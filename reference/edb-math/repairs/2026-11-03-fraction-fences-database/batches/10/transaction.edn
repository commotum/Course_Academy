2}{n}\\right]"] [:db/cas 17592186504437 :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{i}{n})}^{4}\\cdot \\frac{4}{n}]" "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[{\\left(1+\\frac{i}{n}\\right)}^{4}\\cdot \\frac{4}{n}\\right]"] [:db/cas 17592186504460 :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{i}{n})}^{4}\\cdot \\frac{2}{n}]" "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[{\\left(2+\\frac{i}{n}\\right)}^{4}\\cdot \\frac{2}{n}\\right]"] [:db/cas 17592186504601 :question/worked-solution "To calculate the limit, we multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,2}h(x) & =\\lim_{x\\to \\,2}\\frac{x-2}{\\sqrt{x+a}-\\sqrt{2+a}} \\\\  & =\\lim_{x\\to \\,2}(\\frac{x-2}{\\sqrt{x+a}-\\sqrt{2+a}}\\cdot \\frac{\\sqrt{x+a}+\\sqrt{2+a}}{\\sqrt{x+a}+\\sqrt{2+a}}) \\\\  & =\\lim_{x\\to \\,2}\\frac{(x-2)(\\sqrt{x+a}+\\sqrt{2+a})}{(\\sqrt{x+a})^{2}-(\\sqrt{2+a})^{2}} \\\\  & =\\lim_{x\\to \\,2}\\frac{(x-2)(\\sqrt{x+a}+\\sqrt{2+a})}{x-2} \\\\  & =\\lim_{x\\to \\,2}\\frac{\\cancel{(x-2)}(\\sqrt{x+a}+\\sqrt{2+a})}{\\cancel{x-2}} \\\\  & =\\lim_{x\\to \\,2}(\\sqrt{x+a}+\\sqrt{2+a}) \\\\  & =2\\sqrt{2+a}.\\end{aligned}\n$$\n\nIn order for $h(x)$ to be continuous at $x=2,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,2}h(x) & =h(2) \\\\ 2\\sqrt{2+a} & =6 \\\\ \\sqrt{2+a} & =3 \\\\ 2+a & =9 \\\\ a & =7.\\end{aligned}\n$$\n\nTherefore, setting $a=7$ removes the point discontinuity." "To calculate the limit, we multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,2}h(x) & =\\lim_{x\\to \\,2}\\frac{x-2}{\\sqrt{x+a}-\\sqrt{2+a}} \\\\  & =\\lim_{x\\to \\,2}\\left(\\frac{x-2}{\\sqrt{x+a}-\\sqrt{2+a}}\\cdot \\frac{\\sqrt{x+a}+\\sqrt{2+a}}{\\sqrt{x+a}+\\sqrt{2+a}}\\right) \\\\  & =\\lim_{x\\to \\,2}\\frac{(x-2)(\\sqrt{x+a}+\\sqrt{2+a})}{(\\sqrt{x+a})^{2}-(\\sqrt{2+a})^{2}} \\\\  & =\\lim_{x\\to \\,2}\\frac{(x-2)(\\sqrt{x+a}+\\sqrt{2+a})}{x-2} \\\\  & =\\lim_{x\\to \\,2}\\frac{\\cancel{(x-2)}(\\sqrt{x+a}+\\sqrt{2+a})}{\\cancel{x-2}} \\\\  & =\\lim_{x\\to \\,2}(\\sqrt{x+a}+\\sqrt{2+a}) \\\\  & =2\\sqrt{2+a}.\\end{aligned}\n$$\n\nIn order for $h(x)$ to be continuous at $x=2,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,2}h(x) & =h(2) \\\\ 2\\sqrt{2+a} & =6 \\\\ \\sqrt{2+a} & =3 \\\\ 2+a & =9 \\\\ a & =7.\\end{aligned}\n$$\n\nTherefore, setting $a=7$ removes the point discontinuity."] [:db/cas 17592186504606 :question/worked-solution "To calculate the limit, we multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =\\lim_{x\\to 0}\\frac{\\sqrt{x+1}-\\sqrt{1-x}}{ax} \\\\  & =\\lim_{x\\to 0}(\\frac{\\sqrt{x+1}-\\sqrt{1-x}}{ax}\\cdot \\frac{\\sqrt{x+1}+\\sqrt{1-x}}{\\sqrt{x+1}+\\sqrt{1-x}}) \\\\  & =\\lim_{x\\to 0}\\frac{(\\sqrt{x+1})^{2}-(\\sqrt{1-x})^{2}}{ax(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\lim_{x\\to 0}\\frac{2x}{ax(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\lim_{x\\to 0}\\frac{2\\cancel{x}}{a\\cancel{x}(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\lim_{x\\to 0}\\frac{2}{a(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\frac{2}{a(\\sqrt{0+1}+\\sqrt{1-0})} \\\\  & =\\frac{1}{a}.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=0,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =g(0) \\\\ \\frac{1}{a} & =\\frac{1}{4} \\\\ a & =4.\\end{aligned}\n$$\n\nTherefore, setting $a=4$ removes the point discontinuity." "To calculate the limit, we multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =\\lim_{x\\to 0}\\frac{\\sqrt{x+1}-\\sqrt{1-x}}{ax} \\\\  & =\\lim_{x\\to 0}\\left(\\frac{\\sqrt{x+1}-\\sqrt{1-x}}{ax}\\cdot \\frac{\\sqrt{x+1}+\\sqrt{1-x}}{\\sqrt{x+1}+\\sqrt{1-x}}\\right) \\\\  & =\\lim_{x\\to 0}\\frac{(\\sqrt{x+1})^{2}-(\\sqrt{1-x})^{2}}{ax(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\lim_{x\\to 0}\\frac{2x}{ax(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\lim_{x\\to 0}\\frac{2\\cancel{x}}{a\\cancel{x}(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\lim_{x\\to 0}\\frac{2}{a(\\sqrt{x+1}+\\sqrt{1-x})} \\\\  & =\\frac{2}{a(\\sqrt{0+1}+\\sqrt{1-0})} \\\\  & =\\frac{1}{a}.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=0,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =g(0) \\\\ \\frac{1}{a} & =\\frac{1}{4} \\\\ a & =4.\\end{aligned}\n$$\n\nTherefore, setting $a=4$ removes the point discontinuity."] [:db/cas 17592186504607 :question/worked-solution "To calculate the limit, we multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =\\lim_{x\\to 0}\\frac{x}{\\sqrt{x-b}-\\sqrt{2{x}^{2}-b}} \\\\  & =\\lim_{x\\to 0}(\\frac{x}{\\sqrt{x-b}-\\sqrt{2{x}^{2}-b}}\\cdot \\frac{\\sqrt{x-b}+\\sqrt{2{x}^{2}-b}}{\\sqrt{x-b}+\\sqrt{2{x}^{2}-b}}) \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{(\\sqrt{x-b})^{2}-(\\sqrt{2{x}^{2}-b})^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{x-2{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{x(1-2x)} \\\\  & =\\lim_{x\\to 0}\\frac{\\cancel{x}(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{\\cancel{x}(1-2x)} \\\\  & =\\lim_{x\\to 0}\\frac{\\sqrt{x-b}+\\sqrt{2{x}^{2}-b}}{1-2x} \\\\  & =2\\sqrt{-b}.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=0,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =g(0) \\\\ 2\\sqrt{-b} & =10 \\\\ \\sqrt{-b} & =5 \\\\ -b & =25 \\\\ b & =-25.\\end{aligned}\n$$\n\nTherefore, setting $b=-25$ removes the point discontinuity." "To calculate the limit, we multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =\\lim_{x\\to 0}\\frac{x}{\\sqrt{x-b}-\\sqrt{2{x}^{2}-b}} \\\\  & =\\lim_{x\\to 0}\\left(\\frac{x}{\\sqrt{x-b}-\\sqrt{2{x}^{2}-b}}\\cdot \\frac{\\sqrt{x-b}+\\sqrt{2{x}^{2}-b}}{\\sqrt{x-b}+\\sqrt{2{x}^{2}-b}}\\right) \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{(\\sqrt{x-b})^{2}-(\\sqrt{2{x}^{2}-b})^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{x-2{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{x(1-2x)} \\\\  & =\\lim_{x\\to 0}\\frac{\\cancel{x}(\\sqrt{x-b}+\\sqrt{2{x}^{2}-b})}{\\cancel{x}(1-2x)} \\\\  & =\\lim_{x\\to 0}\\frac{\\sqrt{x-b}+\\sqrt{2{x}^{2}-b}}{1-2x} \\\\  & =2\\sqrt{-b}.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=0,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}g(x) & =g(0) \\\\ 2\\sqrt{-b} & =10 \\\\ \\sqrt{-b} & =5 \\\\ -b & =25 \\\\ b & =-25.\\end{aligned}\n$$\n\nTherefore, setting $b=-25$ removes the point discontinuity."] [:db/cas 17592186504609 :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(3x)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{cos}⁡(3x),$ the lower bound is $a=0$ and the upper bound is $b=\\pi /6.$ So, we have\n\n$$\nΔx=\\frac{\\pi /6-0}{n}=\\frac{\\pi }{6n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(3x)\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f(0+i\\cdot \\frac{\\pi }{6n})\\cdot \\frac{\\pi }{6n} \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f\\left(\\frac{\\pi i}{6n}\\right)\\cdot \\frac{\\pi }{6n} \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\operatorname{cos}⁡(3\\cdot \\frac{\\pi i}{6n})\\cdot \\frac{\\pi }{6n} \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\,\\operatorname{cos}⁡\\left(\\frac{\\pi i}{2n}\\right)\\cdot \\frac{\\pi }{6n}.\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(3x)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{cos}⁡(3x),$ the lower bound is $a=0$ and the upper bound is $b=\\pi /6.$ So, we have\n\n$$\nΔx=\\frac{\\pi /6-0}{n}=\\frac{\\pi }{6n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(3x)\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f\\left(0+i\\cdot \\frac{\\pi }{6n}\\right)\\cdot \\frac{\\pi }{6n} \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f\\left(\\frac{\\pi i}{6n}\\right)\\cdot \\frac{\\pi }{6n} \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\operatorname{cos}⁡\\left(3\\cdot \\frac{\\pi i}{6n}\\right)\\cdot \\frac{\\pi }{6n} \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\,\\operatorname{cos}⁡\\left(\\frac{\\pi i}{2n}\\right)\\cdot \\frac{\\pi }{6n}.\\end{aligned}\n$$"] [:db/cas 17592186504612 :question/worked-solution "We have the function \n\n$$\ny=(\\sqrt{x})^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\sqrt{x})^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\sqrt{x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\sqrt{x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(\\sqrt{x}))+(x)\\cdot {(\\operatorname{ln}⁡(\\sqrt{x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(\\sqrt{x})+x\\cdot (\\frac{1}{\\sqrt{x}}\\cdot \\frac{1}{2\\sqrt{x}}) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(\\sqrt{x})+\\frac{1}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}\\operatorname{ln}⁡(x)+\\frac{1}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{2}y(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\sqrt{x})^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{2}(\\sqrt{x})^{x}(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nTherefore, $g(x)=(\\operatorname{ln}⁡(x)+1).$" "We have the function \n\n$$\ny=(\\sqrt{x})^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\sqrt{x})^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\sqrt{x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\sqrt{x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(\\sqrt{x}))+(x)\\cdot {(\\operatorname{ln}⁡(\\sqrt{x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(\\sqrt{x})+x\\cdot \\left(\\frac{1}{\\sqrt{x}}\\cdot \\frac{1}{2\\sqrt{x}}\\right) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(\\sqrt{x})+\\frac{1}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}\\operatorname{ln}⁡(x)+\\frac{1}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{2}y(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\sqrt{x})^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{2}(\\sqrt{x})^{x}(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nTherefore, $g(x)=(\\operatorname{ln}⁡(x)+1).$"] [:db/cas 17592186504618 :question/worked-solution "We have the function \n\n$$\ny={x}^{5{x}^{2}-2}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{5{x}^{2}-2}) \\\\ \\operatorname{ln}⁡y & =(5{x}^{2}-2)\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}((5{x}^{2}-2)\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}-2)\\cdot (\\operatorname{ln}⁡x)+(5{x}^{2}-2)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =10x\\cdot \\operatorname{ln}⁡x+(5{x}^{2}-2)\\cdot \\frac{1}{x} \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =10x\\operatorname{ln}⁡x+\\frac{5{x}^{2}-2}{x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\frac{5{x}^{2}-2}{x}+10x\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{5{x}^{2}-2}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{5{x}^{2}-2}(\\frac{5{x}^{2}-2}{x}+10x\\operatorname{ln}⁡x) \\\\  & ={x}^{5{x}^{2}-2}(\\frac{5{x}^{2}-2}{x}+\\frac{10{x}^{2}\\operatorname{ln}⁡x}{x}) \\\\  & ={x}^{5{x}^{2}-3}(5{x}^{2}+10{x}^{2}\\operatorname{ln}⁡x-2)\\end{aligned}\n$$\n\nTherefore, $g(x)=5{x}^{2}+10{x}^{2}\\operatorname{ln}⁡x-2.$" "We have the function \n\n$$\ny={x}^{5{x}^{2}-2}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{5{x}^{2}-2}) \\\\ \\operatorname{ln}⁡y & =(5{x}^{2}-2)\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}((5{x}^{2}-2)\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}-2)\\cdot (\\operatorname{ln}⁡x)+(5{x}^{2}-2)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =10x\\cdot \\operatorname{ln}⁡x+(5{x}^{2}-2)\\cdot \\frac{1}{x} \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =10x\\operatorname{ln}⁡x+\\frac{5{x}^{2}-2}{x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y\\left(\\frac{5{x}^{2}-2}{x}+10x\\operatorname{ln}⁡x\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{5{x}^{2}-2}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{5{x}^{2}-2}\\left(\\frac{5{x}^{2}-2}{x}+10x\\operatorname{ln}⁡x\\right) \\\\  & ={x}^{5{x}^{2}-2}\\left(\\frac{5{x}^{2}-2}{x}+\\frac{10{x}^{2}\\operatorname{ln}⁡x}{x}\\right) \\\\  & ={x}^{5{x}^{2}-3}(5{x}^{2}+10{x}^{2}\\operatorname{ln}⁡x-2)\\end{aligned}\n$$\n\nTherefore, $g(x)=5{x}^{2}+10{x}^{2}\\operatorname{ln}⁡x-2.$"] [:db/cas 17592186504619 :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{3}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{log}_{2}\\,(5(3+\\frac{4k}{n}))\\cdot \\frac{4}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{3}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}\\left[{log}_{2}\\,\\left(5\\left(3+\\frac{4k}{n}\\right)\\right)\\cdot \\frac{4}{n}\\right].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}"] [:db/cas 17592186504619 :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=3.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{4}{n}.$ Therefore, \n\n$$\n\\frac{4}{n}=\\frac{b-3}{n}\\,⟹\\,b=7.\n$$\n\nConsequently, ${x}_{k}=3+\\frac{4k}{n}$ and $f({x}_{k})={log}_{2}\\,(5{x}_{k}).$ By replacing the sample point ${x}_{k}$ with the variable $x,$ we find the original function.\n\nHence,\n\n$$\n{\\int }_{3}^{7}{\\log }_{2}⁡(5x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{log}_{2}\\,(5(3+\\frac{4k}{n}))\\cdot \\frac{4}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)={\\log }_{2}⁡(5x)\\,\\text{and}\\,b=7.\n$$" "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=3.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{4}{n}.$ Therefore, \n\n$$\n\\frac{4}{n}=\\frac{b-3}{n}\\,⟹\\,b=7.\n$$\n\nConsequently, ${x}_{k}=3+\\frac{4k}{n}$ and $f({x}_{k})={log}_{2}\\,(5{x}_{k}).$ By replacing the sample point ${x}_{k}$ with the variable $x,$ we find the original function.\n\nHence,\n\n$$\n{\\int }_{3}^{7}{\\log }_{2}⁡(5x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}\\left[{log}_{2}\\,\\left(5\\left(3+\\frac{4k}{n}\\right)\\right)\\cdot \\frac{4}{n}\\right].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)={\\log }_{2}⁡(5x)\\,\\text{and}\\,b=7.\n$$"] [:db/cas 17592186504621 :question/worked-solution "From the definition of $f(x),$\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}f(x) & =\\lim_{x\\to 0}\\frac{x}{\\sqrt{x+k}-\\sqrt{k}} \\\\  & =\\lim_{x\\to 0}(\\frac{x}{\\sqrt{x+k}-\\sqrt{k}}\\cdot \\frac{\\sqrt{x+k}+\\sqrt{k}}{\\sqrt{x+k}+\\sqrt{k}}) \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x+k}+\\sqrt{k})}{x+k-k} \\\\  & =\\lim_{x\\to 0}\\frac{\\cancel{x}(\\sqrt{x+k}+\\sqrt{k})}{\\cancel{x}} \\\\  & =\\lim_{x\\to 0}(\\sqrt{x+k}+\\sqrt{k}) \\\\  & =\\sqrt{0+k}+\\sqrt{k} \\\\  & =2\\sqrt{k}.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we must have \n\n$$\n\\begin{aligned}\\lim_{x\\to 0}f(x) & =f(0) \\\\ 2\\sqrt{k} & =18 \\\\ \\sqrt{k} & =9 \\\\ k & =81.\\end{aligned}\n$$" "From the definition of $f(x),$\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}f(x) & =\\lim_{x\\to 0}\\frac{x}{\\sqrt{x+k}-\\sqrt{k}} \\\\  & =\\lim_{x\\to 0}\\left(\\frac{x}{\\sqrt{x+k}-\\sqrt{k}}\\cdot \\frac{\\sqrt{x+k}+\\sqrt{k}}{\\sqrt{x+k}+\\sqrt{k}}\\right) \\\\  & =\\lim_{x\\to 0}\\frac{x(\\sqrt{x+k}+\\sqrt{k})}{x+k-k} \\\\  & =\\lim_{x\\to 0}\\frac{\\cancel{x}(\\sqrt{x+k}+\\sqrt{k})}{\\cancel{x}} \\\\  & =\\lim_{x\\to 0}(\\sqrt{x+k}+\\sqrt{k}) \\\\  & =\\sqrt{0+k}+\\sqrt{k} \\\\  & =2\\sqrt{k}.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we must have \n\n$$\n\\begin{aligned}\\lim_{x\\to 0}f(x) & =f(0) \\\\ 2\\sqrt{k} & =18 \\\\ \\sqrt{k} & =9 \\\\ k & =81.\\end{aligned}\n$$"] [:db/cas 17592186504627 :question/worked-solution "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $$\n\\displaystyle ⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩\n$$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(xy-3x+2y-5)=y-3 \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy-3x+2y-5)=x+2\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨y-3,\\,x+2,\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}y-3 &=0 \\\\ x+2 &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the second equation we get $x=-2,$ while the first equation gives $y=3.$ \n\nFinally, substituting $x=-2$ and $y=3$ into our function, we get\n\n$$\nz=(-2)(3)-3(-2)+2(3)-5=1.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(-2,3,1).$" "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $$\n\\displaystyle \\left\\langle \\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1\\right\\rangle \n$$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(xy-3x+2y-5)=y-3 \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy-3x+2y-5)=x+2\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨y-3,\\,x+2,\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}y-3 &=0 \\\\ x+2 &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the second equation we get $x=-2,$ while the first equation gives $y=3.$ \n\nFinally, substituting $x=-2$ and $y=3$ into our function, we get\n\n$$\nz=(-2)(3)-3(-2)+2(3)-5=1.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(-2,3,1).$"] [:db/cas 17592186504629 :question/problem "$$\n\\displaystyle \\lim_{x\\to \\,3}\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right))=\n$$" "$$\n\\displaystyle \\lim_{x\\to \\,3}\\operatorname{sin}⁡\\left(\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right)\\right)=\n$$"] [:db/cas 17592186504629 :question/worked-solution "First, let's sketch the graph of  $$\n\\displaystyle y=\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right):\n$$   \n\n![](images/4a/4abceba56f404b0b39fbde4b1f7da0ec36e69a496c4ef52d3bebfbcb8c7d3380.png)\n\nThe domain of   $$\n\\displaystyle \\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right)\n$$ is $(-\\infty ,\\infty ).$    \n\nNow, substituting $x=3$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,3}\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right)) & =\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{3}{\\sqrt{3}}\\right)) \\\\  & =\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡(\\sqrt{3})) \\\\  & =\\operatorname{sin}⁡(\\frac{3}{2}\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =1.\\end{aligned}\n$$" "First, let's sketch the graph of  $$\n\\displaystyle y=\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right):\n$$   \n\n![](images/4a/4abceba56f404b0b39fbde4b1f7da0ec36e69a496c4ef52d3bebfbcb8c7d3380.png)\n\nThe domain of   $$\n\\displaystyle \\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right)\n$$ is $(-\\infty ,\\infty ).$    \n\nNow, substituting $x=3$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,3}\\operatorname{sin}⁡\\left(\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{\\sqrt{3}}\\right)\\right) & =\\operatorname{sin}⁡\\left(\\frac{3}{2}\\operatorname{arctan}⁡\\left(\\frac{3}{\\sqrt{3}}\\right)\\right) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{3}{2}\\operatorname{arctan}⁡(\\sqrt{3})\\right) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{3}{2}\\cdot \\frac{\\pi }{3}\\right) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =1.\\end{aligned}\n$$"] [:db/cas 17592186504632 :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{4}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{4},$ the lower bound is $a=1,$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{4}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+i\\cdot \\frac{1}{n})\\,\\cdot \\frac{1}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+\\frac{i}{n})\\cdot \\frac{1}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{i}{n})}^{4}\\cdot \\frac{1}{n}].\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{4}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{4},$ the lower bound is $a=1,$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{4}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[f\\left(1+i\\cdot \\frac{1}{n}\\right)\\,\\cdot \\frac{1}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[f\\left(1+\\frac{i}{n}\\right)\\cdot \\frac{1}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[{\\left(1+\\frac{i}{n}\\right)}^{4}\\cdot \\frac{1}{n}\\right].\\end{aligned}\n$$"] [:db/cas 17592186504637 :question/worked-solution "The slope of the tangent to the curve at $x=\\frac{e}{3}$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny=(\\operatorname{ln}⁡(3x))^{{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡(3x))^{{x}^{2}}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =({x}^{2})^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x)))+({x}^{2})\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x)))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+{x}^{2}\\cdot (\\frac{1}{\\operatorname{ln}⁡(3x)}\\cdot \\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)})\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{ln}⁡(3x))^{{x}^{2}}(2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)})\\end{aligned}\n$$\n\nTherefore, the slope of $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}$ at $x=\\frac{e}{3}$ is\n\n$$\n\\begin{aligned}m={y}^{′}{|}_{x=e/3} & =(\\operatorname{ln}⁡(e))^{(e/3)^{2}}(2\\left(\\frac{e}{3}\\right)\\operatorname{ln}⁡(\\operatorname{ln}⁡(e))+\\frac{\\left(\\frac{e}{3}\\right)}{\\operatorname{ln}⁡(e)}) \\\\  & =(1)^{(e/3)^{2}}(2\\left(\\frac{e}{3}\\right)\\operatorname{ln}⁡(1)+\\frac{\\left(\\frac{e}{3}\\right)}{1}) \\\\  & =1\\cdot (0+\\frac{e}{3}) \\\\  & =\\frac{e}{3}.\\end{aligned}\n$$" "The slope of the tangent to the curve at $x=\\frac{e}{3}$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny=(\\operatorname{ln}⁡(3x))^{{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡(3x))^{{x}^{2}}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =({x}^{2})^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x)))+({x}^{2})\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x)))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+{x}^{2}\\cdot \\left(\\frac{1}{\\operatorname{ln}⁡(3x)}\\cdot \\frac{1}{x}\\right) \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{ln}⁡(3x))^{{x}^{2}}\\left(2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)}\\right)\\end{aligned}\n$$\n\nTherefore, the slope of $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}$ at $x=\\frac{e}{3}$ is\n\n$$\n\\begin{aligned}m={y}^{′}{|}_{x=e/3} & =(\\operatorname{ln}⁡(e))^{(e/3)^{2}}\\left(2\\left(\\frac{e}{3}\\right)\\operatorname{ln}⁡(\\operatorname{ln}⁡(e))+\\frac{\\left(\\frac{e}{3}\\right)}{\\operatorname{ln}⁡(e)}\\right) \\\\  & =(1)^{(e/3)^{2}}\\left(2\\left(\\frac{e}{3}\\right)\\operatorname{ln}⁡(1)+\\frac{\\left(\\frac{e}{3}\\right)}{1}\\right) \\\\  & =1\\cdot \\left(0+\\frac{e}{3}\\right) \\\\  & =\\frac{e}{3}.\\end{aligned}\n$$"] [:db/cas 17592186504641 :question/worked-solution "We have the function \n\n$$\ny=(\\operatorname{tan}⁡x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{tan}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡(\\operatorname{tan}⁡x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\cdot (\\frac{1}{\\operatorname{tan}⁡x}\\cdot {\\sec }^{2}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{tan}⁡x)^{x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =(\\operatorname{tan}⁡x)^{x}(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x.$" "We have the function \n\n$$\ny=(\\operatorname{tan}⁡x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{tan}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡(\\operatorname{tan}⁡x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\cdot \\left(\\frac{1}{\\operatorname{tan}⁡x}\\cdot {\\sec }^{2}⁡x\\right) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{tan}⁡x)^{x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =(\\operatorname{tan}⁡x)^{x}(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x.$"] [:db/cas 17592186504644 :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to \\,\\sqrt{3}/2}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arcsin}⁡(x))=\n$$\n{{field-1}}" "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to \\,\\sqrt{3}/2}\\operatorname{tan}⁡\\left(\\frac{3}{4}\\operatorname{arcsin}⁡(x)\\right)=\n$$\n{{field-1}}"] [:db/cas 17592186504644 :question/worked-solution "![](images/24/24f07da42a537ded7916fc2440dcf3ee1ccdfc81c7b027b47e97814fec059f5a.png)\n\n \n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=\\frac{\\sqrt{3}}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,\\sqrt{3}/2}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arcsin}⁡(x)) & =\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arcsin}⁡\\left(\\frac{\\sqrt{3}}{2}\\right)) \\\\  & =\\operatorname{tan}⁡(\\frac{3}{4}\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =1.\\end{aligned}\n$$" "![](images/24/24f07da42a537ded7916fc2440dcf3ee1ccdfc81c7b027b47e97814fec059f5a.png)\n\n \n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=\\frac{\\sqrt{3}}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,\\sqrt{3}/2}\\operatorname{tan}⁡\\left(\\frac{3}{4}\\operatorname{arcsin}⁡(x)\\right) & =\\operatorname{tan}⁡\\left(\\frac{3}{4}\\operatorname{arcsin}⁡\\left(\\frac{\\sqrt{3}}{2}\\right)\\right) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{3}{4}\\cdot \\frac{\\pi }{3}\\right) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =1.\\end{aligned}\n$$"] [:db/cas 17592186504649 :question/worked-solution "The inequality $z>-\\frac{1}{2}$ corresponds to all numbers greater than $-\\frac{1}{2}.$ A number line for this inequality is shown below:\n\n$$\n\n$$\n\n![](images/9d/9d43b5c54e0beb341f682f44ee4c6d42821a93d45e7d5f0c5576c13e69bff903.png)\n\n \n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $-\\frac{1}{2}$ is *not* included in the interval.\n\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent $z>-\\frac{1}{2}$ as\n\n$$\nz\\in (-\\frac{1}{2},\\infty ).\n$$" "The inequality $z>-\\frac{1}{2}$ corresponds to all numbers greater than $-\\frac{1}{2}.$ A number line for this inequality is shown below:\n\n$$\n\n$$\n\n![](images/9d/9d43b5c54e0beb341f682f44ee4c6d42821a93d45e7d5f0c5576c13e69bff903.png)\n\n \n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $-\\frac{1}{2}$ is *not* included in the interval.\n\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent $z>-\\frac{1}{2}$ as\n\n$$\nz\\in \\left(-\\frac{1}{2},\\infty \\right).\n$$"] [:db/cas 17592186504653 :question/worked-solution "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $$\n\\displaystyle ⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩\n$$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{{x}^{2}+{y}^{2}}) \\\\  & ={e}^{{x}^{2}+{y}^{2}}\\cdot 2x \\\\  & =2x{e}^{{x}^{2}+{y}^{2}} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{{x}^{2}+{y}^{2}}) \\\\  & ={e}^{{x}^{2}+{y}^{2}}\\cdot 2y \\\\  & =2y{e}^{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨2x{e}^{{x}^{2}+{y}^{2}},\\,2y{e}^{{x}^{2}+{y}^{2}},\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}2x{e}^{{x}^{2}+{y}^{2}} &=0 \\\\ 2y{e}^{{x}^{2}+{y}^{2}} &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the first equation, we get $x=0$ while the second equation gives $y=0.$ \n\nFinally, substituting $x=0$ and $y=0$ into our function, we get\n\n$$\nz={e}^{{0}^{2}+{0}^{2}}=1.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(0,0,1).$" "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $$\n\\displaystyle \\left\\langle \\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1\\right\\rangle \n$$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{{x}^{2}+{y}^{2}}) \\\\  & ={e}^{{x}^{2}+{y}^{2}}\\cdot 2x \\\\  & =2x{e}^{{x}^{2}+{y}^{2}} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{{x}^{2}+{y}^{2}}) \\\\  & ={e}^{{x}^{2}+{y}^{2}}\\cdot 2y \\\\  & =2y{e}^{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨2x{e}^{{x}^{2}+{y}^{2}},\\,2y{e}^{{x}^{2}+{y}^{2}},\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}2x{e}^{{x}^{2}+{y}^{2}} &=0 \\\\ 2y{e}^{{x}^{2}+{y}^{2}} &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the first equation, we get $x=0$ while the second equation gives $y=0.$ \n\nFinally, substituting $x=0$ and $y=0$ into our function, we get\n\n$$\nz={e}^{{0}^{2}+{0}^{2}}=1.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(0,0,1).$"] [:db/cas 17592186504654 :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{1}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[7{(1+\\frac{2k}{n})}^{-3}\\cdot \\frac{2}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{1}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}\\left[7{\\left(1+\\frac{2k}{n}\\right)}^{-3}\\cdot \\frac{2}{n}\\right].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}"] [:db/cas 17592186504654 :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=1.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{2}{n}.$ Therefore, \n\n$$\n\\frac{2}{n}=\\frac{b-1}{n}\\,⟹\\,b=3.\n$$\n\nConsequently, ${x}_{k}=1+\\frac{2k}{n}$ and $f({x}_{k})=7{x}_{k}^{-3}.$\n\nHence,\n\n$$\n{\\int }_{1}^{3}7{x}^{-3}\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[7{(1+\\frac{2k}{n})}^{-3}\\cdot \\frac{2}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=7{x}^{-3}\\,\\text{and}\\,b=3.\n$$" "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=1.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{2}{n}.$ Therefore, \n\n$$\n\\frac{2}{n}=\\frac{b-1}{n}\\,⟹\\,b=3.\n$$\n\nConsequently, ${x}_{k}=1+\\frac{2k}{n}$ and $f({x}_{k})=7{x}_{k}^{-3}.$\n\nHence,\n\n$$\n{\\int }_{1}^{3}7{x}^{-3}\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}\\left[7{\\left(1+\\frac{2k}{n}\\right)}^{-3}\\cdot \\frac{2}{n}\\right].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=7{x}^{-3}\\,\\text{and}\\,b=3.\n$$"] [:db/cas 17592186504655 :question/problem "In what direction does the function $f(x,y)={e}^{2y}\\operatorname{tan}⁡({x}^{2})$ increase most rapidly at the point $(\\frac{\\sqrt{\\pi }}{2},0)?$" "In what direction does the function $f(x,y)={e}^{2y}\\operatorname{tan}⁡({x}^{2})$ increase most rapidly at the point $\\left(\\frac{\\sqrt{\\pi }}{2},0\\right)?$"] [:db/cas 17592186504655 :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({e}^{2y}\\operatorname{tan}⁡({x}^{2}))\\,i+\\frac{∂}{∂y}({e}^{2y}\\operatorname{tan}⁡({x}^{2}))\\,j \\\\  & =2x{e}^{2y}{\\sec }^{2}⁡({x}^{2})\\,i+2{e}^{2y}\\operatorname{tan}⁡({x}^{2})\\,j \\\\ ∇f(\\frac{\\sqrt{\\pi }}{2},0) & =2\\left(\\frac{\\sqrt{\\pi }}{2}\\right){e}^{0}{\\sec }^{2}⁡\\left(\\frac{\\pi }{4}\\right)\\,i+2{e}^{0}\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)\\,j \\\\  & =2\\sqrt{\\pi }\\,i+2\\,j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $2\\sqrt{\\pi }\\,i+2\\,j.$" "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({e}^{2y}\\operatorname{tan}⁡({x}^{2}))\\,i+\\frac{∂}{∂y}({e}^{2y}\\operatorname{tan}⁡({x}^{2}))\\,j \\\\  & =2x{e}^{2y}{\\sec }^{2}⁡({x}^{2})\\,i+2{e}^{2y}\\operatorname{tan}⁡({x}^{2})\\,j \\\\ ∇f\\left(\\frac{\\sqrt{\\pi }}{2},0\\right) & =2\\left(\\frac{\\sqrt{\\pi }}{2}\\right){e}^{0}{\\sec }^{2}⁡\\left(\\frac{\\pi }{4}\\right)\\,i+2{e}^{0}\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)\\,j \\\\  & =2\\sqrt{\\pi }\\,i+2\\,j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $2\\sqrt{\\pi }\\,i+2\\,j.$"] [:db/cas 17592186504656 :question/worked-solution "We have the function \n\n$$\ny=(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{sin}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡(x)\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(\\operatorname{sin}⁡(x))^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{sec}⁡(x)))+(\\operatorname{sin}⁡(x))\\cdot {(\\operatorname{ln}⁡(\\operatorname{sec}⁡(x)))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{cos}⁡(x)\\cdot \\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\cdot (\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{sec}⁡(x)^{\\operatorname{sin}⁡(x)}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}\\cdot (\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$" "We have the function \n\n$$\ny=(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{sin}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡(x)\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(\\operatorname{sin}⁡(x))^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{sec}⁡(x)))+(\\operatorname{sin}⁡(x))\\cdot {(\\operatorname{ln}⁡(\\operatorname{sec}⁡(x)))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{cos}⁡(x)\\cdot \\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\cdot \\left(\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)\\right) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{sec}⁡(x)^{\\operatorname{sin}⁡(x)}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}\\cdot (\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$"] [:db/cas 17592186504657 :question/worked-solution "We have the function \n\n$$\ny=(5{x}^{2}+2x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((5{x}^{2}+2x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(5{x}^{2}+2x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(5{x}^{2}+2x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡(5{x}^{2}+2x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5{x}^{2}+2x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡(5{x}^{2}+2x)+x\\cdot (\\frac{1}{5{x}^{2}+2x}\\cdot (10x+2)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x})\\end{aligned}\n$$\n\nFinally, we substitute $y=(5{x}^{2}+2x)^{x}:$    \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =(5{x}^{2}+2x)^{x}\\cdot (\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}) \\\\  & =(5{x}^{2}+2x)^{x}\\cdot (\\frac{(5{x}^{2}+2x)\\operatorname{ln}⁡(5{x}^{2}+2x)}{5{x}^{2}+2x}+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}) \\\\  & =(5{x}^{2}+2x)^{x-1}\\cdot ((5{x}^{2}+2x)\\operatorname{ln}⁡(5{x}^{2}+2x)+10{x}^{2}+2x).\\end{aligned}\n$$" "We have the function \n\n$$\ny=(5{x}^{2}+2x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((5{x}^{2}+2x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(5{x}^{2}+2x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(5{x}^{2}+2x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡(5{x}^{2}+2x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5{x}^{2}+2x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡(5{x}^{2}+2x)+x\\cdot \\left(\\frac{1}{5{x}^{2}+2x}\\cdot (10x+2)\\right) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y\\left(\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=(5{x}^{2}+2x)^{x}:$    \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =(5{x}^{2}+2x)^{x}\\cdot \\left(\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}\\right) \\\\  & =(5{x}^{2}+2x)^{x}\\cdot \\left(\\frac{(5{x}^{2}+2x)\\operatorname{ln}⁡(5{x}^{2}+2x)}{5{x}^{2}+2x}+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}\\right) \\\\  & =(5{x}^{2}+2x)^{x-1}\\cdot ((5{x}^{2}+2x)\\operatorname{ln}⁡(5{x}^{2}+2x)+10{x}^{2}+2x).\\end{aligned}\n$$"] [:db/cas 17592186504658 :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{1}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[\\sqrt{(1+\\frac{4k}{n})+1}\\cdot \\frac{4}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{1}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}\\left[\\sqrt{\\left(1+\\frac{4k}{n}\\right)+1}\\cdot \\frac{4}{n}\\right].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}"] [:db/cas 17592186504658 :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=1.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{4}{n}.$ Therefore, \n\n$$\n\\frac{4}{n}=\\frac{b-1}{n}\\,⟹\\,b=5.\n$$\n\nConsequently, ${x}_{k}=1+\\frac{4k}{n}$ and $f({x}_{k})=\\sqrt{{x}_{k}+1}.$\n\nHence,\n\n$$\n{\\int }_{1}^{5}\\sqrt{x+1}\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[\\sqrt{(1+\\frac{4k}{n})+1}\\cdot \\frac{4}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=\\sqrt{x+1}\\,\\text{and}\\,b=5.\n$$" "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=1.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{4}{n}.$ Therefore, \n\n$$\n\\frac{4}{n}=\\frac{b-1}{n}\\,⟹\\,b=5.\n$$\n\nConsequently, ${x}_{k}=1+\\frac{4k}{n}$ and $f({x}_{k})=\\sqrt{{x}_{k}+1}.$\n\nHence,\n\n$$\n{\\int }_{1}^{5}\\sqrt{x+1}\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}\\left[\\sqrt{\\left(1+\\frac{4k}{n}\\right)+1}\\cdot \\frac{4}{n}\\right].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=\\sqrt{x+1}\\,\\text{and}\\,b=5.\n$$"] [:db/cas 17592186504660 :question/worked-solution "The inequality $x>\\frac{1}{2}$ corresponds to all numbers greater than $\\frac{1}{2}.$ A number line for this inequality is shown below:\n\n$$\n\n$$\n\n![](images/12/122ab4938bf6102036dec1a704cca8afa344d6ca3b9558743c3d573d16367636.png)\n\n \n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $\\frac{1}{2}$ is *not* included in the interval.\n\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent $x>\\frac{1}{2}$ as\n\n$$\nx\\in (\\frac{1}{2},\\infty ).\n$$" "The inequality $x>\\frac{1}{2}$ corresponds to all numbers greater than $\\frac{1}{2}.$ A number line for this inequality is shown below:\n\n$$\n\n$$\n\n![](images/12/122ab4938bf6102036dec1a704cca8afa344d6ca3b9558743c3d573d16367636.png)\n\n \n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $\\frac{1}{2}$ is *not* included in the interval.\n\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent $x>\\frac{1}{2}$ as\n\n$$\nx\\in \\left(\\frac{1}{2},\\infty \\right).\n$$"] [:db/cas 17592186504663 :question/worked-solution "The slope of the tangent to the curve at $x=e$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny=(\\operatorname{ln}⁡x)^{5x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡x)^{5x}) \\\\ \\operatorname{ln}⁡y & =5x\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5x\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(5x)^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡x))+(5x)\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡x)+5x\\cdot (\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =5\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{5}{\\operatorname{ln}⁡x} \\\\ \\frac{{y}^{′}}{y} & =5(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x})\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(5(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}))\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡x)^{5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5(\\operatorname{ln}⁡x)^{5x}(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x})\\end{aligned}\n$$\n\nTherefore, the slope of $y=(\\operatorname{ln}⁡x)^{5x}$ at $x=e$ is\n\n$$\n\\begin{aligned}{y}^{′}{|}_{x=e} & =5(\\operatorname{ln}⁡e)^{5\\cdot e}(\\operatorname{ln}⁡(\\operatorname{ln}⁡e)+\\frac{1}{\\operatorname{ln}⁡e}) \\\\  & =5(1)^{5e}(\\operatorname{ln}⁡(1)+\\frac{1}{1}) \\\\  & =5.\\end{aligned}\n$$" "The slope of the tangent to the curve at $x=e$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny=(\\operatorname{ln}⁡x)^{5x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡x)^{5x}) \\\\ \\operatorname{ln}⁡y & =5x\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5x\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(5x)^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡x))+(5x)\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡x)+5x\\cdot \\left(\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{1}{x}\\right) \\\\ \\frac{{y}^{′}}{y} & =5\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{5}{\\operatorname{ln}⁡x} \\\\ \\frac{{y}^{′}}{y} & =5\\left(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}\\right)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(5\\left(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}\\right)\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡x)^{5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5(\\operatorname{ln}⁡x)^{5x}\\left(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}\\right)\\end{aligned}\n$$\n\nTherefore, the slope of $y=(\\operatorname{ln}⁡x)^{5x}$ at $x=e$ is\n\n$$\n\\begin{aligned}{y}^{′}{|}_{x=e} & =5(\\operatorname{ln}⁡e)^{5\\cdot e}\\left(\\operatorname{ln}⁡(\\operatorname{ln}⁡e)+\\frac{1}{\\operatorname{ln}⁡e}\\right) \\\\  & =5(1)^{5e}\\left(\\operatorname{ln}⁡(1)+\\frac{1}{1}\\right) \\\\  & =5.\\end{aligned}\n$$"] [:db/cas 17592186504672 :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{5}(\\operatorname{arctan}⁡(x)+2)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡(x)+2,$ the lower bound is $a=1,$ and the upper bound is $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}(\\operatorname{arctan}⁡(x)+2)\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+i\\cdot \\frac{4}{n})\\cdot \\frac{4}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+\\frac{4i}{n})\\cdot \\frac{4}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[(\\operatorname{arctan}⁡(\\,1+\\frac{4i}{n}\\,)+2)\\,\\cdot \\frac{4}{n}].\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{5}(\\operatorname{arctan}⁡(x)+2)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡(x)+2,$ the lower bound is $a=1,$ and the upper bound is $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}(\\operatorname{arctan}⁡(x)+2)\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[f\\left(1+i\\cdot \\frac{4}{n}\\right)\\cdot \\frac{4}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[f\\left(1+\\frac{4i}{n}\\right)\\cdot \\frac{4}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[\\left(\\operatorname{arctan}⁡\\left(\\,1+\\frac{4i}{n}\\,\\right)+2\\right)\\,\\cdot \\frac{4}{n}\\right].\\end{aligned}\n$$"] [:db/cas 17592186504682 :question/worked-solution "We have the function \n\n$$\ny=({x}^{2}+3x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+3x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡({x}^{2}+3x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡({x}^{2}+3x)+x\\cdot (\\frac{1}{{x}^{2}+3x}\\cdot 2x+3) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x})\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+3x)^{x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =({x}^{2}+3x)^{x}(\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}) \\\\  & =({x}^{2}+3x)^{x}(\\frac{({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)}{{x}^{2}+3x}+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}) \\\\  & =({x}^{2}+3x)^{x-1}(({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)+(2{x}^{2}+3x)).\\end{aligned}\n$$\n\n \n\nTherefore, $g(x)=({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)+(2{x}^{2}+3x).$" "We have the function \n\n$$\ny=({x}^{2}+3x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+3x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡({x}^{2}+3x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡({x}^{2}+3x)+x\\cdot \\left(\\frac{1}{{x}^{2}+3x}\\cdot 2x+3\\right) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y\\left(\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+3x)^{x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =({x}^{2}+3x)^{x}\\left(\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}\\right) \\\\  & =({x}^{2}+3x)^{x}\\left(\\frac{({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)}{{x}^{2}+3x}+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}\\right) \\\\  & =({x}^{2}+3x)^{x-1}(({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)+(2{x}^{2}+3x)).\\end{aligned}\n$$\n\n \n\nTherefore, $g(x)=({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)+(2{x}^{2}+3x).$"] [:db/cas 17592186504684 :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arccos}⁡(x))=\n$$\n{{field-1}}" "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡\\left(\\frac{3}{4}\\operatorname{arccos}⁡(x)\\right)=\n$$\n{{field-1}}"] [:db/cas 17592186504684 :question/worked-solution "![](images/85/85a182aabfe64c27eaafde94e3bdbede9409b02cfd87395cb2fc5543b09c4e05.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$\n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arccos}⁡(x)) & =\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arccos}⁡\\left(\\frac{1}{2}\\right)) \\\\  & =\\operatorname{tan}⁡(\\frac{3}{4}\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =1.\\end{aligned}\n$$" "![](images/85/85a182aabfe64c27eaafde94e3bdbede9409b02cfd87395cb2fc5543b09c4e05.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$\n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡\\left(\\frac{3}{4}\\operatorname{arccos}⁡(x)\\right) & =\\operatorname{tan}⁡\\left(\\frac{3}{4}\\operatorname{arccos}⁡\\left(\\frac{1}{2}\\right)\\right) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{3}{4}\\cdot \\frac{\\pi }{3}\\right) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =1.\\end{aligned}\n$$"] [:db/cas 17592186504685 :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{5},$ the lower bound is $a=1$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(1+k\\cdot \\frac{1}{n})\\cdot \\frac{1}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(1+\\frac{k}{n})\\cdot \\frac{1}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}[{(1+\\frac{k}{n})}^{5}\\cdot \\frac{1}{n}].\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{5},$ the lower bound is $a=1$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}\\left[f\\left(1+k\\cdot \\frac{1}{n}\\right)\\cdot \\frac{1}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}\\left[f\\left(1+\\frac{k}{n}\\right)\\cdot \\frac{1}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}\\left[{\\left(1+\\frac{k}{n}\\right)}^{5}\\cdot \\frac{1}{n}\\right].\\end{aligned}\n$$"] [:db/cas 17592186504688 :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{sin}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=\\pi .$ So, we have\n\n$$\nΔx=\\frac{\\pi -0}{n}=\\frac{\\pi }{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{\\pi }{n})\\cdot \\frac{\\pi }{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}[f\\left(\\frac{\\pi k}{n}\\right)\\cdot \\frac{\\pi }{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{sin}⁡\\left(\\frac{\\pi k}{n}\\right)\\cdot \\frac{\\pi }{n}].\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{sin}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=\\pi .$ So, we have\n\n$$\nΔx=\\frac{\\pi -0}{n}=\\frac{\\pi }{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}\\left[f\\left(0+k\\cdot \\frac{\\pi }{n}\\right)\\cdot \\frac{\\pi }{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}\\left[f\\left(\\frac{\\pi k}{n}\\right)\\cdot \\frac{\\pi }{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{k=1}^{n}\\left[\\operatorname{sin}⁡\\left(\\frac{\\pi k}{n}\\right)\\cdot \\frac{\\pi }{n}\\right].\\end{aligned}\n$$"] [:db/cas 17592186504689 :question/problem "$$\n\\displaystyle \\lim_{x\\to \\,-\\infty }\\frac{1}{\\pi }(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x))=\n$$" "$$\n\\displaystyle \\lim_{x\\to \\,-\\infty }\\frac{1}{\\pi }\\left(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)\\right)=\n$$"] [:db/cas 17592186504689 :question/worked-solution "First, let's sketch the graph of $y=\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x):$ \n\n![](images/0f/0fa9338fbefb3682249a585b85d287a25868a8f137547830adf6085dae85139a.png)\n\nThe domain of $\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n\\lim_{x\\to -\\infty }\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)=\\pi .\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to \\,-\\infty }\\frac{1}{\\pi }(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x))=\\frac{1}{\\pi }\\cdot (\\pi )=1.\n$$" "First, let's sketch the graph of $y=\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x):$ \n\n![](images/0f/0fa9338fbefb3682249a585b85d287a25868a8f137547830adf6085dae85139a.png)\n\nThe domain of $\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n\\lim_{x\\to -\\infty }\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)=\\pi .\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to \\,-\\infty }\\frac{1}{\\pi }\\left(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)\\right)=\\frac{1}{\\pi }\\cdot (\\pi )=1.\n$$"] [:db/cas 17592186504691 :question/worked-solution "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $$\n\\displaystyle ⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩\n$$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y)=\\operatorname{ln}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡y)=\\frac{x}{y}\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨\\operatorname{ln}⁡y,\\,\\frac{x}{y},\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}\\operatorname{ln}⁡y &=0 \\\\ \\frac{x}{y} &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the first equation we get $y=1,$ while the second equation gives $x=0.$ \n\nFinally, substituting $x=0$ and $y=1$ into our function, we get\n\n$$\nz=0\\operatorname{ln}⁡1=0.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(0,1,0).$" "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $$\n\\displaystyle \\left\\langle \\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1\\right\\rangle \n$$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y)=\\operatorname{ln}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡y)=\\frac{x}{y}\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n\\left\\langle \\operatorname{ln}⁡y,\\,\\frac{x}{y},\\,-1\\right\\rangle .\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}\\operatorname{ln}⁡y &=0 \\\\ \\frac{x}{y} &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the first equation we get $y=1,$ while the second equation gives $x=0.$ \n\nFinally, substituting $x=0$ and $y=1$ into our function, we get\n\n$$\nz=0\\operatorname{ln}⁡1=0.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(0,1,0).$"] [:db/cas 17592186504692 :question/worked-solution "We have the function \n\n$$\ny={x}^{\\operatorname{sec}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{\\operatorname{sec}⁡x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{sec}⁡x\\,\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =(\\frac{\\text{d}}{\\text{d}x}\\operatorname{sec}⁡x)\\operatorname{ln}⁡x+\\operatorname{sec}⁡x(\\frac{\\text{d}}{\\text{d}x}\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\operatorname{ln}⁡x+\\operatorname{sec}⁡x\\cdot \\frac{1}{x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡x\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sec}⁡x}{x})\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{\\operatorname{sec}⁡x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{\\operatorname{sec}⁡x}\\cdot (\\operatorname{ln}⁡x\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sec}⁡x}{x}) \\\\  & ={x}^{\\operatorname{sec}⁡x}\\cdot \\frac{\\operatorname{sec}⁡x}{x}\\cdot (x\\operatorname{ln}⁡x\\,\\operatorname{tan}⁡x+1) \\\\  & ={x}^{\\operatorname{sec}⁡x-1}\\operatorname{sec}⁡x\\cdot (x\\operatorname{ln}⁡x\\operatorname{tan}⁡x+1).\\end{aligned}\n$$" "We have the function \n\n$$\ny={x}^{\\operatorname{sec}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{\\operatorname{sec}⁡x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{sec}⁡x\\,\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\left(\\frac{\\text{d}}{\\text{d}x}\\operatorname{sec}⁡x\\right)\\operatorname{ln}⁡x+\\operatorname{sec}⁡x\\left(\\frac{\\text{d}}{\\text{d}x}\\operatorname{ln}⁡x\\right) \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\operatorname{ln}⁡x+\\operatorname{sec}⁡x\\cdot \\frac{1}{x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y\\left(\\operatorname{ln}⁡x\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sec}⁡x}{x}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{\\operatorname{sec}⁡x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{\\operatorname{sec}⁡x}\\cdot \\left(\\operatorname{ln}⁡x\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sec}⁡x}{x}\\right) \\\\  & ={x}^{\\operatorname{sec}⁡x}\\cdot \\frac{\\operatorname{sec}⁡x}{x}\\cdot (x\\operatorname{ln}⁡x\\,\\operatorname{tan}⁡x+1) \\\\  & ={x}^{\\operatorname{sec}⁡x-1}\\operatorname{sec}⁡x\\cdot (x\\operatorname{ln}⁡x\\operatorname{tan}⁡x+1).\\end{aligned}\n$$"] [:db/cas 17592186504700 :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{2}(x+2)^{3}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(x+2)^{3},$ the lower bound is $a=0$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-0}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(x+2)^{3}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(0+i\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}[f\\left(\\frac{2i}{n}\\right)\\cdot \\frac{2}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}[{(\\,\\frac{2i}{n}+2\\,)}^{\\,3}\\cdot \\frac{2}{n}].\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{2}(x+2)^{3}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(x+2)^{3},$ the lower bound is $a=0$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-0}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(x+2)^{3}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\left[f\\left(0+i\\cdot \\frac{2}{n}\\right)\\cdot \\frac{2}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\left[f\\left(\\frac{2i}{n}\\right)\\cdot \\frac{2}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=1}^{n}\\left[{\\left(\\,\\frac{2i}{n}+2\\,\\right)}^{\\,3}\\cdot \\frac{2}{n}\\right].\\end{aligned}\n$$"] [:db/cas 17592186504703 :question/worked-solution "We have the function \n\n$$\ny=5e{x}^{1/x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e{x}^{1/x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e)+\\operatorname{ln}⁡({x}^{1/x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e)+\\left(\\frac{1}{x}\\right)\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5e)+\\left(\\frac{1}{x}\\right)\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+{\\left(\\frac{1}{x}\\right)}^{′}\\cdot (\\operatorname{ln}⁡x)+\\left(\\frac{1}{x}\\right)\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\left(-\\frac{1}{{x}^{2}}\\right)\\operatorname{ln}⁡x+\\left(\\frac{1}{x}\\right)\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =-\\frac{\\operatorname{ln}⁡x}{{x}^{2}}+\\frac{1}{{x}^{2}} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{{x}^{2}}(1-\\operatorname{ln}⁡x) \\\\ \\frac{{y}^{′}}{y} & ={x}^{-2}(1-\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[{x}^{-2}(1-\\operatorname{ln}⁡x)]\\end{aligned}\n$$\n\nFinally, we substitute $y=5e{x}^{1/x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5e{x}^{1/x}[{x}^{-2}(1-\\operatorname{ln}⁡x)] \\\\  & =5e{x}^{1/x-2}\\cdot (1-\\operatorname{ln}⁡x)\\end{aligned}\n$$" "We have the function \n\n$$\ny=5e{x}^{1/x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e{x}^{1/x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e)+\\operatorname{ln}⁡({x}^{1/x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e)+\\left(\\frac{1}{x}\\right)\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\operatorname{ln}⁡(5e)+\\left(\\frac{1}{x}\\right)\\operatorname{ln}⁡x\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+{\\left(\\frac{1}{x}\\right)}^{′}\\cdot (\\operatorname{ln}⁡x)+\\left(\\frac{1}{x}\\right)\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\left(-\\frac{1}{{x}^{2}}\\right)\\operatorname{ln}⁡x+\\left(\\frac{1}{x}\\right)\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =-\\frac{\\operatorname{ln}⁡x}{{x}^{2}}+\\frac{1}{{x}^{2}} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{{x}^{2}}(1-\\operatorname{ln}⁡x) \\\\ \\frac{{y}^{′}}{y} & ={x}^{-2}(1-\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[{x}^{-2}(1-\\operatorname{ln}⁡x)]\\end{aligned}\n$$\n\nFinally, we substitute $y=5e{x}^{1/x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5e{x}^{1/x}[{x}^{-2}(1-\\operatorname{ln}⁡x)] \\\\  & =5e{x}^{1/x-2}\\cdot (1-\\operatorname{ln}⁡x)\\end{aligned}\n$$"] [:db/cas 17592186504706 :question/worked-solution "We have the function \n\n$$\ny=e{x}^{2-5{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(e{x}^{2-5{x}^{2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡e+\\operatorname{ln}⁡({x}^{2-5{x}^{2}}) \\\\ \\operatorname{ln}⁡y & =1+(2-5{x}^{2})\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(1+(2-5{x}^{2})\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+(2-5{x}^{2})^{′}\\cdot (\\operatorname{ln}⁡x)+(2-5{x}^{2})\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(-10x)\\cdot \\operatorname{ln}⁡x+(2-5{x}^{2})\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =-10x\\operatorname{ln}⁡x+\\frac{2-5{x}^{2}}{x} \\\\ \\frac{{y}^{′}}{y} & =-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x})\\end{aligned}\n$$\n\nFinally, we substitute $y=e{x}^{2-5{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =e{x}^{2-5{x}^{2}}\\cdot (-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}) \\\\  & =e{x}^{1-5{x}^{2}}\\cdot x(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}) \\\\  & =e{x}^{1-5{x}^{2}}\\cdot (-10{x}^{2}\\operatorname{ln}⁡x-5{x}^{2}+2)\\end{aligned}\n$$" "We have the function \n\n$$\ny=e{x}^{2-5{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(e{x}^{2-5{x}^{2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡e+\\operatorname{ln}⁡({x}^{2-5{x}^{2}}) \\\\ \\operatorname{ln}⁡y & =1+(2-5{x}^{2})\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(1+(2-5{x}^{2})\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+(2-5{x}^{2})^{′}\\cdot (\\operatorname{ln}⁡x)+(2-5{x}^{2})\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(-10x)\\cdot \\operatorname{ln}⁡x+(2-5{x}^{2})\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =-10x\\operatorname{ln}⁡x+\\frac{2-5{x}^{2}}{x} \\\\ \\frac{{y}^{′}}{y} & =-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=e{x}^{2-5{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =e{x}^{2-5{x}^{2}}\\cdot \\left(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}\\right) \\\\  & =e{x}^{1-5{x}^{2}}\\cdot x\\left(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}\\right) \\\\  & =e{x}^{1-5{x}^{2}}\\cdot (-10{x}^{2}\\operatorname{ln}⁡x-5{x}^{2}+2)\\end{aligned}\n$$"] [:db/cas 17592186504753 :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + 4b)=λ\\left(\\frac{1}{2}\\right)a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-3}{\\frac{1}{2}} = -6 \\\\\nλ &= \\frac{-24}{4} = -6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-3a - 24b=-6(\\frac{1}{2}a + 4b).\n$$\n\nTherefore,\n\n$$\nλ=-6\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative." "Notice that\n\n$$\nλ\\left(\\frac{1}{2}a + 4b\\right)=λ\\left(\\frac{1}{2}\\right)a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-3}{\\frac{1}{2}} = -6 \\\\\nλ &= \\frac{-24}{4} = -6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-3a - 24b=-6\\left(\\frac{1}{2}a + 4b\\right).\n$$\n\nTherefore,\n\n$$\nλ=-6\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."] [:db/cas 17592186504768 :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{4}a - 3b)=λ\\left(\\frac{1}{4}\\right)a+λ(-3)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{4}} = -4 \\\\\nλ &= \\frac{12}{-3} = -4\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a + 12b=-4(\\frac{1}{4}a - 3b).\n$$\n\nTherefore,\n\n$$\nλ=-4\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative." "Notice that\n\n$$\nλ\\left(\\frac{1}{4}a - 3b\\right)=λ\\left(\\frac{1}{4}\\right)a+λ(-3)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{4}} = -4 \\\\\nλ &= \\frac{12}{-3} = -4\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a + 12b=-4\\left(\\frac{1}{4}a - 3b\\right).\n$$\n\nTherefore,\n\n$$\nλ=-4\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."] [:db/cas 17592186504832 :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + 3b)=λ\\left(\\frac{1}{2}\\right)a+λ(3)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{2}} = -2 \\\\\nλ &= \\frac{-6}{3} = -2\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a - 6b=-2(\\frac{1}{2}a + 3b).\n$$\n\nTherefore,\n\n$$\nλ=-2\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative." "Notice that\n\n$$\nλ\\left(\\frac{1}{2}a + 3b\\right)=λ\\left(\\frac{1}{2}\\right)a+λ(3)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{2}} = -2 \\\\\nλ &= \\frac{-6}{3} = -2\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a - 6b=-2\\left(\\frac{1}{2}a + 3b\\right).\n$$\n\nTherefore,\n\n$$\nλ=-2\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."] [:db/cas 17592186504838 :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + 4b)=λ\\left(\\frac{1}{2}\\right)a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{3}{\\frac{1}{2}} = 6 \\\\\nλ &= \\frac{24}{4} = 6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n3a + 24b=6(\\frac{1}{2}a + 4b).\n$$\n\nTherefore,\n\n$$\nλ=6\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive." "Notice that\n\n$$\nλ\\left(\\frac{1}{2}a + 4b\\right)=λ\\left(\\frac{1}{2}\\right)a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{3}{\\frac{1}{2}} = 6 \\\\\nλ &= \\frac{24}{4} = 6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n3a + 24b=6\\left(\\frac{1}{2}a + 4b\\right).\n$$\n\nTherefore,\n\n$$\nλ=6\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."] [:db/cas 17592186504839 :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + b)=λ\\left(\\frac{1}{2}\\right)a+λ(1)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{2}} = -2 \\\\\nλ &= \\frac{-2}{1} = -2\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a - 2b=-2(\\frac{1}{2}a + b).\n$$\n\nTherefore,\n\n$$\nλ=-2\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative." "Notice that\n\n$$\nλ\\left(\\frac{1}{2}a + b\\right)=λ\\left(\\frac{1}{2}\\right)a+λ(1)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{2}} = -2 \\\\\nλ &= \\frac{-2}{1} = -2\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a - 2b=-2\\left(\\frac{1}{2}a + b\\right).\n$$\n\nTherefore,\n\n$$\nλ=-2\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."] [:db/cas 17592186505119 :answer/value "\\operatorname{ln}⁡(\\frac{4}{3}+\\sqrt{\\frac{11}{9}})" "\\operatorname{ln}⁡\\left(\\frac{4}{3}+\\sqrt{\\frac{11}{9}}\\right)"] [:db/cas 17592186505126 :answer/value "\\operatorname{ln}⁡(\\frac{4}{3}+\\sqrt{\\frac{7}{3}})" "\\operatorname{ln}⁡\\left(\\frac{4}{3}+\\sqrt{\\frac{7}{3}}\\right)"] [:db/cas 17592186505728 :multistep/context "A workshop where cars are painted has ${(\\frac{20}{9})}^{2}$ liters of paint available to paint some parts of a customer's car." "A workshop where cars are painted has ${\\left(\\frac{20}{9}\\right)}^{2}$ liters of paint available to paint some parts of a customer's car."] [:db/cas 17592186505734 :question/problem "Evaluate $\\operatorname{arcosh}⁡(\\frac{5\\sqrt{2}}{7}).$ **Do not round** your answer.\n\n$\\operatorname{arcosh}⁡(\\frac{5\\sqrt{2}}{7})=\\operatorname{ln}⁡($\n{{field-1}}$)$" "Evaluate $\\operatorname{arcosh}⁡\\left(\\frac{5\\sqrt{2}}{7}\\right).$ **Do not round** your answer.\n\n$\\operatorname{arcosh}⁡\\left(\\frac{5\\sqrt{2}}{7}\\right)=\\operatorname{ln}⁡($\n{{field-1}}$)$"] [:db/cas 17592186505734 :question/worked-solution "By definition,\n\n$$\n\\operatorname{arcosh}⁡x=\\ln \\,(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\frac{5\\sqrt{2}}{7} & =\\operatorname{ln}⁡(\\frac{5\\sqrt{2}}{7}+\\sqrt{{\\left(\\frac{5\\sqrt{2}}{7}\\right)}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(\\frac{5\\sqrt{2}}{7}+\\sqrt{\\frac{50}{49}-1}) \\\\  & =\\operatorname{ln}⁡(\\frac{5\\sqrt{2}}{7}+\\sqrt{\\frac{50-49}{49}}) \\\\  & =\\operatorname{ln}⁡(\\frac{5\\sqrt{2}}{7}+\\sqrt{\\frac{1}{49}}) \\\\  & =\\operatorname{ln}⁡(\\frac{5\\sqrt{2}}{7}+\\frac{1}{7}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}+1}{7}\\right).\\end{aligned}\n$$" "By definition,\n\n$$\n\\operatorname{arcosh}⁡x=\\ln \\,(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\frac{5\\sqrt{2}}{7} & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}}{7}+\\sqrt{{\\left(\\frac{5\\sqrt{2}}{7}\\right)}^{2}-1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}}{7}+\\sqrt{\\frac{50}{49}-1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}}{7}+\\sqrt{\\frac{50-49}{49}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}}{7}+\\sqrt{\\frac{1}{49}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}}{7}+\\frac{1}{7}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{5\\sqrt{2}+1}{7}\\right).\\end{aligned}\n$$"] [:db/cas 17592186505735 :question/problem "Evaluate $\\operatorname{arsinh}⁡(\\frac{4-{m}^{2}}{4m}),$ for $m>0.$\n\n$\\operatorname{arsinh}⁡(\\frac{4-{m}^{2}}{4m})=\\operatorname{ln}⁡($\n{{field-1}}$)$" "Evaluate $\\operatorname{arsinh}⁡\\left(\\frac{4-{m}^{2}}{4m}\\right),$ for $m>0.$\n\n$\\operatorname{arsinh}⁡\\left(\\frac{4-{m}^{2}}{4m}\\right)=\\operatorname{ln}⁡($\n{{field-1}}$)$"] [:db/cas 17592186505735 :question/worked-solution "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{4-{m}^{2}}{4m}\\right) & =\\operatorname{ln}⁡(\\frac{4-{m}^{2}}{4m}+\\sqrt{{\\left(\\frac{4-{m}^{2}}{4m}\\right)}^{2}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{4-{m}^{2}}{4m}+\\sqrt{\\frac{16-8{m}^{2}+{m}^{4}}{16{m}^{2}}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{4-{m}^{2}}{4m}+\\sqrt{\\frac{16+8{m}^{2}+{m}^{4}}{16{m}^{2}}}) \\\\  & =\\operatorname{ln}⁡(\\frac{4-{m}^{2}}{4m}+\\sqrt{{\\left(\\frac{{m}^{2}+4}{4m}\\right)}^{2}}) \\\\  & =\\operatorname{ln}⁡(\\frac{4-{m}^{2}}{4m}+|\\frac{{m}^{2}+4}{4m}|)\\end{aligned}\n$$\n\nSince $m>0,$ we have $\\frac{{m}^{2}+4}{4m}>0,$ and we can remove the absolute value in the above expression. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{4-{m}^{2}}{4m}\\right) & =\\operatorname{ln}⁡(\\frac{4-{m}^{2}}{4m}+\\frac{{m}^{2}+4}{4m}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{2}{m}\\right).\\end{aligned}\n$$" "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{4-{m}^{2}}{4m}\\right) & =\\operatorname{ln}⁡\\left(\\frac{4-{m}^{2}}{4m}+\\sqrt{{\\left(\\frac{4-{m}^{2}}{4m}\\right)}^{2}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4-{m}^{2}}{4m}+\\sqrt{\\frac{16-8{m}^{2}+{m}^{4}}{16{m}^{2}}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4-{m}^{2}}{4m}+\\sqrt{\\frac{16+8{m}^{2}+{m}^{4}}{16{m}^{2}}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4-{m}^{2}}{4m}+\\sqrt{{\\left(\\frac{{m}^{2}+4}{4m}\\right)}^{2}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4-{m}^{2}}{4m}+|\\frac{{m}^{2}+4}{4m}|\\right)\\end{aligned}\n$$\n\nSince $m>0,$ we have $\\frac{{m}^{2}+4}{4m}>0,$ and we can remove the absolute value in the above expression. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{4-{m}^{2}}{4m}\\right) & =\\operatorname{ln}⁡\\left(\\frac{4-{m}^{2}}{4m}+\\frac{{m}^{2}+4}{4m}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{2}{m}\\right).\\end{aligned}\n$$"] [:db/cas 17592186505756 :question/worked-solution "The painter had $(8\\,\\frac{5}{6}-7\\,\\frac{2}{3})$ liters of thinner left over.\n\nWriting $8\\,\\frac{5}{6}$ as an improper fraction, we have\n\n$$\n8\\,\\frac{5}{6}=\\frac{8\\times 6+5}{6}=\\frac{53}{6}.\n$$\n\nWriting $7\\,\\frac{2}{3}$ as an improper fraction, we have\n\n$$\n7\\,\\frac{2}{3}=\\frac{7\\times 3+2}{3}=\\frac{23}{3}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{53}{6}-\\frac{23}{3}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $6.$\n\nTo put $\\frac{23}{3}$ over a denominator of $6,$ we multiply the numerator and denominator by $2:$\n\n$$\n\\frac{23}{3}=\\frac{23\\times 2}{3\\times 2}=\\frac{46}{6}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{53}{6}-\\frac{46}{6}=\\frac{7}{6}\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{7}{6}=1\\,\\text{R}\\,1=1\\,\\frac{1}{6}\n$$\n\nTherefore, the painter had $1\\,\\frac{1}{6}$ liters of thinner left over." "The painter had $\\left(8\\,\\frac{5}{6}-7\\,\\frac{2}{3}\\right)$ liters of thinner left over.\n\nWriting $8\\,\\frac{5}{6}$ as an improper fraction, we have\n\n$$\n8\\,\\frac{5}{6}=\\frac{8\\times 6+5}{6}=\\frac{53}{6}.\n$$\n\nWriting $7\\,\\frac{2}{3}$ as an improper fraction, we have\n\n$$\n7\\,\\frac{2}{3}=\\frac{7\\times 3+2}{3}=\\frac{23}{3}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{53}{6}-\\frac{23}{3}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $6.$\n\nTo put $\\frac{23}{3}$ over a denominator of $6,$ we multiply the numerator and denominator by $2:$\n\n$$\n\\frac{23}{3}=\\frac{23\\times 2}{3\\times 2}=\\frac{46}{6}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{53}{6}-\\frac{46}{6}=\\frac{7}{6}\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{7}{6}=1\\,\\text{R}\\,1=1\\,\\frac{1}{6}\n$$\n\nTherefore, the painter had $1\\,\\frac{1}{6}$ liters of thinner left over."] [:db/cas 17592186505757 :question/worked-solution "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨2xz,0,{x}^{2}⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(\\operatorname{ln}⁡x)+\\frac{∂}{∂y}(x{z}^{3})+\\frac{∂}{∂z}({z}^{2})=\\frac{1}{x}+2z.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & ={x}^{2}z(\\frac{1}{x}+2z)+⟨\\operatorname{ln}⁡x,x{z}^{3},{z}^{2}⟩\\cdot ⟨2xz,0,{x}^{2}⟩ \\\\  & =xz+2{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x+{x}^{2}{z}^{2} \\\\  & =xz+3{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x \\\\  & =xz(1+3xz+2\\operatorname{ln}⁡x).\\end{aligned}\n$$" "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨2xz,0,{x}^{2}⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(\\operatorname{ln}⁡x)+\\frac{∂}{∂y}(x{z}^{3})+\\frac{∂}{∂z}({z}^{2})=\\frac{1}{x}+2z.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & ={x}^{2}z\\left(\\frac{1}{x}+2z\\right)+⟨\\operatorname{ln}⁡x,x{z}^{3},{z}^{2}⟩\\cdot ⟨2xz,0,{x}^{2}⟩ \\\\  & =xz+2{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x+{x}^{2}{z}^{2} \\\\  & =xz+3{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x \\\\  & =xz(1+3xz+2\\operatorname{ln}⁡x).\\end{aligned}\n$$"] [:db/cas 17592186505772 :question/problem "Evaluate $\\operatorname{artanh}⁡(-\\frac{\\sqrt{3}}{5}).$ **Do not round** your answer.\n\n$\\operatorname{artanh}⁡(-\\frac{\\sqrt{3}}{5})=\\frac{1}{2}\\operatorname{ln}⁡($\n{{field-1}}$)$" "Evaluate $\\operatorname{artanh}⁡\\left(-\\frac{\\sqrt{3}}{5}\\right).$ **Do not round** your answer.\n\n$\\operatorname{artanh}⁡\\left(-\\frac{\\sqrt{3}}{5}\\right)=\\frac{1}{2}\\operatorname{ln}⁡($\n{{field-1}}$)$"] [:db/cas 17592186505778 :question/problem "Given that $y\\in (-2,2),$ which of the following is equivalent to\n$\\operatorname{artanh}⁡(-\\frac{y}{2})?$" "Given that $y\\in (-2,2),$ which of the following is equivalent to\n$\\operatorname{artanh}⁡\\left(-\\frac{y}{2}\\right)?$"] [:db/cas 17592186505780 :question/worked-solution "We use the identity $$\n\\displaystyle \\operatorname{cot}⁡2x=\\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\n$$ and rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡(2x)}{{\\sin }^{4}⁡(2x)}\\,\\text{d}x & ={\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{\\sin }^{4}⁡(2x)}\\cdot \\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{\\sin }^{5}⁡(2x)}\\cdot \\operatorname{cos}⁡2x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\frac{1}{2}\\text{d}u=\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡2x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{\\sin }^{5}⁡(2x)}\\cdot \\operatorname{cos}⁡2x\\,\\text{d}x & ={\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\left(\\frac{{u}^{-4}}{-4}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{8}\\left(\\frac{1}{{u}^{4}}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{8}(\\frac{1}{{1}^{4}}-{\\left(\\frac{2}{1}\\right)}^{4}) \\\\  & =-\\frac{1}{8}(1-16) \\\\  & =\\frac{15}{8}.\\end{aligned}\\end{aligned}\n$$" "We use the identity $$\n\\displaystyle \\operatorname{cot}⁡2x=\\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\n$$ and rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡(2x)}{{\\sin }^{4}⁡(2x)}\\,\\text{d}x & ={\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{\\sin }^{4}⁡(2x)}\\cdot \\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{\\sin }^{5}⁡(2x)}\\cdot \\operatorname{cos}⁡2x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\frac{1}{2}\\text{d}u=\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡2x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{\\sin }^{5}⁡(2x)}\\cdot \\operatorname{cos}⁡2x\\,\\text{d}x & ={\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\left(\\frac{{u}^{-4}}{-4}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{8}\\left(\\frac{1}{{u}^{4}}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{8}\\left(\\frac{1}{{1}^{4}}-{\\left(\\frac{2}{1}\\right)}^{4}\\right) \\\\  & =-\\frac{1}{8}(1-16) \\\\  & =\\frac{15}{8}.\\end{aligned}\\end{aligned}\n$$"] [:db/cas 17592186505784 :question/problem "Given that $p\\ge 25,$ express $\\operatorname{arcosh}⁡(\\frac{{p}^{2}+25}{10p})$ using the definition of the inverse hyperbolic cosine.\n\n$\\operatorname{arcosh}⁡(\\frac{{p}^{2}+25}{10p})=\\operatorname{ln}⁡($\n{{field-1}}$)$" "Given that $p\\ge 25,$ express $\\operatorname{arcosh}⁡\\left(\\frac{{p}^{2}+25}{10p}\\right)$ using the definition of the inverse hyperbolic cosine.\n\n$\\operatorname{arcosh}⁡\\left(\\frac{{p}^{2}+25}{10p}\\right)=\\operatorname{ln}⁡($\n{{field-1}}$)$"] [:db/cas 17592186505784 :question/worked-solution "The definition of $\\operatorname{arcosh}⁡x$ is \n\n$$\n\\operatorname{arcosh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\left(\\frac{{p}^{2}+25}{10p}\\right) & =\\operatorname{ln}⁡(\\frac{{p}^{2}+25}{10p}+\\sqrt{{\\left(\\frac{{p}^{2}+25}{10p}\\right)}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(\\frac{{p}^{2}+25}{10p}+\\sqrt{\\frac{{p}^{4}+50{p}^{2}+625}{100{p}^{2}}-1}) \\\\  & =\\operatorname{ln}⁡(\\frac{{p}^{2}+25}{10p}+\\sqrt{\\frac{{p}^{4}-50{p}^{2}+625}{100{p}^{2}}}) \\\\  & =\\operatorname{ln}⁡(\\frac{{p}^{2}+25}{10p}+\\sqrt{{\\left(\\frac{{p}^{2}-25}{10p}\\right)}^{2}}) \\\\  & =\\operatorname{ln}⁡(\\frac{{p}^{2}+25}{10p}+|\\frac{{p}^{2}-25}{10p}|)\\end{aligned}\n$$\n\nSince $p\\ge 25,$ we have $\\frac{{p}^{2}-25}{10p}>0,$ and we can remove the absolute value in the above expression. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\left(\\frac{{p}^{2}+25}{10p}\\right) & =\\operatorname{ln}⁡(\\frac{{p}^{2}+25}{10p}+\\frac{{p}^{2}-25}{10p}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{p}{5}\\right).\\end{aligned}\n$$" "The definition of $\\operatorname{arcosh}⁡x$ is \n\n$$\n\\operatorname{arcosh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\left(\\frac{{p}^{2}+25}{10p}\\right) & =\\operatorname{ln}⁡\\left(\\frac{{p}^{2}+25}{10p}+\\sqrt{{\\left(\\frac{{p}^{2}+25}{10p}\\right)}^{2}-1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{p}^{2}+25}{10p}+\\sqrt{\\frac{{p}^{4}+50{p}^{2}+625}{100{p}^{2}}-1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{p}^{2}+25}{10p}+\\sqrt{\\frac{{p}^{4}-50{p}^{2}+625}{100{p}^{2}}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{p}^{2}+25}{10p}+\\sqrt{{\\left(\\frac{{p}^{2}-25}{10p}\\right)}^{2}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{p}^{2}+25}{10p}+|\\frac{{p}^{2}-25}{10p}|\\right)\\end{aligned}\n$$\n\nSince $p\\ge 25,$ we have $\\frac{{p}^{2}-25}{10p}>0,$ and we can remove the absolute value in the above expression. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\left(\\frac{{p}^{2}+25}{10p}\\right) & =\\operatorname{ln}⁡\\left(\\frac{{p}^{2}+25}{10p}+\\frac{{p}^{2}-25}{10p}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{p}{5}\\right).\\end{aligned}\n$$"] [:db/cas 17592186505785 :question/problem "Find the second-degree Taylor polynomial ${P}_{2}(x)$ of $f(x)=\\frac{1}{1-x}$ about $x=\\frac{1}{2}.$\n\n${P}_{2}(x)=$\n{{field-1}}$\\,+$\n{{field-2}}$(x-\\frac{1}{2})\\,+$\n{{field-3}}${(x-\\frac{1}{2})}^{2}$" "Find the second-degree Taylor polynomial ${P}_{2}(x)$ of $f(x)=\\frac{1}{1-x}$ about $x=\\frac{1}{2}.$\n\n${P}_{2}(x)=$\n{{field-1}}$\\,+$\n{{field-2}}$\\left(x-\\frac{1}{2}\\right)\\,+$\n{{field-3}}${\\left(x-\\frac{1}{2}\\right)}^{2}$"] [:db/cas 17592186505785 :question/worked-solution "To find the second-degree Taylor polynomial about $x=\\frac{1}{2},$ we plug $a=\\frac{1}{2}$ into the general formula to give\n\n$$\n{P}_{2}(x)=f\\left(\\frac{1}{2}\\right)+{f}^{′}\\left(\\frac{1}{2}\\right)(x-\\frac{1}{2})+\\frac{1}{2}{f}^{″}\\left(\\frac{1}{2}\\right){(x-\\frac{1}{2})}^{2}.\n$$\n\nSo, we need to work out $f\\left(\\frac{1}{2}\\right),$ ${f}^{′}\\left(\\frac{1}{2}\\right),$ and ${f}^{″}\\left(\\frac{1}{2}\\right):$ \n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{1-x} & ⟹ &  & f\\left(\\frac{1}{2}\\right) & =2 \\\\ {f}^{′}(x) & =\\frac{1}{(1-x)^{2}} & ⟹ &  & {f}^{′}\\left(\\frac{1}{2}\\right) & =4 \\\\ {f}^{″}(x) & =\\frac{2}{(1-x)^{3}} & ⟹ &  & {f}^{″}\\left(\\frac{1}{2}\\right) & =16\\end{aligned}\n$$\n\nWe now plug the results for $f\\left(\\frac{1}{2}\\right),$ ${f}^{′}\\left(\\frac{1}{2}\\right),$ and ${f}^{″}\\left(\\frac{1}{2}\\right)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =2+4(x-\\frac{1}{2})+16\\cdot \\frac{1}{2}{(x-\\frac{1}{2})}^{2} \\\\  & =2+4(x-\\frac{1}{2})+8{(x-\\frac{1}{2})}^{2}.\\end{aligned}\n$$" "To find the second-degree Taylor polynomial about $x=\\frac{1}{2},$ we plug $a=\\frac{1}{2}$ into the general formula to give\n\n$$\n{P}_{2}(x)=f\\left(\\frac{1}{2}\\right)+{f}^{′}\\left(\\frac{1}{2}\\right)\\left(x-\\frac{1}{2}\\right)+\\frac{1}{2}{f}^{″}\\left(\\frac{1}{2}\\right){\\left(x-\\frac{1}{2}\\right)}^{2}.\n$$\n\nSo, we need to work out $f\\left(\\frac{1}{2}\\right),$ ${f}^{′}\\left(\\frac{1}{2}\\right),$ and ${f}^{″}\\left(\\frac{1}{2}\\right):$ \n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{1-x} & ⟹ &  & f\\left(\\frac{1}{2}\\right) & =2 \\\\ {f}^{′}(x) & =\\frac{1}{(1-x)^{2}} & ⟹ &  & {f}^{′}\\left(\\frac{1}{2}\\right) & =4 \\\\ {f}^{″}(x) & =\\frac{2}{(1-x)^{3}} & ⟹ &  & {f}^{″}\\left(\\frac{1}{2}\\right) & =16\\end{aligned}\n$$\n\nWe now plug the results for $f\\left(\\frac{1}{2}\\right),$ ${f}^{′}\\left(\\frac{1}{2}\\right),$ and ${f}^{″}\\left(\\frac{1}{2}\\right)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =2+4\\left(x-\\frac{1}{2}\\right)+16\\cdot \\frac{1}{2}{\\left(x-\\frac{1}{2}\\right)}^{2} \\\\  & =2+4\\left(x-\\frac{1}{2}\\right)+8{\\left(x-\\frac{1}{2}\\right)}^{2}.\\end{aligned}\n$$"] [:db/cas 17592186505789 :question/problem "$$\n\\operatorname{artanh}⁡(-\\frac{1}{4})=\n$$" "$$\n\\operatorname{artanh}⁡\\left(-\\frac{1}{4}\\right)=\n$$"] [:db/cas 17592186505790 :question/problem "$$\n\\operatorname{arsinh}⁡(\\frac{\\sqrt{2}}{2})=\n$$" "$$\n\\operatorname{arsinh}⁡\\left(\\frac{\\sqrt{2}}{2}\\right)=\n$$"] [:db/cas 17592186505790 :question/worked-solution "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{\\sqrt{2}}{2}\\right) & =\\operatorname{ln}⁡(\\frac{\\sqrt{2}}{2}+\\sqrt{{\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{\\sqrt{2}}{2}+\\sqrt{\\frac{1}{2}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{\\sqrt{2}}{2}+\\sqrt{\\frac{3}{2}}) \\\\  & =\\operatorname{ln}⁡(\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{6}}{2}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{2}+\\sqrt{6}}{2}\\right).\\end{aligned}\n$$" "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{\\sqrt{2}}{2}\\right) & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{2}}{2}+\\sqrt{{\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{2}}{2}+\\sqrt{\\frac{1}{2}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{2}}{2}+\\sqrt{\\frac{3}{2}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{6}}{2}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{2}+\\sqrt{6}}{2}\\right).\\end{aligned}\n$$"] [:db/cas 17592186505792 :question/problem "$$\n\\operatorname{arsinh}⁡(\\frac{4}{3})=\n$$" "$$\n\\operatorname{arsinh}⁡\\left(\\frac{4}{3}\\right)=\n$$"] [:db/cas 17592186505792 :question/worked-solution "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{4}{3}\\right) & =\\operatorname{ln}⁡(\\frac{4}{3}+\\sqrt{{\\left(\\frac{4}{3}\\right)}^{2}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{4}{3}+\\sqrt{\\frac{16}{9}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{4}{3}+\\sqrt{\\frac{25}{9}}) \\\\  & =\\operatorname{ln}⁡(\\frac{4}{3}+\\frac{5}{3}) \\\\  & =\\operatorname{ln}⁡3.\\end{aligned}\n$$" "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{4}{3}\\right) & =\\operatorname{ln}⁡\\left(\\frac{4}{3}+\\sqrt{{\\left(\\frac{4}{3}\\right)}^{2}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4}{3}+\\sqrt{\\frac{16}{9}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4}{3}+\\sqrt{\\frac{25}{9}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4}{3}+\\frac{5}{3}\\right) \\\\  & =\\operatorname{ln}⁡3.\\end{aligned}\n$$"] [:db/cas 17592186505809 :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡3x}{\\operatorname{csc}⁡3x}\\,\\text{d}x={\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cot}⁡3x\\cdot \\frac{1}{\\operatorname{csc}⁡3x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $$\n\\displaystyle \\operatorname{cot}⁡3x=\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\n$$ and $\\frac{1}{\\operatorname{sin}⁡3x}=\\operatorname{csc}⁡3x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\\cdot \\operatorname{sin}⁡3x\\,\\text{d}x={\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡3x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=3x.$ Then $\\text{d}x=\\frac{1}{3}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=3x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi }{4}$ | $\\frac{3\\pi }{4}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡3x\\,\\text{d}x & ={\\int }_{\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡u\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{sin}⁡u{|}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{3}(\\operatorname{sin}⁡\\left(\\frac{3\\pi }{4}\\right)-\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)) \\\\  & =\\frac{1}{3}(\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$" "We can write the integral as\n\n$$\n{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡3x}{\\operatorname{csc}⁡3x}\\,\\text{d}x={\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cot}⁡3x\\cdot \\frac{1}{\\operatorname{csc}⁡3x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $$\n\\displaystyle \\operatorname{cot}⁡3x=\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\n$$ and $\\frac{1}{\\operatorname{sin}⁡3x}=\\operatorname{csc}⁡3x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\\cdot \\operatorname{sin}⁡3x\\,\\text{d}x={\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡3x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=3x.$ Then $\\text{d}x=\\frac{1}{3}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=3x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi }{4}$ | $\\frac{3\\pi }{4}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡3x\\,\\text{d}x & ={\\int }_{\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡u\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{sin}⁡u{|}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{3}\\left(\\operatorname{sin}⁡\\left(\\frac{3\\pi }{4}\\right)-\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\right) \\\\  & =\\frac{1}{3}\\left(\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$"] [:db/cas 17592186505812 :question/problem "Given that $-2<w<1,$ express $\\operatorname{artanh}⁡(\\frac{2w+1}{3})$ using the definition of the inverse hyperbolic tangent.\n\n$\\operatorname{artanh}⁡(\\frac{2w+1}{3})=\\frac{1}{2}\\operatorname{ln}⁡($\n{{field-1}}\n$)$" "Given that $-2<w<1,$ express $\\operatorname{artanh}⁡\\left(\\frac{2w+1}{3}\\right)$ using the definition of the inverse hyperbolic tangent.\n\n$\\operatorname{artanh}⁡\\left(\\frac{2w+1}{3}\\right)=\\frac{1}{2}\\operatorname{ln}⁡($\n{{field-1}}\n$)$"] [:db/cas 17592186505828 :question/worked-solution "We use the identity $$\n\\displaystyle \\operatorname{cot}⁡3x=\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\n$$ and rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{\\pi /18}^{\\pi /6}\\frac{\\operatorname{cot}⁡(3x)}{{\\sin }^{4}⁡(3x)}\\,\\text{d}x & ={\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{\\sin }^{4}⁡(3x)}\\cdot \\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{\\sin }^{5}⁡(3x)}\\cdot \\operatorname{cos}⁡3x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡3x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\operatorname{cos}⁡3x\\,⟹\\,\\frac{1}{3}\\text{d}u=\\operatorname{cos}⁡3x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡3x.$\n\n| $x$ | $\\frac{\\pi }{18}$ | $\\frac{\\pi }{6}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{\\sin }^{5}⁡(3x)}\\cdot \\operatorname{cos}⁡3x\\,\\text{d}x & ={\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{1/2}^{1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\left(\\frac{{u}^{-4}}{-4}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{12}\\left(\\frac{1}{{u}^{4}}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{12}(\\frac{1}{{1}^{4}}-{\\left(\\frac{2}{1}\\right)}^{4}) \\\\  & =-\\frac{1}{12}(1-16) \\\\  & =\\frac{5}{4}.\\end{aligned}\\end{aligned}\n$$" "We use the identity $$\n\\displaystyle \\operatorname{cot}⁡3x=\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\n$$ and rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{\\pi /18}^{\\pi /6}\\frac{\\operatorname{cot}⁡(3x)}{{\\sin }^{4}⁡(3x)}\\,\\text{d}x & ={\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{\\sin }^{4}⁡(3x)}\\cdot \\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{\\sin }^{5}⁡(3x)}\\cdot \\operatorname{cos}⁡3x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡3x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\operatorname{cos}⁡3x\\,⟹\\,\\frac{1}{3}\\text{d}u=\\operatorname{cos}⁡3x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡3x.$\n\n| $x$ | $\\frac{\\pi }{18}$ | $\\frac{\\pi }{6}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{\\sin }^{5}⁡(3x)}\\cdot \\operatorname{cos}⁡3x\\,\\text{d}x & ={\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{1/2}^{1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\left(\\frac{{u}^{-4}}{-4}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{12}\\left(\\frac{1}{{u}^{4}}\\right){|}_{1/2}^{1} \\\\  & =-\\frac{1}{12}\\left(\\frac{1}{{1}^{4}}-{\\left(\\frac{2}{1}\\right)}^{4}\\right) \\\\  & =-\\frac{1}{12}(1-16) \\\\  & =\\frac{5}{4}.\\end{aligned}\\end{aligned}\n$$"] [:db/cas 17592186505845 :question/problem "Which of the following is equivalent to $\\operatorname{arsinh}⁡(\\frac{{t}^{2}-1}{2t}),$ for $t>0?$" "Which of the following is equivalent to $\\operatorname{arsinh}⁡\\left(\\frac{{t}^{2}-1}{2t}\\right),$ for $t>0?$"] [:db/cas 17592186505845 :question/worked-solution "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{{t}^{2}-1}{2t}\\right) & =\\operatorname{ln}⁡(\\frac{{t}^{2}-1}{2t}+\\sqrt{{\\left(\\frac{{t}^{2}-1}{2t}\\right)}^{2}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{{t}^{2}-1}{2t}+\\sqrt{\\frac{{t}^{4}-2{t}^{2}+1}{4{t}^{2}}+1}) \\\\  & =\\operatorname{ln}⁡(\\frac{{t}^{2}-1}{2t}+\\sqrt{\\frac{{t}^{4}+2{t}^{2}+1}{4{t}^{2}}}) \\\\  & =\\operatorname{ln}⁡(\\frac{{t}^{2}-1}{2t}+\\sqrt{{\\left(\\frac{{t}^{2}+1}{2t}\\right)}^{2}}) \\\\  & =\\operatorname{ln}⁡(\\frac{{t}^{2}-1}{2t}+|\\frac{{t}^{2}+1}{2t}|)\\end{aligned}\n$$\n\nSince $t>0,$ we have $\\frac{{t}^{2}+1}{2t}>0,$ and we can remove the absolute value in the above expression. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{{t}^{2}-1}{2t}\\right) & =\\operatorname{ln}⁡(\\frac{{t}^{2}-1}{2t}+\\frac{{t}^{2}+1}{2t}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{2{t}^{2}}{2t}\\right) \\\\  & =\\operatorname{ln}⁡t.\\end{aligned}\n$$" "The definition of $\\operatorname{arsinh}⁡x$ is \n\n$$\n\\operatorname{arsinh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{{t}^{2}-1}{2t}\\right) & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}-1}{2t}+\\sqrt{{\\left(\\frac{{t}^{2}-1}{2t}\\right)}^{2}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}-1}{2t}+\\sqrt{\\frac{{t}^{4}-2{t}^{2}+1}{4{t}^{2}}+1}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}-1}{2t}+\\sqrt{\\frac{{t}^{4}+2{t}^{2}+1}{4{t}^{2}}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}-1}{2t}+\\sqrt{{\\left(\\frac{{t}^{2}+1}{2t}\\right)}^{2}}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}-1}{2t}+|\\frac{{t}^{2}+1}{2t}|\\right)\\end{aligned}\n$$\n\nSince $t>0,$ we have $\\frac{{t}^{2}+1}{2t}>0,$ and we can remove the absolute value in the above expression. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{arsinh}⁡\\left(\\frac{{t}^{2}-1}{2t}\\right) & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}-1}{2t}+\\frac{{t}^{2}+1}{2t}\\right) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{2{t}^{2}}{2t}\\right) \\\\  & =\\operatorname{ln}⁡t.\\end{aligned}\n$$"] [:db/cas 17592186506509 :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x} \\\\  & =({x}^{2}+2x)^{6}(\\operatorname{sin}⁡x)^{1/3}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2x)^{6}(\\operatorname{sin}⁡x)^{1/3}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2x)^{6})+\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/3}) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡({x}^{2}+2x)+\\frac{1}{3}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{ln}⁡({x}^{2}+2x)+\\frac{1}{3}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{{x}^{2}+2x}\\cdot (2x+2)+\\frac{1}{3}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot (\\operatorname{cos}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3})\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+2x)^{6}\\sqrt{\\operatorname{sin}⁡x}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}) \\\\  & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cos}⁡x}{3\\operatorname{sin}⁡x}) \\\\  & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}\\left(\\frac{36(x+1)\\operatorname{sin}⁡x+({x}^{2}+2x)\\operatorname{cos}⁡x}{3({x}^{2}+2x)\\operatorname{sin}⁡x}\\right) \\\\  & =\\frac{({x}^{2}+2x)^{5}}{3\\sqrt[3]{{\\sin }^{2}⁡x}}((36x+36)\\operatorname{sin}⁡x+(1{x}^{2}+2x)\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=36+1+2=39.\n$$" "Our function can be written as\n\n$$\n\\begin{aligned}y & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x} \\\\  & =({x}^{2}+2x)^{6}(\\operatorname{sin}⁡x)^{1/3}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2x)^{6}(\\operatorname{sin}⁡x)^{1/3}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2x)^{6})+\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/3}) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡({x}^{2}+2x)+\\frac{1}{3}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(6\\operatorname{ln}⁡({x}^{2}+2x)+\\frac{1}{3}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{{x}^{2}+2x}\\cdot (2x+2)+\\frac{1}{3}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot (\\operatorname{cos}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+2x)^{6}\\sqrt{\\operatorname{sin}⁡x}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}\\left(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}\\right) \\\\  & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}\\left(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cos}⁡x}{3\\operatorname{sin}⁡x}\\right) \\\\  & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}\\left(\\frac{36(x+1)\\operatorname{sin}⁡x+({x}^{2}+2x)\\operatorname{cos}⁡x}{3({x}^{2}+2x)\\operatorname{sin}⁡x}\\right) \\\\  & =\\frac{({x}^{2}+2x)^{5}}{3\\sqrt[3]{{\\sin }^{2}⁡x}}((36x+36)\\operatorname{sin}⁡x+(1{x}^{2}+2x)\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=36+1+2=39.\n$$"] [:db/cas 17592186506511 :question/worked-solution "Let the random variable $X$ be equal to the number of times the spinner lands on blue.\n\nHere, we have the following information:\n\n- there are $n=21$ trials\n\n- the probability of landing on blue is\n\n$$\np=\\frac{1}{3}.\n$$\n\nSo, $X$ follows a binomial distribution, where $X∼B(21,\\frac{1}{3}).$\n\nFor a binomial random variable $X,$ the variance is given by\n\n$$\n\\text{Var}[X]=np(1-p),\n$$\n\nwhere $n$ is the number of experiments and $p$ is the probability of success on each experiment.\n\nSo, the variance of the number of times the spinner lands on blue is\n\n$$\n\\begin{aligned}\\text{Var}[X] & =np(1-p) \\\\  & =21\\cdot \\frac{1}{3}\\cdot (1-\\frac{1}{3}) \\\\  & =7\\cdot \\frac{2}{3} \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$" "Let the random variable $X$ be equal to the number of times the spinner lands on blue.\n\nHere, we have the following information:\n\n- there are $n=21$ trials\n\n- the probability of landing on blue is\n\n$$\np=\\frac{1}{3}.\n$$\n\nSo, $X$ follows a binomial distribution, where $X∼B\\left(21,\\frac{1}{3}\\right).$\n\nFor a binomial random variable $X,$ the variance is given by\n\n$$\n\\text{Var}[X]=np(1-p),\n$$\n\nwhere $n$ is the number of experiments and $p$ is the probability of success on each experiment.\n\nSo, the variance of the number of times the spinner lands on blue is\n\n$$\n\\begin{aligned}\\text{Var}[X] & =np(1-p) \\\\  & =21\\cdot \\frac{1}{3}\\cdot \\left(1-\\frac{1}{3}\\right) \\\\  & =7\\cdot \\frac{2}{3} \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$"] [:db/cas 17592186506513 :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+6)^{3})+\\operatorname{ln}⁡({\\cos }^{4}⁡x)-\\operatorname{ln}⁡((x-1)^{7}) \\\\ \\operatorname{ln}⁡y & =3\\operatorname{ln}⁡(x+6)+4\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-7\\operatorname{ln}⁡(x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(x+6)+4\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-7\\operatorname{ln}⁡(x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =3\\cdot \\frac{1}{x+6}+4\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x)-7\\cdot \\frac{1}{x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}(\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}) \\\\  & =\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\left(\\frac{3(x-1)-4\\operatorname{tan}⁡x(x+6)(x-1)-7(x+6)}{(x+6)(x-1)}\\right) \\\\  & =\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\left(\\frac{-4x-45-4\\operatorname{tan}⁡x({x}^{2}+5x-6)}{(x+6)(x-1)}\\right) \\\\  & =-\\frac{(x+6)^{2}{\\cos }^{4}⁡x}{(x-1)^{8}}(4x+45+4\\operatorname{tan}⁡x({x}^{2}+5x-6)) \\\\  & =-\\frac{(x+6)^{2}{\\cos }^{3}⁡x}{(x-1)^{8}}((4x+45)\\operatorname{cos}⁡x+4\\operatorname{tan}⁡x({x}^{2}+5x-6)\\operatorname{cos}⁡x) \\\\  & =-\\frac{(x+6)^{2}{\\cos }^{3}⁡x}{(x-1)^{8}}((4x+45)\\operatorname{cos}⁡x+\\operatorname{sin}⁡x(4{x}^{2}+20x-24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=4+20+(-24)=0.\n$$" "We have the function \n\n$$\ny=\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+6)^{3})+\\operatorname{ln}⁡({\\cos }^{4}⁡x)-\\operatorname{ln}⁡((x-1)^{7}) \\\\ \\operatorname{ln}⁡y & =3\\operatorname{ln}⁡(x+6)+4\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-7\\operatorname{ln}⁡(x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(x+6)+4\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-7\\operatorname{ln}⁡(x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =3\\cdot \\frac{1}{x+6}+4\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x)-7\\cdot \\frac{1}{x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\left(\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}\\right) \\\\  & =\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\left(\\frac{3(x-1)-4\\operatorname{tan}⁡x(x+6)(x-1)-7(x+6)}{(x+6)(x-1)}\\right) \\\\  & =\\frac{(x+6)^{3}{\\cos }^{4}⁡x}{(x-1)^{7}}\\left(\\frac{-4x-45-4\\operatorname{tan}⁡x({x}^{2}+5x-6)}{(x+6)(x-1)}\\right) \\\\  & =-\\frac{(x+6)^{2}{\\cos }^{4}⁡x}{(x-1)^{8}}(4x+45+4\\operatorname{tan}⁡x({x}^{2}+5x-6)) \\\\  & =-\\frac{(x+6)^{2}{\\cos }^{3}⁡x}{(x-1)^{8}}((4x+45)\\operatorname{cos}⁡x+4\\operatorname{tan}⁡x({x}^{2}+5x-6)\\operatorname{cos}⁡x) \\\\  & =-\\frac{(x+6)^{2}{\\cos }^{3}⁡x}{(x-1)^{8}}((4x+45)\\operatorname{cos}⁡x+\\operatorname{sin}⁡x(4{x}^{2}+20x-24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=4+20+(-24)=0.\n$$"] [:db/cas 17592186506517 :question/worked-solution "We have the function \n\n$$\ny=({x}^{4}+1){3}^{x+4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+1){3}^{x+4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+1)+\\operatorname{ln}⁡({3}^{x+4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+1)+(x+4)\\operatorname{ln}⁡(3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{4}+1)+(x+4)\\operatorname{ln}⁡(3)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{4}+1}\\cdot 4{x}^{3}+\\operatorname{ln}⁡(3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3))\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{4}+1){3}^{x+4}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{4}+1){3}^{x+4}(\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)) \\\\  & ={3}^{x+4}(4{x}^{3}+\\operatorname{ln}⁡(3)({x}^{4}+1)) \\\\  & ={3}^{x+4}(\\operatorname{ln}⁡(3){x}^{4}+4{x}^{3}+\\operatorname{ln}⁡(3))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=\\operatorname{ln}⁡(3)+4+\\operatorname{ln}⁡(3)=4+2\\operatorname{ln}⁡(3).\n$$" "We have the function \n\n$$\ny=({x}^{4}+1){3}^{x+4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+1){3}^{x+4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+1)+\\operatorname{ln}⁡({3}^{x+4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+1)+(x+4)\\operatorname{ln}⁡(3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{4}+1)+(x+4)\\operatorname{ln}⁡(3)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{4}+1}\\cdot 4{x}^{3}+\\operatorname{ln}⁡(3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{4}+1){3}^{x+4}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{4}+1){3}^{x+4}\\left(\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)\\right) \\\\  & ={3}^{x+4}(4{x}^{3}+\\operatorname{ln}⁡(3)({x}^{4}+1)) \\\\  & ={3}^{x+4}(\\operatorname{ln}⁡(3){x}^{4}+4{x}^{3}+\\operatorname{ln}⁡(3))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=\\operatorname{ln}⁡(3)+4+\\operatorname{ln}⁡(3)=4+2\\operatorname{ln}⁡(3).\n$$"] [:db/cas 17592186506518 :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}} \\\\  & ={[\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}]}^{1/4} \\\\  & =({x}^{2}+4)^{1/4}(2{x}^{2}+1)^{-2}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{1/4}(2{x}^{2}+1)^{-2}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{1/4})+\\operatorname{ln}⁡((2{x}^{2}+1)^{-2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+4)-2\\operatorname{ln}⁡(2{x}^{2}+1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+4)-2\\operatorname{ln}⁡(2{x}^{2}+1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{4}\\cdot \\frac{1}{{x}^{2}+4}\\cdot (2x)-2\\cdot \\frac{1}{2{x}^{2}+1}\\cdot (4x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{x}{2({x}^{2}+4)}-\\frac{8x}{2{x}^{2}+1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1})\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{2}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}}\\cdot \\frac{1}{2}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}\\left(\\frac{x(2{x}^{2}+1)-16x({x}^{2}+4)}{({x}^{2}+4)(2{x}^{2}+1)}\\right) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}\\left(\\frac{-14{x}^{3}-63x}{({x}^{2}+4)(2{x}^{2}+1)}\\right) \\\\  & =-\\frac{x(14{x}^{2}+63)}{2(2{x}^{2}+1)^{3}\\sqrt[4]{({x}^{2}+4)^{3}}}\\end{aligned}\n$$" "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}} \\\\  & ={\\left[\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}\\right]}^{1/4} \\\\  & =({x}^{2}+4)^{1/4}(2{x}^{2}+1)^{-2}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{1/4}(2{x}^{2}+1)^{-2}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{1/4})+\\operatorname{ln}⁡((2{x}^{2}+1)^{-2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+4)-2\\operatorname{ln}⁡(2{x}^{2}+1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+4)-2\\operatorname{ln}⁡(2{x}^{2}+1)\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{4}\\cdot \\frac{1}{{x}^{2}+4}\\cdot (2x)-2\\cdot \\frac{1}{2{x}^{2}+1}\\cdot (4x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{x}{2({x}^{2}+4)}-\\frac{8x}{2{x}^{2}+1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}\\left(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}\\right)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{2}\\left(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}}\\cdot \\frac{1}{2}\\left(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}\\right) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}\\left(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}\\right) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}\\left(\\frac{x(2{x}^{2}+1)-16x({x}^{2}+4)}{({x}^{2}+4)(2{x}^{2}+1)}\\right) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}\\left(\\frac{-14{x}^{3}-63x}{({x}^{2}+4)(2{x}^{2}+1)}\\right) \\\\  & =-\\frac{x(14{x}^{2}+63)}{2(2{x}^{2}+1)^{3}\\sqrt[4]{({x}^{2}+4)^{3}}}\\end{aligned}\n$$"] [:db/cas 17592186506521 :question/worked-solution "We have the function \n\n$$\ny=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}+1)+x\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+1)+x\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{2}+1}\\cdot (2x)+(x)^{′}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x{(\\operatorname{ln}⁡(\\operatorname{sin}⁡x))}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x} \\\\ \\frac{{y}^{′}}{y} & =\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}(\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x) \\\\  & =(\\operatorname{sin}⁡x)^{x}(2x+({x}^{2}+1)\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x({x}^{2}+1)\\operatorname{cot}⁡x) \\\\  & =(\\operatorname{sin}⁡x)^{x}(({x}^{2}+1)\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+2x+x({x}^{2}+1)\\operatorname{cot}⁡x)\\end{aligned}\n$$" "We have the function \n\n$$\ny=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}+1)+x\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+1)+x\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{2}+1}\\cdot (2x)+(x)^{′}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x{(\\operatorname{ln}⁡(\\operatorname{sin}⁡x))}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x} \\\\ \\frac{{y}^{′}}{y} & =\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}\\left(\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x\\right) \\\\  & =(\\operatorname{sin}⁡x)^{x}(2x+({x}^{2}+1)\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x({x}^{2}+1)\\operatorname{cot}⁡x) \\\\  & =(\\operatorname{sin}⁡x)^{x}(({x}^{2}+1)\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+2x+x({x}^{2}+1)\\operatorname{cot}⁡x)\\end{aligned}\n$$"] [:db/cas 17592186506524 :question/problem "Suppose we wish to find $$\n\\displaystyle L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}\n$$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}={{field-1}}.\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={A}^{′}(t)\\text{ }dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v={{field-3}}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ $0$, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-5}}\\,\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & ={{field-6}}.\\end{aligned}\n$$\n\n." "Suppose we wish to find $$\n\\displaystyle L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}\n$$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}={{field-1}}.\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={A}^{′}(t)\\text{ }dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v={{field-3}}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)\\left(-\\frac{1}{s}{e}^{-st}\\right)\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ $0$, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-5}}\\,\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & ={{field-6}}.\\end{aligned}\n$$\n\n."] [:db/cas 17592186506524 :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)\\left(-\\frac{1}{s}{e}^{-st}\\right)\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }\\left(-\\frac{1}{s}{e}^{-st}\\right){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"] [:db/cas 17592186506525 :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}3{z}^{2}-12 & =9z \\\\ 3{z}^{2}-9z-12 & =0 \\\\ 3({z}^{2}-3z-4) & =0 \\\\ {z}^{2}-3z-4 & =0 \\\\ {z}^{2}-2\\cdot z\\cdot \\frac{3}{2} & =4 \\\\ {z}^{2}-2\\cdot z\\cdot \\frac{3}{2}+{\\left(\\frac{3}{2}\\right)}^{2}-{\\left(\\frac{3}{2}\\right)}^{2} & =-4 \\\\ [{z}^{2}-2\\cdot z\\cdot \\frac{3}{2}+{\\left(\\frac{3}{2}\\right)}^{2}]-{\\left(\\frac{3}{2}\\right)}^{2} & =-4 \\\\ {(z-\\frac{3}{2})}^{2}-{\\left(\\frac{3}{2}\\right)}^{2} & =4 \\\\ {(z-\\frac{3}{2})}^{2}-\\frac{25}{4} & =0\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(z-\\frac{3}{2})}^{2}-{\\left(\\frac{3}{2}\\right)}^{2} & =4 \\\\ {(z-\\frac{3}{2})}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nSo, $p=-\\frac{3}{2},q=\\frac{25}{4}$ and $p+q=\\frac{19}{4}.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}{(z-\\frac{3}{2})}^{2} & =\\frac{25}{4} \\\\ \\sqrt{{(z-\\frac{3}{2})}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |z-\\frac{3}{2}| & =\\frac{5}{2} \\\\ z-\\frac{3}{2} & =\\pm \\frac{5}{2} \\\\ z & =\\frac{3}{2}\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}z & =\\frac{3}{2}+\\frac{5}{2}=4 \\\\ z & =\\frac{3}{2}-\\frac{5}{2}=-1\\end{aligned}\n$$\n\nTherefore, the solutions are $z=4$ and $z=-1.$" "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}3{z}^{2}-12 & =9z \\\\ 3{z}^{2}-9z-12 & =0 \\\\ 3({z}^{2}-3z-4) & =0 \\\\ {z}^{2}-3z-4 & =0 \\\\ {z}^{2}-2\\cdot z\\cdot \\frac{3}{2} & =4 \\\\ {z}^{2}-2\\cdot z\\cdot \\frac{3}{2}+{\\left(\\frac{3}{2}\\right)}^{2}-{\\left(\\frac{3}{2}\\right)}^{2} & =-4 \\\\ \\left[{z}^{2}-2\\cdot z\\cdot \\frac{3}{2}+{\\left(\\frac{3}{2}\\right)}^{2}\\right]-{\\left(\\frac{3}{2}\\right)}^{2} & =-4 \\\\ {\\left(z-\\frac{3}{2}\\right)}^{2}-{\\left(\\frac{3}{2}\\right)}^{2} & =4 \\\\ {\\left(z-\\frac{3}{2}\\right)}^{2}-\\frac{25}{4} & =0\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{\\left(z-\\frac{3}{2}\\right)}^{2}-{\\left(\\frac{3}{2}\\right)}^{2} & =4 \\\\ {\\left(z-\\frac{3}{2}\\right)}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nSo, $p=-\\frac{3}{2},q=\\frac{25}{4}$ and $p+q=\\frac{19}{4}.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}{\\left(z-\\frac{3}{2}\\right)}^{2} & =\\frac{25}{4} \\\\ \\sqrt{{\\left(z-\\frac{3}{2}\\right)}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |z-\\frac{3}{2}| & =\\frac{5}{2} \\\\ z-\\frac{3}{2} & =\\pm \\frac{5}{2} \\\\ z & =\\frac{3}{2}\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}z & =\\frac{3}{2}+\\frac{5}{2}=4 \\\\ z & =\\frac{3}{2}-\\frac{5}{2}=-1\\end{aligned}\n$$\n\nTherefore, the solutions are $z=4$ and $z=-1.$"] [:db/cas 17592186506527 :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}} \\\\  & =\\frac{\\sqrt{{({x}^{4}+2{x}^{2}+8)}^{2}}}{\\sqrt{\\operatorname{cos}⁡x}} \\\\  & =\\frac{{x}^{4}+2{x}^{2}+8}{(\\operatorname{cos}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{{x}^{4}+2{x}^{2}+8}{(\\operatorname{cos}⁡x)^{1/2}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\operatorname{ln}⁡((\\operatorname{cos}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{4}+2{x}^{2}+8}\\cdot (4{x}^{3}+4x)-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4{x}^{3}+4x}{{x}^{4}+2{x}^{2}+8}+\\frac{\\operatorname{tan}⁡x}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{2}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}}\\cdot \\frac{1}{2}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x) \\\\  & =\\frac{|{x}^{4}+2{x}^{2}+8|}{2\\sqrt{\\operatorname{cos}⁡x}}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nSince ${x}^{4}+2{x}^{2}+8>0\\text{ }∀x\\in R$, so $|{x}^{4}+2{x}^{2}+8|={x}^{4}+2{x}^{2}+8$ and we have:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{x}^{4}+2{x}^{2}+8}{2\\sqrt{\\operatorname{cos}⁡x}}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}[\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}\\cdot ({x}^{4}+2{x}^{2}+8)+\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8)] \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}(8{x}^{3}+8x+\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8))\\end{aligned}\n$$" "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}} \\\\  & =\\frac{\\sqrt{{({x}^{4}+2{x}^{2}+8)}^{2}}}{\\sqrt{\\operatorname{cos}⁡x}} \\\\  & =\\frac{{x}^{4}+2{x}^{2}+8}{(\\operatorname{cos}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{{x}^{4}+2{x}^{2}+8}{(\\operatorname{cos}⁡x)^{1/2}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\operatorname{ln}⁡((\\operatorname{cos}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{4}+2{x}^{2}+8}\\cdot (4{x}^{3}+4x)-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4{x}^{3}+4x}{{x}^{4}+2{x}^{2}+8}+\\frac{\\operatorname{tan}⁡x}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}\\left(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x\\right)\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{2}\\left(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}}\\cdot \\frac{1}{2}\\left(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x\\right) \\\\  & =\\frac{|{x}^{4}+2{x}^{2}+8|}{2\\sqrt{\\operatorname{cos}⁡x}}\\left(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x\\right)\\end{aligned}\n$$\n\nSince ${x}^{4}+2{x}^{2}+8>0\\text{ }∀x\\in R$, so $|{x}^{4}+2{x}^{2}+8|={x}^{4}+2{x}^{2}+8$ and we have:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{x}^{4}+2{x}^{2}+8}{2\\sqrt{\\operatorname{cos}⁡x}}\\left(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x\\right) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}\\left[\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}\\cdot ({x}^{4}+2{x}^{2}+8)+\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8)\\right] \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}(8{x}^{3}+8x+\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8))\\end{aligned}\n$$"] [:db/cas 17592186506532 :question/worked-solution "We have the function \n\n$$\ny=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient, product, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({6}^{\\operatorname{cos}⁡x})-\\operatorname{ln}⁡((x-2)^{4}(3-x)^{3}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6-(\\operatorname{ln}⁡((x-2)^{4})+\\operatorname{ln}⁡((3-x)^{3})) \\\\ \\operatorname{ln}⁡y & =\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6-4\\operatorname{ln}⁡(x-2)-3\\operatorname{ln}⁡(3-x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6)-\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x-2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(3-x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-4\\cdot \\frac{1}{x-2}-3\\cdot \\frac{-1}{3-x} \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}(-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\left(\\frac{-(\\operatorname{ln}⁡6)(x-2)(3-x)\\operatorname{sin}⁡x-4(3-x)+3(x-2)}{(x-2)(3-x)}\\right) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\left(\\frac{-(\\operatorname{ln}⁡6)(x-2)(3-x)\\operatorname{sin}⁡x+7x-18}{(x-2)(3-x)}\\right) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}(-\\operatorname{ln}⁡6(x-2)(3-x)\\operatorname{sin}⁡x+7x-18)}{(x-2)^{5}(3-x)^{4}}\\end{aligned}\n$$" "We have the function \n\n$$\ny=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient, product, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({6}^{\\operatorname{cos}⁡x})-\\operatorname{ln}⁡((x-2)^{4}(3-x)^{3}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6-(\\operatorname{ln}⁡((x-2)^{4})+\\operatorname{ln}⁡((3-x)^{3})) \\\\ \\operatorname{ln}⁡y & =\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6-4\\operatorname{ln}⁡(x-2)-3\\operatorname{ln}⁡(3-x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6)-\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x-2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(3-x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-4\\cdot \\frac{1}{x-2}-3\\cdot \\frac{-1}{3-x} \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\left(-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}\\right) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\left(\\frac{-(\\operatorname{ln}⁡6)(x-2)(3-x)\\operatorname{sin}⁡x-4(3-x)+3(x-2)}{(x-2)(3-x)}\\right) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}\\left(\\frac{-(\\operatorname{ln}⁡6)(x-2)(3-x)\\operatorname{sin}⁡x+7x-18}{(x-2)(3-x)}\\right) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}(-\\operatorname{ln}⁡6(x-2)(3-x)\\operatorname{sin}⁡x+7x-18)}{(x-2)^{5}(3-x)^{4}}\\end{aligned}\n$$"] [:db/cas 17592186506542 :question/worked-solution "The variable $a$ is being *divided* by $4.$ To isolate $a$ and remove the negative sign, we *multiply* by $-4.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{a}{4}\\,\\, & >\\,\\,-2 \\\\ (-4)\\cdot \\left(-\\frac{a}{4}\\right)\\,\\, & <\\,\\,(-4)\\cdot (-2) \\\\ (-4)\\cdot \\left(-\\frac{a}{4}\\right)\\,\\, & <\\,\\,8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-4)\\cdot \\left(-\\frac{a}{4}\\right) & <8 \\\\ (\\cancel{-}4)\\cdot (\\cancel{-}\\frac{a}{4}) & <8 \\\\ 4\\cdot \\frac{a}{4} & <8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $4$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}4\\cdot \\frac{a}{4} & <8 \\\\ \\frac{4a}{4} & <8 \\\\ \\frac{\\cancel{4}a}{\\cancel{4}} & <8 \\\\ a & <8\\end{aligned}\n$$\n\nTherefore, the solution is $a<8.$ The solution can be expressed on a number line, as shown below.\n\n \n\n![](images/eb/ebda9e955c2613aa9e65b950ac80ad7ec4e52d6db6fdcce76cc2f89bbc20b0d4.png)" "The variable $a$ is being *divided* by $4.$ To isolate $a$ and remove the negative sign, we *multiply* by $-4.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{a}{4}\\,\\, & >\\,\\,-2 \\\\ (-4)\\cdot \\left(-\\frac{a}{4}\\right)\\,\\, & <\\,\\,(-4)\\cdot (-2) \\\\ (-4)\\cdot \\left(-\\frac{a}{4}\\right)\\,\\, & <\\,\\,8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-4)\\cdot \\left(-\\frac{a}{4}\\right) & <8 \\\\ (\\cancel{-}4)\\cdot \\left(\\cancel{-}\\frac{a}{4}\\right) & <8 \\\\ 4\\cdot \\frac{a}{4} & <8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $4$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}4\\cdot \\frac{a}{4} & <8 \\\\ \\frac{4a}{4} & <8 \\\\ \\frac{\\cancel{4}a}{\\cancel{4}} & <8 \\\\ a & <8\\end{aligned}\n$$\n\nTherefore, the solution is $a<8.$ The solution can be expressed on a number line, as shown below.\n\n \n\n![](images/eb/ebda9e955c2613aa9e65b950ac80ad7ec4e52d6db6fdcce76cc2f89bbc20b0d4.png)"] [:db/cas 17592186506543 :question/worked-solution "We have the function \n\n$$\ny={x}^{x}\\operatorname{tan}⁡x.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{x}\\operatorname{tan}⁡x) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{x})+\\operatorname{ln}⁡(\\operatorname{tan}⁡x) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\operatorname{ln}⁡x+x{(\\operatorname{ln}⁡x)}^{′}+{[\\operatorname{ln}⁡(\\operatorname{tan}⁡x)]}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+x\\cdot \\frac{1}{x}+\\frac{1}{\\operatorname{tan}⁡x}\\cdot {\\sec }^{2}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1+\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\frac{1}{{\\cos }^{2}⁡x} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x})\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{x}\\operatorname{tan}⁡x:$\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{x}\\operatorname{tan}⁡x(\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\operatorname{tan}⁡x) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{{\\cos }^{2}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+{\\sec }^{2}⁡x)\\end{aligned}\n$$" "We have the function \n\n$$\ny={x}^{x}\\operatorname{tan}⁡x.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{x}\\operatorname{tan}⁡x) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{x})+\\operatorname{ln}⁡(\\operatorname{tan}⁡x) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\operatorname{ln}⁡x+x{(\\operatorname{ln}⁡x)}^{′}+{[\\operatorname{ln}⁡(\\operatorname{tan}⁡x)]}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+x\\cdot \\frac{1}{x}+\\frac{1}{\\operatorname{tan}⁡x}\\cdot {\\sec }^{2}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1+\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\frac{1}{{\\cos }^{2}⁡x} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{x}\\operatorname{tan}⁡x:$\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{x}\\operatorname{tan}⁡x\\left(\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\right) \\\\  & ={x}^{x}\\left(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\operatorname{tan}⁡x\\right) \\\\  & ={x}^{x}\\left(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\right) \\\\  & ={x}^{x}\\left(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{{\\cos }^{2}⁡x}\\right) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+{\\sec }^{2}⁡x)\\end{aligned}\n$$"] [:db/cas 17592186506546 :question/worked-solution "We have the function \n\n$$\ny=({x}^{3}-2x){e}^{{x}^{4}+5x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{3}-2x){e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+\\operatorname{ln}⁡({e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5 \\\\ \\frac{{y}^{′}}{y} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{3}-2x){e}^{{x}^{4}+5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{3}-2x){e}^{{x}^{4}+5x}(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5) \\\\  & ={e}^{{x}^{4}+5x}[3{x}^{2}-2+(4{x}^{3}+5)({x}^{3}-2x)] \\\\  & ={e}^{{x}^{4}+5x}(4{x}^{6}-8{x}^{4}+5{x}^{3}+3{x}^{2}-10x-2)\\end{aligned}\n$$" "We have the function \n\n$$\ny=({x}^{3}-2x){e}^{{x}^{4}+5x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{3}-2x){e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+\\operatorname{ln}⁡({e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5 \\\\ \\frac{{y}^{′}}{y} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{3}-2x){e}^{{x}^{4}+5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{3}-2x){e}^{{x}^{4}+5x}\\left(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5\\right) \\\\  & ={e}^{{x}^{4}+5x}[3{x}^{2}-2+(4{x}^{3}+5)({x}^{3}-2x)] \\\\  & ={e}^{{x}^{4}+5x}(4{x}^{6}-8{x}^{4}+5{x}^{3}+3{x}^{2}-10x-2)\\end{aligned}\n$$"] [:db/cas 17592186506548 :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{x}^{2}-6x+10) & =(-1)\\cdot 0 \\\\ 4{x}^{2}+6x-10 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}+6x-10 & =0 \\\\ 4{x}^{2}+6x & =10 \\\\ 4{x}^{2}+6x & =10 \\\\ 4({x}^{2}+\\frac{3}{2}x) & =10 \\\\ 4[{x}^{2}+2\\cdot \\frac{3}{4}x+{\\left(\\frac{3}{4}\\right)}^{2}-{\\left(\\frac{3}{4}\\right)}^{2}] & =10 \\\\ 4[{(x+\\frac{3}{4})}^{2}-\\frac{9}{16}] & =10\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(x+\\frac{3}{4})}^{2}-4\\cdot \\frac{9}{16} & =10 \\\\ 4{(x+\\frac{3}{4})}^{2}-\\frac{9}{4} & =10 \\\\ 4{(x+\\frac{3}{4})}^{2} & =10+\\frac{9}{4} \\\\ 4{(x+\\frac{3}{4})}^{2} & =\\frac{49}{4}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{3}{4}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(x+\\frac{3}{4})}^{2} & =\\frac{49}{4} \\\\ {(x+\\frac{3}{4})}^{2} & =\\frac{49}{16} \\\\ \\sqrt{{(x+\\frac{3}{4})}^{2}} & =\\sqrt{\\frac{49}{16}} \\\\ |x+\\frac{3}{4}| & =\\frac{7}{4} \\\\ x+\\frac{3}{4} & =\\pm \\frac{7}{4} \\\\ x & =-\\frac{3}{4}\\pm \\frac{7}{4}.\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-\\frac{3}{4}-\\frac{7}{4}=-\\frac{10}{4}=-\\frac{5}{2} \\\\ x & =-\\frac{3}{4}+\\frac{7}{4}=1\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{5}{2}$ and $x=1.$" "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{x}^{2}-6x+10) & =(-1)\\cdot 0 \\\\ 4{x}^{2}+6x-10 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}+6x-10 & =0 \\\\ 4{x}^{2}+6x & =10 \\\\ 4{x}^{2}+6x & =10 \\\\ 4\\left({x}^{2}+\\frac{3}{2}x\\right) & =10 \\\\ 4\\left[{x}^{2}+2\\cdot \\frac{3}{4}x+{\\left(\\frac{3}{4}\\right)}^{2}-{\\left(\\frac{3}{4}\\right)}^{2}\\right] & =10 \\\\ 4\\left[{\\left(x+\\frac{3}{4}\\right)}^{2}-\\frac{9}{16}\\right] & =10\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{\\left(x+\\frac{3}{4}\\right)}^{2}-4\\cdot \\frac{9}{16} & =10 \\\\ 4{\\left(x+\\frac{3}{4}\\right)}^{2}-\\frac{9}{4} & =10 \\\\ 4{\\left(x+\\frac{3}{4}\\right)}^{2} & =10+\\frac{9}{4} \\\\ 4{\\left(x+\\frac{3}{4}\\right)}^{2} & =\\frac{49}{4}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{3}{4}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{\\left(x+\\frac{3}{4}\\right)}^{2} & =\\frac{49}{4} \\\\ {\\left(x+\\frac{3}{4}\\right)}^{2} & =\\frac{49}{16} \\\\ \\sqrt{{\\left(x+\\frac{3}{4}\\right)}^{2}} & =\\sqrt{\\frac{49}{16}} \\\\ |x+\\frac{3}{4}| & =\\frac{7}{4} \\\\ x+\\frac{3}{4} & =\\pm \\frac{7}{4} \\\\ x & =-\\frac{3}{4}\\pm \\frac{7}{4}.\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-\\frac{3}{4}-\\frac{7}{4}=-\\frac{10}{4}=-\\frac{5}{2} \\\\ x & =-\\frac{3}{4}+\\frac{7}{4}=1\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{5}{2}$ and $x=1.$"] [:db/cas 17592186506552 :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}} \\\\  & =\\sqrt{({x}^{2}+1)^{3}}\\cdot \\sqrt{(x-3)^{8}} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{8/2} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2}(x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2})+\\operatorname{ln}⁡((x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+1}\\cdot 2x+4\\cdot \\frac{1}{x-3} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}\\left(\\frac{3x(x-3)+4({x}^{2}+1)}{({x}^{2}+1)(x-3)}\\right) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}\\left(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}\\right) \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}\\left(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}\\right) \\\\  & =({x}^{2}+1)^{1/2}(x-3)^{3}(7{x}^{2}-9x+4) \\\\  & =\\sqrt{{x}^{2}+1}(x-3)^{3}(7{x}^{2}-9x+4)\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\na+b+c=7+(-9)+4=2.\n$$" "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}} \\\\  & =\\sqrt{({x}^{2}+1)^{3}}\\cdot \\sqrt{(x-3)^{8}} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{8/2} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2}(x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2})+\\operatorname{ln}⁡((x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+1}\\cdot 2x+4\\cdot \\frac{1}{x-3} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}\\left(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}\\right) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}\\left(\\frac{3x(x-3)+4({x}^{2}+1)}{({x}^{2}+1)(x-3)}\\right) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}\\left(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}\\right) \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}\\left(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}\\right) \\\\  & =({x}^{2}+1)^{1/2}(x-3)^{3}(7{x}^{2}-9x+4) \\\\  & =\\sqrt{{x}^{2}+1}(x-3)^{3}(7{x}^{2}-9x+4)\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\na+b+c=7+(-9)+4=2.\n$$"] [:db/cas 17592186506564 :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+2)^{4})-\\operatorname{ln}⁡({({x}^{3}+2x-1)}^{3}) \\\\ \\operatorname{ln}⁡y & =4\\operatorname{ln}⁡(x+2)-3\\operatorname{ln}⁡({x}^{3}+2x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x+2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡({x}^{3}+2x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4\\cdot \\frac{1}{x+2}-3\\cdot \\frac{1}{{x}^{3}+2x-1}\\cdot (3{x}^{2}+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{3(3{x}^{2}+2)}{{x}^{3}+2x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\left(\\frac{4({x}^{3}+2x-1)-(x+2)(9{x}^{2}+6)}{(x+2)({x}^{3}+2x-1)}\\right) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\left(\\frac{-5{x}^{3}-18{x}^{2}+2x-16}{(x+2)({x}^{3}+2x-1)}\\right) \\\\  & =\\frac{(x+2)^{3}(-5{x}^{3}-18{x}^{2}+2x-16)}{{({x}^{3}+2x-1)}^{4}}\\end{aligned}\n$$" "We have the function \n\n$$\ny=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+2)^{4})-\\operatorname{ln}⁡({({x}^{3}+2x-1)}^{3}) \\\\ \\operatorname{ln}⁡y & =4\\operatorname{ln}⁡(x+2)-3\\operatorname{ln}⁡({x}^{3}+2x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x+2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡({x}^{3}+2x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4\\cdot \\frac{1}{x+2}-3\\cdot \\frac{1}{{x}^{3}+2x-1}\\cdot (3{x}^{2}+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{3(3{x}^{2}+2)}{{x}^{3}+2x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\left(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}\\right) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\left(\\frac{4({x}^{3}+2x-1)-(x+2)(9{x}^{2}+6)}{(x+2)({x}^{3}+2x-1)}\\right) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}\\left(\\frac{-5{x}^{3}-18{x}^{2}+2x-16}{(x+2)({x}^{3}+2x-1)}\\right) \\\\  & =\\frac{(x+2)^{3}(-5{x}^{3}-18{x}^{2}+2x-16)}{{({x}^{3}+2x-1)}^{4}}\\end{aligned}\n$$"] [:db/cas 17592186506577 :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+3)^{6})+\\operatorname{ln}⁡((x+8)^{5})-\\operatorname{ln}⁡({\\sin }^{8}⁡x) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\n \n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{x+3}+5\\cdot \\frac{1}{x+8}-8\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{6(x+8)+5(x+3)-8\\operatorname{cot}⁡x(x+3)(x+8)}{(x+3)(x+8)}\\right) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{6x+48+5x+15-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}\\right) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}\\right) \\\\  & =\\frac{(x+3)^{5}(x+8)^{4}}{{\\sin }^{8}⁡x}(11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=11+11+24=46.\n$$" "We have the function \n\n$$\ny=\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+3)^{6})+\\operatorname{ln}⁡((x+8)^{5})-\\operatorname{ln}⁡({\\sin }^{8}⁡x) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\n \n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{x+3}+5\\cdot \\frac{1}{x+8}-8\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x\\right) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{6(x+8)+5(x+3)-8\\operatorname{cot}⁡x(x+3)(x+8)}{(x+3)(x+8)}\\right) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{6x+48+5x+15-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}\\right) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{\\sin }^{8}⁡x}\\left(\\frac{11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}\\right) \\\\  & =\\frac{(x+3)^{5}(x+8)^{4}}{{\\sin }^{8}⁡x}(11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=11+11+24=46.\n$$"] [:db/cas 17592186506581 :question/worked-solution "We have the function \n\n$$\ny={(2x-3)}^{7}{({x}^{3}+5)}^{4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7}{({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7})+\\operatorname{ln}⁡({({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5} \\\\ \\frac{{y}^{′}}{y} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5})\\end{aligned}\n$$\n\nFinally, we substitute $y={(2x-3)}^{7}{({x}^{3}+5)}^{4}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={(2x-3)}^{7}{({x}^{3}+5)}^{4}(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}) \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}[14({x}^{3}+5)+12{x}^{2}(2x-3)] \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}(38{x}^{3}-36{x}^{2}+70)\\end{aligned}\n$$" "We have the function \n\n$$\ny={(2x-3)}^{7}{({x}^{3}+5)}^{4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7}{({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7})+\\operatorname{ln}⁡({({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5} \\\\ \\frac{{y}^{′}}{y} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y={(2x-3)}^{7}{({x}^{3}+5)}^{4}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={(2x-3)}^{7}{({x}^{3}+5)}^{4}\\left(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}\\right) \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}[14({x}^{3}+5)+12{x}^{2}(2x-3)] \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}(38{x}^{3}-36{x}^{2}+70)\\end{aligned}\n$$"] [:db/cas 17592186506582 :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}} \\\\  & =\\frac{\\sqrt{{x}^{4}+2x}}{\\sqrt{{x}^{2}+2x+2}} \\\\  & =\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+2x)^{1/2})-\\operatorname{ln}⁡(({x}^{2}+2x+2)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{4}+2x}\\cdot (4{x}^{3}+2)-\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+2x+2}\\cdot (2x+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{(2{x}^{3}+1)({x}^{2}+2x+2)-(x+1)({x}^{4}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}\\right) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{2{x}^{5}+4{x}^{4}+4{x}^{3}+{x}^{2}+2x+2-({x}^{5}+{x}^{4}+2{x}^{2}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}\\right) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{4}+2x)({x}^{2}+2x+2)}\\right) \\\\  & =\\frac{1{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{2}+2x+2)^{3/2}\\sqrt{{x}^{4}+2x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=1+4+2=7.\n$$" "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}} \\\\  & =\\frac{\\sqrt{{x}^{4}+2x}}{\\sqrt{{x}^{2}+2x+2}} \\\\  & =\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+2x)^{1/2})-\\operatorname{ln}⁡(({x}^{2}+2x+2)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{4}+2x}\\cdot (4{x}^{3}+2)-\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+2x+2}\\cdot (2x+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}\\right) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{(2{x}^{3}+1)({x}^{2}+2x+2)-(x+1)({x}^{4}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}\\right) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{2{x}^{5}+4{x}^{4}+4{x}^{3}+{x}^{2}+2x+2-({x}^{5}+{x}^{4}+2{x}^{2}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}\\right) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}\\left(\\frac{{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{4}+2x)({x}^{2}+2x+2)}\\right) \\\\  & =\\frac{1{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{2}+2x+2)^{3/2}\\sqrt{{x}^{4}+2x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=1+4+2=7.\n$$"] [:db/cas 17592186506591 :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+1)^{{x}^{2}})-\\operatorname{ln}⁡({e}^{2-4x}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\operatorname{ln}⁡(x+1)-(2-4x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{ln}⁡(x+1)-2+4x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\operatorname{ln}⁡(x+1)+{x}^{2}\\cdot \\frac{1}{x+1}+4 \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4) \\\\  & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}\\left(\\frac{2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)}{x+1}\\right) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4x+4) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+(x+2)^{2})\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2x(x+1)\\operatorname{ln}⁡(x+1).\n$$" "We have the function \n\n$$\ny=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left(\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}\\right) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+1)^{{x}^{2}})-\\operatorname{ln}⁡({e}^{2-4x}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\operatorname{ln}⁡(x+1)-(2-4x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{ln}⁡(x+1)-2+4x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\operatorname{ln}⁡(x+1)+{x}^{2}\\cdot \\frac{1}{x+1}+4 \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y\\left(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4\\right)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}\\left(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4\\right) \\\\  & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}\\left(\\frac{2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)}{x+1}\\right) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4x+4) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+(x+2)^{2})\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2x(x+1)\\operatorname{ln}⁡(x+1).\n$$"] [:db/cas 17592186506596 :question/worked-solution "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=12\\,{\\text{in}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=2\\,\\text{in}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=12$ and $r=2,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}12 & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (2)^{2} \\\\ 12 & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 16\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{3}{4\\pi }.\\end{aligned}\n$$\n\nTherefore, the radius of the balloon is decreasing at a rate of $\\frac{3}{4\\pi }\\,\\text{in}/\\text{s}$ when the radius is $2\\,\\text{in}.$" "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=12\\,{\\text{in}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=2\\,\\text{in}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{4}{3}\\pi {r}^{3}\\right) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}\\left(\\frac{4}{3}\\pi {r}^{3}\\right) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=12$ and $r=2,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}12 & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (2)^{2} \\\\ 12 & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 16\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{3}{4\\pi }.\\end{aligned}\n$$\n\nTherefore, the radius of the balloon is decreasing at a rate of $\\frac{3}{4\\pi }\\,\\text{in}/\\text{s}$ when the radius is $2\\,\\text{in}.$"] [:db/cas 17592186506597 :question/problem "Suppose we wish to find $$\n\\displaystyle L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}\n$$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}={{field-1}}.\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={{field-3}} \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-6}}\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" "Suppose we wish to find $$\n\\displaystyle L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}\n$$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}={{field-1}}.\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={{field-3}} \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)\\left(-\\frac{1}{s}{e}^{-st}\\right)\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-6}}\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"] [:db/cas 17592186506597 :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)\\left(-\\frac{1}{s}{e}^{-st}\\right)\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }\\left(-\\frac{1}{s}{e}^{-st}\\right){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"] [:db/cas 17592186506747 :answer/value "{(x+\\frac{1}{4})}^{2}" "{\\left(x+\\frac{1}{4}\\right)}^{2}"] [:db/cas 17592186506756 :answer/value "{(x-\\frac{1}{2})}^{2}" "{\\left(x-\\frac{1}{2}\\right)}^{2}"] [:db/cas 17592186506794 :answer/value "{(x+\\frac{3}{4})}^{2}" "{\\left(x+\\frac{3}{4}\\right)}^{2}"] [:db/cas 17592186506807 :answer/value "$(0,\\frac{3}{2},0)$ and $(0,\\frac{5}{2},0)$" "$\\left(0,\\frac{3}{2},0\\right)$ and $\\left(0,\\frac{5}{2},0\\right)$"] [:db/cas 17592186506810 :answer/value "{(x-\\frac{3}{2})}^{2}" "{\\left(x-\\frac{3}{2}\\right)}^{2}"] [:db/cas 17592186506843 :answer/value "{(x-\\frac{5}{6})}^{2}" "{\\left(x-\\frac{5}{6}\\right)}^{2}"] [:db/cas 17592186506847 :answer/value "{(x-\\frac{25}{6})}^{2}" "{\\left(x-\\frac{25}{6}\\right)}^{2}"] [:db/cas 17592186506871 :answer/value "$(0,\\frac{1}{2},0)$ and $(0,\\frac{3}{5},0)$" "$\\left(0,\\frac{1}{2},0\\right)$ and $\\left(0,\\frac{3}{5},0\\right)$"] [:db/cas 17592186506930 :answer/value "$(0,\\frac{1}{2},0)$ and $(0,\\frac{3}{2},0)$" "$\\left(0,\\frac{1}{2},0\\right)$ and $\\left(0,\\frac{3}{2},0\\right)$"] [:db/cas 17592186507008 :answer/value "{(x+\\frac{1}{2})}^{2}" "{\\left(x+\\frac{1}{2}\\right)}^{2}"] [:db/cas 17592186507013 :answer/value "{(x+\\frac{5}{6})}^{2}" "{\\left(x+\\frac{5}{6}\\right)}^{2}"] [:db/cas 17592186507044 :answer/value "$(0,\\frac{2}{5},0)$ and $(0,\\frac{1}{2},0)$" "$\\left(0,\\frac{2}{5},0\\right)$ and $\\left(0,\\frac{1}{2},0\\right)$"] [:db/cas 17592186507054 :answer/value "{(x+\\frac{5}{3})}^{2}" "{\\left(x+\\frac{5}{3}\\right)}^{2}"] [:db/cas 17592186507080 :answer/value "{(x-\\frac{5}{3})}^{2}" "{\\left(x-\\frac{5}{3}\\right)}^{2}"] [:db/cas 17592186507101 :answer/value "{(x-\\frac{3}{4})}^{2}" "{\\left(x-\\frac{3}{4}\\right)}^{2}"] [:db/cas 17592186507102 :answer/value "{(x-\\frac{1}{4})}^{2}" "{\\left(x-\\frac{1}{4}\\right)}^{2}"] [:db/cas 17592186507149 :answer/value "{(x+\\frac{3}{2})}^{2}" "{\\left(x+\\frac{3}{2}\\right)}^{2}"] [:db/cas 17592186507402 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $1\\le x\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{4}^{9}\\frac{1}{19}x\\sqrt{y}\\,\\text{d}y \\\\  & =\\frac{1}{19}x{[\\frac{2}{3}{y}^{3/2}]}_{y=4}^{y=9} \\\\  & =\\frac{2}{57}x{[{y}^{3/2}]}_{y=4}^{y=9} \\\\  & =\\frac{2}{57}x({9}^{3/2}-{4}^{3/2}) \\\\  & =\\frac{2}{3}x.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{2}{3}x, & 1\\le x\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\ge 1.9) & ={\\int }_{1.9}^{\\infty }{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{1.9}^{2}\\frac{2}{3}x\\,\\text{d}x \\\\  & =\\frac{2}{3}{[\\frac{1}{2}{x}^{2}]}_{1.9}^{2} \\\\  & =\\frac{1}{3}[{2}^{2}-{1.9}^{2}] \\\\  & =0.13.\\end{aligned}\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $1\\le x\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{4}^{9}\\frac{1}{19}x\\sqrt{y}\\,\\text{d}y \\\\  & =\\frac{1}{19}x{\\left[\\frac{2}{3}{y}^{3/2}\\right]}_{y=4}^{y=9} \\\\  & =\\frac{2}{57}x{[{y}^{3/2}]}_{y=4}^{y=9} \\\\  & =\\frac{2}{57}x({9}^{3/2}-{4}^{3/2}) \\\\  & =\\frac{2}{3}x.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{2}{3}x, & 1\\le x\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\ge 1.9) & ={\\int }_{1.9}^{\\infty }{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{1.9}^{2}\\frac{2}{3}x\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\left[\\frac{1}{2}{x}^{2}\\right]}_{1.9}^{2} \\\\  & =\\frac{1}{3}[{2}^{2}-{1.9}^{2}] \\\\  & =0.13.\\end{aligned}\n$$"] [:db/cas 17592186507404 :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}-x+\\frac{1}{4}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-x+{\\left(\\frac{1}{2}\\right)}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot \\frac{1}{2}x+{\\left(\\frac{1}{2}\\right)}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=\\frac{1}{2}.$ This gives\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}.\\end{aligned}\n$$" "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}-x+\\frac{1}{4}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-x+{\\left(\\frac{1}{2}\\right)}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot \\frac{1}{2}x+{\\left(\\frac{1}{2}\\right)}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=\\frac{1}{2}.$ This gives\n\n$$\n\\begin{aligned}{\\left(x-\\frac{1}{2}\\right)}^{2}.\\end{aligned}\n$$"] [:db/cas 17592186507415 :question/worked-solution "The definitions of $\\operatorname{cosh}⁡x$ and $\\operatorname{sinh}⁡x$ are\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}),\\,\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nSubstituting the above definitions into the equation $\\operatorname{cosh}⁡x+5\\operatorname{sinh}⁡x=5,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{2}({e}^{x}+{e}^{-x})+5\\cdot (\\frac{1}{2}({e}^{x}-{e}^{-x})) & =5 \\\\ \\frac{1}{2}({e}^{x}+{e}^{-x})+\\frac{5}{2}({e}^{x}-{e}^{-x}) & =5 \\\\ \\frac{1}{2}{e}^{x}+\\frac{1}{2}{e}^{-x}+\\frac{5}{2}{e}^{x}-\\frac{5}{2}{e}^{-x} & =5 \\\\ 3{e}^{x}-2{e}^{-x} & =5.\\end{aligned}\n$$\n\nNext, we multiply both sides of the equation by ${e}^{x},$ and simplify:\n\n$$\n\\begin{aligned}{e}^{x}\\cdot (3{e}^{x}-2{e}^{-x}) & ={e}^{x}\\cdot 5 \\\\ 3{e}^{2x}-2 & =5{e}^{x} \\\\ 3{e}^{2x}-5{e}^{x}-2 & =0.\\end{aligned}\n$$\n\nThis is a quadratic equation in ${e}^{x}$ that we can factor as follows:\n\n$$\n\\begin{aligned}(3{e}^{x}+1)({e}^{x}-2) & =0.\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations:\n\n$$\n3{e}^{x}+1=0,\\,{e}^{x}-2=0.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}3{e}^{x}+1 & =0 &  & \\, & {e}^{x}-2 & =0 \\\\ 3{e}^{x} & =-1 &  & \\, & {e}^{x} & =2 \\\\ {e}^{x} & =-\\frac{1}{3} &  & \\, & x & =\\operatorname{ln}⁡(2).\\end{aligned}\n$$\n\nThere are no real values of $x$ for which ${e}^{x}=-\\frac{1}{3}.$ Therefore, the only real solution to the equation is\n\n$$\nx=\\operatorname{ln}⁡(2).\n$$" "The definitions of $\\operatorname{cosh}⁡x$ and $\\operatorname{sinh}⁡x$ are\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}),\\,\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nSubstituting the above definitions into the equation $\\operatorname{cosh}⁡x+5\\operatorname{sinh}⁡x=5,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{2}({e}^{x}+{e}^{-x})+5\\cdot \\left(\\frac{1}{2}({e}^{x}-{e}^{-x})\\right) & =5 \\\\ \\frac{1}{2}({e}^{x}+{e}^{-x})+\\frac{5}{2}({e}^{x}-{e}^{-x}) & =5 \\\\ \\frac{1}{2}{e}^{x}+\\frac{1}{2}{e}^{-x}+\\frac{5}{2}{e}^{x}-\\frac{5}{2}{e}^{-x} & =5 \\\\ 3{e}^{x}-2{e}^{-x} & =5.\\end{aligned}\n$$\n\nNext, we multiply both sides of the equation by ${e}^{x},$ and simplify:\n\n$$\n\\begin{aligned}{e}^{x}\\cdot (3{e}^{x}-2{e}^{-x}) & ={e}^{x}\\cdot 5 \\\\ 3{e}^{2x}-2 & =5{e}^{x} \\\\ 3{e}^{2x}-5{e}^{x}-2 & =0.\\end{aligned}\n$$\n\nThis is a quadratic equation in ${e}^{x}$ that we can factor as follows:\n\n$$\n\\begin{aligned}(3{e}^{x}+1)({e}^{x}-2) & =0.\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations:\n\n$$\n3{e}^{x}+1=0,\\,{e}^{x}-2=0.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}3{e}^{x}+1 & =0 &  & \\, & {e}^{x}-2 & =0 \\\\ 3{e}^{x} & =-1 &  & \\, & {e}^{x} & =2 \\\\ {e}^{x} & =-\\frac{1}{3} &  & \\, & x & =\\operatorname{ln}⁡(2).\\end{aligned}\n$$\n\nThere are no real values of $x$ for which ${e}^{x}=-\\frac{1}{3}.$ Therefore, the only real solution to the equation is\n\n$$\nx=\\operatorname{ln}⁡(2).\n$$"] [:db/cas 17592186507417 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{2}^{3}\\frac{3}{5}\\sqrt{x}\\,y\\,\\text{d}y \\\\  & ={[\\frac{3}{10}\\sqrt{x}\\,{y}^{2}]}_{y=2}^{y=3} \\\\  & =\\frac{3}{10}\\sqrt{x}({3}^{2}-{2}^{2}) \\\\  & =\\frac{3}{2}\\sqrt{x}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{3}{2}\\sqrt{x}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X<0.5) & ={\\int }_{-\\infty }^{0.5}{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{0.5}(\\frac{3}{2}\\sqrt{x})\\text{d}x \\\\  & ={[{x}^{3/2}]}_{0}^{0.5} \\\\  & =[{0.5}^{3/2}]-[{0}^{3/2}] \\\\  & ≈0.3536.\\end{aligned}\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{2}^{3}\\frac{3}{5}\\sqrt{x}\\,y\\,\\text{d}y \\\\  & ={\\left[\\frac{3}{10}\\sqrt{x}\\,{y}^{2}\\right]}_{y=2}^{y=3} \\\\  & =\\frac{3}{10}\\sqrt{x}({3}^{2}-{2}^{2}) \\\\  & =\\frac{3}{2}\\sqrt{x}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{3}{2}\\sqrt{x}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X<0.5) & ={\\int }_{-\\infty }^{0.5}{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{0.5}\\left(\\frac{3}{2}\\sqrt{x}\\right)\\text{d}x \\\\  & ={[{x}^{3/2}]}_{0}^{0.5} \\\\  & =[{0.5}^{3/2}]-[{0}^{3/2}] \\\\  & ≈0.3536.\\end{aligned}\n$$"] [:db/cas 17592186507427 :question/problem "Given that the function\n\n$$\ng(x)=\\left\\{\\begin{aligned}\\operatorname{ln}⁡(\\frac{x}{2}-b), & 2<x\\le 4 \\\\ 4-x, & x>4\\end{aligned}\\right.\n$$\n\n \nis continuous at  $x=4,$ find the value of $b.$" "Given that the function\n\n$$\ng(x)=\\left\\{\\begin{aligned}\\operatorname{ln}⁡\\left(\\frac{x}{2}-b\\right), & 2<x\\le 4 \\\\ 4-x, & x>4\\end{aligned}\\right.\n$$\n\n \nis continuous at  $x=4,$ find the value of $b.$"] [:db/cas 17592186507427 :question/worked-solution "At $x=4,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{-}}g(x) & =g(4) \\\\  & =\\operatorname{ln}⁡(\\frac{4}{2}-b) \\\\  & =\\operatorname{ln}⁡(2-b),\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{+}}g(x) & =\\lim_{x\\to {4}^{+}}(4-x) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=4,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{-}}g(x) & =\\lim_{x\\to {4}^{+}}g(x) \\\\ \\operatorname{ln}⁡(2-b) & =0 \\\\ 2-b & =1 \\\\ b & =1.\\end{aligned}\n$$" "At $x=4,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{-}}g(x) & =g(4) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4}{2}-b\\right) \\\\  & =\\operatorname{ln}⁡(2-b),\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{+}}g(x) & =\\lim_{x\\to {4}^{+}}(4-x) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=4,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{-}}g(x) & =\\lim_{x\\to {4}^{+}}g(x) \\\\ \\operatorname{ln}⁡(2-b) & =0 \\\\ 2-b & =1 \\\\ b & =1.\\end{aligned}\n$$"] [:db/cas 17592186507428 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,x\\ge 0,\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\le 4\\}.$\n\n![](images/f6/f65ef4fc9d7ae895bc7ba8fe99bc7b03d8b26c92611fcbc43f600aa2e0c30301.png)\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\sqrt{4-{y}^{2}}}\\frac{xy}{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\sqrt{4-{y}^{2}}}xy\\,\\text{d}x \\\\  & =\\frac{1}{2}{[\\frac{1}{2}{x}^{2}y]}_{x=0}^{x=\\sqrt{4-{y}^{2}}} \\\\  & =\\frac{1}{4}[{x}^{2}y]_{x=0}^{x=\\sqrt{4-{y}^{2}}} \\\\  & =\\frac{1}{4}[{(\\sqrt{4-{y}^{2}})}^{2}\\cdot y-{0}^{2}\\cdot y] \\\\  & =\\frac{1}{4}[(4-{y}^{2})y-0] \\\\  & =\\frac{1}{4}[4y-{y}^{3}] \\\\  & =y-\\frac{{y}^{3}}{4}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}y-\\frac{{y}^{3}}{4}, & 0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,x\\ge 0,\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\le 4\\}.$\n\n![](images/f6/f65ef4fc9d7ae895bc7ba8fe99bc7b03d8b26c92611fcbc43f600aa2e0c30301.png)\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\sqrt{4-{y}^{2}}}\\frac{xy}{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\sqrt{4-{y}^{2}}}xy\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\left[\\frac{1}{2}{x}^{2}y\\right]}_{x=0}^{x=\\sqrt{4-{y}^{2}}} \\\\  & =\\frac{1}{4}[{x}^{2}y]_{x=0}^{x=\\sqrt{4-{y}^{2}}} \\\\  & =\\frac{1}{4}[{(\\sqrt{4-{y}^{2}})}^{2}\\cdot y-{0}^{2}\\cdot y] \\\\  & =\\frac{1}{4}[(4-{y}^{2})y-0] \\\\  & =\\frac{1}{4}[4y-{y}^{3}] \\\\  & =y-\\frac{{y}^{3}}{4}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}y-\\frac{{y}^{3}}{4}, & 0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186507432 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=180$ and $p=0.45.$ Therefore, \n\n$$\n\\begin{aligned}np & =180\\cdot 0.45 \\\\  & =81 \\\\  & >5\\,✓ \\\\ n(1-p) & =180\\cdot (1-0.45) \\\\  & =99 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(180)(0.45)=81\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(180)(0.45)(1-0.45)=44.55.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(81,44.55).$\n\nNow, we can approximate the desired probability $P(X=85).$ Using a continuity correction, we have\n\n$$\nP(X=85)≈P(84.5\\le Y\\le 85.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(84.5\\le Y\\le 85.5) & =P(\\frac{84.5-81}{\\sqrt{44.55}}\\le Z\\le \\frac{85.5-81}{\\sqrt{44.55}}) \\\\  & ≈P(0.52\\le Z\\le 0.67) \\\\  & =P(Z\\le 0.67)-P(Z<0.52) \\\\  & =P(Z\\le 0.67)-P(Z\\le 0.52) \\\\  & =Φ(0.67)-Φ(0.52) \\\\  & =0.7486-0.6985 \\\\  & =0.0501\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=85)≈0.050.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0499.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=180$ and $p=0.45.$ Therefore, \n\n$$\n\\begin{aligned}np & =180\\cdot 0.45 \\\\  & =81 \\\\  & >5\\,✓ \\\\ n(1-p) & =180\\cdot (1-0.45) \\\\  & =99 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(180)(0.45)=81\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(180)(0.45)(1-0.45)=44.55.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(81,44.55).$\n\nNow, we can approximate the desired probability $P(X=85).$ Using a continuity correction, we have\n\n$$\nP(X=85)≈P(84.5\\le Y\\le 85.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(84.5\\le Y\\le 85.5) & =P\\left(\\frac{84.5-81}{\\sqrt{44.55}}\\le Z\\le \\frac{85.5-81}{\\sqrt{44.55}}\\right) \\\\  & ≈P(0.52\\le Z\\le 0.67) \\\\  & =P(Z\\le 0.67)-P(Z<0.52) \\\\  & =P(Z\\le 0.67)-P(Z\\le 0.52) \\\\  & =Φ(0.67)-Φ(0.52) \\\\  & =0.7486-0.6985 \\\\  & =0.0501\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=85)≈0.050.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0499.$"] [:db/cas 17592186507433 :question/worked-solution "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case:\n\n- the sample size is \n\n$$\nn=80,\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}f({x}_{i}) \\\\  & =-1\\cdot 0.3+0\\cdot 0.5+1\\cdot 0.1+2\\cdot 0.1 \\\\  & =-0.3+0+0.1+0.3 \\\\  & =0,\\end{aligned}\n$$\n\n- the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\text{Var}[X] \\\\  & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =((-1)^{2}\\cdot 0.3+{0}^{2}\\cdot 0.5+{1}^{2}\\cdot 0.1+{2}^{2}\\cdot 0.1)-{0}^{2} \\\\  & =(0.3+0+0.1+0.4)-0 \\\\  & =0.8.\\end{aligned}\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(0,\\frac{0.8}{80}) \\\\  & ∼N(0,0.01).\\end{aligned}\n$$\n\nWe want to find $P(\\overset{―}{X}>0.1).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}>0.1) & ≈P(Z>\\frac{0.1-0}{\\sqrt{0.01}}) \\\\  & =P(Z>1) \\\\  & =1-Φ(1).\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(\\overset{―}{X}>0.1)=1-Φ(1).\n$$" "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,\\left(\\mu ,\\frac{{\\sigma }^{2}}{n}\\right).\n$$\n\nIn our case:\n\n- the sample size is \n\n$$\nn=80,\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}f({x}_{i}) \\\\  & =-1\\cdot 0.3+0\\cdot 0.5+1\\cdot 0.1+2\\cdot 0.1 \\\\  & =-0.3+0+0.1+0.3 \\\\  & =0,\\end{aligned}\n$$\n\n- the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\text{Var}[X] \\\\  & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =((-1)^{2}\\cdot 0.3+{0}^{2}\\cdot 0.5+{1}^{2}\\cdot 0.1+{2}^{2}\\cdot 0.1)-{0}^{2} \\\\  & =(0.3+0+0.1+0.4)-0 \\\\  & =0.8.\\end{aligned}\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,\\left(\\mu ,\\frac{{\\sigma }^{2}}{n}\\right) \\\\  & ∼N\\,\\left(0,\\frac{0.8}{80}\\right) \\\\  & ∼N(0,0.01).\\end{aligned}\n$$\n\nWe want to find $P(\\overset{―}{X}>0.1).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}>0.1) & ≈P\\left(Z>\\frac{0.1-0}{\\sqrt{0.01}}\\right) \\\\  & =P(Z>1) \\\\  & =1-Φ(1).\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(\\overset{―}{X}>0.1)=1-Φ(1).\n$$"] [:db/cas 17592186507435 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=80$ and $p=0.4.$ Therefore, \n\n$$\n\\begin{aligned}np & =80\\cdot 0.4 \\\\  & =32 \\\\  & >5\\,✓ \\\\ n(1-p) & =80\\cdot (1-0.4) \\\\  & =48 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(80)(0.4)=32\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(80)(0.4)(1-0.4)=19.2.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(32,19.2).$\n\nNow, we can estimate the desired probability $P(25<X<35).$ Using a continuity correction, we have\n\n$$\nP(25<X<35)=P(26\\le X\\le 34)≈P(25.5\\le Y\\le 34.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(25.5\\le Y\\le 34.5) & =P(\\frac{25.5-32}{\\sqrt{19.2}}\\le Z\\le \\frac{34.5-32}{\\sqrt{19.2}}) \\\\  & ≈P(-1.48\\le Z\\le 0.57) \\\\  & =P(Z\\le 0.57)-P(Z<-1.48) \\\\  & =P(Z\\le 0.57)-P(Z\\le -1.48) \\\\  & =Φ(0.57)-Φ(-1.48) \\\\  & =0.7157-0.0694 \\\\  & =0.6463\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(25<X<35)≈0.646.\n$$\n\nNote: Using a software package for the approximation gives a probability of\n$0.65.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=80$ and $p=0.4.$ Therefore, \n\n$$\n\\begin{aligned}np & =80\\cdot 0.4 \\\\  & =32 \\\\  & >5\\,✓ \\\\ n(1-p) & =80\\cdot (1-0.4) \\\\  & =48 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(80)(0.4)=32\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(80)(0.4)(1-0.4)=19.2.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(32,19.2).$\n\nNow, we can estimate the desired probability $P(25<X<35).$ Using a continuity correction, we have\n\n$$\nP(25<X<35)=P(26\\le X\\le 34)≈P(25.5\\le Y\\le 34.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(25.5\\le Y\\le 34.5) & =P\\left(\\frac{25.5-32}{\\sqrt{19.2}}\\le Z\\le \\frac{34.5-32}{\\sqrt{19.2}}\\right) \\\\  & ≈P(-1.48\\le Z\\le 0.57) \\\\  & =P(Z\\le 0.57)-P(Z<-1.48) \\\\  & =P(Z\\le 0.57)-P(Z\\le -1.48) \\\\  & =Φ(0.57)-Φ(-1.48) \\\\  & =0.7157-0.0694 \\\\  & =0.6463\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(25<X<35)≈0.646.\n$$\n\nNote: Using a software package for the approximation gives a probability of\n$0.65.$"] [:db/cas 17592186507438 :question/worked-solution "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with a population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case, we have\n\n$$\nn=108,\\,\\mu =20,\\,\\sigma =90.\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(20,\\frac{{90}^{2}}{108}) \\\\  & ∼N(20,75).\\end{aligned}\n$$\n\nWe want to find $P(|\\overset{―}{X}|<5).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|<5) & =P(-5<\\overset{―}{X}<5) \\\\  & =P(\\frac{-5-20}{\\sqrt{75}}<Z<\\frac{5-20}{\\sqrt{75}}) \\\\  & =P(-\\frac{5}{\\sqrt{3}}<Z<-\\frac{3}{\\sqrt{3}}) \\\\  & ≈P(-2.89<Z<-1.73) \\\\  & =P(Z<-1.73)-P(Z<-2.89) \\\\  & =Φ(-1.73)-Φ(-2.89).\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(-2.89)=0.0019, \\\\ Φ(-1.73)=0.0418.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|<5) & =Φ(-1.73)-Φ(-2.89) \\\\  & =0.0418-0.0019 \\\\  & =0.0399.\\end{aligned}\n$$" "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with a population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,\\left(\\mu ,\\frac{{\\sigma }^{2}}{n}\\right).\n$$\n\nIn our case, we have\n\n$$\nn=108,\\,\\mu =20,\\,\\sigma =90.\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,\\left(\\mu ,\\frac{{\\sigma }^{2}}{n}\\right) \\\\  & ∼N\\,\\left(20,\\frac{{90}^{2}}{108}\\right) \\\\  & ∼N(20,75).\\end{aligned}\n$$\n\nWe want to find $P(|\\overset{―}{X}|<5).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|<5) & =P(-5<\\overset{―}{X}<5) \\\\  & =P\\left(\\frac{-5-20}{\\sqrt{75}}<Z<\\frac{5-20}{\\sqrt{75}}\\right) \\\\  & =P\\left(-\\frac{5}{\\sqrt{3}}<Z<-\\frac{3}{\\sqrt{3}}\\right) \\\\  & ≈P(-2.89<Z<-1.73) \\\\  & =P(Z<-1.73)-P(Z<-2.89) \\\\  & =Φ(-1.73)-Φ(-2.89).\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(-2.89)=0.0019, \\\\ Φ(-1.73)=0.0418.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|<5) & =Φ(-1.73)-Φ(-2.89) \\\\  & =0.0418-0.0019 \\\\  & =0.0399.\\end{aligned}\n$$"] [:db/cas 17592186507442 :question/worked-solution "The \"square of a sum\" formula states that\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}+\\frac{3}{2}x+\\frac{9}{16}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}+\\frac{3}{2}x+{\\left(\\frac{3}{4}\\right)}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}+2\\cdot \\frac{3}{4}x+{\\left(\\frac{3}{4}\\right)}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with $a=\\frac{3}{4}.$ This gives\n\n$$\n\\begin{aligned}{(x+\\frac{3}{4})}^{2}.\\end{aligned}\n$$" "The \"square of a sum\" formula states that\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}+\\frac{3}{2}x+\\frac{9}{16}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}+\\frac{3}{2}x+{\\left(\\frac{3}{4}\\right)}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}+2\\cdot \\frac{3}{4}x+{\\left(\\frac{3}{4}\\right)}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with $a=\\frac{3}{4}.$ This gives\n\n$$\n\\begin{aligned}{\\left(x+\\frac{3}{4}\\right)}^{2}.\\end{aligned}\n$$"] [:db/cas 17592186507444 :question/worked-solution "Let $X$ represent a sandwich price. Then we have $X∼N(\\mu ,{1.10}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(0.80\\mu <X<1.20\\mu )=0.90.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.80\\mu <X<1.20\\mu ) & =0.90 \\\\ 2P(\\mu <X<1.20\\mu ) & =0.90 \\\\ P(\\mu <X<1.20\\mu ) & =0.45 \\\\ P(X<\\mu )+P(\\mu <X<1.20\\mu ) & =0.5+0.45 \\\\ P(X<1.20\\mu ) & =0.95.\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X<1.20\\mu ) & =0.95 \\\\ P(Z<\\frac{0.20\\mu }{1.10}) & =0.95 \\\\ Φ\\left(\\frac{0.20\\mu }{1.10}\\right) & =0.95 \\\\ \\frac{0.20\\mu }{1.10} & ={Φ}^{-1}(0.95).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.95)=1.6449.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}\\frac{0.20\\mu }{1.10} & =1.6449 \\\\ 0.20\\mu  & =1.809\\,39 \\\\ \\mu  & =\\frac{1.809\\,39}{0.20} \\\\  & ≈9.05\\,\\text{dollars}.\\end{aligned}\n$$" "Let $X$ represent a sandwich price. Then we have $X∼N(\\mu ,{1.10}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(0.80\\mu <X<1.20\\mu )=0.90.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.80\\mu <X<1.20\\mu ) & =0.90 \\\\ 2P(\\mu <X<1.20\\mu ) & =0.90 \\\\ P(\\mu <X<1.20\\mu ) & =0.45 \\\\ P(X<\\mu )+P(\\mu <X<1.20\\mu ) & =0.5+0.45 \\\\ P(X<1.20\\mu ) & =0.95.\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X<1.20\\mu ) & =0.95 \\\\ P\\left(Z<\\frac{0.20\\mu }{1.10}\\right) & =0.95 \\\\ Φ\\left(\\frac{0.20\\mu }{1.10}\\right) & =0.95 \\\\ \\frac{0.20\\mu }{1.10} & ={Φ}^{-1}(0.95).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.95)=1.6449.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}\\frac{0.20\\mu }{1.10} & =1.6449 \\\\ 0.20\\mu  & =1.809\\,39 \\\\ \\mu  & =\\frac{1.809\\,39}{0.20} \\\\  & ≈9.05\\,\\text{dollars}.\\end{aligned}\n$$"] [:db/cas 17592186507457 :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}-\\frac{5}{3}x+\\frac{25}{36}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{5}{3}x+{\\left(\\frac{5}{6}\\right)}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot \\frac{5}{6}x+{\\left(\\frac{5}{6}\\right)}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=\\frac{5}{6}.$ This gives\n\n$$\n\\begin{aligned}{(x-\\frac{5}{6})}^{2}.\\end{aligned}\n$$" "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}-\\frac{5}{3}x+\\frac{25}{36}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{5}{3}x+{\\left(\\frac{5}{6}\\right)}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot \\frac{5}{6}x+{\\left(\\frac{5}{6}\\right)}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=\\frac{5}{6}.$ This gives\n\n$$\n\\begin{aligned}{\\left(x-\\frac{5}{6}\\right)}^{2}.\\end{aligned}\n$$"] [:db/cas 17592186507486 :question/worked-solution "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with a population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case, we have\n\n$$\nn=126,\\,\\mu =5,\\,\\sigma =84.\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(5,\\frac{{84}^{2}}{126}) \\\\  & ∼N(5,56).\\end{aligned}\n$$\n\nWe want to find $P(|\\overset{―}{X}|>3.5).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|>3.5) & =1-P(|\\overset{―}{X}|<3.5) \\\\  & =1-P(-3.5<\\overset{―}{X}<3.5) \\\\  & =1-P(\\frac{-3.5-5}{\\sqrt{56}}<Z<\\frac{3.5-5}{\\sqrt{56}}) \\\\  & ≈1-P(-1.14<Z<-0.20) \\\\  & =1-(P(Z<-0.20)-P(Z<-1.14)) \\\\  & =1+Φ(-1.14)-Φ(-0.20).\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(-1.14)=0.1271, \\\\ Φ(-0.20)=0.4207.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|>3.5) & =1+Φ(-1.14)-Φ(-0.20) \\\\  & =1+0.1271-0.4207 \\\\  & =0.7064.\\end{aligned}\n$$" "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with a population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,\\left(\\mu ,\\frac{{\\sigma }^{2}}{n}\\right).\n$$\n\nIn our case, we have\n\n$$\nn=126,\\,\\mu =5,\\,\\sigma =84.\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,\\left(\\mu ,\\frac{{\\sigma }^{2}}{n}\\right) \\\\  & ∼N\\,\\left(5,\\frac{{84}^{2}}{126}\\right) \\\\  & ∼N(5,56).\\end{aligned}\n$$\n\nWe want to find $P(|\\overset{―}{X}|>3.5).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|>3.5) & =1-P(|\\overset{―}{X}|<3.5) \\\\  & =1-P(-3.5<\\overset{―}{X}<3.5) \\\\  & =1-P\\left(\\frac{-3.5-5}{\\sqrt{56}}<Z<\\frac{3.5-5}{\\sqrt{56}}\\right) \\\\  & ≈1-P(-1.14<Z<-0.20) \\\\  & =1-(P(Z<-0.20)-P(Z<-1.14)) \\\\  & =1+Φ(-1.14)-Φ(-0.20).\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(-1.14)=0.1271, \\\\ Φ(-0.20)=0.4207.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|>3.5) & =1+Φ(-1.14)-Φ(-0.20) \\\\  & =1+0.1271-0.4207 \\\\  & =0.7064.\\end{aligned}\n$$"] [:db/cas 17592186507488 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,x\\ge 0,\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\le 1\\}.$\n\n![](images/df/dfa15482cfa0e8fdc9e98b05a71d2b64a89b3886da44f6966fee9f1b5e096eef.png)\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\sqrt{1-{x}^{2}}}15{x}^{2}y\\,\\text{d}y \\\\  & =15{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{x}^{2}y\\,\\text{d}y \\\\  & =15{[\\frac{1}{2}{x}^{2}{y}^{2}]}_{y=0}^{y=\\sqrt{1-{x}^{2}}} \\\\  & =\\frac{15}{2}[{x}^{2}{y}^{2}]_{y=0}^{y=\\sqrt{1-{x}^{2}}} \\\\  & =\\frac{15}{2}[{x}^{2}\\cdot {(\\sqrt{1-{x}^{2}})}^{2}-{x}^{2}\\cdot {0}^{2}] \\\\  & =\\frac{15}{2}[{x}^{2}\\cdot (1-{x}^{2})-0] \\\\  & =\\frac{15({x}^{2}-{x}^{4})}{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{15({x}^{2}-{x}^{4})}{2}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,x\\ge 0,\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\le 1\\}.$\n\n![](images/df/dfa15482cfa0e8fdc9e98b05a71d2b64a89b3886da44f6966fee9f1b5e096eef.png)\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\sqrt{1-{x}^{2}}}15{x}^{2}y\\,\\text{d}y \\\\  & =15{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{x}^{2}y\\,\\text{d}y \\\\  & =15{\\left[\\frac{1}{2}{x}^{2}{y}^{2}\\right]}_{y=0}^{y=\\sqrt{1-{x}^{2}}} \\\\  & =\\frac{15}{2}[{x}^{2}{y}^{2}]_{y=0}^{y=\\sqrt{1-{x}^{2}}} \\\\  & =\\frac{15}{2}[{x}^{2}\\cdot {(\\sqrt{1-{x}^{2}})}^{2}-{x}^{2}\\cdot {0}^{2}] \\\\  & =\\frac{15}{2}[{x}^{2}\\cdot (1-{x}^{2})-0] \\\\  & =\\frac{15({x}^{2}-{x}^{4})}{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{15({x}^{2}-{x}^{4})}{2}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186507489 :question/worked-solution "Let $X$ represent the height of a randomly selected tree. Then we have $X∼N(\\mu ,{8}^{2}),$ and we want to find $P(X>50).$  \n\nWe know that $P(X<45)=0.25.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<45) & =0.25 \\\\ P(Z<\\frac{45-\\mu }{8}) & =0.25 \\\\ Φ\\left(\\frac{45-\\mu }{8}\\right) & =0.25 \\\\ \\frac{45-\\mu }{8} & ={Φ}^{-1}(0.25)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.25)=-0.6745.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{45-\\mu }{8} & =-0.6745 \\\\ 45-\\mu  & =-5.396 \\\\ \\mu  & =50.396.\\end{aligned}\n$$\n\nFinally, we can solve for $P(50<X)$ as follows:\n\n$$\n\\begin{aligned}P(X>50) & =P(Z>\\frac{50-50.396}{8}) \\\\  & ≈P(Z>-0.05) \\\\  & =1-Φ(-0.05) \\\\  & =1-0.4801 \\\\  & ≈51.99\\%\\end{aligned}\n$$\n\nTherefore, approximately $51.99\\%$ of the trees are taller than $50$ feet." "Let $X$ represent the height of a randomly selected tree. Then we have $X∼N(\\mu ,{8}^{2}),$ and we want to find $P(X>50).$  \n\nWe know that $P(X<45)=0.25.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<45) & =0.25 \\\\ P\\left(Z<\\frac{45-\\mu }{8}\\right) & =0.25 \\\\ Φ\\left(\\frac{45-\\mu }{8}\\right) & =0.25 \\\\ \\frac{45-\\mu }{8} & ={Φ}^{-1}(0.25)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.25)=-0.6745.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{45-\\mu }{8} & =-0.6745 \\\\ 45-\\mu  & =-5.396 \\\\ \\mu  & =50.396.\\end{aligned}\n$$\n\nFinally, we can solve for $P(50<X)$ as follows:\n\n$$\n\\begin{aligned}P(X>50) & =P\\left(Z>\\frac{50-50.396}{8}\\right) \\\\  & ≈P(Z>-0.05) \\\\  & =1-Φ(-0.05) \\\\  & =1-0.4801 \\\\  & ≈51.99\\%\\end{aligned}\n$$\n\nTherefore, approximately $51.99\\%$ of the trees are taller than $50$ feet."] [:db/cas 17592186507499 :question/worked-solution "The variable $z$ is being *divided* by $6.$ To isolate $z$ and remove the negative sign, we *multiply* by $-6$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}4\\,\\, & <\\,\\,-\\frac{z}{6} \\\\ (-6)\\cdot 4\\,\\, & >\\,\\,(-6)\\cdot \\left(-\\frac{z}{6}\\right) \\\\ -24\\,\\, & >\\,\\,(-6)\\cdot \\left(-\\frac{z}{6}\\right)\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}-24\\,\\, & >(-6)\\cdot \\left(-\\frac{z}{6}\\right) \\\\ -24 & >(\\cancel{-}6)\\cdot (\\cancel{-}\\frac{z}{6}) \\\\ -24 & >6\\cdot \\frac{z}{6}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}-24 & >6\\cdot \\frac{z}{6} \\\\ -24 & >\\frac{6z}{6} \\\\ -24 & >\\frac{\\cancel{6}z}{\\cancel{6}} \\\\ -24 & >z\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nz<-24\n$$\n\nTherefore, the solution is $z<-24.$" "The variable $z$ is being *divided* by $6.$ To isolate $z$ and remove the negative sign, we *multiply* by $-6$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}4\\,\\, & <\\,\\,-\\frac{z}{6} \\\\ (-6)\\cdot 4\\,\\, & >\\,\\,(-6)\\cdot \\left(-\\frac{z}{6}\\right) \\\\ -24\\,\\, & >\\,\\,(-6)\\cdot \\left(-\\frac{z}{6}\\right)\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}-24\\,\\, & >(-6)\\cdot \\left(-\\frac{z}{6}\\right) \\\\ -24 & >(\\cancel{-}6)\\cdot \\left(\\cancel{-}\\frac{z}{6}\\right) \\\\ -24 & >6\\cdot \\frac{z}{6}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}-24 & >6\\cdot \\frac{z}{6} \\\\ -24 & >\\frac{6z}{6} \\\\ -24 & >\\frac{\\cancel{6}z}{\\cancel{6}} \\\\ -24 & >z\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nz<-24\n$$\n\nTherefore, the solution is $z<-24.$"] [:db/cas 17592186507508 :question/worked-solution "We begin by identifying resonance. The differential equation \n\n$$\n{y}^{″}+\\frac{4{\\pi }^{2}}{9}y=f(x)\n$$\n\nhas a natural frequency of \n\n$$\n\\omega =\\sqrt{\\frac{4{\\pi }^{2}}{9}}=\\frac{2\\pi }{3}.\n$$\n\nThe frequencies of the forcing harmonics for a $6$-periodic function $(L=3)$ are \n\n$$\n{\\omega }_{n}=\\frac{n\\pi }{3}.\n$$\n\nFor $n=2$, we have ${\\omega }_{2}=\\frac{2\\pi }{3}.$ Since ${\\omega }_{2}=\\omega ,$ the $n=2$ harmonic of the forcing function causes resonance.\n\nFor the $n=2$ harmonic, the forcing term is \n\n$$\n{f}_{2}(x)=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\n{y}_{{p}_{2}}=x(A\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)+B\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{y}_{{p}_{2}}^{′} & =(A\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)+B\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right))+x(-\\frac{2\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{2\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)) \\\\ \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{y}_{{p}_{2}}^{″} & =-\\frac{4\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{4\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)-\\frac{4{\\pi }^{2}}{9}x(A\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)+B\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right))\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{{p}_{2}}^{″}$ and ${y}_{{p}_{2}}$ into the equation $$\n\\displaystyle {y}^{″}+\\frac{4{\\pi }^{2}}{9}y=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right):\n$$\n\n$$\n\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,[-\\frac{4\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{4\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)-\\frac{4{\\pi }^{2}}{9}{y}_{{p}_{2}}]+\\frac{4{\\pi }^{2}}{9}{y}_{{p}_{2}}=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-\\frac{4\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{4\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n\n$$\n\\left\\{\\begin{aligned}-\\frac{4\\pi }{3}A &=-\\frac{3}{4} \\\\ \\frac{4\\pi }{3}B &=0\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}A &=\\frac{9}{16\\pi } \\\\ B &=0\\end{aligned}\\right.\n$$\n\nTherefore, the resonant component of a particular solution is\n\n$$\n{y}_{{p}_{2}}=\\frac{9x}{16\\pi }\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right).\n$$" "We begin by identifying resonance. The differential equation \n\n$$\n{y}^{″}+\\frac{4{\\pi }^{2}}{9}y=f(x)\n$$\n\nhas a natural frequency of \n\n$$\n\\omega =\\sqrt{\\frac{4{\\pi }^{2}}{9}}=\\frac{2\\pi }{3}.\n$$\n\nThe frequencies of the forcing harmonics for a $6$-periodic function $(L=3)$ are \n\n$$\n{\\omega }_{n}=\\frac{n\\pi }{3}.\n$$\n\nFor $n=2$, we have ${\\omega }_{2}=\\frac{2\\pi }{3}.$ Since ${\\omega }_{2}=\\omega ,$ the $n=2$ harmonic of the forcing function causes resonance.\n\nFor the $n=2$ harmonic, the forcing term is \n\n$$\n{f}_{2}(x)=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\n{y}_{{p}_{2}}=x\\left(A\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)+B\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)\\right).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{y}_{{p}_{2}}^{′} & =\\left(A\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)+B\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)\\right)+x\\left(-\\frac{2\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{2\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)\\right) \\\\ \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{y}_{{p}_{2}}^{″} & =-\\frac{4\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{4\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)-\\frac{4{\\pi }^{2}}{9}x\\left(A\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)+B\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)\\right)\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{{p}_{2}}^{″}$ and ${y}_{{p}_{2}}$ into the equation $$\n\\displaystyle {y}^{″}+\\frac{4{\\pi }^{2}}{9}y=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right):\n$$\n\n$$\n\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\left[-\\frac{4\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{4\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)-\\frac{4{\\pi }^{2}}{9}{y}_{{p}_{2}}\\right]+\\frac{4{\\pi }^{2}}{9}{y}_{{p}_{2}}=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-\\frac{4\\pi }{3}A\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right)+\\frac{4\\pi }{3}B\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right)=-\\frac{3}{4}\\operatorname{sin}⁡\\left(\\frac{2\\pi x}{3}\\right).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n\n$$\n\\left\\{\\begin{aligned}-\\frac{4\\pi }{3}A &=-\\frac{3}{4} \\\\ \\frac{4\\pi }{3}B &=0\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}A &=\\frac{9}{16\\pi } \\\\ B &=0\\end{aligned}\\right.\n$$\n\nTherefore, the resonant component of a particular solution is\n\n$$\n{y}_{{p}_{2}}=\\frac{9x}{16\\pi }\\operatorname{cos}⁡\\left(\\frac{2\\pi x}{3}\\right).\n$$"] [:db/cas 17592186507514 :question/worked-solution "The definitions of $\\operatorname{cosh}⁡x$ and $\\operatorname{sinh}⁡x$ are\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}),\\,\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nSubstituting the above definitions into the equation  $5\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x=5,$ we get\n\n$$\n\\begin{aligned}5\\cdot (\\frac{1}{2}({e}^{x}+{e}^{-x}))-\\frac{1}{2}({e}^{x}-{e}^{-x}) & =5 \\\\ \\frac{5}{2}{e}^{x}+\\frac{5}{2}{e}^{-x}-\\frac{1}{2}{e}^{x}+\\frac{1}{2}{e}^{-x} & =5 \\\\ 2{e}^{x}+3{e}^{-x} & =5.\\end{aligned}\n$$\n\nNext, we multiply both sides of the equation by ${e}^{x},$ and simplify:\n\n$$\n\\begin{aligned}{e}^{x}\\cdot (2{e}^{x}+3{e}^{-x}) & ={e}^{x}\\cdot 5 \\\\ 2{e}^{2x}+3 & =5{e}^{x} \\\\ 2{e}^{2x}-5{e}^{x}+3 & =0\\end{aligned}\n$$\n\nThis is a quadratic equation in ${e}^{x}$ that we can factor as follows:\n\n$$\n\\begin{aligned}(2{e}^{x}-3)({e}^{x}-1) & =0\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations:\n\n$$\n2{e}^{x}-3=0,\\,{e}^{x}-1=0\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}2{e}^{x}-3 & =0 &  & \\, & {e}^{x}-1 & =0 \\\\ {e}^{x} & =\\frac{3}{2} &  & \\, & {e}^{x} & =1 \\\\ {e}^{x} & =\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right) &  & \\, & x & =\\operatorname{ln}⁡1=0\\end{aligned}\n$$\n\nTherefore, $x=0$ and $x=\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)$ are the real solutions to the equation." "The definitions of $\\operatorname{cosh}⁡x$ and $\\operatorname{sinh}⁡x$ are\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}),\\,\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nSubstituting the above definitions into the equation  $5\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x=5,$ we get\n\n$$\n\\begin{aligned}5\\cdot \\left(\\frac{1}{2}({e}^{x}+{e}^{-x})\\right)-\\frac{1}{2}({e}^{x}-{e}^{-x}) & =5 \\\\ \\frac{5}{2}{e}^{x}+\\frac{5}{2}{e}^{-x}-\\frac{1}{2}{e}^{x}+\\frac{1}{2}{e}^{-x} & =5 \\\\ 2{e}^{x}+3{e}^{-x} & =5.\\end{aligned}\n$$\n\nNext, we multiply both sides of the equation by ${e}^{x},$ and simplify:\n\n$$\n\\begin{aligned}{e}^{x}\\cdot (2{e}^{x}+3{e}^{-x}) & ={e}^{x}\\cdot 5 \\\\ 2{e}^{2x}+3 & =5{e}^{x} \\\\ 2{e}^{2x}-5{e}^{x}+3 & =0\\end{aligned}\n$$\n\nThis is a quadratic equation in ${e}^{x}$ that we can factor as follows:\n\n$$\n\\begin{aligned}(2{e}^{x}-3)({e}^{x}-1) & =0\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations:\n\n$$\n2{e}^{x}-3=0,\\,{e}^{x}-1=0\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}2{e}^{x}-3 & =0 &  & \\, & {e}^{x}-1 & =0 \\\\ {e}^{x} & =\\frac{3}{2} &  & \\, & {e}^{x} & =1 \\\\ {e}^{x} & =\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right) &  & \\, & x & =\\operatorname{ln}⁡1=0\\end{aligned}\n$$\n\nTherefore, $x=0$ and $x=\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)$ are the real solutions to the equation."] [:db/cas 17592186507518 :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{18}+\\frac{(y-3)^{2}}{8} & =1 \\\\ \\frac{(0+2)^{2}}{18}+\\frac{(y-3)^{2}}{8} & =1 \\\\ \\frac{4}{18}+\\frac{(y-3)^{2}}{8} & =1 \\\\ \\frac{2}{9}+\\frac{(y-3)^{2}}{8} & =1 \\\\ 72\\,(\\frac{2}{9}+\\frac{(y-3)^{2}}{8}) & =72 \\\\ 16+9(y-3)^{2} & =72 \\\\ 9(y-3)^{2} & =56 \\\\ (y-3)^{2} & =\\frac{56}{9} \\\\ y-3 & =\\pm \\sqrt{\\frac{56}{9}}=\\pm \\frac{2\\sqrt{14}}{3} \\\\ y & =3\\pm \\frac{2\\sqrt{14}}{3}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,3+\\frac{2\\sqrt{14}}{3})\\,\\text{and}\\,B(0,3-\\frac{2\\sqrt{14}}{3}).\n$$" "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{18}+\\frac{(y-3)^{2}}{8} & =1 \\\\ \\frac{(0+2)^{2}}{18}+\\frac{(y-3)^{2}}{8} & =1 \\\\ \\frac{4}{18}+\\frac{(y-3)^{2}}{8} & =1 \\\\ \\frac{2}{9}+\\frac{(y-3)^{2}}{8} & =1 \\\\ 72\\,\\left(\\frac{2}{9}+\\frac{(y-3)^{2}}{8}\\right) & =72 \\\\ 16+9(y-3)^{2} & =72 \\\\ 9(y-3)^{2} & =56 \\\\ (y-3)^{2} & =\\frac{56}{9} \\\\ y-3 & =\\pm \\sqrt{\\frac{56}{9}}=\\pm \\frac{2\\sqrt{14}}{3} \\\\ y & =3\\pm \\frac{2\\sqrt{14}}{3}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA\\left(0,3+\\frac{2\\sqrt{14}}{3}\\right)\\,\\text{and}\\,B\\left(0,3-\\frac{2\\sqrt{14}}{3}\\right).\n$$"] [:db/cas 17592186507521 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=100$ and $p=0.5.$ Therefore, \n\n$$\n\\begin{aligned}np & =100\\cdot 0.5 \\\\  & =50 \\\\  & >5\\,✓ \\\\ n(1-p) & =100\\cdot (1-0.5) \\\\  & =50 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(100)(0.5)=50\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(100)(0.5)(1-0.5)=25.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(50,25).$\n\nNow, we can approximate the desired probability $P(X=58).$ Using a continuity correction, we have\n\n$$\nP(X=58)≈P(57.5\\le Y\\le 58.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(57.5\\le Y\\le 58.5) & =P(\\frac{57.5-50}{\\sqrt{25}}\\le Z\\le \\frac{58.5-50}{\\sqrt{25}}) \\\\  & ≈P(1.5\\le Z\\le 1.7) \\\\  & =P(Z\\le 1.7)-P(Z<1.5) \\\\  & =P(Z\\le 1.7)-P(Z\\le 1.5) \\\\  & =Φ(1.7)-Φ(1.5) \\\\  & =0.9554-0.9332 \\\\  & =0.022\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=58)≈0.022.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0223.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=100$ and $p=0.5.$ Therefore, \n\n$$\n\\begin{aligned}np & =100\\cdot 0.5 \\\\  & =50 \\\\  & >5\\,✓ \\\\ n(1-p) & =100\\cdot (1-0.5) \\\\  & =50 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(100)(0.5)=50\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(100)(0.5)(1-0.5)=25.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(50,25).$\n\nNow, we can approximate the desired probability $P(X=58).$ Using a continuity correction, we have\n\n$$\nP(X=58)≈P(57.5\\le Y\\le 58.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(57.5\\le Y\\le 58.5) & =P\\left(\\frac{57.5-50}{\\sqrt{25}}\\le Z\\le \\frac{58.5-50}{\\sqrt{25}}\\right) \\\\  & ≈P(1.5\\le Z\\le 1.7) \\\\  & =P(Z\\le 1.7)-P(Z<1.5) \\\\  & =P(Z\\le 1.7)-P(Z\\le 1.5) \\\\  & =Φ(1.7)-Φ(1.5) \\\\  & =0.9554-0.9332 \\\\  & =0.022\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=58)≈0.022.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0223.$"] [:db/cas 17592186507523 :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{4}+\\frac{(y-2)^{2}}{1}+\\frac{(0+2)^{2}}{8} & =1 \\\\ \\frac{1}{4}+\\frac{(y-2)^{2}}{1}+\\frac{4}{8} & =1 \\\\ (y-2)^{2} & =\\frac{1}{4} \\\\ y-2 & =\\pm \\frac{1}{2} \\\\ y & =2\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nHence, we get the solutions $y=\\frac{3}{2}$ and $y=\\frac{5}{2}.$ \n\nTherefore, the intercepts with the $y$-axis are $(0,\\frac{3}{2},0)$ and $(0,\\frac{5}{2},0).$" "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{4}+\\frac{(y-2)^{2}}{1}+\\frac{(0+2)^{2}}{8} & =1 \\\\ \\frac{1}{4}+\\frac{(y-2)^{2}}{1}+\\frac{4}{8} & =1 \\\\ (y-2)^{2} & =\\frac{1}{4} \\\\ y-2 & =\\pm \\frac{1}{2} \\\\ y & =2\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nHence, we get the solutions $y=\\frac{3}{2}$ and $y=\\frac{5}{2}.$ \n\nTherefore, the intercepts with the $y$-axis are $\\left(0,\\frac{3}{2},0\\right)$ and $\\left(0,\\frac{5}{2},0\\right).$"] [:db/cas 17592186508036 :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+2y=f(x),\\,y(4)=3\n$$\n\nwhere $f(x)$ is a $4$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(4)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{\\pi n}{2}x)+{b}_{n}\\sin \\,(\\frac{\\pi n}{2}x))\n$$" "Consider the initial value problem\n\n$$\n{y}^{′}+2y=f(x),\\,y(4)=3\n$$\n\nwhere $f(x)$ is a $4$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(4)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{\\pi n}{2}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{\\pi n}{2}x\\right)\\right)\n$$"] [:db/cas 17592186508036 :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+2y=0$ is \n\n$$\n{y}_{c}=A{e}^{-2x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+2y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-2x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{\\pi n}{2}x)+{b}_{n}\\sin \\,(\\frac{\\pi n}{2}x))\n$$\n\nNow, we apply the initial condition $y(4)=3.$ Using the hint that the particular solution part evaluates to zero at $x=4,$ we have\n\n$$\n\\begin{aligned}y(4) & =A{e}^{-2(4)}+{y}_{p}(4) \\\\ 3 & =A{e}^{-8}+0 \\\\ A & =3{e}^{8}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(3{e}^{8}){e}^{-2x}=3{e}^{8-2x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼3{e}^{8-2x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{\\pi n}{2}x)+{b}_{n}\\sin \\,(\\frac{\\pi n}{2}x)).\n$$" "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+2y=0$ is \n\n$$\n{y}_{c}=A{e}^{-2x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+2y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-2x}+{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{\\pi n}{2}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{\\pi n}{2}x\\right)\\right)\n$$\n\nNow, we apply the initial condition $y(4)=3.$ Using the hint that the particular solution part evaluates to zero at $x=4,$ we have\n\n$$\n\\begin{aligned}y(4) & =A{e}^{-2(4)}+{y}_{p}(4) \\\\ 3 & =A{e}^{-8}+0 \\\\ A & =3{e}^{8}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(3{e}^{8}){e}^{-2x}=3{e}^{8-2x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼3{e}^{8-2x}+{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{\\pi n}{2}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{\\pi n}{2}x\\right)\\right).\n$$"] [:db/cas 17592186508038 :question/worked-solution "First, we graph the function.\n\n![](images/57/57f5c6e193c1db7dc05024088bdcae5cef890c252eb0c06621e36174e1353a0e.png)\n\nThen, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $-1.$ This occurs at the point $(-2,-1).$ However, note that this point is not included in the graph.\n\n- The largest $y$-value is $\\frac{5}{2}.$ This occurs at the point $(5,\\frac{5}{2}).$\n\nThe function covers all the $y$-values between $-1$ and $\\frac{5}{2},$ including $\\frac{5}{2}$ but not including $-1.$\n\nTherefore, the range is $-1<y\\le \\frac{5}{2},$ which can also be written as  \n\n$$\n-1<f(x)\\le \\frac{5}{2}.\n$$" "First, we graph the function.\n\n![](images/57/57f5c6e193c1db7dc05024088bdcae5cef890c252eb0c06621e36174e1353a0e.png)\n\nThen, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $-1.$ This occurs at the point $(-2,-1).$ However, note that this point is not included in the graph.\n\n- The largest $y$-value is $\\frac{5}{2}.$ This occurs at the point $\\left(5,\\frac{5}{2}\\right).$\n\nThe function covers all the $y$-values between $-1$ and $\\frac{5}{2},$ including $\\frac{5}{2}$ but not including $-1.$\n\nTherefore, the range is $-1<y\\le \\frac{5}{2},$ which can also be written as  \n\n$$\n-1<f(x)\\le \\frac{5}{2}.\n$$"] [:db/cas 17592186508043 :question/worked-solution "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-\\text{E}[1] \\\\  & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1\\end{aligned}\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & =\\lim_{a\\to \\infty }{\\int }_{1}^{a}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & =\\lim_{a\\to \\infty }{\\left(-\\frac{3}{x}\\right)|}_{1}^{a} \\\\  & =\\lim_{a\\to \\infty }(3-\\frac{3}{a}) \\\\  & =3\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=\\frac{3}{2}$ and $\\text{E}[{X}^{2}]=3$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1 \\\\  & =3+2\\cdot \\frac{3}{2}-1 \\\\  & =3+3-1 \\\\  & =5.\\end{aligned}\n$$" "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-\\text{E}[1] \\\\  & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1\\end{aligned}\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & =\\lim_{a\\to \\infty }{\\int }_{1}^{a}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & =\\lim_{a\\to \\infty }{\\left(-\\frac{3}{x}\\right)|}_{1}^{a} \\\\  & =\\lim_{a\\to \\infty }\\left(3-\\frac{3}{a}\\right) \\\\  & =3\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=\\frac{3}{2}$ and $\\text{E}[{X}^{2}]=3$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1 \\\\  & =3+2\\cdot \\frac{3}{2}-1 \\\\  & =3+3-1 \\\\  & =5.\\end{aligned}\n$$"] [:db/cas 17592186508059 :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(2,-3).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=2$ and $y=-3$ into the equation above, we get\n\n$$\n\\begin{aligned}(-3)^{2} & =4p(2) \\\\ 9 & =8p \\\\ p & =\\frac{9}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{9}{2}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{9}{2}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{4y}\\end{aligned}\n$$" "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(2,-3).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=2$ and $y=-3$ into the equation above, we get\n\n$$\n\\begin{aligned}(-3)^{2} & =4p(2) \\\\ 9 & =8p \\\\ p & =\\frac{9}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{9}{2}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{9}{2}x\\right) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{4y}\\end{aligned}\n$$"] [:db/cas 17592186508061 :question/worked-solution "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nTherefore, the $y$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{y}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\text{d}A \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{{y}^{3}}}y\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y{\\int }_{0}^{\\sqrt{{y}^{3}}}\\text{d}x\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y[x]_{x=0}^{x=\\sqrt{{y}^{3}}}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y\\cdot \\sqrt{{y}^{3}}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}{y}^{5/2}\\,\\text{d}y \\\\  & =\\frac{5}{2}{[\\frac{2{y}^{7/2}}{7}]}_{0}^{1} \\\\  & =\\frac{5}{2}\\cdot \\frac{2}{7} \\\\  & =\\frac{5}{7}.\\end{aligned}\n$$" "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nTherefore, the $y$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{y}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\text{d}A \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{{y}^{3}}}y\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y{\\int }_{0}^{\\sqrt{{y}^{3}}}\\text{d}x\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y[x]_{x=0}^{x=\\sqrt{{y}^{3}}}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y\\cdot \\sqrt{{y}^{3}}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}{y}^{5/2}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\left[\\frac{2{y}^{7/2}}{7}\\right]}_{0}^{1} \\\\  & =\\frac{5}{2}\\cdot \\frac{2}{7} \\\\  & =\\frac{5}{7}.\\end{aligned}\n$$"] [:db/cas 17592186508063 :question/worked-solution "First we plot the graph of $y={\\left(\\frac{1}{5}\\right)}^{x}:$\n\n![](images/a5/a5b088c08da85c389cb96add374186a898793ec23cf0a3e39270c292fe3d606d.png)\n\nThen, we scale this graph by a factor of $\\frac{1}{4}.$ The $y$-intercept becomes $(0,\\frac{1}{4}),$ and the resulting graph is as follows:\n\n![](images/d5/d563be7169471498c6e0193e3be8493ae6ba119fc3fc7b74b397454b65e6cf57.png)" "First we plot the graph of $y={\\left(\\frac{1}{5}\\right)}^{x}:$\n\n![](images/a5/a5b088c08da85c389cb96add374186a898793ec23cf0a3e39270c292fe3d606d.png)\n\nThen, we scale this graph by a factor of $\\frac{1}{4}.$ The $y$-intercept becomes $\\left(0,\\frac{1}{4}\\right),$ and the resulting graph is as follows:\n\n![](images/d5/d563be7169471498c6e0193e3be8493ae6ba119fc3fc7b74b397454b65e6cf57.png)"] [:db/cas 17592186508090 :question/worked-solution "The graph of $y={\\left(\\frac{5}{4}\\right)}^{x}$ has a $y$-intercept of $(0,1),$ grows rapidly for $x>0,$ and approaches the asymptote $y=0$ for $x<0.$ \n\nWhen $x=1,$ we have $$\n\\displaystyle y={\\left(\\frac{5}{4}\\right)}^{1}=\\frac{5}{4}.\n$$ Therefore, another point on the graph is $(1,\\frac{5}{4}).$ \n\nWe draw the graph through these points as follows:\n\n![](images/92/929a671186aad590fe4f771d9facb822b40fe43b77579720edd38fb8f3d22f25.png)" "The graph of $y={\\left(\\frac{5}{4}\\right)}^{x}$ has a $y$-intercept of $(0,1),$ grows rapidly for $x>0,$ and approaches the asymptote $y=0$ for $x<0.$ \n\nWhen $x=1,$ we have $$\n\\displaystyle y={\\left(\\frac{5}{4}\\right)}^{1}=\\frac{5}{4}.\n$$ Therefore, another point on the graph is $\\left(1,\\frac{5}{4}\\right).$ \n\nWe draw the graph through these points as follows:\n\n![](images/92/929a671186aad590fe4f771d9facb822b40fe43b77579720edd38fb8f3d22f25.png)"] [:db/cas 17592186508098 :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=6{x}^{2}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot 6{x}^{2}\\,\\text{d}A \\\\  & ={∬}_{D}6{x}^{2}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-y}^{y}6{x}^{2}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y[{\\int }_{-y}^{y}3{x}^{2}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y\\cdot {[{x}^{3}]}_{x=-y}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y\\cdot 2{y}^{3}\\text{ }\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}4{y}^{4}\\,\\text{d}y \\\\  & ={[\\frac{4}{5}{y}^{5}]}_{y=0}^{y=1} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=6{x}^{2}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot 6{x}^{2}\\,\\text{d}A \\\\  & ={∬}_{D}6{x}^{2}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-y}^{y}6{x}^{2}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y[{\\int }_{-y}^{y}3{x}^{2}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y\\cdot {[{x}^{3}]}_{x=-y}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y\\cdot 2{y}^{3}\\text{ }\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}4{y}^{4}\\,\\text{d}y \\\\  & ={\\left[\\frac{4}{5}{y}^{5}\\right]}_{y=0}^{y=1} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$"] [:db/cas 17592186508467 :answer/value "$(\\frac{1}{2},2)$ only" "$\\left(\\frac{1}{2},2\\right)$ only"] [:db/cas 17592186508911 :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(\\frac{x+2}{x+1}\\right)}^{2x+2}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{x+2}{x+1}\\right)}^{2x+2} & =\\lim_{x\\to \\infty }{\\left(\\frac{(x+1)+1}{x+1}\\right)}^{2x+2} \\\\  & =\\lim_{x\\to \\infty }{(1+\\frac{1}{x+1})}^{2(x+1)}\\end{aligned}\n$$\n\nLet $x+1=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{x+2}{x+1}\\right)}^{2x+2} & =\\lim_{x\\to \\infty }{(1+\\frac{1}{x+1})}^{2(x+1)} \\\\  & =\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{2n} \\\\  & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={e}^{2}\\end{aligned}\n$$" "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(\\frac{x+2}{x+1}\\right)}^{2x+2}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{x+2}{x+1}\\right)}^{2x+2} & =\\lim_{x\\to \\infty }{\\left(\\frac{(x+1)+1}{x+1}\\right)}^{2x+2} \\\\  & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{x+1}\\right)}^{2(x+1)}\\end{aligned}\n$$\n\nLet $x+1=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{x+2}{x+1}\\right)}^{2x+2} & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{x+1}\\right)}^{2(x+1)} \\\\  & =\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{2n} \\\\  & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{2} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{2} \\\\  & ={e}^{2}\\end{aligned}\n$$"] [:db/cas 17592186508916 :question/worked-solution "**Step 1**: We need to find the value of $y$ such that the volume\n\n$$\nV=x\\cdot y\\cdot z=x\\cdot y\\cdot (2y)=2x{y}^{2}\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $432$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 432 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $z=2y,$ we get the constraint equation\n\n$$\n\\begin{aligned}432 & =2xy+2x(2y)+2y(2y) \\\\ 432 & =2xy+4xy+4{y}^{2} \\\\ 432 & =6xy+4{y}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\nx=\\frac{72}{y}-\\frac{2}{3}y\n$$\n\nThen, we substitute the above into the expression $V=2x{y}^{2}$, and we get\n\n$$\n\\begin{aligned}V(y) & =2{y}^{2}(\\frac{72}{y}-\\frac{2}{3}y) \\\\  & =144y-\\frac{4}{3}{y}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(y)=144-4{y}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 144-4{y}^{2} & =0 \\\\ {y}^{2} & =36 \\\\ y & =6.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $y$ must be positive.\n\n**Step 5**: We confirm that $y=6$ gives a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=-8y\\,⟹\\,{V}^{″}(6)=-48<0,\n$$\n\nSince ${V}^{″}(6)$ is negative, we conclude that this is indeed a maximum of $V(y).$\n\nTherefore, the box with the largest possible volume has height $y=6$ units." "**Step 1**: We need to find the value of $y$ such that the volume\n\n$$\nV=x\\cdot y\\cdot z=x\\cdot y\\cdot (2y)=2x{y}^{2}\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $432$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 432 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $z=2y,$ we get the constraint equation\n\n$$\n\\begin{aligned}432 & =2xy+2x(2y)+2y(2y) \\\\ 432 & =2xy+4xy+4{y}^{2} \\\\ 432 & =6xy+4{y}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\nx=\\frac{72}{y}-\\frac{2}{3}y\n$$\n\nThen, we substitute the above into the expression $V=2x{y}^{2}$, and we get\n\n$$\n\\begin{aligned}V(y) & =2{y}^{2}\\left(\\frac{72}{y}-\\frac{2}{3}y\\right) \\\\  & =144y-\\frac{4}{3}{y}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(y)=144-4{y}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 144-4{y}^{2} & =0 \\\\ {y}^{2} & =36 \\\\ y & =6.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $y$ must be positive.\n\n**Step 5**: We confirm that $y=6$ gives a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=-8y\\,⟹\\,{V}^{″}(6)=-48<0,\n$$\n\nSince ${V}^{″}(6)$ is negative, we conclude that this is indeed a maximum of $V(y).$\n\nTherefore, the box with the largest possible volume has height $y=6$ units."] [:db/cas 17592186508930 :question/worked-solution "First,  let $r$ be the radius of the circular sector and let $\\theta $ be the angle (in radians) subtended by it. We want to maximize the area\n\n$$\nA=\\frac{1}{2}{r}^{2}\\theta .\n$$\n\nWe know that the perimeter is fixed at $180$ units, so we also have the constraint condition\n\n$$\n180=2r+r\\theta .\n$$\n\nNow, by making $\\theta $ the subject of the constraint equation, we find that \n\n$$\n\\theta =\\frac{180-2r}{r}=\\frac{180}{r}-2.\n$$\n\nPlugging the above into our expression for $A,$ we obtain \n\n$$\n\\begin{aligned}A(r) & =\\frac{1}{2}{r}^{2}(\\frac{180}{r}-2) \\\\  & =90r-{r}^{2}.\\end{aligned}\n$$\n\nWe want to maximize $A,$ so we need to differentiate $A$ and set the derivative equal to zero. The derivative is \n\n$$\n{A}^{′}(r)=90-2r.\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ 90-2r & =0 \\\\ r & =45.\\end{aligned}\n$$\n\nFinally, we confirm that $r=45$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-2\\,⟹\\,{A}^{″}(45)=-2<0.\n$$\n\nSince ${A}^{″}(45)$ is negative, we conclude that $r=45$ is indeed a maximum of $A(r).$" "First,  let $r$ be the radius of the circular sector and let $\\theta $ be the angle (in radians) subtended by it. We want to maximize the area\n\n$$\nA=\\frac{1}{2}{r}^{2}\\theta .\n$$\n\nWe know that the perimeter is fixed at $180$ units, so we also have the constraint condition\n\n$$\n180=2r+r\\theta .\n$$\n\nNow, by making $\\theta $ the subject of the constraint equation, we find that \n\n$$\n\\theta =\\frac{180-2r}{r}=\\frac{180}{r}-2.\n$$\n\nPlugging the above into our expression for $A,$ we obtain \n\n$$\n\\begin{aligned}A(r) & =\\frac{1}{2}{r}^{2}\\left(\\frac{180}{r}-2\\right) \\\\  & =90r-{r}^{2}.\\end{aligned}\n$$\n\nWe want to maximize $A,$ so we need to differentiate $A$ and set the derivative equal to zero. The derivative is \n\n$$\n{A}^{′}(r)=90-2r.\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ 90-2r & =0 \\\\ r & =45.\\end{aligned}\n$$\n\nFinally, we confirm that $r=45$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-2\\,⟹\\,{A}^{″}(45)=-2<0.\n$$\n\nSince ${A}^{″}(45)$ is negative, we conclude that $r=45$ is indeed a maximum of $A(r).$"] [:db/cas 17592186508934 :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such as the volume\n\n$$\nV=x\\cdot x\\cdot y={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $216$ square units. So, we have the constraint equation\n\n$$\n\\begin{aligned}S & =2\\,\\text{(area of the base) }+4\\,\\text{(area of  one side) } \\\\ 216 & =2{x}^{2}+4xy.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation: \n\n$$\ny=\\frac{54}{x}-\\frac{x}{2}\n$$\n\nThen, we substitute $y=\\frac{54}{x}-\\frac{x}{2}$ in the expression $V={x}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(x) & ={x}^{2}(\\frac{54}{x}-\\frac{x}{2}) \\\\  & =54x-\\frac{{x}^{3}}{2}.\\end{aligned}\n$$\n\n \n\n**Step 4**: We solve the equation ${V}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(x)=54-\\frac{3{x}^{2}}{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(x) & =0 \\\\ 54-\\frac{3{x}^{2}}{2} & =0 \\\\ {x}^{2} & =36 \\\\ x & =6.\\end{aligned}\n$$\n\nNote that in the last step we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=6$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(x)=-3x\\,⟹\\,{V}^{″}(6)=-18<0.\n$$\n\nSince ${V}^{″}(6)$ is negative, we conclude that $x=6$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x=6$ units." "**Step 1**: We need to find the values of $x$ and $y$ such as the volume\n\n$$\nV=x\\cdot x\\cdot y={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $216$ square units. So, we have the constraint equation\n\n$$\n\\begin{aligned}S & =2\\,\\text{(area of the base) }+4\\,\\text{(area of  one side) } \\\\ 216 & =2{x}^{2}+4xy.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation: \n\n$$\ny=\\frac{54}{x}-\\frac{x}{2}\n$$\n\nThen, we substitute $y=\\frac{54}{x}-\\frac{x}{2}$ in the expression $V={x}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(x) & ={x}^{2}\\left(\\frac{54}{x}-\\frac{x}{2}\\right) \\\\  & =54x-\\frac{{x}^{3}}{2}.\\end{aligned}\n$$\n\n \n\n**Step 4**: We solve the equation ${V}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(x)=54-\\frac{3{x}^{2}}{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(x) & =0 \\\\ 54-\\frac{3{x}^{2}}{2} & =0 \\\\ {x}^{2} & =36 \\\\ x & =6.\\end{aligned}\n$$\n\nNote that in the last step we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=6$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(x)=-3x\\,⟹\\,{V}^{″}(6)=-18<0.\n$$\n\nSince ${V}^{″}(6)$ is negative, we conclude that $x=6$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x=6$ units."] [:db/cas 17592186508940 :question/worked-solution "First, let $r$ be the radius of the circular sector and let $\\theta $ be the angle (in radians) subtended by it. We want to maximize the area\n\n$$\nA=\\frac{1}{2}{r}^{2}\\theta .\n$$\n\nWe know that the perimeter is fixed at $80$ units, so we also have the constraint condition\n\n$$\n80=2r+r\\theta .\n$$\n\nNow, by making $\\theta $ the subject of the constraint equation, we find that\n\n$$\n\\theta =\\frac{80-2r}{r}=\\frac{80}{r}-2.\n$$\n\nPlugging the above into our expression for $A$, we obtain\n\n$$\n\\begin{aligned}A(r) & =\\frac{1}{2}{r}^{2}(\\frac{80}{r}-2) \\\\  & =40r-{r}^{2}.\\end{aligned}\n$$\n\nWe want to maximize $A$, so we need to differentiate $A$ and set the derivative equal to zero. The derivative is\n\n$$\n{A}^{′}(r)=40-2r.\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ 40-2r & =0 \\\\ r & =20.\\end{aligned}\n$$\n\nNow, we confirm that $r=20$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-2\\,⟹\\,{A}^{″}(20)=-2<0.\n$$\n\nSince ${A}^{″}(20)$ is negative, we conclude that $r=20$ is indeed a maximum of $A(r).$\n\nTherefore, the circular sector of the largest area will have a radius of $20,$ and the area is given by \n\n$$\n\\begin{aligned}A & =40r-{r}^{2} \\\\  & =40(20)-(20)^{2} \\\\  & =400.\\end{aligned}\n$$" "First, let $r$ be the radius of the circular sector and let $\\theta $ be the angle (in radians) subtended by it. We want to maximize the area\n\n$$\nA=\\frac{1}{2}{r}^{2}\\theta .\n$$\n\nWe know that the perimeter is fixed at $80$ units, so we also have the constraint condition\n\n$$\n80=2r+r\\theta .\n$$\n\nNow, by making $\\theta $ the subject of the constraint equation, we find that\n\n$$\n\\theta =\\frac{80-2r}{r}=\\frac{80}{r}-2.\n$$\n\nPlugging the above into our expression for $A$, we obtain\n\n$$\n\\begin{aligned}A(r) & =\\frac{1}{2}{r}^{2}\\left(\\frac{80}{r}-2\\right) \\\\  & =40r-{r}^{2}.\\end{aligned}\n$$\n\nWe want to maximize $A$, so we need to differentiate $A$ and set the derivative equal to zero. The derivative is\n\n$$\n{A}^{′}(r)=40-2r.\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ 40-2r & =0 \\\\ r & =20.\\end{aligned}\n$$\n\nNow, we confirm that $r=20$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-2\\,⟹\\,{A}^{″}(20)=-2<0.\n$$\n\nSince ${A}^{″}(20)$ is negative, we conclude that $r=20$ is indeed a maximum of $A(r).$\n\nTherefore, the circular sector of the largest area will have a radius of $20,$ and the area is given by \n\n$$\n\\begin{aligned}A & =40r-{r}^{2} \\\\  & =40(20)-(20)^{2} \\\\  & =400.\\end{aligned}\n$$"] [:db/cas 17592186508943 :question/worked-solution "**Step 1**: We need to find the values of $x,y,$ and $z$ such as the volume\n\n$$\nV=x\\cdot y\\cdot z=2z\\cdot y\\cdot z=2{z}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $48$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 48 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $x=2z,$ we get the constraint equation\n\n$$\n\\begin{aligned}48 & =2(2z)y+2(2z)z+2yz \\\\ 48 & =4yz+4{z}^{2}+2yz \\\\ 48 & =6zy+4{z}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\ny=\\frac{8}{z}-\\frac{2z}{3}\n$$\n\nThen, we substitute the above into the expression $V=2{z}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(z) & =2{z}^{2}(\\frac{8}{z}-\\frac{2z}{3}) \\\\  & =16z-\\frac{4{z}^{3}}{3}.\\end{aligned}\n$$\n\n \n\n**Step 4**: We solve the equation ${V}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(z)=16-4{z}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(z) & =0 \\\\ 16-4{z}^{2} & =0 \\\\ 4{z}^{2} & =16 \\\\ {z}^{2} & =4 \\\\ z & =2.\\end{aligned}\n$$\n\nNote that in the last step we only considered the positive root because the side length $z$ must be positive. \n\n**Step 5**: We confirm that $z=2$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(z)=-8z\\,⟹\\,{V}^{″}(2)=-16<0.\n$$\n\nSince ${V}^{″}(2)$ is negative, we conclude that $z=2$ is indeed a maximum of $V(z).$\n\nTherefore, the box with the largest possible volume has the depth $z=2$ units." "**Step 1**: We need to find the values of $x,y,$ and $z$ such as the volume\n\n$$\nV=x\\cdot y\\cdot z=2z\\cdot y\\cdot z=2{z}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $48$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 48 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $x=2z,$ we get the constraint equation\n\n$$\n\\begin{aligned}48 & =2(2z)y+2(2z)z+2yz \\\\ 48 & =4yz+4{z}^{2}+2yz \\\\ 48 & =6zy+4{z}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\ny=\\frac{8}{z}-\\frac{2z}{3}\n$$\n\nThen, we substitute the above into the expression $V=2{z}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(z) & =2{z}^{2}\\left(\\frac{8}{z}-\\frac{2z}{3}\\right) \\\\  & =16z-\\frac{4{z}^{3}}{3}.\\end{aligned}\n$$\n\n \n\n**Step 4**: We solve the equation ${V}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(z)=16-4{z}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(z) & =0 \\\\ 16-4{z}^{2} & =0 \\\\ 4{z}^{2} & =16 \\\\ {z}^{2} & =4 \\\\ z & =2.\\end{aligned}\n$$\n\nNote that in the last step we only considered the positive root because the side length $z$ must be positive. \n\n**Step 5**: We confirm that $z=2$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(z)=-8z\\,⟹\\,{V}^{″}(2)=-16<0.\n$$\n\nSince ${V}^{″}(2)$ is negative, we conclude that $z=2$ is indeed a maximum of $V(z).$\n\nTherefore, the box with the largest possible volume has the depth $z=2$ units."] [:db/cas 17592186508953 :question/problem "Evaluate $\\lim_{t\\to \\infty }{(1+\\frac{1}{3t-6})}^{t-2}.$" "Evaluate $\\lim_{t\\to \\infty }{\\left(1+\\frac{1}{3t-6}\\right)}^{t-2}.$"] [:db/cas 17592186508953 :question/worked-solution "Notice that as $t\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{t\\to \\infty }{(1+\\frac{1}{3t-6})}^{t-2}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nIn the given limit, we let $3t-6=n.$ Thus, we have\n\n$$\n\\begin{aligned}3t-6 & =n \\\\ 3(t-2) & =n \\\\ t-2 & =\\frac{n}{3}\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $t\\to \\infty ,$ we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{t\\to \\infty }{(1+\\frac{1}{3t-6})}^{t-2} & =\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n/3} \\\\  & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{1/3} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{1/3} \\\\  & ={e}^{1/3} \\\\  & =\\sqrt[3]{e}\\end{aligned}\n$$" "Notice that as $t\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{t\\to \\infty }{\\left(1+\\frac{1}{3t-6}\\right)}^{t-2}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}=e\n$$\n\nIn the given limit, we let $3t-6=n.$ Thus, we have\n\n$$\n\\begin{aligned}3t-6 & =n \\\\ 3(t-2) & =n \\\\ t-2 & =\\frac{n}{3}\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $t\\to \\infty ,$ we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{t\\to \\infty }{\\left(1+\\frac{1}{3t-6}\\right)}^{t-2} & =\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n/3} \\\\  & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{1/3} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{1/3} \\\\  & ={e}^{1/3} \\\\  & =\\sqrt[3]{e}\\end{aligned}\n$$"] [:db/cas 17592186508955 :question/worked-solution "First, let $r$ be the radius of the circular sector and let $\\theta $ be the angle (in radians) subtended by it. We want to maximize the area\n\n$$\nA=\\frac{1}{2}{r}^{2}\\theta .\n$$\n\nWe know that the perimeter is fixed at $100$ units, so we also have the constraint condition\n\n$$\n100=2r+r\\theta .\n$$\n\nNow, by making $\\theta $ the subject of the constraint equation, we find that\n\n$$\n\\theta =\\frac{100-2r}{r}=\\frac{100}{r}-2.\n$$\n\nPlugging the above into our expression for $A$, we obtain\n\n$$\n\\begin{aligned}A(r) & =\\frac{1}{2}{r}^{2}(\\frac{100}{r}-2) \\\\  & =50r-{r}^{2}.\\end{aligned}\n$$\n\nWe want to maximize $A$, so we need to differentiate $A$ and set the derivative equal to zero. The derivative is\n\n$$\n{A}^{′}(r)=50-2r.\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ 50-2r & =0 \\\\ r & =25.\\end{aligned}\n$$\n\nNow, we confirm that $r=25$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-2\\,⟹\\,{A}^{″}(25)=-2<0.\n$$\n\nSince ${A}^{″}(25)$ is negative, we conclude that $r=25$ is indeed a maximum of $A(r).$\n\nFinally, when $r=25$ we have\n\n$$\n\\begin{aligned}\\theta  & =\\frac{100}{r}-2 \\\\  & =\\frac{100}{25}-2 \\\\  & =2.\\end{aligned}\n$$" "First, let $r$ be the radius of the circular sector and let $\\theta $ be the angle (in radians) subtended by it. We want to maximize the area\n\n$$\nA=\\frac{1}{2}{r}^{2}\\theta .\n$$\n\nWe know that the perimeter is fixed at $100$ units, so we also have the constraint condition\n\n$$\n100=2r+r\\theta .\n$$\n\nNow, by making $\\theta $ the subject of the constraint equation, we find that\n\n$$\n\\theta =\\frac{100-2r}{r}=\\frac{100}{r}-2.\n$$\n\nPlugging the above into our expression for $A$, we obtain\n\n$$\n\\begin{aligned}A(r) & =\\frac{1}{2}{r}^{2}\\left(\\frac{100}{r}-2\\right) \\\\  & =50r-{r}^{2}.\\end{aligned}\n$$\n\nWe want to maximize $A$, so we need to differentiate $A$ and set the derivative equal to zero. The derivative is\n\n$$\n{A}^{′}(r)=50-2r.\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ 50-2r & =0 \\\\ r & =25.\\end{aligned}\n$$\n\nNow, we confirm that $r=25$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-2\\,⟹\\,{A}^{″}(25)=-2<0.\n$$\n\nSince ${A}^{″}(25)$ is negative, we conclude that $r=25$ is indeed a maximum of $A(r).$\n\nFinally, when $r=25$ we have\n\n$$\n\\begin{aligned}\\theta  & =\\frac{100}{r}-2 \\\\  & =\\frac{100}{25}-2 \\\\  & =2.\\end{aligned}\n$$"] [:db/cas 17592186508956 :question/worked-solution "We let $r$ be the radius of the circular sector and let $x$ the side of the rectangle.\nThen, we want to minimize the perimeter\n\n$$\nP=\\pi r+2x+2r.\n$$\n\nWe know that the area is fixed at $\\frac{25}{9}$ square units, so we also have the constraint condition\n\n$$\n\\frac{25}{9}=2rx+\\frac{\\pi {r}^{2}}{2}.\n$$\n\nNow, by making $x$ the subject of the constraint equation and taking into account that $r>0,$ we find that\n\n$$\n\\begin{aligned}\\frac{25}{9} & =2rx+\\frac{\\pi {r}^{2}}{2} \\\\ 2rx & =\\frac{25}{9}-\\frac{\\pi {r}^{2}}{2} \\\\ x & =\\frac{25}{18r}-\\frac{\\pi r}{4}.\\end{aligned}\n$$\n\nPlugging this into our expression for $P,$ we obtain\n\n$$\n\\begin{aligned}P & =\\pi r+2x+2r \\\\  & =\\pi r+2(\\frac{25}{18r}-\\frac{\\pi r}{4})+2r \\\\  & =\\pi r+\\frac{25}{9r}-\\frac{\\pi r}{2}+2r \\\\  & =(\\frac{\\pi }{2}+2)r+\\frac{25}{9r}.\\end{aligned}\n$$\n\nWe want to minimize $P,$ so we need to differentiate $P$ and set the derivative equal to zero. Computing the derivative gives \n\n$$\n{P}^{′}(r)=\\frac{\\pi }{2}+2-\\frac{25}{9{r}^{2}}.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives\n\n$$\n\\begin{aligned}\\frac{\\pi }{2}+2-\\frac{25}{9{r}^{2}} & =0 \\\\ 9{r}^{2} & =\\frac{25}{\\frac{\\pi }{2}+2} \\\\ {r}^{2} & =\\frac{50}{9(\\pi +4)} \\\\ r & =\\frac{5}{3}\\sqrt{\\frac{2}{\\pi +4}}.\\end{aligned}\n$$\n\nFinally, we confirm that $r=\\frac{5}{3}\\sqrt{\\frac{2}{\\pi +4}}$ is a minimum using the second derivative test.\n\nSince the second derivative ${P}^{″}(r)=\\frac{50}{9{r}^{3}}>0$, the stationary point $r=\\frac{5}{3}\\sqrt{\\frac{2}{\\pi +4}}$ is a minimum." "We let $r$ be the radius of the circular sector and let $x$ the side of the rectangle.\nThen, we want to minimize the perimeter\n\n$$\nP=\\pi r+2x+2r.\n$$\n\nWe know that the area is fixed at $\\frac{25}{9}$ square units, so we also have the constraint condition\n\n$$\n\\frac{25}{9}=2rx+\\frac{\\pi {r}^{2}}{2}.\n$$\n\nNow, by making $x$ the subject of the constraint equation and taking into account that $r>0,$ we find that\n\n$$\n\\begin{aligned}\\frac{25}{9} & =2rx+\\frac{\\pi {r}^{2}}{2} \\\\ 2rx & =\\frac{25}{9}-\\frac{\\pi {r}^{2}}{2} \\\\ x & =\\frac{25}{18r}-\\frac{\\pi r}{4}.\\end{aligned}\n$$\n\nPlugging this into our expression for $P,$ we obtain\n\n$$\n\\begin{aligned}P & =\\pi r+2x+2r \\\\  & =\\pi r+2\\left(\\frac{25}{18r}-\\frac{\\pi r}{4}\\right)+2r \\\\  & =\\pi r+\\frac{25}{9r}-\\frac{\\pi r}{2}+2r \\\\  & =\\left(\\frac{\\pi }{2}+2\\right)r+\\frac{25}{9r}.\\end{aligned}\n$$\n\nWe want to minimize $P,$ so we need to differentiate $P$ and set the derivative equal to zero. Computing the derivative gives \n\n$$\n{P}^{′}(r)=\\frac{\\pi }{2}+2-\\frac{25}{9{r}^{2}}.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives\n\n$$\n\\begin{aligned}\\frac{\\pi }{2}+2-\\frac{25}{9{r}^{2}} & =0 \\\\ 9{r}^{2} & =\\frac{25}{\\frac{\\pi }{2}+2} \\\\ {r}^{2} & =\\frac{50}{9(\\pi +4)} \\\\ r & =\\frac{5}{3}\\sqrt{\\frac{2}{\\pi +4}}.\\end{aligned}\n$$\n\nFinally, we confirm that $r=\\frac{5}{3}\\sqrt{\\frac{2}{\\pi +4}}$ is a minimum using the second derivative test.\n\nSince the second derivative ${P}^{″}(r)=\\frac{50}{9{r}^{3}}>0$, the stationary point $r=\\frac{5}{3}\\sqrt{\\frac{2}{\\pi +4}}$ is a minimum."] [:db/cas 17592186508959 :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(\\frac{3x+1}{3x}\\right)}^{6x}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{3x+1}{3x}\\right)}^{6x} & =\\lim_{x\\to \\infty }{(1+\\frac{1}{3x})}^{2(3x)}\\end{aligned}\n$$\n\nLet $3x=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{3x+1}{3x}\\right)}^{6x} & =\\lim_{x\\to \\infty }{(1+\\frac{1}{3x})}^{2(3x)} \\\\  & =\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{2n} \\\\  & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={e}^{2}\\end{aligned}\n$$" "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(\\frac{3x+1}{3x}\\right)}^{6x}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{3x+1}{3x}\\right)}^{6x} & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{3x}\\right)}^{2(3x)}\\end{aligned}\n$$\n\nLet $3x=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{3x+1}{3x}\\right)}^{6x} & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{3x}\\right)}^{2(3x)} \\\\  & =\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{2n} \\\\  & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{2} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{2} \\\\  & ={e}^{2}\\end{aligned}\n$$"] [:db/cas 17592186508970 :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such that the volume\n\n$$\nV={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $294$ square units. So, we have the constraint equation\n\n$$\n\\begin{aligned}S & =2\\,\\text{(area of the base)}+4\\,\\text{(area of one side)} \\\\ 294 & =2{x}^{2}+4xy.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation:\n\n$$\ny=\\frac{147}{2x}-\\frac{x}{2}\n$$\n\nThen, we substitute $y=\\frac{147}{2x}-\\frac{x}{2}$ in the expression $V={x}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(x) & ={x}^{2}(\\frac{147}{2x}-\\frac{x}{2}) \\\\  & =\\frac{147}{2}x-\\frac{1}{2}{x}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(x)=\\frac{147}{2}-\\frac{3}{2}{x}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(x) & =0 \\\\ \\frac{147}{2}-\\frac{3}{2}{x}^{2} & =0 \\\\ {x}^{2} & =49 \\\\ x & =7.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=7$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(x)=-3x\\,⟹\\,{V}^{″}(7)=-21<0.\n$$\n\nSince ${V}^{″}(7)$ is negative, we conclude that $x=7$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x=7$ units." "**Step 1**: We need to find the values of $x$ and $y$ such that the volume\n\n$$\nV={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $294$ square units. So, we have the constraint equation\n\n$$\n\\begin{aligned}S & =2\\,\\text{(area of the base)}+4\\,\\text{(area of one side)} \\\\ 294 & =2{x}^{2}+4xy.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation:\n\n$$\ny=\\frac{147}{2x}-\\frac{x}{2}\n$$\n\nThen, we substitute $y=\\frac{147}{2x}-\\frac{x}{2}$ in the expression $V={x}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(x) & ={x}^{2}\\left(\\frac{147}{2x}-\\frac{x}{2}\\right) \\\\  & =\\frac{147}{2}x-\\frac{1}{2}{x}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(x)=\\frac{147}{2}-\\frac{3}{2}{x}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(x) & =0 \\\\ \\frac{147}{2}-\\frac{3}{2}{x}^{2} & =0 \\\\ {x}^{2} & =49 \\\\ x & =7.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=7$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(x)=-3x\\,⟹\\,{V}^{″}(7)=-21<0.\n$$\n\nSince ${V}^{″}(7)$ is negative, we conclude that $x=7$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x=7$ units."] [:db/cas 17592186508974 :question/worked-solution "**Step 1**: We need to find the value of $y$ such that the volume\n\n$$\nV=x\\cdot y\\cdot z\n$$\n\nis the greatest possible value.\n\nSince $y=\\frac{3}{2}x,$ we have $x=\\frac{2}{3}y,$ so\n\n$$\nV=(\\frac{2}{3}y)\\cdot y\\cdot z=\\frac{2}{3}{y}^{2}z.\n$$\n\n**Step 2**: The surface area is $196$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 196 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $x=\\frac{2}{3}y,$ we get the constraint equation\n\n$$\n\\begin{aligned}196 & =2(\\frac{2}{3}y)y+2(\\frac{2}{3}y)z+2yz \\\\ 196 & =\\frac{4}{3}{y}^{2}+\\frac{4}{3}yz+2yz \\\\ 196 & =\\frac{4}{3}{y}^{2}+\\frac{10}{3}yz.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\nz=\\frac{294}{5y}-\\frac{2}{5}y\n$$\n\nThen, we substitute the above into the expression $V=\\frac{2}{3}{y}^{2}z$, and we get\n\n$$\n\\begin{aligned}V(y) & =\\frac{2}{3}{y}^{2}(\\frac{294}{5y}-\\frac{2}{5}y) \\\\  & =\\frac{196}{5}y-\\frac{4}{15}{y}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(y)=\\frac{196}{5}-\\frac{4}{5}{y}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ \\frac{196}{5}-\\frac{4}{5}{y}^{2} & =0 \\\\ 196-4{y}^{2} & =0 \\\\ {y}^{2} & =49 \\\\ y & =7.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $y$ must be positive.\n\n**Step 5**: We confirm that $y=7$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=-\\frac{8}{5}y\\,⟹\\,{V}^{″}(7)=-\\frac{56}{5}<0,\n$$\n\nSince ${V}^{″}(7)$ is negative, we conclude that $y=7$ is indeed a maximum of $V(y).$\n\nTherefore, the box with the largest possible volume has height $y=7$ units." "**Step 1**: We need to find the value of $y$ such that the volume\n\n$$\nV=x\\cdot y\\cdot z\n$$\n\nis the greatest possible value.\n\nSince $y=\\frac{3}{2}x,$ we have $x=\\frac{2}{3}y,$ so\n\n$$\nV=\\left(\\frac{2}{3}y\\right)\\cdot y\\cdot z=\\frac{2}{3}{y}^{2}z.\n$$\n\n**Step 2**: The surface area is $196$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 196 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $x=\\frac{2}{3}y,$ we get the constraint equation\n\n$$\n\\begin{aligned}196 & =2\\left(\\frac{2}{3}y\\right)y+2\\left(\\frac{2}{3}y\\right)z+2yz \\\\ 196 & =\\frac{4}{3}{y}^{2}+\\frac{4}{3}yz+2yz \\\\ 196 & =\\frac{4}{3}{y}^{2}+\\frac{10}{3}yz.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\nz=\\frac{294}{5y}-\\frac{2}{5}y\n$$\n\nThen, we substitute the above into the expression $V=\\frac{2}{3}{y}^{2}z$, and we get\n\n$$\n\\begin{aligned}V(y) & =\\frac{2}{3}{y}^{2}\\left(\\frac{294}{5y}-\\frac{2}{5}y\\right) \\\\  & =\\frac{196}{5}y-\\frac{4}{15}{y}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(y)=\\frac{196}{5}-\\frac{4}{5}{y}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ \\frac{196}{5}-\\frac{4}{5}{y}^{2} & =0 \\\\ 196-4{y}^{2} & =0 \\\\ {y}^{2} & =49 \\\\ y & =7.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $y$ must be positive.\n\n**Step 5**: We confirm that $y=7$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=-\\frac{8}{5}y\\,⟹\\,{V}^{″}(7)=-\\frac{56}{5}<0,\n$$\n\nSince ${V}^{″}(7)$ is negative, we conclude that $y=7$ is indeed a maximum of $V(y).$\n\nTherefore, the box with the largest possible volume has height $y=7$ units."] [:db/cas 17592186508976 :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(\\frac{2x-1}{2x-2}\\right)}^{x-1}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{2x-1}{2x-2}\\right)}^{x-1} & =\\lim_{x\\to \\infty }{\\left(\\frac{(2x-2)+1}{2x-2}\\right)}^{x-1} \\\\  & =\\lim_{x\\to \\infty }{(1+\\frac{1}{2x-2})}^{x-1} \\\\  & =\\lim_{x\\to \\infty }{(1+\\frac{1}{2(x-1)})}^{x-1}\\end{aligned}\n$$\n\nLet $2(x-1)=n$ Then, we have \n\n$$\n\\begin{aligned}2(x-1) & =n \\\\ x-1 & =\\frac{n}{2}.\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{2x-1}{2x-2}\\right)}^{x-1} & =\\lim_{x\\to \\infty }{(1+\\frac{1}{2(x-1)})}^{x-1} \\\\  & =\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n/2} \\\\  & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{1/2} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{1/2} \\\\  & ={e}^{1/2} \\\\  & =\\sqrt{e}\\end{aligned}\n$$" "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(\\frac{2x-1}{2x-2}\\right)}^{x-1}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{2x-1}{2x-2}\\right)}^{x-1} & =\\lim_{x\\to \\infty }{\\left(\\frac{(2x-2)+1}{2x-2}\\right)}^{x-1} \\\\  & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{2x-2}\\right)}^{x-1} \\\\  & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{2(x-1)}\\right)}^{x-1}\\end{aligned}\n$$\n\nLet $2(x-1)=n$ Then, we have \n\n$$\n\\begin{aligned}2(x-1) & =n \\\\ x-1 & =\\frac{n}{2}.\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(\\frac{2x-1}{2x-2}\\right)}^{x-1} & =\\lim_{x\\to \\infty }{\\left(1+\\frac{1}{2(x-1)}\\right)}^{x-1} \\\\  & =\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n/2} \\\\  & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{1/2} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{1/2} \\\\  & ={e}^{1/2} \\\\  & =\\sqrt{e}\\end{aligned}\n$$"] [:db/cas 17592186508979 :question/problem "Evaluate the following limit:\n\n$$\n\\lim_{x\\to \\infty }{(1+\\frac{3}{x})}^{2x}=\n$$\n{{field-1}}" "Evaluate the following limit:\n\n$$\n\\lim_{x\\to \\infty }{\\left(1+\\frac{3}{x}\\right)}^{2x}=\n$$\n{{field-1}}"] [:db/cas 17592186508979 :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{(1+\\frac{3}{x})}^{2x}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nIn the given limit, we let $\\frac{3}{x}=\\frac{1}{n}.$ Thus, we have\n\n$$\n\\begin{aligned}\\frac{3}{x} & =\\frac{1}{n} \\\\ x & =3n.\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{(1+\\frac{3}{x})}^{2x} & =\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{2(3n)} \\\\  & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{6} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{6} \\\\  & ={e}^{6}\\end{aligned}\n$$" "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to \\infty }{\\left(1+\\frac{3}{x}\\right)}^{2x}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}=e\n$$\n\nIn the given limit, we let $\\frac{3}{x}=\\frac{1}{n}.$ Thus, we have\n\n$$\n\\begin{aligned}\\frac{3}{x} & =\\frac{1}{n} \\\\ x & =3n.\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }{\\left(1+\\frac{3}{x}\\right)}^{2x} & =\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{2(3n)} \\\\  & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{6} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{6} \\\\  & ={e}^{6}\\end{aligned}\n$$"] [:db/cas 17592186508984 :question/worked-solution "First,  let $r$ the radius of the upper semicircle (top) and $x$ the radius of the lateral semicircle (right), hence the dimensions of the rectangle are $2r$ and $2x.$ We want to maximize the area\n\n$$\n\\begin{aligned}A & =(2r)(2x)+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi {x}^{2}}{2} \\\\  & =4rx+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi {x}^{2}}{2}.\\end{aligned}\n$$\n\nWe know that the perimeter is fixed at $200$ units, so we also have the constraint condition\n\n$$\n200=\\pi r+\\pi x+2x+2r\\,.\n$$\n\nNow, by making $x$ the subject of the constraint equation, we find that \n\n$$\n\\begin{aligned}200 & =\\pi r+\\pi x+2x+2r \\\\ x(\\pi +2) & =200-r(\\pi +2) \\\\ x & =\\frac{200}{\\pi +2}-r\\,.\\end{aligned}\n$$\n\nPlugging the above into our expression for $A,$ we obtain\n\n$$\n\\begin{aligned}A & =4rx+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi {x}^{2}}{2} \\\\  & =4r(\\frac{200}{\\pi +2}-r)+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi }{2}{(\\frac{200}{\\pi +2}-r)}^{2}\\,.\\end{aligned}\n$$\n\nWe want to maximize $A,$ so we need to differentiate $A$ and set the derivative equal to zero. The derivative is\n\n$$\n\\begin{aligned}{A}^{′}(r) & =4(\\frac{200}{\\pi +2}-r)+4r(-1)+\\pi r+\\pi (\\frac{200}{\\pi +2}-r)(-1) \\\\  & =\\frac{800}{\\pi +2}-4r-4r+\\pi r-\\frac{200\\pi }{\\pi +2}+\\pi r \\\\  & =-8r+2\\pi r+\\frac{800-200\\pi }{\\pi +2}\\,.\\end{aligned}\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ -8r+2\\pi r+\\frac{800-200\\pi }{\\pi +2} & =0 \\\\ 2r(\\pi -4) & =-\\frac{800-200\\pi }{\\pi +2} \\\\ 2r(\\pi -4) & =\\frac{200\\pi -800}{\\pi +2} \\\\ r & =\\frac{100\\pi -400}{(\\pi +2)(\\pi -4)} \\\\ r & =\\frac{100(\\pi -4)}{(\\pi +2)(\\pi -4)} \\\\ r & =\\frac{100}{\\pi +2}\\,.\\end{aligned}\n$$\n\nNow, we confirm that $r=\\frac{100}{\\pi +2}$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-8+2\\pi \\,⟹\\,{A}^{″}\\left(\\frac{100}{\\pi +2}\\right)=-8+2\\pi <0.\n$$\n\nSince ${A}^{″}\\left(\\frac{100}{\\pi +2}\\right)$ is negative, we conclude that $r=\\frac{100}{\\pi +2}$ is indeed a maximum of $A(r).$\n\nFinally, when $r=\\frac{100}{\\pi +2}$, we have \n\n$$\n\\begin{aligned}x & =\\frac{200}{\\pi +2}-\\frac{100}{\\pi +2} \\\\  & =\\frac{100}{\\pi +2}\\,.\\end{aligned}\n$$\n\nTherefore, the length of the side of the field with the largest area is $2x=\\frac{200}{\\pi +2}.$" "First,  let $r$ the radius of the upper semicircle (top) and $x$ the radius of the lateral semicircle (right), hence the dimensions of the rectangle are $2r$ and $2x.$ We want to maximize the area\n\n$$\n\\begin{aligned}A & =(2r)(2x)+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi {x}^{2}}{2} \\\\  & =4rx+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi {x}^{2}}{2}.\\end{aligned}\n$$\n\nWe know that the perimeter is fixed at $200$ units, so we also have the constraint condition\n\n$$\n200=\\pi r+\\pi x+2x+2r\\,.\n$$\n\nNow, by making $x$ the subject of the constraint equation, we find that \n\n$$\n\\begin{aligned}200 & =\\pi r+\\pi x+2x+2r \\\\ x(\\pi +2) & =200-r(\\pi +2) \\\\ x & =\\frac{200}{\\pi +2}-r\\,.\\end{aligned}\n$$\n\nPlugging the above into our expression for $A,$ we obtain\n\n$$\n\\begin{aligned}A & =4rx+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi {x}^{2}}{2} \\\\  & =4r\\left(\\frac{200}{\\pi +2}-r\\right)+\\frac{\\pi {r}^{2}}{2}+\\frac{\\pi }{2}{\\left(\\frac{200}{\\pi +2}-r\\right)}^{2}\\,.\\end{aligned}\n$$\n\nWe want to maximize $A,$ so we need to differentiate $A$ and set the derivative equal to zero. The derivative is\n\n$$\n\\begin{aligned}{A}^{′}(r) & =4\\left(\\frac{200}{\\pi +2}-r\\right)+4r(-1)+\\pi r+\\pi \\left(\\frac{200}{\\pi +2}-r\\right)(-1) \\\\  & =\\frac{800}{\\pi +2}-4r-4r+\\pi r-\\frac{200\\pi }{\\pi +2}+\\pi r \\\\  & =-8r+2\\pi r+\\frac{800-200\\pi }{\\pi +2}\\,.\\end{aligned}\n$$\n\nSetting ${A}^{′}(r)=0$ and solving for $r$ gives\n\n$$\n\\begin{aligned}{A}^{′}(r) & =0 \\\\ -8r+2\\pi r+\\frac{800-200\\pi }{\\pi +2} & =0 \\\\ 2r(\\pi -4) & =-\\frac{800-200\\pi }{\\pi +2} \\\\ 2r(\\pi -4) & =\\frac{200\\pi -800}{\\pi +2} \\\\ r & =\\frac{100\\pi -400}{(\\pi +2)(\\pi -4)} \\\\ r & =\\frac{100(\\pi -4)}{(\\pi +2)(\\pi -4)} \\\\ r & =\\frac{100}{\\pi +2}\\,.\\end{aligned}\n$$\n\nNow, we confirm that $r=\\frac{100}{\\pi +2}$ is a maximum using the second derivative test. The second derivative gives\n\n$$\n{A}^{″}(r)=-8+2\\pi \\,⟹\\,{A}^{″}\\left(\\frac{100}{\\pi +2}\\right)=-8+2\\pi <0.\n$$\n\nSince ${A}^{″}\\left(\\frac{100}{\\pi +2}\\right)$ is negative, we conclude that $r=\\frac{100}{\\pi +2}$ is indeed a maximum of $A(r).$\n\nFinally, when $r=\\frac{100}{\\pi +2}$, we have \n\n$$\n\\begin{aligned}x & =\\frac{200}{\\pi +2}-\\frac{100}{\\pi +2} \\\\  & =\\frac{100}{\\pi +2}\\,.\\end{aligned}\n$$\n\nTherefore, the length of the side of the field with the largest area is $2x=\\frac{200}{\\pi +2}.$"] [:db/cas 17592186508985 :question/worked-solution "**Step 1**: We need to find the value of $z$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =5\\cdot 2xz+2\\cdot 2xy+2\\cdot 2yz \\\\  & =10xz+4xy+4yz\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $50\\,{ft}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot z\\cdot y \\\\ 50 & =3{z}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}3{z}^{2}y & =50 \\\\ y & =\\frac{50}{3{z}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =10xz+4xy+4yz \\\\ C & =10(3z)z+4(3z)\\left(\\frac{50}{3{z}^{2}}\\right)+4\\left(\\frac{50}{3{z}^{2}}\\right)z \\\\ C & =30{z}^{2}+\\frac{200}{z}+\\frac{200}{3z} \\\\ C & =30{z}^{2}+\\frac{800}{3z}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(z)=60z-\\frac{800}{3{z}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(z) & =0 \\\\ 60z-\\frac{800}{3{z}^{2}} & =0 \\\\ 180{z}^{3} & =800 \\\\ {z}^{3} & =\\frac{800}{180} \\\\ z & =\\sqrt[3]{\\frac{40}{9}}.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $z=\\sqrt[3]{\\frac{40}{9}}$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(z)=60+\\frac{1\\,600}{{z}^{3}}\\,⟹\\,{C}^{″}(\\sqrt[3]{\\frac{40}{9}})>0.\n$$\n\nSince ${C}^{″}(\\sqrt[3]{\\frac{40}{9}})$ is positive, we conclude that $z=\\sqrt[3]{\\frac{40}{9}}$ is indeed a minimum of $C(z).$" "**Step 1**: We need to find the value of $z$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =5\\cdot 2xz+2\\cdot 2xy+2\\cdot 2yz \\\\  & =10xz+4xy+4yz\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $50\\,{ft}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot z\\cdot y \\\\ 50 & =3{z}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}3{z}^{2}y & =50 \\\\ y & =\\frac{50}{3{z}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =10xz+4xy+4yz \\\\ C & =10(3z)z+4(3z)\\left(\\frac{50}{3{z}^{2}}\\right)+4\\left(\\frac{50}{3{z}^{2}}\\right)z \\\\ C & =30{z}^{2}+\\frac{200}{z}+\\frac{200}{3z} \\\\ C & =30{z}^{2}+\\frac{800}{3z}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(z)=60z-\\frac{800}{3{z}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(z) & =0 \\\\ 60z-\\frac{800}{3{z}^{2}} & =0 \\\\ 180{z}^{3} & =800 \\\\ {z}^{3} & =\\frac{800}{180} \\\\ z & =\\sqrt[3]{\\frac{40}{9}}.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $z=\\sqrt[3]{\\frac{40}{9}}$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(z)=60+\\frac{1\\,600}{{z}^{3}}\\,⟹\\,{C}^{″}\\left(\\sqrt[3]{\\frac{40}{9}}\\right)>0.\n$$\n\nSince ${C}^{″}\\left(\\sqrt[3]{\\frac{40}{9}}\\right)$ is positive, we conclude that $z=\\sqrt[3]{\\frac{40}{9}}$ is indeed a minimum of $C(z).$"] [:db/cas 17592186508994 :question/worked-solution "The initial investment was $\\$11\\,280$, and this decreased by $\\frac{1}{8}$ every month.\n\nIf the investment value is reduced by $\\frac{1}{8},$ then $\\frac{7}{8}$ of its value remained every month. So the decay factor is $\\frac{7}{8}.$\n\nThe formula for exponential decay (in terms of a decay factor $b$) is\n\n$$\np=a{b}^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=11\\,280$ is the initial investment.\n\n- $b=\\frac{7}{8}$ is the decay factor.\n\n- $t=$ the time, in months.\n\nTherefore, the correct expression for $p(t)$ is\n\n$$\np(t)=11\\,280\\cdot {(\\frac{7}{8})}^{t}.\n$$\n\nSo the missing number is $\\frac{7}{8}.$" "The initial investment was $\\$11\\,280$, and this decreased by $\\frac{1}{8}$ every month.\n\nIf the investment value is reduced by $\\frac{1}{8},$ then $\\frac{7}{8}$ of its value remained every month. So the decay factor is $\\frac{7}{8}.$\n\nThe formula for exponential decay (in terms of a decay factor $b$) is\n\n$$\np=a{b}^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=11\\,280$ is the initial investment.\n\n- $b=\\frac{7}{8}$ is the decay factor.\n\n- $t=$ the time, in months.\n\nTherefore, the correct expression for $p(t)$ is\n\n$$\np(t)=11\\,280\\cdot {\\left(\\frac{7}{8}\\right)}^{t}.\n$$\n\nSo the missing number is $\\frac{7}{8}.$"] [:db/cas 17592186508995 :question/problem "If $X∼B(4,\\frac{1}{3}),$  then, **rounded to $3$ decimal places**, $P(1\\le X<3)≈${{field-1}} ." "If $X∼B\\left(4,\\frac{1}{3}\\right),$  then, **rounded to $3$ decimal places**, $P(1\\le X<3)≈${{field-1}} ."] [:db/cas 17592186508995 :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(4,\\frac{1}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{4}{x}){\\left(\\frac{1}{3}\\right)}^{x}{\\left(\\frac{2}{3}\\right)}^{4-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1\\le X<3) & =P(X\\in \\{1,2\\}) \\\\  & =f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{4}{1}){\\left(\\frac{1}{3}\\right)}^{1}{\\left(\\frac{2}{3}\\right)}^{4-1}+(\\genfrac{}{}{0pt}{}{4}{2}){\\left(\\frac{1}{3}\\right)}^{2}{\\left(\\frac{2}{3}\\right)}^{4-2} \\\\  & =4{\\left(\\frac{1}{3}\\right)}^{1}{\\left(\\frac{2}{3}\\right)}^{3}+6{\\left(\\frac{1}{3}\\right)}^{2}{\\left(\\frac{2}{3}\\right)}^{2} \\\\  & ≈0.691\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places." "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B\\left(4,\\frac{1}{3}\\right),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{4}{x}){\\left(\\frac{1}{3}\\right)}^{x}{\\left(\\frac{2}{3}\\right)}^{4-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1\\le X<3) & =P(X\\in \\{1,2\\}) \\\\  & =f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{4}{1}){\\left(\\frac{1}{3}\\right)}^{1}{\\left(\\frac{2}{3}\\right)}^{4-1}+(\\genfrac{}{}{0pt}{}{4}{2}){\\left(\\frac{1}{3}\\right)}^{2}{\\left(\\frac{2}{3}\\right)}^{4-2} \\\\  & =4{\\left(\\frac{1}{3}\\right)}^{1}{\\left(\\frac{2}{3}\\right)}^{3}+6{\\left(\\frac{1}{3}\\right)}^{2}{\\left(\\frac{2}{3}\\right)}^{2} \\\\  & ≈0.691\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places."] [:db/cas 17592186509051 :answer/value "(- \\frac{1077}{16}, \\frac{123}{8})" "\\left(- \\frac{1077}{16}, \\frac{123}{8}\\right)"] [:db/cas 17592186509062 :answer/value "(- \\frac{1257}{41}, \\frac{201}{41})" "\\left(- \\frac{1257}{41}, \\frac{201}{41}\\right)"] [:db/cas 17592186509063 :answer/value "(\\frac{5}{4}, - \\frac{3}{4})" "\\left(\\frac{5}{4}, - \\frac{3}{4}\\right)"] [:db/cas 17592186509065 :answer/value "(\\frac{11}{14}, \\frac{10}{7})" "\\left(\\frac{11}{14}, \\frac{10}{7}\\right)"] [:db/cas 17592186509069 :answer/value "(- \\frac{29}{5}, \\frac{8}{5})" "\\left(-