 }{4},\\frac{\\sqrt{2}}{2})$" "$\\left(\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2}\\right)$"] [:db/cas 17592186471948 :answer-field/key "$(-\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{3})$" "$\\left(-\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186471949 :answer-field/key "$(-\\frac{\\sqrt{2}}{2},\\frac{5\\pi }{4})$" "$\\left(-\\frac{\\sqrt{2}}{2},\\frac{5\\pi }{4}\\right)$"] [:db/cas 17592186471953 :answer-field/key "$(-1,-\\frac{\\pi }{4})$" "$\\left(-1,-\\frac{\\pi }{4}\\right)$"] [:db/cas 17592186471954 :answer-field/key "$(\\sqrt{3},\\frac{\\pi }{3})$" "$\\left(\\sqrt{3},\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186471955 :answer-field/key "$(\\frac{\\pi }{4},1)$" "$\\left(\\frac{\\pi }{4},1\\right)$"] [:db/cas 17592186472095 :answer-field/key "$A={n\\in Z\\,:\\,\\operatorname{cos}⁡(\\frac{n\\pi }{2})=1}$" "$A={n\\in Z\\,:\\,\\operatorname{cos}⁡\\left(\\frac{n\\pi }{2}\\right)=1}$"] [:db/cas 17592186472096 :answer-field/key "$B={q\\in Q\\,:\\,\\operatorname{cos}⁡(\\frac{q\\pi }{2})=1}$" "$B={q\\in Q\\,:\\,\\operatorname{cos}⁡\\left(\\frac{q\\pi }{2}\\right)=1}$"] [:db/cas 17592186472097 :answer-field/key "$C={x\\in R\\,:\\,\\operatorname{cos}⁡(\\frac{x\\pi }{2})=1}$" "$C={x\\in R\\,:\\,\\operatorname{cos}⁡\\left(\\frac{x\\pi }{2}\\right)=1}$"] [:db/cas 17592186473747 :answer-field/key "${\\sum }_{i=1}^{9}{(\\frac{{X}_{i}-\\sigma }{\\mu })}^{2}$" "${\\sum }_{i=1}^{9}{\\left(\\frac{{X}_{i}-\\sigma }{\\mu }\\right)}^{2}$"] [:db/cas 17592186473793 :answer-field/key "$A={n\\in Z\\,:\\,\\operatorname{sin}⁡(\\frac{n\\pi }{2})=0}$" "$A={n\\in Z\\,:\\,\\operatorname{sin}⁡\\left(\\frac{n\\pi }{2}\\right)=0}$"] [:db/cas 17592186473794 :answer-field/key "$B={q\\in Q\\,:\\,\\operatorname{sin}⁡(\\frac{q\\pi }{2})=0}$" "$B={q\\in Q\\,:\\,\\operatorname{sin}⁡\\left(\\frac{q\\pi }{2}\\right)=0}$"] [:db/cas 17592186473795 :answer-field/key "$C={x\\in R\\,:\\,\\operatorname{sin}⁡(\\frac{x\\pi }{2})=0}$" "$C={x\\in R\\,:\\,\\operatorname{sin}⁡\\left(\\frac{x\\pi }{2}\\right)=0}$"] [:db/cas 17592186473801 :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\frac{1}{{x}^{2}})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}\\left(\\frac{1}{{x}^{2}}\\right)\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$"] [:db/cas 17592186474013 :answer-field/key "$(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$" "$\\left(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6}\\right)$"] [:db/cas 17592186474014 :answer-field/key "$(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$" "$\\left(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6}\\right)$"] [:db/cas 17592186474015 :answer-field/key "$(1,\\frac{\\pi }{3})$" "$\\left(1,\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186474019 :answer-field/key "$(\\sqrt{3},\\frac{\\pi }{3})$" "$\\left(\\sqrt{3},\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186474020 :answer-field/key "$(0,\\frac{\\pi }{6})$" "$\\left(0,\\frac{\\pi }{6}\\right)$"] [:db/cas 17592186474021 :answer-field/key "$(-\\sqrt{3},\\frac{2\\pi }{3})$" "$\\left(-\\sqrt{3},\\frac{2\\pi }{3}\\right)$"] [:db/cas 17592186474022 :answer-field/key "$(-\\sqrt{3},-\\frac{\\pi }{3})$" "$\\left(-\\sqrt{3},-\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186474023 :answer-field/key "$(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6})$" "$\\left(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6}\\right)$"] [:db/cas 17592186474024 :answer-field/key "$(-1,\\frac{\\pi }{4})$" "$\\left(-1,\\frac{\\pi }{4}\\right)$"] [:db/cas 17592186475919 :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx\\,dy & ={\\int }_{1}^{2}[{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx]dy \\\\  & ={\\int }_{1}^{2}[y{e}^{x}]_{0}^{\\operatorname{ln}⁡y}\\,dy \\\\  & ={\\int }_{1}^{2}(y{e}^{\\operatorname{ln}⁡y}-y{e}^{0})\\,dy \\\\  & ={\\int }_{1}^{2}({y}^{2}-y)\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}-y)\\,dy & ={[\\frac{1}{3}{y}^{3}-\\frac{1}{2}{y}^{2}]}_{1}^{2} \\\\  & =(\\frac{8}{3}-2)-(\\frac{1}{3}-\\frac{1}{2}) \\\\  & =\\frac{2}{3}+\\frac{1}{6} \\\\  & =\\frac{5}{6}\\end{aligned}\n$$" "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx\\,dy & ={\\int }_{1}^{2}[{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx]dy \\\\  & ={\\int }_{1}^{2}[y{e}^{x}]_{0}^{\\operatorname{ln}⁡y}\\,dy \\\\  & ={\\int }_{1}^{2}(y{e}^{\\operatorname{ln}⁡y}-y{e}^{0})\\,dy \\\\  & ={\\int }_{1}^{2}({y}^{2}-y)\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}-y)\\,dy & ={\\left[\\frac{1}{3}{y}^{3}-\\frac{1}{2}{y}^{2}\\right]}_{1}^{2} \\\\  & =\\left(\\frac{8}{3}-2\\right)-\\left(\\frac{1}{3}-\\frac{1}{2}\\right) \\\\  & =\\frac{2}{3}+\\frac{1}{6} \\\\  & =\\frac{5}{6}\\end{aligned}\n$$"] [:db/cas 17592186475934 :question/problem "Consider the surface $z\\operatorname{cos}⁡(x+y)-xyz=2+\\frac{{\\pi }^{2}}{2}.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(\\frac{\\pi }{2},-\\frac{\\pi }{2},2),$ what is the value of $\\frac{a}{b}?$" "Consider the surface $z\\operatorname{cos}⁡(x+y)-xyz=2+\\frac{{\\pi }^{2}}{2}.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $\\left(\\frac{\\pi }{2},-\\frac{\\pi }{2},2\\right),$ what is the value of $\\frac{a}{b}?$"] [:db/cas 17592186475934 :question/worked-solution "Let's define  $f(x,y,z)=z\\operatorname{cos}⁡(x+y)-xyz.$ Then, our surface can be viewed as the level surface $f(x,y,z)=2+\\frac{{\\pi }^{2}}{2}.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(\\frac{\\pi }{2},-\\frac{\\pi }{2},2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(z\\operatorname{cos}⁡(x+y)-xyz)i+\\frac{∂}{∂y}(z\\operatorname{cos}⁡(x+y)-xyz)j+\\frac{∂}{∂z}(z\\operatorname{cos}⁡(x+y)-xyz)k \\\\  & =(-z\\operatorname{sin}⁡(x+y)-yz)i+(-z\\operatorname{sin}⁡(x+y)-xz)j+(\\operatorname{cos}⁡(x+y)-xy)k \\\\ ∇f(\\frac{\\pi }{2},-\\frac{\\pi }{2},2) & =(-2\\operatorname{sin}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-2\\left(-\\frac{\\pi }{2}\\right))\\text{ }i+(-2\\operatorname{sin}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-2\\left(\\frac{\\pi }{2}\\right))\\text{ }j+(\\operatorname{cos}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-\\left(\\frac{\\pi }{2}\\right)\\left(-\\frac{\\pi }{2}\\right))\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+(1+\\frac{{\\pi }^{2}}{4})\\text{ }k \\\\  & =⟨\\pi ,\\,-\\pi ,\\,1+\\frac{{\\pi }^{2}}{4}⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨\\pi ,\\,-\\pi ,\\,\\frac{{\\pi }^{2}+4}{4}⟩.$\n\nFinally, $\\frac{a}{b}=\\frac{\\pi }{-\\pi }=-1.$" "Let's define  $f(x,y,z)=z\\operatorname{cos}⁡(x+y)-xyz.$ Then, our surface can be viewed as the level surface $f(x,y,z)=2+\\frac{{\\pi }^{2}}{2}.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $\\left(\\frac{\\pi }{2},-\\frac{\\pi }{2},2\\right):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(z\\operatorname{cos}⁡(x+y)-xyz)i+\\frac{∂}{∂y}(z\\operatorname{cos}⁡(x+y)-xyz)j+\\frac{∂}{∂z}(z\\operatorname{cos}⁡(x+y)-xyz)k \\\\  & =(-z\\operatorname{sin}⁡(x+y)-yz)i+(-z\\operatorname{sin}⁡(x+y)-xz)j+(\\operatorname{cos}⁡(x+y)-xy)k \\\\ ∇f\\left(\\frac{\\pi }{2},-\\frac{\\pi }{2},2\\right) & =\\left(-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}-\\frac{\\pi }{2}\\right)-2\\left(-\\frac{\\pi }{2}\\right)\\right)\\text{ }i+\\left(-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}-\\frac{\\pi }{2}\\right)-2\\left(\\frac{\\pi }{2}\\right)\\right)\\text{ }j+\\left(\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}-\\frac{\\pi }{2}\\right)-\\left(\\frac{\\pi }{2}\\right)\\left(-\\frac{\\pi }{2}\\right)\\right)\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+\\left(1+\\frac{{\\pi }^{2}}{4}\\right)\\text{ }k \\\\  & =\\left\\langle \\pi ,\\,-\\pi ,\\,1+\\frac{{\\pi }^{2}}{4}\\right\\rangle \\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=\\left\\langle \\pi ,\\,-\\pi ,\\,\\frac{{\\pi }^{2}+4}{4}\\right\\rangle .$\n\nFinally, $\\frac{a}{b}=\\frac{\\pi }{-\\pi }=-1.$"] [:db/cas 17592186475984 :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $y$-component of $F=⟨0,\\,xy-z,\\,0⟩$ is non-zero. Since the lateral sides of $S$ are parallel to the $y$-axis, the flux of $F$ through $S$ will be non-zero only at the right and left sides. \n\n![](images/de/de9eb8381df05d2d5e6222a51b0ccbc5729e522df94a4aace570881d1226a1ca.png)\n\n \n\nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the right surface. On this surface, we have $y=1$ for $0\\le x\\le 1$ and $0\\le z\\le 2.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,1,\\,0⟩.\n$$\n\nUsing the fact that $y=1$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨0,\\,xy-z,\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =⟨0,\\,x-z,\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =x-z.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{1}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}x-z\\,\\text{d}S \\\\  & ={∬}_{D}x-z\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}x-z\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}-xz]}_{x=0}^{x=1}\\,\\text{d}z \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}-z\\,\\text{d}z \\\\  & ={[\\frac{1}{2}z-\\frac{1}{2}{z}^{2}]}_{0}^{2} \\\\  & =1-2 \\\\  & =-1\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the left surface. On this surface, we have $y=0$ for $0\\le x\\le 1$ and $0\\le z\\le 2.$ The outward-pointing unit normal vector to ${S}_{2}$ is\n\n$$\n{n}_{2}=⟨0,\\,-1,\\,0⟩.\n$$\n\nUsing the fact that $y=0$ on ${S}_{2},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{2} & =⟨0,\\,xy-z,\\,0⟩\\cdot ⟨0,\\,-1,\\,0⟩ \\\\  & =⟨0,\\,-z,\\,0⟩\\cdot ⟨0,\\,-1,\\,0⟩ \\\\  & =z.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{2}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & ={∬}_{{S}_{2}}F\\cdot {n}_{2}\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}z\\,\\text{d}S \\\\  & ={∬}_{D}z\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}z\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}\\,\\text{d}x{\\int }_{0}^{2}z\\,\\text{d}z \\\\  & =[x]_{0}^{1}\\cdot {[\\frac{{z}^{2}}{2}]}_{0}^{2} \\\\  & =1\\cdot 2 \\\\  & =2\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =(-1)+2 \\\\  & =1.\\end{aligned}\n$$" "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $y$-component of $F=⟨0,\\,xy-z,\\,0⟩$ is non-zero. Since the lateral sides of $S$ are parallel to the $y$-axis, the flux of $F$ through $S$ will be non-zero only at the right and left sides. \n\n![](images/de/de9eb8381df05d2d5e6222a51b0ccbc5729e522df94a4aace570881d1226a1ca.png)\n\n \n\nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the right surface. On this surface, we have $y=1$ for $0\\le x\\le 1$ and $0\\le z\\le 2.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,1,\\,0⟩.\n$$\n\nUsing the fact that $y=1$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨0,\\,xy-z,\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =⟨0,\\,x-z,\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =x-z.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{1}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}x-z\\,\\text{d}S \\\\  & ={∬}_{D}x-z\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}x-z\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{2}{\\left[\\frac{1}{2}{x}^{2}-xz\\right]}_{x=0}^{x=1}\\,\\text{d}z \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}-z\\,\\text{d}z \\\\  & ={\\left[\\frac{1}{2}z-\\frac{1}{2}{z}^{2}\\right]}_{0}^{2} \\\\  & =1-2 \\\\  & =-1\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the left surface. On this surface, we have $y=0$ for $0\\le x\\le 1$ and $0\\le z\\le 2.$ The outward-pointing unit normal vector to ${S}_{2}$ is\n\n$$\n{n}_{2}=⟨0,\\,-1,\\,0⟩.\n$$\n\nUsing the fact that $y=0$ on ${S}_{2},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{2} & =⟨0,\\,xy-z,\\,0⟩\\cdot ⟨0,\\,-1,\\,0⟩ \\\\  & =⟨0,\\,-z,\\,0⟩\\cdot ⟨0,\\,-1,\\,0⟩ \\\\  & =z.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{2}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & ={∬}_{{S}_{2}}F\\cdot {n}_{2}\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}z\\,\\text{d}S \\\\  & ={∬}_{D}z\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}z\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}\\,\\text{d}x{\\int }_{0}^{2}z\\,\\text{d}z \\\\  & =[x]_{0}^{1}\\cdot {\\left[\\frac{{z}^{2}}{2}\\right]}_{0}^{2} \\\\  & =1\\cdot 2 \\\\  & =2\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =(-1)+2 \\\\  & =1.\\end{aligned}\n$$"] [:db/cas 17592186476528 :answer/value "{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)-\\operatorname{cos}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right." "{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}\\left(\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{cos}⁡y\\right), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right."] [:db/cas 17592186476555 :answer/value "{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}(\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)-\\operatorname{cos}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right." "{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{cos}⁡y\\right), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right."] [:db/cas 17592186476727 :answer/value "{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right." "{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡y\\right), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right."] [:db/cas 17592186476875 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}2y\\,\\text{d}y \\\\  & =2{[\\frac{1}{2}{y}^{2}]}_{0}^{1} \\\\  & =[{y}^{2}]_{0}^{1} \\\\  & =({1}^{2}-0) \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{x}1\\,\\text{d}u \\\\  & =[u]_{0}^{x} \\\\  & =x-0 \\\\  & =x.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}0, & x<0 \\\\ x, & 0\\le x\\le 1 \\\\ 1 & x>1.\\end{aligned}\\right.\n$$\n\nFinally, $g(x)=x.$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}2y\\,\\text{d}y \\\\  & =2{\\left[\\frac{1}{2}{y}^{2}\\right]}_{0}^{1} \\\\  & =[{y}^{2}]_{0}^{1} \\\\  & =({1}^{2}-0) \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{x}1\\,\\text{d}u \\\\  & =[u]_{0}^{x} \\\\  & =x-0 \\\\  & =x.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}0, & x<0 \\\\ x, & 0\\le x\\le 1 \\\\ 1 & x>1.\\end{aligned}\\right.\n$$\n\nFinally, $g(x)=x.$"] [:db/cas 17592186476879 :question/worked-solution "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y=1\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x-{x}^{2}\\le y\\le x\\le 1\\}.$\n\n![](images/c7/c7e555ed139343a1a83e0b05bdb9a13be502271b76e9b9bbdf7ed5f3e869fcd0.png)\n\nNow, let's check our conditions:\n\n- Since $c>0,$ we clearly have $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}.$ So the first condition is satisfied.\n\n- For the second condition to be satisfied, we must have \n\n$$\n{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y={\\int }_{0}^{1}{\\int }_{x-{x}^{2}}^{x}c\\sqrt{x-y}\\,\\text{d}y\\,\\text{d}x=1.\n$$\n\nWe evaluate the inner integral by integrating with respect to $y$, treating  $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{x-{x}^{2}}^{x}c\\sqrt{x-y}\\,dy\\,dx & ={\\int }_{0}^{1}c[{\\int }_{x-{x}^{2}}^{x}c\\sqrt{x-y}\\,dy]dx \\\\  & ={\\int }_{0}^{1}c{[-\\frac{2}{3}(x-y)^{3/2}]}_{y=x-{x}^{2}}^{y=x}dx \\\\  & ={\\int }_{0}^{1}c(-0+\\frac{2}{3}(x-x+{x}^{2})^{3/2})dx \\\\  & ={\\int }_{0}^{1}\\frac{2c{x}^{3}}{3}dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x$:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2c{x}^{3}}{3}dx & ={[\\frac{c{x}^{4}}{6}]}_{0}^{1} \\\\  & =\\frac{c}{6}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{c}{6}=1\\,⇒\\,c=6.\n$$" "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y=1\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x-{x}^{2}\\le y\\le x\\le 1\\}.$\n\n![](images/c7/c7e555ed139343a1a83e0b05bdb9a13be502271b76e9b9bbdf7ed5f3e869fcd0.png)\n\nNow, let's check our conditions:\n\n- Since $c>0,$ we clearly have $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}.$ So the first condition is satisfied.\n\n- For the second condition to be satisfied, we must have \n\n$$\n{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y={\\int }_{0}^{1}{\\int }_{x-{x}^{2}}^{x}c\\sqrt{x-y}\\,\\text{d}y\\,\\text{d}x=1.\n$$\n\nWe evaluate the inner integral by integrating with respect to $y$, treating  $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{x-{x}^{2}}^{x}c\\sqrt{x-y}\\,dy\\,dx & ={\\int }_{0}^{1}c[{\\int }_{x-{x}^{2}}^{x}c\\sqrt{x-y}\\,dy]dx \\\\  & ={\\int }_{0}^{1}c{\\left[-\\frac{2}{3}(x-y)^{3/2}\\right]}_{y=x-{x}^{2}}^{y=x}dx \\\\  & ={\\int }_{0}^{1}c\\left(-0+\\frac{2}{3}(x-x+{x}^{2})^{3/2}\\right)dx \\\\  & ={\\int }_{0}^{1}\\frac{2c{x}^{3}}{3}dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x$:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2c{x}^{3}}{3}dx & ={\\left[\\frac{c{x}^{4}}{6}\\right]}_{0}^{1} \\\\  & =\\frac{c}{6}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{c}{6}=1\\,⇒\\,c=6.\n$$"] [:db/cas 17592186476882 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=xy.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}xy\\cdot (x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}({x}^{2}y+x{y}^{2})\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{y{x}^{3}}{3}+\\frac{{x}^{2}{y}^{2}}{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{y}{3}+\\frac{{y}^{2}}{2})\\,\\text{d}y \\\\  & =[\\frac{{y}^{2}}{6}+\\frac{{y}^{3}}{6}]_{0}^{1} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=xy.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}xy\\cdot (x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}({x}^{2}y+x{y}^{2})\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\left[\\frac{y{x}^{3}}{3}+\\frac{{x}^{2}{y}^{2}}{2}\\right]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\left(\\frac{y}{3}+\\frac{{y}^{2}}{2}\\right)\\,\\text{d}y \\\\  & =\\left[\\frac{{y}^{2}}{6}+\\frac{{y}^{3}}{6}\\right]_{0}^{1} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"] [:db/cas 17592186476884 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{\\infty }\\frac{4}{(x+y)^{3}}\\,\\text{d}y \\\\  & =\\lim_{b\\to \\infty }{\\int }_{1}^{b}\\frac{4}{(x+y)^{3}}\\,\\text{d}y \\\\  & =4\\lim_{b\\to \\infty }{\\int }_{1}^{b}(x+y)^{-3}\\,\\text{d}y \\\\  & =4\\lim_{b\\to \\infty }{[-\\frac{1}{2}(x+y)^{-2}]}_{y=1}^{y=b} \\\\  & =-2\\lim_{b\\to \\infty }{[\\frac{1}{(x+y)^{2}}]}_{y=1}^{y=b} \\\\  & =-2\\lim_{b\\to \\infty }[\\frac{1}{(x+b)^{2}}-\\frac{1}{(x+1)^{2}}] \\\\  & =\\frac{2}{(x+1)^{2}}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{1}^{x}\\frac{2}{(u+1)^{2}}\\,\\text{d}u \\\\  & =2{\\int }_{1}^{x}\\frac{1}{(u+1)^{2}}\\,\\text{d}u \\\\  & =2{[-\\frac{1}{u+1}]}_{1}^{x} \\\\  & =2[\\frac{1}{2}-\\frac{1}{x+1}] \\\\  & =1-\\frac{2}{x+1} \\\\  & =\\frac{x-1}{x+1},\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}0, & x<1 \\\\ \\frac{x-1}{x+1}, & x\\ge 1.\\end{aligned}\\right.\n$$\n\nFinally, $g(x)=\\frac{x-1}{x+1}.$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{\\infty }\\frac{4}{(x+y)^{3}}\\,\\text{d}y \\\\  & =\\lim_{b\\to \\infty }{\\int }_{1}^{b}\\frac{4}{(x+y)^{3}}\\,\\text{d}y \\\\  & =4\\lim_{b\\to \\infty }{\\int }_{1}^{b}(x+y)^{-3}\\,\\text{d}y \\\\  & =4\\lim_{b\\to \\infty }{\\left[-\\frac{1}{2}(x+y)^{-2}\\right]}_{y=1}^{y=b} \\\\  & =-2\\lim_{b\\to \\infty }{\\left[\\frac{1}{(x+y)^{2}}\\right]}_{y=1}^{y=b} \\\\  & =-2\\lim_{b\\to \\infty }\\left[\\frac{1}{(x+b)^{2}}-\\frac{1}{(x+1)^{2}}\\right] \\\\  & =\\frac{2}{(x+1)^{2}}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{1}^{x}\\frac{2}{(u+1)^{2}}\\,\\text{d}u \\\\  & =2{\\int }_{1}^{x}\\frac{1}{(u+1)^{2}}\\,\\text{d}u \\\\  & =2{\\left[-\\frac{1}{u+1}\\right]}_{1}^{x} \\\\  & =2\\left[\\frac{1}{2}-\\frac{1}{x+1}\\right] \\\\  & =1-\\frac{2}{x+1} \\\\  & =\\frac{x-1}{x+1},\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}0, & x<1 \\\\ \\frac{x-1}{x+1}, & x\\ge 1.\\end{aligned}\\right.\n$$\n\nFinally, $g(x)=\\frac{x-1}{x+1}.$"] [:db/cas 17592186476885 :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}{e}^{-(\\frac{x}{2}+2y)}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind $P(Y>2).$" "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}{e}^{-\\left(\\frac{x}{2}+2y\\right)}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind $P(Y>2).$"] [:db/cas 17592186476885 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $y\\ge 0$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\infty }{e}^{-(\\frac{x}{2}+2y)}\\,\\text{d}x \\\\  & ={[-2{e}^{-(\\frac{x}{2}+2y)}]}_{x=0}^{x=\\infty } \\\\  & =-2(0-{e}^{-(0+2y)}) \\\\  & =2{e}^{-2y}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}2{e}^{-2y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(Y>2) & ={\\int }_{2}^{\\infty }{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{2}^{\\infty }2{e}^{-2y}\\,\\text{d}y \\\\  & ={[-{e}^{-2y}]}_{2}^{\\infty } \\\\  & =(0+{e}^{-4}) \\\\  & =\\frac{1}{{e}^{4}}.\\end{aligned}\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $y\\ge 0$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\infty }{e}^{-\\left(\\frac{x}{2}+2y\\right)}\\,\\text{d}x \\\\  & ={[-2{e}^{-\\left(\\frac{x}{2}+2y\\right)}]}_{x=0}^{x=\\infty } \\\\  & =-2(0-{e}^{-(0+2y)}) \\\\  & =2{e}^{-2y}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}2{e}^{-2y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(Y>2) & ={\\int }_{2}^{\\infty }{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{2}^{\\infty }2{e}^{-2y}\\,\\text{d}y \\\\  & ={[-{e}^{-2y}]}_{2}^{\\infty } \\\\  & =(0+{e}^{-4}) \\\\  & =\\frac{1}{{e}^{4}}.\\end{aligned}\n$$"] [:db/cas 17592186476891 :question/problem "If $X∼B(5,\\frac{3}{4}),$  then, **rounded to $3$ decimal places**, $P(X\\ge 2)≈${{field-1}}." "If $X∼B\\left(5,\\frac{3}{4}\\right),$  then, **rounded to $3$ decimal places**, $P(X\\ge 2)≈${{field-1}}."] [:db/cas 17592186476891 :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{3}{4}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){\\left(\\frac{3}{4}\\right)}^{x}{\\left(\\frac{1}{4}\\right)}^{5-x}.\n$$\n\nComputing $P(X\\ge 2)$ will require us to compute $f(x)$ at $x=2,3,4,5.$ However, if we compute the complement $P(X<2)$ instead, then we will only have to compute $f(x)$ at $x=0,1,$ which will result in a much faster computation.\n\nComputing $P(X<2),$ we get\n\n$$\n\\begin{aligned}P(X<2) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){\\left(\\frac{3}{4}\\right)}^{0}{\\left(\\frac{1}{4}\\right)}^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1}){\\left(\\frac{3}{4}\\right)}^{1}{\\left(\\frac{1}{4}\\right)}^{5-1} \\\\  & =1{\\left(\\frac{3}{4}\\right)}^{0}{\\left(\\frac{1}{4}\\right)}^{5}+5{\\left(\\frac{3}{4}\\right)}^{1}{\\left(\\frac{1}{4}\\right)}^{4} \\\\  & ≈0.016\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =1-P(X<2) \\\\  & ≈1-0.016 \\\\  & =0.984\\end{aligned}\n$$\n\nrounded to $3$ decimal places." "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B\\left(5,\\frac{3}{4}\\right),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){\\left(\\frac{3}{4}\\right)}^{x}{\\left(\\frac{1}{4}\\right)}^{5-x}.\n$$\n\nComputing $P(X\\ge 2)$ will require us to compute $f(x)$ at $x=2,3,4,5.$ However, if we compute the complement $P(X<2)$ instead, then we will only have to compute $f(x)$ at $x=0,1,$ which will result in a much faster computation.\n\nComputing $P(X<2),$ we get\n\n$$\n\\begin{aligned}P(X<2) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){\\left(\\frac{3}{4}\\right)}^{0}{\\left(\\frac{1}{4}\\right)}^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1}){\\left(\\frac{3}{4}\\right)}^{1}{\\left(\\frac{1}{4}\\right)}^{5-1} \\\\  & =1{\\left(\\frac{3}{4}\\right)}^{0}{\\left(\\frac{1}{4}\\right)}^{5}+5{\\left(\\frac{3}{4}\\right)}^{1}{\\left(\\frac{1}{4}\\right)}^{4} \\\\  & ≈0.016\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =1-P(X<2) \\\\  & ≈1-0.016 \\\\  & =0.984\\end{aligned}\n$$\n\nrounded to $3$ decimal places."] [:db/cas 17592186476893 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)={x}^{2}{y}^{2}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,-1\\le y\\le 0\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}{Y}^{2}] & ={∬}_{{R}^{2}}{x}^{2}{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}{x}^{2}{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{2}{x}^{2}{y}^{2}\\cdot (y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}({y}^{3}+{y}^{2}){\\int }_{0}^{2}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}({y}^{3}+{y}^{2}){[\\frac{{x}^{3}}{3}]}_{0}^{2}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}\\frac{8}{3}({y}^{3}+{y}^{2})\\,\\text{d}y \\\\  & =\\frac{8}{3}[\\frac{{y}^{4}}{4}+\\frac{{y}^{3}}{3}]_{-1}^{0} \\\\  & =\\frac{8}{3}(\\frac{1}{3}-\\frac{1}{4}) \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)={x}^{2}{y}^{2}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,-1\\le y\\le 0\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}{Y}^{2}] & ={∬}_{{R}^{2}}{x}^{2}{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}{x}^{2}{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{2}{x}^{2}{y}^{2}\\cdot (y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}({y}^{3}+{y}^{2}){\\int }_{0}^{2}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}({y}^{3}+{y}^{2}){\\left[\\frac{{x}^{3}}{3}\\right]}_{0}^{2}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}\\frac{8}{3}({y}^{3}+{y}^{2})\\,\\text{d}y \\\\  & =\\frac{8}{3}\\left[\\frac{{y}^{4}}{4}+\\frac{{y}^{3}}{3}\\right]_{-1}^{0} \\\\  & =\\frac{8}{3}\\left(\\frac{1}{3}-\\frac{1}{4}\\right) \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"] [:db/cas 17592186476909 :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\operatorname{cos}⁡(x+y), & 0\\le x\\le \\frac{\\pi }{4},\\,0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind $$\n\\displaystyle P(-\\frac{\\pi }{6}<Y\\le \\frac{\\pi }{12}).\n$$" "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\operatorname{cos}⁡(x+y), & 0\\le x\\le \\frac{\\pi }{4},\\,0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind $$\n\\displaystyle P\\left(-\\frac{\\pi }{6}<Y\\le \\frac{\\pi }{12}\\right).\n$$"] [:db/cas 17592186476909 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le \\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /4}\\frac{1}{\\sqrt{2}-1}\\operatorname{cos}⁡(x+y)\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}-1}[\\operatorname{sin}⁡(x+y)]_{x=0}^{x=\\pi /4} \\\\  & =\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡(0+y)) \\\\  & =\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y).\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(-\\frac{\\pi }{6}<Y\\le \\frac{\\pi }{12}) & ={\\int }_{-\\pi /6}^{\\pi /12}{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /12}\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y)\\text{d}y \\\\  & =\\frac{1}{\\sqrt{2}-1}{[-\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)+\\operatorname{cos}⁡y]}_{0}^{\\pi /12} \\\\  & =\\frac{1}{\\sqrt{2}-1}[(-\\operatorname{cos}⁡(\\frac{\\pi }{4}+\\frac{\\pi }{12})+\\operatorname{cos}⁡\\frac{\\pi }{12})-(-\\operatorname{cos}⁡(\\frac{\\pi }{4}+0)+\\operatorname{cos}⁡0)] \\\\  & =\\frac{1}{\\sqrt{2}-1}(-\\frac{1}{2}+\\frac{1+\\sqrt{3}}{2\\sqrt{2}}+\\frac{\\sqrt{2}}{2}-1) \\\\  & ≈0.4177.\\end{aligned}\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le \\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /4}\\frac{1}{\\sqrt{2}-1}\\operatorname{cos}⁡(x+y)\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}-1}[\\operatorname{sin}⁡(x+y)]_{x=0}^{x=\\pi /4} \\\\  & =\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡(0+y)\\right) \\\\  & =\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡y\\right).\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡y\\right), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P\\left(-\\frac{\\pi }{6}<Y\\le \\frac{\\pi }{12}\\right) & ={\\int }_{-\\pi /6}^{\\pi /12}{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /12}\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡y\\right)\\text{d}y \\\\  & =\\frac{1}{\\sqrt{2}-1}{\\left[-\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}+y\\right)+\\operatorname{cos}⁡y\\right]}_{0}^{\\pi /12} \\\\  & =\\frac{1}{\\sqrt{2}-1}\\left[\\left(-\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}+\\frac{\\pi }{12}\\right)+\\operatorname{cos}⁡\\frac{\\pi }{12}\\right)-\\left(-\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}+0\\right)+\\operatorname{cos}⁡0\\right)\\right] \\\\  & =\\frac{1}{\\sqrt{2}-1}\\left(-\\frac{1}{2}+\\frac{1+\\sqrt{3}}{2\\sqrt{2}}+\\frac{\\sqrt{2}}{2}-1\\right) \\\\  & ≈0.4177.\\end{aligned}\n$$"] [:db/cas 17592186476911 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{x{y}^{2}}{4}\\,\\text{d}x \\\\  & =\\frac{{y}^{2}}{4}{\\int }_{1}^{2}x\\,\\text{d}x \\\\  & =\\frac{{y}^{2}}{4}{[\\frac{{x}^{2}}{2}]}_{x=1}^{x=2} \\\\  & =\\frac{{y}^{2}}{4}[2-\\frac{1}{2}] \\\\  & =\\frac{3{y}^{2}}{8}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{3{y}^{2}}{8}, & \\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{x{y}^{2}}{4}\\,\\text{d}x \\\\  & =\\frac{{y}^{2}}{4}{\\int }_{1}^{2}x\\,\\text{d}x \\\\  & =\\frac{{y}^{2}}{4}{\\left[\\frac{{x}^{2}}{2}\\right]}_{x=1}^{x=2} \\\\  & =\\frac{{y}^{2}}{4}\\left[2-\\frac{1}{2}\\right] \\\\  & =\\frac{3{y}^{2}}{8}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{3{y}^{2}}{8}, & \\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\right.\n$$"] [:db/cas 17592186476913 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le \\frac{\\pi }{4}$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /4}\\frac{1}{\\sqrt{2}-1}\\operatorname{cos}⁡(x+y)\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}-1}[\\operatorname{sin}⁡(x+y)]_{x=0}^{x=\\pi /4} \\\\  & =\\frac{1}{\\sqrt{2}-1}[\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡(0+y)] \\\\  & =\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y).\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le \\frac{\\pi }{4}$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /4}\\frac{1}{\\sqrt{2}-1}\\operatorname{cos}⁡(x+y)\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}-1}[\\operatorname{sin}⁡(x+y)]_{x=0}^{x=\\pi /4} \\\\  & =\\frac{1}{\\sqrt{2}-1}\\left[\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡(0+y)\\right] \\\\  & =\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡y\\right).\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}+y\\right)-\\operatorname{sin}⁡y\\right), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186476914 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{9}\\frac{y\\sqrt{x}}{9}\\,\\text{d}x \\\\  & =\\frac{y}{9}{\\int }_{0}^{9}\\sqrt{x}\\,\\text{d}x \\\\  & =\\frac{y}{9}{[\\frac{2}{3}{x}^{3/2}]}_{x=0}^{x=9} \\\\  & =\\frac{2y}{27}{[{x}^{3/2}]}_{x=0}^{x=9} \\\\  & =\\frac{2y}{27}({9}^{3/2}-{0}^{3/2}) \\\\  & =\\frac{2y}{27}(27-0) \\\\  & =2y.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{F}_{Y}(y) & ={\\int }_{-\\infty }^{y}{f}_{Y}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{y}2u\\,\\text{d}u \\\\  & ={[{u}^{2}]}_{0}^{y} \\\\  & ={y}^{2}-0 \\\\  & ={y}^{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{Y}(y)$ is\n\n$$\n{F}_{Y}(y)=\\left\\{\\begin{aligned}0, & y<0 \\\\ {y}^{2}, & 0\\le y\\le 1 \\\\ 1 & y>1.\\end{aligned}\\right.\n$$\n\nFinally, $g(y)={y}^{2}.$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{9}\\frac{y\\sqrt{x}}{9}\\,\\text{d}x \\\\  & =\\frac{y}{9}{\\int }_{0}^{9}\\sqrt{x}\\,\\text{d}x \\\\  & =\\frac{y}{9}{\\left[\\frac{2}{3}{x}^{3/2}\\right]}_{x=0}^{x=9} \\\\  & =\\frac{2y}{27}{[{x}^{3/2}]}_{x=0}^{x=9} \\\\  & =\\frac{2y}{27}({9}^{3/2}-{0}^{3/2}) \\\\  & =\\frac{2y}{27}(27-0) \\\\  & =2y.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{F}_{Y}(y) & ={\\int }_{-\\infty }^{y}{f}_{Y}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{y}2u\\,\\text{d}u \\\\  & ={[{u}^{2}]}_{0}^{y} \\\\  & ={y}^{2}-0 \\\\  & ={y}^{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{Y}(y)$ is\n\n$$\n{F}_{Y}(y)=\\left\\{\\begin{aligned}0, & y<0 \\\\ {y}^{2}, & 0\\le y\\le 1 \\\\ 1 & y>1.\\end{aligned}\\right.\n$$\n\nFinally, $g(y)={y}^{2}.$"] [:db/cas 17592186476927 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=x{y}^{2}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x,\\,0\\le y,\\,{x}^{2}+{y}^{2}\\le 1\\},$ where $f(x,y)$ is nonzero.\n\n![](images/df/dfa15482cfa0e8fdc9e98b05a71d2b64a89b3886da44f6966fee9f1b5e096eef.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X{Y}^{2}] & ={∬}_{{R}^{2}}x{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}x{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}x{y}^{2}\\cdot 8xy\\,\\text{d}y\\,\\text{d}x \\\\  & =8{\\int }_{0}^{1}{x}^{2}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{y}^{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =8{\\int }_{0}^{1}{x}^{2}{[\\frac{1}{4}{y}^{4}]}_{y=0}^{y=\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}{x}^{2}{(1-{x}^{2})}^{2}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}({x}^{2}-2{x}^{4}+{x}^{6})\\,\\text{d}x \\\\  & =2{[\\frac{1}{3}{x}^{3}-\\frac{2}{5}{x}^{5}+\\frac{1}{7}{x}^{7}]}_{x=0}^{x=1} \\\\  & =2[\\frac{1}{3}-\\frac{2}{5}+\\frac{1}{7}] \\\\  & =\\frac{16}{105}.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=x{y}^{2}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x,\\,0\\le y,\\,{x}^{2}+{y}^{2}\\le 1\\},$ where $f(x,y)$ is nonzero.\n\n![](images/df/dfa15482cfa0e8fdc9e98b05a71d2b64a89b3886da44f6966fee9f1b5e096eef.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X{Y}^{2}] & ={∬}_{{R}^{2}}x{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}x{y}^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}x{y}^{2}\\cdot 8xy\\,\\text{d}y\\,\\text{d}x \\\\  & =8{\\int }_{0}^{1}{x}^{2}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{y}^{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =8{\\int }_{0}^{1}{x}^{2}{\\left[\\frac{1}{4}{y}^{4}\\right]}_{y=0}^{y=\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}{x}^{2}{(1-{x}^{2})}^{2}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}({x}^{2}-2{x}^{4}+{x}^{6})\\,\\text{d}x \\\\  & =2{\\left[\\frac{1}{3}{x}^{3}-\\frac{2}{5}{x}^{5}+\\frac{1}{7}{x}^{7}\\right]}_{x=0}^{x=1} \\\\  & =2\\left[\\frac{1}{3}-\\frac{2}{5}+\\frac{1}{7}\\right] \\\\  & =\\frac{16}{105}.\\end{aligned}\n$$"] [:db/cas 17592186476931 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}(x+y)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}{x}^{2}+xy]}_{x=0}^{x=1} \\\\  & =[(\\frac{1}{2}\\cdot {1}^{2}+1\\cdot y)-(\\frac{1}{2}\\cdot {0}^{2}+0\\cdot y)] \\\\  & =y+\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}y+\\frac{1}{2}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}(x+y)\\,\\text{d}x \\\\  & ={\\left[\\frac{1}{2}{x}^{2}+xy\\right]}_{x=0}^{x=1} \\\\  & =\\left[\\left(\\frac{1}{2}\\cdot {1}^{2}+1\\cdot y\\right)-\\left(\\frac{1}{2}\\cdot {0}^{2}+0\\cdot y\\right)\\right] \\\\  & =y+\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}y+\\frac{1}{2}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186476933 :question/worked-solution "Here,   $4{x}^{2}$ and $-\\frac{5{x}^{2}}{2}$ are like terms, and the $-\\frac{5x}{3}$ and $3x$ are also like terms. So, we group and add each pair of  like terms separately:\n\n$$\n\\begin{aligned}-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x &= (4{x}^{2}-\\frac{5{x}^{2}}{2})+(3x-\\frac{5x}{3}) \\\\ &= (4-\\frac{5}{2}){x}^{2}+(3-\\frac{5}{3})x \\\\ &= \\frac{3}{2}{x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$" "Here,   $4{x}^{2}$ and $-\\frac{5{x}^{2}}{2}$ are like terms, and the $-\\frac{5x}{3}$ and $3x$ are also like terms. So, we group and add each pair of  like terms separately:\n\n$$\n\\begin{aligned}-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x &= \\left(4{x}^{2}-\\frac{5{x}^{2}}{2}\\right)+\\left(3x-\\frac{5x}{3}\\right) \\\\ &= \\left(4-\\frac{5}{2}\\right){x}^{2}+\\left(3-\\frac{5}{3}\\right)x \\\\ &= \\frac{3}{2}{x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$"] [:db/cas 17592186476940 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{2}({x}^{2}+\\frac{8}{9}xy)\\,\\text{d}y \\\\  & ={[{x}^{2}y+\\frac{4}{9}x{y}^{2}]}_{y=1}^{y=2} \\\\  & =({x}^{2}(2)+\\frac{4}{9}x\\cdot {2}^{2})-({x}^{2}(1)+\\frac{4}{9}x\\cdot {1}^{2}) \\\\  & ={x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}{x}^{2}+\\frac{4}{3}x, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{2}\\left({x}^{2}+\\frac{8}{9}xy\\right)\\,\\text{d}y \\\\  & ={\\left[{x}^{2}y+\\frac{4}{9}x{y}^{2}\\right]}_{y=1}^{y=2} \\\\  & =\\left({x}^{2}(2)+\\frac{4}{9}x\\cdot {2}^{2}\\right)-\\left({x}^{2}(1)+\\frac{4}{9}x\\cdot {1}^{2}\\right) \\\\  & ={x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}{x}^{2}+\\frac{4}{3}x, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186476942 :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}{e}^{-(5x+\\frac{y}{5})}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind $P(X\\le 5).$" "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}{e}^{-\\left(5x+\\frac{y}{5}\\right)}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind $P(X\\le 5).$"] [:db/cas 17592186476942 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 0$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\infty }{e}^{-(5x+\\frac{y}{5})}\\,\\text{d}y \\\\  & ={[-5{e}^{-(5x+\\frac{y}{5})}]}_{y=0}^{y=\\infty } \\\\  & =-5(0-{e}^{-(5x+0)}) \\\\  & =5{e}^{-5x}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}5{e}^{-5x}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 5) & ={\\int }_{-\\infty }^{5}{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{5}5{e}^{-5x}\\text{d}x \\\\  & ={[-{e}^{-5x}]}_{0}^{5} \\\\  & =-{e}^{-25}+{e}^{0} \\\\  & =1-\\frac{1}{{e}^{25}}.\\end{aligned}\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 0$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\infty }{e}^{-\\left(5x+\\frac{y}{5}\\right)}\\,\\text{d}y \\\\  & ={[-5{e}^{-\\left(5x+\\frac{y}{5}\\right)}]}_{y=0}^{y=\\infty } \\\\  & =-5(0-{e}^{-(5x+0)}) \\\\  & =5{e}^{-5x}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}5{e}^{-5x}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 5) & ={\\int }_{-\\infty }^{5}{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{5}5{e}^{-5x}\\text{d}x \\\\  & ={[-{e}^{-5x}]}_{0}^{5} \\\\  & =-{e}^{-25}+{e}^{0} \\\\  & =1-\\frac{1}{{e}^{25}}.\\end{aligned}\n$$"] [:db/cas 17592186476947 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le 3y\\le x\\le 3\\}.$\n\n![](images/54/54c803be9ecc7873f2624fc9d083997039cb651c11cc38eff6fa561ec064b7a5.png)\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{3y}^{3}\\frac{{x}^{2}+{y}^{2}}{3}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{3y}^{3}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=3y}^{x=3} \\\\  & =\\frac{1}{3}[\\frac{1}{3}\\cdot {3}^{3}+3\\cdot {y}^{2}-\\frac{1}{3}(3y)^{3}-3y\\cdot {y}^{2}] \\\\  & =\\frac{1}{3}[9+3{y}^{2}-12{y}^{3}] \\\\  & =3+{y}^{2}-4{y}^{3}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}3+{y}^{2}-4{y}^{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le 3y\\le x\\le 3\\}.$\n\n![](images/54/54c803be9ecc7873f2624fc9d083997039cb651c11cc38eff6fa561ec064b7a5.png)\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{3y}^{3}\\frac{{x}^{2}+{y}^{2}}{3}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{3y}^{3}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\left[\\frac{1}{3}{x}^{3}+x{y}^{2}\\right]}_{x=3y}^{x=3} \\\\  & =\\frac{1}{3}\\left[\\frac{1}{3}\\cdot {3}^{3}+3\\cdot {y}^{2}-\\frac{1}{3}(3y)^{3}-3y\\cdot {y}^{2}\\right] \\\\  & =\\frac{1}{3}[9+3{y}^{2}-12{y}^{3}] \\\\  & =3+{y}^{2}-4{y}^{3}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\left\\{\\begin{aligned}3+{y}^{2}-4{y}^{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186476948 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{{x}^{2}}{\\int }_{1}^{\\infty }\\frac{1}{{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{{x}^{2}}\\lim_{b\\to \\infty }{\\int }_{1}^{b}\\frac{1}{{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{{x}^{2}}\\lim_{b\\to \\infty }{[-\\frac{1}{y}]}_{y=1}^{y=b} \\\\  & =\\frac{1}{{x}^{2}}\\lim_{b\\to \\infty }[1-\\frac{1}{b}] \\\\  & =\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{1}^{x}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & ={[-\\frac{1}{u}]}_{1}^{x} \\\\  & =1-\\frac{1}{x} \\\\  & =\\frac{x-1}{x},\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}0, & x<1 \\\\ \\frac{x-1}{x}, & x\\ge 1.\\end{aligned}\\right.\n$$\n\nFinally, $g(x)=\\frac{x-1}{x}.$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{{x}^{2}}{\\int }_{1}^{\\infty }\\frac{1}{{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{{x}^{2}}\\lim_{b\\to \\infty }{\\int }_{1}^{b}\\frac{1}{{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{{x}^{2}}\\lim_{b\\to \\infty }{\\left[-\\frac{1}{y}\\right]}_{y=1}^{y=b} \\\\  & =\\frac{1}{{x}^{2}}\\lim_{b\\to \\infty }\\left[1-\\frac{1}{b}\\right] \\\\  & =\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{1}^{x}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & ={\\left[-\\frac{1}{u}\\right]}_{1}^{x} \\\\  & =1-\\frac{1}{x} \\\\  & =\\frac{x-1}{x},\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}0, & x<1 \\\\ \\frac{x-1}{x}, & x\\ge 1.\\end{aligned}\\right.\n$$\n\nFinally, $g(x)=\\frac{x-1}{x}.$"] [:db/cas 17592186476949 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=y\\sqrt{x}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 4,\\,1\\le y\\le 2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\sqrt{X}] & ={∬}_{{R}^{2}}y\\sqrt{x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}y\\sqrt{x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{4}y\\sqrt{x}\\cdot \\frac{\\sqrt{x}}{2{y}^{3}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{2{y}^{2}}{\\int }_{0}^{4}x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{2{y}^{2}}{[\\frac{{x}^{2}}{2}]}_{0}^{4}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{4}{{y}^{2}}\\,\\text{d}y \\\\  & =4[-\\frac{1}{y}]_{1}^{2} \\\\  & =2.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=y\\sqrt{x}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 4,\\,1\\le y\\le 2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\sqrt{X}] & ={∬}_{{R}^{2}}y\\sqrt{x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}y\\sqrt{x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{4}y\\sqrt{x}\\cdot \\frac{\\sqrt{x}}{2{y}^{3}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{2{y}^{2}}{\\int }_{0}^{4}x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{2{y}^{2}}{\\left[\\frac{{x}^{2}}{2}\\right]}_{0}^{4}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{4}{{y}^{2}}\\,\\text{d}y \\\\  & =4\\left[-\\frac{1}{y}\\right]_{1}^{2} \\\\  & =2.\\end{aligned}\n$$"] [:db/cas 17592186476954 :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 3$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{2}\\frac{1}{21}(xy)^{2}\\,\\text{d}y \\\\  & =\\frac{{x}^{2}}{21}{\\int }_{1}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{{x}^{2}}{21}{[\\frac{1}{3}{y}^{3}]}_{y=1}^{y=2} \\\\  & =\\frac{{x}^{2}}{63}({2}^{3}-{1}^{3}) \\\\  & =\\frac{1}{9}{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{1}{9}{x}^{2}, & 0\\le x\\le 3, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X>1) & ={\\int }_{1}^{\\infty }{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{9}{x}^{2}\\text{d}x \\\\  & =\\frac{1}{9}{[\\frac{1}{3}{x}^{3}]}_{1}^{3} \\\\  & =\\frac{1}{27}[{3}^{3}-{1}^{3}] \\\\  & =\\frac{26}{27}.\\end{aligned}\n$$" "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 3$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{1}^{2}\\frac{1}{21}(xy)^{2}\\,\\text{d}y \\\\  & =\\frac{{x}^{2}}{21}{\\int }_{1}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{{x}^{2}}{21}{\\left[\\frac{1}{3}{y}^{3}\\right]}_{y=1}^{y=2} \\\\  & =\\frac{{x}^{2}}{63}({2}^{3}-{1}^{3}) \\\\  & =\\frac{1}{9}{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{1}{9}{x}^{2}, & 0\\le x\\le 3, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X>1) & ={\\int }_{1}^{\\infty }{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{9}{x}^{2}\\text{d}x \\\\  & =\\frac{1}{9}{\\left[\\frac{1}{3}{x}^{3}\\right]}_{1}^{3} \\\\  & =\\frac{1}{27}[{3}^{3}-{1}^{3}] \\\\  & =\\frac{26}{27}.\\end{aligned}\n$$"] [:db/cas 17592186476959 :question/worked-solution "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y=1\n$$\n\nLet's check the above conditions for each of the given functions.\n\n- The function $f$  is *not* a valid probability density function because it does not satisfy the second condition:\n\n$$\n\\begin{aligned}{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y & ={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}{\\int }_{1}^{e}4xy\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}[{\\int }_{1}^{e}4xy\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}{[2{x}^{2}y]}_{x=1}^{x=e}\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}2({e}^{2}-1)y\\,\\text{d}y \\\\  & =[({e}^{2}-1){y}^{2}]_{1}^{e} \\\\  & =({e}^{2}-1)^{2} \\\\  & \\ne 1\\,\\times \\end{aligned}\n$$\n\n- The function $g$ is *not* a valid probability density function because it does not satisfy the first condition. For example,\n\n$$\ng(1,e)=\\frac{2-e}{4e}≱0.\\,\\times \n$$\n\n- The function $h$ is a valid probability density function. Indeed, we have $h(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2},$  and\n\n$$\n\\begin{aligned}{∬}_{{R}^{2}}h(x,y)\\,\\text{d}x\\text{d}y & ={∬}_{D}h(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}{\\int }_{1}^{e}\\frac{1}{xy}\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}[{\\int }_{1}^{e}\\frac{1}{xy}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}{[\\frac{\\operatorname{ln}⁡x}{y}]}_{x=1}^{x=e}\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y \\\\  & =[\\operatorname{ln}⁡y]_{1}^{e} \\\\  & =1\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$h$ only.\"" "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y=1\n$$\n\nLet's check the above conditions for each of the given functions.\n\n- The function $f$  is *not* a valid probability density function because it does not satisfy the second condition:\n\n$$\n\\begin{aligned}{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y & ={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}{\\int }_{1}^{e}4xy\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}[{\\int }_{1}^{e}4xy\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}{[2{x}^{2}y]}_{x=1}^{x=e}\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}2({e}^{2}-1)y\\,\\text{d}y \\\\  & =[({e}^{2}-1){y}^{2}]_{1}^{e} \\\\  & =({e}^{2}-1)^{2} \\\\  & \\ne 1\\,\\times \\end{aligned}\n$$\n\n- The function $g$ is *not* a valid probability density function because it does not satisfy the first condition. For example,\n\n$$\ng(1,e)=\\frac{2-e}{4e}≱0.\\,\\times \n$$\n\n- The function $h$ is a valid probability density function. Indeed, we have $h(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2},$  and\n\n$$\n\\begin{aligned}{∬}_{{R}^{2}}h(x,y)\\,\\text{d}x\\text{d}y & ={∬}_{D}h(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}{\\int }_{1}^{e}\\frac{1}{xy}\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{e}\\left[{\\int }_{1}^{e}\\frac{1}{xy}\\,\\text{d}x\\right]\\text{d}y \\\\  & ={\\int }_{1}^{e}{\\left[\\frac{\\operatorname{ln}⁡x}{y}\\right]}_{x=1}^{x=e}\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y \\\\  & =[\\operatorname{ln}⁡y]_{1}^{e} \\\\  & =1\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$h$ only.\""] [:db/cas 17592186476960 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=y\\operatorname{cos}⁡x.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\operatorname{cos}⁡X] & ={∬}_{{R}^{2}}y\\operatorname{cos}⁡x\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}y\\operatorname{cos}⁡x\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\pi /2}y\\operatorname{cos}⁡x\\cdot 2y\\operatorname{sin}⁡x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}{[-\\frac{1}{2}\\operatorname{cos}⁡2x]}_{0}^{\\pi /2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\,\\text{d}y \\\\  & =[\\frac{{y}^{3}}{3}]_{0}^{1} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=y\\operatorname{cos}⁡x.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\operatorname{cos}⁡X] & ={∬}_{{R}^{2}}y\\operatorname{cos}⁡x\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}y\\operatorname{cos}⁡x\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\pi /2}y\\operatorname{cos}⁡x\\cdot 2y\\operatorname{sin}⁡x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}{\\left[-\\frac{1}{2}\\operatorname{cos}⁡2x\\right]}_{0}^{\\pi /2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\,\\text{d}y \\\\  & =\\left[\\frac{{y}^{3}}{3}\\right]_{0}^{1} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"] [:db/cas 17592186476967 :question/problem "Find $\\text{E}[\\frac{{e}^{X-Y}}{1-X}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}{e}^{y},\\, & 0\\le x\\le 1,\\,x\\le y\\le 1,, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "Find $\\text{E}\\left[\\frac{{e}^{X-Y}}{1-X}\\right],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}{e}^{y},\\, & 0\\le x\\le 1,\\,x\\le y\\le 1,, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186476967 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\frac{{e}^{x-y}}{1-x}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,x\\le y\\le 1\\},$ where $f(x,y)$ is nonzero.\n\n![](images/bc/bc44d4c99cf60148685a99b5c3b5ea2e732ea4b9939aefe5ba465d46e92c5ea8.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\frac{{e}^{X-Y}}{1-X}] & ={∬}_{{R}^{2}}\\frac{{e}^{x-y}}{1-x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\frac{{e}^{x-y}}{1-x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{x}^{1}\\frac{{e}^{x-y}}{1-x}\\cdot {e}^{y}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{x}}{1-x}{\\int }_{x}^{1}\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{x}}{1-x}\\cdot [y]_{y=x}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{x}}{1-x}(1-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{x}\\,\\text{d}x \\\\  & =[{e}^{x}]_{x=0}^{x=1} \\\\  & =e-1.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\frac{{e}^{x-y}}{1-x}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,x\\le y\\le 1\\},$ where $f(x,y)$ is nonzero.\n\n![](images/bc/bc44d4c99cf60148685a99b5c3b5ea2e732ea4b9939aefe5ba465d46e92c5ea8.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}\\left[\\frac{{e}^{X-Y}}{1-X}\\right] & ={∬}_{{R}^{2}}\\frac{{e}^{x-y}}{1-x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\frac{{e}^{x-y}}{1-x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{x}^{1}\\frac{{e}^{x-y}}{1-x}\\cdot {e}^{y}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{x}}{1-x}{\\int }_{x}^{1}\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{x}}{1-x}\\cdot [y]_{y=x}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{x}}{1-x}(1-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{x}\\,\\text{d}x \\\\  & =[{e}^{x}]_{x=0}^{x=1} \\\\  & =e-1.\\end{aligned}\n$$"] [:db/cas 17592186476969 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\operatorname{cos}⁡(x-y).\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{4},\\,0\\le y\\le x\\},$ where $f(x)$ is nonzero.\n\n![](images/ff/ff35a5c562607b4ac314d3ae755156d75baf5d8b01b813f6b59d67dac540e154.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\operatorname{cos}⁡(X-Y)] & ={∬}_{{R}^{2}}\\operatorname{cos}⁡(x-y)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\operatorname{cos}⁡(x-y)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{x}\\operatorname{cos}⁡(x-y)\\cdot \\frac{32}{{\\pi }^{2}}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}{\\int }_{0}^{x}\\operatorname{cos}⁡(x-y)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}[-\\operatorname{sin}⁡(x-y)]_{y=0}^{y=x}\\,\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}[\\operatorname{sin}⁡(x)-\\operatorname{sin}⁡(0)]\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡(x)\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{[-\\operatorname{cos}⁡(x)]}_{x=0}^{x=\\pi /4} \\\\  & =\\frac{32}{{\\pi }^{2}}[\\operatorname{cos}⁡(0)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)] \\\\  & =\\frac{32}{{\\pi }^{2}}(1-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{16}{{\\pi }^{2}}(2-\\sqrt{2}).\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\operatorname{cos}⁡(x-y).\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{4},\\,0\\le y\\le x\\},$ where $f(x)$ is nonzero.\n\n![](images/ff/ff35a5c562607b4ac314d3ae755156d75baf5d8b01b813f6b59d67dac540e154.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\operatorname{cos}⁡(X-Y)] & ={∬}_{{R}^{2}}\\operatorname{cos}⁡(x-y)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\operatorname{cos}⁡(x-y)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{x}\\operatorname{cos}⁡(x-y)\\cdot \\frac{32}{{\\pi }^{2}}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}{\\int }_{0}^{x}\\operatorname{cos}⁡(x-y)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}[-\\operatorname{sin}⁡(x-y)]_{y=0}^{y=x}\\,\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}[\\operatorname{sin}⁡(x)-\\operatorname{sin}⁡(0)]\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡(x)\\text{d}x \\\\  & =\\frac{32}{{\\pi }^{2}}{[-\\operatorname{cos}⁡(x)]}_{x=0}^{x=\\pi /4} \\\\  & =\\frac{32}{{\\pi }^{2}}\\left[\\operatorname{cos}⁡(0)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)\\right] \\\\  & =\\frac{32}{{\\pi }^{2}}\\left(1-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =\\frac{16}{{\\pi }^{2}}(2-\\sqrt{2}).\\end{aligned}\n$$"] [:db/cas 17592186476973 :question/problem "Find $\\text{E}[\\frac{Y}{7X}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{21}{4}{x}^{2}y,\\, & -1\\le x\\le 1,\\,{x}^{2}\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" "Find $\\text{E}\\left[\\frac{Y}{7X}\\right],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{21}{4}{x}^{2}y,\\, & -1\\le x\\le 1,\\,{x}^{2}\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"] [:db/cas 17592186476973 :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\frac{y}{7x}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,{x}^{2}\\le y\\le 1\\},$ where $f(x,y)$ is nonzero.\n\n![](images/54/54777bc840acd1d1c24da08ccb99025b039af9c47421602a3d9dd73df2a91779.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\frac{Y}{7X}] & ={∬}_{{R}^{2}}\\frac{y}{7x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\frac{y}{7x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{1}{\\int }_{{x}^{2}}^{1}\\frac{y}{7x}\\cdot \\frac{21}{4}{x}^{2}y\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{-1}^{1}x{\\int }_{{x}^{2}}^{1}{y}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{-1}^{1}x{[\\frac{{y}^{3}}{3}]}_{y={x}^{2}}^{y=1}\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{-1}^{1}x[\\frac{1}{3}-\\frac{{x}^{6}}{3}]\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-1}^{1}(x-{x}^{7})\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{2}}{2}-\\frac{{x}^{8}}{8}]}_{x=-1}^{x=1} \\\\  & =\\frac{1}{4}[(\\frac{1}{2}-\\frac{1}{8})-(\\frac{1}{2}-\\frac{1}{8})] \\\\  & =0.\\end{aligned}\n$$" "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\frac{y}{7x}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,{x}^{2}\\le y\\le 1\\},$ where $f(x,y)$ is nonzero.\n\n![](images/54/54777bc840acd1d1c24da08ccb99025b039af9c47421602a3d9dd73df2a91779.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}\\left[\\frac{Y}{7X}\\right] & ={∬}_{{R}^{2}}\\frac{y}{7x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\frac{y}{7x}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{1}{\\int }_{{x}^{2}}^{1}\\frac{y}{7x}\\cdot \\frac{21}{4}{x}^{2}y\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{-1}^{1}x{\\int }_{{x}^{2}}^{1}{y}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{-1}^{1}x{\\left[\\frac{{y}^{3}}{3}\\right]}_{y={x}^{2}}^{y=1}\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{-1}^{1}x\\left[\\frac{1}{3}-\\frac{{x}^{6}}{3}\\right]\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-1}^{1}(x-{x}^{7})\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\left[\\frac{{x}^{2}}{2}-\\frac{{x}^{8}}{8}\\right]}_{x=-1}^{x=1} \\\\  & =\\frac{1}{4}\\left[\\left(\\frac{1}{2}-\\frac{1}{8}\\right)-\\left(\\frac{1}{2}-\\frac{1}{8}\\right)\\right] \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186476977 :question/worked-solution "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y=1\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le y<1-x\\le 1\\}.$\n\n![](images/ab/ab6a4fce220150c53a70ca236843203460a7040cc1a1b5dfe664c6d45dd93ac1.png)\n\nNow, let's check our conditions:\n\n- Since $c>0,$ we clearly have $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}.$ So the first condition is satisfied.\n\n- For the second condition to be satisfied, we must have \n\n$$\n{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y={\\int }_{0}^{1}{\\int }_{0}^{1-x}c\\,\\text{d}y\\,\\text{d}x=1.\n$$\n\nWe evaluate the inner integral by integrating with respect to $y$, treating  $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{1-x}c\\,\\text{d}y]\\text{d}x & ={\\int }_{0}^{1}{[cy]}_{y=0}^{y=1-x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}c(1-x)\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we integrate with respect to $x$:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}c(1-x)\\,\\text{d}x & ={[-\\frac{c(1-x)^{2}}{2}]}_{0}^{1} \\\\  & =\\frac{c}{2}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{c}{2}=1\\,⇒\\,c=2.\n$$" "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y=1\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le y<1-x\\le 1\\}.$\n\n![](images/ab/ab6a4fce220150c53a70ca236843203460a7040cc1a1b5dfe664c6d45dd93ac1.png)\n\nNow, let's check our conditions:\n\n- Since $c>0,$ we clearly have $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}.$ So the first condition is satisfied.\n\n- For the second condition to be satisfied, we must have \n\n$$\n{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y={\\int }_{0}^{1}{\\int }_{0}^{1-x}c\\,\\text{d}y\\,\\text{d}x=1.\n$$\n\nWe evaluate the inner integral by integrating with respect to $y$, treating  $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{1-x}c\\,\\text{d}y]\\text{d}x & ={\\int }_{0}^{1}{[cy]}_{y=0}^{y=1-x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}c(1-x)\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we integrate with respect to $x$:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}c(1-x)\\,\\text{d}x & ={\\left[-\\frac{c(1-x)^{2}}{2}\\right]}_{0}^{1} \\\\  & =\\frac{c}{2}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{c}{2}=1\\,⇒\\,c=2.\n$$"] [:db/cas 17592186477655 :answer-field/key "$(\\frac{\\pi }{6},\\frac{1}{2})$" "$\\left(\\frac{\\pi }{6},\\frac{1}{2}\\right)$"] [:db/cas 17592186477656 :answer-field/key "$(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3})$" "$\\left(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186477658 :answer-field/key "$(\\frac{\\pi }{3},\\frac{1}{2})$" "$\\left(\\frac{\\pi }{3},\\frac{1}{2}\\right)$"] [:db/cas 17592186477659 :answer-field/key "$(\\frac{\\sqrt{2}}{2},\\frac{7\\pi }{4})$" "$\\left(\\frac{\\sqrt{2}}{2},\\frac{7\\pi }{4}\\right)$"] [:db/cas 17592186477660 :answer-field/key "$(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$" "$\\left(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4}\\right)$"] [:db/cas 17592186477661 :answer-field/key "$(\\frac{1}{2},\\frac{\\pi }{4})$" "$\\left(\\frac{1}{2},\\frac{\\pi }{4}\\right)$"] [:db/cas 17592186477662 :answer-field/key "$(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4})$" "$\\left(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4}\\right)$"] [:db/cas 17592186477664 :answer-field/key "$(1,\\frac{\\pi }{6})$" "$\\left(1,\\frac{\\pi }{6}\\right)$"] [:db/cas 17592186477665 :answer-field/key "$(\\sqrt{3},\\frac{\\pi }{3})$" "$\\left(\\sqrt{3},\\frac{\\pi }{3}\\right)$"] [:db/cas 17592186477666 :answer-field/key "$(-1,-\\frac{\\pi }{4})$" "$\\left(-1,-\\frac{\\pi }{4}\\right)$"] [:db/cas 17592186477853 :answer/value "\\operatorname{cos}⁡(x-\\frac{\\pi }{6})" "\\operatorname{cos}⁡\\left(x-\\frac{\\pi }{6}\\right)"] [:db/cas 17592186477866 :answer/value "\\sqrt{2}\\operatorname{cos}⁡(x-\\frac{\\pi }{4})" "\\sqrt{2}\\operatorname{cos}⁡\\left(x-\\frac{\\pi }{4}\\right)"] [:db/cas 17592186477964 :answer/value "{\\int }_{0}^{25}(25+\\frac{2}{1+3x})\\,\\text{d}x" "{\\int }_{0}^{25}\\left(25+\\frac{2}{1+3x}\\right)\\,\\text{d}x"] [:db/cas 17592186478015 :answer/value "\\operatorname{cos}⁡(x-\\frac{\\pi }{3})" "\\operatorname{cos}⁡\\left(x-\\frac{\\pi }{3}\\right)"] [:db/cas 17592186478031 :answer/value "\\sqrt{3}\\operatorname{cos}⁡(x-\\frac{\\pi }{6})" "\\sqrt{3}\\operatorname{cos}⁡\\left(x-\\frac{\\pi }{6}\\right)"] [:db/cas 17592186478150 :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡(x-\\frac{2\\pi }{3})" "\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡\\left(x-\\frac{2\\pi }{3}\\right)"] [:db/cas 17592186478194 :answer/value "{\\int }_{0}^{t}(25+\\frac{2}{1+3x})\\,\\text{d}x" "{\\int }_{0}^{t}\\left(25+\\frac{2}{1+3x}\\right)\\,\\text{d}x"] [:db/cas 17592186478374 :question/worked-solution "We're given $\\text{E}[X].$ So, we first need to compute $\\text{E}[Y].$\n\nThe marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{6}{7}(x+\\sqrt{y})\\,\\text{d}x \\\\  & =\\frac{6}{7}{[\\frac{1}{2}{x}^{2}+x\\sqrt{y}]}_{x=0}^{x=1} \\\\  & =\\frac{6}{7}(\\frac{1}{2}+\\sqrt{y}) \\\\  & =\\frac{3}{7}(2\\sqrt{y}+1).\\end{aligned}\n$$\n\nTherefore, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{3}{7}(2\\sqrt{y}+1)\\,\\text{d}y \\\\  & =\\frac{3}{7}{\\int }_{0}^{1}(2{y}^{3/2}+y)\\,\\text{d}y \\\\  & =\\frac{3}{7}{[\\frac{4}{5}{y}^{5/2}+\\frac{1}{2}{y}^{2}]}_{0}^{1} \\\\  & =\\frac{3}{7}(\\frac{4}{5}+\\frac{1}{2}) \\\\  & =\\frac{39}{70}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[2X+Y] & =2\\,\\text{E}[X]+\\text{E}[Y] \\\\  & =2\\left(\\frac{4}{7}\\right)+\\left(\\frac{39}{70}\\right) \\\\  & =\\frac{80+39}{70} \\\\  & =\\frac{17}{10}.\\end{aligned}\n$$" "We're given $\\text{E}[X].$ So, we first need to compute $\\text{E}[Y].$\n\nThe marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{6}{7}(x+\\sqrt{y})\\,\\text{d}x \\\\  & =\\frac{6}{7}{\\left[\\frac{1}{2}{x}^{2}+x\\sqrt{y}\\right]}_{x=0}^{x=1} \\\\  & =\\frac{6}{7}\\left(\\frac{1}{2}+\\sqrt{y}\\right) \\\\  & =\\frac{3}{7}(2\\sqrt{y}+1).\\end{aligned}\n$$\n\nTherefore, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{3}{7}(2\\sqrt{y}+1)\\,\\text{d}y \\\\  & =\\frac{3}{7}{\\int }_{0}^{1}(2{y}^{3/2}+y)\\,\\text{d}y \\\\  & =\\frac{3}{7}{\\left[\\frac{4}{5}{y}^{5/2}+\\frac{1}{2}{y}^{2}\\right]}_{0}^{1} \\\\  & =\\frac{3}{7}\\left(\\frac{4}{5}+\\frac{1}{2}\\right) \\\\  & =\\frac{39}{70}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[2X+Y] & =2\\,\\text{E}[X]+\\text{E}[Y] \\\\  & =2\\left(\\frac{4}{7}\\right)+\\left(\\frac{39}{70}\\right) \\\\  & =\\frac{80+39}{70} \\\\  & =\\frac{17}{10}.\\end{aligned}\n$$"] [:db/cas 17592186478381 :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{2}{3}x\\cdot \\frac{3}{8}{y}^{2} \\\\  & =\\frac{1}{4}x{y}^{2},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [1,2]\\times [0,2].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{4}x{y}^{2}, & \\,1\\le x\\le 2,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 1.5,Y\\ge 1) & ={\\int }_{1}^{1.5}[{\\int }_{1}^{2}\\frac{1}{4}x{y}^{2}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{1.5}\\frac{1}{4}x{[\\frac{{y}^{3}}{3}]}_{1}^{2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{1.5}\\frac{1}{4}x(\\frac{8}{3}-\\frac{1}{3})\\,\\text{d}x \\\\  & ={\\int }_{1}^{1.5}\\frac{7}{12}x\\,\\text{d}x \\\\  & ={[\\frac{7{x}^{2}}{24}]}_{1}^{1.5}\\,\\text{d}x \\\\  & =\\frac{7(1.5)^{2}}{24}-\\frac{7(1)^{2}}{24} \\\\  & ≈0.365.\\end{aligned}\n$$" "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{2}{3}x\\cdot \\frac{3}{8}{y}^{2} \\\\  & =\\frac{1}{4}x{y}^{2},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [1,2]\\times [0,2].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{4}x{y}^{2}, & \\,1\\le x\\le 2,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 1.5,Y\\ge 1) & ={\\int }_{1}^{1.5}\\left[{\\int }_{1}^{2}\\frac{1}{4}x{y}^{2}\\,\\text{d}y\\right]\\text{d}x \\\\  & ={\\int }_{1}^{1.5}\\frac{1}{4}x{\\left[\\frac{{y}^{3}}{3}\\right]}_{1}^{2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{1.5}\\frac{1}{4}x\\left(\\frac{8}{3}-\\frac{1}{3}\\right)\\,\\text{d}x \\\\  & ={\\int }_{1}^{1.5}\\frac{7}{12}x\\,\\text{d}x \\\\  & ={\\left[\\frac{7{x}^{2}}{24}\\right]}_{1}^{1.5}\\,\\text{d}x \\\\  & =\\frac{7(1.5)^{2}}{24}-\\frac{7(1)^{2}}{24} \\\\  & ≈0.365.\\end{aligned}\n$$"] [:db/cas 17592186478386 :question/worked-solution "We're given the **rate of change** of electricity consumption $r(t).$ To find the **net amount** of electricity consumed by the house between the times $t=0$ and $t=3,$ we integrate $r(t)$ between these two limits. This gives:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}(2{t}^{2}-8t+10)\\,\\text{d}t & ={(\\frac{2}{3}{t}^{3}-\\frac{8}{2}{t}^{2}+10t)|}_{0}^{3} \\\\  & ={(\\frac{2}{3}{t}^{3}-4{t}^{2}+10t)|}_{0}^{3} \\\\  & =(\\frac{2}{3}(3)^{3}-4(3)^{2}+10(3))-(0-0+0) \\\\  & =18-36+30 \\\\  & =12\\end{aligned}\n$$\n\nTherefore, between $t=0$ and $t=3$ hours, $12$ kilowatt-hours were consumed." "We're given the **rate of change** of electricity consumption $r(t).$ To find the **net amount** of electricity consumed by the house between the times $t=0$ and $t=3,$ we integrate $r(t)$ between these two limits. This gives:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}(2{t}^{2}-8t+10)\\,\\text{d}t & ={\\left(\\frac{2}{3}{t}^{3}-\\frac{8}{2}{t}^{2}+10t\\right)|}_{0}^{3} \\\\  & ={\\left(\\frac{2}{3}{t}^{3}-4{t}^{2}+10t\\right)|}_{0}^{3} \\\\  & =\\left(\\frac{2}{3}(3)^{3}-4(3)^{2}+10(3)\\right)-(0-0+0) \\\\  & =18-36+30 \\\\  & =12\\end{aligned}\n$$\n\nTherefore, between $t=0$ and $t=3$ hours, $12$ kilowatt-hours were consumed."] [:db/cas 17592186478394 :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{8}(x+1)\\cdot \\frac{2}{{y}^{2}} \\\\  & =\\frac{x+1}{4{y}^{2}},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [2,4]\\times [1,2].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{x+1}{4{y}^{2}}, & \\,2\\le x\\le 4,\\,1\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\ge 3,Y\\le 4) & ={\\int }_{3}^{4}[{\\int }_{1}^{2}\\frac{x+1}{4{y}^{2}}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{x+1}{4}{[-\\frac{1}{y}]}_{1}^{2}\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{x+1}{4}\\left(\\frac{1}{2}\\right)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{x+1}{8}\\,\\text{d}x \\\\  & ={[\\frac{1}{8}(\\frac{{x}^{2}}{2}+x)]}_{3}^{4}\\,\\text{d}x \\\\  & =\\frac{1}{8}(8+4)-\\frac{1}{8}(\\frac{9}{2}+3) \\\\  & =\\frac{9}{16}.\\end{aligned}\n$$" "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{8}(x+1)\\cdot \\frac{2}{{y}^{2}} \\\\  & =\\frac{x+1}{4{y}^{2}},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [2,4]\\times [1,2].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{x+1}{4{y}^{2}}, & \\,2\\le x\\le 4,\\,1\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\ge 3,Y\\le 4) & ={\\int }_{3}^{4}\\left[{\\int }_{1}^{2}\\frac{x+1}{4{y}^{2}}\\,\\text{d}y\\right]\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{x+1}{4}{\\left[-\\frac{1}{y}\\right]}_{1}^{2}\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{x+1}{4}\\left(\\frac{1}{2}\\right)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{x+1}{8}\\,\\text{d}x \\\\  & ={\\left[\\frac{1}{8}\\left(\\frac{{x}^{2}}{2}+x\\right)\\right]}_{3}^{4}\\,\\text{d}x \\\\  & =\\frac{1}{8}(8+4)-\\frac{1}{8}\\left(\\frac{9}{2}+3\\right) \\\\  & =\\frac{9}{16}.\\end{aligned}\n$$"] [:db/cas 17592186478396 :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{8}x\\cdot \\frac{2}{5}y \\\\  & =\\frac{1}{20}xy,\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,4]\\times [2,3].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{20}xy, & \\,0\\le x\\le 4,\\,2\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(1\\le X\\le 2,1\\le Y\\le 3) & ={\\int }_{1}^{2}[{\\int }_{2}^{3}\\frac{1}{20}xy\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{20}x{[\\frac{{y}^{2}}{2}]}_{2}^{3}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{8}x\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{16}]}_{1}^{2} \\\\  & =\\frac{(2)^{2}}{16}-\\frac{(1)^{2}}{16} \\\\  & =\\frac{3}{16}.\\end{aligned}\n$$" "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{8}x\\cdot \\frac{2}{5}y \\\\  & =\\frac{1}{20}xy,\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,4]\\times [2,3].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{20}xy, & \\,0\\le x\\le 4,\\,2\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(1\\le X\\le 2,1\\le Y\\le 3) & ={\\int }_{1}^{2}\\left[{\\int }_{2}^{3}\\frac{1}{20}xy\\,\\text{d}y\\right]\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{20}x{\\left[\\frac{{y}^{2}}{2}\\right]}_{2}^{3}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{8}x\\,\\text{d}x \\\\  & ={\\left[\\frac{{x}^{2}}{16}\\right]}_{1}^{2} \\\\  & =\\frac{(2)^{2}}{16}-\\frac{(1)^{2}}{16} \\\\  & =\\frac{3}{16}.\\end{aligned}\n$$"] [:db/cas 17592186478405 :question/worked-solution "We're given $\\text{E}[Y].$ So, we first need to compute $\\text{E}[X].$\n\nThe marginal density function for $X$ when $1\\le x\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{2}{5}(x+2y)\\,\\text{d}y \\\\  & =\\frac{2}{5}{[xy+{y}^{2}]}_{y=0}^{y=1} \\\\  & =\\frac{2}{5}(x+1-0) \\\\  & =\\frac{2(x+1)}{5}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot \\frac{2(x+1)}{5}\\,\\text{d}x \\\\  & =\\frac{2}{5}{\\int }_{1}^{2}({x}^{2}+x)\\,\\text{d}x \\\\  & =\\frac{2}{5}{[\\frac{{x}^{3}}{3}+\\frac{{x}^{2}}{2}]}_{1}^{2} \\\\  & =\\frac{2}{5}(\\frac{8}{3}+2-\\frac{1}{3}-\\frac{1}{2}) \\\\  & =\\frac{23}{15}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X+2Y] & =\\text{E}[X]+2\\text{E}[Y] \\\\  & =\\frac{23}{15}+2\\left(\\frac{17}{30}\\right) \\\\  & =\\frac{23}{15}+\\frac{17}{15} \\\\  & =\\frac{40}{15} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$" "We're given $\\text{E}[Y].$ So, we first need to compute $\\text{E}[X].$\n\nThe marginal density function for $X$ when $1\\le x\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{2}{5}(x+2y)\\,\\text{d}y \\\\  & =\\frac{2}{5}{[xy+{y}^{2}]}_{y=0}^{y=1} \\\\  & =\\frac{2}{5}(x+1-0) \\\\  & =\\frac{2(x+1)}{5}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot \\frac{2(x+1)}{5}\\,\\text{d}x \\\\  & =\\frac{2}{5}{\\int }_{1}^{2}({x}^{2}+x)\\,\\text{d}x \\\\  & =\\frac{2}{5}{\\left[\\frac{{x}^{3}}{3}+\\frac{{x}^{2}}{2}\\right]}_{1}^{2} \\\\  & =\\frac{2}{5}\\left(\\frac{8}{3}+2-\\frac{1}{3}-\\frac{1}{2}\\right) \\\\  & =\\frac{23}{15}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X+2Y] & =\\text{E}[X]+2\\text{E}[Y] \\\\  & =\\frac{23}{15}+2\\left(\\frac{17}{30}\\right) \\\\  & =\\frac{23}{15}+\\frac{17}{15} \\\\  & =\\frac{40}{15} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$"] [:db/cas 17592186478421 :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{4}{\\pi }\\operatorname{cos}⁡x,\\, & 0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{4}, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{X}(x)=\\frac{\\pi }{4}\\operatorname{cos}⁡x$ for $x\\in [0,\\frac{\\pi }{2}]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{4}{\\pi }\\operatorname{cos}⁡x,\\, & 0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{4}, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{X}(x)=\\frac{\\pi }{4}\\operatorname{cos}⁡x$ for $x\\in \\left[0,\\frac{\\pi }{2}\\right]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent"] [:db/cas 17592186478421 :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\pi /4}\\frac{4}{\\pi }\\operatorname{cos}⁡x\\,\\text{d}y \\\\  & =\\frac{4}{\\pi }\\operatorname{cos}⁡x\\cdot [y]_{0}^{\\pi /4} \\\\  & =\\operatorname{cos}⁡x,\\end{aligned}\n$$\n\n \nwhere $x\\in [0,\\frac{\\pi }{2}].$\n\n- Statement II is true. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /2}\\frac{4}{\\pi }\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\frac{4}{\\pi }[\\operatorname{sin}⁡x]_{0}^{\\pi /2} \\\\  & =\\frac{4}{\\pi },\\end{aligned}\n$$\n\n \nwhere $y\\in [0,\\frac{\\pi }{4}].$ So, when $x\\in [0,\\frac{\\pi }{2}]$ and $y\\in [0,\\frac{\\pi }{4}],$ we obtain that \n\n$$\n\\underbrace{\\frac{4}{\\pi }\\operatorname{cos}⁡x}_{f(x,y)}=\\underbrace{(\\operatorname{cos}⁡x)}_{{f}_{X}(x)}\\cdot \\underbrace{\\left(\\frac{4}{\\pi }\\right)}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ are independent.\n\nTherefore, the correct answer is \"II and III only.\"" "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\pi /4}\\frac{4}{\\pi }\\operatorname{cos}⁡x\\,\\text{d}y \\\\  & =\\frac{4}{\\pi }\\operatorname{cos}⁡x\\cdot [y]_{0}^{\\pi /4} \\\\  & =\\operatorname{cos}⁡x,\\end{aligned}\n$$\n\n \nwhere $x\\in \\left[0,\\frac{\\pi }{2}\\right].$\n\n- Statement II is true. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /2}\\frac{4}{\\pi }\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\frac{4}{\\pi }[\\operatorname{sin}⁡x]_{0}^{\\pi /2} \\\\  & =\\frac{4}{\\pi },\\end{aligned}\n$$\n\n \nwhere $y\\in \\left[0,\\frac{\\pi }{4}\\right].$ So, when $x\\in \\left[0,\\frac{\\pi }{2}\\right]$ and $y\\in \\left[0,\\frac{\\pi }{4}\\right],$ we obtain that \n\n$$\n\\underbrace{\\frac{4}{\\pi }\\operatorname{cos}⁡x}_{f(x,y)}=\\underbrace{(\\operatorname{cos}⁡x)}_{{f}_{X}(x)}\\cdot \\underbrace{\\left(\\frac{4}{\\pi }\\right)}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ are independent.\n\nTherefore, the correct answer is \"II and III only.\""] [:db/cas 17592186478424 :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{8}(x+2)\\cdot \\frac{1}{3}{e}^{y} \\\\  & =\\frac{1}{24}(x+2){e}^{y},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [1,3]\\times [0,\\operatorname{ln}⁡4].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{24}(x+2){e}^{y}, & \\,1\\le x\\le 3,\\,0\\le y\\le \\operatorname{ln}⁡4 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(1\\le X\\le 2,Y\\le \\operatorname{ln}⁡2) & ={\\int }_{1}^{2}[{\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{1}{24}(x+2){e}^{y}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{24}(x+2)[{e}^{y}]_{0}^{\\operatorname{ln}⁡2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{24}(x+2)\\,\\text{d}x \\\\  & ={[\\frac{1}{24}(\\frac{{x}^{2}}{2}+2x)]}_{1}^{2} \\\\  & =\\frac{1}{24}(2+4)-\\frac{1}{24}(\\frac{1}{2}+2) \\\\  & =\\frac{1}{4}-\\frac{5}{48} \\\\  & =\\frac{7}{48}.\\end{aligned}\n$$" "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{8}(x+2)\\cdot \\frac{1}{3}{e}^{y} \\\\  & =\\frac{1}{24}(x+2){e}^{y},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [1,3]\\times [0,\\operatorname{ln}⁡4].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{24}(x+2){e}^{y}, & \\,1\\le x\\le 3,\\,0\\le y\\le \\operatorname{ln}⁡4 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\right.\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(1\\le X\\le 2,Y\\le \\operatorname{ln}⁡2) & ={\\int }_{1}^{2}\\left[{\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{1}{24}(x+2){e}^{y}\\,\\text{d}y\\right]\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{24}(x+2)[{e}^{y}]_{0}^{\\operatorname{ln}⁡2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{24}(x+2)\\,\\text{d}x \\\\  & ={\\left[\\frac{1}{24}\\left(\\frac{{x}^{2}}{2}+2x\\right)\\right]}_{1}^{2} \\\\  & =\\frac{1}{24}(2+4)-\\frac{1}{24}\\left(\\frac{1}{2}+2\\right) \\\\  & =\\frac{1}{4}-\\frac{5}{48} \\\\  & =\\frac{7}{48}.\\end{aligned}\n$$"] [:db/cas 17592186478427 :question/worked-solution "We're given $\\text{E}[X].$ So, we first need to compute $\\text{E}[Y].$\n\nThe marginal density function for $Y$ when $0\\le y\\le 3$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{y\\sqrt{x}}{3}\\,\\text{d}x \\\\  & =\\frac{y}{3}{[\\frac{2}{3}{x}^{3/2}]}_{x=0}^{x=1} \\\\  & =\\frac{y}{3}(\\frac{2}{3}-0) \\\\  & =\\frac{2y}{9}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}y\\cdot \\frac{2y}{9}\\,\\text{d}y \\\\  & =\\frac{2}{9}{\\int }_{0}^{3}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{2}{9}{[\\frac{{y}^{3}}{3}]}_{0}^{3} \\\\  & =\\frac{2}{9}(9-0) \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[5X-Y] & =5\\,\\text{E}[X]+(-1)\\,\\text{E}[Y] \\\\  & =5\\left(\\frac{3}{5}\\right)+(-1)(2) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$" "We're given $\\text{E}[X].$ So, we first need to compute $\\text{E}[Y].$\n\nThe marginal density function for $Y$ when $0\\le y\\le 3$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{y\\sqrt{x}}{3}\\,\\text{d}x \\\\  & =\\frac{y}{3}{\\left[\\frac{2}{3}{x}^{3/2}\\right]}_{x=0}^{x=1} \\\\  & =\\frac{y}{3}\\left(\\frac{2}{3}-0\\right) \\\\  & =\\frac{2y}{9}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}y\\cdot \\frac{2y}{9}\\,\\text{d}y \\\\  & =\\frac{2}{9}{\\int }_{0}^{3}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{2}{9}{\\left[\\frac{{y}^{3}}{3}\\right]}_{0}^{3} \\\\  & =\\frac{2}{9}(9-0) \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[5X-Y] & =5\\,\\text{E}[X]+(-1)\\,\\text{E}[Y] \\\\  & =5\\left(\\frac{3}{5}\\right)+(-1)(2) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"] [:db/cas 17592186478431 :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =(\\frac{3}{8}{x}^{2})\\cdot (\\frac{2}{3}(y+1)) \\\\  & =\\frac{1}{4}{x}^{2}(y+1)\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,2]\\times [0,1].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{4}{x}^{2}(y+1), & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\right.\n$$" "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) 