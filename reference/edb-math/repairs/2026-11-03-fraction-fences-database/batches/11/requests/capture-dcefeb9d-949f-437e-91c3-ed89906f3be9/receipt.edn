}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-\\frac{1}{y}\\,dx+\\frac{y}{x}\\,dy+dz & ={\\int }_{0}^{\\pi }-\\frac{1}{y}\\frac{\\text{d}x}{\\text{d}t}\\,dt+\\frac{y}{x}\\frac{\\text{d}y}{\\text{d}t}\\,dt+\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }\\left(-\\frac{1}{y}\\frac{\\text{d}x}{\\text{d}t}+\\frac{y}{x}\\frac{\\text{d}y}{\\text{d}t}+\\frac{\\text{d}z}{\\text{d}t}\\right)dt \\\\  & ={\\int }_{0}^{\\pi }-\\frac{1}{\\operatorname{sin}⁡t}(-\\operatorname{sin}⁡t)+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}(\\operatorname{cos}⁡t)+1\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }2+\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =(2t-\\operatorname{cos}⁡t)\\,{|}_{0}^{\\pi } \\\\  & =(2\\pi -\\operatorname{cos}⁡\\pi )+\\operatorname{cos}⁡0 \\\\  & =2(\\pi +1)\\end{aligned}\n$$" 13194139545757 17592186576411 true] [17592186534977 1074 "First, let's make a sketch of our region.\n\n![](images/47/47b612a3e08ff24055cbffa7d53fb337f1905ec861abd3a8e535088d383162cb.png)\n\nNotice that the limits of integration are from $y=0$ to $y=1$ along the $y$-axis.\n\nTo determine which is the left and which is the right function, let's draw our horizontal arrow.  \n\n![](images/19/1927874f5eca0c18b7b61b37d0e6fac5198ec9dcf89205763e88570287330292.png)\n\nThe horizontal arrow \n\n- *enters* the region through the left function $x=\\sqrt[3]{y},$ and\n\n- *leaves* through the right function $x=3.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{0}^{1}[\\,(\\text{right function})-(\\text{left function})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}[\\,(3)-(\\sqrt[3]{y})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[3-\\sqrt[3]{y}]}^{2}\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({y}^{2/3}-6{y}^{1/3}+9)\\text{d}y \\\\  & =\\pi ({\\int }_{0}^{1}{y}^{2/3}\\,\\text{d}y-6{\\int }_{0}^{1}{y}^{1/3}\\,\\text{d}y+9{\\int }_{0}^{1}\\,\\text{d}y) \\\\  & =\\pi (\\frac{3{y}^{5/3}}{5}{|}_{0}^{1}-{\\frac{9{y}^{4/3}}{2}|}_{0}^{1}+9y{|}_{0}^{1}) \\\\  & =\\pi [(\\frac{3}{5}-0)-(\\frac{9}{2}-0)+(9-0)] \\\\  & =\\frac{51\\pi }{10}.\\end{aligned}\n$$" 13194139545757 17592186576411 false] [17592186534977 1074 "First, let's make a sketch of our region.\n\n![](images/47/47b612a3e08ff24055cbffa7d53fb337f1905ec861abd3a8e535088d383162cb.png)\n\nNotice that the limits of integration are from $y=0$ to $y=1$ along the $y$-axis.\n\nTo determine which is the left and which is the right function, let's draw our horizontal arrow.  \n\n![](images/19/1927874f5eca0c18b7b61b37d0e6fac5198ec9dcf89205763e88570287330292.png)\n\nThe horizontal arrow \n\n- *enters* the region through the left function $x=\\sqrt[3]{y},$ and\n\n- *leaves* through the right function $x=3.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{0}^{1}[\\,(\\text{right function})-(\\text{left function})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}[\\,(3)-(\\sqrt[3]{y})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[3-\\sqrt[3]{y}]}^{2}\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({y}^{2/3}-6{y}^{1/3}+9)\\text{d}y \\\\  & =\\pi ({\\int }_{0}^{1}{y}^{2/3}\\,\\text{d}y-6{\\int }_{0}^{1}{y}^{1/3}\\,\\text{d}y+9{\\int }_{0}^{1}\\,\\text{d}y) \\\\  & =\\pi \\left(\\frac{3{y}^{5/3}}{5}{|}_{0}^{1}-{\\frac{9{y}^{4/3}}{2}|}_{0}^{1}+9y{|}_{0}^{1}\\right) \\\\  & =\\pi \\left[\\left(\\frac{3}{5}-0\\right)-\\left(\\frac{9}{2}-0\\right)+(9-0)\\right] \\\\  & =\\frac{51\\pi }{10}.\\end{aligned}\n$$" 13194139545757 17592186576411 true] [17592186534979 1074 "Suppose we have the series $$\n\\displaystyle {\\sum }_{n=1}^{\\infty }{a}_{n}\n$$ suc