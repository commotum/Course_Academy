}{\\left(- \\frac{5}{2}\\right)}=\\left(- \\frac{3}{2}\\right)\\frac{\\frac{9}{4}}{- \\frac{5}{2}}=\\frac{27}{20}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{5}{2},- \\frac{5}{2})}=\\left(- \\frac{3}{2}\\right)\\frac{\\left(- \\frac{5}{2}\\right)^{2}}{\\left(\\frac{5}{2}\\right)}=\\left(- \\frac{3}{2}\\right)\\frac{\\frac{25}{4}}{\\frac{5}{2}}=- \\frac{15}{4}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{7}{2},- \\frac{5}{2})}=\\left(- \\frac{3}{2}\\right)\\frac{\\left(- \\frac{5}{2}\\right)^{2}}{\\left(\\frac{7}{2}\\right)}=\\left(- \\frac{3}{2}\\right)\\frac{\\frac{25}{4}}{\\frac{7}{2}}=- \\frac{75}{28}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/2e/2e0a934b40d6ff2955cdbb9d4af2e5bf834ea59c13a212ccd128ffb04f2663e2.png)"} {:db/id #edb/ref 17592186526341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a901d5-ca4f-5737-bade-9a3f95e9fcd3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/93/93ca31dd0832f9b09274e8357adfb1b27cefac07efc2ea1fdae1cadff7fa3b69.png" :db/id #edb/ref 17592186526301} {:answer/id #uuid "2c0977f8-8622-51a6-88a6-3fc7164c99ad" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d8/d8014fb86ea2854bf8184fb5aa805fe0b6d3e1a8261622bbf6f5f619a8ce1ed2.png" :db/id #edb/ref 17592186526315} {:answer/id #uuid "4390a21d-ba70-57a9-93e0-edfc65e04c1e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3d/3d41555957cd320f3631109842e318bb713699b0dcebc428f4fd644675c807a2.png" :db/id #edb/ref 17592186526324} {:answer/id #uuid "8d4f1112-d5b0-57c6-92ab-ecb8479ec106" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9d/9d155a396810956274ddd882f0936851ff5cb5d8fce675323359f44b77e118d8.png" :db/id #edb/ref 17592186526339} {:answer/id #uuid "cd1aa56d-e965-583f-a3e3-be8c7e709980" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/be/bed3530863181b65d9203e422502eabdffeb7edfb9a1d6ceff0f650024825ed5.png" :db/id #edb/ref 17592186526352}] :answer-field/correct {:db/id #edb/ref 17592186526352} :answer-field/id #uuid "9a818083-44bf-57bd-b9d9-d68d87092f62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186526343}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "997fd844-921f-59ba-966d-0ef1a0054bf4" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\left(- \\frac{3}{2}\\right)x^{2}-(-2)y^{2}?\n$$" :question/retired true :question/worked-solution "We have to sketch the slope field at the points $(- \\frac{1}{2},- \\frac{7}{2})$,$(- \\frac{1}{2},\\frac{1}{2})$,$(- \\frac{7}{2},\\frac{1}{2})$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{1}{2},- \\frac{7}{2})}=\\left(- \\frac{3}{2}\\right)\\left(- \\frac{1}{2}\\right)^{2}-(-2)\\left(- \\frac{7}{2}\\right)^{2}=- \\frac{3}{8}-\\left(- \\frac{49}{2}\\right)=\\frac{193}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{1}{2},\\frac{1}{2})}=\\left(- \\frac{3}{2}\\right)\\left(- \\frac{1}{2}\\right)^{2}-(-2)\\left(\\frac{1}{2}\\right)^{2}=- \\frac{3}{8}-\\left(- \\frac{1}{2}\\right)=\\frac{1}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{7}{2},\\frac{1}{2})}=\\left(- \\frac{3}{2}\\right)\\left(- \\frac{7}{2}\\right)^{2}-(-2)\\left(\\frac{1}{2}\\right)^{2}=- \\frac{147}{8}-\\left(- \\frac{1}{2}\\right)=- \\frac{143}{8}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/be/bed3530863181b65d9203e422502eabdffeb7edfb9a1d6ceff0f650024825ed5.png)"} {:db/id #edb/ref 17592186526385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c435b2-8b4b-52dc-aa07-5619c250e68e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{2}-y^{2}=\\frac{121}{4}" :db/id #edb/ref 17592186526379} {:answer/id #uuid "7f4e14c2-2018-5557-b5ae-6da902977c99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{2}+y^{2}=\\frac{121}{4}" :db/id #edb/ref 17592186526380} {:answer/id #uuid "b5c4c55a-37ab-5244-9e53-604e66dac006" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{2}+y^{2}=\\frac{\\sqrt{22}}{2}" :db/id #edb/ref 17592186526382} {:answer/id #uuid "d32cc603-e58c-5b00-a8b9-0a073ffc01e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{2}+y^{2}=\\frac{11}{2}" :db/id #edb/ref 17592186526383} {:answer/id #uuid "d97f9dc5-21b6-5ee0-a46c-0f9f54098a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{2}-y^{2}=\\frac{11}{2}" :db/id #edb/ref 17592186526384}] :answer-field/correct {:db/id #edb/ref 17592186526380} :answer-field/id #uuid "ad8a1cf2-3368-5b81-80d2-fd8f9646b9dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186526381}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eaf5e3f7-8e64-5b18-999b-2cd25904a7b4" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=\\frac{11}{2}\\cos\\theta,\\quad y=\\frac{11}{2}\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta.$ We can do this using the Pythagorean identity:\n\n$$\\cos^2\\theta+\\sin^2\\theta=1.$$\n\nBy squaring the $x$-equation, we get\n\n$$\\begin{aligned}x&=\\frac{11}{2}\\cos\\theta\\\\x^2&=(\\frac{11}{2}\\cos\\theta)^2\\\\&=\\frac{121}{4}\\cos^2\\theta.\\end{aligned}$$\n\nBy squaring the $y$-equation, we get\n\n$$\\begin{aligned}y&=\\frac{11}{2}\\sin\\theta\\\\y^2&=(\\frac{11}{2}\\sin\\theta)^2\\\\&=\\frac{121}{4}\\sin^2\\theta.\\end{aligned}$$\n\nAdding the two equations and using the identity, we get\n\n$$\\begin{aligned}x^2+y^2&=\\frac{121}{4}\\cos^2\\theta+\\frac{121}{4}\\sin^2\\theta\\\\&=\\frac{121}{4}(\\cos^2\\theta+\\sin^2\\theta)\\\\&=\\frac{121}{4}(1)\\\\&=\\frac{121}{4}.\\end{aligned}$$\n\nTherefore the Cartesian equation is $x^{2}+y^{2}=\\frac{121}{4}.$"} {:answer/id #uuid "080f383a-cad7-506e-98f6-a6105a463e73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{w}-\\frac{1}{z})(\\frac{4}{{w}^{2}}-\\frac{2}{wz}+\\frac{1}{{z}^{2}})" :db/id #edb/ref 17592186526519} {:answer/id #uuid "1e1dd07c-e585-5339-8d34-c067ab9d0124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{4}-1)(\\frac{{u}^{2}}{2}+u+1)" :db/id #edb/ref 17592186526565} {:answer/id #uuid "1f2f5fad-489c-5ef2-abc8-2ead566193c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{w}-\\frac{2}{z})(\\frac{1}{{w}^{2}}+\\frac{2}{wz}+\\frac{4}{{z}^{2}})" :db/id #edb/ref 17592186526571} {:answer/id #uuid "3386a987-4784-5171-a2e1-094255e1eb0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{2}+1)(\\frac{{u}^{2}}{4}-\\frac{u}{2}+1)" :db/id #edb/ref 17592186526601} {:answer/id #uuid "4982dc80-f4cf-5d3a-be46-4ba2743eda41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{4}+1)(\\frac{{u}^{2}}{2}-u+1)" :db/id #edb/ref 17592186526649} {:answer/id #uuid "74bc0359-d645-51ed-8e8a-283c5a90cded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{2}-1)(\\frac{{u}^{2}}{4}+\\frac{u}{2}+1)" :db/id #edb/ref 17592186526731} {:answer/id #uuid "76707eb8-870b-5c30-8e98-237eddb6e483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{w}+\\frac{1}{{z}^{3}})(\\frac{4}{{w}^{2}}-\\frac{2}{w{z}^{3}}+\\frac{1}{{z}^{6}})" :db/id #edb/ref 17592186526735} {:answer/id #uuid "7bd1b9a5-c274-5960-8128-6e38205fa037" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{w}+\\frac{2}{{z}^{3}})(\\frac{1}{{w}^{2}}-\\frac{2}{w{z}^{3}}+\\frac{4}{{z}^{6}})" :db/id #edb/ref 17592186526746} {:answer/id #uuid "7d464a43-e7cc-5052-8183-f2ac55c0f667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{2}-1)(\\frac{{u}^{2}}{2}+u+1)" :db/id #edb/ref 17592186526748} {:answer/id #uuid "8121d101-b037-5fe7-a7e1-a87bb7b493b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{w}-\\frac{1}{{z}^{3}})(\\frac{4}{{w}^{2}}+\\frac{2}{w{z}^{3}}+\\frac{1}{{z}^{6}})" :db/id #edb/ref 17592186526760} {:db/id #edb/ref 17592186527124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac8b5d3-4035-5dd3-a5dd-ebf6500b19f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2y}{y+1}" :db/id #edb/ref 17592186526526} {:answer/id #uuid "1319139a-d5dc-5725-94ac-d3880fa8552c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2y" :db/id #edb/ref 17592186526540} {:answer/id #uuid "39126990-5fa4-5f41-bc2f-d291064aff94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}" :db/id #edb/ref 17592186526610} {:answer/id #uuid "94939d5f-6f1b-5dd9-ac7a-3a24e4324e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-y" :db/id #edb/ref 17592186526793} {:answer/id #uuid "9fe28192-dd92-5dbb-b0a6-33f806a9c962" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y" :db/id #edb/ref 17592186526811}] :answer-field/correct {:db/id #edb/ref 17592186526811} :answer-field/id #uuid "021bcd34-e94e-5e91-97f6-6e6c378cff60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527013}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "02209bdf-5c25-5d71-9f0c-90055349806b" :question/math-academy-id "q-159335" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}0, & x<1\\,\\text{or}\\,y<0 \\\\ \\frac{xy-y}{x}, & x\\ge 1,\\,0\\le y\\le 1 \\\\ {F}_{X}(x), & x\\ge 1,\\,y>1.\\end{aligned}\\right.\n$$\n\nFind ${F}_{Y}(y),$ the marginal CDF of $Y,$ for $0\\le y\\le 1.$" :question/worked-solution "The marginal CDF of $Y$ is given by\n\n$$\n{F}_{Y}(y)=F(\\infty ,y)=\\lim_{x\\to \\infty }F(x,y).\n$$\n\nTherefore, for $0\\le y\\le 1,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =\\lim_{x\\to \\infty }\\left(\\frac{xy-y}{x}\\right) \\\\  & =\\lim_{x\\to \\infty }\\left(\\frac{y(x-1)}{x}\\right) \\\\  & =y\\lim_{x\\to \\infty }(1-\\frac{1}{x}) \\\\  & =y\\lim_{x\\to \\infty }(1-0) \\\\  & =y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "717d95b7-fa98-5ce7-87da-3b5f14244fb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}x{y}^{1/2}" :db/id #edb/ref 17592186526722} {:answer/id #uuid "85f0574f-2eb3-5a2e-a9b4-0e626bc0fe9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}{x}^{2}{y}^{1/2}" :db/id #edb/ref 17592186526771} {:answer/id #uuid "8ad206e5-9b08-5529-8514-60481a8f3392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}{y}^{5/2}" :db/id #edb/ref 17592186526781} {:answer/id #uuid "a5562678-6941-5fda-a0d2-04f3395f2ed7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}{x}^{3}{y}^{3/2}" :db/id #edb/ref 17592186526819} {:answer/id #uuid "da74a110-efe7-5877-a2c6-a01a07f76757" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}x{y}^{3/2}" :db/id #edb/ref 17592186526924}] :answer-field/correct {:db/id #edb/ref 17592186526722} :answer-field/id #uuid "135ebc58-1d65-54f4-8dbd-b35d2b714a66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527021}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2603d8b7-b055-59f9-a9de-a5bcf92cb12b" :question/math-academy-id "q-159330" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}0, & x<0\\,\\text{or}\\,y<0 \\\\ \\frac{1}{4}{x}^{2}{y}^{3/2}, & 0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ {F}_{X}(x), & 0\\le x\\le 2,\\,y>1 \\\\ {F}_{Y}(y), & x>2,\\,0\\le y\\le 1 \\\\ 1, & x>2,\\,y>1.\\end{aligned}\\right.\n$$\n\nwhere ${F}_{X}$ and ${F}_{Y}$ are the marginal CDFs of $X$ and $Y,$ respectively. Find the joint PDF $f(x,y)$ for $0\\le x\\le 2$ and $0\\le y\\le 1.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is determined by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $0\\le x\\le 2$ and $0\\le y\\le 1,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}(\\frac{1}{4}{x}^{2}{y}^{3/2})) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{4}{x}^{2}\\cdot \\frac{∂}{∂y}({y}^{3/2})) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{4}{x}^{2}\\cdot \\frac{3}{2}{y}^{1/2}) \\\\  & =\\frac{3}{8}{y}^{1/2}\\cdot \\frac{∂}{∂x}({x}^{2}) \\\\  & =\\frac{3}{8}{y}^{1/2}\\cdot 2x \\\\  & =\\frac{3}{4}x{y}^{1/2}.\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\nTherefore, we have\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{3}{4}x{y}^{1/2}, & 0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186527146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0048806c-59ec-5b54-9603-d1aea47812e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3159" :db/id #edb/ref 17592186526496} {:answer/id #uuid "654e6669-1c8f-5b7c-9105-507f8fec4f7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3413" :db/id #edb/ref 17592186526706} {:answer/id #uuid "7e5e4424-4f3f-57f4-b362-4a5859daccd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3212" :db/id #edb/ref 17592186526751} {:answer/id #uuid "b98dc844-9500-5f8d-b857-bb196f769cd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3461" :db/id #edb/ref 17592186526856} {:answer/id #uuid "e03cd40f-b9b7-5e51-8c05-cf33954b77fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3665" :db/id #edb/ref 17592186526941}] :answer-field/correct {:db/id #edb/ref 17592186526706} :answer-field/id #uuid "9e93d9e4-a205-5e33-a4db-5e5a5cd44ab1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527080}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2f85c49f-b8cd-5032-99b8-bc70560e429d" :question/math-academy-id "q-143507" :question/problem "Let ${X}_{1},{X}_{2},…,{X}_{75}$ be a random sample of size $n=75$ from a population with probability density function \n\n$$\nf(x)=\\left\\{\\begin{aligned}\\frac{3}{{x}^{4}}, & x\\ge 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nGiven that the population variance ${\\sigma }^{2}=0.75,$ calculate $P(1.5<\\overset{―}{X}<1.6).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.9\\,$ | $\\,0.8159\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ |\n| $\\,1.0\\,$ | $\\,0.8413\\,$ | $\\,0.8438\\,$ | $\\,0.8461\\,$ |\n| $\\,1.1\\,$ | $\\,0.8643\\,$ | $\\,0.8665\\,$ | $\\,0.8686\\,$ |" :question/worked-solution "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case:\n\n- the sample size is\n\n$$\n\\begin{aligned}n & =75,\\end{aligned}\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\int }_{-\\infty }^{\\infty }x\\,f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }x\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & =\\lim_{b\\to \\infty }{\\int }_{1}^{b}\\frac{3}{{x}^{3}}\\,\\text{d}x \\\\  & =\\lim_{b\\to \\infty }{[-\\frac{3}{2{x}^{2}}]}_{1}^{b} \\\\  & =\\lim_{b\\to \\infty }[\\frac{3}{2}-\\frac{3}{2{b}^{2}}] \\\\  & =\\frac{3}{2} \\\\  & =1.5,\\end{aligned}\n$$\n\n- the population variance is ${\\sigma }^{2}=0.75.$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(1.5,\\frac{0.75}{75}) \\\\  & ∼N(1.5,0.01).\\end{aligned}\n$$\n\nWe want to find $P(1.5<\\overset{―}{X}<1.6).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(1.5<\\overset{―}{X}<1.6) & =P(\\frac{1.5-1.5}{\\sqrt{0.01}}<Z<\\frac{1.6-1.5}{\\sqrt{0.01}}) \\\\  & =P(0<Z<1) \\\\  & =P(Z<1)-P(Z<0) \\\\  & =Φ(1)-Φ(0)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\nΦ(1)=0.8413,\n$$\n\nand by the symmetry of the normal distribution, $Φ(0)=0.5.$ Therefore,\n\n$$\n\\begin{aligned}P(1.5<\\overset{―}{X}<1.6) & =Φ(1)-Φ(0) \\\\  & =0.8413-0.5 \\\\  & =0.3413.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f14ebf1-a6a5-5a1c-bceb-b94a30140ab2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{2}{\\sqrt{x}}-2{e}^{1-y}+\\frac{{e}^{1-y}}{\\sqrt{x}}" :db/id #edb/ref 17592186526570} {:answer/id #uuid "88fdae8b-27cd-5d83-8742-cb8138b1a6f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{1}{\\sqrt{x}}-{e}^{1-y}" :db/id #edb/ref 17592186526776} {:answer/id #uuid "c717cb6b-8e7f-518f-9495-eec458502f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\frac{{e}^{1-y}}{\\sqrt{x}}" :db/id #edb/ref 17592186526885} {:answer/id #uuid "e402e686-3ff6-5db1-a2cc-d914d442a9da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{{e}^{1-y}}{\\sqrt{x}}" :db/id #edb/ref 17592186526951} {:answer/id #uuid "e95e6242-3b0b-565c-aa1a-1ac96cd9dddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{1}{\\sqrt{x}}-{e}^{1-y}+\\frac{{e}^{1-y}}{\\sqrt{x}}" :db/id #edb/ref 17592186526965}] :answer-field/correct {:db/id #edb/ref 17592186526965} :answer-field/id #uuid "4808f553-7313-53e6-9c9a-a373717e5764" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527049}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a66a770-559e-57c4-8545-74993f2211db" :question/math-academy-id "q-159320" :question/problem "The marginal CDFs of two continuous independent random variables $X$ and $Y$ are given below. \n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}1-\\frac{1}{\\sqrt{x}}, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\,\\,{F}_{Y}(y)=\\left\\{\\begin{aligned}1-{e}^{1-y}, & y\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\n$$\n\nFind the expression for the joint CDF when $x\\ge 1$ and $y\\ge 1.$" :question/worked-solution "If $X$ and $Y$ are independent continuous random variables with marginal CDFs ${F}_{X}(x)$ and ${F}_{Y}(y),$ respectively, then the corresponding joint CDF of $F(x,y)$ is given by\n\n$$\nF(x,y)={F}_{X}(x)\\cdot {F}_{Y}(y).\n$$\n\nTherefore, for $x\\ge 1$ and $y\\ge 1,$ the joint CDF for our random variables is \n\n$$\n\\begin{aligned}F(x,y) & ={F}_{X}(x)\\cdot {F}_{Y}(y) \\\\  & =(1-\\frac{1}{\\sqrt{x}})(1-{e}^{1-y}) \\\\  & =1-\\frac{1}{\\sqrt{x}}-{e}^{1-y}+\\frac{{e}^{1-y}}{\\sqrt{x}}.\\end{aligned}\n$$\n\nTherefore, the full expression for the joint CDF is\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}1-\\frac{1}{\\sqrt{x}}-{e}^{1-y}+\\frac{{e}^{1-y}}{\\sqrt{x}}, & x\\ge 1,\\,y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186527158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca9b839-cb5a-5b4b-bc58-e09b93f3700e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{24}(x+y)" :db/id #edb/ref 17592186526528} {:answer/id #uuid "18bd9257-411d-5063-94ed-ecd8343134ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}({x}^{2}+{y}^{2})" :db/id #edb/ref 17592186526556} {:answer/id #uuid "3fcd8e4f-e442-55ec-acdd-e2642ab81430" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}(x+y)" :db/id #edb/ref 17592186526628} {:answer/id #uuid "a0127b97-00fd-5391-a92c-e6076c707eb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{24}({x}^{2}+{y}^{2})" :db/id #edb/ref 17592186526813} {:answer/id #uuid "cdab7955-73b1-53f6-a3ff-c803c784a336" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{16}x(x+y)" :db/id #edb/ref 17592186526896}] :answer-field/correct {:db/id #edb/ref 17592186526528} :answer-field/id #uuid "e29738f2-3cd0-58f4-93b4-014da2a887b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527110}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "433f0ce6-f1e1-52cc-bff5-350654ecc1ba" :question/math-academy-id "q-159327" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}0, & x<0\\,\\text{or}\\,y<0 \\\\ \\frac{1}{48}xy(x+y), & 0\\le x\\le 2,\\,0\\le y\\le 4 \\\\ {F}_{X}(x), & 0\\le x\\le 2,\\,y>4 \\\\ {F}_{Y}(y), & x>2,\\,0\\le y\\le 4 \\\\ 1, & x>2,\\,y>4.\\end{aligned}\\right.\n$$\n\nwhere ${F}_{X}$ and ${F}_{Y}$ are the marginal CDFs of $X$ and $Y,$ respectively. Find the joint PDF $f(x,y)$ for $0\\le x\\le 2$ and $0\\le y\\le 4.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is determined by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $0\\le x\\le 2$ and $0\\le y\\le 4,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}(\\frac{1}{48}xy(x+y))) \\\\  & =\\frac{1}{48}\\cdot \\frac{∂}{∂x}(\\frac{∂}{∂y}({x}^{2}y+x{y}^{2})) \\\\  & =\\frac{1}{48}\\cdot \\frac{∂}{∂x}({x}^{2}\\frac{∂}{∂y}(y)+x\\frac{∂}{∂y}({y}^{2})) \\\\  & =\\frac{1}{48}\\cdot \\frac{∂}{∂x}({x}^{2}+2xy) \\\\  & =\\frac{1}{48}\\cdot (\\frac{∂}{∂x}({x}^{2})+2y\\frac{∂}{∂x}(x)) \\\\  & =\\frac{1}{48}(2x+2y) \\\\  & =\\frac{1}{24}(x+y).\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\nTherefore, we have\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{24}(x+y), & 0\\le x\\le 2,\\,0\\le y\\le 4 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186527159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189c31de-c0e9-57cf-bbac-10e821864de1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡y" :db/id #edb/ref 17592186526555} {:answer/id #uuid "3f5f67cd-f071-54d3-9386-f77655d8f0ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}(1+\\operatorname{sin}⁡y-\\operatorname{cos}⁡y)" :db/id #edb/ref 17592186526625} {:answer/id #uuid "72442ffc-e56c-5203-94fd-73282d5c88c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡y" :db/id #edb/ref 17592186526726} {:answer/id #uuid "de7e8486-049c-55a6-a95e-c6f6f07266c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}(2+\\operatorname{sin}⁡y)" :db/id #edb/ref 17592186526937} {:answer/id #uuid "f23d80ed-0301-53e6-88a5-ad22e0c8f2a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}(2-\\operatorname{cos}⁡y)" :db/id #edb/ref 17592186526979}] :answer-field/correct {:db/id #edb/ref 17592186526625} :answer-field/id #uuid "39cb31e5-27ee-572d-af4c-9fd41cce71e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527038}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "449c39ae-346f-5e58-9576-63532dc73237" :question/math-academy-id "q-159347" :question/problem "The joint CDF of two continuous random variables $X$ and $Y,$ for $$\n\\displaystyle (x,y)\\in [0,\\frac{\\pi }{2}]\\times [0,\\frac{\\pi }{2}],\n$$ is given by\n\n$$\nF(x,y)=\\frac{1}{2}(\\operatorname{sin}⁡x+\\operatorname{sin}⁡y-\\operatorname{sin}⁡(x+y)).\n$$\n\nFind ${F}_{Y}(y),$ the marginal CDF of $Y,$ for $0\\le y\\le \\frac{\\pi }{2}.$" :question/worked-solution "The marginal CDF of $X$ is given by\n\n$$\n{F}_{Y}(y)=F(\\infty ,y)=\\lim_{x\\to \\infty }F(x,y).\n$$\n\nTherefore, for $0\\le y\\le \\frac{\\pi }{2},$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =F(\\infty ,y) \\\\  & =F(\\frac{\\pi }{2},y) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡\\frac{\\pi }{2}+\\operatorname{sin}⁡y-\\operatorname{sin}⁡(\\frac{\\pi }{2}+y)) \\\\  & =\\frac{1}{2}(1+\\operatorname{sin}⁡y-\\operatorname{sin}⁡(\\frac{\\pi }{2}+y)) \\\\  & =\\frac{1}{2}(1+\\operatorname{sin}⁡y-\\operatorname{cos}⁡y)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096fe8eb-0f73-5dcd-9283-5609e6cf6c6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{x{y}^{2}}" :db/id #edb/ref 17592186526521} {:answer/id #uuid "1f7b246b-a91d-5397-9b3e-492593bcf3f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{x}^{2}{y}^{3}}" :db/id #edb/ref 17592186526572} {:answer/id #uuid "9ffd77dc-caa5-5a7b-9077-2effd6a99afc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{{x}^{2}{y}^{3}}" :db/id #edb/ref 17592186526812} {:answer/id #uuid "c936279a-3486-5ccb-b9e0-fffe1ccea34f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x{y}^{2}}" :db/id #edb/ref 17592186526891} {:answer/id #uuid "f30d0020-1a54-5639-ab8d-73a8529f890a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{{x}^{3}{y}^{4}}" :db/id #edb/ref 17592186526984}] :answer-field/correct {:db/id #edb/ref 17592186526812} :answer-field/id #uuid "20ab855f-f5a7-5070-a185-6c452a9551a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527024}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74fc0efc-8b80-569c-9c95-98f9405e5eca" :question/math-academy-id "q-159311" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}\\frac{(x-2)({y}^{2}-1)}{x{y}^{2}}, & x\\ge 2,\\,y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind the joint PDF $f(x,y)$ for $x\\ge 2,\\,y\\ge 1.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is given by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $x\\ge 2$ and $y\\ge 1,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}\\left(\\frac{(x-2)({y}^{2}-1)}{x{y}^{2}}\\right)) \\\\  & =\\frac{∂}{∂x}(\\frac{x-2}{x}\\cdot \\frac{∂}{∂y}(1-\\frac{1}{{y}^{2}})) \\\\  & =\\frac{∂}{∂x}(\\frac{x-2}{x}\\cdot \\frac{2}{{y}^{3}}) \\\\  & =\\frac{2}{{y}^{3}}\\cdot \\frac{∂}{∂x}(1-\\frac{2}{x}) \\\\  & =\\frac{2}{{y}^{3}}\\cdot \\frac{2}{{x}^{2}} \\\\  & =\\frac{4}{{x}^{2}{y}^{3}}.\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\n\nTherefore, we have\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{4}{{x}^{2}{y}^{3}}, & x\\ge 2,\\,y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186527186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48289cb0-2db9-541c-ba9b-d4327439a579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186526645} {:answer/id #uuid "626f8019-c00b-5e2b-9eae-917eb16fcd3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186526700} {:answer/id #uuid "77cd1431-7dea-5816-88cc-589a8ce57085" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186526737} {:answer/id #uuid "ce683808-6c11-54ae-bb49-f99568096871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186526898} {:answer/id #uuid "ee5a9688-f2d5-553e-872b-13b2824acaba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186526973}] :answer-field/correct {:db/id #edb/ref 17592186526645} :answer-field/id #uuid "92fcb5de-d0cd-5bb2-911a-0615ed463dd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527075}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9a19ca23-6c60-5d6e-8799-38d55529cc16" :question/math-academy-id "q-143871" :question/problem "Find $\\text{E}[{(X+Y)}^{2}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{4},\\, & y\\le x\\le 4-y,\\,0\\le y\\le 2; \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=(x+y)^{2}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,y\\le x\\le 4-y,\\,0\\le y\\le 2\\},$ where $f(x,y)$ is nonzero.\n\n![](images/8d/8d1935944ffa0017da736fc540ff823df8a052c2c32c985553cde08ea5fce8da.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{(X+Y)}^{2}] & ={∬}_{{R}^{2}}(x+y)^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}(x+y)^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{y}^{4-y}(x+y)^{2}\\cdot \\frac{1}{4}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}{[\\frac{1}{3}(x+y)^{3}]}_{x=y}^{x=4-y}\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}[\\frac{1}{3}(4-y+y)^{3}-\\frac{1}{3}(y+y)^{3}]\\,\\text{d}y \\\\  & =\\frac{1}{12}{\\int }_{0}^{2}({4}^{3}-(2y)^{3})\\,\\text{d}y \\\\  & =\\frac{1}{12}{\\int }_{0}^{2}(64-8{y}^{3})\\,\\text{d}y \\\\  & =\\frac{1}{12}{[64y-2{y}^{4}]}_{y=0}^{y=2} \\\\  & =\\frac{1}{12}(128-32) \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87807497-9d16-516b-a885-3af2d03156ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "430\\,\\text{N}" :db/id #edb/ref 17592186526773} {:answer/id #uuid "8965d7e6-0eda-5e94-9abc-17673bfc7c7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "612\\,\\text{N}" :db/id #edb/ref 17592186526779} {:answer/id #uuid "9653eea3-31da-5fdd-992a-434023dc2787" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "511\\,\\text{N}" :db/id #edb/ref 17592186526796} {:answer/id #uuid "beccc26a-d2bc-5b22-9004-128752f9150f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "491\\,\\text{N}" :db/id #edb/ref 17592186526868} {:answer/id #uuid "c6aedca6-99db-59f9-95e2-e9fdad4e753f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "575\\,\\text{N}" :db/id #edb/ref 17592186526883}] :answer-field/correct {:db/id #edb/ref 17592186526883} :answer-field/id #uuid "31c651ea-1589-526b-91c7-bd4b6db7a166" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527029}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ac6c0c1f-be4b-5795-8838-93be63fc1a08" :question/math-academy-id "q-139125" :question/problem "The displacement $r,$ in meters, of a particle $P$ of mass $3\\,\\text{kg}$ is given by\n\n$$\nr=⟨{t}^{3},\\,{t}^{4}-{t}^{2}⟩,\n$$\n\nwhere $t>0$ is the time in seconds. Calculate the magnitude of the resultant force acting on the particle when $t=4\\,\\text{s}.$ Round your final answer to the nearest Newton." :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{4}-{t}^{2})⟩ \\\\  & =⟨3{t}^{2},\\,4{t}^{3}-2t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-2t)⟩ \\\\  & =⟨6t,\\,12{t}^{2}-2⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =3\\cdot ⟨6t,\\,12{t}^{2}-2⟩ \\\\  & =⟨18t,\\,36{t}^{2}-6⟩.\\end{aligned}\n$$\n\nWhen $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =⟨18(4),\\,36({4}^{2})-6⟩ \\\\  & =⟨72,\\,570⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(4)$ is given by\n\n$$\n\\begin{aligned}|F(4)| & =\\sqrt{(72)^{2}+{(570)}^{2}} \\\\  & ≈575\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton."} {:db/id #edb/ref 17592186527204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3de31675-bc76-555b-9da6-89ac30830000" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{215}^{∘}" :db/id #edb/ref 17592186526620} {:answer/id #uuid "445205a4-1ab3-560d-a8b3-93a2255a869b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{240}^{∘}" :db/id #edb/ref 17592186526634} {:answer/id #uuid "56d28aad-8782-5c87-aca9-e51ba344d3aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{225}^{∘}" :db/id #edb/ref 17592186526680} {:answer/id #uuid "a6f77e82-19ee-5840-97b8-39b65196ac3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{220}^{∘}" :db/id #edb/ref 17592186526823} {:answer/id #uuid "f4be7806-8136-5f6c-86c3-4b86a43642ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{230}^{∘}" :db/id #edb/ref 17592186526988}] :answer-field/correct {:db/id #edb/ref 17592186526680} :answer-field/id #uuid "12987a6c-aa03-52c4-b21a-1cc9b7be360a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527020}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ba6b8db9-c5f9-50b9-8e8a-d50f12658a32" :question/math-academy-id "q-34277" :question/problem "![](images/1b/1bc441dcf36de00672be1ac0ff5004e25ffb04d64788a86df3c849da0600794a.png)\n\nGiven that the point $A$ has coordinates $(-\\frac{5}{4},-\\frac{5}{4}),$ calculate the angle $\\theta .$" :question/worked-solution "We can form a triangle by creating a vertical line from $A$ to the $x$-axis. Let us call ${\\theta }^{′}$ the acute angle that is formed with the $x$-axis such that ${\\theta }^{′}+{180}^{∘}=\\theta $\n\n![](images/e3/e3abf66be20a5ab3ed5d0b8812b127d6336cb88f8369937d415c8918d020e45e.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\operatorname{tan}⁡{\\theta }^{′}=\\frac{\\left(\\frac{5}{4}\\right)}{\\left(\\frac{5}{4}\\right)}=1.\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n{\\theta }^{′}=\\operatorname{arctan}⁡1={45}^{∘}.\n$$\n\nFinally, using $\\theta ={\\theta }^{′}+{180}^{∘},$ we get $\\theta ={45}^{∘}+{180}^{∘}={225}^{∘}.$"} {:db/id #edb/ref 17592186527217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0094f649-619d-53d4-bd4a-599974a79f65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186526499} {:answer/id #uuid "0b87866d-7ca3-5ffe-9bf1-7ca2dbed6087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186526527} {:answer/id #uuid "617c7900-1787-5067-bf53-b914ea33d964" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186526697} {:answer/id #uuid "88871071-0592-5a72-9ee4-9896fb71c1b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186526774} {:answer/id #uuid "d153fc31-a51b-5ff0-a56d-5400a28d1dca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186526906}] :answer-field/correct {:db/id #edb/ref 17592186526906} :answer-field/id #uuid "4a370ffb-9f03-59b2-ac60-62d599bab917" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da99206a-ee96-54b9-a8bb-1c95438c5559" :question/math-academy-id "q-143850" :question/problem "Find $\\text{E}[4(X-1)],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{3}{4},\\, & 1\\le x\\le 2,\\,1\\le y\\le {x}^{2}; \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=4(x-1).\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,1\\le x\\le 2,\\,1\\le y\\le {x}^{2}\\},$ where $f(x,y)$ is nonzero.\n\n![](images/bd/bd8d2d36a0fe570e6ccdb096c6c39bc9c9edeed9b008dada504801025055438f.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[4(X-1)] & ={∬}_{{R}^{2}}4(x-1)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}4(x-1)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{{x}^{2}}4(x-1)\\cdot \\frac{3}{4}\\,\\text{d}y\\,\\text{d}x \\\\  & =3{\\int }_{1}^{2}(x-1){\\int }_{1}^{{x}^{2}}\\,\\text{d}y\\,\\text{d}x \\\\  & =3{\\int }_{1}^{2}(x-1)[y]_{y=1}^{y={x}^{2}}\\,\\text{d}x \\\\  & =3{\\int }_{1}^{2}(x-1)({x}^{2}-1)\\text{d}x \\\\  & =3{\\int }_{1}^{2}({x}^{3}-{x}^{2}-x+1)\\text{d}x \\\\  & =3{[\\frac{1}{4}{x}^{4}-\\frac{1}{3}{x}^{3}-\\frac{1}{2}{x}^{2}+x]}_{x=1}^{x=2} \\\\  & =3[(4-\\frac{8}{3}-2+2)-(\\frac{1}{4}-\\frac{1}{3}-\\frac{1}{2}+1)] \\\\  & =3(\\frac{4}{3}-\\frac{5}{12}) \\\\  & =\\frac{11}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ac938f-f798-5038-bab5-fa297deba0a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{16}{{x}^{4}}-\\frac{8}{{y}^{3}}" :db/id #edb/ref 17592186526502} {:answer/id #uuid "03d36e20-40e6-5b80-9c0d-67f894b58f3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{24}{{x}^{4}{y}^{3}}" :db/id #edb/ref 17592186526509} {:answer/id #uuid "254d8e8c-0380-5000-b8d0-a054397414b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{16}{{x}^{4}}-\\frac{8}{{y}^{3}}+\\frac{24}{{x}^{4}{y}^{3}}" :db/id #edb/ref 17592186526585} {:answer/id #uuid "b225b894-490f-581e-bce4-4a2a39058d58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{16}{{x}^{4}}-\\frac{8}{{y}^{3}}+\\frac{128}{{x}^{4}{y}^{3}}" :db/id #edb/ref 17592186526843} {:answer/id #uuid "e29f4e96-d27a-5c57-bc4c-2abd5d1dceda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{128}{{x}^{4}{y}^{3}}" :db/id #edb/ref 17592186526946}] :answer-field/correct {:db/id #edb/ref 17592186526843} :answer-field/id #uuid "35729131-6ecd-51d1-af5b-b92e2a8eb812" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527035}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e1859419-9341-5ec9-877c-8ef2835f890f" :question/math-academy-id "q-159323" :question/problem "The marginal CDFs of two continuous independent random variables $X$ and $Y$ are given below. \n\n$$\n{F}_{X}(x)=\\left\\{\\begin{aligned}1-\\frac{16}{{x}^{4}}, & x\\ge 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\,\\,{F}_{Y}(y)=\\left\\{\\begin{aligned}1-\\frac{8}{{y}^{3}}, & y\\ge 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\n$$\n\nFind the expression for the joint CDF when $x\\ge 2$ and $y\\ge 2.$" :question/worked-solution "If $X$ and $Y$ are independent continuous random variables with marginal CDFs ${F}_{X}(x)$ and ${F}_{Y}(y),$ respectively, then the corresponding joint CDF of $F(x,y)$ is given by\n\n$$\nF(x,y)={F}_{X}(x)\\cdot {F}_{Y}(y).\n$$\n\nTherefore, for $x\\ge 2$ and $y\\ge 2,$ the joint CDF for our random variables is \n\n$$\n\\begin{aligned}F(x,y) & ={F}_{X}(x)\\cdot {F}_{Y}(y) \\\\  & =(1-\\frac{16}{{x}^{4}})(1-\\frac{8}{{y}^{3}}) \\\\  & =1-\\frac{16}{{x}^{4}}-\\frac{8}{{y}^{3}}+\\frac{128}{{x}^{4}{y}^{3}}.\\end{aligned}\n$$\n\nTherefore, the full expression for the joint CDF is\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}1-\\frac{16}{{x}^{4}}-\\frac{8}{{y}^{3}}+\\frac{128}{{x}^{4}{y}^{3}}, & x\\ge 2,\\,y\\ge 2 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186527225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1dd07c-e585-5339-8d34-c067ab9d0124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{4}-1)(\\frac{{u}^{2}}{2}+u+1)" :db/id #edb/ref 17592186526565} {:answer/id #uuid "3386a987-4784-5171-a2e1-094255e1eb0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{2}+1)(\\frac{{u}^{2}}{4}-\\frac{u}{2}+1)" :db/id #edb/ref 17592186526601} {:answer/id #uuid "4982dc80-f4cf-5d3a-be46-4ba2743eda41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{4}+1)(\\frac{{u}^{2}}{2}-u+1)" :db/id #edb/ref 17592186526649} {:answer/id #uuid "74bc0359-d645-51ed-8e8a-283c5a90cded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{2}-1)(\\frac{{u}^{2}}{4}+\\frac{u}{2}+1)" :db/id #edb/ref 17592186526731} {:answer/id #uuid "7d464a43-e7cc-5052-8183-f2ac55c0f667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{u}{2}-1)(\\frac{{u}^{2}}{2}+u+1)" :db/id #edb/ref 17592186526748}] :answer-field/correct {:db/id #edb/ref 17592186526731} :answer-field/id #uuid "7bf69bfe-f49c-586d-9712-8dbc31ce7c96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee3cc387-c8ba-5e21-b6bf-54f77512a2c2" :question/math-academy-id "q-112336" :question/problem "Factor $\\frac{{u}^{3}}{8}-1.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a difference of cubes, as follows:\n\n$$\n\\frac{{u}^{3}}{8}-1={\\left(\\frac{u}{2}\\right)}^{3}-{1}^{3}\n$$\n\nNow, we factor our expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{{u}^{3}}{8}-1 & ={\\left(\\frac{u}{2}\\right)}^{3}-{1}^{3} \\\\  & =(\\frac{u}{2}-1)({\\left(\\frac{u}{2}\\right)}^{2}+\\frac{u}{2}\\cdot 1+{(1)}^{2}) \\\\  & =(\\frac{u}{2}-1)(\\frac{{u}^{2}}{4}+\\frac{u}{2}+1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080f383a-cad7-506e-98f6-a6105a463e73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{w}-\\frac{1}{z})(\\frac{4}{{w}^{2}}-\\frac{2}{wz}+\\frac{1}{{z}^{2}})" :db/id #edb/ref 17592186526519} {:answer/id #uuid "1f2f5fad-489c-5ef2-abc8-2ead566193c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{w}-\\frac{2}{z})(\\frac{1}{{w}^{2}}+\\frac{2}{wz}+\\frac{4}{{z}^{2}})" :db/id #edb/ref 17592186526571} {:answer/id #uuid "76707eb8-870b-5c30-8e98-237eddb6e483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{w}+\\frac{1}{{z}^{3}})(\\frac{4}{{w}^{2}}-\\frac{2}{w{z}^{3}}+\\frac{1}{{z}^{6}})" :db/id #edb/ref 17592186526735} {:answer/id #uuid "7bd1b9a5-c274-5960-8128-6e38205fa037" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{w}+\\frac{2}{{z}^{3}})(\\frac{1}{{w}^{2}}-\\frac{2}{w{z}^{3}}+\\frac{4}{{z}^{6}})" :db/id #edb/ref 17592186526746} {:answer/id #uuid "8121d101-b037-5fe7-a7e1-a87bb7b493b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{w}-\\frac{1}{{z}^{3}})(\\frac{4}{{w}^{2}}+\\frac{2}{w{z}^{3}}+\\frac{1}{{z}^{6}})" :db/id #edb/ref 17592186526760}] :answer-field/correct {:db/id #edb/ref 17592186526760} :answer-field/id #uuid "c8a54896-3654-52b8-b0f1-96c46cbcf220" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527099}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "efa83c70-ebda-58c7-9dc4-66acbcb8874b" :question/math-academy-id "q-112333" :question/problem "Factor $\\frac{8}{{w}^{3}}-\\frac{1}{{z}^{9}}.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a difference of cubes, as follows:\n\n$$\n\\frac{8}{{w}^{3}}-\\frac{1}{{z}^{9}}={\\left(\\frac{2}{w}\\right)}^{3}-{\\left(\\frac{1}{{z}^{3}}\\right)}^{3}\n$$\n\nNow, we factor our expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{8}{{w}^{3}}-\\frac{1}{{z}^{9}} & ={\\left(\\frac{2}{w}\\right)}^{3}-{\\left(\\frac{1}{{z}^{3}}\\right)}^{3} \\\\  & =(\\frac{2}{w}-\\frac{1}{{z}^{3}})({\\left(\\frac{2}{w}\\right)}^{2}+\\frac{2}{w}\\cdot \\frac{1}{{z}^{3}}+{\\left(\\frac{1}{{z}^{3}}\\right)}^{2}) \\\\  & =(\\frac{2}{w}-\\frac{1}{{z}^{3}})(\\frac{4}{{w}^{2}}+\\frac{2}{w{z}^{3}}+\\frac{1}{({z}^{3})^{2}}) \\\\  & =(\\frac{2}{w}-\\frac{1}{{z}^{3}})(\\frac{4}{{w}^{2}}+\\frac{2}{w{z}^{3}}+\\frac{1}{{z}^{6}})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58ac6aa4-3187-51f4-8986-37a77eb9556e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186526684} {:answer/id #uuid "67d3f414-e5a3-5a85-86ff-7be8a7d0d430" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186526708} {:answer/id #uuid "6ddc4b8b-fe6b-5cab-a0b5-82d769645de3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186526718} {:answer/id #uuid "b6768082-39bc-5d53-bad6-15fd36ca45b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186526853} {:answer/id #uuid "cfcead82-4acf-5200-8fd5-75bb552b7196" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186526901}] :answer-field/correct {:db/id #edb/ref 17592186526901} :answer-field/id #uuid "719de611-fe3d-510b-8ec3-a7dea6d0ecc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527069}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f125a564-9e7e-50c1-b77c-f6cbd0ae6169" :question/math-academy-id "q-143879" :question/problem "Find $\\text{E}[{X}^{2}+{Y}^{2}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}xy,\\, & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)={x}^{2}+{y}^{2}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+{Y}^{2}] & ={∬}_{{R}^{2}}({x}^{2}+{y}^{2})\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}({x}^{2}+{y}^{2})\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}({x}^{2}+{y}^{2})\\cdot xy\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}[{\\int }_{0}^{1}({x}^{3}y+x{y}^{3})\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{[\\frac{y{x}^{4}}{4}+\\frac{{y}^{3}{x}^{2}}{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}(\\frac{y}{4}+\\frac{{y}^{3}}{2})\\,\\text{d}y \\\\  & =[\\frac{{y}^{2}}{8}+\\frac{{y}^{4}}{8}]_{0}^{2} \\\\  & =\\frac{1}{2}+2-0 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "575f89b2-b860-5bf6-94c2-b2386d5174b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8{x}^{2}}{3{y}^{4}}" :db/id #edb/ref 17592186526682} {:answer/id #uuid "ac47ec72-2d41-5b5a-b068-bbdef9147797" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8{x}^{2}}{3{y}^{3}}" :db/id #edb/ref 17592186526834} {:answer/id #uuid "dd56e164-faac-55a7-ae60-d5adf3110db3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16{x}^{3}}{9{y}^{4}}" :db/id #edb/ref 17592186526935} {:answer/id #uuid "fa973044-c950-5daa-a2a0-d7518f5a10c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16x}{3{y}^{3}}" :db/id #edb/ref 17592186527000} {:answer/id #uuid "fe148dd0-c4b8-52c9-9a1c-2693969bc24e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4x}{9{y}^{4}}" :db/id #edb/ref 17592186527008}] :answer-field/correct {:db/id #edb/ref 17592186527000} :answer-field/id #uuid "2bb56fd2-9bf7-57d4-98c0-5fd980b76e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527025}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f97149b0-2afa-55ad-bcc3-a7b6ba9e10a4" :question/math-academy-id "q-159331" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}0, & x<0\\,\\text{or}\\,y<1 \\\\ \\frac{4{x}^{2}({y}^{2}-1)}{3{y}^{2}}, & 0\\le x\\le 1,\\,1\\le y\\le 2 \\\\ {F}_{X}(x), & 0\\le x\\le 1,\\,y>2 \\\\ {F}_{Y}(y), & x>1,\\,1\\le y\\le 2 \\\\ 1, & x>1,\\,y>2.\\end{aligned}\\right.\n$$\n\nwhere ${F}_{X}$ and ${F}_{Y}$ are the marginal CDFs of $X$ and $Y,$ respectively. Find the joint PDF $f(x,y)$ for $0\\le x\\le 1$ and $1\\le y\\le 2.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is determined by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $0\\le x\\le 1$ and $1\\le y\\le 2,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}\\left(\\frac{4{x}^{2}({y}^{2}-1)}{3{y}^{2}}\\right)) \\\\  & =\\frac{∂}{∂x}(\\frac{4}{3}{x}^{2}\\cdot \\frac{∂}{∂y}(1-\\frac{1}{{y}^{2}})) \\\\  & =\\frac{∂}{∂x}(\\frac{4}{3}{x}^{2}\\cdot \\frac{2}{{y}^{3}}) \\\\  & =\\frac{8}{3{y}^{3}}\\cdot \\frac{∂}{∂x}({x}^{2}) \\\\  & =\\frac{8}{3{y}^{3}}\\cdot 2x \\\\  & =\\frac{16x}{3{y}^{3}}.\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\nTherefore, we have\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{16x}{3{y}^{3}}, & 0\\le x\\le 1,\\,1\\le y\\le 2 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186527229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "236a2d72-bb0b-50be-bba3-e4d52248a15f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{{x}^{2}{y}^{2}}" :db/id #edb/ref 17592186526581} {:answer/id #uuid "4b66b758-0826-5108-9ac0-ade8eefbc63c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{xy}" :db/id #edb/ref 17592186526657} {:answer/id #uuid "71dd7185-fad4-53e7-b17c-bea3ed88b7f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{xy}" :db/id #edb/ref 17592186526723} {:answer/id #uuid "b08f83bf-773c-562d-b48f-e6657ce17368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{x}^{2}{y}^{2}}" :db/id #edb/ref 17592186526838} {:answer/id #uuid "d77ff831-4178-5cb0-8b9c-9a40136d4cb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{{x}^{3}{y}^{3}}" :db/id #edb/ref 17592186526918}] :answer-field/correct {:db/id #edb/ref 17592186526838} :answer-field/id #uuid "e0c66bcf-f118-5a15-8c75-354e4b9c987f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527108}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fcac8514-54e9-5652-a542-ae9e241a741a" :question/math-academy-id "q-159315" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\left\\{\\begin{aligned}\\frac{(x-1)(y-1)}{xy}, & x\\ge 1,\\,y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$\n\nFind the joint PDF $f(x,y)$ for $x\\ge 1$ and $y\\ge 1.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is given by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $x\\ge 1$ and $y\\ge 1,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}\\left(\\frac{(x-1)(y-1)}{xy}\\right)) \\\\  & =\\frac{∂}{∂x}(\\frac{x-1}{x}\\cdot \\frac{∂}{∂y}(1-\\frac{1}{y})) \\\\  & =\\frac{∂}{∂x}(\\frac{x-1}{x}\\cdot \\frac{1}{{y}^{2}}) \\\\  & =\\frac{1}{{y}^{2}}\\cdot \\frac{∂}{∂x}(1-\\frac{1}{x}) \\\\  & =\\frac{1}{{y}^{2}}\\cdot \\frac{1}{{x}^{2}} \\\\  & =\\frac{1}{{x}^{2}{y}^{2}}.\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\n\nTherefore, we have\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{1}{{x}^{2}{y}^{2}}, & x\\ge 1,\\,y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\\right.\n$$"} {:answer/id #uuid "041f8bb1-395a-5761-a87c-1b044587e237" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{\\pi }{2},0)" :db/id #edb/ref 17592186527315} {:answer/id #uuid "058cac9d-5a5a-5ee7-9198-6ebfb7207e0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{2}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527319} {:answer/id #uuid "7023af54-631a-5dcf-bf27-5f2705dfb93d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{2}({[3-y]}^{2}-{[\\frac{2}{y}]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527516} {:answer/id #uuid "80f6d32e-5475-5dfc-9839-a9615e457aa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{1}^{2}({[2+\\frac{2}{y}]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527559} {:answer/id #uuid "890682ad-7bd6-5e47-a193-c49b79f9309a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,\\frac{16}{7})" :db/id #edb/ref 17592186527576} {:answer/id #uuid "8aa24a59-28c0-5ddf-af4a-9ea620581550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,\\frac{16}{5})" :db/id #edb/ref 17592186527581} {:answer/id #uuid "8f1ded1a-3543-58c8-aa2a-3a66aeaf334f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,-\\frac{5}{7})" :db/id #edb/ref 17592186527589} {:answer/id #uuid "a19965fa-cbd9-5c65-bf6b-ca13371cc307" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\frac{4}{3},-\\frac{2}{3},\\frac{2}{3})$ and $(4,2,2)$" :db/id #edb/ref 17592186527640} {:answer/id #uuid "ab311e64-5391-5036-a765-998bb36b2623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{\\pi }{4},0)" :db/id #edb/ref 17592186527659} {:answer/id #uuid "c456bbd6-ff27-5bbd-b987-50a276c4e8b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,\\frac{12}{7})" :db/id #edb/ref 17592186527699} {:answer/id #uuid "d10abc45-5b7c-5d5e-9462-2d886e2f6bc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{1}^{2}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527730} {:answer/id #uuid "d30b7d3d-0dea-5470-83f6-553983d20016" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{-2}^{-1}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527733} {:answer/id #uuid "d755c9c6-8859-50b7-b00f-25201a9e2e8f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\frac{4}{3},-\\frac{2}{3},\\frac{2}{3})$ and $(8,4,3)$" :db/id #edb/ref 17592186527741} {:answer/id #uuid "e77c3742-a6e4-525c-89a7-67b1faaea9f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,-\\frac{2}{7})" :db/id #edb/ref 17592186527763} {:db/id #edb/ref 17592186527910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bc60df2-8730-5e1e-bb8a-e55cbc507546" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186527367} {:answer/id #uuid "5bd647e1-d76e-51a0-9ccd-a0bd017494ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186527481} {:answer/id #uuid "6214fdd5-48a4-5599-acaa-959b2a1436e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186527491} {:answer/id #uuid "90d7a5d8-344b-556d-9123-9417e82aa3a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527591} {:answer/id #uuid "91f4c10c-f73b-509c-9c7a-360f4a6c7f87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186527594}] :answer-field/correct {:db/id #edb/ref 17592186527491} :answer-field/id #uuid "332dc5a3-6077-5a95-b9d8-7163745f52d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00568ac8-b77a-5f52-9484-f19c655aa6d0" :question/math-academy-id "q-161558" :question/problem "![](images/57/5780b9e67272fdd78a24aab108fb9c672ee76ff2d62376991cea03c7efaa81fe.png)\n\nEvaluate the triple integral \n$$\n\\displaystyle {∭}_{R}\\frac{z}{12}\\,dV\n$$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/24/240cc6d74e266579aa848be820fd0014672aa0654f079c079472a896ad44c5fe.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 4-y+2z\\},\n$$\n\nwhere\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 4,\\,\\,0\\le z\\le 3\\}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/27/27862dcc3effe5801c812f5c8944c0134d13bb38f99d337b0a4e20e9ff815639.png)\n\nHence, we can express the region $R$ as\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 4,\\,\\,0\\le z\\le 3,\\,\\,0\\le x\\le 4-y+2z\\}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}\\frac{z}{12}\\,\\text{d}V={\\int }_{0}^{4}{\\int }_{0}^{3}{\\int }_{0}^{4-y+2z}\\frac{z}{12}\\,dx\\,dz\\,dy.\n$$\n\nFirst, we evaluate the inner integral with respect to $x$, treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{4}{\\int }_{0}^{3}{\\int }_{0}^{4-y+2z}\\frac{z}{12}\\,dx\\,dz\\,dy & ={\\int }_{0}^{4}{\\int }_{0}^{3}[{\\int }_{0}^{4-y+2z}\\frac{z}{12}\\,dx]dz\\,dy \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{3}\\frac{z}{12}[x]_{x=0}^{x=4-y+2z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{3}\\frac{z}{12}(4-y+2z)\\,dz\\,dy \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{3}\\frac{1}{12}(4z-yz+2{z}^{2})\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{4}{\\int }_{0}^{3}\\frac{1}{12}(4z-yz+2{z}^{2})\\,dz\\,dy & ={\\int }_{0}^{4}[{\\int }_{0}^{3}\\frac{1}{12}(4z-yz+2{z}^{2})\\,dz]dy \\\\  & ={\\int }_{0}^{4}\\frac{1}{12}{[2{z}^{2}-\\frac{1}{2}y{z}^{2}+\\frac{2}{3}{z}^{3}]}_{z=0}^{z=3}\\,dy \\\\  & ={\\int }_{0}^{4}\\frac{1}{12}(18-\\frac{9}{2}y+18)\\,dy \\\\  & ={\\int }_{0}^{4}(3-\\frac{3}{8}y)\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}(3-\\frac{3}{8}y)\\,dy & ={[3y-\\frac{3}{16}{y}^{2}]}_{y=0}^{y=4} \\\\  & =(12-3)-0 \\\\  & =9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0438c001-4681-59c9-8849-bfb0fea1ea87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186527316} {:answer/id #uuid "1fd3f49a-2cb7-53fd-81b2-5b3857da1e8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186527377} {:answer/id #uuid "930c7ce8-022d-5e4d-bd0e-9c20804f999e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186527598} {:answer/id #uuid "bfadebc0-e9ba-513f-b060-6475dd84329f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186527695} {:answer/id #uuid "f5e2d875-4536-53de-bade-39c60d2d073b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527786}] :answer-field/correct {:db/id #edb/ref 17592186527377} :answer-field/id #uuid "07cc355d-4413-59ca-bc08-a5af18b8dff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527805}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0597a6d4-1752-5cad-a458-a8b2a80e68a1" :question/math-academy-id "q-161666" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{x}2x\\,\\text{d}y]\\text{d}A\n$$\n\ngiven that the region $D$ in the $xz$-plane is given by\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 2,\\,0\\le z\\le 2-x\\}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{x}2x\\,\\text{d}y]\\text{d}A & ={∬}_{D}2x[y]_{y=0}^{y=x}\\,\\text{d}A \\\\  & ={∬}_{D}2{x}^{2}\\,\\text{d}A\\end{aligned}\n$$\n\nNotice that $D$ is a type I region in the $xz$-plane.\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $z$ and then with respect to $x:$\n\n$$\n\\begin{aligned}{∬}_{D}2{x}^{2}\\,\\text{d}A & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}2{x}^{2}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}2{x}^{2}[{\\int }_{0}^{2-x}\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{2}2{x}^{2}{[z]}_{z=0}^{z=2-x}\\text{d}x \\\\  & ={\\int }_{0}^{2}2{x}^{2}(2-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(4{x}^{2}-2{x}^{3})\\,\\text{d}x \\\\  & ={[\\frac{4}{3}{x}^{3}-\\frac{1}{2}{x}^{4}]}_{x=0}^{x=2} \\\\  & =(\\frac{32}{3}-8)-0 \\\\  & =\\frac{8}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64b93f40-e571-5114-b903-9dd492e51b88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186527497} {:answer/id #uuid "6cb11349-f33e-5227-8226-abc8119f362b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186527514} {:answer/id #uuid "7b6af685-0917-5dc1-883d-148ee49f787b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186527538} {:answer/id #uuid "a64dc4e7-e9b1-5616-8dbc-3c99ab7b4f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186527650} {:answer/id #uuid "b7557761-3d9b-5307-8631-4113b0f39d15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186527685}] :answer-field/correct {:db/id #edb/ref 17592186527497} :answer-field/id #uuid "6aaf8073-fd00-580d-ae0f-671cb6cc5fda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0884b1e2-1bba-5f2c-8a6a-f7af258e16fe" :question/math-academy-id "q-161568" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{y}^{y+z}2x\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD=\\{(y,z)\\,:\\,1\\le y\\le 2,\\,0\\le z\\le y\\}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{y}^{y+z}2x\\,\\text{d}x]\\text{d}A & ={∬}_{D}[{x}^{2}]_{x=y}^{x=y+z}\\,\\text{d}A \\\\  & ={∬}_{D}(y+z)^{2}-{y}^{2}\\,\\text{d}A \\\\  & ={∬}_{D}2yz+{z}^{2}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2yz+{z}^{2}\\,\\text{d}A & ={\\int }_{1}^{2}{\\int }_{0}^{y}2yz+{z}^{2}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}{[y{z}^{2}+\\frac{1}{3}{z}^{3}]}_{z=0}^{z=y}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}{y}^{3}+\\frac{1}{3}{y}^{3}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{4}{3}{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{1}{3}{y}^{4}]}_{y=1}^{y=2} \\\\  & =\\frac{1}{3}(16-1) \\\\  & =5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b7d98c9-02ac-5603-afb5-66c0e4f344f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527426} {:answer/id #uuid "40bf70c8-60bf-5224-82fd-7ff84ef20808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186527433} {:answer/id #uuid "aa0afc20-5227-5ba6-b5db-de3861c4378d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186527656} {:answer/id #uuid "b718d3fb-6237-5710-a206-2a584cc97e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186527683} {:answer/id #uuid "de78bae8-e4d7-569c-a55e-af9dd522c7c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186527750}] :answer-field/correct {:db/id #edb/ref 17592186527750} :answer-field/id #uuid "84189abc-599a-55c9-aabf-a7a75d8a52db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527862}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0bcb5cdc-84fc-59d4-a070-2f4375bf7e4a" :question/math-academy-id "q-161764" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}4xy\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,x\\le y\\le \\sqrt{1-z}\\},\n$$\n\nand $D$ is a finite region in $xz$-plane enclosed between the $x$-axis, the $z$-axis, and the curve $z=1-{x}^{2},$ in the first quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}4xy\\,\\text{d}V={∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA & ={∬}_{D}2x[{y}^{2}]_{y=x}^{y=\\sqrt{1-z}}\\,dA \\\\  & ={∬}_{D}2x(\\,(1-z)-{x}^{2})\\,dA \\\\  & ={∬}_{D}2x(1-z)-2{x}^{3}\\,dA\\end{aligned}\n$$\n\nWe must now evaluate this double integral over the region $D$ in the $xz$-plane shown below.\n\n![](images/95/95a2b4e28dbfae5ce447b3b975b2f74bf04883441217f42a24636970948402a0.png)\n\n  \n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}2x(1-z)-2{x}^{3}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-z}}2x(1-z)-2{x}^{3}\\,dx\\,dz \\\\  & ={\\int }_{0}^{1}(1-z)[{\\int }_{0}^{\\sqrt{1-z}}2x\\,dx]dz+{\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt{1-z}}-2{x}^{3}\\,dx]dz \\\\  & ={\\int }_{0}^{1}(1-z)[{x}^{2}]_{x=0}^{x=\\sqrt{1-z}}dz+{\\int }_{0}^{1}{[-\\frac{{x}^{4}}{2}]}_{x=0}^{x=\\sqrt{1-z}}dz \\\\  & ={\\int }_{0}^{1}(1-z)^{2}\\,dz-\\frac{1}{2}{\\int }_{0}^{1}(1-z)^{2}\\,dz \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}(1-z)^{2}\\,dz \\\\  & =\\frac{1}{6}{[-(1-z)^{3}]}_{z=0}^{z=1} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8a1e4b-eb13-5f55-ba55-4b5dc6ff93cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186527405} {:answer/id #uuid "89ab1fef-8fcd-5fa1-bf90-fadaaa814b18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186527578} {:answer/id #uuid "af68ffb6-0b68-527c-9426-425189a60c7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186527666} {:answer/id #uuid "b4001b41-6468-5fa7-9631-47ce66435f95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186527674} {:answer/id #uuid "d304075d-a560-5677-ac5a-03672fe435b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186527732}] :answer-field/correct {:db/id #edb/ref 17592186527405} :answer-field/id #uuid "36d55e5e-4911-5da7-af48-d3ee67db6281" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527823}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d6e2493-0d92-5bdf-8874-580184f51513" :question/math-academy-id "q-161932" :question/problem "![](images/6f/6f4bf1fe2f1a49f84b56702c4a83272c2f927ea4774eb677f43e525bf6cfb1f7.png)\n\nEvaluate the triple integral \n$$\n\\displaystyle {∭}_{R}8x\\,dV\n$$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/71/71f3fd0cbbde8adeca71688d6b53e2cd4cdf72076be3efa770cfebb8c10ffb76.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3-\\frac{3x}{4}-\\frac{z}{2}\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 3\\}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/cd/cd84968e9e5300a18d087ba566202aba2b7166818a590cca03eac90d4f3f7a89.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 3,\\,\\,0\\le y\\le 3-\\frac{3x}{4}-\\frac{z}{2}\\}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}8x\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{3}{\\int }_{0}^{3-3x/4-z/2}8x\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{3}{\\int }_{0}^{3-3x/4-z/2}8x\\,dy\\,dz\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{3}[{\\int }_{0}^{3-3x/4-z/2}8x\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}8x[y]_{y=0}^{y=3-3x/4-z/2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}8x(3-\\frac{3x}{4}-\\frac{z}{2})\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}(24x-6{x}^{2}-4xz)\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{3}(24x-6{x}^{2}-4xz)\\,dz\\,dx & ={\\int }_{0}^{1}[{\\int }_{0}^{3}(24x-6{x}^{2}-4xz)\\,dz]dx \\\\  & ={\\int }_{0}^{1}{[24xz-6{x}^{2}z-2x{z}^{2}]}_{z=0}^{z=3}\\,dx \\\\  & ={\\int }_{0}^{1}(72x-18{x}^{2}-18x)\\,dx \\\\  & ={\\int }_{0}^{1}(54x-18{x}^{2})\\,dx\\end{aligned}\n$$\n\n \n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(54x-18{x}^{2})\\,dx & ={[27{x}^{2}-6{x}^{3}]}_{x=0}^{x=1} \\\\  & =(27-6)-0 \\\\  & =21.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79072c2d-8f08-5f5d-b719-e8897f0003bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186527535} {:answer/id #uuid "86d4e147-37c0-5de6-9297-866f2a3e212e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186527570} {:answer/id #uuid "9acf82d9-0415-5a81-99b2-8d7595b0a6f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527626} {:answer/id #uuid "d4818782-d4a8-5e32-83a7-0f9ae23058c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186527738} {:answer/id #uuid "ea550bee-68b7-502c-8b85-afcf994105bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186527766}] :answer-field/correct {:db/id #edb/ref 17592186527535} :answer-field/id #uuid "59fa8c03-9424-5baf-a214-fbd3a612fb42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527842}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0f4e6580-868c-593b-ba50-63aa6d6e6e42" :question/math-academy-id "q-161725" :question/problem "$$\n{∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA,\n$$\n\nEvaluate the repeated integral above given that $D$ is a region in the $xz$-plane bounded by the lines $z=0,$ $x=0,$ and the curve $z+{x}^{2}=1.$" :question/worked-solution "First, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA & ={∬}_{D}2x[{y}^{2}]_{y=x}^{y=\\sqrt{1-z}}\\,dA \\\\  & ={∬}_{D}2x(1-z-{x}^{2})\\,dA \\\\  & ={∬}_{D}(\\,2x(1-z)-2{x}^{3}\\,)\\,dA\\end{aligned}\n$$\n\nNow, to calculate this double integral, we plot $D$ as a type I plane region in the $xz$-plane.\n\n![](images/80/8079d8f9796c1f863a515ced0091c1f420318be1c4bfe0eb2da641bddfa426ce.png)\n\n \n\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $z$ and then with respect to $x:$\n\n$$\n\\begin{aligned}{∬}_{D}(\\,2x(1-z)-2{x}^{3}\\,)\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}(\\,2x(1-z)-2{x}^{3}\\,)\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(x[-(1-z)^{2}]_{z=0}^{z=1-{x}^{2}}-2{x}^{3}[z]_{z=0}^{z=1-{x}^{2}}\\,)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-{x}^{5}+x-2{x}^{3}+2{x}^{5})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{5}+x-2{x}^{3})\\,\\text{d}x \\\\  & ={[\\frac{1}{6}{x}^{6}+\\frac{1}{2}{x}^{2}-\\frac{1}{2}{x}^{4}]}_{x=0}^{x=1} \\\\  & =(\\frac{1}{6}+\\frac{1}{2}-\\frac{1}{2})-0 \\\\  & =\\frac{1}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041f8bb1-395a-5761-a87c-1b044587e237" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{\\pi }{2},0)" :db/id #edb/ref 17592186527315} {:answer/id #uuid "5577dcb2-91aa-5255-8e1f-f21bfb8168c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,0)" :db/id #edb/ref 17592186527470} {:answer/id #uuid "62850344-0899-50d9-b54b-f07542ecb296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,0)" :db/id #edb/ref 17592186527493} {:answer/id #uuid "a64f5e23-38b3-551e-9f55-fba8ae74a486" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\pi ,0)" :db/id #edb/ref 17592186527651} {:answer/id #uuid "ab311e64-5391-5036-a765-998bb36b2623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{\\pi }{4},0)" :db/id #edb/ref 17592186527659}] :answer-field/correct {:db/id #edb/ref 17592186527659} :answer-field/id #uuid "a9630a8b-9a3c-56a1-882a-b2e2265a7e4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527880}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1cf055f3-7724-5017-8bd4-b9d8370b23a5" :question/math-academy-id "q-122943" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4t\\operatorname{ln}⁡\\left(\\frac{t}{\\pi }\\right),\\,y=t\\operatorname{cos}⁡t,\\,t\\in (0,\\infty ).\n$$\n\nLet $C$ be the point that corresponds to $t=\\pi $ on the curve. Determine the point at which the normal to the curve at $C$ crosses the $x$-axis." :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=\\pi $ into the parametric equations:\n\n$$\n\\begin{aligned}x & =4\\pi \\operatorname{ln}⁡\\left(\\frac{\\pi }{\\pi }\\right)=4\\pi (0)=0, \\\\ y & =\\pi \\operatorname{cos}⁡\\pi =-\\pi \\end{aligned}\n$$\n\nSo we're looking to determine the equation of the normal at the point $(0,-\\pi ).$ For this, we need to find $\\frac{\\text{d}y}{\\text{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=4\\operatorname{ln}⁡\\left(\\frac{t}{\\pi }\\right)+4,\\,{y}^{′}(t)=\\operatorname{cos}⁡(t)-t\\operatorname{sin}⁡t\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{\\operatorname{cos}⁡(t)-t\\operatorname{sin}⁡t}{4\\operatorname{ln}⁡\\left(\\frac{t}{\\pi }\\right)+4}.\\end{aligned}\n$$\n\nAt the point where $t=\\pi ,$ the slope $m$ of the tangent line is given by \n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=\\pi } & =\\frac{\\operatorname{cos}⁡(\\pi )-\\pi \\operatorname{sin}⁡\\pi }{4\\operatorname{ln}⁡\\left(\\frac{\\pi }{\\pi }\\right)+4} \\\\  & =\\frac{-1}{4\\cdot 0+4}=-\\,\\frac{1}{4}.\\end{aligned}\n$$\n\nTo find the slope ${m}_{n}$ of the normal line, we take the negative reciprocal of $m$:\n\n$$\n{m}_{n}=-\\frac{1}{m}=-\\frac{1}{\\,\\left(-\\frac{1}{4}\\right)\\,}=4\n$$\n\nTo calculate the equation of the normal, we use point-slope form with the point $({x}_{1},{y}_{1})=(0,-\\pi )$ and the slope ${m}_{n}=4.$ We get\n\n$$\n\\begin{aligned}y-(-\\pi ) & =4(x-0) \\\\ y & =4x-\\pi .\\end{aligned}\n$$\n\nThe normal intersects the $x$-axis when $y=0.$ At this point, we have\n\n$$\n\\begin{aligned}4x-\\pi  & =0 \\\\ 4x & =\\pi  \\\\ x & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nConsequently, $(\\frac{\\pi }{4},0)$ is the $x$-intercept."} {:db/id #edb/ref 17592186527926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf8e160-2051-5377-beb9-7f358fa12cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186527334} {:answer/id #uuid "ca613bca-62eb-519c-a990-d494e25f04b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186527714} {:answer/id #uuid "cfd80d10-6b1c-5684-a3dc-37d716ebf7e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186527727} {:answer/id #uuid "fc8fe0a7-5a62-53ed-9ad4-a69d4dc8c276" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{31}{8}" :db/id #edb/ref 17592186527795} {:answer/id #uuid "fd2d7ec6-a6e6-5a31-bdbf-78782edf7758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186527797}] :answer-field/correct {:db/id #edb/ref 17592186527714} :answer-field/id #uuid "c14a0fdb-ff7e-57f0-b03c-3708c9d22c3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527889}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3104fe5f-1fab-5144-bd0b-8c85fa4d01fa" :question/math-academy-id "q-146225" :question/problem "| $f$ | $Y=2$ | $Y=4$ | $Y=8$ |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n| $X=4$ | $\\frac{5}{16}$ | $\\frac{1}{16}$ | $\\frac{1}{8}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[Y\\,|\\,X=2]$ given that $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{Y|2}=\\frac{11}{2}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=2$ | $Y=4$ | $Y=8$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n| $X=4$ | $\\frac{5}{16}$ | $\\frac{1}{16}$ | $\\frac{1}{8}$ | $\\frac{1}{2}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=2$ | $Y=4$ | $Y=8$ |  |\n| --- | --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ | $1$ |\n| $X=4$ | $\\frac{5}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=2] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,2)]-{\\mu }_{Y|2}^{2} \\\\  & =[{2}^{2}\\cdot \\frac{1}{4}+{4}^{2}\\cdot \\frac{1}{4}+{8}^{2}\\cdot \\frac{1}{2}]-{\\left(\\frac{11}{2}\\right)}^{2} \\\\  & =1+4+32-\\frac{121}{4} \\\\  & =\\frac{27}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a8bec2-48ba-5a11-a243-ad1cfdb0c57b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186527363} {:answer/id #uuid "7fc5004c-bab4-52e2-ace0-ae6162e110d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186527554} {:answer/id #uuid "b8227aeb-2f23-5441-8fc0-8c3dbb03d4b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186527687} {:answer/id #uuid "de737258-a686-5bef-bdde-8f04025a1062" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186527749} {:answer/id #uuid "fcad7b2f-d2c4-56a4-a9ff-d30db2074f4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186527796}] :answer-field/correct {:db/id #edb/ref 17592186527796} :answer-field/id #uuid "c53ed922-aca5-5bca-99bf-697d183ea725" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527891}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "315997a1-7d2c-5dee-aeca-23b06ca1daaa" :question/math-academy-id "q-146201" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,2)=\\left\\{\\begin{aligned}\\frac{2}{5}, & x=5 \\\\ \\frac{3}{5}, & x=10 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\n$$\n\nSuppose $X$ and $Y$ are discrete random variables. Find the conditional variance $\\text{Var}[X\\,|\\,Y=2]$ given that the conditional probability mass function ${f}_{X|Y}(x\\,|\\,2)$ is shown above and the corresponding conditional expected value is ${\\mu }_{X|2}=8.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,2)]-{\\mu }_{X|2}^{2} \\\\  & =[(5)^{2}\\cdot \\frac{2}{5}+(10)^{2}\\cdot \\frac{3}{5}]-(8)^{2} \\\\  & =10+60-64 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e20a1e7-c143-53bc-878e-ea30164f1481" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527337} {:answer/id #uuid "634b9a3d-06ab-59c4-8af6-665347876113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186527495} {:answer/id #uuid "68106bf3-93d0-57f1-baec-9d90f724b12b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186527505} {:answer/id #uuid "95fc6287-af80-5279-939b-bc5232fd84f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186527606} {:answer/id #uuid "c6e1a5fe-ed76-5dc0-83b1-3c95dde85b9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186527707}] :answer-field/correct {:db/id #edb/ref 17592186527707} :answer-field/id #uuid "a0780126-c4c2-5d32-bb52-f4490db11809" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527876}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41ffd91c-a5ef-5456-865a-acafdbd924a3" :question/math-academy-id "q-146245" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ |\n| $X=2$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n| $X=3$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[Y\\,|\\,X=3]$ given that $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{Y|3}=\\frac{1}{4}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=0$ | $Y=1$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ | $\\frac{1}{3}$ |\n| $X=2$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ |\n| $X=3$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ | $\\frac{4}{9}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=0$ | $Y=1$ |  |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ | $1$ |\n| $X=2$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ |\n| $X=3$ | $\\frac{3}{4}$ | $\\frac{1}{4}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=3] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,3)]-{\\mu }_{Y|3}^{2} \\\\  & =[{0}^{2}\\cdot \\frac{3}{4}+{1}^{2}\\cdot \\frac{1}{4}]-{\\left(\\frac{1}{4}\\right)}^{2} \\\\  & =0+\\frac{1}{4}-\\frac{1}{16} \\\\  & =\\frac{3}{16}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af6dba2-cefe-540b-8ae2-f822fecac4db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi}{4}" :db/id #edb/ref 17592186527403}] :answer-field/correct {:db/id #edb/ref 17592186527403} :answer-field/id #uuid "377436fb-63b0-5a7f-9bbf-0d04a4c1e2f0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527824} {:answer-field/choices [{:answer/id #uuid "8aaf9d2a-7bf4-5fae-949b-2222f508d67a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186527582}] :answer-field/correct {:db/id #edb/ref 17592186527582} :answer-field/id #uuid "703919d5-cced-54a9-9d55-c7c534870732" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527855}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "43c9679e-fdc0-5c6d-a6ac-430a80de179e" :question/math-academy-id "q-350382" :question/problem "A curve is defined by the parametric equations\n\n$$\nx={e}^{t}\\operatorname{cos}⁡(t),\\,y={e}^{t}\\operatorname{sin}⁡(t),\\,0\\le t\\le 2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical. Do not round the answers.\n\nIn **ascending order**, the tangent to the curve is vertical at $t=$\n{{field-1}}\nand $t=$\n{{field-2}}." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)={e}^{t}(\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡(t)),\\,{y}^{′}(t)={e}^{t}(\\operatorname{sin}⁡(t)+\\operatorname{cos}⁡(t))\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n\\begin{aligned}{e}^{t}(\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡(t)) & =0 \\\\ \\operatorname{cos}⁡(t)-\\operatorname{sin}⁡(t) & =0 \\\\ 0 & =\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡(t) \\\\ \\operatorname{sin}⁡(t) & =\\operatorname{cos}⁡(t) \\\\ \\frac{\\operatorname{sin}⁡(t)}{\\operatorname{cos}⁡(t)} & =1 \\\\ \\operatorname{tan}⁡(t)=1 \\\\ t & =\\frac{\\pi }{4},\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{y}^{′}\\left(\\frac{\\pi }{4}\\right) & ={e}^{\\frac{\\pi }{4}}[\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)]=\\sqrt{2}{e}^{\\frac{\\pi }{4}}\\ne 0, \\\\ {y}^{′}\\left(\\frac{5\\pi }{4}\\right) & ={e}^{\\frac{5\\pi }{4}}[\\operatorname{sin}⁡\\left(\\frac{5\\pi }{4}\\right)+\\operatorname{cos}⁡\\left(\\frac{5\\pi }{4}\\right)]=-\\sqrt{2}{e}^{\\frac{5\\pi }{4}}\\ne 0,\\end{aligned}\n$$\n\nTherefore, we conclude that the tangent to the curve is vertical at $t=\\frac{\\pi }{4}$ and $t=\\frac{5\\pi }{4}.$"} {:db/id #edb/ref 17592186527935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6f618c-bcbb-5ea7-9f0c-1e592526ff75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186527425} {:answer/id #uuid "70deb780-c887-5dc9-85bd-f3b01ab2a24b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{128}{3}" :db/id #edb/ref 17592186527519} {:answer/id #uuid "c0d3ac95-6cd9-512a-9fab-45c1bf14a2cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186527697} {:answer/id #uuid "c4cd7a9d-8989-5c58-b2bd-dbc2dff6d515" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186527700} {:answer/id #uuid "cd88dea5-2a41-5c70-9ba3-d70de53ad32d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186527724}] :answer-field/correct {:db/id #edb/ref 17592186527519} :answer-field/id #uuid "35cfb42e-572e-5b24-aa8c-8d68254f52ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "43d7c496-4713-50a7-87bb-4a90921bae35" :question/math-academy-id "q-161891" :question/problem "![](images/3c/3cba44923f4f583cf6e01ac87cdd6e5ca73a75993eef8322cd01bf44416f84f4.png)\n\nEvaluate the triple integral \n$$\n\\displaystyle {∭}_{R}4x\\,dV\n$$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/f1/f112dd83a8cbb7563979dc170db23db7e178ba1762aca23fd4073c50e1c7a343.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 5-x-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/71/71974fddc8e0e0b6a12fc6a248c15eea08c9f6b8a0823d50aede8aadc31a41fa.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2,\\,\\,0\\le y\\le 5-x-z\\}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}4x\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{5-x-z}4x\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{5-x-z}4x\\,dy\\,dz\\,dx & ={\\int }_{0}^{2}{\\int }_{0}^{2}[{\\int }_{0}^{5-x-z}4x\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}4x[y]_{y=0}^{y=5-x-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}4x(5-x-z)\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(20x-4{x}^{2}-4xz)\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2}(20x-4{x}^{2}-4xz)\\,dz\\,dx & ={\\int }_{0}^{2}[{\\int }_{0}^{2}(20x-4{x}^{2}-4xz)\\,dz]dx \\\\  & ={\\int }_{0}^{2}{[20xz-4{x}^{2}z-2x{z}^{2}]}_{z=0}^{z=2}\\,dx \\\\  & ={\\int }_{0}^{3}(32x-8{x}^{2})\\,dx\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(32x-8{x}^{2})\\,dx & ={[16{x}^{2}-\\frac{8{x}^{3}}{3}]}_{x=0}^{x=2} \\\\  & =(64-\\frac{64}{3})-0 \\\\  & =\\frac{128}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1257fcfb-46f8-5247-807c-1316aea2b0d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{49}" :db/id #edb/ref 17592186527346} {:answer/id #uuid "498fdd26-91d0-57b8-87a1-230ef8d64f3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{49}" :db/id #edb/ref 17592186527451} {:answer/id #uuid "79f1dcea-b07b-564c-8376-a75167e5d009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186527536} {:answer/id #uuid "a61ab541-431f-5790-8fbe-9236a28cdc2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186527649} {:answer/id #uuid "b68efde0-35a7-58f7-b80d-1b1f8172c3f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527682}] :answer-field/correct {:db/id #edb/ref 17592186527346} :answer-field/id #uuid "01436a2c-b285-56d1-972d-3781d784d175" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527800}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "48b554a2-761e-5c5b-ad17-fc83b8df8618" :question/math-academy-id "q-146274" :question/problem "| $f$ | $Y=1$ | $Y=3$ | $Y=9$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{2}{9}$ | $\\frac{10}{27}$ | $\\frac{5}{27}$ |\n| $X=2$ | $\\frac{1}{27}$ | $\\frac{1}{9}$ | $\\frac{2}{27}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=9]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|9}=\\frac{9}{7}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution of $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=1$ | $Y=3$ | $Y=9$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{2}{9}$ | $\\frac{10}{27}$ | $\\frac{5}{27}$ |\n| $X=2$ | $\\frac{1}{27}$ | $\\frac{1}{9}$ | $\\frac{2}{27}$ |\n| ${f}_{Y}(y)$ | $\\frac{7}{27}$ | $\\frac{13}{27}$ | $\\frac{7}{27}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=1$ | $Y=3$ | $Y=9$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{6}{7}$ | $\\frac{10}{13}$ | $\\frac{5}{7}$ |\n| $X=2$ | $\\frac{1}{7}$ | $\\frac{3}{13}$ | $\\frac{2}{7}$ |\n|  | $1$ | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=9] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,9)]-{\\mu }_{X|9}^{2} \\\\  & =[{1}^{2}\\cdot \\frac{5}{7}+{2}^{2}\\cdot \\frac{2}{7}]-{\\left(\\frac{9}{7}\\right)}^{2} \\\\  & =\\frac{5}{7}+\\frac{8}{7}-\\frac{81}{49} \\\\  & =\\frac{10}{49}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab322b7-88c0-562d-aad6-28ae0e766ac0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡|4-x|-\\frac{5}{4-x}+\\operatorname{ln}⁡|2-x|+K" :db/id #edb/ref 17592186527327} {:answer/id #uuid "3b89cb41-52b7-5666-8f50-16d233ce418c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{ln}⁡|4-x|-\\frac{1}{4-x}-\\operatorname{ln}⁡|2-x|+K" :db/id #edb/ref 17592186527427} {:answer/id #uuid "58923f50-9ab3-5f70-9ff3-7fb61c42ff32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡|4-x|-\\frac{5}{4-x}+5\\operatorname{ln}⁡|2-x|+K" :db/id #edb/ref 17592186527476} {:answer/id #uuid "652ffd1d-a604-5671-a532-9fbbb91be568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{ln}⁡|4-x|+\\frac{1}{4-x}+5\\operatorname{ln}⁡|2-x|+K" :db/id #edb/ref 17592186527499} {:answer/id #uuid "bf74c85d-c2cb-5a97-9f09-4ade326e74d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{ln}⁡|4-x|+\\frac{5}{4-x}-5\\operatorname{ln}⁡|2-x|+K" :db/id #edb/ref 17592186527694}] :answer-field/correct {:db/id #edb/ref 17592186527499} :answer-field/id #uuid "a1fdb08d-4e9a-5aa1-bf2f-9d236664e6fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527877}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "504684ef-507d-57b1-81c3-7c9672d3e28f" :question/math-academy-id "q-11372" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{9x-38}{(4-x)^{2}(2-x)}\\,\\text{d}x.\n$$" :question/worked-solution "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{9x-38}{(4-x)^{2}(2-x)}=\\frac{A}{(4-x)}+\\frac{B}{(4-x)^{2}}+\\frac{C}{(2-x)}\n$$\n\nTo determine the coefficients $A,$ $B,$ and $C,$ we first multiply both sides of the above equation by $(4-x)^{2}(2-x)$ and get\n\n$$\n9x-38=A(4-x)(2-x)+B(2-x)+C(4-x)^{2}.\n$$\n\nPlugging in $x=4,$ we can eliminate $A$ and $C$ and solve for $B:$\n\n$$\n\\begin{aligned}9(4)-38 & =A(4-4)(2-4)+B(2-4)+C(4-4)^{2} \\\\ 36-38 & =B(-2) \\\\ B & =\\frac{-2}{-2} \\\\ B & =1\\end{aligned}\n$$\n\nPlugging in $x=2,$ we can eliminate $A$ and $B$ and solve for $C:$\n\n$$\n\\begin{aligned}9(2)-38 & =A(4-2)(2-2)+B(2-2)+C(4-2)^{2} \\\\ 18-38 & =C{(2)}^{2} \\\\ C & =\\frac{-20}{4} \\\\ C & =-5\\end{aligned}\n$$\n\nPlugging in $x=0$ and substituting the known values of $B$ and $C,$ we can solve for $A:$\n\n$$\n\\begin{aligned}9(0)-38 & =A(4-0)(2-0)+B(2-0)+C(4-0)^{2} \\\\ -38 & =8A+2B+16C \\\\ -38 & =8A+2(1)+16(-5) \\\\ -38 & =8A-78 \\\\ 8A & =78-38 \\\\ A & =\\frac{40}{8} \\\\ A & =5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{9x-38}{(4-x)^{2}(2-x)}=\\frac{5}{(4-x)}+\\frac{1}{(4-x)^{2}}-\\frac{5}{(2-x)}.\n$$\n\nFinally, we integrate this expression term by term, and get\n\n$$\n\\begin{aligned}\\int \\frac{9x-38}{(4-x)^{2}(2-x)}\\,\\text{d}x & =\\int (\\frac{5}{(4-x)}+\\frac{1}{(4-x)^{2}}-\\frac{5}{(2-x)})\\,\\text{d}x \\\\  & =5\\int \\frac{1}{4-x}\\,\\text{d}x+\\int \\frac{1}{(4-x)^{2}}\\,\\text{d}x-5\\int \\frac{1}{2-x}\\,\\text{d}x \\\\  & =-5\\operatorname{ln}⁡|4-x|+\\frac{1}{4-x}+5\\operatorname{ln}⁡|2-x|+K,\\end{aligned}\n$$\n\nwhere $K$ is an integral constant."} {:db/id #edb/ref 17592186527945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a403057-49da-5281-95e9-2b61e1f6c156" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(4,2,2)$ and $(8,4,3)$" :db/id #edb/ref 17592186527579} {:answer/id #uuid "8cc1d652-8f64-55d9-a0a5-6794fcdf58b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(4,2,2)$ only" :db/id #edb/ref 17592186527586} {:answer/id #uuid "a19965fa-cbd9-5c65-bf6b-ca13371cc307" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\frac{4}{3},-\\frac{2}{3},\\frac{2}{3})$ and $(4,2,2)$" :db/id #edb/ref 17592186527640} {:answer/id #uuid "ce32204a-bd90-5a02-95bb-9e251b7948af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(8,4,3)$ only" :db/id #edb/ref 17592186527726} {:answer/id #uuid "d755c9c6-8859-50b7-b00f-25201a9e2e8f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\frac{4}{3},-\\frac{2}{3},\\frac{2}{3})$ and $(8,4,3)$" :db/id #edb/ref 17592186527741}] :answer-field/correct {:db/id #edb/ref 17592186527640} :answer-field/id #uuid "9b76cfe8-40cb-5f07-be72-0076c0000916" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527874}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a9b6c0a-2d84-570a-8860-6a6e61ceeed3" :question/math-academy-id "q-94084" :question/problem "Find the point(s) of the intersection of the elliptic cone ${x}^{2}+4{y}^{2}=8{z}^{2}$ and the line $\\frac{x}{4}=\\frac{y}{2}=z-1.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\n\\frac{x}{4}=\\frac{y}{2}=z-1=t\\,⟹\\,\\left\\{\\begin{aligned}x=4t \\\\ y=2t \\\\ z=t+1,\\end{aligned}\\right.\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x,$ $y,$ and $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2} & =8{z}^{2} \\\\ (4t)^{2}+4(2t)^{2} & =8(t+1)^{2} \\\\ 16{t}^{2}+16{t}^{2} & =8(t+1)^{2} \\\\ 32{t}^{2} & =8(t+1)^{2} \\\\ 4{t}^{2} & =(t+1)^{2} \\\\ 4{t}^{2} & ={t}^{2}+2t+1 \\\\ 3{t}^{2}-2t-1 & =0 \\\\ (3t+1)(t-1) & =0 \\\\ t & =-\\frac{1}{3},1.\\end{aligned}\n$$\n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=-\\frac{1}{3},$ we have\n\n$$\n\\left\\{\\begin{aligned}x=4\\left(-\\frac{1}{3}\\right)=-\\frac{4}{3} \\\\ y=2\\left(-\\frac{1}{3}\\right)=-\\frac{2}{3} \\\\ z=-\\frac{1}{3}+1=\\frac{2}{3},\\end{aligned}\\right.\n$$\n\nso the first point is $$\n\\displaystyle (-\\frac{4}{3},-\\frac{2}{3},\\frac{2}{3}).\n$$\n\n- For $t=1,$ we have\n\n$$\n\\left\\{\\begin{aligned}x=4(1)=4 \\\\ y=2(1)=2 \\\\ z=1+1=2,\\end{aligned}\\right.\n$$\n\nso the second point is $(4,2,2).$\n\nTherefore, the points of intersection are $(-\\frac{4}{3},-\\frac{2}{3},\\frac{2}{3})$ and $(4,2,2).$"} {:db/id #edb/ref 17592186527957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3f812-017d-59eb-99e5-5a00f74bf7d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186527344} {:answer/id #uuid "35e1c9bf-ea2b-560e-8f70-12de88c73f78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186527418} {:answer/id #uuid "49e17673-b9ad-517c-bb9b-8d3f2668d8ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186527452} {:answer/id #uuid "78e4424f-a2d2-5162-a013-91916d289fbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186527534} {:answer/id #uuid "e438768b-4435-5fed-b94f-351a63a4645d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186527756}] :answer-field/correct {:db/id #edb/ref 17592186527534} :answer-field/id #uuid "3888cc3d-bb90-568c-bfd5-048cece1217d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527826}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a83145c-370c-5913-b3c6-439072b6c354" :question/math-academy-id "q-161772" :question/problem "Evaluate the triple integral\n\n$$\n{∭}_{R}xyz\\,\\text{d}V\n$$\n\nwhere $R$ is the type III region given by \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le z\\le 2,\\,0\\le x\\le \\sqrt{4-2z},\\,0\\le y\\le x\\}.\n$$" :question/worked-solution "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}xyz\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{\\int }_{0}^{x}xyz\\,dy\\,dx\\,dz.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{\\int }_{0}^{x}xyz\\,dy\\,dx\\,dz & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}[{\\int }_{0}^{x}xyz\\,dy]dx\\,dz \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}xz{[\\frac{{y}^{2}}{2}]}_{y=0}^{y=x}dx\\,dz \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}xz\\left(\\frac{{x}^{2}}{2}\\right)\\,dx\\,dz \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{x}^{3}z\\,dx\\,dz\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $x$, treating $z$ as a constant: \n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{x}^{3}z\\,dx\\,dz & =\\frac{1}{2}{\\int }_{0}^{2}z[{\\int }_{0}^{\\sqrt{4-2z}}{x}^{3}\\,\\text{d}x]\\text{d}z \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}z{[\\frac{{x}^{4}}{4}]}_{x=0}^{x=\\sqrt{4-2z}}\\text{d}z \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}\\frac{1}{4}(4-2z)^{2}z\\,\\text{d}z \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}4z-4{z}^{2}+{z}^{3}\\,\\text{d}z\\end{aligned}\n$$\n\nFinally, we integrate with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{2}4z-4{z}^{2}+{z}^{3}\\,\\text{d}z & =\\frac{1}{2}{[2{z}^{2}-\\frac{4}{3}{z}^{3}+\\frac{1}{4}{z}^{4}]}_{z=0}^{z=2} \\\\  & =\\frac{1}{2}(8-\\frac{32}{3}+4)-0 \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "058cac9d-5a5a-5ee7-9198-6ebfb7207e0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{2}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527319} {:answer/id #uuid "7023af54-631a-5dcf-bf27-5f2705dfb93d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{2}({[3-y]}^{2}-{[\\frac{2}{y}]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527516} {:answer/id #uuid "80f6d32e-5475-5dfc-9839-a9615e457aa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{1}^{2}({[2+\\frac{2}{y}]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527559} {:answer/id #uuid "d10abc45-5b7c-5d5e-9462-2d886e2f6bc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{1}^{2}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527730} {:answer/id #uuid "d30b7d3d-0dea-5470-83f6-553983d20016" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{-2}^{-1}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186527733}] :answer-field/correct {:db/id #edb/ref 17592186527730} :answer-field/id #uuid "24a6b34c-6b2b-59cf-97a5-55f1d3c4912c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527814}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7bcaaf90-d33e-5a2f-9583-78877f436c71" :question/math-academy-id "q-50330" :question/problem "![](images/31/31d4236bf58cd579c49c7259c32a2a9171e07c771b4c34040ac92896809f695f.png)\n\nThe region enclosed by the curves $x=\\frac{2}{y}$ and $x=3-y$ is rotated $2\\pi $ radians about the line $x=-2.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\frac{2}{y} & =3-y \\\\ 2 & =3y-{y}^{2} \\\\ {y}^{2}-3y+2 & =0 \\\\ (y-1)(y-2) & =0 \\\\ y & =1,2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=1$ to $y=2.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/b7/b73c341f4d09b1df7bea162bc7dbe10d0ee60920c847f9c24210386a3d139e61.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{2}{y},$ and\n\n- *leaves* through the outer curve $x=3-y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=3-y.$\n\n![](images/c8/c8c8e766c66e47a54f316f54893d603b245acec8f529da3a5033d2bba547a319.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}[\\,(3-y)-(-2)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[5-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{2}{y}.$\n\n![](images/1b/1b31331f1c0da353bee6fe29d10e9e58dd531cbc8152cbce214d1adea771b032.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[\\,\\left(\\frac{2}{y}\\right)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[\\frac{2}{y}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{1}^{2}{[5-y]}^{2}\\,\\text{d}y-\\pi {\\int }_{1}^{2}{[\\frac{2}{y}+2]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\text{d}y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16859933-75c0-53cc-92d2-abc0eb0131cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186527351} {:answer/id #uuid "25582ec9-aea6-53c2-b2a3-0a0449093e1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186527391} {:answer/id #uuid "5dbf81b7-4c30-539d-840c-554a9ef51ef3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186527485} {:answer/id #uuid "88b8ff89-b6c2-573a-9042-004cee1995e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186527574} {:answer/id #uuid "9886d286-2a1c-56a0-abf4-404d3ebfd465" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186527618}] :answer-field/correct {:db/id #edb/ref 17592186527574} :answer-field/id #uuid "0e152976-df66-5055-a7f1-93a051729b6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527806}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7dfdc43a-549b-5350-87ba-ec6dde24e325" :question/math-academy-id "q-161689" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{4-{x}^{2}}}5yz\\,\\text{d}y]\\text{d}A\n$$\n\ngiven that the region $D$ in the $xz$-plane is given by\n\n$$\nD=\\{(x,z)\\,:\\,0\\le z\\le 2,\\,0\\le x\\le 2-z\\}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $y,$ treating $z$ and $x$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{4-{x}^{2}}}5yz\\,\\text{d}y]\\text{d}A & ={∬}_{D}5z{[\\frac{{y}^{2}}{2}]}_{y=0}^{y=\\sqrt{4-{x}^{2}}}\\,\\text{d}A \\\\  & =\\frac{5}{2}{∬}_{D}z(4-{x}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNotice that $D$ is a type II region in the $xz$-plane.\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $x$ and then with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{5}{2}{∬}_{D}z(4-{x}^{2})\\,\\text{d}A & =\\frac{5}{2}{\\int }_{0}^{2}{\\int }_{0}^{2-z}z(4-{x}^{2})\\,\\text{d}x\\,\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}z[{\\int }_{0}^{2-z}(4-{x}^{2})\\,\\text{d}x]\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}z{[(4x-\\frac{{x}^{3}}{3})]}_{x=0}^{x=2-z}\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}z(4(2-z)-\\frac{(2-z)^{3}}{3})\\,\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}(\\frac{16z}{3}-2{z}^{3}+\\frac{{z}^{4}}{3})\\,\\text{d}z \\\\  & =\\frac{5}{2}{[\\frac{8{z}^{2}}{3}-\\frac{{z}^{4}}{2}+\\frac{{z}^{5}}{15}]}_{z=0}^{z=2} \\\\  & =\\frac{5}{2}[\\frac{32}{3}-8+\\frac{32}{15}] \\\\  & =12\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1096e9cc-0d05-54f0-a8b0-b4c0608e0b12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186527341} {:answer/id #uuid "58d0b037-6774-52f7-93e7-6f3ae6d9c7cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186527478} {:answer/id #uuid "ae9a381d-5fac-5694-95d2-991e04d47b49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{25}" :db/id #edb/ref 17592186527665} {:answer/id #uuid "ee741f96-ad03-5303-910e-ae71eb5a15f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{25}" :db/id #edb/ref 17592186527768} {:answer/id #uuid "f2abc025-91c6-53cf-babe-651b78bd05b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186527780}] :answer-field/correct {:db/id #edb/ref 17592186527478} :answer-field/id #uuid "90de2426-d3b0-54f0-abb8-0e8cf9780d48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527870}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7e4093f7-c4fd-5107-9969-358e958506e1" :question/math-academy-id "q-146272" :question/problem "| $f$ | $Y=4$ | $Y=8$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{16}$ | $\\frac{3}{16}$ |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=4]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|4}=\\frac{4}{5}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution of $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=4$ | $Y=8$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{16}$ | $\\frac{3}{16}$ |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n| ${f}_{Y}(y)$ | $\\frac{5}{16}$ | $\\frac{11}{16}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=4$ | $Y=8$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{5}$ | $\\frac{3}{11}$ |\n| $X=1$ | $\\frac{4}{5}$ | $\\frac{8}{11}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=4] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,4)]-{\\mu }_{X|4}^{2} \\\\  & =[{0}^{2}\\cdot \\frac{1}{5}+{1}^{2}\\cdot \\frac{4}{5}]-{\\left(\\frac{4}{5}\\right)}^{2} \\\\  & =0+\\frac{4}{5}-\\frac{16}{25} \\\\  & =\\frac{4}{25}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d9012e4-4080-5eed-b0f1-ea73de461ec2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186527374}] :answer-field/correct {:db/id #edb/ref 17592186527374} :answer-field/id #uuid "23614fcf-fbe4-5be9-ae9e-34482a74c5f3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527812} {:answer-field/choices [{:answer/id #uuid "1c25e94b-079d-51a9-bf98-4849a2d4378b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186527369}] :answer-field/correct {:db/id #edb/ref 17592186527369} :answer-field/id #uuid "298c6150-0d93-5585-9a25-200dda26c396" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527815}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8516a769-888c-5185-902e-1a5250ccaa04" :question/math-academy-id "q-350393" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t,\\,0<t<2\\pi .\n$$\n\nLet $C$ be the point that corresponds to $t=\\frac{\\pi }{6}$ on the curve. Determine the coordinates of the point at which the normal to the curve at $C$ crosses the $y$-axis. Do not round the answers.\n\nThe normal to the curve at $C$ crosses the $y$-axis at $(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=\\frac{\\pi }{6}$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =3\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)=3\\cdot \\frac{\\sqrt{3}}{2}=\\frac{3\\sqrt{3}}{2} \\\\ y & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)=\\frac{1}{2}\\end{aligned}\n$$\n\nSo, we're looking to determine the equation of the normal at the point $(\\frac{3\\sqrt{3}}{2},\\frac{1}{2}).$ For this, we need to find $\\frac{\\text{d}y}{\\text{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=-3\\operatorname{sin}⁡t,\\,{y}^{′}(t)=\\operatorname{cos}⁡t\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{\\operatorname{cos}⁡t}{-3\\operatorname{sin}⁡t} \\\\  & =-\\frac{1}{3}\\operatorname{cot}⁡t.\\end{aligned}\n$$\n\nAt the point where $t=\\frac{\\pi }{6},$ the slope of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t\\,=\\,\\frac{\\pi }{6}} & =-\\frac{1}{3}\\operatorname{cot}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =-\\frac{1}{3}(\\sqrt{3}) \\\\  & =-\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nTo find the slope ${m}_{n}$ of the normal line, we take the negative reciprocal of $m:$\n\n$$\n{m}_{n}=-\\frac{1}{m}=-\\frac{1}{\\left(-\\frac{\\sqrt{3}}{3}\\right)}=\\frac{3}{\\sqrt{3}}=\\sqrt{3}\n$$\n\nTo calculate the equation of the normal, we use point-slope form with the point $$\n\\displaystyle ({x}_{1},{y}_{1})=(\\frac{3\\sqrt{3}}{2},\\frac{1}{2})\n$$ and the slope ${m}_{n}=\\sqrt{3}.$ We get\n\n$$\n\\begin{aligned}y-\\frac{1}{2} & =\\sqrt{3}(x-\\frac{3\\sqrt{3}}{2}) \\\\ y-\\frac{1}{2} & =\\sqrt{3}x-\\frac{3(3)}{2} \\\\ y & =\\sqrt{3}x-\\frac{9}{2}+\\frac{1}{2} \\\\ y & =\\sqrt{3}x-4.\\end{aligned}\n$$\n\nThe normal crosses the $y$-axis when $x=0.$ At this point, we have\n\n$$\n\\begin{aligned}y & =-4.\\end{aligned}\n$$\n\nConsequently, the normal to the curve at $C$ crosses the $y$-axis at  $(0,\\,-4).$"} {:db/id #edb/ref 17592186527966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c73cfa-7b32-590c-b75b-0204826dff2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186527422} {:answer/id #uuid "39dd785e-5174-5e6e-b059-c2712b64a71e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186527423} {:answer/id #uuid "54955e88-70a2-5393-9107-0e28fe8834fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527466} {:answer/id #uuid "6fbf2e95-fb3f-53c7-ad6e-69eb5f31932a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186527515} {:answer/id #uuid "ba2deb2d-5233-59f1-9ed9-14564cf52445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186527691}] :answer-field/correct {:db/id #edb/ref 17592186527515} :answer-field/id #uuid "5a9293fa-0ff1-56b4-a14c-8acca9e82920" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527843}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86c9830c-c21b-52dd-a632-55f72d300bd2" :question/math-academy-id "q-146204" :question/problem "| $x$ | $0$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| ${f}_{X|Y}(x\\,|\\,4)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{5}{8}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=4]$ given that the conditional probability mass function ${f}_{X|Y}(x\\,|\\,4)$ is shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|4}=3.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=4] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,4)]-{\\mu }_{X|4}^{2} \\\\  & =[(0)^{2}\\cdot \\frac{1}{8}+(2)^{2}\\cdot \\frac{1}{4}+(4)^{2}\\cdot \\frac{5}{8}]-(3)^{2} \\\\  & =0+1+10-9 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b90be1f8-f52b-54dc-8056-994899931820" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186527690} {:answer/id #uuid "cb16beeb-c065-5e1a-9a9f-154f6ede0684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186527716} {:answer/id #uuid "d02cbb9c-d528-570e-9025-f251098c46db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186527729} {:answer/id #uuid "d547977d-f989-58a0-bcf9-f72affac5dec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186527739} {:answer/id #uuid "f0430f6a-c2da-516a-9585-cb2748f0f4b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527775}] :answer-field/correct {:db/id #edb/ref 17592186527716} :answer-field/id #uuid "1fa90856-9c00-502c-9ab3-58b709209b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527811}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a520314-a8ce-5660-9be7-ab082651f66c" :question/math-academy-id "q-146246" :question/problem "| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=2$ | $\\frac{1}{16}$ | $\\frac{1}{4}$ |\n| $X=4$ | $\\frac{1}{4}$ | $\\frac{3}{16}$ |\n| $X=6$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[Y\\,|\\,X=6]$ given that $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{Y|6}=3.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=2$ | $Y=4$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{16}$ | $\\frac{1}{4}$ | $\\frac{5}{16}$ |\n| $X=4$ | $\\frac{1}{4}$ | $\\frac{3}{16}$ | $\\frac{7}{16}$ |\n| $X=6$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=2$ | $Y=4$ |  |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{5}$ | $\\frac{4}{5}$ | $1$ |\n| $X=4$ | $\\frac{4}{7}$ | $\\frac{3}{7}$ | $1$ |\n| $X=6$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=6] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,6)]-{\\mu }_{Y|6}^{2} \\\\  & =[{2}^{2}\\cdot \\frac{1}{2}+{4}^{2}\\cdot \\frac{1}{2}]-{3}^{2} \\\\  & =2+8-9 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21702398-6680-552d-923f-027dff95a35a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186527383} {:answer/id #uuid "6029d8a7-a6ae-5959-9ee4-f8e3ebd8e072" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186527489} {:answer/id #uuid "78ae96ca-4942-5362-807b-c0b65d2496c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186527533} {:answer/id #uuid "c94fc212-35ff-5e38-9f57-12d4f4959a4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186527711} {:answer/id #uuid "ea8f272e-677d-5489-96d8-1e29db88e990" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186527767}] :answer-field/correct {:db/id #edb/ref 17592186527489} :answer-field/id #uuid "8b9c47c5-4e96-58fa-ac91-5791dc11f30c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527867}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ada3d128-ac86-51c2-88c8-3e672e4cad88" :question/math-academy-id "q-124172" :question/problem "![](images/09/09a38bb4306728f97b7fecbf9ab1bda7aa957607352c1ab27af09489c271c3ed.png)\n\nEvaluate $$\n\\displaystyle {\\int }_{C}({y}^{2}-2x)\\,\\text{d}y,\n$$ where $C$ is the path traversed along the line segment from the point $(0,1)$ to the point $(2,3),$ as shown above." :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\nThe curve $C$ is a line segment with endpoints $(0,1)$ and $(2,3).$ It can be parametrized as \n\n$$\n\\begin{aligned}r(t) & =⟨(0+t(2-0)),\\,(1+t(3-1))⟩ \\\\  & =⟨2t,\\,1+2t⟩,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+2t)=2\\end{aligned}\n$$\n\nNow, since $f(x,y)={y}^{2}-2x$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(1+2t)^{2}-2(2t) \\\\  & =1+4t+4{t}^{2}-4t \\\\  & =4{t}^{2}+1.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{1}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(4{t}^{2}+1)\\cdot 2\\cdot \\text{d}t \\\\  & =2{\\int }_{0}^{1}(4{t}^{2}+1)\\,\\text{d}t \\\\  & =2{[\\frac{4{t}^{3}}{3}+t]}_{0}^{1} \\\\  & =2(\\frac{4}{3}+1)-2(0) \\\\  & =\\frac{14}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "390a0a3f-8045-51e4-9e9a-3692b030cba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{24}" :db/id #edb/ref 17592186527421} {:answer/id #uuid "45156b6e-6526-56b2-a152-2e340488d5e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186527440} {:answer/id #uuid "72cceeab-ae35-5169-ba9f-38c49406c64d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186527523} {:answer/id #uuid "85994e10-7a1c-5399-818a-6d0eb148e72c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186527566} {:answer/id #uuid "a03f33e4-9c17-5d89-ba8f-89c5877bca3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186527638}] :answer-field/correct {:db/id #edb/ref 17592186527566} :answer-field/id #uuid "5e440dfe-c51c-5a5e-a6b4-025b490904aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527845}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bf9108b7-225d-5060-8e6a-417eee5fc631" :question/math-academy-id "q-161572" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{1-y-z}24y\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le \\frac{1}{2},\\,0\\le z\\le y\\}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{1-y-z}24y\\,\\text{d}x]\\text{d}A & ={∬}_{D}24y[x]_{x=0}^{x=1-y-z}\\,\\text{d}A \\\\  & ={∬}_{D}24y(1-y-z)\\,\\text{d}A \\\\  & ={∬}_{D}24y-24{y}^{2}-24yz\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}24y-24{y}^{2}-24yz\\,\\text{d}A & ={\\int }_{0}^{1/2}{\\int }_{0}^{y}24(y-{y}^{2})-24yz\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}24(y-{y}^{2})[z]_{z=0}^{z=y}-12y[{z}^{2}]_{z=0}^{z=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}24(y-{y}^{2})y-12{y}^{3}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}24{y}^{2}-36{y}^{3}\\,\\text{d}y \\\\  & ={[8{y}^{3}-9{y}^{4}]}_{y=0}^{y=1/2} \\\\  & =8(\\frac{1}{8}-0)-9(\\frac{1}{16}-0) \\\\  & =\\frac{7}{16}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186527989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "890682ad-7bd6-5e47-a193-c49b79f9309a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,\\frac{16}{7})" :db/id #edb/ref 17592186527576} {:answer/id #uuid "8aa24a59-28c0-5ddf-af4a-9ea620581550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,\\frac{16}{5})" :db/id #edb/ref 17592186527581} {:answer/id #uuid "8f1ded1a-3543-58c8-aa2a-3a66aeaf334f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,-\\frac{5}{7})" :db/id #edb/ref 17592186527589} {:answer/id #uuid "c456bbd6-ff27-5bbd-b987-50a276c4e8b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,\\frac{12}{7})" :db/id #edb/ref 17592186527699} {:answer/id #uuid "e77c3742-a6e4-525c-89a7-67b1faaea9f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\,-\\frac{2}{7})" :db/id #edb/ref 17592186527763}] :answer-field/correct {:db/id #edb/ref 17592186527576} :answer-field/id #uuid "45604a60-69c4-5549-aadb-af6a3764d454" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527831}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c3009bb8-76e4-5e7a-be7f-b556ddcfdaef" :question/math-academy-id "q-122700" :question/problem "A curve is defined by the parametric equations\n\n$$\nx={t}^{2}+3t,\\,y=1+\\sqrt{2t},\\,t\\in [0,\\infty ).\n$$\n\nLet $C$ be the point that corresponds to $t=2$ on the curve. Determine the point at which the tangent to the curve at $C$ crosses the $y$-axis." :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=2$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =(2)^{2}+3(2)=10, \\\\ y & =1+\\sqrt{2(2)}=3.\\end{aligned}\n$$\n\nSo we're looking to find the equation of the tangent line to the curve at the point $(10,3).$ \n\nTo find the equation of the tangent line, we need to find $\\frac{dy}{dx}.$ To compute it, we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=2t+3,\\,{y}^{′}(t)=\\frac{1}{\\sqrt{2t}}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{\\frac{1}{\\sqrt{2t}}}{2t+3} \\\\  & =\\frac{1}{\\sqrt{2t}(2t+3)}.\\end{aligned}\n$$\n\nAt the point where $t=2,$ the slope of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=2} & =\\frac{1}{\\sqrt{2\\cdot 2}(2\\cdot 2+3)} \\\\  & =\\frac{1}{14}.\\end{aligned}\n$$\n\nFinally, to calculate the equation of the tangent line, we use point-slope form with the point $({x}_{1},{y}_{1})=(10,3)$ and the slope $m=\\frac{1}{14}.$ We get\n\n$$\n\\begin{aligned}y-3 & =\\frac{1}{14}(x-10).\\end{aligned}\n$$\n\nThe tangent crosses the $y$-axis when $x=0.$ At this point, we have\n\n$$\n\\begin{aligned}y-3 & =\\frac{1}{14}(0-10) \\\\ y-3 & =-\\frac{5}{7} \\\\ y & =\\frac{16}{7}.\\end{aligned}\n$$\n\nConsequently, $(0,\\,\\frac{16}{7})$ is the $y$-intercept."} {:db/id #edb/ref 17592186528005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0282d2f5-2a53-58db-a10f-e26b85fe6f5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{36}" :db/id #edb/ref 17592186527310} {:answer/id #uuid "3fcfb3a6-bd6a-5f81-b119-ffca2871d580" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{36}" :db/id #edb/ref 17592186527432} {:answer/id #uuid "806d8ac7-8b82-599c-9872-2d84cc0bb623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{29}{64}" :db/id #edb/ref 17592186527556} {:answer/id #uuid "8768788c-5a1c-5056-8877-7d8c7cb5dc7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186527572} {:answer/id #uuid "9fd9e948-6464-58a2-a0f2-d61ae7071f1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{72}" :db/id #edb/ref 17592186527637}] :answer-field/correct {:db/id #edb/ref 17592186527637} :answer-field/id #uuid "3a706466-bb58-58a9-b091-d4ba42a7541f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527827}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e31a3154-dd92-51e0-baa5-7e556d0b4865" :question/math-academy-id "q-161580" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}2xyz\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,0\\le x\\le y+z\\},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axis, the line $y=1$ and the line $z=y$ in the first quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}2xyz\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{y+z}2xyz\\,dx]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{y+z}2xyz\\,dx]dA & ={∬}_{D}yz[{x}^{2}]_{x=0}^{x=y+z}\\,dA \\\\  & ={∬}_{D}yz(y+z)^{2}\\,dA \\\\  & ={∬}_{D}yz({y}^{2}+2yz+{z}^{2})\\,dA \\\\  & ={∬}_{D}{y}^{3}z+2{y}^{2}{z}^{2}+y{z}^{3}\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $yz$-plane shown below.\n\n![](images/59/5974f852ba8dcaf9e6c4d6323709987c590e2f739524e012545738bc4bb842b0.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{3}z+2{y}^{2}{z}^{2}+y{z}^{3}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{y}{y}^{3}z+2{y}^{2}{z}^{2}+y{z}^{3}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{y}{y}^{3}z+2{y}^{2}{z}^{2}+y{z}^{3}\\,dz]dy \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{2}{y}^{3}{z}^{2}+\\frac{2}{3}{y}^{2}{z}^{3}+\\frac{1}{4}y{z}^{4}]}_{z=0}^{z=y}dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{2}{y}^{3}\\cdot {y}^{2}+\\frac{2}{3}{y}^{2}\\cdot {y}^{3}+\\frac{1}{4}y\\cdot {y}^{4}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{17}{12}{y}^{5}\\,dy \\\\  & =\\frac{17}{12}{\\int }_{0}^{1}{y}^{5}\\,dy \\\\  & =\\frac{17}{12}{[\\frac{1}{6}{y}^{6}]}_{y=0}^{y=1} \\\\  & =\\frac{17}{12}(\\frac{1}{6}-0) \\\\  & =\\frac{17}{72}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186528006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "565f5262-532c-5e41-8ea0-d94694ac1b53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186527472} {:answer/id #uuid "81298f2e-a4cc-5c37-837c-36620a8723f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186527560} {:answer/id #uuid "90f1f224-4869-5295-a80b-2af51c894cd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186527592} {:answer/id #uuid "a23b2b89-1dca-5af5-9d84-12be328a7e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186527641} {:answer/id #uuid "bfc76cd0-c0a3-5a18-9d90-d4b09fd8e301" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186527696}] :answer-field/correct {:db/id #edb/ref 17592186527641} :answer-field/id #uuid "62352491-31d2-5339-9e42-95ca180169b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527846}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e4e7d822-5d73-50ee-b641-1c594f9a070a" :question/math-academy-id "q-161738" :question/problem "Evaluate the triple integral\n\n$$\n{∭}_{R}3x\\,\\text{d}V\n$$\n\nwhere $R$ is the type III region given by \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le x,\\,0\\le z\\le 2-x\\}.\n$$" :question/worked-solution "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}3x\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{2-x}{\\int }_{0}^{x}3x\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2-x}{\\int }_{0}^{x}3x\\,dy\\,dz\\,dx & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}[{\\int }_{0}^{x}3x\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}3x[y]_{y=0}^{y=x}dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}3x(x-0)\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}3{x}^{2}\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2-x}3{x}^{2}\\,dz\\,dx & ={\\int }_{0}^{2}3{x}^{2}[{\\int }_{0}^{2-x}\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{2}3{x}^{2}{[z]}_{z=0}^{z=2-x}\\text{d}x \\\\  & ={\\int }_{0}^{2}3{x}^{2}(2-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(6{x}^{2}-3{x}^{3})\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(6{x}^{2}-3{x}^{3})\\,\\text{d}x & ={[2{x}^{3}-\\frac{3}{4}{x}^{4}]}_{x=0}^{x=2} \\\\  & =(16-12)-0 \\\\  & =4.\\end{aligned}\n$$"} {:answer/id #uuid "10a507d3-b82b-5812-b4bd-1a60a94b11a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{6}({[\\frac{1}{2}y-1]}^{2}-y+2)\\text{d}y" :db/id #edb/ref 17592186528337} {:answer/id #uuid "3531e655-6ae7-5b2d-ab95-2fc419eb17a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{4}({[\\frac{1}{2}y-1]}^{2}-y+2)\\text{d}y" :db/id #edb/ref 17592186528432} {:answer/id #uuid "b1c80ec3-99ea-519d-b6ba-11c8b1be9972" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{6}(\\sqrt{y-2}-\\frac{1}{2}y+1)\\text{d}y" :db/id #edb/ref 17592186528733} {:answer/id #uuid "b6ea001f-721c-5acf-821a-a0ad541670bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{6}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y" :db/id #edb/ref 17592186528745} {:answer/id #uuid "d2a469bb-c186-589c-8768-0ebb679178a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{4}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y" :db/id #edb/ref 17592186528825} {:db/id #edb/ref 17592186529090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29fab220-23bc-5366-b741-676d8657ce65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186528405} {:answer/id #uuid "8cfc9f8a-4976-5927-99bf-331c5811136e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186528637} {:answer/id #uuid "b80dc7eb-9456-5e23-b6c7-2d2f2b7e9338" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\pi }{5}" :db/id #edb/ref 17592186528748} {:answer/id #uuid "c15e3f58-b077-5947-b270-fa6badb4c890" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{5}" :db/id #edb/ref 17592186528775} {:answer/id #uuid "d7e6f5d2-255a-53e4-a0a8-a54da7d2533b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi }{5}" :db/id #edb/ref 17592186528838}] :answer-field/correct {:db/id #edb/ref 17592186528748} :answer-field/id #uuid "f62f58ca-a3ef-528b-83c7-bf2ccd3c2d04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529081}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "10f20a34-5dca-5f03-b661-36330ae0c9f9" :question/math-academy-id "q-123488" :question/problem "![](images/b2/b2888d7fef98dacad56792a627ef1554ed28def615f1431de35d3ba9820fe0de.png)\n\nConsider the finite region bounded by $x={y}^{2}+2$ and $y=2-x,$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Writing our second function in terms of $y,$ we get\n\n$$\ny=2-x\\,⟹\\,x=2-y.\n$$\n\nLet $f(y)={y}^{2}+2$ and $g(y)=2-y.$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ {y}^{2}+2 & =2-y \\\\ {y}^{2}+y & =0 \\\\ y(y+1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-1$ to $y=0.$    \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/af/afe7bb6fbc5f523e04bdd8c5bc9e899af356729da0e4c7822bd7619dfeb3cb95.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=f(y)={y}^{2}+2,$ and\n\n- *leaves* through the outer function $x=g(y)=2-y.$\n\nTherefore, the integral that gives our volume is:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}({[2-y]}^{2}-{[{y}^{2}+2]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}(4-4y+{y}^{2}-({y}^{4}+4{y}^{2}+4))\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}(-{y}^{4}-3{y}^{2}-4y)\\text{d}y \\\\  & =\\pi {(-\\frac{{y}^{5}}{5}-{y}^{3}-2{y}^{2})|}_{-1}^{0} \\\\  & =\\pi [0-(\\frac{1}{5}+1-2)] \\\\  & =\\frac{4\\pi }{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bb127fe-81a1-51d8-a7f3-7f6901827eb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{25}{12}" :db/id #edb/ref 17592186528375} {:answer/id #uuid "3574038e-055d-56a6-9f8a-f1deedf83863" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186528434} {:answer/id #uuid "359b2829-aef3-5244-a711-6b233756f5c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{23}{11}" :db/id #edb/ref 17592186528436} {:answer/id #uuid "75aed8b7-b806-509d-904b-d5e5a1544691" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{25}{11}" :db/id #edb/ref 17592186528572} {:answer/id #uuid "ad2bcd84-ba3a-519d-a0e6-d8c907296ffc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{27}{13}" :db/id #edb/ref 17592186528724}] :answer-field/correct {:db/id #edb/ref 17592186528572} :answer-field/id #uuid "4409dd34-9ab8-5a98-a1d2-9602397921b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528977}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14f76056-5e3c-539d-8f82-855878eb07d3" :question/math-academy-id "q-50498" :question/problem "Given that ${a}_{1}=-\\frac{5}{2}$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{10}$ for all integers $n\\ge 1,$ find the value of $$\n\\displaystyle {\\sum }_{n=1}^{\\infty }{a}_{n}.\n$$" :question/worked-solution "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=-\\frac{5}{2}.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{10}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-\\frac{5}{2}}{(1-\\left(-\\frac{1}{10}\\right))} \\\\  & =\\frac{-\\frac{5}{2}}{\\left(\\frac{11}{10}\\right)} \\\\  & =-\\frac{5}{2}\\cdot \\frac{10}{11} \\\\  & =-\\frac{25}{11}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48706475-0664-565e-bd2d-7f83441bc4d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186528481} {:answer/id #uuid "99d1f1a0-32aa-5964-8ea7-584cb8f97f59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186528665} {:answer/id #uuid "c448d435-9bcd-595a-9b15-481488adc3cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186528780} {:answer/id #uuid "c948edf4-7c1a-595a-9006-e62d1d1f4937" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186528793} {:answer/id #uuid "f7aa2104-1ab4-5d6d-8862-d71d4c61233f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186528912}] :answer-field/correct {:db/id #edb/ref 17592186528780} :answer-field/id #uuid "9c25b804-adcd-5109-97e9-a671522d2fa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529026}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "17abd4d5-764f-50c1-82c3-4fcec4b8a574" :question/math-academy-id "q-122546" :question/problem "![](images/8c/8ce8a8061ec087c39ce93d73d0566832f33c4e6ce5c2f5185170c9372a0d88fa.png)\n\nConsider the finite region above bounded by $y=2x+2$ and $y=\\sqrt{4x+4},$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $x\\text{-axis.}$" :question/worked-solution "Let $f(x)=2x+2$ and $g(x)=\\sqrt{4x+4}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2x+2 & =\\sqrt{4x+4} \\\\ 2(x+1) & =\\sqrt{4x+4} \\\\ 4(x+1)^{2} & =4x+4 \\\\ {x}^{2}+2x+1 & =x+1 \\\\ {x}^{2}+x & =0 \\\\ x(x+1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=-1$ to $x=0.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/0a/0a6bdcc071500ac8dd40143c3219a14c80fc73d543d7307cb2c880a22db793a3.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=f(x)=2x+2,$ and\n\n- *leaves* through the outer function $y=g(x)=\\sqrt{4x+4}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}({[\\sqrt{4x+4}]}^{2}-{[2x+2]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}[4x+4-(2(x+1))^{2}]\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}[4(x+1)-4({x}^{2}+2x+1)]\\text{d}x \\\\  & =4\\pi {\\int }_{-1}^{0}[x+1-({x}^{2}+2x+1)]\\text{d}x \\\\  & =4\\pi {\\int }_{-1}^{0}(-{x}^{2}-x)\\text{d}x \\\\  & =4\\pi {(-\\frac{1}{3}{x}^{3}-\\frac{1}{2}{x}^{2})|}_{-1}^{0} \\\\  & =4\\pi (0-(\\frac{1}{3}-\\frac{1}{2})) \\\\  & =4\\pi \\left(\\frac{1}{6}\\right) \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de34e6e-ce64-5552-8a5c-f69eb0490ff9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,2)" :db/id #edb/ref 17592186528332} {:answer/id #uuid "2af0d1ed-dd1d-56ae-8b44-42cea59b8320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,1)" :db/id #edb/ref 17592186528410} {:answer/id #uuid "922c8552-c8fc-5577-b29a-57d3afc8d382" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,3)" :db/id #edb/ref 17592186528648} {:answer/id #uuid "e0d3dda4-f2bf-5297-875e-8af145212de6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,6)" :db/id #edb/ref 17592186528850} {:answer/id #uuid "f50c2d83-0310-5633-bc1e-2fbf9b92c4d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,2)" :db/id #edb/ref 17592186528904}] :answer-field/correct {:db/id #edb/ref 17592186528332} :answer-field/id #uuid "c861d536-4b73-5bd5-a586-cd534a3b924d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2708eacc-b12f-5049-bb93-6886b57484fd" :question/math-academy-id "q-111185" :question/problem "The point $P$ with coordinates $(3,6)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=\\frac{1}{3}f(x)?$" :question/worked-solution "The function $y=\\frac{1}{3}f(x)$ represents a compression of the function $y=f(x)$ by a factor of $3$ parallel to the $y$-axis. This has the effect of dividing the $y$-coordinates of all points on $y=f(x)$ by $3.$\n\nTherefore, the point $(3,6)$ on $f(x)$ is mapped to the point $(3,\\frac{6}{3})=(3,2),$ and this point must lie on the graph of $y=\\frac{1}{3}f(x).$"} {:db/id #edb/ref 17592186529107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c8c1d5-6245-5e5d-af86-ae89e6d91c80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+\\frac{9\\pi }{8}" :db/id #edb/ref 17592186528426}] :answer-field/correct {:db/id #edb/ref 17592186528426} :answer-field/id #uuid "0f185ea2-90bf-5f97-91ff-946b826ac36e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186528947}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ba92fa4-3450-58d7-9f90-59493b716e4d" :question/math-academy-id "q-352331" :question/problem "![](images/e3/e3f2350ba3651e928c65e1a78908a8f8e93cb690585a3fa16b723d1cf38a5024.png)\n\nFind the area $A$ bounded by the polar curve $r=2+\\operatorname{sin}⁡(2\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{2},$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=2+\\operatorname{sin}⁡(2\\theta )$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(2+\\operatorname{sin}⁡(2\\theta ))^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(4+4\\operatorname{sin}⁡(2\\theta )+{\\sin }^{2}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(4+4\\operatorname{sin}⁡(2\\theta )+\\frac{1-\\operatorname{cos}⁡(4\\theta )}{2})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\frac{9}{2}+4\\operatorname{sin}⁡(2\\theta )-\\frac{1}{2}\\operatorname{cos}⁡(4\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{9}{2}\\theta -2\\operatorname{cos}⁡(2\\theta )-\\frac{\\operatorname{sin}⁡(4\\theta )}{8}){|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\frac{9\\pi }{4}+4) \\\\  & =2+\\frac{9\\pi }{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "773ffc42-e2cb-572a-9030-e9a10ba881ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi +24}{8}" :db/id #edb/ref 17592186528576} {:answer/id #uuid "a1bcdf62-382b-5121-8803-109ccdad8245" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi -9}{4}" :db/id #edb/ref 17592186528689} {:answer/id #uuid "a5649c91-b6ce-5e11-a61e-4473ca3b44bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27\\pi -9}{8}" :db/id #edb/ref 17592186528700} {:answer/id #uuid "a8b16dc0-ef14-5998-aff3-022fa9ad94bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi +72}{8}" :db/id #edb/ref 17592186528711} {:answer/id #uuid "b1addd5e-b739-5991-8970-6b78acd4e746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27\\pi -72}{8}" :db/id #edb/ref 17592186528732}] :answer-field/correct {:db/id #edb/ref 17592186528732} :answer-field/id #uuid "870af8e4-9463-5142-8458-8ef364ddaa4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529015}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3c3c2375-fac6-5465-bbbf-42c39eaebb70" :question/math-academy-id "q-123912" :question/problem "![](images/98/98bc6f2ea4d71368226f0f784d629e98949e07005bc08158206de35a87bea520.png)\n\nFind the area bounded by the polar curve $r=3-3\\operatorname{cos}⁡\\theta $ for $\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3-3\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=\\frac{3\\pi }{2}$ and ${\\theta }_{2}=2\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{3\\pi /2}^{2\\pi }(3-3\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{3\\pi /2}^{2\\pi }(9-18\\operatorname{cos}⁡\\theta +9{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{3\\pi /2}^{2\\pi }(1-2\\operatorname{cos}⁡\\theta +{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}(\\theta \\,{|}_{3\\pi /2}^{2\\pi }-2\\operatorname{sin}⁡\\theta \\,{|}_{3\\pi /2}^{2\\pi }+\\frac{1}{2}{\\int }_{3\\pi /2}^{2\\pi }(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{9}{2}(\\theta \\,{|}_{3\\pi /2}^{2\\pi }-2\\operatorname{sin}⁡\\theta \\,{|}_{3\\pi /2}^{2\\pi }+\\frac{1}{2}(\\theta \\,{|}_{3\\pi /2}^{2\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{3\\pi /2}^{2\\pi })) \\\\  & =\\frac{9}{2}(\\theta \\,{|}_{3\\pi /2}^{2\\pi }-2\\operatorname{sin}⁡\\theta \\,{|}_{3\\pi /2}^{2\\pi }+\\frac{1}{2}\\theta \\,{|}_{3\\pi /2}^{2\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{3\\pi /2}^{2\\pi }) \\\\  & =\\frac{27}{4}\\theta \\,{|}_{3\\pi /2}^{2\\pi }-9\\operatorname{sin}⁡\\theta \\,{|}_{3\\pi /2}^{2\\pi }+\\frac{9\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{3\\pi /2}^{2\\pi } \\\\  & =\\frac{27}{4}(2\\pi -\\frac{3\\pi }{2})-9(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡\\left(\\frac{3\\pi }{2}\\right))+\\frac{9}{8}(\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(3\\pi )) \\\\  & =\\frac{27\\pi }{8}-9+\\frac{9}{8}(0) \\\\  & =\\frac{27\\pi -72}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e8e637-7057-5738-bf7e-37e493294f83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186528302} {:answer/id #uuid "15e653f1-5de1-53ea-abbc-55ef743af9eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186528354} {:answer/id #uuid "41ba3cc1-a57c-5405-a9a7-4fc4022e386b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186528470} {:answer/id #uuid "4c18dc99-1f3e-572b-b474-4613ba1ccc54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186528490} {:answer/id #uuid "ba5b425b-9a81-5998-a220-805626423f1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186528755}] :answer-field/correct {:db/id #edb/ref 17592186528490} :answer-field/id #uuid "4a913a76-11e5-57cb-aec7-0eda0a258d42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528987}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3c7bf914-2de6-57ee-85dd-b40dcc8d6cfc" :question/math-academy-id "q-9640" :question/problem "![](images/7c/7ca646111a7708da96fa1bea8aca056abf0c45f9a4295e2beb27181d704aa814.png)\n\nFind the area bounded by the polar curve $r=2\\operatorname{cos}⁡(4\\theta )$ for $$\n\\displaystyle \\frac{\\pi }{8}\\le \\theta \\le \\frac{3\\pi }{8},\n$$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2\\operatorname{cos}⁡(4\\theta )$, ${\\theta }_{1}=\\frac{\\pi }{8}$ and ${\\theta }_{2}=\\frac{3\\pi }{8}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /8}^{3\\pi /8}(2\\operatorname{cos}⁡(4\\theta ))^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{\\pi /8}^{3\\pi /8}{\\cos }^{2}⁡(4\\theta )\\,\\text{d}\\theta  \\\\  & =2\\cdot \\frac{1}{2}{\\int }_{\\pi /8}^{3\\pi /8}(1+\\operatorname{cos}⁡(8\\theta ))\\,\\text{d}\\theta  \\\\  & =\\theta \\,{|}_{\\pi /8}^{3\\pi /8}+\\frac{1}{8}\\operatorname{sin}⁡(8\\theta )\\,{|}_{\\pi /8}^{3\\pi /8} \\\\  & =(\\frac{3\\pi }{8}-\\frac{\\pi }{8})+\\frac{1}{8}(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(\\pi )) \\\\  & =\\frac{\\pi }{4}+0 \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2531d59f-f2ae-5972-ad8d-0b5fd54daec2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186528397} {:answer/id #uuid "abfcd8a6-cfe4-579a-ae03-ab736d027afa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7\\pi }{3}" :db/id #edb/ref 17592186528718} {:answer/id #uuid "beed519c-f20b-5284-af42-9fbc05bb7cb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186528766} {:answer/id #uuid "cd6260e8-7e2e-517a-94a3-c2333c4374dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186528804} {:answer/id #uuid "e25642d2-500b-5440-8219-49e59a725b80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186528857}] :answer-field/correct {:db/id #edb/ref 17592186528804} :answer-field/id #uuid "68c55f83-abc0-585e-b0d0-0f5142052ec5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529002}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4870784d-cfa2-5882-86d4-3e6f72784ac7" :question/math-academy-id "q-11107" :question/problem "![](images/0f/0f94662dcae88371bb47d9748d002e38c6e521b0ba689e31e782ce288d266a58.png)\n\nConsider the finite region bounded by ${x}^{2}-{y}^{2}=2$ and ${x}^{2}-2{y}^{2}=1,$ where $x\\ge 0,$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Given that $x\\ge 0,$ writing our functions in terms of $y,$ we get the following:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2}=2\\, & ⟹\\,x=\\sqrt{2+{y}^{2}} \\\\ {x}^{2}-2{y}^{2}=1\\, & ⟹\\,x=\\sqrt{1+2{y}^{2}}.\\end{aligned}\n$$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}\\sqrt{2+{y}^{2}} & =\\sqrt{1+2{y}^{2}} \\\\ 2+{y}^{2} & =1+2{y}^{2} \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-1$ to $y=1.$    \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/41/4177abe03f95230a3176738cddbc556d2e4c3703fe72c1391a53c1ecb5f82181.png)\n\n  \n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=\\sqrt{1+2{y}^{2}},$ and\n\n- *leaves* through the outer function $x=\\sqrt{2+{y}^{2}}.$\n\nTherefore, the integral that gives our volume is:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}({[\\sqrt{2+{y}^{2}}]}^{2}-{[\\sqrt{1+2{y}^{2}}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}((2+{y}^{2})-(1+2{y}^{2}))\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}(1-{y}^{2})\\text{d}y \\\\  & =\\pi {(y-\\frac{{y}^{3}}{3})|}_{-1}^{1} \\\\  & =\\pi [(1-\\frac{1}{3})-((-1)+\\frac{1}{3})] \\\\  & =\\frac{4\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ac10f77-8ae8-588c-aa5b-9b166ef62be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>\\frac{1}{2}" :db/id #edb/ref 17592186528555} {:answer/id #uuid "a540c7ef-3a47-5316-a86d-0f235c9017d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\le \\frac{1}{2}" :db/id #edb/ref 17592186528699} {:answer/id #uuid "f9cf5cd1-885f-57c1-8fdd-a201868954c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<\\frac{1}{2}" :db/id #edb/ref 17592186528921}] :answer-field/correct {:db/id #edb/ref 17592186528699} :answer-field/id #uuid "82a1c564-8ed7-51bb-9100-2075924dd285" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529012} {:answer-field/choices [{:answer/id #uuid "db60b9e0-7805-5dcf-8f06-61d0c68bbd3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<\\frac{1}{3}" :db/id #edb/ref 17592186528844} {:answer/id #uuid "e3b33196-3002-5811-a611-63277072ea19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le \\frac{1}{3}" :db/id #edb/ref 17592186528862} {:answer/id #uuid "f7da83d4-0fe5-58e2-a525-0b995c402010" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>\\frac{1}{3}" :db/id #edb/ref 17592186528913}] :answer-field/correct {:db/id #edb/ref 17592186528913} :answer-field/id #uuid "9bda8146-8e80-5830-9a92-3b8225b2c958" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529024} {:answer-field/choices [{:answer/id #uuid "1221a838-7531-52e4-ae2a-e1fef6447f41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "and" :db/id #edb/ref 17592186528341} {:answer/id #uuid "6587c575-bbbb-538d-89ab-cb1869db242e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "or" :db/id #edb/ref 17592186528542}] :answer-field/correct {:db/id #edb/ref 17592186528542} :answer-field/id #uuid "f99f332a-f486-5c22-ada6-441f0984caf5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529085}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4e83f3e0-1564-59fb-a764-5da5f052add0" :question/math-academy-id "q-183299" :question/problem "$\\,$ $$\n\\displaystyle x\\le \\frac{1}{3}\\text{ and }y>\\frac{1}{2}.\n$$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" :question/worked-solution "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$$\n\\displaystyle x\\le \\frac{1}{3}\\text{ and }y>\\frac{1}{2}\n$$\" is\n\n$$\n\\begin{aligned}¬(x\\le \\frac{1}{3}\\text{ and }y>\\frac{1}{2}) & ≡¬(x\\le \\frac{1}{3}∧y>\\frac{1}{2}) \\\\  & ≡¬(x\\le \\frac{1}{3})∨¬(y>\\frac{1}{2}) \\\\  & ≡x>\\frac{1}{3}∨y\\le \\frac{1}{2} \\\\  & ≡x>\\frac{1}{3}\\text{ or }y\\le \\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "976b5925-40fb-5125-b552-7a9d7cec7fe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{27}" :db/id #edb/ref 17592186528659}] :answer-field/correct {:db/id #edb/ref 17592186528659} :answer-field/id #uuid "1cde64eb-fc8f-574e-a4b3-4a914b9a4d5e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186528953}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54f15411-79a5-546c-8ee4-965cb1e88cd5" :question/math-academy-id "q-350607" :question/problem "Evaluate the following series. Do not round the answer.\n\n$$\n\\displaystyle {\\sum }_{n=4}^{\\infty }{\\left(\\frac{2}{3}\\right)}^{n}=\n$$\n{{field-1}}" :question/worked-solution "First, note that the index $n$ starts from $4.$ However, it is still a geometric series because it is in the form\n$$\n\\displaystyle \\sum a{r}^{n}.\n$$\n\nIn this case, the first term is ${a}_{4},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{4} & ={\\left(\\frac{2}{3}\\right)}^{4}=\\frac{16}{81} \\\\ {a}_{5} & ={\\left(\\frac{2}{3}\\right)}^{5}=\\frac{32}{243}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{\\left(\\frac{32}{243}\\right)}{\\left(\\frac{16}{81}\\right)}=\\frac{2}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }{\\left(\\frac{2}{3}\\right)}^{n} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{\\left(\\frac{16}{81}\\right)}{(1-\\frac{2}{3})} \\\\  & =\\frac{\\left(\\frac{16}{81}\\right)}{\\left(\\frac{1}{3}\\right)} \\\\  & =\\frac{16}{27}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df9bedc8-89b3-5ab1-b0b3-a9b2ac3b4951" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186528847}] :answer-field/correct {:db/id #edb/ref 17592186528847} :answer-field/id #uuid "d13a95c4-8252-5e9e-aaed-c7750144cf3c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186529054}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56e0e8e1-0cfd-5d25-b2ed-327a18d60529" :question/math-academy-id "q-350582" :question/problem "Evaluate the following series. Do not round the answer.\n\n$$\n\\displaystyle {\\sum }_{n=1}^{\\infty }8{\\left(\\frac{3}{8}\\right)}^{n}=\n$$\n{{field-1}}" :question/worked-solution "Notice that the given series is a geometric series because it is in the form\n$$\n\\displaystyle \\sum a{r}^{n}.\n$$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=8{\\left(\\frac{3}{8}\\right)}^{1}=3.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{8{\\left(\\frac{3}{8}\\right)}^{2}}{8{\\left(\\frac{3}{8}\\right)}^{1}}=\\frac{3}{8}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }8{\\left(\\frac{3}{8}\\right)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{3}{(1-\\frac{3}{8})} \\\\  & =\\frac{3}{\\left(\\frac{5}{8}\\right)} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc33e925-2bf6-51a9-b4d5-52ab4d837e86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186528929}] :answer-field/correct {:db/id #edb/ref 17592186528929} :answer-field/id #uuid "77d5f4a7-be7e-5df2-a989-37fce15016eb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186529009}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c0c2f91-9457-576f-ab5b-77c8f4a530ad" :question/math-academy-id "q-350579" :question/problem "Evaluate the following series. Do not round the answer.\n\n$$\n\\displaystyle {\\sum }_{n=1}^{\\infty }4{\\left(\\frac{3}{5}\\right)}^{n}=\n$$\n{{field-1}}" :question/worked-solution "Notice that the given series is a geometric series because it is in the form\n$$\n\\displaystyle \\sum a{r}^{n}.\n$$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=4{\\left(\\frac{3}{5}\\right)}^{1}=\\frac{12}{5}.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{4{\\left(\\frac{3}{5}\\right)}^{2}}{4{\\left(\\frac{3}{5}\\right)}^{1}}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }4{\\left(\\frac{3}{5}\\right)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{\\left(\\frac{12}{5}\\right)}{(1-\\frac{3}{5})} \\\\  & =\\frac{\\left(\\frac{12}{5}\\right)}{\\left(\\frac{2}{5}\\right)} \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c77480c4-6dc8-5251-b1f4-72672af1b05e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{500\\pi}{3}" :db/id #edb/ref 17592186528786}] :answer-field/correct {:db/id #edb/ref 17592186528786} :answer-field/id #uuid "7c19b998-512f-50eb-99a5-8be35004295f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186529010}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "61a0b761-b748-5011-958d-51f405f814ac" :question/math-academy-id "q-362200" :question/problem "Consider the finite region bounded by $y=x+6$ and $y={x}^{2}.$ Find the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "Let $f(x)=x+6$ and $g(x)={x}^{2}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ x+6 & ={x}^{2} \\\\ {x}^{2}-x-6 & =0 \\\\ (x-3)(x+2) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=-2$ to $x=3.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/dd/dd8dc332f56d3b851647e5ed0fa8208eb5d3daf6e704a42ab5cffdb78ed78585.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={x}^{2},$ and\n\n- *leaves* through the outer function $y=f(x)=x+6.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{3}((x+6)^{2}-({x}^{2})^{2})\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{3}({x}^{2}+12x+36-{x}^{4})\\,\\text{d}x \\\\  & =\\pi (\\frac{{x}^{3}}{3}+6{x}^{2}+36x-\\frac{{x}^{5}}{5})\\,{|}_{-2}^{3} \\\\  & =\\pi [(\\frac{27}{3}+54+108-\\frac{243}{5})-(-\\frac{8}{3}+24-72+\\frac{32}{5})] \\\\  & =\\frac{500\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "622acefd-6fc4-5289-acf9-eacb640ce3ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+\\frac{13\\pi}{8}" :db/id #edb/ref 17592186528532}] :answer-field/correct {:db/id #edb/ref 17592186528532} :answer-field/id #uuid "2b1fe94c-bcca-5ef1-b698-9fc1476d4a23" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186528963}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63188c95-9ec2-54ce-9302-58600c7d5645" :question/math-academy-id "q-352326" :question/problem "![](images/7a/7ab46adacda52da11a07c783905161c6a6c8ebadb77423d7c70acdb17321a50e.png)\n\nFind the area $A$ bounded by the polar curve $r=3\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2},$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=3\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(3\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(9{\\sin }^{2}⁡\\theta +12\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(4+5{\\sin }^{2}⁡\\theta +12\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(4+\\frac{5(1-\\operatorname{cos}⁡(2\\theta ))}{2}+6\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\frac{13}{2}-\\frac{5}{2}\\operatorname{cos}⁡(2\\theta )+6\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{13}{2}\\theta -\\frac{5}{4}\\operatorname{sin}⁡(2\\theta )-3\\operatorname{cos}⁡(2\\theta )){|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\frac{13\\pi }{4}+6) \\\\  & =3+\\frac{13\\pi }{8} \\\\  & =\\frac{13\\pi +24}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354f5fb0-502e-5b97-96b1-1770af96065f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186528433} {:answer/id #uuid "390a92f2-20da-56ad-8a6d-81f1d663abf6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186528445} {:answer/id #uuid "4dd94adf-0738-5e8a-8201-c8eaf6da5741" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186528493} {:answer/id #uuid "688f977f-48f9-5555-8bb1-1d938d96b3a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186528550} {:answer/id #uuid "bd83ca4f-fc8b-5c42-9c89-2ce30742bfbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186528761}] :answer-field/correct {:db/id #edb/ref 17592186528493} :answer-field/id #uuid "d2a7c0e4-497b-555e-b210-485ed2c4815e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529055}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "63be8186-8026-5f56-8153-6a18a81d6ce3" :question/math-academy-id "q-44066" :question/problem "Let $V=C[0,2\\pi ]$ be the vector space of all functions that are continuous on $[0,2\\pi ],$ equipped with the inner product \n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{2\\pi }f(t)g(t)\\,\\text{d}t.\n$$\n\nGiven the functions $f(t)=\\operatorname{sin}⁡t$ and $g(t)=\\operatorname{cos}⁡(2t),$ which of the following statements are true?\n\nI. $⟨f(t),g(t)⟩=2\\pi $\n\nII. $⟨f(t),g(t)⟩=0$\n\nIII. $f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$\n\n*Hint: You may wish to make use of the identity $$\n\\displaystyle \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha -\\beta )+\\operatorname{sin}⁡(\\alpha +\\beta )).\n$$*" :question/worked-solution "We need to evaluate\n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡(2t)\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the given identity, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡(2t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡(t-2t)+\\operatorname{sin}⁡(t+2t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡(-t)+\\operatorname{sin}⁡(3t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }(-\\operatorname{sin}⁡t+\\operatorname{sin}⁡(3t))\\,\\text{d}t \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡t-\\frac{\\operatorname{cos}⁡(3t)}{3}){|}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}[\\operatorname{cos}⁡(2\\pi )-\\frac{\\operatorname{cos}⁡(6\\pi )}{3}]-\\frac{1}{2}[\\operatorname{cos}⁡0-\\frac{\\operatorname{cos}⁡0}{3}] \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}-\\frac{1}{2}\\cdot \\frac{2}{3} \\\\  & =0\\end{aligned}\n$$\n\nLet's now examine the statements:\n\n- Statement I is false, while statement II is true. This is as a result of the above calculations.\n\n- Statement III is true. Since the inner product is zero, our vectors must be orthogonal.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186529135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "460f98e6-2dad-5164-97ed-ca84fd3c06be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{8}" :db/id #edb/ref 17592186528475} {:answer/id #uuid "771fcce6-ddaf-54b3-a739-a6390529f5f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186528575} {:answer/id #uuid "b1e72018-e6e3-592b-880f-a6d48f3ebdb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186528734} {:answer/id #uuid "b294df79-b64d-5dcb-8a58-b77dd62b8429" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186528736} {:answer/id #uuid "e6233b81-6983-586a-81cd-f71c40f0288b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186528868}] :answer-field/correct {:db/id #edb/ref 17592186528734} :answer-field/id #uuid "4863b9c5-7c52-590c-ac4a-f95a2e691add" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528981}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "692ede8e-6241-512f-89fd-e5f23e8be1b4" :question/math-academy-id "q-9641" :question/problem "![](images/ed/ed702f9d982d599fc0f175dc7d7dd022aeefc3f5463aade2a9db71313faf4866.png)\n\nFind the area bounded by the polar curve $r=1+\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1+\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1+\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1+2\\operatorname{cos}⁡\\theta +{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}{\\int }_{0}^{\\pi }(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{0}^{\\pi })) \\\\  & =\\frac{3}{4}\\theta \\,{|}_{0}^{\\pi }+\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{8}\\operatorname{sin}⁡(2\\theta )\\,{|}_{0}^{\\pi } \\\\  & =\\frac{3}{4}(\\pi -0)+(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡0)+\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡0) \\\\  & =\\frac{3\\pi }{4}+0+\\frac{1}{8}(0) \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052804b5-ac12-5294-a262-e3fa2b590da2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186528315} {:answer/id #uuid "31321875-45ba-5d60-9460-76f9ff4b65bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186528422} {:answer/id #uuid "66deb24d-93e5-58be-9017-317a664a99a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186528546} {:answer/id #uuid "c902eb5b-0235-5da3-b574-a9735354dbe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186528792} {:answer/id #uuid "d7217da2-ae78-508a-874f-f889c1b07a86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186528836}] :answer-field/correct {:db/id #edb/ref 17592186528836} :answer-field/id #uuid "52b89aa0-9d44-5e08-ab59-3cc05bb04a17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528992}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "72ca9ca6-7469-59a8-9b29-546c35450d5e" :question/math-academy-id "q-146353" :question/problem "$$\n\\begin{aligned}f(x,y)=\\left\\{\\begin{aligned}\\frac{2+y-x}{3}, & 0\\le x\\le 1,\\,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\,{f}_{X}(x)=\\left\\{\\begin{aligned}\\frac{5-2x}{6}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional expected value $\\text{E}[Y\\,|\\,X=1].$" :question/worked-solution "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\left(\\frac{2+y-x}{3}\\right)}{\\left(\\frac{5-2x}{6}\\right)} \\\\  & =\\frac{2(2+y-x)}{5-2x},\\end{aligned}\n$$\n\n \n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNow, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x),$ we get\n\n$$\n{f}_{Y|X}(y\\,|\\,1)=\\frac{2(2+y-1)}{5-2\\cdot 1}=\\frac{2(1+y)}{3}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{2(1+y)}{3}\\text{d}y \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}(y+{y}^{2})\\text{d}y \\\\  & =\\frac{2}{3}{[\\frac{{y}^{2}}{2}+\\frac{{y}^{3}}{3}]}_{0}^{1} \\\\  & =\\frac{2}{3}[(\\frac{1}{2}+\\frac{1}{3})-0] \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bdef5ee-d3f3-562e-aecc-41aeb9ad117d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{5}" :db/id #edb/ref 17592186528330} {:answer/id #uuid "0f2772e5-3a67-5a55-9efd-47b34d382cca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186528334} {:answer/id #uuid "2105d49c-3838-5c6f-a36c-1a555b26bcd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186528392} {:answer/id #uuid "25c78422-62a4-52b1-bc72-b3de2ce6a592" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186528398} {:answer/id #uuid "2a9324da-a375-57dd-a2cb-31842855799b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186528408}] :answer-field/correct {:db/id #edb/ref 17592186528330} :answer-field/id #uuid "c15c1c6b-8e24-5b94-b478-74191ff0b0e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529042}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75a391e4-92f0-5306-8519-d804235fa403" :question/math-academy-id "q-78591" :question/problem "Evaluate the series $$\n\\displaystyle {\\sum }_{n=2}^{\\infty }{\\left(\\frac{4}{5}\\right)}^{n}.\n$$" :question/worked-solution "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & ={\\left(\\frac{4}{5}\\right)}^{2}=\\frac{16}{25} \\\\ {a}_{3} & ={\\left(\\frac{4}{5}\\right)}^{3}=\\frac{64}{125}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{\\left(\\frac{64}{125}\\right)}{\\left(\\frac{16}{25}\\right)}=\\frac{4}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }{\\left(\\frac{4}{5}\\right)}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{\\left(\\frac{16}{25}\\right)}{(1-\\frac{4}{5})} \\\\  & =\\frac{\\left(\\frac{16}{25}\\right)}{\\left(\\frac{1}{5}\\right)} \\\\  & =\\frac{16}{25}\\cdot 5 \\\\  & =\\frac{16}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1ffe733-727d-5ca8-9de6-2f0a4144bd80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186528896}] :answer-field/correct {:db/id #edb/ref 17592186528896} :answer-field/id #uuid "451b0468-1ab6-5622-abf5-d01927a565b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186528979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "858e5587-42fe-5f2f-94b7-94758f1a2164" :question/math-academy-id "q-348315" :question/problem "![](images/f3/f33fde62793530cfe8970a9fea690fc71036312483ea617088a8d0a663d5133a.png)\n\nFind the area $A$ bounded by the polar curve $r=2\\operatorname{cos}⁡(3\\theta )$ for $$\n\\displaystyle -\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{6},\n$$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta ,\n$$\n\nwhere $r(\\theta )=2\\operatorname{cos}⁡(3\\theta )$, ${\\theta }_{1}=-\\frac{\\pi }{6}$ and ${\\theta }_{2}=\\frac{\\pi }{6}.$ This gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}{(2\\operatorname{cos}⁡(3\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{-\\pi /6}^{\\pi /6}{\\cos }^{2}⁡(3\\theta )\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /6}^{\\pi /6}(1+\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta  \\\\  & =(\\theta +\\frac{1}{6}\\operatorname{sin}⁡(6\\theta )){|}_{-\\pi /6}^{\\pi /6} \\\\  & =(\\frac{\\pi }{6}-\\left(-\\frac{\\pi }{6}\\right))+\\frac{1}{6}(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡(-\\pi )) \\\\  & =\\frac{\\pi }{3}+0 \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf4aa39e-778f-58ff-8308-65c8627a83b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186528811}] :answer-field/correct {:db/id #edb/ref 17592186528811} :answer-field/id #uuid "e5704968-f186-54d5-a951-55effb0d3ff9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186529071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "85d4b81f-f257-5ee9-9249-f54ff8b0fda6" :question/math-academy-id "q-352298" :question/problem "Find the area $A$ bounded by the polar curve $r=4\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=4\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(4\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi /2}{\\cos }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =8\\cdot \\frac{1}{2}{\\int }_{0}^{\\pi /2}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =4\\theta \\,{|}_{0}^{\\pi /2}+2\\operatorname{sin}⁡(2\\theta )\\,{|}_{0}^{\\pi /2} \\\\  & =4(\\frac{\\pi }{2}-0)+2(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡0) \\\\  & =2\\pi +0 \\\\  & =2\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0b39530-de5a-5c77-986a-201fc9682d01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi" :db/id #edb/ref 17592186528730}] :answer-field/correct {:db/id #edb/ref 17592186528730} :answer-field/id #uuid "8d7cde26-15d1-5ea3-9851-e82954572829" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186529017}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86ea583e-6e3e-5bb4-93ab-14ccfe18681c" :question/math-academy-id "q-352297" :question/problem "Find the area $A$ bounded by the polar curve $r=2\\operatorname{cos}⁡\\theta $ for $$\n\\displaystyle -\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.\n$$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{-\\pi /2}^{\\pi /2}{\\cos }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2\\cdot \\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\theta \\,{|}_{-\\pi /2}^{\\pi /2}+\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /2}^{\\pi /2} \\\\  & =(\\frac{\\pi }{2}-\\left(-\\frac{\\pi }{2}\\right))+\\frac{1}{2}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )) \\\\  & =\\pi +0 \\\\  & =\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0689e233-9bc4-5d7a-a7c9-a4ddabcf8f8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{10}" :db/id #edb/ref 17592186528319} {:answer/id #uuid "33d5497e-3754-55e7-8f8c-02dbadf4046e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{15}" :db/id #edb/ref 17592186528427} {:answer/id #uuid "6362d776-a3dc-580c-8bc4-2d16e9c2b4e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186528535} {:answer/id #uuid "a7cc3b11-8155-534b-8103-47d2fb5e7672" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16\\pi }{15}" :db/id #edb/ref 17592186528707} {:answer/id #uuid "c8ecc4d4-4427-5ab6-86a2-60f434bcd1e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi }{14}" :db/id #edb/ref 17592186528791}] :answer-field/correct {:db/id #edb/ref 17592186528791} :answer-field/id #uuid "ae92ff64-4bee-5c75-a130-c0515196ac49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529031}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5df2e25-639b-5613-82c1-85dbfc89566d" :question/math-academy-id "q-11094" :question/problem "![](images/2b/2bf88537e9a37404dd10dd99769f6933879d07c1ffbb913adc2a4f52b11f48d6.png)\n\nConsider the finite region above bounded by $y=\\sqrt{x}$ and $y={x}^{3},$ as shown above. Calculate the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "Let $f(x)=\\sqrt{x}$ and $g(x)={x}^{3}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ \\sqrt{x} & ={x}^{3} \\\\ \\sqrt{x}-{x}^{3} & =0 \\\\ \\sqrt{x}(1-{x}^{5/2}) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ and $x=1.$ \n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/0c/0cdcf559f1498045d3d8cd725593da6adb0459addb1df7cc3c4167b2fd9b6214.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={x}^{3},$ and\n\n- *leaves* through the outer function $y=f(x)=\\sqrt{x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[\\sqrt{x}]}^{2}-{[{x}^{3}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}(x-{x}^{6})\\text{d}x \\\\  & =\\pi {(\\frac{{x}^{2}}{2}-\\frac{{x}^{7}}{7})|}_{0}^{1} \\\\  & =\\pi [(\\frac{1}{2}-\\frac{1}{7})-0] \\\\  & =\\frac{5\\pi }{14}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0fa857c-1d3e-5cf2-baa1-2ef2c08c36f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17\\pi}{3}+14\\sqrt{3}" :db/id #edb/ref 17592186528851}] :answer-field/correct {:db/id #edb/ref 17592186528851} :answer-field/id #uuid "ea42cbea-59a6-5df3-b3cd-da64d32d78f3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186529075}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "acc4627b-a75b-5710-8130-818c19bd3eef" :question/math-academy-id "q-352321" :question/problem "Find the area $A$ bounded by the polar curve $r=3+4\\operatorname{cos}⁡\\theta $ for $$\n\\displaystyle -\\frac{\\pi }{3}\\le \\theta \\le \\frac{\\pi }{3}.\n$$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3+4\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{3}$ and ${\\theta }_{2}=\\frac{\\pi }{3}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(3+4\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(9+24\\operatorname{cos}⁡\\theta +16{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(9+24\\operatorname{cos}⁡\\theta +8(1+\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(17\\theta +24\\operatorname{sin}⁡\\theta +4\\operatorname{sin}⁡(2\\theta )){|}_{-\\pi /3}^{\\pi /3} \\\\  & =\\frac{1}{2}(17\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+24\\operatorname{sin}⁡\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+4\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /3}^{\\pi /3}) \\\\  & =\\frac{17}{2}\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+12\\operatorname{sin}⁡\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+2\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /3}^{\\pi /3} \\\\  & =\\frac{17}{2}(\\frac{\\pi }{3}+\\frac{\\pi }{3})+12(\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{sin}⁡\\left(-\\frac{\\pi }{3}\\right))+2(\\operatorname{sin}⁡\\left(\\frac{2\\pi }{3}\\right)-\\operatorname{sin}⁡\\left(-\\frac{2\\pi }{3}\\right)) \\\\  & =\\frac{17\\pi }{3}+12(\\sqrt{3})+2(\\sqrt{3}) \\\\  & =\\frac{17\\pi }{3}+14\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53b1658a-0743-5f39-aa3b-81a36c8036ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{84\\pi }{5}" :db/id #edb/ref 17592186528502} {:answer/id #uuid "78780af1-b667-5db4-80fc-158b6cdd4cf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{384\\pi }{5}" :db/id #edb/ref 17592186528580} {:answer/id #uuid "a22fb4d8-f9d7-52f8-ba8d-91050811627a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{34\\pi }{5}" :db/id #edb/ref 17592186528691} {:answer/id #uuid "ac201446-7ce5-558f-be28-299a3a97fe4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{38\\pi }{5}" :db/id #edb/ref 17592186528719} {:answer/id #uuid "d3652865-5e1f-5c8f-897b-2f29a227539f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\pi }{5}" :db/id #edb/ref 17592186528828}] :answer-field/correct {:db/id #edb/ref 17592186528580} :answer-field/id #uuid "bac40885-b168-57ac-9764-80cef2e04f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529037}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bb5bb053-af9b-561d-bd9f-9db0ee360eaf" :question/math-academy-id "q-86145" :question/problem "Consider the finite region bounded by $x={y}^{2}-6$ and $x=-2.$ Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Let $f(y)={y}^{2}-6$ and $g(y)=-2.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ {y}^{2}-6 & =-2 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-2$ and $y=2.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/ba/ba9886ace429eee313ac208f7a8aebd93993c734e4382656dcf31ef15d04cd00.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)=-2,$ and\n\n- *leaves* through the outer function $x=f(y)={y}^{2}-6.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-2}^{2}({[{y}^{2}-6]}^{2}-{[-2]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-2}^{2}({y}^{4}-12{y}^{2}+32)\\text{d}y \\\\  & =\\pi {(\\frac{{y}^{5}}{5}-4{y}^{3}+32y)|}_{-2}^{2} \\\\  & =\\pi [(\\frac{32}{5}-32+64)-(-\\frac{32}{5}+32-64)] \\\\  & =\\frac{384\\pi }{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c49c4a-231f-5e98-b371-0e935a20a3ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186528305} {:answer/id #uuid "92fa2249-5af2-5ed4-b4f5-e80a0891b31b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186528650} {:answer/id #uuid "a59e2126-217b-588b-8ec1-c18e748c0160" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186528701} {:answer/id #uuid "c7e58acf-da9e-5137-9d01-db3f88e60768" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186528788} {:answer/id #uuid "d7d6410d-8ce9-57d1-9928-c24c78a23343" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186528837}] :answer-field/correct {:db/id #edb/ref 17592186528837} :answer-field/id #uuid "e0a449ce-c8fa-55c9-ab8d-6d9f7f6b2000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529067}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c0901d8a-5ab9-5481-aeea-fb9811603032" :question/math-academy-id "q-146256" :question/problem "$$\n\\begin{aligned}f(x,y)=\\left\\{\\begin{aligned}\\frac{3(x+y)}{4}, & 0<x\\le 2y,\\,\\,0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\,{f}_{Y}(y)=\\left\\{\\begin{aligned}3{y}^{2}, & 0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional expected value $\\text{E}[X\\,|\\,Y=1].$" :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{3(x+y)}{4}\\right)}{3{y}^{2}} \\\\  & =\\frac{(x+y)}{4{y}^{2}},\\end{aligned}\n$$\n\nwhere $0<x\\le 2y,\\,0<y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{(x+1)}{4}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{(x+1)}{4}\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({x}^{2}+x)\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{3}}{3}+\\frac{{x}^{2}}{2}]}_{0}^{2} \\\\  & =\\frac{1}{4}[(\\frac{8}{3}+2)-0] \\\\  & =\\frac{7}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12bfe273-020f-5d83-9faf-6cff62334849" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186528345} {:answer/id #uuid "2c31661b-2050-5fa7-bf5f-9b3a7ef311ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186528411} {:answer/id #uuid "2c61ae29-cae7-5ccc-a372-b73c4206fcc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186528412} {:answer/id #uuid "8559fe88-e67b-5f1b-bf3d-bbf3de7441ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186528617} {:answer/id #uuid "94cc8691-117b-5651-83f2-f780d14663d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186528653}] :answer-field/correct {:db/id #edb/ref 17592186528412} :answer-field/id #uuid "ec27395b-38a3-58fa-99e7-8f30382149a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529077}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d588b5a8-8a0c-5e4d-8e17-d8c93ee42445" :question/math-academy-id "q-78592" :question/problem "$$\n\\displaystyle {\\sum }_{n=2}^{\\infty }\\frac{1}{3}{\\left(\\frac{3}{5}\\right)}^{n}=\n$$" :question/worked-solution "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{3}{\\left(\\frac{3}{5}\\right)}^{2}=\\frac{1}{3}\\left(\\frac{9}{25}\\right)=\\frac{3}{25} \\\\ {a}_{3} & =\\frac{1}{3}{\\left(\\frac{3}{5}\\right)}^{3}=\\frac{1}{3}\\left(\\frac{27}{125}\\right)=\\frac{9}{125}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{\\left(\\frac{9}{125}\\right)}{\\left(\\frac{3}{25}\\right)}=\\frac{9}{125}\\cdot \\frac{25}{3}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }\\frac{1}{3}{\\left(\\frac{3}{5}\\right)}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{\\left(\\frac{3}{25}\\right)}{(1-\\frac{3}{5})} \\\\  & =\\frac{\\left(\\frac{3}{25}\\right)}{\\left(\\frac{2}{5}\\right)} \\\\  & =\\frac{3}{25}\\cdot \\frac{5}{2} \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a507d3-b82b-5812-b4bd-1a60a94b11a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{6}({[\\frac{1}{2}y-1]}^{2}-y+2)\\text{d}y" :db/id #edb/ref 17592186528337} {:answer/id #uuid "3531e655-6ae7-5b2d-ab95-2fc419eb17a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{4}({[\\frac{1}{2}y-1]}^{2}-y+2)\\text{d}y" :db/id #edb/ref 17592186528432} {:answer/id #uuid "b1c80ec3-99ea-519d-b6ba-11c8b1be9972" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{6}(\\sqrt{y-2}-\\frac{1}{2}y+1)\\text{d}y" :db/id #edb/ref 17592186528733} {:answer/id #uuid "b6ea001f-721c-5acf-821a-a0ad541670bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{6}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y" :db/id #edb/ref 17592186528745} {:answer/id #uuid "d2a469bb-c186-589c-8768-0ebb679178a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{4}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y" :db/id #edb/ref 17592186528825}] :answer-field/correct {:db/id #edb/ref 17592186528745} :answer-field/id #uuid "82f32dfc-9143-5166-b02d-1b46261da802" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529013}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d84428ea-0ba4-5227-96d6-43b34422e545" :question/math-academy-id "q-123365" :question/problem "![](images/55/55308256c72aaf122c04c0b7f3a987fccd72d2513dd4edb6cf0ea4ce857522e5.png)\n\nConsider the finite region bounded by $y=2x+2$ and $x=\\sqrt{y-2},$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "Writing our first function in terms of $y,$ we get \n\n$$\n\\begin{aligned}y=2x+2\\,⟹\\,x=\\frac{1}{2}y-1.\\end{aligned}\n$$\n\nLet $f(y)=\\frac{1}{2}y-1$ and $g(y)=\\sqrt{y-2}.$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ \\frac{1}{2}y-1 & =\\sqrt{y-2} \\\\ y-2 & =2\\sqrt{y-2} \\\\ (y-2)^{2} & =4(y-2) \\\\ (y-2)^{2}-4(y-2) & =0 \\\\ (y-2)((y-2)-4) & =0 \\\\ (y-2)(y-6) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=2$ to $y=6.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/8e/8e621715ded3c5ed527d2367785707939b1e3593707eaafe0b4c5e4509883e49.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=f(y)=\\frac{1}{2}y-1,$ and\n\n- *leaves* through the outer function $x=g(y)=\\sqrt{y-2}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{2}^{6}({[\\sqrt{y-2}]}^{2}-{[\\frac{1}{2}y-1]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{2}^{6}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad32293-81c4-5632-9b56-dce7d9c78668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186528328} {:answer/id #uuid "3bdb6d77-f65e-5ff5-becb-dd2f3d35c069" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186528453} {:answer/id #uuid "5c4e7ff3-16b6-51f5-a98c-6ce0c3972663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186528518} {:answer/id #uuid "843d0574-e70b-5e22-b58c-6a661198e3c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186528614} {:answer/id #uuid "b2433a72-ac85-5f1f-b794-39e122d2d8d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186528735}] :answer-field/correct {:db/id #edb/ref 17592186528453} :answer-field/id #uuid "5101b7ce-f6ad-523b-93e4-83e6665f500b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd479934-e321-5035-bf71-51bd7984a9a8" :question/math-academy-id "q-124588" :question/problem "Evaluate the series $$\n\\displaystyle {\\sum }_{n=2}^{\\infty }180{\\left(\\frac{1}{6}\\right)}^{n}.\n$$" :question/worked-solution "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & =180{\\left(\\frac{1}{6}\\right)}^{2}=5 \\\\ {a}_{3} & =180{\\left(\\frac{1}{6}\\right)}^{3}=\\frac{5}{6}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{\\left(\\frac{5}{6}\\right)}{5}=\\frac{1}{6}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }180{\\left(\\frac{1}{6}\\right)}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{5}{(1-\\frac{1}{6})} \\\\  & =\\frac{5}{\\left(\\frac{5}{6}\\right)} \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070e71d3-4fa0-5f24-95c6-4392df98055f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186528321} {:answer/id #uuid "358ce659-62c7-5b50-8b6a-72ee4e8e55df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186528435} {:answer/id #uuid "3ec18b62-e688-5729-8acb-74067dce2afa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186528461} {:answer/id #uuid "b575e07e-689b-50db-9fe4-49b41ddcdf6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186528744} {:answer/id #uuid "e072663c-1824-5e1b-a41f-e8be263083ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186528848}] :answer-field/correct {:db/id #edb/ref 17592186528848} :answer-field/id #uuid "160bbd50-69e6-5813-9152-8fb571501011" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528952}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df45f3a3-f545-5c42-98d5-edf671e88e36" :question/math-academy-id "q-124584" :question/problem "$$\n\\displaystyle {\\sum }_{n=1}^{\\infty }10{\\left(\\frac{3}{5}\\right)}^{n}=\n$$" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=10{\\left(\\frac{3}{5}\\right)}^{1}=6.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{10{\\left(\\frac{3}{5}\\right)}^{2}}{10{\\left(\\frac{3}{5}\\right)}^{1}}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }10{\\left(\\frac{3}{5}\\right)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{6}{(1-\\frac{3}{5})} \\\\  & =\\frac{6}{\\left(\\frac{2}{5}\\right)} \\\\  & =6\\cdot \\frac{5}{2} \\\\  & =15.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a3480c0-71b3-53a7-8e12-a5f45e9dc984" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186528369} {:answer/id #uuid "410edf4d-43bb-535f-8576-68374334c4b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186528467} {:answer/id #uuid "9a0391d6-60ff-509f-9126-d08627def1cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186528666} {:answer/id #uuid "d808212c-d12b-5613-8018-d3e5a2a5ce89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186528839} {:answer/id #uuid "fc743163-b80f-5adb-9a55-ae315a62a76c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186528930}] :answer-field/correct {:db/id #edb/ref 17592186528930} :answer-field/id #uuid "d3c44b61-550f-50e7-828e-641fd371090c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529058}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbd76d75-8ee7-5bcd-acb2-1f5ae9aa3787" :question/math-academy-id "q-67301" :question/problem "$$\n\\displaystyle {\\sum }_{n=1}^{\\infty }8{\\left(\\frac{3}{4}\\right)}^{n}=\n$$" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=8{\\left(\\frac{3}{4}\\right)}^{1}=6.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{8{\\left(\\frac{3}{4}\\right)}^{2}}{8{\\left(\\frac{3}{4}\\right)}^{1}}=\\frac{3}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }8{\\left(\\frac{3}{4}\\right)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{6}{(1-\\frac{3}{4})} \\\\  & =\\frac{6}{\\left(\\frac{1}{4}\\right)} \\\\  & =6\\cdot \\frac{4}{1} \\\\  & =24.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ef324f-e3e0-55de-bf8c-31d0adf63779" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186528317} {:answer/id #uuid "1433506f-2bda-51e6-9d54-5354fc116b88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186528350} {:answer/id #uuid "1d68d2b6-b709-52d4-a640-81aa11b499e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186528380} {:answer/id #uuid "76810779-d00b-5526-95a9-f6b537df2534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186528574} {:answer/id #uuid "ac4f0db2-b37d-5e05-b26f-af89dbb0df5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186528721}] :answer-field/correct {:db/id #edb/ref 17592186528574} :answer-field/id #uuid "b1e89487-9f71-5b83-9a7d-94bccae434fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529032}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "febf3d13-3a80-5fb8-bb8d-fc4ac7755bf9" :question/math-academy-id "q-146344" :question/problem "$$\n\\begin{aligned}f(x,y)=\\left\\{\\begin{aligned}1+y-x, & 0\\le x\\le 2y,\\,\\,0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\,{f}_{Y}(y)=\\left\\{\\begin{aligned}2y, & 0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional expected value $\\text{E}[X\\,|\\,Y=1].$" :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(1+y-x)}{2y},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 2y,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{(2-x)}{2}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{(2-x)}{2}\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}(2x-{x}^{2})\\text{d}x \\\\  & =\\frac{1}{2}{[{x}^{2}-\\frac{{x}^{3}}{3}]}_{0}^{2} \\\\  & =\\frac{1}{2}[(4-\\frac{8}{3})-0] \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bf30a48-c9e1-56ae-a6e7-d1c98a8ff3ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529217} {:answer/id #uuid "c73dcc5f-2dfd-545e-8686-1192c87baf69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529244}] :answer-field/correct {:db/id #edb/ref 17592186529217} :answer-field/id #uuid "6c836807-d3ab-5654-828e-8cfc6899a48e" :answer-field/key "$Q$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529226} {:answer-field/choices [{:answer/id #uuid "3352e3a8-a31e-5489-b928-3600c98b31be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529215} {:answer/id #uuid "7eea3389-ae38-5700-acdf-02838bc43de5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529233}] :answer-field/correct {:db/id #edb/ref 17592186529233} :answer-field/id #uuid "7319f1b7-7a37-5090-bc1d-79d9eee3c8d9" :answer-field/key "$\\det (Q)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529231} {:answer-field/choices [{:answer/id #uuid "59fb7559-abec-5a5a-8f38-66e0e05169a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529221} {:answer/id #uuid "edd1215a-893f-52eb-9b40-de5e574e65b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529249}] :answer-field/correct {:db/id #edb/ref 17592186529249} :answer-field/id #uuid "885ed53f-bd5b-5462-9002-72b92ffeea39" :answer-field/key "$Q$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529235}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0f86b247-8f09-549d-8811-1a1520e150f7" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n$$\nQ=\\begin{bmatrix}\\frac{4 \\sqrt{2}}{3} & -1 & \\frac{\\sqrt{2}}{2} \\\\ \\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2 & - \\sqrt{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\det (Q) & =\\begin{vmatrix}\\frac{4 \\sqrt{2}}{3} & -1 & \\frac{\\sqrt{2}}{2} \\\\ \\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2 & - \\sqrt{2}\\end{vmatrix} \\\\  & =\\frac{4 \\sqrt{2}}{3}\\begin{vmatrix}\\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ 2 & - \\sqrt{2}\\end{vmatrix}+1\\begin{vmatrix}\\frac{2 \\sqrt{2}}{3} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & - \\sqrt{2}\\end{vmatrix}+\\frac{\\sqrt{2}}{2}\\begin{vmatrix}\\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2\\end{vmatrix} \\\\  & =\\frac{4 \\sqrt{2}}{3}(- \\frac{3 \\sqrt{2}}{2}- \\sqrt{2})+1(- \\frac{4}{3}+\\frac{8}{3})+\\frac{\\sqrt{2}}{2}(\\frac{4 \\sqrt{2}}{3}+4 \\sqrt{2}) \\\\  & =\\frac{4 \\sqrt{2}}{3}\\cdot \\left(- \\frac{5 \\sqrt{2}}{2}\\right)+1\\cdot \\frac{4}{3}+\\frac{\\sqrt{2}}{2}\\cdot \\frac{16 \\sqrt{2}}{3} \\\\  & =- \\frac{20}{3}+\\frac{4}{3}+\\frac{16}{3} \\\\  & =0\\end{aligned}\n$$\n\nSince $\\det (Q)=0$, the matrix is singular. \n\nTherefore, only statements “$Q$ is a singular matrix” and $\\det (Q)=0$ are true."} {:db/id #edb/ref 17592186529214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "623acce1-fff7-50e6-838b-7b0788c7f4cc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529223} {:answer/id #uuid "6f989a4f-56c1-50c2-8a6c-3fc3965f7ada" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529228}] :answer-field/correct {:db/id #edb/ref 17592186529223} :answer-field/id #uuid "25dfb153-bf6c-5bc8-81b3-3f8c8e55fd75" :answer-field/key "$R$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529212} {:answer-field/choices [{:answer/id #uuid "6ea2a503-d065-55b2-8fd1-d25f4f09f9f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529227} {:answer/id #uuid "7a8e8b31-aab5-5ebf-9a6d-c0ce4e4dec83" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529232}] :answer-field/correct {:db/id #edb/ref 17592186529227} :answer-field/id #uuid "7227b94e-e860-5cf3-bd06-90e04b0b9867" :answer-field/key "$R$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529230} {:answer-field/choices [{:answer/id #uuid "0849452b-707f-5059-a47a-da630beb226a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529208} {:answer/id #uuid "fa6b1114-f6aa-5ce4-b2fd-bd99b174c462" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529251}] :answer-field/correct {:db/id #edb/ref 17592186529208} :answer-field/id #uuid "e852e547-0a05-5456-8b75-a7942f7d0613" :answer-field/key "$\\det (R)=\\frac{4}{5} - \\sqrt{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529248}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2eb19151-d434-5c12-a703-9c37eed13782" :question/problem "Which of the following statements are true regarding the matrix $R$ given below?\n\nSelect all that apply.\n\n$$\nR=\\begin{bmatrix}- \\frac{\\sqrt{2}}{2} & \\frac{2}{5} & - \\sqrt{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\det (R) & =\\begin{vmatrix}- \\frac{\\sqrt{2}}{2} & \\frac{2}{5} & - \\sqrt{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{vmatrix} \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)\\begin{vmatrix}\\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{vmatrix}+\\left(- \\frac{2}{5}\\right)\\begin{vmatrix}\\frac{\\sqrt{2}}{2} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & - \\frac{\\sqrt{2}}{2}\\end{vmatrix}+(- \\sqrt{2})\\begin{vmatrix}\\frac{\\sqrt{2}}{2} & \\frac{4}{5} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5}\\end{vmatrix} \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)(- \\frac{2 \\sqrt{2}}{5}- \\frac{3 \\sqrt{2}}{5})+\\left(- \\frac{2}{5}\\right)(- \\frac{1}{2}+\\frac{9}{4})+(- \\sqrt{2})(\\frac{\\sqrt{2}}{5}+\\frac{3 \\sqrt{2}}{5}) \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\sqrt{2})+\\left(- \\frac{2}{5}\\right)\\cdot \\frac{7}{4}+(- \\sqrt{2})\\cdot \\frac{4 \\sqrt{2}}{5} \\\\  & =1- \\frac{7}{10}- \\frac{8}{5} \\\\  & =- \\frac{13}{10}\\end{aligned}\n$$\n\nSince $\\det (R)=- \\frac{13}{10}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement “$R$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186529220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f10ee21-6b89-5e0f-a04a-e49bcfa4c907" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529218} {:answer/id #uuid "fe16b8a0-13d3-5554-8edd-ff60470da1a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529255}] :answer-field/correct {:db/id #edb/ref 17592186529255} :answer-field/id #uuid "283cd5ed-404d-513a-8b29-74966f63a5de" :answer-field/key "$D$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529213} {:answer-field/choices [{:answer/id #uuid "9bbf7977-41f6-5bb2-bc84-9b91b4aa2e00" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529239} {:answer/id #uuid "b655c0ce-1985-5548-8848-5fb9f83b43c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529242}] :answer-field/correct {:db/id #edb/ref 17592186529239} :answer-field/id #uuid "57424796-2385-5961-a89c-2d74ee068fcd" :answer-field/key "$\\det (D)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529219} {:answer-field/choices [{:answer/id #uuid "670467a6-e81c-5c99-be97-28f089cc9d37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529225} {:answer/id #uuid "db4c2f01-affa-593d-9e86-c0393439ae7e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529247}] :answer-field/correct {:db/id #edb/ref 17592186529247} :answer-field/id #uuid "fbad6dc2-1046-5c88-93da-58012356da43" :answer-field/key "$D$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529253}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "58253580-dd5c-51ba-b42f-aea83256773d" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n$$\nD=\\begin{bmatrix}- \\frac{3 \\sqrt{2}}{5} & \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ \\frac{3 \\sqrt{2}}{5} & - \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ - \\frac{3 \\sqrt{2}}{5} & \\frac{4}{5} & - \\frac{\\sqrt{2}}{4}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\det (D) & =\\begin{vmatrix}- \\frac{3 \\sqrt{2}}{5} & \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ \\frac{3 \\sqrt{2}}{5} & - \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ - \\frac{3 \\sqrt{2}}{5} & \\frac{4}{5} & - \\frac{\\sqrt{2}}{4}\\end{vmatrix} \\\\  & =\\left(- \\frac{3 \\sqrt{2}}{5}\\right)\\begin{vmatrix}- \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ \\frac{4}{5} & - \\frac{\\sqrt{2}}{4}\\end{vmatrix}+\\left(- \\frac{2}{5}\\right)\\begin{vmatrix}\\frac{3 \\sqrt{2}}{5} & \\frac{\\sqrt{2}}{4} \\\\ - \\frac{3 \\sqrt{2}}{5} & - \\frac{\\sqrt{2}}{4}\\end{vmatrix}+\\frac{\\sqrt{2}}{4}\\begin{vmatrix}\\frac{3 \\sqrt{2}}{5} & - \\frac{2}{5} \\\\ - \\frac{3 \\sqrt{2}}{5} & \\frac{4}{5}\\end{vmatrix} \\\\  & =\\left(- \\frac{3 \\sqrt{2}}{5}\\right)(\\frac{\\sqrt{2}}{10}- \\frac{\\sqrt{2}}{5})+\\left(- \\frac{2}{5}\\right)(- \\frac{3}{10}+\\frac{3}{10})+\\frac{\\sqrt{2}}{4}(\\frac{12 \\sqrt{2}}{25}- \\frac{6 \\sqrt{2}}{25}) \\\\  & =\\left(- \\frac{3 \\sqrt{2}}{5}\\right)\\cdot \\left(- \\frac{\\sqrt{2}}{10}\\right)+\\left(- \\frac{2}{5}\\right)\\cdot 0+\\frac{\\sqrt{2}}{4}\\cdot \\frac{6 \\sqrt{2}}{25} \\\\  & =\\frac{3}{25}+\\frac{3}{25} \\\\  & =\\frac{6}{25}\\end{aligned}\n$$\n\nSince $\\det (D)=\\frac{6}{25}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement “$D$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186529229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87861eb3-5f89-51bb-a83b-a2a2f34426b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529234} {:answer/id #uuid "fb3191b2-823c-5ff2-9063-c65501bb4dc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529252}] :answer-field/correct {:db/id #edb/ref 17592186529252} :answer-field/id #uuid "0187374c-e9df-5d8a-b2e7-160b085f7e8a" :answer-field/key "$D$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529206} {:answer-field/choices [{:answer/id #uuid "5e9331ae-3672-5960-a137-fec2b5ed94e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529222} {:answer/id #uuid "c78e9128-09e7-5dbd-8651-62e753136ca1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529245}] :answer-field/correct {:db/id #edb/ref 17592186529245} :answer-field/id #uuid "8e0b79b6-ad2c-596a-b49a-2f831ec2b99d" :answer-field/key "$\\det (D)=\\frac{7}{40}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529236} {:answer-field/choices [{:answer/id #uuid "8f014eef-cc68-5016-a321-04739726f29b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529237} {:answer/id #uuid "9792a9f2-799d-58ba-9247-36ec66135b4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529238}] :answer-field/correct {:db/id #edb/ref 17592186529238} :answer-field/id #uuid "a28fbb07-9011-5ca0-97ac-fffd6b36f2ee" :answer-field/key "$D$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529240}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "71433954-37ca-5812-b277-05c8f0f0a4e4" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n$$\nD=\\begin{bmatrix}- \\frac{\\sqrt{7}}{5} & 1 & - \\frac{3 \\sqrt{7}}{4} \\\\ - \\frac{\\sqrt{7}}{5} & \\frac{1}{2} & \\frac{\\sqrt{7}}{4} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\frac{3}{2} & \\sqrt{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\det (D) & =\\begin{vmatrix}- \\frac{\\sqrt{7}}{5} & 1 & - \\frac{3 \\sqrt{7}}{4} \\\\ - \\frac{\\sqrt{7}}{5} & \\frac{1}{2} & \\frac{\\sqrt{7}}{4} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\frac{3}{2} & \\sqrt{7}\\end{vmatrix} \\\\  & =\\left(- \\frac{\\sqrt{7}}{5}\\right)\\begin{vmatrix}\\frac{1}{2} & \\frac{\\sqrt{7}}{4} \\\\ \\frac{3}{2} & \\sqrt{7}\\end{vmatrix}+(-1)\\begin{vmatrix}- \\frac{\\sqrt{7}}{5} & \\frac{\\sqrt{7}}{4} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\sqrt{7}\\end{vmatrix}+\\left(- \\frac{3 \\sqrt{7}}{4}\\right)\\begin{vmatrix}- \\frac{\\sqrt{7}}{5} & \\frac{1}{2} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\frac{3}{2}\\end{vmatrix} \\\\  & =\\left(- \\frac{\\sqrt{7}}{5}\\right)(\\frac{\\sqrt{7}}{2}- \\frac{3 \\sqrt{7}}{8})+(-1)(- \\frac{7}{5}+\\frac{21}{20})+\\left(- \\frac{3 \\sqrt{7}}{4}\\right)(- \\frac{3 \\sqrt{7}}{10}+\\frac{3 \\sqrt{7}}{10}) \\\\  & =\\left(- \\frac{\\sqrt{7}}{5}\\right)\\cdot \\frac{\\sqrt{7}}{8}+(-1)\\cdot \\left(- \\frac{7}{20}\\right)+\\left(- \\frac{3 \\sqrt{7}}{4}\\right)\\cdot 0 \\\\  & =- \\frac{7}{40}+\\frac{7}{20} \\\\  & =\\frac{7}{40}\\end{aligned}\n$$\n\nSince $\\det (D)=\\frac{7}{40}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statements “$D$ is **not** a singular matrix” and $\\det (D)=\\frac{7}{40}$ are true."} {:db/id #edb/ref 17592186529250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e93d6b-04f6-5d4f-b5b6-d410c07da27b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529210} {:answer/id #uuid "ac318550-2f86-5de9-9b06-3ca0446a83ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529241}] :answer-field/correct {:db/id #edb/ref 17592186529210} :answer-field/id #uuid "c469465a-d12b-5568-8d4c-567bbab54c8b" :answer-field/key "$\\det (N)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529243} {:answer-field/choices [{:answer/id #uuid "48843694-108e-5d14-bd01-367c88bbda7b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529216} {:answer/id #uuid "66105f24-eeac-5dfa-906a-b29c7b525374" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529224}] :answer-field/correct {:db/id #edb/ref 17592186529216} :answer-field/id #uuid "caa6403a-374c-56a6-9e6e-eff87afdb677" :answer-field/key "$N$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529246} {:answer-field/choices [{:answer/id #uuid "0634ee5a-1fe4-5615-bb1f-de6045b61f9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186529207} {:answer/id #uuid "25008e01-79c7-58b7-aeed-e63a6324cfd6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186529211}] :answer-field/correct {:db/id #edb/ref 17592186529211} :answer-field/id #uuid "fd12a97e-9c51-5ed4-8b7d-226953a0be67" :answer-field/key "$N$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186529254}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f4817fa1-7160-5d08-adc7-564c3155c399" :question/problem "Which of the following statements are true regarding the matrix $N$ given below?\n\nSelect all that apply.\n\n$$\nN=\\begin{bmatrix}\\frac{2 \\sqrt{2}}{3} & 1 & 2 \\sqrt{2} \\\\ - \\frac{\\sqrt{2}}{3} & - \\frac{1}{3} & \\sqrt{2} \\\\ - \\frac{4 \\sqrt{2}}{3} & -2 & - 4 \\sqrt{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\det (N) & =\\begin{vmatrix}\\frac{2 \\sqrt{2}}{3} & 1 & 2 \\sqrt{2} \\\\ - \\frac{\\sqrt{2}}{3} & - \\frac{1}{3} & \\sqrt{2} \\\\ - \\frac{4 \\sqrt{2}}{3} & -2 & - 4 \\sqrt{2}\\end{vmatrix} \\\\  & =\\frac{2 \\sqrt{2}}{3}\\begin{vmatrix}- \\frac{1}{3} & \\sqrt{2} \\\\ -2 & - 4 \\sqrt{2}\\end{vmatrix}+(-1)\\begin{vmatrix}- \\frac{\\sqrt{2}}{3} & \\sqrt{2} \\\\ - \\frac{4 \\sqrt{2}}{3} & - 4 \\sqrt{2}\\end{vmatrix}+2 \\sqrt{2}\\begin{vmatrix}- \\frac{\\sqrt{2}}{3} & - \\frac{1}{3} \\\\ - \\frac{4 \\sqrt{2}}{3} & -2\\end{vmatrix} \\\\  & =\\frac{2 \\sqrt{2}}{3}(\\frac{4 \\sqrt{2}}{3}+2 \\sqrt{2})+(-1)(\\frac{8}{3}+\\frac{8}{3})+2 \\sqrt{2}(\\frac{2 \\sqrt{2}}{3}- \\frac{4 \\sqrt{2}}{9}) \\\\  & =\\frac{2 \\sqrt{2}}{3}\\cdot \\frac{10 \\sqrt{2}}{3}+(-1)\\cdot \\frac{16}{3}+2 \\sqrt{2}\\cdot \\frac{2 \\sqrt{2}}{9} \\\\  & =\\frac{40}{9}- \\frac{16}{3}+\\frac{8}{9} \\\\  & =0\\end{aligned}\n$$\n\nSince $\\det (N)=0$, the matrix is singular. \n\nTherefore, only statements “$N$ is a singular matrix” and $\\det (N)=0$ are true."} {:db/id #edb/ref 17592186529263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71a19f9f-c97f-5b22-a3fb-3ddd84649033" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529285} {:answer/id #uuid "7968a19d-81e4-508f-8ec6-11e1b7db0381" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529288} {:answer/id #uuid "cd558f16-0c95-5532-85ce-16a34dea6a67" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529319}] :answer-field/correct {:db/id #edb/ref 17592186529288} :answer-field/id #uuid "a88aecce-0e48-579b-8ac8-fffb289b1a69" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529308}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "22c76199-015b-5355-8da5-51b3e4eb6386" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}y + 2x + 4 &=0 \\\\ 4y - 4x + 9 &=0\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n2x + y &= -4 \\\\\n-4x + 4y &= -9\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}2x + y &=-4 && \\mid \\cdot (2) \\\\ -4x + 4y &=-9\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n4x + 2y &= -8 \\\\\n-4x + 4y &= -9 \\\\\n6y &= (-8 - 9) \\\\\n6y &= -17 \\\\\ny &= - \\frac{17}{6}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n2x + (1)\\left(- \\frac{17}{6}\\right) &= -4 \\\\\n2x &= - \\frac{7}{6} \\\\\nx &= - \\frac{7}{12}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{7}{12},- \\frac{17}{6})$."} {:db/id #edb/ref 17592186529265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "344db828-cf79-52e5-a777-8ab84b874966" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529268} {:answer/id #uuid "95396471-ccc2-5ee9-a8d6-43bc15e844c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529298} {:answer/id #uuid "dcdd0cde-b36f-54e5-a018-7db85e9b5a1f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529324}] :answer-field/correct {:db/id #edb/ref 17592186529268} :answer-field/id #uuid "65b4752f-c56d-5617-8e96-0a2d7a4fd12a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529281}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27a6ba63-3c85-5feb-bfac-b122a5e9f9a3" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-4x + 4y &=-9 \\\\ 2x - y &=-4\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the first equation:\n\n$$\n\\left\\{\\begin{aligned}-4x + 4y &=-9 \\\\ 2x - y &=-4 && \\mid \\cdot (2)\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-4x + 4y &= -9 \\\\\n4x - 2y &= -8 \\\\\n2y &= (-9 - 8) \\\\\n2y &= -17 \\\\\ny &= - \\frac{17}{2}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-4x + (4)\\left(- \\frac{17}{2}\\right) &= -9 \\\\\n-4x &= 25 \\\\\nx &= - \\frac{25}{4}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{25}{4},- \\frac{17}{2})$."} {:db/id #edb/ref 17592186529284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6a9c04-4483-5b31-88cd-fdc0d4f8dfab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529273} {:answer/id #uuid "6532299d-7242-529d-b584-f2d02d122b29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529280} {:answer/id #uuid "a3bb91a8-f370-546d-8650-fc4b5ac0f2bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529304}] :answer-field/correct {:db/id #edb/ref 17592186529304} :answer-field/id #uuid "571d0d37-8178-57f9-8598-a1a4ba418722" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529277}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6df7ea41-de66-50d4-b68f-ac8978094097" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}y - 3x + 1 &=0 \\\\ -3y - 6x - 8 &=0\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n-3x + y &= -1 \\\\\n-6x - 3y &= 8\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $-2$, then we will get a $6x$ term that can cancel with the $-6x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-3x + y &=-1 && \\mid \\cdot (-2) \\\\ -6x - 3y &=8\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n6x - 2y &= 2 \\\\\n-6x - 3y &= 8 \\\\\n-5y &= (2 + 8) \\\\\n-5y &= 10 \\\\\ny &= -2\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-3x + (1)(-2) &= -1 \\\\\n-3x &= 1 \\\\\nx &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{1}{3},-2)$."} {:db/id #edb/ref 17592186529294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aedf24db-2200-5c34-82c8-69e05734e790" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529313} {:answer/id #uuid "d688773d-636f-5a54-b4ee-355c9f396330" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529321} {:answer/id #uuid "f2dee143-55db-5cf5-83a5-24cd943aae58" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529329}] :answer-field/correct {:db/id #edb/ref 17592186529329} :answer-field/id #uuid "f5171cd4-7721-5fe2-926b-265c33c00b33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529330}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88e09a62-e93a-583d-86c5-5caff22bdcbd" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}6x + 2y &=0 \\\\ -3x + 5y &=-2\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $2$, then we will get a $-6x$ term that can cancel with the $6x$ term in the first equation:\n\n$$\n\\left\\{\\begin{aligned}6x + 2y &=0 \\\\ -3x + 5y &=-2 && \\text{multiply by } 2\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n6x + 2y &= 0 \\\\\n-6x + 10y &= -4 \\\\\n12y &= (0 - 4) \\\\\n12y &= -4 \\\\\ny &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n6x + (2)\\left(- \\frac{1}{3}\\right) &= 0 \\\\\n6x &= \\frac{2}{3} \\\\\nx &= \\frac{1}{9}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(\\frac{1}{9},- \\frac{1}{3})$.\n\nThe corresponding lines intersect at exactly one point."} {:db/id #edb/ref 17592186529307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5289c2-ae65-5854-8e71-5b033554cd5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529258} {:answer/id #uuid "81a01f27-1606-571b-a96b-5a5040320fbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529292} {:answer/id #uuid "9d492ab7-1bb8-5fc1-8c03-1d65e9d953d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529301}] :answer-field/correct {:db/id #edb/ref 17592186529301} :answer-field/id #uuid "a2ae9c90-b5af-556d-b9c0-2e84879f0db0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529303}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a81cacd7-ddb8-5f18-91b0-0d7142c96649" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}y - 3x - 4 &=0 \\\\ -2y + 12x + 10 &=0\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n-3x + y &= 4 \\\\\n12x - 2y &= -10\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $4$, then we will get a $-12x$ term that can cancel with the $12x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-3x + y &=4 && \\mid \\cdot (4) \\\\ 12x - 2y &=-10\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-12x + 4y &= 16 \\\\\n12x - 2y &= -10 \\\\\n2y &= (16 - 10) \\\\\n2y &= 6 \\\\\ny &= 3\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-3x + (1)(3) &= 4 \\\\\n-3x &= 1 \\\\\nx &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{1}{3},3)$."} {:db/id #edb/ref 17592186529316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72bba841-9529-5598-b921-f90b8dffbe5b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529286} {:answer/id #uuid "b27078db-ea72-5bd8-9115-2ea5343e2f7b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529315} {:answer/id #uuid "f96540d7-0eb1-5d77-a5ce-3fa81473a266" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529331}] :answer-field/correct {:db/id #edb/ref 17592186529315} :answer-field/id #uuid "6c1fbec3-c232-5078-a580-2f08b5aa37e3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529282}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c0b2af50-0676-5686-aa21-aed280aaa725" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-x - 5y &=-12 \\\\ 2x - 6y &=-4\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $2$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-x - 5y &=-12 && \\text{multiply by } 2 \\\\ 2x - 6y &=-4\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-2x - 10y &= -24 \\\\\n2x - 6y &= -4 \\\\\n-16y &= (-24 - 4) \\\\\n-16y &= -28 \\\\\ny &= \\frac{7}{4}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-x + (-5)\\left(\\frac{7}{4}\\right) &= -12 \\\\\n-x &= - \\frac{13}{4} \\\\\nx &= \\frac{13}{4}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(\\frac{13}{4},\\frac{7}{4})$.\n\nThe corresponding lines intersect at exactly one point."} {:db/id #edb/ref 17592186529318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f5d6e30-8e43-5909-9e9a-3a9af82fd1e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a single solution" :db/id #edb/ref 17592186529297} {:answer/id #uuid "9c1af611-f1dc-57a7-b4ff-1cd30b5d58d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529300} {:answer/id #uuid "a979b510-0d7a-5573-bce5-5f77d85dffa4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "no solutions" :db/id #edb/ref 17592186529310}] :answer-field/correct {:db/id #edb/ref 17592186529297} :answer-field/id #uuid "8eaf5b55-2fa9-5c35-a346-66798bb8f61b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186529296}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5970b8b-793c-585b-9c66-c8937f9714fc" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}x - 3y &=-6 \\\\ 4x - y &=-12\\end{aligned}\\right.\n$$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-4x$ term that can cancel with the $4x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}x - 3y &=-6 && \\mid \\cdot (-4) \\\\ 4x - y &=-12\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-4x + 12y &= 24 \\\\\n4x - y &= -12 \\\\\n11y &= (24 - 12) \\\\\n11y &= 12 \\\\\ny &= \\frac{12}{11}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\nx + (-3)\\left(\\frac{12}{11}\\right) &= -6 \\\\\nx &= - \\frac{30}{11} \\\\\nx &= - \\frac{30}{11}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{30}{11},\\frac{12}{11})$."} {:db/id #edb/ref 17592186529336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3158d5a7-3a0d-564b-b6fb-2802c49578ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 48 v^{2},\\,- 12 u,\\,72 u v^{2}⟩" :db/id #edb/ref 17592186529346} {:answer/id #uuid "4ebc0dc8-e1eb-526d-b156-67f24bff1e0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6 u,\\,0,\\,4⟩" :db/id #edb/ref 17592186529352} {:answer/id #uuid "8f662bdf-3426-541b-aeae-8f73c454cac5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 48 v^{2},\\,12 u,\\,72 u v^{2}⟩" :db/id #edb/ref 17592186529373} {:answer/id #uuid "9ac7215a-1e75-5bca-9b78-c47a51cd04cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨48 v^{2},\\,12 u,\\,- 72 u v^{2}⟩" :db/id #edb/ref 17592186529377} {:answer/id #uuid "b7bf49b0-96d5-5f6a-bf2a-ab30c93bed0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,12 v^{2},\\,2⟩" :db/id #edb/ref 17592186529387}] :answer-field/correct {:db/id #edb/ref 17592186529346} :answer-field/id #uuid "90974337-909a-5a06-b301-97712683285d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529374}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "079d695e-b3a6-59aa-920c-1ff665e1082b" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=3\\left({u}^{2}+1\\right),\\,y=4\\left({v}^{3}+1\\right),\\,z=2\\left(2u+v\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨3\\left({u}^{2}+1\\right),\\,4\\left({v}^{3}+1\\right),\\,2\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(2\\left(2u+v\\right))⟩ \\\\  & =⟨6 u,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(2\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,12 v^{2},\\,2⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3\\left(2u\\right) & 0 & 2\\left(2\\right) \\\\ 0 & 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 2\\left(2\\right) \\\\ 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}3\\left(2u\\right) & 2\\left(2\\right) \\\\ 0 & 2\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}3\\left(2u\\right) & 0 \\\\ 0 & 4\\left(3{v}^{2}\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 48 v^{2},\\,- 12 u,\\,72 u v^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "513c0ff2-0b40-5d28-ae4c-7dbd8c46d8e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 72 v^{2},\\,- 8 u,\\,18 u v^{2}⟩" :db/id #edb/ref 17592186529353} {:answer/id #uuid "5ae97bc8-ceab-539c-b279-77e85c4ec979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 72 v^{2},\\,8 u,\\,18 u v^{2}⟩" :db/id #edb/ref 17592186529357} {:answer/id #uuid "707eea66-3c70-52f8-96ff-83c9270232ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2 u,\\,0,\\,8⟩" :db/id #edb/ref 17592186529363} {:answer/id #uuid "e542ea0c-15b0-5e7c-bebb-9196a291740b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨72 v^{2},\\,8 u,\\,- 18 u v^{2}⟩" :db/id #edb/ref 17592186529403} {:answer/id #uuid "f6825be3-48b8-58cc-a7e1-1b5a5360a776" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,9 v^{2},\\,4⟩" :db/id #edb/ref 17592186529410}] :answer-field/correct {:db/id #edb/ref 17592186529353} :answer-field/id #uuid "17726b3e-da12-5100-9529-30dd30f97ab5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529338}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1f7b80e6-fd6c-56fc-be8d-0adb41e9046a" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx={u}^{2}+1,\\,y=3\\left({v}^{3}+1\\right),\\,z=4\\left(2u+v\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨{u}^{2}+1,\\,3\\left({v}^{3}+1\\right),\\,4\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}({u}^{2}+1),\\,\\frac{∂}{∂u}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(4\\left(2u+v\\right))⟩ \\\\  & =⟨2u,\\,0,\\,8⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}({u}^{2}),\\,\\frac{∂}{∂v}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(4\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,9 v^{2},\\,4⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2u & 0 & 4\\left(2\\right) \\\\ 0 & 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 4\\left(2\\right) \\\\ 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2u & 4\\left(2\\right) \\\\ 0 & 4\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}2u & 0 \\\\ 0 & 3\\left(3{v}^{2}\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 72 v^{2},\\,- 8 u,\\,18 u v^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e322d8-ea35-5e03-9ba3-b9169197298c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,\\,6 v,\\,u⟩" :db/id #edb/ref 17592186529335} {:answer/id #uuid "1f5939eb-96cb-569a-a36d-99edfcd63b12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3 u \\cos{(u )} - 6 v^{2},\\,- 2 u + 2 v,\\,12 v - 6 \\cos{(u )}⟩" :db/id #edb/ref 17592186529340} {:answer/id #uuid "5d22a2bd-bcc3-592e-a7f6-40f9aab6f703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3 u \\cos{(u )} - 6 v^{2},\\,2 u - 2 v,\\,12 v - 6 \\cos{(u )}⟩" :db/id #edb/ref 17592186529358} {:answer/id #uuid "7a398103-fe6d-5bb1-982f-5e9709d919e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,\\,3 \\cos{(u )},\\,v⟩" :db/id #edb/ref 17592186529365} {:answer/id #uuid "f26aabe8-b114-5c96-bf02-8440e5209761" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 3 u \\cos{(u )} + 6 v^{2},\\,2 u - 2 v,\\,- 12 v + 6 \\cos{(u )}⟩" :db/id #edb/ref 17592186529407}] :answer-field/correct {:db/id #edb/ref 17592186529340} :answer-field/id #uuid "46102bec-425d-5814-92d4-891a6a84571f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529350}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2f1ae609-38a0-53f0-baa0-900f6821dc85" :question/problem "Find the fundamental vector product of the surface defined by the equations\n\n$$\n\\displaystyle x = 2\\left(u + v\\right), y = 3\\left(v^{2} + \\sin u\\right), z = uv.\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2 u + 2 v,\\,3 v^{2} + 3 \\sin{(u )},\\,u v⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u + 2 v),\\,\\frac{∂}{∂u}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂u}(u v)⟩ \\\\  & =⟨2,\\,3 \\cos{(u )},\\,v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u + 2 v),\\,\\frac{∂}{∂v}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂v}(u v)⟩ \\\\  & =⟨2,\\,6 v,\\,u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 \\cos{(u )} & v \\\\ 2 & 6 v & u\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}3 \\cos{(u )} & v \\\\ 6 v & u\\end{vmatrix},\\,-\\begin{vmatrix}2 & v \\\\ 2 & u\\end{vmatrix},\\,\\begin{vmatrix}2 & 3 \\cos{(u )} \\\\ 2 & 6 v\\end{vmatrix}\\right\\rangle  \\\\  & =⟨(3 \\cos{(u )})(u)-(v)(6 v),\\,-[(2)(u)-(v)(2)],\\,(2)(6 v)-(3 \\cos{(u )})(2)⟩ \\\\  & =⟨3 u \\cos{(u )} - 6 v^{2},\\,- 2 u + 2 v,\\,12 v - 6 \\cos{(u )}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7302147c-799a-53fc-9de8-45d235aa655f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8 u,\\,0,\\,4⟩" :db/id #edb/ref 17592186529364} {:answer/id #uuid "a2e3ac65-4e72-576b-81d3-83baa3c9e6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨48 v^{2},\\,16 u,\\,- 96 u v^{2}⟩" :db/id #edb/ref 17592186529379} {:answer/id #uuid "c311f11d-ff39-5e16-a7cd-305794bdafae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 48 v^{2},\\,- 16 u,\\,96 u v^{2}⟩" :db/id #edb/ref 17592186529390} {:answer/id #uuid "d5132c66-a16e-5aaf-8021-9cfcf9dae875" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 48 v^{2},\\,16 u,\\,96 u v^{2}⟩" :db/id #edb/ref 17592186529399} {:answer/id #uuid "f82660ec-1d20-5f98-a30b-893b20483f22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,12 v^{2},\\,2⟩" :db/id #edb/ref 17592186529411}] :answer-field/correct {:db/id #edb/ref 17592186529390} :answer-field/id #uuid "97d1543c-ce7e-5c30-9e63-bcf33b02c1b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529376}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "34df8a07-4ac5-5db8-94ec-53489ab5c141" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=4\\left({u}^{2}+1\\right),\\,y=4\\left({v}^{3}+1\\right),\\,z=2\\left(2u+v\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨4\\left({u}^{2}+1\\right),\\,4\\left({v}^{3}+1\\right),\\,2\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(4\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(2\\left(2u+v\\right))⟩ \\\\  & =⟨8 u,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(4\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(2\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,12 v^{2},\\,2⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 4\\left(2u\\right) & 0 & 2\\left(2\\right) \\\\ 0 & 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 2\\left(2\\right) \\\\ 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}4\\left(2u\\right) & 2\\left(2\\right) \\\\ 0 & 2\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}4\\left(2u\\right) & 0 \\\\ 0 & 4\\left(3{v}^{2}\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 48 v^{2},\\,- 16 u,\\,96 u v^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "678770cb-842e-5e05-b487-43b37e01953a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-12,\\,8 e^{v},\\,6⟩" :db/id #edb/ref 17592186529362} {:answer/id #uuid "7e92ad08-43c8-5f16-bc7c-2fba47afaa13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,\\,0,\\,4⟩" :db/id #edb/ref 17592186529367} {:answer/id #uuid "ac60ce9d-5cfc-5603-8b92-38ff4555d026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨12,\\,- 8 e^{v},\\,-6⟩" :db/id #edb/ref 17592186529382} {:answer/id #uuid "ae160852-fc16-5a75-97b8-496d8b57ecb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,3,\\,- 4 e^{v}⟩" :db/id #edb/ref 17592186529383} {:answer/id #uuid "e811bfc6-8c6f-5dc9-955e-158552f9c970" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-12,\\,- 8 e^{v},\\,6⟩" :db/id #edb/ref 17592186529405}] :answer-field/correct {:db/id #edb/ref 17592186529362} :answer-field/id #uuid "52fa7d03-36ca-5ec6-a545-028ec9a3e3b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529355}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "536925ac-3a11-5824-b56c-c42c0cb5a4dc" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=2\\left(u\\right),\\,y=3\\left(v\\right),\\,z=4\\left(u-{e}^{v}\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2\\left(u\\right),\\,3\\left(v\\right),\\,4\\left(u-{e}^{v}\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2\\left(u\\right)),\\,\\frac{∂}{∂u}(3\\left(v\\right)),\\,\\frac{∂}{∂u}(4\\left(u-{e}^{v}\\right))⟩ \\\\  & =⟨2,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2\\left(u\\right)),\\,\\frac{∂}{∂v}(3\\left(v\\right)),\\,\\frac{∂}{∂v}(4\\left(u-{e}^{v}\\right))⟩ \\\\  & =⟨0,\\,3,\\,- 4 e^{v}⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2\\left(1\\right) & 0 & 4\\left(1\\right) \\\\ 0 & 3\\left(1\\right) & 4\\left(-{e}^{v}\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 4\\left(1\\right) \\\\ 3\\left(1\\right) & 4\\left(-{e}^{v}\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2\\left(1\\right) & 4\\left(1\\right) \\\\ 0 & 4\\left(-{e}^{v}\\right)\\end{vmatrix},\\,\\begin{vmatrix}2\\left(1\\right) & 0 \\\\ 0 & 3\\left(1\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨-12,\\,8 e^{v},\\,6⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d0c0d85-2f02-55dc-9473-202a33fde613" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3,\\,\\sin{(v )},\\,- v \\sin{(u )}⟩" :db/id #edb/ref 17592186529344} {:answer/id #uuid "3d18ed36-4dfa-5c0a-8d32-485072bbb2cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨u v \\sin{(u )} \\cos{(v )} + \\sin{(v )} \\cos{(u )},\\,- 3 \\cos{(u )},\\,3 u \\cos{(v )}⟩" :db/id #edb/ref 17592186529349} {:answer/id #uuid "a2a95bff-92b9-53c6-8fe5-0f0d43b2da54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,u \\cos{(v )},\\,\\cos{(u )}⟩" :db/id #edb/ref 17592186529378} {:answer/id #uuid "d47bf98b-95ef-5c6e-a01e-21e1f47b6e49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- u v \\sin{(u )} \\cos{(v )} - \\sin{(v )} \\cos{(u )},\\,3 \\cos{(u )},\\,- 3 u \\cos{(v )}⟩" :db/id #edb/ref 17592186529398} {:answer/id #uuid "e687c503-1567-58df-be9a-1878259734e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨u v \\sin{(u )} \\cos{(v )} + \\sin{(v )} \\cos{(u )},\\,3 \\cos{(u )},\\,3 u \\cos{(v )}⟩" :db/id #edb/ref 17592186529404}] :answer-field/correct {:db/id #edb/ref 17592186529349} :answer-field/id #uuid "f47863d9-76b7-508b-9a8f-b6a3c48353d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529408}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f82fba6-89f1-5c94-8cc8-c031a913d71e" :question/problem "Find the fundamental vector product of the surface generated by the vector-valued function $r(u,v)=⟨3\\left(u\\right),\\,u\\operatorname{sin}⁡v,\\,v\\operatorname{cos}⁡u⟩.$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3\\left(u\\right)),\\,\\frac{∂}{∂u}(u\\operatorname{sin}⁡v),\\,\\frac{∂}{∂u}(v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨3,\\,\\operatorname{sin}⁡v,\\,-v\\operatorname{sin}⁡u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3\\left(u\\right)),\\,\\frac{∂}{∂v}(u\\operatorname{sin}⁡v),\\,\\frac{∂}{∂v}(v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨0,\\,u\\operatorname{cos}⁡v,\\,\\operatorname{cos}⁡u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3\\left(1\\right) & \\operatorname{sin}⁡v & -v\\operatorname{sin}⁡u \\\\ 0 & u\\operatorname{cos}⁡v & \\operatorname{cos}⁡u\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}\\operatorname{sin}⁡v & -v\\operatorname{sin}⁡u \\\\ u\\operatorname{cos}⁡v & \\operatorname{cos}⁡u\\end{vmatrix},\\,-\\begin{vmatrix}3\\left(1\\right) & -v\\operatorname{sin}⁡u \\\\ 0 & \\operatorname{cos}⁡u\\end{vmatrix},\\,\\begin{vmatrix}3\\left(1\\right) & \\operatorname{sin}⁡v \\\\ 0 & u\\operatorname{cos}⁡v\\end{vmatrix}\\right\\rangle  \\\\  & =⟨\\operatorname{cos}⁡u\\operatorname{sin}⁡v+uv\\operatorname{sin}⁡u\\operatorname{cos}⁡v,\\,- 3 \\cos{(u )},\\,3 u \\cos{(v )}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c963dd3-a1f9-5682-99a3-17ca99265979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨9 u \\cos{(u )} - 18 v^{2},\\,9 u - 9 v,\\,18 v - 9 \\cos{(u )}⟩" :db/id #edb/ref 17592186529366} {:answer/id #uuid "948274ad-00c2-576b-8a46-9c49f17fea14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 9 u \\cos{(u )} + 18 v^{2},\\,9 u - 9 v,\\,- 18 v + 9 \\cos{(u )}⟩" :db/id #edb/ref 17592186529375} {:answer/id #uuid "af4abca4-9c9c-5890-99b9-eab3686e51f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3,\\,6 v,\\,3 u⟩" :db/id #edb/ref 17592186529384} {:answer/id #uuid "c99438fc-2a5a-57e6-8a6f-35fd0cb40dad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨9 u \\cos{(u )} - 18 v^{2},\\,- 9 u + 9 v,\\,18 v - 9 \\cos{(u )}⟩" :db/id #edb/ref 17592186529392} {:answer/id #uuid "ccaccd12-671f-52c4-8b18-a8e1d1b6a31c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3,\\,3 \\cos{(u )},\\,3 v⟩" :db/id #edb/ref 17592186529394}] :answer-field/correct {:db/id #edb/ref 17592186529392} :answer-field/id #uuid "0cf26bf8-7ae2-5ac3-aef1-b50aa10ab485" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529337}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a36ce165-471f-570d-9650-640cec5623fe" :question/problem "Find the fundamental vector product of the surface defined by the equations\n\n$$\n\\displaystyle x = 3\\left(u + v\\right), y = 3\\left(v^{2} + \\sin u\\right), z = 3\\left(uv\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨3 u + 3 v,\\,3 v^{2} + 3 \\sin{(u )},\\,3 u v⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3 u + 3 v),\\,\\frac{∂}{∂u}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂u}(3 u v)⟩ \\\\  & =⟨3,\\,3 \\cos{(u )},\\,3 v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3 u + 3 v),\\,\\frac{∂}{∂v}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂v}(3 u v)⟩ \\\\  & =⟨3,\\,6 v,\\,3 u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3 & 3 \\cos{(u )} & 3 v \\\\ 3 & 6 v & 3 u\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}3 \\cos{(u )} & 3 v \\\\ 6 v & 3 u\\end{vmatrix},\\,-\\begin{vmatrix}3 & 3 v \\\\ 3 & 3 u\\end{vmatrix},\\,\\begin{vmatrix}3 & 3 \\cos{(u )} \\\\ 3 & 6 v\\end{vmatrix}\\right\\rangle  \\\\  & =⟨(3 \\cos{(u )})(3 u)-(3 v)(6 v),\\,-[(3)(3 u)-(3 v)(3)],\\,(3)(6 v)-(3 \\cos{(u )})(3)⟩ \\\\  & =⟨9 u \\cos{(u )} - 18 v^{2},\\,- 9 u + 9 v,\\,18 v - 9 \\cos{(u )}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "517f96df-2944-53eb-b50d-17f1387e43ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨72 v^{2},\\,16 u,\\,- 36 u v^{2}⟩" :db/id #edb/ref 17592186529354} {:answer/id #uuid "64e9e700-d3cd-54f5-b9b2-d40f9cb5c9d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨4 u,\\,0,\\,8⟩" :db/id #edb/ref 17592186529360} {:answer/id #uuid "6685d10d-ae48-537c-b0e4-0a386d10674a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 72 v^{2},\\,16 u,\\,36 u v^{2}⟩" :db/id #edb/ref 17592186529361} {:answer/id #uuid "8352b7c2-83f1-5e9d-9d58-b6ea2e141b52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 72 v^{2},\\,- 16 u,\\,36 u v^{2}⟩" :db/id #edb/ref 17592186529368} {:answer/id #uuid "d39e64d9-d1b0-54f3-8894-9323b7b1df99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,9 v^{2},\\,4⟩" :db/id #edb/ref 17592186529397}] :answer-field/correct {:db/id #edb/ref 17592186529368} :answer-field/id #uuid "dc616a45-3e00-5d64-b7a9-e4fced4e40f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529401}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "afa8c161-9dec-5962-a3c6-b42a56e57915" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=2\\left({u}^{2}+1\\right),\\,y=3\\left({v}^{3}+1\\right),\\,z=4\\left(2u+v\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2\\left({u}^{2}+1\\right),\\,3\\left({v}^{3}+1\\right),\\,4\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(4\\left(2u+v\\right))⟩ \\\\  & =⟨4 u,\\,0,\\,8⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(4\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,9 v^{2},\\,4⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2\\left(2u\\right) & 0 & 4\\left(2\\right) \\\\ 0 & 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 4\\left(2\\right) \\\\ 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2\\left(2u\\right) & 4\\left(2\\right) \\\\ 0 & 4\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}2\\left(2u\\right) & 0 \\\\ 0 & 3\\left(3{v}^{2}\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 72 v^{2},\\,- 16 u,\\,36 u v^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2175fd76-0c56-57b8-9174-0002272778f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,3,\\,- 4 e^{v}⟩" :db/id #edb/ref 17592186529342} {:answer/id #uuid "23fff28c-98c6-517d-894e-e3ade0b85cc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-12,\\,4 e^{v},\\,3⟩" :db/id #edb/ref 17592186529343} {:answer/id #uuid "bef9218d-e0fe-5ce0-82f9-bf47cfd7d97b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨12,\\,- 4 e^{v},\\,-3⟩" :db/id #edb/ref 17592186529389} {:answer/id #uuid "d62667d1-734a-5e83-a94c-519d0e08464a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-12,\\,- 4 e^{v},\\,3⟩" :db/id #edb/ref 17592186529400} {:answer/id #uuid "e8db9f02-5e58-5d77-9a53-681489b491a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,\\,0,\\,4⟩" :db/id #edb/ref 17592186529406}] :answer-field/correct {:db/id #edb/ref 17592186529343} :answer-field/id #uuid "4775f4af-3673-54e1-9229-30258922e843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529351}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c43bafbb-27d1-589d-9395-34d1fb53b842" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=u,\\,y=3\\left(v\\right),\\,z=4\\left(u-{e}^{v}\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨u,\\,3\\left(v\\right),\\,4\\left(u-{e}^{v}\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(3\\left(v\\right)),\\,\\frac{∂}{∂u}(4\\left(u-{e}^{v}\\right))⟩ \\\\  & =⟨1,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(3\\left(v\\right)),\\,\\frac{∂}{∂v}(4\\left(u-{e}^{v}\\right))⟩ \\\\  & =⟨0,\\,3,\\,- 4 e^{v}⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 4\\left(1\\right) \\\\ 0 & 3\\left(1\\right) & 4\\left(-{e}^{v}\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 4\\left(1\\right) \\\\ 3\\left(1\\right) & 4\\left(-{e}^{v}\\right)\\end{vmatrix},\\,-\\begin{vmatrix}1 & 4\\left(1\\right) \\\\ 0 & 4\\left(-{e}^{v}\\right)\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 3\\left(1\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨-12,\\,4 e^{v},\\,3⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c01696f-1313-569d-b8dd-1b6ab93e698b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 12 v^{2},\\,- 12 u,\\,18 u v^{2}⟩" :db/id #edb/ref 17592186529339} {:answer/id #uuid "328d5447-3347-5040-9526-4d0f97f066b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨12 v^{2},\\,12 u,\\,- 18 u v^{2}⟩" :db/id #edb/ref 17592186529347} {:answer/id #uuid "8957384e-fa9c-5800-9b29-602d86892550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 12 v^{2},\\,12 u,\\,18 u v^{2}⟩" :db/id #edb/ref 17592186529370} {:answer/id #uuid "bc6fc1db-b13a-5b17-a1ee-f3152ebb05c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6 u,\\,0,\\,4⟩" :db/id #edb/ref 17592186529388} {:answer/id #uuid "d022c4c7-0c21-5bf5-99c0-d849f94827ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,3 v^{2},\\,2⟩" :db/id #edb/ref 17592186529396}] :answer-field/correct {:db/id #edb/ref 17592186529339} :answer-field/id #uuid "cb049baa-bb14-5762-b5a8-0e6bb3e655ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529393}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e182b79a-69d6-51fa-bb1c-78fc47b34b3a" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=3\\left({u}^{2}+1\\right),\\,y={v}^{3}+1,\\,z=2\\left(2u+v\\right).\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨3\\left({u}^{2}+1\\right),\\,{v}^{3}+1,\\,2\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}({v}^{3}+1),\\,\\frac{∂}{∂u}(2\\left(2u+v\\right))⟩ \\\\  & =⟨6 u,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}({v}^{3}+1),\\,\\frac{∂}{∂v}(2\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,3{v}^{2},\\,2⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3\\left(2u\\right) & 0 & 2\\left(2\\right) \\\\ 0 & 3{v}^{2} & 2\\left(1\\right)\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 2\\left(2\\right) \\\\ 3{v}^{2} & 2\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}3\\left(2u\\right) & 2\\left(2\\right) \\\\ 0 & 2\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}3\\left(2u\\right) & 0 \\\\ 0 & 3{v}^{2}\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 12 v^{2},\\,- 12 u,\\,18 u v^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "893aedc5-d336-51fd-a323-6bc046fac648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8 u,\\,0,\\,2⟩" :db/id #edb/ref 17592186529369} {:answer/id #uuid "8d182813-aebd-50d7-b3b8-2aae19e921af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨12 v^{2},\\,8 u,\\,- 48 u v^{2}⟩" :db/id #edb/ref 17592186529372} {:answer/id #uuid "a76d51bc-cc84-5183-8de3-86672a302969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 12 v^{2},\\,- 8 u,\\,48 u v^{2}⟩" :db/id #edb/ref 17592186529381} {:answer/id #uuid "b7590c8f-53c2-5e60-abe5-94dba4b54823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,6 v^{2},\\,1⟩" :db/id #edb/ref 17592186529386} {:answer/id #uuid "cf34330c-97e2-5157-b920-b9f0ebafbfa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- 12 v^{2},\\,8 u,\\,48 u v^{2}⟩" :db/id #edb/ref 17592186529395}] :answer-field/correct {:db/id #edb/ref 17592186529381} :answer-field/id #uuid "8a9644d7-6a0d-58f4-8f95-fffe69d2cb42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529371}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5c049c6-8f99-5422-a42e-c9b464f4ec2b" :question/problem "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=4\\left({u}^{2}+1\\right),\\,y=2\\left({v}^{3}+1\\right),\\,z=2u+v.\n$$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨4\\left({u}^{2}+1\\right),\\,2\\left({v}^{3}+1\\right),\\,2u+v⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(4\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(2\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(2u+v)⟩ \\\\  & =⟨8 u,\\,0,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(4\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(2\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(2u+v)⟩ \\\\  & =⟨0,\\,6 v^{2},\\,1⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 4\\left(2u\\right) & 0 & 2 \\\\ 0 & 2\\left(3{v}^{2}\\right) & 1\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 2 \\\\ 2\\left(3{v}^{2}\\right) & 1\\end{vmatrix},\\,-\\begin{vmatrix}4\\left(2u\\right) & 2 \\\\ 0 & 1\\end{vmatrix},\\,\\begin{vmatrix}4\\left(2u\\right) & 0 \\\\ 0 & 2\\left(3{v}^{2}\\right)\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 12 v^{2},\\,- 8 u,\\,48 u v^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136b59f4-a9e4-5d8c-b869-dad46630033a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13\\,\\text{min}" :db/id #edb/ref 17592186529422} {:answer/id #uuid "461e25d2-998f-5231-9ad9-048327e6eb31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,\\text{min}" :db/id #edb/ref 17592186529433} {:answer/id #uuid "8ce962ca-5f25-5bd0-8fc8-ea3116721951" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24\\,\\text{min}" :db/id #edb/ref 17592186529450} {:answer/id #uuid "90c189d5-a421-5b5e-906b-c9e5138b97ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{min}" :db/id #edb/ref 17592186529452} {:answer/id #uuid "9ab3b094-2f4a-5213-b0de-26f0f8cd39f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,\\text{min}" :db/id #edb/ref 17592186529455}] :answer-field/correct {:db/id #edb/ref 17592186529422} :answer-field/id #uuid "95c3cd81-387f-52f6-8598-4e98964b059c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529453}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "08518a50-98e2-5d9c-a6f5-59dc1a4a2277" :question/problem "A heated metal body cools in a room at ${18}^{∘}\\text{C}.$ Its temperature is ${60}^{∘}\\text{C}$ after $3$ minutes and ${39}^{∘}\\text{C}$ after $7$ minutes. The temperature $T(t)$, in degrees Celsius, obeys Newton's law of cooling, with $t$ measured in minutes since cooling began. To the nearest minute, how long after cooling began does the body reach ${25}^{∘}\\text{C}$?" :question/retired true :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the inhibited decay equation\n\n$$\n\\frac{dT}{dt}=-k(T-18),\\qquad k>0.\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-18} & =-k\\,dt \\\\ \\int \\frac{dT}{T-18} & =-k\\int dt \\\\ \\operatorname{ln}⁡|T-18| & =-kt+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-18>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-18 & ={e}^{-kt+C} \\\\ T-18 & ={e}^{C}{e}^{-kt} \\\\ T-18 & =K{e}^{-kt} \\\\ T & =18+K{e}^{-kt}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nApply the two observed conditions $T(3)=60$ and $T(7)=39$:\n\n$$\n\\begin{aligned}60 & =18+Ke^{-3k} \\\\ 42 & =Ke^{-3k} \\\\ 39 & =18+Ke^{-7k} \\\\ 21 & =Ke^{-7k}\\end{aligned}\n$$\n\nDivide the excess temperatures to eliminate $K$, then take natural logarithms:\n\n$$\n\\begin{aligned}\\frac{21}{42} & =\\frac{Ke^{-7k}}{Ke^{-3k}} \\\\ \\frac{1}{2} & =e^{-4k} \\\\ \\ln\\left(\\frac{1}{2}\\right) & =-4k \\\\ k & =\\frac{\\ln{\\left(2 \\right)}}{4}\\end{aligned}\n$$\n\nNow substitute this rate into $T(3)=60$ to determine the constant:\n\n$$\n\\begin{aligned}42 & =Ke^{-3\\left(\\frac{\\ln{\\left(2 \\right)}}{4}\\right)} \\\\ K & =42e^{3\\left(\\frac{\\ln{\\left(2 \\right)}}{4}\\right)} \\\\ K & =42\\left(\\frac{42}{21}\\right)^{\\frac{3}{4}}\\end{aligned}\n$$\n\nTherefore, the solution satisfying both observations is\n\n$$\nT(t)=18+42\\left(\\frac{42}{21}\\right)^{\\frac{3}{4}}e^{-\\left(\\frac{\\ln{\\left(2 \\right)}}{4}\\right)t}.\n$$\n\nSubstituting the two observation times confirms the model:\n\n$$\n\\begin{aligned}T(3) & =18+(42\\left(\\frac{42}{21}\\right)^{\\frac{3}{4}})e^{-\\left(\\frac{\\ln{\\left(2 \\right)}}{4}\\right)\\cdot 3}=60 \\\\ T(7) & =18+(42\\left(\\frac{42}{21}\\right)^{\\frac{3}{4}})e^{-\\left(\\frac{\\ln{\\left(2 \\right)}}{4}\\right)\\cdot 7}=39\\end{aligned}\n$$\n\nFinally, let ${t}_{1}$ be the time when the body reaches ${25}^{∘}\\text{C}.$ Then, we have\n\n$$\n\\begin{aligned}T({t}_{1}) & =25 \\\\ 18+Ke^{-k{t}_{1}} & =25 \\\\ Ke^{-k{t}_{1}} & =7 \\\\ e^{-k{t}_{1}} & =\\frac{7}{K} \\\\ -k{t}_{1} & =\\ln\\left(\\frac{7}{K}\\right) \\\\ {t}_{1} & =-\\frac{1}{k}\\ln\\left(\\frac{7}{K}\\right)\\end{aligned}\n$$\n\nSubstitute the values of $K$ and $k$ to obtain the time measured since cooling began:\n\n$$\n\\begin{aligned}{t}_{1} & =-\\frac{1}{\\frac{\\ln{\\left(2 \\right)}}{4}}\\ln\\left(\\frac{7}{42\\left(\\frac{42}{21}\\right)^{\\frac{3}{4}}}\\right) \\\\ {t}_{1} & =3+4\\frac{\\ln\\left(\\frac{1}{6}\\right)}{\\ln\\left(\\frac{1}{2}\\right)}≈13\\,\\text{min}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2061e414-b4ea-5c57-ad60-fc9a5c241449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,\\text{min}" :db/id #edb/ref 17592186529425} {:answer/id #uuid "3148407a-a1b7-5be3-ae1b-0b7c3252c208" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19\\,\\text{min}" :db/id #edb/ref 17592186529429} {:answer/id #uuid "642227aa-f6b5-5f2c-9789-1258fcc2941b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\,\\text{min}" :db/id #edb/ref 17592186529439} {:answer/id #uuid "81dae93e-910d-5d6a-839a-efb7b838187c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36\\,\\text{min}" :db/id #edb/ref 17592186529447} {:answer/id #uuid "84a07af3-e9fe-57c9-9b86-f82e9bbbe6bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,\\text{min}" :db/id #edb/ref 17592186529449}] :answer-field/correct {:db/id #edb/ref 17592186529429} :answer-field/id #uuid "ab2a34ec-9222-55be-9af3-842e7b4fe46d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529457}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "55811d49-71e0-57b3-9d4a-d1c8d9d4f58f" :question/problem "A heated metal body cools in a room at ${12}^{∘}\\text{C}.$ Its temperature is ${64}^{∘}\\text{C}$ after $1$ minute and ${49}^{∘}\\text{C}$ after $4$ minutes. The temperature $T(t)$, in degrees Celsius, obeys Newton's law of cooling, with $t$ measured in minutes since cooling began. To the nearest minute, how long after cooling began does the body reach ${19}^{∘}\\text{C}$?" :question/retired true :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the inhibited decay equation\n\n$$\n\\frac{dT}{dt}=-k(T-12),\\qquad k>0.\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-12} & =-k\\,dt \\\\ \\int \\frac{dT}{T-12} & =-k\\int dt \\\\ \\operatorname{ln}⁡|T-12| & =-kt+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-12>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-12 & ={e}^{-kt+C} \\\\ T-12 & ={e}^{C}{e}^{-kt} \\\\ T-12 & =K{e}^{-kt} \\\\ T & =12+K{e}^{-kt}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nApply the two observed conditions $T(1)=64$ and $T(4)=49$:\n\n$$\n\\begin{aligned}64 & =12+Ke^{-1k} \\\\ 52 & =Ke^{-1k} \\\\ 49 & =12+Ke^{-4k} \\\\ 37 & =Ke^{-4k}\\end{aligned}\n$$\n\nDivide the excess temperatures to eliminate $K$, then take natural logarithms:\n\n$$\n\\begin{aligned}\\frac{37}{52} & =\\frac{Ke^{-4k}}{Ke^{-1k}} \\\\ \\frac{37}{52} & =e^{-3k} \\\\ \\ln\\left(\\frac{37}{52}\\right) & =-3k \\\\ k & =- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}\\end{aligned}\n$$\n\nNow substitute this rate into $T(1)=64$ to determine the constant:\n\n$$\n\\begin{aligned}52 & =Ke^{-1\\left(- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}\\right)} \\\\ K & =52e^{1\\left(- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}\\right)} \\\\ K & =52\\left(\\frac{52}{37}\\right)^{\\frac{1}{3}}\\end{aligned}\n$$\n\nTherefore, the solution satisfying both observations is\n\n$$\nT(t)=12+52\\left(\\frac{52}{37}\\right)^{\\frac{1}{3}}e^{-\\left(- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}\\right)t}.\n$$\n\nSubstituting the two observation times confirms the model:\n\n$$\n\\begin{aligned}T(1) & =12+(52\\left(\\frac{52}{37}\\right)^{\\frac{1}{3}})e^{-\\left(- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}\\right)\\cdot 1}=64 \\\\ T(4) & =12+(52\\left(\\frac{52}{37}\\right)^{\\frac{1}{3}})e^{-\\left(- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}\\right)\\cdot 4}=49\\end{aligned}\n$$\n\nFinally, let ${t}_{1}$ be the time when the body reaches ${19}^{∘}\\text{C}.$ Then, we have\n\n$$\n\\begin{aligned}T({t}_{1}) & =19 \\\\ 12+Ke^{-k{t}_{1}} & =19 \\\\ Ke^{-k{t}_{1}} & =7 \\\\ e^{-k{t}_{1}} & =\\frac{7}{K} \\\\ -k{t}_{1} & =\\ln\\left(\\frac{7}{K}\\right) \\\\ {t}_{1} & =-\\frac{1}{k}\\ln\\left(\\frac{7}{K}\\right)\\end{aligned}\n$$\n\nSubstitute the values of $K$ and $k$ to obtain the time measured since cooling began:\n\n$$\n\\begin{aligned}{t}_{1} & =-\\frac{1}{- \\frac{\\ln{\\left(\\frac{37}{52} \\right)}}{3}}\\ln\\left(\\frac{7}{52\\left(\\frac{52}{37}\\right)^{\\frac{1}{3}}}\\right) \\\\ {t}_{1} & =1+3\\frac{\\ln\\left(\\frac{7}{52}\\right)}{\\ln\\left(\\frac{37}{52}\\right)}≈19\\,\\text{min}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "035a9a44-7a16-5905-a0dc-77a5358cf6b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\,\\text{min}" :db/id #edb/ref 17592186529417} {:answer/id #uuid "09046438-fbef-58e9-b053-5d1dfaf0a2ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30\\,\\text{min}" :db/id #edb/ref 17592186529419} {:answer/id #uuid "230162fd-bc9d-51be-85ce-5f37c00f2f06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "58\\,\\text{min}" :db/id #edb/ref 17592186529427} {:answer/id #uuid "73a7a8ba-22d0-5b55-b3ed-cf04f2684bc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28\\,\\text{min}" :db/id #edb/ref 17592186529443} {:answer/id #uuid "fcb1a3a5-87a1-5709-994d-fc4337d0f0cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{min}" :db/id #edb/ref 17592186529465}] :answer-field/correct {:db/id #edb/ref 17592186529419} :answer-field/id #uuid "21da3e90-7194-505b-be0e-0a0a44ad7031" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186529426}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "57bd2c5d-2ec7-5e40-ac6f-231dd6ea513e" :question/problem "A heated metal body cools in a room at ${23}^{∘}\\text{C}.$ Its temperature is ${110}^{∘}\\text{C}$ after $2$ minutes and ${62}^{∘}\\text{C}$ after $8$ minutes. The temperature $T(t)$, in degrees Celsius, obeys Newton's law of cooling, with $t$ measured in minutes since cooling began. To the nearest minute, how long after cooling began does the body reach ${25}^{∘}\\text{C}$?" :question/retired true :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the inhibited decay equation\n\n$$\n\\frac{dT}{dt}=-k(T-23),\\qquad k>0.\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-23} & =-k\\,dt \\\\ \\int \\frac{dT}{T-23} & =-k\\int dt \\\\ \\operatorname{ln}⁡|T-23| & =-kt+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-23>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-23 & ={e}^{-kt+C} \\\\ T-23 & ={e}^{C}{e}^{-kt} \\\\ T-23 & =K{e}^{-kt} \\\\ T & =23+K{e}^{-kt}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nApply the two observed conditions $T(2)=110$ and $T(8)=62$:\n\n$$\n\\begin{aligned}110 & =23+Ke^{-2k} \\\\ 87 & =Ke^{-2k} \\\\ 62 & =23+Ke^{-8k} \\\\ 39 & =Ke^{-8k}\\end{aligned}\n$$\n\nDivide the excess temperatures to eliminate $K$, then take natural logarithms:\n\n$$\n\\begin{aligned}\\frac{39}{87} & =\\frac{Ke^{-8k}}{Ke^{-2k}} \\\\ \\frac{13}{29} & =e^{-6k} \\\\ \\ln\\left(\\frac{13}{29}\\right) & =-6k \\\\ k & =- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}\\end{aligned}\n$$\n\nNow substitute this rate into $T(2)=110$ to determine the constant:\n\n$$\n\\begin{aligned}87 & =Ke^{-2\\left(- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}\\right)} \\\\ K & =87e^{2\\left(- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}\\right)} \\\\ K & =87\\left(\\frac{87}{39}\\right)^{\\frac{1}{3}}\\end{aligned}\n$$\n\nTherefore, the solution satisfying both observations is\n\n$$\nT(t)=23+87\\left(\\frac{87}{39}\\right)^{\\frac{1}{3}}e^{-\\left(- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}\\right)t}.\n$$\n\nSubstituting the two observation times confirms the model:\n\n$$\n\\begin{aligned}T(2) & =23+(87\\left(\\frac{87}{39}\\right)^{\\frac{1}{3}})e^{-\\left(- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}\\right)\\cdot 2}=110 \\\\ T(8) & =23+(87\\left(\\frac{87}{39}\\right)^{\\frac{1}{3}})e^{-\\left(- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}\\right)\\cdot 8}=62\\end{aligned}\n$$\n\nFinally, let ${t}_{1}$ be the time when the body reaches ${25}^{∘}\\text{C}.$ Then, we have\n\n$$\n\\begin{aligned}T({t}_{1}) & =25 \\\\ 23+Ke^{-k{t}_{1}} & =25 \\\\ Ke^{-k{t}_{1}} & =2 \\\\ e^{-k{t}_{1}} & =\\frac{2}{K} \\\\ -k{t}_{1} & =\\ln\\left(\\frac{2}{K}\\right) \\\\ {t}_{1} & =-\\frac{1}{k}\\ln\\left(\\frac{2}{K}\\right)\\end{aligned}\n$$\n\nSubstitute the values of $K$ and $k$ to obtain the time measured since cooling began:\n\n$$\n\\begin{aligned}{t}_{1} & =-\\frac{1}{- \\frac{\\ln{\\left(\\frac{13}{29} \\right)}}{6}}\\ln\\left(\\frac{2}{87\\left(\\frac{87}{39}\\right)^{\\frac{1}{3}}}\\right) \\\\ {t}_{1} & =2+6\\frac{\\ln\\left(\\frac{2}{87}\\right)}{\\ln\\left(\\frac{13}{29}\\right)}≈30\\,\\text{min}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186529438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108ed220-ff0d-5a3e-9732-871db25e264d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42\\,\\text{min}" :db/id #edb/ref 17592186529421} {:answer/id #uuid "36b98352-a45c-57