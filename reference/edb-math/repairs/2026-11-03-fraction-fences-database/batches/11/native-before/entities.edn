)^{2}}{\\left(\\frac{3}{2}\\right)}=\\frac{3}{4}\\frac{\\frac{25}{4}}{\\frac{3}{2}}=\\frac{25}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{5}{2},- \\frac{7}{2})}=\\frac{3}{4}\\frac{\\left(- \\frac{7}{2}\\right)^{2}}{\\left(- \\frac{5}{2}\\right)}=\\frac{3}{4}\\frac{\\frac{49}{4}}{- \\frac{5}{2}}=- \\frac{147}{40}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{7}{2},- \\frac{3}{2})}=\\frac{3}{4}\\frac{\\left(- \\frac{3}{2}\\right)^{2}}{\\left(\\frac{7}{2}\\right)}=\\frac{3}{4}\\frac{\\frac{9}{4}}{\\frac{7}{2}}=\\frac{27}{56}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/9d/9ddc3615a868cd3a04cdf8cbfa2ba3b6bc640cc48708c858442b9dfe3d28a8fc.png)"} {:db/id #edb/ref 17592186526329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002443df-175c-5f3c-916c-31c54a130e23" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/82/82f1453d9f38011d775803d700ae331f238c861564eeac4f3201ccf77b4c67b9.png" :db/id #edb/ref 17592186526298} {:answer/id #uuid "1e24712f-ed6c-5421-a806-f628b23f4b22" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/08/0822ae8783ee9c8c8743ecade2d6404c868d32cc60a2f15fb1d7ba102da88523.png" :db/id #edb/ref 17592186526308} {:answer/id #uuid "37443dec-b9c0-5d52-901a-5b71d9f9cbe7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7e/7e9b6daec155cf70a743578ce561fda017d20ab6955af3fa3a0ddf599542de29.png" :db/id #edb/ref 17592186526320} {:answer/id #uuid "d12b791e-1710-5dba-ace1-adccc5904bb1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/55/5561f44cbaeaf6bc79d5df8360b85d3b2dc4025bf3eda30677b6ae9bb4c3f14e.png" :db/id #edb/ref 17592186526353} {:answer/id #uuid "d18a33ec-6c1d-5f1c-9f87-3be112ecf40d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8b/8b5c3eec9e38afb9622523fdc933c1ddf8bae981dc0f9d6092760cc400b9ea44.png" :db/id #edb/ref 17592186526354}] :answer-field/correct {:db/id #edb/ref 17592186526308} :answer-field/id #uuid "875b585c-cb2a-52e7-a1b4-975ac7f6ecd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186526337}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5f5eb967-198b-5004-ad32-ecc18e2c0aaa" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2}x^{2}-(2)y^{2}?\n$$" :question/retired true :question/worked-solution "We have to sketch the slope field at the points $(\\frac{1}{2},- \\frac{3}{2})$,$(\\frac{3}{2},- \\frac{5}{2})$,$(\\frac{7}{2},\\frac{1}{2})$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{1}{2},- \\frac{3}{2})}=\\frac{1}{2}\\left(\\frac{1}{2}\\right)^{2}-2\\left(- \\frac{3}{2}\\right)^{2}=\\frac{1}{8}-\\left(\\frac{9}{2}\\right)=- \\frac{35}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{3}{2},- \\frac{5}{2})}=\\frac{1}{2}\\left(\\frac{3}{2}\\right)^{2}-2\\left(- \\frac{5}{2}\\right)^{2}=\\frac{9}{8}-\\left(\\frac{25}{2}\\right)=- \\frac{91}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{7}{2},\\frac{1}{2})}=\\frac{1}{2}\\left(\\frac{7}{2}\\right)^{2}-2\\left(\\frac{1}{2}\\right)^{2}=\\frac{49}{8}-\\left(\\frac{1}{2}\\right)=\\frac{45}{8}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/08/0822ae8783ee9c8c8743ecade2d6404c868d32cc60a2f15fb1d7ba102da88523.png)"} {:db/id #edb/ref 17592186526332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "552920fa-9e17-5948-be2c-204fe680ad43" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/92/927b063e8bf1c0bb3ad79f20bede84a48566252d0c4080ba4d4bce5352354612.png" :db/id #edb/ref 1759218