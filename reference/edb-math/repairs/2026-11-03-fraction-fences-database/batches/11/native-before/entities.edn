5497} :answer/value "images/4b/4be763c92f457c2436f4b3ef6824ddb151c9c4cb1c948da8bb2615a5be0266b4.png" :db/id #edb/ref 17592186518766} {:answer/id #uuid "4de6c361-9c35-5623-986e-37c8f14621b5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/4060e215b7c065030ef48fb633dc81216de738ebdd9cd6a9fdff6c30886cb071.png" :db/id #edb/ref 17592186518784} {:answer/id #uuid "578f1762-b52d-5429-9715-426aab770bbc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/72/72186906f29a435fb3dbb9f09d133a2343d6baea068f2ed543147e0edaf66759.png" :db/id #edb/ref 17592186518787} {:answer/id #uuid "91d57135-0f5a-55de-8677-5cbed001fbe9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3e/3e7f1d15693dbf9f069d84a6664a7d7808c70fee3a579009487c01ef4d0f7aec.png" :db/id #edb/ref 17592186518804} {:answer/id #uuid "a3b57fa5-a012-5ba5-9613-62a1d7c22793" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/250170b98f74972b6d63a4b62cf1b5ac9cfe3fc3137231c5cdabeee61d4696f6.png" :db/id #edb/ref 17592186518815}] :answer-field/correct {:db/id #edb/ref 17592186518787} :answer-field/id #uuid "bbf695b5-12e6-55c9-9a1a-fcc4ba5a7874" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97000ac7-3b8a-5bc8-9971-e4d488d336a5" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=-x y\\,i-2 x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(-2,- \\frac{3}{2}),(1,- \\frac{1}{2}),$ and $(1,\\frac{1}{2}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=-x y\\,i-2 x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(-2,- \\frac{3}{2}) & =\\left((-1)(-2)\\left(- \\frac{3}{2}\\right)\\right)\\,i+\\left((-2)(-2)^{2}\\right)\\,j=-3\\,i-8\\,j \\\\ F(1,- \\frac{1}{2}) & =\\left((-1)(1)\\left(- \\frac{1}{2}\\right)\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=\\frac{1}{2}\\,i-2\\,j \\\\ F(1,\\frac{1}{2}) & =\\left((-1)(1)\\left(\\frac{1}{2}\\right)\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=-\\frac{1}{2}\\,i-2\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/72/72186906f29a435fb3dbb9f09d133a2343d6baea068f2ed543147e0edaf66759.png)"} {:db/id #edb/ref 17592186518814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b187716-5c52-5154-8eba-92ea2595ebca" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a6/a69a9afddf3271e21e7b0a4136a84d4420238af354869085c58d931ac2e045fe.png" :db/id #edb/ref 17592186518799} {:answer/id #uuid "e6c20b29-76d4-5e38-8c58-494a801735b7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ac/ac7b6358e4a38abf76e49ca6e45dd3f170dd0565e4f303fd0ba4404c277ed2ab.png" :db/id #edb/ref 17592186518828} {:answer/id #uuid "f7236076-70c6-51ad-8f1c-70ee14c70552" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b6/b6f5ce40a52995b6b4cda770566885cfbfdc3f74cfade2d37f2bc88f6e55c6e4.png" :db/id #edb/ref 17592186518829} {:answer/id #uuid "f98bd55b-3400-51be-83c0-e4bec78eed02" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/91/91f6b076c94322c828a689829eaab50cda96b38237e21ed6d3010ae49ef89dfc.png" :db/id #edb/ref 17592186518831} {:answer/id #uuid "fda4634f-2172-562a-acac-47e97dcdd3ed" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d8/d818c0db25a267f3abdda3687ac96d1bd476cae70fe1e0874c3edc15b90bf997.png" :db/id #edb/ref 17592186518832}] :answer-field/correct {:db/id #edb/ref 17592186518799} :answer-field/id #uuid "8f72cb0b-a380-59f9-acdc-d02f0d8440d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518803}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a2cca722-7989-59b4-a813-89c902f8a1d8" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=2 x y\\,i-2 x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(1,- \\frac{1}{4}),(-1,\\frac{5}{4}),$ and $(1,\\frac{1}{4}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=2 x y\\,i-2 x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(1,- \\frac{1}{4}) & =\\left((2)(1)\\left(- \\frac{1}{4}\\right)\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=-\\frac{1}{2}\\,i-2\\,j \\\\ F(-1,\\frac{5}{4}) & =\\left((2)(-1)\\left(\\frac{5}{4}\\right)\\right)\\,i+\\left((-2)(-1)^{2}\\right)\\,j=-\\frac{5}{2}\\,i-2\\,j \\\\ F(1,\\frac{1}{4}) & =\\left((2)(1)\\left(\\frac{1}{4}\\right)\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=\\frac{1}{2}\\,i-2\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/a6/a69a9afddf3271e21e7b0a4136a84d4420238af354869085c58d931ac2e045fe.png)"} {:db/id #edb/ref 17592186518817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d9748db-ff33-5738-9275-47347081811f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a5/a5ee72ae329a50484d2d6c41983fbcf131500e9f52619d1c6644a63a10e9b92f.png" :db/id #edb/ref 17592186518767} {:answer/id #uuid "13ef16eb-1657-5324-8294-4449e71c4000" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/95/9560b790b63b75ce1a0e79e0beb58e0f51693723fdc8ac0642440fd4ad973937.png" :db/id #edb/ref 17592186518770} {:answer/id #uuid "37e994b8-8c59-5ccf-a6e4-81eeb22d9cfe" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4e/4e79f6a378556f500223baaa090df75b002cfd83196bd23b748278ef542b0fae.png" :db/id #edb/ref 17592186518779} {:answer/