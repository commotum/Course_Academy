\pi}324\\cos^{2}(t)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c9441f0-8025-50de-92dd-b68a5473e6df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48 \\cos{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186522964} {:answer/id #uuid "72138b32-51b5-521a-825b-63805481f838" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\cos{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186522965} {:answer/id #uuid "80d97e84-96e2-52b3-b2fa-9f92fd3dc027" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 24 \\cos{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186522971} {:answer/id #uuid "f52e2b91-2584-5d73-a7bd-a35995deadde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 \\sin{\\left(2 t \\right)} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186523009} {:answer/id #uuid "f89a05e1-4245-5973-8c82-77913d1c69af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24 \\cos{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186523012}] :answer-field/correct {:db/id #edb/ref 17592186523012} :answer-field/id #uuid "93c6e54f-a830-57c6-980f-afa5053f5253" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522977}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "552e2a8e-e82a-5c18-8e63-f2ebfa49d9fa" :question/problem "![](images/94/948754761eebc091cffa3aade21d37c92dfa38d69df076bcbb59ee03a06330cf.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨2\\sin(2t),\\,6\\cos(t)⟩$ for $t\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{-\\pi /2}^{\\pi /2}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, piecewise smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨4\\cos(2t),\\,-6\\sin(t)⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={\\int }_{-\\pi /2}^{\\pi /2}6\\cos(t)\\cdot 4\\cos(2t)\\,dt \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}24\\cos(t)\\cos(2t)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f341c9f-1061-5321-9da6-f891a686fdcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522962} {:answer/id #uuid "656ee85a-970c-51ad-996c-6d1be7ff23d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522963} {:answer/id #uuid "c3d26b20-8553-5b4b-a44f-eb5278f4e0cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522994} {:answer/id #uuid "c6c047b0-5d9f-526e-87fc-b39b96da4f7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 1759