|\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{\\int }_{1}^{16}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}[{\\int }_{1}^{16}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{16}]dv \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}(\\operatorname{ln}⁡16-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}{\\int }_{2}^{5}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{2}^{5} \\\\  & =\\frac{2\\operatorname{ln}⁡4}{9}\\cdot (125-8) \\\\  & =26\\operatorname{ln}⁡4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088d3881-6f26-5c1e-8b70-605ffcbe6a13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\ln{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186539357} {:answer/id #uuid "13d60485-67ff-563a-a2f9-a27075387c5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{112 \\ln{\\left(3 \\right)}}{9}" :db/id #edb/ref 17592186539358} {:answer/id #uuid "4e49411c-8515-54df-bf3e-1b739c795ae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{112 \\ln{\\left(3 \\right)}}{9}" :db/id #edb/ref 17592186539367} {:answer/id #uuid "719b5cba-94f5-5e18-8818-62c388bfb5f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{112 \\ln{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186539375} {:answer/id #uuid "cef2c8c7-9728-5e8f-b345-f1a76f0182b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40 \\ln{\\left(3 \\right)}" :db/id #edb/ref 17592186539384}] :answer-field/correct {:db/id #edb/ref 17592186539367} :answer-field/id #uuid "58854fce-abbe-50be-9446-ce124d3d6e2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539369}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id 