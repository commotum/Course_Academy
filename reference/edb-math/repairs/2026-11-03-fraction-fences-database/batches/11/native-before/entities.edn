}{{x}^{2}}\\right)}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{\\int }_{1}^{9}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{v}^{2}[{\\int }_{1}^{9}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{9}]dv \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{v}^{2}(\\operatorname{ln}⁡9-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡3}{3}{\\int }_{2}^{4}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡3}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{2}^{4} \\\\  & =\\frac{2\\operatorname{ln}⁡3}{9}\\cdot (64-8) \\\\  & =\\frac{112\\operatorname{ln}⁡3}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1760086a-7c09-5e8c-b8a1-c75d9fe9a51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\ln(4)" :db/id #edb/ref 17592186539359} {:answer/id #uuid "6a996faf-b917-5a49-b738-11415367209b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 14 \\ln(4)" :db/id #edb/ref 17592186539373} {:answer/id #uuid "7ea0e4fa-607a-52bf-a6d1-09e1f76b57f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539377} {:answer/id #uuid "cf2b0b28-1110-5655-97fd-3599b3b30adf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42 \\ln(4)" :db/id #edb/ref 17592186539385} {:answer/id #uuid "d44bf487-a72f-5688-b79f-679c5c9843de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{85 \\ln(4)}{2}" :db/id #edb/ref 1759218653