\pi}{3}, \\frac{17\\pi}{6}, \\frac{10\\pi}{3}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{11\\pi}{6}\\right) & =4\\ne 0, \\\\ {x}^{′}\\left(\\frac{7\\pi}{3}\\right) & =-4\\ne 0, \\\\ {x}^{′}\\left(\\frac{17\\pi}{6}\\right) & =4\\ne 0, \\\\ {x}^{′}\\left(\\frac{10\\pi}{3}\\right) & =-4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $$\n\\displaystyle t=\\frac{11\\pi}{6}, \\frac{7\\pi}{3}, \\frac{17\\pi}{6}, \\frac{10\\pi}{3}.\n$$"} {:db/id #edb/ref 17592186523083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d66d1357-e0d7-58c9-a48f-bd62562836f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186523080}] :answer-field/correct {:db/id #edb/ref 17592186523080} :answer-field/id #uuid "20ef8185-3b01-5cc2-a040-a6ce07a57c3b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186523027} {:answer-field/choices [{:answer/id #uuid "396284fb-66e1-5043-b407-7357db7c21ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186523036}] :answer-field/correct {:db/id #edb/ref 17592186523036} :answer-field/id #uuid "4e4eda86-0324-54cf-b300-9a498fb8794e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186523041}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da8bb941-6503-5014-b798-77c51b79d5e5" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=6\\operatorname{cos}⁡(t-\\frac{\\pi }{6})+11,\\,y=6\\operatorname{sin}⁡(t-\\frac{\\pi }{6})-1,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the normal to the curve is vertical. Give exact answers.\n\nIn **ascending order**, the normal to the curve is vertical at $t=$\n{{field-1}}\nand $t=$\n{{field-2}}." :question/worked-solution "The normal is vertical if the tangent is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=-6\\operatorname{sin}⁡(t-\\frac{\\pi }{6}),\\,{y}^{′}(t)=6\\operatorname{cos}⁡(t-\\frac{\\pi }{6})\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n6\\operatorname{cos}⁡(t-\\frac{\\pi }{6})=0\\,⟹\\,t=\\frac{2\\pi }{3},\\frac{5\\pi }{3}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{2\\pi }{3}\\right) & =-6\\ne 0, \\\\ {x}^{′}\\left(\\frac{5\\pi }{3}\\right) & =6\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{2\\pi }{3}$ and $t=\\frac{5\\pi }{3}.$"} {:answer/id #uuid "13eb88b0-c538-59f5-a87f-9f0c62715e7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{4}{3},\\,-\\frac{1}{3},\\,-1⟩" :db/id #edb/ref 17592186523194} {:answer/id #uuid "1be8f1ac-37b5-58a3-955f-0739f5c4af3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{5 \\sqrt{43}}{43},\\,-\\frac{3 \\sqrt{43}}{43},\\,-\\frac{3 \\sqrt{43}}{43}⟩" :db/id #edb/ref 17592186523196} {:answer/id #uuid "24903325-fc0a-5ecb-8f57-b0303e5a47b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{15}{43},\\,\\frac{9}{43},\\,\\frac{9}{43}⟩" :db/id #edb/ref 17592186523197} {:answer/id #uuid "24f1dbef-5fc8-59db-bec0-0a9c8a04f080" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{2 \\sqrt{26}}{13},\\,\\frac{\\sqrt{26}}{26},\\,\\frac{3 \\sqrt{26}}{26}⟩" :db/id #edb/ref 17592186523198} {:answer/id #uuid "4510612c-f80f-5c67-8138-7e4b58f04da5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{3}{17},\\,-\\frac{2}{17},\\,-\\frac{2}{17}⟩" :db/id #edb/ref 17592186523201} {:answer/id #uuid "4d2355f9-7bdf-5219-b0ed-8b759d10a82f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3 \\sqrt{17}}{17},\\,\\frac{2 \\sqrt{17}}{17},\\,\\frac{2 \\sqrt{17}}{17}⟩" :db/id #edb/ref 17592186523204} {:answer/id #uuid "4db28b1e-53e6-