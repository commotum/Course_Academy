2}\\right)\\,j=-i-j \\\\ F(-1,\\frac{3}{2}) & =\\left((2)(-1)\\left(\\frac{3}{2}\\right)\\right)\\,i+\\left((-1)(-1)^{2}\\right)\\,j=-3\\,i-j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/0d/0d2feddba8eb9c880f7a0dfd88b2b1f936f8bfa1de33f205c408fd776a33a579.png)"} {:db/id #edb/ref 17592186518789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f24afde-307e-5a68-9ef6-d776f89a190a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cc/ccaa50fb2c18d3f4f320dfebfaa34522a32a50b8fa0c4bea641f158367716437.png" :db/id #edb/ref 17592186518769} {:answer/id #uuid "279db652-c9e6-5660-a30a-c3664e796959" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f1/f1825366a93acf5c83c83973d9689d919e5e4a27a3db7fe31bca95afe0dfef78.png" :db/id #edb/ref 17592186518776} {:answer/id #uuid "4792412b-7e7a-5172-9926-7e53c39b704f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2c/2cdf71a7faea6652cca5c0b87916f6a6ce2f622dfb5a668b386a5c1bf2567d23.png" :db/id #edb/ref 17592186518780} {:answer/id #uuid "5cb11845-5440-5f8e-ab38-09080147e291" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/86/866186b6f6f18cca7832b0da458fbd08f01a6cb7d618f2a904f50885eb2e3f0f.png" :db/id #edb/ref 17592186518788} {:answer/id #uuid "a099f06e-ecd1-50f5-8536-1f98184ff8e2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f686e6a5920875ee373ced37fa6fcac941dc3fbd54489f16d4f27c3ff996b2e8.png" :db/id #edb/ref 17592186518813}] :answer-field/correct {:db/id #edb/ref 17592186518788} :answer-field/id #uuid "f8b11a11-c4c5-5c9c-a8c5-b16ef6212efd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518830}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "664de91a-fae2-5c4e-bcb3-71dd355525c5" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=-2 x y\\,i-x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(-1,\\frac{5}{4}),(-2,- \\frac{5}{4}),$ and $(-2,\\frac{3}{4}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=-2 x y\\,i-x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(-1,\\frac{5}{4}) & =\\left((-2)(-1)\\left(\\frac{5}{4}\\right)\\right)\\,i+\\left((-1)(-1)^{2}\\right)\\,j=\\frac{5}{2}\\,i-j \\\\ F(-2,- \\frac{5}{4}) & =\\left((-2)(-2)\\left(- \\frac{5}{4}\\right)\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=-5\\,i-4\\,j \\\\ F(-2,\\frac{3}{4}) & =\\left((-2)(-2)\\left(\\frac{3}{4}\\right)\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=3\\,i-4\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/86/866186b6f6f18cca7832b0da458fbd08f01a6cb7d618f2a904f50885eb2e3f0f.png)"} {:db/id #edb/ref 17592186518796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c47d7b-b24d-5cf2-b0c2-6d7f0849e04d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/72/72166eb3343bf0855703e987cae9bc13f3f086b9c5ed12b0d122fc895625dbb0.png" :db/id #edb/ref 17592186518793} {:answer/id #uuid "ac2d5692-6775-5b7d-ab4e-b438291a6bbd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/22/22f6819ea214f9f4e28ecf9dcc15a809aeb8e518a2f9c819fcb3c55f92372b77.png" :db/id #edb/ref 17592186518816} {:answer/id #uuid "dc0b44c4-099e-5594-a966-9e9a34f749ee" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/07/07355ad0b1ad48f062e97eeab30d1d9fbc708c418e232782710d2a69610585aa.png" :db/id #edb/ref 17592186518824} {:answer/id #uuid "dd179ccb-32c0-5484-a19d-839444ebf6a7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value 