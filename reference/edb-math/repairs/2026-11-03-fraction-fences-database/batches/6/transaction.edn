4}\\right) & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-(-1/4))t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{0t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }t\\,{|}_{0}^{a} \\\\  & =\\lim_{a\\to \\infty }(a-0) \\\\  & =\\lim_{a\\to \\infty }a \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore:\n\n- For $s\\le -\\frac{1}{4}$ the integral is divergent.\n\n- For $s>-\\frac{1}{4}$ the integral is convergent.\n\nEvaluating for $s>-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a} \\\\  & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot 0 \\\\  & =\\frac{1}{s+1/4} \\\\  & =\\frac{4}{4s+1}.\\end{aligned}\n$$\n\nSo, the Laplace transform of $f(t)={e}^{-t/4}$ is $F(s)=\\frac{4}{4s+1},$ defined for $s>-\\frac{1}{4}.$" "For a function $f(t)$ defined on $[0,\\infty ),$ the Laplace transform of $f,$ denoted $L{f(t)}$ or $F(s),$ is a function of the variable $s$ defined as\n\n$$\nF(s)=L{f(t)}={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,\\text{d}t\n$$\n\nprovided that this integral exists and is finite. \n\nFor the function $f(t)={e}^{-t/4},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-t/4}\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-st-t/4}\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{(-1/4-s)t}\\text{d}t.\\end{aligned}\n$$\n\nWe calculate our integral as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-1/4-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-s)t}\\text{d}t\\end{aligned}\n$$\n\nTo evaluate the last integral, we must consider whether $s\\ne -\\frac{1}{4}$ or $s=-\\frac{1}{4}.$\n\n- If $s\\ne -\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(s) & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\left(\\frac{1}{-1/4-s}{e}^{(-1/4-s)t}\\right)|}_{0}^{a} \\\\  & =\\frac{1}{-1/4-s}(\\lim_{a\\to \\infty }{e}^{(-1/4-s)a}-1) \\\\  & =\\frac{1}{s+1/4}(1-\\lim_{a\\to \\infty }{e}^{(-1/4-s)a}) \\\\  & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a}\\end{aligned}\n$$\n\nLet's evaluate the limit. We have\n\n$$\n\\begin{aligned}\\lim_{a\\to \\mathrm{\\infty }}{e}^{(-1/4-s)a}=\\begin{cases}0,\\hspace{1em} & s>-\\frac{1}{4}, \\\\ \\mathrm{\\infty },\\hspace{1em} & s<-\\frac{1}{4}.\\end{cases}\\end{aligned}\n$$\n\n- If $s=-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F\\left(-\\frac{1}{4}\\right) & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-(-1/4))t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{0t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }t\\,{|}_{0}^{a} \\\\  & =\\lim_{a\\to \\infty }(a-0) \\\\  & =\\lim_{a\\to \\infty }a \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore:\n\n- For $s\\le -\\frac{1}{4}$ the integral is divergent.\n\n- For $s>-\\frac{1}{4}$ the integral is convergent.\n\nEvaluating for $s>-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a} \\\\  & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot 0 \\\\  & =\\frac{1}{s+1/4} \\\\  & =\\frac{4}{4s+1}.\\end{aligned}\n$$\n\nSo, the Laplace transform of $f(t)={e}^{-t/4}$ is $F(s)=\\frac{4}{4s+1},$ defined for $s>-\\frac{1}{4}.$"] [:db/cas 17592186315007 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{4\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{4\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(4\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(4\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(4\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{4\\text{i}-s}{e}^{(4\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{4\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(4\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-4\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(4\\text{i}-s)a}) \\\\  & =\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{4\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a))] \\\\  & =\\frac{1}{s-4\\text{i}}-0 \\\\  & =\\frac{1}{s-4\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{4\\text{i}t}$ is $F(s)=\\frac{1}{s-4\\text{i}},$ defined for $s>0.$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{4\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{4\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(4\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(4\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(4\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\left(\\frac{1}{4\\text{i}-s}{e}^{(4\\text{i}-s)t}\\right)|}_{0}^{a} \\\\  & =\\frac{1}{4\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(4\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-4\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(4\\text{i}-s)a}) \\\\  & =\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{4\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a))] \\\\  & =\\frac{1}{s-4\\text{i}}-0 \\\\  & =\\frac{1}{s-4\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{4\\text{i}t}$ is $F(s)=\\frac{1}{s-4\\text{i}},$ defined for $s>0.$"] [:db/cas 17592186315008 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{7\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{7\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{7\\text{i}-s}{e}^{(7\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{7\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(7\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-7\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(7\\text{i}-s)a}) \\\\  & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{7\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))] \\\\  & =\\frac{1}{s-7\\text{i}}-0 \\\\  & =\\frac{1}{s-7\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{7\\text{i}t}$ is $F(s)=\\frac{1}{s-7\\text{i}},$ defined for $s>0.$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{7\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{7\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\left(\\frac{1}{7\\text{i}-s}{e}^{(7\\text{i}-s)t}\\right)|}_{0}^{a} \\\\  & =\\frac{1}{7\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(7\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-7\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(7\\text{i}-s)a}) \\\\  & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{7\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))] \\\\  & =\\frac{1}{s-7\\text{i}}-0 \\\\  & =\\frac{1}{s-7\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{7\\text{i}t}$ is $F(s)=\\frac{1}{s-7\\text{i}},$ defined for $s>0.$"] [:db/cas 17592186315009 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-2\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-2\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{-2\\text{i}-s}{e}^{(-2\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{-2\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s+2\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}) \\\\  & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-2\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))] \\\\  & =\\frac{1}{s+2\\text{i}}-0 \\\\  & =\\frac{1}{s+2\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-2\\text{i}t}$ is $F(s)=\\frac{1}{s+2\\text{i}},$ defined for $s>0.$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-2\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-2\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\left(\\frac{1}{-2\\text{i}-s}{e}^{(-2\\text{i}-s)t}\\right)|}_{0}^{a} \\\\  & =\\frac{1}{-2\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s+2\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}) \\\\  & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-2\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))] \\\\  & =\\frac{1}{s+2\\text{i}}-0 \\\\  & =\\frac{1}{s+2\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-2\\text{i}t}$ is $F(s)=\\frac{1}{s+2\\text{i}},$ defined for $s>0.$"] [:db/cas 17592186315011 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-3\\text{i}t/8},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-3