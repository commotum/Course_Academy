\text{i}/8} \\\\  & =\\frac{8}{8s+3\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-3\\text{i}t/8}$ is $F(s)=\\frac{8}{8s+3\\text{i}},$ defined for $s>0.$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-3\\text{i}t/8},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-3\\text{i}t/8}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-3\\text{i}/8-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-3\\text{i}/8-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-3\\text{i}/8-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\left(\\frac{1}{-3\\text{i}/8-s}{e}^{(-3\\text{i}/8-s)t}\\right)|}_{0}^{a} \\\\  & =\\frac{1}{-3\\text{i}/8-s}(\\lim_{a\\to \\infty }{e}^{(-3\\text{i}/8-s)a}-1) \\\\  & =\\frac{1}{s+3\\text{i}/8}(1-\\lim_{a\\to \\infty }{e}^{(-3\\text{i}/8-s)a}) \\\\  & =\\frac{1}{s+3\\text{i}/8}-\\frac{1}{s+3\\text{i}/8}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-3\\text{i}a/8}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+3\\text{i}/8}-\\frac{1}{s+3\\text{i}/8}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-3a/8)+\\text{i}\\operatorname{sin}⁡(-3a/8))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-3a/8)+\\text{i}\\operatorname{sin}⁡(-3a/8)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-3a/8)+\\text{i}\\operatorname{sin}⁡(-3a/8),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-3a/8)+\\text{i}\\operatorname{sin}⁡(-3a/8)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+3\\text{i}/8}-\\frac{1}{s+3\\text{i}/8}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-3a/8)+\\text{i}\\operatorname{sin}⁡(-3a/8))] \\\\  & =\\frac{1}{s+3\\text{i}/8}-0 \\\\  & =\\frac{1}{s+3\\text{i}/8} \\\\  & =\\frac{8}{8s+3\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-3\\text{i}t/8}$ is $F(s)=\\frac{8}{8s+3\\text{i}},$ defined for $s>0.$"] [:db/cas 17592186315012 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-\\text{i}t/9},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-\\text{i}t/9}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-\\text{i}/9-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-\\text{i}/9-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-\\text{i}/9-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{-\\text{i}/9-s}{e}^{(-\\text{i}/9-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{-\\text{i}/9-s}(\\lim_{a\\to \\infty }{e}^{(-\\text{i}/9-s)a}-1) \\\\  & =\\frac{1}{s+\\text{i}/9}(1-\\lim_{a\\to \\infty }{e}^{(-\\text{i}/9-s)a}) \\\\  & =\\frac{1}{s+\\text{i}/9}-\\frac{1}{s+\\text{i}/9}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-\\text{i}a/9}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+\\text{i}/9}-\\frac{1}{s+\\text{i}/9}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+\\text{i}/9}-\\frac{1}{s+\\text{i}/9}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9))] \\\\  & =\\frac{1}{s+\\text{i}/9}-0 \\\\  & =\\frac{1}{s+\\text{i}/9} \\\\  & =\\frac{9}{9s+\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-\\text{i}t/9}$ is $F(s)=\\frac{9}{9s+\\text{i}},$ defined for $s>0.$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-\\text{i}t/9},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-\\text{i}t/9}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-\\text{i}/9-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-\\text{i}/9-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-\\text{i}/9-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\left(\\frac{1}{-\\text{i}/9-s}{e}^{(-\\text{i}/9-s)t}\\right)|}_{0}^{a} \\\\  & =\\frac{1}{-\\text{i}/9-s}(\\lim_{a\\to \\infty }{e}^{(-\\text{i}/9-s)a}-1) \\\\  & =\\frac{1}{s+\\text{i}/9}(1-\\lim_{a\\to \\infty }{e}^{(-\\text{i}/9-s)a}) \\\\  & =\\frac{1}{s+\\text{i}/9}-\\frac{1}{s+\\text{i}/9}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-\\text{i}a/9}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+\\text{i}/9}-\\frac{1}{s+\\text{i}/9}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+\\text{i}/9}-\\frac{1}{s+\\text{i}/9}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-a/9)+\\text{i}\\operatorname{sin}⁡(-a/9))] \\\\  & =\\frac{1}{s+\\text{i}/9}-0 \\\\  & =\\frac{1}{s+\\text{i}/9} \\\\  & =\\frac{9}{9s+\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-\\text{i}t/9}$ is $F(s)=\\frac{9}{9s+\\text{i}},$ defined for $s>0.$"] [:db/cas 17592186315031 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)=\\begin{cases}0,\\hspace{1em} & t<0 \\\\ 1,\\hspace{1em} & t\\ge 0.\\end{cases}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(5-t)=\\begin{cases}1,\\hspace{1em} & t\\le 5 \\\\ 0,\\hspace{1em} & t>5\\end{cases}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(5-t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }0\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe compute this integral for $s>0$ as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{5}{e}^{-st}\\,\\text{d}t \\\\  & ={[-\\frac{{e}^{-st}}{s}]}_{0}^{5} \\\\  & =-\\frac{{e}^{-5s}}{s}+\\frac{1}{s} \\\\  & =\\frac{1}{s}(1-{e}^{-5s})\\end{aligned}\n$$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)=\\begin{cases}0,\\hspace{1em} & t<0 \\\\ 1,\\hspace{1em} & t\\ge 0.\\end{cases}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(5-t)=\\begin{cases}1,\\hspace{1em} & t\\le 5 \\\\ 0,\\hspace{1em} & t>5\\end{cases}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(5-t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }0\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe compute this integral for $s>0$ as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{5}{e}^{-st}\\,\\text{d}t \\\\  & ={\\left[-\\frac{{e}^{-st}}{s}\\right]}_{0}^{5} \\\\  & =-\\frac{{e}^{-5s}}{s}+\\frac{1}{s} \\\\  & =\\frac{1}{s}(1-{e}^{-5s})\\end{aligned}\n$$"] [:db/cas 17592186315033 :question/worked-solution "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-3x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=-\\frac{6}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{6}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =-\\frac{6}{\\pi }(-\\frac{1}{n}[x\\operatorname{cos}⁡(nx)]_{0}^{\\pi }+\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{6}{n\\pi }((\\pi \\cdot \\operatorname{cos}⁡(n\\pi )-0\\cdot \\operatorname{cos}⁡(0))-\\frac{1}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{6}{n\\pi }(\\pi \\operatorname{cos}⁡(n\\pi )-\\frac{1}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))) \\\\  & =\\frac{6\\operatorname{cos}⁡(n\\pi )}{n}.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=\\frac{6(-1)^{n}}{n}.\n$$\n\nFinally, the Fourier sine series is\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n}\\cdot \\operatorname{sin}⁡(nx).\n$$" "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-3x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=-\\frac{6}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{6}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =-\\frac{6}{\\pi }\\left(-\\frac{1}{n}[x\\operatorname{cos}⁡(nx)]_{0}^{\\pi }+\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{6}{n\\pi }\\left((\\pi \\cdot \\operatorname{cos}⁡(n\\pi )-0\\cdot \\operatorname{cos}⁡(0))-\\frac{1}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =\\frac{6}{n\\pi }\\left(\\pi \\operatorname{cos}⁡(n\\pi )-\\frac{1}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))\\right) \\\\  & =\\frac{6\\operatorname{cos}⁡(n\\pi )}{n}.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=\\frac{6(-1)^{n}}{n}.\n$$\n\nFinally, the Fourier sine series is\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n}\\cdot \\operatorname{sin}⁡(nx).\n$$"] [:db/cas 17592186315034 :question/worked-solution "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-5x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=-\\frac{10}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{10}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =-\\frac{10}{\\pi }(-\\frac{1}{n}[x\\operatorname{cos}⁡(nx)]_{0}^{\\pi }+\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{10}{n\\pi }((\\pi \\cdot \\operatorname{cos}⁡(n\\pi )-0\\cdot \\operatorname{cos}⁡(0))-\\frac{1}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{10}{n\\pi }(\\pi \\operatorname{cos}⁡(n\\pi )-\\frac{1}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))) \\\\  & =\\frac{10\\operatorname{cos}⁡(n\\pi )}{n}.\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=\\frac{10(-1)^{n}}{n}.\n$$" "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-5x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=-\\frac{10}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{10}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =-\\frac{10}{\\pi }\\left(-\\frac{1}{n}[x\\operatorname{cos}⁡(nx)]_{0}^{\\pi }+\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{10}{n\\pi }\\left((\\pi \\cdot \\operatorname{cos}⁡(n\\pi )-0\\cdot \\operatorname{cos}⁡(0))-\\frac{1}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =\\frac{10}{n\\pi }\\left(\\pi \\operatorname{cos}⁡(n\\pi )-\\frac{1}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))\\right) \\\\  & =\\frac{10\\operatorname{cos}⁡(n\\pi )}{n}.\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=\\frac{10(-1)^{n}}{n}.\n$$"] [:db/cas 17592186315044 :question/problem "For the functions $u(x)$ and $v(x),$ you're given the following data:\n\n$$\nu(4)=1,\\,{u}^{′}(4)=6,\\,v(4)=-2,\\,{v}^{′}(4)=2\n$$\n\nCompute $$\n\\displaystyle \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))\n$$ at $x=4.$\n\n$$\n\\displaystyle {\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))|}_{x=4}=\n$$\n{{field-1}}" "For the functions $u(x)$ and $v(x),$ you're given the following data:\n\n$$\nu(4)=1,\\,{u}^{′}(4)=6,\\,v(4)=-2,\\,{v}^{′}(4)=2\n$$\n\nCompute $$\n\\displaystyle \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}u(x)+3v(x)\\right)\n$$ at $x=4.$\n\n$$\n\\displaystyle {\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}u(x)+3v(x)\\right)|}_{x=4}=\n$$\n{{field-1}}"] [:db/cas 17592186315044 :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))=\\frac{1}{2}{u}^{′}(x)+3{v}^{′}(x).\n$$\n\nAt the point where $x=4$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))|}_{x=4} & =\\frac{1}{2}{u}^{′}(4)+3{v}^{′}(4) \\\\  & =\\frac{1}{2}(6)+3(2) \\\\  & =3+6 \\\\  & =9.\\end{aligned}\n$$" "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}u(x)+3v(x)\\right)=\\frac{1}{2}{u}^{′}(x)+3{v}^{′}(x).\n$$\n\nAt the point where $x=4$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}u(x)+3v(x)\\right)|}_{x=4} & =\\frac{1}{2}{u}^{′}(4)+3{v}^{′}(4) \\\\  & =\\frac{1}{2}(6)+3(2) \\\\  & =3+6 \\\\  & =9.\\end{aligned}\n$$"] [:db/cas 17592186315047 :question/worked-solution "We know that the area of the equilateral triangle with side $s$ is given by  \n\n$$\nA=A(s)=\\frac{\\sqrt{3}}{4}{s}^{2}.\n$$\n\nTaking the derivative, the rate of change of $A(s)$  with respect to $s$ is \n\n$$\n\\begin{aligned}{A}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{3}}{4}{s}^{2}) \\\\  & =\\frac{\\sqrt{3}}{4}\\cdot (2s) \\\\  & =\\frac{\\sqrt{3}}{2}s,\\end{aligned}\n$$\n\nand evaluating at $s=4$ gives\n\n$$\n{A}^{′}(4)=\\frac{\\sqrt{3}}{2}\\cdot 4=2\\sqrt{3}.\n$$\n\n \n\nTherefore, the instantaneous rate of change at the moment when the length of the side is $s=4\\,\\text{in}$ is $2\\sqrt{3}\\,{\\text{in}}^{2}/\\text{in}.$" "We know that the area of the equilateral triangle with side $s$ is given by  \n\n$$\nA=A(s)=\\frac{\\sqrt{3}}{4}{s}^{2}.\n$$\n\nTaking the derivative, the rate of change of $A(s)$  with respect to $s$ is \n\n$$\n\\begin{aligned}{A}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{\\sqrt{3}}{4}{s}^{2}\\right) \\\\  & =\\frac{\\sqrt{3}}{4}\\cdot (2s) \\\\  & =\\frac{\\sqrt{3}}{2}s,\\end{aligned}\n$$\n\nand evaluating at $s=4$ gives\n\n$$\n{A}^{′}(4)=\\frac{\\sqrt{3}}{2}\\cdot 4=2\\sqrt{3}.\n$$\n\n \n\nTherefore, the instantaneous rate of change at the moment when the length of the side is $s=4\\,\\text{in}$ is $2\\sqrt{3}\\,{\\text{in}}^{2}/\\text{in}.$"] [:db/cas 17592186315049 :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{cosh}⁡(2t)=\\frac{{e}^{2t}+{e}^{-2t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(2t)} & =L{\\frac{{e}^{2t}+{e}^{-2t}}{2}} \\\\  & =L{\\frac{{e}^{2t}}{2}+\\frac{{e}^{-2t}}{2}} \\\\  & =L{\\frac{{e}^{2t}}{2}}+L{\\frac{{e}^{-2t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{2t}}+\\frac{1}{2}L{{e}^{-2t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{2t}} & =\\frac{1}{s-2},\\,s>2 \\\\ L{{e}^{-2t}} & =\\frac{1}{s+2},\\,s>-2\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cosh}⁡(2t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(2t)} & =\\frac{1}{2}L{{e}^{2t}}+\\frac{1}{2}L{{e}^{-2t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-2}+\\frac{1}{2}\\cdot \\frac{1}{s+2} \\\\  & =\\frac{1}{2}(\\frac{1}{s-2}+\\frac{1}{s+2}) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+2)+(s-2)}{(s-2)(s+2)}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{2s}{{s}^{2}-4}\\right) \\\\  & =\\frac{s}{{s}^{2}-4}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{2t}}$ is defined for $s\\in (2,\\infty )$ and $L{{e}^{-2t}}$ is defined for $s\\in (-2,\\infty ),$ we have that $L{\\operatorname{cosh}⁡(2t)}$ is defined for\n\n$$\n(2,\\infty )\\cap (-2,\\infty )=(2,\\infty ),\n$$\n\nthat is, $s>2.$" "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{cosh}⁡(2t)=\\frac{{e}^{2t}+{e}^{-2t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(2t)} & =L{\\frac{{e}^{2t}+{e}^{-2t}}{2}} \\\\  & =L{\\frac{{e}^{2t}}{2}+\\frac{{e}^{-2t}}{2}} \\\\  & =L{\\frac{{e}^{2t}}{2}}+L{\\frac{{e}^{-2t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{2t}}+\\frac{1}{2}L{{e}^{-2t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{2t}} & =\\frac{1}{s-2},\\,s>2 \\\\ L{{e}^{-2t}} & =\\frac{1}{s+2},\\,s>-2\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cosh}⁡(2t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(2t)} & =\\frac{1}{2}L{{e}^{2t}}+\\frac{1}{2}L{{e}^{-2t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-2}+\\frac{1}{2}\\cdot \\frac{1}{s+2} \\\\  & =\\frac{1}{2}\\left(\\frac{1}{s-2}+\\frac{1}{s+2}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+2)+(s-2)}{(s-2)(s+2)}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{2s}{{s}^{2}-4}\\right) \\\\  & =\\frac{s}{{s}^{2}-4}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{2t}}$ is defined for $s\\in (2,\\infty )$ and $L{{e}^{-2t}}$ is defined for $s\\in (-2,\\infty ),$ we have that $L{\\operatorname{cosh}⁡(2t)}$ is defined for\n\n$$\n(2,\\infty )\\cap (-2,\\infty )=(2,\\infty ),\n$$\n\nthat is, $s>2.$"] [:db/cas 17592186315050 :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{cosh}⁡(4t)=\\frac{{e}^{4t}+{e}^{-4t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(4t)} & =L{\\frac{{e}^{4t}+{e}^{-4t}}{2}} \\\\  & =L{\\frac{{e}^{4t}}{2}+\\frac{{e}^{-4t}}{2}} \\\\  & =L{\\frac{{e}^{4t}}{2}}+L{\\frac{{e}^{-4t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{4t}}+\\frac{1}{2}L{{e}^{-4t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{4t}} & =\\frac{1}{s-4},\\,s>4 \\\\ L{{e}^{-4t}} & =\\frac{1}{s+4},\\,s>-4\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cosh}⁡(4t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(4t)} & =\\frac{1}{2}L{{e}^{4t}}+\\frac{1}{2}L{{e}^{-4t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-4}+\\frac{1}{2}\\cdot \\frac{1}{s+4} \\\\  & =\\frac{1}{2}(\\frac{1}{s-4}+\\frac{1}{s+4}) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+4)+(s-4)}{(s-4)(s+4)}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{2s}{{s}^{2}-16}\\right) \\\\  & =\\frac{s}{{s}^{2}-16}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{4t}}$ is defined for $s\\in (4,\\infty )$ and $L{{e}^{-4t}}$ is defined for $s\\in (-4,\\infty ),$ we have that $L{\\operatorname{cosh}⁡(4t)}$ is defined for\n\n$$\n(4,\\infty )\\cap (-4,\\infty )=(4,\\infty ),\n$$\n\nthat is, $s>4.$" "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{cosh}⁡(4t)=\\frac{{e}^{4t}+{e}^{-4t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(4t)} & =L{\\frac{{e}^{4t}+{e}^{-4t}}{2}} \\\\  & =L{\\frac{{e}^{4t}}{2}+\\frac{{e}^{-4t}}{2}} \\\\  & =L{\\frac{{e}^{4t}}{2}}+L{\\frac{{e}^{-4t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{4t}}+\\frac{1}{2}L{{e}^{-4t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{4t}} & =\\frac{1}{s-4},\\,s>4 \\\\ L{{e}^{-4t}} & =\\frac{1}{s+4},\\,s>-4\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cosh}⁡(4t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(4t)} & =\\frac{1}{2}L{{e}^{4t}}+\\frac{1}{2}L{{e}^{-4t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-4}+\\frac{1}{2}\\cdot \\frac{1}{s+4} \\\\  & =\\frac{1}{2}\\left(\\frac{1}{s-4}+\\frac{1}{s+4}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+4)+(s-4)}{(s-4)(s+4)}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{2s}{{s}^{2}-16}\\right) \\\\  & =\\frac{s}{{s}^{2}-16}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{4t}}$ is defined for $s\\in (4,\\infty )$ and $L{{e}^{-4t}}$ is defined for $s\\in (-4,\\infty ),$ we have that $L{\\operatorname{cosh}⁡(4t)}$ is defined for\n\n$$\n(4,\\infty )\\cap (-4,\\infty )=(4,\\infty ),\n$$\n\nthat is, $s>4.$"] [:db/cas 17592186315051 :question/worked-solution "The formula for the derivative of $\\operatorname{arcsec} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsec} \\,x)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arcsec} ({e}^{x})] \\\\  & =\\frac{1}{|{e}^{x}|\\sqrt{{({e}^{x})}^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{1}{{e}^{x}\\sqrt{{e}^{2x}-1}}\\cdot {e}^{x} \\\\  & =\\frac{1}{\\sqrt{{e}^{2x}-1}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=\\frac{1}{2}\\operatorname{ln}⁡10$ is\n\n$$\n\\begin{aligned}m={f}^{′}(\\frac{1}{2}\\operatorname{ln}⁡10) & =\\frac{1}{\\sqrt{{e}^{2(\\operatorname{ln}⁡(10)/2)}-1}} \\\\  & =\\frac{1}{\\sqrt{{e}^{\\operatorname{ln}⁡10}-1}} \\\\  & =\\frac{1}{\\sqrt{10-1}} \\\\  & =\\frac{1}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" "The formula for the derivative of $\\operatorname{arcsec} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsec} \\,x)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arcsec} ({e}^{x})] \\\\  & =\\frac{1}{|{e}^{x}|\\sqrt{{({e}^{x})}^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{1}{{e}^{x}\\sqrt{{e}^{2x}-1}}\\cdot {e}^{x} \\\\  & =\\frac{1}{\\sqrt{{e}^{2x}-1}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=\\frac{1}{2}\\operatorname{ln}⁡10$ is\n\n$$\n\\begin{aligned}m={f}^{′}\\left(\\frac{1}{2}\\operatorname{ln}⁡10\\right) & =\\frac{1}{\\sqrt{{e}^{2(\\operatorname{ln}⁡(10)/2)}-1}} \\\\  & =\\frac{1}{\\sqrt{{e}^{\\operatorname{ln}⁡10}-1}} \\\\  & =\\frac{1}{\\sqrt{10-1}} \\\\  & =\\frac{1}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"] [:db/cas 17592186315053 :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that the sine function can be defined in terms of complex exponentials as follows: \n\n$$\n\\operatorname{sin}⁡(12t)=\\frac{{e}^{12\\text{i}t}-{e}^{-12\\text{i}t}}{2\\text{i}}\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡(12t)} & =L{\\frac{{e}^{12\\text{i}t}-{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =L{\\frac{{e}^{12\\text{i}t}}{2\\text{i}}-\\frac{{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =L{\\frac{{e}^{12\\text{i}t}}{2\\text{i}}}-L{\\frac{{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =\\frac{1}{2\\text{i}}L{{e}^{12\\text{i}t}}-\\frac{1}{2\\text{i}}L{{e}^{-12\\text{i}t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{\\text{i}\\omega t}}=\\frac{1}{s-\\text{i}\\omega },\\,s>0.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{12\\text{i}t}} & =\\frac{1}{s-12\\text{i}},\\,s>0 \\\\ L{{e}^{-12\\text{i}t}} & =\\frac{1}{s+12\\text{i}},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{sin}⁡(12t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡(12t)} & =\\frac{1}{2\\text{i}}L{{e}^{12\\text{i}t}}-\\frac{1}{2\\text{i}}L{{e}^{-12\\text{i}t}} \\\\  & =\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s-12\\text{i}}-\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s+12\\text{i}} \\\\  & =\\frac{1}{2\\text{i}}(\\frac{1}{s-12\\text{i}}-\\frac{1}{s+12\\text{i}}) \\\\  & =\\frac{1}{2\\text{i}}\\left(\\frac{(s+12\\text{i})-(s-12\\text{i})}{(s-12\\text{i})(s+12\\text{i})}\\right) \\\\  & =\\frac{1}{2\\text{i}}\\left(\\frac{24\\text{i}}{{s}^{2}+144}\\right) \\\\  & =\\frac{12}{{s}^{2}+144},\\end{aligned}\n$$\n\ndefined for $s>0.$" "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that the sine function can be defined in terms of complex exponentials as follows: \n\n$$\n\\operatorname{sin}⁡(12t)=\\frac{{e}^{12\\text{i}t}-{e}^{-12\\text{i}t}}{2\\text{i}}\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡(12t)} & =L{\\frac{{e}^{12\\text{i}t}-{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =L{\\frac{{e}^{12\\text{i}t}}{2\\text{i}}-\\frac{{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =L{\\frac{{e}^{12\\text{i}t}}{2\\text{i}}}-L{\\frac{{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =\\frac{1}{2\\text{i}}L{{e}^{12\\text{i}t}}-\\frac{1}{2\\text{i}}L{{e}^{-12\\text{i}t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{\\text{i}\\omega t}}=\\frac{1}{s-\\text{i}\\omega },\\,s>0.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{12\\text{i}t}} & =\\frac{1}{s-12\\text{i}},\\,s>0 \\\\ L{{e}^{-12\\text{i}t}} & =\\frac{1}{s+12\\text{i}},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{sin}⁡(12t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡(12t)} & =\\frac{1}{2\\text{i}}L{{e}^{12\\text{i}t}}-\\frac{1}{2\\text{i}}L{{e}^{-12\\text{i}t}} \\\\  & =\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s-12\\text{i}}-\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s+12\\text{i}} \\\\  & =\\frac{1}{2\\text{i}}\\left(\\frac{1}{s-12\\text{i}}-\\frac{1}{s+12\\text{i}}\\right) \\\\  & =\\frac{1}{2\\text{i}}\\left(\\frac{(s+12\\text{i})-(s-12\\text{i})}{(s-12\\text{i})(s+12\\text{i})}\\right) \\\\  & =\\frac{1}{2\\text{i}}\\left(\\frac{24\\text{i}}{{s}^{2}+144}\\right) \\\\  & =\\frac{12}{{s}^{2}+144},\\end{aligned}\n$$\n\ndefined for $s>0.$"] [:db/cas 17592186315054 :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that the cosine function can be defined in terms of complex exponentials as follows: \n\n$$\n\\operatorname{cos}⁡(5t)=\\frac{{e}^{5\\text{i}t}+{e}^{-5\\text{i}t}}{2}\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡(5t)} & =L{\\frac{{e}^{5\\text{i}t}+{e}^{-5\\text{i}t}}{2}} \\\\  & =L{\\frac{{e}^{5\\text{i}t}}{2}+\\frac{{e}^{-5\\text{i}t}}{2}} \\\\  & =L{\\frac{{e}^{5\\text{i}t}}{2}}+L{\\frac{{e}^{-5\\text{i}t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{5\\text{i}t}}+\\frac{1}{2}L{{e}^{-5\\text{i}t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{\\text{i}\\omega t}}=\\frac{1}{s-\\text{i}\\omega },\\,s>0.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{5\\text{i}t}} & =\\frac{1}{s-5\\text{i}},\\,s>0 \\\\ L{{e}^{-5\\text{i}t}} & =\\frac{1}{s+5\\text{i}},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cos}⁡(5t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡(5t)} & =\\frac{1}{2}L{{e}^{5\\text{i}t}}+\\frac{1}{2}L{{e}^{-5\\text{i}t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-5\\text{i}}+\\frac{1}{2}\\cdot \\frac{1}{s+5\\text{i}} \\\\  & =\\frac{1}{2}(\\frac{1}{s-5\\text{i}}+\\frac{1}{s+5\\text{i}}) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+5\\text{i})+(s-5\\text{i})}{(s-5\\text{i})(s+5\\text{i})}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{2s}{{s}^{2}+25}\\right) \\\\  & =\\frac{s}{{s}^{2}+25},\\end{aligned}\n$$\n\ndefined for $s>0.$" "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that the cosine function can be defined in terms of complex exponentials as follows: \n\n$$\n\\operatorname{cos}⁡(5t)=\\frac{{e}^{5\\text{i}t}+{e}^{-5\\text{i}t}}{2}\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡(5t)} & =L{\\frac{{e}^{5\\text{i}t}+{e}^{-5\\text{i}t}}{2}} \\\\  & =L{\\frac{{e}^{5\\text{i}t}}{2}+\\frac{{e}^{-5\\text{i}t}}{2}} \\\\  & =L{\\frac{{e}^{5\\text{i}t}}{2}}+L{\\frac{{e}^{-5\\text{i}t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{5\\text{i}t}}+\\frac{1}{2}L{{e}^{-5\\text{i}t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{\\text{i}\\omega t}}=\\frac{1}{s-\\text{i}\\omega },\\,s>0.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{5\\text{i}t}} & =\\frac{1}{s-5\\text{i}},\\,s>0 \\\\ L{{e}^{-5\\text{i}t}} & =\\frac{1}{s+5\\text{i}},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cos}⁡(5t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡(5t)} & =\\frac{1}{2}L{{e}^{5\\text{i}t}}+\\frac{1}{2}L{{e}^{-5\\text{i}t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-5\\text{i}}+\\frac{1}{2}\\cdot \\frac{1}{s+5\\text{i}} \\\\  & =\\frac{1}{2}\\left(\\frac{1}{s-5\\text{i}}+\\frac{1}{s+5\\text{i}}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+5\\text{i})+(s-5\\text{i})}{(s-5\\text{i})(s+5\\text{i})}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{2s}{{s}^{2}+25}\\right) \\\\  & =\\frac{s}{{s}^{2}+25},\\end{aligned}\n$$\n\ndefined for $s>0.$"] [:db/cas 17592186315055 :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} \\,x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}\\cdot \\operatorname{arccot} (\\sqrt{x})) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})\\cdot \\operatorname{arccot} (\\sqrt{x})+\\sqrt{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} \\,(\\sqrt{x})) \\\\  & =\\frac{1}{2\\sqrt{x}}\\cdot \\operatorname{arccot} (\\sqrt{x})+\\sqrt{x}\\cdot [-\\frac{1}{1+{(\\sqrt{x})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})] \\\\  & =\\frac{\\operatorname{arccot} (\\sqrt{x})}{2\\sqrt{x}}-\\frac{\\sqrt{x}}{1+x}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =\\frac{\\operatorname{arccot} (\\sqrt{x})}{2\\sqrt{x}}-\\frac{1}{2(1+x)}.\\end{aligned}\n$$" "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} \\,x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}\\cdot \\operatorname{arccot} (\\sqrt{x})) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})\\cdot \\operatorname{arccot} (\\sqrt{x})+\\sqrt{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} \\,(\\sqrt{x})) \\\\  & =\\frac{1}{2\\sqrt{x}}\\cdot \\operatorname{arccot} (\\sqrt{x})+\\sqrt{x}\\cdot \\left[-\\frac{1}{1+{(\\sqrt{x})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})\\right] \\\\  & =\\frac{\\operatorname{arccot} (\\sqrt{x})}{2\\sqrt{x}}-\\frac{\\sqrt{x}}{1+x}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =\\frac{\\operatorname{arccot} (\\sqrt{x})}{2\\sqrt{x}}-\\frac{1}{2(1+x)}.\\end{aligned}\n$$"] [:db/cas 17592186315068 :question/worked-solution "Since $f$ is the $\\pi /2$-periodic extension of $F,$ we have  \n\n- $f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement “$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$” is true. This is exactly the definition of $\\frac{\\pi }{2}$-periodicity:\n\n$$\nf(x+\\frac{\\pi }{2})=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement “$f(x)=F(x)$ for all $x\\in R$” is false. For example, take $x=\\frac{3\\pi }{4}.$ Using the periodicity of $f(x):$\n\n$$\n\\begin{aligned}f\\left(\\frac{3\\pi }{4}\\right)=f(\\frac{\\pi }{4}+\\frac{\\pi }{2})=f\\left(\\frac{\\pi }{4}\\right)=F\\left(\\frac{\\pi }{4}\\right)=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F\\left(\\frac{3\\pi }{4}\\right)=\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{4})=\\operatorname{sin}⁡\\left(\\frac{3\\pi }{2}\\right)=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{3\\pi }{4}.$\n\n- Statement “$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$” is true. Since $f$ is $\\frac{\\pi }{2}$-periodic, any shift by a multiple of its period returns the same value:\n\n$$\n\\begin{aligned}f(x+\\frac{\\pi }{2})=f(x)\\,\\text{and}\\,f(x-\\frac{\\pi }{2})=f((x-\\frac{\\pi }{2})+\\frac{\\pi }{2})=f(x).\\end{aligned}\n$$\n\nSince both sides equal $f(x),$ the statement is true for all $x\\in R.$\n\nTherefore, the correct answer is “$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$”; “$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$” only." "Since $f$ is the $\\pi /2$-periodic extension of $F,$ we have  \n\n- $f\\left(x+\\frac{\\pi }{2}\\right)=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement “$f\\left(x+\\frac{\\pi }{2}\\right)=f(x)$ for all $x\\in R$” is true. This is exactly the definition of $\\frac{\\pi }{2}$-periodicity:\n\n$$\nf\\left(x+\\frac{\\pi }{2}\\right)=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement “$f(x)=F(x)$ for all $x\\in R$” is false. For example, take $x=\\frac{3\\pi }{4}.$ Using the periodicity of $f(x):$\n\n$$\n\\begin{aligned}f\\left(\\frac{3\\pi }{4}\\right)=f\\left(\\frac{\\pi }{4}+\\frac{\\pi }{2}\\right)=f\\left(\\frac{\\pi }{4}\\right)=F\\left(\\frac{\\pi }{4}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{4}\\right)=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F\\left(\\frac{3\\pi }{4}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{3\\pi }{4}\\right)=\\operatorname{sin}⁡\\left(\\frac{3\\pi }{2}\\right)=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{3\\pi }{4}.$\n\n- Statement “$f\\left(x+\\frac{\\pi }{2}\\right)=f\\left(x-\\frac{\\pi }{2}\\right)$ for all $x\\in R$” is true. Since $f$ is $\\frac{\\pi }{2}$-periodic, any shift by a multiple of its period returns the same value:\n\n$$\n\\begin{aligned}f\\left(x+\\frac{\\pi }{2}\\right)=f(x)\\,\\text{and}\\,f\\left(x-\\frac{\\pi }{2}\\right)=f\\left(\\left(x-\\frac{\\pi }{2}\\right)+\\frac{\\pi }{2}\\right)=f(x).\\end{aligned}\n$$\n\nSince both sides equal $f(x),$ the statement is true for all $x\\in R.$\n\nTherefore, the correct answer is “$f\\left(x+\\frac{\\pi }{2}\\right)=f(x)$ for all $x\\in R$”; “$f\\left(x+\\frac{\\pi }{2}\\right)=f\\left(x-\\frac{\\pi }{2}\\right)$ for all $x\\in R$” only."] [:db/cas 17592186315074 :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=10x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{20}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{20}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{20}{\\pi }(\\frac{1}{n}[x\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{20}{n\\pi }((\\pi \\cdot \\operatorname{sin}⁡(n\\pi )-0\\cdot \\operatorname{sin}⁡(0))+\\frac{1}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{20}{n\\pi }(0+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{20(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{20((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$" "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=10x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{20}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{20}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{20}{\\pi }\\left(\\frac{1}{n}[x\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{20}{n\\pi }\\left((\\pi \\cdot \\operatorname{sin}⁡(n\\pi )-0\\cdot \\operatorname{sin}⁡(0))+\\frac{1}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =\\frac{20}{n\\pi }\\left(0+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))\\right) \\\\  & =\\frac{20(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{20((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$"] [:db/cas 17592186315075 :question/problem "Let $F(x)=5x+2$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(2+\\frac{5}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" "Let $F(x)=5x+2$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼\\left(2+\\frac{5}{2}\\pi \\right)+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$"] [:db/cas 17592186315075 :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5x+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5x+2)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=5x+2\\, & ⇒\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(5x+2)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{5}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((5\\pi +2)\\operatorname{sin}⁡(n\\pi )-2\\operatorname{sin}⁡(0))+\\frac{5}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{5}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{10(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(2+\\frac{5}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5x+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5x+2)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=5x+2\\, & ⇒\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }\\left(\\frac{1}{n}[(5x+2)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{5}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{2}{n\\pi }\\left(((5\\pi +2)\\operatorname{sin}⁡(n\\pi )-2\\operatorname{sin}⁡(0))+\\frac{5}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =\\frac{2}{n\\pi }\\left(0+\\frac{5}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))\\right) \\\\  & =\\frac{10(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼\\left(2+\\frac{5}{2}\\pi \\right)+{\\sum }_{n=1}^{\\infty }\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"] [:db/cas 17592186315076 :question/problem "Let $F(x)=x+4$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(4+\\frac{\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" "Let $F(x)=x+4$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼\\left(4+\\frac{\\pi }{2}\\right)+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$"] [:db/cas 17592186315076 :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=x+4$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(x+4)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x+4\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(x+4)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((\\pi +4)\\operatorname{sin}⁡(nx)-(0+4)\\operatorname{sin}⁡(nx))+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{2(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{2((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(4+\\frac{\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\frac{2((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=x+4$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(x+4)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x+4\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }\\left(\\frac{1}{n}[(x+4)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{2}{n\\pi }\\left(((\\pi +4)\\operatorname{sin}⁡(nx)-(0+4)\\operatorname{sin}⁡(nx))+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))\\right) \\\\  & =\\frac{2}{n\\pi }\\left(0+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))\\right) \\\\  & =\\frac{2(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{2((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼\\left(4+\\frac{\\pi }{2}\\right)+{\\sum }_{n=1}^{\\infty }\\frac{2((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"] [:db/cas 17592186315077 :question/problem "Let $F(x)=3x+1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(1+\\frac{3}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" "Let $F(x)=3x+1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼\\left(1+\\frac{3}{2}\\pi \\right)+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$"] [:db/cas 17592186315077 :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=3x+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(3x+1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=3x+1\\, & ⇒\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(3x+1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((3\\pi +1)\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))+\\frac{3}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{3}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{6(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(1+\\frac{3}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=3x+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(3x+1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=3x+1\\, & ⇒\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }\\left(\\frac{1}{n}[(3x+1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{2}{n\\pi }\\left(((3\\pi +1)\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))+\\frac{3}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =\\frac{2}{n\\pi }\\left(0+\\frac{3}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))\\right) \\\\  & =\\frac{6(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼\\left(1+\\frac{3}{2}\\pi \\right)+{\\sum }_{n=1}^{\\infty }\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"] [:db/cas 17592186315078 :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-2x+5$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-2x+5)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-2x+5\\, & ⇒\\,{u}^{′}=-2 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(-2x+5)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }+\\frac{2}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((-2\\pi +5)\\operatorname{sin}⁡(n\\pi )-5\\operatorname{sin}⁡(0))-\\frac{2}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0-\\frac{2}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{4(1-\\operatorname{cos}⁡(n\\pi ))}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(5-\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-2x+5$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-2x+5)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-2x+5\\, & ⇒\\,{u}^{′}=-2 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }\\left(\\frac{1}{n}[(-2x+5)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }+\\frac{2}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x\\right) \\\\  & =\\frac{2}{n\\pi }\\left(((-2\\pi +5)\\operatorname{sin}⁡(n\\pi )-5\\operatorname{sin}⁡(0))-\\frac{2}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =\\frac{2}{n\\pi }\\left(0-\\frac{2}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))\\right) \\\\  & =\\frac{4(1-\\operatorname{cos}⁡(n\\pi ))}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(5-\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"] [:db/cas 17592186315079 :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5{x}^{2}+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5{x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[\\frac{5{x}^{3}}{3}+2x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(\\frac{5{\\pi }^{3}}{3}+2\\pi )-0 \\\\  & =2(\\frac{5{\\pi }^{2}}{3}+2).\\end{aligned}\n$$" "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5{x}^{2}+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5{x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\left[\\frac{5{x}^{3}}{3}+2x\\right]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }\\left(\\frac{5{\\pi }^{3}}{3}+2\\pi \\right)-0 \\\\  & =2\\left(\\frac{5{\\pi }^{2}}{3}+2\\right).\\end{aligned}\n$$"] [:db/cas 17592186315080 :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡\\left(\\frac{x}{4}\\right)$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡\\left(\\frac{x}{4}\\right)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[4\\operatorname{cos}⁡\\left(\\frac{x}{4}\\right)]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(4\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)-4\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(4\\cdot \\frac{\\sqrt{2}}{2}-4) \\\\  & =\\frac{4}{\\pi }(\\sqrt{2}-2).\\end{aligned}\n$$" "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡\\left(\\frac{x}{4}\\right)$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡\\left(\\frac{x}{4}\\right)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\left[4\\operatorname{cos}⁡\\left(\\frac{x}{4}\\right)\\right]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }\\left(4\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)-4\\operatorname{cos}⁡(0)\\right) \\\\  & =\\frac{2}{\\pi }\\left(4\\cdot \\frac{\\sqrt{2}}{2}-4\\right) \\\\  & =\\frac{4}{\\pi }(\\sqrt{2}-2).\\end{aligned}\n$$"] [:db/cas 17592186315081 :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡\\left(\\frac{x}{6}\\right)$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡\\left(\\frac{x}{6}\\right)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[6\\operatorname{cos}⁡\\left(\\frac{x}{6}\\right)]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(6\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)-6\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(6\\cdot \\frac{\\sqrt{3}}{2}-6) \\\\  & =\\frac{6(\\sqrt{3}-2)}{\\pi }.\\end{aligned}\n$$" "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡\\left(\\frac{x}{6}\\right)$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡\\left(\\frac{x}{6}\\right)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\left[6\\operatorname{cos}⁡\\left(\\frac{x}{6}\\right)\\right]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }\\left(6\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)-6\\operatorname{cos}⁡(0)\\right) \\\\  & =\\frac{2}{\\pi }\\left(6\\cdot \\frac{\\sqrt{3}}{2}-6\\right) \\\\  & =\\frac{6(\\sqrt{3}-2)}{\\pi }.\\end{aligned}\n$$"] [:db/cas 17592186315082 :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ &= ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1⟩ \\\\ &= ⟨\\frac{{a}_{0}}{2},1⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x.\\end{aligned}\n$$" "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ &= \\left\\langle \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1\\right\\rangle  \\\\ &= \\left\\langle \\frac{{a}_{0}}{2},1\\right\\rangle +{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x.\\end{aligned}\n$$"] [:db/cas 17592186315083 :question/worked-solution "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-3x+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-3x+2)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+2\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(-\\frac{1}{n}[(-3x+2)\\operatorname{cos}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x) \\\\  & =-\\frac{2}{n\\pi }(((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2\\operatorname{cos}⁡(0))+\\frac{3}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }) \\\\  & =-\\frac{2}{n\\pi }((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2+\\frac{3}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))) \\\\  & =-\\frac{2}{n\\pi }((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2).\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=-\\frac{2}{n\\pi }((-3\\pi +2)(-1)^{n}-2)=\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2).\n$$\n\nFinally, the Fourier sine series is\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2)\\cdot \\operatorname{sin}⁡(nx).\n$$" "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-3x+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-3x+2)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+2\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }\\left(-\\frac{1}{n}[(-3x+2)\\operatorname{cos}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x\\right) \\\\  & =-\\frac{2}{n\\pi }\\left(((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2\\operatorname{cos}⁡(0))+\\frac{3}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =-\\frac{2}{n\\pi }\\left((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2+\\frac{3}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))\\right) \\\\  & =-\\frac{2}{n\\pi }((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2).\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=-\\frac{2}{n\\pi }((-3\\pi +2)(-1)^{n}-2)=\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2).\n$$\n\nFinally, the Fourier sine series is\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2)\\cdot \\operatorname{sin}⁡(nx).\n$$"] [:db/cas 17592186315084 :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡(4x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{cos}⁡(4x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{2}\\operatorname{cos}⁡(x)]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(14\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{2}(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{14}(1-1)+\\frac{1}{2}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{cos}⁡(4x)$ $\\text{are orthogonal}$ with respect to the inner product." "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡(4x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{cos}⁡(4x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & ={\\left[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{2}\\operatorname{cos}⁡(x)\\right]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(14\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{2}(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{14}(1-1)+\\frac{1}{2}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{cos}⁡(4x)$ $\\text{are orthogonal}$ with respect to the inner product."] [:db/cas 17592186315087 :question/worked-solution "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-2x+3$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-2x+3)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-2x+3\\, & ⇒\\,{u}^{′}=-2 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(-\\frac{1}{n}[(-2x+3)\\operatorname{cos}⁡(nx)]_{0}^{\\pi }-\\frac{2}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x) \\\\  & =-\\frac{2}{n\\pi }(((-2\\pi +3)\\operatorname{cos}⁡(n\\pi )-3\\cdot \\operatorname{cos}⁡(0))+\\frac{2}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }) \\\\  & =-\\frac{2}{n\\pi }((-2\\pi +3)\\operatorname{cos}⁡(n\\pi )-3+\\frac{2}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))) \\\\  & =-\\frac{2}{n\\pi }((-2\\pi +3)\\operatorname{cos}⁡(n\\pi )-3).\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=-\\frac{2}{n\\pi }((-2\\pi +3)(-1)^{n}-3)=\\frac{2}{n\\pi }((-1)^{n}(2\\pi -3)+3).\n$$" "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-2x+3$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-2x+3)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-2x+3\\, & ⇒\\,{u}^{′}=-2 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }\\left(-\\frac{1}{n}[(-2x+3)\\operatorname{cos}⁡(nx)]_{0}^{\\pi }-\\frac{2}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x\\right) \\\\  & =-\\frac{2}{n\\pi }\\left(((-2\\pi +3)\\operatorname{cos}⁡(n\\pi )-3\\cdot \\operatorname{cos}⁡(0))+\\frac{2}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }\\right) \\\\  & =-\\frac{2}{n\\pi }\\left((-2\\pi +3)\\operatorname{cos}⁡(n\\pi )-3+\\frac{2}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))\\right) \\\\  & =-\\frac{2}{n\\pi }((-2\\pi +3)\\operatorname{cos}⁡(n\\pi )-3).\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=-\\frac{2}{n\\pi }((-2\\pi +3)(-1)^{n}-3)=\\frac{2}{n\\pi }((-1)^{n}(2\\pi -3)+3).\n$$"] [:db/cas 17592186315088 :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\sin ⁡x)=\\cos ⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5\\sin ⁡x}{4}+\\frac{{x}^{4}}{4}) \\\\  & =\\frac{5}{4}(\\cos ⁡x)+\\frac{1}{4}(4{x}^{3}) \\\\  & =\\frac{5\\cos ⁡x}{4}+{x}^{3}.\\end{aligned}\n$$" "We know that $\\frac{\\text{d}}{\\text{d}x}(\\sin ⁡x)=\\cos ⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5\\sin ⁡x}{4}+\\frac{{x}^{4}}{4}\\right) \\\\  & =\\frac{5}{4}(\\cos ⁡x)+\\frac{1}{4}(4{x}^{3}) \\\\  & =\\frac{5\\cos ⁡x}{4}+{x}^{3}.\\end{aligned}\n$$"] [:db/cas 17592186315092 :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)=\\begin{cases}0,\\hspace{1em} & t<0 \\\\ 1,\\hspace{1em} & t\\ge 0.\\end{cases}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(8-t)=\\begin{cases}1,\\hspace{1em} & t\\le 8 \\\\ 0,\\hspace{1em} & t>8\\end{cases}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(8-t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{8}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{8}^{\\infty }0\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{8}{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe compute this integral for $s>0$ as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{8}{e}^{-st}\\,\\text{d}t \\\\  & ={[-\\frac{{e}^{-st}}{s}]}_{0}^{8} \\\\  & =-\\frac{{e}^{-8s}}{s}+\\frac{1}{s} \\\\  & =\\frac{1}{s}(1-{e}^{-8s})\\end{aligned}\n$$" "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)=\\begin{cases}0,\\hspace{1em} & t<0 \\\\ 1,\\hspace{1em} & t\\ge 0.\\end{cases}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(8-t)=\\begin{cases}1,\\hspace{1em} & t\\le 8 \\\\ 0,\\hspace{1em} & t>8\\end{cases}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(8-t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{8}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{8}^{\\infty }0\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{8}{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe compute this integral for $s>0$ as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{8}{e}^{-st}\\,\\text{d}t \\\\  & ={\\left[-\\frac{{e}^{-st}}{s}\\right]}_{0}^{8} \\\\  & =-\\frac{{e}^{-8s}}{s}+\\frac{1}{s} \\\\  & =\\frac{1}{s}(1-{e}^{-8s})\\end{aligned}\n$$"] [:db/cas 17592186315106 :question/worked-solution "First, we convert the given probability into a cumulative probability:\n\n$$\n\\begin{aligned}P(X<2)=0.5910\\,⇒\\,P(X\\le 2)=0.5910\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2) & =0.5910 \\\\ P\\,(Z\\le \\frac{2-1.5}{\\sigma }) & =0.5910 \\\\ Φ\\,\\left(\\frac{0.5}{\\sigma }\\right) & =0.5910 \\\\ \\frac{0.5}{\\sigma } & ={Φ}^{-1}(0.5910)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.23)=0.5910\\,⇒\\,{Φ}^{-1}(0.5910)=0.23.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{0.5}{\\sigma } & =0.23 \\\\ \\sigma  & =\\frac{0.5}{0.23} \\\\ \\sigma  & ≈2.173\\,91,\\end{aligned}\n$$\n\nrounded to $5$ decimal places.\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2}=(2.173\\,91)^{2}≈4.73.\\end{aligned}\n$$" "First, we convert the given probability into a cumulative probability:\n\n$$\n\\begin{aligned}P(X<2)=0.5910\\,⇒\\,P(X\\le 2)=0.5910\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2) & =0.5910 \\\\ P\\,\\left(Z\\le \\frac{2-1.5}{\\sigma }\\right) & =0.5910 \\\\ Φ\\,\\left(\\frac{0.5}{\\sigma }\\right) & =0.5910 \\\\ \\frac{0.5}{\\sigma } & ={Φ}^{-1}(0.5910)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.23)=0.5910\\,⇒\\,{Φ}^{-1}(0.5910)=0.23.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{0.5}{\\sigma } & =0.23 \\\\ \\sigma  & =\\frac{0.5}{0.23} \\\\ \\sigma  & ≈2.173\\,91,\\end{aligned}\n$$\n\nrounded to $5$ decimal places.\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2}=(2.173\\,91)^{2}≈4.73.\\end{aligned}\n$$"] [:db/cas 17592186315109 :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+5{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-2}+5{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+5\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-2(-2{y}^{-3})+5(2y) \\\\  & =\\frac{4}{{y}^{3}}+10y \\\\  & =\\frac{4+10{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{{y}^{3}}{4+10{y}^{4}}.\n$$" "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}\\left(-\\frac{2}{{y}^{2}}+5{y}^{2}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-2}+5{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+5\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-2(-2{y}^{-3})+5(2y) \\\\  & =\\frac{4}{{y}^{3}}+10y \\\\  & =\\frac{4+10{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{{y}^{3}}{4+10{y}^{4}}.\n$$"] [:db/cas 17592186315132 :answer/value "(