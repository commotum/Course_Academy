186045498} :answer/value "s\\le -\\frac{1}{4}" :db/id #edb/ref 17592186312939}] :answer-field/correct {:db/id #edb/ref 17592186312912} :answer-field/id #uuid "c2953cca-c192-534b-8129-b35317c5c8c2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314557} {:answer-field/choices [{:answer/id #uuid "68912a76-3768-5fb8-bc31-7df9990f896e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }{e}^{(-1/4+s)t}\\,\\text{d}t" :db/id #edb/ref 17592186312794} {:answer/id #uuid "a8e42ecc-59bc-5bc2-8c08-b7c60669b503" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\le -\\frac{1}{4}" :db/id #edb/ref 17592186313300} {:answer/id #uuid "d160e714-5c7b-569c-b90b-3a6248ee49c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\infty }^{\\infty }{e}^{(-1/4-s)t}\\,\\text{d}t" :db/id #edb/ref 17592186313611} {:answer/id #uuid "e55e1719-7063-579d-8557-74da7489a611" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }{e}^{(-1/4-s)t}\\,\\text{d}t" :db/id #edb/ref 17592186313788} {:answer/id #uuid "ea32d01e-b8ff-59fa-9782-c2fb47dcd2b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\infty }^{\\infty }{e}^{(-1/4+s)t}\\,\\text{d}t" :db/id #edb/ref 17592186313838}] :answer-field/correct {:db/id #edb/ref 17592186313300} :answer-field/id #uuid "cf059f47-58a0-5753-b1d2-f7dca1fe25f2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314580}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fc7c5db0-02db-5d4a-bb26-bb53af87d850" :question/math-academy-id "q-340733" :question/problem "Complete the arguments in the reasoning below to find the Laplace transform of $f(t)={e}^{-t/4}.$First, we apply the definition of the Laplace transform:\n\n$$\nL{f(t)}=F(s)={{field-1}}\n$$\n\nWe now examine the convergence of $F(s)$ for different values of $s:$\n\n$\\,$ For {{field-2}}\nthe integral is divergent.\n\n$\\,$ For {{field-3}}\nthe integral is convergent.\n\nEvaluating our integral in the convergent case, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{(-1/4-s)t}\\,\\text{d}t={{field-4}}.\n$$\n\nTherefore, we conclude that $L{{e}^{-t/4}}=\\frac{4}{4s+1},$ \ndefined for\n{{field-5}}." :question/worked-solution "For a function $f(t)$ defined on $[0,\\infty ),$ the Laplace transform of $f,$ denoted $L{f(t)}$ or $F(s),$ is a function of the variable $s$ defined as\n\n$$\nF(s)=L{f(t)}={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,\\text{d}t\n$$\n\nprovided that this integral exists and is finite. \n\nFor the function $f(t)={e}^{-t/4},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-t/4}\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-st-t/4}\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{(-1/4-s)t}\\text{d}t.\\end{aligned}\n$$\n\nWe calculate our integral as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-1/4-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-s)t}\\text{d}t\\end{aligned}\n$$\n\nTo evaluate the last integral, we must consider whether $s\\ne -\\frac{1}{4}$ or $s=-\\frac{1}{4}.$\n\n- If $s\\ne -\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(s) & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{-1/4-s}{e}^{(-1/4-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{-1/4-s}(\\lim_{a\\to \\infty }{e}^{(-1/4-s)a}-1) \\\\  & =\\frac{1}{s+1/4}(1-\\lim_{a\\to \\infty }{e}^{(-1/4-s)a}) \\\\  & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a}\\end{aligned}\n$$\n\nLet's evaluate the limit. We have\n\n$$\n\\begin{aligned}\\lim_{a\\to \\mathrm{\\infty }}{e}^{(-1/4-s)a}=\\begin{cases}0,\\hspace{1em} & s>-\\frac{1}{4}, \\\\ \\mathrm{\\infty },\\hspace{1em} & s<-\\frac{1}{4}.\\end{cases}\\end{aligned}\n$$\n\n- If $s=-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F\\left(-\\frac{1}{4}\\right) & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-(-1/4))t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{0t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }t\\,{|}_{0}^{a} \\\\  & =\\lim_{a\\to \\infty }(a-0) \\\\  & =\\lim_{a\\to \\infty }a \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore:\n\n- For $s\\le -\\frac{1}{4}$ the integral is divergent.\n\n- For $s>-\\frac{1}{4}$ the integral is convergent.\n\nEvaluating for $s>-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a} \\\\  & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot 0 \\\\  & =\\frac{1}{s+1/4} \\\\  & =\\frac{4}{4s+1}.\\end{aligned}\n$$\n\nSo, the Laplace transform of $f(t)={e}^{-t/4}$ is $F(s)=\\frac{4}{4s+1},$ defined for $s>-\\frac{1}{4}.$"} {:db/id #edb/ref 17592186315007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33eeb63c-8a3d-51d0-9df5-59b444335bb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>-4" :db/id #edb/ref 17592186312394} {:answer/id #uuid "4722a2e5-34a4-55c8-b2dc-d18be9d70a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>0" :db/id #edb/ref 17592186312554} {:answer/id #uuid "7ce4f685-be85-5eb5-87c5-3b900911de9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>4" :db/id #edb/ref 17592186312976} {:answer/id #uuid "c52bd3a9-19e1-5a72-a8dc-5f09f1709db0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s<0" :db/id #edb/ref 17592186313523}] :answer-field/correct {:db/id #edb/ref 17592186312554} :answer-field/id #uuid "2856d971-7704-5c1f-9673-b5518021e7f2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314117} {:answer-field/choices [{:answer/id #uuid "4cf97564-d8c5-5ce9-bb0b-bcaf5bcd2603" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s-4\\text{i}}" :db/id #edb/ref 17592186312598} {:answer/id #uuid "68f683b8-a496-56f9-9707-c10efd3adebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{s}{s+4\\text{i}}" :db/id #edb/ref 17592186312796} {:answer/id #uuid "c00bb487-624f-5af5-88e3-043147aa0858" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s+4\\text{i}}" :db/id #edb/ref 17592186313479} {:answer/id #uuid "cb8c0f48-07c8-5af3-a1cd-ac8bef44e1c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{s}{s-4\\text{i}}" :db/id #edb/ref 17592186313562}] :answer-field/correct {:db/id #edb/ref 17592186312598} :answer-field/id #uuid "5400ad96-c049-5af8-bd3d-e2c4288b9588" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314246}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9cf42d2-c3b2-53c0-b918-41826a147a08" :question/math-academy-id "q-340736" :question/problem "What is the Laplace transform of $f(t)={e}^{4\\text{i}t},$ where $t,s\\in R?$$\\,L(f(t))=$\n{{field-1}},\ndefined for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{4\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{4\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(4\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(4\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(4\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{4\\text{i}-s}{e}^{(4\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{4\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(4\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-4\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(4\\text{i}-s)a}) \\\\  & =\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{4\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-4\\text{i}}-\\frac{1}{s-4\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(4a)+\\text{i}\\operatorname{sin}⁡(4a))] \\\\  & =\\frac{1}{s-4\\text{i}}-0 \\\\  & =\\frac{1}{s-4\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{4\\text{i}t}$ is $F(s)=\\frac{1}{s-4\\text{i}},$ defined for $s>0.$"} {:db/id #edb/ref 17592186315008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e8f789-158e-5efa-89e6-b6088ce4ec5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{s}{s-7\\text{i}}" :db/id #edb/ref 17592186312013} {:answer/id #uuid "09b0f12f-34db-59a8-ab96-d3705a683904" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s+7\\text{i}}" :db/id #edb/ref 17592186312047} {:answer/id #uuid "1fe47bf8-7b01-5514-92ed-3a2b205189e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{s}{s+7\\text{i}}" :db/id #edb/ref 17592186312215} {:answer/id #uuid "ade6004c-313e-5fd1-95fe-c7b632ea902d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s-7\\text{i}}" :db/id #edb/ref 17592186313334}] :answer-field/correct {:db/id #edb/ref 17592186313334} :answer-field/id #uuid "6d68ab60-7d28-560a-8fd4-52bec8590884" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314314} {:answer-field/choices [{:answer/id #uuid "70772930-02d2-526f-a7a4-247d9cac6df1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>0" :db/id #edb/ref 17592186312859} {:answer/id #uuid "7c26cd7a-85eb-5aad-bf99-fdeb3ed0cb2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>-7" :db/id #edb/ref 17592186312971} {:answer/id #uuid "8bc0f907-06fe-574e-9fcd-3c0f422d79c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>7" :db/id #edb/ref 17592186313091} {:answer/id #uuid "bd7b08cb-7e7f-5634-b31f-b8d9f72f78ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s<0" :db/id #edb/ref 17592186313457}] :answer-field/correct {:db/id #edb/ref 17592186312859} :answer-field/id #uuid "b2aa715f-3a29-5ba5-960f-3168f5188f57" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "72f760c7-5015-52bc-823b-bed24865132a" :question/math-academy-id "q-340737" :question/problem "What is the Laplace transform of $f(t)={e}^{7\\text{i}t},$ where $t,s\\in R?$$\\,L(f(t))=$\n{{field-1}},\ndefined for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{7\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{7\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{7\\text{i}-s}{e}^{(7\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{7\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(7\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-7\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(7\\text{i}-s)a}) \\\\  & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{7\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))] \\\\  & =\\frac{1}{s-7\\text{i}}-0 \\\\  & =\\frac{1}{s-7\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{7\\text{i}t}$ is $F(s)=\\frac{1}{s-7\\text{i}},$ defined for $s>0.$"} {:db/id #edb/ref 17592186315009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf8be6c-65cb-5488-b4d1-5e482c264e28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{s}{s+2\\text{i}}" :db/id #edb/ref 17592186312065} {:answer/id #uuid "2b1ecbd4-749a-57da-a4c2-b0b36c361076" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s-2\\text{i}}" :db/id #edb/ref 17592186312309} {:answer/id #uuid "5237cfbe-0b9e-5ab0-9422-8c870c121efd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s+2\\text{i}}" :db/id #edb/ref 17592186312642} {:answer/id #uuid "66d5ec86-b6c8-5b90-81bf-b90463c5933e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{s}{s-2\\text{i}}" :db/id #edb/ref 17592186312786}] :answer-field/correct {:db/id #edb/ref 17592186312642} :answer-field/id #uuid "2ccc93ae-3521-5524-b625-8f6ace527627" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314128} {:answer-field/choices [{:answer/id #uuid "04cb0f84-f6ec-5dcc-8f28-ecc08ed54777" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>2" :db/id #edb/ref 17592186312002} {:answer/id #uuid "0b744974-618a-5d4b-b160-65db677537f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>0" :db/id #edb/ref 17592186312061} {:answer/id #uuid "494c9c3c-702e-550f-8da7-72c9ff41ecf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s<0" :db/id #edb/ref 17592186312563} {:answer/id #uuid "7b8b1c34-5d6e-58a7-9764-8fdcc101ad01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>-2" :db/id #edb/ref 17592186312964}] :answer-field/correct {:db/id #edb/ref 17592186312061} :answer-field/id #uuid "f0b6a3e9-a956-5097-a02a-e7f23650ea30" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314673}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01454c1b-8bb1-582b-8cb0-51d12631f4e7" :question/math-academy-id "q-340739" :question/problem "What is the Laplace transform of $f(t)={e}^{-2\\text{i}t},$ where $t,s\\in R?$$\\,L(f(t))=$\n{{field-1}},\ndefined for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-2\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-2\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & =\\lim_{a\\to \\infty }{(\\frac{1}{-2\\text{i}-s}{e}^{(-2\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{-2\\text{i}-s}(\\lim_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s+2\\text{i}}(1-\\lim_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}) \\\\  & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}(\\lim_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-2\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[\\lim_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))] \\\\  & =\\frac{1}{s+2\\text{i}}-0 \\\\  & =\\frac{1}{s+2\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-2\\text{i}t}$ is $F(s)=\\frac{1}{s+2\\text{i}},$ defined for $s>0.$"} {:db/id #edb/ref 17592186315011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c3e12fd-8603-5e35-aad8-ab60f1ba48dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{8s+3\\text{i}}" :db/id #edb/ref 17592186312318} {:answer/id #uuid "590355b9-ada8-5ff4-8467-bc70f24164ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8s+3\\text{i}}" :db/id #edb/ref 17592186312686} {:answer/id #uuid "b4174344-b313-5065-81e6-0cae0025ff22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3s+8\\text{i}}" :db/id #edb/ref 17592186313375} {:answer/id #uuid "d4229fb2-b03b-50f2-91f6-d04265bcaf0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3s+8\\text{i}}" :db/id #edb/ref 17592186313644}] :answer-field/correct {:db/id #edb/ref 17592186312318} :answer-field/id #uuid "4f776089-c6c8-5d03-9687-2c01a8a999d9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314233} {:answer-field/choices [{:answer/id #uuid "1a051ea1-c379-5a8b-9125-842ddf7a5c99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>-3/8" :db/id #edb/ref 17592186312165} {:answer/id #uuid "c053e5e8-e979-5f96-bb8a-9bbae0665043" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>3/8" :db/id #edb/ref 17592186313483} {:answer/id #uuid "d0368472-bf60-5353-8d6a-18bb6734fc74" :answer/type {:db/id #edb/ref 175921860