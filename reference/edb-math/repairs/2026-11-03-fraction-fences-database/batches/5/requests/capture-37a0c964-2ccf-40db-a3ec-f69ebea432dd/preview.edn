\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}\\left(\\frac{\\operatorname{sin}⁡(2x)}{2}\\right)-\\int \\left(\\frac{\\operatorname{sin}⁡(2x)}{2}\\right)(-{e}^{-x})\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}\\left(-\\frac{\\operatorname{cos}⁡(2x)}{2}\\right)-\\int \\left(-\\frac{\\operatorname{cos}⁡(2x)}{2}\\right)(-{e}^{-x})\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}(-\\frac