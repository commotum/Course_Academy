dt} & =g \\\\ \\int \\frac{1}{1-0.0064{v}^{2}}\\cdot \\frac{dv}{dt}\\,dt & =g\\int dt \\\\ \\int \\frac{1}{1-(0.08v)^{2}}\\,dv & =g\\int dt \\\\ \\frac{1}{0.08}\\operatorname{artanh}⁡(0.08v) & =gt+{C}_{1} \\\\ \\operatorname{artanh}⁡(0.08v) & =\\frac{2}{25}gt+C \\\\ 0.08v & =\\operatorname{tanh}⁡\\left(\\frac{2}{25}gt+C\\right) \\\\ v(t) & =\\frac{25}{2}\\operatorname{tanh}⁡\\left(\\frac{2}{25}gt+C\\right)\\end{aligned}\n$$\n\nwhere $C=0.08{C}_{1}$ is a constant of integration.\n\nWe're told that the package is released from rest. So, we can apply the initial condition $v(0)=0,$ and solve for $C:$\n\n$$\n\\begin{aligned}v(0) & =\\frac{25}{2}\\operatorname{tanh}⁡\\left(\\frac{2}{25}g\\cdot 0+C\\right) \\\\ 0 & =\\frac{25}{2}\\operatorname{tanh}⁡(C) \\\\ \\operatorname{tanh}⁡(C) & =0 \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have the following expression for $v(t):$\n\n$$\nv(t)=\\frac{25}{2}\\operatorname{tanh}⁡\\left(\\frac{2}{25}gt\\right)\n$$\n\nFinally, the velocity of the package after $t=2$ seconds is\n\n$$\n\\begin{aligned}v(2) & =\\frac{25}{2}\\operatorname{tanh}⁡(0.784\\cdot 2) \\\\  & =11.4588… \\\\  & ≈11.46\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to two decimal places."] [:db/cas 17592186363912 :question/worked-solution "First, note that only two forces act on the container: the force due to gravity, given by the weight\n\n$$\nw=mg=5\\,000g\n$$\n\nand the force due to drag $D,$ which is proportional to the velocity squared (and negative since it acts in the negative direction),\n\n$$\nD=-k{v}^{2},\n$$\n\nwhere $k>0$ is a constant of proportionality. Hence, the resultant force acting on the container is\n\n$$\nF=w+D=5\\,000g-k{v}^{2}.\n$$\n\nApplying Newton's second law, we obtain a separable first-order differential equation:\n\n$$\n\\begin{aligned}F & =ma \\\\ 5\\,000g-k{v}^{2} & =5\\,000\\,\\frac{dv}{dt} \\\\ \\frac{dv}{dt} & =g-\\frac{k}{5\\,000}{v}^{2}\\end{aligned}\n$$\n\nWe're told that, at a particular moment, the container's velocity is $12.5\\,\\text{m/s}$ and its instantaneous acceleration is $7.35\\,{\\text{m/s}}^{2}.$ Substituting these values and $g=9.8$ into the ODE, we can solve for $k:$\n\n$$\n7.35=g-\\frac{k}{5\\,000}\\cdot (12.5)^{2}\\,⟹\\,k=78.4\\,\\text{kg/m}\n$$\n\nTherefore, we have the following differential equation:\n\n$$\n\\frac{dv}{dt}=g-0.01568{v}^{2}\n$$\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{dv}{dt} & =g(1-0.0016{v}^{2}) \\\\ \\frac{1}{1-0.0016{v}^{2}}\\cdot \\frac{dv}{dt} & =g \\\\ \\int \\frac{1}{1-0.0016{v}^{2}}\\cdot \\frac{dv}{dt}\\,dt & =g\\int dt \\\\ \\int \\frac{1}{1-(0.04v)^{2}}\\,dv & =g\\int dt \\\\ \\frac{1}{0.04}\\operatorname{artanh}⁡(0.04v) & =gt+{C}_{1} \\\\ \\operatorname{artanh}⁡(0.04v) & =\\frac{1}{25}gt+C \\\\ 0.04v & =\\operatorname{tanh}⁡(\\frac{1}{25}gt+C) \\\\ v(t) & =25\\operatorname{tanh}⁡(\\frac{1}{25}gt+C)\\end{aligned}\n$$\n\nwhere $C=0.04{C}_{1}$ is a constant of integration.\n\nWe're told that the container is released from rest. So, we can apply the initial condition $v(0)=0,$ and solve for $C:$\n\n$$\n\\begin{aligned}v(0) & =25\\operatorname{tanh}⁡(\\frac{1}{25}g\\cdot 0+C) \\\\ 0 & =25\\operatorname{tanh}⁡(C) \\\\ \\operatorname{tanh}⁡(C) & =0 \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have the following expression for $v(t):$\n\n$$\nv(t)=25\\operatorname{tanh}⁡(\\frac{1}{25}gt)\n$$\n\nFinally, the velocity of the container after $t=3$ seconds is\n\n$$\n\\begin{aligned}v(3) & =25\\operatorname{tanh}⁡(0.392\\cdot 3) \\\\  & =20.6547… \\\\  & ≈20.65\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to two decimal places." "First, note that only two forces act on the container: the force due to gravity, given by the weight\n\n$$\nw=mg=5\\,000g\n$$\n\nand the force due to drag $D,$ which is proportional to the velocity squared (and negative since it acts in the negative direction),\n\n$$\nD=-k{v}^{2},\n$$\n\nwhere $k>0$ is a constant of proportionality. Hence, the resultant force acting on the container is\n\n$$\nF=w+D=5\\,000g-k{v}^{2}.\n$$\n\nApplying Newton's second law, we obtain a separable first-order differential equation:\n\n$$\n\\begin{aligned}F & =ma \\\\ 5\\,000g-k{v}^{2} & =5\\,000\\,\\frac{dv}{dt} \\\\ \\frac{dv}{dt} & =g-\\frac{k}{5\\,000}{v}^{2}\\end{aligned}\n$$\n\nWe're told that, at a particular moment, the container's velocity is $12.5\\,\\text{m/s}$ and its instantaneous acceleration is $7.35\\,{\\text{m/s}}^{2}.$ Substituting these values and $g=9.8$ into the ODE, we can solve for $k:$\n\n$$\n7.35=g-\\frac{k}{5\\,000}\\cdot (12.5)^{2}\\,⟹\\,k=78.4\\,\\text{kg/m}\n$$\n\nTherefore, we have the following differential equation:\n\n$$\n\\frac{dv}{dt}=g-0.01568{v}^{2}\n$$\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{dv}{dt} & =g(1-0.0016{v}^{2}) \\\\ \\frac{1}{1-0.0016{v}^{2}}\\cdot \\frac{dv}{dt} & =g \\\\ \\int \\frac{1}{1-0.0016{v}^{2}}\\cdot \\frac{dv}{dt}\\,dt & =g\\int dt \\\\ \\int \\frac{1}{1-(0.04v)^{2}}\\,dv & =g\\int dt \\\\ \\frac{1}{0.04}\\operatorname{artanh}⁡(0.04v) & =gt+{C}_{1} \\\\ \\operatorname{artanh}⁡(0.04v) & =\\frac{1}{25}gt+C \\\\ 0.04v & =\\operatorname{tanh}⁡\\left(\\frac{1}{25}gt+C\\right) \\\\ v(t) & =25\\operatorname{tanh}⁡\\left(\\frac{1}{25}gt+C\\right)\\end{aligned}\n$$\n\nwhere $C=0.04{C}_{1}$ is a constant of integration.\n\nWe're told that the container is released from rest. So, we can apply the initial condition $v(0)=0,$ and solve for $C:$\n\n$$\n\\begin{aligned}v(0) & =25\\operatorname{tanh}⁡\\left(\\frac{1}{25}g\\cdot 0+C\\right) \\\\ 0 & =25\\operatorname{tanh}⁡(C) \\\\ \\operatorname{tanh}⁡(C) & =0 \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have the following expression for $v(t):$\n\n$$\nv(t)=25\\operatorname{tanh}⁡\\left(\\frac{1}{25}gt\\right)\n$$\n\nFinally, the velocity of the container after $t=3$ seconds is\n\n$$\n\\begin{aligned}v(3) & =25\\operatorname{tanh}⁡(0.392\\cdot 3) \\\\  & =20.6547… \\\\  & ≈20.65\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to two decimal places."] [:db/cas 17592186363941 :question/problem "Evaluate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{9n}=\n$$\n{{field-1}}" "Evaluate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{9n}=\n$$\n{{field-1}}"] [:db/cas 17592186363941 :question/worked-solution "Recall the following special limit: \n\n$$\ne=\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{9n} & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{9} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{9} \\\\  & ={e}^{9}\\end{aligned}\n$$" "Recall the following special limit: \n\n$$\ne=\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{9n} & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{9} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{9} \\\\  & ={e}^{9}\\end{aligned}\n$$"] [:db/cas 17592186363944 :question/problem "Evaluate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n/5}=\n$$\n{{field-1}}" "Evaluate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n/5}=\n$$\n{{field-1}}"] [:db/cas 17592186363944 :question/worked-solution "Recall the following special limit: \n\n$$\ne=\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n/5} & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{1/5} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{1/5} \\\\  & ={e}^{1/5} \\\\  & =\\sqrt[5]{e}\\end{aligned}\n$$" "Recall the following special limit: \n\n$$\ne=\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n/5} & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{1/5} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{1/5} \\\\  & ={e}^{1/5} \\\\  & =\\sqrt[5]{e}\\end{aligned}\n$$"] [:db/cas 17592186363947 :question/problem "Calculate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{7nyz}=\n$$\n{{field-1}}" "Calculate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{7nyz}=\n$$\n{{field-1}}"] [:db/cas 17592186363947 :question/worked-solution "Recall the following special limit: \n\n$$\ne=\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{7nyz} & =\\lim_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{7yz} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{7yz} \\\\  & ={e}^{7yz}\\end{aligned}\n$$" "Recall the following special limit: \n\n$$\ne=\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{7nyz} & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{7yz} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{1}{n}\\right)}^{n}\\right]}^{7yz} \\\\  & ={e}^{7yz}\\end{aligned}\n$$"] [:db/cas 17592186363950 :question/problem "Calculate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{(1+\\frac{x}{n})}^{-n}=\n$$\n{{field-1}}" "Calculate the following limit:\n\n$$\n\\lim_{n\\to \\infty }{\\left(1+\\frac{x}{n}\\right)}^{-n}=\n$$\n{{field-1}}"] [:db/cas 17592186363950 :question/worked-solution "Recall the following special limit: \n\n$$\n{e}^{x}=\\lim_{n\\to \\infty }{(1+\\frac{x}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{(1+\\frac{x}{n})}^{-n} & =\\lim_{n\\to \\infty }{[{(1+\\frac{x}{n})}^{n}]}^{-1} \\\\  & ={[\\lim_{n\\to \\infty }{(1+\\frac{x}{n})}^{n}]}^{-1} \\\\  & ={({e}^{x})}^{-1} \\\\  & ={e}^{-x} \\\\  & =\\frac{1}{{e}^{x}}\\end{aligned}\n$$" "Recall the following special limit: \n\n$$\n{e}^{x}=\\lim_{n\\to \\infty }{\\left(1+\\frac{x}{n}\\right)}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{\\left(1+\\frac{x}{n}\\right)}^{-n} & =\\lim_{n\\to \\infty }{\\left[{\\left(1+\\frac{x}{n}\\right)}^{n}\\right]}^{-1} \\\\  & ={\\left[\\lim_{n\\to \\infty }{\\left(1+\\frac{x}{n}\\right)}^{n}\\right]}^{-1} \\\\  & ={({e}^{x})}^{-1} \\\\  & ={e}^{-x} \\\\  & =\\frac{1}{{e}^{x}}\\end{aligned}\n$$"] [:db/cas 17592186364406 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={\\cos }^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={\\cos }^{2}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le 0.$ \n\nNow, if $f(x,y)={x}^{2}+{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({\\cos }^{2}⁡\\theta )}^{2}+{(\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )}^{2} \\\\  & ={\\cos }^{4}⁡\\theta +{\\sin }^{2}⁡\\theta {\\cos }^{2}⁡\\theta  \\\\  & ={\\cos }^{2}⁡\\theta ({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta ) \\\\  & ={\\cos }^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta ) \\\\  & =-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡2\\theta )}^{2}} \\\\  & =\\sqrt{{\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+{y}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /4}^{0}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}{\\cos }^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}{\\cos }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}\\frac{1+\\operatorname{cos}⁡2\\theta }{2}\\,\\text{d}\\theta  \\\\  & =\\frac{2\\theta +\\operatorname{sin}⁡2\\theta }{4}{|}_{-\\pi /4}^{0} \\\\  & =\\frac{1}{4}(0-\\left(-\\frac{\\pi }{2}\\right)-(-1)) \\\\  & =\\frac{\\pi +2}{8}\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={\\cos }^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={\\cos }^{2}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le 0.$ \n\nNow, if $f(x,y)={x}^{2}+{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({\\cos }^{2}⁡\\theta )}^{2}+{(\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )}^{2} \\\\  & ={\\cos }^{4}⁡\\theta +{\\sin }^{2}⁡\\theta {\\cos }^{2}⁡\\theta  \\\\  & ={\\cos }^{2}⁡\\theta ({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta ) \\\\  & ={\\cos }^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta ) \\\\  & =-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡2\\theta )}^{2}} \\\\  & =\\sqrt{{\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+{y}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /4}^{0}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}{\\cos }^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}{\\cos }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}\\frac{1+\\operatorname{cos}⁡2\\theta }{2}\\,\\text{d}\\theta  \\\\  & =\\frac{2\\theta +\\operatorname{sin}⁡2\\theta }{4}{|}_{-\\pi /4}^{0} \\\\  & =\\frac{1}{4}\\left(0-\\left(-\\frac{\\pi }{2}\\right)-(-1)\\right) \\\\  & =\\frac{\\pi +2}{8}\\end{aligned}\n$$"] [:db/cas 17592186364413 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =4\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =4\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=4\\operatorname{cos}⁡\\theta $ and $y=4\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)={x}^{3}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(4\\operatorname{cos}⁡\\theta )^{3}4\\operatorname{sin}⁡\\theta  \\\\  & =256{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(4)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{4}^{2}+{0}^{2}} \\\\  & =4.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}y\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}256{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 4\\cdot \\text{d}\\theta  \\\\  & =1\\,024{\\int }_{0}^{\\pi /4}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡\\theta ,$ $\\text{d}u=-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}1\\,024{\\int }_{0}^{\\pi /4}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =-1\\,024{\\int }_{1}^{\\sqrt{2}/2}{u}^{3}\\,\\text{d}u \\\\  & =-1\\,024\\cdot \\frac{1}{4}{u}^{4}\\,{|}_{1}^{\\sqrt{2}/2} \\\\  & =-256(\\left(\\frac{\\sqrt{2}}{2}\\right)^{4}-{1}^{4}) \\\\  & =-256\\left(-\\frac{3}{4}\\right) \\\\  & =192\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =4\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =4\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=4\\operatorname{cos}⁡\\theta $ and $y=4\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)={x}^{3}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(4\\operatorname{cos}⁡\\theta )^{3}4\\operatorname{sin}⁡\\theta  \\\\  & =256{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(4)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{4}^{2}+{0}^{2}} \\\\  & =4.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}y\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}256{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 4\\cdot \\text{d}\\theta  \\\\  & =1\\,024{\\int }_{0}^{\\pi /4}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡\\theta ,$ $\\text{d}u=-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}1\\,024{\\int }_{0}^{\\pi /4}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =-1\\,024{\\int }_{1}^{\\sqrt{2}/2}{u}^{3}\\,\\text{d}u \\\\  & =-1\\,024\\cdot \\frac{1}{4}{u}^{4}\\,{|}_{1}^{\\sqrt{2}/2} \\\\  & =-256\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)^{4}-{1}^{4}\\right) \\\\  & =-256\\left(-\\frac{3}{4}\\right) \\\\  & =192\\end{aligned}\n$$"] [:db/cas 17592186364455 :answer/value "t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})" "t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)"] [:db/cas 17592186364634 :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{-1}^{1}(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}({t}^{2}+1)^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}({t}^{4}+2{t}^{2}+1)\\,\\text{d}t \\\\  & ={(\\frac{{t}^{5}}{5}+\\frac{2{t}^{3}}{3}+t)|}_{-1}^{1} \\\\  & =(\\frac{1}{5}+\\frac{2}{3}+1)-(-\\frac{1}{5}-\\frac{2}{3}-1) \\\\  & =\\frac{2}{5}+\\frac{4}{3}+2 \\\\  & =\\frac{56}{15}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n‖f(t)‖=\\sqrt{\\frac{56}{15}}=2\\sqrt{\\frac{14}{15}}.\n$$" "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{-1}^{1}(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}({t}^{2}+1)^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}({t}^{4}+2{t}^{2}+1)\\,\\text{d}t \\\\  & ={\\left(\\frac{{t}^{5}}{5}+\\frac{2{t}^{3}}{3}+t\\right)|}_{-1}^{1} \\\\  & =\\left(\\frac{1}{5}+\\frac{2}{3}+1\\right)-\\left(-\\frac{1}{5}-\\frac{2}{3}-1\\right) \\\\  & =\\frac{2}{5}+\\frac{4}{3}+2 \\\\  & =\\frac{56}{15}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n‖f(t)‖=\\sqrt{\\frac{56}{15}}=2\\sqrt{\\frac{14}{15}}.\n$$"] [:db/cas 17592186364749 :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y-3})=\\frac{1}{2\\sqrt{y-3}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}=\\frac{1}{4(y-3)}.\n$$\n\nThen, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{3}^{15/4}\\sqrt{y-3}\\cdot \\sqrt{1+\\frac{1}{4(y-3)}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{3}^{15/4}\\sqrt{y-3}\\cdot \\sqrt{\\frac{4y-11}{4(y-3)}}\\,\\text{d}y \\\\  & =\\pi {\\int }_{3}^{15/4}\\sqrt{4y-11}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=4y-11.$ Then, $\\text{d}y=\\frac{1}{4}\\text{d}u.$\n\nWe also need to compute new limits:\n\n| **$y$** | $3$ | $\\frac{15}{4}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =\\pi {\\int }_{3}^{15/4}\\sqrt{4y-11}\\,\\text{d}y \\\\  & =\\frac{\\pi }{4}{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{\\pi }{4}\\cdot {[\\frac{2}{3}\\sqrt{{u}^{3}}]}_{1}^{4} \\\\  & =\\frac{\\pi }{6}(\\sqrt{{4}^{3}}-\\sqrt{{1}^{3}}) \\\\  & =\\frac{\\pi }{6}(8-1) \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$" "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y-3})=\\frac{1}{2\\sqrt{y-3}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}=\\frac{1}{4(y-3)}.\n$$\n\nThen, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{3}^{15/4}\\sqrt{y-3}\\cdot \\sqrt{1+\\frac{1}{4(y-3)}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{3}^{15/4}\\sqrt{y-3}\\cdot \\sqrt{\\frac{4y-11}{4(y-3)}}\\,\\text{d}y \\\\  & =\\pi {\\int }_{3}^{15/4}\\sqrt{4y-11}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=4y-11.$ Then, $\\text{d}y=\\frac{1}{4}\\text{d}u.$\n\nWe also need to compute new limits:\n\n| **$y$** | $3$ | $\\frac{15}{4}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =\\pi {\\int }_{3}^{15/4}\\sqrt{4y-11}\\,\\text{d}y \\\\  & =\\frac{\\pi }{4}{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{\\pi }{4}\\cdot {\\left[\\frac{2}{3}\\sqrt{{u}^{3}}\\right]}_{1}^{4} \\\\  & =\\frac{\\pi }{6}(\\sqrt{{4}^{3}}-\\sqrt{{1}^{3}}) \\\\  & =\\frac{\\pi }{6}(8-1) \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$"] [:db/cas 17592186364763 :question/worked-solution "First, we make the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =y \\\\ {x}_{2}(t) & ={y}^{′}.\\end{aligned}\n$$\n\nWe also convert the initial conditions, as follows:\n\n$$\n\\begin{aligned}y(1) & ={x}_{1}(1)=1 \\\\ {y}^{′}(1) & ={x}_{2}(1)=-2\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′}(t) & ={y}^{′} \\\\ {x}_{2}^{′}(t) & ={y}^{″}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′} &={x}_{2}, \\\\ {x}_{2}^{′} &={y}^{″}.\\end{aligned}\\right.\n$$\n\nAt this point, we're almost done. We just need to write the right-hand side of the last equation in terms of ${x}_{1}$ and ${x}_{2}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{″}),$ we obtain\n\n$$\n{y}^{″}=-\\frac{5}{12}{y}^{′}+\\frac{1}{6}y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{″}=-\\frac{5}{12}{x}_{2}+\\frac{1}{6}{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′} &={x}_{2},\\, && {x}_{1}(1)=1 \\\\ {x}_{2}^{′} &=\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2},\\, && {x}_{2}(1)=-2\\end{aligned}\\right.\n$$\n\nFinally, $$\n\\displaystyle p=1,q=-2,f(t)=\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2},\n$$ and \n\n$$\n\\begin{aligned}(p-q)\\cdot f(t) & =(1-(-2))(\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2}) \\\\  & =3(\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2}) \\\\  & =\\frac{1}{2}{x}_{1}-\\frac{5}{4}{x}_{2}.\\end{aligned}\n$$" "First, we make the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =y \\\\ {x}_{2}(t) & ={y}^{′}.\\end{aligned}\n$$\n\nWe also convert the initial conditions, as follows:\n\n$$\n\\begin{aligned}y(1) & ={x}_{1}(1)=1 \\\\ {y}^{′}(1) & ={x}_{2}(1)=-2\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′}(t) & ={y}^{′} \\\\ {x}_{2}^{′}(t) & ={y}^{″}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′} &={x}_{2}, \\\\ {x}_{2}^{′} &={y}^{″}.\\end{aligned}\\right.\n$$\n\nAt this point, we're almost done. We just need to write the right-hand side of the last equation in terms of ${x}_{1}$ and ${x}_{2}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{″}),$ we obtain\n\n$$\n{y}^{″}=-\\frac{5}{12}{y}^{′}+\\frac{1}{6}y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{″}=-\\frac{5}{12}{x}_{2}+\\frac{1}{6}{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′} &={x}_{2},\\, && {x}_{1}(1)=1 \\\\ {x}_{2}^{′} &=\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2},\\, && {x}_{2}(1)=-2\\end{aligned}\\right.\n$$\n\nFinally, $$\n\\displaystyle p=1,q=-2,f(t)=\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2},\n$$ and \n\n$$\n\\begin{aligned}(p-q)\\cdot f(t) & =(1-(-2))\\left(\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2}\\right) \\\\  & =3\\left(\\frac{1}{6}{x}_{1}-\\frac{5}{12}{x}_{2}\\right) \\\\  & =\\frac{1}{2}{x}_{1}-\\frac{5}{4}{x}_{2}.\\end{aligned}\n$$"] [:db/cas 17592186364852 :question/problem "The domain of the function $f(x)=\\frac{4x+3}{5x+2k}$ is $$\n\\displaystyle (-\\infty ,\\frac{2}{5})\\cup (\\frac{2}{5},\\infty ).\n$$ What is the value of $k?$" "The domain of the function $f(x)=\\frac{4x+3}{5x+2k}$ is $$\n\\displaystyle \\left(-\\infty ,\\frac{2}{5}\\right)\\cup \\left(\\frac{2}{5},\\infty \\right).\n$$ What is the value of $k?$"] [:db/cas 17592186364927 :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{1-2y}) \\\\  & =\\frac{-2}{2\\sqrt{1-2y}} \\\\  & =-\\frac{1}{\\sqrt{1-2y}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}=\\frac{1}{1-2y}.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-3}^{0}\\sqrt{1-2y}\\sqrt{1+\\frac{1}{1-2y}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-3}^{0}\\sqrt{1-2y}\\sqrt{\\frac{2-2y}{1-2y}}\\,\\text{d}y \\\\  & =2\\sqrt{2}\\pi {\\int }_{-3}^{0}\\sqrt{1-y}\\,\\text{d}y \\\\  & =2\\sqrt{2}\\pi {[-\\frac{2}{3}(1-y)^{3/2}]}_{-3}^{0} \\\\  & =2\\sqrt{2}\\pi (-\\frac{2}{3}+\\frac{16}{3}) \\\\  & =\\frac{28\\sqrt{2}\\,\\pi }{3}.\\end{aligned}\n$$" "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{1-2y}) \\\\  & =\\frac{-2}{2\\sqrt{1-2y}} \\\\  & =-\\frac{1}{\\sqrt{1-2y}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}=\\frac{1}{1-2y}.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-3}^{0}\\sqrt{1-2y}\\sqrt{1+\\frac{1}{1-2y}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-3}^{0}\\sqrt{1-2y}\\sqrt{\\frac{2-2y}{1-2y}}\\,\\text{d}y \\\\  & =2\\sqrt{2}\\pi {\\int }_{-3}^{0}\\sqrt{1-y}\\,\\text{d}y \\\\  & =2\\sqrt{2}\\pi {\\left[-\\frac{2}{3}(1-y)^{3/2}\\right]}_{-3}^{0} \\\\  & =2\\sqrt{2}\\pi \\left(-\\frac{2}{3}+\\frac{16}{3}\\right) \\\\  & =\\frac{28\\sqrt{2}\\,\\pi }{3}.\\end{aligned}\n$$"] [:db/cas 17592186364934 :question/worked-solution "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find the value of $t$ that corresponds to the point $P(16,12,16)$ on the given curve. We know that\n\n$$\n\\begin{aligned}r(t) & =⟨16,12,16⟩ \\\\ ⟨8t,\\,3{t}^{2},\\,2{t}^{3}⟩ & =⟨16,12,16⟩.\\end{aligned}\n$$\n\nEquating the respective components gives the system\n\n$$\n\\left\\{\\begin{aligned}8t &=16 \\\\ 3{t}^{2} &=12 \\\\ 2{t}^{3} &=16.\\end{aligned}\\right.\n$$\n\nFrom the first equality, $t=2.$ This value also satisfies the other two equations. Therefore, $P(16,12,16)$ is at the tip of $r(2).$ \n\nNow, we calculate ${r}^{′}(t)$ and evaluate it at $t=2:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(8t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨8,\\,6t,\\,6{t}^{2}⟩ \\\\ {r}^{′}(2) & =⟨8,\\,6(2),\\,6(2)^{2}⟩ \\\\  & =⟨8,12,24⟩ \\\\  & =4⟨2,3,6⟩\\end{aligned}\n$$\n\nNext, we calculate the magnitude of ${r}^{′}(2):$\n\n$$\n\\begin{aligned}‖{r}^{′}(2)‖ & =4\\sqrt{{2}^{2}+{3}^{2}+{6}^{2}} \\\\  & =4\\sqrt{4+9+36} \\\\  & =4\\sqrt{49} \\\\  & =28\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(2)$ and obtain the unit tangent vector to the given curve at $P(16,12,16):$\n\n$$\n\\begin{aligned}T(2) & =\\frac{{r}^{′}(2)}{‖{r}^{′}(2)‖} \\\\  & =\\frac{1}{28}\\cdot 4⟨2,3,6⟩ \\\\  & =⟨\\frac{2}{7},\\frac{3}{7},\\frac{6}{7}⟩\\end{aligned}\n$$" "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find the value of $t$ that corresponds to the point $P(16,12,16)$ on the given curve. We know that\n\n$$\n\\begin{aligned}r(t) & =⟨16,12,16⟩ \\\\ ⟨8t,\\,3{t}^{2},\\,2{t}^{3}⟩ & =⟨16,12,16⟩.\\end{aligned}\n$$\n\nEquating the respective components gives the system\n\n$$\n\\left\\{\\begin{aligned}8t &=16 \\\\ 3{t}^{2} &=12 \\\\ 2{t}^{3} &=16.\\end{aligned}\\right.\n$$\n\nFrom the first equality, $t=2.$ This value also satisfies the other two equations. Therefore, $P(16,12,16)$ is at the tip of $r(2).$ \n\nNow, we calculate ${r}^{′}(t)$ and evaluate it at $t=2:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(8t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})\\right\\rangle  \\\\  & =⟨8,\\,6t,\\,6{t}^{2}⟩ \\\\ {r}^{′}(2) & =⟨8,\\,6(2),\\,6(2)^{2}⟩ \\\\  & =⟨8,12,24⟩ \\\\  & =4⟨2,3,6⟩\\end{aligned}\n$$\n\nNext, we calculate the magnitude of ${r}^{′}(2):$\n\n$$\n\\begin{aligned}‖{r}^{′}(2)‖ & =4\\sqrt{{2}^{2}+{3}^{2}+{6}^{2}} \\\\  & =4\\sqrt{4+9+36} \\\\  & =4\\sqrt{49} \\\\  & =28\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(2)$ and obtain the unit tangent vector to the given curve at $P(16,12,16):$\n\n$$\n\\begin{aligned}T(2) & =\\frac{{r}^{′}(2)}{‖{r}^{′}(2)‖} \\\\  & =\\frac{1}{28}\\cdot 4⟨2,3,6⟩ \\\\  & =\\left\\langle \\frac{2}{7},\\frac{3}{7},\\frac{6}{7}\\right\\rangle \\end{aligned}\n$$"] [:db/cas 17592186364936 :answer/value "⟨1,\\frac{2}{7},-2⟩" "\\left\\langle 1,\\frac{2}{7},-2\\right\\rangle "] [:db/cas 17592186364937 :answer/value "⟨\\frac{1}{7},\\frac{3}{7},2⟩" "\\left\\langle \\frac{1}{7},\\frac{3}{7},2\\right\\rangle "] [:db/cas 17592186364938 :answer/value "⟨\\frac{3}{7},\\frac{6}{7},-\\frac{2}{7}⟩" "\\left\\langle \\frac{3}{7},\\frac{6}{7},-\\frac{2}{7}\\right\\rangle "] [:db/cas 17592186364939 :answer/value "⟨-1,1,\\frac{6}{7}⟩" "\\left\\langle -1,1,\\frac{6}{7}\\right\\rangle "] [:db/cas 17592186364940 :answer/value "⟨\\frac{2}{7},\\frac{3}{7},\\frac{6}{7}⟩" "\\left\\langle \\frac{2}{7},\\frac{3}{7},\\frac{6}{7}\\right\\rangle "] [:db/cas 17592186364941 :question/worked-solution "For a curve $r(t)=x(t)i+y(t)j+z(t)k$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=0:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{t}^{2}+1}\\,p(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{{t}^{2}+1}\\right)\\cdot p(t)+\\frac{1}{{t}^{2}+1}\\cdot \\frac{\\text{d}}{\\text{d}t}(p(t)) \\\\  & =-\\frac{2t}{{({t}^{2}+1)}^{2}}\\,p(t)+\\frac{1}{{t}^{2}+1}\\,{p}^{′}(t) \\\\ {r}^{′}(0) & =-\\frac{2(0)}{{({0}^{2}+1)}^{2}}\\,p(0)+\\frac{1}{{0}^{2}+1}\\,{p}^{′}(0) \\\\  & =0(2\\,i+j-k)+(\\,i-2\\,j-2k) \\\\  & =\\,i-2\\,j-2k\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}(0):$  \n\n$$\n\\begin{aligned}‖r(0)‖ & =\\sqrt{(1)^{2}+(-2)^{2}+(-2)^{2}} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(0):$  \n\n$$\n\\begin{aligned}T(0) & =\\frac{{r}^{′}(0)}{‖{r}^{′}(0)‖} \\\\  & =\\frac{1}{3}\\cdot (i-2\\,j-2\\,k) \\\\  & =\\frac{1}{3}\\,i-\\frac{2}{3}\\,j-\\frac{2}{3}\\,k\\end{aligned}\n$$\n\nTherefore, the unit tangent vector to the curve at the point that corresponds to $t=0$ is  $$\n\\displaystyle T(0)=\\frac{1}{3}\\,i-\\frac{2}{3}\\,j-\\frac{2}{3}\\,k.\n$$" "For a curve $r(t)=x(t)i+y(t)j+z(t)k$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=0:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{{t}^{2}+1}\\,p(t)\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{{t}^{2}+1}\\right)\\cdot p(t)+\\frac{1}{{t}^{2}+1}\\cdot \\frac{\\text{d}}{\\text{d}t}(p(t)) \\\\  & =-\\frac{2t}{{({t}^{2}+1)}^{2}}\\,p(t)+\\frac{1}{{t}^{2}+1}\\,{p}^{′}(t) \\\\ {r}^{′}(0) & =-\\frac{2(0)}{{({0}^{2}+1)}^{2}}\\,p(0)+\\frac{1}{{0}^{2}+1}\\,{p}^{′}(0) \\\\  & =0(2\\,i+j-k)+(\\,i-2\\,j-2k) \\\\  & =\\,i-2\\,j-2k\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}(0):$  \n\n$$\n\\begin{aligned}‖r(0)‖ & =\\sqrt{(1)^{2}+(-2)^{2}+(-2)^{2}} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(0):$  \n\n$$\n\\begin{aligned}T(0) & =\\frac{{r}^{′}(0)}{‖{r}^{′}(0)‖} \\\\  & =\\frac{1}{3}\\cdot (i-2\\,j-2\\,k) \\\\  & =\\frac{1}{3}\\,i-\\frac{2}{3}\\,j-\\frac{2}{3}\\,k\\end{aligned}\n$$\n\nTherefore, the unit tangent vector to the curve at the point that corresponds to $t=0$ is  $$\n\\displaystyle T(0)=\\frac{1}{3}\\,i-\\frac{2}{3}\\,j-\\frac{2}{3}\\,k.\n$$"] [:db/cas 17592186365213 :question/worked-solution "We must find the maximum value of $f(x,y)$ subject to the constraint $g(x,y)=2{x}^{2}+{y}^{2}-2y=0.$ \n\nSince $f(x,y)$ is continuous and the constraint is closed and bounded, $f(x,y)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y)=\\lambda ∇g(x,y),\\,g(x,y)=0\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨-2x,-6y⟩ & =\\lambda ⟨4x,2y-2⟩\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}-2x &=4\\lambda x \\\\ -6y &=2\\lambda (y-1)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x(1+2\\lambda ) &=0 \\\\ y(\\lambda +3) &=\\lambda\\end{aligned}\\right.\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation of the system, the constraint condition $2{x}^{2}+{y}^{2}-2y=0$ implies\n\n$$\n\\begin{aligned}{y}^{2}-2y & =0\\,⇒\\,y=0,2.\\end{aligned}\n$$\n\nThis gives the critical points $(0,0),(0,2).$\n\n- Assuming $\\lambda =-\\frac{1}{2}$ in the first equation of the system, the second equation of the system implies\n\n$$\n\\begin{aligned}y(-\\frac{1}{2}+3)=-\\frac{1}{2}\\,⇒\\,y=-\\frac{1}{5}.\\end{aligned}\n$$\n\nThen, the constraint condition $2{x}^{2}+{y}^{2}-2y=0$ implies\n\n$$\n\\begin{aligned}2{x}^{2}=-\\frac{11}{25}.\\end{aligned}\n$$\n\nwhich gives a contradiction.\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(0,0),\\,(0,2).\n$$\n\nWe evaluate $f$ at these points. These are given in the following table:\n\n| $(x,y)$ | $(0,0)$ | $(0,2)$ |\n| --- | --- | --- |\n| $f(x,y)$ | $1$ | $-11$ |\n\nTherefore, the function reaches a maximum value at the point $(0,0)$ and its maximum value is $1.$" "We must find the maximum value of $f(x,y)$ subject to the constraint $g(x,y)=2{x}^{2}+{y}^{2}-2y=0.$ \n\nSince $f(x,y)$ is continuous and the constraint is closed and bounded, $f(x,y)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y)=\\lambda ∇g(x,y),\\,g(x,y)=0\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨-2x,-6y⟩ & =\\lambda ⟨4x,2y-2⟩\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}-2x &=4\\lambda x \\\\ -6y &=2\\lambda (y-1)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x(1+2\\lambda ) &=0 \\\\ y(\\lambda +3) &=\\lambda\\end{aligned}\\right.\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation of the system, the constraint condition $2{x}^{2}+{y}^{2}-2y=0$ implies\n\n$$\n\\begin{aligned}{y}^{2}-2y & =0\\,⇒\\,y=0,2.\\end{aligned}\n$$\n\nThis gives the critical points $(0,0),(0,2).$\n\n- Assuming $\\lambda =-\\frac{1}{2}$ in the first equation of the system, the second equation of the system implies\n\n$$\n\\begin{aligned}y\\left(-\\frac{1}{2}+3\\right)=-\\frac{1}{2}\\,⇒\\,y=-\\frac{1}{5}.\\end{aligned}\n$$\n\nThen, the constraint condition $2{x}^{2}+{y}^{2}-2y=0$ implies\n\n$$\n\\begin{aligned}2{x}^{2}=-\\frac{11}{25}.\\end{aligned}\n$$\n\nwhich gives a contradiction.\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(0,0),\\,(0,2).\n$$\n\nWe evaluate $f$ at these points. These are given in the following table:\n\n| $(x,y)$ | $(0,0)$ | $(0,2)$ |\n| --- | --- | --- |\n| $f(x,y)$ | $1$ | $-11$ |\n\nTherefore, the function reaches a maximum value at the point $(0,0)$ and its maximum value is $1.$"] [:db/cas 17592186365226 :question/worked-solution "We need to find the maximum value of $f$ subject to the constraint $g(x,y,z)={x}^{2}+{z}^{2}-y=0.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y,z)=\\lambda ∇g(x,y,z),\\,g(x,y,z)=0\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z) \\\\ ⟨{f}_{x}(x,y,z),{f}_{y}(x,y,z),{f}_{z}(x,y,z)⟩ & =\\lambda ⟨{g}_{x}(x,y,z),{g}_{y}(x,y,z),{g}_{z}(x,y,z)⟩ \\\\ ⟨-2x,-2y,2z⟩ & =\\lambda ⟨2x,-1,2z⟩\\end{aligned}\n$$\n\nWe start by solving the first equation:\n\n$$\n\\left\\{\\begin{aligned}-2x &=2\\lambda x \\\\ -2y &=-\\lambda \\\\ 2z &=2\\lambda z\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}(1+\\lambda )x &=0 \\\\ y &=\\frac{\\lambda }{2} \\\\ (1-\\lambda )z &=0\\end{aligned}\\right.\n$$\n\nTo solve this system, we break it up into several cases:\n\n- First, assume that $\\lambda \\ne \\pm 1.$ Then, by the first and third equations, we must have $x=z=0.$ Also, by the constraint $g(x,y,z)=0,$ we have\n\n$$\ny={0}^{2}+{0}^{2}\\,⇒\\,y=0.\n$$\n\nThis gives the critical point $(0,0,0).$\n\n- Next, assume that $\\lambda =-1.$ Then, by the second and third equations, we must have $y=-\\frac{1}{2}$ and $z=0,$ but this contradicts the constraint $g(x,y,z)=0.$\n\n- Finally, assume that $\\lambda =1.$ Then, by the first and second equations, we must have $x=0$ and $y=\\frac{1}{2}.$ Also, by the constraint $g(x,y,z)=0,$ we have\n\n$$\n\\frac{1}{2}={0}^{2}+{z}^{2}\\,⇒\\,z=\\pm \\frac{1}{\\sqrt{2}}.\n$$\n\nThis gives the critical points $(0,\\frac{1}{2},\\pm \\frac{1}{\\sqrt{2}}).$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $\\,(x,y,z)\\,$ | $\\,(0,0,0)\\,$ | $$\n\\displaystyle \\,(0,\\frac{1}{2},\\pm \\frac{1}{\\sqrt{2}})\\,\n$$ |\n| --- | --- | --- |\n| $\\,f(x,y,z)\\,$ | $\\,0\\,$ | $\\,\\frac{1}{4}\\,$ |\n\n$$\n\n$$\n\nTherefore, the function reaches a maximum value at the points $(0,\\frac{1}{2},\\pm \\frac{1}{\\sqrt{2}}),$ and its maximum value is $\\frac{1}{4}.$" "We need to find the maximum value of $f$ subject to the constraint $g(x,y,z)={x}^{2}+{z}^{2}-y=0.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y,z)=\\lambda ∇g(x,y,z),\\,g(x,y,z)=0\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z) \\\\ ⟨{f}_{x}(x,y,z),{f}_{y}(x,y,z),{f}_{z}(x,y,z)⟩ & =\\lambda ⟨{g}_{x}(x,y,z),{g}_{y}(x,y,z),{g}_{z}(x,y,z)⟩ \\\\ ⟨-2x,-2y,2z⟩ & =\\lambda ⟨2x,-1,2z⟩\\end{aligned}\n$$\n\nWe start by solving the first equation:\n\n$$\n\\left\\{\\begin{aligned}-2x &=2\\lambda x \\\\ -2y &=-\\lambda \\\\ 2z &=2\\lambda z\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}(1+\\lambda )x &=0 \\\\ y &=\\frac{\\lambda }{2} \\\\ (1-\\lambda )z &=0\\end{aligned}\\right.\n$$\n\nTo solve this system, we break it up into several cases:\n\n- First, assume that $\\lambda \\ne \\pm 1.$ Then, by the first and third equations, we must have $x=z=0.$ Also, by the constraint $g(x,y,z)=0,$ we have\n\n$$\ny={0}^{2}+{0}^{2}\\,⇒\\,y=0.\n$$\n\nThis gives the critical point $(0,0,0).$\n\n- Next, assume that $\\lambda =-1.$ Then, by the second and third equations, we must have $y=-\\frac{1}{2}$ and $z=0,$ but this contradicts the constraint $g(x,y,z)=0.$\n\n- Finally, assume that $\\lambda =1.$ Then, by the first and second equations, we must have $x=0$ and $y=\\frac{1}{2}.$ Also, by the constraint $g(x,y,z)=0,$ we have\n\n$$\n\\frac{1}{2}={0}^{2}+{z}^{2}\\,⇒\\,z=\\pm \\frac{1}{\\sqrt{2}}.\n$$\n\nThis gives the critical points $\\left(0,\\frac{1}{2},\\pm \\frac{1}{\\sqrt{2}}\\right).$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $\\,(x,y,z)\\,$ | $\\,(0,0,0)\\,$ | $$\n\\displaystyle \\,\\left(0,\\frac{1}{2},\\pm \\frac{1}{\\sqrt{2}}\\right)\\,\n$$ |\n| --- | --- | --- |\n| $\\,f(x,y,z)\\,$ | $\\,0\\,$ | $\\,\\frac{1}{4}\\,$ |\n\n$$\n\n$$\n\nTherefore, the function reaches a maximum value at the points $\\left(0,\\frac{1}{2},\\pm \\frac{1}{\\sqrt{2}}\\right),$ and its maximum value is $\\frac{1}{4}.$"] [:db/cas 17592186365246 :question/worked-solution "![](images/cd/cd42eb74e5bba02951118c349a1b25f7193c39aa53f6504403918dfa984eb2c2.png)\n\nSince the acceleration of the particle $P$ has magnitude $kx\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-kx.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-kx.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-kx)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-\\frac{k}{2}{x}^{2}+C.\n$$\n\nNow, since $v=20\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-\\frac{k}{2}{x}^{2}+C \\\\ \\frac{1}{2}(20)^{2} & =-\\frac{k}{2}(0)^{3}+C \\\\ C & =200\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=200-\\frac{k}{2}{x}^{2}.\n$$\n\nFinally, since $v=0\\,m/s$ when $x=10\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =200-\\frac{k}{2}{x}^{2} \\\\ \\frac{1}{2}(0)^{2} & =200-\\frac{k}{2}(10)^{2} \\\\ 50k & =200 \\\\ k & =4.\\end{aligned}\n$$" "![](images/cd/cd42eb74e5bba02951118c349a1b25f7193c39aa53f6504403918dfa984eb2c2.png)\n\nSince the acceleration of the particle $P$ has magnitude $kx\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-kx.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-kx.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (-kx)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-\\frac{k}{2}{x}^{2}+C.\n$$\n\nNow, since $v=20\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-\\frac{k}{2}{x}^{2}+C \\\\ \\frac{1}{2}(20)^{2} & =-\\frac{k}{2}(0)^{3}+C \\\\ C & =200\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=200-\\frac{k}{2}{x}^{2}.\n$$\n\nFinally, since $v=0\\,m/s$ when $x=10\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =200-\\frac{k}{2}{x}^{2} \\\\ \\frac{1}{2}(0)^{2} & =200-\\frac{k}{2}(10)^{2} \\\\ 50k & =200 \\\\ k & =4.\\end{aligned}\n$$"] [:db/cas 17592186365253 :question/worked-solution "![](images/d4/d4e5b78932f8ff6155ac81e12538eb31ac211c9d27d6a2b0c67542527ccd3b2a.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(4-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4-x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}4-x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=4-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (4-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=4x-\\frac{1}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =4(0)-\\frac{1}{2}(0)^{2}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+18 \\\\ {v}^{2} & =8x-{x}^{2}+36 \\\\ v & =\\pm \\sqrt{-{x}^{2}+8x+36}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+8x+36}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-(4)^{2}+8(4)+36}=2\\sqrt{13}\\,m/s\n$$" "![](images/d4/d4e5b78932f8ff6155ac81e12538eb31ac211c9d27d6a2b0c67542527ccd3b2a.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(4-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4-x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}4-x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=4-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (4-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=4x-\\frac{1}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =4(0)-\\frac{1}{2}(0)^{2}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+18 \\\\ {v}^{2} & =8x-{x}^{2}+36 \\\\ v & =\\pm \\sqrt{-{x}^{2}+8x+36}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+8x+36}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-(4)^{2}+8(4)+36}=2\\sqrt{13}\\,m/s\n$$"] [:db/cas 17592186365260 :question/worked-solution "![](images/33/33b95a6985a53b76eb7f74771825c18f21d1e59b2245325e14690a365a2a8bb0.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(10-2x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=10-2x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}10-2x & =0 \\\\ x & =5.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=5\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,5)$ | $5$ | $(5,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $4$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=5\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=10-2x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (10-2x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=10x-{x}^{2}+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =10x-{x}^{2}+C \\\\ \\frac{1}{2}(2)^{2} & =10(0)-(0)^{2}+C \\\\ C & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =10x-{x}^{2}+2 \\\\ {v}^{2} & =20x-2{x}^{2}+4 \\\\ v & =\\pm \\sqrt{-2{x}^{2}+20x+4}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-2{x}^{2}+20x+4}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(5)=\\sqrt{-2(5)^{2}+20(5)+4}=3\\sqrt{6}\\,m/s\n$$" "![](images/33/33b95a6985a53b76eb7f74771825c18f21d1e59b2245325e14690a365a2a8bb0.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(10-2x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=10-2x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}10-2x & =0 \\\\ x & =5.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=5\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,5)$ | $5$ | $(5,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $4$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=5\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=10-2x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (10-2x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=10x-{x}^{2}+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =10x-{x}^{2}+C \\\\ \\frac{1}{2}(2)^{2} & =10(0)-(0)^{2}+C \\\\ C & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =10x-{x}^{2}+2 \\\\ {v}^{2} & =20x-2{x}^{2}+4 \\\\ v & =\\pm \\sqrt{-2{x}^{2}+20x+4}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-2{x}^{2}+20x+4}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(5)=\\sqrt{-2(5)^{2}+20(5)+4}=3\\sqrt{6}\\,m/s\n$$"] [:db/cas 17592186365267 :question/worked-solution "![](images/cd/cd42eb74e5bba02951118c349a1b25f7193c39aa53f6504403918dfa984eb2c2.png)\n\nSince the acceleration of the particle $P$ has magnitude $kx\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-kx.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-kx.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-kx)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-\\frac{k}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-\\frac{k}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =-\\frac{k}{2}(0)^{3}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=18-\\frac{k}{2}{x}^{2}.\n$$\n\nFinally, since $v=0\\,m/s$ when $x=3\\sqrt{2}\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =18-\\frac{k}{2}{x}^{2} \\\\ \\frac{1}{2}(0)^{2} & =18-\\frac{k}{2}(3\\sqrt{2})^{2} \\\\ 18-9k & =0 \\\\ 9k & =18 \\\\ k & =2.\\end{aligned}\n$$" "![](images/cd/cd42eb74e5bba02951118c349a1b25f7193c39aa53f6504403918dfa984eb2c2.png)\n\nSince the acceleration of the particle $P$ has magnitude $kx\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-kx.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-kx.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (-kx)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-\\frac{k}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-\\frac{k}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =-\\frac{k}{2}(0)^{3}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=18-\\frac{k}{2}{x}^{2}.\n$$\n\nFinally, since $v=0\\,m/s$ when $x=3\\sqrt{2}\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =18-\\frac{k}{2}{x}^{2} \\\\ \\frac{1}{2}(0)^{2} & =18-\\frac{k}{2}(3\\sqrt{2})^{2} \\\\ 18-9k & =0 \\\\ 9k & =18 \\\\ k & =2.\\end{aligned}\n$$"] [:db/cas 17592186365274 :question/worked-solution "![](images/b3/b396b80995e34fe348b3d059737b1eec3d4ce5a9d2e9138a8e7d4ed5c0945dc0.png)\n\nSince the acceleration of the particle $P$ is $k\\operatorname{sin}⁡x\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k\\operatorname{sin}⁡x.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k\\operatorname{sin}⁡x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int k\\operatorname{sin}⁡x\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-k\\operatorname{cos}⁡x+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=\\frac{\\pi }{2}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-k\\operatorname{cos}⁡x+C \\\\ \\frac{1}{2}(4)^{2} & =-k\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=8-k\\operatorname{cos}⁡x.\n$$\n\nFinally, since $v=8\\,m/s$ when $x=\\pi \\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =8-k\\operatorname{cos}⁡x \\\\ \\frac{1}{2}(8)^{2} & =8-k\\operatorname{cos}⁡\\pi  \\\\ 32 & =8+k \\\\ k & =24.\\end{aligned}\n$$" "![](images/b3/b396b80995e34fe348b3d059737b1eec3d4ce5a9d2e9138a8e7d4ed5c0945dc0.png)\n\nSince the acceleration of the particle $P$ is $k\\operatorname{sin}⁡x\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k\\operatorname{sin}⁡x.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=k\\operatorname{sin}⁡x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int k\\operatorname{sin}⁡x\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-k\\operatorname{cos}⁡x+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=\\frac{\\pi }{2}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-k\\operatorname{cos}⁡x+C \\\\ \\frac{1}{2}(4)^{2} & =-k\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=8-k\\operatorname{cos}⁡x.\n$$\n\nFinally, since $v=8\\,m/s$ when $x=\\pi \\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =8-k\\operatorname{cos}⁡x \\\\ \\frac{1}{2}(8)^{2} & =8-k\\operatorname{cos}⁡\\pi  \\\\ 32 & =8+k \\\\ k & =24.\\end{aligned}\n$$"] [:db/cas 17592186365281 :question/worked-solution "![](images/dd/dd8eecba814fda9c628dc4c8a3853805a31e57f953dd9bf26a6fa79f5c700788.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(6-3x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=6-3x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}6-3x & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=2\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,2)$ | $2$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $1$ |  | $3$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $3>0$ | $0$ | $-3<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=2\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=6-3x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (6-3x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=6x-\\frac{3}{2}{x}^{2}+C.\n$$\n\nNow, since $v=\\sqrt{2}\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-\\frac{3}{2}{x}^{2}+C \\\\ \\frac{1}{2}(\\sqrt{2})^{2} & =6(0)-\\frac{3}{2}(0)^{2}+C \\\\ C & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-\\frac{3}{2}{x}^{2}+1 \\\\ {v}^{2} & =12x-3{x}^{2}+2 \\\\ v & =\\pm \\sqrt{-3{x}^{2}+12x+2}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-3{x}^{2}+12x+2}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(2)=\\sqrt{-3(2)^{2}+12(2)+2}=\\sqrt{14}\\,m/s\n$$" "![](images/dd/dd8eecba814fda9c628dc4c8a3853805a31e57f953dd9bf26a6fa79f5c700788.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(6-3x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=6-3x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}6-3x & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=2\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,2)$ | $2$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $1$ |  | $3$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $3>0$ | $0$ | $-3<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=2\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=6-3x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (6-3x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=6x-\\frac{3}{2}{x}^{2}+C.\n$$\n\nNow, since $v=\\sqrt{2}\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-\\frac{3}{2}{x}^{2}+C \\\\ \\frac{1}{2}(\\sqrt{2})^{2} & =6(0)-\\frac{3}{2}(0)^{2}+C \\\\ C & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-\\frac{3}{2}{x}^{2}+1 \\\\ {v}^{2} & =12x-3{x}^{2}+2 \\\\ v & =\\pm \\sqrt{-3{x}^{2}+12x+2}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-3{x}^{2}+12x+2}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(2)=\\sqrt{-3(2)^{2}+12(2)+2}=\\sqrt{14}\\,m/s\n$$"] [:db/cas 17592186365288 :question/worked-solution "![](images/61/61388466bb2d97b5080707e769ae862e633bfb0fe1d2b5f16c75daa14da76e53.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(6-6x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=6-6x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}6-6x & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=1\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $\\frac{1}{2}$ |  | $2$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $3>0$ | $0$ | $-6<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=1\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=6-6x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (6-6x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=6x-3{x}^{2}+C.\n$$\n\nNow, since $v=2\\sqrt{2}\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-3{x}^{2}+C \\\\ \\frac{1}{2}(2\\sqrt{2})^{2} & =6(0)-3(0)^{2}+C \\\\ C & =4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-3{x}^{2}+4 \\\\ {v}^{2} & =12x-6{x}^{2}+8 \\\\ v & =\\pm \\sqrt{-6{x}^{2}+12x+8}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-6{x}^{2}+12x+8}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(1)=\\sqrt{-6(1)^{2}+12(1)+8}=\\sqrt{14}\\,m/s\n$$" "![](images/61/61388466bb2d97b5080707e769ae862e633bfb0fe1d2b5f16c75daa14da76e53.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(6-6x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=6-6x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}6-6x & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=1\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $\\frac{1}{2}$ |  | $2$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $3>0$ | $0$ | $-6<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=1\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=6-6x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (6-6x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=6x-3{x}^{2}+C.\n$$\n\nNow, since $v=2\\sqrt{2}\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-3{x}^{2}+C \\\\ \\frac{1}{2}(2\\sqrt{2})^{2} & =6(0)-3(0)^{2}+C \\\\ C & =4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =6x-3{x}^{2}+4 \\\\ {v}^{2} & =12x-6{x}^{2}+8 \\\\ v & =\\pm \\sqrt{-6{x}^{2}+12x+8}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-6{x}^{2}+12x+8}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(1)=\\sqrt{-6(1)^{2}+12(1)+8}=\\sqrt{14}\\,m/s\n$$"] [:db/cas 17592186365295 :question/worked-solution "![](images/6f/6f34d18ec0aed1f28e77a143c5be0b3d4eaf44ba08649d02517c6c6ea5bc0af4.png)\n\nSince the acceleration of the particle $P$ is $(k-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k-x.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (k-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=kx-\\frac{{x}^{2}}{2}+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =kx-\\frac{{x}^{2}}{2}+C \\\\ \\frac{1}{2}(4)^{2} & =k(0)-\\frac{(0)^{2}}{2}+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=kx-\\frac{{x}^{2}}{2}+8.\n$$\n\nFinally, since $v=2\\sqrt{6}\\,m/s$ when $x=2\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =kx-\\frac{{x}^{2}}{2}+8 \\\\ \\frac{1}{2}(2\\sqrt{6})^{2} & =k(2)-\\frac{{2}^{2}}{2}+8 \\\\ 12 & =2k+6 \\\\ 2k & =6 \\\\ k & =3.\\end{aligned}\n$$" "![](images/6f/6f34d18ec0aed1f28e77a143c5be0b3d4eaf44ba08649d02517c6c6ea5bc0af4.png)\n\nSince the acceleration of the particle $P$ is $(k-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k-x.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=k-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (k-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=kx-\\frac{{x}^{2}}{2}+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =kx-\\frac{{x}^{2}}{2}+C \\\\ \\frac{1}{2}(4)^{2} & =k(0)-\\frac{(0)^{2}}{2}+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=kx-\\frac{{x}^{2}}{2}+8.\n$$\n\nFinally, since $v=2\\sqrt{6}\\,m/s$ when $x=2\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =kx-\\frac{{x}^{2}}{2}+8 \\\\ \\frac{1}{2}(2\\sqrt{6})^{2} & =k(2)-\\frac{{2}^{2}}{2}+8 \\\\ 12 & =2k+6 \\\\ 2k & =6 \\\\ k & =3.\\end{aligned}\n$$"] [:db/cas 17592186365302 :question/worked-solution "![](images/2d/2d768dd32288c71332e81b0f72aa2652c19a7c80fed6751abea5ced383e6848f.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(3-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(3-x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(3-x) & =0 \\\\ 3-x & =0 \\\\ x & =3.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=3\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,3)$ | $3$ | $(3,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $4$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $k>0$ | $0$ | $-k<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=3\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k(3-x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int k(3-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k(3x-\\frac{1}{2}{x}^{2})+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(3x-\\frac{1}{2}{x}^{2})+C \\\\ \\frac{1}{2}(4)^{2} & =k(3(0)-\\frac{1}{2}(0)^{2})+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k(3x-\\frac{1}{2}{x}^{2})+8.\n$$\n\nAlso, since $v=2\\sqrt{6}\\,m/s$ when $x=2\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(3x-\\frac{1}{2}{x}^{2})+8 \\\\ \\frac{1}{2}(2\\sqrt{6})^{2} & =k(3(2)-\\frac{1}{2}{(2)}^{2})+8 \\\\ 12 & =4k+8 \\\\ 4k & =4 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =1(3x-\\frac{1}{2}{x}^{2})+8 \\\\ {v}^{2} & =6x-{x}^{2}+16 \\\\ v & =\\pm \\sqrt{-{x}^{2}+6x+16}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+6x+16}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(3)=\\sqrt{-(3)^{2}+6(3)+16}=5\\,m/s\n$$" "![](images/2d/2d768dd32288c71332e81b0f72aa2652c19a7c80fed6751abea5ced383e6848f.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(3-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(3-x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(3-x) & =0 \\\\ 3-x & =0 \\\\ x & =3.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=3\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,3)$ | $3$ | $(3,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $4$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $k>0$ | $0$ | $-k<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=3\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=k(3-x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int k(3-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k\\left(3x-\\frac{1}{2}{x}^{2}\\right)+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k\\left(3x-\\frac{1}{2}{x}^{2}\\right)+C \\\\ \\frac{1}{2}(4)^{2} & =k\\left(3(0)-\\frac{1}{2}(0)^{2}\\right)+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k\\left(3x-\\frac{1}{2}{x}^{2}\\right)+8.\n$$\n\nAlso, since $v=2\\sqrt{6}\\,m/s$ when $x=2\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k\\left(3x-\\frac{1}{2}{x}^{2}\\right)+8 \\\\ \\frac{1}{2}(2\\sqrt{6})^{2} & =k\\left(3(2)-\\frac{1}{2}{(2)}^{2}\\right)+8 \\\\ 12 & =4k+8 \\\\ 4k & =4 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =1\\left(3x-\\frac{1}{2}{x}^{2}\\right)+8 \\\\ {v}^{2} & =6x-{x}^{2}+16 \\\\ v & =\\pm \\sqrt{-{x}^{2}+6x+16}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+6x+16}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(3)=\\sqrt{-(3)^{2}+6(3)+16}=5\\,m/s\n$$"] [:db/cas 17592186365309 :question/worked-solution "![](images/5a/5a1fa0d49dc7a35d176473d3554de6383fa042cc2c5daf7eb5abaad1d5b387cd.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(8-2x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(8-2x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(8-2x) & =0 \\\\ 8-2x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $3$ |  | $5$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2k>0$ | $0$ | $-2k<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k(8-2x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int k(8-2x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k(8x-{x}^{2})+C.\n$$\n\nNow, since $v=\\sqrt{6}\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(8x-{x}^{2})+C \\\\ \\frac{1}{2}(\\sqrt{6})^{2} & =k(8(0)-(0)^{2})+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k(8x-{x}^{2})+3.\n$$\n\nAlso, since $v=2\\sqrt{5}\\,m/s$ when $x=1\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(8x-{x}^{2})+3 \\\\ \\frac{1}{2}(2\\sqrt{5})^{2} & =k(8(1)-{(1)}^{2})+3 \\\\ 10 & =7k+3 \\\\ 7k & =7 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =1(8x-{x}^{2})+3 \\\\ {v}^{2} & =16x-2{x}^{2}+6 \\\\ v & =\\pm \\sqrt{-2{x}^{2}+16x+6}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-2{x}^{2}+16x+6}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-2(4)^{2}+16(4)+6}=\\sqrt{38}\\,m/s\n$$" "![](images/5a/5a1fa0d49dc7a35d176473d3554de6383fa042cc2c5daf7eb5abaad1d5b387cd.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(8-2x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(8-2x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(8-2x) & =0 \\\\ 8-2x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $3$ |  | $5$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2k>0$ | $0$ | $-2k<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=k(8-2x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int k(8-2x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k(8x-{x}^{2})+C.\n$$\n\nNow, since $v=\\sqrt{6}\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(8x-{x}^{2})+C \\\\ \\frac{1}{2}(\\sqrt{6})^{2} & =k(8(0)-(0)^{2})+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k(8x-{x}^{2})+3.\n$$\n\nAlso, since $v=2\\sqrt{5}\\,m/s$ when $x=1\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(8x-{x}^{2})+3 \\\\ \\frac{1}{2}(2\\sqrt{5})^{2} & =k(8(1)-{(1)}^{2})+3 \\\\ 10 & =7k+3 \\\\ 7k & =7 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =1(8x-{x}^{2})+3 \\\\ {v}^{2} & =16x-2{x}^{2}+6 \\\\ v & =\\pm \\sqrt{-2{x}^{2}+16x+6}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-2{x}^{2}+16x+6}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-2(4)^{2}+16(4)+6}=\\sqrt{38}\\,m/s\n$$"] [:db/cas 17592186365316 :question/worked-solution "![](images/a8/a8ff5e02237554d0f7107168f287adbe1834c4dd7ad965163531f5a23412a4fc.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(6-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(6-x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(6-x) & =0 \\\\ 6-x & =0 \\\\ x & =6.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=6\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,6)$ | $6$ | $(6,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $5$ |  | $7$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $k>0$ | $0$ | $-k<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=6\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k(6-x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int k(6-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k(6x-\\frac{1}{2}{x}^{2})+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(6x-\\frac{1}{2}{x}^{2})+C \\\\ \\frac{1}{2}(2)^{2} & =k(6(0)-\\frac{1}{2}(0)^{2})+C \\\\ C & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k(6x-\\frac{1}{2}{x}^{2})+2.\n$$\n\nAlso, since $v=2\\sqrt{11}\\,m/s$ when $x=2\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(6x-\\frac{1}{2}{x}^{2})+2 \\\\ \\frac{1}{2}(2\\sqrt{11})^{2} & =k(6(2)-\\frac{1}{2}{(2)}^{2})+2 \\\\ 22 & =10k+2 \\\\ 10k & =20 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =2(6x-\\frac{1}{2}{x}^{2})+2 \\\\ \\frac{1}{2}{v}^{2} & =12x-{x}^{2}+2 \\\\ {v}^{2} & =24x-2{x}^{2}+4 \\\\ v & =\\pm \\sqrt{-2{x}^{2}+24x+4}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-2{x}^{2}+24x+4}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(6)=\\sqrt{-2(6)^{2}+24(6)+4}=2\\sqrt{19}\\,m/s\n$$" "![](images/a8/a8ff5e02237554d0f7107168f287adbe1834c4dd7ad965163531f5a23412a4fc.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(6-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(6-x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(6-x) & =0 \\\\ 6-x & =0 \\\\ x & =6.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=6\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,6)$ | $6$ | $(6,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $5$ |  | $7$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $k>0$ | $0$ | $-k<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=6\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=k(6-x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int k(6-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k\\left(6x-\\frac{1}{2}{x}^{2}\\right)+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k\\left(6x-\\frac{1}{2}{x}^{2}\\right)+C \\\\ \\frac{1}{2}(2)^{2} & =k\\left(6(0)-\\frac{1}{2}(0)^{2}\\right)+C \\\\ C & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k\\left(6x-\\frac{1}{2}{x}^{2}\\right)+2.\n$$\n\nAlso, since $v=2\\sqrt{11}\\,m/s$ when $x=2\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k\\left(6x-\\frac{1}{2}{x}^{2}\\right)+2 \\\\ \\frac{1}{2}(2\\sqrt{11})^{2} & =k\\left(6(2)-\\frac{1}{2}{(2)}^{2}\\right)+2 \\\\ 22 & =10k+2 \\\\ 10k & =20 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =2\\left(6x-\\frac{1}{2}{x}^{2}\\right)+2 \\\\ \\frac{1}{2}{v}^{2} & =12x-{x}^{2}+2 \\\\ {v}^{2} & =24x-2{x}^{2}+4 \\\\ v & =\\pm \\sqrt{-2{x}^{2}+24x+4}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-2{x}^{2}+24x+4}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(6)=\\sqrt{-2(6)^{2}+24(6)+4}=2\\sqrt{19}\\,m/s\n$$"] [:db/cas 17592186365329 :question/worked-solution "![](images/a9/a967d26d7c139b5316c57b5546f47e52b30b2ff9e2d25620c79d05843cf5bfce.png)\n\nSince the acceleration of the particle $P$ has magnitude $(10+kx)\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-(10+kx).\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-(10+kx).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int -(10+kx)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-10x-\\frac{k{x}^{2}}{2}+C.\n$$\n\nNow, since $v=12\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-10x-\\frac{k{x}^{2}}{2}+C \\\\ \\frac{1}{2}(12)^{2} & =-10(0)-\\frac{k(0)^{2}}{2}+C \\\\ C & =72\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=72-10x-\\frac{k{x}^{2}}{2}.\n$$\n\nFinally, since $v=2\\sqrt{15}\\,m/s$ when $x=4\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =72-10x-\\frac{k{x}^{2}}{2} \\\\ \\frac{1}{2}(2\\sqrt{15})^{2} & =72-10(4)-\\frac{k(4)^{2}}{2} \\\\ 30 & =72-40-8k \\\\ 8k & =2 \\\\ k & =\\frac{1}{4}.\\end{aligned}\n$$" "![](images/a9/a967d26d7c139b5316c57b5546f47e52b30b2ff9e2d25620c79d05843cf5bfce.png)\n\nSince the acceleration of the particle $P$ has magnitude $(10+kx)\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-(10+kx).\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-(10+kx).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int -(10+kx)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-10x-\\frac{k{x}^{2}}{2}+C.\n$$\n\nNow, since $v=12\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-10x-\\frac{k{x}^{2}}{2}+C \\\\ \\frac{1}{2}(12)^{2} & =-10(0)-\\frac{k(0)^{2}}{2}+C \\\\ C & =72\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=72-10x-\\frac{k{x}^{2}}{2}.\n$$\n\nFinally, since $v=2\\sqrt{15}\\,m/s$ when $x=4\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =72-10x-\\frac{k{x}^{2}}{2} \\\\ \\frac{1}{2}(2\\sqrt{15})^{2} & =72-10(4)-\\frac{k(4)^{2}}{2} \\\\ 30 & =72-40-8k \\\\ 8k & =2 \\\\ k & =\\frac{1}{4}.\\end{aligned}\n$$"] [:db/cas 17592186365336 :question/worked-solution "![](images/52/52d095f73fdaa91c6a2fe9f2caca74929a22ec09618e85395732ea451bda81c7.png)\n\nSince the acceleration of the particle $P$ has magnitude $3{x}^{2}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-3{x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-3{x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-3{x}^{2})\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-{x}^{3}+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=2\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-{x}^{3}+C \\\\ \\frac{1}{2}(2)^{2} & =-(2)^{3}+C \\\\ C & =2+8 \\\\ C & =10\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=10-{x}^{3}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =10-{x}^{3} \\\\ \\frac{1}{2}(0)^{2} & =10-{x}^{3} \\\\ {x}^{3} & =10 \\\\ x & =\\sqrt[3]{10}\\,m.\\end{aligned}\n$$" "![](images/52/52d095f73fdaa91c6a2fe9f2caca74929a22ec09618e85395732ea451bda81c7.png)\n\nSince the acceleration of the particle $P$ has magnitude $3{x}^{2}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-3{x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-3{x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (-3{x}^{2})\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-{x}^{3}+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=2\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-{x}^{3}+C \\\\ \\frac{1}{2}(2)^{2} & =-(2)^{3}+C \\\\ C & =2+8 \\\\ C & =10\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=10-{x}^{3}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =10-{x}^{3} \\\\ \\frac{1}{2}(0)^{2} & =10-{x}^{3} \\\\ {x}^{3} & =10 \\\\ x & =\\sqrt[3]{10}\\,m.\\end{aligned}\n$$"] [:db/cas 17592186365343 :question/worked-solution "![](images/a8/a8c9778580276589ff7a047ca3c7b620de842efd7b3799a70b6e4484bc5fa0e6.png)\n\nSince the acceleration of the particle $P$ has magnitude $6{x}^{2}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-6{x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-6{x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-6{x}^{2})\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-2{x}^{3}+C.\n$$\n\nNow, since $v=2\\sqrt{7}\\,m/s$ when $x=1\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-2{x}^{3}+C \\\\ \\frac{1}{2}(2\\sqrt{7})^{2} & =-2(1)^{3}+C \\\\ C & =14+2 \\\\ C & =16\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=16-2{x}^{3}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =16-2{x}^{3} \\\\ \\frac{1}{2}(0)^{2} & =16-2{x}^{3} \\\\ 2{x}^{3} & =16 \\\\ {x}^{3} & =8 \\\\ x & =2\\,m.\\end{aligned}\n$$" "![](images/a8/a8c9778580276589ff7a047ca3c7b620de842efd7b3799a70b6e4484bc5fa0e6.png)\n\nSince the acceleration of the particle $P$ has magnitude $6{x}^{2}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-6{x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-6{x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (-6{x}^{2})\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-2{x}^{3}+C.\n$$\n\nNow, since $v=2\\sqrt{7}\\,m/s$ when $x=1\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-2{x}^{3}+C \\\\ \\frac{1}{2}(2\\sqrt{7})^{2} & =-2(1)^{3}+C \\\\ C & =14+2 \\\\ C & =16\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=16-2{x}^{3}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =16-2{x}^{3} \\\\ \\frac{1}{2}(0)^{2} & =16-2{x}^{3} \\\\ 2{x}^{3} & =16 \\\\ {x}^{3} & =8 \\\\ x & =2\\,m.\\end{aligned}\n$$"] [:db/cas 17592186365350 :question/worked-solution "![](images/cd/cdb88c0c679ca9325df42c5c8c4feaea6ce6c0cf02655410158860d7b03d54dc.png)\n\nSince the acceleration of the particle $P$ has magnitude $(4x-2)\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-(4x-2).\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-(4x-2).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-4x+2)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-2{x}^{2}+2x+C.\n$$\n\nNow, since $v=1\\,m/s$ when $x=\\frac{1}{2}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-2{x}^{2}+2x+C \\\\ \\frac{1}{2}(1)^{2} & =-2{\\left(\\frac{1}{2}\\right)}^{2}+2\\left(\\frac{1}{2}\\right)+C \\\\ C & =\\frac{1}{2}+\\frac{1}{2}-1 \\\\ C & =0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=-2{x}^{2}+2x.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-2{x}^{2}+2x \\\\ \\frac{1}{2}(0)^{2} & =-2{x}^{2}+2x \\\\ 2x(1-x) & =0.\\end{aligned}\n$$\n\nThe only solution of this equation for $x\\ge \\frac{1}{2}$ is $x=1\\,m.$" "![](images/cd/cdb88c0c679ca9325df42c5c8c4feaea6ce6c0cf02655410158860d7b03d54dc.png)\n\nSince the acceleration of the particle $P$ has magnitude $(4x-2)\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-(4x-2).\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-(4x-2).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (-4x+2)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-2{x}^{2}+2x+C.\n$$\n\nNow, since $v=1\\,m/s$ when $x=\\frac{1}{2}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-2{x}^{2}+2x+C \\\\ \\frac{1}{2}(1)^{2} & =-2{\\left(\\frac{1}{2}\\right)}^{2}+2\\left(\\frac{1}{2}\\right)+C \\\\ C & =\\frac{1}{2}+\\frac{1}{2}-1 \\\\ C & =0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=-2{x}^{2}+2x.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-2{x}^{2}+2x \\\\ \\frac{1}{2}(0)^{2} & =-2{x}^{2}+2x \\\\ 2x(1-x) & =0.\\end{aligned}\n$$\n\nThe only solution of this equation for $x\\ge \\frac{1}{2}$ is $x=1\\,m.$"] [:db/cas 17592186365357 :question/worked-solution "![](images/fa/fa329a81ac533c3ab4bfd9ca6fb5b2ef81ff4e29fb8ff7f030c5e04952d9448d.png)\n\nSince the acceleration of the particle $P$ has magnitude $6x\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-6x.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-6x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-6x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-3{x}^{2}+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=2\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-3{x}^{2}+C \\\\ \\frac{1}{2}(4)^{2} & =-3(2)^{2}+C \\\\ C & =8+12 \\\\ C & =20\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=20-3{x}^{2}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =20-3{x}^{2} \\\\ \\frac{1}{2}(0)^{2} & =20-3{x}^{2} \\\\ {x}^{2} & =\\frac{20}{3} \\\\ x & =\\pm \\frac{2}{3}\\sqrt{15}\\,m.\\end{aligned}\n$$" "![](images/fa/fa329a81ac533c3ab4bfd9ca6fb5b2ef81ff4e29fb8ff7f030c5e04952d9448d.png)\n\nSince the acceleration of the particle $P$ has magnitude $6x\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-6x.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=-6x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int (-6x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-3{x}^{2}+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=2\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-3{x}^{2}+C \\\\ \\frac{1}{2}(4)^{2} & =-3(2)^{2}+C \\\\ C & =8+12 \\\\ C & =20\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=20-3{x}^{2}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =20-3{x}^{2} \\\\ \\frac{1}{2}(0)^{2} & =20-3{x}^{2} \\\\ {x}^{2} & =\\frac{20}{3} \\\\ x & =\\pm \\frac{2}{3}\\sqrt{15}\\,m.\\end{aligned}\n$$"] [:db/cas 17592186365364 :question/worked-solution "![](images/ce/cefc91f25690470124503ab4da79245a95896ecc71f562d9a268d9f79ce0de58.png)\n\nSince the acceleration of the particle $P$ is $9{x}^{2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=9{x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=9{x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int 9{x}^{2}\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=3{x}^{3}+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=\\sqrt[3]{3}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =3{x}^{3}+C \\\\ \\frac{1}{2}(4)^{2} & =3{(\\sqrt[3]{3})}^{3}+C \\\\ 8 & =9+C \\\\ C & =-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=3{x}^{3}-1.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =3{x}^{3}-1 \\\\ \\frac{1}{2}(0)^{2} & =3{x}^{3}-1 \\\\ 3{x}^{3}-1 & =0 \\\\ {x}^{3} & =\\frac{1}{3} \\\\ x & =\\frac{1}{\\sqrt[3]{3}}\\,m.\\end{aligned}\n$$" "![](images/ce/cefc91f25690470124503ab4da79245a95896ecc71f562d9a268d9f79ce0de58.png)\n\nSince the acceleration of the particle $P$ is $9{x}^{2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=9{x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=9{x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int 9{x}^{2}\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=3{x}^{3}+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=\\sqrt[3]{3}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =3{x}^{3}+C \\\\ \\frac{1}{2}(4)^{2} & =3{(\\sqrt[3]{3})}^{3}+C \\\\ 8 & =9+C \\\\ C & =-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=3{x}^{3}-1.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =3{x}^{3}-1 \\\\ \\frac{1}{2}(0)^{2} & =3{x}^{3}-1 \\\\ 3{x}^{3}-1 & =0 \\\\ {x}^{3} & =\\frac{1}{3} \\\\ x & =\\frac{1}{\\sqrt[3]{3}}\\,m.\\end{aligned}\n$$"] [:db/cas 17592186365371 :question/worked-solution "![](images/1b/1b474c320ec59107dd191ab4420f0d4edb1e551164d90b741338da1e0dd3b23d.png)\n\nSince the acceleration of the particle $P$ is ${x}^{2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}={x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})={x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int {x}^{2}\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=\\frac{1}{3}{x}^{3}+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=\\sqrt[3]{7}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{1}{3}{x}^{3}+C \\\\ \\frac{1}{2}(2)^{2} & =\\frac{1}{3}(\\sqrt[3]{7})^{3}+C \\\\ C & =2-\\frac{7}{3} \\\\ C & =-\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=\\frac{{x}^{3}-1}{3}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{{x}^{3}-1}{3} \\\\ \\frac{1}{2}(0)^{2} & =\\frac{{x}^{3}-1}{3} \\\\ {x}^{3}-1 & =0 \\\\ {x}^{3} & =1 \\\\ x & =1\\,m.\\end{aligned}\n$$" "![](images/1b/1b474c320ec59107dd191ab4420f0d4edb1e551164d90b741338da1e0dd3b23d.png)\n\nSince the acceleration of the particle $P$ is ${x}^{2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}={x}^{2}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)={x}^{2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)\\text{d}x=\\int {x}^{2}\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=\\frac{1}{3}{x}^{3}+C.\n$$\n\nNow, since $v=2\\,m/s$ when $x=\\sqrt[3]{7}\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{1}{3}{x}^{3}+C \\\\ \\frac{1}{2}(2)^{2} & =\\frac{1}{3}(\\sqrt[3]{7})^{3}+C \\\\ C & =2-\\frac{7}{3} \\\\ C & =-\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=\\frac{{x}^{3}-1}{3}.\n$$\n\nFinally, the particle is instantaneously at rest when $v(x)=0\\,m/s.$ We find the displacement of the particle when instantaneously at rest by substituting $v=0$ in the equation above and solving for $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{{x}^{3}-1}{3} \\\\ \\frac{1}{2}(0)^{2} & =\\frac{{x}^{3}-1}{3} \\\\ {x}^{3}-1 & =0 \\\\ {x}^{3} & =1 \\\\ x & =1\\,m.\\end{aligned}\n$$"] [:db/cas 17592186365412 :question/problem "$$\n\\mathbf{f}(x,t)=⟨x,\\hspace{0.167em}\\text{_____},\\hspace{0.167em}7\\operatorname{tan}t⟩,\\hspace{2em}t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})\n$$\n\nThe vector-valued function $\\mathbf{f}(x,t)$ above parametrizes one sheet of the hyperbolic cylinder defined in Cartesian coordinates as ${y}^{2}-{z}^{2}=49$ for $y\\ge 7.$ What is the second component of $\\mathbf{f}?$" "$$\n\\mathbf{f}(x,t)=⟨x,\\hspace{0.167em}\\text{_____},\\hspace{0.167em}7\\operatorname{tan}t⟩,\\hspace{2em}t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)\n$$\n\nThe vector-valued function $\\mathbf{f}(x,t)$ above parametrizes one sheet of the hyperbolic cylinder defined in Cartesian coordinates as ${y}^{2}-{z}^{2}=49$ for $y\\ge 7.$ What is the second component of $\\mathbf{f}?$"] [:db/cas 17592186365412 :question/worked-solution "Recall that the hyperbola ${y}^{2}-{z}^{2}=49$ for $y\\ge 7$ in $yz$-plane has the parametrization\n\n$$\n⟨y,z⟩=⟨7\\operatorname{sec}⁡t,\\,7\\operatorname{tan}⁡t⟩,\\,t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})\n$$\n\nsince \n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2} & =(7\\operatorname{sec}⁡t)^{2}-(7\\operatorname{tan}⁡t)^{2} \\\\  & =49{\\sec }^{2}⁡t-49{\\tan }^{2}⁡t \\\\  & =49({\\sec }^{2}⁡t-{\\tan }^{2}⁡t) \\\\  & =49.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(x,t) & =⟨x,y,z⟩ \\\\  & =⟨x,\\hspace{0.167em}{\\color{blue}7\\operatorname{sec}t},\\hspace{0.167em}7\\operatorname{tan}t⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})$ and $x\\in (-\\infty ,\\infty ).$\n\nTherefore, the second component of $\\mathbf{f}$ is ${\\color{blue}7\\operatorname{sec}t}.$" "Recall that the hyperbola ${y}^{2}-{z}^{2}=49$ for $y\\ge 7$ in $yz$-plane has the parametrization\n\n$$\n⟨y,z⟩=⟨7\\operatorname{sec}⁡t,\\,7\\operatorname{tan}⁡t⟩,\\,t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)\n$$\n\nsince \n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2} & =(7\\operatorname{sec}⁡t)^{2}-(7\\operatorname{tan}⁡t)^{2} \\\\  & =49{\\sec }^{2}⁡t-49{\\tan }^{2}⁡t \\\\  & =49({\\sec }^{2}⁡t-{\\tan }^{2}⁡t) \\\\  & =49.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(x,t) & =⟨x,y,z⟩ \\\\  & =⟨x,\\hspace{0.167em}{\\color{blue}7\\operatorname{sec}t},\\hspace{0.167em}7\\operatorname{tan}t⟩\\end{aligned}\n$$\n\nwhere $t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)$ and $x\\in (-\\infty ,\\infty ).$\n\nTherefore, the second component of $\\mathbf{f}$ is ${\\color{blue}7\\operatorname{sec}t}.$"] [:db/cas 17592186365419 :question/problem "$$\n\\mathbf{f}(t,y)=⟨\\text{_____},\\hspace{0.167em}y,\\hspace{0.167em}4\\operatorname{tan}t⟩,\\hspace{2em}t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})\n$$\n\nThe vector-valued function $\\mathbf{f}(t,y)$ above parametrizes one sheet of the hyperbolic cylinder defined in Cartesian coordinates as ${x}^{2}-\\frac{{z}^{2}}{16}=1$ for $x\\ge 1.$ What is the first component of $\\mathbf{f}?$" "$$\n\\mathbf{f}(t,y)=⟨\\text{_____},\\hspace{0.167em}y,\\hspace{0.167em}4\\operatorname{tan}t⟩,\\hspace{2em}t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)\n$$\n\nThe vector-valued function $\\mathbf{f}(t,y)$ above parametrizes one sheet of the hyperbolic cylinder defined in Cartesian coordinates as ${x}^{2}-\\frac{{z}^{2}}{16}=1$ for $x\\ge 1.$ What is the first component of $\\mathbf{f}?$"] [:db/cas 17592186365419 :question/worked-solution "Recall that the hyperbola ${x}^{2}-\\frac{{z}^{2}}{16}=1$ for $x\\ge 1$ in $xz$-plane has the parametrization\n\n$$\n⟨x,z⟩=⟨\\operatorname{sec}⁡t,\\,4\\operatorname{tan}⁡t⟩,\\,t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})\n$$\n\nsince \n\n$$\n\\begin{aligned}{x}^{2}-\\frac{{z}^{2}}{16} & =(\\operatorname{sec}⁡t)^{2}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & ={\\sec }^{2}⁡t-\\frac{16{\\tan }^{2}⁡t}{16} \\\\  & ={\\sec }^{2}⁡t-{\\tan }^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,y) & =⟨x,y,z⟩ \\\\  & =⟨{\\color{blue}\\operatorname{sec}t},y,\\hspace{0.167em}4\\operatorname{tan}t⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})$ and $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}\\operatorname{sec}t}.$" "Recall that the hyperbola ${x}^{2}-\\frac{{z}^{2}}{16}=1$ for $x\\ge 1$ in $xz$-plane has the parametrization\n\n$$\n⟨x,z⟩=⟨\\operatorname{sec}⁡t,\\,4\\operatorname{tan}⁡t⟩,\\,t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)\n$$\n\nsince \n\n$$\n\\begin{aligned}{x}^{2}-\\frac{{z}^{2}}{16} & =(\\operatorname{sec}⁡t)^{2}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & ={\\sec }^{2}⁡t-\\frac{16{\\tan }^{2}⁡t}{16} \\\\  & ={\\sec }^{2}⁡t-{\\tan }^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,y) & =⟨x,y,z⟩ \\\\  & =⟨{\\color{blue}\\operatorname{sec}t},y,\\hspace{0.167em}4\\operatorname{tan}t⟩\\end{aligned}\n$$\n\nwhere $t\\in \\left(-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right)$ and $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}\\operatorname{sec}t}.$"] [:db/cas 17592186365568 :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }\\frac{2\\sqrt{x}+9x-1}{3x+5} & =\\lim_{x\\to \\infty }\\frac{[2\\sqrt{x}+9x-1]^{′}}{[3x+5]^{′}} \\\\  & =\\lim_{x\\to \\infty }\\frac{(\\frac{1}{\\sqrt{x}}+9)}{3} \\\\  & =\\frac{0+9}{3} \\\\  & =3.\\end{aligned}\n$$" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }\\frac{2\\sqrt{x}+9x-1}{3x+5} & =\\lim_{x\\to \\infty }\\frac{[2\\sqrt{x}+9x-1]^{′}}{[3x+5]^{′}} \\\\  & =\\lim_{x\\to \\infty }\\frac{\\left(\\frac{1}{\\sqrt{x}}+9\\right)}{3} \\\\  & =\\frac{0+9}{3} \\\\  & =3.\\end{aligned}\n$$"] [:db/cas 17592186365571 :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{8}\\operatorname{ln}⁡(5x+1)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{ln}⁡(5x+1),$ the lower bound is $a=2$ and the upper bound is $b=8.$ So, we have\n\n$$\nΔx=\\frac{8-2}{n}=\\frac{6}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{8}\\operatorname{ln}⁡(5x+1)\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(2+m\\cdot \\frac{6}{n})\\cdot \\frac{6}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(2+\\frac{6m}{n})\\cdot \\frac{6}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}[\\operatorname{ln}⁡(5(2+\\frac{6m}{n})+1)\\cdot \\frac{6}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}[\\operatorname{ln}⁡(11+\\frac{30m}{n})\\cdot \\frac{6}{n}].\\end{aligned}\n$$" "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{8}\\operatorname{ln}⁡(5x+1)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{ln}⁡(5x+1),$ the lower bound is $a=2$ and the upper bound is $b=8.$ So, we have\n\n$$\nΔx=\\frac{8-2}{n}=\\frac{6}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{8}\\operatorname{ln}⁡(5x+1)\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}\\left[f\\left(2+m\\cdot \\frac{6}{n}\\right)\\cdot \\frac{6}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}\\left[f\\left(2+\\frac{6m}{n}\\right)\\cdot \\frac{6}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}\\left[\\operatorname{ln}⁡\\left(5\\left(2+\\frac{6m}{n}\\right)+1\\right)\\cdot \\frac{6}{n}\\right] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{m=1}^{n}\\left[\\operatorname{ln}⁡\\left(11+\\frac{30m}{n}\\right)\\cdot \\frac{6}{n}\\right].\\end{aligned}\n$$"] [:db/cas 17592186365650 :question/worked-solution "For a second-order initial value problem\n\n$$\n{y}^{″}=f(x,y,{y}^{′}),\\,y(a)=c,\\,{y}^{′}(a)=d,\n$$\n\nwe can use Euler's method to approximate a solution by first reducing the second-order ODE to a system of first-order ODEs,\n\n$$\n\\left\\{\\begin{aligned}{y}^{′} &=z,\\, && y(a)=c, \\\\ {z}^{′} &=f(x,y,z)\\, && z(a)=d,\\end{aligned}\\right.\n$$\n\nbefore applying the update rule component-wise to each equation.\n\nTo apply Euler’s method, we first isolate ${y}^{″}$ so it can serve as the derivative of a new variable $z:$\n\n$$\n\\begin{aligned}3{y}^{″}+2{y}^{′}-{x}^{2} & =0 \\\\ 3{y}^{″} & ={x}^{2}-2{y}^{′} \\\\ {y}^{″} & =\\frac{{x}^{2}-2{y}^{′}}{3}.\\end{aligned}\n$$\n\nThen, we substitute our new variable $z={y}^{′},{z}^{′}={y}^{″}$ in the right-hand side of the above equation. This gives\n\n$$\n{z}^{′}=\\frac{{x}^{2}-2z}{3}.\n$$\n\nNote that the initial value of $z$ is $z(1)={y}^{′}(1)=0.$\nSo, the initial value problem reduces to the following system of first-order ODEs:\n\n$$\n\\left\\{\\begin{aligned}{y}^{′} &=z,\\, && y(1)=2, \\\\ {z}^{′} &=\\frac{{x}^{2}-2z}{3},\\, && z(1)=0\\end{aligned}\\right.\n$$\n\nNow, we can proceed with Euler's method by applying the update rule component-wise.\n\nFirst, note that we are given the values of $y$ and $z={y}^{′}$ at $x=1$ and asked to find their values at $x=3.$ The distance from $x=1$ to $x=3$ is $2,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{3-1}{2}=1.\n$$\n\nNow, we'll start by creating a table that includes the initial condition data $y(1)=2$ and $z(1)=0.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ |  |  | $0$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =z=0 \\\\ {z}^{′} & =\\frac{{x}^{2}-2z}{3}=\\frac{{1}^{2}-2\\cdot 0}{3}=\\frac{1}{3} \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ Δz & ={z}^{′}\\cdot Δx=\\frac{1}{3}\\cdot 1=\\frac{1}{3} \\\\ {x}_{\\text{new}} & =x+Δx=1+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=2+0=2 \\\\ {z}_{\\text{new}} & =z+Δz=0+\\frac{1}{3}=\\frac{1}{3}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ | $0$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |\n| $2$ | $2$ |  |  | $\\frac{1}{3}$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =z=\\frac{1}{3} \\\\ {z}^{′} & =\\frac{{x}^{2}-2z}{3}=\\frac{({2}^{2}-2\\cdot \\frac{1}{3})}{3}=\\frac{10}{9} \\\\ Δy & ={y}^{′}\\cdot Δx=\\frac{1}{3}\\cdot 1=\\frac{1}{3} \\\\ Δz & ={z}^{′}\\cdot Δx=\\frac{10}{9}\\cdot 1=\\frac{10}{9} \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3 \\\\ {y}_{\\text{new}} & =y+Δy=2+\\frac{1}{3}=\\frac{7}{3} \\\\ {z}_{\\text{new}} & =z+Δz=\\frac{1}{3}+\\frac{10}{9}=\\frac{13}{9}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ | $0$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |\n| $2$ | $2$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{10}{9}$ | $\\frac{10}{9}$ |\n| $3$ | $\\frac{7}{3}$ |  |  | $\\frac{13}{9}$ |  |  |\n\nTherefore, we conclude that\n$y(3)≈\\frac{7}{3}$\nand\n${y}^{′}(3)=z(3)≈\\frac{13}{9}.$" "For a second-order initial value problem\n\n$$\n{y}^{″}=f(x,y,{y}^{′}),\\,y(a)=c,\\,{y}^{′}(a)=d,\n$$\n\nwe can use Euler's method to approximate a solution by first reducing the second-order ODE to a system of first-order ODEs,\n\n$$\n\\left\\{\\begin{aligned}{y}^{′} &=z,\\, && y(a)=c, \\\\ {z}^{′} &=f(x,y,z)\\, && z(a)=d,\\end{aligned}\\right.\n$$\n\nbefore applying the update rule component-wise to each equation.\n\nTo apply Euler’s method, we first isolate ${y}^{″}$ so it can serve as the derivative of a new variable $z:$\n\n$$\n\\begin{aligned}3{y}^{″}+2{y}^{′}-{x}^{2} & =0 \\\\ 3{y}^{″} & ={x}^{2}-2{y}^{′} \\\\ {y}^{″} & =\\frac{{x}^{2}-2{y}^{′}}{3}.\\end{aligned}\n$$\n\nThen, we substitute our new variable $z={y}^{′},{z}^{′}={y}^{″}$ in the right-hand side of the above equation. This gives\n\n$$\n{z}^{′}=\\frac{{x}^{2}-2z}{3}.\n$$\n\nNote that the initial value of $z$ is $z(1)={y}^{′}(1)=0.$\nSo, the initial value problem reduces to the following system of first-order ODEs:\n\n$$\n\\left\\{\\begin{aligned}{y}^{′} &=z,\\, && y(1)=2, \\\\ {z}^{′} &=\\frac{{x}^{2}-2z}{3},\\, && z(1)=0\\end{aligned}\\right.\n$$\n\nNow, we can proceed with Euler's method by applying the update rule component-wise.\n\nFirst, note that we are given the values of $y$ and $z={y}^{′}$ at $x=1$ and asked to find their values at $x=3.$ The distance from $x=1$ to $x=3$ is $2,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{3-1}{2}=1.\n$$\n\nNow, we'll start by creating a table that includes the initial condition data $y(1)=2$ and $z(1)=0.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ |  |  | $0$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =z=0 \\\\ {z}^{′} & =\\frac{{x}^{2}-2z}{3}=\\frac{{1}^{2}-2\\cdot 0}{3}=\\frac{1}{3} \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ Δz & ={z}^{′}\\cdot Δx=\\frac{1}{3}\\cdot 1=\\frac{1}{3} \\\\ {x}_{\\text{new}} & =x+Δx=1+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=2+0=2 \\\\ {z}_{\\text{new}} & =z+Δz=0+\\frac{1}{3}=\\frac{1}{3}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ | $0$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |\n| $2$ | $2$ |  |  | $\\frac{1}{3}$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =z=\\frac{1}{3} \\\\ {z}^{′} & =\\frac{{x}^{2}-2z}{3}=\\frac{\\left({2}^{2}-2\\cdot \\frac{1}{3}\\right)}{3}=\\frac{10}{9} \\\\ Δy & ={y}^{′}\\cdot Δx=\\frac{1}{3}\\cdot 1=\\frac{1}{3} \\\\ Δz & ={z}^{′}\\cdot Δx=\\frac{10}{9}\\cdot 1=\\frac{10}{9} \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3 \\\\ {y}_{\\text{new}} & =y+Δy=2+\\frac{1}{3}=\\frac{7}{3} \\\\ {z}_{\\text{new}} & =z+Δz=\\frac{1}{3}+\\frac{10}{9}=\\frac{13}{9}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ | $0$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |\n| $2$ | $2$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{10}{9}$ | $\\frac{10}{9}$ |\n| $3$ | $\\frac{7}{3}$ |  |  | $\\frac{13}{9}$ |  |  |\n\nTherefore, we conclude that\n$y(3)≈\\frac{7}{3}$\nand\n${y}^{′}(3)=z(3)≈\\frac{13}{9}.$"] [:db/cas 17592186365668 :question/worked-solution "Suppose $A$ is a constant $n\\times n$ matrix and $x(t)$ is an $n\\times 1$ column vector. The standard fundamental matrix of the linear system ${x}^{′}(t)=Ax(t),$ denoted ${Φ}_{0}(t),$ is the unique matrix solution of the initial value problem \n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n},\n$$\n\nwhere ${I}_{n}$ is the identity matrix. \n\nFurthermore, it can be shown that ${Φ}_{0}(t)={e}^{At}.$\n\nWe have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{0} & 5{\\alpha }_{1}t \\\\ 5{\\alpha }_{1}t & {\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are constants to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=-5t,\\,{\\lambda }_{2}=5t,\n$$\n\neach of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(-5t) &={e}^{-5t} \\\\ r(5t) &={e}^{5t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}-5t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{-5t} \\\\ 5t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{5t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- Subtracting the second equation from the first one, we get\n\n$$\n-10t{\\alpha }_{1}={e}^{-5t}-{e}^{5t}\\,⇒\\,{\\alpha }_{1}=-\\frac{1}{10t}({e}^{-5t}-{e}^{5t}).\n$$\n\n- Adding the first and the second equations, we get\n\n$$\n2{\\alpha }_{0}={e}^{-5t}+{e}^{5t}\\,⇒\\,{\\alpha }_{0}=\\frac{1}{2}({e}^{-5t}+{e}^{5t}).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{0} & =\\frac{1}{2}({e}^{-5t}+{e}^{5t}) \\\\  & =\\frac{1}{2}({e}^{5t}+{e}^{-5t}) \\\\ 5{\\alpha }_{1}t & =5\\cdot (-\\frac{1}{10t}({e}^{-5t}-{e}^{5t}))t \\\\  & =\\frac{1}{2}({e}^{5t}-{e}^{-5t})\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\frac{1}{2}\\begin{bmatrix}{e}^{5t}+{e}^{-5t} & {e}^{5t}-{e}^{-5t} \\\\ {e}^{5t}-{e}^{-5t} & {e}^{5t}+{e}^{-5t}\\end{bmatrix}.\n$$" "Suppose $A$ is a constant $n\\times n$ matrix and $x(t)$ is an $n\\times 1$ column vector. The standard fundamental matrix of the linear system ${x}^{′}(t)=Ax(t),$ denoted ${Φ}_{0}(t),$ is the unique matrix solution of the initial value problem \n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n},\n$$\n\nwhere ${I}_{n}$ is the identity matrix. \n\nFurthermore, it can be shown that ${Φ}_{0}(t)={e}^{At}.$\n\nWe have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{0} & 5{\\alpha }_{1}t \\\\ 5{\\alpha }_{1}t & {\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are constants to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=-5t,\\,{\\lambda }_{2}=5t,\n$$\n\neach of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(-5t) &={e}^{-5t} \\\\ r(5t) &={e}^{5t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}-5t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{-5t} \\\\ 5t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{5t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- Subtracting the second equation from the first one, we get\n\n$$\n-10t{\\alpha }_{1}={e}^{-5t}-{e}^{5t}\\,⇒\\,{\\alpha }_{1}=-\\frac{1}{10t}({e}^{-5t}-{e}^{5t}).\n$$\n\n- Adding the first and the second equations, we get\n\n$$\n2{\\alpha }_{0}={e}^{-5t}+{e}^{5t}\\,⇒\\,{\\alpha }_{0}=\\frac{1}{2}({e}^{-5t}+{e}^{5t}).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{0} & =\\frac{1}{2}({e}^{-5t}+{e}^{5t}) \\\\  & =\\frac{1}{2}({e}^{5t}+{e}^{-5t}) \\\\ 5{\\alpha }_{1}t & =5\\cdot \\left(-\\frac{1}{10t}({e}^{-5t}-{e}^{5t})\\right)t \\\\  & =\\frac{1}{2}({e}^{5t}-{e}^{-5t})\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\frac{1}{2}\\begin{bmatrix}{e}^{5t}+{e}^{-5t} & {e}^{5t}-{e}^{-5t} \\\\ {e}^{5t}-{e}^{-5t} & {e}^{5t}+{e}^{-5t}\\end{bmatrix}.\n$$"] [:db/cas 17592186365724 :question/problem "Which of the following gives the unit tangent vector to the curve\n $r(t)=⟨\\frac{1}{t},\\,t,\\,\\sqrt{2}\\operatorname{ln}⁡t⟩$ at an arbitrary point where $t\\in (0,\\infty )?$" "Which of the following gives the unit tangent vector to the curve\n $r(t)=\\left\\langle \\frac{1}{t},\\,t,\\,\\sqrt{2}\\operatorname{ln}⁡t\\right\\rangle $ at an arbitrary point where $t\\in (0,\\infty )?$"] [:db/cas 17592186365724 :question/worked-solution "For a curve $r(t)=⟨x(t),\\,y(t),\\,z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find the derivative of $r(t):$  \n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right),\\,\\frac{\\text{d}}{\\text{d}t}(t),\\,\\sqrt{2}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)⟩ \\\\  & =⟨-\\frac{1}{{t}^{2}},\\,1,\\,\\frac{\\sqrt{2}}{t}⟩\\end{aligned}\n$$\n\nNext, we calculate the magnitude of ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{r}^{′}(t)‖ & =\\sqrt{{\\left(-\\frac{1}{{t}^{2}}\\right)}^{2}+(1)^{2}+{\\left(\\frac{\\sqrt{2}}{t}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{1}{{t}^{4}}+1+\\frac{2}{{t}^{2}}} \\\\  & =\\sqrt{\\frac{1+{t}^{4}+2{t}^{2}}{{t}^{4}}} \\\\  & =\\sqrt{\\frac{(1+{t}^{2})^{2}}{{t}^{4}}} \\\\  & =\\frac{1+{t}^{2}}{{t}^{2}}\\end{aligned}\n$$\n\n Finally, we normalize ${r}^{′}(t)$ and obtain the unit tangent vector to the curve:\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{{t}^{2}}{1+{t}^{2}}⟨-\\frac{1}{{t}^{2}},\\,1,\\,\\frac{\\sqrt{2}}{t}⟩ \\\\  & =\\frac{1}{1+{t}^{2}}⟨-1,\\,{t}^{2},\\,\\sqrt{2}t⟩\\end{aligned}\n$$" "For a curve $r(t)=⟨x(t),\\,y(t),\\,z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find the derivative of $r(t):$  \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right),\\,\\frac{\\text{d}}{\\text{d}t}(t),\\,\\sqrt{2}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\right\\rangle  \\\\  & =\\left\\langle -\\frac{1}{{t}^{2}},\\,1,\\,\\frac{\\sqrt{2}}{t}\\right\\rangle \\end{aligned}\n$$\n\nNext, we calculate the magnitude of ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{r}^{′}(t)‖ & =\\sqrt{{\\left(-\\frac{1}{{t}^{2}}\\right)}^{2}+(1)^{2}+{\\left(\\frac{\\sqrt{2}}{t}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{1}{{t}^{4}}+1+\\frac{2}{{t}^{2}}} \\\\  & =\\sqrt{\\frac{1+{t}^{4}+2{t}^{2}}{{t}^{4}}} \\\\  & =\\sqrt{\\frac{(1+{t}^{2})^{2}}{{t}^{4}}} \\\\  & =\\frac{1+{t}^{2}}{{t}^{2}}\\end{aligned}\n$$\n\n Finally, we normalize ${r}^{′}(t)$ and obtain the unit tangent vector to the curve:\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{{t}^{2}}{1+{t}^{2}}\\left\\langle -\\frac{1}{{t}^{2}},\\,1,\\,\\frac{\\sqrt{2}}{t}\\right\\rangle  \\\\  & =\\frac{1}{1+{t}^{2}}⟨-1,\\,{t}^{2},\\,\\sqrt{2}t⟩\\end{aligned}\n$$"] [:db/cas 17592186365726 :answer/value "\\frac{1}{1+t}⟨-1,\\,{t}^{2},\\,\\frac{\\sqrt{2}}{2}t⟩" "\\frac{1}{1+t}\\left\\langle -1,\\,{t}^{2},\\,\\frac{\\sqrt{2}}{2}t\\right\\rangle "] [:db/cas 17592186365787 :answer/value "⟨\\frac{1}{\\sqrt{17}},0,\\frac{4}{\\sqrt{17}}⟩" "\\left\\langle \\frac{1}{\\sqrt{17}},0,\\frac{4}{\\sqrt{17}}\\right\\rangle "] [:db/cas 17592186365788 :answer/value "⟨\\frac{2}{9},\\frac{8}{9},\\frac{4}{9}⟩" "\\left\\langle \\frac{2}{9},\\frac{8}{9},\\frac{4}{9}\\right\\rangle "] [:db/cas 17592186365789 :answer/value "⟨\\frac{1}{\\sqrt{69}},\\frac{8}{\\sqrt{69}},\\frac{2}{\\sqrt{69}}⟩" "\\left\\langle \\frac{1}{\\sqrt{69}},\\frac{8}{\\sqrt{69}},\\frac{2}{\\sqrt{69}}\\right\\rangle "] [:db/cas 17592186365790 :answer/value "⟨\\frac{1}{9},\\frac{8}{9},\\frac{4}{9}⟩" "\\left\\langle \\frac{1}{9},\\frac{8}{9},\\frac{4}{9}\\right\\rangle "] [:db/cas 17592186365791 :answer/value "⟨\\frac{1}{9},-\\frac{8}{9},\\frac{4}{9}⟩" "\\left\\langle \\frac{1}{9},-\\frac{8}{9},\\frac{4}{9}\\right\\rangle "] [:db/cas 17592186365808 :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nNotice that we are given that\n\n$$\n{x}_{c}(t)={c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{-2t}+{c}_{2}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{t}.\n$$\n\nWe'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{-2t} & -{e}^{t} \\\\ 2{e}^{-2t} & {e}^{t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}4t \\\\ 0\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-2t}\\cdot {e}^{t}-(-{e}^{t})\\cdot 2{e}^{-2t}}\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ -2{e}^{-2t} & {e}^{-2t}\\end{bmatrix} \\\\  & =\\frac{{e}^{t}}{3}\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ -2{e}^{-2t} & {e}^{-2t}\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}{e}^{2t} & {e}^{2t} \\\\ -2{e}^{-t} & {e}^{-t}\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{Φ}^{-1}\\,f(t) & =\\frac{1}{3}\\begin{bmatrix}{e}^{2t} & {e}^{2t} \\\\ -2{e}^{-t} & {e}^{-t}\\end{bmatrix}\\begin{bmatrix}4t \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{3}t{e}^{2t} \\\\ -\\frac{8}{3}t{e}^{-t}\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}\\frac{4}{3}t{e}^{2t} \\\\ -\\frac{8}{3}t{e}^{-t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int \\frac{4}{3}t{e}^{2t}\\,\\text{d}t \\\\ \\int -\\frac{8}{3}t{e}^{-t}\\,\\text{d}t\\end{bmatrix}.\\end{aligned}\n$$\n\nIntegrating the components by parts, we get the following:\n\n- For the first component, let $u=\\frac{4}{3}t$ and $\\text{d}v={e}^{2t}\\,\\text{d}t.$ Then, $\\text{d}u=\\frac{4}{3}\\,\\text{d}t$ and $v=\\frac{1}{2}{e}^{2t}.$ So,\n\n$$\n\\begin{aligned}\\int \\frac{4}{3}t{e}^{2t}\\,\\text{d}t & =\\frac{4}{3}t\\cdot \\frac{1}{2}{e}^{2t}-\\int \\frac{1}{2}{e}^{2t}\\cdot (\\frac{4}{3}\\,\\text{d}t) \\\\  & =\\frac{2}{3}t{e}^{2t}-\\frac{2}{3}\\int {e}^{2t}\\,\\text{d}t \\\\  & =\\frac{2}{3}t{e}^{2t}-\\frac{1}{3}{e}^{2t} \\\\  & =\\frac{1}{3}{e}^{2t}(2t-1).\\end{aligned}\n$$\n\n- For the second component, let $u=-\\frac{8}{3}t$ and $\\text{d}v={e}^{-t}\\,\\text{d}t.$ Then, $\\text{d}u=-\\frac{8}{3}\\,\\text{d}t$ and $v=-{e}^{-t}.$ So,\n\n$$\n\\begin{aligned}\\int -\\frac{8}{3}t{e}^{-t}\\,\\text{d}t & =-\\frac{8}{3}t\\cdot (-{e}^{-t})-\\int -{e}^{-t}\\cdot (-\\frac{8}{3}\\,\\text{d}t) \\\\  & =\\frac{8}{3}t{e}^{-t}-\\frac{8}{3}\\int {e}^{-t}\\,\\text{d}t \\\\  & =\\frac{8}{3}t{e}^{-t}+\\frac{8}{3}{e}^{-t} \\\\  & =\\frac{8}{3}{e}^{-t}(t+1).\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}{e}^{-2t} & -{e}^{t} \\\\ 2{e}^{-2t} & {e}^{t}\\end{bmatrix}\\begin{bmatrix}\\frac{1}{3}{e}^{2t}(2t-1) \\\\ \\frac{8}{3}{e}^{-t}(t+1)\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}(2t-1)-8(t+1) \\\\ 2(2t-1)+8(t+1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2t-3 \\\\ 4t+2\\end{bmatrix}.\\end{aligned}\n$$" "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nNotice that we are given that\n\n$$\n{x}_{c}(t)={c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{-2t}+{c}_{2}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{t}.\n$$\n\nWe'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{-2t} & -{e}^{t} \\\\ 2{e}^{-2t} & {e}^{t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}4t \\\\ 0\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-2t}\\cdot {e}^{t}-(-{e}^{t})\\cdot 2{e}^{-2t}}\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ -2{e}^{-2t} & {e}^{-2t}\\end{bmatrix} \\\\  & =\\frac{{e}^{t}}{3}\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ -2{e}^{-2t} & {e}^{-2t}\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}{e}^{2t} & {e}^{2t} \\\\ -2{e}^{-t} & {e}^{-t}\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{Φ}^{-1}\\,f(t) & =\\frac{1}{3}\\begin{bmatrix}{e}^{2t} & {e}^{2t} \\\\ -2{e}^{-t} & {e}^{-t}\\end{bmatrix}\\begin{bmatrix}4t \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{3}t{e}^{2t} \\\\ -\\frac{8}{3}t{e}^{-t}\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}\\frac{4}{3}t{e}^{2t} \\\\ -\\frac{8}{3}t{e}^{-t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int \\frac{4}{3}t{e}^{2t}\\,\\text{d}t \\\\ \\int -\\frac{8}{3}t{e}^{-t}\\,\\text{d}t\\end{bmatrix}.\\end{aligned}\n$$\n\nIntegrating the components by parts, we get the following:\n\n- For the first component, let $u=\\frac{4}{3}t$ and $\\text{d}v={e}^{2t}\\,\\text{d}t.$ Then, $\\text{d}u=\\frac{4}{3}\\,\\text{d}t$ and $v=\\frac{1}{2}{e}^{2t}.$ So,\n\n$$\n\\begin{aligned}\\int \\frac{4}{3}t{e}^{2t}\\,\\text{d}t & =\\frac{4}{3}t\\cdot \\frac{1}{2}{e}^{2t}-\\int \\frac{1}{2}{e}^{2t}\\cdot \\left(\\frac{4}{3}\\,\\text{d}t\\right) \\\\  & =\\frac{2}{3}t{e}^{2t}-\\frac{2}{3}\\int {e}^{2t}\\,\\text{d}t \\\\  & =\\frac{2}{3}t{e}^{2t}-\\frac{1}{3}{e}^{2t} \\\\  & =\\frac{1}{3}{e}^{2t}(2t-1).\\end{aligned}\n$$\n\n- For the second component, let $u=-\\frac{8}{3}t$ and $\\text{d}v={e}^{-t}\\,\\text{d}t.$ Then, $\\text{d}u=-\\frac{8}{3}\\,\\text{d}t$ and $v=-{e}^{-t}.$ So,\n\n$$\n\\begin{aligned}\\int -\\frac{8}{3}t{e}^{-t}\\,\\text{d}t & =-\\frac{8}{3}t\\cdot (-{e}^{-t})-\\int -{e}^{-t}\\cdot \\left(-\\frac{8}{3}\\,\\text{d}t\\right) \\\\  & =\\frac{8}{3}t{e}^{-t}-\\frac{8}{3}\\int {e}^{-t}\\,\\text{d}t \\\\  & =\\frac{8}{3}t{e}^{-t}+\\frac{8}{3}{e}^{-t} \\\\  & =\\frac{8}{3}{e}^{-t}(t+1).\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}{e}^{-2t} & -{e}^{t} \\\\ 2{e}^{-2t} & {e}^{t}\\end{bmatrix}\\begin{bmatrix}\\frac{1}{3}{e}^{2t}(2t-1) \\\\ \\frac{8}{3}{e}^{-t}(t+1)\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}(2t-1)-8(t+1) \\\\ 2(2t-1)+8(t+1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2t-3 \\\\ 4t+2\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186365845 :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and $$\n\\displaystyle y\\,\\left(\\frac{1}{2}\\right)+{y}^{′}\\,\\left(\\frac{1}{2}\\right)=0\n$$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-20\\lambda m+100{\\lambda }^{2} & =0 \\\\ (m-10\\lambda )(m-10\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=10\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{10\\lambda x},\\,{y}_{2}(x)=x{e}^{10\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{10\\lambda x}+Bx{e}^{10\\lambda x}.\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA+B\\cdot 0=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=Bx{e}^{10\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′}=B{e}^{10\\lambda x}+10B\\lambda x{e}^{10\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition $$\n\\displaystyle y\\,\\left(\\frac{1}{2}\\right)+{y}^{′}\\,\\left(\\frac{1}{2}\\right)=0\n$$ yields\n\n$$\n\\begin{aligned}\\frac{1}{2}B{e}^{5\\lambda }+B{e}^{5\\lambda }+5B\\lambda {e}^{5\\lambda } & =0 \\\\ \\frac{3}{2}B{e}^{5\\lambda }+5B\\lambda {e}^{5\\lambda } & =0 \\\\ B{e}^{5\\lambda }+\\frac{10}{3}B\\lambda {e}^{5\\lambda } & =0 \\\\ B{e}^{5\\lambda }(1+\\frac{10}{3}\\lambda ) & =0.\\end{aligned}\n$$\n\nFor nontrivial solutions, we require $B\\ne 0.$ Thus, since ${e}^{5\\lambda }>0,$ we must have\n\n$$\n\\lambda =-\\frac{3}{10}.\n$$\n\nTherefore, the corresponding eigenfunction is\n\n$$\n\\begin{aligned}y(x) & =Bx{e}^{10\\lambda x} \\\\  & =Bx{e}^{-3x}.\\end{aligned}\n$$" "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and $$\n\\displaystyle y\\,\\left(\\frac{1}{2}\\right)+{y}^{′}\\,\\left(\\frac{1}{2}\\right)=0\n$$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-20\\lambda m+100{\\lambda }^{2} & =0 \\\\ (m-10\\lambda )(m-10\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=10\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{10\\lambda x},\\,{y}_{2}(x)=x{e}^{10\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{10\\lambda x}+Bx{e}^{10\\lambda x}.\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA+B\\cdot 0=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=Bx{e}^{10\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′}=B{e}^{10\\lambda x}+10B\\lambda x{e}^{10\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition $$\n\\displaystyle y\\,\\left(\\frac{1}{2}\\right)+{y}^{′}\\,\\left(\\frac{1}{2}\\right)=0\n$$ yields\n\n$$\n\\begin{aligned}\\frac{1}{2}B{e}^{5\\lambda }+B{e}^{5\\lambda }+5B\\lambda {e}^{5\\lambda } & =0 \\\\ \\frac{3}{2}B{e}^{5\\lambda }+5B\\lambda {e}^{5\\lambda } & =0 \\\\ B{e}^{5\\lambda }+\\frac{10}{3}B\\lambda {e}^{5\\lambda } & =0 \\\\ B{e}^{5\\lambda }\\left(1+\\frac{10}{3}\\lambda \\right) & =0.\\end{aligned}\n$$\n\nFor nontrivial solutions, we require $B\\ne 0.$ Thus, since ${e}^{5\\lambda }>0,$ we must have\n\n$$\n\\lambda =-\\frac{3}{10}.\n$$\n\nTherefore, the corresponding eigenfunction is\n\n$$\n\\begin{aligned}y(x) & =Bx{e}^{10\\lambda x} \\\\  & =Bx{e}^{-3x}.\\end{aligned}\n$$"] [:db/cas 17592186365867 :answer/value "$Bx{e}^{-x}$ and $C{e}^{x/2}(x+\\frac{3}{2})$" "$Bx{e}^{-x}$ and $C{e}^{x/2}\\left(x+\\frac{3}{2}\\right)$"] [:db/cas 17592186365942 :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(0)=1\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(0)=0.$*\n\nThe solution is \n\n$y(x)∼$  \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{2\\pi n}{3}x)+{b}_{n}\\sin \\,(\\frac{2\\pi n}{3}x))\n$$" "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(0)=1\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(0)=0.$*\n\nThe solution is \n\n$y(x)∼$  \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{2\\pi n}{3}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{2\\pi n}{3}x\\right)\\right)\n$$"] [:db/cas 17592186365942 :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{2\\pi n}{3}x)+{b}_{n}\\sin \\,(\\frac{2\\pi n}{3}x))\n$$\n\nNow, we apply the initial condition $y(0)=1.$ Using the hint that the particular solution part evaluates to zero at $x=0,$ we have\n\n$$\n\\begin{aligned}y(0) & =A{e}^{-4(0)}+{y}_{p}(0) \\\\ 1 & =A(1)+0 \\\\ A & =1.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}={e}^{-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{2\\pi n}{3}x)+{b}_{n}\\sin \\,(\\frac{2\\pi n}{3}x)).\n$$" "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{2\\pi n}{3}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{2\\pi n}{3}x\\right)\\right)\n$$\n\nNow, we apply the initial condition $y(0)=1.$ Using the hint that the particular solution part evaluates to zero at $x=0,$ we have\n\n$$\n\\begin{aligned}y(0) & =A{e}^{-4(0)}+{y}_{p}(0) \\\\ 1 & =A(1)+0 \\\\ A & =1.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}={e}^{-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼{e}^{-4x}+{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{2\\pi n}{3}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{2\\pi n}{3}x\\right)\\right).\n$$"] [:db/cas 17592186365945 :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}-5y=f(x),\\,y(3)=-2\n$$\n\nwhere $f(x)$ is a $4$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(3)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{\\pi n}{2}x)+{b}_{n}\\sin \\,(\\frac{\\pi n}{2}x))\n$$" "Consider the initial value problem\n\n$$\n{y}^{′}-5y=f(x),\\,y(3)=-2\n$$\n\nwhere $f(x)$ is a $4$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(3)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{\\pi n}{2}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{\\pi n}{2}x\\right)\\right)\n$$"] [:db/cas 17592186365945 :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}-5y=0$ is \n\n$$\n{y}_{c}=A{e}^{5x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}-5y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{5x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{\\pi n}{2}x)+{b}_{n}\\sin \\,(\\frac{\\pi n}{2}x))\n$$\n\nNow, we apply the initial condition $y(3)=-2.$ Using the hint that the particular solution part evaluates to zero at $x=3,$ we have\n\n$$\n\\begin{aligned}y(3) & =A{e}^{5(3)}+{y}_{p}(3) \\\\ -2 & =A{e}^{15}+0 \\\\ A & =-2{e}^{-15}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(-2{e}^{-15}){e}^{5x}=-2{e}^{5x-15}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-2{e}^{5x-15}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{\\pi n}{2}x)+{b}_{n}\\sin \\,(\\frac{\\pi n}{2}x)).\n$$" "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}-5y=0$ is \n\n$$\n{y}_{c}=A{e}^{5x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}-5y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{5x}+{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{\\pi n}{2}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{\\pi n}{2}x\\right)\\right)\n$$\n\nNow, we apply the initial condition $y(3)=-2.$ Using the hint that the particular solution part evaluates to zero at $x=3,$ we have\n\n$$\n\\begin{aligned}y(3) & =A{e}^{5(3)}+{y}_{p}(3) \\\\ -2 & =A{e}^{15}+0 \\\\ A & =-2{e}^{-15}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(-2{e}^{-15}){e}^{5x}=-2{e}^{5x-15}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-2{e}^{5x-15}+{\\sum }_{n=1}^{\\infty }\\left({a}_{n}\\cos \\,\\left(\\frac{\\pi n}{2}x\\right)+{b}_{n}\\sin \\,\\left(\\frac{\\pi n}{2}x\\right)\\right).\n$$"] [:db/cas 17592186365948 :question/problem "$$\n{y}^{″}+3y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=-5\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $4\\pi $-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,(\\frac{n}{2}x)\n$$" "$$\n{y}^{″}+3y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=-5\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $4\\pi $-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,\\left(\\frac{n}{2}x\\right)\n$$"] [:db/cas 17592186365948 :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,(\\frac{n}{2}x).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+3=0$ gives roots $\\lambda =\\pm \\sqrt{3}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{3}x)+B\\operatorname{sin}⁡(\\sqrt{3}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=-5.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{3}\\operatorname{cos}⁡(\\sqrt{3}x)+{\\sum }_{n=1}^{\\infty }\\frac{n}{2}{b}_{n}\\cos \\,(\\frac{n}{2}x)\n$$\n\nApplying ${y}^{′}(0)=-5$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}-5 & =B\\sqrt{3}+{\\sum }_{n=1}^{\\infty }\\frac{n}{2}{b}_{n} \\\\ B\\sqrt{3} & =-5-{\\sum }_{n=1}^{\\infty }\\frac{n}{2}{b}_{n} \\\\ B & =-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{2\\sqrt{3}}.\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{3}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{sin}⁡(\\sqrt{3}x)(-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{2\\sqrt{3}})+{\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,(\\frac{n}{2}x)\n$$" "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,\\left(\\frac{n}{2}x\\right).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+3=0$ gives roots $\\lambda =\\pm \\sqrt{3}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{3}x)+B\\operatorname{sin}⁡(\\sqrt{3}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=-5.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{3}\\operatorname{cos}⁡(\\sqrt{3}x)+{\\sum }_{n=1}^{\\infty }\\frac{n}{2}{b}_{n}\\cos \\,\\left(\\frac{n}{2}x\\right)\n$$\n\nApplying ${y}^{′}(0)=-5$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}-5 & =B\\sqrt{3}+{\\sum }_{n=1}^{\\infty }\\frac{n}{2}{b}_{n} \\\\ B\\sqrt{3} & =-5-{\\sum }_{n=1}^{\\infty }\\frac{n}{2}{b}_{n} \\\\ B & =-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{2\\sqrt{3}}.\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{3}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{sin}⁡(\\sqrt{3}x)\\left(-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{2\\sqrt{3}}\\right)+{\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,\\left(\\frac{n}{2}x\\right)\n$$"] [:db/cas 17592186365950 :answer/value "\\operatorname{sin}⁡(\\sqrt{3}x)(-\\frac{5}{\\sqrt{3}}+{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{3}})" "\\operatorname{sin}⁡(\\sqrt{3}x)\\left(-\\frac{5}{\\sqrt{3}}+{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{3}}\\right)"] [:db/cas 17592186365951 :answer/value "\\operatorname{cos}⁡(\\sqrt{3}x)(-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{3}})" "\\operatorname{cos}⁡(\\sqrt{3}x)\\left(-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{3}}\\right)"] [:db/cas 17592186365952 :answer/value "\\operatorname{sin}⁡(\\sqrt{3}x)(-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{2\\sqrt{3}})" "\\operatorname{sin}⁡(\\sqrt{3}x)\\left(-\\frac{5}{\\sqrt{3}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{2\\sqrt{3}}\\right)"] [:db/cas 17592186365984 :question/worked-solution "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 5-\\frac{1}{2}t & =0 \\\\ t & =10.\\end{aligned}\n$$\n\nSo, the extremum of the velocity function occurs when $t=10\\,\\text{s}.$\n\nWe now test the extreme values using the second derivative test. The second derivative is given by\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{\\text{d}v}{\\text{d}t}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(5-\\frac{1}{2}t) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nSince ${v}^{″}(10)<0,$ we conclude that the velocity is maximized when $t=10\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (5-\\frac{1}{2}t)\\text{d}t \\\\  & =5t-\\frac{1}{4}{t}^{2}+C.\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(4)=3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}5(4)-\\frac{1}{4}(4)^{2}+C & =3 \\\\ 20-4+C & =3\\,⟹\\,C=-13.\\end{aligned}\n$$\n\nTherefore, the velocity is given by $v(t)=5t-\\frac{1}{4}{t}^{2}-13.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(10)=5(10)-\\frac{1}{4}(10)^{2}-13=12\\,\\text{m}/\\text{s}.\n$$\n\nSo the maximum velocity ${v}_{\\text{max}}=12\\,\\text{m}/\\text{s}$ is reached at $t=10\\,\\text{s}.$" "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 5-\\frac{1}{2}t & =0 \\\\ t & =10.\\end{aligned}\n$$\n\nSo, the extremum of the velocity function occurs when $t=10\\,\\text{s}.$\n\nWe now test the extreme values using the second derivative test. The second derivative is given by\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{\\text{d}v}{\\text{d}t}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(5-\\frac{1}{2}t\\right) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nSince ${v}^{″}(10)<0,$ we conclude that the velocity is maximized when $t=10\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int \\left(5-\\frac{1}{2}t\\right)\\text{d}t \\\\  & =5t-\\frac{1}{4}{t}^{2}+C.\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(4)=3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}5(4)-\\frac{1}{4}(4)^{2}+C & =3 \\\\ 20-4+C & =3\\,⟹\\,C=-13.\\end{aligned}\n$$\n\nTherefore, the velocity is given by $v(t)=5t-\\frac{1}{4}{t}^{2}-13.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(10)=5(10)-\\frac{1}{4}(10)^{2}-13=12\\,\\text{m}/\\text{s}.\n$$\n\nSo the maximum velocity ${v}_{\\text{max}}=12\\,\\text{m}/\\text{s}$ is reached at $t=10\\,\\text{s}.$"] [:db/cas 17592186366059 :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement $⟨\\frac{6}{5},1⟩\\in \\text{Im}(T)$ is false.\nNotice that the point $(\\frac{6}{5},1)$ does not satisfy the equation of the line $5y=6x$ since $5\\cdot 1\\ne \\frac{6}{5}\\cdot 6.$ Therefore, \n$⟨\\frac{6}{5},1⟩\\notin \\text{Im}(T).$\n\n- Statement $\\text{Ker}(T)\\ne {0}$ is true.\nSince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. So, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement “$\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$” is false.\nSince  statement $\\text{Ker}(T)\\ne {0}$ is true we have that $\\text{nullity}(T)=\\text{dim(Ker}(T))\\ne 0.$" "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement $\\left\\langle \\frac{6}{5},1\\right\\rangle \\in \\text{Im}(T)$ is false.\nNotice that the point $\\left(\\frac{6}{5},1\\right)$ does not satisfy the equation of the line $5y=6x$ since $5\\cdot 1\\ne \\frac{6}{5}\\cdot 6.$ Therefore, \n$\\left\\langle \\frac{6}{5},1\\right\\rangle \\notin \\text{Im}(T).$\n\n- Statement $\\text{Ker}(T)\\ne {0}$ is true.\nSince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. So, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement “$\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$” is false.\nSince  statement $\\text{Ker}(T)\\ne {0}$ is true we have that $\\text{nullity}(T)=\\text{dim(Ker}(T))\\ne 0.$"] [:db/cas 17592186366104 :question/problem "![](images/48/48d76f34becfba9f58658c3c38ba2df0e76ad6ff20b83ffc836e213c4eea4565.png)\n\nEvaluate $$\n\\displaystyle {\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})dz\\,dy\\,dx.\n$$ The region of integration is shown above.\n\n*Hint: Change the order of integration to $\\text{d}y\\,\\text{d}z\\,\\text{d}x.$*" "![](images/48/48d76f34becfba9f58658c3c38ba2df0e76ad6ff20b83ffc836e213c4eea4565.png)\n\nEvaluate $$\n\\displaystyle {\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)dz\\,dy\\,dx.\n$$ The region of integration is shown above.\n\n*Hint: Change the order of integration to $\\text{d}y\\,\\text{d}z\\,\\text{d}x.$*"] [:db/cas 17592186366104 :question/worked-solution "We cannot integrate the given integral because we cannot find a simple antiderivative of the integrand. So, we change the order of integration.\n\nWe wish to find the limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(x),$ ${v}_{2}(x),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})dz\\,dy\\,dx={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le \\sqrt[6]{\\pi },\\,\\,{y}^{3}\\le z\\le \\sqrt{\\pi }}\n$$\n\nThe region $R$ is shown below.\n\n![](images/86/86af6e58f4f13e79bb9672cef329572f006e5f4875178ede7908bddbd0dec404.png)\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type I *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/83/83041605fcd79db34f249664b12311a4e5d797c331bcaf1279f03b5b68891b23.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region is\n\n$$\ny=0.\n$$\n\n- The right boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nz={y}^{3}\\,⟹\\,y=\\sqrt[3]{z}.\n$$\n\nTherefore, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le \\sqrt[3]{z}},\n$$\n\nas shown in the diagram below.\n\n![](images/b5/b5a3fc034b713ce5fca98fbd0cca3c454d18e42e0e73eecc7ec18c51a8e7ebb5.png)\n\nNow, we consider the projection $D$ as a type I plane region in the $xz$-plane with the bottom curve given by $z=\\sqrt[3]{0}=0.$\n\n![](images/54/54fa3b1c3a15391e0a87c15017b07594c4f2cca7fb741cd7480909a64e3d39db.png)\n\nHence,\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le \\sqrt{\\pi }}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})dz\\,dy\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}{\\int }_{0}^{\\sqrt[3]{z}}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})[{\\int }_{0}^{\\sqrt[3]{z}}{y}^{2}\\,\\text{d}y]\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2}){[\\frac{1}{3}{y}^{3}]}_{0}^{\\sqrt[3]{z}}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\frac{1}{3}z\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}[\\frac{1}{3}{\\int }_{0}^{\\sqrt{\\pi }}z\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{3}{[-\\frac{1}{2}\\operatorname{cos}⁡(\\frac{\\pi }{3}+{z}^{2})]}_{0}^{\\sqrt{\\pi }}\\,\\text{d}x \\\\  & =-\\frac{1}{6}{\\int }_{0}^{1}\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{3}\\right)\\,\\text{d}x \\\\  & =-\\frac{1}{6}{\\int }_{0}^{1}(-\\frac{1}{2}-\\frac{1}{2})\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{1}\\text{d}x \\\\  & =\\frac{1}{6}[x]_{0}^{1} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$" "We cannot integrate the given integral because we cannot find a simple antiderivative of the integrand. So, we change the order of integration.\n\nWe wish to find the limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(x),$ ${v}_{2}(x),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)dz\\,dy\\,dx={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}{y}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le \\sqrt[6]{\\pi },\\,\\,{y}^{3}\\le z\\le \\sqrt{\\pi }}\n$$\n\nThe region $R$ is shown below.\n\n![](images/86/86af6e58f4f13e79bb9672cef329572f006e5f4875178ede7908bddbd0dec404.png)\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type I *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/83/83041605fcd79db34f249664b12311a4e5d797c331bcaf1279f03b5b68891b23.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region is\n\n$$\ny=0.\n$$\n\n- The right boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nz={y}^{3}\\,⟹\\,y=\\sqrt[3]{z}.\n$$\n\nTherefore, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le \\sqrt[3]{z}},\n$$\n\nas shown in the diagram below.\n\n![](images/b5/b5a3fc034b713ce5fca98fbd0cca3c454d18e42e0e73eecc7ec18c51a8e7ebb5.png)\n\nNow, we consider the projection $D$ as a type I plane region in the $xz$-plane with the bottom curve given by $z=\\sqrt[3]{0}=0.$\n\n![](images/54/54fa3b1c3a15391e0a87c15017b07594c4f2cca7fb741cd7480909a64e3d39db.png)\n\nHence,\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le \\sqrt{\\pi }}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)dz\\,dy\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}{\\int }_{0}^{\\sqrt[3]{z}}{y}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)[{\\int }_{0}^{\\sqrt[3]{z}}{y}^{2}\\,\\text{d}y]\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right){\\left[\\frac{1}{3}{y}^{3}\\right]}_{0}^{\\sqrt[3]{z}}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\frac{1}{3}z\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\left[\\frac{1}{3}{\\int }_{0}^{\\sqrt{\\pi }}z\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)\\,\\text{d}z\\right]\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{3}{\\left[-\\frac{1}{2}\\operatorname{cos}⁡\\left(\\frac{\\pi }{3}+{z}^{2}\\right)\\right]}_{0}^{\\sqrt{\\pi }}\\,\\text{d}x \\\\  & =-\\frac{1}{6}{\\int }_{0}^{1}\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{3}\\right)\\,\\text{d}x \\\\  & =-\\frac{1}{6}{\\int }_{0}^{1}\\left(-\\frac{1}{2}-\\frac{1}{2}\\right)\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{1}\\text{d}x \\\\  & =\\frac{1}{6}[x]_{0}^{1} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$"] [:db/cas 17592186366158 :question/problem "Find the function $f(x)$ and the value of $b,$ given that $$\n\\displaystyle {\\int }_{4}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(4+\\frac{3i}{n})}^{3}\\cdot \\frac{3}{n}].\n$$" "Find the function $f(x)$ and the value of $b,$ given that $$\n\\displaystyle {\\int }_{4}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[{\\left(4+\\frac{3i}{n}\\right)}^{3}\\cdot \\frac{3}{n}\\right].\n$$"] [:db/cas 17592186366158 :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nNotice that we're given that the lower limit $a=4.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{3}{n}.$ Therefore, \n\n$$\n\\frac{3}{n}=\\frac{b-4}{n}\\,⟹\\,b=7.\n$$\n\nConsequently, ${x}_{i}=4+\\frac{3i}{n}$ and $f({x}_{i})={x}_{i}^{3}.$\n\nHence,\n\n$$\n{\\int }_{4}^{7}{x}^{3}\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(4+\\frac{3i}{n})}^{3}\\cdot \\frac{3}{n}].\n$$\n\nTherefore, the correct answer is $f(x)={x}^{3}$ and $b=7.$" "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nNotice that we're given that the lower limit $a=4.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{3}{n}.$ Therefore, \n\n$$\n\\frac{3}{n}=\\frac{b-4}{n}\\,⟹\\,b=7.\n$$\n\nConsequently, ${x}_{i}=4+\\frac{3i}{n}$ and $f({x}_{i})={x}_{i}^{3}.$\n\nHence,\n\n$$\n{\\int }_{4}^{7}{x}^{3}\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}\\left[{\\left(4+\\frac{3i}{n}\\right)}^{3}\\cdot \\frac{3}{n}\\right].\n$$\n\nTherefore, the correct answer is $f(x)={x}^{3}$ and $b=7.$"] [:db/cas 17592186366184 :question/worked-solution "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x={e}^{t},$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x={e}^{t},$ we note that\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{t}=x\\,⟹\\,\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\right)\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-3\\frac{\\text{d}y}{\\text{d}t}+2y=t-4.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous differential equation with constant coefficients and polynomial forcing. \n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is\n\n$$\n{y}_{c}(t)=A{e}^{t}+B{e}^{2t}.\n$$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=0.\n$$\n\nTo find the values of $\\alpha $ and $\\beta $ we substitute the derivatives into the differential equation for $y(t):$\n\n$$\n0-3\\alpha +2(\\alpha t+\\beta )=t-4\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n2\\alpha t+(-3\\alpha +2\\beta )=t-4.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2\\alpha &=1\\, && (\\text{equating the coefficients of }t) \\\\ -3\\alpha +2\\beta &=-4\\, && (\\text{equating the constants})\\end{aligned}\\right.\n$$\n\nHence, $\\alpha =\\frac{1}{2}$ and $\\beta =-\\frac{5}{4},$ and so the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=\\frac{1}{2}t-\\frac{5}{4}=\\frac{2t-5}{4}.\n$$\n\nNow, returning to the variable $x,$ we get\n\n$$\n{y}_{p}(x)=\\frac{2\\operatorname{ln}⁡x-5}{4}.\n$$" "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x={e}^{t},$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x={e}^{t},$ we note that\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{t}=x\\,⟹\\,\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}\\right) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\right)\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-3\\frac{\\text{d}y}{\\text{d}t}+2y=t-4.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous differential equation with constant coefficients and polynomial forcing. \n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is\n\n$$\n{y}_{c}(t)=A{e}^{t}+B{e}^{2t}.\n$$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=0.\n$$\n\nTo find the values of $\\alpha $ and $\\beta $ we substitute the derivatives into the differential equation for $y(t):$\n\n$$\n0-3\\alpha +2(\\alpha t+\\beta )=t-4\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n2\\alpha t+(-3\\alpha +2\\beta )=t-4.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2\\alpha &=1\\, && (\\text{equating the coefficients of }t) \\\\ -3\\alpha +2\\beta &=-4\\, && (\\text{equating the constants})\\end{aligned}\\right.\n$$\n\nHence, $\\alpha =\\frac{1}{2}$ and $\\beta =-\\frac{5}{4},$ and so the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=\\frac{1}{2}t-\\frac{5}{4}=\\frac{2t-5}{4}.\n$$\n\nNow, returning to the variable $x,$ we get\n\n$$\n{y}_{p}(x)=\\frac{2\\operatorname{ln}⁡x-5}{4}.\n$$"] [:db/cas 17592186366413 :question/worked-solution "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 6\\operatorname{cos}⁡(2t) & =0 \\\\ \\operatorname{cos}⁡(2t) & =0 \\\\ 2t & =\\frac{\\pi }{2}+\\pi n \\\\ t & =\\frac{\\pi }{4}+\\frac{\\pi }{2}n,\\end{aligned}\n$$\n\nwhere $n$ is any integer. \n\nTherefore, the extrema of the velocity function, for $t>0,$ are\n\n$$\nt=\\frac{\\pi }{4},\\frac{3\\pi }{4},\\frac{5\\pi }{4},…\n$$\n\nWe now test the extrema values, starting with the least, using the second derivative test. For this, we find the second derivative of $v(t):$\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{\\text{d}v}{\\text{d}t}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{cos}⁡2t) \\\\  & =-12\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nAt $t=\\frac{\\pi }{4},$ the second derivative is\n\n$$\n\\begin{aligned}{v}^{″}\\left(\\frac{\\pi }{4}\\right) & =-12\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =-12\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =-12\\cdot 1 \\\\  & =-12<0.\\end{aligned}\n$$\n\nSince ${v}^{″}\\left(\\frac{\\pi }{4}\\right)<0,$ we conclude that the velocity is maximized when $t=\\frac{\\pi }{4}.$\nTherefore, the first time when the particle reaches its maximum velocity is $t=\\frac{\\pi }{4}\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int 6\\operatorname{cos}⁡(2t)\\text{d}t \\\\  & =3\\operatorname{sin}⁡(2t)+C.\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}3\\operatorname{sin}⁡(0)+C & =1 \\\\ 0+C & =1\\,⟹\\,C=1.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=1+3\\operatorname{sin}⁡(2t).$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v\\left(\\frac{\\pi }{4}\\right)=1+3\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=4\\,\\text{m}/\\text{s}.\n$$\n\nSo the maximum velocity ${v}_{\\text{max}}=4\\,\\text{m}/\\text{s}$ is reached first time at $t=\\frac{\\pi }{4}\\,\\text{s}.$" "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 6\\operatorname{cos}⁡(2t) & =0 \\\\ \\operatorname{cos}⁡(2t) & =0 \\\\ 2t & =\\frac{\\pi }{2}+\\pi n \\\\ t & =\\frac{\\pi }{4}+\\frac{\\pi }{2}n,\\end{aligned}\n$$\n\nwhere $n$ is any integer. \n\nTherefore, the extrema of the velocity function, for $t>0,$ are\n\n$$\nt=\\frac{\\pi }{4},\\frac{3\\pi }{4},\\frac{5\\pi }{4},…\n$$\n\nWe now test the extrema values, starting with the least, using the second derivative test. For this, we find the second derivative of $v(t):$\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{\\text{d}v}{\\text{d}t}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{cos}⁡2t) \\\\  & =-12\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nAt $t=\\frac{\\pi }{4},$ the second derivative is\n\n$$\n\\begin{aligned}{v}^{″}\\left(\\frac{\\pi }{4}\\right) & =-12\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{4}\\right) \\\\  & =-12\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =-12\\cdot 1 \\\\  & =-12<0.\\end{aligned}\n$$\n\nSince ${v}^{″}\\left(\\frac{\\pi }{4}\\right)<0,$ we conclude that the velocity is maximized when $t=\\frac{\\pi }{4}.$\nTherefore, the first time when the particle reaches its maximum velocity is $t=\\frac{\\pi }{4}\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int 6\\operatorname{cos}⁡(2t)\\text{d}t \\\\  & =3\\operatorname{sin}⁡(2t)+C.\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}3\\operatorname{sin}⁡(0)+C & =1 \\\\ 0+C & =1\\,⟹\\,C=1.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=1+3\\operatorname{sin}⁡(2t).$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v\\left(\\frac{\\pi }{4}\\right)=1+3\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{4}\\right)=4\\,\\text{m}/\\text{s}.\n$$\n\nSo the maximum velocity ${v}_{\\text{max}}=4\\,\\text{m}/\\text{s}$ is reached first time at $t=\\frac{\\pi }{4}\\,\\text{s}.$"] [:db/cas 17592186366469 :question/worked-solution "The particle is stationary when $v=0\\,\\text{m}/\\text{s}.$\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ({t}^{1/3}-1)\\text{d}t \\\\  & =\\frac{3}{4}{t}^{4/3}-t+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(8)=4.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}4 & =\\frac{3}{4}(8)^{4/3}-8+C \\\\ 4 & =12-8+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=\\frac{3}{4}{t}^{4/3}-t.$\n\nNow, we find the moments in time when $v=0\\,\\text{m}/\\text{s}:$\n\n$$\n\\begin{aligned}\\frac{3}{4}{t}^{4/3}-t & =0 \\\\ t(\\frac{3}{4}{t}^{1/3}-1) & =0 \\\\ t & =0,\\frac{64}{27}.\\end{aligned}\n$$\n\nSince $t>0,$ we discard the solution $t=0.$ Therefore, the particle is stationary when $t=\\frac{64}{27}\\,\\text{s}.$" "The particle is stationary when $v=0\\,\\text{m}/\\text{s}.$\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ({t}^{1/3}-1)\\text{d}t \\\\  & =\\frac{3}{4}{t}^{4/3}-t+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(8)=4.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}4 & =\\frac{3}{4}(8)^{4/3}-8+C \\\\ 4 & =12-8+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=\\frac{3}{4}{t}^{4/3}-t.$\n\nNow, we find the moments in time when $v=0\\,\\text{m}/\\text{s}:$\n\n$$\n\\begin{aligned}\\frac{3}{4}{t}^{4/3}-t & =0 \\\\ t\\left(\\frac{3}{4}{t}^{1/3}-1\\right) & =0 \\\\ t & =0,\\frac{64}{27}.\\end{aligned}\n$$\n\nSince $t>0,$ we discard the solution $t=0.$ Therefore, the particle is stationary when $t=\\frac{64}{27}\\,\\text{s}.$"] [:db/cas 17592186366574 :question/worked-solution "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x={e}^{t},$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x={e}^{t},$ we note that\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{t}=x\\,⟹\\,\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\right)\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}+3\\frac{\\text{d}y}{\\text{d}t}-10y=5t.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous differential equation with constant coefficients and polynomial forcing. \n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is\n\n$$\n{y}_{c}(t)=\\frac{A}{{e}^{5t}}+B{e}^{2t}.\n$$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=0.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation for $y(t):$\n\n$$\n0+3\\alpha -10(\\alpha t+\\beta )=5t\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n-10\\alpha t-10\\beta +3\\alpha =t.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-10\\alpha &=5\\, && (\\text{equating the coefficients of }t) \\\\ -10\\beta +3\\alpha &=0\\, && (\\text{equating the constants}).\\end{aligned}\\right.\n$$\n\nHence, $\\alpha =-\\frac{1}{2}$ and $\\beta =-\\frac{3}{20},$ and so the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=-\\frac{t}{2}-\\frac{3}{20}.\n$$\n\nNow, returning to the variable $x,$ we get\n\n$$\n{y}_{p}(x)=-\\frac{\\operatorname{ln}⁡x}{2}-\\frac{3}{20}.\n$$" "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x={e}^{t},$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x={e}^{t},$ we note that\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{t}=x\\,⟹\\,\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}\\right) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\right)\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}\\left(\\frac{\\text{d}y}{\\text{d}t}\\right) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}+3\\frac{\\text{d}y}{\\text{d}t}-10y=5t.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous differential equation with constant coefficients and polynomial forcing. \n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is\n\n$$\n{y}_{c}(t)=\\frac{A}{{e}^{5t}}+B{e}^{2t}.\n$$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=0.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation for $y(t):$\n\n$$\n0+3\\alpha -10(\\alpha t+\\beta )=5t\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n-10\\alpha t-10\\beta +3\\alpha =t.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-10\\alpha &=5\\, && (\\text{equating the coefficients of }t) \\\\ -10\\beta +3\\alpha &=0\\, && (\\text{equating the constants}).\\end{aligned}\\right.\n$$\n\nHence, $\\alpha =-\\frac{1}{2}$ and $\\beta =-\\frac{3}{20},$ and so the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=-\\frac{t}{2}-\\frac{3}{20}.\n$$\n\nNow, returning to the variable $x,$ we get\n\n$$\n{y}_{p}(x)=-\\frac{\\operatorname{ln}⁡x}{2}-\\frac{3}{20}.\n$$"] [:db/cas 17592186366615 :question/worked-solution "First, we note the following:\n\n$$\nC:\\,\\underbrace{14{x}_{1}^{2}-6{x}_{1}{x}_{2}+6{x}_{2}^{2}}_{Q(x)}+\\sqrt{10}{x}_{1}+3\\sqrt{10}{x}_{2}=40\n$$\n\nLet's write the given change of variables explicitly: \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=-\\frac{3}{\\sqrt{10}}{y}_{1}+\\frac{1}{\\sqrt{10}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{10}}{y}_{1}+\\frac{3}{\\sqrt{10}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}14{x}_{1}^{2}-6{x}_{1}{x}_{2}+6{x}_{2}^{2}+\\sqrt{10}{x}_{1}+3\\sqrt{10}{x}_{2} & =40 \\\\ 15{y}_{1}^{2}+5{y}_{2}^{2}+\\sqrt{10}(-\\frac{3}{\\sqrt{10}}{y}_{1}+\\frac{1}{\\sqrt{10}}{y}_{2})+3\\sqrt{10}(\\frac{1}{\\sqrt{10}}{y}_{1}+\\frac{3}{\\sqrt{10}}{y}_{2}) & =40 \\\\ 15{y}_{1}^{2}+5{y}_{2}^{2}+10{y}_{2} & =40 \\\\ 3{y}_{1}^{2}+{y}_{2}^{2}+2{y}_{2} & =8\\end{aligned}\n$$\n\nNow, we complete the square for the variable ${y}_{2}:$\n\n$$\n\\begin{aligned}3{y}_{1}^{2}+{y}_{2}^{2}+2{y}_{2} & =8 \\\\ 3{y}_{1}^{2}+({y}_{2}^{2}+2{y}_{2}+1) & =8+1 \\\\ 3{y}_{1}^{2}+{({y}_{2}+1)}^{2} & =9\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}, \\\\ {z}_{2} &={y}_{2}+1,\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{z}_{1}^{2}+{z}_{2}^{2} & =9 \\\\ \\frac{{z}_{1}^{2}}{3}+\\frac{{z}_{2}^{2}}{9} & =1 \\\\ \\frac{{z}_{1}^{2}}{(\\sqrt{3})^{2}}+\\frac{{z}_{2}^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nThis represents an ellipse with semiaxes $\\sqrt{3}$ and $3.$" "First, we note the following:\n\n$$\nC:\\,\\underbrace{14{x}_{1}^{2}-6{x}_{1}{x}_{2}+6{x}_{2}^{2}}_{Q(x)}+\\sqrt{10}{x}_{1}+3\\sqrt{10}{x}_{2}=40\n$$\n\nLet's write the given change of variables explicitly: \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=-\\frac{3}{\\sqrt{10}}{y}_{1}+\\frac{1}{\\sqrt{10}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{10}}{y}_{1}+\\frac{3}{\\sqrt{10}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}14{x}_{1}^{2}-6{x}_{1}{x}_{2}+6{x}_{2}^{2}+\\sqrt{10}{x}_{1}+3\\sqrt{10}{x}_{2} & =40 \\\\ 15{y}_{1}^{2}+5{y}_{2}^{2}+\\sqrt{10}\\left(-\\frac{3}{\\sqrt{10}}{y}_{1}+\\frac{1}{\\sqrt{10}}{y}_{2}\\right)+3\\sqrt{10}\\left(\\frac{1}{\\sqrt{10}}{y}_{1}+\\frac{3}{\\sqrt{10}}{y}_{2}\\right) & =40 \\\\ 15{y}_{1}^{2}+5{y}_{2}^{2}+10{y}_{2} & =40 \\\\ 3{y}_{1}^{2}+{y}_{2}^{2}+2{y}_{2} & =8\\end{aligned}\n$$\n\nNow, we complete the square for the variable ${y}_{2}:$\n\n$$\n\\begin{aligned}3{y}_{1}^{2}+{y}_{2}^{2}+2{y}_{2} & =8 \\\\ 3{y}_{1}^{2}+({y}_{2}^{2}+2{y}_{2}+1) & =8+1 \\\\ 3{y}_{1}^{2}+{({y}_{2}+1)}^{2} & =9\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}, \\\\ {z}_{2} &={y}_{2}+1,\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{z}_{1}^{2}+{z}_{2}^{2} & =9 \\\\ \\frac{{z}_{1}^{2}}{3}+\\frac{{z}_{2}^{2}}{9} & =1 \\\\ \\frac{{z}_{1}^{2}}{(\\sqrt{3})^{2}}+\\frac{{z}_{2}^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nThis represents an ellipse with semiaxes $\\sqrt{3}$ and $3.$"] [:db/cas 17592186366622 :question/worked-solution "First, we note the following:\n\n$$\nC:\\,\\underbrace{{x}_{1}^{2}-8{x}_{1}{x}_{2}-5{x}_{2}^{2}}_{Q(x)}-12\\sqrt{5}{x}_{1}+6\\sqrt{5}{x}_{2}+12=0\n$$\n\nLet's write the given change of variables explicitly:\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=-\\frac{2}{\\sqrt{5}}{y}_{1}+\\frac{1}{\\sqrt{5}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}{x}_{1}^{2}-8{x}_{1}{x}_{2}-5{x}_{2}^{2}-12\\sqrt{5}{x}_{1}+6\\sqrt{5}{x}_{2}+12 & =0 \\\\ 3{y}_{1}^{2}-7{y}_{2}^{2}-12\\sqrt{5}(-\\frac{2}{\\sqrt{5}}{y}_{1}+\\frac{1}{\\sqrt{5}}{y}_{2})+6\\sqrt{5}(\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2})+12 & =0 \\\\ 3{y}_{1}^{2}-7{y}_{2}^{2}+30{y}_{1}+12 & =0\\end{aligned}\n$$\n\n \n\nNow, we complete the square for the variable ${y}_{1}:$\n\n$$\n\\begin{aligned}3{y}_{1}^{2}-7{y}_{2}^{2}+30{y}_{1}+12 & =0 \\\\ 3({y}_{1}^{2}+10{y}_{1})-7{y}_{2}^{2}+12 & =0 \\\\ 3({y}_{1}^{2}+10{y}_{1}+25-25)-7{y}_{2}^{2}+12 & =0 \\\\ 3({y}_{1}^{2}+10{y}_{1}+25)-75-7{y}_{2}^{2}+12 & =0 \\\\ 3({y}_{1}+5)^{2}-7{y}_{2}^{2}-63 & =0 \\\\ 3({y}_{1}+5)^{2}-7{y}_{2}^{2} & =63\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}+5, \\\\ {z}_{2} &={y}_{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{z}_{1}^{2}-7{z}_{2}^{2} & =63 \\\\ \\frac{{z}_{1}^{2}}{21}-\\frac{{z}_{2}^{2}}{9} & =1 \\\\ \\frac{{z}_{1}^{2}}{(\\sqrt{21})^{2}}-\\frac{{z}_{2}^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\n \n\nThis represents a hyperbola with semiaxes  $\\sqrt{21}$ and $3.$" "First, we note the following:\n\n$$\nC:\\,\\underbrace{{x}_{1}^{2}-8{x}_{1}{x}_{2}-5{x}_{2}^{2}}_{Q(x)}-12\\sqrt{5}{x}_{1}+6\\sqrt{5}{x}_{2}+12=0\n$$\n\nLet's write the given change of variables explicitly:\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=-\\frac{2}{\\sqrt{5}}{y}_{1}+\\frac{1}{\\sqrt{5}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}{x}_{1}^{2}-8{x}_{1}{x}_{2}-5{x}_{2}^{2}-12\\sqrt{5}{x}_{1}+6\\sqrt{5}{x}_{2}+12 & =0 \\\\ 3{y}_{1}^{2}-7{y}_{2}^{2}-12\\sqrt{5}\\left(-\\frac{2}{\\sqrt{5}}{y}_{1}+\\frac{1}{\\sqrt{5}}{y}_{2}\\right)+6\\sqrt{5}\\left(\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2}\\right)+12 & =0 \\\\ 3{y}_{1}^{2}-7{y}_{2}^{2}+30{y}_{1}+12 & =0\\end{aligned}\n$$\n\n \n\nNow, we complete the square for the variable ${y}_{1}:$\n\n$$\n\\begin{aligned}3{y}_{1}^{2}-7{y}_{2}^{2}+30{y}_{1}+12 & =0 \\\\ 3({y}_{1}^{2}+10{y}_{1})-7{y}_{2}^{2}+12 & =0 \\\\ 3({y}_{1}^{2}+10{y}_{1}+25-25)-7{y}_{2}^{2}+12 & =0 \\\\ 3({y}_{1}^{2}+10{y}_{1}+25)-75-7{y}_{2}^{2}+12 & =0 \\\\ 3({y}_{1}+5)^{2}-7{y}_{2}^{2}-63 & =0 \\\\ 3({y}_{1}+5)^{2}-7{y}_{2}^{2} & =63\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}+5, \\\\ {z}_{2} &={y}_{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{z}_{1}^{2}-7{z}_{2}^{2} & =63 \\\\ \\frac{{z}_{1}^{2}}{21}-\\frac{{z}_{2}^{2}}{9} & =1 \\\\ \\frac{{z}_{1}^{2}}{(\\sqrt{21})^{2}}-\\frac{{z}_{2}^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\n \n\nThis represents a hyperbola with semiaxes  $\\sqrt{21}$ and $3.$"] [:db/cas 17592186366629 :question/worked-solution "First, we note the following:\n\n$$\nC:\\,\\underbrace{{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}}_{Q(x)}+4\\sqrt{2}{x}_{1}=4\n$$\n\nLet's write the given change of variables explicitly:\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=\\frac{1}{\\sqrt{2}}{y}_{1}-\\frac{1}{\\sqrt{2}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{2}}{y}_{1}+\\frac{1}{\\sqrt{2}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain \n\n$$\n\\begin{aligned}{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}+4\\sqrt{2}{x}_{1} & =4 \\\\ 2{y}_{1}^{2}+4\\sqrt{2}(\\frac{1}{\\sqrt{2}}{y}_{1}-\\frac{1}{\\sqrt{2}}{y}_{2}) & =4 \\\\ 2{y}_{1}^{2}+4{y}_{1}-4{y}_{2} & =4\\end{aligned}\n$$\n\n \n\nNow, we complete the square for the variable ${y}_{1}:$ \n\n$$\n\\begin{aligned}2{y}_{1}^{2}+4{y}_{1}-4{y}_{2} & =4 \\\\ 2({y}_{1}^{2}+2{y}_{1})-4{y}_{2} & =4 \\\\ 2({y}_{1}^{2}+2{y}_{1}+1-1)-4{y}_{2} & =4 \\\\ 2({y}_{1}+1)^{2}-2\\cdot 1-4{y}_{2} & =4 \\\\ 2({y}_{1}+1)^{2} & =4{y}_{2}+6 \\\\ 2({y}_{1}+1)^{2} & =4({y}_{2}+\\frac{3}{2})\\end{aligned}\n$$\n\nFinally, performing the change of variables \n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}+1, \\\\ {z}_{2} &={y}_{2}+\\frac{3}{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}2({y}_{1}+1)^{2} & =4({y}_{2}+\\frac{3}{2}) \\\\ 2{z}_{1}^{2} & =4{z}_{2} \\\\ {z}_{1}^{2} & =2{z}_{2}\\end{aligned}\n$$\n\n \n\nThis represents a parabola that opens in the direction of the positive ${z}_{2}$-axis." "First, we note the following:\n\n$$\nC:\\,\\underbrace{{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}}_{Q(x)}+4\\sqrt{2}{x}_{1}=4\n$$\n\nLet's write the given change of variables explicitly:\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=\\frac{1}{\\sqrt{2}}{y}_{1}-\\frac{1}{\\sqrt{2}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{2}}{y}_{1}+\\frac{1}{\\sqrt{2}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain \n\n$$\n\\begin{aligned}{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}+4\\sqrt{2}{x}_{1} & =4 \\\\ 2{y}_{1}^{2}+4\\sqrt{2}\\left(\\frac{1}{\\sqrt{2}}{y}_{1}-\\frac{1}{\\sqrt{2}}{y}_{2}\\right) & =4 \\\\ 2{y}_{1}^{2}+4{y}_{1}-4{y}_{2} & =4\\end{aligned}\n$$\n\n \n\nNow, we complete the square for the variable ${y}_{1}:$ \n\n$$\n\\begin{aligned}2{y}_{1}^{2}+4{y}_{1}-4{y}_{2} & =4 \\\\ 2({y}_{1}^{2}+2{y}_{1})-4{y}_{2} & =4 \\\\ 2({y}_{1}^{2}+2{y}_{1}+1-1)-4{y}_{2} & =4 \\\\ 2({y}_{1}+1)^{2}-2\\cdot 1-4{y}_{2} & =4 \\\\ 2({y}_{1}+1)^{2} & =4{y}_{2}+6 \\\\ 2({y}_{1}+1)^{2} & =4\\left({y}_{2}+\\frac{3}{2}\\right)\\end{aligned}\n$$\n\nFinally, performing the change of variables \n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}+1, \\\\ {z}_{2} &={y}_{2}+\\frac{3}{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}2({y}_{1}+1)^{2} & =4\\left({y}_{2}+\\frac{3}{2}\\right) \\\\ 2{z}_{1}^{2} & =4{z}_{2} \\\\ {z}_{1}^{2} & =2{z}_{2}\\end{aligned}\n$$\n\n \n\nThis represents a parabola that opens in the direction of the positive ${z}_{2}$-axis."] [:db/cas 17592186366732 :question/worked-solution "First, we complete the squares for the variable ${x}_{1}:$\n\n$$\n\\begin{aligned}3{x}_{1}^{2}-2{x}_{1}+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3({x}_{1}^{2}-\\frac{2}{3}{x}_{1})+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3({x}_{1}^{2}-\\frac{2}{3}{x}_{1}+{\\left(\\frac{1}{3}\\right)}^{2}-{\\left(\\frac{1}{3}\\right)}^{2})+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3{({x}_{1}-\\frac{1}{3})}^{2}-3{\\left(\\frac{1}{3}\\right)}^{2}+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3{({x}_{1}-\\frac{1}{3})}^{2}-\\frac{1}{3}+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3{({x}_{1}-\\frac{1}{3})}^{2}+4{x}_{2}^{2} & =\\frac{36}{3} \\\\ 3{({x}_{1}-\\frac{1}{3})}^{2}+4{x}_{2}^{2} & =12\\end{aligned}\n$$\n\nNow, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}-\\frac{1}{3}, \\\\ {y}_{2} &={x}_{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{y}_{1}^{2}+4{y}_{2}^{2} & =12 \\\\ \\frac{{y}_{1}^{2}}{4}+\\frac{{y}_{2}^{2}}{3} & =1 \\\\ \\frac{{y}_{1}^{2}}{{2}^{2}}+\\frac{{y}_{2}^{2}}{(\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\n \n\nThis represents an ellipse with semiaxes $2$ and $\\sqrt{3}.$" "First, we complete the squares for the variable ${x}_{1}:$\n\n$$\n\\begin{aligned}3{x}_{1}^{2}-2{x}_{1}+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3\\left({x}_{1}^{2}-\\frac{2}{3}{x}_{1}\\right)+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3\\left({x}_{1}^{2}-\\frac{2}{3}{x}_{1}+{\\left(\\frac{1}{3}\\right)}^{2}-{\\left(\\frac{1}{3}\\right)}^{2}\\right)+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3{\\left({x}_{1}-\\frac{1}{3}\\right)}^{2}-3{\\left(\\frac{1}{3}\\right)}^{2}+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3{\\left({x}_{1}-\\frac{1}{3}\\right)}^{2}-\\frac{1}{3}+4{x}_{2}^{2} & =\\frac{35}{3} \\\\ 3{\\left({x}_{1}-\\frac{1}{3}\\right)}^{2}+4{x}_{2}^{2} & =\\frac{36}{3} \\\\ 3{\\left({x}_{1}-\\frac{1}{3}\\right)}^{2}+4{x}_{2}^{2} & =12\\end{aligned}\n$$\n\nNow, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}-\\frac{1}{3}, \\\\ {y}_{2} &={x}_{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{y}_{1}^{2}+4{y}_{2}^{2} & =12 \\\\ \\frac{{y}_{1}^{2}}{4}+\\frac{{y}_{2}^{2}}{3} & =1 \\\\ \\frac{{y}_{1}^{2}}{{2}^{2}}+\\frac{{y}_{2}^{2}}{(\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\n \n\nThis represents an ellipse with semiaxes $2$ and $\\sqrt{3}.$"] [:db/cas 17592186366801 :question/worked-solution "First, we make $x$ the subject:\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{x+1} \\\\ {y}^{3} & =x+1 \\\\ x & ={y}^{3}-1\\end{aligned}\n$$\n\nNow, to find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{3}-1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{3}\\,\\text{d}y-{\\int }_{0}^{1}\\,\\text{d}y \\\\  & ={\\frac{{y}^{4}}{4}|}_{0}^{1}-y{|}_{0}^{1} \\\\  & =(\\frac{1}{4}-0)-(1-0) \\\\  & =\\frac{1}{4}-1 \\\\  & =-\\frac{3}{4}\\end{aligned}\n$$\n\nWe obtained a negative number because the region lies to the left of the $y$-axis. So the area that we want is $|-\\frac{3}{4}|=\\frac{3}{4}.$" "First, we make $x$ the subject:\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{x+1} \\\\ {y}^{3} & =x+1 \\\\ x & ={y}^{3}-1\\end{aligned}\n$$\n\nNow, to find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{3}-1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{3}\\,\\text{d}y-{\\int }_{0}^{1}\\,\\text{d}y \\\\  & ={\\frac{{y}^{4}}{4}|}_{0}^{1}-y{|}_{0}^{1} \\\\  & =\\left(\\frac{1}{4}-0\\right)-(1-0) \\\\  & =\\frac{1}{4}-1 \\\\  & =-\\frac{3}{4}\\end{aligned}\n$$\n\nWe obtained a negative number because the region lies to the left of the $y$-axis. So the area that we want is $|-\\frac{3}{4}|=\\frac{3}{4}.$"] [:db/cas 17592186366815 :question/problem "Given the function $f(x,y,z)=6{x}^{2}-y+{z}^{3}$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(\\frac{1}{2},3,2).$" "Given the function $f(x,y,z)=6{x}^{2}-y+{z}^{3}$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=\\left(\\frac{1}{2},3,2\\right).$"] [:db/cas 17592186366815 :question/worked-solution "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(\\frac{1}{2},3,2):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(6{x}^{2}-y+{z}^{3})\\text{ }i+\\frac{∂}{∂y}(6{x}^{2}-y+{z}^{3})\\text{ }j+\\frac{∂}{∂z}(6{x}^{2}-y+{z}^{3})\\text{ }k \\\\  & =12x\\text{ }i-\\text{ }j+3{z}^{2}k \\\\ ∇\\,f(\\frac{1}{2},3,2) & =12\\cdot \\frac{1}{2}\\text{ }i-\\text{ }j+3(2)^{2}k \\\\  & =6\\,i-\\,j+12k \\\\  & =⟨6,-1,12⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(\\frac{1}{2},3,2)\\cdot ⟨x-\\frac{1}{2},\\,y-3,\\,z-2⟩ & =0 \\\\ ⟨6,-1,12⟩\\cdot ⟨x-\\frac{1}{2},\\,y-3,\\,z-2⟩ & =0 \\\\ 6(x-\\frac{1}{2})-(y-3)+12(z-2) & =0 \\\\ 6x-y+12z-24 & =0\\end{aligned}\n$$" "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=\\left(\\frac{1}{2},3,2\\right):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(6{x}^{2}-y+{z}^{3})\\text{ }i+\\frac{∂}{∂y}(6{x}^{2}-y+{z}^{3})\\text{ }j+\\frac{∂}{∂z}(6{x}^{2}-y+{z}^{3})\\text{ }k \\\\  & =12x\\text{ }i-\\text{ }j+3{z}^{2}k \\\\ ∇\\,f\\left(\\frac{1}{2},3,2\\right) & =12\\cdot \\frac{1}{2}\\text{ }i-\\text{ }j+3(2)^{2}k \\\\  & =6\\,i-\\,j+12k \\\\  & =⟨6,-1,12⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f\\left(\\frac{1}{2},3,2\\right)\\cdot \\left\\langle x-\\frac{1}{2},\\,y-3,\\,z-2\\right\\rangle  & =0 \\\\ ⟨6,-1,12⟩\\cdot \\left\\langle x-\\frac{1}{2},\\,y-3,\\,z-2\\right\\rangle  & =0 \\\\ 6\\left(x-\\frac{1}{2}\\right)-(y-3)+12(z-2) & =0 \\\\ 6x-y+12z-24 & =0\\end{aligned}\n$$"] [:db/cas 17592186366836 :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following linearity properties for curl:\n\n- $∇\\times (kF)=k∇\\times F$\n\n- $∇\\times (F+G)=∇\\times F+∇\\times G$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\times (F-G) & =∇\\times F-∇\\times G.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\times F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\times F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ \\operatorname{ln}⁡z & 0 & xy\\end{vmatrix} \\\\  & =[\\frac{∂}{∂y}(xy)-\\frac{∂}{∂z}(0)]i-[\\frac{∂}{∂x}(xy)-\\frac{∂}{∂z}(\\operatorname{ln}⁡z)]j+[\\frac{∂}{∂x}(0)-\\frac{∂}{∂y}(\\operatorname{ln}⁡z)]k \\\\  & =(x-0)i-(y-\\frac{1}{z})j+(0-0)k \\\\  & =x\\,i+(\\frac{1}{z}-y)j.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\times (F-G) & =∇\\times F-∇\\times G \\\\  & =x\\,i+(\\frac{1}{z}-y)j-[-i+2z\\,j-x\\,k] \\\\  & =x\\,i+(\\frac{1}{z}-y)j+i-2z\\,j+x\\,k \\\\  & =(x+1)\\,i+(\\frac{1}{z}-y-2z)j+x\\,k.\\end{aligned}\n$$\n\nFinally, evaluating at the point $(0,2,1),$ we get\n\n$$\n\\begin{aligned}(∇\\times (F-G))(0,2,1) & =(0+1)\\,i+(\\frac{1}{1}-2-2(1))j+0\\,k \\\\  & =i-3\\,j.\\end{aligned}\n$$" "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following linearity properties for curl:\n\n- $∇\\times (kF)=k∇\\times F$\n\n- $∇\\times (F+G)=∇\\times F+∇\\times G$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\times (F-G) & =∇\\times F-∇\\times G.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\times F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\times F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ \\operatorname{ln}⁡z & 0 & xy\\end{vmatrix} \\\\  & =\\left[\\frac{∂}{∂y}(xy)-\\frac{∂}{∂z}(0)\\right]i-\\left[\\frac{∂}{∂x}(xy)-\\frac{∂}{∂z}(\\operatorname{ln}⁡z)\\right]j+\\left[\\frac{∂}{∂x}(0)-\\frac{∂}{∂y}(\\operatorname{ln}⁡z)\\right]k \\\\  & =(x-0)i-\\left(y-\\frac{1}{z}\\right)j+(0-0)k \\\\  & =x\\,i+\\left(\\frac{1}{z}-y\\right)j.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\times (F-G) & =∇\\times F-∇\\times G \\\\  & =x\\,i+\\left(\\frac{1}{z}-y\\right)j-[-i+2z\\,j-x\\,k] \\\\  & =x\\,i+\\left(\\frac{1}{z}-y\\right)j+i-2z\\,j+x\\,k \\\\  & =(x+1)\\,i+\\left(\\frac{1}{z}-y-2z\\right)j+x\\,k.\\end{aligned}\n$$\n\nFinally, evaluating at the point $(0,2,1),$ we get\n\n$$\n\\begin{aligned}(∇\\times (F-G))(0,2,1) & =(0+1)\\,i+\\left(\\frac{1}{1}-2-2(1)\\right)j+0\\,k \\\\  & =i-3\\,j.\\end{aligned}\n$$"] [:db/cas 17592186366843 :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following linearity properties for curl:\n\n- $∇\\times (kF)=k∇\\times F$\n\n- $∇\\times (F+G)=∇\\times F+∇\\times G$\n\nFirst, we need to calculate $∇\\times F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\times F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ -3 & z & 8\\sqrt{x}\\end{vmatrix} \\\\  & =[\\frac{∂}{∂y}(8\\sqrt{x})-\\frac{∂}{∂z}(z)]i-[\\frac{∂}{∂x}(8\\sqrt{x})-\\frac{∂}{∂z}(-3)]j+[\\frac{∂}{∂x}(z)-\\frac{∂}{∂y}(-3)]k \\\\  & =(0-1)i-(\\frac{4}{\\sqrt{x}}-0)j+(0-0)k \\\\  & =-i-\\frac{4}{\\sqrt{x}}\\,j.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\times (F+G) & =∇\\times F+∇\\times G \\\\  & =-i-\\frac{4}{\\sqrt{x}}\\,j+[-i-j] \\\\  & =-i-\\frac{4}{\\sqrt{x}}\\,j-i-j \\\\  & =-2\\,i-(\\frac{4}{\\sqrt{x}}+1)j.\\end{aligned}\n$$\n\nFinally, evaluating at the point $(4,3,-1),$ we get\n\n$$\n\\begin{aligned}(∇\\times (F+G))(4,3,-1) & =-2\\,i-(\\frac{4}{\\sqrt{4}}+1)j \\\\  & =-2\\,i-3\\,j.\\end{aligned}\n$$" "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following linearity properties for curl:\n\n- $∇\\times (kF)=k∇\\times F$\n\n- $∇\\times (F+G)=∇\\times F+∇\\times G$\n\nFirst, we need to calculate $∇\\times F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\times F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ -3 & z & 8\\sqrt{x}\\end{vmatrix} \\\\  & =\\left[\\frac{∂}{∂y}(8\\sqrt{x})-\\frac{∂}{∂z}(z)\\right]i-\\left[\\frac{∂}{∂x}(8\\sqrt{x})-\\frac{∂}{∂z}(-3)\\right]j+\\left[\\frac{∂}{∂x}(z)-\\frac{∂}{∂y}(-3)\\right]k \\\\  & =(0-1)i-\\left(\\frac{4}{\\sqrt{x}}-0\\right)j+(0-0)k \\\\  & =-i-\\frac{4}{\\sqrt{x}}\\,j.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\times (F+G) & =∇\\times F+∇\\times G \\\\  & =-i-\\frac{4}{\\sqrt{x}}\\,j+[-i-j] \\\\  & =-i-\\frac{4}{\\sqrt{x}}\\,j-i-j \\\\  & =-2\\,i-\\left(\\frac{4}{\\sqrt{x}}+1\\right)j.\\end{aligned}\n$$\n\nFinally, evaluating at the point $(4,3,-1),$ we get\n\n$$\n\\begin{aligned}(∇\\times (F+G))(4,3,-1) & =-2\\,i-\\left(\\frac{4}{\\sqrt{4}}+1\\right)j \\\\  & =-2\\,i-3\\,j.\\end{aligned}\n$$"] [:db/cas 17592186367156 :question/worked-solution "First, let's add a $Y=\\frac{{X}^{4}}{4}$ row to our table.\n\n| $x$ | $-2$ | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $4$ | $\\frac{1}{4}$ | $0$ | $\\frac{1}{4}$ |\n| ${f}_{X}(x)$ | $0.1$ | $0.2$ | $0.3$ | $0.4$ |\n\nFrom the table, we see that $Y\\in {0,\\frac{1}{4},4}.$ Notice that we now have two columns for $Y=\\frac{1}{4}.$\n\nWe calculate the probabilities associated with each value of $Y$ as follows:\n\n$$\n\\begin{aligned}P(Y=0) & =0.3 \\\\ P(Y=\\frac{1}{4}) & =0.2+0.4 \\\\ P(Y=4) & =0.1\\end{aligned}\n$$\n\nThis gives the following table.\n\n| $y$ | $0$ | $\\frac{1}{4}$ | $4$ |\n| --- | --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.3$ | $0.6$ | $0.1$ |\n\nTherefore, $b=4,c=0.6,$ and $b+c=4.6.$" "First, let's add a $Y=\\frac{{X}^{4}}{4}$ row to our table.\n\n| $x$ | $-2$ | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $4$ | $\\frac{1}{4}$ | $0$ | $\\frac{1}{4}$ |\n| ${f}_{X}(x)$ | $0.1$ | $0.2$ | $0.3$ | $0.4$ |\n\nFrom the table, we see that $Y\\in {0,\\frac{1}{4},4}.$ Notice that we now have two columns for $Y=\\frac{1}{4}.$\n\nWe calculate the probabilities associated with each value of $Y$ as follows:\n\n$$\n\\begin{aligned}P(Y=0) & =0.3 \\\\ P\\left(Y=\\frac{1}{4}\\right) & =0.2+0.4 \\\\ P(Y=4) & =0.1\\end{aligned}\n$$\n\nThis gives the following table.\n\n| $y$ | $0$ | $\\frac{1}{4}$ | $4$ |\n| --- | --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.3$ | $0.6$ | $0.1$ |\n\nTherefore, $b=4,c=0.6,$ and $b+c=4.6.$"] [:db/cas 17592186367163 :question/worked-solution "We can use the double-angle formula for cosine:\n\n$$\n{\\cos }^{2}⁡\\theta -{\\sin }^{2}⁡\\theta =\\operatorname{cos}⁡2\\theta \n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int (2x-{\\cos }^{2}⁡x+{\\sin }^{2}⁡x)\\text{d}x & =\\int (2x-[{\\cos }^{2}⁡x-{\\sin }^{2}⁡x])\\text{d}x \\\\  & =\\int (2x-\\operatorname{cos}⁡2x)\\text{d}x \\\\  & =2(\\frac{1}{2}{x}^{2})-\\frac{1}{2}\\operatorname{sin}⁡2x+C \\\\  & ={x}^{2}-\\frac{1}{2}\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$" "We can use the double-angle formula for cosine:\n\n$$\n{\\cos }^{2}⁡\\theta -{\\sin }^{2}⁡\\theta =\\operatorname{cos}⁡2\\theta \n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int (2x-{\\cos }^{2}⁡x+{\\sin }^{2}⁡x)\\text{d}x & =\\int (2x-[{\\cos }^{2}⁡x-{\\sin }^{2}⁡x])\\text{d}x \\\\  & =\\int (2x-\\operatorname{cos}⁡2x)\\text{d}x \\\\  & =2\\left(\\frac{1}{2}{x}^{2}\\right)-\\frac{1}{2}\\operatorname{sin}⁡2x+C \\\\  & ={x}^{2}-\\frac{1}{2}\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$"] [:db/cas 17592186367170 :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{\\text{d}}{\\text{d}t}(\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2}) & =\\frac{\\text{d}}{\\text{d}t}(1) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{y}^{2}}{2}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}\\left(\\frac{{y}^{2}}{2}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\left(\\frac{2x}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot y & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=4$ and $x=-3.$ We get\n\n$$\n\\begin{aligned}4\\cdot (-2)-\\frac{\\text{d}y}{\\text{d}t}\\cdot y & =0 \\\\ -8-\\frac{\\text{d}y}{\\text{d}t}\\cdot y & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=-3$ into the equation of the hyperbola.\n\nAt the point where $x=-3,$ we have\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{(-3)^{2}}{3}-\\frac{{y}^{2}}{2} & =1 \\\\ 3-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{{y}^{2}}{2} & =2 \\\\ {y}^{2} & =4 \\\\ y & =2.\\end{aligned}\n$$\n\nNote that we used $y>0$ since we're only interested in the second quadrant.\n\n Finally, substituting $y=2,$ we get\n\n$$\n\\begin{aligned}-8-\\frac{\\text{d}y}{\\text{d}t}\\cdot 2 & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =-4.\\end{aligned}\n$$" "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2}\\right) & =\\frac{\\text{d}}{\\text{d}t}(1) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{y}^{2}}{2}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}\\left(\\frac{{y}^{2}}{2}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\left(\\frac{2x}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot y & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=4$ and $x=-3.$ We get\n\n$$\n\\begin{aligned}4\\cdot (-2)-\\frac{\\text{d}y}{\\text{d}t}\\cdot y & =0 \\\\ -8-\\frac{\\text{d}y}{\\text{d}t}\\cdot y & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=-3$ into the equation of the hyperbola.\n\nAt the point where $x=-3,$ we have\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{(-3)^{2}}{3}-\\frac{{y}^{2}}{2} & =1 \\\\ 3-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{{y}^{2}}{2} & =2 \\\\ {y}^{2} & =4 \\\\ y & =2.\\end{aligned}\n$$\n\nNote that we used $y>0$ since we're only interested in the second quadrant.\n\n Finally, substituting $y=2,$ we get\n\n$$\n\\begin{aligned}-8-\\frac{\\text{d}y}{\\text{d}t}\\cdot 2 & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =-4.\\end{aligned}\n$$"] [:db/cas 17592186367177 :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{1}{x}+\\operatorname{ln}⁡(y) & =2 \\\\ \\frac{\\text{d}}{\\text{d}t}(\\frac{1}{x}+\\operatorname{ln}⁡(y)) & =\\frac{\\text{d}}{\\text{d}t}(2) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{x}\\right)+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(y)) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(\\operatorname{ln}⁡(y)) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\left(-\\frac{1}{{x}^{2}}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{1}{y}\\right) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=2$ and $x=\\frac{1}{2}.$ We get\n\n$$\n\\begin{aligned}(2)\\cdot \\left(-\\frac{1}{{\\left(\\frac{1}{2}\\right)}^{2}}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{1}{y}\\right) & =0 \\\\ -8+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{1}{y}\\right) & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=\\frac{1}{2}$ into the equation of the curve.\n\nAt the point where $x=\\frac{1}{2},$ we have\n\n$$\n\\begin{aligned}\\frac{1}{x}+\\operatorname{ln}⁡(y) & =2 \\\\ 2+\\operatorname{ln}⁡(y) & =2 \\\\ \\operatorname{ln}⁡(y) & =0 \\\\ y & =1.\\end{aligned}\n$$\n\nFinally, substituting $y=1,$ we get  \n\n$$\n\\begin{aligned}-8+\\frac{\\text{d}y}{\\text{d}t}\\cdot (1) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =8.\\end{aligned}\n$$" "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{1}{x}+\\operatorname{ln}⁡(y) & =2 \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{x}+\\operatorname{ln}⁡(y)\\right) & =\\frac{\\text{d}}{\\text{d}t}(2) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{x}\\right)+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(y)) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{x}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(\\operatorname{ln}⁡(y)) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\left(-\\frac{1}{{x}^{2}}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{1}{y}\\right) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=2$ and $x=\\frac{1}{2}.$ We get\n\n$$\n\\begin{aligned}(2)\\cdot \\left(-\\frac{1}{{\\left(\\frac{1}{2}\\right)}^{2}}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{1}{y}\\right) & =0 \\\\ -8+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{1}{y}\\right) & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=\\frac{1}{2}$ into the equation of the curve.\n\nAt the point where $x=\\frac{1}{2},$ we have\n\n$$\n\\begin{aligned}\\frac{1}{x}+\\operatorname{ln}⁡(y) & =2 \\\\ 2+\\operatorname{ln}⁡(y) & =2 \\\\ \\operatorname{ln}⁡(y) & =0 \\\\ y & =1.\\end{aligned}\n$$\n\nFinally, substituting $y=1,$ we get  \n\n$$\n\\begin{aligned}-8+\\frac{\\text{d}y}{\\text{d}t}\\cdot (1) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =8.\\end{aligned}\n$$"] [:db/cas 17592186367184 :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨3,\\frac{1}{2\\sqrt{t-2}}⟩,\\,t>2.\n$$\n\nGiven that the particle has velocity $v=⟨15,1⟩$ when $t=11,$ calculate the times at which the particle is stationary." "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=\\left\\langle 3,\\frac{1}{2\\sqrt{t-2}}\\right\\rangle ,\\,t>2.\n$$\n\nGiven that the particle has velocity $v=⟨15,1⟩$ when $t=11,$ calculate the times at which the particle is stationary."] [:db/cas 17592186367184 :question/worked-solution "The particle is stationary when its velocity is zero. So first, we need to compute the velocity of the particle.\n\nTo compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨3,\\frac{1}{2\\sqrt{t-2}}⟩\\text{d}t \\\\  & =⟨\\int 3\\,\\text{d}t,\\int \\frac{1}{2\\sqrt{t-2}}\\,\\text{d}t⟩ \\\\  & =⟨3t+{C}_{1},\\sqrt{t-2}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(11)=⟨15,1⟩.$ Substituting $t=11,$ we get\n\n$$\n\\begin{aligned}v(11) & =⟨3(11)+{C}_{1},\\sqrt{11-2}+{C}_{2}⟩ \\\\ ⟨15,1⟩ & =⟨33+{C}_{1},3+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=-18$ and ${C}_{2}=-2.$ Therefore, the velocity is given by\n\n$$\n\\begin{aligned}v(t) & =⟨3t-18,\\sqrt{t-2}-2⟩.\\end{aligned}\n$$\n\nTo find the times at which the particle is stationary, we solve for the times at which the velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨3t-18,\\sqrt{t-2}-2⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}3t-18=3(t-6) & =0\\,⇒\\,t=6, \\\\ \\sqrt{t-2}-2 & =0\\,⇒\\,t=6.\\end{aligned}\n$$\n\nThe only solution that satisfies both equations is $t=6,$ so this is the only value of $t$ when the particle is stationary." "The particle is stationary when its velocity is zero. So first, we need to compute the velocity of the particle.\n\nTo compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\left\\langle 3,\\frac{1}{2\\sqrt{t-2}}\\right\\rangle \\text{d}t \\\\  & =\\left\\langle \\int 3\\,\\text{d}t,\\int \\frac{1}{2\\sqrt{t-2}}\\,\\text{d}t\\right\\rangle  \\\\  & =⟨3t+{C}_{1},\\sqrt{t-2}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(11)=⟨15,1⟩.$ Substituting $t=11,$ we get\n\n$$\n\\begin{aligned}v(11) & =⟨3(11)+{C}_{1},\\sqrt{11-2}+{C}_{2}⟩ \\\\ ⟨15,1⟩ & =⟨33+{C}_{1},3+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=-18$ and ${C}_{2}=-2.$ Therefore, the velocity is given by\n\n$$\n\\begin{aligned}v(t) & =⟨3t-18,\\sqrt{t-2}-2⟩.\\end{aligned}\n$$\n\nTo find the times at which the particle is stationary, we solve for the times at which the velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨3t-18,\\sqrt{t-2}-2⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}3t-18=3(t-6) & =0\\,⇒\\,t=6, \\\\ \\sqrt{t-2}-2 & =0\\,⇒\\,t=6.\\end{aligned}\n$$\n\nThe only solution that satisfies both equations is $t=6,$ so this is the only value of $t$ when the particle is stationary."] [:db/cas 17592186367191 :question/worked-solution "![](images/30/30e0e58a17f1683f1c6ca58ea8e4d3df97d7edb76676b0ed6d1a75f62d0c0803.png)\n\nSince the acceleration of the particle $P$ is $\\sqrt[3]{3{x}^{2}+2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\sqrt[3]{3{x}^{2}+2}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=\\sqrt[3]{3{x}^{2}+2}.\\end{aligned}\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we have\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=\\sqrt[3]{3{x}^{2}+2}.\\,\\,(∗)\n$$\n\nFinally, using the fact that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({v}^{2})=2v\\frac{\\text{d}v}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=v\\frac{\\text{d}v}{\\text{d}x},\n$$\n\nwe can write our differential equation $(∗)$ as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=\\sqrt[3]{3{x}^{2}+2}.\n$$" "![](images/30/30e0e58a17f1683f1c6ca58ea8e4d3df97d7edb76676b0ed6d1a75f62d0c0803.png)\n\nSince the acceleration of the particle $P$ is $\\sqrt[3]{3{x}^{2}+2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\sqrt[3]{3{x}^{2}+2}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=\\sqrt[3]{3{x}^{2}+2}.\\end{aligned}\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we have\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=\\sqrt[3]{3{x}^{2}+2}.\\,\\,(∗)\n$$\n\nFinally, using the fact that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({v}^{2})=2v\\frac{\\text{d}v}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=v\\frac{\\text{d}v}{\\text{d}x},\n$$\n\nwe can write our differential equation $(∗)$ as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=\\sqrt[3]{3{x}^{2}+2}.\n$$"] [:db/cas 17592186367193 :answer/value "\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=\\sqrt[3]{3{x}^{2}+2}" "\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{2}{v}^{2}\\right)=\\sqrt[3]{3{x}^{2}+2}"] [:db/cas 17592186367197 :answer/value "\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{v}^{2})=\\sqrt[3]{3{x}^{2}+2}" "\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{4}{v}^{2}\\right)=\\sqrt[3]{3{x}^{2}+2}"] [:db/cas 17592186367219 :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}5t-7 \\\\ -1-10t \\\\ \\frac{1}{4}t+\\frac{3}{5}\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{bmatrix}+\\begin{bmatrix}5t \\\\ -10t \\\\ \\frac{1}{4}t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{bmatrix}+t\\begin{bmatrix}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{bmatrix} \\\\ r & =\\begin{bmatrix}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{bmatrix}+t\\begin{bmatrix}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the straight line passes through the point $(-7,-1,\\frac{3}{5})$ and is parallel to the vector $v=\\begin{bmatrix}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{bmatrix}.$" "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}5t-7 \\\\ -1-10t \\\\ \\frac{1}{4}t+\\frac{3}{5}\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{bmatrix}+\\begin{bmatrix}5t \\\\ -10t \\\\ \\frac{1}{4}t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{bmatrix}+t\\begin{bmatrix}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{bmatrix} \\\\ r & =\\begin{bmatrix}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{bmatrix}+t\\begin{bmatrix}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the straight line passes through the point $\\left(-7,-1,\\frac{3}{5}\\right)$ and is parallel to the vector $v=\\begin{bmatrix}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{bmatrix}.$"] [:db/cas 17592186367247 :question/worked-solution "First, recall that\n\n$$\n\\lim_{t\\to 0}f(t)=(\\lim_{t\\to 0}(1-{t}^{2}))i+(\\lim_{t\\to 0}\\frac{1}{t-1})j+(\\lim_{t\\to 0}\\sqrt{t-1})k.\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{t\\to 0}(1-{t}^{2}) & =1-{0}^{2}=1.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{t\\to 0}\\frac{1}{t-1}=\\frac{1}{0-1}=-1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{t\\to 0}\\sqrt{1-t} & =\\sqrt{1-0}=1.\\end{aligned}\n$$\n\nHence, $\\lim_{t\\to 0}f(t)=i-j+k.$" "First, recall that\n\n$$\n\\lim_{t\\to 0}f(t)=(\\lim_{t\\to 0}(1-{t}^{2}))i+\\left(\\lim_{t\\to 0}\\frac{1}{t-1}\\right)j+(\\lim_{t\\to 0}\\sqrt{t-1})k.\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{t\\to 0}(1-{t}^{2}) & =1-{0}^{2}=1.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{t\\to 0}\\frac{1}{t-1}=\\frac{1}{0-1}=-1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{t\\to 0}\\sqrt{1-t} & =\\sqrt{1-0}=1.\\end{aligned}\n$$\n\nHence, $\\lim_{t\\to 0}f(t)=i-j+k.$"] [:db/cas 17592186367275 :question/problem "Calculate $\\lim_{s\\to 2}||f(s)||,$ if $f(s)=⟨{e}^{s-2},\\,\\sqrt{6-s},\\,\\frac{3}{s+2}⟩.$" "Calculate $\\lim_{s\\to 2}||f(s)||,$ if $f(s)=\\left\\langle {e}^{s-2},\\,\\sqrt{6-s},\\,\\frac{3}{s+2}\\right\\rangle .$"] [:db/cas 17592186367275 :question/worked-solution "First, recall that\n\n$$\n\\lim_{s\\to 2}f(s)=⟨\\lim_{s\\to 2}{e}^{s-2},\\,\\lim_{s\\to 2}\\sqrt{6-s},\\,\\lim_{s\\to 2}\\frac{3}{s+2}⟩.\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}{e}^{s-2} & ={e}^{2-2} \\\\  & ={e}^{0} \\\\  & =1.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\sqrt{6-s} & =\\sqrt{6-2} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\frac{3}{s+2} & =\\frac{3}{2+2} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nHence, $\\lim_{s\\to 2}f(s)=⟨1,2,\\frac{3}{4}⟩.$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $2$ is\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}‖f(s)‖ & =‖\\lim_{s\\to 2}f(s)‖ \\\\  & =‖⟨1,2,\\frac{3}{4}⟩‖ \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{\\left(\\frac{3}{4}\\right)}^{2}} \\\\  & =\\sqrt{1+4+\\frac{9}{16}} \\\\  & =\\sqrt{\\frac{89}{16}} \\\\  & =\\frac{\\sqrt{89}}{4}.\\end{aligned}\n$$" "First, recall that\n\n$$\n\\lim_{s\\to 2}f(s)=\\left\\langle \\lim_{s\\to 2}{e}^{s-2},\\,\\lim_{s\\to 2}\\sqrt{6-s},\\,\\lim_{s\\to 2}\\frac{3}{s+2}\\right\\rangle .\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}{e}^{s-2} & ={e}^{2-2} \\\\  & ={e}^{0} \\\\  & =1.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\sqrt{6-s} & =\\sqrt{6-2} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\frac{3}{s+2} & =\\frac{3}{2+2} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nHence, $\\lim_{s\\to 2}f(s)=\\left\\langle 1,2,\\frac{3}{4}\\right\\rangle .$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $2$ is\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}‖f(s)‖ & =‖\\lim_{s\\to 2}f(s)‖ \\\\  & =‖\\left\\langle 1,2,\\frac{3}{4}\\right\\rangle ‖ \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{\\left(\\frac{3}{4}\\right)}^{2}} \\\\  & =\\sqrt{1+4+\\frac{9}{16}} \\\\  & =\\sqrt{\\frac{89}{16}} \\\\  & =\\frac{\\sqrt{89}}{4}.\\end{aligned}\n$$"] [:db/cas 17592186367282 :question/problem "Calculate $\\lim_{s\\to 2}||f(s)||,$ if $f(s)=⟨\\frac{5}{{e}^{s-2}},\\,3\\operatorname{cos}⁡(4-2s),\\,{s}^{3}-5⟩.$" "Calculate $\\lim_{s\\to 2}||f(s)||,$ if $f(s)=\\left\\langle \\frac{5}{{e}^{s-2}},\\,3\\operatorname{cos}⁡(4-2s),\\,{s}^{3}-5\\right\\rangle .$"] [:db/cas 17592186367282 :question/worked-solution "First, recall that\n\n$$\n\\lim_{s\\to 2}f(s)=⟨\\lim_{s\\to 2}\\frac{5}{{e}^{s-2}},\\,\\lim_{s\\to 2}3\\operatorname{cos}⁡(4-2s),\\,\\lim_{s\\to 2}\\,({s}^{3}-5)⟩.\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\frac{5}{{e}^{s-2}} & =\\frac{5}{{e}^{0}}=5.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}3\\operatorname{cos}⁡(4-2s) & =3\\lim_{s\\to 2}\\operatorname{cos}⁡(4-2s) \\\\  & =3\\cdot \\operatorname{cos}⁡(4-2(0)) \\\\  & =3\\cdot \\operatorname{cos}⁡0 \\\\  & =3.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\,({s}^{3}-5) & ={2}^{3}-5=3.\\end{aligned}\n$$\n\nHence, $\\lim_{s\\to 2}f(s)=⟨5,3,3⟩.$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $2$ is\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}‖f(s)‖ & =‖\\lim_{s\\to 2}f(s)‖ \\\\  & =‖⟨5,3,3⟩‖ \\\\  & =\\sqrt{{5}^{2}+{3}^{2}+{3}^{2}} \\\\  & =\\sqrt{25+9+9} \\\\  & =\\sqrt{43}.\\end{aligned}\n$$" "First, recall that\n\n$$\n\\lim_{s\\to 2}f(s)=\\left\\langle \\lim_{s\\to 2}\\frac{5}{{e}^{s-2}},\\,\\lim_{s\\to 2}3\\operatorname{cos}⁡(4-2s),\\,\\lim_{s\\to 2}\\,({s}^{3}-5)\\right\\rangle .\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\frac{5}{{e}^{s-2}} & =\\frac{5}{{e}^{0}}=5.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}3\\operatorname{cos}⁡(4-2s) & =3\\lim_{s\\to 2}\\operatorname{cos}⁡(4-2s) \\\\  & =3\\cdot \\operatorname{cos}⁡(4-2(0)) \\\\  & =3\\cdot \\operatorname{cos}⁡0 \\\\  & =3.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}\\,({s}^{3}-5) & ={2}^{3}-5=3.\\end{aligned}\n$$\n\nHence, $\\lim_{s\\to 2}f(s)=⟨5,3,3⟩.$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $2$ is\n\n$$\n\\begin{aligned}\\lim_{s\\to 2}‖f(s)‖ & =‖\\lim_{s\\to 2}f(s)‖ \\\\  & =‖⟨5,3,3⟩‖ \\\\  & =\\sqrt{{5}^{2}+{3}^{2}+{3}^{2}} \\\\  & =\\sqrt{25+9+9} \\\\  & =\\sqrt{43}.\\end{aligned}\n$$"] [:db/cas 17592186367289 :question/problem "Find $\\lim_{t\\to 2}[f(t)+g(t)]$ given that $f(t)$ and $g(t)$ are defined as\n\n$$\n\\begin{aligned}f(t) & =⟨6-{t}^{3},\\,{t}^{2}-6,\\,\\frac{2}{{t}^{3}}⟩, \\\\ g(t) & =⟨5-\\operatorname{ln}⁡(3-t),\\,\\sqrt{6-t},\\,2t⟩\\end{aligned}\n$$" "Find $\\lim_{t\\to 2}[f(t)+g(t)]$ given that $f(t)$ and $g(t)$ are defined as\n\n$$\n\\begin{aligned}f(t) & =\\left\\langle 6-{t}^{3},\\,{t}^{2}-6,\\,\\frac{2}{{t}^{3}}\\right\\rangle , \\\\ g(t) & =⟨5-\\operatorname{ln}⁡(3-t),\\,\\sqrt{6-t},\\,2t⟩\\end{aligned}\n$$"] [:db/cas 17592186367289 :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}\\lim_{t\\to 2}f(t) & =⟨\\lim_{t\\to 2}\\,(6-{t}^{3}),\\,\\lim_{t\\to 2}\\,({t}^{2}-6),\\,\\lim_{t\\to 2}\\frac{2}{{t}^{3}}⟩ \\\\  & =⟨6-{2}^{3},{2}^{2}-6,\\frac{2}{{2}^{3}}⟩ \\\\  & =⟨-2,-2,\\frac{1}{4}⟩ \\\\ \\lim_{t\\to 2}g(t) & =⟨\\lim_{t\\to 2}\\,(5-\\operatorname{ln}⁡(3-t)),\\,\\lim_{t\\to 2}\\,\\sqrt{6-t},\\,\\lim_{t\\to 2}\\,(2t)⟩ \\\\  & =⟨5-\\operatorname{ln}⁡(3-2),\\sqrt{6-2},2(2)⟩ \\\\  & =⟨5,2,4⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}\\lim_{t\\to 2}[f(t)+g(t)] & =\\lim_{t\\to 2}f(t)+\\lim_{t\\to 2}g(t) \\\\  & =⟨-2,-2,\\frac{1}{4}⟩+⟨5,2,4⟩ \\\\  & =⟨-2+5,-2+2,\\frac{1}{4}+4⟩ \\\\  & =⟨3,0,\\frac{17}{4}⟩\\end{aligned}\n$$" "First, we find the limit of each function:\n\n$$\n\\begin{aligned}\\lim_{t\\to 2}f(t) & =\\left\\langle \\lim_{t\\to 2}\\,(6-{t}^{3}),\\,\\lim_{t\\to 2}\\,({t}^{2}-6),\\,\\lim_{t\\to 2}\\frac{2}{{t}^{3}}\\right\\rangle  \\\\  & =\\left\\langle 6-{2}^{3},{2}^{2}-6,\\frac{2}{{2}^{3}}\\right\\rangle  \\\\  & =\\left\\langle -2,-2,\\frac{1}{4}\\right\\rangle  \\\\ \\lim_{t\\to 2}g(t) & =⟨\\lim_{t\\to 2}\\,(5-\\operatorname{ln}⁡(3-t)),\\,\\lim_{t\\to 2}\\,\\sqrt{6-t},\\,\\lim_{t\\to 2}\\,(2t)⟩ \\\\  & =⟨5-\\operatorname{ln}⁡(3-2),\\sqrt{6-2},2(2)⟩ \\\\  & =⟨5,2,4⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}\\lim_{t\\to 2}[f(t)+g(t)] & =\\lim_{t\\to 2}f(t)+\\lim_{t\\to 2}g(t) \\\\  & =\\left\\langle -2,-2,\\frac{1}{4}\\right\\rangle +⟨5,2,4⟩ \\\\  & =\\left\\langle -2+5,-2+2,\\frac{1}{4}+4\\right\\rangle  \\\\  & =\\left\\langle 3,0,\\frac{17}{4}\\right\\rangle \\end{aligned}\n$$"] [:db/cas 17592186367292 :answer/value "⟨3,0,\\frac{17}{4}⟩" "\\left\\langle 3,0,\\frac{17}{4}\\right\\rangle "] [:db/cas 17592186367294 :answer/value "⟨-7,4,\\frac{7}{4}⟩" "\\left\\langle -7,4,\\frac{7}{4}\\right\\rangle "] [:db/cas 17592186367295 :answer/value "⟨-2,-2,\\frac{1}{4}⟩" "\\left\\langle -2,-2,\\frac{1}{4}\\right\\rangle "] [:db/cas 17592186367296 :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}\\lim_{t\\to \\,-1}f(t) & =(\\lim_{t\\to \\,-1}{t}^{3})i+(\\lim_{t\\to \\,-1}{t}^{2})j+(\\lim_{t\\to \\,-1}\\operatorname{ln}⁡(t+2))k \\\\  & =(-1)^{3}\\,i+(-1)^{2}\\,j+\\operatorname{ln}⁡(-1+2)\\,k \\\\  & =-i+j \\\\ \\lim_{t\\to \\,-1}g(t) & =(\\lim_{t\\to \\,-1}\\frac{2}{t})i+(\\lim_{t\\to \\,-1}(3-t))j-(\\lim_{t\\to \\,-1}({t}^{2}-1))k \\\\  & =\\frac{2}{(-1)}\\,i+(3-(-1))\\,j-((-1)^{2}-1)k \\\\  & =-2\\,i+4\\,j\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}\\lim_{t\\to \\,-1}[4f(t)-7g(t)] & =\\lim_{t\\to \\,-1}4f(t)-\\lim_{t\\to \\,-1}7g(t) \\\\  & =4\\lim_{t\\to \\,-1}f(t)-7\\lim_{t\\to \\,-1}g(t) \\\\  & =4(-i+j)-7(-2\\,i+4\\,j) \\\\  & =-4\\,i+4\\,j+14\\,i-28\\,j \\\\  & =10\\,i-24\\,j\\end{aligned}\n$$" "First, we find the limit of each function:\n\n$$\n\\begin{aligned}\\lim_{t\\to \\,-1}f(t) & =(\\lim_{t\\to \\,-1}{t}^{3})i+(\\lim_{t\\to \\,-1}{t}^{2})j+(\\lim_{t\\to \\,-1}\\operatorname{ln}⁡(t+2))k \\\\  & =(-1)^{3}\\,i+(-1)^{2}\\,j+\\operatorname{ln}⁡(-1+2)\\,k \\\\  & =-i+j \\\\ \\lim_{t\\to \\,-1}g(t) & =\\left(\\lim_{t\\to \\,-1}\\frac{2}{t}\\right)i+(\\lim_{t\\to \\,-1}(3-t))j-(\\lim_{t\\to \\,-1}({t}^{2}-1))k \\\\  & =\\frac{2}{(-1)}\\,i+(3-(-1))\\,j-((-1)^{2}-1)k \\\\  & =-2\\,i+4\\,j\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}\\lim_{t\\to \\,-1}[4f(t)-7g(t)] & =\\lim_{t\\to \\,-1}4f(t)-\\lim_{t\\to \\,-1}7g(t) \\\\  & =4\\lim_{t\\to \\,-1}f(t)-7\\lim_{t\\to \\,-1}g(t) \\\\  & =4(-i+j)-7(-2\\,i+4\\,j) \\\\  & =-4\\,i+4\\,j+14\\,i-28\\,j \\\\  & =10\\,i-24\\,j\\end{aligned}\n$$"] [:db/cas 17592186367366 :question/problem "Calculate $∇\\cdot (\\frac{1}{2}F+4G)$ for the vector fields $F$ and $G,$ where\n\n$$\nF={x}^{2}{y}^{3}\\,i+{y}^{2}\\operatorname{ln}⁡x\\,j,\\,∇\\cdot G=-\\frac{1}{2}y\\operatorname{ln}⁡(x).\n$$" "Calculate $∇\\cdot \\left(\\frac{1}{2}F+4G\\right)$ for the vector fields $F$ and $G,$ where\n\n$$\nF={x}^{2}{y}^{3}\\,i+{y}^{2}\\operatorname{ln}⁡x\\,j,\\,∇\\cdot G=-\\frac{1}{2}y\\operatorname{ln}⁡(x).\n$$"] [:db/cas 17592186367366 :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F+4G) & =∇\\cdot (\\frac{1}{2}F)+∇\\cdot (4G) \\\\  & =\\frac{1}{2}∇\\cdot F+4∇\\cdot G.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({x}^{2}{y}^{3})+\\frac{∂}{∂y}({y}^{2}\\operatorname{ln}⁡x) \\\\  & =2x{y}^{3}+2y\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F+2G) & =\\frac{1}{2}∇\\cdot F+4∇\\cdot G \\\\  & =\\frac{1}{2}(2x{y}^{3}+2y\\operatorname{ln}⁡x)+4\\cdot (-\\frac{1}{2}y\\operatorname{ln}⁡x) \\\\  & =x{y}^{3}+y\\operatorname{ln}⁡x-2y\\operatorname{ln}⁡x \\\\  & =x{y}^{3}-y\\operatorname{ln}⁡x.\\end{aligned}\n$$" "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot \\left(\\frac{1}{2}F+4G\\right) & =∇\\cdot \\left(\\frac{1}{2}F\\right)+∇\\cdot (4G) \\\\  & =\\frac{1}{2}∇\\cdot F+4∇\\cdot G.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({x}^{2}{y}^{3})+\\frac{∂}{∂y}({y}^{2}\\operatorname{ln}⁡x) \\\\  & =2x{y}^{3}+2y\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot \\left(\\frac{1}{2}F+2G\\right) & =\\frac{1}{2}∇\\cdot F+4∇\\cdot G \\\\  & =\\frac{1}{2}(2x{y}^{3}+2y\\operatorname{ln}⁡x)+4\\cdot \\left(-\\frac{1}{2}y\\operatorname{ln}⁡x\\right) \\\\  & =x{y}^{3}+y\\operatorname{ln}⁡x-2y\\operatorname{ln}⁡x \\\\  & =x{y}^{3}-y\\operatorname{ln}⁡x.\\end{aligned}\n$$"] [:db/cas 17592186367394 :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following linearity properties for curl:\n\n- $∇\\times (kF)=k∇\\times F$\n\n- $∇\\times (F+G)=∇\\times F+∇\\times G$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\times (2F+G) & =∇\\times (2G)+∇\\times G \\\\  & =2∇\\times F+∇\\times G\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\times F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\times F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 2\\sqrt{y} & z & yz\\end{vmatrix} \\\\  & =[\\frac{∂}{∂y}(yz)-\\frac{∂}{∂z}(z)]i-[\\frac{∂}{∂x}(yz)-\\frac{∂}{∂z}(2\\sqrt{y})]j+[\\frac{∂}{∂x}(z)-\\frac{∂}{∂y}(2\\sqrt{y})]k \\\\  & =(z-1)i-(0-0)j+(0-\\frac{1}{\\sqrt{y}})k \\\\  & =(z-1)\\,i-\\frac{1}{\\sqrt{y}}\\,k.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\times (2F+G) & =2∇\\times F+∇\\times G \\\\  & =2[(z-1)\\,i-\\frac{1}{\\sqrt{y}}\\,k]+x\\,i-y\\,j+\\,k \\\\  & =(x+2z-2)\\,i-y\\,j+(1-\\frac{2}{\\sqrt{y}})\\,k.\\end{aligned}\n$$\n\nFinally, evaluating at the point $(-1,1,4),$ we get\n\n$$\n(∇\\times (2F+G))(-1,1,4)=5\\,i-\\,j-\\,k\n$$" "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following linearity properties for curl:\n\n- $∇\\times (kF)=k∇\\times F$\n\n- $∇\\times (F+G)=∇\\times F+∇\\times G$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\times (2F+G) & =∇\\times (2G)+∇\\times G \\\\  & =2∇\\times F+∇\\times G\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\times F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\times F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 2\\sqrt{y} & z & yz\\end{vmatrix} \\\\  & =\\left[\\frac{∂}{∂y}(yz)-\\frac{∂}{∂z}(z)\\right]i-\\left[\\frac{∂}{∂x}(yz)-\\frac{∂}{∂z}(2\\sqrt{y})\\right]j+\\left[\\frac{∂}{∂x}(z)-\\frac{∂}{∂y}(2\\sqrt{y})\\right]k \\\\  & =(z-1)i-(0-0)j+\\left(0-\\frac{1}{\\sqrt{y}}\\right)k \\\\  & =(z-1)\\,i-\\frac{1}{\\sqrt{y}}\\,k.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\times (2F+G) & =2∇\\times F+∇\\times G \\\\  & =2\\left[(z-1)\\,i-\\frac{1}{\\sqrt{y}}\\,k\\right]+x\\,i-y\\,j+\\,k \\\\  & =(x+2z-2)\\,i-y\\,j+\\left(1-\\frac{2}{\\sqrt{y}}\\right)\\,k.\\end{aligned}\n$$\n\nFinally, evaluating at the point $(-1,1,4),$ we get\n\n$$\n(∇\\times (2F+G))(-1,1,4)=5\\,i-\\,j-\\,k\n$$"] [:db/cas 17592186367415 :question/worked-solution "The curvature $κ$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖$:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t,\\,{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t⟩ \\\\  & ={e}^{-t}⟨-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & ={e}^{-t}\\sqrt{{(-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}} \\\\  & ={e}^{-t}\\sqrt{{\\cos }^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{\\sin }^{2}⁡t+{\\cos }^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{\\sin }^{2}⁡t} \\\\  & ={e}^{-t}\\sqrt{2({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)} \\\\  & =\\sqrt{2}{e}^{-t}\\end{aligned}\n$$\n\nNow, we find the second derivative:\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨2{e}^{-t}\\operatorname{sin}⁡t,\\,-2{e}^{-t}\\operatorname{cos}⁡t⟩ \\\\  & =2{e}^{-t}⟨\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(t)$ and ${r}^{″}(t)$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(t)\\times {r}^{″}(t) & =({e}^{-t}⟨-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0⟩)\\times (2{e}^{-t}⟨\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t,\\,0⟩) \\\\  & =2{e}^{-2t}\\,\\begin{vmatrix}i & j & k \\\\ -\\operatorname{cos}⁡t-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & 0 \\\\ \\operatorname{sin}⁡t & -\\operatorname{cos}⁡t & 0\\end{vmatrix} \\\\  & =2{e}^{-2t}\\,\\begin{vmatrix}-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{sin}⁡t & -\\operatorname{cos}⁡t\\end{vmatrix}\\,k \\\\  & =2{e}^{-2t}({\\cos }^{2}⁡t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{\\sin }^{2}⁡t)k \\\\  & =2{e}^{-2t}\\,k\\end{aligned}\n$$\n\nSo, the magnitude of the cross product is\n\n$$\n‖{r}^{′}(t)\\times {r}^{″}(t)‖=2{e}^{-2t}.\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{2{e}^{-2t}}{{(\\sqrt{2}{e}^{-t})}^{3}} \\\\  & =\\frac{2{e}^{-2t}}{2\\sqrt{2}{e}^{-3t}} \\\\  & =\\frac{\\sqrt{2}{e}^{t}}{2}.\\end{aligned}\n$$" "The curvature $κ$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖$:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{sin}⁡t)\\right\\rangle  \\\\  & =⟨-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t,\\,{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t⟩ \\\\  & ={e}^{-t}⟨-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & ={e}^{-t}\\sqrt{{(-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}} \\\\  & ={e}^{-t}\\sqrt{{\\cos }^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{\\sin }^{2}⁡t+{\\cos }^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{\\sin }^{2}⁡t} \\\\  & ={e}^{-t}\\sqrt{2({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)} \\\\  & =\\sqrt{2}{e}^{-t}\\end{aligned}\n$$\n\nNow, we find the second derivative:\n\n$$\n\\begin{aligned}{r}^{″}(t) & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t)\\right\\rangle  \\\\  & =⟨2{e}^{-t}\\operatorname{sin}⁡t,\\,-2{e}^{-t}\\operatorname{cos}⁡t⟩ \\\\  & =2{e}^{-t}⟨\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(t)$ and ${r}^{″}(t)$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(t)\\times {r}^{″}(t) & =({e}^{-t}⟨-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0⟩)\\times (2{e}^{-t}⟨\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t,\\,0⟩) \\\\  & =2{e}^{-2t}\\,\\begin{vmatrix}i & j & k \\\\ -\\operatorname{cos}⁡t-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & 0 \\\\ \\operatorname{sin}⁡t & -\\operatorname{cos}⁡t & 0\\end{vmatrix} \\\\  & =2{e}^{-2t}\\,\\begin{vmatrix}-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{sin}⁡t & -\\operatorname{cos}⁡t\\end{vmatrix}\\,k \\\\  & =2{e}^{-2t}({\\cos }^{2}⁡t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{\\sin }^{2}⁡t)k \\\\  & =2{e}^{-2t}\\,k\\end{aligned}\n$$\n\nSo, the magnitude of the cross product is\n\n$$\n‖{r}^{′}(t)\\times {r}^{″}(t)‖=2{e}^{-2t}.\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{2{e}^{-2t}}{{(\\sqrt{2}{e}^{-t})}^{3}} \\\\  & =\\frac{2{e}^{-2t}}{2\\sqrt{2}{e}^{-3t}} \\\\  & =\\frac{\\sqrt{2}{e}^{t}}{2}.\\end{aligned}\n$$"] [:db/cas 17592186367470 :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3-{t}^{2})=-2t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+4t)=2t+4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{{(-2t)}^{2}+{(2t+4)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{4{t}^{2}+4{t}^{2}+16t+16}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{8{t}^{2}+16t+16}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{16(\\frac{{t}^{2}}{2}+t+1)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\cdot 4\\cdot \\sqrt{(\\frac{{t}^{2}}{2}+t+1)}\\,\\text{d}t \\\\  & =8\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{\\frac{{t}^{2}}{2}+t+1}\\,\\text{d}t.\\end{aligned}\n$$" "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3-{t}^{2})=-2t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+4t)=2t+4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{{(-2t)}^{2}+{(2t+4)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{4{t}^{2}+4{t}^{2}+16t+16}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{8{t}^{2}+16t+16}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{16\\left(\\frac{{t}^{2}}{2}+t+1\\right)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(3-{t}^{2})\\cdot 4\\cdot \\sqrt{\\left(\\frac{{t}^{2}}{2}+t+1\\right)}\\,\\text{d}t \\\\  & =8\\pi {\\int }_{0}^{1}(3-{t}^{2})\\sqrt{\\frac{{t}^{2}}{2}+t+1}\\,\\text{d}t.\\end{aligned}\n$$"] [:db/cas 17592186367484 :question/worked-solution "Newton's second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nThe resultant force $F$ acting on $P$ equals the sum of the forces acting on $P.$ Therefore,\n\n$$\n\\begin{aligned}F & ={F}_{1}+{F}_{2} \\\\  & =⟨2,\\,4{\\sin }^{3}⁡t⟩+⟨8\\operatorname{sin}⁡2t-2,\\,4\\operatorname{sin}⁡t{\\cos }^{2}⁡t⟩ \\\\  & =⟨2+8\\operatorname{sin}⁡2t-2,\\,4{\\sin }^{3}⁡t+4\\operatorname{sin}⁡t{\\cos }^{2}⁡t)⟩ \\\\  & =⟨8\\operatorname{sin}⁡2t,\\,4\\operatorname{sin}⁡t({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)⟩ \\\\  & =⟨8\\operatorname{sin}⁡2t,\\,4\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nBy Newton's second law, we have\n\n$$\n\\begin{aligned}a & =\\frac{F}{m} \\\\  & =\\frac{1}{4}\\cdot ⟨8\\operatorname{sin}⁡2t,\\,4\\operatorname{sin}⁡t⟩ \\\\  & =⟨2\\operatorname{sin}⁡2t,\\,\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nTo compute the velocity vector $v,$ we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v & =\\int a\\,\\text{d}t \\\\  & =\\int ⟨2\\operatorname{sin}⁡2t,\\,\\operatorname{sin}⁡t⟩\\,\\text{d}t \\\\  & =⟨\\int 2\\operatorname{sin}⁡2t\\,\\text{d}t,\\,\\int \\operatorname{sin}⁡t\\,\\text{d}t⟩ \\\\  & =⟨-\\operatorname{cos}⁡2t,\\,-\\operatorname{cos}⁡t⟩+C\\end{aligned}\n$$\n\nwhere $C$ is a (vector) constant of integration. \n\nWe can solve for $C$ by substituting $v=⟨0,\\,-1⟩\\,\\text{m/s}$ and $t=0\\,\\text{s}$ into the above, as follows:\n\n$$\n\\begin{aligned}⟨0,\\,-1⟩ & =⟨-\\operatorname{cos}⁡(2\\cdot 0),\\,-\\operatorname{cos}⁡0⟩+C \\\\ ⟨0,\\,-1⟩ & =⟨-1,\\,-1⟩+C \\\\ C & =⟨1,\\,0⟩\\end{aligned}\n$$\n\nTherefore, the velocity of $P$ at time $t$ is given by\n\n$$\n\\begin{aligned}v & =⟨-\\operatorname{cos}⁡2t,\\,-\\operatorname{cos}⁡t⟩+⟨1,\\,0⟩ \\\\  & =⟨1-\\operatorname{cos}⁡2t,\\,-\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nFinally  the velocity at $t=\\frac{\\pi }{2}$ equals\n\n$$\n\\begin{aligned}v\\left(\\frac{\\pi }{2}\\right) & =⟨1-\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}),\\,-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)⟩ \\\\  & =⟨2,\\,0⟩.\\end{aligned}\n$$" "Newton's second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nThe resultant force $F$ acting on $P$ equals the sum of the forces acting on $P.$ Therefore,\n\n$$\n\\begin{aligned}F & ={F}_{1}+{F}_{2} \\\\  & =⟨2,\\,4{\\sin }^{3}⁡t⟩+⟨8\\operatorname{sin}⁡2t-2,\\,4\\operatorname{sin}⁡t{\\cos }^{2}⁡t⟩ \\\\  & =⟨2+8\\operatorname{sin}⁡2t-2,\\,4{\\sin }^{3}⁡t+4\\operatorname{sin}⁡t{\\cos }^{2}⁡t)⟩ \\\\  & =⟨8\\operatorname{sin}⁡2t,\\,4\\operatorname{sin}⁡t({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)⟩ \\\\  & =⟨8\\operatorname{sin}⁡2t,\\,4\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nBy Newton's second law, we have\n\n$$\n\\begin{aligned}a & =\\frac{F}{m} \\\\  & =\\frac{1}{4}\\cdot ⟨8\\operatorname{sin}⁡2t,\\,4\\operatorname{sin}⁡t⟩ \\\\  & =⟨2\\operatorname{sin}⁡2t,\\,\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nTo compute the velocity vector $v,$ we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v & =\\int a\\,\\text{d}t \\\\  & =\\int ⟨2\\operatorname{sin}⁡2t,\\,\\operatorname{sin}⁡t⟩\\,\\text{d}t \\\\  & =⟨\\int 2\\operatorname{sin}⁡2t\\,\\text{d}t,\\,\\int \\operatorname{sin}⁡t\\,\\text{d}t⟩ \\\\  & =⟨-\\operatorname{cos}⁡2t,\\,-\\operatorname{cos}⁡t⟩+C\\end{aligned}\n$$\n\nwhere $C$ is a (vector) constant of integration. \n\nWe can solve for $C$ by substituting $v=⟨0,\\,-1⟩\\,\\text{m/s}$ and $t=0\\,\\text{s}$ into the above, as follows:\n\n$$\n\\begin{aligned}⟨0,\\,-1⟩ & =⟨-\\operatorname{cos}⁡(2\\cdot 0),\\,-\\operatorname{cos}⁡0⟩+C \\\\ ⟨0,\\,-1⟩ & =⟨-1,\\,-1⟩+C \\\\ C & =⟨1,\\,0⟩\\end{aligned}\n$$\n\nTherefore, the velocity of $P$ at time $t$ is given by\n\n$$\n\\begin{aligned}v & =⟨-\\operatorname{cos}⁡2t,\\,-\\operatorname{cos}⁡t⟩+⟨1,\\,0⟩ \\\\  & =⟨1-\\operatorname{cos}⁡2t,\\,-\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nFinally  the velocity at $t=\\frac{\\pi }{2}$ equals\n\n$$\n\\begin{aligned}v\\left(\\frac{\\pi }{2}\\right) & =\\left\\langle 1-\\operatorname{cos}⁡\\left(2\\cdot \\frac{\\pi }{2}\\right),\\,-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)\\right\\rangle  \\\\  & =⟨2,\\,0⟩.\\end{aligned}\n$$"] [:db/cas 17592186367491 :question/problem "A particle $P$ of mass $5\\,\\text{kg}$ is subject to the external forces \n\n$$\n{F}_{1}=⟨\\frac{3t-7}{{t}^{2}-1},\\,5t⟩,\\,{F}_{2}=⟨\\frac{7t-3}{{t}^{2}-1},\\,5t⟩,\n$$\n\nwhere ${F}_{1}$ and ${F}_{2}$ are measured in Newtons and $t>0$ is the time, in seconds. Given that the velocity of $P$ equals $⟨0,\\,-1⟩\\,\\text{m/s}$ when $t=0\\,\\text{s},$ calculate the speed of $P$ when $t=1\\,\\text{s}.$" "A particle $P$ of mass $5\\,\\text{kg}$ is subject to the external forces \n\n$$\n{F}_{1}=\\left\\langle \\frac{3t-7}{{t}^{2}-1},\\,5t\\right\\rangle ,\\,{F}_{2}=\\left\\langle \\frac{7t-3}{{t}^{2}-1},\\,5t\\right\\rangle ,\n$$\n\nwhere ${F}_{1}$ and ${F}_{2}$ are measured in Newtons and $t>0$ is the time, in seconds. Given that the velocity of $P$ equals $⟨0,\\,-1⟩\\,\\text{m/s}$ when $t=0\\,\\text{s},$ calculate the speed of $P$ when $t=1\\,\\text{s}.$"] [:db/cas 17592186367491 :question/worked-solution "Newton's second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nThe resultant force $F$ acting on $P$ equals the sum of the forces acting on $P.$ Therefore,\n\n$$\n\\begin{aligned}F & ={F}_{1}+{F}_{2} \\\\  & =⟨\\frac{3t-7}{{t}^{2}-1},\\,5t⟩+⟨\\frac{7t-3}{{t}^{2}-1},\\,5t⟩ \\\\  & =⟨\\frac{10t-10}{(t+1)(t-1)},\\,10t⟩ \\\\  & =⟨\\frac{10(t-1)}{(t+1)(t-1)},\\,10t⟩ \\\\  & =⟨\\frac{10}{t+1},\\,10t⟩.\\end{aligned}\n$$\n\nBy Newton's second law, we have\n\n$$\n\\begin{aligned}a & =\\frac{F}{m} \\\\  & =\\frac{1}{5}\\cdot ⟨\\frac{10}{t+1},\\,10t⟩ \\\\  & =⟨\\frac{2}{t+1},\\,2t⟩.\\end{aligned}\n$$\n\nTo compute the velocity vector $v,$ we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v & =\\int a\\,\\text{d}t \\\\  & =\\int ⟨\\frac{2}{t+1},\\,2t⟩\\,\\text{d}t \\\\  & =⟨\\int \\frac{2}{t+1}\\,\\text{d}t,\\,\\int 2t\\,\\text{d}t⟩ \\\\  & =⟨2\\operatorname{ln}⁡(t+1),\\,{t}^{2}⟩+C\\end{aligned}\n$$\n\nwhere $C$ is a (vector) constant of integration. \n\nWe can solve for $C$ by substituting $v=⟨0,\\,-1⟩\\,\\text{m/s}$ and $t=0\\,\\text{s}$ into the above, as follows:\n\n$$\n\\begin{aligned}⟨0,\\,-1⟩ & =⟨2\\operatorname{ln}⁡(0+1),\\,{0}^{2}⟩+C \\\\ ⟨0,\\,-1⟩ & =⟨0,\\,0⟩+C \\\\ C & =⟨0,\\,-1⟩\\end{aligned}\n$$\n\nTherefore, the velocity of $P$ at time $t$ is given by\n\n$$\n\\begin{aligned}v & =⟨2\\operatorname{ln}⁡(t+1),\\,{t}^{2}⟩+⟨0,\\,-1⟩ \\\\  & =⟨2\\operatorname{ln}⁡(t+1),\\,{t}^{2}-1⟩.\\end{aligned}\n$$\n\nWhen $t=1,$ the velocity equals\n\n$$\n\\begin{aligned}v(1) & =⟨2\\operatorname{ln}⁡(1+1),\\,{1}^{2}-1⟩ \\\\  & =⟨2\\operatorname{ln}⁡2,\\,0⟩.\\end{aligned}\n$$\n\nFinally, the speed of $P$ when $t=1$ equals the magnitude of $v(1).$ Therefore,\n\n$$\n\\begin{aligned}|v(1)| & =\\sqrt{(2\\operatorname{ln}⁡2)^{2}+{0}^{2}} \\\\  & =2\\operatorname{ln}⁡2\\,\\text{m/s}.\\end{aligned}\n$$" "Newton's second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nThe resultant force $F$ acting on $P$ equals the sum of the forces acting on $P.$ Therefore,\n\n$$\n\\begin{aligned}F & ={F}_{1}+{F}_{2} \\\\  & =\\left\\langle \\frac{3t-7}{{t}^{2}-1},\\,5t\\right\\rangle +\\left\\langle \\frac{7t-3}{{t}^{2}-1},\\,5t\\right\\rangle  \\\\  & =\\left\\langle \\frac{10t-10}{(t+1)(t-1)},\\,10t\\right\\rangle  \\\\  & =\\left\\langle \\frac{10(t-1)}{(t+1)(t-1)},\\,10t\\right\\rangle  \\\\  & =\\left\\langle \\frac{10}{t+1},\\,10t\\right\\rangle .\\end{aligned}\n$$\n\nBy Newton's second law, we have\n\n$$\n\\begin{aligned}a & =\\frac{F}{m} \\\\  & =\\frac{1}{5}\\cdot \\left\\langle \\frac{10}{t+1},\\,10t\\right\\rangle  \\\\  & =\\left\\langle \\frac{2}{t+1},\\,2t\\right\\rangle .\\end{aligned}\n$$\n\nTo compute the velocity vector $v,$ we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v & =\\int a\\,\\text{d}t \\\\  & =\\int \\left\\langle \\frac{2}{t+1},\\,2t\\right\\rangle \\,\\text{d}t \\\\  & =\\left\\langle \\int \\frac{2}{t+1}\\,\\text{d}t,\\,\\int 2t\\,\\text{d}t\\right\\rangle  \\\\  & =⟨2\\operatorname{ln}⁡(t+1),\\,{t}^{2}⟩+C\\end{aligned}\n$$\n\nwhere $C$ is a (vector) constant of integration. \n\nWe can solve for $C$ by substituting $v=⟨0,\\,-1⟩\\,\\text{m/s}$ and $t=0\\,\\text{s}$ into the above, as follows:\n\n$$\n\\begin{aligned}⟨0,\\,-1⟩ & =⟨2\\operatorname{ln}⁡(0+1),\\,{0}^{2}⟩+C \\\\ ⟨0,\\,-1⟩ & =⟨0,\\,0⟩+C \\\\ C & =⟨0,\\,-1⟩\\end{aligned}\n$$\n\nTherefore, the velocity of $P$ at time $t$ is given by\n\n$$\n\\begin{aligned}v & =⟨2\\operatorname{ln}⁡(t+1),\\,{t}^{2}⟩+⟨0,\\,-1⟩ \\\\  & =⟨2\\operatorname{ln}⁡(t+1),\\,{t}^{2}-1⟩.\\end{aligned}\n$$\n\nWhen $t=1,$ the velocity equals\n\n$$\n\\begin{aligned}v(1) & =⟨2\\operatorname{ln}⁡(1+1),\\,{1}^{2}-1⟩ \\\\  & =⟨2\\operatorname{ln}⁡2,\\,0⟩.\\end{aligned}\n$$\n\nFinally, the speed of $P$ when $t=1$ equals the magnitude of $v(1).$ Therefore,\n\n$$\n\\begin{aligned}|v(1)| & =\\sqrt{(2\\operatorname{ln}⁡2)^{2}+{0}^{2}} \\\\  & =2\\operatorname{ln}⁡2\\,\\text{m/s}.\\end{aligned}\n$$"] [:db/cas 17592186367498 :question/problem "The velocity $v,$ in meters per second, of a particle $P$ of mass $3\\,\\text{kg}$ is given by\n\n$$\nv=⟨\\frac{12}{t},\\,{t}^{3}-1⟩,\n$$\n\nwhere $t>0$ is the time in seconds. Calculate the resultant force acting on the particle when $t=2\\,\\text{s}.$" "The velocity $v,$ in meters per second, of a particle $P$ of mass $3\\,\\text{kg}$ is given by\n\n$$\nv=\\left\\langle \\frac{12}{t},\\,{t}^{3}-1\\right\\rangle ,\n$$\n\nwhere $t>0$ is the time in seconds. Calculate the resultant force acting on the particle when $t=2\\,\\text{s}.$"] [:db/cas 17592186367498 :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{12}{t}\\right),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)⟩ \\\\  & =⟨-\\frac{12}{{t}^{2}},\\,3{t}^{2}⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =3\\cdot ⟨-\\frac{12}{{t}^{2}},\\,3{t}^{2}⟩ \\\\  & =⟨-\\frac{36}{{t}^{2}},\\,9{t}^{2}⟩.\\end{aligned}\n$$\n\nFinally, when $t=2\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(2) & =⟨-\\frac{36}{{2}^{2}},\\,9(2)^{2}⟩ \\\\  & =⟨-9,\\,36⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=2\\,\\text{s}$ equals $⟨-9,\\,36⟩\\,\\text{N}.$" "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{12}{t}\\right),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)\\right\\rangle  \\\\  & =\\left\\langle -\\frac{12}{{t}^{2}},\\,3{t}^{2}\\right\\rangle \\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =3\\cdot \\left\\langle -\\frac{12}{{t}^{2}},\\,3{t}^{2}\\right\\rangle  \\\\  & =\\left\\langle -\\frac{36}{{t}^{2}},\\,9{t}^{2}\\right\\rangle .\\end{aligned}\n$$\n\nFinally, when $t=2\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(2) & =\\left\\langle -\\frac{36}{{2}^{2}},\\,9(2)^{2}\\right\\rangle  \\\\  & =⟨-9,\\,36⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=2\\,\\text{s}$ equals $⟨-9,\\,36⟩\\,\\text{N}.$"] [:db/cas 17592186367500 :answer/value "⟨-\\frac{1}{4},\\,16⟩\\,\\text{N}" "\\left\\langle -\\frac{1}{4},\\,16\\right\\rangle \\,\\text{N}"] [:db/cas 17592186367505 :question/problem "The velocity $v,$ in meters per second, of a particle $P$ of mass $6\\,\\text{kg}$ is given by\n\n$$\nv=⟨3\\operatorname{ln}⁡(t-4),\\,\\frac{1}{2}{t}^{2}⟩,\n$$\n\nwhere $t>4$ is the time in seconds. Calculate the resultant force acting on the particle when $t=7\\,\\text{s}.$" "The velocity $v,$ in meters per second, of a particle $P$ of mass $6\\,\\text{kg}$ is given by\n\n$$\nv=\\left\\langle 3\\operatorname{ln}⁡(t-4),\\,\\frac{1}{2}{t}^{2}\\right\\rangle ,\n$$\n\nwhere $t>4$ is the time in seconds. Calculate the resultant force acting on the particle when $t=7\\,\\text{s}.$"] [:db/cas 17592186367505 :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{ln}⁡(t-4)),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{2})⟩ \\\\  & =⟨\\frac{3}{t-4},\\,t⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =6\\cdot ⟨\\frac{3}{t-4},\\,t⟩ \\\\  & =⟨\\frac{18}{t-4},\\,6t⟩.\\end{aligned}\n$$\n\nFinally, when $t=7\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(7) & =⟨\\frac{18}{7-4},\\,6(7)⟩ \\\\  & =⟨6,\\,42⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=7\\,\\text{s}$ equals $⟨6,\\,42⟩\\,\\text{N}.$" "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(3\\operatorname{ln}⁡(t-4)),\\,\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{2}{t}^{2}\\right)\\right\\rangle  \\\\  & =\\left\\langle \\frac{3}{t-4},\\,t\\right\\rangle \\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =6\\cdot \\left\\langle \\frac{3}{t-4},\\,t\\right\\rangle  \\\\  & =\\left\\langle \\frac{18}{t-4},\\,6t\\right\\rangle .\\end{aligned}\n$$\n\nFinally, when $t=7\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(7) & =\\left\\langle \\frac{18}{7-4},\\,6(7)\\right\\rangle  \\\\  & =⟨6,\\,42⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=7\\,\\text{s}$ equals $⟨6,\\,42⟩\\,\\text{N}.$"] [:db/cas 17592186367512 :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-12\\operatorname{ln}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(8\\sqrt{t})⟩ \\\\  & =⟨-\\frac{12}{t},\\,\\frac{4}{\\sqrt{t}}⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =2\\cdot ⟨-\\frac{12}{t},\\,\\frac{4}{\\sqrt{t}}⟩ \\\\  & =⟨-\\frac{24}{t},\\,\\frac{8}{\\sqrt{t}}⟩.\\end{aligned}\n$$\n\nWhen $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =⟨-\\frac{24}{4},\\,\\frac{8}{\\sqrt{4}}⟩ \\\\  & =⟨-6,\\,4⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(4)$ is given by\n\n$$\n\\begin{aligned}|F(4)| & =\\sqrt{(-6)^{2}+{(4)}^{2}} \\\\  & ≈7.2\\,\\text{N}\\end{aligned}\n$$\n\nrounded to one decimal place." "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(-12\\operatorname{ln}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(8\\sqrt{t})\\right\\rangle  \\\\  & =\\left\\langle -\\frac{12}{t},\\,\\frac{4}{\\sqrt{t}}\\right\\rangle \\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =2\\cdot \\left\\langle -\\frac{12}{t},\\,\\frac{4}{\\sqrt{t}}\\right\\rangle  \\\\  & =\\left\\langle -\\frac{24}{t},\\,\\frac{8}{\\sqrt{t}}\\right\\rangle .\\end{aligned}\n$$\n\nWhen $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =\\left\\langle -\\frac{24}{4},\\,\\frac{8}{\\sqrt{4}}\\right\\rangle  \\\\  & =⟨-6,\\,4⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(4)$ is given by\n\n$$\n\\begin{aligned}|F(4)| & =\\sqrt{(-6)^{2}+{(4)}^{2}} \\\\  & ≈7.2\\,\\text{N}\\end{aligned}\n$$\n\nrounded to one decimal place."] [:db/cas 17592186367519 :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{3/2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2})⟩ \\\\  & =⟨9{t}^{1/2},\\,3{t}^{2}-6t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{1/2}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-6t)⟩ \\\\  & =⟨\\frac{9}{2\\sqrt{t}},\\,6t-6⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =4\\cdot ⟨\\frac{9}{2\\sqrt{t}},\\,6t-6⟩ \\\\  & =⟨\\frac{18}{\\sqrt{t}},\\,24t-24⟩.\\end{aligned}\n$$\n\nFinally, when $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =⟨\\frac{18}{\\sqrt{4}},\\,24(4)-24⟩ \\\\  & =⟨9,\\,72⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=4\\,\\text{s}$ equals $⟨9,\\,72⟩\\,\\text{N}.$" "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(6{t}^{3/2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2})\\right\\rangle  \\\\  & =⟨9{t}^{1/2},\\,3{t}^{2}-6t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(9{t}^{1/2}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-6t)\\right\\rangle  \\\\  & =\\left\\langle \\frac{9}{2\\sqrt{t}},\\,6t-6\\right\\rangle \\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =4\\cdot \\left\\langle \\frac{9}{2\\sqrt{t}},\\,6t-6\\right\\rangle  \\\\  & =\\left\\langle \\frac{18}{\\sqrt{t}},\\,24t-24\\right\\rangle .\\end{aligned}\n$$\n\nFinally, when $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =\\left\\langle \\frac{18}{\\sqrt{4}},\\,24(4)-24\\right\\rangle  \\\\  & =⟨9,\\,72⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=4\\,\\text{s}$ equals $⟨9,\\,72⟩\\,\\text{N}.$"] [:db/cas 17592186367526 :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(1-4{e}^{t/2}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{4-t})⟩ \\\\  & =⟨-2{e}^{t/2},\\,-{e}^{4-t}⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-2{e}^{t/2}),\\,\\frac{\\text{d}}{\\text{d}t}(-{e}^{4-t})⟩ \\\\  & =⟨-{e}^{t/2},\\,{e}^{4-t}⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot ⟨-{e}^{t/2},\\,{e}^{4-t}⟩ \\\\  & =⟨-5{e}^{t/2},\\,5{e}^{4-t}⟩.\\end{aligned}\n$$\n\nWhen $t=3\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(3) & =⟨-5{e}^{3/2},\\,5{e}^{4-3}⟩ \\\\  & =⟨-5{e}^{3/2},\\,5e⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(3)$ is given by\n\n$$\n\\begin{aligned}|F(3)| & =\\sqrt{(-5{e}^{3/2})^{2}+{(5e)}^{2}} \\\\  & =\\sqrt{25{e}^{3}+25{e}^{2}} \\\\  & =5e\\sqrt{e+1} \\\\  & ≈26\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton." "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(1-4{e}^{t/2}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{4-t})\\right\\rangle  \\\\  & =⟨-2{e}^{t/2},\\,-{e}^{4-t}⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(-2{e}^{t/2}),\\,\\frac{\\text{d}}{\\text{d}t}(-{e}^{4-t})\\right\\rangle  \\\\  & =⟨-{e}^{t/2},\\,{e}^{4-t}⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot ⟨-{e}^{t/2},\\,{e}^{4-t}⟩ \\\\  & =⟨-5{e}^{t/2},\\,5{e}^{4-t}⟩.\\end{aligned}\n$$\n\nWhen $t=3\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(3) & =⟨-5{e}^{3/2},\\,5{e}^{4-3}⟩ \\\\  & =⟨-5{e}^{3/2},\\,5e⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(3)$ is given by\n\n$$\n\\begin{aligned}|F(3)| & =\\sqrt{(-5{e}^{3/2})^{2}+{(5e)}^{2}} \\\\  & =\\sqrt{25{e}^{3}+25{e}^{2}} \\\\  & =5e\\sqrt{e+1} \\\\  & ≈26\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton."] [:db/cas 17592186367533 :question/worked-solution "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t)⟩ \\\\  & =⟨-4\\operatorname{sin}⁡t,\\,6\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-4\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-4\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-6\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot ⟨-4\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-6\\operatorname{sin}⁡t⟩ \\\\  & =⟨-20\\operatorname{cos}⁡t,\\,10\\operatorname{cos}⁡t-30\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nWhen $t=\\frac{4\\pi }{3}\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F\\left(\\frac{4\\pi }{3}\\right) & =⟨-20\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right),\\,10\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)-30\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right)⟩ \\\\  & =⟨10,\\,15\\sqrt{3}-5⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F\\left(\\frac{4\\pi }{3}\\right)$ is given by\n\n$$\n\\begin{aligned}|F\\left(\\frac{4\\pi }{3}\\right)| & =\\sqrt{(10)^{2}+{(15\\sqrt{3}-5)}^{2}} \\\\  & ≈23\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton." "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t)\\right\\rangle  \\\\  & =⟨-4\\operatorname{sin}⁡t,\\,6\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(-4\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t)\\right\\rangle  \\\\  & =⟨-4\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-6\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot ⟨-4\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-6\\operatorname{sin}⁡t⟩ \\\\  & =⟨-20\\operatorname{cos}⁡t,\\,10\\operatorname{cos}⁡t-30\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nWhen $t=\\frac{4\\pi }{3}\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F\\left(\\frac{4\\pi }{3}\\right) & =\\left\\langle -20\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right),\\,10\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)-30\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right)\\right\\rangle  \\\\  & =⟨10,\\,15\\sqrt{3}-5⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F\\left(\\frac{4\\pi }{3}\\right)$ is given by\n\n$$\n\\begin{aligned}|F\\left(\\frac{4\\pi }{3}\\right)| & =\\sqrt{(10)^{2}+{(15\\sqrt{3}-5)}^{2}} \\\\  & ≈23\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton."] [:db/cas 17592186367617 :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-{y}^{2} & =1 \\\\ \\frac{\\text{d}}{\\text{d}t}(\\frac{{x}^{2}}{3}-{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}(1) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}}{\\text{d}t}({y}^{2}) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}({y}^{2}) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\left(\\frac{2x}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot (2y) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=6,$ $x=2\\sqrt{3},$ and $y=\\sqrt{3},$ and solve $\\frac{\\text{d}y}{\\text{d}t}.$ We get  \n\n$$\n\\begin{aligned}6\\cdot \\left(\\frac{2(2\\sqrt{3})}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot (2(\\sqrt{3})) & =0 \\\\ -2\\sqrt{3}\\cdot \\frac{\\text{d}y}{\\text{d}t} & =-8\\sqrt{3} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =4.\\end{aligned}\n$$" "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-{y}^{2} & =1 \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{3}-{y}^{2}\\right) & =\\frac{\\text{d}}{\\text{d}t}(1) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}}{\\text{d}t}({y}^{2}) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{2}}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}({y}^{2}) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\left(\\frac{2x}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot (2y) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=6,$ $x=2\\sqrt{3},$ and $y=\\sqrt{3},$ and solve $\\frac{\\text{d}y}{\\text{d}t}.$ We get  \n\n$$\n\\begin{aligned}6\\cdot \\left(\\frac{2(2\\sqrt{3})}{3}\\right)-\\frac{\\text{d}y}{\\text{d}t}\\cdot (2(\\sqrt{3})) & =0 \\\\ -2\\sqrt{3}\\cdot \\frac{\\text{d}y}{\\text{d}t} & =-8\\sqrt{3} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =4.\\end{aligned}\n$$"] [:db/cas 17592186367652 :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{\\text{d}}{\\text{d}t}(\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}t}(1) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{2}\\right)+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{y}^{2}}{4}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{2}}{2}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}\\left(\\frac{{y}^{2}}{4}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (x)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{y}{2}\\right) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}y}{\\text{d}t}=\\sqrt{2}$ and $x=1.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (1)+(\\sqrt{2})\\cdot \\left(\\frac{y}{2}\\right) & =0. \\\\ \\frac{\\text{d}x}{\\text{d}t}+\\frac{\\sqrt{2}\\text{ }\\,y}{2} & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=1$ into the equation of the ellipse. \n\nAt the point where $x=1,$ we have\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{(1)^{2}}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{1}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{y}^{2}}{4} & =1-\\frac{1}{2} \\\\ \\frac{{y}^{2}}{4} & =\\frac{1}{2} \\\\ {y}^{2} & =2 \\\\ y & =\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we used $y>0$ since we're only interested in the first quadrant. \n\nFinally, substituting $y=\\sqrt{2},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}+\\frac{\\sqrt{2}\\cdot \\sqrt{2}}{2} & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}+1 & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-1.\\end{aligned}\n$$" "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4}\\right) & =\\frac{\\text{d}}{\\text{d}t}(1) \\\\ \\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{x}^{2}}{2}\\right)+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{y}^{2}}{4}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{2}}{2}\\right)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}\\left(\\frac{{y}^{2}}{4}\\right) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (x)+\\frac{\\text{d}y}{\\text{d}t}\\cdot \\left(\\frac{y}{2}\\right) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}y}{\\text{d}t}=\\sqrt{2}$ and $x=1.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (1)+(\\sqrt{2})\\cdot \\left(\\frac{y}{2}\\right) & =0. \\\\ \\frac{\\text{d}x}{\\text{d}t}+\\frac{\\sqrt{2}\\text{ }\\,y}{2} & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=1$ into the equation of the ellipse. \n\nAt the point where $x=1,$ we have\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{(1)^{2}}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{1}{2}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{y}^{2}}{4} & =1-\\frac{1}{2} \\\\ \\frac{{y}^{2}}{4} & =\\frac{1}{2} \\\\ {y}^{2} & =2 \\\\ y & =\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we used $y>0$ since we're only interested in the first quadrant. \n\nFinally, substituting $y=\\sqrt{2},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}+\\frac{\\sqrt{2}\\cdot \\sqrt{2}}{2} & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}+1 & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-1.\\end{aligned}\n$$"] [:db/cas 17592186367694 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/9c/9c4ea0ba92e19a201e3944defa6deb0bc1ee76971adaa809521722b6ac31241f.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $$\nz=\\sqrt{9-({x}^{2}-{y}^{2})}=\\sqrt{9-{r}^{2}({\\operatorname{cos}}^{2}\\theta -{\\operatorname{sin}}^{2}\\theta )}=\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )}.\n$$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 3,\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le \\sqrt{9-{r}^{2}\\operatorname{cos}⁡(2\\theta )}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}\\frac{z}{\\sqrt{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}\\operatorname{sin}\\theta }}\\hspace{0.222em}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{0}^{\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )}}z\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{[\\frac{1}{2}{z}^{2}]}_{z=0}^{z=\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )}}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}\\frac{1}{2}{(\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )})}^{2}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}\\frac{1}{2}(9-{r}^{2}\\operatorname{cos}(2\\theta ))\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[\\frac{9}{2}r-\\frac{1}{6}{r}^{3}\\operatorname{cos}(2\\theta )]}_{r=0}^{r=3}\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{9}{2}(3)-\\frac{1}{6}(3)^{3}\\operatorname{cos}(2\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{27}{2}-\\frac{9}{2}\\operatorname{cos}(2\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={[\\frac{27}{2}\\theta -\\frac{9}{4}\\operatorname{sin}(2\\theta )]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =\\frac{27}{2}(2\\pi -0)-\\frac{9}{4}(0-0) \\\\  & =27\\pi .\\end{aligned}\n$$" "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/9c/9c4ea0ba92e19a201e3944defa6deb0bc1ee76971adaa809521722b6ac31241f.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $$\nz=\\sqrt{9-({x}^{2}-{y}^{2})}=\\sqrt{9-{r}^{2}({\\operatorname{cos}}^{2}\\theta -{\\operatorname{sin}}^{2}\\theta )}=\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )}.\n$$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 3,\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le \\sqrt{9-{r}^{2}\\operatorname{cos}⁡(2\\theta )}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}\\frac{z}{\\sqrt{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}\\operatorname{sin}\\theta }}\\hspace{0.222em}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{0}^{\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )}}z\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\left[\\frac{1}{2}{z}^{2}\\right]}_{z=0}^{z=\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )}}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}\\frac{1}{2}{(\\sqrt{9-{r}^{2}\\operatorname{cos}(2\\theta )})}^{2}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}\\frac{1}{2}(9-{r}^{2}\\operatorname{cos}(2\\theta ))\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\left[\\frac{9}{2}r-\\frac{1}{6}{r}^{3}\\operatorname{cos}(2\\theta )\\right]}_{r=0}^{r=3}\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{9}{2}(3)-\\frac{1}{6}(3)^{3}\\operatorname{cos}(2\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{27}{2}-\\frac{9}{2}\\operatorname{cos}(2\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\left[\\frac{27}{2}\\theta -\\frac{9}{4}\\operatorname{sin}(2\\theta )\\right]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =\\frac{27}{2}(2\\pi -0)-\\frac{9}{4}(0-0) \\\\  & =27\\pi .\\end{aligned}\n$$"] [:db/cas 17592186367701 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f4/f4c6f3acefa5d89fd5064de469952da3d68d379559bb4a6a4990a2ea24e4f861.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by  $$\nz=\\sqrt{{x}^{2}+{y}^{2}}=\\sqrt{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta }=r,\n$$  and\n\n- bounded above by $z=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 1,\\,0\\le \\theta <2\\pi ,\\,r\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\int }_{r}^{1}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}[z]_{z=r}^{z=1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}(1-r)\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}-{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[\\frac{1}{4}{r}^{4}-\\frac{1}{5}{r}^{5}]}_{r=0}^{r=1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{4}-\\frac{1}{5}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{20}\\,\\text{d}\\theta  \\\\  & ={[\\frac{1}{20}\\theta ]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =\\frac{1}{20}(2\\pi -0) \\\\  & =\\frac{\\pi }{10}.\\end{aligned}\n$$" "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f4/f4c6f3acefa5d89fd5064de469952da3d68d379559bb4a6a4990a2ea24e4f861.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by  $$\nz=\\sqrt{{x}^{2}+{y}^{2}}=\\sqrt{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta }=r,\n$$  and\n\n- bounded above by $z=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 1,\\,0\\le \\theta <2\\pi ,\\,r\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\int }_{r}^{1}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}[z]_{z=r}^{z=1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}(1-r)\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}-{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\left[\\frac{1}{4}{r}^{4}-\\frac{1}{5}{r}^{5}\\right]}_{r=0}^{r=1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{4}-\\frac{1}{5}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{20}\\,\\text{d}\\theta  \\\\  & ={\\left[\\frac{1}{20}\\theta \\right]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =\\frac{1}{20}(2\\pi -0) \\\\  & =\\frac{\\pi }{10}.\\end{aligned}\n$$"] [:db/cas 17592186367708 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f8/f837d76caa5a6fd2c2de9a628a77c211fc12be6733fec4f1d3332b9c8ff0991c.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-x=-r\\operatorname{cos}⁡\\theta ,$ and\n\n- bounded above by $z=x+2=r\\operatorname{cos}⁡\\theta +2.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le 1,\\hspace{0.222em}0\\le \\theta <\\pi ,\\hspace{0.222em}-r\\operatorname{cos}\\theta \\le z\\le r\\operatorname{cos}\\theta +2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2xz\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}2z\\cdot r\\operatorname{cos}\\theta \\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{\\int }_{-r\\operatorname{cos}\\theta }^{r\\operatorname{cos}\\theta +2}2z{r}^{2}\\operatorname{cos}\\theta \\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{r}^{2}\\operatorname{cos}\\theta [{z}^{2}]_{z=-r\\operatorname{cos}\\theta }^{z=r\\operatorname{cos}\\theta +2}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{r}^{2}\\operatorname{cos}\\theta ({(r\\operatorname{cos}\\theta +2)}^{2}-{(-r\\operatorname{cos}\\theta )}^{2})\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{r}^{2}\\operatorname{cos}\\theta ({r}^{2}{\\operatorname{cos}}^{2}\\theta +4r\\operatorname{cos}\\theta +4-{r}^{2}{\\operatorname{cos}}^{2}\\theta )\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}4{r}^{3}{\\operatorname{cos}}^{2}\\theta +4{r}^{2}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }[{r}^{4}{\\operatorname{cos}}^{2}\\theta +\\frac{4}{3}{r}^{3}\\operatorname{cos}\\theta ]_{r=0}^{r=1}\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\operatorname{cos}}^{2}\\theta +\\frac{4}{3}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\frac{1}{2}(1+\\operatorname{cos}(2\\theta ))+\\frac{4}{3}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}(2\\theta )+\\frac{4}{3}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}\\theta  \\\\  & ={[\\frac{1}{2}\\theta +\\frac{1}{4}\\operatorname{sin}(2\\theta )+\\frac{4}{3}\\operatorname{sin}\\theta ]}_{\\theta =0}^{\\theta =\\pi } \\\\  & =\\frac{1}{2}(\\pi -0)+\\frac{1}{4}(0-0)+\\frac{4}{3}(0-0) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$" "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f8/f837d76caa5a6fd2c2de9a628a77c211fc12be6733fec4f1d3332b9c8ff0991c.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-x=-r\\operatorname{cos}⁡\\theta ,$ and\n\n- bounded above by $z=x+2=r\\operatorname{cos}⁡\\theta +2.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le 1,\\hspace{0.222em}0\\le \\theta <\\pi ,\\hspace{0.222em}-r\\operatorname{cos}\\theta \\le z\\le r\\operatorname{cos}\\theta +2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2xz\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}2z\\cdot r\\operatorname{cos}\\theta \\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{\\int }_{-r\\operatorname{cos}\\theta }^{r\\operatorname{cos}\\theta +2}2z{r}^{2}\\operatorname{cos}\\theta \\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{r}^{2}\\operatorname{cos}\\theta [{z}^{2}]_{z=-r\\operatorname{cos}\\theta }^{z=r\\operatorname{cos}\\theta +2}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{r}^{2}\\operatorname{cos}\\theta ({(r\\operatorname{cos}\\theta +2)}^{2}-{(-r\\operatorname{cos}\\theta )}^{2})\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}{r}^{2}\\operatorname{cos}\\theta ({r}^{2}{\\operatorname{cos}}^{2}\\theta +4r\\operatorname{cos}\\theta +4-{r}^{2}{\\operatorname{cos}}^{2}\\theta )\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{1}4{r}^{3}{\\operatorname{cos}}^{2}\\theta +4{r}^{2}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\left[{r}^{4}{\\operatorname{cos}}^{2}\\theta +\\frac{4}{3}{r}^{3}\\operatorname{cos}\\theta \\right]_{r=0}^{r=1}\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\operatorname{cos}}^{2}\\theta +\\frac{4}{3}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\frac{1}{2}(1+\\operatorname{cos}(2\\theta ))+\\frac{4}{3}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}(2\\theta )+\\frac{4}{3}\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\left[\\frac{1}{2}\\theta +\\frac{1}{4}\\operatorname{sin}(2\\theta )+\\frac{4}{3}\\operatorname{sin}\\theta \\right]}_{\\theta =0}^{\\theta =\\pi } \\\\  & =\\frac{1}{2}(\\pi -0)+\\frac{1}{4}(0-0)+\\frac{4}{3}(0-0) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"] [:db/cas 17592186367715 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/6f/6fe710e758ccda9a826d79f8219dc82b25f8cc39f65d92f02a6c28594c428a96.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{2}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=6-2x=6-2r\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le \\sqrt{2},\\hspace{0.222em}0\\le \\theta <\\pi ,\\hspace{0.222em}0\\le z\\le 6-2r\\operatorname{cos}\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}4\\,\\text{d}V & ={∭}_{Δ}4\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{\\int }_{0}^{6-2r\\operatorname{cos}⁡\\theta }4r\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}4r[z]_{z=0}^{z=6-2r\\operatorname{cos}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}4r(6-2r\\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}24r-8{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{[12{r}^{2}-\\frac{8}{3}{r}^{3}\\operatorname{cos}⁡\\theta ]}_{r=0}^{r=\\sqrt{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }12(\\sqrt{2})^{2}-\\frac{8}{3}(\\sqrt{2})^{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }24-\\frac{16\\sqrt{2}}{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={[24\\theta -\\frac{16\\sqrt{2}}{3}\\operatorname{sin}⁡\\theta ]}_{\\theta =0}^{\\theta =\\pi } \\\\  & =24(\\pi -0)-\\frac{16\\sqrt{2}}{3}(0-0) \\\\  & =24\\pi .\\end{aligned}\n$$" "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/6f/6fe710e758ccda9a826d79f8219dc82b25f8cc39f65d92f02a6c28594c428a96.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{2}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=6-2x=6-2r\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le \\sqrt{2},\\hspace{0.222em}0\\le \\theta <\\pi ,\\hspace{0.222em}0\\le z\\le 6-2r\\operatorname{cos}\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}4\\,\\text{d}V & ={∭}_{Δ}4\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{\\int }_{0}^{6-2r\\operatorname{cos}⁡\\theta }4r\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}4r[z]_{z=0}^{z=6-2r\\operatorname{cos}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}4r(6-2r\\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}24r-8{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\left[12{r}^{2}-\\frac{8}{3}{r}^{3}\\operatorname{cos}⁡\\theta \\right]}_{r=0}^{r=\\sqrt{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }12(\\sqrt{2})^{2}-\\frac{8}{3}(\\sqrt{2})^{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }24-\\frac{16\\sqrt{2}}{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\left[24\\theta -\\frac{16\\sqrt{2}}{3}\\operatorname{sin}⁡\\theta \\right]}_{\\theta =0}^{\\theta =\\pi } \\\\  & =24(\\pi -0)-\\frac{16\\sqrt{2}}{3}(0-0) \\\\  & =24\\pi .\\end{aligned}\n$$"] [:db/cas 17592186367736 :question/worked-solution "Since we have a closed surface, the positive orientation is outward-pointing by convention. So,\n\n- the upper surface ${S}_{1}:z=g(x,y)=4-{x}^{2}-{y}^{2}$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)=x$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper paraboloid ${S}_{1}.$\n\nWe compute the partial derivatives of $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4-{x}^{2}-{y}^{2})=-2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4-{x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=-xy,\\,Q=-z={x}^{2}+{y}^{2}-4,\\,R=0.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(-xy)\\cdot (-2x)-({x}^{2}+{y}^{2}-4)\\cdot (-2y)+0)\\,\\text{d}A \\\\  & ={∬}_{D}-2{x}^{2}y+2{x}^{2}y+2{y}^{3}-8y\\,\\text{d}A \\\\  & ={∬}_{D}2{y}^{3}-8y\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider lower plane ${S}_{2}.$ \n\nWe compute the partial derivatives of $z=h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(x)=1 \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(x)=0\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=-xy,\\,Q=-z=-x,\\,R=0.\n$$\n\n \n\nAs a result, since the positive orientation is downward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & =-{∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & =-{∬}_{D}(-(-xy)\\cdot 1-(-x)\\cdot 0+0)\\,\\text{d}A \\\\  & =-{∬}_{D}xy\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}2{y}^{3}-8y\\,\\text{d}A-{∬}_{D}xy\\,\\text{d}A \\\\  & ={∬}_{D}2{y}^{3}-8y-xy\\,\\text{d}A.\\end{aligned}\n$$" "Since we have a closed surface, the positive orientation is outward-pointing by convention. So,\n\n- the upper surface ${S}_{1}:z=g(x,y)=4-{x}^{2}-{y}^{2}$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)=x$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper paraboloid ${S}_{1}.$\n\nWe compute the partial derivatives of $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4-{x}^{2}-{y}^{2})=-2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4-{x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=-xy,\\,Q=-z={x}^{2}+{y}^{2}-4,\\,R=0.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{D}\\left(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R\\right)\\text{d}A \\\\  & ={∬}_{D}(-(-xy)\\cdot (-2x)-({x}^{2}+{y}^{2}-4)\\cdot (-2y)+0)\\,\\text{d}A \\\\  & ={∬}_{D}-2{x}^{2}y+2{x}^{2}y+2{y}^{3}-8y\\,\\text{d}A \\\\  & ={∬}_{D}2{y}^{3}-8y\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider lower plane ${S}_{2}.$ \n\nWe compute the partial derivatives of $z=h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(x)=1 \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(x)=0\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=-xy,\\,Q=-z=-x,\\,R=0.\n$$\n\n \n\nAs a result, since the positive orientation is downward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & =-{∬}_{D}\\left(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R\\right)\\text{d}A \\\\  & =-{∬}_{D}(-(-xy)\\cdot 1-(-x)\\cdot 0+0)\\,\\text{d}A \\\\  & =-{∬}_{D}xy\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}2{y}^{3}-8y\\,\\text{d}A-{∬}_{D}xy\\,\\text{d}A \\\\  & ={∬}_{D}2{y}^{3}-8y-xy\\,\\text{d}A.\\end{aligned}\n$$"] [:db/cas 17592186367839 :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as\n\n$$\n\\lambda (x,y)=k(|x|+|y|)=k(x+y),\n$$\n\nwhere $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}k(x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{\\int }_{0}^{2}x+y\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}+xy]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}2+2y\\,\\text{d}y \\\\  & =k{[2y+{y}^{2}]}_{0}^{2} \\\\  & =k(4+4) \\\\  & =8k\\end{aligned}\n$$\n\nTherefore, $k=\\frac{M}{8}$ and hence,\n\n$$\n\\lambda (x,y)=k(x+y)=\\frac{M}{8}(x+y).\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}{y}^{2}\\cdot (x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}x{y}^{2}+{y}^{3}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}{y}^{2}+x{y}^{3}]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}2{y}^{2}+2{y}^{3}\\,\\text{d}y \\\\  & =\\frac{M}{8}{[\\frac{2}{3}{y}^{3}+\\frac{1}{2}{y}^{4}]}_{0}^{2} \\\\  & =\\frac{M}{8}(\\frac{16}{3}+8) \\\\  & =\\frac{5M}{3}.\\end{aligned}\n$$" "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as\n\n$$\n\\lambda (x,y)=k(|x|+|y|)=k(x+y),\n$$\n\nwhere $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}k(x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{\\int }_{0}^{2}x+y\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{\\left[\\frac{1}{2}{x}^{2}+xy\\right]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}2+2y\\,\\text{d}y \\\\  & =k{[2y+{y}^{2}]}_{0}^{2} \\\\  & =k(4+4) \\\\  & =8k\\end{aligned}\n$$\n\nTherefore, $k=\\frac{M}{8}$ and hence,\n\n$$\n\\lambda (x,y)=k(x+y)=\\frac{M}{8}(x+y).\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}{y}^{2}\\cdot (x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}x{y}^{2}+{y}^{3}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\left[\\frac{1}{2}{x}^{2}{y}^{2}+x{y}^{3}\\right]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}2{y}^{2}+2{y}^{3}\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\left[\\frac{2}{3}{y}^{3}+\\frac{1}{2}{y}^{4}\\right]}_{0}^{2} \\\\  & =\\frac{M}{8}\\left(\\frac{16}{3}+8\\right) \\\\  & =\\frac{5M}{3}.\\end{aligned}\n$$"] [:db/cas 17592186367846 :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2x},\n$$\n\nas shown below.\n\n![](images/3c/3cd38c4eca16f60ac918a6867e858ae3c1d4589a3a02d04f7b34f5cf7e24ac62.png)\n\nFrom the description, the mass density function can be written as \n\n$$\n\\lambda (x,y)=k|x|=kx,\n$$\n\nwhere $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2x}kx\\,\\text{d}y\\,\\text{d}x \\\\  & =k{\\int }_{0}^{2}[{\\int }_{0}^{2x}x\\,\\text{d}y]\\text{d}x \\\\  & =k{\\int }_{0}^{2}[xy]_{y=0}^{y=2x}\\,\\text{d}x \\\\  & =k{\\int }_{0}^{2}x(2x)\\,\\text{d}x \\\\  & =k{\\int }_{0}^{2}2{x}^{2}\\,\\text{d}x \\\\  & =k{[\\frac{2}{3}{x}^{3}]}_{0}^{2} \\\\  & =\\frac{16k}{3}\\end{aligned}\n$$\n\nTherefore, $k=\\frac{3M}{16}$ and hence,\n\n$$\n\\lambda (x,y)=kx=\\frac{3M}{16}x.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}{\\int }_{0}^{2x}({x}^{2}+{y}^{2})(x)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}[{\\int }_{0}^{2x}{x}^{3}+x{y}^{2}\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}{[{x}^{3}y+\\frac{1}{3}x{y}^{3}]}_{y=0}^{y=2x}\\,\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}{x}^{3}(2x)+\\frac{1}{3}x(2x)^{3}\\,\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}\\frac{14}{3}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{7M}{8}{\\int }_{0}^{2}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{7M}{8}{[\\frac{1}{5}{x}^{5}]}_{0}^{2} \\\\  & =\\frac{7M}{8}\\cdot \\frac{32}{5} \\\\  & =\\frac{28M}{5}.\\end{aligned}\n$$" "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2x},\n$$\n\nas shown below.\n\n![](images/3c/3cd38c4eca16f60ac918a6867e858ae3c1d4589a3a02d04f7b34f5cf7e24ac62.png)\n\nFrom the description, the mass density function can be written as \n\n$$\n\\lambda (x,y)=k|x|=kx,\n$$\n\nwhere $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2x}kx\\,\\text{d}y\\,\\text{d}x \\\\  & =k{\\int }_{0}^{2}[{\\int }_{0}^{2x}x\\,\\text{d}y]\\text{d}x \\\\  & =k{\\int }_{0}^{2}[xy]_{y=0}^{y=2x}\\,\\text{d}x \\\\  & =k{\\int }_{0}^{2}x(2x)\\,\\text{d}x \\\\  & =k{\\int }_{0}^{2}2{x}^{2}\\,\\text{d}x \\\\  & =k{\\left[\\frac{2}{3}{x}^{3}\\right]}_{0}^{2} \\\\  & =\\frac{16k}{3}\\end{aligned}\n$$\n\nTherefore, $k=\\frac{3M}{16}$ and hence,\n\n$$\n\\lambda (x,y)=kx=\\frac{3M}{16}x.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}{\\int }_{0}^{2x}({x}^{2}+{y}^{2})(x)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}[{\\int }_{0}^{2x}{x}^{3}+x{y}^{2}\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}{\\left[{x}^{3}y+\\frac{1}{3}x{y}^{3}\\right]}_{y=0}^{y=2x}\\,\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}{x}^{3}(2x)+\\frac{1}{3}x(2x)^{3}\\,\\text{d}x \\\\  & =\\frac{3M}{16}{\\int }_{0}^{2}\\frac{14}{3}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{7M}{8}{\\int }_{0}^{2}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{7M}{8}{\\left[\\frac{1}{5}{x}^{5}\\right]}_{0}^{2} \\\\  & =\\frac{7M}{8}\\cdot \\frac{32}{5} \\\\  & =\\frac{28M}{5}.\\end{aligned}\n$$"] [:db/cas 17592186367853 :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2x},\n$$\n\nas shown below.\n\n![](images/76/760f05986cf2d58561ddcdc80b41b7f2a91ea8cc1fd5482ab115e3950d213b81.png)\n\nThe area of the triangular plate $D$ is \n\n$$\nA=\\frac{1}{2}\\cdot 2\\cdot 4=4.\n$$\n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{4}.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}{\\int }_{0}^{2x}({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}[{\\int }_{0}^{2x}({x}^{2}+{y}^{2})\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}{[{x}^{2}y+\\frac{{y}^{3}}{3}]}_{y=0}^{y=2x}\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}2{x}^{3}+\\frac{8}{3}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}\\frac{14}{3}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{M}{4}{[\\frac{7}{6}{x}^{4}]}_{0}^{2} \\\\  & =\\frac{7M}{24}(16-0) \\\\  & =\\frac{14M}{3}.\\end{aligned}\n$$" "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2x},\n$$\n\nas shown below.\n\n![](images/76/760f05986cf2d58561ddcdc80b41b7f2a91ea8cc1fd5482ab115e3950d213b81.png)\n\nThe area of the triangular plate $D$ is \n\n$$\nA=\\frac{1}{2}\\cdot 2\\cdot 4=4.\n$$\n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{4}.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}{\\int }_{0}^{2x}({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}[{\\int }_{0}^{2x}({x}^{2}+{y}^{2})\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}{\\left[{x}^{2}y+\\frac{{y}^{3}}{3}\\right]}_{y=0}^{y=2x}\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}2{x}^{3}+\\frac{8}{3}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{M}{4}{\\int }_{0}^{2}\\frac{14}{3}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{M}{4}{\\left[\\frac{7}{6}{x}^{4}\\right]}_{0}^{2} \\\\  & =\\frac{7M}{24}(16-0) \\\\  & =\\frac{14M}{3}.\\end{aligned}\n$$"] [:db/cas 17592186367860 :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 3,\\,\\,x\\le y\\le 3},\n$$\n\nas shown below.\n\n![](images/5c/5c8b8b20bdafd15c5784ad2c83cafe52ab2afe45956dd4c7a640260840098a8f.png)\n\nThe area of the triangular plate $D$ is \n\n$$\nA=\\frac{1}{2}\\cdot 3\\cdot 3=\\frac{9}{2}.\n$$\n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{2M}{9}.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}{\\int }_{x}^{3}({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}[{\\int }_{x}^{3}({x}^{2}+{y}^{2})\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}{[{x}^{2}y+\\frac{{y}^{3}}{3}]}_{y=x}^{y=3}\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}(3{x}^{2}+9)-({x}^{3}+\\frac{{x}^{3}}{3})\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}3{x}^{2}+9-\\frac{4}{3}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{2M}{9}{[{x}^{3}+9x-\\frac{{x}^{4}}{3}]}_{0}^{3} \\\\  & =\\frac{2M}{9}(27+27-27) \\\\  & =6M.\\end{aligned}\n$$" "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 3,\\,\\,x\\le y\\le 3},\n$$\n\nas shown below.\n\n![](images/5c/5c8b8b20bdafd15c5784ad2c83cafe52ab2afe45956dd4c7a640260840098a8f.png)\n\nThe area of the triangular plate $D$ is \n\n$$\nA=\\frac{1}{2}\\cdot 3\\cdot 3=\\frac{9}{2}.\n$$\n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{2M}{9}.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}{\\int }_{x}^{3}({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}[{\\int }_{x}^{3}({x}^{2}+{y}^{2})\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}{\\left[{x}^{2}y+\\frac{{y}^{3}}{3}\\right]}_{y=x}^{y=3}\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}(3{x}^{2}+9)-\\left({x}^{3}+\\frac{{x}^{3}}{3}\\right)\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}3{x}^{2}+9-\\frac{4}{3}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\left[{x}^{3}+9x-\\frac{{x}^{4}}{3}\\right]}_{0}^{3} \\\\  & =\\frac{2M}{9}(27+27-27) \\\\  & =6M.\\end{aligned}\n$$"]]
