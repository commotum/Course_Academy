 "d9d128b2-4dc7-59f5-9ae4-fde84a06094e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186432436}] :answer-field/correct {:answer/id #uuid "49734c3c-e905-5965-849c-4608b2744957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{105}^{∘}" :db/id #edb/ref 17592186432399} :answer-field/id #uuid "5bad39f7-11be-5684-b61f-14d08753ac2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432447}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04351232-e12f-56c5-9996-c18094808c54" :question/math-academy-id "q-154716" :question/problem "![](images/0c/0c5a57e090562c65ff7f0ff8d7c63f469a038d4396bba68be3cb4916f4e7aab7.png)\n\nWhat is the measure of $\\overset{^}{COE}?$" :question/worked-solution "![](images/18/18be9d5946a70aa62b4dda5408fa7e3312fe2e33675cbf695cbbdecac2feaa5b.png)\n\nFirst, notice that $\\overset{^}{COD}$ and $\\overset{^}{DOE}$ are adjacent because they share the same side $\\overset{\\to }{OD}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore:\n\n$$\n\\begin{aligned}m\\overset{^}{COE} & =m\\overset{^}{COD}+m\\overset{^}{DOE} \\\\  & ={70}^{∘}+{35}^{∘} \\\\  & ={105}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186432461 :knowledge-point/_questions [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29cfb2bf-06d4-573d-9bee-ffd5e788ec1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{173}^{∘}" :db/id #edb/ref 17592186432385} {:answer/id #uuid "30be3a32-c98a-5a2e-815d-43e60c1cf69b" :answer/type {:db/id #edb/ref 1759218604549