_{j-1}+{y}_{j})-\\frac{1}{2}({x}_{i-1}+{x}_{i})]Δ{x}_{i}Δ{y}_{j}\\le U(f,P)\n$$\n\nSeparating the sums using the addition rule, we get\n\n$$\n\\begin{aligned}L(f,P) & \\le \\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j}-\\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j} \\\\  & \\le U(f,P).\\end{aligned}\n$$\n\nUsing the hint, we get the following:\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{j-1}+{x}_{j})Δ{x}_{i}Δ{y}_{j} & =\\frac{1}{2}({1}^{2}-(-3)^{2})(4-2)=-8 \\\\ \\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} & =\\frac{1}{2}({4}^{2}-{2}^{2})(1-(-3))=24\\end{aligned}\n$$\n\nFinally then:\n\n$$\n\\begin{aligned}L(f,P)\\le 24-(-8)\\le U(f,P)\\,⟹\\,L(f,P)\\le 32\\le U(f,P)\\end{aligned}\n$$\n\nTherefore, we conclude that \n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=32.\n$$" 13194139535935 17592186045417 true] [17592186544855 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i-2j+k)-(-i+j+k) \\\\  & =3i-3j \\\\  & =⟨3,-3,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+2j+2k)-(-i+j+k) \\\\  & =2i+j+k \\\\  & =⟨2,1,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i-j+4k)-(-i+j+k) \\\\  & =3i-2j+3k \\\\  & =⟨3,-2,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}3 & -3 & 0 \\\\ 2 & 1 & 1 \\\\ 3 & -2 & 3\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & 1 \\\\ -2 & 3\\end{aligned}|-(-3)\\cdot |\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}2 & 1 \\\\ 3 & -2\\end{aligned}| \\\\  & =3(1\\cdot 3-(-2)\\cd