#{[{:db/id #edb/ref 17592186678309 :knowledge-point/_questions [{:db/id #edb/ref 17592186068917 :knowledge-point/title "Integrating Products Containing Trigonometric Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10306567-3786-5bb6-b48a-264df6f8c19c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u" :db/id #edb/ref 17592186678246} {:answer/id #uuid "1a6b9c1a-750b-5917-bf9b-72064d5ab3dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678248} {:answer/id #uuid "5891f849-cdc9-5a96-9500-7ed3b726bd69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{3}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678275} {:answer/id #uuid "d122c9c1-699a-567a-9c2f-263df3f5e4bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678321} {:answer/id #uuid "d5d30a1b-08f2-5ad2-ae40-ff291da65c3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678325}] :answer-field/correct {:answer/id #uuid "1a6b9c1a-750b-5917-bf9b-72064d5ab3dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678248} :answer-field/id #uuid "f2f57764-e4d0-53c4-8b08-8ee8a04be1a7" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186678336}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2f9afef-2213-5cf4-8ac2-9379af1651a3" :question/problem "Use the substitution $u=x^{3}$. Which integral is obtained?\n\n$$\n\\int x^{2} \\csc^{2}{\\left(x^{3} \\right)}\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3 x^{2}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int x^{2} \\csc^{2}{\\left(x^{3} \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{3}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\n$$"}]}
