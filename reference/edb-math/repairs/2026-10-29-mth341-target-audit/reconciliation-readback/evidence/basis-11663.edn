[[{:db/id 17592186660905 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e3b9100-91b5-59ec-8676-832893b05ebb" :knowledge-point/title "Calculating Cross Product Expressions Using the Distributive Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20903be6-89e3-5119-ab2f-761f0d0da1c7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id 17592186660494}] :answer-field/correct {:answer/id #uuid "20903be6-89e3-5119-ab2f-761f0d0da1c7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id 17592186660494} :answer-field/id #uuid "1465d378-1afb-5561-9949-861532da7c31" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186660774} {:answer-field/choices [{:answer/id #uuid "b2d057c7-4c76-57ee-ad78-fa96cae384aa" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id 17592186660675}] :answer-field/correct {:answer/id #uuid "b2d057c7-4c76-57ee-ad78-fa96cae384aa" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id 17592186660675} :answer-field/id #uuid "9172dc51-97c6-5bfc-9571-88a20012b26e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186660816}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccbaa794-afb5-5200-b91c-e8c3a1f38e0d" :question/math-academy-id "q-280352" :question/problem "Let $\\mathbf{c}\\times \\mathbf{a}=⟨1,5,0⟩$ and $\\mathbf{c}\\times \\mathbf{b}=⟨-2,4,0⟩.$ Find $\\mathbf{c}\\times (2\\mathbf{a}-3\\mathbf{b}).$\n\n$\\mathbf{c}\\times (2\\mathbf{a}-3\\mathbf{b})=⟨$\n{{field-1}}$,$\n{{field-2}}$,0⟩$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\nc\\times (2a-3b)=c\\times (2a)-c\\times (3b)\n$$\n\n- Next, we factor out the scalars:\n\n$$\nc\\times (2a)-c\\times (3b)=2(c\\times a)-3(c\\times b)\n$$\n\n- Finally, we substitute the given values for $c\\times a$ and $c\\times b,$ and simplify:\n\n$$\n\\begin{aligned}2(c\\times a)-3(c\\times b) & =2⟨1,5,0⟩-3⟨-2,4,0⟩ \\\\  & =⟨2,10,0⟩+⟨6,-12,0⟩ \\\\  & =⟨8,\\,-2,0⟩\\end{aligned}\n$$"}] [{:db/id 17592186304926 :knowledge-point/_questions [{:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336bb496-d1df-5e9a-a07a-1ec951355ede" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id 17592186302774} {:answer/id #uuid "8e8dad69-2acf-5472-9a3f-505a95ac3fea" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-2,-2,-2⟩+s⟨1,4,-14⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id 17592186303341} {:answer/id #uuid "b208b020-2e95-5012-90d1-880d0704ce1a" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨-2,-2,-2⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id 17592186303557} {:answer/id #uuid "d3a6125d-748b-50ac-93e6-06be995d0638" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨0,3,-19⟩+s⟨-2,-2,-2⟩+t⟨1,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id 17592186303769} {:answer/id #uuid "feb8b07e-b16f-57b2-afdf-a8e6076cfea6" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id 17592186304058}] :answer-field/correct {:answer/id #uuid "feb8b07e-b16f-57b2-afdf-a8e6076cfea6" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id 17592186304058} :answer-field/id #uuid "3a308e92-1035-59ed-9244-1f44706e0efe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186304233}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "133e1de3-de48-5298-8948-a57726f1d155" :question/math-academy-id "q-33160" :question/problem "Find a parametric equation of the plane that passes through the point $C(1,4,-14)$ and is parallel to the plane determined by the two distinct parallel lines $\\mathbf{r}=⟨-1,5,7⟩+s⟨1,1,1⟩$ and $\\mathbf{r}=⟨0,3,-19⟩+t⟨-2,-2,-2⟩.$" :question/worked-solution "The two lines have direction vectors $\\mathbf d_1=\\langle1,1,1\\rangle$ and $\\mathbf d_2=\\langle-2,-2,-2\\rangle=-2\\mathbf d_1$, so they are parallel. Their base points are $P(-1,5,7)$ and $Q(0,3,-19)$. The vector between them is\n\n$$\n\\mathbf u=\\overrightarrow{PQ}=\\langle1,-2,-26\\rangle.\n$$\n\nThe plane determined by the two lines has direction span $\\operatorname{span}\\{\\mathbf d_1,\\mathbf u\\}$. These vectors are independent because $\\mathbf d_1\\times\\mathbf u=\\langle-24,27,-3\\rangle\\ne\\mathbf0$. A parallel plane through $C(1,4,-14)$ has the same direction span, hence its parametric equation is\n\n$$\n\\mathbf r=\\langle1,4,-14\\rangle+s\\langle1,1,1\\rangle+t\\langle1,-2,-26\\rangle,\\qquad s,t\\in\\mathbb R.\n$$\n\nThis is the unique listed plane with that direction span passing through $C$."}]]