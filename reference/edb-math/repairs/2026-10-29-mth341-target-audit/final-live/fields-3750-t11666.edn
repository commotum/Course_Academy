nswer.type/math} :answer/value "\\begin{bmatrix}4-2z \\\\ 1+z \\\\ z\\end{bmatrix},\\quad z\\in\\mathbb{R}" :db/id #edb/ref 17592186716642} {:answer/feedback "This is only the solution with $z=0$. The question asks for every solution." :answer/id #uuid "c02c23cb-88aa-5181-947c-e39bc6347144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186716645}] :answer-field/correct {:db/id #edb/ref 17592186716636} :answer-field/id #uuid "0ace548b-c4c3-5737-9833-056407587ce8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186716629}] [{:answer-field/choices [{:answer/feedback "This forces $w=y$ and leaves out valid solutions where the two free variables differ." :answer/id #uuid "1702c7af-22cf-5980-8d05-1780959ae954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3-y \\\\ y \\\\ -1-2y \\\\ y\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716630} {:answer/feedback "This is just one solution, obtained by taking $y=w=0$." :answer/id #uuid "5718aafd-2a50-5157-b063-1c78a6a2d348" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186716640} {:answer/feedback "The first pivot equation gives $x=3-2y+w$." :answer/id #uuid "68ab3c01-58a2-5813-8f69-ee809a82e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3+2y+w \\\\ y \\\\ -1-2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}" :db/id #edb/ref 17592186716641} {:answer/feedback "Both free variables vary independently, and the pivot equations determine $x$ and $z$." :answer/id #uuid "ac581172-a2d1-53a9-bc31-065f73225a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3-2y+w \\\\ y \\\\ -1-2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}" :db/id #edb/ref 17592186716644} {:answer/feedback "The pivot equations give $x=3-2y+w$ and $z=-1-2w$; both parameter signs here are wrong." :answer/id #uuid "dd912ed2-6123-5faa-a141-8de452a153b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3-2y-w \\\\ y \\\\ -1+2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}" :db/id #edb/ref 17592186716647}] :answer-field/correct {:db/id #edb/ref 17592186716644} :answer-field/id #uuid "1bac10f3-b02d-5af5-9337-7b5d9fadc082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186716631}] [{:answer-field/choices [{:answer/feedback "Allowing $y$ to vary requires $x$ to vary as $3-2y$." :answer/id #uuid "31384dc2-fd15-5bde-87e1-d8d05bc46d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716635} {:answer/feedback "The equation $3z=3$ gives $z=1$, not $3$." :answer/id #uuid "462572cd-58a5-54fb-9b36-b41dccf505ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3-2y \\\\ y \\\\ 3\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716638} {:answer/feedback "Clearing the $z$ coefficient also changes the constant from $2$ to $3$." :answer/id #uuid "54ae90f3-2cae-55fd-9f74-f578edee1521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2-2y \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716639} {:answer/feedback "The nonpivot variable is $y$; the pivot variable $z$ is fixed at $1$." :answer/id #uuid "a893ccc9-c4ef-5602-afa6-f3e9316d8522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer