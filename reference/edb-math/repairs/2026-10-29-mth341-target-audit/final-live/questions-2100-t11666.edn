#{[{:db/id #edb/ref 17592186540483 :question/answer-fields [{:db/id #edb/ref 17592186540505}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2d00aa1-1933-5301-9a98-c10f6c0863aa" :question/problem "Let $u=⟨-7,8,8⟩$ and $v=⟨6,-5,-7⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -7 & 8 & 8 \\\\ 6 & -5 & -7\\end{vmatrix} \\\\  & =\\begin{vmatrix}8 & 8 \\\\ -5 & -7\\end{vmatrix}i-\\begin{vmatrix}-7 & 8 \\\\ 6 & -7\\end{vmatrix}j+\\begin{vmatrix}-7 & 8 \\\\ 6 & -5\\end{vmatrix}k \\\\  & =((8)(-7)-(8)(-5))i-((-7)(-7)-(8)(6))j+((-7)(-5)-(8)(6))k \\\\  & =(-56-(-40))i-(49-(48))j+(35-(48))k \\\\  & =-16i-j-13k \\\\  & =⟨-16,-1,-13⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540489 :question/answer-fields [{:db/id #edb/ref 17592186540481}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bf9484b3-9081-5c6e-811b-eb353ca9f662" :question/problem "Let $u=⟨-1,-1,-2⟩$ and $v=⟨-\\frac{5}{2},1,\\frac{5}{4}⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -1 & -1 & -2 \\\\ -\\frac{5}{2} & 1 & \\frac{5}{4}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & -2 \\\\ 1 & \\frac{5}{4}\\end{vmatrix}i-\\begin{vmatrix}-1 & -2 \\\\ -\\frac{5}{2} & \\frac{5}{4}\\end{vmatrix}j+\\begin{vmatrix}-1 & -1 \\\\ -\\frac{5}{2} & 1\\end{vmatrix}k \\\\  & =((-1)\\left(\\frac{5}{4}\\right)-(-2)(1))i-((-1)\\left(\\frac{5}{4}\\right)-(-2)\\left(-\\frac{5}{2}\\right))j+((-1)(1)-(-1)\\left(-\\frac{5}{2}\\right))k \\\\  & =(-\\frac{5}{4}-(-2))i-(-\\frac{5}{4}-(5))j+(-1-\\left(\\frac{5}{2}\\right))k \\\\  & =\\frac{3}{4}i+\\frac{25}{4}j-\\frac{7}{2}k \\\\  & =⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540496 :question/answer-fields [{:db/id #edb/ref 17592186540447}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c77adb70-a8ce-5278-ac35-a3c62801b336" :question/problem "Let $u=⟨4,3,2⟩$ and $v=⟨6,1,7⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 4 & 3 & 2 \\\\ 6 & 1 & 7\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 2 \\\\ 1 & 7\\end{vmatrix}i-\\begin{vmatrix}4 & 2 \\\\ 6 & 7\\end{vmatrix}j+\\begin{vmatrix}4 & 3 \\\\ 6 & 1\\end{vmatrix}k \\\\  & =((3)(7)-(2)(1))i-((4)(7)-(2)(6))j+((4)(1)-(3)(6))k \\\\  & =(21-(2))i-(28-(12))j+(4-(18))k \\\\  & =19i-16j-14k \\\\  & =⟨19,-16,-14⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540497 :question/answer-fields [{:db/id #edb/ref 17592186540452} {:db/id #edb/ref 17592186540500} {:db/id #edb/ref 17592186540504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c864978d-b324-56a0-a971-f1464ab20fb6" :question/problem "Let $u=⟨-3,2,1⟩$ and $v=⟨4,-4,8⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -3 & 2 & 1 \\\\ 4 & -4 & 8\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ -4 & 8\\end{vmatrix}i-\\begin{vmatrix}-3 & 1 \\\\ 4 & 8\\end{vmatrix}j+\\begin{vmatrix}-3 & 2 \\\\ 4 & -4\\end{vmatrix}k \\\\  & =((2)(8)-(1)(-4))i-((-3)(8)-(1)(4))j+((-3)(-4)-(2)(4))k \\\\  & =(16-(-4))i-(-24-(4))j+(12-(8))k \\\\  & =20i+28j+4k \\\\  & =⟨20,28,4⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540499 :question/answer-fields [{:db/id #edb/ref 17592186540493}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c879baa4-8bcb-559c-9780-708721266a3e" :question/problem "Let $u=-\\frac{6}{5}i+2j+k$ and $v=-\\frac{7}{2}i-4j+6k.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -\\frac{6}{5} & 2 & 1 \\\\ -\\frac{7}{2} & -4 & 6\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ -4 & 6\\end{vmatrix}i-\\begin{vmatrix}-\\frac{6}{5} & 1 \\\\ -\\frac{7}{2} & 6\\end{vmatrix}j+\\begin{vmatrix}-\\frac{6}{5} & 2 \\\\ -\\frac{7}{2} & -4\\end{vmatrix}k \\\\  & =((2)(6)-(1)(-4))i-(\\left(-\\frac{6}{5}\\right)(6)-(1)\\left(-\\frac{7}{2}\\right))j+(\\left(-\\frac{6}{5}\\right)(-4)-(2)\\left(-\\frac{7}{2}\\right))k \\\\  & =(12-(-4))i-(-\\frac{36}{5}-\\left(-\\frac{7}{2}\\right))j+(\\frac{24}{5}-(-7))k \\\\  & =16i+\\frac{37}{10}j+\\frac{59}{5}k \\\\  & =⟨16,\\frac{37}{10},\\frac{59}{5}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542353 :question/answer-fields [{:db/id #edb/ref 17592186542358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "036a544e-adcf-5604-8565-d9b2d689152b" :question/problem "Find $k$, if $4{a}_{1}+k{a}_{2}=0$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}.\n$$" :question/retired true :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $k$ term, we get\n\n$$\n\\begin{aligned}4{a}_{1}+k{a}_{2} & =0 \\\\ 4\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}+k\\begin{bmatrix}2 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ k\\begin{bmatrix}2 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}-4\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} \\\\ k\\begin{bmatrix}2 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}-8 \\\\ -16\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the first components, we get\n\n$$\n2k=-8\\,⟹\\,k=-4.\n$$\n\nBut then\n\n$$\n\\begin{aligned}-4\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ -8\\end{bmatrix}\\ne \\begin{bmatrix}-8 \\\\ -16\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, there is no $k$ such that $4{a}_{1}+k{a}_{2}=0.$"}] [{:db/id #edb/ref 17592186542366 :question/answer-fields [{:db/id #edb/ref 17592186542355}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5e9f97a-8dbd-5e5f-adc8-0ae163476518" :question/problem "Find $k$, if $3{a}_{1}+k{a}_{2}=0$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}.\n$$" :question/retired true :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $k$ term, we get\n\n$$\n\\begin{aligned}3{a}_{1}+k{a}_{2} & =0 \\\\ 3\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}+k\\begin{bmatrix}3 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ k\\begin{bmatrix}3 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}-3\\begin{bmatrix}2 \\\\ 2\\end{bmatrix} \\\\ k\\begin{bmatrix}3 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}-6 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the first components, we get\n\n$$\n3k=-6\\,⟹\\,k=-2.\n$$\n\nBut then\n\n$$\n\\begin{aligned}-2\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-6 \\\\ -4\\end{bmatrix}\\ne \\begin{bmatrix}-6 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, there is no $k$ such that $3{a}_{1}+k{a}_{2}=0.$"}] [{:db/id #edb/ref 17592186544819 :question/answer-fields [{:db/id #edb/ref 17592186544657}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58e03782-f890-5578-a853-4a903526c725" :question/math-academy-id "q-280718" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=⟨1,2,k⟩$, $\\mathbf{b}=⟨-3,0,4⟩$, and $\\mathbf{c}=⟨2,-1,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}1 & 2 & k \\\\ -3 & 0 & 4 \\\\ 2 & -1 & 5\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}0 & 4 \\\\ -1 & 5\\end{vmatrix}-2\\cdot \\begin{vmatrix}-3 & 4 \\\\ 2 & 5\\end{vmatrix}+k\\cdot \\begin{vmatrix}-3 & 0 \\\\ 2 & -1\\end{vmatrix} \\\\  & =1(0\\cdot 5-4\\cdot (-1))-2((-3)\\cdot 5-4\\cdot 2)+k((-3)\\cdot (-1)-0\\cdot 2) \\\\  & =4-2(-15-8)+3k \\\\  & =50+3k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 50+3k & =0 \\\\ k & =-\\frac{50}{3}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{50}{3}.$"}] [{:db/id #edb/ref 17592186544855 :question/answer-fields [{:db/id #edb/ref 17592186544716}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9ce41098-082c-5659-8a15-6d5205341359" :question/math-academy-id "q-73747" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(-1,1,1)$, $B(2,-2,1)$, $C(1,2,2)$, and $D(2,-1,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i-2j+k)-(-i+j+k) \\\\  & =3i-3j \\\\  & =⟨3,-3,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+2j+2k)-(-i+j+k) \\\\  & =2i+j+k \\\\  & =⟨2,1,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i-j+4k)-(-i+j+k) \\\\  & =3i-2j+3k \\\\  & =⟨3,-2,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & -3 & 0 \\\\ 2 & 1 & 1 \\\\ 3 & -2 & 3\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}1 & 1 \\\\ -2 & 3\\end{vmatrix}-(-3)\\cdot \\begin{vmatrix}2 & 1 \\\\ 3 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}2 & 1 \\\\ 3 & -2\\end{vmatrix} \\\\  & =3(1\\cdot 3-(-2)\\cdot 1)+3(2\\cdot 3-3\\cdot 1)+0 \\\\  & =15+9 \\\\  & =24.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|24|=24.\n$$"}] [{:db/id #edb/ref 17592186545820 :question/answer-fields [{:db/id #edb/ref 17592186545752}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e7c8be1-d271-506d-bfc9-fbf1881a88d8" :question/math-academy-id "q-142489" :question/problem "Find $\\text{rank}(A)$ given that $$\n\\displaystyle \\text{Null}(A)=\\left\\{\\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}+{x}_{2} \\\\ 0 \\\\ 0\\end{bmatrix}\\right.\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}.\n$$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =5 \\\\ \\text{rank}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545837 :question/answer-fields [{:db/id #edb/ref 17592186545699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94febb74-e81c-5137-a80c-9d7fa83538e0" :question/math-academy-id "q-141229" :question/problem "Let $A$ be a $4\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545857 :question/answer-fields [{:db/id #edb/ref 17592186545765}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c10d4c77-93c5-52a9-900d-275fa9299d3e" :question/math-academy-id "q-79410" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}\\right\\}?\n$$\n\nI. $\\text{rank}(A)=2$\n\nII. $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}$\n\nIII. $A$ has $2$ pivot colums" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $$\n\\displaystyle \\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{4} \\\\ \\text{dim(Col}(A)) &=4=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the non-zero vector\n\n$$\n\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}\n$$\n\nspans $\\text{Null}(A),$ we conclude that $\\text{nullity}(A)=1.$ So, by the rank-nullity theorem, with $n=4$,  we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, since $\\text{dim(Col}(A))=\\text{rank}(A)=3,$ we must have  that $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}.$\n\n- Statement III is false. The fact that $\\text{dim(Col}(A))=3$ implies that the number of pivot columns in $A$ is also equal to $3.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186547285 :question/answer-fields [{:db/id #edb/ref 17592186547287}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d36ecf41-14d3-5c33-b433-31e0dcd3d9be" :question/problem "If $P$ is a $12\\times 9$ matrix that has $4$ **non-pivot** columns, then $\\text{rank}(P)=$" :question/worked-solution "We know that $\\text{rank}(P)$ is the number of pivot columns in $P.$ \n\nSince $P$ has $9$ columns and $4$ of them are non-pivots, then the number of pivot columns in $P$ is \n\n$$\n9-4=5.\n$$\n\nTherefore, $\\text{rank}(P)=5.$"}] [{:db/id #edb/ref 17592186547289 :question/answer-fields [{:db/id #edb/ref 17592186547282}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed8ba18a-6f66-543b-bfae-4f1da3ae9419" :question/problem "Let $A$ be a $12\\times 7$ matrix that has $1$ **pivot** column. What is the rank of the matrix?" :question/retired true :question/worked-solution "We know that $\\text{rank}(A)$ is the number of pivot columns in $A.$ \n\nSince we are told that $A$ has $1$ pivot column, we have \n\n$$\n\\text{rank}(A)=1.\n$$"}] [{:db/id #edb/ref 17592186549053 :question/answer-fields [{:db/id #edb/ref 17592186548973}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d68af87f-be02-55a7-9b78-0da04db4e309" :question/math-academy-id "q-79345" :question/problem "Consider the matrices given below. Find $\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=\\begin{bmatrix}1 & -1 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}1 & -2 & 4 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & -4 & 1 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $1$ pivot column and $2$ non-pivot columns (namely, the $2$nd and $3$rd columns). So, \n\n$$\n\\text{dim(Null}(A))=2.\n$$\n\n- The matrix $B$ has $3$ pivot columns and $1$ non-pivot column (namely, the $4$th column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- The matrix $C$ has $3$ pivot columns and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(C))=1.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=2+1+1=4.\n$$"}] [{:db/id #edb/ref 17592186551247 :question/answer-fields [{:db/id #edb/ref 17592186551101}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "231b9e48-9ef0-506b-a5a1-fc73da681086" :question/math-academy-id "q-42916" :question/problem "Calculate the value of \n$$\n\\displaystyle \\,\\begin{vmatrix}-1 & 3 & -2 & 1 \\\\ 3 & -4 & -1 & 3 \\\\ -2 & 1 & -5 & 2 \\\\ 4 & -3 & 1 & -4\\end{vmatrix}.\n$$\n\n*Hint: Use elementary row operations to make the entries below ${a}_{14}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries below ${a}_{14}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}-1 & 3 & -2 & 1 \\\\ 3 & -4 & -1 & 3 \\\\ -2 & 1 & -5 & 2 \\\\ 4 & -3 & 1 & -4\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ {R}_{4}:={R}_{4}+4{R}_{1}\\end{aligned} \\\\  & =\\begin{vmatrix}-1 & 3 & -2 & 1 \\\\ 6 & -13 & 5 & 0 \\\\ 0 & -5 & -1 & 0 \\\\ 0 & 9 & -7 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $4$th column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}-1 & 3 & -2 & 1 \\\\ 6 & -13 & 5 & 0 \\\\ 0 & -5 & -1 & 0 \\\\ 0 & 9 & -7 & 0\\end{vmatrix} \\\\  & =1\\cdot (-1)^{1+4}\\begin{vmatrix}6 & -13 & 5 \\\\ 0 & -5 & -1 \\\\ 0 & 9 & -7\\end{vmatrix} \\\\  & =-\\begin{vmatrix}6 & -13 & 5 \\\\ 0 & -5 & -1 \\\\ 0 & 9 & -7\\end{vmatrix} \\\\  & =(-1)\\cdot 6\\cdot (-1)^{1+1}\\begin{vmatrix}-5 & -1 \\\\ 9 & -7\\end{vmatrix} \\\\  & =-6(35-(-9)) \\\\  & =-264.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551268 :question/answer-fields [{:db/id #edb/ref 17592186551089}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4038f08b-56e1-5740-bb03-adc638c1a6b4" :question/math-academy-id "q-91219" :question/problem "$$\n\\begin{vmatrix}1 & 3 & 1 & -4 \\\\ -4 & 2 & 2 & 1 \\\\ 5 & -2 & -1 & 3 \\\\ 7 & -1 & -2 & 2\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{13}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{13}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 3 & 1 & -4 \\\\ -4 & 2 & 2 & 1 \\\\ 5 & -2 & -1 & 3 \\\\ 7 & -1 & -2 & 2\\end{vmatrix} &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-1){C}_{3} \\\\ {C}_{2}:={C}_{2}+(-3){C}_{3} \\\\ {C}_{4}:={C}_{4}+4{C}_{3}\\end{aligned} \\\\  & =\\begin{vmatrix}0 & 0 & 1 & 0 \\\\ -6 & -4 & 2 & 9 \\\\ 6 & 1 & -1 & -1 \\\\ 9 & 5 & -2 & -6\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}0 & 0 & 1 & 0 \\\\ -6 & -4 & 2 & 9 \\\\ 6 & 1 & -1 & -1 \\\\ 9 & 5 & -2 & -6\\end{vmatrix} \\\\  & =1\\cdot (-1)^{1+3}\\begin{vmatrix}-6 & -4 & 9 \\\\ 6 & 1 & -1 \\\\ 9 & 5 & -6\\end{vmatrix} \\\\  & =\\begin{vmatrix}-6 & -4 & 9 \\\\ 6 & 1 & -1 \\\\ 9 & 5 & -6\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551271 :question/answer-fields [{:db/id #edb/ref 17592186551125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45127938-c6a2-5a13-8b44-5358b2433862" :question/math-academy-id "q-42930" :question/problem "$$\n\\begin{vmatrix}1 & 3 & 1 & -2 \\\\ -2 & -1 & -2 & 5 \\\\ 1 & 3 & -1 & 2 \\\\ -1 & -2 & 3 & 2\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{33}$ equal to zero.*" :question/worked-solution "Let's make entries above and below ${a}_{33}=-1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 3 & 1 & -2 \\\\ -2 & -1 & -2 & 5 \\\\ 1 & 3 & -1 & 2 \\\\ -1 & -2 & 3 & 2\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+{R}_{3} \\\\ {R}_{2}:={R}_{2}+(-2){R}_{3} \\\\ {R}_{4}:={R}_{4}+3{R}_{3}\\end{aligned} \\\\  & =\\begin{vmatrix}2 & 6 & 0 & 0 \\\\ -4 & -7 & 0 & 1 \\\\ 1 & 3 & -1 & 2 \\\\ 2 & 7 & 0 & 8\\end{vmatrix}\\end{aligned}\n$$\n\nExpanding the result along the $3$rd column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}2 & 6 & 0 & 0 \\\\ -4 & -7 & 0 & 1 \\\\ 1 & 3 & -1 & 2 \\\\ 2 & 7 & 0 & 8\\end{vmatrix} \\\\  & =(-1)\\cdot (-1)^{3+3}\\begin{vmatrix}2 & 6 & 0 \\\\ -4 & -7 & 1 \\\\ 2 & 7 & 8\\end{vmatrix} \\\\  & =-\\begin{vmatrix}2 & 6 & 0 \\\\ -4 & -7 & 1 \\\\ 2 & 7 & 8\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551282 :question/answer-fields [{:db/id #edb/ref 17592186551202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "634c0345-e97a-5738-8ae3-640a8e78ce93" :question/math-academy-id "q-132023" :question/problem "$$\n\\begin{vmatrix}3 & 1 & 7 & -5 \\\\ -2 & 9 & -2 & 7 \\\\ 5 & 3 & 6 & 6 \\\\ 1 & -2 & 3 & -1\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the right of ${a}_{41}$ equal to zero.*" :question/worked-solution "Let's make entries to the right of ${a}_{41}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}3 & 1 & 7 & -5 \\\\ -2 & 9 & -2 & 7 \\\\ 5 & 3 & 6 & 6 \\\\ 1 & -2 & 3 & -1\\end{vmatrix} &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+2{C}_{1} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{1} \\\\ {C}_{4}:={C}_{4}+{C}_{1}\\end{aligned} \\\\  & =\\begin{vmatrix}3 & 7 & -2 & -2 \\\\ -2 & 5 & 4 & 5 \\\\ 5 & 13 & -9 & 11 \\\\ 1 & 0 & 0 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}3 & 7 & -2 & -2 \\\\ -2 & 5 & 4 & 5 \\\\ 5 & 13 & -9 & 11 \\\\ 1 & 0 & 0 & 0\\end{vmatrix} \\\\  & =1\\cdot (-1)^{4+1}\\begin{vmatrix}7 & -2 & -2 \\\\ 5 & 4 & 5 \\\\ 13 & -9 & 11\\end{vmatrix} \\\\  & =-\\begin{vmatrix}7 & -2 & -2 \\\\ 5 & 4 & 5 \\\\ 13 & -9 & 11\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551323 :question/answer-fields [{:db/id #edb/ref 17592186551137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "adab6899-9f13-599d-9b9d-313f4a53055c" :question/math-academy-id "q-91173" :question/problem "$$\n\\begin{vmatrix}-1 & -2 & 5 & -3 \\\\ 1 & -1 & 2 & 2 \\\\ 5 & 3 & 4 & -2 \\\\ 2 & 0 & 3 & 1\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries above ${a}_{44}$ equal to zero.*" :question/worked-solution "Let's make entries above ${a}_{44}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}-1 & -2 & 5 & -3 \\\\ 1 & -1 & 2 & 2 \\\\ 5 & 3 & 4 & -2 \\\\ 2 & 0 & 3 & 1\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{4} \\\\ {R}_{2}:={R}_{2}+(-2){R}_{4} \\\\ {R}_{3}:={R}_{3}+2{R}_{4}\\end{aligned} \\\\  & =\\begin{vmatrix}5 & -2 & 14 & 0 \\\\ -3 & -1 & -4 & 0 \\\\ 9 & 3 & 10 & 0 \\\\ 2 & 0 & 3 & 1\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $4$th column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}5 & -2 & 14 & 0 \\\\ -3 & -1 & -4 & 0 \\\\ 9 & 3 & 10 & 0 \\\\ 2 & 0 & 3 & 1\\end{vmatrix} \\\\  & =1\\cdot (-1)^{4+4}\\begin{vmatrix}5 & -2 & 14 \\\\ -3 & -1 & -4 \\\\ 9 & 3 & 10\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & -2 & 14 \\\\ -3 & -1 & -4 \\\\ 9 & 3 & 10\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555762 :question/answer-fields [{:db/id #edb/ref 17592186555660}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc73948-1028-504a-8a43-9f0c9272154c" :question/math-academy-id "q-110462" :question/problem "Consider $$\n\\displaystyle E=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by multiplying the second row of ${I}_{3}$ by $-\\frac{1}{3}:$\n\n$$\n\\begin{aligned}{I}_{3} & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{2}:=-\\frac{1}{3}{R}_{2}$ to $A.$"}] [{:db/id #edb/ref 17592186555780 :question/answer-fields [{:db/id #edb/ref 17592186555667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d00f9e4-bc18-5599-a1c2-2f30832c80ab" :question/math-academy-id "q-42537" :question/problem "Consider $$\n\\displaystyle E=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by taking the first row of ${I}_{3}$ and subtracting the third row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}-{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}-{R}_{3}$ to $A.$"}] [{:db/id #edb/ref 17592186555789 :question/answer-fields [{:db/id #edb/ref 17592186555754}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "382e043a-e5b7-50fb-a8b9-9a5ba4e6f38b" :question/math-academy-id "q-94869" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nI. $$\n\\displaystyle \\left\\{\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\right\\}\n$$ is a linearly independent set in ${\\text{M}}_{2}(R)$\n\nII. $$\n\\displaystyle \\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}\n$$ can be expressed as a linear combination of $$\n\\displaystyle \\left\\{\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\right\\}\n$$\n\nIII. $$\n\\displaystyle \\left\\{\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\right\\}\n$$ is a basis of ${\\text{M}}_{2}(R)$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is false. Notice that\n\n$$\n0\\cdot \\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix}+1\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}+1\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nwhere some coefficients are nonzero, so the set is linearly dependent.\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}=(-1)\\cdot \\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix}+0\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\n- Statement III is false. Since the set is not linearly independent, it can't form a basis.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186555791 :question/answer-fields [{:db/id #edb/ref 17592186555747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a8b7714-d243-5a18-865d-0e2cf918670b" :question/math-academy-id "q-110463" :question/problem "Consider $$\n\\displaystyle E=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 7 & 0 & 1\\end{bmatrix}\n$$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by taking the third row of ${I}_{3}$ and adding $7$ times the first row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 7 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{3}:={R}_{3}+7{R}_{1}$ to $A.$"}] [{:db/id #edb/ref 17592186555797 :question/answer-fields [{:db/id #edb/ref 17592186555680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44c4828d-5d0a-5c06-aad5-ea02f733cf44" :question/math-academy-id "q-110476" :question/problem "Suppose that the elementary row operation \n${R}_{3}:=\\frac{2}{5}{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{3}:=\\frac{2}{5}{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :=\\frac{2}{5}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{2}{5}\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{2}{5}\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186555812 :question/answer-fields [{:db/id #edb/ref 17592186555691}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e29c468-7ba6-5997-83d8-49458f8bde8e" :question/math-academy-id "q-110470" :question/problem "Suppose that the elementary row operation ${R}_{1}:={R}_{1}+2{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+2{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+2{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186555820 :question/answer-fields [{:db/id #edb/ref 17592186555715}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7135217a-2b68-531f-be98-4ee4582b3546" :question/math-academy-id "q-36478" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of a vector space $V.$\n\nWhich of the following statements are true?\n\nI. $\\{{b}_{1},{b}_{2}+{b}_{3},{b}_{3}\\}$ is a basis of $V$\n\nII. $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{2}\\}$ is linearly independent\n\nIII. $\\{{b}_{1},{b}_{1}+{b}_{2}\\}$ is a basis of $V$" :question/worked-solution "Since $B$ is a basis, the following properties must hold:\n\n- $B$ is a maximally linearly independent set of vectors in $V,$ and\n\n- $B$ spans $V.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}({b}_{2}+{b}_{3})+{x}_{3}{b}_{3} & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+({x}_{2}+{x}_{3}){b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since $\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{2}+{x}_{3}=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\\right.\n$$\n\nAlso, $\\{{b}_{1},{b}_{2}+{b}_{3},{b}_{3}\\}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of $\\{{b}_{1},{b}_{2}+{b}_{3},{b}_{3}\\}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}={x}_{1}{b}_{1}+{x}_{2}({b}_{2}+{b}_{3})+({x}_{3}-{x}_{2}){b}_{3}\n$$\n\n- Statement II is false. Since ${b}_{1}+{b}_{2}$ is a linear combination of ${b}_{1}$ and ${b}_{2}$, the given set is linearly dependent.\n\n- Statement III is false since the vector ${b}_{3}$ can't be written as a linear combination of $\\{{b}_{1},{b}_{1}+{b}_{2}\\}.$ But then\n\n$$\n\\begin{aligned}{b}_{3} & ={x}_{1}{b}_{1}+{x}_{2}({b}_{1}+{b}_{2}) \\\\  & =({x}_{1}+{x}_{2}){b}_{1}+{x}_{2}{b}_{2},\\end{aligned}\n$$\n\nwhich would mean that $B$ is linearly dependent. This would contradict the fact that $B$ is a basis.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186555834 :question/answer-fields [{:db/id #edb/ref 17592186555695}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "941b6a8e-c424-5e02-9c9b-4d19cc52c2d6" :question/math-academy-id "q-75162" :question/problem "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{1}↔{R}_{2},\\,{R}_{3}:={R}_{3}-4{R}_{1},\\,{R}_{1}:=-8{R}_{1}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{3}:={R}_{3}-4{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{1}:=-8{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :=-8{R}_{1} \\\\  & ∼\\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n\\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186555837 :question/answer-fields [{:db/id #edb/ref 17592186555690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a623800-a9e7-562e-b4c1-2e4906af2084" :question/math-academy-id "q-107127" :question/problem "Consider the vector space ${R}_{2}[t]$ of all polynomials in the variable $t$ over $R$ with degrees at most $2.$\n\nWhich of the following statements are true?\n\nI. $\\{1,t,t+1\\}$ is a linearly independent set in ${R}_{2}[t]$\n\nII. $2t+1$ can be expressed as a linear combination of $\\{1,t,t+1\\}$\n\nIII. $\\{1,t,t+1\\}$ is a basis of ${R}_{2}[t]$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is false. Notice that \n\n$$\n1\\cdot 1+1\\cdot t+(-1)\\cdot (t+1)=0,\n$$\n\n \nwhere all three coefficients are nonzero, so the set is linearly dependent.\n\n- Statement II is true. Indeed,\n\n$$\n2t+1=0\\cdot 1+1\\cdot t+1\\cdot (t+1).\n$$\n\n- Statement III is false. Since the set is not linearly independent, it can't form a basis.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186555847 :question/answer-fields [{:db/id #edb/ref 17592186555687}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab0273b9-503a-530e-8fea-6b6048661bee" :question/math-academy-id "q-107535" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nI. $$\n\\displaystyle \\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\right\\}\n$$ is a linearly independent set in ${\\text{M}}_{2}(R)$\n\nII. $$\n\\displaystyle \\begin{bmatrix}2 & 3 \\\\ 0 & 2\\end{bmatrix}\n$$ can be expressed as a linear combination of $$\n\\displaystyle \\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\right\\}\n$$\n\nIII. $$\n\\displaystyle \\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\right\\}\n$$ is a basis of ${\\text{M}}_{2}(R)$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation\n\n$$\n{x}_{1}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+{x}_{2}\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+{x}_{3}\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nis true if and only if ${x}_{1}={x}_{2}={x}_{3}=0.$ So the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 0 & 2\\end{bmatrix}=2\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+3\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+0\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\n- Statement III is false. For example, the matrix $$\n\\displaystyle \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$ can't be written as a linear combination of \n\n$$\n\\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\right\\}\n$$\n\nsince all these linear combinations result in matrices with the entry ${a}_{11}={a}_{22}:$\n\n$$\na\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+b\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+c\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ c & a\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186555861 :question/answer-fields [{:db/id #edb/ref 17592186555654}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da9b8a15-279d-5af5-bedd-335abf7ae54a" :question/math-academy-id "q-107132" :question/problem "Consider the vector space ${R}_{3}[t]$ of all polynomials in the variable $t$ over $R$ with degrees at most $3.$\n\nWhich of the following statements are true?\n\nI. $\\{t,{t}^{2},{t}^{3}\\}$ is a linearly independent set in ${R}_{3}[t]$\n\nII. $3t-2{t}^{3}$ can be expressed as a linear combination of $\\{t,{t}^{2},{t}^{3}\\}$\n\nIII. $\\{t,{t}^{2},{t}^{3}\\}$ is a basis of ${R}_{3}[t]$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation \n\n$$\n{x}_{1}\\cdot t+{x}_{2}\\cdot {t}^{2}+{x}_{3}\\cdot {t}^{3}=0,\n$$\n\n \nis true if and only if ${x}_{1}={x}_{2}={x}_{3}=0.$ So, the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n3t-2{t}^{3}=3\\cdot t+0\\cdot {t}^{2}+(-2)\\cdot {t}^{3}.\n$$\n\n- Statement III is false. For example, the polynomial $1+t$ can't be written as a linear combination of the set\n$\\{t,{t}^{2},{t}^{3}\\}.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186555871 :question/answer-fields [{:db/id #edb/ref 17592186555684}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f4424f4e-4e2c-59a3-8d15-5c180b952f0f" :question/math-academy-id "q-107938" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of a vector space $V.$ \n\nWhich of the following statements are true?\n\nI. $\\{{b}_{2},{b}_{3}\\}$ is linearly independent\n\nII. $\\{{b}_{1},{b}_{2},{b}_{3},w\\}$ is a basis of $V$\n\nIII. $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{3}\\}$ is linearly independent" :question/worked-solution "Since $B$ is a basis, the following properties must hold:\n\n- $B$ is a maximally linearly independent set of vectors in $V,$ and\n\n- $B$ spans $V.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, if $\\{{b}_{2},{b}_{3}\\}$ is linearly dependent then there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{b}_{2}+{x}_{2}{b}_{3}=0,\n$$\n\nwhere at least one of $x$'s is not zero. But then \n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+0{b}_{3}=0,\n$$\n\nwhich would mean that $B$ is linearly dependent. This would contradict the fact that $B$ is a basis.\n\n- Statement II is false. Since $B$ is a basis of $V,$ it is a maximally linearly independent set of vectors. This means that if we add any new vector to the set, it becomes linearly dependent. Hence, the given set is not a basis for $V.$\n\n- Statement III is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}({b}_{1}+{b}_{3}) & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}({x}_{1}+{x}_{3}){b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since $\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{3}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\\right.\n$$\n\nAlso, $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{3}\\}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{3}\\}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}=({x}_{1}-{x}_{3}){b}_{1}+{x}_{2}{b}_{2}+{x}_{3}({b}_{1}+{b}_{3})\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186557414 :question/answer-fields [{:db/id #edb/ref 17592186557436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d5b5966-d0b2-51ba-a7a1-c76ebe8e6658" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ 2x+ky &=-8\\end{aligned}\\right.\n$$" :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 0 & k-6 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ (k-6)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"}] [{:db/id #edb/ref 17592186557415 :question/answer-fields [{:db/id #edb/ref 17592186557422}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "364e838c-b667-5333-9687-aeee90961e0c" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ -2x+ky &=5\\end{aligned}\\right.\n$$" :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ -2 & k & 5\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ -2 & k & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ 0 & k+4 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ (k+4)y &=-3.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-3,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"}] [{:db/id #edb/ref 17592186557416 :question/answer-fields [{:db/id #edb/ref 17592186557435}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4508cab0-6e88-59d6-a9c3-7b9fc61a9c9d" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-2y &=5 \\\\ 3x+ky &=3\\end{aligned}\\right.\n$$" :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 3 & k & 3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 3 & k & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 0 & k+6 & -12\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=5 \\\\ (k+6)y &=-12.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-6,$ then the second equation is $0=-12,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-6.$"}] [{:db/id #edb/ref 17592186557419 :question/answer-fields [{:db/id #edb/ref 17592186557441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "550c7cdf-5810-56e4-b192-4674132b8147" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-4 \\\\ 2x+ky &=-3\\end{aligned}\\right.\n$$" :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 2 & k & -3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 2 & k & -3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 0 & k+6 & 5\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-4 \\\\ (k+6)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-6,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-6.$"}] [{:db/id #edb/ref 17592186557444 :question/answer-fields [{:db/id #edb/ref 17592186557423}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f4f00ddd-faa4-5195-9569-dbec2d0e2e6c" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-5 \\\\ -2x+ky &=0\\end{aligned}\\right.\n$$" :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ -2 & k & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ -2 & k & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ 0 & k+4 & -10\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-5 \\\\ (k+4)y &=-10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"}] [{:db/id #edb/ref 17592186557520 :question/answer-fields [{:db/id #edb/ref 17592186557517}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4149b33c-f03c-5dc8-a587-d4628af75acd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-4z+2w &=22 \\\\ 2x+y-z+8w &=16 \\\\ 2x+4w &=12.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & -2 & -4 & 2 & 22 \\\\ 2 & 1 & -1 & 8 & 16 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & -2 & -4 & 2 & 22 \\\\ 2 & 1 & -1 & 8 & 16 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 2 & 1 & -1 & 8 & 16 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 3 & 3 & 6 & -6 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 3 & 3 & 6 & -6 \\\\ 0 & 2 & 4 & 2 & -10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 2 & 4 & 2 & -10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 0 & 2 & -2 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 0 & -1 & 5 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 2 & 6 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2w &=6 \\\\ y+3w &=1 \\\\ z-w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2w+6 \\\\ y &=-3w+1 \\\\ z &=w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-2w+6 \\\\ -3w+1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557532 :question/answer-fields [{:db/id #edb/ref 17592186557505}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6907b90d-7d23-51a7-95a1-476aee7d4fa3" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y-4z+2w &=-30 \\\\ x+4y+z+7w &=-12 \\\\ -2x-4y+4z-4w &=40.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & -4 & 2 & -30 \\\\ 1 & 4 & 1 & 7 & -12 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & -4 & 2 & -30 \\\\ 1 & 4 & 1 & 7 & -12 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 1 & 4 & 1 & 7 & -12 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 3 & 3 & 6 & 3 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 3 & 3 & 6 & 3 \\\\ 0 & -2 & 0 & -2 & 10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 1 & 2 & 1 \\\\ 0 & -2 & 0 & -2 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 1 & 2 & 1 \\\\ 0 & 0 & 2 & 2 & 12\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 1 & 2 & 1 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 0 & 1 & -5 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & 3 & -3 \\\\ 0 & 1 & 0 & 1 & -5 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 2 & 2 \\\\ 0 & 1 & 0 & 1 & -5 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2w &=2 \\\\ y+w &=-5 \\\\ z+w &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2w+2 \\\\ y &=-w-5 \\\\ z &=-w+6 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-2w+2 \\\\ -w-5 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557536 :question/answer-fields [{:db/id #edb/ref 17592186557554}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "867f3ffb-700b-5ac6-8627-7d43c2d36663" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y-4z-18w &=20 \\\\ -2x-y+7z+24w &=-20 \\\\ x+y-z-5w &=2.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -18 & 20 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -18 & 20 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 3 & 3 & 6 & 0 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 3 & 3 & 6 & 0 \\\\ 0 & -1 & 1 & 4 & -8\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & -1 & 1 & 4 & -8\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & 0 & 2 & 6 & -8\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -3 & 2 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -1 & -6 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-w &=-6 \\\\ y-w &=4 \\\\ z+3w &=-4.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=w-6 \\\\ y &=w+4 \\\\ z &=-3w-4 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}w-6 \\\\ w+4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557548 :question/answer-fields [{:db/id #edb/ref 17592186557523}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a510fef8-28cf-5858-9f70-47fb3be2fcfd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y-4z-26w &=-20 \\\\ 2x+7y+2z-23w &=-17 \\\\ -2x-5y+4z+29w &=25.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -26 & -20 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -26 & -20 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 3 & 6 & 3 & 3 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 3 & 6 & 3 & 3 \\\\ 0 & -1 & 0 & 3 & 5\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & -1 & 0 & 3 & 5\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & 0 & 2 & 4 & 6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -9 & -4 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -3 & 6 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3w &=6 \\\\ y-3w &=-5 \\\\ z+2w &=3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3w+6 \\\\ y &=3w-5 \\\\ z &=-2w+3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557549 :question/answer-fields [{:db/id #edb/ref 17592186557562}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6f0b47a-f445-55ab-8fc9-cbed8ed9f994" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+4z &=-16 \\\\ -2x+y+5z &=10 \\\\ -x-2y-5z &=10.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -16 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -16 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 3 & 9 & -6 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & -1 & -3 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -1 & -6 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=-6 \\\\ y+3z &=-2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=z-6 \\\\ y &=-3z-2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557551 :question/answer-fields [{:db/id #edb/ref 17592186557513}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adb0568a-cc33-548d-9e70-7aec30b5b6bd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+14z &=-6 \\\\ x+4y+16z &=-18 \\\\ -2x-4y-20z &=16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 3 & 9 & -15 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & -2 & -6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & 2 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=2 \\\\ y+3z &=-5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z+2 \\\\ y &=-3z-5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557557 :question/answer-fields [{:db/id #edb/ref 17592186557521}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7e5dc6c-e550-5c9b-8c75-fe188ef23a8b" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+2z-8w &=-22 \\\\ -x+2y+2z-2w &=-16 \\\\ x+2y+4z-12w &=-26.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 2 & -6 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & -1 & -8 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2w &=-2 \\\\ y+w &=-6 \\\\ z-3w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2w-2 \\\\ y &=-w-6 \\\\ z &=3w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557558 :question/answer-fields [{:db/id #edb/ref 17592186557508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d05ea200-995d-55b2-a1b7-0a4ae934dd54" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y-8z &=-16 \\\\ 2x-y+4z &=-10 \\\\ 2x-5y-12z &=-18.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 3 & 12 & 6 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & -1 & -4 & -2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=-4 \\\\ y+4z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z-4 \\\\ y &=-4z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557567 :question/answer-fields [{:db/id #edb/ref 17592186557546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f34874f6-66c0-58d0-a503-ac8424ffc0ef" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-2z &=-16 \\\\ 2x+y+7z &=-1 \\\\ 2x+4z &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 3 & 9 & 15 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 2 & 6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -3 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2z &=-3 \\\\ y+3z &=5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2z-3 \\\\ y &=-3z+5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557569 :question/answer-fields [{:db/id #edb/ref 17592186557514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6291f54-74fa-5018-8da1-0d69f2fed16a" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+2z &=-4 \\\\ -2x+5y-14z &=22 \\\\ 2x-4y+10z &=-16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 3 & -12 & 18 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & -2 & 8 & -12\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 4 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3z &=4 \\\\ y-4z &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3z+4 \\\\ y &=4z+6 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186559789 :question/answer-fields [{:db/id #edb/ref 17592186559750}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2af09a21-2c9f-5742-9701-8495f499a998" :question/math-academy-id "q-105095" :question/problem "Let $$\n\\displaystyle b=\\begin{bmatrix}-2 \\\\ -4 \\\\ 6 \\\\ 8 \\\\ 0\\end{bmatrix}.\n$$ Find $-\\frac{1}{2}b.$" :question/worked-solution "Multiplying each component of $b$ by $-\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}-\\frac{1}{2}b & =-\\frac{1}{2}\\begin{bmatrix}-2 \\\\ -4 \\\\ 6 \\\\ 8 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{2}\\cdot (-2) \\\\ -\\frac{1}{2}\\cdot (-4) \\\\ -\\frac{1}{2}\\cdot 6 \\\\ -\\frac{1}{2}\\cdot 8 \\\\ -\\frac{1}{2}\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -3 \\\\ -4 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559791 :question/answer-fields [{:db/id #edb/ref 17592186559666}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34bb1a50-1857-5b83-b60b-483ccca13301" :question/math-academy-id "q-105094" :question/problem "Let $$\n\\displaystyle a=\\begin{bmatrix}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{bmatrix}.\n$$ Find $2a.$" :question/worked-solution "Multiplying each component of $a$ by $2,$ we get\n\n$$\n\\begin{aligned}2a & =2\\begin{bmatrix}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (-7) \\\\ 2\\cdot 2 \\\\ 2\\cdot 2 \\\\ 2\\cdot (-3) \\\\ 2\\cdot 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-14 \\\\ 4 \\\\ 4 \\\\ -6 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559795 :question/answer-fields [{:db/id #edb/ref 17592186559682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/math-academy-id "q-73943" :question/problem "Let\n$$\n\\displaystyle r=\\begin{bmatrix}x-2 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{bmatrix}\n$$ and $$\n\\displaystyle s=\\begin{bmatrix}1 \\\\ 3 \\\\ x \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\nIf $r\\cdot s=7$, find the value of $x.$" :question/worked-solution "Starting from the equation $r\\cdot s=7,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =7 \\\\ (x-2)\\cdot 1+2\\cdot 3+(-3)\\cdot x+1\\cdot (-2)+1\\cdot 1 & =7 \\\\ x-2+6-3x-2+1 & =7 \\\\ -2x+3 & =7 \\\\ 2x & =-4 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-2.$"}] [{:db/id #edb/ref 17592186559803 :question/answer-fields [{:db/id #edb/ref 17592186559681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "457dac21-00fa-5025-808b-b3e414ce1988" :question/math-academy-id "q-35096" :question/problem "Let $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ 2 \\\\ -5 \\\\ 0 \\\\ -1\\end{bmatrix}\n$$ and $$\n\\displaystyle c=\\begin{bmatrix}3 \\\\ -4 \\\\ 8 \\\\ 7\\end{bmatrix}.\n$$ Find $b+c.$" :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ 2 \\\\ -5 \\\\ 0 \\\\ -1\\end{bmatrix}\n$$ has $5$ components as it lies in ${R}^{5}.$\n\n- The vector $$\n\\displaystyle c=\\begin{bmatrix}3 \\\\ -4 \\\\ 8 \\\\ 7\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined."}] [{:db/id #edb/ref 17592186559834 :question/answer-fields [{:db/id #edb/ref 17592186559653}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99569175-b9f3-5c01-983c-724e408918e3" :question/math-academy-id "q-73947" :question/problem "Let $$\n\\displaystyle r=\\begin{bmatrix}3 \\\\ \\frac{2}{{x}^{2}} \\\\ 0 \\\\ x\\end{bmatrix}\n$$ and $$\n\\displaystyle s=\\begin{bmatrix}-1 \\\\ {x}^{4} \\\\ 8 \\\\ -1\\end{bmatrix}.\n$$\nIf $r\\cdot s=0$ and $x<0$, find the value of $x.$" :question/worked-solution "Starting from the equation $r\\cdot s=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 3\\cdot (-1)+\\frac{2}{{x}^{2}}\\cdot {x}^{4}+0\\cdot 8+x\\cdot (-1) & =0 \\\\ -3+2{x}^{2}+0-x & =0 \\\\ 2{x}^{2}-x-3 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-1)\\pm \\sqrt{(-1)^{2}-4(2)(-3)}}{2(2)} \\\\  & =\\frac{1\\pm \\sqrt{25}}{4} \\\\  & =\\frac{1\\pm 5}{4}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=\\frac{3}{2}$ and ${x}_{2}=-1.$ Since we need $x<0$, our final answer is $x=-1$ only."}] [{:db/id #edb/ref 17592186559836 :question/answer-fields [{:db/id #edb/ref 17592186559646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99f979f5-50b6-5282-8195-712172f0dd94" :question/math-academy-id "q-105106" :question/problem "Let $$\n\\displaystyle r=\\begin{bmatrix}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{bmatrix}\n$$ and $$\n\\displaystyle s=\\begin{bmatrix}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{bmatrix}.\n$$ What is $r\\cdot s?$" :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle r=\\begin{bmatrix}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\n- The vector $$\n\\displaystyle s=\\begin{bmatrix}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{bmatrix}\n$$ has $5$ components as it lies in ${R}^{5}.$\n\nTherefore, since the number of components does not match, the operation is undefined."}] [{:db/id #edb/ref 17592186559840 :question/answer-fields [{:db/id #edb/ref 17592186559687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/math-academy-id "q-35098" :question/problem "Let $$\n\\displaystyle u=\\begin{bmatrix}1 \\\\ 3 \\\\ 2 \\\\ 6\\end{bmatrix}\n$$ and $$\n\\displaystyle v=\\begin{bmatrix}k \\\\ 4 \\\\ -5 \\\\ k+2\\end{bmatrix}.\n$$ If $u\\cdot v=0$, find the value of $k.$" :question/worked-solution "Starting from the equation $u\\cdot v=0,$ we compute the dot product in terms of $k$ and then solve for $k$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 1\\cdot k+3\\cdot 4+2\\cdot (-5)+6\\cdot (k+2) & =0 \\\\ k+12-10+6k+12 & =0 \\\\ 7k+14 & =0 \\\\ 7k & =-14 \\\\ k & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $k=-2.$"}] [{:db/id #edb/ref 17592186559845 :question/answer-fields [{:db/id #edb/ref 17592186559644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2fb6e56-ff2e-5614-a5dd-38bf8fc25970" :question/math-academy-id "q-105101" :question/problem "Let $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 6 \\\\ 9 \\\\ 7 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle w=\\begin{bmatrix}8 \\\\ 4 \\\\ 0 \\\\ 16\\end{bmatrix}.\n$$ Find $2v+\\frac{1}{4}w.$" :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 6 \\\\ 9 \\\\ 7 \\\\ 0\\end{bmatrix}\n$$ has $5$ components as it lies in ${R}^{5}.$\n\n- The vector $$\n\\displaystyle w=\\begin{bmatrix}8 \\\\ 4 \\\\ 0 \\\\ 16\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined."}] [{:db/id #edb/ref 17592186559862 :question/answer-fields [{:db/id #edb/ref 17592186559747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdc2cbf3-48b6-588f-b958-c891b668d712" :question/math-academy-id "q-35120" :question/problem "Let $$\n\\displaystyle u=\\begin{bmatrix}-7 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 5 \\\\ 3 \\\\ 0\\end{bmatrix}.\n$$ Find $u+2v.$" :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle u=\\begin{bmatrix}-7 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$ has $3$ components as it lies in ${R}^{3}.$\n\n- The vector $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 5 \\\\ 3 \\\\ 0\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined."}] [{:db/id #edb/ref 17592186559863 :question/answer-fields [{:db/id #edb/ref 17592186559672}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ceec6370-9876-5337-a51f-c0a5305aac98" :question/math-academy-id "q-105096" :question/problem "Let $$\n\\displaystyle c=\\begin{bmatrix}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{bmatrix}.\n$$ Find $\\frac{1}{4}c.$" :question/worked-solution "Multiplying each component of $c$ by $\\frac{1}{4},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{4}c & =\\frac{1}{4}\\begin{bmatrix}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{4}\\cdot 4 \\\\ \\frac{1}{4}\\cdot 20 \\\\ \\frac{1}{4}\\cdot (-4) \\\\ \\frac{1}{4}\\cdot (-8) \\\\ \\frac{1}{4}\\cdot 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559868 :question/answer-fields [{:db/id #edb/ref 17592186559743}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc18df10-64c6-5957-81d9-6515439cccbe" :question/math-academy-id "q-73925" :question/problem "If $$\n\\displaystyle v=\\begin{bmatrix}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{bmatrix},\n$$ then $-2v=$" :question/worked-solution "Multiplying each component of $v$ by $-2,$ we get\n\n$$\n\\begin{aligned}-2v & =-2\\begin{bmatrix}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\cdot (-1) \\\\ -2\\cdot 3 \\\\ -2\\cdot 0 \\\\ -2\\cdot 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -6 \\\\ 0 \\\\ -20\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559879 :question/answer-fields [{:db/id #edb/ref 17592186559675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/math-academy-id "q-73944" :question/problem "Let\n$$\n\\displaystyle v=\\begin{bmatrix}-2 \\\\ p \\\\ 5 \\\\ -2 \\\\ -3\\end{bmatrix}\n$$ and $$\n\\displaystyle w=\\begin{bmatrix}2 \\\\ -4 \\\\ 3 \\\\ -3 \\\\ p\\end{bmatrix}.\n$$\nIf $v\\cdot w=3$, find the value of $p.$" :question/worked-solution "Starting from the equation $v\\cdot w=3,$ we compute the dot product in terms of $p$ and then solve for $p$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =3 \\\\ -2\\cdot 2+p\\cdot (-4)+5\\cdot 3+(-2)\\cdot (-3)+(-3)\\cdot p & =3 \\\\ -4-4p+15+6-3p & =3 \\\\ -7p+17 & =3 \\\\ 7p & =14 \\\\ p & =2\\end{aligned}\n$$\n\nTherefore, we conclude that $p=2.$"}] [{:db/id #edb/ref 17592186562400 :question/answer-fields [{:db/id #edb/ref 17592186562326}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "125421bb-697b-5db0-9420-c14f51cbf8ed" :question/math-academy-id "q-20959" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{array}\\right].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is \n\n$$\n\\left\\{\\begin{aligned}x-3y &=2 \\\\ 0x+0y &=0.\\end{aligned}\\right.\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-3y=2.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=2+3y,$ and the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2+3y \\\\ y &=y\\end{aligned}\\right.\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2+3y \\\\ y\\end{bmatrix}=⟨2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186562406 :question/answer-fields [{:db/id #edb/ref 17592186562288}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c4f9063-8349-57ea-b235-d134f5cba639" :question/math-academy-id "q-34572" :question/problem "Find $q$, if $2{a}_{1}+q{a}_{2}=b$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}7 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}18 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $q$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+q{a}_{2} & =b \\\\ 2\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}+q\\begin{bmatrix}7 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}18 \\\\ 4\\end{bmatrix} \\\\ q\\begin{bmatrix}7 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}18 \\\\ 4\\end{bmatrix}-2\\begin{bmatrix}2 \\\\ -3\\end{bmatrix} \\\\ q\\begin{bmatrix}7 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}14 \\\\ 10\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $q=2.$"}] [{:db/id #edb/ref 17592186562438 :question/answer-fields [{:db/id #edb/ref 17592186562331}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6154ace2-6af4-581c-9596-72c7ea4a622a" :question/math-academy-id "q-105156" :question/problem "Find $t$, if $2{a}_{1}+t{a}_{2}=0$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}8 \\\\ 1 \\\\ -6\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $t$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+t{a}_{2} & =0 \\\\ 2\\begin{bmatrix}8 \\\\ 1 \\\\ -6\\end{bmatrix}+t\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ t\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}-2\\begin{bmatrix}8 \\\\ 1 \\\\ -6\\end{bmatrix} \\\\ t\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}-16 \\\\ -2 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the first components, we get \n\n$$\n-4t=-16\\,⟹\\,t=4.\n$$\n\nBut then \n\n$$\n\\begin{aligned}4\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}-16 \\\\ -4 \\\\ 12\\end{bmatrix}\\ne \\begin{bmatrix}-16 \\\\ -2 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, there is no $t$ such that \n $2{a}_{1}+t{a}_{2}=0.$"}] [{:db/id #edb/ref 17592186562449 :question/answer-fields [{:db/id #edb/ref 17592186562233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b8162a3-2a18-5498-a3a6-ab4fdf90d980" :question/math-academy-id "q-105158" :question/problem "Find $x$, if $5a-2x=b$ and\n\n$$\na=\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}5a-2x & =b \\\\ -2x & =b-5a \\\\ x & =-\\frac{1}{2}(b-5a) \\\\ x & =-\\frac{1}{2}\\left(\\begin{bmatrix}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{bmatrix}-5\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{bmatrix}\\right) \\\\ x & =-\\frac{1}{2}\\begin{bmatrix}-8 \\\\ -6 \\\\ -6 \\\\ 4\\end{bmatrix} \\\\ x & =\\begin{bmatrix}4 \\\\ 3 \\\\ 3 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186562457 :question/answer-fields [{:db/id #edb/ref 17592186562316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "897c434c-2b3e-570b-8210-f27b51719e55" :question/math-academy-id "q-20964" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-5y &=0 \\\\ 2x-10y &=3.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." :question/worked-solution "First, we set up the augmented matrix for the system:\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -5 & 0 \\\\ 2 & -10 & 3\\end{array}\\right]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & -5 & 0 \\\\ 2 & -10 & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & 0 \\\\ 0 & 0 & 3\\end{array}\\right].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-5y &=0 \\\\ 0x+0y &=3.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0x+0y=3$ has no solution. It simplifies to $0=3,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution."}] [{:db/id #edb/ref 17592186562512 :question/answer-fields [{:db/id #edb/ref 17592186562317}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6e40000-d3bb-5e63-9aa5-9e060c0e21d3" :question/math-academy-id "q-105153" :question/problem "Find $k$, if $6{a}_{1}+k{a}_{2}=b$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}5 \\\\ 3 \\\\ -9\\end{bmatrix},\\,b=\\begin{bmatrix}8 \\\\ 0 \\\\ 6\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $k$ term, we get\n\n$$\n\\begin{aligned}6{a}_{1}+k{a}_{2} & =b \\\\ 6\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix}+k\\begin{bmatrix}5 \\\\ 3 \\\\ -9\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ 0 \\\\ 6\\end{bmatrix} \\\\ k\\begin{bmatrix}5 \\\\ 3 \\\\ -9\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ 0 \\\\ 6\\end{bmatrix}-6\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\ k\\begin{bmatrix}5 \\\\ 3 \\\\ -9\\end{bmatrix} & =\\begin{bmatrix}-10 \\\\ -6 \\\\ 18\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $k=-2.$"}] [{:db/id #edb/ref 17592186562514 :question/answer-fields [{:db/id #edb/ref 17592186562218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9fda870-d2c0-5b67-a720-dd733f4059b5" :question/math-academy-id "q-105163" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}5 \\\\ 7 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 4 \\\\ 3\\end{bmatrix},\\,b=\\begin{bmatrix}4 \\\\ -1 \\\\ -11\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}5 \\\\ 7 \\\\ -1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 4 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ -1 \\\\ -11\\end{bmatrix} \\\\ \\begin{bmatrix}5{x}_{1} \\\\ 7{x}_{1} \\\\ -{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ 4{x}_{2} \\\\ 3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ -1 \\\\ -11\\end{bmatrix} \\\\ \\begin{bmatrix}5{x}_{1}+2{x}_{2} \\\\ 7{x}_{1}+4{x}_{2} \\\\ -{x}_{1}+3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ -1 \\\\ -11\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}5{x}_{1}+2{x}_{2} &=4 \\\\ 7{x}_{1}+4{x}_{2} &=-1 \\\\ -{x}_{1}+3{x}_{2} &=-11\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $(-2)$ and adding the result to the second equation, we get\n\n$$\n\\begin{aligned}-3{x}_{1} & =-9\\,⟹\\,{x}_{1}=3.\\end{aligned}\n$$\n\nSubstituting ${x}_{1}=3$ into the first equation, we get\n\n$$\n\\begin{aligned}5(3)+2{x}_{2} & =4\\,⟹\\,{x}_{2}=-\\frac{11}{2}.\\end{aligned}\n$$\n\nFinally, substituting ${x}_{1}=3$ and ${x}_{2}=-\\frac{11}{2}$ into the third equation, we obtain\n\n$$\n\\begin{aligned}-{x}_{1}+3{x}_{2} & =-11 \\\\ -(3)+3\\left(-\\frac{11}{2}\\right) & =-11 \\\\ -\\frac{33}{2} & =-8,\\end{aligned}\n$$\n\nwhich gives a false statement. \n\nSo, the system has no solution."}] [{:db/id #edb/ref 17592186563678 :question/answer-fields [{:db/id #edb/ref 17592186563609}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "435bef4b-b3af-5768-973e-b4aa50ac129d" :question/math-academy-id "q-105235" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}5 \\\\ -9 \\\\ 10\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -4 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}5 \\\\ -9 \\\\ 10\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -4 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+5{x}_{2}=3 \\\\ -2{x}_{1}-9{x}_{2}=-4 \\\\ 2{x}_{1}+10{x}_{2}=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 5 & 3 \\\\ -2 & -9 & -4 \\\\ 2 & 10 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 5 & 3 \\\\ 0 & 1 & 2 \\\\ 2 & 10 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 5 & 3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k-6\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-6.$ Therefore, the system has a solution only if\n\n$$\n0=k-6\\,⇒\\,k=6.\n$$"}] [{:db/id #edb/ref 17592186563719 :question/answer-fields [{:db/id #edb/ref 17592186563546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8427e64-b547-5ecb-a62e-824aa188b632" :question/math-academy-id "q-34114" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}=2 \\\\ 2{x}_{1}+4{x}_{2}=0 \\\\ -3{x}_{1}+{x}_{2}=-7\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 2 & 4 & 0 \\\\ -3 & 1 & -7\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 4 & -4 \\\\ -3 & 1 & -7\\end{array}\\right] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 4 & -4 \\\\ 0 & 1 & -1\\end{array}\\right] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{array}\\right] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}=2 \\\\ {x}_{2}=-1 \\\\ 0=0.\\end{aligned}\\right.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}2{a}_{1}+(-1){a}_{2} & =b \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}+(-1)\\cdot \\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=2\\cdot (-1)=-2.$"}] [{:db/id #edb/ref 17592186563732 :question/answer-fields [{:db/id #edb/ref 17592186563577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c391d9c3-0c76-5e6f-b0c3-d6b4ee2c37cb" :question/math-academy-id "q-105199" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}=3 \\\\ 2{x}_{1}+{x}_{2}=8\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 2 & 1 & 8\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}=3 \\\\ {x}_{2}=2.\\end{aligned}\\right.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}3{a}_{1}+2{a}_{2} & =b \\\\ 3\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=3\\cdot 2=6.$"}] [{:db/id #edb/ref 17592186563749 :question/answer-fields [{:db/id #edb/ref 17592186563523}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ddfb229d-f01d-542c-8a6c-f2e9a5996154" :question/math-academy-id "q-34639" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{3}=3 \\\\ 4{x}_{1}+{x}_{2}-8{x}_{3}=18 \\\\ 2{x}_{1}-3{x}_{3}=9\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 4 & 1 & -8 & 18 \\\\ 2 & 0 & -3 & 9\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 2 & 0 & -3 & 9\\end{array}\\right] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{3}=3 \\\\ {x}_{2}=6 \\\\ {x}_{3}=3.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(3)=3\\,⟹\\,{x}_{1}=9.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}9{a}_{1}+6{a}_{2}+3{a}_{3} & =b \\\\ 9\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}+6\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+3\\cdot \\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=9\\cdot 6\\cdot 3=162.$"}] [{:db/id #edb/ref 17592186564481 :question/answer-fields [{:db/id #edb/ref 17592186564444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34925275-ae4c-5d65-95f3-737bbc060369" :question/math-academy-id "q-75642" :question/problem "The set $\\{{a}_{1},{a}_{2}\\}$ is linearly dependent. Which of the following vectors could be ${a}_{2}$ if\n$$\n\\displaystyle {a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}?\n$$" :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nA set containing *only two* vectors is linearly *dependent* if and only if the two vectors are parallel.\n\nFrom the given options, the correct answer is \n\n$$\n{a}_{2}=\\begin{bmatrix}-2 \\\\ 2 \\\\ 4\\end{bmatrix}.\n$$\n\nTo see why, notice that \n\n$$\n\\begin{bmatrix}-2 \\\\ 2 \\\\ 4\\end{bmatrix}=2\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}=2{a}_{1}.\n$$\n\nThis way, we have\n\n$$\n\\begin{aligned}2{a}_{1}-2{a}_{1} & =0 \\\\ 2{a}_{1}-{a}_{2} & =0 \\\\ 2{a}_{1}+(-1){a}_{2} & =0\\end{aligned}\n$$\n\nIn other words, the vectors ${a}_{1}$ and ${a}_{2}$ are parallel.\n\nTo see why this means that ${a}_{1}$ and ${a}_{2}$ are linearly dependent, we notice that the equation\n\n$$\n{x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0\n$$\n\nhas the solution ${x}_{1}=2$ and ${x}_{2}=-1,$ which is different from ${x}_{1}={x}_{2}=0.$ Therefore, the set is linearly dependent."}] [{:db/id #edb/ref 17592186564485 :question/answer-fields [{:db/id #edb/ref 17592186564414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d8749ea-387f-52be-af2d-efee12373f36" :question/math-academy-id "q-156682" :question/problem "Let $L$ be the line with equation $x+y=1$ in ${R}^{2}.$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is **not** a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}x \\\\ 1-x\\end{bmatrix},\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $x+y=1:$\n\n$$\n\\begin{aligned}x+y & =1 \\\\ (0)+(0) & =1 \\\\ 0 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example, $$\n\\displaystyle a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$ and $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0+1 \\\\ 1+0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n \nHowever, $$\n\\displaystyle \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\notin L\n$$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}x+y & =1 \\\\ (1)+(1) & =1 \\\\ 2 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186564487 :question/answer-fields [{:db/id #edb/ref 17592186564381}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5873b1df-0474-5771-9ef7-dcd0b294d997" :question/math-academy-id "q-105317" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}9 \\\\ 20 \\\\ -13\\end{bmatrix}.\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nIII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solution." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+9{x}_{3}=0 \\\\ 2{x}_{1}-{x}_{2}+20{x}_{3}=0 \\\\ -2{x}_{1}+2{x}_{2}-13{x}_{3}=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -1 & 9 & 0 \\\\ 2 & -1 & 20 & 0 \\\\ -2 & 2 & -13 & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 9 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ -2 & 2 & -13 & 0\\end{array}\\right] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 9 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 0 & 0 & 5 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+9{x}_{3}=0 \\\\ {x}_{2}+2{x}_{3}=0 \\\\ 5{x}_{3}=0.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+2(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-(0)+9(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements I and III are false, while statement II is true."}] [{:db/id #edb/ref 17592186564493 :question/answer-fields [{:db/id #edb/ref 17592186564461}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "659cad17-10ef-5a6e-af0d-5c68299c5ad8" :question/math-academy-id "q-156650" :question/problem "Let $L$ be the line with equation $3x+y=4$ in ${R}^{2}.$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is **not** a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}x \\\\ -3x+4\\end{bmatrix},\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $y=-3x+4:$\n\n$$\n\\begin{aligned}y & =-3x+4 \\\\ (0) & =-3(0)+4 \\\\ 0 & =4\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example,$$\n\\displaystyle a=\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}\n$$ and $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0+1 \\\\ 4+1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$\n\n \nHowever, $$\n\\displaystyle \\begin{bmatrix}1 \\\\ 5\\end{bmatrix}\\notin L\n$$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}y & =-3x+4 \\\\ (5) & =-3(1)+4 \\\\ 5 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186564502 :question/answer-fields [{:db/id #edb/ref 17592186564452}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "848dcb43-d675-54a9-ae47-a5c4f5dfb881" :question/math-academy-id "q-157254" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-4 \\\\ -2 \\\\ 6\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nI. $3{a}_{1}-2{a}_{2}=0.$\n\nII. ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$\n\nIII. The set $\\{{a}_{1},{a}_{2}\\}$ is linearly dependent." :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's look at each statement in turn.\n\n- Statement I is false. Indeed:\n\n$$\n\\begin{aligned}3{a}_{1}-2{a}_{2} & =3\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}-2\\begin{bmatrix}-4 \\\\ -2 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ 3 \\\\ -9\\end{bmatrix}+\\begin{bmatrix}8 \\\\ 4 \\\\ -12\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 \\\\ 7 \\\\ -21\\end{bmatrix} \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement II is false. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-4{x}_{2}=0 \\\\ {x}_{1}-2{x}_{2}=0 \\\\ -3{x}_{1}+6{x}_{2}=0.\\end{aligned}\\right.\n$$\n\nSolving this system, we find that the solution is ${x}_{1}=2{x}_{2}.$\n\n- Statement III is true. Since statement II is false, the set $\\{{a}_{1},{a}_{2}\\}$ is linearly dependent.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186564519 :question/answer-fields [{:db/id #edb/ref 17592186564428}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0506b4c-4bb7-5b50-9f2e-88bb9d3c3ed6" :question/math-academy-id "q-157293" :question/problem "Let $L$ be the line with equation $2x-y=3$ in ${R}^{2}.$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}x \\\\ 2x-3\\end{bmatrix},\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $2x-y=3:$\n\n$$\n\\begin{aligned}2x-y & =3 \\\\ 2(0)-(0) & =3 \\\\ 0 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example, $$\n\\displaystyle a=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}\n$$ and $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}0+1 \\\\ -3-1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\n \nHowever, $$\n\\displaystyle \\begin{bmatrix}1 \\\\ -4\\end{bmatrix}\\notin L\n$$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}2x-y & =3 \\\\ 2(1)-(-4) & =3 \\\\ 6 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is false. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186564529 :question/answer-fields [{:db/id #edb/ref 17592186564440}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "de9e1bb6-8c29-536b-b329-05255b6d1f04" :question/math-academy-id "q-75636" :question/problem "The set $\\{{a}_{1},{a}_{2}\\}$ is linearly dependent. Which of the following vectors could be ${a}_{2}$ if\n$$\n\\displaystyle {a}_{1}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}?\n$$" :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nA set containing *only two* vectors is linearly *dependent* if and only if the two vectors are parallel.\n\nFrom the given options, the correct answer is \n\n$$\n{a}_{2}=\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}.\n$$\n\nTo see why, notice that \n\n$$\n\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}=-3\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}=-3{a}_{1}.\n$$\n\nThis way, we have\n\n$$\n\\begin{aligned}3{a}_{1}-3{a}_{1} & =0 \\\\ 3{a}_{1}+{a}_{2} & =0.\\end{aligned}\n$$\n\nIn other words, the vectors ${a}_{1}$ and ${a}_{2}$ are parallel.\n\nTo see why this means that ${a}_{1}$ and ${a}_{2}$ are linearly dependent, we notice that the equation\n\n$$\n{x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0\n$$\n\nhas the solution ${x}_{1}=3$ and ${x}_{2}=1,$ which is different from ${x}_{1}={x}_{2}=0.$ Therefore, the set is linearly dependent."}] [{:db/id #edb/ref 17592186566211 :question/answer-fields [{:db/id #edb/ref 17592186566115}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "209031ad-2174-5217-ad4d-29ab0216591c" :question/math-academy-id "q-37776" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -2 & 3 & -2 \\\\ 0 & 1 & -6 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "Notice that the matrix $M$ is already in row echelon form. The system corresponding to $M$ is \n\n$$\n\\left\\{\\begin{aligned}x-2y+3z &=-2 \\\\ 0x+y-6z &=2 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final equation $0x+0y+0z=0,$ we can remove this equation from the system. So, our system now consists of just two equations:\n\n$$\n\\left\\{\\begin{aligned}x-2y+3z &=-2 \\\\ y-6z &=2\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ To do this, we apply the back substitution. \n\nFrom the second equation, we get\n\n$$\ny-6z=2\\,⇒\\,y=6z+2\n$$\n\nand substituting this into the first equation, we obtain\n\n$$\nx-2(6z+2)+3z=-2\\,⇒\\,x=9z+2.\n$$\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=9z+2 \\\\ y &=6z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}9z+2 \\\\ 6z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186566236 :question/answer-fields [{:db/id #edb/ref 17592186566133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a78aa41-fab4-5422-8e61-82dda2111dae" :question/math-academy-id "q-73916" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -3 & -5 & -6 \\\\ 4 & -12 & -20 & -24 \\\\ -\\frac{1}{2} & \\frac{3}{2} & \\frac{5}{2} & 3\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -5 & -6 \\\\ 4 & -12 & -20 & -24 \\\\ -\\frac{1}{2} & \\frac{3}{2} & \\frac{5}{2} & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -5 & -6 \\\\ 0 & 0 & 0 & 0 \\\\ -\\frac{1}{2} & \\frac{3}{2} & \\frac{5}{2} & 3\\end{array}\\right] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -5 & -6 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3y-5z &=-6 \\\\ 0x+0y+0z &=0 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx-3y-5z=-6\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=-6+3y+5z.\n$$\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-6+3y+5z \\\\ y &=y \\\\ z &=z\\end{aligned}\\right.\n$$\n\nwhere $y,z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-6+3y+5z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186566241 :question/answer-fields [{:db/id #edb/ref 17592186566187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70a3bd24-6afb-575f-802d-3c1798798cee" :question/math-academy-id "q-131507" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}7 & 8 & -7 & 5 \\\\ 0 & -5 & 9 & -8 \\\\ 0 & 0 & 0 & 1\\end{array}\\right].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n\\left\\{\\begin{aligned}7x+8y-7z &=5 \\\\ 0x-5y+9z &=-8 \\\\ 0x+0y+0z &=1\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=1,$ we can conclude that our system has no solution."}] [{:db/id #edb/ref 17592186566265 :question/answer-fields [{:db/id #edb/ref 17592186566182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d941de1f-e5bc-5cb7-8728-2a74f1c72d5f" :question/math-academy-id "q-131487" :question/problem "Consider the system\n\n$$\n\\left\\{\\begin{aligned}-2{x}_{1}+6{x}_{2}+2{x}_{3} &=-8 \\\\ {x}_{1}-2{x}_{2}+{x}_{3} &=2 \\\\ -3{x}_{1}+9{x}_{2}+3{x}_{3} &=-12.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for the system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & 6 & 2 & -8 \\\\ 1 & -2 & 1 & 2 \\\\ -3 & 9 & 3 & -12\\end{array}\\right].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}-2 & 6 & 2 & -8 \\\\ 1 & -2 & 1 & 2 \\\\ -3 & 9 & 3 & -12\\end{array}\\right] & {R}_{1} & :=-\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 1 & -2 & 1 & 2 \\\\ -3 & 9 & 3 & -12\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & 2 & -2 \\\\ -3 & 9 & 3 & -12\\end{array}\\right] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & 2 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567017 :question/answer-fields [{:db/id #edb/ref 17592186566906}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11dad216-cc7f-5ad1-80ce-080caf456bf3" :question/math-academy-id "q-73640" :question/problem "Which of the following completes the statement so that it is true:\n\n*If $$\n\\displaystyle \\det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0,\n$$ then $\\underline{\\phantom{xxxxxx}}$ .* \n\nI. The lines $ax+by=0$ and $cx+dy=0$ don't intersect\n\nII. The lines $ax+by=0$ and $cx+dy=0$ intersect at infinitely many points\n\nIII. The system $$\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\mathbf{x}=\\mathbf{0}$$ has the unique zero solution." :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNow, since the fifth part of the invertible matrix theorem is true ($\\det(A)\\ne 0$), all the other parts of the theorem are true too. Therefore, according to the theorem, only option III gives us a true statement: \n\n*If $$\n\\displaystyle \\det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0,\n$$ then the system $$\n\\displaystyle \\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}x=0\n$$ has the unique zero solution.* $\\,✓$"}] [{:db/id #edb/ref 17592186567034 :question/answer-fields [{:db/id #edb/ref 17592186566897}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3e5e2349-4ced-536b-b394-0219c1de87f4" :question/math-academy-id "q-128155" :question/problem "Consider the lines $2x-y=1$ and $4x-ky=0$, where $k$ is a constant. Complete the following statement so that it is true:\n\n*If $k\\ne 2$, then $\\underline{\\phantom{xxxxxx}}\\,.$*" :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nLet $$\n\\displaystyle A=\\begin{bmatrix}2 & -1 \\\\ 4 & -k\\end{bmatrix}.\n$$ If $k\\ne 2$, then\n\n$$\n\\det(A)=\\det\\begin{bmatrix}2 & -1 \\\\ 4 & -k\\end{bmatrix}=4-2k\\ne 0.\n$$\n\n \n\nSo, according to the invertible matrix theorem $A$ is invertible and $$\n\\displaystyle \\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$ is the unique solution of  $Ax=0.$\nAlso, the system \n\n$$\n\\begin{bmatrix}2 & -1 \\\\ 4 & -k\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\n \nhas exactly one solution, and the lines $2x-y=1$ and $4x-ky=0$ intersect at exactly one point.  \n\nTherefore, the true statement is as follows:\n\n*If $k\\ne 2$, then the system $$\n\\displaystyle \\begin{bmatrix}2 & -1 \\\\ 4 & -k\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$ has exactly one solution.* $\\,✓$"}] [{:db/id #edb/ref 17592186567049 :question/answer-fields [{:db/id #edb/ref 17592186566884}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71946d02-db78-542e-8e6c-2648f4f0692f" :question/math-academy-id "q-127916" :question/problem "Consider the system of linear equations given by\n\n$$\n\\left\\{\\begin{aligned}7x+2y=1 \\\\ y+x=9.\\end{aligned}\\right.\n$$\n\nGiven that the system has exactly one solution, which of the following statements are true?\n\nI. The lines $7x+2y=1$ and $y+x=9$ intersect at exactly one point\n\nII. The determinant of the coefficient matrix is equal to $0$\n\nIII. The coefficient matrix is not invertible" :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement I is true by the fourth part of the invertible matrix theorem.\n\n- Statement II is false. According to the fifth part of the invertible matrix theorem, the determinant cannot be $0.$\n\n- Statement III is false by the first part of the invertible matrix theorem.\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186567056 :question/answer-fields [{:db/id #edb/ref 17592186566955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80beacf9-8114-56a0-8f57-abbecbd075fa" :question/math-academy-id "q-73560" :question/problem "Consider the system of linear equations given by\n\n$$\n\\left\\{\\begin{aligned}x+y=0 \\\\ kx+2y=0.\\end{aligned}\\right.\n$$\n\nGiven that the system has a unique zero solution, which of the following statements are true?\n\nI. The lines $x+y=0$ and $kx+2y=0$ don't intersect\n\nII. $k=2$\n\nIII. The coefficient matrix is invertible" :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nAlso, we are told that the third part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement I is false by the fourth part of the invertible matrix theorem.\n\n- Statement II is false. If $k=2$ then\n\n$$\n\\det\\begin{bmatrix}1 & 1 \\\\ \\text{ }k & 2\\end{bmatrix}=\\det\\begin{bmatrix}1 & 1 \\\\ \\text{ }2 & 2\\end{bmatrix}=1\\cdot 2-1\\cdot 2=0,\n$$\n\nbut  according to the fifth part of the invertible matrix theorem, the determinant cannot be $0.$\n\n- Statement III is true by the first part of the invertible matrix theorem.\n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186567074 :question/answer-fields [{:db/id #edb/ref 17592186566921}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abbbffe0-a1a4-54a2-bcdd-88f376076c7c" :question/math-academy-id "q-73561" :question/problem "Consider a system of two linear equations in two variables, represented by the matrix equation $A\\mathbf{x}=\\mathbf{b}$ in the usual way. Given that the system has exactly one solution, which of the following statements are true?\n\nI. $\\det(A)=0$\n\nII. $A$ is invertible\n\nIII. $A\\mathbf{x}=\\mathbf{0}$ has an infinite number of solutions" :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement I is false by the fifth part of the invertible matrix theorem.\n\n- Statement II is true by the first part of the invertible matrix theorem.\n\n- Statement III is false by the third part of the invertible matrix theorem.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186567077 :question/answer-fields [{:db/id #edb/ref 17592186566968}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b23db50f-6fe1-5c69-a46d-89da21fc9fd2" :question/math-academy-id "q-127912" :question/problem "Consider a system of two linear equations in two variables, represented by the matrix equation $A\\mathbf{x}=\\mathbf{b}$ in the usual way. Given that the system has exactly one solution, which of the following statements are true?\n\nI. $\\det(A)\\ne 0$\n\nII. $A$ is not invertible\n\nIII. $A\\mathbf{x}=\\mathbf{0}$ has a nonzero solution" :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement I is true by the fifth part of the invertible matrix theorem.\n\n- Statement II is false by the first part of the invertible matrix theorem.\n\n- Statement III is false by the third part of the invertible matrix theorem.\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186567100 :question/answer-fields [{:db/id #edb/ref 17592186566926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb3fb3b9-076d-5aff-b850-4998889f64e6" :question/math-academy-id "q-31908" :question/problem "Let \n$$\n\\displaystyle A=\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix}.\n$$\nWhich of the following statements are true?\n\nI. $\\det(A)=0$\n\nII. The system  $A\\mathbf{x}=\\mathbf{0}$ has exactly one solution\n\nIII. $A$ is invertible" :question/worked-solution "Recall that given $$\n\\displaystyle A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix},\n$$ then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $\\det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement I is true. We have \n\n$$\n\\begin{aligned}\\det(A) & =\\det\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix} \\\\  & =2\\cdot 0-(-3)\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is false, all the other parts of the theorem are false too. Therefore, according to the theorem:\n\n- Statement II is false by the third part of the invertible matrix theorem.\n\n- Statement III is false by the first part of the invertible matrix theorem.\n\nTherefore only statements I is true."}] [{:db/id #edb/ref 17592186569961 :question/answer-fields [{:db/id #edb/ref 17592186569867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d9a8a04-d6f4-5dae-8ede-86bd3b61ce86" :question/math-academy-id "q-131714" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+z &=4 \\\\ y-3z &=-1.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -2 & 1 & 4 \\\\ 0 & 1 & -3 & -1\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -2 & 1 & 4 \\\\ 0 & 1 & -3 & -1\\end{array}\\right] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -5 & 2 \\\\ 0 & 1 & -3 & -1\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-5z &=2 \\\\ y-3z &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=5z+2 \\\\ y &=3z-1 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5z+2 \\\\ 3z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186569976 :question/answer-fields [{:db/id #edb/ref 17592186569945}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f4a72f8-3bd3-5788-9d12-62ca6f611891" :question/math-academy-id "q-74636" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-x+y &=-1 \\\\ 2x+3y &=3 \\\\ -x-4y &=-3.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. The system is inconsistent\n\nII. The system has a unique solution\n\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 1 & -1 \\\\ 2 & 3 & 3 \\\\ -1 & -4 & -3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:  \n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}-1 & 1 & -1 \\\\ 2 & 3 & 3 \\\\ -1 & -4 & -3\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-1 & 1 & -1 \\\\ 0 & 5 & 1 \\\\ -1 & -4 & -3\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-1 & 1 & -1 \\\\ 0 & 5 & 1 \\\\ 0 & -5 & -2\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-1 & 1 & -1 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & -1\\end{array}\\right]\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-1,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement I is true."}] [{:db/id #edb/ref 17592186569978 :question/answer-fields [{:db/id #edb/ref 17592186569881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35e39332-390d-57d5-8a71-b2e823ef2c1d" :question/math-academy-id "q-131713" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-x+2y &=-1 \\\\ 4x-8y &=4 \\\\ -4x+8y &=-4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 2 & -1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}-1 & 2 & -1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{array}\\right] & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 1 \\\\ 0 & 0 & 0 \\\\ -4 & 8 & -4\\end{array}\\right] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-2y &=1\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2y+1 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2y+1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570699 :question/answer-fields [{:db/id #edb/ref 17592186570589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f13da88-9214-5888-9868-a4b7f8edacdd" :question/math-academy-id "q-72721" :question/problem "Suppose $B$ is a $4\\times 4$ matrix and $det(B)=-21.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{1}↔{R}_{4}$ (switching the first and the fourth rows). What is the value of $det(C)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(-21) \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570735 :question/answer-fields [{:db/id #edb/ref 17592186570591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "620b0d62-bee7-51dc-8bf7-49326cfad693" :question/math-academy-id "q-130735" :question/problem "Suppose $B$ is a $2\\times 2$ matrix and $det(B)=-5.$ What is the value of $det(3B)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot B) &={k}^{n}\\cdot det(B).\\end{aligned}\n$$\n\nIn our case, we have $k=3$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(3B) & ={3}^{2}\\cdot det(B) \\\\  & =9\\cdot (-5) \\\\  & =-45.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570738 :question/answer-fields [{:db/id #edb/ref 17592186570656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "687e18db-1843-51e7-a8a0-475f4a6d1676" :question/math-academy-id "q-72735" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=80.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{4}:=\\frac{3}{10}{R}_{4}.$ What is the value of $det(C)?$" :question/worked-solution "The row operation applied to $B$ consists of multiplying a row by the number $\\frac{3}{10}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(C) & =\\frac{3}{10}det(B) \\\\  & =\\frac{3}{10}\\cdot 80 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570763 :question/answer-fields [{:db/id #edb/ref 17592186570630}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1f0bc2a-d097-538a-b002-360896d3c91f" :question/math-academy-id "q-130769" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=11.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{4}:=3{R}_{4}$ and ${R}_{2}:={R}_{2}+(-5){R}_{1}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}:={R}_{2}+(-5){R}_{1}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{4}:=3{R}_{4}$ involves multiplying a row by $3,$ so the determinant is multiplied by $3$ as well.\n\nTherefore, we only have to multiply the determinant by $3.$ Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =3det(A) \\\\  & =3\\cdot 11 \\\\  & =33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570776 :question/answer-fields [{:db/id #edb/ref 17592186570643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7915d65-a649-5e77-8661-8aa533c4bd16" :question/math-academy-id "q-43045" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=3$, find $det(Y).$\n\n$$\nX=\\begin{bmatrix}3 & 0 & -2 \\\\ 1 & 0 & -1 \\\\ 4 & 3 & 2\\end{bmatrix},\\,Y=\\begin{bmatrix}4 & 3 & 2 \\\\ 1 & 0 & -1 \\\\ 3 & 0 & -2\\end{bmatrix}?\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $1$st and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(3) \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570789 :question/answer-fields [{:db/id #edb/ref 17592186570681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9fbd8ca-7a83-50db-a6d3-a36d5d6ceb97" :question/math-academy-id "q-72746" :question/problem "Suppose $C$ is a $3\\times 3$ matrix and $det(C)=-5.$ What is the value of $det(-4C)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot C) &={k}^{n}\\cdot det(C).\\end{aligned}\n$$\n\nIn our case, we have $k=-4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(-4C) & =(-4)^{3}\\cdot det(C) \\\\  & =(-64)\\cdot (-5) \\\\  & =320.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571376 :question/answer-fields [{:db/id #edb/ref 17592186571347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "023dfa42-4e6d-5f3b-a244-3651fae43041" :question/math-academy-id "q-77483" :question/problem "$$\n\\displaystyle \\begin{vmatrix}2 & 0 & 3 & 0 \\\\ 4 & 1 & 2 & -3 \\\\ 1 & 0 & -2 & -1 \\\\ -1 & 1 & 5 & 2\\end{vmatrix}=\n$$" :question/worked-solution "The $1$rst row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 0 & 3 & 0 \\\\ 4 & 1 & 2 & -3 \\\\ 1 & 0 & -2 & -1 \\\\ -1 & 1 & 5 & 2\\end{vmatrix} & =2\\cdot {C}_{11}+0\\cdot {C}_{12}+3\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2\\cdot (-1)^{1+1}\\begin{vmatrix}1 & 2 & -3 \\\\ 0 & -2 & -1 \\\\ 1 & 5 & 2\\end{vmatrix}+3\\cdot (-1)^{1+3}\\cdot \\begin{vmatrix}4 & 1 & -3 \\\\ 1 & 0 & -1 \\\\ -1 & 1 & 2\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}1 & 2 & -3 \\\\ 0 & -2 & -1 \\\\ 1 & 5 & 2\\end{vmatrix}+3\\cdot \\begin{vmatrix}4 & 1 & -3 \\\\ 1 & 0 & -1 \\\\ -1 & 1 & 2\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571396 :question/answer-fields [{:db/id #edb/ref 17592186571344}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f9ad428-3dfc-5d8c-ae39-56b5c0911ce9" :question/math-academy-id "q-130067" :question/problem "$$\n\\displaystyle \\begin{vmatrix}2 & 0 & -1 & 3 \\\\ 1 & 7 & 2 & -1 \\\\ -3 & 0 & 1 & 2 \\\\ -2 & 0 & 3 & -1\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 0 & -1 & 3 \\\\ 1 & 7 & 2 & -1 \\\\ -3 & 0 & 1 & 2 \\\\ -2 & 0 & 3 & -1\\end{vmatrix} & =0\\cdot {C}_{12}+7\\cdot {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =7\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix} \\\\  & =7\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571404 :question/answer-fields [{:db/id #edb/ref 17592186571300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f805a2f-454d-5b6b-b94e-f4a78a778d84" :question/math-academy-id "q-131099" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle T=\\begin{bmatrix}0 & 0 & 0 & -10 \\\\ 0 & 4 & 0 & -5 \\\\ 1 & 3 & 2 & 0 \\\\ 1 & 2 & 3 & -25\\end{bmatrix}\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(T) & ={t}_{11}{C}_{11}+{t}_{12}{C}_{12}+{t}_{13}{C}_{13}+{t}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}-10\\cdot {C}_{14} \\\\  & =-10{C}_{14} \\\\  & =-10\\cdot \\begin{vmatrix}∗ & ∗ & ∗ & -10 \\\\ 0 & 4 & 0 & ∗ \\\\ 1 & 3 & 2 & ∗ \\\\ 1 & 2 & 3 & ∗\\end{vmatrix} \\\\  & =-10(-1)^{1+4}\\begin{vmatrix}0 & 4 & 0 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 3\\end{vmatrix} \\\\  & =10\\left(0\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & 3\\end{vmatrix}-4\\cdot \\begin{vmatrix}1 & 2 \\\\ 1 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}1 & 3 \\\\ 1 & 2\\end{vmatrix}\\right) \\\\  & =10(0-4(1\\cdot 3-1\\cdot 2)+0) \\\\  & =10\\cdot (-4) \\\\  & =-40\\end{aligned}\n$$"}]}
