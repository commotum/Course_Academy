} & {\\color{red}0} & {\\color{red}0} \\\\ 1 & -3 & -4 & 3\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{31}}+{\\color{red}3}\\cdot {\\color{black}{C}_{32}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}0}\\cdot {\\color{blue}{C}_{34}} \\\\  & ={\\color{red}3}\\cdot {\\color{blue}(-1)^{3+2}\\cdot \\begin{vmatrix}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{vmatrix}} \\\\  & =-3\\cdot \\begin{vmatrix}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{vmatrix}.\\end{aligned}$$"] [17592186345306 "Using cofactor expansion along the $1$st row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}1} & {\\color{red}0} & {\\color{red}0} & {\\color{red}-1} \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{vmatrix} & ={\\color{red}1}\\cdot {\\color{blue}{C}_{11}}+{\\color{red}0}\\cdot {\\color{black}{C}_{12}}+{\\color{red}0}\\cdot {\\color{black}{C}_{13}}+{\\color{red}(-1)}\\cdot {\\color{blue}{C}_{14}} \\\\  & ={\\color{red}1}\\cdot {\\color{blue}(-1)^{1+1}\\cdot \\begin{vmatrix}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{vmatrix}}+{\\color{red}(-1)}\\cdot {\\color{blue}(-1)^{1+4}\\cdot \\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & -0\\end{vmatrix}} \\\\  & =\\begin{vmatrix}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{vmatrix}+\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{vmatrix}.\\end{aligned}$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\\begin{aligned}\\begin{vmatrix}2 & 1 & -1 \\\\ {\\color{red}1} & {\\color{red}5} & {\\color{red}0} \\\\ -4 & 0 & -3\\end{vmatrix} & ={\\color{red}1}\\cdot {\\color{blue}{C}_{21}}+{\\color{red}5}\\cdot {\\color{blue}{C}_{22}}+{\\color{red}0}\\cdot {\\color{black}{C}_{23}} \\\\  & ={\\color{red}1}\\cdot {\\color{blue}(-1)^{2+1}\\cdot \\begin{vmatrix}1 & -1 \\\\ 0 & -3\\end{vmatrix}}+{\\color{red}5}\\cdot {\\color{blue}(-1)^{2+2}\\cdot \\begin{vmatrix}2 & -1 \\\\ -4 & -3\\end{vmatrix}} \\\\  & =-\\begin{vmatrix}1 & -1 \\\\ 0 & -3\\end{vmatrix}+5\\begin{vmatrix}2 & -1 \\\\ -4 & -3\\end{vmatrix} \\\\  & =-(-3-0)+5(-6-4) \\\\  & =3-50 \\\\  & =-47\\end{aligned}$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain: \n\n$$\\begin{aligned}\\begin{vmatrix}2 & 2 & 1 \\\\ {\\color{red}0} & {\\color{red}1} & {\\color{red}5} \\\\ 2 & -4 & 0\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{21}}+{\\color{red}1}\\cdot {\\color{blue}{C}_{22}}+{\\color{red}5}\\cdot {\\color{blue}{C}_{23}} \\\\  & ={\\color{red}1}\\cdot {\\color{blue}(-1)^{2+2}\\cdot \\begin{vmatrix}2 & 1 \\\\ 2 & 0\\end{vmatrix}}+{\\color{red}5}\\cdot {\\color{blue}(-1)^{2+3}\\cdot \\begin{vmatrix}2 & 2 \\\\ 2 & -4\\end{vmatrix}} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 2 & 0\\end{vmatrix}-5\\begin{vmatrix}2 & 2 \\\\ 2 & -4\\end{vmatrix} \\\\  & =(0-2)-5(-8-4) \\\\  & =-2+60 \\\\  & =58\\end{aligned}$$\n\n  \n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{vmatrix}=-47+58=11.\n$$"] [17592186345307 "Using cofactor expansion along the $2$nd row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}0 & 0 & 3 & 4 \\\\ {\\color{red}0} & {\\color{red}2} & {\\color{red}0} & {\\color{red}0} \\\\ 3 & 0 & 8 & -5 \\\\ -1 & 1 & 0 & 0\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{21}}+{\\color{red}2}\\cdot {\\color{blue}{C}_{22}}+{\\color{red}0}\\cdot {\\color{black}{C}_{23}}+{\\color{red}0}\\cdot {\\color{black}{C}_{24}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{2+2}\\cdot \\begin{vmatrix}0 & 3 & 4 \\\\ 3 & 8 & -5 \\\\ -1 & 0 & 0\\end{vmatrix}} \\\\  & =2\\begin{vmatrix}0 & 3 & 4 \\\\ 3 & 8 & -5 \\\\ -1 & 0 & 0\\end{vmatrix}.\\end{aligned}$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\\begin{aligned}\\begin{vmatrix}0 & 3 & 4 \\\\ 3 & 8 & -5 \\\\ {\\color{red}-1} & {\\color{red}0} & {\\color{red}0}\\end{vmatrix} & ={\\color{red}(-1)}\\cdot {\\color{blue}{C}_{31}}+{\\color{red}0}\\cdot {\\color{black}{C}_{32}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}} \\\\  & ={\\color{red}(-1)}\\cdot {\\color{blue}(-1)^{3+1}\\cdot \\begin{vmatrix}3 & 4 \\\\ 8 & -5\\end{vmatrix}} \\\\  & =(-1)\\begin{vmatrix}3 & 4 \\\\ 8 & -5\\end{vmatrix} \\\\  & =(-1)(-15-32) \\\\  & =(-1)\\cdot (-47) \\\\  & =47\\end{aligned}$$\n\n \n\nTherefore,\n\n$$\n\\begin{vmatrix}0 & 0 & 3 & 4 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 0 & 8 & -5 \\\\ -1 & 1 & 0 & 0\\end{vmatrix}=2\\cdot 47=94.\n$$"] [17592186345311 "Using a cofactor expansion along the $2$nd column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}4 & 0 & 9 & 8 \\\\ 2 & 0.5 & 0 & 4 \\\\ 0 & 0.2 & -1 & 3 \\\\ -3 & 0 & 12 & 4\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{12}}+{\\color{red}0.5}\\cdot {\\color{blue}{C}_{22}}+{\\color{red}0.2}\\cdot {\\color{black}{C}_{32}}+{\\color{red}0}\\cdot {\\color{blue}{C}_{42}} \\\\  & ={\\color{red}0.5}\\cdot {\\color{blue}(-1)^{2+2}\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}}+{\\color{red}0.2}\\cdot {\\color{blue}(-1)^{3+2}\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix}} \\\\  & =0.5\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}-0.2\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix}.\\end{aligned}$$"] [17592186345335 "The $1$rst row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}0} & {\\color{red}-3} & {\\color{red}2} & {\\color{red}0} \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{11}}+{\\color{red}-3}\\cdot {\\color{blue}{C}_{12}}+{\\color{red}2}\\cdot {\\color{blue}{C}_{13}}+{\\color{red}0}\\cdot {\\color{black}{C}_{14}} \\\\  & ={\\color{red}-3}\\cdot {\\color{blue}(-1)^{1+2}\\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}}+{\\color{red}2}\\cdot {\\color{blue}(-1)^{1+3}\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}} \\\\  & =3\\cdot \\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}+2\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}.\\end{aligned}$$"] [17592186345336 "The $2$nd row of the matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $2$nd row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}-7 & -1 & 5 & 8 \\\\ {\\color{red}3} & {\\color{red}-6} & {\\color{red}0} & {\\color{red}0} \\\\ 4 & -3 & 2 & -1 \\\\ 1 & 3 & -5 & -7\\end{vmatrix} & ={\\color{red}3}\\cdot {\\color{blue}{C}_{21}}+{\\color{red}(-6)}\\cdot {\\color{blue}{C}_{22}}+{\\color{red}0}\\cdot {\\color{black}{C}_{23}}+{\\color{red}0}\\cdot {\\color{black}{C}_{24}} \\\\  & ={\\color{red}3}\\cdot {\\color{blue}(-1)^{2+1}\\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}}+{\\color{red}(-6)}\\cdot {\\color{blue}(-1)^{2+2}\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix}} \\\\  & =-3\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}-6\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix}.\\end{aligned}$$"] [17592186345337 "Using cofactor expansion along the $2$nd row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}0 & -1 & 0 & 3 \\\\ {\\color{red}0} & {\\color{red}0} & {\\color{red}0} & {\\color{red}3} \\\\ -7 & 0 & 1 & -2 \\\\ 0 & 3 & 1 & 5\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{21}}+{\\color{red}0}\\cdot {\\color{black}{C}_{22}}+{\\color{red}0}\\cdot {\\color{black}{C}_{23}}+{\\color{red}3}\\cdot {\\color{blue}{C}_{24}} \\\\  & ={\\color{red}3}\\cdot {\\color{blue}(-1)^{2+4}\\cdot \\begin{vmatrix}0 & -1 & 0 \\\\ -7 & 0 & 1 \\\\ 0 & 3 & 1\\end{vmatrix}} \\\\  & =3\\cdot \\begin{vmatrix}0 & -1 & 0 \\\\ -7 & 0 & 1 \\\\ 0 & 3 & 1\\end{vmatrix}.\\end{aligned}$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}0} & {\\color{red}-1} & {\\color{red}0} \\\\ -7 & 0 & 1 \\\\ 0 & 3 & 1\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{11}}+{\\color{red}(-1)}\\cdot {\\color{blue}{C}_{12}}+{\\color{red}0}\\cdot {\\color{black}{C}_{13}} \\\\  & ={\\color{red}(-1)}\\cdot {\\color{blue}(-1)^{1+2}\\cdot \\begin{vmatrix}-7 & 1 \\\\ 0 & 1\\end{vmatrix}} \\\\  & =\\begin{vmatrix}-7 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-7-0 \\\\  & =-7\\end{aligned}$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}0 & -1 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ -7 & 0 & 1 & -2 \\\\ 0 & 3 & 1 & 5\\end{vmatrix}=3(-7)=-21.\n$$"] [17592186345338 "Using cofactor expansion along the $4$th row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ {\\color{red}-2} & {\\color{red}5} & {\\color{red}0} & {\\color{red}0}\\end{vmatrix} & ={\\color{red}-2}\\cdot {\\color{blue}{C}_{41}}+{\\color{red}5}\\cdot {\\color{blue}{C}_{42}}+{\\color{red}0}\\cdot {\\color{black}{C}_{43}}+{\\color{red}0}\\cdot {\\color{black}{C}_{44}} \\\\  & ={\\color{red}-2}\\cdot {\\color{blue}(-1)^{4+1}\\cdot \\begin{vmatrix}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{vmatrix}}+{\\color{red}5}\\cdot {\\color{blue}(-1)^{4+2}\\cdot \\begin{vmatrix}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{vmatrix}} \\\\  & =2\\cdot \\begin{vmatrix}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{vmatrix}+5\\cdot \\begin{vmatrix}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{vmatrix}.\\end{aligned}$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}-1} & {\\color{red}1} & {\\color{red}0} \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{vmatrix} & ={\\color{red}(-1)}\\cdot {\\color{blue}{C}_{11}}+{\\color{red}1}\\cdot {\\color{blue}{C}_{12}}+{\\color{red}0}\\cdot {\\color{black}{C}_{13}} \\\\  & ={\\color{red}(-1)}\\cdot {\\color{blue}(-1)^{1+1}\\cdot \\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}}+{\\color{red}1}\\cdot {\\color{blue}(-1)^{1+2}\\cdot \\begin{vmatrix}-2 & -1 \\\\ 2 & 4\\end{vmatrix}} \\\\  & =-\\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}-\\begin{vmatrix}-2 & -1 \\\\ 2 & 4\\end{vmatrix} \\\\  & =-(-4-7)-(-8+2) \\\\  & =11+6 \\\\  & =17\\end{aligned}$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain: \n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}1} & {\\color{red}1} & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{vmatrix} & ={\\color{red}1}\\cdot {\\color{blue}{C}_{11}}+{\\color{red}1}\\cdot {\\color{blue}{C}_{12}}+{\\color{red}0}\\cdot {\\color{black}{C}_{13}} \\\\  & ={\\color{red}1}\\cdot {\\color{blue}(-1)^{1+1}\\cdot \\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}}+{\\color{red}1}\\cdot {\\color{blue}(-1)^{1+2}\\cdot \\begin{vmatrix}0 & -1 \\\\ 0 & 4\\end{vmatrix}} \\\\  & =\\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}-\\begin{vmatrix}0 & -1 \\\\ 0 & 4\\end{vmatrix} \\\\  & =(-4-7)-(0+0) \\\\  & =-11-0 \\\\  & =-11\\end{aligned}$$\n\n  \n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ -2 & 5 & 0 & 0\\end{vmatrix}=2(17)+5(-11)=-21.\n$$"] [17592186345341 "Using a cofactor expansion along the $1$st column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}-2} & 2 & 0 & 4 \\\\ {\\color{red}0} & 5 & -7 & 3 \\\\ {\\color{red}0} & 9 & 6 & -1 \\\\ {\\color{red}0} & 8 & -1 & -1\\end{vmatrix} & ={\\color{red}-2}\\cdot {\\color{blue}{C}_{11}}+{\\color{red}0}\\cdot {\\color{black}{C}_{21}}+{\\color{red}0}\\cdot {\\color{black}{C}_{31}}+{\\color{red}0}\\cdot {\\color{black}{C}_{41}} \\\\  & ={\\color{red}(-2)}\\cdot {\\color{blue}(-1)^{1+1}\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}} \\\\  & =-2\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}.\\end{aligned}$$"] [17592186345342 "Using a cofactor expansion along the $2$nd column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}1 & {\\color{red}0} & -4 & 3 \\\\ -1 & {\\color{red}-7} & 5 & -1 \\\\ 2 & {\\color{red}0} & 6 & -2 \\\\ -2 & {\\color{red}-8} & -9 & 4\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{12}}+{\\color{red}(-7)}\\cdot {\\color{blue}{C}_{22}}+{\\color{red}0}\\cdot {\\color{black}{C}_{32}}+{\\color{red}(-8)}\\cdot {\\color{blue}{C}_{42}} \\\\  & ={\\color{red}(-7)}\\cdot {\\color{blue}(-1)^{2+2}\\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}}+{\\color{red}(-8)}\\cdot {\\color{blue}(-1)^{4+2}\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}} \\\\  & =-7\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}-8\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}.\\end{aligned}$$"] [17592186354507 "First, we find the matrix $\\,P-\\lambda I:$\n\n\n$$\nP-\\lambda I=\\begin{bmatrix}3-\\lambda  & 5 & 2 & 0 \\\\ 0 & -2-\\lambda  & 0 & -1 \\\\ 0 & 0 & 1-\\lambda  & 7 \\\\ 0 & 0 & 0 & -3-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $\\det(P-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}\\det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 5 & 2 & 0 \\\\ 0 & -2-\\lambda  & 0 & -1 \\\\ 0 & 0 & 1-\\lambda  & 7 \\\\ 0 & 0 & 0 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-2-\\lambda )(1-\\lambda )(-3-\\lambda ) & =0 \\\\ (\\lambda -3)(\\lambda +2)(\\lambda -1)(\\lambda +3) & =0\\end{aligned}\n$$"] [17592186366006 "First, we find the matrix $\\,C-\\lambda I:$\n\n\n$$\nC-\\lambda I=\\begin{bmatrix}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $\\det(C-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $4$th column, as follows:\n\n$$\n\\begin{aligned}\\det(C-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )\\begin{vmatrix}2-\\lambda  & 1 & 4 \\\\ 0 & 5-\\lambda  & 0 \\\\ -5 & 2 & -3-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(5-\\lambda )\\cdot (5-\\lambda )\\begin{vmatrix}2-\\lambda  & 4 \\\\ -5 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )^{2}\\cdot ((2-\\lambda )(-3-\\lambda )+20) & =0 \\\\ (\\lambda -5)^{2}({\\lambda }^{2}+\\lambda +14) & =0\\end{aligned}\n$$\n\nSince $D<0$ for the polynomial ${\\lambda }^{2}+\\lambda +14$ we have that the only real eigenvalue is $\\lambda =5$ (with algebraic multiplicity $2$). \n\nTherefore, the correct answer is “$\\lambda =5$ is an eigenvalue of $C$”; “The eigenvalue $\\lambda =5$ has algebraic multiplicity $2$” only."] [17592186366013 "First, we find the matrix $\\,C-\\lambda I:$\n\n\n$$\nC-\\lambda I=\\begin{bmatrix}4-\\lambda  & 3 & -6 \\\\ 4 & 5-\\lambda  & -12 \\\\ 3 & 3 & -7-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $\\det(C-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}\\det(C-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 3 & -6 \\\\ 4 & 5-\\lambda  & -12 \\\\ 3 & 3 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & -12 \\\\ 3 & -7-\\lambda \\end{vmatrix}-3\\begin{vmatrix}4 & -12 \\\\ 3 & -7-\\lambda \\end{vmatrix}+(-6)\\begin{vmatrix}4 & 5-\\lambda  \\\\ 3 & 3\\end{vmatrix} & =0 \\\\ (4-\\lambda )({\\lambda }^{2}+2\\lambda +1)-3(-4\\lambda +8)-6(-3+3\\lambda ) & =0 \\\\ (-{\\lambda }^{3}+2{\\lambda }^{2}+7\\lambda +4)-(-12\\lambda +24)-(-18+18\\lambda ) & =0 \\\\ -{\\lambda }^{3}+2{\\lambda }^{2}+\\lambda -2 & =0 \\\\ {\\lambda }^{3}-2{\\lambda }^{2}-\\lambda +2 & =0\\end{aligned}\n$$"] [17592186366365 "First, we find the matrix $\\,P-\\lambda I:$\n\n\n$$\nP-\\lambda I=\\begin{bmatrix}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $\\det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}\\det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )\\begin{vmatrix}-\\lambda  & 0 & 4 \\\\ 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & -14-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(2-\\lambda )\\cdot (-14-\\lambda )\\begin{vmatrix}-\\lambda  & 0 \\\\ 3 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-14-\\lambda )(-\\lambda )(-2-\\lambda ) & =0 \\\\ (\\lambda -2)(\\lambda +14)\\lambda (\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =2,$ $\\lambda =-2,$ $\\lambda =0,$ and $\\lambda =-14$  (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is “$\\lambda =0$ is an eigenvalue of $P$”; “$\\lambda =-14$ is an eigenvalue of $P$” only."] [17592186366511 "First, we find the matrix $\\,D-\\lambda I:$\n\n\n$$\nD-\\lambda I=\\begin{bmatrix}-1-\\lambda  & -2 & 4 & 6 \\\\ 0 & 1-\\lambda  & -1 & 0 \\\\ 0 & -2 & -\\lambda  & 5 \\\\ 0 & 0 & 0 & -7-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $\\det(D-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}\\det(D-\\lambda I) & =0 \\\\ \\begin{vmatrix}-1-\\lambda  & -2 & 4 & 6 \\\\ 0 & 1-\\lambda  & -1 & 0 \\\\ 0 & -2 & -\\lambda  & 5 \\\\ 0 & 0 & 0 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )\\begin{vmatrix}1-\\lambda  & -1 & 0 \\\\ -2 & -\\lambda  & 5 \\\\ 0 & 0 & -7-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(-1-\\lambda )(-7-\\lambda )\\begin{vmatrix}1-\\lambda  & -1 \\\\ -2 & -\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )(-7-\\lambda )((1-\\lambda )(-\\lambda )-2) & =0 \\\\ (\\lambda +1)(\\lambda +7)({\\lambda }^{2}-\\lambda -2) & =0 \\\\ (\\lambda +1)(\\lambda +7)(\\lambda -2)(\\lambda +1) & =0 \\\\ (\\lambda +1)^{2}(\\lambda +7)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $D$ are $\\lambda =-1$ (with algebraic multiplicity $2$), $\\lambda =-7$ and $\\lambda =2.$\n\nTherefore, the correct answer is “$\\lambda =2$ is an eigenvalue of $D$”; “$\\lambda =-1$ is an eigenvalue of $D$”; “The eigenvalue $\\lambda =-1$ has algebraic multiplicity $2$”."] [17592186366518 "First, we find the matrix $\\,R-\\lambda I:$\n\n\n$$\nR-\\lambda I=\\begin{bmatrix}1-\\lambda  & 2 & -1 \\\\ -2 & -\\lambda  & 4 \\\\ 0 & 1 & 3-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $\\det(R-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st column, we get the following:\n\n$$\n\\begin{aligned}\\det(R-\\lambda I) & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 2 & -1 \\\\ -2 & -\\lambda  & 4 \\\\ 0 & 1 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}-\\lambda  & 4 \\\\ 1 & 3-\\lambda \\end{vmatrix}-(-2)\\begin{vmatrix}2 & -1 \\\\ 1 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-3\\lambda -4)+2(-2\\lambda +7) & =0 \\\\ (-{\\lambda }^{3}+4{\\lambda }^{2}+\\lambda -4)+(-4\\lambda +14) & =0 \\\\ -{\\lambda }^{3}+4{\\lambda }^{2}-3\\lambda +10 & =0 \\\\ {\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -10 & =0\\end{aligned}\n$$"] [17592186367380 "We write down $U$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $U$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[U\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 2 & 6 & 0 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 0 & -2 & -2 & 1\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 0 & 1 & 1 & -\\frac{1}{2}\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-4){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & -3 & 2 \\\\ 0 & 1 & 1 & -\\frac{1}{2}\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${U}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{U}^{-1}=\\begin{bmatrix}-3 & 2 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}.\n$$"] [17592186367942 "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=3 \\\\ x-2y &=1.\\end{aligned}\\right.\n$$\n\nNow, we can represent this system of equations in the form $A\\mathbf{x}=\\mathbf{b}:$\n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot (-2)-1\\cdot 3}\\begin{bmatrix}-2 & -3 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{(-7)}\\begin{bmatrix}-2 & -3 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{7}\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\frac{1}{7}\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}\\end{aligned}$$"] [17592186367964 "This system can be written as\n\n$$\n\\begin{bmatrix}-1 & 4 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n\n$$\nA=\\begin{bmatrix}-1 & 4 \\\\ -3 & 2\\end{bmatrix}.\n$$\n\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 2-(-3)\\cdot 4}\\begin{bmatrix}2 & -4 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}2 & -4 \\\\ 3 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\\mathbf{x}={A}^{-1}\\mathbf{b}=\\frac{1}{10}\\begin{bmatrix}2 & -4 \\\\ 3 & -1\\end{bmatrix}\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}.$$"] [17592186369686 "Using cofactor expansion along the third row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}4 & 1 & 0 & 0 \\\\ 0 & 0 & 3 & -2 \\\\ 0 & 2 & 0 & 0 \\\\ 5 & 0 & -1 & 2\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{31}}+{\\color{red}2}\\cdot {\\color{blue}{C}_{32}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}0}\\cdot {\\color{black}{C}_{34}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{3+2}\\cdot \\begin{vmatrix}4 & 0 & 0 \\\\ 0 & 3 & -2 \\\\ 5 & -1 & 2\\end{vmatrix}} \\\\  & =-2\\begin{vmatrix}4 & 0 & 0 \\\\ 0 & 3 & -2 \\\\ 5 & -1 & 2\\end{vmatrix}\\end{aligned}$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\\begin{aligned}\\begin{vmatrix}{\\color{red}4} & {\\color{red}0} & {\\color{red}0} \\\\ 0 & 3 & -2 \\\\ 5 & -1 & 2\\end{vmatrix} & ={\\color{red}4}\\cdot {\\color{blue}{C}_{11}}+{\\color{red}0}\\cdot {\\color{black}{C}_{12}}+{\\color{red}0}\\cdot {\\color{black}{C}_{13}} \\\\  & ={\\color{red}4}\\cdot {\\color{blue}(-1)^{1+1}\\cdot \\begin{vmatrix}3 & -2 \\\\ -1 & 2\\end{vmatrix}} \\\\  & =4\\begin{vmatrix}3 & -2 \\\\ -1 & 2\\end{vmatrix} \\\\  & =4(3\\cdot 2-(-1)\\cdot (-2)) \\\\  & =4\\cdot 4 \\\\  & =16\\end{aligned}$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}4 & 1 & 0 & 0 \\\\ 0 & 0 & 3 & -2 \\\\ 0 & 2 & 0 & 0 \\\\ 5 & 0 & -1 & 2\\end{vmatrix}=-2\\cdot 16=-32.\n$$"] [17592186369693 "Using a cofactor expansion along the $3$rd column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}3 & 2 & {\\color{red}-2} & -2 \\\\ 1 & -1 & {\\color{red}0} & 3 \\\\ 2 & 5 & {\\color{red}0} & 1 \\\\ -2 & 4 & {\\color{red}1} & -2\\end{vmatrix} & ={\\color{red}(-2)}\\cdot {\\color{blue}{C}_{13}}+{\\color{red}0}\\cdot {\\color{black}{C}_{23}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}1}\\cdot {\\color{blue}{C}_{43}} \\\\  & ={\\color{red}(-2)}\\cdot {\\color{blue}(-1)^{1+3}\\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}}+{\\color{red}1}\\cdot {\\color{blue}(-1)^{4+3}\\cdot \\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix}} \\\\  & =-2\\cdot \\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}-\\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix}.\\end{aligned}$$"] [17592186370926 "Using a cofactor expansion along the $3$rd column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}1 & 1 & {\\color{red}0} & -1 \\\\ 3 & -1 & {\\color{red}\\sqrt{2}} & 1 \\\\ -1 & 1 & {\\color{red}0} & -1 \\\\ -2 & 5 & {\\color{red}\\sqrt{3}} & 1\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{13}}+{\\color{red}\\sqrt{2}}\\cdot {\\color{blue}{C}_{23}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}\\sqrt{3}}\\cdot {\\color{blue}{C}_{43}} \\\\  & ={\\color{red}\\sqrt{2}}\\cdot {\\color{blue}(-1)^{2+3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}}+{\\color{red}\\sqrt{3}}\\cdot {\\color{blue}(-1)^{4+3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}} \\\\  & =-\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}-\\sqrt{3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}.\\end{aligned}$$"] [17592186370933 "Using cofactor expansion along the third row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}2 & 3 & 0 & 0 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 0 & -1 & 1\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{31}}+{\\color{red}2}\\cdot {\\color{blue}{C}_{32}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}0}\\cdot {\\color{black}{C}_{34}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{3+2}\\cdot \\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 1 & -1 & 1\\end{vmatrix}} \\\\  & =-2\\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 1 & -1 & 1\\end{vmatrix}\\end{aligned}$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\\begin{aligned}\\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 1 & -1 & 1\\end{vmatrix} & ={\\color{red}2}\\cdot {\\color{blue}{C}_{11}}+{\\color{red}0}\\cdot {\\color{black}{C}_{12}}+{\\color{red}0}\\cdot {\\color{black}{C}_{13}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{1+1}\\cdot \\begin{vmatrix}1 & 2 \\\\ -1 & 1\\end{vmatrix}} \\\\  & =2\\begin{vmatrix}1 & 2 \\\\ -1 & 1\\end{vmatrix} \\\\  & =2(1\\cdot 1-2\\cdot (-1)) \\\\  & =2\\cdot 3 \\\\  & =6\\end{aligned}$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}2 & 3 & 0 & 0 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 0 & -1 & 1\\end{vmatrix}=-2\\cdot 6=-12.\n$$"] [17592186371077 "Using cofactor expansion along the $4$th row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}1 & 2 & 4 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & -2 & 4 \\\\ {\\color{red}3} & {\\color{red}0} & {\\color{red}0} & {\\color{red}1}\\end{vmatrix} & ={\\color{red}3}\\cdot {\\color{blue}{C}_{41}}+{\\color{red}0}\\cdot {\\color{black}{C}_{42}}+{\\color{red}0}\\cdot {\\color{black}{C}_{43}}+{\\color{red}1}\\cdot {\\color{black}{C}_{44}} \\\\  & ={\\color{red}3}\\cdot {\\color{blue}(-1)^{4+1}\\cdot \\begin{vmatrix}2 & 4 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & -2 & 4\\end{vmatrix}}+{\\color{red}1}\\cdot {\\color{blue}(-1)^{4+4}\\cdot \\begin{vmatrix}1 & 2 & 4 \\\\ 1 & 2 & 0 \\\\ 0 & 1 & -2\\end{vmatrix}} \\\\  & =-3\\begin{vmatrix}2 & 4 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & -2 & 4\\end{vmatrix}+1\\begin{vmatrix}1 & 2 & 4 \\\\ 1 & 2 & 0 \\\\ 0 & 1 & -2\\end{vmatrix}.\\end{aligned}$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain: \n\n$$\\begin{aligned}\\begin{vmatrix}2 & 4 & 1 \\\\ {\\color{red}2} & {\\color{red}0} & {\\color{red}0} \\\\ 1 & -2 & 4\\end{vmatrix} & ={\\color{red}2}\\cdot {\\color{blue}{C}_{21}}+{\\color{red}0}\\cdot {\\color{black}{C}_{22}}+{\\color{red}0}\\cdot {\\color{black}{C}_{23}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{2+1}\\cdot \\begin{vmatrix}4 & 1 \\\\ -2 & 4\\end{vmatrix}} \\\\  & =-2\\begin{vmatrix}4 & 1 \\\\ -2 & 4\\end{vmatrix} \\\\  & =-2(16-(-2)) \\\\  & =-36\\end{aligned}$$\n\n \nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along its $3$rd row:\n\n$$\\begin{aligned}\\begin{vmatrix}1 & 2 & 4 \\\\ 1 & 2 & 0 \\\\ {\\color{red}0} & {\\color{red}1} & {\\color{red}-2}\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{31}}+{\\color{red}1}\\cdot {\\color{blue}{C}_{32}}+{\\color{red}(-2)}\\cdot {\\color{blue}{C}_{33}} \\\\  & ={\\color{red}1}\\cdot {\\color{blue}(-1)^{3+2}\\cdot \\begin{vmatrix}1 & 4 \\\\ 1 & 0\\end{vmatrix}}+{\\color{red}(-2)}\\cdot {\\color{blue}(-1)^{3+3}\\cdot \\begin{vmatrix}1 & 2 \\\\ 1 & 2\\end{vmatrix}} \\\\  & =-\\begin{vmatrix}1 & 4 \\\\ 1 & 0\\end{vmatrix}-2\\begin{vmatrix}1 & 2 \\\\ 1 & 2\\end{vmatrix} \\\\  & =-(0-4)-2(2-2) \\\\  & =4+0 \\\\  & =4\\end{aligned}$$\n\n \n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & 2 & 4 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & -2 & 4 \\\\ 3 & 0 & 0 & 1\\end{vmatrix}=-3\\cdot (-36)+1\\cdot 4=112.\n$$"] [17592186377575 "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $A\\mathbf{x}=\\mathbf{b}$ has exactly one solution for any $2\\times 1$ column vector $\\mathbf{b}.$\n\n- The system $A\\mathbf{x}=\\mathbf{0}$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $\\det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nAccording to the invertible matrix theorem, if the lines $-kx+3y=3$ and $x+2y=0$ intersect at one point, then\n\n$$\nA=\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}\n$$\n\nis invertible and $\\det(A)\\ne 0$, which implies that ${A}^{-1}$ exists ($A$ is non-singular). Additionally, the unique solution of $A\\mathbf{x}=\\mathbf{0}$ is $\\mathbf{x}=⟨0,0⟩$ and\n\n$$\n\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}\n$$\n\nhas exactly one solution, which is the intersection point of the lines."] [17592186377668 "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $A\\mathbf{x}=\\mathbf{b}$ has exactly one solution for any $2\\times 1$ column vector $\\mathbf{b}.$\n\n- The system $A\\mathbf{x}=\\mathbf{0}$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $\\det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}\\det(A) & =\\det\\begin{bmatrix}2 & -3 \\\\ 2 & -2\\end{bmatrix} \\\\  & =2\\cdot (-2)-(-3)\\cdot 2 \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement “$A$ is **not** invertible” is false by the first part of the invertible matrix theorem.\n\n- Statement “The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point” is true by the fourth part of the invertible matrix theorem.\n\n- Statement “$A\\mathbf{x}=\\mathbf{0}$ has no solution” is false since, according to the third part of the invertible matrix theorem, the system $A\\mathbf{x}=\\mathbf{0}$ has the unique zero solution.\n\nTherefore, only statement “The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point” is true."] [17592186383279 "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[A\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}-6 & 1 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & :={R}_{1}+6{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 6 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ 0 & 1 & 1 & 6\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 1 & 6\\end{bmatrix}.\n$$"] [17592186383286 "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[A\\,|\\,I] & =\\left[\\begin{array}{cc|cc}-2 & 1 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ -2 & 1 & 1 & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ 0 & 1 & 1 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}↔{R}_{2},\\,{R}_{2}:={R}_{2}+2{R}_{1}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 1 & 2\\end{bmatrix}.\n$$"] [17592186385599 "We write down $S$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $S$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[S\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 0 \\\\ 1 & 3 & 0 & 1\\end{array}\\right] & {R}_{2} & ↔{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 3 & 0 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & -3 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${S}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{S}^{-1}=\\begin{bmatrix}-3 & 1 \\\\ 1 & 0\\end{bmatrix}.\n$$"] [17592186386048 "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}x+3y &=0 \\\\ 2y &=1.\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $A\\mathbf{x}=\\mathbf{b}:$\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-0\\cdot 3}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\end{aligned}$$"] [17592186387318 "This system can be written as\n\n$$\n\\begin{bmatrix}5 & -2 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}5 & -2 \\\\ 2 & -1\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot (-1)-(-2)\\cdot 2}\\begin{bmatrix}-1 & 2 \\\\ -2 & 5\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}-1 & 2 \\\\ -2 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -5\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -5\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\\end{aligned}$$"] [17592186388209 "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[A\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 0 \\\\ 1 & -2 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & -2 & 0 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}.\n$$"] [17592186390694 "This system can be written as\n\n$$\n\\begin{bmatrix}5 & -2 \\\\ 8 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}5 & -2 \\\\ 8 & 3\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 3-(-2)\\cdot 8}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix} \\\\  & =\\frac{1}{31}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\frac{1}{31}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\end{aligned}$$"] [17592186390711 "This system can be written as\n\n$$\n\\begin{bmatrix}1 & -1 \\\\ 2 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}1 & -1 \\\\ 2 & 3\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 3-(-1)\\cdot 2}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\frac{1}{5}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}\\end{aligned}$$"] [17592186390718 "This system can be written as\n\n$$\n\\begin{bmatrix}2 & 6 \\\\ 8 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}2 & 6 \\\\ 8 & 1\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 1-6\\cdot 8}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix} \\\\  & =-\\frac{1}{46}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =-\\frac{1}{46}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}\\end{aligned}$$"] [17592186392468 "Using a cofactor expansion along the $4$th column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}2 & -1 & 4 & {\\color{red}0} \\\\ 3 & 1 & 2 & {\\color{red}2} \\\\ -1 & 2 & 3 & {\\color{red}0} \\\\ -3 & -2 & 5 & {\\color{red}-1}\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{14}}+{\\color{red}2}\\cdot {\\color{blue}{C}_{24}}+{\\color{red}0}\\cdot {\\color{black}{C}_{34}}+{\\color{red}(-1)}\\cdot {\\color{blue}{C}_{44}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{2+4}\\cdot \\begin{vmatrix}2 & -1 & 4 \\\\ -1 & 2 & 3 \\\\ -3 & -2 & 5\\end{vmatrix}}+{\\color{red}(-1)}\\cdot {\\color{blue}(-1)^{4+4}\\cdot \\begin{vmatrix}2 & -1 & 4 \\\\ 3 & 1 & 2 \\\\ -1 & 2 & 3\\end{vmatrix}} \\\\  & =2\\cdot \\begin{vmatrix}2 & -1 & 4 \\\\ -1 & 2 & 3 \\\\ -3 & -2 & 5\\end{vmatrix}-\\begin{vmatrix}2 & -1 & 4 \\\\ 3 & 1 & 2 \\\\ -1 & 2 & 3\\end{vmatrix}.\\end{aligned}$$"] [17592186392973 "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\\begin{aligned}\\begin{vmatrix}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ {\\color{red}0} & {\\color{red}0} & {\\color{red}0} & {\\color{red}2} \\\\ 5 & -1 & -2 & 2\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{31}}+{\\color{red}0}\\cdot {\\color{black}{C}_{32}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}2}\\cdot {\\color{blue}{C}_{34}} \\\\  & ={\\color{red}2}\\cdot {\\color{blue}(-1)^{3+4}\\cdot \\begin{vmatrix}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{vmatrix}} \\\\  & =-2\\cdot \\begin{vmatrix}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{vmatrix}.\\end{aligned}$$"] [17592186393215 "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\left\\{\\begin{aligned}3x-y &=4 \\\\ x+2y &=-1.\\end{aligned}\\right.\n$$\n\nNow, we can represent this system of equations in the form $A\\mathbf{x}=\\mathbf{b}:$\n\n$$\n\\begin{bmatrix}3 & -1 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}3 & -1 \\\\ 1 & 2\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-(-1)\\cdot 1}\\begin{bmatrix}2 & 1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\frac{1}{7}\\begin{bmatrix}2 & 1 \\\\ -1 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\frac{1}{7}\\begin{bmatrix}2 & 1 \\\\ -1 & 3\\end{bmatrix}\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}\\end{aligned}$$"] [17592186393709 "Using a cofactor expansion along the $4$th column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}3 & -1 & 4 & {\\color{red}0} \\\\ 2 & 0 & 2 & {\\color{red}5} \\\\ 1 & 2 & 0 & {\\color{red}0} \\\\ 1 & 2 & 4 & {\\color{red}0}\\end{vmatrix} & ={\\color{red}0}\\cdot {\\color{black}{C}_{14}}+{\\color{red}5}\\cdot {\\color{blue}{C}_{24}}+{\\color{red}0}\\cdot {\\color{black}{C}_{34}}+{\\color{red}0}\\cdot {\\color{blue}{C}_{44}} \\\\  & ={\\color{red}5}\\cdot {\\color{blue}(-1)^{2+4}\\cdot \\begin{vmatrix}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{vmatrix}} \\\\  & =5\\cdot \\begin{vmatrix}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{vmatrix}.\\end{aligned}$$"] [17592186393716 "Using a cofactor expansion along the $3$rd column, we have\n\n$$\\begin{aligned}\\begin{vmatrix}3 & 2 & {\\color{red}\\sqrt{3}} & -1 \\\\ -1 & -1 & {\\color{red}0} & 1 \\\\ -2 & 1 & {\\color{red}0} & -1 \\\\ -1 & 5 & {\\color{red}\\sqrt{5}} & 1\\end{vmatrix} & ={\\color{red}\\sqrt{3}}\\cdot {\\color{black}{C}_{13}}+{\\color{red}0}\\cdot {\\color{blue}{C}_{23}}+{\\color{red}0}\\cdot {\\color{black}{C}_{33}}+{\\color{red}\\sqrt{5}}\\cdot {\\color{blue}{C}_{43}} \\\\  & ={\\color{red}\\sqrt{3}}\\cdot {\\color{blue}(-1)^{1+3}\\cdot \\begin{vmatrix}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{vmatrix}}+{\\color{red}\\sqrt{5}}\\cdot {\\color{blue}(-1)^{4+3}\\cdot \\begin{vmatrix}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{vmatrix}} \\\\  & =\\sqrt{3}\\cdot \\begin{vmatrix}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{vmatrix}-\\sqrt{5}\\cdot \\begin{vmatrix}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{vmatrix}.\\end{aligned}$$"] [17592186394786 "This system can be written as\n\n$$\n\\begin{bmatrix}0 & 8 \\\\ -5 & 6\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 \\\\ 7\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}0 & 8 \\\\ -5 & 6\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 0-(-5)\\cdot 8}\\begin{bmatrix}6 & -8 \\\\ 5 & 0\\end{bmatrix} \\\\  & =\\frac{1}{40}\\begin{bmatrix}6 & -8 \\\\ 5 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\\begin{aligned}\\mathbf{x} & ={A}^{-1}\\mathbf{b} \\\\  & =\\frac{1}{40}\\begin{bmatrix}6 & -8 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}6 \\\\ 7\\end{bmatrix}\\end{aligned}$$"] [17592186398368 "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[A\\,|\\,I] & =\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ -10 & -2 & 0 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+10{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & -2 & 10 & 1\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & -5 & -\\frac{1}{2}\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:={R}_{2}+10{R}_{1},\\,{R}_{2}:=-\\frac{1}{2}{R}_{2}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}1 & 0 \\\\ -5 & -\\frac{1}{2}\\end{bmatrix}.\n$$"] [17592186398375 "We write down $Y$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $Y$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}{}[Y\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}4 & -1 & 1 & 0 \\\\ -3 & 1 & 0 & 1\\end{array}\\right] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 1 \\\\ -3 & 1 & 0 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 1 \\\\ 0 & 1 & 3 & 4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:={R}_{1}+{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}.\n$$\n\nThe matrix ${Y}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{Y}^{-1}=\\begin{bmatrix}1 & 1 \\\\ 3 & 4\\end{bmatrix}.\n$$"]}
