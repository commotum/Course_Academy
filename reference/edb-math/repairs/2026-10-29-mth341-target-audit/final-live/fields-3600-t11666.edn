ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4+2y \\\\ y\\end{bmatrix},\\quad y\\in(-\\infty,\\infty)" :db/id #edb/ref 17592186713262} {:answer/id #uuid "2aaa131b-e396-5ac3-b35d-9e0598797bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4-2y \\\\ y\\end{bmatrix},\\quad y\\in(-\\infty,\\infty)" :db/id #edb/ref 17592186713266} {:answer/id #uuid "494d8700-5cfd-5f23-bc29-1c8ce6fae33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2-4y \\\\ y\\end{bmatrix},\\quad y\\in(-\\infty,\\infty)" :db/id #edb/ref 17592186713269} {:answer/id #uuid "6dc8e293-cf40-56fc-9fd5-083b57a5a666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186713272} {:answer/id #uuid "7aab75a1-b7aa-5cd4-926d-5e9fbdc3f0b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4-2y \\\\ y\\end{bmatrix},\\quad y\\in(-\\infty,\\infty)" :db/id #edb/ref 17592186713274}] :answer-field/correct {:db/id #edb/ref 17592186713274} :answer-field/id #uuid "feaf4329-538b-539b-92df-155c2b0550e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713280}] [{:answer-field/choices [{:answer/feedback "The repeated equation does not cause inconsistency. The third coordinate gives the missing independent equation." :answer/id #uuid "50be0dbb-729f-527e-a8dd-e4bcd0b394c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713322} {:answer/feedback "This is $t$. The requested value is $s\\cdot t$." :answer/id #uuid "91a39ad4-cd8c-5671-9d2f-0a41cbe97000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713329} {:answer/feedback "Yes. The pair $(4,-1)$ satisfies all three coordinates and has product $-4$." :answer/id #uuid "a80f81d5-d260-5a89-ba0f-55d6260788ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713331} {:answer/feedback "This is the sum $s+t$. Use the product after checking membership." :answer/id #uuid "ed295388-d435-5252-b201-efc65f104216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713335} {:answer/feedback "This is $s$. Multiply it by $t=-1$." :answer/id #uuid "f884e554-fb60-56f5-9de4-d70b8aac748d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713336}] :answer-field/correct {:db/id #edb/ref 17592186713331} :answer-field/id #uuid "201e8260-65cd-578b-8403-3aa3a5fdf53e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713320}] [{:answer-field/choices [{:answer/feedback "The signs of $s=2$ and $t=-1$ differ, so their product is negative." :answer/id #uuid "05eed988-5442-593c-88d6-9715f575714b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186713318} {:answer/feedback "Yes. The pair $(2,-1)$ satisfies every coordinate, and its product is $-2$." :answer/id #uuid "10f26121-320a-57ba-bb34-5ddef5eaf638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713319} {:answer/feedback "The third equation holds: $2+2(-1)=0$." :answer/id #uuid "686fc79b-533a-5d0a-a7f5-10ce4acd911b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\math