#{[{:db/id #edb/ref 17592186391769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96fe8ea5-6816-5080-896c-06099a363468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 2 \\\\ 4 \\\\ 11\\end{bmatrix}" :db/id #edb/ref 17592186391771} {:answer/id #uuid "3a2e0c2f-6803-55a5-a5f2-e054623d8ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 4 \\\\ 2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186391772} {:answer/id #uuid "29c4b51b-0698-508e-a6f7-8d02ca0c1eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2 \\\\ 6 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186391773} {:answer/id #uuid "daf1ae0f-726d-57c8-8c92-a3fce61a6349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -2 \\\\ 6 \\\\ 11\\end{bmatrix}" :db/id #edb/ref 17592186391774} {:answer/id #uuid "0d6772bb-89f5-5ddb-bfb0-b3b493fd97bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 2 \\\\ 6 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186391775}] :answer-field/correct {:db/id #edb/ref 17592186391771} :answer-field/id #uuid "48032479-0a2f-561c-a438-98d70ba6d18f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df695587-ec35-5395-87f6-af8d0149e4cf" :question/math-academy-id "q-34158" :question/problem "Let $c=\\begin{bmatrix}-2 \\\\ 0 \\\\ -1 \\\\ 4\\end{bmatrix}$ and $d=\\begin{bmatrix}-3 \\\\ 2 \\\\ 5 \\\\ 7\\end{bmatrix}.$ Find $c+d.$" :question/worked-solution "We add the vectors:\n\n$$\n\\begin{aligned}c+d & =\\begin{bmatrix}-2 \\\\ 0 \\\\ -1 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2 \\\\ 5 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2-3 \\\\ 0+2 \\\\ -1+5 \\\\ 4+7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 \\\\ 2 \\\\ 4 \\\\ 11\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186391776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ac916e8-03ca-50c6-a581-99efb62080da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1 \\\\ 2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186391778} {:answer/id #uuid "bbca5d51-9467-522a-90f5-b76d315856f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-16 \\\\ 0 \\\\ 4 \\\\ -12\\end{bmatrix}" :db/id #edb/ref 17592186391779} {:answer/id #uuid "2b1834b3-3172-5c19-9a0e-d0036d146feb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 0 \\\\ 1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186391780} {:answer/id #uuid "b5904f76-ac24-5756-95c2-25879fe2c82f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 0 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186391781} {:answer/id #uuid "5239f020-e220-5486-bc08-ed6c3a4dfce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ -1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186391782}] :answer-field/correct {:db/id #edb/ref 17592186391780} :answer-field/id #uuid "4ae05a79-f1b0-58e1-b8aa-a4e576dece13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391777}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8972b624-d396-5686-85e2-b86ff24317e5" :question/math-academy-id "q-34164" :question/problem "If $b=\\begin{bmatrix}8 \\\\ 0 \\\\ -2 \\\\ 6\\end{bmatrix}$, then $-\\frac{1}{2}b=$" :question/worked-solution "Multiplying each component of $b$ by $-\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}-\\frac{1}{2}b & =-\\frac{1}{2}\\begin{bmatrix}8 \\\\ 0 \\\\ -2 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{2}\\cdot 8 \\\\ -\\frac{1}{2}\\cdot 0 \\\\ -\\frac{1}{2}\\cdot (-2) \\\\ -\\frac{1}{2}\\cdot 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ 0 \\\\ 1 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186391783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85f41bc9-f4ee-5d83-994c-749f81c2660b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3 \\\\ 1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186391785} {:answer/id #uuid "1fc7fe12-0d07-584b-a201-6102f0c5b1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2 \\\\ -1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186391786} {:answer/id #uuid "05748cf4-d1bd-5419-be64-8c8db1e5750b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2 \\\\ -4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186391787} {:answer/id #uuid "6fe63be9-6453-5e49-b83e-0d29a78eb50b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 4 \\\\ -2 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186391788} {:answer/id #uuid "b86123ea-e25f-5dda-a9f4-fff4e748aacf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2 \\\\ 1 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186391789}] :answer-field/correct {:db/id #edb/ref 17592186391786} :answer-field/id #uuid "48107f1f-739e-57c9-8924-b10a2cc5e9d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "815b0df7-6a48-559f-aa63-735c856d741c" :question/math-academy-id "q-34228" :question/problem "If $c=\\begin{bmatrix}12 \\\\ -8 \\\\ 4 \\\\ 16\\end{bmatrix}$, then $-\\frac{1}{4}c=$" :question/worked-solution "Multiplying each component of $c$ by $-\\frac{1}{4},$ we get\n\n$$\n\\begin{aligned}-\\frac{1}{4}c & =-\\frac{1}{4}\\begin{bmatrix}12 \\\\ -8 \\\\ 4 \\\\ 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{4}\\cdot 12 \\\\ -\\frac{1}{4}\\cdot (-8) \\\\ -\\frac{1}{4}\\cdot 4 \\\\ -\\frac{1}{4}\\cdot 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ 2 \\\\ -1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186391871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f0198d9-f83e-5d0e-a8f2-b00c3ca2d46b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}4{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186391873} {:answer/id #uuid "5f0421dd-4b76-5b27-941c-50a51355f127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186391874} {:answer/id #uuid "98535724-16db-586b-94d6-47675062a82b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-11{x}_{2} \\\\ {x}_{2} \\\\ 4{x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391875} {:answer/id #uuid "fb7b7c44-935c-5b9c-95d9-ab7dff1476d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-11{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186391876} {:answer/id #uuid "4d601e9e-c427-56eb-9ac5-b71bffd8d3e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{1} \\\\ 4{x}_{1} \\\\ -11{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186391877}] :answer-field/correct {:db/id #edb/ref 17592186391876} :answer-field/id #uuid "6fde154e-f5aa-5ee6-91b0-0f999f1f1a17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391872}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d54de9d5-0eaf-51ac-a971-a5633a39368a" :question/math-academy-id "q-34334" :question/problem "Consider the matrix $A=\\begin{bmatrix}3 & 6 & 9 \\\\ 4 & 9 & 8 \\\\ 4 & 8 & 12\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 6 & 9 \\\\ 4 & 9 & 8 \\\\ 4 & 8 & 12\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 4 & 9 & 8 \\\\ 4 & 8 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & 1 & -4 \\\\ 4 & 8 & 12\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+3{x}_{3} &=0 \\\\ {x}_{2}-4{x}_{3} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2}$, and we have one free variables, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$\n\nFrom the second equation we get ${x}_{2}=4{x}_{3}.$ Substituting ${x}_{2}=4{x}_{3}$ into the first equation, we get \n\n$$\n{x}_{1}+2(4{x}_{3})+3{x}_{3}=0\\,⟹\\,{x}_{1}=-11{x}_{3}.\n$$\n\nSo the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)={\\begin{bmatrix}-11{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}.\n$$"}] [{:db/id #edb/ref 17592186396592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a58b77f-aa33-52d3-a1ab-4bbbe9ed2639" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of polynomials is not associative" :db/id #edb/ref 17592186396594} {:answer/id #uuid "cb6dcbd0-7e6a-5124-8dfb-30e54362007c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition and scalar multiplication of polynomials do not satisfy the distributive laws" :db/id #edb/ref 17592186396595} {:answer/id #uuid "3afd6545-9a30-5d6b-bce2-014c2d72383f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of polynomials in $Y$ is not closed" :db/id #edb/ref 17592186396596} {:answer/id #uuid "8ab25e26-7932-539a-b22c-b438766b2222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of polynomials is not commutative" :db/id #edb/ref 17592186396597} {:answer/id #uuid "257d280c-e23a-51f0-8ab9-6c6a6d270300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot p\\ne p$ for some $p\\in Y$" :db/id #edb/ref 17592186396598}] :answer-field/correct {:db/id #edb/ref 17592186396596} :answer-field/id #uuid "8e07246a-b3d7-5b8e-9074-824239bfbe46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c206776-99db-55ba-ae48-7c0ec7d6d597" :question/math-academy-id "q-106929" :question/problem "Let $Y$ be the set of all polynomials in the variable $x\\in R$ with coefficients in $R$ of degree exactly $2.$ Complete the following sentence:\n\n*$Y$ is **not** a vector space (with respect to polynomials addition and multiplication of a polynomial by a real number) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$Y$ is **not** a vector space (with respect to polynomials addition and multiplication of a polynomial by a real number) because **addition of polynomials in $Y$ is not closed.*** \n\nIndeed, let's consider, for example, the polynomials $p(x)={x}^{2}+x$ and $q(x)=-{x}^{2}.$ Then $p,q\\in Y,$ but \n\n$$\np(x)+q(x)={x}^{2}+x+(-{x}^{2})=x\\notin Y\n$$\n\n because $\\operatorname{deg}⁡(p+q)=1\\ne 2.$\n\nOn the other hand:\n\n- $1\\cdot p=p$ for all $p\\in Y.$ $\\,✓$\n\n- Addition and scalar multiplication of polynomials satisfy the distributive laws. $\\,✓$\n\n- Addition of polynomials is commutative. $\\,✓$\n\n- Addition of polynomials is associative. $\\,✓$"}] [{:db/id #edb/ref 17592186396599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0fcd6c1-3e34-5869-bda3-f3935c249cfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot f\\ne f$ for some $f\\in L$" :db/id #edb/ref 17592186396601} {:answer/id #uuid "9ae69b77-733b-5c58-bc2b-3800bcfe26dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplication of $f\\in L$ by a scalar is not closed" :db/id #edb/ref 17592186396602} {:answer/id #uuid "dac8d022-edf8-56b5-99c7-7f2b00e051d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions in $L$ is not associative" :db/id #edb/ref 17592186396603} {:answer/id #uuid "6358779e-1da8-5238-9ef6-81ac25fc065f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions in $L$ is not commutative" :db/id #edb/ref 17592186396604} {:answer/id #uuid "85442eb9-7db8-592f-9879-ddfd77d97231" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition and scalar multiplication of functions in $L$ do not satisfy the distributive laws" :db/id #edb/ref 17592186396605}] :answer-field/correct {:db/id #edb/ref 17592186396602} :answer-field/id #uuid "f09dfa2c-f035-539f-94db-4698ecc43f0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396600}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "15beea94-47dc-575a-be81-e2d3b2547e2f" :question/math-academy-id "q-106930" :question/problem "Let $L$ be the set of all functions $f:R\\to R$ of the form $f(x)=ax+1,$ where $a\\in R.$ Complete the following sentence:\n\n*$L$ is **not** a vector space (with respect to function addition and scalar multiplication of a function by a real number) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$L$ is **not** a vector space (with respect to function addition and scalar multiplication of a function by a real number) because **multiplication of $f\\in L$ by a scalar is not closed.*** \n\nFor example, if $\\alpha =2$ and $f(x)=x+1,$ then $\\alpha f(x)=2x+2.$ So, $\\alpha f(x)\\notin L$ because the constant term is not $1.$\n\nOn the other hand:\n\n- Addition of real valued functions is associative. $\\,✓$\n\n- Addition of real valued functions is commutative. $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in L.$ $\\,✓$\n\n- Addition and scalar multiplication of real valued functions satisfy the distributive laws.\n$\\,✓$"}] [{:db/id #edb/ref 17592186396606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62b7fc67-e9bb-5a0f-8e80-9dcf56649314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions is not commutative" :db/id #edb/ref 17592186396608} {:answer/id #uuid "7cd140b2-7871-5579-9e98-6ecf9f3f51ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions is not associative" :db/id #edb/ref 17592186396609} {:answer/id #uuid "1e058a54-9658-5798-ba7c-a86d9840498e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition and scalar multiplication of functions do not satisfy the distributive laws" :db/id #edb/ref 17592186396610} {:answer/id #uuid "d6932b0d-e307-5cc8-971a-38fac820cb2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot f\\ne f$ for some $f\\in I$" :db/id #edb/ref 17592186396611} {:answer/id #uuid "4d629cc1-8c34-5761-b952-696843bcc069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$I$ does not contain the zero element" :db/id #edb/ref 17592186396612}] :answer-field/correct {:db/id #edb/ref 17592186396612} :answer-field/id #uuid "c7ef701a-1be0-572c-baca-f76e42023271" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "17d56701-363e-5629-ba43-f0ff54124002" :question/math-academy-id "q-106933" :question/problem "Let $I$ be the set of all functions $f:R\\to R$ of the form $f(x)={2}^{ax},$ where $a\\in R.$ Complete the following sentence:\n\n*$I$ is **not** a vector space (with respect to function addition and scalar multiplication of a function by a real number) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$I$ is **not** a vector space (with respect to function addition and scalar multiplication of a function by a real number) because **$I$ does not contain the zero element.*** \n\nIndeed, $f(x)={2}^{ax}>0$ for all $x\\in R$ for any $a\\in R,$ hence the zero function $z(x)=0\\notin I.$\n\nOn the other hand:\n\n- Addition of real valued functions  is associative. $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in I.$ $\\,✓$\n\n- Addition and scalar multiplication of polynomials satisfy the distributive laws.\n$\\,✓$\n\n- Addition of real valued functions  is commutative. $\\,✓$"}] [{:db/id #edb/ref 17592186396722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dced25c9-e7ab-5f35-8521-98dbb4380860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of polynomials is not associative" :db/id #edb/ref 17592186396724} {:answer/id #uuid "44e5f623-8068-52a9-b610-cc58b0a625bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of polynomials is not commutative" :db/id #edb/ref 17592186396725} {:answer/id #uuid "93ab4050-ad19-5d1c-8155-556dd79d719e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot f\\ne f$ for some $f\\in S$" :db/id #edb/ref 17592186396726} {:answer/id #uuid "4542450e-69bf-52e8-919b-58face6ea7bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplication of functions in  $S$ by real scalars is not closed" :db/id #edb/ref 17592186396727} {:answer/id #uuid "9ba8a7fb-33bd-5b6d-a7ee-19ce6a4656ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ does not contain the zero function" :db/id #edb/ref 17592186396728}] :answer-field/correct {:db/id #edb/ref 17592186396727} :answer-field/id #uuid "689b4114-c1d3-5f0f-8182-74e6a0c999f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0cbcdef-8d32-524c-bf12-b31a8feacf80" :question/math-academy-id "q-94798" :question/problem "Let $S$ be the set of all polynomials in the real  variable $x$ with coefficients in $Q.$ Complete the following sentence: \n\n*$S$ is **not** a vector space (with respect to polynomials addition and multiplication of a polynomial by a real number) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$S$ is **not** a vector space (with respect to polynomials addition and multiplication of a polynomial by a real number) because **multiplication of functions in  $S$ by real scalars is not closed.*** \n\nIndeed, let's consider, for example, the polynomial  $f(x)=x.$ Then $f\\in S$, but $\\sqrt{2}f(x)=\\sqrt{2}\\,\\text{ }x\\notin S$ because $\\sqrt{2}\\notin Q.$\nOn the other hand: \n\n- Addition of polynomials is associative. $\\,✓$\n\n- Addition of polynomials is commutative. $\\,✓$\n\n- The zero function belongs to $S.$ $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in S.$ $\\,✓$"}] [{:db/id #edb/ref 17592186399587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96cab4fe-b011-5072-be3e-391125bf75c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A3}$, $\\text{A6}$" :db/id #edb/ref 17592186399589} {:answer/id #uuid "479eb2f9-8717-57b1-9f07-9c964bbfdbab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A2}$, $\\text{A7}$" :db/id #edb/ref 17592186399590} {:answer/id #uuid "fcde83fb-02ab-5892-a45a-6c4b43adb9eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A7}$, $\\text{A5}$" :db/id #edb/ref 17592186399591} {:answer/id #uuid "e44c72a4-6813-558a-a34c-560c1aff92da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A3}$, $\\text{A5}$" :db/id #edb/ref 17592186399592} {:answer/id #uuid "afcd5ca7-6625-5f48-ac5f-5ce7f390cf1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A6}$, $\\text{A3}$" :db/id #edb/ref 17592186399593}] :answer-field/correct {:db/id #edb/ref 17592186399592} :answer-field/id #uuid "0fb9d1c7-c909-596f-a04a-7d5c7e74340d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399588}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "258def85-3c26-5841-81d2-c1a1f3c916a4" :question/math-academy-id "q-106944" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:* \n\n*$0\\cdot 0=0$* \n\n*Proof:*\n\n$$\n\\begin{aligned}0\\cdot 0 & =0\\cdot 0 &  & [\\,\\text{given}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+1\\cdot 0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ 0\\cdot 0 & =(0+1)\\cdot 0 &  & [\\,\\text{axiom A7}\\,] \\\\ 0\\cdot 0 & =1\\cdot 0 &  & [\\,\\text{addition of integers}\\,] \\\\ 0\\cdot 0 & =0 &  & [\\,\\text{axiom A5}\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following: \n\n$$\n\\begin{aligned}0\\cdot 0 & =0\\cdot 0 &  & [\\,\\text{given}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+0 &  & [\\,\\text{axiom }\\text{A3}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+1\\cdot 0 &  & [\\,\\text{axiom }\\text{A5}\\,] \\\\ 0\\cdot 0 & =(0+1)\\cdot 0 &  & [\\,\\text{axiom A7}\\,] \\\\ 0\\cdot 0 & =1\\cdot 0 &  & [\\,\\text{addition of integers}\\,] \\\\ 0\\cdot 0 & =0 &  & [\\,\\text{axiom A5}\\,]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0957d54-3a75-5c9c-85ed-c3fc9e27319a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{2}$ only" :db/id #edb/ref 17592186402364} {:answer/id #uuid "a07d906a-9817-56bc-a8bc-f84fb817ea22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$ only" :db/id #edb/ref 17592186402365} {:answer/id #uuid "ffba3c8a-b1b6-5ff8-95f5-61453383f036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402366} {:answer/id #uuid "574e668b-516f-527f-a863-a5d86ad524ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{2}$ and ${b}_{3}$ only" :db/id #edb/ref 17592186402367} {:answer/id #uuid "6b7c7a5a-0d78-5275-8321-8300ff247f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$ and ${b}_{2}$ only" :db/id #edb/ref 17592186402368}] :answer-field/correct {:db/id #edb/ref 17592186402364} :answer-field/id #uuid "504c5c81-a875-5c21-b5d2-42ca7fdd3f22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402363}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cade4505-b877-5cb5-ae1c-bc1354365d4f" :question/math-academy-id "q-34361" :question/problem "The matrix $A$ and vectors ${b}_{1}$, ${b}_{2}$, ${b}_{3}$ are given below. Which of the vectors lie in $\\text{Null}(A)?$\n\n$$\nA=\\begin{bmatrix}3 & -5 & 4 \\\\ 6 & -10 & 8\\end{bmatrix},\\,{b}_{1}=\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}4 \\\\ 8 \\\\ 7\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}-4 \\\\ -3 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "A vector $b$ lies in $\\text{Null}(A)$ if $Ab=0.$ So, we need to compute the product of $A$ and each of the given vectors and check whether it is equal to $0:$\n\n$$\n\\begin{aligned}A{b}_{1} & =\\begin{bmatrix}3 & -5 & 4 \\\\ 6 & -10 & 8\\end{bmatrix}\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}41 \\\\ 82\\end{bmatrix}\\ne 0\\,\\times  \\\\ A{b}_{2} & =\\begin{bmatrix}3 & -5 & 4 \\\\ 6 & -10 & 8\\end{bmatrix}\\begin{bmatrix}4 \\\\ 8 \\\\ 7\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\\,✓ \\\\ A{b}_{3} & =\\begin{bmatrix}3 & -5 & 4 \\\\ 6 & -10 & 8\\end{bmatrix}\\begin{bmatrix}-4 \\\\ -3 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}7 \\\\ 14\\end{bmatrix}\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, only ${b}_{2}$ lies in $\\text{Null}(A).$"}] [{:db/id #edb/ref 17592186402389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "492978d5-2bec-55d1-bdda-860ad257a369" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{2}$ only" :db/id #edb/ref 17592186402391} {:answer/id #uuid "f6789158-3583-5bab-89c7-6784cdb9397a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$,  ${b}_{2}$, and ${b}_{3}$" :db/id #edb/ref 17592186402392} {:answer/id #uuid "b68888a5-1eb0-5529-977b-9f744647ef8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$ only" :db/id #edb/ref 17592186402393} {:answer/id #uuid "7354f182-00ec-50bf-9755-be6a57c5b1ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402394} {:answer/id #uuid "36c2d878-22ee-54ba-8dc0-b9b9e3b0d0aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{2}$ and ${b}_{3}$ only" :db/id #edb/ref 17592186402395}] :answer-field/correct {:db/id #edb/ref 17592186402393} :answer-field/id #uuid "9d0b1afa-4467-52dd-b537-3af075fc6fea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65ef5949-cf70-59d8-adcb-422768352bc5" :question/math-academy-id "q-34984" :question/problem "The matrix $A$ and vectors ${b}_{1}$, ${b}_{2}$, ${b}_{3}$ are given below. Which of the vectors lie in $\\text{Null}(A)?$\n\n$$\nA=\\begin{bmatrix}0 & 2 & 4\\end{bmatrix},\\,{b}_{1}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "A vector $b$ lies in $\\text{Null}(A)$ if $Ab=0.$ So, we need to compute the product of $A$ and each of the given vectors and check whether it is equal to $0:$\n\n$$\n\\begin{aligned}A{b}_{1} & =\\begin{bmatrix}0 & 2 & 4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}=0\\,✓ \\\\ A{b}_{2} & =\\begin{bmatrix}0 & 2 & 4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}=-4\\ne 0\\,\\times  \\\\ A{b}_{3} & =\\begin{bmatrix}0 & 2 & 4\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}=4\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, only ${b}_{1}$ lies in $\\text{Null}(A).$"}] [{:db/id #edb/ref 17592186402434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c4f1d1a-384a-5b9f-b52c-026a37aea598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A3}$, $\\text{A2}$" :db/id #edb/ref 17592186402436} {:answer/id #uuid "7be29340-c311-570d-a8a5-d715d90e7b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A2}$, $\\text{A7}$" :db/id #edb/ref 17592186402437} {:answer/id #uuid "f3ffdc61-92b7-525f-ba13-ec7d8e5bece2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A7}$, $\\text{A3}$" :db/id #edb/ref 17592186402438} {:answer/id #uuid "dbb894df-460c-5d88-98ab-47811b8def6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A2}$, $\\text{A1}$" :db/id #edb/ref 17592186402439} {:answer/id #uuid "27104a21-fa7a-5b79-b863-dfef8c36d3cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A5}$, $\\text{A2}$" :db/id #edb/ref 17592186402440}] :answer-field/correct {:db/id #edb/ref 17592186402438} :answer-field/id #uuid "2a7cbdf1-0f6c-51d1-a347-9dc567706a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402435}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cf85bb24-d080-5608-9b8e-8c02ff8974d0" :question/math-academy-id "q-35559" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:* \n\n*$0x=0$ for any $x\\in V$* \n\n*Proof:*\n\n$$\n\\begin{aligned}0x & =0x &  & [\\,\\text{given}\\,] \\\\ (0+0)x & =0x &  & [\\,\\text{property of number }0\\,] \\\\ 0x+0x & =0x &  & [\\,\\text{axiom __}\\,\\,] \\\\ (0x+0x)+(-0x) & =0x+(-0x) &  & [\\,\\text{add }-0x\\text{ to both sides}\\,] \\\\ (0x+0x)+(-0x) & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ 0x+(0x+(-0x)) & =0 &  & [\\,\\text{axiom A2}\\,] \\\\ 0x+0 & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ 0x & =0 &  & [\\,\\text{axiom __}\\,\\,]\\end{aligned}\n$$\n\n \n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following: \n\n$$\n\\begin{aligned}0x & =0x &  & [\\,\\text{given}\\,] \\\\ (0+0)x & =0x &  & [\\,\\text{property of number }0\\,] \\\\ 0x+0x & =0x &  & [\\,\\text{axiom }\\text{A7}\\,] \\\\ (0x+0x)+(-0x) & =0x+(-0x) &  & [\\,\\text{add }-0x\\text{ to both sides}\\,] \\\\ (0x+0x)+(-0x) & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ 0x+(0x+(-0x)) & =0 &  & [\\,\\text{axiom A2}\\,] \\\\ 0x+0 & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ 0x & =0 &  & [\\,\\text{axiom }\\text{A3}\\,]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119efa2d-2c30-5748-95ef-f1f9d458348b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} \\\\ -\\frac{1}{5} \\\\ \\frac{3}{5} \\\\ \\frac{2}{5} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186411201} {:answer/id #uuid "48de7a8d-366b-5d22-8f97-49e3a7d870a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -5 \\\\ 3 \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186411215} {:answer/id #uuid "5a9abe9a-5a98-5c6d-a3e8-44d029e94902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 \\\\ -25 \\\\ 15 \\\\ 50 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186411221} {:answer/id #uuid "9417a634-7f92-5520-b975-c9c7f5cae661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} \\\\ -1 \\\\ \\frac{3}{5} \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186411233} {:answer/id #uuid "f60cb625-9f30-5307-9f1c-0bc77607184c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ 3 \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186411252}] :answer-field/correct {:db/id #edb/ref 17592186411233} :answer-field/id #uuid "3015237e-7b2d-548d-984d-ca9c09166d9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0aec8973-1dfc-5e32-a5d6-c0e8bf8b8440" :question/math-academy-id "q-73930" :question/problem "Let $w=\\begin{bmatrix}2 \\\\ -5 \\\\ 3 \\\\ 10 \\\\ 0\\end{bmatrix}.$ Find $\\frac{1}{5}w.$" :question/worked-solution "Multiplying each component of $w$ by $\\frac{1}{5},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{5}w & =\\frac{1}{5}\\begin{bmatrix}2 \\\\ -5 \\\\ 3 \\\\ 10 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{5}\\cdot 2 \\\\ \\frac{1}{5}\\cdot (-5) \\\\ \\frac{1}{5}\\cdot 3 \\\\ \\frac{1}{5}\\cdot 10 \\\\ \\frac{1}{5}\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{5} \\\\ -1 \\\\ \\frac{3}{5} \\\\ 2 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "578a4fb0-5d29-543a-b363-7d74eb7f4b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186411219} {:answer/id #uuid "6fad7444-0378-5902-b324-186df811114e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186411226} {:answer/id #uuid "adb284e4-ddba-507c-a606-ff692335b187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186411235} {:answer/id #uuid "aede447b-d581-5f0d-965c-4a10d72d89f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186411237} {:answer/id #uuid "e81e9587-09f0-55b5-8010-2c85e7724a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186411250}] :answer-field/correct {:db/id #edb/ref 17592186411226} :answer-field/id #uuid "44445a49-0a6e-5ad0-9ac8-d8b6292a9f9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16324101-11ba-5ac3-b499-b08b32289ecb" :question/math-academy-id "q-105108" :question/problem "Let $v=\\begin{bmatrix}7 \\\\ 2 \\\\ 3 \\\\ 4\\end{bmatrix}$ and $w=\\begin{bmatrix}1 \\\\ -5 \\\\ 4 \\\\ -5\\end{bmatrix}.$ What is $(2v)\\cdot w?$" :question/worked-solution "First, multiplying each component of $v$ by $2$, we get\n\n$$\n\\begin{aligned}2v & =2\\begin{bmatrix}7 \\\\ 2 \\\\ 3 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}14 \\\\ 4 \\\\ 6 \\\\ 8\\end{bmatrix}\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(2v)\\cdot w & =14\\cdot 1+4\\cdot (-5)+6\\cdot 4+8\\cdot (-5) \\\\  & =14-20+24-40 \\\\  & =-22\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088821a4-3897-5498-993d-4363e322c0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186411199} {:answer/id #uuid "1b653e39-5941-5255-8685-46ecb7bc2d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186411205} {:answer/id #uuid "48177a2f-a337-559d-8d5c-0df94de6cbfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186411214} {:answer/id #uuid "6b6af0a1-bada-5b9e-9046-ff9033b19308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186411225} {:answer/id #uuid "d81e9aab-3b35-5081-8c51-759cad294b1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186411246}] :answer-field/correct {:db/id #edb/ref 17592186411205} :answer-field/id #uuid "087bc630-46e1-553d-8ba3-2ea92bda14ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411254}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "535d2613-b3a1-5204-b804-20416fe47ef7" :question/math-academy-id "q-34163" :question/problem "If $b=\\begin{bmatrix}-3 \\\\ 2 \\\\ 1 \\\\ 4\\end{bmatrix}$ and $c=\\begin{bmatrix}-4 \\\\ -2 \\\\ 3 \\\\ 1\\end{bmatrix}$, then $b\\cdot c=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}b\\cdot c & ={b}_{1}\\cdot {c}_{1}+{b}_{2}\\cdot {c}_{2}+{b}_{3}\\cdot {c}_{3}+{b}_{4}\\cdot {c}_{4} \\\\  & =(-3)\\cdot (-4)+2\\cdot (-2)+1\\cdot 3+4\\cdot 1 \\\\  & =12-4+3+4 \\\\  & =15\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1957423a-442f-5ef4-a823-2167288015d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186411204} {:answer/id #uuid "32403ef3-5870-5204-aa02-b1a9ffc040de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186411211} {:answer/id #uuid "516c9081-fa09-5c11-a6ce-9a2a68957bf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186411217} {:answer/id #uuid "642b6abc-efff-5290-ae64-726fe5107889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186411224} {:answer/id #uuid "8a79b117-eb2d-5fb8-a211-0feb3de3deb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186411230}] :answer-field/correct {:db/id #edb/ref 17592186411211} :answer-field/id #uuid "0f39298e-f9eb-54c2-ba35-d12ad376d7bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411255}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a2c3118-2e96-5ebd-b1cc-e7d3498c7926" :question/math-academy-id "q-73940" :question/problem "Let $v=\\begin{bmatrix}-4 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{bmatrix}$ and $w=\\begin{bmatrix}1 \\\\ 4 \\\\ 1 \\\\ 2 \\\\ 2\\end{bmatrix}.$ What is $(-3v)\\cdot w?$" :question/worked-solution "First, multiplying each component of $v$ by $-3$, we get\n\n$$\n\\begin{aligned}-3v & =-3\\begin{bmatrix}-4 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}12 \\\\ -6 \\\\ 9 \\\\ -3 \\\\ -3\\end{bmatrix}\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(-3v)\\cdot w & =12\\cdot 1+(-6)\\cdot 4+9\\cdot 1+(-3)\\cdot 2+(-3)\\cdot 2 \\\\  & =12-24+9-6-6 \\\\  & =-15\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1804df3c-3eb9-536e-b08c-752d4c09cc0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 16 \\\\ 14 \\\\ -4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186411203} {:answer/id #uuid "a52a3c7c-20b9-59d5-af8b-ea4a379bd5ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 16 \\\\ 14 \\\\ -10 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186411234} {:answer/id #uuid "cea31079-cbf2-554f-bfa9-8f2bad7a07a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 8 \\\\ 7 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186411242} {:answer/id #uuid "db9c75f1-9792-5221-8e69-0a7ed8d167cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 13 \\\\ 7 \\\\ 4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186411247} {:answer/id #uuid "e39cd76e-30ab-52d8-bc4f-7f304f7500db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 8 \\\\ 5 \\\\ 4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186411249}] :answer-field/correct {:db/id #edb/ref 17592186411247} :answer-field/id #uuid "a309f7fa-27f9-52c6-b170-ba69fad7dd18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411259}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77ad5afc-06f9-5927-8017-a80efc594482" :question/math-academy-id "q-105099" :question/problem "Let $r=\\begin{bmatrix}6 \\\\ 5 \\\\ 0 \\\\ 6 \\\\ 2\\end{bmatrix}$ and $s=\\begin{bmatrix}-6 \\\\ 3 \\\\ 7 \\\\ -8 \\\\ 0\\end{bmatrix}.$ Find $2r+s.$" :question/worked-solution "First, we multiply each component of $r$ by $2.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}2r+s & =2\\cdot \\begin{bmatrix}6 \\\\ 5 \\\\ 0 \\\\ 6 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}-6 \\\\ 3 \\\\ 7 \\\\ -8 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 \\\\ 10 \\\\ 0 \\\\ 12 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}-6 \\\\ 3 \\\\ 7 \\\\ -8 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}12+(-6) \\\\ 10+3 \\\\ 0+7 \\\\ 12+(-8) \\\\ 4+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ 13 \\\\ 7 \\\\ 4 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2798b1e5-76e0-5993-9799-5d8774a0490c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ -3 \\\\ -3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186411208} {:answer/id #uuid "62365ebd-bf36-50d9-addb-bc4183a3f7a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 5 \\\\ -6 \\\\ -4 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186411223} {:answer/id #uuid "773eb848-e322-5d49-aa31-c016b70c1726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ \\frac{5}{3} \\\\ -2 \\\\ -\\frac{4}{3} \\\\ \\frac{8}{3}\\end{bmatrix}" :db/id #edb/ref 17592186411227} {:answer/id #uuid "8a79d48a-e64c-5d1f-b7d5-c3d255a676f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ -3 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186411231} {:answer/id #uuid "d3ec6a63-9b34-5367-b998-3c2561dbd9ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{2} \\\\ \\frac{5}{2} \\\\ -3 \\\\ -2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186411245}] :answer-field/correct {:db/id #edb/ref 17592186411231} :answer-field/id #uuid "cc63c5a8-5dde-5704-b774-d0e8ea8db1c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411261}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fbe6a49-60d8-5901-b7da-6252cc956f06" :question/math-academy-id "q-73932" :question/problem "Let $p=\\begin{bmatrix}0 \\\\ 8 \\\\ -6 \\\\ 2 \\\\ 2\\end{bmatrix}$ and $q=\\begin{bmatrix}-9 \\\\ 3 \\\\ 0 \\\\ 6 \\\\ -6\\end{bmatrix}.$ Find $\\frac{1}{2}p-\\frac{1}{3}q.$" :question/worked-solution "First, we multiply each component of $p$ by $\\frac{1}{2}$ and each component of $q$ by $\\frac{1}{3}.$ Then, we substract the vectors:\n\n$$\n\\begin{aligned}\\frac{1}{2}p-\\frac{1}{3}q & =\\frac{1}{2}\\cdot \\begin{bmatrix}0 \\\\ 8 \\\\ -6 \\\\ 2 \\\\ 2\\end{bmatrix}-\\frac{1}{3}\\cdot \\begin{bmatrix}-9 \\\\ 3 \\\\ 0 \\\\ 6 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 4 \\\\ -3 \\\\ 1 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}-3 \\\\ 1 \\\\ 0 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0-(-3) \\\\ 4-1 \\\\ -3-0 \\\\ 1-2 \\\\ 1-(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 3 \\\\ -3 \\\\ -1 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eaa34a7-a085-545f-91fe-beae8d47c684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -3 \\\\ 11 \\\\ 12 \\\\ -10\\end{bmatrix}" :db/id #edb/ref 17592186411200} {:answer/id #uuid "1c62dcda-8b75-5d10-8e57-034327e30a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{12}{5} \\\\ -\\frac{1}{5} \\\\ \\frac{27}{5} \\\\ \\frac{4}{5} \\\\ \\frac{6}{5}\\end{bmatrix}" :db/id #edb/ref 17592186411206} {:answer/id #uuid "2b023d7b-06c4-5789-be1e-13fa7d88f7f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ -1 \\\\ 27 \\\\ 4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186411209} {:answer/id #uuid "4768353a-0b59-517a-b9a2-a228b1331554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-36 \\\\ -3 \\\\ 81 \\\\ 12 \\\\ 18\\end{bmatrix}" :db/id #edb/ref 17592186411213} {:answer/id #uuid "7dd58fb5-446f-5211-bab6-26628b3a5dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -1 \\\\ 7 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186411228}] :answer-field/correct {:db/id #edb/ref 17592186411200} :answer-field/id #uuid "b1216389-180c-5ccd-835a-3b9f64db68a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411260}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0aeb120-14da-52fd-96a2-d00ab74ac383" :question/math-academy-id "q-73935" :question/problem "Let $r=\\begin{bmatrix}3 \\\\ -1 \\\\ 2 \\\\ 4 \\\\ -4\\end{bmatrix}$ and $s=\\begin{bmatrix}-15 \\\\ 0 \\\\ 25 \\\\ 0 \\\\ 10\\end{bmatrix}.$ Find $3r+\\frac{1}{5}s.$" :question/worked-solution "First, we multiply each component of $r$ by $3$ and each component of $s$ by $\\frac{1}{5}.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}3r+\\frac{1}{5}s & =3\\cdot \\begin{bmatrix}3 \\\\ -1 \\\\ 2 \\\\ 4 \\\\ -4\\end{bmatrix}+\\frac{1}{5}\\cdot \\begin{bmatrix}-15 \\\\ 0 \\\\ 25 \\\\ 0 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 \\\\ -3 \\\\ 6 \\\\ 12 \\\\ -12\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 0 \\\\ 5 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}9-3 \\\\ -3+0 \\\\ 6+5 \\\\ 12+0 \\\\ -12+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -3 \\\\ 11 \\\\ 12 \\\\ -10\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd7953a-67be-5f09-a6a6-28814c9221b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 \\\\ 1 \\\\ 0 \\\\ 3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186411207} {:answer/id #uuid "4fbd4b42-a892-5d7a-886a-6030ee7067d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ \\frac{3}{2} \\\\ 0 \\\\ 2 \\\\ -\\frac{3}{2}\\end{bmatrix}" :db/id #edb/ref 17592186411216} {:answer/id #uuid "5d6150aa-c447-5b95-a570-979f75644021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ \\frac{2}{3} \\\\ 0 \\\\ 2 \\\\ -\\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186411222} {:answer/id #uuid "8d6cb8f0-2771-5c76-b518-445dbe40558e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 2 \\\\ 0 \\\\ 2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186411232} {:answer/id #uuid "aeb1ca12-b884-5faf-a48c-dcf72d25cb43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ \\frac{3}{2} \\\\ 0 \\\\ 3 \\\\ -\\frac{3}{2}\\end{bmatrix}" :db/id #edb/ref 17592186411236}] :answer-field/correct {:db/id #edb/ref 17592186411222} :answer-field/id #uuid "ce43afeb-783e-501c-a28a-b887bf1e3de8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f20a436e-0127-5928-a01b-2889e7a8ec0e" :question/math-academy-id "q-73926" :question/problem "Let $r=\\begin{bmatrix}-9 \\\\ 1 \\\\ 0 \\\\ 3 \\\\ -1\\end{bmatrix}.$ Find $\\frac{2}{3}r.$" :question/worked-solution "Multiplying each component of $r$ by $\\frac{2}{3},$ we get\n\n$$\n\\begin{aligned}\\frac{2}{3}r & =\\frac{2}{3}\\begin{bmatrix}-9 \\\\ 1 \\\\ 0 \\\\ 3 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{3}\\cdot (-9) \\\\ \\frac{2}{3}\\cdot 1 \\\\ \\frac{2}{3}\\cdot 0 \\\\ \\frac{2}{3}\\cdot 3 \\\\ \\frac{2}{3}\\cdot (-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ \\frac{2}{3} \\\\ 0 \\\\ 2 \\\\ -\\frac{2}{3}\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186417738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065f9865-0513-58da-9b22-d96229767c84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186417708} {:answer/id #uuid "2bc79277-ae90-5b10-b515-d4f65951b373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186417713} {:answer/id #uuid "2ecdee28-7a39-54e8-b845-add658821807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186417714} {:answer/id #uuid "ae95c44a-5b3c-5f86-ad5d-103a70a2b3df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186417728} {:answer/id #uuid "c6656c99-3f58-5764-82e3-b277dcfb1731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186417729}] :answer-field/correct {:db/id #edb/ref 17592186417729} :answer-field/id #uuid "035f7b17-da06-59f6-9265-6f52b45bcb1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3276f9dc-0fc5-5be4-8351-1b5347481225" :question/math-academy-id "q-34382" :question/problem "Consider the matrix $A=\\begin{bmatrix}3 & 1 & -2 \\\\ 4 & 2 & -6\\end{bmatrix}$ and the vector $b=\\begin{bmatrix}1 \\\\ k \\\\ -1\\end{bmatrix}.$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}3 & 1 & -2 \\\\ 4 & 2 & -6\\end{bmatrix}\\begin{bmatrix}1 \\\\ k \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}3+k+2 \\\\ 4+2k+6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}k+5 &=0 \\\\ 2k+10 &=0\\end{aligned}\\right.\n$$\n\nand for each of these equations, we obtain $k=-5.$"}] [{:db/id #edb/ref 17592186417739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b313932-8a2d-5efe-9590-f6798ae0a9bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186417709} {:answer/id #uuid "1839cd87-9807-5099-aa1b-8c59eca72147" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$ and ${b}_{3}$ only" :db/id #edb/ref 17592186417710} {:answer/id #uuid "4200484a-68ef-5a68-826c-3f22c3f6744b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$ only" :db/id #edb/ref 17592186417715} {:answer/id #uuid "43348635-a4e0-572f-b730-392f51070b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{1}$,  ${b}_{2}$, and ${b}_{3}$" :db/id #edb/ref 17592186417716} {:answer/id #uuid "aac34498-7b04-5d6d-ae12-08f353104028" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${b}_{3}$ only" :db/id #edb/ref 17592186417727}] :answer-field/correct {:db/id #edb/ref 17592186417709} :answer-field/id #uuid "e63daa46-8b3f-5be5-a899-eeb5be3faafc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "840cf185-0fde-50bc-83f8-78075677882d" :question/math-academy-id "q-74858" :question/problem "The matrix $A$ and vectors ${b}_{1}$, ${b}_{2}$, ${b}_{3}$ are given below. Which of the vectors lie in $\\text{Null}(A)?$\n\n$$\nA=\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix},\\,{b}_{1}=\\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}2 \\\\ 4 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "A vector $b$ lies in $\\text{Null}(A)$ if $Ab=0.$ So, we need to compute the product of $A$ and each of the given vectors and check whether it is equal to $0:$\n\n$$\n\\begin{aligned}A{b}_{1} & =\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 5 \\\\ 0\\end{bmatrix}\\ne 0\\,\\times  \\\\ A{b}_{2} & =\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix}\\ne 0\\,\\times  \\\\ A{b}_{3} & =\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 4 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}9 \\\\ 0 \\\\ 8\\end{bmatrix}\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, none of the vectors lies in $\\text{Null}(A).$"}] [{:db/id #edb/ref 17592186417740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dea2883-7aed-50ab-88db-338d6b05d1d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{bmatrix}4{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\right\\}" :db/id #edb/ref 17592186430953} {:answer/id #uuid "6d08ac3a-bf71-57e5-86bb-45513f396dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{bmatrix}6{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\right\\}" :db/id #edb/ref 17592186430958} {:answer/id #uuid "78246ec8-609c-551f-b0ac-0dadda339bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\right\\}" :db/id #edb/ref 17592186430960} {:answer/id #uuid "a3181278-1876-5206-9569-f7c580389091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\right\\}" :db/id #edb/ref 17592186430963} {:answer/id #uuid "bcdbf8dd-4179-511e-ac05-173b55d1fa27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{bmatrix}{x}_{1} \\\\ -{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\right\\}" :db/id #edb/ref 17592186430965}] :answer-field/correct {:db/id #edb/ref 17592186430960} :answer-field/id #uuid "59767641-5ff1-522d-98ff-ca8331e026ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417735}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87edb91a-a643-5fdb-a1df-2e5d059d6b9b" :question/math-academy-id "q-111154" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -2 \\\\ -3 & 6 \\\\ 4 & -8\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 \\\\ -3 & 6 \\\\ 4 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0 \\\\ 4 & -8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2} &=0 \\\\ 0 &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have one free variable, ${x}_{2}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}.$\n\nFrom the first equation we get ${x}_{1}=2{x}_{2},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\left\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186417741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4345a24b-01f2-51a9-a9a3-ec26cb12faf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186417717} {:answer/id #uuid "59f64036-7331-5cd3-843e-78a74738a9d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186417719} {:answer/id #uuid "754f9b55-2a4f-56a1-a443-6730aeb9dbd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186417721} {:answer/id #uuid "a602ff6b-6d7d-5c41-a3a4-a43d6175780c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186417725} {:answer/id #uuid "d5fab15a-6aaa-5d52-a720-35f24b947f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186417731}] :answer-field/correct {:db/id #edb/ref 17592186417721} :answer-field/id #uuid "2b31ab65-a8d2-52bf-9fe7-84343a8c24b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417734}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89126de9-6477-52ae-9bf6-a1ac2a8f4680" :question/math-academy-id "q-111103" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & -6 \\\\ -1 & 3 \\\\ 4 & -12\\end{bmatrix}$ and the vector $b=\\begin{bmatrix}k \\\\ 1\\end{bmatrix}.$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}2 & -6 \\\\ -1 & 3 \\\\ 4 & -12\\end{bmatrix}\\begin{bmatrix}k \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}2k-6 \\\\ -k+3 \\\\ 4k-12\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}2k-6 &=0 \\\\ -k+3 &=0 \\\\ 4k-12 &=0\\end{aligned}\\right.\n$$\n\nand for each of these equations, we obtain $k=3.$"}] [{:db/id #edb/ref 17592186417742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267cb3d1-2ef0-50d2-827b-ba6571c4e7a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186417711} {:answer/id #uuid "4c4607fe-b4f6-500f-b628-c9efb2f77b90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186417718} {:answer/id #uuid "63a9c9e9-789b-5e69-a3e9-b68cbdaf3c6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186417720} {:answer/id #uuid "cbb639f6-eb5e-5bc1-a3ee-ebf239dfc56d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{1} \\\\ {x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186417730} {:answer/id #uuid "e3dcbb04-64eb-5c82-a9e6-1019c7c418e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186417732}] :answer-field/correct {:db/id #edb/ref 17592186417711} :answer-field/id #uuid "9debef96-eaa3-515c-b307-163bd264f5ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417736}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f53050dc-6a1d-553b-afc7-7c5bd1dcb5bf" :question/math-academy-id "q-111165" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -3 \\\\ 1 & -2 \\\\ 2 & -4\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -3 \\\\ 1 & -2 \\\\ 2 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1 \\\\ 2 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1 \\\\ 0 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2} &=0 \\\\ {x}_{2} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}-3(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)={0}.$"}] [{:db/id #edb/ref 17592186419007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313cdc82-5d69-5af4-95bb-ace914a012ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplication of $f\\in A$ by a scalar is not closed" :db/id #edb/ref 17592186418996} {:answer/id #uuid "4f43eb35-6698-556b-937a-7540b2eaa194" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions in $A$  is not associative" :db/id #edb/ref 17592186418997} {:answer/id #uuid "54d7d70f-b06b-5dba-8920-ce4be2335648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions in $A$  is not commutative" :db/id #edb/ref 17592186418999} {:answer/id #uuid "61ff392f-4de3-5c34-9123-789573d772b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot f\\ne f$ for some $f\\in A$" :db/id #edb/ref 17592186419000} {:answer/id #uuid "f187a6fa-78fb-565f-9a52-c1915abb65f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition and scalar multiplication of functions  in $A$ do not satisfy the distributive laws" :db/id #edb/ref 17592186419005}] :answer-field/correct {:db/id #edb/ref 17592186418996} :answer-field/id #uuid "4628fceb-08d9-5ba5-86ad-00d444e18706" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419006}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a47334c-0a05-5b9c-b7eb-76cf4c1d5cfb" :question/math-academy-id "q-94792" :question/problem "Let $A$ be the set of all functions $f:R\\to R$ of the form  $f(x)=a+{x}^{2},$ where $a\\in R.$ Complete the following sentence:\n\n*$A$ is **not** a vector space (with respect to function addition and scalar multiplication) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$A$ is **not** a vector space (with respect to function addition and scalar multiplication) because **multiplication of $f\\in A$ by a scalar is not closed.*** \n\nFor example, if $\\alpha =2$ and $f(x)={x}^{2},$ then $\\alpha f(x)=2{x}^{2}.$ So, $\\alpha f(x)\\notin A$ because the coefficient of ${x}^{2}$ is not $1.$\n\nOn the other hand:\n\n- Addition of real valued functions  is associative. $\\,✓$\n\n- Addition and scalar multiplication of polynomials satisfy the distributive laws.\n$\\,✓$\n\n- Addition of real valued functions  is commutative. $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in A.$ $\\,✓$"}] [{:db/id #edb/ref 17592186423620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ef60749-f0a3-5b92-b7ac-687d57c40bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186423608} {:answer/id #uuid "842c1b53-7a3c-5c3c-95cd-f635e53b9e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186423609} {:answer/id #uuid "8f1ff8c3-beef-5403-bf54-dedcfd80e6c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186423610} {:answer/id #uuid "c1363c60-15a5-5bca-ae79-3b740d941738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186423613} {:answer/id #uuid "c62c345c-75b2-5956-a3af-45a35e4a85f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186423614}] :answer-field/correct {:db/id #edb/ref 17592186423610} :answer-field/id #uuid "8d734853-a228-557f-9012-a5d01ef1cf52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c2bc939-4b4c-5161-9351-90818be5a0a1" :question/math-academy-id "q-75070" :question/problem "Given the matrix \n$V=\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 4\\end{bmatrix}.$ Find a basis $B$ of $\\text{Col}(V).$" :question/worked-solution "In order to find a basis of $\\text{Col}(V),$ we reduce the matrix $V$ to row echelon form:\n\n$$\n\\begin{aligned}V & =\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 4\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${v}_{1}$ and ${v}_{2}.$ So, a basis of $\\text{Col}(V)$ is $\\{{v}_{1},{v}_{2}\\},$ that is to say, \n\n$$\nB=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186423621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35e3091b-8980-52e7-a1d9-a90be4aa96ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\{{f}_{1},{f}_{2},{f}_{3}\\}$ is not a basis of $\\text{Col}(F)$" :db/id #edb/ref 17592186423604} {:answer/id #uuid "3d86af19-6bb9-5da7-832b-79a566c84f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186423605} {:answer/id #uuid "67c52e20-2bf3-5d92-86ef-d45fa30e8513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186423606} {:answer/id #uuid "9f2e8bb6-fedc-5092-b791-68f16dc74270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186423611} {:answer/id #uuid "a9845672-a026-53af-b2ba-1e8d7af5f91b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186423612}] :answer-field/correct {:db/id #edb/ref 17592186423604} :answer-field/id #uuid "f7f4cbcc-1506-5396-b835-9d7d9a6a3ab8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423619}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "693e6ed3-909b-52a6-8fa3-e0e6ae013327" :question/math-academy-id "q-75982" :question/problem "The matrix $F$ is given below. Let ${f}_{1}$, ${f}_{2}$,  ${f}_{3}$ and ${f}_{4}$ be the respective columns of $F.$\nDetermine if $B=\\text{{}{f}_{1},{f}_{2},{f}_{3}\\text{}}$ is a basis of $\\text{Col}(F).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${f}_{4}={x}_{1}{f}_{1}+{x}_{2}{f}_{2}+{x}_{3}{f}_{3}.$ \n\n$$\nF=\\begin{bmatrix}-4 & -4 & -24 & -4 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $F$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}F & =\\begin{bmatrix}-4 & -4 & -24 & -4 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{bmatrix} & {R}_{1} & :=\\left(-\\frac{1}{4}\\right){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 6 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 6 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 5 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(F)$ is $\\{{f}_{1},{f}_{2}\\}.$ \n\nTherefore, we conclude that $B=\\{{f}_{1},{f}_{2},{f}_{3}\\}$ is not a basis of $\\text{Col}(F).$"}] [{:db/id #edb/ref 17592186423670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f2283d3-68c5-5fca-946c-408c6fb2b791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A2}$, $\\text{A3}$" :db/id #edb/ref 17592186423658} {:answer/id #uuid "506393e5-9110-55a4-ad28-86b41af5f7b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A1}$, $\\text{A2}$" :db/id #edb/ref 17592186423659} {:answer/id #uuid "94a3dcc7-829d-5b5b-838b-243af61af1c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A1}$, $\\text{A4}$" :db/id #edb/ref 17592186423661} {:answer/id #uuid "b61ef8ae-4ec6-5626-8687-752c08d8c0f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A2}$, $\\text{A4}$" :db/id #edb/ref 17592186423664} {:answer/id #uuid "f44ae4d3-7509-5333-9443-9a689afb980d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{A1}$, $\\text{A3}$" :db/id #edb/ref 17592186423666}] :answer-field/correct {:db/id #edb/ref 17592186423659} :answer-field/id #uuid "29e9d841-9401-5444-9a3a-2b082af4b7ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423669}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2d091317-3092-5633-8a6e-4652d2fd3389" :question/math-academy-id "q-106941" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:* \n\n*If $u$ and $v$ are vectors such that $x+u=x+v$ for some $x\\in V,$ then $u=v.$*\n\n*Proof:*\n\n$$\n\\begin{aligned}x+u & =x+v &  & [\\,\\text{given}\\,] \\\\ (x+u)+(-x) & =(x+v)+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (u+x)+(-x) & =(v+x)+(-x) &  & [\\,\\text{axiom __}\\,\\,] \\\\ u+(x+(-x)) & =v+(x+(-x)) &  & [\\,\\text{axiom __}\\,\\,] \\\\ u+0 & =v+0 &  & [\\,\\text{axiom A4}\\,] \\\\ u & =v &  & [\\,\\text{axiom A3}\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following:\n\n$$\n\\begin{aligned}x+u & =x+v &  & [\\,\\text{given}\\,] \\\\ (x+u)+(-x) & =(x+v)+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (u+x)+(-x) & =(v+x)+(-x) &  & [\\,\\text{axiom }\\text{A1}\\,] \\\\ u+(x+(-x)) & =v+(x+(-x)) &  & [\\,\\text{axiom }\\text{A2}\\,] \\\\ u+0 & =v+0 &  & [\\,\\text{axiom A4}\\,] \\\\ u & =v &  & [\\,\\text{axiom A3}\\,]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c610fab-a6ec-5612-9143-78410e0c0685" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of matrices in $T$ is not associative" :db/id #edb/ref 17592186423660} {:answer/id #uuid "952805ec-db79-5003-ab44-c608da27648b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "there exists a matrix $A\\in T$ such that $A+B\\ne O$ for any $B\\in T.$" :db/id #edb/ref 17592186423662} {:answer/id #uuid "97a1f3dc-dc3c-53f9-b457-30bca1c9f80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ does not contain the zero matrix $O$" :db/id #edb/ref 17592186423663} {:answer/id #uuid "d008fb5f-392d-5a1e-8353-f48e8e0933c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of matrices in $T$ is not commutative" :db/id #edb/ref 17592186423665} {:answer/id #uuid "f89006ab-36a7-5769-850c-8ee5d58a71d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplication by a scalar is not closed" :db/id #edb/ref 17592186423667}] :answer-field/correct {:db/id #edb/ref 17592186423667} :answer-field/id #uuid "047ee837-df71-5e5c-bcee-335a715a816d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423668}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87c89c45-3edb-5cd5-88f1-a3ee2b4d8003" :question/math-academy-id "q-35640" :question/problem "Let $T$ be the set of all $2\\times 2$ matrices $({a}_{ij})$  with real entries, such that  ${a}_{11}+{a}_{22}$ is rational.  Complete the following sentence:\n\n*$T$ is **not** a vector space (with respect to addition of matrices and multiplication of matrices by a real number) because $\\text{____}\\,.$*" :question/worked-solution "The correct answer is \n\n*$T$ is **not** a vector space (with respect to addition of matrices and multiplication of matrices by a real number) because **multiplication by a scalar is not closed.*** \n\n For example, the identity matrix \n\n$$\nI=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\nlies in $T$, but\n\n$$\n\\sqrt{2}\\cdot I=\\begin{bmatrix}\\sqrt{2} & 0 \\\\ 0 & \\sqrt{2}\\end{bmatrix}\\notin T\n$$\n\nbecause $\\sqrt{2}+\\sqrt{2}$ is not a rational number.\n\nOn the other hand,\n\n- The zero matrix belongs to $T.$  $\\,✓$\n\n- Addition of matrices with real entries is commutative, in general.    $\\,✓$\n\n- Addition of matrices with real entries is associative, in general.    $\\,✓$\n\n- Given any $A\\in T,$  the additive inverse matrix $-A=(-1)\\cdot A$ is also in  $T,$ and   $A+(-A)=O.$  $\\,✓$"}] [{:db/id #edb/ref 17592186425404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b39024-8f98-5edf-93f7-04a64ee7b6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186425380} {:answer/id #uuid "48411ad1-c867-5f45-b8c7-ce3589fd2218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186425384} {:answer/id #uuid "69951a24-a52b-5841-8392-9e70e2c63d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186425388} {:answer/id #uuid "7ac52ed7-ea31-518a-95fb-dc6ea725ad9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186425390} {:answer/id #uuid "d56c921a-e74a-5b91-bee7-d13092469fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186425397}] :answer-field/correct {:db/id #edb/ref 17592186425384} :answer-field/id #uuid "2c9771c3-f30b-56b9-83e9-dd0e274a3d9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425400}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83850766-9b1b-5a37-bf38-12d47d12c4d5" :question/math-academy-id "q-35347" :question/problem "Given $$\n\\displaystyle G=\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ -2 & 3 & -6 & 4 \\\\ 0 & -2 & 5 & 1 \\\\ -6 & -15 & -12 & -16\\end{bmatrix},\\,\n$$ what is $\\text{dim}(\\text{Null}(G))?$" :question/worked-solution "To find $\\text{dim}(\\text{Null}(G))$, we reduce $G$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}G & =\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ -2 & 3 & -6 & 4 \\\\ 0 & -2 & 5 & 1 \\\\ -6 & -15 & -12 & -16\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ 0 & 8 & -2 & 7 \\\\ 0 & -2 & 5 & 1 \\\\ -6 & -15 & -12 & -16\\end{bmatrix} & {R}_{4} & :={R}_{4}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ 0 & 8 & -2 & 7 \\\\ 0 & -2 & 5 & 1 \\\\ 0 & 0 & 0 & -7\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{4}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ 0 & 8 & -2 & 7 \\\\ 0 & 0 & \\frac{9}{2} & \\frac{11}{4} \\\\ 0 & 0 & 0 & -7\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $4$ pivot columns and no non-pivot columns. \n\nTherefore,\n\n$$\n\\text{dim}(\\text{Null}(G))=0.\n$$"}] [{:db/id #edb/ref 17592186425405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3658fbf4-7125-51a3-8c67-6dac5efe7ee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186425383} {:answer/id #uuid "51f6e2e6-dc2b-5315-9b73-948670576a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186425385} {:answer/id #uuid "6da18174-0469-5de1-85a3-4a634932a54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186425389} {:answer/id #uuid "ce1d5e0a-36bb-506c-8445-a60981eb2cf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186425395} {:answer/id #uuid "ef53b2d3-1206-58e8-a659-33784ef08b53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186425398}] :answer-field/correct {:db/id #edb/ref 17592186425383} :answer-field/id #uuid "f829e1c6-fc4a-5157-b1d9-91868b24b67e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85da25d6-54a2-55b2-b4ae-23095c708e42" :question/math-academy-id "q-79338" :question/problem "If $B$ is a $4\\times 6$ matrix that has $4$ **non-pivot** columns, then $\\text{dim(Null}(B))=$" :question/worked-solution "We know that $\\text{dim(Null}(B))$ is the number of non-pivot columns in $B.$\n\nSince we are told that $B$ has $4$ non-pivot columns, we have \n\n$$\n\\text{dim(Null}(B))=4.\n$$"}] [{:db/id #edb/ref 17592186425406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b7137d1-196e-5467-891f-8a544f21aeba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186425381} {:answer/id #uuid "53593f8a-84e1-5e46-9090-20482d8e60a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186425386} {:answer/id #uuid "942dbaf5-ecc1-59dd-96cd-09e8f4c50159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186425392} {:answer/id #uuid "d1b97ca4-654d-53cf-b7f4-3b50efd771a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186425396} {:answer/id #uuid "f87f31f4-b42f-5af1-a0e6-59a42452095b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186425399}] :answer-field/correct {:db/id #edb/ref 17592186425386} :answer-field/id #uuid "72b3a9a3-a8e1-52c0-99d6-ec57e4d43b0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425401}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b000b980-8b9a-5a4e-a59b-6de7017a3b28" :question/math-academy-id "q-34901" :question/problem "If $A$ is a $7\\times 11$ matrix that has $7$ **non-pivot** columns, then $\\text{dim(Null}(A))=$" :question/worked-solution "We know that $\\text{dim(Null}(A))$ is the number of non-pivot columns in $A.$\n\nSince we are told that $A$ has $7$ non-pivot columns, we have \n\n$$\n\\text{dim(Null}(A))=7.\n$$"}] [{:db/id #edb/ref 17592186425407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d9c3ae-c60e-5f23-8b09-bd6f72672565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186425382} {:answer/id #uuid "62c579bb-353a-5222-8c49-b704acbe87e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186425387} {:answer/id #uuid "8d34d79c-138f-5ab3-9fb5-c6f333384a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186425391} {:answer/id #uuid "b08e9ade-c6e5-5b60-ac34-32e78a9a1641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186425393} {:answer/id #uuid "bca9b8c9-b194-53fd-be09-17e6ac4e9236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186425394}] :answer-field/correct {:db/id #edb/ref 17592186425382} :answer-field/id #uuid "f7861d69-8891-56f9-b3bb-6cd69873e91d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd86946f-a577-5d18-8f57-7b7435272376" :question/math-academy-id "q-35200" :question/problem "Consider the matrices given below. Find $\\,\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=\\begin{bmatrix}2 & 5 \\\\ 0 & -4\\end{bmatrix},\\,B=\\begin{bmatrix}-1 & 0 & 5 \\\\ 0 & 8 & 3 \\\\ 0 & 0 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}2 & 7 & -3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $2$ pivot columns and no non-pivot column. So, \n\n$$\n\\text{dim(Null}(A))=0.\n$$\n\n- The matrix $B$ has $2$ pivot columns and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- The matrix $C$ has $1$ pivot column and $2$ non-pivot columns (namely, the $2$nd and $3$rd columns). So, \n\n$$\n\\text{dim(Null}(C))=2.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=0+1+2=3.\n$$"}] [{:db/id #edb/ref 17592186426072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d5ed8d-7e60-5db5-b7d1-d96bb65185a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474362} {:answer/id #uuid "10b14067-3f7f-5868-8791-43396e0607b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474363}] :answer-field/correct {:db/id #edb/ref 17592186474363} :answer-field/id #uuid "bb207fd4-1ade-5c72-8528-ba143a738870" :answer-field/key "$A$ has no inverse" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475107} {:answer-field/choices [{:answer/id #uuid "0948d764-f192-5b49-80f0-17ce4b9bcefb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474364} {:answer/id #uuid "f2aade65-5d3a-520b-86ea-745a85070e15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474365}] :answer-field/correct {:db/id #edb/ref 17592186474364} :answer-field/id #uuid "e4b6ddd3-8ce7-5c7f-874e-23d5563021dc" :answer-field/key "$\\text{Null}(A)$ has dimension zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475108} {:answer-field/choices [{:answer/id #uuid "23dc218b-818c-594c-978b-8b69736909ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474366} {:answer/id #uuid "4999264b-817a-578e-85f5-209e47509eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474367}] :answer-field/correct {:db/id #edb/ref 17592186474367} :answer-field/id #uuid "25ecf0bb-4395-5d51-99bd-1c0a67d30176" :answer-field/key "$A$ has less than $5$ pivot columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475109}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "251cfe7e-474d-59b2-8ccf-101401daf068" :question/math-academy-id "q-139978" :question/problem "Consider the following sentence:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $$\n\\displaystyle \\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{5} \\\\ \\text{dim(Col}(A)) &=5=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$ \n\nIndeed, since $det(A)=0,$ the matrix $A$ can't be invertible.\n\n- The following statement is false:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{Null}(A)$ has dimension zero.* $\\,\\times$\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn,  means that $\\text{Null}(A)$ must have a basis so the dimension must be greater than zero.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has less than $5$ pivot columns.* $\\,✓$\n\nIndeed, since $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))\\ne 5,$ which means that $A$ has less than $5$ pivot columns.\n\nTherefore, the correct answer is “$A$ has no inverse”; “$A$ has less than $5$ pivot columns” only."}] [{:db/id #edb/ref 17592186426073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c95950f-0823-5370-bdc6-01bb92a952d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186426033} {:answer/id #uuid "273e0c96-01c0-59a1-9a8a-bbc504aefdcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186426040} {:answer/id #uuid "6b00939c-668f-5ef6-a841-a3a747721c0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1\\}" :db/id #edb/ref 17592186426051} {:answer/id #uuid "8f359088-8e4f-5c73-9327-b8f57f81b67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186426056} {:answer/id #uuid "932d7cf7-e61c-56ad-ad09-463fb4d48e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186426057}] :answer-field/correct {:db/id #edb/ref 17592186426057} :answer-field/id #uuid "ca86128d-009c-5e25-9a78-0a5e2db13bd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426069}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33a20d40-e8ca-5cc3-bf01-9f700d36b547" :question/math-academy-id "q-141191" :question/problem "$$\nA\\text{ is invertible}\\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{n} \\\\ \\text{dim(Col}(A)) &=n=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=\\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{W}}=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nConsider the equivalence above, where $A$ is an $n\\,\\times \\,n$ matrix. Which of the following should be placed into the blank space to make a true statement?" :question/worked-solution "Recall that the *invertible matrix theorem* states the following: \n\n*Let $A$ be an $n\\,\\times \\,n$ matrix. Then we have the following equivalence:*\n\n$$\nA\\text{ is invertible}\\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{n} \\\\ \\text{dim(Col}(A)) &=n=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nTherefore, the missing expression is $0.$"}] [{:db/id #edb/ref 17592186426074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b25edc-b99e-5683-bc78-86b9980302d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186426049} {:answer/id #uuid "689ca3d8-8583-5b72-bea0-6f1b9b6117f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{I}_{n\\times n}" :db/id #edb/ref 1759