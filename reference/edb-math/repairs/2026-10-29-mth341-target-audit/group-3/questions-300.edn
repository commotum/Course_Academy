imes\\mathbf b=2\\mathbf j+4\\mathbf k\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042ac55c-b614-532c-a37a-87463d65c781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\mathbf i+4\\mathbf j" :db/id #edb/ref 17592186711697} {:answer/id #uuid "0d4a32c3-1cd6-51f2-ba90-b89d7b2bc0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\mathbf i+18\\mathbf j" :db/id #edb/ref 17592186711699} {:answer/id #uuid "a725d792-1426-5b0f-a7ad-c73c29e4c480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\mathbf i-2\\mathbf j" :db/id #edb/ref 17592186711704} {:answer/id #uuid "b252556c-7971-534f-9a10-6703613c1e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10\\mathbf i+10\\mathbf j" :db/id #edb/ref 17592186711705} {:answer/id #uuid "c2eb8027-1861-5a3a-9403-0a8b30c1760b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\mathbf i-14\\mathbf j" :db/id #edb/ref 17592186711707}] :answer-field/correct {:db/id #edb/ref 17592186711705} :answer-field/id #uuid "d8e5d30a-7ac4-55f9-9120-355f9b750463" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711709}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "042d1d19-c42d-5e14-acc4-ec911c6539b1" :question/problem "Find $(-3\\mathbf b-2\\mathbf a)\\times(-2\\mathbf c-2\\mathbf a)$, given:\n\n$\\mathbf c\\times\\mathbf a=\\mathbf i-\\mathbf j$.\n\n$\\mathbf a\\times\\mathbf b=-\\mathbf i+\\mathbf j$.\n\n$\\mathbf c\\times\\mathbf b=2\\mathbf i-2\\mathbf j$." :question/worked-solution "Distribute without changing the order of the vector factors, and extract the scalars.\n\n$$\n\\begin{aligned}\n(-3\\mathbf b-2\\mathbf a)\\times(-2\\mathbf c-2\\mathbf a)\\\\&=6(\\mathbf b\\times\\mathbf c)+6(\\mathbf b\\times\\mathbf a)\\\\&\\quad{}+4(\\mathbf a\\times\\mathbf c)+4(\\mathbf a\\times\\mathbf a)\n\\end{aligned}\n$$\n\nUse $\\mathbf b\\times\\mathbf c=-(\\mathbf c\\times\\mathbf b)$, $\\mathbf b\\times\\mathbf a=-(\\mathbf a\\times\\mathbf b)$, $\\mathbf a\\times\\mathbf c=-(\\mathbf c\\times\\mathbf a)$, $\\mathbf a\\times\\mathbf a=\\mathbf0$. The self product vanishes; each reversed pair changes sign.\n\n$$\n\\begin{aligned}\n&-6(\\mathbf c\\times\\mathbf b)-6(\\mathbf a\\times\\mathbf b)-4(\\mathbf c\\times\\mathbf a)\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&-6\\bigl(2\\mathbf i-2\\mathbf j\\bigr)=-12\\mathbf i+12\\mathbf j\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&-6\\bigl(-\\mathbf i+\\mathbf j\\bigr)=6\\mathbf i-6\\mathbf j\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&-4\\bigl(\\mathbf i-\\mathbf j\\bigr)=-4\\mathbf i+4\\mathbf j\n\\end{aligned}\n$$\n\nCollect the three components:\n\n$$\n\\begin{aligned}\n&(-12)+(6)+(-4)=-10\\\\&(12)+(-6)+(4)=10\\\\&(0)+(0)+(0)=0\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&(-3\\mathbf b-2\\mathbf a)\\times(-2\\mathbf c-2\\mathbf a)=-10\\mathbf i+10\\mathbf j\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197f34fc-a676-58d5-94ac-11759a439300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,-12,-6\\rangle" :db/id #edb/ref 17592186711700} {:answer/id #uuid "69b5f05c-d76c-5155-930a-34901faf1e23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,12,6\\rangle" :db/id #edb/ref 17592186711701} {:answer/id #uuid "6cf72561-d47a-55d4-883f-0d52782846c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle0,-6,-12\\rangle" :db/id #edb/ref 17592186711702} {:answer/id #uuid "7c9b37e9-df68-52ce-97dd-1d9f322015ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,-6,-12\\rangle" :db/id #edb/ref 17592186711703} {:answer/id #uuid "b8f2b2df-9498-52de-888e-13d8761eafac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,-9,-9\\rangle" :db/id #edb/ref 17592186711706}] :answer-field/correct {:db/id #edb/ref 17592186711703} :answer-field/id #uuid "f3501fe7-27ba-505e-ac12-837a7464985c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711710}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d102aad5-ca86-5e66-b33b-b8bb3885590b" :question/problem "Find $(3\\mathbf c+\\mathbf b)\\times(-\\mathbf b+3\\mathbf a)$, given:\n\n$\\mathbf b\\times\\mathbf c=\\langle-2,0,0\\rangle$.\n\n$\\mathbf a\\times\\mathbf c=\\langle0,1,1\\rangle$.\n\n$\\mathbf a\\times\\mathbf b=\\langle0,-1,1\\rangle$." :question/worked-solution "Distribute without changing the order of the vector factors, and extract the scalars.\n\n$$\n\\begin{aligned}\n(3\\mathbf c+\\mathbf b)\\times(-\\mathbf b+3\\mathbf a)\\\\&=-3(\\mathbf c\\times\\mathbf b)+9(\\mathbf c\\times\\mathbf a)\\\\&\\quad{}-(\\mathbf b\\times\\mathbf b)+3(\\mathbf b\\times\\mathbf a)\n\\end{aligned}\n$$\n\nUse $\\mathbf c\\times\\mathbf b=-(\\mathbf b\\times\\mathbf c)$, $\\mathbf c\\times\\mathbf a=-(\\mathbf a\\times\\mathbf c)$, $\\mathbf b\\times\\mathbf b=\\mathbf0$, $\\mathbf b\\times\\mathbf a=-(\\mathbf a\\times\\mathbf b)$. The self product vanishes; each reversed pair changes sign.\n\n$$\n\\begin{aligned}\n&3(\\mathbf b\\times\\mathbf c)-9(\\mathbf a\\times\\mathbf c)-3(\\mathbf a\\times\\mathbf b)\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&3\\bigl(\\langle-2,0,0\\rangle\\bigr)=\\langle-6,0,0\\rangle\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&-9\\bigl(\\langle0,1,1\\rangle\\bigr)=\\langle0,-9,-9\\rangle\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&-3\\bigl(\\langle0,-1,1\\rangle\\bigr)=\\langle0,3,-3\\rangle\n\\end{aligned}\n$$\n\nCollect the three components:\n\n$$\n\\begin{aligned}\n&(-6)+(0)+(0)=-6\\\\&(0)+(-9)+(3)=-6\\\\&(0)+(-9)+(-3)=-12\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&(3\\mathbf c+\\mathbf b)\\times(-\\mathbf b+3\\mathbf a)=\\langle-6,-6,-12\\rangle\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530be0b3-5b38-5a39-be5a-4883b39ee4aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186711737}] :answer-field/correct {:db/id #edb/ref 17592186711737} :answer-field/id #uuid "289be0af-9c2c-5d41-bd0e-2be58b00b949" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711732} {:answer-field/choices [{:answer/id #uuid "4272b5c1-c504-5737-b536-130d09ad54ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186711733}] :answer-field/correct {:db/id #edb/ref 17592186711733} :answer-field/id #uuid "43171dc3-73f6-5e63-9843-b0cb3898d121" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711734} {:answer-field/choices [{:answer/id #uuid "d97e6c31-98c7-552f-907d-6157a5e660a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186711742}] :answer-field/correct {:db/id #edb/ref 17592186711742} :answer-field/id #uuid "4c687c64-f3f1-5a59-8f25-a8a752a18884" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711736}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dea880