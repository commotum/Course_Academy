\\mathbf k\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c00c04c-eafd-5870-9194-8573f4db144b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\mathbf i+9\\mathbf j+6\\mathbf k" :db/id #edb/ref 17592186711663} {:answer/id #uuid "4964476b-b00d-5338-8c16-68f3c3cd3a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\mathbf i+3\\mathbf j+2\\mathbf k" :db/id #edb/ref 17592186711674} {:answer/id #uuid "9d58dac1-be41-5f5f-9151-458c6aa09e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbf i-3\\mathbf j-2\\mathbf k" :db/id #edb/ref 17592186711679} {:answer/id #uuid "bbc48e87-bc9c-5446-9faf-30c9c38349ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\mathbf i+6\\mathbf j+4\\mathbf k" :db/id #edb/ref 17592186711683} {:answer/id #uuid "d8e0c41f-98dc-52c5-8db9-be84f787377b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\mathbf i-9\\mathbf j-6\\mathbf k" :db/id #edb/ref 17592186711687}] :answer-field/correct {:db/id #edb/ref 17592186711663} :answer-field/id #uuid "ab1d6f25-bca4-5b97-9d57-96b74aed4883" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31739287-ab65-5257-9135-7e91e97281c8" :question/problem "Find $\\mathbf b\\times(3\\mathbf a+\\mathbf b)$, given:\n\n$\\mathbf a\\times\\mathbf b=\\mathbf i-3\\mathbf j-2\\mathbf k$." :question/worked-solution "Distribute without changing the order of the vector factors, and extract the scalars.\n\n$$\n\\begin{aligned}\n\\mathbf b\\times(3\\mathbf a+\\mathbf b)\\\\&=3(\\mathbf b\\times\\mathbf a)+(\\mathbf b\\times\\mathbf b)\n\\end{aligned}\n$$\n\nUse $\\mathbf b\\times\\mathbf a=-(\\mathbf a\\times\\mathbf b)$, $\\mathbf b\\times\\mathbf b=\\mathbf0$. The self product vanishes; each reversed pair changes sign.\n\n$$\n\\begin{aligned}\n&-3(\\mathbf a\\times\\mathbf b)\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n&-3\\bigl(\\mathbf i-3\\mathbf j-2\\mathbf k\\bigr)=-3\\mathbf i+9\\mathbf j+6\\mathbf k\n\\end{aligned}\n$$\n\nCollect the three components:\n\n$$\n\\begin{aligned}\n&\\mathbf b\\times(3\\mathbf a+\\mathbf b)=-3\\mathbf i+9\\mathbf j+6\\mathbf k\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1748300f-bbbe-5528-9869-5cfa01e4bc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,-9,-3\\rangle" :db/id #edb/ref 17592186711664} {:answer/id #uuid "257c9da8-1bc8-5bbf-b87d-eefc27e2e668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-2,-3,-1\\rangle" :db/id #edb/ref 17592186711667} {:answer/id #uuid "70f832c8-1a13-51bd-b1ea-5cc4095f7fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle2,3,1\\rangle" :db/id #edb/ref 17592186711677} {:answer/id #uuid "dcf11c86-5f8d-5cfa-9250-68e5e1b0b7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-4,-6,-2\\rangle" :db/id #edb/ref 17592186711688} {:answer/id #uuid "df3e1aad-99d8-57c6-859f-258a454ff28d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle6,9,3\\rangle" :db/id #edb/ref 17592186711690}] :answer-field/correct {:db/id #edb/ref 17592186711664} :answer-field/id #uuid "414c977a-3cc6-58a8-8e41-fa5a95d7bc0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711673}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.