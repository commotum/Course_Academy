#{[{:db/id #edb/ref 17592186711117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66fbf2a6-f531-5df3-b2ca-b396e30d0de5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\mathbf i-4\\mathbf j" :db/id #edb/ref 17592186711108} {:answer/id #uuid "7050ce87-b1cc-56f4-af02-936f68154de7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\mathbf i+4\\mathbf j" :db/id #edb/ref 17592186711109} {:answer/id #uuid "aa245962-b662-5802-8164-a051f6da5f60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\mathbf i" :db/id #edb/ref 17592186711111} {:answer/id #uuid "d47668da-5a5e-51fc-a450-1be3ab6ae56b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\mathbf i+6\\mathbf j" :db/id #edb/ref 17592186711118} {:answer/id #uuid "f319bd9e-c01c-5747-9f90-00d93b4d0934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbf i+3\\mathbf j" :db/id #edb/ref 17592186711120}] :answer-field/correct {:db/id #edb/ref 17592186711109} :answer-field/id #uuid "1f893f26-052c-5289-b4b7-3883bde19823" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711105}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4525e65-242b-5b41-baf9-63cf6511ce20" :question/problem "Find $(2\\mathbf a+\\mathbf b)\\times\\mathbf c$, given $\\mathbf a\\times\\mathbf c=2\\mathbf i+\\mathbf j$ and $\\mathbf b\\times\\mathbf c=-\\mathbf i+2\\mathbf j$." :question/worked-solution "Distribute across the sum without changing the order of either cross product:\n\n$$\n(2\\mathbf a+\\mathbf b)\\times\\mathbf c=(2\\mathbf a)\\times\\mathbf c+\\mathbf b\\times\\mathbf c.\n$$\n\nExtract the scalar, substitute the given products, and combine like components:\n\n$$\n\\begin{aligned}\n2(\\mathbf a\\times\\mathbf c)+\\mathbf b\\times\\mathbf c\n&=2(2\\mathbf i+\\mathbf j)+(-\\mathbf i+2\\mathbf j)\\\\\n&=4\\mathbf i+2\\mathbf j-\\mathbf i+2\\mathbf j\\\\\n&=3\\mathbf i+4\\mathbf j.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8bc2fef-003f-5bdb-abc9-e1eca951c5ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186711119}] :answer-field/correct {:db/id #edb/ref 17592186711119} :answer-field/id #uuid "3b64d465-5aec-547e-bdc0-ddc02a3d1a4d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711106} {:answer-field/choices [{:answer/id #uuid "c379c360-4cdb-5e00-a2d2-fbca4be2239e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186711114}] :answer-field/correct {:db/id #edb/ref 17592186711114} :answer-field/id #uuid "c994e3c6-d145-5cab-b0c4-da77a489271a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f371d14b-8e3d-511c-bad0-0c7eef2c31d9" :question/problem "Let $\\mathbf c\\times\\mathbf a=\\mathbf i-2\\mathbf j$ and $\\mathbf c\\times\\mathbf b=3\\mathbf i+\\mathbf j$. Find $(-2\\mathbf c)\\times(\\mathbf a-2\\mathbf b)$.\n\n$(-2\\mathbf c)\\times(\\mathbf a-2\\mathbf b)=$ {{field-1}} $\\mathbf i+$ {{field-2}} $\\mathbf j$" :question/worked-solution "Distribute across the difference, keeping $\\mathbf c$ on the left:\n\n$$\n(-2\\mathbf c)\\times(\\mathbf a-2\\mathbf b)=(-2\\mathbf c)\\times\\mathbf a-(-2\\mathbf c)\\times(2\\mathbf b).\n$$\n\nExtract the scalars from both factors. The second coefficient is positive because $-((-2)\\cdot2)=4$:\n\n$$\n\\begin{aligned}\n(-2\\mathbf c)\\times(\\mathbf a-2\\mathbf b)\n&=-2(\\mathbf c\\times\\mathbf a)+4(\\mathbf c\\times\\mathbf b)\\\\\n&=-2(\\mathbf i-2\\mathbf j)+4(3\\mathbf i+\\mathbf j)\\\\\n&=-2\\mathbf i+4\\mathbf j+12\\mathbf i+4\\mathbf j\\\\\n&=10\\mathbf i+8\\mathbf j.\n\\end{aligned}\n$$\n\nThe coefficients to enter are $10$ and $8$."}] [{:db/id #edb/ref 17592186711233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7149bb32-9a3f-5349-86a9-8f4204cbc0ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186711238}] :answer-field/correct {:db/id #edb/ref 17592186711238} :answer-field/id #uuid "17dd2d85-8491-5ea9-872d-2b8b7128b3e2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711229} {:answer-field/choices [{:answer/id #uuid "79751cdb-96e6-57de-ace0-b596c41bb139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186711239}] :answer-field/correct {:db/id #edb/ref 17592186711239} :answer-field/id #uuid "d91bf741-82e9-5dd6-b6ff-8f901993273b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711243} {:answer-field/choices [{:answer/id #uuid "ebeee001-b7ce-5992-8317-7ee57e160592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186711246}] :answer-field/correct {:db/id #edb/ref 17592186711246} :answer-field/id #uuid "f06eef8c-224f-567b-8acd-d80abed70cf8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711247}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e7bd054-2afa-590a-ae69-62f026ce51bf" :question/problem "Let $\\mathbf a\\times\\mathbf b=\\langle1,-2,3\\rangle$. Find $3\\mathbf b\\times(2\\mathbf a-\\mathbf b)$.\n\n$3\\mathbf b\\times(2\\mathbf a-\\mathbf b)=\\langle${{field-1}}$,$ {{field-2}}$,$ {{field-3}}$\\rangle$" :question/worked-solution "Distribute first and factor out both scalar factors:\n\n$$\n\\begin{aligned}\n3\\mathbf b\\times(2\\mathbf a-\\mathbf b)\n&=(3\\mathbf b)\\times(2\\mathbf a)-(3\\mathbf b)\\times\\mathbf b\\\\\n&=6(\\mathbf b\\times\\mathbf a)-3(\\mathbf b\\times\\mathbf b).\n\\end{aligned}\n$$\n\nNow use $\\mathbf b\\times\\mathbf b=\\mathbf0$ and $\\mathbf b\\times\\mathbf a=-\\mathbf a\\times\\mathbf b$:\n\n$$\n\\begin{aligned}\n6(\\mathbf b\\times\\mathbf a)-3(\\mathbf b\\times\\mathbf b)\n&=-6(\\mathbf a\\times\\mathbf b)-3\\mathbf0\\\\\n&=-6\\langle1,-2,3\\rangle\\\\\n&=\\langle-6,12,-18\\rangle.\n\\end{aligned}\n$$\n\nThe three entries, in order, are $-6$, $12$, and $-18$."}] [{:db/id #edb/ref 17592186711240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ee6c73-30e1-5b8b-820f-a02ce6460951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle6,-3,9\\rangle" :db/id #edb/ref 17592186711227} {:answer/id #uuid "0cd237dd-76fc-558e-a1cd-a39f0298ea7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,-3,-9\\rangle" :db/id #edb/ref 17592186711228} {:answer/id #uuid "34d6eb7a-3ce2-5155-9c71-5b1a6e8295c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-2,1,-3\\rangle" :db/id #edb/ref 17592186711232} {:answer/id #uuid "4f28879c-70bc-5f5f-9fe2-4c17d4279b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-4,2,-6\\rangle" :db/id #edb/ref 17592186711234} {:answer/id #uuid "e28ceeaa-a06a-5613-8adb-f7f735a55c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle-6,3,-9\\rangle" :db/id #edb/ref 17592186711244}] :answer-field/correct {:db/id #edb/ref 17592186711244} :answer-field/id #uuid "a6185a7f-d385-5d7b-8fb7-58a94b580c24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711241}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9be7251b-1a26-58dc-a22f-77e84d53bd21" :question/problem "Find $(3\\mathbf a-2\\mathbf b)\\times\\mathbf b$, if $\\mathbf b\\times\\mathbf a=\\langle2,-1,3\\rangle$." :question/worked-solution "Distribute the cross product, keeping the factors in their original order, and factor out the scalars:\n\n$$\n\\begin{aligned}\n(3\\mathbf a-2\\mathbf b)\\times\\mathbf b\n&=3(\\mathbf a\\times\\mathbf b)-2(\\mathbf b\\times\\mathbf b).\n\\end{aligned}\n$$\n\nA vector crossed with itself is the zero vector. Reversing the order of a cross product changes its sign, so $\\mathbf a\\times\\mathbf b=-\\mathbf b\\times\\mathbf a$. Hence\n\n$$\n\\begin{aligned}\n3(\\mathbf a\\times\\mathbf b)-2(\\mathbf b\\times\\mathbf b)\n&=-3(\\mathbf b\\times\\mathbf a)-2\\mathbf0\\\\\n&=-3\\langle2,-1,3\\rangle\\\\\n&=\\langle-6,3,-9\\rangle.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b24c9ae-6d2e-5c1d-b6e5-5ea195303fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\mathbf i+9\\mathbf j-\\mathbf k" :db/id #edb/ref 17592186711230} {:answer/id #uuid "5ebe0c0c-2e32-54b2-873d-ed50a351379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\mathbf i-5\\mathbf j+5\\mathbf k" :db/id #edb/ref 17592186711235} {:answer/id #uuid "5f78bb1c-66a0-5ee1-b134-44bd158bc2ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\mathbf i-3\\mathbf j-5\\mathbf k" :db/id #edb/ref 17592186711236} {:answer/id #uuid "625361d3-acc9-50ad-9856-406d7aea1bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\mathbf i-9\\mathbf j+\\mathbf k" :db/id #edb/ref 17592186711237} {:answer/id #uuid "e3b83bb2-d06f-517a-a5ab-95bd62cd8d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbf i-7\\mathbf j+3\\mathbf k" :db/id #edb/ref 17592186711245}] :answer-field/correct {:db/id #edb/ref 17592186711237} :answer-field/id #uuid "2b9e655a-2f67-5860-beac-458a1cd3b4a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711231}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0ab30bc-8e0d-58ed-bb44-53e554f692a6" :question/problem "Find $(2\\mathbf a+3\\mathbf c)\\times(\\mathbf b+2\\mathbf c)$, if $\\mathbf a\\times\\mathbf b=\\mathbf i-\\mathbf j+\\mathbf k$, $\\mathbf a\\times\\mathbf c=\\mathbf i-\\mathbf j-\\mathbf k$, and $\\mathbf b\\times\\mathbf c=\\mathbf i+\\mathbf j-\\mathbf k$." :question/worked-solution "Distribute over both sums. Keep the order of each pair of vectors while factoring out the scalars:\n\n$$\n\\begin{aligned}\n(2\\mathbf a+3\\mathbf c)\\times(\\mathbf b+2\\mathbf c)\n&=2(\\mathbf a\\times\\mathbf b)+4(\\mathbf a\\times\\mathbf c)\\\\\n&\\quad+3(\\mathbf c\\times\\mathbf b)+6(\\mathbf c\\times\\mathbf c).\n\\end{aligned}\n$$\n\nThe self product is zero. The third term uses the opposite order from the given $\\mathbf b\\times\\mathbf c$, so it changes sign. The expression reduces to\n\n$$\n2(\\mathbf a\\times\\mathbf b)+4(\\mathbf a\\times\\mathbf c)-3(\\mathbf b\\times\\mathbf c).\n$$\n\nSubstitute the three given products and collect components:\n\n$$\n\\begin{aligned}\n&2(\\mathbf i-\\mathbf j+\\mathbf k)+4(\\mathbf i-\\mathbf j-\\mathbf k)-3(\\mathbf i+\\mathbf j-\\mathbf k)\\\\\n&\\quad=(2+4-3)\\mathbf i+(-2-4-3)\\mathbf j+(2-4+3)\\mathbf k\\\\\n&\\quad=3\\mathbf i-9\\mathbf j+\\mathbf k.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1122b6e9-0846-53ec-a7ad-b360b37c2e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\mathbf{j}-22\\mathbf{k}" :db/id #edb/ref 17592186711464} {:answer/id #uuid "2d7726be-a87e-5086-a275-0370dbbb1c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\mathbf{j}+2\\mathbf{k}" :db/id #edb/ref 17592186711470} {:answer/id #uuid "38f4c546-5f97-5b0c-8cd9-a8177758a5f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\mathbf{j}+22\\mathbf{k}" :db/id #edb/ref 17592186711472} {:answer/id #uuid "7ab236d0-5e79-540a-82d1-96a847efb086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\mathbf{j}+14\\mathbf{k}" :db/id #edb/ref 17592186711478} {:answer/id #uuid "f9d71e72-579a-5777-9f35-916985a8b15d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\mathbf{j}+16\\mathbf{k}" :db/id #edb/ref 17592186711495}] :answer-field/correct {:db/id #edb/ref 17592186711478} :answer-field/id #uuid "7ee2a1cf-978f-5839-beb4-6233d1b6f73e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711479}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ce982b9-fb5f-508d-86f7-3230d22962a8" :question/problem "Find $(2\\mathbf{c})\\times (-3\\mathbf{a}-2\\mathbf{b})$, given\n\n$$\n\\begin{aligned}\n\\mathbf{c}\\times \\mathbf{a}&=-\\mathbf{j}-3\\mathbf{k} \\\\ \\mathbf{c}\\times \\mathbf{b}&=-3\\mathbf{j}+\\mathbf{k}\n\\end{aligned}\n$$" :question/worked-solution "Distribute over each sum or difference, keeping the operands in their original order:\n\n$$\n\\begin{aligned}\n&(2\\mathbf{c})\\times (-3\\mathbf{a}-2\\mathbf{b}) \\\\ &=(2\\mathbf{c})\\times (-3\\mathbf{a})+(2\\mathbf{c})\\times (-2\\mathbf{b})\n\\end{aligned}\n$$\n\nExtract the scalars, substitute the given ordered products, and add corresponding components:\n\n$$\n\\begin{aligned}\n&=-6(\\mathbf{c}\\times \\mathbf{a})-4(\\mathbf{c}\\times \\mathbf{b}) \\\\ &=-6(-\\mathbf{j}-3\\mathbf{k})-4(-3\\mathbf{j}+\\mathbf{k}) \\\\ &=(6\\mathbf{j}+18\\mathbf{k})+(12\\mathbf{j}-4\\mathbf{k}) \\\\ &=18\\mathbf{j}+14\\mathbf{k}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16fa3c32-10cd-5e99-a13d-01d81d2fc14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 0,14,6\\rangle" :db/id #edb/ref 17592186711465} {:answer/id #uuid "2595164a-8090-5bf8-92c3-b147636d9e63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 0,26,2\\rangle" :db/id #edb/ref 17592186711468} {:answer/id #uuid "43fb30da-a3aa-58a1-8b54-84f30ca7bcaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 0,10,-14\\rangle" :db/id #edb/ref 17592186711474} {:answer/id #uuid "a3422118-7226-5989-8584-0182541721d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 0,-10,14\\rangle" :db/id #edb/ref 17592186711484} {:answer/id #uuid "bf43753b-38bb-590e-ae95-2fd8b36592d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 0,22,-2\\rangle" :db/id #edb/ref 17592186711487}] :answer-field/correct {:db/id #edb/ref 17592186711468} :answer-field/id #uuid "b27b9540-a6f5-55eb-a0ff-9cc98daa4017" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711486}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76ad7816-7833-5e32-b36d-3b8bf587e55d" :question/problem "Find $(2\\mathbf{a}+3\\mathbf{b})\\times (-2\\mathbf{c})$, given\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\times \\mathbf{c}&=\\langle 0,-2,-2\\rangle \\\\ \\mathbf{b}\\times \\mathbf{c}&=\\langle 0,-3,1\\rangle\n\\end{aligned}\n$$" :question/worked-solution "Distribute over each sum or difference, keeping the operands in their original order:\n\n$$\n\\begin{aligned}\n&(2\\mathbf{a}+3\\mathbf{b})\\times (-2\\mathbf{c}) \\\\ &=(2\\mathbf{a})\\times (-2\\mathbf{c})+(3\\mathbf{b})\\times (-2\\mathbf{c})\n\\end{aligned}\n$$\n\nExtract the scalars, substitute the given ordered products, and add corresponding components:\n\n$$\n\\begin{aligned}\n&=-4(\\mathbf{a}\\times \\mathbf{c})-6(\\mathbf{b}\\times \\mathbf{c}) \\\\ &=-4(\\langle 0,-2,-2\\rangle)-6(\\langle 0,-3,1\\rangle) \\\\ &=(\\langle 0,8,8\\rangle)+(\\langle 0,18,-6\\rangle) \\\\ &=\\langle 0,26,2\\rangle\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11151026-2088-59c2-a71c-827a76410b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\mathbf{j}" :db/id #edb/ref 17592186711463} {:answer/id #uuid "34b217e6-6b09-57a1-b004-dbc4a8b6387e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\mathbf{i}-12\\mathbf{j}" :db/id #edb/ref 17592186711471} {:answer/id #uuid "3abf74c8-957f-58f9-8d03-e33fa0c57dcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\mathbf{i}-12\\mathbf{j}" :db/id #edb/ref 17592186711473} {:answer/id #uuid "74ecca2d-0fab-59b0-90f6-3e0c515b8e8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\mathbf{i}+12\\mathbf{j}" :db/id #edb/ref 17592186711476} {:answer/id #uuid "86ebb960-6f45-5434-bf30-a98157ea8801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :