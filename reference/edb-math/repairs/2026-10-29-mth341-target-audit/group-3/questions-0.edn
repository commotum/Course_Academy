nswer.type/math} :answer/value "Z" :db/id #edb/ref 17592186389885} {:answer/id #uuid "12983aa2-003c-5e08-9553-fa254287b24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186389886} {:answer/id #uuid "d322c9f2-6eea-5a6c-928b-46473e30f25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186389887} {:answer/id #uuid "9b6d1a27-c6c6-5b53-950b-9eaa6b2d1ae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{2}" :db/id #edb/ref 17592186389888}] :answer-field/correct {:db/id #edb/ref 17592186389886} :answer-field/id #uuid "cd9d9adb-106e-598c-93ae-8f50a1356364" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186389882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d5f6382-0496-52d1-a2e2-159ffe2ef26c" :question/math-academy-id "q-181129" :question/problem "![](images/d5/d550ecec3b7103c9510b6e45e738ae1385e07fa63ff2e50c54da6c17606faaec.png)\n\nDescribe the set of points shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,{{field-2}}\\le x\\le {{field-3}},\\,{{field-4}}\\le y\\le {{field-5}}\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points $P(x,y)$ satisfy the condition\n\n$$\nx\\in \\{-3,-2,-1\\},\\,y\\in \\{-4,-3,-2,-1\\}.\n$$\n\nIn other words,\n\n$$\n-3\\le x\\le -1,\\,-4\\le y\\le -1\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,-3\\le x\\le -1,\\,-4\\le y\\le -1\\}.\n$$"}] [{:db/id #edb/ref 17592186198774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "115b13aa-45b4-5d7f-b7be-4105d7f301bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186284941} {:answer/id #uuid "97761c50-baa0-5b7f-b17b-c4f1e031062b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286167} {:answer/id #uuid "9874712d-e48a-5ad7-8062-8b7a1b66f8c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286184} {:answer/id #uuid "afb03202-6366-5d59-875c-6ab75aa5a6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186286389}] :answer-field/correct {:db/id #edb/ref 17592186286167} :answer-field/id #uuid "05528c93-d5f8-5c5b-b1cd-04f0cc8714b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287155} {:answer-field/choices [{:answer/id #uuid "2e43267a-ab67-5d4d-9e98-2cfd8dad2032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186285200} {:answer/id #uuid "8a88562c-e5a6-5722-865d-e046e5b8bf65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286054} {:answer/id #uuid "a05bb211-87ae-58c1-b83f-068532bb0ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286249} {:answer/id #uuid "d6881747-ef44-5afa-931c-6610c1e0f88f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186286739} {:answer/id #uuid "fc68d7ed-c691-5563-884b-234b832e66d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186287095}] :answer-field/correct {:db/id #edb/ref 17592186286054} :answer-field/id #uuid "5c965ca2-4bb9-5407-b798-9c41900a1240" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287346}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e53c3cdf-7677-5e74-84b5-4fbd3ffc112e" :question/math-academy-id "q-181172" :question/problem "![](images/5c/5c4ffbb64a754df9a6100fda3fd6eaf4a68f28ac59de4dfb716c2c8b1f2847ab.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,{x}^{2}}\n$$" :question/worked-solution "The points in our set include all those that lie *below* the curve $y={x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<{x}^{2}\n$$\n\nWe must also include the curve $y={x}^{2}$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\le {x}^{2}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\le {x}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186198777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b97f22-a5de-5eb5-bcba-1c3ac6dd986d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285719} {:answer/id #uuid "66be57f6-21d4-563a-9e66-fc6b4ec7bc4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186285720} {:answer/id #uuid "67e09f05-2c8e-5438-8d98-57cf29ff9721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285739} {:answer/id #uuid "86b5837d-7e55-53a6-9dda-da2d7eb45c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286023} {:answer/id #uuid "c9d4decd-fb9d-5a3b-8362-0a371fcc26fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286629}] :answer-field/correct {:db/id #edb/ref 17592186286023} :answer-field/id #uuid "07fc6651-c3df-5d42-9915-2169e2bb8b07" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287161} {:answer-field/choices [{:answer/id #uuid "1cecd63a-a4a8-5b52-a34f-28045e7a521e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186285047} {:answer/id #uuid "58d41c4d-9e8f-59fa-b909-9ce7fe0df992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186285602} {:answer/id #uuid "e1d0ac02-e8e5-5e23-9d84-c1bc2f9261ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186286843} {:answer/id #uuid "e376d0b6-8adf-540e-ba62-12698cc7129a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286867}] :answer-field/correct {:db/id #edb/ref 17592186286867} :answer-field/id #uuid "db3af0b1-8a47-5f0a-949e-6ccd7bf13aed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287594}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c28df386-4e37-5537-beaf-35f25b2c6e2f" :question/math-academy-id "q-181269" :question/problem "![](images/f0/f00499aad7b915267fe99bde8c13665a325cf6409e2e856466e9cdc90e4a8b8a.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,2x-3}\n$$" :question/worked-solution "The points in our set include all those that lie *below* the line $y=2x-3.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<2x-3\n$$\n\nWe must also include the line $y=2x-3$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\le 2x-3\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\le 2x-3}.\n$$"}] [{:db/id #edb/ref 17592186198781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89bc49da-ef2e-515e-b0fc-f5f41d825070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186195398} {:answer/id #uuid "bae4cae4-31ff-552f-88b6-e13c998ba9dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186195399} {:answer/id #uuid "fe3fc5af-ba89-5093-8178-d66491208e1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186195400} {:answer/id #uuid "56c7f4c4-3bee-5091-8356-a8d8d487779c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186195401} {:answer/id #uuid "575f5a20-bd9b-549d-bacf-328ed0335a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186195402}] :answer-field/id #uuid "93a05ded-da2d-5c40-b94f-67fed0ee2106" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186195397} {:answer-field/choices [{:answer/id #uuid "9c39655b-463a-5353-b186-042f645dfed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 1759218619540