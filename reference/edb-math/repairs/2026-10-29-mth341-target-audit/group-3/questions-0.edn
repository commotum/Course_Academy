a600d-d7ff-5eb1-9775-622244250c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186191838} {:answer/id #uuid "551a86b2-cd2a-550b-992a-87d8041f9257" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186191839} {:answer/id #uuid "73bf09a7-7dc9-5873-b694-31967fdd10e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186191840}] :answer-field/id #uuid "b777d0a7-d3d3-53db-a3ec-ea0d8ad11792" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186191835}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d74321de-8890-56ad-834f-b47ef644ccec" :question/math-academy-id "q-35586" :question/problem "Which of the following sets is a subspace of $R^{2}$?\n\n1. $A = {⟨2 - t,-4 + t⟩: t ∈ R}$\n2. $B = {⟨x, y⟩ ∈ R^{2}: 4x - 2y = 1}$\n3. $C = {⟨x, y⟩ ∈ R^{2}: y = 0}$"}] [{:db/id #edb/ref 17592186193319 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "619d88ad-a1c7-5b3d-8c24-b6a78974ec7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459847} {:answer/id #uuid "543df3d1-82cc-50ab-9e90-e99e3210da09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459848}] :answer-field/correct {:db/id #edb/ref 17592186459847} :answer-field/id #uuid "adf642b5-0d99-5a3e-8aa9-2b628925bcd1" :answer-field/key "![Diagram I](images/6e/6e8c180b3963c096afadfcfe590f8cff8ee3859438aab883ef08fa18d35ed503.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460790} {:answer-field/choices [{:answer/id #uuid "c18b93bd-bcdd-50e4-afa3-