\\\\ \\sqrt{5} \\\\ 0\\end{bmatrix}.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=\\begin{bmatrix}-14 \\\\ 1 \\\\ 2\\end{bmatrix}+s\\begin{bmatrix}5 \\\\ -1 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ \\sqrt{5} \\\\ 0\\end{bmatrix},\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186338862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,2,-1⟩" :db/id #edb/ref 17592186336052} {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} {:answer/id #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,0⟩" :db/id #edb/ref 17592186336605} {:answer/id #uuid "924674c9-4ac4-5fac-bce9-febfcdbeeeee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-3,1⟩" :db/id #edb/ref 17592186337359} {:answer/id #uuid "faf5ff12-8cff-5606-9806-8c51dfe352b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-1,3⟩" :db/id #edb/ref 17592186338232}] :answer-field/correct {:db/id #edb/ref 17592186336439} :answer-field/id #uuid "0006422d-58d9-51c7-8d8f-f4fd7450f036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2e1c378-a183-516b-92fd-1753dcbc375f" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=\\begin{bmatrix}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ -1 \\\\ 3\\end{bmatrix}+s\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix},\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}0 \\\\ -1 \\\\ 3\\end{bmatrix}\\times \\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{vmatrix} \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$"}] [{:db/id #edb/ref 17592186338863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13372795-1d9c-59ee-ba7f-59bbde3f9d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,3⟩" :db/id #edb/ref 17592186336213} {:answer/id #uuid "14870064-b7e8-54d0-99ca-4b64bfe2bd62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,4⟩" :db/id #edb/ref 17592186336226} {:answer/id #uuid "2c7f5521-fd3a-51c7-9ecf-a3af94ee1454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,1⟩" :db/id #edb/ref 17592186336454} {:answer/id #uuid "6249715c-fc3f-56fb-9993-32d1a515b62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,0,-3⟩" :db/id #edb/ref 17592186336915} {:answer/id #uuid "c671655c-abd1-563c-aef5-4ee4cece1841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,1,-3⟩" :db/id #edb/ref 17592186337791}] :answer-field/correct {:db/id #edb/ref 17592186337791} :answer-field/id #uuid "be9468de-a381-56af-b583-e970a0ac913c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cd142bb-0e37-5169-9871-c05d6282caa6" :question/math-academy-id "q-70974" :question/problem "Find a normal vector to the plane\n\n$$\nr=\\begin{bmatrix}1 \\\\ 12 \\\\ \\frac{3}{4}\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 0 \\\\ 4\\end{bmatrix}+s\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix},\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨3,0,4⟩$ and $w=⟨1,-1,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ 4\\end{bmatrix}\\times \\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 3 & 0 & 4 \\\\ 1 & -1 & 1\\end{vmatrix} \\\\  & =4i+j-3k \\\\  & =⟨4,1,-3⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨4,1,-3⟩.$"}] [{:db/id #edb/ref 17592186338864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b6d3463-0771-5e04-b56b-54f54e1837a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,\\sqrt{2},-1⟩+s⟨1,2,-3⟩+t⟨-1,0,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336286} {:answer/id #uuid "2f58a87f-7c73-5da5-b8f8-e1aacaae0350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,2,-3⟩+s⟨1,\\sqrt{2},-1⟩+t⟨-1,0,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336486} {:answer/id #uuid "4ae0deb5-2922-5529-9ad8-91ab2528ada9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,\\sqrt{2},-1⟩+s⟨0,11,\\frac{1}{3}⟩+t⟨0,\\sqrt{2},5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336722} {:answer/id #uuid "a223a9e3-d02c-5320-818f-d895e878dbc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186337503} {:answer/id #u