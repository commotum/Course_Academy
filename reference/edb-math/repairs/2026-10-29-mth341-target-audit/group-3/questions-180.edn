 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨9,-7,2⟩+t⟨15,2,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336194} {:answer/id #uuid "29c0e30f-01b0-544b-ab04-24cf15557b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336418} {:answer/id #uuid "38aecd63-d022-58e1-a3f2-d592b96f91b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,1,-2⟩+s⟨16,-1,3⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336560} {:answer/id #uuid "5e4e05a5-2028-58b3-8745-b9f305c2a037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186336888} {:answer/id #uuid "f37cbbb1-9cfd-5d0b-8790-c75dd0b9d27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,11,3⟩+s⟨5,1,-2⟩+t⟨16,-1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186338159}] :answer-field/correct {:db/id #edb/ref 17592186336418} :answer-field/id #uuid "6e9c1f6e-eb56-5021-8bc2-47b86fdac3a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc807ce5-aee1-5714-82d8-8391abd01453" :question/math-academy-id "q-70978" :question/problem "Find a parametric equation of the plane that passes through the point $E(16,-1,3)$ and is parallel to the lines $r=⟨9,-7,2⟩+s⟨5,1,-2⟩$ and $r=⟨15,2,-3⟩+t⟨1,11,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨5,1,-2⟩$ and ${v}_{2}=⟨1,11,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $E(16,-1,3)$ lies on the plane and its position vector is $e=⟨16,-1,3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =e+s{v}_{1}+t{v}_{2} \\\\ r & =⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49c5cfba-30b4-5cd2-bb7b-b9327c517321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-1,-1,1⟩+s⟨2,5,-3⟩+t⟨0,-8,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336716} {:answer/id #uuid "6aa30567-9f99-5396-b1b9-f442d2fcaa29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-1,-1,1⟩+s⟨1,-7,-2⟩+t⟨0,-8,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336976} {:answer/id #uuid "81128713-0ba6-54d5-ad60-664ede84fab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-1,-1,1⟩+s⟨3,6,-4⟩+t⟨1,-7,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337202} {:answer/id #uuid "8afb07a6-2bd8-5edb-9ec6-22d1e7d02591" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186337287} {:answer/id #uuid "a3e1912b-7b80-5650-8872-08ddd53cd44c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-1,-1,1⟩+s⟨3,6,-4⟩+t⟨2,5,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337517}] :answer-field/correct {:db/id #edb/ref 17592186337202} :answer-field/id #uuid "2c6c2ae9-bf70-5d0f-96e8-5aee0a9622bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338357}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2d249e59-e724-5332-83de-2d46399e2dbe" :question/math-academy-id "q-71034" :question/problem "Find a parametric equation of the plane that passes through the points $L(-1,-1,1),\\,M(2,5,-3)$, and $N(0,-8,-1).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =⟨2,5,-3⟩-⟨-1,-1,1⟩ \\\\  & =⟨3,6,-4⟩ \\\\ \\overset{\\to }{LN} & =⟨0,-8,-1⟩-⟨-1,-1,1⟩ \\\\  & =⟨1,-7,-2⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $l=⟨-1,-1,1⟩$ of the point $l,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =l+s\\overset{\\to }{LM}+t\\overset{\\to }{LN} \\\\ r & =⟨-1,-1,1⟩+s⟨3,6,-4⟩+t⟨1,-7,-2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2337c867-1b68-51ab-bed8-d899af940e00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186336359} {:answer/id #uuid "337484e0-5b6b-5f95-88dc-ef0b3096b39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,0⟩+s⟨3,4,-3⟩+t⟨2,0,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336518} {:answer/id #uuid "38e231b3-4c0e-5717-a0ef-ef6534f1c274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨2,0,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336565} {:answer/id #uuid "4401b429-e065-55ec-a1ab-6464c74d2d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336670} {:answer/id #uuid "f760a7c7-7e6e-53d4-8222-5b484099a2f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,0⟩+s⟨3,4,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186338201}] :answer-field/correct {:db/id #edb/ref 17592186336670} :answer-field/id #uuid "489447af-58f8-5125-a63d-1b42d95b0549" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338406}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "238f448c-c904-543b-b4aa-7c48d6e1e778" :question/math-academy-id "q-71038" :question/problem "Find a parametric equation of the plane that passes through the points $U(2,-1,0),\\,V(3,4,-3)$, and $W(2,0,0).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{UV}$ and $\\overset{\\to }{UW},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =⟨3,4,-3⟩-⟨2,-1,0⟩ \\\\  & =⟨1,5,-3⟩ \\\\ \\overset{\\to }{UW} & =⟨2,0,0⟩-⟨2,-1,0⟩ \\\\  & =⟨0,1,0⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨2,-1,0⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+s\\overset{\\to }{UV}+t\\overset{\\to }{UW} \\\\ r & =⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5b2d85-4151-54a4-ac97-beef0024d1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468076} {:answer/id #uuid "2c392c8d-2089-591c-a70b-c5983cd9d8ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468077}] :answer-field/correct {:db/id #edb/ref 17592186468076} :answer-field/id #uuid "d486dc1c-3d30-5e4f-835e-f08717f52889" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\1-x-y=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468759} {:answer-field/choices [{:answer/id #uuid "465a6071-09f7-5ac0-928d-43e875a45ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468078} {:answer/id #uuid "43d1ede4-b752-517f-859b-1a7a07ade02c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468079}] :answer-field/correct {:db/id #edb/ref 17592186468078} :answer-field/id #uuid "a9c858f4-cbfb-5002-a626-7d8e4c6fc2c6" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\{x}^{2}+{y}^{2}+{z}^{2}\\le 1\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468760} {:answer-field/choices [{:answer/id #uuid "61b2f350-f63b-50a8-a1f2-5bd05dffb414" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468080} {:answer/id #uuid "f07e9305-0844-5a74-9550-81a8ec3521c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468081}] :answer-field/correct {:db/id #edb/ref 17592186468081} :answer-field/id #uuid "0fa3dc22-e26d-5b76-84a3-23639eb52190" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\2x+3y-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468761}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e93e600-4a01-5ada-842d-9b175b57ee56" :question/math-academy-id "q-74217" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $1-x-y=0$ since $1-0-0\\ne 0.$\n\n- The set $B$ is not a subspace. Indeed, the vector $u=⟨1,0,0⟩$ is in $B$, but $2u=⟨2,0,0⟩$ is not in $B$, since ${2}^{2}+{0}^{2}+{0}^{2}≰1.$ So, $B$ is not closed under scalar multiplication.\n\n- The set $C$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $2x+3y-z=0$ since $2\\cdot 0+3\\cdot 0-0=0.$ So $0$ lies in $C.$\n\nIn conclusion, the correct answer is $$\n\\displaystyle \\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\2x+3y-z=0\\end{gathered}\\right\\}\\end{gathered}\n$$ only."}] [{:db/id #edb/ref 17592186342188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4ee9b9a-eb51-5e15-abb2-05bb1b86b139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468082} {:answer/id #uuid "f22d2656-8795-5d89-ac40-9e4cae3d15a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468083}] :answer-field/correct {:db/id #edb/ref 17592186468082} :answer-field/id #uuid "36e0eb83-eda5-5211-bd02-730bf01aa552" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\{x}^{2}+{y}^{2}+{z}^{2}=1\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468762} {:answer-field/choices [{:answer/id #uuid "1d206fe7-45bb-5c68-ba7e-b82cba496bc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468084} {:answer/id #uuid "e417d014-1256-54c2-b5a6-83c0e16db7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468085}] :answer-field/correct {:db/id #edb/ref 17592186468084} :answer-field/id #uuid "8a030342-3365-5302-be22-c12324e628cc" :answer-field/key "$B={⟨x,y,z⟩\\in {R}^{3}:xyz=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468763} {:answer-field/choices [{:answer/id #uuid "1ef52cd4-5c7a-5343-89cd-f60bf03a78bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468086} {:answer/id #uuid "993adad2-e813-5acf-9d8c-0d5673935db2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468087}] :answer-field/correct {:db/id #edb/ref 17592186468086} :answer-field/id #uuid "e56f414b-9b1b-5b30-aeec-c4089b6d4315" :answer-field/key "$C={⟨x,y,z⟩\\in {R}^{3}:y=-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468764} {:answer-field/choices [{:answer/id #uuid "7ce11628-b3f5-578a-ab84-8015541fd894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668695} {:answer/id #uuid "8d0643a8-0d37-5ac4-a88a-e9cd0e0dbf1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668696}] :answer-field/correct {:db/id #edb/ref 17592186668696} :answer-field/id #uuid "824306a8-7a4d-51f8-ac57-01ae94ef5558" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5037faf6-6f8a-5ea2-800f-2c136a3bb59e" :question/math-academy-id "q-74218" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition ${x}^{2}+{y}^{2}+{z}^{2}=1$ since ${0}^{2}+{0}^{2}+{0}^{2}\\ne 1.$\n\n- The set $B$ is not a subspace because it is not closed under vector addition. Indeed, both $a=⟨1,0,1⟩$ and $b=⟨0,1,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0,1⟩+⟨0,1,1⟩=⟨1,1,2⟩\n$$\n\n \ndoes not satisfy the condition $xyz=0$ since $1\\cdot 1\\cdot 2\\ne 0.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $y=-1$ since $0\\ne -1.$\n\nSo, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186342191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99a152a-4432-58e7-8095-7a6594ae2e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468088} {:answer/id #uuid "ed1282bf-bb72-590a-82cb-57afddffd291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468089}] :answer-field/correct {:db/id #edb/ref 17592186468088} :answer-field/id #uuid "1bf27b0a-4178-50bb-a563-2416eaa07855" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}<\\frac{1}{2}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468765} {:answer-field/choices [{:answer/id #uuid "75291599-266c-544e-b704-be929998cc4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468090} {:answer/id #uuid "cf437d27-edd1-584d-be5b-b58d1bf9be5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468091}] :answer-field/correct {:db/id #edb/ref 17592186468091} :answer-field/id #uuid "11bc94d4-2ccf-5ec6-bfea-1ec2f439dda1" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5x-y-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468766} {:answer-field/choices [{:answer/id #uuid "90497ddb-e287-5539-b1a1-cd58a7c31e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468092} {:answer/id #uuid "80442660-0495-5466-89ce-25cccd762bbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468093}] :answer-field/correct {:db/id #edb/ref 17592186468092} :answer-field/id #uuid "dc40e59a-282b-5ffd-8ff6-51c6739169ba" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5-x-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468767}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb81e4a8-c5a7-59da-b168-b278b747b24a" :question/math-academy-id "q-74255" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. Indeed, the vector $u=⟨\\frac{1}{4},0,0⟩$ is in $A$, since\n\n$$\n\\sqrt{{\\left(\\frac{1}{4}\\right)}^{2}+{0}^{2}+{0}^{2}}=\\frac{1}{4}<\\frac{1}{2},\n$$\n\nbut, $4u=⟨1,0,0⟩$ is not in $B$, since \n\n$$\n\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}}>\\frac{1}{2}.\n$$\n\nSo, $A$ is not closed under scalar multiplication.\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $5x-y-z=0$ since $5\\cdot 0-0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $5-x-z=0$ since $5-0-0\\ne 0.$\n\nIn conclusion, the correct answer is $$\n\\displaystyle \\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5x-y-z=0\\end{gathered}\\right\\}\\end{gathered}\n$$ only."}] [{:db/id #edb/ref 17592186363024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5e34802-4e03-501d-b655-3f42e2ddfc64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-3,0⟩)\\cdot ⟨3,5,0⟩=0" :db/id #edb/ref 17592186363026} {:answer/id #uuid "bec5e5a9-a073-528d-9ae3-9bfe40a3b19e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,-3⟩)\\cdot ⟨5,3,0⟩=0" :db/id #edb/ref 17592186363027} {:answer/id #uuid "0d1df4cb-44e6-56d3-a196-44308fd4a048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,3,0⟩)\\cdot ⟨3,5,-1⟩=0" :db/id #edb/ref 17592186363028} {:answer/id #uuid "e6bc49eb-5a6c-5d63-a2d4-86976bd7f8e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,3⟩)\\cdot ⟨5,3,0⟩=0" :db/id #edb/ref 17592186363029} {:answer/id #uuid "76481902-4242-5eb8-a9a5-98cb5658a19f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-3,1⟩)\\cdot ⟨3,0,5⟩=0" :db/id #edb/ref 17592186363030}] :answer-field/correct {:db/id #edb/ref 17592186363026} :answer-field/id #uuid "62d8e0de-bd79-5989-ac01-8e91264eb204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363025}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "375a2ad1-dda0-51b8-a824-e404e34a60e1" :question/math-academy-id "q-128382" :question/problem "Given the Cartesian equation $3x+5y+15=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨3,5,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}3x+5y+15 & =0 \\\\ 5y & =-3x-15 \\\\ y & =-\\frac{3}{5}x-3.\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=-3.$ Hence, the point $P(0,-3,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,-3,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,-3,0⟩)\\cdot ⟨3,5,0⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186363934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de24ce31-8567-5933-91b9-84ce46195f82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y-4z+2=0" :db/id #edb/ref 17592186363936} {:answer/id #uuid "f47bdf6d-aa44-5993-8a4f-e55f9cddaa83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4z+2=0" :db/id #edb/ref 17592186363937} {:answer/id #uuid "a3a0927d-77b7-5bf0-bc22-7b9ddcfd7658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y-4z-22=0" :db/id #edb/ref 17592186363938} {:answer/id #uuid "9c6c0173-9824-5097-808b-03437fc112f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-4z+2=0" :db/id #edb/ref 17592186363939} {:answer/id #uuid "c1a6b20d-9141-5a21-8147-f66bb2f7a01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-4y-22=0" :db/id #edb/ref 17592186363940}] :answer-field/correct {:db/id #edb/ref 17592186363936} :answer-field/id #uuid "c325860e-c4c3-52ab-a5ca-c8d3a61bbc17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363935}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b22ad79-7dea-54b4-b8ec-aee9009a09ff" :question/math-academy-id "q-336218" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(0,2,3)$ and is perpendicular to the line \n\n$$\n\\frac{y-3}{-5}=\\frac{z}{4},\\,x=1\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨0,2,3⟩.$ From the Cartesian equation, we find that the line is parallel to the vector $⟨0,-5,4⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨0,-5,4⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,-5,4⟩ & =⟨0,2,3⟩\\cdot ⟨0,-5,4⟩ \\\\ r\\cdot ⟨0,-5,4⟩ & =2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,-5,4⟩ & =2 \\\\ -5y+4z & =2 \\\\ -5y+4z-2 & =0 \\\\ 5y-4z+2 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181df3ad-19a0-57f1-abe1-34809fb363ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y-z-4=0" :db/id #edb/ref 17592186364304} {:answer/id #uuid "f4ea7f46-b7b5-5164-9296-a5705c866cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y+z-5=0" :db/id #edb/ref 17592186364305} {:answer/id #uuid "2bb82e7a-c0b7-5eef-ac04-7f9df3f862fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y-4=0" :db/id #edb/ref 17592186364306} {:answer/id #uuid "9cec7669-a89f-53aa-9859-52e8d03c3787" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y-z-5=0" :db/id #edb/ref 17592186364307} {:answer/id #uuid "fdabf384-2f71-5d7f-a659-8e78a851ba26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+y-z-5=0" :db/id #edb/ref 17592186364308}] :answer-field/correct {:db/id #edb/ref 17592186364307} :answer-field/id #uuid "8e8ea1c7-6edb-564b-ac95-d5d2b72cd2e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364303}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "091b9ad4-6dc4-5677-b067-721682dcc589" :question/math-academy-id "q-70811" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,1,0)$ and is perpendicular to the line \n$$\n\\displaystyle r=\\begin{bmatrix}3 \\\\ 1 \\\\ -1\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ -3 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,1,0⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨-2,-3,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-2,-3,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-2,-3,1⟩ & =⟨1,1,0⟩\\cdot ⟨-2,-3,1⟩ \\\\ r\\cdot ⟨-2,-3,1⟩ & =-5.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,-3,1⟩ & =-5 \\\\ -2x-3y+z & =-5 \\\\ -2x-3y+z+5 & =0 \\\\ 2x+3y-z-5 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfc0e271-d132-5c96-8979-e364f1e1f34a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,-2,4⟩+s⟨7,3,4⟩+t⟨3,5,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186364963} {:answer/id #uuid "7cd1342d-7878-5a75-9176-05c6122e4327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,-5,2⟩+s⟨-3,-7,4⟩+t⟨3,5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186364964} {:answer/id #uuid "a2469e45-f46f-5bf2-8218-43fbc9316f2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨4,-3,7⟩+t⟨1,-5,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186364965} {:answer/id #uuid "981f1d77-de73-5603-a919-a53078816346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨7,-4,3⟩+t⟨1,-5,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186364966} {:answer/id #uuid "bb118e6d-8ad4-5109-9907-192619f47dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨7,-3,4⟩+t⟨3,-5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186364967}] :answer-field/correct {:db/id #edb/ref 17592186364967} :answer-field/id #uuid "248fe217-5cd5-501a-994e-666efe8ce937" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b43bb9ce-619f-53b3-8245-585a25c57b33" :question/math-academy-id "q-128538" :question/problem "Find a parametric equation of the plane that passes through the point $E(4,-2,5)$ and is parallel to the lines $r=⟨11,0,5⟩+s⟨7,-3,4⟩$ and $r=⟨12,-2,4⟩+t⟨3,-5,1⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨7,-3,4⟩$ and ${v}_{2}=⟨3,-5,1⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $E(4,-2,5)$ lies on the plane and its position vector is $e=⟨4,-2,5⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =e+s{v}_{1}+t{v}_{2} \\\\ r & =⟨4,-2,5⟩+s⟨7,-3,4⟩+t⟨3,-5,1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abe04ef1-0077-539a-b85c-52caa98344a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-3,2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366207} {:answer/id #uuid "4a96f288-3fd0-537b-806e-046844764150" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186366208} {:answer/id #uuid "fac45cd4-59c7-516c-bd74-1e4a54e263c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨-3,2,4⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366209} {:answer/id #uuid "4e15b755-6aa5-59e8-8ede-166d794590c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366210} {:answer/id #uuid "6d4ca503-3a78-5aa5-ac98-b7e77b80a651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-4,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366211}] :answer-field/correct {:db/id #edb/ref 17592186366211} :answer-field/id #uuid "3b9dde6c-05bb-5b0d-9060-015e400fc047" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366206}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "340957e8-d465-5c3d-b1df-5f238a4c6329" :question/math-academy-id "q-71040" :question/problem "Find a parametric equation of the plane that passes through the points $C(1,1,1)$ and $D(-3,2,4)$, and is parallel to the vector $v=⟨0,1,1⟩.$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). We already have one vector $v=⟨0,1,1⟩.$ Let's also use the displacement vector $\\overset{\\to }{CD}$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =⟨-3,2,4⟩-⟨1,1,1⟩ \\\\  & =⟨-4,1,3⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $c=⟨1,1,1⟩$ of the point $C,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =c+sv+t\\overset{\\to }{CD} \\\\ r & =⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-4,1,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bde48367-e769-503e-8ad6-0c5d9f897ada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186374396} {:answer/id #uuid "c7894e2b-1060-5e26-8a29-0c4f787e571e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186374397}] :answer-field/correct {:db/id #edb/ref 17592186374397} :answer-field/id #uuid "a83530ca-fbbe-51cb-a26a-450659c0e6a5" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374395} {:answer-field/choices [{:answer/id #uuid "6907ae38-4cab-542f-aec0-edb74aec88f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186374399} {:answer/id #uuid "8d88ff4a-3ee2-549e-ba1c-d5c20bba3069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186374400}] :answer-field/correct {:db/id #edb/ref 17592186374400} :answer-field/id #uuid "a89cf05b-dcae-59f6-a446-92398496ca87" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374398} {:answer-field/choices [{:answer/id #uuid "0237cc93-9a15-541a-9d00-3189dee5eec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186374402} {:answer/id #uuid "174aa03e-49b1-5db3-82aa-38ce30dc1411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186374403}] :answer-field/correct {:db/id #edb/ref 17592186374402} :answer-field/id #uuid "a3157b98-0c9b-5429-ad6c-5f32fc31031f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374401} {:answer-field/choices [{:answer/id #uuid "2d92890b-6106-515d-8c3c-b939fdacd758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186374405} {:answer/id #uuid "d04e5716-9d6a-5f97-8a55-69c57553d296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186374406}] :answer-field/correct {:db/id #edb/ref 17592186374405} :answer-field/id #uuid "9b1e6a44-df3e-53cc-97e9-1b76ca3abff0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d62b961-39d3-5633-b650-62ddc2233d7f" :question/math-academy-id "q-181159" :question/problem "![](images/99/993cfa437e54f390237b85f3d7ee8a76b626d65431908fe039e0046ba0a33bb1.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3\\,{{field-1}}\\,x\\,{{field-2}}\\,6,\\,1\\,{{field-3}}\\,y\\,{{field-4}}\\,4\\}\n$$" :question/worked-solution "A point $P(x,y)$ lies *inside* the rectangle if the following conditions are satisfied:\n\n$$\n\\begin{aligned}3<x<6,\\,1<y<4.\\end{aligned}\n$$\n\nNotice that we also need to\n\n- *include* the left edge ($x=3$), and\n\n- *include* the bottom edge ($y=1$).\n\nTherefore, we change the corresponding inequality symbols to non-strict, as follows:\n\n$$\n\\begin{aligned}3\\le x<6,\\,1\\le y<4.\\end{aligned}\n$$\n\nMoreover, since *every* real value in these intervals is included, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3\\le x<6,\\,1\\le y<4\\}.\n$$"}] [{:db/id #edb/ref 17592186374407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7daca75-cb84-525d-be2f-9604ebcf32dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186374409} {:answer/id #uuid "7e791571-9546-5009-bc38-25e83877079d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186374410} {:answer/id #uuid "295b2100-f334-53be-b9fe-d1932f85c458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186374411} {:answer/id #uuid "9164fb18-2d76-5826-96dc-3909bc2e3f16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186374412} {:answer/id #uuid "ead3d9c5-e428-5d92-b348-e8ea96d980e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186374413}] :answer-field/correct {:db/id #edb/ref 17592186374411} :answer-field/id #uuid "6b97a150-262f-5dd7-9bc4-87966d429ca7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374408} {:answer-field/choices [{:answer/id #uuid "be5a308a-017f-5314-a9a1-5ab8ff323996" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186374415} {:answer/id #uuid "68a128eb-22d1-54c2-b694-1d04f74d6d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186374416} {:answer/id #uuid "fbac01d2-efa9-526d-8100-5ae2a3b1e3e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186374417} {:answer/id #uuid "c1785e0b-d077-5a1f-94a3-7d98789e90fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186374418} {:answer/id #uuid "c0a04e0f-2460-5291-9568-7c9e8794d0fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186374419} {:answer/id #uuid "b6d9c0de-0c34-5547-8c21-d8b4a8f9c80a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{2}" :db/id #edb/ref 17592186374420}] :answer-field/correct {:db/id #edb/ref 17592186374418} :answer-field/id #uuid "1454ce89-d759-58c7-a98b-a5b287aac190" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adb62f2e-918d-5d56-973b-da3bc299a8de" :question/math-academy-id "q-181602" :question/problem "![](images/79/79df94546a6fafcd66f8733622e8e9d8c37d29c24cb99378eba141610a8fdc8a.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,x-1\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *below* the line $y=x-1.$ For those points, the following condition is satisfied:\n\n$$\ny<x-1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\le x-1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,y\\le x-1\\}\n$$"}] [{:db/id #edb/ref 17592186374421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e72b7c1-8394-5b02-8036-d7907341035c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186374423} {:answer/id #uuid "a97fd4df-c214-57ee-a27a-65ad9117bd96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186374424} {:answer/id #uuid "005bc6a6-93b5-50ab-b2bc-6551804ffe69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186374425} {:answer/id #uuid "bdddaa7d-a391-58aa-bdbf-7e7e176baaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186374426} {:answer/id #uuid "a3a20af8-0b3b-57a3-a8bf-0892e60b03b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186374427} {:answer/id #uuid "bffad148-085f-53ae-933b-2e18a3d86251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186374428}] :answer-field/correct {:db/id #edb/ref 17592186374423} :answer-field/id #uuid "99228080-aba3-504e-825f-8af6bf7681f6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374422} {:answer-field/choices [{:answer/id #uuid "78320d14-0dc9-5492-bc66-5da56120e6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186374430} {:answer/id #uuid "7af143ec-484b-54a3-8afa-a14793cf5a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186374431} {:answer/id #uuid "4ba487fa-314e-58e8-ba6b-c2e598ee83b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer