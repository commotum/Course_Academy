1}\n$$"}] [{:db/id #edb/ref 17592186287797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b7f378-a574-56ed-ae25-c093122f8ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186284934} {:answer/id #uuid "39f2c0b6-9acb-5eda-8f85-8a654d0f1f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285333} {:answer/id #uuid "4235ac22-609f-52ba-9125-303c9a31bcda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186285400} {:answer/id #uuid "90c8cddd-c93a-5c70-bd38-f1bc2a18b9af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286109} {:answer/id #uuid "cf9cce4a-8178-5205-9b2e-d67cf9c2754d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286675}] :answer-field/correct {:db/id #edb/ref 17592186284934} :answer-field/id #uuid "60ad2ba3-8cfe-5526-aea9-b32e5eb48990" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287353} {:answer-field/choices [{:answer/id #uuid "049fac55-bf43-5afd-a918-fab7eb017b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186284829} {:answer/id #uuid "49c67b2b-620b-5f12-97e8-6c093146e61e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{2}" :db/id #edb/ref 17592186285468} {:answer/id #uuid "a14316c7-6603-5cd5-a273-9db61836f71a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186286260} {:answer/id #uuid "c0a30eb8-26bc-5293-a4cf-5e404eaf301c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "