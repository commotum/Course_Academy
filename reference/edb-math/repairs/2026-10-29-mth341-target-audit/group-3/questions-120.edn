5498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286037}] :answer-field/correct {:db/id #edb/ref 17592186286037} :answer-field/id #uuid "cb0cc407-be95-5a84-a458-d76811518cb8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287567}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8779b713-2ad1-53d1-a3e6-394f41bc52c9" :question/math-academy-id "q-182032" :question/problem "![](images/98/980ae73286ed41ed0c6f074a4bed5b35fa852dd608fb0a1a561f26a7eac60ea7.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,2\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *to the left* the line $x=2.$ For those points, the following condition is satisfied:\n\n$$\nx<2\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\nx<2.\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,x<2\\}\n$$"}] [{:db/id #edb/ref 17592186287954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c051538-a40a-5cbc-8282-8e645475d177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16i+6j" :db/id #edb/ref 17592186285036} {:answer/id #uuid "37605613-4081-584e-9bbc-0ab7008945d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8i+6j" :db/id #edb/ref 17592186285307} {:answer/id #uuid "97aaa877-e8dc-5a6b-8c37-e93b45150992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6j" :db/id #edb/ref 17592186286169} {:answer/id #uuid "b97da330-2f20-5f50-92b7-3dbc00396a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186286476} {:answer/id #uuid "e7a7db3a-d520-5e8e-96ba-69ee0e718642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8i" :db/id #edb/ref 17592186286909}] :answer-field/correct {:db/id #edb/ref 17592186286476} :answer-field/id #uuid "9c450f3c-9024-571e-bb0b-dd413e259582" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287467}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5071b5db-b2c7-5b4f-b394-920acc893dc1" :question/math-academy-id "q-19764" :question/problem "Find $(a+4b)\\times c$, if $a\\times c=8i+2j$ and $b\\times c=-2i+j.$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use distributive property:\n\n$$\n(a+4b)\\times c=a\\times c+(4b)\\times c\n$$\n\n- Next, we factor out the scalars:\n  \n\n$$\na\\times c+(4b)\\times c=a\\times c+4(b\\times c)\n$$\n\n- Finally, we substitute the given values for $a\\times c$ and $b\\times c,$ and simplify:\n\n$$\n\\begin{aligned}a\\times c+4(b\\times c) & =(8i+2j)+4(-2i+j) \\\\  & =8i+2j-8i+4j \\\\  & =6j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e7dc545-c7da-5fc9-a70b-8b7572a60620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6i+32j" :db/id #edb/ref 17592186285061} {:answer/id #uuid "34d5af6c-2bc3-503b-add1-72cb6eaae876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66i+8j" :db/id #edb/ref 17592186285273} {:answer/id #uuid "4714eb99-3c2a-5a20-a917-7eef5d4c2190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36i-8j" :db/id #edb/ref 17592186285444} {:answer/id #uuid "7b7cb3fb-0723-5cc5-9d50-319829e246f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66i+32j" :db/id #edb/ref 17592186285929} {:answer/id #uuid "eeeca519-1f5f-5442-aba4-216a4873eb9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-66i-8j" :db/id #edb/ref 17592186286979}] :answer-field/correct {:db/id #edb/ref 17592186285273} :answer-field/id #uuid "fd0858cb-02f0-5ad6-b987-3086b0dc1bf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287659}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eed27f20-b67a-5b7d-a3c2-a07a46e7e902" :question/math-academy-id "q-19767" :question/problem "Find $(3a-5b)\\times (2c)$, if $a\\times c=6i-2j$ and $b\\times c=-3i-2j.$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use distributive property:\n\n$$\n(3a-5b)\\times (2c)=(3a)\\times (2c)-(5b)\\times (2c)\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}(3a)\\times (2c)-(5b)\\times (2c) & =(3\\cdot 2)(a\\times c)-(5\\cdot 2)(b\\times c) \\\\  & =6(a\\times c)-10(b\\times c)\\end{aligned}\n$$\n\n- Finally, we substitute the given values for $a\\times c$ and $b\\times c,$ and simplify:\n\n$$\n\\begin{aligned}6(a\\times c)-10(b\\times c) & =6(6i-2j)-10(-3i-2j) \\\\  & =36i-12j+30i+20j \\\\  & =66i+8j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323eaa4e-f2e9-5113-9450-8c44caaf1e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6j-3k" :db/id #edb/ref 17592186285244} {:answer/id #uuid "55ac46af-a9d8-59f5-bfee-da66cc48c308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6i-2j" :db/id #edb/ref 17592186285573} {:answer/id #uuid "55b1d06c-1ce0-5af3-b7dd-4c5d790fa7c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9j+6k" :db/id #edb/ref 17592186285576} {:answer/id #uuid "bd7c0cca-930c-5c89-8791-719ae27eff54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9j+2k" :db/id #edb/ref 17592186286521} {:answer/id #uuid "d8e96620-e26e-5aaa-9833-b2c37c9a5d6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9j-6k" :db/id #edb/ref 17592186286764}] :answer-field/correct {:db/id #edb/ref 17592186286764} :answer-field/id #uuid "61f72f43-311c-58f9-af25-6e9606eadcd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287355}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c3e9b2b8-80c6-5b5f-a8f3-154d30b790dd" :question/math-academy-id "q-19777" :question/problem "Find $(2a+3c)\\times (b+2c)$, if $a\\times b=3i-2j+k$, $a\\times c=j-2k$ and $b\\times c=2i-3j.$" :question/worked-solution "First, recall that:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n\\begin{aligned}(2a+3c)\\times (b+2c) &= ((2a)\\times b)+((2a)\\times (2c))+((3c)\\times b)+((3c)\\times (2c))\\end{aligned}\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}((2a)\\times b)+((2a)\\times (2c))+((3c)\\times b)+((3c)\\times (2c)) &= 2(a\\times b)+(2\\cdot 2)(a\\times c)+3(c\\times b)+(3\\cdot 2)(c\\times c) \\\\ &= 2(a\\times b)+4(a\\times c)+3(c\\times b)+6(c\\times c)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $c\\times c=0:$\n\n$$\n\\begin{aligned}2(a\\times b)+4(a\\times c)+3(c\\times b)+6(c\\times c) &= 2(a\\times b)+4(a\\times c)-3(b\\times c)+6(0) \\\\ &= 2(a\\times b)+4(a\\times c)-3(b\\times c)\\end{aligned}\n$$\n\n- Finally, we substitute the given values and simplify:\n\n$$\n\\begin{aligned}2(a\\times b)+4(a\\times c)-3(b\\times c) &= 2(3i-2j+k)+4(j-2k)-3(2i-3j) \\\\ &= (6i-4j+2k)+(4j-8k)-(6i-9j) \\\\ &= (6i-6i)+(-4j+4j+9j)+(2k-8k) \\\\ &= 9j-6k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c94236-9a9d-5f33-bc42-c13f3f3d00da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-j+6k" :db/id #edb/ref 17592186288241} {:answer/id #uuid "782c00ee-c3ed-5215-8945-490b1d847461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3i-6j+3k" :db/id #edb/ref 17592186288860} {:answer/id #uuid "8511b2c3-3a1e-5a91-a8c1-2e4b0c95b42e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3i+6j-k" :db/id #edb/ref 17592186288925} {:answer/id #uuid "d8462a2f-c8d3-51af-9bb3-9e0b9ea4371c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3i-9j+6k" :db/id #edb/ref 17592186289473} {:answer/id #uuid "f0b87c52-4e18-5d4e-9886-3a0c1708e990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i+3j-3k" :db/id #edb/ref 17592186289623}] :answer-field/correct {:db/id #edb/ref 17592186288860} :answer-field/id #uuid "28bfefd3-5294-5674-b5e8-734bef14e9da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289825}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0f3ebcb-819b-5060-93c1-2a4bba4f43b1" :question/math-academy-id "q-216349" :question/problem "Find $a\\times (2a+3b)$, if $b\\times a=-i+2j-k.$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\na\\times (2a+3b)=a\\times (2a)+a\\times (3b)\n$$\n\n- Next, we factor out the scalars:\n\n$$\na\\times (2a)+a\\times (3b)=2(a\\times a)+3(a\\times b)\n$$\n\n- Then, we use anticommutativity, and the fact that $a\\times a=0:$\n\n$$\n\\begin{aligned}2(a\\times a)+3(a\\times b) & =2(0)+3(-b\\times a) \\\\  & =-3(b\\times a)\\end{aligned}\n$$\n\n- Substitute the given value for $b\\times a$ and simplify:\n\n$$\n\\begin{aligned}-3(b\\times a) & =-3(-i+2j-k) \\\\  & =3i-6j+3k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe71f984-f5ae-55f3-b0e6-099813d36647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291719}] :answer-field/correct {:db/id #edb/ref 17592186291719} :answer-field/id #uuid "3c4c9fa4-f866-5182-af47-5c3bf4d0a036" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291939} {:answer-field/choices [{:answer/id #uuid "c3ee84e3-a60f-5940-9c13-48bee865040e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291474}] :answer-field/correct {:db/id #edb/ref 17592186291474} :answer-field/id #uuid "dbc1ae46-a5cd-5192-9202-e58d5b3566c1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292418}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64a063c4-201d-50ad-960d-a431962b0bcf" :question/math-academy-id "q-275297" :question/problem "Let $a\\times c=3i+j$ and $b\\times c=2i+2j.$ Find $(4a-3b)\\times c.$\n\n$(4a-3b)\\times c=$\n{{field-1}}\n$i\\,\\,-$\n{{field-2}}\n$j$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n(4a-3b)\\times c=(4a)\\times c-(3b)\\times c\n$$\n\n- Next, we factor out the scalars:\n\n$$\n(4a)\\times c-(3b)\\times c=4(a\\times c)-3(b\\times c)\n$$\n\n- Finally, we substitute the given values for $a\\times c$ and $b\\times c,$ and simplify:\n\n$$\n\\begin{aligned}4(a\\times c)-3(b\\times c) & =4(3i+j)-3(2i+2j) \\\\  & =12i+4j-6i-6j \\\\  & =6\\,i-2\\,j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64828e5f-4306-556c-b4d4-f75d3c0c3e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186291061}] :answer-field/correct {:db/id #edb/ref 17592186291061} :answer-field/id #uuid "66cd32eb-214b-5be2-ac7c-29bbe42f6acb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292048} {:answer-field/choices [{:answer/id #uuid "fa63b121-7064-5f61-b473-0c70c6222ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186291691}] :answer-field/correct {:db/id #edb/ref 17592186291691} :answer-field/id #uuid "710db14c-7c10-5be3-b475-93b81c384119" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48383069-88ac-53ba-a18f-1b9e7ee17931" :question/math-academy-id "q-275301" :question/problem "Let $a\\times c=2i-j$ and $b\\times c=-4i+3j.$ Find $(6a-5b)\\times (2c).$\n\n$(6a-5b)\\times (2c)=$\n{{field-1}}\n$i\\,\\,-$\n{{field-2}}\n$j$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n(6a-5b)\\times (2c)=(6a)\\times (2c)-(5b)\\times (2c)\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}(6a)\\times (2c)-(5b)\\times (2c) & =(6\\cdot 2)(a\\times c)-(5\\cdot 2)(b\\times c) \\\\  & =12(a\\times c)-10(b\\times c)\\end{aligned}\n$$\n\n- Finally, we substitute the given values for $a\\times c$ and $b\\times c,$ and simplify:\n\n$$\n\\begin{aligned}12(a\\times c)-10(b\\times c) & =12(2i-j)-10(-4i+3j) \\\\  & =24i-12j+40i-30j \\\\  & =64\\,i-42\\,j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d747faa-f10d-5d9e-a71b-4e0dcabb202f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293310}] :answer-field/correct {:db/id #edb/ref 17592186293310} :answer-field/id #uuid "116f6206-9ad5-5ad8-9293-e4685a797081" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293979}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77730a53-5e90-5c0a-a69e-20df2d022292" :question/math-academy-id "q-280351" :question/problem "Let $c\\times a=3i-2j$ and $c\\times b=4i+j.$ Find $c\\times (a+2b).$\n\n$c\\times (a+2b)=$\n{{field-1}}\n$i$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\nc\\times (a+2b)=c\\times a+c\\times (2b)\n$$\n\n- Next, we factor out the scalars:\n\n$$\nc\\times a+c\\times (2b)=c\\times a+2(c\\times b)\n$$\n\n- Finally, we substitute the given values for $c\\times a$ and $c\\times b,$ and simplify:\n\n$$\n\\begin{aligned}c\\times a+2(c\\times b) & =(3i-2j)+2(4i+j) \\\\  & =3i-2j+8i+2j \\\\  & =11\\,i\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60f713ee-562b-5f44-b1c4-ed314da95ff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293327}] :answer-field/correct {:db/id #edb/ref 17592186293327} :answer-field/id #uuid "0a934969-cd9b-525f-a196-81524f11dadd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293959} {:answer-field/choices [{:answer/id #uuid "efba8181-f2dd-5023-9ff6-a8bc7b4fa919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293862}] :answer-field/correct {:db/id #edb/ref 17592186293862} :answer-field/id #uuid "3b0cede7-c17d-57c7-9603-05e8367080e9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294134} {:answer-field/choices [{:answer/id #uuid "8f858b82-03bc-50d1-9bdd-56ea551953f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293491}] :answer-field/correct {:db/id #edb/ref 17592186293491} :answer-field/id #uuid "b0a6e860-81c5-5811-b299-c67d1881e201" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34251e9f-6d6e-5593-b05c-d3a2ed14c7e5" :question/math-academy-id "q-280381" :question/problem "Let $b\\times a=⟨6,0,-3⟩.$ Find $a\\times (3a-2b).$\n\n$a\\times (3a-2b)=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\na\\times (3a-2b)=a\\times (3a)-a\\times (2b)\n$$\n\n- Next, we factor out the scalars:\n\n$$\na\\times (3a)-a\\times (2b)=3(a\\times a)-2(a\\times b)\n$$\n\n- Then, we use the anticommutativity property and the fact that $a\\times a=0:$\n\n$$\n\\begin{aligned}3(a\\times a)-2(a\\times b) & =3(0)-2(-b\\times a) \\\\  & =2(b\\times a)\\end{aligned}\n$$\n\n- Substitute the given value for $b\\times a$ and simplify:\n\n$$\n\\begin{aligned}2(b\\times a) & =2⟨6,0,-3⟩ \\\\  & =⟨12,0,-6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "944a35bf-f9bc-5529-9597-3ffa66122071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293514}] :answer-field/correct {:db/id #edb/ref 17592186293514} :answer-field/id #uuid "58ae4f1f-72c0-5a5b-be06-f1b4b8603e50" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294246} {:answer-field/choices [{:answer/id #uuid "34ecca97-c96f-5c98-a47b-ed463d45a48d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293155}] :answer-field/correct {:db/id #edb/ref 17592186293155} :answer-field/id #uuid "a07417ae-4493-5d64-a14e-e201f33861c9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294510} {:answer-field/choices [{:answer/id #uuid "7a0ee8cc-e034-5bde-a3d7-236a384bd30a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186293423}] :answer-field/correct {:db/id #edb/ref 17592186293423} :answer-field/id #uuid "ace150d5-1104-55c2-b348-f212e7d3beb4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b5ecce5-4519-5318-90df-e9ee9bf806a2" :question/math-academy-id "q-280385" :question/problem "Let $b\\times a=2i-j+4k.$ Find $a\\times (b-3a).$\n\n$a\\times (b-3a)=$\n{{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j\\,\\,+$\n{{field-3}}\n$k$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\na\\times (b-3a)=a\\times b-a\\times (3a)\n$$\n\n- Next, we factor out the scalars:\n\n$$\na\\times b-a\\times (3a)=a\\times b-3(a\\times a)\n$$\n\n- Then, we use the anticommutativity property and the fact that $a\\times a=0:$\n\n$$\n\\begin{aligned}a\\times b-3(a\\times a) & =-b\\times a-3(0) \\\\  & =-b\\times a\\end{aligned}\n$$\n\n- Substitute the given value for $b\\times a$ and simplify:\n\n$$\n\\begin{aligned}-b\\times a & =-(2i-j+4k) \\\\  & =-2i+1j+-4k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9cb137e-c9c2-5820-aae3-7e812adcddd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186293655}] :answer-field/correct {:db/id #edb/ref 17592186293655} :answer-field/id #uuid "420bfb9e-282c-5718-9b84-9f9768d8ef08" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294160} {:answer-field/choices [{:answer/id #uuid "507e82a8-e7b0-58a4-8d68-aa3bb02b19f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186293261}] :answer-field/correct {:db/id #edb/ref 17592186293261} :answer-field/id #uuid "66204788-d2d8-59e8-b96e-91e37b43256b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294287} {:answer-field/choices [{:answer/id #uuid "3fdb7254-f211-5a76-b1c0-7ae13e8d0356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293189}] :answer-field/correct {:db/id #edb/ref 17592186293189} :answer-field/id #uuid "dceafa30-d75b-56de-b70d-ef75698f7c2d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e746ff9c-9f50-594b-8773-1ffdd380a3c1" :question/math-academy-id "q-280834" :question/problem "Let $a\\times b=⟨2,-5,-1⟩.$ Find $6b\\times (2a-b).$\n\n$6b\\times (2a-b)=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "First, we recall the following properties of the cross product:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n6b\\times (2a-b)=(6b)\\times (2a)-(6b)\\times b\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}(6b)\\times (2a)-(6b)\\times b & =(6\\cdot 2)(b\\times a)-6(b\\times b) \\\\  & =12(b\\times a)-6(b\\times b)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $b\\times b=0:$\n\n$$\n\\begin{aligned}12(b\\times a)-6(b\\times b) & =12(-a\\times b)-6(0) \\\\  & =-12(a\\times b)\\end{aligned}\n$$\n\n- Substitute the given value for $a\\times b$ and simplify:\n\n$$\n\\begin{aligned}-12(a\\times b) & =-12⟨2,-5,-1⟩ \\\\  & =⟨-24,60,12⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "322bdd40-a89d-54b3-81d8-8151235b82d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186300210}] :answer-field/correct {:db/id #edb/ref 17592186300210} :answer-field/id #uuid "1a2cde90-cae5-5b84-89e4-e24f91f327d4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301309} {:answer-field/choices [{:answer/id #uuid "49081e49-39e7-597d-9ecf-6118251f8fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186300334}] :answer-field/correct {:db/id #edb/ref 17592186300334} :answer-field/id #uuid "5a2ca30b-bdbd-5eac-ae60-bf6ac951e1d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301524} {:answer-field/choices [{:answer/id #uuid "1245995a-f65b-5c93-81c2-48beb67e35a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186300036}] :answer-field/correct {:db/id #edb/ref 17592186300036} :answer-field/id #uuid "d95ac3b6-903b-59a8-b8db-2d80e9e15a1a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301926}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7278c5e-97e4-5ded-971c-857a998455ed" :question/math-academy-id "q-326312" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,2,4)$ and is parallel to the vectors ${v}_{1}=⟨1,-2,-5⟩$ and ${v}_{2}=⟨0,1,-7⟩.$\n\n{{field-1}}\n$x\\,+$\n{{field-2}}\n$y+z\\,+$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-3,2,4⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}1 \\\\ -2 \\\\ -5\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 1 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & -2 & -5 \\\\ 0 & 1 & -7\\end{vmatrix} \\\\  & =19i+7j+k \\\\  & =⟨19,7,1⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨19,7,1⟩ & =⟨-3,2,4⟩\\cdot ⟨19,7,1⟩ \\\\ r\\cdot ⟨19,7,1⟩ & =-39\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨19,7,1⟩ & =-39 \\\\ 19x+7y+z & =-39 \\\\ 19x+7y+z+39 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e8d53b-177d-5796-8cf7-52c015fc02a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300384}] :answer-field/correct {:db/id #edb/ref 17592186300384} :answer-field/id #uuid "11b7d2ed-536b-5849-8e7d-54f3dbfbb735" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301284} {:answer-field/choices [{:answer/id #uuid "8de30fa2-0c67-5646-bab5-d1acac95ffaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300681}] :answer-field/correct {:db/id #edb/ref 17592186300681} :answer-field/id #uuid "2eae7c05-5e89-5f2f-b6dd-83424a9cf5ce" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301372} {:answer-field/choices [{:answer/id #uuid "27084236-e409-5976-ba9d-d171f96debd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300148}] :answer-field/correct {:db/id #edb/ref 17592186300148} :answer-field/id #uuid "6d7b439f-d927-5a9b-940c-4e51f8e79127" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301567}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8f8613f-ede8-5b23-9e9a-6a90b747b545" :question/math-academy-id "q-326901" :question/problem "Given the Cartesian equation $2x-y+2z+6=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$ \n{{field-1}}\n$⟩)\\cdot ⟨2,$\n{{field-2}}\n, \n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨2,-1,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}2x-y+2z+6 & =0 \\\\ z & =-x+\\frac{y}{2}-3.\\end{aligned}\n$$\n\nIf we put $x=0$ and $y=0$, we get $z=-3.$ Hence, the point $P(0,0,-3)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-3⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-3⟩)\\cdot ⟨2,-1,2⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa5c8f6-bf83-5bd8-9bb3-80811ef65a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix}=-9" :db/id #edb/ref 17592186302631} {:answer/id #uuid "407d1ed1-6ab5-5fde-b2e9-9ef394359c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}=-9" :db/id #edb/ref 17592186302860} {:answer/id #uuid "42cce788-2ef2-5bc9-89b5-61bb8342b033" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186302878} {:answer/id #uuid "4a24ce80-8c12-5476-97ef-85e573270172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186302924} {:answer/id #uuid "a92599b3-9f56-5635-b79f-2c71088e3569" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}=-5" :db/id #edb/ref 17592186303499}] :answer-field/correct {:db/id #edb/ref 17592186302631} :answer-field/id #uuid "6581d869-7e78-5398-89d1-33179a6e2c3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304351}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62f6f273-804e-559c-a53a-0d8f68234b8d" :question/math-academy-id "q-33027" :question/problem "Find an equation of the plane that contains the point $Q(1,2,-1)$ and is perpendicular to the vector $n=\\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "First, note that the position vector of $Q$ is $q=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}$ and $n=\\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix}$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have \n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot \\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix} \\\\ r\\cdot \\begin{bmatrix}2 \\\\ -4 \\\\ 3\\end{bmatrix} & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "557e38a7-a029-588d-bfe3-065970b42e29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (i-\\sqrt{3}j+4k)=8i+\\sqrt{27}j" :db/id #edb/ref 17592186302983} {:answer/id #uuid "7b5e4122-6bcd-5d0f-81a6-b8727f7f80bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (i-\\sqrt{3}j+4k)=1" :db/id #edb/ref 17592186303218} {:answer/id #uuid "dcdc9b30-9726-5982-8b3e-a81f38639057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (8i+\\sqrt{27}j)=i-\\sqrt{3}j+4k" :db/id #edb/ref 17592186303836} {:answer/id #uuid "f1d19671-a68e-5384-b817-7d3c1d7cbc20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (8i+\\sqrt{27}j)=-1" :db/id #edb/ref 17592186303975} {:answer/id #uuid "fc41c2f2-2231-5ddb-adb6-644582d77c1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (8i+\\sqrt{27}j)=8-\\sqrt{3}" :db/id #edb/ref 17592186304038}] :answer-field/correct {:db/id #edb/ref 17592186303975} :answer-field/id #uuid "39ef42cb-e415-5101-9065-d75c9c30b48d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304232}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd3baba0-1430-5e29-b123-dd1e840723b6" :question/math-academy-id "q-33035" :question/problem "Find an equation of the plane that contains the point  $P(1,-\\sqrt{3},4)$ and is perpendicular to the vector $n=8i+\\sqrt{27}j.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=i-\\sqrt{3}j+4k$ and $n=8i+\\sqrt{27}j$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as \n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (8i+\\sqrt{27}j) & =(i-\\sqrt{3}j+4k)\\cdot (8i+\\sqrt{27}j) \\\\ r\\cdot (8i+\\sqrt{27}j) & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "130cc39a-be42-573b-a075-ac851c6972af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y-5z-26=0" :db/id #edb/ref 17592186302583} {:answer/id #uuid "16d9f5a1-4e5b-50a7-b3de-bbee67b28acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+y-5z+26=0" :db/id #edb/ref 17592186302604} {:answer/id #uuid "7d2796d6-1a82-5d74-a36f-0f34e5ab333d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y-5z+26=0" :db/id #edb/ref 17592186303238} {:answer/id #uuid "a6ad4e61-3414-5129-9cff-739a6125e65b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y-5z+24=0" :db/id #edb/ref 17592186303480} {:answer/id #uuid "d55212d8-f2ba-5bb1-a14c-962080164544" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y+5z+26=0" :db/id #edb/ref 17592186303777}] :answer-field/correct {:db/id #edb/ref 17592186303238} :answer-field/id #uuid "2ff8b302-c015-5365-8e07-707e1112c9ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00e129f5-c1b2-5333-8f70-babdfeae2e75" :question/math-academy-id "q-330498" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-2,4)$ and is perpendicular to the vector $n=⟨0,3,-5⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨1,-2,4⟩$ and the normal vector of the plane is $n=⟨0,3,-5⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,3,-5⟩ & =⟨1,-2,4⟩\\cdot ⟨0,3,-5⟩ \\\\ r\\cdot ⟨0,3,-5⟩ & =-26\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,3,-5⟩ & =-26 \\\\ 3y-5z & =-26 \\\\ 3y-5z+26 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0069db2e-d01f-5ba7-85d5-c68688366845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x-2y+z-10=0" :db/id #edb/ref 17592186302448} {:answer/id #uuid "11b6d126-fa6c-56bc-9471-56192788fff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-6y-10=0" :db/id #edb/ref 17592186302572} {:answer/id #uuid "778cf533-1371-59ce-bb1d-6d0eb998dcc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x-2y-10=0" :db/id #edb/ref 17592186303194} {:answer/id #uuid "921363dd-3390-59eb-8778-51139591f588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x-y-10z=0" :db/id #edb/ref 17592186303363} {:answer/id #uuid "c92e6fbe-a6b2-5db7-9900-beeb71e27342" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+y-10=0" :db/id #edb/ref 17592186303690}] :answer-field/correct {:db/id #edb/ref 17592186303194} :answer-field/id #uuid "2cd57c0c-5e4f-5559-b558-81cf8cdec69d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03f5292d-2cbb-5362-966c-d91bc52e2d79" :question/math-academy-id "q-330500" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,1,-5)$ and is perpendicular to the vector $n=⟨6,-2,0⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨2,1,-5⟩$ and the normal vector of the plane is $n=⟨6,-2,0⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨6,-2,0⟩ & =⟨2,1,-5⟩\\cdot ⟨6,-2,0⟩ \\\\ r\\cdot ⟨6,-2,0⟩ & =10\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨6,-2,0⟩ & =10 \\\\ 6x-2y & =10 \\\\ 6x-2y-10 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144a3f0e-e55f-5127-8aba-d54af0f7928f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y-z-18=0" :db/id #edb/ref 17592186302589} {:answer/id #uuid "3fd6d560-4786-54eb-abee-b673f3be01d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-3z-13=0" :db/id #edb/ref 17592186302857} {:answer/id #uuid "5d279caa-dcf7-5550-96a4-a74ca0a84887" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+4y-z-13=0" :db/id #edb/ref 17592186303024} {:answer/id #uuid "90379d74-6d2d-545b-ace3-86b0b2a1b6c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+y-3z-13=0" :db/id #edb/ref 17592186303357} {:answer/id #uuid "fa35067d-2265-5860-b10f-4d3a826a567a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+4y+z+5=0" :db/id #edb/ref 17592186304025}] :answer-field/correct {:db/id #edb/ref 17592186303024} :answer-field/id #uuid "de959850-4f0a-51e6-ac9c-e23d617a73d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "972806e5-5276-519b-b09e-86229dab2cf0" :question/math-academy-id "q-33067" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(5,0,-3)$ and is perpendicular to the vector $n=⟨2,4,-1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨5,0,-3⟩$ and the normal vector of the plane is $n=⟨2,4,-1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,4,-1⟩ & =⟨5,0,-3⟩\\cdot ⟨2,4,-1⟩ \\\\ r\\cdot ⟨2,4,-1⟩ & =13.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,4,-1⟩ & =13 \\\\ 2x+4y-z & =13 \\\\ 2x+4y-z-13 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c83cada-a7ac-5af2-892c-a9cbb2d4e096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186302640} {:answer/id #uuid "6643e321-34e5-5982-97b1-032e34e1a9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303075} {:answer/id #uuid "76f316c8-4e2e-509f-a399-e27fb58b0ebe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,-3,2⟩+s⟨-6,3,2⟩+t⟨4,2,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303190} {:answer/id #uuid "bd31cd36-15b6-5f2c-915c-50465bc1d3d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,2,-1⟩+s⟨-6,3,2⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303616} {:answer/id #uuid "df5d9419-53c8-5bb3-bf95-641fe61245d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-6,3,2⟩+s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303857}] :answer-field/correct {:db/id #edb/ref 17592186303857} :answer-field/id #uuid "84072f13-460d-5fb0-8df2-14c89ef08313" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304434}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9271c80c-c992-52e7-8ded-e69bd152c1f5" :question/math-academy-id "q-33133" :question/problem "Find a parametric equation of the plane that passes through the point $D(-6,3,2)$ and is parallel to the vectors ${v}_{1}=⟨4,2,-1⟩$  and ${v}_{2}=⟨4,-3,2⟩.$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $D$ is $p=⟨-6,3,2⟩$ and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=⟨4,2,-1⟩$  and ${v}_{2}=⟨4,-3,2⟩.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=⟨-6,3,2⟩+s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186304912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458b8eb5-3b29-5924-902c-d3cffef6a6de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15x-8y-3z-67=0" :db/id #edb/ref 17592186302895} {:answer/id #uuid "88dc538f-e6c9-5c6f-808b-34c2e95ebb30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+y-67=0" :db/id #edb/ref 17592186303309} {:answer/id #uuid "bd1bdbf0-be7f-5cf7-818b-98633141df5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-2y+3z=0" :db/id #edb/ref 17592186303615} {:answer/id #uuid "d7a0a96f-703b-50f9-a5c7-b2bec60c5f8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-5y+z-70=0" :db/id #edb/ref 17592186303802} {:answer/id #uuid "fba3cc98-79bd-550c-ab66-3b016a6a9822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15x-8y-3z+70=0" :db/id #edb/ref 17592186304035}] :answer-field/correct {:db/id #edb/ref 17592186302895} :answer-field/id #uuid "ff2ba7ba-1383-50ad-b6f1-05fe844c3868" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304763}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0886b819-4519-5617-bf4c-2f8309f1feb4" :question/math-academy-id "q-33142" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(2,-5,1)$, $P(4,-2,3)$ and $Q(5,1,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨2,-5,1⟩,\\,p=⟨4,-2,3⟩,$ and $q=⟨5,1,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨4,-2,3⟩-⟨2,-5,1⟩ \\\\  & =⟨2,3,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨5,1,0⟩-⟨2,-5,1⟩ \\\\  & =⟨3,6,-1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 3 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & 2 \\\\ 3 & 6 & -1\\end{vmatrix} \\\\  & =-15i+8j+3k \\\\  & =⟨-15,8,3⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-15,8,3⟩ & =⟨4,-2,3⟩\\cdot ⟨-15,8,3⟩ \\\\ r\\cdot ⟨-15,8,3⟩ & =-67\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-15,8,3⟩ & =-67 \\\\ -15x+8y+3z & =-67 \\\\ -15x+8y+3z+67 & =0 \\\\ 15x-8y-3z-67 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336bb496-d1df-5e9a-a07a-1ec951355ede" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186302774} {:answer/id #uuid "8e8dad69-2acf-5472-9a3f-505a95ac3fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-2,-2,-2⟩+s⟨1,4,-14⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303341} {:answer/id #uuid "b208b020-2e95-5012-90d1-880d0704ce1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨-2,-2,-2⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303557} {:answer/id #uuid "d3a6125d-748b-50ac-93e6-06be995d0638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨0,3,-19⟩+s⟨-2,-2,-2⟩+t⟨1,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303769} {:answer/id #uuid "feb8b07e-b16f-57b2-afdf-a8e6076cfea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186304058}] :answer-field/correct {:db/id #edb/ref 17592186304058} :answer-field/id #uuid "3a308e92-1035-59ed-9244-1f44706e0efe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304233}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "133e1de3-de48-5298-8948-a57726f1d155" :question/math-academy-id "q-33160" :question/problem "Find a parametric equation of the plane that passes through the point $C(1,4,-14)$ and is parallel to the two distinct lines $r=⟨-1,5,7⟩+s⟨1,1,1⟩$ and $r=⟨0,3,-19⟩+t⟨-2,-2,-2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-2,-2,-2⟩$ and ${v}_{2}=⟨1,1,1⟩,$ respectively.\nBut ${v}_{2}=-2{v}_{1}.$ So, our lines are parallel. \n\nDespite this fact, two distinct parallel lines still determine a plane. Now: \n\n- from the equation of the first line, we get the point $P$ with the position vector $p=⟨-1,5,7⟩$ that lies on it, and\n\n- from the equation of the second line, we get the point $Q$ with the position vector $q=⟨0,3,-19⟩$ that lies on it.\n\nThe vector $u=q-p$ will be parallel to the required plane. \n\nComputing the coordinates of $u,$  we obtain\n\n$$\n\\begin{aligned}u & =q-p \\\\  & =⟨0,3,-19⟩-⟨-1,5,7⟩ \\\\  & =⟨1,-2,-26⟩\\end{aligned}\n$$\n\nFinally, since $\\overset{\\to }{PQ}∦{v}_{1},$ we can find the equation of our plane.\n\nWe know that the point $C(1,4,-14)$ lies on the plane and its position vector is $c=⟨1,4,-14⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =c+s{v}_{1}+tu \\\\ r & =⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280d2e89-c3f5-5191-859c-002f7d1d6dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-5y+z+1=0" :db/id #edb/ref 17592186302715} {:answer/id #uuid "3537ab24-c238-5848-8ae5-5ed96c1361f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x+4z+1=0" :db/id #edb/ref 17592186302787} {:answer/id #uuid "6d2e1a28-b548-5422-a0a4-3c14076cccdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x+y+4z-1=0" :db/id #edb/ref 17592186303120} {:answer/id #uuid "9d1c65af-d3a6-51b9-87f0-3dcea485d3fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-5y+2z+1=0" :db/id #edb/ref 17592186303435} {:answer/id #uuid "f689b81d-7063-5e1e-9aaf-49529b0a36a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x+3y+2z+1=0" :db/id #edb/ref 17592186304004}] :answer-field/correct {:db/id #edb/ref 17592186303435} :answer-field/id #uuid "b8f97666-3ba0-509b-8f76-1eba3f70428a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6438ac3c-8420-5b05-be4d-39c722849ed1" :question/math-academy-id "q-33162" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,0,4)$ and is perpendicular to the line \n$$\n\\displaystyle r=\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -5 \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨-3,0,4⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨3,-5,2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨3,-5,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-5,2⟩ & =⟨-3,0,4⟩\\cdot ⟨3,-5,2⟩ \\\\ r\\cdot ⟨3,-5,2⟩ & =-1.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-5,2⟩ & =-1 \\\\ 3x-5y+2z & =-1 \\\\ 3x-5y+2z+1 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab53ccfc-64b7-524d-968b-6893b62213d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y-8z-7=0" :db/id #edb/ref 17592186303511} {:answer/id #uuid "dc7eaa38-3a98-5e4b-a287-9986a7293e04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y-8z-17=0" :db/id #edb/ref 17592186303832} {:answer/id #uuid "e6861164-b0cf-5ba0-aa1b-6cd1763beb2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x+3y-7=0" :db/id #edb/ref 17592186303889} {:answer/id #uuid "ea20f4fb-c33f-5d07-9c45-30c73baa36d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x+3y+z+7=0" :db/id #edb/ref 17592186303918} {:answer/id #uuid "eaa011ee-143b-5ae4-8126-4b8c02ada24f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y-8z-1=0" :db/id #edb/ref 17592186303920}] :answer-field/correct {:db/id #edb/ref 17592186303511} :answer-field/id #uuid "c8d1946d-38c1-56f9-8702-9b5223a6e94e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304623}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e8a4061-bb52-5786-a928-eac2a59e8597" :question/math-academy-id "q-33164" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-4,3,0)$ and is perpendicular to the vector $n=2i+5j-8k.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-4,3,0⟩$ and the normal vector of the plane is $n=⟨2,5,-8⟩.$\n\nUsing the dot product we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,5,-8⟩ & =⟨-4,3,0⟩\\cdot ⟨2,5,-8⟩ \\\\ r\\cdot ⟨2,5,-8⟩ & =7.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,5,-8⟩ & =7 \\\\ 2x+5y-8z & =7 \\\\ 2x+5y-8z-7 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e83df31-2c2f-5620-ba52-0af831585f03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,2,3⟩=16" :db/id #edb/ref 17592186305915} {:answer/id #uuid "56e9dbad-4aa4-533d-963c-c3233bd4192a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,3,3⟩=4" :db/id #edb/ref 17592186305992} {:answer/id #uuid "86d531b8-9f38-5a61-8811-e6860c0e2231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,2,2⟩=16" :db/id #edb/ref 17592186306437} {:answer/id #uuid "a040c800-92fb-5a68-91ae-9da594b3ac2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,3,3⟩=⟨3,2,2⟩" :db/id #edb/ref 17592186306653} {:answer/id #uuid "b1d1abf3-2fea-56e2-9c26-19018c03d820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,3,2⟩=4" :db/id #edb/ref 17592186306821}] :answer-field/correct {:db/id #edb/ref 17592186305915} :answer-field/id #uuid "64233505-d022-52c2-927b-67cce1279a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307839}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "641cc290-5f71-543f-a832-4e80117c9730" :question/math-academy-id "q-33312" :question/problem "Find an equation of the plane that contains the point $Q(3,2,2)$ and is perpendicular to the vector $n=⟨2,2,3⟩.$" :question/worked-solution "First, notice that the position vector of $Q$ is $q=⟨3,2,2⟩,$ $n=⟨2,2,3⟩$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨2,2,3⟩ & =⟨3,2,2⟩\\cdot ⟨2,2,3⟩ \\\\ r\\cdot ⟨2,2,3⟩ & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be2860e-76f3-5d9d-bf88-ce7854d1a186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186305571} {:answer/id #uuid "6c6f1eb0-ee64-514d-98de-d34d9b44314a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186306190} {:answer/id #uuid "7b28870c-c686-56de-8301-a1d3a6669a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186306326} {:answer/id #uuid "7b563320-dadf-52e8-ae03-48cf4482b401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306330} {:answer/id #uuid "e06638bf-2fdd-5ef3-8ff6-f99f8daca96b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186307227}] :answer-field/correct {:db/id #edb/ref 17592186305571} :answer-field/id #uuid "f682525d-3133-53f0-ba43-839c46ba42eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a973cbbd-df7e-5f41-a87c-5c205b31db4a" :question/math-academy-id "q-33313" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨4,0,2⟩=16.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨4,0,2⟩=16$ of the plane, we get the normal vector $n=⟨4,0,2⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨4,0,2⟩ & =0 \\\\ 4{t}_{1}+2{t}_{3} & =0 \\\\ 2{t}_{3} & =-4{t}_{1} \\\\ {t}_{3} & =-2{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,-2{t}_{1}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,0,\\,-2⟩.\n$$\n\nTherefore, $\\frac{a}{c}=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186308399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166ef2d2-32f9-5566-82ce-7cdba329c024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,5,-1⟩=0" :db/id #edb/ref 17592186305351} {:answer/id #uuid "2d1369ba-d6af-518c-9a18-2bcb2250fd78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,5,-1⟩=-23" :db/id #edb/ref 17592186305582} {:answer/id #uuid "60c376f1-f147-5aa7-8c7c-ae55262553b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,5,-1⟩=⟨1,-4,2⟩" :db/id #edb/ref 17592186306084} {:answer/id #uuid "872e10d1-c31a-5bdc-a18f-00aeaf508a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-4,2⟩=⟨-1,5,-1⟩" :db/id #edb/ref 17592186306439} {:answer/id #uuid "d788f251-5e9e-56e8-8b45-aa84f1099d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-4,2⟩=-23" :db/id #edb/ref 17592186307146}] :answer-field/correct {:db/id #edb/ref 17592186305582} :answer-field/id #uuid "8fc16c6a-1a25-557e-b7df-b3323cb169a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307974}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4553242a-e32b-5422-9dd6-251f47f5a320" :question/math-academy-id "q-33317" :question/problem "Find an equation of the plane that passes through the point $Q(1,-4,2)$ and is perpendicular to the line that goes through the points \n$A(2,1,-3)$ and $B(1,6,-4).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨1,-4,2⟩.$\n\nSince the line  passes through the points $A(2,1,-3)$ and $B(1,6,-4)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,6,-4⟩-⟨2,1,-3⟩ \\\\  & =⟨-1,5,-1⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨-1,5,-1⟩.$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-1,5,-1⟩ & =⟨1,-4,2⟩\\cdot ⟨-1,5,-1⟩ \\\\ r\\cdot ⟨-1,5,-1⟩ & =-23.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aef8723-641e-516c-8c4a-a5d5de549a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (5i+2j+3k)=25" :db/id #edb/ref 17592186305710} {:answer/id #uuid "9813abc0-1700-54c0-9c07-5981bf1e93ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (5i+2j+3k)=52" :db/id #edb/ref 17592186306578} {:answer/id #uuid "ba6412aa-de58-53f9-bd92-3970bea844c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (6i+5j+4k)=5i" :db/id #edb/ref 17592186306890} {:answer/id #uuid "d3ef5d7c-8f43-5fb9-88cc-0e631dbc7945" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (6i+5j+4k)=52" :db/id #edb/ref 17592186307114} {:answer/id #uuid "d401246f-9f18-5c5b-9df7-2bc112841ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot (6i+5j+4k)=0" :db/id #edb/ref 17592186307117}] :answer-field/correct {:db/id #edb/ref 17592186307114} :answer-field/id #uuid "d63df9bb-7280-5cd8-aee8-407814fcba8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc9756ae-93f4-5e8e-b7df-21ca51316b9d" :question/math-academy-id "q-33322" :question/problem "Find an equation of the plane that contains the point  $Q(5,2,3)$ and is perpendicular to the vector $n=6i+5j+4k.$" :question/worked-solution "First, notice that the position vector of $Q$ is $q=5i+2j+3k$ and $n=6i+5j+4k$ is normal to the plane. \n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot (6i+5j+4k) & =(5i+2j+3k)\\cdot (6i+5j+4k) \\\\ r\\cdot (6i+5j+4k) & =52.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ebcc58c-3918-5971-8319-5cd009e22c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186308850}] :answer-field/correct {:db/id #edb/ref 17592186308850} :answer-field/id #uuid "00949ed5-4f72-5085-865e-8ff2e6b32aa5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310793} {:answer-field/choices [{:answer/id #uuid "8b488120-28cf-5e4a-b809-5c7970270675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309843}] :answer-field/correct {:db/id #edb/ref 17592186309843} :answer-field/id #uuid "b1ba0da6-c9b8-5145-b089-e43a8228fd9d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311311} {:answer-field/choices [{:answer/id #uuid "f4ff3f1c-912d-5bd4-aad4-c46e4201501d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310696}] :answer-field/correct {:db/id #edb/ref 17592186310696} :answer-field/id #uuid "ddac13c1-1e39-5170-8def-6350cdacd6d6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da280df0-7d7a-5d86-8e85-f52e5903aba5" :question/math-academy-id "q-336110" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-2,5)$ and is perpendicular to the line \n$$\n\\displaystyle \\left\\{\\begin{aligned}x &=4+3t \\\\ y &=1-4t \\\\ z &=-3-2t\\end{aligned}\\right..\n$$\n\n{{field-1}}\n$x\\,-4y\\,-\\,$ \n{{field-2}} $z\\,-$\n{{field-3}}$\\,=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,-2,5⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨3,-4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨3,-4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-4,-2⟩ & =⟨1,-2,5⟩\\cdot ⟨3,-4,-2⟩ \\\\ r\\cdot ⟨3,-4,-2⟩ & =1\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-4,-2⟩ & =1 \\\\ 3x-4y-2z & =1 \\\\ 3x-4y-2z-1 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb4622ed-9eb6-5ab5-b09f-f59678e58176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310755}] :answer-field/correct {:db/id #edb/ref 17592186310755} :answer-field/id #uuid "9111dd74-21be-5107-89db-711f1d689b9f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311203} {:answer-field/choices [{:answer/id #uuid "2e83fa3a-3413-5d19-8fa6-0a79d47eec96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186309102}] :answer-field/correct {:db/id #edb/ref 17592186309102} :answer-field/id #uuid "9bf5b2eb-fbfa-5d61-8ec3-aa4076b08859" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311244} {:answer-field/choices [{:answer/id #uuid "ddb1d17c-d1bc-5a82-8d25-eb41948deb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310524}] :answer-field/correct {:db/id #edb/ref 17592186310524} :answer-field/id #uuid "adbc801d-93a1-5b8a-b526-ca60531ec87a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8add1d49-d5c8-5e59-a059-69a179339ffb" :question/math-academy-id "q-336111" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,4,1)$ and is perpendicular to the line \n$$\n\\displaystyle \\left\\{\\begin{aligned}x &=-1+2t \\\\ y &=5+3t \\\\ z &=7-t\\end{aligned}\\right..\n$$\n\n{{field-1}}$\\,x\\,+\\,$\n{{field-2}}\n$y\\,-\\,z\\,-\\,$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨-3,4,1⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨2,3,-1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨2,3,-1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,3,-1⟩ & =⟨-3,4,1⟩\\cdot ⟨2,3,-1⟩ \\\\ r\\cdot ⟨2,3,-1⟩ & =5\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,3,-1⟩ & =5 \\\\ 2x+3y-z & =5 \\\\ 2x+3y-z-5 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0edc0a0f-2cbe-5823-9fd4-9455494e4db0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186308854}] :answer-field/correct {:db/id #edb/ref 17592186308854} :answer-field/id #uuid "ca83f76c-8072-5d0c-88b4-bea69dee4f00" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311379} {:answer-field/choices [{:answer/id #uuid "5102665c-8d9c-5af5-9e98-1b4f15580f39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309360}] :answer-field/correct {:db/id #edb/ref 17592186309360} :answer-field/id #uuid "d4d09ea0-2e9b-5d82-98cc-d6d208beec43" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311415} {:answer-field/choices [{:answer/id #uuid "8a059327-7f8d-5c0c-b3ff-4d8452e915d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309833}] :answer-field/correct {:db/id #edb/ref 17592186309833} :answer-field/id #uuid "edd4c1b4-3940-59d1-97f2-9b321d1dc3db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311488}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "556f46a4-05a0-5daf-9526-dc3855ec8f34" :question/math-academy-id "q-336112" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-1,3)$ and is perpendicular to the line \n$$\n\\displaystyle r=\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ -4 \\\\ 2\\end{bmatrix}.\n$$\n\n$x\\,-\\,$\n{{field-1}}\n$y\\,+$\n{{field-2}}\n$z\\,-\\,$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-1,3⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨1,-4,2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨1,-4,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,-4,2⟩ & =⟨2,-1,3⟩\\cdot ⟨1,-4,2⟩ \\\\ r\\cdot ⟨1,-4,2⟩ & =12\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,-4,2⟩ & =12 \\\\ x-4y+2z & =12 \\\\ x-4y+2z-12 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcefed56-4038-52f8-9f7f-eb79fbac52c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186310279}] :answer-field/correct {:db/id #edb/ref 17592186310279} :answer-field/id #uuid "526b627c-ea2e-56a3-b719-9b27238d70b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311006} {:answer-field/choices [{:answer/id #uuid "b701a41d-caa6-5b6b-b7ea-02cf09f48a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186310232}] :answer-field/correct {:db/id #edb/ref 17592186310232} :answer-field/id #uuid "a799307c-dd75-558e-b577-b483cae79109" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311276} {:answer-field/choices [{:answer/id #uuid "f83624ab-ca02-5f56-b5a5-00c4b2cc4485" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310726}] :answer-field/correct {:db/id #edb/ref 17592186310726} :answer-field/id #uuid "c51c5119-11d8-58d9-a87c-7d239e283f10" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311362}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45673dfb-d60d-5849-951f-95ea52c6f106" :question/math-academy-id "q-336201" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-2,3,1)$ and is perpendicular to the line \n$$\n\\displaystyle r=\\begin{bmatrix}1 \\\\ -1 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -5 \\\\ 2\\end{bmatrix}.\n$$\n\n$3x\\,-\\,$\n{{field-1}}\n$y\\,+\\,$\n{{field-2}}\n$z\\,+$\n{{field-3}}\n\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨-2,3,1⟩.$  From the vectorial equation, we find that the line is parallel to the vector $⟨3,-5,2⟩.$  So, the normal vector of the plane is \n\n$$\nn=⟨3,-5,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-5,2⟩ & =⟨-2,3,1⟩\\cdot ⟨3,-5,2⟩ \\\\ r\\cdot ⟨3,-5,2⟩ & =-19\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-5,2⟩ & =-19 \\\\ 3x-5y+2z & =-19 \\\\ 3x-5y+2z+19 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b698b8d-d838-569e-8743-c7334a7dd440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+2z-4=0" :db/id #edb/ref 17592186309583} {:answer/id #uuid "a0f0c8b9-bc37-5bfb-9929-0df4d8029937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+z-3=0" :db/id #edb/ref 17592186310049} {:answer/id #uuid "a57fb5b0-6222-58fe-bfc1-5e5325cd7d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+z-4=0" :db/id #edb/ref 17592186310083} {:answer/id #uuid "b5a86eb1-28e1-5734-84d2-b468a6108b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y+z-4=0" :db/id #edb/ref 17592186310216} {:answer/id #uuid "cfa6a16f-d3a1-5a8e-b635-4f53092ff5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y-z-4=0" :db/id #edb/ref 17592186310419}] :answer-field/correct {:db/id #edb/ref 17592186310083} :answer-field/id #uuid "c0d80fa9-92b4-56ea-bacd-670e1a568b19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311349}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69ff4417-28a7-50ac-aae7-8483ea57f4a8" :question/math-academy-id "q-336213" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,1,0)$ and is perpendicular to the line \n$$\n\\displaystyle \\left\\{\\begin{aligned}x &=1 \\\\ y &=-2+4t \\\\ z &=3+t\\end{aligned}\\right..\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,1,0⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨0,4,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨0,4,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,4,1⟩ & =⟨2,1,0⟩\\cdot ⟨0,4,1⟩ \\\\ r\\cdot ⟨0,4,1⟩ & =4\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,4,1⟩ & =4 \\\\ 4y+z & =4 \\\\ 4y+z-4 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e77dac35-f79f-5bc2-9fde-1d8139793b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310587}] :answer-field/correct {:db/id #edb/ref 17592186310587} :answer-field/id #uuid "6747872f-f63f-52c6-9f61-19718f0a2359" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311064} {:answer-field/choices [{:answer/id #uuid "b3875a94-efdb-5eca-baf2-d84143e12286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310199}] :answer-field/correct {:db/id #edb/ref 17592186310199} :answer-field/id #uuid "936c951d-ff8e-5b6e-89ac-24ab5c66011f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311210} {:answer-field/choices [{:answer/id #uuid "370e6e98-3c53-5434-9334-94895858c8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186309168}] :answer-field/correct {:db/id #edb/ref 17592186309168} :answer-field/id #uuid "cce56c2d-29c3-5fd6-b50e-1beeeb3c5b54" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc5e8637-ca14-5006-a320-1c33620f30f4" :question/math-academy-id "q-336220" :question/problem "Given the Cartesian equation $3x+y+2z+4=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨$ \n{{field-2}}\n$,1\\,,$\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨3,1,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}3x+y+2z+4 & =0 \\\\ 2z & =-3x-y-4 \\\\ z & =-\\frac{3}{2}x-\\frac{1}{2}y-2\\end{aligned}\n$$\n\nIf we put $x=0$ and $y=0$, we get $z=-2.$ Hence, the point $P(0,0,-2)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-2⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-2⟩)\\cdot ⟨3,1,2⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a084ee0-627b-5a25-87e5-c96f7478912e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309063}] :answer-field/correct {:db/id #edb/ref 17592186309063} :answer-field/id #uuid "7003a65b-3fe7-5632-99c3-efacb8b557f3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311092} {:answer-field/choices [{:answer/id #uuid "447e12cd-52ed-5f18-917c-6d3705fe1ce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186309271}] :answer-field/correct {:db/id #edb/ref 17592186309271} :answer-field/id #uuid "be2dfd93-04c4-5d34-8a61-193937b3dc93" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311336} {:answer-field/choices [{:answer/id #uuid "966c020e-8bfc-5c8a-8dfc-c8c597049306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186309952}] :answer-field/correct {:db/id #edb/ref 17592186309952} :answer-field/id #uuid "ea998710-ef72-59ff-8552-f1d42c4ec5f1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0599589-1ded-5a0e-8e23-6b2660c198aa" :question/math-academy-id "q-336225" :question/problem "Given the Cartesian equation $5x-7y+4z+20=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨5,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨5,-7,4⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}5x-7y+4z+20 & =0 \\\\ z & =-\\frac{5}{4}x+\\frac{7}{4}y-5\\end{aligned}\n$$\n\nIf we put $x=0$ and $y=0$, we get $z=-5.$ Hence, the point $P(0,0,-5)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-5⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-5⟩)\\cdot ⟨5,-7,4⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6d66ff-70a2-5b92-ab20-bd677380c46b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186309086}] :answer-field/correct {:db/id #edb/ref 17592186309086} :answer-field/id #uuid "8fb6a62c-788d-5190-8837-bfc59fd86a05" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311199} {:answer-field/choices [{:answer/id #uuid "b4beecf1-8790-5fba-ac43-35bd9e823884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186310212}] :answer-field/correct {:db/id #edb/ref 17592186310212} :answer-field/id #uuid "9e94a478-1097-5e40-80d1-4f48dc385a29" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311248} {:answer-field/choices [{:answer/id #uuid "4cdae185-5c04-5fc5-8b31-566acad00345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186309333}] :answer-field/correct {:db/id #edb/ref 17592186309333} :answer-field/id #uuid "e7db4f19-e049-5cb9-8352-a80b31669e9f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64044816-f99e-5bbd-98dc-f1b11d26a804" :question/math-academy-id "q-336228" :question/problem "Given the Cartesian equation $5x+2y+z-4=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨$\n{{field-2}} $,\\,2\\,,$\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨5,2,1⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}5x+2y+z-4 & =0 \\\\ z & =-5x-2y+4\\end{aligned}\n$$\n\nIf we put $x=0$ and $y=0$, we get $z=4.$ Hence, the point $P(0,0,4)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,4⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,4⟩)\\cdot ⟨5,\\,2\\,,1⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "983ac607-b7d8-5a59-ba8c-c3d73aead01c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309972}] :answer-field/correct {:db/id #edb/ref 17592186309972} :answer-field/id #uuid "8fe851a5-475e-5e00-ae87-a44650a48c05" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311200} {:answer-field/choices [{:answer/id #uuid "39d38379-3377-58a7-b66e-226c76d0f0ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186309191}] :answer-field/correct {:db/id #edb/ref 17592186309191} :answer-field/id #uuid "c534bce9-2049-5269-add0-acbf6bd23974" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311363} {:answer-field/choices [{:answer/id #uuid "3d82f8bf-6b6a-5e27-bfa7-8709039830a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309216}] :answer-field/correct {:db/id #edb/ref 17592186309216} :answer-field/id #uuid "c967a25c-f606-5cfa-b6b7-b9ce29d1b714" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311374}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90a83aba-f17d-5cf5-b908-89b87fad5bea" :question/math-academy-id "q-336229" :question/problem "Given the Cartesian equation $5x+2z-8=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨5,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨5,0,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}5x+2z-8 & =0 \\\\ z & =-\\frac{5}{2}x+4\\end{aligned}\n$$\n\nIf we put, say, $x=0,$ we get $z=4.$ Hence, the point $P(0,0,4)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,4⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,4⟩)\\cdot ⟨5,0,2⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c41f3d-5996-54ab-934e-b5526604547a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310443}] :answer-field/correct {:db/id #edb/ref 17592186310443} :answer-field/id #uuid "4c583d5c-c776-5f72-9c2f-d90ee50557e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310994} {:answer-field/choices [{:answer/id #uuid "f681872c-91f8-5414-8018-47869e55ecc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186310706}] :answer-field/correct {:db/id #edb/ref 17592186310706} :answer-field/id #uuid "ad0c9c01-8da4-50d1-828f-206ea43f1949" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311293} {:answer-field/choices [{:answer/id #uuid "2dbe44a6-4370-5b71-adaf-8fda69b11328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186309092}] :answer-field/correct {:db/id #edb/ref 17592186309092} :answer-field/id #uuid "bfe3bcc6-012e-591c-b518-45d3e3ee895b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311345}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "db62087a-6baa-53ef-9e04-a1fd4ede9961" :question/math-academy-id "q-336239" :question/problem "Given the Cartesian equation $9x-3y+6=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,$\n{{field-1}}$\\,,0$\n\n$⟩)\\cdot ⟨$\n{{field-2}}\n,\n{{field-3}}\n$,0⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨9,-3,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}9x-3y+6 & =0 \\\\ -3y & =-9x-6 \\\\ y & =3x+2\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=2.$ Hence, the point $P(0,2,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,2,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,2,0⟩)\\cdot ⟨9,-3,0⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ac71e4-1f43-51f8-bfa4-a92855f4700b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309261}] :answer-field/correct {:db/id #edb/ref 17592186309261} :answer-field/id #uuid "7faaceec-cd8b-568a-858c-271760090279" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311144} {:answer-field/choices [{:answer/id #uuid "580b7964-a0b4-59ea-bd21-b56d80484ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309413}] :answer-field/correct {:db/id #edb/ref 17592186309413} :answer-field/id #uuid "93f3390e-533a-5d25-83c0-c5daa77f3ccf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311213} {:answer-field/choices [{:answer/id #uuid "0ccc2dae-6d3d-5c97-a2ff-2660720cb731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186308836}] :answer-field/correct {:db/id #edb/ref 17592186308836} :answer-field/id #uuid "95d0ab30-64b1-59c5-b1be-e3cbd8256de2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "04886b81-54da-502a-b95c-1502eb418ce2" :question/math-academy-id "q-336241" :question/problem "Given the Cartesian equation $12y-6z-30=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨0,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,12,-6⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}12y-6z-30 & =0 \\\\ -6z & =-12y+30 \\\\ z & =2y-5\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-5.$ Hence, the point $P(0,0,-5)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-5⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-5⟩)\\cdot ⟨0,12,-6⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f585e309-73b4-523e-a6db-a2a983999732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186310701}] :answer-field/correct {:db/id #edb/ref 17592186310701} :answer-field/id #uuid "0465da51-c688-5f2e-a3b9-979e1d2fc572" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310804} {:answer-field/choices [{:answer/id #uuid "1b5b7065-1260-5634-833e-cd8d9b69dc30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186308962}] :answer-field/correct {:db/id #edb/ref 17592186308962} :answer-field/id #uuid "495fba70-636b-5cb8-b619-f1add74b1dec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310987} {:answer-field/choices [{:answer/id #uuid "2cf18829-493f-5163-a8ed-b491fd4a9396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309082}] :answer-field/correct {:db/id #edb/ref 17592186309082} :answer-field/id #uuid "97cb1a37-6fd2-5af4-8e41-45302b6fb593" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311236}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ade52e16-a03f-5e87-b722-7d62e66ee938" :question/math-academy-id "q-336358" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-4,3,5)$ and is parallel to the vectors ${v}_{1}=⟨2,-3,-6⟩$ and ${v}_{2}=⟨0,2,-8⟩.$\n\n{{field-1}}\n$x\\,+$\n{{field-2}}\n$y\\,+\\,z\\,+$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-4,3,5⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ -3 \\\\ -6\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 2 \\\\ -8\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & -3 & -6 \\\\ 0 & 2 & -8\\end{vmatrix} \\\\  & =36i+16j+4k \\\\  & =⟨36,16,4⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨36,16,4⟩ & =⟨-4,3,5⟩\\cdot ⟨36,16,4⟩ \\\\ r\\cdot ⟨36,16,4⟩ & =-76\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨36,16,4⟩ & =-76 \\\\ 36x+16y+4z & =-76 \\\\ 36x+16y+4z+76 & =0 \\\\ 9x+4y+z+19 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142ba832-6df9-5f16-afd1-b26adde73a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186308895}] :answer-field/correct {:db/id #edb/ref 17592186308895} :answer-field/id #uuid "ad4741e0-f097-5cb6-bbf0-add403d4a44b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311294}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90ebde0b-39f7-53e6-b891-41140a14fc75" :question/math-academy-id "q-336381" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,1,-1)$, $P(3,4,2)$ and $Q(-1,2,0).$\n\n$\\,y\\,-\\,z\\,-$\n{{field-1}}\n$=0$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,1,-1⟩,\\,p=⟨3,4,2⟩,$ and $q=⟨-1,2,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,4,2⟩-⟨1,1,-1⟩ \\\\  & =⟨2,3,3⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨-1,2,0⟩-⟨1,1,-1⟩ \\\\  & =⟨-2,1,1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 3 \\\\ 3\\end{bmatrix}\\times \\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & 3 \\\\ -2 & 1 & 1\\end{vmatrix} \\\\  & =0i-8j+8k \\\\  & =⟨0,-8,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,-8,8⟩ & =⟨3,4,2⟩\\cdot ⟨0,-8,8⟩ \\\\ r\\cdot ⟨0,-8,8⟩ & =-16\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,-8,8⟩ & =-16 \\\\ -8y+8z & =-16 \\\\ -8y+8z+16 & =0 \\\\ y-z-2 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb432540-1fcf-5293-9159-3760fb3980d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186310619}] :answer-field/correct {:db/id #edb/ref 17592186310619} :answer-field/id #uuid "0513cf96-93dc-524f-936b-6ac3cf3a7015" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310806} {:answer-field/choices [{:answer/id #uuid "e82ade4e-f022-5b8b-b609-90b4ef1a62a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186310592}] :answer-field/correct {:db/id #edb/ref 17592186310592} :answer-field/id #uuid "7000019d-143c-5832-869c-bbfdc4d09dd9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311091} {:answer-field/choices [{:answer/id #uuid "46d3f357-e4f8-5535-8109-12ac27e1bc4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309290}] :answer-field/correct {:db/id #edb/ref 17592186309290} :answer-field/id #uuid "c0a0a06e-de98-5dd9-8d9d-588e34cf9940" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311348}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b056d61-c09c-50b3-b173-38669f95fc26" :question/math-academy-id "q-336384" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(2,-2,1)$, $P(5,0,3)$ and $Q(1,1,-1).$\n\n{{field-1}}\n$x\\,-$\n{{field-2}}\n$y\\,-\\,11z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨2,-2,1⟩,\\,p=⟨5,0,3⟩,$ and $q=⟨1,1,-1⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨5,0,3⟩-⟨2,-2,1⟩ \\\\  & =⟨3,2,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨1,1,-1⟩-⟨2,-2,1⟩ \\\\  & =⟨-1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}3 \\\\ 2 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}-1 \\\\ 3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 3 & 2 & 2 \\\\ -1 & 3 & -2\\end{vmatrix} \\\\  & =-10i+4j+11k \\\\  & =⟨-10,4,11⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-10,4,11⟩ & =⟨5,0,3⟩\\cdot ⟨-10,4,11⟩ \\\\ r\\cdot ⟨-10,4,11⟩ & =-17\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-10,4,11⟩ & =-17 \\\\ -10x+4y+11z & =-17 \\\\ 10x-4y-11z & =17 \\\\ 10x-4y-11z-17 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17793687-91b7-5e39-8c30-e05f6c7e9d4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-2z-6=0" :db/id #edb/ref 17592186308932} {:answer/id #uuid "4bd4c4c1-dbf1-5146-b731-536aabaaf317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-y-2z-3=0" :db/id #edb/ref 17592186309326} {:answer/id #uuid "b00c9fd6-291a-54bf-aa04-8f9a4c5b1b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+y-2z-5=0" :db/id #edb/ref 17592186310169} {:answer/id #uuid "de96c60a-1e6f-5bba-8fc7-038c86c7b674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+y+2z-3=0" :db/id #edb/ref 17592186310536} {:answer/id #uuid "f6ab27ed-0b38-5cf5-9b46-80e61fe105aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+y-2z-3=0" :db/id #edb/ref 17592186310707}] :answer-field/correct {:db/id #edb/ref 17592186308932} :answer-field/id #uuid "a5573a7b-0f09-50b5-bd07-bcff38daef8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9d64ce1-7855-51fd-a302-1dae7b7afa6a" :question/math-academy-id "q-336407" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-3,1)$ and is perpendicular to the line \n$$\n\\displaystyle r=\\begin{bmatrix}-1 \\\\ 4 \\\\ 2\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix}.\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-3,1⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨4,0,-2⟩.$ So, the normal vector of the plane is\n\n$$\nn=⟨4,0,-2⟩,\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,0,-2⟩ & =⟨2,-3,1⟩\\cdot ⟨4,0,-2⟩ \\\\ r\\cdot ⟨4,0,-2⟩ & =6\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute  $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨4,0,-2⟩ & =3 \\\\ 4x-2z & =6 \\\\ 4x-2z-6 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a14273c4-973b-5e8e-bc83-453225164017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186310052}] :answer-field/correct {:db/id #edb/ref 17592186310052} :answer-field/id #uuid "6874ae7e-e122-5cb2-8f2b-840a85daa817" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311067} {:answer-field/choices [{:answer/id #uuid "602c2e50-169c-5e1d-999d-cc423e1aea3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309474}] :answer-field/correct {:db/id #edb/ref 17592186309474} :answer-field/id #uuid "6efcf732-1c4e-54c7-b4b6-d6f298695ac0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311087} {:answer-field/choices [{:answer/id #uuid "8d8ab4ec-8327-5d8c-9b75-20218bf80f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186309867}] :answer-field/correct {:db/id #edb/ref 17592186309867} :answer-field/id #uuid "a36b0722-c2b4-5bde-930b-01b7098a01cb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311268}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8fc2917-9125-5430-b66d-89b52e1351ff" :question/math-academy-id "q-336450" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-4,3)$ and is parallel to the vectors ${v}_{1}=⟨1,-3,-2⟩$ and ${v}_{2}=⟨0,4,-1⟩.$\n\n{{field-1}}\n$x\\,+\\,y\\,+$\n{{field-2}} \n$z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨2,-4,3⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}1 \\\\ -3 \\\\ -2\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 4 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & -3 & -2 \\\\ 0 & 4 & -1\\end{vmatrix} \\\\  & =11i+1j+4k \\\\  & =⟨11,1,4⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨11,1,4⟩ & =⟨2,-4,3⟩\\cdot ⟨11,1,4⟩ \\\\ r\\cdot ⟨11,1,4⟩ & =30\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨11,1,4⟩ & =30 \\\\ 11x+y+4z & =30 \\\\ 11x+y+4z-30 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eaadc80-2b16-539b-a368-a16f47e8ad0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-3z-12=0" :db/id #edb/ref 17592186308848} {:answer/id #uuid "abb27324-f6d9-5bc6-8149-a4879a7a061b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y-3x+12=0" :db/id #edb/ref 17592186310136} {:answer/id #uuid "b25e3f58-14d4-5ddb-a833-9135fa659667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y-3z-12=0" :db/id #edb/ref 17592186310190} {:answer/id #uuid "cb0b4341-b875-5124-a2f5-e73cd8ad57ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3z-12=0" :db/id #edb/ref 17592186310374} {:answer/id #uuid "ce61ca74-92fc-59e3-8309-f252d8951690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-3z+12=0" :db/id #edb/ref 17592186310406}] :answer-field/correct {:db/id #edb/ref 17592186308848} :answer-field/id #uuid "91db78ac-e8b6-5cd5-a2ae-1be0b76a5d9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f9042cb-d3d8-5370-a9db-8978ddd34aee" :question/math-academy-id "q-336538" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(3,-2,1)$ and is perpendicular to the line \n\n$$\n\\frac{x-1}{5}=\\frac{z+2}{-3},\\,y=4\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,1⟩.$ From the Cartesian equation, we find that the line is parallel to the vector $⟨5,0,-3⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,0,-3⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,0,-3⟩ & =⟨3,-2,1⟩\\cdot ⟨5,0,-3⟩ \\\\ r\\cdot ⟨5,0,-3⟩ & =12\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,0,-3⟩ & =12 \\\\ 5x-3z & =12 \\\\ 5x-3z-12 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c006e5-3f7e-5051-858d-4500712511f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-4y+z+14=0" :db/id #edb/ref 17592186309366} {:answer/id #uuid "60ed1dfd-51f0-598a-b06f-b0ee5a9100fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y+14=0" :db/id #edb/ref 17592186309485} {:answer/id #uuid "9f48ce73-6192-528e-8095-135366ecf8b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y+z+10=0" :db/id #edb/ref 17592186310034} {:answer/id #uuid "ceb7e276-0387-5607-bbd3-dd25d74ffab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y+14=0" :db/id #edb/ref 17592186310409} {:answer/id #uuid "dc96b7ad-2b24-5c90-9fa9-5a875768683a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y-2z+13=0" :db/id #edb/ref 17592186310517}] :answer-field/correct {:db/id #edb/ref 17592186309485} :answer-field/id #uuid "ae155145-cf8c-585f-a832-9bff4daf4c4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ebf2e85f-ac82-5cbe-8701-83e9058f130b" :question/math-academy-id "q-336540" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-4,1)$ and is perpendicular to the line \n$$\n\\displaystyle \\left\\{\\begin{aligned}x &=-2+t \\\\ y &=1+4t \\\\ z &=5\\end{aligned}\\right..\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-4,1⟩.$  From the parametrical equation, we find that the line is parallel to the vector $⟨1,4,0⟩.$  So, the normal vector of the plane is \n\n$$\nn=⟨1,4,0⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,4,0⟩ & =⟨2,-4,1⟩\\cdot ⟨1,4,0⟩ \\\\ r\\cdot ⟨1,4,0⟩ & =-14\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,4,0⟩ & =-14 \\\\ x+4y & =-14 \\\\ x+4y+14 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3999a87b-f882-5ca7-9260-d448846a37d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,5,4⟩" :db/id #edb/ref 17592186309187} {:answer/id #uuid "39a5a717-471c-5a17-834f-af512678a057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-13,33,-14⟩" :db/id #edb/ref 17592186309188} {:answer/id #uuid "7600e36d-9294-520d-95e5-38e4fd4ac988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-12,21,-4⟩" :db/id #edb/ref 17592186309669} {:answer/id #uuid "9bc1f13f-1145-50d7-80ea-c9565ed86989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-33,13,-41⟩" :db/id #edb/ref 17592186310008} {:answer/id #uuid "fe53bf4d-a431-5742-8703-83bd73a22ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,7,-1⟩" :db/id #edb/ref 17592186310782}] :answer-field/correct {:db/id #edb/ref 17592186310008} :answer-field/id #uuid "86549ea0-3e13-5e9e-9d1d-fbd94e79de20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c5d0e74-0671-5cb7-b3b8-23383905b037" :question/math-academy-id "q-33819" :question/problem "Find a normal vector to the plane\n\n$$\nr=\\begin{bmatrix}-2 \\\\ 23 \\\\ 14\\end{bmatrix}+t\\begin{bmatrix}-3 \\\\ 5 \\\\ 4\\end{bmatrix}+s\\begin{bmatrix}4 \\\\ 7 \\\\ -1\\end{bmatrix},\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-3,5,4⟩$ and $w=⟨4,7,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}-3 \\\\ 5 \\\\ 4\\end{bmatrix}\\times \\begin{bmatrix}4 \\\\ 7 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ -3 & 5 & 4 \\\\ 4 & 7 & -1\\end{vmatrix} \\\\  & =-33i+13j-41k \\\\  & =⟨-33,13,-41⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-33,13,-41⟩.$"}] [{:db/id #edb/ref 17592186311922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e74f9f-1af9-5dc7-8ccc-bd79144a5971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨81,31,-54⟩" :db/id #edb/ref 17592186308892} {:answer/id #uuid "a16a88ae-3018-5f41-a616-24e14cb6feed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,1,5⟩" :db/id #edb/ref 17592186310054} {:answer/id #uuid "b17d75bb-ff09-5c49-972d-a2cae3d3a64e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-9,-5⟩" :db/id #edb/ref 17592186310183} {:answer/id #uuid "cd2ea962-2c6b-5f06-b9d5-2bfa1e73b3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-45,13,18⟩" :db/id #edb/ref 17592186310392} {:answer/id #uuid "dc527030-7073-59d7-957d-01ea5e456e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨18,31,-45⟩" :db/id #edb/ref 17592186310513}] :answer-field/correct {:db/id #edb/ref 17592186310513} :answer-field/id #uuid "bf3ec234-028e-5441-a8e5-9ae115d7f17b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311342}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c4d4116-a9f1-5bf2-8a08-5f9441d405d1" :question/math-academy-id "q-33820" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨3,1,5⟩+t⟨3,-9,-5⟩+s⟨-8,9,3⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨3,-9,-5⟩$ and $w=⟨-8,9,3⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}3 \\\\ -9 \\\\ -5\\end{bmatrix}\\times \\begin{bmatrix}-8 \\\\ 9 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 3 & -9 & -5 \\\\ -8 & 9 & 3\\end{vmatrix} \\\\  & =18i+31j-45k \\\\  & =⟨18,31,-45⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨18,31,-45⟩.$"}] [{:db/id #edb/ref 17592186311923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c8e7ea8-0d9c-5b1f-89e9-91628496e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨13,3,-2⟩" :db/id #edb/ref 17592186308835} {:answer/id #uuid "354a9260-c58f-58ed-8391-3adb2b24d963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,1,-2⟩" :db/id #edb/ref 17592186309153} {:answer/id #uuid "6e0d2672-9a88-554f-b39c-620549cbdefe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,1,1⟩" :db/id #edb/ref 17592186309597} {:answer/id #uuid "b46385db-0845-5695-b5f9-3fe1e651f7bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,-7,-8⟩" :db/id #edb/ref 17592186310207} {:answer/id #uuid "cd9094b0-9eb0-5127-819f-099f8d1c96fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,13,-8⟩" :db/id #edb/ref 17592186310398}] :answer-field/correct {:db/id #edb/ref 17592186310207} :answer-field/id #uuid "1b2ef420-dca5-5f3b-8c47-d02babc3d1c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b724a31e-de81-5f97-aa9a-91e913632f49" :question/math-academy-id "q-33822" :question/problem "Find a normal vector to the plane\n\n$$\nr=\\begin{bmatrix}6 \\\\ 0 \\\\ 2\\end{bmatrix}+t\\begin{bmatrix}-5 \\\\ 1 \\\\ 1\\end{bmatrix}+s\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix},\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-5,1,1⟩$ and $w=⟨3,1,-2⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}-5 \\\\ 1 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ -5 & 1 & 1 \\\\ 3 & 1 & -2\\end{vmatrix} \\\\  & =-3i-7j-8k \\\\  & =⟨-3,-7,-8⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-3,-7,-8⟩.$"}] [{:db/id #edb/ref 17592186314753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4287f2-23fb-5921-a476-c54d401a558f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y-4=0" :db/id #edb/ref 17592186312058} {:answer/id #uuid "1c55f330-a58c-50e4-baae-061ff856ae82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-y-2z-4=0" :db/id #edb/ref 17592186312185} {:answer/id #uuid "3c31d601-a464-55b8-8619-a4f5cb6a3c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3z-4=0" :db/id #edb/ref 17592186312463} {:answer/id #uuid "8fef07d3-7bf2-538a-8dbe-c447310426b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y+z+4=0" :db/id #edb/ref 17592186313123} {:answer/id #uuid "d6e5e999-43bb-571e-ad28-ea600f0a65f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-y-2z=0" :db/id #edb/ref 17592186313667}] :answer-field/correct {:db/id #edb/ref 17592186312185} :answer-field/id #uuid "c2fa0fd7-88c8-56df-ac33-842b5a56dd52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314560}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "686d05b3-6ae6-58de-961c-a5d4a934cbc6" :question/math-academy-id "q-33913" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-1,1)$, $P(2,0,3)$ and $Q(1,1,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-1,1⟩,\\,p=⟨2,0,3⟩,$ and $q=⟨1,1,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨2,0,3⟩-⟨1,-1,1⟩ \\\\  & =⟨1,1,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨1,1,0⟩-⟨1,-1,1⟩ \\\\  & =⟨0,2,-1⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & 1 & 2 \\\\ 0 & 2 & -1\\end{vmatrix} \\\\  & =-5i+j+2k \\\\  & =⟨-5,1,2⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,1,2⟩ & =⟨2,0,3⟩\\cdot ⟨-5,1,2⟩ \\\\ r\\cdot ⟨-5,1,2⟩ & =-4\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,1,2⟩ & =-4 \\\\ -5x+y+2z & =-4 \\\\ -5x+y+2z+4 & =0 \\\\ 5x-y-2z-4 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a74889-ac9d-5168-9bd6-c05b2e6eb04a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+z-5=0" :db/id #edb/ref 17592186312163} {:answer/id #uuid "1ead3ef2-4480-5ec3-a602-0edf54b64bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+3z-5=0" :db/id #edb/ref 17592186312206} {:answer/id #uuid "6c95a8c3-59f1-52ca-bbe5-6e4745dae092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-5y+z=0" :db/id #edb/ref 17592186312827} {:answer/id #uuid "db699c62-fa97-57d3-a15f-72ebf06976d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+2y+z-5=0" :db/id #edb/ref 17592186313701} {:answer/id #uuid "de95faa1-c022-587f-bbda-e098387dddda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y+3z-5=0" :db/id #edb/ref 17592186313725}] :answer-field/correct {:db/id #edb/ref 17592186312163} :answer-field/id #uuid "c1911110-c68f-571f-b041-6475b3b845e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2229970c-380d-5c52-9385-f1cac1675d7c" :question/math-academy-id "q-33926" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,0,3)$ and is perpendicular to the vector $n=⟨2,0,1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨1,0,3⟩$ and the normal vector of the plane is $n=⟨2,0,1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,0,1⟩ & =⟨1,0,3⟩\\cdot ⟨2,0,1⟩ \\\\ r\\cdot ⟨2,0,1⟩ & =5.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,0,1⟩ & =5 \\\\ 2x+z & =5 \\\\ 2x+z-5 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c45b9636-399b-57c9-b0ca-5b056cab6e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467154} {:answer/id #uuid "00f0df38-33bd-5952-938b-70e46d37d368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467155}] :answer-field/correct {:db/id #edb/ref 17592186467154} :answer-field/id #uuid "9fc7f8e8-fc48-5fd1-b18c-379caef6afe3" :answer-field/key "![Diagram I](images/86/865ed1369b8acd7f6968e55f5e70d09be3f8ff76728cc450727971d46d0c440a.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468298} {:answer-field/choices [{:answer/id #uuid "4176da4a-c07c-53da-b9f8-81f889069292" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467156} {:answer/id #uuid "37103a6e-807c-5169-b7ba-686822f478af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467157}] :answer-field/correct {:db/id #edb/ref 17592186467156} :answer-field/id #uuid "3627c95d-cad1-56d5-b0b6-1badb632532d" :answer-field/key "![Diagram II](images/de/de1da96426cf0c5a3fae00d6d390e330f98fadf84fc1e8718c9175913280c14b.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468299} {:answer-field/choices [{:answer/id #uuid "5b796237-8562-520b-9624-44bf611de202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467158} {:answer/id #uuid "58db0137-2f48-5c3e-a9ce-c6b13667728c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467159}] :answer-field/correct {:db/id #edb/ref 17592186467159} :answer-field/id #uuid "c76ce559-9343-5371-bc06-64f8880bfebd" :answer-field/key "![Diagram III](images/ee/ee43587f781158d585bafdb6acb2176bd8a35b7f97ec6c7b89651ba79d002ed4.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "278579d2-6c97-5a07-b8af-1fbac0d66174" :question/math-academy-id "q-34174" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\n- Diagram II does not represent a subspace. The vector $a=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$  lies inside the given subset. But\n\n$$\n(-1)\\cdot a=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\n- Diagram III represents a subspace. It represents the whole plane, which is considered a special subspace of ${R}^{2}.$\n\nSo, the correct answer is diagram III only."}] [{:db/id #edb/ref 17592186317349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26487427-5f9b-54b2-bf84-c50ca7d67c88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467238} {:answer/id #uuid "8abe74c0-b916-592e-8e38-169447a7be01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467239}] :answer-field/correct {:db/id #edb/ref 17592186467238} :answer-field/id #uuid "4bb369ea-eb84-5999-9ef8-b0df4c5228f7" :answer-field/key "![Diagram I](images/cf/cfb657b3cec6a9f0fc3c4787d0cb8228d35472d4ae3118d7274ee312cab6224a.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468340} {:answer-field/choices [{:answer/id #uuid "6f749e06-8ca2-52aa-9e98-1b67c0b6a908" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467240} {:answer/id #uuid "c92f06ac-0ec3-5893-aea1-dd43200715b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467241}] :answer-field/correct {:db/id #edb/ref 17592186467241} :answer-field/id #uuid "dffd8e82-1715-566d-a74e-b5ca9f8ee2b6" :answer-field/key "![Diagram II](images/71/71c6306c877b53adb93195f97bb0fa68757e3b327199bd49495c5b55eb8f352d.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468341} {:answer-field/choices [{:answer/id #uuid "21aeab67-d310-5a4e-9331-241f8caf4bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467242} {:answer/id #uuid "6101f1aa-f296-59f7-8d09-2eac34095f6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467243}] :answer-field/correct {:db/id #edb/ref 17592186467242} :answer-field/id #uuid "56cc4e03-77d2-5272-af50-419f510cef6e" :answer-field/key "![Diagram III](images/f6/f6a2d1a4d0f605e44fab627146b021d7d23a033859b01c7c429fc3da976cf4d7.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468342} {:answer-field/choices [{:answer/id #uuid "08bc47ae-635a-5401-88ad-448e7833a2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668611} {:answer/id #uuid "33b610b5-c9b9-5aee-bbe1-d5dd991e02cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668612}] :answer-field/correct {:db/id #edb/ref 17592186668611} :answer-field/id #uuid "4fd81551-96ad-5200-96b9-b5e7551faeb4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "113a385d-0512-508f-a50c-e45bc26c3c1f" :question/math-academy-id "q-34300" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}$ or ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a line that does not pass through the origin. But every subspace must contain the origin, so the line in Diagram I is not a subspace of ${R}^{2}.$\n\n- Diagram II is a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\n- Diagram III does not represent a subspace. The origin $0=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}$ lies outside the subset.\n\nSo, the correct answer is diagram II only"}] [{:db/id #edb/ref 17592186317380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a32be64-f2b5-5cb3-a9b9-ef2943408008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467244} {:answer/id #uuid "07c1dfb9-72a8-504a-b11e-8c01835fe7f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467245}] :answer-field/correct {:db/id #edb/ref 17592186467245} :answer-field/id #uuid "c9a85601-cde0-5741-a206-f9b2c5d853b4" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y⟩\\in {R}^{2}:\\\\{x}^{2}+{y}^{2}\\ge 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468343} {:answer-field/choices [{:answer/id #uuid "aff10804-82e4-5d83-a8ad-c843c8e8a0a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467246} {:answer/id #uuid "5842b0a4-3f5b-582b-8bee-6e80b74c5259" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467247}] :answer-field/correct {:db/id #edb/ref 17592186467247} :answer-field/id #uuid "192b3bcd-ac72-5cdf-9221-db424cc98b06" :answer-field/key "$B=\\{⟨x,y⟩\\in {R}^{2}:x=2y\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468344} {:answer-field/choices [{:answer/id #uuid "5d159a5b-2686-5bfa-b54b-4ca0ed609fcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467248} {:answer/id #uuid "2528c821-b847-54f0-8883-6d9ed55b4f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467249}] :answer-field/correct {:db/id #edb/ref 17592186467249} :answer-field/id #uuid "918b7c5a-dd99-5cbf-b43f-6939bcb541bb" :answer-field/key "$C=\\{⟨x,y⟩\\in {R}^{2}:x-y=0\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468345}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92efc5e4-6fcf-5867-b774-9cceef4cda9c" :question/math-academy-id "q-34327" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. It actually represents the whole space ${R}^{2}$, since the coordinates of any vector $⟨x,y⟩$ satisfy the inequality ${x}^{2}+{y}^{2}\\ge 0.$\n\n- The set $B$ is a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $x=2y$ since $0=2\\cdot 0.$ So, $0$ lies in $B.$\n\n- The set $C$ is a subspace. It also represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $x-y=0$ since $0-0=0.$ So, $0$ lies in $C.$\n\nSo, the correct answer is $$\n\\displaystyle \\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y⟩\\in {R}^{2}:\\\\{x}^{2}+{y}^{2}\\ge 0\\end{gathered}\\right\\}\\end{gathered};\n$$ $B=\\{⟨x,y⟩\\in {R}^{2}:x=2y\\}$; $C=\\{⟨x,y⟩\\in {R}^{2}:x-y=0\\}$."}] [{:db/id #edb/ref 17592186323702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0cec0f5-50a0-5db7-aa24-c8f6e6f46576" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467316} {:answer/id #uuid "84637b0b-e6d4-5bf8-8d2a-0889fc35f79a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467317}] :answer-field/correct {:db/id #edb/ref 17592186467317} :answer-field/id #uuid "3580a9f0-52f8-5185-8668-b0142e7a463c" :answer-field/key "$A={⟨x,y⟩\\in {R}^{2}:{x}^{2}+{y}^{2}\\le 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468379} {:answer-field/choices [{:answer/id #uuid "c4781a47-7159-598f-bde4-83c8c11de3e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467318} {:answer/id #uuid "7de9877f-5787-5cf1-9cf3-6d2942ba95b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467319}] :answer-field/correct {:db/id #edb/ref 17592186467318} :answer-field/id #uuid "c5f1fc60-d17d-5814-b04d-4e79e98e1504" :answer-field/key "$B={⟨x,y⟩\\in {R}^{2}:x=\\frac{1}{2}y+2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468380} {:answer-field/choices [{:answer/id #uuid "470f0416-0b89-5555-aeca-66f06e23ece5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467320} {:answer/id #uuid "3e03d669-cae3-5262-bdca-b0bd34428d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467321}] :answer-field/correct {:db/id #edb/ref 17592186467321} :answer-field/id #uuid "15500526-9977-5c61-a2b5-2c48a155e044" :answer-field/key "$C={0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d143826-9093-5bc1-bb87-8034a4c54f58" :question/math-academy-id "q-35599" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. There is only one vector in ${R}^{2}$ that satisfies the equation ${x}^{2}+{y}^{2}\\le 0,$ namely, the zero vector $0=⟨0,0⟩.$ So, $A={0}$, which is a special subspace of ${R}^{2}.$\n\n- The set $B$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0⟩$ does not satisfy the equation $x=\\frac{1}{2}y+2$ since $0\\ne \\frac{1}{2}\\cdot 0+2.$\n\n- The set $C$ is a subspace. This subset has only one element, the zero vector $0=⟨0,0⟩,$ which is a special subspace of ${R}^{2}.$\n\nSo, the correct answer is $A={⟨x,y⟩\\in {R}^{2}:{x}^{2}+{y}^{2}\\le 0}$; $C={0}$ only."}] [{:db/id #edb/ref 17592186323703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0970f7c9-0267-5fd4-9880-d41ae3a79463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467322} {:answer/id #uuid "4f237964-f389-5bd6-8aac-aa282034aac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467323}] :answer-field/correct {:db/id #edb/ref 17592186467322} :answer-field/id #uuid "c5afcb2c-0b40-564c-94ff-ab2c6514204c" :answer-field/key "![Diagram I](images/40/409caad41e356e4fbb8f9f735a1bdae2330711ebc26ab3b887b3708716e2725e.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468382} {:answer-field/choices [{:answer/id #uuid "1e4fd8e4-2e3e-5610-9911-e8b5d526828a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467324} {:answer/id #uuid "c173b593-8813-5ead-a8f2-2b0d20818dc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467325}] :answer-field/correct {:db/id #edb/ref 17592186467325} :answer-field/id #uuid "a377b320-87d3-55f5-bdfe-2d4bec9a251e" :answer-field/key "![Diagram II](images/7f/7ff3e4c257e91061e59c40321cf495d151286c2aad8e6d7bcd8cb71b9f9b088c.svg)" :answe