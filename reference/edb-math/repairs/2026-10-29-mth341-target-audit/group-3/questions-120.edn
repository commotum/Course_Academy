d #edb/ref 17592186286544} {:answer/id #uuid "e2c21149-b51b-5c5a-a0e0-3d426aa0c537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186286852} {:answer/id #uuid "ee3658c3-81e8-5ecc-aea4-f0acc0e2855c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286972}] :answer-field/correct {:db/id #edb/ref 17592186286972} :answer-field/id #uuid "fec77e96-3956-5e7b-8e39-d6e53fb9e67a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287664}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dfc3e0f0-9ab6-551c-8d47-c8fca0b2295d" :question/math-academy-id "q-181988" :question/problem "![](images/34/34f5bb40fdcd4f71967ef2b1cc15328cf8d4d02cdd54b19a406273fae6c88ad4.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x-1\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *above* the line $y=-x-1.$ For those points, the following condition is satisfied:\n\n$$\ny>-x-1\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny>-x-1.\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,y>-x-1\\}\n$$"}] [{:db/id #edb/ref 17592186287786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ff83ff-a85e-5759-9a2a-3d799b7146cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285009} {:answer/id #uuid "22dcd8b2-76cb-51d8-aa88-be7ec7d0f316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186285101} {:answer/id #uuid "31cf8ca8-2c9c-5660-b2d4-d28776812fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186285240} {:answer/id #uuid "888939e6-2972-505a-a344-1b5368a90f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286039}] :answer-field/correct {:db/id #edb/ref 17592186285009} :answer-field/id #uuid "15922b56-5dee-5494-8dfc-80286a88342e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287186} {:answer-field/choices [{:answer/id #uuid "0e641f7d-97d5-592f-b908-a83d570e3900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186284910} {:answer/id #uuid "510bea55-bf55-5cea-8b52-95fe8b458fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186285534} {:answer/id #uuid "8373ff27-35ba-51b2-b72c-2a5884d86109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285994} {:answer/id #uuid "a7bf6367-06aa-5f5d-8157-3a9ba937b6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286318} {:answer/id #uuid "b08deaa3-fc46-587f-8575-c5dc0208de7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286402}] :answer-field/correct {:db/id #edb/ref 17592186286318} :answer-field/id #uuid "8ea164f5-ab88-5833-8f94-dcbc1b0c609b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53ac5dfb-f75e-5ef2-a84c-e58da3b6698e" :question/math-academy-id "q-181999" :question/problem "![](images/c7/c7f7b1dc9bf4da61b573345aaf92fe0d29ea00ef5558a9fca985d8af25fa0a03.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,2\\}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=2.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>2\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny>2.\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y>2\\}.\n$$"}] [{:db/id #edb/ref 17592186287790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d32fcf7-f956-579e-bd12-582e2a8e1218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285188} {:answer/id #uuid "8380f9b1-920d-5146-839d-4b75e2f43ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285996} {:answer/id #uuid "d3d0529c-dab6-51e3-9c14-4b29bf91f5fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286714} {:answer/id #uuid "e6cb933e-eef2-5fbf-b5cf-aa05874b4c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286899} {:answer/id #uuid "e92e2838-a3f7-5ff3-a899-3e77a31053e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286920}] :answer-field/correct {:db/id #edb/ref 17592186286920} :answer-field/id #uuid "b1c12478-b402-5f5d-b4da-66a564ce341e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287517} {:answer-field/choices [{:answer/id #uuid "38812c8c-b3a5-564b-b650-983576d4442a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285315} {:answer/id #uuid "66d676e1-0e6e-5f12-b840-c7214f77aef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186285723} {:answer/id #uuid "d06de7c4-b859-548f-af13-4ddc486c2944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186286685} {:answer/id #uuid "dca2758b-df2c-54f7-9ccf-9a8e5f9528f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186286797}] :answer-field/correct {:db/id #edb/ref 17592186285315} :answer-field/id #uuid "dbc6ba57-bdbf-5460-a5b9-e829e1bd1802" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287597}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49192157-aea0-5727-927f-dcfccbbb5607" :question/math-academy-id "q-182013" :question/problem "![](images/77/7703b8c621b268a9fcbb412cd3a0617045145d475024dc91cecfa09a18fc8712.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,-2\\}\n$$" :question/worked-solution "The points in our set include all those that lie *right* the line $x=-2.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx>-2\n$$\n\nWe must also include the line $x=-2$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\nx\\ge -2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2\\}.\n$$"}] [{:db/id #edb/ref 17592186287792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167ee290-c682-5fed-ba58-a3f8ff1bfa22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{2}" :db/id #edb/ref 17592186284992} {:answer/id #uuid "5b353c2e-5d30-5a8e-aba9-8867e5be727f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285622} {:answer/id #uuid "5f1158a7-b4ae-51b5-8786-b3f74e91071b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186285658} {:answer/id #uuid "7ff29248-215b-5815-a8ee-4db3139b66ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186285965} {:answer/id #uuid "ad42a5c1-8d53-56c1-8ccc-0e00f3246008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286371} {:answer/id #uuid "f36669c5-1dfc-578b-9980-2f5d1be54bc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186287016}] :answer-field/correct {:db/id #edb/ref 17592186286371} :answer-field/id #uuid "1294729d-a5bd-5c49-b0c6-f422f0a1974b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287178} {:answer-field/choices [{:answer/id #uuid "3256dce2-fbdc-53bb-94fb-b50be06f7aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285247} {:a