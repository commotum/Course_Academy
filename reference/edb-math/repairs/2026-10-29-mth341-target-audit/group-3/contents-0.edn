#{[{:db/id #edb/ref 17592186119829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119640} :knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048954}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120217} {:db/id #edb/ref 17592186120222} {:db/id #edb/ref 17592186262809} {:db/id #edb/ref 17592186304808} {:db/id #edb/ref 17592186304818} {:db/id #edb/ref 17592186308388} {:db/id #edb/ref 17592186308412} {:db/id #edb/ref 17592186390848} {:db/id #edb/ref 17592186392994} {:db/id #edb/ref 17592186413463} {:db/id #edb/ref 17592186413464} {:db/id #edb/ref 17592186423177} {:db/id #edb/ref 17592186641630} {:db/id #edb/ref 17592186649168} {:db/id #edb/ref 17592186649222} {:db/id #edb/ref 17592186650982}] :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Vector"}] [{:db/id #edb/ref 17592186119830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119641} :knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186120248} {:db/id #edb/ref 17592186120508} {:db/id #edb/ref 17592186262837} {:db/id #edb/ref 17592186262838} {:db/id #edb/ref 17592186262846} {:db/id #edb/ref 17592186262847} {:db/id #edb/ref 17592186308389} {:db/id #edb/ref 17592186338827} {:db/id #edb/ref 17592186338828} {:db/id #edb/ref 17592186338829} {:db/id #edb/ref 17592186338830} {:db/id #edb/ref 17592186338831} {:db/id #edb/ref 17592186393029} {:db/id #edb/ref 17592186420153} {:db/id #edb/ref 17592186445224} {:db/id #edb/ref 17592186649199} {:db/id #edb/ref 17592186649200}] :knowledge-point/title "Finding a Vector That Is Parallel To a Plane"}] [{:db/id #edb/ref 17592186119831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119642} :knowledge-point/id #uuid "45cdbb0d-2986-5