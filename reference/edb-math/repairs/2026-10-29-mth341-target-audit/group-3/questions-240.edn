#{[{:db/id #edb/ref 17592186410902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d1652fb-1168-5910-b443-bc4d2aaa83b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-2,3,4⟩+s⟨3,2,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410876} {:answer/id #uuid "6de998f6-75b1-5c9e-b4ad-4610846cd003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨5,1,3⟩+t⟨6,-4,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410877} {:answer/id #uuid "6f370def-22e8-5622-8821-0b17c7041552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨5,-1,3⟩+t⟨-2,6,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410878} {:answer/id #uuid "8c776c18-debc-5cbb-81e5-adcde0157d0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-4,1⟩+s⟨-1,-3,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410881} {:answer/id #uuid "a4cfb9d5-2ef9-5254-9cf0-fa366d4db62f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨3,-1,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410885}] :answer-field/correct {:db/id #edb/ref 17592186410885} :answer-field/id #uuid "06437268-d863-51cb-b3b0-cea274d91aa3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410892}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d22837b0-87ad-552e-9bb4-a7dfb550ed51" :question/math-academy-id "q-128466" :question/problem "Find a parametric equation of the plane that passes through the point $E(2,-1,4)$ and is parallel to the vectors ${v}_{1}=⟨3,-1,5⟩$  and ${v}_{2}=⟨6,-2,4⟩.$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $E$ is $p=⟨2,-1,4⟩$ and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=⟨3,-1,5⟩$  and ${v}_{2}=⟨6,-2,4⟩.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=⟨2,-1,4⟩+s⟨3,-1,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186413462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c482fb6-1221-56a1-9d24-627eff7b967c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,5⟩=0" :db/id #edb/ref 17592186413448} {:answer/id #uuid "5fbbe94c-7a42-57a2-8bc5-73a5b3aa4afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,5⟩=⟨1,2,3⟩" :db/id #edb/ref 17592186413449} {:answer/id #uuid "8be31b94-69c9-5829-891b-14995d0113a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,2,3⟩=18" :db/id #edb/ref 17592186413451} {:answer/id #uuid "b346d644-6f1f-5ec8-a95e-b0ef3e5e25bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,2,3⟩=⟨-1,2,5⟩" :db/id #edb/ref 17592186413454} {:answer/id #uuid "c846c53c-a7c1-5cb9-84b1-15cf24c5ceca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,5⟩=18" :db/id #edb/ref 17592186413457}] :answer-field/correct {:db/id #edb/ref 17592186413457} :answer-field/id #uuid "09321377-3d24-5a5f-8608-652765793fba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8bddb63c-4c54-5e88-a8e9-1298e5060eb6" :question/math-academy-id "q-70883" :question/problem "Find an equation of the plane that passes through the point $P(1,2,3)$ and is perpendicular to the line that goes through the points \n$A(2,1,0)$ and $B(1,3,5).$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,2,3⟩.$\n\nSince the line  passes through the points $A(2,1,0)$ and $B(1,3,5)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,3,5⟩-⟨2,1,0⟩ \\\\  & =⟨-1,2,5⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨-1,2,5⟩.$ \n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,5⟩ & =⟨1,2,3⟩\\cdot ⟨-1,2,5⟩ \\\\ r\\cdot ⟨-1,2,5⟩ & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32743a37-ea98-5030-bc97-5c9249817938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=0" :db/id #edb/ref 17592186413446} {:answer/id #uuid "3bf9d08c-d107-5f44-9c81-8ad84d2c8cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨5,-1,1⟩=⟨1,2,-3⟩" :db/id #edb/ref 17592186413447} {:answer/id #uuid "6906bd4d-81fa-56e9-9975-333718bd9981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨5,-1,1⟩=-4" :db/id #edb/ref 17592186413450} {:answer/id #uuid "a556e4c0-7956-5861-be5e-2d8ead0ef5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=⟨-5,1,-1⟩" :db/id #edb/ref 17592186413452} {:answer/id #uuid "c3bbba03-77ef-54a0-90c6-08b40f6f1852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=10" :db/id #edb/ref 17592186413456}] :answer-field/correct {:db/id #edb/ref 17592186413446} :answer-field/id #uuid "c10fc8bb-0d7f-5bee-84f8-1fa8a92dd2ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413461}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bced3755-fd06-539b-819f-10c4ab686823" :question/math-academy-id "q-32972" :question/problem "Find an equation of the plane that contains the point $Q(5,-1,1)$ and is perpendicular to the vector $n=⟨-1,-2,3⟩.$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨5,-1,1⟩$ and $n=⟨-1,-2,3⟩$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-1,-2,3⟩ & =⟨5,-1,1⟩\\cdot ⟨-1,-2,3⟩ \\\\ r\\cdot ⟨-1,-2,3⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061185a3-b68f-5683-8fef-601edcc7e95a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-1⟩=3" :db/id #edb/ref 17592186413444} {:answer/id #uuid "25d0e859-47cf-5e2e-9ce5-c53b1448f6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,1⟩=-3" :db/id #edb/ref 17592186413445} {:answer/id #uuid "afd07518-3061-5b76-96ee-db6a415e76db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=3" :db/id #edb/ref 17592186413453} {:answer/id #uuid "b94406b8-9d2b-52e2-8a01-3a285d79c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=-3" :db/id #edb/ref 17592186413455} {:answer/id #uuid "e2856d01-e48b-5c22-b7b4-3fdd89bdafd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=-1" :db/id #edb/ref 17592186413458}] :answer-field/correct {:db/id #edb/ref 17592186413453} :answer-field/id #uuid "5979170b-e938-5576-b257-2c5e77488161" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fae89980-f6bf-5229-9ea3-54197530dd8b" :question/math-academy-id "q-127645" :question/problem "Find an equation of the plane that contains the point $P(3,-2,4)$ and is perpendicular to the vector $n=⟨1,-2,-1⟩.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,4⟩,$ and $n=⟨1,-2,-1⟩$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,-2,-1⟩ & =⟨3,-2,4⟩\\cdot ⟨1,-2,-1⟩ \\\\ r\\cdot ⟨1,-2,-1⟩ & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2493b28e-9805-515c-9bb7-52400b1ebad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y-z+3=0" :db/id #edb/ref 17592186413717} {:answer/id #uuid "5c7649c7-0f92-5513-b462-907271b682a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3z+3=0" :db/id #edb/ref 17592186413720} {:answer/id #uuid "a11ad414-7674-5c26-950f-59f6a219f5d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-z+3=0" :db/id #edb/ref 17592186413724} {:answer/id #uuid "d3c26dd6-942b-51e3-9221-ce5b6eff63d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y-z-4=0" :db/id #edb/ref 17592186413730} {:answer/id #uuid "d4795ff7-792e-54da-b148-8c4ee1d289d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y+z-4=0" :db/id #edb/ref 17592186413731}] :answer-field/correct {:db/id #edb/ref 17592186413717} :answer-field/id #uuid "f6c20a87-b8c2-530d-b3e1-fb8bd507d26c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413734}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34ca6320-0524-59fc-8f68-7b8524566ac6" :question/math-academy-id "q-70815" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(0,0,3)$ and is perpendicular to the line \n$$\n\\displaystyle \\left\\{\\begin{aligned}x &=2+2t \\\\ y &=5t \\\\ z &=1-t\\end{aligned}\\right..\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨0,0,3⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨2,5,-1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨2,5,-1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,5,-1⟩ & =⟨0,0,3⟩\\cdot ⟨2,5,-1⟩ \\\\ r\\cdot ⟨2,5,-1⟩ & =-3.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,5,-1⟩ & =-3 \\\\ 2x+5y-z & =-3 \\\\ 2x+5y-z+3 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2717e35a-d5d8-5b8d-b82d-51c22326e847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-y+z+2=0" :db/id #edb/ref 17592186413718} {:answer/id #uuid "9f69fd47-a1f5-5770-8c3d-1d9916854264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+z-2=0" :db/id #edb/ref 17592186413723} {:answer/id #uuid "a34b8674-3166-5800-b2b6-3d8e2d749e97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+z+2=0" :db/id #edb/ref 17592186413725} {:answer/id #uuid "bb1a451c-30a6-598a-a1e4-37120fd4f9f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y+z+2=0" :db/id #edb/ref 17592186413728} {:answer/id #uuid "cf32c54e-7d9c-57e0-ac44-14a3df665bca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+y+z+2=0" :db/id #edb/ref 17592186413729}] :answer-field/correct {:db/id #edb/ref 17592186413725} :answer-field/id #uuid "261a61c5-5d9c-5e73-a9c8-99e605e6c3e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413732}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d60eaae3-858a-5d2f-83b8-ccadfd1429d3" :question/math-academy-id "q-330499" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-1,3,2)$ and is perpendicular to the vector $n=⟨4,0,1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-1,3,2⟩$ and the normal vector of the plane is $n=⟨4,0,1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,0,1⟩ & =⟨-1,3,2⟩\\cdot ⟨4,0,1⟩ \\\\ r\\cdot ⟨4,0,1⟩ & =-2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨4,0,1⟩ & =-2 \\\\ 4x+z & =-2 \\\\ 4x+z+2 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f5bbffd-b662-53da-9146-542052fb7f6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+5y+5z+1=0" :db/id #edb/ref 17592186413719} {:answer/id #uuid "88552711-7258-529e-8575-2c6ac297ae0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x+5y+5z+10=0" :db/id #edb/ref 17592186413721} {:answer/id #uuid "88a1e7b7-4a66-5740-9c7e-14a39dd3849b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+5y+5z-5=0" :db/id #edb/ref 17592186413722} {:answer/id #uuid "a3f975fc-9692-533a-ba00-bf7e8438a517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-5y+5z-10=0" :db/id #edb/ref 17592186413726} {:answer/id #uuid "b5ddaec5-2f45-5d0e-8c08-e6549f59e357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x+5y+5z+5=0" :db/id #edb/ref 17592186413727}] :answer-field/correct {:db/id #edb/ref 17592186413721} :answer-field/id #uuid "f3cdc898-7c65-52bc-9785-8f3da0b98b76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413733}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fc9c30e8-905e-5cc3-9596-440fe740820a" :question/math-academy-id "q-128410" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,1)$, $P(3,-1,2)$ and $Q(4,2,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,1⟩,\\,p=⟨3,-1,2⟩,$ and $q=⟨4,2,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-1,2⟩-⟨1,-2,1⟩ \\\\  & =⟨2,1,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨4,2,0⟩-⟨1,-2,1⟩ \\\\  & =⟨3,4,-1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ 4 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & 1 \\\\ 3 & 4 & -1\\end{vmatrix} \\\\  & =-5i+5j+5k \\\\  & =⟨-5,5,5⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,5,5⟩ & =⟨3,-1,2⟩\\cdot ⟨-5,5,5⟩ \\\\ r\\cdot ⟨-5,5,5⟩ & =-10\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,5,5⟩ & =-10 \\\\ -5x+5y+5z & =-10 \\\\ -5x+5y+5z+10 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b70f6a-e851-54e5-aa28-b6a025e9ece5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186419408}] :answer-field/correct {:db/id #edb/ref 17592186419408} :answer-field/id #uuid "2f1bb041-bd3b-51ec-95b9-ab27a720aff3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419416} {:answer-field/choices [{:answer/id #uuid "b0061273-aae7-5a50-ba3b-7dbc44ba608c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186419411}] :answer-field/correct {:db/id #edb/ref 17592186419411} :answer-field/id #uuid "51f6537d-feab-5ce3-9fc6-f89624d037a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419418} {:answer-field/choices [{:answer/id #uuid "373d6628-e7af-5c99-8ea7-bda3f45e1294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186419407}] :answer-field/correct {:db/id #edb/ref 17592186419407} :answer-field/id #uuid "c79424ce-ee00-57d0-b195-b7db6dde7351" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419420}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53aad395-ec2e-5a47-9cdb-e404625e4482" :question/math-academy-id "q-330576" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$$\n\\displaystyle \\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.\n$$\n\n{{field-1}}\n$x\\,+4y\\,-$\n{{field-2}}\n$z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c0fd5d-eb30-51ed-9d57-ff0d86d1b905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y+z-2=0" :db/id #edb/ref 17592186419403} {:answer/id #uuid "25dcf144-1a51-5366-9800-5383c00b5a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2y-z-2=0" :db/id #edb/ref 17592186419405} {:answer/id #uuid "2b822cf8-78b8-5c6f-ba5e-a61ce1027e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2y-z-5=0" :db/id #edb/ref 17592186419406} {:answer/id #uuid "aaf4ea99-1c7e-5b6b-af27-f81db06966e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x-2y-z-5=0" :db/id #edb/ref 17592186419410} {:answer/id #uuid "b32a3885-cdf4-51dc-ad0e-0a3c46647043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y+z-5=0" :db/id #edb/ref 17592186419412}] :answer-field/correct {:db/id #edb/ref 17592186419405} :answer-field/id #uuid "b30e511f-0a3e-547f-96f1-0bfc53ad4766" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419419}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70aeaa22-2b90-533e-ab1d-9dbd9f885f48" :question/math-academy-id "q-70807" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-1,1)$ and is perpendicular to the line \n$$\n\\displaystyle \\frac{x-2}{-1}=\\frac{y-1}{2}=\\frac{z+1}{1}.\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,-1,1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨-1,2,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-1,2,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,1⟩ & =⟨1,-1,1⟩\\cdot ⟨-1,2,1⟩ \\\\ r\\cdot ⟨-1,2,1⟩ & =-2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-1,2,1⟩ & =-2 \\\\ -x+2y+z & =-2 \\\\ -x+2y+z+2 & =0 \\\\ x-2y-z-2 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "102de1fa-9039-5418-a721-6fc419237fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5y+8z+9=0" :db/id #edb/ref 17592186419404} {:answer/id #uuid "90536ec6-2590-5af2-a702-9be2e4b1ecdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+8y+5z+6=0" :db/id #edb/ref 17592186419409} {:answer/id #uuid "c7f81252-3be5-5daa-a718-63070020d187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5y+8z+7=0" :db/id #edb/ref 17592186419413} {:answer/id #uuid "c8ca9437-ca61-5c50-96e0-f167dfcd51fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5y-8z+11=0" :db/id #edb/ref 17592186419414} {:answer/id #uuid "d6eccb3f-c3a2-58a8-b47e-683c853ab3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5y+9z+15=0" :db/id #edb/ref 17592186419415}] :answer-field/correct {:db/id #edb/ref 17592186419404} :answer-field/id #uuid "34e50549-8287-5dd0-82ee-b77b6017695a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419417}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e08b1f6c-36a3-5d41-8737-49d26e8563c5" :question/math-academy-id "q-128459" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,0)$, $P(3,-4,1)$ and $Q(2,1,-2).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,0⟩,\\,p=⟨3,-4,1⟩,$ and $q=⟨2,1,-2⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-4,1⟩-⟨1,-2,0⟩ \\\\  & =⟨2,-2,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨2,1,-2⟩-⟨1,-2,0⟩ \\\\  & =⟨1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & -2 & 1 \\\\ 1 & 3 & -2\\end{vmatrix} \\\\  & =i+5j+8k \\\\  & =⟨1,5,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,5,8⟩ & =⟨3,-4,1⟩\\cdot ⟨1,5,8⟩ \\\\ r\\cdot ⟨1,5,8⟩ & =-9\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,5,8⟩ & =-9 \\\\ x+5y+8z & =-9 \\\\ x+5y+8z+9 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b182a09-cc9d-51c4-95fe-e78790ecf72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186420142} {:answer/id #uuid "36cb63bc-ae79-51e4-b5ab-3039c42340e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186420143} {:answer/id #uuid "4173b538-e381-5dd5-b0c5-10dc2eaa96c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186420144} {:answer/id #uuid "502b671f-b1be-5d29-8f96-08571a87d173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186420145} {:answer/id #uuid "72001519-6957-56f0-b511-f27a9ed3c85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420146}] :answer-field/correct {:db/id #edb/ref 17592186420143} :answer-field/id #uuid "f9a0d8dd-871f-5fc8-9699-7a78c5f80aac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3fa29ff6-5ae4-5642-82fd-03b1645e810c" :question/math-academy-id "q-127921" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨5,-1,3⟩=27.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨5,-1,3⟩=27$ of the plane, we get the normal vector $n=⟨5,-1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨5,-1,3⟩ & =0 \\\\ 5{t}_{1}-{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{2} & =5{t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,5{t}_{1}+3{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,3,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=3.$"}] [{:db/id #edb/ref 17592186423157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e5c1f6-5233-50a9-a0c7-3d8454d96058" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+5y+2z-49=0" :db/id #edb/ref 17592186423137} {:answer/id #uuid "44b25bde-c138-5e61-9bfe-10c541da03de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-4y-2z-53=0" :db/id #edb/ref 17592186423138} {:answer/id #uuid "8a9aa20e-7044-5fe9-999a-ca209eb00faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+4y+2z-36=0" :db/id #edb/ref 17592186423140} {:answer/id #uuid "b722b988-b76f-5900-8ce4-497e838c929c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-5y-2z-17=0" :db/id #edb/ref 17592186423145} {:answer/id #uuid "dd9f7bca-6210-53d4-939e-d73b38d6642a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+4y-2z-57=0" :db/id #edb/ref 17592186423151}] :answer-field/correct {:db/id #edb/ref 17592186423151} :answer-field/id #uuid "ab781c91-252d-5387-b0ba-ee29d18b5ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a383fb4-f81d-5536-bfab-907adbefb459" :question/math-academy-id "q-128372" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$$\n\\displaystyle \\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c2e93d-88d9-55e5-8da7-a7c8857c95a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=1" :db/id #edb/ref 17592186423171} {:answer/id #uuid "865e5880-5d6c-5eb8-b605-32023bca731a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=0" :db/id #edb/ref 17592186423172} {:answer/id #uuid "88b7b35b-b8a9-55fa-b177-e46dd3a1176a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=-1" :db/id #edb/ref 17592186423173} {:answer/id #uuid "c899f30d-448a-55d6-a220-50efc27da551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=1" :db/id #edb/ref 17592186423174} {:answer/id #uuid "f42a4087-cff6-5d2b-9264-832562c287ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186423175}] :answer-field/correct {:db/id #edb/ref 17592186423174} :answer-field/id #uuid "ed6bca43-1900-5519-94be-29cc1bb55d43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9509d4b2-8f43-5f25-8917-81a3d5d9b04d" :question/math-academy-id "q-33195" :question/problem "Find an equation of the plane that contains the point $P(0,1,1)$ and is perpendicular to the vector $n=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "First, notice that the position vector of $P$ is $p=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}$ and $n=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}$ is normal to the plane.\n\nThe equation of the plane that passes though the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\ r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bd6234-56f6-541c-bfc5-f390a8cb5bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨3,-2,1⟩=0" :db/id #edb/ref 17592186423950} {:answer/id #uuid "1d1ce09d-4b43-5ecf-b718-dbc33ca70dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,2,3⟩=0" :db/id #edb/ref 17592186423951} {:answer/id #uuid "2c57426d-3447-5790-bc09-7f27391e4e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,3⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423952} {:answer/id #uuid "95f99c20-a235-5660-8d6b-b04b727483d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423955} {:answer/id #uuid "b1292071-77e9-579a-8b2f-0a1e4da37f19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,\\frac{1}{3}⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423957}] :answer-field/correct {:db/id #edb/ref 17592186423955} :answer-field/id #uuid "0fa9de33-9d04-55cd-94a1-cecb483c4e8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423959}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e005b4ab-002a-57d1-b9b7-3fc85eeb395f" :question/math-academy-id "q-70819" :question/problem "Given the Cartesian equation $x-2y+3z=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨1,-2,3⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}x-2y+3z & =0 \\\\ 3z & =-x+2y \\\\ z & =-\\frac{1}{3}x+\\frac{2}{3}y.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=0.$ Hence, the point $P(0,0,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186426531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9417891-0e40-540b-991e-c0da826220ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474424} {:answer/id #uuid "72a365a1-c915-5248-8b67-7d67badce3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474425}] :answer-field/correct {:db/id #edb/ref 17592186474424} :answer-field/id #uuid "d831bd91-03aa-54a1-ab90-e13837639f43" :answer-field/key "![Diagram I](images/b0/b00fb1155a26b42272142a96f86e31c96b6ab0adfbe0e743b5ee7125a029cd44.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475138} {:answer-field/choices [{:answer/id #uuid "1fa4f35b-8dc5-579b-8ae5-b2436fabe315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474426} {:answer/id #uuid "bc5da6ed-abf0-570d-9dbc-5092dcb29f9e" :answer/type {:db/id #edb/ref 17592186045499 