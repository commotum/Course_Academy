t as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-2<y\\le 2}.\n$$"}] [{:db/id #edb/ref 17592186287727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00dd7aff-bfda-5343-80b2-b9d8a212688c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186284798} {:answer/id #uuid "40fe20cf-eb94-56ec-b101-6d9e772648d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285393} {:answer/id #uuid "9a1dbdc7-e20c-51b5-a1af-b363f5f360ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286200} {:answer/id #uuid "9b86519b-9739-5214-b3eb-1c6713326737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186286215} {:answer/id #uuid "ec094cca-380b-5c2d-8597-8376933da0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286953}] :answer-field/correct {:db/id #edb/ref 17592186284798} :answer-field/id #uuid "053b43c3-dca6-5e97-8ea6-906172bd2e2e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287153} {:answer-field/choices [{:answer/id #uuid "1d98047c-fc8d-5044-9c7f-2dc676b7d6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186285055} {:answer/id #uuid "2205f098-6512-5ee8-af24-e180e25ac21c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186285092} {:answer/id #uuid "b1b9278c-2f3d-5280-9562-fa7aab619fab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286414} {:answer/id #uuid "c2792ffe-1548-55d4-9064-609e1cbeee26" :answer/type {:db/id #edb/ref 17592186045498 :db