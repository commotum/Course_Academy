45498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186284856} {:answer/id #uuid "fcae3297-6377-5f20-b0cc-c62719d96954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186287097}] :answer-field/correct {:db/id #edb/ref 17592186287097} :answer-field/id #uuid "9b171719-0565-50d7-8d61-26ab3095e3df" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287465}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49eb2820-ef81-5aa5-ac35-475ea920738e" :question/math-academy-id "q-181804" :question/problem "![](images/a8/a87b00f9f7908fe62542ef7bca94277f040af97b4af24698dd648c167bcd3376.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,1\\,{{field-1}}\\,x\\,{{field-2}}\\,5,\\,2\\,{{field-3}}\\,y\\,{{field-4}}\\,5}\n$$" :question/worked-solution "A point $P(x,y)$ lies *inside* the rectangle if the following conditions are satisfied:\n\n$$\n\\begin{aligned}1<x<5,\\,2<y<5\\end{aligned}\n$$\n\nNotice that we also need to *include* the bottom edge ($y=2$).\n\nTherefore, we change the corresponding inequality symbol to non-strict, as follows:\n\n$$\n\\begin{aligned}1<x<5,\\,2\\le y<5\\end{aligned}\n$$\n\nMoreover, since *every* real value in these intervals is included, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,1<x<5,\\,2\\le y<5}\n$$"}] [{:db/id #edb/ref 17592186287766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69670d3d-4c35-5e47-ac77-855bbb84bf70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285755} {:answer/id #uuid "7ea5b245-1f40-532c-9d05-5940a886593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285955}] :answer-field/correct {:db/id #edb/ref 17592186285955} :answer-field/id #uuid "366f834e-6096-5eb0-b5d0-af45bd1624d9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287259} {:answer-field/choices [{:answer/id #uuid "44672182-1f63-5e08-b2a9-b9242df22dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285415} {:answer/id #uuid "b6f2f61d-0eab-5d1c-95d6-06e41613cc94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286457}] :answer-field/correct {:db/id #edb/ref 17592186286457} :answer-field/id #uuid "bfcdb8db-afca-5db6-aa94-8d8b7eacb832" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287541} {:answer-field/choices [{:answer/id #uuid "7af19ec5-1e20-5b94-bba7-9ac309dd5b1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285925} {:answer/id #uuid "ed06f4fb-f595-59ca-9f73-57684d15b46d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286958}] :answer-field/correct {:db/id #edb/ref 17592186285925} :answer-field/id #uuid "c6bc1a35-6893-503b-ab8d-e34953f8b04a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287554} {:answer-field/choices [{:answer/id #uuid "5ff8e0f3-186e-5b12-bf3a-8a8f15fef9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285668} {:answer/id #uuid "7acaf994-2b2c-5a5c-b08e-017ef4750ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285922}] :answer-field/correct {:db/id #edb/ref 17592186285922} :answer-field/id #uuid "e69002f9-65bd-5fe4-9e71-e80796938792" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287624}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c447c7d2-83cd-503b-b04b-0c9b2bcb0661" :question/math-academy-id "q-181806" :question/problem "![](images/a6/a659e2d14a645036488833cd920e6bb3e3d7a7716724dba63814be6df4066fe9.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3\\,{{field-1}}\\,x\\,{{field-2}}\\,6,\\,-1\\,{{field-3}}\\,y\\,{{field-4}}\\,4\\}\n$$" :question/worked-solution "A point $P(x,y)$ lies *inside* the rectangle if the following conditions are satisfied:\n\n$$\n\\begin{aligned}3<x<6,\\,-1<y<4\\end{aligned}\n$$\n\nNotice that we also need to *include* the left edge ($x=3$).\n\nTherefore, we change the corresponding inequality symbol to non-strict, as follows:\n\n$$\n\\begin{aligned}3\\le x<6,\\,-1<y<4\\end{aligned}\n$$\n\nMoreover, since *every* real value in these intervals is included, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3\\le x<6,\\,-1<y<4\\}\n$$"}] [{:db/id #edb/ref 17592186287767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11cc44e6-a832-55a1-a9e3-3566446a515a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186284943} {:answer/id #uuid "136d190b-9ad1-5ab3-859d-6641b7baa09a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186284959} {:answer/id #uuid "1e776ac1-b687-50b1-90cb-5fca83236005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285060} {:answer/id #uuid "43d4781b-0b76-5b39-9fef-3807e26e2c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186285413} {:answer/id #uuid "e14846ae-e294-5fca-8128-4ced5dbde9a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286838}] :answer-field/correct {:db/id #edb/ref 17592186286838} :answer-field/id #uuid "1ac59a38-d1e6-5d90-9201-2e7ef1cbfee0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287197} {:answer-field/choices [{:answer/id #uuid "1069f288-216a-5529-80fa-81dbf08cdd14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186284930} {:answer/id #uuid "6a77d002-6917-5ba1-a687-c0e990c00e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285761} {:answer/id #uuid "aead6432-d94b-5cda-add2-e32e2dfb2cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286380} {:answer/id #uuid "f8a82c5a-57c9-54be-bb4b-c4260ea0a346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186287061}] :answer-field/correct {:db/id #edb/ref 17592186285761} :answer-field/id #uuid "73caa2cc-d69f-5757-afd5-a542f464a4aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fc98003-bd40-5665-b2e9-cfd241ea5aff" :question/math-academy-id "q-181807" :question/problem "![](images/8c/8c23fe5aa17b46293ff29cd8621ee10b2e143cb23b77811ddf20037a1639bce0.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,{y}^{2}}\n$$" :question/worked-solution "The points in our set include all those that lie *to the left* of the curve $x={y}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx<{y}^{2}\n$$\n\nSince the boundary is not included in the set (the curve is dashed), the inequality is strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x<{y}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186287768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6df847-23fc-5618-8c18-cd3e96bad7a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285059} {:answer/id #uuid "6c7bec6a-d3f9-56f2-b34b-16fcdb511f09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186285782} {:answer/id #uuid "6c934d86-6799-5a6e-be1b-bfcdcd53dd42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186285784} {:answer/id #uuid "aee4f92c-fce7-5537-b85f-5e5708d9ae30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286382}] :answer-field/correct {:db/id #edb/ref 17592186285059} :answer-field/id #uuid "29d47059-772c-58b6-bf07-0817d7499418" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287238} {:answer-field/choices [{:answer/id #uuid "64d997cd-655e-5365-aaf1-cceff5a5062b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285704} {:answer/id #uuid "a26003a9-2d9a-5d8a-a1f7-9bc14c3b9449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286276} {:answer/id #uuid "da2ef479-d8c3-5e76-82bd-a78943a3c260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286779} {:answer/id #uuid "dececa6b-e086-5d80-a97b-6ce596fac723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286817} {:answer/id #uuid "e9e62585-e325-5a07-981f-eaa32507d441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286928}] :answer-field/correct {:db/id #edb/ref 17592186286928} :answer-field/id #uuid "5222196a-8c6a-5902-9894-d374f0ebb9a7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f80556dc-02e0-555b-8ef8-6bae1cda35bf" :question/math-academy-id "q-181808" :question/problem "![](images/66/664c70223ca8a6219b04a287c779d20bf0f88d770920d1357303721574d90787.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,{x}^{2}\\}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the curve $y={x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>{x}^{2}\n$$\n\nWe must also include the curve $y={x}^{2}$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\ge {x}^{2}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2}\\}.\n$$"}] [{:db/id #edb/ref 17592186287769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a6267bb-2818-55e7-87ad-c6c4d297e820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186285760}] :answer-field/correct {:db/id #edb/ref 17592186285760} :answer-field/id #uuid "02ba57c2-638c-5fe3-97ac-462f29ba9d0e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287142} {:answer-field/choices [{:answer/id #uuid "e539d3e3-c8b1-5c3b-bdce-2f885b094c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186286887}] :answer-field/correct {:db/id #edb/ref 17592186286887} :answer-field/id #uuid "1ebbc0f4-be4f-504a-8944-6a5935727df0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287215} {:answer-field/choices [{:answer/id #uuid "d6902f1e-0c2d-50dc-b18b-b7487e08cfa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186286740}] :answer-field/correct {:db/id #edb/ref 17592186286740} :answer-field/id #uuid "850d0167-fdb7-5967-93da-86df0b20a3e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "706b2b43-7315-5cd0-9807-cc687006ade4" :question/math-academy-id "q-181809" :question/problem "![](images/8b/8be62d80165b756aedf31e998d6636d7f77a5606e195b3ec288cb0ac6fb52d6f.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$\\{(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$144$\n\n$\\}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=4$ and vertical radius $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{9} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n9{x}^{2}+16{y}^{2}=144.\n$$\n\nWe're interested in describing all points that lie *outside* the ellipse. So, let's pick any point outside the region, say, $(0,4).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n9(0)^{2}+16(4)^{2}\\,>\\,144.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n9{x}^{2}+16{y}^{2}>144.\n$$\n\nNotice that we use $>$ since the boundary is excluded from the set (the boundary curve is dashed).\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,9{x}^{2}+16{y}^{2}>144\\}.\n$$"}] [{:db/id #edb/ref 17592186287779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2666c468-fc33-52d6-93bd-f0a88838de22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186285124} {:answer/id #uuid "2f302289-5d3d-5452-ac1d-b0d0209c7eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{2}" :db/id #edb/ref 17592186285211} {:answer/id #uuid "ab7053c1-4e09-5eb1-aae0-531352d7433d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286351} {:answer/id #uuid "b1a04b58-793e-5385-b844-aa6a268bc195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286412} {:answer/id #uuid "cda16ec3-f60f-5e8b-9c7e-22dc379fb758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186286659} {:answer/id #uuid "f1cffe97-e550-512e-aef6-d7dec7520efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186287008}] :answer-field/correct {:db/id #edb/ref 17592186287008} :answer-field/id #uuid "ca0914f5-bd5c-521e-bb5b-366f025a00b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287563} {:answer-field/choices [{:answer/id #uuid "921b11d4-9aa5-5e97-bd70-adda69224b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286115} {:answer/id #uuid "a415e744-75b0-5e33-b9e0-218a15e914f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286291} {:answer/id #uuid "b8c8b26e-2480-5dfb-90cd-78218b99a523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286472} {:answer/id #uuid "cb4aea1f-ca2d-5d8f-ab12-687e454476e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186286642} {:answer/id #uuid "f3ee8853-59b1-5bf9-9ddf-f2b8e9267954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186287021}] :answer-field/correct {:db/id #edb/ref 17592186286115} :answer-field/id #uuid "d6b4acb6-bdd9-55f0-b57b-14458546f71d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adce9191-abcc-50fc-a56f-a2f330169645" :question/math-academy-id "q-181970" :question/problem "![](images/01/010d4befaa2bd2142cf63010f79f071df331bb6394eb65e4f883752cb04a2cb4.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x+1\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *above* the line $y=-x+1.$ For those points, the following condition is satisfied:\n\n$$\ny>-x+1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\ge -x+1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,y\\ge -x+1\\}\n$$"}] [{:db/id #edb/ref 17592186287781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155eddcc-7b10-5882-9c3b-e997a278e33e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186284974} {:answer/id #uuid "4afae310-a2c1-52ac-8b9d-c50e017595d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186285483} {:answer/id #uuid "bb683912-97b7-522d-a4bb-58f482c2718a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286494} {:answer/id #uuid "c9ae26c6-2ac6-5819-931c-9d430094433e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286627}] :answer-field/correct {:db/id #edb/ref 17592186286494} :answer-field/id #uuid "4d4c6ec5-c4d7-5d7a-a2f5-0c291edde648" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287320} {:answer-field/choices [{:answer/id #uuid "3d680f06-6809-5a16-96e1-d5b2b3b1d6e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186285367} {:answer/id #uuid "4b32c95c-a97c-5769-9d0e-66fe5b6c0b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285485} {:answer/id #uuid "8a002afb-df41-5e87-96b1-fabd6d1407ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286048} {:answer/id #uuid "c77d5982-2411-5283-8b3a-faa916d95088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286615} {:answer/id #uuid "dc41e0fb-5599-5945-9510-c040584ad374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286790}] :answer-field/correct {:db/id #edb/ref 17592186285367} :answer-field/id #uuid "f785468f-299b-5f38-9497-09ddea8e7e4d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "827675a7-728a-52ab-b17b-7e94ef593363" :question/math-academy-id "q-181976" :question/problem "![](images/11/11ec43034f97e66840da012f3beaf2d933fb03cfbe69f510ca5b68f1fd861f83.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x+1\\}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=-x+1.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>-x+1\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny>-x+1.\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y>-x+1\\}.\n$$"}]}
