#{[{:db/id #edb/ref 17592186369693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "702839b4-c7b1-5db9-91ea-9c3f2efab5cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot \\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}+\\begin{vmatrix}3 & 2 & 2 \\\\ -1 & -1 & 2 \\\\ 3 & 1 & 5\\end{vmatrix}" :db/id #edb/ref 17592186369695} {:answer/id #uuid "f86e6205-9a75-5a60-9ed4-ef2f0b3a571b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot \\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}+\\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix}" :db/id #edb/ref 17592186369696} {:answer/id #uuid "12a47d28-bcb1-5afd-99ff-3d8a94cbaabc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot \\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}-\\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix}" :db/id #edb/ref 17592186369697} {:answer/id #uuid "c5e252b5-30d1-5771-b379-d06e3e238213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}+2\\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix}" :db/id #edb/ref 17592186369698} {:answer/id #uuid "a52f2928-dafd-561a-863c-739b0e4b9c30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}1 & -1 & 3 \\\\ 1 & 5 & 2 \\\\ -2 & 4 & -2\\end{vmatrix}+2\\begin{vmatrix}3 & 2 & -2 \\\\ 5 & -1 & 3 \\\\ 2 & 1 & 1\\end{vmatrix}" :db/id #edb/ref 17592186369699}] :answer-field/correct {:db/id #edb/ref 17592186369697} :answer-field/id #uuid "c19f6c7d-3c52-5637-8844-758c3fa93289" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369694}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8bf1ccdc-7e01-5240-851c-ad3ae64cb10d" :question/math-academy-id "q-130090" :question/problem "$$\n\\displaystyle \\begin{vmatrix}3 & 2 & -2 & -2 \\\\ 1 & -1 & 0 & 3 \\\\ 2 & 5 & 0 & 1 \\\\ -2 & 4 & 1 & -2\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 2 & -2 & -2 \\\\ 1 & -1 & 0 & 3 \\\\ 2 & 5 & 0 & 1 \\\\ -2 & 4 & 1 & -2\\end{vmatrix} & =(-2)\\cdot {C}_{13}+0\\cdot {C}_{23}+0\\cdot {C}_{33}+1\\cdot {C}_{43} \\\\  & =(-2)\\cdot (-1)^{1+3}\\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}+1\\cdot (-1)^{4+3}\\cdot \\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix} \\\\  & =-2\\cdot \\begin{vmatrix}1 & -1 & 3 \\\\ 2 & 5 & 1 \\\\ -2 & 4 & -2\\end{vmatrix}-\\begin{vmatrix}3 & 2 & -2 \\\\ 1 & -1 & 3 \\\\ 2 & 5 & 1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186370926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ab59958-3572-5bd5-9c71-dfdee9fa7f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}-\\sqrt{3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186370928} {:answer/id #uuid "1c30c61b-21ed-5c4f-9a64-e854818db2cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}+\\sqrt{3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186370929} {:answer/id #uuid "7b4ff528-6dac-5d43-8c67-a64208c6bc95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}-\\sqrt{3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186370930} {:answer/id #uuid "cc0c955a-c739-5ab4-94d5-942d420b6ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}+\\sqrt{3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186370931} {:answer/id #uuid "4de2008b-4106-537b-9ed4-de6f1962cbf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}" :db/id #edb/ref 17592186370932}] :answer-field/correct {:db/id #edb/ref 17592186370930} :answer-field/id #uuid "f6a52c01-3abc-504f-8ce8-0f58ce9b7efc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370927}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0371a0fc-9bcf-5c08-aebc-022bfcf1ee58" :question/math-academy-id "q-42097" :question/problem "$$\n\\displaystyle \\begin{vmatrix}1 & 1 & 0 & -1 \\\\ 3 & -1 & \\sqrt{2} & 1 \\\\ -1 & 1 & 0 & -1 \\\\ -2 & 5 & \\sqrt{3} & 1\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 1 & 0 & -1 \\\\ 3 & -1 & \\sqrt{2} & 1 \\\\ -1 & 1 & 0 & -1 \\\\ -2 & 5 & \\sqrt{3} & 1\\end{vmatrix} & =0\\cdot {C}_{13}+\\sqrt{2}\\cdot {C}_{23}+0\\cdot {C}_{33}+\\sqrt{3}\\cdot {C}_{43} \\\\  & =\\sqrt{2}\\cdot (-1)^{2+3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}+\\sqrt{3}\\cdot (-1)^{4+3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix} \\\\  & =-\\sqrt{2}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ -1 & 1 & -1 \\\\ -2 & 5 & 1\\end{vmatrix}-\\sqrt{3}\\cdot \\begin{vmatrix}1 & 1 & -1 \\\\ 3 & -1 & 1 \\\\ -1 & 1 & -1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186370933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6067ab7f-666f-51fe-a3ad-de2b5d607d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186370935} {:answer/id #uuid "c031e32c-214f-5b2c-8394-eab613b8d9d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186370936} {:answer/id #uuid "cfe9381e-b0ef-5210-b4ea-f2615e9433da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186370937} {:answer/id #uuid "7d661da1-7cdc-5100-b6d8-e9dfbca11fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186370938} {:answer/id #uuid "e88af25c-0464-5342-b56b-d091bcd4dd1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186370939}] :answer-field/correct {:db/id #edb/ref 17592186370939} :answer-field/id #uuid "8e5bc926-a168-5bf8-9c60-65f432035bc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370934}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe1a4bd6-0ca7-5877-a7c4-a06ff6754131" :question/math-academy-id "q-42106" :question/problem "Compute the following determinant using a cofactor expansion along the $3$rd row:\n\n$$\n\\begin{vmatrix}2 & 3 & 0 & 0 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 0 & -1 & 1\\end{vmatrix}\n$$" :question/worked-solution "Using cofactor expansion along the third row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 3 & 0 & 0 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 0 & -1 & 1\\end{vmatrix} & =0\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+2}\\cdot \\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 1 & -1 & 1\\end{vmatrix} \\\\  & =-2\\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 1 & -1 & 1\\end{vmatrix}\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 1 & -1 & 1\\end{vmatrix} & =2\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =2\\cdot (-1)^{1+1}\\cdot \\begin{vmatrix}1 & 2 \\\\ -1 & 1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}1 & 2 \\\\ -1 & 1\\end{vmatrix} \\\\  & =2(1\\cdot 1-2\\cdot (-1)) \\\\  & =2\\cdot 3 \\\\  & =6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}2 & 3 & 0 & 0 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 0 & -1 & 1\\end{vmatrix}=-2\\cdot 6=-12.\n$$"}] [{:db/id #edb/ref 17592186371077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4136cbe3-0e51-5894-9db2-0b5720c6937d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186371079} {:answer/id #uuid "9675a04a-b132-5d93-b85b-92a4e236cb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "116" :db/id #edb/ref 17592186371080} {:answer/id #uuid "2ca29f97-3356-53c7-aca4-9390ad0dc517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "201" :db/id #edb/ref 17592186371081} {:answer/id #uuid "cb6c6e57-06f4-5117-bb87-036736e8cd06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186371082} {:answer/id #uuid "3c10fb02-e2c8-5f7e-bf76-33ecc7934fac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186371083}] :answer-field/correct {:db/id #edb/ref 17592186371082} :answer-field/id #uuid "3ca3f24d-5ce2-5c3a-aa5b-7f7ec9ca8da3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371078}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "92efbe12-f093-58f1-a6e2-e6fbb71066d5" :question/math-academy-id "q-77486" :question/problem "Compute the following determinant using a cofactor expansion along the $4$th row:\n\n$$\n\\begin{vmatrix}1 & 2 & 4 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & -2 & 4 \\\\ 3 & 0 & 0 & 1\\end{vmatrix}.\n$$" :question/worked-solution "Using cofactor expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 & 4 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & -2 & 4 \\\\ 3 & 0 & 0 & 1\\end{vmatrix} & =3\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+1\\cdot {C}_{44} \\\\  & =3\\cdot (-1)^{4+1}\\cdot \\begin{vmatrix}2 & 4 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & -2 & 4\\end{vmatrix}+1\\cdot (-1)^{4+4}\\cdot \\begin{vmatrix}1 & 2 & 4 \\\\ 1 & 2 & 0 \\\\ 0 & 1 & -2\\end{vmatrix} \\\\  & =-3\\begin{vmatrix}2 & 4 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & -2 & 4\\end{vmatrix}+1\\begin{vmatrix}1 & 2 & 4 \\\\ 1 & 2 & 0 \\\\ 0 & 1 & -2\\end{vmatrix}.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain: \n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 4 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & -2 & 4\\end{vmatrix} & =2\\cdot {C}_{21}+0\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =2\\cdot (-1)^{2+1}\\cdot \\begin{vmatrix}4 & 1 \\\\ -2 & 4\\end{vmatrix} \\\\  & =-2\\begin{vmatrix}4 & 1 \\\\ -2 & 4\\end{vmatrix} \\\\  & =-2(16-(-2)) \\\\  & =-36\\end{aligned}\n$$\n\n \nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along its $3$rd row:\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 & 4 \\\\ 1 & 2 & 0 \\\\ 0 & 1 & -2\\end{vmatrix} & =0\\cdot {C}_{31}+1\\cdot {C}_{32}+(-2)\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+2}\\cdot \\begin{vmatrix}1 & 4 \\\\ 1 & 0\\end{vmatrix}+(-2)\\cdot (-1)^{3+3}\\cdot \\begin{vmatrix}1 & 2 \\\\ 1 & 2\\end{vmatrix} \\\\  & =-\\begin{vmatrix}1 & 4 \\\\ 1 & 0\\end{vmatrix}-2\\begin{vmatrix}1 & 2 \\\\ 1 & 2\\end{vmatrix} \\\\  & =-(0-4)-2(2-2) \\\\  & =4+0 \\\\  & =4\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & -2 & 4 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & -2 & 4 \\\\ 3 & 0 & 0 & 0\\end{vmatrix}=-3\\cdot (-36)+1\\cdot 4=112.\n$$"}] [{:db/id #edb/ref 17592186377575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef27079c-3542-5d3e-bc44-a225b391f6ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}x=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}$ has no solution" :db/id #edb/ref 17592186377577} {:answer/id #uuid "e67014f4-561a-53c1-8c6e-d986ff1ae582" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}}^{-1}$ exists" :db/id #edb/ref 17592186377578} {:answer/id #uuid "3c99949c-f081-559e-b33e-2dfefd50e777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ has no solution" :db/id #edb/ref 17592186377579} {:answer/id #uuid "5b47b2fb-b980-5195-8c81-c9bfb43d742b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "det\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}=0" :db/id #edb/ref 17592186377580} {:answer/id #uuid "0a9ae3ac-866f-5d3d-a9a4-43f6a5b5eb71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}$ is singular" :db/id #edb/ref 17592186377581}] :answer-field/correct {:db/id #edb/ref 17592186377578} :answer-field/id #uuid "87aa0349-8538-5cc0-aad6-50db447fcd97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377576}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8426bbc0-cdc8-595a-941b-da128b255dca" :question/math-academy-id "q-36067" :question/problem "Consider the lines $3y-kx=3$ and $x+2y=0$, where $k$ is a constant. If both intersect at one point, then" :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nAccording to the invertible matrix theorem, if the lines $-kx+3y=3$ and $x+2y=0$ intersect at one point, then\n\n$$\nA=\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}\n$$\n\nis invertible and $det(A)\\ne 0$, which implies that ${A}^{-1}$ exists ($A$ is non-singular). Additionally, the unique solution of $Ax=0$ is $x=⟨0,0⟩$ and\n\n$$\n\\begin{bmatrix}-k & 3 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}\n$$\n\nhas exactly one solution, which is the intersection point of the lines."}] [{:db/id #edb/ref 17592186377668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dbd8a41-022e-505a-9a23-5897ee2615d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453946} {:answer/id #uuid "e964dc82-e823-526c-bb4e-d9d86b715c3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453947}] :answer-field/correct {:db/id #edb/ref 17592186453946} :answer-field/id #uuid "fd5d2420-05be-505d-a6da-9370564b875a" :answer-field/key "$A$ is **not** invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454723} {:answer-field/choices [{:answer/id #uuid "5bfaf3e3-c8c3-5b0f-905a-7cfc3c188946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453948} {:answer/id #uuid "8e7b77cf-0808-52a0-92c8-aef31c85857a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453949}] :answer-field/correct {:db/id #edb/ref 17592186453949} :answer-field/id #uuid "b912caf2-b2fa-5b75-b5a5-849cbfd33c40" :answer-field/key "The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454724} {:answer-field/choices [{:answer/id #uuid "581a4ee7-2ef6-5d6a-8a10-f2e80e510c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453950} {:answer/id #uuid "b85c6ec3-9718-5d84-925f-86b8f81442df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453951}] :answer-field/correct {:db/id #edb/ref 17592186453950} :answer-field/id #uuid "74197001-61cf-522e-acb4-234d12a1ff07" :answer-field/key "$Ax=0$ has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aafb0544-5c12-5527-bc2a-2417215aad99" :question/math-academy-id "q-73566" :question/problem "Let \n$$\n\\displaystyle A=\\begin{bmatrix}2 & -3 \\\\ 2 & -2\\end{bmatrix}.\n$$\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & -3 \\\\ 2 & -2\\end{bmatrix} \\\\  & =2\\cdot (-2)-(-3)\\cdot 2 \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement “$A$ is **not** invertible” is false by the first part of the invertible matrix theorem.\n\n- Statement “The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point” is true by the fourth part of the invertible matrix theorem.\n\n- Statement “$Ax=0$ has no solution” is false since, according to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement “The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point” is true."}] [{:db/id #edb/ref 17592186383279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8041691-268c-5a30-acce-47ccca7f0445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}0 & -1 \\\\ -1 & 6\\end{bmatrix}" :db/id #edb/ref 17592186383281} {:answer/id #uuid "edfbb615-a450-5dc4-aacd-a424a91fb862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186383282} {:answer/id #uuid "4f8cd2b2-34bd-55b3-9e41-1b61002f829b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 1 & 6\\end{bmatrix}" :db/id #edb/ref 17592186383283} {:answer/id #uuid "322543cc-7484-5646-b47f-5bdcc02b8f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}0 & 6 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186383284} {:answer/id #uuid "613005e9-bbde-5477-b41f-7ecc34c6fb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}-6 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186383285}] :answer-field/correct {:db/id #edb/ref 17592186383283} :answer-field/id #uuid "6c3d9194-2253-57bb-9738-68e618b12cd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383280}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc5890e5-c245-5798-b10d-ed7cf51b232f" :question/math-academy-id "q-131382" :question/problem "The inverse of the $2\\times 2$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}-6 & 1 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & :={R}_{1}+6{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 6 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}-6 & 1 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & :={R}_{1}+6{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 6 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ 0 & 1 & 1 & 6\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 1 & 6\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186383286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b273511-a7cc-5c6a-9dd8-0abe26274e77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{2}{R}_{1},\\,{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186383288} {:answer/id #uuid "90009beb-fdae-54f4-a1be-b67a0e2f37d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2},\\,{R}_{2}:={R}_{2}-2{R}_{1}" :db/id #edb/ref 17592186383289} {:answer/id #uuid "d949a385-01a3-547e-bde2-e99e2407774c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}" :db/id #edb/ref 17592186383290} {:answer/id #uuid "f51e7881-94f1-58ab-ab06-c8b6f7294763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=-\\frac{1}{2}{R}_{1},\\,{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186383291} {:answer/id #uuid "32471165-41bc-5064-a412-16c9c2cff15b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2},\\,{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186383292}] :answer-field/correct {:db/id #edb/ref 17592186383292} :answer-field/id #uuid "177d43b0-3c90-586e-81e2-8ae60e0195aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383287}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0502d3a-1260-56b0-b010-809a7a1a12de" :question/math-academy-id "q-131980" :question/problem "The inverse of the matrix $A$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =\\left[\\begin{array}{cc|cc}-2 & 1 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] &  & \\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ -2 & 1 & 1 & 0\\end{array}\\right] &  & \\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ 0 & 1 & 1 & 2\\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =\\left[\\begin{array}{cc|cc}-2 & 1 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ -2 & 1 & 1 & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 0 & 1 \\\\ 0 & 1 & 1 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}↔{R}_{2},\\,{R}_{2}:={R}_{2}+2{R}_{1}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 1 & 2\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186385599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "674336a4-b105-5a0d-9b10-8a9e7e59c95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}^{-1}=\\begin{bmatrix}-1 & 1 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186385601} {:answer/id #uuid "b20bd4f0-7b0f-54e1-8345-de02b00633b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}^{-1}=\\begin{bmatrix}1 & 1 \\\\ -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186385602} {:answer/id #uuid "16490cb2-5c59-515e-a4bc-2e6c361b8cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}^{-1}=\\begin{bmatrix}-3 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186385603} {:answer/id #uuid "cd65824d-f795-59d6-a193-22844e26e3b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}^{-1}=\\begin{bmatrix}3 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186385604} {:answer/id #uuid "27301e23-f9ae-5b7a-a33f-21e345390422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}^{-1}=\\begin{bmatrix}-1 & 3 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186385605}] :answer-field/correct {:db/id #edb/ref 17592186385603} :answer-field/id #uuid "719b51bc-b278-50ec-af37-3f69c5c7e57f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc5f69a3-44de-59cd-8de4-103061c156c4" :question/math-academy-id "q-75607" :question/problem "The inverse of the $2\\times 2$ matrix $S$ is found using row operations, as shown below. Complete the process, and determine ${S}^{-1}.$\n\n$$\n\\begin{aligned}[S\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 0 \\\\ 1 & 3 & 0 & 1\\end{array}\\right] & {R}_{2} & ↔{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 3 & 0 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right] & {R}_{1} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $S$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $S$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[S\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 0 \\\\ 1 & 3 & 0 & 1\\end{array}\\right] & {R}_{2} & ↔{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 3 & 0 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & -3 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${S}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{S}^{-1}=\\begin{bmatrix}-3 & 1 \\\\ 1 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186386048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc295251-8992-58af-99ad-555c55679954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{6}\\begin{bmatrix}2 & 3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386050} {:answer/id #uuid "fa3e33dc-c2fa-5ce8-a74b-cafe4387cbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386051} {:answer/id #uuid "afb508cc-f7c7-553c-b844-811d03f18621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}-2 & -3 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386052} {:answer/id #uuid "38618689-5610-50ab-b2fe-e981dfe08e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386053} {:answer/id #uuid "e35c6576-aa93-5aa2-bc00-3b5fc1b8c2d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386054}] :answer-field/correct {:db/id #edb/ref 17592186386053} :answer-field/id #uuid "a482c228-62c7-528d-a980-052fac0d225f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f36e193-cfb7-556d-862d-7ca0f147ebca" :question/math-academy-id "q-102799" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}3y &=-x \\\\ 2y &=1\\end{aligned}\\right.\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}x+3y &=0 \\\\ 2y &=1.\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-0\\cdot 3}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a82d5f6-66f3-5522-a100-e2f8dae13966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & -2 \\\\ 2 & -5\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186387320} {:answer/id #uuid "629adac7-7e11-5b16-8d75-97adcdbde8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}5 & 2 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186387321} {:answer/id #uuid "1bbc0dc2-d7b9-50b2-a002-118c594c07e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & 2 \\\\ 2 & 5\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186387322} {:answer/id #uuid "08ad482e-16a9-5965-ad6e-397324dce8bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-5 & 2 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186387323} {:answer/id #uuid "6be35ef2-6065-55cf-b015-361f21dd7ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-1 & 2 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186387324}] :answer-field/correct {:db/id #edb/ref 17592186387320} :answer-field/id #uuid "299f6ec7-a02a-58c0-aab8-a90cf14d427a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387319}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33942b97-95c2-5a05-bee1-52e88505e10f" :question/math-academy-id "q-12284" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}5x-2y &=3 \\\\ 2x-y &=5\\end{aligned}\\right.\n$$" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}5 & -2 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}5 & -2 \\\\ 2 & -1\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot (-1)-(-2)\\cdot 2}\\begin{bmatrix}-1 & 2 \\\\ -2 & 5\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}-1 & 2 \\\\ -2 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -5\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -5\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "948eac23-81d2-5cc0-800b-0edc863e2953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}2 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388211} {:answer/id #uuid "952de722-8203-5743-8593-c71db966ae3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}-2 & -1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388212} {:answer/id #uuid "cce08128-0360-55fa-b3b2-a44378c80726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388213} {:answer/id #uuid "d7a26f5d-0602-5ec5-83d9-2aa6bd1bdcf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}0 & 1 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388214} {:answer/id #uuid "d1eda9a4-a5ea-5838-86e1-566847652b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=\\begin{bmatrix}-2 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388215}] :answer-field/correct {:db/id #edb/ref 17592186388213} :answer-field/id #uuid "788280f7-1f4b-5462-8a7a-cd446a5868f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23d98e62-6043-5354-9621-545d60a12bf3" :question/math-academy-id "q-131379" :question/problem "The inverse of the $2\\times 2$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 0 \\\\ 1 & -2 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & -2 & 0 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right] & {R}_{1} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}0 & 1 & 1 & 0 \\\\ 1 & -2 & 0 & 1\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & -2 & 0 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186390694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad3e10c2-e2f1-58e8-b2f9-00f2c4c2df6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{31}\\begin{bmatrix}3 & -2 \\\\ 8 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390696} {:answer/id #uuid "30e4ebf6-13b6-590d-9607-b5715eb73e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-3 & -2 \\\\ 8 & -5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390697} {:answer/id #uuid "7aac971d-5512-509f-afcf-e37b9c5bd0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{31}\\begin{bmatrix}5 & 2 \\\\ -8 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390698} {:answer/id #uuid "de4d0df2-2d46-543e-b9bd-33d2e628c41a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{31}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390699} {:answer/id #uuid "496d8420-4ee1-5bb7-a84d-0f998d3229fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}5 & 2 \\\\ -8 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390700}] :answer-field/correct {:db/id #edb/ref 17592186390699} :answer-field/id #uuid "23bd791b-3244-5621-8d76-a43da7beeff2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c60618eb-8102-5d29-9fef-37f3fce33d0e" :question/math-academy-id "q-32026" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}5x-2y &=1 \\\\ 8x+3y &=0\\end{aligned}\\right.\n$$" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}5 & -2 \\\\ 8 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}5 & -2 \\\\ 8 & 3\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 3-(-2)\\cdot 8}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix} \\\\  & =\\frac{1}{31}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{31}\\begin{bmatrix}3 & 2 \\\\ -8 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2cf0dd5-0db7-57a2-9870-1611db6da665" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390713} {:answer/id #uuid "be6ce68f-4c42-58da-863b-b22d6376ce30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-3 & -1 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390714} {:answer/id #uuid "333a570b-447e-5d5d-9439-65c7fcbb64c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{5}\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390715} {:answer/id #uuid "ae5e534f-499c-5a4d-9bd0-1ecbfeee8157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390716} {:answer/id #uuid "f518abcf-bf8c-56aa-bf15-d5e00e0d770d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & 1 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186390717}] :answer-field/correct {:db/id #edb/ref 17592186390716} :answer-field/id #uuid "89bea882-0921-5708-a9f9-9d676afb881e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390712}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffd8425a-ff52-5722-b741-7d19394751e5" :question/math-academy-id "q-32136" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}x-y &=-1 \\\\ 2x+3y &=0\\end{aligned}\\right.\n$$" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}1 & -1 \\\\ 2 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}1 & -1 \\\\ 2 & 3\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 3-(-1)\\cdot 2}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af53f340-3e36-5545-937e-11e307962671" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/va