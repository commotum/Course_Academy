}5 \\\\ -1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}0 & 7 \\\\ 2 & 3\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{0\\cdot 3-2\\cdot 7}\\begin{bmatrix}3 & -7 \\\\ -2 & 0\\end{bmatrix} \\\\  & =-\\frac{1}{14}\\begin{bmatrix}3 & -7 \\\\ -2 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{14}\\begin{bmatrix}3 & -7 \\\\ -2 & 0\\end{bmatrix}\\begin{bmatrix}5 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0812d2a5-bb6d-5016-84db-0f8c91f4d4be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186297592}] :answer-field/correct {:db/id #edb/ref 17592186297592} :answer-field/id #uuid "26caa8df-d3a5-5187-bfe8-9ab955f16c53" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298766} {:answer-field/choices [{:answer/id #uuid "fd1de317-b881-5416-b852-3e38e3537d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298637}] :answer-field/correct {:db/id #edb/ref 17592186298637} :answer-field/id #uuid "7626fd6f-e27b-5461-9199-8699cba490c9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299037} {:answer-field/choices [{:answer/id #uuid "3ca15a1b-6bd0-5856-96e2-aebad025ac12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297793}] :answer-field/correct {:db/id #edb/ref 17592186297793} :answer-field/id #uuid "b8abe9c9-a856-5d4e-8a5a-046101a2875b" :answer-field/key "field-2