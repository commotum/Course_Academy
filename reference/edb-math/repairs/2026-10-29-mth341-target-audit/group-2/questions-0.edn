end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}-1 & 3 \\\\ -4 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{10}\\begin{bmatrix}-1 & 3 \\\\ -4 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f76438-6efc-5154-acf2-f6221ba718ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & 2 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186236280} {:answer/id #uuid "5f9a3a70-ee22-53c6-95ac-a12143b1c2c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}1 & 2 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186236424} {:answer/id #uuid "96729604-fadb-5569-aa87-61777a5842be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-1 & 2 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186236771} {:answer/id #uuid "bc5d3eee-3c13-550d-bfe1-19982b6b6b11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-1 & -2 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186237020} {:answer/id #uuid "e80f65f0-a584-5cc5-9b86-6e7afa185455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}1 & -2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186237279}] :answer-field/correct {:db/id #edb/ref 17592186236280} :answer-field/id #uuid "82a38cc5-62a7-5b61-a58b-db932ec1135d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237613}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f4997ea-9df4-5b85-a287-2f793d51b1ec" :question/math-academy-id "q-102807" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}2y &=x+3 \\\\ 7-y &=-x\\end{aligned}\\right.\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\left\\{\\begin{aligned}-x+2y &=3 \\\\ x-y &=-7.\\end{aligned}\\right.\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}-1 & 2 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}-1 & 2 \\\\ 1 & -1\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot (-1)-1\\cdot 2}\\begin{bmatrix}-1 & -2 \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}-1 & -2 \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc29ab4-d8ac-5d3d-979b-9f7f98f139d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{10}\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186236107} {:answer/id #uuid "3de44d48-7c55-5446-89cc-29fd5806f50b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186236202} {:answer/id #uuid "a8e5c08a-cb31-58b8-b1f4-396df518bf90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186236877} {:answer/id #uuid "ab4ec5f6-1181-5431-9305-03d19df17f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-3 & -1 \\\\ -4 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186236903} {:answer/id #uuid "f2a76ae9-5747-59ff-a6cf-cd7f572a7402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186237348}] :answer-field/correct {:db/id #edb/ref 17592186237348} :answer-field/id #uuid "07e11cc4-ab12-593a-b925-941a0b313fdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237452}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af582baa-848b-5255-869a-b91da71ab3e4" :question/math-academy-id "q-102808" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}2x-3 &=y \\\\ 3y &=4x+2\\end{aligned}\\right.\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ -4x+3y &=2.\\end{aligned}\\right.\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}2 & -1 \\\\ -4 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}2 & -1 \\\\ -4 & 3\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 3-(-4)\\cdot (-1)}\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}3 & 1 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65244d9b-e076-530c-a369-4480f47d9556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{20}\\begin{bmatrix}5 & -3 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186236459} {:answer/id #uuid "771d3b5c-5ed2-5f37-bd7a-fbfa57df0d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{20}\\begin{bmatrix}5 & -3 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186236566} {:answer/id #uuid "863438cb-8b5e-556d-b853-0da07e2effb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{14}\\begin{bmatrix}-4 & -3 \\\\ 2 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186236652} {:answer/id #uuid "868772fc-96c1-56f7-83c3-16a475c414d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{14}\\begin{bmatrix}-4 & 3 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186236654} {:answer/id #uuid "c4a74150-e44f-5676-97b9-fe72216cdb78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{14}\\begin{bmatrix}-4 & -3 \\\\ 2 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186237060}] :answer-field/correct {:db/id #edb/ref 17592186237060} :answer-field/id #uuid "bb07b2ee-24d6-5edd-9fd3-03d48f69b538" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237679}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "67ac7207-89ed-556a-b760-e125b88ef308" :question/math-academy-id "q-102809" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}5x &=1-3y \\\\ 3-4y &=2x\\end{aligned}\\right.\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\left\\{\\begin{aligned}5x+3y &=1 \\\\ -2x-4y &=-3.\\end{aligned}\\right.\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}5 & 3 \\\\ -2 & -4\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}5 & 3 \\\\ -2 & -4\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot (-4)-(-2)\\cdot 3}\\begin{bmatrix}-4 & -3 \\\\ 2 & 5\\end{bmatrix} \\\\  & =-\\frac{1}{14}\\begin{bmatrix}-4 & -3 \\\\ 2 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{14}\\begin{bmatrix}-4 & -3 \\\\ 2 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064de0c7-096b-5389-8080-9e2ae4764534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-1 & 1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186250605} {:answer/id #uuid "3e8d8a83-b90f-5180-90d6-a020b14121fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-1 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186251073} {:answer/id #uuid "9b08396c-9b9b-50dc-a08e-c834744fe172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-1 & 2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186251888} {:answer/id #uuid "d5eb9222-6c0e-556f-b560-f04038c06a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & 1 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186252447} {:answer/id #uuid "f1422872-4bb2-5409-903a-825ff487dfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}1 & -1 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186252661}] :answer-field/correct {:db/id #edb/ref 17592186250605} :answer-field/id #uuid "c19d993e-cabe-5e7a-9e34-3aaa832bda0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253139}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b922ce0-59e6-5533-889a-0b37907617d2" :question/math-academy-id "q-11981" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}x-y &=4 \\\\ 2x-y &=5\\end{aligned}\\right.\n$$" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}1 & -1 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}1 & -1 \\\\ 2 & -1\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot (-1)-(-1)\\cdot 2}\\begin{bmatrix}-1 & 1 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ -2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a999a1bb-7ac8-55d2-8393-2961fe8f6692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}6 & -4 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186255168} {:answer/id #uuid "bad09301-d962-5451-8ac9-40479b90b545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2}\\begin{bmatrix}1 & 4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186255333} {:answer/id #uuid "c59330f8-e12e-592e-8afa-3159508c866a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}1 & 4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186255437} {:answer/id #uuid "cd20ba9f-fc2f-5364-8d37-2189aa419900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2}\\begin{bmatrix}6 & 1 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186255493} {:answer/id #uuid "cfad5070-eeb4-522e-a3e7-6957328ebff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}1 & -4 \\\\ -1 & 6\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186255521}] :answer-field/correct {:db/id #edb/ref 17592186255437} :answer-field/id #uuid "3b18a69d-d021-519e-8b4b-74ae20efe383" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256031}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cdc942f-b397-593d-89df-c73bdf9f84fc" :question/math-academy-id "q-12285" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}6x-4y &=2 \\\\ -x+y &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}6 & -4 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}6 & -4 \\\\ -1 & 1\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 1-(-4)\\cdot (-1)}\\begin{bmatrix}1 & 4 \\\\ 1 & 6\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 4 \\\\ 1 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"}]}
