& 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}" :db/id #edb/ref 17592186323144}] :answer-field/correct {:db/id #edb/ref 17592186322717} :answer-field/id #uuid "9c1fe6f0-fefd-5d07-bd73-536b734ab2ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5116353-6062-5b65-a3e1-05950bfbb7b0" :question/math-academy-id "q-36221" :question/problem "$$\n\\displaystyle \\begin{vmatrix}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{vmatrix}=\n$$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{vmatrix} & =0\\cdot {C}_{31}+(-5)\\cdot {C}_{32}+(-5)\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =(-5)\\cdot (-1)^{3+2}\\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}+(-5)\\cdot (-1)^{3+3}\\cdot \\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix} \\\\  & =5\\cdot \\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}-5\\cdot \\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac7088fd-91ec-5f65-a3a0-66351d709298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5 \\cdot\\begin{vmatrix}2 & 1 & -3 \\\\ 1 & 6 & -2 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118539} {:answer/id #uuid "d73bd2c1-7553-53b7-8bb0-d54e6a1c3e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 \\cdot\\begin{vmatrix}2 & 1 & -3 \\\\ 1 & 6 & -2 \\\\ -1 & 1 & 2\\end{vmatrix}-\\begin{vmatrix}2 & 1 & -3 \\\\ 2 & -2 & 4 \\\\ 1 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186118540} {:answer/id #uuid "126eb8c8-5841-57fc-a8c4-e7c7a7c3d686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5 \\cdot\\begin{vmatrix}2 & 1 & -3 \\\\ 1 & 6 & -2 \\\\ -1 & 1 & 2\\end{vmatrix}+\\begin{vmatrix}2 & 1 & -3 \\\\ 2 & -2 & 4 \\\\ 1 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186118541} {:answer/id #uuid "1286544d-d34a-50f5-8bb5-3bbcfc10eed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5 \\cdot\\begin{vmatrix}2 & 1 & -3 \\\\ 1 & 6 & -2 \\\\ -1 & 1 & 2\\end{vmatrix}-\\begin{vmatrix}2 & 1 & -3 \\\\ 2 & -2 & 4 \\\\ 1 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186118542} {:answer/id #uuid "25cb3a8a-32ea-5429-bff7-3c8afd6cb5d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 \\cdot\\begin{vmatrix}2 & 1 & -3 \\\\ 1 & 6 & -2 \\\\ -1 & 1 & 2\\end{vmatrix}+\\begin{vmatrix}2 & 1 & -3 \\\\ 2 & -2 & 4 \\\\ 1 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186118543}] :answer-field/id #uuid "e5ec8331-3600-5e02-8b08-885aea3977a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118538}] :question/id #uuid "ca38aeec-dd7c-5ece-9b79-dcabf88c42fa" :question/math-academy-id "q-36224" :question/problem "What is $\\begin{vmatrix}2 & 1 & 0 & -3 \\\\ 2 & -2 & -5 & 4 \\\\ 1 & 6 & 0 & -2 \\\\ -1 & 1 & 1 & 2\\end{vmatrix}$?"}] [{:db/id #edb/ref 17592186120423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fed8988-0c94-5b15-a56e-7110ec959a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186392463} {:answer/id #uuid "30cf3edb-0792-5623-86f8-5c988853740c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186392464} {:answer/id #uuid "d9872f80-aa54-5895-978e-95ad891888fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot \\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186392465} {:answer/id #uuid "215dc55c-579c-514a-843e-102fb53ed1a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot \\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186392466} {:answer/id #uuid "4108826d-2244-50a4-9d7d-01a548e69167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot \\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186392467}] :answer-field/correct {:db/id #edb/ref 17592186392465} :answer-field/id #uuid "177f17fc-1d2f-5875-85e5-6d7641740557" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "321c9319-feb5-5099-bb29-b08dbc237dd2" :question/math-academy-id "q-42094" :question/problem "$$\n\\displaystyle \\begin{vmatrix}1 & 0 & -3 & 1 \\\\ 1 & 0 & 1 & 9 \\\\ -4 & 0 & 2 & -1 \\\\ -5 & 2 & 4 & 2\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 0 & -3 & 1 \\\\ 1 & 0 & 1 & 9 \\\\ -4 & 0 & 2 & -1 \\\\ -5 & 2 & 4 & 2\\end{vmatrix} & =0\\cdot {C}_{12}+0\\cdot {C}_{22}+0\\cdot {C}_{32}+2\\cdot {C}_{42} \\\\  & =2\\cdot (-1)^{4+2}\\cdot \\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}1 & -3 & 1 \\\\ 1 & 1 & 9 \\\\ -4 & 2 & -1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2645148c-8f0c-59d8-8328-daf1c11c002e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186324280} {:answer/id #uuid "8423c962-04ae-56a6-a351-28d4870327a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186325084} {:answer/id #uuid "8cbab88f-65b0-53c1-8212-e69a999b2288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186325165} {:answer/id #uuid "8ed70273-c8e9-55fc-8960-e486a7629dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325182} {:answer/id #uuid "d57a2363-d584-51bb-988e-accd88178c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186325825}] :answer-field/correct {:db/id #edb/ref 17592186324280} :answer-field/id #uuid "60a39b12-5834-56dc-bd92-b12e1a44915e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326386}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00bb680c-6e72-5c8f-931f-0ff9d17c1cfb" :question/math-academy-id "q-42095" :question/problem "Calculate\n$$\n\\displaystyle \\begin{vmatrix}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{vmatrix}.\n$$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{vmatrix} & =2\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+1\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+1}\\cdot \\begin{vmatrix}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{vmatrix}+1\\cdot (-1)^{3+4}\\cdot \\begin{vmatrix}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{vmatrix} \\\\  & =2\\begin{vmatrix}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{vmatrix}-\\begin{vmatrix}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{vmatrix}.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{vmatrix} & =1\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+1}\\cdot \\begin{vmatrix}1 & -1 \\\\ -2 & 1\\end{vmatrix}+2\\cdot (-1)^{3+2}\\cdot \\begin{vmatrix}2 & -1 \\\\ -4 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ -2 & 1\\end{vmatrix}-2\\begin{vmatrix}2 & -1 \\\\ -4 & 1\\end{vmatrix} \\\\  & =(1-2)-2(2-4) \\\\  & =-1+4 \\\\  & =3\\end{aligned}\n$$\n\nNow, computing the second $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{vmatrix} & =0\\cdot {C}_{21}+(-4)\\cdot {C}_{22}+(-2)\\cdot {C}_{23} \\\\  & =(-4)\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}1 & 1 \\\\ -3 & 2\\end{vmatrix}+(-2)\\cdot (-1)^{2+3}\\cdot \\begin{vmatrix}1 & 2 \\\\ -3 & 1\\end{vmatrix} \\\\  & =-4\\begin{vmatrix}1 & 1 \\\\ -3 & 2\\end{vmatrix}+2\\begin{vmatrix}1 & 2 \\\\ -3 & 1\\end{vmatrix} \\\\  & =-4(2+3)+2(1+6) \\\\  & =-20+14 \\\\  & =-6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{vmatrix}=2\\cdot 3-(-6)=12.\n$$"}] [{:db/id #edb/ref 17592186120425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "819d8586-5eea-5e34-b50c-421d163d1a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186118665} {:answer/id #uuid "0cad95a9-c08b-5a7d-bc34-f5eef8e5c070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186118666} {:answer/id #uuid "479e9e2e-e06e-5031-94a1-c70bace159ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186118667} {:answer/id #uuid "5b11b433-8691-5ee4-b8ed-85da94b9d41b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186118668} {:answer/id #uuid "683b14ae-9a2d-592d-a551-ef9ad96ef2fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186118669}] :answer-field/id #uuid "99cee47c-f5d8-5093-8004-e516e2380918" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118664}] :question/id #uuid "1c3e37f2-7f08-5c72-b37d-bf0e0953e983" :question/math-academy-id "q-42105" :question/problem "Compute the following determinant using a cofactor expansion along the $2$nd row:\n$$\n\\displaystyle \\begin{vmatrix}0 & 0 & 2 & 2 \\\\ 0 & 1 & 0 & 0 \\\\ 1 & 0 & 1 & -1 \\\\ 2 & 1 & 0 & 0\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186124331 :question/id #uuid "4b2fcf5d-0da3-5676-b4c6-54095c3fb45c" :question/math-academy-id "e-5486" :question/problem "Determine all real eigenvalues $\\lambda$ of the matrix \n$$\nA=\n{\\left[ \\begin{array}{ccc}- 9 & 4 & 8 \\\\ 0 & 9 & - 7 \\\\ 0 & 0 & 6\\end{array} \\right]}.\n$$" :question/worked-solution "First, we find the matrix $\\, A-\\lambda I \\mathbin{:}$\n﻿﻿﻿$$\n\\displaystyle A - \\lambda I = \n{\\left[ \\begin{array}{ccc}- 9 - \\lambda  & 4 & 8 \\\\ 0 & 9 - \\lambda  & - 7 \\\\ 0 & 0 & 6 - \\lambda \\end{array} \\right]}\n$$\n\nThe characteristic equation is $\\det(A-\\lambda I) = 0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-9-\\lambda  & 4 & 8 \\\\ 0 & 9-\\lambda  & -7 \\\\ 0 & 0 & 6-\\lambda \\end{vmatrix} & =0 \\\\ (-9-\\lambda )(9-\\lambda )(6-\\lambda ) & =0 \\\\ (\\lambda +9)(\\lambda -9)(\\lambda -6) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda_1=-9,$ $\\lambda_2=9,$ and $\\lambda_3=6.$ \n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are always the entries on the main diagonal."}] [{:db/id #edb/ref 17592186124332 :question/id #uuid "76c52a74-9b98-5df5-ac63-64e92af1a580" :question/math-academy-id "e-5487" :question/problem "Determine all real eigenvalues $\\lambda$ of the matrix \n$$\nA=\n{\\left[ \\begin{array}{ccc}1 & - 1 & - 2 \\\\ - 1 & 1 & - 2 \\\\ - 2 & - 2 & - 7\\end{array} \\right]}.\n$$" :question/worked-solution "First, we find the matrix $A-\\lambda I{:}$\n﻿﻿﻿$$\n\\displaystyle A - \\lambda I = \n{\\left[ \\begin{array}{ccc}1 - \\lambda  & - 1 & - 2 \\\\ - 1 & 1 - \\lambda  & - 2 \\\\ - 2 & - 2 & - 7 - \\lambda \\end{array} \\right]}\n$$\n\nThe characteristic equation is given by $\\det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{array}{cc}\\det  ( A - \\lambda  I ) &  = 0 \\\\ \\left| \\begin{array}{ccc}1 - \\lambda  & - 1 & - 2 \\\\ - 1 & 1 - \\lambda  & - 2 \\\\ - 2 & - 2 & - 7 - \\lambda \\end{array} \\right| &  = 0 \\\\ ( 1 - \\lambda  ) \\left| \\begin{array}{cc}1 - \\lambda  & - 2 \\\\ - 2 & - 7 - \\lambda \\end{array} \\right| - ( - 1 ) \\left| \\begin{array}{cc}- 1 & - 2 \\\\ - 2 & - 7 - \\lambda \\end{array} \\right| + ( - 2 ) \\left| \\begin{array}{cc}- 1 & 1 - \\lambda  \\\\ - 2 & - 2\\end{array} \\right| &  = 0 \\\\ ( - {\\lambda }^{3} - 5 {\\lambda }^{2} + 17 \\lambda  - 11 ) + ( 3 + \\lambda  ) - 2 ( 4 - 2 \\lambda  ) &  = 0 \\\\ - {\\lambda }^{3} - 5 {\\lambda }^{2} + 22 \\lambda  - 16 &  = 0 \\\\ {\\lambda }^{3} + 5 {\\lambda }^{2} - 22 \\lambda  + 16 &  = 0\\end{array}\n$$\n\nNow, we need to solve this equation. We find the first root by testing some values. According to the rational zeros theorem, a list of good first guesses consists of all divisors of $16\\mathbin{:}$ \n$$\n\\pm1, \\pm2, \\pm4, \\pm8, \\pm 16\n$$\n\nLet's pick $\\lambda=1.$ Substituting to the characteristic equation gives\n$$\n\\begin{array}{rl}\\displaystyle ( 1 {)}^{3} + 5 ( 1 {)}^{2} - 22 ( 1 ) + 16 & \\displaystyle  = 0.\\end{array}\n$$\nSo, $\\lambda=1$ is a root of the equation. This means we can factor $(\\lambda-1)$ out of $\\lambda^3 +5 \\lambda^2 - 22 \\lambda + 16$ using synthetic division:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\" data-border-top=\"none\" data-border-right=\"solid\" data-border-bottom=\"none\" data-border-left=\"none\">$1$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$1$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$5$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$-22$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$16$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"solid\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"solid\" data-border-left=\"none\">$\\color{lightgray}\\downarrow$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"solid\" data-border-left=\"none\">$1$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"solid\" data-border-left=\"none\">$6$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"solid\" data-border-left=\"none\">$-16$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$1$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$6$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$-16$</td>\n<td data-cell-align=\"center\" data-fill=\"#EEEEEE\" data-border-top=\"solid\" data-border-right=\"solid\" data-border-bottom=\"solid\" data-border-left=\"solid\">$0$</td>\n</tr>\n</tbody></table></div>\n\n\nSo, we obtain the following factorization:\n$$\n\\begin{aligned}\n(λ - 1)(λ^{2} + 6λ - 16) &= 0 \\\\\n(λ - 1)(λ - 2)(λ + 8) &= 0\n\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda_1=1,$ $\\lambda_2=2,$ and $\\,\\lambda_3=-8.$"}] [{:db/id #edb/ref 17592186124380 :question/id #uuid "a1c51187-c0a6-505c-bc58-2319b439086e" :question/math-academy-id "e-7047" :question/problem "$$\nP=\n{\\left[ \\begin{array}{cccc}3 & 0 & - 8 & - 2 \\\\ 0 & - 1 & 3 & 5 \\\\ 0 & 0 & 4 & 0 \\\\ 0 & 7 & - 3 & 1\\end{array} \\right]}.\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nI. $\\lambda=4$ is an eigenvalue of $P$\n\nII. $\\lambda=-1$ is an eigenvalue of $P$\n\nIII. The eigenvalue $\\lambda=6$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\, P-\\lambda I \\mathbin{:}$\n﻿﻿﻿$$\n\\displaystyle P - \\lambda I = \n{\\left[ \\begin{array}{cccc}3 - \\lambda  & 0 & - 8 & - 2 \\\\ 0 & - 1 - \\lambda  & 3 & 5 \\\\ 0 & 0 & 4 - \\lambda  & 0 \\\\ 0 & 7 & - 3 & 1 - \\lambda \\end{array} \\right]}\n$$\n\nThe characteristic equation is $\\det(P-\\lambda I) = 0.$ \n\nNotice that we can expand the $4 \\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 0 & -8 & -2 \\\\ 0 & -1-\\lambda  & 3 & 5 \\\\ 0 & 0 & 4-\\lambda  & 0 \\\\ 0 & 7 & -3 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )\\begin{vmatrix}-1-\\lambda  & 3 & 5 \\\\ 0 & 4-\\lambda  & 0 \\\\ 7 & -3 & 1-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3 \\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(3-\\lambda )\\cdot (4-\\lambda )\\begin{vmatrix}-1-\\lambda  & 5 \\\\ 7 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(4-\\lambda )((-1-\\lambda )(1-\\lambda )-35) & =0 \\\\ (3-\\lambda )(4-\\lambda )({\\lambda }^{2}-36) & =0 \\\\ (\\lambda -3)(\\lambda -4)(\\lambda -6)(\\lambda +6) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda=3,$ $\\lambda=4,$ $\\lambda=6,$ and $\\lambda=-6$ (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186125011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414f9370-14a3-5aa6-8486-cea2e27301a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -2)^{2}(\\lambda +1)(\\lambda -5)=0" :db/id #edb/ref 17592186447397} {:answer/id #uuid "457e9051-86d9-52ea-9195-8e29a88ad83f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -2)(\\lambda +1)(\\lambda -5)(\\lambda -1)=0" :db/id #edb/ref 17592186447398} {:answer/id #uuid "691f275b-fd9a-54d9-8586-a64a1a03045b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -2)(\\lambda -5)^{2}(\\lambda +1)=0" :db/id #edb/ref 17592186447409} {:answer/id #uuid "75cdd761-23be-5c11-826b-34cb06e74a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -2)^{2}(\\lambda -5)^{2}=0" :db/id #edb/ref 17592186447415} {:answer/id #uuid "8bcf654c-f10a-5880-a4ae-224b5c7e4e07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -2)(\\lambda -5)(\\lambda +1)^{2}=0" :db/id #edb/ref 17592186447423}] :answer-field/correct {:db/id #edb/ref 17592186447398} :answer-field/id #uuid "34c56093-04e6-5946-b523-0fde12c0770a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122666}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d28aed4f-dd9b-57fa-bc7d-1ecf9008bea3" :question/math-academy-id "q-36819" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle B=\\begin{bmatrix}2 & 5 & 4 & 2 \\\\ 0 & -1 & 5 & 1 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=\\begin{bmatrix}2-\\lambda  & 5 & 4 & 2 \\\\ 0 & -1-\\lambda  & 5 & 1 \\\\ 0 & 0 & 5-\\lambda  & 1 \\\\ 0 & 0 & 0 & 1-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 5 & 4 & 2 \\\\ 0 & -1-\\lambda  & 5 & 1 \\\\ 0 & 0 & 5-\\lambda  & 1 \\\\ 0 & 0 & 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-1-\\lambda )(5-\\lambda )(1-\\lambda ) & =0 \\\\ (\\lambda -2)(\\lambda +1)(\\lambda -5)(\\lambda -1) & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a22ae914-eefb-5975-9b0f-5a27d28c6132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-2, 3}" :db/id #edb/ref 17592186122673} {:answer/id #uuid "c08eba2a-5e5a-5380-979b-32db6ac0cb46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-2}" :db/id #edb/ref 17592186122674} {:answer/id #uuid "cca08244-779e-521a-99c1-161f55a3ce64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-2,-1, 4}" :db/id #edb/ref 17592186122675} {:answer/id #uuid "201219c0-0f24-5f90-a03f-c05a1c2872d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-2, 3, 4}" :db/id #edb/ref 17592186122676} {:answer/id #uuid "642c8c67-ace8-5bc1-adb5-d88f862d0b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-4,-2, 3}" :db/id #edb/ref 17592186122677}] :answer-field/id #uuid "8e3898e9-8787-559d-a597-4830d4990984" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122672}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a451407b-df1a-5469-850d-9d3e8b92e100" :question/math-academy-id "q-36822" :question/problem "Determine all real eigenvalues $λ$ of the matrix\n$$\n\\displaystyle A = \\begin{bmatrix}3 & 0 & 0 \\\\ 1 & -2 & 0 \\\\ -2 & 3 & 4\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186125013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc50313-1349-57e5-bd5b-c32ef21846c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\lambda }^{2}-2\\lambda -4=0" :db/id #edb/ref 17592186427375} {:answer/id #uuid "ba3bf449-9417-55d8-bda3-bcdf2a3abb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2=0" :db/id #edb/ref 17592186427378} {:answer/id #uuid "bb4847f7-518c-5520-9f7b-8f055c77b9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-5{\\lambda }^{2}-2\\lambda =0" :db/id #edb/ref 17592186427379} {:answer/id #uuid "c9d9c2bc-05e4-5243-ab8a-17562b551bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-5{\\lambda }^{2}+2\\lambda -2=0" :db/id #edb/ref 17592186427380} {:answer/id #uuid "f431214a-fe2c-58fb-acc6-9d70412cfbb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-2\\lambda -2=0" :db/id #edb/ref 17592186427383}] :answer-field/correct {:db/id #edb/ref 17592186427378} :answer-field/id #uuid "b55f74a2-418f-5fce-b67f-29118bc0950f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122678}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f39262c6-06ce-51e6-92a2-5f2acfb813a4" :question/math-academy-id "q-36824" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}0 & -2 & -3 \\\\ -2 & 3 & 6 \\\\ 2 & -2 & -5\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}-\\lambda  & -2 & -3 \\\\ -2 & 3-\\lambda  & 6 \\\\ 2 & -2 & -5-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-\\lambda  & -2 & -3 \\\\ -2 & 3-\\lambda  & 6 \\\\ 2 & -2 & -5-\\lambda \\end{vmatrix} & =0 \\\\ -\\lambda \\begin{vmatrix}3-\\lambda  & 6 \\\\ -2 & -5-\\lambda \\end{vmatrix}-(-2)\\begin{vmatrix}-2 & 6 \\\\ 2 & -5-\\lambda \\end{vmatrix}+(-3)\\begin{vmatrix}-2 & 3-\\lambda  \\\\ 2 & -2\\end{vmatrix} & =0 \\\\ -\\lambda ({\\lambda }^{2}+2\\lambda -3)+2(2\\lambda -2)-3(2\\lambda -2) & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+3\\lambda )+(4\\lambda -4)-(6\\lambda -6) & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+\\lambda +2 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b850092-0768-5d13-a72a-e11e6fa61527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {1, 2, 3}" :db/id #edb/ref 17592186122697} {:answer/id #uuid "f3a1a73f-8bf5-5f94-b424-b7f3670c257a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {2, 3}" :db/id #edb/ref 17592186122698} {:answer/id #uuid "092448a6-840b-51dc-a7ec-b41d39ae8c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-5,-1, 2}" :db/id #edb/ref 17592186122699} {:answer/id #uuid "137b35b1-2635-5ab0-a9bf-0aed4b658b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {1}" :db/id #edb/ref 17592186122700} {:answer/id #uuid "28788f1a-eb82-5d27-8d2e-99d46877bcae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "λ ∈ {-3, 1, 2}" :db/id #edb/ref 17592186122701}] :answer-field/id #uuid "5d5f5bbf-db0e-5460-a7b4-69f560d13363" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "be3a7238-7c60-5feb-8696-67cf958422da" :question/math-academy-id "q-36841" :question/problem "Determine all real eigenvalues $λ$ of the matrix\n$$\n\\displaystyle A = \\begin{bmatrix}4 & 2 & 1 \\\\ -2 & -1 & -2 \\\\ 2 & 2 & 3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186125017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34b63fae-2f7c-5fe2-a1a4-0ec3c381a3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\lambda )({\\lambda }^{2}+\\lambda -4)=0" :db/id #edb/ref 17592186321550} {:answer/id #uuid "7e0eb44e-ac21-5b2a-a972-1f77bba194b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\lambda )({\\lambda }^{2}+\\lambda +4)=0" :db/id #edb/ref 17592186322140} {:answer/id #uuid "9bb97b3b-8054-574a-8ea2-ed4ef42cb19d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\lambda )({\\lambda }^{2}+\\lambda -10)=0" :db/id #edb/ref 17592186322378} {:answer/id #uuid "d58e6bae-778a-5650-bdd1-f71c17fa7409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\lambda )({\\lambda }^{2}+\\lambda -16)=0" :db/id #edb/ref 17592186322813} {:answer/id #uuid "d90d6023-7a0f-5e73-af24-24eac2a1b5b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\lambda )({\\lambda }^{2}-16)=0" :db/id #edb/ref 17592186322849}] :answer-field/correct {:db/id #edb/ref 17592186322813} :answer-field/id #uuid "55997a27-4ab4-5568-9f4a-ccc1b73a2faf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323333}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2accab64-f6f1-5300-b0aa-a3471aee3ef9" :question/math-academy-id "q-36845" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}-3 & 2 & -1 \\\\ 5 & 2 & 3 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}-3-\\lambda  & 2 & -1 \\\\ 5 & 2-\\lambda  & 3 \\\\ 0 & 0 & 1-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $3$rd row, we obtain the following:  \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-3-\\lambda  & 2 & -1 \\\\ 5 & 2-\\lambda  & 3 \\\\ 0 & 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}-3-\\lambda  & 2 \\\\ 5 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((-3-\\lambda )(2-\\lambda )-2\\cdot 5) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}+\\lambda -16) & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "203333e3-42b8-50e5-ad7c-349f412c474d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448596} {:answer/id #uuid "909fc2e1-73fa-59b2-a46b-d44dc0bb0b16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448597}] :answer-field/correct {:db/id #edb/ref 17592186448596} :answer-field/id #uuid "8a9cdab4-a97f-58e7-b97a-81f65eb22730" :answer-field/key "$\\lambda =-1$ is an eigenvalue of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449338} {:answer-field/choices [{:answer/id #uuid "6017700f-5a71-5853-a457-72bd0d6622d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448598} {:answer/id #uuid "78230748-a3fa-5d9d-9caf-d1ef1fc40fb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448599}] :answer-field/correct {:db/id #edb/ref 17592186448599} :answer-field/id #uuid "baf3d724-150e-5574-a988-4d93412ca0c2" :answer-field/key "$\\lambda =-10$ is an eigenvalue of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449339} {:answer-field/choices [{:answer/id #uuid "f182a3b9-57f6-551f-b745-0c46637db13b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448600} {:answer/id #uuid "9f9693de-9b5c-55ce-8c6f-86871ae8c865" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448601}] :answer-field/correct {:db/id #edb/ref 17592186448601} :answer-field/id #uuid "b5f31ab0-0b07-530a-931a-fd795892e749" :answer-field/key "The eigenvalue $\\lambda =-10$ has algebraic multiplicity $3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449340}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c699a77c-6393-5572-b010-6743d9f3bb17" :question/math-academy-id "q-37355" :question/problem "$$\nP=\\begin{bmatrix}-1 & -9 & -18 & -3 \\\\ 0 & -10 & 0 & 0 \\\\ 0 & 0 & -10 & 0 \\\\ -18 & 18 & -36 & -4\\end{bmatrix}.\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}-1-\\lambda  & -9 & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 & 0 \\\\ 0 & 0 & -10-\\lambda  & 0 \\\\ -18 & 18 & -36 & -4-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}-1-\\lambda  & -9 & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 & 0 \\\\ 0 & 0 & -10-\\lambda  & 0 \\\\ -18 & 18 & -36 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (-10-\\lambda )\\begin{vmatrix}-1-\\lambda  & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 \\\\ -18 & -36 & -4-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(-10-\\lambda )\\cdot (-10-\\lambda )\\begin{vmatrix}-1-\\lambda  & -3 \\\\ -18 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (-10-\\lambda )^{2}((-1-\\lambda )(-4-\\lambda )-54) & =0 \\\\ (\\lambda +10)^{2}({\\lambda }^{2}+5\\lambda -50) & =0 \\\\ (\\lambda +10)^{2}(\\lambda +10)(\\lambda -5) & =0 \\\\ (\\lambda +10)^{3}(\\lambda -5) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =-10$ (with algebraic multiplicity $3$) and $\\lambda =5.$\n\nTherefore, the correct answer is “$\\lambda =-10$ is an eigenvalue of $P$”; “The eigenvalue $\\lambda =-10$ has algebraic multiplicity $3$” only."}] [{:db/id #edb/ref 17592186235397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8a2b0d-d5b3-5494-a8d5-71ccb1bd416a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234593}] :answer-field/correct {:db/id #edb/ref 17592186234593} :answer-field/id #uuid "67b39520-9797-501e-b4fa-f5114ee8090d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235084} {:answer-field/choices [{:answer/id #uuid "11b5b2e4-6df0-5c69-b3ce-2762ea4544ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234567}] :answer-field/correct {:db/id #edb/ref 17592186234567} :answer-field/id #uuid "6de6d6a5-daf3-537a-94ab-8241aceddfcb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235094} {:answer-field/choices [{:answer/id #uuid "a90358fb-6302-5266-94d3-c5c04cd00164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234804}] :answer-field/correct {:db/id #edb/ref 17592186234804} :answer-field/id #uuid "b64d1ae8-169d-508d-b88c-817a9ce74bef" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235196}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "211421e3-130a-58f3-b6bd-e1f1632e4ff1" :question/math-academy-id "q-138788" :question/problem "The solution of the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+y+1 &=0 \\\\ 4x+3y-3 &=0\\end{aligned}\\right.\n$$\n\ngives the point where the highways meet. This solution can be written in matrix form as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\frac{1}{2}\\begin{bmatrix}a & b \\\\ -4 & 2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ c\\end{bmatrix}\n$$\n\nFind the values of $a,$ $b,$ and $c.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n$a\\,=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,b\\,=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,c\\,=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-3}}" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}2 & 1 \\\\ 4 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}2 & 1 \\\\ 4 & 3\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 3-4\\cdot 1}\\begin{bmatrix}3 & -1 \\\\ -4 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}3 & -1 \\\\ -4 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we can write the solution to this system as\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}3 & -1 \\\\ -4 & 2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed7825e-346d-5a22-8ed8-59e83678839e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}-3 & 2 \\\\ 3 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186235895} {:answer/id #uuid "3f5e0f07-9e55-5437-8a9f-de7f29f88968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\begin{bmatrix}-2 & 2 \\\\ 2 & -3\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186236220} {:answer/id #uuid "81562466-cc96-52f4-a684-36eebfe55435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}-3 & -2 \\\\ -2 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186236623} {:answer/id #uuid "8c1eec43-5163-52ae-8860-4c008a4b0cdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ -2 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186236698} {:answer/id #uuid "d2543379-d127-586c-a68f-81316a7711b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}-2 & -2 \\\\ -2 & -3\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186237148}] :answer-field/correct {:db/id #edb/ref 17592186236623} :answer-field/id #uuid "7297e027-56e3-5659-87cd-c6423edce84a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25d74c84-9d1d-5f1c-8223-f549d1370a13" :question/math-academy-id "q-102705" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\left\\{\\begin{aligned}-2x+2y &=1 \\\\ 2x-3y &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}-2 & 2 \\\\ 2 & -3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}-2 & 2 \\\\ 2 & -3\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-2)\\cdot (-3)-2\\cdot 2}\\begin{bmatrix}-3 & -2 \\\\ -2 & -2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-3 & -2 \\\\ -2 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}-3 & -2 \\\\ -2 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37503db8-10d7-5583-8f30-374405d5c1fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\begin{bmatrix}4 & -2 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186236171} {:answer/id #uuid "4461e345-3733-5f04-8b2d-ba7bcab3ab70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}\\begin{bmatrix}0 & 2 \\\\ -5 & 4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186236258} {:answer/id #uuid "6ca5d4f4-cb39-51c0-989f-7439bc2613f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}\\begin{bmatrix}0 & -2 \\\\ 5 & 4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186236501} {:answer/id #uuid "825b8a80-c42c-526f-8704-24d7b15a4dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{10}\\begin{bmatrix}0 & 2 \\\\ 5 & 4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186236631} {:answer/id #uuid "ee57336e-c7c8-555f-8bf6-a84746d0aacb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\begin{bmatrix}4 & 2 \\\\ -5 & 0\\end{bmatrix}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186237317}] :answer-field/correct {:db/id #edb/ref 17592186236258} :answer-field/id #uuid "fe30c037-d401-593e-a43e-6b8a2fcfc035" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237773}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9876e0e7-b1e4-559d-b97c-350c8c6823a9" :question/math-academy-id "q-102802" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}4x-2y &=4 \\\\ 6 &=5x\\end{aligned}\\right.\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}4x-2y &=4 \\\\ 5x &=6.\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}4 & -2 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}4 & -2 \\\\ 5 & 0\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 0-5\\cdot (-2)}\\begin{bmatrix}0 & 2 \\\\ -5 & 4\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}0 & 2 \\\\ -5 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{10}\\begin{bmatrix}0 & 2 \\\\ -5 & 4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7beab9a8-f3e4-5887-ad6d-af714014f1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}\\begin{bmatrix}-1 & -3 \\\\ -4 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186236591} {:answer/id #uuid "84f426dd-988f-5643-a988-220caa26f7a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{10}\\begin{bmatrix}-1 & -3 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186236643} {:answer/id #uuid "9ee9efea-1ede-57bd-aec3-223261944b19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=