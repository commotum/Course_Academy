\end{bmatrix} \\\\  & =I\\,✓ \\\\ B & =\\begin{bmatrix}8 & 0 \\\\ -6 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ -6 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ C & =\\begin{bmatrix}4 & 0 \\\\ -4 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id #edb/ref 17592186345106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a22d4b7-074a-5d04-912d-7b6108e7167d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468136} {:answer/id #uuid "5d0b2a23-76ab-5200-8d7b-f13b77b40192" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468137}] :answer-field/correct {:db/id #edb/ref 17592186468136} :answer-field/id #uuid "f4254187-bd09-58f3-a28e-1f6f28a5af6d" :answer-field/key "$A=\\begin{bmatrix}4 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468789} {:answer-field/choices [{:answer/id #uuid "390c4edc-e818-5223-aa83-23ae63a5ce1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468138} {:answer/id #uuid "11b4e9f4-70a6-5c81-993a-0952578db682" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468139}] :answer-field/correct {:db/id #edb/ref 17592186468139} :answer-field/id #uuid "1646aa06-2e33-5643-a89f-dcda0cb5e983" :answer-field/key "$B=\\begin{bmatrix}2 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468790} {:answer-field/choices [{:answer/id #uuid "6f052af5-1b8f-5975-b3f7-87826619a2c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468140} {:answer/id #uuid "678dc931-9de5-5c14-9144-1b98946a7b5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468141}] :answer-field/correct {:db/id #edb/ref 17592186468140} :answer-field/id #uuid "4e05ce73-bd6b-5a87-b9b7-7872f18039e7" :answer-field/key "$C=\\begin{bmatrix}1 & 1 \\\\ \\frac{3}{4} & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468791}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd25b025-461f-556b-97f3-6071c19d59d7" :question/math-academy-id "q-75595" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=4{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}2 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}1 & 1 \\\\ \\frac{3}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186345107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf810a22-6e4e-5370-935e-7b24712f6a30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468142} {:answer/id #uuid "848f4c22-cfc4-5377-a40d-094c0e364b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468143}] :answer-field/correct {:db/id #edb/ref 17592186468143} :answer-field/id #uuid "f591a7fc-b05e-5621-acf8-731308abb477" :answer-field/key "$A=\\begin{bmatrix}2 & 1 \\\\ 2 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468792} {:answer-field/choices [{:answer/id #uuid "50b01950-272f-59a6-9096-2b795827c4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468144} {:answer/id #uuid "65204522-9d40-58cf-9306-f1b137036423" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468145}] :answer-field/correct {:db/id #edb/ref 17592186468144} :answer-field/id #uuid "0bf1582f-2805-5217-a9e3-252ee8df0a4b" :answer-field/key "$B=\\begin{bmatrix}-2 & 1 \\\\ 2 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468793} {:answer-field/choices [{:answer/id #uuid "20560ea6-e142-5067-95f1-de2eac284f54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468146} {:answer/id #uuid "6b6e2ed2-a856-5436-bf79-89e451131f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468147}] :answer-field/correct {:db/id #edb/ref 17592186468146} :answer-field/id #uuid "eac4c188-4d68-52bb-a7c2-ea3ae475e3ad" :answer-field/key "$C=\\begin{bmatrix}4 & 1 \\\\ 2 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468794}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a52696c-f90c-56a7-94f5-6062f59efbae" :question/math-academy-id "q-75599" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=\\frac{1}{2}{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 1 \\\\ 2 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ B & =\\begin{bmatrix}-2 & 1 \\\\ 2 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ C & =\\begin{bmatrix}4 & 1 \\\\ 2 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id #edb/ref 17592186345305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4181657e-bef8-5bd8-86ba-a0dc4bcb1328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot \\begin{vmatrix}-2 & -2 & 2 \\\\ 2 & 3 & 1 \\\\ 1 & -4 & 3\\end{vmatrix}" :db/id #edb/ref 17592186342776} {:answer/id #uuid "8acdc0e6-b529-56de-9823-ca79949873cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & 3 & 1 \\\\ 1 & -4 & 3 \\\\ -2 & -2 & 2\\end{vmatrix}" :db/id #edb/ref 17592186343447} {:answer/id #uuid "8b32d2ac-71ed-5393-9c06-566b463f4b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot \\begin{vmatrix}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{vmatrix}" :db/id #edb/ref 17592186343450} {:answer/id #uuid "990c13b7-95ba-521a-9304-fa8b166a3978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot \\begin{vmatrix}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 0 & 3 & 0\\end{vmatrix}" :db/id #edb/ref 17592186343583} {:answer/id #uuid "b8ec4375-4789-59b2-b472-016291083078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -2 & -2 & 2 \\\\ 1 & -3 & -4\\end{vmatrix}" :db/id #edb/ref 17592186343861}] :answer-field/correct {:db/id #edb/ref 17592186343450} :answer-field/id #uuid "cca33b3f-5998-5d52-8f34-7de42faab193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64bf6a39-abf5-5018-a960-bf7a8fbd2ffd" :question/math-academy-id "q-77481" :question/problem "$$\n\\displaystyle \\begin{vmatrix}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{vmatrix}=\n$$" :question/worked-solution "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{vmatrix} & =0\\cdot {C}_{31}+3\\cdot {C}_{32}+0\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =3\\cdot (-1)^{3+2}\\cdot \\begin{vmatrix}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{vmatrix} \\\\  & =-3\\cdot \\begin{vmatrix}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "703f38f5-d562-5737-a3e9-455a97a42f39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186343204} {:answer/id #uuid "917467d4-68ad-589a-b372-c2656ddfbe56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186343511} {:answer/id #uuid "95733d44-1f56-5609-980e-fc36d7c34c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186343545} {:answer/id #uuid "b84505eb-59e1-5ba6-848a-5b83870be4a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186343855} {:answer/id #uuid "fb9247e7-0c47-5cc3-ac67-d7bc0bbe7d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186344451}] :answer-field/correct {:db/id #edb/ref 17592186343511} :answer-field/id #uuid "dfb3dcc7-ea2d-577b-bed7-1da5dd43872a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344884}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7219fa5b-320d-5221-9146-e95094c6f719" :question/math-academy-id "q-77487" :question/problem "Compute the following determinant using a cofactor expansion along the $1$st row:\n\n$$\n\\begin{vmatrix}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{vmatrix}.\n$$" :question/worked-solution "Using cofactor expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{vmatrix} & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+(-1)\\cdot {C}_{14} \\\\  & =1\\cdot (-1)^{1+1}\\cdot \\begin{vmatrix}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{vmatrix}+(-1)\\cdot (-1)^{1+4}\\cdot \\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & -0\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{vmatrix}+\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{vmatrix} & =1\\cdot {C}_{21}+5\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+1}\\cdot \\begin{vmatrix}1 & -1 \\\\ 0 & -3\\end{vmatrix}+5\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}2 & -1 \\\\ -4 & -3\\end{vmatrix} \\\\  & =-\\begin{vmatrix}1 & -1 \\\\ 0 & -3\\end{vmatrix}+5\\begin{vmatrix}2 & -1 \\\\ -4 & -3\\end{vmatrix} \\\\  & =-(-3-0)+5(-6-4) \\\\  & =3-50 \\\\  & =-47\\end{aligned}\n$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain: \n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{vmatrix} & =0\\cdot {C}_{21}+1\\cdot {C}_{22}+5\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}2 & 1 \\\\ 2 & 0\\end{vmatrix}+5\\cdot (-1)^{2+3}\\cdot \\begin{vmatrix}2 & 2 \\\\ 2 & -4\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 2 & 0\\end{vmatrix}-5\\begin{vmatrix}2 & 2 \\\\ 2 & -4\\end{vmatrix} \\\\  & =(0-2)-5(-8-4) \\\\  & =-2+60 \\\\  & =58\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{vmatrix}=-47+58=11.\n$$"}] [{:db/id #edb/ref 17592186345307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c78bb2-c05e-5042-99b4-4ba26257cfd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "94" :db/id #edb/ref 17592186343085} {:answer/id #uuid "ac08282d-ec1c-52a7-bb55-b48b1164c66f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186343752} {:answer/id #uuid "b45e6f2e-a5c6-545c-b716-1f84c527b6c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186343821} {:answer/id #uuid "b5e13b1e-923e-54b7-9baf-180717ccf5c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186343831} {:answer/id #uuid "b86e0c96-da3a-5204-a16d-eb611c571f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186343857}] :answer-field/correct {:db/id #edb/ref 17592186343085} :answer-field/id #uuid "818d92fb-dffb-55cf-8415-a01be38b7c20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344721}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "942da52d-05d9-58c3-b707-f2f2db2a2ed1" :question/math-academy-id "q-77491" :question/problem "Compute the following determinant using a cofactor expansion along the $2$nd row:\n\n$$\n\\begin{vmatrix}0 & 0 & 3 & 4 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 0 & 8 & -5 \\\\ -1 & 1 & 0 & 0\\end{vmatrix}.\n$$" :question/worked-solution "Using cofactor expansion along the $2$nd row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & 0 & 3 & 4 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 0 & 8 & -5 \\\\ -1 & 1 & 0 & 0\\end{vmatrix} & =0\\cdot {C}_{21}+2\\cdot {C}_{22}+0\\cdot {C}_{23}+0\\cdot {C}_{24} \\\\  & =2\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}0 & 3 & 4 \\\\ 3 & 8 & -5 \\\\ -1 & 0 & 0\\end{vmatrix} \\\\  & =2\\begin{vmatrix}0 & 3 & 4 \\\\ 3 & 8 & -5 \\\\ -1 & 0 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & 3 & 4 \\\\ 3 & 8 & -5 \\\\ -1 & 0 & 0\\end{vmatrix} & =(-1)\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33} \\\\  & =(-1)\\cdot (-1)^{3+1}\\cdot \\begin{vmatrix}3 & 4 \\\\ 8 & -5\\end{vmatrix} \\\\  & =(-1)\\begin{vmatrix}3 & 4 \\\\ 8 & -5\\end{vmatrix} \\\\  & =(-1)(-15-32) \\\\  & =(-1)\\cdot (-47) \\\\  & =47\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{vmatrix}0 & 0 & 3 & 4 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 0 & 8 & -5 \\\\ -1 & 1 & 0 & 0\\end{vmatrix}=2\\cdot 47=94.\n$$"}] [{:db/id #edb/ref 17592186345311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085677fe-2ce2-56d8-8f07-f38b3e3e665b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}" :db/id #edb/ref 17592186342307} {:answer/id #uuid "5fe12a8f-343b-5c20-bdaf-21cebdc2dd3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}-0.5\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix}" :db/id #edb/ref 17592186343051} {:answer/id #uuid "60fa4062-6a66-5111-ba4f-e565fcbdc453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}-0.2\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix}" :db/id #edb/ref 17592186343058} {:answer/id #uuid "65fd3752-25a3-5899-9c71-dfff302978eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}+0.3\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix}" :db/id #edb/ref 17592186343102} {:answer/id #uuid "f67a3464-f318-50cd-bbd5-6291648cb525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}-0.2\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ 0 & -1 & 3\\end{vmatrix}" :db/id #edb/ref 17592186344408}] :answer-field/correct {:db/id #edb/ref 17592186343058} :answer-field/id #uuid "b52751f0-c8a2-5c19-acd0-37fdcde09c7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344813}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfafc8a0-7ee6-5e27-9d18-bae692ae8fdc" :question/math-academy-id "q-77506" :question/problem "$$\n\\displaystyle \\begin{vmatrix}4 & 0 & 9 & 8 \\\\ 2 & 0.5 & 0 & 4 \\\\ 0 & 0.2 & -1 & 3 \\\\ -3 & 0 & 12 & 4\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 0 & 9 & 8 \\\\ 2 & 0.5 & 0 & 4 \\\\ 0 & 0.2 & -1 & 3 \\\\ -3 & 0 & 12 & 4\\end{vmatrix} & =0\\cdot {C}_{12}+0.5\\cdot {C}_{22}+0.2\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =0.5\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}+0.2\\cdot (-1)^{3+2}\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix} \\\\  & =0.5\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{vmatrix}-0.2\\cdot \\begin{vmatrix}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e61f4c2-8085-5114-a20b-6ea7aea00f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot \\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}+2\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186342492} {:answer/id #uuid "25a545b6-2f31-5036-b445-a8862f234210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot \\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}" :db/id #edb/ref 17592186342554} {:answer/id #uuid "57480ec8-f1b7-52b3-a79c-b6a587fef1b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot \\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}+3\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186342965} {:answer/id #uuid "ad7d3e0d-3e6e-53ab-9ce6-1a956f138509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186343763} {:answer/id #uuid "d50ce4c7-1536-586c-bce7-e90d1ada92fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot \\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}-2\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186344105}] :answer-field/correct {:db/id #edb/ref 17592186342492} :answer-field/id #uuid "6420e3da-ebe0-5423-a2d2-71302a68d23d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344662}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "658f3c01-d02e-55ae-801b-ed3db4082fef" :question/math-academy-id "q-77798" :question/problem "$$\n\\displaystyle \\begin{vmatrix}0 & -3 & 2 & 0 \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{vmatrix}=\n$$" :question/worked-solution "The $1$rst row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & -3 & 2 & 0 \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{vmatrix} & =0\\cdot {C}_{11}+-3\\cdot {C}_{12}+2\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =-3\\cdot (-1)^{1+2}\\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}+2\\cdot (-1)^{1+3}\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{vmatrix}+2\\cdot \\begin{vmatrix}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0697b8f8-60bd-5ea9-b299-33fb8a105bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}-6\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix}" :db/id #edb/ref 17592186342298} {:answer/id #uuid "0bd2dbe7-49de-58ee-b0a6-7ca4dd81cd94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}-3\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix}" :db/id #edb/ref 17592186342342} {:answer/id #uuid "478a2b31-fc2b-5057-9df6-cb76999d8cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}" :db/id #edb/ref 17592186342829} {:answer/id #uuid "e7803236-3735-5a23-a9ed-53518e027f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}" :db/id #edb/ref 17592186344271} {:answer/id #uuid "f0ce6711-9158-5ade-944d-8e8347b0264c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}+6\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix}" :db/id #edb/ref 17592186344354}] :answer-field/correct {:db/id #edb/ref 17592186342298} :answer-field/id #uuid "434a7d58-b4ae-59e3-8116-c520bcdbc4c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344601}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3050e12e-4f05-5836-84f0-bb2d520a66fd" :question/math-academy-id "q-77799" :question/problem "$$\n\\displaystyle \\begin{vmatrix}-7 & -1 & 5 & 8 \\\\ 3 & -6 & 0 & 0 \\\\ 4 & -3 & 2 & -1 \\\\ 1 & 3 & -5 & -7\\end{vmatrix}=\n$$" :question/worked-solution "The $2$nd row of the matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $2$nd row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}-7 & -1 & 5 & 8 \\\\ 3 & -6 & 0 & 0 \\\\ 4 & -3 & 2 & -1 \\\\ 1 & 3 & -5 & -7\\end{vmatrix} & =3\\cdot {C}_{21}+(-6)\\cdot {C}_{22}+0\\cdot {C}_{23}+0\\cdot {C}_{24} \\\\  & =3\\cdot (-1)^{2+1}\\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}+(-6)\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix} \\\\  & =-3\\cdot \\begin{vmatrix}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{vmatrix}-6\\cdot \\begin{vmatrix}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc79991-58e0-5122-ac80-577fb9452fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186342358} {:answer/id #uuid "39027aaf-7f10-521d-9d79-b04232289b93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186342707} {:answer/id #uuid "56f2432c-2ff0-5b6c-bc53-3d21355bba2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186342962} {:answer/id #uuid "a136c0cd-cd24-579c-9993-2a92eec516cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186343660} {:answer/id #uuid "d3b55ff0-0c21-55e1-ac05-eb2cb572eea9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186344096}] :answer-field/correct {:db/id #edb/ref 17592186342358} :answer-field/id #uuid "1fd7b9a7-034b-59d4-8409-d4980260d202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344548}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca7d486d-765a-531d-b071-af032848aae1" :question/math-academy-id "q-77800" :question/problem "Compute the following determinant using a cofactor expansion along the $2$nd row:\n\n$$\n\\begin{vmatrix}0 & -1 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ -7 & 0 & 1 & -2 \\\\ 0 & 3 & 1 & 5\\end{vmatrix}.\n$$" :question/worked-solution "Using cofactor expansion along the $2$nd row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & -1 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ -7 & 0 & 1 & -2 \\\\ 0 & 3 & 1 & 5\\end{vmatrix} & =0\\cdot {C}_{21}+0\\cdot {C}_{22}+0\\cdot {C}_{23}+3\\cdot {C}_{24} \\\\  & =3\\cdot (-1)^{2+4}\\cdot \\begin{vmatrix}0 & -1 & 0 \\\\ -7 & 0 & 1 \\\\ 0 & 3 & 1\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}0 & -1 & 0 \\\\ -7 & 0 & 1 \\\\ 0 & 3 & 1\\end{vmatrix}.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & -1 & 0 \\\\ -7 & 0 & 1 \\\\ 0 & 3 & 1\\end{vmatrix} & =0\\cdot {C}_{11}+(-1)\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =(-1)\\cdot (-1)^{1+2}\\cdot \\begin{vmatrix}-7 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}-7 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-7-0 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}0 & -1 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ -7 & 0 & 1 & -2 \\\\ 0 & 3 & 1 & 5\\end{vmatrix}=3(-7)=-21.\n$$"}] [{:db/id #edb/ref 17592186345338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6835c8-2cfb-5a8c-acb9-0d6f35bdff99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186342497} {:answer/id #uuid "5c5eeff0-d8f4-5176-9a11-2cfb5f801710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186343013} {:answer/id #uuid "764c4dcd-d2a0-53ec-a5f4-c09bd26aca40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186343261} {:answer/id #uuid "983ffe27-13e6-5f16-8ab7-7b68417a6e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186343572} {:answer/id #uuid "a090828d-2b1a-51fa-8296-142970b0c8f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186343655}] :answer-field/correct {:db/id #edb/ref 17592186343572} :answer-field/id #uuid "4f7b556e-bf75-5353-a507-76bc077cec3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344628}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9e41934-b6da-5af2-884b-ea417e91c9f3" :question/math-academy-id "q-77802" :question/problem "Compute the following determinant using a cofactor expansion along the $4$th row:\n\n$$\n\\begin{vmatrix}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ -2 & 5 & 0 & 0\\end{vmatrix}.\n$$" :question/worked-solution "Using cofactor expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ -2 & 5 & 0 & 0\\end{vmatrix} & =-2\\cdot {C}_{41}+5\\cdot {C}_{42}+0\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =-2\\cdot (-1)^{4+1}\\cdot \\begin{vmatrix}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{vmatrix}+5\\cdot (-1)^{4+2}\\cdot \\begin{vmatrix}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{vmatrix}+5\\cdot \\begin{vmatrix}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{vmatrix}.\\end{aligned}\n$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{vmatrix} & =(-1)\\cdot {C}_{11}+1\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =(-1)\\cdot (-1)^{1+1}\\cdot \\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}+1\\cdot (-1)^{1+2}\\cdot \\begin{vmatrix}-2 & -1 \\\\ 2 & 4\\end{vmatrix} \\\\  & =-\\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}-\\begin{vmatrix}-2 & -1 \\\\ 2 & 4\\end{vmatrix} \\\\  & =-(-4-7)-(-8+2) \\\\  & =11+6 \\\\  & =17\\end{aligned}\n$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain: \n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{vmatrix} & =1\\cdot {C}_{11}+1\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =1\\cdot (-1)^{1+1}\\cdot \\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}+1\\cdot (-1)^{1+2}\\cdot \\begin{vmatrix}0 & -1 \\\\ 0 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & -1 \\\\ -7 & 4\\end{vmatrix}-\\begin{vmatrix}0 & -1 \\\\ 0 & 4\\end{vmatrix} \\\\  & =(-4-7)-(0+0) \\\\  & =-11-0 \\\\  & =-11\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n\\begin{vmatrix}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ -2 & 5 & 0 & 0\\end{vmatrix}=2(17)+5(-11)=-21.\n$$"}] [{:db/id #edb/ref 17592186345341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37450e5f-9dbd-57be-8924-cdaac0aa67b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186342694} {:answer/id #uuid "4d9264bd-21cd-5219-ae3f-d2598b22e769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186342875} {:answer/id #uuid "953369d4-2550-585a-b2ca-bf98ce692e31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186343541} {:answer/id #uuid "bfecf5a1-ed25-563c-a6a9-2d6c6b4f1201" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186343920} {:answer/id #uuid "f76f97c5-0dca-54d8-8375-04c2a5ef3fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}" :db/id #edb/ref 17592186344416}] :answer-field/correct {:db/id #edb/ref 17592186343920} :answer-field/id #uuid "42f191cd-be28-501d-89c2-824c0c38f155" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344600}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8213aabe-0e24-5f5b-b5ea-816bb725793c" :question/math-academy-id "q-77806" :question/problem "$$\n\\displaystyle \\begin{vmatrix}-2 & 2 & 0 & 4 \\\\ 0 & 5 & -7 & 3 \\\\ 0 & 9 & 6 & -1 \\\\ 0 & 8 & -1 & -1\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $1$st column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}-2 & 2 & 0 & 4 \\\\ 0 & 5 & -7 & 3 \\\\ 0 & 9 & 6 & -1 \\\\ 0 & 8 & -1 & -1\\end{vmatrix} & =-2\\cdot {C}_{11}+0\\cdot {C}_{21}+0\\cdot {C}_{31}+0\\cdot {C}_{41} \\\\  & =(-2)\\cdot (-1)^{1+1}\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix} \\\\  & =-2\\cdot \\begin{vmatrix}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf7cfbc-f2b0-5684-bbfc-df2a4dfe1cd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}+7\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186343018} {:answer/id #uuid "6745fcba-99f1-5578-83b5-4b228c41d687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}-8\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186343115} {:answer/id #uuid "96c34368-3ce8-50f2-93cc-27f082bae5c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186343556} {:answer/id #uuid "a6f5b999-091a-5e45-b917-5e6ca067d8b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}" :db/id #edb/ref 17592186343707} {:answer/id #uuid "bf449a53-c16e-5f60-859a-2068ef5af47d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}-8\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186343918}] :answer-field/correct {:db/id #edb/ref 17592186343115} :answer-field/id #uuid "f64fee77-2b23-5772-9fa3-c06da3bf3384" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344924}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "82b9ddc1-7a19-5213-af13-fb4eb5bd3ace" :question/math-academy-id "q-77808" :question/problem "$$\n\\displaystyle \\begin{vmatrix}1 & 0 & -4 & 3 \\\\ -1 & -7 & 5 & -1 \\\\ 2 & 0 & 6 & -2 \\\\ -2 & -8 & -9 & 4\\end{vmatrix}=\n$$" :question/worked-solution "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 0 & -4 & 3 \\\\ -1 & -7 & 5 & -1 \\\\ 2 & 0 & 6 & -2 \\\\ -2 & -8 & -9 & 4\\end{vmatrix} & =0\\cdot {C}_{12}+(-7)\\cdot {C}_{22}+0\\cdot {C}_{32}+(-8)\\cdot {C}_{42} \\\\  & =(-7)\\cdot (-1)^{2+2}\\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}+(-8)\\cdot (-1)^{4+2}\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix} \\\\  & =-7\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{vmatrix}-8\\cdot \\begin{vmatrix}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "242bc1ff-9d6a-5249-9c87-df81d32a7785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -3)(\\lambda -2)(\\lambda -1)(\\lambda +3)=0" :db/id #edb/ref 17592186351897} {:answer/id #uuid "4ca0ab54-3950-52f9-9f8a-4d77319ad175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -3)^{2}(\\lambda +2)(\\lambda -1)=0" :db/id #edb/ref 17592186352267} {:answer/id #uuid "4fbc21b4-be4d-543a-b434-958a7eefccf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -3)(\\lambda +2)(\\lambda -1)(\\lambda +3)=0" :db/id #edb/ref 17592186352287} {:answer/id #uuid "c609ae85-57e2-57a3-9e3e-63455f2e5cd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -3)^{2}(\\lambda -2)(\\lambda -1)=0" :db/id #edb/ref 17592186353284} {:answer/id #uuid "ea8f1d9a-964d-5721-a11c-a90ebcc3202e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda +{3}^{2})(\\lambda +2)(\\lambda -1)=0" :db/id #edb/ref 17592186353612}] :answer-field/correct {:db/id #edb/ref 17592186352287} :answer-field/id #uuid "709448bf-2e7d-5b59-85e2-71d9ceccca7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5c38096-9f20-5f16-82a1-f8397b703a46" :question/math-academy-id "q-86749" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle P=\\begin{bmatrix}3 & 5 & 2 & 0 \\\\ 0 & -2 & 0 & -1 \\\\ 0 & 0 & 1 & 7 \\\\ 0 & 0 & 0 & -3\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}3-\\lambda  & 5 & 2 & 0 \\\\ 0 & -2-\\lambda  & 0 & -1 \\\\ 0 & 0 & 1-\\lambda  & 7 \\\\ 0 & 0 & 0 & -3-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 5 & 2 & 0 \\\\ 0 & -2-\\lambda  & 0 & -1 \\\\ 0 & 0 & 1-\\lambda  & 7 \\\\ 0 & 0 & 0 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-2-\\lambda )(1-\\lambda )(-3-\\lambda ) & =0 \\\\ (\\lambda -3)(\\lambda +2)(\\lambda -1)(\\lambda +3) & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7e5456c-c3dd-5a0d-b1c2-3704fc8684a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451347} {:answer/id #uuid "2e3a06ba-b64e-5195-8730-c9b460991557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451348}] :answer-field/correct {:db/id #edb/ref 17592186451347} :answer-field/id #uuid "e1d9b580-5d43-50e2-927e-f8ae49947f12" :answer-field/key "$\\lambda =2$ is an eigenvalue of $C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452521} {:answer-field/choices [{:answer/id #uuid "44f80825-4dc0-5703-964c-52ef15f73d55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451349} {:answer/id #uuid "183ba4dd-4b07-51c8-addc-3f2d2bef0202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451350}] :answer-field/correct {:db/id #edb/ref 17592186451350} :answer-field/id #uuid "1e54440b-ec3a-55ca-8152-eddfc8c269f2" :answer-field/key "$\\lambda =5$ is an eigenvalue of $C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452522} {:answer-field/choices [{:answer/id #uuid "bd8399ad-e6d4-5375-a818-f30592990e92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451351} {:answer/id #uuid "171f1a31-d670-547d-9146-cec5d20385e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451352}] :answer-field/correct {:db/id #edb/ref 17592186451352} :answer-field/id #uuid "b104c177-2725-5efd-84ea-448298f66c5d" :answer-field/key "The eigenvalue $\\lambda =5$ has algebraic multiplicity $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e41ff16d-c666-5918-91e3-4e187ca2af95" :question/math-academy-id "q-37387" :question/problem "$$\nC=\\begin{bmatrix}2 & 1 & 4 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ -5 & 2 & -3 & 0 \\\\ 1 & -7 & 6 & 5\\end{bmatrix}.\n$$\n\nConsider the matrix $C$ given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the matrix $\\,C-\\lambda I:$\n﻿﻿﻿\n\n$$\nC-\\lambda I=\\begin{bmatrix}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(C-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $4$th column, as follows:\n\n$$\n\\begin{aligned}det(C-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )\\begin{vmatrix}2-\\lambda  & 1 & 4 \\\\ 0 & 5-\\lambda  & 0 \\\\ -5 & 2 & -3-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(5-\\lambda )\\cdot (5-\\lambda )\\begin{vmatrix}2-\\lambda  & 4 \\\\ -5 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )^{2}\\cdot ((2-\\lambda )(-3-\\lambda )+20) & =0 \\\\ (\\lambda -5)^{2}({\\lambda }^{2}+\\lambda +14) & =0\\end{aligned}\n$$\n\nSince $D<0$ for the polynomial ${\\lambda }^{2}+\\lambda +14$ we have that the only real eigenvalue is $\\lambda =5$ (with algebraic multiplicity $2$). \n\nTherefore, the correct answer is “$\\lambda =5$ is an eigenvalue of $C$”; “The eigenvalue $\\lambda =5$ has algebraic multiplicity $2$” only."}] [{:db/id #edb/ref 17592186366013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd702e4-330a-55c4-a31c-c235740df973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-109\\lambda +470=0" :db/id #edb/ref 17592186366015} {:answer/id #uuid "1bc53b3d-fa24-5966-986f-e002765bf747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-31\\lambda +32=0" :db/id #edb/ref 17592186366016} {:answer/id #uuid "7fb400bf-02c7-5b7d-be66-3597e2682ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}-10\\lambda -5=0" :db/id #edb/ref 17592186366017} {:answer/id #uuid "d4b97459-5f9c-583d-bbf4-79230e9fff2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-109\\lambda +110=0" :db/id #edb/ref 17592186366018} {:answer/id #uuid "4587a64e-a88f-55cb-a42a-0f3b6f625361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-\\lambda +2=0" :db/id #edb/ref 17592186366019}] :answer-field/correct {:db/id #edb/ref 17592186366019} :answer-field/id #uuid "23f37a83-a62e-50f1-affa-75b650e2059a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366014}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94bfabe8-f33f-5580-888f-0bac595dc86b" :question/math-academy-id "q-37395" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle C=\\begin{bmatrix}4 & 3 & -6 \\\\ 4 & 5 & -12 \\\\ 3 & 3 & -7\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,C-\\lambda I:$\n﻿﻿﻿\n\n$$\nC-\\lambda I=\\begin{bmatrix}4-\\lambda  & 3 & -6 \\\\ 4 & 5-\\lambda  & -12 \\\\ 3 & 3 & -7-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(C-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(C-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 3 & -6 \\\\ 4 & 5-\\lambda  & -12 \\\\ 3 & 3 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & -12 \\\\ 3 & -7-\\lambda \\end{vmatrix}-3\\begin{vmatrix}4 & -12 \\\\ 3 & -7-\\lambda \\end{vmatrix}+(-6)\\begin{vmatrix}4 & 5-\\lambda  \\\\ 3 & 3\\end{vmatrix} & =0 \\\\ (4-\\lambda )({\\lambda }^{2}+2\\lambda +1)-3(-4\\lambda +8)-6(-3+3\\lambda ) & =0 \\\\ (-{\\lambda }^{3}+2{\\lambda }^{2}+7\\lambda +4)-(-12\\lambda +24)-(-18+18\\lambda ) & =0 \\\\ -{\\lambda }^{3}+2{\\lambda }^{2}+\\lambda -2 & =0 \\\\ {\\lambda }^{3}-2{\\lambda }^{2}-\\lambda +2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ec9910-e0fd-500c-a549-944d8205800e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451789} {:answer/id #uuid "5a37d4f9-58db-5ba8-88b3-85410ad5ea6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451790}] :answer-field/correct {:db/id #edb/ref 17592186451790} :answer-field/id #uuid "d02090ef-d4ce-52dc-a572-f7d577aef6d1" :answer-field/key "$\\lambda =0$ is an eigenvalue of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452742} {:answer-field/choices [{:answer/id #uuid "5bd5e478-5cfa-5b4b-b744-a3677754f14d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451791} {:answer/id #uuid "0b89ae10-1176-5228-9818-87068f6baeb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451792}] :answer-field/correct {:db/id #edb/ref 17592186451792} :answer-field/id #uuid "5f49c755-7208-571d-b62b-fa250286bf1d" :answer-field/key "$\\lambda =-14$ is an eigenvalue of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452743} {:answer-field/choices [{:answer/id #uuid "1d81aeff-94a5-5d39-a36b-e4ef94203480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451793} {:answer/id #uuid "1923b6cb-681f-5678-aa63-c64a0628a021" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451794}] :answer-field/correct {:db/id #edb/ref 17592186451793} :answer-field/id #uuid "ba776b6a-55ef-5233-8b4a-47f605e790d5" :answer-field/key "The eigenvalue $\\lambda =2$ has algebraic multiplicity $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452744}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6753a04-a08e-5bc2-a11a-2cad03fb8d3f" :question/math-academy-id "q-80800" :question/problem "$$\nP=\\begin{bmatrix}2 & -3 & -8 & 5 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 3 & -2 & 11 \\\\ 0 & 0 & 0 & -14\\end{bmatrix}.\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )\\begin{vmatrix}-\\lambda  & 0 & 4 \\\\ 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & -14-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(2-\\lambda )\\cdot (-14-\\lambda )\\begin{vmatrix}-\\lambda  & 0 \\\\ 3 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-14-\\lambda )(-\\lambda )(-2-\\lambda ) & =0 \\\\ (\\lambda -2)(\\lambda +14)\\lambda (\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =2,$ $\\lambda =-2,$ $\\lambda =0,$ and $\\lambda =-14$  (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is “$\\lambda =0$ is an eigenvalue of $P$”; “$\\lambda =-14$ is an eigenvalue of $P$” only."}] [{:db/id #edb/ref 17592186366511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3139a9d-4709-52dc-b082-fa6e7262b4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451863} {:answer/id #uuid "6611bee2-086e-5458-82d6-29162e06ef7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451864}] :answer-field/correct {:db/id #edb/ref 17592186451864} :answer-field/id #uuid "3b3c705f-a12e-5ec7-9d9e-7cfb964eab33" :answer-field/key "$\\lambda =2$ is an eigenvalue of $D$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452779} {:answer-field/choices [{:answer/id #uuid "80fd8012-3fa3-5669-b4d0-1a4677a6674d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451865} {:answer/id #uuid "f4d74f60-32b7-5c05-af9d-16a41f64d1c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451866}] :answer-field/correct {:db/id #edb/ref 17592186451866} :answer-field/id #uuid "061f5f16-a1a6-5a40-b334-2790c7680235" :answer-field/key "$\\lambda =-1$ is an eigenvalue of $D$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452780} {:answer-field/choices [{:answer/id #uuid "ceb7b4d4-53de-5934-8e1a-b0b8206b39b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451867} {:answer/id #uuid "3f9d8d40-8af7-502f-800e-af1a162fcfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451868}] :answer-field/correct {:db/id #edb/ref 17592186451868} :answer-field/id #uuid "a5bb764e-2d9e-5196-a9d1-56181fe324ba" :answer-field/key "The eigenvalue $\\lambda =-1$ has algebraic multiplicity $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ad99f7f-a225-5eb9-a085-4dc337f7e2b1" :question/math-academy-id "q-86752" :question/problem "$$\nD=\\begin{bmatrix}-1 & -2 & 4 & 6 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & -2 & 0 & 5 \\\\ 0 & 0 & 0 & -7\\end{bmatrix}.\n$$\n\nConsider the matrix $D$ given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the matrix $\\,D-\\lambda I:$\n﻿﻿﻿\n\n$$\nD-\\lambda I=\\begin{bmatrix}-1-\\lambda  & -2 & 4 & 6 \\\\ 0 & 1-\\lambda  & -1 & 0 \\\\ 0 & -2 & -\\lambda  & 5 \\\\ 0 & 0 & 0 & -7-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(D-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(D-\\lambda I) & =0 \\\\ \\begin{vmatrix}-1-\\lambda  & -2 & 4 & 6 \\\\ 0 & 1-\\lambda  & -1 & 0 \\\\ 0 & -2 & -\\lambda  & 5 \\\\ 0 & 0 & 0 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )\\begin{vmatrix}1-\\lambda  & -1 & 0 \\\\ -2 & -\\lambda  & 5 \\\\ 0 & 0 & -7-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(-1-\\lambda )(-7-\\lambda )\\begin{vmatrix}1-\\lambda  & -1 \\\\ -2 & -\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )(-7-\\lambda )((1-\\lambda )(-\\lambda )-2) & =0 \\\\ (\\lambda +1)(\\lambda +7)({\\lambda }^{2}-\\lambda -2) & =0 \\\\ (\\lambda +1)(\\lambda +7)(\\lambda -2)(\\lambda +1) & =0 \\\\ (\\lambda +1)^{2}(\\lambda +7)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $D$ are $\\lambda =-1$ (with algebraic multiplicity $2$), $\\lambda =-7$ and $\\lambda =2.$\n\nTherefore, the correct answer is “$\\lambda =2$ is an eigenvalue of $D$”; “$\\lambda =-1$ is an eigenvalue of $D$”; “The eigenvalue $\\lambda =-1$ has algebraic multiplicity $2$”."}] [{:db/id #edb/ref 17592186366518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fb7b1df-59af-5c98-b200-8e2db9ace225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-3{\\lambda }^{2}+2\\lambda -10=0" :db/id #edb/ref 17592186366520} {:answer/id #uuid "780e1a23-2b19-569c-80de-ba05aa572a33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -6=0" :db/id #edb/ref 17592186366521} {:answer/id #uuid "1e23239c-8a66-52b7-8ebb-bb679392ff42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}+3\\lambda +10=0" :db/id #edb/ref 17592186366522} {:answer/id #uuid "d9d592de-a8e2-59d7-af6e-a3bf5bfd67b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-3{\\lambda }^{2}+2\\lambda -6=0" :db/id #edb/ref 17592186366523} {:answer/id #uuid "023efe6a-1a85-50a5-b630-83708ee21893" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -10=0" :db/id #edb/ref 17592186366524}] :answer-field/correct {:db/id #edb/ref 17592186366524} :answer-field/id #uuid "9a1a646e-8c46-51ec-bc79-a886445b9b9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366519}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09a3b9db-e65e-598f-9745-d20fbdbcba69" :question/math-academy-id "q-86753" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle R=\\begin{bmatrix}1 & 2 & -1 \\\\ -2 & 0 & 4 \\\\ 0 & 1 & 3\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,R-\\lambda I:$\n﻿﻿﻿\n\n$$\nR-\\lambda I=\\begin{bmatrix}1-\\lambda  & 2 & -1 \\\\ -2 & -\\lambda  & 4 \\\\ 0 & 1 & 3-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(R-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st column, we get the following:\n\n$$\n\\begin{aligned}det(R-\\lambda I) & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 2 & -1 \\\\ -2 & -\\lambda  & 4 \\\\ 0 & 1 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}-\\lambda  & 4 \\\\ 1 & 3-\\lambda \\end{vmatrix}-(-2)\\begin{vmatrix}2 & -1 \\\\ 1 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-3\\lambda -4)+2(-2\\lambda +7) & =0 \\\\ (-{\\lambda }^{3}+4{\\lambda }^{2}+\\lambda -4)+(-4\\lambda +14) & =0 \\\\ -{\\lambda }^{3}+4{\\lambda }^{2}-3\\lambda +10 & =0 \\\\ {\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -10 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5e4d4a6-47d4-594a-bb6e-b1ace8a4a6c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{U}^{-1}=\\begin{bmatrix}3 & -4 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186367382} {:answer/id #uuid "881a37c9-d7f8-59f2-b7ee-095fc504a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{U}^{-1}=\\begin{bmatrix}-2 & 1 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186367383} {:answer/id #uuid "4be5e6c7-dd16-573c-b14b-40d745a1e82f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{U}^{-1}=\\begin{bmatrix}2 & 4 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186367384} {:answer/id #uuid "8b9dbd30-b95e-598f-816b-01942329f555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{U}^{-1}=\\begin{bmatrix}-3 & 2 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186367385} {:answer/id #uuid "ff56a692-b286-52a3-8b6e-59978067c457" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{U}^{-1}=\\begin{bmatrix}4 & -2 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186367386}] :answer-field/correct {:db/id #edb/ref 17592186367385} :answer-field/id #uuid "70d91655-25da-5fba-9d38-73eb64f27906" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d8a7a16-61ab-5f35-8a80-89b943b1ed70" :question/math-academy-id "q-131385" :question/problem "The inverse of the $2\\times 2$ matrix $U$ is found using row operations, as shown below. Complete the process, and determine ${U}^{-1}.$\n\n$$\n\\begin{aligned}[U\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 2 & 6 & 0 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 0 & -2 & -2 & 1\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 0 & 1 & 1 & -\\frac{1}{2}\\end{array}\\right] & {R}_{1} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $U$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $U$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[U\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 2 & 6 & 0 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 0 & -2 & -2 & 1\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 4 & 1 & 0 \\\\ 0 & 1 & 1 & -\\frac{1}{2}\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-4){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & -3 & 2 \\\\ 0 & 1 & 1 & -\\frac{1}{2}\\end{array}\\right]\\end{aligned}\n$$\n\nThe matrix ${U}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{U}^{-1}=\\begin{bmatrix}-3 & 2 \\\\ 1 & -\\frac{1}{2}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186367942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "795f98a0-cfeb-5e53-9ca4-a39e59752b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186367944}] :answer-field/correct {:db/id #edb/ref 17592186367944} :answer-field/id #uuid "92ab6d21-d5ac-5e81-b0b4-ae407584dcfd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186367943} {:answer-field/choices [{:answer/id #uuid "2c9f43a2-c733-5f0d-bf7d-1d791c0c1338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186367946}] :answer-field/correct {:db/id #edb/ref 17592186367946} :answer-field/id #uuid "bbfa6506-27b9-5c30-abe6-f50d7f5d0199" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186367945} {:answer-field/choices [{:answer/id #uuid "157efe8e-971d-5726-84b4-718316ef3184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186367948}] :answer-field/correct {:db/id #edb/ref 17592186367948} :answer-field/id #uuid "2f509bb7-1eba-5227-8840-6f3afededcc3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186367947}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4290f953-e9cc-53d8-aaec-0e2030ce4110" :question/math-academy-id "q-275760" :question/problem "The solution to the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3y+2x &=3 \\\\ x-2y &=1\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $2$ | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | $1$ | {{field-3}} |  | |  |  |  | |  | $3$ |  |\n| --- | --- | --- |\n|  | $1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $2$ | {{field-2}} |  |  |  |\n|  | $1$ | {{field-3}} |  |  |  |\n|  | $3$ |  |  |  |  |\n|  | $1$ |  |  |  |  |" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=3 \\\\ x-2y &=1.\\end{aligned}\\right.\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot (-2)-1\\cdot 3}\\begin{bmatrix}-2 & -3 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{(-7)}\\begin{bmatrix}-2 & -3 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{7}\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{7}\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a65b5bd-498c-5785-a89d-07844552eed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186367966}] :answer-field/correct {:db/id #edb/ref 17592186367966} :answer-field/id #uuid "398542b7-05d1-5048-9711-c7014964c485" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186367965} {:answer-field/choices [{:answer/id #uuid "12cea75a-1df5-57ea-99ca-6ab0811d1d98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186367968}] :answer-field/correct {:db/id #edb/ref 17592186367968} :answer-field/id #uuid "d21bb5f8-4523-5638-96df-56a604664ce2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186367967} {:answer-field/choices [{:answer/id #uuid "448bb91e-a341-5a9e-a908-9e863bf2afba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186367970}] :answer-field/correct {:db/id #edb/ref 17592186367970} :answer-field/id #uuid "7822a354-8aa6-56b2-bbdf-e8459df04ca5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186367969}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe0dfc0e-7217-593c-8e4c-31e96c17d1b3" :question/math-academy-id "q-321443" :question/problem "The solution to the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-5 \\\\ -3x+2y &=1\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-4$ |  |\n| --- | --- | --- | --- |\n|  | $3$ | {{field-3}} |  | |  |  |  | |  | $-5$ |  |\n| --- | --- | --- |\n|  | $1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-4$ |  |  |  |\n|  | $3$ | {{field-3}} |  |  |  |\n|  | $-5$ |  |  |  |  |\n|  | $1$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}-1 & 4 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n\n$$\nA=\\begin{bmatrix}-1 & 4 \\\\ -3 & 2\\end{bmatrix}.\n$$\n\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 2-(-3)\\cdot 4}\\begin{bmatrix}2 & -4 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}2 & -4 \\\\ 3 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\nx={A}^{-1}b=\\frac{1}{10}\\begin{bmatrix}2 & -4 \\\\ 3 & -1\\end{bmatrix}\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186369686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a5c820-be5b-5082-926b-e68028730b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186369688} {:answer/id #uuid "3ea3bb4d-945d-58f9-9adb-63f707e063fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186369689} {:answer/id #uuid "81a658e1-0516-5466-a149-e2eb4f1f4c21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-64" :db/id #edb/ref 17592186369690} {:answer/id #uuid "f056f334-c31b-5405-870a-03cf05d84686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186369691} {:answer/id #uuid "ae5e7563-f924-5173-b2ac-acb8371abc72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186369692}] :answer-field/correct {:db/id #edb/ref 17592186369692} :answer-field/id #uuid "f92affe9-b7e7-55a2-9d79-b25b03dbdff1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b87ab7d2-a978-564c-941d-810575e01d02" :question/math-academy-id "q-130035" :question/problem "Compute the following determinant using a cofactor expansion along the $3$rd row:\n\n$$\n\\begin{vmatrix}4 & 1 & 0 & 0 \\\\ 0 & 0 & 3 & -2 \\\\ 0 & 2 & 0 & 0 \\\\ 5 & 0 & -1 & 2\\end{vmatrix}\n$$" :question/worked-solution "Using cofactor expansion along the third row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 1 & 0 & 0 \\\\ 0 & 0 & 3 & -2 \\\\ 0 & 2 & 0 & 0 \\\\ 5 & 0 & -1 & 2\\end{vmatrix} & =0\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+2}\\cdot \\begin{vmatrix}4 & 0 & 0 \\\\ 0 & 3 & -2 \\\\ 5 & -1 & 2\\end{vmatrix} \\\\  & =-2\\begin{vmatrix}4 & 0 & 0 \\\\ 0 & 3 & -2 \\\\ 5 & -1 & 2\\end{vmatrix}\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 0 & 0 \\\\ 0 & 3 & -2 \\\\ 5 & -1 & 2\\end{vmatrix} & =4\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =4\\cdot (-1)^{1+1}\\cdot \\begin{vmatrix}3 & -2 \\\\ -1 & 2\\end{vmatrix} \\\\  & =4\\begin{vmatrix}3 & -2 \\\\ -1 & 2\\end{vmatrix} \\\\  & =4(3\\cdot 2-(-1)\\cdot (-2)) \\\\  & =4\\cdot 4 \\\\  & =16\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{vmatrix}4 & 1 & 0 & 0 \\\\ 0 & 0 & 3 & -2 \\\\ 0 & 2 & 0 & 0 \\\\ 5 & 0 & -1 & 2\\end{vmatrix}=-2\\cdot 16=-32.\n$$"}]}
