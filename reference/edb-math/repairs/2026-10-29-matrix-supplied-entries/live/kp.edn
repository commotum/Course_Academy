69" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 & 1 & \\sqrt{3} \\\\ 3 & 25 & 1 \\\\ -2\\sqrt{7} & 1 & 15\\end{bmatrix}" :db/id #edb/ref 17592186484953} {:answer/id #uuid "42cf42b7-a3c2-53dc-ba16-f1f6303e15c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 5 & 5\\sqrt{3} \\\\ 3 & 5 & 15 \\\\ -10\\sqrt{7} & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186484962} {:answer/id #uuid "857afe33-8979-5ee0-856c-c667f1a2c253" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 & 5 & 5\\sqrt{3} \\\\ 15 & 25 & 5 \\\\ -10\\sqrt{7} & 5 & 15\\end{bmatrix}" :db/id #edb/ref 17592186485106} {:answer/id #uuid "bcf646e3-9549-580f-923e-95be517cf503" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}" :db/id #edb/ref 17592186485223}] :answer-field/correct {:answer/id #uuid "857afe33-8979-5ee0-856c-c667f1a2c253" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 & 5 & 5\\sqrt{3} \\\\ 15 & 25 & 5 \\\\ -10\\sqrt{7} & 5 & 15\\end{bmatrix}" :db/id #edb/ref 17592186485106} :answer-field/id #uuid "cc48abf2-5197-5ab6-b236-59dff53ceb41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485454}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "59d9ac6b-9ad1-5629-b5da-d053470d3899" :question/math-academy-id "q-130275" :question/problem "Find $AB+CB$, where\n\n$$\nA=\\begin{bmatrix}4 & 3 & 1 \\\\ -2 & -2 & 3 \\\\ -8 & 9 & 9\\end{bmatrix},\\,B=\\begin{bmatrix}8 & 1 & \\sqrt{3} \\\\ 3 & 5 & 1 \\\\ -2\\sqrt{7} & 1 & 3\\end{bmatrix},\\,C=\\begin{bmatrix}1 & -3 & -1 \\\\ 2 & 7 & -3 \\\\ 8 & -9 & -4\\end{bmatrix}.\n$$" :question/worked-solution "We apply the distributive law\n\n$$\nAB+CB=(A+C)B.\n$$\n\nSo, we calculate $A+C$ first:\n\n$$\n\\begin{aligned}A+C & =\\begin{bmatrix}4 & 3 & 1 \\\\ -2 & -2 & 3 \\\\ -8 & 9 & 9\\end{bmatrix}+\\begin{bmatrix}1 & -3 & -1 \\\\ 2 & 7 & -3 \\\\ 8 & -9 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =5{I}_{3}\\end{aligned}\n$$\n\n \n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+CB & =(A+C)B \\\\  & =5{I}_{3}B \\\\  & =5B \\\\  & =\\begin{bmatrix}40 & 5 & 5\\sqrt{3} \\\\ 15 & 25 & 5 \\\\ -10\\sqrt{7} & 5 & 15\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e233e64-3579-5308-adcf-0a3d34ed29d1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484954}] :answer-field/correct {:answer/id #uuid "3e233e64-3579-5308-adcf-0a3d34ed29d1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484954} :answer-field/id #uuid "47bcd799-0bc3-56c0-89be-70bb4ebb64ff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485398} {:answer-field/choices [{:answer/id #uuid "0ebeac41-ad6f-5e78-914d-22f0aeb5dd17" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186484846}] :answer-field/correct {:answer/id #uuid "0ebeac41-ad6f-5e78-914d-22f0aeb5dd17" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186484846} :answer-field/id #uuid "aae6b6ee-6c60-535b-9bd3-32a07cc14ec8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485441} {:answer-field/choices [{:answer/id #uuid "24f12064-302a-52c9-8e88-80bf05a286d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186484886}] :answer-field/correct {:answer/id #uuid "24f12064-302a-52c9-8e88-80bf05a286d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186484886} :answer-field/id #uuid "ae3e7ed6-338b-5cae-8e40-b8c7b35d8018" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485443}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5fdc95ea-e1eb-5331-974c-7dbe555559e4" :question/math-academy-id "q-319197" :question/problem "Calculate $AC+BC$, where\n\n$$\nA=\\begin{bmatrix}3 & 0 & -2 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}-2 & 0 & 2 \\\\ -1 & -1 & -4 \\\\ 0 & -1 & -4\\end{bmatrix},\\,C=\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & 4 & 2 \\\\ 5 & -1 & 3\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AC+BC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$2$</td><td>{{field-1}}</td><td>$0$</td></tr>\n<tr><td>{{field-2}}</td><td>$4$</td><td>$2$</td></tr>\n<tr><td>$5$</td><td>{{field-3}}</td><td>$3$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "We can apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}3 & 0 & -2 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 5\\end{bmatrix}+\\begin{bmatrix}-2 & 0 & 2 \\\\ -1 & -1 & -4 \\\\ 0 & -1 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & ={I}_{3}\\cdot C \\\\  & =C \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & 4 & 2 \\\\ 5 & -1 & 3\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6afbb954-8251-54c6-9289-3b7b67977c2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3\\sqrt{2} & 3\\sqrt{3} \\\\ 6 & 3\\sqrt{3} & 6 \\\\ 9 & 6 & 3\\sqrt{5}\\text{ }\\end{bmatrix}" :db/id #edb/ref 17592186485049} {:answer/id #uuid "9f8c7b20-ab9a-5f82-aa71-ab274f566e4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186485162} {:answer/id #uuid "a457aec9-c905-57bd-a32b-334aab799f02" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3\\sqrt{3} & 0 \\\\ 0 & 0 & 3\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186485175} {:answer/id #uuid "d93c949b-2601-5a6c-bdfe-2a018e7d7553" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -\\sqrt{2} & -\\sqrt{3} \\\\ -2 & -\\sqrt{3} & -2 \\\\ -3 & -2 & -\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186485273} {:answer/id #uuid "dbc1e4f5-2794-5ee2-870f-276a9e8a1fc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & \\sqrt{2} & \\sqrt{3} \\\\ 2 & \\sqrt{3} & 2 \\\\ 3 & 2 & \\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186485279}] :answer-field/correct {:answer/id #uuid "6afbb954-8251-54c6-9289-3b7b67977c2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3\\sqrt{2} & 3\\sqrt{3} \\\\ 6 & 3\\sqrt{3} & 6 \\\\ 9 & 6 & 3\\sqrt{5}\\text{ }\\end{bmatrix}" :db/id #edb/ref 17592186485049} :answer-field/id #uuid "1201651f-fb8b-5f4f-9fec-edb4aa86cc4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485374}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "72e0b567-7c07-513e-b4b8-2088d6f698dd" :question/math-academy-id "q-75612" :question/problem "Find $AC+BC$, where\n\n$$\nA=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & -3 & 1 \\\\ 3 & 2 & -6\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -2 & 1 \\\\ -3 & 6 & -1 \\\\ -3 & -2 & 9\\end{bmatrix},\\,C=\\begin{bmatrix}1 & \\sqrt{2} & \\sqrt{3} \\\\ 2 & \\sqrt{3} & 2 \\\\ 3 & 2 & \\sqrt{5}\\end{bmatrix}.\n$$" :question/worked-solution "We apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & -3 & 1 \\\\ 3 & 2 & -6\\end{bmatrix}+\\begin{bmatrix}2 & -2 & 1 \\\\ -3 & 6 & -1 \\\\ -3 & -2 & 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =3{I}_{3}\\end{aligned}\n$$\n\n \n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & =3{I}_{3}C \\\\  & =3C \\\\  & =\\begin{bmatrix}3 & 3\\sqrt{2} & 3\\sqrt{3} \\\\ 6 & 3\\sqrt{3} & 6 \\\\ 9 & 6 & 3\\sqrt{5}\\text{ }\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a2ce50d-bf34-5f48-ab8e-790c73e2b7b0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186535150}] :answer-field/correct {:answer/id #uuid "6a2ce50d-bf34-5f48-ab8e-790c73e2b7b0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186535150} :answer-field/id #uuid "010c2d60-a1ff-58e4-a55d-a5b31f3c3963" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535144} {:answer-field/choices [{:answer/id #uuid "37947f45-c932-53a3-8557-a7495e179229" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186535148}] :answer-field/correct {:answer/id #uuid "37947f45-c932-53a3-8557-a7495e179229" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186535148} :answer-field/id #uuid "0fa0e75c-170c-59c8-a337-702945bb0847" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535145} {:answer-field/choices [{:answer/id #uuid "1decb065-4465-5244-97f7-ee5d153a18b7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186535146}] :answer-field/correct {:answer/id #uuid "1decb065-4465-5244-97f7-ee5d153a18b7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186535146} :answer-field/id #uuid "43c7af27-397e-5bc3-b478-fd0467623702" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 175921865351