d-4}}</td><td>$-3$</td><td>{{field-1}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $C$ on the right and preserve the order of the addition:\n\n$$\nAC+BC=(A+B)C.\n$$\n\nCombine corresponding entries first:\n\n$$\nA+B=\\begin{bmatrix}-1 & 1 & 0 \\\\ -1 & 0 & 1 \\\\ 0 & -1 & -1\\end{bmatrix}.\n$$\n\nUse row-by-column multiplication on the shorter product $(A+B)C$.\n\n$$\n\\begin{aligned}(AC+BC)_{33}&=(-1)(2)+(-1)(1)=-3 \\\\ (AC+BC)_{22}&=(-1)(-1)+(1)(3)=4 \\\\ (AC+BC)_{11}&=(1)(3)=3 \\\\ (AC+BC)_{31}&=(-1)(3)+(-1)(-3)=0\\end{aligned}\n$$\n\n\n\n$$\nAC+BC=\\begin{bmatrix}3 & 1 & 4 \\\\ -3 & 4 & 3 \\\\ 0 & -3 & -3\\end{bmatrix}.\n$$\n\n"} {:db/id #edb/ref 17592186717759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "754d4ce0-c426-5b35-bf28-82a6c831fe5d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186717765}] :answer-field/correct {:answer/id #uuid "754d4ce0-c426-5b35-bf28-82a6c831fe5d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186717765} :answer-field/id #uuid "126295a5-dd61-58d3-a425-dbfa4c6b22fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717754} {:answer-field/choices [{:answer/id #uuid "5e56f60e-d567-5b46-86c5-9b85f36f3ceb" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186717761}] :answer-field/correct {:answer/id #uuid "5e56f60e-d567-5b46-86c5-9b85f36f3ceb" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186717761} :answer-field/id #uuid "93c299b2-400e-5287-ac51-a794ec8612eb" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717773} {:answer-field/choices [{:answer/id #uuid "6f122a3d-60ef-5e3e-a38b-7b2f198aad00" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186717764}] :answer-field/correct {:answer/id #uuid "6f122a3d-60ef-5e3e-a38b-7b2f198aad00" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186717764} :answer-field/id #uuid "b64becee-83c1-5f5c-bacf-b2674bf4ad68" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717778} {:answer-field/choices [{:answer/id #uuid "0fee4776-9139-5be1-acfc-51a834157b92" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186717753}] :answer-field/correct {:answer/id #uuid "0fee4776-9139-5be1-acfc-51a834157b92" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186717753} :answer-field/id #uuid "cf327bdf-cc30-52e9-ae04-683c180e8f56" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717783}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4471c240-666f-5f09-bee5-21fd864bc0e3" :question/problem "Calculate $BC-BA$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}3 & 0 & -2 \\\\ -4 & 3 & 3 \\\\ 0 & -4 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-3 & 2 & -3 \\\\ 1 & -3 & -2 \\\\ 0 & 3 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & -1 & -1 \\\\ -3 & 2 & 3 \\\\ -1 & -4 & 4\\end{bmatrix}$</div>\n</div>\n\nFill in the missing entries.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$BC-BA=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-2}}</td><td>{{field-1}}</td><td>$-6$</td></tr>\n<tr><td>{{field-3}}</td><td>$2$</td><td>$-1$</td></tr>\n<tr><td>$2$</td><td>$-3$</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $B$ on the left and preserve the order of the subtraction:\n\n$$\nBC-BA=B(C-A).\n$$\n\nCombine corresponding entries first:\n\n$$\nC-A=\\begin{bmatrix}0 & -1 & 1 \\\\ 1 & -1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}.\n$$\n\nUse row-by-column multiplication on the shorter product $B(C-A)$.\n\n$$\n\\begin{aligned}(BC-BA)_{12}&=(-3)(-1)+(2)(-1)=1 \\\\ (BC-BA)_{11}&=(2)(1)+(-3)(-1)=5 \\\\ (BC-BA)_{21}&=(-3)(1)+(-2)(-1)=-1 \\\\ (BC-BA)_{33}&=(1)(1)=1\\end{aligned}\n$$\n\n\n\n$$\nBC-BA=\\begin{bmatrix}5 & 1 & -6 \\\\ -1 & 2 & -1 \\\\ 2 & -3 & 1\\end{bmatrix}.\n$$\n\n"} {:db/id #edb/ref 17592186717763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0f5096c-b272-5e9d-b79d-c2447c2abeba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717775}] :answer-field/correct {:answer/id #uuid "a0f5096c-b272-5e9d-b79d-c2447c2abeba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717775} :answer-field/id #uuid "0f5962c6-9ec6-5815-98ee-11e9962b6512" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717752} {:answer-field/choices [{:answer/id #uuid "7be0ecf3-5cbb-57da-856a-58089a2ec00b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186717768}] :answer-field/correct {:answer/id #uuid "7be0ecf3-5cbb-57da-856a-58089a2ec00b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186717768} :answer-field/id #uuid "75c8ba7d-b755-5ebb-9d27-38bbb5775bb7" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717766} {:answer-field/choices [{:answer/id #uuid "1d91d0e9-0a8b-5793-a23d-2dc4d7f20f10" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186717756}] :answer-field/correct {:answer/id #uuid "1d91d0e9-0a8b-5793-a23d-2dc4d7f20f10" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186717756} :answer-field/id #uuid "91aa9d0d-643f-5e28-9234-d323367719ab" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717771} {:answer-field/choices [{:answer/id #uuid "cbd8a326-91bf-5020-bf55-d12d242dec98" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186717781}] :answer-field/correct {:answer/id #uuid "cbd8a326-91bf-5020-bf55-d12d242dec98" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186717781} :answer-field/id #uuid "afa1b357-96d9-536d-a154-09980db22bb0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717777}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "680fddfd-6ede-51c4-9581-cb5528ee6a34" :question/problem "Calculate $CA-BA$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-2 & 0 & -3 \\\\ 3 & -3 & 1 \\\\ 2 & 0 & -3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & -3 & 2 \\\\ 3 & 2 & 3 \\\\ -3 & 3 & 4\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & -3 & 3 \\\\ 3 & 3 & 2 \\\\ -4 & 4 & 4\\end{bmatrix}$</div>\n</div>\n\nFill in the missing entries.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$CA-BA=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-2}}</td><td>$0$</td><td>{{field-1}}</td></tr>\n<tr><td>$1$</td><td>$-3$</td><td>$4$</td></tr>\n<tr><td>{{field-4}}</td><td>{{field-3}}</td><td>$4$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $A$ on the right and preserve the order of the subtraction:\n\n$$\nCA-BA=(C-B)A.\n$$\n\nCombine corresponding entries first:\n\n$$\nC-B=\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & -1 \\\\ -1 & 1 & 0\\end{bmatrix}.\n$$\n\nUse row-by-column multiplication on the shorter product $(C-B)A$.\n\n$$\n\\begin{aligned}(CA-BA)_{13}&=(1)(-3)+(1)(-3)=-6 \\\\ (CA-BA)_{11}&=(1)(-2)+(1)(2)=0 \\\\ (CA-BA)_{32}&=(1)(-3)=-3 \\\\ (CA-BA)_{31}&=(-1)(-2)+(1)(3)=5\\end{aligned}\n$$\n\n\n\n$$\nCA-BA=\\begin{bmatrix}0 & 0 & -6 \\\\ 1 & -3 & 4 \\\\ 5 & -3 & 4\\end{bmatrix}.\n$$\n\n"} {:db/id #edb/ref 17592186717772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eac32dc-2b45-57cd-a24c-ad4b54e467c0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717758}] :answer-field/correct {:answer/id #uuid "3eac32dc-2b45-57cd-a24c-ad4b54e467c0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717758} :answer-field/id #uuid "1eb69a77-aecf-5bed-a0ac-9c9f23572ff2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717757} {:answer-field/choices [{:answer/id #uuid "565d9603-5c0a-58df-96ca-1a621e44556f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186717760}] :answer-field/correct {:answer/id #uuid "565d9603-5c0a-58df-96ca-1a621e44556f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186717760} :answer-field/id #uuid "8cf80ed4-0848-587b-b1dc-2f762b1ac5a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717770} {:answer-field/choices [{:answer/id #uuid "c92ba4c7-6ceb-5df4-a56c-fff6de4f5216" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186717780}] :answer-field/correct {:answer/id #uuid "c92ba4c7-6ceb-5df4-a56c-fff6de4f5216" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186717780} :answer-field/id #uuid "ce87884a-7623-5d5a-89c0-4ce68efc6923" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717782} {:answer-field/choices [{:answer/id #uuid "62a0c851-df8b-5f14-af8b-2d07faaffb76" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186717762}] :answer-field/correct {:answer/id #uuid "62a0c851-df8b-5f14-af8b-2d07faaffb76" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186717762} :answer-field/id #uuid "e49c8346-b882-59ad-9d37-984fd0f9b98b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717786}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9276d11b-63d1-5b46-99cc-481d483e381a" :question/problem "Calculate $AB+AC$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}2 & -1 & 1 \\\\ 2 & -1 & 2 \\\\ 1 & -2 & -3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 2 & 0 \\\\ 3 & -1 & 0 \\\\ 3 & -1 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}-3 & -3 & 0 \\\\ -4 & 1 & 1 \\\\ -3 & 2 & -2\\end{bmatrix}$</div>\n</div>\n\nFill in the missing entries.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB+AC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-3}}</td><td>$-1$</td><td>{{field-4}}</td></tr>\n<tr><td>$-1$</td><td>{{field-2}}</td><td>{{field-1}}</td></tr>\n<tr><td>$1$</td><td>$-4$</td><td>$1$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $A$ on the left and preserve the order of the addition:\n\n$$\nAB+AC=A(B+C).\n$$\n\nCombine corresponding entries first:\n\n$$\nB+C=\\begin{bmatrix}-1 & -1 & 0 \\\\ -1 & 0 & 1 \\\\ 0 & 1 & -1\\end{bmatrix}.\n$$\n\nUse row-by-column multiplication on the shorter product $A(B+C)$.\n\n$$\n\\begin{aligned}(AB+AC)_{23}&=(-1)(1)+(2)(-1)=-3 \\\\ (AB+AC)_{22}&=(2)(-1)+(2)(1)=0 \\\\ (AB+AC)_{11}&=(2)(-1)+(-1)(-1)=-1 \\\\ (AB+AC)_{13}&=(-1)(1)+(1)(-1)=-2\\end{aligned}\n$$\n\n\n\n$$\nAB+AC=\\begin{bmatrix}-1 & -1 & -2 \\\\ -1 & 0 & -3 \\\\ 1 & -4 & 1\\end{bmatrix}.\n$$\n\n"}] :knowledge-point/title "Calculating a Matrix Product Using the Distributive Law"}]}
