[{"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "d5f46995-e92d-5a54-aeb8-6e36d18e5662", ":question/difficulty": ":question.difficulty/hard", ":question/problem": "Find the domain of the function $f(x,y)=\\arcsin\\left(\\frac{1}{-x+2y+1}\\right).$", ":question/worked-solution": "The inner quotient requires $-x+2y+1\\ne 0$.\n\nThe input of $\\arcsin$ must lie in the closed interval $[-1,1]$, including both endpoints. Therefore $-1\\le \\frac{1}{-x+2y+1}\\le 1$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-1\\le \\frac{1}{-x+2y+1}\\le 1 \\\\ -x+2y+1\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le \\frac{1}{-x+2y+1}\\le 1 \\\\ &-x+2y+1\\ne 0\\end{aligned}\\right\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "3235fa6d-89e7-5d86-b66f-e205216ee961", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "9b6ad5de-1a24-5d26-87dc-f50519cdb178", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-\\frac{\\pi}{2}\\le \\frac{1}{-x+2y+1}\\le \\frac{\\pi}{2} \\\\ &-x+2y+1\\ne 0\\end{aligned}\\right\\}"}, {":answer/id": "453a49bf-2837-55e6-bd3f-7f92121ddb4e", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le \\frac{1}{-x+2y+1}\\le 1 \\\\ &-x+2y+1\\ne 0 \\\\ &x\\ne 0\\end{aligned}\\right\\}"}, {":answer/id": "4d3ee7fd-b80b-506d-ae6b-10ec0dece511", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le \\frac{1}{-x+2y+1}\\le 1 \\\\ &-x+2y+1\\ne 0\\end{aligned}\\right\\}"}, {":answer/id": "49b2b583-9af6-58cc-ab0a-23e685b5d206", ":answer/type": ":answer.type/math", ":answer/value": "\\mathbb{R}^{2}"}, {":answer/id": "8f139ec6-173d-5cdc-b2d4-69e3d8f7ba21", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&0<\\frac{1}{-x+2y+1}\\le 1 \\\\ &-x+2y+1\\ne 0\\end{aligned}\\right\\}"}], ":answer-field/correct": [":answer/id", "4d3ee7fd-b80b-506d-ae6b-10ec0dece511"]}]}, "generation": {"family": "inverse_reciprocal", "parameters": {"u": "-x+2y+1", "v": "-x+2y+1", "w": "x", "op": "arcsin", "power": 1, "numerator": "x^{3}", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158583"], "conversions": [], "math_format": "course-academy-tex-v1"}}, {"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "aa64aa99-77f0-5bd2-aab9-892a569bddd6", ":question/difficulty": ":question.difficulty/hard", ":question/problem": "Find the domain of the function $f(x,y)=\\arcsin\\left(y+\\sqrt{x}\\right).$", ":question/worked-solution": "The inner square root requires $x\\ge 0$.\n\nThe input of $\\arcsin$ must lie in the closed interval $[-1,1]$, including both endpoints. Therefore $-1\\le y+\\sqrt{x}\\le 1$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-1\\le y+\\sqrt{x}\\le 1 \\\\ x\\ge 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le y+\\sqrt{x}\\le 1 \\\\ &x\\ge 0\\end{aligned}\\right\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "f899434e-55aa-511c-a66c-a920e60a5a5e", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "fd36b5b6-94c1-5f58-95ea-c56134ad4076", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le y+\\sqrt{x}\\le 1 \\\\ &x\\ge 0\\end{aligned}\\right\\}"}, {":answer/id": "f257fc26-5929-523d-8398-2d118459319c", ":answer/type": ":answer.type/math", ":answer/value": "\\mathbb{R}^{2}"}, {":answer/id": "11eca3a8-867e-52a1-9cc0-7e27a677a277", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&0\\le y+\\sqrt{x}\\le \\pi \\\\ &x\\ge 0\\end{aligned}\\right\\}"}, {":answer/id": "826c64ec-b574-52e4-9454-8df1ee25acc0", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le y+x\\le 1 \\\\ &x\\ge 0\\end{aligned}\\right\\}"}, {":answer/id": "2686e10c-a23d-5394-8121-75970f81b9ad", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1<y+\\sqrt{x}<1 \\\\ &x\\ge 0\\end{aligned}\\right\\}"}], ":answer-field/correct": [":answer/id", "fd36b5b6-94c1-5f58-95ea-c56134ad4076"]}]}, "generation": {"family": "inverse_root", "parameters": {"u": "x^{2}-y^{2}", "v": "x", "w": "y", "op": "arcsin", "power": 1, "numerator": "y^{2}", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158589"], "conversions": [], "math_format": "course-academy-tex-v1"}}, {"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "ccde3377-6984-537c-84ab-47b7cecc513d", ":question/difficulty": ":question.difficulty/hard", ":question/problem": "Find the domain of the function $f(x,y)=\\arccos\\left(-x-y\\right).$", ":question/worked-solution": "The inner polynomial is defined everywhere.\n\nThe input of $\\arccos$ must lie in the closed interval $[-1,1]$, including both endpoints. Therefore $-1\\le -x-y\\le 1$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-1\\le -x-y\\le 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb{R}^{2}:\\,-1\\le -x-y\\le 1\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "4b31488c-2503-58b9-97cf-b52dc5134307", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "7828dcf5-43b7-5d2a-8725-5232475c7cba", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,0\\le -x-y\\le \\pi\\}"}, {":answer/id": "d383c86f-20f5-52f2-8cbc-b5afb78f6e51", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x-y\\ne 0\\}"}, {":answer/id": "d183a9f3-4829-5cf9-b53c-5c8f24ec83e1", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-1\\le -x-y\\le 1\\}"}, {":answer/id": "8fd865fa-95b1-5b0f-af64-a6ee3d4a9ce3", ":answer/type": ":answer.type/math", ":answer/value": "\\mathbb{R}^{2}"}, {":answer/id": "2e24fb24-9ab6-5f69-a15c-c1ab6dd42b75", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le -x-y\\le 1 \\\\ &x\\ne 0\\end{aligned}\\right\\}"}], ":answer-field/correct": [":answer/id", "d183a9f3-4829-5cf9-b53c-5c8f24ec83e1"]}]}, "generation": {"family": "inverse", "parameters": {"u": "-x-y", "v": "x-1", "w": "y", "op": "arccos", "power": 1, "numerator": "x^{3}", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158181", "q-158580"], "conversions": [], "math_format": "course-academy-tex-v1"}}]
