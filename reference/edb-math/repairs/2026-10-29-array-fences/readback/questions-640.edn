1aaaeb3a-38af-536b-adf5-32090beb4ef8" :answer/type {:db/ident :answer.type/math} :answer/value "-0.92" :db/id #edb/ref 17592186533203} {:answer/id #uuid "d87b0ef7-78ce-5960-ae8f-4cbf0d6f6243" :answer/type {:db/ident :answer.type/math} :answer/value "-1.36" :db/id #edb/ref 17592186533669} {:answer/id #uuid "dffa4b1e-3824-58f3-8269-6dd937669df5" :answer/type {:db/ident :answer.type/math} :answer/value "-0.16" :db/id #edb/ref 17592186533694} {:answer/id #uuid "fbdfdb9f-b437-5a51-a678-435f997107b2" :answer/type {:db/ident :answer.type/math} :answer/value "0.30" :db/id #edb/ref 17592186533759}] :answer-field/correct {:db/id #edb/ref 17592186533669} :answer-field/id #uuid "cab7b38a-04c3-5b5c-abd3-248ae2ec81ee" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186533924} {:answer-field/choices [{:answer/id #uuid "03e9c5de-0e88-581e-83f0-4e610ace94c7" :answer/type {:db/ident :answer.type/math} :answer/value "2.72" :db/id #edb/ref 17592186533141} {:answer/id #uuid "21d2c724-1d34-5316-9a84-28fe34c40ff1" :answer/type {:db/ident :answer.type/math} :answer/value "-1.65" :db/id #edb/ref 17592186533218} {:answer/id #uuid "5d1b62c3-0289-5288-a293-4b938fe71832" :answer/type {:db/ident :answer.type/math} :answer/value "4.08" :db/id #edb/ref 17592186533350} {:answer/id #uuid "d5de3dd4-4841-5da8-9acb-589598a0ea11" :answer/type {:db/ident :answer.type/math} :answer/value "0.49" :db/id #edb/ref 17592186533660}] :answer-field/correct {:db/id #edb/ref 17592186533350} :answer-field/id #uuid "ddf277ff-0705-5167-8b74-05c8ef3b77c1" :answer-field/key "field-8" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186533933} {:answer-field/choices [{:answer/id #uuid "36ade065-04cb-56fa-badf-a713e9212bf8" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{-2t}" :db/id #edb/ref 17592186533268} {:answer/id #uuid "62e4cb92-0825-54c2-ab59-7acd871353ce" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2t}" :db/id #edb/ref 17592186533367} {:answer/id #uuid "6aec5bdb-6052-5017-8cf2-42fb083477e3" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-2t}" :db/id #edb/ref 17592186533389} {:answer/id #uuid "a8248137-e842-5af1-b6c2-063abb2bc006" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{2t}" :db/id #edb/ref 17592186533547}] :answer-field/correct {:db/id #edb/ref 17592186533389} :answer-field/id #uuid "fc4487a4-144f-5b03-86d5-0ad215d73311" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186533966}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d04cdee5-5005-58d2-afad-7aaebd536510" :question/math-academy-id "q-333601" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)+y(t) \\\\ {y}^{′}(t)=-x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector $v=[1,\\text{ }-1]^{T}$ corresponds to the repeated eigenvalue $\\lambda =-2$ of the system's matrix $A.$ The vector $w=[0,\\text{ }1]^{T}$ is such that $(A-\\lambda I)w=v.$ Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{-2t}+{c}_{2}(\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}t{e}^{-2t}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{{field-1}}) \\\\  & ={c}_{1}{e}^{-2t}{{field-2}}+{c}_{2}{e}^{-2t}\\begin{bmatrix}t \\\\ -t+1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{-2t}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\nlie on that line. \n\nSince ${e}^{-2t}\\to $ \n{{field-4}} \nas $t\\to \\infty ,$ these solutions approach \n{{field-5}}  \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/45/4522e4e6ed382e821aaa47d40a191135161f95eef276b6e8ba3a8514e6bfdfd8.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{-2t}\\begin{bmatrix}t \\\\ -t+1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x={{field-6}} \\\\ y=(-t+1){e}^{-2t}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-7}} | $0$ | $0.18$ |\n| $y$ | {{field-8}} | $1$ | $0.18$ |\n\nLet's add the solutions to the phase space.\n\n![](images/db/dbf5a13ecd5e81c399204fd29d235e410fcb62274555cf3e5b32a383c1078d24.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/a6/a680b8c9319290df3beb20d7db964f385b368b01ead33961e2c10d22b19db4eb.png)" :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =-2$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =-2,\\,v=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\\,w=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{-2t}+{c}_{2}(\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}t{e}^{-2t}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-2t}) \\\\  & ={c}_{1}{e}^{-2t}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}+{c}_{2}{e}^{-2t}\\begin{bmatrix}t \\\\ -t+1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$ has the equation \n\n$$\ny=-x\n$$\n\nand the straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{-2t}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\nlie on that line. \n\nSince ${e}^{-2t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/45/4522e4e6ed382e821aaa47d40a191135161f95eef276b6e8ba3a8514e6bfdfd8.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{-2t}\\begin{bmatrix}t \\\\ -t+1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{-2t} \\\\ y=(-t+1){e}^{-2t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-1.36$ | $0$ | $0.18$ |\n| $y$ | $4.08$ | $1$ | $0.18$ |\n\nLet's add the solutions to the phase space.\n\n![](images/db/dbf5a13ecd5e81c399204fd29d235e410fcb62274555cf3e5b32a383c1078d24.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/13/13a57f14ea65118473c24c6eb1dbf50a0461060201ced051bb2eb6776f5daf64.png)"}] [{:db/id #edb/ref 17592186534978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16636eaa-e2cc-5e82-a93c-29ae2c9a4b79" :answer/type {:db/ident :answer.type/math} :answer/value "a=4,\\,b=-5" :db/id #edb/ref 17592186534317} {:answer/id #uuid "590d032f-044c-52af-affe-ade519cfab6e" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=4" :db/id #edb/ref 17592186534445} {:answer/id #uuid "9c9268e1-dbb3-5170-96ed-895c49adebf4" :answer/type {:db/ident :answer.type/math} :answer/value "a=3,\\,b=-2" :db/id #edb/ref 17592186534613} {:answer/id #uuid "c40a62c3-bbe0-5d17-9e8f-240d7fe1b737" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=1" :db/id #edb/ref 17592186534704} {:answer/id #uuid "efbe8073-8987-54ae-9846-bf0535624288" :answer/type {:db/ident :answer.type/math} :answer/value "a=0,\\,b=3" :db/id #edb/ref 17592186534798}] :answer-field/correct {:db/id #edb/ref 17592186534613} :answer-field/id #uuid "172d876b-a2ec-53c9-b98d-a6ec2ea0fdc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534842}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f1e5457-cea5-5c5a-997b-b02818578f46" :question/math-academy-id "q-216060" :question/problem "$$\n\\{\\begin{aligned}a+\\frac{3}{5}b=\\frac{9}{5} \\\\ \\frac{3}{7}a+\\frac{1}{7}b=1\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of fractions, we multiply the first equation by $5$ and the second equation by $7,$ as follows:\n\n$$\n\\{\\begin{aligned}a+\\frac{3}{5}b=\\frac{9}{5} & |\\times 5 \\\\ \\frac{3}{7}a+\\frac{1}{7}b=1 & |\\times 7\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5a+3b=9 \\\\ 3a+b=7\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Notice that the second equation can easily be solved for $b:$\n\n$$\n\\begin{aligned}3a+b & =7 \\\\ b & =7-3a\\end{aligned}\n$$\n\nWe substitute $b=7-3a$ into the first equation and then solve for $a:$\n\n$$\n\\begin{aligned}5a+3b & =9 \\\\ 5a+3(7-3a) & =9 \\\\ 5a+21-9a & =9 \\\\ -4a & =-12 \\\\ a & =3\\end{aligned}\n$$\n\nFinally, to find the value of $b,$ we substitute $a=3$ into the equation $b=7-3a$ as follows:\n\n$$\n\\begin{aligned}b & =7-3a \\\\  & =7-3(3) \\\\  & =7-9 \\\\  & =-2\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $a=3$ and $b=-2.$"}] [{:db/id #edb/ref 17592186534993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e6143a6-0fdd-5669-84d8-0e113cd51643" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186534620}] :answer-field/correct {:db/id #edb/ref 17592186534620} :answer-field/id #uuid "22db2219-dd1d-5c73-8420-03acf31177fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534853} {:answer-field/choices [{:answer/id #uuid "7b7dfa22-473e-57b5-a937-ceec1b5ff546" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186534530}] :answer-field/correct {:db/id #edb/ref 17592186534530} :answer-field/id #uuid "8cc1d4df-8587-5128-8fdf-3b45c0f0a1dc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534906}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2f8f1100-44e9-5de0-ac27-77c13ead7f67" :question/math-academy-id "q-215740" :question/problem "$$\n\\{\\begin{aligned}2x+\\frac{1}{3}y=6 \\\\ 5x-y=4\\end{aligned}\n$$\n\nFind the solution to the system of equations given above.\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $3.$\n\n$$\n\\{\\begin{aligned}2x+\\frac{1}{3}y=6 & |\\,\\times 3 \\\\ 5x-y=4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}6x+y=18 \\\\ 5x-y=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $y$ term in the first equation can cancel with the $-y$ term in the second equation.\n\nAdding the two equations eliminates the $y$-variable, and allows us to solve for $x:$\n\n$$\n\\begin{array}{rl}6x+\\cancel{y} & =18 \\\\ 5x-\\cancel{y} & =4 \\\\ \\hline 11x & =22 \\\\ x & =2\\end{array}\n$$\n\nFinally, we can substitute $x=2$ into the equation $6x+y=18$ to solve for $y:$\n\n$$\n\\begin{aligned}6x+y & =18 \\\\ 6\\cdot 2+y & =18 \\\\ 12+y & =18 \\\\ y & =6\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=2,\\,y=6.$"}] [{:db/id #edb/ref 17592186535018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccf4bfc3-88a6-5d09-ae6d-e269ffac1931" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186534724}] :answer-field/correct {:db/id #edb/ref 17592186534724} :answer-field/id #uuid "32fbac1b-2c0d-5963-85ad-5444d6fe7fc9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534860} {:answer-field/choices [{:answer/id #uuid "ad656808-65b5-5adb-8dd4-7e9667a6904d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186534655}] :answer-field/correct {:db/id #edb/ref 17592186534655} :answer-field/id #uuid "3d296c9e-3e4f-5251-b99c-1087847747be" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534866}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "634cc981-026f-5720-a0d6-757e4b38cffe" :question/math-academy-id "q-215834" :question/problem "$$\n\\{\\begin{aligned}5x+2y=1 \\\\ \\frac{2x}{3}-\\frac{y}{9}=-1\\end{aligned}\n$$\n\nFind the solution to the system of equations given above.\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}" :question/worked-solution "To get rid of the fractions in the second equation, we must multiply the second equation by the lowest common denominator of the fractions, which is $9.$\n\n$$\n\\{\\begin{aligned}5x+2y=1 \\\\ \\frac{2x}{3}-\\frac{y}{9}=-1 & |\\,\\times 9\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5x+2y=1 \\\\ 6x-y=-9\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Let's solve for $y$ in the second equation:\n\n$$\n\\begin{aligned}6x-y & =-9 \\\\ 6x+9 & =y \\\\ y & =6x+9\\end{aligned}\n$$\n\nThen, we can substitute $y=6x+9$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}5x+2y & =1 \\\\ 5x+2(6x+9) & =1 \\\\ 5x+12x+18 & =1 \\\\ 17x+18 & =1 \\\\ 17x & =-17 \\\\ x & =-1\\end{aligned}\n$$\n\nFinally, to find the value of $y,$ we substitute $x=-1$ into the equation $y=6x+9,$ as follows:\n\n$$\n\\begin{aligned}y & =6x+9 \\\\  & =6(-1)+9 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-1,\\,y=3.$"}] [{:db/id #edb/ref 17592186535038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81b3f5e6-7b2e-56b7-9389-d1e188527eb5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186534547}] :answer-field/correct {:db/id #edb/ref 17592186534547} :answer-field/id #uuid "2cb22693-eb88-5d68-998f-9fb46b5af777" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534858} {:answer-field/choices [{:answer/id #uuid "615d06a8-9c96-51de-bff8-a126ddbcc263" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186534463}] :answer-field/correct {:db/id #edb/ref 17592186534463} :answer-field/id #uuid "b535eccc-73da-535c-a127-32c7c5dd2549" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534935}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87b4272d-ed6b-52ae-b49c-9dfe670380e7" :question/math-academy-id "q-216038" :question/problem "$$\n\\{\\begin{aligned}\\frac{1}{3}p-\\frac{1}{4}q=3 \\\\ -4p-7q=4\\end{aligned}\n$$\n\nFind the solution to the system of equations given above.\n\n$p=$\n{{field-1}}$,\\,q=$\n{{field-2}}" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $12.$\n\n$$\n\\{\\begin{aligned}\\frac{1}{3}p-\\frac{1}{4}q=3 & |\\,\\times 12 \\\\ -4p-7q=4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}4p-3q=36 \\\\ -4p-7q=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $4p$ term in the first equation can cancel with the $-4p$ term in the second equation.\n\nAdding the two equations eliminates the $p$-variable, and allows us to solve for $q:$\n\n$$\n\\begin{array}{rl}\\cancel{4p}-3q & =36 \\\\ -\\cancel{4p}-7q & =4 \\\\ \\hline -10q & =40 \\\\ q & =-4\\end{array}\n$$\n\nFinally, we can substitute $q=-4$ into the equation $-4p-7q=4$ to solve for $p:$\n\n$$\n\\begin{aligned}-4p-7q & =4 \\\\ -4p-7\\cdot (-4) & =4 \\\\ -4p+28 & =4 \\\\ -4p & =-24 \\\\ p & =6\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $p=6$ and $q=-4.$"}] [{:db/id #edb/ref 17592186535043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0293fcaf-7265-58db-982d-824c6a56e9e6" :answer/type {:db/ident :answer.type/math} :answer/value "x=0,\\,y=-\\frac{10}{3}" :db/id #edb/ref 17592186534268} {:answer/id #uuid "5fcca77f-33b4-51d9-b59e-2f22876bcd95" :answer/type {:db/ident :answer.type/math} :answer/value "x=4,\\,y=-5" :db/id #edb/ref 17592186534459} {:answer/id #uuid "b1db4db7-8a40-5e37-8cf9-10fa79be6e22" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,\\,y=-\\frac{8}{3}" :db/id #edb/ref 17592186534664} {:answer/id #uuid "cd385079-e588-5673-a07b-71dcd96eba0b" :answer/type {:db/ident :answer.type/math} :answer/value "x=3,\\,y=-4" :db/id #edb/ref 17592186534725} {:answer/id #uuid "d2977dc8-5522-59a8-9ba9-e7485deb3f09" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2,\\,y=6" :db/id #edb/ref 17592186534736}] :answer-field/correct {:db/id #edb/ref 17592186534725} :answer-field/id #uuid "f4d9a375-abbc-5813-a298-e638283c175f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534964}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98e817d9-610e-538f-a711-341d85a62ad2" :question/math-academy-id "q-216035" :question/problem "$$\n\\{\\begin{aligned}\\frac{1}{3}x+\\frac{3}{2}y=-5 \\\\ -2x-y=-2\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $6.$\n\n$$\n\\{\\begin{aligned}\\frac{1}{3}x+\\frac{3}{2}y=-5 & |\\,\\times 6 \\\\ -2x-y=-2\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2x+9y=-30 \\\\ -2x-y=-2\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $2x$ term in the first equation can cancel with the $-2x$ term in the second equation.\n\nAdding the two equations eliminates the $x$-variable, and allows us to solve for $y:$\n\n$$\n\\begin{array}{rl}\\cancel{2x}+9y & =-30 \\\\ -\\cancel{2x}-y & =-2 \\\\ \\hline 8y & =-32 \\\\ y & =-4\\end{array}\n$$\n\nFinally, we can substitute $y=-4$ into the equation $-2x-y=-2$ to solve for $x:$\n\n$$\n\\begin{aligned}-2x-y & =-2 \\\\ -2x-(-4) & =-2 \\\\ -2x+4 & =-2 \\\\ -2x & =-6 \\\\ x & =3\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=3$ and $y=-4.$"}]}
