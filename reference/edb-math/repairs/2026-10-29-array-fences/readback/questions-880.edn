#{[{:db/id #edb/ref 17592186554562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d948b64-117c-579e-b644-ff48d5689b18" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{7}=-\\frac{1}{2\\,187}" :db/id #edb/ref 17592186553899} {:answer/id #uuid "414e8dd7-f46d-5b69-b647-2ab2091b8a06" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{7}=\\frac{1}{2\\,187}" :db/id #edb/ref 17592186553987} {:answer/id #uuid "66e2c5cc-c66f-5b95-bdf4-64edd8104ed2" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{7}=-3" :db/id #edb/ref 17592186554073} {:answer/id #uuid "a4b8e80e-0266-5cc0-9779-10e7d69bf61b" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{7}=-\\frac{1}{3}" :db/id #edb/ref 17592186554231} {:answer/id #uuid "c88fe9b9-712f-5caa-8196-19c17631b170" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{7}=2\\,187" :db/id #edb/ref 17592186554311}] :answer-field/correct {:db/id #edb/ref 17592186553899} :answer-field/id #uuid "baf33f80-cdc5-56ca-aedb-5cb060109b06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554506}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3805f218-eb22-5e05-bae4-085089844c85" :question/math-academy-id "q-67512" :question/problem "Find the equation for the common ratio $r$ of the geometric sequence whose $4$th term is $27$ and whose $11$th term is $-\\frac{1}{81}.$" :question/worked-solution "The formula for the $n$th term of a geometric sequence is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}.\n$$\n\nApplying this formula with $n=11$ and $n=4,$ respectively, we have\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}{r}^{4-1}={a}_{1}{r}^{3}, \\\\ {a}_{11} & ={a}_{1}{r}^{11-1}={a}_{1}{r}^{10}.\\end{aligned}\n$$\n\nGiven that ${a}_{4}=27$ and ${a}_{11}=-\\frac{1}{81},$ we obtain the following system of equations:\n\n$$\n\\{\\begin{aligned}{a}_{1}{r}^{3}=27 \\\\ {a}_{1}{r}^{10}=-\\frac{1}{81}\\end{aligned}\n$$\n\nFinally, by dividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{{a}_{1}{r}^{10}}{{a}_{1}{r}^{3}} & =\\frac{\\left(-\\frac{1}{81}\\right)}{27} \\\\ \\frac{\\cancel{\\,{a}_{1}\\,}{r}^{10}}{\\cancel{\\,{a}_{1}\\,}{r}^{3}} & =\\frac{\\left(-\\frac{1}{81}\\right)}{27} \\\\ \\frac{{r}^{10}}{{r}^{3}} & =-\\frac{1}{2\\,187} \\\\ {r}^{7} & =-\\frac{1}{2\\,187}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0359c967-a736-556a-aa0f-b1dd2a3da13c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-2 & -8 & 5 \\\\ -4 & -6 & 3 \\\\ 1 & 0 & 4\\end{vmatrix}" :db/id #edb/ref 17592186553873} {:answer/id #uuid "0612e921-5057-58c7-8bb3-0c5741bb3803" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-2 & -8 & 8 \\\\ -4 & -6 & -1 \\\\ 1 & 0 & -7\\end{vmatrix}" :db/id #edb/ref 17592186553879} {:answer/id #uuid "11916100-9121-5d1e-a1ef-24a6f295f8fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}8 & -8 & 5 \\\\ -1 & -6 & 3 \\\\ -7 & 0 & 4\\end{vmatrix}" :db/id #edb/ref 17592186553905} {:answer/id #uuid "65de8e7a-c592-535e-8398-2751781df9fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-2 & 8 & 5 \\\\ -4 & -1 & 3 \\\\ 1 & -7 & 4\\end{vmatrix}" :db/id #edb/ref 17592186554069} {:answer/id #uuid "7c92dc9c-1ea6-5198-b638-55d04bb60a37" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-2 & -8 & 5 \\\\ -4 & -6 & 3 \\\\ 8 & -1 & -7\\end{vmatrix}" :db/id #edb/ref 17592186554119}] :answer-field/correct {:db/id #edb/ref 17592186553879} :answer-field/id #uuid "1dde4f08-b0b2-5881-b757-0ce139acae19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554444}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3cd38166-ab43-501c-8a09-bb660de655be" :question/math-academy-id "q-43120" :question/problem "Consider the system of equations \n\n$$\n\\{\\begin{aligned}-2x-8y+5z=8 \\\\ -4x-6y+3z=-1 \\\\ x-4z=-7.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}(-2)x+(-8)y+5z=8 \\\\ (-4)x+(-6)y+3z=-1 \\\\ 1x+0y+(-4)z=-7.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=\\begin{vmatrix}-2 & -8 & 5 \\\\ -4 & -6 & 3 \\\\ 1 & 0 & -4\\end{vmatrix}.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{z}=\\begin{vmatrix}-2 & -8 & 8 \\\\ -4 & -6 & -1 \\\\ 1 & 0 & -7\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131b8e36-82f8-5b9c-9ba5-e64dead4cde3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186553908} {:answer/id #uuid "2bec32dd-29a6-5607-920d-c35b9a232d65" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186553949} {:answer/id #uuid "7bf56a6c-9b35-56b5-83b1-eab01b39b95f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186554118} {:answer/id #uuid "c4ae4810-f1e6-544a-a09e-ed9a32b9bd9a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186554297} {:answer/id #uuid "d88503a5-902e-5a41-ab49-65ce7f2c3952" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186554342}] :answer-field/correct {:db/id #edb/ref 17592186553949} :answer-field/id #uuid "b8fd5cb6-f113-5503-be05-ca917de23415" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554505}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42ee0be6-4308-53bc-b367-0e542cac978e" :question/math-academy-id "q-43121" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\{\\begin{aligned}2x+3y+z=1 \\\\ 6x-2y-z=-14 \\\\ 3x+y-z=1\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $27,$ then $z=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\{\\begin{aligned}2x+3y+1z=1 \\\\ 6x+(-2)y+(-1)z=-14 \\\\ 3x+1y+(-1)z=1.\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=\\begin{vmatrix}2 & 3 & 1 \\\\ 6 & -2 & -1 \\\\ 3 & 1 & -1\\end{vmatrix}=27.\\end{aligned}\n$$\n\nNow, to find ${D}_{z}$, we replace the third column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=\\begin{vmatrix}2 & 3 & 1 \\\\ 6 & -2 & -14 \\\\ 3 & 1 & 1\\end{vmatrix} & =2\\cdot \\begin{vmatrix}-2 & -14 \\\\ 1 & 1\\end{vmatrix}-3\\cdot \\begin{vmatrix}6 & -14 \\\\ 3 & 1\\end{vmatrix}+1\\cdot \\begin{vmatrix}6 & -2 \\\\ 3 & 1\\end{vmatrix} \\\\  & =2(-2+14)-3(6+42)+(6+6) \\\\  & =24-144+12 \\\\  & =-108.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}z & =\\frac{{D}_{z}}{D}=\\frac{-108}{27}=-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34d52dde-78fc-56d2-a22f-16743942f394" :answer/type {:db/ident :answer.type/math} :answer/value "1[\\{0,5,10\\}\\in 7]" :db/id #edb/ref 17592186553963} {:answer/id #uuid "3e5a4ce9-38a3-50c2-ab37-2b31fa255565" :answer/type {:db/ident :answer.type/math} :answer/value "1[7=D]" :db/id #edb/ref 17592186553982} {:answer/id #uuid "3f98e784-15fe-5da6-bf43-5d7bde990e34" :answer/type {:db/ident :answer.type/math} :answer/value "1[D\\in \\{0,5,10\\}]" :db/id #edb/ref 17592186553984} {:answer/id #uuid "929abffe-450c-5006-a4e0-9188f9b6910d" :answer/type {:db/ident :answer.type/math} :answer/value "1[7\\in \\{0,5,10\\}]" :db/id #edb/ref 17592186554193} {:answer/id #uuid "caeec9e3-866d-5050-ab7c-4b6736d7497b" :answer/type {:db/ident :answer.type/math} :answer/value "1[7\\notin \\{0,5,10\\}]" :db/id #edb/ref 17592186554316}] :answer-field/correct {:db/id #edb/ref 17592186554193} :answer-field/id #uuid "cd8b1eb9-905f-5eaa-b94d-45d4a5b08f18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554515}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7ecead24-f472-509d-9b09-182eae6554e7" :question/math-academy-id "q-346663" :question/problem "Let $D=\\{0,5,10\\}.$ Which of the following is equivalent to ${1}_{D}(7)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{D}(x)$ of a set $D$ equals $1$ if $x\\in D$ and $0$ if $x\\notin D.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{D}(x)=1[x\\in D].\n$$\n\nTherefore, we have\n\n$$\n{1}_{D}(7)=1[7\\in D]=1[7\\in \\{0,5,10\\}].\n$$"}] [{:db/id #edb/ref 17592186554592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b477092-14a5-585d-a218-bfd1bf2d5620" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186553894} {:answer/id #uuid "381978cd-5ab7-51e7-b541-211370f63648" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186553969} {:answer/id #uuid "a549f739-e810-54df-a9ab-4502b087167f" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186554233} {:answer/id #uuid "f21927cf-9af8-5e15-9789-74ae85afddc3" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186554393} {:answer/id #uuid "fec613a5-e3db-55c6-8737-642a2ed8c695" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{3}" :db/id #edb/ref 17592186554424}] :answer-field/correct {:db/id #edb/ref 17592186553894} :answer-field/id #uuid "9df02a6a-4e09-5087-b781-68996219ec42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554493}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8259ae37-435b-52c3-a2f0-cf085e62a133" :question/math-academy-id "q-42682" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\{\\begin{aligned}kx+2y-4z=-4 \\\\ x-2y+5z=-6 \\\\ 10x+y+2z=8.\\end{aligned}\n$$\n\nGiven that  $x=-\\frac{20}{3}$ and that the determinant of the coefficient matrix is equal to $12-9k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=\\begin{vmatrix}k & 2 & -4 \\\\ 1 & -2 & 5 \\\\ 10 & 1 & 2\\end{vmatrix}=12-9k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=\\begin{vmatrix}-4 & 2 & -4 \\\\ -6 & -2 & 5 \\\\ 8 & 1 & 2\\end{vmatrix} & =(-4)\\cdot \\begin{vmatrix}-2 & 5 \\\\ 1 & 2\\end{vmatrix}-2\\cdot \\begin{vmatrix}-6 & 5 \\\\ 8 & 2\\end{vmatrix}+(-4)\\cdot \\begin{vmatrix}-6 & -2 \\\\ 8 & 1\\end{vmatrix} \\\\  & =-4(-4-5)-2(-12-40)-4(-6+16) \\\\  & =36+104-40 \\\\  & =100.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{100}{12-9k}.\n$$\n\nFrom the problem statement, we know that $x=-\\frac{20}{3}.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{100}{12-9k} & =-\\frac{20}{3} \\\\ 15 & =-12+9k \\\\ 9k & =27 \\\\ k & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02901c74-dd5e-55a8-a30e-d37d23988f6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & -8 & 2 \\\\ 0 & 6 & -7 \\\\ 1 & -5 & -10\\end{vmatrix}" :db/id #edb/ref 17592186553869} {:answer/id #uuid "22f9ed04-9d1d-5af3-b8ea-58280ed15c9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & 2 & 3 \\\\ 0 & -7 & -3 \\\\ 1 & -10 & 4\\end{vmatrix}" :db/id #edb/ref 17592186553930} {:answer/id #uuid "889308d6-5850-58f0-9c91-23f4fd38db14" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & 5 & 3 \\\\ -7 & 0 & -3 \\\\ -10 & 1 & 4\\end{vmatrix}" :db/id #edb/ref 17592186554154} {:answer/id #uuid "d73ce50d-5dd1-5828-9bcd-7fd2823a2ef5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & 0 & 3 \\\\ 2 & -7 & -10 \\\\ 1 & -3 & 4\\end{vmatrix}" :db/id #edb/ref 17592186554338} {:answer/id #uuid "f6e0ff00-c772-536b-a3bd-7591ea83a72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & -8 & 3 \\\\ 0 & 6 & -3 \\\\ 1 & -5 & 4\\end{vmatrix}" :db/id #edb/ref 17592186554404}] :answer-field/correct {:db/id #edb/ref 17592186553930} :answer-field/id #uuid "5a66b44b-6b9e-5088-92dd-3e1f0889e8b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554465}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8be0f924-0f3e-5631-9e67-77a4667752f3" :question/math-academy-id "q-43109" :question/problem "Consider the system of equations\n\n$$\n\\{\\begin{aligned}5x-8y+3z=2 \\\\ 6y-3z=-7 \\\\ x-5y+4z=-10.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=\\frac{{D}_{y}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{y}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}5x+(-8)y+3z=2 \\\\ 0x+6y+(-3)z=-7 \\\\ 1x+(-5)y+4z=-10.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=\\begin{vmatrix}5 & -8 & 3 \\\\ 0 & 6 & -3 \\\\ 1 & -5 & 4\\end{vmatrix}.\n$$\n\nNow, to construct ${D}_{y}$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y}=\\begin{vmatrix}5 & 2 & 3 \\\\ 0 & -7 & -3 \\\\ 1 & -10 & 4\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f06b55-7101-5453-94d2-1449f30ba91d" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{2}=\\frac{1}{49}" :db/id #edb/ref 17592186553884} {:answer/id #uuid "4384dfb2-d047-515d-a013-fca808c9af4f" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{2}=4" :db/id #edb/ref 17592186553993} {:answer/id #uuid "75296d26-4773-53b7-af61-4667830eee3d" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{3}=4" :db/id #edb/ref 17592186554106} {:answer/id #uuid "c313cfcb-f47c-5df3-a1fb-6a7052dd4a4d" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{2}=49" :db/id #edb/ref 17592186554293} {:answer/id #uuid "f76e274a-b078-575d-9e2e-8d6701796c5f" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{3}=49" :db/id #edb/ref 17592186554405}] :answer-field/correct {:db/id #edb/ref 17592186554293} :answer-field/id #uuid "01cea72a-2cdc-51be-a48d-be98f9d7fefe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554428}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8e2a0b2-6f85-51c0-a653-f0669492c9a0" :question/math-academy-id "q-67513" :question/problem "Find the equation for the common ratio $r$ of the geometric sequence whose $3$rd term is $4$ and whose $5$th term is $196.$" :question/worked-solution "The formula for the $n$th term of a geometric sequence is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}.\n$$\n\nApplying this formula with $n=5$ and $n=3,$ respectively, we have\n\n$$\n\\begin{aligned}{a}_{3} & ={a}_{1}{r}^{3-1}={a}_{1}{r}^{2}, \\\\ {a}_{5} & ={a}_{1}{r}^{5-1}={a}_{1}{r}^{4}.\\end{aligned}\n$$\n\nGiven that ${a}_{3}=4$ and ${a}_{5}=196,$ we obtain the following system of equations:\n\n$$\n\\{\\begin{aligned}{a}_{1}{r}^{2}=4 \\\\ {a}_{1}{r}^{4}=196\\end{aligned}\n$$\n\nFinally, by dividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{{a}_{1}{r}^{4}}{{a}_{1}{r}^{2}} & =\\frac{196}{4} \\\\ \\frac{\\cancel{\\,{a}_{1}\\,}{r}^{4}}{\\cancel{\\,{a}_{1}\\,}{r}^{2}} & =\\frac{196}{4} \\\\ \\frac{{r}^{4}}{{r}^{2}} & =49 \\\\ {r}^{2} & =49.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd697bf3-bab3-5be7-93b9-af592dc078ba" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186554352}] :answer-field/correct {:db/id #edb/ref 17592186554352} :answer-field/id #uuid "edb32b44-fa3a-53b5-9c67-b4cbe35e057e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186554530}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3d61585-203e-5ae2-ba7d-32b154b3cecc" :question/math-academy-id "q-347438" :question/problem "$$\n{x}_{1}=-6,\\,{x}_{2}=-1,\\,{x}_{3}=0,\\,{x}_{4}=4,\\,{x}_{5}=7\n$$\n\nGiven the values ${x}_{1},\\,{x}_{2},\\,{x}_{3},\\,{x}_{4},\\,{x}_{5}$ above, we have\n\n$$\n\\displaystyle {\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot (2{x}_{i})+1[{x}_{i}<0]\\cdot 1=\n$$ {{field-1}}." :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nThe expression $1[{x}_{i}\\ge 0]\\cdot (2{x}_{i})+1[{x}_{i}<0]\\cdot 1$ equals $2{x}_{i}$ when ${x}_{i}\\ge 0$ and equals $1$ when ${x}_{i}<0.$ Thus, the sum\n\n$$\n{\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot (2{x}_{i})+1[{x}_{i}<0]\\cdot 1\n$$\n\nadds $2{x}_{i}$ for nonnegative values and $1$ for negative values.\n\nWe evaluate the indicator function for each ${x}_{i}:$\n\n- $1[{x}_{1}\\ge 0]=1[-6\\ge 0]=0,$ $1[{x}_{1}<0]=1$\n\n- $1[{x}_{2}\\ge 0]=1[-1\\ge 0]=0,$ $1[{x}_{2}<0]=1$\n\n- $1[{x}_{3}\\ge 0]=1[0\\ge 0]=1,$ $1[{x}_{3}<0]=0$\n\n- $1[{x}_{4}\\ge 0]=1[4\\ge 0]=1,$ $1[{x}_{4}<0]=0$\n\n- $1[{x}_{5}\\ge 0]=1[7\\ge 0]=1,$ $1[{x}_{5}<0]=0$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot (2{x}_{i})+1[{x}_{i}<0]\\cdot 1 & =1+1+2\\cdot 0+2\\cdot 4+2\\cdot 7 \\\\  & =1+1+0+8+14 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a42e783-06ac-540f-a993-5fee32a5d1a7" :answer/type {:db/ident :answer.type/math} :answer/value "1[-1=C]" :db/id #edb/ref 17592186554115} {:answer/id #uuid "905baf65-bc02-52ab-a96c-06c275629272" :answer/type {:db/ident :answer.type/math} :answer/value "1[-1\\notin \\{-3,-1,1,3\\}]" :db/id #edb/ref 17592186554181} {:answer/id #uuid "c64a4829-6ad8-5110-9db6-5fd9a585d15a" :answer/type {:db/ident :answer.type/math} :answer/value "1[C\\in \\{-3,-1,1,3\\}]" :db/id #edb/ref 17592186554304} {:answer/id #uuid "c77659db-76b7-535a-9c58-254c1f6de06a" :answer/type {:db/ident :answer.type/math} :answer/value "1[-1\\in \\{-3,-1,1,3\\}]" :db/id #edb/ref 17592186554307} {:answer/id #uuid "d3d06cfb-9a89-5639-8808-7411f0dd598c" :answer/type {:db/ident :answer.type/math} :answer/value "1[\\{-3,-1,1,3\\}\\in -1]" :db/id #edb/ref 17592186554329}] :answer-field/correct {:db/id #edb/ref 17592186554307} :answer-field/id #uuid "8c55f3e7-608f-546e-9238-bec098222d4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8cf80bf-23f2-50e5-8be6-fd421cafc0d7" :question/math-academy-id "q-346662" :question/problem "Let $C=\\{-3,-1,1,3\\}.$ Which of the following is equivalent to ${1}_{C}(-1)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{C}(x)$ of a set $C$ equals $1$ if $x\\in C$ and $0$ if $x\\notin C.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{C}(x)=1[x\\in C].\n$$\n\nTherefore, we have\n\n$$\n{1}_{C}(-1)=1[-1\\in C]=1[-1\\in \\{-3,-1,1,3\\}].\n$$"}] [{:db/id #edb/ref 17592186554636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "156a71be-c9a4-5ae7-9a2c-02e2f98c3a59" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186553911}] :answer-field/correct {:db/id #edb/ref 17592186553911} :answer-field/id #uuid "034b7137-7dce-507f-82b0-3f725c6f8c4a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186554429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f030361e-8a29-5e63-bca8-4e28e1ba5da0" :question/math-academy-id "q-346677" :question/problem "$$\n{x}_{1}=9,\\,{x}_{2}=-8,\\,{x}_{3}=-1,\\,{x}_{4}=4,\\,{x}_{5}=2\n$$\n\nGiven the values ${x}_{1},\\,{x}_{2},\\,{x}_{3},\\,{x}_{4},\\,{x}_{5}$ above, we have\n\n$$\n\\displaystyle {\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i}=\n$$ {{field-1}}." :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nThe expression $1[{x}_{i}>0]\\cdot {x}_{i}$ equals ${x}_{i}$ when ${x}_{i}>0$ and equals $0$ otherwise. Thus, the sum \n\n$$\n{\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i}\n$$\n\nadds up only the positive values.\n\nWe evaluate the indicator function for each ${x}_{i}:$\n\n- $1[{x}_{1}>0]=1[9>0]=1$\n\n- $1[{x}_{2}>0]=1[-8>0]=0$\n\n- $1[{x}_{3}>0]=1[-1>0]=0$\n\n- $1[{x}_{4}>0]=1[4>0]=1$\n\n- $1[{x}_{5}>0]=1[2>0]=1$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i} & =1\\cdot 9+0\\cdot (-8)+0\\cdot (-1)+1\\cdot 4+1\\cdot 2 \\\\  & =9+0+0+4+2 \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280d8127-c31a-5e2e-b9dc-665b3585f060" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}{e}^{-9t}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}" :db/id #edb/ref 17592186555084} {:answer/id #uuid "44c32af4-4f13-53b5-8974-40ae755cae35" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}{e}^{9t}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}" :db/id #edb/ref 17592186555147} {:answer/id #uuid "48431481-3e8e-57a8-83d2-eb0cb39cf23b" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}-\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}" :db/id #edb/ref 17592186555154} {:answer/id #uuid "a2c5ce55-c333-5011-848b-c5650ca56801" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}" :db/id #edb/ref 17592186555391} {:answer/id #uuid "a3a1cb7e-8b62-5bfd-ab90-3eb838df358f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}{e}^{-9t}" :db/id #edb/ref 17592186555392}] :answer-field/correct {:db/id #edb/ref 17592186555391} :answer-field/id #uuid "8cd5bc44-1d8a-5b80-a78e-d0c95223991b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555710}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "021e3fe3-3d72-56fe-ac1a-be1f9dae2590" :question/math-academy-id "q-335026" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=9y(t) \\\\ {y}^{′}(t)=9x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: $$\n\\displaystyle {e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{bmatrix},\n$$ where $$\n\\displaystyle A=\\begin{bmatrix}0 & 9 \\\\ 9 & 0\\end{bmatrix}.\n$$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 9 \\\\ 9 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $$\n\\displaystyle x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.\n$$ So, the matrix of the system is $$\n\\displaystyle A=\\begin{bmatrix}0 & 9 \\\\ 9 & 0\\end{bmatrix}.\n$$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{bmatrix}.\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{bmatrix}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} \\\\  & ={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"}] [{:db/id #edb/ref 17592186555764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7cd4b8-d810-5af2-844a-029c0614f602" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{1-y/2}, & y\\ge 2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555029} {:answer/id #uuid "10021868-bebf-5d55-88d6-1666034c1a46" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{(1-y)/2}, & y\\ge 2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555031} {:answer/id #uuid "1ef13b49-b8a1-573d-960c-ebf7e8cd471e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{(1-y)/2}, & y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555056} {:answer/id #uuid "df0e68c0-8aa4-5c57-a44f-b03b70691336" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4{e}^{1-y/2}, & y\\ge 2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555543} {:answer/id #uuid "f4bcd3f9-a718-5576-984c-731f9180bd20" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y/2}, & y\\ge 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555605}] :answer-field/correct {:db/id #edb/ref 17592186555029} :answer-field/id #uuid "7ea4d1f3-3230-5c90-8f5f-f708753efce4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555700}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10780b62-18db-53fc-94bd-63d320bb4c73" :question/math-academy-id "q-143774" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}{e}^{1-x},\\, & x\\ge 1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=2X,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=2X.$ The transformation $u(x)=2x$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =2y \\\\ y & =2{u}^{-1}(y) \\\\ {u}^{-1}(y) & =\\frac{y}{2}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=\\frac{1}{2}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}\\left(\\frac{y}{2}\\right)\\cdot |\\frac{1}{2}| \\\\  & ={e}^{1-y/2}\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{2}{e}^{1-y/2}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $x\\ge 1,$ the bounds are $a=1$ and $b\\to \\infty ,$ we have\n\n$$\nu(1)=2,\\,\\lim_{x\\to \\infty }u(x)=\\infty .\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{1-y/2}, & y\\ge 2 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "368e39f4-7c89-5dbe-b59a-90b69ad68444" :answer/type {:db/ident :answer.type/math} :answer/value "2.45" :db/id #edb/ref 17592186555115} {:answer/id #uuid "50907c91-9bbc-55c1-8c7d-3ee9bdffecbd" :answer/type {:db/ident :answer.type/math} :answer/value "1.78" :db/id #edb/ref 17592186555179} {:answer/id #uuid "b1f51ad0-f017-5334-b1f9-111993585928" :answer/type {:db/ident :answer.type/math} :answer/value "3.12" :db/id #edb/ref 17592186555430} {:answer/id #uuid "d77c1d14-7d11-58f9-9465-73a0b8c60934" :answer/type {:db/ident :answer.type/math} :answer/value "2.09" :db/id #edb/ref 17592186555519} {:answer/id #uuid "fbfc573b-da4d-5a63-a17a-aad20992b7b3" :answer/type {:db/ident :answer.type/math} :answer/value "1.95" :db/id #edb/ref 17592186555626}] :answer-field/correct {:db/id #edb/ref 17592186555519} :answer-field/id #uuid "bb51de07-a3ab-5b3e-aa1b-ded6bbcf5569" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555731}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "15966dc5-b8d2-54f2-9092-584d157e0965" :question/math-academy-id "q-90603" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈3.314\\,81,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{9}, & 0<x<3, \\\\ \\frac{1}{9}(2x-5), & 3\\le x<5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{3}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot \\frac{1}{9}\\,\\text{d}x+{\\int }_{3}^{5}{x}^{2}\\cdot \\frac{1}{9}(2x-5)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{{x}^{2}}{9}\\,\\text{d}x+{\\int }_{3}^{5}\\frac{1}{9}(2{x}^{3}-5{x}^{2})\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{27}|}_{0}^{3}+{\\frac{1}{9}(\\frac{{x}^{4}}{2}-\\frac{5{x}^{3}}{3})|}_{3}^{5} \\\\  & ≈13.074\\,07\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈13.074\\,07-(3.314\\,81)^{2} \\\\  & ≈2.09\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186555774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c48896b-a018-521e-946b-fe65b686effd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ -5\\operatorname{sinh}⁡(5t)\\end{bmatrix}" :db/id #edb/ref 17592186555247} {:answer/id #uuid "7a745ab5-2e30-5358-a661-1005ce9fee4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t)\\end{bmatrix}" :db/id #edb/ref 17592186555285} {:answer/id #uuid "8e5a344b-c228-5070-a3de-d96f53cbd405" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ -2\\operatorname{sinh}⁡(5t)\\end{bmatrix}" :db/id #edb/ref 17592186555331} {:answer/id #uuid "cf972ef6-5de2-58b9-b5d8-6de313e595af" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{cosh}⁡(5t) \\\\ -2\\operatorname{sinh}⁡(5t)\\end{bmatrix}" :db/id #edb/ref 17592186555494} {:answer/id #uuid "da11d876-2fe9-5885-b371-78fffbd4906e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ 2\\operatorname{sinh}⁡(5t)\\end{bmatrix}" :db/id #edb/ref 17592186555528}] :answer-field/correct {:db/id #edb/ref 17592186555331} :answer-field/id #uuid "f9bfc61d-9208-5f2a-9171-0d8c90db3cd8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555756}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27a5f814-886e-5a61-acf9-facf209e99cf" :question/math-academy-id "q-335263" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=5y(t) \\\\ {y}^{′}(t)=5x(t),\\end{aligned}\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: $$\n\\displaystyle {e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{bmatrix},\n$$ where $$\n\\displaystyle A=\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}.\n$$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $$\n\\displaystyle x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.\n$$ So, the matrix of the system is $$\n\\displaystyle A=\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}.\n$$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{bmatrix}.\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ -2\\operatorname{sinh}⁡(5t)\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19341623-c069-57f0-918f-2be57be5a81e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2y, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555046} {:answer/id #uuid "3eb89bec-79dd-58af-8196-d3d356437ba3" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1-\\sqrt{y}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555135} {:answer/id #uuid "533a4289-18f4-5f2c-abf2-84425ff4dc32" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3\\sqrt{y}}{2}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555188} {:answer/id #uuid "c386f9b3-75b7-5c3c-8088-0bdc0612b3d3" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1-\\sqrt{y}}{\\sqrt{y}}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555473} {:answer/id #uuid "f11f15bf-525a-5a41-bdc7-38a742a7f4d9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555592}] :answer-field/correct {:db/id #edb/ref 17592186555473} :answer-field/id #uuid "81f86259-5958-5bf3-bfcc-15c37733af30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555704}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ba326fb-1af3-5ddd-8698-9863f73e0845" :question/math-academy-id "q-143895" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2-2x, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y={X}^{2},$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y={X}^{2}.$ The transformation $u(x)={x}^{2}$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & ={y}^{2} \\\\ y & =({u}^{-1}(y))^{2} \\\\ {u}^{-1}(y) & =\\sqrt{y}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=\\frac{1}{2\\sqrt{y}}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & =(2-2\\sqrt{y})\\cdot \\frac{1}{2\\sqrt{y}} \\\\  & =\\frac{1-\\sqrt{y}}{\\sqrt{y}}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<1,$ the bounds are $a=0$ and $b=1,$ we have\n\n$$\nu(0)=0,\\,u(1)=1.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1-\\sqrt{y}}{\\sqrt{y}}, & 0<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d8ed0ae-8c4c-5c40-b9fe-c94e4393c50b" :answer/type {:db/ident :answer.type/math} :answer/value "0.29" :db/id #edb/ref 17592186555209} {:answer/id #uuid "98cdc799-45df-57d7-9906-2ddedbe7c5bb" :answer/type {:db/ident :answer.type/math} :answer/value "1.56" :db/id #edb/ref 17592186555369} {:answer/id #uuid "d4ff1634-fce9-5b8f-a582-81c3cab8ed4d" :answer/type {:db/ident :answer.type/math} :answer/value "1.34" :db/id #edb/ref 17592186555504} {:answer/id #uuid "e04aa9a5-64b5-59f1-8dde-5ebe34bb8a3c" :answer/type {:db/ident :answer.type/math} :answer/value "0.98" :db/id #edb/ref 17592186555548} {:answer/id #uuid "f8ba96cd-c44c-5515-a683-4d13c806b5c8" :answer/type {:db/ident :answer.type/math} :answer/value "0.46" :db/id #edb/ref 17592186555616}] :answer-field/correct {:db/id #edb/ref 17592186555209} :answer-field/id #uuid "340fc414-84b2-5d60-ae70-bad6cd5d8dc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555664}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42fc75dd-9bd8-5bf5-a346-8dddd7ab3b06" :question/math-academy-id "q-90605" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈1.136\\,90,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}x, & 0\\le x<1, \\\\ \\frac{3{x}^{2}}{14}, & 1\\le x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot x\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot \\frac{3{x}^{2}}{14}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{3}\\,\\text{d}x+{\\int }_{1}^{2}\\frac{3{x}^{4}}{14}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{4}|}_{0}^{1}+{\\frac{3{x}^{5}}{70}|}_{1}^{2} \\\\  & =1.578\\,57\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈1.578\\,57-(1.136\\,90)^{2} \\\\  & ≈0.29\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186555799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "760d68c2-bf69-5092-a28f-9f206e7da7bb" :answer/type {:db/ident :answer.type/math} :answer/value "B(120,0.6)" :db/id #edb/ref 17592186555268} {:answer/id #uuid "7678dea6-b13b-5668-b51b-7fa42acc8ac1" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.4)" :db/id #edb/ref 17592186555270} {:answer/id #uuid "8a13d411-f193-59df-a60d-691d14b62d42" :answer/type {:db/ident :answer.type/math} :answer/value "B(200,0.6)" :db/id #edb/ref 17592186555324} {:answer/id #uuid "a7ac58e6-6890-59aa-86e5-021020ca205b" :answer/type {:db/ident :answer.type/math} :answer/value "B(200,0.4)" :db/id #edb/ref 17592186555402} {:answer/id #uuid "c1b1149b-27d1-5022-b30e-bdf734dc8801" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.6)" :db/id #edb/ref 17592186555468}] :answer-field/correct {:db/id #edb/ref 17592186555324} :answer-field/id #uuid "9c2d22b3-82ab-571f-9d82-01f972b998da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555720}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "490b7df2-1c00-5889-8265-81d6b29b18f3" :question/math-academy-id "q-146401" :question/problem "Suppose we have a random sample of size $n=200$ from a population where $60\\%$ of the population has a particular characteristic. Let the random variable ${X}_{i}$ be equal to\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nwhere $i=1,…,200.$ Find an approximate sampling distribution of the statistic $$\n\\displaystyle X={\\sum }_{i=1}^{200}{X}_{i}.\n$$\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ the random variables ${X}_{i}$ can be considered independent and identically distributed. Under this assumption, we have\n\n$$\n{X}_{i}∼\\text{Bernoulli}(p)\\,1\\le i\\le n\n$$\n\nwhere $p$ is the proportion of the population that has the characteristic.\n\nTherefore, the random variable $X,$ defined as \n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}\n$$\n\ncan be approximated as a binomial random variable $X≈B(n,p).$ \n\nIn our case, we're told that the population size is significantly larger than the sample size. Moreover, we have \n\n$$\np=60\\%=0.6,\\,n=200.\n$$\n\nTherefore,\n\n$$\nX≈B(200,0.6).\n$$"}] [{:db/id #edb/ref 17592186555800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172b375e-317c-5b1c-9b41-2c052f27e8cc" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{4y}, & \\frac{1}{2}\\le y\\le \\frac{e}{2} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555044} {:answer/id #uuid "4a8f09eb-0cd1-51e6-8310-03cf1c596658" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2y}, & \\frac{1}{2}\\le y\\le \\frac{e}{2} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555163} {:answer/id #uuid "5da7260c-a3fd-55ce-8eb2-dbff9b05485e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{y}, & 1\\le y\\le \\sqrt{e} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555210} {:answer/id #uuid "c4d09561-afb0-5c88-aa32-fb6a6e01b8da" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2y}, & 1\\le y\\le \\sqrt{e} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555476} {:answer/id #uuid "d70b1e5b-84cc-5206-9db3-4b373b7356ec" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{y}, & \\frac{1}{2}\\le y\\le \\frac{e}{2} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555514}] :answer-field/correct {:db/id #edb/ref 17592186555514} :answer-field/id #uuid "7865a740-1a99-5f05-a821-db2d459c2cba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555698}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4cdff0a1-3127-5db2-a31d-94794e2a46b7" :question/math-academy-id "q-143777" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{x}\\, & 1\\le x\\le e \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\frac{X}{2},$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=\\frac{X}{2}.$ The transformation $u(x)=\\frac{x}{2}$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =\\frac{y}{2} \\\\ y & =\\frac{{u}^{-1}(y)}{2} \\\\ {u}^{-1}(y) & =2y\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=2\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & =\\frac{1}{2y}\\cdot 2 \\\\  & =\\frac{1}{y}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<e,$ the bounds are $a=1$ and $b=e,$ we have\n\n$$\nu(1)=\\frac{1}{2},\\,u(e)=\\frac{e}{2}.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{y}, & \\frac{1}{2}\\le y\\le \\frac{e}{2} \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22684d1d-b0b3-54ef-b3ee-48b2d6c88f60" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.72)" :db/id #edb/ref 17592186555067} {:answer/id #uuid "9a32f7fa-6742-56e1-bf1a-cf1c58e74768" :answer/type {:db/ident :answer.type/math} :answer/value "B(80,0.72)" :db/id #edb/ref 17592186555373} {:answer/id #uuid "9e5f5792-ce54-5a1b-9b50-cfc7b9f8870e" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.28)" :db/id #edb/ref 17592186555382} {:answer/id #uuid "ac7ce6d1-961d-56fe-aded-0106ed9f05c3" :answer/type {:db/ident :answer.type/math} :answer/value "B(58,0.72)" :db/id #edb/ref 17592186555415} {:answer/id #uuid "d72a2b1b-9ea0-537e-a5f6-1f5385cf75a5" :answer/type {:db/ident :answer.type/math} :answer/value "B(80,0.28)" :db/id #edb/ref 17592186555517}] :answer-field/correct {:db/id #edb/ref 17592186555373} :answer-field/id #uuid "282e375f-1850-5399-9599-cb2c5ef898b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555658}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "59f1c663-db33-5cbd-a122-ef9383054d3e" :question/math-academy-id "q-146398" :question/problem "Suppose we have a random sample of size $n=80$ from a population where $72\\%$ of the population has a particular characteristic. Let the random variable ${X}_{i}$ be equal to\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nwhere $i=1,…,80.$ Find an approximate sampling distribution of the statistic $$\n\\displaystyle X={\\sum }_{i=1}^{80}{X}_{i}.\n$$\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ the random variables ${X}_{i}$ can be considered independent and identically distributed. Under this assumption, we have\n\n$$\n{X}_{i}∼\\text{Bernoulli}(p)\\,1\\le i\\le n\n$$\n\nwhere $p$ is the proportion of the population that has the characteristic.\n\nTherefore, the random variable $X,$ defined as \n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}\n$$\n\ncan be approximated as a binomial random variable $X≈B(n,p).$ \n\nIn our case, we're told that the population size is significantly larger than the sample size. Moreover, we have \n\n$$\np=72\\%=0.72,\\,n=80.\n$$\n\nTherefore,\n\n$$\nX≈B(80,0.72).\n$$"}] [{:db/id #edb/ref 17592186555816 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83866d01-d00c-5606-97fc-8034676dfc07" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555303} {:answer/id #uuid "af72d3b7-3cf4-586f-afbf-29d7d4a06a3f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555420} {:answer/id #uuid "bebaa45c-6d1d-5ae9-aa82-d69d094bf6a2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}-2y, & -1<y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555455} {:answer/id #uuid "e32bb70d-69d8-5b13-87d0-5ff4152c7216" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}-3{y}^{2}, & -1<y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555555} {:answer/id #uuid "fbaccb16-ff2d-5f45-9895-60c746ff8274" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}-4{y}^{3}, & -1<y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555624}] :answer-field/correct {:db/id #edb/ref 17592186555624} :answer-field/id #uuid "9aa1eb7e-f2a5-549e-b007-219daa3b78ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555717}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "674cd7aa-b875-5b4c-b5f8-f279a4fd931b" :question/math-academy-id "q-143892" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2x, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=-\\sqrt{X},$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=-\\sqrt{X}.$ The transformation $u(x)=-\\sqrt{x}$ is strictly monotonically *decreasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & =-\\sqrt{y} \\\\ y & =-\\sqrt{{u}^{-1}(y)} \\\\ {u}^{-1}(y) & ={y}^{2}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=2y\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & =2({y}^{2})\\cdot 2|y| \\\\  & =4{y}^{2}|y|.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<1,$ the bounds are $a=0$ and $b=1,$ we have\n\n$$\nu(0)=0,\\,u(1)=-1.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}-4{y}^{3}, & -1<y<0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86341e77-1f57-5302-bb6d-a2c8a5537faa" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186555310} {:answer/id #uuid "b2e23238-bfec-5704-ba16-5d10f1e57bb4" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186555432} {:answer/id #uuid "c10d3e1f-2274-5367-bc4b-0e95df0e5a77" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186555465} {:answer/id #uuid "e045873a-b588-5fec-8b66-2507fea13467" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186555547} {:answer/id #uuid "e7a4fd87-0d62-525b-8e48-73d80e64732e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186555569}] :answer-field/correct {:db/id #edb/ref 17592186555569} :answer-field/id #uuid "9474a4f7-d9d7-5966-bcd5-2d786ecd797e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555715}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7135217a-2b68-531f-be98-4ee4582b3546" :question/math-academy-id "q-36478" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of a vector space $V.$\n\nWhich of the following statements are true?\n\nI. $\\{{b}_{1},{b}_{2}+{b}_{3},{b}_{3}\\}$ is a basis of $V$\n\nII. $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{2}\\}$ is linearly independent\n\nIII. $\\{{b}_{1},{b}_{1}+{b}_{2}\\}$ is a basis of $V$" :question/worked-solution "Since $B$ is a basis, the following properties must hold:\n\n- $B$ is a maximally linearly independent set of vectors in $V,$ and\n\n- $B$ spans $V.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}({b}_{2}+{b}_{3})+{x}_{3}{b}_{3} & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+({x}_{2}+{x}_{3}){b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since $\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is linearly independent, gives\n\n$$\n\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{2}+{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nAlso, $\\{{b}_{1},{b}_{2}+{b}_{3},{b}_{3}\\}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of $\\{{b}_{1},{b}_{2}+{b}_{3},{b}_{3}\\}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}={x}_{1}{b}_{1}+{x}_{2}({b}_{2}+{b}_{3})+({x}_{3}-{x}_{2}){b}_{3}\n$$\n\n- Statement II is false. Since ${b}_{1}+{b}_{2}$ is a linear combination of ${b}_{1}$ and ${b}_{2}$, the given set is linearly dependent.\n\n- Statement III is false since the vector ${b}_{3}$ can't be written as a linear combination of $\\{{b}_{1},{b}_{1}+{b}_{2}\\}.$ But then\n\n$$\n\\begin{aligned}{b}_{3} & ={x}_{1}{b}_{1}+{x}_{2}({b}_{1}+{b}_{2}) \\\\  & =({x}_{1}+{x}_{2}){b}_{1}+{x}_{2}{b}_{2},\\end{aligned}\n$$\n\nwhich would mean that $B$ is linearly dependent. This would contradict the fact that $B$ is a basis.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186555827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cccba6b-f470-51dd-b23c-1c518f8d32fe" :answer/type {:db/ident :answer.type/image} :answer/value "images/49/498944b029b0a16a67dcd830a91bf6ea6480b3267a2a8f233d97fab2dd98d3a7.png" :db/id #edb/ref 17592186555021} {:answer/id #uuid "b07ed8b7-ba04-5275-a158-92c500ad6e37" :answer/type {:db/ident :answer.type/image} :answer/value "images/1a/1aefee3b012fc011ba7a643d92562724e520f78d06553d5ac82ec7226ccd0550.png" :db/id #edb/ref 17592186555424} {:answer/id #uuid "d89ee78f-3a41-5e1b-82db-a8654f6fdce9" :answer/type {:db/ident :answer.type/image} :answer/value "images/ce/cecf86b753685cbad211f1a85e0552ef504a7c1fc6cc35219d72a70e922643a7.png" :db/id #edb/ref 17592186555521} {:answer/id #uuid "dc16fd87-410b-57e5-8b5c-be56639e5ed1" :answer/type {:db/ident :answer.type/image} :answer/value "images/65/6527b4f7514f14211c796840c704df5544cabfa6099e69a3740e2e1941e126d2.png" :db/id #edb/ref 17592186555534} {:answer/id #uuid "e3d8f0c9-d1d6-5a68-ad42-ce31393b9535" :answer/type {:db/ident :answer.type/image} :answer/value "images/f8/f815f737ed2f98d9cc8d028545e77407cff0693c6212ffee58efeaff0bf658ff.png" :db/id #edb/ref 17592186555558}] :answer-field/correct {:db/id #edb/ref 17592186555534} :answer-field/id #uuid "3dd397f7-5ec0-560f-a03e-535e6aeb3530" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555670}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81bf18b7-eab3-5bbd-9ce6-359135969b2e" :question/math-academy-id "q-46785" :question/problem "Given that \n\n$$\nf(x)=\\{\\begin{aligned}1,\\, & x\\le 0 \\\\ -2,\\, & x\\text{ }>0,\\end{aligned}\n$$\n\nwhich of the following is the graph of $y=f(x)?$" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,0],$ we have $f(x)=1,$ so the graph is a horizontal line that ends at $(0,1),$ including this point.\n\n- On the interval $(0,\\infty )$, we have $f(x)=-2,$ so the graph is a horizontal line that begins at $(0,-2),$ excluding this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/65/6527b4f7514f14211c796840c704df5544cabfa6099e69a3740e2e1941e126d2.png)"}] [{:db/id #edb/ref 17592186555833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3437553e-7766-56dc-b3d3-e9e7c72cc279" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x\\le 1 \\\\ x,\\, & x>1\\end{aligned}" :db/id #edb/ref 17592186555110} {:answer/id #uuid "ae152954-f902-53bd-b2ef-b01345a0f0a1" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}2x,\\, & x\\le 4 \\\\ 1,\\, & x>4\\end{aligned}" :db/id #edb/ref 17592186555419} {:answer/id #uuid "e1927365-62c2-515d-9dbf-69034002b056" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}" :db/id #edb/ref 17592186555552} {:answer/id #uuid "e34b9c2d-6c57-55bf-8eed-c4819d40f872" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}x+1,\\, & x\\le 2 \\\\ 2,\\, & x>2\\end{aligned}" :db/id #edb/ref 17592186555556} {:answer/id #uuid "fbcec12c-1509-5612-8ee1-be7da7f92471" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x<4 \\\\ 1-x,\\, & x\\ge 4\\end{aligned}" :db/id #edb/ref 17592186555625}] :answer-field/correct {:db/id #edb/ref 17592186555552} :answer-field/id #uuid "e1f95f09-2832-5ce0-bed7-f205e739286f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555748}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fda4d22-b124-5945-a801-91535484189e" :question/math-academy-id "q-19294" :question/problem "![](images/8d/8d531960f0aa1444b614279f1ab82d8cc01904580e44be331f42d3d28266e1a9.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,4],$ we have a line with a slope of $1$ and $y$-intercept $0.$ So the graph is the line $y=x$ that ends at $(4,4),$ including this point.\n\n- On the interval $(4,\\infty ),$ we have a horizontal line that passes through the point $(4,2).$ So the graph is the line $y=2$ that starts at $(4,2),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1524fb62-acc2-536e-a99c-e6d653124ea2" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[X]=8,\\,\\text{Var}[X]=5.7" :db/id #edb/ref 17592186555041} {:answer/id #uuid "669f46f9-7fe9-57c8-b15c-822e2852fd28" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=5.7" :db/id #edb/ref 17592186555232} {:answer/id #uuid "6986251f-e45f-59ee-9667-7b37f30a8e1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=6.2" :db/id #edb/ref 17592186555240} {:answer/id #uuid "7f7af2aa-2e28-5c1f-abd9-a7f96818713e" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=5.0" :db/id #edb/ref 17592186555294} {:answer/id #uuid "a0857c8a-f9dd-50e3-a78d-bf44e5e33721" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[X]=8,\\,\\text{Var}[X]=5.0" :db/id #edb/ref 17592186555387}] :answer-field/correct {:db/id #edb/ref 17592186555232} :answer-field/id #uuid "620b9567-454a-5a74-9979-8ed7be2affd8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555686}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94f8387a-ce74-5bb3-92d4-c497c3ceea9c" :question/math-academy-id "q-146405" :question/problem "Suppose we have a random sample of size $n=120$ from a population where $5\\%$ of the population has a particular characteristic. Let the random variable ${X}_{i}$ be equal to\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nwhere $i=1,…,120.$ If the statistic $X$ is defined as\n\n$$\nX={\\sum }_{i=1}^{120}{X}_{i}\n$$\n\nfind approximate values of $\\text{E}[X]$ and $\\text{Var}[X].$\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ the random variables ${X}_{i}$ can be considered independent and identically distributed. Under this assumption, we have\n\n$$\n{X}_{i}∼\\text{Bernoulli}(p)\\,1\\le i\\le n\n$$\n\nwhere $p$ is the proportion of the population that has the characteristic.\n\nTherefore, the random variable $X,$ defined as \n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}\n$$\n\ncan be approximated as a binomial random variable $X≈B(n,p),$ where\n\n$$\n\\text{E}[X]=np,\\,\\text{Var}[X]=np(1-p).\n$$\n\nIn our case, we're told that the population size is significantly larger than the sample size. Moreover, we have \n\n$$\np=5\\%=0.05,\\,n=120.\n$$\n\nTherefore,\n\n$$\nX≈B(120,0.05)\n$$\n\nand we have the following results for the mean and variance:\n\n$$\n\\begin{aligned}\\text{E}[X] & =np \\\\  & =120\\cdot 0.05 \\\\  & =6 \\\\ \\text{Var}[X] & =np(1-p) \\\\  & =120\\cdot 0.05\\cdot (1-0.05) \\\\  & =5.7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164226e5-15d4-5658-89e3-bcd50cd4659c" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[\\widehat{\\,p}]=0.38,\\,\\text{Var}[\\widehat{\\,p}]=0.011" :db/id #edb/ref 17592186555043} {:answer/id #uuid "68be19d6-216b-577d-b2f8-7073e6ae0ba3" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[\\widehat{\\,p}]=0.38,\\,\\text{Var}[\\widehat{\\,p}]=0.006" :db/id #edb/ref 17592186555237} {:answer/id #uuid "7fa95346-6c40-5885-9b17-5047d823cbf8" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[\\widehat{\\,p}]=0.62,\\,\\text{Var}[\\widehat{\\,p}]=0.008" :db/id #edb/ref 17592186555295} {:answer/id #uuid "9b61f479-1547-598f-8162-e8595d51c610" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[\\widehat{\\,p}]=0.62,\\,\\text{Var}[\\widehat{\\,p}]=0.011" :db/id #edb/ref 17592186555375} {:answer/id #uuid "bfbebd0d-2330-54dc-9da4-4269e0fa7655" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{E}[\\widehat{\\,p}]=0.38,\\,\\text{Var}[\\widehat{\\,p}]=0.008" :db/id #edb/ref 17592186555460}] :answer-field/correct {:db/id #edb/ref 17592186555460} :answer-field/id #uuid "b9340764-7d20-536c-8af6-aa8f9dc6fc8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555730}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a90f2432-beab-5d93-b930-00f3398843bd" :question/math-academy-id "q-146445" :question/problem "Suppose that $38\\%$ of a city's adult population like romance movies. A random sample of $n=30$ adults is taken from the population and asked about their favorite movie genre.\n\nWhat is the mean and variance of $\\widehat{\\,p},$ the proportion of people in the sample who like romance movies? Round your answers to $3$ decimal places where appropriate.\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ we have that\n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}≈B(n,p)\n$$\n\nwhere $p$ is the proportion of the population that have the characteristic, and \n\n$$\n\\text{E}[X]=np,\\,\\text{Var}[X]=np(1-p).\n$$\n\nThe sample proportion $\\widehat{\\,p}$ is given by\n\n$$\n\\widehat{\\,p}=\\overset{―}{X}=\\frac{X}{n}.\n$$\n\nUsing the properties of expectation and variance, it is straightforward to show that\n\n$$\n\\text{E}[\\widehat{\\,p}]=p,\\,\\text{Var}[\\widehat{\\,p}]=\\frac{p(1-p)}{n}.\n$$\n\nIn our case, we have $p=38\\%=0.38,$ and $n=30.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[\\widehat{\\,p}] & =38\\%=0.38, \\\\ \\text{Var}[\\widehat{\\,p}] & =\\frac{0.38(1-0.38)}{30} \\\\  & ≈0.008\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186555851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5505216d-62d4-5def-93fc-88b1ec673ac2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}(2-y)^{3}, & 1<y<2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555191} {:answer/id #uuid "94632b8d-e646-5a1c-841b-4e1b8e19abb4" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4(1-y)^{3}, & 0<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555351} {:answer/id #uuid "aa9cd992-4d6d-5ca5-ae3d-ef1729cd1a3c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4(2-y)^{3}}{15}, & 1<y<2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555407} {:answer/id #uuid "d0da31ad-07c0-5d9c-9e30-027174062da2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4{y}^{3}, & 0<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555496} {:answer/id #uuid "d3decfd7-864b-5543-84c0-099e06bf2958" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4(2-y)^{3}, & 1<y<2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555502}] :answer-field/correct {:db/id #edb/ref 17592186555502} :answer-field/id #uuid "316bf6ab-3947-532a-8211-ad09e1e9e024" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555663}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ba6a48c1-7aec-5ddc-a819-dca70319c91f" :question/math-academy-id "q-143775" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}4{x}^{3},\\, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=2-X,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=2-X.$ The transformation $u(x)=2-x$ is strictly monotonically *decreasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =2-y \\\\ y & =2-{u}^{-1}(y) \\\\ {u}^{-1}(y) & =2-y\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=-1\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(2-y)\\cdot |-1| \\\\  & =4(2-y)^{3}\\cdot 1 \\\\  & =4(2-y)^{3}\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<1,$ the bounds are $a=0$ and $b=1,$ we have\n\n$$\nu(0)=2,\\,u(1)=1.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}4(2-y)^{3}, & 1<y<2 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a16446-72e7-5554-b9f3-37b2398be8d4" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2}\\operatorname{sin}⁡(y-3\\pi ), & 3\\pi <y<4\\pi  \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555150} {:answer/id #uuid "5a4b3c40-e6b8-525a-82c8-7ceba383c32e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}\\operatorname{sin}⁡(y-3\\pi ), & 3\\pi <y<4\\pi  \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555198} {:answer/id #uuid "ef12e410-2dd2-54b0-8f94-d0d3d23c11aa" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{y}{3}-\\pi ), & 3\\pi <y<6\\pi  \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555589} {:answer/id #uuid "f5eb8add-1881-5e5c-861b-7348e0c1f821" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{6}\\operatorname{sin}⁡(\\frac{y}{3}-\\pi ), & 3\\pi <y<6\\pi  \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555610} {:answer/id #uuid "fe44390e-3a59-58fc-9d2b-ca5ec6e5fa5b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{3}\\operatorname{sin}⁡(\\frac{y}{3}-\\pi ), & 3\\pi <y<6\\pi  \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555633}] :answer-field/correct {:db/id #edb/ref 17592186555610} :answer-field/id #uuid "b92ab0a5-3040-53cf-82b8-bf078d4d8e28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555729}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c6f869b2-aa11-5377-8e76-cb36213ba7a6" :question/math-academy-id "q-143773" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{\\operatorname{sin}⁡x}{2}\\, & 0<x<\\pi  \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=3X+3\\pi ,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=3X+3\\pi .$ The transformation $u(x)=3x+3\\pi $ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =3y+3\\pi  \\\\ y & =3{u}^{-1}(y)+3\\pi  \\\\ {u}^{-1}(y) & =\\frac{y}{3}-\\pi \\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=\\frac{1}{3}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(\\frac{y}{3}-\\pi )\\cdot |\\frac{1}{3}| \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{y}{3}-\\pi )\\cdot \\frac{1}{3} \\\\  & =\\frac{1}{6}\\operatorname{sin}⁡(\\frac{y}{3}-\\pi ).\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<\\pi ,$ the bounds are $a=0$ and $b=\\pi ,$ we have\n\n$$\nu(0)=3\\pi ,\\,u(\\pi )=6\\pi .\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{6}\\operatorname{sin}⁡(\\frac{y}{3}-\\pi ), & 3\\pi <y<6\\pi  \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fdd0c6-1d98-54af-82c9-a3de113fe661" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186555016} {:answer/id #uuid "0ee61fd2-c684-57e7-9ea4-f09a8e349764" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186555027} {:answer/id #uuid "9d9c7297-d71f-5a15-82a4-809b7fbacfeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186555379} {:answer/id #uuid "aa206b43-8b04-5867-a4d8-d7210015326b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186555406} {:answer/id #uuid "cb7d4718-a5a3-5cee-ad89-6d539fb4ecc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186555488}] :answer-field/correct {:db/id #edb/ref 17592186555488} :answer-field/id #uuid "45b92ccf-c96a-52fb-b618-ecc3a61419d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555673}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d36205bb-47f5-5c37-9085-d080474849b2" :question/math-academy-id "q-131169" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{30(x-1)}{{x}^{7}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{30(x-1)}{{x}^{7}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30x-30}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30}{{x}^{5}}-\\frac{30}{{x}^{6}}\\,\\text{d}x \\\\  & =-\\frac{30}{4{x}^{4}}+\\frac{30}{5{x}^{5}}{|}_{1}^{\\infty } \\\\  & =-\\frac{15}{2{x}^{4}}+\\frac{6}{{x}^{5}}{|}_{1}^{\\infty } \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{30(x-1)}{{x}^{7}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30x-30}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30}{{x}^{4}}-\\frac{30}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{30}{3{x}^{3}}+\\frac{30}{4{x}^{4}}{|}_{1}^{\\infty } \\\\  & =-\\frac{10}{{x}^{3}}+\\frac{15}{2{x}^{4}}{|}_{1}^{\\infty } \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{2}-{\\left(\\frac{3}{2}\\right)}^{2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4010751e-b00b-5952-82c6-80435f82ec17" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2(y+2)^{2}}, & -1<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555139} {:answer/id #uuid "936d9658-283d-560e-bc6d-ea190c5bec8c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{12}{(y+4)^{2}}, & -1<y<0 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555349} {:answer/id #uuid "ad9ede15-0d30-5234-a411-d8e0859ef10f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{4(y+2)^{2}}, & -1<y<0 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555418} {:answer/id #uuid "bad0b915-0433-5599-97e8-4708519f4503" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(y+4)^{2}}, & -1<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555444} {:answer/id #uuid "d6231f98-9851-5b39-adff-92d72af76228" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(y+2)^{2}}, & -1<y<0 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186555509}] :answer-field/correct {:db/id #edb/ref 17592186555509} :answer-field/id #uuid "0feccc34-587e-5131-85c6-09d92716448a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555647}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d414a04e-d0c3-5f7e-b95a-0d762c3601e3" :question/math-academy-id "q-143764" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{4}{{x}^{2}},\\, & 2<x<4 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\frac{1}{2}X-2,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=\\frac{1}{2}X-2.$ The transformation $u(x)=\\frac{1}{2}x-2$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =\\frac{1}{2}y-2 \\\\ y & =\\frac{1}{2}{u}^{-1}(y)-2 \\\\ {u}^{-1}(y) & =2y+4\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=2\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(2y+4)\\cdot |2| \\\\  & =\\frac{4}{(2y+4)^{2}}\\cdot 2 \\\\  & =\\frac{2}{(y+2)^{2}}\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $2<x<4,$ the bounds are $a=2$ and $b=4,$ we have\n\n$$\nu(2)=-1,\\,u(4)=0.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(y+2)^{2}}, & -1<y<0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d2dabb0-502b-562b-b584-741bd2219b36" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sin(3(t-2))" :db/id #edb/ref 17592186555287}] :answer-field/correct {:db/id #edb/ref 17592186555287} :answer-field/id #uuid "12370503-03e0-554e-be1b-d6e2ad47764c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186555648} {:answer-field/choices [{:answer/id #uuid "d71b20dd-cdf6-5315-9b31-8b02be6facce" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos(3(t-2))" :db/id #edb/ref 17592186555515}] :answer-field/correct {:db/id #edb/ref 17592186555515} :answer-field/id #uuid "645a6766-29a4-5adf-89b5-f8cdeb82aee5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186555689}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea042103-925d-51d6-8c12-93baa97ad8a2" :question/math-academy-id "q-335432" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-3y(t) \\\\ {y}^{′}(t)=3x(t),\\end{aligned}\\,\\begin{bmatrix}x(2) \\\\ y(2)\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: $$\n\\displaystyle {e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(3t) & -\\operatorname{sin}⁡(3t) \\\\ \\operatorname{sin}⁡(3t) & \\operatorname{cos}⁡(3t)\\end{bmatrix},\n$$ where $$\n\\displaystyle A=\\begin{bmatrix}0 & -3 \\\\ 3 & 0\\end{bmatrix}.\n$$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"130px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & -3 \\\\ 3 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $$\n\\displaystyle x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.\n$$ So, the matrix of the system is $$\n\\displaystyle A=\\begin{bmatrix}0 & -3 \\\\ 3 & 0\\end{bmatrix}.\n$$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-2)}\\,x(2) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(3(t-2)) & -\\operatorname{sin}⁡(3(t-2)) \\\\ \\operatorname{sin}⁡(3(t-2)) & \\operatorname{cos}⁡(3(t-2))\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\,2\\operatorname{cos}⁡(3(t-2))\\, \\\\ \\,2\\operatorname{sin}⁡(3(t-2))\\,\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "524ac2a6-5a9a-5148-8d1d-5ca5d309098c" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186555186} {:answer/id #uuid "5ceb10ac-2029-5299-9b2b-f37c6c0e52df" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186555208} {:answer/id #uuid "ef0366e0-ac17-5dc4-9ef7-d8e912021ed4" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186555588} {:answer/id #uuid "f2e1dee4-d755-5dce-9b9a-d2e2a492f1fe" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186555597} {:answer/id #uuid "f8f694a6-37e0-5cb0-ad91-f0bb2037328f" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186555617}] :answer-field/correct {:db/id #edb/ref 17592186555208} :answer-field/id #uuid "605de236-0714-5f9b-b01a-6122dd1e3831" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555684}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f4424f4e-4e2c-59a3-8d15-5c180b952f0f" :question/math-academy-id "q-107938" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of a vector space $V.$ \n\nWhich of the following statements are true?\n\nI. $\\{{b}_{2},{b}_{3}\\}$ is linearly independent\n\nII. $\\{{b}_{1},{b}_{2},{b}_{3},w\\}$ is a basis of $V$\n\nIII. $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{3}\\}$ is linearly independent" :question/worked-solution "Since $B$ is a basis, the following properties must hold:\n\n- $B$ is a maximally linearly independent set of vectors in $V,$ and\n\n- $B$ spans $V.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, if $\\{{b}_{2},{b}_{3}\\}$ is linearly dependent then there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{b}_{2}+{x}_{2}{b}_{3}=0,\n$$\n\nwhere at least one of $x$'s is not zero. But then \n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+0{b}_{3}=0,\n$$\n\nwhich would mean that $B$ is linearly dependent. This would contradict the fact that $B$ is a basis.\n\n- Statement II is false. Since $B$ is a basis of $V,$ it is a maximally linearly independent set of vectors. This means that if we add any new vector to the set, it becomes linearly dependent. Hence, the given set is not a basis for $V.$\n\n- Statement III is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}({b}_{1}+{b}_{3}) & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}({x}_{1}+{x}_{3}){b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since $\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is linearly independent, gives\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{3}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nAlso, $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{3}\\}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of $\\{{b}_{1},{b}_{2},{b}_{1}+{b}_{3}\\}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}=({x}_{1}-{x}_{3}){b}_{1}+{x}_{2}{b}_{2}+{x}_{3}({b}_{1}+{b}_{3})\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186555873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2de2ebeb-e356-5986-9a18-4bbd04698ed4" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3{y}^{11}}{4}, & 0<y<\\sqrt[3]{2} \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555103} {:answer/id #uuid "4410421e-5953-53d0-9979-891add3b5dce" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{5{y}^{9}}{512}, & 0<y<2 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555145} {:answer/id #uuid "4844bff0-8c04-50b9-8d99-cfda0d95e6de" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{2}, & 0<y<2 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555155} {:answer/id #uuid "c0334f0c-f3c9-5d23-a132-9151568d6904" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{\\sqrt[3]{2}}, & 0<y<\\sqrt[3]{2} \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555461} {:answer/id #uuid "d7241d2b-cc21-532e-9835-5918240ff0d6" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3{y}^{5}}{2}, & 0<y<\\sqrt[3]{2} \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186555516}] :answer-field/correct {:db/id #edb/ref 17592186555103} :answer-field/id #uuid "1cfdb681-1420-5e1f-89b1-59fd61ccc9df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555652}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff19e38b-ccbe-5836-a668-3a89307b9227" :question/math-academy-id "q-143894" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{{x}^{3}}{4}, & 0<x<2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\sqrt[3]{X},$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=\\sqrt[3]{X}.$ The transformation $u(x)=\\sqrt[3]{x}$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & =\\sqrt[3]{y} \\\\ y & =\\sqrt[3]{{u}^{-1}(y)} \\\\ {u}^{-1}(y) & ={y}^{3}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=3{y}^{2}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}({y}^{3})\\cdot |3{y}^{2}| \\\\  & =\\frac{{({y}^{3})}^{3}}{4}\\cdot 3{y}^{2} \\\\  & =\\frac{{y}^{9}}{4}\\cdot 3{y}^{2} \\\\  & =\\frac{3{y}^{11}}{4}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<2,$ the bounds are $a=0$ and $b=2,$ we have\n\n$$\nu(0)=0,\\,u(2)=\\sqrt[3]{2}.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3{y}^{11}}{4}, & 0<y<\\sqrt[3]{2} \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a0e737-5697-57a4-a73d-edbc478b30a3" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186556507} {:answer/id #uuid "45a303ab-287c-5d20-b61f-e565124eda57" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556583} {:answer/id #uuid "65c8beba-7f48-5893-abed-5629555ee374" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186556668} {:answer/id #uuid "ca91840c-4fe1-5797-837e-cf0d04ba1b59" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186556917} {:answer/id #uuid "e9b5e34c-4678-5dca-b523-4a58e93795c8" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186557007}] :answer-field/correct {:db/id #edb/ref 17592186556668} :answer-field/id #uuid "640612ec-cca7-54d8-80ce-3588c7e329a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557123}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "220c02c6-9021-54d4-b05d-5f454f3a5b70" :question/math-academy-id "q-95938" :question/problem "$$\n\\overbrace{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}^{R}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. You're given that the system of equations given below connects the columns of $Q$ and the columns of $A.$  \n\n$$\n\\{\\begin{aligned}{q}_{1}=\\frac{1}{4}{a}_{1} \\\\ {q}_{2}=\\frac{1}{6}{a}_{2}-3{q}_{1} \\\\ {q}_{3}=\\frac{1}{5}{a}_{3}-{q}_{1}-2{q}_{2}\\end{aligned}\n$$\n\nWhat is the value of ${r}_{11}+{r}_{13}+{r}_{33}?$" :question/worked-solution "Let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\{\\begin{aligned}{q}_{1}=\\frac{1}{4}{a}_{1} \\\\ {q}_{2}=\\frac{1}{6}{a}_{2}-3{q}_{1} \\\\ {q}_{3}=\\frac{1}{5}{a}_{3}-{q}_{1}-2{q}_{2}\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{a}_{1}=4{q}_{1} \\\\ {a}_{2}=18{q}_{1}+6{q}_{2} \\\\ {a}_{3}=5{q}_{1}+10{q}_{2}+5{q}_{3}.\\end{aligned}\n$$\n\nTherefore, this system can be written in matrix form as follows:\n\n$$\n\\overbrace{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}4 & 18 & 5 \\\\ 0 & 6 & 10 \\\\ 0 & 0 & 5\\end{bmatrix}}^{R}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{13}+{r}_{33}=4+5+5=14.\n$$"}] [{:db/id #edb/ref 17592186557220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7c23440-5c3b-5c48-baf9-2c8cb1453e1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186557044}] :answer-field/correct {:db/id #edb/ref 17592186557044} :answer-field/id #uuid "0efa0061-db88-505a-8abf-cea16f7858a3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557072} {:answer-field/choices [{:answer/id #uuid "ae33a651-5fef-5a40-83d2-8951babac325" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186556858}] :answer-field/correct {:db/id #edb/ref 17592186556858} :answer-field/id #uuid "7995027e-8581-593c-8043-53ee8d796378" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557136}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "257d204a-c14e-5aa5-8045-bec1e0148274" :question/math-academy-id "q-334995" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=-3x+5xy \\\\ {y}^{′}=5y-3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the predators and $y=y(t)$ represents the prey. Find the nonzero equilibrium of the model.\n\n$(${{field-1}}\n$,$\n{{field-2}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}-3x+5xy=0 \\\\ 5y-3xy=0\\end{aligned}\n$$\n\nSolving the first equation, we get\n\n$$\n\\begin{aligned}-3x+5xy & =0 \\\\ x(-3+5y) & =0.\\end{aligned}\n$$\n\nSo, $x=0$ or $y=\\frac{3}{5}.$ We consider both cases separately.\n\n- If $x=0,$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}5y-3(0)y=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThus, one equilibrium is $(0,0).$\n\n- If $y=\\frac{3}{5},$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}5y-3xy & =0 \\\\ y(5-3x) & =0 \\\\ \\frac{3}{5}(5-3x) & =0 \\\\ 5-3x & =0 \\\\ x & =\\frac{5}{3}.\\end{aligned}\n$$\n\nThus, another equilibrium is $(\\frac{5}{3},\\frac{3}{5}).$\n\nTherefore, the nonzero equilibrium of the model is\n$(\\frac{5}{3},\\frac{3}{5}).$"}] [{:db/id #edb/ref 17592186557222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50ba80ef-f04e-50df-b6d3-a54349425c28" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola with semiaxes $5$ and $4$" :db/id #edb/ref 17592186556614} {:answer/id #uuid "99191248-3fa5-597a-8b54-a603b1f3f7cd" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipse with semiaxes $\\frac{1}{5}$ and $\\frac{1}{\\sqrt{2}}$" :db/id #edb/ref 17592186556797} {:answer/id #uuid "a1e84b15-e7c8-5fd4-aa6e-1f803de91be4" :answer/type {:db/ident :answer.type/text} :answer/value "A single point" :db/id #edb/ref 17592186556826} {:answer/id #uuid "da3da08e-ab18-5b95-a7d3-b32ef06eaf72" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola" :db/id #edb/ref 17592186556972} {:answer/id #uuid "dc4ed344-c362-572c-a34e-eb57da043aa3" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola with semiaxes $2$ and $\\frac{1}{2}$" :db/id #edb/ref 17592186556977}] :answer-field/correct {:db/id #edb/ref 17592186556826} :answer-field/id #uuid "2872dfa0-d71b-51c3-93f9-e6e87fc08e6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557091}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "27762923-ddbc-55ca-b261-ca5c61feb064" :question/math-academy-id "q-95396" :question/problem "Consider the change of variables given by the matrix equation\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\nand the curve $C,$ defined as\n\n$$\nC:\\,24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}-\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2}=-\\frac{5}{16}.\n$$\n\n \n\nGiven that the change of variables above reduces $Q(x)=24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}$ to its canonical (diagonal) form $25{y}_{1}^{2}+20{y}_{2}^{2},$ what type of a quadratic curve is defined by $C?$" :question/worked-solution "First, we note the following:\n\n$$\nC:\\,\\underbrace{24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}}_{Q(x)}-\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2}=-\\frac{5}{16}\n$$\n\nLet's write the given change of variables explicitly:\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\{\\begin{aligned}{x}_{1}=\\frac{2}{\\sqrt{5}}{y}_{1}-\\frac{1}{\\sqrt{5}}{y}_{2} \\\\ {x}_{2}=\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2},\\end{aligned}\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}-\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2} & =-\\frac{5}{16} \\\\ 25{y}_{1}^{2}+20{y}_{2}^{2}-\\sqrt{5}(\\frac{2}{\\sqrt{5}}{y}_{1}-\\frac{1}{\\sqrt{5}}{y}_{2})+2\\sqrt{5}(\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2}) & =-\\frac{5}{16} \\\\ 25{y}_{1}^{2}+20{y}_{2}^{2}+5{y}_{2} & =-\\frac{5}{16} \\\\ 5{y}_{1}^{2}+4{y}_{2}^{2}+{y}_{2} & =-\\frac{1}{16}\\end{aligned}\n$$\n\nNow, we complete the square for the variable ${y}_{2}:$\n\n$$\n\\begin{aligned}5{y}_{1}^{2}+4{y}_{2}^{2}+{y}_{2} & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}^{2}+\\frac{1}{4}{y}_{2}) & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}^{2}+\\frac{1}{4}{y}_{2}+\\frac{1}{64}-\\frac{1}{64}) & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}^{2}+\\frac{1}{4}{y}_{2}+\\frac{1}{64})-\\frac{4}{64} & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}+\\frac{1}{8})^{2}-\\frac{1}{16} & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}+\\frac{1}{8})^{2} & =0\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\{\\begin{aligned}{z}_{1}={y}_{1}, \\\\ {z}_{2}={y}_{2}+\\frac{1}{8},\\end{aligned}\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}5{z}_{1}^{2}+4{z}_{2}^{2} & =0 \\\\ \\frac{{z}_{1}^{2}}{\\frac{1}{5}}+\\frac{{z}_{2}^{2}}{\\frac{1}{4}} & =0 \\\\ \\frac{{z}_{1}^{2}}{\\left(\\frac{1}{\\sqrt{5}}\\right)^{2}}+\\frac{{z}_{2}^{2}}{\\left(\\frac{1}{2}\\right)^{2}} & =0\\end{aligned}\n$$\n\n \n\nA sum of squares is equal to zero if and only if each summand is zero, so the given quadratic equation represents a single point."}] [{:db/id #edb/ref 17592186557240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "632b77ae-b3d3-5a97-a7ad-12a184e6637d" :answer/type {:db/ident :answer.type/math} :answer/value "1.232,\\,1.637,\\,2.284" :db/id #edb/ref 17592186556657} {:answer/id #uuid "9b3a9b79-41d8-5dd7-aa99-3bc9dc99d288" :answer/type {:db/ident :answer.type/math} :answer/value "1.398,\\,1.793,\\,1.942" :db/id #edb/ref 17592186556806} {:answer/id #uuid "ce6367be-6630-55f0-be18-4865fbd18d1d" :answer/type {:db/ident :answer.type/math} :answer/value "1.920,\\,2.136,\\,2.536" :db/id #edb/ref 17592186556925} {:answer/id #uuid "e0af9a98-12d1-5c58-8537-0b157b699025" :answer/type {:db/ident :answer.type/math} :answer/value "1.343,\\,1.983,\\,2.487" :db/id #edb/ref 17592186556984} {:answer/id #uuid "f7321105-ec7d-5b0e-b119-818ca4e002fa" :answer/type {:db/ident :answer.type/math} :answer/value "1.602,\\,1.834,\\,2.673" :db/id #edb/ref 17592186557042}] :answer-field/correct {:db/id #edb/ref 17592186556657} :answer-field/id #uuid "6506b03f-ca93-59cf-b94c-6064957efb49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557126}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3ef6d345-db21-5f3a-aad1-2b5e56cc5e56" :question/math-academy-id "q-147698" :question/problem "Suppose the following random sample was drawn from the uniform distribution $U[0,1].$ \n\n$$\n0.209,\\,0.493,\\,0.826\n$$\n\nUse these numbers to generate three random numbers that follow a probability distribution with the PDF $f(x),$ given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{x},\\, & 1\\le x\\le e, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nRound your answers to $3$ decimal places." :question/worked-solution "Let the random variable $Y∼U[0,1]$ be uniformly distributed. Suppose that the function $F(x)$ is a cumulative distribution function, where $F(a)=0,F(b)=1,$ and $F$ is strictly monotonic on $a<x<b.$ Then, the random variable $X,$ given by\n\n$$\nX={F}^{-1}(Y)\n$$\n\nis a continuous random variable with the cumulative distribution function $F(x).$\n\nFirst, we must find the cumulative distribution function $F(x)$ corresponding to our random variable. Since our PDF $f(x)$ is non-negative only for $1\\le x\\le e,$ we have\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<1, \\\\ {\\int }_{1}^{x}f(t)\\,\\text{d}t, & \\,1\\le x\\le e, \\\\ 1, & \\,x>e.\\end{aligned}\n$$\n\nEvaluating the integral, we obtain \n\n$$\n\\begin{aligned}{\\int }_{1}^{x}f(t)\\,\\text{d}t & ={\\int }_{1}^{x}\\frac{1}{t}\\,\\text{d}t \\\\  & =\\operatorname{ln}⁡t\\,{|}_{1}^{x} \\\\  & =\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<1, \\\\ \\operatorname{ln}⁡x, & \\,1\\le x\\le e, \\\\ 1, & \\,x>e.\\end{aligned}\n$$\n\nNext, we need to find the inverse of $y=F(x).$ So, we solve the following equation for $x,$ taking into account that $1\\le x\\le e$ and $0<y<1:$\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡x \\\\ x & ={e}^{y}\\end{aligned}\n$$\n\nNow, we substitute the numbers drawn from $U[0,1]$ into the above equation:\n\n- For $y=0.209,$ we get $x={e}^{0.209}≈1.232$\n\n- For $y=0.493,$ we get $x={e}^{0.493}≈1.637$\n\n- For $y=0.826,$ we get $x={e}^{0.826}≈2.284$"}] [{:db/id #edb/ref 17592186557243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41ea1ddd-0512-515d-9f5d-135412757c8a" :answer/type {:db/ident :answer.type/math} :answer/value "0.503,\\,0.725,\\,0.837" :db/id #edb/ref 17592186556574} {:answer/id #uuid "5ec97d5a-b5a2-539b-ab5d-c42e4fe5ae83" :answer/type {:db/ident :answer.type/math} :answer/value "0.831,\\,0.861,\\,0.916" :db/id #edb/ref 17592186556644} {:answer/id #uuid "84bf4099-962f-5056-8840-be25081e74c5" :answer/type {:db/ident :answer.type/math} :answer/value "0.035,\\,0.351,\\,0.540" :db/id #edb/ref 17592186556743} {:answer/id #uuid "8b3874bc-e662-56d9-b74c-96550f2ac2f1" :answer/type {:db/ident :answer.type/math} :answer/value "0.404,\\,0.646,\\,0.951" :db/id #edb/ref 17592186556763} {:answer/id #uuid "f6672f1f-cc34-5175-9f11-9cf409f90322" :answer/type {:db/ident :answer.type/math} :answer/value "0.353,\\,0.494,\\,0.631" :db/id #edb/ref 17592186557038}] :answer-field/correct {:db/id #edb/ref 17592186556644} :answer-field/id #uuid "f547b9f3-9164-5013-b7a0-bea7e78cacbf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557204}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "483ad5dd-d09b-5c15-bb9e-2524c193114e" :question/math-academy-id "q-147745" :question/problem "Suppose the following random sample was drawn from the uniform distribution $U[0,1].$ \n\n$$\n0.691,\\,0.741,\\,0.839\n$$\n\nUse these numbers to generate three random numbers that follow a probability distribution with the PDF $f(x),$ given by\n\n$$\nf(x)=\\{\\begin{aligned}2x,\\, & 0\\le x\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nRound your answers to $3$ decimal places." :question/worked-solution "Let the random variable $Y∼U[0,1]$ be uniformly distributed. Suppose that the function $F(x)$ is a cumulative distribution function, where $F(a)=0,F(b)=1,$ and $F$ is strictly monotonic on $a<x<b.$ Then, the random variable $X,$ given by\n\n$$\nX={F}^{-1}(Y)\n$$\n\nis a continuous random variable with the cumulative distribution function $F(x).$\n\nFirst, we must find the cumulative distribution function $F(x)$ corresponding to our random variable. Since our PDF $f(x)$ is non-negative only for $0\\le x\\le 1,$ we have\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<0, \\\\ {\\int }_{0}^{x}f(t)\\,\\text{d}t, & \\,0\\le x\\le 1, \\\\ 1, & \\,x>1.\\end{aligned}\n$$\n\nEvaluating the integral, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{x}f(t)\\,\\text{d}t & ={\\int }_{0}^{x}2t\\,\\text{d}t \\\\  & ={t}^{2}\\,{|}_{0}^{x} \\\\  & ={x}^{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<0, \\\\ {x}^{2}, & \\,0\\le x\\le 1, \\\\ 1, & \\,x>1.\\end{aligned}\n$$\n\nNext, we need to find the inverse of $y=F(x).$ So, we solve the following equation for $x,$ taking into account that $0\\le x\\le 1$ and $0<y<1:$\n\n$$\n\\begin{aligned}y & ={x}^{2} \\\\ x & =\\sqrt{y}\\end{aligned}\n$$\n\nNow, we substitute the numbers drawn from $U[0,1]$ into the above equation:\n\n- For $y=0.691,$ we get $x=\\sqrt{0.691}≈0.831$\n\n- For $y=0.741,$ we get $x=\\sqrt{0.741}≈0.861$\n\n- For $y=0.839,$ we get $x=\\sqrt{0.839}≈0.916$"}] [{:db/id #edb/ref 17592186557253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c543b2-c742-5216-a976-704265096bf3" :answer/type {:db/ident :answer.type/text} :answer/value "A pair of intersecting lines" :db/id #edb/ref 17592186556437} {:answer/id #uuid "4d58c25d-4003-58d6-ba24-34ce3e87a8a6" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola with semiaxes $2$ and $\\sqrt{3}$" :db/id #edb/ref 17592186556600} {:answer/id #uuid "e2716f9d-9b38-5af5-a1db-0a58828ce254" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola" :db/id #edb/ref 17592186556989} {:answer/id #uuid "f08c1f85-9679-5c12-98ff-95ec5e74f12d" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola with semiaxes $3$ and $\\sqrt{6}$" :db/id #edb/ref 17592186557023} {:answer/id #uuid "f4b9bfec-c82b-508d-8c85-f0390ed2dd71" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipse with semiaxes $9$ and $\\sqrt{6}$" :db/id #edb/ref 17592186557032}] :answer-field/correct {:db/id #edb/ref 17592186557023} :answer-field/id #uuid "c0e2b3fe-1fd8-5dda-acb7-cbb560deb0ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557174}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "584e6ba7-6a66-5994-b1b0-75bfa6a71313" :question/math-academy-id "q-95392" :question/problem "Consider the change of variables given by the matrix equation\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\nand the curve $C,$ defined as\n\n$$\nC:\\,{x}_{1}^{2}+4{x}_{1}{x}_{2}-2{x}_{2}^{2}+2\\sqrt{5}{x}_{1}+\\sqrt{5}{x}_{2}=\\frac{119}{8}.\n$$\n\nGiven that the change of variables above reduces $Q(x)={x}_{1}^{2}+4{x}_{1}{x}_{2}-2{x}_{2}^{2}$ to its canonical (diagonal) form $2{y}_{1}^{2}-3{y}_{2}^{2},$ what type of a quadratic curve is defined by $C?$" :question/worked-solution "First, we note the following:\n\n$$\nC:\\,\\underbrace{{x}_{1}^{2}+4{x}_{1}{x}_{2}-2{x}_{2}^{2}}_{Q(x)}+2\\sqrt{5}{x}_{1}+\\sqrt{5}{x}_{2}=\\frac{119}{8}\n$$\n\nLet's write the given change of variables explicitly: \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\{\\begin{aligned}{x}_{1}=\\frac{2}{\\sqrt{5}}{y}_{1}-\\frac{1}{\\sqrt{5}}{y}_{2} \\\\ {x}_{2}=\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2},\\end{aligned}\n$$\n\n \n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}{x}_{1}^{2}+4{x}_{1}{x}_{2}-2{x}_{2}^{2}+2\\sqrt{5}{x}_{1}+\\sqrt{5}{x}_{2} & =\\frac{119}{8} \\\\ 2{y}_{1}^{2}-3{y}_{2}^{2}+2\\sqrt{5}(\\frac{2}{\\sqrt{5}}{y}_{1}-\\frac{1}{\\sqrt{5}}{y}_{2})+\\sqrt{5}(\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2}) & =\\frac{119}{8} \\\\ 2{y}_{1}^{2}-3{y}_{2}^{2}+5{y}_{1} & =\\frac{119}{8}\\end{aligned}\n$$\n\nNow, we complete the square for the variable ${y}_{1}:$\n\n$$\n\\begin{aligned}2{y}_{1}^{2}-3{y}_{2}^{2}+5{y}_{1} & =\\frac{119}{8} \\\\ 2({y}_{1}^{2}+\\frac{5}{2}{y}_{1})-3{y}_{2}^{2} & =\\frac{119}{8} \\\\ 2({y}_{1}^{2}+\\frac{5}{2}{y}_{1}+\\frac{25}{16}-\\frac{25}{16})-3{y}_{2}^{2} & =\\frac{119}{8} \\\\ 2{({y}_{1}+\\frac{5}{4})}^{2}-\\frac{25}{8}-3{y}_{2}^{2} & =\\frac{119}{8} \\\\ 2{({y}_{1}+\\frac{5}{4})}^{2}-3{y}_{2}^{2} & =18\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\{\\begin{aligned}{z}_{1}={y}_{1}+\\frac{5}{4}, \\\\ {z}_{2}={y}_{2},\\end{aligned}\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}2{z}_{1}^{2}-3{z}_{2}^{2} & =18 \\\\ \\frac{{z}_{1}^{2}}{9}-\\frac{{z}_{2}^{2}}{6} & =1 \\\\ \\frac{{z}_{1}^{2}}{{3}^{2}}-\\frac{{z}_{2}^{2}}{(\\sqrt{6})^{2}} & =1\\end{aligned}\n$$\n\nThis represents a hyperbola with semiaxes $3$ and $\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186557254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "653df948-6dc8-5e58-977c-49f0d870e61c" :answer/type {:db/ident :answer.type/math} :answer/value "2.053,\\,2.894,\\,2.931" :db/id #edb/ref 17592186556665} {:answer/id #uuid "6567f6f8-c441-5894-846d-a5e89207da3b" :answer/type {:db/ident :answer.type/math} :answer/value "1.034,\\,1.736,\\,1.954" :db/id #edb/ref 17592186556666} {:answer/id #uuid "d69c6365-efc5-554a-ac72-1c07eeb313fe" :answer/type {:db/ident :answer.type/math} :answer/value "2.546,\\,3.631,\\,3.778" :db/id #edb/ref 17592186556954} {:answer/id #uuid "e13b7ccf-e151-5505-959f-cc939906e693" :answer/type {:db/ident :answer.type/math} :answer/value "1.478,\\,2.253,\\,2.564" :db/id #edb/ref 17592186556986} {:answer/id #uuid "f41ac435-1c3a-57c0-b25f-beb895ca90b7" :answer/type {:db/ident :answer.type/math} :answer/value "0.902,\\,1.463,\\,1.683" :db/id #edb/ref 17592186557030}] :answer-field/correct {:db/id #edb/ref 17592186556954} :answer-field/id #uuid "1ee473ff-8143-5b43-81e9-6dad15e3972f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557085}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "58d37898-ce2e-573d-a33c-7ebee5e8073b" :question/math-academy-id "q-147752" :question/problem "Suppose the following random sample was drawn from the uniform distribution $U[0,1].$ \n\n$$\n0.405,\\,0.824,\\,0.892\n$$\n\nUse these numbers to generate three random numbers that follow a probability distribution with the PDF $f(x),$ given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{8}x,\\, & 0\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nRound your answers to $3$ decimal places." :question/worked-solution "Let the random variable $Y∼U[0,1]$ be uniformly distributed. Suppose that the function $F(x)$ is a cumulative distribution function, where $F(a)=0,F(b)=1,$ and $F$ is strictly monotonic on $a<x<b.$ Then, the random variable $X,$ given by\n\n$$\nX={F}^{-1}(Y)\n$$\n\nis a continuous random variable with the cumulative distribution function $F(x).$\n\nFirst, we must find the cumulative distribution function $F(x)$ corresponding to our random variable. Since our PDF $f(x)$ is non-negative only for $0\\le x\\le 4,$ we have\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<0, \\\\ {\\int }_{0}^{x}f(t)\\,\\text{d}t, & \\,0\\le x\\le 4, \\\\ 1, & \\,x>4.\\end{aligned}\n$$\n\nEvaluating the integral, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{x}f(t)\\,\\text{d}t & ={\\int }_{0}^{x}\\frac{1}{8}t\\,\\text{d}t \\\\  & =\\frac{1}{16}{t}^{2}\\,{|}_{0}^{x} \\\\  & =\\frac{1}{16}{x}^{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<0, \\\\ \\frac{1}{16}{x}^{2}, & \\,0\\le x\\le 4, \\\\ 1, & \\,x>4.\\end{aligned}\n$$\n\nNext, we need to find the inverse of $y=F(x).$ So, we solve the following equation for $x,$ taking into account that $0\\le x\\le 4$ and $0<y<1:$\n\n$$\n\\begin{aligned}y & =\\frac{1}{16}{x}^{2} \\\\ 16y & ={x}^{2} \\\\ x & =4\\sqrt{y}\\end{aligned}\n$$\n\nNow, we substitute the numbers drawn from $U[0,1]$ into the above equation:\n\n- For $y=0.405,$ we get $x=4\\sqrt{0.405}≈2.546$\n\n- For $y=0.824,$ we get $x=4\\sqrt{0.824}≈3.631$\n\n- For $y=0.892,$ we get $x=4\\sqrt{0.892}≈3.778$"}] [{:db/id #edb/ref 17592186557258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed81a42-4f5b-592d-9877-e155aa0820d4" :answer/type {:db/ident :answer.type/math} :answer/value "1.791,\\,1.831,\\,1.983" :db/id #edb/ref 17592186556501} {:answer/id #uuid "ad6dcec7-cb37-5574-bdae-e38c0d88cc3e" :answer/type {:db/ident :answer.type/math} :answer/value "1.745,\\,2.323,\\,2.987" :db/id #edb/ref 17592186556856} {:answer/id #uuid "d695e024-941b-5f2c-8ffd-481b7c531017" :answer/type {:db/ident :answer.type/math} :answer/value "2.029,\\,2.322,\\,2.799" :db/id #edb/ref 17592186556953} {:answer/id #uuid "d78d7fa8-dcf4-5bb1-99c1-d0866aa1f60a" :answer/type {:db/ident :answer.type/math} :answer/value "1.232,\\,1.330,\\,1.421" :db/id #edb/ref 17592186556962} {:answer/id #uuid "eb00bf92-1637-5fdb-aea4-e09fbcb06285" :answer/type {:db/ident :answer.type/math} :answer/value "2.543,\\,2.806,\\,3.281" :db/id #edb/ref 17592186557009}] :answer-field/correct {:db/id #edb/ref 17592186556962} :answer-field/id #uuid "4ec6b574-4380-5af5-a64d-c3a6fdb29ec7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557109}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "67a7dadb-337f-50e0-a564-1d8c6c18e0d9" :question/math-academy-id "q-147778" :question/problem "Suppose the following random sample was drawn from the uniform distribution $U[0,1].$ \n\n$$\n0.198,\\,0.266,\\,0.322\n$$\n\nUse these numbers to generate three random numbers that follow a probability distribution with the PDF $f(x),$ given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{\\sqrt{{x}^{3}}},\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nRound your answers to $3$ decimal places." :question/worked-solution "Let the random variable $Y∼U[0,1]$ be uniformly distributed. Suppose that the function $F(x)$ is a cumulative distribution function, where $F(a)=0,F(b)=1,$ and $F$ is strictly monotonic on $a<x<b.$ Then, the random variable $X,$ given by\n\n$$\nX={F}^{-1}(Y)\n$$\n\nis a continuous random variable with the cumulative distribution function $F(x).$\n\nFirst, we must find the cumulative distribution function $F(x)$ corresponding to our random variable. Since our PDF $f(x)$ is non-negative only for $1\\le x\\le 4,$ we have\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<1, \\\\ {\\int }_{1}^{x}f(t)\\,\\text{d}t, & \\,1\\le x\\le 4, \\\\ 1, & \\,x>4.\\end{aligned}\n$$\n\nEvaluating the integral, we obtain \n\n$$\n\\begin{aligned}{\\int }_{1}^{x}f(t)\\,\\text{d}t & ={\\int }_{1}^{x}\\frac{1}{\\sqrt{{t}^{3}}}\\,\\text{d}t \\\\  & =-\\frac{2}{\\sqrt{t}}\\,{|}_{1}^{x} \\\\  & =2(1-\\frac{1}{\\sqrt{x}}).\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & \\,x<1, \\\\ 2(1-\\frac{1}{\\sqrt{x}}), & \\,1\\le x\\le 4, \\\\ 1, & \\,x>4.\\end{aligned}\n$$\n\nNext, we need to find the inverse of $y=F(x).$ So, we solve the following equation for $x,$ taking into account that $1\\le x\\le 4$ and $0<y<1:$\n\n$$\n\\begin{aligned}y & =2(1-\\frac{1}{\\sqrt{x}}) \\\\ \\frac{y}{2} & =1-\\frac{1}{\\sqrt{x}} \\\\ \\frac{1}{\\sqrt{x}} & =1-\\frac{y}{2} \\\\ \\frac{1}{\\sqrt{x}} & =\\frac{2-y}{2} \\\\ \\sqrt{x} & =\\frac{2}{2-y} \\\\ x & =\\frac{4}{(2-y)^{2}}\\end{aligned}\n$$\n\nNow, we substitute the numbers drawn from $U[0,1]$ into the above equation:\n\n- For $y=0.198,$ we get $x=\\frac{4}{(2-0.198)^{2}}≈1.232$\n\n- For $y=0.266,$ we get $x=\\frac{4}{(2-0.266)^{2}}≈1.330$\n\n- For $y=0.322,$ we get $x=\\frac{4}{(2-0.322)^{2}}≈1.421$"}] [{:db/id #edb/ref 17592186557273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097afa2f-b763-522d-8032-55d688c0a48e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186556451} {:answer/id #uuid "41edcfd1-d5be-5af9-9124-6e8bc1342df8" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186556575} {:answer/id #uuid "a183426e-8a50-5897-ac5d-048e3653057c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186556825} {:answer/id #uuid "c0ed8d32-d145-5e0c-aae9-cf1b8fc058cb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556893} {:answer/id #uuid "e9928077-44bc-5ecc-819b-2944f2d4cb5a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186557006}] :answer-field/correct {:db/id #edb/ref 17592186557006} :answer-field/id #uuid "18af244f-5b99-5c52-b321-7c2760b8516a" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186557080} {:answer-field/choices [{:answer/id #uuid "05374a86-e6cd-507f-a0b1-5c00e099616f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556438} {:answer/id #uuid "9c65a080-7fa5-5c62-b0c2-2496ec2251aa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556811} {:answer/id #uuid "9f67151e-0582-5405-9bc2-7f4abe819c39" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186556818} {:answer/id #uuid "a7745325-afa5-500b-9d87-197710b467a3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186556843} {:answer/id #uuid "f8a21cb3-acd8-557e-87c5-c6a2761a6696" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186557046}] :answer-field/correct {:db/id #edb/r