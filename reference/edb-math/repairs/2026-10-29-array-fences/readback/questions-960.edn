#{[{:db/id #edb/ref 17592186580320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e68475-9a29-5548-b204-ebe0398ccbb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186579681} {:answer/id #uuid "175b4ed2-c056-5608-a697-68ed2a005496" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186579719} {:answer/id #uuid "bfafb65d-b72c-5fd1-a691-bf2e8504d2d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186579996} {:answer/id #uuid "e539e188-f9bb-5a06-8da8-100771cf0ee9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186580064} {:answer/id #uuid "e608e405-956c-58bf-b7aa-5a6a9f235dfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186580067}] :answer-field/correct {:db/id #edb/ref 17592186579681} :answer-field/id #uuid "9a30346f-d508-5d25-9109-bb88aaebdefe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f7d5abe7-fa39-5089-9721-1b70b1a86d4d" :question/math-academy-id "q-126172" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{x}{2}, & 0\\le x<2 \\\\ 1, & x\\ge 2,\\end{aligned}\n$$\n\nfind $P(1\\le X\\le 3).$" :question/worked-solution "Remember that for continuous random variables, it doesn't matter whether or not we include the endpoints of the interval. So we can perform the computation as follows:\n\n$$\n\\begin{aligned}P(1\\le X\\le 3) & =P(1<X\\le 3) \\\\  & =P(X\\le 3)-P(X\\le 1) \\\\  & =F(3)-F(1) \\\\  & =1-\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186580322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b2d4dc-a566-5d1c-95f6-d74f6074f75d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{8}" :db/id #edb/ref 17592186579709} {:answer/id #uuid "9eaba4d3-8644-5755-b8bc-9d9fc20360c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186579945} {:answer/id #uuid "be2b5308-21b4-5190-9907-08e68d362c57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{8}" :db/id #edb/ref 17592186579994} {:answer/id #uuid "e73f1758-773b-5a29-870e-c53c21c68385" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186580071} {:answer/id #uuid "ff93a56c-4c48-5001-b83d-61ce30518a58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186580122}] :answer-field/correct {:db/id #edb/ref 17592186579709} :answer-field/id #uuid "a21ba782-afe1-5dd2-be47-4f2fdebb7a04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580184}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f9eb15f5-e2de-5a79-a97c-d1ff32d29564" :question/math-academy-id "q-152924" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}{x}^{3}, & 0\\le x<1 \\\\ \\frac{1}{2}\\,x, & 1\\le x\\le 2.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{4}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fourth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{4}] & ={\\int }_{0}^{2}{x}^{4}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{4}\\cdot {x}^{3}\\,\\text{d}x+{\\int }_{1}^{2}{x}^{4}\\cdot \\frac{1}{2}\\,x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{7}\\,\\text{d}x+\\frac{1}{2}{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\,{x}^{8}\\,{|}_{0}^{1}+\\frac{1}{12}\\,{x}^{6}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{8}(1-0)+\\frac{1}{12}(64-1) \\\\  & =\\frac{1}{8}+\\frac{21}{4} \\\\  & =\\frac{43}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186580880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25fb603f-99e1-55bc-9588-77e136b79039" :answer/type {:db/ident :answer.type/math} :answer/value "1.6056" :db/id #edb/ref 17592186580450} {:answer/id #uuid "492a6a5d-3a6f-5f71-b86d-8254bca584d1" :answer/type {:db/ident :answer.type/math} :answer/value "1.5566" :db/id #edb/ref 17592186580510} {:answer/id #uuid "5403b4f9-e3bd-50a9-94a2-ee5fe8970f03" :answer/type {:db/ident :answer.type/math} :answer/value "0.0906" :db/id #edb/ref 17592186580527} {:answer/id #uuid "6b537724-55d3-50f0-841c-0c2a4b421cb7" :answer/type {:db/ident :answer.type/math} :answer/value "0.6650" :db/id #edb/ref 17592186580568} {:answer/id #uuid "9661636a-57b9-51c0-bed2-cb7d7f17f0d6" :answer/type {:db/ident :answer.type/math} :answer/value "0.0656" :db/id #edb/ref 17592186580640}] :answer-field/correct {:db/id #edb/ref 17592186580640} :answer-field/id #uuid "4029d8d3-196b-5f66-b128-4c9c3eb421c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580815}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "052845df-31c1-5ac6-8fdb-db6eae2b480b" :question/math-academy-id "q-108283" :question/problem "Given that the random variable $X∼{χ}^{2}(8),$ calculate $P(X<3).$ Round your final answer to four decimal places.\n\n*Hint: You may wish to make use of the following result:*\n\n$$\n{\\int }_{0}^{3}{x}^{3}{e}^{-x/2}\\,\\text{d}x≈6.30168\n$$\n\n*The probability density function ${χ}^{2}(k)$ is given by*\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{k/2}Γ\\left(\\frac{k}{2}\\right)}{x}^{k/2-1}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "A chi-square random variable $X∼{χ}^{2}(k)$ with $k$ degrees of freedom has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{k/2}Γ\\left(\\frac{k}{2}\\right)}{x}^{k/2-1}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nWe're given that $X∼{χ}^{2}(8).$ So, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{16Γ(4)}{x}^{3}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nRecalling that $Γ(n)=(n-1)!$ for any natural number $n\\ge 1,$ we have\n\n$$\nΓ(4)=3!=6.\n$$\n\nSo, the probability distribution becomes\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{96}{x}^{3}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, we calculate $P(X<3)$ as follows:\n\n$$\n\\begin{aligned}P(X<3) & ={\\int }_{0}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{1}{96}{x}^{3}{e}^{-x/2}\\,\\text{d}x \\\\  & =\\frac{1}{96}{\\int }_{0}^{3}{x}^{3}{e}^{-x/2}\\,\\text{d}x \\\\  & ≈\\frac{1}{96}\\cdot 6.30168 \\\\  & ≈0.0656\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186580909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23bed5a7-946a-5761-b3c6-c169f961d99c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{\\int }_{0}^{3}{x}^{4}{e}^{-x/2}\\,\\text{d}x" :db/id #edb/ref 17592186580446} {:answer/id #uuid "2c3f4fae-e3f0-5ab1-aeab-69c1e6b34bbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{96}{\\int }_{0}^{3}x{e}^{-x/2}\\,\\text{d}x" :db/id #edb/ref 17592186580458} {:answer/id #uuid "4d845e5f-48d1-56a8-a9a9-92289951f110" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{96}{\\int }_{0}^{3}{x}^{3}{e}^{-x/2}\\,\\text{d}x" :db/id #edb/ref 17592186580518} {:answer/id #uuid "7895e320-c61b-57ba-84d3-b9a150bd1eea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}{\\int }_{0}^{3}{x}^{3}{e}^{-x/2}\\,\\text{d}x" :db/id #edb/ref 17592186580593} {:answer/id #uuid "ba7089bb-a038-5d2b-a34b-9bf3c599cdb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}{\\int }_{0}^{3}{x}^{3}{e}^{-x/2}\\,\\text{d}x" :db/id #edb/ref 17592186580686}] :answer-field/correct {:db/id #edb/ref 17592186580518} :answer-field/id #uuid "fd737fdb-a1db-508c-9c67-7a25aa8d3a5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580878}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "51526ec7-ea58-5f68-9175-85663bcbb887" :question/math-academy-id "q-108284" :question/problem "Given that $X∼{χ}^{2}(8),$ what is $P(X<3)$ expressed as an integral?\n\n*Hint: The probability density function ${χ}^{2}(k)$ is given by*\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{k/2}Γ\\left(\\frac{k}{2}\\right)}{x}^{k/2-1}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "A chi-square random variable $X∼{χ}^{2}(k)$ with $k$ degrees of freedom has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{k/2}Γ\\left(\\frac{k}{2}\\right)}{x}^{k/2-1}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nWe're given that $X∼{χ}^{2}(8).$ So, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{16Γ(4)}{x}^{3}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nRecalling that $Γ(n)=(n-1)!$ for any natural number $n\\ge 1,$ we have\n\n$$\nΓ(4)=3!=6.\n$$\n\nSo, the probability distribution becomes\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{96}{x}^{3}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, we calculate $P(X<3)$ as follows:\n\n$$\n\\begin{aligned}P(X<3) & ={\\int }_{0}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{1}{96}{x}^{3}{e}^{-x/2}\\,\\text{d}x \\\\  & =\\frac{1}{96}{\\int }_{0}^{3}{x}^{3}{e}^{-x/2}\\,\\text{d}x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186580958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54980c57-8d6e-54ce-afcf-f92faebaf38b" :answer/type {:db/ident :answer.type/math} :answer/value "0.0389" :db/id #edb/ref 17592186580528} {:answer/id #uuid "6a3743e5-6d0b-53aa-987b-d95480c8639f" :answer/type {:db/ident :answer.type/math} :answer/value "1.9393" :db/id #edb/ref 17592186580565} {:answer/id #uuid "af01cbd5-6518-5f2a-a3d6-f10e4118cdb7" :answer/type {:db/ident :answer.type/math} :answer/value "1.3689" :db/id #edb/ref 17592186580676} {:answer/id #uuid "bac8021b-3e1c-5ea3-bfa4-7891ea89dbc9" :answer/type {:db/ident :answer.type/math} :answer/value "0.0889" :db/id #edb/ref 17592186580687} {:answer/id #uuid "f35dde90-b67c-53f7-bf21-15cec35bcef0" :answer/type {:db/ident :answer.type/math} :answer/value "0.9389" :db/id #edb/ref 17592186580773}] :answer-field/correct {:db/id #edb/ref 17592186580773} :answer-field/id #uuid "46d3ab4e-f9cb-5529-ad5e-f05fc5c34187" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580817}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f47d7654-b908-545b-ade8-3e63f03d90b4" :question/math-academy-id "q-108278" :question/problem "Given that the random variable $X∼{χ}^{2}(4),$ calculate $P(X<9).$ Round your final answer to four decimal places.\n\n*Hint: You may wish to make use of the following result:*\n\n$$\n{\\int }_{0}^{9}x{e}^{-x/2}\\,\\text{d}x≈3.75560\n$$\n\n*The probability density function ${χ}^{2}(k)$ is given by*\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{k/2}Γ\\left(\\frac{k}{2}\\right)}{x}^{k/2-1}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "A chi-square random variable $X∼{χ}^{2}(k)$ with $k$ degrees of freedom has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{k/2}Γ\\left(\\frac{k}{2}\\right)}{x}^{k/2-1}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nWe're given that $X∼{χ}^{2}(4).$ So, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4Γ(2)}x{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nRecalling that $Γ(n)=(n-1)!$ for any natural number $n\\ge 1,$ we have\n\n$$\nΓ(2)=1!=1.\n$$\n\nSo, the probability distribution becomes\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}x{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, we calculate $P(X<9)$ as follows:\n\n$$\n\\begin{aligned}P(X<9) & ={\\int }_{0}^{9}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{9}\\frac{1}{4}x{e}^{-x/2}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{9}x{e}^{-x/2}\\,\\text{d}x \\\\  & ≈\\frac{1}{4}\\cdot 3.75560 \\\\  & =0.9389\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db68153-71e4-53f2-b5a4-e679e239b458" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{196}{9}" :db/id #edb/ref 17592186581063} {:answer/id #uuid "33ca4d42-f211-5f5a-a904-08fe1bb8b9ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186581109} {:answer/id #uuid "3a2398cc-13db-5b4d-aa48-fa2b5af29aba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186581128} {:answer/id #uuid "56663b96-4b26-5926-8e50-3dc0cefa35e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186581177} {:answer/id #uuid "90ddd770-dc0f-545f-b30c-4fd6c7938c40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{68}{3}" :db/id #edb/ref 17592186581280}] :answer-field/correct {:db/id #edb/ref 17592186581128} :answer-field/id #uuid "ea381cac-6ebc-5b25-9bac-19b3cbcfbdd2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581622}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "26ca37f6-adee-50b5-bfff-61ba9660bf70" :question/math-academy-id "q-90561" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{x}{8}-\\frac{1}{4},\\, & 2\\le x\\le 6, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{2}^{6}x\\cdot (\\frac{x}{8}-\\frac{1}{4})\\,\\text{d}x \\\\  & ={\\int }_{2}^{6}(\\frac{{x}^{2}}{8}-\\frac{x}{4})\\,\\text{d}x \\\\  & ={(\\frac{{x}^{3}}{24}-\\frac{{x}^{2}}{8})|}_{2}^{6} \\\\  & =\\frac{14}{3}\\end{aligned}\n$$\n\n \n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{2}^{6}{x}^{2}\\cdot (\\frac{x}{8}-\\frac{1}{4})\\,\\text{d}x \\\\  & ={\\int }_{2}^{6}(\\frac{{x}^{3}}{8}-\\frac{{x}^{2}}{4})\\,\\text{d}x \\\\  & ={(\\frac{{x}^{4}}{32}-\\frac{{x}^{3}}{12})|}_{2}^{6} \\\\  & =\\frac{68}{3}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{68}{3}-{\\left(\\frac{14}{3}\\right)}^{2} \\\\  & =\\frac{8}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1ba380-1ed1-5658-8eca-fb53e6edc0cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{48}" :db/id #edb/ref 17592186581065} {:answer/id #uuid "20b2425e-5cb3-539f-aa03-9fddcdb76854" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186581068} {:answer/id #uuid "57846172-7ccc-5606-a4eb-76a43bc93be2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{9}" :db/id #edb/ref 17592186581178} {:answer/id #uuid "888e4beb-b73b-5ef4-975d-d3d656fe01af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{9}" :db/id #edb/ref 17592186581263} {:answer/id #uuid "fc12ad82-9f91-56a5-88eb-baadc1786972" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{51}" :db/id #edb/ref 17592186581497}] :answer-field/correct {:db/id #edb/ref 17592186581065} :answer-field/id #uuid "792ef969-2718-5f5b-951d-bf43cbc24888" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581568}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5bf58e62-fb33-5cad-aca4-6dac3bc7e21a" :question/math-academy-id "q-90557" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{5}{4},$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{5}{{x}^{6}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{5}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{5}{{x}^{4}}\\,\\text{d}x \\\\  & ={-\\frac{5}{3{x}^{3}}|}_{1}^{\\infty } \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{3}-{\\left(\\frac{5}{4}\\right)}^{2} \\\\  & =\\frac{5}{48}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "217b031d-17e0-5178-927c-d2947c71f584" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186581069} {:answer/id #uuid "22e8cd9b-497e-52ee-a92e-45a048e71a9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186581074} {:answer/id #uuid "84b4db40-7fd4-5295-8d44-f55e0a96fc2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186581252} {:answer/id #uuid "9468d78a-a22f-59c0-8544-8dd91f65ce28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186581291} {:answer/id #uuid "bd0f6b97-d522-5f22-9ec7-13b009b1f30c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186581372}] :answer-field/correct {:db/id #edb/ref 17592186581074} :answer-field/id #uuid "d50a3151-c108-5fbc-b0b4-11a77735dc99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581610}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f458b28-b165-5394-a076-48aa8347358f" :question/math-academy-id "q-131260" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=1,$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}1-x, & 0<x<1 \\\\ \\frac{10(x-1)}{{x}^{6}},\\, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot (1-x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{10(x-1)}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{2}-{x}^{3})\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{10x-10}{{x}^{4}}\\,\\text{d}x \\\\  & =(\\frac{{x}^{3}}{3}-\\frac{{x}^{4}}{4}){|}_{0}^{1}+(-\\frac{5}{{x}^{2}}+\\frac{10}{3{x}^{3}}){|}_{1}^{\\infty } \\\\  & =\\frac{1}{12}+0+5-\\frac{10}{3} \\\\  & =\\frac{7}{4}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{7}{4}-{1}^{2} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352cd4fa-d886-55d2-bdb1-89058f24c395" :answer/type {:db/ident :answer.type/math} :answer/value "1.45" :db/id #edb/ref 17592186581116} {:answer/id #uuid "6528a101-6796-5c43-857f-9f895a29d761" :answer/type {:db/ident :answer.type/math} :answer/value "2.60" :db/id #edb/ref 17592186581202} {:answer/id #uuid "ae65e855-30f3-5b9e-ba89-1a9c683cb08d" :answer/type {:db/ident :answer.type/math} :answer/value "2.31" :db/id #edb/ref 17592186581342} {:answer/id #uuid "c87a2573-4317-5af2-91e8-b7f7ba782b6c" :answer/type {:db/ident :answer.type/math} :answer/value "1.96" :db/id #edb/ref 17592186581395} {:answer/id #uuid "e5a902da-c2a6-5e49-a44d-112724a28544" :answer/type {:db/ident :answer.type/math} :answer/value "2.95" :db/id #edb/ref 17592186581449}] :answer-field/correct {:db/id #edb/ref 17592186581342} :answer-field/id #uuid "55f17e15-9e56-5eee-aa0d-e6dbce1b4f99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581548}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a053b5b5-cfb1-5eaa-ade2-573c6fe57bdc" :question/math-academy-id "q-90566" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{11}{6},$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{8}{27}, & 0<x<3, \\\\ \\frac{9}{{x}^{4}}, & 3\\le x, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{3}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot \\frac{8}{27}\\,\\text{d}x+{\\int }_{3}^{\\infty }{x}^{2}\\cdot \\frac{9}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{8{x}^{2}}{27}\\,\\text{d}x+{\\int }_{3}^{\\infty }\\frac{9}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\frac{8{x}^{3}}{81}|}_{0}^{3}+{\\left(-\\frac{9}{x}\\right)|}_{3}^{\\infty } \\\\  & =\\frac{17}{3}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{17}{3}-{\\left(\\frac{11}{6}\\right)}^{2} \\\\  & =\\frac{83}{36} \\\\  & ≈2.31\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186581719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b4c07c8-f712-5930-bfeb-0ee97a9e4127" :answer/type {:db/ident :answer.type/math} :answer/value "3.02" :db/id #edb/ref 17592186581212} {:answer/id #uuid "962cf013-64e9-5b24-9fdc-c7e067512868" :answer/type {:db/ident :answer.type/math} :answer/value "1.96" :db/id #edb/ref 17592186581292} {:answer/id #uuid "a1f402d5-5a5a-56e0-a863-ae02138b8281" :answer/type {:db/ident :answer.type/math} :answer/value "2.81" :db/id #edb/ref 17592186581321} {:answer/id #uuid "ac448e08-ccb0-5449-8728-2ee20562ab52" :answer/type {:db/ident :answer.type/math} :answer/value "2.15" :db/id #edb/ref 17592186581338} {:answer/id #uuid "eb04968d-cd9d-5d15-8ae9-2fdeb2603c77" :answer/type {:db/ident :answer.type/math} :answer/value "3.50" :db/id #edb/ref 17592186581463}] :answer-field/correct {:db/id #edb/ref 17592186581212} :answer-field/id #uuid "c19359cc-f0df-5410-8b43-eb2230ef3b77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581601}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a9b26e16-3764-5428-977d-85cbeba99ae5" :question/math-academy-id "q-131259" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈0.6931,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{x+4}{24}, & -4<x<2 \\\\ \\frac{1}{{x}^{2}}, & 2\\le x<4 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{-4}^{4}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{-4}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{4}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{-4}^{2}{x}^{2}\\cdot \\frac{x+4}{24}\\,\\text{d}x+{\\int }_{2}^{4}{x}^{2}\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{24}{\\int }_{-4}^{2}({x}^{3}+4{x}^{2})\\,\\text{d}x+{\\int }_{2}^{4}\\,\\text{d}x \\\\  & =\\frac{1}{24}(\\frac{{x}^{4}}{4}+\\frac{4{x}^{3}}{3}){|}_{-4}^{2}+x{|}_{2}^{4} \\\\  & =\\frac{11}{18}+\\frac{8}{9}+2 \\\\  & =3.5\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈3.5-(0.6931)^{2} \\\\  & ≈3.02.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a1479f-7099-576b-a109-9298d80b71b1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186581045} {:answer/id #uuid "6ab613fb-e376-5dd6-82b0-8b1c022750fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581209} {:answer/id #uuid "90af1f81-4516-5ca9-be60-41ae6a8e33fe" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186581279} {:answer/id #uuid "9f002b2e-5e48-593c-b601-874beeedeb30" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186581312} {:answer/id #uuid "f440c68b-0129-5be4-a769-58c4965bfe37" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186581483}] :answer-field/correct {:db/id #edb/ref 17592186581209} :answer-field/id #uuid "74ce1887-cf59-52dc-86f6-98bf74280a34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581565}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e1bf4042-6970-5916-a89a-e9a8db2c8bbe" :question/math-academy-id "q-131165" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=2,$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{12(x-1)}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{12(x-1)}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{12{x}^{3}-12{x}^{2}}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{12}{{x}^{2}}-\\frac{12}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{12}{x}+\\frac{6}{{x}^{2}}{|}_{1}^{\\infty } \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =6-{2}^{2} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186582364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86380ab4-aea7-5ecd-8522-30d622590edd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186582047}] :answer-field/correct {:db/id #edb/ref 17592186582047} :answer-field/id #uuid "b15a4bb9-fe76-5ea8-87b9-4d80a6538e55" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186582301}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "428061f7-7e8e-53e2-b574-aa6198a6a095" :question/math-academy-id "q-302092" :question/problem "Find the limit at $x=1$ of the piecewise function $f(x)$ defined by\n\n$$\nf(x)=\\{\\begin{aligned}2x-1\\, & \\text{ for }\\,x<1 \\\\ 2\\, & \\text{ for }\\,x=1 \\\\ 2-{x}^{2}\\, & \\text{ for }\\,x>1.\\end{aligned}\n$$\n\n$$\n\\lim_{x\\to 1}f(x)=\n$$\n{{field-1}}" :question/worked-solution "Approaching from the left, we have $x<1,$ so we use the expression $f(x)=2x-1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}f(x) & =\\lim_{x\\to {1}^{-}}(2x-1) \\\\  & =2(1)-1 \\\\  & =1.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>1,$ so we use the expression $f(x)=2-{x}^{2}.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}(2-{x}^{2}) \\\\  & =2-{1}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nSince the left- and right-sided limits are equal to $1,$ we conclude that\n\n$$\n\\lim_{x\\to 1}f(x)=1.\n$$"}] [{:db/id #edb/ref 17592186582368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ededad9-ad84-52bc-abc9-ec75f56a5e94" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186582068}] :answer-field/correct {:db/id #edb/ref 17592186582068} :answer-field/id #uuid "580ae876-f774-5f1c-bd10-20699bea1984" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186582262}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ec0e444-9705-59db-b39a-d24b9743b1f8" :question/math-academy-id "q-302097" :question/problem "Find the right-sided limit at $x=32$ for the function\n\n$$\nf(x)=\\{\\begin{aligned}2x\\, & \\text{ for }\\,x\\le 32 \\\\ \\sqrt[5]{x}\\, & \\text{ for }\\,x>32.\\end{aligned}\n$$\n\n$$\n\\lim_{x\\to {32}^{+}}f(x)=\n$$\n{{field-1}}" :question/worked-solution "Approaching from the right, we have $x>32,$ so we use the expression $f(x)=\\sqrt[5]{x}.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {32}^{+}}f(x) & =\\lim_{x\\to {32}^{+}}\\sqrt[5]{x} \\\\  & =\\sqrt[5]{32} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186582373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b7c4795-8d0f-5b31-b444-b8c0eb69c6fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to \\,{0}^{-}}f(x)=2,\\,\\lim_{x\\to \\,{0}^{+}}f(x)=3" :db/id #edb/ref 17592186581911} {:answer/id #uuid "3fa5bab2-e355-5b9e-855c-bb5bfef18953" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to \\,{0}^{-}}f(x)=\\lim_{x\\to \\,{0}^{+}}f(x)=3" :db/id #edb/ref 17592186581936} {:answer/id #uuid "56ed21e2-2909-5f46-b033-e965dc351450" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to \\,{0}^{-}}f(x)=\\text{DNE},\\,\\lim_{x\\to \\,{0}^{+}}f(x)=2" :db/id #edb/ref 17592186581976} {:answer/id #uuid "74229e23-9be4-54f6-9fd1-0b478353e051" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to \\,{0}^{-}}f(x)=2,\\,\\lim_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186582016} {:answer/id #uuid "b2d2fcd5-d117-5f1f-84e0-61a08766f123" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to \\,{0}^{-}}f(x)=\\lim_{x\\to \\,{0}^{+}}f(x)=2" :db/id #edb/ref 17592186582120}] :answer-field/correct {:db/id #edb/ref 17592186582016} :answer-field/id #uuid "bc788828-4f85-5a34-b8ca-5c13c0894148" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582307}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "67761f4c-4109-5a7f-ba9f-81b0ee52929b" :question/math-academy-id "q-36698" :question/problem "Find $\\lim_{x\\to \\,{0}^{+}}f(x)$ and $\\lim_{x\\to \\,{0}^{-}}f(x)$ for the function given by\n\n$$\nf(x)=\\{\\begin{aligned}{e}^{x}+1 & \\text{ for }\\,x\\le 0 \\\\ \\sqrt{x}+2 & \\text{ for }\\,x\\ge 1\\end{aligned}\n$$" :question/worked-solution "Approaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)={e}^{x}+1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{-}}({e}^{x}+1) \\\\  & ={e}^{0}+1 \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$\n\nThe right-sided limit $\\lim_{x\\to {0}^{+}}f(x)$ does not exist since $f(x)$ is not defined on the interval $x\\in (0,1).$ \n\nConsequently, \n\n$$\n\\lim_{x\\to {0}^{+}}f(x)=\\text{DNE}.\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to {0}^{-}}f(x)=2,\\,\\lim_{x\\to {0}^{+}}f(x)=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186582387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f88e25f-bbe5-55c8-a67a-7a6eaca03287" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186582003} {:answer/id #uuid "a8c33853-ed17-50cd-9365-55cdff773212" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186582102} {:answer/id #uuid "baf290cb-bee8-57a2-8f68-84f632bad35b" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186582131} {:answer/id #uuid "ef2e168b-113e-5f39-bd83-a96775488ad1" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{5}{4}" :db/id #edb/ref 17592186582202} {:answer/id #uuid "feea6b1b-cd69-570a-abf4-a0f9fb53e3df" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186582225}] :answer-field/correct {:db/id #edb/ref 17592186582225} :answer-field/id #uuid "3eaf31c9-2b0a-5983-9665-20143d77a00d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582255}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8de3c8e0-f48e-5191-a8ca-d1dc2bb45bdd" :question/math-academy-id "q-36972" :question/problem "For the piecewise function \n\n$$\nf(x)=\\{\\begin{aligned}2\\operatorname{tan}⁡\\left(\\frac{x\\pi }{4}\\right)+3x\\, & \\text{ for }\\,-2<x\\le 1 \\\\ 4\\operatorname{cot}⁡\\left(\\frac{x\\pi }{4}\\right)+kx\\, & \\text{ for }\\,1<x<4\\end{aligned}\n$$\n\nit is known that $\\lim_{x\\to 1}f(x)$ exists. What is the value of constant $k?$" :question/worked-solution "In order for $\\lim_{x\\to 1}f(x)$ to exist, the left and right-sided limits must both exist and be equal.\n\n- Approaching from the left, we have $x<1,$ so we use the expression $f(x)=2\\operatorname{tan}⁡\\left(\\frac{x\\pi }{4}\\right)+3x.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}f(x) & =\\lim_{x\\to {1}^{-}}(2\\operatorname{tan}⁡\\left(\\frac{x\\pi }{4}\\right)+3x) \\\\  & =2\\operatorname{tan}⁡\\left(\\frac{1\\cdot \\pi }{4}\\right)+3(1) \\\\  & =2\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)+3 \\\\  & =2\\cdot 1+3 \\\\  & =5.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>1,$ so we use the expression $f(x)=4\\operatorname{cot}⁡\\left(\\frac{x\\pi }{4}\\right)+kx.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}(4\\operatorname{cot}⁡\\left(\\frac{x\\pi }{4}\\right)+kx) \\\\  & =4\\operatorname{cot}⁡\\left(\\frac{1\\cdot \\pi }{4}\\right)+k(1) \\\\  & =4\\operatorname{cot}⁡\\left(\\frac{\\pi }{4}\\right)+k \\\\  & =4\\cdot 1+k \\\\  & =4+k.\\end{aligned}\n$$\n\nFinally, since the left and right-sided limits must be equal, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{-}}f(x) \\\\ 4+k & =5 \\\\ k & =1\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186582390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d1bf89-74d9-58fc-ba1f-0da7f0ba4ffe" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186581898} {:answer/id #uuid "236e2bf2-5004-5ba4-a363-18d2915a0b8e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186581904} {:answer/id #uuid "7632959a-8d88-5caf-a48f-d8f4a1094aea" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186582021} {:answer/id #uuid "b11cbdba-dd2e-5207-92d0-06d9761a9de9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186582115} {:answer/id #uuid "be18ad51-77db-59f7-8d4f-74d51b0630a1" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186582135}] :answer-field/correct {:db/id #edb/ref 17592186582135} :answer-field/id #uuid "34a831a1-71a4-5255-8f6e-cec5a3d24ef3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582250}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "98d20c59-41cb-5b9e-90bb-67319a17d2bc" :question/math-academy-id "q-129895" :question/problem "Let $D$ be a finite region enclosed between the curve $y=|x|-1$ and the line $y=2.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}xy{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. $$\n\\displaystyle {∬}_{D}xy{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-1,2]$\n\nII. $$\n\\displaystyle {∬}_{R}xy{e}^{x+y}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-1,3]$\n\nIII. $$\n\\displaystyle {∬}_{D}xy{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [0,3]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/09/09707ef0347a6b67fc39c5247efbe19d22ca69b713738b5e3361cca5f965b021.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}xy{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}xy{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement II is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement III is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186582391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c27a22e-a962-5c0b-ac8d-509a3f413b51" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186581873} {:answer/id #uuid "3159f13e-3fef-5ae2-94dc-f101368b42af" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186581922} {:answer/id #uuid "3590421d-1eeb-588c-a38c-edc09e04ea74" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186581926} {:answer/id #uuid "5f9409db-447d-5a05-bf8e-68bf7bc3cba4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186581985} {:answer/id #uuid "fc1091f2-f17e-5704-8165-3e2b5d5e8a21" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186582221}] :answer-field/correct {:db/id #edb/ref 17592186581926} :answer-field/id #uuid "0dcb8bc3-1df2-51b0-a0ed-fa7129b876fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582236}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "998b8bc8-26b8-5a82-a7bf-365462577ff5" :question/math-academy-id "q-86862" :question/problem "Let $D$ be a finite region enclosed by the curves $y={x}^{2}$ and $y=-x+2.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}{y}^{2}+xy, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}({x}^{2}{y}^{2}+xy)\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\nI. $R=[-2,1]\\times [-1,2]$\n\nII. $R=[-3,2]\\times [-1,4]$\n\nIII. $R=[-3,1]\\times [2,4]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/10/10bcdedc511d069ecf790e06a1fbac49dc9bebd66638363f4e8dad5cbb82c2e9.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}{y}^{2}+xy, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nthen we obtain\n\n$$\n{∬}_{D}({x}^{2}{y}^{2}+xy)\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangles I and III do not cover the region $D.$\n\n- Rectangle II covers the region $D$ completely.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186582393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9bc917-694b-5b26-a947-7e56ac5a85dc" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186581933} {:answer/id #uuid "73ba2999-3a93-559c-81bc-31067c33ad06" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186582014} {:answer/id #uuid "9f69eba4-e276-5ed6-9fc1-1c1a5210c0da" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186582085} {:answer/id #uuid "b223d231-2ac9-59e2-be1f-0c0ef7066a74" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186582118} {:answer/id #uuid "bdaf8487-32eb-5fa8-b739-838528dda92f" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186582134}] :answer-field/correct {:db/id #edb/ref 17592186581933} :answer-field/id #uuid "ee4833cc-fed9-5b98-bc1d-f4ee7a1af9be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582335}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9c5a76ab-4aff-5864-ae3d-053a84c4533e" :question/math-academy-id "q-80506" :question/problem "Let $D$ be a finite region enclosed by the curves $y={x}^{2}-1$ and $y=x+1.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}y+y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}{x}^{2}y+y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\nI. $R=[-1,2]\\times [-1,3]$\n\nII. $R=[-1,1]\\times [-1,1]$\n\nIII. $R=[-1,3]\\times [-1,2]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/e4/e48f172079d6edc0b29356cafa30c82fcae0afd008e469ea8e0ad9a3660d6fd0.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}y+y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}{x}^{2}y+y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangles II and III do not cover the region $D.$\n\n- Rectangle I covers the region $D$ completely.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186582394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "407c491f-597a-540e-afe5-9804d6c32809" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {(-4)}^{+}}f(x)=-16" :db/id #edb/ref 17592186581937} {:answer/id #uuid "4e5fd911-3d75-5770-b418-4dc0ec2bc0c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {(-4)}^{+}}f(x)=16" :db/id #edb/ref 17592186581961} {:answer/id #uuid "63a23393-e817-58c0-a832-81d8ce9e1743" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {(-4)}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186581991} {:answer/id #uuid "862e281d-312d-5f62-914e-6ce4317d46f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {(-4)}^{+}}f(x)=-4" :db/id #edb/ref 17592186582046} {:answer/id #uuid "eb12e284-590c-5a37-8e58-d67d3bacf884" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {(-4)}^{+}}f(x)=4" :db/id #edb/ref 17592186582199}] :answer-field/correct {:db/id #edb/ref 17592186581961} :answer-field/id #uuid "cff8eaee-0d6b-5fb3-a549-f95a888917bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a17f4a77-7f20-57c3-98c8-d205f2e21ffb" :question/math-academy-id "q-36723" :question/problem "Find the right-sided limit at $x=-4$ of the piecewise function $f(x)$ defined by\n\n$$\nf(x)=\\{\\begin{aligned}-16\\, & \\text{ for }\\,x\\le -4 \\\\ {x}^{2}\\, & \\text{ for }\\,x>-4.\\end{aligned}\n$$" :question/worked-solution "Approaching from the right, we have $x>-4,$ so we use the expression $f(x)={x}^{2}.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {(-4)}^{+}}f(x) & =\\lim_{x\\to {(-4)}^{+}}{x}^{2} \\\\  & ={(-4)}^{2} \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186582396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e9011e-d30b-5e10-9291-d40265afac60" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186581899} {:answer/id #uuid "2fc1bde0-6485-563f-9185-3f9e0736b4e1" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186581918} {:answer/id #uuid "39de9fe9-d7e6-5340-9599-4eb9dbd22d64" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186581930} {:answer/id #uuid "5c6cb386-3a85-5860-8f5d-fbf0b27a915f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186581982} {:answer/id #uuid "d63f7256-d231-5a58-849b-a3b58e673816" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186582169}] :answer-field/correct {:db/id #edb/ref 17592186581918} :answer-field/id #uuid "2a797a02-698f-5dcd-af14-e554533c2d7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582247}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a96711f0-2d2a-53ff-8366-452fba0f03a0" :question/math-academy-id "q-129787" :question/problem "Let $D$ be a finite region enclosed between the curves $y={x}^{2}-4$ and $y=-x+2.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}-{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. $$\n\\displaystyle {∬}_{D}({x}^{2}-{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,2]\\times [-4,5]$\n\nII. $$\n\\displaystyle {∬}_{D}({x}^{2}-{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-5,5]$\n\nIII. $$\n\\displaystyle {∬}_{R}({x}^{2}-{y}^{3})\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-4,4]\\times [-6,6]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/1f/1f03bc85a6cd6f803c87a8fedaf8518af8306a57ff530481810af91a4d93c697.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}-{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}-{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186582398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "484a3c56-83cb-569f-b29a-b976e8efb857" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 0}f(x)=2" :db/id #edb/ref 17592186581948} {:answer/id #uuid "75c2deec-b195-55de-a0bb-ca48e72196b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 0}f(x)={e}^{2}" :db/id #edb/ref 17592186582020} {:answer/id #uuid "c3028d77-f2e4-56ee-9bfb-3457f5721b74" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 0}f(x)=1" :db/id #edb/ref 17592186582145} {:answer/id #uuid "f9f45c30-ac71-5bf6-ac1b-979ce5e596fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 0}f(x)=0" :db/id #edb/ref 17592186582218} {:answer/id #uuid "fc5e4c53-4741-5c58-85d4-82d41f4fa527" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 0}f(x)=e" :db/id #edb/ref 17592186582222}] :answer-field/correct {:db/id #edb/ref 17592186581948} :answer-field/id #uuid "98dbb6e6-c1ad-5475-a51a-a4a6621ce293" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582295}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b78d0954-5486-536b-bf33-39d65569ca17" :question/math-academy-id "q-36734" :question/problem "Find the limit at $x=0$ of the piecewise function $f(x)$ defined by\n\n$$\nf(x)=\\{\\begin{aligned}{e}^{x}+1 & \\text{ for }\\,x<0 \\\\ 1 & \\text{ for }\\,x=0 \\\\ {e}^{-x}+1 & \\text{ for }\\,x>0.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<0,$ so we use the expression $f(x)={e}^{x}+1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{-}}({e}^{x}+1) \\\\  & ={e}^{0}+1 \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>0,$ so we use the expression $f(x)={e}^{-x}+1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}f(x) & =\\lim_{x\\to {0}^{+}}({e}^{-x}+1) \\\\  & ={e}^{-0}+1 \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$\n\nSince the left- and right-sided limits are equal to $2,$ we conclude that\n\n$$\n\\lim_{x\\to 0}f(x)=2.\n$$"}] [{:db/id #edb/ref 17592186582403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000a9a3d-96f3-559b-bda4-a5a961befa38" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(0,1)\\times (0,3)}x\\sqrt{y}\\operatorname{sin}⁡(xy)\\,\\text{d}A" :db/id #edb/ref 17592186581852} {:answer/id #uuid "48da97ec-5a87-5ad7-8d2b-3999ddca1f3c" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(0,1)\\times (0,3)}\\operatorname{sin}⁡(xy)\\,\\text{d}A+{∬}_{(0,1)\\times (3,5)}x\\sqrt{y}\\,\\text{d}A" :db/id #edb/ref 17592186581950} {:answer/id #uuid "4a2aefe8-8a96-550a-a8c6-9a37a9535733" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(0,1)\\times (0,3)}(x\\sqrt{y}+\\operatorname{sin}⁡(xy))\\,\\text{d}A" :db/id #edb/ref 17592186581953} {:answer/id #uuid "7469d93b-2232-528f-a86a-41e132fc585e" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(0,1)\\times (0,3)}x\\sqrt{y}\\,\\text{d}A+{∬}_{(0,1)\\times (0,5)}\\operatorname{sin}⁡(xy)\\,\\text{d}A" :db/id #edb/ref 17592186582017} {:answer/id #uuid "a92adcba-a1d4-579a-8e9c-58761815e679" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(0,1)\\times (0,3)}x\\sqrt{y}\\,\\text{d}A+{∬}_{(0,1)\\times (3,5)}\\operatorname{sin}⁡(xy)\\,\\text{d}A" :db/id #edb/ref 17592186582105}] :answer-field/correct {:db/id #edb/ref 17592186582105} :answer-field/id #uuid "01205ae7-dc8f-5176-9642-377c0ccc47f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582229}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d10ccc73-4795-5132-917b-9833b7789e44" :question/math-academy-id "q-130041" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}x\\sqrt{y},\\, & \\text{if}\\,0<x<1,\\,0<y<3, \\\\ \\operatorname{sin}⁡(xy),\\, & \\text{if}\\,0<x<1,\\,3<y<5.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,1)\\times (0,5)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,1)\\times ((0,3)\\cup (3,5)) \\\\  & =((0,1)\\times (0,3))\\cup ((0,1)\\times (3,5)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,1)\\times (0,3)}f(x,y)\\,\\text{d}A+{∬}_{(0,1)\\times (3,5)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,1)\\times (0,3)}x\\sqrt{y}\\,\\text{d}A+{∬}_{(0,1)\\times (3,5)}\\operatorname{sin}⁡(xy)\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186582413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "557e205d-19aa-5f53-b4e1-09e47c331d7a" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}+12" :db/id #edb/ref 17592186581973} {:answer/id #uuid "7fbc5d37-d24b-5c42-bfe7-3c155b939dfd" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}-2" :db/id #edb/ref 17592186582040} {:answer/id #uuid "8cea4d6e-c773-5f1b-bc88-338e2f3bdcc4" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}+e-1" :db/id #edb/ref 17592186582064} {:answer/id #uuid "cba610d1-b63c-5d04-8fee-868f4f3a507a" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}+6" :db/id #edb/ref 17592186582156} {:answer/id #uuid "dfe60f62-66ea-5d13-b051-c7f75ea27bb3" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}+3e" :db/id #edb/ref 17592186582182}] :answer-field/correct {:db/id #edb/ref 17592186582156} :answer-field/id #uuid "bb67238e-e2ed-5b4e-8d71-b279623fa0f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582306}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f50e74c6-919a-5f71-bca3-e3a7949efcdf" :question/math-academy-id "q-130043" :question/problem "Evaluate the double integral $$\n\\displaystyle {∬}_{R}f(x,y)\\,\\text{d}A,\n$$ where\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3{x}^{2}}{y},\\, & \\text{if}\\,-1<x<2,\\,1<y<e, \\\\ xy,\\, & \\text{if}\\,2<x<4,\\,1<y<e,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(-1,2)\\times (1,e)$ and ${R}_{2}=(2,4)\\times (1,e).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}\\frac{3{x}^{2}}{y}\\,\\text{d}A+{∬}_{{R}_{2}}xy\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}(3{x}^{2})\\left(\\frac{1}{y}\\right)\\,\\text{d}A+{∬}_{{R}_{2}}(x)(y)\\,\\text{d}A \\\\  & =({\\int }_{-1}^{2}3{x}^{2}\\,\\text{d}x)({\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y)+({\\int }_{2}^{4}x\\,\\text{d}x)({\\int }_{1}^{e}y\\,\\text{d}y) \\\\  & =[{x}^{3}]_{-1}^{2}\\cdot [\\operatorname{ln}⁡y]_{1}^{e}+{[\\frac{{x}^{2}}{2}]}_{2}^{4}\\cdot {[\\frac{{y}^{2}}{2}]}_{1}^{e} \\\\  & =(8+1)\\cdot (1-0)+(8-2)\\cdot (\\frac{{e}^{2}}{2}-\\frac{1}{2}) \\\\  & =9+3({e}^{2}-1) \\\\  & =3{e}^{2}+6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186582416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c2163a6-d9a9-5e49-ae34-0016701b225b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581998}] :answer-field/correct {:db/id #edb/ref 17592186581998} :answer-field/id #uuid "332d18bb-fdb1-5607-a76f-60ae86476e65" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186582249} {:answer-field/choices [{:answer/id #uuid "c0b32ad4-7bdf-5da0-84e2-58fcd999a204" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186582142}] :answer-field/correct {:db/id #edb/ref 17592186582142} :answer-field/id #uuid "8a3d4542-2723-5813-b9c6-7ab3206b09e4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186582285}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff9dd161-7bf4-5368-bfad-b6750476ab0f" :question/math-academy-id "q-339916" :question/problem "Find the left-sided and the right-sided limits at $x=4$ for the function\n\n$$\ng(x)=\\{\\begin{aligned}x+2 & \\text{ for }\\,x<4 \\\\ {e}^{x-4}+1 & \\text{ for }\\,x\\ge 4.\\end{aligned}\n$$\n\n$$\n\\lim_{x\\to {4}^{-}}g(x)=\n$$\n{{field-1}}\n$\\,$ and $\\,$\n$$\n\\lim_{x\\to {4}^{+}}g(x)=\n$$\n{{field-2}}" :question/worked-solution "Approaching from the left, we have $x<4,$ so we use the expression $g(x)=x-2.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{-}}g(x) & =\\lim_{x\\to {2}^{-}}(x+2) \\\\  & =4+2 \\\\  & =6.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>4,$ so we use the expression $g(x)={e}^{x-4}+1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{+}}g(x) & =\\lim_{x\\to {4}^{+}}(\\,{e}^{x-4}+1\\,) \\\\  & ={e}^{4-4}+1 \\\\  & ={e}^{0}+1 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to {4}^{-}}g(x)=6,\\,\\lim_{x\\to {4}^{+}}g(x)=2.\n$$"}] [{:db/id #edb/ref 17592186583023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145414d3-4551-5bc9-ab74-c447219c7285" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186582519} {:answer/id #uuid "1a8ffc86-7d75-5084-a7d7-3986ac4ea83b" :answer/type {:db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186582527} {:answer/id #uuid "4afba6b1-ca84-5b31-b2ca-a18956c59e1c" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186582609} {:answer/id #uuid "8884eb81-d756-57a9-986a-4474718857ab" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186582714} {:answer/id #uuid "c93620fd-b6b3-57f4-b497-16be838a8c54" :answer/type {:db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186582814}] :answer-field/correct {:db/id #edb/ref 17592186582519} :answer-field/id #uuid "fcb44186-a0bd-550a-bc8e-45dd6ade367a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582997}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ab85875-8659-5af1-a05b-3ec68f62450f" :question/math-academy-id "q-152934" :question/problem "Consider the following function:\n\n$$\ng(x)=\\{\\begin{aligned}\\frac{x}{2}+1, & x\\ne -1 \\\\ 0, & x=-1\\end{aligned}\n$$\n\n \nWhich of the following statements are true regarding $g(x)?$\n\nI. $g(x)$ is defined at $x=-1$\n\nII. $\\lim_{x\\to \\,(-1)}g(x)$ exists\n\nIII. $\\lim_{x\\to \\,(-1)}g(x)=g(-1)$\n\nIV. $g(x)$ has a discontinuity at $x=-1$" :question/worked-solution "To test for continuity of $f(x)$ at a point $x=c$, we need to check three conditions:\n\n1\\. Does $f(c)$ exist?\n\n2\\. Does $\\lim_{x\\to c}f(x)$ exist?\n\n3\\. Does $\\lim_{x\\to c}f(x)=f(c)?$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Using the expression for the second branch of the function, we obtain that \n\n$$\ng(-1)=0.\n$$\n\nSo, $g(x)$ is defined at $x=-1.$ $\\,\\,✓$\n\n- Statement II is true. By calculating the one-sided limits, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to {(-1)}^{-}}g(x) & =\\lim_{x\\to {(-1)}^{-}}(\\frac{x}{2}+1) \\\\  & =\\frac{(-1)}{2}+1 \\\\  & =\\frac{1}{2} \\\\ \\lim_{x\\to {(-1)}^{+}}g(x) & =\\lim_{x\\to {(-1)}^{+}}(\\frac{x}{2}+1) \\\\  & =\\frac{(-1)}{2}+1 \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nAs a result:\n\n$$\n\\lim_{x\\to (-1)^{-}}g(x)=\\lim_{x\\to (-1)^{+}}g(x)\n$$\n\n \nTherefore, the limit of $g(x)$ at $x=-1$ exists:\n\n$$\n\\lim_{x\\to (-1)}g(x)=\\frac{1}{2}\\,\\,✓\n$$\n\n- Statement III is false. Indeed, we have that $\\lim_{x\\to (-1)}g(x)=\\frac{1}{2}\\ne g(-1).$  $\\,\\,\\times$\n\n- Statement IV is true. Since not all statements I-III are true, the function $g(x)$ has a discontinuity at $x=-1.$\n\nTherefore, the correct answer is \"I, II, and IV only.\""}] [{:db/id #edb/ref 17592186583028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57b2351c-4b42-5782-aeb4-ec0e407f1ed7" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186582628} {:answer/id #uuid "a7b1d317-3f93-5e70-95c1-84859a45519b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186582771} {:answer/id #uuid "d40b0bee-8288-59b6-b48a-10f20d1bef1f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186582835} {:answer/id #uuid "ef70f882-0ef3-596d-84ba-c368b6023f95" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186582871} {:answer/id #uuid "f049f70c-0cc9-5cc5-ab85-7a878a16353b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186582874}] :answer-field/correct {:db/id #edb/ref 17592186582628} :answer-field/id #uuid "bd63c2e7-6767-5ec7-88f0-13b182019cfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582969}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3e22f275-7bc3-534b-b3ee-edf97c6bfb95" :question/math-academy-id "q-152911" :question/problem "Consider the following function:\n\n$$\nf(x)=\\{\\begin{aligned}36-{x}^{3}, & x<3 \\\\ 9, & x=3 \\\\ {x}^{2}, & x>3\\end{aligned}\n$$\n\nWhich of the following statements are true regarding $f(x)?$\n\nI. $f(x)$ is defined at $x=3$\n\nII. $\\lim_{x\\to {3}^{-}}f(x)=\\lim_{x\\to {3}^{+}}f(x)$\n\nIII. $\\lim_{x\\to 3}f(x)=f(3)$\n\nIV. $f(x)$ has a discontinuity at $x=3$" :question/worked-solution "To test for continuity of $f(x)$ at a point $x=c$, we need to check three conditions:\n\n1\\. Does $f(c)$ exist?\n\n2\\. Does $\\lim_{x\\to c}f(x)$ exist?\n\n3\\. Does $\\lim_{x\\to c}f(x)=f(c)?$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Using the expression for the second branch of the function, we obtain that \n\n$$\nf(3)=9.\n$$\n\nSo, $f(x)$ is defined at $x=3.$ $\\,\\,✓$\n\n- Statement II is true. By calculating the one-sided limits, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to {3}^{-}}f(x) & =\\lim_{x\\to {3}^{-}}(36-{x}^{3}) \\\\  & =36-(3)^{3} \\\\  & =9 \\\\ \\lim_{x\\to {3}^{+}}f(x) & =\\lim_{x\\to {3}^{+}}({x}^{2}) \\\\  & =(3)^{2} \\\\  & =9\\end{aligned}\n$$\n\nAs a result:\n\n$$\n\\lim_{x\\to {3}^{-}}f(x)=\\lim_{x\\to {3}^{+}}f(x)\n$$\n\n \nTherefore, the limit of $f(x)$ at $x=3$ exists:\n\n$$\n\\lim_{x\\to 3}f(x)=9\\,\\,✓\n$$\n\n- Statement III is true. Indeed, we have that $\\lim_{x\\to 3}f(x)=9=f(3).$  $\\,\\,✓$\n\n- Statement IV is false. Since all statements I-III are true, according to the continuity test, the function $f(x)$ is continuous at $x=3.$\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186585036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ca1e6c-a9db-594b-9016-8d2f4f95e494" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186584520} {:answer/id #uuid "2e6885e2-6c79-56ac-a707-f154c368c4c4" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186584582} {:answer/id #uuid "a4e4803a-3193-5a61-ad59-41fa6d8162b0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186584760} {:answer/id #uuid "c76dfb14-ed87-5c28-aa7c-c3d97f8ae0d4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186584821} {:answer/id #uuid "e259caa1-7c25-584a-8413-f8b7a68494ea" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186584865}] :answer-field/correct {:db/id #edb/ref 17592186584520} :answer-field/id #uuid "9f02793e-5a9a-51f8-ade8-5864438f715e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584979}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "17f7ba10-4976-547e-9411-f559e227b76c" :question/math-academy-id "q-87241" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}k{e}^{10x},\\, & x<0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nIn our case, for the function $f(x)=k{e}^{10x}$ on the interval $-\\infty <x<0,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{0}k{e}^{10x}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}k{e}^{10x}\\,\\text{d}x &={[\\frac{k}{10}{e}^{10x}]}_{-\\infty }^{0}=\\frac{k}{10}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{10}=1\\,⟹\\,k=10.\n$$"}] [{:db/id #edb/ref 17592186585038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a9c0043-e651-5fb5-b526-8b2ece9ccdf9" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186584690} {:answer/id #uuid "8b3ad99f-3f53-5db5-a5e1-a47c938ebf2f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186584720} {:answer/id #uuid "a4a09bad-26b1-51c6-9d0a-6d1b782f6a02" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186584758} {:answer/id #uuid "a9ae9e35-428b-50af-899d-f04c9726549b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186584770} {:answer/id #uuid "d231275c-9862-52a3-92b8-4a75dc92b107" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186584834}] :answer-field/correct {:db/id #edb/ref 17592186584758} :answer-field/id #uuid "d2bbc92d-447c-5432-93d8-983cd65826b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186585003}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "25a69f9d-b645-54bf-9cbb-f1e3ce6f1da8" :question/math-academy-id "q-160441" :question/problem "$$\nf(x)=\\{\\begin{aligned}2{e}^{2x},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\le 0$\n\nII. $$\n\\displaystyle {\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x=1\n$$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\le 0,$ we have $f(x)=2{e}^{2x}\\ge 0.$\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x & ={\\int }_{-\\infty }^{0}2{e}^{2x}\\,\\text{d}x \\\\  & ={e}^{2x}\\,{|}_{-\\infty }^{0} \\\\  & ={e}^{0}-0 \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is true. Since statements I and II are true, the first and second conditions are satisfied. So, $f(x)$ is a valid probability density function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186585060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60926318-7d67-5432-9d46-0d93389d552d" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186584651} {:answer/id #uuid "71277fdb-8c98-5365-b0f5-9cac1eb9f910" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186584662} {:answer/id #uuid "79a544b4-b85a-5763-b5b4-bf511cf8012b" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186584685} {:answer/id #uuid "a02eb47b-fd3b-548a-9be4-72be2e27720c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186584749} {:answer/id #uuid "c3c8a0f9-7d9f-5951-a705-287434776a2d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186584815}] :answer-field/correct {:db/id #edb/ref 17592186584662} :answer-field/id #uuid "43b222a4-745f-52a7-b644-3d778e54f3a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584950}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4aa5fb59-6718-5462-9925-b4e1ad0a5f64" :question/math-academy-id "q-160454" :question/problem "$$\nf(x)=\\{\\begin{aligned}{e}^{x+2},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\le 0$\n\nII. $$\n\\displaystyle {\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x=1\n$$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\le 0,$ we have $f(x)={e}^{x+2}\\ge 0.$\n\n- Statement II is false. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x & ={\\int }_{-\\infty }^{0}{e}^{x+2}\\,\\text{d}x \\\\  & ={e}^{x+2}\\,{|}_{-\\infty }^{0} \\\\  & ={e}^{2}-0 \\\\  & ={e}^{2}\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, $f(x)$ is not a valid probability density function.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186585082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bfc71c5-c318-5100-92d6-a9e7486c44ef" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186584575} {:answer/id #uuid "5144d45c-59c3-5e35-9995-0b6b096386a7" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186584636} {:answer/id #uuid "7c1c4d2d-7da2-5b14-9bc9-8c47daa57710" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186584693} {:answer/id #uuid "db8d5c95-0d4c-5016-9f68-a2ad0181652f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186584852} {:answer/id #uuid "df3e4c71-b937-5253-8fb5-5d0bc306bfa1" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186584859}] :answer-field/correct {:db/id #edb/ref 17592186584575} :answer-field/id #uuid "e5f99d1c-5ad7-5a81-becd-abbb46d6367e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186585012}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88b2d9de-60dc-5457-8401-6605d8f70130" :question/math-academy-id "q-160443" :question/problem "$$\nf(x)=\\{\\begin{aligned}{e}^{x},\\, & x\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\le 1$\n\nII. $$\n\\displaystyle {\\int }_{-\\infty }^{1}f(x)\\,\\text{d}x=1\n$$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\le 1,$ we have $f(x)={e}^{x}\\ge 0.$\n\n- Statement II is false. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}f(x)\\,\\text{d}x & ={\\int }_{-\\infty }^{1}{e}^{x}\\,\\text{d}x \\\\  & ={e}^{x}\\,{|}_{-\\infty }^{1} \\\\  & ={e}^{1}-0 \\\\  & =e\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, $f(x)$ is not a valid probability density function.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186585083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254353e8-9c0c-5bcf-9180-96f4de47422a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186584557} {:answer/id #uuid "51120523-fa17-5ceb-ac2f-00a6061c05bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186584634} {:answer/id #uuid "7465ed96-affc-5e58-aba2-339f7d4426e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186584667} {:answer/id #uuid "b618eca1-55a3-5c99-9523-fed5d665b998" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186584786} {:answer/id #uuid "cc44d5a5-3293-56a1-91dd-a0b9a43692bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186584828}] :answer-field/correct {:db/id #edb/ref 17592186584786} :answer-field/id #uuid "05a463f1-eb55-54ab-9bea-73573998675f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89d2737a-db2c-5113-ba62-9daf05e9b52d" :question/math-academy-id "q-87230" :question/problem "Compute $P(X\\le -5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{{x}^{2}},\\, & x\\le -3, \\\\ 0,\\, & x>-3.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X\\le -5) & =P(-\\infty <X\\le -5) \\\\  & ={\\int }_{-\\infty }^{-5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-5}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{3}{x}]}_{-\\infty }^{-5} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186585109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0419a4ad-ccc4-5732-a066-b0a6fb0d7ca8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186584514} {:answer/id #uuid "1a15d695-a894-5cae-b303-09df784cf378" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186584538} {:answer/id #uuid "2cf0b60a-1b5b-5ab2-9179-fa2ff926ecc9" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186584580} {:answer/id #uuid "9e930ec7-0a1d-5449-bf40-e1808d6d62eb" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186584748} {:answer/id #uuid "eb3e7c75-d9d6-5ab1-b897-513e9093f5d2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186584879}] :answer-field/correct {:db/id #edb/ref 17592186584538} :answer-field/id #uuid "b910409b-f636-5d04-b781-8d88335088f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de37e0de-55a5-50bb-a1a2-7108ecfb8429" :question/math-academy-id "q-160462" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{k}{(4-x)^{3}},\\, & x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nIn our case, for the function $f(x)=\\frac{k}{(4-x)^{3}}$ on the interval $x\\le 2,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{2}\\frac{k}{(4-x)^{3}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{2}\\frac{k}{(4-x)^{3}}\\,\\text{d}x &=\\frac{k}{2(4-x)^{2}}\\,{|}_{-\\infty }^{2}=\\frac{k}{8}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{8}=1\\,⟹\\,k=8.\n$$"}] [{:db/id #edb/ref 17592186586548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0581d88f-47f3-53ca-ac04-8bead464f97a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{59}{56}" :db/id #edb/ref 17592186585888} {:answer/id #uuid "1eacbef4-82ac-53c3-9351-e6cf601fd528" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186585940} {:answer/id #uuid "215f616b-75f4-5da6-94e6-d94fbc0741a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{50}" :db/id #edb/ref 17592186585950} {:answer/id #uuid "4907d14c-38c4-5159-a4d9-2c654b6aa7f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{41}{28}" :db/id #edb/ref 17592186586024} {:answer/id #uuid "668d5445-92e8-5c3c-9e90-1a9f13a99723" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{60}{17}" :db/id #edb/ref 17592186586075}] :answer-field/correct {:db/id #edb/ref 17592186585888} :answer-field/id #uuid "a3088c34-5e5c-5b71-a2f4-3680156cc32b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586477}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "40438e8a-1cc8-567b-a164-3888c13ae6e3" :question/math-academy-id "q-90389" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}, & 0<x<1 \\\\ \\frac{3{x}^{2}}{14}, & 1\\le x<2\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x\n$$\n\n \n\nWe compute the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{0}^{2}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{2}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\frac{1}{2}\\,\\text{d}x+{\\int }_{1}^{2}x\\cdot \\frac{3{x}^{2}}{14}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}\\,\\text{d}x+{\\int }_{1}^{2}\\frac{3{x}^{3}}{14}\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{4}|}_{0}^{1}+{\\frac{3{x}^{4}}{56}|}_{1}^{2} \\\\  & =\\frac{1}{4}+\\frac{45}{56} \\\\  & =\\frac{59}{56}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a54e5f-e7d2-50cc-bc74-6f6a3aacdd26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186585879} {:answer/id #uuid "49047f28-bccb-50f3-a64a-e6ba7fec61ed" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186586023} {:answer/id #uuid "4cca7af5-0469-505a-925c-18d93885eae4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186586035} {:answer/id #uuid "6f37e1f7-98b9-52e5-8d04-d629b5ca19f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186586089} {:answer/id #uuid "84a2237b-483c-5e3c-817f-0014c4833546" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186586135}] :answer-field/correct {:db/id #edb/ref 17592186586135} :answer-field/id #uuid "a5d6eb1f-19ad-54f2-83d6-f4eb41339eb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f04680e-a673-559e-abe9-bb1b42386d0d" :question/math-academy-id "q-110003" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{5}, & x=1 \\\\ \\frac{1}{5}, & x=2 \\\\ \\frac{2}{5}, & x=3\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\sum }_{x\\in S}{x}^{2}\\cdot f(x).\n$$\n\nSumming up the products of each squared value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in S}{x}^{2}\\cdot f(x) \\\\  & ={1}^{2}\\cdot \\frac{2}{5}+{2}^{2}\\cdot \\frac{1}{5}+{3}^{2}\\cdot \\frac{2}{5} \\\\  & =\\frac{2}{5}+\\frac{4}{5}+\\frac{18}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b29a2d7-237c-5983-bb23-119f899d8685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}+\\frac{1}{{e}^{2}}+1" :db/id #edb/ref 17592186585998} {:answer/id #uuid "4182e594-3b1c-5594-beee-ce553851a4f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}+1" :db/id #edb/ref 17592186586008} {:answer/id #uuid "4ee7e4cb-33fe-5ce4-8989-79052f30b98e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}-\\frac{1}{e}+1" :db/id #edb/ref 17592186586038} {:answer/id #uuid "7a456eb1-0413-530a-a5f1-ba35afaa4611" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}-\\frac{1}{{e}^{2}}+1" :db/id #edb/ref 17592186586116} {:answer/id #uuid "8b0d1073-d886-50d3-9b33-1c1703cfd113" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}-\\frac{1}{{e}^{2}}-1" :db/id #edb/ref 17592186586155}] :answer-field/correct {:db/id #edb/ref 17592186586116} :answer-field/id #uuid "85468c66-9098-56d2-b860-1329bcee4fda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586454}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "70264740-af05-5406-ba9b-9a94defaec62" :question/math-academy-id "q-130881" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{ex}, & \\frac{1}{e}<x<1 \\\\ \\frac{1}{{x}^{2}}, & 1\\le x<e\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x\n$$\n\n \n\nWe compute the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{{e}^{-1}}^{e}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{{e}^{-1}}^{1}x\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{e}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{{e}^{-1}}^{1}x\\cdot \\frac{1}{ex}\\,\\text{d}x+{\\int }_{1}^{e}x\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{{e}^{-1}}^{1}\\frac{1}{e}\\,\\text{d}x+{\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x \\\\  & ={\\frac{x}{e}|}_{{e}^{-1}}^{1}+\\operatorname{ln}⁡x{|}_{1}^{e} \\\\  & =\\frac{1}{e}-\\frac{1}{{e}^{2}}+1-0 \\\\  & =\\frac{1}{e}-\\frac{1}{{e}^{2}}+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf80839-5f9a-59f3-b6c6-8394f1377d91" :answer/type {:db/ident :answer.type/math} :answer/value "1.25" :db/id #edb/ref 17592186585970} {:answer/id #uuid "376e99dd-1c9f-5daf-b4ca-63fa911fec4e" :answer/type {:db/ident :answer.type/math} :answer/value "0.78" :db/id #edb/ref 17592186585988} {:answer/id #uuid "8cefc991-bd9f-505d-ab0c-b4d63713f0b8" :answer/type {:db/ident :answer.type/math} :answer/value "1.65" :db/id #edb/ref 17592186586163} {:answer/id #uuid "a275b9b5-4725-5e5b-ad1e-2ae86e9d9be5" :answer/type {:db/ident :answer.type/math} :answer/value "1.81" :db/id #edb/ref 17592186586211} {:answer/id #uuid "be77f023-1c17-523e-ae0f-ed108ba10822" :answer/type {:db/ident :answer.type/math} :answer/value "1.13" :db/id #edb/ref 17592186586257}] :answer-field/correct {:db/id #edb/ref 17592186586211} :answer-field/id #uuid "ee945bb4-9f1d-5bd3-ae9b-e9ecfabce372" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586516}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce941b9b-782d-5931-bac1-db07d0594583" :question/math-academy-id "q-90446" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[X].$ Give your answer to two decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}}{3}, & 1<x<2 \\\\ \\frac{2}{9}, & 2\\le x<3\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x\n$$\n\n \n\nWe compute the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{3}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot \\frac{{x}^{2}}{3}\\,\\text{d}x+{\\int }_{2}^{3}x\\cdot \\frac{2}{9}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{{x}^{3}}{3}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{2x}{9}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{12}|}_{1}^{2}+{\\frac{{x}^{2}}{9}|}_{2}^{3} \\\\  & =\\frac{15}{12}+\\frac{5}{9} \\\\  & =\\frac{65}{36} \\\\  & ≈1.81,\\end{aligned}\n$$\n\n \n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186586613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "279fbbe8-62fc-5f8e-acee-f837847e4f8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186585959} {:answer/id #uuid "9e7d055b-ebd7-5d8b-9595-1471ea0c1176" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29}{6}" :db/id #edb/ref 17592186586203} {:answer/id #uuid "e9d2694a-1d0e-5701-a2ca-53700f318c21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186586340} {:answer/id #uuid "eeb23424-d542-5530-b290-2261f18cdbba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186586346} {:answer/id #uuid "f59b5534-2d2e-5d01-a8de-2852f9ed256b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{3}" :db/id #edb/ref 17592186586364}] :answer-field/correct {:db/id #edb/ref 17592186586364} :answer-field/id #uuid "83f2d81a-c391-536c-bada-c67bd96225e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586452}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec9bf528-d06e-5b2e-8331-90dacbd2d0c8" :question/math-academy-id "q-143801" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}, & x=1 \\\\ \\frac{1}{3}, & x=2 \\\\ \\frac{1}{6}, & x=3\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{3}$ is given by\n\n$$\n\\text{E}[{X}^{3}]={\\sum }_{x\\in S}{x}^{3}\\cdot f(x).\n$$\n\nSumming up the products of each cubed value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\sum }_{x\\in S}{x}^{3}\\cdot f(x) \\\\  & ={1}^{3}\\cdot \\frac{1}{2}+{2}^{3}\\cdot \\frac{1}{3}+{3}^{3}\\cdot \\frac{1}{6} \\\\  & =1\\cdot \\frac{1}{2}+8\\cdot \\frac{1}{3}+27\\cdot \\frac{1}{6} \\\\  & =\\frac{1}{2}+\\frac{8}{3}+\\frac{9}{2} \\\\  & =\\frac{23}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3669d52e-01d2-5840-8ea6-b71c35b841b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186586773} {:answer/id #uuid "7c5b9161-c842-5f60-8fd3-e9fa7484cdd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{72}{5}" :db/id #edb/ref 17592186586893} {:answer/id #uuid "9dbe1521-2059-5454-9770-9298e76bce39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{36}" :db/id #edb/ref 17592186586960} {:answer/id #uuid "b1d82734-d8c2-5b72-abb4-ce7fc44f98c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{72}" :db/id #edb/ref 17592186586991} {:answer/id #uuid "ea6ba9ff-53a6-543d-970c-da105c0838ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{72}" :db/id #edb/ref 17592186587109}] :answer-field/correct {:db/id #edb/ref 17592186586960} :answer-field/id #uuid "ecd4344b-1467-585e-857d-eef49c591f64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587267}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25a3122c-631d-534f-983b-79cf390647dd" :question/math-academy-id "q-89748" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{{x}^{2}}{144}, & 0\\le x\\le 12 \\\\ 1, & x>12,\\end{aligned}\n$$\n\nfind $P(4<X\\le 6).$" :question/worked-solution "We can perform this computation as follows:\n\n$$\n\\begin{aligned}P(4<X\\le 6) & =P(X\\le 6)-P(X\\le 4) \\\\  & =F(6)-F(4) \\\\  & =\\frac{{6}^{2}}{144}-\\frac{{4}^{2}}{144} \\\\  & =\\frac{5}{36}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c648df9-d933-525e-a4c6-37aa0e55c816" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186586717} {:answer/id #uuid "599dba62-e955-526e-931d-b5f6ecde45c0" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186586827} {:answer/id #uuid "63592343-ee5f-5ced-8354-f55c15bde9b5" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186586850} {:answer/id #uuid "7e64f3ed-14aa-5cfd-8949-d2cbcc914d3c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186586902} {:answer/id #uuid "95ce8c91-6ba8-5523-a4b9-d3ecfdf4ec6b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186586941}] :answer-field/correct {:db/id #edb/ref 17592186586902} :answer-field/id #uuid "9ddb33d5-8320-5420-8f7c-f84599dbee68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587226}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "379360cb-d369-5022-8e15-65c6f2ca6a19" :question/math-academy-id "q-213097" :question/problem "|  | $N$ | $Z$ | $Q$ |\n| --- | --- | --- | --- |\n| $N$ | $1$ | $1$ | $0$ |\n| $Z$ | $0$ | $0$ | $0$ |\n| $Q$ | $1$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{N,Z,Q\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(N,Z)$\n\nII. $(Q,Q)$\n\nIII. $(Z,Z)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(N,Z)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $N$-row and the $Z$-column.\n\n- The pair $(Q,Q)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $Q$-row and the $Q$-column.\n\n- The pair $(Z,Z)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $Z$-row and the $Z$-column.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186587320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "941f45f1-8112-5f24-aafe-14a5ba19448e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186586936}] :answer-field/correct {:db/id #edb/ref 17592186586936} :answer-field/id #uuid "15b5b913-09e5-57f4-9628-c911873caa5b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587163} {:answer-field/choices [{:answer/id #uuid "59a57448-0fd9-5684-95a8-c878c187b526" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586828}] :answer-field/correct {:db/id #edb/ref 17592186586828} :answer-field/id #uuid "1fe92805-f5fe-5073-9ddd-922baa20f55b" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587170} {:answer-field/choices [{:answer/id #uuid "bcc5b59c-3412-574d-942d-0a80735d2047" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186587012}] :answer-field/correct {:db/id #edb/ref 17592186587012} :answer-field/id #uuid "4e045632-fd64-5dfd-b9bd-057d45a4771d" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587190} {:answer-field/choices [{:answer/id #uuid "a6d2356f-3874-5027-91c9-638acbb5b960" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186586972}] :answer-field/correct {:db/id #edb/ref 17592186586972} :answer-field/id #uuid "7ed006ad-2352-507f-810d-5c19f6bae09a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587207} {:answer-field/choices [{:answer/id #uuid "72702b9a-2ea6-581f-af86-5a419d11f66d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586871}] :answer-field/correct {:db/id #edb/ref 17592186586871} :answer-field/id #uuid "c6f865ec-86d1-5b50-9294-a4de413d4a3e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587250}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "69236c45-b206-5c24-8daa-0feb5e92ca99" :question/math-academy-id "q-213119" :question/problem "Consider the sets $A=\\{-2,-1,0\\}$ and $B=\\{0,1,2\\},$ and the relation $R=\\{(x,y)\\in A\\times B\\,:\\,x=y-1\\}.$\nFill in the missing values in the adjacency matrix of the relation:\n\n|  | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $-2$ | $0$ | {{field-1}} | {{field-2}} |\n| $-1$ | {{field-3}} | $0$ | {{field-4}} |\n| $0$ | $0$ | {{field-5}} | $0$ |" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nThe relation $R$ is the set of ordered pairs $(x,y)\\in A\\times B$ with $x=y-1.$\n\nLet's consider each row in our table.\n\n- If $x=-2,$ then there is no value of $y\\in B$ that satisfies $x=y-1.$\n\n- If $x=-1,$ then the value $y=0$ satisfies $x=y-1.$ So, $R$ contains the ordered pair $(-1,0),$ and we write $1$ in the intersection of the $2$nd row and the $1$st column in the adjacency matrix.\n\n- If $x=0,$ then the value $y=1$ satisfies $x=y-1.$ So, $R$ contains the ordered pair $(0,1),$ and we write $1$ in the intersection of the $3$rd row and the $2$nd column in the adjacency matrix.\n\nAll the other cells in the matrix must be filled with zeros. Therefore, we have the following adjacency matrix:\n\n|  | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $-2$ | $0$ | $0$ | $0$ |\n| $-1$ | $1$ | $0$ | $0$ |\n| $0$ | $0$ | $1$ | $0$ |"}] [{:db/id #edb/ref 17592186587329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55219566-b147-5c91-a1ff-3a063060d37e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x/3}}{3}" :db/id #edb/ref 17592186586823} {:answer/id #uuid "5e1477f2-72a7-5436-b7e9-c317a3b5db3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x/3}}{3}" :db/id #edb/ref 17592186586840} {:answer/id #uuid "96bb5fb5-3c9b-55b4-9516-c5d8b5dc9321" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x/3}}{2}" :db/id #edb/ref 17592186586943} {:answer/id #uuid "d7227421-4f0e-50f0-afb5-2fe0b91a48ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x/3}}{2}" :db/id #edb/ref 17592186587063} {:answer/id #uuid "dc35d8f8-09fa-5b53-8c0e-7ffd234d635d" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{{e}^{2x/3}}{2}" :db/id #edb/ref 17592186587074}] :answer-field/correct {:db/id #edb/ref 17592186587063} :answer-field/id #uuid "5430940c-56d0-5eeb-b625-164bd457a5b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587193}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d413aac-5807-516c-8907-fea3b2acddc8" :question/math-academy-id "q-89730" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{{e}^{-|2x/3|}}{3},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}h(x),\\, & x<0 \\\\ 1-\\frac{{e}^{-2x/3}}{2},\\, & x\\ge 0.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t & ={\\frac{{e}^{2t/3}}{2}|}_{-\\infty }^{x} \\\\  & =\\frac{{e}^{2x/3}}{2},\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t & ={\\frac{{e}^{2x/3}}{2}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t & =-{\\frac{{e}^{-2t/3}}{2}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-2x/3}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-2x/3}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-2x/3}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{2x/3}}{2}, & x<0 \\\\ 1-\\frac{{e}^{-2x/3}}{2}, & x\\ge 0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576a6e67-80ad-5972-9dd3-d6de5f102dfd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586825}] :answer-field/correct {:db/id #edb/ref 17592186586825} :answer-field/id #uuid "20634ef4-a11c-5cb2-93e2-37311a2cc945" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587171} {:answer-field/choices [{:answer/id #uuid "75ce33d3-73c9-589e-a4cc-c6031a94cf5c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586881}] :answer-field/correct {:db/id #edb/ref 17592186586881} :answer-field/id #uuid "5c831c1d-f15e-510c-b8b4-37db030c03f2" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587196} {:answer-field/choices [{:answer/id #uuid "cd66ea83-37c9-5ca2-87e4-55535ba1cd59" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186587041}] :answer-field/correct {:db/id #edb/ref 17592186587041} :answer-field/id #uuid "a00f52f4-77f1-5083-ae97-0ee474b5cbb4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587228} {:answer-field/choices [{:answer/id #uuid "c8bbd8f3-7658-58bc-82c2-bb8931321384" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186587031}] :answer-field/correct {:db/id #edb/ref 17592186587031} :answer-field/id #uuid "ac38f8dd-32ff-5fb5-83f3-c5f47b4fb6b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587236} {:answer-field/choices [{:answer/id #uuid "efd2ba7c-553a-515f-99b7-96a85203193e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186587121}] :answer-field/correct {:db/id #edb/ref 17592186587121} :answer-field/id #uuid "e3a3af6a-505a-55e3-b802-da42d8bfa908" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587258}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "babf08c4-4b7c-546d-874f-9998301f4c0b" :question/math-academy-id "q-213007" :question/problem "Consider the sets $A=\\{1,2,3\\}$ and $B=\\{∅,\\{2\\},\\{1,2\\}\\},$ and the relation $R=\\{(x,y)\\in A\\times B\\,:\\,x\\in y\\}.$\nFill in the missing values in the adjacency matrix of the relation:\n\n|  | $∅$ | $\\{2\\}$ | $\\{1,2\\}$ |\n| --- | --- | --- | --- |\n| $1$ | {{field-1}} | $0$ | {{field-2}} |\n| $2$ | $0$ | {{field-3}} | {{field-4}} |\n| $3$ | $0$ | {{field-5}} | $0$ |" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nThe relation $R$ is the set of ordered pairs $(x,y)\\in A\\times B$ with $x\\in y.$\n\nLet's consider each row in our table.\n\n- If $x=1,$ then the value $y=\\{1,2\\}$ satisfies $x\\in y.$ So, $R$ contains the ordered pair $(1,\\{1,2\\}),$ and we write $1$ in the intersection of the $1$st row and the $3$rd column in the adjacency matrix.\n\n- If $x=2,$ then the values $y=\\{2\\},\\{1,2\\}$ satisfy $x\\in y.$ So, $R$ contains the ordered pairs $(2,\\{2\\})$ and $(2,\\{1,2\\}),$ and we write $1$ in the intersection of the $2$nd row and the $2$nd column and in the intersection of the $2$nd row and the $3$rd column in the adjacency matrix.\n\n- If $x=3,$ then there is no value of $y\\in B$ that satisfies $x\\in y.$\n\nAll the other cells in the matrix must be filled with zeros. Therefore, we have the following adjacency matrix:\n\n|  | $∅$ | $\\{2\\}$ | $\\{1,2\\}$ |\n| --- | --- | --- | --- |\n| $1$ | $0$ | $0$ | $1$ |\n| $2$ | $0$ | $1$ | $1$ |\n| $3$ | $0$ | $0$ | $0$ |"}] [{:db/id #edb/ref 17592186587358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32237a0c-609e-5a49-94aa-bcc66f8efb3b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186586762} {:answer/id #uuid "5b762c25-1795-5f64-835b-417f3d2c39f6" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186586833} {:answer/id #uuid "5bb62dae-0dd7-553f-8fef-bfd8775822ed" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186586834} {:answer/id #uuid "79476be3-c708-5e9b-8fb4-afb320dfcad2" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186586884} {:answer/id #uuid "c2fe063a-b205-58b6-ac9d-bc12714ef421" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186587025}] :answer-field/correct {:db/id #edb/ref 17592186586833} :answer-field/id #uuid "a2171cea-b024-5cae-b928-cfdfab1f13d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587230}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcd5a589-bd1c-5e59-a60d-a5a67e6fcf6a" :question/math-academy-id "q-213099" :question/problem "|  | $3$ | $5$ | $7$ |\n| --- | --- | --- | --- |\n| $2$ | $1$ | $1$ | $0$ |\n| $4$ | $1$ | $0$ | $1$ |\n| $6$ | $0$ | $1$ | $0$ |\n\nThe adjacency matrix of the relation $R,$ defined over the sets $\\{2,4,6\\}$ and $\\{3,5,7\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(2,7)$\n\nII. $(6,5)$\n\nIII. $(6,3)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(2,7)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $2$-row and the $7$-column.\n\n- The pair $(6,5)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $6$-row and the $5$-column.\n\n- The pair $(6,3)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $6$-row and the $3$-column.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186587359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210ca0b8-a4ed-5d17-90b0-697a5b418079" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186586729} {:answer/id #uuid "522a582c-dd7a-538d-aea3-6a5604094492" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186586820} {:answer/id #uuid "5d9987e4-ab1d-5b70-a527-dabea56c0a44" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186586839} {:answer/id #uuid "753f7655-6fea-5433-a2db-e52f5450e4c9" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186586879} {:answer/id #uuid "86a8e5f6-dc3c-5aa3-af10-8c5e74a0ba10" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186586916}] :answer-field/correct {:db/id #edb/ref 17592186586820} :answer-field/id #uuid "a62d8cbc-5d16-5ae0-8075-e070bd42a746" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587231}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c37d136c-f4fa-5cf3-a365-b4945e0fce86" :question/math-academy-id "q-213096" :question/problem "|  | $1$ | $4$ | $9$ |\n| --- | --- | --- | --- |\n| $1$ | $1$ | $0$ | $1$ |\n| $4$ | $1$ | $0$ | $1$ |\n| $9$ | $1$ | $1$ | $0$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{1,4,9\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(1,4)$\n\nII. $(4,9)$\n\nIII. $(9,4)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(1,4)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $1$-row and the $4$-column.\n\n- The pair $(4,9)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $4$-row and the $9$-column.\n\n- The pair $(9,4)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $9$-row and the $4$-column.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186589031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005a6c28-a9b8-5da0-946c-e90e595a643f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186588349} {:answer/id #uuid "13f61926-402b-596b-8962-8688816880bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{19}" :db/id #edb/ref 17592186588388} {:answer/id #uuid "3a93d266-3fac-56aa-a1f0-ccb5f809765e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186588465} {:answer/id #uuid "6b4e55cf-b0b7-5961-b89e-8e770fc876c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186588571} {:answer/id #uuid "a5a33036-012d-5878-885d-15402f42f6df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{19}" :db/id #edb/ref 17592186588697}] :answer-field/correct {:db/id #edb/ref 17592186588465} :answer-field/id #uuid "474a7d39-b195-5dd9-958a-f27a7269d1c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588912}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11d1bf06-89d7-5c5d-834c-2477999468d3" :question/math-academy-id "q-96812" :question/problem "Given $X∼U\\{9,10,11,…,28\\},$ compute $P(X>25).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{9,10,11,…,28\\},$ and the set $S=\\{9,10,11,…,28\\}$ has $|S|=28-9+1=20$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{20}, & x=9,10,11,…,28 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X>25$ are $26,27,28.$ There are $3$ of these items. Therefore,\n\n$$\nP(X>25)=3\\cdot \\frac{1}{20}=\\frac{3}{20}.\n$$"}] [{:db/id #edb/ref 17592186589034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0537e84a-444d-5363-bf59-829b30bd93e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186588358} {:answer/id #uuid "381903cf-5ffd-519b-b0aa-83bb36b0fde8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{27}" :db/id #edb/ref 17592186588461} {:answer/id #uuid "accf2ce1-ce4f-5032-a22c-94d4daaea89a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{27}" :db/id #edb/ref 17592186588713} {:answer/id #uuid "e0d95951-6d14-53c3-95ee-59f15314e07d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186588817} {:answer/id #uuid "f7e21385-ffea-52ac-94ce-ce722116e812" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{13}" :db/id #edb/ref 17592186588855}] :answer-field/correct {:db/id #edb/ref 17592186588713} :answer-field/id #uuid "fbabdff0-810a-5f76-a707-1fa2c088ea4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186589022}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1837fd0f-b453-598a-bac4-c7a513849bdf" :question/math-academy-id "q-96841" :question/problem "Given $X∼U\\{8,9,10,…,34\\},$ compute $P(12\\le X\\le 25).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{8,9,10,…,34\\},$ and the set $S=\\{8,9,10,…,34\\}$ has $|S|=34-8+1=27$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{27}, & x=8,9,10,…,34 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $12\\le X\\le 25$ are $12,13,14,…,25.$ There are $25-12+1=14$ of these items. Therefore,\n\n$$\nP(12\\le X\\le 25)=14\\cdot \\frac{1}{27}=\\frac{14}{27}.\n$$"}] [{:db/id #edb/ref 17592186589042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aec1a0c-0724-5839-8baf-76eaf8f2ecc5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186588366} {:answer/id #uuid "2888510c-9bb7-5e2e-84cb-ba59669e9b59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186588426} {:answer/id #uuid "8cd61fd0-2795-5e93-b67e-786b36d64d59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186588650} {:answer/id #uuid "9acda700-7880-57f4-8a4f-d29a6433dea6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{21}" :db/id #edb/ref 17592186588674} {:answer/id #uuid "cd1077dd-0b91-5a17-80b4-3712597a1dfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{21}" :db/id #edb/ref 17592186588776}] :answer-field/correct {:db/id #edb/ref 17592186588426} :answer-field/id #uuid "6ff9f006-fdd4-585b-b98b-446b974b31c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2c036ef3-87e8-5500-885c-21f613373a9a" :question/math-academy-id "q-164165" :question/problem "Given $X∼U\\{-10,-9,-8,…,10\\},$ compute $P(-3<X\\le 6).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{-10,-9,-8,…,10\\},$ and the set $S=\\{-10,-9,-8,…,10\\}$ has $|S|=10-(-10)+1=21$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{21}, & x=-10,-9,-8,…,10 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $-3<X\\le 6$ are $-2,-1,0,…,6.$ There are $6-(-2)+1=9$ of these items. Therefore,\n\n$$\nP(-3<X\\le 6)=9\\cdot \\frac{1}{21}=\\frac{3}{7}.\n$$"}] [{:db/id #edb/ref 17592186589056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc7e113-7d58-5963-8335-a5ddc160faa8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186588369} {:answer/id #uuid "1e80f60e-c6d9-5ee3-806c-41899ce47f05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186588410} {:answer/id #uuid "4b4b7de6-732f-53ef-949e-baf2baeec720" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186588497} {:answer/id #uuid "7177ed8b-b1da-54ce-b772-ca9d6a327a32" :answer/type {:db/ide