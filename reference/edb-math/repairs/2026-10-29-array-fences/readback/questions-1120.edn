#{[{:db/id #edb/ref 17592186591713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b83a274-e40a-5caf-b1be-2050dbbe83b0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186591068} {:answer/id #uuid "a3532a1c-b62b-5a8f-a000-a57689b6bd61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1024}{3125}" :db/id #edb/ref 17592186591299} {:answer/id #uuid "b1cce001-3ab9-5259-a908-7154bbf71e2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{64}{125}" :db/id #edb/ref 17592186591333} {:answer/id #uuid "c9dfa5fc-4a46-523c-ad3a-b0d95411f328" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{512}{625}" :db/id #edb/ref 17592186591374} {:answer/id #uuid "e483623f-4cc4-5c42-908e-de8459032fc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186591436}] :answer-field/correct {:db/id #edb/ref 17592186591299} :answer-field/id #uuid "186439d2-8348-5d10-9b7c-8188bde62817" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591501}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d8d6522f-8b1d-5640-ad93-001b41be1c63" :question/math-academy-id "q-142964" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{10}{3}x{y}^{4}, & 1\\le x\\le 2,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind $P(Y<\\frac{4}{5}).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{1}^{2}\\frac{10}{3}x{y}^{4}\\,\\text{d}x \\\\  & =\\frac{10}{3}{y}^{4}{[\\frac{1}{2}{x}^{2}]}_{x=1}^{x=2} \\\\  & =\\frac{5}{3}{y}^{4}({2}^{2}-{1}^{2}) \\\\  & =5{y}^{4}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}5{y}^{4}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(Y<\\frac{4}{5}) & ={\\int }_{-\\infty }^{4/5}{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{4/5}5{y}^{4}\\,\\text{d}y \\\\  & ={[{y}^{5}]}_{0}^{4/5} \\\\  & ={\\left(\\frac{4}{5}\\right)}^{5}-{0}^{5} \\\\  & =\\frac{1024}{3125}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "642e6dbc-2b18-5046-9ed6-df562e24d04e" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{x}" :db/id #edb/ref 17592186591167} {:answer/id #uuid "67dc7b49-5209-5539-8eba-5f408a27eb4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186591175} {:answer/id #uuid "7394be1f-7525-588b-8367-8f5d6f2c9618" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{{x}^{3}}" :db/id #edb/ref 17592186591203} {:answer/id #uuid "f6db558a-cdb9-5fba-a9a8-27291228e77d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186591467} {:answer/id #uuid "f9861006-70e3-5894-97e9-1daa1bab6c91" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186591472}] :answer-field/correct {:db/id #edb/ref 17592186591167} :answer-field/id #uuid "803b6850-6bb6-5334-a4e6-96a04a959f1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591555}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "eb2fe53f-84a4-58ab-aeed-b96d7ecf1f41" :question/math-academy-id "q-142920" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3{y}^{2}}{{x}^{2}}, & x\\ge 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThe marginal CDF ${F}_{X}(x)$ of $X$ is given by\n\n$$\n{F}_{X}(x)=\\{\\begin{aligned}0, & x<1 \\\\ g(x), & x\\ge 1.\\end{aligned}\n$$\n\nWhat is the function $g(x)?$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}\\frac{3{y}^{2}}{{x}^{2}}\\,\\text{d}y \\\\  & =\\frac{3}{{x}^{2}}{\\int }_{0}^{1}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{3}{{x}^{2}}{[\\frac{{y}^{3}}{3}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{{x}^{2}}{[{y}^{3}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{{x}^{2}}({1}^{3}-0) \\\\  & =\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $x\\ge 1$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{1}^{x}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & ={[-\\frac{1}{u}]}_{1}^{x} \\\\  & =1-\\frac{1}{x}.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\{\\begin{aligned}0, & x<1 \\\\ 1-\\frac{1}{x}, & x\\ge 1.\\end{aligned}\n$$\n\nFinally, $g(x)=1-\\frac{1}{x}.$"}] [{:db/id #edb/ref 17592186591723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29949efc-8bfd-5125-8a20-50777755e5d7" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{y}, & y\\le 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591066} {:answer/id #uuid "754f6f06-79a7-5bd4-a09d-d2d8e3b0aacb" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}y{e}^{y}, & y\\le 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591211} {:answer/id #uuid "c691cad4-3e45-55e1-8b29-23315dce06e7" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591367} {:answer/id #uuid "d6378e8c-3e24-5c52-af39-8009c04e33bd" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{y}^{2}{e}^{y}, & y\\le 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591407} {:answer/id #uuid "df8235e9-bd00-56a2-a243-ef0649886f8d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}-y{e}^{y}, & y\\le 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591427}] :answer-field/correct {:db/id #edb/ref 17592186591427} :answer-field/id #uuid "522c1bec-5c6d-59af-a36b-240c4216ddec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591528}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f54fcb3c-960b-5614-830e-4646b7887fac" :question/math-academy-id "q-142708" :question/problem "Let $X$ and $Y$ be two continuous random variables with a joint probability density function\n\n$$\nf(x,y)=2x{e}^{y},\\,x\\ge 0,\\,y\\le -{x}^{2}.\n$$\n\nFind the expression for the marginal PDF ${f}_{Y}(y).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,x\\ge 0,\\,y\\le -{x}^{2}\\}.$\n\n![](images/1b/1bc2723ca6b5ee5af27bb6f9cb8e3462dde99a4686542b3f8c273a4148ede595.png)\n\nIn our case, the marginal density function of $Y$ for $y\\le 0$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\sqrt{-y}}2x{e}^{y}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{\\sqrt{-y}}x{e}^{y}\\,\\text{d}x \\\\  & =2{[\\frac{1}{2}{x}^{2}{e}^{y}]}_{x=0}^{x=\\sqrt{-y}} \\\\  & =[{x}^{2}{e}^{y}]_{x=0}^{x=\\sqrt{-y}} \\\\  & =[{(\\sqrt{-y})}^{2}\\cdot {e}^{y}-{0}^{2}\\cdot {e}^{y}] \\\\  & =-y{e}^{y}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}-y{e}^{y}, & y\\le 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186593211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "151fc2f9-1161-5067-83c7-651eb6727fce" :answer/type {:db/ident :answer.type/math} :answer/value "0.98" :db/id #edb/ref 17592186592394} {:answer/id #uuid "88fb6401-77cb-57bd-b70b-8a0565dae19e" :answer/type {:db/ident :answer.type/math} :answer/value "0.09" :db/id #edb/ref 17592186592704} {:answer/id #uuid "9d094f34-b1ac-5b6c-8f5a-446bdbd9393f" :answer/type {:db/ident :answer.type/math} :answer/value "0.02" :db/id #edb/ref 17592186592754} {:answer/id #uuid "c930d0eb-d21a-5704-a885-50796d69fd57" :answer/type {:db/ident :answer.type/math} :answer/value "0.08" :db/id #edb/ref 17592186592888} {:answer/id #uuid "e5fde62a-fb06-59e2-a848-86804746e793" :answer/type {:db/ident :answer.type/math} :answer/value "0.92" :db/id #edb/ref 17592186592956}] :answer-field/correct {:db/id #edb/ref 17592186592888} :answer-field/id #uuid "aa157cdb-496f-55c4-a7a1-b142f4101504" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01cd9fca-2193-5783-80f6-562ef87e8b29" :question/math-academy-id "q-97203" :question/problem "Given that $X∼\\text{Bernoulli}(0.92),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.92),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.92, & x=1 \\\\ 0.08, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=0.08.\n$$"}] [{:db/id #edb/ref 17592186593225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f5b1f9-63fe-5b0c-a4b1-67fd3bbebe0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186592413} {:answer/id #uuid "bea04e58-cc02-579b-bb83-a130aac5080a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186592847} {:answer/id #uuid "c4798f36-7a13-5e3a-ba2f-c1a4c2326c56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186592866} {:answer/id #uuid "cbad4152-ce5d-5a43-85f8-de488e9940d5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186592893} {:answer/id #uuid "e45d1b5d-2a7f-5981-aa46-5f4a466a9430" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186592951}] :answer-field/correct {:db/id #edb/ref 17592186592847} :answer-field/id #uuid "2a9e9099-0455-5f30-9c88-6b5517ad432d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593046}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f97ee58-0c1a-56c2-b925-34b652d5a854" :question/math-academy-id "q-170658" :question/problem "Given that $X∼\\text{Bernoulli}\\left(\\frac{1}{6}\\right),$ compute $P(X=1).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}\\left(\\frac{1}{6}\\right),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{6}, & x=1 \\\\ \\frac{5}{6}, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=1)=f(1)=\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186593231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be50d72-4f86-5bec-b6ab-95c332e5f555" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186592419} {:answer/id #uuid "763e9cbc-c3e4-5da1-b7c6-71374d9841ed" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186592659} {:answer/id #uuid "7ab93143-801e-5c38-a865-f2cacf4eb482" :answer/type {:db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186592675} {:answer/id #uuid "b4cf93fc-b12d-578f-a79c-b210a39825cb" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186592818} {:answer/id #uuid "f45a0d83-6c22-5087-9d1a-8f56b6fe189a" :answer/type {:db/ident :answer.type/math} :answer/value "0.9" :db/id #edb/ref 17592186592987}] :answer-field/correct {:db/id #edb/ref 17592186592987} :answer-field/id #uuid "c9d91ec1-b73d-545d-b047-f60aeaec88a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593172}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d427a27-c68f-54ea-be5a-f488ce63d40e" :question/math-academy-id "q-97196" :question/problem "Given that $X∼\\text{Bernoulli}(0.1),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.1),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.1, & x=1 \\\\ 0.9, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=0.9.\n$$"}] [{:db/id #edb/ref 17592186593242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24a27841-80f2-5035-bd72-485564e9257a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186592449} {:answer/id #uuid "58cd7738-0f34-5c17-b16f-4fa882f9dfe5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186592585} {:answer/id #uuid "626e1f8f-b878-527b-960c-a8ed644722ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186592606} {:answer/id #uuid "9608139f-2646-5667-a9d4-c69918dbcfaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186592739} {:answer/id #uuid "a9e391fb-a9bd-5cea-a6f2-648035b90f46" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186592783}] :answer-field/correct {:db/id #edb/ref 17592186592606} :answer-field/id #uuid "fb77ce1c-ce3a-5f77-ac78-55b858b2d476" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593208}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b1fe355-be21-55d9-88e9-b15f4870021b" :question/math-academy-id "q-170660" :question/problem "Given that $X∼\\text{Bernoulli}\\left(\\frac{1}{3}\\right),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}\\left(\\frac{1}{3}\\right),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{3}, & x=1 \\\\ \\frac{2}{3}, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=\\frac{2}{3}.\n$$"}] [{:db/id #edb/ref 17592186593256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b3bf2f-573a-5a2d-b5f9-877b9e867fd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4e+3{e}^{2}-1}{2}" :db/id #edb/ref 17592186592398} {:answer/id #uuid "24e81381-c025-5a0e-ad54-45662fb93995" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2e-{e}^{2}+3}{2}" :db/id #edb/ref 17592186592451} {:answer/id #uuid "5fa3b55d-56b5-56d7-a689-35998c1523a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3e+{e}^{2}-1}{2}" :db/id #edb/ref 17592186592602} {:answer/id #uuid "7b431557-726d-5650-857f-3f44ab22ec48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4e-{e}^{2}-3}{2}" :db/id #edb/ref 17592186592676} {:answer/id #uuid "f3d718ee-5531-5fe1-a8e7-38e5c2012257" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2e-{e}^{2}-1}{2}" :db/id #edb/ref 17592186592986}] :answer-field/correct {:db/id #edb/ref 17592186592676} :answer-field/id #uuid "164b1296-a274-5d55-bda8-a478f091facf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6aa093db-db1c-5604-b14d-4beb6280682c" :question/math-academy-id "q-131155" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=e-1,$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{x},\\, & 1\\le x\\le e, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{e}{x}^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{2}|}_{1}^{e} \\\\  & =\\frac{{e}^{2}-1}{2}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{{e}^{2}-1}{2}-{(e-1)}^{2} \\\\  & =\\frac{4e-{e}^{2}-3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186593265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021a66f9-15d6-5911-87e0-88a923aef8dd" :answer/type {:db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186592348} {:answer/id #uuid "25d2221c-890c-50ad-9b8c-cc3571382496" :answer/type {:db/ident :answer.type/math} :answer/value "0.73" :db/id #edb/ref 17592186592453} {:answer/id #uuid "591d02ba-beca-5baf-9b4b-20df2a41dc57" :answer/type {:db/ident :answer.type/math} :answer/value "0.77" :db/id #edb/ref 17592186592586} {:answer/id #uuid "aa6bd597-c98d-5e01-a64b-0324890a5a80" :answer/type {:db/ident :answer.type/math} :answer/value "0.37" :db/id #edb/ref 17592186592786} {:answer/id #uuid "cbdc00bd-803b-5cc2-bea7-3832cd0cd9ad" :answer/type {:db/ident :answer.type/math} :answer/value "0.17" :db/id #edb/ref 17592186592895}] :answer-field/correct {:db/id #edb/ref 17592186592586} :answer-field/id #uuid "297eaaeb-bef5-52cb-9b2f-6e8daa4b739f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593044}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86bdba3d-a920-587d-a794-19f8e2169813" :question/math-academy-id "q-97211" :question/problem "Given that $X∼\\text{Bernoulli}(0.77),$ compute $P(X=1).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.77),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.77, & x=1 \\\\ 0.23, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=1)=f(1)=0.77.\n$$"}] [{:db/id #edb/ref 17592186593270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39945687-5b53-5847-83e6-767056c6c879" :answer/type {:db/ident :answer.type/math} :answer/value "0.28" :db/id #edb/ref 17592186592500} {:answer/id #uuid "5d09e065-4549-5f08-80ea-23f4c39df5c6" :answer/type {:db/ident :answer.type/math} :answer/value "0.84" :db/id #edb/ref 17592186592598} {:answer/id #uuid "ab0a626b-1df6-5059-b92e-baf5edbba245" :answer/type {:db/ident :answer.type/math} :answer/value "0.16" :db/id #edb/ref 17592186592789} {:answer/id #uuid "d3a22b57-9710-5a28-aba2-ec0a21541745" :answer/type {:db/ident :answer.type/math} :answer/value "0.06" :db/id #edb/ref 17592186592918} {:answer/id #uuid "d83653f9-9512-55b2-905a-815bc4b4c0c4" :answer/type {:db/ident :answer.type/math} :answer/value "0.14" :db/id #edb/ref 17592186592926}] :answer-field/correct {:db/id #edb/ref 17592186592789} :answer-field/id #uuid "9f829451-f1a0-5bb7-94b2-4ffd90e9df42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593137}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f19ac6c-0f9e-5d34-9636-41cc02e7cdae" :question/math-academy-id "q-97210" :question/problem "Given that $X∼\\text{Bernoulli}(0.16),$ compute $P(X=1).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.16),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.16, & x=1 \\\\ 0.84, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=1)=f(1)=0.16.\n$$"}] [{:db/id #edb/ref 17592186593274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13387953-67e5-55db-9603-96b07c7cd7a6" :answer/type {:db/ident :answer.type/math} :answer/value "1.24" :db/id #edb/ref 17592186592388} {:answer/id #uuid "557a5d01-b686-5762-84c3-cb2c23bd7a93" :answer/type {:db/ident :answer.type/math} :answer/value "0.85" :db/id #edb/ref 17592186592578} {:answer/id #uuid "71b70c1d-b868-5567-a6c4-e1f0b925a099" :answer/type {:db/ident :answer.type/math} :answer/value "0.91" :db/id #edb/ref 17592186592652} {:answer/id #uuid "8773a336-582e-58bc-8d2e-c92de652d5a3" :answer/type {:db/ident :answer.type/math} :answer/value "0.74" :db/id #edb/ref 17592186592700} {:answer/id #uuid "9e82eeb7-4107-504b-8289-d2d267f7f7c3" :answer/type {:db/ident :answer.type/math} :answer/value "1.13" :db/id #edb/ref 17592186592761}] :answer-field/correct {:db/id #edb/ref 17592186592700} :answer-field/id #uuid "c4d62433-669f-5529-85c5-6c6adcc89e8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593169}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "99b7d013-003d-567d-9a25-4182e399709f" :question/math-academy-id "q-90546" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{11}{12},$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}1-{x}^{2}, & 0<x<1, \\\\ \\frac{1}{6}, & 1\\le x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot (1-{x}^{2})\\,\\text{d}x+{\\int }_{1}^{3}{x}^{2}\\cdot \\frac{1}{6}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{2}-{x}^{4})\\,\\text{d}x+{\\int }_{1}^{3}\\frac{{x}^{2}}{6}\\,\\text{d}x \\\\  & ={(\\frac{{x}^{3}}{3}-\\frac{{x}^{5}}{5})|}_{0}^{1}+{\\frac{{x}^{3}}{18}|}_{1}^{3} \\\\  & =\\frac{71}{45}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{71}{45}-{\\left(\\frac{11}{12}\\right)}^{2} \\\\  & ≈0.74\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186593293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1b4ace-2d2e-5575-8f29-4d218218e5d7" :answer/type {:db/ident :answer.type/math} :answer/value "0.27" :db/id #edb/ref 17592186592417} {:answer/id #uuid "2fc35f73-5a46-5afd-8de9-929e9dc222cc" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186592478} {:answer/id #uuid "c292f812-69a7-5409-863c-0a74d4d923ea" :answer/type {:db/ident :answer.type/math} :answer/value "0.72" :db/id #edb/ref 17592186592859} {:answer/id #uuid "cbf2394d-096f-56d8-925c-8055f33c5b4b" :answer/type {:db/ident :answer.type/math} :answer/value "0.23" :db/id #edb/ref 17592186592897} {:answer/id #uuid "ff16632f-51d7-56df-85ae-de9a52e6358e" :answer/type {:db/ident :answer.type/math} :answer/value "0.73" :db/id #edb/ref 17592186593009}] :answer-field/correct {:db/id #edb/ref 17592186593009} :answer-field/id #uuid "f6674f1c-d6fd-53c9-afc6-59ef65dbd632" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593203}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d21b6dab-24ae-5e48-bbf3-ff8f673bb44d" :question/math-academy-id "q-97198" :question/problem "Given that $X∼\\text{Bernoulli}(0.27),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.27),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.27, & x=1 \\\\ 0.73, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=0.73.\n$$"}] [{:db/id #edb/ref 17592186593296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d667f78-61c9-5555-bd29-bbd4dd5c1d16" :answer/type {:db/ident :answer.type/math} :answer/value "0.13" :db/id #edb/ref 17592186592427} {:answer/id #uuid "3f12a019-d0bc-53fd-a3ee-07950701f8e0" :answer/type {:db/ident :answer.type/math} :answer/value "0.18" :db/id #edb/ref 17592186592522} {:answer/id #uuid "46db2d0b-d619-5d1f-bdfe-7c789c4dc6a5" :answer/type {:db/ident :answer.type/math} :answer/value "0.83" :db/id #edb/ref 17592186592542} {:answer/id #uuid "545c2ae1-2de0-5986-8bd6-3621a26b3fe6" :answer/type {:db/ident :answer.type/math} :answer/value "0.17" :db/id #edb/ref 17592186592575} {:answer/id #uuid "bf56385f-6061-57a8-96ae-6b424bb545c6" :answer/type {:db/ident :answer.type/math} :answer/value "0.87" :db/id #edb/ref 17592186592849}] :answer-field/correct {:db/id #edb/ref 17592186592427} :answer-field/id #uuid "4e14a7dc-2ea8-5b00-83b2-0050fab662b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d937d2b0-bac8-5667-bce8-66417e1c6307" :question/math-academy-id "q-97202" :question/problem "Given that $X∼\\text{Bernoulli}(0.87),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.87),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.87, & x=1 \\\\ 0.13, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=0.13.\n$$"}] [{:db/id #edb/ref 17592186593304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab6e5a8-3afd-59ec-ab02-3b988b830b73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186592463} {:answer/id #uuid "b53a641f-4a0c-5f8b-b8b3-e4a3d94cca01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186592819} {:answer/id #uuid "ca854eab-bb07-5157-a66a-04eebe4c8b76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186592890} {:answer/id #uuid "eaccafe1-80a9-5727-a738-47aeb0860282" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186592968} {:answer/id #uuid "f1eada11-ec2f-5376-a15a-3278b58f4bff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186592981}] :answer-field/correct {:db/id #edb/ref 17592186592819} :answer-field/id #uuid "19b37d70-aba7-59d0-bec2-ea2fe2d82e8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593035}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa05d63d-6128-5215-b7df-8cfe25e84f32" :question/math-academy-id "q-170657" :question/problem "Given that $X∼\\text{Bernoulli}\\left(\\frac{2}{3}\\right),$ compute $P(X=1).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}\\left(\\frac{2}{3}\\right),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{3}, & x=1 \\\\ \\frac{1}{3}, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=1)=f(1)=\\frac{2}{3}.\n$$"}] [{:db/id #edb/ref 17592186594147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13be2041-38a5-5f52-b1e5-c2dd9f95ffe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{11}" :db/id #edb/ref 17592186593426} {:answer/id #uuid "3b5eea8a-8ecb-5cca-8c74-1a41dbd9d72c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{27}" :db/id #edb/ref 17592186593510} {:answer/id #uuid "c4743ba4-c2ba-5031-a6bb-f992f27204c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186593851} {:answer/id #uuid "dbec9359-c558-5957-8e9c-e9a37478b78f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{21}" :db/id #edb/ref 17592186593901} {:answer/id #uuid "ea3f2b3d-3cdf-5df3-923b-eba617aa2b34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{27}" :db/id #edb/ref 17592186593931}] :answer-field/correct {:db/id #edb/ref 17592186593931} :answer-field/id #uuid "2fa636b3-f5de-5d3e-a215-f00fd104d1e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594020}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0dbc51ee-15ed-52a0-a21b-3201565510a6" :question/math-academy-id "q-145119" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{x+y}{3}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(X<\\frac{2}{3}\\,|\\,Y=\\frac{1}{2}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}y,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nUsing the formula for the marginal density function for $Y,$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{x+y}{3}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{0}^{2}(x+y)\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{{x}^{2}}{2}+xy]}_{x=0}^{x=2} \\\\  & =\\frac{1}{3}(2+2y-0) \\\\  & =\\frac{2(y+1)}{3}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2(y+1)}{3}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 2,0\\le y\\le 1,$ we have\n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{x+y}{3}\\right)}{\\left(\\frac{2(y+1)}{3}\\right)} \\\\  & =\\frac{x+y}{2(y+1)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{x+y}{2(y+1)}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(X<\\frac{2}{3}\\,|\\,Y=\\frac{1}{2}) & ={\\int }_{0}^{2/3}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{1}{2})\\text{d}x \\\\  & ={\\int }_{0}^{2/3}\\frac{(x+\\frac{1}{2})}{2(\\frac{1}{2}+1)}\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{2/3}(2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{6}{[{x}^{2}+x]}_{0}^{2/3} \\\\  & =\\frac{1}{6}(\\frac{4}{9}+\\frac{2}{3}-0) \\\\  & =\\frac{1}{6}\\left(\\frac{10}{9}\\right) \\\\  & =\\frac{5}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49797651-d75d-5b8c-9edb-8de32546def2" :answer/type {:db/ident :answer.type/math} :answer/value "0.27" :db/id #edb/ref 17592186593556} {:answer/id #uuid "78412886-0716-5e91-bbab-779c43a45715" :answer/type {:db/ident :answer.type/math} :answer/value "0.17" :db/id #edb/ref 17592186593661} {:answer/id #uuid "90a054a7-5132-5cb9-84c7-749d6119541b" :answer/type {:db/ident :answer.type/math} :answer/value "0.04" :db/id #edb/ref 17592186593725} {:answer/id #uuid "92cdf376-3dbe-5d00-88fc-fa0047956eab" :answer/type {:db/ident :answer.type/math} :answer/value "0.32" :db/id #edb/ref 17592186593730} {:answer/id #uuid "bf771000-640b-5ba4-87c8-a0030264cb02" :answer/type {:db/ident :answer.type/math} :answer/value "0.13" :db/id #edb/ref 17592186593834}] :answer-field/correct {:db/id #edb/ref 17592186593834} :answer-field/id #uuid "63442e50-d2a4-543e-9976-d1c33887296b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594047}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "29a9c010-814a-5d5c-a115-d796744175b6" :question/math-academy-id "q-148350" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}4{x}^{2}y+\\frac{1}{3}, & \\,0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{2}{3},\\,\\text{E}[Y]=\\frac{11}{18},\\,\\text{SD}[X]≈0.2582,\\,\\text{SD}[Y]≈0.2664,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}xy\\cdot (4{x}^{2}y+\\frac{1}{3})\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}(4{x}^{3}{y}^{2}+\\frac{1}{3}xy)\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1}{[{x}^{4}{y}^{2}+\\frac{1}{6}{x}^{2}y]}_{x=0}^{x=1}\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{2}+\\frac{1}{6}y)\\,\\text{d}y \\\\  & ={[\\frac{1}{3}{y}^{3}+\\frac{1}{12}{y}^{2}]}_{0}^{1} \\\\  & =\\frac{1}{3}+\\frac{1}{12} \\\\  & =\\frac{5}{12}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{12}-\\left(\\frac{2}{3}\\right)\\left(\\frac{11}{18}\\right) \\\\  & =\\frac{1}{108}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{\\left(\\frac{1}{108}\\right)}{(0.2582)\\cdot (0.2664)} \\\\  & ≈0.13,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186594155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "421233ee-c5e3-544a-8479-a4ffeb0830e6" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{-y}" :db/id #edb/ref 17592186593536} {:answer/id #uuid "5dcdf948-d921-5d2f-941a-24cb93e94df7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{-y}}{2}" :db/id #edb/ref 17592186593598} {:answer/id #uuid "817b8276-9838-522a-8c14-f181a8c53c7e" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{-2x}" :db/id #edb/ref 17592186593685} {:answer/id #uuid "8a975a63-ab05-5763-8427-541b7236f61d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2x}}{2}" :db/id #edb/ref 17592186593712} {:answer/id #uuid "f1fd7459-9620-52ab-a5d1-09d4175f500b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2x-y}}{2}" :db/id #edb/ref 17592186593951}] :answer-field/correct {:db/id #edb/ref 17592186593685} :answer-field/id #uuid "f7f60ca5-c9bf-5ef4-ac33-d1a0842269a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594137}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "32e245f7-b140-5c0a-bd45-81f7042158f5" :question/math-academy-id "q-143632" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}2{e}^{-2x-y}, & \\,x\\ge 0,\\,y\\ge 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $x\\ge 0,\\,y\\ge 0.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\infty }2{e}^{-2x-y}\\,\\text{d}x \\\\  & =2{e}^{-y}\\lim_{b\\to \\infty }{\\int }_{0}^{b}{e}^{-2x}\\,\\text{d}x \\\\  & =2{e}^{-y}\\lim_{b\\to \\infty }\\left(-\\frac{{e}^{-2x}}{2}\\right){|}_{0}^{b} \\\\  & ={e}^{-y}\\lim_{b\\to \\infty }(1-{e}^{-2b}) \\\\  & ={e}^{-y}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y}, & \\,y\\ge 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $x\\ge 0,\\,y\\ge 0,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{2{e}^{-2x-y}}{{e}^{-y}} \\\\  & =2{e}^{-2x}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}2{e}^{-2x}, & \\,x\\ge 0,\\,y\\ge 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fdf8f1c-b84c-56c3-a31d-8d97eb95ba94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186593451} {:answer/id #uuid "307b0591-6ac9-5028-96f6-3bd9c08df847" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186593491} {:answer/id #uuid "5c125c8a-9671-5e18-b65f-4fc4810dd6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186593596} {:answer/id #uuid "76168dee-4089-5ffb-a897-e3a994726170" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186593650} {:answer/id #uuid "8b28239a-75e4-53fe-b002-750b6f3347bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186593713}] :answer-field/correct {:db/id #edb/ref 17592186593491} :answer-field/id #uuid "2c695385-8f3c-53c1-abdd-94c78b29ed93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594017}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "48194873-0262-57b6-977e-d08b7a2391fb" :question/math-academy-id "q-148407" :question/problem "Maria collects stickers for a sticker album, where each sticker in the album has a different number on it.\nSo far, Maria has duplicates of the following sticker numbers:\n\n$$\n7,\\,12,\\,28,\\,35,\\,78,\\,81,\\,99,\\,112\n$$\n\nIf Maria picks a duplicate sticker at random to give to a friend, what is the probability that the sticker number she picks is greater than $70?$" :question/worked-solution "Let $X$ represent the number on the chosen sticker. From the problem statement, we know that $X∼U\\{7,\\,12,\\,28,\\,35,\\,78,\\,81,\\,99,\\,112\\},$ and we wish to compute $P(X>70).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{7,\\,12,\\,28,\\,35,\\,78,\\,81,\\,99,\\,112\\},$ and the set $S=\\{7,\\,12,\\,28,\\,35,\\,78,\\,81,\\,99,\\,112\\}$ has $|S|=8$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{8}, & x=7,\\,12,\\,28,\\,35,\\,78,\\,81,\\,99,\\,112 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X>70$ are $78,\\,81,\\,99,\\,112.$ There are $4$ of these items. Therefore,\n\n$$\nP(X>70)=4\\cdot \\frac{1}{8}=\\frac{4}{8}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186594164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d264558-e46c-5e25-862e-d378733b12f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{65}{72}" :db/id #edb/ref 17592186593409} {:answer/id #uuid "6d89f0fb-6019-5d93-b25d-a61f33ad879c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{55}{64}" :db/id #edb/ref 17592186593633} {:answer/id #uuid "7d59a7d7-5b61-506a-abac-1d1301608dd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{48}{72}" :db/id #edb/ref 17592186593675} {:answer/id #uuid "c20d28e3-c682-51b0-8361-a8a3c7b9c4ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{71}{72}" :db/id #edb/ref 17592186593846} {:answer/id #uuid "fd4feb9e-5305-50cb-9b3c-dfe22564f74e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{64}" :db/id #edb/ref 17592186593977}] :answer-field/correct {:db/id #edb/ref 17592186593846} :answer-field/id #uuid "d80d9b05-3b0e-5d84-82c0-e1b4164f07e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594113}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49c1fa94-41fa-54ea-b43b-1640e0c576cc" :question/math-academy-id "q-145109" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{y}{{x}^{2}} & \\,0<x\\le 2,\\,0\\le y\\le \\sqrt{2}\\,x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(\\frac{1}{4}<Y\\,|\\,X=\\frac{3}{2}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}x,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(\\frac{1}{4}<Y\\,|\\,X=\\frac{3}{2}) & ={\\int }_{1/4}^{3\\sqrt{2}/2}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{3}{2})\\text{d}y \\\\  & ={\\int }_{1/4}^{3\\sqrt{2}/2}\\frac{y}{{\\left(\\frac{3}{2}\\right)}^{2}}\\,\\text{d}y \\\\  & =\\frac{4}{9}{\\int }_{1/4}^{3\\sqrt{2}/2}y\\,\\text{d}y \\\\  & =\\frac{4}{9}{[\\frac{{y}^{2}}{2}]}_{1/4}^{3\\sqrt{2}/2} \\\\  & =\\frac{2}{9}({\\left(\\frac{3\\sqrt{2}}{2}\\right)}^{2}-{\\left(\\frac{1}{4}\\right)}^{2}) \\\\  & =\\frac{2}{9}(\\frac{9}{2}-\\frac{1}{16}) \\\\  & =\\frac{2}{9}\\cdot \\frac{71}{16} \\\\  & =\\frac{71}{72}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b7d3da-98f0-59f8-a828-e6395cfabc5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186593384} {:answer/id #uuid "8ec0150c-bcf5-586c-8b10-a71a89193876" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186593720} {:answer/id #uuid "979a0290-2039-5a43-b491-f1738717cc6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186593744} {:answer/id #uuid "a422c5ed-1585-54e7-a8c4-0bcbd3cdd946" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186593773} {:answer/id #uuid "b225e6a3-a995-5e83-ad0f-c7acf820d683" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186593806}] :answer-field/correct {:db/id #edb/ref 17592186593773} :answer-field/id #uuid "6d219dcd-6070-5a3e-b52a-77111a5d0112" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4e607124-453f-5d89-a238-255edf1e5015" :question/math-academy-id "q-148409" :question/problem "Jennifer's marbles are labeled with numbers $7$ through $22.$ If Jennifer chooses a marble at random, what is the probability that the marble number she picks is greater than or equal to $10$ and less than $17?$" :question/worked-solution "Let $X$ represent the number on the chosen marble. From the problem statement, we know that $X∼U\\{7,8,…,22\\},$ and we wish to compute $P(10\\le X<17).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{7,8,…,22\\},$ and the set $S=\\{7,8,…,22\\}$ has $|S|=22-7+1=16$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{16}, & x=7,8,…,22 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $10\\le X<17$ are $10,11,12,13,14,15,16.$ There are $7$ of these elements. Therefore,\n\n$$\nP(10\\le X<17)=7\\cdot \\frac{1}{16}=\\frac{7}{16}.\n$$"}] [{:db/id #edb/ref 17592186594172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20405660-6c0b-5ca7-ba39-49318f923999" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186593453} {:answer/id #uuid "3a5929b0-6a8d-5eea-9347-66bef6e2d72d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{13}" :db/id #edb/ref 17592186593508} {:answer/id #uuid "9eb31232-8837-522b-a7c6-407f4aa0219e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{27}" :db/id #edb/ref 17592186593761} {:answer/id #uuid "cbc26862-dacf-5bf0-b731-b91521b8f691" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{26}" :db/id #edb/ref 17592186593867} {:answer/id #uuid "e982debc-1e70-59c5-92c8-3bf186bca349" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{27}" :db/id #edb/ref 17592186593928}] :answer-field/correct {:db/id #edb/ref 17592186593867} :answer-field/id #uuid "3571fd4f-168f-5e64-9935-badf075a69c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594024}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63a61000-be39-5f78-93de-ca9b7047ca52" :question/math-academy-id "q-97652" :question/problem "Ann and Steven are playing a card game. Ann chooses a card at random from a deck of cards labeled $15$ through $40.$ If the number she picks is greater or equal to $20$ and less than $25,$ Ann wins, otherwise Steven wins. What is the probability that Ann wins the game?" :question/worked-solution "Let $X$ represent the card number Ann picks. From the problem statement, we know that $X∼U\\{15,16,…,40\\},$ and we wish to compute $P(20\\le X<25).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{15,16,…,40\\},$ and the set $S=\\{15,16,…,40\\}$ has $|S|=40-15+1=26$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{26}, & x=15,16,…,40 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $20\\le X<25$ are $20,21,22,23,24.$ There are $5$ of these elements. Therefore,\n\n$$\nP(20\\le X<25)=5\\cdot \\frac{1}{26}=\\frac{5}{26}.\n$$"}] [{:db/id #edb/ref 17592186594182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "570925b3-8f8e-5cfc-be3c-d11210838de1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x(-{x}^{2}+2)}{8}" :db/id #edb/ref 17592186593587} {:answer/id #uuid "85e50e3b-a3bf-510f-93ad-4f3b74f6e5b2" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{2}+x" :db/id #edb/ref 17592186593700} {:answer/id #uuid "c1f96c07-df9e-5631-a1ab-5b08985ba963" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x}{-{x}^{2}+x+2}" :db/id #edb/ref 17592186593845} {:answer/id #uuid "e81823df-fe9a-5209-8d9a-f0d037ea3367" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{-{x}^{2}+x+2}" :db/id #edb/ref 17592186593926} {:answer/id #uuid "fc87f1c1-2bd7-5292-b412-77b27fcb26c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8(-{x}^{2}+2)}{3x}" :db/id #edb/ref 17592186593974}] :answer-field/correct {:db/id #edb/ref 17592186593926} :answer-field/id #uuid "2b48f238-da66-5ee8-a342-90bced86a287" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594014}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e6e5bd8-8a05-549b-9cb9-4a44448da5e8" :question/math-academy-id "q-143640" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3x}{8}, & \\,0\\le x<2,\\,{x}^{2}\\le y\\le x+2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x<2,\\,{x}^{2}\\le y\\le x+2.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{{x}^{2}}^{x+2}\\frac{3x}{8}\\,\\text{d}y \\\\  & =\\frac{3x}{8}\\cdot y\\,{|}_{{x}^{2}}^{x+2} \\\\  & =\\frac{3x}{8}\\cdot (x+2-{x}^{2}) \\\\  & =\\frac{3x(-{x}^{2}+x+2)}{8}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3x(-{x}^{2}+x+2)}{8}, & \\,0\\le x<2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x<2,\\,{x}^{2}\\le y\\le x+2,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\left(\\frac{3x}{8}\\right)}{\\left(\\frac{3x(-{x}^{2}+x+2)}{8}\\right)} \\\\  & =\\frac{1}{-{x}^{2}+x+2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{1}{-{x}^{2}+x+2}, & \\,0\\le x<2,\\,{x}^{2}\\le y\\le x+2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18903c8d-5af3-519e-ad20-4a7cefb6f46b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{y+1}" :db/id #edb/ref 17592186593436} {:answer/id #uuid "94f09c21-753a-58f6-af25-017332b8bc61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(xy+1)}{y+1}" :db/id #edb/ref 17592186593736} {:answer/id #uuid "aa2a6ea1-c5cb-533f-8f0d-080814ac2153" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy+1}{2(y+1)}" :db/id #edb/ref 17592186593785} {:answer/id #uuid "c128e7b2-ce09-5b01-84a0-a50607ef5b6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+y}{2(y+1)}" :db/id #edb/ref 17592186593841} {:answer/id #uuid "cec16073-4f00-5b15-9764-b1607114d278" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+1}{xy+2}" :db/id #edb/ref 17592186593869}] :answer-field/correct {:db/id #edb/ref 17592186593785} :answer-field/id #uuid "45ae3fb8-74fc-52d6-a846-bf0aaf975b50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594034}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "93b3b076-040f-57da-a9b0-481b207ab196" :question/math-academy-id "q-145095" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{xy+1}{3}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 2,\\,0\\le y\\le 1.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{xy+1}{3}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{0}^{2}(xy+1)\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{{x}^{2}y}{2}+x]}_{x=0}^{x=2} \\\\  & =\\frac{1}{3}\\cdot [2y+2-0] \\\\  & =\\frac{2(y+1)}{3}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2(y+1)}{3}, & \\,0\\le x\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 2,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{xy+1}{3}\\right)}{\\left(\\frac{2(y+1)}{3}\\right)} \\\\  & =\\frac{xy+1}{2(y+1)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{xy+1}{2(y+1)}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f7487bd-265d-5bc7-83cc-c9c0931145d8" :answer/type {:db/ident :answer.type/math} :answer/value "15{x}^{2}y" :db/id #edb/ref 17592186593486} {:answer/id #uuid "4a372f38-7a87-5ac9-8ff0-573c9721656e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4xy}{15}" :db/id #edb/ref 17592186593558} {:answer/id #uuid "71270774-73ea-5328-b718-4fa3a01b74ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15xy}{1-{x}^{2}}" :db/id #edb/ref 17592186593642} {:answer/id #uuid "75bdfbd1-7c58-5d54-ac99-6fff965f30ef" :answer/type {:db/ident :answer.type/math} :answer/value "30xy" :db/id #edb/ref 17592186593647} {:answer/id #uuid "db46d93a-ea7d-50a7-8cb9-cabac0aefd46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{2}y}{15(1-{x}^{2})}" :db/id #edb/ref 17592186593899}] :answer-field/correct {:db/id #edb/ref 17592186593486} :answer-field/id #uuid "55e388c2-eef8-5ae9-a3d3-7c9872756e99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594042}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9bec54a3-d311-5351-a212-c493a73b9300" :question/math-academy-id "q-143615" :question/problem "$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{1-{x}^{2}}, & 0\\le x<1,\\,0\\le y\\le \\sqrt{1-{x}^{2}}, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{15{x}^{2}(1-{x}^{2})}{2}, & 0\\le x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ and the marginal density function ${f}_{X}(x)$ are shown above. Find the expression of the joint probability density function $f(x,y)$ for $0\\le x<1,\\,0\\le y\\le \\sqrt{1-{x}^{2}}.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nFrom the equation above, it follows that\n\n$$\nf(x,y)={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x).\n$$\n\nNow, for $0\\le x<1,\\,0\\le y\\le \\sqrt{1-{x}^{2}},$ we have \n\n$$\n\\begin{aligned}f(x,y) & ={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x) \\\\  & =\\frac{2y}{1-{x}^{2}}\\cdot \\frac{15{x}^{2}(1-{x}^{2})}{2} \\\\  & =15{x}^{2}y.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ equals $0.$ As a result, the product will be equal to $0$ too.\n\nTherefore, the joint probability density function is the following:\n\n$$\nf(x,y)=\\{\\begin{aligned}15{x}^{2}y, & 0\\le x<1,\\,0\\le y\\le \\sqrt{1-{x}^{2}} \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3693820a-1870-5848-9030-438ce9172e9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{21}" :db/id #edb/ref 17592186593501} {:answer/id #uuid "78acea98-d856-506b-97db-a44a12229297" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{32}" :db/id #edb/ref 17592186593662} {:answer/id #uuid "9ae90186-9131-57b6-8399-82183c7ae35f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186593753} {:answer/id #uuid "bba38901-beba-5400-9447-3315323caf6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{24}" :db/id #edb/ref 17592186593826} {:answer/id #uuid "fa257460-0d27-5b77-b2fe-d268692bba91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186593968}] :answer-field/correct {:db/id #edb/ref 17592186593662} :answer-field/id #uuid "52b233f1-7196-540f-9aaf-964ccf28135d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594041}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aeede78e-94df-54ad-9afa-3cff3ecafc80" :question/math-academy-id "q-145041" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x+2y}{2y+1}, & \\,0<x<1,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X<\\frac{3}{4}\\,|\\,Y=\\frac{1}{2}).$" :question/worked-solution "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(X<\\frac{3}{4}\\,|\\,Y=\\frac{1}{2}) & ={\\int }_{0}^{3/4}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{1}{2})\\text{d}x \\\\  & ={\\int }_{0}^{3/4}\\frac{(2x+2\\cdot \\frac{1}{2})}{(2\\cdot \\frac{1}{2}+1)}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{3/4}(2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{2}[{x}^{2}+x]_{0}^{3/4} \\\\  & =\\frac{1}{2}({\\left(\\frac{3}{4}\\right)}^{2}+\\frac{3}{4}-0) \\\\  & =\\frac{1}{2}(\\frac{9}{16}+\\frac{3}{4}) \\\\  & =\\frac{1}{2}\\cdot \\frac{21}{16} \\\\  & =\\frac{21}{32}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23eae862-9580-5e02-be32-ce2dbd81aec7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186593464} {:answer/id #uuid "815ceb11-5177-5da1-aa23-e72cb20f85b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186593684} {:answer/id #uuid "9b1f7e60-68fc-5873-a8e5-d18bda03e240" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186593756} {:answer/id #uuid "b0f211e1-9c03-50bc-bfaf-d124fe3d9f38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186593805} {:answer/id #uuid "ed2ae822-ff62-59bb-b286-0a52de7c81b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186593937}] :answer-field/correct {:db/id #edb/ref 17592186593937} :answer-field/id #uuid "4f9dabf5-ba1d-5337-90cd-b4c042cf5810" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594039}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ca549ea0-069f-517c-8dea-30a9de93b0a5" :question/math-academy-id "q-97628" :question/problem "In a math test, a student has to answer a multiple-choice question, and they decide to select an answer at random. The answers are labeled from $1$ to $5.$ What is the probability that the student picks one of the first $2$ answers?" :question/worked-solution "Let $X$ represent the selected answer. From the problem statement, we know that $X∼U\\{1,2,…,5\\},$ and we wish to compute $P(X\\le 2).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{1,2,…,5\\},$ and the set $S=\\{1,2,…,5\\}$ has $|S|=5-1+1=5$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{5}, & x=1,2,…,5 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X\\le 2$ are $1,2.$ There are $2$ of these elements. Therefore,\n\n$$\nP(X\\le 2)=2\\cdot \\frac{1}{5}=\\frac{2}{5}.\n$$"}] [{:db/id #edb/ref 17592186594218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1572b57a-dff2-5ebd-8871-f0e3a47e3677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186593430} {:answer/id #uuid "4750a9d7-5626-52ae-b638-7bcd5c7c0cfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{20}" :db/id #edb/ref 17592186593553} {:answer/id #uuid "9fb8933e-b886-5556-b4bb-aabbd9801367" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186593765} {:answer/id #uuid "f1c40c99-1fc1-5e4b-bc92-e97e3142de3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{40}" :db/id #edb/ref 17592186593949} {:answer/id #uuid "f44e224b-a122-56f4-9ab4-0388bd861372" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186593956}] :answer-field/correct {:db/id #edb/ref 17592186593949} :answer-field/id #uuid "be261ba0-d614-5a73-b85e-4435b032bf31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594098}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d1413b7f-f919-5052-8fef-4e7307d9f409" :question/math-academy-id "q-145127" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3(x+2y)}{2}, & \\,0\\le y\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(X<\\frac{2}{5}\\,|\\,Y=\\frac{1}{5}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}y,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nUsing the formula for the marginal density function for $Y,$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{y}^{1}\\frac{3(x+2y)}{2}\\,\\text{d}x \\\\  & =\\frac{3}{2}{\\int }_{y}^{1}(x+2y)\\,\\text{d}x \\\\  & =\\frac{3}{2}{[\\frac{1}{2}{x}^{2}+2xy]}_{x=y}^{x=1} \\\\  & =\\frac{3}{2}(\\frac{1}{2}+2y-\\frac{1}{2}{y}^{2}-2{y}^{2}) \\\\  & =\\frac{3}{2}[\\frac{1+4y-5{y}^{2}}{2}] \\\\  & =\\frac{3(1+4y-5{y}^{2})}{4}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3(1+4y-5{y}^{2})}{4}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le y\\le x\\le 1,$ we have\n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{3(x+2y)}{2}\\right)}{\\left(\\frac{3(1+4y-5{y}^{2})}{4}\\right)} \\\\  & =\\frac{2(x+2y)}{1+4y-5{y}^{2}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2(x+2y)}{1+4y-5{y}^{2}}, & \\,0\\le y\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(X<\\frac{2}{5}\\,|\\,Y=\\frac{1}{5}) & ={\\int }_{y}^{2/5}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{1}{5})\\text{d}x \\\\  & ={\\int }_{1/5}^{2/5}\\frac{2(x+2\\left(\\frac{1}{5}\\right))}{(1+4\\left(\\frac{1}{5}\\right)-5{\\left(\\frac{1}{5}\\right)}^{2})}\\,\\text{d}x \\\\  & ={\\int }_{1/5}^{2/5}\\frac{2(x+\\frac{2}{5})}{\\left(\\frac{8}{5}\\right)}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{1/5}^{2/5}(5x+2)\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{5{x}^{2}}{2}+2x]}_{1/5}^{2/5} \\\\  & =\\frac{1}{4}(\\frac{2}{5}+\\frac{4}{5}-\\frac{1}{10}-\\frac{2}{5}) \\\\  & =\\frac{1}{4}\\left(\\frac{7}{10}\\right) \\\\  & =\\frac{7}{40}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2c0631-0bd4-5d71-9836-be598891083b" :answer/type {:db/ident :answer.type/math} :answer/value "-0.12" :db/id #edb/ref 17592186593439} {:answer/id #uuid "2606abf0-8418-5f2c-ba74-449c818c1e05" :answer/type {:db/ident :answer.type/math} :answer/value "0.11" :db/id #edb/ref 17592186593470} {:answer/id #uuid "a2873844-44cc-5aa7-bbd2-59778cdbb622" :answer/type {:db/ident :answer.type/math} :answer/value "0.09" :db/id #edb/ref 17592186593770} {:answer/id #uuid "b9e952be-961b-57b8-9c32-60b303de06eb" :answer/type {:db/ident :answer.type/math} :answer/value "-0.04" :db/id #edb/ref 17592186593819} {:answer/id #uuid "e9f815f9-bbd5-5fec-a212-23cc136e306d" :answer/type {:db/ident :answer.type/math} :answer/value "-0.06" :db/id #edb/ref 17592186593930}] :answer-field/correct {:db/id #edb/ref 17592186593819} :answer-field/id #uuid "358713e9-f69b-5d1e-aa48-49a9e0be9a90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594025}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d96a62c4-445f-5a0f-be6a-6a822a55817d" :question/math-academy-id "q-148355" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{2x+{e}^{y}}{e}, & \\,0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{3e+1}{6e},\\,\\text{E}[Y]=\\frac{3}{2e},\\,\\text{SD}[X]≈0.2821,\\,\\text{SD}[Y]≈0.2870,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}xy\\cdot \\left(\\frac{2x+{e}^{y}}{e}\\right)\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{e}{\\int }_{0}^{1}[{\\int }_{0}^{1}(2{x}^{2}y+xy{e}^{y})\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{e}{\\int }_{0}^{1}{[\\frac{2}{3}{x}^{3}y+\\frac{1}{2}{x}^{2}y{e}^{y}]}_{x=0}^{x=1}\\text{d}y \\\\  & =\\frac{1}{e}{\\int }_{0}^{1}(\\frac{2}{3}y+\\frac{1}{2}y{e}^{y})\\,\\text{d}y \\\\  & =\\frac{1}{e}{[\\frac{1}{3}{y}^{2}+\\frac{1}{2}y{e}^{y}-\\frac{1}{2}{e}^{y}]}_{0}^{1} \\\\  & =\\frac{1}{e}(\\frac{1}{3}+\\frac{e}{2}-\\frac{e}{2}+\\frac{1}{2}) \\\\  & =\\frac{5}{6e}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{6e}-\\left(\\frac{3e+1}{6e}\\right)\\left(\\frac{3}{2e}\\right) \\\\  & =\\frac{e-3}{12{e}^{2}}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{\\left(\\frac{e-3}{12{e}^{2}}\\right)}{(0.2821)\\cdot (0.2870)} \\\\  & ≈-0.04,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186594229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155ba72f-3d7d-58c5-993f-1188c36455e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186593429} {:answer/id #uuid "30e28dec-fa23-5b7f-9951-fee0e5844de3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186593492} {:answer/id #uuid "3920bbbd-260b-58f8-936a-7e75927e44a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186593506} {:answer/id #uuid "7b592af0-5c74-5889-89a9-b3b159179d4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186593668} {:answer/id #uuid "bb54513e-d2d5-58b8-9412-15eed13734e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186593824}] :answer-field/correct {:db/id #edb/ref 17592186593668} :answer-field/id #uuid "5efc2d6a-f8ad-5667-a1ec-f91f444b3514" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594045}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "df202318-e036-5725-91a7-7b2e2e6925e3" :question/math-academy-id "q-143624" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}2x{e}^{y}, & \\,0\\le x\\le 1,0\\le y\\le \\operatorname{ln}⁡2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(X<Y\\,|\\,X=\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}y,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}2x{e}^{y}\\,\\text{d}y \\\\  & =2x{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{y}\\,\\text{d}y \\\\  & =2x{[{e}^{y}]}_{0}^{\\operatorname{ln}⁡2} \\\\  & =2x(2-1) \\\\  & =2x.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2x, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0<x<1,0<y<\\operatorname{ln}⁡2,$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{2x{e}^{y}}{2x} \\\\  & ={e}^{y}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}{e}^{y}, & \\,0\\le y\\le \\operatorname{ln}⁡2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(X<Y\\,|\\,X=\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)) & =P(\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)<Y\\,|\\,X=\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)) \\\\  & ={\\int }_{\\operatorname{ln}⁡(3/2)}^{\\operatorname{ln}⁡2}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right))\\text{d}y \\\\  & ={\\int }_{\\operatorname{ln}⁡(3/2)}^{\\operatorname{ln}⁡2}{e}^{y}\\,\\text{d}y \\\\  & ={[{e}^{y}]}_{\\operatorname{ln}⁡(3/2)}^{\\operatorname{ln}⁡2} \\\\  & =2-\\frac{3}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d95be1-9570-5a00-a102-d264aff4e1f2" :answer/type {:db/ident :answer.type/math} :answer/value "0.16" :db/id #edb/ref 17592186593437} {:answer/id #uuid "49bac261-ae12-51ff-8c42-c331e9bce4e3" :answer/type {:db/ident :answer.type/math} :answer/value "0.08" :db/id #edb/ref 17592186593557} {:answer/id #uuid "4e357132-43b8-5ae7-994c-39c13a13ac57" :answer/type {:db/ident :answer.type/math} :answer/value "0.18" :db/id #edb/ref 17592186593569} {:answer/id #uuid "82ac5fe2-3210-5b78-abfa-235c935b281e" :answer/type {:db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186593689} {:answer/id #uuid "d6eaf161-1e68-52ab-b429-22846c9e03fd" :answer/type {:db/ident :answer.type/math} :answer/value "0.12" :db/id #edb/ref 17592186593886}] :answer-field/correct {:db/id #edb/ref 17592186593557} :answer-field/id #uuid "e21b54d5-b641-576f-92cf-bde2d4c9f57c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594122}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8e3e751-672b-5965-af1d-da39efcbadf3" :question/math-academy-id "q-148334" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{xy+2}{4}, & \\,-1\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{1}{12},\\,\\text{E}[Y]=\\frac{1}{2},\\,\\text{SD}[X]≈0.5713,\\,\\text{SD}[Y]≈0.2887,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{1}[{\\int }_{0}^{1}xy\\cdot \\frac{xy+2}{4}\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-1}^{1}[{\\int }_{0}^{1}({x}^{2}{y}^{2}+2xy)\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-1}^{1}{[\\frac{{x}^{2}{y}^{3}}{3}+x{y}^{2}]}_{y=0}^{y=1}\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-1}^{1}(\\frac{{x}^{2}}{3}+x)\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{3}}{9}+\\frac{{x}^{2}}{2}]}_{-1}^{1} \\\\  & =\\frac{1}{4}[\\frac{1}{9}+\\frac{1}{2}-(-\\frac{1}{9}+\\frac{1}{2})] \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{1}{18}-\\left(\\frac{1}{12}\\right)\\left(\\frac{1}{2}\\right) \\\\  & =\\frac{1}{72}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{\\left(\\frac{1}{72}\\right)}{(0.5713)\\cdot (0.2887)} \\\\  & ≈0.08,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186594234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2adf7dc2-b121-5b2d-a09e-876fee16c458" :answer/type {:db/ident :answer.type/math} :answer/value "y(1-{x}^{4})" :db/id #edb/ref 17592186593481} {:answer/id #uuid "4c30ed16-d3fe-54a4-96d0-29778839ed94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2y}{1-{x}^{4}}" :db/id #edb/ref 17592186593561} {:answer/id #uuid "5676c57c-88a7-5e17-bad9-412cdebaa995" :answer/type {:db/ident :answer.type/math} :answer/value "xy(1-{x}^{4})" :db/id #edb/ref 17592186593585} {:answer/id #uuid "7645cc41-db55-5ec2-b263-2eb627b7bd82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{2(1-{x}^{4})}" :db/id #edb/ref 17592186593653} {:answer/id #uuid "9519fd2b-3db5-5c5e-b8fc-de56c98df6ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{1-{x}^{4}}" :db/id #edb/ref 17592186593739}] :answer-field/correct {:db/id #edb/ref 17592186593561} :answer-field/id #uuid "8b4583ae-8ad1-545d-860e-496b4f5437ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594073}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4a2e6a7-5117-5150-b7b8-3b6ab1df9427" :question/math-academy-id "q-143639" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{21{x}^{2}y}{2}, & \\,-1<x\\le 0,\\,{x}^{2}\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $-1<x\\le 0,\\,{x}^{2}\\le y\\le 1.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{{x}^{2}}^{1}\\frac{21{x}^{2}y}{2}\\,\\text{d}y \\\\  & =\\frac{21{x}^{2}}{2}{\\int }_{{x}^{2}}^{1}y\\,\\text{d}y \\\\  & =\\frac{21{x}^{2}}{2}\\cdot \\frac{{y}^{2}}{2}\\,{|}_{{x}^{2}}^{1} \\\\  & =\\frac{21{x}^{2}}{4}\\cdot (1-{x}^{4}) \\\\  & =\\frac{21{x}^{2}(1-{x}^{4})}{4}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{21{x}^{2}(1-{x}^{4})}{4}, & \\,-1<x\\le 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $-1<x\\le 0,\\,{x}^{2}\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\left(\\frac{21{x}^{2}y}{2}\\right)}{\\left(\\frac{21{x}^{2}(1-{x}^{4})}{4}\\right)} \\\\  & =\\frac{2y}{1-{x}^{4}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{1-{x}^{4}}, & \\,-1<x\\le 0,\\,{x}^{2}\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b07b60-926e-5752-89ce-7b5a5eeb3269" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186593390} {:answer/id #uuid "46696891-07a8-5095-b53b-be56920d5ce6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186593550} {:answer/id #uuid "8313a34d-eec8-52c5-b7ea-39138b4b0764" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{14}" :db/id #edb/ref 17592186593692} {:answer/id #uuid "83c5dff4-3b6d-596b-9e14-62c53ed43b3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{14}" :db/id #edb/ref 17592186593693} {:answer/id #uuid "d90ab71c-e77d-5600-b445-255796ab89c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186593891}] :answer-field/correct {:db/id #edb/ref 17592186593891} :answer-field/id #uuid "3b3d5e0d-4556-56ec-aa2c-d0e79fbc28b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594030}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4fcbf19-11d5-5c21-9516-e30e5bf38915" :question/math-academy-id "q-148404" :question/problem "Mike has a box with $7$ red LEGO blocks numbered from $1$ to $7$ and other $7$ blue LEGO blocks numbered from $8$ to $14.$ If Mike chooses a LEGO block at random, what is the probability that he picks a blue LEGO block?" :question/worked-solution "Let $X$ represent the number on the chosen LEGO block. From the problem statement, we know that $X∼U\\{1,2,…,14\\},$ and we wish to compute $P(8\\le X\\le 14).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{1,2,…,14\\},$ and the set $S$ has $|S|=14$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{14}, & x=1,2,…,14 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $8\\le X\\le 14$ are $8,9,10,11,12,13,14.$ There are $7$ of these items. Therefore,\n\n$$\nP(8\\le X\\le 14)=7\\cdot \\frac{1}{14}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186594238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fcfa4b7-c916-54c9-a953-58ca4ac1f19d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}+1}{2}" :db/id #edb/ref 17592186593450} {:answer/id #uuid "656295f1-ebd3-58c2-bb8c-765344439ab7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}{y}^{2}+1}{3({y}^{2}+1)}" :db/id #edb/ref 17592186593612} {:answer/id #uuid "68afc157-3036-5831-9789-faf8c13fd136" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3({x}^{2}{y}^{2}+1)}{{y}^{2}+3}" :db/id #edb/ref 17592186593620} {:answer/id #uuid "dca54d9d-a1e2-512e-8148-62f293d15c27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(xy+1)}{y+2}" :db/id #edb/ref 17592186593902} {:answer/id #uuid "fa4be62b-7ba9-5e60-84c4-1b7fda7634c3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}(xy+1)" :db/id #edb/ref 17592186593969}] :answer-field/correct {:db/id #edb/ref 17592186593620} :answer-field/id #uuid "69f8ff5d-95a8-5094-a7ea-98c2e2bfaffb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594056}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fcf706c6-7e10-5c3f-b0cf-d9c199f24a41" :question/math-academy-id "q-144945" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{9({x}^{2}{y}^{2}+1)}{16}, & 0\\le x\\le 1,\\,1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3({y}^{2}+3)}{16}, & 1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{Y}(y)$ are shown above. Find the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 1,\\,1\\le y\\le 2.$" :question/worked-solution "Recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 1,\\,1\\le y\\le 2,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{9({x}^{2}{y}^{2}+1)}{16}\\right)}{\\left(\\frac{3({y}^{2}+3)}{16}\\right)} \\\\  & =\\frac{3({x}^{2}{y}^{2}+1)}{{y}^{2}+3}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{3({x}^{2}{y}^{2}+1)}{{y}^{2}+3}, & 0\\le x\\le 1,\\,1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3df5fa9c-a5e1-508d-a181-de8c02678f82" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lim_{x\\to {0}^{-}}f(x)=2$ and $\\lim_{x\\to {(\\pi /2)}^{+}}f(x)=\\frac{\\pi }{2}$" :db/id #edb/ref 17592186594395} {:answer/id #uuid "544e3d16-e1ea-53ca-abbc-27231cee8114" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=\\lim_{x\\to {(\\pi /2)}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186594411} {:answer/id #uuid "6ff8ee0c-7102-53f1-8ec6-6a03f2d71611" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=\\text{DNE},\\,\\lim_{x\\to {(\\pi /2)}^{+}}f(x)=\\frac{\\pi }{2}" :db/id #edb/ref 17592186594437} {:answer/id #uuid "90063b1a-c6dc-543d-9114-77f15982ded7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=1,\\,\\lim_{x\\to {(\\pi /2)}^{+}}f(x)=0" :db/id #edb/ref 17592186594471} {:answer/id #uuid "d2a7a5f6-97d0-5b52-a441-39da29be536b" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=2,\\,\\lim_{x\\to {(\\pi /2)}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186594543}] :answer-field/correct {:db/id #edb/ref 17592186594395} :answer-field/id #uuid "d386df52-1c9a-54d0-984e-a271d6b24d38" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594650}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c84f753-589b-5ce1-9459-1771a16344eb" :question/math-academy-id "q-36697" :question/problem "Find $\\lim_{x\\to {0}^{-}}f(x)$ and $\\lim_{x\\to {(\\pi /2)}^{+}}f(x)$ for the function given by\n\n$$\nf(x)=\\{\\begin{aligned}2\\operatorname{sec}⁡x & \\text{ for }\\,-\\frac{\\pi }{2}<x<0 \\\\ \\operatorname{cot}⁡x+x & \\text{ for }\\,\\frac{\\pi }{2}\\le x<\\pi .\\end{aligned}\n$$" :question/worked-solution "Approaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=2\\operatorname{sec}⁡x.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{-}}2\\operatorname{sec}⁡x \\\\  & =2\\operatorname{sec}⁡0 \\\\  & =2(1) \\\\  & =2.\\end{aligned}\n$$\n\nApproaching $x=\\frac{\\pi }{2}$ from the right, we have $x>\\frac{\\pi }{2},$ so we use the expression $f(x)=\\operatorname{cot}⁡x+x.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {(\\pi /2)}^{+}}f(x) & =\\lim_{x\\to {(\\pi /2)}^{+}}(\\operatorname{cot}⁡x+x) \\\\  & =\\operatorname{cot}⁡\\left(\\frac{\\pi }{2}\\right)+\\frac{\\pi }{2} \\\\  & =0+\\frac{\\pi }{2} \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6eea7866-5af5-5eac-9c7d-9570dbc715c8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186594434}] :answer-field/correct {:db/id #edb/ref 17592186594434} :answer-field/id #uuid "8c359556-5f0b-5f99-b43e-22f9ba1df4d6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594629}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94c3f77e-19f9-57a5-ad10-3a09e905fba0" :question/math-academy-id "q-302093" :question/problem "Find the right-sided limit at $x=2$ for the function\n\n$$\nf(x)=\\{\\begin{aligned}{x}^{4}-16\\, & \\text{ for }\\,x\\le 2 \\\\ \\sqrt{2x+5}-\\sqrt{2x}\\, & \\text{ for }\\,x>2.\\end{aligned}\n$$\n\n$$\n\\lim_{x\\to {2}^{+}}f(x)=\n$$\n{{field-1}}" :question/worked-solution "Approaching from the right, we have $x>2,$ so we use the expression $f(x)=\\sqrt{2x+5}-\\sqrt{2x}.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{+}}f(x) & =\\lim_{x\\to {2}^{+}}(\\sqrt{2x+5}-\\sqrt{2x}) \\\\  & =\\sqrt{(2\\cdot 2)+5}-\\sqrt{2\\cdot 2} \\\\  & =\\sqrt{9}-\\sqrt{4} \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d0147a7-0d5d-5c1f-a98f-5a4b9a122e8b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186594416} {:answer/id #uuid "70114d54-278a-5b22-ae1f-646a78c427cf" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186594438} {:answer/id #uuid "70e1033f-fcf9-593f-af72-a2c812371adb" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186594440} {:answer/id #uuid "e4964eca-7438-563e-9f11-6b1050519016" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186594561} {:answer/id #uuid "f21ac1e4-411c-5e95-a353-aea07881bbe9" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186594575}] :answer-field/correct {:db/id #edb/ref 17592186594561} :answer-field/id #uuid "dfe1c40e-f769-5a17-b233-2d2ba771bf66" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594654}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ca8a3dd5-f4ee-5b3b-bff7-8a83e07ba125" :question/math-academy-id "q-80570" :question/problem "Let $D$ be a finite region enclosed by the curve ${x}^{2}+\\frac{{y}^{2}}{16}=1.$ If $R=[-1,1]\\times [-4,4],$ and\n\n$$\n{∬}_{D}|{x}^{3}y-{y}^{2}|\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $$\n\\displaystyle \\{\\begin{aligned}0, & (x,y)\\in D∖R \\\\ |{x}^{3}y-{y}^{2}|, & (x,y)\\in R∖D\\end{aligned}\n$$\n\nII. $$\n\\displaystyle \\{\\begin{aligned}|{x}^{3}y-{y}^{2}|, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}\n$$\n\nIII. $$\n\\displaystyle \\{\\begin{aligned}|{x}^{3}y-{y}^{2}|, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$" :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/3f/3fe53f71501bccf9bc2c6bb4144a63d9cf1614ef229b5ca3b640fcf130968fd2.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $|{x}^{3}y-{y}^{2}|$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}|{x}^{3}y-{y}^{2}|\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions II and III equal $|{x}^{3}y-{y}^{2}|$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function I. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,4)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186594725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "619ba8f0-d522-5f2f-aa49-1bffc6592afd" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186594425} {:answer/id #uuid "8343f068-8fce-5793-a987-e500e3eabd76" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186594460} {:answer/id #uuid "c2ff07c1-f8ed-5073-9c5d-a8e643b924fc" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186594523} {:answer/id #uuid "c980e977-32a2-5e25-96a0-23346f43d712" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186594532} {:answer/id #uuid "f9926336-3411-5e84-9a3e-f513185b69cc" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186594586}] :answer-field/correct {:db/id #edb/ref 17592186594460} :answer-field/id #uuid "b865c934-bcca-57ae-a717-9b9291098d65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594642}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f1dac8e6-80ac-5844-8f29-38963e5758f6" :question/math-academy-id "q-86893" :question/problem "Let $D$ be a finite region enclosed by the curves $y={x}^{2}$ and $y=3-|x|.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{3}+{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. $$\n\\displaystyle {∬}_{D}({x}^{3}+{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-2,2]\\times [0,3]$\n\nII. $$\n\\displaystyle {∬}_{R}({x}^{3}+{y}^{3})\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-2,2]\\times [1,3]$\n\nIII. $$\n\\displaystyle {∬}_{D}({x}^{3}+{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-1,1]\\times [0,3]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/01/012c298cc2defbf82e240f266f94733cdcd8e579ad10535eb94f33becf528b8d.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{3}+{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{3}+{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is true. Indeed, the rectangle $R$ covers the region $D$ completely.\n\n- Statement II is false. The rectangle $R$ does not cover the region $D.$ Also, the integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement III is false. The rectangle $R$ does not completely cover the region $D.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186595919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "848708c2-cd82-52ca-afdf-1c3cdb652e1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186595268} {:answer/id #uuid "8f4de34d-88b7-53e9-8f49-0ce3d770c328" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186595306} {:answer/id #uuid "925483b8-a0fa-5b5c-a802-cbafb77e5c8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186595317} {:answer/id #uuid "f9ce1071-561b-5e38-bc6c-7f987e52eba4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186595662} {:answer/id #uuid "fd52bb59-3d76-5198-9b11-13e105e5f6e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186595673}] :answer-field/correct {:db/id #edb/ref 17592186595306} :answer-field/id #uuid "e7de609e-d993-5e3e-b4a4-15f698027135" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595890}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "04c9a043-611c-5f87-ba09-184f6bf9d6c0" :question/math-academy-id "q-143354" :question/problem "Let $X$ and $Y$ be two independent continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{9}x, & \\,0\\le x\\le 3, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\operatorname{sin}⁡y, & \\,0\\le y\\le \\frac{\\pi }{2}, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X\\le 2,Y\\le 3).$" :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{2}{9}x\\cdot \\operatorname{sin}⁡y \\\\  & =\\frac{2}{9}x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,3]\\times [0,\\frac{\\pi }{2}].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{9}x\\operatorname{sin}⁡y, & \\,0\\le x\\le 3,\\,0\\le y\\le \\frac{\\pi }{2} \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 2,Y\\le 3) & ={\\int }_{0}^{2}[{\\int }_{0}^{\\pi /2}\\frac{2}{9}x\\operatorname{sin}⁡y\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{2}{9}x[-\\operatorname{cos}⁡y]_{0}^{\\pi /2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{2}{9}x\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{9}]}_{0}^{2} \\\\  & =\\frac{(2)^{2}}{9}-0 \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3bad9e7-ba7b-5e7f-9ec4-8ee827e9bd0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186595438} {:answer/id #uuid "d5eb5c54-d0cf-5285-837b-aef2413ff57d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186595538} {:answer/id #uuid "d7b64ca1-e102-5eee-86bd-4b8736b438b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186595545} {:answer/id #uuid "d8168b3d-0589-56ea-b13c-fdcc568bc169" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186595546} {:answer/id #uuid "f9c659c4-cf17-57f8-a959-83e8191a92b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186595661}] :answer-field/correct {:db/id #edb/ref 17592186595538} :answer-field/id #uuid "8feed906-a622-5b1f-8a45-11b12635aab8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595812}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0c28a44d-b3f9-5ffa-b220-06f365490293" :question/math-academy-id "q-143575" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2y}{(x+1)^{2}}, & x\\ge 0,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $Y.$" :question/worked-solution "The marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\infty }\\frac{2y}{(x+1)^{2}}\\,\\text{d}x \\\\  & =2y\\lim_{b\\to \\infty }{\\int }_{0}^{b}\\frac{1}{(x+1)^{2}}\\,\\text{d}x \\\\  & =2y\\lim_{b\\to \\infty }{[-\\frac{1}{(x+1)}]}_{0}^{b} \\\\  & =2y\\lim_{b\\to \\infty }(1-\\frac{1}{b+1}) \\\\  & =2y.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}2y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\cdot {f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot 2y\\,\\text{d}y \\\\  & =2{\\int }_{0}^{1}{y}^{2}\\,\\text{d}y \\\\  & =2{[\\frac{{y}^{3}}{3}]}_{0}^{1} \\\\  & =2(\\frac{1}{3}-0) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0176aae3-fbd8-59e0-9df0-a3b64b394fb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}(1-\\frac{1}{{e}^{2}})" :db/id #edb/ref 17592186594824} {:answer/id #uuid "42cb5eaa-97b1-5c1c-b2af-a9814494adfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}(1-\\frac{1}{e})" :db/id #edb/ref 17592186595033} {:answer/id #uuid "a0f13974-65fe-52a8-9d21-dab7f5133af1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}(1-\\frac{1}{{e}^{4}})" :db/id #edb/ref 17592186595378} {:answer/id #uuid "c15f75c2-a87d-5b36-a4b1-2d2502965c3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}(1-\\frac{1}{e})" :db/id #edb/ref 17592186595478} {:answer/id #uuid "dd597b33-8f38-5674-81dd-eedae7a839b5" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186595562}] :answer-field/correct {:db/id #edb/ref 17592186594824} :answer-field/id #uuid "ccb7967e-0bc0-5ce0-99ae-3b3135ec07ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595870}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f04e9c4-e396-5f9c-afd4-215de687a8b2" :question/math-academy-id "q-143353" :question/problem "Let $X$ and $Y$ be two independent continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2{e}^{-2x}, & \\,0\\le x, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{4}y, & \\,1\\le y\\le 3, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X\\le 1,Y\\le 2).$" :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =2{e}^{-2x}\\cdot \\frac{1}{4}y \\\\  & =\\frac{1}{2}y{e}^{-2x},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,\\infty )\\times [1,3].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}y{e}^{-2x}, & \\,0\\le x,\\,1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 1,Y\\le 2) & ={\\int }_{0}^{1}[{\\int }_{1}^{2}\\frac{1}{2}y{e}^{-2x}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{2}{e}^{-2x}{[\\frac{{y}^{2}}{2}]}_{1}^{2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{4}{e}^{-2x}\\,\\text{d}x \\\\  & ={[-\\frac{3{e}^{-2x}}{8}]}_{0}^{1} \\\\  & =-\\frac{3{e}^{-2}}{8}-\\left(-\\frac{3}{8}\\right) \\\\  & =\\frac{3}{8}(1-\\frac{1}{{e}^{2}}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f76594c-2130-5267-aee6-f5ce43abacb2" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{2}{3}({x}^{2}-1){e}^{y}, & \\,2\\le x\\le 3,\\,0\\le y\\le \\operatorname{ln}⁡3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595242} {:answer/id #uuid "b5ee09f9-a9d5-505b-bd37-4ea359a7ef9a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{3}(x-1){e}^{y}, & \\,2\\le x\\le 3,\\,0\\le y\\le \\operatorname{ln}⁡3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595448} {:answer/id #uuid "b995666f-b7b4-5bdd-a2be-8001ac411be8" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{2}{3}(2x-1){e}^{y}, & \\,2\\le x\\le 3,\\,0\\le y\\le \\operatorname{ln}⁡3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595456} {:answer/id #uuid "f291c2bc-7091-5ef4-a2c0-cd42d5822d8e" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine using only the given information." :db/id #edb/ref 17592186595635} {:answer/id #uuid "f6fb5183-da01-53cb-8e78-f481f920886b" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{3}(y-1){e}^{x}, & \\,2\\le x\\le 3,\\,0\\le y\\le \\operatorname{ln}⁡3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595647}] :answer-field/correct {:db/id #edb/ref 17592186595635} :answer-field/id #uuid "567aaa50-2b09-5fbe-a513-743444efe8bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595769}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "27c8be0c-65fe-5f8e-818d-93dfca5e16bf" :question/math-academy-id "q-143349" :question/problem "Let $X$ and $Y$ be two continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{3}(x-1), & \\,2\\le x\\le 3, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{y}, & \\,0\\le y\\le \\operatorname{ln}⁡3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the joint probability density function $f(x,y).$\n\n*Hint: We do not know if $X$ and $Y$ are independent.*" :question/worked-solution "Since we don't know whether $X$ and $Y$ are independent, it is impossible to determine the joint distribution of $X$ and $Y$ using only the given information."}] [{:db/id #edb/ref 17592186595931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025e1656-6569-5f0c-9d35-4a9649c68ca3" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186594828} {:answer/id #uuid "14ee30f9-28fa-530a-8b4d-4c886737d5cb" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements is true" :db/id #edb/ref 17592186594893} {:answer/id #uuid "1740426b-af3f-5e9d-8369-e133f777e9ef" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186594898} {:answer/id #uuid "22ae26c9-9596-5e48-b396-13624a4a9305" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186594938} {:answer/id #uuid "f6f8070c-ef96-5a04-af85-c1b407db7136" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186595646}] :answer-field/correct {:db/id #edb/ref 17592186594893} :answer-field/id #uuid "99fc683c-02f9-5242-8b60-47d1be9066c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595818}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "315fb257-a450-57a3-a9b4-d26ab05eaa97" :question/math-academy-id "q-143385" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{3}(1+xy),\\, & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{Y}(y)=\\frac{y+1}{3}$ for $y\\in [0,2]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}\\frac{1}{3}(1+xy)\\,\\text{d}x \\\\  & =\\frac{1}{3}{[x+\\frac{y{x}^{2}}{2}]}_{x=0}^{x=1} \\\\  & =\\frac{1}{3}(1+\\frac{y}{2}-0) \\\\  & =\\frac{y+2}{6},\\end{aligned}\n$$\n\n \nwhere $y\\in [0,2].$\n\n- Statement II is false. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{2}\\frac{1}{3}(1+xy)\\,\\text{d}y \\\\  & =\\frac{1}{3}{[y+\\frac{x{y}^{2}}{2}]}_{y=0}^{y=2} \\\\  & =\\frac{1}{3}(2+2x-0) \\\\  & =\\frac{2(x+1)}{3},\\end{aligned}\n$$\n\n \nwhere $x\\in [0,1].$ So, when $x\\in [0,1]$ and $y\\in [0,2],$ we obtain that \n\n$$\n{{\\frac{1}{3}(1+xy)}_{⏟}}_{f(x,y)}\\ne {{\\left(\\frac{2(x+1)}{3}\\right)}_{⏟}}_{{f}_{X}(x)}\\cdot {{\\left(\\frac{y+2}{6}\\right)}_{⏟}}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is false. Since statement II is *not* true, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of the statements is true.\""}] [{:db/id #edb/ref 17592186595933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8b9993-09f3-5cf6-88a6-32ffe73f8e9f" :answer/type {:db/ident :answer.type/text} :answer/value "None of these listed" :db/id #edb/ref 17592186594856} {:answer/id #uuid "88b140c8-a9a5-52fa-b11d-c916c6d28667" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186595282} {:answer/id #uuid "a92a52f2-d7bc-5f41-acb1-5fb8d8129d0e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186595408} {:answer/id #uuid "ac4758c4-b39d-5c64-9d71-9707104665d2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186595418} {:answer/id #uuid "be390658-2eba-563e-878c-cc136e1c4d77" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186595470}] :answer-field/correct {:db/id #edb/ref 17592186595470} :answer-field/id #uuid "12866dfa-998d-5041-843f-9c40a816ca92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595713}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "35a93a7d-8bc4-5627-9377-9c1f52685da9" :question/math-academy-id "q-143389" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{10}({x}^{2}+{y}^{2}),\\, & 0\\le x\\le 1,\\,0\\le y\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. $$\n\\displaystyle {f}_{Y}(y)=\\frac{1}{10}{y}^{2}+\\frac{1}{30}\n$$ for $y\\in [0,3]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}\\frac{1}{10}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{10}{[\\frac{1}{3}{x}^{3}+{y}^{2}x]}_{x=0}^{x=1} \\\\  & =\\frac{1}{10}[\\frac{1}{3}+{y}^{2}] \\\\  & =\\frac{1}{10}{y}^{2}+\\frac{1}{30},\\end{aligned}\n$$\n\n \nwhere $y\\in [0,3].$\n\n- Statement II is false. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{3}\\frac{1}{10}({x}^{2}+{y}^{2})\\,\\text{d}y \\\\  & =\\frac{1}{10}{[{x}^{2}y+\\frac{{y}^{3}}{3}]}_{y=0}^{y=3} \\\\  & =\\frac{1}{10}[3{x}^{2}+9] \\\\  & =\\frac{3}{10}{x}^{2}+\\frac{9}{10},\\end{aligned}\n$$\n\n \nwhere $x\\in [0,1].$ So, when $x\\in [0,1]$ and $y\\in [0,3],$ we obtain that \n\n$$\n{{\\frac{1}{10}({x}^{2}+{y}^{2})}_{⏟}}_{f(x,y)}\\ne {{(\\frac{3}{10}{x}^{2}+\\frac{9}{10})}_{⏟}}_{{f}_{X}(x)}\\cdot {{(\\frac{1}{10}{y}^{2}+\\frac{1}{30})}_{⏟}}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is false. Since statement II is *not* true, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186595936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2477ece8-3c93-5cf3-a027-6e1d994ee810" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186594944} {:answer/id #uuid "9d9641fd-6a99-52d2-a038-a27c8a92dab7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186595362} {:answer/id #uuid "ab568d44-e083-51ac-8c33-3b2d43a1748b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186595414} {:answer/id #uuid "ae6b2b8b-e68e-5c37-805a-0082a4f68233" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186595424} {:answer/id #uuid "f1d94898-3a0a-52c4-b554-9228db1d7e0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186595631}] :answer-field/correct {:db/id #edb/ref 17592186595414} :answer-field/id #uuid "fa3a7747-9a93-5b74-ad4d-770bdac2d761" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595916}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f3bef0c-4220-5154-b108-6ceab0c1664b" :question/math-academy-id "q-143370" :question/problem "Let $X$ and $Y$ be two independent continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{4}(x+1), & \\,0\\le x\\le 2, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2}\\sqrt{y}, & \\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X\\le 1,Y\\le 1).$" :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{1}{4}(x+1)\\cdot \\frac{3}{2}\\sqrt{y} \\\\  & =\\frac{3}{8}(x+1)\\sqrt{y},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,2]\\times [0,1].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{8}(x+1)\\sqrt{y}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 1,Y\\le 1) & ={\\int }_{0}^{1}[{\\int }_{0}^{1}\\frac{3}{8}(x+1)\\sqrt{y}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3(x+1)}{8}{[\\frac{2}{3}\\sqrt{{y}^{3}}]}_{0}^{1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{4}(x+1)\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{8}+\\frac{x}{4}]}_{0}^{1} \\\\  & =(\\frac{1}{8}+\\frac{1}{4})-0 \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b1adcb8-fd8b-53d1-9954-4786bdf93004" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186595058} {:answer/id #uuid "65e73041-422d-53ee-a459-7a2b185dcfb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186595151} {:answer/id #uuid "7594b756-5905-541e-89d5-f2f5892eb46e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186595207} {:answer/id #uuid "a878f824-d3cc-5659-8286-97fb2ccc459f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186595406} {:answer/id #uuid "fa92dbcd-2345-5e7c-9bee-7a4587ffb5ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186595665}] :answer-field/correct {:db/id #edb/ref 17592186595207} :answer-field/id #uuid "49d7ce98-635e-5120-a003-0bef6d37cb22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595753}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "511a04fd-28b5-5b53-b5fd-2cb1754e48d0" :question/math-academy-id "q-143360" :question/problem "Let $X$ and $Y$ be two independent continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3}{4}\\sqrt{\\frac{x}{2}}, & \\,0\\le x\\le 2, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{8}{e}^{y}, & \\,0\\le y\\le \\operatorname{ln}⁡9, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X\\le 1,0\\le Y\\le \\operatorname{ln}⁡9).$" :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{3}{4}\\sqrt{\\frac{x}{2}}\\cdot \\frac{1}{8}{e}^{y} \\\\  & =\\frac{3}{32}{e}^{y}\\sqrt{\\frac{x}{2}},\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,2]\\times [0,\\operatorname{ln}⁡9].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{32}{e}^{y}\\sqrt{\\frac{x}{2}}, & \\,0\\le x\\le 2,\\,0\\le y\\le \\operatorname{ln}⁡9 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\n$$\n\nFinally, the required probability is\n\n$$\n\\begin{aligned}P(X\\le 1,0\\le Y\\le \\operatorname{ln}⁡9) & ={\\int }_{0}^{1}[{\\int }_{0}^{\\operatorname{ln}⁡9}\\frac{3}{32}{e}^{y}\\sqrt{\\frac{x}{2}}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{32}\\sqrt{\\frac{x}{2}}[{e}^{y}]_{0}^{\\operatorname{ln}⁡9}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{4}\\sqrt{\\frac{x}{2}}\\,\\text{d}x \\\\  & ={[\\frac{1}{2\\sqrt{2}}\\sqrt{{x}^{3}}]}_{0}^{1} \\\\  & =\\frac{1}{2\\sqrt{2}}-0 \\\\  & =\\frac{\\sqrt{2}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c206f5-521d-5fc5-846f-aaeb7ac83a66" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{5}{x}^{3}(y+2), & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186594877} {:answer/id #uuid "138de91e-b2cd-5891-8e3b-fbb8cee68248" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{10}{x}^{3}(y+2), & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186594887} {:answer/id #uuid "1abe4581-163f-52ab-b253-03b015325c87" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{5}({x}^{3}-y), & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186594915} {:answer/id #uuid "8089c8fb-c451-57da-ae1e-06193c395f2e" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine using only the given information." :db/id #edb/ref 17592186595249} {:answer/id #uuid "9379fded-8ac5-558f-995e-3d043d371bda" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{10}{x}^{2}y, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595325}] :answer-field/correct {:db/id #edb/ref 17592186595249} :answer-field/id #uuid "f72c53a5-9604-53d2-8cb8-1d9f054402a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "51ee8559-018f-5381-b006-a432639d178e" :question/math-academy-id "q-143346" :question/problem "Let $X$ and $Y$ be two continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{4}\\,{x}^{3}, & \\,0\\le x\\le 2, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{5}(y+2), & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the joint probability density function $f(x,y).$\n\n*Hint: We do not know if $X$ and $Y$ are independent.*" :question/worked-solution "Since we don't know whether $X$ and $Y$ are independent, it is impossible to determine the joint distribution of $X$ and $Y$ using only the given information."}] [{:db/id #edb/ref 17592186595958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7ae38f-ab98-512e-85de-9299d5097713" :answer/type {:db/ident :answer.type/math} :answer/value "\\{2\\}" :db/id #edb/ref 17592186594872} {:answer/id #uuid "1cbee373-9793-5c99-845e-2eb28a4863ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\{2,4,5\\}" :db/id #edb/ref 17592186594923} {:answer/id #uuid "2ffcfd93-fdee-53de-92a7-a2e1554ac088" :answer/type {:db/ident :answer.type/math} :answer/value "\\{2,3\\}" :db/id #edb/ref 17592186594977} {:answer/id #uuid "d09e437c-84d7-5f3d-afda-e60f0b090f78" :answer/type {:db/ident :answer.type/math} :answer/value "\\{1,4\\}" :db/id #edb/ref 17592186595522} {:answer/id #uuid "e46fb443-b3de-5432-b05f-00ccbd024ef9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{1,4,5\\}" :db/id #edb/ref 17592186595584}] :answer-field/correct {:db/id #edb/ref 17592186594977} :answer-field/id #uuid "a71b8623-3c86-559b-9916-3956bb45d788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595839}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7c882e01-5763-5986-83e7-9b0a2a5ec12d" :question/math-academy-id "q-174357" :question/problem "![](images/90/908a7c34818915cc0cf1709f82d0b705b843b57ac4e437eb5208748c6f9161a9.png)\n\nWhich of the following is the subset $A$ of $U=\\{1,2,3,4\\}$ whose indicator function ${1}_{A}(x)$ is shown above?" :question/worked-solution "An indicator function maps elements from a set to the values $0$ or $1,$ depending on whether the element belongs to a specified subset. The indicator function is designed to \"indicate\" whether an element is a member of a subset.\n\nMore specifically, consider a universal set $X.$ Then, the indicator function of a set $A⊆X$ is the function\n\n$$\n{1}_{A}(x)=\\{\\begin{aligned}1, & \\text{if }x\\in A, \\\\ 0, & \\text{if }x\\notin A.\\end{aligned}\n$$\n\nIn the diagram above, only the elements $2$ and $3$ are mapped to $1.$ Therefore, the indicator function in the diagram above corresponds to the set $A=\\{2,3\\}.$"}] [{:db/id #edb/ref 17592186595962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08911307-498e-557d-b69f-4c4a6f366299" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186594845} {:answer/id #uuid "7434c3a2-d090-54c9-93bb-ac56038eccc9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186595204} {:answer/id #uuid "8bcbbcb1-4f96-5529-81f1-009860e973c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186595291} {:answer/id #uuid "981c7d7f-752a-5f9e-8826-61c574abd52f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186595349} {:answer/id #uuid "bd68ecf2-51d1-5121-88f9-adc4454785ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186595463}] :answer-field/correct {:db/id #edb/ref 17592186595204} :answer-field/id #uuid "63b1a33b-ccee-5108-91bf-b5da0f45bda8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595777}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8043a273-a319-5370-970a-271d28c684d7" :question/math-academy-id "q-143585" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}, & 0\\le x\\le 1,\\,0\\le y\\le 3, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[Y]=\\frac{3}{2},$ find $\\text{E}[2Y-4X].$" :question/worked-solution "We're given $\\text{E}[Y].$ So, we first need to compute $\\text{E}[X].$\n\nThe marginal density function for $X$ when $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}{x}^{2}\\,\\text{d}y \\\\  & =[{x}^{2}y]_{y=0}^{y=3} \\\\  & =3{x}^{2}-0 \\\\  & =3{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{1}{x}^{3}\\,\\text{d}x \\\\  & =3{[\\frac{{x}^{4}}{4}]}_{0}^{1} \\\\  & =3(\\frac{1}{4}-0) \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[2Y-4X] & =2\\,\\text{E}[Y]+(-4)\\,\\text{E}[X] \\\\  & =2\\,\\left(\\frac{3}{2}\\right)-4\\left(\\frac{3}{4}\\right) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02255f96-c42e-578e-870b-69261aa70626" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements is true" :db/id #edb/ref 17592186594826} {:answer/id #uuid "34fafad2-ce97-573c-80a7-f2d04ffcdef7" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186594989} {:answer/id #uuid "402ea738-302d-5168-943e-cad9a0496ac7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186595024} {:answer/id #uuid "96c72117-5d39-5c9e-8f0c-8df2fa7bba89" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186595343} {:answer/id #uuid "f8730e27-4bfa-52b8-8dfc-6113e4acf205" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186595653}] :answer-field/correct {:db/id #edb/ref 17592186594826} :answer-field/id #uuid "a5e7d411-235f-5db3-8199-89400f7730ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595838}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "90221e5f-e86e-53c2-ae31-0642a68abcc4" :question/math-academy-id "q-143388" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}x+\\frac{3}{2}{y}^{2},\\, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{X}(x)=\\frac{3}{2}x+1$ for $y\\in [0,1]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}(x+\\frac{3}{2}{y}^{2})\\,\\text{d}y \\\\  & ={[xy+\\frac{{y}^{3}}{2}]}_{y=0}^{y=1} \\\\  & =x+\\frac{1}{2},\\end{aligned}\n$$\n\n \nwhere $x\\in [0,1].$\n\n- Statement II is false. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}(x+\\frac{3}{2}{y}^{2})\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{2}+\\frac{3}{2}x{y}^{2}]}_{x=0}^{x=1} \\\\  & =\\frac{3}{2}{y}^{2}+\\frac{1}{2},\\end{aligned}\n$$\n\n \nwhere $y\\in [0,1].$ So, when $x\\in [0,1]$ and $y\\in [0,1],$ we obtain that \n\n$$\n{{x+\\frac{3}{2}{y}^{2}}_{⏟}}_{f(x,y)}\\ne {{(x+\\frac{1}{2})}_{⏟}}_{{f}_{X}(x)}\\cdot {{(\\frac{3}{2}{y}^{2}+\\frac{1}{2})}_{⏟}}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is false. Since statement II is *not* true, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of the statements is true.\""}] [{:db/id #edb/ref 17592186595966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ef6c2b1-d83a-5628-8a2a-6f40049fd638" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186595072} {:answer/id #uuid "586f5e4e-178e-57a7-88ab-9195f9a564e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186595107} {:answer/id #uuid "66567a3d-a46a-50b7-8123-9beaa0735424" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186595152} {:answer/id #uuid "763e1ab5-11d5-542c-ad11-60a88e54507c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186595208} {:answer/id #uuid "f42ed87f-f2ca-5507-a320-1a7d8156321f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186595638}] :answer-field/correct {:db/id #edb/ref 17592186595152} :answer-field/id #uuid "a80b143e-2961-5879-ab42-ee41f4963ee7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595842}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93ebdec3-2f38-57e1-aa0d-9e37c1dd24af" :question/math-academy-id "q-149615" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{x{y}^{2}+2}{6}, & 2\\le x\\le 4,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $Y.$" :question/worked-solution "The marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{2}^{4}\\frac{x{y}^{2}+2}{6}\\,\\text{d}x \\\\  & =\\frac{1}{6}{[\\frac{1}{2}{x}^{2}{y}^{2}+2x]}_{x=2}^{x=4} \\\\  & =\\frac{1}{6}(8{y}^{2}+8-2{y}^{2}-4) \\\\  & =\\frac{1}{6}(6{y}^{2}+4) \\\\  & ={y}^{2}+\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}{y}^{2}+\\frac{2}{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot ({y}^{2}+\\frac{2}{3})\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{3}+\\frac{2}{3}y)\\,\\text{d}y \\\\  & ={[\\frac{1}{4}{y}^{4}+\\frac{1}{3}{y}^{2}]}_{0}^{1} \\\\  & =\\frac{1}{4}+\\frac{1}{3} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fbeb17-eb8b-5aca-a238-58456a5629e1" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186594837} {:answer/id #uuid "27914434-01fb-5182-bc3c-2c19d36fcd5b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186594954} {:answer/id #uuid "8dd48263-94b8-50b6-9caf-bfb561e70e28" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186595298} {:answer/id #uuid "927c6009-3b5a-522e-b280-fb01e5c2ae73" :answer/type {:db/ident :answer.type/text} :answer/value "None of these listed" :db/id #edb/ref 17592186595318} {:answer/id #uuid "eb4ecd5e-82bc-55af-b4cb-45f004ba1a7b" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186595614}] :answer-field/correct {:db/id #edb/ref 17592186594837} :answer-field/id #uuid "e655539c-b5d7-50a5-8e05-7900c9b5ae45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595888}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9d3d4a73-195c-50d5-aa56-25097c87405a" :question/math-academy-id "q-143386" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}+\\frac{1}{3}xy,\\, & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{X}(x)=2{x}^{2}+\\frac{2}{3}x$ for $x\\in [0,1]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{2}({x}^{2}+\\frac{1}{3}xy)\\,\\text{d}y \\\\  & ={[{x}^{2}y+\\frac{x{y}^{2}}{6}]}_{y=0}^{y=2} \\\\  & =2{x}^{2}+\\frac{2}{3}x,\\end{aligned}\n$$\n\n \nwhere $x\\in [0,1].$\n\n- Statement II is false. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}({x}^{2}+\\frac{1}{3}xy)\\,\\text{d}x \\\\  & ={[\\frac{{x}^{3}}{3}+\\frac{{x}^{2}y}{6}]}_{x=0}^{x=1} \\\\  & =\\frac{y}{6}+\\frac{1}{3},\\end{aligned}\n$$\n\n \nwhere $y\\in [0,2].$ So, when $x\\in [0,1]$ and $y\\in [0,2],$ we obtain that \n\n$$\n{{{x}^{2}+\\frac{1}{3}xy}_{⏟}}_{f(x,y)}\\ne {{(2{x}^{2}+\\frac{2}{3}x)}_{⏟}}_{{f}_{X}(x)}\\cdot {{(\\frac{y}{6}+\\frac{1}{3})}_{⏟}}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is false. Since statement II is *not* true, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186595971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6450f841-a9a9-5d22-921d-6719744bf2cc" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}5{x}^{4}\\operatorname{cos}⁡y, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595142} {:answer/id #uuid "77687661-0caa-5b50-9d78-722dd5445389" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine using only the given information." :db/id #edb/ref 17592186595213} {:answer/id #uuid "8472f7ac-04ea-59e4-a517-559d674435ba" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}5{y}^{4}\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595267} {:answer/id #uuid "c071bb9d-dd61-5340-aa5e-b7504326cbb7" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}{y}^{4}\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595477} {:answer/id #uuid "e6dec252-80ac-5c08-8409-4d4bd20da3b2" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{5}y\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595594}] :answer-field/correct {:db/id #edb/ref 17592186595213} :answer-field/id #uuid "e73a4836-2ab2-59c1-82a8-51df994c1d5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595889}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5663210-166c-575e-a73a-5c3e9ef797ff" :question/math-academy-id "q-143350" :question/problem "Let $X$ and $Y$ be two continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}5{y}^{4}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the joint probability density function $f(x,y).$\n\n*Hint: We do not know if $X$ and $Y$ are independent.*" :question/worked-solution "Since we don't know whether $X$ and $Y$ are independent, it is impossible to determine the joint distribution of $X$ and $Y$ using only the given information."}] [{:db/id #edb/ref 17592186595983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71f70d71-f63c-5688-8c84-54226f9ebaa7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186595199} {:answer/id #uuid "8e2753ed-6020-58ca-8fd5-5ab32e415bd3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186595300} {:answer/id #uuid "9422b22a-7d41-531d-bd64-911f7df646e4" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186595333} {:answer/id #uuid "cde51ebe-e49a-54b4-b97c-be292f2dd2e0" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186595511} {:answer/id #uuid "f7a37ca6-5f48-5093-90fb-ca35fdfc8707" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186595651}] :answer-field/correct {:db/id #edb/ref 17592186595511} :answer-field/id #uuid "7a4a3775-ac79-5dc8-bdf9-104c2bd2fa2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595794}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b998e3d7-f028-58c7-9b16-e457db5aac0b" :question/math-academy-id "q-143382" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}x\\operatorname{sin}⁡y,\\, & 0\\le x\\le 2,\\,0\\le y\\le \\frac{\\pi }{2}, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{Y}(y)=\\operatorname{sin}⁡y$ for $y\\in [0,\\frac{\\pi }{2}]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{2}\\frac{1}{2}x\\operatorname{sin}⁡y\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡y{[\\frac{{x}^{2}}{2}]}_{0}^{2} \\\\  & =\\operatorname{sin}⁡y,\\end{aligned}\n$$\n\n \nwhere $y\\in [0,\\frac{\\pi }{2}].$\n\n- Statement II is true. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}x\\operatorname{sin}⁡y\\,\\text{d}y \\\\  & =\\frac{1}{2}x[-\\operatorname{cos}⁡y]_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}x,\\end{aligned}\n$$\n\n \nwhere $x\\in [0,2].$ So, when $x\\in [0,2]$ and $y\\in [0,\\frac{\\pi }{2}],$ we obtain that \n\n$$\n{{\\frac{1}{2}x\\operatorname{sin}⁡y}_{⏟}}_{f(x,y)}={{(\\frac{1}{2}x)}_{⏟}}_{{f}_{X}(x)}\\cdot {{(\\operatorname{sin}⁡y)}_{⏟}}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ are independent.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186595989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff5824e-9ce8-512d-9b26-1cdd1cb7076a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186594975} {:answer/id #uuid "531f6330-895f-5857-89e0-9b95708f85d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186595087} {:answer/id #uuid "82416cd0-9a8e-5686-add1-489a71823ed1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186595258} {:answer/id #uuid "8e8808c8-f270-5d9e-b79c-c51af40dbf28" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186595302} {:answer/id #uuid "ce715355-c417-577a-8b0d-7f676983d82a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186595514}] :answer-field/correct {:db/id #edb/ref 17592186594975} :answer-field/id #uuid "f17fd51d-a2fd-54c9-9da5-07f7bcd50baa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595906}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c7c553ee-90c8-5b5a-b65b-f3ca69c34b51" :question/math-academy-id "q-143576" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}x+y, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $Y.$" :question/worked-solution "The marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}(x+y)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}{x}^{2}+xy]}_{x=0}^{x=1} \\\\  & =\\frac{1}{2}\\cdot {1}^{2}+1\\cdot y-0 \\\\  & =\\frac{1}{2}+y.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}+y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\cdot {f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot (\\frac{1}{2}+y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{y}{2}+{y}^{2})\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{4}+\\frac{{y}^{3}}{3}]}_{0}^{1} \\\\  & =(\\frac{1}{4}+\\frac{1}{3})-0 \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7947bb7b-6025-5e81-ba6e-d4a24a1b29cd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{8}x({y}^{2}+1), & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595220} {:answer/id #uuid "816719b5-f4ba-5448-b3ab-e59f9af6bb44" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{8}{x}^{2}(y+1), & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595254} {:answer/id #uuid "95b6d82f-064d-550e-8898-defb805ecbc4" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine using only the given information." :db/id #edb/ref 17592186595340} {:answer/id #uuid "d3e9e9db-5e96-5585-82f7-7fb05dc73adb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{8}({x}^{2}+1)y, & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595532} {:answer/id #uuid "fb740492-1eec-5627-910b-0f0b625cd549" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{4}({x}^{2}+1)y, & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595668}] :answer-field/correct {:db/id #edb/ref 17592186595532} :answer-field/id #uuid "be4d5256-c094-52be-ae67-a0e85708ae56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595861}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d486bf2f-3991-5913-80f3-edea14576e37" :question/math-academy-id "q-143344" :question/problem "Let $X$ and $Y$ be two independent continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3}{4}({x}^{2}+1), & \\,0\\le x\\le 1, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}y, & \\,0\\le y\\le 2, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the joint probability density function $f(x,y).$" :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{3}{4}({x}^{2}+1)\\cdot \\frac{1}{2}y \\\\  & =\\frac{3}{8}({x}^{2}+1)y\\end{aligned}\n$$\n\nwhere $(x,y)\\in [0,1]\\times [0,2].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{8}({x}^{2}+1)y, & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186595996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0772d629-c53e-5e8e-b205-fea7872c8530" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{{y}^{3}}{4{x}^{2}}, & \\,1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186594843} {:answer/id #uuid "4920dfc6-3692-53ca-91c1-695025f3e307" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{8{x}^{3}}{{y}^{2}}, & \\,1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595053} {:answer/id #uuid "bfd8d7f7-db6c-5b56-b144-3953daa035a9" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine using only the given information." :db/id #edb/ref 17592186595474} {:answer/id #uuid "cf41e090-da43-51da-b15a-9d1d60362559" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{{y}^{3}}{8{x}^{2}}, & \\,1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595518} {:answer/id #uuid "d13e98f9-b3ea-55bd-aeff-d132e37b3d65" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{8{y}^{3}}{{x}^{2}}, & \\,1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186595524}] :answer-field/correct {:db/id #edb/ref 17592186595524} :answer-field/id #uuid "57bb0132-e107-5480-b30c-7736b8bfb6a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595771}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "db739dd0-8b17-5e59-abb0-e5c428165075" :question/math-academy-id "q-143348" :question/problem "Let $X$ and $Y$ be two independent continuous random variables whose marginal density functions are as follows:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{{x}^{2}}, & \\,1\\le x\\le 2, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,\\,{f}_{Y}(y)=\\{\\begin{aligned}4{y}^{3}, & \\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the joint probability density function $f(x,y).$" :question/worked-solution "Two continuous random variables $X$ and $Y$ with joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nSince our random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X}(x)\\cdot {f}_{Y}(y) \\\\  & =\\frac{2}{{x}^{2}}\\cdot 4{y}^{3} \\\\  & =\\frac{8{y}^{3}}{{x}^{2}}\\end{aligned}\n$$\n\nwhere $(x,y)\\in [1,2]\\times [0,1].$ Therefore, the full expression for $f(x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{8{y}^{3}}{{x}^{2}}, & \\,1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186596002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "942d76e7-b682-52dd-9e62-b4eee236a9f6" :answer/type {:db/ident :answer.type/image} :answer/value "images/7d/7d85f9c5da793b9093ea9ab8e9170a0834c498c179257307d9abb7e8dd0927be.png" :db/id #edb/ref 17592186595334} {:answer/id #uuid "c64455d4-84c8-530b-a484-75e67409617f" :answer/type {:db/ident :answer.type/image} :answer/value "images/d9/d95b4c5baa53c2301d06c4b8865112a6f9f2cb2486294e9dfc81eb28f00d2ba0.png" :db/id #edb/ref 17592186595492} {:answer/id #uuid "eb45499e-389b-58cc-952f-44f83dc1a9d2" :answer/type {:db/ident :answer.type/image} :answer/value "images/52/526860e076655e27f7422ac17651276e30ad8981271b3ec5edfc4d1ab31b3f52.png" :db/id #edb/ref 17592186595613} {:answer/id #uuid "ec82ebb3-520f-5bb6-81ec-76fbd1597124" :answer/type {:db/ident :answer.type/image} :answer/value "images/eb/ebb06d21bfcf6cf46fc5b7cd0badcc346d048e28ae4f45aa15cbafa2dc36c2f2.png" :db/id #edb/ref 17592186595617} {:answer/id #uuid "fd96e026-9de5-539b-966e-fc516c06c570" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b668cdb5ae042136bdc0da6791cf5d3ed579bbf99cd43b981b3d7a22e47a776f.png" :db/id #edb/ref 17592186595678}] :answer-field/correct {:db/id #edb/ref 17592186595613} :answer-field/id #uuid "a53042cc-7059-5a26-ada9-c8810e880986" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595836}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f23b5e6d-bc16-5c60-bea5-d32546b17632" :question/math-academy-id "q-174376" :question/problem "Which of the following is the indicator function ${1}_{A}(x)$ of the subset $A=\\{1,2\\}$ of $X=\\{-2,-1,0,1,2\\}.$" :question/worked-solution "An indicator function maps elements from a set to the values $0$ or $1,$ depending on whether the element belongs to a specified subset. The indicator function is designed to \"indicate\" whether an element is a member of a subset.\n\nMore specifically, consider a universal set $X.$ Then, the indicator function of a set $A⊆X$ is the function\n\n$$\n{1}_{A}(x)=\\{\\begin{aligned}1, & \\text{if }x\\in A, \\\\ 0, & \\text{if }x\\notin A.\\end{aligned}\n$$\n\nThe indicator function of the set $\\{1,2\\}$ is shown below.\n\n![](images/4c/4ccd0aab0a3e67bfed1fe90f4868b374fb9e443da559aa3cc34b4033c7e40427.png)\n\n \n\nNotice that the elements $1$ and $2$ (the elements of our subset) are mapped to $1,$ and all other elements are mapped to $0.$"}] [{:db/id #edb/ref 17592186596623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35c09820-13be-53b9-862d-b564facccf27" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186596166} {:answer/id #uuid "8cfd7d90-d4db-5330-9ce5-44da32075fa4" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186596302} {:answer/id #uuid "d54937aa-6b89-5a47-8841-f54ed0b0988f" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186596418} {:answer/id #uuid "dfa9b265-c63f-5b4c-9e6a-51367d3df477" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186596440} {:answer/id #uuid "f2c87a11-38d7-532e-83b0-417c4c3847a0" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186596463}] :answer-field/correct {:db/id #edb/ref 17592186596302} :answer-field/id #uuid "a2411783-e785-55f4-8cb7-395590e07479" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596575}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0948f12b-3b25-5368-b76b-01a21d4254bc" :question/math-academy-id "q-84193" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡0 & (\\text{mod}\\,2) \\\\ x≡4 & (\\text{mod}\\,5) \\\\ x≡7 & (\\text{mod}\\,9)\\end{aligned}\n$$" :question/worked-solution "Since $2,$ $5,$ and $9$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $2\\cdot 5\\cdot 9=90.$\n\nWe will solve the system in two steps.\n\n**Step 1.** Find the common solution for the first and second congruences of the system.\n\nFrom the first congruence, we get\n\n$$\nx≡0\\,(\\text{mod}\\,2)\\,⟹\\,x=2t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡4 &  & \\,(\\text{mod}\\,5) \\\\ 2t & ≡4 &  & \\,(\\text{mod}\\,5) \\\\ t & ≡2 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nAs a result, $t=2+5s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get the common solution for the first and second congruences:\n\n$$\n\\begin{aligned}x & =2t \\\\  & =2(2+5s) \\\\  & =4+10s\\end{aligned}\n$$\n\n**Step 2.** Find the common solution of all three congruences.\n\nNow, substituting the common solution of the first two congruences into the third congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡7 &  & \\,(\\text{mod}\\,9) \\\\ 4+10s & ≡7 &  & \\,(\\text{mod}\\,9) \\\\ 10s & ≡3 &  & \\,(\\text{mod}\\,9) \\\\ s & ≡3 &  & \\,(\\text{mod}\\,9)\\end{aligned}\n$$\n\nAs a result, $s=3+9u,$ where $u\\in Z.$ Substituting this into the expression for the common solution of the first two congruences, we get\n\n$$\n\\begin{aligned}x & =4+10s \\\\  & =4+10(3+9u) \\\\  & =34+90u.\\end{aligned}\n$$\n\nTherefore, $x≡34\\,(\\text{mod}\\,90)$ is the unique solution modulo $90,$ and $x=34$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2db2290c-877c-5fc2-8c2f-34d3a3044984" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186596156} {:answer/id #uuid "562cb4dc-43f6-512a-8dda-e1bf440c7ddd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186596216} {:answer/id #uuid "8324b2c9-1564-5b64-b9ee-ac9b9009d036" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186596291} {:answer/id #uuid "b2855382-0143-51ce-b91b-8cddb1c88182" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186596365} {:answer/id #uuid "cb8b2881-d44c-5b31-b496-764e58c932f4" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186596399}] :answer-field/correct {:db/id #edb/ref 17592186596156} :answer-field/id #uuid "04f418fd-37e1-5304-9308-04ab2cd45fa6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596492}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e3dd477-05cc-55ef-bcd2-dec3fc4aaad2" :question/math-academy-id "q-82773" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡1 & (\\text{mod}\\,3) \\\\ x≡3 & (\\text{mod}\\,4)\\end{aligned}\n$$" :question/worked-solution "Since $3$ and $4$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $3\\cdot 4=12.$\n\nFrom the first congruence, we get\n\n$$\nx≡1\\,(\\text{mod}\\,3)\\,⟹\\,x=1+3t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡3 &  & \\,(\\text{mod}\\,4) \\\\ 1+3t & ≡3 &  & \\,(\\text{mod}\\,4) \\\\ 3t & ≡2 &  & \\,(\\text{mod}\\,4)\\end{aligned}\n$$\n\nSince $4$ is a relatively small modulus, by trial and error, we have that $3\\cdot 3≡1\\,(\\text{mod}\\,4).$ So, we multiply both sides by $3:$\n\n$$\n\\begin{aligned}3t & ≡2 &  & \\,(\\text{mod}\\,4) \\\\ 3\\cdot 3t & ≡6 &  & \\,(\\text{mod}\\,4) \\\\ t & ≡2 &  & \\,(\\text{mod}\\,4)\\end{aligned}\n$$\n\nAs a result, $t=2+4s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get\n\n$$\n\\begin{aligned}x & =1+3t \\\\  & =1+3(2+4s) \\\\  & =7+12s.\\end{aligned}\n$$\n\nTherefore, $x≡7\\,(\\text{mod}\\,12)$ is the unique solution modulo $12,$ and $x=7$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596652 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b46e68-f58c-5ba4-aba2-aa1b6433744c" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186596081} {:answer/id #uuid "058bfaf3-d319-58a4-aa11-0dd0bb59233d" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186596086} {:answer/id #uuid "0ea1ad38-0148-5479-9bd9-ba340cadc62f" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186596101} {:answer/id #uuid "562e682e-e9f9-5031-9ecc-5e53a6c1789d" :answer/type {:db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186596217} {:answer/id #uuid "a02bf11e-159b-5017-838e-bf66d422b6fa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186596331}] :answer-field/correct {:db/id #edb/ref 17592186596331} :answer-field/id #uuid "3cf5ed6b-e9c4-5bf0-a41d-74b0cad5691a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596525}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "576d930c-c143-51bf-9c96-64ac1aef5d89" :question/math-academy-id "q-82769" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡1 & (\\text{mod}\\,2) \\\\ x≡2 & (\\text{mod}\\,3) \\\\ x≡5 & (\\text{mod}\\,7)\\end{aligned}\n$$" :question/worked-solution "Since $2,$ $3,$ and $7$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $2\\cdot 3\\cdot 7=42.$\n\nWe will solve the system in two steps.\n\n**Step 1.** Find the common solution for the first and second congruences of the system.\n\nFrom the first congruence, we get\n\n$$\nx≡1\\,(\\text{mod}\\,2)\\,⟹\\,x=1+2t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡2 &  & \\,(\\text{mod}\\,3) \\\\ 1+2t & ≡2 &  & \\,(\\text{mod}\\,3) \\\\ 2t & ≡1 &  & \\,(\\text{mod}\\,3)\\end{aligned}\n$$\n\nSince $3$ is a relatively small modulus, we can solve it by trial and error. We have that $2\\cdot 2≡1\\,(\\text{mod}\\,3).$ So, we multiply both sides by $2:$\n\n$$\n\\begin{aligned}2t & ≡1 &  & \\,(\\text{mod}\\,3) \\\\ 2\\cdot 2t & ≡2 &  & \\,(\\text{mod}\\,3) \\\\ t & ≡2 &  & \\,(\\text{mod}\\,3)\\end{aligned}\n$$\n\nAs a result, $t=2+3s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get the common solution for the first and second congruences:\n\n$$\n\\begin{aligned}x & =1+2t \\\\  & =1+2(2+3s) \\\\  & =5+6s\\end{aligned}\n$$\n\n**Step 2.** Find the common solution of all three congruences.\n\nNow, substituting the common solution of the first two congruences into the third congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡5 &  & \\,(\\text{mod}\\,7) \\\\ 5+6s & ≡5 &  & \\,(\\text{mod}\\,7) \\\\ 6s & ≡0 &  & \\,(\\text{mod}\\,7)\\end{aligned}\n$$\n\nSince $7$ is a relatively small modulus, by trial and error, we have that $6\\cdot 6≡1\\,(\\text{mod}\\,7).$ Hence,\n\n$$\n\\begin{aligned}6s & ≡0 &  & \\,(\\text{mod}\\,7) \\\\ 6\\cdot 6s & ≡0 &  & \\,(\\text{mod}\\,7) \\\\ s & ≡0 &  & \\,(\\text{mod}\\,7)\\end{aligned}\n$$\n\nAs a result, $s=7u,$ where $u\\in Z.$ Substituting this into the expression for the common solution of the first two congruences, we get\n\n$$\n\\begin{aligned}x & =5+6s \\\\  & =5+6(7u) \\\\  & =5+42u.\\end{aligned}\n$$\n\nTherefore, $x≡5\\,(\\text{mod}\\,42)$ is the unique solution modulo $42,$ and $x=5$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "625af6e6-47b0-5d4b-b02c-6683f25b2805" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186596238} {:answer/id #uuid "817d7046-a3c0-504c-b86d-37f5bf040c80" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186596290} {:answer/id #uuid "bd2ff541-d893-53ba-88a1-2724b3d588cb" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186596382} {:answer/id #uuid "c36a10ae-5870-5806-8e12-615675a72004" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186596391} {:answer/id #uuid "caf95c1a-5fc9-5899-9280-239d81b5104e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186596398}] :answer-field/correct {:db/id #edb/ref 17592186596382} :answer-field/id #uuid "d1af4b42-3c73-57b5-b8e0-7467fe9e7832" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596600}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "721082b2-c9da-52a9-9f48-353f3a841bb9" :question/math-academy-id "q-82763" :question/problem "According to the Chinese remainder theorem, which of the following systems of congruences has a unique solution modulo $144?$ \n\n$$\n\\text{I.}\\,\\{\\begin{aligned}x≡1 & (\\text{mod}\\,3) \\\\ x≡4 & (\\text{mod}\\,6) \\\\ x≡7 & (\\text{mod}\\,8)\\end{aligned}\\,\\text{II.}\\,\\{\\begin{aligned}x≡3 & (\\text{mod}\\,9) \\\\ x≡8 & (\\text{mod}\\,16)\\end{aligned}\\,\\text{III.}\\,\\{\\begin{aligned}x≡5 & (\\text{mod}\\,6) \\\\ x≡7 & (\\text{mod}\\,24)\\end{aligned}\\,\n$$" :question/worked-solution "The Chinese remainder theorem states that if the natural numbers ${n}_{1},{n}_{2},…,{n}_{k}$ are pairwise coprime, meaning that $\\text{gcd}({n}_{i},{n}_{j})=1$ whenever $i\\ne j,$ then for any integers ${a}_{1},{a}_{2},…,{a}_{k}$ the system\n\n$$\n\\{\\begin{aligned}x≡{a}_{1} & (\\text{mod}\\,{n}_{1}) \\\\ x≡{a}_{2} & (\\text{mod}\\,{n}_{2}) \\\\ \\,⋮ \\\\ x≡{a}_{k} & (\\text{mod}\\,{n}_{k})\\end{aligned}\n$$\n\nhas a unique solution modulo ${n}_{1}{n}_{2}⋯{n}_{k}.$\n\nLet's now inspect each of the given systems in turn.\n\n- The theorem does *not* apply to system I since $3$ and $6$ are not coprime: \n\n$$\n\\text{gcd}(3,6)=3>1\n$$\n\n- The theorem applies to system II. The numbers $9$ and $16$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $9\\cdot 16=144.$\n\n- The theorem does *not* apply to system III since $6$ and $24$ are not coprime: \n\n$$\n\\text{gcd}(6,24)=6>1\n$$\n\nSo, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186596670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37bbe3b1-4df4-5941-8269-f54073ead821" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186596169} {:answer/id #uuid "5a250dde-d9d3-59aa-84cf-0307b7daec5b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186596222} {:answer/id #uuid "80ac4cb3-1ab4-509a-84d7-26551b69dd50" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186596286} {:answer/id #uuid "9cc0068e-defa-55f9-a4a9-f2b7918e1db6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186596326} {:answer/id #uuid "9f34c2bd-4cbd-5d8a-bcfe-207af7d208b3" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186596329}] :answer-field/correct {:db/id #edb/ref 17592186596169} :answer-field/id #uuid "e9eea505-97cf-5ee0-8a43-6162146fded7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596611}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a8da941-4163-51b1-81fc-44084b010f1f" :question/math-academy-id "q-82761" :question/problem "According to the Chinese remainder theorem, which of the following systems of congruences has a unique solution modulo $105?$ \n\n$$\n\\text{I.}\\,\\{\\begin{aligned}x≡1 & (\\text{mod}\\,3) \\\\ x≡4 & (\\text{mod}\\,5) \\\\ x≡5 & (\\text{mod}\\,7)\\end{aligned}\\,\\text{II.}\\,\\{\\begin{aligned}x≡3 & (\\text{mod}\\,5) \\\\ x≡6 & (\\text{mod}\\,21)\\end{aligned}\\,\\text{III.}\\,\\{\\begin{aligned}x≡5 & (\\text{mod}\\,7) \\\\ x≡7 & (\\text{mod}\\,15)\\end{aligned}\\,\n$$" :question/worked-solution "The Chinese remainder theorem states that if the natural numbers ${n}_{1},{n}_{2},…,{n}_{k}$ are pairwise coprime, meaning that $\\text{gcd}({n}_{i},{n}_{j})=1$ whenever $i\\ne j,$ then for any integers ${a}_{1},{a}_{2},…,{a}_{k}$ the system\n\n$$\n\\{\\begin{aligned}x≡{a}_{1} & (\\text{mod}\\,{n}_{1}) \\\\ x≡{a}_{2} & (\\text{mod}\\,{n}_{2}) \\\\ \\,⋮ \\\\ x≡{a}_{k} & (\\text{mod}\\,{n}_{k})\\end{aligned}\n$$\n\nhas a unique solution modulo ${n}_{1}{n}_{2}⋯{n}_{k}.$\n\nLet's now inspect each of the given systems in turn.\n\n- The theorem applies to system I. The numbers $3,$ $5,$ and $7$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $3\\cdot 5\\cdot 7=105.$\n\n- The theorem applies to system II. The numbers $5$ and $21$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $5\\cdot 21=105.$\n\n- The theorem applies to system III. The numbers $7$ and $15$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $7\\cdot 15=105.$\n\nSo, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186596683 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be576cb-6fef-5355-aed7-eadd5a2fd783" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186596125} {:answer/id #uuid "a40628df-43ac-539f-a8fd-03c7f46814d4" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186596341} {:answer/id #uuid "cd27bf13-0016-56ba-b3a2-04afad85e2b1" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186596402} {:answer/id #uuid "d7c5e2dd-0ffc-57af-839c-bb92086c9b1e" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186596425} {:answer/id #uuid "f31b0619-cd06-5d62-a273-b137a0a6e850" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186596464}] :answer-field/correct {:db/id #edb/ref 17592186596425} :answer-field/id #uuid "06807cd7-2843-5cab-92ed-1e3389676fcf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "98a12bd2-f43d-5719-9e9d-a6204b9e3106" :question/math-academy-id "q-84189" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡4 & (\\text{mod}\\,7) \\\\ x≡8 & (\\text{mod}\\,10)\\end{aligned}\n$$" :question/worked-solution "Since $7$ and $10$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $7\\cdot 10=70.$\n\nFrom the first congruence, we get\n\n$$\nx≡4\\,(\\text{mod}\\,7)\\,⟹\\,x=4+7t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡8 &  & \\,(\\text{mod}\\,10) \\\\ 4+7t & ≡8 &  & \\,(\\text{mod}\\,10) \\\\ 7t & ≡4 &  & \\,(\\text{mod}\\,10)\\end{aligned}\n$$\n\nSince $10$ is a relatively small modulus, by trial and error, we have that $3\\cdot 7≡1\\,(\\text{mod}\\,10).$ So, we multiply both sides by $3:$\n\n$$\n\\begin{aligned}7t & ≡4 &  & \\,(\\text{mod}\\,10) \\\\ 3\\cdot 7t & ≡12 &  & \\,(\\text{mod}\\,10) \\\\ t & ≡2 &  & \\,(\\text{mod}\\,10)\\end{aligned}\n$$\n\nAs a result, $t=2+10s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get\n\n$$\n\\begin{aligned}x & =4+7t \\\\  & =4+7(2+10s) \\\\  & =18+70s.\\end{aligned}\n$$\n\nTherefore, $x≡18\\,(\\text{mod}\\,70)$ is the unique solution modulo $70,$ and $x=18$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c36ee3c-df4f-5366-8e4d-affdd808d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186596094} {:answer/id #uuid "2e9fb386-72dd-5d07-a68a-b9ed61e6acdc" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186596158} {:answer/id #uuid "76aa5e51-9f0d-56e6-a5c4-4af591a16978" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186596270} {:answer/id #uuid "9746e082-f244-58a5-8270-4aa42ad213cd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186596314} {:answer/id #uuid "aefbce0f-e499-5ebb-9583-89bfad77a6c8" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186596360}] :answer-field/correct {:db/id #edb/ref 17592186596270} :answer-field/id #uuid "68d6fa04-404c-5f35-876c-807df1a1231c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596543}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9f62d185-6ad2-54b6-93de-b2216970aa7d" :question/math-academy-id "q-82767" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡1 & (\\text{mod}\\,2) \\\\ x≡4 & (\\text{mod}\\,5)\\end{aligned}\n$$" :question/worked-solution "Since $2$ and $5$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $2\\cdot 5=10.$\n\nFrom the first congruence, we get\n\n$$\nx≡1\\,(\\text{mod}\\,2)\\,⟹\\,x=1+2t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡4 &  & \\,(\\text{mod}\\,5) \\\\ 1+2t & ≡4 &  & \\,(\\text{mod}\\,5) \\\\ 2t & ≡3 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nSince $5$ is a relatively small modulus, by trial and error, we have that $3\\cdot 2≡1\\,(\\text{mod}\\,5).$ So, we multiply both sides by $3:$\n\n$$\n\\begin{aligned}2t & ≡3 &  & \\,(\\text{mod}\\,5) \\\\ 3\\cdot 2t & ≡3\\cdot 3 &  & \\,(\\text{mod}\\,5) \\\\ t & ≡9 &  & \\,(\\text{mod}\\,5) \\\\ t & ≡4 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nAs a result, $t=4+5s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get\n\n$$\n\\begin{aligned}x & =1+2t \\\\  & =1+2(4+5s) \\\\  & =9+10s.\\end{aligned}\n$$\n\nTherefore, $x≡9\\,(\\text{mod}\\,10)$ is the unique solution modulo $10,$ and $x=9$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8d0324-d125-5c68-93c5-c4290fcba384" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186596150} {:answer/id #uuid "64b8e472-7e23-5bbf-9b03-bc7253bc144a" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186596244} {:answer/id #uuid "6d402025-4a50-5193-95b8-f17f338ffe09" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186596259} {:answer/id #uuid "9d4bcfff-64d0-585c-815f-477713ec319f" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186596327} {:answer/id #uuid "ecb02713-87de-59f4-8397-f482d65372e0" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186596457}] :answer-field/correct {:db/id #edb/ref 17592186596327} :answer-field/id #uuid "134ed2c4-ac66-541f-a318-9fd2e974fef4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596503}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a794c6e7-0d86-507b-8a8f-beb4d2c0cf83" :question/math-academy-id "q-82774" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡1 & (\\text{mod}\\,2) \\\\ x≡3 & (\\text{mod}\\,5) \\\\ x≡5 & (\\text{mod}\\,7)\\end{aligned}\n$$" :question/worked-solution "Since $2,$ $5,$ and $7$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $2\\cdot 5\\cdot 7=70.$\n\nWe will solve the system in two steps.\n\n**Step 1.** Find the common solution for the first and second congruences of the system.\n\nFrom the first congruence, we get\n\n$$\nx≡1\\,(\\text{mod}\\,2)\\,⟹\\,x=1+2t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡3 &  & \\,(\\text{mod}\\,5) \\\\ 1+2t & ≡3 &  & \\,(\\text{mod}\\,5) \\\\ 2t & ≡2 &  & \\,(\\text{mod}\\,5) \\\\ t & ≡1 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nAs a result, $t=1+5s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get the common solution for the first and second congruences:\n\n$$\n\\begin{aligned}x & =1+2t \\\\  & =1+2(1+5s) \\\\  & =3+10s\\end{aligned}\n$$\n\n**Step 2.** Find the common solution of all three congruences.\n\nNow, substituting the common solution of the first two congruences into the third congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡5 &  & \\,(\\text{mod}\\,7) \\\\ 3+10s & ≡5 &  & \\,(\\text{mod}\\,7) \\\\ 10s & ≡2 &  & \\,(\\text{mod}\\,7) \\\\ 3s & ≡2 &  & \\,(\\text{mod}\\,7)\\end{aligned}\n$$\n\nSince $7$ is a relatively small modulus, by trial and error, we have that $5\\cdot 3≡1\\,(\\text{mod}\\,7).$ So, we multiply both sides by $5:$\n\n$$\n\\begin{aligned}3s & ≡2 &  & \\,(\\text{mod}\\,7) \\\\ 5\\cdot 3s & ≡10 &  & \\,(\\text{mod}\\,7) \\\\ s & ≡3 &  & \\,(\\text{mod}\\,7)\\end{aligned}\n$$\n\nAs a result, $s=3+7u,$ where $u\\in Z.$ Substituting this into the expression for the common solution of the first two congruences, we get\n\n$$\n\\begin{aligned}x & =3+10s \\\\  & =3+10(3+7u) \\\\  & =33+70u.\\end{aligned}\n$$\n\nTherefore, $x≡33\\,(\\text{mod}\\,70)$ is the unique solution modulo $70,$ and $x=33$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268131d6-1c9c-5f74-bd4a-74acb28528c8" :answer/type {:db/ident :answer.type/math} :answer/value "53" :db/id #edb/ref 17592186596139} {:answer/id #uuid "97a154f1-5cb8-5515-9007-9a0cba4076c2" :answer/type {:db/ident :answer.type/math} :answer/value "41" :db/id #edb/ref 17592186596316} {:answer/id #uuid "bc483704-2be3-553b-b59f-f74de33d8221" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186596379} {:answer/id #uuid "e50f138c-b651-5a61-90fd-f21fdac26ef0" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186596446} {:answer/id #uuid "f5a8dfb1-696f-538a-9e56-d42ab9296b2a" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186596471}] :answer-field/correct {:db/id #edb/ref 17592186596139} :answer-field/id #uuid "b507c4c3-9a57-5928-9a7f-928687cff65c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596583}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b0ff2d24-e784-5748-b525-d41f4f13aba3" :question/math-academy-id "q-84192" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡2 & (\\text{mod}\\,3) \\\\ x≡4 & (\\text{mod}\\,7) \\\\ x≡5 & (\\text{mod}\\,8)\\end{aligned}\n$$" :question/worked-solution "Since $3,$ $7,$ and $8$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $3\\cdot 7\\cdot 8=168.$\n\nWe will solve the system in two steps.\n\n**Step 1.** Find the common solution for the first and second congruences of the system.\n\nFrom the first congruence, we get\n\n$$\nx≡2\\,(\\text{mod}\\,3)\\,⟹\\,x=2+3t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡4 &  & \\,(\\text{mod}\\,7) \\\\ 2+3t & ≡4 &  & \\,(\\text{mod}\\,7) \\\\ 3t & ≡2 &  & \\,(\\text{mod}\\,7)\\end{aligned}\n$$\n\nSince $7$ is a relatively small modulus, we can solve it by trial and error. We have that $5\\cdot 3≡1\\,(\\text{mod}\\,7).$ So, we multiply both sides by $5:$\n\n$$\n\\begin{aligned}3t & ≡2 &  & \\,(\\text{mod}\\,7) \\\\ 5\\cdot 3t & ≡10 &  & \\,(\\text{mod}\\,7) \\\\ t & ≡3 &  & \\,(\\text{mod}\\,7)\\end{aligned}\n$$\n\nAs a result, $t=3+7s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get the common solution for the first and second congruences:\n\n$$\n\\begin{aligned}x & =2+3t \\\\  & =2+3(3+7s) \\\\  & =11+21s\\end{aligned}\n$$\n\n**Step 2.** Find the common solution of all three congruences.\n\nNow, substituting the common solution of the first two congruences into the third congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡5 &  & \\,(\\text{mod}\\,8) \\\\ 11+21s & ≡5 &  & \\,(\\text{mod}\\,8) \\\\ 21s & ≡-6 &  & \\,(\\text{mod}\\,8) \\\\ 5s & ≡2 &  & \\,(\\text{mod}\\,8)\\end{aligned}\n$$\n\nSince $8$ is a relatively small modulus, by trial and error, we have that $5\\cdot 5≡1\\,(\\text{mod}\\,8).$ So, we multiply both sides by $5:$\n\n$$\n\\begin{aligned}5s & ≡2 &  & \\,(\\text{mod}\\,8) \\\\ 5\\cdot 5s & ≡10 &  & \\,(\\text{mod}\\,8) \\\\ s & ≡2 &  & \\,(\\text{mod}\\,8)\\end{aligned}\n$$\n\nAs a result, $s=2+8u,$ where $u\\in Z.$ Substituting this into the expression for the common solution of the first two congruences, we get\n\n$$\n\\begin{aligned}x & =11+21s \\\\  & =11+21(2+8u) \\\\  & =53+168u.\\end{aligned}\n$$\n\nTherefore, $x≡53\\,(\\text{mod}\\,168)$ is the unique solution modulo $168,$ and $x=53$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e6c249f-23c8-5528-868e-72237433dc77" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186596303}] :answer-field/correct {:db/id #edb/ref 17592186596303} :answer-field/id #uuid "cdd8d8f5-32cb-5e36-9ab1-a2e800f3038b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186596597}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f7b81869-77b2-53e2-ae84-b8b52768ab43" :question/math-academy-id "q-361320" :question/problem "$$\n\\{\\begin{aligned}x≡0 & (\\text{mod}\\,3) \\\\ x≡4 & (\\text{mod}\\,5) \\\\ x≡10 & (\\text{mod}\\,11)\\end{aligned}\n$$\n\nThe smallest natural-number solution to the system of linear congruences above  is $x=$\n{{field-1}}." :question/worked-solution "Since $3,$ $5,$ and $11$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $3\\cdot 5\\cdot 11=165.$\n\nWe will solve the system in two steps.\n\n**Step 1.** Find the common solution for the first and second congruences of the system.\n\nFrom the first congruence, we get\n\n$$\nx≡0\\,(\\text{mod}\\,3)\\,⟹\\,x=3t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡4 &  & \\,(\\text{mod}\\,5) \\\\ 3t & ≡4 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nSince $5$ is a relatively small modulus, we can solve it by trial and error. We have that $2\\cdot 3≡1\\,(\\text{mod}\\,5).$ So, we multiply both sides by $2:$\n\n$$\n\\begin{aligned}3t & ≡4 &  & \\,(\\text{mod}\\,5) \\\\ 2\\cdot 3t & ≡8 &  & \\,(\\text{mod}\\,5) \\\\ t & ≡3 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nAs a result, $t=3+5s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get the common solution for the first and second congruences:\n\n$$\n\\begin{aligned}x & =3t \\\\  & =3(3+5s) \\\\  & =9+15s\\end{aligned}\n$$\n\n**Step 2.** Find the common solution of all three congruences.\n\nNow, substituting the common solution of the first two congruences into the third congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡10 &  & \\,(\\text{mod}\\,11) \\\\ 9+15s & ≡10 &  & \\,(\\text{mod}\\,11) \\\\ 15s & ≡1 &  & \\,(\\text{mod}\\,11) \\\\ 4s & ≡1 &  & \\,(\\text{mod}\\,11)\\end{aligned}\n$$\n\nSince $11$ is a relatively small modulus, by trial and error, we have that $3\\cdot 4≡1\\,(\\text{mod}\\,11).$ So, we multiply both sides by $3:$\n\n$$\n\\begin{aligned}4s & ≡1 &  & \\,(\\text{mod}\\,11) \\\\ 3\\cdot 4s & ≡3 &  & \\,(\\text{mod}\\,11) \\\\ s & ≡3 &  & \\,(\\text{mod}\\,11)\\end{aligned}\n$$\n\nAs a result, $s=3+11u,$ where $u\\in Z.$ Substituting this into the expression for the common solution of the first two congruences, we get\n\n$$\n\\begin{aligned}x & =9+15s \\\\  & =9+15(3+11u) \\\\  & =54+165u.\\end{aligned}\n$$\n\nTherefore, $x≡54\\,(\\text{mod}\\,165)$ is the unique solution modulo $165,$ and $x=54$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186596722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa54466-a10c-5ec7-a06a-27da0c430b52" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186596234} {:answer/id #uuid "9b14fe28-7636-5de8-b231-d12af21fd3dc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186596323} {:answer/id #uuid "c0205261-ad31-559c-bc8c-d53427d0281b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186596387} {:answer/id #uuid "cbaf0651-51b5-5c6e-91d1-50235809fac3" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186596400} {:answer/id #uuid "d2a99707-68f1-5f35-a7ac-f2a1835860d0" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186596412}] :answer-field/correct {:db/id #edb/ref 17592186596234} :answer-field/id #uuid "3eb5ec20-a422-5bc9-b7d6-f509b5764d7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596526}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f97a4c7b-03b8-56dd-b49e-25ed6bbeadda" :question/math-academy-id "q-82902" :question/problem "According to the Chinese remainder theorem, which of the following systems of congruences has a unique solution modulo $210?$ \n\n$$\n\\text{I.}\\,\\{\\begin{aligned}x≡2 & (\\text{mod}\\,5) \\\\ x≡4 & (\\text{mod}\\,6) \\\\ x≡5 & (\\text{mod}\\,7)\\end{aligned}\\,\\text{II.}\\,\\{\\begin{aligned}x≡7 & (\\text{mod}\\,10) \\\\ x≡13 & (\\text{mod}\\,21)\\end{aligned}\\,\\text{III.}\\,\\{\\begin{aligned}x≡9 & (\\text{mod}\\,14) \\\\ x≡11 & (\\text{mod}\\,15)\\end{aligned}\\,\n$$" :question/worked-solution "The Chinese remainder theorem states that if the natural numbers ${n}_{1},{n}_{2},…,{n}_{k}$ are pairwise coprime, meaning that $\\text{gcd}({n}_{i},{n}_{j})=1$ whenever $i\\ne j,$ then for any integers ${a}_{1},{a}_{2},…,{a}_{k}$ the system\n\n$$\n\\{\\begin{aligned}x≡{a}_{1} & (\\text{mod}\\,{n}_{1}) \\\\ x≡{a}_{2} & (\\text{mod}\\,{n}_{2}) \\\\ \\,⋮ \\\\ x≡{a}_{k} & (\\text{mod}\\,{n}_{k})\\end{aligned}\n$$\n\nhas a unique solution modulo ${n}_{1}{n}_{2}⋯{n}_{k}.$\n\nLet's now inspect each of the given systems in turn.\n\n- The theorem applies to system I. The numbers $5,$ $6,$ and $7$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $5\\cdot 6\\cdot 7=210.$\n\n- The theorem applies to system II. The numbers $10$ and $21$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $10\\cdot 21=210.$\n\n- The theorem applies to system III. The numbers $14$ and $15$ are pairwise coprime natural numbers. Therefore, according to the Chinese remainder theorem, the system has a unique solution modulo $14\\cdot 15=210.$\n\nSo, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186596723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "367e57d8-0cae-549d-a5b6-427f1919133f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186596167} {:answer/id #uuid "695cb3cd-78d1-5182-a4ec-53f27c35ed70" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186596252} {:answer/id #uuid "7bebfe64-acf5-5354-bf2f-8c45d895979e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186596277} {:answer/id #uuid "852673a0-1849-5d85-aa36-1885a521dca9" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186596294} {:answer/id #uuid "eacdd0a6-052f-558f-a1d0-289d6d6d1424" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186596453}] :answer-field/correct {:db/id #edb/ref 17592186596252} :answer-field/id #uuid "d234b783-8a00-5faf-a698-17623ffc4b6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596601}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc3089e2-34c6-58f6-9aa1-fa311804a403" :question/math-academy-id "q-82765" :question/problem "Find the smallest natural number solution to the system of linear congruences below.\n\n$$\n\\{\\begin{aligned}x≡2 & (\\text{mod}\\,3) \\\\ x≡3 & (\\text{mod}\\,5)\\end{aligned}\n$$" :question/worked-solution "Since $3$ and $5$ are coprime, then according to the Chinese remainder theorem, the system has a unique solution modulo $3\\cdot 5=15.$\n\nFrom the first congruence, we get\n\n$$\nx≡2\\,(\\text{mod}\\,3)\\,⟹\\,x=2+3t,\\,t\\in Z.\n$$\n\nSubstituting this into the second congruence, we obtain the following:\n\n$$\n\\begin{aligned}x & ≡3 &  & \\,(\\text{mod}\\,5) \\\\ 2+3t & ≡3 &  & \\,(\\text{mod}\\,5) \\\\ 3t & ≡1 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nSince $5$ is a relatively small modulus, by trial and error, we have that $2\\cdot 3≡1\\,(\\text{mod}\\,5).$ So, we multiply both sides by $2:$\n\n$$\n\\begin{aligned}3t & ≡1 &  & \\,(\\text{mod}\\,5) \\\\ 2\\cdot 3t & ≡2 &  & \\,(\\text{mod}\\,5) \\\\ t & ≡2 &  & \\,(\\text{mod}\\,5)\\end{aligned}\n$$\n\nAs a result, $t=2+5s,$ where $s\\in Z.$ Substituting this into the expression for $x,$ we get\n\n$$\n\\begin{aligned}x & =2+3t \\\\  & =2+3(2+5s) \\\\  & =8+15s.\\end{aligned}\n$$\n\nTherefore, $x≡8\\,(\\text{mod}\\,15)$ is the unique solution modulo $15,$ and $x=8$ is the smallest natural number solution to the system."}] [{:db/id #edb/ref 17592186597589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b75730-4293-5860-9719-50702b120621" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186596871} {:answer/id #uuid "bff27476-092c-52ca-b08a-61955ae453a6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186597244} {:answer/id #uuid "c52ba5f3-10f6-5a94-a979-f719a475f968" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186597259} {:answer/id #uuid "e16a87ce-e2fc-5a0f-a530-407eec43f81b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186597316} {:answer/id #uuid "e836d431-1c2d-5173-9dae-f8eaff0eb563" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186597331}] :answer-field/correct {:db/id #edb/ref 17592186597244} :answer-field/id #uuid "c73a37bb-dd1d-5aea-86a4-7c34015d84d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186597498}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2be856f-6608-5b5d-90dc-e6201ffa98c8" :question/math-academy-id "q-110857" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}cxy,\\, & 0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nwhere $c$ is a positive real number. Find the value of $c.$" :question/worked-solution "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y=1\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1\\}.$\n\n![](images/ea/ea5ff670f03d0bffb84f0929d19b94bca62f23677f913c01e8e0949d144bc60a.png)\n\nNow, let's check our conditions:\n\n- Since $c>0,$ we clearly have $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}.$ So the first condition is satisfied.\n\n- For the second condition to be satisfied, we must have \n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{1}cxy\\,\\text{d}y\\,\\text{d}x=1.\n$$\n\nWe evaluate the inner integral by integrating with respect to $y$, treating  $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{1}cxy\\,\\text{d}y]\\text{d}x & ={\\int }_{0}^{1}{[\\frac{cx{y}^{2}}{2}]}_{y=0}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\left(\\frac{cx}{2}\\right)\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\left(\\frac{cx}{2}\\right)\\,\\text{d}x & ={[\\frac{c{x}^{2}}{4}]}_{0}^{1} \\\\  & =\\frac{c}{4}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{c}{4}=1\\,⇒\\,c=4.\n$$"}] [{:db/id #edb/ref 17592186598565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4af724-369f-5915-81ee-075b0df8d0c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{x}^{2}" :db/id #edb/ref 17592186597781} {:answer/id #uuid "9f63acbc-e575-5f84-926e-ecd3e6fa7a9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}x" :db/id #edb/ref 17592186598175} {:answer/id #uuid "a26b051d-5872-56dc-9e9f-6062cc4b2aa4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{x}^{2}" :db/id #edb/ref 17592186598182} {:answer/id #uuid "a8ecd788-872f-583d-8985-8312a79deeb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}({x}^{2}-1)" :db/id #edb/ref 17592186598195} {:answer/id #uuid "c295b3d1-62f3-5567-82f0-eb8bd2b4dac1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(x+1)" :db/id #edb/ref 17592186598248}] :answer-field/correct {:db/id #edb/ref 17592186598182} :answer-field/id #uuid "0c83cb0a-6c7a-5942-8fab-2786ec20fb16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186598401}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04907a76-f20c-547d-8c85-9e2a4f484daa" :question/math-academy-id "q-143713" :question/problem "Let $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{3}xy, & 0\\le x\\le 2,\\,1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\n \nFind the expression for the corresponding joint CDF when $0\\le x\\le 2$ and $y>2.$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the region $D$ in the $uv$-plane where the function $f(u,v)$ is nonzero. Let's also consider a point $(x,y)$ where $0\\le x\\le 2$ and $y>2$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/bd/bd8ba5862859dd85230edaeeeaef011fc163caf58d24ee0a9f64e6cda2a8ac63.png)\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=\\{(u,v)\\,:\\,0\\le u\\le x,\\,1\\le v\\le 2\\}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={\\int }_{1}^{2}{\\int }_{0}^{x}\\frac{1}{3}uv\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{2}v{[\\frac{{u}^{2}}{2}]}_{u=0}^{u=x}\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{2}\\frac{v{x}^{2}}{2}\\text{d}v \\\\  & =\\frac{1}{6}{x}^{2}{[\\frac{{v}^{2}}{2}]}_{v=1}^{v=2} \\\\  & =\\frac{1}{12}{x}^{2}({2}^{2}-{1}^{2}) \\\\  & =\\frac{1}{4}{x}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186598569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f1c98e-a456-5458-92b4-808da501075b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(x-y)^{2}" :db/id #edb/ref 17592186597775} {:answer/id #uuid "8f4859bb-f07c-5a66-8c0c-88dd8e6e46ce" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186598134} {:answer/id #uuid "c4d94b89-8300-5358-ac43-51ab758ce4f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(y-x)" :db/id #edb/ref 17592186598257} {:answer/id #uuid "cbff545e-d091-500e-84f9-40427d4e410c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(x-y)" :db/id #edb/ref 17592186598270} {:answer/id #uuid "e2086485-788a-52be-9665-5b349c9fa87a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186598327}] :answer-field/correct {:db/id #edb/ref 17592186598327} :answer-field/id #uuid "0ac41f97-7a4c-5724-a975-e3c6fdbf4046" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186598400}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "12165786-f9d2-5028-ac14-9f6f1b0876f3" :question/math-academy-id "q-143664" :question/problem "Let $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{6}(x-y), & 2\\le x\\le 5,\\,1\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the corresponding joint CDF when $x<2,\\,y<3.$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the region $D$ in the $uv$-plane where the function $f(u,v)$ is nonzero. Let's also consider a point $(x,y)$ where $x<2,\\,y<3,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/74/74dd82bfd636b96a813c388acf11cd76b07e7d8640d44d92beb8ae02b7887699.png)\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=∅.\n$$\n\n \n\nSo there is nowhere in our region $Δ$ where $f(x,y)$ is nonzero. Therefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={∬}_{Δ}f(u,v)\\,\\text{d}u\\,\\text{d}v=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186598571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f67381-7d51-54c8-9bed-6e7a805b1ec7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186597768} {:answer/id #uuid "155930d8-5960-56c4-b060-8fb165cf17ec" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186597804} {:answer/id #uuid "43f8dc7d-669e-5c0b-9a01-5537cfe04cac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186597918} {:answer/id #uuid "46924fb0-3bc3-530b-bab3-1eee27a43408" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186597926} {:answer/id #uuid "4e290a2b-9856-51a9-b5b9-c6f6762a5d58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186597951}] :answer-field/correct {:db/id #edb/ref 17592186597804} :answer-field/id #uuid "1b056615-0b8e-5af3-915b-941ab09496af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186598412}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1916c106-7964-5ee9-b8f9-8a796abf47bd" :question/math-academy-id "q-137896" :question/problem "![](images/c6/c64cfa701997c2b9e5e54f7eb77afb9927b878065af9c32fed86f09f140a4ec4.png)\n\nLet $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}x+y, & (x,y)\\in D, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(-\\frac{1}{4},\\frac{1}{2}).$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the point $(-\\frac{1}{4},\\frac{1}{2})$ on our diagram. Let's also consider the region $Δ$ that lies below and to the left of this point.\n\n![](images/72/72ec33b41b4a7d924cec49ca1d55856c36c56cec4db1e7c347eefc06cbe2d2f2.png)\n\nUsing the definition of the joint CDF, we have\n\n$$\nF(-\\frac{1}{4},\\frac{1}{2})=P(X<-\\frac{1}{4},Y<\\frac{1}{2})={\\int }_{-\\infty }^{1/2}{\\int }_{-\\infty }^{-1/4}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nHowever, $f(u,v)$ is zero everywhere inside the region $Δ.$ Therefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1/2}{\\int }_{-\\infty }^{-1/4}f(u,v)\\,\\text{d}u\\,\\text{d}v &=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186598582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2960da24-74d7-57ca-9b2b-522f3d214439" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}y\\sqrt{x}" :db/id #edb/ref 17592186597851} {:answer/id #uuid "2a24246e-5bf8-5fcc-8b36-f74cf354e544" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186597854} {:answer/id #uuid "521ce299-2d6d-54f7-a950-93acb30706a2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186597959} {:answer/id #uuid "750fc7c2-eaab-5502-b74b-d0786f8d5f50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}x\\sqrt{y}" :db/id #edb/ref 17592186598065} {:answer/id #uuid "7707a586-eef3-5c68-a937-9858104a962d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}x\\sqrt{y}" :db/id #edb/ref 17592186598071}] :answer-field/correct {:db/id #edb/ref 17592186597854} :answer-field/id #uuid "5e4c3a80-45a0-5c0f-bdc5-ed2bc0f672ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186598464}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4be8160a-916a-59b9-965e-18ca548131dd" :question/math-academy-id "q-143655" :question/problem "Let $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{4}x\\sqrt{y}, & 0\\le x\\le 2,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the corresponding joint CDF when $x>2,\\,y>1.$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the region $D$ in the $uv$-plane where the function $f(u,v)$ is nonzero. Let's also consider a point $(x,y)$ where $x>2,\\,y>1,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/ae/aee587dffc2912f936f9ad43a2f50e727f818f6fab87ced742b3e5d6795cb1d8.png)\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=D.\n$$\n\n \n\nSo our region $Δ$ covers the entire region where $f(x,y)$ is nonzero. Therefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={∬}_{D}f(u,v)\\,\\text{d}u\\,\\text{d}v=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186598611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d04f43-e3af-5768-b42b-d2c6190fa607" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}{x}^{2}({e}^{y}+1)" :db/id #edb/ref 17592186597771} {:answer/id #uuid "64296d7d-e211-5e38-9de1-475dab99106a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{x}^{2}({e}^{y}-1)" :db/id #edb/ref 17592186598012} {:answer/id #uuid "6c303b5e-f699-5f97-8686-0f2f6d32e37a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{x}^{2}{e}^{y}" :db/id #edb/ref 17592186598036} {:answer/id #uuid "903409ab-6c30-5152-87b5-9ca8607d0cd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}x({e}^{y}-1)" :db/id #edb/ref 17592186598137} {:answer/id #uuid "aa36de8f-f488-57ef-a4c7-36a8ac3201d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}x({e}^{y}-2)" :db/id #edb/ref 17592186598200}] :answer-field/correct {:db/id #edb/ref 17592186598012} :answer-field/id #uuid "f13a1589-533b-518a-8f05-970da501e2a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186598550}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ae5fd30d-fbe9-5c51-b051-cbe6aa8f7dbf" :question/math-academy-id "q-143697" :question/problem "Let $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{6}x{e}^{y}, & 0\\le x\\le 2,\\,0\\le y\\le \\operatorname{ln}⁡4, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the corresponding joint CDF when $0\\le x\\le 2,\\,0\\le y\\le \\operatorname{ln}⁡4.$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the region $D$ in the $uv$-plane where the function $f(u,v)$ is nonzero. Let's also consider a point $(x,y)$ where $0\\le x\\le 2,\\,0\\le y\\le \\operatorname{ln}⁡4,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/c6/c62b7e0866443343399eb9de04a58bdec5095c21492cb5b65062de4faafc2a10.png)\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=\\{(u,v)\\,:\\,0\\le u\\le x,\\,0\\le v\\le y\\}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={\\int }_{0}^{y}{\\int }_{0}^{x}\\frac{1}{6}u{e}^{v}\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{y}\\frac{1}{6}{e}^{v}{\\int }_{0}^{x}u\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{y}\\frac{1}{6}{e}^{v}{[\\frac{{u}^{2}}{2}]}_{u=0}^{u=x}\\,\\text{d}v \\\\  & ={\\int }_{0}^{y}\\frac{1}{12}{x}^{2}{e}^{v}\\,\\text{d}v \\\\  & =\\frac{1}{12}{x}^{2}{\\int }_{0}^{y}{e}^{v}\\,\\text{d}v \\\\  & =\\frac{1}{12}{x}^{2}[{e}^{v}]_{v=0}^{v=y} \\\\  & =\\frac{1}{12}{x}^{2}({e}^{y}-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186598619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135c125a-5fe2-5b7c-a5de-4bb7a3469d22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186597799} {:answer/id #uuid "23666876-6046-5759-ab40-9f695bcea7e4" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{e}" :db/id #edb/ref 17592186597837} {:answer/id #uuid "9e3f99e4-6f41-578d-9ed4-b31f70c1cdf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186598173} {:answer/id #uuid "ab336105-3338-579d-90b1-67fa4f570950" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186598202} {:answer/id #uuid "cf7514c5-c157-5566-8a94-22a6b62862c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(1-\\frac{1}{e})" :db/id #edb/ref 17592186598284}] :answer-field/correct {:db/id #edb/ref 17592186597837} :answer-field/id #uuid "13a9e2b9-67e0-5c32-a955-d920a34c9248" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186598405}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd087b6f-fdc5-5c17-bce1-bded6ef6e32d" :question/math-academy-id "q-143746" :question/problem "![](images/3c/3c45364ee569d9ee24bbac167ad2a76f8a0a1a519f6604b7f9427d723c59abab.png)\n\nLet $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}6y{e}^{-3x}, & (x,y)\\in D, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(\\frac{1}{3},\\frac{4}{3}).$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the point $(\\frac{1}{3},\\frac{4}{3})$ on our diagram. Let's also consider the region $Δ$ that lies below and to the left of this point.\n\n![](images/fb/fbd92a584940df6ed6224a2ff0f1546e53786657012a997395d30d9248bfd528.png)\n\nUsing the definition of the joint CDF, we have\n\n$$\nF(\\frac{1}{3},\\frac{4}{3})=P(X<\\frac{1}{3},Y<\\frac{4}{3})={\\int }_{-\\infty }^{4/3}{\\int }_{-\\infty }^{1/3}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=\\{(x,y)\\,:\\,0\\le x\\le \\frac{1}{3},\\,0\\le y\\le 1\\}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{4/3}{\\int }_{-\\infty }^{1/3}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={\\int }_{0}^{1}{\\int }_{0}^{1/3}6v{e}^{-3u}\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{1}{[-2v{e}^{-3u}]}_{u=0}^{u=1/3}\\,\\text{d}v \\\\  & ={\\int }_{0}^{1}(2v-2v{e}^{-1})\\text{d}v \\\\  & ={\\int }_{0}^{1}2(1-{e}^{-1})v\\,\\text{d}v \\\\  & =(1-{e}^{-1}){[{v}^{2}]}_{v=0}^{v=1} \\\\  & =(1-{e}^{-1}) \\\\  & =1-\\frac{1}{e}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186599232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62455d14-7720-5bb0-8ddc-48d16e9fb624" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}\\frac{3}{5} & 0 \\\\ 0 & \\frac{13}{16}\\end{bmatrix}\n$$" :db/id #edb/ref 17592186598867} {:answer/id #uuid "679fd6f2-c6b8-5657-902b-2cf8da90a971" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}\\frac{3}{20} & 0 \\\\ 0 & \\frac{9}{16}\\end{bmatrix}\n$$" :db/id #edb/ref 17592186598877} {:answer/id #uuid "b949644d-89e6-53bc-b6d8-0a12af579afe" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}\\frac{3}{20} & -1 \\\\ -1 & \\frac{7}{162}\\end{bmatrix}\n$$" :db/id #edb/ref 17592186599007} {:answer/id #uuid "c3429af5-ce39-574f-90df-180825f19e07" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}\\frac{3}{5} & -1 \\\\ -1 & \\frac{13}{162}\\end{bmatrix}\n$$" :db/id #edb/ref 17592186599022} {:answer/id #uuid "eb39f288-0a06-5386-a39c-201c6f8706c3" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}\\frac{3}{20} & 0 \\\\ 0 & \\frac{13}{162}\\end{bmatrix}\n$$" :db/id #edb/ref 17592186599075}] :answer-field/correct {:db/id #edb/ref 17592186599075} :answer-field/id #uuid "648f6675-534c-524b-ba11-313f74c3d724" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186599144}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f6512b5-c94d-5732-b0f6-fd9f2599153f" :question/math-academy-id "q-159400" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{4}{x}^{2}(y+1),\\, & 0\\le x\\le 2,\\,\\,0\\le y\\le 1, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $\\text{E}[X]=\\frac{3}{2}$ and $\\text{E}[Y]=\\frac{5}{9},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=\\begin{bmatrix}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{bmatrix}.\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{2}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{x}^{2}(\\frac{1}{4}{x}^{2}(y+1))\\text{d}x\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}(y+1){\\int }_{0}^{2}{x}^{4}\\text{d}x\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}(y+1)\\cdot {[\\frac{1}{5}{x}^{5}]}_{0}^{2}\\text{d}y \\\\  & =\\frac{8}{5}{\\int }_{0}^{1}(y+1)\\,\\text{d}y \\\\  & =\\frac{8}{5}\\cdot {[\\frac{1}{2}{y}^{2}+y]}_{0}^{1} \\\\  & =\\frac{8}{5}\\cdot \\frac{3}{2} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{12}{5}-{\\left(\\frac{3}{2}\\right)}^{2} \\\\  & =\\frac{3}{20}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{2}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{y}^{2}(\\frac{1}{4}{x}^{2}(y+1))\\text{d}x\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}({y}^{3}+{y}^{2}){\\int }_{0}^{2}{x}^{2}\\,\\text{d}x\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}({y}^{3}+{y}^{2}){[\\frac{1}{3}{x}^{3}]}_{0}^{2}\\,\\text{d}y \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}({y}^{3}+{y}^{2})\\,\\text{d}y \\\\  & =\\frac{2}{3}\\cdot {[\\frac{1}{4}{y}^{4}+\\frac{1}{3}{y}^{3}]}_{0}^{1} \\\\  & =\\frac{2}{3}\\cdot \\frac{7}{12} \\\\  & =\\frac{7}{18}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{7}{18}-{\\left(\\frac{5}{9}\\right)}^{2} \\\\  & =\\frac{13}{162}.\\end{aligned}\n$$\n\nNow, we find the covariance of $X$ and $Y.$ The joint support of $X$ and $Y$ is given by the rectangle\n\n$$\nS=[0,2]\\times [0,1].\n$$\n\nMoreover, we can write\n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=\\frac{3{x}^{2}}{8}$ and $h(y)=\\frac{2(y+1)}{3}.$\n\nHence, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=\\begin{bmatrix}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{bmatrix}=\\begin{bmatrix}\\frac{3}{20} & 0 \\\\ 0 & \\frac{13}{162}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186599256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af3e478-f02d-5957-947a-ab8630c9573a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} & 0 \\\\ 0 & \\frac{1}{9}\\end{bmatrix}" :db/id #edb/ref 17592186598776} {:answer/id #uuid "2d630af2-9659-5e5c-b3f9-e6d1982764f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} & 1 \\\\ 1 & \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186598780} {:answer/id #uuid "4c19ebc9-1f4f-5ffb-ae75-29ee53c6432a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} & 0 \\\\ 0 & \\frac{1}{18}\\end{bmatrix}" :db/id #edb/ref 17592186598834} {:answer/id #uuid "94d1a6b7-5181-5b87-9313-4902de871a60" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} & 1 \\\\ 1 & \\frac{1}{18}\\end{bmatrix}" :db/id #edb/ref 17592186598944} {:answer/id #uuid "d76259d1-2962-540a-87cb-f9764e961393" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{18}\\end{bmatrix}" :db/id #edb/ref 17592186599049}] :answer-field/correct {:db/id #edb/ref 17592186598834} :answer-field/id #uuid "5796fe89-f18d-55f1-b314-9155eb802d9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186599140}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d43d63b7-f056-53f6-9ca6-07a82b3017cf" :question/math-academy-id "q-159405" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{4}y({x}^{2}+1),\\, & -1\\le x\\le 1,\\,\\,0\\le y\\le 1, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $\\text{E}[X]=0$ and $\\text{E}[Y]=\\frac{2}{3},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=\\begin{bmatrix}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{bmatrix}.\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{1}{\\int }_{-1}^{1}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}{x}^{2}(\\frac{3}{4}y({x}^{2}+1))\\text{d}x\\text{d}y \\\\  & =\\frac{3}{4}{\\int }_{0}^{1}y{\\int }_{-1}^{1}({x}^{4}+{x}^{2})\\text{d}x\\text{d}y \\\\  & =\\frac{3}{4}{\\int }_{0}^{1}y\\cdot {[\\frac{1}{5}{x}^{5}+\\frac{1}{3}{x}^{3}]}_{-1}^{1}\\text{d}y \\\\  & =\\frac{3}{4}\\cdot \\frac{16}{15}{\\int }_{0}^{1}y\\,\\text{d}y \\\\  & =\\frac{4}{5}\\cdot {[\\frac{1}{2}{y}^{2}]}_{0}^{1} \\\\  & =\\frac{4}{5}\\cdot \\frac{1}{2} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{5}-{(0)}^{2} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{1}{\\int }_{-1}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}{y}^{2}(\\frac{3}{4}y({x}^{2}+1))\\text{d}x\\text{d}y \\\\  & =\\frac{3}{4}{\\int }_{0}^{1}{y}^{3}{\\int }_{-1}^{1}({x}^{2}+1)\\,\\text{d}x\\text{d}y \\\\  & =\\frac{3}{4}{\\int }_{0}^{1}{y}^{3}{[\\frac{1}{3}{x}^{3}+x]}_{-1}^{1}\\,\\text{d}y \\\\  & =2{\\int }_{0}^{1}{y}^{3}\\,\\text{d}y \\\\  & =2\\cdot {[\\frac{1}{4}{y}^{4}]}_{0}^{1} \\\\  & =2\\cdot \\frac{1}{4} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{1}{2}-{\\left(\\frac{2}{3}\\right)}^{2} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$\n\nNow, we find the covariance of $X$ and $Y.$ The joint support of $X$ and $Y$ is given by the rectangle\n\n$$\nS=[-1,1]\\times [0,1].\n$$\n\nMoreover, we can write\n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=\\frac{3}{8}({x}^{2}+1)$ and $h(y)=2y.$\n\nHence, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=\\begin{bmatrix}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{5} & 0 \\\\ 0 & \\frac{1}{18}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186599790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c0699dd-887f-50b1-93df-aa7d72bcc51a" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}y" :db/id #edb/ref 17592186599379} {:answer/id #uuid "313bc3b6-57ce-59b4-8177-5b32852142b6" :answer/type {:db/ident :answer.type/math} :answer/value "3x{y}^{2}" :db/id #edb/ref 17592186599401} {:answer/id #uuid "87d4ff53-cc94-531a-87fb-ba5cc9315644" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}x{y}^{2}" :db/id #edb/ref 17592186599513} {:answer/id #uuid "e845fc75-5893-554e-890b-13a6218381e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{3}y" :db/id #edb/ref 17592186599640} {:answer/id #uuid "f2a254e8-a394-596b-b39e-5f2191b8eb97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{x}^{2}y" :db/id #edb/ref 17592186599654}] :answer-field/correct {:db/id #edb/ref 17592186599379} :answer-field/id #uuid "8fcbf3c1-220d-5a61-92a8-273a862b7adc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186599727}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4d4fc2ac-26c3-5472-8b34-d6f74f7dfc76" :question/math-academy-id "q-159328" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\{\\begin{aligned}0, & x<-1\\,\\text{or}\\,y<0 \\\\ \\frac{1}{2}({x}^{3}+1){y}^{2}, & -1\\le x\\le 1,\\,0\\le y\\le 1 \\\\ {F}_{X}(x), & -1\\le x\\le 1,\\,y>1 \\\\ {F}_{Y}(y), & x>1,\\,0\\le y\\le 1 \\\\ 1, & x>1,\\,y>1.\\end{aligned}\n$$\n\nwhere ${F}_{X}$ and ${F}_{Y}$ are the marginal CDFs of $X$ and $Y,$ respectively. Find the joint PDF $f(x,y)$ for $-1\\le x\\le 1$ and $0\\le y\\le 1.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is determined by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $-1\\le x\\le 1$ and $0\\le y\\le 1,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}(\\frac{1}{2}({x}^{3}+1){y}^{2})) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{2}({x}^{3}+1)\\cdot \\frac{∂}{∂y}({y}^{2})) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{2}({x}^{3}+1)\\cdot 2y) \\\\  & =y\\cdot \\frac{∂}{∂x}({x}^{3}+1) \\\\  & =y\\cdot 3{x}^{2} \\\\  & =3{x}^{2}y.\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\nTherefore, we have\n\n$$\nf(x,y)=\\{\\begin{aligned}3{x}^{2}y, & -1\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186599799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207c1609-ef53-5387-8cc3-7c486471cbcb" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186599384} {:answer/id #uuid "5a51d447-5d72-5bd2-a185-b51c71c32451" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186599457} {:answer/id #uuid "907ac801-4d73-50c8-ac57-a477925a7b7d" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186599528} {:answer/id #uuid "b58544ee-0f96-5b7c-be44-6c94fa9ebd3e" :answer/type {:db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186599576} {:answer/id #uuid "d31bf675-416f-56f0-960c-be354b96d897" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186599610}] :answer-field/correct {:db/id #edb/ref 17592186599457} :answer-field/id #uuid "7a2d6c21-5ba7-5466-b03e-e5acab40ed58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186599718}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b1eb315-aae9-55ec-9f22-3e0858dc3d91" :question/math-academy-id "q-117664" :question/problem "The function $f(x)$ is defined below. What is the value of \n$$\n\\displaystyle {\\int }_{-3}^{2}f(x)\\,\\text{d}x\\,?\n$$\n\n$$\nf(x)=\\{\\begin{aligned}3-x, & x<1 \\\\ 2x, & x\\ge 1\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-3}^{2}f(x)\\,\\text{d}x & ={\\int }_{-3}^{1}(3-x)\\,\\text{d}x+{\\int }_{1}^{2}2x\\,\\text{d}x \\\\  & =(3x-\\frac{{x}^{2}}{2}){|}_{-3}^{1}+{x}^{2}{|}_{1}^{2} \\\\  & =[3(1)-\\frac{(1)^{2}}{2}-3(-3)+\\frac{(-3)^{2}}{2}]+[(2)^{2}-(1)^{2}] \\\\  & =[12+4]+[4-1] \\\\  & =16+3 \\\\  & =19.\\end{aligned}\n$$"}]}
