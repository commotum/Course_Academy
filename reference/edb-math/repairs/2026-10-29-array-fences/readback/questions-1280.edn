#{[{:db/id #edb/ref 17592186654325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eacdb65-7dc0-52bd-b611-e463e0161142" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}1,\\, & x\\le -1 \\\\ 2x-1,\\, & x>-1\\end{aligned}" :db/id #edb/ref 17592186653684} {:answer/id #uuid "4f776840-6d09-5e73-b55a-208e5f4a7edf" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}1,\\, & x\\le -1 \\\\ 2x+2,\\, & x>-1\\end{aligned}" :db/id #edb/ref 17592186653798} {:answer/id #uuid "e94b33cd-b0bf-5750-98e1-328f580fa0c4" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}-1,\\, & x\\le -1 \\\\ 2x+1,\\, & x>-1\\end{aligned}" :db/id #edb/ref 17592186654076} {:answer/id #uuid "eefec59c-94ff-5afa-a620-70665a0cc9eb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}-1,\\, & x\\le -1 \\\\ 2x,\\, & x>-1\\end{aligned}" :db/id #edb/ref 17592186654090} {:answer/id #uuid "f36c4430-ec62-5d10-88fc-12523d99d898" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\{\\begin{aligned}-1,\\, & x\\le -1 \\\\ x,\\, & x>-1\\end{aligned}" :db/id #edb/ref 17592186654098}] :answer-field/correct {:db/id #edb/ref 17592186654090} :answer-field/id #uuid "79de0182-8f78-5cc2-88d7-dbd9e6e1d5a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186654170}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6171ead-27b5-56ce-87c1-b7c921123b5d" :question/math-academy-id "q-129282" :question/problem "![](images/05/052fcdbb779b8f261874c1919ad2327fb053e2a90b34313227620c8a536a699c.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,-1],$ we have $f(x)=-1,$ so the graph is a horizontal line that ends at $(-1,-1),$ including this point.\n\n- On the interval $(-1,\\infty ),$ we have a line with a slope of $2$ and $y$-intercept $0.$ So the graph is the line $y=2x$ that starts at $(-1,-2),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}-1,\\, & x\\le -1 \\\\ 2x,\\, & x>-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186654326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a5ffcc-3204-5529-a063-1d020e3f4f5d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186653671} {:answer/id #uuid "e3e40fe3-29cd-5494-a7f2-840913be7dba" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186654064} {:answer/id #uuid "ea3c4a84-5368-544a-990c-279610d3007d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186654079} {:answer/id #uuid "f6baba55-7cfe-53de-91df-0bb7c88519f9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186654102} {:answer/id #uuid "f712307a-acf0-55b7-a168-d3738884b4a5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186654105}] :answer-field/correct {:db/id #edb/ref 17592186654079} :answer-field/id #uuid "9da12895-63e8-507b-9e56-23a5e1dc7905" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186654186}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e99cb868-b9fc-54fd-bbaa-dd619018c7a3" :question/math-academy-id "q-7303" :question/problem "Given the following piecewise function $f(x),$ what is $f(4)?$\n\n$$\nf(x)=\\{\\begin{aligned}x+4,\\, & x\\le 2 \\\\ x-1,\\, & x>2\\end{aligned}\n$$" :question/worked-solution "Since $x=4$ is in the interval $x>2,$ we use the right-hand branch, namely $f(x)=x-1:$\n\n$$\n\\begin{aligned}f(4) & =4-1=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186654746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13398000-551f-56b3-8921-87dafefe197a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186654406} {:answer/id #uuid "2b8b6285-079c-5094-8a8a-bd86a58d9ee6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186654426} {:answer/id #uuid "4247b7bb-cf59-59b4-b1b4-bdd918bb5349" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186654450} {:answer/id #uuid "d9171196-706b-5942-a75f-263c38c45c02" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186654608} {:answer/id #uuid "f0b37adc-11a9-5bbd-aea6-09531d627d46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186654637}] :answer-field/correct {:db/id #edb/ref 17592186654426} :answer-field/id #uuid "70a3f15f-159e-5861-8501-5c06bb3b07f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186654695}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3430ae13-4b50-5c75-98bd-de70c607009b" :question/math-academy-id "q-143579" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{2}{y}^{2}, & 0\\le x\\le 2,\\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $X.$" :question/worked-solution "The marginal density function for $X$ for $0\\le x\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}\\frac{3}{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{3}{2}{[\\frac{1}{3}{y}^{3}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{2}{[{y}^{3}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{2}({1}^{3}-0) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{2}, & 0\\le x\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\cdot {f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}x\\,\\text{d}x \\\\  & =\\frac{1}{2}{[\\frac{{x}^{2}}{2}]}_{0}^{2} \\\\  & =\\frac{1}{2}(2-0) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186654771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10013ca4-9419-5ed1-8e8a-85011224d4f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186654400} {:answer/id #uuid "371c5550-8318-5bdd-abf2-b658476157a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186654440} {:answer/id #uuid "460d56b2-6f50-52f9-aacf-44d6aecd43e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186654456} {:answer/id #uuid "4c71ef50-bcb8-5b51-abd7-15b00b345ada" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186654460} {:answer/id #uuid "dec2443b-266d-527f-9e14-dc687354a32b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186654617}] :answer-field/correct {:db/id #edb/ref 17592186654456} :answer-field/id #uuid "5a152c7b-84dd-5f1e-9c99-2e7d64e13000" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186654686}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6b0c2486-75af-5d67-8d59-c62bff9d7466" :question/math-academy-id "q-149606" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{x+3{y}^{2}}{4}, & 0\\le x\\le 2,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $X.$" :question/worked-solution "The marginal density function for $X$ when $0\\le x\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}\\frac{x+3{y}^{2}}{4}\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}(x+3{y}^{2})\\,\\text{d}y \\\\  & =\\frac{1}{4}{[xy+{y}^{3}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{4}(x+1-0) \\\\  & =\\frac{x+1}{4}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{x+1}{4}, & 0\\le x\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\cdot {f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{x+1}{4}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({x}^{2}+x)\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{3}}{3}+\\frac{{x}^{2}}{2}]}_{0}^{2} \\\\  & =\\frac{1}{4}(\\frac{8}{3}+2) \\\\  & =\\frac{7}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186655513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04752e78-fcbe-5c4b-8384-bcec20e5f9a6" :answer/type {:db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186654888} {:answer/id #uuid "48715bca-3005-5a86-bec0-147bed30b3ed" :answer/type {:db/ident :answer.type/math} :answer/value "0.37" :db/id #edb/ref 17592186655018} {:answer/id #uuid "a49af563-81d9-55c1-b0c5-67c1981b68a2" :answer/type {:db/ident :answer.type/math} :answer/value "0.36" :db/id #edb/ref 17592186655178} {:answer/id #uuid "c4f84536-a166-5421-810c-54253a495281" :answer/type {:db/ident :answer.type/math} :answer/value "0.67" :db/id #edb/ref 17592186655242} {:answer/id #uuid "ea9aa653-fbbd-5d47-b8ed-25e7475fce08" :answer/type {:db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186655310}] :answer-field/correct {:db/id #edb/ref 17592186655018} :answer-field/id #uuid "b8aaf7fe-6923-5e7d-b02c-c3ad617ab491" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186655426}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e220d48-41a5-541b-854f-7ccc5d1888ea" :question/math-academy-id "q-97201" :question/problem "Given that $X∼\\text{Bernoulli}(0.63),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.63),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.63, & x=1 \\\\ 0.37, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=0.37.\n$$"}] [{:db/id #edb/ref 17592186656248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32a86a60-6cd2-5495-9c90-49f2c157cbd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=\\text{DNE},\\,\\lim_{x\\to \\,(\\pi /2)^{+}}f(x)=3" :db/id #edb/ref 17592186655762} {:answer/id #uuid "74d06051-dcab-57e3-8c9a-502b4928c119" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=\\lim_{x\\to \\,(\\pi /2)^{+}}f(x)=1" :db/id #edb/ref 17592186655855} {:answer/id #uuid "b01879d3-16db-576d-aee7-2007099cb8b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=1,\\,\\lim_{x\\to \\,(\\pi /2)^{+}}f(x)=3" :db/id #edb/ref 17592186655943} {:answer/id #uuid "e2048650-1d59-5223-b189-8af84ce5c47b" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=1,\\,\\lim_{x\\to \\,(\\pi /2)^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186656013} {:answer/id #uuid "ee01c01b-b8c7-5283-a04a-512d564e99f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to {0}^{-}}f(x)=0,\\,\\lim_{x\\to \\,(\\pi /2)^{+}}f(x)=1" :db/id #edb/ref 17592186656029}] :answer-field/correct {:db/id #edb/ref 17592186655943} :answer-field/id #uuid "c52b5a0f-4a2d-5b89-96a3-cebbd309608f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656124}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea32f9f3-918e-5c7c-abeb-f51a871f1aa8" :question/math-academy-id "q-78415" :question/problem "Find $\\lim_{x\\to \\,{0}^{-}}f(x)$ and $\\lim_{x\\to \\,(\\pi /2)^{+}}f(x)$ for the function given by\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{cos}⁡(2x) & \\text{ for }\\,x\\le 0 \\\\ 2\\operatorname{sin}⁡(x)+1 & \\text{ for }\\,x>\\frac{\\pi }{2}\\end{aligned}\n$$" :question/worked-solution "Approaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=\\operatorname{cos}⁡(2x).$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{-}}\\operatorname{cos}⁡(2x) \\\\  & =\\operatorname{cos}⁡(0) \\\\  & =1.\\end{aligned}\n$$\n\nApproaching $x=\\frac{\\pi }{2}$ from the right, we have $x>\\frac{\\pi }{2},$ so we use the expression $f(x)=2\\operatorname{sin}⁡(x)+1.$ Consequently,\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,(\\pi /2)^{+}}f(x) & =\\lim_{x\\to \\,(\\pi /2)^{+}}(2\\operatorname{sin}⁡(x)+1) \\\\  & =2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)+1 \\\\  & =2(1)+1 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bd85ff7-e5a1-59c9-bb99-b03d950f98f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186656468} {:answer/id #uuid "6a2d203e-ee05-50b9-a44f-6400c9b172cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{216}" :db/id #edb/ref 17592186656544} {:answer/id #uuid "c1c6d5c8-36dc-5bf3-9579-930203591c4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{73}{216}" :db/id #edb/ref 17592186656673} {:answer/id #uuid "d648dc56-ee1e-5bab-885f-ec58db14a6a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{91}{243}" :db/id #edb/ref 17592186656697} {:answer/id #uuid "fbe78a5a-5929-5c94-be52-724abc4fc5c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186656760}] :answer-field/correct {:db/id #edb/ref 17592186656697} :answer-field/id #uuid "d02f1792-a3a5-5032-8c5a-e3a98539a312" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656844}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1079940a-bd3b-5977-a28e-6541d16a36b1" :question/math-academy-id "q-143623" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}{x}^{2}{y}^{2}, & \\,-1\\le x\\le 1,-1\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(X<Y<\\frac{3}{2}\\,|\\,X=\\frac{1}{6}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}y,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$  \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{-1}^{2}\\frac{1}{2}{x}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{2}{x}^{2}{\\int }_{-1}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{2}{x}^{2}{[\\frac{1}{3}{y}^{3}]}_{-1}^{2} \\\\  & =\\frac{1}{2}{x}^{2}(\\frac{8}{3}+\\frac{1}{3}) \\\\  & =\\frac{3}{2}{x}^{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3}{2}{x}^{2}, & \\,-1\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $-1\\le x\\le 1,-1\\le y\\le 2,$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{1}{2}{x}^{2}{y}^{2})}{(\\frac{3}{2}{x}^{2})} \\\\  & =\\frac{1}{3}{y}^{2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{1}{3}{y}^{2}, & \\,-1\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(X<Y<\\frac{3}{2}\\,|\\,X=\\frac{1}{6}) & =P(\\frac{1}{6}<Y<\\frac{3}{2}\\,|\\,X=\\frac{1}{6}) \\\\  & ={\\int }_{1/6}^{3/2}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{1}{6})\\text{d}y \\\\  & ={\\int }_{1/6}^{3/2}\\frac{1}{3}{y}^{2}\\text{d}y \\\\  & ={[\\frac{{y}^{3}}{9}]}_{1/6}^{3/2} \\\\  & =\\frac{1}{9}(\\frac{27}{8}-\\frac{1}{216}) \\\\  & =\\frac{91}{243}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ae7eb0a-64c4-597b-9115-67c161e879e5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186656545} {:answer/id #uuid "6dc0ca5b-f3ca-581c-88f5-0aa63424c260" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186656548} {:answer/id #uuid "8b9da87c-e2ab-5c28-ab57-3b29a9751bf6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186656598} {:answer/id #uuid "9258a64d-bef3-5a04-a0a5-d532477df1dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186656612} {:answer/id #uuid "df014408-b1c3-5b25-b611-9a753924f50c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186656716}] :answer-field/correct {:db/id #edb/ref 17592186656716} :answer-field/id #uuid "62687bca-df85-50e1-bf16-8b2ce019d6a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656805}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5aee9b45-3316-52a1-922d-3fad3000b471" :question/math-academy-id "q-147840" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{8{y}^{2}}{{x}^{3}}, & 1\\le x\\le 2,\\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}.\\end{aligned}\n$$\n\nFind the covariance of $X$ and $Y.$" :question/worked-solution "The joint support of $X$ and $Y$ is given by the rectangle \n\n$$\nS=[1,2]\\times [0,1].\n$$\n\nMoreover, we can write \n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=\\frac{1}{{x}^{3}}$ and $h(y)=8{y}^{2}.$ \n\nTherefore, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$"}] [{:db/id #edb/ref 17592186656896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018ca137-2781-5422-b884-d231d812de18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16{x}^{3}{y}^{2}}{9}" :db/id #edb/ref 17592186656388} {:answer/id #uuid "33f4c20c-976f-503c-834e-131d1c374529" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}y" :db/id #edb/ref 17592186656453} {:answer/id #uuid "84373bb7-8b02-5c15-a2b3-43633ef48c64" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{y}^{2}" :db/id #edb/ref 17592186656575} {:answer/id #uuid "9237fba2-499e-59ef-a028-66ee08889ae2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{x}^{3}}{9}" :db/id #edb/ref 17592186656611} {:answer/id #uuid "ac0fe3c4-78cd-5d40-833b-13ade94b2273" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{3}" :db/id #edb/ref 17592186656649}] :answer-field/correct {:db/id #edb/ref 17592186656649} :answer-field/id #uuid "ba5e9dda-03d6-5e2e-b497-911a1c1fb093" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656832}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "60e75156-e685-5891-8bcf-a9ac2aaad14d" :question/math-academy-id "q-143608" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{8{x}^{3}y}{3}, & 0\\le x\\le 1,\\,1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2y}{3}, & 1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{Y}(y)$ are shown above. Find the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 1,\\,1\\le y\\le 2.$" :question/worked-solution "Recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 1,\\,1\\le y\\le 2,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{8{x}^{3}y}{3}\\right)}{\\left(\\frac{2y}{3}\\right)} \\\\  & =4{x}^{3}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}4{x}^{3}, & 0\\le x\\le 1,\\,1\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02539e99-228c-5778-8df3-1d3b30d50ed2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x+y}{y+1}" :db/id #edb/ref 17592186656389} {:answer/id #uuid "600c4d4c-b89b-5510-8e7d-f6c13abfe9f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{2y+1}" :db/id #edb/ref 17592186656526} {:answer/id #uuid "7e85896f-e154-521b-9a44-e02a5de350d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y+1}" :db/id #edb/ref 17592186656565} {:answer/id #uuid "8003bae7-a250-5560-a26e-5cb957a5c460" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x+2y}{2y+1}" :db/id #edb/ref 17592186656567} {:answer/id #uuid "8943d9c0-a48f-5f99-a40c-f618afb7b56a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+y}{y+1}" :db/id #edb/ref 17592186656590}] :answer-field/correct {:db/id #edb/ref 17592186656567} :answer-field/id #uuid "2ebb0eef-ee83-58e3-a220-fe85b73ede12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656785}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ecca051-c021-559d-b7bf-65ad1df03e23" :question/math-academy-id "q-144940" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}x+y, & 0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2y+1}{2}, & 0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{Y}(y)$ are shown above. Find the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 1,\\,0\\le y\\le 1.$" :question/worked-solution "Recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 1,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{x+y}{\\left(\\frac{2y+1}{2}\\right)} \\\\  & =\\frac{2x+2y}{2y+1}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x+2y}{2y+1}, & 0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389042a1-0fb1-52c7-a07d-6b30ecda7996" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4}}{5}" :db/id #edb/ref 17592186656461} {:answer/id #uuid "4a40cb29-7eb7-5fa3-ab43-cdab514b7c58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{7}" :db/id #edb/ref 17592186656489} {:answer/id #uuid "a59e0613-d78a-5132-a549-df7a912eb06c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{x}^{2}+1}" :db/id #edb/ref 17592186656638} {:answer/id #uuid "a5b2b19d-b855-5cd2-aeb0-05d8a04ed816" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}" :db/id #edb/ref 17592186656639} {:answer/id #uuid "aa42e5f5-d405-5b41-9054-d9290c81f4c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{2}}{3}" :db/id #edb/ref 17592186656643}] :answer-field/correct {:db/id #edb/ref 17592186656489} :answer-field/id #uuid "c4c85285-dff5-5d6b-a8e3-ad5275716c92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656838}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a2351e4f-7af7-5a46-856c-b74fb4a2263c" :question/math-academy-id "q-143606" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{15{x}^{2}{y}^{4}}{7}, & 1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}5{y}^{4}, & 0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{Y}(y)$ are shown above. Find the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $1\\le x\\le 2,\\,0\\le y\\le 1.$" :question/worked-solution "Recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $1\\le x\\le 2,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{15{x}^{2}{y}^{4}}{7}\\right)}{5{y}^{4}} \\\\  & =\\frac{3{x}^{2}}{7}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{3{x}^{2}}{7}, & 1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2752f4-89f2-534e-b490-474c50aa906d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{12}" :db/id #edb/ref 17592186656421} {:answer/id #uuid "8b217c8a-24da-519a-8888-e933c9a6c6c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186656596} {:answer/id #uuid "949c4797-36e8-519a-be19-6642e5e0801a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186656616} {:answer/id #uuid "dbcb913b-0661-5a55-b7d7-fd2609102c3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186656709} {:answer/id #uuid "fba54702-d167-511e-a909-d7fd5ca07a34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186656758}] :answer-field/correct {:db/id #edb/ref 17592186656709} :answer-field/id #uuid "e1100563-20df-58b1-a47f-4dc58d7238be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656849}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a2e39d5e-76b8-5e24-a1fc-e51a1ecf5ae4" :question/math-academy-id "q-145125" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3({x}^{2}+y)}{8}, & \\,0\\le x\\le 1,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(Y<X\\,|\\,X=\\frac{1}{3}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}y,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{3({x}^{2}+y)}{8}\\,\\text{d}y \\\\  & =\\frac{3}{8}{\\int }_{0}^{2}({x}^{2}+y)\\,\\text{d}y \\\\  & =\\frac{3}{8}{[y{x}^{2}+\\frac{1}{2}{y}^{2}]}_{y=0}^{y=2} \\\\  & =\\frac{3}{8}[2{x}^{2}+2-0] \\\\  & =\\frac{3({x}^{2}+1)}{4}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3({x}^{2}+1)}{4}, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le 1,0\\le y\\le 2$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\left(\\frac{3({x}^{2}+y)}{8}\\right)}{\\left(\\frac{3({x}^{2}+1)}{4}\\right)} \\\\  & =\\frac{{x}^{2}+y}{2({x}^{2}+1)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{{x}^{2}+y}{2({x}^{2}+1)}, & \\,0\\le x\\le 1,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(Y<X\\,|\\,X=\\frac{1}{3}) & =P(Y<\\frac{1}{3}\\,|\\,X=\\frac{1}{3}) \\\\  & ={\\int }_{0}^{1/3}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{1}{3})\\text{d}y \\\\  & ={\\int }_{0}^{1/3}\\frac{({\\left(\\frac{1}{3}\\right)}^{2}+y)}{2({\\left(\\frac{1}{3}\\right)}^{2}+1)}\\text{d}y \\\\  & ={\\int }_{0}^{1/3}\\frac{\\left(\\frac{9y+1}{9}\\right)}{\\left(\\frac{20}{9}\\right)}\\text{d}y \\\\  & =\\frac{1}{20}{\\int }_{0}^{1/3}(9y+1)\\,\\text{d}y \\\\  & =\\frac{1}{20}{[\\frac{9{y}^{2}}{2}+y]}_{0}^{1/3} \\\\  & =\\frac{1}{20}(\\frac{1}{2}+\\frac{1}{3}) \\\\  & =\\frac{1}{20}\\cdot \\frac{5}{6} \\\\  & =\\frac{1}{24}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fe37c6-bf78-5466-a149-b807dbf5b32a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x}{{y}^{5}}" :db/id #edb/ref 17592186656450} {:answer/id #uuid "362bf813-726e-5a4d-ad9b-73e59d167e5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}y}{8}" :db/id #edb/ref 17592186656456} {:answer/id #uuid "88e8ab7c-f5de-50b8-8a2e-a37e1c8013f7" :answer/type {:db/ident :answer.type/math} :answer/value "2x{y}^{2}" :db/id #edb/ref 17592186656589} {:answer/id #uuid "9f205a00-23f3-54ae-9f71-6926288d3637" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}{y}^{2}" :db/id #edb/ref 17592186656629} {:answer/id #uuid "a6ca3c18-7e61-5586-887b-0df6088b4de5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{2}" :db/id #edb/ref 17592186656642}] :answer-field/correct {:db/id #edb/ref 17592186656642} :answer-field/id #uuid "04164974-9115-50c7-a9cb-f79aba0e18fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656772}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be5e85f7-c287-5f30-9a8e-3d60a27f740d" :question/math-academy-id "q-143614" :question/problem "$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x}{{y}^{2}}, & 0\\le x\\le y,\\,0<y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{{y}^{3}}{4}, & 0<y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ and the marginal density function ${f}_{Y}(y)$ are shown above. Find the expression of the joint probability density function $f(x,y)$ for $0\\le x\\le y,\\,0<y\\le 2.$" :question/worked-solution "Recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nFrom the equation above, it follows that\n\n$$\nf(x,y)={f}_{X\\,|\\,Y}(x\\,|\\,y)\\cdot {f}_{Y}(y).\n$$\n\nNow, for $0\\le x\\le y,\\,0<y\\le 2,$ we have \n\n$$\n\\begin{aligned}f(x,y) & ={f}_{X\\,|\\,Y}(x\\,|\\,y)\\cdot {f}_{Y}(y) \\\\  & =\\frac{2x}{{y}^{2}}\\cdot \\frac{{y}^{3}}{4} \\\\  & =\\frac{xy}{2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ equals $0.$ As a result, the product will be equal to $0$ too.\n\nTherefore, the joint probability density function is the following:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{xy}{2}, & 0\\le x\\le y,\\,0<y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63f47c1c-99a5-5107-ada3-fb269bb95767" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186656533} {:answer/id #uuid "746a9686-3f2e-5391-a8f8-7b3ea3300cfa" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186656554} {:answer/id #uuid "a67720b9-2fdf-51d3-88c0-234f87d86a1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186656640} {:answer/id #uuid "f1892470-cc24-5066-887c-3f74c065a465" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186656738} {:answer/id #uuid "f5a517f2-6f5c-5f46-9983-2edf55b241a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186656745}] :answer-field/correct {:db/id #edb/ref 17592186656745} :answer-field/id #uuid "e8648f36-4173-5282-86e5-f19940a2523e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656851}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dca936e5-3feb-53f4-8938-93df89c84670" :question/math-academy-id "q-143636" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{\\operatorname{ln}⁡y}{xy}, & \\,1\\le x\\le {e}^{2},\\,1\\le y\\le e \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $1\\le x\\le {e}^{2},\\,1\\le y\\le e.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{1}^{{e}^{2}}\\frac{\\operatorname{ln}⁡y}{xy}\\,\\text{d}x \\\\  & =\\frac{\\operatorname{ln}⁡y}{y}{\\int }_{1}^{{e}^{2}}\\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{\\operatorname{ln}⁡y}{y}\\cdot \\operatorname{ln}⁡x\\,{|}_{1}^{{e}^{2}} \\\\  & =\\frac{\\operatorname{ln}⁡y}{y}\\cdot (2-0) \\\\  & =\\frac{2\\operatorname{ln}⁡y}{y}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2\\operatorname{ln}⁡y}{y}, & \\,1\\le y\\le e \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $1\\le x\\le {e}^{2},\\,1\\le y\\le e,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\left(\\frac{\\operatorname{ln}⁡y}{xy}\\right)}{\\left(\\frac{2\\operatorname{ln}⁡y}{y}\\right)} \\\\  & =\\frac{1}{2x}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{1}{2x}, & \\,1\\le x\\le {e}^{2},\\,1\\le y\\le e \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145a62fb-8074-50e4-96e8-e5d92be2f22d" :answer/type {:db/ident :answer.type/math} :answer/value "12({x}^{2}+{y}^{2})" :db/id #edb/ref 17592186656408} {:answer/id #uuid "5fc4d039-b8f3-5a77-a385-a59081014550" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3(3{x}^{2}+1)}" :db/id #edb/ref 17592186656525} {:answer/id #uuid "ddfaafd2-409d-58be-9544-cb3167ed1d7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3({x}^{2}+{y}^{2})}{2(3{x}^{2}+1)}" :db/id #edb/ref 17592186656711} {:answer/id #uuid "edfe1938-91f1-5b50-8e9d-4878d60908c0" :answer/type {:db/ident :answer.type/math} :answer/value "2(3{x}^{2}+1)" :db/id #edb/ref 17592186656732} {:answer/id #uuid "fdd55f87-661d-50f2-8d2b-26de4011c3f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+{y}^{2}}{6}" :db/id #edb/ref 17592186656762}] :answer-field/correct {:db/id #edb/ref 17592186656711} :answer-field/id #uuid "6c1ca7b0-1b49-57c1-bb47-8544ea4fa403" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656808}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ecc4b200-5153-572f-81cf-a8e6a0976b37" :question/math-academy-id "q-143635" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3({x}^{2}+{y}^{2})}{4}, & \\,0\\le x\\le 1,\\,-1\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x\\le 1,\\,-1\\le y\\le 1.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}\\frac{3({x}^{2}+{y}^{2})}{4}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}(\\frac{3{x}^{2}}{4}+\\frac{3{y}^{2}}{4})\\text{d}y \\\\  & ={[\\frac{3{x}^{2}y}{4}+\\frac{{y}^{3}}{4}]}_{y=-1}^{y=1} \\\\  & =\\frac{3{x}^{2}}{4}+\\frac{1}{4}-[-\\frac{3{x}^{2}}{4}-\\frac{1}{4}] \\\\  & =\\frac{3{x}^{2}}{2}+\\frac{1}{2} \\\\  & =\\frac{3{x}^{2}+1}{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3{x}^{2}+1}{2}, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le 1,\\,-1\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\left(\\frac{3({x}^{2}+{y}^{2})}{4}\\right)}{\\left(\\frac{3{x}^{2}+1}{2}\\right)} \\\\  & =\\frac{3({x}^{2}+{y}^{2})}{2(3{x}^{2}+1)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{3({x}^{2}+{y}^{2})}{2(3{x}^{2}+1)}, & \\,0\\le x\\le 1,\\,-1\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186656950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0094fe4e-da13-566f-9b2a-2df97c10411d" :answer/type {:db/ident :answer.type/math} :answer/value "12{x}^{3}y" :db/id #edb/ref 17592186656386} {:answer/id #uuid "3f39b6ee-a9c1-5280-b790-d754e681ca88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12xy}{1-{x}^{2}}" :db/id #edb/ref 17592186656475} {:answer/id #uuid "8e2f0705-44c6-58fb-8825-ba5e2c41155a" :answer/type {:db/ident :answer.type/math} :answer/value "24xy" :db/id #edb/ref 17592186656603} {:answer/id #uuid "9d6adbae-7c27-57a2-9993-c1a4a0d8ebdd" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{2}y" :db/id #edb/ref 17592186656627} {:answer/id #uuid "d1d47878-76f4-593d-81c8-b49c0a92418d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6y}{x(1-{x}^{2})}" :db/id #edb/ref 17592186656694}] :answer-field/correct {:db/id #edb/ref 17592186656603} :answer-field/id #uuid "a406300b-e680-5b76-9258-f9ba4865babf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f52f1079-3c52-5b6b-99fe-2d88ab748a64" :question/math-academy-id "q-143611" :question/problem "$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{{x}^{2}(1-{x}^{2})}, & 0<x<1,\\,{x}^{2}\\le y\\le x \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}12{x}^{3}(1-{x}^{2}), & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ and the marginal density function ${f}_{X}(x)$ are shown above. Find the expression of the joint probability density function $f(x,y)$ for $0<x<1,\\,{x}^{2}\\le y\\le x.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nFrom the equation above, it follows that\n\n$$\nf(x,y)={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x).\n$$\n\nNow, for $0<x<1,\\,{x}^{2}\\le y\\le x,$ we have \n\n$$\n\\begin{aligned}f(x,y) & ={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x) \\\\  & =\\frac{2y}{{x}^{2}(1-{x}^{2})}\\cdot 12{x}^{3}(1-{x}^{2}) \\\\  & =24xy.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ equals $0.$ As a result, the product will be equal to $0$ too.\n\nTherefore, the joint probability density function is the following:\n\n$$\nf(x,y)=\\{\\begin{aligned}24xy, & 0<x<1,\\,{x}^{2}\\le y\\le x \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56dcbd22-9361-5ca9-8361-8343c7b2acbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{6}" :db/id #edb/ref 17592186657150} {:answer/id #uuid "897f5c19-d50b-5076-ba88-91115fe4fd90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186657211} {:answer/id #uuid "d95740d3-113a-5500-a8ab-47616c21a1f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186657302} {:answer/id #uuid "fb39460d-932f-5bfe-b150-cca9091953d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186657340} {:answer/id #uuid "fc6b25cf-ed45-533d-bf66-1acdec702e77" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186657342}] :answer-field/correct {:db/id #edb/ref 17592186657211} :answer-field/id #uuid "c68f65b5-e44e-5950-a9c8-8a254fd14670" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657417}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0653bec4-9054-52e1-a128-d64ae29498b2" :question/math-academy-id "q-146244" :question/problem "$$\n{f}_{Y\\,|\\,X}(y\\,|\\,0.5)=\\{\\begin{aligned}4y, & \\,0\\le y\\le \\frac{\\sqrt{2}}{2} \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n  \n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional expected value $\\text{E}[Y\\,|\\,X=0.5]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,0.5)$ is shown above." :question/worked-solution "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=0.5] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,0.5)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\sqrt{2}/2}y\\cdot 4y\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\sqrt{2}/2}4{y}^{2}\\,\\text{d}y \\\\  & ={[\\frac{4{y}^{3}}{3}]}_{0}^{\\sqrt{2}/2} \\\\  & =\\frac{4}{3}({\\left(\\frac{\\sqrt{2}}{2}\\right)}^{3}-0) \\\\  & =\\frac{\\sqrt{2}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5401d87f-8225-5438-b56a-9702d0933107" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{50}" :db/id #edb/ref 17592186657147} {:answer/id #uuid "85a4c3f1-3150-59f5-9e9d-8423b96c2348" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{52}" :db/id #edb/ref 17592186657202} {:answer/id #uuid "876ac783-f3bc-5e81-b803-29e72edba95a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{45}" :db/id #edb/ref 17592186657204} {:answer/id #uuid "c7f5b453-c8f6-5154-93e1-de63649940b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{52}" :db/id #edb/ref 17592186657276} {:answer/id #uuid "e58cdd5b-f3a4-5edc-8508-9fa1473e6f5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{45}" :db/id #edb/ref 17592186657315}] :answer-field/correct {:db/id #edb/ref 17592186657202} :answer-field/id #uuid "c3b2e25a-e882-5c0c-92a4-15631a11f0f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657415}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f893190-f46a-5967-80ff-8ef9fa2416da" :question/math-academy-id "q-146229" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,0.5)=\\{\\begin{aligned}\\frac{3({x}^{2}+4)}{13}, & \\,\\,0\\le x\\le 1 \\\\ 0, & \\,\\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. Find the conditional expected value $\\text{E}[X\\,|\\,Y=0.5]$  given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,0.5)$ is shown above." :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain  \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=0.5] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,0.5)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\frac{3({x}^{2}+4)}{13}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3({x}^{3}+4x)}{13}\\,\\text{d}x \\\\  & =\\frac{3}{13}{[\\frac{{x}^{4}}{4}+2{x}^{2}]}_{0}^{1} \\\\  & =\\frac{3}{13}(\\frac{1}{4}+2) \\\\  & =\\frac{27}{52}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158f57b1-0ff4-5a44-9a98-acba44532c0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{45}{28}" :db/id #edb/ref 17592186657078} {:answer/id #uuid "af036b17-c161-56d3-87f1-b66f801e6d2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186657248} {:answer/id #uuid "b835c4cc-b99d-5a2b-a69c-710295a1e2e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186657258} {:answer/id #uuid "d64563a0-ee88-5d6e-8d74-a0e22101fe93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{7}" :db/id #edb/ref 17592186657297} {:answer/id #uuid "f1f665bb-84ba-500f-9818-e901d203da1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{14}" :db/id #edb/ref 17592186657331}] :answer-field/correct {:db/id #edb/ref 17592186657078} :answer-field/id #uuid "e83cbdd1-d69e-5e93-b7af-893996c0d715" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657428}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "586f2079-1d27-5ef8-9268-295136ba7bbd" :question/math-academy-id "q-146171" :question/problem "$$\n{f}_{X\\,|\\,Y}(x\\,|\\,1)=\\{\\begin{aligned}\\frac{3{x}^{2}}{7}, & \\,\\,1\\le x\\le 2 \\\\ 0, & \\,\\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional expected value $\\text{E}[X\\,|\\,Y=1]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,1)$ is shown above." :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot \\frac{3{x}^{2}}{7}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{3{x}^{3}}{7}\\,\\text{d}x \\\\  & ={[\\frac{3{x}^{4}}{28}]}_{1}^{2} \\\\  & =\\frac{48}{28}-\\frac{3}{28} \\\\  & =\\frac{45}{28}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059e691d-6f53-58ef-a124-e4fa63992e02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{14}" :db/id #edb/ref 17592186657053} {:answer/id #uuid "385d5c3a-7e66-5f8a-ad2d-52c905c382be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186657120} {:answer/id #uuid "6954b775-e676-5779-8987-fde1d7f6915a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{7}" :db/id #edb/ref 17592186657170} {:answer/id #uuid "7f5d19c0-9d37-5460-b644-7b9610b4bf7c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186657193} {:answer/id #uuid "cc84c0dc-4232-5d9b-a321-06b4724eafd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186657286}] :answer-field/correct {:db/id #edb/ref 17592186657053} :answer-field/id #uuid "f5d24684-dfbf-513f-9f7a-8c6bc7d74ed9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657432}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d1bf7573-e07d-58dc-b71a-4aa86d221a80" :question/math-academy-id "q-146247" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,2)=\\{\\begin{aligned}\\frac{3(4{x}^{2}+1)}{7}, & \\,\\,0\\le x\\le 1 \\\\ 0, & \\,\\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. Find the conditional expected value $\\text{E}[X\\,|\\,Y=2]$  given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,2)$ is shown above." :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain  \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=2] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,2)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\frac{3(4{x}^{2}+1)}{7}\\,\\text{d}x \\\\  & =\\frac{3}{7}{\\int }_{0}^{1}(4{x}^{3}+x)\\,\\text{d}x \\\\  & =\\frac{3}{7}{[{x}^{4}+\\frac{{x}^{2}}{2}]}_{0}^{1} \\\\  & =\\frac{3}{7}(1+\\frac{1}{2}-0) \\\\  & =\\frac{9}{14}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186658253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58033655-e35d-5a4f-bec8-5cf527ea74f4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186657859} {:answer/id #uuid "9f123bb4-e775-57ed-93bd-edc06761b85b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186657975} {:answer/id #uuid "a649e694-3e6b-509b-885d-1dd9a11e3979" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186657999} {:answer/id #uuid "ea92184b-23c4-5de8-be1f-0af9594b726d" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186658116} {:answer/id #uuid "f88d9585-9b8c-59ab-9a50-d850950cb37c" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186658136}] :answer-field/correct {:db/id #edb/ref 17592186657975} :answer-field/id #uuid "20ad758e-e629-5f37-bdb0-82dd6d6c942a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "053fb4de-627f-5129-9fea-caf9848d3150" :question/math-academy-id "q-346684" :question/problem "Consider the function\n\n$$\nf(x)=1[x\\ge -2]\\cdot {x}^{2}+1[x<-2]\\cdot (-x).\n$$\n\nWhat is $f(-4)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nFor $x=-4,$ we evaluate each indicator function:\n\n- $1[x\\ge -2]=1[-4\\ge -2]=0$ (since $-4\\ge -2$ is false)\n\n- $1[x<-2]=1[-4<-2]=1$ (since $-4<-2$ is true)\n\nSubstituting into the expression for $f(x),$ we get\n\n$$\n\\begin{aligned}f(-4) & =1[-4\\ge -2]\\cdot (-4)^{2}+1[-4<-2]\\cdot (-(-4)) \\\\  & =0\\cdot 16+1\\cdot 4 \\\\  & =4.\\end{aligned}\n$$\n\nNote that the indicator functions act as a \"switch\": since $x=-4<-2,$ the first term vanishes and only the second term contributes to the result."}] [{:db/id #edb/ref 17592186658256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1d9fbd-0033-516b-b42f-85ee740b5c61" :answer/type {:db/ident :answer.type/math} :answer/value "1[-2=G]" :db/id #edb/ref 17592186657740} {:answer/id #uuid "26792dad-524e-54a2-86c2-e31423455792" :answer/type {:db/ident :answer.type/math} :answer/value "1[-2\\in \\{-4,-2,0,6\\}]" :db/id #edb/ref 17592186657779} {:answer/id #uuid "57219ae8-cbd0-5da7-950d-6b46e150b8dd" :answer/type {:db/ident :answer.type/math} :answer/value "1[G\\in \\{-4,-2,0,6\\}]" :db/id #edb/ref 17592186657856} {:answer/id #uuid "8da55f1e-b1da-5249-bc2e-736df5c75e32" :answer/type {:db/ident :answer.type/math} :answer/value "1[\\{-4,-2,0,6\\}\\in -2]" :db/id #edb/ref 17592186657946} {:answer/id #uuid "a4da3dcb-a36b-5679-986d-028b73c9d8e3" :answer/type {:db/ident :answer.type/math} :answer/value "1[-2\\notin \\{-4,-2,0,6\\}]" :db/id #edb/ref 17592186657994}] :answer-field/correct {:db/id #edb/ref 17592186657779} :answer-field/id #uuid "cf13f891-5c5b-521d-89b5-e2997b6c86c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658233}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c0b035c-6b0c-581e-9748-b85e98f22385" :question/math-academy-id "q-351126" :question/problem "Let $G=\\{-4,-2,0,6\\}.$ Which of the following is equivalent to ${1}_{G}(-2)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{G}(x)$ of a set $G$ equals $1$ if $x\\in G$ and $0$ if $x\\notin G.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{G}(x)=1[x\\in G].\n$$\n\nTherefore, we have\n\n$$\n{1}_{G}(-2)=1[-2\\in G]=1[-2\\in \\{-4,-2,0,6\\}].\n$$"}] [{:db/id #edb/ref 17592186658272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252fa619-51a9-5f5f-8aeb-d561460d2a9c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186657775} {:answer/id #uuid "2fc039a1-3f1b-56c7-b1a4-e2a5284de72f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186657795} {:answer/id #uuid "5042827a-adb9-5151-ae08-fd984efb23bb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186657846} {:answer/id #uuid "e9bc4290-7dd2-5860-aaf8-ea6f321cb8ef" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186658113} {:answer/id #uuid "f9deb4f8-4151-5010-93d8-ecdcd0148c57" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186658138}] :answer-field/correct {:db/id #edb/ref 17592186658138} :answer-field/id #uuid "a78834b8-5b41-5690-8baa-f3645a9ba2eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658215}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3d380694-9332-5d76-a72a-3dcce6967ae3" :question/math-academy-id "q-351124" :question/problem "Evaluate the indicator function\n$1[-2>-5].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $-2>-5.$ Since $-2$ is greater than $-5,$ the predicate is true. Therefore,\n\n$$\n1[-2>-5]=1.\n$$"}] [{:db/id #edb/ref 17592186658278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43304d4b-f122-56d8-9d94-fed8c2a6144c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186657829} {:answer/id #uuid "71059a3a-7003-5ff6-941a-ae2c90c0884d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186657896} {:answer/id #uuid "746a18bc-d50d-5e43-a59e-cf3c054fe0a4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186657901} {:answer/id #uuid "a4aa0f69-98a2-5112-b5bf-38d2161f5545" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186657991} {:answer/id #uuid "ec012485-a52b-5970-9361-dc87ed42a6a5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186658119}] :answer-field/correct {:db/id #edb/ref 17592186657901} :answer-field/id #uuid "f782c06b-da39-501e-ad43-f10905e50617" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658249}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4e80d14f-2d0c-596d-b3ec-746733112e6d" :question/math-academy-id "q-346655" :question/problem "Evaluate the indicator function\n$1[-4<-10].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $-4<-10.$ Since $-4$ is not less than $-10,$ the predicate is false. Therefore,\n\n$$\n1[-4<-10]=0.\n$$"}] [{:db/id #edb/ref 17592186658297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c396b13-2b67-50f3-88a7-4409e6ad3177" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186657765}] :answer-field/correct {:db/id #edb/ref 17592186657765} :answer-field/id #uuid "2418a47a-b4c4-5e73-a6ff-64ee34cde265" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186658159}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8558ce44-a610-50fd-adab-39fbdfaa0f3d" :question/math-academy-id "q-347930" :question/problem "$$\n{x}_{1}=-2,\\,{x}_{2}=5,\\,{x}_{3}=-7,\\,{x}_{4}=0,\\,{x}_{5}=3\n$$\n\nGiven the values ${x}_{1},\\,{x}_{2},\\,{x}_{3},\\,{x}_{4},\\,{x}_{5}$ above, we have\n\n$$\n\\displaystyle {\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot ({x}_{i}+2)+1[{x}_{i}<0]\\cdot (-1)=\n$$ {{field-1}}." :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nThe expression $1[{x}_{i}\\ge 0]\\cdot ({x}_{i}+2)+1[{x}_{i}<0]\\cdot (-1)$ equals ${x}_{i}+2$ when ${x}_{i}\\ge 0$ and equals $-1$ when ${x}_{i}<0.$ Thus, the sum\n\n$$\n{\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot ({x}_{i}+2)+1[{x}_{i}<0]\\cdot (-1)\n$$\n\nadds ${x}_{i}+2$ for nonnegative values and $-1$ for negative values.\n\nWe evaluate the indicator function for each ${x}_{i}:$\n\n- $1[{x}_{1}\\ge 0]=1[-2\\ge 0]=0,$ $1[{x}_{1}<0]=1$\n\n- $1[{x}_{2}\\ge 0]=1[5\\ge 0]=1,$ $1[{x}_{2}<0]=0$\n\n- $1[{x}_{3}\\ge 0]=1[-7\\ge 0]=0,$ $1[{x}_{3}<0]=1$\n\n- $1[{x}_{4}\\ge 0]=1[0\\ge 0]=1,$ $1[{x}_{4}<0]=0$\n\n- $1[{x}_{5}\\ge 0]=1[3\\ge 0]=1,$ $1[{x}_{5}<0]=0$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot ({x}_{i}+2)+1[{x}_{i}<0]\\cdot (-1) & =(-1)+(5+2)+(-1)+(0+2)+(3+2) \\\\  & =-1+7-1+2+5 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186658309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a84b24-9e3e-5ef2-934b-8ef779284068" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{G}(2)" :db/id #edb/ref 17592186657725} {:answer/id #uuid "1b209606-c4b2-5d70-b037-d2afbfd0c232" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{G}(1)" :db/id #edb/ref 17592186657762} {:answer/id #uuid "2c5a2ed6-763a-5a9e-9222-d87c00efe741" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{2}(G)" :db/id #edb/ref 17592186657788} {:answer/id #uuid "be4a63de-61a5-5cc2-baa5-9fd054b10b9c" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{\\{-8,-4,1,5\\}}(G)" :db/id #edb/ref 17592186658037} {:answer/id #uuid "e58f13b5-fe1b-5752-9b58-a835a882bf01" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{2}(-8)" :db/id #edb/ref 17592186658110}] :answer-field/correct {:db/id #edb/ref 17592186657725} :answer-field/id #uuid "f4b18da3-7e90-593e-aed5-b6bc2e454913" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658246}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d2af66c-b298-56f4-b79c-a30e24c13d8e" :question/math-academy-id "q-351131" :question/problem "Let $G=\\{-8,-4,1,5\\}.$ Which of the following is equivalent to $1[2\\in G]?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{A}(x)$ of a set $A$ equals $1$ if $x\\in A$ and $0$ if $x\\notin A.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{A}(x)=1[x\\in A].\n$$\n\nHere, the Iverson bracket expression $1[2\\in G]$ has $x=2$ and $A=G.$ Therefore, converting back to set indicator notation, we have\n\n$$\n1[2\\in G]={1}_{G}(2).\n$$"}] [{:db/id #edb/ref 17592186658314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b748bf-fa22-5a15-aa5b-693a53fb0de2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186657723} {:answer/id #uuid "1edd492f-3b6a-583c-9a9d-bd497014c99e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186657766} {:answer/id #uuid "7dbbd03a-7e80-5e3e-8e8b-f34516a8339e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186657914} {:answer/id #uuid "cae25145-5a4f-561a-bada-62cc709d4c72" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186658064} {:answer/id #uuid "f64275a3-7786-5b53-a621-45b70f1b7e25" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186658130}] :answer-field/correct {:db/id #edb/ref 17592186658130} :answer-field/id #uuid "94dd2e81-d828-54c0-9b24-adcddd21cb87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658204}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7c0cdf2-0b57-5ba5-b53a-626934bff9f1" :question/math-academy-id "q-351125" :question/problem "Evaluate the indicator function\n$1[-4\\in \\{-6,-4,0,9\\}].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $-4\\in \\{-6,-4,0,9\\}.$ Since $-4$ is an element of the set $\\{-6,-4,0,9\\},$ the predicate is true. Therefore,\n\n$$\n1[-4\\in \\{-6,-4,0,9\\}]=1.\n$$"}] [{:db/id #edb/ref 17592186658322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "428a9cc9-0a92-5357-9000-7a7a2c6a94da" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{D}(-1)" :db/id #edb/ref 17592186657828} {:answer/id #uuid "7b20fa8a-5a2d-520e-9c7a-4f6066461f64" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{D}(-2)" :db/id #edb/ref 17592186657908} {:answer/id #uuid "90f38f97-e521-58d7-8008-a355bfffdb3e" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{\\{-5,-2,0,6\\}}(D)" :db/id #edb/ref 17592186657950} {:answer/id #uuid "a0a36513-a9ca-55ba-bdb0-6846b0aee343" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{-1}(D)" :db/id #edb/ref 17592186657980} {:answer/id #uuid "bb2c23a9-df41-5a7a-9f2c-d4840f11665f" :answer/type {:db/ident :answer.type/math} :answer/value "{1}_{-1}(-5)" :db/id #edb/ref 17592186658031}] :answer-field/correct {:db/id #edb/ref 17592186657828} :answer-field/id #uuid "c7083a4c-5c3d-5a94-a15a-8a624c26d1ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658230}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "be0bda7b-1c9e-5518-9546-220ed2564bc4" :question/math-academy-id "q-351128" :question/problem "Let $D=\\{-5,-2,0,6\\}.$ Which of the following is equivalent to $1[-1\\in D]?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{A}(x)$ of a set $A$ equals $1$ if $x\\in A$ and $0$ if $x\\notin A.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{A}(x)=1[x\\in A].\n$$\n\nHere, the Iverson bracket expression $1[-1\\in D]$ has $x=-1$ and $A=D.$ Therefore, converting back to set indicator notation, we have\n\n$$\n1[-1\\in D]={1}_{D}(-1).\n$$"}] [{:db/id #edb/ref 17592186658326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d2494c0-0477-5038-9ffe-0510e8e26821" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186657866} {:answer/id #uuid "ab85f157-d935-5975-9782-22b0e72e002d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186658007} {:answer/id #uuid "bb2b0eff-c855-5cd4-90ad-680c1cfe237c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186658030} {:answer/id #uuid "be0c3bc7-37d2-56ca-a1c4-c387b83be85c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186658036} {:answer/id #uuid "ea0b5880-ec93-5d36-945d-0b28f5f993b2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186658115}] :answer-field/correct {:db/id #edb/ref 17592186658030} :answer-field/id #uuid "cf349591-c8c6-55bc-b8eb-e51a2c6ad8d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658234}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c1049591-21b6-5e7c-8a74-0c355e90f613" :question/math-academy-id "q-347436" :question/problem "Consider the function\n\n$$\nq(x)=1[x\\ge 3]\\cdot (x-1)^{2}+1[0\\le x<3]\\cdot (-x)+1[x<0]\\cdot 2.\n$$\n\nWhat is $q(2)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nFor $x=2,$ we evaluate each indicator function:\n\n- $1[x\\ge 3]=1[2\\ge 3]=0$ (since $2\\ge 3$ is false)\n\n- $1[0\\le x<3]=1[0\\le 2<3]=1$ (since $0\\le 2<3$ is true)\n\n- $1[x<0]=1[2<0]=0$ (since $2<0$ is false)\n\nSubstituting into the expression for $q(x),$ we get\n\n$$\n\\begin{aligned}q(2) & =0\\cdot {1}^{2}+1\\cdot (-2)+0\\cdot 2 \\\\  & =-2.\\end{aligned}\n$$\n\nNote that the indicator functions act as a \"switch\": since $0\\le x<3,$ only the second term contributes to the result."}] [{:db/id #edb/ref 17592186658927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b944d63-ff86-5407-b3c8-21bc07bc68f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186658442} {:answer/id #uuid "45005735-cf08-59da-8d13-504a3e18a132" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186658503} {:answer/id #uuid "8ee28e7d-d00b-5928-b28a-796caef93ebe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186658609} {:answer/id #uuid "b1f003a1-25ac-5e04-a11c-a2fc11007ecf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186658664} {:answer/id #uuid "bf70ccd9-c54b-5145-8f15-6330ff600b83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186658693}] :answer-field/correct {:db/id #edb/ref 17592186658442} :answer-field/id #uuid "5b5356f7-1c3f-587a-9654-287703065753" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658854}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "31cc515e-9ee0-59f4-8461-71fdfae272d2" :question/math-academy-id "q-96813" :question/problem "Given $X∼U\\{6,7,8,…,21\\},$ compute $P(X\\ge 14).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{6,7,8,…,21\\},$ and the set $S=\\{6,7,8,…,21\\}$ has $|S|=21-6+1=16$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{16}, & x=6,7,8,…,21 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X\\ge 14$ are $14,15,16,…21.$ There are $21-14+1=8$ of these items. Therefore,\n\n$$\nP(X\\ge 14)=8\\cdot \\frac{1}{16}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186658933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32094e66-f2fd-513c-b478-d2c03f9c21a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186658476} {:answer/id #uuid "443af7a6-ad94-5396-85de-02868452aa0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186658502} {:answer/id #uuid "615ca1cf-5680-56e0-ae45-3731d4a47b18" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186658550} {:answer/id #uuid "b1c9a4b6-8db5-5d61-be95-935ca6379b41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186658663} {:answer/id #uuid "dd380816-b388-58ee-972c-2c7a4388ed44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186658736}] :answer-field/correct {:db/id #edb/ref 17592186658663} :answer-field/id #uuid "f77266de-a838-5519-94f8-c8e92907b43e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658909}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42c57826-88ab-5103-85bd-405e2329bc0c" :question/math-academy-id "q-164158" :question/problem "Given that $X∼U\\{-3,-2,-1,0,1,2,3\\},$ compute $P(X=0).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{-3,-2,-1,0,1,2,3\\},$ and the set $S=\\{-3,-2,-1,0,1,2,3\\}$ has $|S|=7$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{7}, & x=-3,-2,-1,0,1,2,3 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=\\frac{1}{7}.\n$$"}] [{:db/id #edb/ref 17592186658943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "778ddf6e-59a2-56e2-a0c7-dcecc6fe2c51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186658580} {:answer/id #uuid "8a305e65-a1c8-50df-b6b7-c9b5c0544507" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{36}" :db/id #edb/ref 17592186658603} {:answer/id #uuid "b526749b-374a-509b-8832-46b476b5929a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{35}" :db/id #edb/ref 17592186658667} {:answer/id #uuid "c13d78ef-d80d-5bac-9aaa-33c8829a55a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{35}" :db/id #edb/ref 17592186658699} {:answer/id #uuid "eb8dc9a5-b434-5718-a653-97c72bb4b24b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186658772}] :answer-field/correct {:db/id #edb/ref 17592186658580} :answer-field/id #uuid "e69a7187-dad5-5e85-90c6-7a1b46dcc02c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658900}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5da66830-e1f0-534c-be2b-7a40d3adfcf7" :question/math-academy-id "q-96842" :question/problem "Given $X∼U\\{9,10,11,…,44\\},$ compute $P(11<X<30).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{9,10,11,…,44\\},$ and the set $S=\\{9,10,11,…,44\\}$ has $|S|=44-9+1=36$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{36}, & x=9,10,11,…,44 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $11<X<30$ are $12,13,14,…,29.$ There are $29-12+1=18$ of these items. Therefore,\n\n$$\nP(11<X<30)=18\\cdot \\frac{1}{36}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186658944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177e91fb-b989-5ffc-99bb-aeaf25efd752" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186658432} {:answer/id #uuid "3015378c-550a-5095-ac3e-567c08dc5bc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186658470} {:answer/id #uuid "829de5b2-1176-5202-8894-a187fad63917" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186658593} {:answer/id #uuid "ca695642-7d86-5422-8c5c-cd2b4727b926" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186658708} {:answer/id #uuid "e736fac6-1faf-5cf8-b272-cf60c34b90eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186658758}] :answer-field/correct {:db/id #edb/ref 17592186658593} :answer-field/id #uuid "2d977bda-7909-57c6-b152-8d3028b0e7a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658828}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5f5c28fe-8a58-56fa-9232-ac6131c4ff1c" :question/math-academy-id "q-96836" :question/problem "Given $X∼U\\{2,4,6,7,8,9\\},$ compute $P(6\\le X<8).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{2,4,6,7,8,9\\},$ and the set $S=\\{2,4,6,7,8,9\\}$ has $|S|=6$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{6}, & x=2,4,6,7,8,9 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ there are $2$ items $(6,7)$ that satisfy $6\\le X<8.$ Therefore,\n\n$$\nP(6\\le X<8)=2\\cdot \\frac{1}{6}=\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186658979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "349579e1-a8b7-502b-acf2-a2afa8cb4b22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186658480} {:answer/id #uuid "8e5d64b6-4b18-5729-9533-352e95c8bcf3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186658608} {:answer/id #uuid "be217ad7-5506-5b09-b951-4a97b6358681" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186658691} {:answer/id #uuid "de44130e-8a60-55ad-a915-3c6effc76181" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186658739} {:answer/id #uuid "e8f20f5e-f72b-57ef-b3f8-935cf0911ef3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186658765}] :answer-field/correct {:db/id #edb/ref 17592186658480} :answer-field/id #uuid "40ba1db0-b936-5877-b32b-28bfca326e4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658840}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ca483c63-ab97-549c-b57d-49c221c7ea06" :question/math-academy-id "q-96872" :question/problem "The time a person spends viewing a webpage is uniformly distributed between $1.5$ and $4.5$ minutes, inclusive. What is the probability that a randomly chosen visitor spends more than $2.5$ minutes viewing the page?" :question/worked-solution "Let $X$ represent the time a visitor spends on the webpage. From the problem statement, we know that $X∼U[1.5,4.5],$ and we wish to compute $P(X>2.5).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[1.5,4.5],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{3}, & 1.5\\le x\\le 4.5 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>2.5) & ={\\int }_{2.5}^{4.5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2.5}^{4.5}\\frac{1}{3}\\,\\text{d}x \\\\  & ={\\frac{x}{3}|}_{2.5}^{4.5} \\\\  & =\\frac{4.5}{3}-\\frac{2.5}{3} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186658980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d30bfd-78c4-5ead-8923-223a4751d9f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186658429} {:answer/id #uuid "2672676d-ccef-5a52-9347-fe5e2a73c37c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186658460} {:answer/id #uuid "30a95678-f165-5729-b67f-e5a6cfe35785" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186658471} {:answer/id #uuid "3255ed24-e54a-5078-8bc5-36cca66cc90c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186658477} {:answer/id #uuid "d7189598-d5be-5751-a0c9-580bbd97212d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186658728}] :answer-field/correct {:db/id #edb/ref 17592186658477} :answer-field/id #uuid "527bcc17-f21f-5f4b-8fe4-a7530e5b62d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658847}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cbcb9089-73d8-5195-9864-c4a0f553df90" :question/math-academy-id "q-96871" :question/problem "A nutritionist notices that after following a specific diet, the minimum amount of weight a person will lose during the first month is $5\\,\\text{kg},$ whereas the maximum weight loss is $12\\,\\text{kg}.$ Assuming that the weight loss during the first month is uniformly distributed, what is the probability that a randomly chosen person following the diet loses between $7\\,\\text{kg}$ and $10\\,\\text{kg}$ during the first month?" :question/worked-solution "Let $X$ represent the weight lost during the first month for a randomly chosen person following the diet. From the problem statement, we know that $X∼U[5,12],$ and we wish to compute $P(7\\le X<10).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[5,12],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{7}, & 5\\le x\\le 12 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(7\\le X<10) & ={\\int }_{7}^{10}f(x)\\,\\text{d}x \\\\  & ={\\int }_{7}^{10}\\frac{1}{7}\\,\\text{d}x \\\\  & ={\\frac{x}{7}|}_{7}^{10} \\\\  & =\\frac{10}{7}-\\frac{7}{7} \\\\  & =\\frac{3}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186658987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f88b155-0a7b-52bf-892e-7b4846ac0019" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id #edb/ref 17592186658611} {:answer/id #uuid "a088be53-f5d9-5c0f-bf71-0dba8302090f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186658637} {:answer/id #uuid "b866f08a-3741-50e8-90c1-0ab11df2f11e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186658676} {:answer/id #uuid "ba846fd8-6b5f-5eb9-b0db-0b2023962758" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186658682} {:answer/id #uuid "f940e293-3a7b-5728-8029-5153d63f868d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{11}" :db/id #edb/ref 17592186658795}] :answer-field/correct {:db/id #edb/ref 17592186658682} :answer-field/id #uuid "32f788aa-5a83-5b74-9fa3-e3c670ead926" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658831}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e41905aa-d937-5f9f-8905-d92ccc1c0cbf" :question/math-academy-id "q-164161" :question/problem "Given $X∼U\\{-5,-4,-3,…,6\\},$ compute $P(X\\ge 3).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{-5,-4,-3,…,6\\},$ and the set $S=\\{-5,-4,-3,…,6\\}$ has $|S|=6-(-5)+1=12$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{12}, & x=-5,-4,-3,…,6 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X\\ge 3$ are $3,4,5,6.$ There are $4$ of these items. Therefore,\n\n$$\nP(X\\ge 3)=4\\cdot \\frac{1}{12}=\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186658990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b34e8a4-6e59-5c1b-9b61-cf29d29f2252" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{18}" :db/id #edb/ref 17592186658420} {:answer/id #uuid "339cb044-3b41-5605-866b-59a0bb4bba24" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186658479} {:answer/id #uuid "b56f94e4-bd2c-5581-ba5a-149bb0762e42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{11}" :db/id #edb/ref 17592186658668} {:answer/id #uuid "e6943948-65f2-5706-ac0e-1bb825abe2e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186658756} {:answer/id #uuid "ed664e2d-9b02-59cf-8a19-5b4baf0ce313" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186658775}] :answer-field/correct {:db/id #edb/ref 17592186658775} :answer-field/id #uuid "8f405ca4-9f96-5da3-ba39-a83cc7f4bdba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658871}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e57e73cb-25aa-5731-beaa-eeda09a9556c" :question/math-academy-id "q-96775" :question/problem "Given that $X∼U\\{9,10,11,…,18\\},$ compute $P(X=11).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{9,10,11,…,18\\},$ and the set $S=\\{9,10,11,…,18\\}$ has $|S|=18-9+1=10$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{10}, & x=9,10,11,…,18 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=11)=f(11)=\\frac{1}{10}.\n$$"}] [{:db/id #edb/ref 17592186658994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52d214ca-68dc-59be-9f0e-7a28e4da04e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186658531} {:answer/id #uuid "56b35321-4697-55e3-9de1-397a7a50482c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{17}" :db/id #edb/ref 17592186658537} {:answer/id #uuid "b4ce13b7-11e8-5357-9fcb-35613ad73fcd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{25}" :db/id #edb/ref 17592186658666} {:answer/id #uuid "bc21a4a8-943b-53cc-9dd8-faa5c470152c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{125}" :db/id #edb/ref 17592186658688} {:answer/id #uuid "daed359a-e8d6-5bae-b74e-694c11a224d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186658734}] :answer-field/correct {:db/id #edb/ref 17592186658666} :answer-field/id #uuid "23b85f6f-bec4-5fe5-badb-562b8c3b9645" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658826}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "edc5f6f5-35a2-557f-b6a2-66fd780cc53f" :question/math-academy-id "q-96740" :question/problem "The water height in a particular dam is uniformly distributed between $165$ and $290$ meters, inclusive. What is the probability that the water height level is $250$ meters or less?" :question/worked-solution "Let $X$ represent the height of water. From the problem statement, we know that $X∼U[165,290],$ and we wish to compute $P(X\\le 250).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[165,290],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{125}, & 165\\le x\\le 290 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 250) & ={\\int }_{165}^{250}f(x)\\,\\text{d}x \\\\  & ={\\int }_{165}^{250}\\frac{1}{125}\\,\\text{d}x \\\\  & ={\\frac{x}{125}|}_{165}^{250} \\\\  & =\\frac{250}{125}-\\frac{165}{125} \\\\  & =\\frac{17}{25}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c50180e-eb4d-59ad-bd08-f4dbffdb184c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{8},\\, & 1<y<8 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659109} {:answer/id #uuid "6b077a93-423c-59a9-8bf4-2321bf692b8f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2y-2,\\, & 1<y<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659272} {:answer/id #uuid "770d9ff3-e479-5623-a97a-7968019ed159" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2-2y,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659297} {:answer/id #uuid "c92b840a-ac97-5a8d-b10a-fe83b4be8f9f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659431} {:answer/id #uuid "f6e6e932-26c5-57d2-9be7-fa8e55cb3931" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 1<y<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659517}] :answer-field/correct {:db/id #edb/ref 17592186659517} :answer-field/id #uuid "c31b35f6-5998-5f2f-a039-6f43a5412247" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659628}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "077ba357-e35d-5ff4-9dde-9b16b336d6fd" :question/math-academy-id "q-110342" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{3\\sqrt[3]{{x}^{2}}},\\, & 1<x<8 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\sqrt[3]{X},$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=\\sqrt[3]{X}$ is a strictly increasing function of $X.$ Moreover, for $1<x<8,$ we have $1<y<2.$\n\n![](images/21/21d19426e86916c123e898bf5427ef858784a601eedb861ba55e22855912005c.png)\n\n*Note: Image not drawn to scale.*\n\nNow, using the definition of the cumulative distribution of $Y,$ for $1<y<2,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(\\sqrt[3]{X}\\le y) \\\\  & =P(X\\le {y}^{3}) \\\\  & =F({y}^{3})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $1<y<2,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =3{y}^{2}\\cdot {F}_{X}^{′}({y}^{3}) \\\\  & =3{y}^{2}\\cdot {f}_{X}({y}^{3}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =3{y}^{2}\\cdot {f}_{X}({y}^{3}) \\\\  & =3{y}^{2}\\cdot \\frac{1}{3\\sqrt[3]{({y}^{3})^{2}}} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 1<y<2 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef9efab-de54-5588-8d35-f85d1bf316f1" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+4}{16}, & \\,0<y<8 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659143} {:answer/id #uuid "7714fb7b-488f-57f0-90c1-583df7b07368" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+4}{24}, & \\,0<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659298} {:answer/id #uuid "9214a391-1f60-5728-834a-7d5a5e05cdeb" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+1}{40}, & \\,0<y<8 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659341} {:answer/id #uuid "e3ddbd04-1775-55a0-8fb8-f3331e621915" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+4}{64}, & \\,0<y<8 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659474} {:answer/id #uuid "ec4aaf1e-5ff6-5b4a-8c16-59865a592b57" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4y+1}{16}, & \\,0<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659495}] :answer-field/correct {:db/id #edb/ref 17592186659474} :answer-field/id #uuid "6a9f4da2-6689-58f5-a818-db866ba2868b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659586}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e0ac04f-7790-59fb-9e61-95d62106a25e" :question/math-academy-id "q-151983" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{x+1}{4},\\, & 0<x<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=4X,$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ in terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=4X$ is a strictly increasing function of $X.$  Moreover, for $0<x<2,$ we have $0<y<8.$\n\n![](images/96/96df3a12ff46d4f07a12beb3ffb89bee427da352ee0e7b4c42dea3a19e923a5f.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $0<y<8,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(4X\\le y) \\\\  & =P(X\\le \\frac{y}{4}) \\\\  & ={F}_{X}\\left(\\frac{y}{4}\\right)\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $0<y<8,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =\\frac{1}{4}\\cdot {F}_{X}^{′}\\left(\\frac{y}{4}\\right) \\\\  & =\\frac{1}{4}\\cdot {f}_{X}\\left(\\frac{y}{4}\\right).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{4}\\cdot {f}_{X}\\left(\\frac{y}{4}\\right) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\frac{y}{4}+1}{4} \\\\  & =\\frac{y+4}{64}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+4}{64}, & \\,0<y<8 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148e0736-2fdd-595f-bab6-7e49a721a7bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186659096} {:answer/id #uuid "2be8b18c-03fe-5930-93ff-b5c58bdd3183" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186659137} {:answer/id #uuid "36dddec5-032e-59a9-8dc9-719983a2b2a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186659167} {:answer/id #uuid "72a78dee-0269-55d2-894d-fb3ce6325398" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{24}" :db/id #edb/ref 17592186659288} {:answer/id #uuid "87bcd05c-c09f-5afa-ab7b-706573fda6e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186659325}] :answer-field/correct {:db/id #edb/ref 17592186659137} :answer-field/id #uuid "6a912ed6-2d60-5161-82db-75a24dbd793d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659585}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ea6358e-04c4-5bb0-93fe-be896f42486d" :question/math-academy-id "q-143737" :question/problem "![](images/48/483c019e9c68f857379192d2b40ab84803c4360ca4e0158adc0a8a3bc1636c4e.png)\n\nLet $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}+\\frac{8}{9}xy, & (x,y)\\in D, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(\\frac{1}{2},\\frac{5}{2}).$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the point $(\\frac{1}{2},\\frac{5}{2})$ on our diagram. Let's also consider the region $Δ$ that lies below and to the left of this point.\n\n![](images/dd/dde332e904cf9cbd8a1badf80722ca0d4221b23f0eb259d6048be3b821b66995.png)\n\nUsing the definition of the joint CDF, we have\n\n$$\nF(\\frac{1}{2},\\frac{5}{2})=P(X<\\frac{1}{2},Y<\\frac{5}{2})={\\int }_{-\\infty }^{5/2}{\\int }_{-\\infty }^{1/2}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=\\{(x,y)\\,:\\,0\\le x\\le \\frac{1}{2},\\,1\\le y\\le 2\\}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{5/2}{\\int }_{-\\infty }^{1/2}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={\\int }_{1}^{2}{\\int }_{0}^{1/2}({u}^{2}+\\frac{8}{9}uv)\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{1}^{2}{[\\frac{{u}^{3}}{3}+\\frac{4}{9}{u}^{2}v]}_{u=0}^{u=1/2}\\,\\text{d}v \\\\  & ={\\int }_{1}^{2}(\\frac{1}{24}+\\frac{v}{9})\\text{d}v \\\\  & ={[\\frac{v}{24}+\\frac{{v}^{2}}{18}]}_{v=1}^{v=2} \\\\  & =(\\frac{1}{12}+\\frac{2}{9})-(\\frac{1}{24}+\\frac{1}{18}) \\\\  & =\\frac{5}{24}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ea0221-8284-5d08-b184-31a5ed70d816" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186659155} {:answer/id #uuid "67a1b8be-d8a7-54e1-8614-279ccc9ed85d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186659262} {:answer/id #uuid "6871944e-9f33-5b34-b0f9-5fe3c5c2889e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{{y}^{2}}" :db/id #edb/ref 17592186659264} {:answer/id #uuid "f4ec54e8-f64d-5a91-8702-f250673a1fab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186659513} {:answer/id #uuid "f553b8a1-2ecd-5919-8ceb-66b5495702ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x}{9{y}^{2}}" :db/id #edb/ref 17592186659514}] :answer-field/correct {:db/id #edb/ref 17592186659155} :answer-field/id #uuid "efa96905-700f-5662-b7cf-cdc2718bcf4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659655}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "20738af8-8849-5514-801c-7291c61748c7" :question/math-academy-id "q-143662" :question/problem "Let $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{8x}{9{y}^{2}}, & 1\\le x\\le 2,\\,1\\le y\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the corresponding joint CDF when $x>2,\\,y>4.$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the region $D$ in the $uv$-plane where the function $f(u,v)$ is nonzero. Let's also consider a point $(x,y)$ where $x>2,\\,y>4,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/64/64429752a067b28b7baafbfa99dc9a6deb8e9f3cff9ab0c44dd297defb09f8a4.png)\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=D.\n$$\n\n \n\nSo our region $Δ$ covers the entire region where $f(x,y)$ is nonzero. Therefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={∬}_{D}f(u,v)\\,\\text{d}u\\,\\text{d}v=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fd9541-89ff-52d3-9c12-a857f84b8220" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3{y}^{2}}{8},\\, & 0<y<2 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659077} {:answer/id #uuid "05a6316b-606d-5335-9a6e-65a8fda57a03" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3y}{2},\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659081} {:answer/id #uuid "77a674e8-ae88-5259-860f-ae5a68839cb9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{8}\\sqrt{2y},\\, & 0<y<2 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659299} {:answer/id #uuid "88b50688-e6ed-53f4-8e12-08497f383a3a" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2},\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659327} {:answer/id #uuid "b54353de-5e77-5800-b2b3-32ddf75dc165" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2y,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659405}] :answer-field/correct {:db/id #edb/ref 17592186659327} :answer-field/id #uuid "af7bd651-04d5-53d0-8333-cf249dbc0afc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659616}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "69a4d1e9-a233-52f6-9283-b668a8b6ba68" :question/math-academy-id "q-151996" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3\\sqrt{x}}{2},\\, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\sqrt{X},$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ in terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=\\sqrt{X}$ is a strictly increasing function of $X.$ Moreover, for $0<x<1,$ we have $0<y<1.$\n\n![](images/26/26d742853a76c8af3ef1c55a6d6f728e38a3c891b4416bc4a80936968cfca76b.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $0<y<1,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(\\sqrt{X}\\le y) \\\\  & =P(X\\le {y}^{2}) \\\\  & ={F}_{X}({y}^{2}).\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $0<y<1,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =2y\\cdot {F}_{X}^{′}({y}^{2}) \\\\  & =2y\\cdot {f}_{X}({y}^{2}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =2y\\cdot {f}_{X}({y}^{2}) \\\\  & =2y\\cdot \\frac{3\\sqrt{{y}^{2}}}{2} \\\\  & =3{y}^{2}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2},\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238da50c-9ae0-56f5-bdd5-5ea85ce47bfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}(1-\\frac{1}{{e}^{3}})" :db/id #edb/ref 17592186659122} {:answer/id #uuid "35f9e77b-c737-585c-ad89-6c4997b44d01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186659162} {:answer/id #uuid "3e3cee7c-661a-506a-a017-58dca4b904a9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186659177} {:answer/id #uuid "41e28f15-3b32-53d2-817b-72fdf76d5889" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186659186} {:answer/id #uuid "47df1b5f-4faf-5fa9-aa77-dd3ad0f330f1" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{e}" :db/id #edb/ref 17592186659195}] :answer-field/correct {:db/id #edb/ref 17592186659177} :answer-field/id #uuid "1c238b6b-c151-5012-913c-b93e516805b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659548}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "89ebda90-530b-54af-bfc8-9042393303d2" :question/math-academy-id "q-143745" :question/problem "![](images/3c/3c45364ee569d9ee24bbac167ad2a76f8a0a1a519f6604b7f9427d723c59abab.png)\n\nLet $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}6y{e}^{-3x}, & (x,y)\\in D, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(1,-\\frac{1}{3}).$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the point $(1,-\\frac{1}{3})$ on our diagram. Let's also consider the region $Δ$ that lies below and to the left of this point.\n\n![](images/06/0603051ebb33e1e6b3a9f88432ed21d7f00455e870e142ffe35aa8099791e238.png)\n\nUsing the definition of the joint CDF, we have\n\n$$\nF(1,-\\frac{1}{3})=P(X<1,Y<-\\frac{1}{3})={\\int }_{-\\infty }^{-1/3}{\\int }_{-\\infty }^{1}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nHowever, $f(u,v)$ is zero everywhere inside the region $Δ.$ Therefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1/3}{\\int }_{-\\infty }^{1}f(u,v)\\,\\text{d}u\\,\\text{d}v &=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1621629a-0e7e-5743-ab90-5f476cffd76c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(y+1)^{2}},\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659101} {:answer/id #uuid "b7e959bc-249d-5f82-bdb7-eb9ce65452b2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4}{(y+1)^{2}},\\, & 1<y<3 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659408} {:answer/id #uuid "d0b9aaa3-e556-5693-a63e-7e24987ca890" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(y-1)^{2}},\\, & 2<y<3 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659440} {:answer/id #uuid "df7db7ba-ffbf-51aa-8976-6af39839ef49" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{(2y+1)^{2}},\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659465} {:answer/id #uuid "fcde6933-6f47-53be-8ffa-6d961c1c3f93" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4}{(y-1)^{2}},\\, & 3<y<5 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659529}] :answer-field/correct {:db/id #edb/ref 17592186659529} :answer-field/id #uuid "23220371-83cb-5ccd-8fd3-632b3e58be28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659550}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ef7a1e8-b1e1-5536-83aa-52a18efcb7ef" :question/math-academy-id "q-110108" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{{x}^{2}},\\, & 1<x<2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=2X+1,$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=2X+1$ is a strictly increasing function of $X.$  Moreover, for $1<x<2,$ we have $3<y<5.$\n\n![](images/bb/bb2f32772d3bcf0ae72f5d015ec78ee096b1501d1a3c1b977e2d00720d0caf59.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $3<y<5,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(2X+1\\le y) \\\\  & =P(2X\\le y-1) \\\\  & =P(X\\le \\frac{y-1}{2}) \\\\  & ={F}_{X}\\left(\\frac{y-1}{2}\\right)\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $3<y<5,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =\\frac{1}{2}\\cdot {F}_{X}^{′}\\left(\\frac{y-1}{2}\\right) \\\\  & =\\frac{1}{2}\\cdot {f}_{X}\\left(\\frac{y-1}{2}\\right).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{2}\\cdot {f}_{X}\\left(\\frac{y-1}{2}\\right) \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{{\\left(\\frac{y-1}{2}\\right)}^{2}} \\\\  & =\\frac{4}{(y-1)^{2}}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4}{(y-1)^{2}},\\, & 3<y<5 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22040f22-e989-575e-9d9e-ed6e06ced286" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{1+y}, & \\,y\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659120} {:answer/id #uuid "303e6558-f11f-51ac-adc5-500cb309ac01" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{1+2y}, & \\,y\\le -\\frac{1}{2} \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659150} {:answer/id #uuid "458d15bf-f684-5e40-8b15-d82de1b4522e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{1-2y}, & \\,y\\ge \\frac{1}{2} \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659190} {:answer/id #uuid "9e07ad0b-7fb5-520c-8085-1ee23802deb0" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{1-y/2}, & \\,y\\ge 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659363} {:answer/id #uuid "a2142af8-847d-5885-9d7a-cfce3c427206" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{1+y/2}, & \\,y\\le -2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659373}] :answer-field/correct {:db/id #edb/ref 17592186659150} :answer-field/id #uuid "8354e085-d534-5620-8093-113e096937a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659601}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cde5b377-5903-52ae-a6d1-b07e954fae4c" :question/math-academy-id "q-110061" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}{e}^{1-x},\\, & x\\ge 1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=-\\frac{1}{2}X,$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=-\\frac{1}{2}X$ is a strictly decreasing function of $X.$ Moreover, for $x\\ge 1,$ we have $y\\le -\\frac{1}{2}.$\n\n![](images/c0/c073010347f3fb0d1922a7fa50737bd104f8c82fa1de7e4cf434586b1433d1ff.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $y\\le -\\frac{1}{2},$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(-\\frac{1}{2}X\\le y) \\\\  & =P(X\\ge -2y) \\\\  & =1-{F}_{X}(-2y)\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $y\\le -\\frac{1}{2},$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =0-(-2)\\cdot {F}_{X}^{′}(-2y) \\\\  & =2{f}_{X}(-2y).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =2{f}_{X}(-2y) \\\\  & =2{e}^{1-(-2y)} \\\\  & =2{e}^{1+2y}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{1+2y}, & \\,y\\le -\\frac{1}{2} \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "841c02e2-a37b-5327-b137-d09507cf1f29" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186659321} {:answer/id #uuid "9dd12a1e-7229-5c20-80f4-f2dbd0036388" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(y-1)" :db/id #edb/ref 17592186659362} {:answer/id #uuid "9fb8c1ad-b79b-545c-80d7-1b331927445c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186659367} {:answer/id #uuid "cc4819bd-b5f0-563e-a2ff-086f0817f889" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{y}^{2}" :db/id #edb/ref 17592186659435} {:answer/id #uuid "f0897686-3024-5d2b-bfa4-272f97d5e094" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15}({y}^{2}-1)" :db/id #edb/ref 17592186659504}] :answer-field/correct {:db/id #edb/ref 17592186659504} :answer-field/id #uuid "32b5bb1a-3317-5052-89e3-29564445c1e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659558}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d0bc8736-6760-5c3a-b62a-2532f73498d5" :question/math-academy-id "q-143714" :question/problem "Let $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{5}y\\sqrt{x}, & 0\\le x\\le 1,\\,1\\le y\\le 4 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\n \nFind the expression for the corresponding joint CDF when $x>1$ and $1\\le y\\le 4.$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the region $D$ in the $uv$-plane where the function $f(u,v)$ is nonzero. Let's also consider a point $(x,y)$ where $x>1$ and $1\\le y\\le 4$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/d2/d2b553f2212366e6bed5746d192d0c6b539b155f579807a9b878d2365993a3b1.png)\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=\\{(u,v)\\,:\\,0\\le u\\le 1,\\,1\\le v\\le y\\}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={\\int }_{1}^{y}{\\int }_{0}^{1}\\frac{1}{5}v\\sqrt{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{5}{\\int }_{1}^{y}v{[\\frac{2}{3}{u}^{3/2}]}_{u=0}^{u=1}\\,\\text{d}v \\\\  & =\\frac{1}{5}{\\int }_{1}^{y}v(\\frac{2}{3}-0)\\text{d}v \\\\  & =\\frac{2}{15}{\\int }_{1}^{y}v\\,\\text{d}v \\\\  & =\\frac{2}{15}{[\\frac{{v}^{2}}{2}]}_{v=1}^{v=y} \\\\  & =\\frac{2}{15}[\\frac{{y}^{2}}{2}-\\frac{1}{2}] \\\\  & =\\frac{1}{15}({y}^{2}-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186659746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc910cc-a02c-5147-89ef-f98e29a547c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186659206} {:answer/id #uuid "a7e4440f-beb4-5f49-b081-f8d130e62d5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(1-\\frac{1}{e})" :db/id #edb/ref 17592186659386} {:answer/id #uuid "b8b7bdd4-ed06-588d-822c-03b394cf8340" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}}{27}" :db/id #edb/ref 17592186659410} {:answer/id #uuid "ecaaf0ac-213c-5e22-b871-faf6c40547ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}(1-\\frac{1}{{e}^{3}})" :db/id #edb/ref 17592186659497} {:answer/id #uuid "f9172462-fc60-53e8-82c6-8cc242c46d29" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186659522}] :answer-field/correct {:db/id #edb/ref 17592186659497} :answer-field/id #uuid "8244ba6d-578c-5ac0-bae8-10cc309ef647" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186659599}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e28f1de9-6710-5901-91a1-1a210c57eb36" :question/math-academy-id "q-143744" :question/problem "![](images/3c/3c45364ee569d9ee24bbac167ad2a76f8a0a1a519f6604b7f9427d723c59abab.png)\n\nLet $X$ and $Y$ be continuous random variables with the joint probability density function \n\n$$\nf(x,y)=\\{\\begin{aligned}6y{e}^{-3x}, & (x,y)\\in D, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(1,\\frac{1}{3}).$" :question/worked-solution "If $X$ and $Y$ are continuous random variables with the joint probability density function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\int }_{-\\infty }^{y}{\\int }_{-\\infty }^{x}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nLet's draw the point $(1,\\frac{1}{3})$ on our diagram. Let's also consider the region $Δ$ that lies below and to the left of this point.\n\n![](images/a4/a420e0087e092800c82150ed8cd3acf5f2010ec8acc27704a3134f3190ddc6bb.png)\n\nUsing the definition of the joint CDF, we have\n\n$$\nF(1,\\frac{1}{3})=P(X<1,Y<\\frac{1}{3})={\\int }_{-\\infty }^{1/3}{\\int }_{-\\infty }^{1}f(u,v)\\,\\text{d}u\\,\\text{d}v.\n$$\n\nFor the purposes of computation, we're only interested in the region inside $Δ$ where $f(x,y)$ is nonzero. This is given by\n\n$$\nD\\cap Δ=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\frac{1}{3}\\}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1/3}{\\int }_{-\\infty }^{1}f(u,v)\\,\\text{d}u\\,\\text{d}v & ={\\int }_{0}^{1/3}{\\int }_{0}^{1}6v{e}^{-3u}\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{1/3}{[-2v{e}^{-3u}]}_{u=0}^{u=1}\\,\\text{d}v \\\\  & ={\\int }_{0}^{1/3}(2v-2v{e}^{-3})\\text{d}v \\\\  & ={\\int }_{0}^{1/3}2(1-{e}^{-3})v\\,\\text{d}v \\\\  & =(1-{e}^{-3}){[{v}^{2}]}_{v=0}^{v=1/3} \\\\  & =\\frac{1}{9}(1-{e}^{-3})-0 \\\\  & =\\frac{1}{9}(1-\\frac{1}{{e}^{3}}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea522d9-96f4-560c-98ed-fa2f6db1d46d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659902} {:answer/id #uuid "36c25b7d-c4f4-527b-b2e2-31f03773918d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2y, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659917} {:answer/id #uuid "50e41410-8e5e-5d4c-92c4-d91e6e62930f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{(1-y)^{2}}{3}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659959} {:answer/id #uuid "51ced16b-21eb-5210-8ddd-afbd9b6fc8fa" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659962} {:answer/id #uuid "aa9f336a-b116-5db5-85a6-f89074cafc2d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2(1-y), & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660089}] :answer-field/correct {:db/id #edb/ref 17592186659962} :answer-field/id #uuid "abf2c5db-7fec-5bc8-bb48-ee3f64464fd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660278}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00578886-7dda-53ac-9b2f-732dec4a201c" :question/math-academy-id "q-143844" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}3(1-x)^{2}, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=(1-X)^{3},$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=(1-X)^{3}.$ The transformation $u(x)=(1-x)^{3}$ is strictly monotonically *decreasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & =(1-y)^{3} \\\\ y & =(1-{u}^{-1}(y))^{3} \\\\ {u}^{-1}(y) & =1-\\sqrt[3]{y}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=-\\frac{1}{3\\sqrt[3]{{y}^{2}}}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(1-\\sqrt[3]{y})\\cdot |-\\frac{1}{3\\sqrt[3]{{y}^{2}}}| \\\\  & =3(1-[1-\\sqrt[3]{y}])^{2}\\cdot \\frac{1}{3\\sqrt[3]{{y}^{2}}} \\\\  & =3\\sqrt[3]{{y}^{2}}\\cdot \\frac{1}{3\\sqrt[3]{{y}^{2}}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<1,$ the bounds are $a=0$ and $b=1,$ we have\n\n$$\nu(0)=1,\\,u(1)=0.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}1, & 0<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ac87682-366c-501b-b2bd-f59694b88d7c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}(9y-1)^{2}, & 1<y<2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659926} {:answer/id #uuid "40118e8f-f320-57d4-ba73-bd996526a584" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}27(y-1)^{2}, & 1<y<\\frac{4}{3} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659934} {:answer/id #uuid "41391778-4205-5c19-a97f-2daa062474cc" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}9(3y-1)^{2}, & 1<y<\\frac{4}{3} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659938} {:answer/id #uuid "4b5aced4-e841-55e1-a472-bafa801afac0" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}3(y-1)^{2}, & 1<y<2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659956} {:answer/id #uuid "839b4cfe-dd75-531f-ad60-f7cbef3e0423" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}81(y-1)^{2}, & 1<y<\\frac{4}{3} \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186660025}] :answer-field/correct {:db/id #edb/ref 17592186660025} :answer-field/id #uuid "acd72c6b-beda-5cd0-b15d-01cdae65725a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660279}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "643de5bf-a289-5084-b18a-fff6b8b79b60" :question/math-academy-id "q-143763" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}3{x}^{2},\\, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\frac{1}{3}X+1,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=\\frac{1}{3}X+1.$ The transformation $u(x)=\\frac{1}{3}x+1$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =\\frac{1}{3}y+1\\text{ } \\\\ y & =\\frac{1}{3}{u}^{-1}(y)+1 \\\\ {u}^{-1}(y) & =3y-3\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=3\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(3y-3)\\cdot |3| \\\\  & =3(3y-3)^{2}\\cdot 3 \\\\  & =81(y-1)^{2}\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<1,$ the bounds are $a=0$ and $b=1,$ we have\n\n$$\nu(0)=1,\\,u(1)=\\frac{4}{3}.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}81(y-1)^{2}, & 1<y<\\frac{4}{3} \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36e1a633-79c0-5718-a126-1a5c681f367e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y}, & y\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659918} {:answer/id #uuid "4adf838f-ad44-5222-9a2d-1eefa55f4481" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}{e}^{y/2}, & y\\le 0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659955} {:answer/id #uuid "5221c9b4-7784-5669-9339-68917f4a245a" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{-2y}, & y\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659963} {:answer/id #uuid "8cae6468-6e7d-5f22-a2c9-b8409790bc5c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{2y}, & y\\le 0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660041} {:answer/id #uuid "ed077390-0c86-55f2-8d0b-7a5c8492bdc3" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{y}, & y\\le 0 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660186}] :answer-field/correct {:db/id #edb/ref 17592186660186} :answer-field/id #uuid "7b86baed-fc02-5390-9184-4b67150d1b8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660256}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6f2ecdaf-065c-5327-a715-cc16679baf3a" :question/math-academy-id "q-143847" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{{x}^{2}}, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=-\\operatorname{ln}⁡X,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=-\\operatorname{ln}⁡X.$ The transformation $u(x)=-\\operatorname{ln}⁡x$ is strictly monotonically *decreasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & =-\\operatorname{ln}⁡y \\\\ y & =-\\operatorname{ln}⁡({u}^{-1}(y)) \\\\ {u}^{-1}(y) & ={e}^{-y}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=-{e}^{-y}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}({e}^{-y})\\cdot |-{e}^{-y}| \\\\  & =\\frac{1}{({e}^{-y})^{2}}\\cdot {e}^{-y} \\\\  & =\\frac{1}{{e}^{-2y}}\\cdot {e}^{-y} \\\\  & ={e}^{y}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $x\\ge 1,$ the bounds are $a=1$ and $b\\to \\infty ,$ we have\n\n$$\nu(1)=0,\\,\\text{and}\\,\\lim_{x\\to \\infty }u(x)=-\\infty .\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{e}^{y}, & y\\le 0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9ed819-28bc-5920-aefd-e08fb807a8b2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4\\sqrt[3]{\\operatorname{ln}⁡(y)}}{3y}, & 1<y<e \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659855} {:answer/id #uuid "4847f219-a5e5-5a0e-91fe-d39f0702cf9e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{\\sqrt[3]{\\operatorname{ln}⁡(y)}}{2y}, & 1<y<e \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659952} {:answer/id #uuid "63f79e25-9ca1-5bc4-888e-0af4e8fe7955" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4\\sqrt[3]{{e}^{y}}}{3y}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659983} {:answer/id #uuid "d4854ca6-9804-5cbe-a5a3-466998a7d4bb" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2{e}^{3y}}{3y}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660152} {:answer/id #uuid "ecb0705b-306b-528d-b997-c8ebf57e4936" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4{ln}^{3}⁡(y)}{3y}, & 1<y<e \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660185}] :answer-field/correct {:db/id #edb/ref 17592186659855} :answer-field/id #uuid "2ec0f46e-f7ef-5b29-ad14-6e90be28941b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660232}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "878d833d-e806-5c01-ba11-04a10d38efce" :question/math-academy-id "q-143843" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{4\\sqrt[3]{x}}{3}, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y={e}^{X},$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y={e}^{X}.$ The transformation $u(x)={e}^{x}$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & ={e}^{y} \\\\ y & ={e}^{{u}^{-1}(y)} \\\\ {u}^{-1}(y) & =\\operatorname{ln}⁡(y)\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=\\frac{1}{y}\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(\\operatorname{ln}⁡(y))\\cdot |\\frac{1}{y}| \\\\  & =\\frac{4\\sqrt[3]{\\operatorname{ln}⁡(y)}}{3}\\cdot \\frac{1}{|y|} \\\\  & =\\frac{4\\sqrt[3]{\\operatorname{ln}⁡(y)}}{3|y|}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $0<x<1,$ the bounds are $a=0$ and $b=1,$ we have\n\n$$\nu(0)=1,\\,u(1)=e.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4\\sqrt[3]{\\operatorname{ln}⁡(y)}}{3y}, & 1<y<e \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f2bb290-c6be-5de5-9eb3-982612b1d096" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}-{log}_{2}⁡y\\cdot \\operatorname{ln}⁡2, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186659999} {:answer/id #uuid "762dbd60-cbd1-5c78-8123-8a4b40374b99" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660007} {:answer/id #uuid "9bf88855-bb29-5fd6-90e3-0cd3271e67e1" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{{2}^{2y+1}\\operatorname{ln}⁡2}{3}, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660064} {:answer/id #uuid "c0f0a1af-cb80-5af6-b504-771a805eb772" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{2}, & 0<y<2 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660123} {:answer/id #uuid "d65e3a51-14b6-5c6c-b603-3ba183ea75cf" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{{2}^{2y+1}\\operatorname{ln}⁡2}{15}, & 0<y<2 \\\\ 0, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186660153}] :answer-field/correct {:db/id #edb/ref 17592186660064} :answer-field/id #uuid "4b5fa4cf-8a8e-5330-8e2b-ee0615d708cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660239}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93aed58a-81ac-5f77-b9d6-439aa15594ba" :question/math-academy-id "q-143835" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2x}{3}, & 1<x<2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y={log}_{2}⁡X,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y={log}_{2}⁡X.$ The transformation $u(x)={log}_{2}⁡x$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y)$ as follows:\n\n$$\n\\begin{aligned}u(y) & ={log}_{2}⁡y \\\\ y & ={log}_{2}⁡({u}^{-1}(y)) \\\\ {u}^{-1}(y) & ={2}^{y}\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)={2}^{y}\\operatorname{ln}⁡2\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & =\\frac{2\\cdot {2}^{y}}{3}\\cdot {2}^{y}\\operatorname{ln}⁡2 \\\\  & =\\frac{{2}^{2y+1}\\operatorname{ln}⁡2}{3}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $1<x<2,$ the bounds are $a=1$ and $b=2,$ we have\n\n$$\nu(1)=0,\\,u(2)=1.\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{{2}^{2y+1}\\operatorname{ln}⁡2}{3}, & 0<y<1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b43b46-f495-5851-a969-8851c3483e94" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2{y}^{2}}, & y>2 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659948} {:answer/id #uuid "47ea3a5d-1799-5a09-a8ed-032b71ca1a2d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(2y-1)^{2}}, & y>0 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186659951} {:answer/id #uuid "b4f5286a-b901-5fca-a1c3-ce9a3d345bb0" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{(y+1)^{2}}, & y>0 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186660108} {:answer/id #uuid "c29d270c-4a43-512d-85e8-1cb53b7ef3cc" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{(y-1)^{2}}, & y>1 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186660124} {:answer/id #uuid "ff548d19-7271-51ec-915f-41045c2163fa" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{(2y+1)^{2}}, & y>0 \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186660214}] :answer-field/correct {:db/id #edb/ref 17592186660108} :answer-field/id #uuid "7467f061-2a32-505f-ab5f-521681f50990" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660253}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c14a3a10-3dca-5ae5-bd85-3455c4ca6200" :question/math-academy-id "q-143770" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{{x}^{2}},\\, & x>1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=X-1,$ use the change-of-variables method to find the probability density function of $Y.$" :question/worked-solution "If $X\\in (a,b)$ is a continuous random variable with probability density function ${f}_{X}$ and $Y=u(X),$ where the function $u(x)$ is strictly monotonic, then according to the change-of-variables method, the probability density function of $Y$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)|, & y\\text{ is between }u(a)\\text{ and }u(b) \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nHere, we have $Y=X-1.$ The transformation $u(x)=x-1$ is strictly monotonically *increasing*, so the change-of-variables method can be used.\n\nFirst, we find ${u}^{-1}(y),$ as follows:\n\n$$\n\\begin{aligned}u(y) & =y-1 \\\\ y & ={u}^{-1}(y)-1 \\\\ {u}^{-1}(y) & =y+1\\end{aligned}\n$$\n\nThen, we find $({u}^{-1})^{′}(y):$\n\n$$\n({u}^{-1})^{′}(y)=1\n$$\n\nAccording to the change-of-variables method, for nonzero ${f}_{Y},$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={f}_{X}({u}^{-1}(y))\\cdot |({u}^{-1})^{′}(y)| \\\\  & ={f}_{X}(y+1)\\cdot |1| \\\\  & =\\frac{1}{(y+1)^{2}}\\cdot 1 \\\\  & =\\frac{1}{(y+1)^{2}}.\\end{aligned}\n$$\n\nFinally, since ${f}_{X}$ is nonzero on $x\\ge 1,$ the bounds are $a=1$ and $b\\to \\infty ,$ we have\n\n$$\nu(1)=0,\\,\\lim_{x\\to \\infty }u(x)=\\infty .\n$$\n\nTherefore, the probability distribution of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{(y+1)^{2}}, & y>0 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20094111-3cf0-5ec3-936d-f94dd7629887" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186660493} {:answer/id #uuid "49ed2228-f504-5e9b-b98d-f44bb4a6456a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186660541} {:answer/id #uuid "69194c98-60b9-546f-9bd6-3469ae4cdcfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186660581} {:answer/id #uuid "aaf3de6b-1f43-5efc-a486-6a8e7b75da13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186660658} {:answer/id #uuid "ce51baed-ab71-5197-b414-bbf39b57635d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186660698}] :answer-field/correct {:db/id #edb/ref 17592186660541} :answer-field/id #uuid "69ac766f-69f7-57c8-b975-af0188dfdf36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660803}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5ec5a230-3401-59b6-b89c-b7ec48c50db9" :question/math-academy-id "q-146173" :question/problem "$$\n{f}_{Y\\,|\\,X}(y\\,|\\,2)=\\{\\begin{aligned}3{y}^{2}, & \\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\n  \n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional expected value $\\text{E}[Y\\,|\\,X=2]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,2)$ is shown above." :question/worked-solution "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=2] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,2)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot 3{y}^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}3{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{3{y}^{4}}{4}]}_{0}^{1} \\\\  & =\\frac{3}{4}(1-0) \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62ab5404-6d5c-5762-abc5-d3afe7ee3c38" :answer/type {:db/ident :answer.type/math} :answer/value "0.9" :db/id #edb/ref 17592186660575} {:answer/id #uuid "641184ca-3101-5c41-8d43-f57f9bb6653a" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186660577} {:answer/id #uuid "8f79cf75-d838-5898-a348-d087acb25ff3" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186660629} {:answer/id #uuid "ebc69e8c-a7fd-5630-b509-4a1790e997c5" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186660740} {:answer/id #uuid "f18d6827-77d1-5eca-bdb4-271ff6c4e45b" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186660752}] :answer-field/correct {:db/id #edb/ref 17592186660577} :answer-field/id #uuid "4dc1640c-cae6-553b-b6d0-22e0463424d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660792}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6bd5327e-2697-563d-8211-fe1f545dd51a" :question/math-academy-id "q-97207" :question/problem "Given that $X∼\\text{Bernoulli}(0.4),$ compute $P(X=1).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.4),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.4, & x=1 \\\\ 0.6, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=1)=f(1)=0.4.\n$$"}] [{:db/id #edb/ref 17592186660882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21aa739f-9712-55a2-9f17-fe66ca7408e0" :answer/type {:db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186660497} {:answer/id #uuid "a24ef13a-5b63-511f-8cfa-b9a1cd54b5c4" :answer/type {:db/ident :answer.type/math} :answer/value "0.36" :db/id #edb/ref 17592186660649} {:answer/id #uuid "cfbaa7ca-da3d-582f-b929-a58aa20f4c6d" :answer/type {:db/ident :answer.type/math} :answer/value "0.32" :db/id #edb/ref 17592186660700} {:answer/id #uuid "ed2fccaf-413b-5330-8a76-7b14aa18fe01" :answer/type {:db/ident :answer.type/math} :answer/value "0.38" :db/id #edb/ref 17592186660743} {:answer/id #uuid "ed60364f-fc92-5d54-a439-152b6f3a3563" :answer/type {:db/ident :answer.type/math} :answer/value "0.68" :db/id #edb/ref 17592186660745}] :answer-field/correct {:db/id #edb/ref 17592186660700} :answer-field/id #uuid "026bf449-d3ed-539d-bcbd-75aa9d9c9627" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660764}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7cca51f2-4ee5-52c3-bfb8-fdaab67fbcdc" :question/math-academy-id "q-97214" :question/problem "Given that $X∼\\text{Bernoulli}(0.32),$ compute $P(X=1).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.32),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.32, & x=1 \\\\ 0.68, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=1)=f(1)=0.32.\n$$"}] [{:db/id #edb/ref 17592186660915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a1beeb-b04e-5f98-aa38-5c71cba0e36c" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186660483} {:answer/id #uuid "4ee98c6e-4e2f-526f-ac1f-ba8e16f19229" :answer/type {:db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186660550} {:answer/id #uuid "5b08a252-aa4f-521e-9664-c02b07348416" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186660563} {:answer/id #uuid "afbe60e2-bf85-5725-881f-61ff3b57ca63" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186660669} {:answer/id #uuid "e7066130-2f9f-5641-bfc4-f206efc5e7af" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186660734}] :answer-field/correct {:db/id #edb/ref 17592186660563} :answer-field/id #uuid "e669d833-4d7d-596a-ae3e-8245cdce41ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660840}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "effe7c96-c18c-5721-aa74-dd59d97a5883" :question/math-academy-id "q-97195" :question/problem "Given that $X∼\\text{Bernoulli}(0.2),$ compute $P(X=0).$" :question/worked-solution "If $X∼\\text{Bernoulli}(p),$ then $X$ has the following probability mass function: \n\n$$\nf(x)=\\{\\begin{aligned}p, & x=1 \\\\ 1-p, & x=0\\end{aligned}\n$$\n\nHere, $X∼\\text{Bernoulli}(0.2),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}0.2, & x=1 \\\\ 0.8, & x=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=0)=f(0)=0.8.\n$$"}] [{:db/id #edb/ref 17592186661485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19372f6f-e535-53c0-8ab6-f785bb56e5c0" :answer/type {:db/ident :answer.type/math} :answer/value "0.0043" :db/id #edb/ref 17592186661015} {:answer/id #uuid "1b5e831c-e566-5315-b5d0-d462b6b6af43" :answer/type {:db/ident :answer.type/math} :answer/value "0.0039" :db/id #edb/ref 17592186661023} {:answer/id #uuid "21199f18-4066-52b1-99d0-f9e722b9c901" :answer/type {:db/ident :answer.type/math} :answer/value "0.0056" :db/id #edb/ref 17592186661032} {:answer/id #uuid "546fb4d4-2c7b-5a36-af00-0d5d5fd4639a" :answer/type {:db/ident :answer.type/math} :answer/value "0.0047" :db/id #edb/ref 17592186661135} {:answer/id #uuid "5d4a5ee0-bb29-5b6c-93d8-70e5c79b7611" :answer/type {:db/ident :answer.type/math} :answer/value "0.0035" :db/id #edb/ref 17592186661150}] :answer-field/correct {:db/id #edb/ref 17592186661150} :answer-field/id #uuid "2fef9ca5-4e55-5f0b-bbe5-8e4af1990411" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661413}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "06880e92-5c4d-5d34-8928-8e1ef00a8b18" :question/math-academy-id "q-97524" :question/problem "Given that $X∼\\text{NB}(12,0.9),$ compute $P(X=18),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(12,0.9),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{11})(0.1)^{x-12}(0.9)^{12}, & x=12,13,14,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=18) & =f(18) \\\\  & =(\\genfrac{}{}{0pt}{}{18-1}{11})(0.1)^{18-12}(0.9)^{12} \\\\  & =(\\genfrac{}{}{0pt}{}{17}{11})(0.1)^{6}(0.9)^{12} \\\\  & ≈0.0035\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c8ff145-e800-5725-be92-2568d76fa955" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{20}" :db/id #edb/ref 17592186661026} {:answer/id #uuid "7e93178f-6976-5c6c-a0fe-bf387e81321a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{100}" :db/id #edb/ref 17592186661193} {:answer/id #uuid "918ae174-a056-50b9-b409-04f37e375e6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{100}" :db/id #edb/ref 17592186661218} {:answer/id #uuid "d35dd643-c480-5426-891a-e5603410a316" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186661331} {:answer/id #uuid "eb42b466-b9f2-5538-b115-4aaa6a88a24b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186661362}] :answer-field/correct {:db/id #edb/ref 17592186661218} :answer-field/id #uuid "5fdcab71-6311-509a-b960-e4254845b48b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661429}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0753c1ed-3f80-58af-b303-b8bbeebb90e7" :question/math-academy-id "q-146808" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,0)=\\{\\begin{aligned}\\frac{2}{3\\sqrt[3]{y}}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=0]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,0)$ is shown above and the corresponding expected value is ${\\mu }_{Y|0}=\\frac{2}{5}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=0] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,0)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\cdot \\frac{2}{3\\sqrt[3]{y}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{2}{3}\\cdot {y}^{5/3}\\,\\text{d}y \\\\  & ={[\\frac{1}{4}{y}^{8/3}]}_{0}^{1} \\\\  & =\\frac{1}{4}(1-0) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=0] & =\\text{E}[{Y}^{2}\\,|\\,X=0]-{\\mu }_{Y|0}^{2} \\\\  & =\\frac{1}{4}-{\\left(\\frac{2}{5}\\right)}^{2} \\\\  & =\\frac{1}{4}-\\frac{4}{25} \\\\  & =\\frac{9}{100}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01361058-1aa4-56f8-bf5f-efbff8a54ce1" :answer/type {:db/ident :answer.type/math} :answer/value "0.8256" :db/id #edb/ref 17592186660974} {:answer/id #uuid "23882b8e-0687-5992-836b-034bfe54ea8d" :answer/type {:db/ident :answer.type/math} :answer/value "0.0816" :db/id #edb/ref 17592186661037} {:answer/id #uuid "3234ba4d-b1f0-5c8c-8124-0f151e4c4bd3" :answer/type {:db/ident :answer.type/math} :answer/value "0.0875" :db/id #edb/ref 17592186661064} {:answer/id #uuid "51a27231-964b-51e5-ad0b-f93b921e19bc" :answer/type {:db/ident :answer.type/math} :answer/value "0.0578" :db/id #edb/ref 17592186661127} {:answer/id #uuid "b3c1afe8-eb79-5df1-b79e-b4f26d069045" :answer/type {:db/ident :answer.type/math} :answer/value "0.8061" :db/id #edb/ref 17592186661285}] :answer-field/correct {:db/id #edb/ref 17592186661064} :answer-field/id #uuid "c6de6f48-6874-524b-bab2-91d661b80202" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661470}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "129edac1-2a77-5570-800f-547037da3253" :question/math-academy-id "q-97595" :question/problem "Given $X∼\\text{NB}(12,0.44),$ compute $P(17<X\\le 20),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(12,0.44),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{11})(0.56)^{x-12}(0.44)^{12}, & x=12,13,14,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(17<X\\le 20) & =P(X\\in \\{18,19,20\\}) \\\\  & =P(X=18)+P(X=19)+P(X=20) \\\\  & =f(18)+f(19)+f(20) \\\\  & =(\\genfrac{}{}{0pt}{}{17}{11})(0.56)^{6}(0.44)^{12}+(\\genfrac{}{}{0pt}{}{18}{11})(0.56)^{7}(0.44)^{12}+(\\genfrac{}{}{0pt}{}{19}{11})(0.56)^{8}(0.44)^{12} \\\\  & ≈0.0875\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "237875f9-0e59-5294-accf-1fd154cfb946" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{5}" :db/id #edb/ref 17592186661036} {:answer/id #uuid "4b64cba1-bf8b-574b-8b2e-675d8584b6b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{47}{5}" :db/id #edb/ref 17592186661114} {:answer/id #uuid "8639fe13-62df-521e-b798-7051c2af2dbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{5}" :db/id #edb/ref 17592186661201} {:answer/id #uuid "9da3aedf-b405-5b44-b5cb-465cb22dd0fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{107}{5}" :db/id #edb/ref 17592186661244} {:answer/id #uuid "af5193da-5876-5585-b019-8d975f8afae8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{77}{5}" :db/id #edb/ref 17592186661276}] :answer-field/correct {:db/id #edb/ref 17592186661201} :answer-field/id #uuid "961d03db-505a-5c64-8ee3-48899530a65e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661446}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "152bb94e-0dc4-5fd2-a502-e38e1e8e4396" :question/math-academy-id "q-146805" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,1)=\\{\\begin{aligned}\\frac{2}{3{y}^{4/3}}, & \\,1\\le y\\le 8 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,1)$ is shown above and the corresponding expected value is ${\\mu }_{Y|1}=3.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{1}^{8}{y}^{2}\\cdot \\frac{2}{3{y}^{4/3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{8}\\frac{2}{3}{y}^{2/3}\\,\\text{d}x \\\\  & ={[\\frac{2}{5}{y}^{5/3}]}_{1}^{8} \\\\  & =\\frac{2}{5}(32-1) \\\\  & =\\frac{62}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{62}{5}-{3}^{2} \\\\  & =\\frac{17}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0314438e-1e46-5cda-ad46-cf5bcdb388ef" :answer/type {:db/ident :answer.type/math} :answer/value "0.0635" :db/id #edb/ref 17592186660978} {:answer/id #uuid "97af0e98-d932-5eef-b2c2-9aea0a39dae7" :answer/type {:db/ident :answer.type/math} :answer/value "0.0500" :db/id #edb/ref 17592186661230} {:answer/id #uuid "ab2a7bd8-8363-5dce-9877-95ab9c9aa5ce" :answer/type {:db/ident :answer.type/math} :answer/value "0.0606" :db/id #edb/ref 17592186661268} {:answer/id #uuid "e26d14dd-0021-5ba5-830a-782032961914" :answer/type {:db/ident :answer.type/math} :answer/value "0.0582" :db/id #edb/ref 17592186661350} {:answer/id #uuid "f64c9fc5-da7d-5046-8965-60ea52f516f7" :answer/type {:db/ident :answer.type/math} :answer/value "0.0680" :db/id #edb/ref 17592186661379}] :answer-field/correct {:db/id #edb/ref 17592186661268} :answer-field/id #uuid "fcedc858-3a0a-533b-8ca5-0c3f18188a02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661484}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1dc37ea0-d288-5e00-a7b1-2cc5d9165496" :question/math-academy-id "q-97562" :question/problem "Given $X∼\\text{NB}(20,0.75),$ compute $P(X<23),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(20,0.75),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{19})(0.25)^{x-20}(0.75)^{20}, & x=20,21,22,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<23) & =P(X\\in \\{20,21,22\\}) \\\\  & =P(X=20)+P(X=21)+P(X=22) \\\\  & =f(20)+f(21)+f(22) \\\\  & =(\\genfrac{}{}{0pt}{}{19}{19})(0.25)^{0}(0.75)^{20}+(\\genfrac{}{}{0pt}{}{20}{19})(0.25)^{1}(0.75)^{20}+(\\genfrac{}{}{0pt}{}{21}{19})(0.25)^{2}(0.75)^{20} \\\\  & ≈0.0606\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "068969ad-fea9-5902-b09a-5e27756e94ad" :answer/type {:db/ident :answer.type/math} :answer/value "0.2936" :db/id #edb/ref 17592186660985} {:answer/id #uuid "16f2cd98-ca0c-5ab6-a8a0-f6d61a01bcf1" :answer/type {:db/ident :answer.type/math} :answer/value "0.2912" :db/id #edb/ref 17592186661010} {:answer/id #uuid "33edd95b-cd89-59f7-b040-0775d3c82688" :answer/type {:db/ident :answer.type/math} :answer/value "0.0257" :db/id #edb/ref 17592186661066} {:answer/id #uuid "a4127944-5cf5-528c-85c2-c31ee08fbd94" :answer/type {:db/ident :answer.type/math} :answer/value "0.0391" :db/id #edb/ref 17592186661257} {:answer/id #uuid "b4e0fc78-8248-50c0-a5dd-e4af4e216895" :answer/type {:db/ident :answer.type/math} :answer/value "0.0297" :db/id #edb/ref 17592186661286}] :answer-field/correct {:db/id #edb/ref 17592186661286} :answer-field/id #uuid "f888f015-25dd-5b96-8eb7-2dae29eaa85d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661482}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "247580fa-794f-5bdb-bd72-d8bfabdf1626" :question/math-academy-id "q-97548" :question/problem "Given that $X∼\\text{NB}(7,0.4),$ compute $P(X=10),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(7,0.4),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{6})(0.6)^{x-7}(0.4)^{7}, & x=7,8,9,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=10) & =f(10) \\\\  & =(\\genfrac{}{}{0pt}{}{10-1}{6})(0.6)^{10-7}(0.4)^{7} \\\\  & =(\\genfrac{}{}{0pt}{}{9}{6})(0.6)^{3}(0.4)^{7} \\\\  & ≈0.0297\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065eedad-69b9-5ab3-8c90-8838dd7d33d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{16}" :db/id #edb/ref 17592186660984} {:answer/id #uuid "4014dbe8-4873-5716-80f6-fd242ee4b20d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{48}" :db/id #edb/ref 17592186661092} {:answer/id #uuid "4e588d11-5f08-5a06-a3b1-81ba245bf42e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186661117} {:answer/id #uuid "4f6f7c4e-0753-5022-a93d-d3a1e993aa81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{48}" :db/id #edb/ref 17592186661121} {:answer/id #uuid "88fbcde1-ee75-5866-9c78-38f2bef444d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{12}" :db/id #edb/ref 17592186661205}] :answer-field/correct {:db/id #edb/ref 17592186661121} :answer-field/id #uuid "ddea5261-89b4-5c9d-b8d9-57e9a2ab10c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d7b2209-12fb-5e3f-8af8-1336e316faee" :question/math-academy-id "q-149405" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,0)=\\{\\begin{aligned}\\frac{5}{{x}^{6}}, & \\,x\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=0]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,0)$ is shown above and the corresponding expected value is ${\\mu }_{X|0}=-\\frac{5}{4}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=0] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,0)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}{x}^{2}\\cdot \\frac{5}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}\\frac{5}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}5{x}^{-4}\\,\\text{d}x \\\\  & ={[-\\frac{5}{3}\\cdot {x}^{-3}]}_{-\\infty }^{-1} \\\\  & ={[-\\frac{5}{3{x}^{3}}]}_{-\\infty }^{-1} \\\\  & =\\frac{5}{3}-0 \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=0] & =\\text{E}[{X}^{2}\\,|\\,Y=0]-{\\mu }_{X|0}^{2} \\\\  & =\\frac{5}{3}-{\\left(-\\frac{5}{4}\\right)}^{2} \\\\  & =\\frac{5}{3}-\\frac{25}{16} \\\\  & =\\frac{5}{48}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d09de55-de4c-5120-954e-0a32f909ae67" :answer/type {:db/ident :answer.type/math} :answer/value "0.0872" :db/id #edb/ref 17592186661084} {:answer/id #uuid "3daf2a05-5054-59b0-96df-3f4ad377ca18" :answer/type {:db/ident :answer.type/math} :answer/value "0.8890" :db/id #edb/ref 17592186661087} {:answer/id #uuid "84a4537c-1ec0-5f1e-aa7c-b3d98c22d0a5" :answer/type {:db/ident :answer.type/math} :answer/value "0.9880" :db/id #edb/ref 17592186661200} {:answer/id #uuid "b73fb17b-9634-5b6a-90a5-dcc94576ef71" :answer/type {:db/ident :answer.type/math} :answer/value "0.0889" :db/id #edb/ref 17592186661289} {:answer/id #uuid "e6e42aec-2909-5754-9978-56144c744a6b" :answer/type {:db/ident :answer.type/math} :answer/value "0.0980" :db/id #edb/ref 17592186661356}] :answer-field/correct {:db/id #edb/ref 17592186661200} :answer-field/id #uuid "08418e93-e121-5971-a1e0-7eebbe7489f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661402}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3c20982e-0200-55db-a3f9-dcf3d0e125ba" :question/math-academy-id "q-97608" :question/problem "Given $X∼\\text{NB}(25,0.73),$ compute $P(X\\ge 28),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(25,0.73),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{24})(0.27)^{x-25}(0.73)^{25}, & x=25,26,27,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 28.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 28) & =1-P(X<28)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<28) & =P(X\\in \\{25,26,27\\}) \\\\  & =P(X=25)+P(X=26)+P(X=27) \\\\  & =f(25)+f(26)+f(27) \\\\  & =(\\genfrac{}{}{0pt}{}{24}{24})(0.27)^{0}(0.73)^{25}+(\\genfrac{}{}{0pt}{}{25}{24})(0.27)^{1}(0.73)^{25}+(\\genfrac{}{}{0pt}{}{26}{24})(0.27)^{2}(0.73)^{25} \\\\  & ≈0.0120.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 28) & =1-P(X<28) \\\\  & ≈1-0.0120 \\\\  & =0.9880\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193f8646-1ce1-5fcd-99a3-3f63d8dbdfb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186661016} {:answer/id #uuid "4e1a8a9c-dc34-53f0-9fde-d581ed798555" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186661116} {:answer/id #uuid "aa881261-0685-51b9-ae1f-2ecf8e8f9c0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186661265} {:answer/id #uuid "ed57ac7d-a36b-5711-8ef0-43f4f359a65e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186661366} {:answer/id #uuid "ff66cc24-9b9f-5460-9b21-3fcecceb4cd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{9}" :db/id #edb/ref 17592186661396}] :answer-field/correct {:db/id #edb/ref 17592186661366} :answer-field/id #uuid "0b662c13-ef35-5442-9564-fdd1bbc9ebac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661403}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "517f935e-c565-504d-bcc8-5e97859472f7" :question/math-academy-id "q-149445" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,-5)=\\{\\begin{aligned}-\\frac{4}{{y}^{5}}, & \\,y\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=-5]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,-5)$ is shown above and the corresponding expected value is ${\\mu }_{Y|-5}=-\\frac{4}{3}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=-5] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,-5)\\,\\text{d}y \\\\  & ={\\int }_{-\\infty }^{-1}{y}^{2}\\cdot \\left(-\\frac{4}{{y}^{5}}\\right)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}-\\frac{4}{{y}^{3}}\\,\\text{d}y \\\\  & ={\\int }_{-\\infty }^{-1}-4{y}^{-3}\\,\\text{d}y \\\\  & ={[-4\\cdot \\left(-\\frac{1}{2}\\right)\\cdot {y}^{-2}]}_{-\\infty }^{-1} \\\\  & ={[\\frac{2}{{y}^{2}}]}_{-\\infty }^{-1} \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=-5] & =\\text{E}[{Y}^{2}\\,|\\,X=-5]-{\\mu }_{Y|-5}^{2} \\\\  & =2-{\\left(-\\frac{4}{3}\\right)}^{2} \\\\  & =2-\\frac{16}{9} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b81004-d78c-579a-8da4-32d9b3fcf44c" :answer/type {:db/ident :answer.type/math} :answer/value "0.2647" :db/id #edb/ref 17592186661047} {:answer/id #uuid "40a6f1a9-5b74-5ef6-9959-7ae95629014f" :answer/type {:db/ident :answer.type/math} :answer/value "0.0264" :db/id #edb/ref 17592186661094} {:answer/id #uuid "4fa77dc4-fc99-54fb-ae24-1c2f2701bd18" :answer/type {:db/ident :answer.type/math} :answer/value "0.2987" :db/id #edb/ref 17592186661122} {:answer/id #uuid "8b887973-7700-5180-b0dc-016297898fa2" :answer/type {:db/ident :answer.type/math} :answer/value "0.0797" :db/id #edb/ref 17592186661210} {:answer/id #uuid "c7c1fa4f-5688-5542-9aee-7ef18bec54de" :answer/type {:db/ident :answer.type/math} :answer/value "0.0287" :db/id #edb/ref 17592186661315}] :answer-field/correct {:db/id #edb/ref 17592186661122} :answer-field/id #uuid "cdad9f74-63a1-508f-bbd1-32541867effa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661473}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5541d78a-a67e-52bd-b9cc-afd38f83c662" :question/math-academy-id "q-97601" :question/problem "Given $X∼\\text{NB}(17,0.81),$ compute $P(21<X<25),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(17,0.81),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{16})(0.19)^{x-17}(0.81)^{17}, & x=17,18,19,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(21<X<25) & =P(X\\in \\{22,23,24\\}) \\\\  & =P(X=22)+P(X=23)+P(X=24) \\\\  & =f(22)+f(23)+f(24) \\\\  & =(\\genfrac{}{}{0pt}{}{21}{16})(0.19)^{5}(0.81)^{17}+(\\genfrac{}{}{0pt}{}{22}{16})(0.19)^{6}(0.81)^{17}+(\\genfrac{}{}{0pt}{}{23}{16})(0.19)^{7}(0.81)^{17} \\\\  & ≈0.2987\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e070b6f-7b60-5256-bc15-887b7758b83b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186661059} {:answer/id #uuid "30047be9-2fe3-562c-a39d-1fb10a7206be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186661062} {:answer/id #uuid "54607aed-7c48-5753-9a56-30075c799448" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20}{9}" :db/id #edb/ref 17592186661134} {:answer/id #uuid "77901299-37ab-5b5f-8d1d-d23fe6c061c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{65}{9}" :db/id #edb/ref 17592186661182} {:answer/id #uuid "7ad48f8e-3012-50d3-8ad6-c31cbf286926" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186661189}] :answer-field/correct {:db/id #edb/ref 17592186661134} :answer-field/id #uuid "0c4f0cc6-95ba-5e4a-936b-133579d7e491" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661404}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "57d6351c-839d-5170-8574-6ef83c62585c" :question/math-academy-id "q-149398" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,1)=\\{\\begin{aligned}\\frac{5}{2{x}^{7/2}}, & \\,x\\ge 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=1]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,1)$ is shown above and the corresponding expected value is ${\\mu }_{X|1}=\\frac{5}{3}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{5}{2{x}^{7/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{5}{2{x}^{3/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{5}{2}{x}^{-3/2}\\,\\text{d}x \\\\  & ={[\\frac{5}{2}\\cdot (-2)\\cdot {x}^{-1/2}]}_{1}^{\\infty } \\\\  & ={[-\\frac{5}{\\sqrt{x}}]}_{1}^{\\infty } \\\\  & =0-(-5) \\\\  & =5.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=1] & =\\text{E}[{X}^{2}\\,|\\,Y=1]-{\\mu }_{X|1}^{2} \\\\  & =5-{\\left(\\frac{5}{3}\\right)}^{2} \\\\  & =5-\\frac{25}{9} \\\\  & =\\frac{20}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0304c17c-c925-57dd-a200-6ab951bfa113" :answer/type {:db/ident :answer.type/math} :answer/value "0.1618" :db/id #edb/ref 17592186660977} {:answer/id #uuid "39629cba-bcdc-5693-a4e9-442b5f7a57b0" :answer/type {:db/ident :answer.type/math} :answer/value "0.1783" :db/id #edb/ref 17592186661078} {:answer/id #uuid "3b8e971b-3f45-5d12-a771-e0930723ac3c" :answer/type {:db/ident :answer.type/math} :answer/value "0.0159" :db/id #edb/ref 17592186661080} {:answer/id #uuid "503ab1b9-d5f9-5f81-ade7-b1e76989c7c5" :answer/type {:db/ident :answer.type/math} :answer/value "0.6219" :db/id #edb/ref 17592186661124} {:answer/id #uuid "d3672e29-f1bb-5523-96fb-386cd6e3b45a" :answer/type {:db/ident :answer.type/math} :answer/value "0.1928" :db/id #edb/ref 17592186661332}] :answer-field/correct {:db/id #edb/ref 17592186660977} :answer-field/id #uuid "31caf3cd-5d27-52c4-b9d0-309e2477195f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661415}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6e3ad5bf-4344-5202-9875-5022d7079f3d" :question/math-academy-id "q-97550" :question/problem "Given that $X∼\\text{NB}(9,0.7),$ compute $P(X=13),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(9,0.7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{8})(0.3)^{x-9}(0.7)^{9}, & x=9,10,11,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=13) & =f(13) \\\\  & =(\\genfrac{}{}{0pt}{}{13-1}{8})(0.3)^{13-9}(0.7)^{9} \\\\  & =(\\genfrac{}{}{0pt}{}{12}{8})(0.3)^{4}(0.7)^{9} \\\\  & ≈0.1618\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab886e0b-81fe-5458-80da-e18de314d020" :answer/type {:db/ident :answer.type/math} :answer/value "0.6978" :db/id #edb/ref 17592186661269} {:answer/id #uuid "abe562d8-d3a4-58a7-976e-08411b9ce6b8" :answer/type {:db/ident :answer.type/math} :answer/value "0.9984" :db/id #edb/ref 17592186661270} {:answer/id #uuid "e28f5db3-25e0-5508-89a6-3da2e296db82" :answer/type {:db/ident :answer.type/math} :answer/value "0.9844" :db/id #edb/ref 17592186661351} {:answer/id #uuid "e535317a-6c09-5aa2-bdd6-46b45b0679fe" :answer/type {:db/ident :answer.type/math} :answer/value "0.0939" :db/id #edb/ref 17592186661354} {:answer/id #uuid "e70b25bc-1963-5a6a-b7a5-5167978e8259" :answer/type {:db/ident :answer.type/math} :answer/value "0.9949" :db/id #edb/ref 17592186661357}] :answer-field/correct {:db/id #edb/ref 17592186661270} :answer-field/id #uuid "6f208f12-198a-5529-8d64-fd50fb8a6304" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661433}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7437bec2-f31b-597e-ba32-7dc01640f463" :question/math-academy-id "q-97618" :question/problem "Given $X∼\\text{NB}(18,0.57),$ compute $P(X>20),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(18,0.57),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{17})(0.43)^{x-18}(0.57)^{18}, & x=18,19,20,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>20.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X>20) & =1-P(X\\le 20)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 20) & =P(X\\in \\{18,19,20\\}) \\\\  & =P(X=18)+P(X=19)+P(X=20) \\\\  & =f(18)+f(19)+f(20) \\\\  & =(\\genfrac{}{}{0pt}{}{17}{17})(0.43)^{0}(0.57)^{18}+(\\genfrac{}{}{0pt}{}{18}{17})(0.43)^{1}(0.57)^{18}+(\\genfrac{}{}{0pt}{}{19}{17})(0.43)^{2}(0.57)^{18} \\\\  & ≈0.0016.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>20) & =1-P(X\\le 20) \\\\  & ≈1-0.0016 \\\\  & =0.9984\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07d65f47-c144-582a-b4a3-b3544da9bd0a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186660987} {:answer/id #uuid "699aad9c-a06c-5ec5-94fa-43f1f0110c47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186661165} {:answer/id #uuid "d645cffa-7e2e-50f8-b5a2-58adf7bfeae4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186661336} {:answer/id #uuid "fa237970-37f4-5299-b3bf-c0c2fdf27736" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186661386} {:answer/id #uuid "fd50c0ee-f45a-5896-8eb5-52f3c8761a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{16}" :db/id #edb/ref 17592186661390}] :answer-field/correct {:db/id #edb/ref 17592186661386} :answer-field/id #uuid "9c8f1503-1056-55a8-94d8-13f21f4917ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661451}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ac470b6-a75d-5e31-8377-45cebe6f2f3f" :question/math-academy-id "q-146210" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,2)=\\{\\begin{aligned}\\frac{7}{8}, & y=2 \\\\ \\frac{1}{8}, & y=4 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSuppose $X$ and $Y$ are discrete random variables. Find the conditional variance $\\text{Var}[Y\\,|\\,X=2]$ given that the conditional probability mass function ${f}_{Y|X}(y\\,|\\,2)$ is shown above and the corresponding conditional expected value is ${\\mu }_{Y|2}=\\frac{9}{4}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=2] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,2)]-{\\mu }_{Y|2}^{2} \\\\  & =[(2)^{2}\\cdot \\frac{7}{8}+(4)^{2}\\cdot \\frac{1}{8}]-{\\left(\\frac{9}{4}\\right)}^{2} \\\\  & =\\frac{7}{2}+2-\\frac{81}{16} \\\\  & =\\frac{7}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210a98b6-31b1-5e73-8371-4b5aa4e6f8cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{16}" :db/id #edb/ref 17592186661031} {:answer/id #uuid "86ddf722-49f4-5453-9069-5f8316c5f69a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{16}" :db/id #edb/ref 17592186661203} {:answer/id #uuid "ba50d74b-e3af-5fd2-ac75-b0b822839158" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{4}" :db/id #edb/ref 17592186661296} {:answer/id #uuid "c86cc956-b411-5b19-aa2c-b7a7bdc9dc64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186661316} {:answer/id #uuid "ed4506ba-05ac-5ac9-80b1-587e92a251bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{16}" :db/id #edb/ref 17592186661365}] :answer-field/correct {:db/id #edb/ref 17592186661203} :answer-field/id #uuid "b331fe71-b853-51e7-898e-2b2d983f82e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661463}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7b7534da-fd0f-5f2d-bae7-f40ee1c13366" :question/math-academy-id "q-149408" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,-2)=\\{\\begin{aligned}\\frac{7}{3{y}^{10/3}}, & \\,1\\le y \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=-2]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,-2)$ is shown above and the corresponding expected value is ${\\mu }_{Y|-2}=\\frac{7}{4}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=-2] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,-2)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{7}{3{y}^{10/3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{7}{3{y}^{4/3}}\\,\\text{d}y \\\\  & ={[\\frac{7}{3}\\cdot (-3)\\cdot \\frac{1}{\\sqrt[3]{y}}]}_{1}^{\\infty } \\\\  & ={[-\\frac{7}{\\sqrt[3]{y}}]}_{1}^{\\infty } \\\\  & =0-(-7) \\\\  & =7.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=-2] & =\\text{E}[{Y}^{2}\\,|\\,X=-2]-{\\mu }_{Y|-2}^{2} \\\\  & =7-{\\left(\\frac{7}{4}\\right)}^{2} \\\\  & =7-\\frac{49}{16} \\\\  & =\\frac{63}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dca5d9-ed50-5cb1-912c-29c4c10ddd37" :answer/type {:db/ident :answer.type/math} :answer/value "0.6893" :db/id #edb/ref 17592186661013} {:answer/id #uuid "2534b91c-ff1c-5125-861a-f9a4a566f491" :answer/type {:db/ident :answer.type/math} :answer/value "0.9876" :db/id #edb/ref 17592186661039} {:answer/id #uuid "3cbc9cb5-bc23-51a4-93a9-0b89d9c2efa1" :answer/type {:db/ident :answer.type/math} :answer/value "0.9987" :db/id #edb/ref 17592186661082} {:answer/id #uuid "a963e859-7d87-5169-9377-a3cee146c444" :answer/type {:db/ident :answer.type/math} :answer/value "0.0978" :db/id #edb/ref 17592186661262} {:answer/id #uuid "b53274a7-29fe-51e4-aec0-83cd9d1537a1" :answer/type {:db/ident :answer.type/math} :answer/value "0.0697" :db/id #edb/ref 17592186661287}] :answer-field/correct {:db/id #edb/ref 17592186661082} :answer-field/id #uuid "b9dcb715-1630-5955-823f-3367b19a626d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661465}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7c8337c9-531d-5006-aac2-f26db5c7fbec" :question/math-academy-id "q-97617" :question/problem "Given $X∼\\text{NB}(9,0.33),$ compute $P(X>11),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(9,0.33),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{8})(0.67)^{x-9}(0.33)^{9}, & x=9,10,11,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>11.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X>11) & =1-P(X\\le 11)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 11) & =P(X\\in \\{9,10,11\\}) \\\\  & =P(X=9)+P(X=10)+P(X=11) \\\\  & =f(9)+f(10)+f(11) \\\\  & =(\\genfrac{}{}{0pt}{}{8}{8})(0.67)^{0}(0.33)^{9}+(\\genfrac{}{}{0pt}{}{9}{8})(0.67)^{1}(0.33)^{9}+(\\genfrac{}{}{0pt}{}{10}{8})(0.67)^{2}(0.33)^{9} \\\\  & ≈0.0013.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>11) & =1-P(X\\le 11) \\\\  & ≈1-0.0013 \\\\  & =0.9987\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99dd731e-0d3a-534d-a456-7b7dbcceac9e" :answer/type {:db/ident :answer.type/math} :answer/value "0.9971" :db/id #edb/ref 17592186661236} {:answer/id #uuid "ad78eb1e-a26d-581e-b441-895c401e3535" :answer/type {:db/ident :answer.type/math} :answer/value "0.1614" :db/id #edb/ref 17592186661272} {:answer/id #uuid "b0a9e5ec-539b-5c9c-b9ca-44fda7fbec0d" :answer/type {:db/ident :answer.type/math} :answer/value "0.7119" :db/id #edb/ref 17592186661280} {:answer/id #uuid "c26d3e8c-1721-52a6-bd97-834b0d10a39d" :answer/type {:db/ident :answer.type/math} :answer/value "0.0971" :db/id #edb/ref 17592186661310} {:answer/id #uuid "dafe5354-016d-524b-ae14-30c16ad139b0" :answer/type {:db/ident :answer.type/math} :answer/value "0.0716" :db/id #edb/ref 17592186661341}] :answer-field/correct {:db/id #edb/ref 17592186661236} :answer-field/id #uuid "1311d863-ec7f-5a07-8656-c7bfc828ca2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661407}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "85eb79b1-6b1e-5929-bb1e-557944c42c0a" :question/math-academy-id "q-97606" :question/problem "Given $X∼\\text{NB}(23,0.66),$ compute $P(X\\ge 26),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(23,0.66),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{22})(0.34)^{x-23}(0.66)^{23}, & x=23,24,25,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 26.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 26) & =1-P(X<26)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<26) & =P(X\\in \\{23,24,25\\}) \\\\  & =P(X=23)+P(X=24)+P(X=25) \\\\  & =f(23)+f(24)+f(25) \\\\  & =(\\genfrac{}{}{0pt}{}{22}{22})(0.34)^{0}(0.66)^{23}+(\\genfrac{}{}{0pt}{}{23}{22})(0.34)^{1}(0.66)^{23}+(\\genfrac{}{}{0pt}{}{24}{22})(0.34)^{2}(0.66)^{23} \\\\  & ≈0.0029.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 26) & =1-P(X<26) \\\\  & ≈1-0.0029 \\\\  & =0.9971\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26fd4c33-9305-5336-ad85-b0fd6d72958f" :answer/type {:db/ident :answer.type/math} :answer/value "0.9130" :db/id #edb/ref 17592186661046} {:answer/id #uuid "348a0dc3-9ef4-54e0-adb0-2eb072ff59fb" :answer/type {:db/ident :answer.type/math} :answer/value "0.9093" :db/id #edb/ref 17592186661068} {:answer/id #uuid "44fb2b03-1ab4-5210-9d84-16909d7aa707" :answer/type {:db/ident :answer.type/math} :answer/value "0.8973" :db/id #edb/ref 17592186661102} {:answer/id #uuid "bcc32572-9898-5ffb-afda-0df541b7a4c7" :answer/type {:db/ident :answer.type/math} :answer/value "0.9393" :db/id #edb/ref 17592186661298} {:answer/id #uuid "be74e959-c756-5230-94ae-d1b79a884a1f" :answer/type {:db/ident :answer.type/math} :answer/value "0.9930" :db/id #edb/ref 17592186661303}] :answer-field/correct {:db/id #edb/ref 17592186661303} :answer-field/id #uuid "01a2c4ce-21a9-50e4-b342-f2436db9e05a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661399}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8956d518-dcb2-5b11-ad81-32d390b609fd" :question/math-academy-id "q-97616" :question/problem "Given $X∼\\text{NB}(22,0.68),$ compute $P(X>24),$ rounded to $4$ decimal places." :question/worked-solution "For a negative binomial random variable $X∼\\text{NB}(r,p),$ we have the following probability distribution:\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{r-1})(1-p)^{x-r}{p}^{r}, & x=r,r+1,r+2,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{NB}(22,0.68),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(\\genfrac{}{}{0pt}{}{x-1}{21})(0.32)^{x-22}(0.68)^{22}, & x=22,23,24,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>24.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X>24) & =1-P(X\\le 24)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 24) & =P(X\\in \\{22,23,24\\}) \\\\  & =P(X=22)+P(X=23)+P(X=24) \\\\  & =f(22)+f(23)+f(24) \\\\  & =(\\genfrac{}{}{0pt}{}{21}{21})(0.32)^{0}(0.68)^{22}+(\\genfrac{}{}{0pt}{}{22}{21})(0.32)^{1}(0.68)^{22}+(\\genfrac{}{}{0pt}{}{23}{21})(0.32)^{2}(0.68)^{22} \\\\  & ≈0.0070.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>24) & =1-P(X\\le 24) \\\\  & ≈1-0.0070 \\\\  & =0.9930\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186661535 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25908671-ec15-5a8f-96ce-ce6f50eb7618" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{49}" :db/id #edb/ref 17592186661041} {:answer/id #uuid "295f95c6-aea6-5b9c-91eb-bd9a506b8e09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{35}" :db/id #edb/ref 17592186661051} {:answer/id #uuid "2b77728a-4ff3-5cd6-b5eb-3c5aa1b79cc0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{245}" :db/id #edb/ref 17592186661056} {:answer/id #uuid "a12f28bd-10a7-5a95-be81-bfd7525548a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186661253} {:answer/id #uuid "f40e1b86-d402-5e6e-b2a7-1aa1ef9256f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{178}{245}" :db/id #edb/ref 17592186661378}] :answer-field/correct {:db/id #edb/ref 17592186661056} :answer-field/id #uuid "a8438282-3ea9-5730-b6a4-cc4a570f9dea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661455}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c94bcb6-514e-5b2c-8576-1c70b30b4181" :question/math-academy-id "q-146774" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,4)=\\{\\begin{aligned}\\frac{4}{3}\\sqrt[3]{x}, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=4]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,4)$ is shown above and the corresponding expected value is ${\\mu }_{X|4}=\\frac{4}{7}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=4] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,4)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{4}{3}\\sqrt[3]{x}\\,\\text{d}x \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}{x}^{2}\\cdot {x}^{1/3}\\,\\text{d}x \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}{x}^{7/3}\\,\\text{d}x \\\\  & =\\frac{4}{3}{[\\frac{3}{10}{x}^{10/3}]}_{0}^{1} \\\\  & =\\frac{4}{3}\\cdot \\frac{3}{10}{[{x}^{10/3}]}_{0}^{1} \\\\  & =\\frac{2}{5}(1-0) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=4] & =\\text{E}[{X}^{2}\\,|\\,Y=4]-{\\mu }_{X|4}^{2} \\\\  & =\\frac{2}{5}-{\\left(\\frac{4}{7}\\right)}^{2} \\\\  & =\\frac{2}{5}-\\frac{16}{49} \\\\  & =\\frac{18}{245}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "477b5a5e-d1a4-5d2d-b351-2f181dc7b970" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186661106} {:answer/id #uuid "578a979d-dc23-5a60-a147-87b8972ba098" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186661143} {:answer/id #uuid "b891e7fe-a826-5585-a48a-d7ed9999bb1e" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186661294} {:answer/id #uuid "bd5d76ee-7a21-5cef-accf-e6b61846381f" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186661300} {:answer/id #uuid "efcba831-54fe-591b-a6b7-ab06e51d4b50" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186661371}] :answer-field/correct {:db/id #edb/ref 17592186661371} :answer-field/id #uuid "ca6d79b5-d394-5cf6-bb4a-da10094b8a28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661472}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97f37707-9dc6-5bc6-bf22-14946fd140b8" :question/math-academy-id "q-146209" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,4)=\\{\\begin{aligned}0.8, & y=5 \\\\ 0.2, & y=10 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSuppose $X$ and $Y$ are discrete random variables. Find the conditional variance $\\text{Var}[Y\\,|\\,X=4]$ given that the conditional probability mass function ${f}_{Y|X}(y\\,|\\,4)$ is shown above and the corresponding conditional expected value is ${\\mu }_{Y|4}=6.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=4] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,4)]-{\\mu }_{Y|4}^{2} \\\\  & =[(5)^{2}\\cdot 0.8+(10)^{2}\\cdot 0.2]-(6)^{2} \\\\  & =20+20-36 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29e49317-6d5f-5aa1-b709-03d7b6095984" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{180}" :db/id #edb/ref 17592186661053} {:answer/id #uuid "4d0eb8ab-3ddf-5914-8222-afabef1e52e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{180}" :db/id #edb/ref 17592186661115} {:answer/id #uuid "87d7159c-edbc-5252-81dd-0a146d055321" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{77}{180}" :db/id #edb/ref 17592186661204} {:answer/id #uuid "caa62be7-f23d-57ac-a1d8-7e7d1fe2a324" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{77}{35}" :db/id #edb/ref 17592186661319} {:answer/id #uuid "d445e8c7-1600-58c4-82f5-a7f9de890aff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{35}" :db/id #edb/ref 17592186661333}] :answer-field/correct {:db/id #edb/ref 17592186661053} :answer-field/id #uuid "4a996868-3fa6-5eae-ba27-6a61f6bf6c6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661426}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9bf376d4-d63e-5caf-a453-b38619cd03a5" :question/math-academy-id "q-149409" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,1)=\\{\\begin{aligned}\\frac{7}{{y}^{8}}, & \\,1\\le y \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,1)$ is shown above and the corresponding expected value is ${\\mu }_{Y|1}=\\frac{7}{6}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{7}{{y}^{8}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{7}{{y}^{6}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }7{y}^{-6}\\,\\text{d}y \\\\  & ={[7\\cdot \\left(-\\frac{1}{5}\\right)\\cdot {y}^{-5}]}_{1}^{\\infty } \\\\  & ={[-\\frac{7}{5{y}^{5}}]}_{1}^{\\infty } \\\\  & =0-\\left(-\\frac{7}{5}\\right) \\\\  & =\\frac{7}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{7}{5}-{\\left(\\frac{7}{6}\\right)}^{2} \\\\  & =\\frac{7}{5}-\\frac{49}{36} \\\\  & =\\frac{7}{180}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114530dd-82cc-5e99-92b8-ce6db35ece9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{{x}^{3}}" :db/id #edb/ref 17592186661003} {:answer/id #uuid "252c0812-18b0-541b-9830-6dc4afbdc0da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{{x}^{2}}" :db/id #edb/ref 17592186661038} {:answer/id #uuid "61d5d5a8-639b-58ee-ba99-1eaf55983a77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{2{x}^{3}}" :db/id #edb/ref 17592186661153} {:answer/id #uuid "94dc46ce-132d-5c23-9467-a16166927bf3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{2{x}^{3}}" :db/id #edb/ref 17592186661223} {:answer/id #uuid "f17fdf1b-496f-55b6-a593-75d3091f31eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3y}{{x}^{2}}" :db/id #edb/ref 17592186661376}] :answer-field/correct {:db/id #edb/ref 17592186661003} :answer-field/id #uuid "c8cef596-68fc-5036-bd81-e7aa1025c175" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186661471}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "af19bf5b-85d7-5007-8095-a99e690fbf65" :question/math-academy-id "q-159313" :question/problem "The joint CDF of two continuous random variables $X$ and $Y$ is given by\n\n$$\nF(x,y)=\\{\\begin{aligned}0, & x<1\\,\\text{or}\\,y<-1 \\\\ \\frac{({x}^{2}-1)({y}^{3}+1)}{2{x}^{2}}, & x\\ge 1,\\,-1\\le y\\le 1 \\\\ {F}_{X}(x), & x\\ge 1,\\,y>1.\\end{aligned}\n$$\n\nFind the joint PDF $f(x,y)$ for $x\\ge 1,\\,-1\\le y\\le 1.$" :question/worked-solution "Since the partial derivatives of $F(x,y)$ are defined, the joint probability density function $f(x,y)$ is given by\n\n$$\nf(x,y)=\\frac{{∂}^{2}}{∂x∂y}F(x,y).\n$$\n\nFor $x\\ge 1$ and $-1\\le y\\le 1,$ we have\n\n$$\n\\begin{aligned}f(x,y) & =\\frac{{∂}^{2}}{∂x∂y}F(x,y) \\\\  & =\\frac{∂}{∂x}(\\frac{∂}{∂y}\\left(\\frac{({x}^{2}-1)({y}^{3}+1)}{2{x}^{2}}\\right)) \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{2}-1}{2{x}^{2}}\\cdot \\frac{∂}{∂y}({y}^{3}+1)) \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{2}-1}{2{x}^{2}}\\cdot 3{y}^{2}) \\\\  & =\\frac{3{y}^{2}}{2}\\cdot \\frac{∂}{∂x}(1-\\frac{1}{{x}^{2}}) \\\\  & =\\frac{3{y}^{2}}{2}\\cdot \\frac{2}{{x}^{3}} \\\\  & =\\frac{3{y}^{2}}{{x}^{3}}.\\end{aligned}\n$$\n\nOtherwise, $f(x,y)=0.$\n\nTherefore, we have\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3{y}^{2}}{{x}^{3}}, & x\\ge 1,\\,-1\\le y\\le 1 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}]}
