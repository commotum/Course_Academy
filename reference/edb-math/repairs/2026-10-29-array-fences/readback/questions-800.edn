#{[{:db/id #edb/ref 17592186550021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249e501c-2f96-5d3a-aca1-a06ed673e1ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}\\,-28 & 5 \\\\ \\,\\,11 & 2\\end{vmatrix}" :db/id #edb/ref 17592186549393} {:answer/id #uuid "2592d63c-e1be-5dbf-bf09-9ff0d9f2f561" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}\\,11 & 8 \\\\ \\,-28 & 3\\end{vmatrix}" :db/id #edb/ref 17592186549394} {:answer/id #uuid "41433e06-ff80-564d-9ce3-d0dc9852a8ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}8 & 3 \\\\ 3 & 2\\end{vmatrix}" :db/id #edb/ref 17592186549448} {:answer/id #uuid "752e27ae-6bc8-5acc-bb2a-b47134fc80d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}\\,-28 & 8 \\\\ \\,\\,11 & 3\\end{vmatrix}" :db/id #edb/ref 17592186549538} {:answer/id #uuid "8a477f06-b877-5fa0-bce3-9f5744ae6971" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & \\,-28 \\\\ 2 & \\,11\\end{vmatrix}" :db/id #edb/ref 17592186549579}] :answer-field/correct {:db/id #edb/ref 17592186549538} :answer-field/id #uuid "8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186549858}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc096f25-da43-5ef0-8dca-9310fea097c1" :question/math-academy-id "q-42981" :question/problem "Consider the system of linear equations \n\n$$\n\\{\\begin{aligned}5x+8y=-28 \\\\ 2x+3y=11.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the unknown $x$ can be written as $$\n\\displaystyle x=\\frac{{D}_{x}}{\\begin{vmatrix}5 & 8 \\\\ 2 & 3\\end{vmatrix}},\n$$ where ${D}_{x}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}5x+8y=-28 \\\\ 2x+3y=11.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is \n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}5 & 8 \\\\ 2 & 3\\end{vmatrix}.\\end{aligned}\n$$\n\nNow, to construct ${D}_{x}$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{x} & =\\begin{vmatrix}\\,-28 & 8 \\\\ \\,\\,11 & 3\\end{vmatrix}\\end{aligned}.\n$$"}] [{:db/id #edb/ref 17592186551258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55053340-f635-546e-8e5d-4621e256edb8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186550570} {:answer/id #uuid "ab11db4e-65b6-5238-aa40-285ffcaa4e1d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186550828} {:answer/id #uuid "b7737c7e-9824-5e5f-a3ae-34856a098e7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186550872} {:answer/id #uuid "efdbe697-d6a3-508c-a692-ae48f85ba690" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551016}] :answer-field/correct {:db/id #edb/ref 17592186551016} :answer-field/id #uuid "319f9cc5-6350-50bc-9ef5-9fc966e9afe8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551094} {:answer-field/choices [{:answer/id #uuid "1b3542e3-4bf3-5d25-87cb-feba5f3ffd90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{{n}^{2}({n}^{2}{\\pi }^{2}+81)}" :db/id #edb/ref 17592186550425} {:answer/id #uuid "5558f4a3-3994-5897-8ff9-622d5df04392" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{n({n}^{2}{\\pi }^{2}+81)}" :db/id #edb/ref 17592186550571} {:answer/id #uuid "e29b2edf-998e-5740-bb95-54727e9f45f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{n({n}^{2}{\\pi }^{2}+81)}" :db/id #edb/ref 17592186550986}] :answer-field/correct {:db/id #edb/ref 17592186550986} :answer-field/id #uuid "44914850-8fa0-5396-b873-81fa2f52fbd0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551107} {:answer-field/choices [{:answer/id #uuid "46ca47af-c6a7-509f-8d83-2150c0238a78" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{18}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+81)}" :db/id #edb/ref 17592186550533} {:answer/id #uuid "92481f36-1e85-521a-ba9a-acee004b176f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{162}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+81)}" :db/id #edb/ref 17592186550736} {:answer/id #uuid "e0c34785-8282-5217-a833-be2afab68c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{162}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+81)}" :db/id #edb/ref 17592186550981}] :answer-field/correct {:db/id #edb/ref 17592186550736} :answer-field/id #uuid "cdd62ed7-f5a0-5d14-b295-af477d1b5a66" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551193}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "336eb7d8-27df-584e-adc9-df5d1de8bc4e" :question/math-academy-id "q-344058" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{′}-3y=f(x),$ where the Fourier series of the $6$-periodic forcing function is given by\n\n$$\nf(x)∼-3+{\\sum }_{n=1}^{\\infty }\\frac{6}{{n}^{2}\\pi }\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nThe Fourier series of a particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼{{field-1}} & +{\\sum }_{n=1}^{\\infty }\\,{{field-2}}\\cdot \\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,{{field-3}}\\cdot \\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\\end{aligned}\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)+{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)+{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right))+{b}_{n}\\cdot \\frac{n\\pi }{3}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)) \\\\  & \\,-3(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)+{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)) \\\\  & \\,\\,=-3+{\\sum }_{n=1}^{\\infty }\\frac{6}{{n}^{2}\\pi }\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & -3\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{3}-3{a}_{n})\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{3}-3{b}_{n})\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right) \\\\  & \\,\\,\\,\\,=-3+{\\sum }_{n=1}^{\\infty }\\frac{6}{{n}^{2}\\pi }\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n\\{\\begin{aligned}-3\\cdot \\frac{{a}_{0}}{2}=-3 \\\\ \\frac{{b}_{n}n\\pi }{3}-3{a}_{n}=\\frac{6}{{n}^{2}\\pi } \\\\ -\\frac{{a}_{n}n\\pi }{3}-3{b}_{n}=0\\end{aligned}\n$$\n\nFrom the first equation, ${a}_{0}=2,$ which means the constant term is given by\n\n$$\n\\frac{{a}_{0}}{2}=1.\n$$\n\nNext, from the third equation, \n\n$$\n{b}_{n}=-\\frac{{a}_{n}n\\pi }{9}.\n$$\n\nSubstituting this into the second equation gives\n\n$$\n\\left(-\\frac{{a}_{n}n\\pi }{9}\\right)\\frac{n\\pi }{3}-3{a}_{n}=\\frac{6}{{n}^{2}\\pi }\\,⇒\\,{a}_{n}=-\\frac{162}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+81)}.\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{{a}_{n}n\\pi }{9} \\\\  & =-\\frac{n\\pi }{9}\\cdot \\left(-\\frac{162}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+81)}\\right) \\\\  & =\\frac{18}{n({n}^{2}{\\pi }^{2}+81)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼1 & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{162}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+81)}\\cdot \\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,\\frac{18}{n({n}^{2}{\\pi }^{2}+81)}\\cdot \\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359a8301-f2b5-525c-9c59-3eca56ed7220" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186550498} {:answer/id #uuid "954ac438-6aab-5e66-944b-f44c338618fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186550741} {:answer/id #uuid "a5bc2cfa-37ac-5ab0-91e9-e6abbac4d269" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186550802} {:answer/id #uuid "c4801de1-59ca-57fe-b0c0-05d352233bf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550899} {:answer/id #uuid "d128f841-a358-5f8c-9454-d6b460a2413f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186550931}] :answer-field/correct {:db/id #edb/ref 17592186550498} :answer-field/id #uuid "78d3bcbf-8ec9-56b3-920b-0ce0b0b51783" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551136}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3433ea61-fe1b-529a-a624-2ade0d70ec66" :question/math-academy-id "q-130818" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix},\\,{E}_{2}=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}{}[{E}_{1}\\,|\\,I\\,] & =[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & -1 & 0 & 1\\end{array}] &  & {R}_{2}:=(-1){R}_{2} \\\\  & ∼[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -1\\end{array}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{1}^{-1}=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186551266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "582190fc-850a-5c44-9e79-a818e78b201e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186550584} {:answer/id #uuid "68202c51-a8c7-5b41-8b8e-52288fa600be" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550625} {:answer/id #uuid "7873d209-1846-562f-a21c-77b8683916c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186550674} {:answer/id #uuid "9266158b-36be-5081-ada4-69f033c39993" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550737} {:answer/id #uuid "e7bd5536-867b-57d6-9150-07d885c15b03" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & \\frac{1}{3} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550996}] :answer-field/correct {:db/id #edb/ref 17592186550737} :answer-field/id #uuid "a94df7ac-0f23-5acc-9a88-bce1ea6077bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551168}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3df63019-7de5-5b3e-afc6-d7a9e953df1d" :question/math-academy-id "q-130784" :question/problem "Find the inverse of the elementary matrix \n$$\n\\displaystyle L=\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We write down $L$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}{}[L\\,|\\,I\\,] & =[\\begin{array}{cc|cc}1 & -3 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{array}] &  & {R}_{1}:={R}_{1}+3{R}_{2} \\\\  & ∼[\\begin{array}{cc|cc}1 & 0 & 1 & 3 \\\\ 0 & 1 & 0 & 1\\end{array}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{L}^{-1}=\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186551278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171d85cf-363f-5e91-8844-7377fbfe4868" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ -2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186550417} {:answer/id #uuid "abc41fe2-4fc6-5168-adaa-26ac614241df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186550831} {:answer/id #uuid "b8d97c63-845a-5df4-bd21-ef85ce115fe4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186550877} {:answer/id #uuid "d05c1129-f39e-5113-b571-d89546b3420c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550927} {:answer/id #uuid "d7b02096-c5f8-533f-a7c6-397872aa44c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ -2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186550950}] :answer-field/correct {:db/id #edb/ref 17592186550417} :answer-field/id #uuid "2aa55760-fe42-5b20-a3f8-0684f066d9d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551090}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5238d337-5418-5670-995a-6cacdf9c34e1" :question/math-academy-id "q-130816" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix},\\,{E}_{2}=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}{}[{E}_{1}\\,|\\,I\\,] & =[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{array}] &  & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & -2 & 1\\end{array}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{1}^{-1}=\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}.\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ -2 & 3\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186551285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc4a3af-4483-521b-bb70-d53ecf298569" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550553} {:answer/id #uuid "6dac34b7-0afe-57b3-92dd-0f1fe22e6081" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550640}] :answer-field/correct {:db/id #edb/ref 17592186550553} :answer-field/id #uuid "a7c63119-6c8c-562e-abc9-23fca39a632c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551166} {:answer-field/choices [{:answer/id #uuid "80ea76ea-89c9-5952-ae08-cee6ace28d82" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550695} {:answer/id #uuid "ee7734d0-53ef-5456-8980-faad9723c723" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186551013}] :answer-field/correct {:db/id #edb/ref 17592186551013} :answer-field/id #uuid "c9e2bd45-2176-5d0a-8daf-b4630614c646" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551190} {:answer-field/choices [{:answer/id #uuid "25e88e23-60be-52a5-b776-49ba011dac2d" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550461} {:answer/id #uuid "ae9e632a-9e59-5e68-bbaf-7f55bdadec72" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550843}] :answer-field/correct {:db/id #edb/ref 17592186550843} :answer-field/id #uuid "dcc6415d-3e4e-531f-9f82-1e1222466f88" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551206} {:answer-field/choices [{:answer/id #uuid "5e730ffa-3f8d-587a-90e9-54ce2eab4291" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550596} {:answer/id #uuid "c97a6594-ee59-51ba-bb03-4d481212136d" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550911}] :answer-field/correct {:db/id #edb/ref 17592186550911} :answer-field/id #uuid "e6e854c4-06f2-5c3a-8345-9858abe5cb7f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551215}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6acce05c-927e-54a3-ab7e-dea3332ed930" :question/math-academy-id "q-342257" :question/problem "$$\nF(x)=\\{\\begin{aligned}-5x, & x\\in [-2,0) \\\\ \\frac{5}{2}{x}^{2}, & x\\in [0,2)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-2,2).$ Let $f(x)$ be the $4$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-2,2)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-2,2)$ | {{field-2}} |\n| III. | $\\lim_{x\\to -{2}^{+}}F(x)=\\lim_{x\\to {2}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{true}.$ The function $F(x)$ is continuous on $x\\in (-2,2).$ Its graph is shown below.\n\n![](images/64/64b557365c3642ae7a4206794080804bf2bbccb07230dfa46a4f415570f85329.png)\n\n- Statement II is $\\text{true}.$ The function $F(x)$ is piecewise smooth on $x\\in (-2,2).$ It consists of two smooth pieces.\n\n- Statement III is $\\text{true}.$ Indeed, we have\n\n$$\n\\lim_{x\\to -{2}^{+}}F(x)=\\lim_{x\\to -{2}^{+}}-5x=-5(-2)=10\n$$\n\nand \n\n$$\n\\lim_{x\\to {2}^{-}}F(x)=\\lim_{x\\to {2}^{-}}\\frac{5}{2}{x}^{2}=\\frac{5}{2}(2)^{2}=10.\n$$\n\nSo, $\\lim_{x\\to -{2}^{+}}F(x)=\\lim_{x\\to {2}^{-}}F(x).$\n\n- Statement IV is $\\text{true}$ since statements I, II, and III are all true.\n\n**Note:** The $4$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/cd/cd37979eada411b68755dfa85ec3b1e22585df2bff5c4bdd4b27cf06463706d6.png)"}] [{:db/id #edb/ref 17592186551286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32904df2-4f2b-512e-b905-4f4eebcb813e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -12\\end{bmatrix}" :db/id #edb/ref 17592186550488} {:answer/id #uuid "b50b8760-3a6d-55c4-a188-c37cf457dc61" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186550863} {:answer/id #uuid "e8fc2b8c-e26a-5dd7-a42a-b9a4b347b89f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 12 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550998} {:answer/id #uuid "f98c45d9-1ef2-58e4-b974-3eb63756e062" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -12 & 1\\end{bmatrix}" :db/id #edb/ref 17592186551036} {:answer/id #uuid "ffcf0b97-a0e4-515d-9606-6b57bb04f711" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 12 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186551057}] :answer-field/correct {:db/id #edb/ref 17592186550863} :answer-field/id #uuid "f732bcd0-c8c8-5638-93ed-8a183c2c0d4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551224}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ad7a8de-9677-5fd6-a871-171f20886f2e" :question/math-academy-id "q-130788" :question/problem "Find the inverse of the elementary matrix \n$$\n\\displaystyle N=\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{12}\\end{bmatrix}.\n$$" :question/worked-solution "We write down $N$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}{}[N\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & \\frac{1}{12} & 0 & 1\\end{array}\\right] &  & {R}_{2}:=12{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & 12\\end{array}\\right]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{N}^{-1}=\\begin{bmatrix}1 & 0 \\\\ 0 & 12\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186551296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "726b610b-966f-5fad-8937-be3c12d0601d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550654} {:answer/id #uuid "77d890b8-7322-5242-a284-9e74f77fee01" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550671} {:answer/id #uuid "d0ae9d64-3c04-543e-9bad-0f91c19f44f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186550928} {:answer/id #uuid "db2ac3cb-cacf-5f7f-8f49-0a6d597fce81" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186550963} {:answer/id #uuid "f6d47fd4-271e-59b7-9dfb-e64e565385a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186551029}] :answer-field/correct {:db/id #edb/ref 17592186550928} :answer-field/id #uuid "3af9e33e-f08c-574c-97d5-344ef1178cc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551102}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7effc142-a727-5443-a7a6-2e2db67c4b1f" :question/math-academy-id "q-32008" :question/problem "Find the inverse of the elementary matrix \n$$\n\\displaystyle S=\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We write down $S$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}{}[S\\,|\\,I\\,] & =[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ -4 & 1 & 0 & 1\\end{array}] &  & {R}_{2}:={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & 4 & 1\\end{array}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{S}^{-1}=\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186551307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78061c99-9116-56c2-88f4-777413d48782" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{18(-1)^{n}}{n\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186550672} {:answer/id #uuid "85bccb7d-0294-553d-b094-d5837f950d47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24(-1)^{n}}{n\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186550705} {:answer/id #uuid "f77c27c9-c7d3-591e-bac3-638faae40001" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n}}{n\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186551033}] :answer-field/correct {:db/id #edb/ref 17592186550705} :answer-field/id #uuid "34398e9c-a70c-53b7-b84a-4a5e338eee91" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551097} {:answer-field/choices [{:answer/id #uuid "30256479-a0c3-536f-992c-58c727330693" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12(-1)^{n}}{{n}^{2}{\\pi }^{2}({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186550484} {:answer/id #uuid "644342fd-f897-5f58-92a1-0b8ef53eb76b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(-1)^{n}}{n({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186550609} {:answer/id #uuid "ab325d87-a065-546e-baf7-139015307fa0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4(-1)^{n}}{{n}^{2}{\\pi }^{2}+36}" :db/id #edb/ref 17592186550829}] :answer-field/correct {:db/id #edb/ref 17592186550829} :answer-field/id #uuid "819e15d7-2e20-52a4-83ba-4e170679fa89" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551140}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a503430-335a-52ca-a8f2-1a25c8b18de5" :question/math-academy-id "q-343819" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{′}+3y=f(x),$ where the Fourier series of the $4$-periodic forcing function is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{n\\pi }sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot cos\\,\\left(\\frac{n\\pi x}{2}\\right)+{{field-2}}\\cdot sin\\,\\left(\\frac{n\\pi x}{2}\\right)\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}cos\\,\\left(\\frac{n\\pi x}{2}\\right)+{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}cos\\,\\left(\\frac{n\\pi x}{2}\\right)+{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right)) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{2}sin\\,\\left(\\frac{n\\pi x}{2}\\right))+{b}_{n}\\cdot \\frac{n\\pi }{2}cos\\,\\left(\\frac{n\\pi x}{2}\\right) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{2}sin\\,\\left(\\frac{n\\pi x}{2}\\right)+\\frac{{b}_{n}n\\pi }{2}cos\\,\\left(\\frac{n\\pi x}{2}\\right)\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{2}sin\\,\\left(\\frac{n\\pi x}{2}\\right)+\\frac{{b}_{n}n\\pi }{2}cos\\,\\left(\\frac{n\\pi x}{2}\\right)) \\\\  & \\,+3(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}cos\\,\\left(\\frac{n\\pi x}{2}\\right)+{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right)) \\\\  & \\,\\,={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{n\\pi }sin\\,\\left(\\frac{n\\pi x}{2}\\right)\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & \\frac{3{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{2}+3{a}_{n})cos\\,\\left(\\frac{n\\pi x}{2}\\right) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{2}+3{b}_{n})sin\\,\\left(\\frac{n\\pi x}{2}\\right) \\\\  & \\,\\,\\,\\,={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{n\\pi }sin\\,\\left(\\frac{n\\pi x}{2}\\right).\\end{aligned}\n$$\n\nNow, equating the free terms and the cosine and sine coefficients, we obtain the following system:\n\n$$\n\\{\\begin{aligned}\\frac{3{a}_{0}}{2}=0 \\\\ \\frac{{b}_{n}n\\pi }{2}+3{a}_{n}=0 \\\\ -\\frac{{a}_{n}n\\pi }{2}+3{b}_{n}=\\frac{2(-1)^{n}}{n\\pi }\\end{aligned}\n$$\n\nFrom the first equation, ${a}_{0}=0.$ \n\nNext, from the second equation, \n\n$$\n{a}_{n}=-\\frac{{b}_{n}n\\pi }{6}.\n$$\n\nSubstituting this into the third equation gives\n\n$$\n-\\left(-\\frac{{b}_{n}n\\pi }{6}\\right)\\frac{n\\pi }{2}+3{b}_{n}=\\frac{2(-1)^{n}}{n\\pi }\\,⇒\\,{b}_{n}=\\frac{24(-1)^{n}}{n\\pi ({n}^{2}{\\pi }^{2}+36)}\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{a}_{n} & =-\\frac{{b}_{n}n\\pi }{6} \\\\  & =-\\frac{n\\pi }{6}\\cdot \\frac{24(-1)^{n}}{n\\pi ({n}^{2}{\\pi }^{2}+36)} \\\\  & =-\\frac{4(-1)^{n}}{{n}^{2}{\\pi }^{2}+36}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,-\\frac{4(-1)^{n}}{{n}^{2}{\\pi }^{2}+36}\\cdot cos\\,\\left(\\frac{n\\pi x}{2}\\right)+\\frac{24(-1)^{n}}{n\\pi ({n}^{2}{\\pi }^{2}+36)}\\cdot sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$"}] [{:db/id #edb/ref 17592186551313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2b6588-f32d-5385-bd36-7b8f041a190c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3t}" :db/id #edb/ref 17592186550480} {:answer/id #uuid "683fbbc1-c806-50d9-85a2-308dfd7a7a36" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{-3t}" :db/id #edb/ref 17592186550627} {:answer/id #uuid "75aa5e5b-700c-53ad-aec6-1adbaed46b85" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{3t}" :db/id #edb/ref 17592186550663} {:answer/id #uuid "a76d076d-96cf-5f10-aa9f-cad8b99ef4fc" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-3t}" :db/id #edb/ref 17592186550809}] :answer-field/correct {:db/id #edb/ref 17592186550663} :answer-field/id #uuid "13b526db-cf02-5f36-a044-7d6b75922f0e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551072} {:answer-field/choices [{:answer/id #uuid "591b2b7e-b01c-5e07-a746-ed180d35a0a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186550586} {:answer/id #uuid "aa586531-3bcc-503b-820e-4330f043b12e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186550823} {:answer/id #uuid "aaa0ff68-b962-565a-bfdd-c76ff445cc7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186550825} {:answer/id #uuid "c88aed15-3026-5bed-ada9-a035e6a85c58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t \\\\ 1\\end{b