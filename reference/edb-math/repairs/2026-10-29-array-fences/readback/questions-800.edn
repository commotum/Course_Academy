6550475} :answer-field/id #uuid "e4527180-f754-595e-9604-e5840563a9e9" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551212}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "97e18a22-6fdc-5ccf-b5b0-b0a200f3d5b5" :question/math-academy-id "q-333307" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=3x(t)+y(t) \\\\ {y}^{′}(t)=3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector corresponding to the only eigenvalue of the system's matrix $A$ is $v=[1,\\text{ }0]^{T}.$ The vector $w=[0,\\text{ }1]^{T}$ is such that $(A-\\lambda I)w=v.$ Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{3t}+{c}_{2}(\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{{field-1}}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}) \\\\  & ={c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{3t}{{field-2}},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\nlie on the \n{{field-3}} \nSince ${e}^{3t}\\to $ \n{{field-4}} \nas $t\\to \\infty ,$ these solutions move toward \n{{field-5}}  \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/98/98fc60d566b520f3d943e42ee8f4e07aa0bdd33b53fbb04981c2e8f4001210fd.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{3t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x={{field-6}} \\\\ y={e}^{3t}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.11$ | $0$ | {{field-7}} |\n| $y$ | $0.22$ | $1$ | {{field-8}} |\n\nLet's add the solutions to the phase space.\n\n![](images/ee/eed535cfbba657a10aa37ffd90c4de36ae85e5acfa6e44b1790ec3372da10c3c.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/4e/4eaab4510bb15a7207aedaf37bff252132f62550d5dc62373aea0b506b7b0611.png)" :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =3$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =3,\\,v=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,w=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{3t}+{c}_{2}(\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}t{e}^{3t}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}) \\\\  & ={c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{3t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\nlie on the $x\\text{-axis}.$ Since ${e}^{3t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move toward $\\text{infinity}$ in the phase plane as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/98/98fc60d566b520f3d943e42ee8f4e07aa0bdd33b53fbb04981c2e8f4001210fd.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{3t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{3t} \\\\ y={e}^{3t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.11$ | $0$ | $2.24$ |\n| $y$ | $0.22$ | $1$ | $4.48$ |\n\nLet's add the solutions to the phase space.\n\n![](images/ee/eed535cfbba657a10aa37ffd90c4de36ae85e5acfa6e44b1790ec3372da10c3c.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/4e/4eaab4510bb15a7207aedaf37bff252132f62550d5dc62373aea0b506b7b0611.png)"}] [{:db/id #edb/ref 17592186551331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4607cf6e-3e20-5e09-a1a5-531194df6bd3" :answer/type {:db/ident :answer.type/math} :answer/value "2.13" :db/id #edb/ref 17592186550530} {:answer/id #uuid "6f2c1230-c00c-51e9-ae67-b1cccc809e43" :answer/type {:db/ident :answer.type/math} :answer/value "3.24" :db/id #edb/ref 17592186550647} {:answer/id #uuid "a9e99b2a-d27b-529d-91f0-fdfda3691a9c" :answer/type {:db/ident :answer.type/math} :answer/value "4.95" :db/id #edb/ref 17592186550818} {:answer/id #uuid "c4648e3f-2e11-59eb-8f00-3010f5c082be" :answer/type {:db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186550898}] :answer-field/correct {:db/id #edb/ref 17592186550818} :answer-field/id #uuid "01c6a10f-ebe8-58c0-a15f-3c5474e1e637" :answer-field/key "field-8" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551058} {:answer-field/choices [{:answer/id #uuid "29815c50-5111-50e4-8567-540fa5bdafe5" :answer/type {:db/ident :answer.type/text} :answer/value "$x$-axis" :db/id #edb/ref 17592186550469} {:answer/id #uuid "c7c4a816-e9ec-5cc0-a552-6ae0d393f7bb" :answer/type {:db/ident :answer.type/text} :answer/value "$y$-axis" :db/id #edb/ref 17592186550907}] :answer-field/correct {:db/id #edb/ref 17592186550469} :answer-field/id #uuid "1cb0f973-9d38-54ed-bd98-9ab310f803cc" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186551076} {:answer-field/choices [{:answer/id #uuid "1f055163-6d58-5ba9-be50-a93f85f9da79" :answer/