#{[{:db/id #edb/ref 17592186265804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e35ef35-ff48-5e0e-b45c-16d9c9d6eb80" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A" :db/id #edb/ref 17592186263953} {:answer/id #uuid "c3308c3c-38ac-5e02-8bb3-09f266686a29" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(1,2)\\times (1,4)}(\\frac{y+1}{1+{x}^{2}}+\\frac{{x}^{2}}{{y}^{2}})\\,\\text{d}A" :db/id #edb/ref 17592186264701} {:answer/id #uuid "eb6905fa-dfd2-5209-96b6-0a3467859dae" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(2,4)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A" :db/id #edb/ref 17592186265055} {:answer/id #uuid "ec02c144-31a5-5879-a3d0-81ee338bad48" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(1,2)\\times (1,4)}\\frac{{x}^{2}(y+1)}{{y}^{2}(1+{x}^{2})}\\,\\text{d}A" :db/id #edb/ref 17592186265065} {:answer/id #uuid "f38d6811-6741-50d2-bbf2-973c0069b778" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{(1,2)\\times (1,2)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A" :db/id #edb/ref 17592186265139}] :answer-field/correct {:db/id #edb/ref 17592186263953} :answer-field/id #uuid "88b62c52-192d-530f-aa19-1533d59dee25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265486}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4097ab0e-1da6-536a-8ecd-ac95516f4e76" :question/math-academy-id "q-130038" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{y+1}{1+{x}^{2}},\\, & \\text{if}\\,1<x<2,\\,1<y<2, \\\\ \\frac{{x}^{2}}{{y}^{2}},\\, & \\text{if}\\,1<x<2,\\,2<y<4.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(1,2)\\times (1,4)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(1,2)\\times ((1,2)\\cup (2,4)) \\\\  & =((1,2)\\times (1,2))\\cup ((1,2)\\times (2,4)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(1,2)\\times (1,2)}f(x,y)\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e56985f-4995-5832-bc47-741b2c1c4d9c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186263389} {:answer/id #uuid "2f850b1b-56d0-59fe-a9ae-66a9e18b21ff" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186263400} {:answer/id #uuid "368fce54-dfc9-5cf7-bfed-6e49c5c536c5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263482} {:answer/id #uuid "5242a3d0-9686-5c9e-8bd4-51f9d91b6046" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{10}{3}" :db/id #edb/ref 17592186263708} {:answer/id #uuid "a0e848e1-2f47-546b-a791-34c55dd61aef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186264366}] :answer-field/correct {:db/id #edb/ref 17592186263708} :answer-field/id #uuid "7b2c7ebf-14a9-54f0-9253-98e711bf656a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265457}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a400e754-c19b-557c-be08-7c8b69cf6b10" :question/math-academy-id "q-130042" :question/problem "Evaluate the double integral $$\n\\displaystyle {∬}_{R}f(x,y)\\,\\text{d}A,\n$$ where\n\n$$\nf(x,y)=\\{\\begin{aligned}x{y}^{2},\\, & \\text{if}\\,-2<x<0,\\,0<y<2, \\\\ 2x,\\, & \\text{if}\\,0<x<1,\\,0<y<2,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(-2,0)\\times (0,2)$ and ${R}_{2}=(0,1)\\times (0,2).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}x{y}^{2}\\,\\text{d}A+{∬}_{{R}_{2}}2x\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}(x)({y}^{2})\\,\\text{d}A+{∬}_{{R}_{2}}2x\\,\\text{d}A \\\\  & =({\\int }_{-2}^{0}x\\,\\text{d}x)({\\int }_{0}^{2}{y}^{2}\\,\\text{d}y)+(2-0){\\int }_{0}^{1}2x\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{2}]}_{-2}^{0}\\cdot {[\\frac{{y}^{3}}{3}]}_{0}^{2}+2[{x}^{2}]_{0}^{1} \\\\  & =(-2)\\cdot \\frac{8}{3}+2 \\\\  & =-\\frac{10}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fabc10d-9ae1-5e94-853a-462fb1aa00c9" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2}-e" :db/id #edb/ref 17592186263139} {:answer/id #uuid "36198322-ecf6-5863-a4a5-ad9f61a2c642" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{2}+2e-14" :db/id #edb/ref 17592186263479} {:answer/id #uuid "4ec19f8f-0bbe-587e-b732-392919b19297" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2}-e+14" :db/id #edb/ref 17592186263684} {:answer/id #uuid "5e93e174-ae19-5d17-a706-ca4ec3c6bb1f" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{2}+2e-28" :db/id #edb/ref 17592186263817} {:answer/id #uuid "a416981c-bb03-5879-bcbc-2040c346ee71" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{2}-28" :db/id #edb/ref 17592186264399}] :answer-field/correct {:db/id #edb/ref 17592186263817} :answer-field/id #uuid "49302468-b7d7-52f5-907e-c6fdfd044bfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265385}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a87d3263-74f6-5090-88d6-56cb978e87ed" :question/math-academy-id "q-130044" :question/problem "Evaluate the double integral $$\n\\displaystyle {∬}_{R}f(x,y)\\,\\text{d}A,\n$$ where\n\n$$\nf(x,y)=\\{\\begin{aligned}y{e}^{x+1},\\, & \\text{if}\\,0<x<1,\\,-2<y<0, \\\\ 3y\\sqrt{x},\\, & \\text{if}\\,1<x<4,\\,-2<y<0,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(0,1)\\times (-2,0)$ and ${R}_{2}=(1,4)\\times (-2,0).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}y{e}^{x+1}\\,\\text{d}A+{∬}_{{R}_{2}}3y\\sqrt{x}\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}({e}^{x+1})(y)\\,\\text{d}A+{∬}_{{R}_{2}}(\\sqrt{x})(3y)\\,\\text{d}A \\\\  & =({\\int }_{0}^{1}{e}^{x+1}\\,\\text{d}x)({\\int }_{-2}^{0}y\\,\\text{d}y)+({\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x)({\\int }_{-2}^{0}3y\\,\\text{d}y) \\\\  & =[{e}^{x+1}]_{0}^{1}\\cdot {[\\frac{{y}^{2}}{2}]}_{-2}^{0}+{[\\frac{2\\sqrt{{x}^{3}}}{3}]}_{1}^{4}\\cdot {[\\frac{3{y}^{2}}{2}]}_{-2}^{0} \\\\  & =({e}^{2}-e)\\cdot (0-2)+(\\frac{16}{3}-\\frac{2}{3})\\cdot (0-6) \\\\  & =-2{e}^{2}+2e-28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07bf1876-cf7e-5384-b7fe-70631d2188d3" :answer/type {:db/ident :answer.type/math} :answer/value "0.1084" :db/id #edb/ref 17592186263071} {:answer/id #uuid "70225033-f73c-588d-a9dd-7d250c47d05c" :answer/type {:db/ident :answer.type/math} :answer/value "0.1275" :db/id #edb/ref 17592186263969} {:answer/id #uuid "7c05e6c3-b2c4-580c-a7c8-91f0cf3eca15" :answer/type {:db/ident :answer.type/math} :answer/value "0.9584" :db/id #edb/ref 17592186264071} {:answer/id #uuid "a10e63de-a04f-56eb-bb64-ebfeb3d71349" :answer/type {:db/ident :answer.type/math} :answer/value "0.2584" :db/id #edb/ref 17592186264370} {:answer/id #uuid "b6fc6cb5-8cb6-5fa6-8dd4-7bd4fef22ded" :answer/type {:db/ident :answer.type/math} :answer/value "0.2775" :db/id #edb/ref 17592186264585}] :answer-field/correct {:db/id #edb/ref 17592186264585} :answer-field/id #uuid "8ff06068-2dd1-5e69-ae32-656cb2276ffe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265503}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "28c8d216-a346-5e8a-b9da-a29b8df87b52" :question/math-academy-id "q-130196" :question/problem "Given $X∼\\text{Geom}(0.15),$ compute $P(X<3).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.15),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.85)}^{x-1}(0.15), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(0.85)}^{0}(0.15)+{(0.85)}^{1}(0.15) \\\\  & =0.2775.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10003c18-ee89-5e47-9287-28cd8699fd93" :answer/type {:db/ident :answer.type/math} :answer/value "0.0256" :db/id #edb/ref 17592186263148} {:answer/id #uuid "1ed8419d-aff9-58ff-a2ff-cb0f1a80b25a" :answer/type {:db/ident :answer.type/math} :answer/value "0.0102" :db/id #edb/ref 17592186263283} {:answer/id #uuid "a6d72351-762f-507d-89e9-a81fbe31b5e9" :answer/type {:db/ident :answer.type/math} :answer/value "0.9744" :db/id #edb/ref 17592186264428} {:answer/id #uuid "b3fbc289-93a4-52d1-ad45-1732fb8fb3cd" :answer/type {:db/ident :answer.type/math} :answer/value "0.3898" :db/id #edb/ref 17592186264546} {:answer/id #uuid "c6750a8b-1e3d-51c1-9e20-c81f216a0d38" :answer/type {:db/ident :answer.type/math} :answer/value "0.9898" :db/id #edb/ref 17592186264738}] :answer-field/correct {:db/id #edb/ref 17592186263148} :answer-field/id #uuid "100631c3-8c6a-5bdf-880a-6dc979d7e2a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265273}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "48e417b8-5121-57e7-8423-7df9a5c6b9ce" :question/math-academy-id "q-130233" :question/problem "Given $X∼\\text{Geom}\\left(\\frac{3}{5}\\right),$ compute $P(X\\ge 5).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}\\left(\\frac{3}{5}\\right),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{\\left(\\frac{2}{5}\\right)}^{x-1}\\left(\\frac{3}{5}\\right), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 5.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 5) & =1-P(X<5)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={\\left(\\frac{2}{5}\\right)}^{0}\\left(\\frac{3}{5}\\right)+{\\left(\\frac{2}{5}\\right)}^{1}\\left(\\frac{3}{5}\\right)+{\\left(\\frac{2}{5}\\right)}^{2}\\left(\\frac{3}{5}\\right)+{\\left(\\frac{2}{5}\\right)}^{3}\\left(\\frac{3}{5}\\right) \\\\  & =0.9744.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 5) & =1-P(X<5) \\\\  & =1-0.9744 \\\\  & =0.0256.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83c0ac7c-478b-5d46-ba6c-ed0eb4af934b" :answer/type {:db/ident :answer.type/math} :answer/value "0.0014" :db/id #edb/ref 17592186264132} {:answer/id #uuid "84e765ef-c6c9-5160-a8ac-288c0f2e2c2e" :answer/type {:db/ident :answer.type/math} :answer/value "0.9986" :db/id #edb/ref 17592186264141} {:answer/id #uuid "c6671d3c-c604-55f5-8e89-f9987ccaf7e5" :answer/type {:db/ident :answer.type/math} :answer/value "0.9959" :db/id #edb/ref 17592186264737} {:answer/id #uuid "e9f99923-aa23-5ded-93a1-029a29441b6c" :answer/type {:db/ident :answer.type/math} :answer/value "0.332" :db/id #edb/ref 17592186265037} {:answer/id #uuid "fa7aa329-6c14-5e61-8ffa-14c4cdf604b5" :answer/type {:db/ident :answer.type/math} :answer/value "0.0041" :db/id #edb/ref 17592186265194}] :answer-field/correct {:db/id #edb/ref 17592186265194} :answer-field/id #uuid "05963ba4-7264-5bd8-8e34-c0b81836b3f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265255}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c187994c-c002-555b-aa54-6ed7098c1e28" :question/math-academy-id "q-130236" :question/problem "Given $X∼\\text{Geom}\\left(\\frac{2}{3}\\right),$ compute $P(X\\ge 6)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}\\left(\\frac{2}{3}\\right),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{\\left(\\frac{1}{3}\\right)}^{x-1}\\left(\\frac{2}{3}\\right), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 6.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 6) & =1-P(X<6)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<6) & =P(X\\in \\{1,2,3,4,5\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4)+P(X=5) \\\\  & =f(1)+f(2)+f(3)+f(4)+f(5) \\\\  & ={\\left(\\frac{1}{3}\\right)}^{0}\\left(\\frac{2}{3}\\right)+{\\left(\\frac{1}{3}\\right)}^{1}\\left(\\frac{2}{3}\\right)+{\\left(\\frac{1}{3}\\right)}^{2}\\left(\\frac{2}{3}\\right)+{\\left(\\frac{1}{3}\\right)}^{3}\\left(\\frac{2}{3}\\right)+{\\left(\\frac{1}{3}\\right)}^{4}\\left(\\frac{2}{3}\\right) \\\\  & ≈0.9959.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 6) & =1-P(X<6) \\\\  & ≈1-0.9959 \\\\  & =0.0041.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53a22dd3-a12d-5858-8abe-50ea411d89b9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463964} {:answer/id #uuid "36046449-1599-5cbe-a388-6f9f7a5cb79c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463965}] :answer-field/correct {:db/id #edb/ref 17592186463964} :answer-field/id #uuid "d07414d7-38bb-5a41-a70a-cab1a7c6266e" :answer-field/key "$[-\\frac{\\pi }{3},\\frac{\\pi }{3}]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464916} {:answer-field/choices [{:answer/id #uuid "6ef93042-d8eb-5786-ae85-d1a2674d5ca7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463966} {:answer/id #uuid "7809c3f4-194e-508e-aa57-63f005ea71e3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463967}] :answer-field/correct {:db/id #edb/ref 17592186463967} :answer-field/id #uuid "b0621149-4a49-5264-943b-8b19e5114ba8" :answer-field/key "$[\\frac{\\pi }{6},\\frac{\\pi }{3}]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464917} {:answer-field/choices [{:answer/id #uuid "cead2490-5a8f-5617-b718-96a31861ea17" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463968} {:answer/id #uuid "44cc7066-d7c7-5444-8303-dac86b7c407b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463969}] :answer-field/correct {:db/id #edb/ref 17592186463968} :answer-field/id #uuid "372a4dc1-c392-5350-a730-58b07fa01c7e" :answer-field/key "$[\\frac{\\pi }{3},\\frac{2\\pi }{3}]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464918}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d91387a3-da34-5d28-af8d-36338cffabf0" :question/math-academy-id "q-131066" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}2, & x<0 \\\\ \\operatorname{tan}⁡x, & x\\ge 0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-\\frac{\\pi }{3},\\frac{\\pi }{3}].$ We have\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to 0}2=2, \\\\ \\lim_{x\\to {0}^{+}}f(x) & =\\lim_{x\\to 0}\\operatorname{tan}⁡x=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-\\frac{\\pi }{3},\\frac{\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\n- Consider $[\\frac{\\pi }{6},\\frac{\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function $f(x)$ is continuous on the interval $[\\frac{\\pi }{6},\\frac{\\pi }{3}],$ and the extreme value theorem is applicable on this interval.\n\n- Consider $[\\frac{\\pi }{3},\\frac{2\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function is not defined at $x=\\frac{\\pi }{2}.$ Therefore, $f(x)$ is not continuous on the interval $[\\frac{\\pi }{3},\\frac{2\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is $[\\frac{\\pi }{6},\\frac{\\pi }{3}]$ only."}] [{:db/id #edb/ref 17592186266108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d071ed6-2702-5a8c-a1bb-c6115d93069c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186263265} {:answer/id #uuid "22018c6a-c000-55d9-ad50-bbf2d8dc310a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{25}" :db/id #edb/ref 17592186263300} {:answer/id #uuid "2aa73e37-f65f-5473-8506-1046bb0408e8" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186263365} {:answer/id #uuid "534b38df-3041-5cc5-bf51-997cf44692b8" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186263717} {:answer/id #uuid "5cbef439-267b-552e-bccf-b3b24da20aea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186263802}] :answer-field/correct {:db/id #edb/ref 17592186263365} :answer-field/id #uuid "c1c8fd0b-22e6-58f9-911b-2b7e540386c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265585}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "78d3c6b5-0dc7-5dd1-a65f-4624387da0ab" :question/math-academy-id "q-131654" :question/problem "Find \n$$\n\\displaystyle \\begin{vmatrix}r & 1 & 0 \\\\ 5 & 3t & 0 \\\\ 0 & 0 & -25\\end{vmatrix}\n$$\ngiven that \n$$\n\\displaystyle \\begin{vmatrix}r & 1 \\\\ 5 & 3t\\end{vmatrix}=\\frac{3}{5}.\n$$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}r & 1 & 0 \\\\ 5 & 3t & 0 \\\\ 0 & 0 & -25\\end{vmatrix} & =|\\begin{array}{cc|c}r & 1 & 0 \\\\ 5 & 3t & 0 \\\\ \\hline 0 & 0 & -25\\end{array}| \\\\  & =\\begin{vmatrix}r & 1 \\\\ 5 & 3t\\end{vmatrix}\\cdot (-25) \\\\  & =\\frac{3}{5}\\cdot (-25) \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62b803d7-a384-5ae1-abf3-11a9999dc13b" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186263852} {:answer/id #uuid "698da396-7f02-58f4-a1a3-ec217a1dffd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186263906} {:answer/id #uuid "920ae89c-0ba8-5baa-92ac-2fc082d1e962" :answer/type {:db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186264251} {:answer/id #uuid "ba2b38b1-b5a2-5ab3-843e-999d444de5f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{7}" :db/id #edb/ref 17592186264613} {:answer/id #uuid "d058e104-fc83-5a89-b0d3-3dd17a691395" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264824}] :answer-field/correct {:db/id #edb/ref 17592186264824} :answer-field/id #uuid "70f30f2e-2647-56fd-9734-06d501f09310" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265438}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7bdfaa5e-09b0-53c0-aa6b-c7cff92a4a13" :question/math-academy-id "q-131675" :question/problem "Find $$\n\\displaystyle \\,\\begin{vmatrix}v & 5{w}^{2} & 0 & 0 \\\\ 3v & 2 & 0 & 0 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & -8 & 5\\end{vmatrix}\n$$ given that $$\n\\displaystyle \\,\\begin{vmatrix}v & 5{w}^{2} \\\\ 3v & 2\\end{vmatrix}=\\frac{1}{7}.\n$$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}v & 5{w}^{2} & 0 & 0 \\\\ 3v & 2 & 0 & 0 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & -8 & 5\\end{vmatrix} & =|\\begin{array}{cc|cc}v & 5{w}^{2} & 0 & 0 \\\\ 3v & 2 & 0 & 0 \\\\ \\hline 0 & 0 & 3 & -1 \\\\ 0 & 0 & -8 & 5\\end{array}| \\\\  & =\\begin{vmatrix}v & 5{w}^{2} \\\\ 3v & 2\\end{vmatrix}\\cdot \\begin{vmatrix}3 & -1 \\\\ -8 & 5\\end{vmatrix} \\\\  & =\\frac{1}{7}\\cdot 7 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186271990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aee602c-4d2a-536f-b5a1-43a412811ff2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464072} {:answer/id #uuid "13c7384c-1cfa-57cc-8a50-9bf3eab8a9e2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464073}] :answer-field/correct {:db/id #edb/ref 17592186464072} :answer-field/id #uuid "7c3b7373-e5a8-5e2b-8acc-0be10c9b59f2" :answer-field/key "$-3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464970} {:answer-field/choices [{:answer/id #uuid "550ef764-b469-5976-ae9d-0020002e1ead" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464074} {:answer/id #uuid "d1697d54-6fd0-5d05-b11b-25f7ce8acc26" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464075}] :answer-field/correct {:db/id #edb/ref 17592186464075} :answer-field/id #uuid "1f5b3e10-e84c-56fd-8992-d584ea10b2ad" :answer-field/key "$3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464971} {:answer-field/choices [{:answer/id #uuid "fab9ce83-630e-5c19-ae07-249274247140" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464076} {:answer/id #uuid "7bc5ed4c-a4d9-52b6-ad58-1348db969598" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464077}] :answer-field/correct {:db/id #edb/ref 17592186464076} :answer-field/id #uuid "5b13ee4f-81c8-5307-88d8-1a4665b341de" :answer-field/key "$|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=3|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464972}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "09aa5cfb-0ccb-582a-bfa8-b6151a1b73a2" :question/math-academy-id "q-139979" :question/problem "Let $⟨x,3⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}kx+3y &=1 \\\\ 7x-2y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}k & 3 \\\\ 7 & -2\\end{vmatrix}.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =\\begin{vmatrix}k & 1 \\\\ 7 & 8\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ 3 & =\\frac{\\begin{vmatrix}k & 1 \\\\ 7 & 8\\end{vmatrix}}{\\begin{vmatrix}k & 3 \\\\ 7 & -2\\end{vmatrix}} \\\\ 3\\begin{vmatrix}k & 3 \\\\ 7 & -2\\end{vmatrix} & =\\begin{vmatrix}k & 1 \\\\ 7 & 8\\end{vmatrix}\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle 3\\begin{vmatrix}k & 3 \\\\ 7 & -2\\end{vmatrix}=\\begin{vmatrix}k & 1 \\\\ 7 & 8\\end{vmatrix}\n$$ only."}] [{:db/id #edb/ref 17592186271991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8504eb0f-93c6-5d20-8195-88dbad00b315" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464078} {:answer/id #uuid "c70ffc2d-dbef-5e28-8e5a-6e4a97b209b2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464079}] :answer-field/correct {:db/id #edb/ref 17592186464078} :answer-field/id #uuid "83c98712-e70e-5484-9096-216f3da1b3f6" :answer-field/key "$|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=2|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464973} {:answer-field/choices [{:answer/id #uuid "855711cd-7b19-555c-ab6e-e3cbe95bee72" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464080} {:answer/id #uuid "8f8516b4-64ce-53f5-938e-8dfecd51f520" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464081}] :answer-field/correct {:db/id #edb/ref 17592186464080} :answer-field/id #uuid "acfad26a-36f9-5d0e-a1e7-36cd998ca21e" :answer-field/key "$|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=-4|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464974} {:answer-field/choices [{:answer/id #uuid "988ccea1-2f9c-50fe-b323-1720447bfb02" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464082} {:answer/id #uuid "725b0b06-d3c5-567b-9157-156746df62ed" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464083}] :answer-field/correct {:db/id #edb/ref 17592186464083} :answer-field/id #uuid "535c6a07-6be3-5ec1-a653-291a4880438d" :answer-field/key "$-2|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464975}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ddc658b6-e0a7-590f-af72-c80671fc917f" :question/math-academy-id "q-139980" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}15x+8y &=-1 \\\\ kx+13y &=-31.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}15 & 8 \\\\ k & 13\\end{vmatrix}.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =\\begin{vmatrix}15 & -1 \\\\ k & -31\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{\\begin{vmatrix}15 & -1 \\\\ k & -31\\end{vmatrix}}{\\begin{vmatrix}15 & 8 \\\\ k & 13\\end{vmatrix}} \\\\ -2\\begin{vmatrix}15 & 8 \\\\ k & 13\\end{vmatrix} & =\\begin{vmatrix}15 & -1 \\\\ k & -31\\end{vmatrix}\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle -2\\begin{vmatrix}15 & 8 \\\\ k & 13\\end{vmatrix}=\\begin{vmatrix}15 & -1 \\\\ k & -31\\end{vmatrix}\n$$ only."}] [{:db/id #edb/ref 17592186272021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afa82d44-d03d-5e9b-af04-272ab90230e5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464096} {:answer/id #uuid "71f897c8-dfce-5b45-8f4c-bb7062ae467e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464097}] :answer-field/correct {:db/id #edb/ref 17592186464096} :answer-field/id #uuid "6ed222a1-7190-5964-99bc-a9de5fd0be28" :answer-field/key "$\\text{Ker}(T)\\ne \\{0\\}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464982} {:answer-field/choices [{:answer/id #uuid "5a1a3dca-d308-5f38-927f-67b0c977e32e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464098} {:answer/id #uuid "d292b59f-adc1-58d1-98bc-5da647707c1a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464099}] :answer-field/correct {:db/id #edb/ref 17592186464099} :answer-field/id #uuid "cafebd75-e7fa-54e1-9bcf-2578d3061be4" :answer-field/key "$T$ is invertible" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464983} {:answer-field/choices [{:answer/id #uuid "dbb177f8-879b-5898-9551-53329abe91c3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464100} {:answer/id #uuid "7332d203-8792-51a5-976c-10e58a391aaf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464101}] :answer-field/correct {:db/id #edb/ref 17592186464101} :answer-field/id #uuid "b8de8dc2-3957-5b43-9b1f-bfdfb462141b" :answer-field/key "$\\text{nullity}(T)=0$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464984}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1cac76f2-abeb-58d4-87e9-5f3619bedd4c" :question/math-academy-id "q-140085" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $\\text{rank}(T)=5,$ then $\\underline{\\phantom{xxxxxx}}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)\\ne \\{0\\}$ is false. Since $\\text{rank}(T)=5,$ the invertible matrix theorem implies that $\\text{Ker}(T)=\\{0\\}.$\n\n- Statement “$T$ is invertible” is true. Indeed, since $\\text{rank}(T)=5,$ the invertible matrix theorem implies that $T$ is invertible.\n\n- Statement $\\text{nullity}(T)=0$ is true. Indeed, since $T$ is invertible, the invertible matrix theorem implies that $\\text{nullity}(T)=0.$\n\nTherefore, the correct answer is “$T$ is invertible”; $\\text{nullity}(T)=0$ only."}] [{:db/id #edb/ref 17592186272284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079f5dae-bfcf-5b50-ba4b-ae83bc6f55b1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{Im}(T)$ and $\\text{Ker}(T)$" :db/id #edb/ref 17592186269339} {:answer/id #uuid "9d1d9335-bfdb-5b54-9538-0501d53fbad2" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{Null}(T)$ and $\\text{Ker}(T)$" :db/id #edb/ref 17592186270657} {:answer/id #uuid "abe72a0c-363a-5a3a-8cac-526a5e9222e1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{Ker}(T)$ and $\\text{Domain}(T)$" :db/id #edb/ref 17592186270803} {:answer/id #uuid "b6ee4548-b055-5785-a92c-1b09684993d8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{Domain}(T)$ and $\\text{Range}(T)$" :db/id #edb/ref 17592186270889} {:answer/id #uuid "c93ea908-b041-5ad1-8668-bc8878031acb" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{Im}(T)$ and $\\text{det}(T)$" :db/id #edb/ref 17592186271036}] :answer-field/correct {:db/id #edb/ref 17592186269339} :answer-field/id #uuid "222b73f0-3a82-5bff-b427-7650cd47a873" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271572}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "55000931-5b53-577e-bfdc-cc3083a1d40b" :question/math-academy-id "q-141454" :question/problem "$T$ is a bijection $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{WW}}={R}^{n} \\\\  & \\text{rank}(T)=n \\\\  & \\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{WW}}=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$ \n$\\,⟺\\,$  $T$ is invertible\n\nConsider the equivalence above, where $T:{R}^{n}\\to {R}^{n}$ is a linear transformation whose standard matrix is $T.$ **From top to bottom**, which of the following should be placed into the blank spaces to make the statements true?" :question/worked-solution "Recall that the *invertible matrix theorem* (in terms of linear transformations) states the following: \n\n $T$ is a bijection $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{n} \\\\  & \\text{rank}(T)=n \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$ \n$\\,⟺\\,$  $T$ is invertible\n\nTherefore, from top to bottom the missing expression are $\\text{Im}(T)$ and $\\text{Ker}(T).$"}] [{:db/id #edb/ref 17592186272285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af878bc-a2d4-5d29-9f1c-9e4a3cf3f993" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{Domain}(T)$ and $n-2$" :db/id #edb/ref 17592186269487} {:answer/id #uuid "b89bcde2-5886-5353-b2fb-ee39f615fc0c" :answer/type {:db/ident :answer.type/text} :answer/value "${R}^{n}$ and $\\text{det}(T)$" :db/id #edb/ref 17592186270900} {:answer/id #uuid "baa5abde-92f5-5f9a-af2b-a0a103048cab" :answer/type {:db/ident :answer.type/text} :answer/value "$0$ and $n$" :db/id #edb/ref 17592186270915} {:answer/id #uuid "e3cd4fc3-738a-5af8-a034-a398ae8afd2e" :answer/type {:db/ident :answer.type/text} :answer/value "${R}^{n}$ and $n$" :db/id #edb/ref 17592186271274} {:answer/id #uuid "966c47fb-4bd7-5ecd-b699-314eb32ff7c4" :answer/type {:db/ident :answer.type/text} :answer/value "$R∖\\{0\\}$ and $1$" :db/id #edb/ref 17592186458890}] :answer-field/correct {:db/id #edb/ref 17592186271274} :answer-field/id #uuid "2be4f7f0-fda8-5056-81c8-7f9c5bad1fba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271589}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0c34404-67b0-5bd2-86a3-b5bd22c70fb5" :question/math-academy-id "q-141457" :question/problem "$T$ is a bijection $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)=\\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{W}} \\\\  & \\text{rank}(T)=\\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{W}} \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$ \n$\\,⟺\\,$  $T$ is invertible\n\nConsider the equivalence above, where $T:{R}^{n}\\to {R}^{n}$ is a linear transformation whose standard matrix is $T.$ **From top to bottom**, which of the following should be placed into the blank spaces to make the statements true?" :question/worked-solution "Recall that the *invertible matrix theorem* (in terms of linear transformations) states the following: \n\n $T$ is a bijection $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{n} \\\\  & \\text{rank}(T)=n \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$ \n$\\,⟺\\,$  $T$ is invertible\n\nTherefore, from top to bottom, the missing expressions are ${R}^{n}$ and $n.$"}] [{:db/id #edb/ref 17592186272291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8230d7a2-4524-54a5-9590-04c588c295e3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464210} {:answer/id #uuid "14884516-4125-50da-8b5d-7e51e9e24ab8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464211}] :answer-field/correct {:db/id #edb/ref 17592186464211} :answer-field/id #uuid "3f5eda39-3b08-5189-b208-4e35abe1db47" :answer-field/key "$\\text{Ker}(T)\\ne \\{0\\}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465039} {:answer-field/choices [{:answer/id #uuid "44af8797-c814-5748-994f-92b788de154a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464212} {:answer/id #uuid "78baedc7-0e87-5ff1-9a52-276bee40b842" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464213}] :answer-field/correct {:db/id #edb/ref 17592186464212} :answer-field/id #uuid "d424f77d-314f-5358-8eee-a8487ea9871f" :answer-field/key "$\\text{Im}(T)={R}^{3}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465040} {:answer-field/choices [{:answer/id #uuid "26f9634b-041a-572d-8750-407c23f61424" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464214} {:answer/id #uuid "fa4ff653-5f79-56df-815d-652606c37fae" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464215}] :answer-field/correct {:db/id #edb/ref 17592186464214} :answer-field/id #uuid "52b0634f-8af8-5969-84d2-36ca3ab0045a" :answer-field/key "$T$ is invertible" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465041}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "496f9381-a057-5d31-a929-726bf731d70b" :question/math-academy-id "q-141495" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and ${v}_{1},{v}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If $2T({v}_{1})-3T({v}_{2})=0$ and ${v}_{1}\\ne k{v}_{2}$ for all $k\\in R$ then $\\underline{\\phantom{xxxxxx}}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)\\ne \\{0\\}$ is true. Since $2T({v}_{1})-3T({v}_{2})=0$ and $T$ is a linear transformation, we have $T(2{v}_{1}-3{v}_{2})=0$ which means $2{v}_{1}-3{v}_{2}\\in \\text{Ker}(T).$   Since ${v}_{1}\\ne k{v}_{2}$,  we must have $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement $\\text{Im}(T)={R}^{3}$ is false. Since $\\text{Ker}(T)\\ne \\{0\\}$, then according to the invertible matrix theorem, the transformation $T$ is not a bijection. Since $T$ is not a bijection, then by the invertible matrix theorem, $\\text{Im}(T)\\ne {R}^{3}.$\n\n- Statement “$T$ is invertible” is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{3},$ the corresponding matrix $T$ can't be invertible.\n\nTherefore, the correct answer is $\\text{Ker}(T)\\ne \\{0\\}$ only."}] [{:db/id #edb/ref 17592186275459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052459b5-32fe-5a93-b48b-e733fac244d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186272434} {:answer/id #uuid "09f7d73c-c7ee-52c8-9189-640706a28aed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186272477} {:answer/id #uuid "c76bdcab-c03f-5229-8d6c-4ac9d282117c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186274120} {:answer/id #uuid "c778c7da-afc4-5bd5-b2f1-bcc32a8fc807" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186274122} {:answer/id #uuid "f414363f-835b-53bb-9b0c-4cd9b3378183" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186274543}] :answer-field/correct {:db/id #edb/ref 17592186272477} :answer-field/id #uuid "e1f7daa1-80eb-5764-a426-2110070d9e2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275031}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93f58db6-2e5f-58ae-a9a5-9aa2f152a653" :question/math-academy-id "q-158309" :question/problem "Compute $P(X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{24}({x}^{2}+1),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<1,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{24}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{24}{\\int }_{1}^{3}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{1}{24}{[\\frac{{x}^{3}}{3}+x]}_{1}^{3} \\\\  & =\\frac{1}{24}[(\\frac{{3}^{3}}{3}+3)-(\\frac{1}{3}+1)] \\\\  & =\\frac{1}{24}(12-\\frac{4}{3}) \\\\  & =\\frac{1}{24}\\cdot \\frac{32}{3} \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a02ae6e-0506-5c3e-842e-2d36e9955a2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186272611} {:answer/id #uuid "1b27c71e-715d-563a-b143-9a7e7dade11e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186272619} {:answer/id #uuid "352fdf1f-1c35-5952-8b5a-ab2dea63c3f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186272858} {:answer/id #uuid "44ddfa3a-38ea-5840-9c97-21475c3e27e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186272974} {:answer/id #uuid "a09352eb-ece5-548c-9db8-6b063dbf41eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186273778}] :answer-field/correct {:db/id #edb/ref 17592186272974} :answer-field/id #uuid "9a0add09-f8b7-5571-85b6-3994fc452dcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274905}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "93973542-05ae-5f66-9567-d5a70adf747f" :question/math-academy-id "q-158310" :question/problem "Compute $P(X>-3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{72}{x}^{2},\\, & -6\\le x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>0,$ we have\n\n$$\n\\begin{aligned}P(X>-3) & ={\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{0}\\frac{1}{72}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{216}{x}^{3}]}_{-3}^{0} \\\\  & =\\frac{1}{216}[(0)^{3}-(-3)^{3}] \\\\  & =\\frac{27}{216} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23104f3a-32df-5eb8-b625-6064a0927bc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186275790} {:answer/id #uuid "4782f702-6fe4-5d9d-ac7f-0cbf1d5585b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186276109} {:answer/id #uuid "c4d9a75e-ef16-53b2-91a4-a58f25730b94" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277227} {:answer/id #uuid "d69f8bf4-08dd-5e99-b4bd-7e77b6e86109" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186277368} {:answer/id #uuid "fded7981-ac59-53d8-a59e-57b524b6aaff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186277705}] :answer-field/correct {:db/id #edb/ref 17592186275790} :answer-field/id #uuid "b52cd5b8-493f-5839-b0c1-450922ded456" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278044}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c628a4a3-1d03-5b7a-9d8c-d548c59d8196" :question/math-academy-id "q-158442" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}k(x+1),\\, & 2<x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{2}^{3}k(x+1)\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}k(x+1)\\,\\text{d}x & =k{[\\frac{{x}^{2}}{2}+x]}_{2}^{3} \\\\  & =k([\\frac{9}{2}+3]-[\\frac{4}{2}+2]) \\\\  & =k(\\frac{9}{2}-1) \\\\  & =\\frac{7}{2}k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{7}{2}k=1\\,⟹\\,k=\\frac{2}{7}.\n$$"}] [{:db/id #edb/ref 17592186278187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1028c364-ce75-5836-a84c-a7b8c7109998" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186275619} {:answer/id #uuid "37590d2d-228a-54b7-9ea1-ddb7e5c81f4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{24}" :db/id #edb/ref 17592186275969} {:answer/id #uuid "5b184341-4aed-5427-a6ea-c4f9d55ff988" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{16}" :db/id #edb/ref 17592186276293} {:answer/id #uuid "78b9fe3f-4e98-52de-bbf1-6f4e65819078" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186276572} {:answer/id #uuid "e782edc4-7e83-59f7-a604-01cdc3eef141" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186277501}] :answer-field/correct {:db/id #edb/ref 17592186276293} :answer-field/id #uuid "b41386b3-26a4-5507-8fde-5cf49c81cb7d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278040}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2c51ecb-6d65-53cb-ba0b-d70d6940d33b" :question/math-academy-id "q-158443" :question/problem "Compute $P(0<X\\le 5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}({x}^{3}+1),\\, & -1\\le x<1, \\\\ \\frac{1}{24}x & 1\\le x\\le 5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0<X\\le 5) & ={\\int }_{0}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{4}({x}^{3}+1)\\,\\text{d}x+{\\int }_{1}^{5}\\frac{1}{24}x\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{1}{4}{x}^{4}+x]}_{0}^{1}+{[\\frac{1}{48}{x}^{2}]}_{1}^{5} \\\\  & =\\frac{1}{4}([\\frac{1}{4}(1)^{4}+1]-[\\frac{1}{4}(0)^{4}+0])+\\frac{1}{48}[{5}^{2}-{1}^{2}] \\\\  & =\\frac{1}{4}\\left(\\frac{5}{4}\\right)+\\frac{1}{2} \\\\  & =\\frac{5}{16}+\\frac{1}{2} \\\\  & =\\frac{13}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d46a99b-9aed-5723-ae0f-4c64551e3f94" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275588} {:answer/id #uuid "47db744f-f0b3-5760-896a-049544b6375a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186276112} {:answer/id #uuid "7a49c651-4a95-5c0c-b6a3-3b8cdc26b296" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186276587} {:answer/id #uuid "8415d956-a817-53c4-8f60-93416a12acc9" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186276662} {:answer/id #uuid "9f3492e5-9010-5a95-8437-b5d792b01884" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276909}] :answer-field/correct {:db/id #edb/ref 17592186276587} :answer-field/id #uuid "86517bcb-97bd-5ba9-8706-7572bc681126" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277964}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1741b28-dd7a-521f-bff9-3881fb7d5bb4" :question/math-academy-id "q-158447" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}+1}{k},\\, & 1<x<4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x & =\\frac{1}{k}{\\int }_{1}^{4}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{k}{[\\frac{{x}^{3}}{3}+x]}_{1}^{4} \\\\  & =\\frac{1}{k}([\\frac{64}{3}+4]-[\\frac{1}{3}+1]) \\\\  & =\\frac{1}{k}(21+3) \\\\  & =\\frac{24}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{24}{k}=1\\,⟹\\,k=24.\n$$"}] [{:db/id #edb/ref 17592186278307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56481835-518b-5171-88da-86e05963ba2f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186276245} {:answer/id #uuid "6273fab4-4c1d-5d8f-a0e5-081c7a5bdc04" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276368} {:answer/id #uuid "71638daa-0052-5754-b71c-02dc8f380acc" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276498} {:answer/id #uuid "992c7b81-3eb7-55dc-bc8c-3bd914085869" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276852} {:answer/id #uuid "a0222e17-38e9-574c-9fce-ece43f8640e4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186276920}] :answer-field/correct {:db/id #edb/ref 17592186276920} :answer-field/id #uuid "9950b528-93fa-5fe7-a6ea-a3f27b30d432" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277997}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e4ee7fd8-9373-59cf-bc78-d62531a54190" :question/math-academy-id "q-160463" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{k}{(x+3)^{7}},\\, & x\\ge -2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nIn our case, for the function $f(x)=\\frac{k}{(x+3)^{7}}$ on the interval $x\\ge -2,$ the second condition states that\n\n$$\n{\\int }_{-2}^{\\infty }\\frac{k}{(x+3)^{7}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{\\infty }\\frac{k}{(x+3)^{7}}\\,\\text{d}x=-\\frac{k}{6(x+3)^{6}}\\,{|}_{-2}^{\\infty }=\\frac{k}{6}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{6}=1\\,⟹\\,k=6.\n$$"}] [{:db/id #edb/ref 17592186278310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118c3392-8f4b-5a28-b170-f891ea364930" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{e}" :db/id #edb/ref 17592186275633} {:answer/id #uuid "929258e4-1ed5-5b7d-8880-aba10bed2194" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{2}}" :db/id #edb/ref 17592186276804} {:answer/id #uuid "e0656531-5f92-50c3-8174-7a4c5b980686" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186277436} {:answer/id #uuid "e255bf4d-f521-5b32-8e26-405c65c4a7ec" :answer/type {:db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186277458} {:answer/id #uuid "f106b996-8990-5fef-94a8-8ae99ae28da6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{3}" :db/id #edb/ref 17592186277593}] :answer-field/correct {:db/id #edb/ref 17592186276804} :answer-field/id #uuid "afb72719-6e3d-599c-8a5a-a7d44b4323e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278031}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "008eb439-04f8-52ac-8507-0ab3780bebdf" :question/math-academy-id "q-160467" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}k{e}^{3x+2},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nIn our case, for the function $f(x)=k{e}^{3x+2}$ on the interval $x\\le 0,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{0}k{e}^{3x+2}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}k{e}^{3x+2}\\,\\text{d}x=\\frac{k}{3}{e}^{3x+2}\\,{|}_{-\\infty }^{0}=\\frac{k{e}^{2}}{3}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k{e}^{2}}{3}=1\\,⟹\\,k=\\frac{3}{{e}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186297242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9d9c4e-2687-5a00-b777-4684cc0de27f" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186295338} {:answer/id #uuid "3ffdef35-a30a-5f30-99b8-4a995eac8ffb" :answer/type {:db/ident :answer.type/math} :answer/value "-500" :db/id #edb/ref 17592186295632} {:answer/id #uuid "a6bb394a-fe2f-5d30-b8bc-9546189fbccc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296144} {:answer/id #uuid "c0eee9c9-1fa3-56af-a61c-95a972738e2a" :answer/type {:db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186296285} {:answer/id #uuid "e36988ba-6cfe-5f34-b0a1-f31a0c88f51b" :answer/type {:db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186296479}] :answer-field/correct {:db/id #edb/ref 17592186296285} :answer-field/id #uuid "e17078ea-5afe-5ed2-9a45-a07ca7d4a2b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297099}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7ee241ee-6c9b-581f-8e3e-00ecaf1e5967" :question/math-academy-id "q-29734" :question/problem "The function $f(x)$ is defined below. What is the value of \n$$\n\\displaystyle {\\int }_{0}^{10}f(x)\\,\\text{d}x\\,?\n$$\n\n$$\nf(x)=\\{\\begin{aligned}x-9, & x<5 \\\\ \\frac{x}{5}-5, & x\\ge 5\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{10}f(x)\\,\\text{d}x & ={\\int }_{0}^{5}(x-9)\\,\\text{d}x+{\\int }_{5}^{10}(\\frac{x}{5}-5)\\,\\text{d}x \\\\  & ={(\\frac{{x}^{2}}{2}-9x)|}_{0}^{5}+{(\\frac{{x}^{2}}{10}-5x)|}_{5}^{10} \\\\  & =[\\frac{(5)^{2}}{2}-9(5)-\\frac{(0)^{2}}{2}+9(0)]+[\\frac{(10)^{2}}{10}-5(10)-\\frac{(5)^{2}}{10}+5(5)] \\\\  & =[\\frac{25}{2}-45]+[10-50-\\frac{25}{10}+25] \\\\  & =-50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021675ce-f69e-5717-beee-62f1b55fe9a1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295272} {:answer/id #uuid "3e46952e-9cec-5cb5-af26-701cae6d5879" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186295626} {:answer/id #uuid "6dcb4361-9b61-51c7-9aaf-35ffbda245cc" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186295875} {:answer/id #uuid "e3676b27-8ef7-5622-91a9-2bca7ef2dc81" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296478} {:answer/id #uuid "fd2022c7-8746-55e0-8d32-73482f73ca68" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186296614}] :answer-field/correct {:db/id #edb/ref 17592186296478} :answer-field/id #uuid "66c909a9-c1e8-56c3-a557-6fc2fdb9e1a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296847}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "598039da-8879-5b3c-ab71-e359f8b00731" :question/math-academy-id "q-29742" :question/problem "The function $f(x)$ is defined below. What is the value of \n$$\n\\displaystyle {\\int }_{0}^{6}f(x)\\,\\text{d}x\\,?\n$$\n\n$$\nf(x)=\\{\\begin{aligned}3x-9, & x<3 \\\\ \\frac{x}{3}-1, & x\\ge 3\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}(3x-9)\\,\\text{d}x+{\\int }_{3}^{6}(\\frac{x}{3}-1)\\,\\text{d}x \\\\  & ={(\\frac{3{x}^{2}}{2}-9x)|}_{0}^{3}+{(\\frac{{x}^{2}}{6}-x)|}_{3}^{6} \\\\  & =[\\frac{3(3)^{2}}{2}-9(3)-\\frac{3(0)^{2}}{2}+9(0)]+[\\frac{(6)^{2}}{6}-6-\\frac{(3)^{2}}{6}+3] \\\\  & =[\\frac{27}{2}-27]+[6-6-\\frac{3}{2}+3] \\\\  & =-\\frac{27}{2}+\\frac{3}{2} \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3422b384-f2f9-572e-8eb4-d8bd9d567439" :answer/type {:db/ident :answer.type/math} :answer/value "3|x{|}^{2}+2|x|" :db/id #edb/ref 17592186312396} {:answer/id #uuid "399ebb03-9a48-5ae4-ad4b-e2f9708d9ade" :answer/type {:db/ident :answer.type/math} :answer/value "-3{x}^{2}+2x" :db/id #edb/ref 17592186312443} {:answer/id #uuid "7b4b355d-f37a-5b71-acc6-9fcb7764f37b" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}-2x" :db/id #edb/ref 17592186312959} {:answer/id #uuid "7bbb155a-24f1-5fdf-9331-fc35b1aa9681" :answer/type {:db/ident :answer.type/math} :answer/value "|-3{x}^{2}+2x|" :db/id #edb/ref 17592186312966} {:answer/id #uuid "d8724818-0c32-5508-ba36-fc4ff13554d2" :answer/type {:db/ident :answer.type/math} :answer/value "-3{x}^{2}-2x" :db/id #edb/ref 17592186313679}] :answer-field/correct {:db/id #edb/ref 17592186313679} :answer-field/id #uuid "398ee33f-318a-5b30-b174-de823e5df8f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314170}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9a5c0f3-170f-537d-a310-26965c54349f" :question/math-academy-id "q-340866" :question/problem "Let $F(x)=3{x}^{2}-2x$ for $x\\in [0,5),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-5,5).$ What is $f(x)$ for $x\\in (-5,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,5),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,5), \\\\ -F(-x), & x\\in (-5,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-5,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(3(-x)^{2}-2(-x)) \\\\  & =-(3{x}^{2}+2x) \\\\  & =-3{x}^{2}-2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3e4fe3-02d7-5d29-8ad7-3668f238c80b" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{3}+3x" :db/id #edb/ref 17592186312201} {:answer/id #uuid "5e546d57-7d43-5fdd-9926-cb08a53da797" :answer/type {:db/ident :answer.type/math} :answer/value "|2{x}^{3}-3x|" :db/id #edb/ref 17592186312729} {:answer/id #uuid "72646c31-66f9-59e9-b13a-7b244f98ace6" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{3}-3x" :db/id #edb/ref 17592186312874} {:answer/id #uuid "82066e55-50d4-57e0-ac8c-f0b4180a166e" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{3}-3x" :db/id #edb/ref 17592186313022} {:answer/id #uuid "8b7964f5-e30a-59a4-bfc5-74cffaad8946" :answer/type {:db/ident :answer.type/math} :answer/value "-2|x{|}^{3}-3|x|" :db/id #edb/ref 17592186313088}] :answer-field/correct {:db/id #edb/ref 17592186312201} :answer-field/id #uuid "cf43efd4-4be2-5e7b-a5ea-b1f07093d073" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e12be66-5682-57ef-8004-80dc62d4ed67" :question/math-academy-id "q-340871" :question/problem "Let $F(x)=-2{x}^{3}+3x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-2(-x)^{3}+3(-x)) \\\\  & =-(2{x}^{3}-3x) \\\\  & =-2{x}^{3}+3x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55fed7ab-a91c-50d6-aa4f-e191cbf584c9" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186312667}] :answer-field/correct {:db/id #edb/ref 17592186312667} :answer-field/id #uuid "c2bbefba-2fd6-5ec2-b297-2bf9ad8d5f88" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314558}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c9a83be1-0157-5d64-aa36-c77e159ee194" :question/math-academy-id "q-341210" :question/problem "Let $F(x)=-{x}^{2}+5x$ for $x\\in [0,8),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-8,8).$ What is the value of $f(-3)?$\n\n$f(-3)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,8),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,8), \\\\ -F(-x), & x\\in (-8,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-8,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-(-x)^{2}+5(-x)) \\\\  & =-(-{x}^{2}-5x) \\\\  & ={x}^{2}+5x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-3) & =(-3)^{2}+5(-3)=-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af28b770-ae88-5a31-80df-f0b664e52aa0" :answer/type {:db/ident :answer.type/math} :answer/value "|x{|}^{3}+|x|" :db/id #edb/ref 17592186313341} {:answer/id #uuid "ba559227-5f6d-5a3f-a5b7-d8f6c9ff4b22" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}-x" :db/id #edb/ref 17592186313427} {:answer/id #uuid "d298aadc-ec0a-59b6-a1c4-a181506abe7a" :answer/type {:db/ident :answer.type/math} :answer/value "|-{x}^{3}+x|" :db/id #edb/ref 17592186313625} {:answer/id #uuid "ee5212cb-169d-5ee0-8c4b-ef27a6dc9f86" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}-x" :db/id #edb/ref 17592186313877} {:answer/id #uuid "f46f04ee-46bb-52c3-83db-8477ccd31b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}+x" :db/id #edb/ref 17592186313930}] :answer-field/correct {:db/id #edb/ref 17592186313930} :answer-field/id #uuid "1a18eef6-ce6b-5df3-bf8d-2434bbf8e335" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314077}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da2cbfde-d64b-5d60-ab62-7e1044f8ad53" :question/math-academy-id "q-341240" :question/problem "Let $F(x)={x}^{3}-x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn this case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}-(-x) \\\\  & =-{x}^{3}+x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce3ead7-0b83-5eab-9199-842cc025d4a4" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186315380} {:answer/id #uuid "3aca0239-27a6-5c5c-96b6-cc49183e0e6e" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186315456}] :answer-field/correct {:db/id #edb/ref 17592186315456} :answer-field/id #uuid "23e8c250-6052-5c7e-8aa2-842606a473e0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316630} {:answer-field/choices [{:answer/id #uuid "c9b64430-e1a7-5018-92b8-5a440a98a30f" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186316254} {:answer/id #uuid "e273b80a-755a-5202-a33c-bd0bc03650fe" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186316372}] :answer-field/correct {:db/id #edb/ref 17592186316254} :answer-field/id #uuid "77492101-d1f7-5814-a922-e3f5920b6f11" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316832} {:answer-field/choices [{:answer/id #uuid "0a302410-85bc-585f-8c2d-33efa2dd93cc" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186315169} {:answer/id #uuid "54e399fb-cac3-5ef5-8d8c-7f48f901bbcb" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186315605}] :answer-field/correct {:db/id #edb/ref 17592186315605} :answer-field/id #uuid "90e114c9-5c98-54b3-9ea6-3e2d144fa479" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316880} {:answer-field/choices [{:answer/id #uuid "99fd6e29-10e2-567b-83cb-3f7adddc1fa2" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186315979} {:answer/id #uuid "e7e38600-19e2-5b19-ab04-bf50f924692c" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186316401}] :answer-field/correct {:db/id #edb/ref 17592186315979} :answer-field/id #uuid "bfd358e2-ceac-5b84-a7b4-d64ad89516db" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316997}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a3280171-70dd-50e2-8570-67e489365512" :question/math-academy-id "q-342406" :question/problem "$$\nF(x)=\\{\\begin{aligned}x+1, & x\\in [-2,0) \\\\ -2, & x\\in [0,2)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-2,2).$ Let $f(x)$ be the $4$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-2,2)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-2,2)$ | {{field-2}} |\n| III. | $\\lim_{x\\to -{2}^{+}}F(x)=\\lim_{x\\to {2}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{false}.$ The function $F(x)$ has a jump discontinuity at $x=0.$ Its graph is shown below.\n\n![](images/7c/7cfd6da222fb36d06be1153ac0e398e567f8b9fb8cd1cd9e21f1bb35ed131f8d.png)\n\n- Statement II is $\\text{true}.$ The function $F(x)$ is piecewise smooth on $x\\in (-2,2).$ It consists of two smooth pieces.\n\n- Statement III is $\\text{false}.$ Indeed, we have\n\n$$\n\\lim_{x\\to -{2}^{+}}F(x)=\\lim_{x\\to -{2}^{+}}(x+1)=-2+1=-1\n$$\n\nand \n\n$$\n\\lim_{x\\to {2}^{-}}F(x)=\\lim_{x\\to {2}^{-}}(-2)=-2.\n$$\n\nSo, $\\lim_{x\\to -{2}^{+}}F(x)\\ne {lim}_{x\\to {2}^{-}}F(x).$\n\n- Statement IV is $\\text{false}$ since statements I and III are false.\n\n**Note:** The $4$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/a5/a59fad69c9790a2b899c21fd730f779c28bc9b70f44a67851ad5ca92bff21951.png)"}] [{:db/id #edb/ref 17592186317343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4412b0a-c71f-5cca-bfd7-0e7a394cd882" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186316137} {:answer/id #uuid "d4107e3e-ce7b-572c-a7b0-63308ed4b323" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186316307}] :answer-field/correct {:db/id #edb/ref 17592186316307} :answer-field/id #uuid "384932b1-045f-5e97-adf9-8c7d788221a0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316679} {:answer-field/choices [{:answer/id #uuid "3bdd7d9d-de70-5aed-afa2-c306cd50b6f9" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186315462} {:answer/id #uuid "a3599bbd-841c-52c8-ba53-48371a212d90" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186316039}] :answer-field/correct {:db/id #edb/ref 17592186315462} :answer-field/id #uuid "766fd31b-a411-57ed-afac-05d8e91addc4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316829} {:answer-field/choices [{:answer/id #uuid "46c2a83e-e1b4-587f-8352-258685818859" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186315530} {:answer/id #uuid "f1bb71dc-c7a5-5888-9c5c-a0c6c35f5aa4" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186316463}] :answer-field/correct {:db/id #edb/ref 17592186316463} :answer-field/id #uuid "b496164e-826b-5d5a-bf37-8bb4bcd3b015" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316971} {:answer-field/choices [{:answer/id #uuid "52a95f78-0264-56af-b724-e87bacdc6ae2" :answer/type {:db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186315590} {:answer/id #uuid "90039fb4-359d-54c4-a7d0-6cad1bc614a3" :answer/type {:db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186315923}] :answer-field/correct {:db/id #edb/ref 17592186315923} :answer-field/id #uuid "b8c4e885-4811-5e1e-84d1-0bbc46d06da5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316982}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33a3c9fc-2528-5adc-9b2e-4d84493c2477" :question/math-academy-id "q-342949" :question/problem "$$\nF(x)=\\{\\begin{aligned}2x+1, & x\\in [-3,0] \\\\ \\frac{2}{{x}^{2}}, & x\\in (0,3)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-3,3).$ Let $f(x)$ be the $6$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-3,3)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-3,3)$ | {{field-2}} |\n| III. | $\\lim_{x\\to -{3}^{+}}F(x)=\\lim_{x\\to {3}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{false}.$ The function $F(x)$ is not continuous on $x\\in (-3,3)$ because $\\frac{2}{{x}^{2}}\\to \\infty $ as $x\\to {0}^{+}.$ Its graph is shown below.\n\n![](images/77/7736417b068541a1609efa46e9824cd3f65cd34856c1d2f5d0ec7258ec883b5c.png)\n\n- Statement II is $\\text{false}.$ The function $F(x)$ is not piecewise smooth on $x\\in (-3,3)$ because ${F}^{′}(x)=-\\frac{4}{{x}^{3}}\\to -\\infty $ as $x\\to {0}^{+}.$\n\n- Statement III is $\\text{false}.$ Indeed, we have\n\n$$\n\\lim_{x\\to -{3}^{+}}F(x)=\\lim_{x\\to -{3}^{+}}(2x+1)=2(-3)+1=-5\n$$\n\nand \n\n$$\n\\lim_{x\\to {3}^{-}}F(x)=\\lim_{x\\to {3}^{-}}\\frac{2}{{x}^{2}}=\\frac{2}{9}.\n$$\n\nSo, $\\lim_{x\\to -{3}^{+}}F(x)\\ne {lim}_{x\\to {3}^{-}}F(x).$\n\n- Statement IV is $\\text{false}$ since statements I and II are false.\n\n**Note:** The $6$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/ac/ac4d89fcccca99bebaeab4b44baac9c5c03651c38cef7e4d14cfe57978d066b7.png)"}] [{:db/id #edb/ref 17592186317392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b796236-ecb8-5476-9123-68c2471bcce1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315549}] :answer-field/correct {:db/id #edb/ref 17592186315549} :answer-field/id #uuid "66aeef22-5905-5dc6-b02a-1f2b21fdc21a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316791}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "883d77a7-ed55-5648-ad28-2c6a5e33fb4b" :question/math-academy-id "q-343359" :question/problem "$$\nF(x)=\\{\\begin{aligned}-1, & x\\in [-\\pi ,0] \\\\ 3, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ converges when $x=\\pi .$\n\nThe Fourier series converges to {{field-1}} when $x=\\pi .$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $2\\pi $-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=\\pi .$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(\\pi ) & =\\lim_{x\\to {\\pi }^{-}}f(x)=3 \\\\ {f}^{+}(\\pi ) & =\\lim_{x\\to {\\pi }^{+}}f(x)=-1\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}(\\pi )+{f}^{+}(\\pi )}{2}=\\frac{3+(-1)}{2}=1.\n$$"}] [{:db/id #edb/ref 17592186317393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0037eb03-213e-5d10-a8b1-2c3b156f0fd9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315114}] :answer-field/correct {:db/id #edb/ref 17592186315114} :answer-field/id #uuid "ab6fb759-4189-56fa-94b4-4e7de6084501" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316948}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "97ff3547-7e44-5c45-a91b-58643d43344d" :question/math-academy-id "q-343364" :question/problem "$$\nF(x)=\\{\\begin{aligned}{e}^{x+2}, & x\\in [-2,0) \\\\ 1, & x\\in [0,2)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ converges when $x=-2.$\n\nThe Fourier series converges to {{field-1}} when $x=-2.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $4$-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=-2.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(-2) & =\\lim_{x\\to -{2}^{-}}f(x)=1 \\\\ {f}^{+}(-2) & =\\lim_{x\\to -{2}^{+}}f(x)={e}^{-2+2}=1\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}(-2)+{f}^{+}(-2)}{2}=\\frac{1+1}{2}=1.\n$$"}] [{:db/id #edb/ref 17592186317394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bff08d19-8cb4-5226-967f-942523bd104b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186316201}] :answer-field/correct {:db/id #edb/ref 17592186316201} :answer-field/id #uuid "bf1a59b6-d6c2-5e99-8bc5-ed1d49da21ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316995}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "086a93d6-9edf-5e6c-82a6-6ae6a865d444" :question/math-academy-id "q-343370" :question/problem "$$\nF(x)=\\{\\begin{aligned}{x}^{2}, & x\\in [-\\pi ,0] \\\\ \\operatorname{sin}⁡x+1, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is converging when $x=\\frac{\\pi }{2}.$\n\nThe Fourier series converges to {{field-1}} when $x=\\frac{\\pi }{2}.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $2\\pi $-periodic extension $f(x)$ of our function $F(x)$ is continuous at $x=\\frac{\\pi }{2}.$ \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\nf\\,\\left(\\frac{\\pi }{2}\\right)=sin\\,\\left(\\frac{\\pi }{2}\\right)+1=2.\n$$"}] [{:db/id #edb/ref 17592186317395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a90ff20b-46bc-563c-8a6d-2698d67747fc" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186316068}] :answer-field/correct {:db/id #edb/ref 17592186316068} :answer-field/id #uuid "49330cc6-9572-5a0d-b1f2-3e73f8b2ef51" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316717}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d4ef002-5026-5196-8b56-541878d83ddc" :question/math-academy-id "q-343372" :question/problem "$$\nF(x)=\\{\\begin{aligned}-2x+1, & x\\in [-4,0] \\\\ {x}^{2}+2, & x\\in (0,4)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is converging when $x=-3.$\n\nThe Fourier series converges to {{field-1}} when $x=-3.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $8$-periodic extension $f(x)$ of our function $F(x)$ is continuous at $x=-3.$ \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\nf(-3)=-2(-3)+1=7.\n$$"}] [{:db/id #edb/ref 17592186317396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e8d60e5-0ad9-55d5-8b7e-e475ef95acb2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316010}] :answer-field/correct {:db/id #edb/ref 17592186316010} :answer-field/id #uuid "8b06dbb1-77e5-5ad6-bd29-3766a587c036" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316865}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85b0a574-008a-56b0-af42-48f4058807a7" :question/math-academy-id "q-343385" :question/problem "$$\nF(x)=\\{\\begin{aligned}{x}^{2}, & x\\in [-\\frac{\\pi }{3},0] \\\\ 2\\operatorname{sin}⁡x, & x\\in (0,\\frac{\\pi }{3})\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $\\frac{2\\pi }{3}$-periodic extension $f(x)$ of $F(x)$ is converging when $x=\\frac{\\pi }{6}.$\n\nThe Fourier series converges to {{field-1}} when $x=\\frac{\\pi }{6}.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{-}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $\\frac{2\\pi }{3}$-periodic extension $f(x)$ of our function $F(x)$ is continuous at $x=\\frac{\\pi }{6}.$ \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\nf\\,\\left(\\frac{\\pi }{6}\\right)=2sin\\,\\left(\\frac{\\pi }{6}\\right)=1.\n$$"}] [{:db/id #edb/ref 17592186317397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a066781a-6e52-5220-93ef-23ff199bd9a5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186316022}] :answer-field/correct {:db/id #edb/ref 17592186316022} :answer-field/id #uuid "c5f46bb7-8b99-5788-8b85-2ae0679bb181" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317019}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cc552628-2cac-58c1-ac79-840e54e9a1ec" :question/math-academy-id "q-343390" :question/problem "$$\nF(x)=\\{\\begin{aligned}{x}^{2}-4, & x\\in [-5,0] \\\\ \\operatorname{sin}⁡x, & x\\in (0,5)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $10$-periodic extension $f(x)$ of $F(x)$ is converging when $x=-3.$\n\nThe Fourier series converges to {{field-1}} when $x=-3.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $10$-periodic extension $f(x)$ of our function $F(x)$ is continuous at $x=-3.$ \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\nf(-3)=(-3)^{2}-4=5.\n$$"}] [{:db/id #edb/ref 17592186317401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ef83eb-7903-5ed1-889b-def0c697eddb" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315133} {:answer/id #uuid "27e8af18-0de0-586a-9eba-abc08ba0860f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315346} {:answer/id #uuid "39b7289a-e50b-58ae-adf6-ed3e51b77d40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315449} {:answer/id #uuid "da376413-1d3f-5fc1-a97f-75c417a4de92" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186316335}] :answer-field/correct {:db/id #edb/ref 17592186315133} :answer-field/id #uuid "7464d8a5-08db-527e-ae6f-a39637e25763" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316824} {:answer-field/choices [{:answer/id #uuid "25ed0276-2c2c-590f-8cf3-8e9560a9382e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315332} {:answer/id #uuid "3c0beb9b-15d0-5e7d-be81-a2261768c844" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186315464} {:answer/id #uuid "83f4701d-d6ed-5779-9953-ace7e06d74cb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315849}] :answer-field/correct {:db/id #edb/ref 17592186315849} :answer-field/id #uuid "86734426-13ad-555c-959c-201c8b396e42" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316857} {:answer-field/choices [{:answer/id #uuid "69d7be75-9cff-5055-abf6-8731caa29961" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315715} {:answer/id #uuid "fdb1ce19-9f8b-5eba-83bd-79edd557b6cf" :answer/type {:db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186316538}] :answer-field/correct {:db/id #edb/ref 17592186315715} :answer-field/id #uuid "c07a2823-4eda-5d88-8515-cf12f86486ef" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186317002} {:answer-field/choices [{:answer/id #uuid "103a311b-6837-5aa1-b2e0-7d1ceba394e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186315217} {:answer/id #uuid "711120c9-6920-5a47-9c36-a481b0f8923f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186315759} {:answer/id #uuid "c3328fd8-a582-53de-9cd2-efd19d1100c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186316215} {:answer/id #uuid "e0a5aafe-207d-58af-a17d-6e2bb04ce27c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186316363}] :answer-field/correct {:db/id #edb/ref 17592186316363} :answer-field/id #uuid "ce9feec9-f3c6-5510-bc50-0395fa9771a9" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186317036}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0d801752-c780-5add-95cf-b3a0d0a59bd1" :question/math-academy-id "q-343429" :question/problem "$$\nF(x)=\\{\\begin{aligned}-1, & x\\in [-2,0] \\\\ 2, & x\\in (0,2)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{1}{2}+{\\sum }_{n=1}^{\\infty }\\frac{6}{\\pi (2n-1)}sin\\,\\left(\\frac{(2n-1)\\pi x}{2}\\right).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=1,$ we have\n\n$$\nsin\\,\\left(\\frac{(2n-1)\\pi }{2}\\right)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=1,$ the corresponding Fourier series converges to \n\n$$\nf(1)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{1}{2}+\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,\\left(\\frac{(2n-1)\\pi x}{2}\\right).\n$$\n\nNow, notice that at $x=1,$ we have\n\n$$\nsin\\,\\left(\\frac{(2n-1)\\pi }{2}\\right)=sin\\,(-\\frac{\\pi }{2}+n\\pi )=(-1)^{n+1}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=1,$ the corresponding Fourier series converges to \n\n$$\nf(1)=2.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(1) & =\\frac{1}{2}+\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,\\left(\\frac{(2n-1)\\pi \\cdot 1}{2}\\right) \\\\ 2 & =\\frac{1}{2}+\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n+1} \\\\ \\frac{3}{2} & =\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3303fe09-6ad0-505a-89d8-a19574971d07" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315415} {:answer/id #uuid "69514901-5c64-5d07-b95a-d45b7fa88118" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186315712} {:answer/id #uuid "a1035538-7e14-55b0-ac2d-8d7e5266d7f3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316026}] :answer-field/correct {:db/id #edb/ref 17592186316026} :answer-field/id #uuid "1b0e268d-0a7c-5c87-942a-0d527b2e7230" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316610} {:answer-field/choices [{:answer/id #uuid "526509c1-9276-5c3d-8d48-c9645209f961" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186315588} {:answer/id #uuid "55ea1062-c9e1-5062-8d07-1555f9a98009" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186315611} {:answer/id #uuid "b78b7f35-d5d7-5ae4-be39-18600507be7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186316159} {:answer/id #uuid "ca0c938c-160a-52cd-8dd0-6140a987639e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186316255}] :answer-field/correct {:db/id #edb/ref 17592186315588} :answer-field/id #uuid "26f1fe62-5fe6-5d2f-a137-b4f3a4585631" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316633} {:answer-field/choices [{:answer/id #uuid "3b65ed1d-642e-56f2-bfbe-4ef0a45f2f92" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315459} {:answer/id #uuid "b855acb5-e97c-5841-8d72-85aa1b7718a9" :answer/type {:db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186316161}] :answer-field/correct {:db/id #edb/ref 17592186315459} :answer-field/id #uuid "32132a2d-5a62-506e-a3d9-84e46c8a7381" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316663} {:answer-field/choices [{:answer/id #uuid "0c35aee6-7694-50b8-99ff-38af1b21180b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315189} {:answer/id #uuid "13531dbc-f785-5e13-9d29-9d280d8db742" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315233} {:answer/id #uuid "4e9a9a9c-8530-5ab3-8a17-1e2278aba947" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186315567} {:answer/id #uuid "9666b55d-0e86-50aa-b086-53a192b7da15" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315952}] :answer-field/correct {:db/id #edb/ref 17592186315567} :answer-field/id #uuid "4f23a1a7-b2fc-50dd-b7d3-dea39ae4eda7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186316731}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0b3adfef-3238-5b0a-8f95-7aed0a3d3235" :question/math-academy-id "q-343443" :question/problem "$$\nF(x)=\\{\\begin{aligned}3, & x\\in [-\\pi ,0] \\\\ -5, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼-1-{\\sum }_{n=1}^{\\infty }\\frac{16}{\\pi (2n-1)}sin\\,((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot \\left(-\\frac{\\pi }{2}\\right))={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf\\left(-\\frac{\\pi }{2}\\right)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼-1-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,((2n-1)x).\n$$\n\nNow, notice that at $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot \\left(-\\frac{\\pi }{2}\\right))=sin\\,(\\frac{\\pi }{2}-n\\pi )=(-1)^{n}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf\\left(-\\frac{\\pi }{2}\\right)=3.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f\\left(-\\frac{\\pi }{2}\\right) & =-1-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,((2n-1)\\cdot \\left(-\\frac{\\pi }{2}\\right)) \\\\ 3 & =-1-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n} \\\\ 4 & =-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} & =-\\frac{\\pi }{4} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ed57d1-1d91-544a-bdae-7940b7113ad5" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to (1/2)}f(x)=\\text{DNE}" :db/id #edb/ref 17592186321348} {:answer/id #uuid "877e8444-5a27-500f-a477-baed7db698bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to (1/2)}f(x)=2" :db/id #edb/ref 17592186322223} {:answer/id #uuid "964d5dce-dd1f-5775-a66c-aba0c11d0274" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to (1/2)}f(x)=1" :db/id #edb/ref 17592186322343} {:answer/id #uuid "98de86f1-ea9d-579c-b52c-2a809a3accce" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to (1/2)}f(x)=-4" :db/id #edb/ref 17592186322361} {:answer/id #uuid "e14ed661-5e3a-5437-bf1b-eb0a7535207c" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to (1/2)}f(x)=4" :db/id #edb/ref 17592186322907}] :answer-field/correct {:db/id #edb/ref 17592186322907} :answer-field/id #uuid "bf487efd-f750-56a9-8fe4-aff8fa623557" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323545}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df0978e3-40c7-5749-aacd-3714af936e64" :question/math-academy-id "q-36720" :question/problem "Find the limit at $x=\\frac{1}{2}$ of the piecewise function $f(x)$ defined by\n\n$$\nf(x)=\\{\\begin{aligned}6x+1\\, & \\text{ for }\\,x\\le \\frac{1}{2} \\\\ -4{log}_{2}⁡x\\, & \\text{ for }\\,x>\\frac{1}{2}.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<\\frac{1}{2},$ so we use the expression $f(x)=6x+1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {(1/2)}^{-}}f(x) & =\\lim_{x\\to {(1/2)}^{-}}(6x+1) \\\\  & =6\\cdot \\frac{1}{2}+1 \\\\  & =4.\\end{aligned}\n$$\n\nNow,  approaching from the right, we have $x>\\frac{1}{2},$ so we use the expression $f(x)=-4{log}_{2}⁡x.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {(1/2)}^{+}}f(x) & =\\lim_{x\\to {(1/2)}^{+}}-4{log}_{2}⁡x \\\\  & =-4{log}_{2}⁡\\frac{1}{2} \\\\  & =-4{log}_{2}⁡{2}^{-1} \\\\  & =-4(-1){log}_{2}⁡2 \\\\  & =-4(-1) \\\\  & =4.\\end{aligned}\n$$\n\nSince the left- and right-sided limits are equal to $4,$ we conclude that\n\n$$\n\\lim_{x\\to (1/2)}f(x)=4.\n$$"}] [{:db/id #edb/ref 17592186323847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0331564f-2588-501b-b00b-4bfc21903eab" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 3}f(x)=-1" :db/id #edb/ref 17592186321178} {:answer/id #uuid "26f8feb1-5ef3-5db8-83c3-0253bb71a162" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 3}f(x)=\\text{DNE}" :db/id #edb/ref 17592186321454} {:answer/id #uuid "30a31cb0-e610-5382-bc68-23ae87a10893" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 3}f(x)=1" :db/id #edb/ref 17592186321520} {:answer/id #uuid "8e9a9190-a31e-5666-90db-d2259e210b30" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 3}f(x)=2" :db/id #edb/ref 17592186322279} {:answer/id #uuid "e9e36c4d-2ff0-5296-a228-00cad37c904e" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to 3}f(x)=3" :db/id #edb/ref 17592186322977}] :answer-field/correct {:db/id #edb/ref 17592186321454} :answer-field/id #uuid "6db0b422-9f7f-5b42-ba98-b50b2a2c0d76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323389}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2777af2b-a5d2-5c98-9043-4dca19a2df59" :question/math-academy-id "q-36724" :question/problem "Find the limit at $x=3$ for the function\n\n$$\nf(x)=\\{\\begin{aligned}\\sqrt[3]{3x-1}\\, & \\text{ for }\\,x<3 \\\\ \\operatorname{cos}⁡(x\\pi )\\, & \\text{ for }\\,x\\ge 3.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<3,$ so we use the expression $f(x)=\\sqrt[3]{3x-1}.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {3}^{-}}f(x) & =\\lim_{x\\to {3}^{-}}\\sqrt[3]{3x-1} \\\\  & =\\sqrt[3]{3\\cdot 3-1} \\\\  & =\\sqrt[3]{8} \\\\  & =2\\,.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>3,$ so we use the expression $f(x)=\\operatorname{cos}⁡(x\\pi ).$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {3}^{+}}f(x) & =\\lim_{x\\to {3}^{+}}\\operatorname{cos}⁡(x\\pi ) \\\\  & =\\operatorname{cos}⁡(3\\pi ) \\\\  & =-1\\,.\\end{aligned}\n$$\n\nSince the two limits are different, we can conclude that\n\n$$\n\\lim_{x\\to 3}f(x)=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186326932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65f2ced9-7d2e-51ec-aed8-fc926b53f822" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186324817} {:answer/id #uuid "7a06542b-390b-5e71-9cea-5c0da8ee2843" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324990} {:answer/id #uuid "8d55f82d-0360-5372-9d47-93fdb7f1cbc3" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186325172} {:answer/id #uuid "a2cef144-bd04-58d5-a563-7219e9963b56" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186325353} {:answer/id #uuid "e9d92509-50b3-508e-87be-92b11a53a57e" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186326031}] :answer-field/correct {:db/id #edb/ref 17592186324817} :answer-field/id #uuid "3c115403-e9a8-53a4-802c-1239ad8a7cc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326319}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cc08f308-2d18-506d-9143-fe2b2d3a192c" :question/math-academy-id "q-42129" :question/problem "Find \n$$\n\\displaystyle \\begin{vmatrix}a & 2 & 10 \\\\ 0 & b & 12 \\\\ 0 & 0 & 4\\end{vmatrix}\n$$\ngiven that \n$$\n\\displaystyle \\begin{vmatrix}a & 2 \\\\ 0 & b\\end{vmatrix}=-5.\n$$" :question/worked-solution "Notice that we have  a block upper triangular matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}a & 2 & 10 \\\\ 0 & b & 12 \\\\ 0 & 0 & 4\\end{vmatrix} & =|\\begin{array}{cc|c}a & 2 & 10 \\\\ 0 & b & 12 \\\\ \\hline 0 & 0 & 4\\end{array}| \\\\  & =\\begin{vmatrix}a & 2 \\\\ 0 & b\\end{vmatrix}\\cdot 4 \\\\  & =-5\\cdot 4 \\\\  & =-20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2934b6-da54-5d53-98f7-fbe430d5e744" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186327053} {:answer/id #uuid "26d292f5-32a6-5175-aec1-21401aba3b57" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186327270} {:answer/id #uuid "6f5bdb65-c453-5967-9ce8-7ccdc0e6c5c6" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186327897} {:answer/id #uuid "bec35a1e-5a2c-5e67-83e9-f90ea3d2d3eb" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186328601} {:answer/id #uuid "cc678f64-c03c-5c94-91be-b2f4e017e0d4" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186328726}] :answer-field/correct {:db/id #edb/ref 17592186328601} :answer-field/id #uuid "0f8b7b10-83d3-52d4-948a-7e7e4e370fa9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329208}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f1190f94-94ed-5602-8000-c03537160c28" :question/math-academy-id "q-42139" :question/problem "Find \n$$\n\\displaystyle \\begin{vmatrix}2 & 0 & 0 \\\\ 0 & d & e \\\\ 0 & 2 & -1\\end{vmatrix}\n$$\ngiven that\n$$\n\\displaystyle \\begin{vmatrix}d & e \\\\ 2 & -1\\end{vmatrix}=7.\n$$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 0 & 0 \\\\ 0 & d & e \\\\ 0 & 2 & -1\\end{vmatrix} & =|\\begin{array}{c|cc}2 & 0 & 0 \\\\ \\hline 0 & d & e \\\\ 0 & 2 & -1\\end{array}| \\\\  & =2\\cdot \\begin{vmatrix}d & e \\\\ 2 & -1\\end{vmatrix} \\\\  & =2\\cdot 7 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be7744ec-227d-555c-b802-95392ec513c1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467518} {:answer/id #uuid "f886a11b-86a7-5b5a-8f76-6da328b63714" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467519}] :answer-field/correct {:db/id #edb/ref 17592186467519} :answer-field/id #uuid "c8d7c76e-d109-5769-8668-62038090a469" :answer-field/key "$|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|=-4|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468480} {:answer-field/choices [{:answer/id #uuid "86b1e6c3-5e63-57c4-9a2c-3c91c2d3c235" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467520} {:answer/id #uuid "0e0f888e-4bbc-5ac8-806d-7f7a885bfed4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467521}] :answer-field/correct {:db/id #edb/ref 17592186467520} :answer-field/id #uuid "14df28d2-7f17-512c-aa78-54fedf4382f1" :answer-field/key "$|\\begin{aligned}-14 & 1 \\\\ -34 & -k\\end{aligned}|=4|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468481} {:answer-field/choices [{:answer/id #uuid "2d8c2352-983b-5658-8df2-16e409639b55" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467522} {:answer/id #uuid "a3313dd9-a767-59cb-bba4-c976f1f2ec54" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467523}] :answer-field/correct {:db/id #edb/ref 17592186467522} :answer-field/id #uuid "1283c815-0425-57c4-8ea5-2495c255615f" :answer-field/key "$-4|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|=|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468482}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc386e74-2622-5d48-a383-9789d25d9007" :question/math-academy-id "q-42613" :question/problem "Let $⟨-4,y⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}9x+11y &=-14 \\\\ 6x-ky &=-34.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}9 & 11 \\\\ 6 & -k\\end{vmatrix}.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x} & =\\begin{vmatrix}-14 & 11 \\\\ -34 & -k\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D} \\\\ -4 & =\\frac{\\begin{vmatrix}-14 & 11 \\\\ -34 & -k\\end{vmatrix}}{\\begin{vmatrix}9 & 11 \\\\ 6 & -k\\end{vmatrix}} \\\\ -4\\begin{vmatrix}9 & 11 \\\\ 6 & -k\\end{vmatrix} & =\\begin{vmatrix}-14 & 11 \\\\ -34 & -k\\end{vmatrix}\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle \\begin{vmatrix}-14 & 11 \\\\ -34 & -k\\end{vmatrix}=-4\\begin{vmatrix}9 & 11 \\\\ 6 & -k\\end{vmatrix}\n$$ only."}] [{:db/id #edb/ref 17592186329702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35563308-1bf5-5412-b3ac-38e945d6435f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467548} {:answer/id #uuid "8cce9941-e08e-5b25-878b-8a3e1fd19b85" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467549}] :answer-field/correct {:db/id #edb/ref 17592186467548} :answer-field/id #uuid "14870e3e-adcd-5e31-8d98-7270ab6e02ba" :answer-field/key "$|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|=-13$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468495} {:answer-field/choices [{:answer/id #uuid "02c55623-fcd2-5073-8bbe-89c8cd4a2e52" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467550} {:answer/id #uuid "79d4acc9-9024-588c-a500-b68af6d2d348" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467551}] :answer-field/correct {:db/id #edb/ref 17592186467550} :answer-field/id #uuid "fa0e6660-67a9-5431-b123-e8f58681f385" :answer-field/key "$|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|=-1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468496} {:answer-field/choices [{:answer/id #uuid "5c20d9fe-a802-5cb2-97e5-b29befe6b81d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467552} {:answer/id #uuid "99913413-aa5b-526c-8205-7d8f2623301b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467553}] :answer-field/correct {:db/id #edb/ref 17592186467553} :answer-field/id #uuid "7d0e47a0-8744-5d99-932d-e825a9175d73" :answer-field/key "$|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|=13$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468497}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "854132a3-b7f0-5d3e-b0d4-55e43fe2b0f3" :question/math-academy-id "q-42984" :question/problem "Let $⟨-1,y⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x+5y &=k \\\\ 2x-y &=-4.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}3 & 5 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-3-10 \\\\  & -13.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x} & =\\begin{vmatrix}k & 5 \\\\ -4 & -1\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D} \\\\ -1 & =\\frac{\\begin{vmatrix}k & 5 \\\\ -4 & -1\\end{vmatrix}}{-13} \\\\ \\begin{vmatrix}k & 5 \\\\ -4 & -1\\end{vmatrix} & =(-1)(-13) \\\\ \\begin{vmatrix}k & 5 \\\\ -4 & -1\\end{vmatrix} & =13\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle \\begin{vmatrix}k & 5 \\\\ -4 & -1\\end{vmatrix}=13\n$$ only."}] [{:db/id #edb/ref 17592186329826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7586a0dc-25d3-53c5-b3af-cdc314d8fce7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451411} {:answer/id #uuid "6dc22f55-8ff2-5a8c-bcc3-e6b2be4c1019" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451412}] :answer-field/correct {:db/id #edb/ref 17592186451411} :answer-field/id #uuid "f438756f-c79d-53bd-81ac-ca123103d798" :answer-field/key "It is continuous and differentiable at $x=1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452553} {:answer-field/choices [{:answer/id #uuid "1089274e-1ae2-5b78-a393-34038fd470a4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451413} {:answer/id #uuid "501e9e09-32a6-52eb-99c7-4a057e5cb0bd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451414}] :answer-field/correct {:db/id #edb/ref 17592186451414} :answer-field/id #uuid "47ec493f-310f-5901-ae51-8ee0e6d54060" :answer-field/key "It is **not** differentiable at $x=1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452554} {:answer-field/choices [{:answer/id #uuid "6be1a7df-639d-50cc-ad8c-bbe0418ffddf" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451415} {:answer/id #uuid "c045dc4a-dc87-5d60-b5ee-eeb1471cb20e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451416}] :answer-field/correct {:db/id #edb/ref 17592186451415} :answer-field/id #uuid "51fbc957-ad59-548f-b7b0-b1fa76bed7e9" :answer-field/key "It is differentiable on the interval $(-1,2)$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452555}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8298d153-fa1d-58c6-bfcd-efab6041f9f0" :question/math-academy-id "q-47681" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)=\\{\\begin{aligned}{x}^{3}+1, & x\\ne 1 \\\\ 3, & x=1\\end{aligned}\\,\n$$\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement individually. \n\n- Statement “It is continuous and differentiable at $x=1$” is false.  At $x=1$, we have \n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}({x}^{3}+1)={1}^{3}+1=2 \\\\ \\lim_{x\\to {1}^{-}}f(x) & =\\lim_{x\\to {1}^{-}}({x}^{3}+1)={1}^{3}+1=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to {1}^{+}}f(x)=\\lim_{x\\to {1}^{-}}f(x)\\ne f(1)=3,\n$$\n\nand so $f(x)$ is not continuous at $x=1$ ($f(x)$ has a removable discontinuity at $x=1$).\n\n- Statement “It is **not** differentiable at $x=1$” is true. Since  $f(x)$ is not continuous at $x=1,$ it is also not differentiable there (because differentiability implies continuity).\n\n- Statement “It is differentiable on the interval $(-1,2)$” is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(-1,2).$\n\nTherefore, only statement “It is **not** differentiable at $x=1$” is true."}] [{:db/id #edb/ref 17592186332845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e9e5a96-4534-58ea-bab8-06e75a58241f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451447} {:answer/id #uuid "37186cca-00e9-556e-9ebb-cf5c0f3d22fa" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451448}] :answer-field/correct {:db/id #edb/ref 17592186451447} :answer-field/id #uuid "a759576c-6748-54ed-b630-631dd1491276" :answer-field/key "It is continuous and differentiable at $x=1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452571} {:answer-field/choices [{:answer/id #uuid "7c9d7f40-ce2a-5069-b244-f2015404fbec" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451449} {:answer/id #uuid "dca9b7a5-d530-5de9-88ae-c75a211f007e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451450}] :answer-field/correct {:db/id #edb/ref 17592186451449} :answer-field/id #uuid "4ffd2573-bf93-588a-948e-63534ae3550a" :answer-field/key "It is differentiable on the interval $(-2,2)$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452572} {:answer-field/choices [{:answer/id #uuid "dc1ab0af-7df7-5290-9161-a4b21fba48ae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451451} {:answer/id #uuid "585c3f02-a77d-56b4-9200-a30714a42bcd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451452}] :answer-field/correct {:db/id #edb/ref 17592186451452} :answer-field/id #uuid "385e7e32-dae1-552f-b1b3-a83635627292" :answer-field/key "It is **not** differentiable at $x=1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452573}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4ce07619-7707-5d93-86b3-865c0def2d71" :question/math-academy-id "q-51072" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)=\\{\\begin{aligned}-x+4, & x<1 \\\\ 0, & x=1 \\\\ x+2, & x>1\\end{aligned}\\,\n$$\n\nSelect all that apply." :question/worked-solution "- Statement “It is continuous and differentiable at $x=1$” is false and statement “It is **not** differentiable at $x=1$” is true. Indeed,  let's investigate the continuity of $f(x).$ It is continuous everywhere except, possibly, $x=1.$ At this point, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}f(x) & =\\lim_{x\\to {1}^{-}}(-x+4)=-1+4=3 \\\\ \\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}(x+2)=1+2=3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to {1}^{+}}f(x)=\\lim_{x\\to {1}^{-}}f(x)\\ne f(1)=0,\n$$\n\nand so $f(x)$ is not continuous at $x=1$ (it has a removable discontinuity there). Hence, it is also not differentiable at this point.\n\n- Statement “It is differentiable on the interval $(-2,2)$” is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(-2,2).$"}] [{:db/id #edb/ref 17592186338767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ae2925c-3b96-520c-a0d3-abd31d1b1a7c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467800} {:answer/id #uuid "a8c35df2-2bc6-5aff-a8c0-5983afd08cee" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467801}] :answer-field/correct {:db/id #edb/ref 17592186467800} :answer-field/id #uuid "9964608f-6d33-5d23-ad89-67c51daca483" :answer-field/key "$|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|=-2|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468621} {:answer-field/choices [{:answer/id #uuid "f51e75d4-d650-5dde-bab9-f44d9ed0ba19" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467802} {:answer/id #uuid "2ddc6cc2-a2f6-5c31-89bf-5e97f4160d3a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467803}] :answer-field/correct {:db/id #edb/ref 17592186467802} :answer-field/id #uuid "21a74bb3-8d72-54f1-aaee-8348f893cc5c" :answer-field/key "$|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|=|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468622} {:answer-field/choices [{:answer/id #uuid "554d0d1b-860a-576b-b335-77efc0624d21" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467804} {:answer/id #uuid "4374345d-6d8f-5041-923b-26fb3a674b3b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467805}] :answer-field/correct {:db/id #edb/ref 17592186467805} :answer-field/id #uuid "b1ccbcc4-dfe8-569e-8534-c9a02b85e5b8" :answer-field/key "$|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|=-|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468623}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e21820bb-bc15-5fe3-a578-6f44daf46f1f" :question/math-academy-id "q-70252" :question/problem "Let $⟨-1,y⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+ky &=-4 \\\\ 3x-4y &=5.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}2 & k \\\\ 3 & -4\\end{vmatrix}.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x} & =\\begin{vmatrix}-4 & k \\\\ 5 & -4\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D} \\\\ -1 & =\\frac{\\begin{vmatrix}-4 & k \\\\ 5 & -4\\end{vmatrix}}{\\begin{vmatrix}2 & k \\\\ 3 & -4\\end{vmatrix}} \\\\ \\begin{vmatrix}2 & k \\\\ 3 & -4\\end{vmatrix} & =-\\begin{vmatrix}-4 & k \\\\ 5 & -4\\end{vmatrix}\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle \\begin{vmatrix}2 & k \\\\ 3 & -4\\end{vmatrix}=-\\begin{vmatrix}-4 & k \\\\ 5 & -4\\end{vmatrix}\n$$ only."}] [{:db/id #edb/ref 17592186338891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53623a55-b77d-5351-9fc2-d973dfa306f4" :answer/type {:db/ident :answer.type/text} :answer/value "$f(-1)$ does not exist" :db/id #edb/ref 17592186336802} {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} {:answer/id #uuid "976f1ad0-705e-5259-a60b-4f7ca8ac9ef3" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lim_{x\\to (-1)^{-}}f(x)$ does not exist" :db/id #edb/ref 17592186337413} {:answer/id #uuid "aaa26b4e-cfda-5c6f-8638-0760a72b3b60" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lim_{x\\to (-1)^{+}}f(x)$ does not exist" :db/id #edb/ref 17592186337570} {:answer/id #uuid "fb13ed6b-6c19-5ee0-9d99-95a01f90eaeb" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lim_{x\\to (-1)}f(x)$ does not exist" :db/id #edb/ref 17592186338236}] :answer-field/correct {:db/id #edb/ref 17592186337129} :answer-field/id #uuid "af56593a-6a9e-589a-b62d-3c3c78f2abea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338599}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c90a0801-6b26-5a6a-b72a-693261024597" :question/math-academy-id "q-71079" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=-1?$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}+1}{2}, & x<-1 \\\\ 2, & x=-1 \\\\ \\frac{2}{{x}^{2}+1}, & x>-1\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=-1.$\n\n- $f(-1)=2,$ so $f(-1)$ exists. $✓$\n\n- We calculate the one-sided limits and check if they coincide:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1)^{-}}f(x) & =\\lim_{x\\to (-1)^{-}}\\left(\\frac{{x}^{2}+1}{2}\\right) \\\\  & =\\frac{(-1)^{2}+1}{2} \\\\  & =\\frac{1+1}{2} \\\\  & =1, \\\\ \\lim_{x\\to (-1)^{+}}f(x) & =\\lim_{x\\to (-1)^{+}}\\left(\\frac{2}{{x}^{2}+1}\\right) \\\\  & =\\frac{2}{(-1)^{2}+1} \\\\  & =\\frac{2}{1+1} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the overall limit exists and $\\lim_{x\\to (-1)}f(x)=1$ $✓$\n\n- The limit of the function is not equal to the function value: $\\lim_{x\\to (-1)}f(x)=1,$ while $f(-1)=2.$ $\\,\\,\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=-1$ because $\\lim_{x\\to (-1)}f(x)\\ne f(-1).$"}] [{:db/id #edb/ref 17592186341990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61d52bbf-27b3-5866-b828-58197f11fac0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468040} {:answer/id #uuid "c05f5724-e978-5eea-b92e-be4ff7cc5a0d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468041}] :answer-field/correct {:db/id #edb/ref 17592186468040} :answer-field/id #uuid "dc14219f-7f18-5ba0-9fb0-e04cfae28cad" :answer-field/key "$[-1,1]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468741} {:answer-field/choices [{:answer/id #uuid "5693a553-a140-59da-b649-fed8ae8eea18" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468042} {:answer/id #uuid "5d98483c-577a-5658-83b7-11401637261c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468043}] :answer-field/correct {:db/id #edb/ref 17592186468043} :answer-field/id #uuid "08342a0b-3ffb-5b86-b7e3-32a2e2c374fe" :answer-field/key "$[\\frac{1}{2},1]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468742} {:answer-field/choices [{:answer/id #uuid "a6533366-2a36-568d-b35d-24894d19e704" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468044} {:answer/id #uuid "96549b46-bd6d-576f-b03c-61ff8c2c2d92" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468045}] :answer-field/correct {:db/id #edb/ref 17592186468044} :answer-field/id #uuid "b266eb0d-67ee-5d2a-919e-0f751c92ae28" :answer-field/key "$[-1,0)$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468743}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7b9b884e-eb8a-59c7-aa31-49f0025fb47f" :question/math-academy-id "q-73495" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}{2}^{-x}, & x\\ge 0 \\\\ -1, & x<0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}f(x) & =\\lim_{x\\to 0}({2}^{-x})={2}^{0}=1, \\\\ \\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to 0}(-1)=-1.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[\\frac{1}{2},1].$ In this interval, $f(x)={2}^{-x}$ and so $f(x)$ is continuous on $[\\frac{1}{2},1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, the interval $[-1,0)$, is not closed, so the extreme value theorem is not applicable in this case.\n\nIn conclusion, the correct answer is $[\\frac{1}{2},1]$ only."}] [{:db/id #edb/ref 17592186341991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f25d5da-ec35-5632-aad0-213145d26886" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468046} {:answer/id #uuid "c76b69ff-3198-57d9-aef0-130f0dde5932" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468047}] :answer-field/correct {:db/id #edb/ref 17592186468046} :answer-field/id #uuid "18b84733-209d-5464-81ea-0c9b576450f5" :answer-field/key "$[0,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468744} {:answer-field/choices [{:answer/id #uuid "07e8a938-e962-527f-add2-4a924aeca6bd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468048} {:answer/id #uuid "d138c8c0-fc82-5702-acaf-54cc5cce2285" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468049}] :answer-field/correct {:db/id #edb/ref 17592186468049} :answer-field/id #uuid "67486e15-3e89-5ef7-ae3e-0805624a1cc5" :answer-field/key "$[-1,0]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468745} {:answer-field/choices [{:answer/id #uuid "8eeedf4d-8de8-56c0-94c3-b7f2c06a9024" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468050} {:answer/id #uuid "401e04fe-e906-51ad-8dfa-8a0c0aebd6fb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468051}] :answer-field/correct {:db/id #edb/ref 17592186468050} :answer-field/id #uuid "e04dd868-99c1-5128-856f-dcf493097c6c" :answer-field/key "$[-1,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468746}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d1eaad6e-884d-57bd-a4ae-a690d3d6abe9" :question/math-academy-id "q-73499" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{ln}⁡(x-1), & x>1 \\\\ x-1, & x\\le 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[0,2].$ In this case, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\nHence, $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[0,2],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[-1,0].$ In this interval, $f(x)=x-1$ and so $f(x)$ is continuous on $[-1,0].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, in the interval $[-1,2]$, we also have\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\n \nHence, $f(x)$ is not continuous on $[-1,2]$ and therefore  the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is $[-1,0]$ only."}] [{:db/id #edb/ref 17592186342003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "590b6563-fc5a-5099-8b31-7c8840139fb3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468064} {:answer/id #uuid "823fa8bb-4902-59a1-8b15-a420ef200eaf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468065}] :answer-field/correct {:db/id #edb/ref 17592186468064} :answer-field/id #uuid "b03606bc-af56-5495-a640-2b1ff321627a" :answer-field/key "$[-2,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468753} {:answer-field/choices [{:answer/id #uuid "6551ac70-7210-595b-b7c9-6d9837da871d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468066} {:answer/id #uuid "cad2d236-f9c3-5706-b2e8-53826efc2a83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468067}] :answer-field/correct {:db/id #edb/ref 17592186468066} :answer-field/id #uuid "1a52ec7c-0e75-5e34-b576-a534c8cf21a1" :answer-field/key "$[-3,1)$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468754} {:answer-field/choices [{:answer/id #uuid "44dc5099-0725-53e3-b405-c81f11d46f16" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468068} {:answer/id #uuid "6b7e8804-4489-51c0-b955-8a411b43aaac" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468069}] :answer-field/correct {:db/id #edb/ref 17592186468069} :answer-field/id #uuid "e79dce1b-5f18-5741-977a-3edf1f823ef0" :answer-field/key "$[1.5,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468755}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8abc4b9f-caf8-5c94-91da-62ad0ae61b3d" :question/math-academy-id "q-73531" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{x-1}-1}, & x\\ne 1 \\\\ \\,\\,1, & x=1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- Let first consider the interval  $[-2,2].$ This is a  closed interval, but we have\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}\\frac{1}{{2}^{x-1}-1}=\\infty \\end{aligned}\n$$\n\nand so $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1]$, and the extreme value theorem is not applicable.\n\n- The interval $[-3,1)$ is not closed, so the extreme value theorem is not applicable in this case.\n\n- Finally consider  $[1.5,2].$ The only discontinuity of the function $f(x)$ is at $x=1,$ which is not in the interval  $[1.5,2].$ Therefore, $f(x)$ is continuous on the interval  $[1.5,2]$, and the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is $[1.5,2]$ only."}] [{:db/id #edb/ref 17592186345293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7a2c945-cc7a-516f-b667-0d89251d3b88" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468196} {:answer/id #uuid "40dd3909-7386-578c-83fe-14ada120188c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468197}] :answer-field/correct {:db/id #edb/ref 17592186468197} :answer-field/id #uuid "a689391a-097b-5af2-9f28-47cb333ebeda" :answer-field/key "$|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-6$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468819} {:answer-field/choices [{:answer/id #uuid "fd7b34da-0847-5b45-af70-c9c06b31eade" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468198} {:answer/id #uuid "a7025902-02fe-5c8c-8871-b5a8b672cf56" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468199}] :answer-field/correct {:db/id #edb/ref 17592186468198} :answer-field/id #uuid "55fe37fb-e330-5dc6-9f1e-3cb5a382485e" :answer-field/key "$|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-12$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468820} {:answer-field/choices [{:answer/id #uuid "9f36311c-d5c2-569b-97ab-eaf35ae46749" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468200} {:answer/id #uuid "4903bf3a-5ec0-502a-9315-987f705aa1f8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468201}] :answer-field/correct {:db/id #edb/ref 17592186468200} :answer-field/id #uuid "efa69594-ec70-57b1-b89f-3696a43adfec" :answer-field/key "$|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=3$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468821}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dfe3c702-6424-5bb5-8a56-52b5a6e22724" :question/math-academy-id "q-77400" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ 2x+y &=k\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}1 & -1 \\\\ 2 & 1\\end{vmatrix} \\\\  & =1+2 \\\\  & =3.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =\\begin{vmatrix}1 & 2 \\\\ 2 & k\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{\\begin{vmatrix}1 & 2 \\\\ 2 & k\\end{vmatrix}}{3} \\\\ \\begin{vmatrix}1 & 2 \\\\ 2 & k\\end{vmatrix} & =-6\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle \\begin{vmatrix}1 & 2 \\\\ 2 & k\\end{vmatrix}=-6\n$$ only."}] [{:db/id #edb/ref 17592186345294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d68061f9-26f7-5cb1-b451-9613d07f582b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468202} {:answer/id #uuid "305d62c3-fb2c-554a-888b-993e673cc358" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468203}] :answer-field/correct {:db/id #edb/ref 17592186468202} :answer-field/id #uuid "7204a3ea-ab6b-5c40-bbe8-ec855216acb2" :answer-field/key "$|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=5$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468822} {:answer-field/choices [{:answer/id #uuid "29506dd5-d859-5ad5-9d4b-430345bd390d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468204} {:answer/id #uuid "8aa20fab-5c90-5c84-a527-307ae07a2504" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468205}] :answer-field/correct {:db/id #edb/ref 17592186468204} :answer-field/id #uuid "5ae3e59d-3a9b-58cd-9548-f87659ec9274" :answer-field/key "$|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=-7$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468823} {:answer-field/choices [{:answer/id #uuid "db9a7f34-a705-56e4-95cf-26717aba6aa0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468206} {:answer/id #uuid "b87a5642-b55a-55d3-b69c-559ebce5dc2b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468207}] :answer-field/correct {:db/id #edb/ref 17592186468207} :answer-field/id #uuid "f473da0d-0013-52fe-bd69-e5c67cc3e1ac" :answer-field/key "$|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=13$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468824}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a75a54e5-59f0-5536-9005-ac12974e1a69" :question/math-academy-id "q-77401" :question/problem "Let $⟨x,1⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x-y &=k \\\\ x+4y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =\\begin{vmatrix}3 & -1 \\\\ 1 & 4\\end{vmatrix} \\\\  & =12+1 \\\\  & =13.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =\\begin{vmatrix}3 & k \\\\ 1 & 3\\end{vmatrix}.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}1 & =\\frac{{D}_{y}}{D} \\\\ 1 & =\\frac{\\begin{vmatrix}3 & k \\\\ 1 & 3\\end{vmatrix}}{13} \\\\ \\begin{vmatrix}3 & k \\\\ 1 & 3\\end{vmatrix} & =13\\end{aligned}\n$$\n\nSo, the correct answer is $$\n\\displaystyle \\begin{vmatrix}3 & k \\\\ 1 & 3\\end{vmatrix}=13\n$$ only."}] [{:db/id #edb/ref 17592186348410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed782008-d4bb-582f-8807-d4b2a836e6be" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469182} {:answer/id #uuid "3c54d1e7-ad86-5f47-bd24-54748f29d4fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469183}] :answer-field/correct {:db/id #edb/ref 17592186469183} :answer-field/id #uuid "64ff9acc-15fa-5b35-b5c4-b8f3bf78db99" :answer-field/key "$\\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470203} {:answer-field/choices [{:answer/id #uuid "50e43c3e-49bc-5747-bc7d-86c7f947be32" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469184} {:answer/id #uuid "fb0c42e5-292e-59b3-96a8-e42c0ec855e3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469185}] :answer-field/correct {:db/id #edb/ref 17592186469184} :answer-field/id #uuid "5bb45f02-d2af-5280-a109-2bf63fa0482d" :answer-field/key "$\\{\\begin{aligned}0, & (x,y)\\in R \\\\ \\frac{2x+y}{y}, & (x,y)\\in D∖R\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470204} {:answer-field/choices [{:answer/id #uuid "89749230-2ffe-51eb-8434-4cccec8af5aa" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469186} {:answer/id #uuid "95c596d5-e2a4-574b-bae8-8587629e2bba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469187}] :answer-field/correct {:db/id #edb/ref 17592186469187} :answer-field/id #uuid "07159f59-7f7d-59a7-b2fb-4d5e3b43d7d4" :answer-field/key "$\\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470205}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b7813ca-41d9-58f5-aaf1-c07ba10ad235" :question/math-academy-id "q-80540" :question/problem "![](images/50/506a298041a875549ec60c5cf99ebdbeb5ca4b5717037083fa6ca196fce27279.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [0,3],$ and\n\n$$\n{∬}_{D}\\frac{2x+y}{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/d2/d2b5c55b15f594680e8f299899d690cd1d92baa1ebef31ce5c79af52afec631e.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\frac{2x+y}{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}\\frac{2x+y}{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use function $$\n\\displaystyle \\{\\begin{aligned}0, & (x,y)\\in R \\\\ \\frac{2x+y}{y}, & (x,y)\\in D∖R\\end{aligned}.\n$$ Since $D∖R$ is empty, the function $f(x,y)$ will be identical to zero for all points in $R,$ including $D.$ But $\\frac{2x+y}{y}$ is not zero, for example, at $(x,y)=(0,2)\\in D.$\n\n- Functions $$\n\\displaystyle \\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}\n$$ and $$\n\\displaystyle \\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ equals $\\frac{2x+y}{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is $$\n\\displaystyle \\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned};\n$$ $$\n\\displaystyle \\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ only."}] [{:db/id #edb/ref 17592186354529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d38473f-1c37-5574-8cce-9dd05c01a1db" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469434} {:answer/id #uuid "71548014-9b7d-5256-a391-69ae37925ab0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469435}] :answer-field/correct {:db/id #edb/ref 17592186469434} :answer-field/id #uuid "e1a8edea-d8f5-5695-b707-719355dcc825" :answer-field/key "$R=[-1,2]\\times [0,1]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470329} {:answer-field/choices [{:answer/id #uuid "fc491af5-dcc1-573c-b195-84c60e3c6752" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469436} {:answer/id #uuid "69bc5686-a74d-53b3-8ced-e77c8cd7dd44" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469437}] :answer-field/correct {:db/id #edb/ref 17592186469437} :answer-field/id #uuid "9df60925-b297-5260-8b29-cb30e2524168" :answer-field/key "$R=[-1,2]\\times [-2,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470330} {:answer-field/choices [{:answer/id #uuid "012003e8-85b8-5998-9a8f-328e7aa4ca2b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469438} {:answer/id #uuid "3a2f000d-1620-5df1-82ba-d1c1e9fa1e3f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469439}] :answer-field/correct {:db/id #edb/ref 17592186469438} :answer-field/id #uuid "21ba43a7-52b8-58fc-9557-eab716ef3dd5" :answer-field/key "$R=[-2,2]\\times [0,1]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470331}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63f88f2b-5634-54ed-8998-5ec059a5e869" :question/math-academy-id "q-86861" :question/problem "![](images/53/534f6ef0206bd4281320968c8a60b88f7f237e48c31e3d10c1080ddb69b9f56f.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}-{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}({x}^{2}-{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}-{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}-{y}^{3})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangles $R=[-1,2]\\times [0,1]$ and $R=[-2,2]\\times [0,1]$ do not cover the region $D.$\n\n- Rectangle $R=[-1,2]\\times [-2,2]$ covers the region $D$ completely.\n\nTherefore, the correct answer is $R=[-1,2]\\times [-2,2]$ only."}] [{:db/id #edb/ref 17592186354530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14078cbb-e2f9-5c26-80b6-ce16aa62ca33" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451869} {:answer/id #uuid "618b19c8-3470-50fe-b37b-4cc4086849aa" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451870}] :answer-field/correct {:db/id #edb/ref 17592186451869} :answer-field/id #uuid "dd4d02ca-f845-54bf-97b7-803e44eb3ff2" :answer-field/key "${∬}_{D}{e}^{x-y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452782} {:answer-field/choices [{:answer/id #uuid "d62be857-de11-55f2-bf65-a6f6fa2b4ed2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451871} {:answer/id #uuid "63d3abf6-f57f-54e2-a190-75a48dc84fa1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451872}] :answer-field/correct {:db/id #edb/ref 17592186451871} :answer-field/id #uuid "eebb9ca8-6ae2-54a4-8b8d-d24fe6daf795" :answer-field/key "${∬}_{R}{e}^{x-y}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452783} {:answer-field/choices [{:answer/id #uuid "d54569e8-25cd-51fb-9e4c-cbeb92e1913c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451873} {:answer/id #uuid "4a739055-caf5-5dad-a093-92704b147e1d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451874}] :answer-field/correct {:db/id #edb/ref 17592186451874} :answer-field/id #uuid "edc906f1-6059-5fa6-9455-d997269a94cd" :answer-field/key "${∬}_{D}{e}^{x-y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452784}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "020f4792-4587-5aa1-be12-a9175f71b2e8" :question/math-academy-id "q-86867" :question/problem "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{x-y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D:$\n\n![](images/62/62925844de27c9731b181f17a1bdd912bfa3265176bd62ebda425d182ae8d9e8.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{x-y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}{e}^{x-y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “$$\n\\displaystyle {∬}_{D}{e}^{x-y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-2,2]\\times [-3,3]$” is false. The rectangle $R$ does not completely cover the region $D.$\n\n- Statement “$$\n\\displaystyle {∬}_{R}{e}^{x-y}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-2,2]\\times [-3,3]$” is false. The rectangle $R$ does not cover the region $D.$ Also, the integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement “$$\n\\displaystyle {∬}_{D}{e}^{x-y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-2,2]$” is true. Indeed, the rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is “$$\n\\displaystyle {∬}_{D}{e}^{x-y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-2,2]$” only."}] [{:db/id #edb/ref 17592186354532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4d320e0-ae6e-50fb-9499-96141d8d23cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469440} {:answer/id #uuid "13df0eb3-71ad-51e9-9129-0b147ebcf52a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469441}] :answer-field/correct {:db/id #edb/ref 17592186469441} :answer-field/id #uuid "27947ac9-7b94-54bc-b68f-70dbc5d1a0f7" :answer-field/key "$\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470332} {:answer-field/choices [{:answer/id #uuid "ba2ef83f-94cb-52a9-97c1-2a2dd65d32b0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469442} {:answer/id #uuid "6e09612b-3ac0-58d8-9cbd-02412a7ecd6f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469443}] :answer-field/correct {:db/id #edb/ref 17592186469443} :answer-field/id #uuid "597be7b9-557b-5a03-b098-582e28fbabba" :answer-field/key "$\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470333} {:answer-field/choices [{:answer/id #uuid "8546fa73-dcec-50dc-974d-858421123cff" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469444} {:answer/id #uuid "0bbd1552-1f4e-52a4-a141-e1fb530579a5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469445}] :answer-field/correct {:db/id #edb/ref 17592186469444} :answer-field/id #uuid "00caafb1-473f-5b30-8fec-fff060993a90" :answer-field/key "$\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470334} {:answer-field/choices [{:answer/id #uuid "817ecd59-8e82-5f2d-9ecb-8b5582faeb69" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668727} {:answer/id #uuid "bd147ff9-91f1-5381-8931-f0e9bb8c2202" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668728}] :answer-field/correct {:db/id #edb/ref 17592186668727} :answer-field/id #uuid "2291b4ef-e385-501a-936c-7f8aa2bbd1f6" :answer-field/key "None of the above" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668941}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0b045a52-4215-5bdb-9dcf-5641984e3591" :question/math-academy-id "q-86898" :question/problem "Let $D$ be a finite region enclosed by the curves $y={x}^{2}-1$ and $y=|x|.$ If $R=[-2,2]\\times [-1,2],$ and\n\n$$\n{∬}_{D}\\frac{y}{{x}^{2}+1}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/23/23f31619eda46f1e8604695c4056d4c0c5bb8ee1e186b1316151762d5b5c8e59.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\frac{y}{{x}^{2}+1}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}\\frac{y}{{x}^{2}+1}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions $$\n\\displaystyle \\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}\n$$ and $$\n\\displaystyle \\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ equal $\\frac{y}{{x}^{2}+1}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function $$\n\\displaystyle \\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}.\n$$ The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(0,1)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is $$\n\\displaystyle \\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned};\n$$ $$\n\\displaystyle \\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ only."}] [{:db/id #edb/ref 17592186354533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6df4441-21a2-5303-8fb5-58f8fecb14ae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469446} {:answer/id #uuid "ee618263-9395-5352-9720-a6eec6d6ed5d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469447}] :answer-field/correct {:db/id #edb/ref 17592186469447} :answer-field/id #uuid "4a0c311d-a059-5cd2-bbd6-64c976dac562" :answer-field/key "$\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470335} {:answer-field/choices [{:answer/id #uuid "7bc24ece-33bb-5946-a1eb-10980a715793" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469448} {:answer/id #uuid "304554bf-f809-5b6e-b9f7-a303c9a307fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469449}] :answer-field/correct {:db/id #edb/ref 17592186469449} :answer-field/id #uuid "31ed207a-f15c-5448-a440-49246efdf212" :answer-field/key "$\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470336} {:answer-field/choices [{:answer/id #uuid "e440f0a5-215d-5ce7-9d8c-a7d55e01e51a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469450} {:answer/id #uuid "edbee4f2-6785-5059-828c-aec5fd26b060" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469451}] :answer-field/correct {:db/id #edb/ref 17592186469450} :answer-field/id #uuid "d9570c66-92e3-5a9c-83b5-c9049f7f004a" :answer-field/key "$\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470337}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa4fe275-03b1-57bc-8327-4434c307d887" :question/math-academy-id "q-86899" :question/problem "Let $D$ be a finite region enclosed by the curves $y=-|x|+2$ and $y=|x|.$ If $R=[-1,1]\\times [0,2],$ and\n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/f3/f3ffc82025f80c357c06e28fcb091c701d53d84821bebd9d2886cf4972b77028.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${x}^{5}-{y}^{2}$ on $D$ and to be equal $0$ outside $D,$ we obtain  \n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\n \n\nWith that in mind, let's examine each of the given functions.\n\n- Functions $$\n\\displaystyle \\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}\n$$ and $$\n\\displaystyle \\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ equal ${x}^{5}-{y}^{2}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function $$\n\\displaystyle \\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}.\n$$ The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,0)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is $$\n\\displaystyle \\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned};\n$$ $$\n\\displaystyle \\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ only."}] [{:db/id #edb/ref 17592186354557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1388b042-f6a5-5728-9122-9ffa17a12761" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186351737} {:answer/id #uuid "270dbcf7-cdc2-513f-ab8b-6e3e4820b640" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186351922} {:answer/id #uuid "7d1ba640-d224-560e-a507-31e31167512d" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186352665} {:answer/id #uuid "cde4b7ff-d7f7-5bb3-83c1-196e63bd4eb6" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186353354} {:answer/id #uuid "fbc3532b-a4cf-5703-bd69-c1f96685710c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186353771}] :answer-field/correct {:db/id #edb/ref 17592186352665} :answer-field/id #uuid "2bd51fe8-4963-559a-9cc8-296b567fd612" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353888}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7c5dab49-c074-55ae-82a5-34331ee5b508" :question/math-academy-id "q-87236" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{k}{{x}^{3}},\\, & 3<x<6, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{3}^{6}\\frac{k}{{x}^{3}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{6}\\frac{k}{{x}^{3}}\\,\\text{d}x & ={\\int }_{3}^{6}k{x}^{-3}\\,\\text{d}x \\\\  & ={[-\\frac{k}{2{x}^{2}}]}_{3}^{6} \\\\  & =-\\frac{k}{72}+\\frac{k}{18} \\\\  & =\\frac{k}{24}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{k}{24}=1\\,⟹\\,k=24.\n$$"}] [{:db/id #edb/ref 17592186360757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022d673b-fe73-5da1-8708-a3a7e5646a4a" :answer/type {:db/ident :answer.type/math} :answer/value "0.0556" :db/id #edb/ref 17592186357775} {:answer/id #uuid "54310c0f-32b6-5896-b12c-3616dd83daad" :answer/type {:db/ident :answer.type/math} :answer/value "0.0656" :db/id #edb/ref 17592186358479} {:answer/id #uuid "6faedf13-8530-5c9e-8244-e2f45780f66e" :answer/type {:db/ident :answer.type/math} :answer/value "0.0466" :db/id #edb/ref 17592186358723} {:answer/id #uuid "b11d40dd-402c-50c6-9189-0873faffbf32" :answer/type {:db/ident :answer.type/math} :answer/value "0.0655" :db/id #edb/ref 17592186359289} {:answer/id #uuid "bef0b822-8f05-5d6e-99db-5ad3c0d9a92a" :answer/type {:db/ident :answer.type/math} :answer/value "0.0566" :db/id #edb/ref 17592186359422}] :answer-field/correct {:db/id #edb/ref 17592186359422} :answer-field/id #uuid "72396ab5-0293-5a00-b4d7-6c62c9bfa148" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360184}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed9cf7bd-ec59-5fb2-9e4a-bbb1076eead3" :question/math-academy-id "q-97127" :question/problem "Given $X∼\\text{Geom}(0.15),$ compute $P(X=7).$  Round your final answer to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.15),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.85)}^{x-1}(0.15), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=7) & =f(7) \\\\  & ={(0.85)}^{6}(0.15) \\\\  & ≈0.0566.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1169e5-852d-5544-8468-16696082321e" :answer/type {:db/ident :answer.type/math} :answer/value "0.2287" :db/id #edb/ref 17592186357853} {:answer/id #uuid "5822d891-5127-5d79-87f6-93ebd2d0cc13" :answer/type {:db/ident :answer.type/math} :answer/value "0.2481" :db/id #edb/ref 17592186358516} {:answer/id #uuid "7e31eb69-f028-5ff2-ab22-1b1d00adfaa7" :answer/type {:db/ident :answer.type/math} :answer/value "0.4166" :db/id #edb/ref 17592186358851} {:answer/id #uuid "92be8b10-a5ad-5000-8627-169d851892c6" :answer/type {:db/ident :answer.type/math} :answer/value "0.3004" :db/id #edb/ref 17592186359035} {:answer/id #uuid "e78b968a-3ca0-5854-9293-024e8377fcd7" :answer/type {:db/ident :answer.type/math} :answer/value "0.3258" :db/id #edb/ref 17592186359804}] :answer-field/correct {:db/id #edb/ref 17592186358516} :answer-field/id #uuid "ade7b26b-b2cd-5734-8dc5-4befa7539429" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360300}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a90f56db-3bf1-5904-b2af-586397c0fc70" :question/math-academy-id "q-97155" :question/problem "Given that $X∼\\text{Geom}(0.23),$ compute $P(3<X<7)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.23),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.77)}^{x-1}(0.23), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3<X<7) & =P(X\\in \\{4,5,6\\}) \\\\  & =P(X=4)+P(X=5)+P(X=6) \\\\  & =f(4)+f(5)+f(6) \\\\  & ={(0.77)}^{3}(0.23)+{(0.77)}^{4}(0.23)+{(0.77)}^{5}(0.23) \\\\  & ≈0.2481.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34173332-1136-51d2-ad93-db9a5f0081d6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186361066} {:answer/id #uuid "39b179d3-adc5-52f1-9971-aeb3689d65e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186361099} {:answer/id #uuid "6fded49b-49d5-5c26-843c-cbd878559ab6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186361333} {:answer/id #uuid "b34e9597-e0e0-563c-8baf-9c56f04d22d7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361634} {:answer/id #uuid "c8a3bfd1-3853-55dd-bb31-f2042e3f4297" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186361743}] :answer-field/correct {:db/id #edb/ref 17592186361333} :answer-field/id #uuid "04aab6fa-9c89-5b73-9ae9-58f17e202d24" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361984}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91708f0d-366e-5441-a87d-7b80b150a761" :question/math-academy-id "q-99961" :question/problem "For the piecewise function \n\n$$\nf(x)=\\{\\begin{aligned}-x\\, & \\text{ for }\\,x\\le -1 \\\\ x+c\\, & \\text{ for }\\,x>-1\\end{aligned}\n$$\n\nit is known that $\\lim_{x\\to -1}f(x)=1.$ What is the value of the constant $c?$" :question/worked-solution "In order for $\\lim_{x\\to -1}f(x)$ to be equal to $1,$ the left and right-sided limits must both exist and be equal to $1.$\n\n- Approaching from the left, we have $x<-1,$ so we use the expression $f(x)=-x.$ We get \n\n$$\n\\begin{aligned}\\lim_{x\\to (-1)^{-}}f(x) & =\\lim_{x\\to (-1)^{-}}(-x) \\\\  & =-(-1) \\\\  & =1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>-1,$ so we use the expression $f(x)=x+c.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1)^{+}}f(x) & =\\lim_{x\\to (-1)^{+}}(x+c) \\\\  & =-1+c.\\end{aligned}\n$$\n\nFinally, since the left and right-sided limits must be equal, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1)^{-}}f(x) & =\\lim_{x\\to (-1)^{+}}f(x) \\\\ 1 & =-1+c \\\\ c & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfe45e96-b6f2-5280-bd02-15325098a1c4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469032} {:answer/id #uuid "d1208062-b192-5bb7-a768-32fe16db1321" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469033}] :answer-field/correct {:db/id #edb/ref 17592186469032} :answer-field/id #uuid "01a567c0-0023-5025-af7d-e7a0249210c8" :answer-field/key "$\\text{Ker}(T)=\\{0\\}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470128} {:answer-field/choices [{:answer/id #uuid "e99694d5-15bf-5e3c-9954-8af1c80b4a01" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469034} {:answer/id #uuid "427ca074-860f-5ae5-b4a1-3f89a485e8d7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469035}] :answer-field/correct {:db/id #edb/ref 17592186469034} :answer-field/id #uuid "338eec5c-2406-5f0c-bb1c-c1531ce433f3" :answer-field/key "$T$ is invertible" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470129} {:answer-field/choices [{:answer/id #uuid "64b50964-d370-5d75-8291-5c06aa29eca9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469036} {:answer/id #uuid "7af62786-7b5e-59ed-ad41-57aa0b2131b5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469037}] :answer-field/correct {:db/id #edb/ref 17592186469037} :answer-field/id #uuid "912585d5-f1a5-5f2d-97a9-471dd9c27ba3" :answer-field/key "$\\text{nullity}(T)>0$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470130}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e3fcd83b-c9bf-54f3-97b2-1811800f0c15" :question/math-academy-id "q-38889" :question/problem "Let $T:{R}^{7}\\to {R}^{7}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If ${v}_{1}\\ne {v}_{2}$ vectors such that $T({v}_{1})=T({v}_{2})$, then $\\underline{\\phantom{xxxxxx}}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{7}$ into ${R}^{7},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $$\n\\displaystyle \\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{7} \\\\  & \\text{rank}(T)=7 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}\n$$\n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)=\\{0\\}$ is false. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement “$T$ is invertible” is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne \\{0\\},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement $\\text{nullity}(T)>0$ is true. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$ In turn, this means that $\\text{nullity}(T)>0.$\n\nTherefore, the correct answer is $\\text{nullity}(T)>0$ only."}] [{:db/id #edb/ref 17592186367401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94618c21-daef-5d27-8916-8b8df06c291f" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186367403} {:answer/id #uuid "88c18ef9-7f93-5e4c-b9fd-b97b7485d3e8" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186367404} {:answer/id #uuid "9ef2185f-debf-5b5e-8362-05b053e5bc07" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186367405} {:answer/id #uuid "f9e34810-9b3d-5d4f-83a6-4a0b90696571" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186367406} {:answer/id #uuid "6b920b35-d339-54f2-a2bf-d2c62663c24d" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186367407}] :answer-field/correct {:db/id #edb/ref 17592186367403} :answer-field/id #uuid "65636130-3bf1-526c-8381-5096a3678036" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367402}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "202fd2eb-e19f-5709-853f-f9d1b66aa054" :question/math-academy-id "q-131652" :question/problem "Find \n$$\n\\displaystyle \\begin{vmatrix}8 & 0 & 0 \\\\ 1 & 3q & -6 \\\\ 3 & 2 & p\\end{vmatrix}\n$$\ngiven that \n$$\n\\displaystyle \\begin{vmatrix}3q & -6 \\\\ 2 & p\\end{vmatrix}=-5.\n$$" :question/worked-solution "Notice that we have  a block lower triangular matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}8 & 0 & 0 \\\\ 1 & 3q & -6 \\\\ 3 & 2 & p\\end{vmatrix} & =|\\begin{array}{c|cc}8 & 0 & 0 \\\\ \\hline 1 & 3q & -6 \\\\ 3 & 2 & p\\end{array}| \\\\  & =8\\cdot \\begin{vmatrix}3q & -6 \\\\ 2 & p\\end{vmatrix} \\\\  & =8\\cdot (-5) \\\\  & =-40\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3408d4-a725-5d6f-bde0-abc3ae80fdc6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186367410} {:answer/id #uuid "ed7fc879-743b-5ccd-826c-8a8e50e4331f" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186367411} {:answer/id #uuid "7eb5ba69-b80e-5c06-9383-c6d1bb73a13c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186367412} {:answer/id #uuid "f30939c8-05f0-5c5f-b9bf-a14dce8624d7" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186367413} {:answer/id #uuid "c4ad03eb-217d-5549-b04c-fbe6caa17772" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186367414}] :answer-field/correct {:db/id #edb/ref 17592186367410} :answer-field/id #uuid "be6aa0ff-ec0d-58f5-b91b-35aaf2d39bab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367409}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fcb154ec-04b4-53f4-bb0d-67f9c8aa5c85" :question/math-academy-id "q-131655" :question/problem "Find $$\n\\displaystyle \\,\\begin{vmatrix}p & 2 & 0 & 0 \\\\ 5 & q & 5 & 0 \\\\ 8 & 0 & 3 & 0 \\\\ r & 0 & 0 & \\frac{2}{3}\\end{vmatrix}\n$$ given that $$\n\\displaystyle \\,\\begin{vmatrix}p & 2 & 0 \\\\ 5 & q & 5 \\\\ 8 & 0 & 3\\end{vmatrix}=12.\n$$" :question/worked-solution "Notice that we have  a block lower triangular matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}p & 2 & 0 & 0 \\\\ 5 & q & 5 & 0 \\\\ 8 & 0 & 3 & 0 \\\\ r & 0 & 0 & \\frac{2}{3}\\end{vmatrix} & =|\\begin{array}{ccc|c}p & 2 & 0 & 0 \\\\ 5 & q & 5 & 0 \\\\ 8 & 0 & 3 & 0 \\\\ \\hline r & 0 & 0 & \\frac{2}{3}\\end{array}| \\\\  & =\\begin{vmatrix}p & 2 & 0 \\\\ 5 & q & 5 \\\\ 8 & 0 & 3\\end{vmatrix}\\cdot \\frac{2}{3} \\\\  & =12\\cdot \\frac{2}{3} \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42cf5542-0289-5dec-a071-29770b99b3eb" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186367973} {:answer/id #uuid "b0d368b0-3fe5-5821-a75b-cb36898eadc4" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186367974} {:answer/id #uuid "1f3e4090-3023-5287-89a3-493d5d621214" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186367975} {:answer/id #uuid "e2d8a4d5-ef76-50e4-a75e-2bf24eedd773" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186367976} {:answer/id #uuid "f8eace11-55fe-5542-9c70-079f9177d0e6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186367977}] :answer-field/correct {:db/id #edb/ref 17592186367975} :answer-field/id #uuid "d8b04c9b-a297-56c0-bc58-cb471f7a2a39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367972}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89791f16-1e44-5ecb-98bd-8a1b36242eee" :question/math-academy-id "q-32172" :question/problem "Find \n$$\n\\displaystyle \\begin{vmatrix}-3 & b & 0 \\\\ d & 2 & 0 \\\\ 0 & 0 & -4\\end{vmatrix}\n$$\ngiven that \n$$\n\\displaystyle \\begin{vmatrix}-3 & b \\\\ d & 2\\end{vmatrix}=-7.\n$$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-3 & b & 0 \\\\ d & 2 & 0 \\\\ 0 & 0 & -4\\end{vmatrix} & =|\\begin{array}{cc|c}-3 & b & 0 \\\\ d & 2 & 0 \\\\ \\hline 0 & 0 & -4\\end{array}| \\\\  & =\\begin{vmatrix}-3 & b \\\\ d & 2\\end{vmatrix}\\cdot (-4) \\\\  & =(-7)\\cdot (-4) \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186371569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58338181-f5f2-53c4-ba2c-1eea5f78b0ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186371571} {:answer/id #uuid "51c241d2-b827-5429-8bbc-12cb2e50febb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186371572} {:answer/id #uuid "08d78c40-67ca-5552-bfbc-85ea24759319" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186371573} {:answer/id #uuid "6cfd8f25-4f0e-55fd-8077-79f56797ab4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186371574} {:answer/id #uuid "94df0702-4a0f-564a-b2f1-d0fd90b62b07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186371575}] :answer-field/correct {:db/id #edb/ref 17592186371571} :answer-field/id #uuid "63d8ef8e-e282-5085-bd0c-37645c87d08b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "821858ee-46eb-57a4-9f6b-cec1ae6e7ca5" :question/math-academy-id "q-111251" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{3},\\, & 0\\le x\\le 3,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind $P(Y<X<Y+2).$" :question/worked-solution "If $f(x,y)$ is a joint probability density function for the random variables $X$ and $Y$ and $A⊂{R}^{2},$ then\n\n$$\nP((X,Y)\\in A)={∬}_{A}f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nNotice that $f(x,y)$ is nonnegative in the region $D=[0,3]\\times [0,1],$ and the event $A=\\{Y<X<Y+2\\}$ corresponds to a subset of $D,$ shown as the shaded region below:\n\n![](images/f4/f4a0cc357eee835c84ef08524d27e3c30b98d58e1b6b5083b7df6a66ce987b6b.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(Y<X<Y+2) & ={∬}_{A}f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{A}\\frac{1}{3}\\,\\text{d}x\\text{d}y \\\\  & =\\frac{1}{3}\\text{Area}(A) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186375031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dcce98c-8760-56f2-b17b-5fd945b150e4" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186375033}] :answer-field/correct {:db/id #edb/ref 17592186375033} :answer-field/id #uuid "948a4c6b-6866-5b53-840b-620e511c4ece" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375032}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae903844-3154-5fe9-a420-6a9e8272ce91" :question/math-academy-id "q-343366" :question/problem "$$\nF(x)=\\{\\begin{aligned}{x}^{2}-26, & x\\in [-5,0) \\\\ -3x, & x\\in [0,5)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $10$-periodic extension $f(x)$ of $F(x)$ converges when $x=5.$\n\nThe Fourier series converges to {{field-1}} when $x=5.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $10$-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=5.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(5) & =\\lim_{x\\to {5}^{-}}f(x)=-3(5)=-15 \\\\ {f}^{+}(5) & =\\lim_{x\\to {5}^{+}}f(x)={5}^{2}-26=-1\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}(5)+{f}^{+}(5)}{2}=\\frac{-15+(-1)}{2}=-8.\n$$"}] [{:db/id #edb/ref 17592186375034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb5a35bc-6e98-5466-b248-220b58805210" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375036}] :answer-field/correct {:db/id #edb/ref 17592186375036} :answer-field/id #uuid "73e9342f-7d4b-572d-ae06-c85b2c42d4ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375035}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8508b9f1-644b-5b60-9272-323a48701a7e" :question/math-academy-id "q-343367" :question/problem "$$\nF(x)=\\{\\begin{aligned}2, & x\\in [-\\pi ,0) \\\\ \\operatorname{sin}⁡x, & x\\in [0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ converges when $x=\\pi .$\n\nThe Fourier series converges to {{field-1}} when $x=\\pi .$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $2\\pi $-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=\\pi .$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(\\pi ) & =\\lim_{x\\to {\\pi }^{-}}f(x)=\\operatorname{sin}⁡\\pi =0 \\\\ {f}^{+}(\\pi ) & =\\lim_{x\\to {\\pi }^{+}}f(x)=2\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}(\\pi )+{f}^{+}(\\pi )}{2}=\\frac{0+2}{2}=1.\n$$"}] [{:db/id #edb/ref 17592186375055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2acba6b-85a0-5271-998e-5cb3d652c89e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186375057}] :answer-field/correct {:db/id #edb/ref 17592186375057} :answer-field/id #uuid "05225483-6672-597f-a26b-7bc809c08b7c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375056}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a441f1e0-bba8-5858-84bf-38b79256c3c4" :question/math-academy-id "q-343451" :question/problem "$$\nF(x)=\\{\\begin{aligned}-4, & x\\in [-\\frac{\\pi }{2},0) \\\\ 2\\operatorname{sin}⁡x, & x\\in [0,\\frac{\\pi }{2})\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $\\pi $-periodic extension $f(x)$ of $F(x)$ converges when $x=\\frac{\\pi }{2}.$\n\nThe Fourier series converges to {{field-1}} when $x=\\frac{\\pi }{2}.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $\\pi $-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=\\frac{\\pi }{2}.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}\\,\\left(\\frac{\\pi }{2}\\right) & =\\lim_{x\\to (\\pi /2)^{-}}f(x)=2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)=2 \\\\ {f}^{+}\\,\\left(\\frac{\\pi }{2}\\right) & =\\lim_{x\\to (\\pi /2)^{+}}f(x)=-4\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}\\,\\left(\\frac{\\pi }{2}\\right)+{f}^{+}\\,\\left(\\frac{\\pi }{2}\\right)}{2}=\\frac{2+(-4)}{2}=-1.\n$$"}] [{:db/id #edb/ref 17592186379568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acc20d32-5af1-5435-abc5-4668ce0e44f2" :answer/type {:db/ident :answer.type/math} :answer/value "|-{x}^{2}-4x+9|" :db/id #edb/ref 17592186379570} {:answer/id #uuid "75a227c8-8086-59dd-be4b-fc392dab1a1f" :answer/type {:db/ident :answer.type/math} :answer/value "|x{|}^{2}-4|x|-9" :db/id #edb/ref 17592186379571} {:answer/id #uuid "ebe30399-f024-50fa-99cc-49507726732c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+4x+9" :db/id #edb/ref 17592186379572} {:answer/id #uuid "7624e34c-bc9a-5db4-b2f9-1e263ec50973" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{2}+4x+9" :db/id #edb/ref 17592186379573} {:answer/id #uuid "a4eb5fc9-b49d-5069-afff-7884f7f94646" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{2}-4x+9" :db/id #edb/ref 17592186379574}] :answer-field/correct {:db/id #edb/ref 17592186379573} :answer-field/id #uuid "4211b349-1586-553e-b79d-b35e6c14641e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379569}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f55ac59a-df5b-57d9-8289-eba696ad592d" :question/math-academy-id "q-340863" :question/problem "Let $F(x)={x}^{2}+4x-9$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{2}+4(-x)-9) \\\\  & =-({x}^{2}-4x-9) \\\\  & =-{x}^{2}+4x+9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "669c79c2-1922-5d4f-8294-a85dd5e7d7f3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186379597}] :answer-field/correct {:db/id #edb/ref 17592186379597} :answer-field/id #uuid "62443fee-fe96-5815-bb89-8967be450b9e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379596}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0188791e-a7fa-5d1c-b905-419c47766caf" :question/math-academy-id "q-341203" :question/problem "Let $F(x)={x}^{2}-6x$ for $x\\in [0,12),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-12,12).$ What is the value of $f(-4)?$\n\n$f(-4)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,12),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,12), \\\\ -F(-x), & x\\in (-12,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-12,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{2}-6(-x)) \\\\  & =-({x}^{2}+6x) \\\\  & =-{x}^{2}-6x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-4) & =-(-4)^{2}-6(-4)=8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186380838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87cd12d0-6a34-5d69-a052-37dd7b665fa1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470997} {:answer/id #uuid "2a5c113f-8f85-54df-a191-e6a260a622ec" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470998}] :answer-field/correct {:db/id #edb/ref 17592186470998} :answer-field/id #uuid "a053ccd6-a515-5e7f-a170-df59bdc9e410" :answer-field/key "$\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472004} {:answer-field/choices [{:answer/id #uuid "499f94a8-9207-510d-9baa-5720b20b1c07" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470999} {:answer/id #uuid "92e04b93-9fab-5c61-a3ba-0482b966ebc3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471000}] :answer-field/correct {:db/id #edb/ref 17592186470999} :answer-field/id #uuid "82cef237-2c86-5e8e-8666-abbf572a6632" :answer-field/key "$\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472005} {:answer-field/choices [{:answer/id #uuid "d53fcefd-cbee-5163-8861-b3c676aacc68" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471001} {:answer/id #uuid "7b636524-5e3f-5180-98df-969975052f6d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471002}] :answer-field/correct {:db/id #edb/ref 17592186471001} :answer-field/id #uuid "f4a80c0b-1724-53b6-833f-dcb16e1b056b" :answer-field/key "$\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472006} {:answer-field/choices [{:answer/id #uuid "e7106e71-52be-5893-82b1-9e36228a4c18" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669025} {:answer/id #uuid "53852ab1-fede-5949-8059-bba9c3a18ad3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669026}] :answer-field/correct {:db/id #edb/ref 17592186669025} :answer-field/id #uuid "eed5bffe-abd6-5649-ac3a-499589455194" :answer-field/key "None of the above" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669312}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d32f310d-7c80-57bd-8ae7-821e89abc170" :question/math-academy-id "q-129901" :question/problem "![](images/e2/e2ded513c72c8029b7d2909d2e3b37cbd659c4ba60a7be72c81379626a7a1234.png)\n\nConsider the region $D$ shown above. If $R=[-1,2]\\times [-1,3],$ and\n\n$$\n{∬}_{D}{e}^{x}\\operatorname{cos}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/77/77c8e1b1aacd29c6d69aa3c641c1641f43ff2aa1467dc713d417641f8b76b066.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${e}^{x}\\operatorname{cos}⁡y$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}{e}^{x}\\operatorname{cos}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions $$\n\\displaystyle \\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}\n$$ and $$\n\\displaystyle \\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}.\n$$ Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,3)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function $$\n\\displaystyle \\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ equals ${e}^{x}\\operatorname{cos}⁡y$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is $$\n\\displaystyle \\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ only."}] [{:db/id #edb/ref 17592186380845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84e6ca1c-985b-57a6-bbdc-cfcae76d35e1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471003} {:answer/id #uuid "d9d90adc-d8e3-5eed-84c7-910312448f23" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471004}] :answer-field/correct {:db/id #edb/ref 17592186471004} :answer-field/id #uuid "7bf10497-649d-5202-b23e-b273af7bee99" :answer-field/key "$\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472007} {:answer-field/choices [{:answer/id #uuid "98097f2b-9e49-5e27-80f9-f06bc14aab86" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471005} {:answer/id #uuid "fce61fa5-c452-5372-a5c0-cfe94d4a20f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471006}] :answer-field/correct {:db/id #edb/ref 17592186471006} :answer-field/id #uuid "f4b2628b-6aa3-5ec7-8908-353c28bcb1e4" :answer-field/key "$\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472008} {:answer-field/choices [{:answer/id #uuid "b103412c-5b4e-56d0-9003-8a8ec8267e02" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471007} {:answer/id #uuid "a577d434-9c09-55d1-b36d-57e46a052ed5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471008}] :answer-field/correct {:db/id #edb/ref 17592186471007} :answer-field/id #uuid "59c48db3-67b1-567b-8a55-234d3dd131bd" :answer-field/key "$\\{\\begin{aligned}0, & (x,y)\\in D \\\\ y{e}^{x+y}, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472009}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a021db95-99b8-59d4-be5a-36dd8114ebe0" :question/math-academy-id "q-129907" :question/problem "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1.$ If $R=[-3,3]\\times [-2,2],$ and\n\n$$\n{∬}_{D}y{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/38/38c44f897999039f88df2c3e549a1229ec9f9a979bbc83dfe1a5d7279701450d.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $y{e}^{x+y}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}y{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions $$\n\\displaystyle \\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}\n$$ and $$\n\\displaystyle \\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ equal $y{e}^{x+y}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function $$\n\\displaystyle \\{\\begin{aligned}0, & (x,y)\\in D \\\\ y{e}^{x+y}, & (x,y)\\in R∖D\\end{aligned}.\n$$ The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(3,2)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is $$\n\\displaystyle \\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned};\n$$ $$\n\\displaystyle \\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$ only."}] [{:db/id #edb/ref 17592186380887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7ca0fab-075f-5734-9404-a0116b2b5481" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S\\cup U}(\\sqrt{xy}+{x}^{2}+{y}^{2})\\,\\text{d}A" :db/id #edb/ref 17592186380889} {:answer/id #uuid "65875c7d-3c02-56d4-92cd-11bf2395175e" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\sqrt{xy}\\,\\text{d}A+{∬}_{U}({x}^{2}+{y}^{2})\\,\\text{d}A" :db/id #edb/ref 17592186380890} {:answer/id #uuid "e0651f3a-2e5d-5164-a133-6b270af1e639" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\sqrt{xy}\\,\\text{d}A+{∬}_{T}({x}^{2}+{y}^{2})\\,\\text{d}A" :db/id #edb/ref 17592186380891} {:answer/id #uuid "2dd6a7f4-7b19-555f-b262-2eb0eacf2344" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S\\cup U}\\sqrt{xy}({x}^{2}+{y}^{2})\\,\\text{d}A" :db/id #edb/ref 17592186380892} {:answer/id #uuid "edf299a8-ceef-5a1c-956d-ec8ef1c226fd" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\sqrt{xy}\\,\\text{d}A+{∬}_{T}\\,\\text{d}A+{∬}_{U}({x}^{2}+{y}^{2})\\,\\text{d}A" :db/id #edb/ref 17592186380893}] :answer-field/correct {:db/id #edb/ref 17592186380890} :answer-field/id #uuid "75a5c930-1ca9-58b5-8264-1a5886ebc360" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380888}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8a2d9ca-ceb2-572b-acd2-d44a9e37ec8c" :question/math-academy-id "q-130022" :question/problem "![](images/aa/aae6528f576b58fb5cea5238a921074d2176f9e9c9e6fc0ba3e98bc2f647e133.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\sqrt{xy}, & (x,y)\\in S, \\\\ 0, & (x,y)\\in T, \\\\ {x}^{2}+{y}^{2}, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}\\sqrt{xy}\\,\\text{d}A+{∬}_{T}0\\,\\text{d}A+{∬}_{U}({x}^{2}+{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{S}\\sqrt{xy}\\,\\text{d}A+{∬}_{U}({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186380894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2e15614-cf10-5035-a3e9-1e74b5a8b0de" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S\\cup T}(\\frac{x}{y}+{x}^{2}-x{y}^{3})\\text{d}A" :db/id #edb/ref 17592186380896} {:answer/id #uuid "d9b88361-c3e7-5541-acf8-ca9ffbbb62e2" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S\\cup T}\\frac{x}{y}({x}^{2}-x{y}^{3})\\,\\text{d}A" :db/id #edb/ref 17592186380897} {:answer/id #uuid "180eeba2-deb2-5cf1-b167-3418a77c6df3" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{U}({x}^{2}-x{y}^{3})\\,\\text{d}A" :db/id #edb/ref 17592186380898} {:answer/id #uuid "92d66543-c3a6-5f98-bd86-be2ec63d6e7a" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A+{∬}_{U}\\,\\text{d}A" :db/id #edb/ref 17592186380899} {:answer/id #uuid "5e937bea-7600-5aff-bb43-6733c9d40198" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A" :db/id #edb/ref 17592186380900}] :answer-field/correct {:db/id #edb/ref 17592186380900} :answer-field/id #uuid "e64f7bef-5384-5c7a-9b11-57463fc18d7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380895}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9798be4b-01fe-51e0-b1bf-171e60296bfd" :question/math-academy-id "q-130023" :question/problem "![](images/e5/e50797d61a59cf8533e86695c03da168bff7e59ce363e0ee42bb700de515385f.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{x}{y}, & (x,y)\\in S, \\\\ {x}^{2}-x{y}^{3}, & (x,y)\\in T, \\\\ 0, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A+{∬}_{U}0\\,\\text{d}A \\\\  & ={∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186380901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7db9ae6-022f-576a-8519-7658f21f3c1c" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}{e}^{x+y}\\,\\text{d}A" :db/id #edb/ref 17592186380903} {:answer/id #uuid "02402e02-1c0d-5866-945c-89ed5fcb73d8" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A" :db/id #edb/ref 17592186380904} {:answer/id #uuid "cf442e6d-ef62-56e6-b29f-779c57161862" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}{e}^{x+y}\\,\\text{d}A+{∬}_{U}y\\operatorname{cos}⁡x\\,\\text{d}A" :db/id #edb/ref 17592186380905} {:answer/id #uuid "cf6d7190-82e1-5ea8-9682-d27614c71d44" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A" :db/id #edb/ref 17592186380906} {:answer/id #uuid "1a6d80d9-2c44-5055-a96b-4b1146cdd341" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}{e}^{x+y}\\,\\text{d}A+{∬}_{U}\\,\\text{d}A" :db/id #edb/ref 17592186380907}] :answer-field/correct {:db/id #edb/ref 17592186380904} :answer-field/id #uuid "5e73b362-62bb-5798-aa2e-4d6f0042c275" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380902}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09109a55-6e5b-5bb8-a3bc-8b73ba148056" :question/math-academy-id "q-130025" :question/problem "![](images/dd/ddc6c02aff017b31dd24ba6d47a3527aa46a2a5130cffc7094122545babd7656.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}y\\operatorname{cos}⁡x, & (x,y)\\in S, \\\\ 0, & (x,y)\\in T, \\\\ {e}^{x+y}, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}0\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A \\\\  & ={∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6a14e7a-b747-5daa-a6d8-ddf27bcb3435" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454054} {:answer/id #uuid "ef203a18-6200-50a4-8f37-40f6d775a047" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454055}] :answer-field/correct {:db/id #edb/ref 17592186454054} :answer-field/id #uuid "368e434e-c352-5632-8222-8c74717eb1e3" :answer-field/key "${∬}_{R}{e}^{x+y}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,2]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454777} {:answer-field/choices [{:answer/id #uuid "89d2bcf1-e624-5732-9da9-f26392281661" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454056} {:answer/id #uuid "65454c69-ffda-5315-a369-0369fd32aa73" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454057}] :answer-field/correct {:db/id #edb/ref 17592186454057} :answer-field/id #uuid "1998fa1f-9db2-528c-8a77-26d7fb35e77f" :answer-field/key "${∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454778} {:answer-field/choices [{:answer/id #uuid "8a0139cb-9ef6-5b37-92da-cfe05b47fe33" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454058} {:answer/id #uuid "03dcd1c2-23f1-50a4-923d-5b396bf94b6c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454059}] :answer-field/correct {:db/id #edb/ref 17592186454059} :answer-field/id #uuid "5fd599f9-74b2-5a43-9569-f24f6afb0be6" :answer-field/key "${∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-3,3]$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454779}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "47830ab2-2bae-52c6-8c9c-df89a69a6369" :question/math-academy-id "q-80536" :question/problem "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D:$\n\n![](images/5c/5c5dbc673c2c6a9bd0a4f06223133e21e2dcbbdbaa2dfe2de2b29d8824dd821e.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “$$\n\\displaystyle {∬}_{R}{e}^{x+y}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-2,2]$” is false. The rectangle $R$ does not cover the region $D.$ Also, the integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statements “$$\n\\displaystyle {∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-2,2]\\times [-3,3]$” and “$$\n\\displaystyle {∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-3,3]$” are true. In both cases, the rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is “$$\n\\displaystyle {∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-2,2]\\times [-3,3]$”; “$$\n\\displaystyle {∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,\n$$ where $R=[-3,3]\\times [-3,3]$” only."}] [{:db/id #edb/ref 17592186382455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab529760-3889-51a8-b4c8-66bfbf77c410" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{T}(\\sqrt[3]{x}y-\\sqrt[3]{y})\\,\\text{d}A+{∬}_{U}2x{y}^{3}\\,\\text{d}A" :db/id #edb/ref 17592186382457} {:answer/id #uuid "2325dd1a-ce3d-54f1-afa1-cd4830f6be26" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\sqrt[3]{x}\\text{ }\\text{d}A-{∬}_{T}y\\sqrt[3]{y}\\text{ }\\text{d}A+{∬}_{T}2x{y}^{3}\\,\\text{d}A" :db/id #edb/ref 17592186382458} {:answer/id #uuid "e9526d42-7973-5cd9-a423-f18f92adf041" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}(\\sqrt[3]{x}y-\\sqrt[3]{y})\\,\\text{d}A+{∬}_{T}2x{y}^{3}\\,\\text{d}A" :db/id #edb/ref 17592186382459} {:answer/id #uuid "a1c99a0e-5c23-54ec-aa7b-84c58c6240f1" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}(\\sqrt[3]{x}y-\\sqrt[3]{y})\\,\\text{d}A+{∬}_{U}2x{y}^{3}\\,\\text{d}A" :db/id #edb/ref 17592186382460} {:answer/id #uuid "2b4d8952-e530-5523-a7fc-b0dd32bd0156" :answer/type {:db/ident :answer.type/math} :answer/value "{∬}_{S}\\sqrt[3]{x}y\\text{ }\\text{d}A-{∬}_{T}\\sqrt[3]{y}\\text{ }\\text{d}A+{∬}_{T}2x{y}^{3}\\,\\text{d}A" :db/id #edb/ref 17592186382461}] :answer-field/correct {:db/id #edb/ref 17592186382459} :answer-field/id #uuid "9d9e42d1-446a-551f-9c15-70d2ade4d9dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382456}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6c01f4d5-f15d-5491-b498-84e3a762539b" :question/math-academy-id "q-81248" :question/problem "![](images/20/208f19ed915ad8db5f818636fe7b5d6f525487039195281346fc301a79638a6d.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\sqrt[3]{x}y-\\sqrt[3]{y}, & (x,y)\\in S, \\\\ 2x{y}^{3}, & (x,y)\\in T, \\\\ 0, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}(\\sqrt[3]{x}y-\\sqrt[3]{y})\\,\\text{d}A+{∬}_{T}2x{y}^{3}\\,\\text{d}A+{∬}_{U}0\\,\\text{d}A \\\\  & ={∬}_{S}(\\sqrt[3]{x}y-\\sqrt[3]{y})\\,\\text{d}A+{∬}_{T}2x{y}^{3}\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424c1725-f6be-557b-8ba1-de6cd2c48a82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186382464} {:answer/id #uuid "ad38cb99-0e64-5f96-baca-e7d0549cba5a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382465} {:answer/id #uuid "1e089d84-f069-5f2c-83fa-ebc8d830878a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382466} {:answer/id #uuid "c6fc8d95-fed9-543b-84f8-e46cb703d09b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186382467} {:answer/id #uuid "9f1aadd1-ba01-5e68-a02a-c2ed4e7c1f65" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382468}] :answer-field/correct {:db/id #edb/ref 17592186382465} :answer-field/id #uuid "d86e0dfb-0f1e-5397-8c0c-93b6e0bbf141" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382463}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "265058e2-39b1-59f9-b955-fd7951910713" :question/math-academy-id "q-81253" :question/problem "Evaluate the double integral $$\n\\displaystyle {∬}_{R}f(x,y)\\,\\text{d}A,\n$$ where\n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{cos}⁡y,\\, & \\text{if}\\,-1<x<1,\\,0<y<\\pi , \\\\ x\\operatorname{sin}⁡y,\\, & \\text{if}\\,1<x<2,\\,0<y<\\pi ,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(-1,1)\\times (0,\\pi )$ and ${R}_{2}=(1,2)\\times (0,\\pi ).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}\\operatorname{cos}⁡y\\,\\text{d}A+{∬}_{{R}_{2}}x\\operatorname{sin}⁡y\\,\\text{d}A \\\\  & =(1-(-1)){\\int }_{0}^{\\pi }\\operatorname{cos}⁡y\\,\\text{d}y+({\\int }_{1}^{2}x\\,\\text{d}x)({\\int }_{0}^{\\pi }\\operatorname{sin}⁡y\\,\\text{d}y) \\\\  & =2[\\operatorname{sin}⁡y]_{0}^{\\pi }+[\\frac{{x}^{2}}{2}]_{1}^{2}\\cdot [-\\operatorname{cos}⁡y]_{0}^{\\pi } \\\\  & =2(0)+(2-\\frac{1}{2})\\cdot (-(-1)+1) \\\\  & =3.\\end{aligned}\n$$"}]}
