#{[{:db/id #edb/ref 17592186585083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254353e8-9c0c-5bcf-9180-96f4de47422a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186584557} {:answer/id #uuid "51120523-fa17-5ceb-ac2f-00a6061c05bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186584634} {:answer/id #uuid "7465ed96-affc-5e58-aba2-339f7d4426e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186584667} {:answer/id #uuid "b618eca1-55a3-5c99-9523-fed5d665b998" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186584786} {:answer/id #uuid "cc44d5a5-3293-56a1-91dd-a0b9a43692bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186584828}] :answer-field/correct {:db/id #edb/ref 17592186584786} :answer-field/id #uuid "05a463f1-eb55-54ab-9bea-73573998675f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89d2737a-db2c-5113-ba62-9daf05e9b52d" :question/math-academy-id "q-87230" :question/problem "Compute $P(X\\le -5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{{x}^{2}},\\, & x\\le -3, \\\\ 0,\\, & x>-3.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X\\le -5) & =P(-\\infty <X\\le -5) \\\\  & ={\\int }_{-\\infty }^{-5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-5}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{3}{x}]}_{-\\infty }^{-5} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186585109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0419a4ad-ccc4-5732-a066-b0a6fb0d7ca8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186584514} {:answer/id #uuid "1a15d695-a894-5cae-b303-09df784cf378" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186584538} {:answer/id #uuid "2cf0b60a-1b5b-5ab2-9179-fa2ff926ecc9" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186584580} {:answer/id #uuid "9e930ec7-0a1d-5449-bf40-e1808d6d62eb" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186584748} {:answer/id #uuid "eb3e7c75-d9d6-5ab1-b897-513e9093f5d2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186584879}] :answer-field/correct {:db/id #edb/ref 17592186584538} :answer-field/id #uuid "b910409b-f636-5d04-b781-8d88335088f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de37e0de-55a5-50bb-a1a2-7108ecfb8429" :question/math-academy-id "q-160462" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{k}{(4-x)^{3}},\\, & x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nIn our case, for the function $f(x)=\\frac{k}{(4-x)^{3}}$ on the interval $x\\le 2,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{2}\\frac{k}{(4-x)^{3}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{2}\\frac{k}{(4-x)^{3}}\\,\\text{d}x &=\\frac{k}{2(4-x)^{2}}\\,{|}_{-\\infty }^{2}=\\frac{k}{8}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{8}=1\\,⟹\\,k=8.\n$$"}] [{:db/id #edb/ref 17592186586548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0581d88f-47f3-53ca-ac04-8bead464f97a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{59}{56}" :db/id #edb/ref 17592186585888} {:answer/id #uuid "1eacbef4-82ac-53c3-9351-e6cf601fd528" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186585940} {:answer/id #uuid "215f616b-75f4-5da6-94e6-d94fbc0741a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{50}" :db/id #edb/ref 17592186585950} {:answer/id #uuid "4907d14c-38c4-5159-a4d9-2c654b6aa7f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{41}{28}" :db/id #edb/ref 17592186586024} {:answer/id #uuid "668d5445-92e8-5c3c-9e90-1a9f13a99723" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{60}{17}" :db/id #edb/ref 17592186586075}] :answer-field/correct {:db/id #edb/ref 17592186585888} :answer-field/id #uuid "a3088c34-5e5c-5b71-a2f4-3680156cc32b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586477}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "40438e8a-1cc8-567b-a164-3888c13ae6e3" :question/math-academy-id "q-90389" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}, & 0<x<1 \\\\ \\frac{3{x}^{2}}{14}, & 1\\le x<2\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x\n$$\n\n \n\nWe compute the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{0}^{2}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{2}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\frac{1}{2}\\,\\text{d}x+{\\int }_{1}^{2}x\\cdot \\frac{3{x}^{2}}{14}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}\\,\\text{d}x+{\\int }_{1}^{2}\\frac{3{x}^{3}}{14}\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{4}|}_{0}^{1}+{\\frac{3{x}^{4}}{56}|}_{1}^{2} \\\\  & =\\frac{1}{4}+\\frac{45}{56} \\\\  & =\\frac{59}{56}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a54e5f-e7d2-50cc-bc74-6f6a3aacdd26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186585879} {:answer/id #uuid "49047f28-bccb-50f3-a64a-e6ba7fec61ed" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186586023} {:answer/id #uuid "4cca7af5-0469-505a-925c-18d93885eae4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186586035} {:answer/id #uuid "6f37e1f7-98b9-52e5-8d04-d629b5ca19f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186586089} {:answer/id #uuid "84a2237b-483c-5e3c-817f-0014c4833546" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186586135}] :answer-field/correct {:db/id #edb/ref 17592186586135} :answer-field/id #uuid "a5d6eb1f-19ad-54f2-83d6-f4eb41339eb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f04680e-a673-559e-abe9-bb1b42386d0d" :question/math-academy-id "q-110003" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{5}, & x=1 \\\\ \\frac{1}{5}, & x=2 \\\\ \\frac{2}{5}, & x=3\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\sum }_{x\\in S}{x}^{2}\\cdot f(x).\n$$\n\nSumming up the products of each squared value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in S}{x}^{2}\\cdot f(x) \\\\  & ={1}^{2}\\cdot \\frac{2}{5}+{2}^{2}\\cdot \\frac{1}{5}+{3}^{2}\\cdot \\frac{2}{5} \\\\  & =\\frac{2}{5}+\\frac{4}{5}+\\frac{18}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b29a2d7-237c-5983-bb23-119f899d8685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}+\\frac{1}{{e}^{2}}+1" :db/id #edb/ref 17592186585998} {:answer/id #uuid "4182e594-3b1c-5594-beee-ce553851a4f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}+1" :db/id #edb/ref 17592186586008} {:answer/id #uuid "4ee7e4cb-33fe-5ce4-8989-79052f30b98e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}-\\frac{1}{e}+1" :db/id #edb/ref 17592186586038} {:answer/id #uuid "7a456eb1-0413-530a-a5f1-ba35afaa4611" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}-\\frac{1}{{e}^{2}}+1" :db/id #edb/ref 17592186586116} {:answer/id #uuid "8b0d1073-d886-50d3-9b33-1c1703cfd113" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}-\\frac{1}{{e}^{2}}-1" :db/id #edb/ref 17592186586155}] :answer-field/correct {:db/id #edb/ref 17592186586116} :answer-field/id #uuid "85468c66-9098-56d2-b860-1329bcee4fda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586454}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "70264740-af05-5406-ba9b-9a94defaec62" :question/math-academy-id "q-130881" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{ex}, & \\frac{1}{e}<x<1 \\\\ \\frac{1}{{x}^{2}}, & 1\\le x<e\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x\n$$\n\n \n\nWe compute the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{{e}^{-1}}^{e}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{{e}^{-1}}^{1}x\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{e}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{{e}^{-1}}^{1}x\\cdot \\frac{1}{ex}\\,\\text{d}x+{\\int }_{1}^{e}x\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{{e}^{-1}}^{1}\\frac{1}{e}\\,\\text{d}x+{\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x \\\\  & ={\\frac{x}{e}|}_{{e}^{-1}}^{1}+\\operatorname{ln}⁡x{|}_{1}^{e} \\\\  & =\\frac{1}{e}-\\frac{1}{{e}^{2}}+1-0 \\\\  & =\\frac{1}{e}-\\frac{1}{{e}^{2}}+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf80839-5f9a-59f3-b6c6-8394f1377d91" :answer/type {:db/ident :answer.type/math} :answer/value "1.25" :db/id #edb/ref 17592186585970} {:answer/id #uuid "376e99dd-1c9f-5daf-b4ca-63fa911fec4e" :answer/type {:db/ident :answer.type/math} :answer/value "0.78" :db/id #edb/ref 17592186585988} {:answer/id #uuid "8cefc991-bd9f-505d-ab0c-b4d63713f0b8" :answer/type {:db/ident :answer.type/math} :answer/value "1.65" :db/id #edb/ref 17592186586163} {:answer/id #uuid "a275b9b5-4725-5e5b-ad1e-2ae86e9d9be5" :answer/type {:db/ident :answer.type/math} :answer/value "1.81" :db/id #edb/ref 17592186586211} {:answer/id #uuid "be77f023-1c17-523e-ae0f-ed108ba10822" :answer/type {:db/ident :answer.type/math} :answer/value "1.13" :db/id #edb/ref 17592186586257}] :answer-field/correct {:db/id #edb/ref 17592186586211} :answer-field/id #uuid "ee945bb4-9f1d-5bd3-ae9b-e9ecfabce372" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586516}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce941b9b-782d-5931-bac1-db07d0594583" :question/math-academy-id "q-90446" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[X].$ Give your answer to two decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}}{3}, & 1<x<2 \\\\ \\frac{2}{9}, & 2\\le x<3\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x\n$$\n\n \n\nWe compute the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{3}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot \\frac{{x}^{2}}{3}\\,\\text{d}x+{\\int }_{2}^{3}x\\cdot \\frac{2}{9}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{{x}^{3}}{3}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{2x}{9}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{12}|}_{1}^{2}+{\\frac{{x}^{2}}{9}|}_{2}^{3} \\\\  & =\\frac{15}{12}+\\frac{5}{9} \\\\  & =\\frac{65}{36} \\\\  & ≈1.81,\\end{aligned}\n$$\n\n \n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186586613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "279fbbe8-62fc-5f8e-acee-f837847e4f8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186585959} {:answer/id #uuid "9e7d055b-ebd7-5d8b-9595-1471ea0c1176" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29}{6}" :db/id #edb/ref 17592186586203} {:answer/id #uuid "e9d2694a-1d0e-5701-a2ca-53700f318c21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186586340} {:answer/id #uuid "eeb23424-d542-5530-b290-2261f18cdbba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186586346} {:answer/id #uuid "f59b5534-2d2e-5d01-a8de-2852f9ed256b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{3}" :db/id #edb/ref 17592186586364}] :answer-field/correct {:db/id #edb/ref 17592186586364} :answer-field/id #uuid "83f2d81a-c391-536c-bada-c67bd96225e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586452}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec9bf528-d06e-5b2e-8331-90dacbd2d0c8" :question/math-academy-id "q-143801" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}, & x=1 \\\\ \\frac{1}{3}, & x=2 \\\\ \\frac{1}{6}, & x=3\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{3}$ is given by\n\n$$\n\\text{E}[{X}^{3}]={\\sum }_{x\\in S}{x}^{3}\\cdot f(x).\n$$\n\nSumming up the products of each cubed value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\sum }_{x\\in S}{x}^{3}\\cdot f(x) \\\\  & ={1}^{3}\\cdot \\frac{1}{2}+{2}^{3}\\cdot \\frac{1}{3}+{3}^{3}\\cdot \\frac{1}{6} \\\\  & =1\\cdot \\frac{1}{2}+8\\cdot \\frac{1}{3}+27\\cdot \\frac{1}{6} \\\\  & =\\frac{1}{2}+\\frac{8}{3}+\\frac{9}{2} \\\\  & =\\frac{23}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3669d52e-01d2-5840-8ea6-b71c35b841b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186586773} {:answer/id #uuid "7c5b9161-c842-5f60-8fd3-e9fa7484cdd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{72}{5}" :db/id #edb/ref 17592186586893} {:answer/id #uuid "9dbe1521-2059-5454-9770-9298e76bce39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{36}" :db/id #edb/ref 17592186586960} {:answer/id #uuid "b1d82734-d8c2-5b72-abb4-ce7fc44f98c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{72}" :db/id #edb/ref 17592186586991} {:answer/id #uuid "ea6ba9ff-53a6-543d-970c-da105c0838ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{72}" :db/id #edb/ref 17592186587109}] :answer-field/correct {:db/id #edb/ref 17592186586960} :answer-field/id #uuid "ecd4344b-1467-585e-857d-eef49c591f64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587267}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25a3122c-631d-534f-983b-79cf390647dd" :question/math-academy-id "q-89748" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{{x}^{2}}{144}, & 0\\le x\\le 12 \\\\ 1, & x>12,\\end{aligned}\n$$\n\nfind $P(4<X\\le 6).$" :question/worked-solution "We can perform this computation as follows:\n\n$$\n\\begin{aligned}P(4<X\\le 6) & =P(X\\le 6)-P(X\\le 4) \\\\  & =F(6)-F(4) \\\\  & =\\frac{{6}^{2}}{144}-\\frac{{4}^{2}}{144} \\\\  & =\\frac{5}{36}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c648df9-d933-525e-a4c6-37aa0e55c816" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186586717} {:answer/id #uuid "599dba62-e955-526e-931d-b5f6ecde45c0" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186586827} {:answer/id #uuid "63592343-ee5f-5ced-8354-f55c15bde9b5" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186586850} {:answer/id #uuid "7e64f3ed-14aa-5cfd-8949-d2cbcc914d3c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186586902} {:answer/id #uuid "95ce8c91-6ba8-5523-a4b9-d3ecfdf4ec6b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186586941}] :answer-field/correct {:db/id #edb/ref 17592186586902} :answer-field/id #uuid "9ddb33d5-8320-5420-8f7c-f84599dbee68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587226}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "379360cb-d369-5022-8e15-65c6f2ca6a19" :question/math-academy-id "q-213097" :question/problem "|  | $N$ | $Z$ | $Q$ |\n| --- | --- | --- | --- |\n| $N$ | $1$ | $1$ | $0$ |\n| $Z$ | $0$ | $0$ | $0$ |\n| $Q$ | $1$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{N,Z,Q\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(N,Z)$\n\nII. $(Q,Q)$\n\nIII. $(Z,Z)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(N,Z)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $N$-row and the $Z$-column.\n\n- The pair $(Q,Q)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $Q$-row and the $Q$-column.\n\n- The pair $(Z,Z)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $Z$-row and the $Z$-column.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186587320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "941f45f1-8112-5f24-aafe-14a5ba19448e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186586936}] :answer-field/correct {:db/id #edb/ref 17592186586936} :answer-field/id #uuid "15b5b913-09e5-57f4-9628-c911873caa5b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587163} {:answer-field/choices [{:answer/id #uuid "59a57448-0fd9-5684-95a8-c878c187b526" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586828}] :answer-field/correct {:db/id #edb/ref 17592186586828} :answer-field/id #uuid "1fe92805-f5fe-5073-9ddd-922baa20f55b" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587170} {:answer-field/choices [{:answer/id #uuid "bcc5b59c-3412-574d-942d-0a80735d2047" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186587012}] :answer-field/correct {:db/id #edb/ref 17592186587012} :answer-field/id #uuid "4e045632-fd64-5dfd-b9bd-057d45a4771d" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587190} {:answer-field/choices [{:answer/id #uuid "a6d2356f-3874-5027-91c9-638acbb5b960" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186586972}] :answer-field/correct {:db/id #edb/ref 17592186586972} :answer-field/id #uuid "7ed006ad-2352-507f-810d-5c19f6bae09a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587207} {:answer-field/choices [{:answer/id #uuid "72702b9a-2ea6-581f-af86-5a419d11f66d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586871}] :answer-field/correct {:db/id #edb/ref 17592186586871} :answer-field/id #uuid "c6f865ec-86d1-5b50-9294-a4de413d4a3e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587250}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "69236c45-b206-5c24-8daa-0feb5e92ca99" :question/math-academy-id "q-213119" :question/problem "Consider the sets $A=\\{-2,-1,0\\}$ and $B=\\{0,1,2\\},$ and the relation $R=\\{(x,y)\\in A\\times B\\,:\\,x=y-1\\}.$\nFill in the missing values in the adjacency matrix of the relation:\n\n|  | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $-2$ | $0$ | {{field-1}} | {{field-2}} |\n| $-1$ | {{field-3}} | $0$ | {{field-4}} |\n| $0$ | $0$ | {{field-5}} | $0$ |" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nThe relation $R$ is the set of ordered pairs $(x,y)\\in A\\times B$ with $x=y-1.$\n\nLet's consider each row in our table.\n\n- If $x=-2,$ then there is no value of $y\\in B$ that satisfies $x=y-1.$\n\n- If $x=-1,$ then the value $y=0$ satisfies $x=y-1.$ So, $R$ contains the ordered pair $(-1,0),$ and we write $1$ in the intersection of the $2$nd row and the $1$st column in the adjacency matrix.\n\n- If $x=0,$ then the value $y=1$ satisfies $x=y-1.$ So, $R$ contains the ordered pair $(0,1),$ and we write $1$ in the intersection of the $3$rd row and the $2$nd column in the adjacency matrix.\n\nAll the other cells in the matrix must be filled with zeros. Therefore, we have the following adjacency matrix:\n\n|  | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $-2$ | $0$ | $0$ | $0$ |\n| $-1$ | $1$ | $0$ | $0$ |\n| $0$ | $0$ | $1$ | $0$ |"}] [{:db/id #edb/ref 17592186587329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55219566-b147-5c91-a1ff-3a063060d37e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x/3}}{3}" :db/id #edb/ref 17592186586823} {:answer/id #uuid "5e1477f2-72a7-5436-b7e9-c317a3b5db3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x/3}}{3}" :db/id #edb/ref 17592186586840} {:answer/id #uuid "96bb5fb5-3c9b-55b4-9516-c5d8b5dc9321" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x/3}}{2}" :db/id #edb/ref 17592186586943} {:answer/id #uuid "d7227421-4f0e-50f0-afb5-2fe0b91a48ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x/3}}{2}" :db/id #edb/ref 17592186587063} {:answer/id #uuid "dc35d8f8-09fa-5b53-8c0e-7ffd234d635d" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{{e}^{2x/3}}{2}" :db/id #edb/ref 17592186587074}] :answer-field/correct {:db/id #edb/ref 17592186587063} :answer-field/id #uuid "5430940c-56d0-5eeb-b625-164bd457a5b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587193}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d413aac-5807-516c-8907-fea3b2acddc8" :question/math-academy-id "q-89730" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{{e}^{-|2x/3|}}{3},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}h(x),\\, & x<0 \\\\ 1-\\frac{{e}^{-2x/3}}{2},\\, & x\\ge 0.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t & ={\\frac{{e}^{2t/3}}{2}|}_{-\\infty }^{x} \\\\  & =\\frac{{e}^{2x/3}}{2},\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{2t/3}}{3}\\,\\text{d}t & ={\\frac{{e}^{2x/3}}{2}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t & =-{\\frac{{e}^{-2t/3}}{2}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-2x/3}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-2t/3}}{3}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-2x/3}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-2x/3}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{2x/3}}{2}, & x<0 \\\\ 1-\\frac{{e}^{-2x/3}}{2}, & x\\ge 0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576a6e67-80ad-5972-9dd3-d6de5f102dfd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586825}] :answer-field/correct {:db/id #edb/ref 17592186586825} :answer-field/id #uuid "20634ef4-a11c-5cb2-93e2-37311a2cc945" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587171} {:answer-field/choices [{:answer/id #uuid "75ce33d3-73c9-589e-a4cc-c6031a94cf5c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186586881}] :answer-field/correct {:db/id #edb/ref 17592186586881} :answer-field/id #uuid "5c831c1d-f15e-510c-b8b4-37db030c03f2" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587196} {:answer-field/choices [{:answer/id #uuid "cd66ea83-37c9-5ca2-87e4-55535ba1cd59" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186587041}] :answer-field/correct {:db/id #edb/ref 17592186587041} :answer-field/id #uuid "a00f52f4-77f1-5083-ae97-0ee474b5cbb4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587228} {:answer-field/choices [{:answer/id #uuid "c8bbd8f3-7658-58bc-82c2-bb8931321384" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186587031}] :answer-field/correct {:db/id #edb/ref 17592186587031} :answer-field/id #uuid "ac38f8dd-32ff-5fb5-83f3-c5f47b4fb6b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587236} {:answer-field/choices [{:answer/id #uuid "efd2ba7c-553a-515f-99b7-96a85203193e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186587121}] :answer-field/correct {:db/id #edb/ref 17592186587121} :answer-field/id #uuid "e3a3af6a-505a-55e3-b802-da42d8bfa908" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587258}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "babf08c4-4b7c-546d-874f-9998301f4c0b" :question/math-academy-id "q-213007" :question/problem "Consider the sets $A=\\{1,2,3\\}$ and $B=\\{∅,\\{2\\},\\{1,2\\}\\},$ and the relation $R=\\{(x,y)\\in A\\times B\\,:\\,x\\in y\\}.$\nFill in the missing values in the adjacency matrix of the relation:\n\n|  | $∅$ | $\\{2\\}$ | $\\{1,2\\}$ |\n| --- | --- | --- | --- |\n| $1$ | {{field-1}} | $0$ | {{field-2}} |\n| $2$ | $0$ | {{field-3}} | {{field-4}} |\n| $3$ | $0$ | {{field-5}} | $0$ |" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nThe relation $R$ is the set of ordered pairs $(x,y)\\in A\\times B$ with $x\\in y.$\n\nLet's consider each row in our table.\n\n- If $x=1,$ then the value $y=\\{1,2\\}$ satisfies $x\\in y.$ So, $R$ contains the ordered pair $(1,\\{1,2\\}),$ and we write $1$ in the intersection of the $1$st row and the $3$rd column in the adjacency matrix.\n\n- If $x=2,$ then the values $y=\\{2\\},\\{1,2\\}$ satisfy $x\\in y.$ So, $R$ contains the ordered pairs $(2,\\{2\\})$ and $(2,\\{1,2\\}),$ and we write $1$ in the intersection of the $2$nd row and the $2$nd column and in the intersection of the $2$nd row and the $3$rd column in the adjacency matrix.\n\n- If $x=3,$ then there is no value of $y\\in B$ that satisfies $x\\in y.$\n\nAll the other cells in the matrix must be filled with zeros. Therefore, we have the following adjacency matrix:\n\n|  | $∅$ | $\\{2\\}$ | $\\{1,2\\}$ |\n| --- | --- | --- | --- |\n| $1$ | $0$ | $0$ | $1$ |\n| $2$ | $0$ | $1$ | $1$ |\n| $3$ | $0$ | $0$ | $0$ |"}] [{:db/id #edb/ref 17592186587358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32237a0c-609e-5a49-94aa-bcc66f8efb3b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186586762} {:answer/id #uuid "5b762c25-1795-5f64-835b-417f3d2c39f6" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186586833} {:answer/id #uuid "5bb62dae-0dd7-553f-8fef-bfd8775822ed" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186586834} {:answer/id #uuid "79476be3-c708-5e9b-8fb4-afb320dfcad2" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186586884} {:answer/id #uuid "c2fe063a-b205-58b6-ac9d-bc12714ef421" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186587025}] :answer-field/correct {:db/id #edb/ref 17592186586833} :answer-field/id #uuid "a2171cea-b024-5cae-b928-cfdfab1f13d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587230}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcd5a589-bd1c-5e59-a60d-a5a67e6fcf6a" :question/math-academy-id "q-213099" :question/problem "|  | $3$ | $5$ | $7$ |\n| --- | --- | --- | --- |\n| $2$ | $1$ | $1$ | $0$ |\n| $4$ | $1$ | $0$ | $1$ |\n| $6$ | $0$ | $1$ | $0$ |\n\nThe adjacency matrix of the relation $R,$ defined over the sets $\\{2,4,6\\}$ and $\\{3,5,7\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(2,7)$\n\nII. $(6,5)$\n\nIII. $(6,3)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(2,7)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $2$-row and the $7$-column.\n\n- The pair $(6,5)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $6$-row and the $5$-column.\n\n- The pair $(6,3)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $6$-row and the $3$-column.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186587359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210ca0b8-a4ed-5d17-90b0-697a5b418079" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186586729} {:answer/id #uuid "522a582c-dd7a-538d-aea3-6a5604094492" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186586820} {:answer/id #uuid "5d9987e4-ab1d-5b70-a527-dabea56c0a44" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186586839} {:answer/id #uuid "753f7655-6fea-5433-a2db-e52f5450e4c9" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186586879} {:answer/id #uuid "86a8e5f6-dc3c-5aa3-af10-8c5e74a0ba10" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186586916}] :answer-field/correct {:db/id #edb/ref 17592186586820} :answer-field/id #uuid "a62d8cbc-5d16-5ae0-8075-e070bd42a746" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186587231}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c37d136c-f4fa-5cf3-a365-b4945e0fce86" :question/math-academy-id "q-213096" :question/problem "|  | $1$ | $4$ | $9$ |\n| --- | --- | --- | --- |\n| $1$ | $1$ | $0$ | $1$ |\n| $4$ | $1$ | $0$ | $1$ |\n| $9$ | $1$ | $1$ | $0$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{1,4,9\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(1,4)$\n\nII. $(4,9)$\n\nIII. $(9,4)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(1,4)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $1$-row and the $4$-column.\n\n- The pair $(4,9)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $4$-row and the $9$-column.\n\n- The pair $(9,4)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $9$-row and the $4$-column.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186589031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005a6c28-a9b8-5da0-946c-e90e595a643f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186588349} {:answer/id #uuid "13f61926-402b-596b-8962-8688816880bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{19}" :db/id #edb/ref 17592186588388} {:answer/id #uuid "3a93d266-3fac-56aa-a1f0-ccb5f809765e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186588465} {:answer/id #uuid "6b4e55cf-b0b7-5961-b89e-8e770fc876c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186588571} {:answer/id #uuid "a5a33036-012d-5878-885d-15402f42f6df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{19}" :db/id #edb/ref 17592186588697}] :answer-field/correct {:db/id #edb/ref 17592186588465} :answer-field/id #uuid "474a7d39-b195-5dd9-958a-f27a7269d1c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588912}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11d1bf06-89d7-5c5d-834c-2477999468d3" :question/math-academy-id "q-96812" :question/problem "Given $X∼U\\{9,10,11,…,28\\},$ compute $P(X>25).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{9,10,11,…,28\\},$ and the set $S=\\{9,10,11,…,28\\}$ has $|S|=28-9+1=20$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{20}, & x=9,10,11,…,28 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X>25$ are $26,27,28.$ There are $3$ of these items. Therefore,\n\n$$\nP(X>25)=3\\cdot \\frac{1}{20}=\\frac{3}{20}.\n$$"}] [{:db/id #edb/ref 17592186589034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0537e84a-444d-5363-bf59-829b30bd93e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186588358} {:answer/id #uuid "381903cf-5ffd-519b-b0aa-83bb36b0fde8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{27}" :db/id #edb/ref 17592186588461} {:answer/id #uuid "accf2ce1-ce4f-5032-a22c-94d4daaea89a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{27}" :db/id #edb/ref 17592186588713} {:answer/id #uuid "e0d95951-6d14-53c3-95ee-59f15314e07d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186588817} {:answer/id #uuid "f7e21385-ffea-52ac-94ce-ce722116e812" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{13}" :db/id #edb/ref 17592186588855}] :answer-field/correct {:db/id #edb/ref 17592186588713} :answer-field/id #uuid "fbabdff0-810a-5f76-a707-1fa2c088ea4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186589022}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1837fd0f-b453-598a-bac4-c7a513849bdf" :question/math-academy-id "q-96841" :question/problem "Given $X∼U\\{8,9,10,…,34\\},$ compute $P(12\\le X\\le 25).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{8,9,10,…,34\\},$ and the set $S=\\{8,9,10,…,34\\}$ has $|S|=34-8+1=27$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{27}, & x=8,9,10,…,34 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $12\\le X\\le 25$ are $12,13,14,…,25.$ There are $25-12+1=14$ of these items. Therefore,\n\n$$\nP(12\\le X\\le 25)=14\\cdot \\frac{1}{27}=\\frac{14}{27}.\n$$"}] [{:db/id #edb/ref 17592186589042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aec1a0c-0724-5839-8baf-76eaf8f2ecc5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186588366} {:answer/id #uuid "2888510c-9bb7-5e2e-84cb-ba59669e9b59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186588426} {:answer/id #uuid "8cd61fd0-2795-5e93-b67e-786b36d64d59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186588650} {:answer/id #uuid "9acda700-7880-57f4-8a4f-d29a6433dea6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{21}" :db/id #edb/ref 17592186588674} {:answer/id #uuid "cd1077dd-0b91-5a17-80b4-3712597a1dfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{21}" :db/id #edb/ref 17592186588776}] :answer-field/correct {:db/id #edb/ref 17592186588426} :answer-field/id #uuid "6ff9f006-fdd4-585b-b98b-446b974b31c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2c036ef3-87e8-5500-885c-21f613373a9a" :question/math-academy-id "q-164165" :question/problem "Given $X∼U\\{-10,-9,-8,…,10\\},$ compute $P(-3<X\\le 6).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{-10,-9,-8,…,10\\},$ and the set $S=\\{-10,-9,-8,…,10\\}$ has $|S|=10-(-10)+1=21$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{21}, & x=-10,-9,-8,…,10 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $-3<X\\le 6$ are $-2,-1,0,…,6.$ There are $6-(-2)+1=9$ of these items. Therefore,\n\n$$\nP(-3<X\\le 6)=9\\cdot \\frac{1}{21}=\\frac{3}{7}.\n$$"}] [{:db/id #edb/ref 17592186589056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc7e113-7d58-5963-8335-a5ddc160faa8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186588369} {:answer/id #uuid "1e80f60e-c6d9-5ee3-806c-41899ce47f05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186588410} {:answer/id #uuid "4b4b7de6-732f-53ef-949e-baf2baeec720" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186588497} {:answer/id #uuid "7177ed8b-b1da-54ce-b772-ca9d6a327a32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186588585} {:answer/id #uuid "f2177fe3-9ced-5f1c-9167-b35489c4a718" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186588845}] :answer-field/correct {:db/id #edb/ref 17592186588585} :answer-field/id #uuid "255782fe-fb1a-568a-9846-01530063c75c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588893}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a0ca7e7-ae0e-5770-8ff5-92bad5d7cec8" :question/math-academy-id "q-96811" :question/problem "Given $X∼U\\{2,3,4,…,11\\},$ compute $P(X\\ge 5).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{2,3,4,…,11\\},$ and the set $S=\\{2,3,4,…,11\\}$ has $|S|=11-2+1=10$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{10}, & x=2,3,4,…,11 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X\\ge 5$ are $5,6,7,…,11.$ There are $11-5+1=7$ of these items. Therefore,\n\n$$\nP(X\\ge 5)=7\\cdot \\frac{1}{10}=\\frac{7}{10}.\n$$"}] [{:db/id #edb/ref 17592186589058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "676e6ccf-aa77-5595-8b24-3975deb40f76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186588562} {:answer/id #uuid "67e42080-b309-5510-9a42-a5f99c2c03c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186588564} {:answer/id #uuid "c184b900-c8b0-5b97-989b-7ef53d85e4b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186588757} {:answer/id #uuid "d96161a8-e4aa-598c-9d26-e0df35680876" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186588799} {:answer/id #uuid "dc3a14f4-53b7-57a5-81b6-ec2ad228e169" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186588811}] :answer-field/correct {:db/id #edb/ref 17592186588564} :answer-field/id #uuid "06c04ff5-8052-5db9-80b7-a2ff4c0d14c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588871}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a8c99c9-7a18-529c-902c-34bc9b28f5a4" :question/math-academy-id "q-96837" :question/problem "Given $X∼U\\{2,3,5,6,7,8,9,10\\},$ compute $P(7<X\\le 10).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{2,3,5,6,7,8,9,10\\},$ and the set $S=\\{2,3,5,6,7,8,9,10\\}$ has $|S|=8$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{8}, & x=2,3,5,6,7,8,9,10 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ there are $3$ items $(8,9,10)$ that satisfy $7<X\\le 10.$ Therefore,\n\n$$\nP(7<X\\le 10)=3\\cdot \\frac{1}{8}=\\frac{3}{8}.\n$$"}] [{:db/id #edb/ref 17592186589076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f918c50-3432-5aa2-899b-377aa99259e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186588380} {:answer/id #uuid "5300c098-d880-5bc4-b1bf-2a7652c4341c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{11}" :db/id #edb/ref 17592186588514} {:answer/id #uuid "76a67d08-c25e-5bf1-aa72-4d7c454635b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186588597} {:answer/id #uuid "87668b5d-b33c-5e2d-b205-79d6b87938a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{13}" :db/id #edb/ref 17592186588637} {:answer/id #uuid "8a15e9c7-091c-555f-a8d2-768e15afa091" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186588641}] :answer-field/correct {:db/id #edb/ref 17592186588380} :answer-field/id #uuid "5fbe233f-f809-55bd-9fba-90404305c978" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186588930}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82a10359-526a-5654-a6b3-b353133c05b8" :question/math-academy-id "q-96774" :question/problem "Given that $X∼U\