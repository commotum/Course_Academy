571d-b7d9-c3c6838b2f49" :answer/type {:db/ident :answer.type/math} :answer/value "0.9999" :db/id #edb/ref 17592186590220} {:answer/id #uuid "8b27fc07-3306-5587-8321-1af78f42afe4" :answer/type {:db/ident :answer.type/math} :answer/value "0.7534" :db/id #edb/ref 17592186590417} {:answer/id #uuid "ba07ff3d-464f-584c-83c4-f77e26c13c37" :answer/type {:db/ident :answer.type/math} :answer/value "0.8347" :db/id #edb/ref 17592186590504} {:answer/id #uuid "cca3d597-0249-527f-80ec-3f2e3c030725" :answer/type {:db/ident :answer.type/math} :answer/value "0.8647" :db/id #edb/ref 17592186590533} {:answer/id #uuid "cf78f442-2b95-5066-b73a-b4f70859d19d" :answer/type {:db/ident :answer.type/math} :answer/value "0.7981" :db/id #edb/ref 17592186590542}] :answer-field/correct {:db/id #edb/ref 17592186590542} :answer-field/id #uuid "d083e6b6-e159-5313-9c77-b87edcfe74b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186590725}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f6a28689-89f8-5372-b9bf-fe41dab67f62" :question/math-academy-id "q-96398" :question/problem "Given that the random variable $Y∼\\text{Exp}\\left(\\frac{2}{5}\\right),$ calculate $P(Y\\le 4).$ Round your final answer to four decimal places." :question/worked-solution "An exponential random variable $Y$ with rate $\\lambda$ has the following probability density function:\n\n$$\nf(y)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda y}, & y\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nWe're given that\n\n$$\nY∼\\text{Exp}\\left(\\frac{2}{5}\\right).\n$$\n\nSo, $Y$ has the following probability density function:\n\n$$\nf(y)=\\{\\begin{aligned}\\frac{2}{5}{e}^{-2y/5}, & y\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, we can calculate $P(Y\\le 4)$ as follows:\n\n$$\n\\begin{aligned}P(Y\\le 4) & ={\\int }_{0}^{4}f(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}\\frac{2}{5}{e}^{-2y/5}\\,\\text{d}y \\\\  & =-{e}^{-2y/5}{|}_{0}^{4} \\\\  & =-{e}^{-8/5}+{e}^{0} \\\\  & ≈0.7981\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186590838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e999fe9-296c-5c45-ae03-39ed7b93e980" :answer/type {:db/ident :answer.type/math} :answer/value "0.0142" :db/id #edb/ref 17592186590228} {:answer/id #uuid "38f28e8b-e412-5e24-8a36-026808c74fa0" :answer/type {:db/ident :answer.type/math} :answer/value "0.0189" :db/id #edb/ref 17592186590289} {:answer/id #uuid "596b1803-6b6d-550a-8797-9a49fd27208c" :answer/type {:db/ident :answer.type/math} :answer/value "0.0011" :db/id #edb/ref 17592186590351} {:answer/id #uuid "9faa9612-e01f-510c-ba89-0f5e212eb0dd" :answer/type {:db/ident :answer.type/math} :answer/value "0.0025" :db/id #edb/ref 17592186590461} {:answer/id #uuid "ea79df63-f55d-5dd8-be2f-b7f63e837f8c" :answer/type {:db/ident :answer.type/math} :answer/value "0.0099" :db/id #edb/ref 17592186590596}] :answer-field/correct {:db/id #edb/ref 17592186590461} :answer-field/id #uuid "a4f372a0-1948-5872-9c02-c7188c470427" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186590701}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff9759da-993e-586a-b6fd-f929a219db2c" :question/math-academy-id "q-96340" :question/problem "Given that the random variable $X∼\\text{Exp}(3),$ calculate $P(X>2).$ Round your final answer to four decimal places." :question/worked-solution "An exponential random variable $X$ with rate $\\lambda$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nWe're given that\n\n$$\nX∼\\text{Exp}(3).\n$$\n\nSo, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}3{e}^{-3x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, we can calculate $P(X>2)$ as follows:\n\n$$\n\\begin{aligned}P(X>2) & ={\\int }_{2}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{\\infty }3{e}^{-3x}\\,\\text{d}x \\\\  & =-{e}^{-3x}{|}_{2}^{\\infty } \\\\  & ={e}^{-6} \\\\  & ≈0.0025\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f660532-8958-5f29-9061-06d637d2606d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591044} {:answer/id #uuid "29051936-f771-52d2-a3bf-d530a755fd26" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4}{3}({y}^{2}-{y}^{3}), & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591065} {:answer/id #uuid "6081af46-82aa-5917-ad37-0cfe37b5272d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1+3{y}^{2}-4{y}^{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591161} {:answer/id #uuid "df1cc697-4378-5b9c-9435-c0127315949a" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4(y-{y}^{3}), & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591425} {:answer/id #uuid "e712e8f7-3603-5cf7-9b52-df24d373ee31" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4{y}^{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591443}] :answer-field/correct {:db/id #edb/ref 17592186591161} :answer-field/id #uuid "74fa8fb4-8d3c-5f91-9bd6-d9d675ae6767" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591548}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "028a6d78-101a-542f-9ff4-83c18779ade1" :question/math-academy-id "q-142709" :question/problem "Let $X$ and $Y$ be two continuous random variables with a joint probability density function\n\n$$\nf(x,y)=3({x}^{2}+{y}^{2}),\\,0\\le y\\le x\\le 1.\n$$\n\nFind the expression for the marginal PDF ${f}_{Y}(y).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le y\\le x\\le 1\\}.$\n\n![](images/2c/2cc3b27a1f926e9f5b5fdf59a5ea01fb7e28da53c7fc01535cc590f4c315258c.png)\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{y}^{1}3({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =3{\\int }_{y}^{1}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =3{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=y}^{x=1} \\\\  & ={[{x}^{3}+3x{y}^{2}]}_{x=y}^{x=1} \\\\  & =[({1}^{3}+3\\cdot 1\\cdot {y}^{2})-({y}^{3}+3\\cdot y\\cdot {y}^{2})] \\\\  & =1+3{y}^{2}-4{y}^{3}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}1+3{y}^{2}-4{y}^{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e694d8a-0ed8-593a-b1c7-7cbe935ce0d2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3{y}^{2}}{2}, & -1\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591042} {:answer/id #uuid "3bd545bc-dca8-5d4f-9bec-a1f3a997457b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3(1-{y}^{2})}{4}, & -1\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591094} {:answer/id #uuid "3dfc46fc-2e54-5c6e-87c4-e3badf361e9b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3(1+2{y}^{2})}{10}, & -1\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591097} {:answer/id #uuid "4c7bfacb-d860-5171-9553-35d0480f67a1" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+1}{2}, & -1\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591126} {:answer/id #uuid "6f7e61b2-9de6-5f3b-8d3d-1a6fa57d5ded" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3(1+{y}^{2})}{8}, & -1\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591192}] :answer-field/correct {:db/id #edb/ref 17592186591094} :answer-field/id #uuid "6340c500-3169-5387-add0-b3a3e520080f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591539}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "13e0ad0c-a8ea-52dc-bc79-837fed5333d9" :question/math-academy-id "q-142855" :question/problem "Let $X$ and $Y$ be two continuous random variables with a joint probability density function\n\n$$\nf(x,y)=\\frac{3x}{2({y}^{2}+1)},\\,{y}^{2}\\le x\\le 1.\n$$\n\nFind the expression for the marginal PDF ${f}_{Y}(y).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,{y}^{2}\\le x\\le 1\\}.$\n\n![](images/cf/cf0c8438253a5b46a468610ca62bc17a9ce927c98045eb461291d98644241e2f.png)\n\nIn our case, the marginal density function of $Y$ for $-1\\le y\\le 1$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{{y}^{2}}^{1}\\frac{3x}{2({y}^{2}+1)}\\,\\text{d}x \\\\  & =\\frac{3}{2({y}^{2}+1)}{\\int }_{{y}^{2}}^{1}x\\,\\text{d}x \\\\  & =\\frac{3}{2({y}^{2}+1)}{[\\frac{1}{2}{x}^{2}]}_{x={y}^{2}}^{x=1} \\\\  & =\\frac{3}{4({y}^{2}+1)}[1-{({y}^{2})}^{2}] \\\\  & =\\frac{3}{4({y}^{2}+1)}[1-{y}^{4}] \\\\  & =\\frac{3(1-{y}^{2})(1+{y}^{2})}{4({y}^{2}+1)} \\\\  & =\\frac{3(1-{y}^{2})}{4}\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3(1-{y}^{2})}{4}, & -1\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d27e6fd-e52f-5424-bff1-96bc9444dad6" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{6}{(y+6)^{2}}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591151} {:answer/id #uuid "903cdaf1-65c7-554e-a752-3d4b572e5bb1" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-3y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591261} {:answer/id #uuid "a83127f1-9325-502c-9eaa-75ccb9b6e152" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{3}{e}^{-3y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591309} {:answer/id #uuid "d4bf7ec9-50f8-5040-bef5-6ee590525718" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}3{e}^{-3y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591403} {:answer/id #uuid "f6a95583-b25b-55c6-9d05-cb74ea61ac86" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{(y+3)^{2}}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591466}] :answer-field/correct {:db/id #edb/ref 17592186591403} :answer-field/id #uuid "08c0c73b-a3be-5060-822b-fa7f585aedbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1e5625d5-5fb1-5fe9-b7bc-beb0b0db6f82" :question/math-academy-id "q-142886" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{-(\\frac{x}{3}+3y)}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the marginal PDF ${f}_{Y}(y).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $y\\ge 0$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\infty }{e}^{-(\\frac{x}{3}+3y)}\\,\\text{d}x \\\\  & ={[-3{e}^{-(\\frac{x}{3}+3y)}]}_{x=0}^{x=\\infty } \\\\  & =-3{[{e}^{-(\\frac{x}{3}+3y)}]}_{x=0}^{x=\\infty } \\\\  & =-3[0-{e}^{-(0+3y)}] \\\\  & =3{e}^{-3y}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}3{e}^{-3y}, & y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ee23e0-1f6e-55d3-b420-8cff311cd4c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt[3]{2}}" :db/id #edb/ref 17592186591021} {:answer/id #uuid "52af213b-b975-5c58-b9a0-cbe42e6abc6d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt[3]{2}}" :db/id #edb/ref 17592186591138} {:answer/id #uuid "7431034d-452b-5500-9a75-f71635f3f064" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186591205} {:answer/id #uuid "b9b8e6b5-d4e0-5fdf-8614-ea84d3460d98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt[3]{2}}{2}" :db/id #edb/ref 17592186591346} {:answer/id #uuid "f595435b-4338-5606-86ca-587ae3286de6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186591464}] :answer-field/correct {:db/id #edb/ref 17592186591021} :answer-field/id #uuid "5658459b-9aa6-56a2-ac50-a558d66d4172" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591531}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2de97f32-f7ad-51d2-a68d-f92f1f60ace0" :question/math-academy-id "q-142968" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{6}\\,{x}^{3}\\sqrt[3]{\\frac{y}{2}}, & 0\\le x\\le 2,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind $P(Y\\le 1).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{2}\\frac{1}{6}\\,{x}^{3}\\sqrt[3]{\\frac{y}{2}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\sqrt[3]{\\frac{y}{2}}{[\\frac{1}{4}{x}^{4}]}_{x=0}^{x=2} \\\\  & =\\frac{1}{24}\\sqrt[3]{\\frac{y}{2}}[{2}^{4}-{0}^{4}] \\\\  & =\\frac{2}{3}\\sqrt[3]{\\frac{y}{2}}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2}{3}\\sqrt[3]{\\frac{y}{2}}, & 0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(Y\\le 1) & ={\\int }_{-\\infty }^{1}{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{2}{3}\\sqrt[3]{\\frac{y}{2}}\\,\\text{d}y \\\\  & =\\frac{2}{3\\sqrt[3]{2}}{\\int }_{0}^{1}\\,{y}^{1/3}\\text{d}y \\\\  & =\\frac{2}{3\\sqrt[3]{2}}{[\\frac{3}{4}{y}^{4/3}]}_{0}^{1} \\\\  & =\\frac{1}{2\\sqrt[3]{2}}[{1}^{4/3}-{0}^{4/3}] \\\\  & =\\frac{1}{2\\sqrt[3]{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e158140-3603-5db6-8c28-4a913568f9bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+{y}^{3}}{2}" :db/id #edb/ref 17592186591073} {:answer/id #uuid "4ba2c84a-a25a-50cc-b983-7c6a18504685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+{y}^{2}}{2}" :db/id #edb/ref 17592186591125} {:answer/id #uuid "59c20bd9-ea92-5f55-a024-b7939dac47ec" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186591144} {:answer/id #uuid "7649f8e6-a672-54e6-81be-5eabecc3c39e" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186591215} {:answer/id #uuid "f14848c8-e92d-56f4-82f0-cae23d722f47" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}" :db/id #edb/ref 17592186591458}] :answer-field/correct {:db/id #edb/ref 17592186591125} :answer-field/id #uuid "d201eafd-3c73-5e6c-8622-8fba14df71d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591597}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5488f7ef-a3fd-5433-bb0f-0f8a2a61219e" :question/math-academy-id "q-142860" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}x+y, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThe marginal CDF ${F}_{Y}(y)$ of $Y$ is given by\n\n$$\n{F}_{Y}(y)=\\{\\begin{aligned}0, & y<0 \\\\ g(y), & 0\\le y\\le 1 \\\\ 1 & y>1.\\end{aligned}\n$$\n\nWhat is the function $g(y)?$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}(x+y)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}{x}^{2}+xy]}_{x=0}^{x=1} \\\\  & =\\frac{1}{2}\\cdot {1}^{2}+1\\cdot y-0 \\\\  & =\\frac{1}{2}+y.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{F}_{Y}(y) & ={\\int }_{-\\infty }^{y}{f}_{Y}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{y}(\\frac{1}{2}+u)\\,\\text{d}u \\\\  & ={[\\frac{u}{2}+\\frac{{u}^{2}}{2}]}_{0}^{y} \\\\  & =\\frac{1}{2}[y+{y}^{2}-0] \\\\  & =\\frac{y+{y}^{2}}{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{Y}(y)$ is\n\n$$\n{F}_{Y}(y)=\\{\\begin{aligned}0, & y<0 \\\\ \\frac{y+{y}^{2}}{2}, & 0\\le y\\le 1 \\\\ 1 & y>1.\\end{aligned}\n$$\n\nFinally, $g(y)=\\frac{y+{y}^{2}}{2}.$"}] [{:db/id #edb/ref 17592186591663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0581138f-51cc-5a1d-9413-579deb1fe20d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186590999} {:answer/id #uuid "2005314e-3e53-5a62-8cca-153d2ca579da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186591046} {:answer/id #uuid "a441f171-ecf1-5e8c-b306-0009b6e6be19" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186591300} {:answer/id #uuid "ac576111-2b15-5232-aec6-14a7eb8d58e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186591321} {:answer/id #uuid "b82aa5b8-8a81-5fee-87d6-d83f04553030" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186591344}] :answer-field/correct {:db/id #edb/ref 17592186591046} :answer-field/id #uuid "847373ee-a712-5b7e-b636-a8f2b82fd36f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591559}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6aaa2752-910d-5bf7-ab5e-6b65c9777a8d" :question/math-academy-id "q-142952" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}y\\operatorname{sin}⁡x, & 0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind $P(-3<Y<1).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}y\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\frac{1}{2}y[-\\operatorname{cos}⁡x]_{x=0}^{x=\\pi /2} \\\\  & =\\frac{1}{2}y(-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{cos}⁡(0)) \\\\  & =\\frac{1}{2}y.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}y, & 0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(-3<Y<1) & ={\\int }_{-3}^{1}{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{1}{2}y\\,\\text{d}y \\\\  & =\\frac{1}{2}{[\\frac{{y}^{2}}{2}]}_{0}^{1} \\\\  & =\\frac{1}{4}({1}^{2}-{0}^{2}) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17269eb6-d861-5905-b550-afd510d44738" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{\\pi }{2}, & 0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591033} {:answer/id #uuid "7bd7038e-908b-5db6-bbe7-ebbc6457c543" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\operatorname{cos}⁡x, & 0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591227} {:answer/id #uuid "81df4c3b-855b-560a-b12e-3aeeed81c62f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\operatorname{sin}⁡x, & 0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591240} {:answer/id #uuid "da972315-2dc0-5268-8653-8dd6ee248988" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{8x}{{\\pi }^{2}}, & 0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591411} {:answer/id #uuid "f0216f9c-d2d2-53a9-a1dd-0e8b1ba7edc1" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{\\pi }, & 0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591456}] :answer-field/correct {:db/id #edb/ref 17592186591456} :answer-field/id #uuid "ddaec570-8642-5daf-9e3d-28c29374ea54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591607}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86994f22-4ed6-5278-9ec3-0eb9133c9cc7" :question/math-academy-id "q-142751" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{\\pi }\\,\\operatorname{sin}⁡y, & 0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the marginal PDF ${f}_{X}(x).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le \\frac{\\pi }{2}$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\pi /2}\\frac{2}{\\pi }\\,\\operatorname{sin}⁡y\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }[-\\operatorname{cos}⁡y]_{y=0}^{y=\\pi /2} \\\\  & =\\frac{2}{\\pi }(-\\operatorname{cos}⁡\\frac{\\pi }{2}+\\operatorname{cos}⁡0) \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{\\pi }, & 0\\le x\\le \\frac{\\pi }{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0823bf41-1e23-5446-bbca-3abcf14cac9a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-x}" :db/id #edb/ref 17592186591003} {:answer/id #uuid "0cc12e1b-0eb7-5ada-97a9-e6451066cd54" :answer/type {:db/ident :answer.type/math} :answer/value "1-{e}^{-2x}" :db/id #edb/ref 17592186591009} {:answer/id #uuid "c244b21b-8d18-59f2-a2d0-7d1f7be6e49b" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-{x}^{2}}" :db/id #edb/ref 17592186591359} {:answer/id #uuid "c8951a9b-3dcf-5839-bf57-9c01b2693a31" :answer/type {:db/ident :answer.type/math} :answer/value "1-{e}^{-{x}^{2}}" :db/id #edb/ref 17592186591371} {:answer/id #uuid "d31de738-4883-5d11-b63e-848ae353af6e" :answer/type {:db/ident :answer.type/math} :answer/value "1-{e}^{-x}" :db/id #edb/ref 17592186591400}] :answer-field/correct {:db/id #edb/ref 17592186591400} :answer-field/id #uuid "8be69e6e-ba68-5e57-af44-2e5ad3ae65b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591564}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87388207-1c0b-5684-a29e-8f08de85119d" :question/math-academy-id "q-142922" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{-(x+y)}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThe marginal CDF ${F}_{X}(x)$ of $X$ is given by\n\n$$\n{F}_{X}(x)=\\{\\begin{aligned}0, & x<0 \\\\ g(x), & x\\ge 0.\\end{aligned}\n$$\n\nWhat is the function $g(x)?$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 0$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\infty }{e}^{-(x+y)}\\,\\text{d}y \\\\  & ={e}^{-x}\\lim_{b\\to \\infty }{\\int }_{0}^{b}{e}^{-y}\\,\\text{d}y \\\\  & ={e}^{-x}\\lim_{b\\to \\infty }{[-{e}^{-y}]}_{y=0}^{y=b} \\\\  & ={e}^{-x}\\lim_{b\\to \\infty }(1-{e}^{-b}) \\\\  & ={e}^{-x}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $X$ for $x\\ge 0$ is \n\n$$\n\\begin{aligned}{F}_{X}(x) & ={\\int }_{-\\infty }^{x}{f}_{X}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{x}{e}^{-u}\\,\\text{d}u \\\\  & ={[-{e}^{-u}]}_{0}^{x} \\\\  & =1-{e}^{-x}.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{X}(x)$ is\n\n$$\n{F}_{X}(x)=\\{\\begin{aligned}0, & x<0 \\\\ 1-{e}^{-x}, & x\\ge 0.\\end{aligned}\n$$\n\nFinally, $g(x)=1-{e}^{-x}.$"}] [{:db/id #edb/ref 17592186591684 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013de305-55b7-5387-a63a-9d940b2ea75c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{12x-3{x}^{2}}{32}, & 0\\le x\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186590993} {:answer/id #uuid "04bb955f-dfbb-522a-b5e0-4492bca83534" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}4x, & 0\\le x\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186590998} {:answer/id #uuid "44a3270a-11f8-5fe5-9ac3-3bb906e4ad16" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{3{x}^{2}}{64}, & 0\\le x\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591106} {:answer/id #uuid "5ac15e3d-c009-5eaf-8a80-5661e0baa77e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{{x}^{3}}{64}, & 0\\le x\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591149} {:answer/id #uuid "f87e5d8b-2113-51b7-ac73-aa1dd7995578" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{x}{8}, & 0\\le x\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591469}] :answer-field/correct {:db/id #edb/ref 17592186591149} :answer-field/id #uuid "56e1e657-8636-5d3e-b530-69b144cb4fc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591532}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a637704d-0464-5714-971d-5226ad40baf3" :question/math-academy-id "q-142705" :question/problem "Let $X$ and $Y$ be two continuous random variables with a joint probability density function\n\n$$\nf(x,y)=\\frac{1}{16}x{y}^{3},\\,0\\le x\\le 4,\\,0\\le y\\le \\sqrt{x}.\n$$\n\nFind the expression for the marginal PDF ${f}_{X}(x).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le 4,0\\le y\\le \\sqrt{x}\\}.$\n\n![](images/0a/0a3aeba14383b64a0414f3163828d972102073dc972d64105e779b317b8574b0.png)\n\nIn our case, the marginal density function of $X$ for $0\\le x\\le 4$ is\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\sqrt{x}}\\frac{1}{16}x{y}^{3}\\,\\text{d}y \\\\  & =\\frac{1}{16}{\\int }_{0}^{\\sqrt{x}}x{y}^{3}\\,\\text{d}y \\\\  & =\\frac{1}{16}{[\\frac{1}{4}x{y}^{4}]}_{y=0}^{y=\\sqrt{x}} \\\\  & =\\frac{1}{64}{[x{y}^{4}]}_{y=0}^{y=\\sqrt{x}} \\\\  & =\\frac{1}{64}[x\\cdot (\\sqrt{x})^{4}-x\\cdot (\\sqrt{0})^{4}] \\\\  & =\\frac{1}{64}[x\\cdot {x}^{2}-0] \\\\  & =\\frac{{x}^{3}}{64}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{{x}^{3}}{64}, & 0\\le x\\le 4, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60b4f028-32d8-5094-b307-0a50f8cb7ceb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2y}{3}" :db/id #edb/ref 17592186591163} {:answer/id #uuid "6a318147-1015-5649-ab4b-7c825a45584e" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186591178} {:answer/id #uuid "7499674f-9b43-50b3-b996-9e56331234ad" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}" :db/id #edb/ref 17592186591208} {:answer/id #uuid "8f281d04-4bd7-5efd-9076-ba8aaac2a9c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+{y}^{3}}{2}" :db/id #edb/ref 17592186591259} {:answer/id #uuid "d2ad103f-5db5-5522-97c9-137a9f1fd82c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+{y}^{2}}{2}" :db/id #edb/ref 17592186591398}] :answer-field/correct {:db/id #edb/ref 17592186591259} :answer-field/id #uuid "ea389dff-fcf6-5fe4-a3d9-ec36ca89189a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591612}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aec15b91-592c-5e0b-b3bc-4963d4e01bf4" :question/math-academy-id "q-142918" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{2}({x}^{2}+{y}^{2}), & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThe marginal CDF ${F}_{Y}(y)$ of $Y$ is given by\n\n$$\n{F}_{Y}(y)=\\{\\begin{aligned}0, & y<0 \\\\ g(y), & 0\\le y\\le 1 \\\\ 1 & y>1.\\end{aligned}\n$$\n\nWhat is the function $g(y)?$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{Y}(y) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}\\frac{3}{2}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =\\frac{3}{2}{\\int }_{0}^{1}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =\\frac{3}{2}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=1} \\\\  & =\\frac{3}{2}[\\frac{1}{3}\\cdot {1}^{3}+1\\cdot {y}^{2}-0] \\\\  & =\\frac{3}{2}(\\frac{1}{3}+{y}^{2}) \\\\  & =\\frac{1}{2}+\\frac{3{y}^{2}}{2}.\\end{aligned}\n$$\n\nTherefore, the marginal CDF of $Y$ for $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{F}_{Y}(y) & ={\\int }_{-\\infty }^{y}{f}_{Y}(u)\\,\\text{d}u \\\\  & ={\\int }_{0}^{y}(\\frac{1}{2}+\\frac{3{u}^{2}}{2})\\,\\text{d}u \\\\  & ={[\\frac{u}{2}+\\frac{{u}^{3}}{2}]}_{0}^{y} \\\\  & =\\frac{1}{2}[y+{y}^{3}-0] \\\\  & =\\frac{y+{y}^{3}}{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${F}_{Y}(y)$ is\n\n$$\n{F}_{Y}(y)=\\{\\begin{aligned}0, & y<0 \\\\ \\frac{y+{y}^{3}}{2}, & 0\\le y\\le 1 \\\\ 1 & y>1.\\end{aligned}\n$$\n\nFinally, $g(y)=\\frac{y+{y}^{3}}{2}.$"}] [{:db/id #edb/ref 17592186591701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10464ab2-fb5b-5a27-b3c0-d5da52b5b85f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{32}" :db/id #edb/ref 17592186591018} {:answer/id #uuid "131b86c3-64bc-5d0e-b27e-8edd5885889c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{32}" :db/id #edb/ref 17592186591024} {:answer/id #uuid "5f2aa958-8b4f-500c-ad33-f49cf4b3632b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{24}" :db/id #edb/ref 17592186591157} {:answer/id #uuid "6df7f1e5-0147-542f-82b2-7e80cf7c4081" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{23}" :db/id #edb/ref 17592186591187} {:answer/id #uuid "718eb0c3-e7b1-5092-b6f8-8c46ca1ddf8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186591198}] :answer-field/correct {:db/id #edb/ref 17592186591024} :answer-field/id #uuid "7a2d94b0-cc55-5460-9da7-aed70aadded3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591552}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cc02d07e-91fb-5d5d-b234-451aff2335b3" :question/math-academy-id "q-142963" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{16}({x}^{3}+{y}^{3}), & 0\\le x\\le 2,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind $P(Y\\ge 1).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le 2$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{2}\\frac{1}{16}({x}^{3}+{y}^{3})\\,\\text{d}x \\\\  & =\\frac{1}{16}{[\\frac{{x}^{4}}{4}+x{y}^{3}]}_{x=0}^{x=2} \\\\  & =\\frac{1}{16}[\\frac{{2}^{4}}{4}+(2){y}^{3}]-0 \\\\  & =\\frac{1}{16}(4+2{y}^{3}) \\\\  & =\\frac{1}{4}+\\frac{1}{8}{y}^{3}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{4}+\\frac{1}{8}{y}^{3}, & 0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore, the required probability is\n\n$$\n\\begin{aligned}P(Y\\ge 1) & ={\\int }_{1}^{\\infty }{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}(\\frac{1}{4}+\\frac{1}{8}{y}^{3})\\text{d}y \\\\  & ={[\\frac{1}{4}y+\\frac{1}{32}{y}^{4}]}_{1}^{2} \\\\  & =[\\frac{1}{4}(2)+\\frac{1}{32}{2}^{4}]-[\\frac{1}{4}(1)+\\frac{1}{32}{1}^{4}] \\\\  & =1-\\frac{9}{32} \\\\  & =\\frac{23}{32}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e51a0b0-97b0-5bf0-a633-bb5af6c3248a" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)-\\operatorname{cos}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591074} {:answer/id #uuid "6a5826c4-7e27-5b49-8d65-e6b5a9b8ae4b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{sin}⁡y-\\operatorname{cos}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591179} {:answer/id #uuid "7276a99b-1279-57ff-8763-d738c8ec9009" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{sin}⁡y-\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591201} {:answer/id #uuid "b2dcd27e-80d6-5b5f-89a7-5a47a23e34f0" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{sin}⁡y+\\operatorname{cos}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591335} {:answer/id #uuid "c9c80125-7c32-5258-9f19-4772a48d72ef" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{sin}⁡(\\frac{\\pi }{4}+y)-\\operatorname{sin}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591372}] :answer-field/correct {:db/id #edb/ref 17592186591074} :answer-field/id #uuid "626d38b7-310d-5999-9efe-0c0f771987f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591538}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cdab03ca-34df-52b0-ae2d-f7886faf7822" :question/math-academy-id "q-142870" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{\\sqrt{2}-1}\\operatorname{sin}⁡(x+y), & 0\\le x\\le \\frac{\\pi }{4},\\,0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the marginal PDF ${f}_{Y}(y).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $Y$ for $0\\le y\\le \\frac{\\pi }{4}$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{\\pi /4}\\frac{1}{\\sqrt{2}-1}\\operatorname{sin}⁡(x+y)\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}-1}[-\\operatorname{cos}⁡(x+y)]_{x=0}^{x=\\pi /4} \\\\  & =\\frac{1}{1-\\sqrt{2}}[\\operatorname{cos}⁡(x+y)]_{x=0}^{x=\\pi /4} \\\\  & =\\frac{1}{1-\\sqrt{2}}[\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)-\\operatorname{cos}⁡(0+y)] \\\\  & =\\frac{1}{1-\\sqrt{2}}(\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)-\\operatorname{cos}⁡y).\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{Y}(y)$ is given by\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{1-\\sqrt{2}}(\\operatorname{cos}⁡(\\frac{\\pi }{4}+y)-\\operatorname{cos}⁡y), & 0\\le y\\le \\frac{\\pi }{4}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186591710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47dd38cd-f4dd-52ac-acc2-70e646995c64" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}-{e}^{-x}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591119} {:answer/id #uuid "5b0c93b3-2cf8-5a3a-bc26-b75123baa542" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}{e}^{-x}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591150} {:answer/id #uuid "6d2203e1-9cf0-50b4-be11-c633e59c7043" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{(x+1)^{2}}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591186} {:answer/id #uuid "b0b6a0b3-dc09-5f5d-983f-b811a89a4e72" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}\\frac{2}{(x+2)^{2}}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591331} {:answer/id #uuid "f673770c-78d1-5248-b5b5-20ff4c341d47" :answer/type {:db/ident :answer.type/math} :answer/value "{f}_{X}(x)=\\{\\begin{aligned}2{e}^{-x}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}" :db/id #edb/ref 17592186591465}] :answer-field/correct {:db/id #edb/ref 17592186591150} :answer-field/id #uuid "dd05c2aa-178d-5e44-9ce2-49a21cc2e199" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591605}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d57a0a41-e072-545b-a61f-1f77ea6bd4df" :question/math-academy-id "q-142815" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{-(x+y)}, & x\\ge 0,\\,y\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFind the expression for the marginal PDF ${f}_{X}(x).$" :question/worked-solution "If $X$ and $Y$ are two continuous random variables with joint probability density function $f(x,y),$ then the marginal density functions for $X$ and $Y$ are\n\n$$\n\\begin{aligned}{f}_{X}(x) &={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y,\\,{f}_{Y}(y)={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x.\\end{aligned}\n$$\n\nIn our case, the marginal density function of $X$ for $x\\ge 0$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{\\infty }{e}^{-(x+y)}\\,\\text{d}y \\\\  & ={[-{e}^{-(x+y)}]}_{y=0}^{y=\\infty } \\\\  & =(0+{e}^{-(x+0)}) \\\\  & ={e}^{-x}.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}{e}^{-x}, & x\\ge 0, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$"}]}
