^{3t}|}_{-\\infty }^{x} \\\\  & =\\frac{1}{2}{e}^{3x},\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{3}{2}{e}^{3t}\\,\\text{d}t & ={\\frac{1}{2}{e}^{3x}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{3}{2}{e}^{-3t}\\,\\text{d}t & =-{\\frac{1}{2}{e}^{-3t}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-3x}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{3}{2}{e}^{-3t}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{3}{2}{e}^{-3t}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-3x}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-3x}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\left\\{\\begin{aligned}\\frac{{e}^{3x}}{2}, & x<0 \\\\ 1-\\frac{{e}^{-3x}}{2}, & x\\ge 0.\\end{aligned}\\right.\n$$" 13194139544833 17592186576411 true] [17592186654276 1074 "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{3}{2}{e}^{3t}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{3}{2}{e}^{3t}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{3}{2}{e}^{-3t}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{3}{2}{e}^{3t}\\,\\text{d}t & ={\\frac{1}{2}{e}^{3t}|}_{-\\infty }^{x} \\\\  & =\\frac{1}{2}{e}^{3x},\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{3}{2}{e}^{3t}\\,\\text{d}t & ={\\frac{1}{2}{e}^{3x}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{3}{2}{e}^{-3t}\\,\\text{d}t & =-{\\frac{1}{2}{e}^{-3t}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-3x}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\beg