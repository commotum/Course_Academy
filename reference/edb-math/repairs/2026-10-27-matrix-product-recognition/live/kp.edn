.type/blank} :db/id #edb/ref 17592186695866} {:answer-field/choices [{:answer/id #uuid "73ad2939-a894-54e5-b19f-145b9a79a2fa" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186695834}] :answer-field/correct {:answer/id #uuid "73ad2939-a894-54e5-b19f-145b9a79a2fa" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186695834} :answer-field/id #uuid "ecf58dd6-2943-5a43-867d-f9d1e4957a22" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186695872}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8e46ef99-26f0-5da1-a3a9-be61c7870457" :question/problem "Calculate $AB$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 1 & -2 \\\\ -1 & -3 & -2 \\\\ -2 & -2 & 2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & -1 & -2 \\\\ 1 & 1 & -2 \\\\ 3 & -1 & -3\\end{bmatrix}$</div>\n</div>\n\nComplete the product.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n<tr><td>{{field-4}}</td><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n<tr><td>{{field-7}}</td><td>{{field-8}}</td><td>{{field-9}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Multiply each row of $A$ by each column of $B$, adding the three pairwise products.\n\n$$\n\\begin{aligned}c_{11} &= 1\\cdot(-2)+1\\cdot1+(-2)\\cdot3 = -7 \\\\ c_{12} &= 1\\cdot(-1)+1\\cdot1+(-2)\\cdot(-1) = 2 \\\\ c_{13} &= 1\\cdot(-2)+1\\cdot(-2)+(-2)\\cdot(-3) = 2\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21} &= (-1)\\cdot(-2)+(-3)\\cdot1+(-2)\\cdot3 = -7 \\\\ c_{22} &= (-1)\\cdot(-1)+(-3)\\cdot1+(-2)\\cdot(-1) = 0 \\\\ c_{23} &= (-1)\\cdot(-2)+(-3)\\cdot(-2)+(-2)\\cdot(-3) = 14\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{31} &= (-2)\\cdot(-2)+(-2)\\cdot1+2\\cdot3 = 8 \\\\ c_{32} &= (-2)\\cdot(-1)+(-2)\\cdot1+2\\cdot(-1) = -2 \\\\ c_{33} &= (-2)\\cdot(-2)+(-2)\\cdot(-2)+2\\cdot(-3) = 2\\end{aligned}\n$$\n\nTherefore,\n$$\nAB=\\begin{bmatrix}-7 & 2 & 2 \\\\ -7 & 0 & 14 \\\\ 8 & -2 & 2\\end{bmatrix}.\n$$\n"} {:db/id #edb/ref 17592186695850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "def96784-0c69-57a1-a465-852182c81715" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186695869}] :answer-field/correct {:answer/id #uuid "def96784-0c69-57a1-a465-852182c81715" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186695869} :answer-field/id #uuid "15820b8b-2330-5081-97a7-58b39f62293f" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186695803} {:answer-field/choices [{:answer/id #uuid "7953f301-2d3a-54e8-98cf-a517ed3f6aa5" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186695836}] :answer-field/correct {:answer/id #uuid "7953f301-2d3a-54e8-98cf-a517ed3f6aa5" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186695836} :answer-field/id #uuid "45674da0-7faf-5568-a777-c0692a1334c6" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186695816} {:answer-field/choices [{:answer/id #uuid "5a21a8b9-8935-575b-a24e-852972152cba" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186695821}] :answer-field/correct {:answer/id #uuid "5a21a8b9-8935-575b-a24e-852972152cba" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186695821} :answer-field/id #uuid "5aa4730a-698a-5cac-9e6b-a423a1acdd70" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186695822} {:answer-field/choices [{:answer/id #uuid "6ab72714-1f01-5081-8379-04909f40ee7e" :answer/type