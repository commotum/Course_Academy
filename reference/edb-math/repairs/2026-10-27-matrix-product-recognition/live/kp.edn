e three pairwise products.\n\n$$\n\\begin{aligned}c_{11} &= 3\\cdot(-2)+(-3)\\cdot2+(-3)\\cdot1 = -15 \\\\ c_{12} &= 3\\cdot(-1)+(-3)\\cdot3+(-3)\\cdot(-2) = -6 \\\\ c_{13} &= 3\\cdot(-2)+(-3)\\cdot2+(-3)\\cdot(-2) = -6\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21} &= (-1)\\cdot(-2)+3\\cdot2+(-3)\\cdot1 = 5 \\\\ c_{22} &= (-1)\\cdot(-1)+3\\cdot3+(-3)\\cdot(-2) = 16 \\\\ c_{23} &= (-1)\\cdot(-2)+3\\cdot2+(-3)\\cdot(-2) = 14\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{31} &= 2\\cdot(-2)+1\\cdot2+(-2)\\cdot1 = -4 \\\\ c_{32} &= 2\\cdot(-1)+1\\cdot3+(-2)\\cdot(-2) = 5 \\\\ c_{33} &= 2\\cdot(-2)+1\\cdot2+(-2)\\cdot(-2) = 2\\end{aligned}\n$$\n\nTherefore,\n$$\nAB=\\begin{bmatrix}-15 & -6 & -6 \\\\ 5 & 16 & 14 \\\\ -4 & 5 & 2\\end{bmatrix}.\n$$\n"} {:db/id #edb/ref 17592186725439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64e18375-d4d4-5b45-9408-3924a921f782" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186725447}] :answer-field/correct {:answer/id #uuid "64e18375-d4d4-5b45-9408-3924a921f782" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186725447} :answer-field/id #uuid "07e49803-ad43-5dd6-b868-451218426073" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186725436} {:answer-field/choices [{:answer/id #uuid "45eb5595-0d7f-5cfd-b884-4a08f4b6e469" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186725442}] :answer-field/correct {:answer/id #uuid "45eb5595-0d7f-5cfd-b884-4a08f4b6e469" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186725442} :answer-field/id #uuid "c4ce87cd-8536-5445-8619-f1b0fd3bf603" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186725459} {:answer-field/choices [{:answer/id #uuid "e24ab3d7-d807-5504-9a03-8e881393d16c" :answer/type {:db/ident :answer.type/math} :answer/val