-1)\\cdot0+0\\cdot(-3) = 0 \\\\ c_{33} &= 0\\cdot(-2)+(-1)\\cdot3+0\\cdot2 = -3\\end{aligned}\n$$\n\nTherefore,\n$$\nAB=\\begin{bmatrix}5 & -6 & 1 \\\\ -4 & -6 & 4 \\\\ -1 & 0 & -3\\end{bmatrix}.\n$$\n"] [:db/add "f21230d8-e9b5-5da9-8f16-6cf39c371a77" :question/difficulty :question.difficulty/easy] [:db/add "f21230d8-e9b5-5da9-8f16-6cf39c371a77" :question/answer-fields "d82c466c-27a6-5f16-80c9-3f453c83fba7"] [:db/add "f21230d8-e9b5-5da9-8f16-6cf39c371a77" :question/answer-fields "85b15664-7ee0-51be-9188-3344b6eed2ca"] [:db/add "f21230d8-e9b5-5da9-8f16-6cf39c371a77" :question/answer-fields "ed655e38-cc4a-50e3-b231-40fb2a68e538"] [:db/ensure "f21230d8-e9b5-5da9-8f16-6cf39c371a77" :question/validate] [:db/add 17592186059747 :knowledge-point/questions "f21230d8-e9b5-5da9-8f16-6cf39c371a77"] [:db/add "generator" :question-generator/id #uuid "a71fbe81-1975-5863-b3d1-f21d44a67d94"] [:db/add "generator" :question-generator/script "generators/a9/a94cca56f1b193b678022a4709a73ce0ff52a720feb0959cc58c53f05ff54a85/generator.py"] [:db/add 17592186059747 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059747 :knowledge-point/validate] [:db/cas 17592186695558 :question/retired nil true] [:db/cas 17592186695774 :question/retired nil true] [:db/cas 17592186695777 :question/retired nil true] [:db/cas 17592186695793 :question/retired nil true] [:db/cas 17592186695797 :question/retired nil true]]
