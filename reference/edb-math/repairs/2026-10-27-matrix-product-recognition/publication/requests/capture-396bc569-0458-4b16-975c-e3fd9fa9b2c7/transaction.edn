lidate] [:db/add "d6a59cd6-d905-588a-9678-7e9f3c72aba6" :answer-field/id #uuid "d6a59cd6-d905-588a-9678-7e9f3c72aba6"] [:db/add "d6a59cd6-d905-588a-9678-7e9f3c72aba6" :answer-field/key "field-3"] [:db/add "d6a59cd6-d905-588a-9678-7e9f3c72aba6" :answer-field/type :answer-field.type/blank] [:db/add "d6a59cd6-d905-588a-9678-7e9f3c72aba6" :answer-field/choices "e24ab3d7-d807-5504-9a03-8e881393d16c"] [:db/add "d6a59cd6-d905-588a-9678-7e9f3c72aba6" :answer-field/correct "e24ab3d7-d807-5504-9a03-8e881393d16c"] [:db/ensure "d6a59cd6-d905-588a-9678-7e9f3c72aba6" :answer-field/validate] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/id #uuid "18bd73e9-f246-52aa-a650-a1c5e696ff7f"] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/problem "Calculate $AB$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-3 & 0 & -1 \\\\ 0 & 0 & 2 \\\\ 0 & 1 & 0\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & -1 & -3 \\\\ -1 & 3 & 3 \\\\ 3 & -2 & -2\\end{bmatrix}$</div>\n</div>\n\nComplete the product.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$5$</td><td>$11$</td></tr>\n<tr><td>$6$</td><td>$-4$</td><td>{{field-2}}</td></tr>\n<tr><td>$-1$</td><td>{{field-3}}</td><td>$3$</td></tr>\n</tbody></table>\n</div>\n</div>"] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/worked-solution "Multiply each row of $A$ by each column of $B$, adding the three pairwise products.\n\n$$\n\\begin{aligned}c_{11} &= (-3)\\cdot0+0\\cdot(-1)+(-1)\\cdot3 = -3 \\\\ c_{12} &= (-3)\\cdot(-1)+0\\cdot3+(-1)\\cdot(-2) = 5 \\\\ c_{13} &= (-3)\\cdot(-3)+0\\cdot3+(-1)\\cdot(-2) = 11\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21} &= 0\\cdot0+0\\cdot(-1)+2\\cdot3 = 6 \\\\ c_{22} &= 0\\cdot(-1)+0\\cdot3+2\\cdot(-2) = -4 \\\\ c_{23} &= 0\\cdot(-3)+0\\cdot3+2\\cdot(-2) = -4\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{31} &= 0\\cdot0+1\\cdot(-1)+0\\cdot3 = -1 \\\\ c_{32} &= 0\\cdot(-1)+1\\cdot3+0\\cdot(-2) = 3 \\\\ c_{33} &= 0\\cdot(-3)+1\\cdot3+0\\cdot(-2) = 3\\end{aligned}\n$$\n\nTherefore,\n$$\nAB=\\begin{bmatrix}-3 & 5 & 11 \\\\ 6 & -4 & -4 \\\\ -1 & 3 & 3\\end{bmatrix}.\n$$\n"] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/difficulty :question.difficulty/easy] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/answer-fields "c4ce87cd-8536-5445-8619-f1b0fd3bf603"] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/answer-fields "07e49803-ad43-5dd6-b868-451218426073"] [:db/add "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/answer-fields "d6a59cd6-d905-588a-9678-7e9f3c72aba6"] [:db/ensure "18bd73e9-f246-52aa-a650-a1c5e696ff7f" :question/validate] [:db/add 17592186059747 :knowledge-point/questions "18bd73e9-f246-52aa-a650-a1c5e696ff7f"] [:db/add "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993" :answer/id #uuid "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993"] [:db/add "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993" :answer/type :answer.type/math] [:db/add "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993" :answer/value "0"] [:db/ensure "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993" :answer/validate] [:db/add "71cb0d60-f367-5cd0-a9f4-3f51049f046b" :answer-field/id #uuid "71cb0d60-f367-5cd0-a9f4-3f51049f046b"] [:db/add "71cb0d60-f367-5cd0-a9f4-3f51049f046b" :answer-field/key "field-1"] [:db/add "71cb0d60-f367-5cd0-a9f4-3f51049f046b" :answer-field/type :answer-field.type/blank] [:db/add "71cb0d60-f367-5cd0-a9f4-3f51049f046b" :answer-field/choices "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993"] [:db/add "71cb0d60-f367-5cd0-a9f4-3f51049f046b" :answer-field/correct "8d3ab1c7-aeb1-5f67-9862-8fc8c8df9993"] [:db/ensure "71cb0d60-f367-5cd0-a9f4-3f51049f046b" :answer-field/validate] [:db/add "a0c29520-6536-5c8d-a984-027d6b1e918c" :answer/id #uuid "a0c29520-6536-5c8d-a984-027d6b1e918c"] [:db/add "a0c29520-6536-5c8d-a984-027d6b1e918c" :answer/type :answer.type/math] [:db/add "a0c29520-6536-5c8d-a984-027d6b1e918c