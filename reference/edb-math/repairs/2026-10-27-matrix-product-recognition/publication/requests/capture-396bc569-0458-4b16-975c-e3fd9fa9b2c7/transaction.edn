fbe-5de8-89b8-3ed17366153b" :answer/value "2"] [:db/ensure "776a2d26-3fbe-5de8-89b8-3ed17366153b" :answer/validate] [:db/add "26421724-d40e-50e0-9d71-aaf930d700ed" :answer-field/id #uuid "26421724-d40e-50e0-9d71-aaf930d700ed"] [:db/add "26421724-d40e-50e0-9d71-aaf930d700ed" :answer-field/key "field-3"] [:db/add "26421724-d40e-50e0-9d71-aaf930d700ed" :answer-field/type :answer-field.type/blank] [:db/add "26421724-d40e-50e0-9d71-aaf930d700ed" :answer-field/choices "776a2d26-3fbe-5de8-89b8-3ed17366153b"] [:db/add "26421724-d40e-50e0-9d71-aaf930d700ed" :answer-field/correct "776a2d26-3fbe-5de8-89b8-3ed17366153b"] [:db/ensure "26421724-d40e-50e0-9d71-aaf930d700ed" :answer-field/validate] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/id #uuid "93cf1462-a55e-5761-bffc-e0aa8242a43f"] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/problem "Calculate $AB$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & -1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & -1 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}$</div>\n</div>\n\nComplete the product.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$2$</td><td>{{field-1}}</td><td>$2$</td></tr>\n<tr><td>$2$</td><td>$-2$</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$-1$</td><td>$-1$</td></tr>\n</tbody></table>\n</div>\n</div>"] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/worked-solution "Multiply each row of $A$ by each column of $B$, adding the three pairwise products.\n\n$$\n\\begin{aligned}c_{11} &= 1\\cdot2+0\\cdot1+2\\cdot0 = 2 \\\\ c_{12} &= 1\\cdot1+0\\cdot(-1)+2\\cdot2 = 5 \\\\ c_{13} &= 1\\cdot0+0\\cdot2+2\\cdot1 = 2\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21} &= 0\\cdot2+2\\cdot1+0\\cdot0 = 2 \\\\ c_{22} &= 0\\cdot1+2\\cdot(-1)+0\\cdot2 = -2 \\\\ c_{23} &= 0\\cdot0+2\\cdot2+0\\cdot1 = 4\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{31} &= 1\\cdot2+0\\cdot1+(-1)\\cdot0 = 2 \\\\ c_{32} &= 1\\cdot1+0\\cdot(-1)+(-1)\\cdot2 = -1 \\\\ c_{33} &= 1\\cdot0+0\\cdot2+(-1)\\cdot1 = -1\\end{aligned}\n$$\n\nTherefore,\n$$\nAB=\\begin{bmatrix}2 & 5 & 2 \\\\ 2 & -2 & 4 \\\\ 2 & -1 & -1\\end{bmatrix}.\n$$\n"] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/difficulty :question.difficulty/easy] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/answer-fields "4f345338-ed84-5daf-8674-618960a1ede1"] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/answer-fields "1090352a-84bc-50bd-b3ad-f262b563b8f2"] [:db/add "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/answer-fields "26421724-d40e-50e0-9d71-aaf930d700ed"] [:db/ensure "93cf1462-a55e-5761-bffc-e0aa8242a43f" :question/validate] [:db/add 17592186059747 :knowledge-point/questions "93cf1462-a55e-5761-bffc-e0aa8242a43f"] [:db/add "ee0b6a85-7f87-5904-ac39-6c4a21e19865" :answer/id #uuid "ee0b6a85-7f87-5904-ac39-6c4a21e19865"] [:db/add "ee0b6a85-7f87-5904-ac39-6c4a21e19865" :answer/type :answer.type/math] [:db/add "ee0b6a85-7f87-5904-ac39-6c4a21e19865" :answer/value "-2"] [:db/ensure "ee0b6a85-7f87-5904-ac39-6c4a21e19865" :answer/validate] [:db/add "51edd1f2-b812-523b-abbe-85d60961339a" :answer-field/id #uuid "51edd1f2-b812-523b-abbe-85d60961339a"] [:db/add "51edd1f2-b812-523b-abbe-85d60961339a" :answer-field/key "field-1"] [:db/add "51edd1f2-b812-523b-abbe-85d60961339a" :answer-field/type :answer-field.type/blank] [:db/add "51edd1f2-b812-523b-abbe-85d60961339a" :answer-field/choices "ee0b6a85-7f87-5904-ac39-6c4a21e19865"] [:db/add "51edd1f2-b812-523b-abbe-85d60961339a" :answer-field/correct "ee0b6a85-7f87-5904-ac39-6c4a21e19865"] [:db/ensure "51edd1f2-b812-523b-abbe-85d60961339a" :answer-field/validate] [:db/add "fabb25d1-6bd1-51b2-b3d9-eda1a3df949e" :answer/id #uuid "fabb25d1-6bd1-51b2-b3d9-eda1a3df949e"] [:db/add "fabb25d1-6bd1-51b2-b3d9-eda1a3df949e" :answer/type :answer.ty