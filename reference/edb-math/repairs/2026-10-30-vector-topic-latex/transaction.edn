1)$ and ${X}_{2}(-6,2,-7).$" "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}\\mathbf{r} & =\\mathbf{p}+t\\mathbf{v} \\\\ \\mathbf{r} & =⟨-4,\\,2,\\,-3⟩+t⟨1,\\,0,\\,2⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $X$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overrightarrow{OX} & =⟨-4,\\,2,\\,-3⟩+t⟨1,\\,0,\\,2⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overrightarrow{PX} & =\\overrightarrow{OX}-\\overrightarrow{OP} \\\\  & =(⟨-4,\\,2,\\,-3⟩+t⟨1,\\,0,\\,2⟩)-⟨-4,\\,2,\\,-3⟩ \\\\  & =t⟨1,\\,0,\\,2⟩ \\\\  & =⟨t,\\,0,\\,2t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PX=\\sqrt{20},$ we get:\n\n$$\n\\begin{aligned}XP & =\\sqrt{20} \\\\ |\\overrightarrow{PX}| & =\\sqrt{20} \\\\ |⟨t,\\,0,\\,2t⟩| & =\\sqrt{20} \\\\ \\sqrt{{t}^{2}+{0}^{2}+(2t)^{2}} & =\\sqrt{20} \\\\ \\sqrt{5{t}^{2}} & =\\sqrt{20} \\\\ \\pm \\sqrt{5}t & =2\\sqrt{5} \\\\ t & =\\pm 2\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 2$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overrightarrow{O{X}_{1}}=⟨-4,\\,2,\\,-3⟩+2⟨1,\\,0,\\,2⟩=⟨-2,2,1⟩, \\\\  & \\overrightarrow{O{X}_{2}}=⟨-4,\\,2,\\,-3⟩-2⟨1,\\,0,\\,2⟩=⟨-6,2,-7⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${X}_{1}(-2,2,1)$ and ${X}_{2}(-6,2,-7).$"] [:db/cas 17592186648686 :question/problem "Consider the straight line that passes through $P(5,1,2)$ and is parallel to $v=⟨1,0,-1⟩.$ Find all the possible points $S$ on that line such that $SP=\\sqrt{18}.$" "Consider the straight line that passes through $P(5,1,2)$ and is parallel to $\\mathbf{v}=⟨1,0,-1⟩.$ Find all the possible points $S$ on that line such that $SP=\\sqrt{18}.$"] [:db/cas 17592186648686 :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨5,1,2⟩+t⟨1,0,-1⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $S$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OS} & =⟨5,1,2⟩+t⟨1,0,-1⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PS} & =\\overset{\\to }{OS}-\\overset{\\to }{OP} \\\\  & =(⟨5,1,2⟩+t⟨1,0,-1⟩)-⟨5,1,2⟩ \\\\  & =t\\,⟨1,0,-1⟩ \\\\  & =⟨t,\\,0,\\,-t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PS=\\sqrt{18},$ we get:\n\n$$\n\\begin{aligned}SP & =\\sqrt{18} \\\\ |\\overset{\\to }{PS}| & =\\sqrt{18} \\\\ |⟨t,\\,0,\\,-t⟩| & =\\sqrt{18} \\\\ \\sqrt{{t}^{2}+{0}^{2}+{t}^{2}} & =\\sqrt{18} \\\\ \\sqrt{2{t}^{2}} & =\\sqrt{18} \\\\ \\pm \\sqrt{2}t & =3\\sqrt{2} \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 3$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{S}_{1}}=⟨5,1,2⟩+3⟨1,0,-1⟩=⟨8,1,-1⟩, \\\\  & \\overset{\\to }{O{S}_{2}}=⟨5,1,2⟩-3⟨1,0,-1⟩=⟨2,1,5⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${S}_{1}(8,1,-1)$ and ${S}_{2}(2,1,5).$" "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}\\mathbf{r} & =\\mathbf{p}+t\\mathbf{v} \\\\ \\mathbf{r} & =⟨5,1,2⟩+t⟨1,0,-1⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $S$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overrightarrow{OS} & =⟨5,1,2⟩+t⟨1,0,-1⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overrightarrow{PS} & =\\overrightarrow{OS}-\\overrightarrow{OP} \\\\  & =(⟨5,1,2⟩+t⟨1,0,-1⟩)-⟨5,1,2⟩ \\\\  & =t\\,⟨1,0,-1⟩ \\\\  & =⟨t,\\,0,\\,-t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PS=\\sqrt{18},$ we get:\n\n$$\n\\begin{aligned}SP & =\\sqrt{18} \\\\ |\\overrightarrow{PS}| & =\\sqrt{18} \\\\ |⟨t,\\,0,\\,-t⟩| & =\\sqrt{18} \\\\ \\sqrt{{t}^{2}+{0}^{2}+{t}^{2}} & =\\sqrt{18} \\\\ \\sqrt{2{t}^{2}} & =\\sqrt{18} \\\\ \\pm \\sqrt{2}t & =3\\sqrt{2} \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 3$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overrightarrow{O{S}_{1}}=⟨5,1,2⟩+3⟨1,0,-1⟩=⟨8,1,-1⟩, \\\\  & \\overrightarrow{O{S}_{2}}=⟨5,1,2⟩-3⟨1,0,-1⟩=⟨2,1,5⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${S}_{1}(8,1,-1)$ and ${S}_{2}(2,1,5).$"] [:db/cas 17592186105466 :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(-2\\,i+5\\,j-k)-(-4\\,i+j+2\\,k) \\\\  & =2\\,i+4\\,j-3\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\mathbf{r} = \\mathbf{p} + t \\mathbf{v} \n\\qquad\\Longrightarrow\\qquad\n\\mathbf{r} = (-4 \\, \\mathbf{i} + \\mathbf{j} + 2\\,\\mathbf{k}) + t (2 \\, \\mathbf{i} + 4 \\, \\mathbf{j} - 3 \\, \\mathbf{k})\n$$\n\nand the parametrization of the line segment $\\overline{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(-4\\,i+j+2\\,k)+t(2\\,i+4\\,j-3\\,k) \\\\  & =(2t-4)\\,i+(4t+1)\\,j+(2-3t)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$" "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}\\mathbf{v} & =\\overrightarrow{PQ} \\\\  & =\\overrightarrow{OQ}-\\overrightarrow{OP} \\\\  & =(-2\\,\\mathbf{i}+5\\,\\mathbf{j}-\\mathbf{k})-(-4\\,\\mathbf{i}+\\mathbf{j}+2\\,\\mathbf{k}) \\\\  & =2\\,\\mathbf{i}+4\\,\\mathbf{j}-3\\,\\mathbf{k}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\mathbf{r} = \\mathbf{p} + t \\mathbf{v} \n\\qquad\\Longrightarrow\\qquad\n\\mathbf{r} = (-4 \\, \\mathbf{i} + \\mathbf{j} + 2\\,\\mathbf{k}) + t (2 \\, \\mathbf{i} + 4 \\, \\mathbf{j} - 3 \\, \\mathbf{k})\n$$\n\nand the parametrization of the line segment $\\overline{PQ}$ is\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =(-4\\,\\mathbf{i}+\\mathbf{j}+2\\,\\mathbf{k})+t(2\\,\\mathbf{i}+4\\,\\mathbf{j}-3\\,\\mathbf{k}) \\\\  & =(2t-4)\\,\\mathbf{i}+(4t+1)\\,\\mathbf{j}+(2-3t)\\,\\mathbf{k},\\,t\\in [0,1].\\end{aligned}\n$$"] [:db/cas 17592186106065 :question/problem "The equation below describes all the points on the line segment $PQ^(―)$, where $P(1, 4,-2)$ and $Q(-2, 3, 1)$.\n$$\n\\displaystyle r(t) = \\begin{bmatrix}1 \\\\ a \\\\ -2\\end{bmatrix} + t\\begin{bmatrix}b \\\\ -1 \\\\ 3\\end{bmatrix}, t ∈ [0, c]\n$$\nWhat is the value of $a + b + c$?" "The equation below describes all the points on the line segment $\\overline{PQ}$, where $P(1, 4,-2)$ and $Q(-2, 3, 1)$.\n$$\n\\displaystyle \\mathbf{r}(t) = \\begin{bmatrix}1 \\\\ a \\\\ -2\\end{bmatrix} + t\\begin{bmatrix}b \\\\ -1 \\\\ 3\\end{bmatrix}, t ∈ [0, c]\n$$\nWhat is the value of $a + b + c$?"] [:db/cas 17592186106066 :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(1,0,3)$ and $Q(1,2,0).$\n\n$$\nr(t)=i+a\\,j+b\\,k,\\,t\\in [c,1]\n$$\n\nWhat is $a+b+c?$" "The equation below gives a parametrization of the line segment $\\overline{PQ},$ where $P(1,0,3)$ and $Q(1,2,0).$\n\n$$\n\\mathbf{r}(t)=\\mathbf{i}+a\\,\\mathbf{j}+b\\,\\mathbf{k},\\,t\\in [c,1]\n$$\n\nWhat is $a+b+c?$"] [:db/cas 17592186106066 :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(i+2\\,j)-(i+3\\,k) \\\\  & =2\\,j-3\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(i+3\\,k)+t(2\\,j-3\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(i+3\\,k)+t(2\\,j-3\\,k) \\\\  & =i+2t\\,j+(3-3t)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=2t+(3-3t)+0=3-t.\n$$" "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}\\mathbf{v} & =\\overrightarrow{PQ} \\\\  & =\\overrightarrow{OQ}