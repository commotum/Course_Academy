/type {:db/id #edb/ref 17592186045498} :answer/value "2y" :db/id #edb/ref 17592186551501} {:answer/id #uuid "d68ed1d2-c144-55a5-b34f-0e15b765bb1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}" :db/id #edb/ref 17592186551514} {:answer/id #uuid "f0b0b26e-1f07-54b8-8ab3-048abfbca64e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{y}^{2}" :db/id #edb/ref 17592186551518}] :answer-field/correct {:answer/id #uuid "f0b0b26e-1f07-54b8-8ab3-048abfbca64e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{y}^{2}" :db/id #edb/ref 17592186551518} :answer-field/id #uuid "051530dd-4f84-55f7-8b5d-04b74bb42cad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551474}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ddaa8e8-7863-5605-a361-7abca3dcce02" :question/problem "$$\nf(x,y)=⟨x,\\,y,\\,{{selection}}⟩\n$$\n\nThe vector-valued function $f(x,y)$ above parametrizes the parabolic cylinder defined in Cartesian coordinates as $2{y}^{2}=z.$ What is the third component of $f?$" :question/worked-solution "For any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(x,y) & =⟨x,y,z⟩ \\\\  & =⟨x,\\,y,\\,2{y}^{2}⟩\\end{aligned}\n$$\n\nwhere $x\\in (-\\infty ,\\infty )$ and $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the third component of $f$ is $2{y}^{2}.$"}] [{:db/id #edb/ref 17592186551503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0986a572-404b-53ff-84ea-b070d428e82b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8z" :db/id #edb/ref 17592186551475} {:answer/id #uuid "286ab5d2-72f6-5867-9f0a-922d180b8da3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8y" :db/id #edb/ref 17592186551479} {:answer/id #uuid "96a28711-f7b4-5c18-abd7-3ac5221780fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{y}^{2}" :db/id #edb/ref 17592186551502} {:answer/id #uuid "afdd10ba-0