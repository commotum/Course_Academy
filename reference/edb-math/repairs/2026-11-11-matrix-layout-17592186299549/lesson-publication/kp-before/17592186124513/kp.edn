swer-field/correct {:answer/id #uuid "28991ad5-1694-59d5-bbd8-a8dece7ab6bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -4 & 5 \\\\ 6 & 3 & -2 \\\\ -8 & -1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186591848} :answer-field/id #uuid "45b3f16d-ba18-5ad4-9d49-0c927859d985" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592180}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5be5ee31-db76-542c-9cfc-7814b2fd2271" :question/math-academy-id "q-37920" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}5z-4y+2x \\\\ 3y-2z+6x \\\\ 4z-8x-y\\end{bmatrix}.\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x-4y+5z \\\\ 6x+3y-2z \\\\ -8x-y+4z\\end{bmatrix}\n$$\n\nWe require a $3\\times 3$ matrix $T$ such that\n    \n\n$$\nT\\cdot \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2x-4y+5z \\\\ 6x+3y-2z \\\\ -8x-y+4z\\end{bmatrix}.\n$$\n\nNotice that\n    \n\n$$\n\\begin{bmatrix}2 & -4 & 5 \\\\ 6 & 3 & -2 \\\\ -8 & -1 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2x-4y+5z \\\\ 6x+3y-2z \\\\ -8x-y+4z\\end{bmatrix}.\n$$\n\nHence, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n\\begin{bmatrix}2 & -4 & 5 \\\\ 6 & 3 & -2 \\\\ -8 & -1 & 4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186604085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec8a24e-e05d-53a4-bfa8-e2e796d3e533" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186603287} {:answer/id #uuid "6cde4cf1-2cc8-5821-9619-d6958a52d025" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186603492} {:answer/id #uuid "6fb1fa6f-7e8f-5e9c-8507-eb982c9068ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 5 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186603502} {:answer/id #uuid "911115a0-eefd-5e35-b777-730d98b9f83a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186603581} {:answer/id #uuid "ae32b90d-ca8a-56ec-8b88-06006f9e6e9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186603641}] :answer-field/correct {:answer/id #uuid "6cde4cf1-2cc8-5821-9619-d6958a52d025" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186603492} :answer-field/id #uuid "a7d64157-dbff-5892-9e7b-f93fd543d0e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186603938}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ea4ddfe1-6530-5b8a-8f88-f00718e1ad64" :question/math-academy-id "q-168110" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x \\\\ y-x\\end{bmatrix}.\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x \\\\ -x+y\\end{bmatrix}\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5x \\\\ -x+y\\end{bmatrix}.\n$$\n\nNotice that\n    \n\n$$\n\\begin{bmatrix}5 & 0 \\\\ -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5x \\\\ -x+y\\end{bmatrix}.\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n\\begin{bmatrix}5 & 0 \\\\ -1 & 1\\end{bmatrix}.\n$$"}] :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}]}
