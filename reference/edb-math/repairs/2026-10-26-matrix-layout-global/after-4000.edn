& 1\\end{bmatrix}\\cdot A"] [17592186555356 :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555384 :answer/value "\\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555391 :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}"] [17592186555392 :answer/value "x(t)={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix}{e}^{-9t}"] [17592186555395 :answer/value "$D=\\begin{bmatrix}5 & 0 \\\\ 0 & 10\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}$"] [17592186555398 :answer/value "$D=\\begin{bmatrix}9 & 0 \\\\ 0 & -8\\end{bmatrix}$ and $P=\\begin{bmatrix}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}$"] [17592186555399 :answer/value "\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot A"] [17592186555440 :answer/value "\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot A"] [17592186555457 :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555463 :answer/value "$D=\\begin{bmatrix}9 & 0 \\\\ 0 & -8\\end{bmatrix}$ and $P=\\begin{bmatrix}-2 & 1 \\\\ 1 & 2\\end{bmatrix}$"] [17592186555478 :answer/value "$D=\\begin{bmatrix}5 & 0 \\\\ 0 & 10\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$"] [17592186555484 :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ \\frac{2}{5} & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555490 :answer/value "$\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}$\nand\n$\\begin{bmatrix}-\\frac{1}{2} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{2}\\end{bmatrix}$"] [17592186555494 :answer/value "\\begin{bmatrix}2\\operatorname{cosh}⁡(5t) \\\\ -2\\operatorname{sinh}⁡(5t)\\end{bmatrix}"] [17592186555507 :answer/value "$D=\\begin{bmatrix}7 & 0 \\\\ 0 & -8\\end{bmatrix}$ and $P=\\begin{bmatrix}-4 & 1 \\\\ 1 & 4\\end{bmatrix}$"] [17592186555525 :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555527 :answer/value "\\begin{bmatrix}\\frac{3}{7} \\\\ \\frac{2}{7} \\\\ -\\frac{6}{7}\\end{bmatrix}"] [17592186555528 :answer/value "\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ 2\\operatorname{sinh}⁡(5t)\\end{bmatrix}"] [17592186555529 :answer/value "$\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}$\nand\n$\\begin{bmatrix}-\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{bmatrix}$"] [17592186555561 :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555562 :answer/value "\\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555567 :answer/value "\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555571 :answer/value "\\begin{bmatrix}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [17592186555590 :answer/value "$\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ -\\frac{\\sqrt{2}}{3}\\end{bmatrix}$\nand\n$\\begin{bmatrix}-\\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{2}\\end{bmatrix}$"] [17592186555591 :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{2}{5}\\end{bmatrix}\\cdot A"] [17592186555593 :answer/value "\\begin{bmatrix}2 \\\\ 3 \\\\ -1\\end{bmatrix}"] [17592186555612 :answer/value "$D=\\begin{bmatrix}9 & 0 \\\\ 0 & -5\\end{bmatrix}$ and $P=\\begin{bmatrix}-\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{bmatrix}$"] [17592186555614 :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{5}{2}\\end{bmatrix}\\cdot A"] [17592186555627 :answer/value "$D=\\begin{bmatrix}9 & 0 \\\\ 0 & -8\\end{bmatrix}$ and $P=\\begin{bmatrix}-\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{bmatrix}$"] [17592186555758 :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}-5 \\\\ 2\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & -2 \\\\ -2 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nFind the distribution of $Y={X}_{1}-{X}_{2}.$"] [17592186555758 :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{bmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=-5$ and ${\\mu }_{2}=2.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}-{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]-\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}-{\\mu }_{2} \\\\  & =-5-2 \\\\  & =-7.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=3,{\\sigma }_{2}^{2}=7,$ and ${\\sigma }_{12}={\\sigma }_{21}=-2.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[{X}_{1}-{X}_{2}] \\\\  & ={1}^{2}\\cdot 3+(-1)^{2}\\cdot 7+2\\cdot 1\\cdot (-1)\\cdot (-2) \\\\  & =3+7+4 \\\\  & =14.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-7,14).\n$$"] [17592186555759 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=9y(t) \\\\ {y}^{′}(t)=9x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: $$\n\\displaystyle {e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{bmatrix},\n$$ where $$\n\\displaystyle A=\\begin{bmatrix}0 & 9 \\\\ 9 & 0\\end{bmatrix}.\n$$*"] [17592186555759 :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 9 \\\\ 9 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $$\n\\displaystyle x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.\n$$ So, the matrix of the system is $$\n\\displaystyle A=\\begin{bmatrix}0 & 9 \\\\ 9 & 0\\end{bmatrix}.\n$$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{bmatrix}.\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{bmatrix}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} \\\\  & ={c}_{1}\\begin{bmatrix}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"] [17592186555762 :question/problem "Consider $$\n\\displaystyle E=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left."] [17592186555762 :question/worked-solution "The given matrix $E$ is obtained by multiplying the second row of ${I}_{3}$ by $-\\frac{1}{3}:$\n\n$$\n\\begin{aligned}{I}_{3} & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{2}:=-\\frac{1}{3}{R}_{2}$ to $A.$"] [17592186555769 :question/problem "Given that\n$$\n\\displaystyle A=\\begin{bmatrix}-2 & -8 \\\\ -1 & -4\\end{bmatrix}\n$$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$"] [17592186555769 :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-2 & -8 \\\\ -1 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\left(-\\frac{1}{2}\\right){R}_{1}\\,⟺\\,\\overbrace{\\begin{bmatrix}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{bmatrix}}^{{E}_{1}}\\cdot A \\\\  & ∼\\begin{bmatrix}-2 & -8 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{bmatrix}}^{-1}U \\\\ A & =\\underbrace{\\begin{bmatrix}1 & 0 \\\\ \\frac{1}{2} & 1\\end{bmatrix}}_{L}\\underbrace{\\begin{bmatrix}-2 & -8 \\\\ 0 & 0\\end{bmatrix}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=\\frac{1}{2},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=\\frac{1}{2}.$"] [17592186555771 :question/problem "$$\nP=\\begin{bmatrix}\\,∗\\, & \\frac{6}{7} & -\\frac{2}{7} \\\\ \\,∗\\, & -\\frac{2}{7} & \\frac{3}{7} \\\\ \\,∗\\, & \\frac{3}{7} & \\frac{6}{7}\\end{bmatrix}\n$$\n\nConsider the matrix $P$ shown above. Given that $A=PD{P}^{T}$ is an orthogonal diagonalization of a $3\\times 3$ symmetric matrix $A$ for some diagonal matrix $D,$ which of the following could be the first column of the matrix $P?$"] [17592186555771 :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix.\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nSince  $A=PD{P}^{T}$ is an orthogonal diagonalization of a $3\\times 3$ symmetric matrix $A,$ the matrix $P$ must be a $3\\times 3$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second and third columns, and\n\n- the norm of the first column must be equal to $1.$\n\nAmong the given options, only the vector $$\n\\displaystyle \\begin{bmatrix}\\frac{3}{7} \\\\ \\frac{6}{7} \\\\ -\\frac{2}{7}\\end{bmatrix}\n$$ has both properties."] [17592186555774 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=5y(t) \\\\ {y}^{′}(t)=5x(t),\\end{aligned}\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: $$\n\\displaystyle {e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{bmatrix},\n$$ where $$\n\\displaystyle A=\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}.\n$$*"] [17592186555774 :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $$\n\\displaystyle x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.\n$$ So, the matrix of the system is $$\n\\displaystyle A=\\begin{bmatrix}0 & 5 \\\\ 5 & 0\\end{bmatrix}.\n$$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{bmatrix}.\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\operatorname{cosh}⁡(5t) \\\\ -2\\operatorname{sinh}⁡(5t)\\end{bmatrix}.\\end{aligned}\n$$"] [17592186555780 :question/problem "Consider $$\n\\displaystyle E=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left."] [17592186555780 :question/worked-solution "The given matrix $E$ is obtained by taking the first row of ${I}_{3}$ and subtracting the third row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}-{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}-{R}_{3}$ to $A.$"] [17592186555784 :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & -2 \\\\ -2 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFind the distribution of $Y=-5{X}_{1}-4{X}_{2}.$"] [17592186555784 :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{bmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=1$ and ${\\mu }_{2}=-1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[-5{X}_{1}-4{X}_{2}] \\\\  & =-5\\text{E}[{X}_{1}]-4\\text{E}[{X}_{2}] \\\\  & =-5\\cdot {\\mu }_{1}-4\\cdot {\\mu }_{2} \\\\  & =-5\\cdot 1-4\\cdot (-1) \\\\  & =-5+4 \\\\  & =-1\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=3,{\\sigma }_{2}^{2}=2,$ and ${\\sigma }_{12}={\\sigma }_{21}=-2.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[-5{X}_{1}-4{X}_{2}] \\\\  & =(-5)^{2}\\cdot 3+(-4)^{2}\\cdot 2+2\\cdot (-5)\\cdot (-4)\\cdot (-2) \\\\  & =75+32-80 \\\\  & =27.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-1,27).\n$$"] [17592186555789 :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nI. $$\n\\displaystyle \\{\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}\n$$ is a linearly independent set in ${\\text{M}}_{2}(R)$\n\nII. $$\n\\displaystyle \\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}\n$$ can be expressed as a linear combination of $$\n\\displaystyle \\{\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}\n$$\n\nIII. $$\n\\displaystyle \\{\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}\n$$ is a basis of ${\\text{M}}_{2}(R)$"] [17592186555789 :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is false. Notice that\n\n$$\n0\\cdot \\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix}+1\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}+1\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nwhere some coefficients are nonzero, so the set is linearly dependent.\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}=(-1)\\cdot \\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix}+0\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\n- Statement III is false. Since the set is not linearly independent, it can't form a basis.\n\nTherefore, the correct answer is \"II only.\""] [17592186555791 :question/problem "Consider $$\n\\displaystyle E=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 7 & 0 & 1\\end{bmatrix}\n$$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left."] [17592186555791 :question/worked-solution "The given matrix $E$ is obtained by taking the third row of ${I}_{3}$ and adding $7$ times the first row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 7 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{3}:={R}_{3}+7{R}_{1}$ to $A.$"] [17592186555795 :question/problem "Given that\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 2 \\\\ 7 & 9\\end{bmatrix}\n$$ \nhas the LU decomposition $A=LU$, then ${l}_{21}\\cdot {u}_{22}=$"] [17592186555795 :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 \\\\ 7 & 9\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-7){R}_{1}\\,⟺\\,\\overbrace{\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix}}^{{E}_{1}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & 2 \\\\ 0 & -5\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix}}^{-1}U \\\\ A & =\\underbrace{\\begin{bmatrix}1 & 0 \\\\ 7 & 1\\end{bmatrix}}_{L}\\underbrace{\\begin{bmatrix}1 & 2 \\\\ 0 & -5\\end{bmatrix}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=7,{u}_{22}=-5,$ and ${l}_{21}\\cdot {u}_{12}=-35.$"] [17592186555797 :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{3}:=\\frac{2}{5}{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :=\\frac{2}{5}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{2}{5}\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{2}{5}\\end{bmatrix}\\cdot A\n$$"] [17592186555802 :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}-1 \\\\ 1 \\\\ 4\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 2 & 1 \\\\ 2 & 6 & 2 \\\\ 1 & 2 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nLet $Y=2{X}_{1}-{X}_{2}-{X}_{3}.$ Find $P(Y\\le -2).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.7\\,$ | $\\,0.7580\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ | $\\,0.7673\\,$ |\n| $\\,0.8\\,$ | $\\,0.7881\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ | $\\,0.7967\\,$ |\n| $\\,0.9\\,$ | $\\,0.8159\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ | $\\,0.8238\\,$ |\n| $\\,1.0\\,$ | $\\,0.8413\\,$ | $\\,0.8438\\,$ | $\\,0.8461\\,$ | $\\,0.8485\\,$ |"] [17592186555802 :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y=2{X}_{1}-{X}_{2}-{X}_{3},$ we have \n\n$$\nc=\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}.\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =\\begin{bmatrix}2 & -1 & -1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1 \\\\ 4\\end{bmatrix} \\\\  & =-2-1-4 \\\\  & =-7,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =\\begin{bmatrix}2 & -1 & -1\\end{bmatrix}\\begin{bmatrix}5 & 2 & 1 \\\\ 2 & 6 & 2 \\\\ 1 & 2 & 7\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 & -1\\end{bmatrix}\\begin{bmatrix}7 \\\\ -4 \\\\ -7\\end{bmatrix} \\\\  & =14+4+7 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-7,25).\n$$\n\nNow, we need to compute $P(Y\\le -2).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\le -2) & =P(Z\\le \\frac{-2-(-7)}{\\sqrt{25}}) \\\\  & =P(Z\\le 1)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(Z\\le 1) & =Φ(1).\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\nΦ(1)=0.8413.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P(Z\\le 1)=0.8413.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(Y\\le -2)=0.8413.\n$$"] [17592186555805 :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & -1 & 1 \\\\ -1 & 4 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nLet $Y=2{X}_{1}+{X}_{2}+2{X}_{3}.$ Find $P(-6<Y\\le 12).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.7\\,$</th><td align=\"center\"> $\\,0.7673\\,$ </td><td align=\"center\"> $\\,0.7704\\,$ </td><td align=\"center\"> $\\,0.7734\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.8\\,$</th><td align=\"center\"> $\\,0.7967\\,$ </td><td align=\"center\"> $\\,0.7995\\,$ </td><td align=\"center\"> $\\,0.8023\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.9\\,$</th><td align=\"center\"> $\\,0.8238\\,$ </td><td align=\"center\"> $\\,0.8264\\,$ </td><td align=\"center\"> $\\,0.8289\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.7\\,$</th><td align=\"center\"> $\\,0.9554\\,$ </td><td align=\"center\"> $\\,0.9564\\,$ </td><td align=\"center\"> $\\,0.9573\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.8\\,$</th><td align=\"center\"> $\\,0.9641\\,$ </td><td align=\"center\"> $\\,0.9649\\,$ </td><td align=\"center\"> $\\,0.9656\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.9\\,$</th><td align=\"center\"> $\\,0.9713\\,$ </td><td align=\"center\"> $\\,0.9719\\,$ </td><td align=\"center\"> $\\,0.9726\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>"] [17592186555805 :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y=2{X}_{1}+{X}_{2}+2{X}_{3},$ we have \n\n$$\nc=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =\\begin{bmatrix}2 & 1 & 2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =-2+0+2 \\\\  & =0,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =\\begin{bmatrix}2 & 1 & 2\\end{bmatrix}\\begin{bmatrix}3 & -1 & 1 \\\\ -1 & 4 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 2\\end{bmatrix}\\begin{bmatrix}7 \\\\ 6 \\\\ 10\\end{bmatrix} \\\\  & =14+6+20 \\\\  & =40.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(0,40).\n$$\n\nNow, we need to compute $P(-6<Y\\le 12).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(-6<Y\\le 12) & =P(\\frac{-6-0}{\\sqrt{40}}<Z\\le \\frac{12-0}{\\sqrt{40}}) \\\\  & =P(-0.95<Z\\le 1.90)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.95<Z\\le 1.90) & =P(Z\\le 1.90)-P(Z\\le -0.95) \\\\  & =Φ(1.90)-Φ(-0.95).\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\n\\begin{aligned}Φ(0.95) & =0.8289 \\\\ Φ(1.90) & =0.9713\\end{aligned}\n$$\n\nBy the symmetry of the normal distribution, we have\n\n$$\nΦ(-0.95)=1-Φ(0.95)=1-0.8289=0.1711.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P(-0.95<Z\\le 1.90)=0.9713-0.1711=0.8002.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(-6<Y\\le 12)=0.8002.\n$$"] [17592186555807 :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\nI. $$\n\\displaystyle A=\\begin{bmatrix}1 & 0 \\\\ -9 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nII. $$\n\\displaystyle A=\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}\\begin{bmatrix}7 & 0 \\\\ 0 & 8\\end{bmatrix}\n$$\n\nIII. $$\n\\displaystyle A=\\begin{bmatrix}3 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 6 & 1\\end{bmatrix}\n$$"] [17592186555807 :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nA=\\overbrace{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}^{L}\\cdot \\overbrace{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}^{U}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ -9 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 0 & 1\\end{bmatrix}\\,✓\n$$\n\n- The second product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}\\begin{bmatrix}7 & 0 \\\\ 0 & 8\\end{bmatrix}\\,✓\n$$\n\n- The third product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nA=\\begin{bmatrix}3 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 6 & 1\\end{bmatrix}\\,\\times \n$$\n\nTherefore, the correct answer is \"I and II only\"."] [17592186555812 :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+2{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+2{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"] [17592186555828 :question/problem "$$\nP=\\begin{bmatrix}0.4 & 0.7 & 0.25 \\\\ 0.2 & 0.1 & 0.65 \\\\ 0.4 & 0.2 & 0.1\\end{bmatrix},\\,q=\\begin{bmatrix}\\frac{17}{38} \\\\ \\frac{11}{38} \\\\ \\frac{5}{19}\\end{bmatrix}\n$$\n\nConsider the stochastic matrix $P$ and vector $q$ shown above. Which of the following statements are true?\n\nI. $q$ is a stochastic vector\n\nII. $Pq=q$\n\nIII. $q$ is a steady-state vector of $P$"] [17592186555828 :question/worked-solution "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that $Pq=q.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, $q$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement II is true. Indeed, we have \n\n$$\nPq=\\begin{bmatrix}0.4 & 0.7 & 0.25 \\\\ 0.2 & 0.1 & 0.65 \\\\ 0.4 & 0.2 & 0.1\\end{bmatrix}\\begin{bmatrix}\\frac{17}{38} \\\\ \\frac{11}{38} \\\\ \\frac{5}{19}\\end{bmatrix}=\\begin{bmatrix}\\frac{6.8}{38}+\\frac{7.7}{38}+\\frac{1.25}{19} \\\\ \\frac{3.4}{38}+\\frac{1.1}{38}+\\frac{3.25}{19} \\\\ \\frac{6.8}{38}+\\frac{2.2}{38}+\\frac{0.5}{19}\\end{bmatrix}=\\begin{bmatrix}\\frac{17}{38} \\\\ \\frac{11}{38} \\\\ \\frac{5}{19}\\end{bmatrix}=q.\n$$\n\n- Statement III is true. Indeed, $q$ is a stochastic vector such that $Pq=q.$ So, it's a steady-state vector of $P.$\n\nTherefore, the correct answer is \"I, II, and III.\""] [17592186555834 :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{3}:={R}_{3}-4{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{1}:=-8{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :=-8{R}_{1} \\\\  & ∼\\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n\\begin{bmatrix}-8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"] [17592186555847 :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nI. $$\n\\displaystyle \\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\}\n$$ is a linearly independent set in ${\\text{M}}_{2}(R)$\n\nII. $$\n\\displaystyle \\begin{bmatrix}2 & 3 \\\\ 0 & 2\\end{bmatrix}\n$$ can be expressed as a linear combination of $$\n\\displaystyle \\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\}\n$$\n\nIII. $$\n\\displaystyle \\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\}\n$$ is a basis of ${\\text{M}}_{2}(R)$"] [17592186555847 :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation\n\n$$\n{x}_{1}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+{x}_{2}\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+{x}_{3}\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nis true if and only if ${x}_{1}={x}_{2}={x}_{3}=0.$ So the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 0 & 2\\end{bmatrix}=2\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+3\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+0\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\n- Statement III is false. For example, the matrix $$\n\\displaystyle \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$ can't be written as a linear combination of \n\n$$\n\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\}\n$$\n\nsince all these linear combinations result in matrices with the entry ${a}_{11}={a}_{22}:$\n\n$$\na\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+b\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+c\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ c & a\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"I and II only.\""]}
