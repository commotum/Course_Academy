\frac{1}{2v}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{3}^{7}\\,\\text{d}u{\\int }_{3}^{5}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (7-3)\\cdot (\\operatorname{ln}⁡5-\\operatorname{ln}⁡3) \\\\  & =2\\operatorname{ln}⁡\\frac{5}{3}\\end{aligned}\n$$"] [17592186557881 :answer/value "\\begin{bmatrix}15 & 2 \\\\ 10 & 5 \\\\ 8 & 9 \\\\ 7 & 14 \\\\ 3 & 20\\end{bmatrix}"] [17592186557883 :answer/value "\\begin{bmatrix}1 & 2 & -10 \\\\ 2 & 4 & -8 \\\\ 4 & 6 & -5 \\\\ 8 & 8 & -1 \\\\ 16 & 10 & 2\\end{bmatrix}"] [17592186557885 :answer/value "\\begin{bmatrix}1 & 0 & {0}^{2} \\\\ 1 & 2 & {2}^{2} \\\\ 1 & 4 & {4}^{2} \\\\ 1 & 6 & {6}^{2} \\\\ 1 & 8 & {8}^{2}\\end{bmatrix}"] [17592186557893 :answer/value "\\begin{bmatrix}1 & 13 & {13}^{2} \\\\ 1 & -4 & (-4)^{2} \\\\ 1 & -18 & (-18)^{2} \\\\ 1 & -10 & (-10)^{2} \\\\ 1 & 11 & {11}^{2}\\end{bmatrix}"] [17592186557899 :answer/value "\\begin{bmatrix}1 & -2 & 15 \\\\ 1 & -1 & 19 \\\\ 1 & 0 & 25 \\\\ 1 & 1 & 17 \\\\ 1 & 2 & 32\\end{bmatrix}"] [17592186557905 :answer/value "\\begin{bmatrix}-2 \\\\ -1 \\\\ 0 \\\\ 1 \\\\ 2\\end{bmatrix}"] [17592186557916 :answer/value "y=\\begin{bmatrix}-1 \\\\ 8 \\\\ 5\\end{bmatrix}"] [17592186557946 :answer/value "\\begin{bmatrix}1 \\\\ 2 \\\\ 3 \\\\ 4 \\\\ 5\\end{bmatrix}"] [17592186557947 :answer/value "\\begin{bmatrix}5 \\\\ 10 \\\\ 16 \\\\ 22 \\\\ 30\\end{bmatrix}"] [17592186557963 :answer/value "y=\\begin{bmatrix}-1 \\\\ 2 \\\\ -8\\end{bmatrix}"] [17592186557976 :answer/value "\\begin{bmatrix}-8 \\\\ -6 \\\\ -4 \\\\ -1 \\\\ 2\\end{bmatrix}"] [17592186557989 :answer/value "\\begin{bmatrix}-2 & 15 \\\\ -1 & 19 \\\\ 0 & 25 \\\\ 1 & 17 \\\\ 2 & 32\\end{bmatrix}"] [17592186558015 :answer/value "\\begin{bmatrix}1 \\\\ 2 \\\\ 3 \\\\ 4 \\\\ 5\\end{bmatrix}"] [17592186558017 :answer/value "$$\n\\begin{bmatrix}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4 \\\\ 1 & 5\\end{bmatrix}\n$$"] [17592186558019 :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}"] [17592186558074 :answer/valu