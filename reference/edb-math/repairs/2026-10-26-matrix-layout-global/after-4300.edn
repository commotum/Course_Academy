ft(\\frac{64}{3}\\right))) \\\\ &=\\frac{1}{10}\\left(\\frac{256}{3}\\right) \\\\ &=\\frac{128}{15}\\end{aligned}\n$$"] [17592186558904 :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=5 x - 2 y,\\,v=x + y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nSubstituting $5 x - 2 y=u$ and $x + y=v$ into the equation of the first curve, we get\n\n$$\n(5 x - 2 y)^{2}-(x + y)=0\\,⟹\\,u^{2}-v=0\\,⟹\\,v=u^{2}.\n$$\n\nwhile substituting $x + y=v$ into the equation of the second curve, we obtain\n\n$$\nv=1.\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v=u^{2} \\\\ v=1\\end{aligned}\\right.\\,⟹\\,u=\\pm 1\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 1,1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,u^{2}\\le v\\le 1\\}.\n$$\n\n![](images/39/39d20dd045c97cae079f3839b4db071bd6b3b9ff133299ed4ae4d9421a55fee8.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x}&\\frac{∂u}{∂y}\\\\\\frac{∂v}{∂x}&\\frac{∂v}{∂y}\\end{vmatrix} \\\\ &=\\begin{vmatrix}5&-2\\\\1&1\\end{vmatrix} \\\\ &=7\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(7)^{-1}=\\frac{1}{7}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}\\iint_D dxdy &=\\iint_Δ |\\frac{∂(x,y)}{∂(u,v)}|\\,dudv \\\\ &=\\iint_Δ |\\frac{1}{7}|\\,dudv \\\\ &=\\frac{1}{7}\\int_{-1}^{1}[\\int_{u^{2}}^{1}dv]du \\\\ &=\\frac{1}{7}\\int_{-1}^{1}[v]_{u^{2}}^{1}du \\\\ &=\\frac{1}{7}\\int_{-1}^{1}(1)-(u^{2})du \\\\ &=\\frac{1}{7}\\int_{-1}^{1}(1 - u^{2})du \\\\ &=\\frac{1}{7}[- \\frac{u^{3}}{3} + u]_{-1}^{1} \\\\ &=\\frac{1}{7}(((1)+\\left(- \\frac{1}{3}\\right))-((-1)+\\left(\\frac{1}{3}\\right))) \\\\ &=\\frac{1}{7}\\left(\\frac{4}{3}\\right) \\\\ &=\\frac{4}{21}\\end{aligned}\n$$"] [17592186558917 :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=8 x - 2 y,\\,v=x + y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nSubstituting $8 x - 2 y=u$ and $x + y=v$ into the equation of the first curve, we get\n\n$$\n(8 x - 2 y)^{2}-(x + y)=0\\,⟹\\,u^{2}-v=0\\,⟹\\,v=u^{2}.\n$$\n\nwhile substituting $x + y=v$ into the equation of the second curve, we obtain\n\n$$\nv=9.\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v=u^{2} \\\\ v=9\\end{aligned}\\right.\\,⟹\\,u=\\pm 3\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 3,9).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-3\\le u\\le 3,\\,u^{2}\\le v\\le 9\\}.\n$$\n\n![](images/18/18c4c61a55dd2a361b82a208eb9a0d26f3fcfa213fe83b05f23644c9f79becaa.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x}&\\frac{∂u}{∂y}\\\\\\frac{∂v}{∂x}&\\frac{∂v}{∂y}\\end{vmatrix} \\\\ &=\\begin{vmatrix}8&-2\\\\1&1\\end{vmatrix} \\\\ &=10\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(10)^{-1}=\\frac{1}{10}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}\\iint_D dxdy &=\\iint_Δ |\\frac{∂(x,y)}{∂(u,v)}|\\,dudv \\\\ &=\\iint_Δ |\\frac{1}{10}|\\,dudv \\\\ &=\\frac{1}{10}\\int_{-3}^{3}[\\int_{u^{2}}^{9}dv]du \\\\ &=\\frac{1}{10}\\int_{-3}^{3}[v]_{u^{2}}^{9}du \\\\ &=\\frac{1}{10}\\int_{-3}^{3}(9)-(u^{2})du \\\\ &=\\frac{1}{10}\\int_{-3}^{3}(9 - u^{2})du \\\\ &=\\frac{1}{10}[- \\frac{u^{3}}{3} + 9 u]_{-3}^{3} \\\\ &=\\frac{1}{10}(((27)+(-9))-((-27)+(9))) \\\\ &=\\frac{1}{10}(36) \\\\ &=\\frac{18}{5}\\end{aligned}\n$$"] [17592186558926 :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x - 4 y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nSubstituting $x - 4 y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n(x - 4 y)^{2}-(y)=4\\,⟹\\,u^{2}-v=4\\,⟹\\,v=u^{2} - 4.\n$$\n\nwhile substituting $y=v$ into the equation of the second curve, we obtain\n\n$$\nv=8.\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v=u^{2} - 4 \\\\ v=8\\end{aligned}\\right.\\,⟹\\,u=\\pm 2 \\sqrt{3}\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 2 \\sqrt{3},8).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,- 2 \\sqrt{3}\\le u\\le 2 \\sqrt{3},\\,u^{2} - 4\\le v\\le 8\\}.\n$$\n\n![](images/23/2369c3299b61f996c6203e1e45a7a62c74cf9e8f4691c2d0941bdeec0a5ae53c.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x}&\\frac{∂u}{∂y}\\\\\\frac{∂v}{∂x}&\\frac{∂v}{∂y}\\end{vmatrix} \\\\ &=\\begin{vmatrix}1&-4\\\\0&1\\end{vmatrix} \\\\ &=1\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(1)^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}\\iint_D dxdy &=\\iint_Δ |\\frac{∂(x,y)}{∂(u,v)}|\\,dudv \\\\ &=\\iint_Δ |1|\\,dudv \\\\ &=1\\int_{- 2 \\sqrt{3}}^{2 \\sqrt{3}}[\\int_{u^{2} - 4}^{8}dv]du \\\\ &=1\\int_{- 2 \\sqrt{3}}^{2 \\sqrt{3}}[v]_{u^{2} - 4}^{8}du \\\\ &=1\\int_{- 2 \\sqrt{3}}^{2 \\sqrt{3}}(8)-(u^{2} - 4)du \\\\ &=1\\int_{- 2 \\sqrt{3}}^{2 \\sqrt{3}}(12 - u^{2})du \\\\ &=1[- \\frac{u^{3}}{3} + 12 u]_{- 2 \\sqrt{3}}^{2 \\sqrt{3}} \\\\ &=1(((24 \\sqrt{3})+(- 8 \\sqrt{3}))-((- 24 \\sqrt{3})+(8 \\sqrt{3}))) \\\\ &=1(32 \\sqrt{3}) \\\\ &=32 \\sqrt{3}\\end{aligned}\n$$"] [17592186559020 :answer/value "\\begin{bmatrix}4 \\\\ -2 \\\\ 3 \\\\ 7\\text{ }\\end{bmatrix}"] [17592186559026 :answer/value "\\begin{bmatrix}4 \\\\ 13 \\\\ 18 \\\\ 18 \\\\ 0\\end{bmatrix}"] [17592186559038 :answer/value "\\begin{bmatrix}-5 \\\\ 1 \\\\ 1 \\\\ -6 \\\\ 3\\end{bmatrix}"] [17592186559051 :answer/value "\\begin{bmatrix}-13 \\\\ 7 \\\\ 3 \\\\ 0\\end{bmatrix}"] [17592186559068 :answer/value "\\begin{bmatrix}4 \\\\ 13 \\\\ 18 \\\\ 18\\end{bmatrix}"] [17592186559070 :answer/value "\\begin{bmatrix}-14 \\\\ 4 \\\\ 4 \\\\ -6 \\\\ 12\\end{bmatrix}"] [17592186559075 :answer/value "\\begin{bmatrix}-2 \\\\ 6 \\\\ -13 \\\\ -7\\end{bmatrix}"] [17592186559141 :answer/value "\\begin{bmatrix}-1 \\\\ -2 \\\\ 3 \\\\ 4 \\\\ 0\\end{bmatrix}"] [17592186559157 :answer/value "\\begin{vmatrix}0 & 0 \\\\ 0 & 0\\end{vmatrix}"] [17592186559159 :answer/value "\\begin{bmatrix}-5 \\\\ 11 \\\\ 6\\end{bmatrix}"] [17592186559188 :answer/value "C=\\begin{bmatrix}-5 & -8 \\\\ -5 & -9\\end{bmatrix}"] [17592186559191 :answer/value "\\begin{vmatrix}\\pi  & 0 \\\\ 0 & 0\\end{vmatrix}"] [17592186559195 :answer/value "C=\\begin{bmatrix}2 & -3 \\\\ -11 & -6\\end{bmatrix}"] [17592186559210 :answer/value "\\begin{bmatrix}-14 \\\\ 2 \\\\ 0\\end{bmatrix}"] [17592186559227 :answer/value "\\begin{bmatrix}2 \\\\ -6 \\\\ 0 \\\\ -20\\end{bmatrix}"] [17592186559251 :answer/value "\\begin{bmatrix}1 \\\\ -6 \\\\ 0 \\\\ -5\\end{bmatrix}"] [17592186559259 :answer/value "\\begin{bmatrix}-2 \\\\ 6 \\\\ -13 \\\\ -7 \\\\ -1\\end{bmatrix}"] [17592186559260 :answer/value "C=\\begin{bmatrix}-5 & -8 \\\\ 5 & 9\\end{bmatrix}"] [17592186559264 :answer/value "\\begin{bmatrix}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{bmatrix}"] [17592186559292 :answer/value "C=\\begin{bmatrix}5 & 0 \\\\ 5 & 9\\end{bmatrix}"] [17592186559299 :answer/value "\\begin{bmatrix}4 \\\\ -2 \\\\ 3 \\\\ 7 \\\\ -1\\end{bmatrix}"] [17592186559311 :answer/value "\\begin{vmatrix}0 & \\pi  \\\\ 1 & 0\\end{vmatrix}"] [17592186559325 :answer/value "C=\\begin{bmatrix}-3 & -4 \\\\ -9 & 2\\end{bmatrix}"] [17592186559347 :answer/value "\\begin{bmatrix}6 \\\\ 14 \\\\ 18 \\\\ 22\\end{bmatrix}"] [17592186559350 :answer/value "\\begin{bmatrix}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ 7\\end{bmatrix}"] [17592186559377 :answer/value "\\begin{bmatrix}1 \\\\ 2 \\\\ -3 \\\\ -4 \\\\ 0\\end{bmatrix}"] [17592186559384 :answer/value "C=\\begin{bmatrix}2 & -3 \\\\ 6 & -11\\end{bmatrix}"] [17592186559408 :answer/value "\\begin{bmatrix}2 \\\\ 10 \\\\ -2 \\\\ -4 \\\\ \\frac{7}{4}\\end{bmatrix}"] [17592186559416 :answer/value "\\begin{bmatrix}-4 \\\\ -8 \\\\ 12 \\\\ 16 \\\\ 0\\end{bmatrix}"] [17592186559427 :answer/value "\\begin{bmatrix}8 \\\\ 40 \\\\ -8 \\\\ -16 \\\\ \\frac{7}{4}\\end{bmatrix}"] [17592186559442 :answer/value "C=\\begin{bmatrix}-5 & -6 \\\\ -11 & -6\\end{bmatrix}"] [17592186559446 :answer/value "\\begin{bmatrix}-14 \\\\ 1 \\\\ 4 \\\\ -3 \\\\ 12\\end{bmatrix}"] [17592186559455 :answer/value "\\begin{bmatrix}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{bmatrix}"] [17592186559457 :answer/value "\\begin{bmatrix}6 \\\\ 14 \\\\ 18 \\\\ 22 \\\\ 0\\end{bmatrix}"] [17592186559526 :answer/value "\\begin{bmatrix}16 \\\\ 80 \\\\ -16 \\\\ -32 \\\\ 28\\end{bmatrix}"] [17592186559536 :answer/value "\\begin{vmatrix}-\\pi  & 0 \\\\ 2 & 0\\end{vmatrix}"] [17592186559546 :answer/value "\\begin{bmatrix}4 \\\\ 8 \\\\ -12 \\\\ -16 \\\\ 0\\end{bmatrix}"] [17592186559550 :answer/value "C=\\begin{bmatrix}-13 & -8 \\\\ 5 & -15\\end{bmatrix}"] [17592186559556 :answer/value "\\begin{bmatrix}-5 \\\\ 11 \\\\ 6 \\\\ 0\\end{bmatrix}"] [17592186559562 :answer/value "C=\\begin{bmatrix}-3 & 2 \\\\ 4 & 9\\end{bmatrix}"] [17592186559563 :answer/value "\\begin{bmatrix}2 \\\\ -6 \\\\ -2 \\\\ -20\\end{bmatrix}"] [17592186559565 :answer/value "\\begin{bmatrix}2 \\\\ -6 \\\\ -2 \\\\ -5\\end{bmatrix}"] [17592186559585 :answer/value "\\begin{bmatrix}-5 \\\\ 4 \\\\ 4 \\\\ -1 \\\\ 8\\end{bmatrix}"] [17592186559589 :answer/value "C=\\begin{bmatrix}-5 & 0 \\\\ -5 & 15\\end{bmatrix}"] [17592186559615 :answer/value "\\begin{bmatrix}-7 \\\\ 1 \\\\ 1 \\\\ -3 \\\\ 3\\end{bmatrix}"] [17592186559639 :answer/value "\\begin{bmatrix}1 \\\\ -2 \\\\ 3 \\\\ -4 \\\\ 0\\end{bmatrix}"] [17592186559772 :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+0-1=0\\,⟹\\,x=-1,\n$$\n\nand substituting $z=0$ into the second equation gives\n\n$$\ny+0+5=0\\,⟹\\,y=-5.\n$$\n\nTherefore, $a=⟨-1,-5,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+z-1=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,0,1⟩.$\n\n- For the plane $y+z+5=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨-1,0,1⟩\\times ⟨0,1,1⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ -1 & 0 & 1 \\\\ 0 & 1 & 1\\end{vmatrix} \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩\\end{aligned}\n$$\n\nThus, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-5,0⟩+t⟨-1,1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1+(-5)=-6,$ and $b=⟨-1,1,-1⟩.$"] [17592186559788 :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=\\begin{bmatrix}-1 & 2 \\\\ 0 & 3\\end{bmatrix},\\,{B}_{2}=\\begin{bmatrix}2 & 1 \\\\ 0 & -1\\end{bmatrix},\\,A=\\begin{bmatrix}-10 & 0 \\\\ 0 & 10\\end{bmatrix}\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $$\n\\displaystyle [A]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\n$$ then ${x}_{1}+{x}_{2}=$"] [17592186559788 :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}-1 & 2 \\\\ 0 & 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 & 1 \\\\ 0 & -1\\end{bmatrix} & =\\begin{bmatrix}-10 & 0 \\\\ 0 & 10\\end{bmatrix} \\\\ \\begin{bmatrix}-{x}_{1}+2{x}_{2} & 2{x}_{1}+{x}_{2} \\\\ 0 & 3{x}_{1}-{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-10 & 0 \\\\ 0 & 10\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}-{x}_{1}+2{x}_{2}=-10 \\\\ 2{x}_{1}+{x}_{2}=0 \\\\ 3{x}_{1}-{x}_{2}=10.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{array}{cc|c}-1 & 2 & -10 \\\\ 2 & 1 & 0 \\\\ 3 & -1 & 10\\end{array}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{array}{cc|c}-1 & 2 & -10 \\\\ 2 & 1 & 0 \\\\ 3 & -1 & 10\\end{array}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+3{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{array}{cc|c}-1 & 2 & -10 \\\\ 0 & 5 & -20 \\\\ 0 & 5 & -20\\end{array}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}+2{x}_{2}=-10 \\\\ 5{x}_{2}=-20\\end{aligned}\n$$\n\nFrom the second  equation, we get ${x}_{2}=-4.$ From the first equation, we get \n\n$$\n\\begin{aligned}-{x}_{1}+2(-4) & =-10 \\\\ -{x}_{1} & =-2 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\n \n\nTherefore, $$\n\\displaystyle [A]_{B}=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}+{x}_{2}=2+(-4)=-2.$"] [17592186559789 :question/problem "Let $$\n\\displaystyle b=\\begin{bmatrix}-2 \\\\ -4 \\\\ 6 \\\\ 8 \\\\ 0\\end{bmatrix}.\n$$ Find $-\\frac{1}{2}b.$"] [17592186559789 :question/worked-solution "Multiplying each component of $b$ by $-\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}-\\frac{1}{2}b & =-\\frac{1}{2}\\begin{bmatrix}-2 \\\\ -4 \\\\ 6 \\\\ 8 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{2}\\cdot (-2) \\\\ -\\frac{1}{2}\\cdot (-4) \\\\ -\\frac{1}{2}\\cdot 6 \\\\ -\\frac{1}{2}\\cdot 8 \\\\ -\\frac{1}{2}\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -3 \\\\ -4 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"] [17592186559791 :question/problem "Let $$\n\\displaystyle a=\\begin{bmatrix}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{bmatrix}.\n$$ Find $2a.$"] [17592186559791 :question/worked-solution "Multiplying each component of $a$ by $2,$ we get\n\n$$\n\\begin{aligned}2a & =2\\begin{bmatrix}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (-7) \\\\ 2\\cdot 2 \\\\ 2\\cdot 2 \\\\ 2\\cdot (-3) \\\\ 2\\cdot 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-14 \\\\ 4 \\\\ 4 \\\\ -6 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$"] [17592186559795 :question/problem "Let\n$$\n\\displaystyle r=\\begin{bmatrix}x-2 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{bmatrix}\n$$ and $$\n\\displaystyle s=\\begin{bmatrix}1 \\\\ 3 \\\\ x \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\nIf $r\\cdot s=7$, find the value of $x.$"] [17592186559803 :question/problem "Let $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ 2 \\\\ -5 \\\\ 0 \\\\ -1\\end{bmatrix}\n$$ and $$\n\\displaystyle c=\\begin{bmatrix}3 \\\\ -4 \\\\ 8 \\\\ 7\\end{bmatrix}.\n$$ Find $b+c.$"] [17592186559803 :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle b=\\begin{bmatrix}1 \\\\ 2 \\\\ -5 \\\\ 0 \\\\ -1\\end{bmatrix}\n$$ has $5$ components as it lies in ${R}^{5}.$\n\n- The vector $$\n\\displaystyle c=\\begin{bmatrix}3 \\\\ -4 \\\\ 8 \\\\ 7\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined."] [17592186559815 :question/problem "Consider the polynomials ${p}_{1}(t)$ and ${p}_{2}(t),$ given by\n\n$$\n{p}_{1}(t)=t-{t}^{3},\\,{p}_{2}(t)=2{t}^{2}+5{t}^{3}.\n$$\n\nFind $p(t)$ given that $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1},{p}_{2}\\},$ and the coordinates of $p(t)$ relative to $B$ are $$\n\\displaystyle [p(t)]_{B}=\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}.\n$$"] [17592186559815 :question/worked-solution "Any vector in  $\\text{Span}\\{{p}_{1},{p}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t).\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[p(t)]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}p(t) & =(-3)\\cdot (t-{t}^{3})+1\\cdot (2{t}^{2}+5{t}^{3}) \\\\  & =-3t+3{t}^{3}+2{t}^{2}+5{t}^{3} \\\\  & =-3t+2{t}^{2}+8{t}^{3}.\\end{aligned}\n$$"] [17592186559818 :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $$\n\\displaystyle x=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}\n$$ and \n$$\n\\displaystyle \\text{\\boldsymbol}f(x)=\\begin{bmatrix}{x}^{2}+4y-2x-3 \\\\ {x}^{2}-{y}^{2}+3y-3\\end{bmatrix}.\n$$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+4y-2x-3)=2x-2,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+4y-2x-3)=4 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}-{y}^{2}+3y-3)=2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}-{y}^{2}+3y-3)=-2y+3\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}2x-2 & 4 \\\\ 2x & -2y+3\\end{bmatrix}.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium $$\n\\displaystyle {x}^{∗}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=\\begin{bmatrix}2(1)-2 & 4 \\\\ 2(1) & -2(1)+3\\end{bmatrix}=\\begin{bmatrix}0 & 4 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=\\begin{bmatrix}0 & 4 \\\\ 2 & 1\\end{bmatrix}u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}x-1 \\\\ y-1\\end{bmatrix}.\n$$"] [17592186559834 :question/problem "Let $$\n\\displaystyle r=\\begin{bmatrix}3 \\\\ \\frac{2}{{x}^{2}} \\\\ 0 \\\\ x\\end{bmatrix}\n$$ and $$\n\\displaystyle s=\\begin{bmatrix}-1 \\\\ {x}^{4} \\\\ 8 \\\\ -1\\end{bmatrix}.\n$$\nIf $r\\cdot s=0$ and $x<0$, find the value of $x.$"] [17592186559836 :question/problem "Let $$\n\\displaystyle r=\\begin{bmatrix}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{bmatrix}\n$$ and $$\n\\displaystyle s=\\begin{bmatrix}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{bmatrix}.\n$$ What is $r\\cdot s?$"] [17592186559836 :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle r=\\begin{bmatrix}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\n- The vector $$\n\\displaystyle s=\\begin{bmatrix}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{bmatrix}\n$$ has $5$ components as it lies in ${R}^{5}.$\n\nTherefore, since the number of components does not match, the operation is undefined."] [17592186559840 :question/problem "Let $$\n\\displaystyle u=\\begin{bmatrix}1 \\\\ 3 \\\\ 2 \\\\ 6\\end{bmatrix}\n$$ and $$\n\\displaystyle v=\\begin{bmatrix}k \\\\ 4 \\\\ -5 \\\\ k+2\\end{bmatrix}.\n$$ If $u\\cdot v=0$, find the value of $k.$"] [17592186559845 :question/problem "Let $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 6 \\\\ 9 \\\\ 7 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle w=\\begin{bmatrix}8 \\\\ 4 \\\\ 0 \\\\ 16\\end{bmatrix}.\n$$ Find $2v+\\frac{1}{4}w.$"] [17592186559845 :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 6 \\\\ 9 \\\\ 7 \\\\ 0\\end{bmatrix}\n$$ has $5$ components as it lies in ${R}^{5}.$\n\n- The vector $$\n\\displaystyle w=\\begin{bmatrix}8 \\\\ 4 \\\\ 0 \\\\ 16\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined."] [17592186559846 :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $$\n\\displaystyle x=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}\n$$ and \n$$\n\\displaystyle \\text{\\boldsymbol}f(x)=\\begin{bmatrix}\\operatorname{sin}⁡(\\pi x)+{y}^{2} \\\\ {x}^{2}y\\end{bmatrix}.\n$$\n\nWe need to compute the Jacobian determinant of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\nJ=\\begin{vmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{vmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(\\pi x)+{y}^{2})=\\pi \\operatorname{cos}⁡(\\pi x),\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(\\pi x)+{y}^{2})=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}y)=2xy,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}y)={x}^{2}\\end{aligned}\n$$\n\nThus, we have\n\n$$\nJ=\\begin{vmatrix}\\pi \\operatorname{cos}⁡(\\pi x) & 2y \\\\ 2xy & {x}^{2}\\end{vmatrix}.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium $$\n\\displaystyle {x}^{∗}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$ to get\n\n$$\n\\begin{aligned}J(0,0) & =\\begin{vmatrix}\\pi \\operatorname{cos}⁡(0) & 2(0) \\\\ 2(0)(0) & {0}^{2}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\pi  & 0 \\\\ 0 & 0\\end{vmatrix} \\\\  & =\\pi \\cdot 0-0\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nFinally, since the Jacobian determinant is zero, our system is $\\text{not almost linear}$ at ${x}^{∗}.$"] [17592186559855 :question/problem "Which of the following statements are true?\n\nI. Any $5\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n\nII. Any $3\\times 5$ matrix $A$ has at most $3$ distinct singular values.\n\nIII. The singular values of the matrix $$\n\\displaystyle A=\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}\n$$ are negative."] [17592186559862 :question/problem "Let $$\n\\displaystyle u=\\begin{bmatrix}-7 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 5 \\\\ 3 \\\\ 0\\end{bmatrix}.\n$$ Find $u+2v.$"] [17592186559862 :question/worked-solution "Let's examine our vectors:\n\n- The vector $$\n\\displaystyle u=\\begin{bmatrix}-7 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$ has $3$ components as it lies in ${R}^{3}.$\n\n- The vector $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 5 \\\\ 3 \\\\ 0\\end{bmatrix}\n$$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined."] [17592186559863 :question/problem "Let $$\n\\displaystyle c=\\begin{bmatrix}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{bmatrix}.\n$$ Find $\\frac{1}{4}c.$"] [17592186559863 :question/worked-solution "Multiplying each component of $c$ by $\\frac{1}{4},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{4}c & =\\frac{1}{4}\\begin{bmatrix}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{4}\\cdot 4 \\\\ \\frac{1}{4}\\cdot 20 \\\\ \\frac{1}{4}\\cdot (-4) \\\\ \\frac{1}{4}\\cdot (-8) \\\\ \\frac{1}{4}\\cdot 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{bmatrix}.\\end{aligned}\n$$"] [17592186559868 :question/problem "If $$\n\\displaystyle v=\\begin{bmatrix}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{bmatrix},\n$$ then $-2v=$"] [17592186559868 :question/worked-solution "Multiplying each component of $v$ by $-2,$ we get\n\n$$\n\\begin{aligned}-2v & =-2\\begin{bmatrix}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\cdot (-1) \\\\ -2\\cdot 3 \\\\ -2\\cdot 0 \\\\ -2\\cdot 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -6 \\\\ 0 \\\\ -20\\end{bmatrix}.\\end{aligned}\n$$"] [17592186559870 :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix},\\,{B}_{2}=\\begin{bmatrix}2 & 1 \\\\ 0 & -3\\end{bmatrix},\\,A=\\begin{bmatrix}-2 & -6 \\\\ 0 & 12\\end{bmatrix}\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $$\n\\displaystyle [A]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\n$$ then ${x}_{1}+{x}_{2}=$"] [17592186559870 :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 & 1 \\\\ 0 & -3\\end{bmatrix} & =\\begin{bmatrix}-2 & -6 \\\\ 0 & 12\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} & -2{x}_{1}+{x}_{2} \\\\ 0 & 3{x}_{1}-3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-2 & -6 \\\\ 0 & 12\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=-2 \\\\ -2{x}_{1}+{x}_{2}=-6 \\\\ 3{x}_{1}-3{x}_{2}=12.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{array}{cc|c}1 & 2 & -2 \\\\ -2 & 1 & -6 \\\\ 3 & -3 & 12\\end{array}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{array}{cc|c}1 & 2 & -2 \\\\ -2 & 1 & -6 \\\\ 3 & -3 & 12\\end{array}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{array}{cc|c}1 & 2 & -2 \\\\ 0 & 5 & -10 \\\\ 0 & -9 & 18\\end{array}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=-2 \\\\ 5{x}_{2}=-10 \\\\ -9{x}_{2}=18.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=-2.$ From the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+2(-2) & =-2 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\n \n\nTherefore, $$\n\\displaystyle [A]_{B}=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}+{x}_{2}=2+(-2)=0.$"] [17592186559877 :question/worked-solution "First, notice that:  \n\n- For the plane $3x-6y+1=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-6,0⟩.$\n\n- For the plane $-x+2y=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,2,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨3,-6,0⟩\\times ⟨-1,2,0⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ 3 & -6 & 0 \\\\ -1 & 2 & 0\\end{vmatrix} \\\\  & =0i+0j+0k \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}=0$, the vectors ${n}_{1}$ and ${n}_{2}$ are parallel. However,  the second plane passes through the origin  $O(0,0,0)$ but the first plane doesn't: \n\n$$\n3(0)-6(0)+1=1\\ne 0\n$$\n\n So, the planes are parallel but not coincident.\n\n- Statement III is false. Since planes are parallel but not coincident, they cannot intersect.\n\nTherefore, only statements I and II are true."] [17592186559879 :question/problem "Let\n$$\n\\displaystyle v=\\begin{bmatrix}-2 \\\\ p \\\\ 5 \\\\ -2 \\\\ -3\\end{bmatrix}\n$$ and $$\n\\displaystyle w=\\begin{bmatrix}2 \\\\ -4 \\\\ 3 \\\\ -3 \\\\ p\\end{bmatrix}.\n$$\nIf $v\\cdot w=3$, find the value of $p.$"] [17592186559880 :question/problem "$$\n{A}_{1}=\\begin{bmatrix}1 & -1 \\\\ 0 & 3\\end{bmatrix},\\,{A}_{2}=\\begin{bmatrix}9 & 4 \\\\ -5 & 3\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Find the matrix $C$ given that $B=\\{{A}_{1},{A}_{2}\\}$ is a basis of $\\text{Span}\\{{A}_{1},{A}_{2}\\},$ and the coordinates of the matrix $C$ relative to $B$ are $$\n\\displaystyle [C]_{B}=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}.\n$$"] [17592186559880 :question/worked-solution "Any vector in $\\text{Span}\\{{A}_{1},{A}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{A}_{1}+{x}_{2}{A}_{2}.\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[C]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}C & =4\\cdot \\begin{bmatrix}1 & -1 \\\\ 0 & 3\\end{bmatrix}+(-1)\\cdot \\begin{bmatrix}9 & 4 \\\\ -5 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -4 \\\\ 0 & 12\\end{bmatrix}+\\begin{bmatrix}-9 & -4 \\\\ 5 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & -8 \\\\ 5 & 9\\end{bmatrix}.\\end{aligned}\n$$"] [17592186559885 :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $$\n\\displaystyle x=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}\n$$ and \n$$\n\\displaystyle \\text{\\boldsymbol}f(x)=\\begin{bmatrix}{x}^{2}+xy-6 \\\\ -{y}^{2}+2x-3\\end{bmatrix}.\n$$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+xy-6)=2x+y \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+xy-6)=x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-{y}^{2}+2x-3)=2 \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-{y}^{2}+2x-3)=-2y\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}2x+y & x \\\\ 2 & -2y\\end{bmatrix}.\n$$\n\nNow, we evaluate the Jacobian at the equilibrium $$\n\\displaystyle {x}^{∗}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\n$$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=\\begin{bmatrix}2(2)+1 & 2 \\\\ 2 & -2(1)\\end{bmatrix}=\\begin{bmatrix}5 & 2 \\\\ 2 & -2\\end{bmatrix}.\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}\\begin{vmatrix}5-\\lambda  & 2 \\\\ 2 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(-2-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-3\\lambda -6 & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues $$\n\\displaystyle {\\lambda }_{1,2}=\\frac{3}{2}\\pm \\frac{\\sqrt{33}}{2}.\n$$\n\nSince the eigenvalues are real and have opposite signs, our equilibrium is an $\\text{unstable}$ $\\text{saddle}.$"] [17592186559889 :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the first equation gives \n\n$$\nx+2(0)+2z=0\\,⟹\\,x=-2z,\n$$\n\nand substituting $y=0$ and $x=-2z$ into the second equation gives\n\n$$\n\\begin{aligned}4x-2y+4z+8 & =0 \\\\ 4(-2z)-2(0)+4z+8 & =0 \\\\ -4z & =-8 \\\\ z & =2.\\end{aligned}\n$$\n\nTherefore, $x=-2z=-4$ and $a=⟨-4,0,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+2z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,2⟩.$\n\n- For the plane $4x-2y+4z+8=0,$ a normal vector to the plane is ${n}_{2}=⟨4,-2,4⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,2⟩\\times ⟨4,-2,4⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & 2 & 2 \\\\ 4 & -2 & 4\\end{vmatrix} \\\\  & =12i+4j-10k \\\\  & =⟨12,4,-10⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{2}({n}_{1}\\times {n}_{2})=⟨6,2,-5⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-4,0,2⟩+t⟨6,2,-5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=-4+2=-2,$ and $b=⟨6,2,-5⟩.$"] [17592186559891 :question/problem "Which of the following statements are true?\n\nI. The matrix $$\n\\displaystyle A=\\begin{bmatrix}-2 & 0 \\\\ 0 & -2\\end{bmatrix}\n$$ has two negative singular values.\n\nII. Any $4\\times 5$ matrix $A$ has at most $5$ distinct singular values.\n\nIII. Any $8\\times 4$ matrix $A$ has at most $8$ distinct singular values."] [17592186560320 :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u v),\\,\\frac{∂}{∂u}(- 3 u),\\,\\frac{∂}{∂u}(2 u - 2 v^{2})⟩ \\\\  & =⟨2 v,\\,-3,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(2 u - 2 v^{2})⟩ \\\\  & =⟨2 u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 v & -3 & 2 \\\\ 2 u & 0 & - 4 v\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-3 & 2 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}2 v & 2 \\\\ 2 u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}2 v & -3 \\\\ 2 u & 0\\end{vmatrix}⟩ \\\\  & =⟨12 v,\\,4 u + 8 v^{2},\\,6 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,4 u + 8 v^{2},\\,6 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(4 u + 8 v^{2})^{2}+(6 u)^{2}} \\\\  & =\\sqrt{52 u^{2} + 64 u v^{2} + 64 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(3 x - y^{2} z)\\,{|}_{x=2 u v\\,y=- 3 u\\,z=2 u - 2 v^{2}} \\\\  & =6 u v-1\\cdot (- 3 u)^{2}\\cdot (2 u - 2 v^{2}) \\\\  & =- 18 u^{3} + 18 u^{2} v^{2} + 6 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 18 u^{3} + 18 u^{2} v^{2} + 6 u v\\right) \\sqrt{52 u^{2} + 64 u v^{2} + 64 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"] [17592186560324 :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u v),\\,\\frac{∂}{∂u}(- 3 u),\\,\\frac{∂}{∂u}(3 u - 2 v^{2})⟩ \\\\  & =⟨v,\\,-3,\\,3⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(3 u - 2 v^{2})⟩ \\\\  & =⟨u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ v & -3 & 3 \\\\ u & 0 & - 4 v\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-3 & 3 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}v & 3 \\\\ u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}v & -3 \\\\ u & 0\\end{vmatrix}⟩ \\\\  & =⟨12 v,\\,3 u + 4 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,3 u + 4 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(3 u + 4 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{18 u^{2} + 24 u v^{2} + 16 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(x - 3 y^{2} z)\\,{|}_{x=u v\\,y=- 3 u\\,z=3 u - 2 v^{2}} \\\\  & =u v-3\\cdot (- 3 u)^{2}\\cdot (3 u - 2 v^{2}) \\\\  & =- 81 u^{3} + 54 u^{2} v^{2} + u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 81 u^{3} + 54 u^{2} v^{2} + u v\\right) \\sqrt{18 u^{2} + 24 u v^{2} + 16 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"]}
