wer.type/math} :answer/value "9x" :db/id #edb/ref 17592186284925} {:answer/id #uuid "7da55036-6972-52f3-847b-a31f95df7852" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{9x}" :db/id #edb/ref 17592186285944} {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} {:answer/id #uuid "f0d61fb9-24f0-590c-861d-b0dc09f76a1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286998}] :answer-field/correct {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} :answer-field/id #uuid "05333763-722c-5f4d-b56e-21e02dec7970" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287152}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15807573-b299-5e98-85b6-db47d2fbe91c" :question/math-academy-id "q-1952" :question/problem "Given that $y={2}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={2}^{u},\\,u=9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={2}^{u}\\operatorname{ln}⁡2,\\,\\frac{\\text{d}u}{\\text{d}x}=9.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}⁡2\\cdot 9 \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{u} \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{9x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f743bf76-aa68-58e9-907f-2483aa71ceaf" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{ln}(5)" :db/id #edb/ref 17592186296581}] :answer-field/correct {:answer/id #uuid "f743bf76-aa68-58e9-907f-2483aa71ceaf" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{ln}(5)" :db/id #edb/ref 17592186296581} :answer-field/id #uuid "47b334c0-adcd-5c15-b3b3-c3ba23b7d937" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296767}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "96fff31f-332c-5572-b655-bad437de2f44" :question/math-academy-id "q-312462" :question/problem "Given that $f(x)={5}^{{x}^{3}+1},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}$\\cdot \\,{5}^{{x}^{3}+1}$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={5}^{u},\\,u={x}^{3}+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={5}^{u}ln⁡(5),\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={5}^{u}ln⁡(5)\\cdot (3{x}^{2}) \\\\  & =3{x}^{2}ln⁡(5)\\cdot {5}^{u} \\\\  & =3{x}^{2}ln⁡(5)\\cdot {5}^{{x}^{3}+1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa1743b3-cca5-5571-9ea3-78db4f0b711a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(5)" :db/id #edb/ref 17592186313309} {:answer/id #uuid "ea5d74d6-24a0-4c51-b92d-8c37e51d12f2" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\ln5" :db/id #edb/ref 17592186577011}] :answer-field/correct {:answer/id #uuid "aa1743b3-cca5-5571-9ea3-78db4f0b711a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(5)" :db/id #edb/ref 17592186313309} :answer-field/id #uuid "a3811faf-1cb9-5232-9104-02c745e33d3d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314452}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5d403927-9339-566e-9390-9903483d0c58" :question/math-academy-id "q-340969" :question/problem "Find the slope $m$ of the tangent to the curve $y={5}^{x-{x}^{3}}$ at the point where $x=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={5}^{u},\\,u=x-{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={5}^{u}ln⁡(5),\\,\\frac{\\text{d}u}{\\text{d}x}=1-3{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={5}^{u}ln⁡(5)\\cdot (1-3{x}^{2}) \\\\  & =(1-3{x}^{2}){5}^{x-{x}^{3}}ln⁡(5).\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={((1-3{x}^{2}){5}^{x-{x}^{3}}ln⁡(5))|}_{x=1} \\\\  & =(1-3(1)^{2}){5}^{1-(1)^{3}}ln⁡(5) \\\\  & =-2\\cdot {5}^{0}ln⁡(5) \\\\  & =-2ln⁡(5)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f178a09-59b9-5bd4-94f2-717a9d712eec" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327354} {:answer/id #uuid "ce962925-563f-5203-9850-54b8e1527957" :answer/type {:db/ident :answer.type/math} :answer/value "7ln⁡(4)" :db/id #edb/ref 17592186328749} {:answer/id #uuid "d0342368-9d6f-56bf-9428-8ca2563004ae" :answer/type {:db/ident :answer.type/math} :answer/value "28ln⁡(4)" :db/id #edb/ref 17592186328765} {:answer/id #uuid "e44279a3-2028-5e38-9e46-7a6b15fa9ce2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186328935} {:answer/id #uuid "e877c22b-b0a5-5c6f-80fc-dddf3ca707ed" :answer/type {:db/ident :answer.type/math} :answer/value "4ln⁡(4)" :db/id #edb/ref 17592186328967}] :answer-field/correct {:answer/id #uuid "d0342368-9d6f-56bf-9428-8ca2563004ae" :answer/type {:db/ident :answer.type/math} :answer/value "28ln⁡(4)" :db/id #edb/ref 17592186328765} :answer-field/id #uuid "c745005c-c2dc-5006-b584-ff3b1f2fe9d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329537}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac2dcbe2-d530-570b-ae79-f45a337889ca" :question/math-academy-id "q-48659" :question/problem "Find the slope of the tangent to the curve $y={4}^{7x}$ at the point where $x=\\frac{1}{7}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={4}^{u},\\,u=7x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={4}^{u}ln⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=7.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={4}^{u}ln⁡4\\cdot 7 \\\\  & =7ln⁡4\\cdot {4}^{u} \\\\  & =7ln⁡4\\cdot {4}^{7x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=\\frac{1}{7}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1/7} & =7ln⁡(4)\\cdot {4}^{7(1/7)} \\\\  & =7ln⁡(4)\\cdot 4 \\\\  & =28ln⁡(4)\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve at the point where $x=\\frac{1}{7}$ is $28ln⁡(4).$"} {:db/id #edb/ref 17592186524994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff3851f0-019b-54f0-9d24-526c6e29abe2" :answer/type {:db/ident :answer.type/math} :answer/value "-30\\ln(5)" :db/id #edb/ref 17592186524839}] :answer-field/correct {:answer/id #uuid "ff3851f0-019b-54f0-9d24-526c6e29abe2" :answer/type {:db/ident :answer.type/math} :answer/value "-30\\ln(5)" :db/id #edb/ref 17592186524839} :answer-field/id #uuid "d83b75c0-fe56-5390-8126-bd377ed6af9e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524934}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "70b1c8a4-0636-5508-ab80-4e4e15ec81e5" :question/math-academy-id "q-340970" :question/problem "Find the slope $m$ of the tangent to the curve $y=2\\cdot {5}^{1-3x}$ at the point where $x=0.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=2\\cdot {5}^{u},\\,u=1-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=2\\cdot {5}^{u}\\operatorname{ln}⁡(5),\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =2\\cdot {5}^{u}\\operatorname{ln}⁡(5)\\cdot (-3) \\\\  & =-6\\cdot {5}^{1-3x}\\operatorname{ln}⁡(5).\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=0$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={(-6\\cdot {5}^{1-3x}\\operatorname{ln}⁡5)|}_{x=0} \\\\  & =-6\\cdot {5}^{1-3(0)}\\operatorname{ln}⁡(5) \\\\  & =-6\\cdot 5\\operatorname{ln}⁡(5) \\\\  & =-30\\operatorname{ln}⁡(5)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207209c4-3cd7-5f9a-8f55-b6d3c323a8ae" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(2)\\,x+\\operatorname{ln}⁡(2)+\\frac{1}{4}" :db/id #edb/ref 17592186524441} {:answer/id #uuid "47a3f504-906f-5250-a397-60c7605afb97" :answer/type {:db/ident :answer.type/math} :answer/value "y=2\\operatorname{ln}⁡(2)\\,x-2\\operatorname{ln}⁡(2)+\\frac{1}{4}" :db/id #edb/ref 17592186524506} {:answer/id #uuid "8d428376-e2b0-53e2-b314-797b7522cd0c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(2)\\,x-\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186524605} {:answer/id #uuid "a77b2a43-bd2d-5fe7-a7da-2538cecd54fa" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(2)\\,x-2\\operatorname{ln}⁡(2)+\\frac{1}{4}" :db/id #edb/ref 17592186524650} {:answer/id #uuid "e12ce1c7-49ac-5fd0-9ccc-f097ef76e6f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(2)\\,x-\\frac{1}{4}" :db/id #edb/ref 17592186524774}] :answer-field/correct {:answer/id #uuid "207209c4-3cd7-5f9a-8f55-b6d3c323a8ae" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(2)\\,x+\\operatorname{ln}⁡(2)+\\frac{1}{4}" :db/id #edb/ref 17592186524441} :answer-field/id #uuid "717c0cdc-ae39-5590-87a2-a75a93baebfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524890}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "77c551c0-c155-56eb-9f11-d8d660941796" :question/math-academy-id "q-107463" :question/problem "Find the equation of the tangent to the curve $y={4}^{2x+1}$ at the point where $x=-1.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={4}^{u},\\,u=2x+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={4}^{u}\\operatorname{ln}⁡(4),\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={4}^{u}\\operatorname{ln}⁡(4)\\cdot 2 \\\\  & =2\\cdot {4}^{2x+1}\\operatorname{ln}⁡(4).\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=-1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point. \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} & ={(2\\cdot {4}^{2x+1}\\operatorname{ln}⁡4)|}_{x=-1} \\\\  & =2\\cdot {4}^{-1}\\operatorname{ln}⁡(4) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(4) \\\\  & =\\operatorname{ln}⁡((4)^{1/2}) \\\\  & =ln\\,(\\,\\sqrt{4}) \\\\  & =\\operatorname{ln}⁡(2).\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x={x}_{1}=-1$ is\n\n$$\n\\begin{aligned}{y}_{1} & ={({4}^{2x+1})|}_{x=-1} \\\\  & ={4}^{2(-1)+1} \\\\  & ={4}^{-1} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-\\frac{1}{4} & =\\operatorname{ln}⁡(2)\\cdot (x+1) \\\\ y-\\frac{1}{4} & =\\operatorname{ln}⁡(2)\\,x+\\operatorname{ln}⁡(2) \\\\ y & =\\operatorname{ln}⁡(2)\\,x+\\operatorname{ln}⁡(2)+\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38229b23-2b39-59e5-9abd-c6c07d94e182" :answer/type {:db/ident :answer.type/math} :answer/value "7\\cdot {4}^{7x}" :db/id #edb/ref 17592186561722} {:answer/id #uuid "78c9ae9f-b6bd-5e2b-a491-13f9286f6a11" :answer/type {:db/ident :answer.type/math} :answer/value "7x" :db/id #edb/ref 17592186561883} {:answer/id #uuid "799b33bd-f993-5922-93a7-8e0d15933029" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/id #edb/ref 17592186561884} {:answer/id #uuid "7ccc347a-a561-5923-a18e-8613311aa3f2" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{7x}" :db/id #edb/ref 17592186561891} {:answer/id #uuid "b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" :answer/type {:db/ident :answer.type/math} :answer/value "7\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/id #edb/ref 17592186562024}] :answer-field/correct {:answer/id #uuid "b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" :answer/type {:db/ident :answer.type/math} :answer/value "7\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/id #edb/ref 17592186562024} :answer-field/id #uuid "bc0be4a0-ce70-5992-8eed-814e9a761b79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562341}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0876dfcc-e11e-5c1c-a9e0-0c7b6f68915a" :question/math-academy-id "q-1951" :question/problem "If $f(x)={4}^{7x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={4}^{u},\\,u=7x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={4}^{u}\\operatorname{ln}⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=7.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =7\\cdot {4}^{u}\\operatorname{ln}⁡4 \\\\  & =7\\operatorname{ln}⁡4\\cdot {4}^{u} \\\\  & =7\\operatorname{ln}⁡4\\cdot {4}^{7x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "841e2942-bfa2-5b85-b44b-5fcecbbf51ae" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 \\cdot 6^{- 2 x^{3} - 4} x^{2} \\ln{\\left(6 \\right)}" :db/id #edb/ref 17592186657644}] :answer-field/correct {:answer/id #uuid "841e2942-bfa2-5b85-b44b-5fcecbbf51ae" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 \\cdot 6^{- 2 x^{3} - 4} x^{2} \\ln{\\left(6 \\right)}" :db/id #edb/ref 17592186657644} :answer-field/id #uuid "05032cba-eb6d-54e4-9bd4-90a4529fda64" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657633}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0b8b61b6-6058-58ee-b489-5e87a3738e1a" :question/problem "If $f(x)={6}^{-4-2{x}^{3}}$, find ${f}^{\\prime}(x)$.\n\n$f^{\\prime}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={6}^{u},\\,u=-4-2{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}f}{\\mathrm{d}u}={6}^{u}\\ln(6),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-6{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}f}{\\mathrm{d}x} & =\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & ={6}^{u}\\ln(6)\\cdot (-6{x}^{2}) \\\\ & =(-6{x}^{2})\\cdot {6}^{u}\\ln(6) \\\\ & =-6{x}^{2}\\cdot {6}^{-4-2{x}^{3}}\\ln(6).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c1c75b8-e26c-5124-9d8e-2b0c7d538071" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cdot 2^{- 3 x^{3} + 2 x} \\left(2 - 9 x^{2}\\right) \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186657638}] :answer-field/correct {:answer/id #uuid "4c1c75b8-e26c-5124-9d8e-2b0c7d538071" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cdot 2^{- 3 x^{3} + 2 x} \\left(2 - 9 x^{2}\\right) \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186657638} :answer-field/id #uuid "ad146e83-d809-55d5-b5d2-7a4807735ed5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657648}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "11669aef-a5f9-5388-a104-0a436ef45585" :question/problem "Given that $y=4\\cdot {2}^{2x-3{x}^{3}}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$.\n\n$\\frac{\\mathrm{d}y}{\\mathrm{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=4\\cdot {2}^{u},\\,u=2x-3{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}u}=4\\cdot {2}^{u}\\ln(2),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2-9{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =\\frac{\\mathrm{d}y}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & =4\\cdot {2}^{u}\\ln(2)\\cdot (2-9{x}^{2}) \\\\ & =(2-9{x}^{2})\\cdot 4\\cdot {2}^{u}\\ln(2) \\\\ & =(8-36{x}^{2})\\cdot {2}^{2x-3{x}^{3}}\\ln(2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e0a109a-1398-5203-b687-1fca003844e1" :answer/type {:db/ident :answer.type/math} :answer/value "-48\\cdot 2^{3 - 9 x}\\ln(2)" :db/id #edb/ref 17592186657639} {:answer/id #uuid "75a0a275-f824-5f1a-878e-960f624e19ae" :answer/type {:db/ident :answer.type/math} :answer/value "-85\\cdot 2^{3 - 9 x}\\ln(2)" :db/id #edb/ref 17592186657642} {:answer/id #uuid "7af2cbb1-148f-5a29-b908-4002f80f58ca" :answer/type {:db/ident :answer.type/math} :answer/value "85\\cdot 2^{3 - 9 x}\\ln(2)" :db/id #edb/ref 17592186657643} {:answer/id #uuid "aa1a8145-bf09-5948-ab9e-9a0d45e521a4" :answer/type {:db/ident :answer.type/math} :answer/value "36\\cdot 2^{3 - 9 x}\\ln(2)" :db/id #edb/ref 17592186657647} {:answer/id #uuid "dad54a83-3367-58e2-9a9d-cba745b58143" :answer/type {:db/ident :answer.type/math} :answer/value "-36\\cdot 2^{3 - 9 x}\\ln(2)" :db/id #edb/ref 17592186657653}] :answer-field/correct {:answer/id #uuid "dad54a83-3367-58e2-9a9d-cba745b58143" :answer/type {:db/ident :answer.type/math} :answer/value "-36\\cdot 2^{3 - 9 x}\\ln(2)" :db/id #edb/ref 17592186657653} :answer-field/id #uuid "d1dcd53c-c98c-5ecf-b693-90aedb451257" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657651}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "28d91041-6f71-527c-b0ba-ad8e852f62c1" :question/problem "If $f(x)=4\\cdot {2}^{3-9x}$, find ${f}^{\\prime}(x)$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=4\\cdot {2}^{u},\\,u=3-9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}f}{\\mathrm{d}u}=4\\cdot {2}^{u}\\ln(2),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-9.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}f}{\\mathrm{d}x} & =\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & =4\\cdot {2}^{u}\\ln(2)\\cdot (-9) \\\\ & =(-9)\\cdot 4\\cdot {2}^{u}\\ln(2) \\\\ & =-36\\cdot {2}^{3-9x}\\ln(2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0904557f-31ec-5d61-be02-e94f759e9131" :answer/type {:db/ident :answer.type/math} :answer/value "9\\cdot 3^{- 4 x}\\ln(3)" :db/id #edb/ref 17592186657634} {:answer/id #uuid "92a466b7-1343-5de6-93ed-81dc8eaae4cc" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\cdot 3^{- 4 x}\\ln(3)" :db/id #edb/ref 17592186657645} {:answer/id #uuid "9fb0deac-7b1c-574a-8c8d-c13074ff7589" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cdot 3^{- 4 x}\\ln(3)" :db/id #edb/ref 17592186657646} {:answer/id #uuid "be75eec8-65d0-5bd5-a24a-080e621f031b" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\cdot 3^{- 4 x}\\ln(3)" :db/id #edb/ref 17592186657649} {:answer/id #uuid "c8f64b24-5080-5a4a-b39c-7931a40f9db8" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot 3^{- 4 x}\\ln(3)" :db/id #edb/ref 17592186657650}] :answer-field/correct {:answer/id #uuid "9fb0deac-7b1c-574a-8c8d-c13074ff7589" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cdot 3^{- 4 x}\\ln(3)" :db/id #edb/ref 17592186657646} :answer-field/id #uuid "70c563c1-28fa-57f6-9e2c-777ad735321f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657641}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6f7f3334-06bf-5b6c-8d9b-7e1b11d303db" :question/problem "Given that $y={3}^{-4x}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={3}^{u},\\,u=-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}u}={3}^{u}\\ln(3),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =\\frac{\\mathrm{d}y}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & ={3}^{u}\\ln(3)\\cdot (-4) \\\\ & =(-4)\\cdot {3}^{u}\\ln(3) \\\\ & =-4\\cdot {3}^{-4x}\\ln(3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2c2af5a-8964-54fb-89be-8cfcc69077a5" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 6^{x^{3} + 3 x} \\left(3 x^{2} + 3\\right) \\ln{\\left(6 \\right)}" :db/id #edb/ref 17592186657655}] :answer-field/correct {:answer/id #uuid "e2c2af5a-8964-54fb-89be-8cfcc69077a5" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 6^{x^{3} + 3 x} \\left(3 x^{2} + 3\\right) \\ln{\\left(6 \\right)}" :db/id #edb/ref 17592186657655} :answer-field/id #uuid "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657652}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/problem "Given that $y=2\\cdot {6}^{3x+{x}^{3}}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$.\n\n$\\frac{\\mathrm{d}y}{\\mathrm{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=2\\cdot {6}^{u},\\,u=3x+{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}u}=2\\cdot {6}^{u}\\ln(6),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3+3{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =\\frac{\\mathrm{d}y}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & =2\\cdot {6}^{u}\\ln(6)\\cdot (3+3{x}^{2}) \\\\ & =(3+3{x}^{2})\\cdot 2\\cdot {6}^{u}\\ln(6) \\\\ & =(6+6{x}^{2})\\cdot {6}^{3x+{x}^{3}}\\ln(6).\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}]}
