nswer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186331577} {:answer/id #uuid "c163d792-fcdb-58ce-be5c-05660a506b28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186331666} {:answer/id #uuid "c187c878-5877-5b0a-ab41-952209abe59c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arctan}⁡(5x)+C" :db/id #edb/ref 17592186331668} {:answer/id #uuid "e20ac18c-ab7a-518f-8d37-1b59b1612d09" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186331949}] :answer-field/correct {:answer/id #uuid "22bf65d9-1368-5c83-bc06-2f787ae31aed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186330249} :answer-field/id #uuid "4a6a8623-72fb-5f8a-9e38-396d560f8321" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332330}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "73d1e60d-39c3-527b-ad50-26d30b66cdba" :question/math-academy-id "q-49550" :question/problem "$$\n\\displaystyle \\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x=\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{25\\cdot (1+{x}^{2}/25)}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+{x}^{2}/25}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+(x/5)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{5}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x & =\\frac{1}{25}\\int \\frac{1}{1+(x/5)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+{u}^{2}}\\cdot (5\\,\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0218ebee-f46b-52a3-af27-002bd2e16fdd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡\\left(\\frac{x}{8}\\right)}{4}+C" :db/id #edb/ref 17592186329977} {:answer/id #uuid "2d0a098d-fa78-5f98-bfe7-2e76cd1fe7ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)}{4}+C" :db/id #edb/ref 17592186330349} {:answer/id #uuid "3e1c856a-d31e-5281-a2a6-f20cbee86a40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(8x)}{8}+C" :db/id #edb/ref 17592186330499} {:answer/id #uuid "6da04d85-0964-58d1-bd80-e9e62694fa8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡\\left(\\frac{x}{8}\\right)}{4}+C" :db/id #edb/ref 17592186330930} {:answer/id #uuid "e57ddc07-4a02-59ea-b4b1-dd526c6b3d82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡\\left(\\frac{x}{8}\\right)}{8}+C" :db/id #edb/ref 17592186331971}] :answer-field/correct {:answer/id #uuid "6da04d85-0964-58d1-bd80-e9e62694fa8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡\\left(\\frac{x}{8}\\right)}{4}+C" :db/id #edb/ref 17592186330930} :answer-field/id #uuid "d448c3a1-6