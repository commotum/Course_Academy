\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15325872-4e2f-544f-9dec-000683e3691e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(x)}{25}+C" :db/id #edb/ref 17592186288177} {:answer/id #uuid "164243e9-717c-580d-9d74-331ac357f68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288180} {:answer/id #uuid "6b7d4913-276e-5926-8683-f107a4d1158c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(25x)}{25}+C" :db/id #edb/ref 17592186288790} {:answer/id #uuid "87403b08-b913-5b5b-af1b-47f906da3828" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288944} {:answer/id #uuid "90b08433-72df-5a70-8a55-aec7b22f8981" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(25x)}{25}+C" :db/id #edb/ref 17592186289001}] :answer-field/correct {:answer/id #uuid "164243e9-717c-580d-9d74-331ac357f68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288180} :answer-field/id #uuid "589b96c3-feba-5f82-b690-a05fef9d4fc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289916}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d025ad08-0459-5553-af22-02ed776a0b57" :question/math-academy-id "q-2507" :question/problem "$$\n\\displaystyle \\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x=\n$$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\,\\text{d}u=\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024f569b-84cc-57ef-8f4d-9dc8de0df792" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)+C" :db/id #edb/ref 17592186329984} {:answer/id #uuid "12e1d549-32b5-52ba-8653-965154243838" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)+C" :db/id #edb/ref 17592186330111} {:answer/id #uuid "3bd86b9e-f501-52cd-b1cc-9ff1facc3fb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186330482} {:answer/id #uuid "6428015d-361f-5b50-9364-a1602259dd12" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(2x)+C" :db/id #edb/ref 17592186330841} {:answer/id #uuid "fbaac824-d193-5f69-9c43-16185bc76ba0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(2x)+C" :db/id #edb/ref 17592186332162}] :answer-field/correct {:answer/id #uuid "024f569b-84cc-57ef-8f4d-9dc8de0df792" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)+C" :db/id #edb/ref 17592186329984} :answer-field/id #uuid "21cb126f-f