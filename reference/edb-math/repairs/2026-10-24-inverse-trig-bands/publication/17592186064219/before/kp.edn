b/id #edb/ref 17592186248071} {:answer/id #uuid "bb8b07a0-116b-518d-9a1d-972a85844f64" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)+C" :db/id #edb/ref 17592186249098} {:answer/id #uuid "c32179fe-c467-592c-9f69-b60802a05b4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)+C" :db/id #edb/ref 17592186249159} {:answer/id #uuid "d304c17e-5ea8-5a66-93d7-6a99599f2090" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)+C" :db/id #edb/ref 17592186249297} {:answer/id #uuid "fd94393a-c5bd-52f0-be8f-368ed42e2eb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)+C" :db/id #edb/ref 17592186249644}] :answer-field/correct {:answer/id #uuid "d304c17e-5ea8-5a66-93d7-6a99599f2090" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)+C" :db/id #edb/ref 17592186249297} :answer-field/id #uuid "204c0449-cb8b-5901-a89b-496c8ed2dd4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249729}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9cca3e1-79d8-525d-a321-dda6d6f0fe18" :question/math-academy-id "q-114045" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x & =\\int \\frac{8}{16\\cdot (1+{x}^{2}/16)}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{x}^{2}/16}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+(x/4)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{4}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1+(x/4)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\cdot (4\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =2\\operatorname{arctan}⁡u+C \\\\  & =2\\operatorname{arctan}⁡\\left(\\frac{x}{4}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245b618d-7b28-597c-b19b-5c843eb6c7f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186247741} {:answer/id #uuid "52fe1c8c-100b-5622-9e05-9387df536621" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(9x)+C" :db/id #edb/ref 17592186248173} {:answer/id #uuid "a0850bb9-1690-5ca5-b8a2-6fbde9a42a7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡\\left(\\frac{x}{9}\\right)+C" :db/id #edb/ref 17592186248858} {:answer/id #uuid "b7508ec8-5378-54d4-bd32-a71a1b47afaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{x}{9}\\right)+C" :db/id #edb/ref 17592186249065} {:answer/id #uuid "bbaf321e-a0ba-506b-a6c1-81f09db011a4" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{arctan}⁡\\left(\\frac{x}{9}\\right)+C" :db/id #edb/ref 17592186249099}] :answer-field/correct {:answer/id #uuid "b7508ec8-5378-54d4-bd32-a71a1b47afaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{x}{9}\\right)+C" :db/id #edb/ref 17592186249065} :answer-field/id #uuid "835d8e84-7024-5e35-bbe8-a87537867361" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249899}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4e7b39f3-407b-599d-a487-d698e967777b" :question/math-academy-id "q-114046" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{9}{81+{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{9}{81+{x}^{2}}\\,\\text{d}x & =\\int \\frac{9}{81\\cdot (1+{x}^{2}/81)}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{x}^{2}/81}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+(x/9)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\n The only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{9}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{9}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{9}\\,⟹\\,\\text{d}x=9\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{9}{81+{x}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1+(x/9)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{u}^{2}}\\cdot (9\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\operatorname{arctan}⁡u+C \\\\  & =\\operatorname{arctan}⁡\\left(\\frac{x}{9}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "486b0a70-7e05-52ff-8487-81ba071e0a3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C" :db/id #edb/ref 17592186288533} {:answer/id #uuid "69127801-3533-5a03-b74d-9ec2a87d6eb9" :answer/type {:db/ident