arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247464} {:answer/id #uuid "0e2ff00e-68bf-502d-98ea-81a253a73c45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247554} {:answer/id #uuid "4cfc5510-a085-5eb9-b318-bbda8928e434" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186248113} {:answer/id #uuid "5be141d4-f3ae-5dbe-a3ed-b73522cecff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186248256} {:answer/id #uuid "b327e315-fd5b-5fed-a846-f91465502aee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186249029}] :answer-field/correct {:answer/id #uuid "0e2ff00e-68bf-502d-98ea-81a253a73c45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247554} :answer-field/id #uuid "692c144a-767b-5856-8997-1c4aa1c3ede5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249853}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2983a03c-228c-5295-a88a-957cc5ef8213" :question/math-academy-id "q-114035" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{1+5{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $5{x}^{2}=(\\sqrt{5}x)^{2}.$\n\nThus, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+5{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(\\sqrt{5}x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9072ff-4248-5c96-aa34-ca722a5750b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186247515} {:answer/id #uuid "5c681104-b0e2-5a5b-8f09-f83ae1045726" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248265} {:answer/id #uuid "69b6f3a0-9094-584b-a375-09202334d54b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248367} {:answer/id #uuid "8be15631-a51f-557d-9b64-882be871c95f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}x}{3}\\right)+C" :db/id #edb/ref 17592186248677} {:answer/id #uuid "ff4d3d45-5080-5430-90e3-c1923ab5f66b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249659}] :answer-field/correct {:answer/id #uuid "ff4d3d45-5080-5430-90e3-c1923ab5f66b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249659} :answer-field/id #uuid "f08c78cb-9c6d-566a-a639-9975746cefc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250089}] :question/difficulty {:db/ident :ques