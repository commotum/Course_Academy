{6} \\right)}}{42}+C\\end{aligned}\n$$"] [:db/add "e89cba94-0b9c-53a6-bd8e-752f93d9ffc2" :question/difficulty :question.difficulty/hard] [:db/add "e89cba94-0b9c-53a6-bd8e-752f93d9ffc2" :question/answer-fields "6bbb539e-e5b6-53e7-8999-f4fb189180c8"] [:db/ensure "e89cba94-0b9c-53a6-bd8e-752f93d9ffc2" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "e89cba94-0b9c-53a6-bd8e-752f93d9ffc2"] [:db/add "e91c1dff-d486-5d65-a46a-5ff5bfd1c7e6" :answer/id #uuid "e91c1dff-d486-5d65-a46a-5ff5bfd1c7e6"] [:db/add "e91c1dff-d486-5d65-a46a-5ff5bfd1c7e6" :answer/type :answer.type/math] [:db/add "e91c1dff-d486-5d65-a46a-5ff5bfd1c7e6" :answer/value "\\frac{3 \\operatorname{arcsin}{\\left(3 x \\right)}}{7}+C"] [:db/ensure "e91c1dff-d486-5d65-a46a-5ff5bfd1c7e6" :answer/validate] [:db/add "813d1154-44eb-5e02-8ecd-d8dc89caec0d" :answer/id #uuid "813d1154-44eb-5e02-8ecd-d8dc89caec0d"] [:db/add "813d1154-44eb-5e02-8ecd-d8dc89caec0d" :answer/type :answer.type/math] [:db/add "813d1154-44eb-5e02-8ecd-d8dc89caec0d" :answer/value "\\frac{27 \\operatorname{arctan}{\\left(3 x \\right)}}{7}+C"] [:db/ensure "813d1154-44eb-5e02-8ecd-d8dc89caec0d" :answer/validate] [:db/add "e6923f62-a9bc-5fcf-96b2-d18caaa3229f" :answer/id #uuid "e6923f62-a9bc-5fcf-96b2-d18caaa3229f"] [:db/add "e6923f62-a9bc-5fcf-96b2-d18caaa3229f" :answer/type :answer.type/math] [:db/add "e6923f62-a9bc-5fcf-96b2-d18caaa3229f" :answer/value "\\frac{9 \\operatorname{arctan}{\\left(3 x \\right)}}{7}+C"] [:db/ensure "e6923f62-a9bc-5fcf-96b2-d18caaa3229f" :answer/validate] [:db/add "005d9c54-9266-5ad7-9027-c1f978649698" :answer/id #uuid "005d9c54-9266-5ad7-9027-c1f978649698"] [:db/add "005d9c54-9266-5ad7-9027-c1f978649698" :answer/type :answer.type/math] [:db/add "005d9c54-9266-5ad7-9027-c1f978649698" :answer/value "\\frac{3 \\operatorname{arctan}{\\left(3 x \\right)}}{7}+C"] [:db/ensure "005d9c54-9266-5ad7-9027-c1f978649698" :answer/validate] [:db/add "e0df5488-8162-525d-9423-9d533e200638" :answer/id #uuid "e0df5488-8