0e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/id #uuid "f2b10e7e-0247-5cb6-93d0-182d84a3d991"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/key "selection"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/type :answer-field.type/radio] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/choices "e5fb92f8-0d6d-5ea0-9d2d-71d67d6a0775"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/choices "23910027-5f13-5a3c-a6de-adda6a244240"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/choices "07c26e54-2294-5687-b4c5-58f8778f2ab7"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/choices "ca7464c5-dcbc-552b-8052-445cd47479f7"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/choices "84377d13-d7eb-5c20-a86b-157b73f6458f"] [:db/add "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/correct "e5fb92f8-0d6d-5ea0-9d2d-71d67d6a0775"] [:db/ensure "f2b10e7e-0247-5cb6-93d0-182d84a3d991" :answer-field/validate] [:db/add "dbb54453-224c-5927-8847-fd39bd2a8cdb" :question/id #uuid "dbb54453-224c-5927-8847-fd39bd2a8cdb"] [:db/add "dbb54453-224c-5927-8847-fd39bd2a8cdb" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{x^{2} + 81}\\,\\mathrm{d}x\n$$"] [:db/add "dbb54453-224c-5927-8847-fd39bd2a8cdb" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 81=81(1+(\\frac{1}{81})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{9},\\qquad \\mathrm{d}x=(9)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{x^{2} + 81}\\,\\mathrm{d}x \\\\  &= \\frac{1}{81}\\int \\frac{1}{1+(\\frac{x}{9})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{81}(9)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{9}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arctan}{\\left(u \\right)}}{9}+C \\\\  &= \\frac{\\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}}{9}+C\\end{aligned}\n$$"] [:db/add "dbb54453-224c-5927-8847-fd39bd2a8cdb" :question/difficulty :question.difficulty/moderate] [:db/add "dbb54453-224c-5927-8847-fd39bd2a8cdb" :question/answer-fields "f2b10e7e-0247-5cb6-93d0-182d84a3d991"] [:db/ensure "dbb54453-224c-5927-8847-fd39bd2a8cdb" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "dbb54453-224c-5927-8847-fd39bd2a8cdb"] [:db/add "14641773-0758-5ae5-86d4-9b5f82c9f52c" :answer/id #uuid "14641773-0758-5ae5-86d4-9b5f82c9f52c"] [:db/add "14641773-0758-5ae5-86d4-9b5f82c9f52c" :answer/type :answer.type/math] [:db/add "14641773-0758-5ae5-86d4-9b5f82c9f52c" :answer/value "\\operatorname{arctan}{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "14641773-0758-5ae5-86d4-9b5f82c9f52c" :answer/validate] [:db/add "d68caef6-11a8-53cf-aef8-95fba99f9bbd" :answer/id #uuid "d68caef6-11a8-53cf-aef8-95fba99f9bbd"] [:db/add "d68caef6-11a8-53cf-aef8-95fba99f9bbd" :answer/type :answer.type/math] [:db/add "d68caef6-11a8-53cf-aef8-95fba99f9bbd" :answer/value "3 \\operatorname{arctan}{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "d68caef6-11a8-53cf-aef8-95fba99f9bbd" :answer/validate] [:db/add "6c96749d-e150-5f73-8561-f38354710ccd" :answer/id #uuid "6c96749d-e150-5f73-8561-f38354710ccd"] [:db/add "6c96749d-e150-5f73-8561-f38354710ccd" :answer/type :answer.type/math] [:db/add "6c96749d-e150-5f73-8561-f38354710ccd" :answer/value "3 \\operatorname{arctan}{\\left(x \\right)}+C"] [:db/ensure "6c96749d-e150-5f73-8561-f38354710ccd" :answer/validate] [:db/add "b3c6de88-9b8f-54bc-97e1-1be360b15697" :answer/id #uuid "b3c6de88-9b8f-54bc-97e1-1be360b15697"] [:db/add "b3c6de88-9b8f-54bc-97e1-1be360b15697" :answer/type :answer.type/math] [:db/add "b3c6de88-9b8f-54bc-97e1-1be360b15697" :answer/value "3 \\operatorname{arcsin}{\\left(\\frac{x}{3} \\right)}+C"