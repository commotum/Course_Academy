db/add "89dc5d2d-8f9e-5319-aac2-fdf6c46997c5" :answer-field/choices "2ef8c30d-fd49-5779-9e5d-c7dd5a32f59e"] [:db/add "89dc5d2d-8f9e-5319-aac2-fdf6c46997c5" :answer-field/choices "42157c23-e7cf-53d6-a1f4-7ab4e415c97d"] [:db/add "89dc5d2d-8f9e-5319-aac2-fdf6c46997c5" :answer-field/correct "f2bacbd4-300f-5c95-9a1b-adb46900035f"] [:db/ensure "89dc5d2d-8f9e-5319-aac2-fdf6c46997c5" :answer-field/validate] [:db/add "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/id #uuid "2dc8364c-3b6b-5d4f-a269-88d33ebce849"] [:db/add "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{4}{2 x^{2} + 49}\\,\\mathrm{d}x\n$$"] [:db/add "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n2 x^{2} + 49=49(1+(\\frac{2}{49})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{2} x}{7}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{2}}{7},\\qquad \\mathrm{d}x=(\\frac{7 \\sqrt{2}}{2})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{2 x^{2} + 49}\\,\\mathrm{d}x \\\\  &= \\frac{4}{49}\\int \\frac{1}{1+(\\frac{\\sqrt{2} x}{7})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{4}{49}(\\frac{7 \\sqrt{2}}{2})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{2}}{7}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{2} \\operatorname{arctan}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{2 \\sqrt{2} \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{7}+C\\end{aligned}\n$$"] [:db/add "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/difficulty :question.difficulty/hard] [:db/add "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/answer-fields "89dc5d2d-8f9e-5319-aac2-fdf6c46997c5"] [:db/ensure "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "2dc8364c-3b6b-5d4f-a269-88d33ebce849"] [:db/add "1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b" :answer/id #uuid "1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b"] [:db/add "1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b" :answer/type :answer.type/math] [:db/add "1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b" :answer/value "\\frac{6 \\operatorname{arcsin}{\\left(7 x \\right)}}{35}+C"] [:db/ensure "1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b" :answer/validate] [:db/add "c8241a16-47b5-5eb2-a0ce-16edb25d79ee" :answer/id #uuid "c8241a16-47b5-5eb2-a0ce-16edb25d79ee"] [:db/add "c8241a16-47b5-5eb2-a0ce-16edb25d79ee" :answer/type :answer.type/math] [:db/add "c8241a16-47b5-5eb2-a0ce-16edb25d79ee" :answer/value "\\frac{6 \\operatorname{arctan}{\\left(7 x \\right)}}{35}+C"] [:db/ensure "c8241a16-47b5-5eb2-a0ce-16edb25d79ee" :answer/validate] [:db/add "09a5a5c3-5963-5952-b70d-f29daf65f1c2" :answer/id #uuid "09a5a5c3-5963-5952-b70d-f29daf65f1c2"] [:db/add "09a5a5c3-5963-5952-b70d-f29daf65f1c2" :answer/type :answer.type/math] [:db/add "09a5a5c3-5963-5952-b70d-f29daf65f1c2" :answer/value "\\frac{6 \\operatorname{arctan}{\\left(x \\right)}}{35}+C"] [:db/ensure "09a5a5c3-5963-5952-b70d-f29daf65f1c2" :answer/validate] [:db/add "20b7442b-bcfb-526d-b0e6-7ba3cd23c511" :answer/id #uuid "20b7442b-bcfb-526d-b0e6-7ba3cd23c511"] [:db/add "20b7442b-bcfb-526d-b0e6-7ba3cd23c511" :answer/type :answer.type/math] [:db/add "20b7442b-bcfb-526d-b0e6-7ba3cd23c511" :answer/value "\\frac{6 \\operatorname{arctan}{\\left(7 x \\right)}}{5}+C"] [:db/ensure "20b7442b-bcfb-526d-b0e6-7ba3cd23c511" :answer/validate] [:db/add "3115789a-63e7-53d3-b8d4-6e149d36c294" :answer/id #uuid "3115789a-63e7-53d3-b8d4-6e149d36c294"] [:db/add "3115789a-63e7-53d3-b8d4-6e149d36c294" :answer/type :answer.type/math] [:db/add "3115789a-63e7-53d3-b8d4-6e149d36c294" :answer/value "\\frac{42 \\operatorname{arctan}{\\left(7 x \\right)}}{5}+C"] [:db/ensure "3115789a-63e7-53d3-b8d4-6e149d36c294" :answer/validate] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/id #uuid "85972465-831a-5959-bb43-67e737123888"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/key "selection"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/type :answer-field.type/radio] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/choices "1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/choices "c8241a16-47b5-5eb2-a0ce-16edb25d79ee"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/choices "09a5a5c3-5963-5952-b70d-f29daf65f1c2"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/choices "20b7442b-bcfb-526d-b0e6-7ba3cd23c511"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/choices "3115789a-63e7-53d3-b8d4-6e149d36c294"] [:db/add "85972465-831a-5959-bb43-67e737123888" :answer-field/correct "c8241a16-47b5-5eb2-a0ce-16edb25d79ee"] [:db/ensure "85972465-831a-5959-bb43-67e737123888" :answer-field/validate] [:db/add "e24705b1-315a-5355-bc41-cabb19369d0b" :question/id #uuid "e24705b1-315a-5355-bc41-cabb19369d0b"] [:db/add "e24705b1-315a-5355-bc41-cabb19369d0b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{6}{245 x^{2} + 5}\\,\\mathrm{d}x\n$$"] [:db/add "e24705b1-315a-5355-bc41-cabb19369d0b" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n245 x^{2} + 5=5(1+(49)x^{2})\n$$\n\nUse the linear substitution $u=7 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=7,\\qquad \\mathrm{d}x=(\\frac{1}{7})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{6}{245 x^{2} + 5}\\,\\mathrm{d}x \\\\  &= \\frac{6}{5}\\int \\frac{1}{1+(7 x)^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{6}{5}(\\frac{1}{7})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{6}{35}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{6 \\operatorname{arctan}{\\left(u \\right)}}{35}+C \\\\  &= \\frac{6 \\operatorname{arctan}{\\left(7 x \\right)}}{35}+C\\end{aligned}\n$$"] [:db/add "e24705b1-315a-5355-bc41-cabb19369d0b" :question/difficulty :question.difficulty/hard] [:db/add "e24705b1-315a-5355-bc41-cabb19369d0b" :question/answer-fields "85972465-831a-5959-bb43-67e737123888"] [:db/ensure "e24705b1-315a-5355-bc41-cabb19369d0b" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "e24705b1-315a-5355-bc41-cabb19369d0b"] [:db/add "addd6c3c-9125-51be-a9c6-c00adaaae570" :answer/id #uuid "addd6c3c-9125-51be-a9c6-c00adaaae570"] [:db/add "addd6c3c-9125-51be-a9c6-c00adaaae570" :answer/type :answer.type/math] [:db/add "addd6c3c-9125-51be-a9c6-c00adaaae570" :answer/value "\\frac{7 \\sqrt{5} \\operatorname{arctan}{\\left(\\frac{\\sqrt{5} x}{5} \\right)}}{125}+C"] [:db/ensure "addd6c3c-9125-51be-a9c6-c00adaaae570" :answer/validate] [:db/add "9062dee4-44ad-5aa7-8574-bc177ce99fb7" :answer/id #uuid "9062dee4-44ad-5aa7-8574-bc177ce99fb7"] [:db/add "9062dee4-44ad-5aa7-8574-bc177ce99fb7" :answer/type :answer.type/math] [:db/add "9062dee4-44ad-5aa7-8574-bc177ce99fb7" :answer/value "\\frac{7 \\sqrt{5} \\operatorname{arctan}{\\left(\\frac{\\sqrt{5} x}{5} \\right)}}{25}+C"] [:db/ensure "9062dee4-44ad-5aa7-8574-bc177ce99fb7" :answer/validate] [:db/add "0d7d4c0f-5fa0-5f80-a5f5-aa0c2d376c50" :answer/id #uuid "0d7d4c0f-5fa0-5f80-a5f5-aa0c2d376c50"] [:db/add "0d7d4c0f-5fa0-5f80-a5f5-aa0c2d376c50" :answer/type :answer.type/math] [:db/add "0d7d4c0f-5fa0-5f80-a5f5-aa0c2d376c50" :answer/value "\\frac{7 \\sqrt{5} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{5} x}{5} \\right)}}{25}+C"] [:db/ensure "0d7d4c0f-5fa0-5f80-a5f5-aa0c2d376c50" :answer/validate] [:db/add "3f1d75d6-22d2-5ab9-b453-12fcf4cf7865" :answer/id #uuid "3f1d75d6-22d2-5ab9-b453-12fcf4cf7865"] [:db/add "3f1d75d6-22d2-5ab9-b453-12fcf4cf7865" :answer/type :answer.type/math] [:db/add "3f1d75d6-22d2-5ab