rt{10} x \\right)}}{5}+C\\end{aligned}\n$$"] [:db/add "ec536a71-42ec-5ebc-9d40-b2754ac5878c" :question/difficulty :question.difficulty/easy] [:db/add "ec536a71-42ec-5ebc-9d40-b2754ac5878c" :question/answer-fields "aca6f980-732b-5fcd-80e8-f202607f065d"] [:db/ensure "ec536a71-42ec-5ebc-9d40-b2754ac5878c" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "ec536a71-42ec-5ebc-9d40-b2754ac5878c"] [:db/add "0769c362-ae23-56e8-9ec9-7f91d8e28adc" :answer/id #uuid "0769c362-ae23-56e8-9ec9-7f91d8e28adc"] [:db/add "0769c362-ae23-56e8-9ec9-7f91d8e28adc" :answer/type :answer.type/math] [:db/add "0769c362-ae23-56e8-9ec9-7f91d8e28adc" :answer/value "9 \\operatorname{arctan}{\\left(2 x \\right)}+C"] [:db/ensure "0769c362-ae23-56e8-9ec9-7f91d8e28adc" :answer/validate] [:db/add "9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6" :answer/id #uuid "9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6"] [:db/add "9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6" :answer/type :answer.type/math] [:db/add "9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6" :answer/value "\\frac{9 \\operatorname{arctan}{\\left(x \\right)}}{2}+C"] [:db/ensure "9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6" :answer/validate] [:db/add "c41c9187-28fb-5a68-bc11-1ac2507b3cf1" :answer/id #uuid "c41c9187-28fb-5a68-bc11-1ac2507b3cf1"] [:db/add "c41c9187-28fb-5a68-bc11-1ac2507b3cf1" :answer/type :answer.type/math] [:db/add "c41c9187-28fb-5a68-bc11-1ac2507b3cf1" :answer/value "\\frac{9 \\operatorname{arcsin}{\\left(2 x \\right)}}{2}+C"] [:db/ensure "c41c9187-28fb-5a68-bc11-1ac2507b3cf1" :answer/validate] [:db/add "6b7824b8-9a8c-5756-8476-bbac3d10265a" :answer/id #uuid "6b7824b8-9a8c-5756-8476-bbac3d10265a"] [:db/add "6b7824b8-9a8c-5756-8476-bbac3d10265a" :answer/type :answer.type/math] [:db/add "6b7824b8-9a8c-5756-8476-bbac3d10265a" :answer/value "\\frac{9 \\operatorname{arctan}{\\left(2 x \\right)}}{2}+C"] [:db/ensure "6b7824b8-9a8c-5756-8476-bbac3d10265a" :answer/validate] [:db/add "13abb57a-6a30-51a9-9be4-207da1cf738a" :answer/id #uuid "13abb57a-6a30-51a9-9