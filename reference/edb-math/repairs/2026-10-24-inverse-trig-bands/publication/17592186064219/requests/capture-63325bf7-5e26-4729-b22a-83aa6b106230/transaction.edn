\frac{9}{4 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 9\\int \\frac{1}{1+(2 x)^{2}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{2})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{2}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\operatorname{arctan}{\\left(u \\right)}}{2}+C \\\\  &= \\frac{9 \\operatorname{arctan}{\\left(2 x \\right)}}{2}+C\\end{aligned}\n$$"] [:db/add "b184ca4c-53d9-5369-89fb-0039f0abbed1" :question/difficulty :question.difficulty/easy] [:db/add "b184ca4c-53d9-5369-89fb-0039f0abbed1" :question/answer-fields "a8f82dd4-2a36-5f47-8556-3c6a31591d63"] [:db/ensure "b184ca4c-53d9-5369-89fb-0039f0abbed1" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "b184ca4c-53d9-5369-89fb-0039f0abbed1"] [:db/add "fcada423-3e25-587e-9326-43fadd6f5698" :answer/id #uuid "fcada423-3e25-587e-9326-43fadd6f5698"] [:db/add "fcada423-3e25-587e-9326-43fadd6f5698" :answer/type :answer.type/math] [:db/add "fcada423-3e25-587e-9326-43fadd6f5698" :answer/value "\\sqrt{10} \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}+C"] [:db/ensure "fcada423-3e25-587e-9326-43fadd6f5698" :answer/validate] [:db/add "077df066-c1a9-5bdd-aba4-16684f634732" :answer/id #uuid "077df066-c1a9-5bdd-aba4-16684f634732"] [:db/add "077df066-c1a9-5bdd-aba4-16684f634732" :answer/type :answer.type/math] [:db/add "077df066-c1a9-5bdd-aba4-16684f634732" :answer/value "\\frac{\\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{10}+C"] [:db/ensure "077df066-c1a9-5bdd-aba4-16684f634732" :answer/validate] [:db/add "3161d050-8c20-530d-a5d6-f952f5390501" :answer/id #uuid "3161d050-8c20-530d-a5d6-f952f5390501"] [:db/add "3161d050-8c20-530d-a5d6-f952f5390501" :answer/type :answer.type/math] [:db/add "3161d050-8c20-530d-a5d6-f952f5390501" :answer/value "\\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}+C"] [:db/ensure "3161d050-8c20-530d-a5d6-f952f5390501" :answer/validate] [:db/add "f9c317fa-bb92-55a0-a62a-26a5b44699c0" :answer/id #uuid "f9c317fa-bb92-55a0-a62a-26a5b44699c0"]