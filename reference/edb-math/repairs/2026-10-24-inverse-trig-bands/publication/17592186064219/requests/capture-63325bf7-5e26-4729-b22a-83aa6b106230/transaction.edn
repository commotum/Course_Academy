-473c-5bf4-9598-3a717f823644" :answer-field/key "selection"] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/type :answer-field.type/radio] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/choices "2b636129-5f39-51a3-84e5-2abd974c2009"] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/choices "24ff35a2-12cf-5cee-878e-d0b766426a14"] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/choices "d8bc0d3a-5228-5caf-9e16-ef5c59b3a33b"] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/choices "771066be-5b08-556f-82d9-049a0d3f3ddc"] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/choices "04213b8c-a4f5-5d3a-9b15-2026b2773f38"] [:db/add "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/correct "d8bc0d3a-5228-5caf-9e16-ef5c59b3a33b"] [:db/ensure "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/validate] [:db/add "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/id #uuid "0328f6eb-ab94-54f1-a3fa-9db716e7cc30"] [:db/add "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{8}{x^{2} + 81}\\,\\mathrm{d}x\n$$"] [:db/add "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 81=81(1+(\\frac{1}{81})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{9},\\qquad \\mathrm{d}x=(9)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{8}{x^{2} + 81}\\,\\mathrm{d}x \\\\  &= \\frac{8}{81}\\int \\frac{1}{1+(\\frac{x}{9})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{81}(9)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{8}{9}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{8 \\operatorname{arctan}{\\left(u \\right)}}{9}+C \\\\  &= \\frac{8 \\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}}{9}+C\\end{aligned}\n$$"] [:db/add "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/difficulty :question.difficulty/moderate] [:db/add "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/answer-fields "33c84b16-473c-5bf4-9598-3a717f823644"] [:db/ensure "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "0328f6eb-ab94-54f1-a3fa-9db716e7cc30"] [:db/add "a01bd723-2e88-5b18-b635-5b6f088926d7" :answer/id #uuid "a01bd723-2e88-5b18-b635-5b6f088926d7"] [:db/add "a01bd723-2e88-5b18-b635-5b6f088926d7" :answer/type :answer.type/math] [:db/add "a01bd723-2e88-5b18-b635-5b6f088926d7" :answer/value "\\operatorname{arctan}{\\left(x \\right)}+C"] [:db/ensure "a01bd723-2e88-5b18-b635-5b6f088926d7" :answer/validate] [:db/add "ec2c399f-c1a2-59ab-a76c-a167e2ae9f09" :answer/id #uuid "ec2c399f-c1a2-59ab-a76c-a167e2ae9f09"] [:db/add "ec2c399f-c1a2-59ab-a76c-a167e2ae9f09" :answer/type :answer.type/math] [:db/add "ec2c399f-c1a2-59ab-a76c-a167e2ae9f09" :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{64}+C"] [:db/ensure "ec2c399f-c1a2-59ab-a76c-a167e2ae9f09" :answer/validate] [:db/add "856d11d6-0d10-53f1-84fb-098362206b3c" :answer/id #uuid "856d11d6-0d10-53f1-84fb-098362206b3c"] [:db/add "856d11d6-0d10-53f1-84fb-098362206b3c" :answer/type :answer.type/math] [:db/add "856d11d6-0d10-53f1-84fb-098362206b3c" :answer/value "\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}+C"] [:db/ensure "856d11d6-0d10-53f1-84fb-098362206b3c" :answer/validate] [:db/add "0438bd23-6c13-56c2-affd-2ac3c282ca73" :answer/id #uuid "0438bd23-6c13-56c2-affd-2ac3c282ca73"] [:db/add "0438bd23-6c13-56c2-affd-2ac3c282ca73" :answer/type :answer.type/math] [:db/add "0438bd23-6c13-56c2-affd-2ac3c282ca73" :answer/value "\\operatorname{arcsin}{\\left(\\frac{x}{8} \\right)}+C"] [:db/ensure "0438bd23-6c13-56c2-affd-2ac3c282ca73" :answer/validate] [:db/add "5be60abd-8380-5e16-bb21-