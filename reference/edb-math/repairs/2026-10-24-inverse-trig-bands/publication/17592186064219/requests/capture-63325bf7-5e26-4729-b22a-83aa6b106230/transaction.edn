2afad3313" :answer-field/choices "ed8ae318-a787-513f-8541-f627576c0f50"] [:db/add "bede5953-de93-55e7-9413-a0c2afad3313" :answer-field/choices "af1b5b20-413d-532c-a91f-7a7a59b90f40"] [:db/add "bede5953-de93-55e7-9413-a0c2afad3313" :answer-field/correct "17780bed-4359-5126-81c4-a87852eeacd3"] [:db/ensure "bede5953-de93-55e7-9413-a0c2afad3313" :answer-field/validate] [:db/add "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/id #uuid "5a03e52f-a789-58b8-8cc0-a47e970671ff"] [:db/add "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{x^{2} + 64}\\,\\mathrm{d}x\n$$"] [:db/add "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 64=64(1+(\\frac{1}{64})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{8},\\qquad \\mathrm{d}x=(8)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{x^{2} + 64}\\,\\mathrm{d}x \\\\  &= \\frac{1}{64}\\int \\frac{1}{1+(\\frac{x}{8})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{64}(8)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{8}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arctan}{\\left(u \\right)}}{8}+C \\\\  &= \\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{8}+C\\end{aligned}\n$$"] [:db/add "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/difficulty :question.difficulty/moderate] [:db/add "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/answer-fields "bede5953-de93-55e7-9413-a0c2afad3313"] [:db/ensure "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "5a03e52f-a789-58b8-8cc0-a47e970671ff"] [:db/add "2b636129-5f39-51a3-84e5-2abd974c2009" :answer/