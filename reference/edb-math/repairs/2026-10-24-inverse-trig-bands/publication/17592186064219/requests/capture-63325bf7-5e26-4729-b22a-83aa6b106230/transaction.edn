rac{4}{3 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 4\\int \\frac{1}{1+(\\sqrt{3} x)^{2}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{\\sqrt{3}}{3})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{3}}{3}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{3} \\operatorname{arctan}{\\left(u \\right)}}{3}+C \\\\  &= \\frac{4 \\sqrt{3} \\operatorname{arctan}{\\left(\\sqrt{3} x \\right)}}{3}+C\\end{aligned}\n$$"] [:db/add "540dfc73-65b7-5e01-852a-1098e492d974" :question/difficulty :question.difficulty/easy] [:db/add "540dfc73-65b7-5e01-852a-1098e492d974" :question/answer-fields "d4aefbc3-b1af-5b1a-a090-48229e2c59c1"] [:db/ensure "540dfc73-65b7-5e01-852a-1098e492d974" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "540dfc73-65b7-5e01-852a-1098e492d974"] [:db/add "ccab861f-97b1-5360-bb18-335589f6b68d" :answer/id #uuid "ccab861f-97b1-5360-bb18-335589f6b68d"] [:db/add "ccab861f-97b1-5360-bb18-335589f6b68d" :answer/type :answer.type/math] [:db/add "ccab861f-97b1-5360-bb18-335589f6b68d" :answer/value "\\frac{4 \\operatorname{arctan}{\\left(x \\right)}}{5}+C"] [:db/ensure "ccab861f-97b1-5360-bb18-335589f6b68d" :answer/validate] [:db/add "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/id #uuid "d81917ec-2137-583b-8e2a-6dba3b1cbb65"] [:db/add "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/type :answer.type/math] [:db/add "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/value "\\frac{4 \\operatorname{arctan}{\\left(5 x \\right)}}{5}+C"] [:db/ensure "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/validate] [:db/add "c066d068-8f0f-5b8f-9079-684135eeaaa4" :answer/id #uuid "c066d068-8f0f-5b8f-9079-684135eeaaa4"] [:db/add "c066d068-8f0f-5b8f-9079-684135eeaaa4" :answer/type :answer.type/math] [:db/add "c066d068-8f0f-5b8f-9079-684135eeaaa4" :answer/value "4 \\operatorname{arctan}{\\left(5 x \\right)}+C"] [:db/ensure "c066d068-8f0f-5b8f-9079-684135eeaaa4" :answer/validate] [:db/add "4dbf7579-c4a6-5e84-b316-e43a2c06c6d1" :answer/id #uuid "4dbf7579-c4a6-5e84-b3