stion/difficulty :question.difficulty/easy] [:db/add "785a58d5-601a-50af-b1f2-100d273d37ef" :question/answer-fields "b17f2626-b155-58de-9d66-8d6cd21bf664"] [:db/ensure "785a58d5-601a-50af-b1f2-100d273d37ef" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "785a58d5-601a-50af-b1f2-100d273d37ef"] [:db/add "b0bcc72f-effc-5119-94d9-67b8acd9060a" :answer/id #uuid "b0bcc72f-effc-5119-94d9-67b8acd9060a"] [:db/add "b0bcc72f-effc-5119-94d9-67b8acd9060a" :answer/type :answer.type/math] [:db/add "b0bcc72f-effc-5119-94d9-67b8acd9060a" :answer/value "\\frac{4 \\sqrt{3} \\operatorname{arctan}{\\left(\\sqrt{3} x \\right)}}{3}+C"] [:db/ensure "b0bcc72f-effc-5119-94d9-67b8acd9060a" :answer/validate] [:db/add "a09fdd28-10ed-5146-a8c9-c78e47e3a98d" :answer/id #uuid "a09fdd28-10ed-5146-a8c9-c78e47e3a98d"] [:db/add "a09fdd28-10ed-5146-a8c9-c78e47e3a98d" :answer/type :answer.type/math] [:db/add "a09fdd28-10ed-5146-a8c9-c78e47e3a98d" :answer/value "\\frac{4 \\sqrt{3} \\operatorname{arcsin}{\\left(\\sqrt{3} x \\right)}}{3}+C"] [:db/ensure "a09fdd28-10ed-5146-a8c9-c78e47e3a98d" :answer/validate] [:db/add "f58d9e97-798b-599a-9014-01605b801daf" :answer/id #uuid "f58d9e97-798b-599a-9014-01605b801daf"] [:db/add "f58d9e97-798b-599a-9014-01605b801daf" :answer/type :answer.type/math] [:db/add "f58d9e97-798b-599a-9014-01605b801daf" :answer/value "\\frac{4 \\sqrt{3} \\operatorname{arctan}{\\left(x \\right)}}{3}+C"] [:db/ensure "f58d9e97-798b-599a-9014-01605b801daf" :answer/validate] [:db/add "5ac2c4b5-4376-5a26-82cd-28b6e5fef581" :answer/id #uuid "5ac2c4b5-4376-5a26-82cd-28b6e5fef581"] [:db/add "5ac2c4b5-4376-5a26-82cd-28b6e5fef581" :answer/type :answer.type/math] [:db/add "5ac2c4b5-4376-5a26-82cd-28b6e5fef581" :answer/value "4 \\sqrt{3} \\operatorname{arctan}{\\left(\\sqrt{3} x \\right)}+C"] [:db/ensure "5ac2c4b5-4376-5a26-82cd-28b6e5fef581" :answer/validate] [:db/add "a7abed00-599b-52be-a273-794e20b361cd" :answer/id #uuid "a7abed00-599b-52be-a273-794e20b361cd"] [:db/add "a7ab