b877-5e59-5bba-9fdf-edd1082bc890\"] [:db/ensure \"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/validate] [:db/add \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/id #uuid \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\"] [:db/add \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"] [:db/add \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/difficulty :question.difficulty/moderate] [:db/add \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/answer-fields \"f9c6d4df-1b11-5cdc-98b5-b254e3330011\"] [:db/ensure \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\"] [:db/add \"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/id #uuid \"9129a361-2e73-5adc-96c4-fa751e6d00a4\"] [:db/add \"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/type :answer.type/math] [:db/add \"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{2}+C\"] [:db/ensure \"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/validate] [:db/add \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/id #uuid \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\"] [:db/add \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/type :answer.type/math] [:db/add \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [:db/ensure \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/validate] [:db/add \"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/id #uuid \"2e5efafe-ae73-5971-940e-1cb481b504a2\"] [:db/add \"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/type :answer.type/math] [:db/add \"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/validate] [:db/add \"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/id #uuid \"1e490206-6d56-5574-9453-0e68c12263f2\"] [:db/add \"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/type :answer.type/math] [:db/add \"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/validate] [:db/add \"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/id #uuid \"c5017709-422a-585d-8e3d-c3340f483d10\"] [:db/add \"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/type :answer.type/math] [:db/add \"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/value \"2 \\\\operatorname{arctan}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/validate] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/id #uuid \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/key \"selection\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/type :answer-field.type/radio] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"9129a361-2e73-5adc-96c4-fa751e6d00a4\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"2e5efafe-ae73-5971-940e-1cb481b504a2\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"1e490206-6d56-5574-9453-0e68c12263f2\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"c5017709-422a-585d-8e3d-c3340f483d10\"] [:db/add \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/correct \"2e5efafe-ae73-5971-940e-1cb481b504a2\"] [:db/ensure \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/validate] [:db/add \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/id #uuid \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\"] [:db/add \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 2\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 2 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"] [:db/add \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/difficulty :question.difficulty/moderate] [:db/add \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/answer-fields \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\"] [:db/ensure \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\"] [:db/add \"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/id #uuid \"1d9079dc-e0e9-5883-9ee0-be4e84800886\"] [:db/add \"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/type :answer.type/math] [:db/add \"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/validate] [:db/add \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/id #uuid \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\"] [:db/add \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/type :answer.type/math] [:db/add \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [:db/ensure \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/validate] [:db/add \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/id #uuid \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\"] [:db/add \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/type :answer.type/math] [:db/add \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/validate] [:db/add \"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/id #uuid \"c69ee190-e333-5892-a21c-1640d2670d8a\"] [:db/add \"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/type :answer.type/math] [:db/add \"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}}{3}+C\"] [:db/ensure \"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/validate] [:db/add \"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/id #uuid \"142408c4-a856-5ba3-9cb3-fdd989d60438\"] [:db/add \"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/type :answer.type/math] [:db/add \"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/validate] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/id #uuid \"e0a36f36-3cca-5caf-af0f-d26099a43110\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/key \"selection\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/type :answer-field.type/radio] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"1d9079dc-e0e9-5883-9ee0-be4e84800886\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"c69ee190-e333-5892-a21c-1640d2670d8a\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"142408c4-a856-5ba3-9cb3-fdd989d60438\"] [:db/add \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/correct \"1d9079dc-e0e9-5883-9ee0-be4e84800886\"] [:db/ensure \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/validate] [:db/add \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/id #uuid \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\"] [:db/add \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/worked-solution \"Use the linear substitution $u=3 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|3 x|=3|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{3}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{3}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|3 x|\\\\sqrt{(3 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{3})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|3 x|>1$; the constant may differ between those intervals.\"] [:db/add \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/difficulty :question.difficulty/hard] [:db/add \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/answer-fields \"e0a36f36-3cca-5caf-af0f-d26099a43110\"] [:db/ensure \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\"] [:db/add \"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/id #uuid \"e2cd009b-8c17-5c70-87e8-7659d526c59f\"] [:db/add \"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/type :answer.type/math] [:db/add \"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [:db/ensure \"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/validate] [:db/add \"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/id #uuid \"a52357f1-a274-5f15-ace4-aa9303c50604\"] [:db/add \"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/type :answer.type/math] [:db/add \"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/value \"5 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [:db/ensure \"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/validate] [:db/add \"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/id #uuid \"792218b4-1e15-5c28-b955-ccc4600c533e\"] [:db/add \"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/type :answer.type/math] [:db/add \"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [:db/ensure \"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/validate] [:db/add \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/id #uuid \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\"] [:db/add \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/type :answer.type/math] [:db/add \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [:db/ensure \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/validate] [:db/add \"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/id #uuid \"bb1874bf-30c9-586f-9061-209cdbe0411e\"] [:db/add \"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/type :answer.type/math] [:db/add \"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [:db/ensure \"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/validate] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/id #uuid \"15f2c563-ad1d-5843-a270-e994aa71edcb\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/key \"selection\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/type :answer-field.type/radio] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"e2cd009b-8c17-5c70-87e8-7659d526c59f\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"a52357f1-a274-5f15-ace4-aa9303c50604\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"792218b4-1e15-5c28-b955-ccc4600c533e\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"bb1874bf-30c9-586f-9061-209cdbe0411e\"] [:db/add \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/correct \"e2cd009b-8c17-5c70-87e8-7659d526c59f\"] [:db/ensure \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/validate] [:db/add \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/id #uuid \"bbd7d173-e034-5432-834c-943bd6bc824e\"] [:db/add \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{7} x|=\\\\sqrt{7}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{7}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 5 \\\\sqrt{7}\\\\int \\\\frac{1}{|\\\\sqrt{7} x|\\\\sqrt{(\\\\sqrt{7} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 5 \\\\sqrt{7}(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{7} x|>1$; the constant may differ between those intervals.\"] [:db/add \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/difficulty :question.difficulty/hard] [:db/add \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/answer-fields \"15f2c563-ad1d-5843-a270-e994aa71edcb\"] [:db/ensure \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"bbd7d173-e034-5432-834c-943bd6bc824e\"] [:db/add \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/id #uuid \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\"] [:db/add \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/type :answer.type/math] [:db/add \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\"] [:db/ensure \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/validate] [:db/add \"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/id #uuid \"39669edf-52ed-591a-bc4f-05f46c11d86d\"] [:db/add \"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/type :answer.type/math] [:db/add \"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{8}+C\"] [:db/ensure \"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/validate] [:db/add \"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/id #uuid \"a63a8958-2bad-585b-b08f-b28fdffa096b\"] [:db/add \"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/type :answer.type/math] [:db/add \"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/validate] [:db/add \"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/id #uuid \"0208a87c-e72d-5553-95a3-88676b1900da\"] [:db/add \"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/type :answer.type/math] [:db/add \"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{2}+C\"] [:db/ensure \"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/validate] [:db/add \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/id #uuid \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\"] [:db/add \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/type :answer.type/math] [:db/add \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{4}+C\"] [:db/ensure \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/validate] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/id #uuid \"95c1d718-179c-5ae2-9903-11398143c9ae\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/key \"selection\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/type :answer-field.type/radio] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"39669edf-52ed-591a-bc4f-05f46c11d86d\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"a63a8958-2bad-585b-b08f-b28fdffa096b\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"0208a87c-e72d-5553-95a3-88676b1900da\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\"] [:db/add \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/correct \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\"] [:db/ensure \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/validate] [:db/add \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/id #uuid \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\"] [:db/add \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{2|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|2 x|=2|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{2}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{2|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{2})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{2}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{2}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|2 x|>1$; the constant may differ between those intervals.\"] [:db/add \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/difficulty :question.difficulty/hard] [:db/add \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/answer-fields \"95c1d718-179c-5ae2-9903-11398143c9ae\"] [:db/ensure \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\"] [:db/add \"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/id #uuid \"52f20127-7026-51bd-b9eb-d3aaffbd7897\"] [:db/add \"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/type :answer.type/math] [:db/add \"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{6}+C\"] [:db/ensure \"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/validate] [:db/add \"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/id #uuid \"f8e644d1-662e-52e7-b469-8b247975de27\"] [:db/add \"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/type :answer.type/math] [:db/add \"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [:db/ensure \"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/validate] [:db/add \"a926cb91-61f3-563f-8349-379a686c3646\" :answer/id #uuid \"a926cb91-61f3-563f-8349-379a686c3646\"] [:db/add \"a926cb91-61f3-563f-8349-379a686c3646\" :answer/type :answer.type/math] [:db/add \"a926cb91-61f3-563f-8349-379a686c3646\" :answer/value \"30 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [:db/ensure \"a926cb91-61f3-563f-8349-379a686c3646\" :answer/validate] [:db/add \"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/id #uuid \"c3d34534-5046-50b0-a039-b5b4e49d9381\"] [:db/add \"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/type :answer.type/math] [:db/add \"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{36}+C\"] [:db/ensure \"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/validate] [:db/add \"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/id #uuid \"bab46891-026f-5774-bdfe-32c494dd6b77\"] [:db/add \"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/type :answer.type/math] [:db/add \"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(36 x \\\\right)}+C\"] [:db/ensure \"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/validate] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/id #uuid \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/key \"selection\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/type :answer-field.type/radio] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"52f20127-7026-51bd-b9eb-d3aaffbd7897\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"f8e644d1-662e-52e7-b469-8b247975de27\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"a926cb91-61f3-563f-8349-379a686c3646\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"c3d34534-5046-50b0-a039-b5b4e49d9381\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"bab46891-026f-5774-bdfe-32c494dd6b77\"] [:db/add \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/correct \"f8e644d1-662e-52e7-b469-8b247975de27\"] [:db/ensure \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/validate] [:db/add \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/id #uuid \"3feb255f-aeba-5dbb-91d6-6231c18cb161\"] [:db/add \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{36 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/worked-solution \"Use the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|6 x|=6|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{6}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{|x|\\\\sqrt{36 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 30\\\\int \\\\frac{1}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 30(\\\\frac{1}{6})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals.\"] [:db/add \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/difficulty :question.difficulty/hard] [:db/add \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/answer-fields \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\"] [:db/ensure \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"3feb255f-aeba-5dbb-91d6-6231c18cb161\"] [:db/add \"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/id #uuid \"4062c6f4-8073-59e2-8572-082fb67e86cd\"] [:db/add \"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/type :answer.type/math] [:db/add \"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/validate] [:db/add \"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/id #uuid \"f03be629-e361-57e1-aa79-d89c4c2e71ea\"] [:db/add \"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/type :answer.type/math] [:db/add \"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [:db/ensure \"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/validate] [:db/add \"95e14540-a907-57a9-af56-5c13e9653546\" :answer/id #uuid \"95e14540-a907-57a9-af56-5c13e9653546\"] [:db/add \"95e14540-a907-57a9-af56-5c13e9653546\" :answer/type :answer.type/math] [:db/add \"95e14540-a907-57a9-af56-5c13e9653546\" :answer/value \"9 \\\\sqrt{3} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [:db/ensure \"95e14540-a907-57a9-af56-5c13e9653546\" :answer/validate] [:db/add \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/id #uuid \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\"] [:db/add \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/type :answer.type/math] [:db/add \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/value \"3 \\\\sqrt{3} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [:db/ensure \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/validate] [:db/add \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/id #uuid \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\"] [:db/add \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/type :answer.type/math] [:db/add \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [:db/ensure \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/validate] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/id #uuid \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/key \"selection\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/type :answer-field.type/radio] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"4062c6f4-8073-59e2-8572-082fb67e86cd\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"f03be629-e361-57e1-aa79-d89c4c2e71ea\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"95e14540-a907-57a9-af56-5c13e9653546\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\"] [:db/add \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/correct \"f03be629-e361-57e1-aa79-d89c4c2e71ea\"] [:db/ensure \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/validate] [:db/add \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/id #uuid \"9109a0e2-f715-5496-8bcd-2bf0c487318b\"] [:db/add \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|x|\\\\sqrt{3 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{3} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{3},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{3}}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{3} x|=\\\\sqrt{3}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{3}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|x|\\\\sqrt{3 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{3}\\\\int \\\\frac{1}{|\\\\sqrt{3} x|\\\\sqrt{(\\\\sqrt{3} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{3}(\\\\frac{\\\\sqrt{3}}{3})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{3} x|>1$; the constant may differ between those intervals.\"] [:db/add \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/difficulty :question.difficulty/hard] [:db/add \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/answer-fields \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\"] [:db/ensure \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"9109a0e2-f715-5496-8bcd-2bf0c487318b\"] [:db/add \"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/id #uuid \"801ef18d-69aa-5378-b58a-91d4d3f3528c\"] [:db/add \"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/type :answer.type/math] [:db/add \"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{294}+C\"] [:db/ensure \"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/validate] [:db/add \"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/id #uuid \"42e651b5-5ee7-5e53-9e60-c92338128ff0\"] [:db/add \"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/type :answer.type/math] [:db/add \"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\"] [:db/ensure \"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/validate] [:db/add \"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/id #uuid \"f3049055-8ee7-5042-830b-a03fcd46e4c2\"] [:db/add \"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/type :answer.type/math] [:db/add \"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(49 x \\\\right)}}{6}+C\"] [:db/ensure \"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/validate] [:db/add \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/id #uuid \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\"] [:db/add \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/type :answer.type/math] [:db/add \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\"] [:db/ensure \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/validate] [:db/add \"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/id #uuid \"5c828979-a664-5348-8e96-bb972e22d4d4\"] [:db/add \"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/type :answer.type/math] [:db/add \"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{42}+C\"] [:db/ensure \"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/validate] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/id #uuid \"9c355901-1679-5d66-ba00-1c7d5b2850b1\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/key \"selection\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/type :answer-field.type/radio] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"801ef18d-69aa-5378-b58a-91d4d3f3528c\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"42e651b5-5ee7-5e53-9e60-c92338128ff0\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"f3049055-8ee7-5042-830b-a03fcd46e4c2\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"5c828979-a664-5348-8e96-bb972e22d4d4\"] [:db/add \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/correct \"42e651b5-5ee7-5e53-9e60-c92338128ff0\"] [:db/ensure \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/validate] [:db/add \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/id #uuid \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\"] [:db/add \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{6|x|\\\\sqrt{49 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{6|x|\\\\sqrt{49 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{6}\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{6}(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{6}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{6}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"] [:db/add \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/difficulty :question.difficulty/hard] [:db/add \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/answer-fields \"9c355901-1679-5d66-ba00-1c7d5b2850b1\"] [:db/ensure \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\"] [:db/add \"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/id #uuid \"90251f4c-b8bc-5104-8144-8db40d11f9fe\"] [:db/add \"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/type :answer.type/math] [:db/add \"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(16 x \\\\right)}+C\"] [:db/ensure \"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/validate] [:db/add \"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/id #uuid \"87ac9755-9f76-571a-b175-02e2902b7b30\"] [:db/add \"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/type :answer.type/math] [:db/add \"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/value \"28 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/validate] [:db/add \"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/id #uuid \"0126e7ef-2ec7-5d7f-a8d7-582407009616\"] [:db/add \"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/type :answer.type/math] [:db/add \"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/validate] [:db/add \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/id #uuid \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\"] [:db/add \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/type :answer.type/math] [:db/add \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{4}+C\"] [:db/ensure \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/validate] [:db/add \"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/id #uuid \"26615563-e530-5544-b9f7-a24d5d7c3520\"] [:db/add \"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/type :answer.type/math] [:db/add \"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{16}+C\"] [:db/ensure \"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/validate] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/id #uuid \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/key \"selection\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/type :answer-field.type/radio] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"90251f4c-b8bc-5104-8144-8db40d11f9fe\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"87ac9755-9f76-571a-b175-02e2902b7b30\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"0126e7ef-2ec7-5d7f-a8d7-582407009616\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"26615563-e530-5544-b9f7-a24d5d7c3520\"] [:db/add \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/correct \"0126e7ef-2ec7-5d7f-a8d7-582407009616\"] [:db/ensure \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/validate] [:db/add \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/id #uuid \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\"] [:db/add \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{7}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{7}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 28\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 28(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 7\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 7 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"] [:db/add \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/difficulty :question.difficulty/hard] [:db/add \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/answer-fields \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\"] [:db/ensure \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\"] [:db/add \"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/id #uuid \"e645444e-55cd-5743-bd4c-ad58f4b945a5\"] [:db/add \"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/type :answer.type/math] [:db/add \"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [:db/ensure \"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/validate] [:db/add \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/id #uuid \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\"] [:db/add \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/type :answer.type/math] [:db/add \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/value \"9 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [:db/ensure \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/validate] [:db/add \"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/id #uuid \"040ea9c9-e715-507d-902d-bb71351804ed\"] [:db/add \"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/type :answer.type/math] [:db/add \"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [:db/ensure \"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/validate] [:db/add \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/id #uuid \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\"] [:db/add \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/type :answer.type/math] [:db/add \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [:db/ensure \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/validate] [:db/add \"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/id #uuid \"335a8d6a-b4ec-5193-a45f-51bf7646df64\"] [:db/add \"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/type :answer.type/math] [:db/add \"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/value \"\\\\frac{9 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [:db/ensure \"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/validate] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/id #uuid \"e8606212-bc9b-52ae-8e0c-294774fd2b98\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/key \"selection\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/type :answer-field.type/radio] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"e645444e-55cd-5743-bd4c-ad58f4b945a5\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"040ea9c9-e715-507d-902d-bb71351804ed\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"335a8d6a-b4ec-5193-a45f-51bf7646df64\"] [:db/add \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/correct \"040ea9c9-e715-507d-902d-bb71351804ed\"] [:db/ensure \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/validate] [:db/add \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/id #uuid \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\"] [:db/add \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{7} x|=\\\\sqrt{7}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{7}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{7}\\\\int \\\\frac{1}{|\\\\sqrt{7} x|\\\\sqrt{(\\\\sqrt{7} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{7}(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{7} x|>1$; the constant may differ between those intervals.\"] [:db/add \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/difficulty :question.difficulty/hard] [:db/add \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/answer-fields \"e8606212-bc9b-52ae-8e0c-294774fd2b98\"] [:db/ensure \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\"] [:db/add \"generator\" :question-generator/id #uuid \"7ff11018-92f2-5ce1-bd0a-135534338d0e\"] [:db/add \"generator\" :question-generator/script \"generators/8a/8a0c90144a6646880afd310214594dfeb8ddcf955e4d1aa7a69b728cc305a94f/generator.py\"] [:db/add 17592186064250 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186064250 :knowledge-point/validate]] \"assertions\" [[\"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/id #uuid \"ab2399d7-22bf-5740-880c-727575b60c80\"] [\"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/type :answer.type/math] [\"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\"] [\"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/id #uuid \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\"] [\"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/type :answer.type/math] [\"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(196 x \\\\right)}+C\"] [\"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/id #uuid \"74cae605-ea8d-5ca5-8033-c10411a836ab\"] [\"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/type :answer.type/math] [\"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}}{196}+C\"] [\"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/id #uuid \"eed14417-4f9a-5aae-9ec6-27bba65a8975\"] [\"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/type :answer.type/math] [\"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/value \"14 \\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\"] [\"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/id #uuid \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\"] [\"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/type :answer.type/math] [\"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}}{14}+C\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/id #uuid \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/key \"selection\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/type :answer-field.type/radio] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"ab2399d7-22bf-5740-880c-727575b60c80\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"74cae605-ea8d-5ca5-8033-c10411a836ab\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"eed14417-4f9a-5aae-9ec6-27bba65a8975\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\"] [\"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/correct \"ab2399d7-22bf-5740-880c-727575b60c80\"] [\"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/id #uuid \"2c86da1f-3334-519e-bd8d-02dc5abc2552\"] [\"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{14}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/worked-solution \"Use the linear substitution $u=14 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=14,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{14})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|14 x|=14|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{14}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{14}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 14\\\\int \\\\frac{1}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 14(\\\\frac{1}{14})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|14 x|>1$; the constant may differ between those intervals.\"] [\"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/difficulty :question.difficulty/easy] [\"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/answer-fields \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\"] [17592186064250 :knowledge-point/questions \"2c86da1f-3334-519e-bd8d-02dc5abc2552\"] [\"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/id #uuid \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\"] [\"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/type :answer.type/math] [\"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/id #uuid \"d02f031d-3d68-5f84-adca-189e93f397fa\"] [\"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/type :answer.type/math] [\"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/id #uuid \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\"] [\"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/type :answer.type/math] [\"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{16}+C\"] [\"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/id #uuid \"006b058a-8757-53b5-9e86-166b3bad3f57\"] [\"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/type :answer.type/math] [\"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{4}+C\"] [\"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/id #uuid \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\"] [\"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/type :answer.type/math] [\"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(16 x \\\\right)}+C\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/id #uuid \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/key \"selection\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/type :answer-field.type/radio] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"d02f031d-3d68-5f84-adca-189e93f397fa\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"006b058a-8757-53b5-9e86-166b3bad3f57\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\"] [\"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/correct \"d02f031d-3d68-5f84-adca-189e93f397fa\"] [\"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/id #uuid \"76457b92-955f-57c1-a7b4-2de23b67fcb9\"] [\"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"] [\"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/difficulty :question.difficulty/easy] [\"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/answer-fields \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\"] [17592186064250 :knowledge-point/questions \"76457b92-955f-57c1-a7b4-2de23b67fcb9\"] [\"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/id #uuid \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\"] [\"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/type :answer.type/math] [\"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/value \"11 \\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\"] [\"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/id #uuid \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\"] [\"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/type :answer.type/math] [\"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}}{11}+C\"] [\"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/id #uuid \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\"] [\"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/type :answer.type/math] [\"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\"] [\"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/id #uuid \"0e0be1ee-1432-52ae-9e94-69b713d648c2\"] [\"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/type :answer.type/math] [\"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(121 x \\\\right)}+C\"] [\"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/id #uuid \"59b25816-1279-51cb-af04-13bca7bd5f42\"] [\"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/type :answer.type/math] [\"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}}{121}+C\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/id #uuid \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/key \"selection\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/type :answer-field.type/radio] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"0e0be1ee-1432-52ae-9e94-69b713d648c2\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"59b25816-1279-51cb-af04-13bca7bd5f42\"] [\"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/correct \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\"] [\"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/id #uuid \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\"] [\"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{11}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/worked-solution \"Use the linear substitution $u=11 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=11,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{11})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|11 x|=11|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{11}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{11}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 11\\\\int \\\\frac{1}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 11(\\\\frac{1}{11})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|11 x|>1$; the constant may differ between those intervals.\"] [\"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/difficulty :question.difficulty/easy] [\"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/answer-fields \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\"] [17592186064250 :knowledge-point/questions \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\"] [\"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/id #uuid \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\"] [\"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/type :answer.type/math] [\"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/value \"10 \\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\"] [\"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/id #uuid \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\"] [\"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/type :answer.type/math] [\"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}}{10}+C\"] [\"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/id #uuid \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\"] [\"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/type :answer.type/math] [\"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}}{100}+C\"] [\"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/id #uuid \"ac14cc1a-0019-5315-94d9-d5219638bc74\"] [\"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/type :answer.type/math] [\"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\"] [\"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/id #uuid \"361c11c2-2fa8-565f-b175-a7e910e759d9\"] [\"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/type :answer.type/math] [\"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(100 x \\\\right)}+C\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/id #uuid \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/key \"selection\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/type :answer-field.type/radio] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"ac14cc1a-0019-5315-94d9-d5219638bc74\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"361c11c2-2fa8-565f-b175-a7e910e759d9\"] [\"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/correct \"ac14cc1a-0019-5315-94d9-d5219638bc74\"] [\"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/id #uuid \"97af9687-66c6-579d-97d7-01feb5f40f72\"] [\"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{10}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/worked-solution \"Use the linear substitution $u=10 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{10})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|10 x|=10|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{10}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{10}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 10\\\\int \\\\frac{1}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 10(\\\\frac{1}{10})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|10 x|>1$; the constant may differ between those intervals.\"] [\"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/difficulty :question.difficulty/easy] [\"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/answer-fields \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\"] [17592186064250 :knowledge-point/questions \"97af9687-66c6-579d-97d7-01feb5f40f72\"] [\"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/id #uuid \"7616d1f3-8012-52d1-b910-e3117af611f5\"] [\"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/type :answer.type/math] [\"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\"] [\"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/id #uuid \"f781316b-ad0d-5599-b0d1-a715216cc7e8\"] [\"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/type :answer.type/math] [\"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{81}+C\"] [\"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/id #uuid \"093e8ee9-6706-5ac0-9856-c97b4df6f556\"] [\"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/type :answer.type/math] [\"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [\"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/id #uuid \"520052f9-511f-5463-abd6-61c01b26c6c9\"] [\"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/type :answer.type/math] [\"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(81 x \\\\right)}+C\"] [\"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/id #uuid \"2d562848-1d97-52e5-9683-cb014d13bdb0\"] [\"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/type :answer.type/math] [\"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/id #uuid \"60467e61-e7b2-548a-a8c4-112122fa9c9b\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/key \"selection\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/type :answer-field.type/radio] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"7616d1f3-8012-52d1-b910-e3117af611f5\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"f781316b-ad0d-5599-b0d1-a715216cc7e8\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"093e8ee9-6706-5ac0-9856-c97b4df6f556\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"520052f9-511f-5463-abd6-61c01b26c6c9\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"2d562848-1d97-52e5-9683-cb014d13bdb0\"] [\"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/correct \"2d562848-1d97-52e5-9683-cb014d13bdb0\"] [\"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/id #uuid \"1330265e-12c1-57f0-82dd-95378d9f20b0\"] [\"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/worked-solution \"Use the linear substitution $u=9 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{9})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|9 x|=9|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{9}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{9})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals.\"] [\"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/difficulty :question.difficulty/easy] [\"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/answer-fields \"60467e61-e7b2-548a-a8c4-112122fa9c9b\"] [17592186064250 :knowledge-point/questions \"1330265e-12c1-57f0-82dd-95378d9f20b0\"] [\"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/id #uuid \"0420b9b3-9028-5e27-bbba-45726475b49d\"] [\"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/type :answer.type/math] [\"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [\"84724433-c0c0-532e-a461-3914e4459162\" :answer/id #uuid \"84724433-c0c0-532e-a461-3914e4459162\"] [\"84724433-c0c0-532e-a461-3914e4459162\" :answer/type :answer.type/math] [\"84724433-c0c0-532e-a461-3914e4459162\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{36}+C\"] [\"b10591d8-d226-5f76-8227-953214d235b0\" :answer/id #uuid \"b10591d8-d226-5f76-8227-953214d235b0\"] [\"b10591d8-d226-5f76-8227-953214d235b0\" :answer/type :answer.type/math] [\"b10591d8-d226-5f76-8227-953214d235b0\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(36 x \\\\right)}+C\"] [\"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/id #uuid \"5c8f252f-19a7-51d6-bf28-81657f02c35f\"] [\"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/type :answer.type/math] [\"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/value \"6 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [\"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/id #uuid \"5dce131d-6dd3-5b85-9b63-176d037ffa33\"] [\"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/type :answer.type/math] [\"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{6}+C\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/id #uuid \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/key \"selection\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/type :answer-field.type/radio] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"0420b9b3-9028-5e27-bbba-45726475b49d\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"84724433-c0c0-532e-a461-3914e4459162\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"b10591d8-d226-5f76-8227-953214d235b0\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"5c8f252f-19a7-51d6-bf28-81657f02c35f\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"5dce131d-6dd3-5b85-9b63-176d037ffa33\"] [\"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/correct \"0420b9b3-9028-5e27-bbba-45726475b49d\"] [\"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/id #uuid \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\"] [\"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{6}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/worked-solution \"Use the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|6 x|=6|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{6}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{6}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 6\\\\int \\\\frac{1}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 6(\\\\frac{1}{6})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals.\"] [\"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/difficulty :question.difficulty/easy] [\"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/answer-fields \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\"] [17592186064250 :knowledge-point/questions \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\"] [\"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/id #uuid \"4834c340-bc67-5aa0-8c75-aeeabb21803e\"] [\"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/type :answer.type/math] [\"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}}{15}+C\"] [\"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/id #uuid \"1073775f-1bbc-52ab-8c7e-572379bc0994\"] [\"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/type :answer.type/math] [\"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\"] [\"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/id #uuid \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\"] [\"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/type :answer.type/math] [\"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/value \"15 \\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\"] [\"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/id #uuid \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\"] [\"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/type :answer.type/math] [\"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(225 x \\\\right)}+C\"] [\"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/id #uuid \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\"] [\"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/type :answer.type/math] [\"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}}{225}+C\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/id #uuid \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/key \"selection\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/type :answer-field.type/radio] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"4834c340-bc67-5aa0-8c75-aeeabb21803e\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"1073775f-1bbc-52ab-8c7e-572379bc0994\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\"] [\"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/correct \"1073775f-1bbc-52ab-8c7e-572379bc0994\"] [\"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/id #uuid \"feb12510-c969-520b-8bb7-8c2c49a14e5f\"] [\"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{15}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/worked-solution \"Use the linear substitution $u=15 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{15})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|15 x|=15|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{15}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{15}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 15\\\\int \\\\frac{1}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 15(\\\\frac{1}{15})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|15 x|>1$; the constant may differ between those intervals.\"] [\"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/difficulty :question.difficulty/easy] [\"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/answer-fields \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\"] [17592186064250 :knowledge-point/questions \"feb12510-c969-520b-8bb7-8c2c49a14e5f\"] [\"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/id #uuid \"e6780705-5037-5ae0-94fe-1022c619a279\"] [\"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/type :answer.type/math] [\"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}}{13}+C\"] [\"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/id #uuid \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\"] [\"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/type :answer.type/math] [\"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}}{169}+C\"] [\"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/id #uuid \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\"] [\"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/type :answer.type/math] [\"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\"] [\"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/id #uuid \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\"] [\"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/type :answer.type/math] [\"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/value \"13 \\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\"] [\"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/id #uuid \"50b95fae-4e0c-584b-8066-dbac126da0ec\"] [\"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/type :answer.type/math] [\"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(169 x \\\\right)}+C\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/id #uuid \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/key \"selection\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/type :answer-field.type/radio] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"e6780705-5037-5ae0-94fe-1022c619a279\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"50b95fae-4e0c-584b-8066-dbac126da0ec\"] [\"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/correct \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\"] [\"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/id #uuid \"8bc2e902-71e9-5912-9706-6f6dd6006240\"] [\"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{13}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/worked-solution \"Use the linear substitution $u=13 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=13,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{13})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|13 x|=13|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{13}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{13}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 13\\\\int \\\\frac{1}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 13(\\\\frac{1}{13})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|13 x|>1$; the constant may differ between those intervals.\"] [\"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/difficulty :question.difficulty/easy] [\"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/answer-fields \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\"] [17592186064250 :knowledge-point/questions \"8bc2e902-71e9-5912-9706-6f6dd6006240\"] [\"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/id #uuid \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\"] [\"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/type :answer.type/math] [\"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\"] [\"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/id #uuid \"ba323a7e-319b-5495-ba14-d1d7a671d138\"] [\"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/type :answer.type/math] [\"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{9}+C\"] [\"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/id #uuid \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\"] [\"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/type :answer.type/math] [\"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(9 x \\\\right)}}{9}+C\"] [\"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/id #uuid \"5926164f-fed6-5e3a-ba40-860db0a5ab38\"] [\"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/type :answer.type/math] [\"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{81}+C\"] [\"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/id #uuid \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\"] [\"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/type :answer.type/math] [\"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/id #uuid \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/key \"selection\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/type :answer-field.type/radio] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"ba323a7e-319b-5495-ba14-d1d7a671d138\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"5926164f-fed6-5e3a-ba40-860db0a5ab38\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\"] [\"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/correct \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\"] [\"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/id #uuid \"2ed62d92-c36a-50a5-9c81-caff226f716e\"] [\"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/worked-solution \"Use the linear substitution $u=9 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{9})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|9 x|=9|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{9}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{9})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{9}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{9}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals.\"] [\"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/difficulty :question.difficulty/moderate] [\"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/answer-fields \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\"] [17592186064250 :knowledge-point/questions \"2ed62d92-c36a-50a5-9c81-caff226f716e\"] [\"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/id #uuid \"228bf48b-6c00-5de6-bd83-cd4703885c3b\"] [\"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/type :answer.type/math] [\"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/id #uuid \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\"] [\"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/type :answer.type/math] [\"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [\"f3779970-0bfa-5296-b548-2b234032333d\" :answer/id #uuid \"f3779970-0bfa-5296-b548-2b234032333d\"] [\"f3779970-0bfa-5296-b548-2b234032333d\" :answer/type :answer.type/math] [\"f3779970-0bfa-5296-b548-2b234032333d\" :answer/value \"4 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}+C\"] [\"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/id #uuid \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\"] [\"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/type :answer.type/math] [\"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/id #uuid \"0f28e42b-8620-5ae1-8f04-805f88867c6c\"] [\"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/type :answer.type/math] [\"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/id #uuid \"77b14ff6-ee23-5c1a-82b3-746ee344c414\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/key \"selection\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/type :answer-field.type/radio] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"228bf48b-6c00-5de6-bd83-cd4703885c3b\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"f3779970-0bfa-5296-b548-2b234032333d\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"0f28e42b-8620-5ae1-8f04-805f88867c6c\"] [\"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/correct \"228bf48b-6c00-5de6-bd83-cd4703885c3b\"] [\"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/id #uuid \"8ec467ed-a842-5743-90ea-dc3e43a5c825\"] [\"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|2 x|=2|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{2}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{2})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|2 x|>1$; the constant may differ between those intervals.\"] [\"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/difficulty :question.difficulty/moderate] [\"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/answer-fields \"77b14ff6-ee23-5c1a-82b3-746ee344c414\"] [17592186064250 :knowledge-point/questions \"8ec467ed-a842-5743-90ea-dc3e43a5c825\"] [\"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/id #uuid \"1d199601-926c-5873-9d3f-90aebc32fddf\"] [\"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/type :answer.type/math] [\"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\"] [\"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/id #uuid \"fc8cda26-f6db-5986-9ef8-10b89f69beda\"] [\"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/type :answer.type/math] [\"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\"] [\"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/id #uuid \"15e65e07-085b-550a-a717-82d2d0a4449f\"] [\"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/type :answer.type/math] [\"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{64}+C\"] [\"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/id #uuid \"b71fa791-be0c-5a48-a50c-ab3294c89e93\"] [\"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/type :answer.type/math] [\"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}+C\"] [\"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/id #uuid \"e2e87151-dca4-5f40-a571-21cca555c271\"] [\"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/type :answer.type/math] [\"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{8}+C\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/id #uuid \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/key \"selection\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/type :answer-field.type/radio] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"1d199601-926c-5873-9d3f-90aebc32fddf\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"fc8cda26-f6db-5986-9ef8-10b89f69beda\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"15e65e07-085b-550a-a717-82d2d0a4449f\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"b71fa791-be0c-5a48-a50c-ab3294c89e93\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"e2e87151-dca4-5f40-a571-21cca555c271\"] [\"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/correct \"1d199601-926c-5873-9d3f-90aebc32fddf\"] [\"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/id #uuid \"445c17c5-47bb-5095-a41c-cf964b636e04\"] [\"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|8 x|=8|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{8}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{8})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9}{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals.\"] [\"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/difficulty :question.difficulty/moderate] [\"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/answer-fields \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\"] [17592186064250 :knowledge-point/questions \"445c17c5-47bb-5095-a41c-cf964b636e04\"] [\"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/id #uuid \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\"] [\"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/type :answer.type/math] [\"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}+C\"] [\"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/id #uuid \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\"] [\"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/type :answer.type/math] [\"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\"] [\"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/id #uuid \"6e42acbb-4f56-56be-a048-fba84c7dc573\"] [\"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/type :answer.type/math] [\"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\"] [\"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/id #uuid \"20bf9841-2595-5f27-b0e8-1e9284708c28\"] [\"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/type :answer.type/math] [\"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{8}+C\"] [\"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/id #uuid \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\"] [\"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/type :answer.type/math] [\"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{64}+C\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/id #uuid \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/key \"selection\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/type :answer-field.type/radio] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"6e42acbb-4f56-56be-a048-fba84c7dc573\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"20bf9841-2595-5f27-b0e8-1e9284708c28\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\"] [\"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/correct \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\"] [\"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/id #uuid \"184d3205-f072-5ec2-ae47-f41ae45b3346\"] [\"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|8 x|=8|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{8}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{8})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals.\"] [\"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/difficulty :question.difficulty/moderate] [\"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/answer-fields \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\"] [17592186064250 :knowledge-point/questions \"184d3205-f072-5ec2-ae47-f41ae45b3346\"] [\"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/id #uuid \"c566ac9c-ddcc-5843-b570-313dfc0d0833\"] [\"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/type :answer.type/math] [\"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/value \"\\\\frac{4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}}{5}+C\"] [\"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/id #uuid \"ba9ea4eb-0793-5e14-bb35-81349da6a845\"] [\"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/type :answer.type/math] [\"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\"] [\"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/id #uuid \"e626e4b2-798b-511a-9112-b64176edcf02\"] [\"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/type :answer.type/math] [\"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [\"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/id #uuid \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\"] [\"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/type :answer.type/math] [\"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/value \"20 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\"] [\"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/id #uuid \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\"] [\"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/type :answer.type/math] [\"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/value \"4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}+C\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/id #uuid \"d6e53eea-4a9c-579c-9473-40e52033ceba\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/key \"selection\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/type :answer-field.type/radio] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"c566ac9c-ddcc-5843-b570-313dfc0d0833\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"ba9ea4eb-0793-5e14-bb35-81349da6a845\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"e626e4b2-798b-511a-9112-b64176edcf02\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\"] [\"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/correct \"ba9ea4eb-0793-5e14-bb35-81349da6a845\"] [\"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/id #uuid \"c2cb4fba-879b-5b01-9945-6bb60bed682b\"] [\"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{20}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/worked-solution \"Use the linear substitution $u=5 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|5 x|=5|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{5}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{20}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 20\\\\int \\\\frac{1}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 20(\\\\frac{1}{5})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|5 x|>1$; the constant may differ between those intervals.\"] [\"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/difficulty :question.difficulty/moderate] [\"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/answer-fields \"d6e53eea-4a9c-579c-9473-40e52033ceba\"] [17592186064250 :knowledge-point/questions \"c2cb4fba-879b-5b01-9945-6bb60bed682b\"] [\"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/id #uuid \"2cfb56c8-c193-500d-8069-1875caf5cdec\"] [\"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/type :answer.type/math] [\"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [\"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/id #uuid \"26f6ae5e-13b1-5d98-ad21-85c5db855690\"] [\"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/type :answer.type/math] [\"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\"] [\"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/id #uuid \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\"] [\"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/type :answer.type/math] [\"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{49}+C\"] [\"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/id #uuid \"a2305993-b75e-568a-b17f-56fd24469b05\"] [\"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/type :answer.type/math] [\"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{7}+C\"] [\"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/id #uuid \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\"] [\"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/type :answer.type/math] [\"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{7}+C\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/id #uuid \"71ec24ab-1b85-5c39-bff9-ac067e868069\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/key \"selection\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/type :answer-field.type/radio] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"2cfb56c8-c193-500d-8069-1875caf5cdec\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"26f6ae5e-13b1-5d98-ad21-85c5db855690\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"a2305993-b75e-568a-b17f-56fd24469b05\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\"] [\"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/correct \"26f6ae5e-13b1-5d98-ad21-85c5db855690\"] [\"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/id #uuid \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\"] [\"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8}{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"] [\"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/difficulty :question.difficulty/moderate] [\"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/answer-fields \"71ec24ab-1b85-5c39-bff9-ac067e868069\"] [17592186064250 :knowledge-point/questions \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\"] [\"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/id #uuid \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\"] [\"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/type :answer.type/math] [\"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{7}+C\"] [\"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/id #uuid \"5104680c-2ea7-5a28-9524-a65df4157530\"] [\"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/type :answer.type/math] [\"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [\"99e9b877-5e59-5bba-9fdf-edd1082bc890\" :answer/id #uuid \"99e9b877-5e59-5bba-9fdf-edd1082bc890\"] [\"99e9b877-5e59-5bba-9fdf-edd1082bc890\" :answer/type :answer.type/math] [\"99e9b877-5e59-5bba-9fdf-edd1082bc890\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\"] [\"88a8138f-4879-55af-97f9-f23b9b258f0e\" :answer/id #uuid \"88a8138f-4879-55af-97f9-f23b9b258f0e\"] [\"88a8138f-4879-55af-97f9-f23b9b258f0e\" :answer/type :answer.type/math] [\"88a8138f-4879-55af-97f9-f23b9b258f0e\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{49}+C\"] [\"0508ef6a-4649-544f-ab1c-27e5adee2091\" :answer/id #uuid \"0508ef6a-4649-544f-ab1c-27e5adee2091\"] [\"0508ef6a-4649-544f-ab1c-27e5adee2091\" :answer/type :answer.type/math] [\"0508ef6a-4649-544f-ab1c-27e5adee2091\" :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{7}+C\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/id #uuid \"f9c6d4df-1b11-5cdc-98b5-b254e3330011\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/key \"selection\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/type :answer-field.type/radio] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/choices \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/choices \"5104680c-2ea7-5a28-9524-a65df4157530\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/choices \"99e9b877-5e59-5bba-9fdf-edd1082bc890\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/choices \"88a8138f-4879-55af-97f9-f23b9b258f0e\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/choices \"0508ef6a-4649-544f-ab1c-27e5adee2091\"] [\"f9c6d4df-1b11-5cdc-98b5-b254e3330011\" :answer-field/correct \"99e9b877-5e59-5bba-9fdf-edd1082bc890\"] [\"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/id #uuid \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\"] [\"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"] [\"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/difficulty :question.difficulty/moderate] [\"56cb2a9f-1cff-57aa-9994-7646c802ee0c\" :question/answer-fields \"f9c6d4df-1b11-5cdc-98b5-b254e3330011\"] [17592186064250 :knowledge-point/questions \"56cb2a9f-1cff-57aa-9994-7646c802ee0c\"] [\"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/id #uuid \"9129a361-2e73-5adc-96c4-fa751e6d00a4\"] [\"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/type :answer.type/math] [\"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{2}+C\"] [\"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/id #uuid \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\"] [\"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/type :answer.type/math] [\"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [\"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/id #uuid \"2e5efafe-ae73-5971-940e-1cb481b504a2\"] [\"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/type :answer.type/math] [\"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/id #uuid \"1e490206-6d56-5574-9453-0e68c12263f2\"] [\"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/type :answer.type/math] [\"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/id #uuid \"c5017709-422a-585d-8e3d-c3340f483d10\"] [\"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/type :answer.type/math] [\"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/value \"2 \\\\operatorname{arctan}{\\\\left(4 x \\\\right)}+C\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/id #uuid \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/key \"selection\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/type :answer-field.type/radio] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"9129a361-2e73-5adc-96c4-fa751e6d00a4\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"2e5efafe-ae73-5971-940e-1cb481b504a2\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"1e490206-6d56-5574-9453-0e68c12263f2\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/choices \"c5017709-422a-585d-8e3d-c3340f483d10\"] [\"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/correct \"2e5efafe-ae73-5971-940e-1cb481b504a2\"] [\"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/id #uuid \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\"] [\"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 2\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 2 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"] [\"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/difficulty :question.difficulty/moderate] [\"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/answer-fields \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\"] [17592186064250 :knowledge-point/questions \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\"] [\"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/id #uuid \"1d9079dc-e0e9-5883-9ee0-be4e84800886\"] [\"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/type :answer.type/math] [\"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/id #uuid \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\"] [\"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/type :answer.type/math] [\"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [\"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/id #uuid \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\"] [\"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/type :answer.type/math] [\"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/id #uuid \"c69ee190-e333-5892-a21c-1640d2670d8a\"] [\"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/type :answer.type/math] [\"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}}{3}+C\"] [\"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/id #uuid \"142408c4-a856-5ba3-9cb3-fdd989d60438\"] [\"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/type :answer.type/math] [\"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/id #uuid \"e0a36f36-3cca-5caf-af0f-d26099a43110\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/key \"selection\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/type :answer-field.type/radio] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"1d9079dc-e0e9-5883-9ee0-be4e84800886\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"c69ee190-e333-5892-a21c-1640d2670d8a\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/choices \"142408c4-a856-5ba3-9cb3-fdd989d60438\"] [\"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/correct \"1d9079dc-e0e9-5883-9ee0-be4e84800886\"] [\"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/id #uuid \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\"] [\"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/worked-solution \"Use the linear substitution $u=3 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|3 x|=3|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{3}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{3}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|3 x|\\\\sqrt{(3 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{3})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|3 x|>1$; the constant may differ between those intervals.\"] [\"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/difficulty :question.difficulty/hard] [\"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/answer-fields \"e0a36f36-3cca-5caf-af0f-d26099a43110\"] [17592186064250 :knowledge-point/questions \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\"] [\"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/id #uuid \"e2cd009b-8c17-5c70-87e8-7659d526c59f\"] [\"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/type :answer.type/math] [\"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [\"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/id #uuid \"a52357f1-a274-5f15-ace4-aa9303c50604\"] [\"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/type :answer.type/math] [\"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/value \"5 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [\"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/id #uuid \"792218b4-1e15-5c28-b955-ccc4600c533e\"] [\"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/type :answer.type/math] [\"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [\"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/id #uuid \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\"] [\"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/type :answer.type/math] [\"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [\"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/id #uuid \"bb1874bf-30c9-586f-9061-209cdbe0411e\"] [\"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/type :answer.type/math] [\"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/id #uuid \"15f2c563-ad1d-5843-a270-e994aa71edcb\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/key \"selection\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/type :answer-field.type/radio] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"e2cd009b-8c17-5c70-87e8-7659d526c59f\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"a52357f1-a274-5f15-ace4-aa9303c50604\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"792218b4-1e15-5c28-b955-ccc4600c533e\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/choices \"bb1874bf-30c9-586f-9061-209cdbe0411e\"] [\"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/correct \"e2cd009b-8c17-5c70-87e8-7659d526c59f\"] [\"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/id #uuid \"bbd7d173-e034-5432-834c-943bd6bc824e\"] [\"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{7} x|=\\\\sqrt{7}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{7}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 5 \\\\sqrt{7}\\\\int \\\\frac{1}{|\\\\sqrt{7} x|\\\\sqrt{(\\\\sqrt{7} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 5 \\\\sqrt{7}(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{7} x|>1$; the constant may differ between those intervals.\"] [\"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/difficulty :question.difficulty/hard] [\"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/answer-fields \"15f2c563-ad1d-5843-a270-e994aa71edcb\"] [17592186064250 :knowledge-point/questions \"bbd7d173-e034-5432-834c-943bd6bc824e\"] [\"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/id #uuid \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\"] [\"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/type :answer.type/math] [\"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\"] [\"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/id #uuid \"39669edf-52ed-591a-bc4f-05f46c11d86d\"] [\"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/type :answer.type/math] [\"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{8}+C\"] [\"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/id #uuid \"a63a8958-2bad-585b-b08f-b28fdffa096b\"] [\"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/type :answer.type/math] [\"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/id #uuid \"0208a87c-e72d-5553-95a3-88676b1900da\"] [\"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/type :answer.type/math] [\"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{2}+C\"] [\"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/id #uuid \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\"] [\"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/type :answer.type/math] [\"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{4}+C\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/id #uuid \"95c1d718-179c-5ae2-9903-11398143c9ae\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/key \"selection\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/type :answer-field.type/radio] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"39669edf-52ed-591a-bc4f-05f46c11d86d\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"a63a8958-2bad-585b-b08f-b28fdffa096b\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"0208a87c-e72d-5553-95a3-88676b1900da\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/choices \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\"] [\"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/correct \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\"] [\"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/id #uuid \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\"] [\"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{2|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|2 x|=2|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{2}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{2|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{2})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{2}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{2}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|2 x|>1$; the constant may differ between those intervals.\"] [\"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/difficulty :question.difficulty/hard] [\"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/answer-fields \"95c1d718-179c-5ae2-9903-11398143c9ae\"] [17592186064250 :knowledge-point/questions \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\"] [\"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/id #uuid \"52f20127-7026-51bd-b9eb-d3aaffbd7897\"] [\"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/type :answer.type/math] [\"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{6}+C\"] [\"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/id #uuid \"f8e644d1-662e-52e7-b469-8b247975de27\"] [\"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/type :answer.type/math] [\"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [\"a926cb91-61f3-563f-8349-379a686c3646\" :answer/id #uuid \"a926cb91-61f3-563f-8349-379a686c3646\"] [\"a926cb91-61f3-563f-8349-379a686c3646\" :answer/type :answer.type/math] [\"a926cb91-61f3-563f-8349-379a686c3646\" :answer/value \"30 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [\"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/id #uuid \"c3d34534-5046-50b0-a039-b5b4e49d9381\"] [\"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/type :answer.type/math] [\"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{36}+C\"] [\"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/id #uuid \"bab46891-026f-5774-bdfe-32c494dd6b77\"] [\"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/type :answer.type/math] [\"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(36 x \\\\right)}+C\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/id #uuid \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/key \"selection\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/type :answer-field.type/radio] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"52f20127-7026-51bd-b9eb-d3aaffbd7897\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"f8e644d1-662e-52e7-b469-8b247975de27\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"a926cb91-61f3-563f-8349-379a686c3646\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"c3d34534-5046-50b0-a039-b5b4e49d9381\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/choices \"bab46891-026f-5774-bdfe-32c494dd6b77\"] [\"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/correct \"f8e644d1-662e-52e7-b469-8b247975de27\"] [\"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/id #uuid \"3feb255f-aeba-5dbb-91d6-6231c18cb161\"] [\"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{36 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/worked-solution \"Use the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|6 x|=6|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{6}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{|x|\\\\sqrt{36 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 30\\\\int \\\\frac{1}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 30(\\\\frac{1}{6})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals.\"] [\"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/difficulty :question.difficulty/hard] [\"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/answer-fields \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\"] [17592186064250 :knowledge-point/questions \"3feb255f-aeba-5dbb-91d6-6231c18cb161\"] [\"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/id #uuid \"4062c6f4-8073-59e2-8572-082fb67e86cd\"] [\"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/type :answer.type/math] [\"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/id #uuid \"f03be629-e361-57e1-aa79-d89c4c2e71ea\"] [\"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/type :answer.type/math] [\"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [\"95e14540-a907-57a9-af56-5c13e9653546\" :answer/id #uuid \"95e14540-a907-57a9-af56-5c13e9653546\"] [\"95e14540-a907-57a9-af56-5c13e9653546\" :answer/type :answer.type/math] [\"95e14540-a907-57a9-af56-5c13e9653546\" :answer/value \"9 \\\\sqrt{3} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [\"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/id #uuid \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\"] [\"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/type :answer.type/math] [\"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/value \"3 \\\\sqrt{3} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [\"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/id #uuid \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\"] [\"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/type :answer.type/math] [\"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/id #uuid \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/key \"selection\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/type :answer-field.type/radio] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"4062c6f4-8073-59e2-8572-082fb67e86cd\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"f03be629-e361-57e1-aa79-d89c4c2e71ea\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"95e14540-a907-57a9-af56-5c13e9653546\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/choices \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\"] [\"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/correct \"f03be629-e361-57e1-aa79-d89c4c2e71ea\"] [\"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/id #uuid \"9109a0e2-f715-5496-8bcd-2bf0c487318b\"] [\"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|x|\\\\sqrt{3 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{3} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{3},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{3}}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{3} x|=\\\\sqrt{3}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{3}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|x|\\\\sqrt{3 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{3}\\\\int \\\\frac{1}{|\\\\sqrt{3} x|\\\\sqrt{(\\\\sqrt{3} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{3}(\\\\frac{\\\\sqrt{3}}{3})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{3} x|>1$; the constant may differ between those intervals.\"] [\"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/difficulty :question.difficulty/hard] [\"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/answer-fields \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\"] [17592186064250 :knowledge-point/questions \"9109a0e2-f715-5496-8bcd-2bf0c487318b\"] [\"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/id #uuid \"801ef18d-69aa-5378-b58a-91d4d3f3528c\"] [\"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/type :answer.type/math] [\"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{294}+C\"] [\"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/id #uuid \"42e651b5-5ee7-5e53-9e60-c92338128ff0\"] [\"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/type :answer.type/math] [\"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\"] [\"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/id #uuid \"f3049055-8ee7-5042-830b-a03fcd46e4c2\"] [\"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/type :answer.type/math] [\"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(49 x \\\\right)}}{6}+C\"] [\"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/id #uuid \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\"] [\"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/type :answer.type/math] [\"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\"] [\"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/id #uuid \"5c828979-a664-5348-8e96-bb972e22d4d4\"] [\"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/type :answer.type/math] [\"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{42}+C\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/id #uuid \"9c355901-1679-5d66-ba00-1c7d5b2850b1\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/key \"selection\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/type :answer-field.type/radio] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"801ef18d-69aa-5378-b58a-91d4d3f3528c\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"42e651b5-5ee7-5e53-9e60-c92338128ff0\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"f3049055-8ee7-5042-830b-a03fcd46e4c2\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/choices \"5c828979-a664-5348-8e96-bb972e22d4d4\"] [\"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/correct \"42e651b5-5ee7-5e53-9e60-c92338128ff0\"] [\"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/id #uuid \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\"] [\"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{6|x|\\\\sqrt{49 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{6|x|\\\\sqrt{49 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{6}\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{6}(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{6}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{6}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"] [\"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/difficulty :question.difficulty/hard] [\"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/answer-fields \"9c355901-1679-5d66-ba00-1c7d5b2850b1\"] [17592186064250 :knowledge-point/questions \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\"] [\"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/id #uuid \"90251f4c-b8bc-5104-8144-8db40d11f9fe\"] [\"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/type :answer.type/math] [\"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(16 x \\\\right)}+C\"] [\"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/id #uuid \"87ac9755-9f76-571a-b175-02e2902b7b30\"] [\"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/type :answer.type/math] [\"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/value \"28 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/id #uuid \"0126e7ef-2ec7-5d7f-a8d7-582407009616\"] [\"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/type :answer.type/math] [\"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/id #uuid \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\"] [\"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/type :answer.type/math] [\"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{4}+C\"] [\"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/id #uuid \"26615563-e530-5544-b9f7-a24d5d7c3520\"] [\"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/type :answer.type/math] [\"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{16}+C\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/id #uuid \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/key \"selection\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/type :answer-field.type/radio] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"90251f4c-b8bc-5104-8144-8db40d11f9fe\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"87ac9755-9f76-571a-b175-02e2902b7b30\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"0126e7ef-2ec7-5d7f-a8d7-582407009616\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/choices \"26615563-e530-5544-b9f7-a24d5d7c3520\"] [\"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/correct \"0126e7ef-2ec7-5d7f-a8d7-582407009616\"] [\"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/id #uuid \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\"] [\"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{7}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{7}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 28\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 28(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 7\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 7 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"] [\"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/difficulty :question.difficulty/hard] [\"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/answer-fields \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\"] [17592186064250 :knowledge-point/questions \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\"] [\"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/id #uuid \"e645444e-55cd-5743-bd4c-ad58f4b945a5\"] [\"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/type :answer.type/math] [\"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [\"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/id #uuid \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\"] [\"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/type :answer.type/math] [\"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/value \"9 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [\"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/id #uuid \"040ea9c9-e715-507d-902d-bb71351804ed\"] [\"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/type :answer.type/math] [\"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\"] [\"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/id #uuid \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\"] [\"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/type :answer.type/math] [\"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [\"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/id #uuid \"335a8d6a-b4ec-5193-a45f-51bf7646df64\"] [\"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/type :answer.type/math] [\"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/value \"\\\\frac{9 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/id #uuid \"e8606212-bc9b-52ae-8e0c-294774fd2b98\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/key \"selection\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/type :answer-field.type/radio] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"e645444e-55cd-5743-bd4c-ad58f4b945a5\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"040ea9c9-e715-507d-902d-bb71351804ed\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/choices \"335a8d6a-b4ec-5193-a45f-51bf7646df64\"] [\"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/correct \"040ea9c9-e715-507d-902d-bb71351804ed\"] [\"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/id #uuid \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\"] [\"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{7} x|=\\\\sqrt{7}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{7}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{7}\\\\int \\\\frac{1}{|\\\\sqrt{7} x|\\\\sqrt{(\\\\sqrt{7} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{7}(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{7} x|>1$; the constant may differ between those intervals.\"] [\"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/difficulty :question.difficulty/hard] [\"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/answer-fields \"e8606212-bc9b-52ae-8e0c-294774fd2b98\"] [17592186064250 :knowledge-point/questions \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\"] [\"generator\" :question-generator/id #uuid \"7ff11018-92f2-5ce1-bd0a-135534338d0e\"] [\"generator\" :question-generator/script \"generators/8a/8a0c90144a6646880afd310214594dfeb8ddcf955e4d1aa7a69b728cc305a94f/generator.py\"] [17592186064250 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064250 :knowledge-point/question-generator 17592186485645]]}",
