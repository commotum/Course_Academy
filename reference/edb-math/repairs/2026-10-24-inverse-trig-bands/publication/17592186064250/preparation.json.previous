  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/id #uuid \"ab2399d7-22bf-5740-880c-727575b60c80\"] [:db/add \"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/type :answer.type/math] [:db/add \"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\"] [:db/ensure \"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/validate] [:db/add \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/id #uuid \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\"] [:db/add \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/type :answer.type/math] [:db/add \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(196 x \\\\right)}+C\"] [:db/ensure \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/validate] [:db/add \"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/id #uuid \"74cae605-ea8d-5ca5-8033-c10411a836ab\"] [:db/add \"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/type :answer.type/math] [:db/add \"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}}{196}+C\"] [:db/ensure \"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/validate] [:db/add \"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/id #uuid \"eed14417-4f9a-5aae-9ec6-27bba65a8975\"] [:db/add \"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/type :answer.type/math] [:db/add \"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/value \"14 \\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\"] [:db/ensure \"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/validate] [:db/add \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/id #uuid \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\"] [:db/add \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/type :answer.type/math] [:db/add \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}}{14}+C\"] [:db/ensure \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/validate] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/id #uuid \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/key \"selection\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/type :answer-field.type/radio] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"ab2399d7-22bf-5740-880c-727575b60c80\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"74cae605-ea8d-5ca5-8033-c10411a836ab\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"eed14417-4f9a-5aae-9ec6-27bba65a8975\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/choices \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\"] [:db/add \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/correct \"ab2399d7-22bf-5740-880c-727575b60c80\"] [:db/ensure \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/validate] [:db/add \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/id #uuid \"2c86da1f-3334-519e-bd8d-02dc5abc2552\"] [:db/add \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{14}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/worked-solution \"Use the linear substitution $u=14 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=14,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{14})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|14 x|=14|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{14}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{14}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 14\\\\int \\\\frac{1}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 14(\\\\frac{1}{14})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|14 x|>1$; the constant may differ between those intervals.\"] [:db/add \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/difficulty :question.difficulty/easy] [:db/add \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/answer-fields \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\"] [:db/ensure \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"2c86da1f-3334-519e-bd8d-02dc5abc2552\"] [:db/add \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/id #uuid \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\"] [:db/add \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/type :answer.type/math] [:db/add \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/validate] [:db/add \"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/id #uuid \"d02f031d-3d68-5f84-adca-189e93f397fa\"] [:db/add \"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/type :answer.type/math] [:db/add \"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [:db/ensure \"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/validate] [:db/add \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/id #uuid \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\"] [:db/add \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/type :answer.type/math] [:db/add \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{16}+C\"] [:db/ensure \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/validate] [:db/add \"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/id #uuid \"006b058a-8757-53b5-9e86-166b3bad3f57\"] [:db/add \"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/type :answer.type/math] [:db/add \"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{4}+C\"] [:db/ensure \"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/validate] [:db/add \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/id #uuid \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\"] [:db/add \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/type :answer.type/math] [:db/add \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(16 x \\\\right)}+C\"] [:db/ensure \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/validate] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/id #uuid \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/key \"selection\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/type :answer-field.type/radio] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"d02f031d-3d68-5f84-adca-189e93f397fa\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"006b058a-8757-53b5-9e86-166b3bad3f57\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/choices \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\"] [:db/add \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/correct \"d02f031d-3d68-5f84-adca-189e93f397fa\"] [:db/ensure \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/validate] [:db/add \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/id #uuid \"76457b92-955f-57c1-a7b4-2de23b67fcb9\"] [:db/add \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"] [:db/add \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/difficulty :question.difficulty/easy] [:db/add \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/answer-fields \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\"] [:db/ensure \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"76457b92-955f-57c1-a7b4-2de23b67fcb9\"] [:db/add \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/id #uuid \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\"] [:db/add \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/type :answer.type/math] [:db/add \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/value \"11 \\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\"] [:db/ensure \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/validate] [:db/add \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/id #uuid \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\"] [:db/add \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/type :answer.type/math] [:db/add \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}}{11}+C\"] [:db/ensure \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/validate] [:db/add \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/id #uuid \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\"] [:db/add \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/type :answer.type/math] [:db/add \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\"] [:db/ensure \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/validate] [:db/add \"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/id #uuid \"0e0be1ee-1432-52ae-9e94-69b713d648c2\"] [:db/add \"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/type :answer.type/math] [:db/add \"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(121 x \\\\right)}+C\"] [:db/ensure \"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/validate] [:db/add \"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/id #uuid \"59b25816-1279-51cb-af04-13bca7bd5f42\"] [:db/add \"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/type :answer.type/math] [:db/add \"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}}{121}+C\"] [:db/ensure \"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/validate] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/id #uuid \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/key \"selection\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/type :answer-field.type/radio] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"0e0be1ee-1432-52ae-9e94-69b713d648c2\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/choices \"59b25816-1279-51cb-af04-13bca7bd5f42\"] [:db/add \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/correct \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\"] [:db/ensure \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/validate] [:db/add \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/id #uuid \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\"] [:db/add \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{11}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/worked-solution \"Use the linear substitution $u=11 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=11,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{11})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|11 x|=11|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{11}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{11}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 11\\\\int \\\\frac{1}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 11(\\\\frac{1}{11})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|11 x|>1$; the constant may differ between those intervals.\"] [:db/add \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/difficulty :question.difficulty/easy] [:db/add \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/answer-fields \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\"] [:db/ensure \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\"] [:db/add \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/id #uuid \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\"] [:db/add \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/type :answer.type/math] [:db/add \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/value \"10 \\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\"] [:db/ensure \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/validate] [:db/add \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/id #uuid \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\"] [:db/add \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/type :answer.type/math] [:db/add \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}}{10}+C\"] [:db/ensure \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/validate] [:db/add \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/id #uuid \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\"] [:db/add \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/type :answer.type/math] [:db/add \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}}{100}+C\"] [:db/ensure \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/validate] [:db/add \"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/id #uuid \"ac14cc1a-0019-5315-94d9-d5219638bc74\"] [:db/add \"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/type :answer.type/math] [:db/add \"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\"] [:db/ensure \"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/validate] [:db/add \"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/id #uuid \"361c11c2-2fa8-565f-b175-a7e910e759d9\"] [:db/add \"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/type :answer.type/math] [:db/add \"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(100 x \\\\right)}+C\"] [:db/ensure \"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/validate] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/id #uuid \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/key \"selection\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/type :answer-field.type/radio] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"ac14cc1a-0019-5315-94d9-d5219638bc74\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/choices \"361c11c2-2fa8-565f-b175-a7e910e759d9\"] [:db/add \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/correct \"ac14cc1a-0019-5315-94d9-d5219638bc74\"] [:db/ensure \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/validate] [:db/add \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/id #uuid \"97af9687-66c6-579d-97d7-01feb5f40f72\"] [:db/add \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{10}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/worked-solution \"Use the linear substitution $u=10 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{10})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|10 x|=10|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{10}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{10}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 10\\\\int \\\\frac{1}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 10(\\\\frac{1}{10})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|10 x|>1$; the constant may differ between those intervals.\"] [:db/add \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/difficulty :question.difficulty/easy] [:db/add \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/answer-fields \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\"] [:db/ensure \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"97af9687-66c6-579d-97d7-01feb5f40f72\"] [:db/add \"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/id #uuid \"7616d1f3-8012-52d1-b910-e3117af611f5\"] [:db/add \"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/type :answer.type/math] [:db/add \"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\"] [:db/ensure \"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/validate] [:db/add \"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/id #uuid \"f781316b-ad0d-5599-b0d1-a715216cc7e8\"] [:db/add \"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/type :answer.type/math] [:db/add \"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{81}+C\"] [:db/ensure \"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/validate] [:db/add \"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/id #uuid \"093e8ee9-6706-5ac0-9856-c97b4df6f556\"] [:db/add \"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/type :answer.type/math] [:db/add \"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [:db/ensure \"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/validate] [:db/add \"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/id #uuid \"520052f9-511f-5463-abd6-61c01b26c6c9\"] [:db/add \"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/type :answer.type/math] [:db/add \"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(81 x \\\\right)}+C\"] [:db/ensure \"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/validate] [:db/add \"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/id #uuid \"2d562848-1d97-52e5-9683-cb014d13bdb0\"] [:db/add \"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/type :answer.type/math] [:db/add \"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [:db/ensure \"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/validate] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/id #uuid \"60467e61-e7b2-548a-a8c4-112122fa9c9b\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/key \"selection\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/type :answer-field.type/radio] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"7616d1f3-8012-52d1-b910-e3117af611f5\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"f781316b-ad0d-5599-b0d1-a715216cc7e8\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"093e8ee9-6706-5ac0-9856-c97b4df6f556\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"520052f9-511f-5463-abd6-61c01b26c6c9\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/choices \"2d562848-1d97-52e5-9683-cb014d13bdb0\"] [:db/add \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/correct \"2d562848-1d97-52e5-9683-cb014d13bdb0\"] [:db/ensure \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/validate] [:db/add \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/id #uuid \"1330265e-12c1-57f0-82dd-95378d9f20b0\"] [:db/add \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/worked-solution \"Use the linear substitution $u=9 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{9})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|9 x|=9|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{9}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{9})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals.\"] [:db/add \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/difficulty :question.difficulty/easy] [:db/add \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/answer-fields \"60467e61-e7b2-548a-a8c4-112122fa9c9b\"] [:db/ensure \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"1330265e-12c1-57f0-82dd-95378d9f20b0\"] [:db/add \"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/id #uuid \"0420b9b3-9028-5e27-bbba-45726475b49d\"] [:db/add \"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/type :answer.type/math] [:db/add \"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [:db/ensure \"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/validate] [:db/add \"84724433-c0c0-532e-a461-3914e4459162\" :answer/id #uuid \"84724433-c0c0-532e-a461-3914e4459162\"] [:db/add \"84724433-c0c0-532e-a461-3914e4459162\" :answer/type :answer.type/math] [:db/add \"84724433-c0c0-532e-a461-3914e4459162\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{36}+C\"] [:db/ensure \"84724433-c0c0-532e-a461-3914e4459162\" :answer/validate] [:db/add \"b10591d8-d226-5f76-8227-953214d235b0\" :answer/id #uuid \"b10591d8-d226-5f76-8227-953214d235b0\"] [:db/add \"b10591d8-d226-5f76-8227-953214d235b0\" :answer/type :answer.type/math] [:db/add \"b10591d8-d226-5f76-8227-953214d235b0\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(36 x \\\\right)}+C\"] [:db/ensure \"b10591d8-d226-5f76-8227-953214d235b0\" :answer/validate] [:db/add \"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/id #uuid \"5c8f252f-19a7-51d6-bf28-81657f02c35f\"] [:db/add \"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/type :answer.type/math] [:db/add \"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/value \"6 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [:db/ensure \"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/validate] [:db/add \"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/id #uuid \"5dce131d-6dd3-5b85-9b63-176d037ffa33\"] [:db/add \"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/type :answer.type/math] [:db/add \"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{6}+C\"] [:db/ensure \"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/validate] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/id #uuid \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/key \"selection\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/type :answer-field.type/radio] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"0420b9b3-9028-5e27-bbba-45726475b49d\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"84724433-c0c0-532e-a461-3914e4459162\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"b10591d8-d226-5f76-8227-953214d235b0\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"5c8f252f-19a7-51d6-bf28-81657f02c35f\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/choices \"5dce131d-6dd3-5b85-9b63-176d037ffa33\"] [:db/add \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/correct \"0420b9b3-9028-5e27-bbba-45726475b49d\"] [:db/ensure \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/validate] [:db/add \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/id #uuid \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\"] [:db/add \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{6}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/worked-solution \"Use the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|6 x|=6|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{6}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{6}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 6\\\\int \\\\frac{1}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 6(\\\\frac{1}{6})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals.\"] [:db/add \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/difficulty :question.difficulty/easy] [:db/add \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/answer-fields \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\"] [:db/ensure \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\"] [:db/add \"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/id #uuid \"4834c340-bc67-5aa0-8c75-aeeabb21803e\"] [:db/add \"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/type :answer.type/math] [:db/add \"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}}{15}+C\"] [:db/ensure \"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/validate] [:db/add \"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/id #uuid \"1073775f-1bbc-52ab-8c7e-572379bc0994\"] [:db/add \"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/type :answer.type/math] [:db/add \"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\"] [:db/ensure \"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/validate] [:db/add \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/id #uuid \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\"] [:db/add \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/type :answer.type/math] [:db/add \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/value \"15 \\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\"] [:db/ensure \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/validate] [:db/add \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/id #uuid \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\"] [:db/add \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/type :answer.type/math] [:db/add \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(225 x \\\\right)}+C\"] [:db/ensure \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/validate] [:db/add \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/id #uuid \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\"] [:db/add \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/type :answer.type/math] [:db/add \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}}{225}+C\"] [:db/ensure \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/validate] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/id #uuid \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/key \"selection\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/type :answer-field.type/radio] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"4834c340-bc67-5aa0-8c75-aeeabb21803e\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"1073775f-1bbc-52ab-8c7e-572379bc0994\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/choices \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\"] [:db/add \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/correct \"1073775f-1bbc-52ab-8c7e-572379bc0994\"] [:db/ensure \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/validate] [:db/add \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/id #uuid \"feb12510-c969-520b-8bb7-8c2c49a14e5f\"] [:db/add \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{15}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/worked-solution \"Use the linear substitution $u=15 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{15})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|15 x|=15|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{15}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{15}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 15\\\\int \\\\frac{1}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 15(\\\\frac{1}{15})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|15 x|>1$; the constant may differ between those intervals.\"] [:db/add \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/difficulty :question.difficulty/easy] [:db/add \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/answer-fields \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\"] [:db/ensure \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"feb12510-c969-520b-8bb7-8c2c49a14e5f\"] [:db/add \"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/id #uuid \"e6780705-5037-5ae0-94fe-1022c619a279\"] [:db/add \"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/type :answer.type/math] [:db/add \"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}}{13}+C\"] [:db/ensure \"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/validate] [:db/add \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/id #uuid \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\"] [:db/add \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/type :answer.type/math] [:db/add \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}}{169}+C\"] [:db/ensure \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/validate] [:db/add \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/id #uuid \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\"] [:db/add \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/type :answer.type/math] [:db/add \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\"] [:db/ensure \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/validate] [:db/add \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/id #uuid \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\"] [:db/add \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/type :answer.type/math] [:db/add \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/value \"13 \\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\"] [:db/ensure \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/validate] [:db/add \"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/id #uuid \"50b95fae-4e0c-584b-8066-dbac126da0ec\"] [:db/add \"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/type :answer.type/math] [:db/add \"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(169 x \\\\right)}+C\"] [:db/ensure \"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/validate] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/id #uuid \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/key \"selection\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/type :answer-field.type/radio] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"e6780705-5037-5ae0-94fe-1022c619a279\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/choices \"50b95fae-4e0c-584b-8066-dbac126da0ec\"] [:db/add \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/correct \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\"] [:db/ensure \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/validate] [:db/add \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/id #uuid \"8bc2e902-71e9-5912-9706-6f6dd6006240\"] [:db/add \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{13}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/worked-solution \"Use the linear substitution $u=13 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=13,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{13})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|13 x|=13|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{13}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{13}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 13\\\\int \\\\frac{1}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 13(\\\\frac{1}{13})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|13 x|>1$; the constant may differ between those intervals.\"] [:db/add \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/difficulty :question.difficulty/easy] [:db/add \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/answer-fields \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\"] [:db/ensure \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"8bc2e902-71e9-5912-9706-6f6dd6006240\"] [:db/add \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/id #uuid \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\"] [:db/add \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/type :answer.type/math] [:db/add \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\"] [:db/ensure \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/validate] [:db/add \"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/id #uuid \"ba323a7e-319b-5495-ba14-d1d7a671d138\"] [:db/add \"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/type :answer.type/math] [:db/add \"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{9}+C\"] [:db/ensure \"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/validate] [:db/add \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/id #uuid \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\"] [:db/add \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/type :answer.type/math] [:db/add \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(9 x \\\\right)}}{9}+C\"] [:db/ensure \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/validate] [:db/add \"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/id #uuid \"5926164f-fed6-5e3a-ba40-860db0a5ab38\"] [:db/add \"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/type :answer.type/math] [:db/add \"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{81}+C\"] [:db/ensure \"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/validate] [:db/add \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/id #uuid \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\"] [:db/add \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/type :answer.type/math] [:db/add \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\"] [:db/ensure \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/validate] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/id #uuid \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/key \"selection\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/type :answer-field.type/radio] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"ba323a7e-319b-5495-ba14-d1d7a671d138\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"5926164f-fed6-5e3a-ba40-860db0a5ab38\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/choices \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\"] [:db/add \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/correct \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\"] [:db/ensure \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/validate] [:db/add \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/id #uuid \"2ed62d92-c36a-50a5-9c81-caff226f716e\"] [:db/add \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/worked-solution \"Use the linear substitution $u=9 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{9})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|9 x|=9|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{9}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{9})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{9}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{9}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals.\"] [:db/add \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/difficulty :question.difficulty/moderate] [:db/add \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/answer-fields \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\"] [:db/ensure \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"2ed62d92-c36a-50a5-9c81-caff226f716e\"] [:db/add \"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/id #uuid \"228bf48b-6c00-5de6-bd83-cd4703885c3b\"] [:db/add \"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/type :answer.type/math] [:db/add \"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/validate] [:db/add \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/id #uuid \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\"] [:db/add \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/type :answer.type/math] [:db/add \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [:db/ensure \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/validate] [:db/add \"f3779970-0bfa-5296-b548-2b234032333d\" :answer/id #uuid \"f3779970-0bfa-5296-b548-2b234032333d\"] [:db/add \"f3779970-0bfa-5296-b548-2b234032333d\" :answer/type :answer.type/math] [:db/add \"f3779970-0bfa-5296-b548-2b234032333d\" :answer/value \"4 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"f3779970-0bfa-5296-b548-2b234032333d\" :answer/validate] [:db/add \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/id #uuid \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\"] [:db/add \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/type :answer.type/math] [:db/add \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/validate] [:db/add \"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/id #uuid \"0f28e42b-8620-5ae1-8f04-805f88867c6c\"] [:db/add \"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/type :answer.type/math] [:db/add \"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/validate] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/id #uuid \"77b14ff6-ee23-5c1a-82b3-746ee344c414\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/key \"selection\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/type :answer-field.type/radio] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"228bf48b-6c00-5de6-bd83-cd4703885c3b\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"f3779970-0bfa-5296-b548-2b234032333d\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/choices \"0f28e42b-8620-5ae1-8f04-805f88867c6c\"] [:db/add \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/correct \"228bf48b-6c00-5de6-bd83-cd4703885c3b\"] [:db/ensure \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/validate] [:db/add \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/id #uuid \"8ec467ed-a842-5743-90ea-dc3e43a5c825\"] [:db/add \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|2 x|=2|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{2}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{2})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|2 x|>1$; the constant may differ between those intervals.\"] [:db/add \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/difficulty :question.difficulty/moderate] [:db/add \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/answer-fields \"77b14ff6-ee23-5c1a-82b3-746ee344c414\"] [:db/ensure \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"8ec467ed-a842-5743-90ea-dc3e43a5c825\"] [:db/add \"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/id #uuid \"1d199601-926c-5873-9d3f-90aebc32fddf\"] [:db/add \"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/type :answer.type/math] [:db/add \"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\"] [:db/ensure \"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/validate] [:db/add \"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/id #uuid \"fc8cda26-f6db-5986-9ef8-10b89f69beda\"] [:db/add \"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/type :answer.type/math] [:db/add \"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\"] [:db/ensure \"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/validate] [:db/add \"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/id #uuid \"15e65e07-085b-550a-a717-82d2d0a4449f\"] [:db/add \"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/type :answer.type/math] [:db/add \"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{64}+C\"] [:db/ensure \"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/validate] [:db/add \"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/id #uuid \"b71fa791-be0c-5a48-a50c-ab3294c89e93\"] [:db/add \"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/type :answer.type/math] [:db/add \"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}+C\"] [:db/ensure \"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/validate] [:db/add \"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/id #uuid \"e2e87151-dca4-5f40-a571-21cca555c271\"] [:db/add \"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/type :answer.type/math] [:db/add \"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{8}+C\"] [:db/ensure \"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/validate] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/id #uuid \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/key \"selection\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/type :answer-field.type/radio] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"1d199601-926c-5873-9d3f-90aebc32fddf\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"fc8cda26-f6db-5986-9ef8-10b89f69beda\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"15e65e07-085b-550a-a717-82d2d0a4449f\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"b71fa791-be0c-5a48-a50c-ab3294c89e93\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/choices \"e2e87151-dca4-5f40-a571-21cca555c271\"] [:db/add \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/correct \"1d199601-926c-5873-9d3f-90aebc32fddf\"] [:db/ensure \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/validate] [:db/add \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/id #uuid \"445c17c5-47bb-5095-a41c-cf964b636e04\"] [:db/add \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|8 x|=8|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{8}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{8})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9}{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals.\"] [:db/add \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/difficulty :question.difficulty/moderate] [:db/add \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/answer-fields \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\"] [:db/ensure \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"445c17c5-47bb-5095-a41c-cf964b636e04\"] [:db/add \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/id #uuid \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\"] [:db/add \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/type :answer.type/math] [:db/add \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}+C\"] [:db/ensure \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/validate] [:db/add \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/id #uuid \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\"] [:db/add \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/type :answer.type/math] [:db/add \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\"] [:db/ensure \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/validate] [:db/add \"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/id #uuid \"6e42acbb-4f56-56be-a048-fba84c7dc573\"] [:db/add \"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/type :answer.type/math] [:db/add \"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\"] [:db/ensure \"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/validate] [:db/add \"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/id #uuid \"20bf9841-2595-5f27-b0e8-1e9284708c28\"] [:db/add \"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/type :answer.type/math] [:db/add \"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{8}+C\"] [:db/ensure \"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/validate] [:db/add \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/id #uuid \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\"] [:db/add \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/type :answer.type/math] [:db/add \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{64}+C\"] [:db/ensure \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/validate] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/id #uuid \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/key \"selection\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/type :answer-field.type/radio] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"6e42acbb-4f56-56be-a048-fba84c7dc573\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"20bf9841-2595-5f27-b0e8-1e9284708c28\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/choices \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\"] [:db/add \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/correct \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\"] [:db/ensure \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/validate] [:db/add \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/id #uuid \"184d3205-f072-5ec2-ae47-f41ae45b3346\"] [:db/add \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|8 x|=8|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{8}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{8})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals.\"] [:db/add \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/difficulty :question.difficulty/moderate] [:db/add \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/answer-fields \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\"] [:db/ensure \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"184d3205-f072-5ec2-ae47-f41ae45b3346\"] [:db/add \"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/id #uuid \"c566ac9c-ddcc-5843-b570-313dfc0d0833\"] [:db/add \"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/type :answer.type/math] [:db/add \"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/value \"\\\\frac{4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}}{5}+C\"] [:db/ensure \"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/validate] [:db/add \"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/id #uuid \"ba9ea4eb-0793-5e14-bb35-81349da6a845\"] [:db/add \"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/type :answer.type/math] [:db/add \"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\"] [:db/ensure \"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/validate] [:db/add \"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/id #uuid \"e626e4b2-798b-511a-9112-b64176edcf02\"] [:db/add \"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/type :answer.type/math] [:db/add \"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [:db/ensure \"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/validate] [:db/add \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/id #uuid \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\"] [:db/add \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/type :answer.type/math] [:db/add \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/value \"20 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\"] [:db/ensure \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/validate] [:db/add \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/id #uuid \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\"] [:db/add \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/type :answer.type/math] [:db/add \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/value \"4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}+C\"] [:db/ensure \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/validate] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/id #uuid \"d6e53eea-4a9c-579c-9473-40e52033ceba\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/key \"selection\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/type :answer-field.type/radio] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"c566ac9c-ddcc-5843-b570-313dfc0d0833\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"ba9ea4eb-0793-5e14-bb35-81349da6a845\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"e626e4b2-798b-511a-9112-b64176edcf02\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/choices \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\"] [:db/add \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/correct \"ba9ea4eb-0793-5e14-bb35-81349da6a845\"] [:db/ensure \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/validate] [:db/add \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/id #uuid \"c2cb4fba-879b-5b01-9945-6bb60bed682b\"] [:db/add \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{20}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/worked-solution \"Use the linear substitution $u=5 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|5 x|=5|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{5}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{20}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 20\\\\int \\\\frac{1}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 20(\\\\frac{1}{5})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|5 x|>1$; the constant may differ between those intervals.\"] [:db/add \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/difficulty :question.difficulty/moderate] [:db/add \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/answer-fields \"d6e53eea-4a9c-579c-9473-40e52033ceba\"] [:db/ensure \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"c2cb4fba-879b-5b01-9945-6bb60bed682b\"] [:db/add \"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/id #uuid \"2cfb56c8-c193-500d-8069-1875caf5cdec\"] [:db/add \"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/type :answer.type/math] [:db/add \"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [:db/ensure \"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/validate] [:db/add \"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/id #uuid \"26f6ae5e-13b1-5d98-ad21-85c5db855690\"] [:db/add \"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/type :answer.type/math] [:db/add \"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\"] [:db/ensure \"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/validate] [:db/add \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/id #uuid \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\"] [:db/add \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/type :answer.type/math] [:db/add \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{49}+C\"] [:db/ensure \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/validate] [:db/add \"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/id #uuid \"a2305993-b75e-568a-b17f-56fd24469b05\"] [:db/add \"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/type :answer.type/math] [:db/add \"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{7}+C\"] [:db/ensure \"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/validate] [:db/add \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/id #uuid \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\"] [:db/add \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/type :answer.type/math] [:db/add \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{7}+C\"] [:db/ensure \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/validate] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/id #uuid \"71ec24ab-1b85-5c39-bff9-ac067e868069\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/key \"selection\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/type :answer-field.type/radio] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"2cfb56c8-c193-500d-8069-1875caf5cdec\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"26f6ae5e-13b1-5d98-ad21-85c5db855690\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"a2305993-b75e-568a-b17f-56fd24469b05\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/choices \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\"] [:db/add \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/correct \"26f6ae5e-13b1-5d98-ad21-85c5db855690\"] [:db/ensure \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/validate] [:db/add \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/id #uuid \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\"] [:db/add \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8}{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"] [:db/add \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/difficulty :question.difficulty/moderate] [:db/add \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/answer-fields \"71ec24ab-1b85-5c39-bff9-ac067e868069\"] [:db/ensure \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\"] [:db/add \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/id #uuid \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\"] [:db/add \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/type :answer.type/math] [:db/add \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{7}+C\"] [:db/ensure \"bd7d4e3d-f10d-50a1-949e-70eb132876dd\" :answer/validate] [:db/add \"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/id #uuid \"5104680c-2ea7-5a28-9524-a65df4157530\"] [:db/add \"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/type :answer.type/math] [:db/add \"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\"] [:db/ensure \"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/validate] [:db/add \"99e9b877-5e59-5bba-9fdf-edd1082bc890\" :answer/id #uuid \"99e9b877-5e59-5bba-9fdf-edd1082bc890\"] [:db/add \"99e9b877-5