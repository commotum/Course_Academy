ed16-5813-b9ee-ed8cc6b8c2ff" :answer-field/choices "8d780d79-735a-5941-8c9f-4801469c84c9"] [:db/add "90be1365-ed16-5813-b9ee-ed8cc6b8c2ff" :answer-field/choices "123e3224-f470-5a1e-9a86-1c2e4cc2a51e"] [:db/add "90be1365-ed16-5813-b9ee-ed8cc6b8c2ff" :answer-field/correct "ddae6bea-2729-582d-a153-7fc9cd6edc01"] [:db/ensure "90be1365-ed16-5813-b9ee-ed8cc6b8c2ff" :answer-field/validate] [:db/add "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/id #uuid "e4cdc649-5543-52c4-9e7e-a603083141ff"] [:db/add "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{-3}^{3} \\frac{2}{\\sqrt{36 - x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{36 - x^{2}}=\\sqrt{36(1-(\\frac{1}{36})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{6},\\qquad \\mathrm{d}x=(6)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=-3&\\Longrightarrow u=(\\frac{1}{6})(-3)=- \\frac{1}{2} \\\\ x=3&\\Longrightarrow u=(\\frac{1}{6})(3)=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{-3}^{3} \\frac{2}{\\sqrt{36 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}\\int_{-3}^{3} \\frac{1}{\\sqrt{1-(\\frac{x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}(6)\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{1}{2}} \\\\  &= 2(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= 2((\\frac{\\pi}{6})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{2 \\pi}{3}\\end{aligned}\n$$"] [:db/add "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/difficulty :question.difficulty/moderate] [:db/add "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/answer-fields "90be1365-ed16-5813-b9ee-ed8cc6b8c2ff"] [:db/ensure "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "e4cdc649-5543-52c4-9e7e-a603083141ff"] [:db/add "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec" :answer/id #uuid "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec"] [:db/add "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec" :answer/type :answer.type/math] [:db/add "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec" :answer/value "\\frac{\\sqrt{10} \\pi}{5}"] [:db/ensure "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec" :answer/validate] [:db/add "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/id #uuid "5a9796b7-f543-5dc8-b952-8b55e73eb6a2"] [:db/add "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/key "answer"] [:db/add "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/type :answer-field.type/blank] [:db/add "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/choices "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec"] [:db/add "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/correct "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec"] [:db/ensure "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/validate] [:db/add "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/id #uuid "21a4ebc8-c316-5cfd-93e4-ca1118604531"] [:db/add "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\sqrt{10}} \\frac{8}{x^{2} + 10}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 10=10(1+(\\frac{1}{10})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{10}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{10},\\qquad \\mathrm{d}x=(\\sqrt{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(0)=0 \\\\ x=\\sqrt{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(\\sqrt{10})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\sqrt{10}} \\frac{8}{x^{2} + 10}\\,\\mathrm{d}x \\\\  &= \\frac{4}{5}\\int_{0}^{\\sqrt{10}} \\frac{1}{1+(\\frac{\\sqrt{10} x}{10})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{4}{5}(\\sqrt{10})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{4 \\sqrt{10}}{5}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{4 \\sqrt{10}}{5}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\sqrt{10} \\pi}{5}\\end{aligned}\n$$"] [:db/add "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/difficulty :question.difficulty/moderate] [:db/add "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/answer-fields "5a9796b7-f543-5dc8-b952-8b55e73eb6a2"] [:db/ensure "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "21a4ebc8-c316-5cfd-93e4-ca1118604531"] [:db/add "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/id #uuid "cf36209d-dd8d-57a1-a765-f750e1391b98"] [:db/add "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/type :answer.type/math] [:db/add "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/value "\\pi"] [:db/ensure "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/validate] [:db/add "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/id #uuid "b352b4d8-ef8e-542f-94af-6fac013fa473"] [:db/add "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/key "answer"] [:db/add "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/type :answer-field.type/blank] [:db/add "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/choices "cf36209d-dd8d-57a1-a765-f750e1391b98"] [:db/add "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/correct "cf36209d-dd8d-57a1-a765-f750e1391b98"] [:db/ensure "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/validate] [:db/add "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/id #uuid "561f8902-181d-50e5-8116-48d2cb1ddaae"] [:db/add "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\sqrt{5}} \\frac{4}{\\sqrt{10 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{10 - x^{2}}=\\sqrt{10(1-(\\frac{1}{10})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{10}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{10},\\qquad \\mathrm{d}x=(\\sqrt{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(0)=0 \\\\ x=\\sqrt{5}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(\\sqrt{5})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\sqrt{5}} \\frac{4}{\\sqrt{10 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2 \\sqrt{10}}{5}\\int_{0}^{\\sqrt{5}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{10})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2 \\sqrt{10}}{5}(\\sqrt{10})\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 4\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 4[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{2}}{2}} \\\\  &= 4(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 4((\\frac{\\pi}{4})-(0)) \\\\  &= \\pi\\end{aligned}\n$$"] [:db/add "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/difficulty :question.difficulty/moderate] [:db/add "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/answer-fields "b352b4d8-ef8e-542f-94af-6fac013fa473"] [:db/ensure "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "561f8902-181d-50e5-8116-48d2cb1ddaae"] [:db/add "1de17d22-ce4a-560a-97da-52aa819f6d27" :answer/id #uuid "1de17d22-ce4a-560a-97da-52aa819f6d27"] [:db/add "1de17d22-ce4a-560a-97da-52aa819f6d27" :answer/type :answer.type/math] [:db/add "1de17d22-ce4a-560a-97da-52aa819f6d27" :answer/value "\\frac{\\pi}{8}"] [:db/ensure "1de17d22-ce4a-560a-97da-52aa819f6d27" :answer/validate] [:db/add "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/id #uuid "8b06cdcb-17e2-5614-8223-3a8a95be3cd8"] [:db/add "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/key "answer"] [:db/add "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/type :answer-field.type/blank] [:db/add "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/choices "1de17d22-ce4a-560a-97da-52aa819f6d27"] [:db/add "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/correct "1de17d22-ce4a-560a-97da-52aa819f6d27"] [:db/ensure "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/validate] [:db/add "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/id #uuid "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100"] [:db/add "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{8 \\sqrt{3}}{3}} \\frac{6}{x^{2} + 64}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 64=64(1+(\\frac{1}{64})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{8},\\qquad \\mathrm{d}x=(8)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{8})(0)=0 \\\\ x=\\frac{8 \\sqrt{3}}{3}&\\Longrightarrow u=(\\frac{1}{8})(\\frac{8 \\sqrt{3}}{3})=\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{8 \\sqrt{3}}{3}} \\frac{6}{x^{2} + 64}\\,\\mathrm{d}x \\\\  &= \\frac{3}{32}\\int_{0}^{\\frac{8 \\sqrt{3}}{3}} \\frac{1}{1+(\\frac{x}{8})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{32}(8)\\int_{0}^{\\frac{\\sqrt{3}}{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{4}\\int_{0}^{\\frac{\\sqrt{3}}{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{4}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{3}}{3}} \\\\  &= \\frac{3}{4}(\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})-\\operatorname{arctan}(0)) \\\\  &= \\frac{3}{4}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{8}\\end{aligned}\n$$"] [:db/add "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/difficulty :question.difficulty/moderate] [:db/add "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/answer-fields "8b06cdcb-17e2-5614-8223-3a8a95be3cd8"] [:db/ensure "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100"] [:db/add "dd1c91ab-c520-5c89-9666-8520331af451" :answer/id #uuid "dd1c91ab-c520-5c89-9666-8520331af451"] [:db/add "dd1c91ab-c520-5c89-9666-8520331af451" :answer/type :answer.type/math] [:db/add "dd1c91ab-c520-5c89-9666-8520331af451" :answer/value "\\frac{7 \\pi}{3}"] [:db/ensure "dd1c91ab-c520-5c89-9666-8520331af451" :answer/validate] [:db/add "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/id #uuid "c9da6c61-240b-51b8-87c9-710e48d7bbfa"] [:db/add "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/key "answer"] [:db/add "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/type :answer-field.type/blank] [:db/add "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/choices "dd1c91ab-c520-5c89-9666-8520331af451"] [:db/add "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/correct "dd1c91ab-c520-5c89-9666-8520331af451"] [:db/ensure "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/validate] [:db/add "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/id #uuid "a3b89a57-caff-5fb6-834c-90a2ee3c5896"] [:db/add "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{7}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=\\sqrt{9(1-(\\frac{1}{9})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{3},\\qquad \\mathrm{d}x=(3)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{3})(0)=0 \\\\ x=\\frac{3 \\sqrt{3}}{2}&\\Longrightarrow u=(\\frac{1}{3})(\\frac{3 \\sqrt{3}}{2})=\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{7}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{3}\\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{3})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{3}(3)\\int_{0}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 7\\int_{0}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 7[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{3}}{2}} \\\\  &= 7(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 7((\\frac{\\pi}{3})-(0)) \\\\  &= \\frac{7 \\pi}{3}\\end{aligned}\n$$"] [:db/add "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/difficulty :question.difficulty/moderate] [:db/add "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/answer-fields "c9da6c61-240b-51b8-87c9-710e48d7bbfa"] [:db/ensure "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "a3b89a57-caff-5fb6-834c-90a2ee3c5896"] [:db/add "5d602eba-c683-5422-ab3f-d225478a529e" :answer/id #uuid "5d602eba-c683-5422-ab3f-d225478a529e"] [:db/add "5d602eba-c683-5422-ab3f-d225478a529e" :answer/type :answer.type/math] [:db/add "5d602eba-c683-5422-ab3f-d225478a529e" :answer/value "2 \\pi"] [:db/ensure "5d602eba-c683-5422-ab3f-d225478a529e" :answer/validate] [:db/add "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/id #uuid "56821200-ef2e-57da-b433-e28f4b7b7183"] [:db/add "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/key "answer"] [:db/add "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/type :answer-field.type/blank] [:db/add "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/choices "5d602eba-c683-5422-ab3f-d225478a529e"] [:db/add "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/correct "5d602eba-c683-5422-ab3f-d225478a529e"] [:db/ensure "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/validate] [:db/add "b68941c7-a358-52a8-9847-bc887dddfa00" :question/id #uuid "b68941c7-a358-52a8-9847-bc887dddfa00"] [:db/add "b68941c7-a358-52a8-9847-bc887dddfa00" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{7}{2}}^{\\frac{7}{2}} \\frac{6}{\\sqrt{49 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "b68941c7-a358-52a8-9847-bc887dddfa00" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{49 - x^{2}}=\\sqrt{49(1-(\\frac{1}{49})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{7}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{7},\\qquad \\mathrm{d}x=(7)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{7}{2}&\\Longrightarrow u=(\\frac{1}{7})(- \\frac{7}{2})=- \\frac{1}{2} \\\\ x=\\frac{7}{2}&\\Longrightarrow u=(\\frac{1}{7})(\\frac{7}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{7}{2}}^{\\frac{7}{2}} \\frac{6}{\\sqrt{49 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{6}{7}\\int_{- \\frac{7}{2}}^{\\frac{7}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{7})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{6}{7}(7)\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 6\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 6[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{1}{2}} \\\\  &= 6(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= 6((\\frac{\\pi}{6})-(- \\frac{\\pi}{6})) \\\\  &= 2 \\pi\\end{aligned}\n$$"] [:db/add "b68941c7-a358-52a8-9847-bc887dddfa00" :question/difficulty :question.difficulty/moderate] [:db/add "b68941c7-a358-52a8-9847-bc887dddfa00" :question/answer-fields "56821200-ef2e-57da-b433-e28f4b7b7183"] [:db/ensure "b68941c7-a358-52a8-9847-bc887dddfa00" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "b68941c7-a358-52a8-9847-bc887dddfa00"] [: