8f897da0-c7c7-5ad7-bec0-4f2425e87fbe"] [:db/ensure "76e776ca-23c1-5993-b4b0-77109e7c5373" :answer-field/validate] [:db/add "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/id #uuid "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf"] [:db/add "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{9}{7 x^{2} + 25}\\,\\mathrm{d}x\n$$"] [:db/add "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n7 x^{2} + 25=25(1+(\\frac{7}{25})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{7} x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{7}}{5},\\qquad \\mathrm{d}x=(\\frac{5 \\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{5 \\sqrt{21}}{21}&\\Longrightarrow u=(\\frac{\\sqrt{7}}{5})(\\frac{5 \\sqrt{21}}{21})=\\frac{\\sqrt{3}}{3} \\\\ x=\\frac{5 \\sqrt{7}}{7}&\\Longrightarrow u=(\\frac{\\sqrt{7}}{5})(\\frac{5 \\sqrt{7}}{7})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{9}{7 x^{2} + 25}\\,\\mathrm{d}x \\\\  &= \\frac{9}{25}\\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{1}{1+(\\frac{\\sqrt{7} x}{5})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{9}{25}(\\frac{5 \\sqrt{7}}{7})\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}[\\operatorname{arctan}{\\left(u \\right)}]_{\\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{9 \\sqrt{7}}{35}(\\operatorname{arctan}(1)-\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{9 \\sqrt{7}}{35}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{7} \\pi}{140}\\end{aligned}\n$$"] [:db/add "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/difficulty :question.difficulty/hard] [:db/add "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/answer-fields "76e776ca-23c1-5993-b4b0-77109e7c5373"] [:db/ensure "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf"] [:db/add "8fe824ad-db88-5a89-a4f6-708549ce42b2" :answer/id #uuid "8fe824ad-db88-5a89-a4f6-708549ce42b2"] [:db/add "8fe824ad-db88-5a89-a4f6-708549ce42b2" :answer/type :answer.type/math] [:db/add "8fe824ad-db88-5a89-a4f6-708549ce42b2" :answer/value "\\frac{5 \\sqrt{6} \\pi}{72}"] [:db/ensure "8fe824ad-db88-5a89-a4f6-708549ce42b2" :answer/validate] [:db/add "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d" :answer/id #uuid "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d"] [:db/add "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d" :answer/type :answer.type/math] [:db/add "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d" :answer/value "\\frac{5 \\sqrt{6} \\pi}{144}"] [:db/ensure "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d" :answer/validate] [:db/add "b2bb5d3e-7051-5abd-89a8-2b656aebf919" :answer/id #uuid "b2bb5d3e-7051-5abd-89a8-2b656aebf919"] [:db/add "b2bb5d3e-7051-5abd-89a8-2b656aebf919" :answer/type :answer.type/math] [:db/add "b2bb5d3e-7051-5abd-89a8-2b656aebf919" :answer/value "\\frac{5 \\pi}{36}"] [:db/ensure "b2bb5d3e-7051-5abd-89a8-2b656aebf919" :answer/validate] [:db/add "c87fae49-0f53-5df6-911f-e8c7a1db7141" :answer/id #uuid "c87fae49-0f53-5df6-911f-e8c7a1db7141"] [:db/add "c87fae49-0f53-5df6-911f-e8c7a1db7141" :answer/type :answer.type/math] [:db/add "c87fae49-0f53-5df6-911f-e8c7a1db7141" :answer/value "\\frac{5 \\sqrt{6} \\pi}{48}"] [:db/ensure "c87fae49-0f53-5df6-911f-e8c7a1db7141" :answer/validate] [:db/add "f4ca0d1e-aed4-5152-9954-1989b7c30009" :answer/id #uuid "f4ca0d1e-aed4-5152-9954-1989b7c30009"] [:db/add "f4ca0d1e-aed4-5152-9954-1989b7c30009" :answer/type :answer.type/math] [:db/add "f4ca0d1e-aed4-5152-9954-1989b7c30009" :answer/value "- \\frac{5 \\sqrt{6} \\pi}{72}"] [:db/ensure "f4ca0d1e-aed4-5152-9954-1989b7c30009" :answer/validate] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/id #uuid "943865ee-77d8-59f0-8739-263d0db8cbb9"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/key "selection"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/type :answer-field.type/radio] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/choices "8fe824ad-db88-5a89-a4f6-708549ce42b2"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/choices "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/choices "b2bb5d3e-7051-5abd-89a8-2b656aebf919"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/choices "c87fae49-0f53-5df6-911f-e8c7a1db7141"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/choices "f4ca0d1e-aed4-5152-9954-1989b7c30009"] [:db/add "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/correct "8fe824ad-db88-5a89-a4f6-708549ce42b2"] [:db/ensure "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/validate] [:db/add "275ef93a-9e15-50cd-b072-9c822daf3676" :question/id #uuid "275ef93a-9e15-50cd-b072-9c822daf3676"] [:db/add "275ef93a-9e15-50cd-b072-9c822daf3676" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{2}{6 x^{2} + 4}\\,\\mathrm{d}x\n$$"] [:db/add "275ef93a-9e15-50cd-b072-9c822daf3676" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n6 x^{2} + 4=4(1+(\\frac{3}{2})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{2},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{6}}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\sqrt{2}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{2})(- \\frac{\\sqrt{2}}{3})=- \\frac{\\sqrt{3}}{3} \\\\ x=\\frac{\\sqrt{6}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{2})(\\frac{\\sqrt{6}}{3})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{2}{6 x^{2} + 4}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{1}{1+(\\frac{\\sqrt{6} x}{2})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{\\sqrt{6}}{3})\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}[\\operatorname{arctan}{\\left(u \\right)}]_{- \\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{\\sqrt{6}}{6}(\\operatorname{arctan}(1)-\\operatorname{arctan}(- \\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{\\sqrt{6}}{6}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{5 \\sqrt{6} \\pi}{72}\\end{aligned}\n$$"] [:db/add "275ef93a-9e15-50cd-b072-9c822daf3676" :question/difficulty :question.difficulty/hard] [:db/add "275ef93a-9e15-50cd-b072-9c822daf3676" :question/answer-fields "943865ee-77d8-59f0-8739-263d0db8cbb9"] [:db/ensure "275ef93a-9e15-50cd-b072-9c822daf3676" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "275ef93a-9e15-50cd-b072-9c822daf3676"] [:db/add "b534102c-0a28-5ffc-8498-8c551bd0cc23" :answer/id #uuid "b534102c-0a28-5ffc-8498-8c551bd0cc23"] [:db/add "b534102c-0a28-5ffc-8498-8c551bd0cc23" :answer/type :answer.type/math] [:db/add "b534102c-0a28-5ffc-8498-8c551bd0cc23" :answer/value "\\frac{5 \\sqrt{6} \\pi}{72}"] [:db/ensure "b534102c-0a28-5ffc-8498-8c551bd0cc23" :answer/validate] [:db/add "78ee06fb-d3bd-5699-be5d-99abba240a16" :answer/id #uuid "78ee06fb-d3bd-5699-be5d-99abba240a16"] [:db/add "78ee06fb-d3bd-5699-be5d-99abba240a16" :answer/type :answer.type/math] [:db/add "78ee06fb-d3bd-5699-be5d-99abba240a16" :answer/value "- \\frac{5 \\sqrt{6} \\pi}{72}"] [:db/ensure "78ee06fb-d3bd-5699-be5d-99abba240a16" :answer/validate] [:db/add "584e96b6-767c-5e14-899f-41a99d429ed3" :answer/id #uuid "584e96b6-767c-5e14-899f-41a99d429ed3"] [:db/add "584e96b6-767c-5e14-899f-41a99d429ed3" :answer/type :answer.type/math] [:db/add "584e96b6-767c-5e14-899f-41a99d429ed3" :answer/value "\\frac{25 \\sqrt{6} \\pi}{72}"] [:db/ensure "584e96b6-767c-5e14-899f-41a99d429ed3" :answer/validate] [:db/add "ca8e45df-9845-509b-a95f-6c7724735b22" :answer/id #uuid "ca8e45df-9845-509b-a95f-6c7724735b22"] [:db/add "ca8e45df-9845-509b-a95f-6c7724735b22" :answer/type :answer.type/math] [:db/add "ca8e45df-9845-509b-a95f-6c7724735b22" :answer/value "\\frac{5 \\pi}{12}"] [:db/ensure "ca8e45df-9845-509b-a95f-6c7724735b22" :answer/validate] [:db/add "cd0beb08-add5-50bf-82af-696f8e97dadb" :answer/id #uuid "cd0beb08-add5-50bf-82af-696f8e97dadb"] [:db/add "cd0beb08-add5-50bf-82af-696f8e97dadb" :answer/type :answer.type/math] [:db/add "cd0beb08-add5-50bf-82af-696f8e97dadb" :answer/value "\\frac{5 \\pi}{72}"] [:db/ensure "cd0beb08-add5-50bf-82af-696f8e97dadb" :answer/validate] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/id #uuid "c2f94dbd-24b0-502c-8bef-8dd471a94ea1"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/key "selection"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/type :answer-field.type/radio] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/choices "b534102c-0a28-5ffc-8498-8c551bd0cc23"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/choices "78ee06fb-d3bd-5699-be5d-99abba240a16"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/choices "584e96b6-767c-5e14-899f-41a99d429ed3"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/choices "ca8e45df-9845-509b-a95f-6c7724735b22"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/choices "cd0beb08-add5-50bf-82af-696f8e97dadb"] [:db/add "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/correct "b534102c-0a28-5ffc-8498-8c551bd0cc23"] [:db/ensure "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/validate] [:db/add "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/id #uuid "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539"] [:db/add "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\sqrt{6}}{2}}^{\\sqrt{3}} \\frac{5}{\\sqrt{36 - 6 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{36 - 6 x^{2}}=\\sqrt{36(1-(\\frac{1}{6})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{6},\\qquad \\mathrm{d}x=(\\sqrt{6})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt{6}}{2}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{6})(\\frac{\\sqrt{6}}{2})=\\frac{1}{2} \\\\ x=\\sqrt{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{6})(\\sqrt{3})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{\\sqrt{6}}{2}}^{\\sqrt{3}} \\frac{5}{\\sqrt{36 - 6 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{5}{6}\\int_{\\frac{\\sqrt{6}}{2}}^{\\sqrt{3}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{6} x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{5}{6}(\\sqrt{6})\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{5 \\sqrt{6}}{6}\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{5 \\sqrt{6}}{6}[\\operatorname{arcsin}{\\left(u \\right)}]_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{5 \\sqrt{6}}{6}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(\\frac{1}{2})) \\\\  &= \\frac{5 \\sqrt{6}}{6}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{5 \\sqrt{6} \\pi}{72}\\end{aligned}\n$$"] [:db/add "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/difficulty :question.difficulty/hard] [:db/add "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/answer-fields "c2f94dbd-24b0-502c-8bef-8dd471a94ea1"] [:db/ensure "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539"] [:db/add "094fa516-728f-5be6-a4fe-f67ece9b8145" :answer/id #uuid "094fa516-728f-5be6-a4fe-f67ece9b8145"] [:db/add "094fa516-728f-5be6-a4fe-f67ece9b8145" :answer/type :answer.type/math] [:db/add "094fa516-728f-5be6-a4fe-f67ece9b8145" :answer/value "\\frac{3 \\sqrt{6} \\pi}{4}"] [:db/ensure "094fa516-728f-5be6-a4fe-f67ece9b8145" :answer/validate] [:db/add "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/id #uuid "ee3d0bc0-f989-584a-ae0f-e17e36f20d73"] [:db/add "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/key "answer"] [:db/add "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/type :answer-field.type/blank] [:db/add "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/choices "094fa516-728f-5be6-a4fe-f67ece9b8145"] [:db/add "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/correct "094fa516-728f-5be6-a4fe-f67ece9b8145"] [:db/ensure "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/validate] [:db/add "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/id #uuid "d97ef683-6715-5e81-a7d1-14b2ffc5e533"] [:db/add "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\sqrt{6}}{4}}^{\\frac{3 \\sqrt{2}}{4}} \\frac{9}{\\sqrt{9 - 6 x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{9 - 6 x^{2}}=\\sqrt{9(1-(\\frac{2}{3})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{3},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{6}}{2})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\sqrt{6}}{4}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{3})(- \\frac{\\sqrt{6}}{4})=- \\frac{1}{2} \\\\ x=\\frac{3 \\sqrt{2}}{4}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{3})(\\frac{3 \\sqrt{2}}{4})=\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{\\sqrt{6}}{4}}^{\\frac{3 \\sqrt{2}}{4}} \\frac{9}{\\sqrt{9 - 6 x^{2}}}\\,\\mathrm{d}x \\\\  &= 3\\int_{- \\frac{\\sqrt{6}}{4}}^{\\frac{3 \\sqrt{2}}{4}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{6} x}{3})^{2}}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{\\sqrt{6}}{2})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{6}}{2}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{6}}{2}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\\\  &= \\frac{3 \\sqrt{6}}{2}(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{3 \\sqrt{6}}{2}((\\frac{\\pi}{3})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{6} \\pi}{4}\\end{aligned}\n$$"] [:db/add "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/difficulty :question.difficulty/hard] [:db/add "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/answer-fields "ee3d0bc0-f989-584a-ae0f-e17e36f20d73"] [:db/ensure "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "d97ef683-6715-5e81-a7d1-14b2ffc5e533"] [:db/add "0a19f002-f394-581c-8a71-944f99d29f1c" :answer/id #uuid "0a19f002-f394-581c-8a71-944f99d29f1c"] [:db/add "0a19f002-f394-581c-8a71-944f99d29f1c" :answer/type :answer.type/math] [:db/add "0a19f002-f394-581c-8a71-944f99d29f1c" :answer/value "\\frac{\\sqrt{10} \\pi}{360}"] [:db/ensure "0a19f002-f394-581c-8a71-944f99d29f1c" :answer/validate] [:db/add "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/id #uuid "b9486294-79c8-509d-84d4-b54229d994a1"] [:db/add "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/key "answer"] [:db/add "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/type :answer-field.type/blank] [:db/add "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/choices "0a19f002-f394-581c-8a71-944f99d29f1c"] [:db/add "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/correct "0a19f002-f394-581c-8a71-944f99d29f1c"] [:db/ensure "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/validate] [:db/add "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/id #uuid "0372c2fd-66f2-541c-882f-7c71be7cc96e"] [:db/add "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{3 \\sqrt{10}}{10}}^{\\frac{3 \\sqrt{30}}{10}} \\frac{1}{10 x^{2} + 9}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n10 x^{2} + 9=9(1+(\\frac{10}{9})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{3},\\qquad \\mathrm{d}x=(\\frac{3 \\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{3 \\sqrt{10}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{3})(\\frac{3 \\sqrt{10}}{10})=1 \\\\ x=\\frac{3 \\sqrt{30}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{3})(\\frac{3 \\sqrt{30}}{10})=\\sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{3 \\sqrt{10}}{10}}^{\\frac{3 \\sqrt{30}}{10}} \\frac{1}{10 x^{2} + 9}\\,\\mathrm{d}x \\\\  &= \\frac{1}{9}\\int_{\\frac{3 \\sqrt{10}}{10}}^{\\frac{3 \\sqrt{30}}{10}} \\frac{1}{1+(\\frac{\\sqrt{10} x}{3})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{9}(\\frac{3 \\sqrt{10}}{10})\\int_{1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{10}}{30}\\int_{1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{10}}{30}[\\operatorname{arctan}{\\left(u \\right)}]_{1}^{\\sqrt{3}} \\\\  &= \\frac{\\sqrt{10}}{30}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(1)) \\\\  &= \\frac{\\sqrt{10}}{30}((\\frac{\\pi}{3})-(\\frac{\\pi}{4})) \\\\  &= \\frac{\\sqrt{10} \\pi}{360}\\end{aligned}\n$$"] [:db/add "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/difficulty :question.difficulty/hard] [:db/add "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/answer-fields "b9486294-79c8-509d-84d4-b54229d994a1"] [:db/ensure "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "0372c2fd-66f2-541c-882f-7c71be7cc96e"] [:db/add "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/id #uuid "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1"] [:db/add "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/type :answer.type/math] [:db/add "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/value "\\frac{7 \\sqrt{3} \\pi}{54}"] [:db/ensure "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/validate] [:db/add "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/id #uuid "d1b888f5-5707-53a5-b970-7313bcf41529"] [:db/add "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/key "answer"] [:db/add "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/type :answer-field.type/blank] [:db/add "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/choices "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1"] [:db/add "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/correct "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1"] [:db/ensure "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/validate] [:db/add "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/id #uuid "5880c807-c10d-50e8-9d88-c434c7630fa9"] [:db/add "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- 3 \\sqrt{3}}^{9} \\frac{6}{3 x^{2} + 81}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n3 x^{2} + 81=81(1+(\\frac{1}{27})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{3} x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{3}}{9},\\qquad \\mathrm{d}x=(3 \\sqrt{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- 3 \\sqrt{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{9})(- 3 \\sqrt{3})=-1 \\\\ x=9&\\Longrightarrow u=(\\frac{\\sqrt{3}}{9})(9)=\\sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- 3 \\sqrt{3}}^{9} \\frac{6}{3 x^{2} + 81}\\,\\mathrm{d}x \\\\  &= \\frac{2}{27}\\int_{- 3 \\sqrt{3}}^{9} \\frac{1}{1+(\\frac{\\sqrt{3} x}{9})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{2}{27}(3 \\sqrt{3})\\int_{-1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{3}}{9}\\int_{-1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{3}}{9}[\\operatorname{arctan}{\\left(u \\right)}]_{-1}^{\\sqrt{3}} \\\\  &= \\frac{2 \\sqrt{3}}{9}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(-1)) \\\\  &= \\frac{2 \\sqrt{3}}{9}((\\frac{\\pi}{3})-(- \\frac{\\pi}{4})) \\\\  &= \\frac{7 \\sqrt{3} \\pi}{54}\\end{aligned}\n$$"] [:db/add "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/difficulty :question.difficulty/hard] [:db/add "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/answer-fields "d1b888f5-5707-53a5-b970-7313bcf41529"] [:db/ensure "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "5880c807-c10d-50e8-9d88-c434c7630fa9"] [:db/add "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081" :answer/id #uuid "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081"] [:db/add "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081" :answer/type :answer.type/math] [:db/add "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081" :answer/value "\\frac{\\sqrt{6} \\pi}{36}"] [:db/ensure "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081" :answer/validate] [:db/add "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/id #uuid "0970acb4-17e3-5133-8c74-81024d88697a"] [:db/add "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/key "answer"] [:db/add "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/type :answer-field.type/blank] [:db/add "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/choices "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081"] [:db/add "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/correct "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081"] [:db/ensure "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/validate] [:db/add "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/id #uuid "26a5ab0e-8ab0-5f06-8396-7feffadcde08"] [:db/add "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\sqrt{6}}{3}}^{\\frac{2 \\sqrt{3}}{3}} \\frac{2}{\\sqrt{16 - 6 x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{16 - 6 x^{2}}=\\sqrt{16(1-(\\frac{3}{8})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{4}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{4},\\qquad \\mathrm{d}x=(\\frac{2 \\sqrt{6}}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt{6}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{4})(\\frac{\\sqrt{6}}{3})=\\frac{1}{2} \\\\ x=\\frac{2 \\sqrt{3}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{4})(\\frac{2 \\sqrt{3}}{3})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{\\sqrt{6}}{3}}^{\\frac{2 \\sqrt{3}}{3}} \\frac{2}{\\sqrt{16 - 6 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int_{\\frac{\\sqrt{6}}{3}}^{\\frac{2 \\sqrt{3}}{3}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{6} x}{4})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{2 \\sqrt{6}}{3})\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}[\\operatorname{arcsin}{\\left(u \\right)}]_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{\\sqrt{6}}{3}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(\\frac{1}{2})) \\\\  &= \\frac{\\sqrt{6}}{3}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{6} \\pi}{36}\\end{aligned}\n$$"] [:db/add "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/difficulty :question.difficulty/hard] [:db/add "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/answer-fields "0970acb4-17e3-5133-8c74-81024d88697a"] [:db/ensure "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "26a5ab0e-8ab0-5f06-8396-7feffadcde08"] [:db/add "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11" :answer/id #uuid "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11"] [:db/add "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11" :answer/type :answer.type/math] [:db/add "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11" :answer/value "3 \\pi"] [:db/ensure "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11" :answer/validate] [:db/add "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f" :answer/id #uuid "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f"] [:db/add "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f" :answer/type :answer.type/math] [:db/add "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f" :answer/value "\\frac{10 \\pi}{27}"] [:db/ensure "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f" :answer/validate] [:db/add "cbf674a6-5283-5813-b916-60b747375328" :answer/id #uuid "cbf674a6-5283-5813-b916-60b747375328"] [:db/add "cbf674a6-5283-5813-b916-60b747375328" :answer/type :answer.type/math] [:db/add "cbf674a6-5283-5813-b916-60b747375328" :answer/value "\\frac{\\sqrt{10} \\pi}{3}"] [:db/ensure "cbf674a6-5283-5813-b916-60b747375328" :answer/validate] [:db/add "27f548bb-c49c-5514-862f-6732a1a79088" :answer/id #uuid "27f548bb-c49c-5514-862f-6732a1a79088"] [:db/add "27f548bb-c49c-5514-862f-6732a1a79088" :answer/type :answer.type/math] [:db/add "27f548bb-c49c-5514-862f-6732a1a79088" :answer/value "\\frac{4 \\sqrt{10} \\left(\\operatorname{arctan}{\\left(\\frac{1}{2} \\right)} + \\operatorname{arctan}{\\left(\\frac{\\sqrt{2}}{2} \\right)}\\right)}{5}"] [:db/ensure "27f548bb-c49c-5514-862f-6732a1a79088" :answer/validate] [:db/add "07b08bd5-31bc-5c5a-ad01-1f39fa210754" :answer/id #uuid "07b08bd5-31bc-5c5a-ad01-1f39fa210754"] [:db/add "07b08bd5-31bc-5c5a-ad01-1f39fa210754" :answer/type :answer.type/math] [:db/add "07b08bd5-31bc-5c5a-ad01-1f39fa210754" :answer/value "- \\frac{\\sqrt{10} \\pi}{3}"] [:db/ensure "07b08bd5-31bc-5c5a-ad01-1f39fa210754" :answer/validate] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/id #uuid "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/key "selection"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/type :answer-field.type/radio] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/choices "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/choices "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/choices "cbf674a6-5283-5813-b916-60b747375328"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/choices "27f548bb-c49c-5514-862f-6732a1a79088"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/choices "07b08bd5-31bc-5c5a-ad01-1f39fa210754"] [:db/add "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/correct "cbf674a6-5283-5813-b916-60b747375328"] [:db/ensure "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/validate] [:db/add "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/id #uuid "4a24f09e-263b-5efe-ac71-a976bc84e3aa"] [:db/add "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{8}{\\sqrt{81 - 10 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{81 - 10 x^{2}}=\\sqrt{81(1-(\\frac{10}{81})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{9},\\qquad \\mathrm{d}x=(\\frac{9 \\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{9 \\sqrt{10}}{20}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{9})(- \\frac{9 \\sqrt{10}}{20})=- \\frac{1}{2} \\\\ x=\\frac{9 \\sqrt{5}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{9})(\\frac{9 \\sqrt{5}}{10})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{8}{\\sqrt{81 - 10 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{9}\\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{9})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{9}(\\frac{9 \\sqrt{10}}{10})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{4 \\sqrt{10}}{5}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{4 \\sqrt{10}}{5}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{10} \\pi}{3}\\end{aligned}\n$$"] [:db/add "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/difficulty :question.difficulty/hard] [:db/add "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/answer-fields "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a"] [:db/ensure "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "4a24f09e-263b-5efe-ac71-a976bc84e3aa"] [:db/add "b40c90ad-24fd-5084-80a0-31c0f725200f" :answer/id #uuid "b40c90ad-24fd-5084-80a0-31c0f725200f"] [:db/add "b40c90ad-24fd-5084-80a0-31c0f725200f" :answer/type :answer.type/math] [:db/add "b40c90ad-24fd-5084-80a0-31c0f725200f" :answer/value "\\frac{\\sqrt{3} \\pi}{2048}"] [:db/ensure "b40c90ad-24fd-5084-80a0-31c0f725200f" :answer/validate] [:db/add "b3fa66f7-e082-5e62-acfc-3e26bc6ee6e1" :answer/id #uuid "b3fa66f7-e082-5e62-acfc-3e26bc6ee6e1"] [:db/add "b3fa66f7-e082-5e62-ac