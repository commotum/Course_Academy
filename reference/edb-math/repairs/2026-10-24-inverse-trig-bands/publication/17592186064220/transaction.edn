00112100d" :answer-field/choices "193240cb-9bf1-5fc3-88c4-343eb2b3f61c"] [:db/add "a7792e2b-87fe-5b28-8d18-1c100112100d" :answer-field/correct "3e412948-a45d-5098-9434-a82895c83f16"] [:db/ensure "a7792e2b-87fe-5b28-8d18-1c100112100d" :answer-field/validate] [:db/add "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/id #uuid "b7e7efd8-4daf-5a99-9901-08530da7dbd2"] [:db/add "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{8}{3}}^{\\frac{8 \\sqrt{3}}{3}} \\frac{3}{3 x^{2} + 64}\\,\\mathrm{d}x\n$$"] [:db/add "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n3 x^{2} + 64=64(1+(\\frac{3}{64})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{3} x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{3}}{8},\\qquad \\mathrm{d}x=(\\frac{8 \\sqrt{3}}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{8}{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{8})(\\frac{8}{3})=\\frac{\\sqrt{3}}{3} \\\\ x=\\frac{8 \\sqrt{3}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{8})(\\frac{8 \\sqrt{3}}{3})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{8}{3}}^{\\frac{8 \\sqrt{3}}{3}} \\frac{3}{3 x^{2} + 64}\\,\\mathrm{d}x \\\\  &= \\frac{3}{64}\\int_{\\frac{8}{3}}^{\\frac{8 \\sqrt{3}}{3}} \\frac{1}{1+(\\frac{\\sqrt{3} x}{8})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{64}(\\frac{8 \\sqrt{3}}{3})\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{3}}{8}\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{3}}{8}[\\operatorname{arctan}{\\left(u \\right)}]_{\\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{\\sqrt{3}}{8}(\\operatorname{arctan}(1)-\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{\\sqrt{3}}{8}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{3} \\pi}{96}\\end{aligned}\n$$"] [:db/add "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/difficulty :question.difficulty/hard] [:db/add "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/answer-fields "a7792e2b-87fe-5b28-8d18-1c100112100d"] [:db/ensure "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "b7e7efd8-4daf-5a99-9901-08530da7dbd2"] [:db/add "generator" :question-generator/id #uuid "dfb22793-9205-5ab7-9f7c-cd3818ec6882"] [:db/add "generator" :question-generator/script "generators/dc/dc2c6e81c814b35a099aef56a40e934ddf374d633dd99d5b40e34f758270a5a0/generator.py"] [:db/add 17592186064220 :knowledge-point/question-generator "generator"] [:db/ensure 17592186064220 :knowledge-point/validate]]
