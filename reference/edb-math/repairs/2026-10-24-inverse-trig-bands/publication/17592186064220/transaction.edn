3-5b00-8930-97762031a8dc" :answer-field/choices "168d4392-e6c0-51c7-a965-acadc2514a1c"] [:db/add "7f5c43e5-3673-5b00-8930-97762031a8dc" :answer-field/correct "8b30ca6b-ec84-5558-804b-cffd2d66e216"] [:db/ensure "7f5c43e5-3673-5b00-8930-97762031a8dc" :answer-field/validate] [:db/add "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/id #uuid "e1c5c6fb-e670-586e-8a39-d5d94b3f065f"] [:db/add "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{16}} \\frac{3}{\\sqrt{1 - 64 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(8)(0)=0 \\\\ x=\\frac{1}{16}&\\Longrightarrow u=(8)(\\frac{1}{16})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{16}} \\frac{3}{\\sqrt{1 - 64 x^{2}}}\\,\\mathrm{d}x \\\\  &= 3\\int_{0}^{\\frac{1}{16}} \\frac{1}{\\sqrt{1-(8 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{1}{8})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{8}\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{8}[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{3}{8}(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{3}{8}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{16}\\end{aligned}\n$$"] [:db/add "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/difficulty :question.difficulty/easy] [:db/add "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/answer-fields "7f5c43e5-3673-5b00-8930-97762031a8dc"] [:db/ensure "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "e1c5c6fb-e670-586e-8a39-d5d94b3f065f"] [:db/add "cbd0e262-e697-5db3-b587-5ac8bdb7b7be" :answer/id #uuid "cbd0e262-e697-5db3-b587-5ac8bdb7b7be"] [:db/add "cbd0e262-e697-5db3-b587-5ac8bdb7b7be" :answer/type :answer.type/math] [:db/add "cbd0e262-e697-5db3-b587-5ac8bdb7b7be" :answer/value "\\frac{9 \\pi}{256}"] [:db/ensure "cbd0e262-e697-5db3-b587-5ac8bdb7b7be" :answer/validate] [:db/add "dfafb482-d854-543e-90ed-7b48a0404ff0" :answer/id #uuid "dfafb482-d854-543e-90ed-7b48a0404ff0"] [:db/add "dfafb482-d854-543e-90ed-7b48a0404ff0" :answer/type :answer.type/math] [:db/add "dfafb482-d854-543e-90ed-7b48a0404ff0" :answer/value "18 \\pi"] [:db/ensure "dfafb482-d854-543e-90ed-7b48a0404ff0" :answer/validate] [:db/add "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/id #uuid "caff1140-af84-5fee-a20b-46dfa8dfd943"] [:db/add "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/type :answer.type/math] [:db/add "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/value "\\frac{9 \\pi}{32}"] [:db/ensure "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/validate] [:db/add "bcc765d0-19d2-52d4-8cae-2b1ce27c3960" :answer/id #uuid "bcc765d0-19d2-52d4-8cae-2b1ce27c3960"] [:db/add "bcc765d0-19d2-52d4-8cae-2b1ce27c3960" :answer/type :answer.type/math] [:db/add "bcc765d0-19d2-52d4-8cae-2b1ce27c3960" :answer/value "\\frac{\\pi}{32}"] [:db/ensure "bcc765d0-19d2-52d4-8cae-2b1ce27c3960" :answer/validate] [:db/add "35733d7a-08b3-5eb1-b623-b285be791351" :answer/id #uuid "35733d7a-08b3-5eb1-b623-b285be791351"] [:db/add "35733d7a-08b3-5eb1-b623-b285be791351" :answer/type :answer.type/math] [:db/add "35733d7a-08b3-5eb1-b623-b285be791351" :answer/value "- \\frac{9 \\pi}{32}"] [:db/ensure "35733d7a-08b3-5eb1-b623-b285be791351" :answer/validate] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/id #uuid "234d093f-86d5-5259-9076-fc2ff176a74e"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/key "selection"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/type :answer-field.type/radio] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/choices "cbd0e262-e697-5db3-b587-5ac8bdb7b7be"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/choices "dfafb482-d854-543e-90ed-7b48a0404ff0"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/choices "caff1140-af84-5fee-a20b-46dfa8dfd943"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/choices "bcc765d0-19d2-52d4-8cae-2b1ce27c3960"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/choices "35733d7a-08b3-5eb1-b623-b285be791351"] [:db/add "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/correct "caff1140-af84-5fee-a20b-46dfa8dfd943"] [:db/ensure "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/validate] [:db/add "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/id #uuid "6871a209-fee3-5a51-a701-ff2bbca02c0a"] [:db/add "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{8}} \\frac{9}{64 x^{2} + 1}\\,\\mathrm{d}x\n$$"] [:db/add "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(8)(0)=0 \\\\ x=\\frac{1}{8}&\\Longrightarrow u=(8)(\\frac{1}{8})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{8}} \\frac{9}{64 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 9\\int_{0}^{\\frac{1}{8}} \\frac{1}{1+(8 x)^{2}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{8})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{8}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{8}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{9}{8}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{9}{8}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{9 \\pi}{32}\\end{aligned}\n$$"] [:db/add "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/difficulty :question.difficulty/easy] [:db/add "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/answer-fields "234d093f-86d5-5259-9076-fc2ff176a74e"] [:db/ensure "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "6871a209-fee3-5a51-a701-ff2bbca02c0a"] [:db/add "fc523c34-26f5-5ee8-9c58-6eb37bbddad6" :answer/id #uuid "fc523c34-26f5-5ee8-9c58-6eb37bbddad6"] [:db/add "fc523c34-26f5-5ee8-9c58-6eb37bbddad6" :answer/type :answer.type/math] [:db/add "fc523c34-26f5-5ee8-9c58-6eb37bbddad6" :answer/value "48 \\operatorname{arctan}{\\left(3 \\right)}"] [:db/ensure "fc523c34-26f5-5ee8-9c58-6eb37bbddad6" :answer/validate] [:db/add "356b89e1-d725-57e8-b073-eb5591c2bcc3" :answer/id #uuid "356b89e1-d725-57e8-b073-eb5591c2bcc3"] [:db/add "356b89e1-d725-57e8-b073-eb5591c2bcc3" :answer/type :answer.type/math] [:db/add "356b89e1-d725-57e8-b073-eb5591c2bcc3" :answer/value "8 \\operatorname{arctan}{\\left(3 \\right)}"] [:db/ensure "356b89e1-d725-57e8-b073-eb5591c2bcc3" :answer/validate] [:db/add "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/id #uuid "2984adf6-e7b5-5a90-8825-5cdf2f26581a"] [:db/add "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/type :answer.type/math] [:db/add "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/value "\\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}"] [:db/ensure "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/validate] [:db/add "10b98030-d11f-5f99-938a-5366d17d6d1d" :answer/id #uuid "10b98030-d11f-5f99-938a-5366d17d6d1d"] [:db/add "10b98030-d11f-5f