sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{3 \\sqrt{2}} \\frac{2}{x^{2} + 6}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}\\int_{0}^{3 \\sqrt{2}} \\frac{1}{1+(\\frac{\\sqrt{6} x}{6})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}(\\sqrt{6})\\int_{0}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}\\int_{0}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{\\sqrt{3}} \\\\  &= \\frac{\\sqrt{6}}{3}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(0)) \\\\  &= \\frac{\\sqrt{6}}{3}((\\frac{\\pi}{3})-(0)) \\\\  &= \\frac{\\sqrt{6} \\pi}{9}\\end{aligned}\n$$"] [:db/add "e251937d-16b7-5326-a140-cdc3ea29c25f" :question/difficulty :question.difficulty/moderate] [:db/add "e251937d-16b7-5326-a140-cdc3ea29c25f" :question/answer-fields "0f025f07-d47b-5049-b3e3-da3e27c754f9"] [:db/ensure "e251937d-16b7-5326-a140-cdc3ea29c25f" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "e251937d-16b7-5326-a140-cdc3ea29c25f"] [:db/add "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/id #uuid "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba"] [:db/add "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/type :answer.type/math] [:db/add "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/value "\\frac{\\pi}{3}"] [:db/ensure "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/validate] [:db/add "cc4e4223-fd94-5f6b-a213-4216edf8b5c0" :answer/id #uuid "cc4e4223-fd94-5f6b-a213-4216edf8b5c0"] [:db/add "cc4e4223-fd94-5f6b-a213-4216edf8b5c0" :answer/type :answer.type/math] [:db/add "cc4e4223-fd94-5f6b-a213-4216edf8b5c0" :answer/value "\\frac{2 \\pi}{3}"] [:db/ensure "cc4e4223-fd94-5f6b-a213-4216edf8b5c0" :answer/validate] [:db/add "b6d5e3ae-feb8-5269-8089-cd58f1844709" :answer/id #uuid "b6d5e3ae-feb8-5269-8089-cd58f1844709"] [:db/add "b6d5e3ae-feb8-5269-8089-cd58f1844709" :answer/type :answer.type/math] [:db/add "b6d5e3ae-feb8-5269-8089-cd58f1844709" :answer/value "\\frac{\\sqrt{2} \\pi}{3}"] [:db/ensure "b6d5e3ae-feb8-5269-8089-cd58f1844709" :answer/validate] [:db/add "e2796685-73b6-5e94-ae79-b8111f678b61" :answer/id #uuid "e2796685-73b6-5e94-ae79-b8111f678b61"] [:db/add "e2796685-73b6-5e94-ae79-b8111f678b61" :answer/type :answer.type/math] [:db/add "e2796685-73b6-5e94-ae79-b8111f678b61" :answer/value "- \\frac{\\pi}{3}"] [:db/ensure "e2796685-73b6-5e94-ae79-b8111f678b61" :answer/validate] [:db/add "00551039-d607-5600-acd4-4dc4aef60bd8" :answer/id #uuid "00551039-d607-5600-acd4-4dc4aef60bd8"] [:db/add "00551039-d607-5600-acd4-4dc4aef60bd8" :answer/type :answer.type/math] [:db/add "00551039-d607-5600-acd4-4dc4aef60bd8" :answer/value "\\frac{\\sqrt{2} \\pi}{6}"] [:db/ensure "00551039-d607-5600-acd4-4dc4aef60bd8" :answer/validate] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/id #uuid "fdb23a87-6b16-5bae-8d50-4399319e99f9"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/key "selection"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/type :answer-field.type/radio] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/choices "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/choices "cc4e4223-fd94-5f6b-a213-4216edf8b5c0"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/choices "b6d5e3ae-feb8-5269-8089-cd58f1844709"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/choices "e2796685-73b6-5e94-ae79-b8111f678b61"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/choices "00551039-d607-5600-acd4-4dc4aef60bd8"] [:db/add "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/correct "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba"] [:db/ensure "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/validate] [:db/add "3678de14-c7a3-5309-a87e-827f356a473e" :question/id #uuid "3678de14-c7a3-5309-a87e-827f356a473e"] [:db/add "3678de14-c7a3-5309-a87e-827f356a473e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "3678de14-c7a3-5309-a87e-827f356a473e" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{2 - x^{2}}=\\sqrt{2(1-(\\frac{1}{2})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{2} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{2}}{2},\\qquad \\mathrm{d}x=(\\sqrt{2})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{2}}{2})(0)=0 \\\\ x=\\frac{\\sqrt{2}}{2}&\\Longrightarrow u=(\\frac{\\sqrt{2}}{2})(\\frac{\\sqrt{2}}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\sqrt{2}\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{2} x}{2})^{2}}}\\,\\mathrm{d}x \\\\  &= \\sqrt{2}(\\sqrt{2})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= 2(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= 2((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{3}\\end{aligned}\n$$"] [:db/add "3678de14-c7a3-5309-a87e-827f356a473e" :question/difficulty :question.difficulty/moderate] [:db/add "3678de14-c7a3-5309-a87e-827f356a473e" :question/answer-fields "fdb23a87-6b16-5bae-8d50-4399319e99f9"] [:db/ensure "3678de14-c7a3-5309-a87e-827f356a473e" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "3678de14-c7a3-5309-a87e-827f356a473e"] [:db/add "40638152-c07a-5845-b659-ed194dc93945" :answer/id #uuid "40638152-c07a-5845-b659-ed194dc93945"] [:db/add "40638152-c07a-5845-b659-ed194dc93945" :answer/type :answer.type/math] [:db/add "40638152-c07a-5845-b659-ed194dc93945" :answer/value "\\frac{\\pi}{8}"] [:db/ensure "40638152-c07a-5845-b659-ed194dc93945" :answer/validate] [:db/add "fb5a079d-39a5-5990-8353-75942f5fb50c" :answer/id #uuid "fb5a079d-39a5-5990-8353-75942f5fb50c"] [:db/add "fb5a079d-39a5-5990-8353-75942f5fb50c" :answer/type :answer.type/math] [:db/add "fb5a079d-39a5-5990-8353-75942f5fb50c" :answer/value "\\frac{3 \\pi}{4}"] [:db/ensure "fb5a079d-39a5-5990-8353-75942f5fb50c" :answer/validate] [:db/add "3879e69e-611a-5e48-af0d-b81d5085eba7" :answer/id #uuid "3879e69e-611a-5e48-af0d-b81d5085eba7"] [:db/add "3879e69e-611a-5e48-af0d-b81d5085eba7" :answer/type :answer.type/math] [:db/add "3879e69e-611a-5e48-af0d-b81d5085eba7" :answer/value "\\frac{\\pi}{288}"] [:db/ensure "3879e69e-611a-5e48-af0d-b81d5085eba7" :answer/validate] [:db/add "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4" :answer/id #uuid "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4"] [:db/add "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4" :answer/type :answer.type/math] [:db/add "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4" :answer/value "\\frac{\\pi}{24}"] [:db/ensure "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4" :answer/validate] [:db/add "48f997ef-3952-5d82-987d-59ddad9a4ab0" :answer/id #uuid "48f997ef-3952-5d82-987d-59ddad9a4ab0"] [:db/add "48f997ef-3952-5d82-987d-59ddad9a4ab0" :answer/type :answer.type/math] [:db/add "48f997ef-3952-5d82-987d-59ddad9a4ab0" :answer/value "- \\frac{\\pi}{8}"] [:db/ensure "48f997ef-3952-5d82-987d-59ddad9a4ab0" :answer/validate] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/id #uuid "f3205561-4844-5231-9a76-4b12f71b281e"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/key "selection"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/type :answer-field.type/radio] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/choices "40638152-c07a-5845-b659-ed194dc93945"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/choices "fb5a079d-39a5-5990-8353-75942f5fb50c"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/choices "3879e69e-611a-5e48-af0d-b81d5085eba7"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/choices "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/choices "48f997ef-3952-5d82-987d-59ddad9a4ab0"] [:db/add "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/correct "40638152-c07a-5845-b659-ed194dc93945"] [:db/ensure "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/validate] [:db/add "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/id #uuid "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca"] [:db/add "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{6} \\frac{3}{x^{2} + 36}\\,\\mathrm{d}x\n$$"] [:db/add "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 36=36(1+(\\frac{1}{36})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{6},\\qquad \\mathrm{d}x=(6)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{6})(0)=0 \\\\ x=6&\\Longrightarrow u=(\\frac{1}{6})(6)=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{6} \\frac{3}{x^{2} + 36}\\,\\mathrm{d}x \\\\  &= \\frac{1}{12}\\int_{0}^{6} \\frac{1}{1+(\\frac{x}{6})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{12}(6)\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{2}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{2}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{1}{2}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{1}{2}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{8}\\end{aligned}\n$$"] [:db/add "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/difficulty :question.difficulty/moderate] [:db/add "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/answer-fields "f3205561-4844-5231-9a76-4b12f71b281e"] [:db/ensure "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca"] [:db/add "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/id #uuid "a864f77b-e61b-569b-b091-f06fcbea3c77"] [:db/add "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/type :answer.type/math] [:db/add "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/value "\\frac{\\pi}{4}"] [:db/ensure "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/validate] [:db/add "04ac5bda-af2a-567a-972e-4eaed79b2cb5" :answer/id #uuid "04ac5bda-af2a-567a-972e-4eaed79b2cb5"] [:db/add "04ac5bda-af2a-567a-972e-4eaed79b2cb5" :answer/type :answer.type/math] [:db/add "04ac5bda-af2a-567a-972e-4eaed79b2cb5" :answer/value "\\frac{\\pi}{100}"] [:db/ensure "04ac5bda-af2a-567a-972e-4eaed79b2cb5" :answer/validate] [:db/add "daced14b-3627-5e01-8e59-8270db580180" :answer/id #uuid "daced14b-3627-5e01-8e59-8270db580180"] [:db/add "daced14b-3627-5e01-8e59-8270db580180" :answer/type :answer.type/math] [:db/add "daced14b-3627-5e01-8e59-8270db580180" :answer/value "- \\frac{\\pi}{4}"] [:db/ensure "daced14b-3627-5e01-8e59-8270db580180" :answer/validate] [:db/add "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3" :answer/id #uuid "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3"] [:db/add "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3" :answer/type :answer.type/math] [:db/add "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3" :answer/value "\\operatorname{arctan}{\\left(\\frac{\\sqrt{2}}{2} \\right)}"] [:db/ensure "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3" :answer/validate] [:db/add "a63b8559-c82f-598b-a90b-350bd66e1c91" :answer/id #uuid "a63b8559-c82f-598b-a90b-350bd66e1c91"] [:db/add "a63b8559-c82f-598b-a90b-350bd66e1c91" :answer/type :answer.type/math] [:db/add "a63b8559-c82f-598b-a90b-350bd66e1c91" :answer/value "\\frac{\\pi}{20}"] [:db/ensure "a63b8559-c82f-598b-a90b-350bd66e1c91" :answer/validate] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/id #uuid "bd293653-c045-569e-88f6-fbf74712702f"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/key "selection"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/type :answer-field.type/radio] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/choices "a864f77b-e61b-569b-b091-f06fcbea3c77"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/choices "04ac5bda-af2a-567a-972e-4eaed79b2cb5"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/choices "daced14b-3627-5e01-8e59-8270db580180"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/choices "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/choices "a63b8559-c82f-598b-a90b-350bd66e1c91"] [:db/add "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/correct "a864f77b-e61b-569b-b091-f06fcbea3c77"] [:db/ensure "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/validate] [:db/add "682222db-91f6-5331-b0ae-5361f8ce335b" :question/id #uuid "682222db-91f6-5331-b0ae-5361f8ce335b"] [:db/add "682222db-91f6-5331-b0ae-5361f8ce335b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "682222db-91f6-5331-b0ae-5361f8ce335b" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{25 - x^{2}}=\\sqrt{25(1-(\\frac{1}{25})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{5},\\qquad \\mathrm{d}x=(5)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{5})(0)=0 \\\\ x=\\frac{5 \\sqrt{2}}{2}&\\Longrightarrow u=(\\frac{1}{5})(\\frac{5 \\sqrt{2}}{2})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{5}\\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{5})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{5}(5)\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{2}}{2}} \\\\  &= 1(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 1((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{4}\\end{aligned}\n$$"] [:db/add "682222db-91f6-5331-b0ae-5361f8ce335b" :question/difficulty :question.difficulty/moderate] [:db/add "682222db-91f6-5331-b0ae-5361f8ce335b" :question/answer-fields "bd293653-c045-569e-88f6-fbf74712702f"] [:db/ensure "682222db-91f6-5331-b0ae-5361f8ce335b" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "682222db-91f6-5331-b0ae-5361f8ce335b"] [:db/add "ddae6bea-2729-582d-a153-7fc9cd6edc01" :answer/id #uuid "ddae6bea-2729-582d-a153-7fc9cd6edc01"] [:db/add "ddae6bea-2729-582d-a153-7fc9cd6edc01" :answer/type :answer.type/math] [:db/add "ddae6bea-2729-582d-a153-7fc9cd6edc01" :answer/value "\\frac{2 \\pi}{3}"] [:db/ensure "ddae6bea-2729-582d-a153-7