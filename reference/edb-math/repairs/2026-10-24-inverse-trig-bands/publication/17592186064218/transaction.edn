\frac{\\sqrt{2} x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2}{3}(3 \\sqrt{2})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2 \\sqrt{2}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2 \\sqrt{2} \\operatorname{arcsin}{\\left(u \\right)}+C \\\\  &= 2 \\sqrt{2} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{6} \\right)}+C\\end{aligned}\n$$"] [:db/add "a57f0d65-3f7b-5093-8b5d-c66248b0abe5" :question/difficulty :question.difficulty/hard] [:db/add "a57f0d65-3f7b-5093-8b5d-c66248b0abe5" :question/answer-fields "37ff69c9-ad83-5d1e-a355-4ef4c878b6bc"] [:db/ensure "a57f0d65-3f7b-5093-8b5d-c66248b0abe5" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "a57f0d65-3f7b-5093-8b5d-c66248b0abe5"] [:db/add "29ecfb90-4954-5354-9317-133f8d1b8c18" :answer/id #uuid "29ecfb90-4954-5354-9317-133f8d1b8c18"] [:db/add "29ecfb90-4954-5354-9317-133f8d1b8c18" :answer/type :answer.type/math] [:db/add "29ecfb90-4954-5354-9317-133f8d1b8c18" :answer/value "\\frac{3 \\sqrt{2} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{5}+C"] [:db/ensure "29ecfb90-4954-5354-9317-133f8d1b8c18" :answer/validate] [:db/add "34364745-85dd-5191-901a-8585d610c285" :answer/id #uuid "34364745-85dd-5191-901a-8585d610c285"] [:db/add "34364745-85dd-5191-901a-8585d610c285" :answer/type :answer.type/math] [:db/add "34364745-85dd-5191-901a-8585d610c285" :answer/value "\\frac{6 \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{35}+C"] [:db/ensure "34364745-85dd-5191-901a-8585d610c285" :answer/validate] [:db/add "5935e9d1-90a3-5934-943c-196a2cd9ab88" :answer/id #uuid "5935e9d1-90a3-5934-943c-196a2cd9ab88"] [:db/add "5935e9d1-90a3-5934-943c-196a2cd9ab88" :answer/type :answer.type/math] [:db/add "5935e9d1-90a3-5934-943c-196a2cd9ab88" :answer/value "\\frac{3 \\sqrt{2} \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{5}+C"] [:db/ensure "5935e9d1-90a3-5934-943c-196a2cd9ab88" :answer/validate] [:db/add "57b3d13c-f606-5508-88bd-c21237120d7f" :answ