b4b559-27b4-5499-b515-6939cb760420" :question/answer-fields "beb52e1f-9018-57f8-9c4e-4ba4b2465e07"] [:db/ensure "aeb4b559-27b4-5499-b515-6939cb760420" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "aeb4b559-27b4-5499-b515-6939cb760420"] [:db/add "6ce3c644-d7bd-5af0-90aa-621960980866" :answer/id #uuid "6ce3c644-d7bd-5af0-90aa-621960980866"] [:db/add "6ce3c644-d7bd-5af0-90aa-621960980866" :answer/type :answer.type/math] [:db/add "6ce3c644-d7bd-5af0-90aa-621960980866" :answer/value "8 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}+C"] [:db/ensure "6ce3c644-d7bd-5af0-90aa-621960980866" :answer/validate] [:db/add "f1395054-873c-52c8-b347-999eeb014cf8" :answer/id #uuid "f1395054-873c-52c8-b347-999eeb014cf8"] [:db/add "f1395054-873c-52c8-b347-999eeb014cf8" :answer/type :answer.type/math] [:db/add "f1395054-873c-52c8-b347-999eeb014cf8" :answer/value "8 \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}+C"] [:db/ensure "f1395054-873c-52c8-b347-999eeb014cf8" :answer/validate] [:db/add "f638c343-9c97-5913-bd31-5df078a1a1f2" :answer/id #uuid "f638c343-9c97-5913-bd31-5df078a1a1f2"] [:db/add "f638c343-9c97-5913-bd31-5df078a1a1f2" :answer/type :answer.type/math] [:db/add "f638c343-9c97-5913-bd31-5df078a1a1f2" :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{5}+C"] [:db/ensure "f638c343-9c97-5913-bd31-5df078a1a1f2" :answer/validate] [:db/add "7a84aeb3-7c9d-5ea6-b305-0a4fa5dacfc8" :answer/id #uuid "7a84aeb3-7c9d-5ea6-b305-0a4fa5dacfc8"] [:db/add "7a84aeb3-7c9d-5ea6-b305-0a4fa5dacfc8" :answer/type :answer.type/math] [:db/add "7a84aeb3-7c9d-5ea6-b305-0a4fa5dacfc8" :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(x \\right)}}{5}+C"] [:db/ensure "7a84aeb3-7c9d-5ea6-b305-0a4fa5dacfc8" :answer/validate] [:db/add "2b389124-a26d-50e1-aa90-68db0abe6c2e" :answer/id #uuid "2b389124-a26d-50e1-aa90-68db0abe6c2e"] [:db/add "2b389124-a26d-50e1-aa90-68db0abe6c2e" :answer/type :answer.type/math] [:db/