fd980" :answer-field/key "selection"] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/type :answer-field.type/radio] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/choices "acf640ac-2120-5fb5-8cf7-f2e16ceb502a"] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/choices "e1b083a2-8377-5d49-9b34-8079d5287b83"] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/choices "62e8f05f-97cc-5d99-a0be-37e571eec26d"] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/choices "4a7dd127-f3c7-5b5f-b1d1-85ec960d67de"] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/choices "04280869-47cd-51fb-bd56-21c6fc5838e2"] [:db/add "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/correct "62e8f05f-97cc-5d99-a0be-37e571eec26d"] [:db/ensure "d2203131-1971-567e-9dad-1a25974fd980" :answer-field/validate] [:db/add "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd" :question/id #uuid "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd"] [:db/add "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{\\frac{9}{5}}{\\sqrt{36 - 7 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{36 - 7 x^{2}}=\\sqrt{36(1-(\\frac{7}{36})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{7} x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{7}}{6},\\qquad \\mathrm{d}x=(\\frac{6 \\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{\\frac{9}{5}}{\\sqrt{36 - 7 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{10}\\int \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{7} x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{10}(\\frac{6 \\sqrt{7}}{7})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(u \\right)}}{35}+C \\\\  &= \\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{35}+C\\end{aligned}\n$$"] [:db/add "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd" :question/difficulty :question.difficulty/hard] [:db/add "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd" :question/answer-fields "d2203131-1971-567e-9dad-1a25974fd980"] [:db/ensure "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "a7ba47cf-596e-5b89-8f83-7c1f409bdcdd"] [:db/add "fcc4f02a-f8e8-5417-a314-b47a273aa821" :answer/id #uuid "fcc4f02a-f8e8-5417-a314-b47a273aa821"] [:db/add "fcc4f02a-f8e8-5417-a314-b47a273aa821" :answer/type :answer.type/math] [:db/add "fcc4f02a-f8e8-5417-a314-b47a273aa821" :answer/value "\\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{3} \\right)}+C"] [:db/ensure "fcc4f02a-f8e8-5417-a314-b47a273aa821" :answer/validate] [:db/add "6782df1e-4d03-5c54-bb1a-08d21c527b97" :answer/id #uuid "6782df1e-4d03-5c54-bb1a-08d21c527b97"] [:db/add "6782df1e-4d03-5c54-bb1a-08d21c527b97" :answer/type :answer.type/math] [:db/add "6782df1e-4d03-5c54-bb1a-08d21c527b97" :answer/value "\\frac{9 \\sqrt{7} \\operatorname{arctan}{\\left(\\frac{\\sqrt{7} x}{3} \\right)}}{7}+C"] [:db/ensure "6782df1e-4d03-5c54-bb1a-08d21c527b97" :answer/validate] [:db/add "9975dc61-bc56-5617-a016-567a3ee1b51e" :answer/id #uuid "9975dc61-bc56-5617-a016-567a3ee1b51e"] [:db/add "9975dc61-bc56-5617-a016-567a3ee1b51e" :answer/type :answer.type/math] [:db/add "9975dc61-bc56-5617-a016-567a3ee1b51e" :answer/value "3 \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{3} \\right)}+C"] [:db/ensure "9975dc61-bc56-5617-a016-567a3ee1b51e" :answer/validate] [:db/add "a4b55f5c-24ff-5bef-83f9-11bd528fee90" :answer/id #uuid "a4b55f5c-24ff-5bef-83f9-11bd528fee90"] [:db/add "a4b55f5c-24ff-5bef-83f9-11bd528fee90" :answer/type 