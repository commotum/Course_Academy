2d56d9"] [:db/add "e801a538-fddf-55dd-bfcb-170ff82d56d9" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{\\frac{3}{4}}{\\sqrt{81 - x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "e801a538-fddf-55dd-bfcb-170ff82d56d9" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{81 - x^{2}}=\\sqrt{81(1-(\\frac{1}{81})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{9},\\qquad \\mathrm{d}x=(9)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{\\frac{3}{4}}{\\sqrt{81 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{12}\\int \\frac{1}{\\sqrt{1-(\\frac{x}{9})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{12}(9)\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{4}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\operatorname{arcsin}{\\left(u \\right)}}{4}+C \\\\  &= \\frac{3 \\operatorname{arcsin}{\\left(\\frac{x}{9} \\right)}}{4}+C\\end{aligned}\n$$"] [:db/add "e801a538-fddf-55dd-bfcb-170ff82d56d9" :question/difficulty :question.difficulty/moderate] [:db/add "e801a538-fddf-55dd-bfcb-170ff82d56d9" :question/answer-fields "b0a88d44-4f1b-597d-ab5a-a45cbcf2124a"] [:db/ensure "e801a538-fddf-55dd-bfcb-170ff82d56d9" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "e801a538-fddf-55dd-bfcb-170ff82d56d9"] [:db/add "db1d125c-7238-5167-98fc-18d1b5e1fc82" :answer/id #uuid "db1d125c-7238-5167-98fc-18d1b5e1fc82"] [:db/add "db1d125c-7238-5167-98fc-18d1b5e1fc82" :answer/type :answer.type/math] [:db/add "db1d125c-7238-5167-98fc-18d1b5e1fc82" :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{x}{8} \\right)}}{8}+C"] [:db/ensure "db1d125c-7238-5167-98fc-18d1b5e1fc82" :answer/validate] [:db/add "b8655cba-e3ae-57af-9942-b587a54c366f"