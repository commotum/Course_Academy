}\\,\\mathrm{d}x \\\\  &= 8\\int \\frac{1}{\\sqrt{1-(\\sqrt{10} x)^{2}}}\\,\\mathrm{d}x \\\\  &= 8(\\frac{\\sqrt{10}}{10})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(u \\right)}}{5}+C \\\\  &= \\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{5}+C\\end{aligned}\n$$"] [:db/add "44485569-fdd3-513f-8b31-23d9e8828d65" :question/difficulty :question.difficulty/easy] [:db/add "44485569-fdd3-513f-8b31-23d9e8828d65" :question/answer-fields "00843716-9c25-5650-80f8-f7535717f15c"] [:db/ensure "44485569-fdd3-513f-8b31-23d9e8828d65" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "44485569-fdd3-513f-8b31-23d9e8828d65"] [:db/add "ea08fb37-0d0a-5712-8346-ac46ba2af427" :answer/id #uuid "ea08fb37-0d0a-5712-8346-ac46ba2af427"] [:db/add "ea08fb37-0d0a-5712-8346-ac46ba2af427" :answer/type :answer.type/math] [:db/add "ea08fb37-0d0a-5712-8346-ac46ba2af427" :answer/value "\\frac{9 \\operatorname{arcsin}{\\left(x \\right)}}{2}+C"] [:db/ensure "ea08fb37-0d0a-5712-8346-ac46ba2af427" :answer/validate] [:db/add "c8375ac6-3c5b-5845-a3f6-a15c693c3a45" :answer/id #uuid "c8375ac6-3c5b-5845-a3f6-a15c693c3a45"] [:db/add "c8375ac6-3c5b-5845-a3f6-a15c693c3a45" :answer/type :answer.type/math] [:db/add "c8375ac6-3c5b-5845-a3f6-a15c693c3a45" :answer/value "18 \\operatorname{arcsin}{\\left(2 x \\right)}+C"] [:db/ensure "c8375ac6-3c5b-5845-a3f6-a15c693c3a45" :answer/validate] [:db/add "c898bf78-400f-5e7d-ad7a-85cef23b1496" :answer/id #uuid "c898bf78-400f-5e7d-ad7a-85cef23b1496"] [:db/add "c898bf78-400f-5e7d-ad7a-85cef23b1496" :answer/type :answer.type/math] [:db/add "c898bf78-400f-5e7d-ad7a-85cef23b1496" :answer/value "9 \\operatorname{arcsin}{\\left(2 x \\right)}+C"] [:db/ensure "c898bf78-400f-5e7d-ad7a-85cef23b1496" :answer/validate] [:db/add "691332c9-dfd1-51e4-a111-41b0aa45d969" :answer/id #uuid "691332c9-dfd1-51e4