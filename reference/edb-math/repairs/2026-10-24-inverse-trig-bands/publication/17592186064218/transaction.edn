in}{\\left(8 x \\right)}}{64}+C\\end{aligned}\n$$"] [:db/add "596c3e80-0a77-5c0b-9dd5-ac5db525f1a6" :question/difficulty :question.difficulty/easy] [:db/add "596c3e80-0a77-5c0b-9dd5-ac5db525f1a6" :question/answer-fields "48a5b7e2-4c77-5ee6-90b5-acd3e63e113a"] [:db/ensure "596c3e80-0a77-5c0b-9dd5-ac5db525f1a6" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "596c3e80-0a77-5c0b-9dd5-ac5db525f1a6"] [:db/add "fb2a09b8-805b-5475-a6be-01cfe4a50665" :answer/id #uuid "fb2a09b8-805b-5475-a6be-01cfe4a50665"] [:db/add "fb2a09b8-805b-5475-a6be-01cfe4a50665" :answer/type :answer.type/math] [:db/add "fb2a09b8-805b-5475-a6be-01cfe4a50665" :answer/value "\\frac{4 \\sqrt{3} \\operatorname{arcsin}{\\left(\\sqrt{3} x \\right)}}{3}+C"] [:db/ensure "fb2a09b8-805b-5475-a6be-01cfe4a50665" :answer/validate] [:db/add "90fd7807-ac81-5841-8275-8d5bd923a884" :answer/id #uuid "90fd7807-ac81-5841-8275-8d5bd923a884"] [:db/add "90fd7807-ac81-5841-8275-8d5bd923a884" :answer/type :answer.type/math] [:db/add "90fd7807-ac81-5841-8275-8d5bd923a884" :answer/value "4 \\operatorname{arcsin}{\\left(\\sqrt{3} x \\right)}+C"] [:db/ensure "90fd7807-ac81-5841-8275-8d5bd923a884" :answer/validate] [:db/add "da83ea42-6426-5bd3-80cb-0ca878cf408f" :answer/id #uuid "da83ea42-6426-5bd3-80cb-0ca878cf408f"] [:db/add "da83ea42-6426-5bd3-80cb-0ca878cf408f" :answer/type :answer.type/math] [:db/add "da83ea42-6426-5bd3-80cb-0ca878cf408f" :answer/value "4 \\sqrt{3} \\operatorname{arcsin}{\\left(\\sqrt{3} x \\right)}+C"] [:db/ensure "da83ea42-6426-5bd3-80cb-0ca878cf408f" :answer/validate] [:db/add "7c7e6666-22ee-50eb-97f6-e9342b017d03" :answer/id #uuid "7c7e6666-22ee-50eb-97f6-e9342b017d03"] [:db/add "7c7e6666-22ee-50eb-97f6-e9342b017d03" :answer/type :answer.type/math] [:db/add "7c7e6666-22ee-50eb-97f6-e9342b017d03" :answer/value "\\frac{4 \\sqrt{3} \\operatorname{arctan}{\\left(\\sqrt{3} x \\right)}}{3}+C"] [:db/ensure "7c7e6666-22ee-50eb-97f6-e9342b017d03" :answer/validate] [:db/add "97c341f9-c5f4-5b