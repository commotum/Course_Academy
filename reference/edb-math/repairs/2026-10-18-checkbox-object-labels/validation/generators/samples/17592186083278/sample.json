          "title": "Determining the Points Where the Tangent is Horizontal or Vertical"
        },
        "question": {
          ":question/problem": "A curve is defined by the parametric equations\n\n$$\nx=4\\operatorname{sin}\u2061t-1,\\,y=-5\\operatorname{cos}\u2061t-2,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical.",
          ":question/answer-fields": [
            {
              ":answer-field/key": "selection",
              ":answer-field/type": ":answer-field.type/radio",
              ":answer-field/choices": [
                {
                  ":answer/value": "$t=\\frac{3\\pi }{2}$ only",
                  ":answer/type": ":answer.type/text",
                  ":answer/id": "e88132aa-efa5-50c2-a1ea-53c41e9f66da"
                },
                {
                  ":answer/value": "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$",
                  ":answer/type": ":answer.type/text",
                  ":answer/id": "12201ea6-fb67-5919-ba4b-195aad0c9514"
                },
                {
                  ":answer/value": "$t=\\frac{\\pi }{4}$ only",
                  ":answer/type": ":answer.type/text",
                  ":answer/id": "438b61d1-1faf-5b53-9bfd-b2383589f3b5"
                },
                {
                  ":answer/value": "$t=\\frac{\\pi }{2}$ only",
                  ":answer/type": ":answer.type/text",
                  ":answer/id": "38cc3468-e7bf-5940-8578-72b425d1fddc"
                },
                {
                  ":answer/value": "$t=\\frac{\\pi }{4}$ and $t=\\frac{3\\pi }{4}$",
                  ":answer/type": ":answer.type/text",
                  ":answer/id": "2092a062-39a9-576a-9c62-4738305f7e02"
                }
              ],
              ":answer-field/id": "d276a381-1170-546c-a2b7-0c34fd0a023d",
              ":answer-field/correct": [
                ":answer/id",
                "12201ea6-fb67-5919-ba4b-195aad0c9514"
              ]
