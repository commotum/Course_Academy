        "question": {
          ":question/id": "05f25ff3-5fbd-59c5-8681-4de64cb358a8",
          ":question/problem": "Find $k$ given that the vectors $a=\u27e83,0,-3\u27e9$, $b=\u27e8-1,k,0\u27e9$, and $c=\u27e80,3,3\u27e9$ are coplanar.\n\n$k=${{field-1}}",
          ":question/answer-fields": [
            {
              ":answer-field/id": "18aeabe4-da7d-5c5d-80fb-c5caa975bff2",
              ":answer-field/key": "field-1",
