f 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451019}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2efc8f2-dfe5-5b29-94dc-09dde2c27a4f" :question/math-academy-id "q-182015" :question/problem "For the sets $X=\\{5,10\\},$ $Y=\\{r,s,t\\},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nSelect all that apply.\n\n- **I.** $(5,r)\\in Z$\n\n- **II.** $(r,t)\\in Z$\n\n- **III.** $(10,s)\\in Z$" :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/1e/1eb13d93fbefc4c7285edef537a9fb3e21339f7a3b37a179eeb150db8d726c1b.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(5,r),(5,s),(5,t),(10,r),(10,s),(10,t)}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186287793 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050432 :topic/id #uuid "48930849-af42-52a8-8e89-28eb54e1d4a5" :topic/math-academy-id 49 :topic/title "The Cartesian Product"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bda7979-54a8-5c65-b93f-707c6e448e2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450132} {:answer/id #uuid "cee43b96-0d55-592c-8297-f954bf2fe28d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450133}] :answer-field/correct {:answer/id #uuid "cee43b96-0d55-592c-8297-f954bf2fe28d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #e