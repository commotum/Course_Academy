[{:db/id #edb/ref 17592186284448 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049676 :topic/id #uuid "0a177390-6525-5d0c-8721-f7f75db39408" :topic/math-academy-id 1945 :topic/title "Global vs. Local Extrema and Critical Points of Multivariable Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9b5d626-78b0-5774-aafd-613b66eeaa23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465545} {:answer/id #uuid "ab2c614f-48ab-553c-95c7-2c834f9f5c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465546}] :answer-field/correct {:answer/id #uuid "d9b5d626-78b0-5774-aafd-613b66eeaa23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465545} :answer-field/id #uuid "f793b2ba-438f-5bb2-8658-18d80fbc0174" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466616} {:answer-field/choices [{:answer/id #uuid "199d1418-b327-50ef-b343-58adc288f02e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465547} {:answer/id #uuid "7c2550a1-53c4-5c35-acaa-90ad572eadce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465548}] :answer-field/correct {:answer/id #uuid "7c2550a1-53c4-5c35-acaa-90ad572eadce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465548} :answer-field/id #uuid "a9856f39-6b9f-5579-8cea-47c67d587978" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466617} {:answer-field/choices [{:answer/id #uuid "f234d944-3f70-5576-986d-c762fd837476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465549} {:answer/id #uuid "66ba5d6b-e8a7-5d17-b295-5b87aa7ec8d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465550}] :answer-field/correct {:answer/id #uuid "66ba5d6b-e8a7-5d17-b295-5b87aa7ec8d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465550} :answer-field/id #uuid "7f4c9b0c-1b22-5532-8761-c120ec061d86" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466618} {:answer-field/choices [{:answer/id #uuid "163c0c63-ffc7-52ba-a24b-e6daa24dd046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465551} {:answer/id #uuid "accf725f-a855-5906-80e0-8ad6a877bdad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465552}] :answer-field/correct {:answer/id #uuid "163c0c63-ffc7-52ba-a24b-e6daa24dd046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465551} :answer-field/id #uuid "93262b58-62f7-560e-b671-e354477a11cd" :answer-field/key "D" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466619}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e8234e3-2169-51fc-89b1-da45a80005bb" :question/math-academy-id "q-164162" :question/problem "![](images/b6/b698fe735caaf3bc260c1e921bb95596df8869eba67ec9ce72484b4d86cc8c69.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?\n\nSelect all that apply." :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch regions exist for the points $B$ and $C.$ Hence, $B$ and $C$ are local maximum points.\n\n**Note**: For the point $B({x}_{B},{y}_{B},{z}_{B}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{B},{y}_{B})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\le f(a,b)$, the point $B$ does satisfy the conditions for a local maximum.\n\n![](images/6d/6d98be34c848e0fbce571fc572fe9dae244e6ce80b677063fea2e19983e1a2da.png)"} {:db/id #edb/ref 17592186284449 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049676 :topic/id #uuid "0a177390-6525-5d0c-8721-f7f75db39408" :topic/math-academy-id 1945 :topic/title "Global vs. Local Extrema and Critical Points of Multivariable Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441ae300-dbfe-51c6-8a56-1c74cff744f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465553} {:answer/id #uuid "1e43d05c-0b2e-57f2-b4f2-d4d9eee6dd99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465554}] :answer-field/correct {:answer/id #uuid "441ae300-dbfe-51c6-8a56-1c74cff744f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/v