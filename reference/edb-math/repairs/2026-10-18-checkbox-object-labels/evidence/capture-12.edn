2186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48699d28-6189-5c8c-ac56-4e78a856e54a" :question/math-academy-id "q-21500" :question/problem "For the function $f(x)=-3{x}^{5/2}+5{x}^{3/2}+15$ on $(0,\\infty ),$ which of the following statements are true?\n- **I.** $x=1$ is a critical point of $f(x)$\n- **II.** ${f}^{″}(1)<0$\n- **III.** $f(x)$ has a relative minimum at $x=1$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We need to identify whether $x=1$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=-3{x}^{5/2}+5{x}^{3/2}+15,$ we get\n\n$$\n{f}^{′}(x)=-3\\cdot \\frac{5}{2}{x}^{3/2}+5\\cdot \\frac{3}{2}{x}^{1/2}=-\\frac{15}{2}{x}^{3/2}+\\frac{15}{2}{x}^{1/2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}-\\frac{15}{2}{x}^{3/2}+\\frac{15}{2}{x}^{1/2} & =0 \\\\ -\\frac{15}{2}{x}^{1/2}(x-1) & =0 \\\\ x & =0,1.\\end{aligned}\n$$\n\nSo we have a critical point at $x=1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-\\frac{15}{2}\\cdot \\frac{3}{2}{x}^{1/2}+\\frac{15}{2}\\cdot \\frac{1}{2}{x}^{-1/2}=-\\frac{45}{4}{x}^{1/2}+\\frac{15}{4}{x}^{-1/2},\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=1$, we get\n\n$$\n{f}^{″}(1)=-\\frac{45}{4}(1)^{1/2}+\\frac{15}{4}(1)^{-1/2}=-\\frac{15}{2}<0.\n$$\n\nThe second derivative is negative at $x=1,$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=1$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(1)<0\\,✓$\n\n- $f(x)$ has a relative *maximum* at $x=1\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186290310 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test" :topic/_knowledge-points [{:db/id #edb/ref 17592186048883 :topic/id #uuid "c96abbae-0759-5f81-9064-a4b37d0b7422" :topic/math-academy-id 339 :topic/title "The Second Derivative Test"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1458dc53-ee79-5264-9911-8ed7339cb912" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465851} {:answer/id #uuid "776e57cd-230f-5027-88ae-a66b6a45fc65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465852}] :answer-field/correct {:answer/id #uuid "776e57cd-230f-5027-88ae-a66b6a45fc65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465852} :answer-field/id #uuid "5e14f205-4338-574c-984e-57205f445905" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466769} {:answer-field/choices [{:answer/id #uuid "9000b745-54e7-52e5-9d20-5be943c24dea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465853} {:answer/id #uuid "b217d6bb-9abe-54de-bf75-219c5f41a1a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465854}] :answer-field/correct {:answer/id #uuid "b217d6bb-9abe-54de-bf75-219c5f41a1a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465854} :answer-field/id #uuid "41819972-9642-5ab0-a194-47a7491ed78f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466770} {:answer-field/choices [{:answer/id #uuid "cfc6401a-e444-5077-a023-52e04c085fa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465855} {:answer/id #uuid "a157ae35-ee9d-54ba-8019-906609e47187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465856}] :answer-field/correct {:answer/id #uuid "cfc6401a-e444-5077-a023-52e04c085fa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465855} :answer-field/id #uuid "8678397e-2f2b-55b8-a327-5e1713aee4b6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b9fc172-9b76-5d55-bed8-430ab7579f16" :question/math-academy-id "q-21504" :question/problem "For the function $f(x)=-6{x}^{2}+36x-48,$ which of the following statements are true?\n- **I.** $x=3$ is a critical point of $f(x)$\n- **II.** ${f}^{″}(3)<0$\n- **III.** $f(x)$ has a relative minimum at $x=3$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We need to identify whether $x=3$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=-6{x}^{2}+36x-48,$ we get\n\n$$\n{f}^{′}(x)=-12x+36,\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}-12x+36 & =0 \\\\ -12(x-3) & =0 \\\\ x & =3.\\end{aligned}\n$$\n\nSo we have a critical point at $x=3.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-12,\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=3$, we get\n\n$$\n{f}^{″}(3)=-12<0.\n$$\n\nThe second derivative is negative at $x=3,$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=3$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(3)<0\\,✓$\n\n- $f(x)$ has a relative *maximum* at $x=3\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186290311 :knowledge-point/_questions [{:db/id #edb/ref 17592186064166 :knowledge-point/id #uuid "fbee870b-4a67-5ccb-b274-45fac627be6e" :knowledge-point/title "Classifying a Given Critical Point Using the Second Derivative Test" :topic/_knowledge-points [{:db/id #edb/ref 17592186048883 :topic/id #uuid "c96abbae-0759-5f81-9064-a4b37d0b7422" :topic/math-academy-id 339 :topic/title "The Second Derivative Test"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb107d48-ade8-59ec-9f3f-9647d1dd8ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450194} {:answer/id #uuid "0e6a7f11-143b-5dad-9fa8-26bd5aa3ba78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450195}] :answer-field/correct {:answer/id #uuid "eb107d48-ade8-59ec-9f3f-9647d1dd8ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450194} :answer-field/id #uuid "1d2ae416-dab6-56f3-853a-13a41bcd30e9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451051} {:answer-field/choices [{:answer/id #uuid "d51b7c1f-845e-5f42-ae9f-87a5ad90b535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450196} {:answer/id #uuid "25bbe643-d2a8-5ad9-b37b-6925f5785413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450197}] :answer-field/correct {:answer/id #uuid "25bbe643-d2a8-5ad9-b37b-6925f5785413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450197} :answer-field/id #uuid "9e5abbe1-37bc-59ba-97ad-66d356b8e172" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451052} {:answer-field/choices [{:answer/id #uuid "9923f078-f81a-53c2-8593-cbccad0915dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450198} {:answer/id #uuid "2c3b6fd7-2573-50bb-83e7-54096e8ece0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450199}] :answer-field/correct {:answer/id #uuid "9923f078-f81a-53c2-8593-cbccad0915dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450198} :answer-field/id #uuid "39f205e1-a0a5-59f2-ad75-3388b2ab0d1e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cf080c3-6e5f-55a7-a304-f18da95a7022" :question/math-academy-id "q-21508" :question/problem "Consider the function $f(x)=3{x}^{2}-6x+9.$ Given that ${f}^{′}(1)=0,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{″}(1)<0$\n- **II.** $f(x)$ has a relative minimum at $x=1$\n- **III.** $f(x)$ has a relative maximum at $x=1$" :question/worked-solution "We're given that $x=1$ is a stationary point of $f(x).$ We will use the second derivative test to classify this stationary point.\n\nCalculating the first derivative for the function $f(x)=3{x}^{2}-6x+9,$ we get\n\n$$\n{f}^{′}(x)=6x-6.\n$$\n\nCalculating the second derivative, we get \n\n$$\n{f}^{″}(x)=6.\n$$\n\nSubstituting $x=1,$ we get\n\n$$\n\\begin{aligned}{f}^{″}(1) & =6>0.\\end{aligned}\n$$\n\nSince the second derivative is positive, we conclude that $f(x)$ has a relative minimum at $x=1.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186290312 :knowledge-point/_questions [{:db/id #edb/ref 17592186064166 :knowledge-point/id #uuid "fbee870b-4a67-5ccb-b274-45fac627be6e" :knowledge-point/title "Classifying a Given Critical Point Using the Second Derivative Test" :topic/_knowledge-points [{:db/id #edb/ref 17592186048883 :topic/id #uuid "c96abbae-0759-5f81-9064-a4b37d0b7422" :topic/math-academy-id 339 :topic/title "The Second Derivative Test"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5af6d2ba-7e1f-59a1-83fe-8e1adb7b24b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450200} {:answer/id #uuid "59750fcf-5216-5ec2-a1ec-d9fb69d7a2a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450201}] :answer-field/correct {:answer/id #uuid "5af6d2ba-7e1f-59a1-83fe-8e1adb7b24b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450200} :answer-field/id #uuid "dd903065-3e98-5220-b193-4510ce250e18" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451054} {:answer-field/choices [{:answer/id #uuid "231ba120-c2fc-529e-b8bf-524707e79c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450202} {:answer/id #uuid "262fdf04-b5c2-5cda-bbee-46e634415301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450203}] :answer-field