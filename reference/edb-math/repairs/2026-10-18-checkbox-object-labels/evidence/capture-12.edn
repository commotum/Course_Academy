6} {:answer-field/choices [{:answer/id #uuid "602380ef-b41c-57fd-86b6-225808338ba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465687} {:answer/id #uuid "247576d6-f939-593e-a48b-5fb7a6229436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465688}] :answer-field/correct {:answer/id #uuid "602380ef-b41c-57fd-86b6-225808338ba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465687} :answer-field/id #uuid "07076ec2-3a25-5dc2-ba51-06d566c98910" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466687} {:answer-field/choices [{:answer/id #uuid "7da8d070-b66a-5826-8588-70a488ab67fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465689} {:answer/id #uuid "f24fdb91-1196-5e5a-b51b-10ef310c6f21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465690}] :answer-field/correct {:answer/id #uuid "7da8d070-b66a-5826-8588-70a488ab67fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465689} :answer-field/id #uuid "572d5f27-b4b7-5d31-8ba6-6655757099c2" :answer-field/key "Z" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcd97869-92b9-51fc-a566-7b09c1bf865d" :question/math-academy-id "q-181522" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\sqrt{-4}$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-4}=2\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-4}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-4}$ is nonzero, it does *not* belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-4}\\notin N,\\,\\sqrt{-4}\\notin Z,\\,\\sqrt{-4}\\notin Q,\\,\\sqrt{-4}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\""} {:db/id #edb/ref 17592186287685 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87985633-a954-5330-befa-d83e44dfd050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465691} {:answer/id #uuid "aa79bd01-667b-581c-96fa-77a21b6afd28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465692}] :answer-field/correct {:answer/id #uuid "87985633-a954-5330-befa-d83e44dfd050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465691} :answer-field/id #uuid "30541746-026e-5fad-9974-a23f7186d006" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #e