swer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465819} :answer-field/id #uuid "4e6beae7-8b0d-5294-bdee-52c9c42461ef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b374349-dba8-556c-833d-28419c5d38a1" :question/math-academy-id "q-182011" :question/problem "For the sets $X=\\{x,z\\},$ $Y=\\{a,b\\},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nI. $(a,x)\\in Z$\n\nII. $(z,a)\\in Z$\n\nIII. $(z,z)\\in Z$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/b7/b73e7aeb017bd9f7c50f7d110c7933763834eb391ac4a3e97d25f4e587a8a3d4.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,a),(x,b),(z,a),(z,b)}.\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186287791 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050432 :topic/id #uuid "48930849-af42-52a8-8e89-28eb54e1d4a5" :topic/math-academy-id 49 :topic/title "The Cartesian Product"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dedf38d-0a52-5149-9413-322520d8ed48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450126} {:answer/id #uuid "879b6724-e7d0-5fc7-8be2-bf1beb56caf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/