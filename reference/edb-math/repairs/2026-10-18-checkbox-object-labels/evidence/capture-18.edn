8 \\\\ -1 \\\\ -2\\end{bmatrix}}$\n- **V.** $V={\\begin{bmatrix}-3 \\\\ -2\\end{bmatrix},\\begin{bmatrix}6 \\\\ 1\\end{bmatrix}}$\n- **W.** $W={\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}}$\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2},{u}_{3}},$\n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2},{w}_{3}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ notice that \n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}-5 \\\\ 1 \\\\ 0\\end{bmatrix}=-10-3+0=-13\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}-3 \\\\ -2\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 1\\end{bmatrix}=-18-2=-20\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}=2-1-1=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{3} & =\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=0-1+1=0 & ✓ \\\\ {w}_{2}\\cdot {w}_{3} & =\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=0+1-1=0 & ✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, we conclude that the correct answer is \"$W$ only\"."} {:db/id #edb/ref 17592186351422 :knowledge-point/_questions [{:db/id #edb/ref 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal" :topic/_knowledge-points [{:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be5862e6-b730-5e81-9ac1-5e844249d701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469278} {:answer/id #uuid "654dd76b-a128-5d4e-b986-b07234a9d3c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469279}] :answer-field/correct {:answer/id #uuid "654dd76b-a128-5d4e-b986-b07234a9d3c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469279} :answer-field/id #uuid "8c6dc41f-cfa7-5461-a976-ac251c6b54e5" :answer-field/key "U" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470251} {:answer-field/choices [{:answer/id #uuid "4e4af0f3-7d42-5e9a-abb1-c42b4f5355c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469280} {:answer/id #uuid "bd22712f-03ea-5666-af1b-1402b2b37d3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469281}] :answer-field/correct {:answer/id #uuid "bd22712f-03ea-5666-af1b-1402b2b37d3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469281} :answer-field/id #uuid "24699510-dda2-5446-ac6e-65cc0cd53489" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470252} {:answer-field/choices [{:answer/id #uuid "7ac75cde-6eb1-56e3-9185-ae7e5ed25b9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469282} {:answer/id #uuid "66347df5-2c1c-5bb6-89a7-f5ea0bcdf181" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469283}] :answer-field/correct {:answer/id #uuid "7ac75cde-6eb1-56e3-9185-ae7e5ed25b9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469282} :answer-field/id #uuid "34b6086a-d4e7-5d21-9eec-909a989af9d6" :answer-field/key "W" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470253}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7632fcb-d145-5958-9540-44c860cfa586" :question/math-academy-id "q-82397" :question/problem "Which of the following sets are orthogonal?\n- **U.** $U={\\begin{bmatrix}1 \\\\ 3 \\\\ -1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ 1\\end{bmatrix}}$\n- **V.** $V={\\begin{bmatrix}1 \\\\ -1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}}$\n- **W.** $W={\\begin{bmatrix}5 \\\\ -3\\end{bmatrix},\\begin{bmatrix}-3 \\\\ -8\\end{bmatrix}}$\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2},{u}_{3}},$ \n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}1 \\\\ 3 \\\\ -1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}=-1+3-1-1=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{3} & =\\begin{bmatrix}1 \\\\ 3 \\\\ -1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ 1\\end{bmatrix}=1+0-2+1=0 & ✓ \\\\ {u}_{2}\\cdot {u}_{3} & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ 1\\end{bmatrix}=-1+0+2-1=0 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $V,$ we get the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}1 \\\\ -1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}=2-1-1=0 & ✓\\end{aligned}\n$$\n\nSo, the set $V$ is orthogonal.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}\\cdot \\begin{bmatrix}-3 \\\\ -8\\end{bmatrix}=-15+24=9\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $V$ only\"."} {:db/id #edb/ref 17592186351423 :knowledge-point/_questions [{:db/id #edb/ref 17592186133781 :knowledge-point/id #uuid "ed5c8af7-e617-5e8c-be01-45a26eb17d4d" :knowledge-point/title "Determining Whether Sets are Orthonormal" :topic/_knowledge-points [{:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b974feb-5457-574d-a527-ebd86a5e5813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469284} {:answer/id #uuid "d4583b7f-a4ce-5f0e-bde1-2305fb803d32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469285}] :answer-field/correct {:answer/id #uuid "8b974feb-5457-574d-a527-ebd86a5e5813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469284} :answer-field/id #uuid "0c04baba-bbb6-50c8-ad0a-506d8f8bf90f" :answer-field/key "U" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470254} {:answer-field/choices [{:answer/id #uuid "de462187-00a2-5c0a-8f94-af38fffbe0c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469286} {:answer/id #uuid "a974d9f6-4c7d-5c1e-a776-2b79fb0fd47b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469287}] :answer-field/correct {:answer/id #uuid "de462187-00a2-5c0a-8f94-af38fffbe0c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469286} :answer-field/id #uuid "b6947177-0e2d-5291-b8f3-8ab7a401723f" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470255} {:answer-field/choices [{:answer/id #uuid "3ce4a16d-c13c-5ce1-91da-8761f7a9a9c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469288} {:answer/id #uuid "dc21e406-b931-5622-8c7f-f6a3c426155e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469289}] :answer-field/correct {:answer/id #uuid "dc21e406-b931-5622-8c7f-f6a3c426155e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469289} :answer-field/id #uuid "24a51c46-911d-55ae-a9b0-cd6fdec63972" :answer-field/key "W" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c1e164f-769d-52d4-a09c-f8474e7b2368" :question/math-academy-id "q-82401" :question/problem "Which of the following sets are orthonormal?\n- **U.** $U={\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}$\n- **V.** $V={\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}$\n- **W.** $W={\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}$\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$\n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2}}$, respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{1} &=1 \\\\ {u}_{2}\\cdot {u}_{2} &=1.\\end{aligned}\\right.$\n\n- ${v}_{1}\\cdot {v}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{v}_{1}\\cdot {v}_{1} &=1 \\\\ {v}_{2}\\cdot {v}_{2} &=1.\\end{aligned}\\right.$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{w}_{1}\\cdot {w}_{1} &=1 \\\\ {w}_{2}\\cdot {w}_{2} &=1.\\end{aligned}\\right.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ notice that\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{1} & =\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=1+1=2\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthonormal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=0+\\frac{2}{\\sqrt{5}}=\\frac{2}{\\sqrt{5}}\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=0+0=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=1+0=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=0+1=1 & ✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthonormal.\n\nTherefore, we conclude that the correct answer is \"$W$ only\"."} {:db/id #edb/ref 17592186351471 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048459 :topic/id #uuid "a163637a-ed19-547a-85e8-0acfdb20fa0f" :topic/math-academy-id 865 :topic/title "Introduction to Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae458531-3fea-5d4a-9fef-16784006df96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469290} {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291}] :answer-field/correct {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291} :answer-field/id #uuid "ab84475d-72cc-534c-be81-a6861c464c13" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470257} {:answer-field/choices [{:answer/id #uuid "3a743681-e458-539f-acc1-e7e101830b51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469292} {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293}] :answer-field/correct {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293} :answer-field/id #uuid "21f12b61-0b8f-58ec-be60-cd2667a6b36b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470258} {:answer-field/choices [{:answer/id #uuid "4fdad23f-a509-5ce9-9efa-82f9ccbc40a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469294} {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295}] :answer-field/correct {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295} :answer-field/id #uuid "45138a1d-ce8d-542c-875e-b3141969f4d5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470259}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d21c33a8-a8c0-5b77-a079-4c787c111b5f" :question/math-academy-id "q-8296" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x+2y \\\\ 3y\\end{bmatrix}.$\nWhich of the following statements are true?\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}5(kx)+2(ky) \\\\ 3(ky)\\end{bmatrix} \\\\  & =\\begin{bmatrix}k(5x+2y) \\\\ k(3y)\\end{bmatrix} \\\\  & =k\\begin{bmatrix}5x+2y \\\\ 3y\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}5({x}_{1}+{x}_{2})+2({y}_{1}+{y}_{2}) \\\\ 3({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{x}_{1}+2{y}_{1} \\\\ 3{y}_{1}\\end{bmatrix}+\\begin{bmatrix}5{x}_{2}+2{y}_{2} \\\\ 3{y}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186351472 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048459 :topic/id #uuid "a163637a-ed19-547a-85e8-0acfdb20fa0f" :topic/math-academy-id 865 :topic/title "Introduction to Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f2bbb7-924e-519b-858e-8781702c24be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469296} {:answer/id #uui