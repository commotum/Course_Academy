dent :answer-field.type/checkbox} :db/id #edb/ref 17592186470193} {:answer-field/choices [{:answer/id #uuid "687f8064-d19c-5b04-96b5-7a66771814c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469164} {:answer/id #uuid "f5c28a97-679f-53e1-9f72-90fbf1ccf00b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469165}] :answer-field/correct {:answer/id #uuid "f5c28a97-679f-53e1-9f72-90fbf1ccf00b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469165} :answer-field/id #uuid "8df6bed7-94ed-5467-9b40-5bdc5c2235df" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470194} {:answer-field/choices [{:answer/id #uuid "e4f23960-532d-56dc-a2f0-3689d73fd744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469166} {:answer/id #uuid "8756a38a-dd41-5cd2-9f7e-889679dc1f2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469167}] :answer-field/correct {:answer/id #uuid "e4f23960-532d-56dc-a2f0-3689d73fd744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469166} :answer-field/id #uuid "fb5533c3-5e75-59ef-898a-e61b052fc950" :answer-field/key "Z" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c87cce5-2762-52a9-b3ea-307f7f887046" :question/math-academy-id "q-80332" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\pi $ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- The number $\\pi $ is not an integer, so it does *not* belong to $Z$ nor to $N,$ so we can write\n\n$$\n\\pi \\notin N,\\,\\pi \\notin Z.\n$$\n\n- Also, notice that $\\pi =3.14159\\,…\\,$ can not be written as the ratio of two integers, so it does *not* belong to $Q$ either, and we can write \n\n$$\n\\pi \\notin Q.\n$$\n\n- Every irrational number is both a real number and a complex number. Consequently, $\\pi $ belongs to both $R$ and $C,$ and we can write\n\n$$\n\\pi \\in R,\\,\\pi \\in C.\n$$\n\nTherefore, the correct answer is \"$R$ and $C$ only.\""} {:db/id #edb/ref 17592186348366 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81a9b836-be12-5f7a-a40d-e0e95740c064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469168} {:answer/id #uuid "52bdfb16-e79a-5b0b-835c-6dbbdc77e07f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469169}] :answer-field/correct {:answer/id #uuid "52bdfb16-e79a-5b0b-835c-6dbbdc77e07f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.ty