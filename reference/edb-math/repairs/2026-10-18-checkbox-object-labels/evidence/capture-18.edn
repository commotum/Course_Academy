 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469492} :answer-field/id #uuid "48cd5ea8-f344-59a6-ae82-9026baabb5dd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470358}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6956ed56-9d47-53cf-b35c-82d26f52b6fb" :question/math-academy-id "q-88692" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n- **I.** ${\\int }_{-3}^{3}{x}^{2}\\operatorname{sin}⁡(4x)\\,\\text{d}x$\n- **II.** ${\\int }_{-2}^{2}x({e}^{x}+{e}^{-x})\\,\\text{d}x$\n- **III.** ${\\int }_{-\\pi }^{\\pi }{x}^{4}\\operatorname{cos}⁡(2x)\\,\\text{d}x$\n\nSelect all that apply." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={x}^{2}\\operatorname{sin}⁡(4x)$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{2}\\operatorname{sin}⁡(4(-x)) \\\\  & ={x}^{2}\\operatorname{sin}⁡(-4x) \\\\  & ={x}^{2}(-\\operatorname{sin}⁡(4x)) \\\\  & =-{x}^{2}\\operatorname{sin}⁡(4x) \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nHence, by symmetry, we can conclude that\n\n$$\n{\\int }_{-3}^{3}{x}^{2}\\operatorname{sin}⁡(4x)\\,\\text{d}x=0.\n$$\n\n- The function $g(x)=x({e}^{x}+{e}^{-x})$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)({e}^{(-x)}+{e}^{-(-x)}) \\\\  & =-x({e}^{-x}+{e}^{x}) \\\\  & =-x({e}^{x}+{e}^{-x}) \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-2}^{2}x({e}^{x}+{e}^{-x})\\,\\text{d}x=0.\n$$\n\n- The function $h(x)={x}^{2}\\operatorname{cos}⁡(2x)$ is *not* an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{2}\\operatorname{cos}⁡(2(-x)) \\\\  & ={x}^{2}\\operatorname{cos}⁡(-2x) \\\\  & ={x}^{2}\\operatorname{cos}⁡(2x) \\\\  & \\ne -h(x)\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186354656 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186048495 :topic/id #uuid "a4841cae-d95f-5e07-960c-2030a42a2568" :topic/math-academy-id 2975 :topic/title "Evaluating Definite Integrals Using Symmetry"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3a62b3e-3778-50e2-9b13-fca56d3109e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469494} {:answer/id #uuid "e76ffc94-1183-5bdc-a881-050b7728a4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469495}] :answer-field/correct {:answer/id #uuid "e76ffc94-1183-5bdc-a881-050b7728a4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469495} :answer-field/id #uuid "db3bd7f9-0127-5cc0-9031-fc491225923b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470359} {:answer-field/choices [{:answer/id #uuid "eca809b4-79bc-5702-837b-f795e104c492" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469496} {:answer/id #uuid "1337aa00-6b54-5794-8a95-c261410543b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469497}] :answer-field/correct {:answer/id #uuid "eca809b4-79bc-5702-837b-f795e104c492" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469496} :answer-field/id #uuid "95092969-3f5d-5977-baff-eeb5af76e796" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470360} {:answer-field/choices [{:answer/id #uuid "7521864a-802d-5ffe-ae58-df8224f7e2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469498} {:answer/id #uuid "53549473-7f25-5327-bb42-de392cec6ca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469499}] :answer-field/correct {:answer/id #uuid "7521864a-802d-5ffe-ae58-df8224f7e2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469498} :answer-field/id #uuid "7d6887a1-1995-544d-b8ac-23ca51bdadaa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470361}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "857f38ae-b398-5bec-99e3-9572a98abf10" :question/math-academy-id "q-88695" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n- **I.** ${\\int }_{-7}^{7}x{e}^{-{x}^{2}}\\,\\text{d}x$\n- **II.** ${\\int }_{-4}^{4}{x}^{2}{e}^{x}\\,\\text{d}x$\n- **III.** ${\\int }_{-2}^{2}(x+1)^{3}\\,\\text{d}x$\n\nSelect all that apply." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=x{e}^{-{x}^{2}}$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x){e}^{-(-x)^{2}} \\\\  & =-x{e}^{-{x}^{2}} \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-7}^{7}x{e}^{-{x}^{2}}\\,\\text{d}x=0.\n$$\n\n- The function $g(x)={x}^{2}{e}^{x}$  is *not* an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)^{2}{e}^{(-x)} \\\\  & ={x}^{2}{e}^{-x} \\\\  & \\ne -g(x)\\,\\times \\end{aligned}\n$$\n\n- The function $h(x)=(x+1)^{3}$ is *not* an odd function:\n\n$$\n\\begin{aligned}h(-x) & =((-x)+1)^{3} \\\\  & =(1-x)^{3} \\\\  & \\ne -h(x)\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186357357 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186048495 :topic/id #uuid "a4841cae-d95f-5e07-960c-2030a42a2568" :topic/math-academy-id 2975 :topic/title "Evaluating Definite Integrals Using Symmetry"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7f7cf18-38f0-5077-a538-342af76dc308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469500} {:answer/id #uuid "06283436-a33a-58b7-a43f-b43074424d0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469501}] :answer-field/correct {:answer/id #uuid "e7f7cf18-38f0-5077-a538-342af76dc308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469500} :answer-field/id #uuid "8d12fdd3-bb32-5a4d-a689-b2163aa9260c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470362} {:answer-field/choices [{:answer/id #uuid "15309a98-2249-5a8f-8836-e83448833169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469502} {:answer/id #uuid "558b83bf-f917-545e-abd3-673c89b7308d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469503}] :answer-field/correct {:answer/id #uuid "558b83bf-f917-545e-abd3-673c89b7308d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469503} :answer-field/id #uuid "30c76670-dff0-51bc-9765-8c3d9cb1e80c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470363} {:answer-field/choices [{:answer/id #uuid "a2e0d0a3-7248-5080-a257-664102b7609f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469504} {:answer/id #uuid "d63ff98e-39aa-52d8-a345-3c9ecc2a799f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469505}] :answer-field/correct {:answer/id #uuid "a2e0d0a3-7248-5080-a257-664102b7609f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469504} :answer-field/id #uuid "493d5107-b668-56d5-b4f0-5cd63321224a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470364}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ea94d170-9b47-53c8-b5f9-b4a6837f2064" :question/math-academy-id "q-88698" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n- **I.** ${\\int }_{-\\pi }^{\\pi }({x}^{3}-2)\\,\\text{d}x$\n- **II.** ${\\int }_{-1}^{1}({x}^{5}+x\\operatorname{cos}⁡x)\\,\\text{d}x$\n- **III.** ${\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡({e}^{{x}^{2}})\\,\\text{d}x$\n\nSelect all that apply." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $h(x)={x}^{3}-2$ is *not* an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{3}-2 \\\\  & =-{x}^{3}-2 \\\\  & =-({x}^{3}+2) \\\\  & \\ne -h(x)\\,\\times \\end{aligned}\n$$\n\n- The function $f(x)={x}^{5}+x\\operatorname{cos}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{5}+(-x)\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{5}-x\\operatorname{cos}⁡x \\\\  & =-({x}^{5}+x\\operatorname{cos}⁡x) \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-1}^{1}({x}^{5}+x\\operatorname{cos}⁡x)\\,\\text{d}x=0.\n$$\n\n- The function $g(x)=\\operatorname{sin}⁡({e}^{{x}^{2}})$ is *not* an odd function:\n\n$$\n\\begin{aligned}g(-x) & =\\operatorname{sin}⁡({e}^{(-x)^{2}}) \\\\  & =\\operatorname{sin}⁡({e}^{{x}^{2}}) \\\\  & \\ne -g(x)\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186357387 :knowledge-point/_questions [{:db/id #edb/ref 17592186105817 :knowledge-point/id #uuid "2f7256c7-afea-5c33-a859-623b0531e88c" :knowledge-point/title "Identifying Discrete Random Variables" :topic/_knowledge-points [{:db/id #edb/ref 17592186048368 :topic/id #uuid "99cc78ff-5612-5e6a-a347-8c2389044b69" :topic/math-academy-id 1290 :topic/title "Probability Mass Functions of Discrete Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd0cb9d0-7a4e-5cee-9670-8ecef5397953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469506} {:answer/id #uuid "b64c35dc-577d-5453-8511-098dfe72985a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469507}] :answer-field/correct {:answer/id #uuid "dd0cb9d0-7a4e-5cee-9670-8ecef5397953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469506} :answer-field/id #uuid "af4da1b0-0dc1-5e61-9fd7-ab1709d5923a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470365} {:answer-field/choices [{:answer/id #uuid "1a4f1d4a-05d0-5f02-8d12-8843949c13e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469508} {:answer/id #uuid "8aae8d9d-9a3b-539e-a8ec-80316c817815" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469509}] :answer-field/correct {:answer/id #uuid "8aae8d9d-9a3b-539e-a8ec-80316c817815" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469509} :answer-field/id #uuid "66243b5a-3332-558d-9faa-1d5ba7ed36be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470366} {:answer-field/choices [{:answer/id #uuid "4531a54d-3a0a-541c-93d0-00fa8344d8ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469510} {:answer/id #uuid "a745cba0-7f6d-5348-b9be-70cd6706fbe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469511}] :answer-field/correct {:answer/id #uuid "4531a54d-3a0a-541c-93d0-00fa8344d8ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469510} :answer-field/id #uuid "5f9a935f-0519-58e4-bd89-3b8ce4602ea9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470367}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89d077ef-e867-5965-84f4-b7f7051e5ef3" :question/math-academy-id "q-89206" :question/problem "Which of the following are discrete random variables?\n- **I.** The exact time (not rounded to integers) that a full charge of a phone battery lasts\n- **II.** The number of pets owned by a randomly selected family in a town\n- **III.** The height of a randomly selected plant in a nursery\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment.\n\nA *discrete* random variable is a random variable\n\n- that has finitely many possible values, or\n\n- whose possible values can be listed in a sequence: ${x}_{1},{x}_{2},{x}_{3},…$\n\nRemember that a real interval (e.g. $(a,b)$ or $[a,b]$) cannot be listed in a sequence.\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I does not describe a discrete random variable. Although its value is determined by the result of an experiment, the possible values are real numbers that cannot be listed in a sequence.\n\n- Statement II describes a discrete random variable. Its value is determined by the result of an experiment, and it has finitely many possible values: $0,1,2,3,….$\n\n- Statement III does not describe a discrete random variable. Although its value is determined by the result of an experiment, the possible values are real numbers that cannot be listed in a sequence.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186357392 :knowledge-point/_questions [{:db/id #edb/ref 17592186105827 :knowledge-point/id #uuid "162690db-70b3-54a8-a920-576a484a42d9" :knowledge-point/title "Identifying Random Variables that Follow a Binomial Distribution" :topic/_knowledge-points [{:db/id #edb/ref 17592186049632 :topic/id #uuid "06f86dee-da2a-593c-8633-10b2e3189b5c" :topic/math-academy-id 1395 :topic/title "Modeling With the Binomial Distribution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d429a9-d70c-57e7-955e-30fdddf6b515" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469512} {:answer/id #uuid "238e6910-c921-5791-8270-d2f8ece14bf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469513}] :answer-field/correct {:answer/id #uuid "238e6910-c921-5791-8270-d2f8ece14bf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469513} :answer-field/id #uuid "f114d1c5-53d1-5be4-8a50-b27e80bfcc02" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470368} {:answer-field/choices [{:answer/id #uuid "51b0c465-adbd-5ff2-a9f0-3672be3892ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469514} {:answer/id #uuid "bf5704a2-b5a2-5ba2-b7c6-d501f6aec86e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469515}] :answer-field/correct {:answer/id #uuid "bf5704a2-b5a2-5ba2-b7c6-d501f6aec86e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469515} :answer-field/id #uuid "5aa540f6-ffac-5aab-86d8-61a63849afb3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470369} {:answer-field/choices [{:answer/id #uuid "2fff5b7d-5579-5929-a43d-471552870083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469516} {:answer/id #uuid "9fea0e66-c012-585b-8f4c-f437e1d53543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469517}] :answer-field/correct {:answer/id #uuid "2fff5b7d-5579-5929-a43d-471552870083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469516} :answer-field/id #uuid "c9ce6a27-7a10-5485-8403-ce9eac9b4de2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470370}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3640d184-7917-5cae-8823-08846078aa32" :question/math-academy-id "q-89354" :question/problem "Which of the following random variables could be modeled as a binomial distribution?\n- **I.** The number of baskets made by a basketball player attempting three free throws if the probability of scoring any free throw is $65%$\n- **II.** The number of defective items in a random sample of $100$ items produced by a machine\n- **III.** The number of views of a video on a popular video channel\n\nSelect all that apply." :question/worked-solution "A binomial distribution models the number of successes in a sequence of $n$ independent experiments (where each outcome is either success or failure).\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I could be modeled as a binomial distribution. The number of baskets in $3$ throws can be interpreted as the number of successes in a sequence of $3$ independent experiments.\n\n- Random variable II could be modeled as a binomial distribution. The number of defective items in a random sample of $100$ items can be interpreted as the number of successes in a sequence of $100$ independent experiments.\n\n- Random variable III could *not* be modeled as a binomial distribution. The number of views cannot be interpreted as \"success\" or \"failure.\"\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186357393 :knowledge-point/_questions [{:db/id #edb/ref 17592186105827 :knowledge-point/id #uuid "162690db-70b3-54a8-a920-576a484a42d9" :knowledge-point/title "Identifying Random Variables that Follow a Binomial Distribution" :topic/_knowledge-points [{:db/id #edb/ref 17592186049632 :topic/id #uuid "06f86dee-da2a-593c-8633-10b2e3189b5c" :topic/math-academy-id 1395 :topic/title "Modeling With the Binomial Distribution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e93a2454-b29e-51aa-80f3-9456b9873106" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469518} {:answer/id #uuid "dd5a0f89-3a03-544b-ab65-85fa190c2574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469519}] :answer-field/correct {:answer/id #uuid "dd5a0f89-3a03-544b-ab65-85fa190c2574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469519} :answer-field/id #uuid "f10e36c2-2dc3-5a8c-903b-6074050e94dd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470371} {:answer-field/choices [{:answer/id #uuid "9f3998e0-6302-5c52-8a19-fe98044b253b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469520} {:answer/id #uuid "e5745fe8-4932-5d7b-842e-a1d2946a921d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469521}] :answer-field/correct {:answer/id #uuid "9f3998e0-6302-5c52-8a19-fe98044b253b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469520} :answer-field/id #uuid "b0a804be-5a02-5859-b943-512a41d72c82" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470372} {:answer-field/choices [{:answer/id #uuid "0a073217-e81a-5c33-ab4c-3c8b626fddb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469522} {:answer/id #uuid "6db41dbd-b851-55a5-814a-b51eebdc9862" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469523}] :answer-field/correct {:answer/id #uuid "0a073217-e81a-5c33-ab4c-3c8b626fddb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469522} :answer-field/id #uuid "e7a5c00f-ebfa-5a2d-b8c3-bff6f593dde9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470373}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad260dd3-b7b0-51a7-8aee-33250f0e09b0" :question/math-academy-id "q-89355" :question/problem "Which of the following random variables could be modeled as a binomial distribution?\n- **I.** The number of boys in a family of $3$ children\n- **II.** The number of red cars passing through an avenue in an hour\n- **III.** The number of pizzas sold by a pizzeria in a day\n\nSelect all that apply." :question/worked-solution "A binomial distribution models the number of successes in a sequence of $n$ independent experiments (where each outcome is either success or failure).\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I could be modeled as a binomial distribution. The number of boys can be interpreted as the number of successes in a sequence of $3$ independent experiments.\n\n- Random variable II could *not* be modeled as a binomial distribution. Although being red can be interpreted as a \"success,\" there is not a fixed number of trials in this experiment.\n\n- Random variable III could *not* be modeled as a binomial distribution. The number of pizzas sold cannot be interpreted as \"success\" or \"failure.\"\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186357424 :knowledge-point/_questions [{:db/id #edb/ref 17592186157363 :knowledge-point/id #uuid "b5586c38-e0ca-5a6d-90ab-71c0fead2cc2" :knowledge-point/title "Determining Whether a Point on a Solution Curve Is a Stationary Point" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed391fce-2afe-5b9b-a9c6-f670b8630cb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469524} {:answer/id #uuid "57050e23-17df-5843-b160-7621d5528ccc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469525}] :answer-field/correct {:answer/id #uuid "ed391fce-2afe-5b9b-a9c6-f670b8630cb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469524} :answer-field/id #uuid "cbbdb587-2673-5574-93c3-ba0a2535709e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470374} {:answer-field/choices [{:answer/id #uuid "2898c766-abd2-51bb-9814-f2bd37ab3a29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469526} {:answer/id #uuid "bd70e398-b1ab-5131-9929-f9304975f6b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469527}] :answer-field/correct {:answer/id #uuid "bd70e398-b1ab-5131-9929-f9304975f6b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469527} :answer-field/id #uuid "af056641-be7f-5cf7-b1ad-6023b87fe281" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470375} {:answer-field/choices [{:answer/id #uuid "8e0f0017-6948-5bb6-8207-eb13f505b72e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469528} {:answer/id #uuid "a5e4a980-e877-576d-b9b1-fbc7b0973ee4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469529}] :answer-field/correct {:answer/id #uuid "8e0f0017-6948-5bb6-8207-eb13f505b72e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469528} :answer-field/id #uuid "1c077988-6da8-514e-a320-7c4fb3c5dbda" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ebe79c85-c57b-513c-b661-1636edd13781" :question/math-academy-id "q-89866" :question/problem "Consider the solution curves of the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y-4x}{x}.\n$$\n\n \n\nWhich of the following are stationary points of their respective solution curve?\n- **I.** $(1,5)$\n- **II.** $(-2,-4)$\n- **III.** $(-1,-3)$\n\nSelect all that apply." :question/worked-solution "Recall that a stationary point of $f(x)$ is a point $x=c$ in the domain of $f$ such that ${f}^{′}(c)=0.$ \n\nWith that in mind, let's examine each of the given points. We substitute the coordinates of our points into the differential equation and calculate the value of the derivative: \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,5)} & ={(\\frac{2y-4x}{x})|}_{(1,5)} \\\\  & =\\frac{2(5)-4(1)}{1} \\\\  & =6 \\\\  & \\ne 0\\,\\times  \\\\ {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,-4)} & ={(\\frac{2y-4x}{x})|}_{(-2,-4)} \\\\  & =\\frac{2(-4)-4(-2)}{(-2)} \\\\  & =0\\,✓ \\\\ {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-3)} & ={(\\frac{2y-4x}{x})|}_{(-1,-3)} \\\\  & =\\frac{2(-3)-4(-1)}{(-1)} \\\\  & =2 \\\\  & \\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186357425 :knowledge-point/_questions [{:db/id #edb/ref 17592186157363 :knowledge-point/id #uuid "b5586c38-e0ca-5a6d-90ab-71c0fead2cc2" :knowledge-point/title "Determining Whether a Point on a Solution Curve Is a Stationary Point" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51cc055b-de8e-5393-8a8b-b511d70dc797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469530} {:answer/id #uuid "3457b7e9-508e-58e2-a335-c0336824ec4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469531}] :answer-field/correct {:answer/id #uuid "3457b7e9-508e-58e2-a335-c0336824ec4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469531} :answer-field/id #uuid "97d29e05-b9b9-5b13-9274-1fec11ee38c1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470377} {:answer-field/choices [{:answer/id #uuid "602489da-d42c-5fa8-b6fb-229e659e0105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469532} {:answer/id #uuid "04d4f4da-e8f8-5a09-82a7-bdaca673d950" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469533}] :answer-field/correct {:answer/id #uuid "04d4f4da-e8f8-5a09-82a7-bdaca673d950" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469533} :answer-field/id #uuid "21b98c20-25e3-5079-8c1a-c3b2b340be0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470378} {:answer-field/choices [{:answer/id #uuid "0599a20b-574b-5bdc-a59b-504804d76dd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469534} {:answer/id #uuid "453111a5-646d-5f0d-86fb-6db8bb9816cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469535}] :answer-field/correct {:answer/id #uuid "0599a20b-574b-5bdc-a59b-504804d76dd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469534} :answer-field/id #uuid "6a7e04f5-c880-5c61-a926-5168564308e3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470379}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a6c55b2-0dbc-5417-9666-4eed70a77fd5" :question/math-academy-id "q-89869" :question/problem "Consider the solution curves of the differential equation $\\frac{{y}^{′}}{y}+{y}^{2}=x.$ Which of the following points are stationary points of their respective solution curve?\n- **I.** $(1,1)$\n- **II.** $(4,-2)$\n- **III.** $(2,2)$\n\nSelect all that apply." :question/worked-solution "Recall that a stationary point of $y(x)$ is a point $x=c$ in the domain of $y$ such that ${y}^{′}(c)=0.$ \n\nFirst, we make ${y}^{′}$ the subject of the equation.\n\n$$\n\\begin{aligned}\\frac{{y}^{′}}{y}+{y}^{2}=x\\,⟹\\,{y}^{′}=y(x-{y}^{2})\\end{aligned}\n$$\n\nNow, we substitute the coordinates of our points into the differential equation and calculate the value of the derivative: \n\n$$\n\\begin{aligned}{{y}^{′}|}_{(1,1)} & ={y(x-{y}^{2})|}_{(1,1)} \\\\  & =(1)(1-{1}^{2}) \\\\  & =0\\,✓ \\\\ {{y}^{′}|}_{(4,-2)} & ={y(x-{y}^{2})|}_{(4,-2)} \\\\  & =(-2)(4-(-2)^{2}) \\\\  & =0\\,✓ \\\\ {{y}^{′}|}_{(2,2)} & ={y(x-{y}^{2})|}_{(2,2)} \\\\  & =(2)(2-{2}^{2}) \\\\  & =-4 \\\\  & \\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186357426 :knowledge-point/_questions [{:db/id #edb/ref 17592186157363 :knowledge-point/id #uuid "b5586c38-e0ca-5a6d-90ab-71c0fead2cc2" :knowledge-point/title "Determining Whether a Point on a Solution Curve Is a Stationary Point" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1dca5fa-a9a7-5936-992b-453ceb07007e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469536} {:answer/id #uuid "dcce086a-9e68-5c53-8e57-74901b19c09b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469537}] :answer-field/correct {:answer/id #uuid "c1dca5fa-a9a7-5936-992b-453ceb07007e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469536} :answer-field/id #uuid "6d55eb78-31a4-5821-8b16-c576014f0f3f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470380} {:answer-field/choices [{:answer/id #uuid "86e378b6-0af4-5188-a5e7-6414457f0464" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469538} {:answer/id #uuid "82aee8a9-7717-5a7f-8a54-90dfa5eb69ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469539}] :answer-field/correct {:answer/id #uuid "86e378b6-0af4-5188-a5e7-6414457f0464" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469538} :answer-field/id #uuid "2e35b08f-b0c4-534c-9673-873356909333" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470381} {:answer-field/choices [{:answer/id #uuid "7d6ac48f-d971-55cb-8b73-be946f446094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469540} {:answer/id #uuid "ad963729-b8c6-572d-b56a-b69a8f1b73af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469541}] :answer-field/correct {:answer/id #uuid "7d6ac48f-d971-55cb-8b73-be946f446094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469540} :answer-field/id #uuid "2cac8d36-0d1c-5fa4-a1fa-2903f72a8f08" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470382}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e87b95d9-4b1d-5eb0-8c89-8d155a899eb3" :question/math-academy-id "q-89871" :question/problem "Consider the solution curves of the differential equation ${x}^{2}{y}^{′}={e}^{y}.$ Which of the following points are stationary points of their respective solution curve?\n- **I.** $(1,0)$\n- **II.** $(2,-2)$\n- **III.** $(e,1)$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a stationary point of $y(x)$ is a point $x=c$ in the domain of $y$ such that ${y}^{′}(c)=0.$ \n\nFirst, we make ${y}^{′}$ the subject of the equation.\n\n$$\n\\begin{aligned}{x}^{2}{y}^{′}={e}^{y}\\,⟹\\,{y}^{′}=\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nNow, we substitute the coordinates of our points into the differential equation and calculate the value of the derivative: \n\n$$\n\\begin{aligned}{{y}^{′}|}_{(1,0)} & ={(\\frac{{e}^{y}}{{x}^{2}})|}_{(1,0)} \\\\  & =\\frac{{e}^{0}}{{1}^{2}} \\\\  & =1 \\\\  & \\ne 0\\,\\times  \\\\ {{y}^{′}|}_{(2,-2)} & ={(\\frac{{e}^{y}}{{x}^{2}})|}_{(2,-2)} \\\\  & =\\frac{{e}^{-2}}{(2)^{2}} \\\\  & =\\frac{{e}^{-2}}{4} \\\\  & \\ne 0\\,\\times  \\\\ {{y}^{′}|}_{(e,1)} & ={(\\frac{{e}^{y}}{{x}^{2}})|}_{(e,1)} \\\\  & =\\frac{{e}^{1}}{{e}^{2}} \\\\  & ={e}^{-1} \\\\  & \\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"None of the points are the stationary points of the function.\""} {:db/id #edb/ref 17592186357427 :knowledge-point/_questions [{:db/id #edb/ref 17592186157363 :knowledge-point/id #uuid "b5586c38-e0ca-5a6d-90ab-71c0fead2cc2" :knowledge-point/title "Determining Whether a Point on a Solution Curve Is a Stationary Point" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a47cacc-05e2-59e4-b3ce-21a6c2ba88bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469542} {:answer/id #uuid "ad344f99-7760-5710-86f9-d879b6480bd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469543}] :answer-field/correct {:answer/id #uuid "4a47cacc-05e2-59e4-b3ce-21a6c2ba88bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469542} :answer-field/id #uuid "4a634d10-fa1d-52cd-a0d4-6cd281a102e3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470383} {:answer-field/choices [{:answer/id #uuid "c7b43672-317c-5181-abdc-e7031d114d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469544} {:answer/id #uuid "2f6e2d5b-12b9-5aae-94d4-a95b6d406476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469545}] :answer-field/correct {:answer/id #uuid "2f6e2d5b-12b9-5aae-94d4-a95b6d406476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469545} :answer-field/id #uuid "b22bd063-aac7-50c7-8a05-a705c8214bfe" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470384} {:answer-field/choices [{:answer/id #uuid "cbc2e565-ee84-5f30-a307-c4abefd62876" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469546} {:answer/id #uuid "17cc302f-252f-5df6-9a99-5082fb8b1219" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469547}] :answer-field/correct {:answer/id #uuid "17cc302f-252f-5df6-9a99-5082fb8b1219" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469547} :answer-field/id #uuid "6ec56676-6ebe-528e-9f1d-dd62b46dbb51" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b92d6550-a190-5c3e-8b25-14493984cf60" :question/math-academy-id "q-89872" :question/problem "Consider the solution curves of the differential equation ${y}^{′}-{x}^{3}={y}^{2}-2x.$ Which of the following points are stationary points of their respective solution curve?\n- **I.** $(-1,-1)$\n- **II.** $(0,0)$\n- **III.** $(1,1)$\n\nSelect all that apply." :question/worked-solution "Recall that a stationary point of $y(x)$ is a point $x=c$ in the domain of $y$ such that ${y}^{′}(c)=0.$ \n\nFirst, we make ${y}^{′}$ the subject of the equation.\n\n$$\n\\begin{aligned}{y}^{′}-{x}^{3}={y}^{2}-2x\\,⟹\\,{y}^{′}={x}^{3}+{y}^{2}-2x\\end{aligned}\n$$\n\nNow, we substitute the coordinates of our points into the differential equation and calculate the value of the derivative: \n\n$$\n\\begin{aligned}{{y}^{′}|}_{(-1,-1)} & ={({x}^{3}+{y}^{2}-2x)|}_{(-1,-1)} \\\\  & =(-1)^{3}+(-1)^{2}-2(-1) \\\\  & =2 \\\\  & \\ne 0\\,\\times  \\\\ {{y}^{′}|}_{(0,0)} & ={({x}^{3}+{y}^{2}-2x)|}_{(0,0)} \\\\  & =(0)^{3}+(0)^{2}-2(0) \\\\  & =0\\,✓ \\\\ {{y}^{′}|}_{(1,1)} & ={({x}^{3}+{y}^{2}-2x)|}_{(1,1)} \\\\  & =(1)^{3}+(1)^{2}-2(1) \\\\  & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186357435 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94cffac-0f52-5c77-825f-0bfdd28683ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451875} {:answer/id #uuid "1e6eac80-7bf7-51e7-804d-525613d820b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451876}] :answer-field/correct {:answer/id #uuid "1e6eac80-7bf7-51e7-804d-525613d820b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451876} :answer-field/id #uuid "6cb2c1dd-50b0-53e4-bf0b-e1ff47d01cee" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452785} {:answer-field/choices [{:answer/id #uuid "2e3a6b98-e86c-5623-b6e5-022fb623e2fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451877} {:answer/id #uuid "032c98a4-c431-548b-8431-6d9ded716e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451878}] :answer-field/correct {:answer/id #uuid "032c98a4-c431-548b-8431-6d9ded716e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451878} :answer-field/id #uuid "c58dbdbb-b79d-54a5-b153-4dab46952d6a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452786} {:answer-field/choices [{:answer/id #uuid "b17e375e-f3a5-5985-8f28-d894632d69a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451879} {:answer/id #uuid "860ed8f0-ec8b-5919-8e7d-49b72f59cfda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451880}] :answer-field/correct {:answer/id #uuid "b17e375e-f3a5-5985-8f28-d894632d69a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451879} :answer-field/id #uuid "875dbb3d-f76a-54a9-b745-3dcb5a12f6f8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72dda5b9-2988-5be6-b882-d73d509880d4" :question/math-academy-id "q-89885" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=x+y.\n$$\n\nGiven that the point $(-1,1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $(-1,1)$ is a stationary point of the function $f$\n- **II.** $(-1,1)$ is a local minimum point of the function $f$\n- **III.** $(-1,1)$ is an inflection point of the function $f$" :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(-1,1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,1)} & ={(x+y)|}_{(-1,1)} \\\\  & =-1+1 \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x+y) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(y) \\\\  & =1+\\frac{\\text{d}y}{\\text{d}x} \\\\  & =1+(x+y) \\\\  & =x+y+1 \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1,1)} & ={(x+y+1)|}_{(-1,1)} \\\\  & =-1+1+1 \\\\  & =1 \\\\  & >0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,1)}=0,\n$$\n\nwe obtain that $(-1,1)$ is a stationary point of the function $f.$\n\n- Statement II is true. There is a critical point at $(-1,1).$ So, according to the second derivative test, since\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1,1)}>0,\n$$\n\nwe have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(-1,1).$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186357436 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d15a71-3554-597f-a996-a97ed1c8ed55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451881} {:answer/id #uuid "99eada67-2d94-5b32-9e19-3d6bc263054a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451882}] :answer-field/correct {:answer/id #uuid "99eada67-2d94-5b32-9e19-3d6bc263054a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451882} :answer-field/id #uuid "9ce40fc1-4bfd-5742-8051-a80ebafcd454" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452788} {:answer-field/choices [{:answer/id #uuid "38078b3e-4d70-583f-a52d-847f3095a4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451883} {:answer/id #uuid "f69868c8-5873-5d0e-9fec-51b390471e2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451884}] :answer-field/correct {:answer/id #uuid "38078b3e-4d70-583f-a52d-847f3095a4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451883} :answer-field/id #uuid "d3d33c25-6a45-59ec-8f30-8a183e2e2482" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452789} {:answer-field/choices [{:answer/id #uuid "868ad87a-a205-508f-99d3-24bf6b4649dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451885} {:answer/id #uuid "ba2cc099-7c1a-5887-b247-8493f04bd55b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451886}] :answer-field/correct {:answer/id #uuid "868ad87a-a205-508f-99d3-24bf6b4649dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451885} :answer-field/id #uuid "a0ffba87-d42c-5fd0-9996-eccc8e91df84" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452790}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "21b379b1-3944-5c72-96df-e324e7834ad0" :question/math-academy-id "q-89886" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y-x.\n$$\n\nGiven that the point $(0,0)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $(0,0)$ is a stationary point of the function $f$\n- **II.** $(0,0)$ is a local minimum point of the function $f$\n- **III.** $(0,0)$ is an inflection point of the function $f$" :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(0,0),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,0)} & ={(y-x)|}_{(0,0)} \\\\  & =0-0 \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}-1 \\\\  & =(y-x)-1 \\\\  & =y-x-1 \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,0)} & ={(y-x-1)|}_{(0,0)} \\\\  & =0-0-1 \\\\  & =-1 \\\\  & <0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,0)}=0,\n$$\n\nwe obtain that $(0,0)$ is a stationary point of the function $f.$\n\n- Statement II is false. There is a critical point at $(0,0).$ So, according to the second derivative test, since\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,0)}<0,\n$$\n\nwe have a local maximum (not a local minimum) at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(0,0).$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186357437 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d03fa37-ca1a-54f9-a3eb-5a8bf1effac6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469548} {:answer/id #uuid "6fc192d1-a596-57f1-9e52-7df28aa3631a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469549}] :answer-field/correct {:answer/id #uuid "3d03fa37-ca1a-54f9-a3eb-5a8bf1effac6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469548} :answer-field/id #uuid "c7d22a00-7d6c-5c4f-863f-4b796b7ee608" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470386} {:answer-field/choices [{:answer/id #uuid "85798085-cefc-5be0-8526-fcbe0d58d21f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469550} {:answer/id #uuid "468e2470-d7f7-5d4e-92ac-43fe7a8570ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469551}] :answer-field/correct {:answer/id #uuid "85798085-cefc-5be0-8526-fcbe0d58d21f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469550} :answer-field/id #uuid "5b85f1f5-9e6e-5497-98df-d403ecceb824" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470387} {:answer-field/choices [{:answer/id #uuid "cb0b04ec-3384-54b7-bdeb-6b2b7ad2fe88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469552} {:answer/id #uuid "5188a600-1360-5a9d-9060-fbdd68ab3467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469553}] :answer-field/correct {:answer/id #uuid "cb0b04ec-3384-54b7-bdeb-6b2b7ad2fe88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469552} :answer-field/id #uuid "51d29dc4-cdf3-5410-965e-98b9294f009d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470388}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1e244cae-49ac-5727-b109-5857ab506f84" :question/math-academy-id "q-89887" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y+2\\operatorname{sin}⁡x.\n$$\n\nGiven that the point $(\\pi ,1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n- **I.** $(\\pi ,1)$ is a stationary point of the function $f$\n- **II.** $(\\pi ,1)$ is a local maximum point of the function $f$\n- **III.** $(\\pi ,1)$ is an inflection point of the function $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(\\pi ,1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi ,1)} & ={(y+2\\operatorname{sin}⁡x)|}_{(\\pi ,1)} \\\\  & =1+2\\operatorname{sin}⁡(\\pi ) \\\\  & =1\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y+2\\operatorname{sin}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)+\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{sin}⁡x) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}+2\\operatorname{cos}⁡x \\\\  & =(y+2\\operatorname{sin}⁡x)+2\\operatorname{cos}⁡x \\\\  & =y+2\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi ,1)} & ={(y+2\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x)|}_{(\\pi ,1)} \\\\  & =1+2\\operatorname{sin}⁡(\\pi )+2\\operatorname{cos}⁡(\\pi ) \\\\  & =1+0-2 \\\\  & =-1 \\\\  & <0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is false. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi ,1)}=1\\ne 0,\n$$\n\nwe obtain that $(\\pi ,1)$ is not a stationary point of the function $f.$\n\n- Statement II is false. There is no critical point at $(\\pi ,1),$ therefore we cannot have a local maximum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(\\pi ,1).$\n\nTherefore, the correct answer is \"None of those listed.\""} {:db/id #edb/ref 17592186357438 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7336966f-8336-50bb-9351-9f946f8a93c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469554} {:answer/id #uuid "2f19c276-4dd0-5818-a7e8-e0a8c790f637" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469555}] :answer-field/correct {:answer/id #uuid "2f19c276-4dd0-5818-a7e8-e0a8c790f637" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469555} :answer-field/id #uuid "52922013-663f-5486-a5b8-b73490734552" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470389} {:answer-field/choices [{:answer/id #uuid "67d3ff23-6cd5-5077-95e9-4bf353e699f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469556} {:answer/id #uuid "f7fbe06b-4f03-5ee5-8347-c57fabde826e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469557}] :answer-field/correct {:answer/id #uuid "67d3ff23-6cd5-5077-95e9-4bf353e699f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469556} :answer-field/id #uuid "c58572a0-d4f3-5a9c-ae1f-3e90b3667207" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470390} {:answer-field/choices [{:answer/id #uuid "4704dc4d-5c8e-52aa-9ff6-c866e334a419" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469558} {:answer/id #uuid "afd9e88a-8078-53b1-a2cf-af582cabf5e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469559}] :answer-field/correct {:answer/id #uuid "4704dc4d-5c8e-52aa-9ff6-c866e334a419" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469558} :answer-field/id #uuid "662a2990-175d-596c-894a-52061ccb6fc3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470391}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0272b49a-4d96-50b3-ac67-e22a2911e738" :question/math-academy-id "q-89888" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y-4\\operatorname{cos}⁡x.\n$$\n\nGiven that the point $(\\frac{\\pi }{2},0)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n- **I.** $(\\frac{\\pi }{2},0)$ is a stationary point of the function $f$\n- **II.** $(\\frac{\\pi }{2},0)$ is a local maximum point of the function $f$\n- **III.** $(\\frac{\\pi }{2},0)$ is an inflection point of the function $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(\\frac{\\pi }{2},0),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi /2,0)} & ={(y-4\\operatorname{cos}⁡x)|}_{(\\pi /2,0)} \\\\  & =0-4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y-4\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}+4\\operatorname{sin}⁡x \\\\  & =(y-4\\operatorname{cos}⁡x)+4\\operatorname{sin}⁡x \\\\  & =y+4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi /2,0)} & ={(y+4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x)|}_{(\\pi /2,0)} \\\\  & =0+4\\operatorname{sin}⁡(\\frac{\\pi }{2})-4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0+4-0 \\\\  & =4\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi /2,0)}=0,\n$$\n\nwe obtain that $(\\frac{\\pi }{2},0)$ is a stationary point of the function $f.$\n\n- Statement II is false. There is a critical point at $(\\frac{\\pi }{2},0).$ So, according to the second derivative test, since \n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi /2,0)}>0,\n$$\n\n \nwe have a local minimum (not a local maximum) at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(\\frac{\\pi }{2},0).$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186357439 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdbb3904-c6b6-532f-af12-bb5ee642b06c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451887} {:answer/id #uuid "ec88bb3b-8bc6-53e6-b80b-c5c7e170ee59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451888}] :answer-field/correct {:answer/id #uuid "ec88bb3b-8bc6-53e6-b80b-c5c7e170ee59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451888} :answer-field/id #uuid "ed9d8978-02ae-54de-b476-495ad65f4d05" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452791} {:answer-field/choices [{:answer/id #uuid "3cdf6f3d-eff4-5e01-af8b-22be8618f8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451889} {:answer/id #uuid "99928429-3b36-5da2-927f-e66de30e2901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451890}] :answer-field/correct {:answer/id #uuid "99928429-3b36-5da2-927f-e66de30e2901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451890} :answer-field/id #uuid "355746cc-2404-539d-a78a-26147b7e8e68" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452792} {:answer-field/choices [{:answer/id #uuid "5a69ba8d-ce87-5da6-8868-94df457dd58f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451891} {:answer/id #uuid "5177442b-57e5-5591-b061-29c7ac96dfdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451892}] :answer-field/correct {:answer/id #uuid "5a69ba8d-ce87-5da6-8868-94df457dd58f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451891} :answer-field/id #uuid "e0ea8114-05b9-5333-b6e1-b560b2d1e70b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452793}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d8694a2-ea00-53e6-abdb-fa32dda7bdcf" :question/math-academy-id "q-89889" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={x}^{3}+3{x}^{2}-y.\n$$\n\nGiven that the point $(1,4)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $(1,4)$ is a stationary point of the function $f$\n- **II.** $(1,4)$ is a local minimum point of the function $f$\n- **III.** $(1,4)$ is an inflection point of the function $f$" :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(1,4),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,4)} & ={({x}^{3}+3{x}^{2}-y)|}_{(1,4)} \\\\  & =(1)^{3}+3(1)^{2}-(4) \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+3{x}^{2}-y) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}(3{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(y) \\\\  & =3{x}^{2}+6x-\\frac{\\text{d}y}{\\text{d}x} \\\\  & =3{x}^{2}+6x-({x}^{3}+3{x}^{2}-y) \\\\  & =-{x}^{3}+6x+y \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(1,4)} & ={(-{x}^{3}+6x+y)|}_{(1,4)} \\\\  & =-(1)^{3}+6(1)+(4) \\\\  & =9\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,4)}=0,\n$$\n\nwe obtain that $(1,4)$ is a stationary point of the function $f.$\n\n- Statement II is true. There is a critical point at $(1,4).$ So, according to the second derivative test, since \n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(1,4)}>0,\n$$\n\n \nwe have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(1,4).$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186357440 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c862053a-5bee-5c38-9662-6c23de46fd60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469560} {:answer/id #uuid "2e5d7089-7e96-5d4f-b54c-c78b0d049d67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469561}] :answer-field/correct {:answer/id #uuid "2e5d7089-7e96-5d4f-b54c-c78b0d049d67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469561} :answer-field/id #uuid "5276d74f-53e0-56a1-8026-c1dc297a84ec" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470392} {:answer-field/choices [{:answer/id #uuid "8c6c0a2f-2737-5f31-a5e5-7fdf7d0d1363" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469562} {:answer/id #uuid "a31f52be-8332-5208-8d5b-24d230d9e98d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469563}] :answer-field/correct {:answer/id #uuid "a31f52be-8332-5208-8d5b-24d230d9e98d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469563} :answer-field/id #uuid "b17d2099-9152-56aa-9e12-26564c12b1e1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470393} {:answer-field/choices [{:answer/id #uuid "d27c83d1-4a31-5df4-b39b-1772bafc76a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469564} {:answer/id #uuid "3d07a4d3-c170-5686-8fe2-c9bd16b273ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469565}] :answer-field/correct {:answer/id #uuid "d27c83d1-4a31-5df4-b39b-1772bafc76a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469564} :answer-field/id #uuid "6d9d4167-bf75-5351-b7f0-fba4892eca44" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470394}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7cbbdaa7-7656-5f0c-adc2-8162521aa896" :question/math-academy-id "q-89894" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4xy.\n$$\n\nGiven that the point $(0,1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n- **I.** $(0,1)$ is a stationary point of the function $f$\n- **II.** $(0,1)$ is a local minimum point of the function $f$\n- **III.** $(0,1)$ is an inflection point of the function $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(0,1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,1)} & ={(4xy)|}_{(0,1)} \\\\  & =4(0)(1) \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4xy) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x)\\cdot y+4x\\cdot \\frac{\\text{d}}{\\text{d}x}(y) \\\\  & =4y+4x\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =4y+4x(4xy) \\\\  & =4y(1+4{x}^{2}) \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,1)} & ={(4y(1+4{x}^{2}))|}_{(0,1)} \\\\  & =4(1)(1+4(0)^{2}) \\\\  & =4 \\\\  & >0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,1)}=0,\n$$\n\nwe obtain that $(0,1)$ is a stationary point of the function $f.$\n\n- Statement II is true. There is a critical point at $(0,1).$ So, according to the second derivative test, since\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,1)}>0,\n$$\n\nwe have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(0,1).$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186357441 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049383 :topic/id #uuid "f081dc8e-cc66-5491-a79c-ec9dc25a323b" :topic/math-academy-id 2976 :topic/title "Qualitative Analysis of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1d9da7c-a072-5f3b-af33-b2866c1d2152" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469566} {:answer/id #uuid "3d0d05c0-ca73-5a2e-985e-0892c66c1b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469567}] :answer-field/correct {:answer/id #uuid "3d0d05c0-ca73-5a2e-985e-0892c66c1b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469567} :answer-field/id #uuid "fabaf909-99d9-5a89-9004-1e924a5fdf93" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470395} {:answer-field/choices [{:answer/id #uuid "6a0548f0-1a15-5b3f-a6f2-8bb3444061c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469568} {:answer/id #uuid "bf535b84-3986-5327-8aa0-eab77a130dc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469569}] :answer-field/correct {:answer/id #uuid "6a0548f0-1a15-5b3f-a6f2-8bb3444061c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469568} :answer-field/id #uuid "587840e5-864f-5720-953f-25edd60903ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470396} {:answer-field/choices [{:answer/id #uuid "8ed10466-1946-5a24-8c37-950f6d68b65f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469570} {:answer/id #uuid "a39ac4dc-3a76-5f75-aeb1-e452c3bb0a9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469571}] :answer-field/correct {:answer/id #uuid "8ed10466-1946-5a24-8c37-950f6d68b65f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469570} :answer-field/id #uuid "90377193-212f-54e9-849e-664163a14855" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470397}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e18f8cd9-b1f2-5b99-9f93-cbb0a6aa2a95" :question/math-academy-id "q-89895" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{x}{y}.\n$$\n\nGiven that the point $(0,-3)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n- **I.** $(0,-3)$ is a stationary point of the function $f$\n- **II.** $(0,-3)$ is a local minimum point of the function $f$\n- **III.** $(0,-3)$ is an inflection point of the function $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(0,-3),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,-3)} & ={(\\frac{x}{y})|}_{(0,-3)} \\\\  & =\\frac{0}{(-3)} \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x}{y}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(x)\\cdot y-x\\cdot \\frac{\\text{d}}{\\text{d}x}(y)}{{y}^{2}} \\\\  & =\\frac{y-x\\cdot \\frac{\\text{d}y}{\\text{d}x}}{{y}^{2}} \\\\  & =\\frac{(y-x\\cdot \\frac{x}{y})}{{y}^{2}} \\\\  & =\\frac{(y-\\frac{{x}^{2}}{y})}{{y}^{2}} \\\\  & =\\frac{{y}^{2}-{x}^{2}}{{y}^{3}} \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,-3)} & ={(\\frac{{y}^{2}-{x}^{2}}{{y}^{3}})|}_{(0,-3)} \\\\  & =\\frac{(-3)^{2}-{0}^{2}}{(-3)^{3}} \\\\  & =-\\frac{1}{3} \\\\  & <0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,-3)}=0,\n$$\n\nwe obtain that $(0,-3)$ is a stationary point of the function $f.$\n\n- Statement II is false. There is a critical point at $(0,-3).$ So, according to the second derivative test, since\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,-3)}<0,\n$$\n\nwe have a local maximum (not a local minimum) at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(0,-3).$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186357454 :knowledge-point/_questions [{:db/id #edb/ref 17592186147592 :knowledge-point/id #uuid "fc7eacaa-2cf2-5cae-a40c-737c98124bcf" :knowledge-point/title "Determining the Degree of a Homogeneous Polynomial Using the Fast Method" :topic/_knowledge-points [{:db/id #edb/ref 17592186049922 :topic/id #uuid "1ecb929e-8b09-5ace-ac95-9f72f70c2772" :topic/math-academy-id 2536 :topic/title "Homogeneous Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d647a060-72ca-57fb-a5fe-eff8314c12e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469572} {:answer/id #uuid "25e97890-ed76-54f5-ba7f-87f260ab450e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469573}] :answer-field/correct {:answer/id #uuid "d647a060-72ca-57fb-a5fe-eff8314c12e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469572} :answer-field/id #uuid "4fcc0713-29f5-5278-903c-5e98e96e6154" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470398} {:answer-field/choices [{:answer/id #uuid "18d4cfaa-6627-5d83-97bb-7b6641e1f3c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469574} {:answer/id #uuid "b04306a9-85bc-550f-a326-d2233476b975" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469575}] :answer-field/correct {:answer/id #uuid "b04306a9-85bc-550f-a326-d2233476b975" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469575} :answer-field/id #uuid "2814b6ad-5c31-5eec-8fa4-71775f9ab65a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470399} {:answer-field/choices [{:answer/id #uuid "d62f14b6-d71c-5928-9c50-515e215671c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469576} {:answer/id #uuid "7eae1f5b-bb9f-5bc6-84fd-d054c84e24af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469577}] :answer-field/correct {:answer/id #uuid "7eae1f5b-bb9f-5bc6-84fd-d054c84e24af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469577} :answer-field/id #uuid "d880d005-a681-5f07-bca8-dd8df28b76ac" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a2bd93d-e29f-5907-89bd-df4c7adaca45" :question/math-academy-id "q-90582" :question/problem "Which of the following polynomials are homogeneous?\n- **I.** $f(y)={y}^{2}+y$\n- **II.** $g(x,y)={x}^{3}y+{y}^{4}$\n- **III.** $h(x,y,z)=xyz$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's go through each of the options.\n\n- The function $f(y)$  is not homogeneous. It is a polynomial of degree $2.$ However, it also contains a term ($y$) that is of degree $1.$ Therefore, not all of its terms are of degree $2.$\n\n- The function $g(x,y)$ is homogeneous of degree $4.$ It is a polynomial of degree $4,$ and all of its terms are of degree $4.$\n\n- The function $h(x,y,z)$ is homogeneous of degree $3.$ It is a polynomial of degree $3,$ with no terms of degree other than $3.$"} {:db/id #edb/ref 17592186357466 :knowledge-point/_questions [{:db/id #edb/ref 17592186152291 :knowledge-point/id #uuid "6302f81d-4834-56a5-b014-0a97c3dccd6f" :knowledge-point/title "Identifying True Statements About General Solutions of Second-Order Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050522 :topic/id #uuid "503f6e39-70fd-54b8-a04b-77e9fcd7b979" :topic/math-academy-id 2740 :topic/title "General Solutions of Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb85e8eb-30f1-5e30-88c6-2582220a10a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451893} {:answer/id #uuid "951c19d3-6d68-50a9-9a17-2c166c688f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451894}] :answer-field/correct {:answer/id #uuid "951c19d3-6d68-50a9-9a17-2c166c688f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451894} :answer-field/id #uuid "db880168-c319-51c9-8b78-70142c95d5ec" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452794} {:answer-field/choices [{:answer/id #uuid "b9432fd1-b127-528c-9c36-1845ecfb49e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451895} {:answer/id #uuid "a669c147-cbc3-57f4-b038-ac51d2ff09fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451896}] :answer-field/correct {:answer/id #uuid "a669c147-cbc3-57f4-b038-ac51d2ff09fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451896} :answer-field/id #uuid "050c8270-4795-5516-8572-0dd11186bc74" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452795} {:answer-field/choices [{:answer/id #uuid "b9611986-1e99-5e63-bd2e-d8b8e11bc95d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451897} {:answer/id #uuid "5642b8fb-b64d-532e-a7f5-75734f821b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451898}] :answer-field/correct {:answer/id #uuid "5642b8fb-b64d-532e-a7f5-75734f821b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451898} :answer-field/id #uuid "900c0ac8-9b40-5d86-815d-5a4462740f32" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452796}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd483d10-bcb0-5d3a-aec6-2a397c70d709" :question/math-academy-id "q-90699" :question/problem "Consider the differential equation ${y}^{″}+16y=0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${y}_{1}(x)=\\operatorname{cos}⁡4x$ is a solution to the equation.\n- **II.** ${y}_{2}(x)=\\operatorname{sin}⁡4x$ is a solution to the equation.\n- **III.** The general solution of the equation is $y=A\\operatorname{cos}⁡4x+B\\operatorname{sin}⁡4x.$" :question/worked-solution "Let's check each statement:\n\n- To determine whether ${y}_{1}(x)$ is a solution to the differential equation, we substitute ${y}_{1}$ and its derivatives into the equation.\n\nFirst, we find the first and second derivatives:\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-4\\operatorname{sin}⁡4x \\\\ {y}_{1}^{″}(x) & =-16\\operatorname{cos}⁡4x\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation. We get\n\n$$\n-16\\operatorname{cos}⁡4x+16(\\operatorname{cos}⁡4x)=0.\\,✓\n$$\n\nSo, ${y}_{1}$ is a solution to the equation, and therefore statement I is true.\n\n- Similarly, we compute the derivatives of ${y}_{2}$ and substitute to the equation. Computing the derivatives yields\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =4\\operatorname{cos}⁡4x \\\\ {y}_{2}^{″}(x) & =-16\\operatorname{sin}⁡4x.\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation. We get\n\n$$\n-16\\operatorname{sin}⁡4x+16(\\operatorname{sin}⁡4x)=0.\\,✓\n$$\n\nSo, ${y}_{2}$ is a solution to the equation, and therefore statement II is true.\n\n- So, both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian.\n\nThe Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =\\operatorname{cos}⁡4x{(\\operatorname{sin}⁡4x)}^{′}-{(\\operatorname{cos}⁡4x)}^{′}\\operatorname{sin}⁡4x \\\\  & =4\\operatorname{cos}⁡4x(\\operatorname{cos}⁡4x)-(-4\\operatorname{sin}⁡4x)\\operatorname{sin}⁡4x \\\\  & =4({cos}^{2}⁡4x+{sin}^{2}⁡4x) \\\\  & =4.\\end{aligned}\n$$\n\nSince the  Wronskian is not equal to $0,$ the functions are linearly independent, hence $y=A\\operatorname{cos}⁡4x+B\\operatorname{sin}⁡4x$  is the general solution.\n\nTherefore, statement III is true."} {:db/id #edb/ref 17592186357521 :knowledge-point/_questions [{:db/id #edb/ref 17592186092226 :knowledge-point/id #uuid "b0cbb889-0fe1-5347-94a3-53db3ff9a95c" :knowledge-point/title "Calculating the Vertices of a Polygon Given Its Image Under a Linear Transformation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049213 :topic/id #uuid "e3ec8239-fcb5-5753-aa06-6c1a1dcb3ccb" :topic/math-academy-id 988 :topic/title "Inverting Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b68ce632-6e8f-57d4-b15f-d3f5f26f9e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469578} {:answer/id #uuid "6d6e0fda-efae-56fd-bb3d-c94a991faf92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469579}] :answer-field/correct {:answer/id #uuid "6d6e0fda-efae-56fd-bb3d-c94a991faf92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469579} :answer-field/id #uuid "df23e6e6-a55c-54e2-84c5-3e8b3b8e7be2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470401} {:answer-field/choices [{:answer/id #uuid "6339a41a-de7b-5f72-bb5f-2cbd7c5ae565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469580} {:answer/id #uuid "2cc89e1b-573c-5ee0-910b-05fb7a358af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469581}] :answer-field/correct {:answer/id #uuid "2cc89e1b-573c-5ee0-910b-05fb7a358af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469581} :answer-field/id #uuid "89a003f5-318e-5c98-8b44-a32c95fbf50e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470402} {:answer-field/choices [{:answer/id #uuid "36d3017b-7ead-58ef-b9a2-bc9f8cf94b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469582} {:answer/id #uuid "0f3ea1c2-3ca2-588d-adaa-b40a57de928e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469583}] :answer-field/correct {:answer/id #uuid "36d3017b-7ead-58ef-b9a2-bc9f8cf94b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469582} :answer-field/id #uuid "6ed1ef14-e5f2-5b10-aa8a-4ea6c00242de" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0704d357-8cb1-56bb-b120-20ad34cf98ff" :question/math-academy-id "q-9253" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}.\n$$\n\nThe triangle $S$ is mapped to the triangle ${S}^{′}$ under the action of $T.$ The triangle ${S}^{′}$ has vertices $(-1,0),(1,0),$ and $(0,1).$ Which of the following are vertices of $S?$\n- **I.** $(1,0)$\n- **II.** $(-1,0)$\n- **III.** $(0,2)$\n\nSelect all that apply." :question/worked-solution "First, we create a matrix $Y$ containing all of the vertices of ${S}^{′}:$ \n\n$$\n\\begin{aligned}Y & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, if $X$ denotes the matrix that contains the corresponding vertices of $S$, we have\n\n$$\n\\begin{aligned}T\\cdot X & =Y \\\\ T\\cdot X & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot X & ={T}^{-1}\\cdot \\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\ X & ={T}^{-1}\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe inverse of $T$ is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{-2-0}\\begin{bmatrix}2 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}X & ={T}^{-1}\\cdot \\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 & 0 \\\\ 0 & 0 & \\frac{1}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nAs a result, the coordinates of the vertices of the original triangle are $(1,0),(-1,0),(0,\\frac{1}{2}).$\n\nTherefore, the correct answer is \"I and II only.\""}]
