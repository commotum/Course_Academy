efa-5a4a-ade1-f1d387399380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469147}] :answer-field/correct {:answer/id #uuid "12ad0d23-fc97-5563-94e1-04297c791316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469146} :answer-field/id #uuid "59b9344a-a635-53cb-9814-143c2865e5c4" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac020dea-1486-5e82-bd01-29594c8fbf7a" :question/math-academy-id "q-80300" :question/problem "Which of the numbers below belong to  ${R}_{0}^{+}?$\n- **I.** $0$\n- **II.** $\\sqrt{18}$\n- **III.** $-2\\sqrt{5}$\n- **IV.** $-\\frac{1}{5}$\n\nSelect all that apply." :question/worked-solution "Remember that ${R}_{0}^{+}$ is the set of all positive real numbers and $0.$\n\n- $0$ belongs to ${R}_{0}^{+}.\\,✓$\n\n- $\\sqrt{18}=3\\sqrt{2}$ belongs to ${R}_{0}^{+}.\\,✓$\n\n- $-2\\sqrt{5}$ is a negative number, so it does *not* belong to ${R}_{0}^{+}.\\,\\times $\n\n- $-\\frac{1}{5}$ is a negative number, so it does *not* belong to ${R}_{0}^{+}.\\,\\times $\n\nIn conclusion, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186348356 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial" :topic/_knowledge-points [{:db/id #edb/ref 17592186050601 :topic/id #uuid "577aebce-a9af-5bcd-867f-fb32f559c852" :topic/math-academy-id 2049 :topic/title "Graphing General Polynomials"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94576f3a-7505-5e82-8742-fc10ed1df957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438586} {:answer/id #uuid "a8f9186c-1904-505d-8ad2-b07742eb1ac5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438587}] :answer-field/correct {:answer/id #uuid "a8f9186c-1904-505d-8ad2-b07742eb1ac5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438587} :answer-field/id #uuid "26a32c20-5e0b-59c4-bfe0-2d15f0ff67ee" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439322} {:answer-field/choices [{:answer/id #uuid "fb5dfd74-6209-5cbf-8d97-d0393a1ef643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438588} {:answer/id #uuid "273c0fd4-33da-5ac8-a52a-c14d8af475a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438589}] :answer-field/correct {:answer/id #uuid "273c0fd4-33da-5ac8-a52a-c14d8af475a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438589} :answer-field/id #uuid "ed717c89-e36c-59e8-9a8e-732f62bdf119" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439323} {:answer-field/choices [{:answer/id #uuid "56631768-13be-53e4-b611-47a8df8226a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438590} {:answer/id #uuid "43d75997-d0a2-5964-a3fe-8f51550e1425" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438591}] :answer-field/correct {:answer/id #uuid "56631768-13be-53e4-b611-47a8df8226a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438590} :answer-field/id #uuid "9ac2e629-6749-5454-9eae-14b36d6d4ddf" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5211c5f5-64c4-596b-937a-7f0d7439b0b9" :question/math-academy-id "q-80302" :question/problem "![](images/1f/1f49d3448340c612269cdeea20680d717c736cb9a19fcf83dac86da1e4a6127f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $x=-1$ is a simple root.\n- **II.** $x=2$ is a root of odd multiplicity.\n- **III.** $x=2$ is a simple root." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. The root $x=-1$ is a simple root because the graph crosses the $x$-axis at the point and the curve is not tangent to the $x$-axis at that point.\n\n- Statement II is true. The root $x=2$ has an odd multiplicity because at $x=2$ the graph passes through the $x$-axis at this point.\n\n- Statement III is false. The root $x=2$ is not a simple root because the graph crosses the $x$-axis at that point, and the curve is tangent to the $x$-axis at that point.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186348357 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial" :topic/_knowledge-points [{:db/id #edb/ref 17592186050601 :topic/id #uuid "577aebce-a9af-5bcd-867f-fb32f559c852" :topic/math-academy-id 2049 :topic/title "Graphing General Polynomials"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04816dd6-eb04-553b-bb91-2bbf6d17c7fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438592} {:answer/id #uuid "3bb7e424-defa-5355-a5fa-690dfa6401ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438593}] :answer-field/correct {:answer/id #uuid "04816dd6-eb04-553b-bb91-2bbf6d17c7fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438592} :answer-field/id #uuid "a6fbfd71-3cc6-52d6-bfce-275be6d417ac" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439325} {:answer-field/choices [{:answer/id #uuid "f3adf3bf-fb96-5677-aebd-5ab8ed04e1d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438594} {:answer/id #uuid "b96096ae-9d01-5d3d-85bd-1eccbfd7db9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438595}] :answer-field/correct {:answer/id #uuid "b96096ae-9d01-5d3d-85bd-1eccbfd7db9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438595} :answer-field/id #uuid "1fc84e09-8159-5449-a7d7-63fbd891d974" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439326} {:answer-field/choices [{:answer/id #uuid "b0368b65-59db-5c7b-b7ac-a2fdfb20b33b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438596} {:answer/id #uuid "2eef1bc8-7a0f-5447-80e7-3bb55584157a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438597}] :answer-field/correct {:answer/id #uuid "b0368b65-59db-5c7b-b7ac-a2fdfb20b33b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438596} :answer-field/id #uuid "a1179f79-7e17-50ac-97d7-181447f0e79d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e0f13e6-ba4b-56eb-b269-f07bb6ae2732" :question/math-academy-id "q-80303" :question/problem "![](images/0a/0a7b19b50822235a2dcbfcdf74984735a1e26b2b775180b24bdc2bcbf24c588b.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $x=-2$ is a root of even multiplicity.\n\n- **II.** $x=1$ is **not** a simple root.\n\n- **III.** $x=1$ is a root of even multiplicity." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. The root $x=-2$ has an odd multiplicity because at $x=-2$ the graph passes through the $x$-axis at this point.\n\n- Statement II is true. The root $x=1$ is not a simple root because the graph crosses the $x$-axis at that point, and the curve is tangent to the $x$-axis at that point.\n\n- Statement III is false. The root $x=1$ has an odd multiplicity because at $x=1$ the graph passes through the $x$-axis at this point.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186348364 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fb1cc51-1db2-57b9-baf6-75de2e4cdec8" :answer/type {:db/id #edb/ref 17592186045499 :db/id