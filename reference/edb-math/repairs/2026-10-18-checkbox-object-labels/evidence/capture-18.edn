186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469174} {:answer/id #uuid "f09b763a-c7bc-5367-8d39-02bde657298d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469175}] :answer-field/correct {:answer/id #uuid "f09b763a-c7bc-5367-8d39-02bde657298d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469175} :answer-field/id #uuid "8f2d2542-34d9-5aad-8c2b-6cdc8e453ad3" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470199}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4eae16cb-f514-5e15-a012-1e904a842a1d" :question/math-academy-id "q-80338" :question/problem "Which of the numbers below belong to  ${Z}_{0}^{-}?$\n- **I.** $-15$\n- **II.** $0$\n- **III.** $-\\pi $\n- **IV.** $-\\frac{27}{3}$\n\nSelect all that apply." :question/worked-solution "Remember that ${Z}_{0}^{-}$ is the set of all negative integer numbers and $0.$\n\n- $-15$ belongs to ${Z}_{0}^{-}.\\,✓$\n\n- $0$ belongs to ${Z}_{0}^{-}.\\,✓$\n\n- $-\\pi $ is not an integer, so it does *not* belong to ${Z}_{0}^{-}.\\,\\times $\n\n- $-\\frac{27}{3}=-9$ belongs to ${Z}_{0}^{-}.\\,✓$\n\nIn conclusion, the correct answer is \"I, II, and IV only\"."} {:db/id #edb/ref 17592186348397 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality" :topic/_knowledge-points [{:db/id #edb/ref 17592186048613 :topic/id #uuid "aeb25c88-ca51-51cd-bde9-b35abbd14a79" :topic/math-academy-id 2102 :topic/title "Orthogonal Complements"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c9f468c-1750-5557-b4d9-477b106b9700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451765} {:answer/id #uuid "7b5ed1ca-61a7-5c3f-84c9-e8c7187a10a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451766}] :answer-field/correct {:answer/id #uuid "5c9f468c-1750-5557-b4d9-477b106b9700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451765} :answer-field/id #uuid "58657487-e33d-5c65-ac8f-e019d9b9c99d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452730} {:answer-field/choices [{:answer/id #uuid "526bdff9-2408-5f46-adb2-9a4f67d9562d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451767} {:answer/id #uuid "634eae55-4b1e-560a-850d-db46662c5fde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451768}] :answer-field/correct {:answer/id #uuid "526bdff9-2408-5f46-adb2-9a4f67d9562d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451767} :answer-field/id #uuid "e70e65c2-7b73-5bc1-bc0c-3f1dfbd87c32" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452731} {:answer-field/choices [{:answer/id #uuid "e11cafb1-3ead-5836-82a6-f45ab62b7ea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451769} {:answer/id #uuid "cce094ce-f460-5440-8e4a-16827a1c23cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451770}] :answer-field/correct {:answer/id #uuid "cce094ce-f460-5440-8e4a-16827a1c23cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451770} :answer-field/id #uuid "d37b9328-c0b1-5e02-ae8a-023a631ce3f3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452732}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71fa7ac3-736d-581b-993c-ae19335288bd" :question/math-academy-id "q-80500" :question/problem "For the vector $u=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $u$ is orthogonal to the set $H={\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ -1 \\\\ -1\\end{bmatrix}}$\n- **II.** $u$ is orthogonal to the set $V={\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}}$\n- **III.** $u$ is orthogonal to the set $W={\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ -1 \\\\ -1\\end{bmatrix}}$" :question/worked-solution "Let's denote the vectors of $H,V$ and $W$ as ${{h}_{1},{h}_{2}},{{v}_{1},{v}_{2},{v}_{3}}$ and ${{w}_{1},{w}_{2}}$, respectively. \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $H:$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =1\\cdot (-1)+(-1)\\cdot 1+2\\cdot 0=-2 & \\times \\end{aligned}\n$$\n\nSo, $u$ is not orthogonal to the set $H.$ Notice that we stopped after finding the first non-orthogonal vector in the set.\n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =1\\cdot 1+(-1)\\cdot 1+2\\cdot 0=0 & ✓ \\\\ u\\cdot {v}_{2} & =1\\cdot 1+(-1)\\cdot (-2)+2\\cdot (-1)=1\\ne 0 &  & \\times \\end{aligned}\n$$\n\n \nSo, $u$ is not orthogonal to the set $H.$ Notice that, again,  we stopped after finding the first non-orthogonal vector in the set.\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =1\\cdot 1+(-1)\\cdot 1+2\\cdot 0=0 & ✓ \\\\ u\\cdot {w}_{2} & =1\\cdot 1+(-1)\\cdot (-1)+2\\cdot (-1)=0 & ✓\\end{aligned}\n$$\n\nSo, $u$ is orthogonal to the set $W.$\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186348398 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality" :topic/_knowledge-points [{:db/id #edb/ref 17592186048613 :topic/id #uuid "aeb25c88-ca51-51cd-bde9-b35abbd14a79" :topic/math-academy-id 2102 :topic/title "Orthogonal Complements"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1006d03-987d-5615-a6ab-8d64898d5ec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451771} {:answer/id #uuid "695f2e95-1318-59d6-a077-9f1e1beb327f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451772}] :answer-field/correct {:answer/id #uuid "b1006d03-987d-5615-a6ab-8d64898d5ec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451771} :answer-field/id #uuid "0421716a-fc5c-56e6-b389-5c15cd035691" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452733} {:answer-field/choices [{:answer/id #uuid "3170806d-e0e9-5828-8683-3427ff199255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451773} {:answer/id #uuid "ba277f55-102b-59a9-893d-62a35df26c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451774}] :answer-field/correct {:answer/id #uuid "3170806d-e0e9-5828-8683-3427ff199255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451773} :answer-field/id #uuid "64e95e72-0d21-5133-8158-31f7082721d4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452734} {:answer-field/choices [{:answer/id #uuid "0982a10d-b182-53f8-8914-0e0ca2114545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451775} {:answer/id #uuid "8834f5af-13c3-5c07-9588-dac6f623d1e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451776}] :answer-field/correct {:answer/id #uuid "8834f5af-13c3-5c07-9588-dac6f623d1e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451776} :answer-field/id #uuid "263cce7d-9ea5-5c9f-a659-5905800d7383" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452735}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9dd8ae6e-23af-5ad8-bbc1-dab1f1e56a2b" :question/math-academy-id "q-80501" :question/problem "For the vector $u=\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $u⊥H,\\,$ where $H={\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix},\\begin{bmatrix}-1 \\\\ -1 \\\\ 1\\end{bmatrix}}$\n- **II.** $u⊥V,\\,$ where $V={\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}}$\n- **III.** $u⊥W,\\,$ where $W={\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}}$" :question/worked-solution "Let's denote the vectors of $H,V$ and $W$ as ${{h}_{1},{h}_{2}},{{v}_{1},{v}_{2}}$ and ${{w}_{1},{w}_{2}}$, respectively. \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $H:$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =2\\cdot 1+1\\cdot 2+(-2)\\cdot 2=0 & ✓ \\\\ u\\cdot {h}_{2} & =2\\cdot (-1)+1\\cdot (-1)+(-2)\\cdot 1=-5\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸H.$\n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =2\\cdot 3+1\\cdot (-2)+(-2)\\cdot 1=2\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸V.$ Notice that we stopped after finding the first non-orthogonal vector in the set.\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =2\\cdot (-1)+1\\cdot (-2)+(-2)\\cdot (-2)=0 & ✓ \\\\ u\\cdot {w}_{2} & =2\\cdot 2+1\\cdot (-2)+(-2)\\cdot 1=0 & ✓\\end{aligned}\n$$\n\nSo, $u⊥W.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186348399 :knowledge-point/_questions [{:db/id #edb/ref 17592186152199 :knowledge-point/id #uuid "624215ff-efdc-5b12-8d61-9d66371672d9" :knowledge-point/title "Determining a Valid Region to Define a Double Integral Over a Non-Rectangular Domain" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3121940b-6ae2-5edb-93dd-8955ea45f620" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469176} {:answer/id #uuid "a8473e52-f975-58d9-8acc-9eee2154881f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469177}] :answer-field/correct {:answer/id #uuid "3121940b-6ae2-5edb-93dd-8955ea45f620" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469176} :answer-field/id #uuid "2e8ffaeb-d1f8-5c59-aa14-8e3428d03263" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470200} {:answer-field/choices [{:answer/id #uuid "aaa056d7-22c4-5bd6-bc95-d6e606091fdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469178} {:answer/id #uuid "f676c8fd-6553-5e16-9c6b-86dd3331696c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469179}] :answer-field/correct {:answer/id #uuid "f676c8fd-6553-5e16-9c6b-86dd3331696c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469179} :answer-field/id #uuid "7ead8a7a-6bc3-512e-9688-1520aabca85d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470201} {:answer-field/choices [{:answer/id #uuid "415ce60d-0aeb-52ab-b00c-266f5a6ab314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469180} {:answer/id #uuid "072e111f-5eda-5805-a70b-f5ed6a11e655" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469181}] :answer-field/correct {:answer/id #uuid "415ce60d-0aeb-52ab-b00c-266f5a6ab314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469180} :answer-field/id #uuid "e4e75227-e726-5e2c-8e15-ba11029ee612" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fdfb4105-c8ab-5347-92cf-89faf417f305" :question/math-academy-id "q-80503" :question/problem "![](images/9d/9d4a0a08513d817fe841f1e45e5d363d6e64241837dea71f38aef452f86b08a7.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)={\\begin{aligned}\\frac{3{y}^{2}}{x}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}\\frac{3{y}^{2}}{x}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\n- $R=[0,1]\\times [-1,1]$\n- $R=[0,2]\\times [-1,1]$\n- $R=[0,2]\\times [0,1]$\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}\\frac{3{y}^{2}}{x}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}\\frac{3{y}^{2}}{x}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangles I and III do not cover the region $D.$\n\n- Rectangle II covers the region $D$ completely.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186348400 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality" :topic/_knowledge-points [{:db/id #edb/ref 17592186048613 :topic/id #uuid "aeb25c88-ca51-51cd-bde9-b35abbd14a79" :topic/math-academy-id 2102 :topic/title "Orthogonal Complements"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312df5d6-281e-56fd-a46d-7485467ca5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451777} {:answer/id #uuid "babe9d23-88f3-56f2-814c-9507447d4ab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451778}] :answer-field/correct {:answer/id #uuid "312df5d6-281e-56fd-a46d-7485467ca5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451777} :answer-field/id #uuid "029752c3-7fde-5f28-b7eb-a4fea5bce378" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452736} {:answer-field/choices [{:answer/id #uuid "4df2d205-8c5b-5cec-bbd3-885a0f1691e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451779} {:answer/id #uuid "3735a332-dc9e-5d8a-a60c-598bbb7bc17f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451780}] :answer-field/correct {:answer/id #uuid "3735a332-dc9e-5d8a-a60c-598bbb7bc17f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451780} :answer-field/id #uuid "d1fd1e69-2a3e-5868-9491-80bc41d75df3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452737} {:answer-field/choices [{:answer/id #uuid "4353a428-e14a-512c-81f1-4c17e504aaa9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451781} {:answer/id #uuid "d2c5a85c-c313-5c62-9a6e-e90bd11143f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451782}] :answer-field/correct {:answer/id #uuid "4353a428-e14a-512c-81f1-4c17e504aaa9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451781} :answer-field/id #uuid "31de0e96-2740-506a-a2bc-a19fe0e2615f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452738}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae7d6615-4d14-5d13-9805-7d20838b8a36" :question/math-academy-id "q-80504" :question/problem "For the vector $u=\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix}$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $u$ is orthogonal to the set $V={\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix}}$\n- **II.** $u$ is orthogonal to the set $H={\\begin{bmatrix}2 \\\\ 2 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-1 \\\\ -1 \\\\ 1\\end{bmatrix}}$\n- **III.** $u$ is orthogonal to the set $W={\\begin{bmatrix}-2 \\\\ -3 \\\\ 4\\end{bmatrix},\\begin{bmatrix}1 \\\\ -5 \\\\ 3\\end{bmatrix}}$" :question/worked-solution "Let's denote the vectors of $V,H$- and $W$ as ${{v}_{1},{v}_{2},{v}_{3}},{{h}_{1},{h}_{2}}$ and ${{w}_{1},{w}_{2}}$, respectively. \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =3\\cdot 1+(-2)\\cdot 1+1\\cdot (-1)=0\\,✓ \\\\ u\\cdot {v}_{2} & =3\\cdot 2+(-2)\\cdot 2+1\\cdot 3=5\\ne 0\\,\\times \\end{aligned}\n$$\n\nSo, $u$ is not orthogonal to the set $V.$ Notice that we stopped after finding the first non-orthogonal vector in the set.\n\n- For the set $H:$ \n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =3\\cdot 2+(-2)\\cdot 2+1\\cdot (-2)=0,\\,✓ \\\\ u\\cdot {h}_{2} & =3\\cdot (-1)+(-2)\\cdot (-1)+1\\cdot 1=0\\,✓\\end{aligned}\n$$\n\nSo, $u$ is orthogonal to the set $H.$\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =3\\cdot (-2)+(-2)\\cdot (-3)+1\\cdot 4=4\\ne 0\\,\\times \\end{aligned}\n$$\n\nSo, $u$ is not orthogonal to the set $W.$ Notice that we stopped after finding the first non-orthogonal vector in the set.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186348410 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed782008-d4bb-582f-8807-d4b2a836e6be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469182} {:answer/id #uuid "3c54d1e7-ad86-5f47-bd24-54748f29d4fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469183}] :answer-field/correct {:answer/id #uuid "3c54d1e7-ad86-5f47-bd24-54748f29d4fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469183} :answer-field/id #uuid "64ff9acc-15fa-5b35-b5c4-b8f3bf78db99" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470203} {:answer-field/choices [{:answer/id #uuid "50e43c3e-49bc-5747-bc7d-86c7f947be32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469184} {:answer/id #uuid "fb0c42e5-292e-59b3-96a8-e42c0ec855e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469185}] :answer-field/correct {:answer/id #uuid "50e43c3e-49bc-5747-bc7d-86c7f947be32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469184} :answer-field/id #uuid "5bb45f02-d2af-5280-a109-2bf63fa0482d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470204} {:answer-field/choices [{:answer/id #uuid "89749230-2ffe-51eb-8434-4cccec8af5aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469186} {:answer/id #uuid "95c596d5-e2a4-574b-bae8-8587629e2bba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469187}] :answer-field/correct {:answer/id #uuid "95c596d5-e2a4-574b-bae8-8587629e2bba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469187} :answer-field/id #uuid "07159f59-7f7d-59a7-b2fb-4d5e3b43d7d4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470205}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b7813ca-41d9-58f5-aaf1-c07ba10ad235" :question/math-academy-id "q-80540" :question/problem "![](images/50/506a298041a875549ec60c5cf99ebdbeb5ca4b5717037083fa6ca196fce27279.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [0,3],$ and\n\n$$\n{∬}_{D}\\frac{2x+y}{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}0, & (x,y)\\in R \\\\ \\frac{2x+y}{y}, & (x,y)\\in D∖R\\end{aligned}$\n\nIII. $\\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/d2/d2b5c55b15f594680e8f299899d690cd1d92baa1ebef31ce5c79af52afec631e.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\frac{2x+y}{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}\\frac{2x+y}{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use function II. Since $D∖R$ is empty, the function $f(x,y)$ will be identical to zero for all points in $R,$ including $D.$ But $\\frac{2x+y}{y}$ is not zero, for example, at $(x,y)=(0,2)\\in D.$\n\n- Functions I and III equals $\\frac{2x+y}{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436029} :db/id #edb/ref 17592186436045}]} {:db/id #edb/ref 17592186348412 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d4722f-ca99-5a82-9a0e-d4df7cc199ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469188} {:answer/id #uuid "86d93ef6-b705-5b2f-9377-64be6529a5e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469189}] :answer-field/correct {:answer/id #uuid "81d4722f-ca99-5a82-9a0e-d4df7cc199ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469188} :answer-field/id #uuid "139fbd62-63d3-5ea0-9351-3722ad6548ac" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186