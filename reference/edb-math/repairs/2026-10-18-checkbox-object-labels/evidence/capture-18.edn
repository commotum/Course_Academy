id #edb/ref 17592186469444} {:answer/id #uuid "0bbd1552-1f4e-52a4-a141-e1fb530579a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469445}] :answer-field/correct {:answer/id #uuid "8546fa73-dcec-50dc-974d-858421123cff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469444} :answer-field/id #uuid "00caafb1-473f-5b30-8fec-fff060993a90" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470334}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b045a52-4215-5bdb-9dcf-5641984e3591" :question/math-academy-id "q-86898" :question/problem "Let $D$ be a finite region enclosed by the curves $y={x}^{2}-1$ and $y=|x|.$ If $R=[-2,2]\\times [-1,2],$ and\n\n$$\n{∬}_{D}\\frac{y}{{x}^{2}+1}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/23/23f31619eda46f1e8604695c4056d4c0c5bb8ee1e186b1316151762d5b5c8e59.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\frac{y}{{x}^{2}+1}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}\\frac{y}{{x}^{2}+1}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal $\\frac{y}{{x}^{2}+1}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(0,1)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425910} :db/id #edb/ref 17592186425935}]} {:db/id #edb/ref 17592186354533 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6df4441-21a2-5303-8fb5-58f8fecb14ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469446} {:answer/id #uuid "ee618263-9395-5352-9720-a6eec6d6ed5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469447}] :answer-field/correct {:answer/id #uuid "ee618263-9395-5352-9720-a6eec6d6ed5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469447} :answer-field/id #uuid "4a0c311d-a059-5cd2-bbd6-64c976dac562" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470335} {:answer-field/choices [{:answer/id #uuid "7bc24ece-33bb-5946-a1eb-10980a715793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469448} {:answer/id #uuid "304554bf-f809-5b6e-b9f7-a303c9a307fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469449}] :answer-field/correct {:answer/id #uuid "304554bf-f809-5b6e-b9f7-a303c9a307fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469449} :answer-field/id #uuid "31ed207a-f15c-5448-a440-49246efdf212" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470336} {:answer-field/choices [{:answer/id #uuid "e440f0a5-215d-5ce7-9d8c-a7d55e01e51a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469450} {:answer/id #uuid "edbee4f2-6785-5059-828c-aec5fd26b060" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469451}] :answer-field/correct {:answer/id #uuid "e440f0a5-215d-5ce7-9d8c-a7d55e01e51a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469450} :answer-field/id #uuid "d9570c66-92e3-5a9c-83b5-c9049f7f004a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470337}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa4fe275-03b1-57bc-8327-4434c307d887" :question/math-academy-id "q-86899" :question/problem "Let $D$ be a finite region enclosed by the curves $y=-|x|+2$ and $y=|x|.$ If $R=[-1,1]\\times [0,2],$ and\n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/f3/f3ffc82025f80c357c06e28fcb091c701d53d84821bebd9d2886cf4972b77028.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${x}^{5}-{y}^{2}$ on $D$ and to be equal $0$ outside $D,$ we obtain  \n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\n \n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal ${x}^{5}-{y}^{2}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,0)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425910} :db/id #edb/ref 17592186425933}]} {:db/id #edb/ref 17592186354550 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context" :topic/_knowledge-points [{:db/id #edb/ref 17592186049638 :topic/id #uuid "0748b9c2-fae7-5522-9655-db9e6f1d50c0" :topic/math-academy-id 1347 :topic/title "Probability Density Functions of Continuous Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eb51b24-6ed3-57a9-9e8c-ba8ebf824581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469452} {:answer/id #uuid "97efc1af-d4f2-5893-a5d1-ab08ee6e241d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469453}] :answer-field/correct {:answer/id #uuid "4eb51b24-6ed3-57a9-9e8c-ba8ebf824581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469452} :answer-field/id #uuid "a7828160-c717-5cde-a95f-9124fb5c67a4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470338} {:answer-field/choices [{:answer/id #uuid "c352f376-33ce-551c-a4d8-4ee590f980b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469454} {:answer/id #uuid "89a0a2b2-eaa8-5561-8b73-f90f123d705f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469455}] :answer-field/correct {:answer/id #uuid "89a0a2b2-eaa8-5561-8b73-f90f123d705f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469455} :answer-field/id #uuid "bed94909-ceb5-5280-a135-7b7a3b9fc13c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470339} {:answer-field/choices [{:answer/id #uuid "ed844f4b-04af-5322-a4c2-2fad5ffea508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469456} {:answer/id #uuid "a6264200-edb2-5ecd-99cc-83dd60044121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469457}] :answer-field/correct {:answer/id #uuid "a6264200-edb2-5ecd-99cc-83dd60044121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469457} :answer-field/id #uuid "b960eae6-efa4-5d76-9185-52b5574fa7fb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72b0b871-668d-5ed4-92c2-5e17bf34749d" :question/math-academy-id "q-87151" :question/problem "Which of the following are continuous random variables?\n- **I.** The number of heads obtained when a coin is flipped twice\n- **II.** The height of a randomly selected person, measured in meters\n- **III.** The concentration, in grams per cubic centimeter, of glucose in a person's bloodstream\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I does *not* describe a continuous random variable. Its value is determined by the result of an experiment, but its possible values are the integers $0,1,2,$ which do not correspond to an interval of real numbers.\n\n- Statement II describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $(0,\\infty ).$\n\n- Statement III describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $[0,\\infty ).$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186354551 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context" :topic/_knowledge-points [{:db/id #edb/ref 17592186049638 :topic/id #uuid "0748b9c2-fae7-5522-9655-db9e6f1d50c0" :topic/math-academy-id 1347 :topic/title "Probability Density Functions of Continuous Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c488712-aae8-5dd2-ba5d-0f68bced72a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469458} {:answer/id #uuid "d1d53544-242d-510c-b825-c7e932a011d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469459}] :answer-field/correct {:answer/id #uuid "d1d53544-242d-510c-b825-c7e932a011d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469459} :answer-field/id #uuid "8acbd464-38c6-5126-bb9d-207e52352666" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470341} {:answer-field/choices [{:answer/id #uuid "ddb68d9d-4d59-5c43-a359-3bfdb0e274ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469460} {:answer/id #uuid "fe006bad-4bf6-544b-8ebd-35d614865e08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469461}] :answer-field/correct {:answer/id #uuid "ddb68d9d-4d59-5c43-a359-3bfdb0e274ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469460} :answer-field/id #uuid "6e328239-ddbb-5d19-93cf-2cb2e1560efc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470342} {:answer-field/choices [{:answer/id #uuid "2c341e08-6975-5bab-ba35-ee65caf3a79e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469462} {:answer/id #uuid "8844e4ff-3a8a-5db5-b223-d23d0a5524d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469463}] :answer-field/correct {:answer/id #uuid "8844e4ff-3a8a-5db5-b223-d23d0a5524d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469463} :answer-field/id #uuid "77358968-36d5-545e-96e6-3ea3ac2aef40" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470343}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d1bc0bc-e996-5273-b3cb-33c77433dc02" :question/math-academy-id "q-87153" :question/problem "Which of the following are continuous random variables?\n- **I.** The amount of water per month consumed by a randomly selected person\n- **II.** The number of pages in a particular book\n- **III.** The amount of time that a randomly selected person spends waiting for a particular bus\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $[0,\\infty ).$\n\n- Statement II does *not* describe a continuous random variable. The number of pages in a particular book is not the outcome of a trial or experiment.\n\n- Statement III describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $[0,\\infty ).$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186354552 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context" :topic/_knowledge-points [{:db/id #edb/ref 17592186049638 :topic/id #uuid "0748b9c2-fae7-5522-9655-db9e6f1d50c0" :topic/math-academy-id 1347 :topic/title "Probability Density Functions of Continuous Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a01e7f20-78b9-551e-ac72-b8cf14030f1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469464} {:answer/id #uuid "cc8073c0-31e6-5933-bae0-fbcc148e1598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469465}] :answer-field/correct {:answer/id #uuid "a01e7f20-78b9-551e-ac72-b8cf14030f1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469464} :answer-field/id #uuid "759ebed1-eb69-55b2-b7b0-6401213e02d4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/