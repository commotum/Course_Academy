186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470171} {:answer-field/choices [{:answer/id #uuid "4f920bbd-9273-58b0-886f-3ee7ba08f9b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469120} {:answer/id #uuid "ab628a4f-22fe-5a7e-a167-3ab00a3fbd98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469121}] :answer-field/correct {:answer/id #uuid "4f920bbd-9273-58b0-886f-3ee7ba08f9b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469120} :answer-field/id #uuid "8d770fd8-7ca8-5dfc-970f-69a91d10d56f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470172}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f36feb8-418f-5686-b06d-68d66e729361" :question/math-academy-id "q-79830" :question/problem "Given that ${y}_{1}(x)={x}^{2}$ is a solution to the equation ${x}^{2}{y}^{″}+x{y}^{′}-4y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)=3{x}^{4}$\n- **II.** $y(x)=-{x}^{2}$\n- **III.** $y(x)={x}^{2}\\operatorname{ln}⁡x$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=3{x}^{4}$ is **not** guaranteed to be a solution of the equation by the superposition principle because $y(x)={x}^{4}$ is not a solution.\n\n- The function $y(x)=-{x}^{2}$ is a solution of the equation by the superposition principle. In this case, $c=-1.$\n\n- The function $y(x)={x}^{2}\\operatorname{ln}⁡x$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186348298 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050032 :topic/id #uuid "277bf882-73ab-515e-84e5-4f7920acb235" :topic/math-academy-id 2549 :topic/title "The Superposition Principle"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ee4ccfe-48a1-5503-bdd7-94f3af47d78a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469122} {:answer/id #uuid "8714213f-f09f-5e30-9031-11bcdb9ab47a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469123}] :answer-field/correct {:answer/id #uuid "1ee4ccfe-48a1-5503-bdd7-94f3af47d78a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469122} :answer-field/id #uuid "3a1e4d4c-633e-5331-b3f7-d5aaf02bfd77" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470173} {:answer-field/choices [{:answer/id #uuid "d82a3694-1df9-5833-b2fb-dfc08639463c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469124} {:answer/id #uuid "0bdb4ca9-24e2-5a47-b2b6-85078ecb5438" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469125}] :answer-field/correct {:answer/id #uuid "d82a3694-1df9-5833-b2fb-dfc08639463c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469124} :answer-field/id #uuid "8f1a73f8-072a-5abb-8821-3b61b53760d6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470174} {:answer-field/choices [{:answer/id #uuid "a346c91f-3898-593d-9e99-808fa408d748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469126} {:answer/id #uuid "91bf1394-4391-58fa-bd1a-06047a845664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469127}] :answer-field/correct {:answer/id #uuid "91bf1394-4391-58fa-bd1a-06047a845664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469127} :answer-field/id #uuid "4e543d23-a589-5f66-84cd-c6970901bae1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2273f6bc-da9e-5824-b9ba-6b0ea3f200d5" :question/math-academy-id "q-79832" :question/problem "Given that ${y}_{1}(x)={x}^{-5}$ is a solution to the equation ${x}^{2}{y}^{″}+5x{y}^{′}-5y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)={x}^{-5}\\operatorname{ln}⁡x$\n- **II.** $y(x)=5{x}^{-4}$\n- **III.** $y(x)=-{x}^{-5}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)={x}^{-5}\\operatorname{ln}⁡x$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\n- The function $y(x)=5{x}^{-4}$ is **not** guaranteed to be a solution of the equation by the superposition principle because $y={x}^{-4}$ is not a solution.\n\n- The function $y(x)=-{x}^{-5}$ is a solution of the equation by the superposition principle. In this case, $c=-1.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186348299 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050032 :topic/id #uuid "277bf882-73ab-515e-84e5-4f7920acb235" :topic/math-academy-id 2549 :topic/title "The Superposition Principle"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6a361cd-ab6f-5384-81cc-6b0fb3643c85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469128} {:answer/id #uuid "0bafe13e-f37f-51fc-8cb5-4c78b27cbf3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469129}] :answer-field/correct {:answer/id #uuid "0bafe13e-f37f-51fc-8cb5-4c78b27cbf3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469129} :answer-field/id #uuid "93cbeab5-b615-5386-b857-11fb77fddda3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470176} {:answer-field/choices [{:answer/id #uuid "d8830df0-4dbc-57dc-bde3-ebd6e7d721a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469130} {:answer/id #uuid "5a9066c3-cccf-5001-a14a-957a8ae8c755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469131}] :answer-field/correct {:answer/id #uuid "5a9066c3-cccf-5001-a14a-957a8ae8c755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469131} :answer-field/id #uuid "5f73adb4-4499-5195-82f8-ad71528055ca" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470177} {:answer-field/choices [{:answer/id #uuid "14470ea3-f8b2-5e94-a980-c1f2268cfef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469132} {:answer/id #uuid "88bebeba-766e-56d3-af5c-1bb82699777e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469133}] :answer-field/correct {:answer/id #uuid "14470ea3-f8b2-5e94-a980-c1f2268cfef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469132} :answer-field/id #uuid "db56fad5-3569-5509-8082-acc93b3f2dd9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470178}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "60c58de3-1420-5803-8b3d-664cd468fc15" :question/math-academy-id "q-79833" :question/problem "Given that ${y}_{1}(x)={e}^{-6x}$ is a solution to the equation ${y}^{″}+5{y}^{′}-6y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)=2{e}^{-6x}$\n- **II.** $y(x)={e}^{3-6x}$\n- **III.** $y(x)=-{e}^{6x}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=2{e}^{-6x}$ is a solution of the equation by the superposition principle. In this case, $c=2.$\n\n- The function $y(x)={e}^{3-6x}={e}^{3}\\cdot {e}^{-6x}$ is a solution of the equation by the superposition principle. In this case, $c={e}^{3}.$\n\n- The function $y(x)=-{e}^{6x}$ is **not** guaranteed to be a solution of the equation by the superposition principle because $y={e}^{6x}$ is not a solution.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186348312 :knowledge-point/_questions [{:db/id #edb/ref 17592186152291 :knowledge-point/id #uuid "6302f81d-4834-56a5-b014-0a97c3dccd6f" :knowledge-point/title "Identifying True Statements About General Solutions of Second-Order Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050522 :topic/id #uuid "503f6e39-70fd-54b8-a04b-77e9fcd7b979" :topic/math-academy-id 2740 :topic/title "General Solutions of Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7570e3d-575a-53ae-b8a8-f38567dd5f67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451759} {:answer/id #uuid "6a94344d-679e-53eb-a314-dbd682508d6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451760}] :answer-field/correct {:answer/id #uuid "6a94344d-679e-53eb-a314-dbd682508d6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451760} :answer-field/id #uuid "6cac5207-2e26-5568-942f-86862d63daeb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452727} {:answer-field/choices [{:answer/id #uuid "a7f0c9f7-0402-5153-a0b1-122f69f189bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451761} {:answer/id #uuid "87688b5e-8c4f-5df9-8fe4-74a28e2626b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451762}] :answer-field/correct {:answer/id #uuid "87688b5e-8c4f-5df9-8fe4-74a28e2626b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451762} :answer-field/id #uuid "2ab8e285-5d80-5832-a834-3288e7c3d6ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452728} {:answer-field/choices [{:answer/id #uuid "7bba18c2-f91a-5e2e-ba0a-2d83da494501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451763} {:answer/id #uuid "c0839935-7605-5c99-afdd-d828e290b557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451764}] :answer-field/correct {:answer/id #uuid "7bba18c2-f91a-5e2e-ba0a-2d83da494501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451763} :answer-field/id #uuid "2ec233c5-5e09-59b8-9599-d16f1338842d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "435df6d1-711b-52a7-a1be-e3012765e1bb" :question/math-academy-id "q-79930" :question/problem "Consider the differential equation ${y}^{″}+2{y}^{′}+y=0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${y}_{1}(x)={e}^{-t}$ is a solution to the equation.\n- **II.** ${y}_{2}(x)={e}^{1-t}$ is a solution to the equation.\n- **III.** The general solution of the equation is $y=A{e}^{-t}+B{e}^{1-t}.$" :question/worked-solution "Let's check each statement:\n\n- To determine whether ${y}_{1}(t)$ is a solution to the differential equation, we substitute ${y}_{1}$ and its derivatives into the equation.\n\nFirst, we find the first and second derivatives:\n\n$$\n\\begin{aligned}{y}_{1}^{′}(t) & =-{e}^{-t} \\\\ {y}_{1}^{″}(x) & ={e}^{-t}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation. We get\n\n$$\n\\begin{aligned}{e}^{-t}+2(-{e}^{-t})+{e}^{-t} & =(1-2+1){e}^{-t}=0.\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}$ is a solution to the equation, and therefore statement I is true.\n\n- Similarly, we compute the derivatives of ${y}_{2}$ and substitute to the equation. Computing the derivatives yields\n\n$$\n\\begin{aligned}{y}_{2}^{′}(t) & =-{e}^{1-t} \\\\ {y}_{2}^{″}(x) & ={e}^{1-t}.\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation. We get\n\n$$\n\\begin{aligned}{e}^{1-t}+2(-{e}^{1-t})+{e}^{1-t} & =(1-2+1){e}^{1-t}=0.\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}$ is a solution to the equation, and therefore statement II is true.\n\n- So, both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian.\n\nThe Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & ={e}^{-t}{({e}^{1-t})}^{′}-{({e}^{-t})}^{′}{e}^{1-t} \\\\  & ={e}^{-t}(-{e}^{1-t})-(-{e}^{-t}){e}^{1-t} \\\\  & =-{e}^{1-2t}+{e}^{1-2t} \\\\  & =0.\\end{aligned}\n$$\n\nSince the  Wronskian equals $0,$ the functions are not linearly independent, hence $y=A{e}^{-t}+B{e}^{1-t}$  is not the general solution.\n\nTherefore, statement III is false."} {:db/id #edb/ref 17592186348353 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048459 :topic/id #uuid "a163637a-ed19-547a-85e8-0acfdb20fa0f" :topic/math-academy-id 865 :topic/title "Introduction to Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9bdc7e-42c3-53cc-a18e-22ffa2e86bb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469134} {:answer/id #uuid "361c69af-6a32-5d90-a2fa-6b0197287d40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469135}] :answer-field/correct {:answer/id #uuid "361c69af-6a32-5d90-a2fa-6b0197287d40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469135} :answer-field/id #uuid "cd53690d-e07b-5da6-966c-bd269499edd7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470179} {:answer-field/choices [{:answer/id #uuid "23c74a53-044d-57cf-83b8-d90c2e0538e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469136} {:answer/id #uuid "13abf251-50ed-5e34-bf36-94c66ecbad57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469137}] :answer-field/correct {:answer/id #uuid "13abf251-50ed-5e34-bf36-94c66ecbad57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469137} :answer-field/id #uuid "f9eab1d5-593a-5a4b-9714-f2225f52eb4d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470180} {:answer-field/choices [{:answer/id #uuid "de2f0777-10bc-5716-b903-2d5397b7afa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469138} {:answer/id #uuid "1803f7d1-0e88-50d0-b801-03a457a85e83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469139}] :answer-field/correct {:answer/id #uuid "1803f7d1-0e88-50d0-b801-03a457a85e83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469139} :answer-field/id #uuid "06caeb1c-f4fa-5b23-9efc-e6e9cf272ed6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00b02bef-cbb1-520c-b74e-661d82b27e5e" :question/math-academy-id "q-8022" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}x+y \\\\ 2y\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}kx+ky \\\\ 2(ky)\\end{bmatrix} \\\\  & =\\begin{bmatrix}k(x+y) \\\\ k(2y)\\end{bmatrix} \\\\  & =k\\begin{bmatrix}x+y \\\\ 2y\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 2({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}+{y}_{1} \\\\ 2{y}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2}+{y}_{2} \\\\ 2{y}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186348355 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ddf9bcc-1b80-5061-9595-2aa695fdf46e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469140} {:answer/id #uuid "142efaaf-152b-53fd-b91d-f83fe3918936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469141}] :answer-field/correct {:answer/id #uuid "142efaaf-152b-53fd-b91d-f83fe3918936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469141} :answer-field/id #uuid "177885e0-b15c-5b26-b386-e1b7f6e1f46a