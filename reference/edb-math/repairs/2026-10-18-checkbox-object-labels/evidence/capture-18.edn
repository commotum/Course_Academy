b/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451819} :answer-field/id #uuid "0fb5ede1-7e8c-5d9b-b36a-a9a320103a42" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452757}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5521ee3b-fffd-5558-98b1-b81f3a08c9ea" :question/math-academy-id "q-81164" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}y{e}^{x} & {e}^{x}-{e}^{y} \\\\ {e}^{x}-{e}^{y} & -x{e}^{y}\\end{bmatrix}\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(1,1)>0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0$\n- **III.** The point $(1,1)$ is a local maximum of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=\\begin{bmatrix}e & 0 \\\\ 0 & -e\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is false. Computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))=e\\cdot (-e)-{0}^{2}=-{e}^{2}<0.\n$$\n\n- Statement II is true. Indeed, we have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=e>0.$\n\n- Statement III is false. Since $H(1,1)<0,$ the point $(1,1)$ is a saddle point by the second partial derivative test.\n\nTherefore, the correct answer is \"II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186051048 :topic/id #uuid "7d157e41-c50b-570b-8b5b-b8a5a0d03163" :topic/math-academy-id 1944 :topic/title "The Second Partial Derivatives Test"} :activity/title "The Second Partial Derivatives Test" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547306} :db/id #edb/ref 17592186548154}]} {:db/id #edb/ref 17592186351277 :knowledge-point/_questions [{:db/id #edb/ref 17592186087750 :knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049420 :topic/id #uuid "f351f883-c87d-5a54-90d7-d8ba977cd2e1" :topic/math-academy-id 866 :topic/title "Linear Transformations of Objects in the Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b82692e0-ba33-5d1b-aaf9-45e7f08efebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469230} {:answer/id #uuid "ccaeba5b-a611-504e-9481-73f42eb30de5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469231}] :answer-field/correct {:answer/id #uuid "ccaeba5b-a611-504e-9481-73f42eb30de5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469231} :answer-field/id #uuid "e4060c76-fd99-57db-b724-012505e54ad8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470227} {:answer-field/choices [{:answer/id #uuid "43626a82-4c7d-5839-8b35-5dbd2fbeef2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469232} {:answer/id #uuid "c0b5ad13-8ac3-56be-bb52-c2b04d87d9fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469233}] :answer-field/correct {:answer/id #uuid "43626a82-4c7d-5839-8b35-5dbd2fbeef2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469232} :answer-field/id #uuid "4fc1d35b-4d19-5446-8692-a6461841218a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470228} {:answer-field/choices [{:answer/id #uuid "c12886b2-7831-5eba-a969-677c37d81084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469234} {:answer/id #uuid "673e6fbe-3530-52f2-8c6b-27a8d45cfa34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469235}] :answer-field/correct {:answer/id #uuid "673e6fbe-3530-52f2-8c6b-27a8d45cfa34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469235} :answer-field/id #uuid "b770dba2-847d-5910-b406-9d579c4a6ce4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470229}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e67ff0be-cbbc-585a-82ab-87b00ade6bf8" :question/math-academy-id "q-8125" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}7 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nA triangle $S$ has vertices at $(-3,0),(3,0),$ and $(0,-3).$ Which of the following are coordinates of a vertex of ${S}^{′}$, the image of $S$ under the action of $T?$\n- **I.** $(21,0)$\n- **II.** $(3,0)$\n- **III.** $(-21,0)$\n\nSelect all that apply." :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=\\begin{bmatrix}-3 & 3 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}7 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}-3 & 3 & 0 \\\\ 0 & 0 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-21 & 21 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-21,0),(21,0),(0,3).$ \n\nSo, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186351298 :knowledge-point/_questions [{:db/id #edb/ref 17592186105922 :knowledge-point/id #uuid "4e93fd7f-070f-5359-aabb-cba5cc275015" :knowledge-point/title "Identifying Convergent or Divergent Integrals With Unbounded Limits" :topic/_knowledge-points [{:db/id #edb/ref 17592186048880 :topic/id #uuid "c9449775-49cd-5723-869d-965280e34916" :topic/math-academy-id 1382 :topic/title "Improper Integrals Over the Real Line"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f991bde2-a2dd-5997-85e7-48c0a588560b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451833} {:answer/id #uuid "7c4f6253-6648-51da-9f05-9207335fa7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451834}] :answer-field/correct {:answer/id #uuid "7c4f6253-6648-51da-9f05-9207335fa7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451834} :answer-field/id #uuid "11d045a4-5991-5337-ad9c-b832845e2dd9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452764} {:answer-field/choices [{:answer/id #uuid "e65ce071-7dc1-5100-b660-e89d39f58038" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451835} {:answer/id #uuid "74ba8c4c-687e-5876-b882-dc0a2a63b75f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451836}] :answer-field/correct {:answer/id #uuid "e65ce071-7dc1-5100-b660-e89d39f58038" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451835} :answer-field/id #uuid "21fd0057-7bf7-54ce-93d9-6dc035cb7868" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452765} {:answer-field/choices [{:answer/id #uuid "e1d878b3-13f7-5a7a-8b4e-92252de9b06a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451837} {:answer/id #uuid "be8adabd-e2a9-54e8-9cf4-7b11d060aab7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451838}] :answer-field/correct {:answer/id #uuid "e1d878b3-13f7-5a7a-8b4e-92252de9b06a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451837} :answer-field/id #uuid "4669d2fb-acce-57bc-8e15-cf8d7a5bfb3b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452766}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "43f0f1fc-04b9-5788-b436-d0d8e07500dc" :question/math-academy-id "q-81375" :question/problem "Consider the function $f(x)=2x{e}^{-{x}^{2}}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is convergent\n- **II.** ${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is divergent\n- **III.** ${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent" :question/worked-solution "Suppose we have an improper integral in which both the left and right endpoints are unbounded:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x\n$$\n\nIf the integrand $f(x)$ is continuous on $(-\\infty ,\\infty ),$ then we can break the integral up into two improper integrals, each with a single unbounded endpoint:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x\n$$\n\nThen, we can compute each of the two integrals separately and combine their results. \n\n**Watch out!** If either of the two integrals on the right-hand side is divergent, then the integral on the left-hand side is also divergent.\n\nFirst, we calculate the antiderivative using a substitution.  Let $u={x}^{2}$,  then $\\text{d}u=2x\\,\\text{d}x.$ Hence, the antiderivative is\n\n$$\n\\begin{aligned}\\int 2x{e}^{-{x}^{2}}\\,\\text{d}x & =\\int {e}^{-u}\\,\\text{d}u \\\\  & =-{e}^{-u}+C \\\\  & =-{e}^{-{x}^{2}}+C.\\end{aligned}\n$$\n\nNow, let's evaluate each integral in turn.\n\n- Statement I is true. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }2x{e}^{-{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}2x{e}^{-{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }({-{e}^{-{x}^{2}}|}_{0}^{a}) \\\\  & ={lim}_{a\\to \\infty }(-{e}^{-{a}^{2}}+{e}^{0}) \\\\  & =0+1 \\\\  & =1.\\end{aligned}\n$$\n\nSo the integral converges.\n\n- Statement II is false. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}2x{e}^{-{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}2x{e}^{-{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }({-{e}^{-{x}^{2}}|}_{a}^{0}) \\\\  & ={lim}_{a\\to -\\infty }(-{e}^{0}+{e}^{-{a}^{2}}) \\\\  & =-1+0 \\\\  & =-1.\\end{aligned}\n$$\n\nSo the integral converges.\n\n- Statement III is false. The integral in statement III can be expressed as\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x=1-1=0.\n$$\n\nSo the integral converges.\n\nIn conclusion, only statement I is true."} {:db/id #edb/ref 17592186351308 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050603 :topic/id #uuid "579b98fc-d572-5a6a-9016-eb840c350a9d" :topic/math-academy-id 2017 :topic/title "Rotation-Scaling Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df7c1bcf-f1eb-5b77-ab7f-83fe8a5b522f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469236} {:answer/id #uuid "155e8175-9b10-5f3c-be64-04c360f56c5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469237}] :answer-field/correct {:answer/id #uuid "df7c1bcf-f1eb-5b77-ab7f-83fe8a5b522f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469236} :answer-field/id #uuid "d29d3366-25ba-52a3-a6ad-f3cec5d7412b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470230} {:answer-field/choices [{:answer/id #uuid "e03b4caf-8852-5786-a6fe-5de3f76a2476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469238} {:answer/id #uuid "d9a99e8f-4919-55d7-b18c-191aafb41625" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469239}] :answer-field/correct {:answer/id #uuid "d9a99e8f-4919-55d7-b18c-191aafb41625" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469239} :answer-field/id #uuid "c551cc23-c4b0-563a-93ea-895c3a97264c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470231} {:answer-field/choices [{:answer/id #uuid "494e7411-d829-598e-9de5-90e1488b8542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469240} {:answer/id #uuid "41ff5839-503f-5afb-a30e-edef5d272748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469241}] :answer-field/correct {:answer/id #uuid "494e7411-d829-598e-9de5-90e1488b8542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469240} :answer-field/id #uuid "88af55a0-d640-505a-b9a8-b46d712d889d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470232}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92058ab0-e5fa-580e-91cc-9a3c064bb64d" :question/math-academy-id "q-81453" :question/problem "Which of the following are rotation-scaling matrices?\n- **I.** $A=\\begin{bmatrix}1 & 2 \\\\ 2 & 1\\end{bmatrix}$\n- **II.** $B=\\begin{bmatrix}-2 & -5 \\\\ 5 & -2\\end{bmatrix}$\n- **III.** $C=\\begin{bmatrix}8 & 4 \\\\ -4 & -8\\end{bmatrix}$\n\nSelect all that apply." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}1 & 2 \\\\ 2 & 1\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the antidiagonal do not have opposite signs.\n\n- $B=\\begin{bmatrix}-2 & -5 \\\\ 5 & -2\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $C=\\begin{bmatrix}8 & 4 \\\\ -4 & -8\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\nIn conclusion, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186351309 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050603 :topic/id #uuid "579b98fc-d572-5a6a-9016-eb840c350a9d" :topic/math-academy-id 2017 :topic/title "Rotation-Scaling Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8c11326-58cb-5524-92ff-0290a9ecadd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469242} {:answer/id #uuid "a69806df-98fe-59cf-b90d-7b232f854a53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469243}] :answer-field/correct {:answer/id #uuid "d8c11326-58cb-5524-92ff-0290a9ecadd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469242} :answer-field/id #uuid "b5742919-a97f-5002-9b52-5cfe4f6c5bcb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470233} {:answer-field/choices [{:answer/id #uuid "24934774-3605-5fc4-b91f-0c8a4fecbeae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469244} {:answer/id #uuid "7cf8a226-1e50-5780-afa8-fdaf628d6921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469245}] :answer-field/correct {:answer/id #uuid "7cf8a226-1e50-5780-afa8-fdaf628d6921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469245} :answer-field/id #uuid "a614d3d8-32e0-55b6-b55d-57a061d83daf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470234} {:answer-field/choices [{:answer/id #uuid "50ed25b1-fba1-571e-aa3a-ee3f068a238f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469246} {:answer/id #uuid "c9af976b-1dda-5382-8ec8-e6e25b5b9b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469247}] :answer-field/correct {:answer/id #uuid "c9af976b-1dda-5382-8ec8-e6e25b5b9b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469247} :answer-field/id #uuid "ee930c89-0f0d-5310-8f24-78338158d5b5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470235}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1ff6dbb-4ce0-5c14-8e12-348294b11875" :question/math-academy-id "q-81455" :question/problem "Which of the following are rotation-scaling matrices?\n- **I.** $A=\\begin{bmatrix}-2 & 4 \\\\ -4 & 2\\end{bmatrix}$\n- **II.** $B=\\begin{bmatrix}2 & -\\frac{3}{4} \\\\ \\frac{3}{4} & 2\\end{bmatrix}$\n- **III.** $C=\\begin{bmatrix}\\frac{1}{2} & 5 \\\\ -5 & \\frac{1}{2}\\end{bmatrix}$\n\nSelect all that apply." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}-2 & 4 \\\\ -4 & 2\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\n- $B=\\begin{bmatrix}2 & -\\frac{3}{4} \\\\ \\frac{3}{4} & 2\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $C=\\begin{bmatrix}\\frac{1}{2} & 5 \\\\ -5 & \\frac{1}{2}\\end{bmatrix}$ is a rotation-scaling matrix.\n\nIn conclusion, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186351310 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac5898e-ccd9-5404-8efc-311f58a28a6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438598} {:answer/id #uuid "40d3c152-dad7-5945-a794-9fb168302c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438599}] :answer-field/correct {:answer/id #uuid "40d3c152-dad7-5945-a794-9fb168302c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438599} :answer-field/id #uuid "6578c37d-0b49-5206-b245-6ec044a9e0dd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439328} {:answer-field/choices [{:answer/id #uuid "ec262c2d-cd4c-5f8a-9d3f-9bbc45bf6356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438600} {:answer/id #uuid "b5d3825b-3dd0-5749-8394-e80247b12499" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438601}] :answer-field/correct {:answer/id #uuid "b5d3825b-3dd0-5749-8394-e80247b12499" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438601} :answer-field/id #uuid "bdb8753c-ab98-5e82-82cd-ee42afcd9f28" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439329} {:answer-field/choices [{:answer/id #uuid "5a3d211e-4ac3-517a-add9-2d442df1b48e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438602} {:answer/id #uuid "b6c9eb12-1057-58bb-8116-fa1399ef2296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438603}] :answer-field/correct {:answer/id #uuid "b6c9eb12-1057-58bb-8116-fa1399ef2296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438603} :answer-field/id #uuid "ff0eaf1f-730a-5a51-9bf3-fa77e2cb6d36" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc1a89db-98a6-54e9-a27c-1ebc3462a7a6" :question/math-academy-id "q-81460" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F(x,y)=2xy\\,i+{x}^{2}\\,j$\n- **II.** $G(x,y)=\\operatorname{sin}⁡({y}^{2})\\,i+2xy\\operatorname{cos}⁡({y}^{2})\\,j$\n- **III.** $H(x,y)=y{e}^{xy}\\,i+x{e}^{xy}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=2xy$ and $Q={x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2x,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=\\operatorname{sin}⁡({y}^{2})$ and $Q=2xy\\operatorname{cos}⁡({y}^{2}).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y\\operatorname{cos}⁡({y}^{2}),\\,\\frac{∂Q}{∂x}=2y\\operatorname{cos}⁡({y}^{2}).\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=y{e}^{xy}$ and $Q=x{e}^{xy}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{xy}+xy{e}^{xy},\\,\\frac{∂Q}{∂x}={e}^{xy}+xy{e}^{xy}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III\"."} {:db/id #edb/ref 17592186351360 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "371f0d39-776e-5b85-a508-c94b2ac2b522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438604} {:answer/id #uuid "aca9ec9d-b6b0-5219-90db-431dcf2f158f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438605}] :answer-field/correct {:answer/id #uuid "371f0d39-776e-5b85-a508-c94b2ac2b522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438604} :answer-field/id #uuid "0dda7980-1744-5da6-8443-f5cd3aa61fb8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439331} {:answer-field/choices [{:answer/id #uuid "ff09ca98-e109-5e9b-a23c-9174cdfe3d77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438606} {:answer/id #uuid "95604c57-6e13-5fb9-b03a-6c3250992cfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438607}] :answer-field/correct {:answer/id #uuid "95604c57-6e13-5fb9-b03a-6c3250992cfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438607} :answer-field/id #uuid "bc6a548e-e667-5d89-9d10-459ef9e2e419" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439332} {:answer-field/choices [{:answer/id #uuid "063f9ca6-220f-5f24-91d4-0cff834e06d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438608} {:answer/id #uuid "bc47704e-68c1-5d9e-9f9b-802de105632e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438609}] :answer-field/correct {:answer/id #uuid "063f9ca6-220f-5f24-91d4-0cff834e06d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438608} :answer-field/id #uuid "6cd11437-4a71-571d-b489-a706ff584c35" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439333}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2410b4fd-4172-5cce-b672-b1259e48aa6b" :question/math-academy-id "q-81743" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F=x\\operatorname{sin}⁡(xy)\\,i+y\\operatorname{sin}⁡(xy)\\,j$\n- **II.** $G=(2x+1)\\,i+(5{y}^{2}+2y+1)\\,j$\n- **III.** $H={y}^{2}\\,i+{x}^{2}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x\\operatorname{sin}⁡(xy)$ and $Q=y\\operatorname{sin}⁡(xy).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={x}^{2}\\operatorname{cos}⁡(xy),\\,\\frac{∂Q}{∂x}={y}^{2}\\operatorname{cos}⁡(xy).\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=2x+1$ and $Q=5{y}^{2}+2y+1.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=0.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={y}^{2}$ and $Q={x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186351361 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3d344f4-8ed3-593a-aed4-5228049f941e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438616} {:answer/id #uuid "b51feba4-149e-552b-ba57-a034975c6254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438617}] :answer-field/correct {:answer/id #uuid "b51feba4-149e-552b-ba57-a034975c6254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438617} :answer-field/id #uuid "f0efaccc-6c1e-515a-a6b3-27b5fea347ab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439337} {:answer-field/choices [{:answer/id #uuid "fceaa12c-f1cb-5a20-a916-433cb5161bb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438618} {:answer/id #uuid "fdca841c-e44f-5760-937f-556b1d7dbb00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438619}] :answer-field/correct {:answer/id #uuid "fceaa12c-f1cb-5a20-a916-433cb5161bb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438618} :answer-field/id #uuid "75fbead4-be61-5190-81c8-ff7df1836c09" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439338} {:answer-field/choices [{:answer/id #uuid "42ce1c69-5a9a-5668-a6d1-ef1043e559b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438620} {:answer/id #uuid "1cc59867-4b98-5161-bf03-738307481109" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438621}] :answer-field/correct {:answer/id #uuid "42ce1c69-5a9a-5668-a6d1-ef1043e559b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438620} :answer-field/id #uuid "521321bd-40ca-5972-9cfb-572b598d4cdd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7be69df3-7414-5358-b771-962bb47016d4" :question/math-academy-id "q-81746" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F=xy\\,i+(\\frac{1}{2}{x}^{2}+{y}^{2})\\,j$\n- **II.** $G=(4x+{y}^{2})\\,i-4x{y}^{2}\\,j$\n- **III.** $H=\\operatorname{sin}⁡(xy)\\,i+\\operatorname{cos}⁡(xy)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.  \n\n- For the vector field $F,$ we have $P=xy$ and $Q=\\frac{1}{2}{x}^{2}+{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x,\\,\\frac{∂Q}{∂x}=x.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=4x+{y}^{2}$ and $Q=-4x{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=-4{y}^{2}.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\operatorname{sin}⁡(xy)$ and $Q=\\operatorname{cos}⁡(xy).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x\\operatorname{cos}⁡(xy),\\,\\frac{∂Q}{∂x}=-y\\operatorname{sin}⁡(xy),.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186351372 :knowledge-point/_questions [{:db/id #edb/ref 17592186092224 :knowledge-point/id #uuid "20f4ef93-3e7b-58ec-992e-3a62b12b74e2" :knowledge-point/title "Using a Matrix That Represents a Rotation of 180 Degrees" :topic/_knowledge-points [{:db/id #edb/ref 17592186048712 :topic/id #uuid "b784cbd9-6f0d-5689-9a0e-6e19dfca34c7" :topic/math-academy-id 931 :topic/title "Right-Angle Rotations as Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b7a741a-bffe-5ea9-b9ac-595c393a9e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469248} {:answer/id #uuid "4137e893-127f-5a69-9b0e-36ae9097192e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469249}] :answer-field/correct {:answer/id #uuid "4137e893-127f-5a69-9b0e-36ae9097192e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469249} :answer-field/id #uuid "3ff64879-c895-5a14-b807-48ea39b24d27" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470236} {:answer-field/choices [{:answer/id #uuid "aff8b989-aa68-58b3-b0b4-642a905002fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469250} {:answer/id #uuid "01e9d30d-3c30-552c-ac24-dba7622975fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469251}] :answer-field/correct {:answer/id #uuid "01e9d30d-3c30-552c-ac24-dba7622975fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469251} :answer-field/id #uuid "075d906f-9e7b-5da6-8764-cbe590fd5bc0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470237} {:answer-field/choices [{:answer/id #uuid "655faf34-5341-5836-99ac-bf1340995713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469252} {:answer/id #uuid "c929f0bc-b1d4-5ae0-b2b7-c05333704463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469253}] :answer-field/correct {:answer/id #uuid "c929f0bc-b1d4-5ae0-b2b7-c05333704463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469253} :answer-field/id #uuid "c9d5d0b2-c21a-5bc5-a8fa-00879de8dc94" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77695064-c91d-5069-813d-3934cbdfcb63" :question/math-academy-id "q-81815" :question/problem "A triangle $S$ has vertices at $(4,1),(0,-3),(-1,3).$  Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{180}^{∘}}$ by an angle of ${180}^{∘}$ about the origin?\n- **I.** $(1,-3)$\n- **II.** $(-4,-1)$\n- **III.** $(0,3)$\n\nSelect all that apply." :question/worked-solution "The clockwise rotation ${R}_{-{180}^{∘}}$ by an angle of ${180}^{∘}$ is the same as counterclockwise rotation by the same angle. It's given by the matrix\n\n$$\nR=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{180}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}4 & 0 & -1 \\\\ 1 & -3 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{180}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & 0 & -1 \\\\ 1 & -3 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 0 & 1 \\\\ -1 & 3 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-4,-1),(0,3),(1,-3).$\n\nSo, the correct answer is \"I, II and III.\""} {:db/id #edb/ref 17592186351373 :knowledge-point/_questions [{:db/id #edb/ref 17592186092224 :knowledge-point/id #uuid "20f4ef93-3e7b-58ec-992e-3a62b12b74e2" :knowledge-point/title "Using a Matrix That Represents a Rotation of 180 Degrees" :topic/_knowledge-points [{:db/id #edb/ref 17592186