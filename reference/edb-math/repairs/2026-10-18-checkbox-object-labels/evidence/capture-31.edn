uid "3495b22a-5a40-5f4c-a29c-2521e744ca38" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577192} {:answer-field/choices [{:answer/id #uuid "1eb60bde-94b4-5458-b7f4-9d69e214bb5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577185} {:answer/id #uuid "a93e1b70-b465-590a-b650-b80a76b041e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577213}] :answer-field/correct {:answer/id #uuid "a93e1b70-b465-590a-b650-b80a76b041e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577213} :answer-field/id #uuid "70375abd-6d28-58de-b77f-ce69697a327a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577206} {:answer-field/choices [{:answer/id #uuid "07f2b71f-67b4-5220-b1f2-f9c9f3e2990b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577179} {:answer/id #uuid "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577203}] :answer-field/correct {:answer/id #uuid "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577203} :answer-field/id #uuid "ce88c0d7-692b-5115-9ff0-7a3fad5b60fe" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45c5715f-9b0f-5612-a118-607bd8abc3ff" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=3 e^{- y},\\qquad 3 x>0\n$$\n\nLet $f(x)=\\ln{\\left(3 x \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{5}{3 x}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is false. Differentiating $f(x)=\\ln{\\left(3 x \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\ln{\\left(3 x \\right)}\\right)\\prime \\\\ &=\\frac{1}{3 x}\\cdot 3 \\\\ &=\\frac{1}{x} \\\\ &\\not\\equiv \\frac{5}{3 x}\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=\\ln{\\left(3 x \\right)}$ and $y\\prime=\\frac{1}{x}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}3 e^{- y} \\\\ \\frac{1}{x} &\\overset{?}{=}\\frac{3}{e^{\\ln{\\left(3 x \\right)}}} \\\\ \\frac{1}{x} &=\\frac{1}{x}\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=\\ln{\\left(3 x \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186577202 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e396c4fd-71c1-59bc-9209-55e931510240" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577222} {:answer/id #uuid "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577224}] :answer-field/correct {:answer/id #uuid "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577224} :answer-field/id #uuid "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577204} {:answer-field/choices [{:answer/id #uuid "4c7a9207-df6c-50b8-9322-193b412462e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577197} {:answer/id #uuid "e7e176ae-2161-5a2f-98fa-6518aaefb7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577225}] :answer-field/correct {:answer/id #uuid "4c7a9207-df6c-50b8-9322-193b412462e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577197} :answer-field/id #uuid "7b09d08b-9296-54a5-9074-0d5f596c8957" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577208} {:answer-field/choices [{:answer/id #uuid "5f89bbee-f608-509b-809c-754a660a177f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577200} {:answer/id #uuid "93c10b1d-09b9-596a-91ee-b34e3f0aeb22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577212}] :answer-field/correct {:answer/id #uuid "93c10b1d-09b9-596a-91ee-b34e3f0aeb22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577212} :answer-field/id #uuid "b30d6233-d2d5-5248-b659-81906ac6d588" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577214}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "628c5962-9540-54e0-a743-71b039507ef9" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=2 e^{- y},\\qquad 2 x - 3>0\n$$\n\nLet $f(x)=\\ln{\\left(2 x - 3 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{2}{2 x - 3}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=\\ln{\\left(2 x - 3 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\ln{\\left(2 x - 3 \\right)}\\right)\\prime \\\\ &=\\frac{1}{2 x - 3}\\cdot 2 \\\\ &=\\frac{2}{2 x - 3}\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=\\ln{\\left(2 x - 3 \\right)}$ and $y\\prime=\\frac{2}{2 x - 3}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}2 e^{- y} \\\\ \\frac{2}{2 x - 3} &\\overset{?}{=}\\frac{2}{e^{\\ln{\\left(2 x - 3 \\right)}}} \\\\ \\frac{2}{2 x - 3} &=\\frac{2}{2 x - 3}\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=\\ln{\\left(2 x - 3 \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186577207 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fef22b4-1658-51c4-9d88-3a9f9308339c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577186} {:answer/id #uuid "5ea23ce8-56d6-5036-b822-761465ad590a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577199}] :answer-field/correct {:answer/id #uuid "1fef22b4-1658-51c4-9d88-3a9f9308339c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577186} :answer-field/id #uuid "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577180} {:answer-field/choices [{:answer/id #uuid "20a047d6-d21d-54fd-bd52-edd9989ba98c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577187} {:answer/id #uuid "6c090d77-8107-5ce4-844f-f3f7a0f9ce10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577205}] :answer-field/correct {:answer/id #uuid "6c090d77-8107-5ce4-844f-f3f7a0f9ce10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577205} :answer-field/id #uuid "dd