2186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577310}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=6 e^{- \\frac{y}{3}},\\qquad 4 x + 4>0\n$$\n\nLet $f(x)=3 \\ln{\\left(4 x + 4 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{12}{4 x + 4}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=3 \\ln{\\left(4 x + 4 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(3 \\ln{\\left(4 x + 4 \\right)}\\right)\\prime \\\\ &=3\\cdot\\frac{4}{4 x + 4} \\\\ &=\\frac{12}{4 x + 4}\\end{aligned}\n$$\n\n- Statement II is false. Substituting $y=3 \\ln{\\left(4 x + 4 \\right)}$ and $y\\prime=\\frac{12}{4 x + 4}$ into the original equation gives expressions that are not identical:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}6 e^{- \\frac{y}{3}} \\\\ \\frac{12}{4 x + 4} &\\overset{?}{=}6e^{-(3 \\ln{\\left(4 x + 4 \\right)})/(3)} \\\\ \\frac{12}{4 x + 4} &\\overset{?}{=}6e^{-\\ln(4 x + 4)} \\\\ \\frac{12}{4 x + 4} &\\not\\equiv \\frac{3}{2 \\left(x + 1\\right)}\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, the function $y=3 \\ln{\\left(4 x + 4 \\right)}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186577320 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06be9c0a-0223-57ac-aa2a-f18ff8de1f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577280} {:answer/id #uuid "6d228363-cf1a-5ff6-9768-677aa5961cc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577300}] :answer-field/correct {:answer/id #uuid "6d228363-cf1a-5ff6-9768-677aa5961cc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577300} :answer-field/id #uuid "6d72eff3-71f9-5ab8-bb2e-d070834ba15b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577301} {:answer-field/choices [{:answer/id #uuid "182d1adb-f26c-5500-ab80-039d7a4be356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577285} {:answer/id #uuid "366b6039-d11a-5792-9c44-29c7e0c34e1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577287}] :answer-field/correct {:answer/id #uuid "182d1adb-f26c-5500-ab80-039d7a4be356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577285} :answer-field/id #uuid "8ad95109-0cc0-5d78-83ab-75d8e54829d8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577305} {:answer-field/choices [{:answer/id #uuid "76d2274a-f13b-5662-81b5-9656c55f0c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577302} {:answer/id #uuid "7a30a52a-1fcc-5a3c-9848-64fc5a681c65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577303}] :answer-field/correct {:answer/id #uuid "76d2274a-f13b-5662-81b5-9656c55f0c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577302} :answer-field/id #uuid "a4f3d032-bbe2-53bc-8f58-067bf98bacb8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577315}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cb9ae8f4-b827-5abd-a900-f65d110847aa" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=8 e^{- \\frac{y}{2}},\\qquad 4 x - 1>0\n$$\n\nLet $f(x)=2 \\ln{\\left(4 x - 1 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{8}{4 x - 1}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=2 \\ln{\\left(4 x - 1 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(2 \\ln{\\left(4 x - 1 \\right)}\\right)\\prime \\\\ &=2\\cdot\\frac{4}{4 x - 1} \\\\ &=\\frac{8}{4 x - 1}\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=2 \\ln{\\left(4 x - 1 \\right)}$ and $y\\prime=\\frac{8}{4 x - 1}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}8 e^{- \\frac{y}{2}} \\\\ \\frac{8}{4 x - 1} &\\overset{?}{=}8e^{-(2 \\ln{\\left(4 x - 1 \\right)})/(2)} \\\\ \\frac{8}{4 x - 1} &\\overset{?}{=}8e^{-\\ln(4 x - 1)} \\\\ \\frac{8}{4 x - 1} &=\\frac{8}{4 x - 1}\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=2 \\ln{\\left(4 x - 1 \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186577325 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68427cdb-4aa1-5bed-8af1-4c431730eaf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577299} {:answer/id #uuid "db9b80df-b1a1-5f03-abb8-805c0384bf6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577321}] :answer-field/correct {:answer/id #uuid "db9b80df-b1a1-5f03-abb8-805c0384bf6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577321} :answer-field/id #uuid "6452302d-8c93-54b4-bd74-909afc8a339a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577298} {:answer-field/choices [{:answer/id #uuid "08d20a70-a6e3-569b-b70c-91a2deeda071" :a