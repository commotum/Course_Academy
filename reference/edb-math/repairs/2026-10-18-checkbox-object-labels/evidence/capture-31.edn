heckbox} :db/id #edb/ref 17592186569002} {:answer-field/choices [{:answer/id #uuid "6ec6e538-5559-5503-be15-77f01d3a3fc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568971} {:answer/id #uuid "f607b139-5dcc-5cd3-bfef-9e0291f54f01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569056}] :answer-field/correct {:answer/id #uuid "f607b139-5dcc-5cd3-bfef-9e0291f54f01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569056} :answer-field/id #uuid "b6e601d7-5d66-53da-9134-9ff90ecbe165" :answer-field/key "F" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186569016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24965ee9-6cd7-5689-8809-fc92026353b9" :question/problem "Which of the following are diagonal matrices?\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$F=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n<div>$H=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}$</div>\n<div>$M=\\begin{bmatrix}0 & -1 \\\\ 7 & -2\\end{bmatrix}$</div>\n</div>\n\nSelect all that apply." :question/worked-solution "- $F$ is a diagonal matrix. It is square and every off-diagonal entry is zero. It is also an identity matrix; identity matrices are diagonal matrices.\n\n- $H$ is a diagonal matrix. It is square and every off-diagonal entry is zero.\n\n- $M$ is *not* a diagonal matrix. It is square, but an entry off the main diagonal is nonzero: ${m}_{21}=7\\ne 0$.\n\nTherefore, only $F$ and $H$ are diagonal matrices."} {:db/id #edb/ref 17592186568926 :knowledge-point/_questions [{:db/id #edb/ref 17592186087697 :knowledge-point/id #uuid "09fa0899-a3d2-584f-8cdd