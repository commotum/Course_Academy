ery off-diagonal entry is zero.\n\nTherefore, $F$ and $H$ and $M$ are diagonal matrices."} {:db/id #edb/ref 17592186569011 :knowledge-point/_questions [{:db/id #edb/ref 17592186087697 :knowledge-point/id #uuid "09fa0899-a3d2-584f-8cdd-a471f8cfd16b" :knowledge-point/title "Identifying a Special Square Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048252 :topic/id #uuid "8c876864-a853-56d6-a887-91d7f8f1cf14" :topic/math-academy-id 862 :topic/title "Zero, Square, Diagonal and Identity Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e51d620-d9ba-51ab-82d9-b2d5b6ca1491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568908} {:answer/id #uuid "c34d233e-d649-57e0-ab78-837af100a72f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569025}] :answer-field/correct {:answer/id #uuid "0e51d620-d9ba-51ab-82d9-b2d5b6ca1491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568908} :answer-field/id #uuid "a7eba9d9-2b57-520e-a74e-807f28ef7da0" :answer-field/key "N" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186569009} {:answer-field/choices [{:answer/id #uuid "0c3176d5-d551-5b7d-b280-b2976b350f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186568904} {:answer/id #uuid "cbd3bd9d-276f-5cf9-ba82-ff85a1eea62b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569031}] :answer-field/correct {:answer/id #uuid "cbd3bd9d-276f-5cf9-ba82-ff85a1eea62b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569031} :answer-field/id #uuid "b9132a68-d928-5b95-b94e-caf26