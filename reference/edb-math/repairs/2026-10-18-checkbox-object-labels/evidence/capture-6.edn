6045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422251 :task-item/_responses [{:db/id #edb/ref 17592186409283 :task-item/content {:db/id #edb/ref 17592186253524} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "006b96f3-1130-5007-b040-c8341e58057b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422406} {:answer-field/choices [{:answer/id #uuid "d4e37f4d-fa5b-5fe7-96e5-e9ef0b93d247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422253} {:answer/id #uuid "73afeb6e-bb5d-5e60-a750-aabc89815638" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422254 :task-item/_responses [{:db/id #edb/ref 17592186409283 :task-item/content {:db/id #edb/ref 17592186253524} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "73afeb6e-bb5d-5e60-a750-aabc89815638" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422254 :task-item/_responses [{:db/id #edb/ref 17592186409283 :task-item/content {:db/id #edb/ref 17592186253524} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "c68d0e4a-42ad-5fc6-a993-d34e08e87259" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422407}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e075483-5dc5-5bbb-be2d-e2d1164eea57" :question/math-academy-id "q-118870" :question/problem "Which of the following are **not** autonomous ordinary differential equations?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}={e}^{3-y}-2$\n- **II.** $y{y}^{′}+\\operatorname{cos}⁡y=1$\n- **III.** ${y}^{′}=\\operatorname{tan}⁡(x+y)$" :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation I is an autonomous differential equation. It is of the form ${y}^{′}=f(y),$ where $f(y)={e}^{3-y}-2.$\n\n- Equation II is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}y{y}^{′}+\\operatorname{cos}⁡y & =1 \\\\ {y}^{′} & =\\frac{1-\\operatorname{cos}⁡y}{y} \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=\\frac{1-\\operatorname{cos}⁡y}{y}.$\n\n- Equation III is *not* an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\nTherefore, the correct answer is \"III only.\"" :task-item/_content [{:db/id #edb/ref 17592186409283 :task-item/content {:db/id #edb/ref 17592186253524} :task-item/elapsed-seconds 201.908 :task-item/id #uuid "d850ac8a-5955-4db3-9cc8-25eef0277183" :task-item/next {:db/id #edb/ref 17592186409284} :task-item/responses [{:answer/id #uuid "bd1ea97b-c130-5985-8c17-cc72347ebe97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422249} {:answer/id #uuid "6b4a5bf0-ec42-5cdd-9f4a-eafa46fc3dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422251} {:answer/id #uuid "73afeb6e-bb5d-5e60-a750-aabc89815638" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422254}] :task-item/status {:db/id #edb/ref 17592186045571}}]} {:db/id #edb/ref 17592186253528 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186050467 :topic/id #uuid "4bf7862e-8b34-577f-9a7c-1f3cc4989b50" :topic/math-academy-id 1102 :topic/title "Problem Solving Using Vector Diagrams"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14f1707a-a6cd-5d59-84fa-27f9eeb71ead" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461863} {:answer/id #uuid "5ba76389-92e4-5ccf-8712-d8fd82870166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461864}] :answer-field/correct {:answer/id #uuid "14f1707a-a6cd-5d59-84fa-27f9eeb71ead" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461863} :answer-field/id #uuid "7aa4482b-dc1b-5133-8c44-f7dca0376eaa" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462685} {:answer-field/choices [{:answer/id #uuid "98c30e83-48fb-55db-8c1e-f667f6d945ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461865} {:answer/id #uuid "ea94a37b-3120-54ff-b365-49b1f70de0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461866}] :answer-field/correct {:answer/id #uuid "ea94a37b-3120-54ff-b365-49b1f70de0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461866} :answer-field/id #uuid "8e94ea8d-e75e-58b7-909a-2691939879a2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462686} {:answer-field/choices [{:answer/id #uuid "5f16e010-7de1-5279-964b-71ac44e40c31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461867} {:answer/id #uuid "ae3a1e30-5262-5347-b264-bd971063a0e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461868}] :answer-field/correct {:answer/id #uuid "5f16e010-7de1-5279-964b-71ac44e40c31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461867} :answer-field/id #uuid "c0f26be7-fb2b-5772-81c1-0d6c2abc0164" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41da8ad0-e0fc-5f39-8eb7-c4706c551e5a" :question/math-academy-id "q-118976" :question/problem "![](images/dc/dcd36221e7ad293f0aac1ab99ece80641cb077efd05adc168a552e97d86100c8.png)\n\nIn parallelogram $ABCD$ shown above, which of the following equalities are true?\n\nI. $\\overset{\\to }{AD}=\\overset{\\to }{CB}$\n\nII. $\\overset{\\to }{DC}+\\overset{\\to }{CB}=\\overset{\\to }{DB}$\n\nIII. $\\overset{\\to }{AD}+\\overset{\\to }{DF}=\\overset{\\to }{FA}$\n\nSelect all that apply." :question/worked-solution "- Equality I is false. Indeed, $\\overset{\\to }{AD}\\ne \\overset{\\to }{CB}$ since they have the opposite directions.\n\n- Equality II is true. Indeed, $\\overset{\\to }{DC}+\\overset{\\to }{CB}=\\overset{\\to }{DB}.$\n\n- Equality III is false. Indeed, $\\overset{\\to }{AD}+\\overset{\\to }{DF}=\\overset{\\to }{AF}\\ne \\overset{\\to }{FA}$ since they have the opposite directions.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186253550 :knowledge-point/_questions [{:db/id #edb/ref 17592186166823 :knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735" :knowledge-point/title "Identifying True Statements Regarding Slope Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186048822 :topic/id #uuid "c2fc5214-795d-5bfe-b226-459801a3c888" :topic/math-academy-id 3276 :topic/title "Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55e35797-c4cc-588f-a334-6e167d806dcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448072} {:answer/id #uuid "bf6dc8e7-0a87-5da6-a74f-4c8397d0c042" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448073}] :answer-field/correct {:answer/id #uuid "bf6dc8e7-0a87-5da6-a74f-4c8397d0c042" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448073} :answer-field/id #uuid "22f75b47-16b6-5dd6-a760-d4992c5c2524" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449076} {:answer-field/choices [{:answer/id #uuid "8d765046-e075-5330-b681-0d916148575b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448074} {:answer/id #uuid "76d506ba-3407-5dfa-b117-bc384b0cc378" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448075}] :answer-field/correct {:answer/id #uuid "76d506ba-3407-5dfa-b117-bc384b0cc378" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448075} :answer-field/id #uuid "9178f62a-187a-5cd8-94b0-3a0de5cf57e5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449077} {:answer-field/choices [{:answer/id #uuid "77619b7f-1d91-56eb-b4d3-056373fa62fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448076} {:answer/id #uuid "817742eb-aa8e-5d46-ab84-dc12f41876a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448077}] :answer-field/correct {:answer/id #uuid "77619b7f-1d91-56eb-b4d3-056373fa62fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448076} :answer-field/id #uuid "ac315583-34df-5bdd-a20d-a5eaf525c2fe" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449078}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19539888-a72b-5a8c-9bb4-399cabb49fb2" :question/math-academy-id "q-119194" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2x+2$ and its slope field. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** At every point along the line $x=0,$ the slope field has a positive slope\n- **II.** At every point along the line $x=-1,$ the slope field is horizontal\n- **III.** At every point along the line $x=-2,$ the slope field has a positive slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(0,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,y)}=2(0)+2=2>0,\n$$\n\nand this implies that the slope at the point $(0,y)$ is positive for any $y.$ Moreover, the slope at the point $(0,y)$ is equal to $2$ for any $y.$\n\n- Statement II is true. Consider a point of the form $(-1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,y)}=2(-1)+2=0,\n$$\n\nand this implies that the slope at the point $(-1,y)$ is horizontal for any $y.$\n\n- Statement III is false. Consider a point of the form $(-2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,y)}=2(-2)+2=-2<0,\n$$\n\nand this implies that the slope at the point $(-2,y)$ is negative for any $y.$ Moreover, the slope at the point $(-2,y)$ is equal to $-2$ for any $y.$\n\nTherefore, the correct answer is \"I and II only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](images/8d/8d40c405f3f4db66a18e06a5327e86600081a6bc57b502ebed9c94471a0d5857.png)"}]
