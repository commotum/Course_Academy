edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461616}] :answer-field/correct {:answer/id #uuid "630bb051-3efe-5a74-a086-01a568b3085a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461615} :answer-field/id #uuid "3af09c95-73be-5007-8368-88b917550558" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462561}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11f8af48-def1-5000-8ab6-3793fdd8fd3a" :question/math-academy-id "q-110291" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 3 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{3}:={R}_{3}+3{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\nTherefore, only $B$ is an elementary matrix."} {:db/id #edb/ref 17592186247105 :knowledge-point/_questions [{:db/id #edb/ref 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048897 :topic/id #uuid "ca2d5c2b-c710-5912-bab0-623e5d6f5c00" :topic/math-academy-id 1731 :topic/title "Elementary 3x3 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75fb586e-f579-51cf-bd9d-47ff1486b729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461617} {:answer/id #uuid "bdc11fdc-ce52-5c36-bad6-aca6df0112c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461618}] :answer-field/correct {:answer/id #uuid "75fb586e-f579-51cf-bd9d-47ff1486b729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461617} :answer-field/id #uuid "57d8c5f5-4748-5d5e-b3fc-406fcb8ac660" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462562} {:answer-field/choices [{:answer/id #uuid "201ce91a-f2af-5228-b077-e9c4dec01ceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461619} {:answer/id #uuid "b6d897c7-655f-57c2-810f-6244cedbf59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461620}] :answer-field/correct {:answer/id #uuid "b6d897c7-655f-57c2-810f-6244cedbf59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461620} :answer-field/id #uuid "74e56853-cb78-585c-8cc8-8e2d2f6a89ae" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462563} {:answer-field/choices [{:answer/id #uuid "ae49a308-7222-54d7-88af-541e4b74369b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461621} {:answer/id #uuid "f95ae002-6924-5fc8-bdc2-e3df6ecce540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461622}] :answer-field/correct {:answer/id #uuid "f95ae002-6924-5fc8-bdc2-e3df6ecce540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461622} :answer-field/id #uuid "dfb38ab3-fc30-5c9a-b73e-48670489fbfe" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462564}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6d84ae8-2da9-539e-89fc-1e2b037b4578" :question/math-academy-id "q-110296" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 3 & 2 \\\\ 0 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}↔{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1}↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}:=(-5){R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :=(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =C\\end{aligned}\n$$\n\nTherefore, only $B$ and $C$ are elementary matrices."} {:db/id #edb/ref 17592186247106 :knowledge-point/_questions [{:db/id #edb/ref 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048897 :topic/id #uuid "ca2d5c2b-c710-5912-bab0-623e5d6f5c00" :topic/math-academy-id 1731 :topic/title "Elementary 3x3 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a20caaf5-55ed-50a8-9c16-3db9d13f58f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461623} {:answer/id #uuid "88a54ef8-32b5-5135-87f6-e5f1333a4f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461624}] :answer-field/correct {:answer/id #uuid "88a54ef8-32b5-5135-87f6-e5f1333a4f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461624} :answer-field/id #uuid "54012b06-a154-5d01-a786-1580b0324414" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462565} {:answer-field/choices [{:answer/id #uuid "96e31214-3d9d-56fa-8a9e-04bc79bd837a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461625} {:answer/id #uuid "ed987963-27f0-581d-9e0a-71c1f56eff2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461626}] :answer-field/correct {:answer/id #uuid "ed987963-27f0-581d-9e0a-71c1f56eff2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461626} :answer-field/id #uuid "d239a3f5-a495-5008-bcae-4c74c9d8e615" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462566} {:answer-field/choices [{:answer/id #uuid "f62530ad-31bd-5684-97fa-aa4e1c0e075e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461627} {:answer/id #uuid "fadb0d1e-0584-5d37-83f4-5d3313790b10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461628}] :answer-field/correct {:answer/id #uuid "fadb0d1e-0584-5d37-83f4-5d3313790b10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461628} :answer-field/id #uuid "6e637bd1-fb81-53d1-ad8f-f5e388adf393" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a29a5217-fb22-5ba1-a37e-09a1f7203c3e" :question/math-academy-id "q-110297" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{3}:={R}_{3}+9{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+9{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix} \\\\  & =A\\end{aligned}\n$$\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{2}↔{R}_{3},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}:={R}_{1}+4{R}_{3},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+4{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =C\\end{aligned}\n$$\n\nTherefore, $A,$ $B,$ and $C$ are elementary matrices."} {:db/id #edb/ref 17592186247121 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186048337 :topic/id #uuid "96874e3b-8b97-5c33-995d-d34a9d3daf21" :topic/math-academy-id 4077 :topic/title "Subspaces of N-Dimensional Space: Geometric Interpretation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dca237f8-afbe-53d7-93eb-c1a93103fb40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461629} {:answ