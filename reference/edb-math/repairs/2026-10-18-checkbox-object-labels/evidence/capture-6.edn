-bf00-37bb8b85761b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447985} :answer-field/id #uuid "2a8c9fe0-1804-511a-878d-7808f422bf08" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449032}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65e6b2ee-a472-5db0-bf96-384d33845a1c" :question/math-academy-id "q-109360" :question/problem "$$\n\\begin{aligned}u\\overset{A+9I\\,}{\\to }v\\overset{A+9I\\,}{\\to }w\\overset{A+9I\\,}{\\to }0 \\\\ x\\overset{A-I\\,}{\\to }y\\overset{A-I\\,}{\\to }z\\overset{A-I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A+9I$ and $A-I$ on the nonzero vectors $u,v,w,x,$ $y$ and $z$ as depicted above, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-9$ of $A$\n\n- **II.** $x$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **III.** $z$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false.  Since \n\n$$\nv\\overset{A+9I\\,}{\\to }w\\overset{A+9I\\,}{\\to }0,\n$$\n\n and $v\\ne 0,$ \ni.e. $A+9I$ maps $v$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized eigenvector of rank $2,$ not $1.$\n\n- Statement II is  false. Since \n\n$$\nx\\overset{A-I\\,}{\\to }y\\overset{A-I\\,}{\\to }z\\overset{A-I\\,}{\\to }0,\n$$\n\n \ni.e. $A-I$ maps $x$ to $0$ in $3$ steps, \nthe vector $x$ is a generalized eigenvector of rank $3,$ not $2.$\n\n- Statement III is true.  Indeed, since \n\n$$\nz\\overset{A-I\\,}{\\to }0,\n$$\n\ni.e. $A-1I$ maps $z$ to $0$ in $1$ step, \nthe vector $w$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186244291 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488d514c-7856-5bb1-9f27-61a06e12356e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447986} {:answer/id #uuid "2a601700-14b1-5b37-bc21-e9cb82917252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447987}] :answer-field/correct {:answer/id #uuid "488d514c-7856-5bb1-9f27-61a06e12356e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447986} :answer-field/id #uuid "dd010aa9-624f-5401-9ca7-3ba049f13042" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449033} {:answer-field/choices [{:answer/id #uuid "268e1ff9-ffef-534e-9702-84cc79d956ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447988} {:answer/id #uuid "f8ecc2bf-cf19-5dcd-8dc0-e365d5028bf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447989}] :answer-field/correct {:answer/id #uuid "268e1ff9-ffef-534e-9702-84cc79d956ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447988} :answer-field/id #uuid "8ad696ab-44e1-56ba-b3ee-b3265cbb73ea" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449034} {:answer-field/choices [{:answer/id #uuid "27b058b5-afc0-5cd6-ae4d-bd0a5bc33886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447990} {:answer/id #uuid "69ae4757-e4e5-5d91-83ff-acbbd8852af9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447991}] :answer-field/correct {:answer/id #uuid "69ae4757-e4e5-5d91-83ff-acbbd8852af9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447991} :answer-field/id #uuid "43c7aab5-a6e9-5835-b3b5-7835e5599b92" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449035}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c683813-90e6-5581-9ed4-32de3ac9d89f" :question/math-academy-id "q-109431" :question/problem "$$\n\\begin{aligned}v\\overset{A+20I\\,}{\\to }w\\overset{A+20I\\,}{\\to }0 \\\\ x\\overset{A-15I\\,}{\\to }y\\overset{A-15I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A+20I$ and $A-15I$ on the nonzero vectors $v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-20$ of $A$\n- **II.** $x$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =15$ of $A$\n- **III.** $w$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-20$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Since \n\n$$\nv\\overset{A+20I\\,}{\\to }w,\n$$\n\nand $w\\ne 0,$  the vector $v$ is  **not** a eigenvector corresponding  to the eigenvalue $\\lambda =-20$  of $A.$\n\n- Statement II is false. Since\n\n$$\nx\\overset{A-15I\\,}{\\to }y\\overset{A-15I\\,}{\\to }0,\n$$\n\n \ni.e. $A-15I$ maps $x$ to $0$ in $2$ steps, \nthe vector $x$ is a generalized eigenvector of rank $2,$ not $3.$\n\n- Statement III is true. Indeed, since\n\n$$\nw\\overset{A+20I\\,}{\\to }0,\n$$\n\ni.e. $A+20I$ maps $w$ to $0$ in $1$ step, \nthe vector $w$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue $\\lambda =-20$ of $A.$\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"} :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481770} :db/id #edb/ref 17592186482647}]} {:db/id #edb/ref 17592186244292 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49bb99f5-9999-5818-bdd3-812fc81de511" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461551} {:answer/id #uuid "abbbde6a-46b0-5c8a-a35a-867cbefd832c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461552}] :answer-field/correct {:answer/id #uuid "49bb99f5-9999-5818-bdd3-812fc81de511" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461551} :answer-field/id #uuid "a1ce2d44-f3a8-5077-afa5-fe22ffbe9aa5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462529} {:answer-field/choices [{:answer/id #uuid "84565946-12db-55cb-9543-b9e281a35249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461553} {:answer/id #uuid "76f7f31a-5fe5-53d8-be86-9a8aa1bf43ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461554}] :answer-field/correct {:answer/id #uuid "76f7f31a-5fe5-53d8-be86-9a8aa1bf43ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461554} :answer-field/id #uuid "8b4701ec-9c20-5683-826f-23655d031b58" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462530} {:answer-field/choices [{:answer/id #uuid "f1e1df6e-abab-5e94-81ce-ff2b595f6b04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461555} {:answer/id #uuid "480f381b-86af-52b5-a8fc-f0e2232f7875" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461556}] :answer-field/correct {:answer/id #uuid "f1e1df6e-abab-5e94-81ce-ff2b595f6b04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461555} :answer-field/id #uuid "e0f8dd13-47b4-5def-bd3c-ccfd3187627e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462531}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dab8a46d-1b84-5b26-b9d0-b9d19dd8bea3" :question/math-academy-id "q-109440" :question/problem "$$\n\\begin{aligned}u\\overset{A+4I\\,}{\\to }v\\overset{A+4I\\,}{\\to }w\\overset{A+4I\\,}{\\to }0 \\\\ x\\overset{A+3I\\,}{\\to }y\\overset{A+3I\\,}{\\to }z\\overset{A+3I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A+4I$ and $A+3I$ on the nonzero vectors $u,v,w,x,$ $y$ and $z$ as depicted above, which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nII. $x$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-3$ of $A$\n\nIII. $y$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-3$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Since\n\n$$\nv\\overset{A+4I\\,}{\\to }w\\overset{A+4I\\,}{\\to }0,\n$$\n\ni.e. $A+4I$ maps $v$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized eigenvector of rank $2,$ not $3.$\n\n- Statement II is  true. Indeed, since \n\n$$\nx\\overset{A+3I\\,}{\\to }y\\overset{A+3I\\,}{\\to }z\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $x$ to $0$ in $3$ steps, \nthe vector $x$ is a generalzed eigenvector of rank $3$ corresponding  to the eigenvalue $\\lambda =-3$ of $A.$\n\n- Statement III is false. Since\n\n$$\ny\\overset{A+3I\\,}{\\to }z\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $y$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized eigenvector of rank $2,$ not $1.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186244298 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138bb3b-2240-5c6f-8e4f-f5b183ab1ca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461557} {:answer/id #uuid "5f4cb01f-fd3b-5e22-8f85-d6d31e4e2aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461558}] :answer-field/correct {:answer/id #uuid "5f4cb01f-fd3b-5e22-8f85-d6d31e4e2aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461558} :answer-field/id #uuid "3325f4bf-863d-54b9-b3e2-675ef37d6a4e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462532} {:answer-field/choices [{:answer/id #uuid "5ec37e8f-a3b6-58e1-8ac0-ebf42f83c9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461559} {:answer/id #uuid "cf1643b0-dcf4-51e2-9dee-978dbc5d77dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461560}] :answer-field/correct {:answer/id #uuid "5ec37e8f-a3b6-58e1-8ac0-ebf42f83c9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461559} :answer-field/id #uuid "2c9d2262-c721-59fd-8663-dd7f70aa108c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462533} {:answer-field/choices [{:answer/id #uuid "7f3e9e53-b6e3-52c5-a18d-90e354f3cdd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461561} {:answer/id #uuid "167030fc-d98f-5d1e-b38a-bf7f33db7ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461562}] :answer-field/correct {:answer/id #uuid "167030fc-d98f-5d1e-b38a-bf7f33db7ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461562} :answer-field/id #uuid "3a39b7c6-5e57-56c4-b90a-de587ab18cd6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462534}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f8f24d7-923f-567b-b949-576aeecc58aa" :question/math-academy-id "q-109506" :question/problem "$$\nA=\\begin{bmatrix}3 & 0 \\\\ -2 & 3\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nIII. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine out statements.\n\nFirst, we compute $A-3I:$\n\n$$\nA-3I=\\begin{bmatrix}3 & 0 \\\\ -2 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ -2 & 0\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-3I:$\n\n$$\n(A-3I)v=\\begin{bmatrix}0 & 0 \\\\ -2 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n\\underbrace{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{v}\\overset{\\,A-3I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\n \n\nHere, we see that $A-3I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =3$ of $A.$*\n\nSo, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186246999 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac09a573-a23e-5936-81e2-8a4dc7b2d72e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461563} {:answer/id #uuid "6798f96f-447f-5faa-919e-de921ef0dc73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461564}] :answer-field/correct {:answer/id #uuid "ac09a573-a23e-5936-81e2-8a4dc7b2d72e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461563} :answer-field/id #uuid "da7b9358-fa9d-5ba7-99fd-16418a38ed31" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462535} {:answer-field/choices [{:answer/id #uuid "7f221f89-d270-5c37-a24e-41b0d1f210f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461565} {:answer/id #uuid "0368ad04-181d-5ae0-9f04-bf071ac6075f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461566}] :answer-field/correct {:answer/id #uuid "0368ad04-181d-5ae0-9f04-bf071ac6075f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461566} :answer-field/id #uuid "2918a440-120a-5271-b310-15bc39163202" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462536} {:answer-field/choices [{:answer/id #uuid "1eeeb0c6-e947-5a46-853c-7fd461e4302f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461567} {:answer/id #uuid "4a60962c-815b-574f-a2b5-bd3d0be1a5dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461568}] :answer-field/correct {:answer/id #uuid "1eeeb0c6-e947-5a46-853c-7fd461e4302f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461567} :answer-field/id #uuid "3ce4146e-cec5-5999-9d67-968a8eaa2ccc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c9bad97-e078-5fd9-8cb8-6324032501fd" :question/math-academy-id "q-109508" :question/problem "$$\nA=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+4I:$\n\n$$\nA+4I=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix}+4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+4I:$\n\n$$\n(A+4I)v=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+4I:$\n\n$$\n(A+4I)w=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{v}\\overset{A+4I\\,}{\\to }\\underbrace{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{w}\\overset{A+4I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+4I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A.$*\n\nSo, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186247000 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea90c8f5-d8b6-530a-bd3a-55a8a95477ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461569} {:answer/id #uuid "7f02e0f9-4218-50d0-8f74-b3bbce2ccd63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461570}] :answer-field/correct {:answer/id #uuid "7f02e0f9-4218-50d0-8f