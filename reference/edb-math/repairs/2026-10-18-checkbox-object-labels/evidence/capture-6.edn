ref 17592186437522} {:answer/id #uuid "6ad7502a-76db-51b2-ab1c-810e56d61640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437523}] :answer-field/correct {:answer/id #uuid "6ad7502a-76db-51b2-ab1c-810e56d61640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437523} :answer-field/id #uuid "872fa28f-f3f6-529b-b025-3590a2dbec87" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438790} {:answer-field/choices [{:answer/id #uuid "5475e656-b1d4-5bfd-b6f4-46f7fafdc2d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437524} {:answer/id #uuid "106d9768-5715-5dac-af04-f0b6918d6050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437525}] :answer-field/correct {:answer/id #uuid "5475e656-b1d4-5bfd-b6f4-46f7fafdc2d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437524} :answer-field/id #uuid "8ae75796-57c8-5a22-9fb5-6a059099c71c" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438791}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dda73782-2027-59b5-9ca3-37b046a17959" :question/math-academy-id "q-108581" :question/problem "![](images/89/89b0be0ca7ae1a6e76d32bfc669d6f554deaaad2055b2875e3f6a49821043205.png)\n\nWhich of the graphs above correspond to an invertible function?\n\nSelect all that apply." :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](images/cf/cfb095836b7498c91a5cbd9d2cb694715a0d89a12a5e6ea5ff417342c4bde798.png)\n\nFrom the above, we see that:\n\n- For graph III, any horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph III shows a one-to-one function. As a result, this function is invertible.\n\n- For graphs I, II, and IV, some horizontal lines intersect the curve more than once. These are not one-to-one functions. As a result, they are not invertible."} {:db/id #edb/ref 17592186244144 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4149ef3f-74da-5a1a-9c28-c1d8593e3ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437526} {:answer/id #uuid "f842b5cb-cf9f-52db-975f-f671411d8fd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437527}] :answer-field/correct {:answer/id #uuid "4149ef3f-74da-5a1a-9c28-c1d8593e3ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437526} :answer-field/id #uuid "e3063764-2764-5367-acd1-4008cf7a83c1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438792} {:answer-field/choices [{:answer/id #uuid "fc8acbc6-24a3-5fe2-8e8f-0aea2c2bb813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437528} {:answer/id #uuid "46cf5ec5-a0cb-5a49-a70d-2255503ed11e" :answ