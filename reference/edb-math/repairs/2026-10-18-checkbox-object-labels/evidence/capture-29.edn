f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a5e6cea-9241-53a3-82d5-505790a4c541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496612} {:answer/id #uuid "743744fc-7b9f-5477-9c24-7300f4f2feec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496617}] :answer-field/correct {:answer/id #uuid "5a5e6cea-9241-53a3-82d5-505790a4c541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496612} :answer-field/id #uuid "3707dfdd-8d9e-5d9c-9979-533ed76a733f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496606} {:answer-field/choices [{:answer/id #uuid "7a28255f-6bae-5cb3-92c5-4b920a7382c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496619} {:answer/id #uuid "d14b8f38-ffb9-5065-97fd-abafd5ba11a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496633}] :answer-field/correct {:answer/id #uuid "7a28255f-6bae-5cb3-92c5-4b920a7382c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496619} :answer-field/id #uuid "ca39cbab-2c34-51d7-930c-9483587fe929" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496629} {:answer-field/choices [{:answer/id #uuid "5d65d45f-9f95-5e5b-b2