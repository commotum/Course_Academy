bmatrix}-8 & 0 & 3 \\\\ 0 & 7 & -3 \\\\ 10 & -7 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186479922} {:answer-field/choices [{:answer/id #uuid "92ff392c-3617-5857-bb0b-90ec60551f8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186479927} {:answer/id #uuid "b764fd77-640c-5a94-adfb-926828fa54e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186479930}] :answer-field/correct {:answer/id #uuid "b764fd77-640c-5a94-adfb-926828fa54e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186479930} :answer-field/id #uuid "d74978fd-cbb2-591b-886c-5a3c10ea943f" :answer-field/key "$A=\\begin{bmatrix}7 & 0 & 9 & 0 \\\\ 0 & 0 & 0 & -8 \\\\ 0 & 0 & 10 & 4 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186479933}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "95bb49c4-214d-5ba6-82cc-f31f7a47c4fb" :question/problem "Which of the following matrices are upper triangular matrices?\n\nSelect all that apply." :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =10\\ne 0 \\\\ {c}_{32} & =7\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481762 :knowledge-point/_questions [{:db/id #edb/ref 17592186083201 :knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00" :knowledge-point/title "Identifying Divergent Improper Integrals" :topic/_knowledge-points [{:db/id #edb/ref 17592186048115 :topic/id #uuid "80368ff1-7296-5f6c-aa32-63547e29e578" :topic/math-academy-id 758 :topic/title "Improper Integrals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a656c4-82b8-5e88-8816-0dc0a192bb9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186481753} {:answer/id #uuid "80096874-46a7-55a9-a918-5e3243f639ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186481758}] :answer-field/correct {:answer/id #uuid "80096874-46a7-55a9-a918-5e3243f639ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186481758} :answer-field/id #uuid "23c3cc50-8f49-5f0a-a0d2-109c1fb2b62f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186481755} {:answer-field/choices [{:answer/id #uuid "145423fa-33a3-52aa-ae1d-b24235875c7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186481754} {:answer/id #uuid "3630167e-491c-546f-ac6e-210342635c1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186481756}] :answer-field/correct {:answer/id #uuid "3630167e-491c-546f-ac6e-210342635c1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186481756} :answer-field/id #uuid "9525a6e4-2431-55ce-91b6-40d7a688e4cf" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186481759} {:answer-field/choices [{:answer/id #uuid "775f0f81-df07-5d86-9ff9-7f28b4ccaf9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186481757} {:answer/id #uuid "d1da4748-78a9-5547-93fa-277269ba94ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186481761}] :answer-field/correct {:answer/id #uuid "d1da4748-78a9-5547-93fa-277269ba94ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186481761} :answer-field/id #uuid "b5ca4e79-9a78-5e09-ad2e-1b4358963f5c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186481760}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e50acc57-5eee-5203-9dd8-5e7531f41fa1" :question/problem "Which of the following improper integrals are divergent?\n- **I.** ${\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x$\n- **II.** ${\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x$\n- **III.** ${\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}}\\,\\text{d}x$\n\nSelect all that apply." :question/worked-solution "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[2\\sqrt{x-1}]}_{2}^{a} \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2\\sqrt{2-1}) \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}\\frac{1}{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\operatorname{ln}⁡|x|]}_{a}^{-1} \\\\  & ={lim}_{a\\to -\\infty }(\\operatorname{ln}⁡|-1|-\\operatorname{ln}⁡|a|) \\\\  & =-\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{x}]}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{a}+\\frac{1}{1}) \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent.\n\nIn conclusion, only integrals I and II are divergent."} {:db/id #edb/ref 17592186488404 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "539855fa-6c5d-53c2-8e6b-3ae037750849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186488400 :task-item/_responses [{:db/id #edb/ref 17592186576360 :task-item/content {:db/id #edb/ref 17592186488404} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "88990fe2-e5bf-51c0-a552-f3a9611b1ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186488401}] :answer-field/correct {:answer/id #uuid "539855fa-6c5d-53c2-8e6b-3ae037750849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186488400 :task-item/_responses [{:db/id #edb/ref 17592186576360 :task-item/content {:db/id #edb/ref 17592186488404} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "1f123478-0b1d-5380-b456-3eb2029b111c" :answer-field/key "$B$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186488396} {:answer-field/choices [{:answer/id #uuid "1094c3c3-975f-530e-bff0-7807d9d9ab97" :answer/type {: