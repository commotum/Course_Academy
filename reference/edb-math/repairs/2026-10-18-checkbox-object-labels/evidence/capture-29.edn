pe {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186476093}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34b6a301-7e77-5853-a6c2-a712e719b29f" :question/problem "Which of the following is a $3\\times 3$ matrix?\n\nSelect all that apply.\n\n$$\nP = \\begin{bmatrix}\\sqrt{2} & -3 & -0.1 \\\\ 2 & 1 & 4 \\\\ 0 & 1.1 & -3\\end{bmatrix}\n$$\n\n$$\nQ = \\begin{bmatrix}-3 & 7 & -0.1 \\\\ -0.1 & 0 & \\sqrt{3}\\end{bmatrix}\n$$\n\n$$\nR = \\begin{bmatrix}4 & -2 & \\sqrt{3} & -0.1 \\\\ 2 & 7 & 1 & 3 \\\\ 0 & 0 & 0 & \\sqrt{2}\\end{bmatrix}\n$$" :question/worked-solution "- The matrix $P$ has $3$ rows and $3$ columns. So, its dimensions are $3\\times 3.$ $\\,✓$\n\n- The matrix $Q$ has $2$ rows and $3$ columns. So, its dimensions are $2\\times 3.$ $\\,\\times $\n\n- The matrix $R$ has $3$ rows and $4$ columns. So, its dimensions are $3\\times 4.$ $\\,\\times $\n\nTherefore, only $P$ is a $3\\times 3$ matrix."} {:db/id #edb/ref 17592186476046 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186048896 :topic/id #uuid "ca183854-66cd-5b1f-9d29-03785c3216b8" :topic/math-academy-id 861 :topic/title "Introduction to Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4daf14b0-aa28-5059-afdd-ffa5401e3813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186476033} {:answer/id #uuid "e2de35ae-2d24-56a1-ac6f-55586962b70b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186476092}] :answer-field/correct {:answer/id #uuid "e2de35ae-2d24-56a1-ac6f-55586962b70b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text