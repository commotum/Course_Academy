-solution "The matrices $A$ and $B$ are lower triangular matrices since all the entries above the main diagonal are zeros.\n\nThe matrix $C$ is *not* a lower triangular matrix since it has a non-zero element above the main diagonal: \n\n$$\n\\begin{aligned}{c}_{12} & =2\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479914 :knowledge-point/_questions [{:db/id #edb/ref 17592186119772 :knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc" :knowledge-point/title "Identifying a Triangular Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3134bb79-8649-57fa-abcd-16a6ab38fbaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186479921} {:answer/id #uuid "764ed816-8787-5076-98dd-1c3b168501d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186479925}] :answer-field/correct {:answer/id #uuid "764ed816-8787-5076-98dd-1c3b168501d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186479925} :answer-field/id #uuid "24f3da38-d1e2-5f54-8d65-64e6db935e0a" :answer-field/key "$B=\\begin{bmatrix}-7 & 0 & 2 \\\\ 0 & 4 & 7 \\\\ -1 & 5 & -9\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186479916} {:answer-field/choices [{:answer/id #uuid "9108f5ab-b178-5d40-aa32-e6345497ae54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186479926} {:answer/id #uuid "f86f042d-c2f3-5f2e-9c91-5d865e69da55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186479937}] :answer