field/choices [{:answer/id #uuid "67e05fc1-6f27-5a55-b0b8-2454bb824ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512022} {:answer/id #uuid "b7d3bbf8-afc9-50d1-a551-cec7b4370f7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186512059}] :answer-field/correct {:answer/id #uuid "67e05fc1-6f27-5a55-b0b8-2454bb824ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512022} :answer-field/id #uuid "8a1d64d3-cc73-5c25-8f75-374c7c718c4a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186512042} {:answer-field/choices [{:answer/id #uuid "3aa5caf5-667a-5d0e-b3dd-09947d8deafd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186512002} {:answer/id #uuid "4464d916-5dd5-58e9-a4d3-34f78b7e2336" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512011}] :answer-field/correct {:answer/id #uuid "4464d916-5dd5-58e9-a4d3-34f78b7e2336" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512011} :answer-field/id #uuid "9f7f8471-d306-5267-a916-084d0ff2554f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186512051}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e62133c8-9957-522b-ac43-c73e3353a608" :question/problem "Which of the following statements are true regarding the function $y=\\cos x$? Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The complete set of inputs at which the function has zeros is $x=n\\pi.$\n- **II.** The complete set of inputs at which the function has maximum values is $x=n\\pi.$\n- **III.** The complete set of inputs at which the function has minimum values is $x=\\pi+2n\\pi.$" :question/worked-solution "Let's plot the graph of $y=\\cos x$.\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement I is false. The zeros occur at $x=\\frac{\\pi}{2}+n\\pi$. Every zero must be included.\n\n- Statement II is false. The maximum value is $1$, attained at $x=2n\\pi$. Every maximum input must be included.\n\n- Statement III is true. The minimum value is $-1$, attained at $x=\\pi+2n\\pi$. Every minimum input must be included."} {:db/id #edb/ref 17592186513032 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137d4f4e-74af-5d41-b80a-53934c9dd028" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513035} {:answer/id #uuid "cd4ea36e-8e0c-52de-bf81-a2a939c9d472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513079}] :answer-field/correct {:answer/id #uuid "cd4ea36e-8e0c-52de-bf81-a2a939c9d472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513079} :answer-field/id #uuid "523762b1-5a6f-5bc9-9c5f-40cf749f2fa6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186513056} {:answer-field/choices [{:answer/id #uuid "07c32bb1-32b3-5f2a-9a16-528b55e0e374" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513030} {:answer/id #uuid "652bf4b1-f67c-53f8-803c-b0ecdf18e329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513058}] :answer-field/correct {:answer/id #uuid "652bf4b1-f67c-53f8-803c-b0ecdf18e329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513058} :answer-field/id #uuid "d00c1508-a5bb-5bd1-aac8-883af6e66c84" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186513080} {:answer-field/choices [{:answer/id #uuid "a58b7aef-9928-5d29-9b06-bfd7f833b4da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513067} {:answer/id #uuid "cbcbfa36-7793-50b7-add2-58f15ee36dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513077}] :answer-field/correct {:answer/id #uuid "cbcbfa36-7793-50b7-add2-58f15ee36dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513077} :answer-field/id #uuid "fb6b3a4e-16cb-5aa7-a937-e322b7dac4b1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186513088}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a972469-92c6-5025-b8f5-75835bec6279" :question/problem "![](images/ef/efc2a0fcf4999a4ab32cdd5957a87ec7bf782cdb1ecac743551fd0509b983f6b.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply.\n\nI. $x\\in (-2,0]$\n\nII. $x\\in [0,4]$\n\nIII. $x\\in [-1,4]$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- On interval I, $x\\in (-2,0]$, the function is invertible. Indeed, any horizontal line will intersect the restricted graph at most once, no matter where we draw the line.\n\n- On interval II, $x\\in [0,4]$, the function is invertible. Indeed, any horizontal line will intersect the restricted graph at most once, no matter where we draw the line.\n\n- On interval III, $x\\in [-1,4]$, the function is **not** invertible. Some horizontal lines will intersect the restricted graph more than once.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186513034 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46145733-2a91-595a-9887-3c27f126163b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513051} {:answer/id #uuid "4e283f29-9e66-57a6-8d2d-ce7602205610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513054}] :answer-field/correct {:answer/id #uuid "4e283f29-9e66-57a6-8d2d-ce7602205610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513054} :answer-field/id #uuid "b279fd60-6bf8-5bfe-a026-b8526fbfbc01" :answer-field/key "III" :answer-field/type {