answer-field.type/checkbox} :db/id #edb/ref 17592186474144}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1a9f6cf-cd8d-55d6-a82c-4176e7807557" :question/math-academy-id "q-86027" :question/problem "Which of the following residue classes modulo $10$ contain the integer $-4?$\n\nI. $[4]_{10}$\n\nII. $[-14]_{10}$\n\nIII. $[6]_{10}$\n\nSelect all that apply." :question/worked-solution "We have $-4\\in [a]_{10}$ if \n\n$$\n-4≡a\\,(\\text{mod}\\,10).\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $-4\\notin [4]_{10}$ because $-4≢4\\,(\\text{mod}\\,10)$ $\\,\\times $\n\n- $-4\\in [-14]_{10}$ because $-4≡-14\\,(\\text{mod}\\,10)$ $\\,✓$\n\n- $-4\\in [6]_{10}$ because $-4≡6\\,(\\text{mod}\\,10)$ $\\,✓$\n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186412976 :knowledge-point/_questions [{:db/id #edb/ref 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2989d3f5-e299-5e13-bb8a-b7064a9233d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473482} {:answer/id #uuid "6c9cdab6-aa49-55e9-8afe-7c6732a14f3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473483}] :answer-field/correct {:answer/id #uuid "6c9cdab6-aa49-55e9-8afe-7c6732a14f3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473483} :answer-field/id #uuid "f105e393-0d4e-5cd9-95e1-080f8b0997da" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474136} {:answer-field/choices [{:answer/id #uuid "791e2c07-f9e0-5833-affc-a49d179306b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473484} {:answer/id #uuid "4be581e8-2b53-5031-9a14-9bd216201b06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473485}] :answer-field/correct {:answer/id #uuid "4be581e8-2b53-5031-9a14-9bd216201b06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473485} :answer-field/id #uuid "48a46f61-32d6-5a27-b993-971fcbdcc92f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474137} {:answer-field/choices [{:answer/id #uuid "2e0b3d03-bc5f-59ea-9e2c-be14ee34585d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473486} {:answer/id #uuid "8e944c4d-6416-5188-af2c-562ec21ad55b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473487}] :answer-field/correct {:answer/id #uuid "2e0b3d03-bc5f-59ea-9e2c-be14ee34585d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473486} :answer-field/id #uuid "790148cb-92d0-592c-a116-6d1fe4e937e5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474138}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e91f8fe9-c6f2-558a-bf39-b0389019d5ff" :question/math-academy-id "q-86021" :question/problem "Which of the following integers belong to the residue class $[7]_{11}?$\n\nI. $18$\n\nII. $-4$\n\nIII. $15$\n\nSelect all that apply." :question/worked-solution "The residue class $[7]_{11}$ consists of the elements that are congruent to $7$ modulo $11.$ So, we have\n\n$$\n\\begin{aligned}[7]_{11} & =\\{x\\in Z\\,|\\,x≡7\\,(\\text{mod}\\,11)\\} \\\\  & =\\{x\\in Z\\,|\\,x=7+11k,\\,k\\in Z\\} \\\\  & =\\{7+11k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,7-2\\cdot 11,\\,7-11,\\,7,\\,7+11,\\,7+2\\cdot 11,…\\} \\\\  & =\\{…,-15,-4,7,18,29,…\\}.\\end{aligned}\n$$\n\nWe see that $-4$ and $18$ belong to $[7]_{11},$ while $15$ does not.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186412977 :knowledge-point/_questions [{:db/id #edb/ref 17592186152100 :knowledge-point/id #uuid "d1a842b5-7256-59cd-b33f-d590bc315d84" :knowledge-point/title "Identifying True Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99c866b5-fa78-5463-879f-91c030b81919" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453994} {:answer/id #uuid "ed31939a-f058-5205-8c6b-722767e7b7c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453995}] :answer-field/correct {:answer/id #uuid "ed31939a-f058-5205-8c6b-722767e7b7c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453995} :answer-field/id #uuid "d9c2fd1a-fb98-5cd0-b399-c001871510bd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454747} {:answer-field/choices [{:answer/id #uuid "4e0d1411-6ced-5ae0-ac91-be6911cf7935" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453996} {:answer/id #uuid "4793bdef-ca97-5b0f-8ccf-abb72b491ceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453997}] :answer-field/correct {:answer/id #uuid "4793bdef-ca97-5b0f-8ccf-abb72b491ceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453997} :answer-field/id #uuid "31727710-9d5d-5ec7-b533-3911fcb1abea" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454748} {:answer-field/choices [{:answer/id #uuid "320480f6-35f8-534c-b475-8279339d8454" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453998} {:answer/id #uuid "6887d8ad-0703-528f-abc1-66d945caef6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453999}] :answer-field/correct {:answer/id #uuid "6887d8ad-0703-528f-abc1-66d945caef6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453999} :answer-field/id #uuid "33f65df0-556a-5ca2-b14a-a5fd084c424a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f68491fc-7fbf-551d-bb56-21bac80c159f" :question/math-academy-id "q-78644" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** There are $11$ distinct residue classes modulo $11$\n\n- **II.** $[7]_{5}\\cap [2]_{5}\\ne ∅$\n\n- **III.** $Z=[0]_{4}\\cup [9]_{4}\\cup [2]_{4}\\cup [15]_{4}$" :question/worked-solution "Recall that the residue classes modulo $n$ have the following properties:\n\n- There are exactly $n$ distinct residue classes modulo $n$\n\n- Two distinct residue classes have an empty intersection: $[a]_{n}\\cap [b]_{n}=∅$ if $a≢b\\,(\\text{mod}\\,n)$\n\n- Residue classes modulo $n$ form a partition of the set of all integers: \n\n$$\nZ=[0]_{n}\\cup [1]_{n}\\cup ⋯\\cup [n-1]_{n}\n$$\n\n- The integers modulo $n$ is defined as the set containing all distinct residue classes modulo $n$: \n\n$$\n{Z}_{n}=\\{[0]_{n},\\,[1]_{n},\\,…,\\,[n-1]_{n}\\}\n$$\n\nWith that in mind, let's now consider each of the given statements.\n\n- Statement I is true. There are $11$ distinct residue classes modulo $11.$\n\n- Statement II is true. Indeed, since $7≡2\\,(\\text{mod }5),$ we have that $[7]_{5}=[2]_{5}.$ Therefore, $[7]_{5}\\cap [2]_{5}\\ne ∅.$\n\n- Statement III is true. First, notice the following:\n\n$$\n\\begin{aligned}[9]_{4} & =[1+4\\cdot 2]_{4}=[1]_{4} \\\\ [15]_{4} & =[3+4\\cdot 3]_{4}=[3]_{4}\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}[0]_{4}\\cup [9]_{4}\\cup [2]_{4}\\cup [15]_{4} & =[0]_{4}\\cup [1]_{4}\\cup [2]_{4}\\cup [3]_{4} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."} {:db/id #edb/ref 17592186412998 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8610a0d2-fdc1-5ffb-bb7d-fa4d5ec60050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453246} {:answer/id #uuid "1106162e-004a-5376-84ea-4d09f59735a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453247}] :answer-field/correct {:answer/id #uuid "1106162e-004a-5376-84ea-4d09f59735a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453247} :answer-field/id #uuid "16308504-1737-59ec-85f8-6aae9a6e62ca" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454373} {:answer-field/choices [{:answer/id #uuid "654b12c7-247f-59a8-b59b-c9aa7e6df741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453248} {:answer/id #uuid "d1caa7bb-f241-5fda-a091-982727ce423c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453249}] :answer-field/correct {:answer/id #uuid "654b12c7-247f-59a8-b59b-c9aa7e6df741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453248} :answer-field/id #uuid "dec4b167-b790-52bb-b09f-3c495acb1957" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454374} {:answer-field/choices [{:answer/id #uuid "7fb38f24-ce58-5679-8e4c-5ab1475e60b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453250} {:answer/id #uuid "c9beb16d-fb59-5d8a-9e62-f88859d6a643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453251}] :answer-field/correct {:answer/id #uuid "c9beb16d-fb59-5d8a-9e62-f88859d6a643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453251} :answer-field/id #uuid "291c74d0-3740-5390-9af2-8599a8ba49e9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28941d92-3462-55d4-9376-780e240021c7" :question/math-academy-id "q-109277" :question/problem "$$\n\\begin{aligned}u\\overset{A+3I\\,}{\\to }v\\overset{A+3I\\,}{\\to }w\\overset{A+3I\\,}{\\to }0 \\\\ x\\overset{A-3I\\,}{\\to }y\\overset{A-3I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A+3I$ and $A-3I$ on the nonzero vectors $u,v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A$\n\n- **II.** $u$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A$\n\n- **III.** $y$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\nv\\overset{A+3I\\,}{\\to }w\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $v$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized  eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A.$\n\n- Statement II is false. Since\n\n$$\nu\\overset{A+3I\\,}{\\to }v\\overset{A+3I\\,}{\\to }w\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $u$ to $0$ in $3$ steps, \nthe vector $u$ is a generalized eigenvector of rank $3,$ not $2.$\n\n- Statement III is true. Indeed, since\n\n$$\ny\\overset{A-3I\\,}{\\to }0,\n$$\n\ni.e. $A-3I$ maps $y$ to $0$ in $1$ step, \nthe vector $y$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A.$\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"} :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412979} :db/id #edb/ref 17592186413002} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"} :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436616} :db/id #edb/ref 17592186436620}]} {:db/id #edb/ref 17592186412999 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "787f9f37-580f-5658-9df9-ce826b611451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472496} {:answer/id #uuid "c4403496-69e1-5d08-b02d-1b03668dd8c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472497}] :answer-field/correct {:answer/id #uuid "787f9f37-580f-5658-9df9-ce826b611451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472496} :answer-field/id #uuid "0f1a3fb6-945f-5879-9865-fdc5a922c3f4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473643} {:answer-field/choices [{:answer/id #uuid "7460c1a4-dd63-595d-8732-ee34d9a2c09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472498} {:answer/id #uuid "71f5c96a-5c5b-5605-9ce0-b480c9528139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472499}] :answer-field/correct {:answer/id #uuid "7460c1a4-dd63-595d-8732-ee34d9a2c09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472498} :answer-field/id #uuid "a767f879-2f51-5809-aebb-daff65b44383" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473644} {:answer-field/choices [{:answer/id #uuid "2a97ed2f-d3d1-546a-874d-42ae2f24fc40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472500} {:answer/id #uuid "be2ff147-060f-5c7b-81e0-38256805dec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472501}] :answer-field/correct {:answer/id #uuid "be2ff147-060f-5c7b-81e0-38256805dec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472501} :answer-field/id #uuid "b3046741-713a-58b0-a1a8-53bf395bbfbb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e5966d3-ce4d-5835-ab91-1f478e587602" :question/math-academy-id "q-109510" :question/problem "$$\nA=\\begin{bmatrix}1 & -1 \\\\ 1 & 3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}1 & -1 \\\\ 1 & 3\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}}_{v}\\overset{\\,A-2I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}}_{w}\\overset{\\,A-2I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"} :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412979} :db/id #edb/ref 17592186413003}]} {:db/id #edb/ref 17592186413000 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition" :topic/_knowledge-points [{:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6b747f5-b6fd-5eba-ae77-a9174a9eb0e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453252} {:answer/id #uuid "52b890bf-1e84-54cf-9889-91651247a068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453253}] :answer-field/correct {:answer/id #uuid "52b890bf-1e84-54cf-9889-91651247a068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453253} :answer-field/id #uuid "43c1092e-91a4-5e66-9c90-37891305f270" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454376} {:answer-field/choices [{:answer/id #uuid "fc93c4a8-f3e6-52d8-9ef2-057cd1fd00b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453254} {:answer/id #uuid "9e356dd9-cc07-5fef-886f-0f4115f8b97a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453255}] :answer-field/correct {:answer/id #uuid "fc93c4a8-f3e6-52d8-9ef2-057cd1fd00b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453254} :answer-field/id #uuid "4825cadc-9f85-54bd-99c2-cb4b67256536" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454377} {:answer-field/choices [{:answer/id #uuid "604f4f38-dfc8-500b-b033-c1d586698b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453256} {:answer/id #uuid "00d18245-d9fc-5c4f-8e90-f44ae94f6e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453257}] :answer-field/correct {:answer/id #uuid "604f4f38-dfc8-500b-b033-c1d586698b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453256} :answer-field/id #uuid "205d0d73-77db-5f0e-9eb3-e7a3ed04c9e4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eddb46c6-735a-5bdf-b2a2-b57344c5441a" :question/math-academy-id "q-109434" :question/problem "$$\n\\begin{aligned}s\\overset{A-4I\\,}{\\to }u\\overset{A-4I\\,}{\\to }v\\overset{A-4I\\,}{\\to }w\\overset{A-4I\\,}{\\to }0 \\\\ x\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }y\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A-4I$ and $A$ on the nonzero vectors $s,u,v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $s$ is a generalized  eigenvector of rank $4$  corresponding to the eigenvalue $\\lambda =4$ of $A$\n- **II.** $x$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =0$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =4$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\ns\\overset{A-4I\\,}{\\to }u\\overset{A-4I\\,}{\\to }v\\overset{A-4I\\,}{\\to }w\\overset{A-4I\\,}{\\to }0,\n$$\n\ni.e. $A-4I$ maps $s$ to $0$ in $4$ steps, \nthe vector $s$ is an generalized eigenvector of rank $4$  corresponding to the eigenvalue $\\lambda =4$ of $A.$\n\n- Statement II is false. Since\n\n$$\nx\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }y\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }0,\n$$\n\ni.e. $A=A-0I$ maps $x$ to $0$ in $2$ steps, \nthe vector $x$ is a generalized eigenvector of rank $2,$ not $1.$\n\n- Statement III is false. Since\n\n$$\nv\\overset{A-4I\\,}{\\to }w\\overset{A-4I\\,}{\\to }0,\n$$\n\ni.e. $A-4I$ maps $v$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized eigenvector of rank $2,$ not $3.$\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"} :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412979} :db/id #edb/ref 17592186413001} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"} :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481770} :db/id #edb/ref 17592186482633}]} {:db/id #edb/ref 17592186413341 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186048495 :topic/id #uuid "a4841cae-d95f-5e07-960c-2030a42a2568" :topic/math-academy-id 2975 :topic/title "Evaluating Definite Integrals Using Symmetry"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b50a042-fd0e-5d6e-bb0f-935ead60737a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473518} {:answer/id #uuid "6c7d15ef-aaf6-55d7-982b-505c97a0f6c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473519}] :answer-field/correct {:answer/id #uuid "1b50a042-fd0e-5d6e-bb0f-935ead60737a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473518} :answer-field/id #uuid "3c92a1b6-0af5-5cc3-a70f-34e4b7402c1a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474154} {:answer-field/choices [{:answer/id #uuid "dcf2fbc9-664b-5c12-9f73-578676d097bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473520} {:answer/id #uuid "41efc32c-150f-59ff-afb4-a285f47f9892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473521}] :answer-field/correct {:answer/id #uuid "41efc32c-150f-59ff-afb4-a285f47f9892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473521} :answer-field/id #uuid "b7230e64-9d33-5d1e-868c-637788a6c48f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474155} {:answer-field/choices [{:answer/id #uuid "0e959c24-0b7b-5159-be20-0712f3305ce5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473522} {:answer/id #uuid "29d89754-823e-51b8-a1b3-06fb6113390e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473523}] :answer-field/correct {:answer/id #uuid "29d89754-823e-51b8-a1b3-06fb6113390e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473523} :answer-field/id #uuid "f7cc23dd-00ba-5f1f-95ae-d41251462553" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474156}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c87590b-cc07-5050-b79f-9ad013757661" :question/math-academy-id "q-88693" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n- **I.** ${\\int }_{-6}^{6}x\\operatorname{sin}⁡x\\,\\text{d}x$\n- **II.** ${\\int }_{-2}^{2}{x}^{3}\\operatorname{cos}⁡x\\,\\text{d}x$\n- **III.** ${\\int }_{-1}^{1}{x}^{2}\\operatorname{tan}⁡x\\,\\text{d}x$\n\nSelect all that apply." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=x\\operatorname{sin}⁡x$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)\\operatorname{sin}⁡(-x) \\\\  & =-x(-\\operatorname{sin}⁡x) \\\\  & =x\\operatorname{sin}⁡x \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)={x}^{3}\\operatorname{cos}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)^{3}\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}\\operatorname{cos}⁡x \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nHence, by symmetry, we can conclude that\n\n$$\n{\\int }_{-2}^{2}{x}^{3}\\operatorname{cos}⁡x\\,\\text{d}x=0.\n$$\n\n- The function $h(x)={x}^{2}\\operatorname{tan}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{2}\\operatorname{tan}⁡(-x) \\\\  & ={x}^{2}(-\\operatorname{tan}⁡x) \\\\  & =-{x}^{2}\\operatorname{tan}⁡x \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-1}^{1}{x}^{2}\\operatorname{tan}⁡x\\,\\text{d}x=0.\n$$\n\nHence, the correct answer is \"II and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048495 :topic/id #uuid "a4841cae-d95f-5e07-960c-2030a42a2568" :topic/math-academy-id 2975 :topic/title "Evaluating Definite Integrals Using Symmetry"} :activity/title "Evaluating Definite Integrals Using Symmetry" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186413324} :db/id #edb/ref 17592186413348}]} {:db/id #edb/ref 17592186413343 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186048495 :topic/id #uuid "a4841cae-d95f-5e07-960c-2030a42a2568" :topic/math-academy-id 2975 :topic/title "Evaluating Definite Integrals Using Symmetry"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5901841-e8c8-5cbf-a277-7f5d6bd154ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472508} {:answer/id #uuid "89815d70-f7a8-5a3d-8dc6-edd3a9b414b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472509}] :answer-field/correct {:answer/id #uuid "b5901841-e8c8-5cbf-a277-7f5d6bd154ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472508} :answer-field/id #uuid "8ad307b8-c32d-51ae-9cc5-239fd502f244" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473649} {:answer-field/choices [{:answer/id #uuid "675b79aa-0b55-56b0-b75a-127b830e9a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472510} {:answer/id #uuid "a52bb3cf-32df-58c4-893f-1fc229df6b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472511}] :answer-field/correct {:answer/id #uuid "675b79aa-0b55-56b0-b75a-127b830e9a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472510} :answer-field/id #uuid "2847c887-d4df-5a65-acf5-493a754fad3e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473650} {:answer-field/choices [{:answer/id #uuid "ef07f37d-ed46-50c3-8961-01e5ac788b9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472512} {:answer/id #uuid "33cab82b-32ec-5fa0-9569-1db28a6ff758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472513}] :answer-field/correct {:answer/id #uuid "33cab82b-32ec-5fa0-9569-1db28a6ff758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472513} :answer-field/id #uuid "e2e79f4d-084b-5b53-8f38-886deae491b2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473651}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93763c90-6504-59a6-ad5e-8ed17cc5ac6d" :question/math-academy-id "q-115272" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n- **I.** ${\\int }_{-1}^{1}{e}^{2x}\\,\\text{d}x$\n- **II.** ${\\int }_{0}^{\\pi }\\sqrt[3]{x}\\operatorname{cos}⁡x\\,\\text{d}x$\n- **III.** ${\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={e}^{2x}$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & ={e}^{2(-x)} \\\\  & ={e}^{-2x} \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)=\\sqrt[3]{x}\\operatorname{cos}⁡x$ is an odd function, but integral II is not of the form ${\\int }_{-a}^{a}g(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\n- The function $h(x)=x{e}^{{x}^{2}}$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x){e}^{(-x)^{2}} \\\\  & =-x{e}^{{x}^{2}} \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048495 :topic/id #uuid "a4841cae-d95f-5e07-960c-2030a42a2568" :topic/math-academy-id 2975 :topic/title "Evaluating Definite Integrals Using Symmetry"} :activity/title "Evaluating Definite Integrals Using Symmetry" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186413324} :db/id #edb/ref 17592186413347}]} {:db/id #edb/ref 17592186413394 :knowledge-point/_questions [{:db/id #edb/ref 17592186166962 :knowledge-point/id #uuid "544f5154-5213-5898-a45d-4546bc8004c8" :knowledge-point/title "Understanding the Periodic Extension of a Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049306 :topic/id #uuid "eb34afb7-9644-525e-b42b-cf82816ee5e0" :topic/math-academy-id 3195 :topic/title "Introduction to Fourier Series"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d69c9191-c57b-5b40-996e-777a184d420f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453862} {:answer/id #uuid "8e937e18-ad9e-5187-bca2-d80188955602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453863}] :answer-field/correct {:answer/id #uuid "8e937e18-ad9e-5187-bca2-d80188955602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453863} :answer-field/id #uuid "aab8922e-9958-52a6-a909-10999fa1e976" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454681} {:answer-field/choices [{:answer/id #uuid "eb70ef1e-3935-56b9-8d61-37338f1abc9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453864} {:answer/id #uuid "69936ea4-5a61-553c-a841-0f8856c0048e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453865}] :answer-field/correct {:answer/id #uuid "69936ea4-5a61-553c-a841-0f8856c0048e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453865} :answer-field/id #uuid "fe49bd90-5b54-5fa2-af50-8f2dcd2530ea" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454682} {:answer-field/choices [{:answer/id #uuid "2ccc571d-7d63-5a29-b24d-f2770276a3af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453866} {:answer/id #uuid "7853f114-0b0e-5904-b1fc-5803694d16fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453867}] :answer-field/correct {:answer/id #uuid "7853f114-0b0e-5904-b1fc-5803694d16fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453867} :answer-field/id #uuid "5a801a5f-980e-5406-9300-a022a15791c4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454683}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d1f9132-9d3c-569e-af11-701e82cf296a" :question/math-academy-id "q-340515" :question/problem "Let $F(x)=\\operatorname{sin}⁡(4x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{2}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{2})$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\n- **II.** $f(x)=F(x)$ for all $x\\in R$\n\n- **III.** $f(x+2\\pi )=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $\\frac{\\pi }{2}$-periodic extension of $F,$ we have \n\n- $f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. This is exactly the definition of $\\frac{\\pi }{2}$-periodicity:\n\n$$\nf(x)=F(x)\n$$\n\n \nfor all $x\\in [0,\\frac{\\pi }{2}).$\n\n- Statement II is true. Notice that $F$ itself is $\\frac{\\pi }{2}$-periodic, because for any $x\\in R,$ we have\n\n$$\n\\begin{aligned}F(x+\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(4(x+\\frac{\\pi }{2})) \\\\  & =\\operatorname{sin}⁡(4x+2\\pi ) \\\\  & =\\operatorname{sin}⁡(4x) \\\\  & =F(x).\\end{aligned}\n$$\n\nSince $F$ already satisfies the periodicity rule, the $\\frac{\\pi }{2}$-periodic extension agrees with $F$ everywhere, so $f(x)=F(x)$ for all $x\\in R.$\n\n- Statement III is true. Since $f$ has period $\\frac{\\pi }{2},$\n\n$$\n\\begin{aligned}f(x+2\\pi )=f(x+4\\cdot \\frac{\\pi }{2})=f(x).\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."} {:db/id #edb/ref 17592186413395 :knowledge-point/_questions [{:db/id #edb/ref 17592186166962 :knowledge-point/id #uuid "544f5154-5213-5898-a45d-4546bc8004c8" :knowledge-point/title "Understanding the Periodic Extension of a Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049306 :topic/id #uuid "eb34afb7-9644-525e-b42b-cf82816ee5e0" :topic/math-academy-id 3195 :topic/title "Introduction to Fourier Series"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5ad7ce-a85f-5146-b73d-5c45f8bd9216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453856} {:answer/id #uuid "0d314fdc-6ea0-598d-907c-085dc1c84e06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453857}] :answer-field/correct {:answer/id #uuid "0d314fdc-6ea0-598d-907c-085dc1c84e06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453857} :answer-field/id #uuid "43975daa-88ca-549f-9c10-9ddfb429828c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454678} {:answer-field/choices [{:answer/id #uuid "d38eed8e-9345-5eb0-ad4b-4cb3cb071b6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453858} {:answer/id #uuid "03d7439a-1e1f-5e9b-ba05-1b9e13ddc7ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453859}] :answer-field/correct {:answer/id #uuid "d38eed8e-9345-5eb0-ad4b-4cb3cb071b6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453858} :answer-field/id #uuid "72dae627-5309-5b18-9260-7056c334cd57" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454679} {:answer-field/choices [{:answer/id #uuid "be925691-ed91-5787-a733-cd76fa4329cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453860} {:answer/id #uuid "d9310b4e-b012-578f-8840-b20475d111f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453861}] :answer-field/correct {:answer/id #uuid "be925691-ed91-5787-a733-cd76fa4329cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453860} :answer-field/id #uuid "0916c6fa-5ef9-5bab-8f27-693033e2a146" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e155a024-962b-5f82-95d5-406e9c9d0535" :question/math-academy-id "q-340506" :question/problem "Let $G(x)=x+1$ for $x\\in R.$ Suppose $g(x)$ is the $4$-periodic extension of $G(x)$ from $x\\in [0,4)$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $g(x+8)=g(x)$ for all $x\\in R$\n\n- **II.** $g(x)=G(x)$ for all $x\\in R$\n\n- **III.** $g(x+2)=g(x)$ for all $x\\in R$" :question/worked-solution "Since $g$ is the $4$-periodic extension of $G,$ we have \n\n- $g(x+4)=g(x)$ for all $x\\in R,$ and\n\n- $g(x)=G(x)$ for all $x\\in [0,4).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}g(x+8)=g((x+4)+4)=g(x+4)=g(x)\\end{aligned}\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=5.$ Then,\n\n$$\n\\begin{aligned}g(5)=g(1+4)=g(1)=G(1)=2,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}G(5)=5+1=6.\\end{aligned}\n$$\n\nHence, $g(x)\\ne G(x)$ for $x=5.$\n\n- Statement III is false. For example, take $x=1.$ Then, \n\n$$\n\\begin{aligned}g(1+2)=g(3)=G(3)=4\\end{aligned}\n$$\n\nwhile \n\n$$\n\\begin{aligned}g(1)=G(1)=2.\\end{aligned}\n$$\n\nHence, $g(x+2)\\ne g(x)$ for $x=1.$\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186413605 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186049852 :topic/id #uuid "18c7c8d4-f8df-5ab7-94e4-a5bda9fa7a9b" :topic/math-academy-id 3238 :topic/title "Solving Decoupled Homogeneous Systems of ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac55073-69fa-5d04-beb1-b62f89911c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473052} {:answer/id #uuid "474df447-a674-59d3-8567-60b8dfff4e16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473053}] :answer-field/correct {:answer/id #uuid "9ac55073-69fa-5d04-beb1-b62f89911c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473052} :answer-field/id #uuid "52e96549-c627-5583-a9fb-cf1da90d12c3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473921} {:answer-field/choices [{:answer/id #uuid "bd70a287-a637-5426-81c9-78d3016dd9e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473054} {:answer/id #uuid "caf9bc9c-885d-592e-b0ad-f4214345b3a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473055}] :answer-field/correct {:answer/id #uuid "bd70a287-a637-5426-81c9-78d3016dd9e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473054} :answer-field/id #uuid "d01f4732-ff58-597f-8c0f-c64f05d02e95" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473922} {:answer-field/choices [{:answer/id #uuid "f1b720fa-eff2-5721-8737-d3949780bca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473056} {:answer/id #uuid "07107876-6eb0-508b-a5c8-b915a1c3f6e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473057}] :answer-field/correct {:answer/id #uuid "07107876-6eb0-508b-a5c8-b915a1c3f6e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473057} :answer-field/id #uuid "e3487039-0ced-5468-aee8-6fe1bf8ee226" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473923}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96f65a49-2a61-5981-a404-aa212d4de13c" :question/math-academy-id "q-331097" :question/problem "Which of the following systems of linear ODEs are decoupled?\n- **I.** $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=4{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+2{x}_{2}(t)\\end{aligned}\\right.$\n- **II.** $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$\n- **III.** $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-7{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{2}(t)\\end{aligned}\\right.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently. \n\nWith this in mind, let's examine our systems.\n\n- System I is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{1}^{′}(t)=4{x}_{1}(t)+5{x}_{2}(t)$ depends on ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- System II is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)$ depends on ${x}_{2}(t)$ and ${x}_{1}(t).$\n\n- System III is decoupled since its equations depend on only one variable each. Indeed, ${x}_{1}^{′}(t)=-7{x}_{1}(t)$ depends on only ${x}_{1}(t)$ and ${x}_{2}^{′}(t)=9{x}_{2}(t)$ depends on only ${x}_{2}(t).$\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186413606 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186049852 :topic/id #uuid "18c7c8d4-f8df-5ab7-94e4-a5bda9fa7a9b" :topic/math-academy-id 3238 :topic/title "Solving Decoupled Homogeneous Systems of ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "529383e0-630b-588e-8db9-4ce7c7068aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473058} {:answer/id #uuid "4f4e76cc-dcfa-518c-812e-99530bece3ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473059}] :answer-field/correct {:answer/id #uuid "4f4e76cc-dcfa-518c-812e-99530bece3ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473059} :answer-field/id #uuid "58cd9a6e-53ff-55c8-9379-9163ca8db7db" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473924} {:answer-field/choices [{:answer/id #uuid "67701f92-2f97-5a77-bf09-984c8a18dfbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473060} {:answer/id #uuid "37f862dc-0eca-58e7-9512-63967c674760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473061}] :answer-field/correct {:answer/id #uuid "67701f92-2f97-5a77-bf09-984c8a18dfbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473060} :answer-field/id #uuid "dfa1aae3-5835-594e-bfcc-c8f9c5407254" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473925} {:answer-field/choices [{:answer/id #uuid "0188e982-24c3-5077-b63d-055de0590758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473062} {:answer/id #uuid "44480db1-81c7-5fae-9f45-49d3d2b427e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473063}] :answer-field/correct {:answer/id #uuid "44480db1-81c7-5fae-9f45-49d3d2b427e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473063} :answer-field/id #uuid "1fb6c655-3b68-5cc9-ace6-9170c6aa1506" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac9ae842-1c73-58e9-9ed3-756e4fa56ec1" :question/math-academy-id "q-331980" :question/problem "Which of the following systems of linear ODEs are decoupled?\n- **I.** ${x}^{′}(t)=\\begin{bmatrix}8 & 0 \\\\ 0 & -1\\end{bmatrix}x(t)$\n- **II.** ${x}^{′}(t)=\\begin{bmatrix}0 & 7 \\\\ -4 & 3\\end{bmatrix}x(t)$\n- **III.** ${x}^{′}(t)=\\begin{bmatrix}2 & 0 \\\\ 0 & 5\\end{bmatrix}x(t)$\n\nSelect all that apply." :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently.  \n\nIn matrix form, a linear system ${x}^{′}(t)=Ax(t)$ is decoupled if $A$ is a diagonal matrix.\n\nWith this in mind, let's examine our systems.\n\n- Systems I and III are decoupled since their corresponding matrices are diagonal.\n\n- System II is *not* decoupled because its matrix is not diagonal.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186413694 :knowledge-point/_questions [{:db/id #edb/ref 17592186203903 :knowledge-point/id #uuid "0184c705-00dd-54b0-ba83-2f467167a185" :knowledge-point/title "Interpreting an Adjacency Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048960 :topic/id #uuid "cf9ab88a-f36a-55c9-9686-426ec7537bce" :topic/math-academy-id 4819 :topic/title "The Domain and Range of a Relation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a19bac-653a-5eee-9c2f-41a4b7bbc01e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472874} {:answer/id #uuid "2f193e35-b8be-5ea4-bf86-0a381a9f2e69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472875}] :answer-field/correct {:answer/id #uuid "2f193e35-b8be-5ea4-bf86-0a381a9f2e69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472875} :answer-field/id #uuid "ad5dfd31-b4df-5ee3-a703-03f13f39eb84" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473832} {:answer-field/choices [{:answer/id #uuid "9b808580-7a64-5663-b6ca-9281d1ff47e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472876} {:answer/id #uuid "aaa6bc08-886b-529d-9d06-e2bde7d8ac56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472877}] :answer-field/correct {:answer/id #uuid "9b808580-7a64-5663-b6ca-9281d1ff47e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472876} :answer-field/id #uuid "3dbacaa8-ff71-5012-8acb-759fa0f15267" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473833} {:answer-field/choices [{:answer/id #uuid "fa3885af-7f7c-5d34-a944-d8f36b8f0d93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472878} {:answer/id #uuid "be577392-cb10-5612-af5e-b71a08d83712" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472879}] :answer-field/correct {:answer/id #uuid "fa3885af-7f7c-5d34-a944-d8f36b8f0d93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472878} :answer-field/id #uuid "b2c19d87-12f9-58f4-a383-06319f467bdd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d6ac86-9246-53ae-8020-58de7dcc7070" :question/math-academy-id "q-213094" :question/problem "|  | $✠$ | $♣$ | $♠$ |\n| --- | --- | --- | --- |\n| $✠$ | $0$ | $1$ | $0$ |\n| $♣$ | $1$ | $1$ | $0$ |\n| $♠$ | $0$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{✠,♣,♠\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(✠,♣)$\n\nII. $(♣,♠)$\n\nIII. $(♠,✠)$\n\nSelect all that apply." :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(✠,♣)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $✠$-row and the $♣$-column.\n\n- The pair $(♣,♠)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $♣$-row and the $♠$-column.\n\n- The pair $(♠,✠)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $♠$-row and the $✠$-column.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186413696 :knowledge-point/_questions [{:db/id #edb/ref 17592186203903 :knowledge-point/id #uuid "0184c705-00dd-54b0-ba83-2f467167a185" :knowledge-point/title "Interpreting an Adjacency Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048960 :topic/id #uuid "cf9ab88a-f36a-55c9-9686-426ec7537bce" :topic/math-academy-id 4819 :topic/title "The Domain and Range of a Relation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b0e90e-a9a2-53c3-a98d-d5ff68d7b96c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472880} {:answer/id #uuid "e45cb6db-8c29-536d-b9cd-b8ae5e6b7b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472881}] :answer-field/correct {:answer/id #uuid "16b0e90e-a9a2-53c3-a98d-d5ff68d7b96c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472880} :answer-field/id #uuid "1ee29d82-6e2b-5277-8ec9-1f72315bd17f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473835} {:answer-field/choices [{:answer/id #uuid "e71f3623-7599-5c55-96f6-313885cc01a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472882} {:answer/id #uuid "8fbaa2d1-3c66-526e-a54d-05444b706c84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472883}] :answer-field/correct {:answer/id #uuid "8fbaa2d1-3c66-526e-a54d-05444b706c84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472883} :answer-field/id #uuid "9c5eea00-e7de-5d4e-bc9d-dc27601cc6d9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473836} {:answer-field/choices [{:answer/id #uuid "0e2ba602-990d-52ac-8b25-1263667dcc65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472884} {:answer/id #uuid "457cc2fe-dfd8-5b88-b883-eebdc274a68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472885}] :answer-field/correct {:answer/id #uuid "457cc2fe-dfd8-5b88-b883-eebdc274a68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472885} :answer-field/id #uuid "58f7ebd0-f7ec-51b3-8e24-dffd8a1498c6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e24d1221-5380-50fb-b4e2-6e139d57675a" :question/math-academy-id "q-213100" :question/problem "|  | $3$ | $6$ |\n| --- | --- | --- |\n| $2$ | $1$ | $0$ |\n| $4$ | $0$ | $1$ |\n| $8$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined over the sets $\\{2,4,8\\}$ and $\\{3,6\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(4,3)$\n\nII. $(8,6)$\n\nIII. $(2,3)$\n\nSelect all that apply." :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(4,3)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $4$-row and the $3$-column.\n\n- The pair $(8,6)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $8$-row and the $6$-column.\n\n- The pair $(2,3)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $2$-row and the $3$-column.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186413744 :knowledge-point/_questions [{:db/id #edb/ref 17592186147427 :knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4" :knowledge-point/title "Identifying the Intersection of Two Planes" :topic/_knowledge-points [{:db/id #edb/ref 17592186050991 :topic/id #uuid "7789d7fa-bfec-58c3-afd1-afcff30a8748" :topic/math-academy-id 2539 :topic/title "The Intersection of Two Planes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a139c706-0e77-54a4-accb-bfe443670e5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453922} {:answer/id #uuid "f7a0a00e-bd44-522f-87a0-1661c0717d26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453923}] :answer-field/correct {:answer/id #uuid "a139c706-0e77-54a4-accb-bfe443670e5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453922} :answer-field/id #uuid "227c754c-4dc6-54d5-bd20-dc203c3bd56d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454711} {:answer-field/choices [{:answer/id #uuid "86a8ed31-2bd6-5da1-bce7-520c67f0b586" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453924} {:answer/id #uuid "7ef7da89-3321-5d51-9ea4-d7214de7dcff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453925}] :answer-field/correct {:answer/id #uuid "7ef7da89-3321-5d51-9ea4-d7214de7dcff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453925} :answer-field/id #uuid "7d5956ce-b17c-56a5-9c55-441171fc7b01" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454712} {:answer-field/choices [{:answer/id #uuid "6c079efb-b705-50e6-8fa4-f8d29cbaf064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453926} {:answer/id #uuid "313e94f5-659f-51cb-b0fd-10e36f25ce06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453927}] :answer-field/correct {:answer/id #uuid "6c079efb-b705-50e6-8fa4-f8d29cbaf064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453926} :answer-field/id #uuid "cf7ace9d-04e4-53a1-8f3e-3670bba92643" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454713}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abe7bafd-4069-5c23-9e34-e0cbd57e3732" :question/math-academy-id "q-71465" :question/problem "Given the two planes $x+y+z=0$ and $x+y+1=0$, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The cross product of the normal vectors of the planes is equal to $⟨1,1,0⟩.$\n\n- **II.** The planes intersect on a line.\n\n- **III.** The planes are coincident." :question/worked-solution "First, notice that:\n\n- For the plane $x+y+z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,1,1⟩.$\n\n- For the plane $x+y+1=0,$ a normal vector to the plane is ${n}_{2}=⟨1,1,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is false. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,1,1⟩\\times ⟨1,1,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & 1 \\\\ 1 & 1 & 0\\end{aligned}\\right| \\\\  & =-i+j \\\\  & =⟨-1,1,0⟩\\ne ⟨1,1,0⟩.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel. Hence, the corresponding planes must intersect on a line.\n\n- Statement III is false. Indeed, two non-parallel planes could not be coincident either.\n\nTherefore, only statement II is true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050991 :topic/id #uuid "7789d7fa-bfec-58c3-afd1-afcff30a8748" :topic/math-academy-id 2539 :topic/title "The Intersection of Two Planes"} :activity/title "The Intersection of Two Planes" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186421888} :db/id #edb/ref 17592186421903}]} {:db/id #edb/ref 17592186413824 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47c544f2-0094-5efb-b9d7-430a6628b03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473118} {:answer/id #uuid "d6421a79-149e-5798-8b1f-119bfea53fe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473119}] :answer-field/correct {:answer/id #uuid "47c544f2-0094-5efb-b9d7-430a6628b03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473118} :answer-field/id #uuid "fafc7937-f74b-546b-b87e-a22ca804ac3f" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473954} {:answer-field/choices [{:answer/id #uuid "a89bbf83-2e3e-5555-a6d5-981a9278f764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473120} {:answer/id #uuid "cea56d01-fdfe-5736-816e-b8204e960080" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473121}] :answer-field/correct {:answer/id #uuid "a89bbf83-2e3e-5555-a6d5-981a9278f764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473120} :answer-field/id #uuid "8372ee30-4548-5d83-9957-bf0d65799b1f" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473955} {:answer-field/choices [{:answer/id #uuid "fc580dff-bc2e-5878-b7a7-f48a863b4636" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473122} {:answer/id #uuid "2be2d645-5052-599b-a84f-9d2d9883a16a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473123}] :answer-field/correct {:answer/id #uuid "2be2d645-5052-599b-a84f-9d2d9883a16a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473123} :answer-field/id #uuid "4d08e1cd-2808-5a00-b091-ce22e53c0263" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473956}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72e836b6-2968-5b2e-8666-6c15080ad3e0" :question/math-academy-id "q-42005" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{32}\\ne 0$ (condition  II is violated). \n\n$$\nA=\\begin{bmatrix}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{21}\\ne 0$ (condition II is violated). \n\n$$\nB=\\begin{bmatrix}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\nTherefore, only $C$ is in row echelon form."} {:db/id #edb/ref 17592186413825 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff7ff1b-7d10-5900-8b02-8d8762f4648a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472604} {:answer/id #uuid "2a735909-2afd-58c0-8065-6f9b0fda657e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472605}] :answer-field/correct {:answer/id #uuid "2ff7ff1b-7d10-5900-8b02-8d8762f4648a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472604} :answer-field/id #uuid "f09fe1a5-baa2-5973-acbf-a84cc0ff0a30" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473697} {:answer-field/choices [{:answer/id #uuid "9738a799-c696-51e8-87a0-1ab427da9e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472606} {:answer/id #uuid "af5402ff-243c-585f-b25c-a8687187c616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472607}] :answer-field/correct {:answer/id #uuid "af5402ff-243c-585f-b25c-a8687187c616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472607} :answer-field/id #uuid "1021401d-9baa-5256-9d91-aea06ee1499d" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473698} {:answer-field/choices [{:answer/id #uuid "2b14007f-a781-5311-9863-6ad6959abeb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472608} {:answer/id #uuid "d335439c-9eef-5cb8-852d-d00750680628" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472609}] :answer-field/correct {:answer/id #uuid "d335439c-9eef-5cb8-852d-d00750680628" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472609} :answer-field/id #uuid "05c9c089-5c63-5c77-b946-3743f2d68ce2" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0f43991-a609-584a-a820-e263b283da38" :question/math-academy-id "q-129230" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{cccc|c}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{33}\\ne 0$ (condition II is violated).\n\n$$\nA=\\left[\\begin{array}{cccc|c}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{ccc|c}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186414080 :knowledge-point/_questions [{:db/id #edb/ref 17592186161972 :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049024 :topic/id #uuid "d4915fbb-3ba0-55bd-ad16-ce672a3ac557" :topic/math-academy-id 3082 :topic/title "Linear Diophantine Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89dc469f-47b4-520f-b21b-08b07b7451bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473572} {:answer/id #uuid "3a733154-caa1-5094-8512-f504a530a7ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473573}] :answer-field/correct {:answer/id #uuid "3a733154-caa1-5094-8512-f504a530a7ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473573} :answer-field/id #uuid "e915d522-fb10-551b-b9c0-2a6ae97f20d7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474181} {:answer-field/choices [{:answer/id #uuid "0911e3bb-5ca3-57de-848c-a3ed1bdd544f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473574} {:answer/id #uuid "81c28b99-c4a4-548b-86f9-0f49da608633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473575}] :answer-field/correct {:answer/id #uuid "0911e3bb-5ca3-57de-848c-a3ed1bdd544f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473574} :answer-field/id #uuid "d339291e-d574-5719-a6e7-3df247786608" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474182} {:answer-field/choices [{:answer/id #uuid "1eaf2778-ccc5-5f50-ad03-a8e1d231aa75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473576} {:answer/id #uuid "c98e4dd0-d468-53db-9f67-aab42d9dbd63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473577}] :answer-field/correct {:answer/id #uuid "1eaf2778-ccc5-5f50-ad03-a8e1d231aa75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473576} :answer-field/id #uuid "3c7cf870-d376-5c1a-8305-823d614222f7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474183}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34033db1-99ab-5af1-b893-026e522543dd" :question/math-academy-id "q-93742" :question/problem "Which of the following pairs $(x,y)$ are solutions of the Diophantine equation $2x+5y=200?$\n- **I.** $(20,32)$\n- **II.** $(10,20)$\n- **III.** $(15,35)$\n\nSelect all that apply." :question/worked-solution "Let's check each pair in turn.\n\n- $(20,32)$ is a solution of our equation. Indeed, substituting $x=20$ and $y=32,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 20+5\\cdot 32 & =200 \\\\ 40+160 & =200 \\\\ 200 & =200\\,✓\\end{aligned}\n$$\n\n- $(10,20)$ is *not* a solution of our equation. Substituting $x=10$ and $y=20,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 10+5\\cdot 20 & =200 \\\\ 20+100 & =200 \\\\ 120 & \\ne 200\\,\\times \\end{aligned}\n$$\n\n- $(15,35)$ is *not* a solution of our equation. Substituting $x=15$ and $y=35,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 15+5\\cdot 35 & =200 \\\\ 30+175 & =200 \\\\ 205 & \\ne 200\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186414082 :knowledge-point/_questions [{:db/id #edb/ref 17592186161972 :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049024 :topic/id #uuid "d4915fbb-3ba0-55bd-ad16-ce672a3ac557" :topic/math-academy-id 3082 :topic/title "Linear Diophantine Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103213a4-eee1-52b8-951a-225d0087faf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473566} {:answer/id #uuid "53523f87-d23b-5797-96b7-c1b07aa73db6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473567}] :answer-field/correct {:answer/id #uuid "103213a4-eee1-52b8-951a-225d0087faf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473566} :answer-field/id #uuid "f3750945-5563-519d-8de2-c840632071cf" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474178} {:answer-field/choices [{:answer/id #uuid "251a0a61-5483-55ee-8b3e-dc994543c886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473568} {:answer/id #uuid "d4eb30b2-c71d-5651-b1cc-c3704fa4449b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473569}] :answer-field/correct {:answer/id #uuid "d4eb30b2-c71d-5651-b1cc-c3704fa4449b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473569} :answer-field/id #uuid "edf5a7f1-a50e-5d4f-9d3c-2d0898373a0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474179} {:answer-field/choices [{:answer/id #uuid "82e4c0e8-cd70-5672-b740-df2009447e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473570} {:answer/id #uuid "3682f9ef-0cf5-548c-ab93-1b1cefc9125e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473571}] :answer-field/correct {:answer/id #uuid "82e4c0e8-cd70-5672-b740-df2009447e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473570} :answer-field/id #uuid "3b5a744a-bddb-5e17-b027-5a36a30654a6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474180}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "689613bd-55bf-5236-b19b-6e6b928e5d1e" :question/math-academy-id "q-93737" :question/problem "Which of the following pairs $(x,y)$ are solutions of the Diophantine equation $5x+6y=8?$\n- **I.** $(-2,2)$\n- **II.** $(-8,8)$\n- **III.** $(4,-4)$\n\nSelect all that apply." :question/worked-solution "Let's check each pair in turn.\n\n- $(4,-4)$ is *not* a solution of our equation. Substituting $x=4$ and $y=-4,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot (-2)+6\\cdot 2 & =8 \\\\ -10+12 & =8 \\\\ 2 & \\ne 8\\,\\times \\end{aligned}\n$$\n\n- $(-8,8)$ is a solution of our equation. Indeed, substituting $x=-8$ and $y=8,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot (-8)+6\\cdot 8 & =8 \\\\ -40+48 & =8 \\\\ 8 & =8\\,✓\\end{aligned}\n$$\n\n- $(4,-4)$ is *not* a solution of our equation. Substituting $x=4$ and $y=-4,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot 4+6\\cdot (-4) & =8 \\\\ 20-24 & =8 \\\\ -4 & \\ne 8\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186414084 :knowledge-point/_questions [{:db/id #edb/ref 17592186161973 :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution" :topic/_knowledge-points [{:db/id #edb/ref 17592186049024 :topic/id #uuid "d4915fbb-3ba0-55bd-ad16-ce672a3ac557" :topic/math-academy-id 3082 :topic/title "Linear Diophantine Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f0a59d0-bf7d-5ecd-8e1f-e123141cfadd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473584} {:answer/id #uuid "dcefcf08-62ed-52f9-b7fb-ea0b49f3fd53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473585}] :answer-field/correct {:answer/id #uuid "dcefcf08-62ed-52f9-b7fb-ea0b49f3fd53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473585} :answer-field/id #uuid "5269c17c-1ffd-5bfd-8c14-5ca96bbdfe3c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474187} {:answer-field/choices [{:answer/id #uuid "b2bef409-f619-51e6-94e0-f6457f0a3685" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473586} {:answer/id #uuid "b0aa36f0-fcc2-56e8-9927-3fa62debd7d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473587}] :answer-field/correct {:answer/id #uuid "b0aa36f0-fcc2-56e8-9927-3fa62debd7d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473587} :answer-field/id #uuid "a45c1983-86b3-5cd1-a19f-3a95ed53d6e8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474188} {:answer-field/choices [{:answer/id #uuid "987385e9-039d-54b8-b73f-7ff76f5eb1c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473588} {:answer/id #uuid "1064bb59-0abd-5531-bfb2-1b04e362e4cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473589}] :answer-field/correct {:answer/id #uuid "987385e9-039d-54b8-b73f-7ff76f5eb1c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473588} :answer-field/id #uuid "f6e4bd4c-8a69-5bf7-9f3f-fe25de8b0cff" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474189}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8955bc35-57b9-5c55-b8c0-47deb511cca7" :question/math-academy-id "q-93798" :question/problem "Which of the following Diophantine equations have solutions?\n- **I.** $15x-20y=5$\n- **II.** $11x+9y=13$\n- **III.** $-8x+2y=5$\n\nSelect all that apply." :question/worked-solution "Recall that a linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d\\,|\\,c,$ where $d=\\text{gcd}(a,b).$  \n\nWith that in mind, let's examine each equation in turn.\n\n- Equation I has solutions. We have $a=15,$ $b=-20,$ and $c=5.$ Since\n\n$$\nd=\\text{gcd}(15,-20)=5\n$$\n\nand $5\\,|\\,5,$ our equation has solutions.\n\n- Equation II has solutions. We have $a=11,$ $b=9,$ and $c=13.$ Since\n\n$$\nd=\\text{gcd}(11,9)=1\n$$\n\nand $1\\,|\\,13,$ our equation has solutions.\n\n- Equation III has no solution. We have $a=-8,$ $b=2,$ and $c=5.$ Since\n\n$$\nd=\\text{gcd}(-8,2)=2\n$$\n\nand $2\\,\\text{⧸}|\\,5,$ our equation has no solution.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186414086 :knowledge-point/_questions [{:db/id #edb/ref 17592186161973 :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution" :topic/_knowledge-points [{:db/id #edb/ref 17592186049024 :topic/id #uuid "d4915fbb-3ba0-55bd-ad16-ce672a3ac557" :topic/math-academy-id 3082 :topic/title "Linear Diophantine Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8948ea4-a4b4-5b6b-ba31-32af6140c8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473578} {:answer/id #uuid "352c13c4-661f-59c9-8c17-f99a0e6e475f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473579}] :answer-field/correct {:answer/id #uuid "352c13c4-661f-59c9-8c17-f99a0e6e475f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473579} :answer-field/id #uuid "2dea80e2-1129-59df-89da-ce3af791e109" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474184} {:answer-field/choices [{:answer/id #uuid "bb17f015-9f95-5ab0-8c04-37346e89d74d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473580} {:answer/id #uuid "13f1caab-461f-5b08-b5aa-ea0b9d3bc512" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473581}] :answer-field/correct {:answer/id #uuid "bb17f015-9f95-5ab0-8c04-37346e89d74d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473580} :answer-field/id #uuid "4b11ffee-6b60-5f11-8662-a41e822eeaee" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474185} {:answer-field/choices [{:answer/id #uuid "59a816a9-4050-59d1-9baf-432d339aa8cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473582} {:answer/id #uuid "1131bfa8-a0b7-5a68-b32c-3a39176d00f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473583}] :answer-field/correct {:answer/id #uuid "1131bfa8-a0b7-5a68-b32c-3a39176d00f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473583} :answer-field/id #uuid "4aa8a403-8182-54e7-a594-b436fc763ccd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474186}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccf1e2c5-efff-5b3d-ba7c-30f178649720" :question/math-academy-id "q-93795" :question/problem "Which of the following Diophantine equations have solutions?\n- **I.** $3x+7y=11$\n- **II.** $-3x-9y=2$\n- **III.** $-12x+15y=21$\n\nSelect all that apply." :question/worked-solution "Recall that a linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d\\,|\\,c,$ where $d=\\text{gcd}(a,b).$  \n\nWith that in mind, let's examine each equation in turn.\n\n- Equation I has solutions. We have $a=3,$ $b=7,$ and $c=11.$ Since\n\n$$\nd=\\text{gcd}(3,7)=1\n$$\n\nand $1\\,|\\,11,$ our equation has solutions.\n\n- Equation II has no solution. We have $a=-3,$ $b=-9,$ and $c=2.$ Since\n\n$$\nd=\\text{gcd}(-3,-9)=3\n$$\n\nand $3\\,\\text{⧸}|\\,2,$ our equation has no solution.\n\n- Equation III has solutions. We have $a=-12,$ $b=15,$ and $c=21.$ Since\n\n$$\nd=\\text{gcd}(-12,15)=3\n$$\n\nand $3\\,|\\,21,$ our equation has solutions.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186414417 :knowledge-point/_questions [{:db/id #edb/ref 17592186171919 :knowledge-point/id #uuid "308a8c68-628a-522f-9545-17a7165aefdf" :knowledge-point/title "Finite Vs. Infinite Sets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050146 :topic/id #uuid "30c306d4-7422-557a-a542-cedff2b28c58" :topic/math-academy-id 3424 :topic/title "Discrete Infinite Sets With Equal Cardinality"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8164409b-fc2f-56e4-92d4-a571bd078853" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453598} {:answer/id #uuid "eeb1f6d0-b222-5b3f-9baa-7c642ab86cce" :answer/type {:db/id #edb/ref 1759218604549