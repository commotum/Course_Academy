answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472945} :answer-field/id #uuid "3440b723-fef3-5a18-9e35-d09861f3ace7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af0eb712-6f36-542d-b37c-e07c5fedf4a8" :question/math-academy-id "q-213407" :question/problem "Which of the following integers has a multiplicative inverse modulo $27?$\n- **I.** $11$\n- **II.** $16$\n- **III.** $23$\n\nSelect all that apply." :question/worked-solution "An integer $a$ has a multiplicative inverse modulo $n$ if and only if $a$ and $n$ are coprime, i.e., $\\text{gcd}(a,n)=1.$\n\nWith this in mind, let's examine the given options.\n\n- $11$ has a multiplicative inverse modulo $27$ since $\\text{gcd}(11,27)=1.\\,\\,✓$\n\n- $16$ has a multiplicative inverse modulo $27$ since $\\text{gcd}(16,27)=1.\\,\\,✓$\n\n- $23$ has a multiplicative inverse modulo $27$ since $\\text{gcd}(23,27)=1.\\,\\,✓$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186416064 :knowledge-point/_questions [{:db/id #edb/ref 17592186203920 :knowledge-point/id #uuid "65e9c4fd-dae7-5858-b008-ca0e144fa64a" :knowledge-point/title "Representing Binary Relations Using Digraphs" :topic/_knowledge-points [{:db/id #edb/ref 17592186048710 :topic/id #uuid "b73e30a4-d62d-555b-a6f7-1a03dfa6cf83" :topic/math-academy-id 4837 :topic/title "Graphical Representations of Relations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b08d4af0-3773-548f-9fff-8a490f817fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472916} {:answer/id #uuid "59490e6a-5908-57a3-8fef-747cf7e201bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 1759218