7592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472745}] :answer-field/correct {:answer/id #uuid "89f7ef7d-3d29-5bcd-86e4-6ccb6a042395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472745} :answer-field/id #uuid "0562aeab-6992-5c67-82d7-eee722fd8045" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473767} {:answer-field/choices [{:answer/id #uuid "194dcf31-6ded-5f7d-8ad4-8503fc14610b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472746} {:answer/id #uuid "cff66d04-5359-528e-90cc-f15b10b85371" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472747}] :answer-field/correct {:answer/id #uuid "194dcf31-6ded-5f7d-8ad4-8503fc14610b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472746} :answer-field/id #uuid "5cfac123-c198-5997-bc78-bc4c79e3be46" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473768}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b65bfe0-6178-564e-825d-19d4ac9443d8" :question/math-academy-id "q-150012" :question/problem "![](images/5a/5a3961346a4bcb0d94e46caf6d6ed1253dc56fb4761db07b11829e329bc2fa8d.png)\n\nConsider the part of parabola and constant vector field $F$ shown above. Let $C$ be the path where the part of parabola is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{C}F\\cdot \\text{d}r=0$\n- ${\\int }_{-C}F\\cdot \\text{d}r<0$\n\nSelect all that apply." :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I is false, while statement II is true. As the particle moves from $A$ to $B,$ the force $F$ works against the particle for $x>0,$ while $F$  works with the particle for $x<0.$ \n\n![](images/af/af80eab6427f376084301c03715fd098cfe4a1c816dcd72d3e1129cfa35ff29d.png)\n\n \n\nBy symmetry, the contribution to ${\\int }_{C}F\\cdot \\text{d}r$ for $x<0$ is canceled out by the contribution for $x>0.$ So,\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/a2/a26ca79400bf30aa891543d30a052a6e8ec071ccb48fcd8c418fe0a713dad212.png)\n\n \n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049147 :topic/id #uuid "de74c316-f607-5e04-8847-2af8b65a611b" :topic/math-academy-id 3694 :topic/title "Interpreting Line Integrals of Vector-Valued Functions"} :activity/title "Interpreting Line Integrals of Vector-Valued Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550361} :db/id #edb/ref 17592186551389}]} {:db/id #edb/ref 17592186414784 :knowledge-point/_questions [{:db/id #edb/ref 17592186179742 :knowledge-point/id #uuid "3d72127a-90d6-5f7e-bd87-75d03285a918" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Non-Constant Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186049147 :topic/id #uuid "de74c316-f607-5e04-8847-2af8b65a611b" :topic/math-academy-id 3694 :topic/title "Interpreting Line Integrals of Vector-Valued Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0162ba-5ef3-5ddf-8884-68e373c833a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472526} {:answer/id #uuid "10f070d6-ca76-58f9-8198-433b788e83cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472527}] :answer-field/correct {:answer/id #uuid "10f070d6-ca76-58f9-8198-433b788e83cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472527} :answer-field/id #uuid "a22ff3ac-6762-5a5a-a846-c9c1ac079ce7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473658} {:answer-field/choices [{:answer/id #uuid "4a55ad75-30aa-5338-9705-0e8bb5a17796" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472528} {:answer/id #uuid "2bfb901c-eb55-5a16-8c43-2a7bc4df1694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472529}] :answer-field/correct {:answer/id #uuid "4a55ad75-30aa-5338-9705-0e8bb5a17796" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472528} :answer-field/id #uuid "3e84a8a1-9e86-5904-8f0e-d9bd26a8cf86" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473659} {:answer-field/choices [{:answer/id #uuid "cf9bee40-6700-53ec-bc0a-8c4fbe9bdd4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472530} {:answer/id #uuid "35fcedff-2ccf-5690-9d0e-4989e5420282" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472531}] :answer-field/correct {:answer/id #uuid "cf9bee40-6700-53ec-bc0a-8c4fbe9bdd4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472530} :answer-field/id #uuid "1a2b2811-e1ba-5e92-bdc1-f1a06a417ca6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473660}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "277ca4a2-1c02-58e4-b62f-d0e1176e96df" :question/math-academy-id "q-125499" :question/problem "![](images/8f/8ffc97d4fc442503eb5b59e01f317cc7a77cf57d041e16807aa0645f962a5aeb.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the three-quarter circle is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r>0$\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$\n\nSelect all that apply." :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true while statement II is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/c9/c9805268d9f4984983c3cc5e2200a0c22d804bc67076a3505ad35471693c037b.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- Statement III is false. It's clear from the picture below that $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/da/dafb4d468e7711a804a5141301a02331bb5c7900f018a8ecdb6fd382bc05b799.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186414785 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186049147 :topic/id #uuid "de74c316-f607-5e04-8847-2af8b65a611b" :topic/math-academy-id 3694 :topic/title "Interpreting Line Integrals of Vector-Valued Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c75fe3-0f58-55e1-8f86-a88338d5cfcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472520} {:answer/id #uuid "a60b9432-a58a-5243-9f31-007a718f9157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472521}] :answer-field/correct {:answer/id #uuid "a60b9432-a58a-5243-9f31-007a718f9157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472521} :answer-field/id #uuid "7ce59e55-a6c7-5acf-b0ee-3ead7fb9939a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473655} {:answer-field/choices [{:answer/id #uuid "2f1a6c81-b372-55cc-97ce-f7cde5c58ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472522} {:answer/id #uuid "8cd28fc9-2509-520a-9b6e-b710a4fcd873