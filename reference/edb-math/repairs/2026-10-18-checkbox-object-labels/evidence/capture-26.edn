answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472823}] :answer-field/correct {:answer/id #uuid "33f4cad9-66cd-545d-9ac0-97d5414f12cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472823} :answer-field/id #uuid "8aeb8409-1020-570b-8cec-0822b2e40889" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473806} {:answer-field/choices [{:answer/id #uuid "0ff70513-8053-559e-b6b1-7a97e4aa128d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472824} {:answer/id #uuid "78ab4291-cd70-5529-b069-e726e0430998" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472825}] :answer-field/correct {:answer/id #uuid "0ff70513-8053-559e-b6b1-7a97e4aa128d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472824} :answer-field/id #uuid "aebe7e6e-372c-5557-a0e2-e163a4bed7dd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473807}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d6a13d3-ad69-5578-b6a3-a3b3842749f5" :question/math-academy-id "q-183354" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $x\\ge 2.$ $\\,$ $B(x):$ $-x\\le -2.$\n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n- **I.** If $x\\ge 2$ then $-x\\le -2,$ and if $-x\\le -2$ then $x\\ge 2.$\n- **II.** $x\\ge 2$ is equivalent to $-x\\le -2.$\n- **III.** If $x\\ge 2$ then $-x\\le -2,$ or if $-x\\le -2$ then $x\\ge 2.$\n\nSelect all that apply." :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $x\\ge 2$ if and only if $-x\\le -2.$\n\n- $x\\ge 2$ is equivalent to $-x\\le -2.$\n\n- If $x\\ge 2$ then $-x\\le -2,$ and if $-x\\le -2$ then $x\\ge 2.$\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048574 :topic/id #uuid "aad2999b-dacb-527f-a4a8-1fce51919fe6" :topic/math-academy-id 4257 :topic/title "Conditional Statements With Predicates"} :activity/title "Conditional Statements With Predicates" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415162} :db/id #edb/ref 17592186415191} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048574 :topic/id #uuid "aad2999b-dacb-527f-a4a8-1fce51919fe6" :topic/math-academy-id 4257 :topic/title "Conditional Statements With Predicates"} :activity/title "Conditional Statements With Predicates" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186499649} :db/id #edb/ref 17592186500392}]} {:db/id #edb/ref 17592186415272 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path" :topic/_knowledge-points [{:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360 :topic/title "Path Independence of Line Integrals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59393bce-26a0-53f4-b9ee-a4b60e0309ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453336} {:answer/id #uuid "d3ec25f8-9101-5ec4-ae2b-1947b4fed11b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453337}] :answer-field/correct {:answer/id #uuid "d3ec25f8-9101-5ec4-ae2b-1947b4fed11b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453337} :answer-field/id #uuid "6aafa3ab-4c0c-5ec8-8508-509f0aa15d9e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454418} {:answer-field/choices [{:answer/id #uuid "59eb0512-2892-504c-817d-6e1c62f596b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453338} {:answer/id #uuid "8c2be482-8af1-5d7d-8d56-389be603fc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453339}] :answer-field/correct {:answer/id #uuid "8c2be482-8af1-5d7d-8d56-389be603fc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453339} :answer-field/id #uuid "359d2acf-2ea6-56b6-a467-a84c75cf4d9e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454419} {:answer-field/choices [{:answer/id #uuid "7762d99b-6748-51f0-9769-d7e020b910e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453340} {:answer/id #uuid "761205e9-2c61-502f-8e9d-e4e3f37407aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453341}] :answer-field/correct {:answer/id #uuid "7762d99b-6748-51f0-9769-d7e020b910e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453340} :answer-field/id #uuid "95713f76-4916-53c2-b271-58871420022e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454420}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0027cfb5-d932-549f-8cc6-973642895e8d" :question/math-academy-id "q-125743" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{x}\\operatorname{sin}⁡y,\\,{e}^{x}\\operatorname{cos}⁡y⟩$ and the points $O(0,0)$ and $A(1,\\frac{\\pi }{2})$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $F$ is conservative.\n\n- **II.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=e,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$\n\n- **III.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{2}$ is the path along the curve $y=\\frac{\\pi }{2}\\sqrt{x},$ traversed from $O$ to $A.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{x}\\operatorname{cos}⁡y.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf={e}^{x}\\operatorname{sin}⁡y.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(1,\\frac{\\pi }{2})-f(0,0) \\\\  & ={e}^{1}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-{e}^{0}\\cdot \\operatorname{sin}⁡0 \\\\  & =e\\cdot 1-0 \\\\  & =e.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=e.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186415275 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path" :topic/_knowledge-points [{:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360 :topic/title "Path Independence of Line Integrals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e94047db-68c4-551f-9095-b7004ca8440d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453324} {:answer/id #uuid "bb26d5f6-a66c-5844-b1b4-09be8fba0088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453325}] :answer-field/correct {:answer/id #uuid "bb26d5f6-a66c-5844-b1b4-09be8fba0088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453325} :answer-field/id #uuid "72a92e66-5e63-57a1-a0c4-007b140902d2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454412} {:answer-field/choices [{:answer/id #uuid "90c212f9-6c73-5efa-827a-5c7e1827ff4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453326} {:answer/id #uuid "d032a76d-d4bb-5471-9f1d-f875814c51b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453327}] :answer-field/correct {:answer/id #uuid "d032a76d-d4bb-5471-9f1d-f875814c51b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453327} :answer-field/id #uuid "7023734c-f76f-51a8-9faa-f0979cbea5ab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454413} {:answer-field/choices [{:answer/id #uuid "09069a3c-ed3c-50a5-9d67-301f8b9abc91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453328} {:answer/id #uuid "da2b872b-a120-58a1-8c06-6c98a0c03cdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453329}] :answer-field/correct {:answer/id #uuid "09069a3c-ed3c-50a5-9d67-301f8b9abc91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453328} :answer-field/id #uuid "7125f222-da47-5c32-9e27-3e728ad73ef9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41c787c2-8fe3-51ae-aef3-bfbcd04677ea" :question/math-academy-id "q-125720" :question/problem "Consider the vector field $F(x,y)=⟨y,\\,x⟩$ and the points $O(0,0)$ and $A(\\sqrt{2},2)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $F$ is conservative.\n\n- **II.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2\\sqrt{2},$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$\n\n- **III.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=-\\sqrt{2},$ where ${C}_{2}$ is the path along the curve $y={x}^{2},$ traversed from $O$ to $A.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=1.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf=xy.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(\\sqrt{2},2)-f(0,0) \\\\  & =\\sqrt{2}\\cdot 2-0\\cdot 0 \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=2\\sqrt{2}.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186415281 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path" :topic/_knowledge-points [{:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360 :topic/title "Path Independence of Line Integrals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d72dfe19-644e-58ac-b092-ca0bf0a32235" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453330} {:answer/id #uuid "8d3cb706-2c7c-59c6-9797-8f2413c3c0ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453331}] :answer-field/correct {:answer/id #uuid "8d3cb706-2c7c-59c6-9797-8f2413c3c0ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453331} :answer-field/id #uuid "3aa85dc7-977b-504c-9e63-6eaa9497ca86" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454415} {:answer-field/choices [{:answer/id #uuid "6fc76864-a6b1-5bc1-9012-9c15cd8d9c39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453332} {:answer/id #uuid "9de221a3-7ed0-563b-8bfe-b20e6e8988e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453333}] :answer-field/correct {:answer/id #uuid "9de221a3-7ed0-563b-8bfe-b20e6e8988e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453333} :answer-field/id #uuid "6454a9c4-5959-5c99-9e74-da908dab25c3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454416} {:answer-field/choices [{:answer/id #uuid "fea26c04-19a4-5d02-95f7-713e29db1fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453334} {:answer/id #uuid "05e0a248-34b8-5d04-9e61-a958287d7eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453335}] :answer-field/correct {:answer/id #uuid "fea26c04-19a4-5d02-95f7-713e29db1fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453334} :answer-field/id #uuid "771420e3-311e-5ce3-b340-03646c706117" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454417}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef46b0f0-6f4c-53dd-b0f1-5e1b301fe037" :question/math-academy-id "q-125736" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{y},\\,x{e}^{y}⟩$ and the points $A(1,0)$ and $B(3,\\operatorname{ln}⁡3)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $F$ is conservative.\n\n- **II.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=8,$ where ${C}_{1}$ is the path along the curve $y=\\operatorname{ln}⁡(x),$ traversed from $A$ to $B.$\n\n- **III.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=3,$ where ${C}_{2}$ is the path along the line segment $\\overset{―}{AB},$ traversed from $A$ to $B.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{y}.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf=x{e}^{y}.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(3,\\operatorname{ln}⁡3)-f(1,0) \\\\  & =3\\cdot {e}^{\\operatorname{ln}⁡3}-1\\cdot {e}^{0} \\\\  & =3\\cdot 3-1 \\\\  & =8.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{2},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{2}}F\\cdot \\text{d}r=8.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186415312 :knowledge-point/_questions [{:db/id #edb/ref 17592186179740 :knowledge-point/id #uuid "6f30993e-b5c7-5d8a-9b27-2aed2c9223e1" :knowledge-point/title "Determining the Sign of a Circulation From a Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186050773 :topic/id #uuid "659072cc-8b2c-5e8d-b6a6-88321581f47f" :topic/math-academy-id 3713 :topic/title "Circulation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55d9a389-0207-5627-8724-2ab06942a52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472532} {:answer/id #uuid "8021b753-e25f-51ff-8c8f-fab09d9d89b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472533}] :answer-field/correct {:answer/id #uuid "8021b753-e25f-51ff-8c8f-fab09d9d89b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472533} :answer-field/id #uuid "4f990914-9c06-5321-9dbf-d829370622d6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473661} {:answer-field/choices [{:answer/id #uuid "7f7147a8-f34e-5218-b7c5-8ea2c830c0bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472534} {:answer/id #uuid "308c82b6-5505-533c-a6a4-f3335f961206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472535}] :answer-field/correct {:answer/id #uuid "308c82b6-5505-533c-a6a4-f3335f961206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472535} :answer-field/id #uuid "be5dec92-40f9-56cc-a873-06f88cbc4087" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473662} {:answer-field/choices [{:answer/id #uuid "975f0d9b-1723-5cdd-bb95-28c94959e5c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472536} {:answer/id #uuid "8caa6e88-f7bc-5579-83d6-8f86c7a5803f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472537}] :answer-field/correct {:answer/id #uuid "975f0d9b-1723-5cdd-bb95-28c94959e5c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472536} :answer-field/id #uuid "9b8664d6-4e9d-52a7-ac0d-f153ff8d27fa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473663}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e8f010b-1d85-5f55-981d-5803f1cc03c7" :question/math-academy-id "q-125645" :question/problem "![](images/98/981d966645eec322afbfe28a5a1f519eeab8b3557692dcce368a87fe748dddd6.png)\n\nConsider the ellipse $E$ and the vector field $F,$ shown above. Let $C$ be any path where $E$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\n- ${∮}_{C}F\\cdot \\text{d}r>0$\n- ${∮}_{-C}F\\cdot \\text{d}r<0$\n- ${∮}_{C}F\\cdot \\text{d}r<0$\n\nSelect all that apply." :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement III is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves clockwise along $C.$ \n\n![](images/b2/b2473eb0c505d75d2c448c1a0d714d05d42737ce8d601401e925834a25ae9e14.png)\n\nSo, $Γ={∮}_{C}F\\cdot \\text{d}r>0.$\n\n- Statement II is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves counterclockwise along $C.$\n\n![](images/85/8513d9d15d204b6f63f310a37465d6b8dfb21239ca412bac7d3b9936f2bf5ebf.png)\n\nSo, $Γ={∮}_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186415314 :knowledge-point/_questions [{:db/id #edb/ref 17592186179743 :knowledge-point/id #uuid "1da220a9-2afc-5b63-a423-a4d2b3de9567" :knowledge-point/title "Circulation in Conservative Vector Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186050773 :topic/id #uuid "659072cc-8b2c-5e8d-b6a6-88321581f47f" :topic/math-academy-id 3713 :topic/title "Circulation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51baee7c-4f09-5886-aa36-1dcdf90f0b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472538} {:answer/id #uuid "46738186-25bf-5244-a8cd-2cfae05fe1b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472539}] :answer-field/correct {:answer/id #uuid "51baee7c-4f09-5886-aa36-1dcdf90f0b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472538} :answer-field/id #uuid "2343f5a2-9a6f-5456-bd97-3e506bdd18a6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473664} {:answer-field/choices [{:answer/id #uuid "43d8099c-d11a-55ed-bd66-5bc9bfad9a06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472540} {:answer/id #uuid "91e139e0-9b3e-56d8-b8c4-b1714fe1291e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472541}] :answer-field/correct {:answer/id #uuid "43d8099c-d11a-55ed-bd66-5bc9bfad9a06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472540} :answer-field/id #uuid "f7751525-7c16-596e-8c69-5d8f650009fe" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473665} {:answer-field/choices [{:answer/id #uuid "860e69b6-35d8-5d31-ba12-9202b482813d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472542} {:answer/id #uuid "4b8bf411-3432-5e8d-81ec-008c129f27d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472543}] :answer-field/correct {:answer/id #uuid "4b8bf411-3432-5e8d-81ec-008c129f27d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472543} :answer-field/id #uuid "09f14689-536e-5986-8e63-f7f4a981a39f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77e87c43-f6db-5082-9277-93ef32960dff" :question/math-academy-id "q-125659" :question/problem "Consider the vector field $F(x,y)=2x\\operatorname{arctan}⁡2y\\,i+\\frac{2{x}^{2}}{1+4{y}^{2}}\\,j.$ Which of the following statements are true?\n- **I.** $F$ is **not** conservative\n- **II.** ${\\int }_{C}F\\cdot \\text{d}r=0$ for any smooth path $C\\in {R}^{2}$\n- **III.** ${∮}_{C}F\\cdot \\text{d}r=0$ for any ellipse $C\\in {R}^{2}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "If $F$ is a conservative vector field on ${R}^{2},$ then the circulation $Γ=0$ for any *closed* path $C\\in {R}^{2},$ that is \n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r=0.\n$$\n\nWe notice that $F=P\\,i+Q\\,j$ is a vector field with domain $D={R}^{2}.$ Computing the partial derivatives, we have\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=\\frac{4x}{1+4{y}^{2}}.\n$$\n\nWith that in mind, let's consider each statement in turn:\n\n- Statement I is false. The vector field $F$ is conservative since the partial derivatives are equal and continuous everywhere on ${R}^{2}.$\n\n- Statement II is false, while statement III is true. The result $Γ=0$ applies to closed curves only.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186415476 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071ee791-8aa1-59a9-829e-f23787b55570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473130} {:answer/id #uuid "be789ad4-7b1c-517c-b647-7e02fbdc4606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473131}] :answer-field/correct {:answer/id #uuid "be789ad4-7b1c-517c-b647-7e02fbdc4606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473131} :answer-field/id #uuid "1c846e82-5642-55c2-bd6c-bf9a65cc14b7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473960} {:answer-field/choices [{:answer/id #uuid "380f5ebb-1b0a-524b-8107-7d50c50a8d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473132} {:answer/id #uuid "2adc7349-dd06-5e86-bb35-5bbbb5b04583" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473133}] :answer-field/correct {:answer/id #uuid "380f5ebb-1b0a-524b-8107-7d50c50a8d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473132} :answer-field/id #uuid "37aa9389-4822-5c22-ad9b-bf758d46df45" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473961} {:answer-field/choices [{:answer/id #uuid "c2322edf-ee14-5f20-8831-ec7cadfc1dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473134} {:answer/id #uuid "d8ca5be3-1fbc-5f41-bcbb-41b53ef5da56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473135}] :answer-field/correct {:answer/id #uuid "d8ca5be3-1fbc-5f41-bcbb-41b53ef5da56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473135} :answer-field/id #uuid "873d7824-ac7f-5ce0-ad45-49263a39fd15" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d883981-f066-5218-a1bf-dd76574de46e" :question/math-academy-id "q-42469" :question/problem "$$\nA=\\begin{bmatrix}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n- **I.** $A$ has proportional columns\n- **II.** $A$ has identical rows\n- **III.** $A$ has a zero row\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=\\begin{bmatrix}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{bmatrix}\\,✓\n$$\n\n- $A$ does *not* have identical rows.\n\n- $A$ has a zero row: \n\n$$\nA=\\begin{bmatrix}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415444} :db/id #edb/ref 17592186415484}]} {:db/id #edb/ref 17592186415479 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c54ada56-3e8b-562f-84dd-634b27dac9cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453904} {:answer/id #uuid "1bc835ea-e9b6-5ca5-a77e-0c3bd1af050b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453905}] :answer-field/correct {:answer/id #uuid "c54ada56-3e8b-562f-84dd-634b27dac9cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453904} :answer-field/id #uuid "63c0a961-3dd4-5dcd-85e3-43b3a0493c55" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454702} {:answer-field/choices [{:answer/id #uuid "2456bbca-5dde-5fa3-a774-4b5dfb8431ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453906} {:answer/id #uuid "1b80c1f5-4c11-5a34-bb1a-faf5cdfce42f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453907}] :answer-field/correct {:answer/id #uuid "2456bbca-5dde-5fa3-a774-4b5dfb8431ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453906} :answer-field/id #uuid "36456e08-b5e0-5ffb-8bc0-2e13784267ad" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454703} {:answer-field/choices [{:answer/id #uuid "5e336f47-61c7-5dfa-b071-bc593d519e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453908} {:answer/id #uuid "05d59b93-9de5-5bdc-af50-0154b6214595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453909}] :answer-field/correct {:answer/id #uuid "05d59b93-9de5-5bdc-af50-0154b6214595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453909} :answer-field/id #uuid "0bb3bd4f-a1b2-5b23-a316-a0c1d1cd0bc3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454704}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8a11ae3-b740-5975-a251-a4796d69b742" :question/math-academy-id "q-43307" :question/problem "Let $A$ be a $3\\times 3$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\nSelect all that apply.\n\n- **I.** $A$ has a zero column\n- **II.** $A$ has two proportional rows\n- **III.** One of the rows/columns of $A$ is a linear combination of other rows/columns of $A$" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and II are false. For example, consider the matrix \n\n$$\nA=\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 3\\end{bmatrix}.\n$$\n\nExpending across the $1$st column, we have that \n\n$$\n\\begin{aligned}|A| & =1\\cdot \\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}+1\\begin{vmatrix}1 & 2 \\\\ 1 & 1\\end{vmatrix} \\\\  & =(3-2)+(1-2) \\\\  & =0\\end{aligned}\n$$\n\nbut $A$ has neither a zero column nor two proportional rows.\n\n- Statement III is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nTherefore, the correct answer is \"III only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415444} :db/id #edb/ref 17592186415481} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186416113} :db/id #edb/ref 17592186416117}]} {:db/id #edb/ref 17592186415620 :knowledge-point/_questions [{:db/id #edb/ref 17592186203912 :knowledge-point/id #uuid "04206f72-e018-5925-a58f-179e897595dc" :knowledge-point/title "Determining the Existence of a Multiplicative Inverse" :topic/_knowledge-points [{:db/id #edb/ref 17592186050670 :topic/id #uuid "5da1bf0d-a741-59f5-981a-d9099d93b347" :topic/math-academy-id 4818 :to