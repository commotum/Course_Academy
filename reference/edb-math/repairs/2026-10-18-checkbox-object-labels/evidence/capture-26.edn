86408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "579647d8-78b0-511b-8a94-882ec6fc1b22" :question/math-academy-id "q-212923" :question/problem "Given the relation $R$ on $N$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x>y,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $6\\,R\\,8$\n\n- **II.** $7\\,R\\,2$\n\n- **III.** $9\\,\\cancel{\\,R\\,}\\,1$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x>y.$ For this relation, note that\n\n- the symbols $R$ and $>$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $≯$ (or, equivalently, $\\cancel{\\,R\\,}$ and $\\le $) are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is false. Replacing $R$ with the symbol $>,$ we have $6>8,$ which is false.\n\n- Statement II is true. Replacing $R$ with the symbol $>,$ we have $7>2,$ which is true.\n\n- Statement III is false. Replacing $\\cancel{\\,R\\,}$ with the symbol $\\le ,$ we have $9\\le 1,$ which is false.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186411678 :knowledge-point/_questions [{:db/id #edb/ref 17592186203899 :knowledge-point/id #uuid "ff71f3f5-8383-5815-ba42-289f14e16b57" :knowledge-point/title "Identifying Ordered Pairs Belonging to a Standard Relation" :topic/_knowledge-points [{:db/id #edb/ref 17592186050176 :topic/id #uuid "340a9570-0274-5535-83f9-7912961ba2ff" :topic/math-academy-id 4826 :topic/title "Relations on Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8587e734-006d-527c-a8c8-73090b97f285" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453688} {:answer/id #uuid "982f7ef5-cc7e-5bf7-b407-84e014e93125" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453689}] :answer-field/correct {:answer/id #uuid "8587e734-006d-527c-a8c8-73090b97f285" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453688} :answer-field/id #uuid "5d106978-3825-5783-b82f-260e5e09a3b0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454594} {:answer-field/choices [{:answer/id #uuid "e259bb54-f7de-5f20-98e7-eb69df3da9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453690} {:answer/id #uuid "875ac699-118d-533e-b443-208590e44f69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453691}] :answer-field/correct {:answer/id #uuid "e259bb54-f7de-5f20-98e7-eb69df3da9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453690} :answer-field/id #uuid "3afd2430-2118-5392-b5f4-b679fd87253d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454595} {:answer-field/choices [{:answer/id #uuid "f51b0a65-f7e4-568e-89be-e3f7bb38c80c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453692} {:answer/id #uuid "fc36dd43-c708-5750-9ae9-ccf65e36644d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453693}] :answer-field/correct {:answer/id #uuid "fc36dd43-c708-5750-9ae9-ccf65e36644d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453693} :answer-field/id #uuid "0ec8cb5f-e291-5762-af3e-74fccda3b99e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8c98d98-74bc-5116-9f06-75c38fdcf981" :question/math-academy-id "q-212926" :question/problem "Given the relation $R$ on $Z$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x∣y,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $6\\,R\\,3$\n\n- **II.** $5\\,R\\,8$\n\n- **III.** $7\\,\\cancel{\\,R\\,}\\,9$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x∣y.$ For this relation, note that\n\n- the symbols $R$ and $∣$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $∤$ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is false. Replacing $R$ with the symbol $∣,$ we have $6∣3,$ which is false.\n\n- Statement II is false. Replacing $R$ with the symbol $∣,$ we have $5∣8,$ which is false.\n\n- Statement III is true. Replacing $\\cancel{\\,R\\,}$ with the symbol $∤,$ we have $7∤9,$ which is true.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186411679 :knowledge-point/_questions [{:db/id #edb/ref 17592186203900 :knowledge-point/id #uuid "9d05194c-249d-54fb-91f1-f614c0f5e584" :knowledge-point/title "Identifying Ordered Pairs Belonging to a Non-Standard Relation" :topic/_knowledge-points [{:db/id #edb/ref 17592186050176 :topic/id #uuid "340a9570-0274-5535-83f9-7912961ba2ff" :topic/math-academy-id 4826 :topic/title "Relations on Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3be0482-1c32-56e5-b32c-2635eff5a37b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453694} {:answer/id #uuid "ef0e7071-7690-5bc0-ab58-bae0b887668b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453695}] :answer-field/correct {:answer/id #uuid "ef0e7071-7690-5bc0-ab58-bae0b887668b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453695} :answer-field/id #uuid "910ed7f6-3d15-5d27-b480-93608abd7075" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454597} {:answer-field/choices [{:answer/id #uuid "0913762f-fc0f-5198-926a-6361a944a14e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453696} {:answer/id #uuid "8bec21ae-64f9-5251-8628-9b76f8b449b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453697}] :answer-field/correct {:answer/id #uuid "8bec21ae-64f9-5251-8628-9b76f8b449b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453697} :answer-field/id #uuid "b6814b33-9263-5cde-8a29-2d9f13981261" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454598} {:answer-field/choices [{:answer/id #uuid "cdff64e7-785c-5a19-9710-d19ab6a540d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453698} {:answer/id #uuid "75097d40-93bc-5fc9-9154-d423738c8e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453699}] :answer-field/correct {:answer/id #uuid "75097d40-93bc-5fc9-9154-d423738c8e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453699} :answer-field/id #uuid "5e55a813-df68-5a59-b03e-aaafd1e0f4b6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454599}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5b2a52b-fd77-5422-b1dc-3a9ca690060e" :question/math-academy-id "q-212983" :question/problem "Given the relation $R$ on $Z$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x≡y+4\\,(\\text{mod}\\,6),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $0\\,R\\,2$\n\n- **II.** $1\\,R\\,9$\n\n- **III.** $4\\,\\cancel{\\,R\\,}\\,13$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x≡y+4\\,(\\text{mod}\\,6),$ or equivalently, $x\\,R\\,y$ if and only if $6∣(x-y-4).$ \n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is true. In this case, we have $6∣(0-2-4),$ which is true.\n\n- Statement II is true. In this case, we have $6∣(1-9-4),$ which is true.\n\n- Statement III is true. In this case, we have $6∤(4-13-4),$ which is true.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186411856 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577c6459-a68e-5617-9007-38fe998472ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454202} {:answer/id #uuid "9803254f-68b7-5b7e-936e-f2b01fcb4624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454203}] :answer-field/correct {:answer/id #uuid "577c6459-a68e-5617-9007-38fe998472ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454202} :answer-field/id #uuid "40924b97-51ec-57fe-9300-e75dc6817c4c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454851} {:answer-field/choices [{:answer/id #uuid "3d6225d8-02a3-5861-9a49-a929038a7ee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454204} {:answer/id #uuid "b251d743-a66c-5bae-a8cf-5ca14a90f254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454205}] :answer-field/correct {:answer/id #uuid "3d6225d8-02a3-5861-9a49-a929038a7ee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454204} :answer-field/id #uuid "6cae005c-ab57-5373-a6f8-1aefd15ba7ba" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454852} {:answer-field/choices [{:answer/id #uuid "c7230c31-5927-5a08-a14e-0066312e17b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454206} {:answer/id #uuid "98cbb68b-2336-539d-bb6a-8b6710f91c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454207}] :answer-field/correct {:answer/id #uuid "98cbb68b-2336-539d-bb6a-8b6710f91c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454207} :answer-field/id #uuid "e249821b-901a-5fb1-b815-d0984e6c7c99" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454853}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "409399cd-9cd7-53bb-83f5-ffa99003572c" :question/math-academy-id "q-95407" :question/problem "Given that $A$ is a real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ must have a complex eigenvalue\n\n- **II.** $A$ is not diagonalizable\n\n- **III.** If $u$ and $v$ are two eigenvectors corresponding to different eigenvalues, then $u⊥v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the spectral theorem, the eigenvalues are real.\n\n- Statement II is false. According to the spectral theorem, any symmetric matrix with real entries is orthogonally diagonalizable, so, $A$ is diagonalizable.\n\n- Statement III is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046660} :activity/title "Mathematical Methods for the Physical Sciences II: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186420497} :db/id #edb/ref 17592186420512} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"} :activity/title "The Spectral Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559000} :db/id #edb/ref 17592186559976}]} {:db/id #edb/ref 17592186411865 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set" :topic/_knowledge-points [{:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319 :topic/title "Orthogonal Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} {:answer/id #uuid "363acb19-a7c4-58f9-889f-e407b2331d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472785}] :answer-field/correct {:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} :answer-field/id #uuid "51607494-5a75-5d4c-92f2-cb8a34490a90" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473787} {:answer-field/choices [{:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} {:answer/id #uuid "7e0850f2-9a46-5214-af3b-d2ee5b9d05f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472787}] :answer-field/correct {:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} :answer-field/id #uuid "576b8513-a337-57bb-a0b8-42a8d11e9c97" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473788} {:answer-field/choices [{:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} {:answer/id #uuid "9252ae02-4d55-5e0b-ab06-d7222907f63c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472789}] :answer-field/correct {:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} :answer-field/id #uuid "b8436333-b398-5406-b728-7406ac2b71f3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d807e12-6960-57f6-b74d-aa3fe66f0f76" :question/math-academy-id "q-178271" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. ${u}_{1}\\cdot {u}_{3}=0$\n\nII. $\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthogonal\n\nIII. $\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false since\n\n$$\n{u}_{1}\\cdot {u}_{3}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}=3\\ne 0.\n$$\n\n- Statement II is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{3})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{3})={u}_{1}\\cdot {u}_{3}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046660} :activity/title "Mathematical Methods for the Physical Sciences II: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186420497} :db/id #edb/ref 17592186420522} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046660} :activity/title "Mathematical Methods for the Physical Sciences II: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186545198} :db/id #edb/ref 17592186546007}]} {:db/id #edb/ref 17592186412004 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28cc783d-0e04-52b2-86df-236d896481c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473356} {:answer/id #uuid "46a9d129-ef86-55ea-a49c-ad5f819bc93b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473357}] :answer-field/correct {:answer/id #uuid "28cc783d-0e04-52b2-86df-236d896481c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473356} :answer-field/id #uuid "3759d021-c15d-5f94-bf0f-aa713cb06b19" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474073} {:answer-field/choices [{:answer/id #uuid "5a3997f5-e7eb-5b23-a96c-7b63dc3096d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473358} {:answer/id #uuid "cc3abe6b-0a1b-5b0e-88aa-5350d602ba73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473359}] :answer-field/correct {:answer/id #uuid "cc3abe6b-0a1b-5b0e-88aa-5350d602ba73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473359} :answer-field/id #uuid "893f8dbf-f063-518c-9f05-3f90f1e69ab0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474074} {:answer-field/choices [{:answer/id #uuid "1ef8546b-c47c-5327-b7a1-c64d2e6e8c01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473360} {:answer/id #uuid "4219ddb4-e932-5bd3-ae3b-efec94587db8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473361}] :answer-field/correct {:answer/id #uuid "1ef8546b-c47c-5327-b7a1-c64d2e6e8c01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473360} :answer-field/id #uuid "69938d67-9d92-50b1-a0c1-f38ae0ed687a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40dd9397-7325-5b4d-9df5-fd6f72af0a3c" :question/math-academy-id "q-76978" :question/problem "Given that $7≡19\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n- **I.** $n=5$\n- **II.** $n=6$\n- **III.** $n=7$\n\nSelect all that apply." :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=7-19=-12.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $5∤(-12).$ Therefore, the statement is false when $n=5.$\n\n- Note that $6∣(-12)$ because $(-12)÷6=-2,$ and there is no remainder. Therefore, the statement is true when $n=6.$\n\n- Note that $7∤(-12).$ Therefore, the statement is false when $n=7.$\n\nTherefore, the correct answer is \"II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"} :activity/title "Modular Congruence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186411972} :db/id #edb/ref 17592186412012}]} {:db/id #edb/ref 17592186412006 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bae15cd1-2153-5765-8851-e11f5084cb94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472460} {:answer/id #uuid "b1941e2a-6399-5867-8fd2-8397a65c3736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472461}] :answer-field/correct {:answer/id #uuid "b1941e2a-6399-5867-8fd2-8397a65c3736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472461} :answer-field/id #uuid "6bd2169e-2963-565f-b2c3-acf4b032dd7d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473625} {:answer-field/choices [{:answer/id #uuid "f3b3e9a3-10df-59d2-9aaf-723f387bfeff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472462} {:answer/id #uuid "fda30b1a-11fa-50d8-acc0-9459616edd82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472463}] :answer-field/correct {:answer/id #uuid "fda30b1a-11fa-50d8-acc0-9459616edd82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472463} :answer-field/id #uuid "f3c7a717-d8a9-5f11-874c-25dd59863722" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473626} {:answer-field/choices [{:answer/id #uuid "e3c377ae-6819-55aa-9670-acd2f63f98b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472464} {:answer/id #uuid "2fd132f0-8e79-5cac-a8ae-b44c9aeb8654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472465}] :answer-field/correct {:answer/id #uuid "e3c377ae-6819-55aa-9670-acd2f63f98b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472464} :answer-field/id #uuid "6ab28e49-bde5-57c6-bbd6-efe09ce734f0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473627}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e4ac9e6-575d-537d-b731-f3556414b8f1" :question/math-academy-id "q-103492" :question/problem "Given that $15≡7\\,(\\text{mod}\\,n)$, which of the following could be the value of $n?$\n- **I.** $n=2$\n- **II.** $n=4$\n- **III.** $n=6$\n\nSelect all that apply." :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=15-7=8.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $2∣8$ because $8÷2=4,$ and there is no remainder. Therefore, the statement is true when $n=2.$\n\n- Note that $4∣8$ because $8÷4=2,$ and there is no remainder. Therefore, the statement is true when $n=4.$\n\n- Note that $6∤8.$ Therefore, the statement is false when $n=6.$\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"} :activity/title "Modular Congruence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186411972} :db/id #edb/ref 17592186412011}]} {:db/id #edb/ref 17592186412007 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dcda3a9f-e8ac-5506-9e81-4e0c7adb449f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472862} {:answer/id #uuid "d51a1602-8985-583c-a7de-3b29ff3d2fa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472863}] :answer-field/correct {:answer/id #uuid "d51a1602-8985-583c-a7de-3b29ff3d2fa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472863} :answer-field/id #uuid "36163b9e-ff7c-575e-882b-03250c0c2242" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473826} {:answer-field/choices [{:answer/id #uuid "5e0b178c-927e-5ffe-bb0f-a0a4642911b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472864} {:answer/id #uuid "49892b1b-bf63-5dba-9c8c-a402779aa85a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472865}] :answer-field/correct {:answer/id #uuid "5e0b178c-927e-5ffe-bb0f-a0a4642911b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472864} :answer-field/id #uuid "d2efcf26-7033-5f97-a19a-2bd5d52b34ba" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473827} {:answer-field/choices [{:answer/id #uuid "9d995976-59a9-586b-825a-5a32e1e3c605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472866} {:answer/id #uuid "b699bc0a-fb3a-5599-a7b0-e1da985019b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472867}] :answer-field/correct {:answer/id #uuid "9d995976-59a9-586b-825a-5a32e1e3c605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472866} :answer-field/id #uuid "244f56e9-e3b0-51b6-90fe-1f1a02b2e44a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd2ee89b-0850-5297-a810-7e54facce40b" :question/math-academy-id "q-212522" :question/problem "Given that $-7≡-3\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n- **I.** $n=2$\n- **II.** $n=3$\n- **III.** $n=7$\n\nSelect all that apply." :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=-7-(-3)=-4.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $2∣(-4)$ because $(-4)÷2=-2,$ and there is no remainder. Therefore, the statement is true when $n=2.$\n\n- Note that $3∤(-4).$ Therefore, the statement is false when $n=3.$\n\n- Note that $7∤(-4).$ Therefore, the statement is false when $n=7.$\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"} :activity/title "Modular Congruence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186411972} :db/id #edb/ref 17592186412009}]} {:db/id #edb/ref 17592186412061 :knowledge-point/_questions [{:db/id #edb/ref 17592186119931 :knowledge-point/id #uuid "a6a3d254-c96f-5aa0-9db6-a587eb7cb2de" :knowledge-point/title "Calculating an Expression Involving Given Determinants and Matrix Types" :topic/_knowledge-points [{:db/id #edb/ref 17592186049159 :topic/id #uuid "df2bac79-2def-521c-b3f0-baba942d57fa" :topic/math-academy-id 1771 :topic/title "Basic Properties of Determinants"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3992319-c3cb-5cd7-aacc-a323343357a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473136} {:answer/id #uuid "3bbddcbd-2bf5-5bf2-97da-7ac2cb579d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473137}] :answer-field/correct {:answer/id #uuid "3bbddcbd-2bf5-5bf2-97da-7ac2cb579d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473137} :answer-field/id #uuid "fdf25248-1682-59e7-95bb-1d361adf535a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473963} {:answer-field/choices [{:answer/id #uuid "8c0376ef-55b1-5b59-b083-c9871e0d3de3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473138} {:answer/id #uuid "1c79da45-cd4c-5734-b84e-b0bd3128fb29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473139}] :answer-field/correct {:answer/id #uuid "1c79da45-cd4c-5734-b84e-b0bd3128fb29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473139} :answer-field/id #uuid "d551a1fd-027b-537b-97dc-dacedd3d1459" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473964} {:answer-field/choices [{:answer/id #uuid "15ce1514-9241-5a99-9a0c-8b77acadae75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473140} {:answer/id #uuid "99ad0e7f-4641-5c69-9b59-23ddd75d5e3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473141}] :answer-field/correct {:answer/id #uuid "15ce1514-9241-5a99-9a0c-8b77acadae75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473140} :answer-field/id #uuid "ecef3e14-be54-5f11-801f-ad8edf3590fd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03fcc7d2-8c99-53e1-b5b5-d7a0f5cd296f" :question/math-academy-id "q-42481" :question/problem "Given that $det(A)=14$, and $I$ is the $3\\times 3$ identity matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{det}(A)-\\text{det}(3I)=-13$\n\n- **II.** $-\\text{det}({A}^{T})+\\text{det}(I)=-13$\n\n- **III.** $\\text{det}(A)-\\text{det}({A}^{T})=-28$" :question/worked-solution "From the properties of determinants, we know that \n\n$$\n\\text{det}({A}^{T})=\\text{det}(A)=14\n$$\n\nand\n\n$$\ndet(I)=1.\n$$\n\nNow, notice that\n\n$$\n\\begin{aligned}3I & =3\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe determinant of a diagonal matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{vmatrix} & ={3}^{3}=27.\\end{aligned}\n$$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is true. Indeed,\n\n$$\n\\text{det}(A)-\\text{det}(3I)=14-27=-13\n$$\n\n- Statement II is true. Indeed,\n\n$$\n-\\text{det}({A}^{T})+\\text{det}(I)=-14+1=-13\n$$\n\n- Statement III is false. We have\n\n$$\n\\text{det}(A)-\\text{det}({A}^{T})=14-14=0\\ne -28\n$$\n\nIn conclusion, the correct answer is \"I and II only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049159 :topic/id #uuid "df2bac79-2def-521c-b3f0-baba942d57fa" :topic/math-academy-id 1771 :topic/title "Basic Properties of Determinants"} :activity/title "Basic Properties of Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412054} :db/id #edb/ref 17592186412066}]} {:db/id #edb/ref 17592186412421 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "538e7fe6-b399-5899-a9f8-ecf6b1aae817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453842} {:answer/id #uuid "ef9fecf5-e15f-5c9e-8512-53b3ec9864c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453843}] :answer-field/correct {:answer/id #uuid "ef9fecf5-e15f-5c9e-8512-53b3ec9864c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453843} :answer-field/id #uuid "b361575c-aa03-5dbf-b411-97171b912788" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454671} {:answer-field/choices [{:answer/id #uuid "98ef04fa-1c1c-50a2-bdbb-2d85ae96f31e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453844} {:answer/id #uuid "48b4ae45-27c7-56eb-8ab2-ae845aa073be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453845}] :answer-field/correct {:answer/id #uuid "98ef04fa-1c1c-50a2-bdbb-2d85ae96f31e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453844} :answer-field/id #uuid "93942ac4-88b5-56a0-89a7-6a3ffa4986b0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454672} {:answer-field/choices [{:answer/id #uuid "c36e8ab9-e979-5531-8a73-b3a76c58382b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453846} {:answer/id #uuid "145e9b16-dc59-5418-ac2c-92a5cf27033b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453847}] :answer-field/correct {:answer/id #uuid "c36e8ab9-e979-5531-8a73-b3a76c58382b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453846} :answer-field/id #uuid "0c5d49d8-f8a3-5b1d-98ea-81d7fa4820c6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454673}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79c14c2f-568d-5ff3-b628-6c8dd8d0639f" :question/math-academy-id "q-32169" :question/problem "Let \n$A=\\begin{bmatrix}5 & -4 \\\\ 1 & 2\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The lines $5x-4y=0$ and $x+2y=0$ intersect at exactly one point\n- **II.** ${A}^{-1}$ does **not** exist\n- **III.** $Ax=0$ has no solution" :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}5 & -4 \\\\ 1 & 2\\end{bmatrix} \\\\  & =5\\cdot 2-(-4)\\cdot 1 \\\\  & =14\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement I is true by the fourth part of  the invertible matrix theorem.\n\n- Statement II is false by the first part of the invertible matrix theorem.\n\n- Statement III is false. According to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement I is true."} {:db/id #edb/ref 17592186412805 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050221 :topic/id #uuid "3748163a-70f7-518f-9382-77b8230a6624" :topic/math-academy-id 3237 :topic/title "General Solutions of First-Order Linear Systems of ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1c0b90-23e9-5b83-a708-3ea2a44a1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473040} {:answer/id #uuid "d96841dd-b0ce-57d2-8366-ed50689beb53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473041}] :answer-field/correct {:answer/id #uuid "2c1c0b90-23e9-5b83-a708-3ea2a44a1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473040} :answer-field/id #uuid "334c6ac2-2b02-5e0f-a88a-b19789c7086c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473915} {:answer-field/choices [{:answer/id #uuid "43066d0d-a047-5a30-8822-f5d690da8c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473042} {:answer/id #uuid "12848657-20bc-5e4e-8323-c54bfc0aa80a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473043}] :answer-field/correct {:answer/id #uuid "43066d0d-a047-5a30-8822-f5d690da8c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473042} :answer-field/id #uuid "34af04fe-4273-5909-afb6-13e9d8b36c79" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473916} {:answer-field/choices [{:answer/id #uuid "216b9e19-7285-56cb-8603-99b3f8d13d7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473044} {:answer/id #uuid "a0db2386-3a66-5f9c-a3fd-5640d25f6a54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473045}] :answer-field/correct {:answer/id #uuid "a0db2386-3a66-5f9c-a3fd-5640d25f6a54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473045} :answer-field/id #uuid "381905b6-4e83-545a-8560-cb908ea74f55" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473917}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71a6807f-51a3-5e94-a65a-0087aa5dc119" :question/math-academy-id "q-330333" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n\nSelect all that apply.\n\n- **I.** $x(t)={x}_{1}(t)\\times {x}_{2}(t)$\n\n- **II.** $x(t)=\\operatorname{sin}⁡(t)\\cdot {x}_{2}(t)$\n\n- **III.** $x(t)=-3\\cdot {x}_{2}(t)$" :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option I might be *not* a solution to the system since it's not a scalar multiple of any of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- Option II might be *not* a solution to the system since it's not a scalar multiple of any of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multiplier is not a constant.\n\n- Option III is a solution to the system. Indeed, notice that\n\n$$\n-3\\cdot {x}_{2}(t)\n$$\n\nis a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t)$ with constant multiplies ${c}_{1}=0$ and ${c}_{2}=-3,$ respectively.\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186412806 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050221 :topic/id #uuid "3748163a-70f7-518f-9382-77b8230a6624" :topic/math-academy-id 3237 :topic/title "General Solutions of First-Order Linear Systems of ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89ff11c-d1b7-5405-82c1-94c7d7c99ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473046} {:answer/id #uuid "c81e64dc-937e-5cab-8f29-f5b6154dc03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473047}] :answer-field/correct {:answer/id #uuid "c81e64dc-937e-5cab-8f29-f5b6154dc03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473047} :answer-field/id #uuid "c191f663-afad-5fac-a9f2-fac3b31f3803" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473918} {:answer-field/choices [{:answer/id #uuid "e9185fe4-0729-55cd-91d0-1540bf55d2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473048} {:answer/id #uuid "44919b96-98f2-5972-8f19-8568c044e939" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473049}] :answer-field/correct {:answer/id #uuid "e9185fe4-0729-55cd-91d0-1540bf55d2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473048} :answer-field/id #uuid "4eb579d0-ff0e-56d8-afd8-faecf8a98e18" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473919} {:answer-field/choices [{:answer/id #uuid "498d2ce6-8636-51d1-aabe-214949bb04ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473050} {:answer/id #uuid "4038ba31-96d0-5ea2-80fe-ff8ad8b3e1b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473051}] :answer-field/correct {:answer/id #uuid "4038ba31-96d0-5ea2-80fe-ff8ad8b3e1b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473051} :answer-field/id #uuid "a207e67d-e805-59c2-970d-7203de37688e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5a0af42-71ea-5bb3-8eb8-b8b29ef8a2c6" :question/math-academy-id "q-330354" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n- **I.** $x(t)={x}_{1}(t)+{x}_{2}(t)$\n- **II.** $x(t)=\\operatorname{sin}⁡(t)\\cdot {x}_{1}(t)-\\operatorname{cos}⁡(t)\\cdot {x}_{2}(t)$\n- **III.** $x(t)={x}_{1}(t)-{x}_{2}(t)$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option I is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)+{x}_{2}(t)\n$$\n\nis a linear combination of the solutions with constant multiplies ${c}_{1}=1$ and ${c}_{2}=1,$ respectively.\n\n- Option II might be *not* a solution to the system since it's not a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multipliers of the first and the second terms are not constant.\n\n- Option III is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)-{x}_{2}(t)\n$$\n\nis a linear combination of the solutions with constant multiplies ${c}_{1}=1$ and ${c}_{2}=-1,$ respectively.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186412961 :knowledge-point/_questions [{:db/id #edb/ref 17592186152100 :knowledge-point/id #uuid "d1a842b5-7256-59cd-b33f-d590bc315d84" :knowledge-point/title "Identifying True Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d90f90f5-3e74-572c-aa89-9724b4da180e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453988} {:answer/id #uuid "11a83033-f355-5373-a7f0-51d0ef965472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453989}] :answer-field/correct {:answer/id #uuid "d90f90f5-3e74-572c-aa89-9724b4da180e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453988} :answer-field/id #uuid "69f93893-49bf-50eb-9cb8-5100bc1b0a48" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454744} {:answer-field/choices [{:answer/id #uuid "caafc5ae-8676-58f7-be01-e74b00b73515" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453990} {:answer/id #uuid "2dad5cff-3cef-5b95-a702-f2684708b692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453991}] :answer-field/correct {:answer/id #uuid "caafc5ae-8676-58f7-be01-e74b00b73515" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453990} :answer-field/id #uuid "cf3b9fd7-6d29-582c-857b-0ed344345e75" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454745} {:answer-field/choices [{:answer/id #uuid "d2ebe3c7-2898-5c09-95a0-a9683da87a51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453992} {:answer/id #uuid "6cf20969-d67c-5204-9e7c-1a8067b679d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453993}] :answer-field/correct {:answer/id #uuid "6cf20969-d67c-5204-9e7c-1a8067b679d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453993} :answer-field/id #uuid "471dce59-5681-5b77-b94e-7501e5f87b82" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454746}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f9012f2-83ba-5f6f-b553-2ea47d5d4f81" :question/math-academy-id "q-78640" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** There are $3$ distinct residue classes modulo $6$\n\n- **II.** $[5]_{3}\\cap [1]_{3}\\ne ∅$\n\n- **III.** $Z=[3]_{2}\\cup [6]_{2}$" :question/worked-solution "Recall that the residue classes modulo $n$ have the following properties:\n\n- There are exactly $n$ distinct residue classes modulo $n$\n\n- Two distinct residue classes have an empty intersection: $[a]_{n}\\cap [b]_{n}=∅$ if $a≢b\\,(\\text{mod}\\,n)$\n\n- Residue classes modulo $n$ form a partition of the set of all integers: \n\n$$\nZ=[0]_{n}\\cup [1]_{n}\\cup ⋯\\cup [n-1]_{n}\n$$\n\n- The integers modulo $n$ is defined as the set containing all distinct residue classes modulo $n$: \n\n$$\n{Z}_{n}=\\{[0]_{n},\\,[1]_{n},\\,…,\\,[n-1]_{n}\\}\n$$\n\nWith that in mind, let's now consider each of the given statements.\n\n- Statement I is false. There are exactly $6$ distinct residue classes modulo $6.$\n\n- Statement II is false. Since $5≢1\\,(\\text{mod }3),$ we have that $[5]_{3}\\cap [1]_{3}=∅.$\n\n- Statement III is true. First, notice the following:\n\n$$\n\\begin{aligned}[3]_{2} & =[1+2\\cdot 1]_{2}=[1]_{2} \\\\ [6]_{2} & =[0+2\\cdot 3]_{2}=[0]_{2}\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}[3]_{2}\\cup [6]_{2} & =[1]_{2}\\cup [0]_{2} \\\\  & =[0]_{2}\\cup [1]_{2} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186412964 :knowledge-point/_questions [{:db/id #edb/ref 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c3ece1-9a5e-52f4-8699-73139d9a6a37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473004} {:answer/id #uuid "0563223b-220c-58df-9201-b1e95a708764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473005}] :answer-field/correct {:answer/id #uuid "0563223b-220c-58df-9201-b1e95a708764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473005} :answer-field/id #uuid "112786af-b7c6-53b8-bad3-b5ce3ac037cf" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473897} {:answer-field/choices [{:answer/id #uuid "2beadd3e-28d3-5177-a991-6ac6e547dcd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473006} {:answer/id #uuid "05064f80-545d-5b21-ac39-0deff32cdce1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473007}] :answer-field/correct {:answer/id #uuid "2beadd3e-28d3-5177-a991-6ac6e547dcd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473006} :answer-field/id #uuid "b5d9f3bb-8e2c-5510-b22f-bc287c4c9d3d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473898} {:answer-field/choices [{:answer/id #uuid "ae4c9241-2ba0-574d-b41a-55b7771a6440" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473008} {:answer/id #uuid "7bc3c013-0913-5495-8e49-25ca6a801a0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473009}] :answer-field/correct {:answer/id #uuid "7bc3c013-0913-5495-8e49-25ca6a801a0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473009} :answer-field/id #uuid "6116a5f6-75a3-57f5-8b9a-87c19cf2e1cc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473899}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44e36839-2675-57c4-abf9-91a0b0717003" :question/math-academy-id "q-214450" :question/problem "Which of the following integers belong to the residue class $[4]_{7}?$\n\nI. $-3$\n\nII. $6$\n\nIII. $18$\n\nSelect all that apply." :question/worked-solution "The residue class $[4]_{7}$ consists of the elements that are congruent to $4$ modulo $7.$ So, we have\n\n$$\n\\begin{aligned}[4]_{7} & =\\{x\\in Z\\,|\\,x≡4\\,(\\text{mod}\\,7)\\} \\\\  & =\\{x\\in Z\\,|\\,x=4+7k,\\,k\\in Z\\} \\\\  & =\\{4+7k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,4-2\\cdot 7,\\,4-7,\\,4,\\,4+7,\\,4+2\\cdot 7,\\,…\\} \\\\  & =\\{…,-10,-3,4,11,18,…\\}.\\end{aligned}\n$$\n\nWe see that $-3$ and $18$ belong to $[4]_{7},$ while $6$ does not.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186412965 :knowledge-point/_questions [{:db/id #edb/ref 17592186152098 :knowledge-point/id #uuid "9c1fe7ea-d91e-5440-b756-37a460a18f19" :knowledge-point/title "Identifying Residue Classes Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9484721d-864f-51dd-8b2c-88dc3adc7bc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473398} {:answer/id #uuid "2bdcccb2-b950-5109-ab8d-ad162ce8aac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473399}] :