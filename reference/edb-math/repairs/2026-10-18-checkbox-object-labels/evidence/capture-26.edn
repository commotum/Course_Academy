 "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e92798a1-28cd-5dd5-b2e9-27e9b6a2d6bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473392} {:answer/id #uuid "075671dd-b5fc-5771-8f9d-ddbb0073262f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473393}] :answer-field/correct {:answer/id #uuid "e92798a1-28cd-5dd5-b2e9-27e9b6a2d6bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473392} :answer-field/id #uuid "ce963e6f-376a-5c24-8302-4cc69de86378" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474091} {:answer-field/choices [{:answer/id #uuid "47d49dff-25f6-59f4-a909-f2c5bfec4f07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473394} {:answer/id #uuid "d3abc2fc-eae4-550f-ab47-1399b30a9296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473395}] :answer-field/correct {:answer/id #uuid "d3abc2fc-eae4-550f-ab47-1399b30a9296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473395} :answer-field/id #uuid "8fa0af9b-1c1e-5da8-9559-3694afdfe725" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474092} {:answer-field/choices [{:answer/id #uuid "391f1c53-6f02-5d0a-9bb8-20eaaa862951" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473396} {:answer/id #uuid "e404fdc1-9e43-5a7b-94e8-138ab85bd5e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473397}] :answer-field/correct {:answer/id #uuid "e404fdc1-9e43-5a7b-94e8-138ab85bd5e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473397} :answer-field/id #uuid "c59e09da-a822-5efc-a2a8-ed7a9d7baeeb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474093}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a55de8de-5dbf-5007-a3cb-517652d485f3" :question/math-academy-id "q-78599" :question/problem "Which of the following integers belong to the residue class $[9]_{13}?$\n\nI. $4$\n\nII. $-17$\n\nIII. $35$\n\nSelect all that apply." :question/worked-solution "The residue class $[9]_{13}$ consists of the elements that are congruent to $9$ modulo $13.$ So, we have\n\n$$\n\\begin{aligned}[9]_{13} & =\\{x\\in Z\\,|\\,x≡9\\,(\\text{mod}\\,13)\\} \\\\  & =\\{x\\in Z\\,|\\,x=9+13k,\\,k\\in Z\\} \\\\  & =\\{9+13k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,9-2\\cdot 13,\\,9-13,\\,9,\\,9+13,\\,9+2\\cdot 13,\\,…\\} \\\\  & =\\{…,-17,-4,9,22,35,…\\}.\\end{aligned}\n$$\n\nWe see that $-17$ and $35$ belong to $[9]_{13},$ while $4$ does not.\n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186412972 :knowledge-point/_questions [{:db/id #edb/ref 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baa998ac-54ca-5267-9f36-626df9555629" :answer/type {:db/id #edb/ref 175921860454