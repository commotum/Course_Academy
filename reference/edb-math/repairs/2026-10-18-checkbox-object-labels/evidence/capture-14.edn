92186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5914278-adab-5478-b262-9e2341a90a4a" :question/math-academy-id "q-338102" :question/problem "Which of the following second-order differential equations are linear?\n- **I.** $x{y}^{″}+y={x}^{2}$\n- **II.** $y{y}^{″}+{y}^{′}=x$\n- **III.** $5{y}^{″}-{x}^{2}{y}^{′}+7{y}^{2}=x$\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation \n\n$$\nx{y}^{″}+y={x}^{2}\n$$\n\nis a second-order linear ODE with $a(x)=x,b(x)=0,c(x)=1,$ and $f(x)={x}^{2}.$\n\n- The equation \n\n$$\ny{y}^{″}+{y}^{′}=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $y{y}^{″}.$\n\n- The equation \n\n$$\n5{y}^{″}-{x}^{2}{y}^{′}+7{y}^{2}=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $7{y}^{2}.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186311917 :knowledge-point/_questions [{:db/id #edb/ref 17592186229138 :knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397" :knowledge-point/title "Identifying Linear Differential Operators Using the General Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186050537 :topic/id #uuid "51e12769-3848-5c84-bd86-1c35f7ad69b3" :topic/math-academy-id 6707 :topic/title "Linear Differential Operators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "537e9287-d40b-541a-a771-35fdebb7a68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466417} {:answer/id #uuid "b86f20e9-e99e-5043-a105-41ba0d06d907" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466418}] :answer-field/correct {:answer/id #uuid "537e9287-d40b-541a-a771-35fdebb7a68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466417} :answer-field/id #uuid "ee149c43-cd32-54e1-88b1-1a761ba1088d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467052} {:answer-field/choices [{:answer/id #uuid "56ff9540-7748-56d0-8dcc-17c53b286037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466419} {:answer/id #uuid "99c15a2b-52b5-5f4f-a9bd-e392ccd7dd01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466420}] :answer-field/correct {:answer/id #uuid "56ff9540-7748-56d0-8dcc-17c53b286037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466419} :answer-field/id #uuid "fbafeabb-acd0-55ae-b50b-63a06106240a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467053} {:answer-field/choices [{:answer/id #uuid "71c453fc-3161-5efe-87c9-b5487086f7eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466421} {:answer/id #uuid "d3699871-4a43-5354-8111-f56a66a66074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466422}] :answer-field/correct {:answer/id #uuid "d3699871-4a43-5354-8111-f56a66a66074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466422} :answer-field/id #uuid "31b0a69c-b01a-51bf-ad6d-bd58d94109aa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467054}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1c5937c-0d4d-5848-8380-65f08dc10e61" :question/math-academy-id "q-338104" :question/problem "Which of the following are linear differential operators?\n- **I.** ${D}_{1}(y)=\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)\\frac{\\text{d}y}{\\text{d}x}$\n- **II.** ${D}_{2}(y)=x\\operatorname{tan}⁡(y)\\,\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+y$\n- **III.** ${D}_{3}(y)=(1+{x}^{2})\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+\\operatorname{ln}⁡(1+x)\\frac{\\text{d}y}{\\text{d}x}+\\frac{3}{{x}^{2}}y$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the second term is $\\operatorname{sin}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is *not* linear. The coefficient of the first term is $x\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{3}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{3}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=1+{x}^{2},{f}_{1}(x)=\\operatorname{ln}⁡(1+x),$ and ${f}_{0}(x)=\\frac{3}{{x}^{2}}.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186311951 :knowledge-point/_questions [{:db/id #edb/ref 17592186166962 :knowledge-point/id #uuid "544f5154-5213-5898-a45d-4546bc8004c8" :knowledge-point/title "Understanding the Periodic Extension of a Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049306 :topic/id #uuid "eb34afb7-9644-525e-b42b-cf82816ee5e0" :topic/math-academy-id 3195 :topic/title "Introduction to Fourier Series"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4a08bf6-bbd5-5c7a-a458-cc2f28795f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450518} {:answer/id #uuid "bc472246-cf39-501b-88ba-aea193a2227d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450519}] :answer-field/correct {:answer/id #uuid "bc472246-cf39-501b-88ba-aea193a2227d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450519} :answer-field/id #uuid "1d9ed7ec-92aa-541a-9bea-f3cdc0ae0b0e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451213} {:answer-field/choices [{:answer/id #uuid "cae1de41-bd54-5836-8d70-b2f7e421082c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450520} {:answer/id #uuid "2c9484dd-5f72-59ba-b9bf-a220d37834f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450521}] :answer-field/correct {:answer/id #uuid "cae1de41-bd54-5836-8d70-b2f7e421082c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450520} :answer-field/id #uuid "dad3fb9a-3bbe-53ce-a61d-00b578edb53b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451214} {:answer-field/choices [{:answer/id #uuid "5bfb148a-1391-50e5-a4e7-bcf13b54ab32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450522} {:answer/id #uuid "47fa339f-27e5-5b52-9afc-abbb6a18cfdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450523}] :answer-field/correct {:answer/id #uuid "47fa339f-27e5-5b52-9afc-abbb6a18cfdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450523} :answer-field/id #uuid "187f487c-26a4-5852-ba9e-dad42fa9e85d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451215}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2b7e93bb-008a-52c4-ad5d-95180e45a411" :question/math-academy-id "q-338490" :question/problem "Let $F(x)=\\operatorname{sin}⁡(x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\pi $-periodic extension of $F(x)$ from $x\\in [0,\\pi )$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f(x+\\pi )=f(x)$ for all $x\\in R$\n- **II.** $f(x)=F(x)$ for all $x\\in R$\n- **III.** $f(x)=f(x-2\\pi )$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $\\pi $-periodic extension of $F,$ we have  \n\n- $f(x+\\pi )=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\pi ).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement I is true. This is exactly the definition of $\\pi $-periodicity: \n\n$$\nf(x+\\pi )=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=\\frac{3\\pi }{2}.$ Then,\n\n$$\n\\begin{aligned}f(\\frac{3\\pi }{2})=f(\\frac{\\pi }{2}+\\pi )=f(\\frac{\\pi }{2})=F(\\frac{\\pi }{2})=\\operatorname{sin}⁡(\\frac{\\pi }{2})=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(\\frac{3\\pi }{2})=\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{3\\pi }{2}.$\n\n- Statement III is true. We have\n\n$$\n\\begin{aligned}f(x) & =f((x-\\pi )+\\pi ) \\\\  & =f(x-\\pi ) \\\\  & =f((x-2\\pi )+\\pi ) \\\\  & =f(x-2\\pi )\\end{aligned}\n$$\n\nfor all $x\\in R.$\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186314699 :knowledge-point/_questions [{:db/id #edb/ref 17592186152276 :knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems" :topic/_knowledge-points [{:db/id #edb/ref 17592186050677 :topic/id #uuid "5e132315-9606-5b30-bee3-61f0209d40c4" :topic/math-academy-id 2548 :topic/title "Introduction to Second-Order Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a39e901-0aa1-5d86-b708-0e8acb2ac5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466423} {:answer/id #uuid "29e4116f-8a15-53fe-9ea6-b1b9dad75542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466424}] :answer-field/correct {:answer/id #uuid "7a39e901-0aa1-5d86-b708-0e8acb2ac5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466423} :answer-field/id #uuid "d9207047-339f-5590-b907-7f7c565f9552" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467055} {:answer-field/choices [{:answer/id #uuid "865dc4fa-d649-5eb9-a7ec-5bde925f9d64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466425} {:answer/id #uuid "dcaaf4f2-b503-5bf6-83a4-be3c5e2cef67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466426}] :answer-field/correct {:answer/id #uuid "dcaaf4f2-b503-5bf6-83a4-be3c5e2cef67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466426} :answer-field/id #uuid "2c825d3a-0580-5864-b085-36ece98d3299" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467056} {:answer-field/choices [{:answer/id #uuid "6959ade9-49ae-5973-9caa-620065c11d81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466427} {:answer/id #uuid "bfc34701-51c2-57e9-8294-7861a2a09033" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466428}] :answer-field/correct {:answer/id #uuid "6959ade9-49ae-5973-9caa-620065c11d81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466427} :answer-field/id #uuid "f6b83349-428f-55e7-acb7-eb348ac4f370" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dabe6837-4031-5ea3-85c8-7a53d65944dd" :question/math-academy-id "q-338531" :question/problem "Which of the following systems is an initial value problem?\n- **I.** ${y}^{″}-3{y}^{′}+y={e}^{x},\\,y(0)=1,\\,y(2)=0$\n- **II.** ${y}^{″}+4y=\\operatorname{sin}⁡x,\\,y(1)=2,\\,{y}^{′}(1)=-1$\n- **III.** ${y}^{″}-y={x}^{2}$\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=2$). This is a **boundary value problem.**\n\n- The second system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$).\n\n- The third system is not an initial value problem. It contains an equation only. No conditions are specified."} {:db/id #edb/ref 17592186314700 :knowledge-point/_questions [{:db/id #edb/ref 17592186152276 :knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems" :topic/_knowledge-points [{:db/id #edb/ref 17592186050677 :topic/id #uuid "5e132315-9606-5b30-bee3-61f0209d40c4" :topic/math-academy-id 2548 :topic/title "Introduction to Second-Order Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6836982-f6d8-52f8-815d-9525a8903655" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466429} {:answer/id #uuid "8a0a38e7-67c6-52ec-be17-5586868af018" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466430}] :answer-field/correct {:answer/id #uuid "a6836982-f6d8-52f8-815d-9525a8903655" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466429} :answer-field/id #uuid "2f230617-a629-5dbf-9fa6-42a16dd6c5bc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467058} {:answer-field/choices [{:answer/id #uuid "04973466-3738-5bff-b1f2-ace9af564b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466431} {:answer/id #uuid "0e8e13eb-9e6f-58ad-a231-0486e26e30f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466432}] :answer-field/correct {:answer/id #uuid "04973466-3738-5bff-b1f2-ace9af564b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466431} :answer-field/id #uuid "f2885e5d-2c03-53c7-bc3d-19f929c42aac" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467059} {:answer-field/choices [{:answer/id #uuid "4fe77deb-cfc5-5881-8d56-96c7bcafedbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466433} {:answer/id #uuid "a39275f9-b508-525c-a97a-9587ce4361a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466434}] :answer-field/correct {:answer/id #uuid "a39275f9-b508-525c-a97a-9587ce4361a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466434} :answer-field/id #uuid "750c2223-91a4-5d91-ae4f-93359625a42b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467060}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce074393-6c5e-5e9b-ab9a-92fd971d7d06" :question/math-academy-id "q-338533" :question/problem "Which of the following systems is an initial value problem?\n- **I.** ${y}^{″}-4{y}^{′}+y=\\operatorname{cos}⁡x,\\,y(0)=2,\\,y(5)=2$\n- **II.** ${y}^{″}+y={x}^{3}$\n- **III.** ${y}^{″}+2{y}^{′}={e}^{x},\\,y(-3)=0,\\,{y}^{′}(-3)=1$\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not an 