edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467002} {:answer-field/choices [{:answer/id #uuid "b033fba9-aa64-512d-a47b-ee5a966fb49b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466319} {:answer/id #uuid "e3e28aaa-7313-5516-adc5-06bd1a4249cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466320}] :answer-field/correct {:answer/id #uuid "b033fba9-aa64-512d-a47b-ee5a966fb49b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466319} :answer-field/id #uuid "e089d006-f109-5586-8f39-6db728f8f9b6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8de3c48f-01de-56bf-9ee6-1a3bd0e95cc5" :question/math-academy-id "q-335251" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n- **I.** ${F}_{1}(t)={\\int }_{0}^{1}\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}\\,\\text{d}x,\\,t\\in (-1,1)$\n- **II.** ${F}_{2}(t)={\\int }_{0}^{1}\\frac{1}{x-t}\\,\\text{d}x,\\,t\\in (1,2)$\n- **III.** ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{|x-t|}}\\,\\text{d}x,\\,t\\in (0,1)$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}.\n$$\n\nWe fix ${t}_{0}\\in (-1,1)$ and choose $[c,d]⊂(-1,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R$ (since $1+tx>0$). Computing the  partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=\\frac{x}{(1+tx)(1+{x}^{2})}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all $t\\in (-1,1).$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{1}{x-t}.\n$$\n\nWe fix ${t}_{0}\\in (1,2)$ and choose $[c,d]⊂(1,2)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=\\frac{1}{(x-t)^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all $t\\in (1,2).$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{\\sqrt{|x-t|}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $[c,d]⊂(0,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that this function is undefined when $x=t,$ since the denominator vanishes. Thus, ${f}_{3}$ is not continuous on $R,$ and differentiating under the integral sign is *not* valid.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186311555 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies" :topic/_knowledge-points [{:db/id #edb/ref 17592186048817 :topic/id #uuid "c277f404-7746-5317-a99f-359354eb8c6a" :topic/math-academy-id 6682 :topic/title "Differentiating Under the Integral Sign"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f7e4c1-6c8c-516f-99d4-3016aca7887a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466321} {:answer/id #uuid "a65ba9ef-0cc8-52d0-9799-3481656ed4a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466322}] :answer-field/correct {:answer/id #uuid "a65ba9ef-0cc8-52d0-9799-3481656ed4a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466322} :answer-field/id #uuid "591c30be-8419-5dc6-80a9-275d90e3124a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467004} {:answer-field/choices [{:answer/id #uuid "d9372c8d-42b6-5923-978a-5855e094b76b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466323} {:answer/id #uuid "b5b3441a-93b7-54ca-a1d1-eb627c0c175b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466324}] :answer-field/correct {:answer/id #uuid "d9372c8d-42b6-5923-978a-5855e094b76b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466323} :answer-field/id #uuid "7308a380-c9c9-5971-af9f-58b1d0cea85c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467005} {:answer-field/choices [{:answer/id #uuid "d96d0868-95f2-538f-a7e5-d8a250db5ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466325} {:answer/id #uuid "9df9f9c9-4956-531c-b65e-ed180dad9e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466326}] :answer-field/correct {:answer/id #uuid "9df9f9c9-4956-531c-b65e-ed180dad9e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466326} :answer-field/id #uuid "9b3e4b44-d0ed-53af-8a31-aa805a851393" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b175da7-6b72-569e-916d-da964786e33a" :question/math-academy-id "q-335252" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n- **I.** ${F}_{1}(t)={\\int }_{0}^{1}{e}^{-{t}^{2}x}\\,\\text{d}x,\\,t\\in R$\n- **II.** ${F}_{2}(t)={\\int }_{0}^{1}|x-t|\\,\\text{d}x,\\,t\\ge 0$\n- **III.** ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)={e}^{-{t}^{2}x}.\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=-2tx{e}^{-{t}^{2}x},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all real $t.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=|x-t|.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆[0,1],$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ However, the partial derivative\n\n$$\n\\frac{∂{f}_{2}}{∂t}={\\begin{aligned}-1,\\,x>t \\\\ 1,\\,x<t\\end{aligned}\n$$\n\ndoes *not* exist whenever $x=t={t}_{0},$ and is therefore not defined everywhere on $R.$ Thus, differentiating under the integral sign is *not* valid.\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{{x}^{2}+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{2t}{({x}^{2}+{t}^{2})^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t>0.$\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048817 :topic/id #uuid "c277f404-7746-5317-a99f-359354eb8c6a" :topic/math-academy-id 6682 :topic/title "Differentiating Under the Integral Sign"} :activity/title "Differentiating Under the Integral Sign" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494303} :db/id #edb/ref 17592186495226}]} {:db/id #edb/ref 17592186311556 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies" :topic/_knowledge-points [{:db/id #edb/ref 17592186048817 :topic/id #uuid "c277f404-7746-5317-a99f-359354eb8c6a" :topic/math-academy-id 6682 :topic/title "Differentiating Under the Integral Sign"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f193bbe0-8e7c-5b6f-a8dd-105f7c96e087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466327} {:answer/id #uuid "047ad879-475c-51be-8100-93116e6fb609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466328}] :answer-field/correct {:answer/id #uuid "047ad879-475c-51be-8100-93116e6fb609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466328} :answer-field/id #uuid "c351f140-003f-5de1-a059-b4c452861f54" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467007} {:answer-field/choices [{:answer/id #uuid "0ac05226-c0db-52a3-ae14-60638c0dc180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466329} {:answer/id #uuid "6fe0749a-3fbf-53af-8a74-6c63016e53d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466330}] :answer-field/correct {:answer/id #uuid "6fe0749a-3fbf-53af-8a74-6c63016e53d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466330} :answer-field/id #uuid "ec4aa8ac-f5ec-5952-835d-341387814949" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467008} {:answer-field/choices [{:answer/id #uuid "6dde5e19-36cd-5710-ac44-3b7ccc338aa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466331} {:answer/id #uuid "ae4ce050-9839-5301-bc39-df7b6379da2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466332}] :answer-field/correct {:answer/id #uuid "ae4ce050-9839-5301-bc39-df7b6379da2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466332} :answer-field/id #uuid "52c91a3d-646c-5c9e-9c53-efcea5dea94b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467009}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0283e52-8fee-5c3a-a13d-c279ee722034" :question/math-academy-id "q-335253" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n- **I.** ${F}_{1}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{{x}^{2}+{t}^{2}}}\\,\\text{d}x,\\,t>0$\n- **II.** ${F}_{2}(t)={\\int }_{0}^{1}\\operatorname{cos}⁡(xt)\\,\\text{d}x,\\,t\\in R$\n- **III.** ${F}_{3}(t)={\\int }_{0}^{1}\\frac{{x}^{3}}{1+t{x}^{2}}\\,\\text{d}x,\\,t>-1$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{1}{\\sqrt{{x}^{2}+{t}^{2}}}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R$ (since ${x}^{2}+{t}^{2}>0$ on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=-\\frac{t}{({x}^{2}+{t}^{2})^{3/2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all $t>0.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\operatorname{cos}⁡(xt).\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d$ so that $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=-x\\operatorname{sin}⁡(xt)\n$$\n\nwhich exists and is continuous on $R.$ Thus differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all real $t.$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{{x}^{3}}{1+t{x}^{2}}.\n$$\n\nWe fix ${t}_{0}>-1$ and choose $[c,d]⊂(-1,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{{x}^{5}}{(1+t{x}^{2})^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t>-1.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186311557 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies" :topic/_knowledge-points [{:db/id #edb/ref 17592186048817 :topic/id #uuid "c277f404-7746-5317-a99f-359354eb8c6a" :topic/math-academy-id 6682 :topic/title "Differentiating Under the Integral Sign"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "958e50e4-711b-576c-ab91-0087c75945cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466333} {:answer/id #uuid "ce8fed5f-0e8b-5ec1-8918-492f6fc7c6b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466334}] :answer-field/correct {:answer/id #uuid "958e50e4-711b-576c-ab91-0087c75945cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466333} :answer-field/id #uuid "5372760e-066f-55e0-b7b9-2ff11d55e2c0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467010} {:answer-field/choices [{:answer/id #uuid "832c18d4-aaf4-5e10-9aeb-143c9e0d4b0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466335} {:answer/id #uuid "51ef8b21-0c2d-5d7e-bac0-f3e5033cf5eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466336}] :answer-field/correct {:answer/id #uuid "51ef8b21-0c2d-5d7e-bac0-f3e5033cf5eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466336} :answer-field/id #uuid "1aeac474-d1d6-5a95-a8c4-6a2ce80af73e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467011} {:answer-field/choices [{:answer/id #uuid "800c1d5b-5d46-5618-b8ef-1b9451c13e6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466337} {:answer/id #uuid "4250fbe7-e751-5a5c-88fa-cbb83498f5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466338}] :answer-field/correct {:answer/id #uuid "4250fbe7-e751-5a5c-88fa-cbb83498f5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466338} :answer-field/id #uuid "f7db462d-3fc8-5643-b099-4624769f01bf" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "757f1645-7b5c-5866-81f6-7ae1eefa124d" :question/math-academy-id "q-335254" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n- **I.** ${F}_{1}(t)={\\int }_{0}^{1}|x-t|\\,\\text{d}x,\\,t\\in (0,1)$\n- **II.** ${F}_{2}(t)={\\int }_{0}^{1}\\frac{t}{1+{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t\\in R$\n- **III.** ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{(x+t+1)^{3}}\\,\\text{d}x,\\,t\\in (0,1)$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=|x-t|.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R.$ However, the partial derivative\n\n$$\n\\frac{∂{f}_{1}}{∂t}={\\begin{aligned}-1,\\,x>t \\\\ 1,\\,x<t\\end{aligned}\n$$\n\ndoes *not* exist whenever $x=t={t}_{0},$ and is therefore not defined everywhere on $R.$ Thus, differentiating under the integral sign is *not* valid.\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{t}{1+{x}^{2}+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=\\frac{(1+{x}^{2}+{t}^{2})-2{t}^{2}}{(1+{x}^{2}+{t}^{2})^{2}}=\\frac{1+{x}^{2}-{t}^{2}}{(1+{x}^{2}+{t}^{2})^{2}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all real $t.$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{(x+t+1)^{3}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{3}{(x+t+1)^{4}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t\\in (0,1).$\n\nTherefore, the correct answer is \"II and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048817 :topic/id #uuid "c277f404-7746-5317-a99f-359354eb8c6a" :topic/math-academy-id 6682 :topic/title "Differentiating Under the Integral Sign"} :activity/title "Differentiating Under the Integral Sign" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186496653} :db/id #edb/ref 17592186497451}]} {:db/id #edb/ref 17592186311558 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral 