61370}] :answer-field/correct {:answer/id #uuid "574c4e5b-8f7c-50ac-8fc1-44bdde26f20d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461369} :answer-field/id #uuid "f82223f9-3003-55a1-b023-f966e343381c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462438}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4740436b-fb84-571a-aea1-e76558938555" :question/math-academy-id "q-104916" :question/problem "Which of the following sets is a subset of $A={{12},{20,22},{6,9,15}}?$\n- **I.** ${-1,{12}}$\n- **II.** ${{20,22}}$\n- **III.** ${{0},{6,9,15}}$\n\nSelect all that apply." :question/worked-solution "A set is a subset of $A$ if all its elements are elements of $A.$ \n\nWith that in mind, let's inspect each option.\n\n- ${-1,{12}}$ is *not* a subset of $A$ because it contains the element $-1\\notin A.\\,\\times $\n\n- ${{20,22}}$ is a subset of $A.\\,✓$\n\n- ${{0},{6,9,15}}$ is *not* a subset of $A$ because it contains the element ${0}\\notin A.\\,\\times $\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186240965 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45778b4b-32eb-5857-9506-b9aa98925b5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461371} {:answer/id #uuid "c9ae2265-b918-5303-af80-85171c306d46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text