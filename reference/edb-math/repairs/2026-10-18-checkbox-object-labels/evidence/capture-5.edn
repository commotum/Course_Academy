9656-50ca-b527-29ec38bebafe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447801}] :answer-field/correct {:answer/id #uuid "f02b3fc3-9656-50ca-b527-29ec38bebafe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447801} :answer-field/id #uuid "a452f612-5cea-59f2-93e3-d66f0c20ebce" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "253cf041-a7dc-53ad-a439-778e84d95095" :question/math-academy-id "q-106810" :question/problem "Let $J$ be the set of all polynomials with real coefficients and whose degree is at most $2.$  Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\frac{1}{x}\\in J$\n\n- **II.** For any $p(x)\\in J,$ we have $1\\cdot p(x)\\in J$\n\n- **III.** For any $p(x),q(x)\\in J$ and $\\alpha \\in R,$ we have $\\alpha (p(x)-q(x))=\\alpha p(x)-\\alpha q(x)$" :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement I is false. The set $J$ contains only polynomials whose degree is at most $2.$ However, $\\frac{1}{x}$ is *not* a polynomial. So, $\\frac{1}{x}\\notin J.$\n\n- Statement II is true. Indeed, for any $p(x)\\in J$ and for any fixed $x\\in R,$ the result of $p(x)$ is just a real number. Thus,\n\n$$\n1\\cdot p(x)=p(x).\n$$\n\n- Statement III is true. Indeed, for any $p(x),q(x)\\in J,$ and for any fixed $x\\in R,$ the results of $p(x)$ and $q(x)$ are just real numbers. Thus, for any $\\alpha \\in R,$ we obtain that\n\n$$\n\\alpha (p(x)-q(x))=\\alpha p(x)-\\alpha q(x).\n$$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186243957 :knowledge-point/_questions [{:db/id #edb/ref 17592186124589 :knowledge-point/id #uuid "099e7caf-085a-5fd5-ad3d-1ebf189527b7" :knowledge-point/title "Verifying Properties Involving Scalar Multiplication and the Distributive Laws" :topic/_knowledge-points [{:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3497eda5-52bc-523b-945d-d05f19503f52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447802} {:answer/id #uuid "44ac635a-4bd5-5229-88e4-cbb7d8e96d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447803}] :answer-field/correct {:answer/id #uuid "44ac635a-4bd5-5229-88e4-cbb7d8e96d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447803} :answer-field/id #uuid "fdefdd82-0939-5e22-a509-768a1fed2432" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448941} {:answer-field/choices [{:answer/id #uuid "25aca01f-34fb-588b-9dbb-c11c047afdea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447804} {:answer/id #uuid "8d6a09c3-4c87-5a81-b7e3-0d9a6734a797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447805}] :answer-field/correct {:answer/id #uuid "8d6a09c3-4c87-5a81-b7e3-0d9a6734a797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447805} :answer-field/id #uuid "418778fd-c7f4-5d7f-a3d0-fd03d98de531" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448942} {:answer-field/choices [{:answer/id #uuid "ed7df062-5ec2-57b4-8536-99b55fed3f21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447806} {:answer/id #uuid "e0ea89e7-c9f8-55e0-ab34-178df16a57c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447807}] :answer-field/correct {:answer/id #uuid "e0ea89e7-c9f8-55e0-ab34-178df16a57c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447807} :answer-field/id #uuid "68bf64ae-6cb2-5663-8dc1-b3784f64d81e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448943}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43cc36f0-0278-53e6-b346-3f4ef69a0aaa" :question/math-academy-id "q-106812" :question/problem "Let $G$ be the set of functions $f:R\\to R$ such that $f(0)>0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** For any $f(x)\\in G,$ we have $1\\cdot f(x)=f(x).$\n- **II.** For any $f(x)\\in G$ and $\\alpha ,\\beta \\in R$, we have $(\\alpha -\\beta )f(x)=\\alpha f(x)-\\beta f(x).$\n- **III.** The scalar multiplication of functions in $G$ is associative." :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement I is true. Indeed, for any $f(x)\\in G$ and for any fixed $x\\in R,$ the result of $f(x)$ is just a real number. Thus,\n\n$$\n(1\\cdot f)(x)=1\\cdot f(x)=f(x).\n$$\n\n- Statement II is true. Indeed, for any $f(x)\\in G$ and for any fixed $x\\in R,$ the result of $f(x)$ is just a real number. Thus, for any $\\alpha ,\\beta \\in R,$ we obtain that\n\n$$\n(\\alpha -\\beta )f(x)=\\alpha f(x)-\\beta f(x).\n$$\n\n- Statement III is true. Indeed, for any $f(x)\\in G$ and for any fixed $x\\in R,$ the result of $f(x)$ is just a real number. Thus, for any $\\alpha ,\\beta \\in R,$ we obtain that\n\n$$\n\\alpha (\\beta f(x))=(\\alpha \\beta )f(x).\n$$\n\nTherefore, the correct answer is \"I, II, and III.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"} :activity/title "Introduction to Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481574} :db/id #edb/ref 17592186481694}]} {:db/id #edb/ref 17592186243975 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "844c9f0e-446b-5016-9b76-e7e445bdbd08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461467} {:answer/id #uuid "1dc4d0a4-6d49-5f2e-aa11-b4018d2ef796" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461468}] :answer-field/correct {:answer/id #uuid "844c9f0e-446b-5016-9b76-e7e445bdbd08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461467} :answer-field/id #uuid "8891a4fb-5ede-5445-a9fd-00d3e743bb62" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462487} {:answer-field/choices [{:answer/id #uuid "808eb96b-21d3-55b3-9334-bef1392eaad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461469} {:answer/id #uuid "58c883b2-35bd-528c-a6b1-d5516f9bd5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461470}] :answer-field/correct {:answer/id #uuid "808eb96b-21d3-55b3-9334-bef1392eaad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461469} :answer-field/id #uuid "1bbd0ccb-df41-5cb9-b11a-d086bca693ea" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462488} {:answer-field/choices [{:answer/id #uuid "5c96af62-46ae-56c7-88a0-22bb5ebc957b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461471} {:answer/id #uuid "a41e4398-f1c9-51f3-b2d3-cc1222c5d906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461472}] :answer-field/correct {:answer/id #uuid "a41e4398-f1c9-51f3-b2d3-cc1222c5d906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461472} :answer-field/id #uuid "8e4ca1a8-ea04-5785-aaa6-1097c70f54ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c2f74bb-ddf4-5d4c-b244-ad5b6a694598" :question/math-academy-id "q-106897" :question/problem "Which of the following vector spaces has a dimension of $10?$\n- **I.** ${R}_{10}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $10$\n- **II.** ${\\text{M}}_{5}(R)$, the vector space of all $5\\times 5$ matrices over $R$\n- **III.** ${R}^{10}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11\\ne 10.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n}(\\text{R}))={n}^{2}.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{5}(R))={5}^{2}=25\\ne 10.\\,\\times \n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{10})=10.\\,✓\n$$\n\nHence, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/title "Quiz 3" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186544073} :db/id #edb/ref 17592186544941}]} {:db/id #edb/ref 17592186243976 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8961339-1a5c-5154-b431-7f4c1915d7a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461473} {:answer/id #uuid "70ebb621-c996-5bb4-bb6f-d250e25c7d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461474}] :answer-field/correct {:answer/id #uuid "b8961339-1a5c-5154-b431-7f4c1915d7a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461473} :answer-field/id #uuid "d62786ac-59a9-5c3e-85fb-53e10b3893aa" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462490} {:answer-field/choices [{:answer/id #uuid "b262ec27-5eac-58f1-be77-91b34e903a71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461475} {:answer/id #uuid "ac877e51-87f3-537e-a00d-f39a74becde6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461476}] :answer-field/correct {:answer/id #uuid "ac877e51-87f3-537e-a00d-f39a74becde6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461476} :answer-field/id #uuid "abb696bd-503d-5a34-a4cd-484b32d5f6f0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462491} {:answer-field/choices [{:answer/id #uuid "51a9ec73-3d5d-5621-8eb5-866b70303147" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461477} {:answer/id #uuid "fdeb4d4b-156f-55e1-a9a8-7212ac45aeb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461478}] :answer-field/correct {:answer/id #uuid "51a9ec73-3d5d-5621-8eb5-866b70303147" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461477} :answer-field/id #uuid "9590a6b7-5b9b-5524-8e80-e824dafa5c8e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462492}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf92f8df-b777-508f-9358-1b7029534cba" :question/math-academy-id "q-106900" :question/problem "Which of the following vector spaces has a dimension of $3?$\n- **I.** ${R}^{2}$\n- **II.** ${R}_{2}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $2$\n- **III.** ${\\text{M}}_{3}(R),$ the vector space of all $3\\times 3$ matrices over $R$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{2})=2\\ne 3.\\,\\times \n$$\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{2}[t])=2+1=3.\\,✓\n$$\n- Recall that $\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{3}(R))={3}^{2}=9\\ne 3.\\,\\times \n$$\n\nHence, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186243977 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85f50e01-4432-5abc-a190-7e72cdc3873a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461479} {:answer/id #uuid "26b77efa-1ca5-50e3-a239-917ffd78fa11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461480}] :answer-field/correct {:answer/id #uuid "85f50e01-4432-5abc-a190-7e72cdc3873a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461479} :answer-field/id #uuid "d618925b-ccec-5382-aafc-ee623f24eae3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462493} {:answer-field/choices [{:answer/id #uuid "3755b38e-d3c3-5fd6-aa30-ce41d9c8f023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461481} {:answer/id #uuid "0113c910-9d82-5496-a7a5-6245045c74c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461482}] :answer-field/correct {:answer/id #uuid "0113c910-9d82-5496-a7a5-6245045c74c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461482} :answer-field/id #uuid "6af77266-4c24-5185-b7d2-41604c2df381" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462494} {:answer-field/choices [{:answer/id #uuid "e21d3928-a529-5423-a7ee-52349098e089" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461483} {:answer/id #uuid "a21066ee-90f4-5cd6-a2c8-b896111b61f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461484}] :answer-field/correct {:answer/id #uuid "a21066ee-90f4-5cd6-a2c8-b896111b61f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461484} :answer-field/id #uuid "8e400bec-f914-5615-b660-6b8705f12fef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462495}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19d4d0ee-ad5b-53e7-956e-b02eb6cf177b" :question/math-academy-id "q-106901" :question/problem "Which of the following vector spaces has a dimension of $20?$\n- **I.** ${R}_{20}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $20$\n- **II.** ${\\text{M}}_{4\\times 5}(R),$ the vector space of all $4\\times 5$ matrices over $R$\n- **III.** ${R}^{20}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{20}[t])=20+1=21\\ne 20.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{4\\times 5}(R))=4\\cdot 5=20.\\,✓\n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{20})=20.\\,✓\n$$\n\nHence, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186243979 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101d4aef-a0cb-5f59-804c-2d0912201356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461485} {:answer/id #uuid "79a8eb56-c474-574e-bfc9-b522256a029e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461486}] :answer-field/correct {:answer/id #uuid "101d4aef-a0cb-5f59-804c-2d0912201356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461485} :answer-field/id #uuid "ce30771f-f100-546b-a92b-fb508272ed27" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462496} {:answer-field/choices [{:answer/id #uuid "ed8774e9-ebe2-5c6e-85cd-30049680d599" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461487} {:answer/id #uuid "dc8ccde8-41e3-5196-ae3c-09832fdc7f73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461488}] :answer-field/correct {:answer/id #uuid "dc8ccde8-41e3-5196-ae3c-09832fdc7f73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461488} :answer-field/id #uuid "a6f63d3c-95cd-558d-bbab-210730504255" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462497} {:answer-field/choices [{:answer/id #uuid "5c06bef4-3a80-5865-b652-4990c086ea64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461489} {:answer/id #uuid "068ca4a0-476a-53a3-9006-a1ac154420c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461490}] :answer-field/correct {:answer/id #uuid "068ca4a0-476a-53a3-9006-a1ac154420c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461490} :answer-field/id #uuid "8b82d7b2-4328-5c48-a37f-e8fdf88d664e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462498}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28ab3efd-4668-556c-a241-6c3f64cf9ac7" :question/math-academy-id "q-106916" :question/problem "Which of the following vector spaces are finite-dimensional?\n- **I.** ${ℓ}^{1},$ the vector space of infinite real sequences where the sum of the absolute values of the terms are finite\n- **II.** ${R}_{3000}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $3\\,000$\n- **III.** ${\\text{M}}_{50\\times 60}(R),$ the vector space of all $50\\times 60$ matrices over $R$\n\nSelect all that apply." :question/worked-solution "Let's examine our vector spaces.\n\n- ${ℓ}^{1}$ is *not* finite-dimensional. To understand why, we first note that the following subset of ${ℓ}^{1}$ is linearly independent: \n\n$$\n{{e}_{1},\\,{e}_{2},\\,…,{e}_{n}},\\,n\\in N\n$$\n\nwhere, for each $j\\in {1,2,…,n},$\n\n$$\n{e}_{j}=(0,…,0,\\,\\,\\,\\,\\,\\,\\,\\,\\,{1,}_{{↑}_{{j}^{\\text{th}}\\text{ position}}}\\,\\,\\,\\,\\,\\,\\,\\,0,…).\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{e}_{i}=0\n$$\n\nif and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${ℓ}^{1}$ of size $n,$ which imples that  ${ℓ}^{1}$ cannot have finite dimension.\n\n- ${R}_{3000}[t]$ and  ${\\text{M}}_{50\\times 60}(R)$ are finite-dimensional. Indeed,\n\n$$\n\\text{dim}({R}_{3000}[t])=3\\,000+1=3\\,001,\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{50\\times 60}(R))=50\\cdot 60=3\\,000\n$$\n\n \nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186244007 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements" :topic/_knowledge-points [{:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0944cb0d-450f-5b67-bc93-59b28498a18d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447808} {:answer/id #uuid "a85e529f-a8db-5ac6-81a3-1e8d0132b63d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447809}] :answer-field/correct {:answer/id #uuid "a85e529f-a8db-5ac6-81a3-1e8d0132b63d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447809} :answer-field/id #uuid "15427a30-4cc6-5970-9c79-47e051d85769" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448944} {:answer-field/choices [{:answer/id #uuid "df078c5f-70c2-5841-b99b-67590073383e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447810} {:answer/id #uuid "c3db958d-e8fc-5686-af9e-9756b7ea4499" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447811}] :answer-field/correct {:answer/id #uuid "c3db958d-e8fc-5686-af9e-9756b7ea4499" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447811} :answer-field/id #uuid "f8806e66-13da-5591-99c5-a443b1af0cfe" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448945} {:answer-field/choices [{:answer/id #uuid "fdbe147b-5812-50c9-9ca8-b47ac3535278" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447812} {:answer/id #uuid "c70f83db-3806-5abc-98f0-91a2443fb906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447813}] :answer-field/correct {:answer/id #uuid "fdbe147b-5812-50c9-9ca8-b47ac3535278" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447812} :answer-field/id #uuid "008c8f90-e157-56b2-90cc-b8fd20ff040b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448946}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d584308b-6723-5e86-a9ec-6146a097d3d8" :question/math-academy-id "q-107042" :question/problem "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3},{v}_{4}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly dependent and ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly independent, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has a non-zero solution\n- **II.** ${v}_{4}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{3}$\n- **III.** ${v}_{3}$ is a linear combination of ${v}_{1}$ and ${v}_{2}$" :question/worked-solution "Let's examine each of the given options in turn.\n\n- Statement I is true. Since ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly dependent set, we obtain that\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nhas a non-zero solution.\n\n- Statement II is true. Indeed, solving equation ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ for ${v}_{4},$ we obtain\n\n$$\n{v}_{4}=-\\frac{{x}_{1}}{{x}_{4}}{v}_{1}-\\frac{{x}_{2}}{{x}_{4}}{v}_{2}-\\frac{{x}_{3}}{{x}_{4}}{v}_{3}.\n$$\n\nMoreover, ${x}_{4}$ can't be zero because then\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nwill have a non-zero solution, which contradicts the fact that ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly independent.\nHence, ${v}_{4}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{3}.$\n\n- Statement III is false. Since the set ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly independent set, the equation \n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nhas no non-zero solution. Hence, ${v}_{3}$ is not a linear combination of ${v}_{1}$ and ${v}_{2}.$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186244008 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements" :topic/_knowledge-points [{:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "715baca9-d8a1-5a81-a5f7-9987dd0ebe61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447814} {:answer/id #uuid "54ae8f74-a775-5753-af9d-5aa758e47b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447815}] :answer-field/correct {:answer/id #uuid "54ae8f74-a775-5753-af9d-5aa758e47b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447815} :answer-field/id #uuid "46861617-3930-5b40-a317-855ebcd8a0fd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448947} {:answer-field/choices [{:answer/id #uuid "6f4209e6-9877-5337-80c6-621256b8783d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447816} {:answer/id #uuid "e30a7d25-8571-5b68-a654-b26e03cd9e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447817}] :answer-field/correct {:answer/id #uuid "e30a7d25-8571-5b68-a654-b26e03cd9e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447817} :answer-field/id #uuid "bafa262d-3852-5589-8bf2-41b9a0fdf267" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448948} {:answer-field/choices [{:answer/id #uuid "e2710465-fa08-5dce-9ba5-b5da64d4c403" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447818} {:answer/id #uuid "0ff3de92-e2fa-5f0c-b8dc-49743ec38723" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447819}] :answer-field/correct {:answer/id #uuid "e2710465-fa08-5dce-9ba5-b5da64d4c403" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447818} :answer-field/id #uuid "ce7c05ed-038d-5fea-9a49-a7875ca70874" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448949}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4ec52379-6b69-5ec0-af4a-1a5b49cab942" :question/math-academy-id "q-107043" :question/problem "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly independent, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${{v}_{1}+{v}_{3},{v}_{2}+{v}_{3},2{v}_{3}}$ is linearly independent\n- **II.** ${{v}_{2},{v}_{3}}$ is linearly independent\n- **III.** ${{v}_{1},{v}_{2},{v}_{1}+{v}_{2}}$ is linearly independent" :question/worked-solution "Let's examine each of the given options in turn.\n\n- Statement I is true. Suppose that\n\n$$\n\\begin{aligned}{x}_{1}({v}_{1}+{v}_{3})+{x}_{2}({v}_{2}+{v}_{3})+{x}_{3}(2{v}_{3}) & =0,\\end{aligned}\n$$\n\nwhich, in turn, gives\n\n$$\n\\begin{aligned}{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+({x}_{1}+{x}_{2}+2{x}_{3}){v}_{3} & =0.\\end{aligned}\n$$\n\nSince ${{v}_{1},{v}_{2},{v}_{3}}$ is a linearly independent set, the final equation can be true only if\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{1}+{x}_{2}+2{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nThe unique solution of the system is ${x}_{1}={x}_{2}={x}_{3}=0,$ which means that \n\n$$\n{{v}_{1}+{v}_{3},{v}_{2}+{v}_{3},2{v}_{3}}\n$$\n\n is linearly independent.\n\n- Statement II is true. Indeed, ${x}_{1}{v}_{2}+{x}_{2}{v}_{3}=0$ must have only the zero solution ${x}_{2}={x}_{3}=0.$  If this equation has a non-zero solution, $a\\cdot {v}_{2}+b\\cdot {v}_{3}=0,$ then we obtain\n\n$$\n0\\cdot {v}_{1}+a\\cdot {v}_{2}+b\\cdot {v}_{3}=0,\n$$\n\nwhich would mean that ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly dependent.\n\n- Statement III is false. Indeed, notice that\n\n$$\n1\\cdot {v}_{1}+1\\cdot {v}_{2}+(-1)\\cdot ({v}_{1}+{v}_{2})=0.\n$$\n\nAs a result, ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}({v}_{1}+{v}_{2})=0$ has a non-zero solution. This means that ${{v}_{1},{v}_{2},{v}_{1}+{v}_{2}}$ is linearly dependent. In general, any set containing the zero vector is linearly dependent.\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"} :activity/title "Linear Independence in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420706} :db/id #edb/ref 17592186420717}]} {:db/id #edb/ref 17592186244009 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements" :topic/_knowledge-points [{:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "777c64dc-834c-5340-8186-d7fddd2c888a" :answe