nswer.type/text} :answer/value "false" :db/id #edb/ref 17592186437450} :answer-field/id #uuid "87f846d1-462e-5476-ad72-5ffdce32e670" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438754} {:answer-field/choices [{:answer/id #uuid "9db9829d-7585-53f2-9f60-fe945a3c2914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437452} {:answer/id #uuid "cc11d7ed-75ec-5de5-94fc-3d0209cb4b86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437453}] :answer-field/correct {:answer/id #uuid "9db9829d-7585-53f2-9f60-fe945a3c2914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437452} :answer-field/id #uuid "e218f141-6fbf-52b2-a3d6-8f410c56d947" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438755}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2be15a89-9d36-55d5-9fa3-9993a8ff3b6d" :question/math-academy-id "q-105578" :question/problem "![](images/33/33f0353e3856fb2b458d17ed1959918e6a3dd96fd0a966d971575ffc212402f0.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the lengths of the vectors increase as we move horizontally and vertically away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186241106 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132 :topic/title "The Curl of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dec2cc2-3405-52c3-8979-abd8eb2a2b24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437462} {:answer/id #uuid "0794f2ce-66e5-5eee-bc4d-0db5a27294c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437463}] :answer-field/correct {:answer/id #uuid "0794f2ce-66e5-5eee-bc4d-0db5a27294c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437463} :answer-field/id #uuid "7b78da69-9857-55b5-bd09-bf9713a7e40e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438760} {:answer-field/choices [{:answer/id #uuid "66323cd6-6318-59a5-8c75-296ec59e3c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437464} {:answer/id #uuid "421e51c5-959b-56e2-af2c-c59025f76191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437465}] :answer-field/correct {:answer/id #uuid "66323cd6-6318-59a5-8c75-296ec59e3c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437464} :answer-field/id #uuid "1f5add59-bb91-5d45-ba13-41f76566398c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438761} {:answer-field/choices [{:answer/id #uuid "e7c0fd7b-0c6b-5e56-bd17-a792412d0f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437466} {:answer/id #uuid "78ef5d9e-ab86-5f26-8bdf-f69df52aee42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437467}] :answer-field/correct {:answer/id #uuid "78ef5d9e-ab86-5f26-8bdf-f69df52aee42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437467} :answer-field/id #uuid "ff65ca0f-7924-5e1e-b45b-e82396f639fd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438762} {:answer-field/choices [{:answer/id #uuid "9c3454f9-4f94-5d9c-9504-95bd742d6fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437468} {:answer/id #uuid "a286c0c8-6b91-5628-897c-39200ea30c3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437469}] :answer-field/correct {:answer/id #uuid "9c3454f9-4f94-5d9c-9504-95bd742d6fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437468} :answer-field/id #uuid "daa53b8b-f892-5eaf-a4df-840413a09c4a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438763}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d7d9f8f8-5aac-59da-a7d3-267484c84687" :question/math-academy-id "q-105667" :question/problem "![](images/77/773ff9d880deed92f8034d6949cfee85edbcdf735c8e125f1ec5762137fadb9c.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is irrotational\n- **IV.** $\\text{curl}\\,F$ points in the negative $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/4e/4e344a0a1f6b0c535c5ba08ee8c87914cf5e7009600f45732023720048b4c493.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statements III is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statements IV is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186241108 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132 :topic/title "The Curl of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87f8866c-3269-5305-94e0-80d60142b798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437470} {:answer/id #uuid "ceaad2e3-2efd-5e19-bb7f-b57ea3fc6e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437471}] :answer-field/correct {:answer/id #uuid "87f8866c-3269-5305-94e0-80d60142b798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437470} :answer-field/id #uuid "0c08d5d7-5b76-5798-9849-c11e4265495c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438764} {:answer-field/choices [{:answer/id #uuid "af0ccef4-0d9f-5258-a00a-2d3b70919956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437472} {:answer/id #uuid "e6f2d444-ce1a-575d-8dd5-cb8eca23b4aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437473}] :answer-field/correct {:answer/id #uuid "e6f2d444-ce1a-575d-8dd5-cb8eca23b4aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437473} :answer-field/id #uuid "05bb4ba6-a345-5135-97e0-a2bde6d14a93" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438765} {:answer-field/choices [{:answer/id #uuid "1f909166-7a9f-5343-b5ec-b4d1d3560f78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437474} {:answer/id #uuid "7e3f9244-257c-5be9-95ea-d30230d49bf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437475}] :answer-field/correct {:answer/id #uuid "7e3f9244-257c-5be9-95ea-d30230d49bf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437475} :answer-field/id #uuid "690da8d3-c31e-5a96-8f2e-4923d49f0a94" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438766} {:answer-field/choices [{:answer/id #uuid "a1438c53-192f-52c6-a875-55bb696d0ded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437476} {:answer/id #uuid "bb2db5d5-ff4e-5705-a9a3-8abc334919c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437477}] :answer-field/correct {:answer/id #uuid "a1438c53-192f-52c6-a875-55bb696d0ded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437476} :answer-field/id #uuid "91d192c0-fb0c-5d05-a1b4-1e76869a1358" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438767}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c2154fc-c947-5ba9-b169-f98f4fea25a5" :question/math-academy-id "q-105669" :question/problem "![](images/24/2414de6e2129d4fceaae304d16f9be0c91a545e5a8544b2033f353ddb2e581b9.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the positive $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/86/86aee33cdfa96ac0a61468cc9657e791e399f31c024cdbc3a932193dc897d534.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate counterclockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (counterclockwise), our thumb will point away from the screen. Therefore, $\\text{curl}\\,F$ also points away from the screen, in the direction of increasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186241110 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132 :topic/title "The Curl of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf86ba1-b225-5f4e-a85f-182bd2bdbc53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437478} {:answer/id #uuid "c7744411-0aa5-54ef-9c74-d6ca7e53bdb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437479}] :answer-field/correct {:answer/id #uuid "c7744411-0aa5-54ef-9c74-d6ca7e53bdb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437479} :answer-field/id #uuid "af1fc1b7-1f6d-5789-bbaf-748a9803bc96" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438768} {:answer-field/choices [{:answer/id #uuid "9168e608-76cb-5350-991f-3427546bf922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437480} {:answer/id #uuid "6acf104d-e9d0-56e0-a85c-9b1ece39cee2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437481}] :answer-field/correct {:answer/id #uuid "9168e608-76cb-5350-991f-3427546bf922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437480} :answer-field/id #uuid "6aa0313b-ee82-5436-b649-0b4504bba2d2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438769} {:answer-field/choices [{:answer/id #uuid "bf15f6c8-cfc5-5bbe-886a-d7a4c35fe3b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437482} {:answer/id #uuid "5ab85c7d-e507-5369-a231-49fca8b2c436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437483}] :answer-field/correct {:answer/id #uuid "5ab85c7d-e507-5369-a231-49fca8b2c436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437483} :answer-field/id #uuid "c223aec0-697d-56a5-825e-44718ec7f2d3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438770} {:answer-field/choices [{:answer/id #uuid "a4d8d559-74b6-5016-bfae-9833564ce138" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437484} {:answer/id #uuid "ee14db71-cbc6-5c05-87b0-f9afe0453fbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437485}] :answer-field/correct {:answer/id #uuid "a4d8d559-74b6-5016-bfae-9833564ce138" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437484} :answer-field/id #uuid "28f80fe3-8688-556e-8b02-a42b1e403d0f" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438771}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54529993-0bd1-511f-b362-f0eafc672ef8" :question/math-academy-id "q-105671" :question/problem "![](images/4c/4c38294780ac6d5079b759f39a7dbd4944b1c3c21495245dfd314ec180c0434e.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is irrotational\n- **IV.** $\\text{curl}\\,F$ points in the positive $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/97/979b63f21e56924bd7880f9487cf829089e38cf14d287e70196c7a661e41f97f.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statement III is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statement IV is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132 :topic/title "The Curl of a Vector Field"} :activity/title "The Curl of a Vector Field" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409590} :db/id #edb/ref 17592186409612}]} {:db/id #edb/ref 17592186241116 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132 :topic/title "The Curl of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6da5be-dab7-5557-9faa-e9c458176103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437486} {:answer/id #uuid "c92cf9d4-7709-5ceb-b895-b546ae07415c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437487}] :answer-field/correct {:answer/id #uuid "0d6da5be-dab7-5557-9faa-e9c458176103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437486} :answer-field/id #uuid "e7e9da93-54af-5e26-8cfa-2245f93b43c5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438772} {:answer-field/choices [{:answer/id #uuid "5983dd24-2080-5825-8480-5f2274507dcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437488} {:answer/id #uuid "0e102cb8-95ed-551e-b324-574d91856376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437489}] :answer-field/correct {:answer/id #uuid "0e102cb8-95ed-551e-b324-57