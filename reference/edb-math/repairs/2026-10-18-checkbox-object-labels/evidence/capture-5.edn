4db5-ce17-5a9f-8f0c-cf41329af0c2" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438743}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2172851-a396-51c3-bd4e-4e1278b37143" :question/math-academy-id "q-105575" :question/problem "![](images/11/11d38951b884f17616a61403d793322d0e2ea28910e806fe8f018251508352a1.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $∇\\cdot F=0$\n\n- **II.** $∇\\cdot F>0$\n\n- **III.** $∇\\cdot F<0$\n\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131 :topic/title "The Divergence of a Vector Field"} :activity/title "The Divergence of a Vector Field" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436920} :db/id #edb/ref 17592186436936}]} {:db/id #edb/ref 17592186241081 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence" :topic/_knowledge-points [{:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131 :topic/title "The Divergence of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b18a510-e720-57fd-926f-ab9d3c48a75a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437430} {:answer/id #uuid "72d86651-4a74-5ff6-9fd1-824929e1123e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437431}] :answer-field/correct {:answer/id #uuid "72d86651-4a74-5ff6-9fd1-824929e1123e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437431} :answer-field/id #uuid "665fa786-ea66-5817-b113-1425709d275c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438744} {:answer-field/choices [{:answer/id #uuid "571970a0-5082-56bc-8c15-26d049fea5cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437432} {:answer/id #uuid "d8e78f39-2b47-52f9-9502-52e150a46b33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437433}] :answer-field/correct {:answer/id #uuid "571970a0-5082-56bc-8c15-26d049fea5cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437432} :answer-field/id #uuid "3664e7f0-c10a-541a-a220-0f4c16709dde" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438745} {:answer-field/choices [{:answer/id #uuid "bf4e34d1-780b-506e-9e3c-cafa56bb51ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437434} {:answer/id #uuid "d1badd00-e59a-5384-b8e9-55b06e178011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437435}] :answer-field/correct {:answer/id #uuid "bf4e34d1-780b-506e-9e3c-cafa56bb51ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437434} :answer-field/id #uuid "5b68b5d7-cbb4-57e0-97c5-32750d8465c8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438746} {:answer-field/choices [{:answer/id #uuid "55e9fc12-438f-5541-b60c-9f5f8f8d604a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437436} {:answer/id #uuid "b331f531-ebb7-5ebc-9843-2ad0f3951cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437437}] :answer-field/correct {:answer/id #uuid "b331f531-ebb7-5ebc-9843-2ad0f3951cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437437} :answer-field/id #uuid "4361eabc-2c9b-5d9c-b0eb-aca3674799ba" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02256216-cf21-5a66-b1b3-c31d4444cdc1" :question/math-academy-id "q-105576" :question/problem "![](images/cf/cf932f4f02a216d5111da0748cb04f815a7d2e85af5db2f9282f5aefc359b816.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $∇\\cdot F=0$\n- **II.** $∇\\cdot F>0$\n- **III.** $∇\\cdot F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""} {:db/id #edb/ref 17592186241082 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence" :topic/_knowledge-points [{:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131 :topic/title "The Divergence of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4bb96b-8edc-5609-ae5d-59c93968d2c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.