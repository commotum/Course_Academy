166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438689} {:answer-field/choices [{:answer/id #uuid "e2a96a27-f532-56b1-b071-6cec50f8503f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437322} {:answer/id #uuid "d47830c6-0653-572d-a8a7-41bbd043f9fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437323}] :answer-field/correct {:answer/id #uuid "d47830c6-0653-572d-a8a7-41bbd043f9fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437323} :answer-field/id #uuid "98d41179-1f25-5250-b6ec-ea5a42b8c13b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438690}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f5925ee-40c3-50af-9950-ecf1ea188724" :question/math-academy-id "q-103295" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\nSelect all that apply.\n\n- **I.** The vertical asymptotes of the function are $x=2n\\pi $\n- **II.** Its graph passes through the point $(0,0)$\n- **III.** $tan⁡(x-\\frac{\\pi }{6})=tan⁡(x+\\frac{5\\pi }{6})$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/c2/c2d0606829588b01f6cba2fa4785b201c47a6d9ffa325d54e64544c9769d7e4a.png)\n\nLet's examine each statement.\n\n- Statement I is false. The function has an asymptote at $x=\\frac{\\pi }{2}$ and the period is $\\pi .$ Therefore, the asymptotes occur at $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement II is true. Indeed, the graph of the function passes through the point $(0,0).$\n\n- Statement III is true. The function $y=tan⁡x$ has period $\\pi .$ So, $tan⁡(x-\\frac{\\pi }{6})=tan⁡(x-\\frac{\\pi }{6}+\\pi )=tan⁡(x+\\frac{5\\pi }{6}).$\n\nSo, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186238005 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048123 :topic/id #uuid "80ecc4ad-075a-51a6-a1fc-72dc61a2444d" :topic/math-academy-id 313 :topic/title "Global vs. Local Extrema and Critical Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17ca57ad-6a39-5da3-a0a2-57aecb6d47fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461273} {:answer/id #uuid "8774e632-f450-599c-8ad5-4217f5858897" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461274}] :answer-field/correct {:answer/id #uuid "8774e632-f450-599c-8ad5-4217f5858897" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461274} :answer-field/id #uuid "af89ebc7-578c-59cc-8ba0-af951c2a1619" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462390} {:answer-field/choices [{:answer/id #uuid "822e6b63-fdce-5fbe-b767-c309319945b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461275} {:answer/id #uuid "a5f48b58-20d7-5c59-a34c-5a2382d9ccf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461276}] :answer-field/correct {:answer/id #uuid "a5f48b58-20d7-5c59-a34c-5a2382d9ccf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461276} :answer-field/id #uuid "a36aef3b-008a-5af0-a829-ec2cab51c8aa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462391} {:answer-field/choices [{:answer/id #uuid "fa66ed42-00b7-5149-afa9-e61ddf9c0006" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461277} {:answer/id #uuid "549d9b59-93c0-5e2d-aa3a-dc11d548a49b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461278}] :answer-field/correct {:answer/id #uuid "fa66ed42-00b7-5149-afa9-e61ddf9c0006" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461277} :answer-field/id #uuid "dbae254d-0fe9-5642-9e45-73b127b734b5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462392}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f635edc1-2f85-538f-89d8-4edf62a22ccc" :question/math-academy-id "q-103437" :question/problem "![](images/fb/fb61c048eb7eac87f82c53717f8f67251b59610817ddf1f267e80543c0c86959.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\nI. $f(x)$ has a stationary point at $x=-1$\n\nII. $f(x)$ has a critical point at $x=-1$\n\nIII. $f(x)$ has a local maximum at $x=-1$\n\nSelect all that apply." :question/worked-solution "Let's check our statements.\n\n- Statement I is true. Stationary points are points where ${f}^{′}(x)=0.$ In this case, the graph of the function has a horizontal tangent line at $x=-1,$ and therefore, ${f}^{′}(-1)=0.$\n\n- Statement II is true. The function has a critical point at $x=-1$ since each stationary point is a critical point.\n\n- Statement III is false. The function has a local minimum at $x=-1$ since $f(-1)\\le f(x)$ for all $x$ close enough to $x=-1.$\n\nTherefore, statements I and II are true, while statement III is false."} {:db/id #edb/ref 17592186238006 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048123 :topic/id #uuid "80ecc4ad-075a-51a6-a1fc-72dc61a2444d" :topic/math-academy-id 313 :topic/title "Global vs. Local Extrema and Critical Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b293e62f-6f87-5e32-9d47-30001e75a473" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461279} {:answer/id #uuid "d2a8359a-378f-5d30-b9c0-f8c4d4fb9c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461280}] :answer-field/correct {:answer/id #uuid "d2a8359a-378f-5d30-b9c0-f8c4d4fb9c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461280} :answer-field/id #uuid "92f57ac4-00e1-5c7e-9979-b50b20bf610f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462393} {:answer-field/choices [{:answer/id #uuid "f6cc80e1-8c2d-50ca-9f1e-11ffa91bfdf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461281} {:answer/id #uuid "7d3f2ac5-9e21-5c73-81bb-3e709f16ae1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461282}] :answer-field/correct {:answer/id #uuid "7d3f2ac5-9e21-5c73-81bb-3e709f16ae1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461282} :answer-field/id #uuid "71c3c88f-d59c-59fa-bfdc-8de1c22722c3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462394} {:answer-field/choices [{:answer/id #uuid "7a4c59c3-0fa7-57fd-a77c-691d443f258c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461283} {:answer/id #uuid "9d12003a-0d3f-510e-b2aa-cfbebcab6a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461284}] :answer-field/correct {:answer/id #uuid "9d12003a-0d3f-510e-b2aa-cfbebcab6a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461284} :answer-field/id #uuid "37ed8c1c-74af-5b75-8c3b-0d241ae04ccb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2c02942-de68-547a-8bfa-7932a2f390a1" :question/math-academy-id "q-103438" :question/problem "![](images/5b/5bbb0cacbe8dca2facfd49e757ba9b7aa40ee91ae820f001c72d637186d57b79.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\n- $f(x)$ has a critical point at $x=-1$\n- $f(x)$ has a stationary point at $x=0$\n- $f(x)$ has a local minimum at $x=1$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "Let's check our statements.\n\n- Statement I is true. The function has a critical point (a corner) at $x=-1.$ In this case,  ${f}^{′}(-1)$ does not exist.\n\n- Statement II is true. Stationary points are points where ${f}^{′}(x)=0.$ In this case, the graph of the function has a horizontal tangent line at $x=0,$ and therefore, ${f}^{′}(0)=0.$\n\n- Statement III is true. The function has a local minimum at $x=1$ since $f(1)\\le f(x)$ for all $x$ close enough to $x=1.$\n\nTherefore, all three statements are true."} {:db/id #edb/ref 17592186238041 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186050359 :topic/id #uuid "424e5d7e-179f-525e-bdaa-70125807f572" :topic/math-academy-id 3563 :topic/title "Describing Properties of the Secant Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e650522d-7d29-56a7-9d2a-a7366159781f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447666} {:answer/id #uuid "dc16e3da-5bd2-59c3-b215-ad267ab230ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447667}] :answer-field/correct {:answer/id #uuid "e650522d-7d29-56a7-9d2a-a7366159781f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447666} :answer-field/id #uuid "f19fe135-c616-5657-a6a1-2c289676f144" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448873} {:answer-field/choices [{:answer/id #uuid "f2d1b275-589d-55c0-856e-c1cd772557c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447668} {:answer/id #uuid "0c600491-3073-5d6d-af02-741e0459c366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447669}] :answer-field/correct {:answer/id #uuid "f2d1b275-589d-55c0-856e-c1cd772557c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447668} :answer-field/id #uuid "75aee04b-be6f-5c41-b69d-bb24de8e7a75" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448874} {:answer-field/choices [{:answer/id #uuid "1ae0e786-ec20-5fee-affb-d54045e12f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447670} {:answer/id #uuid "4a901910-3a43-5066-90cc-fea69b955c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447671}] :answer-field/correct {:answer/id #uuid "4a901910-3a43-5066-90cc-fea69b955c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447671} :answer-field/id #uuid "aaaac92a-feb5-5a84-8a55-b1c49a2f457a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50bb01da-0246-5da5-b527-fc7a59519d36" :question/math-academy-id "q-103685" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\nSelect all that apply.\n\n- **I.** The range of the function is $y=(-\\infty ,-1]$\n- **II.** $y=-\\frac{1}{2}$ is an output of the function\n- **III.** $x=\\frac{\\pi }{4}$ is not a zero of the function" :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/d0/d0f3e760be991c936baf5e9825cd582f086a73a8330032d24fd35fd5594b4864.png)\n\nLet's go through each statement.\n\n- Statements I and II are false. The range of the function is $y\\in (-\\infty ,-1]\\cup [1,\\infty ).$ Therefore, $y=-\\frac{1}{2}$ is not an output of the function.\n\n- Statement III is true since the function has no zeros."} {:db/id #edb/ref 17592186238055 :knowledge-point/_questions [{:db/id #edb/ref 17592186176053 :knowl