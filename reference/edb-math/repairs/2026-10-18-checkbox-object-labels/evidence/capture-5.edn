answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461363} {:answer/id #uuid "2a853243-a44c-53a4-b53c-bf9f70d94615" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461364}] :answer-field/correct {:answer/id #uuid "f4efe1cf-37a5-5bc3-94b2-592f78caec9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461363} :answer-field/id #uuid "4d89d57f-dc55-5e11-9fca-510bf7b86592" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462435}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3958191-a06f-54c9-9b69-6e7038fa786f" :question/math-academy-id "q-104781" :question/problem "Which of the following functions has the domain $[-2,2]?$\n- **I.** $p:[-2,2]\\to (-2,2)$\n- **II.** $r:[-2,2]\\to {-2,2}$\n- **III.** $q:Z\\to [-2,2]$\n\nSelect all that apply." :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $[-2,2],$ the interval from $-2$ to $2$ (including $-2$ and $2$).\n\n- The domain of $q$ is $[-2,2],$ the interval from $-2$ to $2$ (including $-2$ and $2$).\n\n- The domain of $r$ is $Z,$ the set of integers.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186240957 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [