592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462441}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "caad9560-3559-5568-b085-de268d2408da" :question/math-academy-id "q-104945" :question/problem "Which of the following is the correct interpretation of $g:{0,1}\\to Z?$\n- **I.** The domain of $g$ is ${0,1}$\n- **II.** The codomain of $g$ is $Z$\n- **III.** The range of $g$ is ${0,1}$\n\nSelect all that apply." :question/worked-solution "The notation \n\n$$\ng:{0,1}\\to Z\n$$\n\nmeans that the function $g$ maps the set ${0,1}$ to the set $Z.$ In this case,\n\n- the domain of $g$ is ${0,1},$ and\n\n- the codomain of $g$ is $Z.$ Note that ${0,1}⊆Z$ is *not* necessarily the range.\n\nAs a result, statements I and II are true, while statement III is false.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186240966 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6858c349-e6bf-5e38-a585-15570d08376f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461377} {:answer/id #uuid "b7ed67d9-c399-5b60-8a5b-b97ed7ff9399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461378}] :answer-field/correct {:answer/id #uuid "6858c349-e6bf-5e38-a585-15570d08376f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461377} :answer-field/id #uuid "b55dd236-1315-5f0c-a08b-715c05b2bb35" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462442} {:answer-field/choices [{:answer/id #uuid "71b439da-0fe4-5815-b359-792909931b63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461379} {:answer/id #uuid "2d1a5447-5793-5cd5-840d-50b22c61bc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461380}] :answer-field/correct {:answer/id #uuid "2d1a5447-5793-5cd5-840d-50b22c61bc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461380} :answer-field/id #uuid "7fa6cf5b-6383-5006-ad7b-4465277c422a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462443} {:answer-field/choices [{:answer/id #uuid "f7709721-24eb-5f08-81a5-384dc9ee7c60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461381} {:answer/id #uuid "45b2be3d-93a1-55b7-8fa4-f0eeed9d2b31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461382}] :answer-field/correct {:answer/id #uuid "f7709721-24eb-5f08-81a5-384dc9ee7c60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461381} :answer-field/id #uuid "91e72ba0-42e0-5b90-aa54-1925c2cb5b15" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ece458da-55a3-56bf-9d0d-49bed0ba9d3c" :question/math-academy-id "q-104946" :question/problem "Which of the following is the correct interpretation of $g:Q\\to R?$\n- **I.** The domain of $g$ is $R$\n- **II.** The codomain of $g$ is $R$\n- **III.** The range of $g$ is $Q$\n\nSelect all that apply." :question/worked-solution "The notation \n\n$$\ng:Q\\to R\n$$\n\nmeans that the function $g$ maps the set $Q$ to the set $R.$ In this case,\n\n- the domain of $g$ is $Q,$ and\n\n- the codomain of $g$ is $R.$ Note that $Q⊂R$ is *not* necessarily the range.\n\nAs a result, statements I and III are false, while statement II is true.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186240968 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cd5dc92-6122-5f66-902b-cf7afd5b3037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461383} {:answer/id #uuid "a4df0471-5db6-5210-9df4-d5ba3514d0e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461384}] :answer-field/correct {:answer/id #uuid "6cd5dc92-6122-5f66-902b-cf7afd5b3037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461383} :answer-field/id #uuid "9cecc8bb-b961-5c98-b4f7-f3d1f9014f0a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462445} {:answer-field/choices [{:answer/id #uuid "c2e1150f-e231-56c5-81bd-1920108321f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461385} {:answer/id #uuid "bb539ff7-3b84-5509-b986-80d61829af75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461386}] :answer-field/correct {:answer/id #uuid "c2e1150f-e231-56c5-81bd-1920108321f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461385} :answer-field/id #uuid "1efba3bd-1474-5f45-af9e-911cbd26dcba" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462446} {:answer-field/choices [{:answer/id #uuid "33626836-ef45-5786-b4be-68420909d8c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461387} {:answer/id #uuid "63330572-fab1-5f0e-845e-35f32466a424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461388}] :answer-field/correct {:answer/id #uuid "63330572-fab1-5f0e-845e-35f32466a424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461388} :answer-field/id #uuid "65b7f335-a482-5fb5-99dc-778484b80d04" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462447}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86293bdd-1445-5c75-b0fe-3a52f74f9647" :question/math-academy-id "q-104954" :question/problem "![](images/8f/8ff01afa1993f8e301edb69e3e7a13ee71ab01b1a3da416aa53ee94d021184e1.png)\n\nConsider the function $g:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\n- The domain of $g$ is ${0,1,2}$\n- The codomain of $g$ is ${-1,0,1,2}$\n- The range of $g$ is ${0,1,2}$\n\nSelect all that apply." :question/worked-solution "The notation $g:X\\to Y$ means that the function $g$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $g$ is $X,$\n\n- the codomain of $g$ is $Y.$\n\nThe range of $g$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $g$ is $X={-1,0,1,2},$\n\n- the codomain of $g$ is $Y={0,1,2},$\n\n- the range of $g$ is ${0,1,2},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements I and II are false, while statement III is true.\n\nTherefore, the correct answer \"III only.\""} {:db/id #edb/ref 17592186240969 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test" :topic/_knowledge-points [{:db/id #edb/ref 17592186051048 :topic/id #uuid "7d157e41-c50b-570b-8b5b-b8a5a0d03163" :topic/math-academy-id 1944 :topic/title "The Second Partial Derivatives Test"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61346844-f5db-5d81-988d-5f22f99364e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447690} {:answer/id #uuid "e325de96-c1e7-580b-b09d-da93b3fe3b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447691}] :answer-field/correct {:answer/id #uuid "e325de96-c1e7-580b-b09d-da93b3fe3b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447691} :answer-field/id #uuid "59cd2a41-7643-579c-a7be-c9328567102c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448885} {:answer-field/choices [{:answer/id #uuid "65db9d78-e369-5af7-bf80-9aaea2cb0ae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447692} {:answer/id #uuid "6608fb9a-406b-57eb-94b3-59aa661b60b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447693}] :answer-field/correct {:answer/id #uuid "65db9d78-e369-5af7-bf80-9aaea2cb0ae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447692} :answer-field/id #uuid "b0e6461c-403e-5a30-8b5c-3a1d65889782" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448886} {:answer-field/choices [{:answer/id #uuid "b9a29471-bdb1-5c51-8ffd-2502d26abe0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447694} {:answer/id #uuid "5344e453-2eb8-5606-91f5-05f0b3a8e966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447695}] :answer-field/correct {:answer/id #uuid "5344e453-2eb8-5606-91f5-05f0b3a8e966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447695} :answer-field/id #uuid "d18799fe-c555-58ca-86dc-b96e74bdbd5a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448887}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcc06ba1-1065-5981-a107-14dc46cea80e" :question/math-academy-id "q-104984" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}{e}^{-({x}^{2}+{y}^{2})}(2{x}^{2}-1) & 2xy{e}^{-({x}^{2}+{y}^{2})} \\\\ 2xy{e}^{-({x}^{2}+{y}^{2})} & {e}^{-({x}^{2}+{y}^{2})}(2{y}^{2}-1)\\end{bmatrix}\n$$\n\nand has a stationary point at $(0,0).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(0,0)>0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)>0$\n- **III.** The point $(0,0)$ is a local maximum of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))=(-1)^{2}-{0}^{2}=1>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,0))_{11}=-1<0.$\n\n- Statement III is true. Indeed, since $H(0,0)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)<0,$ the point $(0,0)$ is a local maximum by the second partial derivative test.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186240970 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test" :topic/_knowledge-points [{:db/id #edb/ref 17592186051048 :topic/id #uuid "7d157e41-c50b-570b-8b5b-b8a5a0d03163" :topic/math-academy-id 1944 :topic/title "The Second Partial Derivatives Test"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9cc0718-c1bb-56fe-874b-3d2ed5f2544b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447696} {:answer/id #uuid "b8a64893-6a9e-56d1-b0d5-82ee55f35b0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447697}] :answer-field/correct {:answer/id #uuid "b8a64893-6a9e-56d1-b0d5-82ee55f35b0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447697} :answer-field/id #uuid "79f7f53c-0965-5c42-ac79-38c8c8f55dfc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448888} {:answer-field/choices [{:answer/id #uuid "9811b78d-bf42-5074-a5f1-5e3202d9d52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447698} {:answer/id #uuid "628b95af-f66d-55ad-8d57-7ecc283f7128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447699}] :answer-field/correct {:answer/id #uuid "9811b78d-bf42-5074-a5f1-5e3202d9d52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447698} :answer-field/id #uuid "2d4f29fa-7863-537a-b965-983d1cdcaf33" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448889} {:answer-field/choices [{:answer/id #uuid "2f185b9e-94d3-5cc1-88c1-f600cdb21736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447700} {:answer/id #uuid "54aa6c5e-2f33-5d68-8e97-c072039a6157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447701}] :answer-field/correct {:answer/id #uuid "2f185b9e-94d3-5cc1-88c1-f600cdb21736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447700} :answer-field/id #uuid "3602e327-d83c-5c85-bf65-690df58a1047" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448890}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e273e9fd-fb16-5b0e-b15b-fcbb70918d78" :question/math-academy-id "q-104995" :question/problem "The function \n$f(x,y)$\nhas the first derivative\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}3{x}^{2}-3y & 3{y}^{2}-3x\\end{bmatrix},\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(1,1)>0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)<0$\n- **III.** The point $(1,1)$ is a local maximum of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we notice that since ${f}^{′}(x,y)=\\begin{bmatrix}3{x}^{2}-3y & 3{y}^{2}-3x\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=3{x}^{2}-3y,\\,\\frac{∂f}{∂y}=3{y}^{2}-3x.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(3{x}^{2}-3y)=6x \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(3{y}^{2}-3x)=6y \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(3{y}^{2}-3x)=-3\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}6x & -3 \\\\ -3 & 6y\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=\\begin{bmatrix}6 & -3 \\\\ -3 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))={6}^{2}-(-3)^{2}=27>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=6>0.$\n\n- Statement III is false. Since $H(1,1)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0,$ the point $(1,1)$ is a local minimum by the second partial derivative test.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186240972 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4e84a9-12cc-507d-82ec-e96b850a63c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461389} {:answer/id #uuid "03b2523b-6d7f-5343-be22-5d73eb55caa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461390}] :answer-field/correct {:answer/id #uuid "0e4e84a9-12cc-507d-82ec-e96b850a63c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461389} :answer-field/id #uuid "21f585b3-4b7e-5b0c-950d-f170a9684585" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462448} {:answer-field/choices [{:answer/id #uuid "e048d875-c5f8-5b05-91e6-d6e57d979a7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461391} {:answer/id #uuid "e7952205-57c2-5868-83de-4486f3e4ba9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461392}] :answer-field/correct {:answer/id #uuid "e7952205-57c2-5868-83de-4486f3e4ba9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461392} :answer-field/id #uuid "d5aee732-4e04-5c86-8c88-17358cec8f30" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462449} {:answer-field/choices [{:answer/id #uuid "af0128c2-64d9-5023-a136-740b0739ee93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461393} {:answer/id #uuid "429ab79c-33d5-501e-9804-0a53e669ec6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461394}] :answer-field/correct {:answer/id #uuid "af0128c2-64d9-5023-a136-740b0739ee93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461393} :answer-field/id #uuid "c6abdd44-ff6b-5977-869d-6f5e6c1b1f43" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462450}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63db395b-88f4-58c0-8886-5830de0a85c3" :question/math-academy-id "q-105033" :question/problem "Which of the following are subsets of ${Q}_{0}^{-}$ (the set of non-positive rational numbers)?\n\nI. $Z$\n\nII. ${Z}^{-}$ (the set of negative integers)\n\nIII. $N$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $Z$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in Z$ but $1\\notin {Q}_{0}^{-}.$\n\n- ${Z}^{-}$ is  a subset of ${Q}_{0}^{-}.$ Every negative integer is a non-positive rational number.\n\n- $N$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in N$ but $1\\notin {Q}_{0}^{-}.$\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186240973 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c158a0f0-c079-589b-b013-4a9f9b82fb3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461395} {:answer/id #uuid "8744280e-f02c-5bc6-9d15-48facb9c919f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461396}] :answer-field/correct {:answer/id #uuid "8744280e-f02c-5bc6-9d15-48facb9c919f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461396} :answer-field/id #uuid "2566b0e9-5b7a-5e81-802e-237820ae4fe6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462451} {:answer-field/choices [{:answer/id #uuid "2c6a5137-3745-5393-b21d-8c28530d2fca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461397} {:answer/id #uuid "65f9100a-2754-5f17-bf7a-2c57cf6cb46d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461398}] :answer-field/correct {:answer/id #uuid "65f9100a-2754-5f17-bf7a-2c57cf6cb46d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461398} :answer-field/id #uuid "31f0cff4-3a12-571f-9bd3-e8a1753421a6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462452} {:answer-field/choices [{:answer/id #uuid "fc9c1a65-9169-513c-86d2-a12c5bee7636" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461399} {:answer/id #uuid "f8e6960b-0a97-5423-acd7-79f6befe4c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461400}] :answer-field/correct {:answer/id #uuid "f8e6960b-0a97-5423-acd7-79f6befe4c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461400} :answer-field/id #uuid "0cc0e7a3-af1f-59d7-a52a-6b8ecb9ea699" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb139d93-059f-53af-a8f9-6a747e8ff56b" :question/math-academy-id "q-105034" :question/problem "Which of the following are subsets of $R?$\n- **I.** ${Q}^{-}$ (the set of negative rationals)\n- **II.** ${Z}^{+}$ (the set of positive integers)\n- **III.** $N$\n\nSelect all that apply." :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Q}^{-}$ is  a subset of $R.$ Every negative rational number is a real number.\n\n- ${Z}^{+}$ is a subset of $R.$ Every positive integer number is a real number.\n\n- $N$ a subset of $R.$ Every natural number is a real number.\n\nTherefore, the correct answer is \"I, II and III\"."} {:db/id #edb/ref 17592186240974 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence" :topic/_knowledge-points [{:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131 :topic/title "The Divergence of a Vector Field"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb2fea76-d8f1-5666-a542-917bd5baee71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437390} {:answer/id #uuid "152c789f-5317-52e2-9188-28255c154716" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437391}] :answer-field/correct {:answer/id #uuid "152c789f-5317-52e2-9188-28255c154716" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437391} :answer-field/id #uuid "3ac27b51-3d78-5bc3-a8f8-810b27ff1b38" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438724} {:answer-field/choices [{:answer/id #uuid "a3a9ffcb-44f2-5949-95fa-814bfb8cc5a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437392} {:answer/id #uuid "2efd0294-1666-5152-a16a-9dd09a7d9ddf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437393}] :answer-field/correct {:answer/id #uuid "a3a9ffcb-44f2-5949-95fa-814bfb8cc5a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437392} :answer-field/id #uuid "1c9e6c62-67a6-523e-b1cd-fd7207ec866b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438725} {:answer-field/choices [{:answer/id #uuid "8adb53a3-b021-5071-855f-0576c8b568b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437394} {:answer/id #uuid "7405feb1-7683-5595-b311-1a84859ab6ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437395}] :answer-field/correct {:answer/id #uuid "8adb53a3-b021-5071-855f-0576c8b568b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437394} :answer-field/id #uuid "925b2332-69df-5291-870e-c0a3f090f25c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438726} {:answer-field/choices [{:answer/id #uuid "e7bfa530-747d-5ad6-84ad-036bd0059f0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437396} {:answer/id #uuid "77ab6b50-7aec-5c00-9718-d684cc7f9f64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437397}] :answer-field/correct {:answer/id #uuid "77ab6b50-7aec-5c00-9718-d684cc7f9f64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437397} :answer-field/id #uuid "3f99b753-4981-57eb-8141-5cc7a73668b9" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b5e7ba9-0b08-5996-9edf-60b5549da2af" :question/math-academy-id "q-105046" :question/problem "![](images/0b/0bc0e75bb577ca37b89568e14a4e0d03da7ce4f4853c4e8c57d9b2df79897b13.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $∇\\cdot F=0$\n- **II.** $∇\\cdot F>0$\n- **III.** $∇\\cdot F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""} {:db/id #edb/ref 17592186240975 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4f34ee0-a5c7-5f64-aceb-3307e7592e85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447702} {:answer/id #uuid "39b103a6-b530-5854-bb89-e4751a4468e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447703}] :answer-field/correct {:answer/id #uuid "39b103a6-b530-5854-bb89-e4751a4468e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447703} :answer-field/id #uuid "cf86cec0-1c67-5e78-96b8-dc785f2845d4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448891} {:answer-field/choices [{:answer/id #uuid "9dd453cd-757f-5c9e-a7e0-274893ce973b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447704} {:answer/id #uuid "7803140a-9aa5-5616-b6fe-64aa8707902c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447705}] :answer-field/correct {:answer/id #uuid "9dd453cd-757f-5c9e-a7e0-274893ce973b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447704} :answer-field/id #uuid "4368cbc2-18ce-58df-ae82-45f138887e71" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448892} {:answer-field/choices [{:answer/id #uuid "ee37f047-7c27-5db1-b4a6-2875a1ff4ddc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447706} {:answer/id #uuid "d57fb6f9-aced-5830-ba9b-1bb5c87c20e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447707}] :answer-field/correct {:answer/id #uuid "d57fb6f9-aced-5830-ba9b-1bb5c87c20e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447707} :answer-field/id #uuid "8cdd9aa5-238f-5317-af05-4ee917743461" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448893} {:answer-field/choices [{:answer/id #uuid "9eeb741d-9909-5faf-8472-3941e32281c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447708} {:answer/id #uuid "9d557843-29f8-51ef-a283-42c0f4cdcbd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447709}] :answer-field/correct {:answer/id #uuid "9d557843-29f8-51ef-a283-42c0f4cdcbd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447709} :answer-field/id #uuid "814496e7-2a04-5797-8385-612ec1e1b068" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448894}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0ffa6ad-f9fd-59d8-a6a4-bd61246d63d4" :question/math-academy-id "q-105064" :question/problem "Which of the following statements are true for the sets $A={n\\in N∣n-2\\ge 4}$ and $B={n\\in Z∣n+2\\ge 5}?$\n\nSelect all that apply.\n\n- **I.** $A⊆B$\n- **II.** $B⊆A$\n- **III.** $∅⊆A$\n- **IV.** $B⊇A$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $n-2\\ge 4,$ that is to say, $n\\ge 6.$ So, we have\n\n$$\nA={6,7,8,9,10,11,…}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $n+2\\ge 5,$ That is to say, $n\\ge 3.$ So, we have\n\n$$\nB={3,4,5,6,7,8,…}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is true. Every element in the set $A$ is an element of the set $B.$\n\n- $B⊆A$ is false. For example, $3\\in B$ but $3\\notin A.$\n\n- $∅⊆A$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊇A$ is equivalent to $A⊆B,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only.\""} {:db/id #edb/ref 17592186240976 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c74944be-025b-55b5-bfdf-b35915666c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447710} {:answer/id #uuid "6b42b333-f857-51a3-a78c-01ef4d7afbb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447711}] :answer-field/correct {:answer/id #uuid "c74944be-025b-55b5-bfdf-b35915666c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447710} :answer-field/id #uuid "6bb3db8e-5247-5645-8fe7-fd50818c5a6f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448895} {:answer-field/choices [{:answer/id #uuid "4ba78fd2-41fd-5367-a04f-7c8a900eb1b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447712} {:answer/id #uuid "c10f0ba6-ef05-59c6-8093-70835884084d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447713}] :answer-field/correct {:answer/id #uuid "c10f0ba6-ef05-59c6-8093-70835884084d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447713} :answer-field/id #uuid "547747f5-2310-55c7-99ab-9bce769db3ab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448896} {:answer-field/choices [{:answer/id #uuid "793936d0-e789-5733-bd41-76e45125b280" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447714} {:answer/id #uuid "f263fa6b-8c61-59cf-b695-15e05d2898b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447715}] :answer-field/correct {:answer/id #uuid "793936d0-e789-5733-bd41-76e45125b280" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447714} :answer-field/id #uuid "82288245-f3ce-57b7-ab3b-ec514a2c857a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448897} {:answer-field/choices [{:answer/id #uuid "4c689cef-4c49-5013-9e08-e58a8d7aaad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447716} {:answer/id #uuid "816c5ee7-4d5b-5236-81fe-30ce025781e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447717}] :answer-field/correct {:answer/id #uuid "816c5ee7-4d5b-5236-81fe-30ce025781e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447717} :answer-field/id #uuid "960d1072-f930-5b70-aab9-98dfd7782eea" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6954872-228a-577f-9a57-37ed3b0eaeb9" :question/math-academy-id "q-105065" :question/problem "Which of the following statements are true for the sets $A={x\\in Z∣x\\le 5}$ and $B={x\\in Z∣-7\\le x<3}?$\n\nSelect all that apply.\n\n- **I.** $A⊆B$\n- **II.** $B⊆A$\n- **III.** $B⊈A$\n- **IV.** $A⊇B$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the integer numbers that satisfy the inequality $x\\le 5.$ So, we have\n\n$$\nA={…,-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $-7\\le x<3.$ So, we have\n\n$$\nB={-7,-6,-5,-4,-3,-2,-1,0,1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false.  For example, $5\\in A$ but $5\\notin B.$\n\n- $B⊆A$ is true, while $B⊈A$ is false. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II and IV only\"."} {:db/id #edb/ref 17592186241002 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90fd88a2-226a-5ff1-a0a8-df1068304114" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461401} {:answer/id #uuid "0fdbfac7-dcdc-5954-99e7-5bcb06fbfbb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461402}] :answer-field/correct {:answer/id #uuid "0fdbfac7-dcdc-5954-99e7-5bcb06fbfbb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461402} :answer-field/id #uuid "b8cddacc-3b19-5547-81a5-439069dd081f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462454} {:answer-field/choices [{:answer/id #uuid "173f1338-acfe-54fc-b974-a48d7b09e0c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461403} {:answer/id #uuid "8bd9d2b5-043e-5936-ab7c-0d5c001ff82e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461404}] :answer-field/correct {:answer/id #uuid "173f1338-acfe-54fc-b974-a48d7b09e0c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461403} :answer-field/id #uuid "17aabf5c-4ef2-5cc0-b531-4d27f7c8830c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462455} {:answer-field/choices [{:answer/id #uuid "dfe9612a-a9cf-51fb-bb71-2072e7a3766d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461405} {:answer/id #uuid "3e4fbdb2-6ec0-5182-ace8-386026118c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461406}] :answer-field/correct {:answer/id #uuid "dfe9612a-a9cf-51fb-bb71-2072e7a3766d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461405} :answer-field/id #uuid "06611796-8633-5a59-adc0-f70353fdd9df" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462456}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b64d31c-86a0-5b85-a7b4-c7e3f17987a9" :question/math-academy-id "q-105185" :question/problem "Which of the following sets are closed?\n\nI. $[4,8]\\cup [10,12]$\n\nII. $[0,5)$\n\nIII. $[1,3)\\cup (3,7]$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[4,8]\\cup [10,12]$ is closed. It consists of two parts, where the boundary points are $4,8,10,$ and $12.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $[0,5)$ has a boundary point $5$, which does not lie in the set.\n\n- $[1,3)\\cup (3,7]$ has a boundary point $3$, which does not lie in the set.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186241009 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ad4656f-44cf-5820-bbb4-4c7080ecfd91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461407} {:answer/id #uuid "8291bfb7-e553-5cc5-921a-0318d746ac71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461408}] :answer-field/correct {:answer/id #uuid "8291bfb7-e553-5cc5-921a-0318d746ac71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461408} :answer-field/id #uuid "36d255a3-c911-5e54-ace9-938311041b08" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462457} {:answer-field/choices [{:answer/id #uuid "a6f030b6-2173-5ddb-9dce-1e3f1c24d4e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461409} {:answer/id #uuid "8cd96ff2-24b9-5142-9bb1-d5c053f82f9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461410}] :answer-field/correct {:answer/id #uuid "8cd96ff2-24b9-5142-9bb1-d5c053f82f9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461410} :answer-field/id #uuid "e8e2b46a-fe70-5863-8ff5-d490bdab9929" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462458} {:answer-field/choices [{:answer/id #uuid "0b749e21-c8b8-5be6-9cea-8a368496ad79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461411} {:answer/id #uuid "5733ec84-fea9-51fa-a220-df419390ad63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461412}] :answer-field/correct {:answer/id #uuid "0b749e21-c8b8-5be6-9cea-8a368496ad79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461411} :answer-field/id #uuid "105c32c4-df9a-5113-b2f3-701392d57670" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "381adff8-b5e3-59f1-b958-b7182ed98215" :question/math-academy-id "q-105201" :question/problem "Which of the following sets are open?\n- **I.** $(2,5)$\n- **II.** $(-3,0)\\cup (2,7)$\n- **III.** $(-2,2)\\cup (4,10]$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(2,5)$ and $(-3,0)\\cup (2,7)$ are open because:\n\n- The boundary points of the set $(2,5)$ are $2$, and $5.$ None of them lie in the set.\n\n- The boundary points of the set  $(-3,0)\\cup (2,7)$ are $-3$, $0$, $2$, and $7.$ None of them lie in the set.\n\nThe other set is not open because $(-2,2)\\cup (4,10]$ has four boundary points $-2$, $2$, $4$, and $10$, and the point $10$ lies in the set.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186241031 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction" :topic/_knowledge-points [{:db/id #edb/ref 17592186050426 :topic/id #uuid "47f4b767-dd8b-5a07-a614-8ff85185d0eb" :topic/math-academy-id 1861 :topic/title "Linear Dependence and Independence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87ecc4be-4578-57d6-a249-a80e721e206a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447718} {:answer/id #uuid "ef287bfc-2ff4-5b14-b2d5-1bc2198e03c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447719}] :answer-field/correct {:answer/id #uuid "87ecc4be-4578-57d6-a249-a80e721e206a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447718} :answer-field/id #uuid "128bee5d-a4a7-57a1-ae6a-7583c0f715e8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448899} {:answer-field/choices [{:answer/id #uuid "dbe9b5d3-6adb-5955-bcd2-adef03763ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447720} {:answer/id #uuid "41f14142-f395-5b2d-97b2-a7334b9547d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447721}] :answer-field/correct {:answer/id #uuid "41f14142-f395-5b2d-97b2-a7334b9547d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447721} :answer-field/id #uuid "e2ed73d9-5758-5bb8-b978-25fc615c46b3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448900} {:answer-field/choices [{:answer/id #uuid "530e368b-e235-51ad-89b6-cae0058759c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447722} {:answer/id #uuid "a1b0c5a9-4103-56d9-a943-e66ba874a356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447723}] :answer-field/correct {:answer/id #uuid "530e368b-e235-51ad-89b6-cae0058759c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447722} :answer-field/id #uuid "114dd27c-9db0-5c20-a81a-10eeefb53fbc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448901}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c05cb83d-c779-50b1-a772-7d4551eea239" :question/math-academy-id "q-105308" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}3 \\\\ 10 \\\\ -12\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}4 \\\\ 8 \\\\ -16\\end{bmatrix}.\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$\n\n- **II.** The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\n- **III.** The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2}+4{x}_{3} &=0 \\\\ 3{x}_{1}+10{x}_{2}+8{x}_{3} &=0 \\\\ -4{x}_{1}-12{x}_{2}-16{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 3 & 4 & 0 \\\\ 3 & 10 & 8 & 0 \\\\ -4 & -12 & -16 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 4 & 0 \\\\ 0 & 1 & -4 & 0 \\\\ -4 & -12 & -16 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 4 & 0 \\\\ 0 & 1 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements I and III are false, while statement II is true."} {:db/id #edb/ref 17592186241033 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction" :topic/_knowledge-points [{:db/id #edb/ref 17592186050426 :topic/id #uuid "47f4b767-dd8b-5a07-a614-8ff85185d0eb" :topic/math-academy-id 1861 :topic/title "Linear Dependence and Independence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b0bd8cc-6ac8-5e72-b06f-73c1654ffe1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461413} {:answer/id #uuid "e80cc002-b38f-5d3e-892e-0841eebc40e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461414}] :answer-field/correct {:answer/id #uuid "e80cc002-b38f-5d3e-892e-0841eebc40e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461414} :answer-field/id #uuid "e3f887e6-6723-5611-bf95-bd986f87144d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462460} {:answer-field/choices [{:answer/id #uuid "a81cd52a-c09b-55c3-9802-d94055e5c375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461415} {:answer/id #uuid "4189cfd7-3469-5cbf-a825-c816cd091f10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461416}] :answer-field/correct {:answer/id #uuid "4189cfd7-3469-5cbf-a825-c816cd091f10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461416} :answer-field/id #uuid "aa918275-0dac-5d62-b393-8f3adb29993b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462461} {:answer-field/choices [{:answer/id #uuid "a390f34d-043c-53c1-9c41-c6abbd279b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461417} {:answer/id #uuid "34513fe0-1281-5699-84c3-b63f5d892959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461418}] :answer-field/correct {:answer/id #uuid "a390f34d-043c-53c1-9c41-c6abbd279b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461417} :answer-field/id #uuid "4f68b655-e005-5eb7-8191-01334bd4f1ec" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af32236d-520e-5b71-b7ec-9663a181498c" :question/math-academy-id "q-105310" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 4 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}7 \\\\ 15 \\\\ -7\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-1 \\\\ -4 \\\\ 1\\end{bmatrix}.\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions.\n\nII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nIII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+7{x}_{2}-{x}_{3} &=0 \\\\ 4{x}_{1}+15{x}_{2}-4{x}_{3} &=0 \\\\ -2{x}_{1}-7{x}_{2}+{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 7 & -1 & 0 \\\\ 4 & 15 & -4 & 0 \\\\ -2 & -7 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 7 & -1 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ -2 & -7 & 1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 7 & -1 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement III is false, while statements I and II are true."} {:db/id #edb/ref 17592186241034 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e569ef55-4f86-5f0f-8e5f-366fbbaf65a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461419} {:answer/id #uuid "9574991b-c705-5663-ad05-8a5ee1ebb134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461420}] :answer-field/correct {:answer/id #uuid "9574991b-c705-5663-ad05-8a5ee1ebb134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461420} :answer-field/id #uuid "f3a9bc66-c7a0-5014-ab05-2056ccacd05b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462463} {:answer-field/choices [{:answer/id #uuid "0905ad9b-9d9b-548c-9b9e-2c65efe682ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461421} {:answer/id #uuid "a348288d-0f17-555e-a70f-b82546994dcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461422}] :answer-field/correct {:answer/id #uuid "0905ad9b-9d9b-548c-9b9e-2c65efe682ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461421} :answer-field/id #uuid "470c3f79-891b-55ed-a428-dd2d5b8e69ec" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462464} {:answer-field/choices [{:answer/id #uuid "d009f169-062b-5a05-bfdc-ea900d646a75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461423} {:answer/id #uuid "f7d99831-15cf-550e-ab8c-2067bc306a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461424}] :answer-field/correct {:answer/id #uuid "f7d99831-15cf-550e-ab8c-2067bc306a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461424} :answer-field/id #uuid "e4630cd3-7a16-516e-b1f5-3a6fdd6d0b0f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462465}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f59eef5f-b761-5dcb-b049-d0c57f2862dd" :question/math-academy-id "q-105313" :question/problem "![](images/da/da3040b284606927a6653bfe18697bff0032dea2647d8d36d857c97472bbc540.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is an interior point of the set $M$\n- $B$ is an interior point of the set $M$\n- $C$ is a boundary point of the set $M$\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/c1/c1491f04d1e3d4692dc362008b13ff3909e7ae6f554a5032a9a93036ee2452b5.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is an interior point since there exists an open neighborhood of $A$ that is fully contained inside the set $M.$\n\n- Statement II is false. Every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$ The point $B$ is a boundary point for the given set.\n\n- Statement III is true. The point $C$ is a boundary point because every open neighborhood of $C$ contains points that belong to $M$ and points that do not belong to $M.$\n\nTherefore, the correct answer is 'I and III only'."} {:db/id #edb/ref 17592186241036 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction" :topic/_knowledge-points [{:db/id #edb/ref 17592186050426 :topic/id #uuid "47f4b767-dd8b-5a07-a614-8ff85185d0eb" :topic/math-academy-id 1861 :topic/title "Linear Dependence and Independence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd10af90-8268-5232-9473-253f1c4a0da2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447724} {:answer/id #uuid "f54d7916-c701-5bcb-a279-b7f11eb4abc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447725}] :answer-field/correct {:answer/id #uuid "cd10af90-8268-5232-9473-253f1c4a0da2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447724} :answer-field/id #uuid "8de5c39b-5840-5b9e-83f7-46906d6f45f3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448902} {:answer-field/choices [{:answer/id #uuid "4ffcee29-8511-5be3-b402-b9d385d893a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447726} {:answer/id #uuid "e6f44350-5bbe-53da-b5c6-334f8d6ab627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447727}] :answer-field/correct {:answer/id #uuid "e6f44350-5bbe-53da-b5c6-334f8d6ab627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447727} :answer-field/id #uuid "cd4b40ad-6afb-5fae-9b64-aacae9759675" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448903} {:answer-field/choices [{:answer/id #uuid "079cb409-a3a7-51e0-b8f0-ea41f4f0d754" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447728} {:answer/id #uuid "039313ab-026d-502b-abed-f28f52722a46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447729}] :answer-field/correct {:answer/id #uuid "039313ab-026d-502b-abed-f28f52722a46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447729} :answer-field/id #uuid "27b0747e-f397-5a07-aeb4-68b30a6c531d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448904}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e39d7a95-6796-5061-a2aa-706f3f881251" :question/math-academy-id "q-105315" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}-3 \\\\ 9 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -5 \\\\ -2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}5 \\\\ -12 \\\\ -4\\end{bmatrix}.\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\n- **II.** The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\n- **III.** The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3} &=0 \\\\ 9{x}_{1}-5{x}_{2}-12{x}_{3} &=0 \\\\ -2{x}_{2}-4{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-3 & 2 & 5 & 0 \\\\ 9 & -5 & -12 & 0 \\\\ 0 & -2 & -4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & -2 & -4 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 2 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\left\\{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3} &=0 \\\\ {x}_{2}+3{x}_{3} &=0 \\\\ 2{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+3(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n-3{x}_{1}+2(0)+5(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements II and III are true, while statement I is false."} {:db/id #edb/ref 17592186241038 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction" :topic/_knowledge-points [{:db/id #edb/ref 17592186050426 :topic/id #uuid "47f4b767-dd8b-5a07-a614-8ff85185d0eb" :topic/math-academy-id 1861 :topic/title "Linear Dependence and Independence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119902b6-653e-5dd6-8fa5-3d6771e4a1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447730} {:answer/id #uuid "b1c8f107-a908-59a2-bf5c-916b59b08aa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447731}] :answer-field/correct {:answer/id #uuid "b1c8f107-a908-59a2-bf5c-916b59b08aa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447731} :answer-field/id #uuid "e9bbe3de-380f-5883-ac7f-def1d9e1b0c6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448905} {:answer-field/choices [{:answer/id #uuid "5728916d-87d9-52c5-a916-0ccca10350a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447732} {:answer/id #uuid "c4d20f68-6911-50cc-a7fa-489d0b7dfea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447733}] :answer-field/correct {:answer/id #uuid "c4d20f68-6911-50cc-a7fa-489d0b7dfea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447733} :answer-field/id #uuid "b79c8b14-10e4-5053-854b-9d86f75639d2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448906} {:answer-field/choices [{:answer/id #uuid "2e888d78-0912-515d-b8bd-22e159c76d0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447734} {:answer/id #uuid "2cfacc3c-03da-54a1-be77-08eaf080eea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447735}] :answer-field/correct {:answer/id #uuid "2e888d78-0912-515d-b8bd-22e159c76d0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447734} :answer-field/id #uuid "2ae64784-a378-57b4-8dcc-e0f13a53e107" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448907}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81d16fc8-2819-579f-80e6-748f22f14098" :question/math-academy-id "q-105319" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}-2 \\\\ 8 \\\\ -6\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}4 \\\\ -15 \\\\ 12\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-4 \\\\ 20 \\\\ -7\\end{bmatrix}.\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n- **II.** The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$\n- **III.** The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}-2{x}_{1}+4{x}_{2}-4{x}_{3} &=0 \\\\ 8{x}_{1}-15{x}_{2}+20{x}_{3} &=0 \\\\ -6{x}_{1}+12{x}_{2}-7{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 4 & -4 & 0 \\\\ 8 & -15 & 20 & 0 \\\\ -6 & 12 & -7 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & -4 & 0 \\\\ 0 & 1 & 4 & 0 \\\\ -6 & 12 & -7 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & -4 & 0 \\\\ 0 & 1 & 4 & 0 \\\\ 0 & 0 & 5 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\left\\{\\begin{aligned}-2{x}_{1}+4{x}_{2}-4{x}_{3} &=0 \\\\ {x}_{2}+4{x}_{3} &=0 \\\\ 5{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+4(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n-2{x}_{1}+4(0)-4(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is linearly independent.\n\nTherefore, statements I and II are true, while statement III is false."} {:db/id #edb/ref 17592186241040 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8933021b-ff95-520c-93f9-1899553dcecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447736} {:answer/id #uuid "64d23779-37ea-51fc-98ce-750a58910202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447737}] :answer-field/correct {:answer/id #uuid "8933021b-ff95-520c-93f9-1899553dcecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447736} :answer-field/id #uuid "da48f276-47a0-5522-8b86-7b06f61b5f1d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448908} {:answer-field/choices [{:answer/id #uuid "eabe9833-4a3a-5848-8f4c-c38f1c2fc49a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447738} {:answer/id #uuid "ed58cd7b-cdf1-5a6c-8240-462bf7fe68d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447739}] :answer-field/correct {:answer/id #uuid "ed58cd7b-cdf1-5a6c-8240-462bf7fe68d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447739} :answer-field/id #uuid "c7da7cab-bc59-5b92-9d12-e8f37b4e4145" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448909} {:answer-field/choices [{:answer/id #uuid "bfa10e89-b4be-5ec1-b7ef-365cc1a60424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447740} {:answer/id #uuid "2ea5f38d-e2b8-5b58-87fb-158fc22555db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447741}] :answer-field/correct {:answer/id #uuid "2ea5f38d-e2b8-5b58-87fb-158fc22555db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447741} :answer-field/id #uuid "9970bf36-60b0-537a-9390-6222de4e87d4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c2c7d13-747e-5ac0-bf88-b6f7f16d61aa" :question/math-academy-id "q-105334" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA=\\{(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}>4\\},\\,∂A=\\{(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}=4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(-\\sqrt{2},\\sqrt{2})$ belongs to $A$\n\n- **II.** The point $P(-\\sqrt{2},\\sqrt{2})$ is a boundary point of $A$\n\n- **III.** The point $Q(2,2)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie outside the circle ${x}^{2}+{y}^{2}=4.$ A sketch of this region is shown below:\n\n![](images/a1/a1371f9abdeae5083171f5ddfa5d3e237b7e223ba2ba5cf8a822322c34a4676c.png)\n\n \n\nLet's add the points $P(-\\sqrt{2},\\sqrt{2})$ and $Q(2,2)$ and some neighborhoods of these points to our diagram.\n\n![](images/02/021ebd260ca399ee47bf8268d02a1a05019d63eef8ab2f5facc56f8576195a80.png)\n\nLet's examine the statements in turn.\n\n- Statement I is false. The coordinates of $P(-\\sqrt{2},\\sqrt{2})$ do not satisfy the inequality ${x}^{2}+{y}^{2}>4.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement II is true. The coordinates of $P(-\\sqrt{2},\\sqrt{2})$ satisfy the equation ${x}^{2}+{y}^{2}=4.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement III is true. Indeed, $Q$ is an interior point since there exists an open neighborhood of $Q$ that is fully contained inside the set $A.$\n\nTherefore, the correct answer is 'II and III only'."} {:db/id #edb/ref 17592186241042 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02057818-0bf7-5d62-94ba-0c3159e3f82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447742} {:answer/id #uuid "665df1f8-bd58-553c-8a1d-c93ddddb66ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447743}] :answer-field/correct {:answer/id #uuid "665df1f8-bd58-553c-8a1d-c93ddddb66ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447743} :answer-field/id #uuid "06841891-f37a-58c1-b441-802562d4fe92" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448911} {:answer-field/choices [{:answer/id #uuid "6549e715-2e84-563d-ae87-76b022470af0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447744} {:answer/id #uuid "71c972cd-d3ba-530e-98f0-7075f1725398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447745}] :answer-field/correct {:answer/id #uuid "71c972cd-d3ba-530e-98f0-7075f1725398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447745} :answer-field/id #uuid "2cadbf93-4884-5b6f-b508-5c32610d2796" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448912} {:answer-field/choices [{:answer/id #uuid "e24105fe-af3b-5742-ab18-5fc5303e6655" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447746} {:answer/id #uuid "2ca88cec-cd60-59bc-97f9-aefa992267c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447747}] :answer-field/correct {:answer/id #uuid "e24105fe-af3b-5742-ab18-5fc5303e6655" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447746} :answer-field/id #uuid "bc048b9d-3384-52fd-9e57-1c69d97114a3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448913}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26f835f8-28cf-54e5-acfe-863ecc606ff1" :question/math-academy-id "q-105357" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}\\ge 9},\\,∂A={(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}=9}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(3,0)$ lies on the boundary of $A$\n- **II.** The point $P(3,0)$ belongs to $A$\n- **III.** The point $Q(0,2)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie on or outside the circle ${x}^{2}+{y}^{2}=9.$ A sketch of this region is shown below:\n\n![](images/b9/b9b92085d112ab87592aa8c4d6a56aa4a61ea859d560bac316ce8c97a0af20e5.png)\n\nLet's add the points $P(3,0)$ and $Q(0,2)$ and some neighborhoods of these points to our diagram.\n\n![](images/27/27806c9bb67b60d52cfbae8e881d307d71a3a5fb9465f36d978035f74d78f4bc.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(3,0)$ satisfy the equation ${x}^{2}+{y}^{2}=9.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. The coordinates of $P(3,0)$ satisfy the inequality ${x}^{2}+{y}^{2}\\ge 9.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. The point $Q$ is *not* an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I and II only'."} {:db/id #edb/ref 17592186241043 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0992868-cb81-5a5a-a4c6-0d14a14cb81d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447748} {:answer/id #uuid "64303aea-6ef1-5ea6-b850-8ab554c11d5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447749}] :answer-field/correct {:answer/id #uuid "a0992868-cb81-5a5a-a4c6-0d14a14cb81d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447748} :answer-field/id #uuid "4daa31ae-12ed-5739-bd66-244779ad38e5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448914} {:answer-field/choices [{:answer/id #uuid "0763eedf-6145-5f9d-87aa-d9493d59aa17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447750} {:answer/id #uuid "c8f86495-67e2-5f93-aa9d-87902a0502dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447751}] :answer-field/correct {:answer/id #uuid "c8f86495-67e2-5f93-aa9d-87902a0502dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447751} :answer-field/id #uuid "44c1a6ee-5d02-5245-a744-1ad98c34fb95" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448915} {:answer-field/choices [{:answer/id #uuid "ae6eb8a9-adc0-568d-b9f8-4de17f84f813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447752} {:answer/id #uuid "6f897d74-3ced-58fa-9b7e-96bf41790793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447753}] :answer-field/correct {:answer/id #uuid "ae6eb8a9-adc0-568d-b9f8-4de17f84f813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447752} :answer-field/id #uuid "35069c72-c15c-592a-b7bf-a683c1f62c0d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f57db6a6-9edb-5f0f-98dd-62f31492deff" :question/math-academy-id "q-105365" :question/problem "The set $B$ and its boundary $∂B$ are given by\n\n$$\nB={(x,y)\\in {R}^{2}\\,:\\,\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}<12},\\,∂B={(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}=12}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(3,4)$ lies on the boundary of $B$\n- **II.** The point $P(3,4)$ belongs to $B$\n- **III.** The point $Q(-3,6)$ is an interior point of $B$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $B$ consists of all points that lie inside the ellipse $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}=12.$ A sketch of this region is shown below:\n\n![](images/ad/adee860d39b4d9c4511db2b2f1ad6e7f46342cc474da47303af742be1cc911b3.png)\n\nLet's add the points $P(3,4)$ and $Q(-3,6)$ and some neighborhoods of these points to our diagram.\n\n![](images/21/2185e7129cd799eb1cbb888789566a406b1594dd5a649b9129bec491a1dce1c7.png)\n\nLet's examine the statements in turn.\n\n- Statement I is false. The coordinates of $P(3,4)$ does not satisfy the equation $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}=12.$ Hence, $P$ does not lie on the boundary of $B.$\n\n- Statement II is true. The coordinates of $P(3,4)$ satisfy the inequality $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}<12.$ Hence, $P$ lies in the set $B.$\n\n- Statement III is false. Every open neighborhood of $Q$ contains points that belong to $B$ and points that do not belong to $B.$ The point $Q$ is a boundary point for the given set.\n\nTherefore, the correct answer is 'II only'."} {:db/id #edb/ref 17592186241050 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186048176 :topic/id #uuid "85bbc017-1b3b-59cb-935c-a883af5d0e12" :topic/math-academy-id 612 :topic/title "Continuity Over an Interval"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f5cd349-02df-57a4-87fa-ad7621dc7ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461425} {:answer/id #uuid "c80c29ed-ab88-5f84-a4f6-bfcf8509542b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461426}] :answer-field/correct {:answer/id #uuid "7f5cd349-02df-57a4-87fa-ad7621dc7ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461425} :answer-field/id #uuid "e49eba10-fb5d-5f25-ab9c-eda966fc66dc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462466} {:answer-field/choices [{:answer/id #uuid "80c7e232-9bb0-5a13-b9a9-61d5156eef57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461427} {:answer/id #uuid "e7032692-1def-5667-b369-e6201ffbd33f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461428}] :answer-field/correct {:answer/id #uuid "e7032692-1def-5667-b369-e6201ffbd33f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461428} :answer-field/id #uuid "2ad107a9-8ce8-5886-b6b8-39fdda5e0108" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462467} {:answer-field/choices [{:answer/id #uuid "ace54a21-0486-535d-a83b-20585f9a7047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461429} {:answer/id #uuid "eaef5984-998e-51d8-bebf-b89aaac4b90f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461430}] :answer-field/correct {:answer/id #uuid "ace54a21-0486-535d-a83b-20585f9a7047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461429} :answer-field/id #uuid "78616d03-bd7c-55ad-a15c-d2a4413459e0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bef182d0-f2c3-5147-8c82-4dead855f78c" :question/math-academy-id "q-105418" :question/problem "![](images/b8/b875f560c133e528e4d934ae2722d14c116fac4352f6cca5089f8ec726fe3660.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-2]$\n- $x\\in [-2,4]$\n- $x\\in [4,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram.\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "Let's examine each statement.\n\n- The function is *not* continuous on $(-\\infty ,-2].$ Although the function is continuous on $(-\\infty ,-2),$ it is not left-continuous at $x=-2.$\n\n- The function is continuous on $[-2,4].$ It is continuous on $(-2,4),$ and also right-continuous at $x=-2$ and left-continuous at $x=4.$\n\n- The function is *not* continuous on $[4,\\infty ).$ Although the function is continuous on $(4,\\infty ),$ it is not right-continuous at $x=4.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186241051 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledg