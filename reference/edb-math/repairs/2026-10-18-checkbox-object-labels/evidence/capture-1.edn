[{:answer/id #uuid "1d05df7f-dec5-59ce-b63b-c00fa9f8a672" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438078} {:answer/id #uuid "36e2ee78-8b01-5053-aa94-5d0e687cddc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438079}] :answer-field/correct {:answer/id #uuid "36e2ee78-8b01-5053-aa94-5d0e687cddc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438079} :answer-field/id #uuid "e502be4e-9bbd-5dbb-bb41-0769be49d17b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439068} {:answer-field/choices [{:answer/id #uuid "a8ec9a73-6fbc-5213-bad0-073cc49fb549" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438080} {:answer/id #uuid "29a60663-a01a-5898-a8b1-97b46dadd573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438081}] :answer-field/correct {:answer/id #uuid "a8ec9a73-6fbc-5213-bad0-073cc49fb549" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438080} :answer-field/id #uuid "5bcded34-504d-5f90-a10a-87a266602706" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439069}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b24019f-f592-514c-8874-109e97014d8f" :question/math-academy-id "q-288419" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $3x=2x+5$\n- **II.** $4x-2=4x-2$\n- **III.** $5x+3=5x+1$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x & =2x+5 \\\\ 3x-2x & =2x+5-2x \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the equation $3x=2x+5$ has the unique solution $x=5.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}4x-2 & =4x-2 \\\\ 4x-2-4x & =4x-2-4x \\\\ -2 & =-2.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $4x-2=4x-2$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}5x+3 & =5x+1 \\\\ 5x+3-5x & =5x+1-5x \\\\ 3 & =1.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186111141 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186048295 :topic/id #uuid "920e0459-5102-56be-8b6e-f637c62f1366" :topic/math-academy-id 1531 :topic/title "Graphing Exponential Decay Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ff292a-1c17-5156-aba1-f261c31e00cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448522} {:answer/id #uuid "2702e235-df79-583c-be8b-cc789e4c0437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448523}] :answer-field/correct {:answer/id #uuid "2702e235-df79-583c-be8b-cc789e4c0437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448523} :answer-field/id #uuid "1ca8ca5c-339d-520c-8a6c-c24c9e010289" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449301} {:answer-field/choices [{:a