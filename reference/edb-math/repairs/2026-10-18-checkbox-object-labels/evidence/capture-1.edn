9 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448663}] :answer-field/correct {:answer/id #uuid "fce9af31-06d0-53cd-9d6d-6181d54abe52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448663} :answer-field/id #uuid "7be66204-83a9-53b9-bf40-ec0cbfed1ab5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449371} {:answer-field/choices [{:answer/id #uuid "f5517861-72ea-563c-8242-0d1107c91530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448664} {:answer/id #uuid "b6a78852-4e82-51a1-89eb-21889102a3eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448665}] :answer-field/correct {:answer/id #uuid "f5517861-72ea-563c-8242-0d1107c91530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448664} :answer-field/id #uuid "0dbda2e7-f5a7-5f72-bb3f-fdff336a3646" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449372}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d2def00-4689-55b3-90a3-9823d892535b" :question/math-academy-id "q-43773" :question/problem "Consider the vector space $C[0,1]$ of all continuous functions $f:[0,1]\\to R$ and its subset $K$ containing all constant functions.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $K$ is closed under function addition\n- **II.** $K$ is closed under scalar multiplication\n- **III.** $K$ is a subspace of $C[0,1]$\n- **IV.** $K$ is **not** a subspace of $C[0,1]$\n\n*Hint: $f$ is a constant function if $f(x)=\\text{const}$ for all $x\\in [0,1].$*" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. The sum of two constant functions is a constant function. So, $K$ is closed under addition.\n\n- Statement II is true. The product of a constant function by a scalar is again a constant function. So, $K$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $K$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907 :topic/title "Subspaces of Abstract Vector Spaces"} :activity/title "Subspaces of Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186560356} :db/id #edb/ref 17592186561080}]} {:db/id #edb/ref 17592186125157 :knowledge-point/_questions [{:db/id #edb/ref 17592186124488 :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907 :topic/title "Subspaces of Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "593cf7ed-117d-5fd5-ae11-fb0aaf3de6d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477339} {:answer/id #uuid "fe88dfc1-8125-55b2-a9a1-bbdb7c4a66cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477340}] :answer-field/correct {:answer/id #uuid "593cf7ed-117d-5fd5-ae11-fb0aa