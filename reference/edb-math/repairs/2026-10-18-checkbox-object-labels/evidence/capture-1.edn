id "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4b078b7-f5a3-5e10-8da4-739f031e9cbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438214} {:answer/id #uuid "8c292220-45e3-5b72-bba6-cb8a5c0646b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438215}] :answer-field/correct {:answer/id #uuid "8c292220-45e3-5b72-bba6-cb8a5c0646b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438215} :answer-field/id #uuid "251d1017-18ef-5bc9-9883-11eca3e38d83" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439136} {:answer-field/choices [{:answer/id #uuid "48ad9111-5ff9-5808-834a-73627abed3d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438216} {:answer/id #uuid "29672cf9-dfff-5490-ae19-b79923580048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438217}] :answer-field/correct {:answer/id #uuid "29672cf9-dfff-5490-ae19-b79923580048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438217} :answer-field/id #uuid "02d06f78-7466-5d54-950d-cb989daacc0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439137} {:answer-field/choices [{:answer/id #uuid "fbe0bd4f-6a4d-525e-ac35-a1868f919e0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438218} {:answer/id #uuid "00a2f1ae-0f2a-55b3-bef4-eabad652d111" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438219}] :answer-field/correct {:answer/id #uuid "fbe0bd4f-6a4d-525e-ac35-a1868f919e0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438218} :answer-field/id #uuid "4c704ed7-9a63-5c1b-90d0-bdb2e302d80f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439138}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8099f21-9137-5121-a075-a61a4c5ae84b" :question/math-academy-id "q-36039" :question/problem "![](images/93/936cea1e20ef7bbc1eb66acf9dd564c61476f5bb68ee05e553b00aaf3f970dc3.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in [-4,0]$\n\n- **II.** $x\\in (-4,-2]$\n\n- **III.** $x\\in (-3,1)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.  \n\n- The given function is invertible on each of the intervals $x\\in [-4,0]$ and $x\\in (-4,-2].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/a4/a4499c2d4995c09b9ab6f8852cc2982f415f1650d65429c86df83800344106f4.png)\n\n- The given function is **not** invertible on the interval $x\\in (-3,1]$  because some lines will intersect the curve at more than one point.\n\n![](images/cb/cb0a462b3af10d15bb586f127baac45a74eecd5dc19848bda23664e75de968a4.png)\n\nTherefore, the correct answer is \"I and II only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"} :activity/title "Invertible Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186560353} :db/id #edb/ref 17592186561072}]} {:db/id #edb/ref 17592186124970 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186049511 :topic/id #uuid "fabe76f4-9f30-5b59-b906-f5fa71cfb89f" :topic/math-academy-id 1940 :topic/title "Tangent Lines to Level Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cece21e-845c-5406-87a0-7fadb456d6b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439641} {:answer/id #uuid "de5a9a5b-9a4a-5dff-ae52-46bed3fefdc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439642}] :answer-field/correct {:answer/id #uuid "de5a9a5b-9a4a-5dff-ae52-46bed3fefdc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439642} :answer-field/id #uuid "96d13053-52c8-5327-9cdc-96cbda5b9553" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440178} {:answer-field/choices [{:answer/id #uuid "035c9f0e-cadd-5cfc-8ae0-b3b87f593d82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439643} {:answer/id #uuid "a0d5e2b8-8c44-503b-8c27-5c384d57c17e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439644}] :answer-field/correct {:answer/id #uuid "035c9f0e-cadd-5cfc-