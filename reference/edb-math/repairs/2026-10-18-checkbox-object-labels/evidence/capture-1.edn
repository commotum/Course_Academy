ield/id #uuid "c9224378-06cc-56f0-94b9-9d69d12cb10c" :answer-field/key "$C=\\begin{bmatrix}2 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a1fe1df-e314-527e-a884-f0c092b97472" :question/math-academy-id "q-42090" :question/problem "Which of the following matrices are upper triangular matrices?\n\nSelect all that apply." :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =5\\ne 0 \\\\ {c}_{32} & =3\\ne 0\\end{aligned}\n$$" :task-item/_content [{:db/id #edb/ref 17592186576319 :task-item/content {:db/id #edb/ref 17592186120421} :task-item/elapsed-seconds 16.432 :task-item/id #uuid "ff8c26ee-ce3c-4a33-bdf1-e9c41e4784b8" :task-item/next {:db/id #edb/ref 17592186576320} :task-item/responses [{:answer/id #uuid "fc6cb7c6-9ffe-571b-8f58-c063f4684d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439756} {:answer/id #uuid "0976b793-967e-51b7-a412-465c8f4b7390" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439757} {:answer/id #uuid "1be61f67-558c-5cf9-97de-efa3776455d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439759}] :task-item/status {:db/id #edb/ref 17592186045571} :task-item/working-ended-at #inst "2026-10-17T22:52:49.798Z"}]} {:db/id #edb/ref 17592186120422 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d83