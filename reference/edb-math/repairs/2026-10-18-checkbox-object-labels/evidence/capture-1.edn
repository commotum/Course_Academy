/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460787} {:answer-field/choices [{:answer/id #uuid "16915dd8-a6f1-553d-81d9-5ac7d21852c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459843} {:answer/id #uuid "134336d5-9911-58d2-9ee4-0effc36ebd9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459844}] :answer-field/correct {:answer/id #uuid "16915dd8-a6f1-553d-81d9-5ac7d21852c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459843} :answer-field/id #uuid "bc06950a-f3b8-557c-ad26-06758c78ab74" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460788} {:answer-field/choices [{:answer/id #uuid "d64a178b-7461-5e09-a004-effd84d13a2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459845} {:answer/id #uuid "3755b067-81f0-5479-9950-bef82bc135bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459846}] :answer-field/correct {:answer/id #uuid "3755b067-81f0-5479-9950-bef82bc135bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459846} :answer-field/id #uuid "f5dfddb0-8827-5207-8af4-b1cf45ab0f2c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b428de76-1b52-5416-9b1c-9157ab5ea778" :question/math-academy-id "q-35534" :question/problem "The level curves of the function $f(x,y)=\\frac{2{x}^{2}+1}{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=1$ gives a hyperbola\n- **II.** $c=2$ gives a parabola\n- **III.** $c=3$ gives an ellipse" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}+1}{{x}^{2}+{y}^{2}} & =c \\\\ 2{x}^{2}+1 & =c({x}^{2}+{y}^{2}) \\\\ (c-2){x}^{2}+c{y}^{2} & =1\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=1$ then the level curve is ${y}^{2}-{x}^{2}=1,$ which is a hyperbola.\n\n- If $c=2$ then the level curves are $y=\\pm \\frac{\\sqrt{2}}{2},$ which consists of two lines.\n\n- If $c=3$ then the level curve is ${x}^{2}+3{y}^{2}=1,$ which is an ellipse.\n\nSo, only statements I and III are true."} {:db/id #edb/ref 17592186124899 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements" :topic/_knowledge-points [{:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f80098e5-c2a3-5103-b8f7-876669933d80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448560} {:answer/id #uuid "ce06eac4-88fc-59f1-aeed-a9570958c3d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448561}] :answer-field/correct {:answer/id #uuid "ce06eac4-88fc-59f1-aeed-a9570958c3d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448561} :answer-field/id #uuid "ca230da8-b4e3-5957-a58e-87a045aa03fc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 