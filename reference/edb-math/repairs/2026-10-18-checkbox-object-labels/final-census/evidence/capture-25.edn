uid "6505fe77-158d-58c1-8d86-6a367fa80ba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473355} :answer-field/id #uuid "6923e442-859c-5b1b-afbe-34d9472d4470" :answer-field/key "$n=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474072}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80a88f89-ac3c-581b-83f4-0bc0a136d398" :question/math-academy-id "q-76972" :question/problem "Given that $8≡23\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n\nSelect all that apply." :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=8-23=-15.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $3∣(-15)$ because $(-15)÷3=-5,$ and there is no remainder. Therefore, the statement is true when $n=3.$\n\n- Note that $4∤(-15).$ Therefore, the statement is false when $n=4.$\n\n- Note that $5∣(-15)$ because $(-15)÷5=-3,$ and there is no remainder. Therefore, the statement is true when $n=5.$\n\nTherefore, the correct answer is $n=3$; $n=5$ only."} {:db/id #edb/ref 17592186409438 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f04d70d-73a1-5162-9f13-8c681e7e193a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472454} {:answer/id #uuid "efc94db3-7067-59e2-b764-6e84247a288b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472455}] :answer-field/correct {:answer/id #uuid "efc94db3-7067-59e2-b764-6e84247a288b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472455} :answer-field/id #uuid "c66a189f-578d-55e4-bdc2-1726630fe3a1" :answer-field/key "$n=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473622} {:answer-field/choices [{:answer/id #uuid "ec5cfca5-57a8-5d17-8eef-2d6f69737e95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472456} {:answer/id #uuid "0c2806a1-0cf2-551c-839f-c0c7f5e0fc5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472457}] :answer-field/correct {:answer/id #uuid "0c2806a1-0cf2-551c-839f-c0c7f5e0fc5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472457} :answer-field/id #uuid "0bb3a4ff-595a-555b-9da8-7e75ffc712e8" :answer-field/key "$n=6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473623} {:answer-field/choices [{:answer/id #uuid "58ccace3-f408-56e1-9c02-05d74458e048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472458} {:answer/id #uuid "78380acd-858f-5c58-82d8-b81a2480ef87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472459}] :answer-field/correct {:answer/id #uuid "78380acd-858f-5c58-82d8-b81a2480ef87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472459} :answer-field/id #uuid "86b77862-b26a-5bc0-b724-f4958124abbb" :answer-field/key "$n=9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473624}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9a58d29a-b4cc-50fc-9d69-711422d71682" :question/math-academy-id "q-103490" :question/problem "Given that $13≡-5\\,(\\text{mod}\\,n)$, which of the following could be the value of $n?$\n\nSelect all that apply." :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=13-(-5)=18.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $3∣18$ because $18÷3=6,$ and there is no remainder. Therefore, the statement is true when $n=3.$\n\n- Note that $6∣18$ because $18÷6=3,$ and there is no remainder. Therefore, the statement is true when $n=6.$\n\n- Note that $9∣18$ because $18÷9=2,$ and there is no remainder. Therefore, the statement is true when $n=9.$\n\nTherefore, the correct answer is $n=3$; $n=6$; $n=9$."} {:db/id #edb/ref 17592186409440 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2325c00a-6377-5d3f-8e31-1a81805e5899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453970} {:answer/id #uuid "8c6dd81c-8cb5-59f5-a508-2111c88efa9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453971}] :answer-field/correct {:answer/id #uuid "8c6dd81c-8cb5-59f5-a508-2111c88efa9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453971} :answer-field/id #uuid "2b371275-6d7b-5b97-8c3b-4bd36ec051e3" :answer-field/key "$12≡36\\,(\\text{mod}\\,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454735} {:answer-field/choices [{:answer/id #uuid "2a2d67da-1615-5493-bc76-35012297de9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453972} {:answer/id #uuid "18ef6a60-8030-55f2-9da0-921283250a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453973}] :answer-field/correct {:answer/id #uuid "2a2d67da-1615-5493-bc76-35012297de9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453972} :answer-field/id #uuid "6252a9b3-c085-5ff6-bf8e-08227b893b43" :answer-field/key "$-9≡18\\,(\\text{mod}\\,4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454736} {:answer-field/choices [{:answer/id #uuid "3c1e360a-6eaa-5672-b5fd-0ff6e047a87c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453974} {:answer/id #uuid "41922cf8-75b9-562c-8d22-97b501963686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453975}] :answer-field/correct {:answer/id #uuid "41922cf8-75b9-562c-8d22-97b501963686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453975} :answer-field/id #uuid "3486679b-149d-5c68-b66e-923ed8ccc572" :answer-field/key "$21≡45\\,(\\text{mod}\\,8)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae89ee49-3f2d-51e4-a2f6-ac3e918a674e" :question/math-academy-id "q-76958" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement $12≡36\\,(\\text{mod}\\,2)$ is true because $2∣(12-36).$ There is no remainder:\n\n$$\n(12-36)÷2=-24÷2=-12\n$$\n\n- Statement $-9≡18\\,(\\text{mod}\\,4)$ is false because $4∤(-9-18).$ Notice that $-9-18=-27,$ which is not divisible by $4.$\n\n- Statement $21≡45\\,(\\text{mod}\\,8)$ is true because $8\\,|\\,(21-45).$ There is no remainder:\n\n$$\n(21-45)÷8=-24÷8=-3\n$$\n\nTherefore, the correct answer is $12≡36\\,(\\text{mod}\\,2)$; $21≡45\\,(\\text{mod}\\,8)$ only."} {:db/id #edb/ref 17592186409441 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f096c075-5b46-5ce6-a234-377c581a476b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453976} {:answer/id #uuid "6863ca49-960a-5d77-9a3a-7d0d0aa1dd85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17