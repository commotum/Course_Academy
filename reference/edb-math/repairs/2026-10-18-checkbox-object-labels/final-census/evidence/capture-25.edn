type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574721} {:answer-field/choices [{:answer/id #uuid "ef8035d5-cc67-51fc-a6fa-003a1c47dcc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574479} {:answer/id #uuid "44cff5df-5ee1-5983-b10c-6bc444801c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574480}] :answer-field/correct {:answer/id #uuid "ef8035d5-cc67-51fc-a6fa-003a1c47dcc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574479} :answer-field/id #uuid "84d37da6-508d-5755-a8b0-1eda2924ec3a" :answer-field/key "Column 5: $\\begin{bmatrix}4 \\\\ 1 \\\\ 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574722}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "701f0d82-dd3a-58b3-b64b-6042ce1e752a" :question/math-academy-id "q-73612" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=\\begin{bmatrix}-6 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & -4 & 1 & 1 \\\\ 0 & 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $1$st, $3$rd and $5$th columns:\n\n$$\nB=\\begin{bmatrix}-6 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & -4 & 1 & 1 \\\\ 0 & 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot columns are the $2$nd and $4$th columns."} {:db/id #edb/ref 17592186403682 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904 :topic/title "Identifying the Pivot Columns of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f0de925-861a-5345-ad08-1dc1c646e6dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574553} {:answer/id #uuid "e4c2ae69-043a-5df4-b8e0-15390d849b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574554}] :answer-field/correct {:answer/id #uuid "e4c2ae69-043a-5df4-b8e0-15390d849b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574554} :answer-field/id #uuid "14b6fd21-b390-5c7a-a81d-4c4c1157f529" :answer-field/key "Column 1: $\\begin{bmatrix}-3 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574759} {:answer-field/choices [{:answer/id #uuid "dc7eb03f-5bb4-53f0-9065-9a2b93144df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574555} {:answer/id #uuid "925e2a46-a40e-57ac-b335-c7285bd3eab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574556}] :answer-field/correct {:answer/id #uuid "925e2a46-a40e-57ac-b335-c7285bd3eab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574556} :answer-field/id #uuid "1b7c1a54-6cb9-54d8-99f8-e12b1be8045b" :answer-field/key "Column 2: $\\begin{bmatrix}2 \\\\ 0 \\\\ -4 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574760} {:answer-fiel