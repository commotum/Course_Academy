[{:db/id #edb/ref 17592186403585 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db004ed2-ed81-5217-88ac-e52284d7ad3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473296} {:answer/id #uuid "002f6cc8-519c-547f-b765-dd76618c0b6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473297}] :answer-field/correct {:answer/id #uuid "db004ed2-ed81-5217-88ac-e52284d7ad3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473296} :answer-field/id #uuid "f127a0d3-e90a-58f9-8f2b-6e15c5df7965" :answer-field/key "$A=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474043} {:answer-field/choices [{:answer/id #uuid "a2148234-bd1e-5fc0-8d51-841be04cafc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473298} {:answer/id #uuid "cce1e8ef-95aa-5cbe-8fcc-0e3c07df9260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473299}] :answer-field/correct {:answer/id #uuid "a2148234-bd1e-5fc0-8d51-841be04cafc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473298} :answer-field/id #uuid "15583ac9-f686-5248-9d7b-2d9435ac31bd" :answer-field/key "$B=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474044} {:answer-field/choices [{:answer/id #uuid "7e393702-fa0d-5833-91a4-009529a56bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473300} {:answer/id #uuid "6b014640-d4fa-53b6-b967-987f231f0e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473301}] :answer-field/correct {:answer/id #uuid "6b014640-d4fa-53b6-b967-987f231f0e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473301} :answer-field/id #uuid "b2967199-fd81-5b0d-b35c-cae9b4782fc5" :answer-field/key "$C=\\begin{bmatrix}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba6bcd83-87df-5c0b-b121-63a0ff1205ca" :question/math-academy-id "q-72492" :question/problem "Which of the following matrices are **not** in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{22}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}\n$$\n\nTherefore, only $C$ is **not** in row echelon form."} {:db/id #edb/ref 17592186403647 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither" :topic/_knowledge-points [{:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db64764-98eb-5367-886f-33b324a9214a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473308} {:answer/id #uuid "7f0ff128-e5e1-50ea-8e47-b9e5ae3e0b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473309}] :answer-field/correct {:answer/id #uuid "1db64764-98eb-5367-886f-33b324a9214a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473308} :answer-field/id #uuid "89893083-1925-5c2b-90e5-c9adaba718f9" :answer-field/key "It is a type I region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474049} {:answer-field/choices [{:answer/id #uuid "0dc8ce0d-097d-5ce1-b462-4947b26914f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473310} {:answer/id #uuid "2a96ce7b-6e8b-5a64-8a7a-90e984e28216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473311}] :answer-field/correct {:answer/id #uuid "0dc8ce0d-097d-5ce1-b462-4947b26914f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473310} :answer-field/id #uuid "904ecfbb-f462-5a7b-8006-329fe576e8eb" :answer-field/key "It is a type II region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474050} {:answer-field/choices [{:answer/id #uuid "27a7ac9f-414b-5de1-8820-105f493fe970" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473312} {:answer/id #uuid "e869a60a-bd5e-5590-a53f-789d43379715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473313}] :answer-field/correct {:answer/id #uuid "e869a60a-bd5e-5590-a53f-789d43379715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473313} :answer-field/id #uuid "ec3ecf07-ff0d-544e-9e14-5cec0b49a0d7" :answer-field/key "It's neither a type I nor a type II region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474051}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "964e90c7-3ddc-59ef-9c19-6cc6da31e561" :question/math-academy-id "q-73552" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $(x-1)^{2}+4{y}^{2}=1$ and ${x}^{2}+4{y}^{2}=4?$\n\nSelect all that apply." :question/worked-solution "First, let's sketch our region.\n\n![](images/21/215dd0c920e700a75896fc54751ec20d197487a2c992cd8910810c66129c14dc.png)\n\nWe have the following:\n\n- The vertical line $x=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/7e/7e1a0c5dd2b4aadf7efe78d903234b8d00cf4fa92eb7a3b41209a856f2d14b01.png)\n\n- The horizontal line $y=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/a9/a90d7306e3f88a31609e368f9362248d6a12b7922b6a9e8c9f980ab31e7fb140.png)\n\nTherefore, only statement “It's neither a type I nor a type II region” is true."} {:db/id #edb/ref 17592186403661 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904 :topic/title "Identifying the Pivot Columns of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24521413-a38c-5bab-807d-046ca633558b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574433} {:answer/id #uuid "e6528934-17ee-53de-834e-0926a051f3c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574434}] :answer-field/correct {:answer/id #uuid "24521413-a38c-5bab-807d-046ca633558b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574433} :answer-field/id #uuid "4a098d60-abef-58a5-ba5b-82b5cefd68bc" :answer-field/key "Column 1: $\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574699} {:answer-field/choices [{:answer/id #uuid "739efe86-0bfa-5771-aebc-d62a487ad8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574435} {:answer/id #uuid "1b1fd7c2-dfc