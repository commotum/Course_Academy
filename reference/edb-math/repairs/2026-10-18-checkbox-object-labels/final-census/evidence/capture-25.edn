92186473378} {:answer/id #uuid "f3b6fc24-4f6b-56f1-8866-6340118d47db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473379}] :answer-field/correct {:answer/id #uuid "9299b1f8-2251-5b43-9bd2-4bbaff81aeec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473378} :answer-field/id #uuid "d3409a6e-f1df-5a50-bffb-d1d63615d8a7" :answer-field/key "$\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x-12$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474084}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97b65183-2af9-5046-876f-bba35987095c" :question/math-academy-id "q-77812" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nSelect all that apply." :question/worked-solution "We first simplify the given equations, and get\n\n$\\operatorname{csc}⁡x+30=4\\operatorname{csc}⁡x$. $\\operatorname{csc}⁡x=10$\n\n$5\\operatorname{csc}⁡x-1=2\\operatorname{csc}⁡x$. $\\operatorname{csc}⁡x=\\frac{1}{3}$\n\n$\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x-12$. $\\operatorname{csc}⁡x=4$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation $5\\operatorname{csc}⁡x-1=2\\operatorname{csc}⁡x$ has no solutions."} {:db/id #edb/ref 17592186403919 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048434 :topic/id #uuid "9ef976b2-cf49-59ec-9689-0ec6f4a92d3c" :topic/math-academy-id 288 :topic/title "The Mean Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66663666-6b2e-5179-9d1d-7e887c95870e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473380} {:answer/id #uuid "890f8342-7f94-50f9-bf58-253bb5456e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473381}] :answer-field/correct {:answer/id #uuid "890f8342-7f94-50f9-bf58-253bb5456e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473381} :answer-field/id #uuid "1e2a9ee2-1f01-5fd6-9c2a-edb0bf0a82d2" :answer-field/key "$f(x)={e}^{{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474085} {:answer-field/choices [{:answer/id #uuid "e09f2257-5747-5ba6-91f5-9c588074018a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473382} {:answer/id #uuid "ff04d293-ed97-59e0-bc20-921bdcd6c2ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473383}] :answer-field/correct {:answer/id #uuid "e09f2257-5747-5ba6-91f5-9c588074018a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473382} :answer-field/id #uuid "e8b21d0b-00b1-581c-8ff5-058a7a338509" :answer-field/key "$g(x)={2}^{1/{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474086} {:answer-field/choices [{:answer/id #uuid "26839322-c67a-5c59-aef4-06789c32c634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473384} {:answer/id #uuid "98c2fafd-f8d6-54d6-811f-0da3599ec616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473385}] :answer-field/correct {:answer/id #uuid "98c2fafd-f8d6-54d6-811f-0da3599ec616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473385} :answer-field/id #uuid "3e08be54-a6b1-5674-8fc9-cc5c657d5491" :answer-field/key "$h(x)=\\sqrt{x+4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474087}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d6a5882-b479-5d6b-aea9-d1ab879c1fe4" :question/math-academy-id "q-77865" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-4,4]?$\n\nSelect all that apply." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-4,4],$ the function must be continuous on $[-4,4]$ and differentiable on $(-4,4).$\n\nLet's check each function individually.\n\n- The function $f(x)={e}^{{x}^{2}}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-4,4]$ and differentiable on $(-4,4).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)={2}^{1/{x}^{2}}$ is not defined at $x=0,$ hence, it is not continuous at \n$x=0,$ and so it is not continuous on $[-4,4].$ Therefore, $g(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function $h(x)=\\sqrt{x+4}$ is continuous on $[-4,\\infty )$ and differentiable on $(-4,\\infty ).$ In particular, it is continuous on $[-4,4]$ and differentiable on $(-4,4).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, only the functions $f(x)={e}^{{x}^{2}}$ and $h(x)=\\sqrt{x+4}$ satisfy the conditions for the mean value theorem over the interval $[-4,4].$"} {:db/id #edb/ref 17592186404044 :knowledge-point/_questions [{:db/id #edb/ref 17592186229137 :knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0" :knowledge-point/title "Using the Properties of Linear Differential Operators to Identify Them" :topic/_knowledge-points [{:db/id #edb/ref 17592186050537 :topic/id #uuid "51e12769-3848-5c84-bd86-1c35f7ad69b3" :topic/math-academy-id 6707 :topic/title "Linear Differential Operators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66945714-0f3d-5cc3-8b5b-507cf6021c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473404} {:answer/id #uuid "33c178cd-4b39-5618-b57b-522dc51e66cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473405}] :answer-field/correct {:answer/id #uuid "33c178cd-4b39-5618-b57b-522dc51e66cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473405} :answer-field/id #uuid "37627eb3-6003-5a17-832c-60ecd2564b36" :answer-field/key "${D}_{1}(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474097} {:answer-field/choices [{:answer/id #uuid "dd7e61ba-9286-52f0-8db5-33ed6dbfc475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473406} {:answer/id #uuid "a6f2ab4f-6694-5dfe-90b6-b4ea43acb064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473407}] :answer-field/correct {:answer/id #uuid "a6f2ab4f-6694-5dfe-90b6-b4ea43acb064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473407} :answer-field/id #uuid "2ea6015e-eb0c-5250-9754-e74bfdee2951" :answer-field/key "${D}_{2}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474098} {:answer-field/choices [{:answer/id #uuid "6ca2d238-7517-5f09-b033-0cd58405b16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473408} {:answer/id #uuid "375b18c2-e3c0-5a4f-836e-bb3510f307ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473409}] :answer-field/correct {:answer/id #uuid "6ca2d238-7517-5f09-b033-0cd58405b16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473408} :answer-field/id #uuid "41c26e8c-9101-55a8-9a92-3125eab2120e" :answer-field/key "${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474099}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25cb2680-651e-5a50-81aa-a03a420f17ff" :question/math-academy-id "q-79609" :question/problem "Which of the following are linear differential operators?\n\nSelect all that apply." :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{y}_{1}+b{y}_{2} \\\\  & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{y}_{1}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-ax{y}_{1}-bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-x{y}_{2}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}) \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\na{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})=a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}.\\,\\times \n$$"} {:db/id #edb/ref 17592186404058 :knowledge-point/_questions [{:db/id #edb/ref 17592186152169 :knowledge-point/id #uuid "101e0c22-fbb4-5865-af5f-d669e2488d09" :knowledge-point/title "Identifying Solutions to Linear ODEs Using the Superposition Principle" :topic/_knowledge-points [{:db/id #edb/ref 17592186050032 :topic/id #uuid "277bf882-73ab-515e-84e5-4f7920acb235" :topic/math-academy-id 2549 :topic/title "The Superposition Principle"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1cdba25-84d8-529c-a7e4-55d2c163c39a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473410} {:answer/id #uuid "092a0e35-6b87-553a-b013-1899c41e8750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473411}] :answer-field/correct {:answer/id #uuid "092a0e35-6b87-553a-b013-1899c41e8750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473411} :answer-field/id #uuid "6a33fb9f-f4ab-5fa6-b8c2-2b315892dd81" :answer-field/key "$y(t)={e}^{-t-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474100} {:answer-field/choices [{:answer/id #uuid "067dcce0-2ce3-5612-abc2-5e53e49fa8ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473412} {:answer/id #uuid "bb6e69d3-1313-595d-ae0c-66609c53a4a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473413}] :answer-field/correct {:answer/id #uuid "067dcce0-2ce3-5612-abc2-5e53e49fa8ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473412} :answer-field/id #uuid "7b5d1630-db1e-5690-8f20-a4e018fd9612" :answer-field/key "$y(t)=7{e}^{-t}-3{e}^{-4t}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474101} {:answer-field/choices [{:answer/id #uuid "940def32-e2e8-57dd-9dc8-9252c8387e34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473414} {:answer/id #uuid "f8e6d8c5-ffe3-5619-973e-7efdaa394e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473415}] :answer-field/correct {:answer/id #uuid "f8e6d8c5-ffe3-5619-973e-7efdaa394e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473415} :answer-field/id #uuid "aaa31532-0748-5306-a0e4-248ec10e3366" :answer-field/key "$y(t)=\\frac{{e}^{4t}}{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474102}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "742f0d7e-0be6-5200-afaf-b211266d03e0" :question/math-academy-id "q-79799" :question/problem "Given that ${y}_{1}(t)={e}^{-t}$ and ${y}_{2}(t)={e}^{4t}$ are solutions to the equation ${y}^{″}-3{y}^{′}-4y=0,$ which of the following must also be a solution to the equation?\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(t)$ and ${y}_{2}(t)$ are solutions to a homogeneous, linear differential equation, and ${c}_{1}$ and ${c}_{2}$ are constants, then $y(t)={c}_{1}{y}_{1}(t)+{c}_{2}{y}_{2}(t)$ is also a solution to the equation.\n\nWe're given that ${y}_{1}(t)={e}^{-t}$ and ${y}_{2}(t)={e}^{4t}.$ Therefore, the following function is also a solution:\n\n$$\ny(t)={c}_{1}{e}^{-t}+{c}_{2}{e}^{4t}\n$$\n\nLet's consider each option:\n\n- The function $y(t)={e}^{-t-1}=\\frac{{e}^{-t}}{e}$ is a solution of the given equation. Here, ${c}_{1}=\\frac{1}{e},{c}_{2}=0.$\n\n- The function $y(t)=7{e}^{-t}-3{e}^{-4t}$ is **not** a solution of the given equation because ${e}^{-4t}$ is not a solution.\n\n- The function $y(t)=\\frac{{e}^{4t}}{4}$ is a solution of the given equation. Here, ${c}_{1}=0,{c}_{2}=\\frac{1}{4}.$"} {:db/id #edb/ref 17592186404482 :knowledge-point/_questions [{:db/id #edb/ref 17592186147499 :knowledge-point/id #uuid "6ed6eeb5-a646-5f47-b6d8-f1078f550376" :knowledge-point/title "Identifying Factors Giving an Exact ODE" :topic/_knowledge-points [{:db/id #edb/ref 17592186049438 :topic/id #uuid "f5406a8f-fa45-5605-9b0d-8775dff0b978" :topic/math-academy-id 2521 :topic/title "Exact Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e15f378a-48fc-52fe-8823-93e1ecd6bfa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473530} {:answer/id #uuid "ff0b8c78-df0e-5376-a1d5-062470f9b700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473531}] :answer-field/correct {:answer/id #uuid "e15f378a-48fc-52fe-8823-93e1ecd6bfa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473530} :answer-field/id #uuid "e8491ecc-d42f-5097-b247-4917384941a1" :answer-field/key "$10{y}^{5}{e}^{x}+4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474160} {:answer-field/choices [{:answer/id #uuid "11eae91c-5d78-5a31-ba0c-4a2e1724c2e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473532} {:answer/id #uuid "5427f4e5-abc9-5196-b937-ea2a61a4979f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473533}] :answer-field/correct {:answer/id #uuid "11eae91c-5d78-5a31-ba0c-4a2e1724c2e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473532} :answer-field/id #uuid "d7a6a6b8-f0c5-5e99-bb31-95a22ffc645a" :answer-field/key "$2{y}^{5}{e}^{2x}-y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474161} {:answer-field/choices [{:answer/id #uuid "a748e074-f924-5d1c-9ca0-5cbd913edfa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473534} {:answer/id #uuid "e22fc836-77eb-51c5-b108-fdca97c84f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473535}] :answer-field/correct {:answer/id #uuid "e22fc836-77eb-51c5-b108-fdca97c84f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473535} :answer-field/id #uuid "d122ca1e-6dcc-5fcd-92e2-84487547bfc4" :answer-field/key "$2{y}^{5}{e}^{2x}+{e}^{-x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474162}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fa44e0d-f47d-55dc-9787-703e1dcaa8bd" :question/math-academy-id "q-90493" :question/problem "Consider the following differential equation:\n\n$$\nP(x,y)\\text{d}x+5{y}^{4}{e}^{2x}\\,\\text{d}y=0\n$$\n\nGiven that the differential equation is exact, which of the following functions could be $P(x,y)?$\n\nSelect all that apply." :question/worked-solution "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nIn our case, we're given $Q(x,y)=5{y}^{4}{e}^{2x}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x$:\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(5{y}^{4}{e}^{2x})=10{y}^{4}{e}^{2x}\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=10{y}^{5}{e}^{x}+4.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(10{y}^{5}{e}^{x}+4)=50{y}^{4}{e}^{x}\\ne \\frac{∂Q}{∂x}\\,\\times \\end{aligned}\n$$\n\nTherefore, $P(x,y)=10{y}^{5}{e}^{x}+4$ does *not* give an exact equation.\n\n- Next, we check $P(x,y)=2{y}^{5}{e}^{2x}-y:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2{y}^{5}{e}^{2x}-y)=10{y}^{4}{e}^{2x}-1\\ne \\frac{∂Q}{∂x}\\,\\times \\end{aligned}\n$$\n\nTherefore, $P(x,y)=2{y}^{5}{e}^{2x}-y$ does *not* give an exact equation.\n\n- Finally, we check $P(x,y)=2{y}^{5}{e}^{2x}+{e}^{-x}:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2{y}^{5}{e}^{2x}+{e}^{-x})=10{y}^{4}{e}^{2x}=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2{y}^{5}{e}^{2x}+{e}^{-x}$ gives an exact equation."} {:db/id #edb/ref 17592186404489 :knowledge-point/_questions [{:db/id #edb/ref 17592186147592 :knowledge-point/id #uuid "fc7eacaa-2cf2-5cae-a40c-737c98124bcf" :knowledge-point/title "Determining the Degree of a Homogeneous Polynomial Using the Fast Method" :topic/_knowledge-points [{:db/id #edb/ref 17592186049922 :topic/id #uuid "1ecb929e-8b09-5ace-ac95-9f72f70c2772" :topic/math-academy-id 2536 :topic/title "Homogeneous Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec0311ce-b46b-5035-833a-cea67a498994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473536} {:answer/id #uuid "acbe6235-6424-5ca0-8ff0-d4f83a9b6e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473537}] :answer-field/correct {:answer/id #uuid "acbe6235-6424-5ca0-8ff0-d4f83a9b6e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473537} :answer-field/id #uuid "73412ddb-1b44-5d75-9d51-79a3b827c576" :answer-field/key "$f(x)=7{x}^{7}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474163} {:answer-field/choices [{:answer/id #uuid "0c3c7e4d-96ad-5456-af60-6a9be8b1b2c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473538} {:answer/id #uuid "9a7d5594-82ad-5f14-b78f-06bc040d3301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473539}] :answer-field/correct {:answer/id #uuid "9a7d5594-82ad-5f14-b78f-06bc040d3301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473539} :answer-field/id #uuid "5f571d9b-f764-5fe9-bebd-c3011862617e" :answer-field/key "$g(x,y)=x+y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474164} {:answer-field/choices [{:answer/id #uuid "bafda784-1720-5bb1-a298-7401ce3dc64a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473540} {:answer/id #uuid "0c9d50fe-1a80-59d8-9425-f2596d83aacb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473541}] :answer-field/correct {:answer/id #uuid "0c9d50fe-1a80-59d8-9425-f2596d83aacb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473541} :answer-field/id #uuid "152e7eef-107e-520a-9245-b37a9384cd65" :answer-field/key "$h(x,y,z)={x}^{2}z-2xyz+x{z}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474165}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "056f268e-6f23-5cca-ba50-28679fda2fed" :question/math-academy-id "q-90580" :question/problem "Which of the following polynomials are homogeneous?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's go through each of the options.\n\n- The function $f(x)$ is homogeneous of degree $7.$  It is a polynomial of degree $7,$ with no terms of degree other than $7.$\n\n- The function $g(x,y)$ is homogeneous of degree $1.$ It is a polynomial of degree $1,$ and all of its terms are of degree $1.$\n\n- The function $h(x,y,z)$ is  homogeneous of degree $3.$ It is a polynomial of degree $3,$ and all of its terms are of degree $3.$"} {:db/id #edb/ref 17592186404672 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a987d465-96cb-5565-87da-ae39b2f6a92a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473590} {:answer/id #uuid "3e93a862-63da-5b94-b287-04f38912e3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473591}] :answer-field/correct {:answer/id #uuid "3e93a862-63da-5b94-b287-04f38912e3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473591} :answer-field/id #uuid "ca99863b-b425-5b5a-ac1b-d0313dabcf4b" :answer-field/key "$y=R\\operatorname{cos}⁡(7t+{ϕ}_{1})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474190} {:answer-field/choices [{:answer/id #uuid "1fd96488-ba24-5395-9984-81005376bc49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473592} {:answer/id #uuid "d9c3983e-849e-58b2-8b42-2cd6e4159d2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473593}] :answer-field/correct {:answer/id #uuid "1fd96488-ba24-5395-9984-81005376bc49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473592} :answer-field/id #uuid "c07c7d0e-205c-53a2-a07b-dcf5bc52afaa" :answer-field/key "$y=R{sin}^{2}⁡(7t+{ϕ}_{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474191} {:answer-field/choices [{:answer/id #uuid "ed73706a-6e71-56ba-88e4-f857738dd0fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473594} {:answer/id #uuid "c42472a9-f281-5bea-92d5-c789d59d5b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473595}] :answer-field/correct {:answer/id #uuid "ed73706a-6e71-56ba-88e4-f857738dd0fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473594} :answer-field/id #uuid "ff1aee9a-9f0b-58d7-bba1-84da96bd2edc" :answer-field/key "$y=A\\operatorname{sec}⁡7t+B\\operatorname{sin}⁡7t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5104a46-b15f-584e-909c-ecd7bde371f7" :question/math-academy-id "q-94277" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+49y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants.\n\nSelect all that apply." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=49\\,⟹\\,\\omega =7.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(7t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(7t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡7t+B\\operatorname{sin}⁡7t$\n\nTherefore, only function $y=R\\operatorname{cos}⁡(7t+{ϕ}_{1})$ could be used to represent  $y(t).$"} {:db/id #edb/ref 17592186404679 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8985fe4-3ac5-56a7-9098-2eae5e6fa918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473596} {:answer/id #uuid "15ea8117-ebc8-5814-b2ac-1fe2bf2a8243" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473597}] :answer-field/correct {:answer/id #uuid "e8985fe4-3ac5-56a7-9098-2eae5e6fa918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473596} :answer-field/id #uuid "f84d5925-da95-5920-a7ac-94bedb2ce6db" :answer-field/key "$y=R\\operatorname{cos}⁡(5t+{ϕ}_{1})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474193} {:answer-field/choices [{:answer/id #uuid "29113d34-992b-56b3-8a21-c7c09fdad7f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473598} {:answer/id #uuid "4def6162-cad2-5c33-8c5d-93189b905062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473599}] :answer-field/correct {:answer/id #uuid "4def6162-cad2-5c33-8c5d-93189b905062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473599} :answer-field/id #uuid "898e6262-677e-5b1f-905c-aa35b176ce24" :answer-field/key "$y=R\\operatorname{sin}⁡(\\sqrt{5}t+{ϕ}_{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474194} {:answer-field/choices [{:answer/id #uuid "de417394-cdb1-5a81-a934-58231a475209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473600} {:answer/id #uuid "79e8f5d9-91e1-59d2-ba3c-24686e65b1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473601}] :answer-field/correct {:answer/id #uuid "de417394-cdb1-5a81-a934-58231a475209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473600} :answer-field/id #uuid "1010cd03-ef23-5e5c-9aeb-93be7f261c00" :answer-field/key "$y=A\\operatorname{sec}⁡\\sqrt{5}t+B\\operatorname{csc}⁡\\sqrt{5}t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23f8b8a5-7c24-563a-a40e-d60abf329c96" :question/math-academy-id "q-94278" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+5y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants.\n\nSelect all that apply." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=5\\,⟹\\,\\omega =\\sqrt{5}.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(\\sqrt{5}t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\sqrt{5}t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\sqrt{5}t+B\\operatorname{sin}⁡\\sqrt{5}t$\n\nTherefore, only statement $y=R\\operatorname{sin}⁡(\\sqrt{5}t+{ϕ}_{2})$ could be used to represent $y(t).$"} {:db/id #edb/ref 17592186405016 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences" :topic/_knowledge-points [{:db/id #edb/ref 17592186049983 :topic/id #uuid "23d28f28-6e03-59a9-9aed-cdda7589cb10" :topic/math-academy-id 1087 :topic/title "Limits of Sequences"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0118fcd2-3fb3-5d19-8d54-74b731ba63af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472514} {:answer/id #uuid "185007ee-7759-5766-aba5-89fd735ff1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472515}] :answer-field/correct {:answer/id #uuid "185007ee-7759-5766-aba5-89fd735ff1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472515} :answer-field/id #uuid "76e1c758-f96e-5e38-a825-4534ee09d9c8" :answer-field/key "${a}_{n}=\\frac{{n}^{3}}{1-{n}^{2}}$ for $n\\ge 2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473652} {:answer-field/choices [{:answer/id #uuid "be82617a-5165-5619-a963-79617d0fb8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472516} {:answer/id #uuid "a4acbd6f-94bc-50c4-8cf1-90972310c364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472517}] :answer-field/correct {:answer/id #uuid "be82617a-5165-5619-a963-79617d0fb8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472516} :answer-field/id #uuid "230986f1-b69c-54fe-a946-e524b56da72a" :answer-field/key "${a}_{n}=\\frac{3}{n}$ for $n\\ge 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473653} {:answer-field/choices [{:answer/id #uuid "6428e025-be55-5e9d-a741-674cab46f66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472518} {:answer/id #uuid "dfd56f4c-ce88-53f8-9163-fd06eb6824f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472519}] :answer-field/correct {:answer/id #uuid "6428e025-be55-5e9d-a741-674cab46f66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472518} :answer-field/id #uuid "2fcd4fcd-f673-515e-8c18-48e21edbbda3" :answer-field/key "${a}_{n}=\\frac{2{n}^{2}-3{n}^{3}}{{n}^{3}+5}$ for $n\\ge 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473654}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4fed36-e750-5401-88f4-2ac9e7e598e7" :question/math-academy-id "q-123316" :question/problem "Which of the following sequences diverge?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each sequence in turn. We need to calculate the limit of each sequence as $n$ approaches infinity.\n\n- In sequence “${a}_{n}=\\frac{{n}^{3}}{1-{n}^{2}}$ for $n\\ge 2$”,  the dominant term in the denominator is $-{n}^{2},$ so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{{n}^{3}}{1-{n}^{2}} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{{n}^{3}}{{n}^{2}})}{(\\frac{1}{{n}^{2}}-\\frac{{n}^{2}}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{n}{(\\frac{1}{{n}^{2}}-1)} \\\\  & ={lim}_{n\\to \\infty }\\frac{n}{0-1} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges.\n\n- In sequence “${a}_{n}=\\frac{3}{n}$ for $n\\ge 1$”, the limit is\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{3}{n}=0.\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence “${a}_{n}=\\frac{2{n}^{2}-3{n}^{3}}{{n}^{3}+5}$ for $n\\ge 1$”, the dominant term in the denominator is ${n}^{3},$ so we divide the numerator and the denominator by ${n}^{3}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & =\\frac{2{n}^{2}-3{n}^{3}}{{n}^{3}+5} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{2{n}^{2}}{{n}^{3}}-\\frac{3{n}^{3}}{{n}^{3}})}{(\\frac{{n}^{3}}{{n}^{3}}+\\frac{5}{{n}^{3}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{2}{n}-3)}{(1+\\frac{5}{{n}^{3}})} \\\\  & =\\frac{0-3}{1+0} \\\\  & =-3.\\end{aligned}\n$$\n\nThe limit exists, so the sequence converges.\n\nIn conclusion, sequence “${a}_{n}=\\frac{{n}^{3}}{1-{n}^{2}}$ for $n\\ge 2$” diverges."} {:db/id #edb/ref 17592186405146 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "3762310e-4280-5383-a623-be69110b6dd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473303}] :answer-field/correct {:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "7b242a5e-e0c2-5c98-9faf-9932a432bab4" :answer-field/key "$A=\\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474046} {:answer-field/choices [{:answer/id #uuid "c468a92d-1de4-54b3-98e3-28167311714f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473304} {:answer/id #uuid "cc55be58-e4c5-5d28-bde2-dd07f224de99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "cc55be58-e4c5-5d28-bde2-dd07f224de99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "aa9139c6-224d-5848-a9fd-c41516bf7428" :answer-field/key "$B=\\left[\\begin{array}{ccc|c}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474047} {:answer-field/choices [{:answer/id #uuid "61bba97e-fa99-5844-b1d0-4a1ac0911bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "27aa4326-84a9-502a-8ac6-38a05b1d7790" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473307}] :answer-field/correct {:answer/id #uuid "61bba97e-fa99-5844-b1d0-4a1ac0911bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "17d4295d-6d7f-5bde-a6ed-7e5d41c2a614" :answer-field/key "$C=\\left[\\begin{array}{ccccc|c}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbb2727c-01c4-5345-9e38-1d38c7fb43da" :question/math-academy-id "q-72575" :question/problem "Which of the following augmented matrices have coefficient matrices that are **not** in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\nSelect all that apply." :question/worked-solution "A coefficient matrix, obtained by omitting the final column of its augmented matrix, is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The coefficient matrix of $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]\n$$\n\n- The coefficient matrix of $B$ is not in row echelon form since the leading entries of its first two rows are in columns $3$ and $2,$ respectively (condition II is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{array}\\right]\n$$\n\n- The coefficient matrix of $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccccc|c}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{array}\\right]\n$$\n\nTherefore, only $B$ has a coefficient matrix that is **not** in row echelon form." :task-item/_content [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/elapsed-seconds 32.993 :task-item/id #uuid "1cf13a50-d282-4509-a4ee-caababb75b38" :task-item/next {:db/id #edb/ref 17592186526464} :task-item/responses [{:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302} {:answer/id #uuid "cc55be58-e4c5-5d28-bde2-dd07f224de99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305} {:answer/id #uuid "61bba97e-fa99-5844-b1d0-4a1ac0911bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306}] :task-item/status {:db/id #edb/ref 17592186045571}}]} {:db/id #edb/ref 17592186406655 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set" :topic/_knowledge-points [{:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319 :topic/title "Orthogonal Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047c19ef-c76a-57b3-b13e-81cac8438947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473112} {:answer/id #uuid "0f411e21-0bfc-5e60-be10-aa9385c60d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473113}] :answer-field/correct {:answer/id #uuid "0f411e21-0bfc-5e60-be10-aa9385c60d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473113} :answer-field/id #uuid "41b5e6b2-6fa4-5699-91d3-98491ea01274" :answer-field/key "$U={Q(\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ -3\\end{bmatrix})}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473951} {:answer-field/choices [{:answer/id #uuid "3b5e99f8-6d7b-5605-8eeb-768c689a1a11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473114} {:answer/id #uuid "d3e8b7c2-03e8-52a8-8c30-1f1597b0a406" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473115}] :answer-field/correct {:answer/id #uuid "3b5e99f8-6d7b-5605-8eeb-768c689a1a11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473114} :answer-field/id #uuid "2909a2f7-876c-5e10-a289-6837f83679fc" :answer-field/key "$V={Q(\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}),Q(\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix})}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473952} {:answer-field/choices [{:answer/id #uuid "829a1b56-ccd5-5381-aeca-6ba71098f21a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473116} {:answer/id #uuid "adcc7d05-7e81-525a-b650-a03adf317913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473117}] :answer-field/correct {:answer/id #uuid "adcc7d05-7e81-525a-b650-a03adf317913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473117} :answer-field/id #uuid "51b28bdf-55b7-5470-b1f6-bd8182431d5f" :answer-field/key "$W={Q(\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}),Q(\\begin{bmatrix}6 \\\\ -1\\end{bmatrix})}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9892c6c7-24de-57f2-a3e8-0b32de0c1349" :question/math-academy-id "q-40491" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ ${Q({u}_{1}),Q({u}_{2})},\\,$ ${Q({w}_{1}),Q({w}_{2})},\\,$ and $\\,{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})}.$ \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3\\end{bmatrix}=18-18=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ -1\\end{bmatrix}=1-1=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}=2+12-5=9\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\nTherefore, the correct answer is \"$U$ and $W$ only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319 :topic/title "Orthogonal Linear Transformations"} :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406635} :db/id #edb/ref 17592186406658}]} {:db/id #edb/ref 17592186406841 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8f9232e-9658-51ed-95f2-ac2fd1e78bf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454078} {:answer/id #uuid "a2a49195-0754-59e8-a736-789d713df706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454079}] :answer-field/correct {:answer/id #uuid "a2a49195-0754-59e8-a736-789d713df706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454079} :answer-field/id #uuid "3fee3505-d7fb-511a-a74e-2a2d44598ed9" :answer-field/key "If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454789} {:answer-field/choices [{:answer/id #uuid "33b58ec5-18ed-565a-8a4c-7a428ef3b660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454080} {:answer/id #uuid "fa80fb0a-3883-56b5-b6eb-070e8e31d145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454081}] :answer-field/correct {:answer/id #uuid "33b58ec5-18ed-565a-8a4c-7a428ef3b660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454080} :answer-field/id #uuid "0d6a4961-38f7-5264-b58e-a39849428f01" :answer-field/key "If $Tx=[1,0,0]^{T}$ has more than one solution, then $\\text{nullity}(T)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454790} {:answer-field/choices [{:answer/id #uuid "642014a7-57ea-5677-bbda-439505c688fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454082} {:answer/id #uuid "fbeac619-768a-5b27-a0a3-6f578395c470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454083}] :answer-field/correct {:answer/id #uuid "642014a7-57ea-5677-bbda-439505c688fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454082} :answer-field/id #uuid "d0f9063c-3f2e-5e1f-893e-6358b44768be" :answer-field/key "If $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}$, then $T$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454791}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "838322c6-867e-5a73-a18d-bbf81bd1218b" :question/math-academy-id "q-84081" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$” is true. Since $y=z=0,$ any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ 0 \\\\ 0\\end{bmatrix}=x\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{nullity}(T)=1.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement “If $Tx=[1,0,0]^{T}$ has more than one solution, then $\\text{nullity}(T)=0$” is false. Since $Tx=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$ has more than one solution, there are ${u}_{1},{u}_{2}\\in {R}^{3}$ such that  ${u}_{1}\\ne {u}_{2}$ and \n\n$$\nT({u}_{1})=T({u}_{2})=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$\n\nThis means, $T$ is not a bijection and according to the invertible matrix theorem, $\\text{nullity}(T)\\ne 0.$\n\n- Statement “If $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}$, then $T$ is invertible” is false. Notice that $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}.$ Therefore, $\\text{nullity}(T)=1.$ So, $T$ is not a bijection or, which is the same, $T$ is not invertible.\n\nTherefore, the correct answer is “If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"} :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406809} :db/id #edb/ref 17592186406844}]} {:db/id #edb/ref 17592186406843 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec4bc02-0df9-5348-9ee4-473b64cacd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472718} {:answer/id #uuid "0b06b982-fb9d-5cf4-b752-4ccd290073ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472719}] :answer-field/correct {:answer/id #uuid "0b06b982-fb9d-5cf4-b752-4ccd290073ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472719} :answer-field/id #uuid "edc239d3-5a4c-5fa5-98b1-768823c16b23" :answer-field/key "$\\text{rank}(T)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473754} {:answer-field/choices [{:answer/id #uuid "72dd48fb-940a-538d-8ccc-7a6e5aa609a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472720} {:answer/id #uuid "fcd1213a-a7a4-5890-88d8-8de888db8343" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472721}] :answer-field/correct {:answer/id #uuid "72dd48fb-940a-538d-8ccc-7a6e5aa609a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472720} :answer-field/id #uuid "0ff1d1ba-36f4-5b99-8a47-88e5119e65f7" :answer-field/key "$\\text{nullity}(T)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473755} {:answer-field/choices [{:answer/id #uuid "05116011-77ca-56fd-9a97-eba1d5a68cd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472722} {:answer/id #uuid "01638de6-6ede-5e18-812c-b75ad72b29e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472723}] :answer-field/correct {:answer/id #uuid "05116011-77ca-56fd-9a97-eba1d5a68cd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472722} :answer-field/id #uuid "dec578f4-3243-5145-b140-1c5ad943604d" :answer-field/key "$T$ is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b72abcb6-85da-5c4d-a8eb-72ce20ae6b72" :question/math-academy-id "q-140100" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$, then $\\underline{\\phantom{xxxxxx}}.$ * \n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{rank}(T)=4$ is true. Indeed, since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ and the set ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=4.$\n\n- Statement $\\text{nullity}(T)=4$ is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-4 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement “$T$ is a bijection” is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is $\\text{rank}(T)=4$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"} :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406809} :db/id #edb/ref 17592186406846}]} {:db/id #edb/ref 17592186406880 :knowledge-point/_questions [{:db/id #edb/ref 17592186124490 :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0fb2451-4145-52a4-a863-c1c6b500c031" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454178} {:answer/id #uuid "52bf72c1-2d03-54f1-83ce-0080cfe75fc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454179}] :answer-field/correct {:answer/id #uuid "f0fb2451-4145-52a4-a863-c1c6b500c031" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454178} :answer-field/id #uuid "03f577e9-d7b5-59b1-9054-aeaecadbcd8d" :answer-field/key "${{b}_{1},{b}_{2},{b}_{3},w}$ is linearly independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454839} {:answer-field/choices [{:answer/id #uuid "6291cb58-5945-57e8-971a-03bf17a20742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454180} {:answer/id #uuid "e330a199-18c6-573a-b614-26a3494d9178" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454181}] :answer-field/correct {:answer/id #uuid "6291cb58-5945-57e8-971a-03bf17a20742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454180} :answer-field/id #uuid "e630bf03-420c-549c-8c6a-4ca716a3ea03" :answer-field/key "${{b}_{1},{b}_{2}}$ is linearly dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454840} {:answer-field/choices [{:answer/id #uuid "b7df072b-200d-5d6c-a18b-7f91a1928602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454182} {:answer/id #uuid "2454f33d-1680-5c05-9fc3-08394323c4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454183}] :answer-field/correct {:answer/id #uuid "2454f33d-1680-5c05-9fc3-08394323c4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454183} :answer-field/id #uuid "b8f08f4c-963a-5572-927c-4df8af138eba" :answer-field/key "${{b}_{1},3{b}_{2},2{b}_{3}}$ is a basis of $V$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454841}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1d66ed66-f11f-53c8-af0e-1883d2bbdd40" :question/math-academy-id "q-94942" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of a vector space $V.$ \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $B$ is a basis, the following properties must hold:\n\n- $B$ is a maximally linearly independent set of vectors in $V,$ and\n\n- $B$ spans $V.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “${{b}_{1},{b}_{2},{b}_{3},w}$ is linearly independent” is false. Since $B$ is a basis of $V,$ it is a maximally linearly independent set of vectors. This means that if we add any new vector to the set, it becomes linearly dependent.\n\n- Statement “${{b}_{1},{b}_{2}}$ is linearly dependent” is false. Since if ${{b}_{1},{b}_{2}}$ is linearly dependent then there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}=0,\n$$\n\nwhere at least one of $x$'s is not zero. But then \n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+0{b}_{3}=0,\n$$\n\nwhich would mean that $B$ is linearly dependent. This would contradict the fact that $B$ is a basis.\n\n- Statement “${{b}_{1},3{b}_{2},2{b}_{3}}$ is a basis of $V$” is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}(3{b}_{2})+{x}_{3}(2{b}_{3}) & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+(3{x}_{2}){b}_{2}+(2{x}_{3}){b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since ${{b}_{1},{b}_{2},{b}_{3}}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ 3{x}_{2} &=0 \\\\ 2{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nAlso, ${{b}_{1},3{b}_{2},2{b}_{3}}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of ${{b}_{1},3{b}_{2},2{b}_{3}}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}={x}_{1}{b}_{1}+\\frac{{x}_{2}}{3}(3{b}_{2})+\\frac{{x}_{3}}{2}(2{b}_{3})\n$$\n\nTherefore, the correct answer is “${{b}_{1},3{b}_{2},2{b}_{3}}$ is a basis of $V$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"} :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406849} :db/id #edb/ref 17592186406885}]} {:db/id #edb/ref 17592186406881 :knowledge-point/_questions [{:db/id #edb/ref 17592186124489 :knowledge-point/id #uuid "073042ee-d96d-5872-9681-ddcea43a2d37" :knowledge-point/title "Identifying True Statements About Sets of Vectors in a Matrix Vector Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaaf8ce1-2c2b-5bcc-925e-0f599acad60d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454172} {:answer/id #uuid "c647dd27-09cc-5bd3-810e-1d4746a2941e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454173}] :answer-field/correct {:answer/id #uuid "c647dd27-09cc-5bd3-810e-1d4746a2941e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454173} :answer-field/id #uuid "619d8289-a96c-58c5-9ea1-3220d6f4efec" :answer-field/key "$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 