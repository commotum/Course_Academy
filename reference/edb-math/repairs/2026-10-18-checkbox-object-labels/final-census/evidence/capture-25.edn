type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574562}] :answer-field/correct {:answer/id #uuid "76f2c948-dbcb-556b-98b2-177a54e84030" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574561} :answer-field/id #uuid "dcad0d28-1c27-5e85-a35a-847b6710abda" :answer-field/key "Column 5: $\\begin{bmatrix}4 \\\\ 0 \\\\ 0 \\\\ 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574763}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8bbb774c-4bbb-58f8-84cb-fd20b0029b02" :question/math-academy-id "q-73638" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{bmatrix}?\n$$\n\nSelect all that apply." :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{bmatrix} & {R}_{3} & ↔{R}_{4} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2 \\\\ 0 & 0 & 0 & 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $1$st, $2$nd, $3$rd, and $4$th columns."} {:db/id #edb/ref 17592186403787 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438514} {:answer/id #uuid "72c05b38-661e-55ef-b895-991dd965f68d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438515}] :answer-field/correct {:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438514} :answer-field/id #uuid "d5f63264-b18f-5fb9-8709-61b443e3ce15" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439286} {:answer-field/choices [{:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438516} {:answer/id #uuid "0cfc1f4e-c211-54e2-8df0-f80bdf080bed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438517}] :answer-field/correct {:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438516} :answer-field/id #uuid "a0678042-ac90-54b5-926f-6259f946ee55" :answer-field/key "The system has a unique solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439287} {:answer-field/choices [{:answer/id #uuid "c32dbf70-7f15-517a-9383-074f32bf4f01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438518} {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438519}] :answer-field/correct {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438519} :answer-field/id #uuid "98fa2d2a-8e07-54bb-bb31-70f2215b776f" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8971116-e24d-5808-9b29-a50e168511e5" :question/math-academy-id "q-74634" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-y &=-1 \\\\ 2x-4y &=3 \\\\ x+y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we will first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & \\frac{3}{2} & \\frac{5}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & 0 & \\frac{9}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=\\frac{9}{2},$ and it has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement “The system is inconsistent” is true."} {:db/id #edb/ref 17592186403864 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049220 :topic/id #uuid "e46861d7-4b7a-5813-a6e8-914206606355" :topic/math-academy-id 1565 :topic/title "Elementary Trigonometric Equations Containing Secant"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acd031f-ce15-5c91-b73f-5f31e4bb1899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473332} {:answer/id #uuid "f667985d-d48c-5f2b-94e8-6e61ef5fd588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473333}] :answer-field/correct {:answer/id #uuid "f667985d-d48c-5f2b-94e8-6e61ef5fd588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473333} :answer-field/id #uuid "0b29fd12-66cc-595b-934f-f11eb10c7aed" :answer-field/key "$\\operatorname{sec}⁡x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474061} {:answer-field/choices [{:answer/id #uuid "f8ffa324-af68-5895-a079-04ac45e6d86a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473334} {:answer/id #uuid "d66f8482-f8a4-5bfb-985e-46cb6a04c038" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473335}] :answer-field/correct {:answer/id #uuid "f8ffa324-af68-5895-a079-04ac45e6d86a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473334} :answer-field/id #uuid "09512d14-dd08-54ae-b7f3-edcbde760b7a" :answer-field/key "$\\operatorname{sec}⁡x=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474062} {:answer-field/choices [{:answer/id #uuid "3007f04d-c4c7-5bc6-8bb4-042b79fb5798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473336} {:answer/id #uuid "e3d1c324-50de-591a-97d7-07a3c4b25ae4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473337}] :answer-field/correct {:answer/id #uuid "3007f04d-c4c7-5bc6-8bb4-042b79fb5798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473336} :answer-field/id #uuid "fe8f692d-b519-5db8-aba0-c98e74faba08" :answer-field/key "$\\operatorname{sec}⁡x=\\frac{7}{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a83238f9-a8b1-5193-9f12-9adee2517d46" :question/math-academy-id "q-76503" :question/problem "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation $\\operatorname{sec}⁡x=0$ has no solutions."} {:db/id #edb/ref 17592186403905 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uu