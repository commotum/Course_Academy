}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{bmatrix} \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049489 :topic/id #uuid "f8e64c9f-51e4-540d-a7ed-38ccf90ff042" :topic/math-academy-id 2125 :topic/title "Projection Matrices, Linear Transformations and Their Properties"} :activity/title "Projection Matrices, Linear Transformations and Their Properties" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186497788} :db/id #edb/ref 17592186498625}]} {:db/id #edb/ref 17592186360600 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0366f0a7-9dc5-5a50-9987-2d20cf430407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469788} {:answer/id #uuid "85c5de64-419d-5402-86fe-df0bcd87ab34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469789}] :answer-field/correct {:answer/id #uuid "85c5de64-419d-5402-86fe-df0bcd87ab34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469789} :answer-field/id #uuid "5f298414-5a78-5758-b95a-22a8e18aef9c" :answer-field/key "${R}^{150}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470506} {:answer-field/choices [{:answer/id #uuid "a5d5d3fa-0ab9-5849-9ca3-e919738f22d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469790} {:answer/id #uuid "0ecfa01d-9146-57fe-b075-031b2950c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469791}] :answer-field/correct {:answer/id #uuid "0ecfa01d-9146-57fe-b075-031b2950c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469791} :answer-field/id #uuid "50410e2b-8fd6-5841-ae1c-d3b21473606c" :answer-field/key "${\\text{M}}_{150}(R),$ the vector space of all $150\\times 150$ matrices over $R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470507} {:answer-field/choices [{:answer/id #uuid "c0482d56-7be1-5926-a311-a997c9be84df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469792} {:answer/id #uuid "9fb2846f-3268-586a-ad2f-121bcef06817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469793}] :answer-field/correct {:answer/id #uuid "c0482d56-7be1-5926-a311-a997c9be84df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469792} :answer-field/id #uuid "8c36212a-1538-522d-a072-6f8372621105" :answer-field/key "$R[t],$ the vector space of all polynomial functions in the variable $t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e531c342-c218-5c9e-86de-28e412cdeaaa" :question/math-academy-id "q-95386" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nSelect all that apply." :question/worked-solution "Let's examine our vector spaces.\n\n- ${R}^{150}$ and ${\\text{M}}_{150}(R)$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}^{150})=150\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{150}(R))={150}^{2}=22\\,500,\n$$\n\n \nare both finite numbers.\n\n- $R[t]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{a}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in R$ if and only if ${a}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $R[t]$ of size $n,$ which imples that $R[t]$ cannot have finite dimension.\n\nTherefore, the correct answer is ${R}^{150}$; “${\\text{M}}_{150}(R),$ the vector space of all $150\\times 150$ matrices over $R$” only."} {:db/id #edb/ref 17592186360671 :knowledge-point/_questions [{:db/id #edb/ref 17592186166788 :knowledge-point/id #uuid "6a6ca425-0e94-5b83-8729-fda13fbf3d7d" :knowledge-point/title "Identifying Equilibrium Solutions of a Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186051068 :topic/id #uuid "7e482952-bd90-56e1-a587-ef0d76b7d965" :topic/math-academy-id 3184 :topic/title "Equilibrium Solutions of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8139637-8e82-5b32-b05d-a90a5ed25604" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469806} {:answer/id #uuid "a6b99b14-815f-5b95-84f7-bf5e12833ebe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469807}] :answer-field/correct {:answer/id #uuid "a6b99b14-815f-5b95-84f7-bf5e12833ebe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469807} :answer-field/id #uuid "792054a2-6470-5383-8af1-815b20b190b7" :answer-field/key "$y=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470515} {:answer-field/choices [{:answer/id #uuid "18b5002f-0058-5055-8f76-cd09fc58fc68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469808} {:answer/id #uuid "ea5cd59b-8c99-5170-8de8-87b5f99f1eca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469809}] :answer-field/correct {:answer/id #uuid "18b5002f-0058-5055-8f76-cd09fc58fc68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469808} :answer-field/id #uuid "86b22de7-7fe7-5dd4-b362-42d2cacff149" :answer-field/key "$y=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470516} {:answer-field/choices [{:answer/id #uuid "c45e6e66-7fbc-5337-9c2b-a5fa36cf9618" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469810} {:answer/id #uuid "308fcee5-5e70-5885-b5ea-20cdebf40a6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469811}] :answer-field/correct {:answer/id #uuid "c45e6e66-7fbc-5337-9c2b-a5fa36cf9618" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469810} :answer-field/id #uuid "c3426a6c-4972-5b04-aaed-80a5d1606fef" :answer-field/key "$y=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bdcd03c-4e33-5af2-a43a-72ec614b803e" :question/math-academy-id "q-96070" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}t}+y={y}^{2}-2.$ Which of the following is an equilibrium solution of this equation?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(t)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nFirst, we write the given equation as\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}={y}^{2}-y-2,\n$$\n\nand we get that $f(y)={y}^{2}-y-2.$\n\nNow, let's check each proposed solution by substituting them into $f(y).$\n\n- $y=2$ is an equilibrium point. We have $f(2)={2}^{2}-2-2=0.$$\\,✓$\n\n- $y=1$ is *not* an equilibrium point. We have $f(1)={1}^{2}-1-2=-2\\ne 0.$ $\\,\\times $\n\n- $y=4$ is *not* an equilibrium point. We have $f(4)={4}^{2}-4-2=10\\ne 0.$  $\\,\\times $\n\nTherefore, the correct answer is $y=2$ only."} {:db/id #edb/ref 17592186360672 :knowledge-point/_questions [{:db/id #edb/ref 17592186166788 :knowledge-point/id #uuid "6a6ca425-0e94-5b83-8729-fda13fbf3d7d" :knowledge-point/title "Identifying Equilibrium Solutions of a Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186051068 :topic/id #uuid "7e482952-bd90-56e1-a587-ef0d76b7d965" :topic/math-academy-id 3184 :topic/title "Equilibrium Solutions of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e089712-9e8d-5a06-9486-b36e393637d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469812} {:answer/id #uuid "e5af46c0-36b4-5041-b26e-4967d1519a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469813}] :answer-field/correct {:answer/id #uuid "0e089712-9e8d-5a06-9486-b36e393637d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469812} :answer-field/id #uuid "f0be3825-bbe9-533b-835f-a228584ff886" :answer-field/key "$y=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470518} {:answer-field/choices [{:answer/id #uuid "260410a8-65bb-5892-aa51-d356fbb9b5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469814} {:answer/id #uuid "2431bdce-8758-5311-bac2-20c5ea1f09ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469815}] :answer-field/correct {:answer/id #uuid "2431bdce-8758-5311-bac2-20c5ea1f09ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469815} :answer-field/id #uuid "b7b1200c-89e7-56eb-8bd9-0a9a36df85a5" :answer-field/key "$y=e$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470519} {:answer-field/choices [{:answer/id #uuid "1ceb5c2b-15b4-5a91-8b04-6a949d64834d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469816} {:answer/id #uuid "7f9bff13-8c86-5ea9-a24a-7a92868f1e4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469817}] :answer-field/correct {:answer/id #uuid "1ceb5c2b-15b4-5a91-8b04-6a949d64834d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469816} :answer-field/id #uuid "eca4bcc5-b73b-5b70-b7a2-6076a97d7f00" :answer-field/key "$y=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470520}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7617131b-e756-503f-ac7c-f76ae1870fab" :question/math-academy-id "q-96072" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}+{e}^{2}={y}^{2}\\operatorname{ln}⁡y.$ Which of the following is an equilibrium solution of this equation?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(x)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nFirst, we write the given equation as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={y}^{2}\\operatorname{ln}⁡y-{e}^{2},\n$$\n\nand we get that $f(y)={y}^{2}\\operatorname{ln}⁡y-{e}^{2}.$\n\nNow, let's check each proposed solution by substituting them into $f(y).$\n\n- $y=1$ is *not* an equilibrium point. We have $f(1)=(1)^{2}\\cdot \\operatorname{ln}⁡1-{e}^{2}=-{e}^{2}\\ne 0.$ $\\,\\times $\n\n- $y=e$ is an equilibrium point. We have $f(e)={e}^{2}\\operatorname{ln}⁡e-{e}^{2}={e}^{2}-{e}^{2}=0.$$\\,✓$\n\n- $y=2$ is *not* an equilibrium point. We have $f(2)={2}^{2}\\operatorname{ln}⁡2-{e}^{2}\\ne 0.$  $\\,\\times $\n\nTherefore, the correct answer is $y=e$ only."} {:db/id #edb/ref 17592186360674 :knowledge-point/_questions [{:db/id #edb/ref 17592186166790 :knowledge-point/id #uuid "ba6a29e6-4dab-5854-815c-fa26292c31d8" :knowledge-point/title "Identifying True Statements About Equilibrium Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186051068 :topic/id #uuid "7e482952-bd90-56e1-a587-ef0d76b7d965" :topic/math-academy-id 3184 :topic/title "Equilibrium Solutions of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b84124-c396-5736-a056-7f8e1ce308ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452233} {:answer/id #uuid "598b3fd1-242a-5ae8-a50c-f84a4f67eeaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452234}] :answer-field/correct {:answer/id #uuid "598b3fd1-242a-5ae8-a50c-f84a4f67eeaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452234} :answer-field/id #uuid "2d6b8912-0903-534c-901f-32d0b7de85ab" :answer-field/key "$y=3$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452964} {:answer-field/choices [{:answer/id #uuid "2f8624b2-6502-5a6b-94ce-b00fcae3a52e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452235} {:answer/id #uuid "6f736b23-6015-5e69-8184-7fdc4d3a2265" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452236}] :answer-field/correct {:answer/id #uuid "2f8624b2-6502-5a6b-94ce-b00fcae3a52e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452235} :answer-field/id #uuid "d5cabc5f-4044-5516-b26e-0f594cf46527" :answer-field/key "$y=-1$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452965} {:answer-field/choices [{:answer/id #uuid "fb5e0227-c6ba-57dd-9f20-eb05bb83e2e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452237} {:answer/id #uuid "daf3e89e-d0ca-5dbc-83fa-31386dfe762d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452238}] :answer-field/correct {:answer/id #uuid "daf3e89e-d0ca-5dbc-83fa-31386dfe762d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452238} :answer-field/id #uuid "1ebecfe6-93c5-5a67-a95a-27095255008a" :answer-field/key "The equation has $2$ distinct equilibrium solutions" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452966}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c54591e7-ef71-57d2-878c-9e6d49c7bcb6" :question/math-academy-id "q-96174" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}t}={y}^{3}-7{y}^{2}+15y-9.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(t)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is a equilibrium solution of the equation.\n\nIn our case, we have that $f(y)={y}^{3}-7{y}^{2}+15y-9.$\n\nLet's examine the statement one-by-one.\n\n- Statement “$y=3$ is an equilibrium solution of the equation” is true.  We have that $f(3)=(3)^{3}-7(3)^{2}+15(3)-9=0.$\n\n- Statement “$y=-1$ is an equilibrium solution of the equation” is false.  We have that $f(-1)=(-1)^{3}-7(-1)^{2}+15(-1)-9=-32\\ne 0.$\n\n- Statement “The equation has $2$ distinct equilibrium solutions” is true. We know that $y=3$ is a solution to $f(y)=0,$ and so $(y-3)$ is a factor of the polynomial $f(y).$ Dividing $f(y)$ by $(y-3)$ using synthetic division, we get\n\n|  | ${y}^{3}$ | ${y}^{2}$ | ${y}^{1}$ | ${y}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $3$ | $1$ | $-7$ | $15$ | $-9$ |\n|  | $↓$ | $3$ | $-12$ | $9$ |\n|  | $1$ | $-4$ | $3$ | $0$ |\n\n \nTherefore, \n\n$$\n\\begin{aligned}f(y) & =(y-3)({y}^{2}-4y+3) \\\\  & =(y-3)(y-1)(y-3) \\\\  & =(y-1)(y-3)^{2}.\\end{aligned}\n$$\n\nHence, $f(y)$ has $2$ distinct equilibrium solutions, \n\n$$\n{y}_{1}(t)=1,\\,{y}_{2}(t)=3.\n$$\n\nTherefore, the correct answer is “$y=3$ is an equilibrium solution of the equation”; “The equation has $2$ distinct equilibrium solutions” only."} {:db/id #edb/ref 17592186360675 :knowledge-point/_questions [{:db/id #edb/ref 17592186166790 :knowledge-point/id #uuid "ba6a29e6-4dab-5854-815c-fa26292c31d8" :knowledge-point/title "Identifying True Statements About Equilibrium Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186051068 :topic/id #uuid "7e482952-bd90-56e1-a587-ef0d76b7d965" :topic/math-academy-id 3184 :topic/title "Equilibrium Solutions of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9544f3-e540-59f0-894c-52f1ffc5480e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452239} {:answer/id #uuid "f62afe63-ee09-5de2-b7e3-3548cc0c0e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452240}] :answer-field/correct {:answer/id #uuid "f62afe63-ee09-5de2-b7e3-3548cc0c0e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452240} :answer-field/id #uuid "3cbd59e1-fe6d-565d-90c7-b1bc593c9a92" :answer-field/key "$y=-2$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452967} {:answer-field/choices [{:answer/id #uuid "ae7e3e12-83eb-5eec-9bd3-01e734d50c4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452241} {:answer/id #uuid "a7f423ba-453e-56e5-ad64-b854a7e3f824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452242}] :answer-field/correct {:answer/id #uuid "ae7e3e12-83eb-5eec-9bd3-01e734d50c4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452241} :answer-field/id #uuid "db9db40a-96b5-5bb2-8d94-c0758ab01901" :answer-field/key "$y=2$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452968} {:answer-field/choices [{:answer/id #uuid "d11ef1d5-4c6b-5a24-9bb1-31954972426e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452243} {:answer/id #uuid "3e6ff03b-2d57-5b43-a4f8-ee40ee848a48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452244}] :answer-field/correct {:answer/id #uuid "d11ef1d5-4c6b-5a24-9bb1-31954972426e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452243} :answer-field/id #uuid "1277c36b-d718-5d9b-8046-f6bd1766581c" :answer-field/key "The equation has $3$ distinct equilibrium solutions" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452969}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0a964745-ccd9-5740-8d1c-95a9554c72d8" :question/math-academy-id "q-96175" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}t}={y}^{3}+6{y}^{2}+12y+8.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(t)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nIn our case, we have that $f(y)={y}^{3}+6{y}^{2}+12y+8.$\n\nLet's examine the statement one-by-one.\n\n- Statement “$y=-2$ is an equilibrium solution of the equation” is true. We have that $f(-2)=(-2)^{3}+6(-2)^{2}+12(-2)+8=0.$\n\n- Statement “$y=2$ is an equilibrium solution of the equation” is false. We have that $f(2)=(2)^{3}+6(2)^{2}+12(2)+8=64\\ne 0.$\n\n- Statement “The equation has $3$ distinct equilibrium solutions” is false. We know that $y=-2$ is a solution to $f(y)=0,$ and so $(y+2)$ is a factor of the polynomial $f(y).$ Dividing $f(y)$ by $(y+2)$ using synthetic division, we get\n\n|  | ${y}^{3}$ | ${y}^{2}$ | ${y}^{1}$ | ${y}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-2$ | $1$ | $6$ | $12$ | $8$ |\n|  | $↓$ | $-2$ | $-8$ | $-8$ |\n|  | $1$ | $4$ | $4$ | $0$ |\n\n \nTherefore, \n\n$$\n\\begin{aligned}f(y) & =(y+2)({y}^{2}+4y+4) \\\\  & =(y+2)(y+2)^{2} \\\\  & =(y+2)^{3}.\\end{aligned}\n$$\n\nHence, $f(y)$ has exactly one equilibrium solution,\n\n$$\n{y}_{1}(t)=-2.\n$$\n\nTherefore, the correct answer is “$y=-2$ is an equilibrium solution of the equation” only."} {:db/id #edb/ref 17592186360676 :knowledge-point/_questions [{:db/id #edb/ref 17592186166790 :knowledge-point/id #uuid "ba6a29e6-4dab-5854-815c-fa26292c31d8" :knowledge-point/title "Identifying True Statements About Equilibrium Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186051068 :topic/id #uuid "7e482952-bd90-56e1-a587-ef0d76b7d965" :topic/math-academy-id 3184 :topic/title "Equilibrium Solutions of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87e50c97-9dff-55dd-b173-aeca436dd936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452245} {:answer/id #uuid "1575ff1d-037a-5bd5-a94e-a6cf02fe5603" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452246}] :answer-field/correct {:answer/id #uuid "87e50c97-9dff-55dd-b173-aeca436dd936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452245} :answer-field/id #uuid "667eb623-a31f-5312-b370-cf63459f7ae4" :answer-field/key "$y=1$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452970} {:answer-field/choices [{:answer/id #uuid "91648f96-d7ef-537c-ba94-1646df4b874d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452247} {:answer/id #uuid "44fc5834-e770-5603-bb2f-a52b485c11a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452248}] :answer-field/correct {:answer/id #uuid "44fc5834-e770-5603-bb2f-a52b485c11a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452248} :answer-field/id #uuid "8a9bc596-2dcf-5cd2-bd35-53b46ff7d499" :answer-field/key "$y=-4$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452971} {:answer-field/choices [{:answer/id #uuid "4e43bb63-c9f2-52e0-9310-0815d5c2bde2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452249} {:answer/id #uuid "3f8c7117-68aa-5a04-8a8b-979435f5ff3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452250}] :answer-field/correct {:answer/id #uuid "4e43bb63-c9f2-52e0-9310-0815d5c2bde2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452249} :answer-field/id #uuid "b632e23c-282b-5cd4-91e3-bf7b1ad0c8b5" :answer-field/key "The equation has $3$ distinct equilibrium solutions" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452972}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "240bb27d-47ae-5dc7-8379-ece480fdb60d" :question/math-academy-id "q-96176" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}t}={y}^{3}+6{y}^{2}+9y+4.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(t)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nIn our case, we have that $f(y)={y}^{3}+6{y}^{2}+9y+4.$\n\nLet's examine the statement one-by-one.\n\n- Statement “$y=1$ is an equilibrium solution of the equation” is false.  We have that $f(1)=(1)^{3}+6(1)^{2}+9(1)+4=20\\ne 0.$\n\n- Statement “$y=-4$ is an equilibrium solution of the equation” is true.  We have that $f(-4)=(-4)^{3}+6(-4)^{2}+9(-4)+4=0.$\n\n- Statement “The equation has $3$ distinct equilibrium solutions” is false. We know that $y=-4$ is a solution to $f(y)=0,$ and so $(y+4)$ is a factor of the polynomial $f(y).$ Dividing $f(y)$ by $(y+4)$ using synthetic division, we get\n\n|  | ${y}^{3}$ | ${y}^{2}$ | ${y}^{1}$ | ${y}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-4$ | $1$ | $6$ | $9$ | $4$ |\n|  | $↓$ | $-4$ | $-8$ | $-4$ |\n|  | $1$ | $2$ | $1$ | $0$ |\n\n \nTherefore, \n\n$$\n\\begin{aligned}f(y) & =(y+4)({y}^{2}+2y+1) \\\\  & =(y+4)(y+1)^{2}.\\end{aligned}\n$$\n\nHence, $f(y)$ has $2$ distinct equilibrium solutions, \n\n$$\n{y}_{1}(t)=-4,\\,{y}_{2}(t)=-1.\n$$\n\nTherefore, the correct answer is “$y=-4$ is an equilibrium solution of the equation” only."} {:db/id #edb/ref 17592186360681 :knowledge-point/_questions [{:db/id #edb/ref 17592186166823 :knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735" :knowledge-point/title "Identifying True Statements Regarding Slope Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186048822 :topic/id #uuid "c2fc5214-795d-5bfe-b226-459801a3c888" :topic/math-academy-id 3276 :topic/title "Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f50203c2-f60d-5431-8206-3988c85398af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452251} {:answer/id #uuid "33b2defc-6ca8-58f5-9073-49565cafff10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452252}] :answer-field/correct {:answer/id #uuid "33b2defc-6ca8-58f5-9073-49565cafff10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452252} :answer-field/id #uuid "a0b01744-c511-5150-966e-104b4eaade41" :answer-field/key "At every point along the line $x=-2,$ the slope field has a negative slope" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452973} {:answer-field/choices [{:answer/id #uuid "88c110cc-2d61-5cf9-bad9-83dde739d285" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452253} {:answer/id #uuid "900a492f-fcac-50b8-a3ab-723e91f105fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452254}] :answer-field/correct {:answer/id #uuid "88c110cc-2d61-5cf9-bad9-83dde739d285" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452253} :answer-field/id #uuid "8fd2bfc2-f289-59f4-b485-cac8e450dd97" :answer-field/key "At every point along the line $x=1,$ the slope field has a positive slope" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452974} {:answer-field/choices [{:answer/id #uuid "bfce53f8-f002-5d07-a413-245c28d3c81b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452255} {:answer/id #uuid "ea03c5db-7dc9-5e41-957b-ae2dfab59a99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452256}] :answer-field/correct {:answer/id #uuid "ea03c5db-7dc9-5e41-957b-ae2dfab59a99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452256} :answer-field/id #uuid "cfb3fe4f-a930-5c65-b540-e4ba50e6959a" :answer-field/key "At every point along the line $x=2,$ the slope field is horizontal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452975}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67d01a5a-9701-5a58-9666-20fdabb34b54" :question/math-academy-id "q-96457" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x-2$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement “At every point along the line $x=-2,$ the slope field has a negative slope” is true. Consider a point of the form $(-2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,y)}=-2-2=-4<0,\n$$\n\nand this implies that the slope at the point $(-2,y)$ is negative for any $y.$ Moreover, the slope at the point $(-2,y)$ is equal to $-4$ for any $y.$\n\n- Statement “At every point along the line $x=1,$ the slope field has a positive slope” is false. Consider a point of the form $(1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,y)}=1-2=-1<0,\n$$\n\nand this implies that the slope at the point $(1,y)$ is negative for any $y.$ Moreover, the slope at the point $(1,y)$ is equal to $-1$ for any $y.$\n\n- Statement “At every point along the line $x=2,$ the slope field is horizontal” is true. Consider a point of the form $(2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(2,y)}=2-2=0,\n$$\n\nand this implies that the slope at the point $(2,y)$ is horizontal for any $y.$\n\nTherefore, the correct answer is “At every point along the line $x=-2,$ the slope field has a negative slope”; “At every point along the line $x=2,$ the slope field is horizontal” only.\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](images/34/34ab84e5a2b05adad50384cbbb33f48233976aa9e757a40468d5778709801d83.png)"} {:db/id #edb/ref 17592186360682 :knowledge-point/_questions [{:db/id #edb/ref 17592186166823 :knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735" :knowledge-point/title "Identifying True Statements Regarding Slope Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186048822 :topic/id #uuid "c2fc5214-795d-5bfe-b226-459801a3c888" :topic/math-academy-id 3276 :topic/title "Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b51f78-52a7-5169-8672-6658a2172756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452257} {:answer/id #uuid "20a28d62-8cff-5fe5-b73b-01d3c2bb5ff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452258}] :answer-field/correct {:answer/id #uuid "20a28d62-8cff-5fe5-b73b-01d3c2bb5ff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452258} :answer-field/id #uuid "a1f02116-96e8-5374-a849-4f5b1fd4315a" :answer-field/key "At every point along the line $x=-1,$ the slope field has a negative slope" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452976} {:answer-field/choices [{:answer/id #uuid "a0a5a2c5-5674-5887-9d98-598091315855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452259} {:answer/id #uuid "bffc93cd-feca-55c4-8505-8a284081baf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452260}] :answer-field/correct {:answer/id #uuid "bffc93cd-feca-55c4-8505-8a284081baf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452260} :answer-field/id #uuid "c3f4c587-e575-5f80-a4e9-d133617a0fce" :answer-field/key "At every point along the line $x=0,$ the slope field is horizontal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452977} {:answer-field/choices [{:answer/id #uuid "8390b636-bddb-5593-be7e-210fd012fa3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452261} {:answer/id #uuid "59ae657f-12e6-5df5-a84e-c34977ff4429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452262}] :answer-field/correct {:answer/id #uuid "59ae657f-12e6-5df5-a84e-c34977ff4429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452262} :answer-field/id #uuid "08082b08-0781-5496-9195-669463e47184" :answer-field/key "At every point along the line $x=1,$ the slope field has a positive slope" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ca13504-5fd7-5ae1-b6ac-2d5759efcc76" :question/math-academy-id "q-96460" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}={x}^{3}+x$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement “At every point along the line $x=-1,$ the slope field has a negative slope” is true. Consider a point of the form $(-1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,y)}=(-1)^{3}+(-1)=-2<0,\n$$\n\nand this implies that the slope at the point $(-1,y)$ is negative for any $y.$ Moreover, the slope at the point $(-1,y)$ is equal to $-2$ for any $y.$\n\n- Statement “At every point along the line $x=0,$ the slope field is horizontal” is true. Consider a point of the form $(0,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,y)}=(0)^{2}+0=0,\n$$\n\nand this implies that the slope at the point $(0,y)$ is horizontal for any $y.$\n\n- Statement “At every point along the line $x=1,$ the slope field has a positive slope” is true. Consider a point of the form $(1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,y)}=(1)^{3}+1=2,\n$$\n\nand this implies that the slope at the point $(1,y)$ is positive for any $y.$ Moreover, the slope at the point $(1,y)$ is equal to $2$ for any $y.$\n\nTherefore, the correct answer is “At every point along the line $x=-1,$ the slope field has a negative slope”; “At every point along the line $x=0,$ the slope field is horizontal”; “At every point along the line $x=1,$ the slope field has a positive slope”.\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](images/45/45427ef9ff00752ad528335ae51143c27fcc01d9c535d2fe380edfbbfdb9b167.png)"} {:db/id #edb/ref 17592186360684 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61f9b779-a82b-5fca-ac7c-8326f052042f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452263} {:answer/id #uuid "e7a19fce-bfec-59e9-b174-01dd728ea53b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452264}] :answer-field/correct {:answer/id #uuid "61f9b779-a82b-5fca-ac7c-8326f052042f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452263} :answer-field/id #uuid "027ffc36-9391-569a-9d2f-da2a80b366dc" :answer-field/key "If $A$ is *any*  $n\\times n$ matrix, then ${A}^{2}$ is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452979} {:answer-field/choices [{:answer/id #uuid "c0b1bee2-eead-5899-9436-3a5e41c5d534" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452265} {:answer/id #uuid "5c95db47-f37c-5361-aca9-caa8ca8ccc7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452266}] :answer-field/correct {:answer/id #uuid "c0b1bee2-eead-5899-9436-3a5e41c5d534" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452265} :answer-field/id #uuid "3698aa5e-23d2-5ab3-84e9-157fdeec0f61" :answer-field/key "The product of two $n\\times n$ symmetric matrices is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452980} {:answer-field/choices [{:answer/id #uuid "b91e26b4-0173-5667-9919-d76bd3bc5172" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452267} {:answer/id #uuid "9d9e1009-c7de-59b4-8f5d-83345258f1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452268}] :answer-field/correct {:answer/id #uuid "9d9e1009-c7de-59b4-8f5d-83345258f1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452268} :answer-field/id #uuid "6cfe9278-620c-5f30-9b43-3e38a539af4d" :answer-field/key "If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists)." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452981}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6c182c5-819c-5206-a031-9309a3557f8d" :question/math-academy-id "q-96589" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “If $A$ is *any*  $n\\times n$ matrix, then ${A}^{2}$ is always symmetric” is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, ${A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{2} & =\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement “The product of two $n\\times n$ symmetric matrices is always symmetric” is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}.$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement “If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists)” is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\nTherefore, the correct answer is “If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists)” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"} :activity/title "Symmetric Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425147} :db/id #edb/ref 17592186425155}]} {:db/id #edb/ref 17592186360685 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f12fac1-b0d6-532b-be36-7ca114813335" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452269} {:answer/id #uuid "6b9df603-5cc7-56a3-8458-480fec1933de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452270}] :answer-field/correct {:answer/id #uuid "6b9df603-5cc7-56a3-8458-480fec1933de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452270} :answer-field/id #uuid "cf8b0515-2015-50da-af0f-2f20ef8ea319" :answer-field/key "The product of two $n\\times n$ diagonal matrices is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452982} {:answer-field/choices [{:answer/id #uuid "753c148a-4ac7-5764-9593-da714a721e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452271} {:answer/id #uuid "1f70874e-ec66-5ebd-8bd3-ad7a7ec28222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452272}] :answer-field/correct {:answer/id #uuid "753c148a-4ac7-5764-9593-da714a721e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452271} :answer-field/id #uuid "b9926a67-2ad5-5f8f-aa3d-cb2ad57957a6" :answer-field/key "If $A$ is *any* $n\\times n$ matrix, then ${A}^{2}$ is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452983} {:answer-field/choices [{:answer/id #uuid "62b2961b-aeac-5514-b80f-b37e49e4ab23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452273} {:answer/id #uuid "d7e4c09c-8d69-5ff3-b738-fa41770a02c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452274}] :answer-field/correct {:answer/id #uuid "d7e4c09c-8d69-5ff3-b738-fa41770a02c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452274} :answer-field/id #uuid "e48c112e-140d-5265-8d48-23b6de6bed4a" :answer-field/key "If $A$ is *any*  $n\\times n$ matrix, then $A+{A}^{T}$ is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452984}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f89572d6-dc07-5dcb-a203-869905770fe1" :question/math-academy-id "q-96592" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “The product of two $n\\times n$ diagonal matrices is always symmetric” is true. Indeed, for any diagonal matrices $A$ and $B,$ their product $AB$ is also diagonal, and any diagonal matrix is symmetric.\n\n- Statement “If $A$ is *any* $n\\times n$ matrix, then ${A}^{2}$ is always symmetric” is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, ${A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{2} & =\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement “If $A$ is *any*  $n\\times n$ matrix, then $A+{A}^{T}$ is always symmetric” is true. Indeed, for any square matrix $A,$ we have \n\n$$\n\\begin{aligned}(A+{A}^{T})^{T} & ={A}^{T}+({A}^{T})^{T} \\\\  & ={A}^{T}+A \\\\  & =A+{A}^{T}.\\end{aligned}\n$$\n\nTherefore, the correct answer is “The product of two $n\\times n$ diagonal matrices is always symmetric”; “If $A$ is *any*  $n\\times n$ matrix, then $A+{A}^{T}$ is always symmetric” only."} {:db/id #edb/ref 17592186360686 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bad97d8-ef3a-52f8-b2f7-46a5dd2b75c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452281} {:answer/id #uuid "852f50dd-59e0-589f-a1a7-fad362b65980" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452282}] :answer-field/correct {:answer/id #uuid "852f50dd-59e0-589f-a1a7-fad362b65980" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452282} :answer-field/id #uuid "a05fe89d-6e9f-5b43-99c7-c0eb958dad60" :answer-field/key "If $A$ is a symmetric matrix, then $A+{A}^{2}$ is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452988} {:answer-field/choices [{:answer/id #uuid "96ce7f3f-af0f-54f4-b6c4-89e33dab89e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452283} {:answer/id #uuid "7d0a8b11-f151-59b5-9f8e-b4ba55b44d31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452284}] :answer-field/correct {:answer/id #uuid "96ce7f3f-af0f-54f4-b6c4-89e33dab89e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452283} :answer-field/id #uuid "8ce19bc5-240f-517a-8681-b115f890fcd4" :answer-field/key "The product of *any* two $n\\times n$ matrices is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452989} {:answer-field/choices [{:answer/id #uuid "efefb077-7ac0-500a-b65e-b68056c82797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452285} {:answer/id #uuid "58c68790-31b4-576b-9ece-2177c9770751" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452286}] :answer-field/correct {:answer/id #uuid "efefb077-7ac0-500a-b65e-b68056c82797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452285} :answer-field/id #uuid "3fd66964-e5bc-5721-9f6f-47ca70737690" :answer-field/key "If $A$ is *any*  $n\\times n$  matrix, then ${A}^{2}$ is always symmetric." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452990}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b61034ba-1f50-56d1-94b4-77e3ec4090fa" :question/math-academy-id "q-96596" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “If $A$ is a symmetric matrix, then $A+{A}^{2}$ is always symmetric” is true. If $A$ is symmetric, then ${A}^{2}$ is symmetric. And, since the sum to two symmetric matrices is symmetric, we have that\n\n$$\n\\begin{aligned}A+{A}^{2}\\end{aligned}\n$$\n\nis symmetric.\n\n- Statement “The product of *any* two $n\\times n$ matrices is always symmetric” is false. As a counterexample, consider the matrices \n\n$\\,$ $A=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement “If $A$ is *any*  $n\\times n$  matrix, then ${A}^{2}$ is always symmetric” is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, ${A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{2} & =\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the correct answer is “If $A$ is a symmetric matrix, then $A+{A}^{2}$ is always symmetric” only."} {:db/id #edb/ref 17592186360693 :knowledge-point/_questions [{:db/id #edb/ref 17592186166813 :knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30abb0c4-1bff-50f9-9fca-c00eba3cf9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422285} {:answer/id #uuid "ebe184a0-615a-5d44-a917-af918964b500" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422286}] :answer-field/correct {:answer/id #uuid "ebe184a0-615a-5d44-a917-af918964b500" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422286} :answer-field/id #uuid "2ba99938-250e-5ae5-bf0d-5fb8ffd0e043" :answer-field/key "${y}^{″}{x}^{3}-2y{y}^{′}=\\operatorname{sin}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422423} {:answer-field/choices [{:answer/id #uuid "18a407fa-f792-5416-9af8-1c23d1ca46fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422287} {:answer/id #uuid "d6eee552-87f0-587e-9972-7d671e2c86b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422288}] :answer-field/correct {:answer/id #uuid "d6eee552-87f0-587e-9972-7d671e2c86b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422288} :answer-field/id #uuid "d07ca297-62a7-5e03-8fea-27d8baa6b5a5" :answer-field/key "$3{y}^{″}{y}^{′}-2y=2{y}^{′}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422424} {:answer-field/choices [{:answer/id #uuid "ed3c95ff-45e3-5a8f-97c1-8b53553ad9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422289} {:answer/id #uuid "5ae2557d-e9db-57cc-b828-db6340b0d291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422290}] :answer-field/correct {:answer/id #uuid "ed3c95ff-45e3-5a8f-97c1-8b53553ad9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422289} :answer-field/id #uuid "6fb037b0-ed04-5067-99cf-fa5cc12a74f1" :answer-field/key "$4{y}^{‴}x-7{x}^{2}{y}^{′}=y{e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422425}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1054102-ae5b-5062-8507-4d26889215d7" :question/math-academy-id "q-96672" :question/problem "Which of the following are second-order ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "A differential equation is of second-order if the largest derivative term in the equation is ${y}^{″}.$\n\nKeeping this in mind, let's check each given equation.\n\n- Equation ${y}^{″}{x}^{3}-2y{y}^{′}=\\operatorname{sin}⁡x$ is a second-order differential equation. The highest derivative in this equation is ${y}^{″}.$\n\n- Equation $3{y}^{″}{y}^{′}-2y=2{y}^{′}$ is also a second-order differential equation. The highest derivative in this equation is ${y}^{″}.$\n\n- Equation $4{y}^{‴}x-7{x}^{2}{y}^{′}=y{e}^{x}$ is not a second-order differential equation. The highest derivative in this equation is ${y}^{‴},$ so this is a third-order differential equation.\n\nTherefore, the correct answer is ${y}^{″}{x}^{3}-2y{y}^{′}=\\operatorname{sin}⁡x$; $3{y}^{″}{y}^{′}-2y=2{y}^{′}$ only."} {:db/id #edb/ref 17592186360698 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c8c0cda-78bf-55f7-88e5-b25b198bc750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422315} {:answer/id #uuid "02410bef-7524-5134-a4f8-ebab62b11469" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422316 :task-item/_responses [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "02410bef-7524-5134-a4f8-ebab62b11469" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422316 :task-item/_responses [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "264fc7d0-805e-5bdb-83e7-23bd58448ad6" :answer-field/key "${y}^{′}=\\operatorname{sin}⁡(\\frac{y}{x})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422438} {:answer-field/choices [{:answer/id #uuid "447cd238-ce2a-5aa7-aa7b-1cd804b8d54f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422317} {:answer/id #uuid "a248c664-9709-57ad-a3ee-d65103a93863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422318 :task-item/_responses [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "a248c664-9709-57ad-a3ee-d65103a93863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422318 :task-item/_responses [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "661ef71b-f6a7-5216-a51b-7056fd0d53e9" :answer-field/key "${y}^{′}-{x}^{2}y={e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422439} {:answer-field/choices [{:answer/id #uuid "abdd71bd-d2a4-550e-bfe3-41eb169f5bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422319 :task-item/_responses [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "1ef1a9b6-6b2d-597b-9ef5-e76a8a9c1843" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422320}] :answer-field/correct {:answer/id #uuid "abdd71bd-d2a4-550e-bfe3-41eb169f5bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422319 :task-item/_responses [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "4aa5233b-2a0d-5987-9db1-ae437c736ff9" :answer-field/key "${y}^{′}-\\frac{3}{{y}^{2}}=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5388ae42-2792-5587-8853-f61a559c11a7" :question/math-academy-id "q-96711" :question/problem "Which of the following are **not** autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation ${y}^{′}=\\operatorname{sin}⁡(\\frac{y}{x})$ is *not* an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}-{x}^{2}y={e}^{x}$ is *not* an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}{y}^{′}-{x}^{2}y & ={e}^{x} \\\\ {y}^{′} & ={x}^{2}y+{e}^{x} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)={x}^{2}y+{e}^{x}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}-\\frac{3}{{y}^{2}}=1$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}{y}^{′}-\\frac{3}{{y}^{2}} & =1 \\\\ {y}^{′} & =\\frac{3}{{y}^{2}}+1 \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=\\frac{3}{{y}^{2}}+1.$\n\nTherefore, the correct answer is ${y}^{′}=\\operatorname{sin}⁡(\\frac{y}{x})$; ${y}^{′}-{x}^{2}y={e}^{x}$ only." :task-item/_content [{:db/id #edb/ref 17592186409282 :task-item/content {:db/id #edb/ref 17592186360698} :task-item/elapsed-seconds 121.771 :task-item/id #uuid "28c321c6-ba9e-4278-b202-3e62ead74695" :task-item/next {:db/id #edb/ref 17592186409283} :task-item/responses [{:answer/id #uuid "02410bef-7524-5134-a4f8-ebab62b11469" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422316} {:answer/id #uuid "a248c664-9709-57ad-a3ee-d65103a93863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422318} {:answer/id #uuid "abdd71bd-d2a4-550e-bfe3-41eb169f5bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422319}] :task-item/status {:db/id #edb/ref 17592186045571}}]} {:db/id #edb/ref 17592186360699 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b017fb70-0c5d-548a-9f29-f8c54647f96a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422327} {:answer/id #uuid "f1c9333b-f353-5073-a8ae-7603ecd03ae4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422328}] :answer-field/correct {:answer/id #uuid "b017fb70-0c5d-548a-9f29-f8c54647f96a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422327} :answer-field/id #uuid "4f6f0560-1c9e-5df2-9134-4ff3ff9b0077" :answer-field/key "${e}^{-y}{y}^{′}=-\\sqrt{y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422444} {:answer-field/choices [{:answer/id #uuid "05aaa1e5-c77a-5c69-9336-ba40efd3dca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422329} {:answer/id #uuid "ebc4734c-e2bd-5c34-bcd3-d7f463c81508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422330}] :answer-field/correct {:answer/id #uuid "ebc4734c-e2bd-5c34-bcd3-d7f463c81508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422330} :answer-field/id #uuid "a638c313-64c2-5397-bf14-121c910b5d46" :answer-field/key "${y}^{′}-{y}^{3}=2{e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422445} {:answer-field/choices [{:answer/id #uuid "82717268-aeb7-59c7-9ead-ed0bccb337be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422331} {:answer/id #uuid "7d4573cc-8220-585b-b628-542222050b7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422332}] :answer-field/correct {:answer/id #uuid "82717268-aeb7-59c7-9ead-ed0bccb337be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422331} :answer-field/id #uuid "8ec4389f-6741-54f0-af32-ea647439c22b" :answer-field/key "${y}^{′}-\\frac{2}{{y}^{3}}=3\\sqrt{y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83ac0667-a1bc-5ca7-903e-f359054c0435" :question/math-academy-id "q-96713" :question/problem "Which of the following are **not** autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation ${e}^{-y}{y}^{′}=-\\sqrt{y}$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}{e}^{-y}{y}^{′} & =-\\sqrt{y} \\\\ {y}^{′} & =-\\sqrt{y}{e}^{y} \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=-\\sqrt{y}{e}^{y}.$\n\n- Equation ${y}^{′}-{y}^{3}=2{e}^{x}$ is *not* an autonomous differential equation. If we isolate the derivative term, we get\n\n$$\n\\begin{aligned}{y}^{′}-{y}^{3} & =2{e}^{x} \\\\ {y}^{′} & ={y}^{3}+2{e}^{x} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)={y}^{3}+2{e}^{x}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}-\\frac{2}{{y}^{3}}=3\\sqrt{y}$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}{y}^{′}-\\frac{2}{{y}^{3}} & =3\\sqrt{y} \\\\ {y}^{′} & =\\frac{2}{{y}^{3}}+3\\sqrt{y} \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=\\frac{2}{{y}^{3}}+3\\sqrt{y}.$\n\nTherefore, the correct answer is ${y}^{′}-{y}^{3}=2{e}^{x}$ only."} {:db/id #edb/ref 17592186360700 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04341a8f-3a94-579e-8ed0-431601950988" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422333 :task-item/_responses [{:db/id #edb/ref 17592186569341 :task-item/content {:db/id #edb/ref 17592186360700} :task-item/status {:db/id #edb/ref 17592186045572}}]} {:answer/id #uuid "933327bb-2dcb-55ed-9335-b26ba314554c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422334}] :answer-field/correct {:answer/id #uuid "933327bb-2dcb-55ed-9335-b26ba314554c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422334} :answer-field/id #uuid "9936342f-6870-5e95-ba09-39e58aa96ef6" :answer-field/key "${y}^{′}=\\sqrt{{x}^{2}+\\operatorname{sin}⁡y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422447} {:answer-field/choices [{:answer/id #uuid "b8d5d5c0-2cef-5399-a6c1-f746b7828321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422335 :task-item/_responses [{:db/id #edb/ref 17592186569341 :task-item/content {:db/id #edb/ref 175921863607