id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470498} {:answer-field/choices [{:answer/id #uuid "6f687c01-7e57-5b27-83cd-fe8161fc79a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469774} {:answer/id #uuid "94a9724f-7830-5ca7-88a2-2feb8f9b31d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469775}] :answer-field/correct {:answer/id #uuid "6f687c01-7e57-5b27-83cd-fe8161fc79a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469774} :answer-field/id #uuid "257cf9ba-643d-5a9e-a3c0-437571a8a32b" :answer-field/key "$C=\\begin{bmatrix}\\frac{1}{2} & \\frac{2}{3} \\\\ \\frac{3}{4} & \\frac{1}{2}\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470499}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea1f03fd-61df-5261-a45a-0d8c938b6ee9" :question/math-academy-id "q-95346" :question/problem "Which of the following are orthogonal projection matrices?\n\nSelect all that apply." :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is an orthogonal projection matrix. Indeed,\n${A}^{T}=A$\nand\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{bmatrix}\\begin{bmatrix}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}5 & -10 \\\\ -10 & 20\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{bmatrix} \\\\  & =A.\\end{aligned}\n$$\n\n- $B$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{B}^{T}\\ne B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only.\""} {:db/id #edb/ref 17592186360597 :knowledge-point/_questions [{:db/id #edb/ref 17592186133791 :knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049489 :topic/id #uuid "f8e64c9f-51e4-540d-a7ed-38ccf90ff042" :topic/math-academy-id 2125 :topic/title "Projection Matrices, Linear Transformations and Their Properties"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d91dccf7-f768-50e6-8a72-b5da6c89a6dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469776} {:answer/id #uuid "d988b436-508d-5483-923d-6e920aead5b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469777}] :answer-field/correct {:answer/id #uuid "d91dccf7-f768-50e6-8a72-b5da6c89a6dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469776} :answer-field/id #uuid "4cb60a94-72a5-5abf-a80d-5254f6849783" :answer-field/key "$A=\\begin{bmatrix}2 & -1 \\\\ -1 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470500} {:answer-field/choices [{:answer/id #uuid "cc5b511c-8e27-53d7-8170-a24e73154bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469778} {:answer/id #uuid "d87b13c6-a7c9-52cc-8e0f-17793de6e654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469779}] :answer-field/correct {:answer/id #uuid "d87b13c6-a7c9-52cc-8e0f-17793de6e654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469779} :answer-field/id #uuid "e20ce85b-3034-5756-bb6e-2ec399fa2ad5" :answer-field/key "$B=\\begin{bmatrix}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470501} {:answer-field/choices [{:answer/id #uuid "0b734095-0a53-5925-9d7d-535a13104c4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469780} {:answer/id #uuid "05d4aa39-5d9e-5f04-85c9-616f65a4e8ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469781}] :answer-field/correct {:answer/id #uuid "0b734095-0a53-5925-9d7d-535a13104c4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469780} :answer-field/id #uuid "aa635a58-22e5-54c4-818a-1265728bed9d" :answer-field/key "$C=\\begin{bmatrix}3 & 2 \\\\ 2 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470502}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3f5c5d3-e02d-5016-8de5-5fb09c5bfb03" :question/math-academy-id "q-95351" :question/problem "Which of the following are orthogonal projection matrices?\n\nSelect all that apply." :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n${A}^{T}=A$\nbut \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}2 & -1 \\\\ -1 & 3\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -5 \\\\ -5 & 10\\end{bmatrix} \\\\  & \\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. Indeed,\n${B}^{T}=B$\nand\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{bmatrix}\\begin{bmatrix}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}9 & -3 \\\\ -3 & 1\\end{bmatrix}\\cdot \\frac{1}{10}\\begin{bmatrix}9 & -3 \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\frac{1}{100}\\begin{bmatrix}9 & -3 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}9 & -3 \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\frac{1}{100}\\begin{bmatrix}90 & -30 \\\\ -30 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{bmatrix} \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n${C}^{T}=C$\nbut \n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}3 & 2 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}3 & 2 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}13 & 4 \\\\ 4 & 5\\end{bmatrix} \\\\  & \\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\""} {:db/id #edb/ref 17592186360598 :knowledge-point/_questions [{:db/id #edb/ref 17592186133791 :knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049489 :topic/id #uuid "f8e64c9f-51e4-540d-a7ed-38ccf90ff042" :topic/math-academy-id 2125 :topic/title "Projection Matrices, Linear Transformations and Their Properties"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b15702d8-832c-5c42-9e03-35bd6362356e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469782} {:answer/id #uuid "a8c4e376-6efd-522b-8eb7-f7615e94db55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469783}] :answer-field/correct {:answer/id #uuid "b15702d8-832c-5c42-9e03-35bd6362356e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469782} :answer-field/id #uuid "974cd089-5644-58e6-a817-3fcd5bd1e784" :answer-field/key "$A=\\begin{bmatrix}\\frac{4}{13} & \\frac{6}{13} \\\\ -\\frac{6}{13} & \\frac{4}{13}\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470503} {:answer-field/choices [{:answer/id #uuid "03864ad4-b006-5fc9-8fa0-0354cf3608d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469784} {:answer/id #uuid "0104f927-d60f-53d4-8da5-b850cb12b81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469785}] :answer-field/correct {:answer/id #uuid "0104f927-d60f-53d4-8da5-b850cb12b81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469785} :answer-field/id #uuid "8e4c9dc5-f54d-5159-9354-74e7c37cd4fe" :answer-field/key "$B=\\begin{bmatrix}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470504} {:answer-field/choices [{:answer/id #uuid "e8b1894b-ee6f-56ab-bc55-9c3a60a64104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text}