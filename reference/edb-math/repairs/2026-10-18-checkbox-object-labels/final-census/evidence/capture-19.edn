99 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451950}] :answer-field/correct {:answer/id #uuid "987ede55-9e0a-5c9e-a319-1a36132d579d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451949} :answer-field/id #uuid "b1ed07e9-82f1-5742-b787-39c3cf681ca5" :answer-field/key "$B$ is a subspace of ${R}_{4}[t]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452822} {:answer-field/choices [{:answer/id #uuid "93a3d06d-65b8-5f91-bea1-f18a578082de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451951} {:answer/id #uuid "a313f47f-ca10-53a1-9a2a-d1d4ce6e1e06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451952}] :answer-field/correct {:answer/id #uuid "a313f47f-ca10-53a1-9a2a-d1d4ce6e1e06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451952} :answer-field/id #uuid "bb9df4a2-322a-5195-a606-da4b70804b8b" :answer-field/key "$B$ is **not** a subspace of ${R}_{4}[t]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec5fca83-ae3c-5f26-9292-3c61fcf8876c" :question/math-academy-id "q-94615" :question/problem "Consider the vector space ${R}_{4}[t]$ of all polynomials in the variable $t$ of degree at most $4,$ and its subset $B=\\{p(t)\\in {R}_{4}[t]\\,|\\,p(0)=1\\}.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “$B$ is closed under polynomial addition” is false. For example, if $f(0)=g(0)=1,$ then\n\n$$\n\\begin{aligned}f(0)+g(0) & =1+1 \\\\  & =2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement “$B$ is closed under scalar multiplication” is false. For example, if $f(0)=1$ and $k=2,$ then \n\n$$\n\\begin{aligned}kf(0) & =1\\cdot 2=2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement “$B$ is a subspace of ${R}_{4}[t]$” is false, while statement “$B$ is **not** a subspace of ${R}_{4}[t]$” is true. $B$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is “$B$ is **not** a subspace of ${R}_{4}[t]$” only."} {:db/id #edb/ref 17592186360461 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907 :topic/title "Subspaces of Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9082d0ca-6137-5774-b9e3-7f0e4a8c73a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451953} {:answer/id #uuid "8be89cec-384b-5bff-8e16-25e2f4a93c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451954}] :answer-field/correct {:answer/id #uuid "8be89cec-384b-5bff-8e16-25e2f4a93c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451954} :answer-field/id #uuid "461e025f-c84f-5898-8bdf-b600f8c7383d" :answer-field/key "$E$ is closed under matrix 