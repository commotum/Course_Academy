uuid "748a6989-6b95-540d-a99c-327fc633c873" :question/math-academy-id "q-96827" :question/problem "Which of the following is the correct interpretation of $g:[0,2]\\to {0,2}?$\n\nSelect all that apply." :question/worked-solution "The notation \n\n$$\ng:[0,2]\\to {0,2}\n$$\n\nmeans that the function $g$ maps the set $[0,2]$ to the set ${0,2}.$ In this case,\n\n- the domain of $g$ is $[0,2],$ and\n\n- the codomain of $g$ is ${0,2}.$ Note that this is *not* necessarily the range.\n\nAs a result, statements “The domain of $g$ is ${0,2}$” and “The range of $g$ is $[0,2]$” are false, while statement “The codomain of $g$ is ${0,2}$” is true.\n\nTherefore, the correct answer is “The codomain of $g$ is ${0,2}$” only."} {:db/id #edb/ref 17592186360719 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14bda835-3f7e-5acf-b18b-2e089087e07c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469860} {:answer/id #uuid "42cb668d-98a9-520e-b1e1-4fe002c1b694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469861}] :answer-field/correct {:answer/id #uuid "42cb668d-98a9-520e-b1e1-4fe002c1b694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469861} :answer-field/id #uuid "01e0a5d5-4c50-525a-89e6-5d597c736b28" :answer-field/key "The domain of $f$ is ${5,10,15}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470542} {:answer-field/choices 