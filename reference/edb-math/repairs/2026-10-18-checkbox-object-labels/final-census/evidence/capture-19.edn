/value "false" :db/id #edb/ref 17592186469678} {:answer/id #uuid "c7b3920e-c0f7-5a98-ac0a-e6120f9c52d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469679}] :answer-field/correct {:answer/id #uuid "e5a63cd7-c1d9-5588-9330-fe1036e53e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469678} :answer-field/id #uuid "431b9dde-c58c-5f17-a803-fb9e8caef06e" :answer-field/key "$V=\\begin{bmatrix}1 & -3 \\\\ -3 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470451}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d6f7f1-c1fb-5ae2-b8f7-98ecf5b306a1" :question/math-academy-id "q-94062" :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Recall that every quadratic form defined on ${R}^{3}$ has an associated $3\\times 3$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $T$ could be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $U$ could also be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $V$ *cannot* be a matrix of a quadratic form defined on ${R}^{3}$ since it's a $2\\times 2$ matrix (not $3\\times 3$).\n\nTherefore, the correct answer is \"$T$ and $U$ only.\""} {:db/id #edb/ref 17592186357641 :knowledge-point/_questions [{:db/id #edb/ref 17592186161984 :knowledge-point/id #uuid "e62e458d-0724-5dbe-b448-b79404f279f9" :knowledge-point/title "Identifying Matrices of Quadratic Forms" :topic/_knowledge-points [{:db/id #edb/ref 17592186049450 :topic/id #uuid "f66a029b-c648-5d01-a90b-9ef34d0631d3" :topic/math-academy-id 3123 :topic/title "Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "276e7784-3f27-5f16-857d-565398b07228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469680} {:answer/id #uuid "8c5031f6-651d-54a5-875f-0765312ac751" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469681}] :answer-field/correct {:answer/id #uuid "276e7784-3f27-5f16-857d-565398b07228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469680} :answer-field/id #uuid "aaf3a840-0c3e-54a1-a75f-fef852021152" :answer-field/key "$D=\\begin{bmatrix}3 & 1 & 3 & 0 \\\\ 1 & 5 & 1 & -2 \\\\ 3 & 1 & -2 & 2 \\\\ 0 & -4 & 2 & 7\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470452} {:answer-field/choices [{:answer/id #uuid "1c5ba6a4-f5a4-5d3c-9783-20a15cdf47fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469682} {:answer/id #uuid "bd4c060c-f0ed-573f-9f2e-325a2e5ab7da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469683}] :answer-field/correct {:answer/id #uuid "1c5ba6a4-f5a4-5d3c-9783-20a15cdf47fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469682} :answer-field/id #uuid "f59b0a79-de63-5dfc-b585-7bed00e3a9b0" :answer-field/key "$E=\\begin{bmatrix}7 & 1 \\\\ 1 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470453} {:answer-field/choices [{:answer/id #uuid "5b9e0823-8dcb-5fde-8a80-d56b3d3c5c13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469684} {:answer/id #uuid "7d60c142-4a85-5115-8734-c4470d6fadb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469685}] :answer-field/correct {:answer/id #uuid "7d60c142-4a85-5115-8734-c4470d6fadb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469685} :answer-field/id #uuid "e58d9eb0-2376-5e45-b12e-a50de55ab094" :answer-field/key "$F=\\begin{bmatrix}1 & 2 & 3 & 6 \\\\ 2 & 5 & 4 & -1 \\\\ 3 & 4 & -2 & 2 \\\\ 6 & -1 & 2 & 7\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470454}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61630213-687e-509d-b369-4384ce08371c" :question/math-academy-id "q-94063" :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{4}?$\n\nSelect all that apply." :question/worked-solution "Recall that every quadratic form defined on ${R}^{4}$ has an associated $4\\times 4$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $D$ *cannot* be a matrix of a quadratic form defined on ${R}^{4}.$ Although it's a $4\\times 4$ matrix, $D$ is not symmetric since ${d}_{24}\\ne {d}_{42}.$\n\n- $E$ *cannot* be a matrix of a quadratic form defined on ${R}^{4}$ since it's a $2\\times 2$ matrix (not $4\\times 4$).\n\n- $F$ could be a matrix of a quadratic form defined on ${R}^{4}$ since it is a $4\\times 4$ symmetric matrix.\n\nTherefore, the correct answer is \"$F$ only.\""} {:db/id #edb/ref 17592186357712 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91cc05c9-21e6-5e57-ab36-d1e4df3c1b68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469686} {:answer/id #uuid "768d503e-91ff-5b08-aeae-dda02d324c1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469687}] :answer-field/correct {:answer/id #uuid "91cc05c9-21e6-5e57-ab36-d1e4df3c1b68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469686} :answer-field/id #uuid "683d9c93-8fa5-5d1a-98f2-20d68cd20554" :answer-field/key "$y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470455} {:answer-field/choices [{:answer/id #uuid "54fdca8a-daf1-5068-9ae9-279b847a3c10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469688} {:answer/id #uuid "6e0e45cd-9729-5b3a-98b9-20bb12012d86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469689}] :answer-field/correct {:answer/id #uuid "54fdca8a-daf1-5068-9ae9-279b847a3c10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469688} :answer-field/id #uuid "ac2ab10a-f022-5c38-8a87-3bfd67d0c187" :answer-field/key "$y=R\\operatorname{tan}⁡(2t+{ϕ}_{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470456} {:answer-field/choices [{:answer/id #uuid "d6699d8e-9150-5a70-b4dc-ca5c4bf1ec18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469690} {:answer/id #uuid "21d5c538-57b2-5322-8c9a-786a358047e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469691}] :answer-field/correct {:answer/id #uuid "21d5c538-57b2-5322-8c9a-786a358047e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469691} :answer-field/id #uuid "3688a682-49fd-5cdc-b69d-7a273c82d6dc" :answer-field/key "$y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b779ea2-64c9-5921-9b3e-0c6d8313380f" :question/math-academy-id "q-94275" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+4y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants.\n\nSelect all that apply." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n1\\. $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n2\\. $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n3\\. $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=4\\,⟹\\,\\omega =2.\n$$\n\nThus, we have:\n\n1\\. $y=R\\operatorname{cos}⁡(2t+{ϕ}_{1})$\n\n2\\. $y=R\\operatorname{sin}⁡(2t+{ϕ}_{2})$\n\n3\\. $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$\n\nTherefore, only function $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$ could be used to represent $y(t).$"} {:db/id #edb/ref 17592186357713 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad2732d-69c4-58f7-a030-9480b5996e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469692} {:answer/id #uuid "69b705cb-b59f-52e9-becb-0449feb134d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469693}] :answer-field/correct {:answer/id #uuid "69b705cb-b59f-52e9-becb-0449feb134d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469693} :answer-field/id #uuid "6ecc5cf1-fd33-54bd-a9b6-52159bbfb77b" :answer-field/key "$y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470458} {:answer-field/choices [{:answer/id #uuid "8e486e67-136c-5f23-a046-eac73e44bc12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469694} {:answer/id #uuid "c3d68160-8c63-5214-9a73-525ffab0890b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469695}] :answer-field/correct {:answer/id #uuid "c3d68160-8c63-5214-9a73-525ffab0890b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469695} :answer-field/id #uuid "4ddcdebe-f528-5f7e-8339-afd49564c830" :answer-field/key "$y=R\\operatorname{sin}⁡(4t+{ϕ}_{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470459} {:answer-field/choices [{:answer/id #uuid "8340b1ea-d19d-5867-beea-5ece4a646047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469696} {:answer/id #uuid "6418afea-2aff-5470-8cd8-97afc5b4b6ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469697}] :answer-field/correct {:answer/id #uuid "8340b1ea-d19d-5867-beea-5ece4a646047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469696} :answer-field/id #uuid "8c9a9501-aa24-5bf0-b66c-51ecefe82cb3" :answer-field/key "$y=A\\operatorname{cos}⁡16t+B\\operatorname{sin}⁡16t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "784be4fd-7d61-5b65-af33-15597c14ae36" :question/math-academy-id "q-94276" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+16y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants.\n\nSelect all that apply." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=16\\,⟹\\,\\omega =4.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(4t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t$\n\nTherefore, only functions $y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$ and $y=R\\operatorname{sin}⁡(4t+{ϕ}_{2})$ could be used to represent $y(t).$"} {:db/id #edb/ref 17592186357717 :knowledge-point/_questions [{:db/id #edb/ref 17592186147432 :knowledge-point/id #uuid "a459ec25-988e-5f91-8c25-2b7b81b6b6ee" :knowledge-point/title "Identifying Properties of a Mass-Spring System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e20bb352-8798-5219-b654-623357df644c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451899} {:answer/id #uuid "a6004465-ae7d-59c8-806f-2866bb916848" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451900}] :answer-field/correct {:answer/id #uuid "e20bb352-8798-5219-b654-623357df644c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451899} :answer-field/id #uuid "fc542675-dd46-5683-afc4-6c9bb8629ebe" :answer-field/key "The governing differential equation is ${y}^{″}+\\frac{1}{4}y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452797} {:answer-field/choices [{:answer/id #uuid "372b0b95-a59f-563d-9630-745c738700e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451901} {:answer/id #uuid "d17fb8d0-e7d2-5ca7-b6c3-b47f98ebca5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451902}] :answer-field/correct {:answer/id #uuid "372b0b95-a59f-563d-9630-745c738700e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451901} :answer-field/id #uuid "b928d863-ca43-5ecd-b2ec-156c93fbb974" :answer-field/key "The frequency $f$ of the oscillation is $f=\\frac{2}{\\pi }\\,{\\text{s}}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452798} {:answer-field/choices [{:answer/id #uuid "aa9d8b21-4783-5ada-a5a1-249a2982a947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451903} {:answer/id #uuid "9e4582d3-b5d4-568a-8c7f-88ee00ab3f48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451904}] :answer-field/correct {:answer/id #uuid "9e4582d3-b5d4-568a-8c7f-88ee00ab3f48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451904} :answer-field/id #uuid "b378b982-cafe-5b13-ac67-c1e2b582eb1a" :answer-field/key "The general solution can be expressed as $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$ where $R$ is the amplitude and $ϕ$ is the phase" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452799}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "21aff269-b5d0-5ff1-9c3e-386be14a7e91" :question/math-academy-id "q-94287" :question/problem "A particle of mass $6\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=24\\,{\\text{kg/s}}^{2}.$ The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. \n\nIf the particle moves with simple harmonic motion, then which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's look at each statement in turn.\n\n- The equation of motion for a particle of mass $m$ moving with simple harmonic motion (SHM) under the action of a spring with spring constant $k$ is given by\n\n$$\nm{y}^{″}=-ky.\n$$\n\nRearranging the above equation gives\n\n$$\n{y}^{″}+\\frac{k}{m}y=0.\n$$\n\nComparing this to the SHM equation \n\n$$\n{y}^{″}+{\\omega }^{2}y=0,\n$$\n\nwe see that\n\n$$\n{\\omega }^{2}=\\frac{k}{m}.\n$$\n\nSubstituting our values for $k$ and $m$ gives\n\n$$\n{\\omega }^{2}=\\frac{24}{6}=4\\,⟹\\,\\omega =2.\n$$\n\nSo the governing differential equation is\n\n$$\n{y}^{″}+4y=0.\n$$\n\nHence, statement “The governing differential equation is ${y}^{″}+\\frac{1}{4}y=0$” is false.\n\n- The frequency $f$ (measured in ${s}^{-1}$) is given by\n\n$$\nf=\\frac{1}{T}=\\frac{\\omega }{2\\pi },\n$$\n\nwhere $T$ is the period. So in our case, we have\n\n$$\nf=\\frac{2}{2\\pi }=\\frac{1}{\\pi }\\,.\n$$\n\nSo the frequency $f=\\frac{1}{\\pi }\\,{\\text{s}}^{-1}.$\nHence, statement “The frequency $f$ of the oscillation is $f=\\frac{2}{\\pi }\\,{\\text{s}}^{-1}$” is false.\n\n- The general solution for $y(t)$ can take one of three forms.\n\n- $A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\n- $R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\nWriting $\\omega =2$ in form 1 gives\n\n$$\ny(t)=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t.\n$$\n\nHence, statement “The general solution can be expressed as $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$ where $R$ is the amplitude and $ϕ$ is the phase” is true.\n\nSo, the correct answer is “The general solution can be expressed as $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$ where $R$ is the amplitude and $ϕ$ is the phase” only."} {:db/id #edb/ref 17592186357718 :knowledge-point/_questions [{:db/id #edb/ref 17592186147432 :knowledge-point/id #uuid "a459ec25-988e-5f91-8c25-2b7b81b6b6ee" :knowledge-point/title "Identifying Properties of a Mass-Spring System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f29c74d-4e14-5a24-9683-ca67874f9d9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451905} {:answer/id #uuid "9fa81a14-0980-5d4c-8e00-12da53182396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451906}] :answer-field/correct {:answer/id #uuid "9fa81a14-0980-5d4c-8e00-12da53182396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451906} :answer-field/id #uuid "c84cb828-9a1a-5639-b4d9-d43a955bd3fe" :answer-field/key "The governing differential equation is ${y}^{″}+3y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452800} {:answer-field/choices [{:answer/id #uuid "de19cc85-076b-5377-9445-ebde1b72e493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451907} {:answer/id #uuid "977a2f5b-333e-55c8-8da3-ad1a628caac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451908}] :answer-field/correct {:answer/id #uuid "de19cc85-076b-5377-9445-ebde1b72e493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451907} :answer-field/id #uuid "3ea20260-a271-5a10-a832-9ccf49b5a917" :answer-field/key "The frequency $f$ of the oscillation is $f=\\frac{3}{2\\pi }\\,{\\text{s}}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452801} {:answer-field/choices [{:answer/id #uuid "cd46bc35-f774-5fe1-bea5-72f5ef16cda9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451909} {:answer/id #uuid "474438b9-96d0-5310-a09f-25adb3dfb41b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451910}] :answer-field/correct {:answer/id #uuid "cd46bc35-f774-5fe1-bea5-72f5ef16cda9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451909} :answer-field/id #uuid "7dc124a8-736f-53ee-8bc6-a7ac01651b4e" :answer-field/key "The general solution can be expressed as $y=R\\operatorname{cos}⁡(3t+ϕ),$ where $R$ is the amplitude and $ϕ$ is the phase." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452802}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "de4a4e60-2947-5dae-80ca-6bd02414f29e" :question/math-academy-id "q-94288" :question/problem "A particle of mass $7\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=21\\,{\\text{kg/s}}^{2}.$ The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. \n\nIf the particle moves with simple harmonic motion, then which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's look at each statement in turn.\n\n- The equation of motion for a particle of mass $m$ moving with simple harmonic motion (SHM) under the action of a spring with spring constant $k$ is given by\n\n$$\nm{y}^{″}=-ky.\n$$\n\nRearranging the above equation gives\n\n$$\n{y}^{″}+\\frac{k}{m}y=0.\n$$\n\nComparing this to the SHM equation \n\n$$\n{y}^{″}+{\\omega }^{2}y=0,\n$$\n\nwe see that\n\n$$\n{\\omega }^{2}=\\frac{k}{m}.\n$$\n\nSubstituting our values for $k$ and $m$ gives\n\n$$\n{\\omega }^{2}=\\frac{21}{7}=3\\,⟹\\,\\omega =\\sqrt{3}.\n$$\n\nSo the governing differential equation is\n\n$$\n{y}^{″}+3y=0.\n$$\n\nHence, statement “The governing differential equation is ${y}^{″}+3y=0$” is true.\n\n- The frequency $f$ (measured in ${s}^{-1}$) is given by\n\n$$\nf=\\frac{1}{T}=\\frac{\\omega }{2\\pi },\n$$\n\nwhere $T$ is the period. So in our case, we have\n\n$$\nf=\\frac{\\sqrt{3}}{2\\pi }\\,.\n$$\n\nSo the frequency $f=\\frac{\\sqrt{3}}{2\\pi }\\,{\\text{s}}^{-1}.$\nHence, statement “The frequency $f$ of the oscillation is $f=\\frac{3}{2\\pi }\\,{\\text{s}}^{-1}$” is false.\n\n- The general solution for $y(t)$ can take one of three forms.\n\n- $A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\n- $R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\nWriting $\\omega =\\sqrt{3}$ and ${ϕ}_{1}=ϕ$ in form 2 gives\n\n$$\ny(t)=R\\operatorname{cos}⁡(\\sqrt{3}t+ϕ).\n$$\n\nHence, statement “The general solution can be expressed as $y=R\\operatorname{cos}⁡(3t+ϕ),$ where $R$ is the amplitude and $ϕ$ is the phase” is false.\n\nSo, the correct answer is “The governing differential equation is ${y}^{″}+3y=0$” only."} {:db/id #edb/ref 17592186357722 :knowledge-point/_questions [{:db/id #edb/ref 17592186147445 :knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c" :knowledge-point/title "Identifying Types of Damped Oscillations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048291 :topic/id #uuid "91890390-2801-5fd4-8f87-a9c37f742926" :topic/math-academy-id 2525 :topic/title "Damped Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36ac6cdc-2746-5b43-bd9a-71f9e2b88f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451911} {:answer/id #uuid "a6a60923-dd24-5397-8514-f00555707a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451912}] :answer-field/correct {:answer/id #uuid "a6a60923-dd24-5397-8514-f00555707a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451912} :answer-field/id #uuid "882b1b0e-7667-58fa-a610-b29f39cea8f0" :answer-field/key "${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452803} {:answer-field/choices [{:answer/id #uuid "e8dc9b38-8d8b-526d-8109-de5a6641a5fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451913} {:answer/id #uuid "767cb5ef-5c58-5fa0-86e4-07da2cc8995b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451914}] :answer-field/correct {:answer/id #uuid "e8dc9b38-8d8b-526d-8109-de5a6641a5fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451913} :answer-field/id #uuid "1f567160-672e-57ca-8d2a-ce2f2ac2cef7" :answer-field/key "${y}^{″}+6{y}^{′}+9y=0$ represents an oscillator undergoing light damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452804} {:answer-field/choices [{:answer/id #uuid "411455db-fa35-5440-b800-17f849ed6393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451915} {:answer/id #uuid "90a5c468-08a8-52b4-a291-d994b5c9ea87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451916}] :answer-field/correct {:answer/id #uuid "411455db-fa35-5440-b800-17f849ed6393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451915} :answer-field/id #uuid "63875c8e-e107-53d2-b46a-269a684f3997" :answer-field/key "${y}^{″}+7{y}^{′}+4y=0$ represents an oscillator undergoing critical  damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452805}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8e4b9d3-5113-5f39-9a2d-eee9d1949dd0" :question/math-academy-id "q-94310" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+3{y}^{′}+2y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+3\\lambda +2=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(2) & =1>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement “${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping” is true.\n\n- The differential equation ${y}^{″}+6{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+6\\lambda +9=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(9) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement “${y}^{″}+6{y}^{′}+9y=0$ represents an oscillator undergoing light damping” is false.\n\n- The differential equation ${y}^{″}+7{y}^{′}+4y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+7\\lambda +4=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={7}^{2}-4(1)(4) & =33>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement “${y}^{″}+7{y}^{′}+4y=0$ represents an oscillator undergoing critical  damping” is false.\n\nIn conclusion, the correct answer is “${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping” only."} {:db/id #edb/ref 17592186357723 :knowledge-point/_questions [{:db/id #edb/ref 17592186147445 :knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c" :knowledge-point/title "Identifying Types of Damped Oscillations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048291 :topic/id #uuid "91890390-2801-5fd4-8f87-a9c37f742926" :topic/math-academy-id 2525 :topic/title "Damped Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b173ff0-9b1a-5c3a-9553-9e2122b40871" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451917} {:answer/id #uuid "0da075d0-9182-5b2b-a41c-1a2c5f285c26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451918}] :answer-field/correct {:answer/id #uuid "0da075d0-9182-5b2b-a41c-1a2c5f285c26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451918} :answer-field/id #uuid "47c53b5b-9481-53c7-8ced-5646f548a0a3" :answer-field/key "${y}^{″}+6{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452806} {:answer-field/choices [{:answer/id #uuid "6e660c83-18f6-55ad-8e5a-5e4aecb8546a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451919} {:answer/id #uuid "0cd25faa-e362-5233-be6b-98f26578eed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451920}] :answer-field/correct {:answer/id #uuid "0cd25faa-e362-5233-be6b-98f26578eed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451920} :answer-field/id #uuid "ecd5099b-4d00-56e1-9017-fb47c78b0397" :answer-field/key "${y}^{″}+5{y}^{′}+7y=0$ represents an oscillator undergoing light damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452807} {:answer-field/choices [{:answer/id #uuid "6f62fad2-48d0-5e14-b686-4024f93cdd85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451921} {:answer/id #uuid "5df8d53d-dfe7-5e8b-88a3-63034b3e0dea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451922}] :answer-field/correct {:answer/id #uuid "5df8d53d-dfe7-5e8b-88a3-63034b3e0dea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451922} :answer-field/id #uuid "af024238-6d48-5b5d-9c32-077d25b27679" :answer-field/key "${y}^{″}+8{y}^{′}+16y=0$ represents an oscillator undergoing critical  damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6276abb-11ab-5f2c-8db5-0bce52daa784" :question/math-academy-id "q-94311" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+6{y}^{′}+2y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+6\\lambda +2=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(2) & =28>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement “${y}^{″}+6{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping” is true.\n\n- The differential equation ${y}^{″}+5{y}^{′}+7y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+5\\lambda +7=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={5}^{2}-4(1)(7) & =-3<0.\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement “${y}^{″}+5{y}^{′}+7y=0$ represents an oscillator undergoing light damping” is true.\n\n- The differential equation ${y}^{″}+8{y}^{′}+16y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+8\\lambda +16=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={8}^{2}-4(1)(16) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement “${y}^{″}+8{y}^{′}+16y=0$ represents an oscillator undergoing critical  damping” is true.\n\nIn conclusion, the correct answer is “${y}^{″}+6{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping”; “${y}^{″}+5{y}^{′}+7y=0$ represents an oscillator undergoing light damping”; “${y}^{″}+8{y}^{′}+16y=0$ represents an oscillator undergoing critical  damping”."} {:db/id #edb/ref 17592186357725 :knowledge-point/_questions [{:db/id #edb/ref 17592186147445 :knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c" :knowledge-point/title "Identifying Types of Damped Oscillations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048291 :topic/id #uuid "91890390-2801-5fd4-8f87-a9c37f742926" :topic/math-academy-id 2525 :topic/title "Damped Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53de5ded-23d5-55c8-8884-b03526582d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451923} {:answer/id #uuid "7c35f2dc-f07b-558e-bcf3-3c066e4bc3de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451924}] :answer-field/correct {:answer/id #uuid "53de5ded-23d5-55c8-8884-b03526582d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451923} :answer-field/id #uuid "20e6f6cd-514c-5d2d-9493-8ffb1b208ac7" :answer-field/key "${y}^{″}+2\\sqrt{2}{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452809} {:answer-field/choices [{:answer/id #uuid "b55fb9c1-8a6c-5c21-822d-827fa601b334" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451925} {:answer/id #uuid "7012f647-686b-549d-95ea-28b63df40ce5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451926}] :answer-field/correct {:answer/id #uuid "b55fb9c1-8a6c-5c21-822d-827fa601b334" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451925} :answer-field/id #uuid "8c2e27ac-b0cb-501f-90af-a6959a3c6fea" :answer-field/key "${y}^{″}+7{y}^{′}+9y=0$ represents an oscillator undergoing critical damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452810} {:answer-field/choices [{:answer/id #uuid "9ee00260-8ec8-56fa-b977-042d2f9b4fdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451927} {:answer/id #uuid "9f743705-cc30-5472-8400-083503618e03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451928}] :answer-field/correct {:answer/id #uuid "9f743705-cc30-5472-8400-083503618e03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451928} :answer-field/id #uuid "04168311-44b1-568c-9fa9-f5e84100bb98" :answer-field/key "${y}^{″}+7{y}^{′}+14y=0$ represents an oscillator undergoing light damping" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2840cb37-803e-5355-a4ea-a188990899c3" :question/math-academy-id "q-94313" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+2\\sqrt{2}{y}^{′}+2y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+2\\sqrt{2}\\lambda +2=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D=(2\\sqrt{2})^{2}-4(1)(2) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement “${y}^{″}+2\\sqrt{2}{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping” is false.\n\n- The differential equation ${y}^{″}+7{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+7\\lambda +9=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={7}^{2}-4(1)(9) & =13>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement “${y}^{″}+7{y}^{′}+9y=0$ represents an oscillator undergoing critical damping” is false.\n\n- The differential equation ${y}^{″}+7{y}^{′}+14y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+7\\lambda +14=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={7}^{2}-4(1)(14) & =-7<0.\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement “${y}^{″}+7{y}^{′}+14y=0$ represents an oscillator undergoing light damping” is true.\n\nIn conclusion, the correct answer is “${y}^{″}+7{y}^{′}+14y=0$ represents an oscillator undergoing light damping” only."} {:db/id #edb/ref 17592186357736 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97ea5463-bea1-5eaf-bc15-3836a5ba47fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469698} {:answer/id #uuid "07fd1def-dfaa-5ec4-ae66-bd968103e02f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469699}] :answer-field/correct {:answer/id #uuid "07fd1def-dfaa-5ec4-ae66-bd968103e02f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469699} :answer-field/id #uuid "7c1229eb-a220-5d64-9dde-8d4198484535" :answer-field/key "$y=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470461} {:answer-field/choices [{:answer/id #uuid "e48f9942-dc1d-5bfd-8c7e-fffcfc58f5c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469700} {:answer/id #uuid "cd7c7638-d189-5ef7-8aee-3f80c8472788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469701}] :answer-field/correct {:answer/id #uuid "e48f9942-dc1d-5bfd-8c7e-fffcfc58f5c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469700} :answer-field/id #uuid "b8f4b973-4fd4-5ee7-97b7-671e55562e4d" :answer-field/key "$y=R\\operatorname{sin}⁡(t+ϕ)+2t\\operatorname{sin}⁡t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470462} {:answer-field/choices [{:answer/id #uuid "35c12017-b6ff-5bed-a4ab-944b10eb21be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469702} {:answer/id #uuid "62d36b84-29c6-5fca-991c-d87a064eec38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469703}] :answer-field/correct {:answer/id #uuid "35c12017-b6ff-5bed-a4ab-944b10eb21be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469702} :answer-field/id #uuid "9ef40f75-93cb-5ffc-a30d-cf9bc3956155" :answer-field/key "$y$ $=A\\operatorname{cos}⁡t$ $+B\\operatorname{sin}⁡t$ $-2t\\operatorname{cos}⁡t$ $+t\\operatorname{sin}⁡t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470463}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feaf4026-120d-5dc5-a147-ce0975029f64" :question/math-academy-id "q-94376" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+y=2\\operatorname{sin}⁡t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution to this equation is the sum of the complementary function and a particular solution.\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$\nIt can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=1\\,⟹\\,\\omega =1.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=t(\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t).\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =-1$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=-t\\operatorname{cos}⁡t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n\n- ${y}_{c}=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t$\n\nOnly $y=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$ matches the forms above. Therefore, the correct answer is $y=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$ only."} {:db/id #edb/ref 17592186357737 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edd47e7d-f7e3-5d97-920b-4415df8afc73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469704} {:answer/id #uuid "b1947615-a621-5c38-a8b2-65f39eb8f335" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469705}] :answer-field/correct {:answer/id #uuid "edd47e7d-f7e3-5d97-920b-4415df8afc73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469704} :answer-field/id #uuid "8ace747d-85b7-53e5-9b79-77234909c714" :answer-field/key "$y=R\\operatorname{cos}⁡(2t+ϕ)+16t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470464} {:answer-field/choices [{:answer/id #uuid "b7714d7d-abaa-5ea7-a556-ace61b6af7f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469706} {:answer/id #uuid "ba17faad-e264-5d00-9e6e-97a82564376d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469707}] :answer-field/correct {:answer/id #uuid "ba17faad-e264-5d00-9e6e-97a82564376d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469707} :answer-field/id #uuid "5f5d49b4-18b3-5548-b0aa-1dd4be52ea6e" :answer-field/key "$y=R\\operatorname{sin}⁡(4t+ϕ)+2t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470465} {:answer-field/choices [{:answer/id #uuid "28bd472a-6d85-58a8-8448-7f1562ef06d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469708} {:answer/id #uuid "8d5eaa3c-7699-5df1-8c11-cb3fcbeed6f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469709}] :answer-field/correct {:answer/id #uuid "28bd472a-6d85-58a8-8448-7f1562ef06d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469708} :answer-field/id #uuid "60fcc67d-062a-5c14-a57e-7491a704df6b" :answer-field/key "$y=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡2t+8t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91ea3a27-d7dd-5526-bebd-b64e4b8069b6" :question/math-academy-id "q-94377" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+16y=32t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$ It can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=16\\,⟹\\,\\omega =4.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(4t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(4t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a linear function, we assume that the particular solution is also a linear function,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =2$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=2t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & =R\\operatorname{cos}⁡(4t+ϕ)+2t, \\\\ y(t) & =R\\operatorname{sin}⁡(4t+ϕ)+2t, \\\\ y(t) & =A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t+2t.\\end{aligned}\n$$\n\nOnly $y=R\\operatorname{sin}⁡(4t+ϕ)+2t$ matches the forms above. Therefore, the correct answer is $y=R\\operatorname{sin}⁡(4t+ϕ)+2t$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046660} :activity/title "Mathematical Methods for the Physical Sciences II: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186420497} :db/id #edb/ref 17592186420528}]} {:db/id #edb/ref 17592186357738 :knowledge-point/_questions [{:db/id #edb/ref 17592186124488 :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907 :topic/title "Subspaces of Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02935727-651f-5b07-b97f-57b1c4d0f3c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451929} {:answer/id #uuid "fbf04caf-27a2-599e-82d8-cbea2da9c312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451930}] :answer-field/correct {:answer/id #uuid "fbf04caf-27a2-599e-82d8-cbea2da9c312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451930} :answer-field/id #uuid "b39e3bde-28a9-51b0-8353-c9325f303d31" :answer-field/key "$B$ is closed under function addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452812} {:answer-field/choices [{:answer/id #uuid "447721a6-a05e-5502-ae83-31e9d732352e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451931} {:answer/id #uuid "b3262219-f5d5-5c98-a451-b87d4967b945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451932}] :answer-field/correct {:answer/id #uuid "b3262219-f5d5-5c98-a451-b87d4967b945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451932} :answer-field/id #uuid "f1c67e75-a563-585a-bbe5-a1b210fac55e" :answer-field/key "$B$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452813} {:answer-field/choices [{:answer/id #uuid "e79343d3-28c0-5d7a-92f6-b6df8153fe55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451933} {:answer/id #uuid "a3bc748c-c6a7-5a02-aa95-b0de79015d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451934}] :answer-field/correct {:answer/id #uuid "a3bc748c-c6a7-5a02-aa95-b0de79015d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451934} :answer-field/id #uuid "fdc8ee66-2ef9-53fa-8e03-31ef6f3d85c9" :answer-field/key "$B$ is a subspace of $C[-5,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452814} {:answer-field/choices [{:answer/id #uuid "a58b1a58-79d6-5b5d-9438-c45135c16c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451935} {:answer/id #uuid "f5fec524-6dd3-5744-82cc-62ca6ca17fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451936}] :answer-field/correct {:answer/id #uuid "a58b1a58-79d6-5b5d-9438-c45135c16c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451935} :answer-field/id #uuid "3708130b-ba2b-5131-a9ce-a341fb02f0af" :answer-field/key "$B$ is **not** a subspace of $C[-5,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f4ed1b6-671a-54be-9f7b-f836039c55ea" :question/math-academy-id "q-94380" :question/problem "Consider the vector space $C[-5,0]$ of all continuous functions $f:[-5,0]\\to R$ and its subset $B={f\\in C[-5,0]\\,|\\,f(0)=0}.$ \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “$B$ is closed under function addition” is  true. If $f(x),g(x)\\in B,$ then \n\n$$\n\\begin{aligned}(f+g)(0) & =f(0)+g(0) \\\\  & =0+0 \\\\  & =0\\end{aligned}\n$$\n\nSo, $B$ is closed under addition.\n\n- Statement “$B$ is closed under scalar multiplication” is true. If $f(x)\\in B$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}(kf)(0) & =kf(0) \\\\  & =k\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nSo, $B$ is closed under scalar multiplication.\n\n- Statement “$B$ is a subspace of $C[-5,0]$” is true, while statement “$B$ is **not** a subspace of $C[-5,0]$” is false. $B$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is “$B$ is closed under function addition”; “$B$ is closed under scalar multiplication”; “$B$ is a subspace of $C[-5,0]$” only."} {:db/id #edb/ref 17592186357739 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1ebf5f6-1eef-504e-a45a-429288ea176d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469710} {:answer/id #uuid "d729886d-e293-59ee-8ca1-95ce2767b7cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469711}] :answer-field/correct {:answer/id #uuid "d1ebf5f6-1eef-504e-a45a-429288ea176d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469710} :answer-field/id #uuid "cc17f441-34f0-56a4-9634-da126b593dac" :answer-field/key "$y=R\\operatorname{cos}⁡(25t+ϕ)+12\\operatorname{sin}⁡t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470467} {:answer-field/choices [{:answer/id #uuid "0d37c668-cc5e-5675-93e6-5b054ee0aa13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469712} {:answer/id #uuid "b62dc90a-7763-5dd6-ab0f-bba731e10dfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469713}] :answer-field/correct {:answer/id #uuid "0d37c668-cc5e-5675-93e6-5b054ee0aa13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469712} :answer-field/id #uuid "c1424c1d-310b-5a93-8997-a3196feaf7c2" :answer-field/key "$y=R\\operatorname{sin}⁡(5t+ϕ)+6\\operatorname{cos}⁡t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470468} {:answer-field/choices [{:answer/id #uuid "b7dcc6e6-2f3f-50ce-bc07-ef3040ceb432" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469714} {:answer/id #uuid "b57fed2a-9162-538c-8c97-cb589188adbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469715}] :answer-field/correct {:answer/id #uuid "b57fed2a-9162-538c-8c97-cb589188adbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469715} :answer-field/id #uuid "a58e0ec3-0615-5a4e-a8b8-13cb290e43b9" :answer-field/key "$y=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t+\\operatorname{cos}⁡t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbe86c7f-4360-5aea-8ad0-c457c70df4e7" :question/math-academy-id "q-94382" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+25y=24\\operatorname{cos}⁡t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution to this equation is the sum of the complementary function and a particular solution.\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$ It can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=25\\,⟹\\,\\omega =5.\n$$\n\nThus, we have:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(5t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(5t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =1$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\operatorname{cos}⁡t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(5t+ϕ)+\\operatorname{cos}⁡t$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(5t+ϕ)+\\operatorname{cos}⁡t$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t+\\operatorname{cos}⁡t$\n\nOnly $y=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t+\\operatorname{cos}⁡t$ matches the forms above. Therefore, the correct answer is $y=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t+\\operatorname{cos}⁡t$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"} :activity/title "Forced Oscillators" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186445728} :db/id #edb/ref 17592186445745}]} {:db/id #edb/ref 17592186357740 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cae621f-3d6e-5d45-9b65-1fad41f795f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469716} {:answer/id #uuid "21ad5055-2b76-5888-b77e-0849f5f11837" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469717}] :answer-field/correct {:answer/id #uuid "21ad5055-2b76-5888-b77e-0849f5f11837" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469717} :answer-field/id #uuid "ed908e42-450b-5534-9da1-729e23bf4ae6" :answer-field/key "$y$ $={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)$ $+\\frac{{e}^{t}}{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470470} {:answer-field/choices [{:answer/id #uuid "fc52e9e4-97b0-5304-be16-59ad68d87273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469718} {:answer/id #uuid "8278a36c-ae51-5440-b66c-2b9da7b262a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469719}] :answer-field/correct {:answer/id #uuid "fc52e9e4-97b0-5304-be16-59ad68d87273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469718} :answer-field/id #uuid "1847518c-ebde-5827-8e28-1cc95c28b40a" :answer-field/key "$y=R\\operatorname{sin}⁡(9t+ϕ)+\\frac{{e}^{t}}{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470471} {:answer-field/choices [{:answer/id #uuid "a44e8621-e0a4-5954-b461-751df8afdcb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469720} {:answer/id #uuid "60960cba-b7ee-5e40-a9ae-22c295ee5156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469721}] :answer-field/correct {:answer/id #uuid "a44e8621-e0a4-5954-b461-751df8afdcb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469720} :answer-field/id #uuid "b3f659e9-9050-529d-929a-3c5358c2751f" :answer-field/key "$y=R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+10{e}^{t}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0cf314c8-ddb9-53cd-832f-d87f0d4562fa" :question/math-academy-id "q-94383" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+8{y}^{′}+41y=10{e}^{t}.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+8{y}^{′}+41y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+8\\lambda +41 & =0 \\\\ ({\\lambda }^{2}+8\\lambda +16)-16+41 & =0 \\\\ (\\lambda +4)^{2}+25 & =0 \\\\ (\\lambda +4)^{2} & =-25 \\\\ \\lambda +4 & =\\pm 5\\text{i} \\\\ \\lambda  & =-4\\pm 5\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha {e}^{t}.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =\\frac{1}{5}.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{{e}^{t}}{5}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}.\\end{aligned}\n$$\n\nOnly $y$ $={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)$ $+\\frac{{e}^{t}}{5}$ matches the forms above. Therefore, the correct answer is $y$ $={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)$ $+\\frac{{e}^{t}}{5}$ only."} {:db/id #edb/ref 17592186360459 :knowledge-point/_questions [{:db/id #edb/ref 17592186124591 :knowledge-point/id #uuid "9b1bb974-826a-590f-8d32-cdc868ca827c" :knowledge-point/title "Identifying Subspaces of Polynomial Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907 :topic/title "Subspaces of Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5477cd7b-f9c9-5c7f-a607-f368ecf237de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451937} {:answer/id #uuid "4356813c-3793-5eb3-9f96-9e5097fea019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451938}] :answer-field/correct {:answer/id #uuid "5477cd7b-f9c9-5c7f-a607-f368ecf237de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451937} :answer-field/id #uuid "8dbfd750-72a7-524b-8bc7-6d10bf74a4d0" :answer-field/key "$B$ is closed under polynomial addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452816} {:answer-field/choices [{:answer/id #uuid "b8894f4d-90d8-53b4-bc65-9af198753c2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451939} {:answer/id #uuid "27e95ad7-d915-56b0-8295-2fc259ae000b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451940}] :answer-field/correct {:answer/id #uuid "b8894f4d-90d8-53b4-bc65-9af198753c2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451939} :answer-field/id #uuid "a7269288-bc2a-5146-b1cc-8c0e8653330e" :answer-field/key "$B$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452817} {:answer-field/choices [{:answer/id #uuid "b47b1139-8b3d-5f7c-b65e-aa35843f713d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451941} {:answer/id #uuid "eeb558a0-c346-532f-9101-0ba693e2a378" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451942}] :answer-field/correct {:answer/id #uuid "b47b1139-8b3d-5f7c-b65e-aa35843f713d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451941} :answer-field/id #uuid "92326df0-69fd-5473-9063-f9fd81a501aa" :answer-field/key "$B$ is a subspace of ${R}_{2}[t]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452818} {:answer-field/choices [{:answer/id #uuid "7ad63500-4f97-5dd3-82f7-7907ecb5913c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451943} {:answer/id #uuid "4bed21ac-7c48-54e9-8a98-bbbd3cb520d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451944}] :answer-field/correct {:answer/id #uuid "4bed21ac-7c48-54e9-8a98-bbbd3cb520d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451944} :answer-field/id #uuid "71941d3e-46d1-5c03-ad74-08aa7d83fff7" :answer-field/key "$B$ is **not** a subspace of ${R}_{2}[t]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef92c245-5042-5dba-9942-02e46fcd2132" :question/math-academy-id "q-94612" :question/problem "Consider the vector space ${R}_{2}[t]$ of all polynomials in the variable $t$ of degree at most $2,$ and its subset $B=\\{p(t)\\in {R}_{2}[t]\\,|\\,p(1)=2\\}.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “$B$ is closed under polynomial addition” is false. For example, if $f(1)=g(1)=2,$ then\n\n$$\n\\begin{aligned}f(1)+g(1) & =2+2 \\\\  & =4,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement “$B$ is closed under scalar multiplication” is false. For example, if $f(1)=2$ and $k=2,$ then \n\n$$\n\\begin{aligned}kf(1) & =2\\cdot 2=4,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement “$B$ is a subspace of ${R}_{2}[t]$” is false, while statement “$B$ is **not** a subspace of ${R}_{2}[t]$” is true. $B$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is “$B$ is **not** a subspace of ${R}_{2}[t]$” only."} {:db/id #edb/ref 17592186360460 :knowledge-point/_questions [{:db/id #edb/ref 17592186124591 :knowledge-point/id #uuid "9b1bb974-826a-590f-8d32-cdc868ca827c" :knowledge-point/title "Identifying Subspaces of Polynomial Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907 :topic/title "Subspaces of Abstract Vector Spaces"}]}] :question/answer-fields [