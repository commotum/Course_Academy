7592186470421}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4a6a4708-c258-5b5f-8c4c-fa774844e5ba" :question/math-academy-id "q-9263" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nThe parallelogram $P$ is mapped to the parallelogram ${P}^{′}$ under the action of $T.$ The parallelogram ${P}^{′}$ has vertices $(1,1),(0,0),(-1,1),$ and $(0,2).$ Which of the following are vertices of $P?$\n\nSelect all that apply." :question/worked-solution "First, we create a matrix $Y$ containing all of the vertices of ${P}^{′}:$ \n\n$$\nY=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 1 & 0 & 1 & 2\\end{bmatrix}.\n$$\n\nNow, if $X$ denotes the matrix that contains the corresponding vertices of $P$, we have\n\n$$\n\\begin{aligned}T\\cdot X & =Y \\\\ T\\cdot X & =\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 1 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot X & ={T}^{-1}\\cdot \\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 1 & 0 & 1 & 2\\end{bmatrix} \\\\ X & ={T}^{-1}\\cdot \\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 1 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe inverse of $T$ is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{1-(-1)}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}X & ={T}^{-1}\\cdot \\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 1 & 0 & 1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 1 & 0 & 1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & 0 & 0 & 2 \\\\ 0 & 0 & 2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 & 1 \\\\ 0 & 0 & 1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nAs a result, the coordinates of $P$ are $(1,0),(0,0),(0,1),(1,1).$\n\nTherefore, the correct answer is “The point $(1,1)$” only."} {:db/id #edb/ref 17592186357528 :knowledge-point/_questions [{:db/id #edb/ref 17592186092226 :knowledge-point/id #uuid "b0cbb889-0fe1-5347-94a3-53db3ff9a95c" :knowledge-point/title "Calculating the Vertices of a Polygon Given Its Image Under a Linear Transformation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049213 :topic/id #uuid "e3ec8239-fcb5-5753-aa06-6c1a1dcb3ccb" :topic/math-academy-id 988 :topic/title "Inverting Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2bc64c6-664a-5b24-aa66-f3eba12645eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469620} {:answer/id #uuid "c28bee52-3d67-53f6-ad56-642b64e05043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469621}] :answer-field/correct {:answer/id #uuid "c28bee52-3d67-53f6-ad56-642b64e05043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469621} :answer-field/id #uuid "d3824387-31bc-52a2-846e-2cd22ab4bb71" :answer-field/key "The point $(2,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470422} {:answer-field/choices [{:answer/id #uuid "17d150ea-6336-53f3-9ff9-69a5bbd01ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469622} {:answer/id #uuid "6ad7216c-e3b7-5ed2-868b-6a0ea8df964a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469623}] :answer-field/correct {:answer/id #uuid "17d150ea-6336-53f3-9ff9-69a5bbd01ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469622} :answer-field/id #uuid "60197c06-01e3-5c67-9cf2-3b20020bd750" :answer-field/key "The point $(0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470423} {:answer-field/choices [{:answer/id #uuid "d91462d4-c453-51f4-a051-ec052973b66e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469624} {:answer/id #uuid "4b540585-d54d-5c51-a990-620c2d48bdfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469625}] :answer-field/correct {:answer/id #uuid "d91462d4-c453-51f4-a051-ec052973b66e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469624} :answer-field/id #uuid "bf37dfab-4b60-5bca-be75-986b98bb898e" :answer-field/key "The point $(-2,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470424}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "56746454-856c-5001-bcf8-93772c0debce" :question/math-academy-id "q-9264" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & -1 \\\\ -1 & 1\\end{bmatrix}.\n$$\n\nThe parallelogram $P$ is mapped to the parallelogram ${P}^{′}$ under the action of $T.$ The parallelogram ${P}^{′}$ has vertices $(0,0),(-2,-2),(-4,0),$ and $(-2,2).$ Which of the following are vertices of $P?$\n\nSelect all that apply." :question/worked-solution "First, we create a matrix $Y$ containing all of the vertices of ${P}^{′}:$ \n\n$$\nY=\\begin{bmatrix}0 & -2 & -4 & -2 \\\\ 0 & -2 & 0 & 2\\end{bmatrix}.\n$$\n\nNow, if $X$ denotes the matrix that contains the corresponding vertices of $P$, we have\n\n$$\n\\begin{aligned}T\\cdot X & =Y \\\\ T\\cdot X & =\\begin{bmatrix}0 & -2 & -4 & -2 \\\\ 0 & -2 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot X & ={T}^{-1}\\cdot \\begin{bmatrix}0 & -2 & -4 & -2 \\\\ 0 & -2 & 0 & 2\\end{bmatrix} \\\\ X & ={T}^{-1}\\cdot \\begin{bmatrix}0 & -2 & -4 & -2 \\\\ 0 & -2 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe inverse of $T$ is\n\n$$\n\\begin{aligned}{T}^{-1}=\\frac{1}{-1-1}\\begin{bmatrix}1 & 1 \\\\ 1 & -1\\end{bmatrix} \\\\ =\\frac{1}{2}\\begin{bmatrix}-1 & -1 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}X & ={T}^{-1}\\cdot \\begin{bmatrix}0 & -2 & -4 & -2 \\\\ 0 & -2 & 0 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-1 & -1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}0 & -2 & -4 & -2 \\\\ 0 & -2 & 0 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}0 & 4 & 4 & 0 \\\\ 0 & 0 & 4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 & 2 & 0 \\\\ 0 & 0 & 2 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nAs a result, the coordinates of $P$ are $(0,0),(2,0),(2,2),(0,2).$\n\nTherefore, the correct answer is “The point $(2,2)$” only."} {:db/id #edb/ref 17592186357561 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050677 :topic/id #uuid "5e132315-9606-5b30-bee3-61f0209d40c4" :topic/math-academy-id 2548 :topic/title "Introduction to Second-Order Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79f1d0cf-4c3f-5c5c-ae91-488ad20a8de2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469626} {:answer/id #uuid "e30119a6-2130-5938-bd90-71a9385d623b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469627}] :answer-field/correct {:answer/id #uuid "e30119a6-2130-5938-bd90-71a9385d623b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469627} :answer-field/id #uuid "0c251103-3612-5cc7-947b-af5e3a307592" :answer-field/key "${y}^{″}-x{y}^{′}+y=\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470425} {:answer-field/choices [{:answer/id #uuid "7ded283b-5f18-5f91-a519-dc6be52e9ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469628} {:answer/id #uuid "a2535307-1b92-5ff9-99d4-5185de5d303e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469629}] :answer-field/correct {:answer/id #uuid "7ded283b-5f18-5f91-a519-dc6be52e9ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469628} :answer-field/id #uuid "6733649c-0fec-5d08-b5ec-46452d2f3e60" :answer-field/key "${y}^{″}+y{y}^{′}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470426} {:answer-field/choices [{:answer/id #uuid "37c16826-1021-5383-bad1-77de256c244d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469630} {:answer/id #uuid "fd322604-9348-559d-8fe7-b3bba3d52b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469631}] :answer-field/correct {:answer/id #uuid "37c16826-1021-5383-bad1-77de256c244d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469630} :answer-field/id #uuid "3c67418e-c6a8-56c0-abda-6159ea8578fc" :answer-field/key "$\\frac{1}{y}{y}^{″}+y=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470427}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95ad491b-4ee0-5e7b-8a0c-33d2b7cf1e9a" :question/math-academy-id "q-93715" :question/problem "Which of the following second-order differential equations are linear?\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n{y}^{″}-x{y}^{′}+y=\\operatorname{cos}⁡x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=-x,c(x)=1,$ and $f(x)=\\operatorname{cos}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}+y{y}^{′}=0\n$$\n\nis **NOT** linear because it contains the nonlinear term $y{y}^{′}.$\n\n- The equation\n\n$$\n\\frac{1}{y}{y}^{″}+y=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $\\frac{1}{y}{y}^{″}.$\n\nTherefore, the correct answer is ${y}^{″}-x{y}^{′}+y=\\operatorname{cos}⁡x$ only."} {:db/id #edb/ref 17592186357562 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050677 :topic/id #uuid "5e132315-9606-5b30-bee3-61f0209d40c4" :topic/math-academy-id 2548 :topic/title "Introduction to Second-Order Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a469b2-5896-588d-9b5f-f86452b44eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469632} {:answer/id #uuid "aca4c5d2-3985-5df0-8512-b4a193218a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469633}] :answer-field/correct {:answer/id #uuid "09a469b2-5896-588d-9b5f-f86452b44eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469632} :answer-field/id #uuid "c2f92d40-06fd-5963-9b61-c9a8f2d37df8" :answer-field/key "$2{y}^{2}{y}^{″}-{e}^{x}{y}^{′}=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470428} {:answer-field/choices [{:answer/id #uuid "7732c50a-196e-5bd4-ae46-9604b54c4cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469634} {:answer/id #uuid "4c2401c4-e763-54a9-90ce-bd5138b0907a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469635}] :answer-field/correct {:answer/id #uuid "4c2401c4-e763-54a9-90ce-bd5138b0907a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469635} :answer-field/id #uuid "6c4a0149-404f-5dda-a8e0-57d0e7983147" :answer-field/key "$\\frac{1}{x}{y}^{″}+{y}^{′}-(\\operatorname{sin}⁡x)y=\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470429} {:answer-field/choices [{:answer/id #uuid "c20331be-786e-5ec8-92b5-cf500b578551" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469636} {:answer/id #uuid "c09b531f-230e-59c8-a5d3-13154d41383b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469637}] :answer-field/correct {:answer/id #uuid "c09b531f-230e-59c8-a5d3-13154d41383b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469637} :answer-field/id #uuid "1e6c792f-fb4d-56c6-a87c-d0da2370a750" :answer-field/key "${y}^{″}+17y=2x\\operatorname{sin}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470430}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6e8b60c-c6c9-5753-b254-94e3e9635292" :question/math-academy-id "q-93721" :question/problem "Which of the following second-order differential equations are linear?\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n2{y}^{2}{y}^{″}-{e}^{x}{y}^{′}=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $2{y}^{2}{y}^{″}.$\n\n- The equation\n\n$$\n\\frac{1}{x}{y}^{″}+{y}^{′}-(\\operatorname{sin}⁡x)y=\\operatorname{cos}⁡x\n$$\n\nis a second-order linear ODE with $a(x)=\\frac{1}{x},b(x)=1,c(x)=-\\operatorname{sin}⁡x,$ and $f(x)=\\operatorname{cos}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}+17y=2x\\operatorname{sin}⁡x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=0,c(x)=17,$ and $f(x)=2x\\operatorname{sin}⁡x.$\n\nTherefore, the correct answer is $\\frac{1}{x}{y}^{″}+{y}^{′}-(\\operatorname{sin}⁡x)y=\\operatorname{cos}⁡x$; ${y}^{″}+17y=2x\\operatorname{sin}⁡x$ only."} {:db/id #edb/ref 17592186357611 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b67bf2d-f434-5cbf-a65f-fe92576ed3fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469638} {:answer/id #uuid "1f304f6a-e85b-5ca9-8056-745663c7ef23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469639}] :answer-field/correct {:answer/id #uuid "5b67bf2d-f434-5cbf-a65f-fe92576ed3fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469638} :answer-field/id #uuid "04035bc7-0baa-52a2-8819-5785c4397711" :answer-field/key "$P=\\begin{bmatrix}0 & 1 \\\\ -1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470431} {:answer-field/choices [{:answer/id #uuid "a25bb71a-4230-5f5d-aaf6-2df76c7f39c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469640} {:answer/id #uuid "82cc5f65-1d57-56f6-b5fe-cc38b670cf45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469641}] :answer-field/correct {:answer/id #uuid "82cc5f65-1d57-56f6-b5fe-cc38b670cf45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469641} :answer-field/id #uuid "c9c0a8bf-9374-501d-9297-e531eb25d3f0" :answer-field/key "$Q=\\begin{bmatrix}0 & -1 \\\\ -1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470432} {:answer-field/choices [{:answer/id #uuid "689daa18-2b9c-5f89-9c4a-2575e6717d8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469642} {:answer/id #uuid "2223f70f-5ec1-579a-a3a0-521b192241b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469643}] :answer-field/correct {:answer/id #uuid "689daa18-2b9c-5f89-9c4a-2575e6717d8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469642} :answer-field/id #uuid "800cf770-f16d-5241-92e2-0bfe2665859c" :answer-field/key "$R=\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "225f8bdf-5da4-5137-973e-d6466e5f7f7a" :question/math-academy-id "q-93985" :question/problem "Which of the following matrices are symmetric?\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=\\begin{bmatrix}0 & 1 \\\\ -1 & 1\\end{bmatrix}\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$Q$ only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"} :activity/title "Symmetric Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425147} :db/id #edb/ref 17592186425156}]} {:db/id #edb/ref 17592186357612 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "26894