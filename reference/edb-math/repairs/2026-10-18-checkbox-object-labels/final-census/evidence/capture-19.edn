t answer is $p:(-2,2]\\to (-2,2]$; $r:[-2,2)\\to (-2,2]$ only."} {:db/id #edb/ref 17592186360705 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebdb1253-cd9a-5b85-8df1-75e63393709e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469830} {:answer/id #uuid "e6245462-c3b1-57c7-842e-f6fce74151a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469831}] :answer-field/correct {:answer/id #uuid "e6245462-c3b1-57c7-842e-f6fce74151a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469831} :answer-field/id #uuid "9c46fef9-0e62-59e2-89a4-b2f1649af27e" :answer-field/key "$p:{1,2}\\to R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470527} {:answer-field/choices [{:answer/id #uuid "d673d8ae-45df-57fc-aaa0-e71b323ace0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469832} {:answer/id #uuid "ea3173a1-9c3f-5c99-af9b-4dfff4f7859a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469833}] :answer-field/correct {:answer/id #uuid "d673d8ae-45df-57fc-aaa0-e71b323ace0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469832} :answer-field/id #uuid "caa75953-0552-56a9-9fe1-23388f51b591" :answer-field/key "$q:R\