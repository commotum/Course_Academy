] :answer-field/correct {:answer/id #uuid "980c515e-caa4-5cf7-bf8e-1de693b1e245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469846} :answer-field/id #uuid "b04592ba-c3c0-597c-b837-f4cc1106ab2c" :answer-field/key "The range of $f$ is $R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470535}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "777628a7-f0f2-562d-ab61-872a852162b2" :question/math-academy-id "q-96825" :question/problem "Which of the following is the correct interpretation of $f:[-1,1]\\to R?$\n\nSelect all that apply." :question/worked-solution "The notation \n\n$$\nf:[-1,1]\\to R\n$$\n\nmeans that the function $f$ maps the set $[-1,1]$ to the set $R.$ In this case,\n\n- the domain of $f$ is $[-1,1],$ and\n\n- the codomain of $f$ is $R.$ Note that this is *not* necessarily the range.\n\nAs a result, statements “The codomain of $f$ is $[-1,1]$” and “The range of $f$ is $R$” are false, while statement “The domain of $f$ is $[-1,1]$” is true.\n\nTherefore, the correct answer is “The domain of $f$ is $[-1,1]$” only."} {:db/id #edb/ref 17592186360716 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "962bd8fb-e1fe-5079-9863-836d376cb047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469848} {:answer/id #uuid "abea238c-8f75-57f1-84e9-f2ddc1e820ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.