} :answer-field/id #uuid "a95166f7-68fd-56f2-9a17-d1d25c67b163" :answer-field/key "$L=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472281} {:answer-field/choices [{:answer/id #uuid "95595a4d-4f66-5cdc-a3bd-a942aa54a3c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471553} {:answer/id #uuid "fb9476f3-7983-564a-a01a-d83941d1ddc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471554 :task-item/_responses [{:db/id #edb/ref 17592186568890 :task-item/content {:db/id #edb/ref 17592186396162} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "fb9476f3-7983-564a-a01a-d83941d1ddc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471554 :task-item/_responses [{:db/id #edb/ref 17592186568890 :task-item/content {:db/id #edb/ref 17592186396162} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "bb028653-629e-5964-9f78-3ef8dfd936c4" :answer-field/key "$M=\\begin{bmatrix}2 & 3 & 0 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 7 & 1 & 1 & 4 \\\\ 0 & 0 & 0 & 8\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472282}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ba95bcc-83a0-57ed-9254-81c22af4a048" :question/math-academy-id "q-7835" :question/problem "Which of the following are square matrices?\n\nSelect all that apply." :question/worked-solution "- $K$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $2$ rows and $3$ columns, so it's a $2\\times 3$ matrix.\n\n- $L$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $M$ is a square matrix since it has the same number of rows and columns. It has $4$ rows and $4$ columns, so it is a $4\\times 4$ matrix.\n\nTherefore, only $L$ and $M$ are square matrices." :task-item/_content [{:db/id #edb/ref 17592186568890 :task-item/content {:db/id #edb/ref 17592186396162} :task-item/elapsed-seconds 10.425 :task-item/id #uuid "72401a05-47c2-4f30-ab82-3accf0772fea" :task-item/next {:db/id #edb/ref 17592186568891} :task-item/responses [{:answer/id #uuid "30fed243-4084-56d8-84b0-478adfaa2bb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471549} {:answer/id #uuid "bbfffafd-99ed-5da9-b18d-ccd96540a3b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471552} {:answer/id #uuid "fb9476f3-7983-564a-a01a-d83941d1ddc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471554}] :task-item/status {:db/id #edb/ref 17592186045571} :task-item/working-ended-at #inst "2026-10-16T20:56:55.087Z"}]} {:db/id #edb/ref 17592186396169 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "741083d8-7378-5329-81bd-75ee950b2144" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471555} {:answer/id #uuid "4b7d78d5-2816-585a-9205-a6e70044ec0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471556}] :answer-field/correct {:answer/id #uuid "4b7d78d5-2816-585a-9205-a6e70044ec0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471556} :answer-field/id #uuid "1ec26382-ce45-51fe-9719-373d673b7f62" :answer-field/key "$P=\\begin{bmatrix}4 & 3 \\\\ 8 & 6\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472283} {:answer-field/choices [{:answer/id #uuid "3df8f3cc-d84c-5eee-b203-2e5b3a76ac8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471557} {:answer/id #uuid "084c65aa-a350-580e-b2a3-5201f6c81dfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471558}] :answer-field/correct {:answer/id #uuid "084c65aa-a350-580e-b2a3-5201f6c81dfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471558} :answer-field/id #uuid "d2cbff6b-6444-5254-a29c-7df2a40ce247" :answer-field/key "$Q=\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472284} {:answer-field/choices [{:answer/id #uuid "699ee824-9041-5440-9507-9d2a68088e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471559} {:answer/id #uuid "b999e8b9-c8e3-57fc-af6a-5cfb661ee0e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471560}] :answer-field/correct {:answer/id #uuid "699ee824-9041-5440-9507-9d2a68088e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471559} :answer-field/id #uuid "7a76c867-cf40-5ba2-9a8c-90664e519511" :answer-field/key "$R=\\begin{bmatrix}2 & -4 & 3 \\\\ 3 & -4 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17761662-c8e1-5053-be1d-f17ca1632a52" :question/math-academy-id "q-7915" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $P$, we have\n\n$$\ndet(P)=4\\cdot 6-8\\cdot 3=0.\n$$\n\nBecause $det(P)=0,$ we conclude that $P$ is not invertible. Since $P$ is a square matrix that is not invertible, we also say that $P$ is singular.\n\n- For the matrix $Q$, we have\n\n$$\ndet(Q)=1\\cdot 1-(-1)\\cdot (-1)=0.\n$$\n\nBecause $det(Q)=0,$ we conclude that $Q$ is not invertible. Since $Q$ is a square matrix that is not invertible, we also say that $Q$ is singular.\n\n- The matrix $R$ is a $2\\times 3$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $P$ and $Q$ are singular."} {:db/id #edb/ref 17592186396176 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048459 :topic/id #uuid "a163637a-ed19-547a-85e8-0acfdb20fa0f" :topic/math-academy-id 865 :topic/title "Introduction to Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f34066f-00d4-55b1-8d73-96ef234a63ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471627} {:answer/id #uuid "40aeb5d5-faee-5b7e-8df5-e870d6e9a6e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471628}] :answer-field/correct {:answer/id #uuid "2f34066f-00d4-55b1-8d73-96ef234a63ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471627} :answer-field/id #uuid "27ba3123-b0fe-5ec0-9a8d-2073c4afa0b4" :answer-field/key "$T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472319} {:answer-field/choices [{:answer/id #uuid "3317098d-cf9d-5045-941b-07580beb38db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471629} {:answer/id #uuid "cef4ff68-717a-544a-9ae5-83dfb3142903" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471630}] :answer-field/correct {:answer/id #uuid "3317098d-cf9d-5045-941b-07580beb38db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471629} :answer-field/id #uuid "75df2837-8fbd-5207-9ab7-c0c5f47ed8b5" :answer-field/key "$T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472320} {:answer-field/choices [{:answer/id #uuid "839e484e-16dc-5c22-99f9-7b695e23ac7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471631} {:answer/id #uuid "d9f23ace-b866-586d-8acb-fe6dd49060d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471632}] :answer-field/correct {:answer/id #uuid "d9f23ace-b866-586d-8acb-fe6dd49060d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471632} :answer-field/id #uuid "64c08e3e-68be-5c0c-ab6e-798878cc578f" :answer-field/key "$T$ is **NOT** a linear transformation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472321}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72a3fd90-5133-5a81-a0e8-33ac74b2d520" :question/math-academy-id "q-8049" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}1 \\\\ x\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ kx\\end{bmatrix} \\\\  & \\ne kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is not a linear transformation.\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ {x}_{1}+{x}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ {x}_{2}\\end{bmatrix} \\\\  & \\ne T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nAs a result, only statement “$T$ is **NOT** a linear transformation” is true."} {:db/id #edb/ref 17592186396237 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46af019b-5e0e-54fe-a3a4-d3a5f79204d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440035} {:answer/id #uuid "36089e95-fc88-5a76-b2c4-311f215a41a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440036}] :answer-field/correct {:answer/id #uuid "46af019b-5e0e-54fe-a3a4-d3a5f79204d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440035} :answer-field/id #uuid "a7bba9ed-822d-53ee-89c9-116fde41ee52" :answer-field/key "$k=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440375} {:answer-field/choices [{:answer/id #uuid "242f0892-e1e1-5e47-ac02-f10209cc7691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440037} {:answer/id #uuid "5261eeed-b902-50cd-be8c-e339e0cd7603" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440038}] :answer-field/correct {:answer/id #uuid "5261eeed-b902-50cd-be8c-e339e0cd7603" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440038} :answer-field/id #uuid "3baa83a4-cb6e-5db3-8f0f-7d1c5b2abfae" :answer-field/key "$k=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440376} {:answer-field/choices [{:answer/id #uuid "2a8201e6-2d8f-5889-8d5a-7f26e45965c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440039} {:answer/id #uuid "8aa3b90b-7a80-5418-b7a0-778bc241d10d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440040}] :answer-field/correct {:answer/id #uuid "8aa3b90b-7a80-5418-b7a0-778bc241d10d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440040} :answer-field/id #uuid "ab487ccf-fee0-51d3-aff0-dfee470b09fd" :answer-field/key "$k=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440377}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11af43ea-89bf-58ea-b458-4433226aa764" :question/math-academy-id "q-9913" :question/problem "Find the possible values of the constant $k$ given that the matrix  $\\begin{bmatrix}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{bmatrix}$ is singular.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{aligned}| & =k|\\begin{aligned}3 & 1 \\\\ 6 & k\\end{aligned}|+0|\\begin{aligned}0 & 1 \\\\ 0 & k\\end{aligned}|+0|\\begin{aligned}0 & 3 \\\\ 0 & 6\\end{aligned}| \\\\  & =k(3k-6)+0+0 \\\\  & =k(3k-6)\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}k(3k-6) & =0 \\\\ 3k(k-2) & =0 \\\\ k & =0,2\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=2.$"} {:db/id #edb/ref 17592186396578 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity" :topi