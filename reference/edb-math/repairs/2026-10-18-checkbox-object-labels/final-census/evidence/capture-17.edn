r/value "false" :db/id #edb/ref 17592186468140} {:answer/id #uuid "678dc931-9de5-5c14-9144-1b98946a7b5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468141}] :answer-field/correct {:answer/id #uuid "6f052af5-1b8f-5975-b3f7-87826619a2c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468140} :answer-field/id #uuid "4e05ce73-bd6b-5a87-b9b7-7872f18039e7" :answer-field/key "$C=\\begin{bmatrix}1 & 1 \\\\ \\frac{3}{4} & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468791}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd25b025-461f-556b-97f3-6071c19d59d7" :question/math-academy-id "q-75595" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=4{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}2 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}1 & 1 \\\\ \\frac{3}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."} {:db/id #edb/ref 17592186345107 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048920 :topic/id #uuid "cc887b1d-8841-507d-a99b-b7888c08a675" :topic/math-academy-id 1728 :topic/title "Finding the Inverse of a 2x2 Matrix Using Row Operations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf810a22-6e4e-5370-935e-7b24712f6a30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468142} {:answer/id #uuid "848f4c22-cfc4-5377-a40d-094c0e364b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468143}] :answer-field/correct {:answer/id #uuid "848f4c22-cfc4-5377-a40d-094c0e364b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468143} :answer-field/id #uuid "f591a7fc-b05e-5621-acf8-731308abb477" :answer-field/key "$A=\\begin{bmatrix}2 & 1 \\\\ 2 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468792} {:answer-field/choices [{:answer/id #uuid "50b01950-272f-59a6-9096-2b795827c4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468144} {:answer/id #uuid "65204522-9d40-58cf-9306-f1b137036423" :answer/type {:db/id #edb/