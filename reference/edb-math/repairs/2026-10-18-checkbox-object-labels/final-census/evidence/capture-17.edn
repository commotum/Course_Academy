answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468057} :answer-field/id #uuid "3acf4f19-1ed8-5841-bd74-4e01d898c416" :answer-field/key "$[-2,-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468749}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a761269-f6ea-50eb-8e45-58983c3d9692" :question/math-academy-id "q-73503" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\frac{2-x}{{2}^{x}+1}, & x\\ne 0 \\\\ \\,\\,2, & x=0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- First, let's consider $[-1,1].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}f(x) & ={lim}_{x\\to 0}\\frac{2-x}{{2}^{x}+1}=\\frac{2-0}{{2}^{0}+1}=1\\ne f(0).\\end{aligned}\n$$\n\nHence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(0,3]$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[-2,-1].$ The only discontinuity of the function $f(x)$ is at $x=0,$ which is not in the interval  $[-2,-1].$  Therefore, $f(x)$ is continuous on the interval  $[-2,-1],$  and the extreme value theorem is also applicable on this interval.\n\nIn conclusion, the correct answer is $[-2,-1]$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"} :activity/title "The Extreme Value Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508384} :db/id #edb/ref 17592186509024}]} {:db/id #edb/ref 17592186341994 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff8c0277-f286-5f5c-95f1-742c5c84a4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468058} {:answer/id #uuid "be8dd074-7787-59f7-a72c-bcaee5b2f576" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468059}] :answer-field/correct {:answer/id #uuid "ff8c0277-f286-5f5c-95f1-742c5c84a4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468058} :answer-field/id #uuid "c5514612-b769-5808-8bd5-f23974490b11" :answer-field/key "$[-1,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468750} {:answer-field/choices [{:answer/id #uuid "61a803aa-7689-5e3d-ac70-2fd7924783b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468060} {:answer/id #uuid "54a9b0c7-fc2a-5a6c-8b61-d9b8cb0d6b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468061}] :answer-field/correct {:answer/id #uuid "61a803aa-7689-5e3d-ac70-2fd7924783b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468060} :answer-field/id #uuid "796ce61b-6691-5177-9e8d-07206e5a1e77" :answer-field/key "$(1,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468751} {:answer-field/choices [{:answer/id #uuid "dc0fda9f-032f-5239-88db-2a5cd71a0cff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468062} {:answer/id #uuid "5592e116-d543-53b7-bc8a-6200d16d248a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468063}] :answer-field/correct {:answer/id #uuid "5592e116-d543-53b7-bc8a-6200d16d248a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468063} :answer-field/id #uuid "0afadab0-2a76-5ed8-839b-7a13c2067a7a" :answer-field/key "$[2,\\pi ]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468752}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dcdd6cca-dc15-5e0c-a55e-4d73a59866ce" :question/math-academy-id "q-73504" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\,\\,2{x}^{3}-1, & x<1 \\\\ {sin}^{2}⁡(x-1), & x\\ge 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-1,2].$  We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to 1}(2{x}^{3}-1)=2(1)^{3}-1=1, \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to 1}{sin}^{2}⁡(x-1)={sin}^{2}⁡(1-1)=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=1$ are not the same. Hence, $f(x)$ has a discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,2],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(1,3]$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[2,\\pi ].$ In this interval, $f(x)={sin}^{2}⁡(x-1)$ and so $f(x)$ is continuous on $[2,\\pi ].$  Therefore, the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is $[2,\\pi ]$ only."} {:db/id #edb/ref 17592186342003 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "590b6563-fc5a-5099-8b31-7c8840139fb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468064} {:answer/id #uuid "823fa8bb-4902-59a1-8b15-a420ef200eaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468065}] :answer-field/correct {:answer/id #uuid "590b6563-fc5a-5099-8b31-7c8840139fb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468064} :answer-field/id #uuid "b03606bc-af56-5495-a640-2b1ff321627a" :answer-field/key "$[-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468753} {:answer-field/choices [{:answer/id #uuid "6551ac70-7210-595b-b7c9-6d9837da871d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468066} {:answer/id #uuid "cad2d236-f9c3-5706-b2e8-53826efc2a83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468067}] :answer-field/correct {:answer/id #uuid "6551ac70-7210-595b-b7c9-6d9837da871d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468066} :answer-field/id #uuid "1a52ec7c-0e75-5e34-b576-a534c8cf21a1" :answer-field/key "$[-3,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468754} {:answer-field/choices [{:answer/id #uuid "44dc5099-0725-53e3-b405-c81f11d46f16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468068} {:answer/id #uuid "6b7e8804-4489-51c0-b955-8a411b43aaac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468069}] :answer-field/correct {:answer/id #uuid "6b7e8804-4489-51c0-b955-8a411b43aaac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468069} :answer-field/id #uuid "e79dce1b-5f18-5741-977a-3edf1f823ef0" :answer-field/key "$[1.5,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468755}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8abc4b9f-caf8-5c94-91da-62ad0ae61b3d" :question/math-academy-id "q-73531" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{x-1}-1}, & x\\ne 1 \\\\ \\,\\,1, & x=1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- Let first consider the interval  $[-2,2].$ This is a  closed interval, but we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\frac{1}{{2}^{x-1}-1}=\\infty \\end{aligned}\n$$\n\nand so $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1]$, and the extreme value theorem is not applicable.\n\n- The interval $[-3,1)$ is not closed, so the extreme value theorem is not applicable in this case.\n\n- Finally consider  $[1.5,2].$ The only discontinuity of the function $f(x)$ is at $x=1,$ which is not in the interval  $[1.5,2].$ Therefore, $f(x)$ is continuous on the interval  $[1.5,2]$, and the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is $[1.5,2]$ only."} {:db/id #edb/ref 17592186342012 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither" :topic/_knowledge-points [{:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94e30f0-68f2-5998-b9f9-644e9e44b95f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468070} {:answer/id #uuid "5f0ed006-c485-5f47-9cb3-66d73cb5b6eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468071}] :answer-field/correct {:answer/id #uuid "c94e30f0-68f2-5998-b9f9-644e9e44b95f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468070} :answer-field/id #uuid "e579a2ca-789a-528f-993a-72fedc592395" :answer-field/key "It is a type I region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468756} {:answer-field/choices [{:answer/id #uuid "5794e6f7-e7be-5b7e-8bb8-bb34003ae429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468072} {:answer/id #uuid "c1777e06-539e-50b4-a94c-4208586ed294" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468073}] :answer-field/correct {:answer/id #uuid "5794e6f7-e7be-5b7e-8bb8-bb34003ae429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468072} :answer-field/id #uuid "3694904e-0ccc-5a31-b8a9-6ec58e4eec46" :answer-field/key "It is a type II region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468757} {:answer-field/choices [{:answer/id #uuid "6117a2a3-4603-5502-8e5e-e303e66ecd3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468074} {:answer/id #uuid "32f5d350-119e-5636-b3cb-0f999c5e3d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468075}] :answer-field/correct {:answer/id #uuid "32f5d350-119e-5636-b3cb-0f999c5e3d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468075} :answer-field/id #uuid "abcdcfba-e886-55b6-abf8-403802e888af" :answer-field/key "It's neither a type I nor a type II region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468758}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "451e02c3-10e2-5101-a83f-538a8be6b03d" :question/math-academy-id "q-73549" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $4{x}^{2}+{y}^{2}=4$ and $4{x}^{2}+{y}^{2}=1?$\n\nSelect all that apply." :question/worked-solution "First, let's sketch our region.\n\n![](images/62/627e7e102a0f16cb0c4946e42b48ad122299d729c5bc419293e258a3f2e1701e.png)\n\nWe have the following:\n\n- The vertical line $x=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/d7/d7aa48c887d6fb1c3d0420867b7e74010fa93e16d7e24317e2cf214764e56113.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/ec/ec632fa5f86d8d9b34b9ccf661a3219e965f289c28bf69d7d80eeeb46093e7ae.png)\n\nTherefore, only statement “It's neither a type I nor a type II region” is true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"} :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514859} :db/id #edb/ref 17592186515626}]} {:db/id #edb/ref 17592186342014 :knowledge-point/_questions [{:db/id #edb/ref 17592186115234 :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb2f9c1-c0f7-5cb1-94cf-c1eda0965c26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451585} {:answer/id #uuid "fb399ecd-7930-593b-83c0-38b52228b9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451586}] :answer-field/correct {:answer/id #uuid "fb399ecd-7930-593b-83c0-38b52228b9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451586} :answer-field/id #uuid "a104f9c7-7e4d-5227-b5d9-cb72664cf694" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452640} {:answer-field/choices [{:answer/id #uuid "8ec2e54f-4842-5a73-9901-8fa041c1a988" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451587} {:answer/id #uuid "7460347d-b166-5979-bcfc-69ae5393c4e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451588}] :answer-field/correct {:answer/id #uuid "8ec2e54f-4842-5a73-9901-8fa041c1a988" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451587} :answer-field/id #uuid "fdfa12c5-bb59-5c70-9e62-1ffe6ff85434" :answer-field/key "$A$ is not invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452641} {:answer-field/choices [{:answer/id #uuid "3f7cb3cb-e223-5f6f-b2d5-80b3571e9e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451589} {:answer/id #uuid "5475d51e-e019-56ab-8cdc-1e208b5f796a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451590}] :answer-field/correct {:answer/id #uuid "3f7cb3cb-e223-5f6f-b2d5-80b3571e9e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451589} :answer-field/id #uuid "b6537431-c15f-5384-9d0f-e746bb1bc7d8" :answer-field/key "The system $Ax=b$ has no solution for some $2\\times 1$ column vectors $b.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6905816-c0d6-59f0-9ff1-518732f97672" :question/math-academy-id "q-73562" :question/problem "Consider a system of two linear equations in two variables, represented by the matrix equation $Ax=0$ in the usual way. Given that the system has a unique zero solution, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nAlso, we are told that the third part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement $det(A)\\ne 0$ is true by the fifth part of the invertible matrix theorem.\n\n- Statement “$A$ is not invertible” is false by the first part of the invertible matrix theorem.\n\n- Statement “The system $Ax=b$ has no solution for some $2\\times 1$ column vectors $b.$” is false by the second part of the invertible matrix theorem.\n\nTherefore, only statement $det(A)\\ne 0$ is true."} {:db/id #edb/ref 17592186342015 :knowledge-point/_questions [{:db/id #edb/ref 17592186115234 :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57f8db18-4936-5d58-b7eb-8e4f05c46d52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451591} {:answer/id #uuid "c921bd68-ad9c-592c-9800-47bf22685ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451592}] :answer-field/correct {:answer/id #uuid "57f8db18-4936-5d58-b7eb-8e4f05c46d52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451591} :answer-field/id #uuid "7e23e151-69ab-5150-a6dd-dddffad11cdb" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452643} {:answer-field/choices [{:answer/id #uuid "67e5e15f-8163-5919-96fd-e0ad4f34643e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451593} {:answer/id #uuid "a9b68a52-378f-5960-b347-47f6ca687d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451594}] :answer-field/correct {:answer/id #uuid "a9b68a52-378f-5960-b347-47f6ca687d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451594} :answer-field/id #uuid "4aa3ed8d-d8dc-50ef-a617-8f9288b9d4b0" :answer-field/key "The system $Ax=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ has exactly one solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452644} {:answer-field/choices [{:answer/id #uuid "1d5854a3-4400-582b-bf8c-6ff607f43d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451595} {:answer/id #uuid "c1601bb5-6b85-53dc-a4db-7a5cfa40df0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451596}] :answer-field/correct {:answer/id #uuid "c1601bb5-6b85-53dc-a4db-7a5cfa40df0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451596} :answer-field/id #uuid "b9234a48-131e-5b5b-beae-659f6d2f37fe" :answer-field/key "$A$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452645}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12c8cd48-ec61-5529-9409-02950b9c8c07" :question/math-academy-id "q-73563" :question/problem "Consider a system of two linear equations in two variables, represented by the matrix equation $Ax=0$ in the usual way. Given that the system has a unique zero solution, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nAlso, we are told that the third part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement $det(A)=0$ is false by the fifth part of the invertible matrix theorem.\n\n- Statement “The system $Ax=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ has exactly one solution” is true by the second part of the invertible matrix theorem.\n\n- Statement “$A$ is invertible” is true by the first part of the invertible matrix theorem.\n\nTherefore, only statements “The system $Ax=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ has exactly one solution”  and “$A$ is invertible” are true."} {:db/id #edb/ref 17592186342016 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60635149-f2da-567f-9f0a-9d4117894692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451597} {:answer/id #uuid "d830d804-449e-5e28-85c1-6748faf8d484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451598}] :answer-field/correct {:answer/id #uuid "d830d804-449e-5e28-85c1-6748faf8d484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451598} :answer-field/id #uuid "5e139a64-7bda-5908-828b-d778f0b7810e" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452646} {:answer-field/choices [{:answer/id #uuid "58ffdb3c-5c54-5de6-884b-cb4ea0bf2b80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451599} {:answer/id #uuid "f7f9328e-0820-5a7e-a411-86187b35cbb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451600}] :answer-field/correct {:answer/id #uuid "58ffdb3c-5c54-5de6-884b-cb4ea0bf2b80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451599} :answer-field/id #uuid "358dbeef-add1-5d3c-974e-66d81b7957e3" :answer-field/key "The lines $2x+4y=0$ and $3x+6y=0$ intersect at exactly one point" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452647} {:answer-field/choices [{:answer/id #uuid "c8c76fc4-db40-5d9f-b744-f4e8311ffe23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451601} {:answer/id #uuid "669f7e2b-36da-5c77-9bf8-b929a0f8fb6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451602}] :answer-field/correct {:answer/id #uuid "669f7e2b-36da-5c77-9bf8-b929a0f8fb6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451602} :answer-field/id #uuid "3286acfd-ad75-5a43-83b7-7026982ba30d" :answer-field/key "${A}^{-1}$ does **not** exist" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b4e1216-e41e-5317-bf20-2acb3db54b81" :question/math-academy-id "q-73565" :question/problem "Let \n$A=\\begin{bmatrix}2 & 4 \\\\ 3 & 6\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)=0$ is true. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & 4 \\\\ 3 & 6\\end{bmatrix} \\\\  & =2\\cdot 6-4\\cdot 3 \\\\  & =0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is false, all the other parts of the theorem are false too. Therefore, according to the theorem: \n\n- Statement “The lines $2x+4y=0$ and $3x+6y=0$ intersect at exactly one point” is false by the fourth part of the invertible matrix theorem.\n\n- Statement “${A}^{-1}$ does **not** exist” is true by the first part of the invertible matrix theorem.\n\nTherefore, only statements $det(A)=0$ and “${A}^{-1}$ does **not** exist” are true."} {:db/id #edb/ref 17592186342017 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e722ed3-73e4-52c0-a421-554b9e9509ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451603} {:answer/id #uuid "fd8c1a33-14d5-5cc1-8cc8-cfa132ee5905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451604}] :answer-field/correct {:answer/id #uuid "2e722ed3-73e4-52c0-a421-554b9e9509ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451603} :answer-field/id #uuid "4f67ecc6-4e68-5ff5-857f-036ed453fead" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452649} {:answer-field/choices [{:answer/id #uuid "6115e85e-49af-5de4-9017-fbc84811fcb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451605} {:answer/id #uuid "eaebde56-3eac-5bbe-8241-b7a00be555c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451606}] :answer-field/correct {:answer/id #uuid "6115e85e-49af-5de4-9017-fbc84811fcb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451605} :answer-field/id #uuid "9389fb0c-e8ff-5dd4-bcab-a96185abbeb4" :answer-field/key "The lines $2x+2y=2$ and $3x+ky=0$ intersect at infinitely many points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452650} {:answer-field/choices [{:answer/id #uuid "fa797b64-c1e0-5eb2-85fb-866fba1ac56d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451607} {:answer/id #uuid "896ae4a2-9a84-5c01-a7e8-af08641f9223" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451608}] :answer-field/correct {:answer/id #uuid "896ae4a2-9a84-5c01-a7e8-af08641f9223" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451608} :answer-field/id #uuid "39b24a35-e5b9-5f93-a09d-4ba2dac53cd5" :answer-field/key "$Ax=0$ has the unique solution $\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452651}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "946ddb30-e9a3-52e2-ad46-5aa2c1f15eef" :question/math-academy-id "q-73567" :question/problem "Let $A=\\begin{bmatrix}2 & 2 \\\\ 3 & k\\end{bmatrix}$ and $b=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix},$ where $k$ is a constant such that $k\\ne 3.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)=0$ is false. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & 2 \\\\ 3 & k\\end{bmatrix} \\\\  & =2\\cdot k-3\\cdot 2 \\\\  & =2k-6.\\end{aligned}\n$$\n\nNotice that $2k-6\\ne 0$ if $k\\ne 3.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “The lines $2x+2y=2$ and $3x+ky=0$ intersect at infinitely many points” is false. According to the fourth part of the invertible matrix theorem, the lines must intersect at exactly one point.\n\n- Statement “$Ax=0$ has the unique solution $\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$” is true by the third part of the invertible matrix theorem.\n\nFinally, only statement “$Ax=0$ has the unique solution $\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$” is true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"} :activity/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494315} :db/id #edb/ref 17592186495228}]} {:db/id #edb/ref 17592186342018 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f23fb601-4602-5230-a2b6-d601d28b1d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451609} {:answer/id #uuid "fc8e66cf-8fa0-5d72-a062-c894bd90eeb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451610}] :answer-field/correct {:answer/id #uuid "fc8e66cf-8fa0-5d72-a062-c894bd90eeb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451610} :answer-field/id #uuid "d8a8b707-5ade-50d0-9352-ee18ad208d90" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452652} {:answer-field/choices [{:answer/id #uuid "4599a9d8-85d9-55cd-b0ce-93297e11ff44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451611} {:answer/id #uuid "8805138a-b896-57c2-ae9a-7c7b7fcdcb7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451612}] :answer-field/correct {:answer/id #uuid "4599a9d8-85d9-55cd-b0ce-93297e11ff44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451611} :answer-field/id #uuid "261382cf-81eb-57f1-8fd5-08c17079a626" :answer-field/key "The system $Ax=b$ has infinitely many solutions" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452653} {:answer-field/choices [{:answer/id #uuid "f312ba01-7f4f-5870-a564-3e53f73eba37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451613} {:answer/id #uuid "1dd13e80-555a-5431-b4aa-3bbfe2eec5ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451614}] :answer-field/correct {:answer/id #uuid "f312ba01-7f4f-5870-a564-3e53f73eba37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451613} :answer-field/id #uuid "fa9d9259-e497-5632-a846-f4d0b61339a2" :answer-field/key "The lines $x+2y=2$ and $4x+ky=0$ don't intersect" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452654}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb595552-3588-5923-aa25-072e92fab82f" :question/math-academy-id "q-73570" :question/problem "Let $A=\\begin{bmatrix}1 & 2 \\\\ 4 & k\\end{bmatrix}$ and $b=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix},$ where $k$ is a constant such that $k\\ne 8.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)\\ne 0$ is true. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}1 & 2 \\\\ 4 & k\\end{bmatrix} \\\\  & =1\\cdot k-2\\cdot 4 \\\\  & =k-8.\\end{aligned}\n$$\n\nNotice that $k-8\\ne 0$ if $k\\ne 8.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “The system $Ax=b$ has infinitely many solutions” is false by the second part of the invertible matrix theorem.\n\n- Statement “The lines $x+2y=2$ and $4x+ky=0$ don't intersect” is false.  According to the fourth part of the invertible matrix theorem, the lines must intersect at exactly one point.\n\nFinally, only statement $det(A)\\ne 0$ is true."} {:db/id #edb/ref 17592186342028 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904 :topic/title "Identifying the Pivot Columns of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5abd0f80-5791-5050-afe4-0e1f60f6e5c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/val