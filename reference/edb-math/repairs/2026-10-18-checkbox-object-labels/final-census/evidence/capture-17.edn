a8-7435-5eec-b64a-a638a78ecc0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574444} :answer-field/id #uuid "e50d90ef-faae-5922-966e-07a872c2eaad" :answer-field/key "Column 3: $\\begin{bmatrix}-1 \\\\ 3 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b24da91d-4cea-58f0-be32-4afbd9e924b5" :question/math-academy-id "q-73607" :question/problem "The row echelon form matrix $B$ is given below. What are the pivot columns of $B?$\n\n$$\nB=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $2$ pivots in the $1$st and $3$rd columns:\n\n$$\nB=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186342030 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904 :topic/title "Identifying the Pivot Columns of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5f18fb5-e373-5b1e-b0e8-92e469b79e42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574445} {:answer/id #uuid "707503ee-8ae4-5a7e-b64b-f65288257957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574446}] :answer-field/correc