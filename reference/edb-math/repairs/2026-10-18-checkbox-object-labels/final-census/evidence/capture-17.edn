R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}-1 & -3 \\\\ 1 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & -3 \\\\ 4 & 13\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}7 & 2 \\\\ 3 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}9 & 2 \\\\ 4 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."} {:db/id #edb/ref 17592186345095 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048920 :topic/id #uuid "cc887b1d-8841-507d-a99b-b7888c08a675" :topic/math-academy-id 1728 :topic/title "Finding the Inverse of a 2x2 Matrix Using Row Operations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eaf41b36-30bd-512a-957e-7a79e4183513" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468124} {:answer/id #uuid "9454a215-809e-5191-9a6a-ef7b9461b589" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468125}] :answer-field/correct {:answer/id #uuid "eaf41b36-30bd-512a-957e-7a79e4183513" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468124} :answer-field/id #uuid "3a970b3f-aba4-558d-96f5-bdc7558d6367" :answer-field/key "$A=\\begin{bmatrix}6 & 1 \\\