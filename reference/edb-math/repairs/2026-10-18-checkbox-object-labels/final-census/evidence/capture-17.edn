pe {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468730} {:answer-field/choices [{:answer/id #uuid "ba2ac40e-a985-5867-a362-0966d3f99fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468020} {:answer/id #uuid "a474e3ac-db74-51f8-bb44-c1af15504861" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468021}] :answer-field/correct {:answer/id #uuid "ba2ac40e-a985-5867-a362-0966d3f99fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468020} :answer-field/id #uuid "b8e4d4d7-e3ce-5f08-bdc3-01e051a4597c" :answer-field/key "$(-1,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468731}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe7192f0-0469-5c77-92a1-060194834d30" :question/math-academy-id "q-73482" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{x-1}{\\sqrt{x+1}}?$   \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,0]$ is closed, but the function is not continuous on it because it is not defined at $x=-1.$  Therefore, the extreme value theorem is not applicable.\n\n- The interval $[1,10]$ is  closed, and the function is continuous on $[1,10].$ Therefore, the extreme value theorem is applicable.\n\n- The interval  $(-1,0)$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[1,10]$ only."} {:db/id #edb/ref 17592186341986 :knowledge-point/_questions [