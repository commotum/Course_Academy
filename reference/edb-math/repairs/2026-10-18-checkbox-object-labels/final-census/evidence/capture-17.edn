hoices [{:answer/id #uuid "100f83a6-d105-585a-835c-7c9b9b59b8c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451619} {:answer/id #uuid "a78b485d-bb5b-5f50-9378-ad835cb44037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451620}] :answer-field/correct {:answer/id #uuid "a78b485d-bb5b-5f50-9378-ad835cb44037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451620} :answer-field/id #uuid "2337796b-4d0f-559b-8850-eb51b2d663f4" :answer-field/key "$b\\cdot a<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452657}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec2dfaf1-eafb-5d88-8d0f-be9d2909829b" :question/math-academy-id "q-74049" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement $a\\cdot a<0$ is false. Since $a\\ne 0$, we must have $a\\cdot a>0.$\n\n- Statement $b\\cdot a=a\\cdot a$ is false while statement $b\\cdot a<0$ is true. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\nTherefore, we conclude that the correct answer is $b\\cdot a<0$ only."} {:db/id #edb/ref 17592186342140 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186049045 :topic/id #uuid "d599481a-4f0d-50b9-8ceb-db8805f8eeee" :topic/math-academy-id 2094 :topic/title "The Dot Product in N-Dimensional Euclidean Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d84f96c-b8a2-51f6-9858-6d35b74de32b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451621} {:answer/id #uuid "2d44e4e0-9af3-583b-a878-ab37a166cbd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451622}] :answer-field/correct {:answer/id #uuid "2d84f96c-b8a2-51f6-9858-6d35b74de32b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451621} :answer-field/id #uuid "3191aba1-8c3b-544c-a448-7745b8dfff89" :answer-field/key "$a\\cdot a=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452658} {:answer-field/choices [{:answer/id #uuid "a247f262-d6e4-5450-a67b-170bc47e81aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451623} {:answer/id #uuid "17f28d17-67d0-5dc2-8fe6-3279cee00187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451624}] :answer-field/correct {:answer/id #uuid "a247f262-d6e4-5450-a67b-170bc47e81aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451623} :answer-field/id #uuid "2cf96421-3521-5d61-8614-44b48da5a736" :answer-field/key "$a\\cdot b>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452659} {:answer-field/choices [{:answer/id #uuid "51844bab-271c-5019-b872-1cab5ca37a21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451625} {:answer/id #uuid "c0622aed-18df-5638-9aa1-8074a5ea611e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451626}] :answer-field/correct {:answer/id #uuid "c0622aed-18df-5638-9aa1-8074a5ea611e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451626} :answer-field/id #uuid "7c5252e3-564e-590c-a019-c205c05e4034" :answer-field/key "$a\\cdot b<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452660}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "576bb373-56a3-5da0-ab43-2d02b000f274" :question/math-academy-id "q-74051" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement $a\\cdot a=0$ is false. Since $a\\ne 0$, we must have $a\\cdot a>0.$\n\n- Statement $a\\cdot b>0$ is false while statement $a\\cdot b<0$ is true. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ a\\cdot a+a\\cdot b & =0 \\\\ a\\cdot b & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\nTherefore, we conclude that the correct answer is $a\\cdot b<0$ only."} {:db/id #edb/ref 17592186342187 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048337 :topic/id #uuid "96874e3b-8b97-5c33-995d-d34a9d3daf21" :topic/math-academy-id 4077 :topic/title "Subspaces of N-Dimensional Space: Geometric Interpretation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5b2d85-4151-54a4-ac97-beef0024d1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468076} {:answer/id #uuid "2c392c8d-2089-591c-a70b-c5983cd9d8ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468077}] :answer-field/correct {:answer/id #uuid "1e5b2d85-4151-54a4-ac97-beef0024d1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468076} :answer-field/id #uuid "d486dc1c-3d30-5e4f-835e-f08717f52889" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\1-x-y=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468759} {:answer-field/choices [{:answer/id #uuid "465a6071-09f7-5ac0-928d-43e875a45ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468078} {:answer/id #uuid "43d1ede4-b752-517f-859b-1a7a07ade02c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468079}] :answer-field/correct {:answer/id #uuid "465a6071-09f7-5ac0-928d-43e875a45ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468078} :answer-field/id #uuid "a9c858f4-cbfb-5002-a626-7d8e4c6fc2c6" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\{x}^{2}+{y}^{2}+{z}^{2}\\le 1\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468760} {:answer-field/choices [{:answer/id #uuid "61b2f350-f63b-50a8-a1f2-5bd05dffb414" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468080} {:answer/id #uuid "f07e9305-0844-5a74-9550-81a8ec3521c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468081}] :answer-field/correct {:answer/id #uuid "f07e9305-0844-5a74-9550-81a8ec3521c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468081} :answer-field/id #uuid "0fa3dc22-e26d-5b76-84a3-23639eb52190" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\2x+3y-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468761}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e93e600-4a01-5ada-842d-9b175b57ee56" :question/math-academy-id "q-74217" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $1-x-y=0$ since $1-0-0\\ne 0.$\n\n- The set $B$ is not a subspace. Indeed, the vector $u=⟨1,0,0⟩$ is in $B$, but $2u=⟨2,0,0⟩$ is not in $B$, since ${2}^{2}+{0}^{2}+{0}^{2}≰1.$ So, $B$ is not closed under scalar multiplication.\n\n- The set $C$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $2x+3y-z=0$ since $2\\cdot 0+3\\cdot 0-0=0.$ So $0$ lies in $C.$\n\nIn conclusion, the correct answer is $\\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\2x+3y-z=0\\end{gathered}\\right\\}\\end{gathered}$ only." :step/_content [{:activity/_steps {:activity/scope 