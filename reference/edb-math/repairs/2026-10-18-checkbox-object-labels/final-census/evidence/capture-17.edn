/text} :answer/value "false" :db/id #edb/ref 17592186468084} {:answer/id #uuid "e417d014-1256-54c2-b5a6-83c0e16db7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468085}] :answer-field/correct {:answer/id #uuid "1d206fe7-45bb-5c68-ba7e-b82cba496bc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468084} :answer-field/id #uuid "8a030342-3365-5302-be22-c12324e628cc" :answer-field/key "$B={⟨x,y,z⟩\\in {R}^{3}:xyz=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468763} {:answer-field/choices [{:answer/id #uuid "1ef52cd4-5c7a-5343-89cd-f60bf03a78bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468086} {:answer/id #uuid "993adad2-e813-5acf-9d8c-0d5673935db2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468087}] :answer-field/correct {:answer/id #uuid "1ef52cd4-5c7a-5343-89cd-f60bf03a78bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468086} :answer-field/id #uuid "e56f414b-9b1b-5b30-aeec-c4089b6d4315" :answer-field/key "$C={⟨x,y,z⟩\\in {R}^{3}:y=-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468764}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5037faf6-6f8a-5ea2-800f-2c136a3bb59e" :question/math-academy-id "q-74218" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition ${x}^{2}+{y}^{2}+{z}^{2}=1$ since ${0}^{2}+{0}^{2}+{0}^{2}\\ne 1.$\n\n- The set $B$ is not a subspace because it is not closed under vector addition. Indeed, both $a=⟨1,0,1⟩$ and $b=⟨0,1,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0,1⟩+⟨0,1,1⟩=⟨1,1,2⟩\n$$\n\n \ndoes not satisfy the condition $xyz=0$ since $1\\cdot 1\\cdot 2\\ne 0.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $y=-1$ since $0\\ne -1.$\n\nSo, the correct answer is \"None.\""} {:db/id #edb/ref 17592186342191 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048337 :topic/id #uuid "96874e3b-8b97-5c33-995d-d34a9d3daf21" :topic/math-academy-id 4077 :topic/title "Subspaces of N-Dimensional Space: Geometric Interpretation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99a152a-4432-58e7-8095-7a6594ae2e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468088} {:answer/id #uuid "ed1282bf-bb72-590a-82cb-57afddffd291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468089}] :answer-field/correct {:answer/id #uuid "c99a152a-4432-58e7-8095-7a6594ae2e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468088} :answer-field/id #uuid "1bf27b0a-4178-50bb-a563-2416eaa07855" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}<\\frac{1}{2}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468765} {:answer-field/choices [{:answer/id #uuid "75291599-266c-544e-b704-be929998cc4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468090} {:answer/id #uuid "cf437d27-edd1-584d-be5b-b58d1bf9be5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468091}] :answer-field/correct {:answer/id #uuid "cf437d27-edd1-584d-be5b-b58d1bf9be5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468091} :answer-field/id #uuid "11bc94d4-2ccf-5ec6-bfea-1ec2f439dda1" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5x-y-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468766} {:answer-field/choices [{:answer/id #uuid "90497ddb-e287-5539-b1a1-cd58a7c31e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468092} {:answer/id #uuid "80442660-0495-5466-89ce-25cccd762bbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468093}] :answer-field/correct {:answer/id #uuid "90497ddb-e287-5539-b1a1-cd58a7c31e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468092} :answer-field/id #uuid "dc40e59a-282b-5ffd-8ff6-51c6739169ba" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5-x-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468767}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb81e4a8-c5a7-59da-b168-b278b747b24a" :question/math-academy-id "q-74255" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. Indeed, the vector $u=⟨\\frac{1}{4},0,0⟩$ is in $A$, since\n\n$$\n\\sqrt{{(\\frac{1}{4})}^{2}+{0}^{2}+{0}^{2}}=\\frac{1}{4}<\\frac{1}{2},\n$$\n\nbut, $4u=⟨1,0,0⟩$ is not in $B$, since \n\n$$\n\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}}>\\frac{1}{2}.\n$$\n\nSo, $A$ is not closed under scalar multiplication.\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $5x-y-z=0$ since $5\\cdot 0-0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $5-x-z=0$ since $5-0-0\\ne 0.$\n\nIn conclusion, the correct answer is $\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5x-y-z=0\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186342194 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5292e9e-deab-5423-81ea-859716c87e84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438502} {:answer/id #uuid "6e553caf-cc56-5f3d-be8a-245cca543780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438503}] :answer-field/correct {:answer/id #uuid "6e553caf-cc56-5f3d-be8a-245cca543780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438503} :answer-field/id #uuid "3ab33538-7993-5acb-9468-e0e3dd4ad807" :answer-field/key "$C$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439280} {:answer-field/choices [{:answer/id #uuid "b9bbb38a-9967-5612-8d8d-b7bb86341338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438504} {:answer/id #uuid "38526a4d-7583-5f69-ae01-76ab71dc5556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438505}] :answer-field/correct {:answer/id #uuid "b9bbb38a-9967-5612-8d8d-b7bb86341338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438504} :answer-field/id #uuid "8d6d93d9-8d6f-56cf-ac99-984802318cde" :answer-field/key "$C$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439281} {:answer-field/choices [{:answer/id #uuid "d6e70b79-a9e1-5d68-a28e-f96b03f12a43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438506} {:answer/id #uuid "9e9ac29b-2109-50ad-a691-a49a7e8a0ffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438507}] :answer-field/correct {:answer/id #uuid "d6e70b79-a9e1-5d68-a28e-f96b03f12a43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438506} :answer-field/id #uuid "e1a6caeb-050e-5490-9f4b-d0d5518bd887" :answer-field/key "${C}^{T}$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439282}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e68d4b2f-c3b6-584c-8430-662a571e8316" :question/math-academy-id "q-74318" :question/problem "Consider the matrix\n\n$$\nC=\\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $C$ is upper triangular: **True.** All the entries below the main diagonal of $C$ are zeros:\n\n$$\nC=\\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- $C$ is lower triangular: **False.** This fails because $C$ has non-zero entries above the main diagonal:\n\n$$\nC=\\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- ${C}^{T}$ is upper triangular: **False.** This fails because ${C}^{T}$ has non-zero entries below the main diagonal:\n\n$$\n{C}^{T}=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & 4 & 0 & 0 \\\\ 1 & 0 & 2 & 0 \\\\ 0 & 4 & 1 & 3\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $C$ is upper triangular."} {:db/id #edb/ref 17592186342195 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31f0fe91-c16f-5c88-98c3-6c20947ef352" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438508} {:answer/id #uuid "e7ecd97a-ece8-52f9-9c37-9224155d587f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438509}] :answer-field/correct {:answer/id #uuid "31f0fe91-c16f-5c88-98c3-6c20947ef352" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438508} :answer-field/id #uuid "2f499a2d-45d0-590b-973b-c8d0cb52b220" :answer-field/key "$D$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439283} {:answer-field/choices [{:answer/id #uuid "128b04a8-57bd-5b61-874d-aac65e3e9c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438510} {:answer/id #uuid "a75398e2-65af-5bac-9ad1-259f5a296fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438511}] :answer-field/correct {:answer/id #uuid "a75398e2-65af-5bac-9ad1-259f5a296fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438511} :answer-field/id #uuid "e425ed7f-061d-59d0-bf87-86d0b218dab4" :answer-field/key "$D$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439284} {:answer-field/choices [{:answer/id #uuid "838a0ff9-f487-5659-a60a-b8467710d4e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438512} {:answer/id #uuid "fe5b9217-4edb-562b-8962-681ef51863e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438513}] :answer-field/correct {:answer/id #uuid "fe5b9217-4edb-562b-8962-681ef51863e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438513} :answer-field/id #uuid "716e9941-8550-5bde-a973-86bb302cfd14" :answer-field/key "${D}^{T}$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439285}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10915988-162b-5dec-9de2-5241d5fc3202" :question/math-academy-id "q-74319" :question/problem "Consider the matrix\n\n$$\nD=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $D$ is upper triangular: **False.** This fails because $D$ has non-zero entries below the main diagonal:\n\n$$\nD=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\n- $D$ is lower triangular: **True.** All the entries above the main diagonal of $D$ are zeros:\n\n$$\nD=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\n- ${D}^{T}$ is upper triangular: **True.** All the entries below the main diagonal of ${D}^{T}$ are zeros:\n\n$$\n{D}^{T}=\\begin{bmatrix}3 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $D$ is lower triangular.\n- ${D}^{T}$ is upper triangular."} {:db/id #edb/ref 17592186344956 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08768d96-6543-5057-b351-a7b1e161594f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438520} {:answer/id #uuid "e55197f9-beea-5d56-b568-4686a6fafa27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438521}] :answer-field/correct {:answer/id #uuid "08768d96-6543-5057-b351-a7b1e161594f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438520} :answer-field/id #uuid "c2c63157-7a5a-5373-8ad8-5fe787c42154" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439289} {:answer-field/choices [{:answer/id #uuid "7e975cf8-6ced-5fcc-a167-0751d7c6d489" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438522} {:answer/id #uuid "6a5469f6-81d5-5ff6-93db-790de506e3a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438523}] :answer-field/correct {:answer/id #uuid "7e975cf8-6ced-5fcc-a167-0751d7c6d489" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438522} :answer-field/id #uuid "bc9e9ab2-76ef-5705-8ab7-acb52a0677b5" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439290} {:answer-field/choices [{:answer/id #uuid "2583daa7-3471-5757-b97e-74aae9210e3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438524} {:answer/id #uuid "56894365-ac99-5761-9fdc-76740ad849bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438525}] :answer-field/correct {:answer/id #uuid "56894365-ac99-5761-9fdc-76740ad849bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438525} :answer-field/id #uuid "fd6825c7-6c00-5310-b8fa-2fe4fbc48f05" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439291}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edc80b1b-d469-5071-b24d-3c90bb47fce6" :question/math-academy-id "q-74635" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-2x+4y+3z &=0 \\\\ x+3y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 1 & 3 & 0 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 1 & 3 & 0 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 0 & 5 & \\frac{3}{2} & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means that  we can find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement “The system is consistent dependent” is true."} {:db/id #edb/ref 17592186344957 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d964555-6f83-5191-89db-fd72ffdf14c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438526} {:answer/id #uuid "ad751ae7-e25b-5406-b9e3-27ea4cbed2f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438527}] :answer-field/correct {:answer/id #uuid "0d964555-6f83-5191-89db-fd72ffdf14c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438526} :answer-field/id #uuid "ae1a0230-4005-55bc-8174-e0944a31dd3e" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439292} {:answer-field/choices [{:answer/id #uuid "3be3c581-4293-5cdb-b090-f3c480d1c024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438528} {:answer/id #uuid "89e07487-bb39-5368-bf53-e4b20abb5d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438529}] :answer-field/correct {:answer/id #uuid "89e07487-bb39-5368-bf53-e4b20abb5d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438529} :answer-field/id #uuid "d62a54fe-bb91-5a39-8c45-d4f5ab79b9a1" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439293} {:answer-field/choices [{:answer/id #uuid "4d848cbc-71b2-5e07-ad3c-93e27231b7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438530} {:answer/id #uuid "82fdc104-5ebd-5054-99d2-64d287c3ea35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438531}] :answer-field/correct {:answer/id #uuid "4d848cbc-71b2-5e07-ad3c-93e27231b7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438530} :answer-field/id #uuid "a883d2db-1de6-5620-afb1-bd3d06ab629d" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0089d19-a4b5-5ec4-beaa-917a294458ba" :question/math-academy-id "q-74637" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=-1 \\\\ x-2y &=1 \\\\ -x-5y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 2 & 3 & -1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & -7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=1 \\\\ 7y &=-3.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=-\\frac{3}{7}.$ Substituting this into the first equation, we get\n\n$$\nx-2(-\\frac{3}{7})=1\\,⟹\\,x=\\frac{1}{7}.\n$$\n\n \nSo, we conclude that the system is consistent independent. \n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186345004 :knowledge-point/_questions [{:db/id #edb/ref 17592186124457 :knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed" :knowledge-point/title "Calculating Limits Along Different Paths for Multivariable Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048449 :topic/id #uuid "a05758d1-f2b4-5a86-b7b0-c2a4bb6dcb85" :topic/math-academy-id 1931 :topic/title "Limits and Continuity of Multivariable Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f3e9a8-09a1-5f57-86fa-04e7b6915e56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468094} {:answer/id #uuid "78fcd3c1-4a11-58fd-8ce6-df88fc49f25d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468095}] :answer-field/correct {:answer/id #uuid "78fcd3c1-4a11-58fd-8ce6-df88fc49f25d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468095} :answer-field/id #uuid "2c6cf87b-5ae8-56c1-a044-0835a6c8cde4" :answer-field/key "The limit evaluates to $0$ along the path $y=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468768} {:answer-field/choices [{:answer/id #uuid "311f4a3b-6073-5441-be15-0e0c7cc774ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468096} {:answer/id #uuid "88d6ad28-2d86-517c-95bc-f86d6c74568c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468097}] :answer-field/correct {:answer/id #uuid "88d6ad28-2d86-517c-95bc-f86d6c74568c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468097} :answer-field/id #uuid "d491b47c-a016-53fb-a14f-bea3b0d37235" :answer-field/key "The limit evaluates to $2$ along the path $y={x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468769} {:answer-field/choices [{:answer/id #uuid "b5f46b92-20fa-5e06-82d5-4d57f3b2567e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468098} {:answer/id #uuid "5c70d63f-3608-5e38-a9a1-5aca4eef4730" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468099}] :answer-field/correct {:answer/id #uuid "b5f46b92-20fa-5e06-82d5-4d57f3b2567e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468098} :answer-field/id #uuid "a0d14fb0-548c-5014-9418-0de578d5c27b" :answer-field/key "The limit exists and is equal to $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5fe00a2-ab56-5281-b3c2-6fe8dad2417a" :question/math-academy-id "q-74964" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}\n$$\n\nSelect all that apply." :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement “The limit evaluates to $0$ along the path $y=x$” is true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-x} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{x(2x-1)} \\\\  & ={lim}_{x\\to 0}\\frac{2x}{2x-1} \\\\  & =\\frac{2\\cdot 0}{2\\cdot 0-1} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement “The limit evaluates to $2$ along the path $y={x}^{2}$” is also true. Taking $x\\to (0,0)$ along the path $y={x}^{2},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2\\end{aligned}\n$$\n\n- Statement “The limit exists and is equal to $2$” is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\text{DNE}\n$$"} {:db/id #edb/ref 17592186345029 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048743 :topic/id #uuid "ba8c9515-59e3-55c9-9d86-1de6e55c5474" :topic/math-academy-id 1779 :topic/title "LU Factorization of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aff888b-3abd-519a-b020-976dc34f4245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468100} {:answer/id #uuid "25a7ba29-bc65-581b-9964-6c11c222d79f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468101}] :answer-field/correct {:answer/id #uuid "3aff888b-3abd-519a-b020-976dc34f4245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468100} :answer-field/id #uuid "4f47bd49-5b77-5103-8d2d-487667211ef5" :answer-field/key "$C=\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468771} {:answer-field/choices [{:answer/id #uuid "7cbf7e8b-34e0-5ba3-bf96-0aa8c395b97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468102} {:answer/id #uuid "a74eb240-f723-5f61-8cdf-f327609c7cf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468103}] :answer-field/correct {:answer/id #uuid "7cbf7e8b-34e0-5ba3-bf96-0aa8c395b97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468102} :answer-field/id #uuid "1002dbbd-d4c2-58a4-9d7a-a603394b05ab" :answer-field/key "$C=\\begin{bmatrix}3 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468772} {:answer-field/choices [{:answer/id #uuid "323a7811-4035-5802-b65f-fa37ee80f272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468104} {:answer/id #uuid "6196d8dc-3375-5b48-89b1-f58fc5a8344c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468105}] :answer-field/correct {:answer/id #uuid "6196d8dc-3375-5b48-89b1-f58fc5a8344c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468105} :answer-field/id #uuid "3c3ed68e-ffbd-5c3c-9b32-90b080f28a48" :answer-field/key "$C=\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468773}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89a636cd-a216-5d73-bd3f-7f9cbe4badf4" :question/math-academy-id "q-75116" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\nSelect all that apply." :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overbrace{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}^{L}\\cdot \\overbrace{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}^{U}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form  because  the matrix on the left is not a unit lower triangular matrix, as its main diagonal contains a number not equal to $1.$\n\n$$\nC=\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 1\\end{bmatrix}\\,\\times \n$$\n\n- The second product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nC=\\begin{bmatrix}3 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 4\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is $C=\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 4\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186345030 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048743 :topic/id #uuid "ba8c9515-59e3-55c9-9d86-1de6e55c5474" :topic/math-academy-id 1779 :topic/title "LU Factorization of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e49e90f-76ff-5359-a83b-d19ac304cc98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468106} {:answer/id #uuid "10dda677-3970-5dca-925d-f1fd92be396a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468107}] :answer-field/correct {:answer/id #uuid "9e49e90f-76ff-5359-a83b-d19ac304cc98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468106} :answer-field/id #uuid "c64d7a54-ae7c-59e3-b98f-bb2beec3e574" :answer-field/key "$A=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468774} {:answer-field/choices [{:answer/id #uuid "0861ba46-156e-530e-b250-d70406ef7823" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468108} {:answer/id #uuid "2ceee5b2-6950-50cb-8401-965ea76654fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468109}] :answer-field/correct {:answer/id #uuid "0861ba46-156e-530e-b250-d70406ef7823" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468108} :answer-field/id #uuid "2077df0d-33ac-5ccf-9556-c6e7cc2502c2" :answer-field/key "$A=\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468775} {:answer-field/choices [{:answer/id #uuid "49ff15f0-f00d-52b8-b7dc-4e1b5d1b9bde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468110} {:answer/id #uuid "c91cd91b-5643-5712-a070-3652a02db457" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468111}] :answer-field/correct {:answer/id #uuid "c91cd91b-5643-5712-a070-3652a02db457" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468111} :answer-field/id #uuid "0accbf5a-ff99-5165-88e6-f3ee36af91b4" :answer-field/key "$A=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ 0 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468776}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0305a43d-bf81-5ecb-8a77-49a30ade0147" :question/math-academy-id "q-75117" :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\nSelect all that apply." :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:  \n\n$$\nA=\\overbrace{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}^{L}\\cdot \\overbrace{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}^{U}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$  on the main diagonal.\n\n$$\nA=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ 0 & 1\\end{bmatrix}\\,\\times \n$$\n\n- The second product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal. \n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 2\\end{bmatrix}\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ 0 & 2\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is $A=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ 0 & 2\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186345033 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048743 :topic/id #uuid "ba8c9515-59e3-55c9-9d86-1de6e55c5474" :topic/math-academy-id 1779 :topic/title "LU Factorization of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62ddc631-4c21-5b83-858a-b840b32aee4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468112} {:answer/id #uuid "d8b9dd2e-47fe-5d22-ae99-25d7bbdf4e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468113}] :answer-field/correct {:answer/id #uuid "d8b9dd2e-47fe-5d22-ae99-25d7bbdf4e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468113} :answer-field/id #uuid "5cc8d71a-f7ed-5fdf-86fe-f45189c1e899" :answer-field/key "$C=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468777} {:answer-field/choices [{:answer/id #uuid "b7bdcb06-e317-5a3a-9e70-02fe6708ee55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468114} {:answer/id #uuid "4beb574c-ecdc-5730-ab4c-de665302867c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468115}] :answer-field/correct {:answer/id #uuid "b7bdcb06-e317-5a3a-9e70-02fe6708ee55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468114} :answer-field/id #uuid "f99708f6-d8a6-5891-8014-c3ac976cd0cb" :answer-field/key "$C=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468778} {:answer-field/choices [{:answer/id #uuid "e6d9a215-990f-586e-ad1c-3e2aebcf2b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468116} {:answer/id #uuid "a9ba30f6-0f69-5996-859d-f153859fd7d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468117}] :answer-field/correct {:answer/id #uuid "e6d9a215-990f-586e-ad1c-3e2aebcf2b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468116} :answer-field/id #uuid "a971bb90-3bc7-54d6-93ec-562b99c29957" :answer-field/key "$C=\\begin{bmatrix}0 & 0 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34143660-ecfa-5585-b65e-76b215171706" :question/math-academy-id "q-75123" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\nSelect all that apply." :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overbrace{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}^{L}\\cdot \\overbrace{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}^{U}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}\\,✓\n$$\n\n- The second product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has a non-zero entry above the main diagonal. \n\n$$\nC=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 0 & 0\\end{bmatrix}\\,\\times \n$$\n\n- The third product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$ on the main diagonal.\n\n$$\nC=\\begin{bmatrix}0 & 0 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 1\\end{bmatrix}\\,\\times \n$$\n\nTherefore, the correct answer is $C=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186345092 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048920 :topic/id #uuid "cc887b1d-8841-507d-a99b-b7888c08a675" :topic/math-academy-id 1728 :topic/title "Finding the Inverse of a 2x2 Matrix Using Row Operations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85e64603-bb6e-5b0f-a72d-80a8ccc3450d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468118} {:answer/id #uuid "bb5f4f63-4be8-5a5b-b8cd-fa7559af4fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468119}] :answer-field/correct {:answer/id #uuid "85e64603-bb6e-5b0f-a72d-80a8ccc3450d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468118} :answer-field/id #uuid "c1db1d1e-60e6-5396-8aa1-ee91b508535f" :answer-field/key "$A=\\begin{bmatrix}1 & 5 \\\\ 1 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468780} {:answer-field/choices [{:answer/id #uuid "e2a0153d-23de-5108-888f-f2b222f9131f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468120} {:answer/id #uuid "9cd47bee-3079-5cc3-a48e-29d195deb027" :answer/type {:db/id #edb/