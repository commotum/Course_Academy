b/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468733} {:answer-field/choices [{:answer/id #uuid "4850f6e7-44e4-5c2c-ab1c-1fd4345196e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468026} {:answer/id #uuid "5d89fdc2-6b87-505d-9741-6111f42f5c7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468027}] :answer-field/correct {:answer/id #uuid "5d89fdc2-6b87-505d-9741-6111f42f5c7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468027} :answer-field/id #uuid "bafe51e4-c08a-55a8-b1fd-0a9ee0fb0ef6" :answer-field/key "$[0,\\frac{\\pi }{2}]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468734}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aba1141-c0a4-54c1-bd64-30eb78786676" :question/math-academy-id "q-73484" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\sqrt{\\operatorname{cos}⁡x}?$    \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{\\pi }{2},\\pi ]$  is closed, but the function is not defined on a part of the interval because $\\operatorname{cos}⁡(x)<0$ for all $x\\in (\\frac{\\pi }{2},\\pi ].$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[\\frac{\\pi }{4},\\frac{\\pi }{2})$    is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{2}]$ is  closed, and the function is continuous on $[0,\\frac{\\pi }{2}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is $[0,\\frac{\\pi }{2}]$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"} :activity/title "The Extreme Value Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508384} :db/id #edb/ref 17592186509003}]} {:db/id #edb/ref 17592186341987 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba67c5c0-96ba-5252-813f-4cd1114b1c90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468028} {:answer/id #uuid "13ba8213-a2f7-566e-b980-36df26232e53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468029}] :answer-field/correct {:answer/id #uuid "13ba8213-a2f7-566e-b980-36df26232e53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468029} :answer-field/id #uuid "ae902587-9446-5ee5-a8a7-4011193f99b5" :answer-field/key "$[\\frac{1}{2},1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468735} {:answer-field/choices [{:answer/id #uuid "d08d9480-93aa-548c-b362-0d3f72fe027e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468030} 