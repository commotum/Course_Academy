nt :answer-field.type/checkbox} :db/id #edb/ref 17592186468393} {:answer-field/choices [{:answer/id #uuid "318f23fd-6e6e-5438-b299-91c5b04affe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467346} {:answer/id #uuid "c6d9b6d1-db0c-5dae-9ea0-9ca2ce06e302" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467347}] :answer-field/correct {:answer/id #uuid "318f23fd-6e6e-5438-b299-91c5b04affe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467346} :answer-field/id #uuid "2314e92e-ec9c-5ccb-abec-616ce9b04051" :answer-field/key "${Q}^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468394} {:answer-field/choices [{:answer/id #uuid "7ad04bcd-ec49-5b4d-9ed2-1a08b50d1686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467348} {:answer/id #uuid "26e60de3-6a9a-57a5-9dff-c4a4e48f2a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467349}] :answer-field/correct {:answer/id #uuid "7ad04bcd-ec49-5b4d-9ed2-1a08b50d1686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467348} :answer-field/id #uuid "7dee68bc-a430-5c4c-bd73-876dd575e220" :answer-field/key "${Z}^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fc9ff9e-591c-5172-b83a-e2856d63bd94" :question/math-academy-id "q-36248" :question/problem "To which of the following sets do all the positive integers belong?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The positive integer numbers are $1,2,3,…$\n\n- Since all positive integer numbers are natural numbers, all the positive integers belong to $N.$ $\\,✓$\n\n- Since all positive integer numbers are positive real numbers, all the positive integer numbers belong to ${R}^{+}.$ $\\,✓$\n\n- The set ${Q}^{-}$ contains all the negative rational numbers. However, positive integer numbers as, for instance, $2$ don't belong to ${Q}^{-},$ so ${Q}^{-}$ does *not* contain the positive integer numbers. $\\,\\times $\n\n- The set ${Z}^{-}$ contains all the negative integer numbers. However, positive integer numbers as, for instance, $2$ don't belong to ${Z}^{-},$ so ${Z}^{-}$ does *not* contain the positive integer numbers. $\\,\\times $\n\nTherefore, the correct answer is “$N$ (natural numbers)”; ${R}^{+}$ only."} {:db/id #edb/ref 17592186323843 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors" :topic/_knowledge-points [{:db/id #edb/ref 17592186048819 :topic/id #uuid "c29ac9c3-f2c1-572b-9251-f82101c5a30e" :topic/math-academy-id 1375 :topic/title "The Eigenvalues and Eigenvectors of a 2x2 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ed2777a-34cb-534d-a3c0-f46d98a7f57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467350} {:answer/id #uuid "382ea96b-f840-5089-97ad-613a3c3ea86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467351}] :answer-field/correct {:answer/id #uuid "382ea96b-f840-5089-97ad-613a3c3ea86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467351} :answer-field/id #uuid "cf044f59-5458-5a3f-9122-e042b2ce2609" :answer-field/key "$v=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468396} {:answer-field/choices [{:answer/id #uuid "56892055-3446-54d3-b7c7-091f7041424b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467352} {:answer/id #uuid "97140039-2706-5181-86d8-83d99a14c98f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467353}] :answer-field/correct {:answer/id #uuid "56892055-3446-54d3-b7c7-091f7041424b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467352} :answer-field/id #uuid "1b33e161-c9a5-5c82-a2b4-80ffc8368590" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $-v$ is an eigenvector of $A$ corresponding to $\\lambda =-2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468397} {:answer-field/choices [{:answer/id #uuid "2c95eee0-8ca5-5722-b7c5-52773baa10a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467354} {:answer/id #uuid "af46bc38-7ce0-5c3a-9720-7658d86d8093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467355}] :answer-field/correct {:answer/id #uuid "af46bc38-7ce0-5c3a-9720-7658d86d8093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467355} :answer-field/id #uuid "d185ed44-db67-5969-a945-aa27c7caa20f" :answer-field/key "$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "187c7a1d-e687-5fd7-b36a-8bd4869c300f" :question/math-academy-id "q-36678" :question/problem "Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “$v=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $2.$” is true. We have \n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -4\\end{bmatrix} \\\\  & =2\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =2v.\\end{aligned}\n$$\n\nSince $Av=2v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $-v$ is an eigenvector of $A$ corresponding to $\\lambda =-2.$” is false. We have\n\n$$\n\\begin{aligned}A(-v)=-Av=-(2v)=2(-v).\\end{aligned}\n$$\n\nSince, $A(-v)=2(-v),$ and $-v\\ne 0,$ this implies that $-v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2$ (but not $-2$).\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $0.$” is true. We have \n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =0\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =0v.\\end{aligned}\n$$\n\nSince $Av=0v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =0.$\n\nTherefore, the correct answer is “$v=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $2.$”; “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $0.$” only."} {:db/id #edb/ref 17592186323858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors" :topic/_knowledge-points [{:db/id #edb/ref 17592186048819 :topic/id #uuid "c29ac9c3-f2c1-572b-9251-f82101c5a30e" :topic/math-academy-id 1375 :topic/title "The Eigenvalues and Eigenvectors of a 2x2 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83ea7e4d-2142-5b09-923c-d1732b846aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467356} {:answer/id #uuid "d55181ee-827a-5082-8727-316c1c665376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467357}] :answer-field/correct {:answer/id #uuid "d55181ee-827a-5082-8727-316c1c665376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467357} :answer-field/id #uuid "80fb52f1-d337-52da-ab2b-f0e26b72af8a" :answer-field/key "If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468399} {:answer-field/choices [{:answer/id #uuid "69f8eeec-acb8-50ef-b931-56646b1a48a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467358} {:answer/id #uuid "95027d50-dda7-59a1-90d9-fcb2fc8d7016" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467359}] :answer-field/correct {:answer/id #uuid "69f8eeec-acb8-50ef-b931-56646b1a48a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467358} :answer-field/id #uuid "f91083d4-1dec-5899-9c25-5a1767f35d18" :answer-field/key "An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468400} {:answer-field/choices [{:answer/id #uuid "e8cdfafa-f8c6-57ed-9615-9c048196643d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467360} {:answer/id #uuid "773e58d3-1733-5646-800f-a4d36ca8f057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467361}] :answer-field/correct {:answer/id #uuid "773e58d3-1733-5646-800f-a4d36ca8f057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467361} :answer-field/id #uuid "c66eca36-f5d2-521d-aeda-fb7f80625ed9" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468401}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1d99b1dd-fcce-5575-b1d6-40adbcb0e805" :question/math-academy-id "q-36865" :question/problem "Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$” is true. By the definition of an eigenvector, we have \n\n$$\nAv=3v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=3{A}^{-1}v.\n$$\n\nDividing both sides by $3$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{3}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{3}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement “An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =2.$” is false. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =2$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{2}.$\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$” is true. We have\n\n$$\n\\begin{aligned}A(5v)=5Av=5(-3v)=-3(5v).\\end{aligned}\n$$\n\nSince, $A(5v)=-3(5v),$ and $5v\\ne 0,$ this implies that $5v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is “If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$”; “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$” only."} {:db/id #edb/ref 17592186323865 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c89bf3bc-912d-524b-b8c7-166e854b250f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438242} {:answer/id #uuid "c6255188-de6f-5359-b3ce-b11fa26ffa9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438243}] :answer-field/correct {:answer/id #uuid "c89bf3bc-912d-524b-b8c7-166e854b250f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438242} :answer-field/id #uuid "35f5bf02-6bde-5643-acf0-85bec1bb3263" :answer-field/key "$x\\in [-2,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439150} {:answer-field/choices [{:answer/id #uuid "c10d5b55-5751-534e-848f-312026170d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438244} {:answer/id #uuid "e0e0d146-26cc-5512-87e3-871fc6ff47b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438245}] :answer-field/correct {:answer/id #uuid "e0e0d146-26cc-5512-87e3-871fc6ff47b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438245} :answer-field/id #uuid "edb61cc5-3d51-546d-9186-fa06d6294e86" :answer-field/key "$x\\in (-3,-2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439151} {:answer-field/choices [{:answer/id #uuid "af022492-4d4b-5fe8-ace0-066ff89badcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438246} {:answer/id #uuid "d1341450-0c68-5e67-bd60-bd2b0eef6a3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438247}] :answer-field/correct {:answer/id #uuid "af022492-4d4b-5fe8-ace0-066ff89badcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438246} :answer-field/id #uuid "781dd2b1-5946-5698-92e6-edc4b9e58172" :answer-field/key "$x\\in (-3,-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b24e31b-6e93-5c8b-93d0-5c6b5852eeb3" :question/math-academy-id "q-36934" :question/problem "![](images/1e/1eccd6630b69558f8a86f8336e9f0e49f37ffb29acf4a3c8f58be34346b4c93c.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply." :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The given function is **not** invertible on each of the intervals $x\\in [-2,0]$  and $x\\in (-3,-1]$ because some horizontal lines will intersect the curve more than once.\n\n![](images/d8/d8cc826df6fed7a4106539d88ffa8a1fdc0529904497c2d5413f9761acaccd12.png)\n\n        \n\n- The given function is invertible on the interval $x\\in (-3,-2].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/bc/bc00ed8f4bdf03b248dbd9a1651ed073e352d512b830139505fba3b60e05e7e9.png)\n\nTherefore, the correct answer is \" $x\\in (-3,-2]$ only\"."} {:db/id #edb/ref 17592186323877 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors" :topic/_knowledge-points [{:db/id #edb/ref 17592186048819 :topic/id #uuid "c29ac9c3-f2c1-572b-9251-f82101c5a30e" :topic/math-academy-id 1375 :topic/title "The Eigenvalues and Eigenvectors of a 2x2 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33f5d441-8d4b-58c1-8c22-addd3278df62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467362} {:answer/id #uuid "5290a625-f39a-53d8-892c-452c72d705f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467363}] :answer-field/correct {:answer/id #uuid "5290a625-f39a-53d8-892c-452c72d705f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467363} :answer-field/id #uuid "c7fc9d30-3ccb-5565-83ba-123a94e4a7f6" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468402} {:answer-field/choices [{:answer/id #uuid "412514e3-a9e7-5613-a307-779d4d58279b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467364} {:answer/id #uuid "ee9e4674-ca29-59e5-8966-974fa679ea90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467365}] :answer-field/correct {:answer/id #uuid "ee9e4674-ca29-59e5-8966-974fa679ea90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467365} :answer-field/id #uuid "32d88f51-d3f8-5b52-a864-157037e8ae37" :answer-field/key "$v=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $6.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468403} {:answer-field/choices [{:answer/id #uuid "f4c67b74-bb04-5491-ad72-7bd19c8d5879" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467366} {:answer/id #uuid "3b128b1a-4960-589c-b9b3-e50d9b123f91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467367}] :answer-field/correct {:answer/id #uuid "3b128b1a-4960-589c-b9b3-e50d9b123f91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467367} :answer-field/id #uuid "102ab22e-5d62-5644-8b69-6d1e5e3127ad" :answer-field/key "$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $4.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcdf208-8bdf-5d43-b755-321074d52b2d" :question/math-academy-id "q-37090" :question/problem "Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$” is true. We have\n\n$$\n\\begin{aligned}A(10v)=10Av=10(5v)=5(10v).\\end{aligned}\n$$\n\nSince, $A(10v)=5(10v),$ and $10v\\ne 0,$ this implies that $10v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =5.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement “$v=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $6.$” is true. We have\n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 \\\\ 18\\end{bmatrix} \\\\  & =6\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\  & =6v.\\end{aligned}\n$$\n\nSince $Av=6v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =6.$\n\n- Statement “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $4.$” is true. We have \n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 4\\end{bmatrix} \\\\  & =4\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =4v.\\end{aligned}\n$$\n\nSince $Av=4v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =4.$\n\nTherefore, the correct answer is “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$”; “$v=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $6.$”; “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $4.$”."} {:db/id #edb/ref 17592186323893 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a318415-af17-5fcb-90b3-4e147fe1e830" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450572} {:answer/id #uuid "12648c58-bd6b-5bfb-ba68-38821d15483a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450573}] :answer-field/correct {:answer/id #uuid "1a318415-af17-5fcb-90b3-4e147fe1e830" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450572} :answer-field/id #uuid "13533289-5901-5512-b94b-2e7969173948" :answer-field/key "$A⊆B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451240} {:answer-field/choices [{:answer/id #uuid "df2cf1ee-6702-59fe-8e01-8d9293eb42db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450574} {:answer/id #uuid "9631eefa-83a6-5406-8ce1-0b4a0bf5727f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450575}] :answer-field/correct {:answer/id #uuid "df2cf1ee-6702-59fe-8e01-8d9293eb42db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450574} :answer-field/id #uuid "111fb8ec-8507-5fc9-adc0-2a0d4fd97494" :answer-field/key "$B⊆A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451241} {:answer-field/choices [{:answer/id #uuid "cc3ac701-f2b7-51d3-9617-126db7db1e2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450576} {:answer/id #uuid "3d3fbad1-5c47-5cd3-ba33-710b96fa6475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450577}] :answer-field/correct {:answer/id #uuid "3d3fbad1-5c47-5cd3-ba33-710b96fa6475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450577} :answer-field/id #uuid "192cd3c4-7c44-5235-af6c-f4ef5919d344" :answer-field/key "$∅⊆A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451242}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac28aad1-833b-50ff-aaf3-b0e247f97248" :question/math-academy-id "q-37260" :question/problem "Which of the following statements are true for the sets $A={x\\in N:3\\le x<9}$ and $B={x\\in N:3x<10}?$\n\nSelect all that apply." :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all natural numbers greater than or equal to $3$ but less than $9.$ So,\n\n$$\nA={3,4,5,6,7,8}.\n$$\n\n- On the other hand, the elements of the set $B$ are natural numbers which satisfy the inequality $3x<10.$ So,\n\n$$\nB={1,2,3}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false. For example, $4\\in A$ but $4\\notin B.$\n\n- $B⊆A$ is false. For example, $1\\in B$ but $1\\notin A.$\n\n- $∅⊆A$ is true. The null set $∅={}$ is a subset of *every* set.\n\nTherefore, the correct answer is $∅⊆A$ only."} {:db/id #edb/ref 17592186323894 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5ec21c1-52fd-5aea-87a3-631b1273b5d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450578} {:answer/id #uuid "11dfff47-9d8a-5144-956f-42e803ff6f4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450579}] :answer-field/correct {:answer/id #uuid "b5ec21c1-52fd-5aea-87a3-631b1273b5d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450578} :answer-field/id #uuid "a94ef6a1-baa2-5132-850f-574dc1956238" :answer-field/key "$A⊈B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451243} {:answer-field/choices [{:answer/id #uuid "504c8bbd-d545-50e8-8439-406e19741076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450580} {:answer/id #uuid "6fe96844-1e6b-5c36-9eb2-60bae2c72f95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450581}] :answer-field/correct {:answer/id #uuid "6fe96844-1e6b-5c36-9eb2-60bae2c72f95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450581} :answer-field/id #uuid "151b22e6-61ad-590c-82a8-2a6a225e61e3" :answer-field/key "$∅⊆B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451244} {:answer-field/choices [{:answer/id #uuid "9bdf958c-906a-5454-9ac2-5585761a3f38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450582} {:answer/id #uuid "2d0434c9-f156-5200-acb2-9ec3d3be7b1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450583}] :answer-field/correct {:answer/id #uuid "9bdf958c-906a-5454-9ac2-5585761a3f38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450582} :answer-field/id #uuid "d1c4f18c-d35b-523c-a397-c7d92a501f62" :answer-field/key "$B⊆A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451245} {:answer-field/choices [{:answer/id #uuid "21ffccea-3a10-52a2-b505-5bca2669d5ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450584} {:answer/id #uuid "b128915e-f641-5a92-8fc3-36ecdb275671" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450585}] :answer-field/correct {:answer/id #uuid "21ffccea-3a10-52a2-b505-5bca2669d5ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450584} :answer-field/id #uuid "aff1d921-f2fc-5adb-9de5-6f6e814e0541" :answer-field/key "$A⊇B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7fab40d0-11c4-5889-9e14-2d675fe9ad31" :question/math-academy-id "q-37261" :question/problem "Which of the following statements are true for the sets $A={2{n}^{2}∣n\\in N,1\\le n\\le 3}$ and $B={2,0,8,18}?$\n\nSelect all that apply." :question/worked-solution "First, we must find the elements of the set $A.$ Substituting the values $n\\in {1,2,3}$ into the formula $2{n}^{2},$ we get the following elements:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,2\\cdot {1}^{2}=2 \\\\ n=2 & \\,⇒\\,2\\cdot {2}^{2}=8 \\\\ n=3 & \\,⇒\\,2\\cdot {3}^{2}=18\\end{aligned}\n$$\n\nSo, we have\n\n$$\nA={2,8,18}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊈B$ is false. Every element in the set $A$ is an element of the set $B.$\n\n- $∅⊆B$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊆A$ is false. For example, $0\\in B$ but $0\\notin A.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is false.\n\nTherefore, the correct answer is $∅⊆B$ only."} {:db/id #edb/ref 17592186323897 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f131b8b1-8827-5910-a5ac-d78c1fa32fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467368} {:answer/id #uuid "d7fe3ea3-1ffb-5ce4-a18e-7faebf5b67f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467369}] :answer-field/correct {:answer/id #uuid "d7fe3ea3-1ffb-5ce4-a18e-7faebf5b67f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467369} :answer-field/id #uuid "c2f37772-fd8a-5ee6-811b-4cc121bab3be" :answer-field/key "$B=\\{3n:n\\in N,1\\le n\\le 4\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468405} {:answer-field/choices [{:answer/id #uuid "02753f86-4fce-54fb-9c0e-2207db70647c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467370} {:answer/id #uuid "91b8f2c7-6a27-5fb4-8a55-5077501e753b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467371}] :answer-field/correct {:answer/id #uuid "91b8f2c7-6a27-5fb4-8a55-5077501e753b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467371} :answer-field/id #uuid "cded1df7-9c19-5aca-a016-6ac3bfc68f47" :answer-field/key "$C=\\{6n:n\\in N,1\\le n\\le 3\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468406} {:answer-field/choices [{:answer/id #uuid "b9ac8087-537f-59ff-8200-7a77fbe85624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467372} {:answer/id #uuid "4f3f1e92-dc35-5eaf-ae91-e7233b4568ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467373}] :answer-field/correct {:answer/id #uuid "b9ac8087-537f-59ff-8200-7a77fbe85624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467372} :answer-field/id #uuid "d07afc69-ca10-5308-a2ef-96a874386ca9" :answer-field/key "$D=\\{2n:n\\in N,1\\le n\\le 4\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c42f9a6a-c252-590f-89ec-76e86350914b" :question/math-academy-id "q-37266" :question/problem "Which of the following sets is a subset of $A=\\{3,6,9,12,15,18,21,…\\}?$\n\nSelect all that apply." :question/worked-solution "First, we must find the elements of the sets $B,C$ and $D.$\n\n- We find the elements of the set $B$ substituting the values $n\\in \\{1,2,3,4\\}$ into the formula $3n,$ and we get the following elements:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,3(1)=3 \\\\ n=2 & \\,⇒\\,3(2)=6 \\\\ n=3 & \\,⇒\\,3(3)=9 \\\\ n=4 & \\,⇒\\,3(4)=12\\end{aligned}\n$$\n\nSo we have, $B=\\{3,6,9,12\\}.$\n\n- On the other hand, the elements of the set $C$ can be found substituting the values $n\\in \\{1,2,3\\}$ into the formula $6n,$ and we get the following:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,6(1)=6 \\\\ n=2 & \\,⇒\\,6(2)=12 \\\\ n=3 & \\,⇒\\,6(3)=18\\end{aligned}\n$$\n\nTherefore, $C=\\{6,12,18\\}.$\n\n- Finally, the elements of the set $D$ can be found substituting the values $n\\in \\{1,2,3,4\\}$ into the formula $2n,$ and we get:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,2(1)=2 \\\\ n=2 & \\,⇒\\,2(2)=4 \\\\ n=3 & \\,⇒\\,2(3)=6 \\\\ n=4 & \\,⇒\\,2(4)=8\\end{aligned}\n$$\n\nSo we have, $D=\\{2,4,6,8\\}.$\n\nNow, a set is a subset of $A$ if all of its elements are also elements of $A.$ With that in mind, let's inspect each option.\n\n- $B=\\{3,6,9,12\\}$ is a subset of $A.\\,✓$\n\n- $C=\\{6,12,18\\}$ is a subset of $A.\\,✓$\n\n- $D=\\{2,4,6,8\\}$ is *not* a subset of $A$ because it contains the element $2\\notin A.\\,\\times $\n\nTherefore, the correct answer is $B=\\{3n:n\\in N,1\\le n\\le 4\\}$; $C=\\{6n:n\\in N,1\\le n\\le 3\\}$ only."} {:db/id #edb/ref 17592186323898 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets" :topic/_knowledge-points [{:db/id #edb/ref 17592186050923 :topic/id #uuid "723d1f9c-b696-511c-b5e5-88c045fe7609" :topic/math-academy-id 50 :topic/title "Subsets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89f21c4a-93c8-548f-8c4d-bb755dd17e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450586} {:answer/id #uuid "958c3be8-463c-5ec4-b871-935267f79fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450587}] :answer-field/correct {:answer/id #uuid "958c3be8-463c-5ec4-b871-935267f79fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450587} :answer-field/id #uuid "b95ab62e-0d04-5f23-9890-187fec1efb3e" :answer-field/key "$B⊆A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451247} {:answer-field/choices [{:answer/id #uuid "42cba8ed-d55d-56ec-9d4b-efd82f796bf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450588} {:answer/id #uuid "a9202d2e-57a2-5dbf-b710-5def44bb60cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450589}] :answer-field/correct {:answer/id #uuid "42cba8ed-d55d-56ec-9d4b-efd82f796bf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450588} :answer-field/id #uuid "92cdc7f5-a8ce-58c6-856d-34aeff58a258" :answer-field/key "$A⊆B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451248} {:answer-field/choices [{:answer/id #uuid "1448a45b-9aa9-5235-8ea8-b5e74cbfc4fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450590} {:answer/id #uuid "aa1e20a3-2d00-5edc-82dd-cccb7dfe1f31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450591}] :answer-field/correct {:answer/id #uuid "aa1e20a3-2d00-5edc-82dd-cccb7dfe1f31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450591} :answer-field/id #uuid "f8e4a50c-b87c-5e4d-88a1-e33c5b57c607" :answer-field/key "$A⊈B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451249} {:answer-field/choices [{:answer/id #uuid "52a72544-303f-5a4c-a46c-e62d55037959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450592} {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593}] :answer-field/correct {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593} :answer-field/id #uuid "e6475119-a024-5d8a-8708-d3d59741c388" :answer-field/key "$A⊇B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d3f90-ae5f-56ba-9210-f0c988989a62" :question/math-academy-id "q-37267" :question/problem "Which of the following statements are true for the sets $A={5,10,15,20,25,30,35,…}$ and $B={5n∣n\\in N,3\\le n\\le 7}?$\n\nSelect all that apply." :question/worked-solution "First, we must find the elements of the set $B.$ Substituting the values $n\\in {3,4,5,6,7}$ into the formula $5n,$ we get the following elements:\n\n$$\n\\begin{aligned}n=3 & \\,⇒\\,5(3)=15 \\\\ n=4 & \\,⇒\\,5(4)=20 \\\\ n=5 & \\,⇒\\,5(5)=25 \\\\ n=6 & \\,⇒\\,5(6)=30 \\\\ n=7 & \\,⇒\\,5(7)=35\\end{aligned}\n$$\n\nSo, we have\n\n$$\nB={15,20,25,30,35}.\n$$\n\nNow, let's inspect the given statements.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $5\\in A$ but $5\\notin B.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is $B⊆A$; $A⊈B$; $A⊇B$ only."} {:db/id #edb/ref 17592186323901 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5eb8220c-b68f-589e-8a2b-40578b765ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467374} {:answer/id #uuid "249f1641-add4-5543-992f-0c831364c3ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467375}] :answer-field/correct {:answer/id #uuid "249f1641-add4-5543-992f-0c831364c3ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467375} :answer-field/id #uuid "a4f4754d-90d5-58d5-bee4-c2914dcbe024" :answer-field/key "$N$ (natural numbers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468408} {:answer-field/choices [{:answer/id #uuid "c8da56ec-2879-5bea-86f2-ecd5a0f1f431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467376} {:answer/id #uuid "218f7977-751a-5526-a0c7-dc72dbc821e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467377}] :answer-field/correct {:answer/id #uuid "c8da56ec-2879-5bea-86f2-ecd5a0f1f431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467376} :answer-field/id #uuid "e4896fbd-dde1-5dc5-bb42-74ffc87b6adf" :answer-field/key "${Q}_{0}^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468409} {:answer-field/choices [{:answer/id #uuid "e50f27e2-dabe-5f5d-b408-8e746ec9ba45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467378} {:answer/id #uuid "c0d667fc-7491-57cb-88ed-55c0050584ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467379}] :answer-field/correct {:answer/id #uuid "c0d667fc-7491-57cb-88ed-55c0050584ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467379} :answer-field/id #uuid "6708688d-ee60-5bc4-80b9-6ed3507e593a" :answer-field/key "${Q}^{+}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468410} {:answer-field/choices [{:answer/id #uuid "589f4fa4-82f4-5e5b-bc16-ce81f1f02df5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467380} {:answer/id #uuid "f46d51aa-2699-56f9-b8bc-e809f6fa531f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467381}] :answer-field/correct {:answer/id #uuid "f46d51aa-2699-56f9-b8bc-e809f6fa531f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467381} :answer-field/id #uuid "d1158950-f6fa-5458-85b9-33ffccc6828f" :answer-field/key "$R$ (real numbers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468411}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a76aa6b8-9cdb-5c77-a90e-5b72a9324e9b" :question/math-academy-id "q-37313" :question/problem "To which of the following sets does the number $\\frac{72}{9}$ belong?\n\nSelect all that apply." :question/worked-solution "First, we note that $\\frac{72}{9}=8$ is a natural number, so it belongs to $N.$ \n\nConsequently, $\\frac{72}{9}$ also belongs to ${Q}^{+}$ and $R.$\n\nSince $\\frac{72}{9}$ is positive, it does not belong to ${Q}_{0}^{-}.$\n\nTherefore, the correct answer is “$N$ (natural numbers)”; ${Q}^{+}$; “$R$ (real numbers)” only."} {:db/id #edb/ref 17592186323902 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "add7b108-1f88-5419-896e-b8d3c9267fb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467382} {:answer/id #uuid "89046d5a-7465-57a3-b094-4ccb3168ef2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text