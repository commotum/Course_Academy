6-8b44-10b1471a13b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467432} :answer-field/id #uuid "c77fbfeb-1949-5e80-9ff9-7b505d8aef4b" :answer-field/key "The coefficient of the leading term is negative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468437}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0554fb0-029b-5c2c-8d39-a2786a1cbd89" :question/math-academy-id "q-38759" :question/problem "![](images/91/917c8111af178939316450421635ceaff2b9f3424764f891c4e2464926d4da99.png)\n\nThe graph of a polynomial $y=P(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to \\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is odd, and\n\n- the leading coefficient of $P(x)$ is positive.\n\nTherefore, statements “The degree of $P(x)$ is even” and “The coefficient of the leading term is negative” are false, while statement “$P(x)\\to \\infty $ as $x\\to \\infty .$” is true."} {:db/id #edb/ref 17592186326713 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial" :topic/_knowledge-points [{:db/id #edb/ref 17592186050601 :topic/id #uuid "577aebce-a9af-5bcd-867f-fb32f559c852" :topic/math-academy-id 2049 :topic/title "Graphing General Polynomials"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8c3d270-4f2a-53d7-8062-8d2e9cbcdce5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438278} {:answer/id #uuid "5f8eef91-6406-5add-96a7-f9eabef0d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438279}] :answer-field/correct {:answer/id #uuid "5f8eef91-6406-5add-96a7-f9eabef0d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438279} :answer-field/id #uuid "1da65ceb-5594-5e44-bb39-79c87b94bf6f" :answer-field/key "$x=2$ is a simple root." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439168} {:answer-field/choices [{:answer/id #uuid "739a4d76-6103-5d84-90a1-9822e2f320c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438280} {:answer/id #uuid "4ea74f05-534d-5d4b-9392-375d31647dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438281}] :answer-field/correct {:answer/id #uuid "4ea74f05-534d-5d4b-9392-375d31647dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438281} :answer-field/id #uuid "d2a0193f-d631-5929-9c6e-41674a92b0c3" :answer-field/key "$x=-1$ is a root of even multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439169} {:answer-field/choices [{:answer/id #uuid "4175bc45-7a87-5063-b600-76a60ad7f40e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438282} {:answer/id #uuid "f897869b-bbb9-53aa-9454-68a151292859" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438283}] :answer-field/correct {:answer/id #uuid "4175bc45-7a87-5063-b600-76a60ad7f40e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438282} :answer-field/id #uuid "92c5a7e5-4803-5105-b804-5b0e1a2d5217" :answer-field/key "$p(x)\\to -\\infty $ as $x\\to \\infty .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439170}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbe22a70-053f-5354-8d7b-dc32dacb2db4" :question/math-academy-id "q-38770" :question/problem "![](images/cd/cd19717bd41b787346a96394ce3bc4e38fe690340bb73bd3d11139d41ff977e2.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement “$x=2$ is a simple root” is true. The root $x=2$ is a simple root because the graph crosses the $x$-axis at the point and the curve is not tangent to the $x$-axis at that point.\n\n- Statement “$x=-1$ is a root of even multiplicity” is true. The root $x=-1$  has an even multiplicity because at $x=-1$ the graph just touches the $x$-axis and reverses direction.\n\n- Statement “$p(x)\\to -\\infty $ as $x\\to \\infty .$” is false. As $x$ moves right in the positive direction towards $+\\infty ,$ the $y$ value moves up in the positive direction towards $+\\infty .$\n\nTherefore, the correct answer is “$x=2$ is a simple root”; “$x=-1$ is a root of even multiplicity” only."} {:db/id #edb/ref 17592186326715 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial" :topic/_knowledge-points [{:db/id #edb/ref 17592186050601 :topic/id #uuid "577aebce-a9af-5bcd-867f-fb32f559c852" :topic/math-academy-id 2049 :topic/title "Graphing General Polynomials"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6661618c-5142-5303-9ab6-c061597132f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438284} {:answer/id #uuid "88c1c06f-e22b-5743-a5df-f566bbf4aa81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438285}] :answer-field/correct {:answer/id #uuid "6661618c-5142-5303-9ab6-c061597132f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438284} :answer-field/id #uuid "d6acb8c1-132c-52c2-ab5b-437bf2d6f098" :answer-field/key "$x=-4$ is a root of odd multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439171} {:answer-field/choices [{:answer/id #uuid "a2e61267-f650-507a-a46c-35c4eddb5430" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438286} {:answer/id #uuid "92f87947-b439-59ca-b88e-db6ab3dd76d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438287}] :answer-field/correct {:answer/id #uuid "92f87947-b439-59ca-b88e-db6ab3dd76d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438287} :answer-field/id #uuid "b8d6fc7d-b92b-532a-a9e3-35af311928ef" :answer-field/key "$p(0)=3.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439172} {:answer-field/choices [{:answer/id #uuid "7d72f815-f4b0-5fe6-85cf-34f1b56e3159" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438288} {:answer/id #uuid "bc96f23f-d359-54dc-b7e6-715d86f06b6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438289}] :answer-field/correct {:answer/id #uuid "bc96f23f-d359-54dc-b7e6-715d86f06b6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438289} :answer-field/id #uuid "52431db6-f190-5458-b507-431d7dff764d" :answer-field/key "$x=1$ is a root of odd multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439173}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84c10818-73ce-58a0-a3d2-b4c129acbe6d" :question/math-academy-id "q-38779" :question/problem "![](images/73/737052513985954a32dcce369fce60f898474db846319ca31b36e3e4682b4b37.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement “$x=-4$ is a root of odd multiplicity” is false. The root $x=-4$ has an even multiplicity because at $x=-4$ the graph just touches the $x$-axis and reverses direction.\n\n- Statement $p(0)=3.$ is true. The graph passes through the $y$-axis at $y=3$, which means that $p(0)=3.$\n\n- Statement “$x=1$ is a root of odd multiplicity” is true. The root $x=1$ has an odd multiplicity because the graph passes through the $x$-axis at the point.\n\nTherefore, the correct answer is $p(0)=3.$; “$x=1$ is a root of odd multiplicity” only."} {:db/id #edb/ref 17592186326727 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049371 :topic/id #uuid "ef6bb570-cff7-5ef3-a4ba-79063f5d81ad" :topic/math-academy-id 1962 :topic/title "The Invertible Matrix Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a41ae6c-0d04-54af-b7e1-66f17408a105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450600} {:answer/id #uuid "a7e20032-0a94-5027-bacb-72669ad1d4f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450601}] :answer-field/correct {:answer/id #uuid "a7e20032-0a94-5027-bacb-72669ad1d4f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450601} :answer-field/id #uuid "4edeacdc-e033-5790-be2d-7d85e4729f99" :answer-field/key "$\\text{Ker}(T)={0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451254} {:answer-field/choices [{:answer/id #uuid "58668fbd-bb78-5c00-9a1d-8a7d75b7e60d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450602} {:answer/id #uuid "e3d6d4d0-1f79-5205-af00-ebe990fad527" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450603}] :answer-field/correct {:answer/id #uuid "e3d6d4d0-1f79-5205-af00-ebe990fad527" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450603} :answer-field/id #uuid "dc9782cf-b2f2-54f3-8f50-7e6a03793938" :answer-field/key "$\\text{Im}(T)={R}^{6}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451255} {:answer-field/choices [{:answer/id #uuid "40bfaa4a-5a0a-58da-a864-f7887eb901d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450604} {:answer/id #uuid "834cbe2c-64aa-52c2-adae-2d8273e27d83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450605}] :answer-field/correct {:answer/id #uuid "834cbe2c-64aa-52c2-adae-2d8273e27d83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450605} :answer-field/id #uuid "ec37b2c3-76d5-5c6f-b7f5-1d6ee3b324e5" :answer-field/key "$\\text{rank}(T)=6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e6f3463-c123-5a14-aa68-90e5211244ca" :question/math-academy-id "q-38905" :question/problem "Which of the following statements are true given that $T:{R}^{6}\\to {R}^{6}$ is a linear transformation whose standard matrix is $T,$ and $T$ is a bijection?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)={0}$ is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement $\\text{Im}(T)={R}^{6}$ is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Im}(T)={R}^{6}.$\n\n- Statement $\\text{rank}(T)=6$ is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{rank}(T)=6.$\n\nTherefore, the correct answer is $\\text{Ker}(T)={0}$; $\\text{Im}(T)={R}^{6}$; $\\text{rank}(T)=6$."} {:db/id #edb/ref 17592186326728 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049371 :topic/id #uuid "ef6bb570-cff7-5ef3-a4ba-79063f5d81ad" :topic/math-academy-id 1962 :topic/title "The Invertible Matrix Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3b6b69e-fdda-5b48-8cbe-b6154cd7c5d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450606} {:answer/id #uuid "97c3efcd-f3c2-540f-afcf-4d2de2e5f841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450607}] :answer-field/correct {:answer/id #uuid "97c3efcd-f3c2-540f-afcf-4d2de2e5f841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450607} :answer-field/id #uuid "53da20ae-ae94-56fd-81c5-8688aef36c20" :answer-field/key "$\\text{rank}(T)=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451257} {:answer-field/choices [{:answer/id #uuid "bfca9365-98df-5eb7-95b1-2fb60431dc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450608} {:answer/id #uuid "6fac619f-5615-571c-9063-072979a2d254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450609}] :answer-field/correct {:answer/id #uuid "bfca9365-98df-5eb7-95b1-2fb60431dc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450608} :answer-field/id #uuid "993a94ac-7b36-59ae-a4b9-f0f0c7e4df6e" :answer-field/key "$T$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451258} {:answer-field/choices [{:answer/id #uuid "f0e4ee71-9c86-5467-baba-02fbccd28493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450610} {:answer/id #uuid "d04c4a7d-4c1f-51ad-98ba-4f0eef654db3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450611}] :answer-field/correct {:answer/id #uuid "d04c4a7d-4c1f-51ad-98ba-4f0eef654db3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450611} :answer-field/id #uuid "747ffb98-bf8f-5e74-a1a2-d5a8752eab30" :answer-field/key "$\\text{nullity}(T)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451259}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d76ba203-8385-5ab0-a588-ad7d93b64899" :question/math-academy-id "q-38907" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)?$\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{rank}(T)=3$ is true. Since ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)$ we must have that $\\text{rank}(T)=3.$\n\n- Statement “$T$ is invertible” is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 5,$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement $\\text{nullity}(T)>0$ is true. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$ In turn, this means that $\\text{nullity}(T)>0.$\n\nTherefore, the correct answer is $\\text{rank}(T)=3$; $\\text{nullity}(T)>0$ only."} {:db/id #edb/ref 17592186326750 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186049045 :topic/id #uuid "d599481a-4f0d-50b9-8ceb-db8805f8eeee" :topic/math-academy-id 2094 :topic/title "The Dot Product in N-Dimensional Euclidean Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bab5c6a-f15f-5312-8be0-740e41bde8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467434} {:answer/id #uuid "8011ab83-1ae9-5f11-8342-7b42a240103f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467435}] :answer-field/correct {:answer/id #uuid "4bab5c6a-f15f-5312-8be0-740e41bde8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467434} :answer-field/id #uuid "c63fa5ab-754e-567b-9e4b-510a7a6ad162" :answer-field/key "$b\\cdot a>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468438} {:answer-field/choices [{:answer/id #uuid "9bc03224-7ff5-5865-b574-29adcd9ee3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467436} {:answer/id #uuid "fcd5b92b-7d63-5ddd-b688-cb1c28b1b2d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467437}] :answer-field/correct {:answer/id #uuid "9bc03224-7ff5-5865-b574-29adcd9ee3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467436} :answer-field/id #uuid "c155efcb-a5b6-53dd-8752-59e674dad3c1" :answer-field/key "$b\\cdot a=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468439} {:answer-field/choices [{:answer/id #uuid "813cf431-3746-58d7-a353-84d8b6110731" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467438} {:answer/id #uuid "50eb7922-e1a4-5ef4-86a3-81d24c4f9234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467439}] :answer-field/correct {:answer/id #uuid "813cf431-3746-58d7-a353-84d8b6110731" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467438} :answer-field/id #uuid "fa55ddc0-083f-5e90-97f6-a179bbd97f64" :answer-field/key "$a\\cdot a=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "994b0436-bb09-5be1-b2e9-9e0b690f2b7e" :question/math-academy-id "q-39203" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statements $b\\cdot a>0$ and $b\\cdot a=0$ are false. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\n- Statement $a\\cdot a=0$ is false. Since $a\\ne 0,$ we must have $a\\cdot a>0.$\n\nTherefore, we conclude that none of the statements are true."} {:db/id #edb/ref 17592186326751 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050603 :topic/id #uuid "579b98fc-d572-5a6a-9016-eb840c350a9d" :topic/math-academy-id 2017 :topic/title "Rotation-Scaling Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aebd1d9b-7682-54a1-87d1-5625b9a74a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467440} {:answer/id #uuid "ae1c3ef4-6d14-5347-a96d-aa3d56907e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467441}] :answer-field/correct {:answer/id #uuid "ae1c3ef4-6d14-5347-a96d-aa3d56907e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467441} :answer-field/id #uuid "0c341505-ef51-58ef-9929-830b95c5da1b" :answer-field/key "$A=\\begin{bmatrix}-5 & 4 \\\\ -4 & -5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468441} {:answer-field/choices [{:answer/id #uuid "98532d37-e0bd-582f-81e8-52bc4b117a19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467442} {:answer/id #uuid "aba55aa2-a395-5f99-8e94-cb61594c469c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467443}] :answer-field/correct {:answer/id #uuid "aba55aa2-a395-5f99-8e94-cb61594c469c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467443} :answer-field/id #uuid "293e3409-0097-577e-a358-054e7db5377f" :answer-field/key "$B=\\begin{bmatrix}3 & -\\frac{2}{3} \\\\ \\frac{2}{3} & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468442} {:answer-field/choices [{:answer/id #uuid "2a054fdb-c8ac-5d69-ba2a-8a921c5c373e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467444} {:answer/id #uuid "d4cdc50f-c9ac-5a76-855f-242a9daa529e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467445}] :answer-field/correct {:answer/id #uuid "d4cdc50f-c9ac-5a76-855f-242a9daa529e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467445} :answer-field/id #uuid "30753b51-5644-5667-b969-2971c318dfb9" :answer-field/key "$C=\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "005586ff-4a9c-5e53-b470-73135485f7ce" :question/math-academy-id "q-39216" :question/problem "Which of the following are rotation-scaling matrices?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}-5 & 4 \\\\ -4 & -5\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $B=\\begin{bmatrix}3 & -\\frac{2}{3} \\\\ \\frac{2}{3} & 3\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $C=\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}$ is a rotation-scaling matrix.\n\nIn conclusion, the correct answer is $A=\\begin{bmatrix}-5 & 4 \\\\ -4 & -5\\end{bmatrix}$; $B=\\begin{bmatrix}3 & -\\frac{2}{3} \\\\ \\frac{2}{3} & 3\\end{bmatrix}$; $C=\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}$."} {:db/id #edb/ref 17592186326753 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050603 :topic/id #uuid "579b98fc-d572-5a6a-9016-eb840c350a9d" :topic/math-academy-id 2017 :topic/title "Rotation-Scaling Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "730a249f-9909-593e-987f-dcb1e3654985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467446} {:answer/id #uuid "7f562f29-d90e-52f9-a7c0-0ade3faa4c2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467447}] :answer-field/correct {:answer/id #uuid "730a249f-9909-593e-987f-dcb1e3654985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467446} :answer-field/id #uuid "9f4fa1a9-caa6-575d-a4db-3f3150f93271" :answer-field/key "$A=\\begin{bmatrix}1 & -5 \\\\ 5 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468444} {:answer-field/choices [{:answer/id #uuid "d273d575-ee96-58bd-a8a5-dcc0d66f8b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467448} {:answer/id #uuid "a962ee5c-cb7e-5e12-a832-bf6811118ac3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467449}] :answer-field/correct {:answer/id #uuid "d273d575-ee96-58bd-a8a5-dcc0d66f8b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467448} :answer-field/id #uuid "f5648ff4-d2eb-5a4c-8bce-106d5afbf1de" :answer-field/key "$B=\\begin{bmatrix}-4 & -7 \\\\ -7 & -4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468445} {:answer-field/choices [{:answer/id #uuid "76543da4-6b12-564a-8961-72a8de60a798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467450} {:answer/id #uuid "52aa4f38-4b8c-59ca-8d1e-39e4150502f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467451}] :answer-field/correct {:answer/id #uuid "76543da4-6b12-564a-8961-72a8de60a798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467450} :answer-field/id #uuid "012e81c7-a56a-5f6a-82c9-bf83079ac737" :answer-field/key "$C=\\begin{bmatrix}3 & 1 \\\\ -1 & -3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468446}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "472e5539-e34f-5423-877f-1927b4b9d486" :question/math-academy-id "q-39246" :question/problem "Which of the following are rotation-scaling matrices?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}1 & -5 \\\\ 5 & 3\\end{bmatrix}$  is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\n- $B=\\begin{bmatrix}-4 & -7 \\\\ -7 & -4\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the antidiagonal do not have opposite signs.\n\n- $C=\\begin{bmatrix}3 & 1 \\\\ -1 & -3\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\nIn conclusion, the correct answer is \"None.\""} {:db/id #edb/ref 17592186326761 :knowledge-point/_questions [{:db/id #edb/ref 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal" :topic/_knowledge-points [{:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "436169ad-a07f-5c25-ac9d-4c0589b9f1c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467452} {:answer/id #uuid "71172c6d-69cb-5654-9de1-529b9f219d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467453}] :answer-field/correct {:answer/id #uuid "71172c6d-69cb-5654-9de1-529b9f219d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467453} :answer-field/id #uuid "bcd336a4-e888-5530-80a4-1f13ce8d051e" :answer-field/key "$U={\\begin{bmatrix}-2 \\\\ -4 \\\\ 5\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 4 \\\\ 2\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468447} {:answer-field/choices [{:answer/id #uuid "7391a0f0-11c6-5e13-b5fa-5c4a81d4a16c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467454} {:answer/id #uuid "c2f48a37-f6d7-54a2-8786-46b1ef3f35b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467455}] :answer-field/correct {:answer/id #uuid "7391a0f0-11c6-5e13-b5fa-5c4a81d4a16c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467454} :answer-field/id #uuid "32c892b1-1456-54d9-b9da-a3b642d33cca" :answer-field/key "$V={\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix},\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468448} {:answer-field/choices [{:answer/id #uuid "fe9da6f9-ff11-5873-b211-7ef3a4f05b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467456} {:answer/id #uuid "c944e341-be44-513f-b567-efd54efb1959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467457}] :answer-field/correct {:answer/id #uuid "fe9da6f9-ff11-5873-b211-7ef3a4f05b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467456} :answer-field/id #uuid "6fd43aef-1a51-5e8e-bc1a-09365ae0a928" :answer-field/key "$W={\\begin{bmatrix}3 \\\\ 4 \\\\ -1\\end{bmatrix},\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}-2 \\\\ -1 \\\\ -2\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33270b70-b678-53b1-8691-4ebd546544ee" :question/math-academy-id "q-39396" :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2},{u}_{3}},$\n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2},{w}_{3}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}-2 \\\\ -4 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}-3 \\\\ 4 \\\\ 2\\end{bmatrix}=6-16+10=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{3} & =\\begin{bmatrix}-2 \\\\ -4 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0+0+0=0 & ✓ \\\\ {u}_{2}\\cdot {u}_{3} & =\\begin{bmatrix}-3 \\\\ 4 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0+0+0=0 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ 2\\end{bmatrix}=-8+10=2\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}3 \\\\ 4 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix}=15-12-1=2\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"$U$ only\"."} {:db/id #edb/ref 17592186326784 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator" :topic/_knowledge-points [{:db/id #edb/ref 17592186049363 :topic/id #uuid "eefd5285-6b99-569d-a5bb-365f176fa757" :topic/math-academy-id 807 :topic/title "Vertical Asymptotes of Rational Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fefcf3-dc6d-541a-95f6-34256e8b048b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439713} {:answer/id #uuid "190761d1-2717-5896-9f91-b6244b0d5338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439714}] :answer-field/correct {:answer/id #uuid "190761d1-2717-5896-9f91-b6244b0d5338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439714} :answer-field/id #uuid "157a0946-2038-5a78-b908-8721ffd0a5ef" :answer-field/key "$x=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440214} {:answer-field/choices [{:answer/id #uuid "b697654e-b5c4-59a7-9a0d-9aaf359901f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439715} {:answer/id #uuid "e5f915e1-bdd6-5e79-aed2-0b3140f93891" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439716}] :answer-field/correct {:answer/id #uuid "b697654e-b5c4-59a7-9a0d-9aaf359901f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439715} :answer-field/id #uuid "b96ff4dd-ee3b-5666-b9b2-0ca82fce0e09" :answer-field/key "$x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440215} {:answer-field/choices [{:answer/id #uuid "b79033f7-3d4d-5951-93c7-4bd0b80611dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439717} {:answer/id #uuid "24b70d9d-f545-563b-8936-ae02a1a75b88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439718}] :answer-field/correct {:answer/id #uuid "b79033f7-3d4d-5951-93c7-4bd0b80611dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439717} :answer-field/id #uuid "dd0329ed-b944-5cdb-820b-534bd894cb0f" :answer-field/key "$x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440216} {:answer-field/choices [{:answer/id #uuid "e3408753-560e-5910-90fa-60ce18097d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439719} {:answer/id #uuid "bc4dbdc7-c28b-5056-8cb3-4b10444b0381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439720}] :answer-field/correct {:answer/id #uuid "e3408753-560e-5910-90fa-60ce18097d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439719} :answer-field/id #uuid "cb55c561-c749-5cc7-83b1-d4ef90d3847f" :answer-field/key "$x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440217} {:answer-field/choices [{:answer/id #uuid "fea95748-4d41-54c2-95d7-7515e499a2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439721} {:answer/id #uuid "57e50c0a-e034-580f-992c-1dbb57abf4e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439722}] :answer-field/correct {:answer/id #uuid "fea95748-4d41-54c2-95d7-7515e499a2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439721} :answer-field/id #uuid "641f7ca8-9edf-56f1-a102-a0b83d5500a9" :answer-field/key "$x=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440218}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cd01e245-cc8a-5763-b4a7-8579762d92bc" :question/math-academy-id "q-39804" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{3}-3{x}^{2}+3x-1}{(x-1)(x+5{)}^{2}}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{3}-3{x}^{2}+3x-1}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{(x-1{)}^{3}}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{(x-1)(x-1{)}^{2}}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{\\cancel{(x-1)}(x-1{)}^{2}}{\\cancel{(x-1)}(x+5{)}^{2}} \\\\  & =\\frac{(x-1{)}^{2}}{(x+5{)}^{2}}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x+5{)}^{2}=0\n$$\n\nThis gives the solution $x=-5.$ Therefore, $x=-5$ is the only vertical asymptote."} {:db/id #edb/ref 17592186326791 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator" :topic/_knowledge-points [{:db/id #edb/ref 17592186049363 :topic/id #uuid "eefd5285-6b99-569d-a5bb-365f176fa757" :topic/math-academy-id 807 :topic/title "Vertical Asymptotes of Rational Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91ec1a25-8adf-5207-b26a-3ae451be1d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439731} {:answer/id #uuid "58b58a38-8e9a-51dd-bf57-949f83a6e8d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439732}] :answer-field/correct {:answer/id #uuid "91ec1a25-8adf-5207-b26a-3ae451be1d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439731} :answer-field/id #uuid "6593a937-4442-598c-917f-48de74c14298" :answer-field/key "$x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440223} {:answer-field/choices [{:answer/id #uuid "0163657b-bf49-5d60-9bde-e03ea6cd3d1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439733} {:answer/id #uuid "3c11f501-5926-56a0-a30f-5768d5bb365b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439734}] :answer-field/correct {:answer/id #uuid "3c11f501-5926-56a0-a30f-5768d5bb365b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439734} :answer-field/id #uuid "b416c2cb-ba76-5e43-910e-b07bc7418ba3" :answer-field/key "$x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440224} {:answer-field/choices [{:answer/id #uuid "ebbc5dd0-f450-54ae-b05e-f18f4a0c2f9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439735} {:answer/id #uuid "f89504f5-87d6-54bb-9286-c7d6e1364a11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439736}] :answer-field/correct {:answer/id #uuid "ebbc5dd0-f450-54ae-b05e-f18f4a0c2f9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439735} :answer-field/id #uuid "53af5bc4-d5bd-582b-8c98-b6c0fe211200" :answer-field/key "$x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440225}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "720a20e0-eaeb-515c-b041-a17373ebe5f9" :question/math-academy-id "q-39931" :question/problem "Determine the vertical asymptotes of the function $f(x)=\\frac{{x}^{2}-4}{{x}^{3}+2{x}^{2}}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-4}{{x}^{3}+2{x}^{2}} \\\\  & =\\frac{(x-2)(x+2)}{{x}^{2}(x+2)} \\\\  & =\\frac{(x-2)\\cancel{(x+2)}}{{x}^{2}\\cancel{(x+2)}} \\\\  & =\\frac{x-2}{{x}^{2}}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}=0\n$$\n\nThis gives the solution $x=0.$ Therefore, $x=0$ is the only vertical asymptote."} {:db/id #edb/ref 17592186326792 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots" :topic/_knowledge-points [{:db/id #edb/ref 17592186049363 :topic/id #uuid "eefd5285-6b99-569d-a5bb-365f176fa757" :topic/math-academy-id 807 :topic/title "Vertical Asymptotes of Rational Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f3c3348-eb0c-5468-aa98-ecdb90d6b160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439737} {:answer/id #uuid "1521cff8-c574-52e1-bc38-0a4fe0cf4ca2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439738}] :answer-field/correct {:answer/id #uuid "4f3c3348-eb0c-5468-aa98-ecdb90d6b160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439737} :answer-field/id #uuid "d9c4828b-4e33-518a-aef4-a7d2e4cd25e4" :answer-field/key "$x=-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440226} {:answer-field/choices [{:answer/id #uuid "68b1ea8d-6026-5feb-87a2-96eecb19a3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439739} {:answer/id #uuid "c904bf85-72a5-5708-b2aa-de41ef06bf9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439740}] :answer-field/correct {:answer/id #uuid "68b1ea8d-6026-5feb-87a2-96eecb19a3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439739} :answer-field/id #uuid "8973e8a4-77f9-52ab-9d3a-66756a483070" :answer-field/key "$x=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440227} {:answer-field/choices [{:answer/id #uuid "0a9bb08f-4875-5192-a9d3-276418f376ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439741} {:answer/id #uuid "d195523f-9226-5084-8368-76c29fdcbfcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439742}] :answer-field/correct {:answer/id #uuid "0a9bb08f-4875-5192-a9d3-276418f376ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439741} :answer-field/id #uuid "832c1103-6de8-52e3-91a8-69a589a7090a" :answer-field/key "$x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440228} {:answer-field/choices [{:answer/id #uuid "fc06c13a-02a5-52da-8c5f-33478dd82019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439743} {:answer/id #uuid "0477e31a-6a45-5821-ab82-2a1844d48dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439744}] :answer-field/correct {:answer/id #uuid "fc06c13a-02a5-52da-8c5f-33478dd82019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439743} :answer-field/id #uuid "f85e3c8e-67f8-5920-9a7f-eec1efb5cb19" :answer-field/key "$x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440229}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2f92ee8b-33fa-5343-9c16-73df2f465b76" :question/math-academy-id "q-39934" :question/problem "Determine the vertical asymptotes of the function $f(x)=\\frac{{x}^{2}+3x}{{x}^{3}+2{x}^{2}+8x}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+3x}{{x}^{3}+2{x}^{2}+8x} \\\\  & =\\frac{x(x+3)}{x({x}^{2}+2x+8)} \\\\  & =\\frac{\\cancel{x}(x+3)}{\\cancel{x}({x}^{2}+2x+8)} \\\\  & =\\frac{x+3}{{x}^{2}+2x+8}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+2x+8=0\n$$\n\nThis equation does not have any real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={2}^{2}-4(1)(8) \\\\  & =-28\\end{aligned}\n$$\n\nTherefore, $f(x)$ has no vertical asymptotes."} {:db/id #edb/ref 17592186326808 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186049045 :topic/id #uuid "d599481a-4f0d-50b9-8ceb-db8805f8eeee" :topic/math-academy-id 2094 :topic/title "The Dot Product in N-Dimensional Euclidean Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1db8eb7-e09f-56da-a287-35714cc28cf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467458} {:answer/id #uuid "b1ff2546-2a88-5435-acbe-93df7f7eeafd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467459}] :answer-field/correct {:answer/id #uuid "b1ff2546-2a88-5435-acbe-93df7f7eeafd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467459} :answer-field/id #uuid "ba8eda63-91b1-56f5-a4df-cc1f8bc6d99c" :answer-field/key "$a\\cdot a>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468450} {:answer-field/choices [{:answer/id #uuid "1e828117-5723-519f-b893-5316f2b3b3b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467460} {:answer/id #uuid "c561fe9a-88e5-52b1-bde8-e459bbebb99e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467461}] :answer-field/correct {:answer/id #uuid "1e828117-5723-519f-b893-5316f2b3b3b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467460} :answer-field/id #uuid "45d4bccf-e659-550b-b666-e63b0610397f" :answer-field/key "$a\\cdot a=\\frac{1}{2}(b\\cdot a)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468451} {:answer-field/choices [{:answer/id #uuid "721e29c5-37a8-527b-a2c2-c18d8874306e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467462} {:answer/id #uuid "9be70914-f2ac-53e2-9d6c-276ded2ea1b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467463}] :answer-field/correct {:answer/id #uuid "721e29c5-37a8-527b-a2c2-c18d8874306e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467462} :answer-field/id #uuid "1b258030-52f1-5a01-ae8e-9fcee2a439b4" :answer-field/key "$b\\cdot a=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468452}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b1453d9c-0156-5211-9ae1-5e44ccac6939" :question/math-academy-id "q-40116" :question/problem "Suppose $(6a-9b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement $a\\cdot a>0$ is true. Indedd, $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement $a\\cdot a=\\frac{1}{2}(b\\cdot a)$ is false. Simplifying the expression $(6a-9b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(6a-9b)\\cdot a & =0 \\\\ (6a)\\cdot a-(9b)\\cdot a & =0 \\\\ 6(a\\cdot a)-9(b\\cdot a) & =0 \\\\ 6(a\\cdot a) & =9(b\\cdot a) \\\\ a\\cdot a & =\\frac{3}{2}(b\\cdot a)\\end{aligned}\n$$\n\n- Statement $b\\cdot a=-4$ is false since it leads to a contradiction. If $b\\cdot a=-4$, we get\n\n$$\n\\begin{aligned}(6a-9b)\\cdot a & =0 \\\\ 6(a\\cdot a)-9(b\\cdot a) & =0 \\\\ 6(a\\cdot a)-9(-4) & =0 \\\\ a\\cdot a & =-6,\\end{aligned}\n$$\n\nbut this is a contradiction since $a\\ne 0$ implies that $a\\cdot a>0.$\n\nTherefore, we conclude that the correct answer is $a\\cdot a>0$ only."} {:db/id #edb/ref 17592186326825 :knowledge-point/_questions [{:db/id #edb/ref 17592186078493 :knowledge-point/id #uuid "62736299-f6d6-503f-a5d1-e1091e8b0429" :knowledge-point/title "Identifying Convergent Geometric Series" :topic/_knowledge-points [{:db/id #edb/ref 17592186050868 :topic/id #uuid "6cc04ddb-ad7b-51e8-8f9d-c71c72f8e9d4" :topic/math-academy-id 684 :topic/title "Convergence of Geometric Series"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1057d0ab-c433-53fc-84a5-9ffb065d34b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467464} {:answer/id #uuid "339ba22e-0df0-517c-95d1-7e6077efd09c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467465}] :answer-field/correct {:answer/id #uuid "1057d0ab-c433-53fc-84a5-9ffb065d34b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467464} :answer-field/id #uuid "5c41882d-c836-503b-8dc9-ef3e36f9bdcf" :answer-field/key "$1+5+25+125+⋯$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468453} {:answer-field/choices [{:answer/id #uuid "c01b25f9-e4e2-5ecf-b963-555e12dbb905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467466} {:answer/id #uuid "6bc09b19-9928-52c0-8f2a-bf84b9daf6bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467467}] :answer-field/correct {:answer/id #uuid "c01b25f9-e4e2-5ecf-b963-555e12dbb905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467466} :answer-field/id #uuid "088b4927-cb51-5e0e-91b7-d85a0ed9f3b1" :answer-field/key "$\\frac{2}{7}+\\frac{4}{3}+\\frac{56}{9}+\\frac{784}{27}+⋯$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468454} {:answer-field/choices [{:answer/id #uuid "7456d2ff-df6b-523e-a46a-5cd5f5c8c23f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467468} {:answer/id #uuid "1b01a857-dc53-56a9-808d-76ab0abefd7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467469}] :answer-field/correct {:answer/id #uuid "1b01a857-dc53-56a9-808d-76ab0abefd7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467469} :answer-field/id #uuid "b7c5c6d1-7639-509f-b20e-bfa9b6e5b570" :answer-field/key "$\\begin{gathered}0.1+0.01+0.001+0.000\\,1+⋯\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468455}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "80009f32-0755-50c0-b5e3-ae14ffcb07ce" :question/math-academy-id "q-40282" :question/problem "Which of the following geometric series converge?\n\nSelect all that apply." :question/worked-solution "Let's look at each series in turn.\n\n- For the geometric series $1+5+25+125+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{5}{1} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- For the geometric series $\\frac{2}{7}+\\frac{4}{3}+\\frac{56}{9}+\\frac{784}{27}+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(\\frac{4}{3})}{(\\frac{2}{7})} \\\\  & =\\frac{4}{3}\\cdot \\frac{7}{2} \\\\  & =\\frac{14}{3}\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- For the geometric series $\\begin{gathered}0.1+0.01+0.001+0.000\\,1+⋯\\end{gathered}$  the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{0.01}{0.1} \\\\  & =0.1\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\nIn conclusion, only series $\\begin{gathered}0.1+0.01+0.001+0.000\\,1+⋯\\end{gathered}$ converges."} {:db/id #edb/ref 17592186326833 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases" :topic/_knowledge-points [{:db/id #edb/ref 17592186050324 :topic/id #uuid "3ffd42a4-cf3d-5ec4-9be0-19d427299cac" :topic/math-academy-id 2014 :topic/title "Connections Between Matrix Representations of a Linear Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d988f2e6-8566-5999-9247-7fac533a9295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450612} {:answer/id #uuid "89dae380-77c4-59f5-91cc-e46aa3e51718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450613}] :answer-field/correct {:answer/id #uuid "89dae380-77c4-59f5-91cc-e46aa3e51718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450613} :answer-field/id #uuid "c7fc02e9-bc92-55a1-b760-0628ccf45a59" :answer-field/key "$[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451260} {:answer-field/choices [{:answer/id #uuid "b41db3b9-2667-55f0-9f27-b6ad59f1db21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450614} {:answer/id #uuid "398c62f8-02c3-5c69-8f10-417fb2ab45db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450615}] :answer-field/correct {:answer/id #uuid "b41db3b9-2667-55f0-9f27-b6ad59f1db21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450614} :answer-field/id #uuid "d9ec1260-1b87-550f-ae57-933ff1b4a57b" :answer-field/key "$[T]_{B}=[T]_{C}^{-1}\\cdot {P}_{C\\to B}\\cdot [T]_{C}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451261} {:answer-field/choices [{:answer/id #uuid "16384e17-4347-5ba9-8b00-34639ad8d1d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450616} {:answer/id #uuid "98e7be82-e824-5b9c-ada1-a8ebc9470a63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450617}] :answer-field/correct {:answer/id #uuid "16384e17-4347-5ba9-8b00-34639ad8d1d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450616} :answer-field/id #uuid "cd7e9c73-8df5-5a9f-9b10-48fdad19c370" :answer-field/key "$[T]_{C}={P}_{C\\to B}\\cdot [T]_{B}\\cdot {P}_{C\\to B}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3221319-81c0-55a5-8884-351b35c9f34f" :question/math-academy-id "q-40372" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{C\\to B}$ is the change-of-coordinates matrix from basis $C$ to basis $B,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/9b/9ba3d1f0eebdfc82c40f36bdbe16896ca15516b623c695b72c331861955329bc.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B},\n$$\n\nwhere ${P}_{C\\to B}$ is the change-of-coordinates matrix from $C$ to $B.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}.\n$$\n\nTherefore, the correct answer is $[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}$ only."} {:db/id #edb/ref 17592186326848 :knowledge-point/_questions [{:db/id #edb/ref 17592186115201 :knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186050829 :topic/id #uuid "6a056b25-47a5-57f1-ad81-32b91dee4044" :topic/math-academy-id 1609 :topic/title "Properties of Transformed Exponential Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fba6985-3012-59f9-9046-f7eb81bd2134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467470} {:answer/id #uuid "4176abbf-bd07-546f-8c5b-1cbab5b0a94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467471}] :answer-field/correct {:answer/id #uuid "4176abbf-bd07-546f-8c5b-1cbab5b0a94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467471} :answer-field/id #uuid "a3b98d53-5717-5f50-8dd4-dd0c7af69429" :answer-field/key "The number $-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468456} {:answer-field/choices [{:answer/id #uuid "88ac396c-2449-52a9-a0d6-33a2b4292428" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467472} {:answer/id #uuid "c8ec575c-69f5-5fb8-9972-08b07552919e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467473}] :answer-field/correct {:answer/id #uuid "c8ec575c-69f5-5fb8-9972-08b07552919e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467473} :answer-field/id #uuid "95a51358-016b-50f8-9abd-1bdef89debaa" :answer-field/key "The number $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468457} {:answer-field/choices [{:answer/id #uuid "aa42429c-3d19-5a80-9479-8973b3e68f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467474} {:answer/id #uuid "5098c1b0-3b23-5a63-8473-81c712f3c23c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467475}] :answer-field/correct {:answer/id #uuid "aa42429c-3d19-5a80-9479-8973b3e68f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467474} :answer-field/id #uuid "694365a2-c4b5-5df8-91a8-0c68236bf025" :answer-field/key "The number $10$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468458}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0164c43-f6ad-58eb-9330-df1855ede5c5" :question/math-academy-id "q-40556" :question/problem "Which of the following values ​are possible outputs of $f(x)=-5{(\\frac{2}{3})}^{x-1}+3?$\n\nSelect all that apply." :question/worked-solution "The range of ${(\\frac{2}{3})}^{x}$ is\n\n$$\n{(\\frac{2}{3})}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{(\\frac{2}{3})}^{x-1}>0.\n$$\n\nMultiplying the above inequality by $-5$ and then adding $3,$ we get the following:\n\n$$\n\\begin{aligned}{(\\frac{2}{3})}^{x-1} & >0 \\\\ -5{(\\frac{2}{3})}^{x-1} & <0 \\\\ -5{(\\frac{2}{3})}^{x-1}+3 & <0+3 \\\\ f(x) & <3\\end{aligned}\n$$\n\nTherefore, the range is $f(x)<3.$ Thus, of the given values, only $y=-3$ and $y=2$ are  outputs of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/b2/b220b9c53bfaa49fe9b1b1c70fb9e21d08e247f44df8716846d08fd37ac2cf11.png)\n\n  \n\nSo, the correct answer is “The number $-3$”; “The number $2$” only."} {:db/id #edb/ref 17592186326879 :knowledge-point/_questions [{:db/id #edb/ref 17592186115201 :knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186050829 :topic/id #uuid "6a056b25-47a5-57f1-ad81-32b91dee4044" :topic/math-academy-id 1609 :topic/title "Properties of Transformed Exponential Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be919c0-2e7e-55ba-ac96-3989376a6465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467476} {:answer/id #uuid "12d89c1a-7b91-587f-bcd6-3572509206a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467477}] :answer-field/correct {:answer/id #uuid "12d89c1a-7b91-587f-bcd6-3572509206a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467477} :answer-field/id #uuid "b068adf9-1de1-54ce-add1-bac0f0ac7414" :answer-field/key "The number $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468459} {:answer-field/choices [{:answer/id #uuid "b77c347b-36a4-5c6e-b52e-370b44d8a7b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467478} {:answer/id #uuid "ed8d4346-33f6-59a1-b92e-7148fbd3fdf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467479}] :answer-field/correct {:answer/id #uuid "ed8d4346-33f6-59a1-b92e-7148fbd3fdf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467479} :answer-field/id #uuid "e6620f20-85ec-523b-96f2-0a064cfa262d" :answer-field/key "The number $-0.2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468460} {:answer-field/choices [{:answer/id #uuid "992ba742-0d05-53df-85ef-a4b6b932078e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467480} {:answer/id #uuid "f4b8515a-b879-54b3-9bb0-f5d32d477ca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467481}] :answer-field/correct {:answer/id #uuid "992ba742-0d05-53df-85ef-a4b6b932078e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467480} :answer-field/id #uuid "07c07e13-de4b-5e64-850c-da341cdcf490" :answer-field/key "The number $-0.8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468461}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f9f596e3-81e5-5b3c-9173-334b5d50904e" :question/math-academy-id "q-40798" :question/problem "Which of the following values ​are possible outputs of  $f(x)={(1.5)}^{2x}-0.5?$ \n\nSelect all that apply." :question/worked-solution "The range of ${(1.5)}^{x}$ is\n\n$$\n{(1.5)}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{(1.5)}^{2x}>0.\n$$\n\nSubtracting  $0.5$ from the above inequality yields the following:\n\n$$\n\\begin{aligned}{(1.5)}^{2x} & >0 \\\\ {(1.5)}^{2x}-0.5 & >0-0.5 \\\\ f(x) & >-0.5\\end{aligned}\n$$\n\nTherefore, the range is $f(x)>-0.5.$ Thus, of the given values, only $y=0$ and $y=-0.2$ are outputs of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/58/5876d2095bfd91417d2e6395f8a02ae817ebd476076bae929d79709ea7961a3e.png)\n\nSo, the correct answer is “The number $0$”; “The number $-0.2$” only."} {:db/id #edb/ref 17592186326880 :knowledge-point/_questions [{:db/id #edb/ref 17592186115201 :knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186050829 :topic/id #uuid "6a056b25-47a5-57f1-ad81-32b91dee4044" :topic/math-academy-id 1609 :topic/title "Properties of Transformed Exponential Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b128238-89f2-56ef-a3a0-db3141972f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467482} {:answer/id #uuid "6c788197-15ab-5d92-beb7-29c4da863ea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467483}] :answer-f