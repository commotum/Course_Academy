ield/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468414} {:answer-field/choices [{:answer/id #uuid "4d039182-8620-5d17-bdd4-630342d92f6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467388} {:answer/id #uuid "c7d9f8b8-721a-5004-88e6-29eb60c36f72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467389}] :answer-field/correct {:answer/id #uuid "c7d9f8b8-721a-5004-88e6-29eb60c36f72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467389} :answer-field/id #uuid "61b25af6-7842-53da-94c2-154e630a680e" :answer-field/key "$R$ (real numbers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468415}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cedbe49b-bcb9-5d4b-9edb-8a333a5510e3" :question/math-academy-id "q-37315" :question/problem "To which of the following sets does the number $-\\sqrt{81}$ belong?\n\nSelect all that apply." :question/worked-solution "Note that $-\\sqrt{81}=-9.$ Therefore $-\\sqrt{81}$ is a negative integer. So it's in the sets $Z,$ ${Z}_{0}^{-},$ and ${Z}^{-}.$ \n\nMoreover, since every integer is also a real number, $-\\sqrt{81}$ also belongs to $R.$\n\nTherefore, the correct answer is “$Z$ (integers)”; ${Z}^{-}$; ${Z}_{0}^{-}$; “$R$ (real numbers)”."} {:db/id #edb/ref 17592186323908 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :