 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452530} {:answer-field/choices [{:answer/id #uuid "ce890967-1998-5d98-acc8-eaf2a2f88a9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451367} {:answer/id #uuid "8945dfc3-13d2-5157-9770-cbece5a00282" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451368}] :answer-field/correct {:answer/id #uuid "8945dfc3-13d2-5157-9770-cbece5a00282" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451368} :answer-field/id #uuid "5eec8e96-3fd7-5925-8e44-018a0d825ec1" :answer-field/key "$A$ is **not** a subspace of $C[-1,1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452531}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "db24656f-6e64-5fc3-8ad0-36cdd492a237" :question/math-academy-id "q-43780" :question/problem "Consider the vector space $C[-1,1]$ of all continuous functions $f:[-1,1]\\to R$ and its subset $A={f\\in C[-1,1]\\,|\\,f(1)\\le 0}.$ \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “$A$ is closed under function addition” is true. If $f(x),g(x)\\in A,$ then\n\n$$\n\\begin{aligned}(f+g)(1) & =f(1)+g(1)\\le 0\\end{aligned}\n$$\n\nSo, $A$ is closed under addition.\n\n- Statement “$A$ is closed under scalar multiplication” is false. For example, if $f(x)\\in A$ and $k=-1\\in R,$ then \n\n$$\n\\begin{aligned}f(1) & \\le 0 \\\\ kf(1) & \\ge k\\cdot 0 \\\\ (kf) & \\ge 0\\end{aligned}\n$$\n\nSo, $A$ is *not* closed under scalar multiplication.\n\n- Statement “$A$ is a subspace of $C[-1,1]$” is false, while statement “$A$ is **not** a subspace of $C[-1,1]$” is true. $A$ is *not* a subspace because it's not closed under scalar multiplication.\n\nTherefore, the correct answer is “$A$ is closed under function addition”; “$A$ is **not** a subspace of $C[-1,1]$” only."} {:db/id #edb/ref 17592186329729 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements" :topic/_knowledge-points [{:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9aa7e7a-8ec0-5ba0-bf53-464cee37bf90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451369} {:answer/id #uuid "30ea5b39-4d55-5079-a6a1-8b5632101d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451370}] :answer-field/correct {:answer/id #uuid "a9aa7e7a-8ec0-5ba0-bf53-464cee37bf90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451369} :answer-field/id #uuid "f20f6232-94aa-56b0-ba07-28575864e357" :answer-field/key "${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly independent set" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452532} {:answer-field/choices [{:answer/id #uuid "e9fff169-7d2d-5e8f-aa19-b279b7edb09b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451371} {:answer/id #uuid "840be9e1-e201-5c43-80de-26e479a9452c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451372}] :answer-field/correct {:answer/id #uuid "e9fff169-7d2d-5e8f-aa19-b279b7edb09b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451371} :answer-field/id #uuid "4c4c01e1-7882-56f1-a506-19f45fa661b8" :answer-field/key "${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has only zero solution ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452533} {:answer-field/choices [{:answer/id #uuid "fd17d168-cd11-5c94-ad0d-d1984bff165d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451373} {:answer/id #uuid "20339164-524f-5900-ab66-5ffccc12418f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451374}] :answer-field/correct {:answer/id #uuid "20339164-524f-5900-ab66-5ffccc12418f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451374} :answer-field/id #uuid "3e33abb9-a883-5fa6-8001-bfd2368cc29e" :answer-field/key "${v}_{4}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452534}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8990a76e-d7f0-501d-8a23-d23acd1f20ba" :question/math-academy-id "q-43786" :question/problem "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3},{v}_{4}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{3}}$ is a linearly independent set and \n${v}_{1}={v}_{2}+5{v}_{3}-{v}_{4},$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of the given options in turn.\n\n- Statement “${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly independent set” is false. Since ${v}_{1}={v}_{2}+5{v}_{3}-{v}_{4},$ we have that\n\n$$\n1\\cdot {v}_{1}+(-1)\\cdot {v}_{2}+(-5)\\cdot {v}_{3}+1\\cdot {v}_{4}=0.\n$$\n\nAs a result, ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has a non-zero solution and the set ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly dependent by definition.\n\n- Statement “${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has only zero solution ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0$” is false.  Since ${v}_{1}={v}_{2}+5{v}_{3}-{v}_{4},$ the equation ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has a non-zero solution.\n\n- Statement “${v}_{4}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{3}$” is true. Since ${v}_{1}={v}_{2}+5{v}_{3}-{v}_{4},$ we have that\n\n$$\n{v}_{4}={v}_{2}+5{v}_{3}-{v}_{1}.\n$$\n\nThat is, ${v}_{4}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{3}.$\n\nTherefore, the correct answer is “${v}_{4}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{3}$” only."} {:db/id #edb/ref 17592186329740 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements" :topic/_knowledge-points [{:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71f22ab4-c4a5-502a-87f2-77057b0a8bac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451375} {:answer/id #uuid "24f36ec2-6bfa-5409-9d77-f02ebce02bc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451376}] :answer-field/correct {:answer/id #uuid "24f36ec2-6bfa-5409-9d77-f02ebce02bc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451376} :answer-field/id #uuid "4f821a04-b96f-56c7-b808-1c064e7b598e" :answer-field/key "${v}_{3}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452535} {:answer-field/choices [{:answer/id #uuid "b84ff211-ba60-513c-8d51-316b589c1b4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451377} {:answer/id #uuid "baa1b90a-bf7e-502d-9cc2-4ad14bcca6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451378}] :answer-field/correct {:answer/id #uuid "b84ff211-ba60-513c-8d51-316b589c1b4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451377} :answer-field/id #uuid "3538bb0a-6213-5f28-a889-384259878e28" :answer-field/key "${v}_{4}$ is a linear combination of ${v}_{1}$ and ${v}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452536} {:answer-field/choices [{:answer/id #uuid "8718fe10-dc8a-592d-9d40-03f1b228e7f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451379} {:answer/id #uuid "e5b677d6-f86f-5b86-8f6d-5f8acde3f926" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451380}] :answer-field/correct {:answer/id #uuid "8718fe10-dc8a-592d-9d40-03f1b228e7f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451379} :answer-field/id #uuid "12eb8309-8be1-570a-96c3-7246a920b7d8" :answer-field/key "${v}_{2}$ is a linear combination of ${v}_{1}$ and ${v}_{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452537}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0d14302-1a26-551e-8f3a-e3f476256916" :question/math-academy-id "q-43827" :question/problem "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3},{v}_{4}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{4}}$ is a linearly independent set and ${{v}_{1},{v}_{2},\\text{ }{v}_{3},{v}_{4}}$ is a linearly dependent one, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of the given options in turn.\n\n- Statement “${v}_{3}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{4}$” is true. Since ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly dependent set, we obtain that\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nhas a non-zero solution. Moreover, ${x}_{3}$ can't be zero because then\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{4}{v}_{4}=0\n$$\n\nwill have a non-zero solution and that's a contradiction as ${{v}_{1},{v}_{2},{v}_{4}}$ is linearly independent.\nTherefore, from ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0,$ we get\n\n$$\n{v}_{3}=-\\frac{{x}_{1}}{{x}_{3}}{v}_{1}-\\frac{{x}_{2}}{{x}_{3}}{v}_{2}-\\frac{{x}_{4}}{{x}_{3}}{v}_{4}.\n$$\n\nThis means that ${v}_{3}$ is a linear combination of ${v}_{1}$, ${v}_{2},$ and ${v}_{4}.$\n\n- Statement “${v}_{4}$ is a linear combination of ${v}_{1}$ and ${v}_{2}$” is false. Since ${{v}_{1},{v}_{2},{v}_{4}}$ is a linearly independent set, ${v}_{4}$ can not be a linear combination of other vectors.\n\n- Statement “${v}_{2}$ is a linear combination of ${v}_{1}$ and ${v}_{4}$” is false. Since ${{v}_{1},{v}_{2},{v}_{4}}$ is a linearly independent set, ${v}_{2}$ can not be a linear combination of other vectors.\n\nTherefore, the correct answer is “${v}_{3}$ is a linear combination of ${v}_{1}$, ${v}_{2}$ and ${v}_{4}$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048257 :topic/id #uuid "8cc35c33-61af-5ac3-971b-a33b8bbdcb9d" :topic/math-academy-id 1908 :topic/title "Linear Independence in Abstract Vector Spaces"} :activity/title "Linear Independence in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415054} :db/id #edb/ref 17592186415063}]} {:db/id #edb/ref 17592186329743 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba58b671-2657-5a03-abe7-c1d0f53623a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467554} {:answer/id #uuid "ba1c3ce4-672a-5a3c-a83d-bb611ddd59bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467555}] :answer-field/correct {:answer/id #uuid "ba1c3ce4-672a-5a3c-a83d-bb611ddd59bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467555} :answer-field/id #uuid "4c5d2488-f6b5-5b00-8662-08305a2ef8b5" :answer-field/key "$q(x)\\in W,$ where $q(x)={2}^{x}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468498} {:answer-field/choices [{:answer/id #uuid "40ba87ba-c6e2-5de6-b649-e0483026a236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467556} {:answer/id #uuid "62f2e689-0881-5c43-bed6-64a96561cc4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467557}] :answer-field/correct {:answer/id #uuid "40ba87ba-c6e2-5de6-b649-e0483026a236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467556} :answer-field/id #uuid "a50d472b-7d51-5fe0-859e-60a2e6abcfa4" :answer-field/key "For any $f(x)\\in W$ and $k\\in R,$ we have $k\\cdot f(x)\\in W.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468499} {:answer-field/choices [{:answer/id #uuid "54074d74-4264-5c20-8484-753531648f60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467558} {:answer/id #uuid "e7263bac-9438-5bd2-bceb-9ddd2ae62b91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467559}] :answer-field/correct {:answer/id #uuid "54074d74-4264-5c20-8484-753531648f60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467558} :answer-field/id #uuid "3e58aa32-3f2c-58e2-a22d-6bae8ee75a9b" :answer-field/key "The set is closed under scalar multiplication." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468500}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4fc2576-da47-56c9-aeca-80fed8de957c" :question/math-academy-id "q-43859" :question/problem "Let $W$ be the set of functions $f:R\\to R$ such that $f(0)=1.$ Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's verify the statements one by one.\n\n- Statement “$q(x)\\in W,$ where $q(x)={2}^{x}.$” is true. Indeed, $q(x)={2}^{x}\\in W$ because\n\n$$\nq(0)={2}^{0}=1.\n$$\n\n- Statement “For any $f(x)\\in W$ and $k\\in R,$ we have $k\\cdot f(x)\\in W.$” is false. There exists a function in $W$ that has a scalar multiple *not* in $W.$ For example, let $f(x)={2}^{x}$ and $k=2.$ Notice that $f(x)$ belongs to $W$ since $f(0)=1.$ However,\n\n$$\n2\\cdot f(0)=2\\cdot {2}^{0}=2\\ne 1.\n$$\n\nHence, $k\\cdot f(x)\\notin W.$\n\n- Statement “The set is closed under scalar multiplication” is false. Since statement “For any $f(x)\\in W$ and $k\\in R,$ we have $k\\cdot f(x)\\in W.$” is false, the set is *not* closed under scalar multiplication.\n\nTherefore, the correct answer is “$q(x)\\in W,$ where $q(x)={2}^{x}.$” only."} {:db/id #edb/ref 17592186329750 :knowledge-point/_questions [{:db/id #edb/ref 17592186133869 :knowledge-point/id #uuid "62a2f835-498f-5b9e-9051-89c946558e56" :knowledge-point/title "Identifying True Statements About Orthogonal Vectors in Inner Product Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050331 :topic/id #uuid "4076cd19-9f1e-54c7-b08d-83c706b3cbae" :topic/math-academy-id 2100 :topic/title "Orthogonal Vectors in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6534a1f-f530-5424-9688-7c44f0db33b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451381} {:answer/id #uuid "08d54821-59fc-5873-9304-93d3b65bfe84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451382}] :answer-field/correct {:answer/id #uuid "08d54821-59fc-5873-9304-93d3b65bfe84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451382} :answer-field/id #uuid "13a25f76-fe1c-5fdf-83cd-adab2f40c985" :answer-field/key "$⟨f(t),g(t)⟩=\\frac{1}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452538} {:answer-field/choices [{:answer/id #uuid "f7a440d0-a88a-5188-800f-500c777aa915" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451383} {:answer/id #uuid "dd1fccfe-a02c-59ef-a928-4a46db7daf10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451384}] :answer-field/correct {:answer/id #uuid "f7a440d0-a88a-5188-800f-500c777aa915" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451383} :answer-field/id #uuid "2779cd49-423d-5f5d-850c-909098b2eed5" :answer-field/key "$⟨f(t),g(t)⟩=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452539} {:answer-field/choices [{:answer/id #uuid "cc68676c-ca1c-5219-8aa5-77122434c71c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451385} {:answer/id #uuid "fa9ffda0-5e93-5ed9-aae6-cbb7e4cc5873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451386}] :answer-field/correct {:answer/id #uuid "cc68676c-ca1c-5219-8aa5-77122434c71c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451385} :answer-field/id #uuid "f9acc5d1-05c8-538e-a571-a062b4fe74b6" :answer-field/key "$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452540}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00ac6a8e-9862-5276-9835-c156c0dea515" :question/math-academy-id "q-44058" :question/problem "Let $V=C[0,\\frac{\\pi }{2}]$ be the vector space of all functions that are continuous on $[0,\\frac{\\pi }{2}],$ equipped with the inner product \n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{\\pi /2}f(t)g(t)\\,\\text{d}t.\n$$\n\nGiven the functions $f(t)=\\operatorname{sin}⁡t$ and $g(t)=\\operatorname{cos}⁡t,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to evaluate\n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{sin}⁡t,$ $\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t & ={\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{(1)^{2}}{2}-\\frac{(0)^{2}}{2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nLet's now examine the statements:\n\n- Statement $⟨f(t),g(t)⟩=\\frac{1}{2}$ is true, while statement $⟨f(t),g(t)⟩=0$ is false. This is as a result of the above calculations.\n\n- Statement “$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$” is false. Since the inner product is not zero, our vectors are not orthogonal.\n\nTherefore, the correct answer is $⟨f(t),g(t)⟩=\\frac{1}{2}$ only."} {:db/id #edb/ref 17592186329800 :knowledge-point/_questions [{:db/id #edb/ref 17592186133957 :knowledge-point/id #uuid "1012ae9a-26d6-50bf-a46a-7c859d856752" :knowledge-point/title "Identifying Intervals On Which the IVT Can Be Applied" :topic/_knowledge-points [{:db/id #edb/ref 17592186050810 :topic/id #uuid "6869b952-1056-567b-aee7-9b79143e8e5f" :topic/math-academy-id 2150 :topic/title "The Intermediate Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7405ea-c98b-5325-b63e-2807e36d76d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467560} {:answer/id #uuid "26e98b7e-56f8-5b47-b85d-e433904b1fa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467561}] :answer-field/correct {:answer/id #uuid "26e98b7e-56f8-5b47-b85d-e433904b1fa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467561} :answer-field/id #uuid "0d2f07a7-b601-54ee-9407-23b9e2e1ccad" :answer-field/key "$[0,1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468501} {:answer-field/choices [{:answer/id #uuid "fd77ad93-91ef-5c0f-a754-61403fd2b082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467562} {:answer/id #uuid "3310ece2-aa6d-5452-bfaa-6e91380d4455" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467563}] :answer-field/correct {:answer/id #uuid "fd77ad93-91ef-5c0f-a754-61403fd2b082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467562} :answer-field/id #uuid "66a80203-6b00-5a67-8ab9-e11f7f67970b" :answer-field/key "$[1,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468502} {:answer-field/choices [{:answer/id #uuid "e8378235-3099-5770-a4cf-2dbdf0e69e13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467564} {:answer/id #uuid "f922edc2-68b0-5ca7-8e60-d2d9f9ab5036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467565}] :answer-field/correct {:answer/id #uuid "e8378235-3099-5770-a4cf-2dbdf0e69e13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467564} :answer-field/id #uuid "3698a02e-a636-58f8-a9a1-b0ab2791efd5" :answer-field/key "$[-1,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468503}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "09a3da32-3de0-5834-befe-e2cd86cc2a45" :question/math-academy-id "q-47016" :question/problem "Consider the function $y=\\operatorname{tan}⁡x.$ On which of the following intervals can the intermediate value theorem be applied to this function?\n\nSelect all that apply." :question/worked-solution "The intermediate value theorem can be applied on closed intervals on which the function is continuous. \n\nThe function $f(x)=\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ is discontinuous at the values of $x$ which make the denominator $\\operatorname{cos}⁡x$ equal to zero. Therefore, $f(x)$ is discontinuous at $x=\\frac{\\pi }{2}+n\\pi $, where $n$ is any integer.\n\n- On the interval $[0,1],$ we **can** apply the intermediate value theorem to $y=\\operatorname{tan}⁡x.$\n\n- On the interval $[1,2],$ we **cannot** apply the intermediate value theorem to $y=\\operatorname{tan}⁡x$ because this interval contains the point of discontinuity $\\frac{\\pi }{2}≈1.57\\,.$\n\n- On the interval $[-1,0),$ we **cannot** apply the intermediate value theorem to $y=\\operatorname{tan}⁡x$ because this interval is not closed.\n\nTherefore, the correct answer is $[0,1]$ only."} {:db/id #edb/ref 17592186329801 :knowledge-point/_questions [{:db/id #edb/ref 17592186133957 :knowledge-point/id #uuid "1012ae9a-26d6-50bf-a46a-7c859d856752" :knowledge-point/title "Identifying Intervals On Which the IVT Can Be Applied" :topic/_knowledge-points [{:db/id #edb/ref 17592186050810 :topic/id #uuid "6869b952-1056-567b-aee7-9b79143e8e5f" :topic/math-academy-id 2150 :topic/title "The Intermediate Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9571fe0-bef8-5f1e-9ba0-4c06a4b482c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467566} {:answer/id #uuid "4766a3dd-ffe7-58c7-97d9-8370199dc6e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467567}] :answer-field/correct {:answer/id #uuid "4766a3dd-ffe7-58c7-97d9-8370199dc6e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467567} :answer-field/id #uuid "990578cb-68f3-5bff-ac55-4c4c35ea5506" :answer-field/key "$[-5,-3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468504} {:answer-field/choices [{:answer/id #uuid "a11a4707-8927-586b-bc26-719ddc4f1372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467568} {:answer/id #uuid "47dbafb2-cabc-51dc-9055-c385426b609f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467569}] :answer-field/correct {:answer/id #uuid "a11a4707-8927-586b-bc26-719ddc4f1372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467568} :answer-field/id #uuid "0126cb1a-d5b7-51f6-b9cd-d2b08e3e2f66" :answer-field/key "$[-3,-2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468505} {:answer-field/choices [{:answer/id #uuid "219820d5-c88c-55a4-9c0c-7ab18afb9233" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467570} {:answer/id #uuid "55fd1b5c-e37f-51f0-b8af-339da920860d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467571}] :answer-field/correct {:answer/id #uuid "219820d5-c88c-55a4-9c0c-7ab18afb9233" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467570} :answer-field/id #uuid "e605a49f-dffa-50b2-9558-b152728ee5ef" :answer-field/key "$[-2,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468506}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2fde248b-aec3-5f7a-8ce9-4a20cf4e8153" :question/math-academy-id "q-47035" :question/problem "Consider the function $f(x)=x(x+3)(x-2).$ On which of the following intervals does the intermediate value theorem guarantee that the equation $f(x)=-5$ has a solution?\n\nSelect all that apply." :question/worked-solution "Since $f(x)$ is a polynomial, it's continuous over the real numbers. Thus, we can apply the intermediate value theorem to any of the given intervals.\n\nLet's make a table with the values of $f(x)$ at the endpoints.\n\n| $x$ | $-5$ | $-3$ | $-2$ | $0$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $-70$ | $0$ | $8$ | $0$ |\n\n- On the interval $[-5,-3],$ we have $f(-5)=-70$ and $f(-3)=0.$ Since $-5\\in [-70,0],$ the IVT does guarantee a solution to the equation $f(x)=-5$ on this interval.\n\n- On the interval $[-3,-2],$ we have $f(-3)=0$ and $f(-2)=8.$ Since $-5\\notin [0,8],$ the IVT does *not* guarantee a solution to the equation $f(x)=-5$ on this interval.\n\n- On the interval $[-2,0],$ we have $f(-2)=8$ and $f(0)=0.$ Since $-5\\notin [0,8],$ the IVT does *not* guarantee a solution to the equation $f(x)=-5$ on this interval.\n\nTherefore, the correct answer is $[-5,-3]$ only."} {:db/id #edb/ref 17592186329803 :knowledge-point/_questions [{:db/id #edb/ref 17592186133957 :knowledge-point/id #uuid "1012ae9a-26d6-50bf-a46a-7c859d856752" :knowledge-point/title "Identifying Intervals On Which the IVT Can Be Applied" :topic/_knowledge-points [{:db/id #edb/ref 17592186050810 :topic/id #uuid "6869b952-1056-567b-aee7-9b79143e8e5f" :topic/math-academy-id 2150 :topic/title "The Intermediate Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f344881-385c-5665-85eb-bf009723e051" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467572} {:answer/id #uuid "b0338624-0f00-542b-ad9e-7189e7be0ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467573}] :answer-field/correct {:answer/id #uuid "3f344881-385c-5665-85eb-bf009723e051" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467572} :answer-field/id #uuid "267d92af-d407-5c35-ac8f-a6c162abe01d" :answer-field/key "$[-4,-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468507} {:answer-field/choices [{:answer/id #uuid "c0eccd15-4643-594c-9b76-cc1f8b6669b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467574} {:answer/id #uuid "acfa8399-1619-5e81-b743-8ccb518c5111" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467575}] :answer-field/correct {:answer/id #uuid "acfa8399-1619-5e81-b743-8ccb518c5111" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467575} :answer-field/id #uuid "0e6b3564-dbb4-56c7-a3c8-0f7852ea53a6" :answer-field/key "$[3,5]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468508} {:answer-field/choices [{:answer/id #uuid "1ddc250d-3035-5ac8-aff3-71357621fce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467576} {:answer/id #uuid "57d257e8-63d5-5cd3-990e-9061ae7ffc99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467577}] :answer-field/correct {:answer/id #uuid "1ddc250d-3035-5ac8-aff3-71357621fce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467576} :answer-field/id #uuid "054c1693-cd72-59a0-8e2f-778669cf35f6" :answer-field/key "$[-1,4]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee052f2c-7f8b-5e1c-a710-1b1e4c2963cc" :question/math-academy-id "q-47055" :question/problem "Consider the function $f(x)=\\frac{x+1}{x-2}.$ In which of the following intervals does the intermediate value theorem guarantee that the equation $f(x)=3$ has a solution? \n\nSelect all that apply." :question/worked-solution "The function $f(x)=\\frac{x+1}{x-2}$ is discontinuous at the values of $x$ which make the denominator equal to zero. Therefore, $f(x)$ is discontinuous at $x=2,$ and so the intermediate value theorem can be applied to the function $f(x)$ only on closed intervals that do not contain the point $x=2$ \n\nLet's make a table with the values of $f(x)$ at the endpoints.\n\n| $x$ | $-4$ | $-1$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $0.5$ | $0$ | $4$ | $2.5$ | $2$ |\n\n- On the interval $[-4,-1],$ we have $f(-4)=0.5$ and $f(-1)=0.$ Since $3\\notin [0,0.5],$ the IVT does *not* guarantee a solution to the equation $f(x)=3$ on this interval.\n\n- On the interval $[3,5],$ we have $f(3)=4$ and $f(5)=2.$ Since $3\\in [2,4],$ the IVT *does* guarantee a solution to the equation $f(x)=3$ on this interval.\n\n- The interval $[-1,4]$ contains the point $x=2.$ Therefore we can not apply the intermediate value theorem on this interval.\n\nTherefore, the correct answer is $[3,5]$ only."} {:db/id #edb/ref 17592186329816 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186050359 :topic/id #uuid "424e5d7e-179f-525e-bdaa-70125807f572" :topic/math-academy-id 3563 :topic/title "Describing Properties of the Secant Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e62a7ed-740e-501b-8d6b-8c57af5873e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451387} {:answer/id #uuid "3bf62c5a-98bf-51e9-a149-c724db61f076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451388}] :answer-field/correct {:answer/id #uuid "2e62a7ed-740e-501b-8d6b-8c57af5873e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451387} :answer-field/id #uuid "3f43c87f-65a3-51ec-b164-06e6b244f523" :answer-field/key "The period of the function is $\\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452541} {:answer-field/choices [{:answer/id #uuid "8154f840-2c2b-5e8c-9b2e-eb28ff7d2b70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451389} {:answer/id #uuid "3e98e4ea-c043-58f5-8e9d-ec8d71f9fc74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451390}] :answer-field/correct {:answer/id #uuid "8154f840-2c2b-5e8c-9b2e-eb28ff7d2b70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451389} :answer-field/id #uuid "22fbbc90-7f82-5a70-8099-fd93af7709a8" :answer-field/key "The function is increasing in the interval $(-\\frac{\\pi }{2},0].$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452542} {:answer-field/choices [{:answer/id #uuid "4afaa458-53ac-5375-baf0-a40d0084b83c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451391} {:answer/id #uuid "c86e299f-4afa-5a45-8a32-de03ce84947c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451392}] :answer-field/correct {:answer/id #uuid "c86e299f-4afa-5a45-8a32-de03ce84947c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451392} :answer-field/id #uuid "62c54019-22ca-5af4-aaaf-df8830b76084" :answer-field/key "The function has no zeros." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452543}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ce070dc-f77b-529a-a508-4630f3613570" :question/math-academy-id "q-47455" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{sec}⁡x?$\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/77/779d7a31646a229492a8165c8212a5c83ad7d37d843c1c1b3b36766a74bc5124.png)\n\nLet's go through each statement.\n\n- Statement “The period of the function is $\\pi .$” is false. The period of the function is $2\\pi .$\n\n- Statement “The function is increasing in the interval $(-\\frac{\\pi }{2},0].$” is false. The function $y=sec⁡x$ is decreasing on $(-\\frac{\\pi }{2},0].$\n\n- Statement “The function has no zeros” is true. The function has no zeros."} {:db/id #edb/ref 17592186329820 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049340 :topic/id #uuid "ecf075bf-6d18-5a77-93a9-57ef73f45115" :topic/math-academy-id 1869 :topic/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86d1fafe-67a4-5304-b42b-0fa34a95eaff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467578} {:answer/id #uuid "c76c9ea4-d5d0-5c09-adc5-db52b1568fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467579}] :answer-field/correct {:answer/id #uuid "c76c9ea4-d5d0-5c09-adc5-db52b1568fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467579} :answer-field/id #uuid "3df948ff-c1ab-538f-b99e-ed07682677fc" :answer-field/key "$A$ has no inverse" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468510} {:answer-field/choices [{:answer/id #uuid "6428bf6c-1cd8-523e-89a2-bbd6aefca97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467580} {:answer/id #uuid "49e7f113-867c-5ee0-a738-ba5b88651827" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467581}] :answer-field/correct {:answer/id #uuid "6428bf6c-1cd8-523e-89a2-bbd6aefca97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467580} :answer-field/id #uuid "2e8c77e6-a0b4-526b-bf8e-a435b7b66ac1" :answer-field/key "$\\text{rank}(A)=n$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468511} {:answer-field/choices [{:answer/id #uuid "7b22f319-2182-5f2f-984d-2c69a38c95bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467582} {:answer/id #uuid "f8184f79-583b-5721-92be-e461d3dc1a14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467583}] :answer-field/correct {:answer/id #uuid "7b22f319-2182-5f2f-984d-2c69a38c95bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467582} :answer-field/id #uuid "d58f3fca-628f-5dd4-9837-348f91ad595e" :answer-field/key "All columns of $A$ are pivot columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468512}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c600e13-fdff-5526-82d0-6659ac10dfc3" :question/math-academy-id "q-47587" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{n} \\\\ \\text{dim(Col}(A)) &=n=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$  \n\nIndeed,  a matrix $A$ is invertible if and only if $det(A)\\ne 0.$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $\\text{rank}(A)=n.$*$\\,\\times$\n\nSince our matrix is not invertible, according to the invertible matrix theorem, it must be $\\text{rank}(A)\\ne n.$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then all columns of $A$ are pivot columns.*  $\\,\\times$\n\nSince $\\text{rank}(A)\\ne n$, it must be $\\text{dim(Col}(A))<n,$ which means that not all columns of $A$ are pivot columns.\n\nTherefore, the correct answer is “$A$ has no inverse” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049340 :topic/id #uuid "ecf075bf-6d18-5a77-93a9-57ef73f45115" :topic/math-academy-id 1869 :topic/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity"} :activity/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186528296} :db/id #edb/ref 17592186529204}]} {:db/id #edb/ref 17592186329821 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56e7c760-83ed-5281-9a05-02bdd53f472e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451393} {:answer/id #uuid "1c25083c-8b7e-5fe5-8f5e-8eb45804062d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451394}] :answer-field/correct {:answer/id #uuid "1c25083c-8b7e-5fe5-8f5e-8eb45804062d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451394} :answer-field/id #uuid "42b8cf12-b1ee-56df-a82b-c4c4b8dbd00b" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452544} {:answer-field/choices [{:answer/id #uuid "695aba89-3993-5a92-98dc-4e9a55e876f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451395} {:answer/id #uuid "f8e90fc7-716b-51e9-bf6e-6eb941d76661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451396}] :answer-field/correct {:answer/id #uuid "695aba89-3993-5a92-98dc-4e9a55e876f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451395} :answer-field/id #uuid "5e267111-0c10-5c40-af31-2927630381d9" :answer-field/key "$Ax=0$ has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452545} {:answer-field/choices [{:answer/id #uuid "7eb458c5-d305-5c0f-b510-c154501be818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451397} {:answer/id #uuid "37efc5e7-9dbf-570d-856e-a6d8bc5960e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451398}] :answer-field/correct {:answer/id #uuid "37efc5e7-9dbf-570d-856e-a6d8bc5960e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451398} :answer-field/id #uuid "9d6123ef-1037-5ebd-a9a2-fe6ad93895a1" :answer-field/key "The lines $5x-y=-1$ and $-5x+ky=0$ intersect exactly at one point" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5470569-5538-5c85-aec6-dfcb3a6e366a" :question/math-academy-id "q-47652" :question/problem "Let $A=\\begin{bmatrix}5 & -1 \\\\ -5 & k\\end{bmatrix}$ and $b=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix},$ where $k$ is a constant such that $k\\ne 1.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)\\ne 0$ is true. We have\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}5 & -1 \\\\ -5 & k\\end{bmatrix} \\\\  & =5\\cdot k-(-1)\\cdot (-5) \\\\  & =5k-5.\\end{aligned}\n$$\n\nNotice that $5k-5\\ne 0$ if $k\\ne 1.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “$Ax=0$ has no solution” is false. According to the third part of the invertible matrix theorem, there must be a unique zero solution to $Ax=0.$\n\n- Statement “The lines $5x-y=-1$ and $-5x+ky=0$ intersect exactly at one point” is true. According to the fourth part of the invertible matrix theorem, the lines must intersect at exactly one point.\n\nFinally, only statements $det(A)\\ne 0$ and “The lines $5x-y=-1$ and $-5x+ky=0$ intersect exactly at one point” are true."} {:db/id #edb/ref 17592186329822 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6943c140-8ce8-5ef3-a24a-ec4dd3989d5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467584} {:answer/id #uuid "f903da43-b955-557b-b07e-9a56a9cb9411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467585}] :answer-field/correct {:answer/id #uuid "f903da43-b955-557b-b07e-9a56a9cb9411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467585} :answer-field/id #uuid "131a190d-2e93-5c45-8f99-0ed790058e01" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468513} {:answer-field/choices [{:answer/id #uuid "20a3ed0f-3e98-54bf-9262-acf83b1ca310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467586} {:answer/id #uuid "ce418b35-cc2f-53d8-bacf-bc6a8f351d7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467587}] :answer-field/correct {:answer/id #uuid "ce418b35-cc2f-53d8-bacf-bc6a8f351d7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467587} :answer-field/id #uuid "71011c6f-48e1-5eb7-add1-32fab707cd37" :answer-field/key "$A$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468514} {:answer-field/choices [{:answer/id #uuid "801e1932-e9a9-5a2e-a418-1e17c385bb76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467588} {:answer/id #uuid "6016d1b1-b380-5755-a999-dcec788a69fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467589}] :answer-field/correct {:answer/id #uuid "801e1932-e9a9-5a2e-a418-1e17c385bb76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467588} :answer-field/id #uuid "559e34e0-cb19-5844-a24f-bc87f0e1438e" :answer-field/key "${A}^{-1}$ does not exist" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffbb2a4c-595d-59cc-bffd-a39a18b105b8" :question/math-academy-id "q-47657" :question/problem "Which of the following completes the statement so that it is true:\n\n*If the unique solution of $Ax=0,$ where $A$ is a $2\\times 2$-matrix, is $⟨0,0⟩$, then $\\underline{\\phantom{xxxxxx}}$ .*\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.  \n\nNow, since the third part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem, only options $det(A)\\ne 0$ and “$A$ is invertible” give us true statements:\n\n- *If the unique solution of $Ax=0$ is $⟨0,0⟩$, then $det(A)\\ne 0$ .* $\\,✓$\n\n- *If the unique solution of $Ax=0$ is $⟨0,0⟩$, then $A$ is invertible .*$\\,✓$"} {:db/id #edb/ref 17592186329823 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76eec529-1ff7-57ad-8dc7-b9e3a7ca7314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451399} {:answer/id #uuid "0a53fd56-c030-59d6-9eba-b05dab28cedb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451400}] :answer-field/correct {:answer/id #uuid "0a53fd56-c030-59d6-9eba-b05dab28cedb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451400} :answer-field/id #uuid "744d38f3-a661-5932-b0db-073629ae7f70" :answer-field/key "It is **not** differentiable at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452547} {:answer-field/choices [{:answer/id #uuid "c5297e45-87c1-5249-b34d-07201b1e5710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451401} {:answer/id #uuid "ab86e175-1f5f-5cf0-ad43-555479128a70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451402}] :answer-field/correct {:answer/id #uuid "ab86e175-1f5f-5cf0-ad43-555479128a70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451402} :answer-field/id #uuid "c28e823f-2120-594a-82f6-3352527aec95" :answer-field/key "It  is continuous at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452548} {:answer-field/choices [{:answer/id #uuid "fbc91671-dd80-505f-806e-9a38b0947605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451403} {:answer/id #uuid "3e840629-bf6e-5d37-ad14-3dccc88e02f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451404}] :answer-field/correct {:answer/id #uuid "fbc91671-dd80-505f-806e-9a38b0947605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451403} :answer-field/id #uuid "647b263c-7da1-5276-8051-2c582359c8bd" :answer-field/key "It is differentiable at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452549}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19467d2c-d5fe-5bc4-a4cf-8441c5c34caf" :question/math-academy-id "q-47670" :question/problem "Given that a function $f(x)$ has a jump discontinuity at $x=1$, is differentiable at $x=2$, and has a vertical asymptote at $x=3$, which of the following statements must be true for **any** $f(x)$ that satisfy these criteria?\n\nSelect all that apply." :question/worked-solution "Differentiability implies continuity. Hence,\n\n- Statement “It is **not** differentiable at $x=1$” is true. Since $f(x)$ is not continuous at $x=1$, it can't be differentiable there either.\n\n- Statement “It  is continuous at $x=2$” is true.   Since $f(x)$ is differentiable at $x=2$ it is also  continuous at $x=2.$\n\n- Statement “It is differentiable at $x=3$” is false. Since we have a vertical asymptote at $x=3$, the function $f(x)$ is not continuous at this point, hence it can't be differentiable at $x=3$ either."} {:db/id #edb/ref 17592186329825 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a48906df-e1ca-5248-b6fb-7970aaafe7b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451405} {:answer/id #uuid "f8234ee0-f57e-53fa-b96a-e07bfd2d18fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451406}] :answer-field/correct {:answer/id #uuid "a48906df-e1ca-5248-b6fb-7970aaafe7b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451405} :answer-field/id #uuid "4d19b1ac-9a5a-50ec-a97d-55693e857097" :answer-field/key "It is differentiable at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452550} {:answer-field/choices [{:answer/id #uuid "3c132ed2-ebfa-5599-949c-5ab021d1b898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451407} {:answer/id #uuid "2b69fdb0-a788-5959-a521-193c3b4f76ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451408}] :answer-field/correct {:answer/id #uuid "2b69fdb0-a788-5959-a521-193c3b4f76ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451408} :answer-field/id #uuid "d7e19491-5a3b-5f58-bca0-720e7aec0cd2" :answer-field/key "It  is **not** differentiable at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452551} {:answer-field/choices [{:answer/id #uuid "bd3a3157-77a5-5d36-87c6-011464c86180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451409} {:answer/id #uuid "d071b426-b3e6-5479-b6bb-4a9d02d85637" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451410}] :answer-field/correct {:answer/id #uuid "d071b426-b3e6-5479-b6bb-4a9d02d85637" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451410} :answer-field/id #uuid "ef74da74-37ee-5c81-83e7-fd3dea359ca8" :answer-field/key "It is continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f90e0f73-a650-56a2-851e-2b406e202da6" :question/math-academy-id "q-47679" :question/problem "Given that that a function $f(x)$ is continuous at $x=1$, has a jump discontinuity at $x=2$, and  is differentiable at $x=3$, which of the following statements must be true for **any** $f(x)$ that satisfy these criteria?\n\nSelect all that apply." :question/worked-solution "- Statement “It is differentiable at $x=1$” is false. Continuity does not imply differentiability. For example, the function $y=|x-1|$ is continuous but it's not differentiable at $x=1.$\n\n- Statement “It  is **not** differentiable at $x=2$” is true.  A function that is discontinuous at a point can't be differentiable at this point (because differentiability implies continuity).\n\n- Statement “It is continuous at $x=3$” is true. Indeed, differentiability implies continuity."} {:db/id #edb/ref 17592186329826 :knowledge-point/_questions [{:db/id #edb/ref 17592186115381 :knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3" :knowledge-point/title "Determining Which Functions are Differentiable at a Given Point From the Function Expressions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7586a0dc-25d3-53c5-b3af-cdc314d8fce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451411} {:answer/id #uuid "6dc22f55-8ff2-5a8c-bcc3-e6b2be4c1019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451412}] :answer-field/correct {:answer/id #uuid "7586a0dc-25d3-53c5-b3af-cdc314d8fce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451411} :answer-field/id #uuid "f438756f-c79d-53bd-81ac-ca123103d798" :answer-field/key "It is continuous and differentiable at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452553} {:answer-field/choices [{:answer/id #uuid "1089274e-1ae2-5b78-a393-34038fd470a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451413} {:answer/id #uuid "501e9e09-32a6-52eb-99c7-4a057e5cb0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451414}] :answer-field/correct {:answer/id #uuid "501e9e09-32a6-52eb-99c7-4a057e5cb0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451414} :answer-field/id #uuid "47ec493f-310f-5901-ae51-8ee0e6d54060" :answer-field/key "It is **not** differentiable at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452554} {:answer-field/choices [{:answer/id #uuid "6be1a7df-639d-50cc-ad8c-bbe0418ffddf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451415} {:answer/id #uuid "c045dc4a-dc87-5d60-b5ee-eeb1471cb20e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451416}] :answer-field/correct {:answer/id #uuid "6be1a7df-639d-50cc-ad8c-bbe0418ffddf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451415} :answer-field/id #uuid "51fbc957-ad59-548f-b7b0-b1fa76bed7e9" :answer-field/key "It is differentiable on the interval $(-1,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452555}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8298d153-fa1d-58c6-bfcd-efab6041f9f0" :question/math-academy-id "q-47681" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)=\\{\\begin{aligned}{x}^{3}+1, & x\\ne 1 \\\\ 3, & x=1\\end{aligned}\\,\n$$\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement individually. \n\n- Statement “It is continuous and differentiable at $x=1$” is false.  At $x=1$, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{3}+1)={1}^{3}+1=2 \\\\ {lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{3}+1)={1}^{3}+1=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)={lim}_{x\\to {1}^{-}}f(x)\\ne f(1)=3,\n$$\n\nand so $f(x)$ is not continuous at $x=1$ ($f(x)$ has a removable discontinuity at $x=1$).\n\n- Statement “It is **not** differentiable at $x=1$” is true. Since  $f(x)$ is not continuous at $x=1,$ it is also not differentiable there (because differentiability implies continuity).\n\n- Statement “It is differentiable on the interval $(-1,2)$” is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(-1,2).$\n\nTherefore, only statement “It is **not** differentiable at $x=1$” is true."} {:db/id #edb/ref 17592186329830 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186048295 :topic/id #uuid "920e0459-5102-56be-8b6e-f637c62f1366" :topic/math-academy-id 1531 :topic/title "Graphing Exponential Decay Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2941b1bd-74eb-50ea-8573-ea6bf303ecbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451417} {:answer/id #uuid "3f4809f8-4607-5abc-b8d1-9148e9780cb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451418}] :answer-field/correct {:answer/id #uuid "2941b1bd-74eb-50ea-8573-ea6bf303ecbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451417} :answer-field/id #uuid "9ef339cd-ca1a-5f68-a181-ddfc41baa3a4" :answer-field/key "Its domain is $x>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452556} {:answer-field/choices [{:answer/id #uuid "86926aec-34ec-5ca4-a44d-c7e2f64aec21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451419} {:answer/id #uuid "3cacd08c-54de-5516-90b4-116e69c23f17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451420}] :answer-field/correct {:answer/id #uuid "86926aec-34ec-5ca4-a44d-c7e2f64aec21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451419} :answer-field/id #uuid "3c889f20-b010-5168-b0fc-e32db6413f93" :answer-field/key "Its range is $-\\infty <y<\\infty $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452557} {:answer-field/choices [{:answer/id #uuid "19a58509-615a-5b66-b885-d2c151888b43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451421} {:answer/id #uuid "eed49aff-e179-5980-a3d7-15339409aac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451422}] :answer-field/correct {:answer/id #uuid "eed49aff-e179-5980-a3d7-15339409aac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451422} :answer-field/id #uuid "6bf23fd3-5fce-5331-8251-ee40c271e613" :answer-field/key "It has a horizontal asymptote $y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452558}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "182c44b5-94da-5e7b-aa87-a9b6286e7135" :question/math-academy-id "q-47745" :question/problem "Which of the following statements are true in relation to the function $f(x)=(0.125)^{x}?$\n\nSelect all that apply." :question/worked-solution "Let's start by recalling the graph of $y=(0.125)^{x}:$\n\n![](images/20/20fae3a813e249a6423567b448a1f5515c3b9127e7c0b82aad541e720db03aca.png)\n\nLet's go through the statements one by one.\n\n- Statement “Its domain is $x>0$” is false. The function $f(x)=(0.125)^{x}$ is defined for all input values $x,$ so the domain is $-\\infty <x<\\infty .$\n\n- Statement “Its range is $-\\infty <y<\\infty $” is false. The set of possible outputs of $f(x)=(0.125)^{x}$ consists of all the positive numbers, so the range is $y>0.$\n\n- Statement “It has a horizontal asymptote $y=0$” is true. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $y=0$ is a horizontal asymptote of $y=f(x).$\n\nIn conclusion, only statement “It has a horizontal asymptote $y=0$” is true."} {:db/id #edb/ref 17592186329831 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186048295 :topic/id #uuid "920e0459-5102-56be-8b6e-f637c62f1366" :topic/math-academy-id 1531 :topic/title "Graphing Exponential Decay Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c4946f-7cfd-5eea-9b2a-3c68b8c04bba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451423} {:answer/id #uuid "631df741-fcdf-5ee9-b554-6ce847f8201f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451424}] :answer-field/correct {:answer/id #uuid "631df741-fcdf-5ee9-b554-6ce847f8201f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451424} :answer-field/id #uuid "9ae7393b-6d61-58de-92a9-e49a25b03a56" :answer-field/key "Its domain is $-\\infty <x<\\infty $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452559} {:answer-field/choices [{:answer/id #uuid "ec9a444e-8f67-59aa-984d-88ba3aa4a432" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451425} {:answer/id #uuid "c1829ff3-c9af-5728-b060-4f94a8c1209f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451426}] :answer-field/correct {:answer/id #uuid "c1829ff3-c9af-5728-b060-4f94a8c1209f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451426} :answer-field/id #uuid "fac9daa5-4d61-5666-831a-625724e0a0cc" :answer-field/key "It's a decreasing function" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452560} {:answer-field/choices [{:answer/id #uuid "59f4be26-745f-500a-8014-e08a471c0a22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451427} {:answer/id #uuid "d66a88ac-8487-5227-85df-df58a16cb930" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451428}] :answer-field/correct {:answer/id #uuid "59f4be26-745f-500a-8014-e08a471c0a22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451427} :answer-field/id #uuid "55a523b7-faa6-5772-a250-4264622204cb" :answer-field/key "$f(x)\\to \\infty $ as $x\\to \\infty $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452561}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f25b7dd1-f51b-52ea-a0c4-08f9ed823c0e" :question/math-academy-id "q-47747" :question/problem "Which of the following statements are true in relation to the function $f(x)={(\\frac{1}{2})}^{x}?$\n\nSelect all that apply." :question/worked-solution "Let's start by recalling the graph of $y={(\\frac{1}{2})}^{x}:$\n\n![](images/28/288adf3d1da5cf4bb6e2530318aeb083b69d43639de7704f9df15672be477d0a.png)\n\nLet's go through the statements one by one.\n\n- Statement “Its domain is $-\\infty <x<\\infty $” is true. The function $f(x)={(\\frac{1}{2})}^{x}$ is defined for all input values $x.$\n\n- Statement “It's a decreasing function” is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\n- Statement “$f(x)\\to \\infty $ as $x\\to \\infty $” is false. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $f(x)\\to 0$ as $x\\to \\infty .$\n\nIn conclusion, only statements “Its domain is $-\\infty <x<\\infty $” and “It's a decreasing function” are true."} {:db/id #edb/ref 17592186329840 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cc37e5f-628a-5453-b9aa-5f7736bbc9cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467590} {:answer/id #uuid "86c33542-1a37-5a8c-829b-f0ce4c00b10a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467591}] :answer-fiel