/ref 17592186468520} {:answer-field/choices [{:answer/id #uuid "8f8bfe43-a15d-5668-9257-74a19adfbbb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467600} {:answer/id #uuid "bdbfb014-4e69-5922-98b2-654a079851f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467601}] :answer-field/correct {:answer/id #uuid "bdbfb014-4e69-5922-98b2-654a079851f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467601} :answer-field/id #uuid "ebca5b66-72d2-5051-b663-b25f725bdc65" :answer-field/key "$[3,4]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "632c55e7-35c1-5a02-8973-af67647c4724" :question/math-academy-id "q-48018" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y={log}_{2}⁡(x-2)?$  \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,1]$ is closed, but the function is not continuous on it because $y={log}_{2}⁡(x-2)$ is not defined anywhere in this interval. Therefore, the extreme value theorem is not applicable.\n\n- The interval $[2,3)$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[3,4]$ is closed, and the function is continuous on $[3,4].$  Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is $[3,4]$ only."} {:db/id #edb/ref 17592186329852 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3f46a85-bb8a-511d-ad66-524153b56e1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467602} {:answer/id #uuid "9ac808f8-b76f-5da9-9c2c-f50846ef33e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467603}] :answer-field/correct {:answer/id #uuid "9ac808f8-b76f-5da9-9c2c-f50846ef33e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467603} :answer-field/id #uuid "69cd4ca1-53f7-5c26-b39d-e11af89e4852" :answer-field/key "$[-1,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468522} {:answer-field/choices [{:answer/id #uuid "867861da-42a3-56d6-b2be-e893dd3a6ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467604} {:answer/id #uuid "7d560fb8-d782-59c3-979e-b88c6fc64bea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467605}] :answer-field/correct {:answer/id #uuid "867861da-42a3-56d6-b2be-e893dd3a6ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467604} :answer-field/id #uuid "ce979cb4-0614-53e2-8a28-d665b639c546" :answer-field/key "$(-2,1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468523} {:answer-field/choices [{:answer/id #uuid "28cd7cb5-c364-5a3f-b04d-9d888c1844c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467606} {:answer/id #uuid "10f5285e-8e1a-55c5-9d7e-e0ce7e671593" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467607}] :answer-field/correct {:answer/id #uuid "28cd7cb5-c364-5a3f-b04d-9d888c1844c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467606} :answer-field/id #uuid "a62ebe16-a0c0-5d34-b75e-fc7858ec905c" :answer-field/key "$[-3,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468524}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85a69bc3-3237-5b5c-9f6c-9b2553833eb9" :question/math-academy-id "q-48020" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\operatorname{ln}⁡(x+2)^{2}?$ \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,0]$ is closed, and the function is continuous on $[-1,0]$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(-2,1]$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-3,1]$ is closed, but the function is not continuous on it because $y=\\operatorname{ln}⁡(x+2)^{2}$ is not defined at $x=-2.$ Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[-1,0]$ only."} {:db/id #edb/ref 17592186329853 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowled