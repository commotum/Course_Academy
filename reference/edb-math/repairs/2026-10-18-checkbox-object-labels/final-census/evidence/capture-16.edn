edb/ref 17592186439946}] :answer-field/correct {:answer/id #uuid "c7f8d1ef-4d2a-52c3-97a7-ce498c4ce11b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439945} :answer-field/id #uuid "d02f2705-c6d5-5710-8589-44dd2b88e45c" :answer-field/key "$(4,-4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5577e429-0d55-5dd4-b588-49ac727edd6b" :question/math-academy-id "q-72440" :question/problem "At which points on the curve ${x}^{2}+2xy=-5y+4$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+2xy & =-5y+4 \\\\ {x}^{2}+2xy+5y & =4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+2xy+5y$, our curve can be viewed as the level curve $f(x,y)=4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+2xy+5y)i-\\frac{∂}{∂x}({x}^{2}+2xy+5y)j \\\\  & =(2x+5)\\,i-(2x+2y)\\,j\\end{aligned}\n$$\n\n  \n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+5)\\,i-(2x+2y)\\,j)\\cdot j & =0 \\\\ -(2x+2y) & =0 \\\\ x & =-y\\end{aligned}\n$$\n\nSubstituting $x=-y$ into the equation of our curve gives:    \n\n$$\n\\begin{aligned}{x}^{2}+2xy+5y & =4 \\\\ (-y)^{2}+2(-y)y+5y & =4 \\\\ {y}^{2}-2{y}^{2}+5y & =4 \\\\ -{y}^{2}+5y-4 & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0 \\\\ y & =1\\,\\text{or}\\,y=4\\end{aligned}\n$$\n\nFinally:\n\n- If $y=1$, we get $x=-1$ and the corresponding point is $(-1,1).$\n\n- If $y=4$, we get $x=-4$ and the corresponding point is $(-4,4).$" :step/_content [{:activity/_steps {:activity/title "Quiz 1" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186531933} :db/id #edb/ref 17592186532766}]} {:db/id #edb/ref 17592186339126 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b28d03-cd57-5d78-8671-e5c1d46ed665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467938 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "8ed66caf-fe28-584a-83bf-1f36896c365e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467939}] :answer-field/correct {:answer/id #uuid "23b28d03-cd57-5d78-8671-e5c1d46ed665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467938 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "1cd09d61-c1f0-556d-8c4e-0dd624a70cf5" :answer-field/key "$A=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468690} {:answer-field/choices [{:answer/id #uuid "2b617e07-2740-58b3-b6a5-d9472e257ceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467940} {:answer/id #uuid "b4308405-a8a5-56c9-af60-06c16d1d14d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467941 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "b4308405-a8a5-56c9-af60-06c16d1d14d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467941 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "4ee97b22-001a-5361-9e3b-138ef357939a" :answer-field/key "$B=\\begin{bmatrix}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468691} {:answer-field/choices [{:answer/id #uuid "94af9650-c777-5740-9917-82f863d1fd15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467942} {:answer/id #uuid "3369f3e3-6e3d-5e75-b2a8-d84fac360cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467943 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "3369f3e3-6e3d-5e75-b2a8-d84fac360cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467943 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "3d389fe9-b790-5945-910d-6661d44a7238" :answer-field/key "$C=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ddf8ccb-f483-5bbe-8662-ef5250ea89a5" :question/math-academy-id "q-72489" :question/problem "Which of the following matrices are **not** in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are **not** in row echelon form." :task-item/_content [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/elapsed-seconds 16.434 :task-item/id #uuid "992a4a62-4d41-4f7a-b794-5156808e508e" :task-ite