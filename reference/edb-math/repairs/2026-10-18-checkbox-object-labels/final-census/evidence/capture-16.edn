answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438476 :task-item/_responses [{:db/id #edb/ref 17592186501311 :task-item/content {:db/id #edb/ref 17592186335979} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "57f6da9b-4fb0-58b2-a7a1-8f738e5d1f4c" :answer-field/key "$N = \\begin{bmatrix}1 & 0 & 1 \\\\ 3 & 1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439267}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c563e57f-2913-5048-b8da-281d6ade0aee" :question/math-academy-id "q-69523" :question/problem "Which of the following is a $4\\times 3$ matrix?\n\nSelect all that apply." :question/worked-solution "- The matrix $L$ has $4$ rows and $3$ columns. So, its dimensions are $4\\times 3.$ $\\,✓$\n\n- The matrix $M$ has $3$ rows and $4$ columns. So, its dimensions are $3\\times 4.$ $\\,\\times $\n\n- The matrix $N$ has $2$ rows and $3$ columns. So, its dimensions are $2\\times 3.$ $\\,\\times $\n\nTherefore, only $L$ is a $4\\times 3$ matrix." :task-item/_content [{:db/id #edb/ref 17592186501311 :task-item/content {:db/id #edb/ref 17592186335979} :task-item/elapsed-seconds 33.595 :task-item/id #uuid "c2965712-096e-450a-9bf8-8be7e2e38ec2" :task-item/next {:db/id #edb/ref 17592186501312} :task-item/responses [{:answer/id #uuid "cec8f887-19d9-52c5-979c-41bdf97dea66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438473} {:answer/id #uuid "993a2e57-e68d-5c06-aff9-837e0885e386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438474} {:answer/id #uuid "27f3b618-f6c1-5133-b95f-4d62f222ef52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438476}] :task-item/status {:db/id