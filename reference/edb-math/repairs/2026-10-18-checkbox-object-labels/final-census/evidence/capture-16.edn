swer-field/choices [{:answer/id #uuid "b1d4299d-351a-5fe9-a670-073cc9e5de38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438368} {:answer/id #uuid "fa255a93-20e8-54e8-97be-3ba846492184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438369}] :answer-field/correct {:answer/id #uuid "fa255a93-20e8-54e8-97be-3ba846492184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438369} :answer-field/id #uuid "9f1aeed1-5d5d-55f5-b47f-ad533ff3c9e9" :answer-field/key "$x\\in (-\\infty ,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439213} {:answer-field/choices [{:answer/id #uuid "98321251-a137-534c-9fe9-52d7da6b8d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438370} {:answer/id #uuid "9af520a8-05f9-5db2-8313-3ee23294d164" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438371}] :answer-field/correct {:answer/id #uuid "9af520a8-05f9-5db2-8313-3ee23294d164" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438371} :answer-field/id #uuid "ba5de37a-efe1-5701-9c49-2975bdd66304" :answer-field/key "$x\\in (0,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439214} {:answer-field/choices [{:answer/id #uuid "20ea6006-9ee8-51ed-af73-840f5ecd72e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438372} {:answer/id #uuid "5b63ac11-cd0e-537a-9f3c-14ff4d9d34c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438373}] :answer-field/correct {:answer/id #uuid "5b63ac11-cd0e-537a-9f3c-14ff4d9d34c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438373} :answer-field/id #uuid "938f0d88-c3f0-572a-a97c-94e4a874dfb3" :answer-field/key "$x\\in (-2,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2712841f-ac1b-5d69-a817-019e60c121da" :question/math-academy-id "q-66483" :question/problem "Given that $f(x)=1-x,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply." :question/worked-solution "The function $f(x)$ is a linear function with slope $-1$ and $y$-intercept $1,$ as shown below.\n\n![](images/73/73d9277c040ae457ba6d96e162574edbeeef965d181fa6011ca4ab0e4644bd82.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on $x\\in (0,\\infty )$ and $x\\in (-2,2).$\n\nTherefore, the correct answer is $x\\in (-\\infty ,\\infty )$; $x\\in (0,\\infty )$; $x\\in (-2,2)$."} {:db/id #edb/ref 17592186335886 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-a