e, only $N$ is a $3\\times 2$ matrix." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048896 :topic/id #uuid "ca183854-66cd-5b1f-9d29-03785c3216b8" :topic/math-academy-id 861 :topic/title "Introduction to Matrices"} :activity/title "Review: Introduction to Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569158} :db/id #edb/ref 17592186569159}]} {:db/id #edb/ref 17592186335979 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186048896 :topic/id #uuid "ca183854-66cd-5b1f-9d29-03785c3216b8" :topic/math-academy-id 861 :topic/title "Introduction to Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59af6a9a-42c0-546b-9412-607e459cc142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438472} {:answer/id #uuid "cec8f887-19d9-52c5-979c-41bdf97dea66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438473 :task-item/_responses [{:db/id #edb/ref 17592186501311 :task-item/content {:db/id #edb/ref 17592186335979} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "cec8f887-19d9-52c5-979c-41bdf97dea66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438473 :task-item/_responses [{:db/id #edb/ref 17592186501311 :task-item/content {:db/id #edb/ref 17592186335979} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "be4f58bf-8a1f-59a3-a571-f70e23545235" :answer-field/key "$L = \\begin{bmatrix}1 & 3 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/r