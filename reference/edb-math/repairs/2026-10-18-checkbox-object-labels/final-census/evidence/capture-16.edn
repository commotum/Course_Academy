ref 17592186467996} {:answer/id #uuid "eab7a7c3-30eb-5cd9-ba7c-0bcf3740bbb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467997}] :answer-field/correct {:answer/id #uuid "eab7a7c3-30eb-5cd9-ba7c-0bcf3740bbb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467997} :answer-field/id #uuid "a3561402-4086-52ee-8262-e4d7f3ab1c5d" :answer-field/key "The function is continuous at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7ec702-6570-50d7-8199-a59c190c3e40" :question/math-academy-id "q-73252" :question/problem "![](images/1f/1f2d8b9faac6c300b41902cea5065bf8bafb02c137232ee79779a4dc3ff67f33.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- Statement “The function is continuous at $x=-1$” is true. The graph can be drawn in a neighborhood of $x=-1$ without taking the pencil off the paper.\n\n- Statement “The function is differentiable at $x=1$” is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$ So, it can't be differentiable there.\n\n- Statement “The function is continuous at $x=2$” is true. The graph can be drawn in a neighborhood of $x=2$ without taking the pencil off the paper.\n\nTherefore, only statements “The function is continuous at $x=-1$” and “The function is continuous at $x=2$”  are true."} {:db/id #edb/ref 17592186341931 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28a38711-67d6-55a9-b1a0-49d52f64b6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451567} {:answer/id #uuid "89eac520-48f3-5f0c-bc5e-02e2b3ac1cf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451568}] :answer-field/correct {:answer/id #uuid "89eac520-48f3-5f0c-bc5e-02e2b3ac1cf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451568} :answer-field/id #uuid "17ba1305-8075-590e-bee9-364de771966f" :answer-field/key "${lim}_{x\\to 4}f(x)=f(4).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452631} {:answer-field/choices [{:answer/id #uuid "0f2ffdd1-6e52-5218-9c43-48e390e43d99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451569} {:answer/id #uuid "52f16680-a21d-5cac-ba01-66b077e4e7a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451570}] :answer-field/correct {:answer/id #uuid "52f16680-a21d-5cac-ba01-66b077e4e7a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451570} :answer-field/id #uuid "d897ece2-0978-57f7-b23e-b70fd12cec7f" :answer-field/key "It is **not** differentiable at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452632} {:answer-field/choices [{:answer/id #uuid "b8754041-824b-565b-a821-10eb2a36bf3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451571} {:answer/id #uuid "8a3a92a8-31bd-5649-8fb9-7861669986fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451572}] :answer-field/correct {:answer/id #uuid "b8754041-824b-565b-a821-10eb2a36bf3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451571} :answer-field/id #uuid "c975d66c-aad1-5af1-b3ea-7db71a8dfb3a" :answer-field/key "It is differentiable at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452633}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef354870-3599-55d1-9c3b-8b4fa57a2d1f" :question/math-academy-id "q-73260" :question/problem "Given that a function $f(x)$ is continuous at $x=0$, has a corner point at $x=2,$ and is differentiable at $x=4$, which of the following statements must be true for **any** $f(x)$ that satisfy these criteria?\n\nSelect all that apply." :question/worked-solution "- Statement ${lim}_{x\\to 4}f(x)=f(4).$ is true. Differentiability implies continuity. Hence, ${lim}_{x\\to 4}f(x)=f(4).$\n\n- Statement “It is **not** differentiable at $x=2$” is true. The function has a corner point at $x=2$, so it's not differentiable there.\n\n- Statement “It is differentiable at $x=0$” is false.  Continuity does not imply differentiability. For instance, the function  $g(x)=|x|$ is continuous at $x=0$ but it is not differentiable there."} {:db/id #edb/ref 17592186341933 :knowledge-point/_questions [{:db/id #edb/ref 17592186115381 :knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3" :knowledge-point/title "Determining Which Functions are Differentiable at a Given Point From the Function Expressions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "601e554b-2aff-5f89-8639-25309deb068e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451573} {:answer/id #uuid "2712d4f8-2537-5721-9315-3b3b7cdc1383" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451574}] :answer-field/correct {:answer/id #uuid "601e554b-2aff-5f89-8639-25309deb068e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451573} :answer-field/id #uuid "e2a58f04-6974-56f4-b0c0-be3ef4366a57" :answer-field/key "It is continuous and differentiable at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452634} {:answer-field/choices [{:answer/id #uuid "44f0b0bc-695a-5281-9d76-d704f0a1a0c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451575} {:answer/id #uuid "3e3a1be7-acda-5257-b1db-f86658a13a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451576}] :answer-field/correct {:answer/id #uuid "44f0b0bc-695a-5281-9d76-d704f0a1a0c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451575} :answer-field/id #uuid "0f34bcb5-7749-5298-b6c6-0b25d961d09f" :answer-field/key "It is **not** continuous at $x=0$ but it is differentiable at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452635} {:answer-field/choices [{:answer/id #uuid "a90a205b-4da2-57fb-82cb-2f1ab01f9c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451577} {:answer/id #uuid "6440144d-fcdb-5152-a26f-63ef65b532f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451578}] :answer-field/correct {:answer/id #uuid "6440144d-fcdb-5152-a26f-63ef65b532f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451578} :answer-field/id #uuid "282c39a5-f6af-5051-b949-ddf53ea0f4fe" :answer-field/key "It is **not** differentiable on the interval $x\\in (-1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7575eddd-8de6-52ad-9db9-422a74ac2262" :question/math-academy-id "q-73267" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)={\\begin{aligned}{x}^{3}-1, & x\\ne 0 \\\\ 1, & x=0\\end{aligned}\n$$\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement individually.\n\n- Statement “It is continuous and differentiable at $x=0$” is false. First, we investigate the continuity of $f(x)$ . It is continuous everywhere except, possibly, $x=0.$ At this point, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to {0}^{+}}({x}^{3}-1)={0}^{3}-1=-1 \\\\ {lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}({x}^{3}-1)={0}^{3}-1=-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)={lim}_{x\\to {0}^{-}}f(x)\\ne f(0)=1,\n$$\n\n \nand so $f(x)$ is not continuous at $x=0.$ Therefore, it's not differentiable there either.\n\n- Statement “It is **not** continuous at $x=0$ but it is differentiable at $x=0$” is false. Since $f(x)$ is not continuous at $x=0,$ it is also not differentiable there.\n\n- Statement “It is **not** differentiable on the interval $x\\in (-1,1)$” is true. Since $f(x)$ is not differentiable at $x=0,$ it is not differentiable on any interval that includes this point. Consequently, it is not differentiable in $x\\in (-1,1).$\n\nTherefore, only statement “It is **not** differentiable on the interval $x\\in (-1,1)$” is true."} {:db/id #edb/ref 17592186341934 :knowledge-point/_questions [{:db/id #edb/ref 17592186115381 :knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3" :knowledge-point/title "Determining Which Functions are Differentiable at a Given Point From the Function Expressions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c75dc9f-c775-5c9b-bcb6-00142f5b74e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451579} {:answer/id #uuid "fd6f1899-441e-532a-9e1c-5def882a97ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451580}] :answer-field/correct {:answer/id #uuid "fd6f1899-441e-532a-9e1c-5def882a97ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451580} :answer-field/id #uuid "6b52e236-ea68-51a4-ab5d-1692e9358315" :answer-field/key "It is continuous at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452637} {:answer-field/choices [{:answer/id #uuid "5886fcbc-dc5f-51c1-8b84-ad2ea7e4b4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451581} {:answer/id #uuid "9b9a0b54-6128-5e15-b575-38567a554319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451582}] :answer-field/correct {:answer/id #uuid "9b9a0b54-6128-5e15-b575-38567a554319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451582} :answer-field/id #uuid "329967ec-a76c-5d0a-ad5e-97035d99abb9" :answer-field/key "It is **not** differentiable at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452638} {:answer-field/choices [{:answer/id #uuid "cc12d076-a132-5439-bcff-85a2f98a3a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451583} {:answer/id #uuid "1837bd41-edb2-5da4-b7dc-40639c80a4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451584}] :answer-field/correct {:answer/id #uuid "cc12d076-a132-5439-bcff-85a2f98a3a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451583} :answer-field/id #uuid "fbeb86e7-e503-5403-a017-7e6de8641d02" :answer-field/key "It is differentiable on the interval $(0,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "362e198f-bd1f-525b-82d3-de496c41fcc9" :question/math-academy-id "q-73270" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)={\\begin{aligned}x+1, & x<1 \\\\ 2, & x\\ge 1\\end{aligned}\\,\n$$\n\nSelect all that apply." :question/worked-solution "- Statement “It is continuous at $x=1$” and “It is **not** differentiable at $x=1$” are true. Indeed, let's investigate the continuity of $f(x).$ It is continuous everywhere except, possibly at  $x=1.$ At this point, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}(x+1)=1+1=2 \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}2=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)={lim}_{x\\to {1}^{-}}f(x)=f(1)=2,\n$$\n\nand so $f(x)$ is  continuous at $x=1$ . However, $f(x)$ is not differentiable at $x=1$ because it has a corner point there: \n\n$\\,$ ${f}^{′}(x)=1\\,$  if  $\\,x<1$ and ${f}^{′}(x)=0\\,$ if $\\,x>1$\n\n- Statement “It is differentiable on the interval $(0,2)$” is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(0,2).$\n\nTherefore, only statements “It is continuous at $x=1$” and “It is **not** differentiable at $x=1$” are true."} {:db/id #edb/ref 17592186341975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee362845-daee-5897-bb75-a961373d980a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467998} {:answer/id #uuid "c22a2228-a3c6-5842-b39f-a0af3f9bc381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467999}] :answer-field/correct {:answer/id #uuid "ee362845-daee-5897-bb75-a961373d980a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467998} :answer-field/id #uuid "a71e3e63-1a5c-5eb2-a82a-43054a88f1ed" :answer-field/key "$[-\\pi ,\\pi ]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468720} {:answer-field/choices [{:answer/id #uuid "fb86d5a5-83ae-595d-966a-9d55785d578b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468000} {:answer/id #uuid "77c6f1f4-b497-53af-a531-08703acde8e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468001}] :answer-field/correct {:answer/id #uuid "fb86d5a5-83ae-595d-966a-9d55785d578b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468000} :answer-field/id #uuid "8a5f5fbe-cfc0-5d01-a03c-9fabbb782489" :answer-field/key "$[-\\pi ,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468721} {:answer-field/choices [{:answer/id #uuid "6c3eb099-3817-5824-9961-6c7d871c978c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468002} {:answer/id #uuid "440d23ee-20e9-53fc-b516-424c68aa9501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468003}] :answer-field/correct {:answer/id #uuid "440d23ee-20e9-53fc-b516-424c68aa9501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468003} :answer-field/id #uuid "fa030baa-01fb-586b-9925-167b6b320ec5" :answer-field/key "$[1,\\pi ]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468722}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbdd6305-e297-593d-89f4-fb7ada8ade14" :question/math-academy-id "q-73455" :question/problem "![](images/de/de39663db59e42565c7d69d8a44a4cb95f14af0f4946b77cfc42eac02f7d2786.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\pi ]$ is closed,but the function has a removable discontinuity at $x=0.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[-\\pi ,0)$ is not closed, so, the extreme value theorem is not applicable.\n\n- The interval $[1,\\pi ]$ is closed, and the function is continuous on $[1,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is $[1,\\pi ]$ only."} {:db/id #edb/ref 17592186341981 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1a7dfce-6bc6-58f9-beef-bc1c118e1ce4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468004} {:answer/id #uuid "41f032ab-2bf6-598d-a02f-0c37ae9c222c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468005}] :answer-field/correct {:answer/id #uuid "f1a7dfce-6bc6-58f9-beef-bc1c118e1ce4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468004} :answer-field/id #uuid "1091c558-abc6-5fc7-bdf1-7b6bbc2db065" :answer-field/key "$[-\\pi ,\\frac{\\pi }{2}]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468723} {:answer-field/choices [{:answer/id #uuid "1c6ee0d7-ff8b-5c37-a845-c650d0be027c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468006} {:answer/id #uuid "8222ba74-fcde-5aff-b5d5-66d7a0a0aa98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468007}] :answer-field/correct {:answer/id #uuid "8222ba74-fcde-5aff-b5d5-66d7a0a0aa98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468007} :answer-field/id #uuid "3b6e5b5c-d047-5c5a-9b1e-eaaf8a0d9e5e" :answer-field/key "$[0,\\pi ]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468724} {:answer-field/choices [{:answer/id #uuid "f60334dd-7450-5506-9ad6-c5f3f34ea05b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468008} {:answer/id #uuid "365370d4-b716-5b86-bc0b-1825dda26f0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468009}] :answer-field/correct {:answer/id #uuid "f60334dd-7450-5506-9ad6-c5f3f34ea05b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468008} :answer-field/id #uuid "9bf7440a-843f-5f95-b5a5-89b9f88c1712" :answer-field/key "$(-\\frac{\\pi }{2},\\frac{\\pi }{2}]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468725}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b5c08f3-5fbe-50f0-8681-6cf3ebc354c4" :question/math-academy-id "q-73463" :question/problem "![](images/4d/4de4aa4956b0b70e6e08c9f0188944469270ab19501194ce897e2af9411a0d98.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\frac{\\pi }{2}]$  is closed, but the function has a removable discontinuity at $x=-\\frac{\\pi }{2}.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[0,\\pi ]$ is closed, and the function is continuous on $[0,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(-\\frac{\\pi }{2},\\frac{\\pi }{2}]$  is not closed, so, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[0,\\pi ]$ only."} {:db/id #edb/ref 17592186341984 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61e532f7-a8d4-5ad0-87fa-e0abb07a53ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468010} {:answer/id #uuid "166b32ef-7d9c-5749-b3c9-7228a4faa2d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468011}] :answer-field/correct {:answer/id #uuid "61e532f7-a8d4-5ad0-87fa-e0abb07a53ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468010} :answer-field/id #uuid "11346c34-25dc-5818-adc6-68489744c4a9" :answer-field/key "$[-1,5]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468726} {:answer-field/choices [{:answer/id #uuid "fcab39e9-589e-5993-9821-bf3f565fc3c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468012} {:answer/id #uuid "5faf65eb-1420-5b19-84fa-7b4d080f51e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468013}] :answer-field/correct {:answer/id #uuid "5faf65eb-1420-5b19-84fa-7b4d080f51e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468013} :answer-field/id #uuid "cd1c1baa-2550-538a-9bce-29f2173a21b4" :answer-field/key "$[0,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468727} {:answer-field/choices [{:answer/id #uuid "137588e4-2424-5d62-8fe6-5492472a9566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468014} {:answer/id #uuid "ec6eb95e-2a8c-5ac0-b216-c72fc2f4b9cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468015}] :answer-field/correct {:answer/id #uuid "ec6eb95e-2a8c-5ac0-b216-c72fc2f4b9cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468015} :answer-field/id #uuid "6cf26ba3-fa7e-5c2b-86e3-65a942cdda6b" :answer-field/key "$[2,5]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468728}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "122f233b-5382-5fef-8fbd-2b8682266e28" :question/math-academy-id "q-73481" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\sqrt[4]{x}}{{x}^{2}+1}?$   \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,5]$ is closed, but the function is not continuous on it because $\\sqrt[4]{x}$ is not defined anywhere in the subinterval $[-1,0).$  Therefore, the extreme value theorem is not applicable.\n\n- The intervals $[0,2]$ and $[2,5]$ are closed, and the function is continuous on each of these intervals Therefore, the extreme value theorem is applicable on each $[0,2]$  and $[2,5].$\n\nIn conclusion, the correct answer is $[0,2]$; $[2,5]$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"} :activity/title "The Extreme Value Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508384} :db/id #edb/ref 17592186509047}]}]
