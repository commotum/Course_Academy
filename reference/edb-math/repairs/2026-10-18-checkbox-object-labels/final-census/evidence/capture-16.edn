answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467733} :answer-field/id #uuid "5e6f04cd-45e8-5848-992c-8679294beeaf" :answer-field/key "$(-\\frac{1}{2},-\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468587}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "53be597d-dd1d-573c-aa44-0038d6375f1c" :question/math-academy-id "q-65822" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points.  \n\n- First, we consider the point $(0,-\\pi ).$ We note the following:\n\n- The point $(-\\pi ,0)$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-\\pi $ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(0,-\\pi )$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $(-1,\\frac{3\\pi }{2}).$ We note the following:\n\n- The point $(\\frac{3\\pi }{2},-1)$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{3\\pi }{2}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-1,\\frac{3\\pi }{2})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(-\\frac{1}{2},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},-\\frac{1}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{1}{2},-\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arcsin}⁡x.$"} {:db/id #edb/ref 17592186335868 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049656 :topic/id #uuid "08bc988d-9fd4-51b9-b9a1-01573e3679f4" :topic/math-academy-id 1487 :topic/title "Graphing the Inverse Tangent Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e29c3cbf-ed0c-5f33-a9f0-4d3cdc0ce3f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467734} {:answer/id #uuid "58f8682f-85e2-5cc2-a2ed-0e7c63277345" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467735}] :answer-field/correct {:answer/id #uuid "58f8682f-85e2-5cc2-a2ed-0e7c63277345" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467735} :answer-field/id #uuid "67ac0352-4b5d-55b6-8626-8235d35b0584" :answer-field/key "$(\\frac{1}{\\sqrt{3}},\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468588} {:answer-field/choices [{:answer/id #uuid "543f638b-e58b-5244-baca-fc2e353d3d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467736} {:answer/id #uuid "