er/id #uuid "8f505551-c5b9-5992-8523-d0f2ab34f1e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439928}] :answer-field/correct {:answer/id #uuid "400433b5-a356-507e-a575-1bc28d48f70d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439927} :answer-field/id #uuid "150d32c1-350a-571d-834f-71f20d3a563a" :answer-field/key "$(2,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440321} {:answer-field/choices [{:answer/id #uuid "ed83a8d6-9e07-5905-be1f-34b393c3d6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439929} {:answer/id #uuid "dcef0c5c-1acb-5551-97b3-3f576bf135b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439930}] :answer-field/correct {:answer/id #uuid "ed83a8d6-9e07-5905-be1f-34b393c3d6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439929} :answer-field/id #uuid "1e3dbaf6-9358-5c2a-9801-aef6c67ddc06" :answer-field/key "$(2,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440322} {:answer-field/choices [{:answer/id #uuid "065e1081-b5f1-5f33-a472-b91a349b1ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439931} {:answer/id #uuid "4bed7d93-95ff-5f0a-9e8a-462b709673d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439932}] :answer-field/correct {:answer/id #uuid "4bed7d93-95ff-5f0a-9e8a-462b709673d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439932} :answer-field/id #uuid "a537d884-e552-57b7-b8f8-e2de9abb83a0" :answer-field/key "$(2,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440323}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9c0801c9-8ff6-5c1f-a200-5a0877707694" :question/math-academy-id "q-72410" :question/problem "At which points on the curve ${y}^{2}+2xy={x}^{2}+8$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2xy & ={x}^{2}+8 \\\\ {y}^{2}+2xy-{x}^{2} & =8\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2xy-{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=8.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2xy-{x}^{2})i-\\frac{∂}{∂x}({y}^{2}+2xy-{x}^{2})j \\\\  & =2(y+x)\\,i-2(y-x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ (2(y+x)\\,i-2(y-x)\\,j)\\cdot j & =0 \\\\ -2(y-x) & =0 \\\\ y & =x\\end{aligned}\n$$\n\nSubstituting $y=x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2xy-{x}^{2} & =8 \\\\ (x)^{2}+2x(x)-{x}^{2} & =8 \\\\ {x}^{2}+2{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nFinally:\n\n- If $x=2$, we get $y=2$ and the corresponding point is $(2,2).$\n\n- If $x=-2$, we get $y=-2$ and the corresponding point is $(-2,-2).$" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049511 :topic/id #uuid "fabe76f4-9f30-5b59-b906-f5fa71cfb89f" :topic/math-academy-id 1940 :topic/title "Tangent Lines to Level Curves"} :activity/title "Tangent Lines to Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481766} :db/id #edb/ref 17592186482641}]} {:db/id #edb/ref 17592186339115 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186049511 :topic/id #uuid "fabe76f4-9f30-5b59-b906-f5fa71cfb89f" :topic/math-academy-id 1940 :topic/title "Tangent Lines to Level Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "913ad9eb-89eb-5a60-ac19-fc37d153f23a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439933} {:answer/id #uuid "38454e86-b9b2-5147-b5f5-57a1c469fc1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439934}] :answer-field/correct {:answer/id #uuid "913ad9eb-89eb-5a60-ac19-fc37d153f23a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439933} :answer-field/id #uuid "913b33c0-9682-5034-a4bc-ca4b66f58927" :answer-field/key "$(-4,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440324} {:answer-field/choices [{:answer/id #uuid "33b48cb1-a3d5-5e03-bba7-fd3e349f22a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439935} {:answer/id #uuid "9ef79959-5b46-5fd5-a1f2-b3ef81d41dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439936}] :answer-field/correct {:answer/id #uuid "9