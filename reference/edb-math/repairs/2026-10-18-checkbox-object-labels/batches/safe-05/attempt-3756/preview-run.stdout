 [17592186450972 1077 "I" 13194139537069 17592186576411 false] [17592186450973 1077 "For any $f(x),g(x)\\in N$, we have $f(x)+g(x)\\in N.$" 13194139537069 17592186576411 true] [17592186450973 1077 "II" 13194139537069 17592186576411 false] [17592186450974 1077 "III" 13194139537069 17592186576411 false] [17592186450974 1077 "The set is closed under addition." 13194139537069 17592186576411 true] [17592186450975 1077 "I" 13194139537069 17592186576411 false] [17592186450975 1077 "The  matrix $\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}$ belongs to $S.$" 13194139537069 17592186576411 true] [17592186450976 1077 "For any $A\\in S,$ we can find the corresponding negative matrix $-A\\in S$ such that $A+(-A)=O.$" 13194139537069 17592186576411 true] [17592186450976 1077 "II" 13194139537069 17592186576411 false] [17592186450977 1077 "For any $A,B,C\\in S,$ we have $A+(B-C)=(A+B)-C.$" 13194139537069 17592186576411 true] [17592186450977 1077 "III" 13194139537069 17592186576411 false] [17592186450981 1077 "${f}_{1}(y,z)=\\sqrt{2y}$ and ${f}_{2}(y,z)=\\sqrt{{y}^{2}+{z}^{2}}$" 13194139537069 17592186576411 true] [17592186450981 1077 "I" 13194139537069 17592186576411 false] [17592186450982 1077 "${g}_{1}(y)=-\\sqrt{1-(y-1)^{2}}$ and ${g}_{2}(y)=\\sqrt{1-(y-1)^{2}}$" 13194139537069 17592186576411 true] [17592186450982 1077 "II" 13194139537069 17592186576411 false] [17592186450983 1077 "$a=-1$ and $b=1$" 13194139537069 17592186576411 true] [17592186450983 1077 "III" 13194139537069 17592186576411 false] [17592186450984 1077 "I" 13194139537069 17592186576411 false] [17592186450984 1077 "The zero matrix $O=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ belongs to $G.$" 13194139537069 17592186576411 true] [17592186450985 1077 "For the zero matrix $O$ and any $A\\in G,$ we have $A-O=A.$" 13194139537069 17592186576411 true] [17592186450985 1077 "II" 13194139537069 17592186576411 false] [17592186450986 1077 "For any $A,B\\in G,$ we have $A-B=B-A.$" 13194139537069 17592186576411 true] [1759