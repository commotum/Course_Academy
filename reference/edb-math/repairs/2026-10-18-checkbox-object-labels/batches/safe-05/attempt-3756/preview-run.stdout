 true] [17592186450946 1077 "II" 13194139537069 17592186576411 false] [17592186450946 1077 "The inverse ${f}^{-1}$ is continuously differentiable in a neighborhood of $b.$" 13194139537069 17592186576411 true] [17592186450947 1077 "III" 13194139537069 17592186576411 false] [17592186450947 1077 "The derivative of ${f}^{-1}$ is given by ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$" 13194139537069 17592186576411 true] [17592186450948 1077 "${w}^{4}+1=1$" 13194139537069 17592186576411 true] [17592186450948 1077 "I" 13194139537069 17592186576411 false] [17592186450949 1077 "${(\\frac{z}{w})}^{4}=1$" 13194139537069 17592186576411 true] [17592186450949 1077 "II" 13194139537069 17592186576411 false] [17592186450950 1077 "$\\frac{z}{w}$ is a $4$th root of unity" 13194139537069 17592186576411 true] [17592186450950 1077 "III" 13194139537069 17592186576411 false] [17592186450951 1077 "$({z}^{3})^{2}=-1$" 13194139537069 17592186576411 true] [17592186450951 1077 "I" 13194139537069 17592186576411 false] [17592186450952 1077 "${z}^{3}$ is a $6$th root of unity" 13194139537069 17592186576411 true] [17592186450952 1077 "II" 13194139537069 17592186576411 false] [17592186450953 1077 "${z}^{3}$ is a square root of unity" 13194139537069 17592186576411 true] [17592186450953 1077 "III" 13194139537069 17592186576411 false] [17592186450954 1077 "${z}^{8}=1$" 13194139537069 17592186576411 true] [17592186450954 1077 "I" 13194139537069 17592186576411 false] [17592186450955 1077 "$(zw)^{8}=1$" 13194139537069 17592186576411 true] [17592186450955 1077 "II" 13194139537069 17592186576411 false] [17592186450956 1077 "$zw$ is an $8$th root of unity" 13194139537069 17592186576411 true] [17592186450956 1077 "III" 13194139537069 17592186576411 false] [17592186450957 1077 "$({z}^{4})^{2}=-1$" 13194139537069 17592186576411 true] [17592186450957 1077 "I" 13194139537069 17592186576411 false] [17592186450958 1077 "${z}^{4}$ is an $8$th root of unity" 13194139537069 17592186576411 true] [17592186450958 1077 "II