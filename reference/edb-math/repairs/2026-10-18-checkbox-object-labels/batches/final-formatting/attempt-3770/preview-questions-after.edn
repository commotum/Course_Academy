n}⁡x\\,i$ $-\\operatorname{cos}⁡y\\,j$ $+{z}^{2}\\,k$ only."} {:db/id #edb/ref 17592186256695 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a596d75-c886-5b2a-91fb-fb7040912254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437660} {:answer/id #uuid "14d600f9-2df6-53a0-baaf-26570d859584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437661}] :answer-field/correct {:answer/id #uuid "14d600f9-2df6-53a0-baaf-26570d859584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437661} :answer-field/id #uuid "bdfc827e-4a82-5cd1-a5ae-5c66a06116d1" :answer-field/key "$D(x,y,z)$ $=5\\,i$ $+{z}^{2}\\,j$ $+(y+x)\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438859} {:answer-field/choices [{:answer/id #uuid "660dc541-8ade-5251-99f2-6387f6ee265f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437662} {:answer/id #uuid "7c8b8c9c-d9b9-56b4-b891-4ed17c9de49f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437663}] :answer-field/correct {:answer/id #uuid "660dc541-8ade-5251-99f2-6387f6ee265f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437662} :answer-field/id #uuid "028c2887-4e28-5453-a433-e92b6b42deee" :answer-field/key "$E(x,y)={x}^{2}\\,i-\\sqrt{y}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438860} {:answer-field/choices [{:answer/id #uuid "91914c88-1e9a-57db-9467-36862e8b8bab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437664} {:answer/id #uuid "602a7c8d-0df8-5802-a275-63a5f0ec8f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437665}] :answer-field/correct {:answer/id #uuid "602a7c8d-0df8-5802-a275-63a5f0ec8f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437665} :answer-field/id #uuid "c8a0ad93-ccff-5c53-b92c-06f494f55cfe" :answer-field/key "$G(x,y,z)$ $=x(y+1)\\,i$ $+\\operatorname{tan}⁡(y-z)\\,j$ $+{z}^{3}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09fffcb2-a27e-5da4-b160-3d4f79d02cb0" :question/math-academy-id "q-122688" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $D(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point $(x,y,z)\\in {R}^{3}$ to a vector in ${R}^{3}.$\n\n- The function $E(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $G(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,y-z\\ne \\frac{\\pi }{2}+n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $D(x,y,z)$ $=5\\,i$ $+{z}^{2}\\,j$ $+(y+x)\\,k$; $G(x,y,z)$ $=x(y+1)\\,i$ $+\\operatorname{tan}⁡(y-z)\\,j$ $+{z}^{3}\\,k$ only."} {:db/id #edb/ref 17592186256698 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd70e4d-6c48-57c7-9de7-29fb91ecd156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437672} {:answer/id #uuid "c8a035b0-a3e5-53be-a422-6c7151b90283" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437673}] :answer-field/correct {:answer/id #uuid "1cd70e4d-6c48-57c7-9de7-29fb91ecd156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437672} :answer-field/id #uuid "82f16859-809f-5571-9e24-04024074834c" :answer-field/key "$N(x,y)=⟨x{e}^{y},\\sqrt{x+y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438865} {:answer-field/choices [{:answer/id #uuid "84952cf5-bae9-566b-8785-0e7b44cb9f1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437674} {:answer/id #uuid "9499395a-41a6-544d-ae0b-b638a3373619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437675}] :answer-field/correct {:answer/id #uuid "9499395a-41a6-544d-ae0b-b638a3373619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437675} :answer-field/id #uuid "16a42706-0e2c-5b8a-a048-2ec4e31f3fbc" :answer-field/key "$P(x,y,z)$ $=⟨{e}^{x-2y},\\sqrt{3-x},3{z}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438866} {:answer-field/choices [{:answer/id #uuid "df7e1c2f-9a73-51cd-b44a-97d3a3f06124" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437676} {:answer/id #uuid "0039b744-c30f-5b87-90ae-3f6e231319ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437677}] :answer-field/correct {:answer/id #uuid "0039b744-c30f-5b87-90ae-3f6e231319ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437677} :answer-field/id #uuid "28d18e6e-3fdd-511d-adcf-4ebf4d97e428" :answer-field/key "$Q(x,y,z)$ $=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "659f4527-cc88-5c6b-8485-f595eee1689f" :question/math-academy-id "q-122694" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,3-x\\ge 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,2x-y+z>0}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $P(x,y,z)$ $=⟨{e}^{x-2y},\\sqrt{3-x},3{z}^{3}⟩$; $Q(x,y,z)$ $=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$ only."} {:db/id #edb/ref 17592186256699 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381ec827-a8d9-525e-879e-9867a01781c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437684} {:answer/id #uuid "49b34905-3523-5220-8445-649a78b38000" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437685}] :answer-field/correct {:answer/id #uuid "381ec827-a8d9-525e-879e-9867a01781c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437684} :answer-field/id #uuid "18ab9680-7869-5328-9a15-6eba928afef1" :answer-field/key "$C(x,y,z)=\\frac{z}{x+y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438871} {:answer-field/choices [{:answer/id #uuid "87e56ee0-4b15-585a-b00b-9c198815d5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437686} {:answer/id #uuid "8084195c-c80f-5724-a464-b4190c772af2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437687}] :answer-field/correct {:answer/id #uuid "87e56ee0-4b15-585a-b00b-9c198815d5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437686} :answer-field/id #uuid "f57b8a4e-6326-51ba-9d83-e214db0e9062" :answer-field/key "$D(x,y)$ $=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y),7{x}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438872} {:answer-field/choices [{:answer/id #uuid "9acb7596-f53f-56d2-b363-d2432bfdfc06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437688} {:answer/id #uuid "7cff525b-7dbd-51e3-9c41-4f3a63d8b105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437689}] :answer-field/correct {:answer/id #uuid "7cff525b-7dbd-51e3-9c41-4f3a63d8b105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437689} :answer-field/id #uuid "ee64c134-4670-5bcf-b390-f48716fc96b5" :answer-field/key "$E(x,y,z)$ $=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89ed8a40-4bb8-5a40-9a2c-1bf03637a8bf" :question/math-academy-id "q-122696" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $C(x,y,z)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{3}$ to functions in $R$ (not ${R}^{3}$).\n\n- The function $D(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $E(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne y,\\,z\\ne \\frac{\\pi }{2}+n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $E(x,y,z)$ $=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$ only."} {:db/id #edb/ref 17592186265774 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4073f224-201c-519f-b03c-313a3eb4c350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463784} {:answer/id #uuid "303ad6b7-95a1-5c5c-96bc-cca40c293315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463785}] :answer-field/correct {:answer/id #uuid "4073f224-201c-519f-b03c-313a3eb4c350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463784} :answer-field/id #uuid "dbdfa837-5daf-512b-8a86-865a0822ce51" :answer-field/key "${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [-2,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464826} {:answer-field/choices [{:answer/id #uuid "3cf245ae-16c6-57af-ba00-f38bdd3dbb87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463786} {:answer/id #uuid "f97e585c-e112-5269-a3d4-131611824b6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463787}] :answer-field/correct {:answer/id #uuid "3cf245ae-16c6-57af-ba00-f38bdd3dbb87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463786} :answer-field/id #uuid "61b79227-2c02-506d-9a61-6b6775735c0a" :answer-field/key "${∬}_{R}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,3]\\times [-3,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464827} {:answer-field/choices [{:answer/id #uuid "d28bec82-3c96-5dd1-9805-9b70fa07a348" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463788} {:answer/id #uuid "41d65cdb-6e7d-54f4-8d2f-c670d29cab15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463789}] :answer-field/correct {:answer/id #uuid "41d65cdb-6e7d-54f4-8d2f-c670d29cab15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463789} :answer-field/id #uuid "39509c83-6240-5761-ad2e-aec42c7316d1" :answer-field/key "${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-3,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464828}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9794411d-a692-56fa-886b-52950afee48e" :question/math-academy-id "q-129783" :question/problem "![](images/77/779f39d9b8eca56cf8b7b2b9355364cd95171ca61c3e07cabd69e7a048933e22.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)={\\begin{aligned}x\\sqrt{{x}^{2}+{y}^{2}}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}x\\sqrt{{x}^{2}+{y}^{2}}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [-2,3]$” is false. The rectangle $R$ does not cover the region $D.$\n\n- Statement “${∬}_{R}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,3]\\times [-3,3]$” is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement “${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-3,3]$” is true. The rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is “${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-3,3]$” only."} {:db/id #edb/ref 17592186265775 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4805925e-3a4f-51e1-94c1-af3b24a855ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463790} {:answer/id #uuid "a6bf3669-9ed3-5a3e-84da-d7ad268451f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463791}] :answer-field/correct {:answer/id #uuid "4805925e-3a4f-51e1-94c1-af3b24a855ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463790} :answer-field/id #uuid "a3130562-d0ae-5f2e-a8c7-fd55e38a5f1d" :answer-field/key "${∬}_{D}(x+{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,3]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464829} {:answer-field/choices [{:answer/id #uuid "1484dbfe-1145-5f7b-b9cc-2652edf3c20b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463792} {:answer/id #uuid "99e2b429-1018-5ca0-bda6-2d9bce949606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463793}] :answer-field/correct {:answer/id #uuid "1484dbfe-1145-5f7b-b9cc-2652edf3c20b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463792} :answer-field/id #uuid "4045a5e8-8b12-5161-85fe-027139c70ef6" :answer-field/key "${∬}_{R}(x+{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,4]\\times [-3,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464830} {:answer-field/choices [{:answer/id #uuid "46f5091d-279d-5025-a7ab-367a057641c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} 