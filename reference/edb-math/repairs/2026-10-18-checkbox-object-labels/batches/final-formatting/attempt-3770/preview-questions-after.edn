f 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473211}] :answer-field/correct {:answer/id #uuid "786ef073-3f0d-5149-abdc-4edcd620b314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473211} :answer-field/id #uuid "bac84c97-4cc2-58e5-a587-b2e755fb00d8" :answer-field/key "$x{y}^{″}+2{y}^{′}-y$ $=0,$ $\\,y(0)$ $=-4,$ $\\,{y}^{′}(1)$ $=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b765011e-9d19-55a7-93ef-fd380a1d1bd5" :question/math-academy-id "q-65012" :question/problem "Which of the following systems is a boundary value problem?\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at *different* locations in the domain of $y,$ then this is a **boundary value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not a boundary value problem. The differential equation is combined with two conditions, but both conditions are given at the same location in the domain of $y(x)$ (i.e., at $x=0$). This is an **initial value problem.**\n\n- The second system is not a boundary value problem. It contains an equation only. No conditions are specified.\n\n- The third system is a boundary value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=1$)."} {:db/id #edb/ref 17592186406882 :knowledge-point/_questions [{:db/id #edb/ref 17592186124489 :knowledge-point/id #uuid "073042ee-d96d-5872-9681-ddcea43a2d37" :knowledge-point/title "Identifying True Statements About Sets of Vectors in a Matrix Vector Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69e86229-681b-5403-b631-b065124b1be8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453234} {:answer/id #uuid "e78110f0-ca50-51aa-914f-e386bec6425a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453235}] :answer-field/correct {:answer/id #uuid "e78110f0-ca50-51aa-914f-e386bec6425a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453235} :answer-field/id #uuid "4cbdc373-c990-5dd3-8186-7aa74bd3bb9d" :answer-field/key "$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$ is a linearly independent set in ${\\text{M}}_{2}(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454367} {:answer-field/choices [{:answer/id #uuid "cfdf83a2-6a63-5759-a053-db246c627b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453236} {:answer/id #uuid "aa9113d9-1b88-5970-a100-85c7aea2dbff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453237}] :answer-field/correct {:answer/id #uuid "aa9113d9-1b88-5970-a100-85c7aea2dbff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453237} :answer-field/id #uuid "195daa73-27ff-5877-a458-d22d5ed1852b" :answer-field/key "$\\begin{bmatrix}3 & 4 \\\\ 2 & -5\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454368} {:answer-field/choices [{:answer/id #uuid "2fd8a2c9-e002-5140-8dcb-a07eb82acf68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453238} {:answer/id #uuid "c6c0ea91-328a-544b-b2c0-d0c461ef46cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453239}] :answer-field/correct {:answer/id #uuid "c6c0ea91-328a-544b-b2c0-d0c461ef46cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453239} :answer-field/id #uuid "9796340d-a680-530e-86de-58d047300c0a" :answer-field/key "$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$ is a basis of ${\\text{M}}_{2}(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b0d7b89-c3c8-5cee-b6a2-01b5cd1b1f67" :question/math-academy-id "q-107533" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement “$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$ is a linearly independent set in ${\\text{M}}_{2}(R)$” is true. Indeed, the equation\n\n$$\n{x}_{1}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}+{x}_{2}\\cdot \\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix}+{x}_{3}\\cdot \\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix}+{x}_{4}\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nis true if and only if ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0.$ So, the set is linearly independent.\n\n- Statement “$\\begin{bmatrix}3 & 4 \\\\ 2 & -5\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$” is true. Indeed,\n\n$$\n\\begin{bmatrix}3 & 4 \\\\ 2 & -5\\end{bmatrix}=3\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}+(-4)\\cdot \\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix}+(-2)\\cdot \\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix}+(-5)\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\n- Statement “$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$ is a basis of ${\\text{M}}_{2}(R)$” is true. Indeed, the set is linearly independent and for any matrix in ${\\text{M}}_{2}(R),$ we get \n\n$$\n\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}=a\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}+(-b)\\cdot \\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix}+(-c)\\cdot \\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix}+d\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, the correct answer is “$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$ is a linearly independent set in ${\\text{M}}_{2}(R)$”; “$\\begin{bmatrix}3 & 4 \\\\ 2 & -5\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$”; “$\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & -1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ -1 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}$ is a basis of ${\\text{M}}_{2}(R)$”." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"} :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406849} :db/id #edb/ref 17592186406888}]} {:db/id #edb/ref 17592186407297 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d785f01e-c01b-508b-a7e4-0b68e3819afd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473512} {:answer/id #uuid "72475eb4-0b35-5d4b-9ea7-4c75ae1d9bdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473513}] :answer-field/correct {:answer/id #uuid "72475eb4-0b35-5d4b-9ea7-4c75ae1d9bdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473513} :answer-field/id #uuid "7063df18-38c8-5001-85dc-c37c2a884180" :answer-field/key "${∬}_{D}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,2]\\times [0,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474151} {:answer-field/choices [{:answer/id #uuid "45915786-bde2-58ed-b09f-01d02dd4ab1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473514} {:answer/id #uuid "db2767a5-0290-566a-8860-446c19d11819" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473515}] :answer-field/correct {:answer/id #uuid "45915786-bde2-58ed-b09f-01d02dd4ab1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473514} :answer-field/id #uuid "9428d01a-a858-5759-ad6e-dec6825a2e03" :answer-field/key "${∬}_{R}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-5,5]\\times [0,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474152} {:answer-field/choices [{:answer/id #uuid "20decd90-c71f-5b9c-af2d-3a173c83d963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473516} {:answer/id #uuid "025119c3-228a-5031-89d8-d102fe48b0f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473517}] :answer-field/correct {:answer/id #uuid "20decd90-c71f-5b9c-af2d-3a173c83d963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473516} :answer-field/id #uuid "31799862-7294-50e6-9e5a-cbd879317060" :answer-field/key "${∬}_{D}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[0,2]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed965e5b-f0df-5c0f-9c7c-0cb7a433c067" :question/math-academy-id "q-86866" :question/problem "![](images/51/51706be38cc1c72079fe702c899b575ea53ba4d85e7990a6aa81f20dc8da4de3.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}y{x}^{2}+3x{y}^{2}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}y{x}^{2}+3x{y}^{2}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “${∬}_{D}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,2]\\times [0,3]$” is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement “${∬}_{R}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-5,5]\\times [0,3]$” is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement “${∬}_{D}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[0,2]\\times [-2,2]$” is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is “${∬}_{D}(y{x}^{2}+3x{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,2]\\times [0,3]$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407276} :db/id #edb/ref 17592186407301}]} {:db/id #edb/ref 17592186409710 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed" :topic/_knowledge-points [{:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0638bc04-e9e1-5330-9a7a-284da1ea1862" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472490} {:answer/id #uuid "dedfc764-7039-5fce-9f4f-b712c657dce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472491}] :answer-field/correct {:answer/id #uuid "dedfc764-7039-5fce-9f4f-b712c657dce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472491} :answer-field/id #uuid "ec83fef0-1275-5012-b097-d5d2217af4da" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,2\\le x\\le 4,\\\\\\,0<{y}^{2}\\le 5\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473640} {:answer-field/choices [{:answer/id #uuid "afe1e9fe-eb97-51b8-8ce7-fcc5af4f2758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472492} {:answer/id #uuid "ee4dca9e-0f53-5ed4-ba91-c48d26d2c775" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472493}] :answer-field/correct {:answer/id #uuid "afe1e9fe-eb97-51b8-8ce7-fcc5af4f2758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472492} :answer-field/id #uuid "c35a2a7f-db4f-528f-8a21-817540e2e1e3" :answer-field/key "${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<7}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473641} {:answer-field/choices [{:answer/id #uuid "9276fd3e-3c91-5a26-b6b6-d901d7767211" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472494} {:answer/id #uuid "e5ed62c3-48d9-5265-ad31-aeca74a5c701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472495}] :answer-field/correct {:answer/id #uuid "e5ed62c3-48d9-5265-ad31-aeca74a5c701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472495} :answer-field/id #uuid "6753bfa6-194f-5dbf-bbba-fcb3dac7d172" :answer-field/key "${(x,y)\\in {R}^{2}\\,:\\,1\\le x<4,\\,{y}^{2}<9}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473642}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c5afa8a-a09e-5d94-9d6f-17bde8db6cd3" :question/math-academy-id "q-105422" :question/problem "Which of the following sets are neither open nor closed?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,\\sqrt{5}).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,0).$\n\n- The second set is *open* since it doesn't contain any of its boundary points (the corresponding inequality is strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(4,0).$\n\nTherefore, the correct answer is $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,2\\le x\\le 4,\\\\\\,0<{y}^{2}\\le 5\\end{gathered}\\right\\}\\end{gathered}$; ${(x,y)\\in {R}^{2}\\,:\\,1\\le x<4,\\,{y}^{2}<9}$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"} :activity/title "Open and Closed Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409697} :db/id #edb/ref 17592186409715}]} {:db/id #edb/ref 17592186409711 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation" :topic/_knowledge-points [{:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a21b5b4-8c29-55bf-9071-2d2b633aa59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472760} {:answer/id #uuid "e0e36382-39e0-5e92-9083-d5fb9b041b92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472761}] :answer-field/correct {:answer/id #uuid "9a21b5b4-8c29-55bf-9071-2d2b633aa59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472760} :answer-field/id #uuid "d5ccf86d-3b0c-575d-be62-dcd07f2c84b2" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }-2\\le x\\le 0,\\\\\\,1\\le y\\le 2-x\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473775} {:answer-field/choices [{:answer/id #uuid "e14bf656-6f18-54c0-9140-a4e367e88751" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472762} {:answer/id #uuid "ba64d4e9-e44f-50cd-ae83-6f4393f74694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472763}] :answer-field/correct {:answer/id #uuid "ba64d4e9-e44f-50cd-ae83-6f4393f74694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472763} :answer-field/id #uuid "0b2d70a2-ca62-51f1-bf2b-2dd24fb3a9fd" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }-1<x<1,\\\\\\,0<y<1+x\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473776} {:answer-field/choices [{:answer/id #uuid "a3ffa913-0456-5435-8425-10083a166104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472764} {:answer/id #uuid "e26a2e2e-02cd-579c-bae8-f4e53d04fb09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472765}] :answer-field/correct {:answer/id #uuid "a3ffa913-0456-5435-8425-10083a166104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472764} :answer-field/id #uuid "5f7902ed-77a2-5fae-a322-2ec4a2fe2e71" :answer-field/key "${(x,y)\\in {R}^{2}:\\text{ }4\\le {x}^{2}+{y}^{2}\\le 9}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473777}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b04f2bd5-de84-5515-a0a5-3d6c81e3d583" :question/math-academy-id "q-161644" :question/problem "Which of the following sets are open?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The third set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }-1<x<1,\\\\\\,0<y<1+x\\end{gathered}\\right\\}\\end{gathered}$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"} :activity/title "Open and Closed Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409697} :db/id #edb/ref 17592186409713}]} {:db/id #edb/ref 17592186410575 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "402ff24c-ce68-5100-bc6f-ce08b50c1b48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437378} {:answer/id #uuid "b55bf19b-e306-5cf0-a5ee-460b10f4d0dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437379}] :answer-field/correct {:answer/id #uuid "b55bf19b-e306-5cf0-a5ee-460b10f4d0dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437379} :answer-field/id #uuid "8e0832f4-ea5d-510d-80b2-f2b601f5cea1" :answer-field/key "$F=\\frac{2x}{{e}^{y}}\\,i-\\frac{{x}^{2}}{{e}^{y}}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438718} {:answer-field/choices [{:answer/id #uuid "65c63bc1-ce38-5b41-98d2-3546373c1d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437380} {:answer/id #uuid "aadf4a2f-a9fb-5a4e-a7c3-c50425746fba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437381}] :answer-field/correct {:answer/id #uuid "65c63bc1-ce38-5b41-98d2-3546373c1d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437380} :answer-field/id #uuid "245451c8-c2d8-5660-b868-914d6a09643c" :answer-field/key "$G=\\operatorname{arctan}⁡y\\,i-\\frac{x}{{y}^{2}+1}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438719} {:answer-field/choices [{:answer/id #uuid "ee3af17a-9e86-50af-944e-c33c42e3d28e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437382} {:answer/id #uuid "c5abe579-6912-52ab-ae7a-530eb7394275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437383}] :answer-field/correct {:answer/id #uuid "c5abe579-6912-52ab-ae7a-530eb7394275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437383} :answer-field/id #uuid "cd21fc02-2d66-5119-b27a-c74692938a6c" :answer-field/key "$H$ $=(8x-3y)\\,i$ $+(4y-3x+1)\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438720}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b4c4358-44ac-586a-b065-3dc8b8db940a" :question/math-academy-id "q-104574" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=\\frac{2x}{{e}^{y}}$ and $Q=-\\frac{{x}^{2}}{{e}^{y}}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-\\frac{2x}{{e}^{y}},\\,\\frac{∂Q}{∂x}=-\\frac{2x}{{e}^{y}}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=\\operatorname{arctan}⁡y$ and $Q=-\\frac{x}{{y}^{2}+1}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{1}{{y}^{2}+1},\\,\\frac{∂Q}{∂x}=-\\frac{1}{{y}^{2}+1}.\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=8x-3y$ and $Q=4y-3x+1.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-3,\\,\\frac{∂Q}{∂x}=-3.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is $F=\\frac{2x}{{e}^{y}}\\,i-\\frac{{x}^{2}}{{e}^{y}}\\,j$; $H$ $=(8x-3y)\\,i$ $+(4y-3x+1)\\,j$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"} :activity/title "Conservative Vector Fields in the Cartesian Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410562} :db/id #edb/ref 17592186410577}]} {:db/id #edb/ref 17592186410576 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields" :topic/_knowledge-points [{:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519cca11-1af0-5c38-ac09-9cdf3e9eb8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439999} {:answer/id #uuid "6fbea3d5-d3a9-50cd-881a-7348e37c0dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440000}] :answer-field/correct {:answer/id #uuid "6fbea3d5-d3a9-50cd-881a-7348e37c0dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440000} :answer-field/id #uuid "b3485904-6c14-5182-a07e-0e8536e160b9" :answer-field/key "$F$ $=({e}^{x+y}-\\sqrt{2})\\,i$ $+({e}^{x+y}-\\sqrt{7})\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440357} {:answer-field/choices [{:answer/id #uuid "cb20b90e-716b-5744-aa1c-1bc38cc09c94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440001} {:answer/id #uuid "9e61d8e1-2d98-58e5-918c-f2fb0a227922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440002}] :answer-field/correct {:answer/id #uuid "9e61d8e1-2d98-58e5-918c-f2fb0a227922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440002} :answer-field/id #uuid "908db421-59c3-5473-9555-1804770c666a" :answer-field/key "$G=({y}^{3}-6x)\\,i+(3x{y}^{2})\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440358} {:answer-field/choices [{:answer/id #uuid "99e2896f-89e3-56ed-85e3-9569e0e553b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440003} {:answer/id #uuid "0b03afd1-5458-5b8f-80bb-6721de8fe5c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440004}] :answer-field/correct {:answer/id #uuid "0b03afd1-5458-5b8f-80bb-6721de8fe5c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440004} :answer-field/id #uuid "12bd3f31-bc54-5cfa-8930-506cacf26495" :answer-field/key "$H=\\frac{2xy}{{x}^{2}+1}\\,i+\\operatorname{ln}⁡({x}^{2}+1)\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440359}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "953d7cc2-ab7b-52e3-b63e-6dc18089f06f" :question/math-academy-id "q-86896" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P={e}^{x+y}-\\sqrt{2}$ and $Q={e}^{x+y}-\\sqrt{7}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{x+y},\\,\\frac{∂Q}{∂x}={e}^{x+y}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P={y}^{3}-6x$ and $Q=3x{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=3{y}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\frac{2xy}{{x}^{2}+1}$ and $Q=\\operatorname{ln}⁡({x}^{2}+1).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=\\frac{2x}{{x}^{2}+1},\\,\\frac{∂Q}{∂x}=\\frac{2x}{{x}^{2}+1}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is $F$ $=({e}^{x+y}-\\sqrt{2})\\,i$ $+({e}^{x+y}-\\sqrt{7})\\,j$; $G=({y}^{3}-6x)\\,i+(3x{y}^{2})\\,j$; $H=\\frac{2xy}{{x}^{2}+1}\\,i+\\operatorname{ln}⁡({x}^{2}+1)\\,j$." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149 :topic/title "Conservative Vector Fields in the Cartesian Plane"} :activity/title "Conservative Vector Fields in the Cartesian Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410562} :db/id #edb/ref 17592186410579}]} {:db/id #edb/ref 17592186412806 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050221 :topic/id #uuid "3748163a-70f7-518f-9382-77b8230a6624" :topic/math-academy-id 3237 :topic/title "General Solutions of First-Order Linear Systems of ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89ff11c-d1b7-5405-82c1-94c7d7c99ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473046} {:answer/id #uuid "c81e64dc-937e-5cab-8f29-f5b6154dc03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473047}] :answer-field/correct {:answer/id #uuid "c81e64dc-937e-5cab-8f29-f5b6154dc03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473047} :answer-field/id #uuid "c191f663-afad-5fac-a9f2-fac3b31f3803" :answer-field/key "$x(t)={x}_{1}(t)+{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473918} {:answer-field/choices [{:answer/id #uuid "e9185fe4-0729-55cd-91d0-1540bf55d2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473048} {:answer/id #uuid "44919b96-98f2-5972-8f19-8568c044e939" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473049}] :answer-field/correct {:answer/id #uuid "e9185fe4-0729-55cd-91d0-1540bf55d2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473048} :answer-field/id #uuid "4eb579d0-ff0e-56d8-afd8-faecf8a98e18" :answer-field/key "$x(t)$ $=\\operatorname{sin}⁡(t)\\cdot {x}_{1}(t)$ $-\\operatorname{cos}⁡(t)\\cdot {x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473919} {:answer-field/choices [{:answer/id #uuid "498d2ce6-8636-51d1-aabe-214949bb04ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473050} {:answer/id #uuid "4038ba31-96d0-5ea2-80fe-ff8ad8b3e1b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473051}] :answer-field/correct {:answer/id #uuid "4038ba31-96d0-5ea2-80fe-ff8ad8b3e1b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473051} :answer-field/id #uuid "a207e67d-e805-59c2-970d-7203de37688e" :answer-field/key "$x(t)={x}_{1}(t)-{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5a0af42-71ea-5bb3-8eb8-b8b29ef8a2c6" :question/math-academy-id "q-330354" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option $x(t)={x}_{1}(t)+{x}_{2}(t)$ is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)+{x}_{2}(t)\n$$\n\nis a linear combination of the solutions with constant multiplies ${c}_{1}=1$ and ${c}_{2}=1,$ respectively.\n\n- Option $x(t)$ $=\\operatorname{sin}⁡(t)\\cdot {x}_{1}(t)$ $-\\operatorname{cos}⁡(t)\\cdot {x}_{2}(t)$ might be *not* a solution to the system since it's not a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multipliers of the first and the second terms are not constant.\n\n- Option $x(t)={x}_{1}(t)-{x}_{2}(t)$ is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)-{x}_{2}(t)\n$$\n\nis a linear combination of the solutions with constant multiplies ${c}_{1}=1$ and ${c}_{2}=-1,$ respectively.\n\nTherefore, the correct answer is $x(t)={x}_{1}(t)+{x}_{2}(t)$; $x(t)={x}_{1}(t)-{x}_{2}(t)$ only."} {:db/id #edb/ref 17592186420330 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeb0bd26-a87f-5160-86c6-c88af654a1c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472790} {:answer/id #uuid "058a62c1-4870-5eee-97d2-27a48de6c20e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472791}] :answer-field/correct {:answer/id #uuid "058a62c1-4870-5eee-97d2-27a48de6c20e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472791} :answer-field/id #uuid "76792b10-9c83-5ec3-991b-6d887a31bad1" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{1-2x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473790} {:answer-field/choices [{:answer/id #uuid "0b31da9e-5fdc-54f8-b67b-d7fd5360d29b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472792} {:answer/id #uuid "5883f247-a0a6-5d1a-8e80-822a5710f87e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472793}] :answer-field/correct {:answer/id #uuid "0b31da9e-5fdc-54f8-b67b-d7fd5360d29b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472792} :answer-field/id #uuid "79e111f3-86c2-566b-93bc-79837883bf7b" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(3{e}^{x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473791} {:answer-field/choices [{:answer/id #uuid "97702641-8974-5fba-ba14-8a27155d2a45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472794} {:answer/id #uuid "7e961b21-e701-5dc8-b49d-89b3c52beb1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472795}] :answer-field/correct {:answer/id #uuid "97702641-8974-5fba-ba14-8a27155d2a45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472794} :answer-field/id #uuid "63997d18-6e6c-51b4-907b-4e51f65b898a" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(4{e}^{-x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473792}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6b24cf2-2976-579e-8d0e-dd268f3c65a7" :question/math-academy-id "q-181641" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & ={e}^{1-2x} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{1-2x})=-2{e}^{1-2x} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{1-2x})=4{e}^{1-2x} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{1-2x})=-8{e}^{1-2x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={{e}^{1-2x},-2{e}^{1-2x},4{e}^{1-2x},-8{e}^{1-2x},…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =3{e}^{x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x})=3{e}^{x} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x})=3{e}^{x} \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x})=3{e}^{x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $B$ contains only one element:\n\n$$\nB={3{e}^{x}}\n$$\n\nConsequently, $|B|=1,$ which is finite.\n\n- The set $C$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =4{e}^{-x} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-x})=-4{e}^{-x} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-4{e}^{-x})=4{e}^{-x} \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-x})=-4{e}^{-x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $C$ contains only two elements:\n\n$$\nC={4{e}^{-x},-4{e}^{-x}}.\n$$\n\nConsequently, $|C|=2,$ which is finite.\n\nTherefore, the correct answer is \"$A$ only.\""} {:db/id #edb/ref 17592186420332 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee82b5b5-8eb7-5ff0-be35-a31c59aea9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472808} {:answer/id #uuid "60c4e5f8-cc86-5c70-b850-fea2f6e02c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472809}] :answer-field/correct {:answer/id #uuid "60c4e5f8-cc86-5c70-b850-fea2f6e02c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472809} :answer-field/id #uuid "eab800ab-2c2e-5dc8-b86f-635d0d61cc60" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\sqrt[5]{{x}^{2}})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473799} {:answer-field/choices [{:answer/id #uuid "88bd4daf-0b70-5425-88e1-3fbe6d0526ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472810} {:answer/id #uuid "c75f52b1-417d-59fb-a71b-22a7249d35f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472811}] :answer-field/correct {:answer/id #uuid "c75f52b1-417d-59fb-a71b-22a7249d35f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472811} :answer-field/id #uuid "2cf48651-9562-59ba-b1ef-9b8d571b7647" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(-\\sqrt{x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473800} {:answer-field/choices [{:answer/id #uuid "8f84b03a-b49d-5b9d-93fd-ac4bf51bc165" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472812} {:answer/id #uuid "9090acca-2e47-5919-9d10-e65cb241a5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472813}] :answer-field/correct {:answer/id #uuid "9090acca-2e47-5919-9d10-e65cb241a5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472813} :answer-field/id #uuid "1cb851b0-1008-559e-bba5-6ac2099260c3" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\frac{1}{{x}^{2}})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473801}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8b98aed-4075-5dac-9091-d486170b806a" :question/math-academy-id "q-181706" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\sqrt[5]{{x}^{2}} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[5]{{x}^{2}})=\\frac{2}{5\\sqrt[5]{{x}^{3}}} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{5\\sqrt[3]{{x}^{2}}})=-\\frac{6}{25\\sqrt[5]{{x}^{8}}} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\sqrt[5]{{x}^{2}},\\frac{2}{5\\sqrt[5]{{x}^{3}}},-\\frac{6}{25\\sqrt[5]{{x}^{8}}},…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is also infinite. Similar to the previous case, listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =-\\sqrt{x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\sqrt{x})=-\\frac{1}{2\\sqrt{x}} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{2\\sqrt{x}})=\\frac{1}{4\\sqrt{{x}^{3}}} \\\\  & ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={-\\sqrt{x},-\\frac{1}{2\\sqrt{x}},\\frac{1}{4\\sqrt{{x}^{3}}},…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is also infinite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =\\frac{1}{{x}^{2}} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{{x}^{2}})=-\\frac{2}{{x}^{3}} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{2}{{x}^{3}})=\\frac{6}{{x}^{4}} \\\\  & ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={\\frac{1}{{x}^{2}},-\\frac{2}{{x}^{3}},\\frac{6}{{x}^{4}},…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""} {:db/id #edb/ref 17592186420586 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da46976-50a0-5bba-a035-84d579bf8c14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474550} {:answer/id #uuid "5cfeed0b-7602-5236-8c0f-9326a62b26c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474551}] :answer-field/correct {:answer/id #uuid "5cfeed0b-7602-5236-8c0f-9326a62b26c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474551} :answer-field/id #uuid "250e3d08-bb55-52da-bcdc-28fa241e7bb6" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}n\\in Z\\,:\\\\\\,-{n}^{2}+n+12\\le 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475201} {:answer-field/choices [{:answer/id #uuid "4b8cefbf-5387-5a3e-b149-b7a67085652a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474552} {:answer/id #uuid "72660f00-03ec-5af3-8cad-aee090d7cc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474553}] :answer-field/correct {:answer/id #uuid "4b8cefbf-5387-5a3e-b149-b7a67085652a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474552} :answer-field/id #uuid "6c37b18b-100a-5c03-9a73-ee73cbe27f86" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}m\\in Z\\,:\\\\\\,-{m}^{2}+m+12\\ge 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475202} {:answer-field/choices [{:answer/id #uuid "bf8823b7-fb7b-59e1-a6a7-cbae3eb388cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474554} {:answer/id #uuid "0f7216e9-2722-5e5b-a49d-30702f99303c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474555}] :answer-field/correct {:answer/id #uuid "0f7216e9-2722-5e5b-a49d-30702f99303c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474555} :answer-field/id #uuid "76951e29-2db8-583e-baea-5af2220a2cb6" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}q\\in Q\\,:\\\\\\,-{q}^{2}+q+12\\ge 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a7b8c64-0e50-5904-90c5-c8b0f74761de" :question/math-academy-id "q-181771" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y=-{x}^{2}+x+12$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+x+12 & =0 \\\\ -({x}^{2}-x-12) & =0 \\\\ -(x-4)(x+3) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=-3$ and $x=4,$ and we can graph the parabola as follows:\n\n![](images/57/57d58b579557ba0ea8c6179bd37209c8199eee83e17d79c74828a051aa1382d6.png)\n\nTherefore:\n\n- The solution to the inequality $-{x}^{2}+x+12\\le 0$ for $x\\in R$ is \n\n$$\nx\\le -3\\,\\text{or}\\,x\\ge 4\n$$\n\nand can be expressed as $x\\in {I}_{1}=(-\\infty ,-3]\\cup [4,\\infty ).$\n\n- Similarly, the solution to the inequality $-{x}^{2}+x+12\\ge 0$ for $x\\in R$ is \n\n$$\n-3\\le x\\le 4\n$$\n\nand can be expressed as $x\\in {I}_{2}=[-3,4].$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is infinite. If $n\\in Z,$ the solutions to the inequality $-{n}^{2}+n+12\\le 0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={…,-4,-3}\\cup {4,5,…}.\n$$\n\n- The set $B$ is finite. If $m\\in Z,$ the solutions to the inequality $-{m}^{2}+m+12\\ge 0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={-3,-2,-1,0,1,2,3,4}.\n$$\n\nConsequently, $|B|=8,$ which is finite.\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to $-{q}^{2}+q+12\\ge 0$ are all the rational numbers that lie in the interval ${I}_{2}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A$ and $C$ only.\""} {:db/id #edb/ref 17592186425931 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6eef2f-1705-5a9c-bd6f-ce326ab994cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453350} {:answer/id #uuid "1a1148f9-565b-5ed6-a20a-300c09389e6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453351}] :answer-field/correct {:answer/id #uuid "1e6eef2f-1705-5a9c-bd6f-ce326ab994cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453350} :answer-field/id #uuid "2e444938-dc10-56c1-872a-deebe68ed5da" :answer-field/key "${∬}_{D}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [-1,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454425} {:answer-field/choices [{:answer/id #uuid "988b7db4-ebf6-5468-8780-b1beeb8ee195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453352} {:answer/id #uuid "02fb2d7a-770f-5219-9a76-41ff9f0fb874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453353}] :answer-field/correct {:answer/id #uuid "02fb2d7a-770f-5219-9a76-41ff9f0fb874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453353} :answer-field/id #uuid "39570068-589a-5da0-8fe4-5a34775ee0bb" :answer-field/key "${∬}_{D}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [0,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454426} {:answer-field/choices [{:answer/id #uuid "f7e357a2-e551-5cf6-8fcf-5ea5e81ecbbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453354} {:answer/id #uuid "4f50774f-f918-5ee5-90e6-3807acef4736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453355}] :answer-field/correct {:answer/id #uuid "f7e357a2-e551-5cf6-8fcf-5ea5e81ecbbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453354} :answer-field/id #uuid "0f26f489-8e77-5de8-9048-273b50f7f444" :answer-field/key "${∬}_{R}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,3]\\times [-4,4]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c04d4c5-9913-59ea-a83f-46d8bb7c02cf" :question/math-academy-id "q-129893" :question/problem "Let $D$ be a finite region enclosed between the curve $y=-{x}^{2}+2$ and the $x$-axis. If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}+3y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D:$\n\n![](images/3b/3bfc135232008824ae0522bcc8454c5f97c2dfd13fb6e333e146a040ccbc1f22.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}({x}^{2}+3y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statements “${∬}_{D}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [-1,3]$” is false. The rectangle $R$ does not cover the region $D.$\n\n- Statements “${∬}_{D}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [0,2]$” is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement “${∬}_{R}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-3,3]\\times [-4,4]$” is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\nTherefore, the correct answer is “${∬}_{D}({x}^{2}+3y)\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [0,2]$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425910} :db/id #edb/ref 17592186425936}]} {:db/id #edb/ref 17592186426030 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only" :topic/_knowledge-points [{:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048 :topic/title "Independence of Discrete Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eef6c94a-e496-5891-a2ca-b9ac53696b93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474392} {:answer/id #uuid "741b2c42-773e-5ec4-9974-e7e956acbdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474393}] :answer-field/correct {:answer/id #uuid "741b2c42-773e-5ec4-9974-e7e956acbdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474393} :answer-field/id #uuid "5e8f1f9b-c7ae-59c4-9600-fc6d84220816" :answer-field/key "$P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475122} {:answer-field/choices [{:answer/id #uuid "d17410a8-6d51-5fbd-a6e2-afab502e03a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474394} {:answer/id #uuid "af4458a5-0951-5cde-ba22-486fe27e56df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474395}] :answer-field/correct {:answer/id #uuid "d17410a8-6d51-5fbd-a6e2-afab502e03a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474394} :answer-field/id #uuid "6d41f5c7-38fe-52a2-ac70-78a54dd7e7be" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475123} {:answer-field/choices [{:answer/id #uuid "45d41db6-c839-5651-be71-5da1d3518353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474396} {:answer/id #uuid "7c8c5f95-5115-5b8c-87c7-c97126e15804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474397}] :answer-field/correct {:answer/id #uuid "45d41db6-c839-5651-be71-5da1d3518353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474396} :answer-field/id #uuid "569f02b4-e8e3-5e5d-a2af-5774202b1895" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475124}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ce1827c-c98c-5481-b210-2bd31e84c14f" :question/math-academy-id "q-143337" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ |\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ | $0.35$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ | $0.65$ |\n| ${f}_{Y}$ | $0.4$ | $0.5$ | $0.1$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ is true. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.26.$ On the other hand, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.65\\cdot 0.4=0.26.\\,✓\n$$\n\n- Statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,1) & =0.14=0.35\\cdot 0.4={f}_{X}(0)\\cdot {f}_{Y}(1) & ✓ \\\\ f(0,2) & =0.16\\ne 0.35\\cdot 0.5={f}_{X}(0)\\cdot {f}_{Y}(2) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is false. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ only."} {:db/id #edb/ref 17592186426535 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048337 :topic/id #uuid "96874e3b-8b97-5c33-995d-d34a9d3daf21" :topic/math-academy-id 4077 :topic/title "Subspaces of N-Dimensional Space: Geometric Interpretation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f3871a9-6e60-5fd0-923a-baae81d1dcc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474266} {:answer/id #uuid "08e41dcc-4096-52b0-b648-56bc1c24d9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474267}] :answer-field/correct {:answer/id #uuid "08e41dcc-4096-52b0-b648-56bc1c24d9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474267} :answer-field/id #uuid "8deb3772-23f8-57f0-9654-27f663eb5b79" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\x-y+z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475059} {:answer-field/choices [{:answer/id #uuid "a735ecf6-9831-50b7-9118-50ebb21e7bf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474268} {:answer/id #uuid "7d9a6da5-190a-5a0b-9e24-d7c79706a2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474269}] :answer-field/correct {:answer/id #uuid "7d9a6da5-190a-5a0b-9e24-d7c79706a2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474269} :answer-field/id #uuid "c0e48cf1-2e8f-594c-98aa-3c8a0ee95a28" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\{x}^{2}+{y}^{2}+{z}^{2}=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475060} {:answer-field/choices [{:answer/id #uuid "be9edb74-2397-5ca7-b83f-9320c8ba3023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474270} {:answer/id #uuid "72e5d407-78c6-57eb-916b-f720eba7787b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474271}] :answer-field/correct {:answer/id #uuid "be9edb74-2397-5ca7-b83f-9320c8ba3023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474270} :answer-field/id #uuid "1c506523-20a6-5d70-a10c-c4a2e49bed4c" :answer-field/key "$C=\\{⟨0,0,1⟩\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475061}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c109cc3b-b729-5d92-be15-5107dfc714ce" :question/math-academy-id "q-110759" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $x-y+z=0$ since $0-0+0=0.$ So $0$ lies in $A.$\n\n- The set $B$ is a subspace. This subset has only one element, the zero vector $0=⟨0,0,0⟩,$ which is a special (trivial) subspace of ${R}^{3}.$\n\n- The set $C$ is not a subspace. This subset has only one element, the vector $⟨0,0,1⟩,$ so it does not contain the zero vector.\n\nIn conclusion, the correct answer is $\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\x-y+z=0\\end{gathered}\\right\\}\\end{gathered}$; $\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\{x}^{2}+{y}^{2}+{z}^{2}=0\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186427272 :knowledge-point/_questions [{:db/id #edb/ref 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048966 :topic/id #uuid "cfd9de67-b6d3-5aac-81ab-498c732e22a6" :topic/math-academy-id 6720 :topic/title "Resonance in Vibrating Systems"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14290d8c-e867-59b8-af1c-fccb11ec1cd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474786} {:answer/id #uuid "ef81b3fc-df53-5633-a594-3d4f04f95619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474787}] :answer-field/correct {:answer/id #uuid "14290d8c-e867-59b8-af1c-fccb11ec1cd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474786} :answer-field/id #uuid "838696b9-c509-58f9-8a57-3688030a7f6e" :answer-field/key "$y$ $=R\\operatorname{cos}⁡(3t+ϕ)$ $-\\operatorname{cos}⁡(3t)$ $-\\frac{1}{2}\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475319} {:answer-field/choices [{:answer/id #uuid "9dc17cc0-79a7-5ee7-b21f-ee6d25df87b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474788} {:answer/id #uuid "92aa028c-6b7c-580c-9ad9-b43fe721b886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474789}] :answer-field/correct {:answer/id #uuid "9dc17cc0-79a7-5ee7-b21f-ee6d25df87b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474788} :answer-field/id #uuid "2d3a8464-3e27-51fe-98f3-9d46f96ac2c0" :answer-field/key "$y$ $=R\\operatorname{sin}⁡(3t+ϕ)$ $-t\\operatorname{sin}⁡(3t)$ $-\\frac{1}{2}t\\operatorname{cos}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475320} {:answer-field/choices [{:answer/id #uuid "fa752ff5-8a8a-57e6-b3fb-ad9d131bd5e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474790} {:answer/id #uuid "ee39a1b7-26b9-54e9-966d-579fbbb6a80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474791}] :answer-field/correct {:answer/id #uuid "ee39a1b7-26b9-54e9-966d-579fbbb6a80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474791} :answer-field/id #uuid "2b5e26ac-beb1-59bd-879a-7f19ce8bf81d" :answer-field/key "$y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $-t\\operatorname{cos}⁡(3t)$ $-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475321}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "528870e0-56ba-55b5-a9bc-4fec3b9615fa" :question/math-academy-id "q-343753" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t),$ which is sinusoidal with frequency $3.$ Therefore,\n$\\omega =3.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(3t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(3t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(3t)+B\\operatorname{sin}⁡(3t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)).\n$$\n\nBy substituting the particular solution and $\\omega =3$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(6D-9Ct)\\operatorname{cos}⁡(3t)-(6C+9Dt)\\operatorname{sin}⁡(3t)]+9t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)) & =-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t) \\\\ 6D\\operatorname{cos}⁡(3t)-6C\\operatorname{sin}⁡(3t) & =-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nEquating coefficients, $C=-1$ and $D=-\\frac{1}{2}.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(3t+ϕ)-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\n2\\. $y=R\\operatorname{sin}⁡(3t+ϕ)-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\n3\\. $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $-t\\operatorname{cos}⁡(3t)$ $-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\nOnly solution $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $-t\\operatorname{cos}⁡(3t)$ $-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$ matches the forms above.\nTherefore, the correct answer is $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $-t\\operatorname{cos}⁡(3t)$ $-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048966 :topic/id #uuid "cfd9de67-b6d3-5aac-81ab-498c732e22a6" :topic/math-academy-id 6720 :topic/title "Resonance in Vibrating Systems"} :activity/title "Resonance in Vibrating Systems" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186441789} :db/id #edb/ref 17592186441795}]} {:db/id #edb/ref 17592186431048 :knowledge-point/_questions [{:db/id #edb/ref 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property" :topic/_knowledge-points [{:db/id #edb/ref 17592186050567 :topic/id #uuid "54747772-1cac-572e-9b8f-be3a6c8abe45" :topic/math-academy-id 2198 :topic/title "Using Green's Theorem to Calculate Area"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7834049-c71e-58d4-8d98-c09398226feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437770} {:answer/id #uuid "b6e567b4-b8c2-531b-be4a-6a987225a67c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437771}] :answer-field/correct {:answer/id #uuid "a7834049-c71e-58d4-8d98-c09398226feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437770} :answer-field/id #uuid "1e6cf9cf-573c-532b-8b70-05635308acab" :answer-field/key "$F(x,y)=⟨y{e}^{x},\\,x-{e}^{x}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438914} {:answer-field/choices [{:answer/id #uuid "d458576b-4e27-54ad-b0dd-01c8de1730f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437772} {:answer/id #uuid "95452bb7-2fca-5e83-88ee-5eea11dc8b4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437773}] :answer-field/correct {:answer/id #uuid "d458576b-4e27-54ad-b0dd-01c8de1730f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437772} :answer-field/id #uuid "15e08b68-718b-5246-ad09-cfa2adcaab8c" :answer-field/key "$F(x,y)=⟨2y,\\,x⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438915} {:answer-field/choices [{:answer/id #uuid "937e30c9-442f-5622-a5d1-c5a8f129c9c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437774} {:answer/id #uuid "8e713a4f-cc2e-59f3-b27f-a7992c92588d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437775}] :answer-field/correct {:answer/id #uuid "8e713a4f-cc2e-59f3-b27f-a7992c92588d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437775} :answer-field/id #uuid "b3f9770d-2312-582c-8540-7d2ef01450c3" :answer-field/key "$F(x,y)$ $=⟨-\\frac{y}{3}+\\operatorname{cos}⁡{x}^{2},\\,\\frac{2x}{3}+1⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d67db6a-7337-599e-8ecc-26284642ae3b" :question/math-academy-id "q-126574" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}F\\cdot \\text{d}r\n$$\n\nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the vector field $F(x,y)?$\n\nSelect all that apply." :question/worked-solution "According to Green's theorem, if $F(x,y)=⟨P(x,y),\\,Q(x,y)⟩,$ where\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y \\\\  & ={∮}_{C}F\\cdot \\text{d}r\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Vector field $F(x,y)=⟨y{e}^{x},\\,x-{e}^{x}⟩$ does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}={e}^{x}$\nand\n$\\frac{∂Q}{∂x}=1-{e}^{x},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-2{e}^{x}\\ne 1.\n$$\n\n- Vector field $F(x,y)=⟨2y,\\,x⟩$ does *not* give the required area. Notice that \n$\\frac{∂P}{∂y}=2$\nand\n$\\frac{∂Q}{∂x}=1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-1\\ne 1.\n$$\n\n- Vector field $F(x,y)$ $=⟨-\\frac{y}{3}+\\operatorname{cos}⁡{x}^{2},\\,\\frac{2x}{3}+1⟩$ gives the required area. Notice that\n$\\frac{∂P}{∂y}=-\\frac{1}{3}$\nand\n$\\frac{∂Q}{∂x}=\\frac{2}{3},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is $F(x,y)$ $=⟨-\\frac{y}{3}+\\operatorname{cos}⁡{x}^{2},\\,\\frac{2x}{3}+1⟩$ only."} {:db/id #edb/ref 17592186434367 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f59cca8-143e-50c3-9107-5164e30e88b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474978} {:answer/id #uuid "d916f23d-bc74-569d-b289-7a75b444cca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474979}] :answer-field/correct {:answer/id #uuid "5f59cca8-143e-50c3-9107-5164e30e88b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474978} :answer-field/id #uuid "82507c52-06c9-5e1b-a7fc-0bb3f4dafd71" :answer-field/key "$y=R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ)+4\\operatorname{sin}⁡3t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475415} {:answer-field/choices [{:answer/id #uuid "a361cb0e-75c2-5310-a358-7c715da47d76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474980} {:answer/id #uuid "ca5aae8b-aaeb-5053-90a6-d6ea6f166f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474981}] :answer-field/correct {:answer/id #uuid "a361cb0e-75c2-5310-a358-7c715da47d76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474980} :answer-field/id #uuid "7ec1c685-8fbc-5afd-82fb-d7fa98da1213" :answer-field/key "$y$ $=A{e}^{-3t}$ $+B{e}^{3t}$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475416} {:answer-field/choices [{:answer/id #uuid "ee996a45-bd61-501c-b8c5-a9af76da2c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474982} {:answer/id #uuid "53f460bd-5f74-5f0a-b7bc-e24a342db1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474983}] :answer-field/correct {:answer/id #uuid "53f460bd-5f74-5f0a-b7bc-e24a342db1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474983} :answer-field/id #uuid "3eab5dfe-8d5c-5061-bf8b-bc549bd4e1ee" :answer-field/key "$y$ $={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44316634-3540-5552-a378-8f950333c8f6" :question/math-academy-id "q-94384" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+6{y}^{′}+18y=45\\operatorname{cos}⁡3t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+6{y}^{′}+18y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +18 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+18 & =0 \\\\ (\\lambda +3)^{2}+9 & =0 \\\\ (\\lambda +3)^{2} & =-9 \\\\ \\lambda +3 & =\\pm 3\\text{i} \\\\ \\lambda  & =-3\\pm 3\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & =R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-3t}\\operatorname{cos}⁡(3t+ϕ), \\\\ {y}_{c}(t) & ={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡3t+\\beta \\operatorname{sin}⁡3t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =1$ and $\\beta =2.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & =R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t, \\\\ y(t) & =R{e}^{-3t}\\operatorname{cos}⁡(3t+ϕ)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t, \\\\ y(t) & ={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t.\\end{aligned}\n$$\n\nOnly $y$ $={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$ matches the forms above. Therefore, the correct answer is $y$ $={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$ only."} {:db/id #edb/ref 17592186434368 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048622 :topic/id #uuid "af6ffcd9-235a-539a-acab-3fa95c86d5a2" :topic/math-academy-id 2526 :topic/title "Forced Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bc4b0f4-319d-5b82-a6b6-8a9a2ca8573b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474894} {:answer/id #uuid "1e021694-6cbc-586c-9af5-6032ecb5376f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474895}] :answer-field/correct {:answer/id #uuid "1e021694-6cbc-586c-9af5-6032ecb5376f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474895} :answer-field/id #uuid "8f0d3c1f-0626-50ad-96ff-dff84e27f685" :answer-field/key "$y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475373} {:answer-field/choices [{:answer/id #uuid "97f8b113-0642-5c5b-9738-b86720e2673a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474896} {:answer/id #uuid "0bc87909-bfd5-57b0-bd3c-48f0272a658c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474897}] :answer-field/correct {:answer/id #uuid "97f8b113-0642-5c5b-9738-b86720e2673a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474896} :answer-field/id #uuid "f027bf25-fb1d-54be-a97f-98a1627996e6" :answer-field/key "$y=R{e}^{-2t}\\operatorname{sin}⁡(t+ϕ)+5t-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475374} {:answer-field/choices [{:answer/id #uuid "c9dfad26-9a8d-5709-9bf9-3c9d0dc3ee22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474898} {:answer/id #uuid "9ffef0d1-665e-5de1-8b8a-cf200a7712a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474899}] :answer-field/correct {:answer/id #uuid "c9dfad26-9a8d-5709-9bf9-3c9d0dc3ee22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474898} :answer-field/id #uuid "33da045b-9147-535c-8cf0-691b41b4ea3a" :answer-field/key "$y$ $={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)$ $+t$ $-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f73fcd2-bb5e-5500-9c9a-4e8cac71bdbd" :question/math-academy-id "q-79579" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+2{y}^{′}+5y=25t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+2{y}^{′}+5y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +5 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+5 & =0 \\\\ (\\lambda +1)^{2}+4 & =0 \\\\ (\\lambda +1)^{2} & =-4 \\\\ \\lambda +1 & =\\pm 2\\text{i} \\\\ \\lambda  & =-1\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore the complimentary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a linear function, we assume that the particular solution is also a linear function,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =5$ and $\\beta =-2.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=5t-2.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+5t-2, \\\\ y(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2, \\\\ y(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ)+5t-2.\\end{aligned}\n$$\n\nOnly $y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$ matches the forms above. Therefore, the correct answer is $y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$ only."} {:db/id #edb/ref 17592186435718 :knowledge-point/_questions [{:db/id #edb/ref 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048966 :topic/id #uuid "cfd9de67-b6d3-5aac-81ab-498c732e22a6" :topic/math-academy-id 6720 :topic/title "Resonance in Vibrating Systems"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37a76100-91f1-5381-a393-3127cf1c97a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474798} {:answer/id #uuid "4ff87eb9-7d77-5686-ab05-1d7a2a55bbb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474799}] :answer-field/correct {:answer/id #uuid "4ff87eb9-7d77-5686-ab05-1d7a2a55bbb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474799} :answer-field/id #uuid "470e9eef-cc54-5d82-a9c7-c8a0236fedf9" :answer-field/key "$y$ $=R\\operatorname{cos}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475325} {:answer-field/choices [{:answer/id #uuid "d7c53a20-4ac2-5eba-80da-f36564b6a6a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474800} {:answer/id #uuid "c7fe273f-d3f0-5c55-8e77-2a32ce971fbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474801}] :answer-field/correct {:answer/id #uuid "c7fe273f-d3f0-5c55-8e77-2a32ce971fbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474801} :answer-field/id #uuid "62e86897-4191-5bb4-8443-307e1f191844" :answer-field/key "$y$ $=R\\operatorname{sin}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475326} {:answer-field/choices [{:answer/id #uuid "36f22f84-d4ac-55f4-8251-28dfeceba565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474802} {:answer/id #uuid "32880a89-586e-585a-b6f5-93ebecd15fb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474803}] :answer-field/correct {:answer/id #uuid "36f22f84-d4ac-55f4-8251-28dfeceba565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474802} :answer-field/id #uuid "b3db4908-d27d-54b1-a4ce-ea0117a6ce60" :answer-field/key "$y$ $=A\\operatorname{cos}⁡(5t)$ $+B\\operatorname{sin}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{cos}⁡(5t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d091e55-28a6-57e1-bec5-20aeba4179e3" :question/math-academy-id "q-343770" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t),$ which is sinusoidal with frequency $5.$ Therefore,\n$\\omega =5.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(5t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(5t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(5t)+B\\operatorname{sin}⁡(5t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(5t)+D\\operatorname{sin}⁡(5t)).\n$$\n\nBy substituting the particular solution and $\\omega =5$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(10D-25Ct)\\operatorname{cos}⁡(5t)-(10C+25Dt)\\operatorname{sin}⁡(5t)]+25t(C\\operatorname{cos}⁡(5t)+D\\operatorname{sin}⁡(5t)) & =2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t) \\\\ 10D\\operatorname{cos}⁡(5t)-10C\\operatorname{sin}⁡(5t) & =2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nEquating coefficients, $C=\\frac{4}{5}$ and $D=\\frac{1}{5}.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y$ $=R\\operatorname{cos}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\n2\\. $y$ $=R\\operatorname{sin}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\n3\\. $y=A\\operatorname{cos}⁡(5t)+B\\operatorname{sin}⁡(5t)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\nOnly solutions $y$ $=R\\operatorname{cos}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$ and $y$ $=R\\operatorname{sin}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$ match the forms above.\nTherefore, the correct answer is $y$ $=R\\operatorname{cos}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$; $y$ $=R\\operatorname{sin}⁡(5t+ϕ)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ $+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$ only."} {:db/id #edb/ref 17592186435720 :knowledge-point/_questions [{:db/id #edb/ref 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048966 :topic/id #uuid "cfd9de67-b6d3-5aac-81ab-498c732e22a6" :topic/math-academy-id 6720 :topic/title "Resonance in Vibrating Systems"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8098c12c-c69f-5410-91ea-5d34faacac72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474792} {:answer/id #uuid "cbf8c1e6-7440-5b66-ac6a-a95e969d0c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474793}] :answer-field/correct {:answer/id #uuid "cbf8c1e6-7440-5b66-ac6a-a95e969d0c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474793} :answer-field/id #uuid "b0703231-e8db-5753-a623-8cdd5ed3035a" :answer-field/key "$y=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475322} {:answer-field/choices [{:answer/id #uuid "1ebb008e-2a78-528f-b65f-04738d8d69bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474794} {:answer/id #uuid "3b5fb8cd-1e60-5d1a-9b3c-43f1bdfb0eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474795}] :answer-field/correct {:answer/id #uuid "1ebb008e-2a78-528f-b65f-04738d8d69bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474794} :answer-field/id #uuid "2ee39774-5b22-57d7-b22d-32c67ba80ab1" :answer-field/key "$y=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{sin}⁡(2t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475323} {:answer-field/choices [{:answer/id #uuid "154527e1-d8e6-580a-bfa6-88b0d7e11c16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474796} {:answer/id #uuid "fe8f9ab4-11d0-5d2b-b95a-f6633b354687" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474797}] :answer-field/correct {:answer/id #uuid "fe8f9ab4-11d0-5d2b-b95a-f6633b354687" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474797} :answer-field/id #uuid "80d02f47-2169-5889-be5d-7762353c0de6" :answer-field/key "$y$ $=A\\operatorname{cos}⁡(2t)$ $+B\\operatorname{sin}⁡(2t)$ $+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5e9f5eb-87cf-56db-acd3-a7af3f0549dd" :question/math-academy-id "q-343755" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=-7\\operatorname{sin}⁡(2t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=-7\\operatorname{sin}⁡(2t),$ which is sinusoidal with frequency $2.$ Therefore,\n$\\omega =2.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(2t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(2t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(2t)+B\\operatorname{sin}⁡(2t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(2t)+D\\operatorname{sin}⁡(2t)).\n$$\n\nBy substituting the particular solution and $\\omega =2$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[4(D-Ct)\\operatorname{cos}⁡(2t)-4(C+Dt)\\operatorname{sin}⁡(2t)]+4t(C\\operatorname{cos}⁡(2t)+D\\operatorname{sin}⁡(2t)) & =-7\\operatorname{sin}⁡(2t) \\\\ 4D\\operatorname{cos}⁡(2t)-4C\\operatorname{sin}⁡(2t) & =-7\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nEquating coefficients, $C=\\frac{7}{4}$ and $D=0.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{7}{4}t\\operatorname{cos}⁡(2t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\n2\\. $y=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\n3\\. $y$ $=A\\operatorname{cos}⁡(2t)$ $+B\\operatorname{sin}⁡(2t)$ $+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\nOnly solutions $y=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$ and $y$ $=A\\operatorname{cos}⁡(2t)$ $+B\\operatorname{sin}⁡(2t)$ $+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$ match the forms above.\nTherefore, the correct answer is $y=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$; $y$ $=A\\operatorname{cos}⁡(2t)$ $+B\\operatorname{sin}⁡(2t)$ $+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048966 :topic/id #uuid "cfd9de67-b6d3-5aac-81ab-498c732e22a6" :topic/math-academy-id 6720 :topic/title "Resonance in Vibrating Systems"} :activity/title "Resonance in Vibrating Systems" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186442732} :db/id #edb/ref 17592186442741}]} {:db/id #edb/ref 17592186435739 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation" :topic/_knowledge-points [{:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2ea973b-be96-5868-8539-6c899e1ceafe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474448} {:answer/id #uuid "7d68fc43-f827-53f4-85d1-5fdc1b65ccfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474449}] :answer-field/correct {:answer/id #uuid "a2ea973b-be96-5868-8539-6c899e1ceafe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474448} :answer-field/id #uuid "a9f6a784-72d9-5eb5-a30e-a14d4101a6e3" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }2\\le x\\le 3,\\\\\\,1\\le y\\le x\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475150} {:answer-field/choices [{:answer/id #uuid "80fc9029-59aa-5e75-ad59-589c54a3c286" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474450} {:answer/id #uuid "4decac87-cafe-52a9-807a-2ddc89482edf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474451}] :answer-field/correct {:answer/id #uuid "80fc9029-59aa-5e75-ad59-589c54a3c286" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474450} :answer-field/id #uuid "7f0152dd-54b9-543e-9c9b-83e9b237216f" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }1\\le {x}^{2}\\le 4,\\\\\\,1\\le y\\le 2\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475151} {:answer-field/choices [{:answer/id #uuid "33316c25-10aa-5c8e-a525-3672f92a3e48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474452} {:answer/id #uuid "d2f9c8de-3749-52d8-ac88-8e8037581074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474453}] :answer-field/correct {:answer/id #uuid "d2f9c8de-3749-52d8-ac88-8e8037581074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474453} :answer-field/id #uuid "95b77009-994d-5391-acfd-993891381237" :answer-field/key "$\\{(x,y)\\in {R}^{2}:\\text{ }5{x}^{2}+{y}^{2}<2\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c87d140-5d2b-5665-af2c-c72dc631274f" :question/math-academy-id "q-161645" :question/problem "Which of the following sets are open?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is $\\{(x,y)\\in {R}^{2}:\\text{ }5{x}^{2}+{y}^{2}<2\\}$ only."} {:db/id #edb/ref 17592186435740 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed" :topic/_knowledge-points [{:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce7aba98-baca-58f3-823b-793d80f413c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474846} {:answer/id #uuid "c4b15395-9779-532b-ae7a-32b0491f24a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474847}] :answer-field/correct {:answer/id #uuid "ce7aba98-baca-58f3-823b-793d80f413c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474846} :answer-field/id #uuid "b46f5f99-cae8-5ecf-b933-9ca022e9d398" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,x<y<{x}^{2},\\\\\\,1<x<3\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475349} {:answer-field/choices [{:answer/id #uuid "d09dddc3-2c7d-5ed6-9dc6-7706a726b5de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474848} {:answer/id #uuid "7013c7b8-6487-57e4-a822-26e6b34d05a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474849}] :answer-field/correct {:answer/id #uuid "d09dddc3-2c7d-5ed6-9dc6-7706a726b5de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474848} :answer-field/id #uuid "969b8d38-4f22-5606-bfb6-021773debd86" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,0<x<1,\\\\\\,0<y<1\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475350} {:answer-field/choices [{:answer/id #uuid "61e8b74b-b88f-570f-928a-3bb5b3c64223" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474850} {:answer/id #uuid "8d8b2ef8-0c55-5fe2-9200-c91308c99c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474851}] :answer-field/correct {:answer/id #uuid "8d8b2ef8-0c55-5fe2-9200-c91308c99c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474851} :answer-field/id #uuid "de0c6d9d-d517-5c5b-aba5-890ac0747ef1" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,2\\le x\\le 4,\\\\\\,0<y\\le \\sqrt{x}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f5bd7aa-b6dd-5eb5-9622-6b7733243884" :question/math-academy-id "q-71822" :question/problem "Which of the following sets are neither open nor closed?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is also *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(4,2).$ On the other hand, it does not contain some other boundary points, for example, the point $(4,0).$\n\nTherefore, the correct answer is $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,2\\le x\\le 4,\\\\\\,0<y\\le \\sqrt{x}\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186436043 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f989fd68-acf4-556b-8204-a65874853b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474954} {:answer/id #uuid "61629148-80cc-5f27-9e85-9aef3674ddb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474955}] :answer-field/correct {:answer/id #uuid "f989fd68-acf4-556b-8204-a65874853b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474954} :answer-field/id #uuid "88f9ef63-a2d3-5377-8a45-034749a64a60" :answer-field/key "${∬}_{R}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [0,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475403} {:answer-field/choices [{:answer/id #uuid "287515a8-f582-5ab7-b753-5427943347a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474956} {:answer/id #uuid "f0506c84-e3a0-5e51-8551-816cb0bfb600" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474957}] :answer-field/correct {:answer/id #uuid "f0506c84-e3a0-5e51-8551-816cb0bfb600" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474957} :answer-field/id #uuid "9792e7d3-778a-5703-9384-b40fab189daf" :answer-field/key "${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-3,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475404} {:answer-field/choices [{:answer/id #uuid "48c73456-60c2-5847-b039-d9f5820e7f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474958} {:answer/id #uuid "e3c1d1ec-df43-5584-85d8-8a2f435d0d68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474959}] :answer-field/correct {:answer/id #uuid "48c73456-60c2-5847-b039-d9f5820e7f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474958} :answer-field/id #uuid "ab8930af-c48d-56c7-b380-3a5e38859878" :answer-field/key "${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,2]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475405}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7e910b3-a1a9-5ea8-8009-6cb31a154137" :question/math-academy-id "q-86864" :question/problem "![](images/bb/bbc1bc7b3bb910ffbd13571283bbfa305404d13eb2cb3b5ab423a1c02e46ab86.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}y({x}^{2}-{y}^{2}) & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}y({x}^{2}-{y}^{2}), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “${∬}_{R}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [0,2]$” is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement “${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-3,2]$” is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement “${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,2]\\times [-2,2]$” is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is “${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-3,2]$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436029} :db/id #edb/ref 17592186436046}]} {:db/id #edb/ref 17592186496595 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e41394-7b55-5bc3-bc16-70da08ee175b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496602} {:answer/id #uuid "b143c46e-de12-5d3b-b2c3-3361fcf67088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496626}] :answer-field/correct {:answer/id #uuid "19e41394-7b55-5bc3-bc16-70da08ee175b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496602} :answer-field/id #uuid "cd8616f4-9a95-592a-b132-b5ee4d8121c7" :answer-field/key "$(4+x^2)\\left(\\dfrac{dy}{dx}-3y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496631} {:answer-field/choices [{:answer/id #uuid "021d0e53-551b-5043-b015-a6c429c20350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496592} {:answer/id #uuid "0e51cf2a-f44d-50be-b8c8-f0f53e11215b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496600}] :answer-field/correct {:answer/id #uuid "021d0e53-551b-5043-b015-a6c429c20350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496592} :answer-field/id #uuid "d7f50105-bf2d-5f42-8541-d2897e8819e0" :answer-field/key "$(5+x^2)\\left(\\dfrac{d^3y}{dx^3}-3y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=-2,$ $\\,{y}^{′}(3)$ $=-1,$ $\\,{y}^{″}(3)$ $=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496636} {:answer-field/choices [{:answer/id #uuid "4ba86b24-a09e-58ef-a131-22bb7e0d8b2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496609} {:answer/id #uuid "9aa8b251-d22b-5c20-85ca-0282eba2a1bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496622}] :answer-field/correct {:answer/id #uuid "9aa8b251-d22b-5c20-85ca-0282eba2a1bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496622} :answer-field/id #uuid "e01ef92e-e0ac-5a62-9cc8-729882dff28c" :answer-field/key "$(5+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496639}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "04cab1c1-b4c4-563e-a4e0-aea26627ab39" :question/problem "Which of the following systems is a first-order initial value problem?\n\nSelect all that apply." :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System $(5+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=2$ is a first-order initial value problem. It consists of a first-order differential equation $(5+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}={e}^{x}$ together with the initial condition $y(3)=2.$\n\n- System $(4+x^2)\\left(\\dfrac{dy}{dx}-3y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=4$ is a first-order initial value problem. It consists of a first-order differential equation $(4+x^2)\\left(\\dfrac{dy}{dx}-3y\\right)+x{y}^{′}={e}^{x}$ together with the initial condition $y(3)=4.$\n\n- System $(5+x^2)\\left(\\dfrac{d^3y}{dx^3}-3y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=-2,$ $\\,{y}^{′}(3)$ $=-1,$ $\\,{y}^{″}(3)$ $=0$ is not a first-order initial value problem. It consists of a *third*-order differential equation $(5+x^2)\\left(\\dfrac{d^3y}{dx^3}-3y\\right)+x{y}^{′}={e}^{x}$ together with *three* initial conditions $y(3)=-2,\\,{y}^{′}(3)=-1,\\,{y}^{″}(3)=0.$ This is a third-order initial value problem.\n\nTherefore, the correct answer is $(5+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=2$; $(4+x^2)\\left(\\dfrac{dy}{dx}-3y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(3)$ $=4$ only."} {:db/id #edb/ref 17592186496603 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093ce5ea-7ce2-5813-a68f-45ee253e563a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496598} {:answer/id #uuid "9248089b-449f-5a57-9d31-012fd4df93ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496621}] :answer-field/correct {:answer/id #uuid "9248089b-449f-5a57-9d31-012fd4df93ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496621} :answer-field/id #uuid "68f91a6e-36ba-5b8e-a47c-cc852cf6015b" :answer-field/key "$(3+x^2)\\left(\\dfrac{d^2y}{dx^2}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(2)$ $=2,$ $\\,{y}^{′}(2)$ $=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496615} {:answer-field/choices [{:answer/id #uuid "09b42851-445f-5a9d-ab02-aa2985e5a712" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496599} {:answer/id #uuid "dac405a2-0857-5f8a-aa9b-a6e0e1bf8e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496638}] :answer-field/correct {:answer/id #uuid "09b42851-445f-5a9d-ab02-aa2985e5a712" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496599} :answer-field/id #uuid "cd3e44b4-360a-5420-bb71-a53893ebdc6a" :answer-field/key "$(2+x^2)\\left(\\dfrac{dy}{dx}-3y\\right)+x{y}^{′}$ $={e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496630} {:answer-field/choices [{:answer/id #uuid "a12833f2-4e47-5632-b3a8-fc9f1744a73b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496624} {:answer/id #uuid "d17423f1-5878-5a7a-86bc-a0a3b36ab500" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496634}] :answer-field/correct {:answer/id #uuid "d17423f1-5878-5a7a-86bc-a0a3b36ab500" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496634} :answer-field/id #uuid "d821fbc5-23ce-510c-b285-ba04451b475d" :answer-field/key "$(4+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(2)$ $=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186496637}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "210dbb55-04e5-5206-8aa8-e837c31cd3f9" :question/problem "Which of the following systems is a first-order initial value problem?\n\nSelect all that apply." :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System $(4+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(2)$ $=-4$ is a first-order initial value problem. It consists of a first-order differential equation $(4+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}={e}^{x}$ together with the initial condition $y(2)=-4.$\n\n- System $(2+x^2)\\left(\\dfrac{dy}{dx}-3y\\right)+x{y}^{′}$ $={e}^{x}$ is not a first-order initial value problem. We have a first-order ordinary differential equation, but there is no initial condition.\n\n- System $(3+x^2)\\left(\\dfrac{d^2y}{dx^2}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(2)$ $=2,$ $\\,{y}^{′}(2)$ $=3$ is not a first-order initial value problem. It consists of a *second*-order differential equation $(3+x^2)\\left(\\dfrac{d^2y}{dx^2}-2y\\right)+x{y}^{′}={e}^{x}$ together with *two* initial conditions $y(2)=2,\\,{y}^{′}(2)=3.$ This is a second-order initial value problem.\n\nTherefore, the correct answer is $(4+x^2)\\left(\\dfrac{dy}{dx}-2y\\right)+x{y}^{′}$ $={e}^{x},$ $\\,y(2)$ $=-4$ only."} {:db/id #edb/ref 17592186496616 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0674cf3a-6c5d-570d-896a-baebcbd11a10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186496597} {:answer/id #uuid "84bed33a-efd3-5ef6-8f39-121fb5bbd81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186496620}] :answer-field/correct {:answer/id #uuid "0674cf3a-6c5d-570d-896a-baebcbd11a10" :answer/type {:db/id #edb/ref 17592186045499 :db/