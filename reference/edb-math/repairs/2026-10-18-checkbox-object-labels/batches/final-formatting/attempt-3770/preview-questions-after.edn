)\\in {R}^{2}:\\\\\\text{ }-\\frac{\\pi }{2}<x<0,\\\\\\,0<y<\\operatorname{cos}⁡x\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466568} {:answer-field/choices [{:answer/id #uuid "149425c6-0498-5c99-a352-0ec427a109a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465451} {:answer/id #uuid "23d20095-cdfb-5bd4-99da-2d9b72a8cfda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465452}] :answer-field/correct {:answer/id #uuid "23d20095-cdfb-5bd4-99da-2d9b72a8cfda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465452} :answer-field/id #uuid "17ec6c3d-c76a-58bb-b31c-ebf8bf37fb63" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }-2<x<2,\\\\\\,0<y<{x}^{2}+1\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdca40a5-5172-5279-8887-174acedd2d48" :question/math-academy-id "q-161647" :question/problem "Which of the following sets are open?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }-\\frac{\\pi }{2}<x<0,\\\\\\,0<y<\\operatorname{cos}⁡x\\end{gathered}\\right\\}\\end{gathered}$; $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}:\\\\\\text{ }-2<x<2,\\\\\\,0<y<{x}^{2}+1\\end{gathered}\\right\\}\\end{gathered}$ only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048439 :topic/id #uuid "9f807cd5-8888-510e-98d9-a7920b0d7b50" :topic/math-academy-id 4097 :topic/title "Open and Closed Sets"} :activity/title "Open and Closed Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409697} :db/id #edb/ref 17592186409712}]} {:db/id #edb/ref 17592186281464 :knowledge-point/_questions [{:db/id #edb/ref 17592186124484 :knowledge-point/id #uuid "7eb09138-45df-5e6c-87af-772980ff7546" :knowledge-point/title "Verifying Properties Involving Vector Addition" :topic/_knowledge-points [{:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bb7b96-0ee1-540e-a86d-287f27a702b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450048} {:answer/id #uuid "37ffb9ee-3671-538d-82eb-1a76ca7b6bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450049}] :answer-field/correct {:answer/id #uuid "37ffb9ee-3671-538d-82eb-1a76ca7b6bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450049} :answer-field/id #uuid "2e2d51bd-2585-5f79-94d3-b038a415082e" :answer-field/key "The zero-polynomial belongs to $U.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450978} {:answer-field/choices [{:answer/id #uuid "9b0a5de1-ebdf-50db-b852-bdb9ce68a858" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450050} {:answer/id #uuid "a60f5a43-04d9-5f88-b2bc-365bc6d9531d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450051}] :answer-field/correct {:answer/id #uuid "9b0a5de1-ebdf-50db-b852-bdb9ce68a858" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450050} :answer-field/id #uuid "196f729e-b1a5-5503-a13d-a4964e7a82dd" :answer-field/key "For any $p(x),q(x)\\in U,$ we have $p(x)-q(x)=q(x)-p(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450979} {:answer-field/choices [{:answer/id #uuid "1997ce5d-b934-50cb-856c-b4aaa92fef20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450052} {:answer/id #uuid "a552e5a8-222c-522a-b522-815b9887824d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450053}] :answer-field/correct {:answer/id #uuid "1997ce5d-b934-50cb-856c-b4aaa92fef20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450052} :answer-field/id #uuid "d6507d2c-9d83-5368-870c-3233d9d50c59" :answer-field/key "There are polynomials $p(x),q(x),r(x)\\in U$ such that $[p(x)+q(x)]+r(x)$ $\\ne p(x)+[q(x)+r(x)].$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450980}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b2f6345-ac14-55a4-a687-5a14893fcf90" :question/math-academy-id "q-162392" :question/problem "Let $U$ be the set of polynomials of the form $a{x}^{3}+b{x}^{2},$ where $a,b\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each statement in turn.\n\n- Statement “The zero-polynomial belongs to $U.$” is true. Indeed, the zero-polynomial can be represented as \n\n$$\n0=0\\cdot {x}^{3}+0\\cdot {x}^{2}.\n$$\n\n \nHence, $0\\in U.$\n\n- Statement “For any $p(x),q(x)\\in U,$ we have $p(x)-q(x)=q(x)-p(x).$” is false. For example, consider the polynomials $p(x)={x}^{3}\\in U$ and the zero-polynomial $q(x)=0\\in U.$ Then \n\n$$\np(x)-q(x)=p(x)-0={x}^{3}\n$$\n\nwhile \n\n$$\nq(x)-p(x)=0-p(x)=-{x}^{3}\\ne {x}^{3}.\n$$\n\n- Statement “There are polynomials $p(x),q(x),r(x)\\in U$ such that $[p(x)+q(x)]+r(x)$ $\\ne p(x)+[q(x)+r(x)].$” is false. For any polynomials $p(x),q(x)\\in U,$ we have \n\n$$\n[p(x)+q(x)]+r(x)=p(x)+[q(x)+r(x)],\n$$\n\nsince polynomial addition is associative.\n\nTherefore, the correct answer is “The zero-polynomial belongs to $U.$” only."} {:db/id #edb/ref 17592186281525 :knowledge-point/_questions [{:db/id #edb/ref 17592186124589 :knowledge-point/id #uuid "099e7caf-085a-5fd5-ad3d-1ebf189527b7" :knowledge-point/title "Verifying Properties Involving Scalar Multiplication and the Distributive Laws" :topic/_knowledge-points [{:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e2779fb-9930-5fcd-bcd1-7e1f1104d4a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450066} {:answer/id #uuid "91b3e3fc-389a-585f-96b5-7db78750f42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450067}] :answer-field/correct {:answer/id #uuid "91b3e3fc-389a-585f-96b5-7db78750f42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450067} :answer-field/id #uuid "5f7c9859-71fa-5115-a310-1182f4bf63bc" :answer-field/key "There is a function $f(x)\\in Q,$ such that $(-1)\\cdot f(x)=f(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450987} {:answer-field/choices [{:answer/id #uuid "662847ba-aeb6-5cbd-8649-2265e32224d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450068} {:answer/id #uuid "bf79e41d-5399-5862-8d64-f981b0f2cf1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450069}] :answer-field/correct {:answer/id #uuid "bf79e41d-5399-5862-8d64-f981b0f2cf1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450069} :answer-field/id #uuid "b083e9d7-fb4e-5c84-9a1a-a1c99a0f9d6c" :answer-field/key "For any $f(x)\\in Q$ and $\\alpha ,\\beta \\in R,$ we have $(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450988} {:answer-field/choices [{:answer/id #uuid "69cd0a9e-9920-5b05-8ece-dcad3cae55ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450070} {:answer/id #uuid "dc7468af-0186-5e65-ab49-7c01cd3fc068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450071}] :answer-field/correct {:answer/id #uuid "dc7468af-0186-5e65-ab49-7c01cd3fc068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450071} :answer-field/id #uuid "b050593e-e59b-5bdf-835e-4f773eafb358" :answer-field/key "For any $f(x),g(x)\\in Q$ and $\\alpha \\in R,$ we have $\\alpha (f(x)+g(x))$ $=\\alpha f(x)$ $+\\alpha g(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450989}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff69a5c1-505a-5719-b6b9-7ec69e0931ef" :question/math-academy-id "q-162664" :question/problem "Let $Q$ be the set of all functions of the form $f(x)=a{x}^{2},$ where $a\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement “There is a function $f(x)\\in Q,$ such that $(-1)\\cdot f(x)=f(x).$” is true. Consider the null function $f(x)=0=0{x}^{2}\\in Q.$ Then,\n\n$$\n(-1)\\cdot f(x)=(-1)\\cdot 0=0=f(x).\n$$\n\nHence, $(-1)\\cdot f(x)=f(x).$\n\n- Statement “For any $f(x)\\in Q$ and $\\alpha ,\\beta \\in R,$ we have $(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).$” is true. Indeed, for any function $f(x)\\in Q$ and any fixed $x\\in R,$ the result of $f(x)$ is just a real number. Thus, for any $\\alpha ,\\beta \\in R,$ we obtain that\n\n$$\n(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).\n$$\n\n- Statement “For any $f(x),g(x)\\in Q$ and $\\alpha \\in R,$ we have $\\alpha (f(x)+g(x))$ $=\\alpha f(x)$ $+\\alpha g(x).$” is true. Indeed, for any functions $f(x),g(x)\\in Q$ and any fixed $x\\in R,$ the results of $f(x)$ and $g(x)$ are just real numbers. Thus, for any $\\alpha \\in R,$ we obtain that\n\n$$\n\\alpha (f(x)+g(x))=\\alpha f(x)+\\alpha g(x).\n$$\n\nTherefore, the correct answer is “There is a function $f(x)\\in Q,$ such that $(-1)\\cdot f(x)=f(x).$”; “For any $f(x)\\in Q$ and $\\alpha ,\\beta \\in R,$ we have $(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).$”; “For any $f(x),g(x)\\in Q$ and $\\alpha \\in R,$ we have $\\alpha (f(x)+g(x))$ $=\\alpha f(x)$ $+\\alpha g(x).$”." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"} :activity/title "Introduction to Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186426537} :db/id #edb/ref 17592186426555}]} {:db/id #edb/ref 17592186281526 :knowledge-point/_questions [{:db/id #edb/ref 17592186124589 :knowledge-point/id #uuid "099e7caf-085a-5fd5-ad3d-1ebf189527b7" :knowledge-point/title "Verifying Properties Involving Scalar Multiplication and the Distributive Laws" :topic/_knowledge-points [{:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6dc2795-4ab0-51de-a770-20d43c3a88f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450072} {:answer/id #uuid "06198632-4bef-5852-8df3-61b23cc71b43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450073}] :answer-field/correct {:answer/id #uuid "b6dc2795-4ab0-51de-a770-20d43c3a88f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450072} :answer-field/id #uuid "76c5b6a9-c201-5cfe-94b7-0a5d6e2baf31" :answer-field/key "$\\frac{1}{{x}^{2}}\\in S$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450990} {:answer-field/choices [{:answer/id #uuid "554b7f4f-d75d-532f-af10-b13a3597fa28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450074} {:answer/id #uuid "39d14144-cd01-511c-b559-2f430b3240b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450075}] :answer-field/correct {:answer/id #uuid "39d14144-cd01-511c-b559-2f430b3240b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450075} :answer-field/id #uuid "fc461b09-0b94-5bf1-9079-3927e7dcb562" :answer-field/key "For any $p(x)\\in S,$ we have $(-1)\\cdot p(x)\\in S$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450991} {:answer-field/choices [{:answer/id #uuid "df5a4b91-36ef-5113-a4b9-d1f9b7d8da80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450076} {:answer/id #uuid "aa572e6a-aad9-513a-b665-99a85554378d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450077}] :answer-field/correct {:answer/id #uuid "aa572e6a-aad9-513a-b665-99a85554378d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450077} :answer-field/id #uuid "55832c01-3fed-5f96-9d33-cae8fdc270f3" :answer-field/key "For any $p(x),q(x)\\in S$ and $\\alpha \\in R,$ we have $\\alpha (p(x)-q(x))$ $=\\alpha p(x)$ $-\\alpha q(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450992}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69e25145-91f1-58d1-afd8-be54a0c5863e" :question/math-academy-id "q-162665" :question/problem "Let $S$ be the set of all polynomials with real coefficients and whose degree is at most $2.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement $\\frac{1}{{x}^{2}}\\in S$ is false. The set $S$ contains only polynomials whose degree is at most $2.$ However, $\\frac{1}{{x}^{2}}$ is *not* a polynomial. So, $\\frac{1}{{x}^{2}}\\notin S.$\n\n- Statement “For any $p(x)\\in S,$ we have $(-1)\\cdot p(x)\\in S$” is true. Let $deg(q)$ the degree of a polynomial $q.$ Then, for any $p(x)\\in S$ we have that $(-1)\\cdot p(x)$ is also a polynomial, and that\n\n$$\ndeg((-1)\\cdot p)=deg(-1)+deg(p)=0+deg(p)\\le 2.\n$$\n\nHence, $(-1)p(x)\\in S.$\n\n- Statement “For any $p(x),q(x)\\in S$ and $\\alpha \\in R,$ we have $\\alpha (p(x)-q(x))$ $=\\alpha p(x)$ $-\\alpha q(x)$” is true. Indeed, for any $p(x),q(x)\\in S$ and for any fixed $x\\in R,$ the values $p(x)$ and $q(x)$ are just real numbers. Thus, for any $\\alpha \\in R,$ we obtain that\n\n$$\n\\alpha (p(x)-q(x))=\\alpha p(x)-\\alpha q(x).\n$$\n\nTherefore, the correct answer is “For any $p(x)\\in S,$ we have $(-1)\\cdot p(x)\\in S$”; “For any $p(x),q(x)\\in S$ and $\\alpha \\in R,$ we have $\\alpha (p(x)-q(x))$ $=\\alpha p(x)$ $-\\alpha q(x)$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049737 :topic/id #uuid "0f66ea93-6fdc-5bbf-826c-7d07b2ef17d7" :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"} :activity/title "Introduction to Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508380} :db/id #edb/ref 17592186509016}]} {:db/id #edb/ref 17592186281533 :knowledge-point/_questions [{:db/id #edb/ref 17592186162155 :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/title "Determining Whether Two Random Variables are Independent" :topic/_knowledge-points [{:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048 :topic/title "Independence of Discrete Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc10e234-82ec-548f-b508-b8a34d60de48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465477} {:answer/id #uuid "19cc9d63-26ae-5d67-8d2e-92a25b620c74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465478}] :answer-field/correct {:answer/id #uuid "19cc9d63-26ae-5d67-8d2e-92a25b620c74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465478} :answer-field/id #uuid "76684f2a-492a-5359-ab60-ed33c7131dda" :answer-field/key "$P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466582} {:answer-field/choices [{:answer/id #uuid "d585690c-260f-5e71-a6e3-572e7e3486d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465479} {:answer/id #uuid "2dfff1c9-8854-533f-bcbe-5d8a3b55044b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465480}] :answer-field/correct {:answer/id #uuid "d585690c-260f-5e71-a6e3-572e7e3486d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465479} :answer-field/id #uuid "d16a6f9f-f813-5bc0-8804-79ea114f5d79" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466583} {:answer-field/choices [{:answer/id #uuid "934f59a6-e3f6-570b-9a54-e524e4c540a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465481} {:answer/id #uuid "abb738ed-ecd8-58af-9c55-39b58795284c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465482}] :answer-field/correct {:answer/id #uuid "934f59a6-e3f6-570b-9a54-e524e4c540a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465481} :answer-field/id #uuid "ec28cbc6-2271-5aa3-a1c8-3a8a32cf506a" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466584}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b5dd282b-2dab-5297-89c3-a4849921b265" :question/math-academy-id "q-162746" :question/problem "| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.06$ | $0.04$ |\n| $X=2$ | $0.5$ | $0.24$ | $0.06$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n| | $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| ${f}_{X}(x)$ | $0.2$ | $0.8$ | |  | | $y$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.6$ | $0.3$ | $0.1$ | |  |\n| --- | --- | --- | --- |\n| $x$ | $1$ | $2$ |  |\n| ${f}_{X}(x)$ | $0.2$ | $0.8$ |  |\n| $y$ | $0$ | $1$ | $2$ |\n| ${f}_{Y}(y)$ | $0.6$ | $0.3$ | $0.1$ |\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ is true. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.06.$ On the other hand, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.2\\cdot 0.3=0.06.\\,✓\n$$\n\n- Statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(1,0) & =0.1\\ne 0.2\\cdot 0.6={f}_{X}(1)\\cdot {f}_{Y}(0) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is false. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ only."} {:db/id #edb/ref 17592186281553 :knowledge-point/_questions [{:db/id #edb/ref 17592186162155 :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/title "Determining Whether Two Random Variables are Independent" :topic/_knowledge-points [{:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048 :topic/title "Independence of Discrete Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b6d959-ee25-5492-981c-35d8db8e5d29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465483} {:answer/id #uuid "ff9adef5-225c-5e47-85de-42b3cd7836b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465484}] :answer-field/correct {:answer/id #uuid "06b6d959-ee25-5492-981c-35d8db8e5d29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465483} :answer-field/id #uuid "14307e24-b8d0-5de1-9104-6c06ac0c93ca" :answer-field/key "$P(X=1,Y=0)$ $=P(X=1)\\cdot P(Y=0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466585} {:answer-field/choices [{:answer/id #uuid "655fd2b1-caba-581e-9f02-5af690a77b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465485} {:answer/id #uuid "68af336e-64bf-56bf-84dd-85cd858cec6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465486}] :answer-field/correct {:answer/id #uuid "655fd2b1-caba-581e-9f02-5af690a77b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465485} :answer-field/id #uuid "d37345fc-3288-5bfa-8a83-9ad74cabae6f" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466586} {:answer-field/choices [{:answer/id #uuid "a7f3db53-a644-5ca7-a50d-da78184c6ba9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465487} {:answer/id #uuid "10595161-cfd2-59f2-802a-94f7478661b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465488}] :answer-field/correct {:answer/id #uuid "a7f3db53-a644-5ca7-a50d-da78184c6ba9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465487} :answer-field/id #uuid "4bf4bd53-b362-55cb-86c6-31f5ad34dba8" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466587}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "745e2846-c808-51fa-a431-23f636897e08" :question/math-academy-id "q-162824" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.35$ | $0.15$ |\n| $X=1$ | $0.25$ | $0.25$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n| | $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| ${f}_{X}(x)$ | $0.5$ | $0.5$ | |  | | $y$ | $0$ | $1$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.6$ | $0.4$ | |\n| --- | --- | --- |\n| $x$ | $0$ | $1$ |\n| ${f}_{X}(x)$ | $0.5$ | $0.5$ |\n| $y$ | $0$ | $1$ |\n| ${f}_{Y}(y)$ | $0.6$ | $0.4$ |\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statements $P(X=1,Y=0)$ $=P(X=1)\\cdot P(Y=0)$ and “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” are false. From the table, we obtain that $P(X=1,Y=0)=f(1,0)=0.25.$ However, \n\n$$\nP(X=1)\\cdot P(Y=0)={f}_{X}(1)\\cdot {f}_{Y}(0)=0.5\\cdot 0.6=0.3.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=1,Y=0)\\ne P(X=1)\\cdot P(Y=0),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is false. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186281683 :knowledge-point/_questions [{:db/id #edb/ref 17592186162155 :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/title "Determining Whether Two Random Variables are Independent" :topic/_knowledge-points [{:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048 :topic/title "Independence of Discrete Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6bd5f7b-86e2-5e7e-b73c-315158951242" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465489} {:answer/id #uuid "69898b06-6833-5e82-bda7-be2ba91dcd05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465490}] :answer-field/correct {:answer/id #uuid "69898b06-6833-5e82-bda7-be2ba91dcd05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465490} :answer-field/id #uuid "64426418-f534-5933-9f46-35719ecf03ce" :answer-field/key "$P(X=0,Y=-2)$ $=P(X=0)\\cdot P(Y=-2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466588} {:answer-field/choices [{:answer/id #uuid "dece8f5a-d33c-55b1-8727-78b35148f159" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465491} {:answer/id #uuid "8a0e11ca-3eba-54ba-b933-6364f809561b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465492}] :answer-field/correct {:answer/id #uuid "8a0e11ca-3eba-54ba-b933-6364f809561b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465492} :answer-field/id #uuid "0a934dbd-cdc8-57f7-8678-a94b82ca59cf" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466589} {:answer-field/choices [{:answer/id #uuid "a11b7752-cf12-5634-a8c7-a28b035c3ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465493} {:answer/id #uuid "6d8854e9-a444-5ea2-b47b-67f40c37002e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465494}] :answer-field/correct {:answer/id #uuid "6d8854e9-a444-5ea2-b47b-67f40c37002e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465494} :answer-field/id #uuid "b5ef4a0e-65a8-501a-9a5a-8c9657c7647e" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466590}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b24b5d8-591a-5107-953f-3194f9f2c074" :question/math-academy-id "q-163605" :question/problem "| $f$ | $Y=-2$ | $Y=2$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{4}$ | $\\frac{5}{12}$ |\n| $X=3$ | $\\frac{1}{8}$ | $\\frac{5}{24}$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{X}(x)$</td>\n<td align=\"center\">$\\frac{2}{3}$</td>\n<td align=\"center\">$\\frac{1}{3}$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"50\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$-2$</td>\n<td align=\"center\">$2$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{Y}(y)$</td>\n<td align=\"center\">$\\frac{3}{8}$</td>\n<td align=\"center\">$\\frac{5}{8}$</td>\n</tr>\n</tbody></table>\n<p></p></th></tr></tbody></table>\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement $P(X=0,Y=-2)$ $=P(X=0)\\cdot P(Y=-2)$ is true. From the table, we obtain that $P(X=0,Y=-2)=f(0,-2)=\\frac{1}{4}.$ On the other hand, \n\n$$\nP(X=0)\\cdot P(Y=-2)={f}_{X}(0)\\cdot {f}_{Y}(-2)=\\frac{2}{3}\\cdot \\frac{3}{8}=\\frac{1}{4}.\\,✓\n$$\n\n- Statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is true. Checking all other possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,2) & =\\frac{5}{12}=\\frac{2}{3}\\cdot \\frac{5}{8}={f}_{X}(0)\\cdot {f}_{Y}(2) & ✓ \\\\ f(3,-2) & =\\frac{1}{8}=\\frac{1}{3}\\cdot \\frac{3}{8}={f}_{X}(3)\\cdot {f}_{Y}(-2) & ✓ \\\\ f(3,2) & =\\frac{5}{24}=\\frac{1}{3}\\cdot \\frac{5}{8}={f}_{X}(3)\\cdot {f}_{Y}(2) & ✓\\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is true. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is true, our random variables $X$ and $Y$ must be independent.\n\nTherefore, the correct answer is $P(X=0,Y=-2)$ $=P(X=0)\\cdot P(Y=-2)$; “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$”; “$X$ and $Y$ are independent”."} {:db/id #edb/ref 17592186284383 :knowledge-point/_questions [{:db/id #edb/ref 17592186162155 :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/title "Determining Whether Two Random Variables are Independent" :topic/_knowledge-points [{:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048 :topic/title "Independence of Discrete Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a8ad20-3764-5670-8078-71b7721fc577" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465495} {:answer/id #uuid "27b99241-25ca-5909-922e-fe366e5d4927" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465496}] :answer-field/correct {:answer/id #uuid "27b99241-25ca-5909-922e-fe366e5d4927" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465496} :answer-field/id #uuid "8aa1944d-ce09-51f9-8a91-e6875021ae04" :answer-field/key "$P(X=8,Y=1)$ $=P(X=8)\\cdot P(Y=1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466591} {:answer-field/choices [{:answer/id #uuid "3d4f6faf-e175-54c4-a961-1ff23aedd8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465497} {:answer/id #uuid "057dab26-bc3c-5bcc-81b6-1a2bb82c5a8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465498}] :answer-field/correct {:answer/id #uuid "057dab26-bc3c-5bcc-81b6-1a2bb82c5a8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465498} :answer-field/id #uuid "0e7a4211-9bc2-523c-9177-898dbab2152d" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466592} {:answer-field/choices [{:answer/id #uuid "9d6ce853-4f78-5f21-87d1-1b375cb77cc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465499} {:answer/id #uuid "0da85821-e95e-5859-8a01-ba978cb19b95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465500}] :answer-field/correct {:answer/id #uuid "0da85821-e95e-5859-8a01-ba978cb19b95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465500} :answer-field/id #uuid "8a10f283-8c48-5c9d-a0f4-a9c8b4e9c55e" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "25bf9bc6-630d-50c0-9382-20c9fae3e81f" :question/math-academy-id "q-163617" :question/problem "| $f$ | $Y=-1$ | $Y=1$ |\n| --- | --- | --- |\n| $X=3$ | $0.22$ | $0.33$ |\n| $X=8$ | $0.18$ | $0.27$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n| | $x$ | $3$ | $8$ |\n| --- | --- | --- |\n| ${f}_{X}(x)$ | $0.55$ | $0.45$ | |  | | $y$ | $-1$ | $1$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.4$ | $0.6$ | |\n| --- | --- | --- |\n| $x$ | $3$ | $8$ |\n| ${f}_{X}(x)$ | $0.55$ | $0.45$ |\n| $y$ | $-1$ | $1$ |\n| ${f}_{Y}(y)$ | $0.4$ | $0.6$ |\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement $P(X=8,Y=1)$ $=P(X=8)\\cdot P(Y=1)$ is true. From the table, we obtain that $P(X=8,Y=1)=f(8,1)=0.27.$ On the other hand, \n\n$$\nP(X=8)\\cdot P(Y=1)={f}_{X}(8)\\cdot {f}_{Y}(1)=0.45\\cdot 0.6=0.27.\\,✓\n$$\n\n- Statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is true. Checking all other possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(3,-1) & =0.22=0.55\\cdot 0.4={f}_{X}(3)\\cdot {f}_{Y}(-1) & ✓ \\\\ f(3,1) & =0.33=0.55\\cdot 0.6={f}_{X}(3)\\cdot {f}_{Y}(1) & ✓ \\\\ f(8,-1) & =0.18=0.45\\cdot 0.4={f}_{X}(8)\\cdot {f}_{Y}(-1) & ✓\\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is true. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is true, our random variables $X$ and $Y$ must be independent.\n\nTherefore, the correct answer is $P(X=8,Y=1)$ $=P(X=8)\\cdot P(Y=1)$; “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$”; “$X$ and $Y$ are independent”."} {:db/id #edb/ref 17592186284612 :knowledge-point/_questions [{:db/id #edb/ref 17592186133819 :knowledge-point/id #uuid "7dcc1bf5-5eea-5615-8b16-b8ced5de7984" :knowledge-point/title "Describing Type II Regions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048175 :topic/id #uuid "85bac388-4397-5418-87a6-a1048f67cdda" :topic/math-academy-id 2130 :topic/title "Type I, II, and III Regions in Three-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32d6c48a-dabd-5b73-9357-e9238fe393c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465573} {:answer/id #uuid "8bbedede-75c9-5c50-9a91-507080a3e85c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465574}] :answer-field/correct {:answer/id #uuid "8bbedede-75c9-5c50-9a91-507080a3e85c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465574} :answer-field/id #uuid "e7a10710-6405-5191-80b4-acadd8f60354" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 2,\\\\\\,0\\le z\\le 1\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466630} {:answer-field/choices [{:answer/id #uuid "73b9ec23-c1cc-579e-a0c4-5d87c8a00f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465575} {:answer/id #uuid "8b54509e-b4ee-5517-a7b4-1bb55871ef2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465576}] :answer-field/correct {:answer/id #uuid "73b9ec23-c1cc-579e-a0c4-5d87c8a00f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465575} :answer-field/id #uuid "68df803b-b9ef-529e-9c58-0cf537460332" :answer-field/key "${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=6-2y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466631} {:answer-field/choices [{:answer/id #uuid "827960a3-1924-5361-9439-02bae00012a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465577} {:answer/id #uuid "c3bd0ce3-eb31-5e54-a19f-9d0a2dee67ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465578}] :answer-field/correct {:answer/id #uuid "c3bd0ce3-eb31-5e54-a19f-9d0a2dee67ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465578} :answer-field/id #uuid "61aed479-2cfc-5f61-87f7-af250c4897c7" :answer-field/key "${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=\\frac{6-y}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56bcaf58-be45-5744-844e-cf2c4d4d8d5a" :question/math-academy-id "q-168955" :question/problem "![](images/d2/d294519b3909517b9507322c86ad970550ab388a8d759b0ada99ed18627fc4bd.png)\n\nThe region $R$ is bounded by the planes $y=0$, $y=2$, $z=0$, $z=1$, $x=0,$ and $2x+y=6.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\nas a type II region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type II region can be visualized schematically, as shown below.\n\n![](images/e4/e4c9cbbad2f13e9cc125ddbb89125ed2d734eee3f80737125961f4af1846a972.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 2,\\\\\\,0\\le z\\le 1\\end{gathered}\\right\\}\\end{gathered}$ is true. The projection $D$ of the solid onto the $yz$-plane gives the domain \n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,0\\le z\\le 1}.\n$$\n\n- Statement “${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=6-2y$” is false, while statement “${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=\\frac{6-y}{2}$” is true. We have\n\n- the *back* surface $x={f}_{1}(y,z)=0$, and\n\n- the *front* surface $x={f}_{2}(y,z)=\\frac{6-y}{2}.$\n\n![](images/48/487b57182e190cbacf3b1ad30f55d227b59fb470e8b5609ad72327d229e53e45.png)\n\n \n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 2,\\\\\\,0\\le z\\le 1\\end{gathered}\\right\\}\\end{gathered}$; “${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=\\frac{6-y}{2}$” only."} {:db/id #edb/ref 17592186287711 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e66879a4-1b75-5a88-a6ed-8fd6b85adfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465707} {:answer/id #uuid "b124f68f-e11a-5d13-98fd-6cd7c6495d66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465708}] :answer-field/correct {:answer/id #uuid "e66879a4-1b75-5a88-a6ed-8fd6b85adfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465707} :answer-field/id #uuid "c58505ee-a2eb-5ef9-a59f-889021a87c1f" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{x-1})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466697} {:answer-field/choices [{:answer/id #uuid "2fb3f744-7da3-5c78-b89d-4d9935948f84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465709} {:answer/id #uuid "79d4d4fb-d69d-5e32-879f-114865bffeea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465710}] :answer-field/correct {:answer/id #uuid "79d4d4fb-d69d-5e32-879f-114865bffeea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465710} :answer-field/id #uuid "53a9bd3e-fc5a-5844-96ef-c1f2e66eb639" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{-2x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466698} {:answer-field/choices [{:answer/id #uuid "0681701b-55c9-5869-9306-a71407cc8926" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465711} {:answer/id #uuid "8fd43f80-91a0-5407-9c1f-e8915729ef6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465712}] :answer-field/correct {:answer/id #uuid "8fd43f80-91a0-5407-9c1f-e8915729ef6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465712} :answer-field/id #uuid "f74b3081-1eb9-565f-8bd6-2009091835f1" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{x/2})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b09e4d7d-54df-5b2a-b13d-108c786b3198" :question/math-academy-id "q-181643" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & ={e}^{x-1} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $A$ contains only one element:\n\n$$\nA={{e}^{x-1}}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & ={e}^{-2x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{-2x})=-2{e}^{-2x} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{-2x})=4{e}^{-2x} \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-2x})=-8{e}^{-2x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={{e}^{-2x},-2{e}^{-2x},4{e}^{-2x},-8{e}^{-2x},…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & ={e}^{x/2} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x/2})=\\frac{1}{2}{e}^{x/2} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x/2})=\\frac{1}{4}{e}^{x/2} \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{e}^{x/2})=\\frac{1}{8}{e}^{x/2} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={{e}^{x/2},\\frac{1}{2}{e}^{x/2},\\frac{1}{4}{e}^{x/2},\\frac{1}{8}{e}^{x/2},…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186287712 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0608f7d5-cb5d-5c12-9904-be67e454cb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465713} {:answer/id #uuid "b5e2376b-22de-5207-8959-882360f31747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465714}] :answer-field/correct {:answer/id #uuid "b5e2376b-22de-5207-8959-882360f31747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465714} :answer-field/id #uuid "9a9244d4-ca29-5b09-ad60-1f882ad66970" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{cos}⁡2x)\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466700} {:answer-field/choices [{:answer/id #uuid "0c75b4b6-2e79-52bd-a819-8ed4e83fe956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465715} {:answer/id #uuid "e095a3ae-0bbe-5338-98a3-f4b4bf7e6dc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465716}] :answer-field/correct {:answer/id #uuid "0c75b4b6-2e79-52bd-a819-8ed4e83fe956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465715} :answer-field/id #uuid "b765a2fa-7d98-5023-a0f1-a961bd05dc4d" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(-\\operatorna