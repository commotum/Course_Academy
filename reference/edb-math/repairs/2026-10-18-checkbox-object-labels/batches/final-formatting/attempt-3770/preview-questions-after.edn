d #edb/ref 17592186466458}] :answer-field/correct {:answer/id #uuid "04e7c66e-3dd0-5238-8ec1-1b2246e0f48b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466458} :answer-field/id #uuid "6f15a0c4-822f-5557-a3f4-7905772d9cb5" :answer-field/key "$x{y}^{″}+{y}^{′}-3y$ $={e}^{x},$ $\\,y(1)$ $=0,$ $\\,{y}^{′}(1)$ $=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467072}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99d74bf8-bcac-5e65-b877-61e885b1b024" :question/math-academy-id "q-339254" :question/problem "Which of the following systems is an initial value problem?\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not an initial value problem.  It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=-1$ and $x=2$). This is a **boundary value problem.**\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)."} {:db/id #edb/ref 17592186317380 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048337 :topic/id #uuid "96874e3b-8b97-5c33-995d-d34a9d3daf21" :topic/math-academy-id 4077 :topic/title "Subspa