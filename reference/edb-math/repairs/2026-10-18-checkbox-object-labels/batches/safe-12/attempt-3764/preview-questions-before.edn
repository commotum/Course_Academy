:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474331}] :answer-field/correct {:answer/id #uuid "7f0d690b-a2af-51f1-908f-dcffce79cd11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474330} :answer-field/id #uuid "619d29e9-1652-56eb-a3ec-9f5d3d435236" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475091}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2757e05-6aab-58ae-aed8-77516507381e" :question/math-academy-id "q-132392" :question/problem "Which of the following numbers are divisible by $9?$\n\nI. $34\\,154\\,119$\n\nII. $9\\,173\\,589$\n\nIII. $733\\,123$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A number is divisible by $9$ if the sum of its digits is divisible by $9.$\n\n- The sum of the digits of $34\\,154\\,119$ is\n\n$$\n3+4+1+5+4+1+1+9=28,\n$$\n\nwhich is *not* divisible by $9.$ So, $34\\,154\\,119$ is *not* divisible by $9.$\n\n- The sum of the digits of $9\\,173\\,589$ is\n\n$$\n9+1+7+3+5+8+9=42,\n$$\n\nwhich is *not* divisible by $9.$ So, $9\\,173\\,589$ is *not* divisible by $9.$\n\n- The sum of the digits of $733\\,123$ is\n\n$$\n7+3+3+1+2+3=19,\n$$\n\nwhich is *not* divisible by $9.$ So, $733\\,123$ is *not* divisible by $9.$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186432795 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7" :topic/_knowledge-points [{:db/id #edb/ref 17592186050318 :topic/id #uuid "3f7c8941-2bc1-5431-84b6-f34e556ea057" :topic/math-academy-id 3543 :topic/title "Divisibility of Integers by 3, 9, 6, and 7"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01d64aae-b4bb-5dea-a20a-c665725ead2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474720} {:answer/id #uuid "f191222d-9f7f-5024-a520-ff1d65b86880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474721}] :answer-field/correct {:answer/id #uuid "f191222d-9f7f-5024-a520-ff1d65b86880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474721} :answer-field/id #uuid "def74a04-8990-5db1-a5a1-8d1583c0ca04" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475286} {:answer-field/choices [{:answer/id #uuid "5478d6ca-d740-542a-b41d-63ed73f5fefa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474722} {:answer/id #uuid "6c1d51b2-5f4c-52ee-9581-31b9418eced1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474723}] :answer-field/correct {:answer/id #uuid "5478d6ca-d740-542a-b41d-63ed73f5fefa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474722} :answer-field/id #uuid "5df53844-a158-5d95-ab51-8edd45f16998" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475287} {:answer-field/choices [{:answer/id #uuid "f9ceea81-d289-51c6-932d-fc71211851b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474724} {:answer/id #uuid "2d27c2f6-fd90-5b6b-bfdf-c5d81844d667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474725}] :answer-field/correct {:answer/id #uuid "2d27c2f6-fd90-5b6b-bfdf-c5d81844d667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474725} :answer-field/id #uuid "1a093a01-05c2-5489-916c-e7d8540f516c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475288}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0e5ee54-f96c-54ab-8de5-f272c76ac6c8" :question/math-academy-id "q-223365" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $448$\n\nII. $352$\n\nIII. $217$\n\nSelect all that apply." :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $448,$ we have that \n\n$$\n44-2(8)=44-16=28\n$$\n\nwhich is divisible by $7.$ Therefore, $448$ is divisible by $7.$\n\n- For the number $352,$ we have that \n\n$$\n35-2(2)=35-4=31\n$$\n\nwhich is not divisible by $7.$ Therefore, $352$ is not divisible by $7.$\n\n- For the number $217,$ we have that \n\n$$\n21-2(7)=21-14=7\n$$\n\nwhich is divisible by $7.$ Therefore, $217$ is divisible by $7.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186432796 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7" :topic/_knowledge-points [{:db/id #edb/ref 17592186050318 :topic/id #uuid "3f7c8941-2bc1-5431-84b6-f34e556ea057" :topic/math-academy-id 3543 :topic/title "Divisibility of Integers by 3, 9, 6, and 7"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9121cec7-c707-581d-8d65-e6975e317841" :answer/type {:db/id #edb/ref 17592186045499 :db/i