wer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474856} {:answer/id #uuid "08f18c4b-260e-5eb6-893a-75c1e31e1d07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474857}] :answer-field/correct {:answer/id #uuid "08f18c4b-260e-5eb6-893a-75c1e31e1d07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474857} :answer-field/id #uuid "a35350cb-e643-5d6d-987f-e134ab0a8525" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bbee0aa-5b29-5213-8656-a4a447aaa279" :question/math-academy-id "q-75552" :question/problem "Which of the following is a variable?\n\nI. $3$\n\nII. $1-x$\n\nIII. $y$\n\nSelect all that apply." :question/worked-solution "Let's look at each one in turn.\n\nI. $3$ is a number, not a variable.\n\nII. $1-x$ is an algebraic expression, not a variable.\n\nIII. $y$ is a variable because it's a single letter by itself.\n\nSo, only choice III represents a variable."} {:db/id #edb/ref 17592186424982 :knowledge-point/_questions [{:db/id #edb/ref 17592186054799 :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/title "Identifying Variables" :topic/_knowledge-points [{:db/id #edb/ref 17592186050618 :topic/id #uuid "598e4586-378e-5300-9abe-bbb9ded2ad77" :topic/math-academy-id 63 :topic/title "Introduction to Algebraic Expressions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1091c3c9-831b-59c1-899b-dedcfe750110" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474858} {:answer/id #uuid "28949e6c-d506-50b7-bb16-7942f4f18dc7" :answer/type