6408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473961} {:answer-field/choices [{:answer/id #uuid "c2322edf-ee14-5f20-8831-ec7cadfc1dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473134} {:answer/id #uuid "d8ca5be3-1fbc-5f41-bcbb-41b53ef5da56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473135}] :answer-field/correct {:answer/id #uuid "d8ca5be3-1fbc-5f41-bcbb-41b53ef5da56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473135} :answer-field/id #uuid "873d7824-ac7f-5ce0-ad45-49263a39fd15" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d883981-f066-5218-a1bf-dd76574de46e" :question/math-academy-id "q-42469" :question/problem "$$\nA=\\begin{bmatrix}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n- **I.** $A$ has proportional columns\n- **II.** $A$ has identical rows\n- **III.** $A$ has a zero row\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=\\begin{bmatrix}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{bmatrix}\\,✓\n$$\n\n- $A$ does *not* have identical rows.\n\n- $A$ has a zero row: \n\n$$\nA=\\begin{bmatrix}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/mat