type/text} :answer/value "true" :db/id #edb/ref 17592186474941}] :answer-field/correct {:answer/id #uuid "9c102a97-56e2-599a-84df-d20a3f9f5a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474941} :answer-field/id #uuid "e609c677-e2a8-5cda-9764-1405b6e85e62" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66ca27c6-8cac-5ac3-b80e-6fd1dcb7b6a5" :question/math-academy-id "q-85424" :question/problem "Which digits, when inserted into the blank, make the number $591\\,030\\,47◻$ divisible by $6?$\n\nI. $2$\n\nII. $5$\n\nIII. $4$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n5+9+1+0+3+0+4+7+◻=29+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $2$ into the blank, we get $591\\,030\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $29+2=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $5$ into the blank, we get $591\\,030\\,475,$ which is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- If we substitute $4$ into the blank, we get $591\\,030\\,474,$ which is divisible by $2.$ The sum of the digits is $29+4=33,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186432787 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7" :topic/_knowledge-points [{:db/id #edb/ref 17592186050318 :topic/id #uuid "3f7c8941-2bc1-5431-84b6-f34e556ea057" :topic/math-academy-id 3543 :topic/title "Divisibility of Integers by 3, 9, 6, and 7"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297df35f-e065-50a4-a888-680ae0d69b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474732} {:answer/id #uuid "aa96fa2f-53e6-5a3c-a179-ee3fb5c6cfbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474733}] :answer-field/correct {:answer/id #uuid "aa96fa2f-53e6-5a3c-a179-ee3fb5c6cfbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474733} :answer-field/id #uuid "d5282cdc-0784-5534-92bc-f6b79006d949" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475292} {:answer-field/choices [{:answer/id #uuid "e105e232-7b31-5374-8bbb-3fface90df32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474734} {:answer/id #uuid "65a97dbd-f8ff-57ae-a2dd-21160d5cd783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474735}] :answer-field/correct {:answer/id #uuid "e105e232-7b31-5374-8bbb-3fface90df32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474734} :answer-field/id #uuid "ce78228c-506d-51cc-af6c-7bb332d49800" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475293} {:answer-field/choices [{:answer/id #uuid "840e138b-34dd-5430-8842-ed13b7bb18b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474736} {:answer/id #uuid "21f4d4a0-12cf-5ea3-bfae-ec8a74f56745" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474737}] :answer-field/correct {:answer/id #uuid "840e138b-34dd-5430-8842-ed13b7bb18b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474736} :answer-field/id #uuid "a94010a1-4686-5e5c-9995-109721e74235" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475294}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6daa78eb-7b75-5f11-9d14-72a95f4ad0c2" :question/math-academy-id "q-223454" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $434$\n\nII. $785$\n\nIII. $587$\n\nSelect all that apply." :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $434,$ we have that \n\n$$\n43-2(4)=43-8=35\n$$\n\nwhich is divisible by $7.$ Therefore, $434$ is divisible by $7.$\n\n- For the number $785,$ we have that \n\n$$\n78-2(5)=78-10=68\n$$\n\nwhich is not divisible by $7.$ Therefore, $785$ is not divisible by $7.$\n\n- For the number $587,$ we have that \n\n$$\n58-2(7)=58-14=44\n$$\n\nwhich is not divisible by $7.$ Therefore, $587$ is not divisible by $7.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186432788 :knowledge-point/_questions [{:db/id #edb/ref 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9" :topic/_know