2186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474707} :answer-field/id #uuid "b97d107f-11ec-588d-8c72-df0e99d81ee5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475279}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "22db406c-85ef-5a5a-ab22-d062645b4362" :question/math-academy-id "q-221718" :question/problem "Consider the equivalence relation $∼$ on $Z,$ defined by $x∼y$ if $7\\,|\\,(x-y).$ Which of the following are in the equivalence class $[5]?$\n\nI. $12$\n\nII. $-4$\n\nIII. $-2$\n\nSelect all that apply." :question/worked-solution "The equivalence class $[5]$ consists of the elements that are equivalent to $5$ under the given equivalence relation. So, we have\n\n$$\n\\begin{aligned}[5] & ={x\\in Z\\,:\\,x∼5} \\\\  & ={x\\in Z\\,:\\,7\\,|\\,(x-5)} \\\\  & ={x\\in Z\\,:\\,x=5+7k,k\\in Z} \\\\  & ={…,-9,-2,5,12,19,…}.\\end{aligned}\n$$\n\nWe see that $12$ and $-2$ are in $[5],$ while $-4$ is not.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186421718 :knowledge-point/_questions [{:db/id #edb/ref 17592186152256 :knowledge-point/id #uuid "3601ac83-0800-567a-9a0d-4d5c37cef413" :knowledge-point/title "Identifying Elements Belonging to an Equivalence Class" :topic/_knowledge-points [{:db/id #edb/ref 17592186049702 :topic/id #uuid "0cbdba81-6911-563b-9935-b7f4c99e46ed" :topic/math-academy-id 2642 :topic/title "Equivalence Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e7b59c-00d2-51c6-999a-36e8f035e54a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474876} {:answer/id #uuid "94a4b4c3-a5b5-5d59-ad59-8d61401ea0b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474877}