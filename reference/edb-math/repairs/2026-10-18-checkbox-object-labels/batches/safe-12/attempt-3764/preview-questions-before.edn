b/id #edb/ref 17592186475366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c1db003-08b1-562e-8980-51389652bb7b" :question/math-academy-id "q-77205" :question/problem "Consider the equivalence relation $∼$ on $C,$ defined by $x∼y$ if ${x}^{2}={y}^{2}.$ Which of the following are in the equivalence class $[-4]?$\n\nI. $-4$\n\nII. $4$\n\nIII. $4\\text{i}$\n\nSelect all that apply." :question/worked-solution "The equivalence class $[-4]$ consists of the elements that are equivalent to $-4$ under the given equivalence relation. So, we have\n\n$$\n\\begin{aligned}[-4] & ={x\\in C\\,|\\,x∼-4} \\\\  & ={x\\in C\\,|\\,{x}^{2}=(-4)^{2}} \\\\  & ={x\\in C\\,|\\,{x}^{2}=16} \\\\  & ={-4,4}.\\end{aligned}\n$$\n\nWe see that $-4$ and $4$ are in $[-4],$ while $4\\text{i}$ is not.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186421719 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049702 :topic/id #uuid "0cbdba81-6911-563b-9935-b7f4c99e46ed" :topic/math-academy-id 2642 :topic/title "Equivalence Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62a4bb57-5969-52de-b010-ca21fe9a6007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474714} {:answer/id #uuid "c172fb65-6319-5c94-8438-618f08c71003" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474715}] :answer-field/correct {:answer/id #uuid "62a4bb57-5969-52de-b010-ca21fe9a6007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474714} :answer-field/id #uuid "48c6e22c-1de1-5dae-b9d0-54dcf023b85d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475283} {:answer-field/choices [{:answer/id #uuid "f1dbd89d-4f75-5e11-ae6a-1bc1e6fdafbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474716} {:answer/id #uuid "a41ed67c-b2ca-5b04-b944-70698eb1053c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474717}] :answer-field/correct {:answer/id #uuid "a41ed67c-b2ca-5b04-b944-70698eb1053c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474717} :answer-field/id #uuid "d718270d-232d-5945-ba4d-adf3b623e262" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475284} {:answer-field/choices [{:answer/id #uuid "26f18044-35d9-5b52-afe3-1a1c0f99fdcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474718} {:answer/id #uuid "e7988608-d68e-5f59-bddd-b768195a59fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474719}] :answer-field/correct {:answer/id #uuid "26f18044-35d9-5b52-afe3-1a1c0f99fdcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474718} :answer-field/id #uuid "b6533f41-d016-573d-aa27-6228e0a41929" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46852a07-1e77-54f8-9037-1f17a12c391f" :question/math-academy-id "q-221767" :question/problem "Consider the equivalence relation $∼$ on $R,$ defined by $x∼y$ if $\\operatorname{cos}⁡\\pi x=\\operatorname{cos}⁡\\pi y.$ Which of the following equivalence classes contain the element $3$\n\nI. $[0]$\n\nII. $[1]$\n\nIII. $[2]$\n\nSelect all that apply." :question/worked-solution "We have $3\\in [x]$ if $3∼x.$ Using the definition of the given equivalence relation, we require\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\pi \\cdot 3 & =\\operatorname{cos}⁡\\pi x \\\\ \\operatorname{cos}⁡3\\pi  & =\\operatorname{cos}⁡\\pi x \\\\ -1 & =\\operatorname{cos}⁡\\pi x \\\\ \\operatorname{cos}⁡\\pi x & =-1.\\end{aligned}\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $3\\notin [0]$ because $\\operatorname{cos}⁡(\\pi \\cdot 0)=1\\ne -1\\,\\times $\n\n- $3\\in [1]$ because $\\operatorname{cos}⁡(\\pi \\cdot 1)=-1\\,✓$\n\n- $3\\notin [2]$ because $\\operatorname{cos}⁡(\\pi \\cdot 2)=1\\ne -1\\,\\times $\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186421721 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049702 :topic/id #uuid "0cbdba81-6911-563b-9935-b7f4c99e46ed" :topic/math-academy-id 2642 :topic/title "Equivalence Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27afc98a-a963-5726-801e-f24814932ffc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474708} {:answer/id #uuid "cd9b592b-a126-5e98-882f-fa6560baf569" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474709}] :answer-field/correct {:answer/id #uuid "cd9b592b-a126-5e98-882f-fa6560baf569" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474709} 