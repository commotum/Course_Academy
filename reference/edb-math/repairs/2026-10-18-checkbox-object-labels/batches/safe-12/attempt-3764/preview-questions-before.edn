592186453298} {:answer/id #uuid "a622ca61-c74d-526d-a675-f91fa6ed458a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453299}] :answer-field/correct {:answer/id #uuid "a622ca61-c74d-526d-a675-f91fa6ed458a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453299} :answer-field/id #uuid "52acd980-54ed-5661-a99d-d100f4fdb7da" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454399}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9350880-d00e-5d41-adb3-52fc6c8e0846" :question/math-academy-id "q-113664" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-5≡8\\,(\\text{mod}\\,7)$\n- **II.** $-23≡-5\\,(\\text{mod}\\,6)$\n- **III.** $-7≡-1\\,(\\text{mod}\\,2)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-5-8).$ Notice that $-5-8=-13,$ which is not divisible by $7.$\n\n- Statement II is true because $6∣(-23-(-5)).$ There is no remainder:\n\n$$\n(-23-(-5))÷6=-18÷6=-3\n$$\n\n- Statement III is true because $2\\,|\\,(-7-(-1)).$ There is no remainder:\n\n$$\n(-7-(-1))÷2=-6÷2=-3\n$$\n\nTherefore, the correct answer is \"II and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"} :activity/title "Modular Congruence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419602} :db/id #edb/ref 17592186419642}]} {:db/id #edb/ref 17592186419637 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers" :topic/_knowledge-points [{:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fea04ad-6301-5338-84cb-8e7183ec38b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453300} {:answer/id #uuid "244b0170-04cf-576a-a359-8e6fba1609a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453301}] :answer-field/correct {:answer/id #uuid "5fea04ad-6301-5338-84cb-8e7183ec38b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453300} :answer-field/id #uuid "294256a8-04dd-5480-bd9a-025d2d07c052" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454400} {:answer-field/choices [{:answer/id #uuid "2ce7da18-5976-54f4-853e-11cd748582b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453302} {:answer/id #uuid "d63a67dc-af8b-597d-8d04-bea8356b228f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453303}] :answer-field/correct {:answer/id #uuid "2ce7da18-5976-54f4-853e-11cd748582b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453302} :answer-field/id #uuid "831851a3-f614-56ed-a446-b0ef1f20f1be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454401} {:answer-field/choices [{:answer/id #uuid "f172228e-e7ef-5590-9ed8-ef46152687d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453304} {:answer/id #uuid "dc4882f8-d7db-52e7-a801-2733051a47c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453305}] :answer-field/correct {:answer/id #uuid "dc4882f8-d7db-52e7-a801-2733051a47c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453305} :answer-field/id #uuid "236f2576-4c98-5799-8b90-5d928320dac1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454402}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee3460a5-a9ce-5793-8247-ccd3db242273" :question/math-academy-id "q-113675" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-36≡-19\\,(\\text{mod}\\,7)$\n- **II.** $15≡-26\\,(\\text{mod}\\,10)$\n- **III.** $-27≡9\\,(\\text{mod}\\,4)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-36-(-19)).$ Notice that $-36-(-19)=-17,$ which is not divisible by $7.$\n\n- Statement II is false because $10∤(15-(-26)).$ Notice that $15-(-26)=41,$ which is not divisible by $10.$\n\n- Statement III is true because $4\\,|\\,(-27-9).$ There is no remainder:\n\n$$\n(-27-9)÷4=-36÷4=-9\n$$\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641 :topic/title "Modular Congruence"} :activity/title "Modular Congruence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419602} :db/id #edb/ref 17592186419638}]} {:db/id #edb/ref 17592186419686 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases" :topic/_knowledge-points [{:db/id #edb/ref 17592186050324 :topic/id #uuid "3ffd42a4-cf3d-5ec4-9be0-19d427299cac" :topic/math-academy-id 2014 :topic/title "Connections Between Matrix Representations of a Linear Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573ba886-20ef-53c9-9024-a795a327b2ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454244} {:answer/id #uuid "75fa156d-1a39-536a-ab92-cd46c3d568a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454245}] :answer-field/correct {:answer/id #uuid "75fa156d-1a39-536a-ab92-cd46c3d568a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454245} :answer-field/id #uuid "6c352d4a-a883-55eb-8913-4568682a7132" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454872} {:answer-field/choices [{:answer/id #uuid "a493b3a0-15e1-540d-9b9a-49e179799c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454246} {:answer/id #uuid "6b0b13f5-b674-5518-b581-93c06913cf58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454247}] :answer-field/correct {:answer/id #uuid "a493b3a0-15e1-540d-9b9a-49e179799c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454246} :answer-field/id #uuid "139440a5-d4e1-5ab8-ba4c-c3d86f2c0c74" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454873} {:answer-field/choices [{:answer/id #uuid "41af9a8e-a9d1-5b00-b3e8-b95a4c022fcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454248} {:answer/id #uuid "3a437d50-f3c9-5ac5-8e9a-de9b7e0b61f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454249}] :answer-field/correct {:answer/id #uuid "3a437d50-f3c9-5ac5-8e9a-de9b7e0b61f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454249} :answer-field/id #uuid "08c42cdc-f60a-5dff-99c5-7c1367615b5d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454874}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e737a421-d643-51f0-9d67-b9556fcc15c6" :question/math-academy-id "q-97060" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$\n- **II.** $[T]_{C}={P}_{B\\to C}^{-1}\\cdot [T]_{B}\\cdot {P}_{B\\to C}$\n- **III.** $[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050324 :topic/id #uuid "3ffd42a4-cf3d-5ec4-9be0-19d427299cac" :topic/math-academy-id 2014 :topic/title "Connections Between Matrix Representations of a Linear Transformation"} :activity/title "Connections Between Matrix Representations of a Linear Transformation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419658} :db/id #edb/ref 17592186419690}]} {:db/id #edb/ref 17592186420071 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048604 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080 :topic/title "Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c2f8bfc-8a2b-5c27-8a60-ea04aa4bdc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453806} {:answer/id #uuid "999777ab-3743-55c2-a473-e80ef89adb78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453807}] :answer-field/correct {:answer/id #uuid "4c2f8bfc-8a2b-5c27-8a60-ea04aa4bdc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453806} :answer-field/id #uuid "782c3be1-ac75-5aa2-b432-a55b29c6fd04" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454653} {:answer-field/choices [{:answer/id #uuid "fcbbbb8b-969a-59eb-ad64-12cbd15b1875" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453808} {:answer/id #uuid "817d5feb-1d83-5247-bbc1-274b57d7c67d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453809}] :answer-field/correct {:answer/id #uuid "817d5feb-1d83-5247-bbc1-274b57d7c67d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453809} :answer-field/id #uuid "60099b3d-b168-5c08-9592-0c6035c14b35" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454654} {:answer-field/choices [{:answer/id #uuid "5ad412ec-4d05-534c-98e0-999e777f75f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453810} {:answer/id #uuid "f0567f6e-4237-5109-82cc-40dfbc24f6ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453811}] :answer-field/correct {:answer/id #uuid "5ad412ec-4d05-534c-98e0-999e777f75f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453810} :answer-field/id #uuid "8d462da8-c335-5522-ab67-992c40543616" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454655}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48fbd1ea-16f2-572a-98a1-c1983af51b24" :question/math-academy-id "q-221923" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\nSelect all that apply.\n\n- **I.** $3∣(14x+21y)$\n- **II.** $7∣(14x+21y)$\n- **III.** $4∣(14x+21y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \n\nWith that in mind, let's examine our statement in turn.\n\n- Statement I is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $3.$\n\n- Statement II is true. Notice that \n\n$$\n14x+21y=7(2x+3y).\n$$\n\nSince $x$ and $y$ are integers, $2x+3y$ must be an integer, too. So, $7∣(14x+21y).$\n\n- Statement III is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048604 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080 :topic/title "Integer Divisibility"} :activity/title "Integer Divisibility" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420027} :db/id #edb/ref 17592186420074}]} {:db/id #edb/ref 17592186420072 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048604 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080 :topic/title "Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a14c4a6-d210-5dd4-9ce2-f9ed55f64943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453830} {:answer/id #uuid "287bceee-04d3-509d-acda-bcc302b3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453831}] :answer-field/correct {:answer/id #uuid "287bceee-04d3-509d-acda-bcc302b3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453831} :answer-field/id #uuid "f65bdc06-29ae-5226-b267-6fdc35815932" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454665} {:answer-field/choices [{:answer/id #uuid "6dcb7a7e-04a6-5748-90a8-7d2a33acd246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453832} {:answer/id #uuid "4905546e-c0ac-5cb3-afe1-6534073d8055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453833}] :answer-field/correct {:answer/id #uuid "4905546e-c0ac-5cb3-afe1-6534073d8055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453833} :answer-field/id #uuid "0638118a-1557-568f-9f04-35cd1542f5a3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454666} {:answer-field/choices [{:answer/id #uuid "5e78ce48-c819-5bbc-bd9f-602a454f17b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453834} {:answer/id #uuid "76454f66-2d6e-5f8a-85c0-8183da34db1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453835}] :answer-field/correct {:answer/id #uuid "5e78ce48-c819-5bbc-bd9f-602a454f17b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453834} :answer-field/id #uuid "00285ea7-c2b8-59c7-a9e9-3de805e315c4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63936aa1-e722-5014-a82a-6fe76f4b851d" :question/math-academy-id "q-221929" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\nSelect all that apply.\n\n- **I.** $2$ divides $(6x-18y)$\n- **II.** $3$ divides $(6x-18y)$\n- **III.** $5$ divides $(6x-18y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \nWith that in mind, let's examine our statement in turn.\n\n- Statement I is true. Notice that \n\n$$\n6x-18y=2(3x-9y).\n$$\n\nSince $x$ and $y$ are integers, $3x-9y$ must be an integer, too. So, $2$ divides $(6x-18y).$\n\n- Statement II is true. Notice that \n\n$$\n6x-18y=3(2x-6y).\n$$\n\nSince $x$ and $y$ are integers, $2x-6y$ must be an integer, too. So, $3$ divides $(6x-18y).$\n\n- Statement III is false. For example, if $x=2$ and $y=1,$ we have $6(2)-18(1)=-6,$ which is not divisible by $5.$\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048604 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080 :topic/title "Integer Divisibility"} :activity/title "Integer Divisibility" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420027} :db/id #edb/ref 17592186420078}]} {:db/id #edb/ref 17592186420105 :knowledge-point/_questions [{:db/id #edb/ref 17592186092223 :knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees" :topic/_knowledge-points [{:db/id #edb/ref 17592186048712 :topic/id #uuid "b784cbd9-6f0d-5689-9a0e-6e19dfca34c7" :topic/math-academy-id 931 :topic/title "Right-Angle Rotations as Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c4d9e7-fcc1-51cb-9feb-d14eed398feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472754} {:answer/id #uuid "48e4a354-249b-5ba2-9117-b2967ef925f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472755}] :answer-field/correct {:answer/id #uuid "48e4a354-249b-5ba2-9117-b2967ef925f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472755} :answer-field/id #uuid "dd5de993-b98b-510c-aca5-b262d4fe57ab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473772} {:answer-field/choices [{:answer/id #uuid "2776862c-c124-5cdd-a3a8-95305ed05171" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472756} {:answer/id #uuid "ff8c4bf0-30a7-5205-a922-7ff4168cd4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472757}] :answer-field/correct {:answer/id #uuid "2776862c-c124-5cdd-a3a8-95305ed05171" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472756} :answer-field/id #uuid "7496452b-de20-5cb6-96eb-ad9d02d388c8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473773} {:answer-field/choices [{:answer/id #uuid "4b9e0b92-1b40-59a0-a102-0725a2933668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472758} {:answer/id #uuid "685a4b07-2685-5bcc-833d-6284d65a3096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472759}] :answer-field/correct {:answer/id #uuid "685a4b07-2685-5bcc-833d-6284d65a3096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472759} :answer-field/id #uuid "869b058e-5f7d-52b3-ba22-dde49434dad4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473774}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "08bf8696-2d24-58a9-b5b4-856286859054" :question/math-academy-id "q-160646" :question/problem "A triangle $S$ has vertices at  $(-1,3),(-2,2),(1,-4).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{90}^{∘}}$ by an angle of ${90}^{∘}$ about the origin?\n- **I.** $(3,1)$\n- **II.** $(2,-2)$\n- **III.** $(-4,-1)$\n\nSelect all that apply." :question/worked-solution "The clockwise rotation ${R}_{-{90}^{∘}}$ by an angle of ${90}^{∘}$ is the same as counterclockwise rotation by an angle of ${270}^{∘}.$ It's given by the matrix\n\n$$\nR=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{90}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}-1 & -2 & 1 \\\\ 3 & 2 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{90}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}-1 & -2 & 1 \\\\ 3 & 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 2 & -4 \\\\ 1 & 2 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(3,1),(2,2),(-4,-1).$\n\nSo, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186420258 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a19b88d-f0d3-5ce1-a354-e16dd44157c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453800} {:answer/id #uuid "0b541dca-6c1b-51ea-8ff8-8e8c09c289b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453801}] :answer-field/correct {:answer/id #uuid "7a19b88d-f0d3-5ce1-a354-e16dd44157c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453800} :answer-field/id #uuid "a1b4e2c7-01ac-5098-b14e-68597e290a8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454650} {:answer-field/choices [{:answer/id #uuid "78cf09bc-6b7f-591c-abaf-c9751546fdb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453802} {:answer/id #uuid "ddeb9d9e-70bb-5940-bdfd-2a3d6e2e6eeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453803}] :answer-field/correct {:answer/id #uuid "ddeb9d9e-70bb-5940-bdfd-2a3d6e2e6eeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453803} :answer-field/id #uuid "b8c07ba5-b2aa-5743-8686-116a9dcce74f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454651} {:answer-field/choices [{:answer/id #uuid "f827277c-b111-5abf-97a9-9696bb10ca2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453804} {:answer/id #uuid "e0e904d9-1ffd-59fc-8e5a-55e88cc383fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453805}] :answer-field/correct {:answer/id #uuid "e0e904d9-1ffd-59fc-8e5a-55e88cc383fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453805} :answer-field/id #uuid "9aee165a-37d1-5d6a-ac3d-2a33ddf9b389" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454652}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24815c66-50ab-5aab-ac7b-25ddc673e132" :question/math-academy-id "q-221381" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $11∣k$ then $33∣k$\n\n- **II.** If $33∣k$ then $11∣k$\n\n- **III.** If $33∣k$ then $3∣k$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is false. As a counterexample, let $k=11.$ Then, $11∣11$ but $33∤11.$\n\n- Statement II is true. First, note that $11∣33.$ Therefore, we have\n$11∣33$ and $33∣k,$ which implies that $11∣k.$\n\n- Statement III is true. First, note that $3∣33.$ Therefore, we have\n$3∣33$ and $33∣k,$ which implies that $3∣k.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186420260 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af754b47-d4e5-5fdc-8bd2-d6344c3485f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454108} {:answer/id #uuid "20675c10-e23b-542e-8faa-3a28254d9e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454109}] :answer-field/correct {:answer/id #uuid "20675c10-e23b-542e-8faa-3a28254d9e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454109} :answer-field/id #uuid "e07d4f8b-55b6-5aab-b645-ac6b2ab28954" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454804} {:answer-field/choices [{:answer/id #uuid "7366dfaa-c59f-53f8-9c22-adfa0d5da165" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454110} {:answer/id #uuid "b9dda14e-0c1b-50ef-9d7b-3b7da9a958ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454111}] :answer-field/correct {:answer/id #uuid "b9dda14e-0c1b-50ef-9d7b-3b7da9a958ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454111} :answer-field/id #uuid "52e80153-dfde-514d-9bca-409913cc19fb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454805} {:answer-field/choices [{:answer/id #uuid "933f0836-d1bf-5067-a251-88602fe68e54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454112} {:answer/id #uuid "a54ed7bb-eae7-5c80-b6d8-e0ca1356ae7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454113}] :answer-field/correct {:answer/id #uuid "933f0836-d1bf-5067-a251-88602fe68e54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454112} :answer-field/id #uuid "4fa5cf00-ada4-5c14-974f-fda0ade37b37" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42a248b1-4b2a-5a7f-b673-589ac28da9a8" :question/math-academy-id "q-93649" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $10\\,|\\,21b$ then $10\\,|\\,b$\n\n- **II.** If $21\\,|\\,25b$ then $21\\,|\\,b$\n\n- **III.** If $15\\,|\\,9b$ then $15\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(10,21)=1.$ Therefore, we have $10\\,|\\,21b$ and $\\text{gcd}(10,21)=1,$ which implies $10\\,|\\,b.$\n\n- Statement II is true. First, note that $\\text{gcd}(21,25)=1.$ Therefore, we have $21\\,|\\,25b$ and $\\text{gcd}(21,25)=1,$ which implies $21\\,|\\,b.$\n\n- Statement III is false. As a counterexample, let $b=5.$ Then, $15∣9\\cdot 5$ but $15∤5.$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186420261 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "def3d752-65f1-5731-b05f-edd7c88aec7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454114} {:answer/id #uuid "d915cf80-9790-525d-89fc-8e8a3da1a8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454115}] :answer-field/correct {:answer/id #uuid "def3d752-65f1-5731-b05f-edd7c88aec7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454114} :answer-field/id #uuid "334729c1-cb5a-5475-9dea-97ecb5445f59" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454807} {:answer-field/choices [{:answer/id #uuid "975a5231-8c85-5465-bad9-ae972d8cf69f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454116} {:answer/id #uuid "b61fa41d-4780-51db-95c8-9c1d84982a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454117}] :answer-field/correct {:answer/id #uuid "b61fa41d-4780-51db-95c8-9c1d84982a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454117} :answer-field/id #uuid "0b5db846-64da-5dd5-8276-1cccfb9bfcfb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454808} {:answer-field/choices [{:answer/id #uuid "b1521e88-f7fe-5024-9ad1-4e80a1f3ef2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454118} {:answer/id #uuid "471b8f3e-0e11-5794-b4e9-d0565d0ed717" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454119}] :answer-field/correct {:answer/id #uuid "471b8f3e-0e11-5794-b4e9-d0565d0ed717" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454119} :answer-field/id #uuid "2ee8f5f6-b6e7-5ae4-8c2d-b577fba2c54a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454809}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "553ed68f-8e74-5dda-a8b3-cdd3e89c31cb" :question/math-academy-id "q-93650" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If ${19}^{2}\\,|\\,19b$ then ${19}^{2}\\,|\\,b$\n\n- **II.** If $12\\,|\\,35b$ then $12\\,|\\,b$\n\n- **III.** If $22\\,|\\,{7}^{2}b$ then $22\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is false. As a counterexample, let $b=19.$ Then, ${19}^{2}∣19\\cdot 19$ but ${19}^{2}∤19.$\n\n- Statement II is true. First, note that $\\text{gcd}(12,35)=1.$ Therefore, we have $12\\,|\\,35b$ and $\\text{gcd}(12,35)=1,$ which implies $12\\,|\\,b.$\n\n- Statement III is true. First, note that $\\text{gcd}(22,{7}^{2})=1.$ Therefore, we have $22\\,|\\,{7}^{2}b$ and $\\text{gcd}(22,{7}^{2})=1,$ which implies $22\\,|\\,b.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186420262 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73bcb4b0-570c-5336-ae48-d0a3104dce91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454120} {:answer/id #uuid "d1c56f0f-ebe8-5bcc-ab39-2214650c58a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454121}] :answer-field/correct {:answer/id #uuid "d1c56f0f-ebe8-5bcc-ab39-2214650c58a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454121} :answer-field/id #uuid "54b20b3a-0759-5c20-9cc3-7b20438b436c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454810} {:answer-field/choices [{:answer/id #uuid "4daf1445-f4b8-5db6-b905-c837fed66207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454122} {:answer/id #uuid "d2222e06-b783-5847-8936-f4ecd2c0501f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454123}] :answer-field/correct {:answer/id #uuid "4daf1445-f4b8-5db6-b905-c837fed66207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454122} :answer-field/id #uuid "ad1b8ea2-b742-5284-a512-3d2941ba5283" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454811} {:answer-field/choices [{:answer/id #uuid "1df7369c-f888-585b-b5a0-51c050df8758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454124} {:answer/id #uuid "84ae4082-eeb0-54b9-8f03-f8d452322695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454125}] :answer-field/correct {:answer/id #uuid "84ae4082-eeb0-54b9-8f03-f8d452322695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454125} :answer-field/id #uuid "025dafa7-6607-51f9-8e1b-41f4d1f7008d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ddd359d-678b-53c8-9991-000fcf922944" :question/math-academy-id "q-93657" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $3\\,|\\,a$ and $2\\,|\\,a$ then $6\\,|\\,a$\n\n- **II.** If $7\\,|\\,b$ and $14\\,|\\,b$ then $98\\,|\\,b$\n\n- **III.** If ${2}^{3}\\,|\\,c$ and $3\\,|\\,c$ then $24\\,|\\,c$" :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(2,3)=1$ and $2\\cdot 3=6.$ Therefore, we have $(2\\,|\\,a),(3\\,|\\,a),$ and $\\text{gcd}(2,3)=1,$ which implies $(6\\,|\\,a).$\n\n- Statement II is false. As a counterexample, let $b=14.$ Then, $(7∣14)$ and $(14∣14),$ but $(98∤14).$\n\n- Statement III is true. First, note that $\\text{gcd}({2}^{3},3)=1$ and ${2}^{3}\\cdot 3=24.$ Therefore, we have $({2}^{3}\\,|\\,c),(3\\,|\\,c),$ and $\\text{gcd}({2}^{3},3)=1,$ which implies $(24\\,|\\,c).$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186420264 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e971550-afed-59da-9c00-b2572793e69d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454126} {:answer/id #uuid "ad9813ed-d5d9-523d-b081-2668d852fa1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454127}] :answer-field/correct {:answer/id #uuid "ad9813ed-d5d9-523d-b081-2668d852fa1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454127} :answer-field/id #uuid "e8189c37-e52b-5bae-a536-f2eb9672a785" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454813} {:answer-field/choices [{:answer/id #uuid "035e53a3-a6de-5d10-b8b2-bdce89b90466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454128} {:answer/id #uuid "934ae89c-1a1a-5389-af92-c23152ee7c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454129}] :answer-field/correct {:answer/id #uuid "934ae89c-1a1a-5389-af92-c23152ee7c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454129} :answer-field/id #uuid "70c93dc3-3af0-540d-9d04-a222f3f2bf34" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454814} {:answer-field/choices [{:answer/id #uuid "ef2efbec-ee42-5329-96fe-97e9248fd330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454130} {:answer/id #uuid "58adc57e-9bd7-589d-8e1c-4a3354aeed1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454131}] :answer-field/correct {:answer/id #uuid "ef2efbec-ee42-5329-96fe-97e9248fd330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454130} :answer-field/id #uuid "1cf2310a-22d8-5a6b-b36e-f907e424874e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d7153a0-178f-57d1-b332-d3ea8e076028" :question/math-academy-id "q-93658" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $4\\,|\\,a$ and $9\\,|\\,a$ then $36\\,|\\,a$\n\n- **II.** If $5\\,|\\,b$ and $7\\,|\\,b$ then $35\\,|\\,b$\n\n- **III.** If ${6}^{2}\\,|\\,c$ and $2\\,|\\,c$ then $72\\,|\\,c$" :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(4,9)=1$ and $4\\cdot 9=36.$ Therefore, we have $(4\\,|\\,a),(9\\,|\\,a),$ and $\\text{gcd}(4,9)=1,$ which implies $(36\\,|\\,a).$\n\n- Statement II is true. First, note that $\\text{gcd}(5,7)=1$ and $5\\cdot 7=35.$ Therefore, we have $(5\\,|\\,b),(7\\,|\\,b),$ and $\\text{gcd}(5,7)=1,$ which implies $(35\\,|\\,b).$\n\n- Statement III is false. As a counterexample, let $c=36.$ Then, $({6}^{2}∣36)$ and $(2∣36),$ but $(72∤36).$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186420265 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f311fe-31b2-5bb0-9024-4a1542c58b5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453794} {:answer/id #uuid "4b7a35b7-cd50-59b6-8cb6-a5d519fe2985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453795}] :answer-field/correct {:answer/id #uuid "4b7a35b7-cd50-59b6-8cb6-a5d519fe2985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453795} :answer-field/id #uuid "1779d8ec-8897-538a-9e78-6ce356268b33" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454647} {:answer-field/choices [{:answer/id #uuid "0170f81d-8cb2-5d63-b89e-313b3852372c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453796} {:answer/id #uuid "e6624e35-1287-54bb-aac2-5a914892c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453797}] :answer-field/correct {:answer/id #uuid "e6624e35-1287-54bb-aac2-5a914892c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453797} :answer-field/id #uuid "bcffcaa8-c3cf-5b50-b9f2-0085cba43a19" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454648} {:answer-field/choices [{:answer/id #uuid "8c1b5927-257c-5610-a08d-af3853d534a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453798} {:answer/id #uuid "3e540739-1a45-52b6-be9d-27d235244263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453799}] :answer-field/correct {:answer/id #uuid "8c1b5927-257c-5610-a08d-af3853d534a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453798} :answer-field/id #uuid "95dcbb32-4958-59b9-9b71-aef87e544a81" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454649}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73c135de-ad71-58aa-a780-c01d04341240" :question/math-academy-id "q-221379" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $12∣h$ then $4∣h$\n\n- **II.** If $4∣h$ then $2∣h$\n\n- **III.** If $3∣h$ then $12∣h$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $4∣12.$ Therefore, we have\n$4∣12$ and $12∣h,$ which implies that $4∣h.$\n\n- Statement II is true. First, note that $2∣4.$ Therefore, we have\n$2∣4$ and $4∣h,$ which implies that $2∣h.$\n\n- Statement III is false. As a counterexample, let $h=3.$ Then, $3∣3$ but $12∤3.$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186420269 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186050558 :topic/id #uuid "537a9014-df39-5285-bcbe-727d2aec6910" :topic/math-academy-id 4433 :topic/title "Properties of Integer Divisibility"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8701a912-ef68-5863-a5cf-1e029092f167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454102} {:answer/id #uuid "db9f8878-ded0-5bcb-9d41-9a3647d69fee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454103}] :answer-field/correct {:answer/id #uuid "db9f8878-ded0-5bcb-9d41-9a3647d69fee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454103} :answer-field/id #uuid "0ec63ad7-8480-580b-8832-9f3c4d1ce0ac" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454801} {:answer-field/choices [{:answer/id #uuid "06df3a3e-e9a7-5e3c-99e5-f2aeaa40e35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454104} {:answer/id #uuid "5ec7c826-456c-5eaf-ac54-507319f46a5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454105}] :answer-field/correct {:answer/id #uuid "06df3a3e-e9a7-5e3c-99e5-f2aeaa40e35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454104} :answer-field/id #uuid "84f1cf04-cf52-54c6-882b-230f7c6c2638" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454802} {:answer-field/choices [{:answer/id #uuid "a948fc10-5292-5a77-b044-770a048b0c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454106} {:answer/id #uuid "8b7f8828-83e5-5419-9e0e-116c56de2b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454107}] :answer-field/correct {:answer/id #uuid "8b7f8828-83e5-5419-9e0e-116c56de2b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454107} :answer-field/id #uuid "2f093a1f-da2a-5ae9-9856-84636d51def5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454803}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3b9fb7f-2262-5e34-bb97-3a915acfa755" :question/math-academy-id "q-93648" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$\n\n- **II.** If ${17}^{2}\\,|\\,17b$ then ${17}^{2}\\,|\\,b$\n\n- **III.** If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}({3}^{2},10)=1.$ Therefore, we have ${3}^{2}\\,|\\,10b$ and $\\text{gcd}({3}^{2},10)=1,$ which implies ${3}^{2}\\,|\\,b.$\n\n- Statement II is false. As a counterexample, let $b=17.$ Then, ${17}^{2}∣17\\cdot 17$ but ${17}^{2}∤17.$\n\n- Statement III is true. First, note that $\\text{gcd}(20,{3}^{3})=1.$ Therefore, we have $20\\,|\\,{3}^{3}b$ and $\\text{gcd}(20,{3}^{3})=1,$ which implies $20\\,|\\,b.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186420276 :knowledge-point/_questions [{:db/id #edb/ref 17592186161921 :knowledge-point/id #uuid "01ad9700-5aaa-5b00-8d2f-acce6ed59c9a" :knowledge-point/title "Functions Whose Codomain Is the Set of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186051069 :topic/id #uuid "7e5753ab-fcea-5d2f-ac49-4b475153e05c" :topic/math-academy-id 3027 :topic/title "Into Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982f653f-6cf3-53fc-8e56-92ef7d70036a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473016} {:answer/id #uuid "edcc72a5-120b-5ee1-97e7-fd2c98eb5894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473017}] :answer-field/correct {:answer/id #uuid "edcc72a5-120b-5ee1-97e7-fd2c98eb5894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473017} :answer-field/id #uuid "aaa6136d-b30b-56e8-bf30-53b61fc6705c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473903} {:answer-field/choices [{:answer/id #uuid "d7ee2327-d1e9-55df-aa68-0c11381e1802" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473018} {:answer/id #uuid "2feb2a73-5b5f-5e62-a646-b09fcd1fd29a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473019}] :answer-field/correct {:answer/id #uuid "2feb2a73-5b5f-5e62-a646-b09fcd1fd29a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473019} :answer-field/id #uuid "ddb77040-d533-5459-9ba9-3ae4efed3106" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473904} {:answer-field/choices [{:answer/id #uuid "4606e02b-20d0-5cfc-93eb-144ed9f379b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473020} {:answer/id #uuid "aeb21794-a922-514c-b6d9-2a4e071ad20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473021}] :answer-field/correct {:answer/id #uuid "aeb21794-a922-514c-b6d9-2a4e071ad20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473021} :answer-field/id #uuid "d26a451b-cb27-5bb6-a13a-9b40b67b59dd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba992cb2-fd2f-5e4c-b95b-b82e7bb29b58" :question/math-academy-id "q-232536" :question/problem "Which of the following statements are true regarding the function $f:R\\to R$ which is given by $f(x)={3}^{x}+1?$\n\nI. The range of $f$ is $(1,\\infty )$\n\nII. $∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$\n\nIII. $f$ maps $R$ **into** $R$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we graph the function.\n\n![](images/0c/0cb3e23cecdbd82803f5757827f21a424672bdde6da03782ca995d23e1c4d7b4.png)\n\nRecall that $f:X\\to Y$ is an *into* function if it is not a surjection. In other words, there exists an element $y$ in $Y$ such that it has no preimage in $X:$ \n\n$f:X\\to Y$ is an into function if $∃\\,y\\in Y$ such that $∀\\,x\\in X,$ we have $f(x)\\ne y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. From the graph, the function takes all $y$-values greater than $y=1$, excluding $y=1$ itself. So the range of the function is indeed $(1,\\infty ).$\n\n- Statement II is true. Since the range of the function is $(1,\\infty )$, then for all $y$ contained within $(1,\\infty ),$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement III is true. As we can see from the range, there is no real number $x$ such that $f(x)=0\\in R.$ So, $f$ maps $R$ *into* $R.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186420329 :knowledge-point/_questions [{:db/id #edb/ref 17592186198270 :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/title "Sets Defined Using Trigonometric Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6638e9b8-04e0-5e37-bf80-a24ed5e188f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472802} {:answer/id #uuid "25de8cfd-80d4-51ce-970b-b5efd1192ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472803}] :answer-field/correct {:answer/id #uuid "6638e9b8-04e0-5e37-bf80-a24ed5e188f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472802} :answer-field/id #uuid "65143bba-26d2-5f3f-98dc-e17f220901ed" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473796} {:answer-field/choices [{:answer/id #uuid "b7788d5b-3620-567a-877a-59267d8da9ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472804} {:answer/id #uuid "87e018bc-6d30-551d-ad07-f1a36379af55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472805}] :answer-field/correct {:answer/id #uuid "87e018bc-6d30-551d-ad07-f1a36379af55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472805} :answer-field/id #uuid "762f3115-b8a0-5b32-9a0b-09ead9bd286d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473797} {:answer-field/choices [{:answer/id #uuid "7c33f68a-a8a7-5bcf-ac0c-e8ae18ef5c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472806} {:answer/id #uuid "3993f4fd-fbdd-548c-b5de-850da57be767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472807}] :answer-field/correct {:answer/id #uuid "3993f4fd-fbdd-548c-b5de-850da57be767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472807} :answer-field/id #uuid "4b7e5322-7530-5e96-9303-0361ea826df6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "787ecee8-f1f0-5525-9f42-a25a7295c8af" :question/math-academy-id "q-181669" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A={n\\in Z\\,:\\,\\operatorname{cos}⁡(2n\\pi )=0}$\n\n- **II.** $B={q\\in Q\\,:\\,\\operatorname{cos}⁡(2q\\pi )=0}$\n\n- **III.** $C={x\\in R\\,:\\,\\operatorname{cos}⁡(2x\\pi )=0}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{cos}⁡(2x\\pi )=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}2x\\pi  & =\\frac{\\pi }{2}+m\\pi  \\\\ x & =\\frac{1}{4}+\\frac{m}{2},\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. There are no values of $m\\in Z$ such that $\\frac{1}{4}+\\frac{m}{2}\\in Z.$ Therefore,\n\n$$\nA={}.\n$$\n\nConsequently, $|A|=0,$ which is finite.\n\n- The set $B$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nB={…,-\\frac{3}{4},-\\frac{1}{4},\\frac{1}{4},\\frac{3}{4},…}.\n$$\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186420331 :knowledge-point/_questions [{:db/id #edb/ref 17592186198270 :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/title "Sets Defined Using Trigonometric Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386 :topic/title "Infinite Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6be98ed-2985-5a4b-9efa-6c626ef083aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472796} {:answer/id #uuid "a284a952-4302-5dfa-bf25-723f91b9dfd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472797}] :answer-field/correct {:answer/id #uuid "a284a952-4302-5dfa-bf25-723f91b9dfd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472797} :answer-field/id #uuid "25759778-8fb6-5f63-9330-330d39817923" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473793} {:answer-field/choices [{:answer/id #uuid "c504450c-70b8-5a79-be85-1b4a58e25ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472798} {:answer/id #uuid "a36721f4-cd73-5f82-8636-041b9bcbe466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472799}] :answer-field/correct {:answer/id #uuid "a36721f4-cd73-5f82-8636-041b9bcbe466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472799} :answer-field/id #uuid "3db01313-83c9-5e0a-9bc2-aad0155a4cd1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473794} {:answer-field/choices [{:answer/id #uuid "b78aa730-cf2e-54c8-8191-51cb634845f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472800} {:answer/id #uuid "b01186a6-6a6b-5188-af10-54d4795a3700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472801}] :answer-field/correct {:answer/id #uuid "b01186a6-6a6b-5188-af10-54d4795a3700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472801} :answer-field/id #uuid "7c46ea6f-2d04-5c7b-a253-b975638bca17" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473795}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8147626-87d7-56ca-be09-d1e1490d794e" :question/math-academy-id "q-181667" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A={n\\in Z\\,:\\,\\operatorname{sin}⁡(\\frac{n\\pi }{2})=0}$\n\n- **II.** $B={q\\in Q\\,:\\,\\operatorname{sin}⁡(\\frac{q\\pi }{2})=0}$\n\n- **III.** $C={x\\in R\\,:\\,\\operatorname{sin}⁡(\\frac{x\\pi }{2})=0}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{sin}⁡(\\frac{x\\pi }{2})=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}\\frac{x\\pi }{2} & =m\\pi  \\\\ x & =2m,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nA={…,-2,0,2,4,…}.\n$$\n\n- The set $B$ is infinite. Since $A$ is infinite, and $A⊆B,$ it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""} {:db/id #edb/ref 17592186420353 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8345ca2e-07d0-5694-85e8-8ac1bcfa3d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474822} {:answer/id #uuid "b5ff36f5-8430-54a9-bec5-2cc165a0f1ff" :answer/typ