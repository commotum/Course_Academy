 :answer/value "false" :db/id #edb/ref 17592186472716} {:answer/id #uuid "60b54385-bc72-5ca7-92b5-e42793fb3038" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472717}] :answer-field/correct {:answer/id #uuid "cb2a9643-7098-501a-9ebc-7cfb1fab4258" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472716} :answer-field/id #uuid "a1fe5d17-2a3a-5760-88f2-5077ef1873c0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "062c6773-1c0f-5106-b2b7-7c444f43389f" :question/math-academy-id "q-139820" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{15}$ is drawn from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ If $\\mu $ and $\\sigma $ are both unknown, which of the following are statistics?\n\nI. ${\\sum }_{i=1}^{15}|{X}_{i}|$\n\nII. $min({X}_{1},{X}_{3},…,{X}_{13},{X}_{15})$\n\nIII. $max({X}_{1},{X}_{2},…,{X}_{15},\\sigma )$\n\nSelect all that apply." :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression. \n\n- Expression I is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{15}$ only.\n\n- Expression II is also a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{15}$ only. Note that a statistic doesn't need to include every sample element.\n\n- Expression III is *not* a statistic. It is a function that contains the unknown population standard deviation $\\sigma .$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186416927 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics" :topic/_knowledge-points [{:db/id #edb/ref 17592186049367 :topic/id #uuid "ef34739b-f46e-5073-bcb9-1acc5022fae9" :topic/math-academy-id 3864 :topic/title "Sampling Distributions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91928ab5-1c08-5709-ade9-42c3fbbc3f62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472736} {:answer/id #uuid "8ee1a951-eaaf-5f12-8f31-8f125d603255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472737}] :answer-field/correct {:answer/id #uuid "91928ab5-1c08-5709-ade9-42c3fbbc3f62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472736} :answer-field/id #uuid "2f5bc247-9c01-53e3-aadd-ed34804268a7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473763} {:answer-field/choices [{:answer/id #uuid "5d5702a5-502e-5b8d-9267-895c288c6f32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472738} {:answer/id #uuid "af515352-e650-5ec1-92cb-48d3ce1f3514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472739}] :answer-field/correct {:answer/id #uuid "5d5702a5-502e-5b8d-9267-895c288c6f32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472738} :answer-field/id #uuid "81ff48ec-fbac-56c6-88aa-5530077f7640" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473764} {:answer-field/choices [{:answer/id #uuid "f929db08-b244-5145-89ee-3131d2530bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472740} {:answer/id #uuid "df817a80-9731-505c-9947-3f51347deb8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472741}] :answer-field/correct {:answer/id #uuid "df817a80-9731-505c-9947-3f51347deb8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472741} :answer-field/id #uuid "b551a732-145c-5747-b844-8f4d584df8bc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473765}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4893e2e1-c5c0-525e-90bd-45f0ee89d95b" :question/math-academy-id "q-143552" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{16}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ is unknown and $\\sigma $ is known, which of the following are statistics?\n- **I.** $\\mu \\cdot \\sigma -\\text{min}({X}_{1},{X}_{2},…,{X}_{16})$\n- **II.** $\\mu -\\text{median}({X}_{2},{X}_{4},…,{X}_{16})$\n- **III.** $\\sigma -max({X}_{1},{X}_{3},…,{X}_{15})$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression.\n\n- Expressions I and II are *not* statistics. They are functions that contain the unknown population mean $\\mu .$\n\n- Expression III is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{16}$ and the *known* population standard deviation $\\sigma $ only. Note that a statistic doesn't need to include every sample element.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186416928 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics" :topic/_knowledge-points [{:db/id #edb/ref 17592186049367 :topic/id #uuid "ef34739b-f46e-5073-bcb9-1acc5022fae9" :topic/math-academy-id 3864 :topic/title "Sampling Distributions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab934dba-e3a2-5d59-ae83-e95f06179b50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472700} {:answer/id #uuid "8f7b43a7-81e3-5385-a0ab-8aadc7cfbe8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472701}] :answer-field/correct {:answer/id #uuid "8f7b43a7-81e3-5385-a0ab-8aadc7cfbe8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472701} :answer-field/id #uuid "d026cafa-0a30-51b7-99c1-cb46a04536a8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473745} {:answer-field/choices [{:answer/id #uuid "063a719d-4200-54e4-9e1b-9c0087bfc4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472702} {:answer/id #uuid "f1ed26bd-c371-53d5-9888-89c529c6ff4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472703}] :answer-field/correct {:answer/id #uuid "f1ed26bd-c371-53d5-98