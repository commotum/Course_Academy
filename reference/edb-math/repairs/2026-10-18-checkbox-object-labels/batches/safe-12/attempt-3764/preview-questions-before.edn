e-5fa3-a774-4b5dfb8431ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453906} :answer-field/id #uuid "36456e08-b5e0-5ffb-8bc0-2e13784267ad" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454703} {:answer-field/choices [{:answer/id #uuid "5e336f47-61c7-5dfa-b071-bc593d519e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453908} {:answer/id #uuid "05d59b93-9de5-5bdc-af50-0154b6214595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453909}] :answer-field/correct {:answer/id #uuid "05d59b93-9de5-5bdc-af50-0154b6214595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453909} :answer-field/id #uuid "0bb3bd4f-a1b2-5b23-a316-a0c1d1cd0bc3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454704}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8a11ae3-b740-5975-a251-a4796d69b742" :question/math-academy-id "q-43307" :question/problem "Let $A$ be a $3\\times 3$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\nSelect all that apply.\n\n- **I.** $A$ has a zero column\n- **II.** $A$ has two proportional rows\n- **III.** One of the rows/columns of $A$ is a linear combination of other rows/columns of $A$" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and II are false. For example, consider the matrix \n\n$$\nA=\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 3\\end{bmatrix}.\n$$\n\nExpending across the $1$st column, we have that \n\n$$\n\\begin{aligned}|A| & =1\\cdot \\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}+1\\begin{vmatrix}1 & 2 \\\\ 1 & 1\\end{vmatrix} \\\\  & =(3-2)+(1-2) \\\\  & =0\\end{aligned}\n$$\n\nbut $A$ has neither a zero column nor two proportional rows.\n\n- Statement III is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nTherefore, the correct answer is \"III only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415444} :db/id #edb/ref 17592186415481} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186416113} :db/id #edb/ref 17592186416117}]} {:db/id #edb/ref 17592186415620 :knowledge-point/_questions [{:db/id #edb/ref 17592186203912 :knowledge-point/id #uuid "04206f72-e018-5925-a58f-179e897595dc" :knowledge-point/title "Determining the Existence of a Multiplicative Inverse" :topic/_knowledge-points [{:db/id #edb/ref 17592186050670 :topic/id #uuid "5da1bf0d-a741-59f5-981a-d9099d93b347" :topic/math-academy-id 4818 :topic/title "Multiplicative Inverses Modulo N"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1384975-63d7-58f2-8a6b-f8fdaada1f43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472934} {:answer/id #uuid "521a10a6-eef6-5cd6-bd3f-231097c31451" :answer/