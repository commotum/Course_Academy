e {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454897} {:answer-field/choices [{:answer/id #uuid "f6cf069d-05a9-5977-b07e-cabf8b6745a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454296} {:answer/id #uuid "a5a6a7d4-5300-5741-b7b3-4d1de0c6dba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454297}] :answer-field/correct {:answer/id #uuid "a5a6a7d4-5300-5741-b7b3-4d1de0c6dba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454297} :answer-field/id #uuid "b6a66b23-a5a9-5bd3-a362-76c36456a6fe" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d38c8439-616e-58d4-9fa5-c5876ae08e79" :question/math-academy-id "q-99327" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-\\frac{1}{9}$ is a natural number\n\n- **II.** $-\\frac{1}{9}$ is an integer\n\n- **III.** $-\\frac{1}{9}$ is a rational number" :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-\\frac{1}{9}$ is not a natural number.\n\n- $-\\frac{1}{9}$ is not an integer.\n\n- $-\\frac{1}{9}$ is a rational number because it can be written as $\\frac{(-1)}{9}.$\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046648} :activity/title "Mathematical Foundations I: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186424626} :db/id #edb/ref 17592186424864}]} {:db/id #edb/ref 17592186424834 :knowledge-point/_questions [{:db/id #edb/ref 17592186157307 :knowledge-point/id #uuid "a25bce44-98ca-54c6-a59f-b7508880d5ba" :knowledge-point/title "Determining Whether a Number is Divisible by 4" :topic/_knowledge-points [{:db/id #edb/ref 17592186048967 :topic/id #uuid "cfefea77-2afb-561b-ba1b-49d09f5abb4f" :topic/math-academy-id 2805 :topic/title "Divisibility of Integers by 2, 5, 10, 4, and 8"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dca59057-55b3-5c7c-ba82-222cb932dc6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474314} {:answer/id #uuid "342f9c82-98c2-5afb-b7a9-9344138494ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474315}] :answer-field/correct {:answer/id #uuid "342f9c82-98c2-5afb-b7a9-9344138494ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474315} :answer-field/id #uuid "05842590-b751-527d-8067-eab1f70de64f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475083} {:answer-field/choices [{:answer/id #uuid "1f310f8e-7033-5033-b9d9-74deb0062dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474316} {:answer/id #uuid "24a3dcba-c4be-52f2-90b2-c17076b17071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474317}] :answer-field/correct {:answer/id #uuid "1f310f8e-7033-5033-b9d9-74de