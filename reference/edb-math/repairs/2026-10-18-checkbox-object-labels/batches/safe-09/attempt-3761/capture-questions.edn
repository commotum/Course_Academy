7592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471481} {:answer/id #uuid "07d213c4-b711-5570-9c3b-bec90c86c6d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471482}] :answer-field/correct {:answer/id #uuid "07d213c4-b711-5570-9c3b-bec90c86c6d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471482} :answer-field/id #uuid "85cd195a-49d4-5f8f-83a9-a08d3f58048b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afb4c2fe-2048-5475-a89e-bbe7b7062429" :question/math-academy-id "q-71689" :question/problem "![](images/94/94911d7be45c5572a4ce47ce95c81a66bf6276144eeace8dd74cac15646c2082.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is an interior point of the set $M$\n- $B$ is a boundary point of the set $M$\n- $C$ is a boundary point of the set $M$\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/50/5024d8cf4c7a21667eb91dadee2d3368f1f9f3504e2a06f27b020c2d18804586.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is an interior point since there exists an open neighborhood of $A$ that is fully contained inside the set $M.$\n\n- Statement II is false. There exists an open neighborhood of $B$ that is fully contained inside the set $M.$\n\n- Statement III is true. Indeed, every open neighborhood of $C$ contains points that belong to $M$ and points that do not belong to $M.$ The point $C$ is a boundary point for the given set.\n\nTherefore, the correct answer is 'I and III only'."} {:db/id #edb/ref 17592186377668 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dbd8a41-022e-505a-9a23-5897ee2615d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453946} {:answer/id #uuid "e964dc82-e823-526c-bb4e-d9d86b715c3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453947}] :answer-field/correct {:answer/id #uuid "6dbd8a41-022e-505a-9a23-5897ee2615d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453946} :answer-field/id #uuid "fd5d2420-05be-505d-a6da-9370564b875a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454723} {:answer-field/choices [{:answer/id #uuid "5bfaf3e3-c8c3-5b0f-905a-7cfc3c188946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453948} {:answer/id #uuid "8e7b77cf-0808-52a0-92c8-aef31c85857a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453949}] :answer-field/correct {:answer/id #uuid "8e7b77cf-0808-52a0-92c8-aef31c85857a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453949} :answer-field/id #uuid "b912caf2-b2fa-5b75-b5a5-849cbfd33c40" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454724} {:answer-field/choices [{:answer/id #uuid "581a4ee7-2ef6-5d6a-8a10-f2e80e510c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453950} {:answer/id #uuid "b85c6ec3-9718-5d84-925f-86b8f81442df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453951}] :answer-field/correct {:answer/id #uuid "581a4ee7-2ef6-5d6a-8a10-f2e80e510c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453950} :answer-field/id #uuid "74197001-61cf-522e-acb4-234d12a1ff07" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aafb0544-5c12-5527-bc2a-2417215aad99" :question/math-academy-id "q-73566" :question/problem "Let \n$A=\\begin{bmatrix}2 & -3 \\\\ 2 & -2\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is **not** invertible\n- **II.** The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point\n- **III.** $Ax=0$ has no solution" :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & -3 \\\\ 2 & -2\\end{bmatrix} \\\\  & =2\\cdot (-2)-(-3)\\cdot 2 \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement I is false by the first part of the invertible matrix theorem.\n\n- Statement II is true by the fourth part of the invertible matrix theorem.\n\n- Statement III is false since, according to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement II is true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"} :activity/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494315} :db/id #edb/ref 17592186495224}]} {:db/id #edb/ref 17592186377763 :knowledge-point/_questions [{:db/id #edb/ref 17592186184172 :knowledge-point/id #uuid "5e145cb2-806a-579d-8299-8a91a6feaad1" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem and the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048978 :topic/id #uuid "d0b65e3a-175c-5881-9e6b-528af522aa34" :topic/math-academy-id 3836 :topic/title "The Rank-Nullity Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee3ba979-73eb-55d9-98be-53eb63f15310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454018} {:answer/id #uuid "42f7e70e-a33c-5389-83b8-4b66c4b40413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454019}] :answer-field/correct {:answer/id #uuid "42f7e70e-a33c-5389-83b8-4b66c4b40413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454019} :answer-field/id #uuid "51beb1c0-c434-5ffe-be4f-d1af3a966f94" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454759} {:answer-field/choices [{:answer/id #uuid "b27c5d69-4610-55e4-befd-bab1f9f21b77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454020} {:answer/id #uuid "7f38039b-9493-5449-afe0-51512728ff71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454021}] :answer-field/correct {:answer/id #uuid "7f38039b-9493-5449-afe0-51512728ff71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454021} :answer-field/id #uuid "8bd2f4dc-0220-560a-b969-e0fb63f01a28" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454760} {:answer-field/choices [{:answer/id #uuid "22168706-fdd0-5ec9-8357-a478a254b0de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454022} {:answer/id #uuid "b3eaef39-5ed2-5d0e-8448-e5d92a445686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454023}] :answer-field/correct {:answer/id #uuid "22168706-fdd0-5ec9-8357-a478a254b0de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454022} :answer-field/id #uuid "447c453c-9c02-53db-ad8b-23d0593303f4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454761}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c7ff497-8845-5d34-a5a1-e0b10d7a1e25" :question/math-academy-id "q-79367" :question/problem "Which of the following statements are true given that $A$ is a $5\\times 5$ matrix with $3$ pivot columns?\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(A)=3$\n- **II.** $A$ is not  invertible\n- **III.** $\\text{nullity}(A)=3$" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$$\nA\\text{ is }\\text{invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\operatorname{Col}(A) &=\\mathbb{R}^{5} \\\\ \\dim(\\operatorname{Col}(A)) &=5=\\operatorname{rank}(A) \\\\ \\operatorname{Null}(A) &=\\{0\\} \\\\ \\dim(\\operatorname{Null}(A)) &=0=\\operatorname{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $A$ has $3$ pivot columns, we have $\\text{rank}(A)=3.$\n\n- Statement II is true. Indeed, for the matrix $A,$ the number of the columns is $n=5.$ Now, since $\\text{rank}(A)\\ne 5,$ then by the invertible matrix theorem,  $A$ can't be an invertible matrix.\n\n- Statement III is false. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048978 :topic/id #uuid "d0b65e3a-175c-5881-9e6b-528af522aa34" :topic/math-academy-id 3836 :topic/title "The Rank-Nullity Theorem"} :activity/title "The Rank-Nullity Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545189} :db/id #edb/ref 17592186545994}]} {:db/id #edb/ref 17592186377784 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050777 :topic/id #uuid "65e4f73e-43a8-5089-914d-135e7396b995" :topic/math-academy-id 2821 :topic/title "Logical Equivalence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d48f791-cfb2-5905-8a08-ac3a02cb98d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471651} {:answer/id #uuid "42a831ec-5eee-5950-80a9-6df9cae47ae8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471652}] :answer-field/correct {:answer/id #uuid "42a831ec-5eee-5950-80a9-6df9cae47ae8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471652} :answer-field/id #uuid "895886fe-f51a-5925-af30-4f44e0e9cea8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472331} {:answer-field/choices [{:answer/id #uuid "b947d56e-0ddb-51a5-b1b0-2e3173f580d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471653} {:answer/id #uuid "dde7200c-ebbb-5580-81f9-9955e8fa6c38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471654}] :answer-field/correct {:answer/id #uuid "b947d56e-0ddb-51a5-b1b0-2e3173f580d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471653} :answer-field/id #uuid "34007ef7-681a-5401-838e-6a9b5d455f4d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472332} {:answer-field/choices [{:answer/id #uuid "7bc9cb5e-96ad-5a73-89b4-b5349f290448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471655} {:answer/id #uuid "ec42fe8c-f2e7-5cb5-b521-a55d198bc728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471656}] :answer-field/correct {:answer/id #uuid "ec42fe8c-f2e7-5cb5-b521-a55d198bc728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471656} :answer-field/id #uuid "bb5177ea-d86a-50ce-ba4e-14b59e4673a4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e6dc3a9-8bf9-5ff1-b677-65bc92bbe439" :question/math-academy-id "q-81483" :question/problem "Which of the following statements are logically equivalent?\n- **I.** $¬(A∧¬B)$\n- **II.** $¬A∧B$\n- **III.** $¬A∨B$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬(A∧¬B)\\,$ | $\\,¬A∧B\\,$ | $\\,¬A∨B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n\nWe see that only the statements $¬(A∧¬B)$ and $¬A∨B$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186377791 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050777 :topic/id #uuid "65e4f73e-43a8-5089-914d-135e7396b995" :topic/math-academy-id 2821 :topic/title "Logical Equivalence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ca8340a-82df-55a3-9305-a651afdc38de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471663} {:answer/id #uuid "b512a5e7-a7fe-581c-9548-feb54ed21083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471664}] :answer-field/correct {:answer/id #uuid "6ca8340a-82df-55a3-9305-a651afdc38de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471663} :answer-field/id #uuid "22724fc6-7046-54cf-a41e-738bcd859a57" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408