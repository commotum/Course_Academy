-5e18-b960-859e9f202044" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452226}] :answer-field/correct {:answer/id #uuid "e48f546a-1da8-5e18-b960-859e9f202044" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452226} :answer-field/id #uuid "120438b3-dec2-597e-a996-fd9ef95e4b98" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452960}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14a18e20-8a94-54a8-afff-0a503b7d967c" :question/math-academy-id "q-95916" :question/problem "Given that $A=QR$ is a QR factorization of a $2\\times 2$ matrix $A$ with linearly independent columns, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The columns of $Q$ are orthonormal\n\n- **II.** $Q$ is a square matrix\n\n- **III.** $R$ is a square matrix" :question/worked-solution "Recall that if $A=QR$ is a QR factorization of an $m\\times n$ matrix $A,$ then\n\n$$\n{A}_{m\\times n}={Q}_{m\\times n}\\times {R}_{n\\times n},\n$$\n\nwhere \n\n- $Q$ is an $m\\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A)$\n\n- $R$ is an $n\\times n$ upper triangular matrix\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since the columns of $Q$ form an orthonormal basis, they are orthonormal.\n\n- Statement II is true. Since $Q$ must be a $2\\times 2$ matrix, it is square.\n\n- Statement III is true. Since $R$ must be a $2\\times 2$ matrix, it is square.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186364578 :knowledge-point/_questions [{:db/id #edb/ref 17592186133864 :knowledge-point/id #uuid "1304189f-61ac-53c5-9b09-8e365f763136" :knowledge-point/title "Identifying Dimensions of Factors in a QR Factorization" :topic/_knowledge-points [{:db/id #edb/ref 17592186050130 :topic/id #uuid "2f232786-4262-5d64-9c58-1578e8c629d2" :topic/math-academy-id 2129 :topic/title "QR Factorization"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa96bbef-e60b-5938-afd9-9aecce3662a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452227} {:answer/id #uuid "fc82ac14-9f60-5ff5-abf6-9be439d5811c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452228}] :answer-field/correct {:answer/id #uuid "fa96bbef-e60b-5938-afd9-9aecce3662a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452227} :answer-field/id #uuid "2fe0a7f0-668f-540b-a54e-2bb0427d1d40" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452961} {:answer-field/choices [{:answer/id #uuid "0037e982-4e96-568d-9977-84d06128905e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452229} {:answer/id #uuid "72d0b427-e976-5eed-8e23-5bc0a65dd9f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452230}] :answer-field/correct {:answer/id #uuid "72d0b427-e976-5eed-8e23-5bc0a65dd9f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452230} :answer-field/id #uuid "9f6a5e16-c6e0-5de3-b5c7-56166731c92b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452962} {:answer-field/choices [{:answer/id #uuid "4ffe0134-9e43-5357-bfb9-2d702d98cc8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452231} {:answer/id #uuid "fa4c660a-4b11-554a-9592-b3bbc7fe081e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452232}] :answer-field/correct {:answer/id #uuid "fa4c660a-4b11-554a-9592-b3bbc7fe081e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452232} :answer-field/id #uuid "1d9d8be5-9c71-5d23-9c41-8e0eb84f478a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452963}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d40cdd9-dee2-5236-bb35-1c36eb46fb25" :question/math-academy-id "q-95922" :question/problem "Given that $A=QR$ is a QR factorization of a $4\\times 2$ matrix $A$ with linearly independent columns, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $Q$ is a square matrix\n- **II.** $R$ is a $2\\times 2$ matrix\n- **III.** The columns of $Q$ are orthonormal" :question/worked-solution "Recall that if $A=QR$ is a  QR factorization of an $m\\times n$ matrix $A,$ then\n\n$$\n{A}_{m\\times n}={Q}_{m\\times n}\\times {R}_{n\\times n},\n$$\n\nwhere \n\n- $Q$ is an $m\\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A)$\n\n- $R$ is an $n\\times n$ upper triangular matrix\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. $Q$ should be a $4\\times 2$ matrix, so it is not square.\n\n- Statement II is true. Indeed, $R$ must be a $2\\times 2$ matrix.\n\n- Statement III is true. Since the columns of $Q$ form an orthonormal basis, $Q$ must be an orthogonal matrix.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186364681 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test" :topic/_knowledge-points [{:db/id #edb/ref 17592186051048 :topic/id #uuid "7d157e41-c50b-570b-8b5b-b8a5a0d03163" :topic/math-academy-id 1944 :topic/title "The Second Partial Derivatives Test"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62cbcaa0-0a4b-5073-ad88-c02a4ba1a019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451299} {:answer/id #uuid "375e98ca-c238-53ff-beba-897b64cc63a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451300}] :answer-field/correct {:answer/id #uuid "62cbcaa0-0a4b-5073-ad88-c02a4ba1a019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451299} :answer-field/id #uuid "652213cb-11aa-5dea-a4bc-3b9c8b1c355c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452497} {:answer-field/choices [{:answer/id #uuid "7b0d48c5-2f2c-5055-908e-0dc95f5f7282" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451301} {:answer/id #uuid "61b6f0c7-25e4-5be3-b321-0d0f90827d6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451302}] :answer-field/correct {:answer/id #uuid "61b6f0c7-25e4-5be3-b321-0d0f90827d6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451302} :answer-field/id #uuid "d71cb01d-fa4d-51c3-8af9-10186ba20c84" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452498} {:answer-field/choices [{:answer/id #uuid "1bd7d602-b04e-508c-8f43-638a3bb96a1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451303} {:answer/id #uuid "cafd6976-b47f-5881-a12d-13755ea64993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451304}] :answer-field/correct {:answer/id #uuid "cafd6976-b47f-5881-a12d-13755ea64993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451304} :answer-field/id #uuid "1a57395c-fb2f-5e27-af13-56da5d453d17" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2adfa73-7e18-5d5d-8163-694e5efa8a14" :question/math-academy-id "q-104980" :question/problem "The function $f(x,y)$ has Hessian matrix\n\n$$\n{∇}^{2}f(x,y)=\\begin{bmatrix}{x}^{2}+2(y-3) & 2(x+1) \\\\ 2(x+1) & (y-3)^{2}\\end{bmatrix}\n$$\n\nand has a stationary point at $(-1,3).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(-1,3)<0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,3)>0$\n- **III.** The second partial derivative test is inconclusive" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ then:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$;\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a.$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a.$\n\n- If $H(a)=0,$ then the second partial derivative test is inconclusive.\n\nEvaluating the Hessian at $(-1,3),$ we obtain\n\n$$\n{∇}^{2}f(-1,3)=\\begin{bmatrix}(-1)^{2}+2(3-3) & 2(-1+1) \\\\ 2(-1+1) & (3-3)^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nNow, let's examine the statements.\n\n- Statement I is false. The Hessian determinant is\n\n$$\nH(-1,3)=det({∇}^{2}f(-1,3))=1(0)-0(0)=0.\n$$\n\n- Statement II is true because\n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,3)=1>0.\n$$\n\n- Statement III is true because $H(-1,3)=0,$ so the second partial derivative test is inconclusive.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186364723 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54cbfca0-bff0-52dc-a7d3-f7f9ea5acb20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468858} {:answer/id #uuid "ab8db7bb-912a-549b-8dc7-d4e68d879053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468859}] :answer-field/correct {:answer/id #uuid "ab8db7bb-912a-549b-8dc7-d4e68d879053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468859} :answer-field/id #uuid "cc9b4d17-b28a-526f-8892-83a499708178" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470041} {:answer-field/choices [{:answer/id #uuid "5c5112c1-4747-5e8b-a12b-430126d5ce9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468860} {:answer/id #uuid "cb8614be-f12e-5507-b395-aa4a960dd2ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468861}] :answer-field/correct {:answer/id #uuid "5c5112c1-4747-5e8b-a12b-430126d5ce9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468860} :answer-field/id #uuid "e370841a-5acd-57e5-9802-a92d25d0133e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470042} {:answer-field/choices [{:answer/id #uuid "ae1bff07-aba3-5a99-aece-07d510737e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468862} {:answer/id #uuid "1a402636-9d56-5283-8679-8961a991afe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468863}] :answer-field/correct {:answer/id #uuid "ae1bff07-aba3-5a99-aece-07d510737e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468862} :answer-field/id #uuid "ea2f7538-5026-507b-a35a-db7e12ed1e93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a2340ea-4d69-565f-a0a6-1a2327573430" :question/math-academy-id "q-106904" :question/problem "Which of the following vector spaces has a dimension of $11?$\n- **I.** ${R}_{10}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $10$\n- **II.** ${\\text{M}}_{2\\times 6}(R),$ the vector space of all $2\\times 6$ matrices over $R$\n- **III.** ${R}^{10}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11.\\,✓\n$$\n- Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{2\\times 6}(R))=2\\cdot 6=12\\ne 11.\\,\\times \n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{10})=10\\ne 11.\\,\\times \n$$\n\nHence, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186364730 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de766be9-7744-5bfb-8b2f-8023fc3158cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468864} {:answer/id #uuid "2f125859-37a5-5537-ba48-6d2ee36d6bd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468865}] :answer-field/correct {:answer/id #uuid "de766be9-7744-5bfb-8b2f-8023fc3158cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468864} :answer-field/id #uuid "6be09d3c-75d8-5d3d-919f-3773c54a4af7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470044} {:answer-field/choices [{:answer/id #uuid "5af34f65-86e0-5151-8a15-9503bee30c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468866} {:answer/id #uuid "0fb68f23-b130-57cd-a680-8d96d33d7e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468867}] :answer-field/correct {:answer/id #uuid "0fb68f23-b130-57cd-a680-8d96d33d7e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468867} :answer-field/id #uuid "dfc19938-334a-52b1-a436-771c8fabe642" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470045} {:answer-field/choices [{:answer/id #uuid "13b3e34b-7482-55bd-b20d-64ca8e7437bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468868} {:answer/id #uuid "93ae5df4-23d2-523c-b530-f71615d60fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468869}] :answer-field/correct {:answer/id #uuid "93ae5df4-23d2-523c-b530-f71615d60fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468869} :answer-field/id #uuid "e613ab11-478a-590d-a0b0-981f9038f46d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470046}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ad8a280-94c8-5978-909a-9e22277ca8ba" :question/math-academy-id "q-106918" :question/problem "Which of the following vector spaces are finite-dimensional?\n- **I.** $D(R),$ the vector space of all differentiable functions on $R$\n- **II.** ${R}^{100}$\n- **III.** ${R}_{2000}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $2\\,000$\n\nSelect all that apply." :question/worked-solution "Let's examine our vector spaces.\n\n- $D(R)$ is *not* finite-dimensional. To understand why, we first note that the following subset of $D(R)$ is linearly independent:\n\n$$\n{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in R$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $D(R)$  of size $n,$ which imples that $D(R)$ cannot have finite dimension.     .\n\n- ${R}^{100}$ and ${R}_{2000}[t]$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}^{100})=100\n$$\n\n \nand\n\n$$\n\\text{dim}({R}_{2000}[t])=2000+1=2\\,001,\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186365010 :knowledge-point/_questions [{:db/id #edb/ref 17592186172029 :knowledge-point/id #uuid "7a6bbb34-a43f-5e16-8a24-25c0d6970a38" :knowledge-point/title "Identifying a Quadratic Curve Type From Its Reduced Equation: No Cross-Product Term" :topic/_knowledge-points [{:db/id #edb/ref 17592186050760 :topic/id #uuid "64670a5e-dd35-51fc-bd24-210590f74fcd" :topic/math-academy-id 3336 :topic/title "Classifying Quadratic Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86538b9a-7568-5933-8854-c5b4658f48fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468942} {:answer/id #uuid "7015220a-f9e7-5df7-8058-44ffcd7f8d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468943}] :answer-field/correct {:answer/id #uuid "7015220a-f9e7-5df7-8058-44ffcd7f8d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468943} :answer-field/id #uuid "1042346b-f6d0-5bb9-9f5f-bce0a807b4a3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470083} {:answer-field/choices [{:answer/id #uuid "ec93fa16-4cde-5228-9add-72224548a4b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468944} {:answer/id #uuid "f37fedd9-c61b-5bc4-9e9b-a9572e1053ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468945}] :answer-field/correct {:answer/id #uuid "f37fedd9-c61b-5bc4-9e9b-a9572e1053ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468945} :answer-field/id #uuid "862e7db4-e4cf-5fa7-beaa-ce2dadf572fd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470084} {:answer-field/choices [{:answer/id #uuid "f8f6328b-6e1c-5742-b270-297de5ba0087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468946} {:answer/id #uuid "3f2783d8-30e3-52a0-8485-391ca3a4046f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468947}] :answer-field/correct {:answer/id #uuid "3f2783d8-30e3-52a0-8485-391ca3a4046f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468947} :answer-field/id #uuid "b91acfa1-f88a-5755-910e-8b8e92796d63" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470085}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7ec5e81-6115-5881-b6f7-16bb9226da5a" :question/math-academy-id "q-140554" :question/problem "Which of the following equations define a non-empty set of points in the ${x}_{1}{x}_{2}$-plane?\n- **I.** ${x}_{1}^{2}-{x}_{2}^{2}=-1$\n- **II.** ${x}_{1}^{2}+2{x}_{2}=0$\n- **III.** ${x}_{1}^{2}+{x}_{2}^{2}=0$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the equations in turn.\n\n- The equation ${x}_{1}^{2}-{x}_{2}^{2}=-1$ defines a non-empty set. It represents the hyperbola ${x}_{2}^{2}-{x}_{1}^{2}=1.$\n\n- The equation ${x}_{1}^{2}+2{x}_{2}=0$ defines a non-empty set. It represents a parabola that opens in the direction of the negative ${x}_{2}$-axis in the ${x}_{1}{x}_{2}$-plane.\n\n- The equation ${x}_{1}^{2}+{x}_{2}^{2}=0$ defines a non-empty set. It represents a single point $(0,0)$ in the ${x}_{1}{x}_{2}$-plane.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186365052 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb7dde31-bde1-58e8-ad71-ec6b2e8b2319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451311} {:answer/id #uuid "3ca9aaad-54c8-5fad-9a03-14113c01dc8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451312}] :answer-field/correct {:answer/id #uuid "fb7dde31-bde1-58e8-ad71-ec6b2e8b2319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451311} :answer-field/id #uuid "e741fb79-46a4-593a-9d56-3df9c7384c94" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452503} {:answer-field/choices [{:answer/id #uuid "05cc96c4-9bd0-5ec2-9c67-70c12fe56748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451313} {:answer/id #uuid "71be77cb-f2a0-5da9-a71b-0d54bf22920e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451314}] :answer-field/correct {:answer/id #uuid "05cc96c4-9bd0-5ec2-9c67-70c12fe56748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451313} :answer-field/id #uuid "4fda6962-d111-5d52-9d97-94bb5cf1b992" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452504} {:answer-field/choices [{:answer/id #uuid "757e1e41-d4bd-5b02-ae6c-09acb0b026a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451315} {:answer/id #uuid "ae88a715-f3a8-55f4-890a-5a6165ebc0af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451316}] :answer-field/correct {:answer/id #uuid "ae88a715-f3a8-55f4-890a-5a6165ebc0af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451316} :answer-field/id #uuid "c19a4f3d-993f-546f-aa3d-c187f50b1a7a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb8cc465-a001-5ad5-bfcd-11eb17855f11" :question/math-academy-id "q-140844" :question/problem "Given that $A$ is a $4\\times 4$ real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is not diagonalizable\n- **II.** $A$ must have $4$ integer eigenvalues\n- **III.** If  $\\alpha $ is an eigenvalue of $A$ with the multiplicity $2,$ then the dimension of the eigenspace for the eigenvalue $\\alpha $ is $2.$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the spectral theorem, any symmetric matrix with real entries is orthogonally diagonalizable, so, $A$ is diagonalizable.\n\n- Statement II is false. According to the spectral theorem, the eigenvalues are real but not necessarily integers.\n\n- Statement III is true. According to the theorem, the dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"} :activity/title "The Spectral Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544069} :db/id #edb/ref 17592186544908}]} {:db/id #edb/ref 17592186365108 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8b08f7a-3777-5f1a-a9eb-461a2fd0414f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451335} {:answer/id #uuid "aa1dc0f1-cd98-5509-9477-51d011494a2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451336}] :answer-field/correct {:answer/id #uuid "c8b08f7a-3777-5f1a-a9eb-461a2fd0414f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451335} :answer-field/id #uuid "57869de9-6ee9-5e0b-90f9-6810fc1f801e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452515} {:answer-field/choices [{:answer/id #uuid "3c06a9fc-e9e1-5f78-abd6-96a1dabad6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451337} {:answer/id #uuid "e431efe4-4133-5a40-bbcf-62064ac9644b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451338}] :answer-field/correct {:answer/id #uuid "e431efe4-4133-5a40-bbcf-62064ac9644b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451338} :answer-field/id #uuid "308a1332-e85b-5404-b4a5-ba01221b22ad" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452516} {:answer-field/choices [{:answer/id #uuid "9313834d-4423-5042-bc49-9390326be415" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451339} {:answer/id #uuid "28ce3ebb-bcf9-5d61-a603-60625891c0ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451340}] :answer-field/correct {:answer/id #uuid "28ce3ebb-bcf9-5d61-a603-60625891c0ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451340} :answer-field/id #uuid "237be3da-ec76-5d1e-936e-544f31cdde31" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452517}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b742394a-cffb-5df9-9fbd-181d0debffeb" :question/math-academy-id "q-143683" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $A$ is *any* matrix, then ${A}^{3}$ is always symmetric.\n- **II.** The sum of two $n\\times n$ symmetric matrices is always symmetric.\n- **III.** The difference of two $n\\times n$ symmetric matrices is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, ${A}^{3}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{3} & =\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement II is true. Indeed, for any two symmetric matrices $A$ and $B,$ we have \n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any two symmetric matrices $A$ and $B,$ we have \n\n$$\n\\begin{aligned}(A-B)^{T} & ={A}^{T}-{B}^{T} \\\\  & =A-B.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186365603 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186049852 :topic/id #uuid "18c7c8d4-f8df-5ab7-94e4-a5bda9fa7a9b" :topic/math-academy-id 3238 :topic/title "Solving Decoupled Homogeneous Systems of ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79e6baab-1808-5120-89bc-116fafa9f74c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468990} {:answer/id #uuid "eac07d78-a7a2-5dfe-87f8-a01eb434d336" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468991}] :answer-field/correct {:answer/id #uuid "79e6baab-1808-5120-89bc-116fafa9f74c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468990} :answer-field/id #uuid "b9d469c8-f695-5993-8677-034696487b48" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470107} {:answer-field/choices [{:answer/id #uuid "651ce891-22e2-516c-b4a5-bd76f0bcbe50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468992} {:answer/id #uuid "55ec1ca4-ad6c-5c25-80f7-7ac997155c9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468993}] :answer-field/correct {:answer/id #uuid "55ec1ca4-ad6c-5c25-80f7-7ac997155c9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468993} :answer-field/id #uuid "b900a48f-0d45-549e-8e13-96a10ba611f3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470108} {:answer-field/choices [{:answer/id #uuid "b6f9fb71-005c-56c6-8fb5-6322448b76b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468994} {:answer/id #uuid "3de14d47-3e28-5e31-9272-df20e765bff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468995}] :answer-field/correct {:answer/id #uuid "b6f9fb71-005c-56c6-8fb5-6322448b76b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468994} :answer-field/id #uuid "701a6699-3227-552c-aecd-c57986c59c5d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470109}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1bf4017-8b21-55a6-92c8-e49841f3879b" :question/math-academy-id "q-331092" :question/problem "Which of the following systems of linear ODEs are decoupled?\n- **I.** ${x}^{′}(t)=\\begin{bmatrix}-1 & 2 \\\\ 0 & 3\\end{bmatrix}x(t)$\n- **II.** ${x}^{′}(t)=\\begin{bmatrix}6 & 0 \\\\ 0 & -2\\end{bmatrix}x(t)$\n- **III.** ${x}^{′}(t)=\\begin{bmatrix}-4 & -5 \\\\ 2 & 0\\end{bmatrix}x(t)$\n\nSelect all that apply." :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently.  \n\nIn matrix form, a linear system ${x}^{′}(t)=Ax(t)$ is decoupled if $A$ is a diagonal matrix.\n\nWith this in mind, let's examine our systems.\n\n- System II is decoupled since its corresponding matrix is diagonal.\n\n- Systems I and III are *not* decoupled because their matrices are not diagonal.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186366006 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros" :topic/_knowledge-points [{:db/id #edb/ref 17592186050376 :topic/id #uuid "44312a5e-e7e0-507f-86f6-c3bcdecfd7fe" :topic/math-academy-id 1964 :topic/title "The Characteristic Equation of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7e5456c-c3dd-5a0d-b1c2-3704fc8684a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451347} {:answer/id #uuid "2e3a06ba-b64e-5195-8730-c9b460991557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451348}] :answer-field/correct {:answer/id #uuid "e7e5456c-c3dd-5a0d-b1c2-3704fc8684a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451347} :answer-field/id #uuid "e1d9b580-5d43-50e2-927e-f8ae49947f12" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452521} {:answer-field/choices [{:answer/id #uuid "44f80825-4dc0-5703-964c-52ef15f73d55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451349} {:answer/id #uuid "183ba4dd-4b07-51c8-addc-3f2d2bef0202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451350}] :answer-field/correct {:answer/id #uuid "183ba4dd-4b07-51c8-addc-3f2d2bef0202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451350} :answer-field/id #uuid "1e54440b-ec3a-55ca-8152-eddfc8c269f2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452522} {:answer-field/choices [{:answer/id #uuid "bd8399ad-e6d4-5375-a818-f30592990e92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451351} {:answer/id #uuid "171f1a31-d670-547d-9146-cec5d20385e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451352}] :answer-field/correct {:answer/id #uuid "171f1a31-d670-547d-9146-cec5d20385e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451352} :answer-field/id #uuid "b104c177-2725-5efd-84ea-448298f66c5d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e41ff16d-c666-5918-91e3-4e187ca2af95" :question/math-academy-id "q-37387" :question/problem "$$\nC=\\begin{bmatrix}2 & 1 & 4 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ -5 & 2 & -3 & 0 \\\\ 1 & -7 & 6 & 5\\end{bmatrix}.\n$$\n\nConsider the matrix $C$ given above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\lambda =2$ is an eigenvalue of $C$\n\n- **II.** $\\lambda =5$ is an eigenvalue of $C$\n\n- **III.** The eigenvalue $\\lambda =5$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,C-\\lambda I:$\n﻿﻿﻿\n\n$$\nC-\\lambda I=\\begin{bmatrix}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(C-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $4$th column, as follows:\n\n$$\n\\begin{aligned}det(C-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )\\begin{vmatrix}2-\\lambda  & 1 & 4 \\\\ 0 & 5-\\lambda  & 0 \\\\ -5 & 2 & -3-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(5-\\lambda )\\cdot (5-\\lambda )\\begin{vmatrix}2-\\lambda  & 4 \\\\ -5 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )^{2}\\cdot ((2-\\lambda )(-3-\\lambda )+20) & =0 \\\\ (\\lambda -5)^{2}({\\lambda }^{2}+\\lambda +14) & =0\\end{aligned}\n$$\n\nSince $D<0$ for the polynomial ${\\lambda }^{2}+\\lambda +14$ we have that the only real eigenvalue is $\\lambda =5$ (with algebraic multiplicity $2$). \n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186366039 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffbbdf5b-b5a9-58a5-b789-13db6ff1a8ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469014} {:answer/id #uuid "725a5695-1253-5d33-8d18-e5f71e632c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469015}] :answer-field/correct {:answer/id #uuid "ffbbdf5b-b5a9-58a5-b789-13db6ff1a8ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469014} :answer-field/id #uuid "134c0d8a-c3e3-5d31-a016-da1dea915d49" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470119} {:answer-field/choices [{:answer/id #uuid "c68912f2-a32e-5af0-bfd8-53a4e352fc40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469016} {:answer/id #uuid "90511e22-e82e-54b5-a8be-46168f1b6a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469017}] :answer-field/correct {:answer/id #uuid "90511e22-e82e-54b5-a8be-46168f1b6a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469017} :answer-field/id #uuid "8d16e520-7b60-5e2f-8e42-9334e0996e9c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470120} {:answer-field/choices [{:answer/id #uuid "4e45344d-c214-5cf1-9c6c-7c83274e9ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469018} {:answer/id #uuid "c1ea614b-40b5-59b4-ac19-8dc8a355b72f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469019}] :answer-field/correct {:answer/id #uuid "4e45344d-c214-5cf1-9c6c-7c83274e9ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469018} :answer-field/id #uuid "1f93777f-8292-5756-b7f9-4905592e30dc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470121}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "006b1b75-818e-5ba9-8f81-bc35ede44097" :question/math-academy-id "q-38141" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n- **I.** If $\\text{rank}(T)=2,$ then $\\text{Ker}(T)={0}$\n- **II.** If $[-2,0,0]^{T}$ is a solution of $T(x)=0$ then $\\text{nullity}(T)\\ne 0$\n- **III.** If $T(x)=[1,0,0]^{T}$ has no solution then $\\text{rank}(T)=3$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is true. Since $\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}$ is a solution of $Tx=0$, we have that $\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}\\in \\text{Ker}(T)$ and therefore $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Since $T(x)=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$ has no solution, we have that $\\text{Im}(T)\\ne {R}^{3}.$ Hence, $\\text{rank}(T)\\ne 3.$\n\nTherefore, the correct option is \"II only.\""} {:db/id #edb/ref 17592186366052 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane" :topic/_knowledge-points [{:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d07d408-4bd4-52a2-b369-1432edfe2c77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469020} {:answer/id #uuid "eaeb8c45-a223-54ca-b996-e4cc9a54fe8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469021}] :answer-field/correct {:answer/id #uuid "6d07d408-4bd4-52a2-b369-1432edfe2c77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469020} :answer-field/id #uuid "246b7ed5-a7fd-53be-80d4-b0d726f0fda5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470122} {:answer-field/choices [{:answer/id #uuid "4f53549c-840d-53f3-bf45-f0d90bcc6ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469022} {:answer/id #uuid "215f631a-fd6a-5cc0-906f-13e0a5fbd25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469023}] :answer-field/correct {:answer/id #uuid "215f631a-fd6a-5cc0-906f-13e0a5fbd25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469023} :answer-field/id #uuid "8a6bf326-d27f-5130-ad2f-4b066b4f2754" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470123} {:answer-field/choices [{:answer/id #uuid "5bb3b5e2-0da0-57b0-a807-697b0aeddec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469024} {:answer/id #uuid "a8fd395f-d3c4-53ed-b990-698626ffd03e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469025}] :answer-field/correct {:answer/id #uuid "5bb3b5e2-0da0-57b0-a807-697b0aeddec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469024} :answer-field/id #uuid "435f823d-9228-557b-a231-fc7e35bab06c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470124}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34581764-4087-5b06-9eff-4679fe703405" :question/math-academy-id "q-38300" :question/problem "If the linear transformation $T$ maps ${R}^{2}$ onto the line $y=-3x$ then, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨1,3⟩$ belongs to the range of $T$\n\n- **II.** $\\text{Ker}(T)\\ne {0}$\n\n- **III.** $\\text{Im}(T)={0}$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement I is false. \nNotice that the point $(1,3)$ does not satisfy the equation of the line $y=-3x$ since $3\\ne -3\\cdot 1.$ Therefore, the vector $⟨1,3⟩\\notin \\text{Im}(T).$\n\n- Statement II is true. Indeed, \nsince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. Hence, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. \nFor example,  the point $(1,-3)$ satisfies the equation  $y=-3x$ since $-3=-3\\cdot 1.$ Therefore, the vector $⟨1,-3⟩\\in \\text{Im}(T).$ Thus, $\\text{Im}(T)\\ne {0}.$" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"} :activity/title "The Image of a Linear Transformation in the Cartesian Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553853} :db/id #edb/ref 17592186554674}]} {:db/id #edb/ref 17592186366059 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane" :topic/_knowledge-points [{:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf5d61a3-731b-5ca2-a21d-a258c3b1767d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469026} {:answer/id #uuid "83d5e69a-fb13-5cb4-8279-35f40cd14786" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469027}] :answer-field/correct {:answer/id #uuid "cf5d61a3-731b-5ca2-a21d-a258c3b1767d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469026} :answer-field/id #uuid "ad7fbb88-7ce0-52f3-bfca-0238dcd3a81c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470125} {:answer-field/choices [{:answer/id #uuid "94b0ff15-d102-5f1d-af4e-e362a8a9b9a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469028} {:answer/id #uuid "c0529496-06cf-5552-ac7c-13815e3edd61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469029}] :answer-field/correct {:answer/id #uuid "c0529496-06cf-5552-ac7c-13815e3edd61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469029} :answer-field/id #uuid "990ff885-053e-5892-a630-17d9382e4120" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470126} {:answer-field/choices [{:answer/id #uuid "e46a229c-3d63-5185-b98f-3bcb74c8a528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469030} {:answer/id #uuid "c12af7cf-9477-5a53-a812-9a97f8176c74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469031}] :answer-field/correct {:answer/id #uuid "e46a229c-3d63-5185-b98f-3bcb74c8a528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469030} :answer-field/id #uuid "4bce9e44-27f0-518d-ad2a-de5a2a028195" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470127}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "07bd3910-da00-5269-ba42-c4e894fc0a77" :question/math-academy-id "q-38305" :question/problem "If the linear transformation $T$ maps ${R}^{2}$ onto the line $5y=6x$ then, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨\\frac{6}{5},1⟩\\in \\text{Im}(T)$\n\n- **II.** $\\text{Ker}(T)\\ne {0}$\n\n- **III.** $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement I is false.\nNotice that the point $(\\frac{6}{5},1)$ does not satisfy the equation of the line $5y=6x$ since $5\\cdot 1\\ne \\frac{6}{5}\\cdot 6.$ Therefore, \n$⟨\\frac{6}{5},1⟩\\notin \\text{Im}(T).$\n\n- Statement II is true.\nSince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. So, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false.\nSince  statement II is true we have that $\\text{nullity}(T)=\\text{dim(Ker}(T))\\ne 0.$"} {:db/id #edb/ref 17592186366097 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e4e29d4-8ab4-51b2-bed7-3d933724288f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469038} {:answer/id #uuid "366b643d-0477-56b8-99e8-05665c95ecc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469039}] :answer-field/correct {:answer/id #uuid "3e4e29d4-8ab4-51b2-bed7-3d933724288f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469038} :answer-field/id #uuid "aa806480-98e3-5de9-ac37-45bb7e60daee" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470131} {:answer-field/choices [{:answer/id #uuid "0dba33dd-efd6-5edd-8cb4-431f80150830" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469040} {:answer/id #uuid "03dbdbf2-dd97-5434-bd34-a6b20449669a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469041}] :answer-field/correct {:answer/id #uuid "0dba33dd-efd6-5edd-8cb4-431f80150830" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469040} :answer-field/id #uuid "bad0d392-5687-58fc-8043-83455bbb6881" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470132} {:answer-field/choices [{:answer/id #uuid "2c5c5fde-9d69-5dd0-bd3e-c686ea921e45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469042} {:answer/id #uuid "c12380e7-7519-5b6e-8745-f0b879e1df9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469043}] :answer-field/correct {:answer/id #uuid "2c5c5fde-9d69-5dd0-bd3e-c686ea921e45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469042} :answer-field/id #uuid "8e9fc1cb-34d2-5ac7-b925-bd6d7335fddb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470133}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "936f721f-93be-5c51-8233-7da49b500101" :question/math-academy-id "q-38979" :question/problem "Let $T:{R}^{n}\\to {R}^{n}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n- **I.** If $\\text{Ker}(T)={⟨x,y,z⟩\\,|\\,x+y=0}$ then $\\text{rank}(T)+1=n$\n- **II.** If there exists a vector $v\\notin \\text{Im}(T),$ then $|T|\\ne 0$\n- **III.** If ${{v}_{1},{v}_{2}}$ is linearly independent and $T({v}_{1})=T({v}_{2})=0$ then $\\text{nullity}(T)=1$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{n}$ into ${R}^{n},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{n} \\\\  & \\text{rank}(T)=n \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Solving $x+y=0$ for $x,$ we get $x=-y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-y \\\\ y \\\\ z\\end{bmatrix}=y\\underbrace{\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{v}_{1}}+z\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{nullity}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ \\text{rank}(T)+2 & =n.\\end{aligned}\n$$\n\n- Statement II is false. If $v\\notin \\text{Im}(T)$ then $\\text{Im}(T)\\ne {R}^{n}$, so, according to the invertible matrix theorem, $T$ is not a bijection. Thus, the matrix $T$ is not invertible, and, consequently, $|T|=0.$\n\n- Statement III is false. Since $T({v}_{1})=T({v}_{2})=0$, then ${v}_{1},{v}_{2}\\in \\text{Ker}(T).$ But the vectors are linearly independent, therefore, the dimension of  $\\text{Ker}(T)$ is at least $2.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186366219 :knowledge-point/_questions [{:db/id #edb/ref 17592186147427 :knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4" :knowledge-point/title "Identifying the Intersection of Two Planes" :topic/_knowledge-points [{:db/id #edb/ref 17592186050991 :topic/id #uuid "7789d7fa-bfec-58c3-afd1-afcff30a8748" :topic/math-academy-id 2539 :topic/title "The Intersection of Two Planes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfbaf102-c0df-5e93-9fdd-76ff8e170914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451507} {:answer/id #uuid "bd856043-9bf5-545a-9dab-355b675c30de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451508}] :answer-field/correct {:answer/id #uuid "cfbaf102-c0df-5e93-9fdd-76ff8e170914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451507} :answer-field/id #uuid "17379ff6-7738-574d-b3f4-b367ff0dfb86" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452601} {:answer-field/choices [{:answer/id #uuid "eacdbb44-ca0c-548a-9e83-9c47d872f78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451509} {:answer/id #uuid "f26307df-edf9-5e2f-ae55-61a18a228540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451510}] :answer-field/correct {:answer/id #uuid "eacdbb44-ca0c-548a-9e83-9c47d872f78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451509} :answer-field/id #uuid "b1aea80c-069f-5199-b8cf-083b0c70f9f9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452602} {:answer-field/choices [{:answer/id #uuid "c5d27925-4f17-57c7-83c0-083d924358a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451511} {:answer/id #uuid "b187a096-71e0-5c74-af3c-85207909140b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451512}] :answer-field/correct {:answer/id #uuid "b187a096-71e0-5c74-af3c-85207909140b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451512} :answer-field/id #uuid "22f7c0e5-f396-5066-adbe-dbe1244d165d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96c9a429-d310-55eb-845b-95fc86ca78d5" :question/math-academy-id "q-71448" :question/problem "Given the two planes $x-2y+z=0$ and $x-y+1=0$, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The normal vectors of the planes are parallel.\n- **II.** The cross product of the normal vectors of the planes is equal to $0.$\n- **III.** The planes intersect on a line." :question/worked-solution "First, notice that:\n\n- For the plane $x-2y+z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,-2,1⟩.$\n\n- For the plane $x-y+1=0,$ a normal vector to the plane is ${n}_{2}=⟨1,-1,0⟩.$\n\nNow, let's consider the statements.\n\n- Statements I and II are false. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,-2,1⟩\\times ⟨1,-1,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & -2 & 1 \\\\ 1 & -1 & 0\\end{aligned}\\right| \\\\  & =i+j+k \\\\  & =⟨1,1,1⟩\\ne 0.\\end{aligned}\n$$\n\nSince ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel.\n\n- Statement III is true. Indeed, two non-parallel planes in $3$-dimensional space must intersect on a line.\n\nTherefore, only statement III is true."} {:db/id #edb/ref 17592186366365 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros" :topic/_knowledge-points [{:db/id #edb/ref 17592186050376 :topic/id #uuid "44312a5e-e7e0-507f-86f6-c3bcdecfd7fe" :topic/math-academy-id 1964 :topic/title "The Characteristic Equation of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ec9910-e0fd-500c-a549-944d8205800e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451789} {:answer/id #uuid "5a37d4f9-58db-5ba8-88b3-85410ad5ea6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451790}] :answer-field/correct {:answer/id #uuid "5a37d4f9-58db-5ba8-88b3-85410ad5ea6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451790} :answer-field/id #uuid "d02090ef-d4ce-52dc-a572-f7d577aef6d1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452742} {:answer-field/choices [{:answer/id #uuid "5bd5e478-5cfa-5b4b-b744-a3677754f14d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451791} {:answer/id #uuid "0b89ae10-1176-5228-9818-87068f6baeb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451792}] :answer-field/correct {:answer/id #uuid "0b89ae10-1176-5228-9818-87068f6baeb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451792} :answer-field/id #uuid "5f49c755-7208-571d-b62b-fa250286bf1d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452743} {:answer-field/choices [{:answer/id #uuid "1d81aeff-94a5-5d39-a36b-e4ef94203480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451793} {:answer/id #uuid "1923b6cb-681f-5678-aa63-c64a0628a021" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451794}] :answer-field/correct {:answer/id #uuid "1d81aeff-94a5-5d39-a36b-e4ef94203480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451793} :answer-field/id #uuid "ba776b6a-55ef-5233-8b4a-47f605e790d5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452744}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6753a04-a08e-5bc2-a11a-2cad03fb8d3f" :question/math-academy-id "q-80800" :question/problem "$$\nP=\\begin{bmatrix}2 & -3 & -8 & 5 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 3 & -2 & 11 \\\\ 0 & 0 & 0 & -14\\end{bmatrix}.\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\lambda =0$ is an eigenvalue of $P$\n\n- **II.** $\\lambda =-14$ is an eigenvalue of $P$\n\n- **III.** The eigenvalue $\\lambda =2$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )\\begin{vmatrix}-\\lambda  & 0 & 4 \\\\ 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & -14-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(2-\\lambda )\\cdot (-14-\\lambda )\\begin{vmatrix}-\\lambda  & 0 \\\\ 3 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-14-\\lambda )(-\\lambda )(-2-\\lambda ) & =0 \\\\ (\\lambda -2)(\\lambda +14)\\lambda (\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =2,$ $\\lambda =-2,$ $\\lambda =0,$ and $\\lambda =-14$  (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186366427 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6b563a-739c-5aa6-aa3d-91cf2bda7eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469302} {:answer/id #uuid "0ae5e117-a505-5a04-81e4-439b74052c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469303}] :answer-field/correct {:answer/id #uuid "0ae5e117-a505-5a04-81e4-439b74052c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469303} :answer-field/id #uuid "0829ea20-3a9e-5bac-9aac-a20a5031708f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470263} {:answer-field/choices [{:answer/id #uuid "86ea0788-dc9f-5b43-b4d9-3e6d92f4a3f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469304} {:answer/id #uuid "16e976b2-1f3b-5daf-bc6f-ee9f3ff92e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469305}] :answer-field/correct {:answer/id #uuid "16e976b2-1f3b-5daf-bc6f-ee9f3ff92e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469305} :answer-field/id #uuid "55766021-6ec3-5fd5-927e-a3d5966052e8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470264} {:answer-field/choices [{:answer/id #uuid "584ceae8-0e69-5969-b025-a8dfde1e4426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469306} {:answer/id #uuid "24a75a78-d9f9-590b-98ed-a75a55f1195e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469307}] :answer-field/correct {:answer/id #uuid "584ceae8-0e69-5969-b025-a8dfde1e4426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469306} :answer-field/id #uuid "44fe36b7-f90a-541a-a159-56cfdbf08c21" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f6a64ec-417d-5f3c-a079-819cbc656ca3" :question/math-academy-id "q-83440" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2}}$ be a set of linearly independent vectors in ${R}^{3}.$ Consider the following statement:\n\n*If  $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}$, then $\\underline{\\phantom{xxxxxx}}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{nullity}(T)=2$\n- **II.** $\\text{rank}(T)=1$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}$ and the set ${{v}_{1},{v}_{2}}$ is linearly independent, we get that $\\text{nullity}(T)=2.$\n\n- Statement II is true. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 3$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"} :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505097} :db/id #edb/ref 17592186505856}]} {:db/id #edb/ref 17592186366483 :knowledge-point/_questions [{:db/id #edb/ref 17592186133951 :knowledge-point/id #uuid "da20ffe7-173b-5fc0-8629-3b9b70222860" :knowledge-point/title "Identifying True Statements About Orthogonal Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049606 :topic/id #uuid "03f0df59-343c-5dd7-ad4a-b7bacf1e1f44" :topic/math-academy-id 2105 :topic/title "Orthogonal Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b65968b-6028-551a-9631-58b67db16afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469374} {:answer/id #uuid "a75e0f1b-240f-5f97-b88c-017b10166d2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469375}] :answer-field/correct {:answer/id #uuid "7b65968b-6028-551a-9631-58b67db16afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469374} :answer-field/id #uuid "b7a2f7a7-5e01-577f-9f82-f523dd836563" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470299} {:answer-field/choices [{:answer/id #uuid "c8af276a-607f-58cb-95a3-dfb795f49d12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469376} {:answer/id #uuid "de04d0f8-5260-5b89-a3cd-b666a82c85fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469377}] :answer-field/correct {:answer/id #uuid "c8af276a-607f-58cb-95a3-dfb795f49d12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469376} :answer-field/id #uuid "2d01531c-c3a3-5572-8137-9d105c60ab89" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470300} {:answer-field/choices [{:answer/id #uuid "0feb765d-c901-5436-a1e5-1524e2608115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469378} {:answer/id #uuid "aadde301-7372-5694-8cca-d9b6c7b72bd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469379}] :answer-field/correct {:answer/id #uuid "0feb765d-c901-5436-a1e5-1524e2608115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469378} :answer-field/id #uuid "e169f11f-de5b-5f0d-ad57-d18c3a6c238d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470301}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e6401598-f82b-58db-b408-23496dde6519" :question/math-academy-id "q-84344" :question/problem "Which of the following statements are true regarding the $n\\times n$ orthogonal matrices $P$ and $Q?$\n- **I.** $2PQ$ is always orthogonal\n- **II.** $P-Q$ is always orthogonal\n- **III.** $P$ is **not** invertible\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a matrix $Q$ is orthogonal if and only if\n\n$$\nQ{Q}^{T}={Q}^{T}Q=I.\n$$\n\nTo check that a matrix is orthogonal, it is sufficient to check that the above equation is satisfied.\n\nMoreover, we have the following properties:\n\n- For any orthogonal matrix $Q,$ we have ${Q}^{-1}={Q}^{T}.$\n\n- $(AB)^{T}={B}^{T}{A}^{T}$ for conformable matrices $A$ and $B.$\n\nWith that in mind, let's inspect each of the statements in turn.\n\n- Statement I is false. Computing the product $(2PQ)\\cdot (2PQ)^{T},$ we obtain\n\n$$\n\\begin{aligned}(2PQ)\\cdot (2PQ)^{T} & =2PQ\\cdot 2{Q}^{T}{P}^{T} \\\\  & =4P(Q{Q}^{T}){P}^{T} \\\\  & =4P(I){P}^{T} \\\\  & =4I \\\\  & \\ne I.\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the following subtraction of two orthogonal matrices:\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}-\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nThe resulting matrix is not orthogonal since, for example, its first column is not normalized.\n\n- Statement III is false. The inverse of an orthogonal matrix $P$ is given by ${P}^{-1}={P}^{T}.$\n\nTherefore, the correct answer is \"None of the statements are true\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049606 :topic/id #uuid "03f0df59-343c-5dd7-ad4a-b7bacf1e1f44" :topic/math-academy-id 2105 :topic/title "Orthogonal Matrices"} :activity/title "Orthogonal Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520751} :db/id #edb/ref 17592186521613}]} {:db/id #edb/ref 17592186366490 :knowledge-point/_questions [{:db/id #edb/ref 17592186133951 :knowledge-point/id #uuid "da20ffe7-173b-5fc0-8629-3b9b70222860" :knowledge-point/title "Identifying True Statements About Orthogonal Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049606 :topic/id #uuid "03f0df59-343c-5dd7-ad4a-b7bacf1e1f44" :topic/math-academy-id 2105 :topic/title "Orthogonal Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a454a558-e9c9-559c-8c56-52e733918130" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469380} {:answer/id #uuid "93599e5b-ce93-5b16-a5b8-85ac566f908e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469381}] :answer-field/correct {:answer/id #uuid "93599e5b-ce93-5b16-a5b8-85ac566f908e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469381} :answer-field/id #uuid "08b21958-5070-57d3-ab7f-c8d4fa998b69" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470302} {:answer-field/choices [{:answer/id #uuid "861675fc-dffe-5e49-8d64-223921d9e84a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469382} {:answer/id #uuid "e927ecab-f475-5bf8-84b4-be36a9c65426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469383}] :answer-field/correct {:answer/id #uuid "e927ecab-f475-5bf8-84b4-be36a9c65426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469383} :answer-field/id #uuid "600fda14-a171-59e1-b8a6-d69e1c29474d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470303} {:answer-field/choices [{:answer/id #uuid "7d0a2b49-a427-56fc-9dbd-1ad4ffd42ff4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469384} {:answer/id #uuid "a9ef53d4-cbb1-5d21-b743-dd86c3da732c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469385}] :answer-field/correct {:answer/id #uuid "a9ef53d4-cbb1-5d21-b743-dd86c3da732c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469385} :answer-field/id #uuid "546258ed-c776-5904-bc1f-596ecebf3ec5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470304}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dcdd2917-752d-5fd1-ac2a-6a285cbe6a4f" :question/math-academy-id "q-84353" :question/problem "Which of the following statements are true regarding the $n\\times n$ orthogonal matrices $P$ and $Q?$\n- **I.** $Q$ is invertible\n- **II.** ${P}^{T}$ is orthogonal\n- **III.** ${Q}^{-1}$ is always orthogonal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a matrix $Q$ is orthogonal if and only if\n\n$$\nQ{Q}^{T}={Q}^{T}Q=I.\n$$\n\nTo check that a matrix is orthogonal, it is sufficient to check that the above equation is satisfied.\n\nMoreover, we have the following properties:\n\n- For any orthogonal matrix $Q,$ we have ${Q}^{-1}={Q}^{T}.$\n\n- $(AB)^{T}={B}^{T}{A}^{T}$ for conformable matrices $A$ and $B.$\n\nWith that in mind, let's inspect each of the statements in turn.\n\n- Statement I is true. The inverse of an orthogonal matrix $Q$ is given by ${Q}^{-1}={Q}^{T}.$\n\n- Statement II is true. Computing the product ${P}^{T}\\cdot ({P}^{T})^{T},$ we obtain\n\n$$\n\\begin{aligned}{P}^{T}\\cdot ({P}^{T})^{T} & ={P}^{T}\\cdot P \\\\  & =I.\\end{aligned}\n$$\n\n- Statement III is true. Computing the product ${Q}^{-1}\\cdot ({Q}^{-1})^{T},$ we obtain\n\n$$\n\\begin{aligned}{Q}^{-1}\\cdot ({Q}^{-1})^{T} & ={Q}^{T}\\cdot ({Q}^{T})^{T} \\\\  & ={Q}^{T}Q \\\\  & =I.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186366511 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros" :topic/_knowledge-points [{:db/id #edb/ref 17592186050376 :topic/id #uuid "44312a5e-e7e0-507f-86f6-c3bcdecfd7fe" :topic/math-academy-id 1964 :topic/title "The Characteristic Equation of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3139a9d-4709-52dc-b082-fa6e7262b4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451863} {:answer/id #uuid "6611bee2-086e-5458-82d6-29162e06ef7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451864}] :answer-field/correct {:answer/id #uuid "6611bee2-086e-5458-82d6-29162e06ef7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451864} :answer-field/id #uuid "3b3c705f-a12e-5ec7-9d9e-7cfb964eab33" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452779} {:answer-field/choices [{:answer/id #uuid "80fd8012-3fa3-5669-b4d0-1a4677a6674d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451865} {:answer/id #uuid "f4d74f60-32b7-5c05-af9d-16a41f64d1c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451866}] :answer-field/correct {:answer/id #uuid "f4d74f60-32b7-5c05-af9d-16a41f64d1c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451866} :answer-field/id #uuid "061f5f16-a1a6-5a40-b334-2790c7680235" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452780} {:answer-field/choices [{:answer/id #uuid "ceb7b4d4-53de-5934-8e1a-b0b8206b39b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451867} {:answer/id #uuid "3f9d8d40-8af7-502f-800e-af1a162fcfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451868}] :answer-field/correct {:answer/id #uuid "3f9d8d40-8af7-502f-800e-af1a162fcfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451868} :answer-field/id #uuid "a5bb764e-2d9e-5196-a9d1-56181fe324ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ad99f7f-a225-5eb9-a085-4dc337f7e2b1" :question/math-academy-id "q-86752" :question/problem "$$\nD=\\begin{bmatrix}-1 & -2 & 4 & 6 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & -2 & 0 & 5 \\\\ 0 & 0 & 0 & -7\\end{bmatrix}.\n$$\n\nConsider the matrix $D$ given above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\lambda =2$ is an eigenvalue of $D$\n\n- **II.** $\\lambda =-1$ is an eigenvalue of $D$\n\n- **III.** The eigenvalue $\\lambda =-1$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,D-\\lambda I:$\n﻿﻿﻿\n\n$$\nD-\\lambda I=\\begin{bmatrix}-1-\\lambda  & -2 & 4 & 6 \\\\ 0 & 1-\\lambda  & -1 & 0 \\\\ 0 & -2 & -\\lambda  & 5 \\\\ 0 & 0 & 0 & -7-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(D-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(D-\\lambda I) & =0 \\\\ \\begin{vmatrix}-1-\\lambda  & -2 & 4 & 6 \\\\ 0 & 1-\\lambda  & -1 & 0 \\\\ 0 & -2 & -\\lambda  & 5 \\\\ 0 & 0 & 0 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )\\begin{vmatrix}1-\\lambda  & -1 & 0 \\\\ -2 & -\\lambda  & 5 \\\\ 0 & 0 & -7-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(-1-\\lambda )(-7-\\lambda )\\begin{vmatrix}1-\\lambda  & -1 \\\\ -2 & -\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )(-7-\\lambda )((1-\\lambda )(-\\lambda )-2) & =0 \\\\ (\\lambda +1)(\\lambda +7)({\\lambda }^{2}-\\lambda -2) & =0 \\\\ (\\lambda +1)(\\lambda +7)(\\lambda -2)(\\lambda +1) & =0 \\\\ (\\lambda +1)^{2}(\\lambda +7)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $D$ are $\\lambda =-1$ (with algebraic multiplicity $2$), $\\lambda =-7$ and $\\lambda =2.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186366553 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9295980c-7c10-56c7-9256-1029bff3fede" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469644} {:answer/id #uuid "2f281361-566f-564e-90f3-dc8456c7c329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469645}] :answer-field/correct {:answer/id #uuid "2f281361-566f-564e-90f3-dc8456c7c329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469645} :answer-field/id #uuid "24260372-e2e3-556d-a806-f1f44e080cec" :answer-field/key "P" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470434} {:answer-field/choices [{:answer/id #uuid "579254ab-eaa2-510b-8f52-1e585f11c777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469646} {:answer/id #uuid "15fc8fd0-d708-5fc9-8945-923588741ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469647}] :answer-field/correct {:answer/id #uuid "15fc8fd0-d708-5fc9-8945-923588741ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469647} :answer-field/id #uuid "b2923d22-92c3-5826-8e93-69df978fa286" :answer-field/key "Q" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470435} {:answer-field/choices [{:answer/id #uuid "0273c12c-e70d-5a16-93e2-dabca0aa2e62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469648} {:answer/id #uuid "3790c260-bda0-5fd6-a07c-35ad33e66535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469649}] :answer-field/correct {:answer/id #uuid "0273c12c-e70d-5a16-93e2-dabca0aa2e62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469648} :answer-field/id #uuid "b418d0be-8006-5748-bc6f-012ee528be28" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c1ef725-7db0-58fe-a7db-0097c019b6b6" :question/math-academy-id "q-93987" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}1 & 5 \\\\ 5 & -1\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & -2 & 0.5 \\\\ -2 & 0 & 3 \\\\ 0.5 & 3 & -1\\end{bmatrix},\\,R=\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""} {:db/id #edb/ref 17592186366560 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0860eddb-8872-5a14-90cd-ea80f80450d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469656} {:answer/id #uuid "a9503884-f719-56eb-b3d2-1bbf12f445b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469657}] :answer-field/correct {:answer/id #uuid "a9503884-f719-56eb-b3d2-1bbf12f445b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469657} :answer-field/id #uuid "2ceb7b39-d9d7-59a0-905c-bc078aea9c08" :answer-field/key "P" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470440} {:answer-field/choices [{:answer/id #uuid "0316227b-bc46-5340-873c-fb4bdb297900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469658} {:answer/id #uuid "73b30d62-76b6-5783-bbcb-a165c097c0d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469659}] :answer-field/correct {:answer/id #uuid "0316227b-bc46-5340-873c-fb4bdb297900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469658} :answer-field/id #uuid "e0a912f5-f285-5920-8fe7-d7356920694f" :answer-field/key "Q" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470441} {:answer-field/choices [{:answer/id #uuid "36ff6b0b-7b61-5a1d-b03e-95adb11dc3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469660} {:answer/id #uuid "8c62d2d7-9891-554e-bbb7-c20ffae1d6d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469661}] :answer-field/correct {:answer/id #uuid "36ff6b0b-7b61-5a1d-b03e-95adb11dc3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469660} :answer-field/id #uuid "ab17f333-c773-595b-b978-1a56da303bcf" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470442}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a97d726e-d379-5097-84d8-abb6b0a769af" :question/math-academy-id "q-93992" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}-1 & \\frac{1}{2} \\\\ \\frac{1}{2} & 1\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix},\\,R=\\begin{bmatrix}1 & 2 & 1 \\\\ -1 & 2 & 3 \\\\ 1 & 3 & 3\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{23}\\ne {q}_{32},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}1 & 2 & 1 \\\\ -1 & 2 & 3 \\\\ 1 & 3 & 3\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$P$ only.\""} {:db/id #edb/ref 17592186366608 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c35f8969-6bb9-503c-b423-baf9ba63f251" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469794} {:answer/id #uuid "f2ac1f94-ccb4-5a6b-ba7f-e5e557bfddf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469795}] :answer-field/correct {:answer/id #uuid "c35f8969-6bb9-503c-b423-baf9ba63f251" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469794} :answer-field/id #uuid "9c445df9-5547-539a-8b68-d1638570ff4a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470509} {:answer-field/choices [{:answer/id #uuid "9b7c7aed-2927-5e90-a205-e235a342c35b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469796} {:answer/id #uuid "2bed5c08-7e4a-5683-bf39-316bd5100fc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469797}] :answer-field/correct {:answer/id #uuid "2bed5c08-7e4a-5683-bf39-316bd5100fc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469797} :answer-field/id #uuid "d396cbe4-dbaa-5006-8ccf-4a8aadfb8964" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470510} {:answer-field/choices [{:answer/id #uuid "d963f76c-6988-585e-a71b-75d8f8601841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469798} {:answer/id #uuid "9f964fca-b809-5920-9514-190c5687344b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469799}] :answer-field/correct {:answer/id #uuid "9f964fca-b809-5920-9514-190c5687344b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469799} :answer-field/id #uuid "d4bf78bd-6326-5679-9a2d-eb9d8351ce04" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd51b750-1389-5155-b65d-c0946321f8d3" :question/math-academy-id "q-95388" :question/problem "Which of the following vector spaces are finite-dimensional?\n- **I.** $D(R),$ the vector space of all differentiable functions on $R$\n- **II.** ${\\text{M}}_{10\\times 100}(R),$ the vector space of all $10\\times 100$ matrices over $R$\n- **III.** ${R}_{200}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $200$\n\nSelect all that apply." :question/worked-solution "Let's examine our vector spaces.\n\n- $D(R)$ is *not* finite-dimensional. To understand why, we first note that the following subset of $D(R)$ is linearly independent:\n\n$$\n{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in R$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $D(R)$  of size $n,$ which imples that $D(R)$ cannot have finite dimension.     .\n\n- ${\\text{M}}_{10\\times 100}(R)$ and ${R}_{200}[t]$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{10\\times 100}(R))=10\\cdot 100=1\\,000\n$$\n\n \nand\n\n$$\n\\text{dim}({R}_{200}[t])=200+1=201,\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186366636 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c6e59cf-eefe-5e7d-9e31-a8784bb64fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452197} {:answer/id #uuid "21e11fcb-04eb-552c-a533-7cc128693eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452198}] :answer-field/correct {:answer/id #uuid "21e11fcb-04eb-552c-a533-7cc128693eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452198} :answer-field/id #uuid "99c5561a-1c1f-5380-a23d-ed36c45bd3f7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452946} {:answer-field/choices [{:answer/id #uuid "73d0b8cb-9801-5fc9-a55c-c637e3fd779a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452199} {:answer/id #uuid "f773140f-7c60-560e-8d94-6114e21180eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452200}] :answer-field/correct {:answer/id #uuid "73d0b8cb-9801-5fc9-a55c-c637e3fd779a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452199} :answer-field/id #uuid "b81448bd-7bd9-5f9c-a66a-2e21a29d3fec" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452947} {:answer-field/choices [{:answer/id #uuid "73bd6dbf-2be9-5c2b-8fad-7080e8da1057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452201} {:answer/id #uuid "a2c1e16b-b961-57ac-90e1-29a223838bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452202}] :answer-field/correct {:answer/id #uuid "a2c1e16b-b961-57ac-90e1-29a223838bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452202} :answer-field/id #uuid "c352f51f-c826-5af3-a439-3bb54f1ba94c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66a9cbb1-7460-5af7-96d5-cd936a2ef154" :question/math-academy-id "q-95405" :question/problem "Given that $A$ is an $8\\times 8$ real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is orthogonally diagonalizable\n- **II.** $A$ must have $8$ real and distinct eigenvalues\n- **III.** If $u$ and $v$ are two eigenvectors that correspond to different eigenvalues, then $u⊥v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, any symmetric matrix with real entries is orthogonally diagonalizable.\n\n- Statement II is false. According to the spectral theorem, the eigenvalues are real but not necessarily distinct. This occurs when the characteristic polynomial has roots whose (algebraic) multiplicity is greater than $1.$\n\n- Statement III is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"} :activity/title "The Spectral Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559000} :db/id #edb/ref 17592186559892}]} {:db/id #edb/ref 17592186366643 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82cbba1a-f069-5a33-a2d1-b502c99b2b3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452203} {:answer/id #uuid "dc6ac186-7f49-5faa-93e6-ca668251994b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452204}] :answer-field/correct {:answer/id #uuid "82cbba1a-f069-5a33-a2d1-b502c99b2b3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452203} :answer-field/id #uuid "6e0776b3-44ee-59b9-afc3-45d560491387" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452949} {:answer-field/choices [{:answer/id #uuid "d482a9a1-475e-5fcc-bafe-deb4762a9d2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452205} {:answer/id #uuid "54115a6d-0ff0-5c69-9194-8cdd62d05b82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452206}] :answer-field/correct {:answer/id #uuid "54115a6d-0ff0-5c69-9194-8cdd62d05b82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452206} :answer-field/id #uuid "c4206f3a-3ee1-5441-9ffb-b57c2618eba7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452950} {:answer-field/choices [{:answer/id #uuid "3455c3f3-d151-520c-b72e-9874313639d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452207} {:answer/id #uuid "69ca346c-3af4-5c9e-91d8-6637dc8c1dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452208}] :answer-field/correct {:answer/id #uuid "69ca346c-3af4-5c9e-91d8-6637dc8c1dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452208} :answer-field/id #uuid "fa13589e-7777-52d2-8d09-0d1f83bbcf12" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42059a97-8b39-59cb-bae6-eab5799ef586" :question/math-academy-id "q-95409" :question/problem "Given that $A$ is a $4\\times 4$ real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is not diagonalizable\n- **II.** If $u$ and $v$ are two eigenvectors that correspond to different eigenvalues, then $u⊥v$\n- **III.** $A$ must have $4$ real (not necessarily distinct) eigenvalues" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the theorem, any symmetric matrix with real entries is orthogonally diagonalizable, hence, is diagonalizable.\n\n- Statement II is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\n- Statement III is true. Indeed, a $4\\times 4$ matrix has $4$ (not necessarily distinct) eigenvalues and the eigenvalues of a symmetric matrix are real.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186366650 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d9fb91-ae25-53ed-a33c-52e7f364db71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452209} {:answer/id #uuid "4c814939-1a7e-5031-9e14-64d8c9b51ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452210}] :answer-field/correct {:answer/id #uuid "4c814939-1a7e-5031-9e14-64d8c9b51ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452210} :answer-field/id #uuid "1d68a3af-4038-51ee-9cc7-15a7b64191e6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452952} {:answer-field/choices [{:answer/id #uuid "7914c4bc-6016-5c15-9903-b3e24296b928" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452211} {:answer/id #uuid "98ac60b1-7d42-5198-abee-c2977adfc88a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452212}] :answer-field/correct {:answer/id #uuid "7914c4bc-6016-5c15-9903-b3e24296b928" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452211} :answer-field/id #uuid "fa8226b8-812d-57b4-8dff-7d10faebed24" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452953} {:answer-field/choices [{:answer/id #uuid "61ee797c-7e47-51b1-b65a-01a807de3be9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452213} {:answer/id #uuid "ac26379d-5127-5f07-aecb-9307a97b011c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452214}] :answer-field/correct {:answer/id #uuid "61ee797c-7e47-51b1-b65a-01a807de3be9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452213} :answer-field/id #uuid "99678f97-4a7f-57fc-8ce5-ae8e7084ae62" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0baadb2d-d441-5a17-add5-c8350f576311" :question/math-academy-id "q-95700" :question/problem "Given that $A$ is a $6\\times 6$ real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is orthogonally diagonalizable\n- **II.** $A$ must have $36$ real eigenvalues\n- **III.** If $u$ and $v$ are two eigenvectors, then $u$ is parallel to $v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, any symmetric matrix with real entries is orthogonally diagonalizable.\n\n- Statement II is false. According to the spectral theorem, the eigenvalues are real but there are not $36$ of them. An $n\\times n$ matrix has at most $n$ distinct eigenvalues.\n\n- Statement III is false. According to the theorem, eigenvectors corresponding to different eigenvalues must be orthogonal. So if the two eigenvalues correspond to different eigenvalues, they cannot be parallel.\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"} :activity/title "The Spectral Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559000} :db/id #edb/ref 17592186559951}]} {:db/id #edb/ref 17592186366657 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049849 :topic/id #uuid "1887f465-a1b8-5370-82f6-80e02b9d153a" :topic/math-academy-id 3120 :topic/title "The Spectral Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a37efe81-e4e1-5a83-93e0-08cabbfe53d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452215} {:answer/id #uuid "2a6cbf3a-43ca-51ee-8eb3-b50854600205" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452216}] :answer-field/correct {:answer/id #uuid "2a6cbf3a-43ca-51ee-8eb3-b50854600205" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452216} :answer-field/id #uuid "479f0a5a-bddd-55ed-aa58-35002f747d6d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452955} {:answer-field/choices [{:answer/id #uuid "26c13ebd-2fcf-502b-bb98-1a35a8d3954c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452217} {:answer/id #uuid "9e9346d4-95e8-50e0-a1f6-50b3b049ce5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452218}] :answer-field/correct {:answer/id #uuid "9e9346d4-95e8-50e0-a1f6-50b3b049ce5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452218} :answer-field/id #uuid "43fd6f8e-d6c4-55b8-83df-719636ccff26" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452956} {:answer-field/choices [{:answer/id #uuid "01499ffa-8b4c-5e53-aadb-bcf349545ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452219} {:answer/id #uuid "a978bc16-54ab-589d-955b-d621b0ea98ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452220}] :answer-field/correct {:answer/id #uuid "01499ffa-8b4c-5e53-aadb-bcf349545ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452219} :answer-field/id #uuid "a126a47e-711d-55e4-b163-1b04af3cc6c1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452957}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "531e02eb-ae49-5805-b616-b28b7ddc3a97" :question/math-academy-id "q-95702" :question/problem "Given that $A$ is a $7\\times 7$ real symmetric matrix whose roots of the characteristic polynomial have multiplicity equal to $1,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $u$ and $v$ are two eigenvectors that correspond to the same eigenvalue, then $u$ is parallel to $v$\n- **II.** $A$ must have $7$ real and distinct eigenvalues\n- **III.** $A$ is orthogonal" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the theorem, eigenvectors corresponding to different eigenvalues must be orthogonal. But two eigenvectors that correspond to the same eigenvalue will always be parallel if the geometric multiplicity of the eigenvalue is $1.$\n\n- Statement II is true. Indeed, the eigenvalues of a symmetric matrix are real. Also, since the roots of the characteristic polynomial have (algebraic) multiplicity all equal to $1,$ the eigenvalues are all distinct.\n\n- Statement III is false. According to the theorem, any symmetric matrix with real entries is orthogonally diagonalizable, but not necessarily orthogonal.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186366718 :knowledge-point/_questions [{:db/id #edb/ref 17592186172029 :knowledge-point/id #uuid "7a6bbb34-a43f-5e16-8a24-25c0d6970a38" :knowledge-point/title "Identifying a Quadratic Curve Type From Its Reduced Equation: No Cross-Product Term" :topic/_knowledge-points [{:db/id #edb/ref 17592186050760 :topic/id #uuid "64670a5e-dd35-51fc-bd24-210590f74fcd" :topic/math-academy-id 3336 :topic/title "Classifying Quadratic Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bf4e76a-3e69-5df8-aa83-036f966abd9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469800} {:answer/id #uuid "7a49c557-85d3-5090-94ea-4936242de870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469801}] :answer-field/correct {:answer/id #uuid "8bf4e76a-3e69-5df8-aa83-036f966abd9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469800} :answer-field/id #uuid "ac6afe36-c38f-50b2-8661-ed83db10ddea" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470512} {:answer-field/choices [{:answer/id #uuid "5b42ef67-ca74-5b6b-9a27-0020c5e96699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469802} {:answer/id #uuid "65006734-0d95-5936-a0e3-ef37c8602ed9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469803}] :answer-field/correct {:answer/id #uuid "5b42ef67-ca74-5b6b-9a27-0020c5e96699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469802} :answer-field/id #uuid "c3f1528a-e085-51b6-bebe-f7aa6f28819f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470513} {:answer-field/choices [{:answer/id #uuid "413cf20b-5ae7-5ba3-b881-4f921314ed2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469804} {:answer/id #uuid "b7a0c67e-b3f0-5f31-b17c-15e34178268e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469805}] :answer-field/correct {:answer/id #uuid "b7a0c67e-b3f0-5f31-b17c-15e34178268e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469805} :answer-field/id #uuid "a18c0e07-fb20-5a04-bff6-1eb62f90e1ef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470514}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66610d66-38e7-5d9e-b883-9467a5f6ad73" :question/math-academy-id "q-95897" :question/problem "Which of the following equations define a non-empty set of points in the ${x}_{1}{x}_{2}$ plane?\n- **I.** $2{x}_{2}^{2}+1=0$\n- **II.** $-2{x}_{1}^{2}-3{x}_{2}^{2}=2$\n- **III.** ${x}_{1}^{2}+{x}_{2}=0$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the equations in turn.\n\n- The equation $2{x}_{2}^{2}+1=0$ defines an empty set. Notice that the left-hand side is positive for all ${x}_{2},$ while the right-hand side is zero.\n\n- The equation $-2{x}_{1}^{2}-3{x}_{2}^{2}=2$ defines an empty set. Notice that the left-hand side is non-positive for all ${x}_{1}$ and ${x}_{2},$ while the right-hand side is  positive.\n\n- The equation ${x}_{1}^{2}+{x}_{2}=0$ defines a non-empty set in the ${x}_{1}{x}_{2}$-plane. It represents a parabola that opens in the direction of the negative ${x}_{2}$-axis.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186366739 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118 :topic/title "Symmetric Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed889475-ee9c-533a-8ed7-519387cf84ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452275} {:answer/id #uuid "62ca60ad-f94f-54fa-a2aa-9d8d07b4e4cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452276}] :answer-field/correct {:answer/id #uuid "62ca60ad-f94f-54fa-a2aa-9d8d07b4e4cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452276} :answer-field/id #uuid "c3d3a26b-faad-53a5-854d-c0ce0d455ccd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452985} {:answer-field/choices [{:answer/id #uuid "ecf353d3-2d53-5e63-8b1b-661cb9cb2eea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452277} {:answer/id #uuid "909b121b-5859-5703-a1e4-479d1c1bdd03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452278}] :answer-field/correct {:answer/id #uuid "ecf353d3-2d53-5e63-8b1b-661cb9cb2eea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452277} :answer-field/id #uuid "c1c88bb5-4a8e-5849-bf4a-edd46eb5f6a3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452986} {:answer-field/choices [{:answer/id #uuid "570d980e-c237-5c27-a69f-2dee15bb061a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452279} {:answer/id #uuid "8e4665db-639e-5f41-9895-fb286356fc79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452280}] :answer-field/correct {:answer/id #uuid "8e4665db-639e-5f41-9895-fb286356fc79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452280} :answer-field/id #uuid "4c01aa01-2f35-5253-9a12-c161f9fc3268" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452987}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "df6e5142-313f-5de3-a45d-4da4b737f0bd" :question/math-academy-id "q-96594" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The sum of two $n\\times n$ diagonal matrices is always symmetric.\n- **II.** If $A$ is *any* $n\\times n$ matrix, then ${A}^{-1}$ is always symmetric (if it exists).\n- **III.** If $A$ is *any* matrix, then ${A}^{T}A$ is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any diagonal matrices $A$ and $B,$ we have\n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the non-singular matrix \n\n$\\,$ $A=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, ${A}^{-1}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any $m\\times n$ matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{T}A)^{T} & ={A}^{T}({A}^{T})^{T} \\\\  & ={A}^{T}A.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186366773 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane" :topic/_knowledge-points [{:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9099ef15-a1bf-5b8d-b674-d360c6aadda0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452311} {:answer/id #uuid "8e1abad4-8933-51f0-817c-845930bc0ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452312}] :answer-field/correct {:answer/id #uuid "8e1abad4-8933-51f0-817c-845930bc0ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452312} :answer-field/id #uuid "c524b1b4-bbda-5e7e-890d-f074894a05f4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453003} {:answer-field/choices [{:answer/id #uuid "9ddf10a9-2422-536a-afd4-fa994f101802" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452313} {:answer/id #uuid "245d7eb5-f7c7-52bc-aee9-07abe4358c15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452314}] :answer-field/correct {:answer/id #uuid "245d7eb5-f7c7-52bc-aee9-07abe4358c15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452314} :answer-field/id #uuid "c2341323-e8a8-593f-ac40-f2d6042f60fe" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453004} {:answer-field/choices [{:answer/id #uuid "0f1a969b-4d20-56b8-a302-390ca21fb96c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452315} {:answer/id #uuid "38ab8235-cad9-5536-9cf5-1a513f15a9d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452316}] :answer-field/correct {:answer/id #uuid "0f1a969b-4d20-56b8-a302-390ca21fb96c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452315} :answer-field/id #uuid "57938303-0bc4-5294-929a-a9e479e34260" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbb0c470-3f82-5cd2-8de9-680715504460" :question/math-academy-id "q-97077" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto  ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨-1,0⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)={0}$\n- **III.** $\\text{nullity}(T)=2$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, The condition $\\text{rank}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Im}(T)={R}^{2}.\n$$\n\nHence, $T$ is surjective and so  $⟨-1,0⟩\\in \\text{Im}(T).$\n\n- Statement II is true. Indeed, the condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={0}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186366780 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane" :topic/_knowledge-points [{:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12eb12db-c865-5a15-995f-57d1e99856b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452323} {:answer/id #uuid "fa2992f7-296f-52e8-8e2f-b1875fa14a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452324}] :answer-field/correct {:answer/id #uuid "12eb12db-c865-5a15-995f-57d1e99856b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452323} :answer-field/id #uuid "12ebab7b-febe-5850-8be3-97869ab43f9b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453009} {:answer-field/choices [{:answer/id #uuid "dff232c6-f90e-549a-bf5d-1544c0d7eb35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452325} {:answer/id #uuid "cc22eb64-3d36-5f56-935a-3d6d0d508e49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452326}] :answer-field/correct {:answer/id #uuid "cc22eb64-3d36-5f56-935a-3d6d0d508e49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452326} :answer-field/id #uuid "9583cd23-de18-5d81-9215-33038a6df612" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453010} {:answer-field/choices [{:answer/id #uuid "d092dba5-3f4c-5126-93c1-b72bf8d37079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452327} {:answer/id #uuid "3d4acc6c-2043-51df-a00b-c80988412bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452328}] :answer-field/correct {:answer/id #uuid "d092dba5-3f4c-5126-93c1-b72bf8d37079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452327} :answer-field/id #uuid "5957978d-2e1f-5607-8d63-c7b81149356e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453011}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2335439b-17b4-5a3d-b1ce-91063205bf0d" :question/math-academy-id "q-97079" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto the line $y=2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨2,1⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=2$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1,\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. The point $(2,1)$ does not satisfy the equation of the line $y=2x$ since $1\\ne 2\\cdot 2.$ Hence, \n\n$$\n⟨2,1⟩\\notin \\text{Im}(T).\n$$\n\n- Statement II is true. Since $\\text{nullity}(T)=1,$ we get \n\n$$\n\\text{Ker}(T)\\ne {0}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=1.\n$$\n\nTherefore, the correct answer is \"II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"} :activity/title "The Image of a Linear Transformation in the Cartesian Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553853} :db/id #edb/ref 17592186554734}]} {:db/id #edb/ref 17592186366794 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c502c08e-cbb1-5442-bcb9-424b6777ac3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438664} {:answer/id #uuid "003139e8-881a-52b3-9ea9-221baca3d942" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438665}] :answer-field/correct {:answer/id #uuid "c502c08e-cbb1-5442-bcb9-424b6777ac3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438664} :answer-field/id #uuid "ee174a06-895c-5583-812c-7c4468fa2511" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439361} {:answer-field/choices [{:answer/id #uuid "4493f073-130a-5643-b440-425f3034460d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438666} {:answer/id #uuid "0508c95e-9b72-5cb3-8464-ae610809503a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438667}] :answer-field/correct {:answer/id #uuid "0508c95e-9b72-5cb3-8464-ae610809503a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438667} :answer-field/id #uuid "495bc1a5-e85e-5043-b4d4-3fe8b15554ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439362} {:answer-field/choices [{:answer/id #uuid "b1502369-e88d-503e-90f4-0f6ab218c61c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438668} {:answer/id #uuid "516ece6f-6106-541c-abfc-8c583469231d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438669}] :answer-field/correct {:answer/id #uuid "516ece6f-6106-541c-abfc-8c583469231d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438669} :answer-field/id #uuid "e222facc-8617-59fb-b0f3-b2ffe6c181c7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439363}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e3acb77-06f5-5592-8e02-3140d23a412e" :question/math-academy-id "q-9835" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n- **I.** $det(D)=1$\n- **II.** $D$ is a singular matrix\n- **III.** $det(D)=0$\n\n \n\n$$\nD=\\begin{bmatrix}1 & 2 & 3 \\\\ 1 & 4 & 5 \\\\ 1 & 6 & 7\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}1 & 2 & 3 \\\\ 1 & 4 & 5 \\\\ 1 & 6 & 7\\end{aligned}| \\\\  & =1|\\begin{aligned}4 & 5 \\\\ 6 & 7\\end{aligned}|-2|\\begin{aligned}1 & 5 \\\\ 1 & 7\\end{aligned}|+3|\\begin{aligned}1 & 4 \\\\ 1 & 6\\end{aligned}| \\\\  & =1(28-30)-2(7-5)+3(6-4) \\\\  & =1\\cdot (-2)-2\\cdot 2+3\\cdot 2 \\\\  & =-2-4+6 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements II and III are true."} {:db/id #edb/ref 17592186366945 :knowledge-point/_questions [{:db/id #edb/ref 17592186115334 :knowledge-point/id #uuid "bf19e2ee-7c42-58b0-9254-5a44f315288a" :knowledge-point/title "Identifying Block Diagonal and Block Triangular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048221 :topic/id #uuid "8959dd0b-8ef2-54bf-b8d9-d9b2606263cd" :topic/math-academy-id 1735 :topic/title "Partitioned and Block Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ead9eb7-6179-5dd3-bb4d-a0b6266823fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468870} {:answer/id #uuid "8b9840e8-0b71-5152-86ba-99ddfd860c5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468871}] :answer-field/correct {:answer/id #uuid "3ead9eb7-6179-5dd3-bb4d-a0b6266823fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468870} :answer-field/id #uuid "ea3fe40b-78a5-502f-88f4-ea17a1a7eed1" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470047} {:answer-field/choices [{:answer/id #uuid "63f648f4-6b6b-54ca-b233-6007032093f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468872} {:answer/id #uuid "3b188c3a-165e-5a4d-8e93-a4c74af56e13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468873}] :answer-field/correct {:answer/id #uuid "63f648f4-6b6b-54ca-b233-6007032093f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468872} :answer-field/id #uuid "bac8d59a-f4f8-59b0-a422-e8fcb6fc24d7" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470048} {:answer-field/choices [{:answer/id #uuid "b5d9824e-7b54-553e-bf8d-b4f60f9d4401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468874} {:answer/id #uuid "ad3e8787-8c89-5c14-83be-c185f11748cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468875}] :answer-field/correct {:answer/id #uuid "ad3e8787-8c89-5c14-83be-c185f11748cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468875} :answer-field/id #uuid "3202f73f-6a44-5bd9-9c2c-4f8276a03317" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3da29d09-2c10-59b3-aafb-a3f2d64ea706" :question/math-academy-id "q-109246" :question/problem "Which of the following matrices are block upper triangular?\n\n$$\nA=\\begin{bmatrix}4 & 0 \\\\ 9 & -2\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 8 & 9 \\\\ 0 & -1 & 3 \\\\ 4 & 0 & 2\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 5 \\\\ 4 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A block upper triangular matrix can be partitioned so that it has only square blocks on the main diagonal, and the blocks below the main diagonal contain only zeros.\n\nWith that in mind, let's examine our matrices.\n\n- $A$is *not* a block upper triangular matrix since it can't be partitioned in the way described above:\n\n$$\nA=\\begin{bmatrix}4 & 0 \\\\ 9 & -2\\end{bmatrix}\n$$\n\n- $B$ is *not* a block upper triangular matrix since it can't be partitioned in the way described above:\n\n$$\n\\begin{aligned}B=\\begin{bmatrix}3 & 8 & 9 \\\\ 0 & -1 & 3 \\\\ 4 & 0 & 2\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 8 & 9 \\\\ 0 & -1 & 3 \\\\ 4 & 0 & 2\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 8 & 9 \\\\ 0 & -1 & 3 \\\\ 4 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\n- $C$ is a block upper triangular matrix. Indeed, we can partition it as follows:\n\n$$\nC=\\begin{bmatrix}1 & 0 & 5 \\\\ 4 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$C$ only.\""} {:db/id #edb/ref 17592186367338 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050032 :topic/id #uuid "277bf882-73ab-515e-84e5-4f7920acb235" :topic/math-academy-id 2549 :topic/title "The Superposition Principle"}]}] :question/