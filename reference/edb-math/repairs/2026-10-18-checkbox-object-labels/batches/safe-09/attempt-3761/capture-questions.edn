7592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472033} {:answer-field/choices [{:answer/id #uuid "61f4501f-edca-5eac-9fc0-0d791a3d313d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471057} {:answer/id #uuid "24c6fb10-a538-5ef7-acb6-b358afac5aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471058}] :answer-field/correct {:answer/id #uuid "24c6fb10-a538-5ef7-acb6-b358afac5aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471058} :answer-field/id #uuid "e8b22cd2-a990-590c-90c2-2600d5219d90" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472034}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77f2cd70-5c51-5abc-8136-b13970866790" :question/math-academy-id "q-156681" :question/problem "Let $Π$ be the plane with equation $z=x+y$ in ${R}^{3}.$ Which of the following statements are true? \n\nI. $Π$ contains the zero-vector\n\nII. $Π$ is closed under vector addition\n\nIII. $Π$ is closed under scalar multiplication\n\nIV. $Π$ is a subspace of ${R}^{3}$\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ x+y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The coordinates of the zero-vector satisfy the equation $z=x+y:$\n\n$$\n\\begin{aligned}z & =x+y \\\\ (0) & =(0)+(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement II is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+{a}_{2}\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}+{b}_{2}\\end{bmatrix}\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+{a}_{2}\\end{bmatrix}+\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}+{b}_{2}\\end{bmatrix}=\\begin{bmatrix}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ ({a}_{1}+{a}_{2})+({b}_{1}+{b}_{2})\\end{bmatrix}=\\begin{bmatrix}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ ({a}_{1}+{b}_{1})+({a}_{2}+{b}_{2})\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x+y.$ Therefore, $a+b\\in Π.$\n\n- Statement III is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+{a}_{2}\\end{bmatrix}\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+{a}_{2}\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k({a}_{1}+{a}_{2})\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k{a}_{1}+k{a}_{2}\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x+y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement IV is true. Since statements II and III are true, the plane $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\""} {:db/id #edb/ref 17592186376054 :knowledge-point/_questions [{:db/id #edb/ref 17592186119927 :knowledge-point/id #uuid "83796fe8-f045-5dbc-94d1-6d6e031f3ed8" :knowledge-point/title "Determining Whether a Line Is a Subspace of Three-Dimensional Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186051046 :topic/id #uuid "7cf616eb-2b54-52d2-8407-1b2fc912b2d9" :topic/math-academy-id 1853 :topic/title "Subspaces of N-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12dfb173-85de-53de-8bbb-769e3ff393b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471059} {:answer/id #uuid "dee9be9f-4d3b-54bb-b16b-61cd95251fe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471060}] :answer-field/correct {:answer/id #uuid "12dfb173-85de-53de-8bbb-769e3ff393b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471059} :answer-field/id #uuid "98f7413f-d2af-5cef-8961-04ae15531969" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472035} {:answer-field/choices [{:answer/id #uuid "5daac8d8-5f6f-5451-86d9-365c0f6282a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471061} {:answer/id #uuid "c23b81bd-b600-5fba-9034-aa425ea45b14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471062}] :answer-field/correct {:answer/id #uuid "5daac8d8-5f6f-5451-86d9-365c0f6282a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471061} :answer-field/id #uuid "359f2089-4bbe-5fdf-a7c3-8c747afc5255" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472036} {:answer-field/choices [{:answer/id #uuid "69b3e9f5-b9e7-5b2c-b9df-8010d612b348" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471063} {:answer/id #uuid "68ee5432-10cb-51f0-885c-08f97a2fa22f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471064}] :answer-field/correct {:answer/id #uuid "69b3e9f5-b9e7-5b2c-b9df-8010d612b348" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471063} :answer-field/id #uuid "659695e3-c6ca-568b-aa80-eef126aeff96" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472037} {:answer-field/choices [{:answer/id #uuid "71fc54c9-49f4-50e5-81f0-4f589a575427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471065} {:answer/id #uuid "feb87bed-8997-5d53-80a5-8aa6ed79649d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471066}] :answer-field/correct {:answer/id #uuid "71fc54c9-49f4-50e5-81f0-4f589a575427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471065} :answer-field/id #uuid "c353328a-e322-53ed-a610-69474e8dc78a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472038}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55724e97-d014-5bc4-825e-d54d7bbd24c4" :question/math-academy-id "q-157462" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,-1,2)$ and $(1,2,0).$ Which of the following statements are true?\n- **I.** $L$ contains the zero-vector\n- **II.** $L$ is closed under vector addition\n- **III.** $L$ is closed under scalar multiplication\n- **IV.** $L$ is a subspace of ${R}^{3}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false.The direction vector of the line $L$ is \n\n$$\nd=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}.\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\nx=\\frac{y+1}{3}=\\frac{z-2}{-2}.\n$$\n\nBut this line does not pass through the origin since \n\n$$\n(0)\\ne \\frac{(0)+1}{3}\\ne \\frac{(0)-2}{-2}.\\,\\times \n$$\n\n- Statement II is false. Let's consider the vectors $\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}$ from $L$ (the position vectors of the given points). Then,\n\n$$\n\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nHowever, the point $(1,1,2)$ does not belong to $L$ since\n\n$$\n(1)\\ne \\frac{(1)+1}{3}\\ne \\frac{(2)-2}{-2}.\\,\\times \n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is false. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186376061 :knowledge-point/_questions [{:db/id #edb/ref 17592186119928 :knowledge-point/id #uuid "4f3018fd-9d16-578f-b050-966890844c9b" :knowledge-point/title "Determining Whether a Plane Is a Subspace of Three-Dimensional Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186051046 :topic/id #uuid "7cf616eb-2b54-52d2-8407-1b2fc912b2d9" :topic/math-academy-id 1853 :topic/title "Subspaces of N-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c937576f-6d5f-55a1-8ab7-74336373ddca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471067} {:answer/id #uuid "47583555-84d1-5a39-b1b9-e6047a8944af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471068}] :answer-field/correct {:answer/id #uuid "c937576f-6d5f-55a1-8ab7-74336373ddca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471067} :answer-field/id #uuid "6ab90d14-b0ba-5a9b-855f-b992a23b0955" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472039} {:answer-field/choices [{:answer/id #uuid "b2ee9f06-9f88-5319-ab23-eafad8031298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471069} {:answer/id #uuid "32c5a5bd-0cd6-58b3-8aca-cdd9c3ba44f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471070}] :answer-field/correct {:answer/id #uuid "b2ee9f06-9f88-5319-ab23-eafad8031298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471069} :answer-field/id #uuid "c0460439-3543-5a2d-8246-30fddc3afbca" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472040} {:answer-field/choices [{:answer/id #uuid "4e8c45b4-79e9-59f1-8aed-0fe57c1e774f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471071} {:answer/id #uuid "7b261e97-d4f1-5864-8cd7-0b630c489dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471072}] :answer-field/correct {:answer/id #uuid "4e8c45b4-79e9-59f1-8aed-0fe57c1e774f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471071} :answer-field/id #uuid "09e759f3-3ea4-52e5-91d5-d81ad7bd1e88" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472041} {:answer-field/choices [{:answer/id #uuid "34a389ed-2a90-5310-9d49-d9de078d0e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471073} {:answer/id #uuid "14b87aa4-7616-54b5-993b-17ac7bcfc6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471074}] :answer-field/correct {:answer/id #uuid "34a389ed-2a90-5310-9d49-d9de078d0e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471073} :answer-field/id #uuid "9bac6d2b-71be-5d31-8a9c-1f6b199802d9" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472042}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f7a73387-34bf-50c1-bd13-d6c9025be3b5" :question/math-academy-id "q-157470" :question/problem "Let $Π$ be the plane with equation $2x-y+z=2$ in ${R}^{3}.$ Which of the following statements are true? \n- **I.** $Π$ contains the zero-vector\n- **II.** $Π$ is closed under vector addition\n- **III.** $Π$ is closed under scalar multiplication\n- **IV.** $Π$ is a subspace of ${R}^{3}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ 2-2x+y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The line does not pass through the origin since\n\n$$\n\\begin{aligned}2x-y+z & =2 \\\\ 2(0)-(0)+(0) & =2 \\\\ 0 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let's consider $a=\\begin{bmatrix}0 \\\\ 0 \\\\ 2\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}0 \\\\ -2 \\\\ 0\\end{bmatrix}\\in Π.$ Then \n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ 0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -2 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0+0 \\\\ 0+(-2) \\\\ 2+0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -2 \\\\ 2\\end{bmatrix},\\end{aligned}\n$$\n\nHowever, $\\begin{bmatrix}0 \\\\ -2 \\\\ 2\\end{bmatrix}$ does not belong to $Π$ since \n\n$$\n\\begin{aligned}2x-y+z & =2 \\\\ 2(0)-(-2)+(2) & =2 \\\\ 4 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin Π,$ this set is not closed under scalar multiplication.\n\n- Statement IV is false. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186376068 :knowledge-point/_questions [{:db/id #edb/ref 17592186119928 :knowledge-point/id #uuid "4f3018fd-9d16-578f-b050-966890844c9b" :knowledge-point/title "Determining Whether a Plane Is a Subspace of Three-Dimensional Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186051046 :topic/id #uuid "7cf616eb-2b54-52d2-8407-1b2fc912b2d9" :topic/math-academy-id 1853 :topic/title "Subspaces of N-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "700557ce-6572-5ee2-a07f-34d93423cafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471075} {:answer/id #uuid "c353aaf6-90db-54f4-992e-599b27b80250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471076}] :answer-field/correct {:answer/id #uuid "700557ce-6572-5ee2-a07f-34d93423cafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471075} :answer-field/id #uuid "334fdb1c-33a5-5fc3-a6c1-ca14b6176b0d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472043} {:answer-field/choices [{:answer/id #uuid "fa1b9382-ab0d-51d1-b161-c5849bc1195f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471077} {:answer/id #uuid "f0f7775c-4896-5c6a-a1a8-3b9527a4b11d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471078}] :answer-field/correct {:answer/id #uuid "fa1b9382-ab0d-51d1-b161-c5849bc1195f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471077} :answer-field/id #uuid "6a505b43-dfd2-5534-9a4c-af0066c726a3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472044} {:answer-field/choices [{:answer/id #uuid "5d03f060-6ebf-5283-a886-1008c9f73000" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471079} {:answer/id #uuid "2d73b1c0-28c1-5f56-9383-71e8c8e7cd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471080}] :answer-field/correct {:answer/id #uuid "5d03f060-6ebf-5283-a886-1008c9f73000" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471079} :answer-field/id #uuid "40d38ef1-5e92-5126-b1e0-b9dca3c1fa9f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472045} {:answer-field/choices [{:answer/id #uuid "85d0b485-371d-58e9-a8c2-75e1166ae969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471081} {:answer/id #uuid "5634bb41-dbfb-535e-8b35-09eb6c38952c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471082}] :answer-field/correct {:answer/id #uuid "85d0b485-371d-58e9-a8c2-75e1166ae969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471081} :answer-field/id #uuid "894f59eb-e3c4-5a32-80d8-8b6c6c7a4fbb" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472046}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b6fdf40e-16e2-5d4d-87e5-0c2a5c46b067" :question/math-academy-id "q-157475" :question/problem "Let $Π$ be the plane with equation $3x+2y+z=1$ in ${R}^{3}.$ Which of the following statements are true? \n- **I.** $Π$ contains the zero-vector\n- **II.** $Π$ is closed under vector addition\n- **III.** $Π$ is closed under scalar multiplication\n- **IV.** $Π$ is a subspace of ${R}^{3}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ 1-3x-2y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The line does not pass through the origin since\n\n$$\n\\begin{aligned}3x+2y+z & =1 \\\\ 3(0)+2(0)+(0) & =1 \\\\ 0 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let's consider $a=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}\\in Π.$ Then \n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0+1 \\\\ 0+(-1) \\\\ 1+0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix},\\end{aligned}\n$$\n\nHowever, $\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}$ does not belong to $Π$ since \n\n$$\n\\begin{aligned}3x+2y+z & =1 \\\\ 3(1)+2(-1)+(1) & =1 \\\\ 2 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin Π,$ this set is not closed under scalar multiplication.\n\n- Statement IV is false. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186376075 :knowledge-point/_questions [{:db/id #edb/ref 17592186105861 :knowledge-point/id #uuid "16a6f0f7-4003-5908-8b1b-68d218fdcb8f" :knowledge-point/title "Determining Whether a Function Is a Valid PDF" :topic/_knowledge-points [{:db/id #edb/ref 17592186049638 :topic/id #uuid "0748b9c2-fae7-5522-9655-db9e6f1d50c0" :topic/math-academy-id 1347 :topic/title "Probability Density Functions of Continuous Random Variables"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90dcc132-8806-58fb-a61c-c95866435d63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471083} {:answer/id #uuid "a05fbe18-c3e4-5725-92fa-ba8d739ac71f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471084}] :answer-field/correct {:answer/id #uuid "a05fbe18-c3e4-5725-92fa-ba8d739ac71f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471084} :answer-field/id #uuid "1a594e37-46ef-5d1a-a4b8-4c13868d3694" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472047} {:answer-field/choices [{:answer/id #uuid "8de8aee8-e7ae-5809-8bc3-2c539b8dd567" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471085} {:answer/id #uuid "7b060391-9171-5280-8d27-3a79c55dea31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471086}] :answer-field/correct {:answer/id #uuid "7b060391-9171-5280-8d27-3a79c55dea31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471086} :answer-field/id #uuid "dfb01ced-752c-59fa-9642-732e03a75fa1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472048} {:answer-field/choices [{:answer/id #uuid "a6849ec8-7cdf-569c-a934-902d354767eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471087} {:answer/id #uuid "c817c900-ca18-5d1e-9e95-3c8c1d11b310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471088}] :answer-field/correct {:answer/id #uuid "c817c900-ca18-5d1e-9e95-3c8c1d11b310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471088} :answer-field/id #uuid "172b3a05-bb98-5af8-9278-d9fa53e3c4cd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cced02f8-7b29-5540-80d2-baca7e098b0d" :question/math-academy-id "q-158417" :question/problem "![](images/52/52cb038e475b4d0d5de64684340e7291e0c8cd82072f2f30a1c4025af69cc809.png)\n\nConsider the function $f(x)$ whose graph is shown above.\n\n$$\nf(x)={\\begin{aligned}2x,\\, & 0\\le x<1, \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\n- $f(x)\\ge 0$ for all $x$\n- ${\\int }_{0}^{1}f(x)\\,\\text{d}x=1$\n- $f(x)$ is a valid probability density function\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. From the graph, we see that $f(x)$ is nonnegative for all $x.$\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(x)\\,\\text{d}x & ={\\int }_{0}^{1}2x\\,\\text{d}x \\\\  & ={[{x}^{2}]}_{0}^{1} \\\\  & =[{1}^{2}]-[{0}^{2}] \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is true. Since statements I and II are true, $f(x)$ is a valid probability density function.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186376082 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9d5b57d-d397-5e8b-9a46-ca703dc128d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453430} {:answer/id #uuid "654fdd13-26b0-5b13-a201-e47a6bbd127f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453431}] :answer-field/correct {:answer/id #uuid "654fdd13-26b0-5b13-a201-e47a6bbd127f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453431} :answer-field/id #uuid "f245c56b-ea24-5bc6-9714-193572353072" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454465} {:answer-field/choices [{:answer/id #uuid "c17641c7-2616-5f44-913a-204e61d02795" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453432} {:answer/id #uuid "1798276f-6c7e-5444-91e4-9f13f58ce650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453433}] :answer-field/correct {:answer/id #uuid "1798276f-6c7e-5444-91e4-9f13f58ce650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453433} :answer-field/id #uuid "2595354c-4c90-5eb8-bc56-8aa27847f7cd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454466} {:answer-field/choices [{:answer/id #uuid "7f28fa17-78af-5e9c-9940-0619d6581c75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453434} {:answer/id #uuid "03c6eb37-ee8b-5456-b1b0-d792a68992e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453435}] :answer-field/correct {:answer/id #uuid "7f28fa17-78af-5e9c-9940-0619d6581c75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453434} :answer-field/id #uuid "55044069-05bd-53df-bf38-5763c4c860a7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454467}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80400990-b978-5e6c-95c6-54cde07862e6" :question/math-academy-id "q-158534" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y\\le x+2},\\,∂A={(x,y)\\in {R}^{2}:y=x+2}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(2,4)$ lies on the boundary of $A$\n- **II.** The point $P(2,4)$ belongs to $A$\n- **III.** The point $Q(-2,3)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie on or below the line $y=x+2.$ A sketch of this region is shown below:\n\n![](images/3b/3b0505f0c1fb295665dd64c9d0f26f23960b638ef0e1d414c7ad306a89154dfb.png)\n\nLet's add the points $P(2,4)$ and $Q(-2,3)$ and some neighborhoods of these points to our diagram.\n\n![](images/62/623f00c423c7a846c52537d58c071c730083ba963fb488dbedbb76637ea9cc8c.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(2,4)$ satisfy the equation $y=x+2.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. The coordinates of $P(2,4)$ satisfy the inequality $y\\le x+4.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I and II only.'" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"} :activity/title "Interior and Boundary Points" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481566} :db/id #edb/ref 17592186481687}]} {:db/id #edb/ref 17592186376089 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2a38983-2ac2-5747-84de-52654204b669" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453442} {:answer/id #uuid "24fa1281-9195-576c-958f-f5a1cd7756b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453443}] :answer-field/correct {:answer/id #uuid "24fa1281-9195-576c-958f-f5a1cd7756b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453443} :answer-field/id #uuid "b974481d-3120-5f01-a603-07099f42a784" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454471} {:answer-field/choices [{:answer/id #uuid "5f4a6e95-fed8-5f60-b3be-40a55090ad74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453444} {:answer/id #uuid "0fc66c24-39c8-55f8-949a-fd3c22a45e0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453445}] :answer-field/correct {:answer/id #uuid "5f4a6e95-fed8-5f60-b3be-40a55090ad74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453444} :answer-field/id #uuid "4ab5754e-a652-5899-87ab-53e612a79fd5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454472} {:answer-field/choices [{:answer/id #uuid "c545dbcc-3d3d-5d7f-8c9e-39f107e5337c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453446} {:answer/id #uuid "7b177e0f-f566-534e-911c-092b634ea208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453447}] :answer-field/correct {:answer/id #uuid "c545dbcc-3d3d-5d7f-8c9e-39f107e5337c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453446} :answer-field/id #uuid "7ac4f957-7cd7-55eb-a39f-2fc8342eb8a5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7257b8a6-8ea5-5027-98d4-5845f1b59c79" :question/math-academy-id "q-158548" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y<x+3},\\,∂A={(x,y)\\in {R}^{2}:y=x+3}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(-2,1)$ lies on the boundary of $A$\n- **II.** The point $P(-2,1)$ belongs to $A$\n- **III.** The point $Q(-2,3)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie below the line $y=x+3.$ A sketch of this region is shown below:\n\n![](images/7a/7a23cbece856b7b842d5907665af5ea593a06faea79283b1be13fc4382e0bf26.png)\n\nLet's add the points $P(-2,1)$ and $Q(-2,3)$ and some neighborhoods of these points to our diagram.\n\n![](images/82/82c921570bbc1ce700db5472871048c14c67df7d6895962f87454c70fc1ce192.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(-2,1)$ satisfy $y=x+3.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is false. The coordinates of $P(-2,1)$ do not satisfy the inequality $y<x+3.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement III is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I only.'" :step/_content [{:activity/_steps {:activity/title "Quiz 12" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186552855} :db/id #edb/ref 17592186553681}]} {:db/id #edb/ref 17592186376096 :knowledge-point/_questions [{:db/id #edb/ref 17592186124635 :knowledge-point/id #uuid "b34c9c06-e884-5758-a184-39330a07d8cd" :knowledge-point/title "Identifying Interior and Boundary Points of Sets of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ff2597b-4563-52dd-97bd-79931863e5bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471089} {:answer/id #uuid "c64121cc-495f-5d02-8baa-6347a5757f61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471090}] :answer-field/correct {:answer/id #uuid "c64121cc-495f-5d02-8baa-6347a5757f61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471090} :answer-field/id #uuid "e5738039-4384-58fe-ba54-1ac5ac80b370" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472050} {:answer-field/choices [{:answer/id #uuid "4ba8d4db-3185-546a-9558-c0532b074b4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471091} {:answer/id #uuid "c5c061e7-01b4-514b-badc-0fe24712237a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471092}] :answer-field/correct {:answer/id #uuid "c5c061e7-01b4-514b-badc-0fe24712237a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471092} :answer-field/id #uuid "47c6223b-9267-5508-b98c-7c2d2e8d01e6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472051} {:answer-field/choices [{:answer/id #uuid "668d955d-390f-5905-adc9-a8877fa264d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471093} {:answer/id #uuid "e62939fe-e47a-5ae6-8bda-ff784b7b4a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471094}] :answer-field/correct {:answer/id #uuid "668d955d-390f-5905-adc9-a8877fa264d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471093} :answer-field/id #uuid "197eb59a-025c-5dfb-8852-a076b6a377f3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82163da2-d426-5778-8627-90a3d54226a1" :question/math-academy-id "q-159253" :question/problem "![](images/b3/b3ea4dd786ab1ff777c7667bb94df36e2c04ceaefba8e4506754d1ec79d03641.png)\n\nConsider the set $M=[-2,0)\\cup (0,2]$ and the points $A,$ $B,$ and $C,$ shown above. Which of the following statements are true?\n\n- $A$ is an interior point of the set $M$\n- $B$ is a boundary point of the set $M$\n- $C$ is an interior point of the set $M$\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}\\in R$ is the set of points whose distance from ${x}_{0}$ is *smaller than* $\\delta :$ \n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nA neighborhood of ${x}_{0}$ is given by the open interval $({x}_{0}-\\delta ,{x}_{0}+\\delta ),$ shown below.\n\n![](images/f8/f889352f25e7936d0e5ea76585a979efbb301da61f7e99a937e979af93ee0664.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. The point $A$ is an interior point since there exists an open neighborhood of $A$ that is fully contained inside the set $M.$\n\n![](images/c9/c9acfd3e5e7d179904ba69d3473e5f8644055e777fa679e665cfb9199793d218.png)\n\n- Statement II is true. The point $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$ Notice that $B$ does not belong to $M$ and $B$ belongs to any open neighborhood of $B.$\n\n![](images/74/7480978db0850ff426ed4747ee7dfb81781ad7222f97fca0d6106c800d99fcbf.png)\n\n- Statement III is false. The point $C$ is *not* an interior point of $M$ since any neighborhood of $C$ contains at least one point *outside* the set.\n\n![](images/4f/4fb2567d76963e586370ee771f359b3ba051941d650d9d1f0dc58f47bb770ab4.png)\n\nTherefore, the correct answer is 'I and II only.'"} {:db/id #edb/ref 17592186376103 :knowledge-point/_questions [{:db/id #edb/ref 17592186124635 :knowledge-point/id #uuid "b34c9c06-e884-5758-a184-39330a07d8cd" :knowledge-point/title "Identifying Interior and Boundary Points of Sets of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eb02c31-7aaa-5f27-b88d-0bac5e5ad915" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471095} {:answer/id #uuid "b97e2bd8-7962-5731-ba0e-3fbbb462b382" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471096}] :answer-field/correct {:answer/id #uuid "b97e2bd8-7962-5731-ba0e-3fbbb462b382" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471096} :answer-field/id #uuid "9d50bd4b-9d59-580e-80c2-44d2596ae2d2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472053} {:answer-field/choices [{:answer/id #uuid "2061a619-a5e4-54b1-91b8-46d58be4ebda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471097} {:answer/id #uuid "0fe9756c-7be4-5f9a-b46e-b99e86db76bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471098}] :answer-field/correct {:answer/id #uuid "2061a619-a5e4-54b1-91b8-46d58be4ebda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471097} :answer-field/id #uuid "8a8ac79c-036b-59a8-86e0-7503a1be86e8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472054} {:answer-field/choices [{:answer/id #uuid "5c8bab23-b03e-52ee-ae9d-30f1b5066d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471099} {:answer/id #uuid "5d0e0cf0-0b66-548e-8160-cac53743805a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471100}] :answer-field/correct {:answer/id #uuid "5d0e0cf0-0b66-548e-8160-cac53743805a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471100} :answer-field/id #uuid "9cffa612-f7f9-54e4-b510-6f7c9d3f046b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472055}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82499ed8-8929-5ffd-bdf0-732a59ce454e" :question/math-academy-id "q-159265" :question/problem "![](images/c4/c4a50ae5f62dc5c52d0060a969d510453d3f922fad8f7ba887b2b1ee77fceae6.png)\n\nConsider the set $M=(-\\infty ,-1]\\cup [1,\\infty )$ and the points $A,$ $B,$ and $C,$ shown above. Which of the following statements are true?\n\n- $A$ is a boundary point of the set $M$\n- $B$ is an interior point of the set $M$\n- $C$ is an interior point of the set $M$\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}\\in R$ is the set of points whose distance from ${x}_{0}$ is *smaller than* $\\delta :$ \n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nA neighborhood of ${x}_{0}$ is given by the open interval $({x}_{0}-\\delta ,{x}_{0}+\\delta ),$ shown below.\n\n![](images/f8/f889352f25e7936d0e5ea76585a979efbb301da61f7e99a937e979af93ee0664.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. The point $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n![](images/e8/e847aa005e917a88b19566933e3770edd05ddee946fc25dfd6fed91016bb909d.png)\n\n- Statement II is false. The point $B$ is *not* an interior point of $M$ since any neighborhood of $B$ contains at least one point *outside* the set.\n\n![](images/51/51439f6021efd768268e59c63627449cc68c9a420c4c7a80ab6773dd46e6ec1f.png)\n\n- Statement III is true. The point $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\n![](images/dd/ddd471167f604b4ba97b36ddff3af6be7c7d3cfad6021a4cfc779c6f8ebb2a3d.png)\n\nTherefore, the correct answer is 'I and III only.'" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"} :activity/title "Interior and Boundary Points" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481566} :db/id #edb/ref 17592186481705}]} {:db/id #edb/ref 17592186376110 :knowledge-point/_questions [{:db/id #edb/ref 17592186124635 :knowledge-point/id #uuid "b34c9c06-e884-5758-a184-39330a07d8cd" :knowledge-point/title "Identifying Interior and Boundary Points of Sets of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/id #uuid "cdb710e4-10cf-5554-8041-f24c448bbdae" :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f7134e-0413-5493-b5ac-15d4ba28ba08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471101} {:answer/id #uuid "835a584d-b0a9-5f05-8080-ffa33c185d64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471102}] :answer-field/correct {:answer/id #uuid "06f7134e-0413-5493-b5ac-15d4ba28ba08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471101} :answer-field/id #uuid "e62b53c0-c439-5e2d-9680-fe8ad1611219" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472056} {:answer-field/choices [{:answer/id #uuid "fbd59ee7-1ac2-5275-ae13-0098c9e35f58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471103} {:answer/id #uuid "69e84841-66bf-56ab-a6b7-29c3fe23921e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471104}] :answer-field/correct {:answer/id #uuid "69e84841-66bf-56ab-a6b7-29c3fe23921e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471104} :answer-fi