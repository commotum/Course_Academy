id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469970} {:answer/id #uuid "d1b4e732-d0af-5cb2-919e-58d902106e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469971}] :answer-field/correct {:answer/id #uuid "d1b4e732-d0af-5cb2-919e-58d902106e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469971} :answer-field/id #uuid "f2c6fa40-e8a2-5a5e-8732-9fe57109d620" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d67a28ee-e52e-5e0c-b902-450c792552a6" :question/math-academy-id "q-98715" :question/problem "![](images/4a/4a2c0103fb348883b05692721162ffba17758beb0e6f944deb328a506fed8d21.png)\n\nConsiderer the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\nI. $y=4$ is a source.\n\nII. $y=2$ is a node.\n\nIII. $y=-1$ is a sink.\n\nSelect all that apply." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/df/df340c40982e6d22ef8a815bf043f84fd78b43b4ddc1763845d03d4b2c793aee.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=4$ is a sink.\n\n- Statement II is false. From the phase line, we see that $y=2$ is a source.\n\n- Statement III is true. From the phase line, we see that $y=-1$ is a sink.\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186362322 :knowledge-point/_questions [{:db/id #edb/ref 17592186147495 :knowledge-point/id #uuid "4535b48e-a33f-5f62-95d3-a5c0991c1f6d" :knowledge-point/title "Classifying Equilibrium Points Using a Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048131 :topic/id #uuid "81e52842-e868-5110-93ce-65b6024b5770" :topic/math-academy-id 2533 :topic/title "Classifying Equilibrium Solutions of First-Order ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e5cb174-b867-5b4a-bc5e-45a2f387bc11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469972} {:answer/id #uuid "b4360480-6fa6-563f-96f2-ec111a05e810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469973}] :answer-field/correct {:answer/id #uuid "6e5cb174-b867-5b4a-bc5e-45a2f387bc11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469972} :answer-field/id #uuid "68b7957e-3c4f-5fc4-9326-7956b432c78f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470598} {:answer-field/choices [{:answer/id #uuid "43095516-c6d2-551c-bbcb-22ace06a831a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469974} {:answer/id #uuid "c62f0353-fd74-5679-94c9-c1a055e23d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469975}] :answer-field/correct {:answer/id #uuid "43095516-c6d2-551c-bbcb-22ace06a831a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469974} :answer-field/id #uuid "8dca6b39-8898-5087-b848-10df7e157a0a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470599} {:answer-field/choices [{:answer/id #uuid "ad7f6e59-d971-5f4f-9543-895b927b322c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469976} {:answer/id #uuid "0661e77d-dbeb-50ad-88d7-4257221b8320" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469977}] :answer-field/correct {:answer/id #uuid "0661e77d-dbeb-50ad-88d7-4257221b8320" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469977} :answer-field/id #uuid "b9010a8b-ce0b-575e-bb63-f714ca1d31d1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99cb8df0-a236-544f-967a-a702cdee4d6f" :question/math-academy-id "q-98752" :question/problem "![](images/31/3114d1c94b63a2506a66e701346bc7367b901659b78a2cf7c191648c96a716dc.png)\n\nConsider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\nI. $y=3$ is a node.\n\nII. $y=-1$ is a sink.\n\nIII. $y=-1$ is a source.\n\nSelect all that apply." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/f7/f72f89ecad74cc708b5950763002757d9d012d3859c7a5bd5eb19ae60fc54e55.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=3$ is a sink.\n\n- Statement II is false while statement III is true. From the phase line, we see that $y=-1$ is a source.\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186362340 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ac7900-ea05-5cc8-9d53-11c30c4ca60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440029} {:answer/id #uuid "91747f90-b1ca-5a23-b764-3011370995c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440030}] :answer-field/correct {:answer/id #uuid "37ac7900-ea05-5cc8-9d53-11c30c4ca60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440029} :answer-field/id #uuid "536c4571-b3d8-5ac6-b419-3f6f71056077" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440372} {:answer-field/choices [{:answer/id #uuid "d1e4cb25-b3e5-5104-8ec6-1f86c12d56d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440031} {:answer/id #uuid "7ff679bc-fdfb-5669-bd8b-854d2358190c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440032}] :answer-field/correct {:answer/id #uuid "7ff679bc-fdfb-5669-bd8b-854d2358190c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440032} :answer-field/id #uuid "e5c431c2-1fb0-5a03-b48d-74276cb322b4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440373} {:answer-field/choices [{:answer/id #uuid "9399f58c-b270-5d89-8f0f-c6e1b2ae15a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440033} {:answer/id #uuid "7cd73f80-9ac4-5715-aa47-0376b208e6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440034}] :answer-field/correct {:answer/id #uuid "7cd73f80-9ac4-5715-aa47-0376b208e6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440034} :answer-field/id #uuid "f7c8be4f-cbe0-55fc-a506-530979c94394" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440374}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e554c090-e3bc-5a93-90b4-9f79a0997b62" :question/math-academy-id "q-9911" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$\\begin{bmatrix}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{bmatrix}$ is singular.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $k=-3$\n- **II.** $k=0$\n- **III.** $k=3$" :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}| & =1|\\begin{aligned}k & -k \\\\ k & k\\end{aligned}|-(-1)|\\begin{aligned}1 & -k \\\\ 5 & k\\end{aligned}|+k|\\begin{aligned}1 & k \\\\ 5 & k\\end{aligned}| \\\\  & =({k}^{2}+{k}^{2})+(k+5k)+k(k-5k) \\\\  & =2{k}^{2}+6k+k\\cdot (-4k) \\\\  & =2{k}^{2}+6k-4{k}^{2} \\\\  & =-2{k}^{2}+6k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}-2{k}^{2}+6k & =0 \\\\ k(-2k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=3.$"} {:db/id #edb/ref 17592186362380 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89bb2511-4d58-53a6-b9b5-74c3542580ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469978} {:answer/id #uuid "fc0a7a83-3e1c-5a9b-9f75-f328c10ce732" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469979}] :answer-field/correct {:answer/id #uuid "fc0a7a83-3e1c-5a9b-9f75-f328c10ce732" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469979} :answer-field/id #uuid "eb331c7b-46b8-5412-90c6-0761e3735ff8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470601} {:answer-field/choices [{:answer/id #uuid "130fc7c6-1257-566b-b96a-d4df3fe11cb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469980} {:answer/id #uuid "79193248-d925-54da-af8c-e2b310a2c7de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469981}] :answer-field/correct {:answer/id #uuid "130fc7c6-1257-566b-b96a-d4df3fe11cb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469980} :answer-field/id #uuid "2ff75dcf-d9ce-528d-b1c7-ac32d64afa17" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470602} {:answer-field/choices [{:answer/id #uuid "03b1fff9-b5b9-579a-9aa0-47db8a02aa23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469982} {:answer/id #uuid "de38171d-e241-5c73-9c59-fe2f6349bbd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469983}] :answer-field/correct {:answer/id #uuid "03b1fff9-b5b9-579a-9aa0-47db8a02aa23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469982} :answer-field/id #uuid "6b3c1549-aea3-54c3-ba0f-9b5729caa69d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "029fdb6a-d6ee-5a1f-bdd5-c75825b67c96" :question/math-academy-id "q-99635" :question/problem "$$\n{v}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n- **I.** ${v}_{1}⊥{v}_{3}$ with respect to the given inner product\n- **II.** ${v}_{2}⊥{v}_{3}$ with respect to the given inner product\n- **III.** $S={{v}_{1},{v}_{2},{v}_{3}}$ is an orthogonal set with respect to the given inner product\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =(-1)(1)+2(1)(2)+(1)(-3) \\\\  & =(-1)+4-3 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement I is false since\n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =(2)(1)+2(-1)(2)+(2)(-3) \\\\  & =2-4-6 \\\\  & =-8\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥̸{v}_{3}$ with respect to the given inner product.\n\n- Statement III is false. Since ${v}_{2}⊥̸{v}_{3},$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186362382 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a7789d-bf18-52bd-bc9b-301af5c6d5fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469984} {:answer/id #uuid "0055086d-aa25-5fda-b4af-c9666a64eb04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469985}] :answer-field/correct {:answer/id #uuid "0055086d-aa25-5fda-b4af-c9666a64eb04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469985} :answer-field/id #uuid "f5b78874-d300-5fa5-9795-d39ff2596e54" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470604} {:answer-field/choices [{:answer/id #uuid "fcbf6b25-801c-5c97-8c47-fa6594f98096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469986} {:answer/id #uuid "dd1f59b9-0ffa-5059-8021-bd1050c6ae27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469987}] :answer-field/correct {:answer/id #uuid "fcbf6b25-801c-5c97-8c47-fa6594f98096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469986} :answer-field/id #uuid "f1d427c5-5b56-5cfe-b771-f93205be779a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470605} {:answer-field/choices [{:answer/id #uuid "12d15ce6-683e-5205-83b1-3ef4c0c45fd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469988} {:answer/id #uuid "01c3bb42-0a0e-557a-a08c-494e7ee85d4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469989}] :answer-field/correct {:answer/id #uuid "01c3bb42-0a0e-557a-a08c-494e7ee85d4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469989} :answer-field/id #uuid "d8cf17fc-2cba-51b8-b0bf-47f1618c05ee" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "689e4d4d-2277-5c62-9cd6-9887b81429d8" :question/math-academy-id "q-99656" :question/problem "$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}4 \\\\ -1 \\\\ 1\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+2{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n- **I.** ${v}_{1}⊥{v}_{2}$ with respect to the given inner product\n- **II.** ${v}_{2}⊥̸{v}_{3}$ with respect to the given inner product\n- **III.** $S={{v}_{1},{v}_{2},{v}_{3}}$ is an orthogonal set with respect to the given inner product\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =(1)(4)+2(1)(-1)+2(-1)(1) \\\\  & =4-2-2 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement II is false since \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =(4)(0)+2(-1)(1)+2(1)(1) \\\\  & =0-2+2 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement III is true. Indeed, computing the inner product $⟨{v}_{1},{v}_{3}⟩$, we have \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =(1)(0)+2(1)(1)+2(-1)(1) \\\\  & =0+2-2 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\nAs a result, the set $S$ is orthogonal.\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"} :activity/title "Orthogonal Sets in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517479} :db/id #edb/ref 17592186518224}]} {:db/id #edb/ref 17592186362390 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "961a3bee-0aa7-5b3a-9490-64e96f97c0d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469990} {:answer/id #uuid "a379ae5f-f528-5be2-9828-0f082c70b0dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469991}] :answer-field/correct {:answer/id #uuid "a379ae5f-f528-5be2-9828-0f082c70b0dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469991} :answer-field/id #uuid "9695d404-e5b5-5119-b269-1365e2848754" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470607} {:answer-field/choices [{:answer/id #uuid "1131ba72-54f0-5869-80e4-5124768441a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469992} {:answer/id #uuid "974321a3-4afd-5560-9447-d00b39e3e328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469993}] :answer-field/correct {:answer/id #uuid "1131ba72-54f0-5869-80e4-5124768441a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469992} :answer-field/id #uuid "43b6849a-4395-57b5-9a47-f34aef60036a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470608} {:answer-field/choices [{:answer/id #uuid "d95b5dec-0d95-5892-99cd-3d44ced67f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469994} {:answer/id #uuid "90fba07c-0d7f-54bf-a9de-e9e4d0c05bf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469995}] :answer-field/correct {:answer/id #uuid "d95b5dec-0d95-5892-99cd-3d44ced67f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469994} :answer-field/id #uuid "cec511de-6ce2-5c26-905e-fb28356ffd0f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470609}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "06ea44bd-2468-51be-aabc-e31db5c657e5" :question/math-academy-id "q-99815" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={t}^{2},\\,{f}_{3}(t)=\\operatorname{sin}⁡t\n$$\n\nGiven that the inner product in the vector space $C[-\\pi ,\\pi ]$ of continuous functions over $[-\\pi ,\\pi ]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-\\pi }^{\\pi }f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n- **I.** ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product\n- **II.** ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n- **III.** $S={{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)}$ is an orthogonal set with respect to the given inner product\n\n*Hint: $⟨{f}_{2},{f}_{3}⟩=0.$*\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩ & =⟨t,{t}^{2}⟩ \\\\  & ={\\int }_{-\\pi }^{\\pi }t\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }{t}^{3}\\,\\text{d}t \\\\  & =\\frac{{t}^{4}}{4}{|}_{-\\pi }^{\\pi } \\\\  & =\\frac{{\\pi }^{4}}{4}-(\\frac{(-\\pi )^{4}}{4}) \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩=⟨t,\\operatorname{sin}⁡t⟩={\\int }_{-\\pi }^{\\pi }t\\operatorname{sin}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{sin}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{sin}⁡t\\,\\text{d}t=-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-\\pi }^{\\pi }t\\operatorname{sin}⁡t\\,\\text{d}t & =uv{|}_{-\\pi }^{\\pi }-{\\int }_{-\\pi }^{\\pi }{u}^{′}v\\,\\text{d}t \\\\  & =(-t\\operatorname{cos}⁡t){|}_{-\\pi }^{\\pi }-{\\int }_{-\\pi }^{\\pi }(-\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =(-\\pi \\cdot \\operatorname{cos}⁡(\\pi )-(-(-\\pi )\\cdot \\operatorname{cos}⁡(-\\pi )))+\\operatorname{sin}⁡t{|}_{-\\pi }^{\\pi } \\\\  & =\\pi +\\pi +(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )) \\\\  & =2\\pi \\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Since ${f}_{1}(t)⊥̸{f}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046660} :activity/title "Mathematical Methods for the Physical Sciences II: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186545198} :db/id #edb/ref 17592186545992}]} {:db/id #edb/ref 17592186362391 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcbe8ed8-a2e7-59a7-9dcd-ca895d94f772" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469996} {:answer/id #uuid "1b2456c5-a5b0-5c29-a226-52a11f29ba70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469997}] :answer-field/correct {:answer/id #uuid "1b2456c5-a5b0-5c29-a226-52a11f29ba70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469997} :answer-field/id #uuid "245ca49b-3ef1-5ba6-9c92-331b631ef8af" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470610} {:answer-field/choices [{:answer/id #uuid "862656ec-c41e-53ed-b5b1-593d83f896af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469998} {:answer/id #uuid "1101d9b7-2ce3-5a80-8a13-ab7fef2e907e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469999}] :answer-field/correct {:answer/id #uuid "862656ec-c41e-53ed-b5b1-593d83f896af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469998} :answer-field/id #uuid "c906d66a-475e-595f-a93e-72e736687fd0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470611} {:answer-field/choices [{:answer/id #uuid "c9d0153f-7d93-5c51-a0b3-bdfb99253f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470000} {:answer/id #uuid "a378038d-21ed-5b5c-81b1-271985e61763" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470001}] :answer-field/correct {:answer/id #uuid "c9d0153f-7d93-5c51-a0b3-bdfb99253f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470000} :answer-field/id #uuid "3f4e14fd-7f71-596e-94da-74a2248a0192" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470612}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c3132dd-8104-5475-a04a-6ba3130fe419" :question/math-academy-id "q-99822" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=\\operatorname{cos}⁡t,\\,{f}_{2}(t)={sin}^{2}⁡t,\\,{f}_{3}(t)=1\n$$\n\nGiven that the inner product in the vector space $C[0,\\pi ]$ of continuous functions over $[0,\\pi ]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{\\pi }f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nI. ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n\nII. ${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product\n\n*Hint: $⟨{f}_{1},{f}_{2}⟩=0.$*\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩ & =⟨\\operatorname{cos}⁡t,1⟩ \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =\\operatorname{sin}⁡t{|}_{0}^{\\pi } \\\\  & =\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡0 \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement II is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{3}(t)⟩=⟨{sin}^{2}⁡t,1⟩={\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the identity ${sin}^{2}⁡\\alpha =\\frac{1-\\operatorname{cos}⁡(2\\alpha )}{2}$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡(2t))\\,\\text{d}t \\\\  & =\\frac{1}{2}[t-\\frac{\\operatorname{sin}⁡(2t)}{2}]{|}_{0}^{\\pi } \\\\  & =\\frac{1}{2}[\\pi -\\frac{\\operatorname{sin}⁡(2\\pi )}{2}-(0-\\frac{\\operatorname{sin}⁡0}{2})] \\\\  & =\\frac{1}{2}[\\pi -0-(0-0)] \\\\  & =\\frac{\\pi }{2}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{2}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Since ${f}_{2}(t)⊥̸{f}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"} :activity/title "Orthogonal Sets in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186444798} :db/id #edb/ref 17592186444802}]} {:db/id #edb/ref 17592186362392 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7849511c-42aa-5936-80b4-cf27658d9334" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470002} {:answer/id #uuid "e185f1ae-0f4d-556c-b223-3d5dfc7f46f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470003}] :answer-field/correct {:answer/id #uuid "e185f1ae-0f4d-556c-b223-3d5dfc7f46f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470003} :answer-field/id #uuid "b018c44b-9122-56d8-b47c-5ed9492b1676" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470613} {:answer-field/choices [{:answer/id #uuid "37fee277-ed91-5718-8df4-97c172646d58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470004} {:answer/id #uuid "f141ac45-7382-50ba-b7cb-75b9ede77363" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470005}] :answer-field/correct {:answer/id #uuid "f141ac45-7382-50ba-b7cb-75b9ede77363" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470005} :answer-field/id #uuid "58c60371-84d6-5ccb-aa0c-f35fe237264d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470614} {:answer-field/choices [{:answer/id #uuid "6c240535-770a-5ae6-bcc0-9c4deb00ff77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470006} {:answer/id #uuid "b1721e3c-52c8-584e-98e8-7fdabdf53653" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470007}] :answer-field/correct {:answer/id #uuid "b1721e3c-52c8-584e-98e8-7fdabdf53653" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470007} :answer-field/id #uuid "b0c46d22-5599-543b-821a-3b2899b69934" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470615}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "30fad2b1-33b1-5011-baca-2c53469ec04d" :question/math-academy-id "q-99827" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=1,\\,{f}_{2}(t)=\\operatorname{cos}⁡t,\\,{f}_{3}(t)=\\operatorname{cos}⁡2t\n$$\n\nGiven that the inner product in the vector space $C[-\\pi ,\\pi ]$ of continuous functions over $[-\\pi ,\\pi ]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-\\pi }^{\\pi }f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nI. ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product\n\nII. ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product\n\n*Hint: $⟨{f}_{2},{f}_{3}⟩=0$*\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩ & =⟨1,\\operatorname{cos}⁡t⟩ \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =\\operatorname{sin}⁡t{|}_{-\\pi }^{\\pi } \\\\  & =\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡(-\\pi ) \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩ & =⟨1,\\operatorname{cos}⁡(2t)⟩ \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t \\\\  & =\\frac{\\operatorname{sin}⁡(2t)}{2}{|}_{-\\pi }^{\\pi } \\\\  & =\\frac{\\operatorname{sin}⁡(2\\pi )}{2}-\\frac{\\operatorname{sin}⁡(-2\\pi )}{2} \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is true. Since ${f}_{1}(t)⊥{f}_{2}(t),$ ${f}_{1}(t)⊥{f}_{3}(t),$ and ${f}_{2}(t)⊥{f}_{3}(t),$ the set $S$ is orthogonal.\n\nTherefore, the correct answer is \"I, II, and III.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"} :activity/title "Orthogonal Sets in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186444798} :db/id #edb/ref 17592186444799}]} {:db/id #edb/ref 17592186362393 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b691f2e-59ef-5455-8bc5-6c7175910247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470008} {:answer/id #uuid "989e3268-9d6c-51db-abd2-7a103ac5eb48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470009}] :answer-field/correct {:answer/id #uuid "989e3268-9d6c-51db-abd2-7a103ac5eb48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470009} :answer-field/id #uuid "dfebc0af-3e56-5c01-bb6b-31ef7ddec83a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470616} {:answer-field/choices [{:answer/id #uuid "c6d1af67-f050-5e7c-8437-b20edb8f625f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470010} {:answer/id #uuid "9d6d7cf1-8ae2-5b06-98c5-502fc4c24e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470011}] :answer-field/correct {:answer/id #uuid "9d6d7cf1-8ae2-5b06-98c5-502fc4c24e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470011} :answer-field/id #uuid "bfadfa8f-89a0-5cf2-ac32-f782ee793751" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470617} {:answer-field/choices [{:answer/id #uuid "92445541-35c4-5fec-8155-d89e8ad738bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470012} {:answer/id #uuid "dd5f7120-ecc0-57f5-83c8-5c9716762bde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470013}] :answer-field/correct {:answer/id #uuid "dd5f7120-ecc0-57f5-83c8-5c9716762bde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470013} :answer-field/id #uuid "03813ec3-f377-5abb-a21d-dde851c389d8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470618}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c64aee5-b8e4-5802-9d88-5d5ccb488483" :question/math-academy-id "q-99839" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡t,\\,{f}_{2}(t)=\\operatorname{sin}⁡(3t),\\,{f}_{3}(t)=\\operatorname{sin}⁡(5t)\n$$\n\nGiven that the inner product in the vector space $C[0,\\pi /2]$ of continuous functions over $[0,\\pi /2]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{\\pi /2}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nI. ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product\n\nII. ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product\n\n*Hint: $⟨{f}_{2},{f}_{3}⟩=0.$*\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩=⟨\\operatorname{sin}⁡t,\\operatorname{sin}⁡(3t)⟩={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the identity $\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\,\\operatorname{sin}⁡(3t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡(t-3t)-\\operatorname{cos}⁡(t+3t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡(-2t)-\\operatorname{cos}⁡(4t))\\,\\text{d}t \\\\  & =\\frac{1}{2}(-\\frac{\\operatorname{sin}⁡(-2t)}{2}-\\frac{\\operatorname{sin}⁡(4t)}{4}){|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}(-\\frac{\\operatorname{sin}⁡(-\\pi )}{2}-\\frac{\\operatorname{sin}⁡(2\\pi )}{4})-\\frac{1}{2}(-\\frac{\\operatorname{sin}⁡0}{2}-\\frac{\\operatorname{sin}⁡0}{4}) \\\\  & =-\\frac{1}{2}\\cdot 0+\\frac{1}{2}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩=⟨\\operatorname{sin}⁡t,\\operatorname{sin}⁡(5t)⟩={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{sin}⁡(5t)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the identity $\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\,\\operatorname{sin}⁡(5t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡(t-5t)-\\operatorname{cos}⁡(t+5t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡(-4t)-\\operatorname{cos}⁡(6t))\\,\\text{d}t \\\\  & =\\frac{1}{2}(-\\frac{\\operatorname{sin}⁡(-4t)}{4}-\\frac{\\operatorname{sin}⁡(6t)}{6}){|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}(-\\frac{\\operatorname{sin}⁡(-2\\pi )}{4}-\\frac{\\operatorname{sin}⁡(3\\pi )}{6})-\\frac{1}{2}(-\\frac{\\operatorname{sin}⁡0}{4}-\\frac{\\operatorname{sin}⁡0}{6}) \\\\  & =-\\frac{1}{2}\\cdot 0+\\frac{1}{2}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is true. Since ${f}_{1}(t)⊥{f}_{2}(t),$ ${f}_{1}(t)⊥{f}_{3}(t),$ and ${f}_{2}(t)⊥{f}_{3}(t),$ the set $S$ is orthogonal.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186362394 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72eb4719-e98f-5cb9-a9e4-ea5ac615be39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470014} {:answer/id #uuid "b831ddfd-2e75-57a3-803c-fce7fe0f20f3" :answer