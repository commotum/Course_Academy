21-41f5a726ab31" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453082} {:answer-field/choices [{:answer/id #uuid "b81eebb0-7957-5576-828c-99384c50a06a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452471} {:answer/id #uuid "b516c0cf-2ba1-5ba9-8852-4382e9ac3ae6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452472}] :answer-field/correct {:answer/id #uuid "b81eebb0-7957-5576-828c-99384c50a06a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452471} :answer-field/id #uuid "a8bd4bfb-634d-5ae5-aa62-0dafe1569a4e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453083}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7aa7ebc3-80d5-541f-813e-64c8db0cc171" :question/math-academy-id "q-97962" :question/problem "If $A$ is a $3\\times 3$ matrix and $\\text{nullity}(A-3I)=0,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{Col}(A-3I)={R}^{3}$\n- **II.** $A-3I$ is singular\n- **III.** $\\lambda =3$ is an eigenvalue of $A$" :question/worked-solution "Given a $3\\times 3$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{3} \\\\  & \\text{dim(Col}(M))=3=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $3$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=3.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{rank}(A-3I) & =3-\\text{nullity}(A-3I) \\\\  & =3-0 \\\\  & =3.\\end{aligned}\n$$\n\nAccording to invertible matrix theorem, $\\text{Col}(A-3I)={R}^{3}.$\n\n- Statements II is false. By the invertible matrix theorem, since $\\text{nullity}(A-3I)=0,$ we obtain that $A-3I$ must be non-singular.\n\n- Statement III is false. Notice that if $M=A-3I$ is non-singular, then $(A-3I)x=0$ has only zero solution. As a result, $\\lambda =3$ can not be an eigenvalue of $A.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186362254 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2cedf5f-ea78-598b-8fea-86eb4930a16e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452473} {:answer/id #uuid "ac501363-d562-542c-8971-fa619b64fb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452474}] :answer-field/correct {:answer/id #uuid "ac501363-d562-542c-8971-fa619b64fb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452474} :answer-field/id #uuid "6ed2e22e-171c-554d-a637-c726d3aaa309" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453084} {:answer-field/choices [{:answer/id #uuid "941dacde-a17c-5765-910f-5bc4839a1386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452475} {:answer/id #uuid "5f487188-0cec-5f38-9e34-e190f507bb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452476}] :answer-field/correct {:answer/id #uuid "5f487188-0cec-5f38-9e34-e190f507bb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452476} :answer-field/id #uuid "611e09b5-b47a-5519-9300-6bc0ece8a2f0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453085} {:answer-field/choices [{:answer/id #uuid "0044e830-172d-574e-b097-e1ebe25e1adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452477} {:answer/id #uuid "4200c14b-bbe6-5725-adaa-903da877df9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452478}] :answer-field/correct {:answer/id #uuid "0044e830-172d-574e-b097-e1ebe25e1adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452477} :answer-field/id #uuid "2ef6a8d9-228c-5e0b-8e7a-462c8a409290" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453086}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "651bcec7-c2ce-52d1-b1e2-d8f7e6384008" :question/math-academy-id "q-97969" :question/problem "If $A$ is a $4\\times 4$ matrix and $\\text{rank}(A-3I)=4,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{nullity}(A-3I)=0$\n- **II.** $A-3I$ is invertible\n- **III.** $\\lambda =3$ is an eigenvalue of $A$" :question/worked-solution "Given a $4\\times 4$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{4} \\\\  & \\text{dim(Col}(M))=4=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $4$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=4.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(A-3I) & =4-\\text{rank}(A-3I) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$\n\n- Statements II is true. By the invertible matrix theorem, since $\\text{nullity}(A-3I)=0,$ we obtain that $A-3I$ must be invertible.\n\n- Statement III is false. Notice that if $M=A-3I$ is invertible, then $(A-3I)x=0$ has only zero solution. As a result, $\\lambda =3$ can not be an eigenvalue of $A.$\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"} :activity/title "The Invertible Matrix Theorem in Terms of Eigenvalues" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186487555} :db/id #edb/ref 17592186488346} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"} :activity/title "The Invertible Matrix Theorem in Terms of Eigenvalues" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569444} :db/id #edb/ref 17592186570071}]} {:db/id #edb/ref 17592186362255 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #u