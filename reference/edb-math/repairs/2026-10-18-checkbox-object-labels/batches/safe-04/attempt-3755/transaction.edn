a}_{2}+{b}_{2})\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x+2y.$ Therefore, $a+b\\in Π.$\n\n- Statement III is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{bmatrix}\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k({a}_{1}+2{a}_{2})\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k{a}_{1}+2(k{a}_{2})\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x+2y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement IV is true. Since statements II and III are true, the plane $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\"" "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ x+2y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$Π$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $z=x+2y:$\n\n$$\n\\begin{aligned}z & =x+2y \\\\ (0) & =(0)+2(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$Π$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}+2{b}_{2}\\end{bmatrix}\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {