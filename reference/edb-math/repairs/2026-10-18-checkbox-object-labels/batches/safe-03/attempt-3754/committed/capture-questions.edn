d "42a586b0-b4ae-5007-897d-4fdfaee7b7bc" :answer-field/key "$T=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "474bf73b-e366-5189-9675-bc39c5723be5" :question/math-academy-id "q-126204" :question/problem "Which of the following are zero matrices?\n\nSelect all that apply." :question/worked-solution "- $R$ is a zero matrix since *all* its entries are zeros.\n\n- $S$ is a zero matrix since *all* its entries are zeros.\n\n- $T$ is a zero matrix since *all* its entries are zeros.\n\nTherefore, $R$, $S$, and $T$ are zero matrices."} {:db/id #edb/ref 17592186262600 :knowledge-point/_questions [{:db/id #edb/ref 17592186087696 :knowledge-point/id #uuid "3ca13445-0218-5950-967e-a68bcfec32c7" :knowledge-point/title "Identifying a Square Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048252 :topic/id #uuid "8c876864-a853-56d6-a887-91d7f8f1cf14" :topic/math-academy-id 862 :topic/title "Zero, Square, Diagonal and Identity Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe5658b2-ecbf-5729-a03d-3906b20cccbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463580} {:answer/id #uuid "21c517ff-d927-5410-8a65-4207f1706ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463581}] :answer-field/correct {:answer/id #uuid "21c517ff-d927-5410-8a65-4207f1706ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463581} :answer-field/id #uuid "e80c3713-3550-5c60-bf0c-0821c17d963c" :answer-field/key "$K=\\begin{bmatrix}3 & 1 \\\\ 0 & \\sqrt{2}\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464724} {:answer-field/choices [{:answer/id #uuid "d7f323ab-c5d9-5fff-aecb-db53cbab4e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463582} {:answer/id #uuid "1560c66f-7a1a-5947-9f60-03688b1f8b27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463583}] :answer-field/correct {:answer/id #uuid "d7f323ab-c5d9-5fff-aecb-db53cbab4e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463582} :answer-field/id #uuid "7be7bbda-907a-5513-a354-940218369f61" :answer-field/key "$L=\\begin{bmatrix}1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464725} {:answer-field/choices [{:answer/id #uuid "f3730365-1faa-567b-9c31-4acdc410ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463584} {:answer/id #uuid "869dcee3-6d63-5587-84d7-2a86bd969317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463585}] :answer-field/correct {:answer/id #uuid "f3730365-1faa-567b-9c31-4acdc410ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463584} :answer-field/id #uuid "3622dfcc-ed36-50f5-8709-40aff4162d7a" :answer-field/key "$M=\\begin{bmatrix}-1 & 3 & -3 \\\\ 0 & 0 & 0 \\\\ -2 & 5 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc57098-3c69-5567-91db-1d90d4ec9c40" :question/math-academy-id "q-126275" :question/problem "Which of the following are square matrices?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- $K$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $L$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $1$ rows and $2$ columns, so it's a $1\\times 2$ matrix.\n\n- $M$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $4$ rows and $3$ columns, so it's a $4\\times 3$ matrix.\n\nTherefore, only $K$ is a square matrix."} {:db/id #edb/ref 17592186262685 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048434 :topic/id #uuid "9ef976b2-cf49-59ec-9689-0ec6f4a92d3c" :topic/math-academy-id 288 :topic/title "The Mean Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3712d163-9e49-58ba-8e1d-eedad9bf9dc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463586} {:answer/id #uuid "d7f5288f-ae92-5922-b531-3b721c1ad84c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463587}] :answer-field/correct {:answer/id #uuid "3712d163-9e49-58ba-8e1d-eedad9bf9dc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463586} :answer-field/id #uuid "99224ad4-ae6f-5c27-8559-5a850b63d8e3" :answer-field/key "$f(x)=2|x|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464727} {:answer-field/choices [{:answer/id #uuid "68e18986-22e0-5c9e-9ee9-51a2e38aff6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463588} {:answer/id #uuid "5cd3c05f-0a49-5102-8ed1-cce210ce03cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463589}] :answer-field/correct {:answer/id #uuid "5cd3c05f-0a49-5102-8ed1-cce210ce03cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463589} :answer-field/id #uuid "55e8673f-1711-58a6-a4ca-27f64f2c9bd4" :answer-field/key "$g(x)=|x-1|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464728} {:answer-field/choices [{:answer/id #uuid "432628a2-c729-5b1b-af1c-4fab9151d6a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463590} {:answer/id #uuid "6ee48f3c-d665-5d30-840a-4fbe144185d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463591}] :answer-field/correct {:answer/id #uuid "6ee48f3c-d665-5d30-840a-4fbe144185d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463591} :answer-field/id #uuid "94fe4378-3ad5-5b97-be35-e7cc0517e7e4" :answer-field/key "$h(x)=|x+1|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464729}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "22f3b282-003f-570b-9433-d53609b5be7e" :question/math-academy-id "q-127013" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-1,1]?$\n\nSelect all that apply." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-1,1],$ the function must be continuous on $[-1,1]$ and differentiable on $(-1,1).$\n\nLet's check each function individually.\n\n- The function $f(x)=2|x|$ is continuous on $[-1,1],$ but it has a corner in $x=0.$ Hence, it is not differentiable at $x=0,$ which means it is not differentiable on $(-1,1).$ Therefore, $f(x)$ does not satisfy the conditions of the mean value theorem.\n\n- The function $g(x)=|x-1|$ is continuous on $[-1,1]$ and differentiable on $(-1,1)$ because it is equivalent to $p(x)=1-x$ over the given interval. Therefore, $g(x)$ satisfies the conditions of the mean value theorem. Note that the graph of $y=g(x)$ has a corner point at $x=1$ but this point does not lie inside $(-1,1).$\n\n- The function $h(x)=|x+1|$ is continuous on $[-1,1]$ and differentiable on $(-1,1)$ because it is equivalent to $p(x)=x+1$ over the given interval. Therefore, $h(x)$ satisfies the conditions of the mean value theorem. Note that the graph of $y=h(x)$ has a corner point at $x=-1$ but this point does not lie inside $(-1,1).$\n\nTherefore, only functions $g(x)=|x-1|$ and $h(x)=|x+1|$ satisfy the conditions for the mean value theorem over the interval $[-1,1].$"} {:db/id #edb/ref 17592186262686 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048434 :topic/id #uuid "9ef976b2-cf49-59ec-9689-0ec6f4a92d3c" :topic/math-academy-id 288 :topic/title "The Mean Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8424311-5774-5664-af5d-dfb6a6dc0336" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463592} {:answer/id #uuid "e73779e5-1d0f-59d8-a3a1-18ac78c7b845" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463593}] :answer-field/correct {:answer/id #uuid "e73779e5-1d0f-59d8-a3a1-18ac78c7b845" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463593} :answer-field/id #uuid "46749a79-894a-5c79-8d45-eb84e3aa3d82" :answer-field/key "$p(x)=\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464730} {:answer-field/choices [{:answer/id #uuid "58abab50-c2c8-5df3-b217-1f786f9653b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463594} {:answer/id #uuid "a2c2d4d5-6b1d-5ea5-9ab9-a9533b8b0ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463595}] :answer-field/correct {:answer/id #uuid "58abab50-c2c8-5df3-b217-1f786f9653b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463594} :answer-field/id #uuid "110ee671-4220-5bb9-afb8-70a255ce921c" :answer-field/key "$q(x)=\\operatorname{ln}⁡(x-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464731} {:answer-field/choices [{:answer/id #uuid "f37d08d2-b69c-5300-928b-c280ca4f7e97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463596} {:answer/id #uuid "43f857e8-d7b2-59b9-97d9-8a8843875c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463597}] :answer-field/correct {:answer/id #uuid "f37d08d2-b69c-5300-928b-c280ca4f7e97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463596} :answer-field/id #uuid "4887ee96-65c2-57c9-bbb3-1d2d022f0460" :answer-field/key "$r(x)=\\operatorname{ln}⁡(|x-1|)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464732}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b52094f1-1c52-540b-aa05-57b1e1d10dfd" :question/math-academy-id "q-127014" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[1,3]?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[1,3],$ the function must be continuous on $[1,3]$ and differentiable on $(1,3).$\n\nLet's check each function individually.\n\n- The function $p(x)=\\operatorname{ln}⁡x$ is continuous and differentiable on $(0,\\infty ).$ In particular, it is continuous on $[1,3]$ and differentiable on $(1,3).$ Therefore, $p(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $q(x)=\\operatorname{ln}⁡x$ is continuous and differentiable on $(1,\\infty ).$ Given that it is not defined at $x=1,$ $q(x)$ does not satisfy the conditions of the mean value theorem.\n\n- The function $r(x)=\\operatorname{ln}⁡x$ is continuous and differentiable on $(-\\infty ,1)\\cup (1,\\infty ).$ Given that it is not defined at $x=1,$ $r(x)$ does not satisfy the conditions of the mean value theorem.\n\nTherefore, only function $p(x)=\\operatorname{ln}⁡x$ satisfies the conditions for the mean value theorem over the interval $[1,3].$"} {:db/id #edb/ref 17592186262687 :knowledge-point/_questions [{:db/id #edb/ref 17592186179644 :knowledge-point/id #uuid "2b7b8782-d1f4-5654-a18f-6ad35de8fb30" :knowledge-point/title "Determining a Flux's Sign From a Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186048376 :topic/id #uuid "9a5670e8-43ef-54b7-8f4b-81842fc55f1c" :topic/math-academy-id 3715 :topic/title "Flux in Two-Dimensional Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044e4eb6-1300-50e2-a121-217e4f2aeedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463598} {:answer/id #uuid "4ae2d382-db37-5f46-820f-5c44d57833a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463599}] :answer-field/correct {:answer/id #uuid "4ae2d382-db37-5f46-820f-5c44d57833a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463599} :answer-field/id #uuid "2ff3851d-179e-55d1-8e85-49918b1df7d6" :answer-field/key "The flux of $F$ across $C$ is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464733} {:answer-field/choices [{:answer/id #uuid "f1fc3250-01cb-5753-a77b-5c0da4ff1229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463600} {:answer/id #uuid "97324fd8-5eb3-50f1-81e7-c6ece2d89e9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463601}] :answer-field/correct {:answer/id #uuid "f1fc3250-01cb-5753-a77b-5c0da4ff1229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463600} :answer-field/id #uuid "39af33cf-4ee9-5a22-a356-af409e61b504" :answer-field/key "The flux of $F$ across $-C$ is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464734} {:answer-field/choices [{:answer/id #uuid "09e460cb-9bf3-5530-b17c-fa21d39cd66d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463602} {:answer/id #uuid "9885935d-12a7-5807-9f71-24698900d591" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463603}] :answer-field/correct {:answer/id #uuid "09e460cb-9bf3-5530-b17c-fa21d39cd66d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463602} :answer-field/id #uuid "f4266908-76f9-5cdc-9e19-e4eb00cbd6de" :answer-field/key "The flux of $F$ across $C$ is zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464735}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18437e48-5bf8-597d-848c-dabff126da0e" :question/math-academy-id "q-127025" :question/problem "![](images/95/95e7e2df02e4694d85be868f348bb65fb6a7bf2c646b89000b9af655f937a12f.png)\n\nConsider the ellipse $S$ and vector field $F$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $F$ represents a stream of flowing water. The flux of $F$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $F$ across $C$ is positive” is true, while statement “The flux of $F$ across $C$ is zero” is false. From the diagram below it's clear that there is a net flow *out* through $C.$ \n\n![](images/bf/bfd6a4f3d368bc5920e1c79eed913f4ef21fcdf8b9eb42bbc5ce3f5c2ba7d36b.png)\n\nTherefore, the flux is positive, and we must have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s>0.\n$$\n\n- Statement “The flux of $F$ across $-C$ is negative” is false. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/78/789b387e512c53895b0cfa499c70547046318a29da6d9af7f556a07bcac830ed.png)\n\nSo, the flux of $F$ across $-C$ is positive, and we must have\n\n$$\n{∮}_{-C}F\\cdot n\\,\\text{d}s>0.\n$$\n\nTherefore, the correct answer is “The flux of $F$ across $C$ is positive” only."} {:db/id #edb/ref 17592186262688 :knowledge-point/_questions [{:db/id #edb/ref 17592186179644 :knowledge-point/id #uuid "2b7b8782-d1f4-5654-a18f-6ad35de8fb30" :knowledge-point/title "Determining a Flux's Sign From a Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186048376 :topic/id #uuid "9a5670e8-43ef-54b7-8f4b-81842fc55f1c" :topic/math-academy-id 3715 :topic/title "Flux in Two-Dimensional Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4af413c3-686c-5c2d-bd12-502defdc9a37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463604} {:answer/id #uuid "278d4075-be3f-56a0-8ec4-3e7094bec024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463605}] :answer-field/correct {:answer/id #uuid "4af413c3-686c-5c2d-bd12-502defdc9a37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463604} :answer-field/id #uuid "2137d776-bbde-5eeb-966a-9a2b6a799b38" :answer-field/key "The flux of $F$ across $C$ is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464736} {:answer-field/choices [{:answer/id #uuid "9512c2ad-6323-5b3d-99cc-416c3e5fc2ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463606} {:answer/id #uuid "82f0e2e4-094c-54e4-8fe5-dcd89dd04ef9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463607}] :answer-field/correct {:answer/id #uuid "9512c2ad-6323-5b3d-99cc-416c3e5fc2ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463606} :answer-field/id #uuid "51d19a22-2c6f-5c38-a191-01fc2a500890" :answer-field/key "The flux of $F$ across $-C$ is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464737} {:answer-field/choices [{:answer/id #uuid "e64c3d63-ef55-5f3e-bd1f-c776629cc749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463608} {:answer/id #uuid "9f89e298-102b-5364-846f-ceb612b0dd6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463609}] :answer-field/correct {:answer/id #uuid "9f89e298-102b-5364-846f-ceb612b0dd6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463609} :answer-field/id #uuid "441f3c55-cced-5818-b31e-226165dab266" :answer-field/key "The flux of $F$ across $C$ is zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e84dd576-6f5a-58c5-bf96-4c1a434830ab" :question/math-academy-id "q-127029" :question/problem "![](images/06/06c6dd24948a95d08850455d273c3456076850a47c980a086f06813b96bfd6ed.png)\n\nConsider the circle $S$ and vector field $F$ shown above. Let $C$ be any path where $S$ is traversed once in the clockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $F$ represents a stream of flowing water. The flux of $F$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $F$ across $C$ is negative” is false, while statement “The flux of $F$ across $C$ is zero” is true. From the diagram below we see that $F$ acts perpendicular to $n$ at every point on $C.$ Therefore, there is no net flow of $F$ through $C.$\n\n![](images/29/29f144d6f3ce8233a034025fe933bc57dbea5476c50a259853a98bd2a2b3a47b.png)\n\nSo, the flux of $F$ across $C$ is zero, and we must have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=0.\n$$\n\n- Statement “The flux of $F$ across $-C$ is positive” is false. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/d7/d7a469a331a3cda238fcefb9e7163743483975c4ecc7b962d6d5f8d79736693c.png)\n\nSo, the flux of $F$ across $-C$ is zero, and we must have\n\n$$\n{∮}_{-C}F\\cdot n\\,\\text{d}s=0.\n$$\n\nTherefore, the correct answer is “The flux of $F$ across $C$ is zero” only."} {:db/id #edb/ref 17592186262690 :knowledge-point/_questions [{:db/id #edb/ref 17592186179644 :knowledge-point/id #uuid "2b7b8782-d1f4-5654-a18f-6ad35de8fb30" :knowledge-point/title "Determining a Flux's Sign From a Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186048376 :topic/id #uuid "9a5670e8-43ef-54b7-8f4b-81842fc55f1c" :topic/math-academy-id 3715 :topic/title "Flux in Two-Dimensional Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5323d7-d924-5036-a404-e42edaf50898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463610} {:answer/id #uuid "8215cbff-cc90-5f37-8a5a-22a2f081bfef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463611}] :answer-field/correct {:answer/id #uuid "8215cbff-cc90-5f37-8a5a-22a2f081bfef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463611} :answer-field/id #uuid "aff70dd5-877c-59ef-81bc-8178f3f49dec" :answer-field/key "The flux of $F$ across $C$ is zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464739} {:answer-field/choices [{:answer/id #uuid "8d6f8d00-d75f-502f-bc54-6f1ccf5e06f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463612} {:answer/id #uuid "aac8e4b0-3d27-5f75-bde9-f37d964b4094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463613}] :answer-field/correct {:answer/id #uuid "aac8e4b0-3d27-5f75-bde9-f37d964b4094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463613} :answer-field/id #uuid "82e64186-1575-540c-b2e9-ea65c962ca59" :answer-field/key "The flux of $F$ across $-C$ is zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464740} {:answer-field/choices [{:answer/id #uuid "46fa00f6-11fc-5e06-be3e-f6dba2027667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463614} {:answer/id #uuid "10df1e34-71fc-5eaf-b9c8-3da308db6b19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463615}] :answer-field/correct {:answer/id #uuid "46fa00f6-11fc-5e06-be3e-f6dba2027667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463614} :answer-field/id #uuid "8632d559-2742-5101-9099-c7c7ae2c0458" :answer-field/key "The flux of $F$ across $C$ is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92477238-fcf4-57c0-a788-d4cbd2b1a3bc" :question/math-academy-id "q-127030" :question/problem "![](images/65/6504ab3dde96670102e5046887707416495895dc3b85a514b5bbe7b526b4fa42.png)\n\nConsider the ellipse $S$ and vector field $F$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $F$ represents a stream of flowing water. The flux of $F$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $F$ across $C$ is zero” is true, while statement “The flux of $F$ across $C$ is positive” is false. Note that the flux $F$ that flows in through $C$ is the same that flows out through $C.$ Therefore, there is no net flow of $F$ through $C.$\n\n![](images/9a/9af12f28947e46810074574dad9f6b9a8b572f116456807bf9c478d12da19ec2.png)\n\nSo, the flux of $F$ across $C$ is zero, and we must have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=0.\n$$\n\n- Statement “The flux of $F$ across $-C$ is zero” is true. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/c4/c4402595afc4ce12937794f0755a446ae738d3b47d7e9f4978b6344f9ef8909a.png)\n\nSo, the flux of $F$ across $-C$ is zero, and we must have\n\n$$\n{∮}_{-C}F\\cdot n\\,\\text{d}s=0.\n$$\n\nTherefore, the correct answer is “The flux of $F$ across $C$ is zero”; “The flux of $F$ across $-C$ is zero” only."} {:db/id #edb/ref 17592186262691 :knowledge-point/_questions [{:db/id #edb/ref 17592186179644 :knowledge-point/id #uuid "2b7b8782-d1f4-5654-a18f-6ad35de8fb30" :knowledge-point/title "Determining a Flux's Sign From a Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186048376 :topic/id #uuid "9a5670e8-43ef-54b7-8f4b-81842fc55f1c" :topic/math-academy-id 3715 :topic/title "Flux in Two-Dimensional Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596e2f25-6344-5eef-8a75-204c85175502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463616} {:answer/id #uuid "f2be65cc-9a49-5f0b-8eef-59b759de229f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463617}] :answer-field/correct {:answer/id #uuid "596e2f25-6344-5eef-8a75-204c85175502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463616} :answer-field/id #uuid "d7d9b2de-be53-5786-80d4-7cae45fb50a3" :answer-field/key "The flux of $F$ across $C$ is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464742} {:answer-field/choices [{:answer/id #uuid "497c22f7-4edc-50c1-acb2-19f74b2baca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463618} {:answer/id #uuid "e235a714-1f0d-523a-8c12-6f930cfc72c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463619}] :answer-field/correct {:answer/id #uuid "e235a714-1f0d-523a-8c12-6f930cfc72c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463619} :answer-field/id #uuid "45cc04e2-3594-5873-8ddb-dade30e36c6f" :answer-field/key "The flux of $F$ across $C$ is zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464743} {:answer-field/choices [{:answer/id #uuid "ce71fa89-a63c-5932-a85a-15e6f162c9e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463620} {:answer/id #uuid "7ffa6d1d-e27b-5ef6-bf18-d9dcd01130db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463621}] :answer-field/correct {:answer/id #uuid "7ffa6d1d-e27b-5ef6-bf18-d9dcd01130db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463621} :answer-field/id #uuid "78427e4a-7c4c-55d1-bdbd-e9b61519ab8b" :answer-field/key "The flux of $F$ across $-C$ is zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464744}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6542e3fc-27ed-5a91-abb0-bbb5f848f669" :question/math-academy-id "q-127032" :question/problem "![](images/45/453633f6309b9f1d2a3f7a8d4266ff10f571823cffd705d0bc93b930dce63d8f.png)\n\nConsider the ellipse $S$ and vector field $F$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $F$ represents a stream of flowing water. The flux of $F$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $F$ across $C$ is negative” is false, while statement “The flux of $F$ across $C$ is zero” is true. From the diagram below we see that $F$ acts perpendicular to $n$ at every point on $C.$ Therefore, there is no net flow of $F$ through $C.$\n\n![](images/84/844d5e5574571ae221a86f541820a4b215766451031f4eea678cee46a1b83e41.png)\n\nSo, the flux of $F$ across $C$ is zero, and we must have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=0.\n$$\n\n- Statement “The flux of $F$ across $-C$ is zero” is true. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/b8/b8b31d46646db2d88d8a3f5658ee876383795ad5ba9aa55eb9959d5f95c02dbe.png)\n\nSo, the flux of $F$ across $-C$ is zero, and we must have\n\n$$\n{∮}_{-C}F\\cdot n\\,\\text{d}s=0.\n$$\n\nTherefore, the correct answer is “The flux of $F$ across $C$ is zero”; “The flux of $F$ across $-C$ is zero” only."} {:db/id #edb/ref 17592186262692 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf0d74d1-c4ec-5acb-8d02-428a673c8e65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463622} {:answer/id #uuid "b27ccb3b-3a36-5770-a2e0-e34e1a22fdf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463623}] :answer-field/correct {:answer/id #uuid "bf0d74d1-c4ec-5acb-8d02-428a673c8e65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463622} :answer-field/id #uuid "a80361de-cad8-5430-99d8-5688274c0393" :answer-field/key "$[-4,-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464745} {:answer-field/choices [{:answer/id #uuid "cabcedb4-c1ca-5e1a-b3ec-c2005b0b28e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463624} {:answer/id #uuid "b650e945-f362-5475-974d-8d17e8587aa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463625}] :answer-field/correct {:answer/id #uuid "cabcedb4-c1ca-5e1a-b3ec-c2005b0b28e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463624} :answer-field/id #uuid "d05e1564-e6cd-5fbc-8747-2e5f9ac1ae55" :answer-field/key "$[0,4]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464746} {:answer-field/choices [{:answer/id #uuid "739b0c21-210c-5378-b8ae-1ebb085b817a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463626} {:answer/id #uuid "aacfd434-b805-551c-b330-1937375ff4cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463627}] :answer-field/correct {:answer/id #uuid "aacfd434-b805-551c-b330-1937375ff4cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463627} :answer-field/id #uuid "8fbf5f4e-65f1-5792-8d50-6e668eb928a9" :answer-field/key "$[1,6]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464747}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82be4976-c19d-544a-b202-bf6dca5175c8" :question/math-academy-id "q-127037" :question/problem "![](images/e9/e97552a634b4e3ad3604de9d75742af05aa30a18ee92c8440e6c3cedd5d7273a.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-4,-1]$ is closed, but the function has a removable discontinuity at $x=-2.$  Therefore, the extreme value theorem is not applicable.\n\n- The interval $[0,4]$ is closed, but the function is not defined at $x=0.$ So, it can't be continuous at this point. Therefore, the extreme value theorem is not applicable.\n\n- The interval $[1,6]$ is closed, and the function is continuous on $[1,6].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is $[1,6]$ only."} {:db/id #edb/ref 17592186262693 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8239025-1548-543f-b742-41d95cf7deb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463628} {:answer/id #uuid "9a82f1b3-42a5-578c-8649-06dea016a079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463629}] :answer-field/correct {:answer/id #uuid "9a82f1b3-42a5-578c-8649-06dea016a079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463629} :answer-field/id #uuid "ac1b256f-898f-56e9-b3f9-a86a572d532c" :answer-field/key "$[0,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464748} {:answer-field/choices [{:answer/id #uuid "e9c82c83-bf9b-5c1c-a3ac-23c8a77066be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463630} {:answer/id #uuid "95d01e78-945c-57a4-beeb-ad3daff03013" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463631}] :answer-field/correct {:answer/id #uuid "e9c82c83-bf9b-5c1c-a3ac-23c8a77066be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463630} :answer-field/id #uuid "95ebfab1-477a-5fc2-8ce7-ed02f4886a9e" :answer-field/key "$(1,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464749} {:answer-field/choices [{:answer/id #uuid "f3cb2411-872b-5c5b-bca9-ffa9f1dfeca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463632} {:answer/id #uuid "76790a97-7368-5733-9ed1-932cc5f558e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463633}] :answer-field/correct {:answer/id #uuid "f3cb2411-872b-5c5b-bca9-ffa9f1dfeca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463632} :answer-field/id #uuid "cc644c42-a158-5323-b8b4-dd62841c3890" :answer-field/key "$(-\\infty ,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "144d9fbc-7660-5ed9-9ae4-01d5a04d6a5a" :question/math-academy-id "q-127040" :question/problem "![](images/3c/3c25115cfb7ccde7ec0cbec249d62b037c7fb94be92905b186101ce1fd45a1d8.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which interval is the extreme value theorem applicable to $f(x)?$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,2]$ is closed, and the function is continuous on $[0,2].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(1,2)$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $(-\\infty ,0]$ is closed, but it is not a bounded interval in the form $[a,b].$ Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[0,2]$ only."} {:db/id #edb/ref 17592186262822 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83031cf0-e568-5359-b7ee-f956035ef639" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463634} {:answer/id #uuid "e4cf2a4d-34df-5aca-961e-fc888997d1ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463635}] :answer-field/correct {:answer/id #uuid "e4cf2a4d-34df-5aca-961e-fc888997d1ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463635} :answer-field/id #uuid "fdcbe749-383a-5cb7-9f78-d6159757abf9" :answer-field/key "$A=\\begin{bmatrix}-1 & 0 \\\\ 1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464751} {:answer-field/choices [{:answer/id #uuid "bbb3d7ee-532c-5b06-b40b-f4c2dbe2d0d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463636} {:answer/id #uuid "eea6cd9f-fca7-5155-b38b-3664f40c5e11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463637}] :answer-field/correct {:answer/id #uuid "bbb3d7ee-532c-5b06-b40b-f4c2dbe2d0d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463636} :answer-field/id #uuid "f5a898ab-fc64-534b-9fa2-a231d2f0b959" :answer-field/key "$B=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464752} {:answer-field/choices [{:answer/id #uuid "367796bf-a0ff-5cf6-9aaf-31902587b686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463638} {:answer/id #uuid "0144a740-b964-5dd0-8cb7-ff3f206d1152" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463639}] :answer-field/correct {:answer/id #uuid "367796bf-a0ff-5cf6-9aaf-31902587b686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463638} :answer-field/id #uuid "773e2d3e-4596-5ce9-b52a-b7bceb4276e2" :answer-field/key "$C=\\begin{bmatrix}-2 & 3 \\\\ -3 & 5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9987fa7a-d96a-5001-a5b8-b5e558e85078" :question/math-academy-id "q-127751" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=(-1)\\cdot 0-1\\cdot 0=0.\n$$\n\nBecause $det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $2\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=(-2)\\cdot 5-(-3)\\cdot (3)=-1.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular."} {:db/id #edb/ref 17592186262823 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8c473f5-ef95-5227-a968-e2e86ab24e1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463640} {:answer/id #uuid "ef280a56-6aa4-5367-afd4-c488c98b4baa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463641}] :answer-field/correct {:answer/id #uuid "ef280a56-6aa4-5367-afd4-c488c98b4baa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463641} :answer-field/id #uuid "bce7c6c8-b9b1-552a-b5e1-0f6140ff2c88" :answer-field/key "$A=\\begin{bmatrix}1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464754} {:answer-field/choices [{:answer/id #uuid "929235db-049d-563d-9c46-3e63d1f2cabc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463642} {:answer/id #uuid "fa9297a7-d7f3-5f84-9db4-8e4456568e67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463643}] :answer-field/correct {:answer/id #uuid "929235db-049d-563d-9c46-3e63d1f2cabc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463642} :answer-field/id #uuid "48fb156a-09ce-5fde-8695-5588211123e1" :answer-field/key "$B=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464755} {:answer-field/choices [{:answer/id #uuid "eb27b827-2491-5ec9-8772-7e647962fd24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463644} {:answer/id #uuid "da00eb55-ba67-5112-89f2-1681a8d1c68d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463645}] :answer-field/correct {:answer/id #uuid "da00eb55-ba67-5112-89f2-1681a8d1c68d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463645} :answer-field/id #uuid "fcd2d553-3e6c-5d1d-9ac4-1a5aba1b575d" :answer-field/key "$C=\\begin{bmatrix}1 & 1 \\\\ 2 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e8059f3-ef63-587d-911b-0d0c0a784873" :question/math-academy-id "q-127755" :question/problem "Which of the matrices below does **not** have an inverse?\n\nSelect all that apply." :question/worked-solution "- The matrix $A$ is a $1\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=0\\cdot 0-(-1)\\cdot 1=1.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 2-2\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."} {:db/id #edb/ref 17592186262824 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f57cf2ee-5c54-5728-9819-04ba25ccaed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463646} {:answer/id #uuid "cbe95562-995d-540a-a75b-c6729affad85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463647}] :answer-field/correct {:answer/id #uuid "f57cf2ee-5c54-5728-9819-04ba25ccaed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463646} :answer-field/id #uuid "09b46ce7-eeb0-59a8-90f1-679f8c0295ff" :answer-field/key "$S=\\begin{bmatrix}1 & 0 \\\\ -1 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464757} {:answer-field/choices [{:answer/id #uuid "bde6b23b-b56d-5b3d-a341-8a7675217e27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463648} {:answer/id #uuid "306399cf-a4fb-5e1f-9e1c-fab262184a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463649}] :answer-field/correct {:answer/id #uuid "306399cf-a4fb-5e1f-9e1c-fab262184a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463649} :answer-field/id #uuid "d4b22761-b532-55a6-93c3-281e6baeea2e" :answer-field/key "$T=\\begin{bmatrix}2 & -3 \\\\ 4 & -6\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464758} {:answer-field/choices [{:answer/id #uuid "ad303f4b-49e7-5eb1-b038-2436daaa6d7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463650} {:answer/id #uuid "7e3babfc-5f8a-55a0-949b-758d8eacf432" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463651}] :answer-field/correct {:answer/id #uuid "ad303f4b-49e7-5eb1-b038-2436daaa6d7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463650} :answer-field/id #uuid "c7b1f0e4-c9c9-5321-988b-aaf8e81cba4d" :answer-field/key "$U=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464759}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87b20497-ceac-5d64-8634-616821707ef5" :question/math-academy-id "q-127757" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $S$, we have\n\n$$\ndet(S)=1\\cdot (-1)-(-1)\\cdot 0=-1.\n$$\n\nBecause $det(S)\\ne 0,$ we conclude that $S$ is invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot (-6)-4\\cdot (-3)=0.\n$$\n\nBecause $det(T)=0,$ we conclude that $T$ is not invertible. Since $T$ is a square matrix that is not invertible, we also say that $T$ is singular.\n\n- For the matrix $U$, we have\n\n$$\ndet(U)=0\\cdot 0-1\\cdot (-1)=1.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\nTherefore, only $T$ is singular."} {:db/id #edb/ref 17592186262825 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d30b47ef-87b0-5e27-a184-0a096fd33124" :answer/