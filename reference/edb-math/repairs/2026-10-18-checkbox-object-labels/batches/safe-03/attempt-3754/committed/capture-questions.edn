id #edb/ref 17592186463657}] :answer-field/correct {:answer/id #uuid "9ec3ad4b-8ef7-53f9-a9d2-9dabd3a7a706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463657} :answer-field/id #uuid "189a8dad-81d9-534b-b8f8-9df3343a27e3" :answer-field/key "$C=\\begin{bmatrix}4 & 12 \\\\ 3 & 9\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464762}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7dc44ce-440a-5f50-b6a8-db3db16e9582" :question/math-academy-id "q-127762" :question/problem "Which of the matrices below does **not** have an inverse?\n\nSelect all that apply." :question/worked-solution "- The matrix $A$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=4\\cdot (-1)-(-2)\\cdot 3=2.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=4\\cdot 9-3\\cdot 12=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."} {:db/id #edb/ref 17592186262826 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc10acc5-cbe4-5aa7-85e8-9d27a5cfe577" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463658} {:answer/id #uuid "54ce08b8-b1b6-51d3-82c5-8ce0eae6a5df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463659}] :answer-field/correct {:answer/id #uuid "54ce08b8-b1b6-51d3-82c5-8ce0eae6a5df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463659} :answer-field/id #uuid "8037c49c-f8b0-55ab-9b8d-c0cab9f33665" :answer-field/key "$A=\\begin{bmatrix}-2 & 6 \\\\ 1 & -3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464763} {:answer-field/choices [{:answer/id #uuid "f65a48c6-d48a-5389-9967-5b20a96b30f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463660} {:answer/id #uuid "839aeca5-60b3-587e-9712-cc3955ffe0fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463661}] :answer-field/correct {:answer/id #uuid "f65a48c6-d48a-5389-9967-5b20a96b30f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463660} :answer-field/id #uuid "8ae8dfdf-3ddf-57c5-b5be-6a6ce59947b9" :answer-field/key "$B=\\begin{bmatrix}-3 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464764} {:answer-field/choices [{:answer/id #uuid "f467b224-40ff-5b05-86f0-3f8c1a836859" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463662} {:answer/id #uuid "efd8deea-90c9-5a2d-8712-50eac0029e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463663}] :answer-field/correct {:answer/id #uuid "f467b224-40ff-5b05-86f0-3f8c1a836859" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463662} :answer-field/id #uuid "1bc783cb-7e9c-5966-ba24-f9cc38ab506c" :answer-field/key "$C=\\begin{bmatrix}1 & 0 \\\\ 7 & 5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464765}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7be51f92-4cc3-51a8-b911-c18f52c55601" :question/math-academy-id "q-127821" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=-2\\cdot (-3)-1\\cdot 6=0.\n$$\n\nBecause $det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $1\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 5-7\\cdot 0=5.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular."} {:db/id #edb/ref 17592186262850 :knowledge-point/_questions [{:db/id #edb/ref 17592186115234 :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad0b2008-bd90-5168-be5c-10de1a5ffdf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448260} {:answer/id #uuid "cbfbf81b-2df5-5692-8bdf-b3c476b091e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448261}] :answer-field/correct {:answer/id #uuid "ad0b2008-bd90-5168-be5c-10de1a5ffdf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448260} :answer-field/id #uuid "93520d72-452c-50c9-97c6-82b2dfb2f65b" :answer-field/key "The coefficient matrix is not invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449170} {:answer-field/choices [{:answer/id #uuid "91907250-1b71-5208-9c48-56b624cb208a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448262} {:answer/id #uuid "5eb582a7-2819-5150-ac4e-acd82016b49f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448263}] :answer-field/correct {:answer/id #uuid "5eb582a7-2819-5150-ac4e-acd82016b49f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448263} :answer-field/id #uuid "665b8c3b-23dd-500c-a6e4-59240a3ea0f9" :answer-field/key "The determinant of the coefficient matrix is not zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449171} {:answer-field/choices [{:answer/id #uuid "32d22f54-d568-5c48-a820-4240015e79dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448264} {:answer/id #uuid "07c32ebf-0bc4-563a-88ae-ed188defb588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448265}] :answer-field/correct {:answer/id #uuid "32d22f54-d568-5c48-a820-4240015e79dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448264} :answer-field/id #uuid "c13fe396-2f57-59c0-b60c-e1db65afd4f0" :answer-field/key "The lines $x+2y=-11$ and $y+7x=4$ intersect at infinitely many  points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449172}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "012090a8-b5e2-5e56-87ba-9a6b486504ac" :question/math-academy-id "q-127918" :question/problem "Consider the system of linear equations given by\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-11 \\\\ y+7x &=4.\\end{aligned}\\right.\n$$\n\nGiven that the system has exactly one solution, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “The coefficient matrix is not invertible” is false by the first part of the invertible matrix theorem.\n\n- Statement “The determinant of the coefficient matrix is not zero” is true. According to the fifth part of the invertible matrix theorem, the determinant cannot be $0.$\n\n- Statement “The lines $x+2y=-11$ and $y+7x=4$ intersect at infinitely many  points” is false by the fourth part of the invertible matrix theorem.\n\nTherefore, only statement “The determinant of the coefficient matrix is not zero” is true."} {:db/id #edb/ref 17592186262851 :knowledge-point/_questions [{:db/id #edb/ref 17592186115234 :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31393764-2a3b-5f94-a8ad-ec6c335171fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448266} {:answer/id #uuid "553375c2-cf85-5f9d-bbb0-2230855cf965" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448267}] :answer-field/correct {:answer/id #uuid "553375c2-cf85-5f9d-bbb0-2230855cf965" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448267} :answer-field/id #uuid "19c7722a-6979-5033-a8fd-f7b21ac292e9" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449173} {:answer-field/choices [{:answer/id #uuid "a40d55b1-98b2-5ff7-b0b5-62a7b770b2d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448268} {:answer/id #uuid "a5ed1980-c042-5487-b529-f6a360735551" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448269}] :answer-field/correct {:answer/id #uuid "a5ed1980-c042-5487-b529-f6a360735551" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448269} :answer-field/id #uuid "8d1d04d4-58b5-55a1-ac37-5e45b973022f" :answer-field/key "$A$ is  invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449174} {:answer-field/choices [{:answer/id #uuid "61b43c99-11a6-57ed-8a16-f4ef4192ec6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448270} {:answer/id #uuid "71013a10-6913-520b-800b-767fdc89601a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448271}] :answer-field/correct {:answer/id #uuid "61b43c99-11a6-57ed-8a16-f4ef4192ec6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448270} :answer-field/id #uuid "8901af95-d0b6-584c-8098-fd5186cd5e05" :answer-field/key "$Ax=0$ has a nonzero solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd31265e-20ac-5d02-8e25-ee3bd3fdfd6c" :question/math-academy-id "q-127919" :question/problem "Consider a system of two linear equations in two variables, represented by the matrix equation $Ax=b$ in the usual way. Given that the system has exactly one solution, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement $det(A)\\ne 0$ is true by the fifth part of the invertible matrix theorem.\n\n- Statement “$A$ is  invertible” is true by the first part of the invertible matrix theorem.\n\n- Statement “$Ax=0$ has a nonzero solution” is false by the third part of the invertible matrix theorem.\n\nTherefore, only statements $det(A)\\ne 0$ and “$A$ is  invertible” are true."} {:db/id #edb/ref 17592186262852 :knowledge-point/_questions [{:db/id #edb/ref 17592186115234 :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193a9a31-72cc-52c6-a705-a7cc0d131106" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448272} {:answer/id #uuid "2e608d1e-afec-550f-8c0a-a1b47085d8eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448273}] :answer-field/correct {:answer/id #uuid "193a9a31-72cc-52c6-a705-a7cc0d131106" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448272} :answer-field/id #uuid "84301b7c-4bac-571e-acbc-02ec8c83029b" :answer-field/key "The lines $2x-2y=-1$ and $3y-x=1$ intersect at infinitely many  points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449176} {:answer-field/choices [{:answer/id #uuid "75573dd0-ebb2-5a2b-8aa4-6ff78a5f0d5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448274} {:answer/id #uuid "a7593381-daab-5f1a-a7a3-7c82d8e103ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448275}] :answer-field/correct {:answer/id #uuid "75573dd0-ebb2-5a2b-8aa4-6ff78a5f0d5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448274} :answer-field/id #uuid "d3bdd369-88e5-5770-a50b-15c5ebdb3612" :answer-field/key "The coefficient matrix is not  invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449177} {:answer-field/choices [{:answer/id #uuid "54c547b3-1b9f-57e3-be16-35c6dc9d2854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448276} {:answer/id #uuid "ea577f79-65e8-595e-a0ef-8870c1c707ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448277}] :answer-field/correct {:answer/id #uuid "ea577f79-65e8-595e-a0ef-8870c1c707ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448277} :answer-field/id #uuid "862bba97-dd62-5306-8468-8af85b572b72" :answer-field/key "The determinant of the coefficient matrix is not equal to zero" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449178}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "112c3205-5323-5719-a0c7-431fff65b0ec" :question/math-academy-id "q-127920" :question/problem "Consider the system of linear equations given by\n\n$$\n\\left\\{\\begin{aligned}2x-2y &=-1 \\\\ 3y-x &=1.\\end{aligned}\\right.\n$$\n\nGiven that the system has exactly one solution, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “The lines $2x-2y=-1$ and $3y-x=1$ intersect at infinitely many  points” is false by the fourth part of the invertible matrix theorem.\n\n- Statement “The coefficient matrix is not  invertible” is false by the first part of the invertible matrix theorem.\n\n- Statement “The determinant of the coefficient matrix is not equal to zero” is true by the fifth part of the invertible matrix theorem.\n\nTherefore, only statement “The determinant of the coefficient matrix is not equal to zero” is true."} {:db/id #edb/ref 17592186262854 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69107280-70c4-5ca4-8b64-1e64450165b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448278} {:answer/id #uuid "4a3f6955-4016-59d3-9db9-3955354a9810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448279}] :answer-field/correct {:answer/id #uuid "4a3f6955-4016-59d3-9db9-3955354a9810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448279} :answer-field/id #uuid "2ee137d6-1832-58d0-85d5-575e29a0fa26" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449179} {:answer-field/choices [{:answer/id #uuid "29bde20c-189c-54ef-b19c-9e8950c65826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448280} {:answer/id #uuid "5a9158da-7221-5175-b881-fdd36f8f42ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448281}] :answer-field/correct {:answer/id #uuid "29bde20c-189c-54ef-b19c-9e8950c65826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448280} :answer-field/id #uuid "de466e8f-4f63-50c6-b72f-38c520f95211" :answer-field/key "$Ax=0$ has no solutions" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449180} {:answer-field/choices [{:answer/id #uuid "a6c45389-9701-5934-b1ac-2f11edac2800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448282} {:answer/id #uuid "f20f2e0e-7487-58ee-9feb-810b44ca227a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448283}] :answer-field/correct {:answer/id #uuid "f20f2e0e-7487-58ee-9feb-810b44ca227a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448283} :answer-field/id #uuid "db9964be-6910-5d74-bd0f-7b3cfcffc16d" :answer-field/key "The lines $x+3y=-1$ and $-x+ky=1$  intersect at exactly one point." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "364a18ef-2de8-57d7-9e2f-631eb4651446" :question/math-academy-id "q-127931" :question/problem "Let $A=\\begin{bmatrix}1 & 3 \\\\ -1 & k\\end{bmatrix}$ and $b=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix},$ where $k$ is a constant such that $k\\ne -3.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)\\ne 0$ is true. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}1 & 3 \\\\ -1 & k\\end{bmatrix} \\\\  & =1\\cdot k-(-1)\\cdot 3 \\\\  & =k+3.\\end{aligned}\n$$\n\nNotice that $k+3\\ne 0$ if $k\\ne -3.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “$Ax=0$ has no solutions” is false. According to the third part of the invertible matrix theorem, the unique solution to  $Ax=0$ is the trivial one (zero).\n\n- Statement “The lines $x+3y=-1$ and $-x+ky=1$  intersect at exactly one point” is true by the fourth part of the invertible matrix theorem.\n\nFinally, only statements $det(A)\\ne 0$ and “The lines $x+3y=-1$ and $-x+ky=1$  intersect at exactly one point” are true." :step/_content [{:activity/_steps {:activity/title "Quiz 2" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186494300} :db/id #edb/ref 17592186495207}]} {:db/id #edb/ref 17592186262856 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba1c76d6-26c8-504d-9404-70d3044b6d61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448284} {:answer/id #uuid "52a42a90-a2f2-53a1-a38b-f3fbd471febf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448285}] :answer-field/correct {:answer/id #uuid "52a42a90-a2f2-53a1-a38b-f3fbd471febf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448285} :answer-field/id #uuid "e1f5a7d6-794e-5b2e-8232-2ef8047378b7" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449182} {:answer-field/choices [{:answer/id #uuid "3a25b72a-8f61-5c4f-851c-aafa09b763a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448286} {:answer/id #uuid "ecf17fa0-ce5e-57ed-be01-382386d4d6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448287}] :answer-field/correct {:answer/id #uuid "ecf17fa0-ce5e-57ed-be01-382386d4d6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448287} :answer-field/id #uuid "94fe4db0-076c-5d37-abdd-95681679518e" :answer-field/key "$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449183} {:answer-field/choices [{:answer/id #uuid "a2f82e7b-d0c9-554d-b199-c9cd2d9d3e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448288} {:answer/id #uuid "d21d1cbd-a4f9-59d3-90e9-eebe3afbe948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448289}] :answer-field/correct {:answer/id #uuid "a2f82e7b-d0c9-554d-b199-c9cd2d9d3e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448288} :answer-field/id #uuid "c4af399e-f753-5679-8b6d-af7bd231a29f" :answer-field/key "${A}^{-1}$ does **not** exist" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98a38053-dfdc-5995-9d99-1db68e6c6765" :question/math-academy-id "q-127943" :question/problem "Let \n$A=\\begin{bmatrix}1 & 2 \\\\ -1 & 3\\end{bmatrix}.$ \nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)\\ne 0$ is true. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}1 & 2 \\\\ -1 & 3\\end{bmatrix} \\\\  & =1\\cdot 3-(-1)\\cdot 2 \\\\  & =5\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$” is true by the second part of the invertible matrix theorem.\n\n- Statement “${A}^{-1}$ does **not** exist” is false. According to the first part of the invertible matrix theorem, the inverse ${A}^{-1}$ must exist.\n\nFinally, only statements $det(A)\\ne 0$ and “$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$” are true."} {:db/id #edb/ref 17592186262876 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4abfb096-6bba-5ea2-bf9c-18957c7e68e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448290} {:answer/id #uuid "5230d7f7-5e35-5729-b0e1-3278e7fe5616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448291}] :answer-field/correct {:answer/id #uuid "4abfb096-6bba-5ea2-bf9c-18957c7e68e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448290} :answer-field/id #uuid "8ce3286e-5eb6-554c-b5ea-aa0eacd505cd" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449185} {:answer-field/choices [{:answer/id #uuid "7e17fb2f-c144-5859-ab19-13769207d987" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448292} {:answer/id #uuid "864b613f-cd1f-51bc-a958-900baa735a20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448293}] :answer-field/correct {:answer/id #uuid "864b613f-cd1f-51bc-a958-900baa735a20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448293} :answer-field/id #uuid "d5f91f5f-9b80-5001-94e4-1a6906434452" :answer-field/key "$A$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449186} {:answer-field/choices [{:answer/id #uuid "7510f705-ade9-5b16-a00a-8c553aa48c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448294} {:answer/id #uuid "484b7edd-b950-5cae-bafa-4ec7c3c6e9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448295}] :answer-field/correct {:answer/id #uuid "484b7edd-b950-5cae-bafa-4ec7c3c6e9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448295} :answer-field/id #uuid "9fafc811-ec3d-58ec-be64-95611287b86a" :answer-field/key "$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4f36ed6-3fc6-5f37-801d-3dafa17482c6" :question/math-academy-id "q-128124" :question/problem "Let \n$A=\\begin{bmatrix}2 & -3 \\\\ 2 & 3\\end{bmatrix}.$ \nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)=0$ is false. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & -3 \\\\ 2 & 3\\end{bmatrix} \\\\  & =2\\cdot 3-(-3)\\cdot 2 \\\\  & =12\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “$A$ is invertible” is true by the first part of the invertible matrix theorem.\n\n- Statement “$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$” is true by the second part of the invertible matrix theorem.\n\nFinally, only statements “$A$ is invertible” and “$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$” are true."} {:db/id #edb/ref 17592186262877 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d364ced3-f0b4-5db0-a418-8e753ca019ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448296} {:answer/id #uuid "c073cf48-e7ec-54b8-aa41-5f5dd4380be4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448297}] :answer-field/correct {:answer/id #uuid "d364ced3-f0b4-5db0-a418-8e753ca019ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448296} :answer-field/id #uuid "3fe6ac89-7503-556b-afe3-bc96c1615f30" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449188} {:answer-field/choices [{:answer/id #uuid "e79c11e7-6e9c-5e41-a093-0a00d224cc41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448298} {:answer/id #uuid "9f4b969f-164a-59d2-bd0e-77808fa91ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448299}] :answer-field/correct {:answer/id #uuid "9f4b969f-164a-59d2-bd0e-77808fa91ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448299} :answer-field/id #uuid "9fb139ea-e0aa-5492-9328-5084dd32f1a0" :answer-field/key "The system  $Ax=0$ has exactly one solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449189} {:answer-field/choices [{:answer/id #uuid "151b861f-225f-5d93-94c6-8c117995a350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448300} {:answer/id #uuid "503ffa37-1521-58e6-8ba5-365468b412c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448301}] :answer-field/correct {:answer/id #uuid "151b861f-225f-5d93-94c6-8c117995a350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448300} :answer-field/id #uuid "262c7598-2a14-5bdc-94d3-bf80698480e8" :answer-field/key "The lines $7x+14y=2$ and $-2x+ky=-3$ intersect at infinitely many points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7887fe01-425a-54fe-9f35-ac58c1eba82c" :question/math-academy-id "q-128136" :question/problem "Let $A=\\begin{bmatrix}7 & 14 \\\\ -2 & k\\end{bmatrix}$ and $b=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},$ where $k$ is a constant such that $k\\ne -4.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)=0$ is false. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}7 & 14 \\\\ -2 & k\\end{bmatrix} \\\\  & =7\\cdot k-(-2)\\cdot 14 \\\\  & =7k+28.\\end{aligned}\n$$\n\nNotice that $7k+28\\ne 0$ if $k\\ne -4.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “The system  $Ax=0$ has exactly one solution” is true. Indeed, by the third part of the invertible matrix theorem, the unique solution to $Ax=0$ is the trivial one (zero).\n\n- Statement “The lines $7x+14y=2$ and $-2x+ky=-3$ intersect at infinitely many points” is false. According to the fourth part of the invertible matrix theorem, the lines must intersect at exactly one point.\n\nFinally, only statement “The system  $Ax=0$ has exactly one solution” is true."} {:db/id #edb/ref 17592186262879 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbc51147-25b1-5778-aad6-bf5043f6cb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463664} {:answer/id #uuid "4313bd7f-c033-58ab-9701-6a606323f354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463665}] :answer-field/correct {:answer/id #uuid "cbc51147-25b1-5778-aad6-bf5043f6cb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463664} :answer-field/id #uuid "eb8075aa-0afd-51a1-a5c6-af05a9aed7f2" :answer-field/key "${\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}}^{-1}$ does not exist" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464766} {:answer-field/choices [{:answer/id #uuid "368fae73-e507-5e37-9bef-0792ca0debca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463666} {:answer/id #uuid "d4b9de64-5f82-5775-b0ce-00dc70fb2b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463667}] :answer-field/correct {:answer/id #uuid "368fae73-e507-5e37-9bef-0792ca0debca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463666} :answer-field/id #uuid "39c1f705-0894-5627-bf2d-13ce4da8aa7c" :answer-field/key "The lines $ax+by=0$ and $cx+dy=0$ intersect at infinitely many points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464767} {:answer-field/choices [{:answer/id #uuid "0549c86c-aba6-5d1f-ac04-e74be35442d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463668} {:answer/id #uuid "699204bf-a3a7-5655-bc84-77191c72bfd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463669}] :answer-field/correct {:answer/id #uuid "699204bf-a3a7-5655-bc84-77191c72bfd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463669} :answer-field/id #uuid "e3a0de77-fbba-5ef9-91d1-ff05515f955d" :answer-field/key "$det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f225cdda-cd5f-5d3d-8527-91ba6c98c224" :question/math-academy-id "q-128151" :question/problem "Which of the following completes the statement so that it is true:\n\n*If the system $\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}x=0$ has the unique zero solution, then $\\underline{\\phantom{xxxxxx}}$ . *\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNow, since the third part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem, only option $det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0$ gives us a true statement:  \n\n*If the system $\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}x=0$ has the unique zero solution, then, $det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0$ .* $\\,✓$"} {:db/id #edb/ref 17592186262880 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7718875-3b6a-5af3-ae55-e160abed5bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463670} {:answer/id #uuid "50c983a0-f3fa-5efe-a797-13d084622238" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463671}] :answer-field/correct {:answer/id #uuid "50c983a0-f3fa-5efe-a797-13d084622238" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463671} :answer-field/id #uuid "2e5619ad-fd2a-5490-8260-e33717ee53f8" :answer-field/key "$Ax=0$ has exactly one solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464769} {:answer-field/choices [{:answer/id #uuid "2bf9c284-7027-54d1-9e5b-9501d73fa5e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463672} {:answer/id #uuid "ed0adccf-aa4e-58fe-86b4-43a7bb3d4536" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463673}] :answer-field/correct {:answer/id #uuid "ed0adccf-aa4e-58fe-86b4-43a7bb3d4536" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463673} :answer-field/id #uuid "0b270799-242f-50f7-9f46-cfeb5f128e82" :answer-field/key "The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464770} {:answer-field/choices [{:answer/id #uuid "4e9af7d3-2561-554a-ab5b-17fb671ab226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463674} {:answer/id #uuid "1cd0c675-2a7c-531b-87e6-0dd86ba970a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463675}] :answer-field/correct {:answer/id #uuid "4e9af7d3-2561-554a-ab5b-17fb671ab226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463674} :answer-field/id #uuid "5b205a91-05e2-588d-9438-a4d81472431f" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7075e5f8-1ac7-5f5f-9b8e-5fb44e2f53d3" :question/math-academy-id "q-128152" :question/problem "Which of the following completes the statement so that it is true:\n\n*If a $2\\times 2$-matrix $A$ is invertible, then $\\underline{\\phantom{xxxxxx}}$ . *\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNow, since the first part of the invertible matrix theorem is true ($A$ is invertible), all the other parts of the theorem are true too. Therefore, according to the theorem, only options “$Ax=0$ has exactly one solution” and “The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point” give us true statements: \n\n- *If $A$ is invertible, then $Ax=0$ has exactly one solution.* $\\,✓$\n\n- *If $A$ is invertible, then The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.* $\\,✓$"} {:db/id #edb/ref 17592186262906 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "938435d8-69e4-5177-83be-c2661b220df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437788} {:answer/id #uuid "b0acf52f-1926-563b-90fe-5bd5c838a2cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437789}] :answer-field/correct {:answer/id #uuid "938435d8-69e4-5177-83be-c2661b220df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437788} :answer-field/id #uuid "ef069a99-e51d-5c41-b3dd-fbe618b3ae29" :answer-field/key "$det(Q)=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438923} {:answer-field/choices [{:answer/id #uuid "fda1810e-40d9-5b5a-8ed9-7de0e91b6696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437790} {:answer/id #uuid "ae8badb5-ccf3-54b7-bf14-15f19c3c783e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437791}] :answer-field/correct {:answer/id #uuid "fda1810e-40d9-5b5a-8ed9-7de0e91b6696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437790} :answer-field/id #uuid "3a6baa2c-bfa2-5841-829c-446168fc4d31" :answer-field/key "$det(Q)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438924} {:answer-field/choices [{:answer/id #uuid "bd3030ea-f56b-54f2-b19e-0fe96063ba8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437792} {:answer/id #uuid "13768b60-6037-5979-87a7-85e46aa637f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437793}] :answer-field/correct {:answer/id #uuid "bd3030ea-f56b-54f2-b19e-0fe96063ba8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437792} :answer-field/id #uuid "10609156-1bc3-5176-82f7-7da72d8cac5c" :answer-field/key "$Q$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f86fe2f1-042a-5183-8a18-518a658cc1a0" :question/math-academy-id "q-128474" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n$$\nQ=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 3 & 1 \\\\ 3 & 5 & 3\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =|\\begin{aligned}1 & 1 & -1 \\\\ 2 & 3 & 1 \\\\ 3 & 5 & 3\\end{aligned}| \\\\  & =1|\\begin{aligned}3 & 1 \\\\ 5 & 3\\end{aligned}|-1|\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}|-1|\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}| \\\\  & =1(9-5)-1(6-3)-1(10-9) \\\\  & =1\\cdot 4-1\\cdot 3-1\\cdot 1 \\\\  & =4-3-1 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, none of the statements are true."} {:db/id #edb/ref 17592186262908 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9c8a655-dc30-5747-b5e0-efd4fa464943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437794} {:answer/id #uuid "b3238a25-1600-54c9-a92e-d6b1f31166ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437795}] :answer-field/correct {:answer/id #uuid "d9c8a655-dc30-5747-b5e0-efd4fa464943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437794} :answer-field/id #uuid "0457a549-1799-5124-a11e-6cbe8bf02f40" :answer-field/key "$T$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438926} {:answer-field/choices [{:answer/id #uuid "86770289-d595-5a74-8241-7f7eaf943501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437796} {:answer/id #uuid "0065df67-0fde-5ae4-ab1b-04075255afaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437797}] :answer-field/correct {:answer/id #uuid "0065df67-0fde-5ae4-ab1b-04075255afaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437797} :answer-field/id #uuid "48c446f0-c232-5d1a-a9fa-08c4d973bbe4" :answer-field/key "$T$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438927} {:answer-field/choices [{:answer/id #uuid "06d221ff-7342-5189-8083-2e45e2305d69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437798} {:answer/id #uuid "db168e14-a68a-5486-95d1-8d4686854e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437799}] :answer-field/correct {:answer/id #uuid "db168e14-a68a-5486-95d1-8d4686854e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437799} :answer-field/id #uuid "5b5f6d45-4846-5d6c-b409-f20f073263eb" :answer-field/key "$det(T)=-30$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "898815e0-65a8-55f9-b81f-a64efbb5e7e4" :question/math-academy-id "q-128476" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\nSelect all that apply.\n\n$$\nT=\\begin{bmatrix}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}1 & 1 \\\\ 3 & 1\\end{aligned}|-3|\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}|-5|\\begin{aligned}2 & 1 \\\\ 1 & 3\\end{aligned}| \\\\  & =1(1-3)-3(2-1)-5(6-1) \\\\  & =1\\cdot (-2)-3\\cdot 1-5\\cdot 5 \\\\  & =-2-3-25 \\\\  & =-30\\end{aligned}\n$$\n\n \n\nSince $det(T)=-30\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statements “$T$ is **not** a singular matrix” and $det(T)=-30$ are true."} {:db/id #edb/ref 17592186262913 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96a78a3a-a96f-5296-bb6f-17bd0c2c1029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437812} {:answer/id #uuid "8a41bcde-2807-5a96-8245-df7493039a41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437813}] :answer-field/correct {:answer/id #uuid "8a41bcde-2807-5a96-8245-df7493039a41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437813} :answer-field/id #uuid "2d87a851-8d26-5425-83e8-dba94be07b21" :answer-field/key "$R$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438935} {:answer-field/choices [{:answer/id #uuid "9d06dd62-d83d-54e9-b4ea-1974429d75ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437814} {:answer/id #uuid "423c9da1-fb5c-5eb1-aac0-e8f7d5033fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437815}] :answer-field/correct {:answer/id #uuid "423c9da1-fb5c-5eb1-aac0-e8f7d5033fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437815} :answer-field/id #uuid "ad0097cd-c1c7-5438-b4af-b5844d0cf50a" :answer-field/key "$det(R)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438936} {:answer-field/choices [{:answer/id #uuid "9e2b6e65-193a-5e1a-ae4e-babcf8cd0b3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437816} {:answer/id #uuid "4daf1704-b4bb-5190-aede-54368b9e49c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437817}] :answer-field/correct {:answer/id #uuid "9e2b6e65-193a-5e1a-ae4e-babcf8cd0b3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437816} :answer-field/id #uuid "727b8a81-c497-5e39-8d74-82d5d2b34ab9" :answer-field/key "$det(R)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438937}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0d8a3d8-8c1e-55f4-b495-022734d0f802" :question/math-academy-id "q-128484" :question/problem "Which of the following statements are true regarding the matrix $R$ given below?\n\nSelect all that apply.\n\n$$\nR=\\begin{bmatrix}2 & \\sqrt{2} & 2 \\\\ \\frac{1}{2} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}2 & \\sqrt{2} & 2 \\\\ \\frac{1}{2} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{aligned}| \\\\  & =2|\\begin{aligned}0 & -1 \\\\ \\sqrt{2} & 4\\end{aligned}|-\\sqrt{2}|\\begin{aligned}\\frac{1}{2} & -1 \\\\ 1 & 4\\end{aligned}|+2|\\begin{aligned}\\frac{1}{2} & 0 \\\\ 1 & \\sqrt{2}\\end{aligned}| \\\\  & =2(0+\\sqrt{2})-\\sqrt{2}(2+1)+2(\\frac{\\sqrt{2}}{2}-0) \\\\  & =2\\cdot \\sqrt{2}-\\sqrt{2}\\cdot 3+2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =2\\sqrt{2}-3\\sqrt{2}+\\sqrt{2} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements “$R$ is a singular matrix” and $det(R)=0$ are true."} {:db/id #edb/ref 17592186262919 :knowledge-point/_questions [{:db/id #edb/ref 17592186124445 :knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340" :knowledge-point/title "Finding the Points Where a Gradient Vanishes" :topic/_knowledge-points [{:db/id #edb/ref 17592186050143 :topic/id #uuid "3055ed78-44c0-5be7-9e08-cb26d881941a" :topic/math-academy-id 1934 :topic/title "The Gradient Vector"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fe7a32f-bd64-5c3a-ac51-aa8e847ab23c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439495} {:answer/id #uuid "a5b19982-26ea-52cf-bfb6-891798ebe687" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439496}] :answer-field/correct {:answer/id #uuid "8fe7a32f-bd64-5c3a-ac51-aa8e847ab23c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439495} :answer-field/id #uuid "5c9b26fe-a648-553a-a416-e7a5675ab1fe" :answer-field/key "$(-1,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440105} {:answer-field/choices [{:answer/id #uuid "8879c732-ca2d-5143-a4fe-4257993d10ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439497} {:answer/id #uuid "a9d1f38f-73c6-5480-a2d4-f3c457b36e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439498}] :answer-field/correct {:answer/id #uuid "a9d1f38f-73c6-5480-a2d4-f3c457b36e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439498} :answer-field/id #uuid "71ac6491-2fe7-5147-88bb-c17f0c42377d" :answer-field/key "$(0,\\frac{\\pi}{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440106} {:answer-field/choices [{:answer/id #uuid "e9a47546-8467-57ce-8aa2-a8af7a03a45d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439499} {:answer/id #uuid "9a881647-dacf-5b22-a11c-6dbd54eab45c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439500}] :answer-field/correct {:answer/id #uuid "9a881647-dacf-5b22-a11c-6dbd54eab45c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439500} :answer-field/id #uuid "c5b81800-b1bd-502a-8929-18d2b7af4a18" :answer-field/key "$(1,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440107} {:answer-field/choices [{:answer/id #uuid "3c3587a5-2b35-5b4d-8516-1a3e694d12a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439501} {:answer/id #uuid "f8a10786-54a3-53dd-acf2-86b3f03692c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439502}] :answer-field/correct {:answer/id #uuid "3c3587a5-2b35-5b4d-8516-1a3e694d12a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439501} :answer-field/id #uuid "0962b3c3-8729-55fc-a737-e4fe61f7b385" :answer-field/key "$(1,\\frac{\\pi}{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48261b12-c86c-55b1-9e2a-f38acbfa450a" :question/math-academy-id "q-128517" :question/problem "Given that $f(x,y)={x}^{2}-2x\\operatorname{cos}⁡y,$ find the points $(x,y),$ for $0\\le y<\\pi ,$ where $∇f(x,y)=0.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}-2x\\operatorname{cos}⁡y) \\\\  & =2x-2\\operatorname{cos}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}-2x\\operatorname{cos}⁡y) \\\\  & =2x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nHence, $∇f(x,y)=2(x-\\operatorname{cos}⁡y)\\,i+2x\\operatorname{sin}⁡y\\,j.$\n\nNow, we solve $∇f(x,y)=0:$ \n\n$$\n2(x-\\operatorname{cos}⁡y)\\,i+2x\\operatorname{sin}⁡y\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n\\begin{cases}2(x-\\operatorname{cos}⁡y)=0 \\\\ 2x\\operatorname{sin}⁡y=0\\end{cases}\n$$\n\nFrom the first equation, we get $x=\\operatorname{cos}⁡y.$ Substituting this into the second equation, we obtain \n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡y\\operatorname{sin}⁡y & =0 \\\\ \\operatorname{sin}⁡2y & =0 \\\\ y & =0,\\,\\frac{\\pi }{2}\\end{aligned}\n$$\n\n- For $y=0,$ we get $x=\\operatorname{cos}⁡0=1.$\n\n- For $y=\\frac{\\pi }{2},$ we get $x=\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\nTherefore, $∇f(x,y)=0,$ for $0\\le y<\\pi ,$ at two points: $(1,0)$ and $(0,\\frac{\\pi }{2}).$"} {:db/id #edb/ref 17592186262933 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900 :topic/title "Level Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92ef990e-1cea-5691-add8-a9a4bd107064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448302} {:answer/id #uuid "7dc67608-1f2c-5d22-b921-920a8e4c97a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448303}] :answer-field/correct {:answer/id #uuid "92ef990e-1cea-5691-add8-a9a4bd107064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448302} :answer-field/id #uuid "bc96e470-5f69-574c-9b9e-c620bf3eb7d7" :answer-field/key "$c=-1$ gives a line" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449191} {:answer-field/choices [{:answer/id #uuid "63ddb0bf-c7e0-5bed-a309-72dc6fd5a94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448304} {:answer/id #uuid "7f593a64-253b-5b53-be4d-93a7fd10d52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448305}] :answer-field/correct {:answer/id #uuid "7f593a64-253b-5b53-be4d-93a7fd10d52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448305} :answer-field/id #uuid "df16a0f8-d309-5196-8986-cbcb30f5ac79" :answer-field/key "$c=0$ gives a parabola, excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449192} {:answer-field/choices [{:answer/id #uuid "0f26b8f8-7a28-5ba9-a92e-f0f01da7dab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448306} {:answer/id #uuid "79cbbda2-7409-51ac-b909-8eaa54f9322b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448307}] :answer-field/correct {:answer/id #uuid "79cbbda2-7409-51ac-b909-8eaa54f9322b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448307} :answer-field/id #uuid "c942c571-9ddc-5568-9ee7-d107cf23c370" :answer-field/key "$c=1$ gives the $x$-axis, excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449193}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02aab097-5368-5094-843f-c0ac47beef5b" :question/math-academy-id "q-129058" :question/problem "The level curves of the function $f(x,y)=\\frac{x+{y}^{2}}{x}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{x+{y}^{2}}{x} & =c \\\\ x+{y}^{2} & =cx \\\\ x(1-c)+{y}^{2} & =0\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1,$ the level curve is $x=-\\frac{1}{2}{y}^{2},$ which is a parabola that opens to the left (excluding the origin). So, “$c=-1$ gives a line” is false.\n\n- If $c=0,$ the level curves is $x=-{y}^{2},$ which is a parabola that opens to the left (excluding the origin). So, “$c=0$ gives a parabola, excluding the origin” is true.\n\n- If $c=1,$ the level curve is $y=0,$ which is the $x$-axis (excluding the origin). So, “$c=1$ gives the $x$-axis, excluding the origin” is true.\n\nSo, the correct answer is “$c=0$ gives a parabola, excluding the origin”; “$c=1$ gives the $x$-axis, excluding the origin” only."} {:db/id #edb/ref 17592186262934 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900 :topic/title "Level Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "179db532-d9e6-5e2e-91f3-aade01e0ddb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463676} {:answer/id #uuid "b3485b61-e757-5360-a24b-e5e8e1510cb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463677}] :answer-field/correct {:answer/id #uuid "179db532-d9e6-5e2e-91f3-aade01e0ddb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463676} :answer-field/id #uuid "cd745651-984a-5d60-a190-cb171692cead" :answer-field/key "$c=0$ gives a parabola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464772} {:answer-field/choices [{:answer/id #uuid "05537b17-7ec7-5fc9-bc2c-6afa58fbf701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463678} {:answer/id #uuid "503c7eee-dfea-59ab-9897-fba0a24aa061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463679}] :answer-field/correct {:answer/id #uuid "05537b17-7ec7-5fc9-bc2c-6afa58fbf701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463678} :answer-field/id #uuid "538c309f-7174-5be3-8c40-ec951dfef7f2" :answer-field/key "$c=1$ gives an ellipse" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464773} {:answer-field/choices [{:answer/id #uuid "b488c30c-d8bb-5f46-b3aa-6f3e7348f877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463680} {:answer/id #uuid "0377582f-387c-5883-9a77-bf51a5c48a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463681}] :answer-field/correct {:answer/id #uuid "b488c30c-d8bb-5f46-b3aa-6f3e7348f877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463680} :answer-field/id #uuid "7bce9543-3652-5444-87d3-b92041c327f4" :answer-field/key "$c=2$ gives a hyperbola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464774}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b3926e5-b3cd-5c3a-a183-ad2104ed74d9" :question/math-academy-id "q-129062" :question/problem "The level curves of the function $f(x,y)=\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}} & =c \\\\ {y}^{2} & =c({x}^{2}+{y}^{2}) \\\\ c{x}^{2}+(c-1){y}^{2} & =0\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is the line $y=0,$ which is the $x$-axis. So, “$c=0$ gives a parabola” is false.\n\n- If $c=1,$ the level curve is the line $x=0,$ which is the $y$-axis. So, “$c=1$ gives an ellipse” is false.\n\n- If $c=2,$  then we obtain \n\n$$\n\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}=2\\,⟹\\,2{x}^{2}+{y}^{2}=0.\n$$\n\nHowever, the only real solution to this equation is  $(x,y)=(0,0),$ which is not in the domain of $f(x,y)$ because it would result in division by zero. Thus, “$c=2$ gives a hyperbola” is false.\n\nSo, the correct answer is \"None of the listed\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900 :topic/title "Level Curves"} :activity/title "Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186529572} :db/id #edb/ref 17592186530551}]} {:db/id #edb/ref 17592186262935 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900 :topic/title "Level Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c15a454d-c0ca-506d-b884-f5178778ed63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448308} {:answer/id #uuid "c32fe568-db32-54b6-8558-ab5cfc063bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448309}] :answer-field/correct {:answer/id #uuid "c15a454d-c0ca-506d-b884-f5178778ed63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448308} :answer-field/id #uuid "b5ce8677-ff71-54c3-ad56-f3412cdf488f" :answer-field/key "$c=-1$ gives a hyperbola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449194} {:answer-field/choices [{:answer/id #uuid "aa79405f-ffc1-5234-ad9c-42a8996c0c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448310} {:answer/id #uuid "d901ccba-6ca6-5ba5-b447-d349fd2445c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448311}] :answer-field/correct {:answer/id #uuid "aa79405f-ffc1-5234-ad9c-42a8996c0c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448310} :answer-field/id #uuid "70ebaa1d-8cd6-5098-9a25-c5f76b89deb4" :answer-field/key "$c=0$ gives the $y$-axis, excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449195} {:answer-field/choices [{:answer/id #uuid "5095e664-dc44-568b-aa90-8adbb890de3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448312} {:answer/id #uuid "010f4da8-c1ee-5554-b6b8-f8cf5ae4e818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448313}] :answer-field/correct {:answer/id #uuid "010f4da8-c1ee-5554-b6b8-f8cf5ae4e818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448313} :answer-field/id #uuid "93e97ed1-eab4-543d-87b4-43be11f05919" :answer-field/key "$c=1$ gives the line $y=x,$ excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42b1c0f3-5dd1-53b2-92c2-3218b1cbc331" :question/math-academy-id "q-129063" :question/problem "The level curves of the function $f(x,y)=\\frac{y}{x}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{y}{x} & =c \\\\ y & =cx\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1,$ the level curve is the line $y=-x,$ excluding the origin. So, “$c=-1$ gives a hyperbola” is false.\n\n- If $c=0,$ the level curve is the line $y=0,$ which is the $x$-axis (excluding the origin). So, “$c=0$ gives the $y$-axis, excluding the origin” is false.\n\n- If $c=1,$ the level curve is the line $y=x,$ excluding the origin. So, “$c=1$ gives the line $y=x,$ excluding the origin” is true.\n\nSo, the correct answer is “$c=1$ gives the line $y=x,$ excluding the origin” only."} {:db/id #edb/ref 17592186262966 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8d8437-9a1f-5e54-9c2d-9d69b5d07fcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463682} {:answer/id #uuid "88820cc6-e369-5f61-8714-cccae1ecb7dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463683}] :answer-field/correct {:answer/id #uuid "1f8d8437-9a1f-5e54-9c2d-9d69b5d07fcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463682} :answer-field/id #uuid "7fd7f3c8-09ce-557a-8d30-27eed0333e84" :answer-field/key "$(0,10]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464775} {:answer-field/choices [{:answer/id #uuid "c9424174-763f-56ed-9007-e5e8b5314d09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463684} {:answer/id #uuid "11fed490-01e7-5dc0-b48c-723f591c48ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463685}] :answer-field/correct {:answer/id #uuid "11fed490-01e7-5dc0-b48c-723f591c48ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463685} :answer-field/id #uuid "43c94e9a-338f-53e6-8100-2e1848ece391" :answer-field/key "$[0,10]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464776} {:answer-field/choices [{:answer/id #uuid "afb00d5f-5fb4-556f-888a-473d8f7f0379" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 175921