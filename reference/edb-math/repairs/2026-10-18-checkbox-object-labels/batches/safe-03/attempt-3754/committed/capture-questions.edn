/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "054ed097-32f2-5e6d-8799-43d62b3579f5" :question/math-academy-id "q-120608" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equations $\\operatorname{csc}⁡x=\\frac{1}{4}$ and $\\operatorname{csc}⁡x=-\\frac{3}{5}$ have no solutions."} {:db/id #edb/ref 17592186256428 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant" :topic/_knowledge-points [{:db/id #edb/ref 17592186048533 :topic/id #uuid "a7996653-9e76-59d9-b493-05cb731632cb" :topic/math-academy-id 1566 :topic/title "Elementary Trigonometric Equations Containing Cosecant"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "870079f2-4a08-57eb-9fa2-2bcdbb207f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462013} {:answer/id #uuid "7c1481f5-d524-5c68-8b69-950d84aa0204" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462014}] :answer-field/correct {:answer/id #uuid "7c1481f5-d524-5c68-8b69-950d84aa0204" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462014} :answer-field/id #uuid "5a80ac41-3933-59e7-b8c6-20e32d384029" :answer-field/key "$\\operatorname{csc}⁡x=\\frac{4}{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #