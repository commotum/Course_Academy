ef 17592186461745} {:answer/id #uuid "fe0e7187-d6c3-5198-b64c-9805c15ccdc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461746}] :answer-field/correct {:answer/id #uuid "0524a498-8b2b-59fb-b65e-ad0ec383d4cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461745} :answer-field/id #uuid "731022f7-d0bc-5408-8e58-15a92c89fc00" :answer-field/key "${y}^{′}=9-{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462626} {:answer-field/choices [{:answer/id #uuid "0aeb0246-e841-5d68-8e79-25722b8f2690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461747} {:answer/id #uuid "a5f043b3-1b23-50d2-be97-efc89a8fde6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461748}] :answer-field/correct {:answer/id #uuid "0aeb0246-e841-5d68-8e79-25722b8f2690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461747} :answer-field/id #uuid "ddc36ee2-30f9-5080-926a-4269f7f8d44b" :answer-field/key "${y}^{′}=x(x-2)(x-3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1598c957-f6d6-5194-a4fb-4b15b46e8010" :question/math-academy-id "q-115716" :question/problem "![](images/a0/a0b39135b78cefe8471c7d120850dde9b53786342679b5ed7f25af9110350607.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/a4/a43217f2af81c1bbacbebd8800b7ebcd4076a32d6ff61782e1fdab4cd182d5ee.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $x=0$ and $x=3,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=-x(x-3)$ gives the required behavior. The right-hand side evaluates to zero at $x=0$ and $x=3.$\n\n- The equation ${y}^{′}=9-{x}^{2}$ does *not* give the required behavior. The right-hand side does not evaluate to zero at both $x=0$ and $x=3.$\n\n- The equation ${y}^{′}=x(x-2)(x-3)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=0$ and $x=3,$ but it also evaluates to zero when $x=2,$ which is not a behavior exhibited by our slope field.\n\nTherefore, the correct answer is ${y}^{′}=-x(x-3)$ only."} {:db/id #edb/ref 17592186250473 :knowledge-point/_questions [{:db/id #edb/ref 17592186166820 :knowledge-point/id #uuid "ede6800b-ecfd-5ef8-a386-4aec94ddd89c" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Stationary Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050480 :topic/id #uuid "4d269723-9cfd-54a7-ba45-a1a8ba6983dd" :topic/math-academy-id 3219 :topic/title "Analyzing Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "599a2f16-4cde-5b11-988c-26ef6ae958a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461749} {:answer/id #uuid "674e2162-0aff-5e89-ad5d-62f1b7b88b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461750}] :answer-field/correct {:answer/id #uuid "674e2162-0aff-5e89-ad5d-62f1b7b88b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461750} :answer-field/id #uuid "20ff9988-96ed-5003-87b8-1e50061b9644" :answer-field/key "${y}^{′}=(x+3)(x+7)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462628} {:answer-field/choices [{:answer/id #uuid "be3027b6-c98a-5856-aca0-5295856401ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461751} {:answer/id #uuid "6c01d811-543d-5cfd-a487-a2c4a796ed80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461752}] :answer-field/correct {:answer/id #uuid "be3027b6-c98a-5856-aca0-5295856401ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461751} :answer-field/id #uuid "1c26860d-fdb0-5342-ba78-a18246e190b7" :answer-field/key "${y}^{′}=x(x+3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462629} {:answer-field/choices [{:answer/id #uuid "9a9d9fed-e7f0-5b89-861f-08c01e74a252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461753} {:answer/id #uuid "8fd923e9-73f9-5490-93f0-f510865e93b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461754}] :answer-field/correct {:answer/id #uuid "9a9d9fed-e7f0-5b89-861f-08c01e74a252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461753} :answer-field/id #uuid "871cff07-5ca0-53fe-88a4-54bbc09aa803" :answer-field/key "${y}^{′}=(x+3)(x+5)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462630}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c861b6c2-4257-5ae6-8d33-89c2fd430076" :question/math-academy-id "q-115719" :question/problem "![](images/17/170ddea2148f369d4feedd14540f234d7946bb6670d1ca6eb4c4ebbbb086a760.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/cf/cf77e09457cd6b53da801a6eb876a79712935eba623c851a5b6dafa58887a076.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $x=-3$ and $x=-7,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=(x+3)(x+7)$ gives the required behavior. The right-hand side evaluates to zero at $x=-7$ and $x=-3.$\n\n- The equation ${y}^{′}=x(x+3)$ does *not* give the required behavior. The right-hand side does not evaluate to zero at $x=-7,$ and also evaluates to zero when $x=0,$ which is not a behavior exhibited by our slope field.\n\n- The equation ${y}^{′}=(x+3)(x+5)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=-3$ but it also evaluates to zero when $x=-5,$ which is not a behavior exhibited by our slope field.\n\nTherefore, the correct answer is ${y}^{′}=(x+3)(x+7)$ only."} {:db/id #edb/ref 17592186250477 :knowledge-point/_questions [{:db/id #edb/ref 17592186166822 :knowledge-point/id #uuid "32b9a92b-880b-50de-b8e9-648fa219b83f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes" :topic/_knowledge-points [{:db/id #edb/ref 17592186050480 :topic/id #uuid "4d269723-9cfd-54a7-ba45-a1a8ba6983dd" :topic/math-academy-id 3219 :topic/title "Analyzing Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88fc7cc8-79d5-59d3-ad2c-04b64b84f0ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461755} {:answer/id #uuid "6262e720-b181-540c-bdb0-37bb9b9572a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461756}] :answer-field/correct {:answer/id #uuid "88fc7cc8-79d5-59d3-ad2c-04b64b84f0ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461755} :answer-field/id #uuid "f9f91efd-4f5f-59b4-b78b-62d93d7a34fd" :answer-field/key "${y}^{′}=\\frac{1}{1-{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462631} {:answer-field/choices [{:answer/id #uuid "8590a88d-c93e-5cb6-834a-cd06d60f91f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461757} {:answer/id #uuid "7b2dccd5-90a7-5939-a2f3-ba68c00652df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461758}] :answer-field/correct {:answer/id #uuid "7b2dccd5-90a7-5939-a2f3-ba68c00652df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461758} :answer-field/id #uuid "48d29f83-bdb4-5fcd-8a8c-93e6a7035123" :answer-field/key "${y}^{′}=-\\frac{8}{x+1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462632} {:answer-field/choices [{:answer/id #uuid "80541672-0915-5b6c-9017-9ac341bd9f1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461759} {:answer/id #uuid "a2defdda-9879-5425-b8f7-043e2815e940" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461760}] :answer-field/correct {:answer/id #uuid "80541672-0915-5b6c-9017-9ac341bd9f1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461759} :answer-field/id #uuid "77bf2e3a-fe25-597e-9fd5-53baa9f801cd" :answer-field/key "${y}^{′}=-\\frac{{x}^{2}}{x+1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462633}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "988f2d4b-1d26-5c62-baed-2061d6f81ef4" :question/math-academy-id "q-115751" :question/problem "![](images/25/2552222c6a0be1b1bf1e67a66b4906bb735c2d974d724d3e25e988d15388c696.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/eb/eb1303132a4fe6a26c85b4733a3039a52109b4c49408e1c82038d71885d27f70.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The solution curves have the vertical asymptote $x=-1.$\n\n- The slopes of the slope field become horizontal as $x\\to \\pm \\infty .$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=\\frac{1}{1-{x}^{2}}$ does *not* give the required behavior. The right-hand side approaches $\\pm \\infty $ as $x\\to -1,$ but it also approaches $\\pm \\infty $ as $x\\to 1,$ which is not a behavior exhibited by our slope field.\n\n- The equation ${y}^{′}=-\\frac{8}{x+1}$ gives the required behavior. Notice that\n\n$$\n-\\frac{8}{x+1}\\to 0\\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation become horizontal as $x\\to \\pm \\infty .$\n\n- The equation ${y}^{′}=-\\frac{{x}^{2}}{x+1}$ does *not* give the required behavior. Notice that\n\n$$\n-\\frac{{x}^{2}}{x+1}=-\\frac{x}{(1+\\frac{1}{x})}\\to ∓\\infty \\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become horizontal as $x\\to \\pm \\infty .$\n\nTherefore, the correct answer is ${y}^{′}=-\\frac{8}{x+1}$ only."} {:db/id #edb/ref 17592186250478 :knowledge-point/_questions [{:db/id #edb/ref 17592186166822 :knowledge-point/id #uuid "32b9a92b-880b-50de-b8e9-648fa219b83f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes" :topic/_knowledge-points [{:db/id #edb/ref 17592186050480 :topic/id #uuid "4d269723-9cfd-54a7-ba45-a1a8ba6983dd" :topic/math-academy-id 3219 :topic/title "Analyzing Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0181da5-8614-58af-ac14-1a9336d4dbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461761} {:answer/id #uuid "4d2eec4c-4f47-514b-bf5d-f2c38895ac0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461762}] :answer-field/correct {:answer/id #uuid "f0181da5-8614-58af-ac14-1a9336d4dbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461761} :answer-field/id #uuid "ecc6800d-212e-50df-85f3-d5b35178961d" :answer-field/key "${y}^{′}=7-{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462634} {:answer-field/choices [{:answer/id #uuid "84b32df7-b0d9-5ac9-b15a-2fa4213ca142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461763} {:answer/id #uuid "2e4b5a3f-874e-5bd2-a618-5e76d2280ff0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461764}] :answer-field/correct {:answer/id #uuid "84b32df7-b0d9-5ac9-b15a-2fa4213ca142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461763} :answer-field/id #uuid "9bef5e3b-3082-5dd7-8c06-9ea6d0a08d4c" :answer-field/key "${y}^{′}=-\\frac{{x}^{3}}{x+7}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462635} {:answer-field/choices [{:answer/id #uuid "f0de8a2f-f221-5129-bf2e-e14033c84895" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461765} {:answer/id #uuid "61d491ae-9078-571e-8681-ef4d10f41b84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461766}] :answer-field/correct {:answer/id #uuid "61d491ae-9078-571e-8681-ef4d10f41b84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461766} :answer-field/id #uuid "61918825-a1f6-5a04-9d13-9a6f5063d1ec" :answer-field/key "${y}^{′}=-\\frac{3}{x+7}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3be4e44a-f534-5d30-81ef-fc22fbf18076" :question/math-academy-id "q-115754" :question/problem "![](images/34/34af8d1078100aea331c300ea529d2fdefbdd31e99ee8a7946325d58a8abf680.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/d0/d02883b776dbcd55c5c96347ed1a7bb0e51ef8c26e62786049b6585b878d04fb.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The solution curves have the vertical asymptote $x=-7.$\n\n- The slopes of the slope field become horizontal as $x\\to \\pm \\infty .$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=7-{x}^{2}$ does *not* give the required behavior. The right-hand side does not approach $\\pm \\infty $ as $x\\to -7.$\n\n- The equation ${y}^{′}=-\\frac{{x}^{3}}{x+7}$ does *not* give the required behavior. Notice that\n\n$$\n-\\frac{{x}^{3}}{x+7}=-\\frac{{x}^{2}}{(1+\\frac{7}{x})}\\to -\\infty \\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become horizontal as $x\\to \\pm \\infty .$\n\n- The equation ${y}^{′}=-\\frac{3}{x+7}$ gives the required behavior. Notice that\n\n$$\n-\\frac{3}{x+7}\\to 0\\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation become horizontal as $x\\to \\pm \\infty .$\n\nTherefore, the correct answer is ${y}^{′}=-\\frac{3}{x+7}$ only."} {:db/id #edb/ref 17592186250486 :knowledge-point/_questions [{:db/id #edb/ref 17592186166860 :knowledge-point/id #uuid "762c5225-00bd-5d2f-9859-394f886482cb" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring" :topic/_knowledge-points [{:db/id #edb/ref 17592186050480 :topic/id #uuid "4d269723-9cfd-54a7-ba45-a1a8ba6983dd" :topic/math-academy-id 3219 :topic/title "Analyzing Slope Fields for Directly Integrable Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05bfcbaa-d2b1-5fe0-ad56-ec1eaae881ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461767} {:answer/id #uuid "f2f5ed1e-509a-5016-b984-67ee16a92bea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461768}] :answer-field/correct {:answer/id #uuid "05bfcbaa-d2b1-5fe0-ad56-ec1eaae881ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461767} :answer-field/id #uuid "d0bff3c9-f537-55cb-a1c9-27fc825821aa" :answer-field/key "${y}^{′}=-2{x}^{2}-4x-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462637} {:answer-field/choices [{:answer/id #uuid "73346110-21be-5682-8e62-0adb727d81ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461769} {:answer/id #uuid "26e67922-9884-5bea-aa66-b917a449fbbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461770}] :answer-field/correct {:answer/id #uuid "26e67922-9884-5bea-aa66-b917a449fbbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461770} :answer-field/id #uuid "92a7748a-62c0-5f15-97d3-4cfba9d041af" :answer-field/key "${y}^{′}={x}^{2}+2x+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462638} {:answer-field/choices [{:answer/id #uuid "3782d80d-50d4-5d80-8925-6ddad28cab0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461771} {:answer/id #uuid "f789845b-9090-5a1d-b191-815a29e6ff58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461772}] :answer-field/correct {:answer/id #uuid "3782d80d-50d4-5d80-8925-6ddad28cab0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461771} :answer-field/id #uuid "517e6b35-18b0-5548-9e90-b787cba99ee2" :answer-field/key "${y}^{′}={x}^{2}-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462639}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ef86548-9209-58c6-a39c-c5582ffe1c99" :question/math-academy-id "q-115813" :question/problem "![](images/5a/5a2a2b4b141f4f0c250e4865b174b9eb32b1ed4ab94cc6ebd074131673d5712c.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "![](images/69/69465ce0573d7b6deac631663766a5dd1c90afa29eeb0c5286cb5ef1f7ee1153.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slope field is zero along the line $x=-1.$ Therefore, the right-hand side of the differential equation should evaluate to zero on this line.\n\n- Second, the line $x=-1$ divides the plane into $2$ regions. The sign of the slopes in each of the $2$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $x<-1$ | $x>-1$ |\n| --- | --- | --- |\n| Slope | $↗$ | $↗$ |\n| Sign | $+$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation \n\n$$\n{y}^{′}=-2{x}^{2}-4x-2=-2(x+1)^{2}\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $x<-1$ | $x>-1$ |\n| --- | --- | --- |\n| Slope | $↘$ | $↘$ |\n| Sign | $-$ | $-$ |\n\n- The equation \n\n$$\n{y}^{′}={x}^{2}+2x+1=(x+1)^{2}\n$$\n\ngives the required behavior.\n\n- The equation\n\n$$\n{y}^{′}={x}^{2}-1=(x+1)(x-1)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1$ and $x=1.$\n\nTherefore, the correct answer is ${y}^{′}={x}^{2}+2x+1$ only."} {:db/id #edb/ref 17592186250498 :knowledge-point/_questions [{:db/id #edb/ref 17592186166857 :knowledge-point/id #uuid "954f8004-35b4-58ec-be26-2beccfd5f8e4" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Equilibrium Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049722 :topic/id #uuid "0e116f4e-27ca-5606-81f6-7aa01e4cd9b8" :topic/math-academy-id 3220 :topic/title "Analyzing Slope Fields for Autonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a13ba2-df2a-53c4-ab59-890eff92c862" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461773} {:answer/id #uuid "2c8128ec-1f18-5e3d-9623-98ef235d65e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461774}] :answer-field/correct {:answer/id #uuid "2c8128ec-1f18-5e3d-9623-98ef235d65e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461774} :answer-field/id #uuid "ac77012c-f8f6-517b-8535-cbeb1ede76b8" :answer-field/key "${y}^{′}={y}^{2}(y+4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462640} {:answer-field/choices [{:answer/id #uuid "b23ac169-dcc2-50a4-91ad-5546ba675abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461775} {:answer/id #uuid "1592de2f-81f1-5e83-9fb3-2b57081e984d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461776}] :answer-field/correct {:answer/id #uuid "b23ac169-dcc2-50a4-91ad-5546ba675abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461775} :answer-field/id #uuid "3aacc405-aba8-59ef-8f2c-e61fd41e6c55" :answer-field/key "${y}^{′}=(y+1)^{2}(y+4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462641} {:answer-field/choices [{:answer/id #uuid "8e5d6c14-51bd-5018-9283-62587f67196b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461777} {:answer/id #uuid "00aa593e-3e17-55f9-b363-788c4743e1ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461778}] :answer-field/correct {:answer/id #uuid "8e5d6c14-51bd-5018-9283-62587f67196b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461777} :answer-field/id #uuid "6637ca01-1eec-5fbc-b8d7-52e3f75e1383" :answer-field/key "${y}^{′}=-y(y+1)(y+4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462642}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "335e4d6e-44ad-5f4c-9625-f1960ad24196" :question/math-academy-id "q-115880" :question/problem "![](images/bc/bc5b29fca0521e3da39993d0359e857333611c68c35e49c037ca7af031288ba3.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/cd/cd73bc9f35e167537996a3b33b84471dcb8fefe2eccb4afd21ca55a23e6478fd.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $y=-4$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}={y}^{2}(y+4)$ gives the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=-4.$\n\n- The equation ${y}^{′}=(y+1)^{2}(y+4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=-1$ and $y=-4.$\n\n- The equation ${y}^{′}=-y(y+1)(y+4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=-4,$ but it also evaluates to zero when $y=-1,$ which is not behavior exhibited by our slope field.\n\nTherefore, the correct answer is ${y}^{′}={y}^{2}(y+4)$ only."} {:db/id #edb/ref 17592186250501 :knowledge-point/_questions [{:db/id #edb/ref 17592186166857 :knowledge-point/id #uuid "954f8004-35b4-58ec-be26-2beccfd5f8e4" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Equilibrium Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049722 :topic/id #uuid "0e116f4e-27ca-5606-81f6-7aa01e4cd9b8" :topic/math-academy-id 3220 :topic/title "Analyzing Slope Fields for Autonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3b28ebd-2da3-54ab-9d77-fc487f69e66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461779} {:answer/id #uuid "88fb7312-db4e-54ff-92a6-cd4527b5dd20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461780}] :answer-field/correct {:answer/id #uuid "88fb7312-db4e-54ff-92a6-cd4527b5dd20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461780} :answer-field/id #uuid "363e79a8-3fd4-5599-8fe9-4d374c61acaf" :answer-field/key "${y}^{′}=-(y-1)(y-4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462643} {:answer-field/choices [{:answer/id #uuid "2e853698-7ef8-5248-8f60-ed61f77b54ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461781} {:answer/id #uuid "aa9efb90-7713-5996-a837-d2bba696af8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461782}] :answer-field/correct {:answer/id #uuid "2e853698-7ef8-5248-8f60-ed61f77b54ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461781} :answer-field/id #uuid "0467632c-8d73-5cfc-b4fc-dd1fe9d061a1" :answer-field/key "${y}^{′}=y(y-1)(y-4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462644} {:answer-field/choices [{:answer/id #uuid "02a278e1-8a46-57c3-86a0-51641f029c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461783} {:answer/id #uuid "5a66f5b5-c022-5c22-90bc-ab3ce4998343" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461784}] :answer-field/correct {:answer/id #uuid "02a278e1-8a46-57c3-86a0-51641f029c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461783} :answer-field/id #uuid "4d079fd4-b9c4-55e1-881a-039ed58ace65" :answer-field/key "${y}^{′}={y}^{2}(y-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5780ba6c-1a2c-5799-b86a-8148f7437eba" :question/math-academy-id "q-115888" :question/problem "![](images/2e/2e2d4b78d8181efc77f65af0c3dc4b3110d0203e650006a0e99d9a8ba933b53f.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/7e/7e207bc990a9dfbafa8474ad13c17482e21c323833be848f4ebbaa580abeb201.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $y=1$ and $y=4,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=-(y-1)(y-4)$ gives the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=4.$\n\n- The equation ${y}^{′}=y(y-1)(y-4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=4,$ but it also evaluates to zero when $y=0,$ which is not behavior exhibited by our slope field.\n\n- The equation ${y}^{′}={y}^{2}(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=1.$\n\nTherefore, the correct answer is ${y}^{′}=-(y-1)(y-4)$ only."} {:db/id #edb/ref 17592186250511 :knowledge-point/_questions [{:db/id #edb/ref 17592186166858 :knowledge-point/id #uuid "0ca086fd-9732-5c4b-9cb0-168433d79203" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes" :topic/_knowledge-points [{:db/id #edb/ref 17592186049722 :topic/id #uuid "0e116f4e-27ca-5606-81f6-7aa01e4cd9b8" :topic/math-academy-id 3220 :topic/title "Analyzing Slope Fields for Autonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c93c399-00d1-5205-8db5-10d92ae96715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461785} {:answer/id #uuid "f77f69f4-a570-5d80-a8a6-48163a5d6764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461786}] :answer-field/correct {:answer/id #uuid "2c93c399-00d1-5205-8db5-10d92ae96715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461785} :answer-field/id #uuid "f7c4c22a-e834-5659-826d-b8d7b696410a" :answer-field/key "${y}^{′}=(y+1)^{2}(y-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462646} {:answer-field/choices [{:answer/id #uuid "efe737c2-056d-5907-a016-495bc652f029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461787} {:answer/id #uuid "1abcb48d-8fc7-5e52-adc3-2406e162b5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461788}] :answer-field/correct {:answer/id #uuid "1abcb48d-8fc7-5e52-adc3-2406e162b5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461788} :answer-field/id #uuid "fb0630b3-442d-5d36-b79b-15c3aa1660ca" :answer-field/key "${y}^{′}=(y+1)(1-y)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462647} {:answer-field/choices [{:answer/id #uuid "9d5974de-30b1-5750-9c48-9691a45d5aae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461789} {:answer/id #uuid "9d539f26-33ac-5416-a752-bb943ff2cfef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461790}] :answer-field/correct {:answer/id #uuid "9d5974de-30b1-5750-9c48-9691a45d5aae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461789} :answer-field/id #uuid "c89a4c3e-6590-5ccb-a89d-11e34b7b1e82" :answer-field/key "${y}^{′}=(y-1)^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d530f455-01e1-528c-b25a-48e2a9adee74" :question/math-academy-id "q-115935" :question/problem "![](images/57/57ecd122ba41b296b3884ecd4f748f6b4ac4bd1d26f14d7b5166c5fe6e33674b.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/e1/e109d237419aaba5efcc0c65c2d97c8f8ded17d18f98bb0a95eba3336d224590.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $y=\\pm 1.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=\\pm 1$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<-1$ | $-1<y<1$ | $y>1$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↘$ |\n| Sign | $-$ | $+$ | $-$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=(y+1)^{2}(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=\\pm 1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<-1$ | $-1<y<1$ | $y>1$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↘$ | $↗$ |\n| Sign | $-$ | $-$ | $+$ |\n\n- The equation ${y}^{′}=(y+1)(1-y)$ gives the required behavior.\n\n- The equation ${y}^{′}=(y-1)^{2}$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ only.\n\nTherefore, the correct answer is ${y}^{′}=(y+1)(1-y)$ only."} {:db/id #edb/ref 17592186250512 :knowledge-point/_questions [{:db/id #edb/ref 17592186166858 :knowledge-point/id #uuid "0ca086fd-9732-5c4b-9cb0-168433d79203" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes" :topic/_knowledge-points [{:db/id #edb/ref 17592186049722 :topic/id #uuid "0e116f4e-27ca-5606-81f6-7aa01e4cd9b8" :topic/math-academy-id 3220 :topic/title "Analyzing Slope Fields for Autonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04109485-38c2-5f25-a519-b42955f327a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461791} {:answer/id #uuid "b965cafb-f238-5475-a2d4-db6ce5eb4dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461792}] :answer-field/correct {:answer/id #uuid "b965cafb-f238-5475-a2d4-db6ce5eb4dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461792} :answer-field/id #uuid "486d60e1-a23f-5175-b6b8-6eb4fa77287a" :answer-field/key "${y}^{′}={y}^{2}(3-y)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462649} {:answer-field/choices [{:answer/id #uuid "d060e560-3171-5fff-bd5c-30b612cf104b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461793} {:answer/id #uuid "e3a88cad-3dc5-517b-8bad-bf317b5f6c10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461794}] :answer-field/correct {:answer/id #uuid "d060e560-3171-5fff-bd5c-30b612cf104b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461793} :answer-field/id #uuid "6490f717-f1c9-5e21-b369-f4119efd6e54" :answer-field/key "${y}^{′}=y(y-3)^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462650} {:answer-field/choices [{:answer/id #uuid "b3a8d5b3-e7b4-5f2b-a838-73e0ad428210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461795} {:answer/id #uuid "0e52114e-8c8e-5d15-9018-8abe4cc56551" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461796}] :answer-field/correct {:answer/id #uuid "b3a8d5b3-e7b4-5f2b-a838-73e0ad428210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461795} :answer-field/id #uuid "2247f5d8-5487-572b-b7b7-3c599a39f29a" :answer-field/key "${y}^{′}=y(y-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462651}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe403345-e284-5ce7-b15f-086966b32179" :question/math-academy-id "q-115940" :question/problem "![](images/92/92c557774a625d93c34fea181f435c1e6e544daa606a76c512bd96a7b9c047e7.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/58/583fe0e13218462bdb4286ce456b0bcc4d43dd3772033e62a53242107a0a69db.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $y=0$ and $y=3.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=0$ and $y=3$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<0$ | $0<y<3$ | $y>3$ |\n| --- | --- | --- | --- |\n| Slope | $↗$ | $↗$ | $↘$ |\n| Sign | $+$ | $+$ | $-$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}={y}^{2}(3-y)$ gives the required behavior.\n\n- The equation ${y}^{′}=y(y-3)^{2}$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=3,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<0$ | $0<y<3$ | $y>3$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↗$ |\n| Sign | $-$ | $+$ | $+$ |\n\n- The equation ${y}^{′}=y(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=0.$\n\nTherefore, the correct answer is ${y}^{′}={y}^{2}(3-y)$ only."} {:db/id #edb/ref 17592186250518 :knowledge-point/_questions [{:db/id #edb/ref 17592186166859 :knowledge-point/id #uuid "fba5f68e-15da-5804-b6d9-d72ce6acae59" :knowledge-point/title "Identifying an Equation That Generates a Slope Field by Identifying Asymptotic Behavior" :topic/_knowledge-points [{:db/id #edb/ref 17592186049722 :topic/id #uuid "0e116f4e-27ca-5606-81f6-7aa01e4cd9b8" :topic/math-academy-id 3220 :topic/title "Analyzing Slope Fields for Autonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6406ea0c-d398-53da-8121-bc8b8cbef85b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461797} {:answer/id #uuid "38fe89af-041f-5f67-a609-1f185814986e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461798}] :answer-field/correct {:answer/id #uuid "38fe89af-041f-5f67-a609-1f185814986e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461798} :answer-field/id #uuid "bb11d9b3-0886-59bc-8089-a6919106a383" :answer-field/key "${y}^{′}=-\\frac{1}{y+3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462652} {:answer-field/choices [{:answer/id #uuid "2dd31cd7-9886-5da3-9db1-a3727c748122" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461799} {:answer/id #uuid "d5b0c3dd-f33a-57a6-9ef9-034ee3c77321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461800}] :answer-field/correct {:answer/id #uuid "2dd31cd7-9886-5da3-9db1-a3727c748122" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461799} :answer-field/id #uuid "33dd7160-e17e-53b2-94f0-97450282ace1" :answer-field/key "${y}^{′}=\\frac{1}{(y+3)^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462653} {:answer-field/choices [{:answer/id #uuid "f60d6aa9-be98-5d12-9cf1-725213adda8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461801} {:answer/id #uuid "008761dc-0095-56cd-a692-4b3ee2a31d11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461802}] :answer-field/correct {:answer/id #uuid "f60d6aa9-be98-5d12-9cf1-725213adda8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461801} :answer-field/id #uuid "3d1396a6-5b69-56e2-8588-8b83ce3f9319" :answer-field/key "${y}^{′}=-\\frac{y}{y+3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462654}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "df71ed63-f106-5382-97b4-fb9c0eee25d2" :question/math-academy-id "q-116040" :question/problem "![](images/dd/ddb340a99b8ab92d60e17184274854ce3d1b1bfa4972a79e74b8bfe9b0a81ce7.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/73/73ba54766cd08a0b596e43cd8da93209e2548c68821e70a44418a24dfdf27a38.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The slopes of the slope field become vertical as $y\\to -3.$\n\n- The slopes of the slope field become horizontal as $y\\to \\infty .$\n\n- The slopes of the slope field are positive for $y<-3$ and negative for $y>-3.$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=-\\frac{1}{y+3}$ gives the required behavior. Notice that ${y}^{′}\\to 0$ as $y\\to \\infty ,$ and ${y}^{′}\\to \\infty $ as $y\\to -3.$ Also, the right-hand side of this equation is positive for $y<-3$ and negative for $y>-3.$\n\n- The equation ${y}^{′}=-\\frac{1}{(y+3)^{2}}$ does *not* give the required behavior. The slopes of the slope field for this differential equation are positive for all $y\\ne -3.$\n\n- The equation ${y}^{′}=-\\frac{y}{y+3}$ does *not* give the required behavior. Notice that\n\n$$\n-\\frac{y}{y+3}=-\\frac{1}{(1+\\frac{3}{y})}\\to -1\\,\\text{as}\\,y\\to \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become horizontal as $y\\to \\infty .$"} {:db/id #edb/ref 17592186250536 :knowledge-point/_questions [{:db/id #edb/ref 17592186166861 :knowledge-point/id #uuid "800080f9-db79-5218-acaf-04040ab28a5d" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring" :topic/_knowledge-points [{:db/id #edb/ref 17592186049722 :topic/id #uuid "0e116f4e-27ca-5606-81f6-7aa01e4cd9b8" :topic/math-academy-id 3220 :topic/title "Analyzing Slope Fields for Autonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1661e35a-81ab-54c7-ab06-2d580b985de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461803} {:answer/id #uuid "0886101e-8279-5760-93e9-6582fa02c3e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461804}] :answer-field/correct {:answer/id #uuid "0886101e-8279-5760-93e9-6582fa02c3e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461804} :answer-field/id #uuid "f597d79e-6a3e-5949-bed9-83548deff95f" :answer-field/key "${y}^{′}=-{y}^{3}-2{y}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462655} {:answer-field/choices [{:answer/id #uuid "521cf4fb-97e7-55f9-86cb-683960610173" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461805} {:answer/id #uuid "91b4b871-0fe2-5d7c-976d-ffeff7555e69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461806}] :answer-field/correct {:answer/id #uuid "521cf4fb-97e7-55f9-86cb-683960610173" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461805} :answer-field/id #uuid "c353ad8a-24a9-5acc-b0b2-05d92f5c6a3f" :answer-field/key "${y}^{′}={y}^{3}+4{y}^{2}+4y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462656} {:answer-field/choices [{:answer/id #uuid "9280f3f2-5c55-5703-916d-77116f1462e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461807} {:answer/id #uuid "850a75e2-6648-5983-b3cc-b05819c88401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461808}] :answer-field/correct {:answer/id #uuid "9280f3f2-5c55-5703-916d-77116f1462e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461807} :answer-field/id #uuid "32181f81-74f9-5051-832c-66c255fe625d" :answer-field/key "${y}^{′}=2y-{y}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462657}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5fe91b2-7a65-5a6c-99ca-fdba41d5ec25" :question/math-academy-id "q-116150" :question/problem "![](images/15/158e4f6067ce12d5a31cc6ee0b217a8d11a459db5883fdd0b28ffdc2bd969a5e.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/41/41b6dc7fd4e9a7dba6e14fe2d9fb87e7c07736ec0fc3cc111dd347b61c1075bb.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slope field is zero along the lines $y=-2$ and $y=0.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=-2$ and $y=0$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<-2$ | $-2<y<0$ | $y>0$ |\n| --- | --- | --- | --- |\n| Slope | $↗$ | $↘$ | $↘$ |\n| Sign | $+$ | $-$ | $-$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation \n\n$$\n{y}^{′}=-{y}^{3}-2{y}^{2}=-{y}^{2}(y+2)\n$$\n\ngives the required behavior.\n\n- The equation \n\n$$\n{y}^{′}={y}^{3}+4{y}^{2}+4y=y({y}^{2}+4y+4)=y(y+2)^{2}\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $y=-2$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<-2$ | $-2<y<0$ | $y>0$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↘$ | $↗$ |\n| Sign | $-$ | $-$ | $+$ |\n\n- The equation\n\n$$\n{y}^{′}=2y-{y}^{2}=y(2-y)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=2.$\n\nTherefore, the correct answer is ${y}^{′}=-{y}^{3}-2{y}^{2}$ only."} {:db/id #edb/ref 17592186253256 :knowledge-point/_questions [{:db/id #edb/ref 17592186087700 :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049125 :topic/id #uuid "dcaddd67-a2eb-5a06-88ab-be47014dbd14" :topic/math-academy-id 863 :topic/title "Introduction to the Inverse of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "373c885e-aef8-50b9-911a-ec047f2d5681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448042} {:answer/id #uuid "20c8ff2a-dc3c-5659-91b9-08202181b0c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448043}] :answer-field/correct {:answer/id #uuid "373c885e-aef8-50b9-911a-ec047f2d5681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448042} :answer-field/id #uuid "ed3fa0be-e63d-5195-b281-fe8450f3750c" :answer-field/key "$AB=BA={I}_{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449061} {:answer-field/choices [{:answer/id #uuid "015547b8-bd38-530c-8e48-88bc8e2e2e09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448044} {:answer/id #uuid "1e7fb983-a1ee-5142-94cd-263cd7c41eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448045}] :answer-field/correct {:answer/id #uuid "1e7fb983-a1ee-5142-94cd-263cd7c41eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448045} :answer-field/id #uuid "d5993f1a-def4-558a-814a-d16d4117184e" :answer-field/key "$AC=CA={I}_{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449062} {:answer-field/choices [{:answer/id #uuid "40c83f9f-5824-5aed-81dd-43478e72282d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448046} {:answer/id #uuid "95a699cb-8161-554e-9a4d-c4e507a37e99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448047}] :answer-field/correct {:answer/id #uuid "40c83f9f-5824-5aed-81dd-43478e72282d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448046} :answer-field/id #uuid "d65054a8-c89c-52ab-a032-831b9f5b6b89" :answer-field/key "$B={A}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449063}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9db68f61-a1ba-5fec-8a45-32913742b631" :question/math-academy-id "q-11634" :question/problem "Consider the matrices\n\n$$\nA=\\begin{bmatrix}-1 & 3 & 2 \\\\ 2 & 1 & -2 \\\\ 0 & 1 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-3 & 1 & 8 \\\\ 2 & 1 & -2 \\\\ -2 & -1 & 7\\end{bmatrix},\\,C=\\frac{1}{5}\\begin{bmatrix}-3 & 1 & 8 \\\\ 2 & 1 & -2 \\\\ -2 & -1 & 7\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- First, we check whether $AB=BA={I}_{3}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-1 & 3 & 2 \\\\ 2 & 1 & -2 \\\\ 0 & 1 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 1 & 8 \\\\ 2 & 1 & -2 \\\\ -2 & -1 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & ∗ & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $AB=BA={I}_{3}$ is false. As a result, $B\\ne {A}^{-1}$ and statement $B={A}^{-1}$ is false too.\n\n- Now, we check whether $AC=CA={I}_{3}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\frac{1}{5}\\begin{bmatrix}-1 & 3 & 2 \\\\ 2 & 1 & -2 \\\\ 0 & 1 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 1 & 8 \\\\ 2 & 1 & -2 \\\\ -2 & -1 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\frac{1}{5}\\begin{bmatrix}-3 & 1 & 8 \\\\ 2 & 1 & -2 \\\\ -2 & -1 & 7\\end{bmatrix}\\begin{bmatrix}-1 & 3 & 2 \\\\ 2 & 1 & -2 \\\\ 0 & 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{3}$ is true. \nTherefore, the correct answer is $AC=CA={I}_{3}$ only."} {:db/id #edb/ref 17592186253257 :knowledge-point/_questions [{:db/id #edb/ref 17592186087700 :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049125 :topic/id #uuid "dcaddd67-a2eb-5a06-88ab-be47014dbd14" :topic/math-academy-id 863 :topic/title "Introduction to the Inverse of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "571118f7-834d-565e-8ce1-6917716176bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448048} {:answer/id #uuid "feda0f47-91fe-5b24-a64c-d9d72c65d7be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448049}] :answer-field/correct {:answer/id #uuid "feda0f47-91fe-5b24-a64c-d9d72c65d7be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448049} :answer-field/id #uuid "2f2afe7a-b39e-52d9-b782-4c29afe645ed" :answer-field/key "$AC=CA={I}_{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449064} {:answer-field/choices [{:answer/id #uuid "d4daa118-2951-524a-a8a5-a07a11973d0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448050} {:answer/id #uuid "02b9525c-5aa7-5637-9eb7-f2af65078057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448051}] :answer-field/correct {:answer/id #uuid "d4daa118-2951-524a-a8a5-a07a11973d0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448050} :answer-field/id #uuid "72a46244-d72a-5634-be81-4125503e6ad9" :answer-field/key "$AD=DA={I}_{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449065} {:answer-field/choices [{:answer/id #uuid "3f8c239a-1d74-5503-87f3-5a2380f75c99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448052} {:answer/id #uuid "c8086890-3a86-5a1b-876b-fba7bced727e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448053}] :answer-field/correct {:answer/id #uuid "3f8c239a-1d74-5503-87f3-5a2380f75c99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448052} :answer-field/id #uuid "55292d74-822b-5992-b5bf-236b8ac95ebf" :answer-field/key "$D={A}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449066}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a987f21-4e16-5f44-b8f8-8e69cf93fc24" :question/math-academy-id "q-11636" :question/problem "Consider the matrices\n\n$$\nA=\\begin{bmatrix}3 & 4 & 0 \\\\ -2 & 3 & 1 \\\\ -1 & 1 & 0\\end{bmatrix},\\,C=\\frac{1}{7}\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix},\\,D=\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- First, we check whether $AC=CA={I}_{3}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\frac{1}{7}\\begin{bmatrix}3 & 4 & 0 \\\\ -2 & 3 & 1 \\\\ -1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\frac{1}{7}\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix}\\begin{bmatrix}3 & 4 & 0 \\\\ -2 & 3 & 1 \\\\ -1 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{3}$ is true.\n\n- Now, we check whether $AD=DA={I}_{3}.$ Computing $AD$, we get\n\n$$\n\\begin{aligned}AD & =\\begin{bmatrix}3 & 4 & 0 \\\\ -2 & 3 & 1 \\\\ -1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & ∗ & ∗ \\\\ ∗ & 7 & ∗ \\\\ ∗ & ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $AD=DA={I}_{3}$ is false. As a result, $D\\ne {A}^{-1}$ and statement $D={A}^{-1}$ is false too.\n\nTherefore, the correct answer is $AC=CA={I}_{3}$ only."} {:db/id #edb/ref 17592186253258 :knowledge-point/_questions [{:db/id #edb/ref 17592186087699 :knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09" :knowledge-point/title "Determining the Inverse of a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049125 :topic/id #uuid "dcaddd67-a2eb-5a06-88ab-be47014dbd14" :topic/math-academy-id 863 :topic/title "Introduction to the Inverse of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4efcf39-ef5c-51be-9197-fd336dcc21cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448054} {:answer/id #uuid "46eb2630-2587-530d-ae7f-6568bb2b9247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448055}] :answer-field/correct {:answer/id #uuid "46eb2630-2587-530d-ae7f-6568bb2b9247" :answer/type {:db/id #edb/ref 17592186045499 :db/i