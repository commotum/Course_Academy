d/choices [{:answer/id #uuid "257f0459-756d-5bef-93c8-2315439df9a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461849} {:answer/id #uuid "2a309c64-ac52-5561-ac65-e3710790558e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461850}] :answer-field/correct {:answer/id #uuid "2a309c64-ac52-5561-ac65-e3710790558e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461850} :answer-field/id #uuid "df96a148-3ab6-53a8-bfb3-0111bf03f0d5" :answer-field/key "$(-\\frac{\\sqrt{3}}{3},-\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462678}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bfbb710f-9bcf-5482-b898-5f45cf7ceff2" :question/math-academy-id "q-117366" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(1,\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(1,\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-\\frac{\\sqrt{3}}{3},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},-\\frac{\\sqrt{3}}{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{3},-\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$"} {:db/id #edb/ref 17592186253337 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049656 :topic/id #uuid "08bc988d-9fd4-51b9-b9a1-01573e3679f4" :topic/math-academy-id 1487 :topic/title "Graphing the Inverse Tangent Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c78a2d78-de5b-55db-9598-b2738d47cf1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461851} {:answer/id #uuid "3b2cfab7-7117-5fc2-99af-f66e7b541971" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461852}] :answer-field/correct {:answer/id #uuid "3b2cfab7-7117-5fc2-99af-f66e7b541971" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461852} :answer-field/id #uuid "f58d20dc-9c7d-500c-a86a-f3f1271fa49f" :answer-field/key "$(\\frac{\\sqrt{3}}{3},\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462679} {:answer-field/choices [{:answer/id #uuid "94823d85-e3b3-52c9-9f56-e5542e922a79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461853} {:answer/id #uuid "24ead7ad-8485-5ded-ae26-9d6c7d203b4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461854}] :answer-field/correct {:answer/id #uuid "94823d85-e3b3-52c9-9f56-e5542e922a79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461853} :answer-field/id #uuid "809ec92f-116c-5ca0-acee-614fc750aad8" :answer-field/key "$(\\sqrt{3},\\frac{7\\pi }{3})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462680} {:answer-field/choices [{:answer/id #uuid "4b8e8f20-54be-52d5-9909-13466cd4de2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461855} {:answer/id #uuid "f79a093b-71bd-5e31-bb2f-d45dcebd2e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461856}] :answer-field/correct {:answer/id #uuid "f79a093b-71bd-5e31-bb2f-d45dcebd2e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461856} :answer-field/id #uuid "5fce65dd-a328-5462-9d11-7b16710dbaba" :answer-field/key "$(0,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462681}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d01f8dbc-d72d-57bf-bd1d-25c6d02854e4" :question/math-academy-id "q-117371" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(\\frac{\\sqrt{3}}{3},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{3}}{3},\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{7\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{7\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{7\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(\\sqrt{3},\\frac{7\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(0,0).$ We note the following:\n\n- The point $(0,0)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=0$ lies within this range. $\\,✓$\n\nTherefore, the point $(0,0)$ does lie on the graph of $y=\\operatorname{arctan}⁡x.$"} {:db/id #edb/ref 17592186253444 :knowledge-point/_questions [{:db/id #edb/ref 17592186172017 :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring" :topic/_knowledge-points [{:db/id #edb/ref 17592186048885 :topic/id #uuid "c96ee93a-fd82-595c-824f-e11934066ffc" :topic/math-academy-id 3350 :topic/title "Analyzing Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c63043b-4d95-5271-bd03-04c48cf42652" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461857} {:answer/id #uuid "c435a8df-48c3-55f3-bf34-545dd961babb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461858}] :answer-field/correct {:answer/id #uuid "7c63043b-4d95-5271-bd03-04c48cf42652" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461857} :answer-field/id #uuid "69e6dd76-17e5-5d00-b6a3-2725217da17c" :answer-field/key "${y}^{′}={x}^{2}y+{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462682} {:answer-field/choices [{:answer/id #uuid "9f3b0f15-11c5-5f91-8e39-a4700396d70b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461859} {:answer/id #uuid "413ccddf-0828-5899-b41a-c5b854115744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461860}] :answer-field/correct {:answer/id #uuid "9f3b0f15-11c5-5f91-8e39-a4700396d70b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461859} :answer-field/id #uuid "8a8bbbbd-3619-58c4-a2c4-e30a857f4e01" :answer-field/key "${y}^{′}=xy-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462683} {:answer-field/choices [{:answer/id #uuid "aa9e1a21-a120-5fbf-b91e-9951a669f7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461861} {:answer/id #uuid "5bfa0a89-a5fb-5b03-9b6b-0a15e263c8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461862}] :answer-field/correct {:answer/id #uuid "5bfa0a89-a5fb-5b03-9b6b-0a15e263c8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461862} :answer-field/id #uuid "569a9252-47cd-5e75-9c9f-40b194a881a6" :answer-field/key "${y}^{′}=x{y}^{2}+2xy+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462684}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f47e52f5-b113-5140-ac0d-d3912c7ac7a7" :question/math-academy-id "q-118025" :question/problem "![](images/50/5077a94fe8b5d5435b5bf50d0ea687f5bc87ae95011e22800ccfe473f8af78dd.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "![](images/2f/2f7075161363dee2817aeb8aff9e85781a10bd30c926bfff73724992eee699ac.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=-1,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=0$ and $y=-1$ divide the plane into $4$ quarters. The sign of the slopes in each of the $4$ quarters are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>-1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<-1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation ${y}^{′}={x}^{2}y+{x}^{2}$ does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}={x}^{2}y+{x}^{2}={x}^{2}(y+1)\n$$\n\nevaluates to zero at $x=0$ and $y=-1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>-1$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $-$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation ${y}^{′}=xy-x$ does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=xy-x=x(y-1)\n$$\n\nevaluates to zero at $x=0$ and $y=1.$\n\n- Equation ${y}^{′}=x{y}^{2}+2xy+x$ gives the required behavior. The right-hand side of\n\n$$\n{y}^{′}=x{y}^{2}+2xy+x=x(y+1)^{2}\n$$\n\nevaluates to zero at $x=0$ and $y=-1,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>-1$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\nTherefore, the correct answer is ${y}^{′}=x{y}^{2}+2xy+x$ only."} {:db/id #edb/ref 17592186253501 :knowledge-point/_questions [{:db/id #edb/ref 17592186105922 :knowledge-point/id #uuid "4e93fd7f-070f-5359-aabb-cba5cc275015" :knowledge-point/title "Identifying Convergent or Divergent Integrals With Unbounded Limits" :topic/_knowledge-points [{:db/id #edb/ref 17592186048880 :topic/id #uuid "c9449775-49cd-5723-869d-965280e34916" :topic/math-academy-id 1382 :topic/title "Improper Integrals Over the Real Line"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb5142f6-3668-5c25-bd3b-ad8d86c32b81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448060} {:answer/id #uuid "7f997281-b88c-5dd5-bfb8-151c4ca4f3b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448061}] :answer-field/correct {:answer/id #uuid "bb5142f6-3668-5c25-bd3b-ad8d86c32b81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448060} :answer-field/id #uuid "38c97076-8571-5bd9-b9cc-05ead189c06a" :answer-field/key "${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is convergent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449070} {:answer-field/choices [{:answer/id #uuid "83a8cf32-8c05-57f0-b07c-8619e74a5e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448062} {:answer/id #uuid "2190c7c9-638d-5cac-b33b-bf19444c205d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448063}] :answer-field/correct {:answer/id #uuid "2190c7c9-638d-5cac-b33b-bf19444c205d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448063} :answer-field/id #uuid "aa4d3171-d27d-5383-84f5-fff37db3a18f" :answer-field/key "${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is divergent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449071} {:answer-field/choices [{:answer/id #uuid "d086c6fe-ca1b-589b-9bf5-edc298cbf2b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448064} {:answer/id #uuid "4c940020-f387-5c2f-8a62-86f9ec0bd046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448065}] :answer-field/correct {:answer/id #uuid "4c940020-f387-5c2f-8a62-86f9ec0bd046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448065} :answer-field/id #uuid "29dae20b-066b-57e8-839e-ee1a6bc08141" :answer-field/key "${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449072}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "260fa3cd-f59d-50c6-a56e-8cfbd29393f0" :question/math-academy-id "q-118755" :question/problem "Consider the function $f(x)=\\frac{x}{{x}^{2}+4}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Suppose we have an improper integral in which both the left and right endpoints are unbounded:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x\n$$\n\nIf the integrand $f(x)$ is continuous on $(-\\infty ,\\infty ),$ then we can break the integral up into two improper integrals, each with a single unbounded endpoint:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x\n$$\n\nThen, we can compute each of the two integrals separately and combine their results. \n\n**Watch out!** If either of the two integrals on the right-hand side is divergent, then the integral on the left-hand side is also divergent.\n\nFirst, we calculate the antiderivative using a substitution.  Let $u={x}^{2}+4$,  then $\\text{d}u=2x\\,\\text{d}x.$ Hence, the antiderivative is\n\n$$\n\\begin{aligned}\\int \\frac{x}{{x}^{2}+4}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+4)+C.\\end{aligned}\n$$\n\nNow, let's evaluate each integral in turn.\n\n- Statement “${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is convergent” is false. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{x}^{2}+4}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{x}{{x}^{2}+4}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{(\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+4))|}_{0}^{a} \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }(\\operatorname{ln}⁡({a}^{2}+4)-\\operatorname{ln}⁡4) \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }\\operatorname{ln}⁡({a}^{2}+4)-\\frac{\\operatorname{ln}⁡4}{2}.\\end{aligned}\n$$\n\nAs $a\\to \\infty $, we have that $\\operatorname{ln}⁡({a}^{2}+4)\\to \\infty .$ So the integral diverges.\n\n- Statement “${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is divergent” is true. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{x}{{x}^{2}+4}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{x}{{x}^{2}+4}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{(\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+4))|}_{a}^{0} \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }(\\operatorname{ln}⁡4-\\operatorname{ln}⁡({a}^{2}+4)) \\\\  & =\\frac{\\operatorname{ln}⁡4}{2}-{lim}_{a\\to -\\infty }\\operatorname{ln}⁡({a}^{2}+4).\\end{aligned}\n$$\n\nAs $a\\to -\\infty $, we have that $\\operatorname{ln}⁡({a}^{2}+4)\\to \\infty .$ So the integral diverges.\n\n- Statement “${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent” is true. The integral in statement “${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent” can be expressed as\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x.\n$$\n\nHowever, both integrals on the right-hand side are divergent. Therefore, the integral on the left-hand side is also divergent.\n\nIn conclusion,  only statements “${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is divergent” and “${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent” are true."} {:db/id #edb/ref 17592186253504 :knowledge-point/_questions [{:db/id #edb/ref 17592186105922 :knowledge-point/id #uuid "4e93fd7f-070f-5359-aabb-cba5cc275015" :knowledge-point/title "Identifying Convergent or Divergent Integrals With Unbounded Limits" :topic/_knowledge-points [{:db/id #edb/ref 17592186048880 :topic/id #uuid "c9449775-49cd-5723-869d-965280e34916" :topic/math-academy-id 1382 :topic/title "Improper Integrals Over the Real Line"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "868fce7e-dc8d-506d-8541-a2b33751a81f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448066} {:answer/id #uuid "93200da6-dc06-5778-8c75-662454876dc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448067}] :answer-field/correct {:answer/id #uuid "93200da6-dc06-5778-8c75-662454876dc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448067} :answer-field/id #uuid "6008c1c7-0c91-5c4f-b77d-3d2001714e26" :answer-field/key "${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is divergent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449073} {:answer-field/choices [{:answer/id #uuid "da1f27e2-e43a-595a-af92-12d42e44e236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448068} {:answer/id #uuid "c4a72708-a8dd-5f39-8ec8-0aa6abdf7840" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448069}] :answer-field/correct {:answer/id #uuid "da1f27e2-e43a-595a-af92-12d42e44e236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448068} :answer-field/id #uuid "ba4664ca-f99b-51de-bc33-708da1a4905c" :answer-field/key "${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is convergent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449074} {:answer-field/choices [{:answer/id #uuid "1db0002c-4097-593b-977f-e88306dd33de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448070} {:answer/id #uuid "5820192e-8f09-59ad-9b73-592b6892f4dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448071}] :answer-field/correct {:answer/id #uuid "5820192e-8f09-59ad-9b73-592b6892f4dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448071} :answer-field/id #uuid "fc2690eb-e811-51ff-94f1-5c1490a665aa" :answer-field/key "${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449075}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "96df78fc-91b5-5b18-90a4-e309d8513bb9" :question/math-academy-id "q-118761" :question/problem "Consider the function $f(x)=x\\operatorname{cos}⁡({x}^{2}).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Suppose we have an improper integral in which both the left and right endpoints are unbounded:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x\n$$\n\nIf the integrand $f(x)$ is continuous on $(-\\infty ,\\infty ),$ then we can break the integral up into two improper integrals, each with a single unbounded endpoint:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x\n$$\n\nThen, we can compute each of the two integrals separately and combine their results. \n\n**Watch out!** If either of the two integrals on the right-hand side is divergent, then the integral on the left-hand side is also divergent.\n\nFirst, we calculate the antiderivative using a substitution.  Let $u={x}^{2}$,  then $\\text{d}u=2x\\,\\text{d}x.$ Hence, the antiderivative is\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x & =\\frac{1}{2}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡({x}^{2})+C.\\end{aligned}\n$$\n\nNow, let's evaluate each integral in turn.\n\n- Statement “${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is divergent” is true. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{(\\frac{1}{2}\\operatorname{sin}⁡({x}^{2}))|}_{0}^{a} \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }(\\operatorname{sin}⁡({a}^{2})-\\operatorname{sin}⁡0) \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡({a}^{2}).\\end{aligned}\n$$\n\nAs $a\\to \\infty $, $\\operatorname{sin}⁡({a}^{2})$ oscillates between $-1$ and $1.$ So the integral diverges.\n\n- Statement “${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is convergent” is false. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{(\\frac{1}{2}\\operatorname{sin}⁡({x}^{2}))|}_{a}^{0} \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡({a}^{2})) \\\\  & =-\\frac{1}{2}{lim}_{a\\to -\\infty }\\operatorname{sin}⁡({a}^{2}).\\end{aligned}\n$$\n\nAs $a\\to -\\infty $, $\\operatorname{sin}⁡({a}^{2})$ oscillates between $-1$ and $1.$ So the integral diverges.\n\n- Statement “${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent” is true. The integral in statement “${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent” can be expressed as\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x.\n$$\n\nHowever, both integrals on the right-hand side are divergent. Therefore, the integral on the left-hand side is also divergent.\n\nIn conclusion, only statements “${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is divergent” and “${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent” are true."} {:db/id #edb/ref 17592186253511 :knowledge-point/_questions [{:db/id #edb/ref 17592186166813 :knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "860b7136-4797-5983-a802-c78784e3f2c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422183} {:answer/id #uuid "1ef28afe-8d1f-5280-9074-b3d607cfb6f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422184}] :answer-field/correct {:answer/id #uuid "1ef28afe-8d1f-5280-9074-b3d607cfb6f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422184} :answer-field/id #uuid "98b3ba94-ca57-54ea-a808-cabf5df200db" :answer-field/key "${y}^{″}+{y}^{′}={x}^{2}-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422372} {:answer-field/choices [{:answer/id #uuid "62539b47-6fac-5fcf-9503-61e8367eec33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422185} {:answer/id #uuid "e4034300-7163-55c2-9f5c-bcf30334285a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422186}] :answer-field/correct {:answer/id #uuid "62539b47-6fac-5fcf-9503-61e8367eec33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422185} :answer-field/id #uuid "5c360ce3-6824-5c39-acd6-e256e24886b7" :answer-field/key "${y}^{‴}-y=x-{y}^{″}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422373} {:answer-field/choices [{:answer/id #uuid "de826aab-09ea-5a31-9751-6dc8761d2c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422187} {:answer/id #uuid "099306fc-1518-5f1a-b302-f2ae896069b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422188}] :answer-field/correct {:answer/id #uuid "de826aab-09ea-5a31-9751-6dc8761d2c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422187} :answer-field/id #uuid "036e7701-296b-5b27-9ba3-0fefcc3cbe0b" :answer-field/key "${x}^{3}{y}^{′}+x=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422374}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "412d07fd-1588-561a-99e8-080a2cb49d3e" :question/math-academy-id "q-118783" :question/problem "Which of the following are second-order ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "A differential equation is of second-order if the largest derivative term in the equation is ${y}^{″}.$\n\nKeeping this in mind, let's check each given equation.\n\n- Equation ${y}^{″}+{y}^{′}={x}^{2}-x$ is a second-order differential equation. The highest derivative in this equation is ${y}^{″}.$\n\n- Equation ${y}^{‴}-y=x-{y}^{″}$ is not a second-order differential equation. The highest derivative in this equation is ${y}^{‴},$ so this is a third-order differential equation.\n\n- Equation ${x}^{3}{y}^{′}+x=y$ is not a second-order differential equation. The highest derivative in this equation is ${y}^{′},$ so this is a first-order differential equation.\n\nTherefore, the correct answer is ${y}^{″}+{y}^{′}={x}^{2}-x$ only."} {:db/id #edb/ref 17592186253514 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d275665e-21d6-5021-9af4-963d5728df52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422207} {:answer/id #uuid "c3b7cd67-3643-54bb-814b-c0117b35907e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422208}] :answer-field/correct {:answer/id #uuid "c3b7cd67-3643-54bb-814b-c0117b35907e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422208} :answer-field/id #uuid "2fdfa9c1-4f01-5411-a857-7dd9685e500c" :answer-field/key "${y}^{′}=-9x,\\,y(1)=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422384} {:answer-field/choices [{:answer/id #uuid "9417f602-3568-5efe-94c7-501d5cff75d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422209} {:answer/id #uuid "86b7ef39-bf9a-54c6-a085-f31d633793e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422210}] :answer-field/correct {:answer/id #uuid "86b7ef39-bf9a-54c6-a085-f31d633793e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422210} :answer-field/id #uuid "ef92c25e-8c54-5dcb-95f2-841eb93872dc" :answer-field/key "${y}^{′}-8{x}^{3}=-y,\\,y(0)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422385} {:answer-field/choices [{:answer/id #uuid "89bb1fe1-b3be-5274-ac26-302e27a47abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422211} {:answer/id #uuid "7ab84d7e-d700-5891-a5c2-71baae4994b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422212}] :answer-field/correct {:answer/id #uuid "89bb1fe1-b3be-5274-ac26-302e27a47abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422211} :answer-field/id #uuid "c7a7fdd2-30a3-5167-9a37-4b4c0e0e01ad" :answer-field/key "${y}^{″}+y=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c7ca5ad-bcbb-5515-be28-446ac5363a18" :question/math-academy-id "q-118790" :question/problem "Which of the following systems is a first-order initial value problem?\n\nSelect all that apply." :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System ${y}^{′}=-9x,\\,y(1)=-4$ is a first-order initial value problem. It consists of a first-order differential equation ${y}^{′}=-9x$ together with the initial condition $y(1)=-4.$\n\n- System ${y}^{′}-8{x}^{3}=-y,\\,y(0)=-3$ is a first-order initial value problem. It consists of a first-order differential equation ${y}^{′}-8{x}^{3}=-y$ together with the initial condition $y(0)=-3.$\n\n- System ${y}^{″}+y=3$ is not a first-order initial value problem. We have here a second-order ordinary differential equation.\n\nTherefore, the correct answer is ${y}^{′}=-9x,\\,y(1)=-4$; ${y}^{′}-8{x}^{3}=-y,\\,y(0)=-3$ only."} {:db/id #edb/ref 17592186253519 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429ab1e6-1ea8-591f-8018-488e0328c633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422219} {:answer/id #uuid "8abbe2b3-d552-5095-beac-5364c9bb1f5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422220}] :answer-field/correct {:answer/id #uuid "8abbe2b3-d552-5095-beac-5364c9bb1f5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422220} :answer-field/id #uuid "932c7315-fbec-5137-99ad-8b3d6abcc576" :answer-field/key "${e}^{2y}{y}^{′}+1=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422390} {:answer-field/choices [{:answer/id #uuid "ae25728a-975e-5157-92a8-8d1a96f74031" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422221} {:answer/id #uuid "8dabfa11-04b9-5367-929d-f3c2edf37075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422222}] :answer-field/correct {:answer/id #uuid "ae25728a-975e-5157-92a8-8d1a96f74031" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422221} :answer-field/id #uuid "29377ff2-9a08-5ae1-b11b-c0869a6af61d" :answer-field/key "${y}^{′}+\\sqrt{xy}=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422391} {:answer-field/choices [{:answer/id #uuid "2d642f39-1ba7-582e-99be-e5783acf5bf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422223} {:answer/id #uuid "a488d4a0-572b-5e44-a907-0c207d0eb139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422224}] :answer-field/correct {:answer/id #uuid "a488d4a0-572b-5e44-a907-0c207d0eb139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422224} :answer-field/id #uuid "674b78a9-e972-5af8-91cd-bcf759582826" :answer-field/key "${y}^{′}=\\operatorname{ln}⁡y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422392}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4fb73e0-2435-50c4-b136-c8ed7ccb224f" :question/math-academy-id "q-118858" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation ${e}^{2y}{y}^{′}+1=0$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}{e}^{2y}{y}^{′}+1 & =0 \\\\ {y}^{′} & =-{e}^{-2y} \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=-{e}^{-2y}.$\n\n- Equation ${y}^{′}+\\sqrt{xy}=2$ is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}{y}^{′}+\\sqrt{xy} & =2 \\\\ {y}^{′} & =2-\\sqrt{xy} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=2-\\sqrt{xy}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}=\\operatorname{ln}⁡y$ is an autonomous differential equation. We see that it is of the form ${y}^{′}=f(y),$ where $f(y)=\\operatorname{ln}⁡y.$\n\nTherefore, the correct answer is ${e}^{2y}{y}^{′}+1=0$; ${y}^{′}=\\operatorname{ln}⁡y$ only."} {:db/id #edb/ref 17592186253520 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "205c2cd6-04ab-56ea-9090-bfc8e049d542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422225} {:answer/id #uuid "78ae71d2-619b-56f3-92bf-ecfeebf9c3b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422226}] :answer-field/correct {:answer/id #uuid "205c2cd6-04ab-56ea-9090-bfc8e049d542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422225} :answer-field/id #uuid "4adb79a2-2fca-5fcf-8dd7-6acc5f68f3a9" :answer-field/key "${y}^{′}-3{x}^{2}=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422393} {:answer-field/choices [{:answer/id #uuid "18e49df7-3c70-5cd8-beb4-ff959fd404aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422227} {:answer/id #uuid "38051905-c461-5911-8df5-70c9f959f1d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422228}] :answer-field/correct {:answer/id #uuid "38051905-c461-5911-8df5-70c9f959f1d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422228} :answer-field/id #uuid "cacddabc-75dd-59ce-afe3-05d7d1ba8798" :answer-field/key "${y}^{′}+6y={e}^{3y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422394} {:answer-field/choices [{:answer/id #uuid "8a5168fb-5c6b-5a1a-8194-633d3b1f1dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422229} {:answer/id #uuid "f7168c22-e701-5df5-af8a-614a1a97b22e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422230}] :answer-field/correct {:answer/id #uuid "8a5168fb-5c6b-5a1a-8194-633d3b1f1dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422229} :answer-field/id #uuid "944c44c1-dc25-512a-858d-9642a5fec880" :answer-field/key "${y}^{′}=\\operatorname{ln}⁡(2{x}^{2}+1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81da2b48-aa38-5eb5-8b7d-567a07263315" :question/math-academy-id "q-118859" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation ${y}^{′}-3{x}^{2}=1$ is not an autonomous differential equation. If we isolate the derivative term, we get\n\n$$\n\\begin{aligned}{y}^{′}-3{x}^{2} & =1 \\\\ {y}^{′} & =3{x}^{2}+1 \\\\ {y}^{′} & =f(x)\\end{aligned}\n$$\n\nwhere $f(x)=3{x}^{2}+1.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}+6y={e}^{3y}$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}{y}^{′}+6y & ={e}^{3y} \\\\ {y}^{′} & ={e}^{3y}-6y \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)={e}^{3y}-6y.$\n\n- Equation ${y}^{′}=\\operatorname{ln}⁡(2{x}^{2}+1)$ is not an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\nTherefore, the correct answer is ${y}^{′}+6y={e}^{3y}$ only." :step/_content [{:activity/_steps {:activity/title "Practice assessment" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186536242} :db/id #edb/ref 17592186536244}]} {:db/id #edb/ref 17592186253522 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2888360-9f66-5c23-981b-f079328c8636" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422237} {:answer/id #uuid "d327d689-8c39-594c-96b9-58a570c5b701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422238}] :answer-field/correct {:answer/id #uuid "d2888360-9f66-5c23-981b-f079328c8636" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422237} :answer-field/id #uuid "c873029d-589f-57a0-a4d0-8437caa76bc0" :answer-field/key "${x}^{2}{y}^{′}+6x{y}^{2}=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422399} {:answer-field/choices [{:answer/id #uuid "73b6cd63-9458-513b-b2aa-d028666ac3c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422239} {:answer/id #uuid "3cf41c95-b46b-5d57-a7e0-be741ba1e4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422240}] :answer-field/correct {:answer/id #uuid "73b6cd63-9458-513b-b2aa-d028666ac3c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422239} :answer-field/id #uuid "d843cc15-36f5-5f93-b122-c8351e2ae5d6" :answer-field/key "${y}^{′}+\\frac{1}{x}=3{y}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422400} {:answer-field/choices [{:answer/id #uuid "aa6421fe-c55f-5658-bf62-c0dde5e44e3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422241} {:answer/id #uuid "9a24fdb8-a81b-5920-a551-f1e49499aba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422242}] :answer-field/correct {:answer/id #uuid "9a24fdb8-a81b-5920-a551-f1e49499aba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422242} :answer-field/id #uuid "d809c0ac-7d83-52cd-b318-f7087cf971e1" :answer-field/key "${y}^{′}=\\operatorname{arctan}⁡({y}^{2}+2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422401}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40dc1226-9a4e-5dff-a14a-c81909c8002d" :question/math-academy-id "q-118868" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation ${x}^{2}{y}^{′}+6x{y}^{2}=8$ is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}{x}^{2}{y}^{′}+6x{y}^{2} & =8 \\\\ {y}^{′} & =\\frac{8-6x{y}^{2}}{{x}^{2}} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=\\frac{8-6x{y}^{2}}{{x}^{2}}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}+\\frac{1}{x}=3{y}^{2}$ is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}{y}^{′}+\\frac{1}{x} & =3{y}^{2} \\\\ {y}^{′} & =3{y}^{2}-\\frac{1}{x} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=3{y}^{2}-\\frac{1}{x}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}=\\operatorname{arctan}⁡({y}^{2}+2)$ is an autonomous differential equation. We see that it is of the form ${y}^{′}=f(y),$ where $f(y)=\\operatorname{arctan}⁡({y}^{2}+2).$\n\nTherefore, the correct answer is ${y}^{′}=\\operatorname{arctan}⁡({y}^{2}+2)$ only."} {:db/id #edb/ref 17592186253523 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous" :topic/_knowledge-points [{:db/id #edb/ref 17592186049592 :topic/id #uuid "02ecb448-e544-51fa-b80e-63ee84a4cef1" :topic/math-academy-id 3215 :topic/title "Introduction to Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd904cf8-8e31-5dfb-a522-bc91b00cd7d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422243} {:answer/id #uuid "9b6f67a5-b49f-5fbd-8497-f7c6a4031fd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422244 :task-item/_responses [{:db/id #edb/ref 17592186409281 :task-item/content {:db/id #edb/ref 17592186253523} :task-item/status {:db/id #edb/ref 17592186045572}}]}] :answer-field/correct {:answer/id #uuid "dd904cf8-8e31-5dfb-a522-bc91b00cd7d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422243} :answer-field/id #uuid "cd43700f-31c2-5c61-b73c-b13e37eff052" :answer-field/key "$\\frac{{y}^{′}}{y}+\\frac{1}{\\operatorname{arctan}⁡y+2\\pi }=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422402} {:answer-field/choices [{:answer/id #uuid "9d289e9c-3443-581d-a43b-b8699cb35799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422245 :task-item/_responses [{:db/id #edb/ref 17592186409281 :task-item/content {:db/id #edb/ref 17592186253523} :task-item/status {:db/id #edb/ref 17592186045572}}]} {:answer/id #uuid "27ec5b50-7d97-5078-8643-a6c4784da9bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422246}] :answer-field/correct {:answer/id #uuid "27ec5b50-7d97-5078-8643-a6c4784da9bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422246} :answer-field/id #uuid "12514015-bd25-5ca0-9c7a-27d17e773778" :answer-field/key "${y}^{′}+{y}^{2}={x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422403} {:answer-field/choices [{:answer/id #uuid "6565a714-41fd-50da-aa58-7c4bb033f40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422247 :task-item/_responses [{:db/id #edb/ref 17592186409281 :task-item/content {:db/id #edb/ref 17592186253523} :task-item/status {:db/id #edb/ref 17592186045572}}]} {:answer/id #uuid "c6441d94-73d1-5d09-a421-cb127ecdc684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422248}] :answer-field/correct {:answer/id #uuid "c6441d94-73d1-5d09-a421-cb127ecdc684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422248} :answer-field/id #uuid "3304dbae-d540-59d7-9271-398328295560" :answer-field/key "${y}^{′}=\\operatorname{sin}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1c949f8-b9ab-5207-8749-bf7052ce14f4" :question/math-academy-id "q-118869" :question/problem "Which of the following are **not** autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation $\\frac{{y}^{′}}{y}+\\frac{1}{\\operatorname{arctan}⁡y+2\\pi }=0$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}\\frac{{y}^{′}}{y}+\\frac{1}{\\operatorname{arctan}⁡y+2\\pi } & =0 \\\\ {y}^{′} & =-\\frac{y}{\\operatorname{arctan}⁡y+2\\pi } \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=-\\frac{y}{\\operatorname{arctan}⁡y+2\\pi }.$\n\n- Equation ${y}^{′}+{y}^{2}={x}^{2}$ is *not* an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}{y}^{′}+{y}^{2} & ={x}^{2} \\\\ {y}^{′} & ={x}^{2}-{y}^{2} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)={x}^{2}-{y}^{2}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}=\\operatorname{sin}⁡x$ is *not* an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\nTherefore, the correct answer is ${y}^{′}+{y}^{2}={x}^{2}$; ${y}^{′}=\\operatorname{sin}⁡x$ only." :task-item/_content [{:db/id #edb/ref 17592186409281 :task-item/content {:db/id #edb/ref 17592186253523} :task-item/elapsed-seconds 40.366 :task-item/id #uuid "dd707e34-2dc8-4215-b39