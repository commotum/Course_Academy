ef 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461993} {:answer/id #uuid "6541a222-8209-5d44-b29c-1cf08a407050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461994}] :answer-field/correct {:answer/id #uuid "6541a222-8209-5d44-b29c-1cf08a407050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461994} :answer-field/id #uuid "4072d7ee-3669-5aa0-b288-d84965c916de" :answer-field/key "$\\operatorname{sec}⁡x=-\\frac{1}{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43ac2ee7-84c7-5852-80b5-9c0dac95947e" :question/math-academy-id "q-120478" :question/problem "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equations $\\operatorname{sec}⁡x=\\frac{5}{8}$ and $\\operatorname{sec}⁡x=-\\frac{1}{3}$ have no solutions."} {:db/id #edb/ref 17592186256412 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049220 :topic/id #uuid "e46861d7-4b7a-5813-a6e8-914206606355" :topic/math-academy-id 1565 :topic/title "Elementary Trigonometric Equations Containing Secant"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c51a2b5-097a-5e90-