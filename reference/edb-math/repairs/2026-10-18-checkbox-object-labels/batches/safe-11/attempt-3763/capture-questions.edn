045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473115}] :answer-field/correct {:answer/id #uuid "3b5e99f8-6d7b-5605-8eeb-768c689a1a11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473114} :answer-field/id #uuid "2909a2f7-876c-5e10-a289-6837f83679fc" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473952} {:answer-field/choices [{:answer/id #uuid "829a1b56-ccd5-5381-aeca-6ba71098f21a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473116} {:answer/id #uuid "adcc7d05-7e81-525a-b650-a03adf317913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473117}] :answer-field/correct {:answer/id #uuid "adcc7d05-7e81-525a-b650-a03adf317913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473117} :answer-field/id #uuid "51b28bdf-55b7-5470-b1f6-bd8182431d5f" :answer-field/key "W" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9892c6c7-24de-57f2-a3e8-0b32de0c1349" :question/math-academy-id "q-40491" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n- **U.** $U={Q(\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ -3\\end{bmatrix})}$\n- **W.** $W={Q(\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}),Q(\\begin{bmatrix}6 \\\\ -1\\end{bmatrix})}$\n- **V.** $V={Q(\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}),Q(\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix})}$\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ ${Q({u}_{1}),Q({u}_{2})},\\,$ ${Q({w}_{1}),Q({w}_{2})},\\,$ and $\\,{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})}.$ \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3\\end{bmatrix}=18-18=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ -1\\end{bmatrix}=1-1=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}=2+12-5=9\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\nTherefore, the correct answer is \"$U$ and $W$ only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319 :topic/title "Orthogonal Linear Transformations"} :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406635} :db/id #edb/ref 17592186406658}]} {:db/id #edb/ref 17592186406841 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8f9232e-9658-51ed-95f2-ac2fd1e78bf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454078} {:answer/id #uuid "a2a49195-0754-59e8-a736-789d713df706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454079}] :answer-field/correct {:answer/id #uuid "a2a49195-0754-59e8-a736-789d713df706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454079} :answer-field/id #uuid "3fee3505-d7fb-511a-a74e-2a2d44598ed9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454789} {:answer-field/choices [{:answer/id #uuid "33b58ec5-18ed-565a-8a4c-7a428ef3b660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454080} {:answer/id #uuid "fa80fb0a-3883-56b5-b6eb-070e8e31d145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454081}] :answer-field/correct {:answer/id #uuid "33b58ec5-18ed-565a-8a4c-7a428ef3b660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454080} :answer-field/id #uuid "0d6a4961-38f7-5264-b58e-a39849428f01" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454790} {:answer-field/choices [{:answer/id #uuid "642014a7-57ea-5677-bbda-439505c688fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454082} {:answer/id #uuid "fbeac619-768a-5b27-a0a3-6f578395c470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454083}] :answer-field/correct {:answer/id #uuid "642014a7-57ea-5677-bbda-439505c688fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454082} :answer-field/id #uuid "d0f9063c-3f2e-5e1f-893e-6358b44768be" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454791}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "838322c6-867e-5a73-a18d-bbf81bd1218b" :question/math-academy-id "q-84081" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$\n- **II.** If $Tx=[1,0,0]^{T}$ has more than one solution, then $\\text{nullity}(T)=0$\n- **III.** If $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}$, then $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $y=z=0,$ any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ 0 \\\\ 0\\end{bmatrix}=x\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{nullity}(T)=1.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement II is false. Since $Tx=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$ has more than one solution, there are ${u}_{1},{u}_{2}\\in {R}^{3}$ such that  ${u}_{1}\\ne {u}_{2}$ and \n\n$$\nT({u}_{1})=T({u}_{2})=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$\n\nThis means, $T$ is not a bijection and according to the invertible matrix theorem, $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Notice that $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}.$ Therefore, $\\text{nullity}(T)=1.$ So, $T$ is not a bijection or, which is the same, $T$ is not invertible.\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"} :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406809} :db/id #edb/ref 17592186406844}]} {:db/id #edb/ref 17592186406843 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec4bc02-0df9-5348-9ee4-473b64cacd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472718} {:answer/id #uuid "0b06b982-fb9d-5cf4-b752-4ccd290073ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472719}] :answer-field/correct {:answer/id #uuid "0b06b982-fb9d-5cf4-b752-4ccd290073ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472719} :answer-field/id #uuid "edc239d3-5a4c-5fa5-98b1-768823c16b23" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473754} {:answer-field/choices [{:answer/id #uuid "72dd48fb-940a-538d-8ccc-7a6e5aa609a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472720} {:answer/id #uuid "fcd1213a-a7a4-5890-88d8-8de888db8343" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472721}] :answer-field/correct {:answer/id #uuid "72dd48fb-940a-538d-8ccc-7a6e5aa609a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472720} :answer-field/id #uuid "0ff1d1ba-36f4-5b99-8a47-88e5119e65f7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473755} {:answer-field/choices [{:answer/id #uuid "05116011-77ca-56fd-9a97-eba1d5a68cd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472722} {:answer/id #uuid "01638de6-6ede-5e18-812c-b75ad72b29e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472723}] :answer-field/correct {:answer/id #uuid "05116011-77ca-56fd-9a97-eba1d5a68cd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472722} :answer-field/id #uuid "dec578f4-3243-5145-b140-1c5ad943604d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b72abcb6-85da-5c4d-a8eb-72ce20ae6b72" :question/math-academy-id "q-140100" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$, then $\\underline{\\phantom{xxxxxx}}.$ * \n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{rank}(T)=4$\n- **II.** $\\text{nullity}(T)=4$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ and the set ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=4.$\n\n- Statement II is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-4 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852 :topic/title "The Rank-Nullity Theorem in Terms of Linear Transformations"} :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406809} :db/id #edb/ref 17592186406846}]} {:db/id #edb/ref 17592186406880 :knowledge-point/_questions [{:db/id #edb/ref 17592186124490 :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0fb2451-4145-52a4-a863-c1c6b500c031" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454178} {:answer/id #uuid "52bf72c1-2d03-54f1-83ce-0080cfe75fc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454179}] :answer-field/correct {:answer/id #uuid "f0fb2451-4145-52a4-a863-c1c6b500c031" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454178} :answer-field/id #uuid "03f577e9-d7b5-59b1-9054-aeaecadbcd8d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454839} {:answer-field/choices [{:answer/id #uuid "6291cb58-5945-57e8-971a-03bf17a20742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454180} {:answer/id #uuid "e330a199-18c6-573a-b614-26a3494d9178" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454181}] :answer-field/correct {:answer/id #uuid "6291cb58-5945-57e8-971a-03bf17a20742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454180} :answer-field/id #uuid "e630bf03-420c-549c-8c6a-4ca716a3ea03" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454840} {:answer-field/choices [{:answer/id #uuid "b7df072b-200d-5d6c-a18b-7f91a1928602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454182} {:answer/id #uuid "2454f33d-1680-5c05-9fc3-08394323c4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454183}] :answer-field/correct {:answer/id #uuid "2454f33d-1680-5c05-9fc3-08394323c4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454183} :answer-field/id #uuid "b8f08f4c-963a-5572-927c-4df8af138eba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454841}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1d66ed66-f11f-53c8-af0e-1883d2bbdd40" :question/math-academy-id "q-94942" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of a vector space $V.$ \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${{b}_{1},{b}_{2},{b}_{3},w}$ is linearly independent\n- **II.** ${{b}_{1},{b}_{2}}$ is linearly dependent\n- **III.** ${{b}_{1},3{b}_{2},2{b}_{3}}$ is a basis of $V$" :question/worked-solution "Since $B$ is a basis, the following properties must hold:\n\n- $B$ is a maximally linearly independent set of vectors in $V,$ and\n\n- $B$ spans $V.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $B$ is a basis of $V,$ it is a maximally linearly independent set of vectors. This means that if we add any new vector to the set, it becomes linearly dependent.\n\n- Statement II is false. Since if ${{b}_{1},{b}_{2}}$ is linearly dependent then there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}=0,\n$$\n\nwhere at least one of $x$'s is not zero. But then \n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+0{b}_{3}=0,\n$$\n\nwhich would mean that $B$ is linearly dependent. This would contradict the fact that $B$ is a basis.\n\n- Statement III is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}(3{b}_{2})+{x}_{3}(2{b}_{3}) & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+(3{x}_{2}){b}_{2}+(2{x}_{3}){b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since ${{b}_{1},{b}_{2},{b}_{3}}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ 3{x}_{2} &=0 \\\\ 2{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nAlso, ${{b}_{1},3{b}_{2},2{b}_{3}}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of ${{b}_{1},3{b}_{2},2{b}_{3}}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}={x}_{1}{b}_{1}+\\frac{{x}_{2}}{3}(3{b}_{2})+\\frac{{x}_{3}}{2}(2{b}_{3})\n$$\n\nTherefore, the correct answer is \"III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"} :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406849} :db/id #edb/ref 17592186406885}]} {:db/id #edb/ref 17592186406881 :knowledge-point/_questions [{:db/id #edb/ref 17592186124489 :knowledge-point/id #uuid "073042ee-d96d-5872-9681-ddcea43a2d37" :knowledge-point/title "Identifying True Statements About Sets of Vectors in a Matrix Vector Space" :topic/_knowledge-points [{:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaaf8ce1-2c2b-5bcc-925e-0f599acad60d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454172} {:answer/id #uuid "c647dd27-09cc-5bd3-810e-1d4746a2941e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454173}] :answer-field/correct {:answer/id #uuid "c647dd27-09cc-5bd3-810e-1d4746a2941e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454173} :answer-field/id #uuid "619d8289-a96c-58c5-9ea1-3220d6f4efec" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454836} {:answer-field/choices [{:answer/id #uuid "6aa5580c-81c0-5f4c-a754-31a21c559398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454174} {:answer/id #uuid "0bb76b41-f895-5d96-b445-577e31e07b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454175}] :answer-field/correct {:answer/id #uuid "0bb76b41-f895-5d96-b445-577e31e07b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454175} :answer-field/id #uuid "aa0354d6-0d92-52da-b49b-f1f1344babb1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454837} {:answer-field/choices [{:answer/id #uuid "de933d44-9208-5817-bc6e-9512bd25a83a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454176} {:answer/id #uuid "5c945b34-ae4d-5fc2-b49a-c1b5910f20d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454177}] :answer-field/correct {:answer/id #uuid "de933d44-9208-5817-bc6e-9512bd25a83a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454176} :answer-field/id #uuid "dd8df321-1ba8-5043-8b63-8be3125b1692" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "455cce4b-aebd-5209-87a1-ec6ed81f2e6b" :question/math-academy-id "q-94867" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}\\}$ is a linearly independent set in ${\\text{M}}_{2}(R)$\n\n- **II.** $\\begin{bmatrix}2 & 3 \\\\ 0 & -4\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}\\}$\n\n- **III.** $\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}\\}$ is a basis of ${\\text{M}}_{2}(R)$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation\n\n$$\n{x}_{1}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}+{x}_{2}\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}+{x}_{3}\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nis true if and only if ${x}_{1}={x}_{2}={x}_{3}=0.$ So, the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 0 & -4\\end{bmatrix}=2\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}+(-4)\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}+3\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\n- Statement III is false. For example, the matrix $\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}$ can't be written as a linear combination of \n\n$$\n\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}\\}\n$$\n\nsince all these linear combinations result in matrices with the entry ${a}_{21}=0:$\n\n$$\na\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}+b\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}+c\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}=\\begin{bmatrix}a & c \\\\ 0 & b\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"} :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406849} :db/id #edb/ref 17592186406886}]} {:db/id #edb/ref 17592186406883 :knowledge-point/_questions [{:db/id #edb/ref 17592186124490 :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bbdee2f-94bd-572f-91ae-a989e989cefc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454060} {:answer/id #uuid "ad6016de-8322-5611-abac-11c53498b5f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454061}] :answer-field/correct {:answer/id #uuid "8bbdee2f-94bd-572f-91ae-a989e989cefc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454060} :answer-field/id #uuid "4b86c8c7-ce4a-5843-b124-fd92dc984de2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454780} {:answer-field/choices [{:answer/id #uuid "e5061063-49ba-56ef-8537-f424f6dc8a16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454062} {:answer/id #uuid "710153ca-da8e-5423-9cbc-1f6713a46398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454063}] :answer-field/correct {:answer/id #uuid "710153ca-da8e-5423-9cbc-1f6713a46398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454063} :answer-field/id #uuid "a7647c92-3c6a-55d5-b2a1-537c5b726446" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454781} {:answer-field/choices [{:answer/id #uuid "0743a148-5538-58b8-be74-ca107d1c906d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454064} {:answer/id #uuid "f3c81ac2-78b7-59ca-8a48-01ff07cdd26a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454065}] :answer-field/correct {:answer/id #uuid "0743a148-5538-58b8-be74-ca107d1c906d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454064} :answer-field/id #uuid "ccfdb226-5087-511e-8a84-93a1b34f530a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454782}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3557614-de80-516a-bb07-7b50ae99a56a" :question/math-academy-id "q-80631" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ and $C={{c}_{1},{c}_{2}}$ are bases of ${R}^{3}$ and ${R}^{2}$, respectively. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${x,{b}_{2},{c}_{1}}$ is a basis of ${R}^{3}$\n- **II.** ${-2{b}_{3},3{b}_{1},5{b}_{2}}$ is a basis of ${R}^{3}$\n- **III.** ${{c}_{1},{c}_{2},x}$ is a basis of ${R}^{2}$" :question/worked-solution "Since $B$ and $C$ are bases, the following properties must hold:\n\n- $B$ and $C$ are maximally linearly independent sets in ${R}^{2}$ and ${R}^{3},$ respectively, and\n\n- $B$ spans ${R}^{2},$ while $C$ spans ${R}^{3}.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. The set ${x,{b}_{2},{c}_{1}}$ is not a basis of ${R}^{3}$ because the set contains vectors from another vector space.\n\n- Statement II is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}(-2{b}_{3})+{x}_{2}(3{b}_{1})+{x}_{3}(5{b}_{2}) & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}(-2{x}_{1}){b}_{3}+(3{x}_{2}){b}_{1}+(5{x}_{3}){b}_{2} & =0,\\end{aligned}\n$$\n\nwhich, since ${{b}_{1},{b}_{2},{b}_{3}}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}-2{x}_{1} &=0 \\\\ 3{x}_{2} &=0 \\\\ 5{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nAlso, ${-2{b}_{3},3{b}_{1},5{b}_{2}}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of ${-2{b}_{3},3{b}_{1},5{b}_{2}}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}=\\frac{{x}_{1}}{3}(3{b}_{1})+\\frac{{x}_{2}}{5}(5{b}_{2})+(-\\frac{{x}_{3}}{2})(-2{b}_{3})\n$$\n\n- Statement III is false. Since $C={{c}_{1},{c}_{2}}$ is a basis of ${R}^{2}$, any vector of ${R}^{2},$ including the given vector $x,$ can be written as a linear combination of ${c}_{1}$ and ${c}_{2}.$ This means that ${{c}_{1},{c}_{2},x}$ is linearly dependent and therefore, cannot be a basis.\n\nTherefore, the correct answer is \"II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"} :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406849} :db/id #edb/ref 17592186406884} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048552 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909 :topic/title "Bases in Abstract Vector Spaces"} :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485759} :db/id #edb/ref 17592186486522}]} {:db/id #edb/ref 17592186406949 :knowledge-point/_questions [{:db/id #edb/ref 17592186059701 :knowledge-point/id #uuid "64a3922f-7e74-562f-9bb9-c4a41e912ce7" :knowledge-point/title "Identifying True Conditional Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050360 :topic/id #uuid "4264930a-5f20-54f0-ad2a-c3ad45c03658" :topic/math-academy-id 250 :topic/title "Conditional Statements"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a11b4773-38d5-5c0c-9e9c-3e0b4ecae818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453132} {:answer/id #uuid "9ab874b5-03d7-53c3-b6db-a652d9c156a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453133}] :answer-field/correct {:answer/id #uuid "a11b4773-38d5-5c0c-9e9c-3e0b4ecae818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453132} :answer-field/id #uuid "26f8e36a-498b-5385-816f-6d262d6c4893" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454316} {:answer-field/choices [{:answer/id #uuid "96553132-07aa-5dd8-a9d9-80d5ba1e0f0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453134} {:answer/id #uuid "f12b50d9-97e8-547c-ae5c-e9776f0678cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453135}] :answer-field/correct {:answer/id #uuid "f12b50d9-97e8-547c-ae5c-e9776f0678cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453135} :answer-field/id #uuid "cae81137-1867-50f5-a1a9-e15ecfd57220" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454317} {:answer-field/choices [{:answer/id #uuid "923f9c82-2491-5942-a700-0059eb11d931" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453136} {:answer/id #uuid "bca078d7-e26d-5c8c-ac29-1d2b30f25905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453137}] :answer-field/correct {:answer/id #uuid "bca078d7-e26d-5c8c-ac29-1d2b30f25905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453137} :answer-field/id #uuid "e8ffb718-a2da-578a-a502-45fd1b77e827" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454318}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55e540af-11e2-5ec3-9b47-ab0da3ac740e" :question/math-academy-id "q-103558" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** **If** $12$ is divisible by $3$, **then** $9$ is divisible by $4.$\n- **II.** **If** $5$ is divisible by $2$, **then** $10$ is divisible by $5.$\n- **III.** **If** $9$ is divisible by $5$, **then** $6$ is divisible by $3.$" :question/worked-solution "An implication $A⇒B$ is true *unless* $A$ is true and $B$ is false. In other words, the implication is true unless the \"promise\" is broken.\n\n- Statement I is false. The antecedent \"$12$ is divisible by $3$\" is true, and the consequent \"$9$ is divisible by $4$\" is false. So the promise is broken, and the statement is false.\n\n- Statement II is true. The antecedent \"$5$ is divisible by $2$\" is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\n- Statement III is true. Again, the antecedent \"$9$ is divisible by $5$\" is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\nTherefore, the correct answer is \"II and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050360 :topic/id #uuid "4264930a-5f20-54f0-ad2a-c3ad45c03658" :topic/math-academy-id 250 :topic/title "Conditional Statements"} :activity/title "Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406924} :db/id #edb/ref 17592186406952}]} {:db/id #edb/ref 17592186406950 :knowledge-point/_questions [{:db/id #edb/ref 17592186059701 :knowledge-point/id #uuid "64a3922f-7e74-562f-9bb9-c4a41e912ce7" :knowledge-point/title "Identifying True Conditional Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050360 :topic/id #uuid "4264930a-5f20-54f0-ad2a-c3ad45c03658" :topic/math-academy-id 250 :topic/title "Conditional Statements"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20959140-93b8-5a47-a197-da32ff4810aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454066} {:answer/id #uuid "9379cea3-738f-5b45-9ffb-a0d389c84fcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454067}] :answer-field/correct {:answer/id #uuid "9379cea3-738f-5b45-9ffb-a0d389c84fcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454067} :answer-field/id #uuid "ecc3054a-806e-55e3-a67b-9d3aafb6ab0e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454783} {:answer-field/choices [{:answer/id #uuid "862f1c15-7d4f-5155-be39-3424fe47a6a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454068} {:answer/id #uuid "e30f18bc-42c2-57a7-8e53-faed108c78b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454069}] :answer-field/correct {:answer/id #uuid "862f1c15-7d4f-5155-be39-3424fe47a6a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454068} :answer-field/id #uuid "6338d248-c558-59d6-b0d2-c36e277fc0ef" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454784} {:answer-field/choices [{:answer/id #uuid "3ff828bb-30f0-59e3-937e-d221fd6fafb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454070} {:answer/id #uuid "5d13fad8-f3e6-549c-954e-a199b234815c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454071}] :answer-field/correct {:answer/id #uuid "5d13fad8-f3e6-549c-954e-a199b234815c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454071} :answer-field/id #uuid "693882b2-096a-516e-95d6-0393826e4576" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "806aafe6-aa9d-53f3-a7d9-19809d388a29" :question/math-academy-id "q-82092" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** **If** $7$ is an even number, **then** $6$ is an odd number.\n- **II.** **If** $6$ is an even number, **then** $7$ is an even number.\n- **III.** **If** $6$ is an even number, **then** $7$ is an odd number." :question/worked-solution "An implication $A⇒B$ is true *unless* $A$ is true and $B$ is false. In other words, the implication is true unless the \"promise\" is broken.\n\n- Statement I is true. The antecedent \"$7$ is an even number\" is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\n- Statement II is false. The antecedent \"$6$ is an even number\" is true, and the consequent \"$7$ is an even number\" is false. So the promise is broken, and the statement is false.\n\n- Statement III is true. The antecedent \"$6$ is an even number\" is true, and the consequent \"$7$ is an odd number\" is true. So the promise is kept, and the statement is true.\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050360 :topic/id #uuid "4264930a-5f20-54f0-ad2a-c3ad45c03658" :topic/math-academy-id 250 :topic/title "Conditional Statements"} :activity/title "Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406924} :db/id #edb/ref 17592186406953}]} {:db/id #edb/ref 17592186406982 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither" :topic/_knowledge-points [{:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b532929-031f-53ba-845b-1b69f35ae5ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473278} {:answer/id #uuid "da5ae196-6ddc-5f90-8faf-ce02251fa644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473279}] :answer-field/correct {:answer/id #uuid "da5ae196-6ddc-5f90-8faf-ce02251fa644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473279} :answer-field/id #uuid "8261d6df-4d7c-5438-ab24-46a9a778e5ea" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474034} {:answer-field/choices [{:answer/id #uuid "ff2626a4-af3b-558c-898b-e325dcd7c8a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473280} {:answer/id #uuid "74014f19-619f-54ff-9fc7-8f16f269680a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473281}] :answer-field/correct {:answer/id #uuid "74014f19-619f-54ff-9fc7-8f16f269680a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473281} :answer-field/id #uuid "1f34c2c1-88e7-5e59-bf72-b638136d3b12" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474035} {:answer-field/choices [{:answer/id #uuid "8d131820-9e7d-5679-bbf5-8ff122bec3c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473282} {:answer/id #uuid "38a132f3-eea1-5c88-b25c-151a9517cd9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473283}] :answer-field/correct {:answer/id #uuid "8d131820-9e7d-5679-bbf5-8ff122bec3c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473282} :answer-field/id #uuid "9f148b1b-a08c-5f92-88d7-fab284af6a47" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474036}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d779a1b-dcae-59f0-822c-7860f9483ab7" :question/math-academy-id "q-72160" :question/problem "Which of the following statements are true regarding the finite region bounded between the curves $y={x}^{3}$ and $y=\\sqrt[3]{x},$ in the first quadrant?\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}y={x}^{3}\\, & ⟹\\,x=\\sqrt[3]{y} \\\\ y=\\sqrt[3]{x}\\, & ⟹\\,x={y}^{3}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/89/899357795c6d5b81d3cb619d71493ad787645697fe1f2fcecda78c1b875f388e.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le \\sqrt[3]{x}}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{3}\\le x\\le \\sqrt[3]{y}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"} :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406975} :db/id #edb/ref 17592186406987} {:activity/_steps {:activity/title "Quiz 8" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186527305} :db/id #edb/ref 17592186528031}]} {:db/id #edb/ref 17592186407133 :knowledge-point/_questions [{:db/id #edb/ref 17592186152089 :knowledge-point/id #uuid "6927f03c-aa7a-56ac-8cd0-c036a11aadc9" :knowledge-point/title "Finding the Truth Value of a Statement Involving Nested Quantifiers" :topic/_knowledge-points [{:db/id #edb/ref 17592186050691 :topic/id #uuid "5f607ed3-b581-5e92-9101-c32dd179ab13" :topic/math-academy-id 2792 :topic/title "Nested Quantifiers"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49953372-6786-55fd-b957-4551684db7d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453670} {:answer/id #uuid "eb694d2a-846a-5113-a363-79bb2236c246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453671}] :answer-field/correct {:answer/id #uuid "eb694d2a-846a-5113-a363-79bb2236c246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453671} :answer-field/id #uuid "75840e40-2cca-58f4-a515-e9cfdb46f959" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454585} {:answer-field/choices [{:answer/id #uuid "57c979c3-fafa-584e-abe1-50aaafd5442e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453672} {:answer/id #uuid "374d893b-950f-54cb-a1f5-2cd335ae552b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453673}] :answer-field/correct {:answer/id #uuid "57c979c3-fafa-584e-abe1-50aaafd5442e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453672} :answer-field/id #uuid "726bad40-3e61-5e83-b318-93789e8c9f1e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454586} {:answer-field/choices [{:answer/id #uuid "8d9be598-49fa-52b8-a352-44784bf90317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453674} {:answer/id #uuid "e6cb932f-f971-54a3-ad09-1463e1bb7456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453675}] :answer-field/correct {:answer/id #uuid "e6cb932f-f971-54a3-ad09-1463e1bb7456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453675} :answer-field/id #uuid "9963ef57-4cea-572c-8d46-02df8158a551" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454587}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a806540-0634-5e11-9ba2-ff988650a653" :question/math-academy-id "q-183877" :question/problem "Let $p\\in Q$ and $q\\in Q.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $∃\\,p\\in Q,\\,2p=-1.$\n- **II.** The truth set of the predicate $(\\,∃\\,p\\in Q,\\,p\\cdot q=-1\\,)$ is $Q.$\n- **III.** $∃\\,q,p\\in Q,\\,p\\cdot q=-1.$" :question/worked-solution "First, notice that the statement \n\n$$\n∃\\,q,p\\in Q,\\,p\\cdot q=-1\n$$\n\nfrom option III reads as follows:\n\n$\\,$ There exist rationals $q$ and $p,$ such that $p\\cdot q=-1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true, $2p=-1$ for some rational number $p$ (e.g., for $p=-\\frac{1}{2}$).\n\n- Statement II is false. For the predicate\n\n$$\nP(q):\\,∃\\,p\\in Q,\\,p\\cdot q=-1\n$$\n\nwe note that $P(q)$ is true for some $q\\in Q$ and false for others. For example, \n\n$$\nP(0):\\,∃\\,p\\in Q,\\,p\\cdot 0=-1\n$$\n\nis false. However, \n\n$$\nP(1):\\,∃\\,p\\in Q,\\,p\\cdot 1=-1\n$$\n\nis true, since we can take $p=-1.$\n\n- Statement III is true. The sentence \n\n$$\n(\\,∃\\,q,p\\in Q,\\,p\\cdot q=-1\\,)\n$$\n\n \ncan be written as\n\n$$\n∃q\\in Q\\,(\\,\\underbrace{∃p\\in Q,\\,p\\cdot q=-1}_{P(q)}\\,)\n$$\n\nwhich is true whenever the inner predicate $P(q)$ has a nonempty truth set. And according to the discussion in statement II, this is the case.\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050691 :topic/id #uuid "5f607ed3-b581-5e92-9101-c32dd179ab13" :topic/math-academy-id 2792 :topic/title "Nested Quantifiers"} :activity/title "Nested Quantifiers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407113} :db/id #edb/ref 17592186407137}]} {:db/id #edb/ref 17592186407246 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049881 :topic/id #uuid "1aba1eae-fe85-559f-b4fb-b8896b64623f" :topic/math-academy-id 2200 :topic/title "The Four Fundamental Subspaces of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e37cdb6-c2f8-5f2d-b68e-1ab7dae2c068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472502} {:answer/id #uuid "ac8ee36b-6930-5033-bbff-c6e5831b6de6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472503}] :answer-field/correct {:answer/id #uuid "6e37cdb6-c2f8-5f2d-b68e-1ab7dae2c068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472502} :answer-field/id #uuid "48015e6d-6aef-53c6-aa13-f63167aef2d9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473646} {:answer-field/choices [{:answer/id #uuid "c132e320-a78b-5003-a32b-1274e70dff6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472504} {:answer/id #uuid "2c9107f0-649f-5e5e-8c94-d1089de849cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472505}] :answer-field/correct {:answer/id #uuid "2c9107f0-649f-5e5e-8c94-d1089de849cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472505} :answer-field/id #uuid "ff283957-040e-592b-8540-faef6177d2d1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473647} {:answer-field/choices [{:answer/id #uuid "49c7e552-c7ec-5bd5-9721-98ed03dbe1c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472506} {:answer/id #uuid "bce36cf7-e320-5e6d-97a5-94061b6e55fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472507}] :answer-field/correct {:answer/id #uuid "49c7e552-c7ec-5bd5-9721-98ed03dbe1c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472506} :answer-field/id #uuid "0d2b47b3-71ab-5d28-ac5e-96cdddfab7f6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9f78c95-881f-537a-b5e6-305264553498" :question/math-academy-id "q-109777" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}(A)$ for every matrix $A?$\n- **I.** $\\text{Col}({A}^{T})$\n- **II.** $\\text{Null}({A}^{T})$\n- **III.** $\\text{Null}(A)$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Col}(A)$ consists of all linear combinations of the columns of $A$, that is, the rows of ${A}^{T}.$\n\nIf a vector is orthogonal to every linear combination of the rows of ${A}^{T},$ it must be orthogonal to each row of ${A}^{T}.$\nBut notice that when pre-multiplying a vector by ${A}^{T},$ we actually multiply each row of ${A}^{T}$ by that vector.\nSo, $\\text{Col}(A)$ must be orthogonal to the left null space of $A,$ which is $\\text{Null}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049881 :topic/id #uuid "1aba1eae-fe85-559f-b4fb-b8896b64623f" :topic/math-academy-id 2200 :topic/title "The Four Fundamental Subspaces of a Matrix"} :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407212} :db/id #edb/ref 17592186407248}]} {:db/id #edb/ref 17592186407272 :knowledge-point/_questions [{:db/id #edb/ref 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction" :topic/_knowledge-points [{:db/id #edb/ref 17592186050128 :topic/id #uuid "2edfad38-c4ef-5df9-8b35-5ea30d354656" :topic/math-academy-id 2823 :topic/title "The Absorption Laws"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "679af59b-9a9b-5445-a2ed-971d3b27b789" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473428} {:answer/id #uuid "de09f7f6-1950-5bcd-bd5c-77f9db8d881f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473429}] :answer-field/correct {:answer/id #uuid "679af59b-9a9b-5445-a2ed-971d3b27b789" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473428} :answer-field/id #uuid "4227a58e-2c13-5157-9e01-c278430e3976" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474109} {:answer-field/choices [{:answer/id #uuid "3bd41ee6-ad6b-5890-a457-f6ca7b6dce4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473430} {:answer/id #uuid "02c1ee5c-a4fa-5962-a619-7f070b4cd2f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473431}] :answer-field/correct {:answer/id #uuid "02c1ee5c-a4fa-5962-a619-7f070b4cd2f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473431} :answer-field/id #uuid "afee90de-95e4-5385-bed8-47f54fc880ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474110} {:answer-field/choices [{:answer/id #uuid "6890afd6-d111-51ac-ae72-3d7d329c5b51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473432} {:answer/id #uuid "8a46eb9d-07c1-5ef1-b9f1-b6989168e206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473433}] :answer-field/correct {:answer/id #uuid "8a46eb9d-07c1-5ef1-b9f1-b6989168e206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473433} :answer-field/id #uuid "9cced8f6-da3e-5b5c-9853-44c78ca4e503" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474111}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "669b0027-14f5-5068-b932-b9686df06625" :question/math-academy-id "q-81717" :question/problem "Which of the following are logically equivalent to $R?$\n- **I.** $(T∨R)∧T$\n- **II.** $R∧(T∨R)$\n- **III.** $(R∨T)∧R$\n\nSelect all that apply." :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nR∧(R∨T)≡R.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}(T∨R)∧T & ≡T∧(T∨R) \\\\  & ≡T≢R.\\,\\times \\end{aligned}\n$$\n\n- Statement II is logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}R∧(T∨R) & ≡R∧(R∨T) \\\\  & ≡R.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}(R∨T)∧R & ≡R∧(R∨T) \\\\  & ≡R.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050128 :topic/id #uuid "2edfad38-c4ef-5df9-8b35-5ea30d354656" :topic/math-academy-id 2823 :topic/title "The Absorption Laws"} :activity/title "The Absorption Laws" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407253} :db/id #edb/ref 17592186407274}]} {:db/id #edb/ref 17592186407295 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d87facea-76c9-53bf-b25e-e7acd8a0848f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472616} {:answer/id #uuid "34788671-40c0-55de-9282-705047e61c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472617}] :answer-field/correct {:answer/id #uuid "34788671-40c0-55de-9282-705047e61c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472617} :answer-field/id #uuid "13cca8d7-a733-550e-ab33-1ebcc8cc6ba3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473703} {:answer-field/choices [{:answer/id #uuid "2cb2a430-1b20-5cd8-889c-8397d5f66f4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472618} {:answer/id #uuid "facde33f-6a68-5c26-a7d0-f157550ab480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472619}] :answer-field/correct {:answer/id #uuid "facde33f-6a68-5c26-a7d0-f157550ab480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472619} :answer-field/id #uuid "a6b1f945-9ba0-5e99-9ab4-a0c22108dd3f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473704} {:answer-field/choices [{:answer/id #uuid "1f4df998-df9d-5be1-85e2-6c7fe20e4d11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472620} {:answer/id #uuid "94aa333b-da6a-5843-999a-18b8e9d9555f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472621}] :answer-field/correct {:answer/id #uuid "1f4df998-df9d-5be1-85e2-6c7fe20e4d11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472620} :answer-field/id #uuid "1b668eb0-a01c-5c4c-9775-6cc00549cbbd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473705}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04b43074-9710-54c1-a656-7d7797008d68" :question/math-academy-id "q-129786" :question/problem "![](images/9d/9d66cb97b9e04367ce2250e5156eaa9daaf42fadb395220e0464bca687e91908.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)={\\begin{aligned}\\frac{y}{1+{x}^{2}}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\n- ${∬}_{D}\\frac{y}{1+{x}^{2}}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$\n- ${∬}_{D}\\frac{y}{1+{x}^{2}}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-3,4]$\n- ${∬}_{R}\\frac{y}{1+{x}^{2}}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-4,4]\\times [-2,2]$\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}\\frac{y}{1+{x}^{2}}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}\\frac{y}{1+{x}^{2}}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\nTherefore, the correct answer is \"I and II only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407276} :db/id #edb/ref 17592186407299}]} {:db/id #edb/ref 17592186407296 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain" :topic/_knowledge-points [{:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034d7503-b6f8-527c-a973-ac2bfc867df1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472622} {:answer/id #uuid "77d96fda-e870-55c8-b23f-4d1d5eb0e5f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472623}] :answer-field/correct {:answer/id #uuid "77d96fda-e870-55c8-b23f-4d1d5eb0e5f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472623} :answer-field/id #uuid "256d9380-5a22-5d58-bc62-7da50bb3ece8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473706} {:answer-field/choices [{:answer/id #uuid "83f3b95a-f8ca-5464-96e2-8800e62a2417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472624} {:answer/id #uuid "50306918-6a2a-5e3c-a5ab-150d520b00cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472625}] :answer-field/correct {:answer/id #uuid "83f3b95a-f8ca-5464-96e2-8800e62a2417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472624} :answer-field/id #uuid "16d53d61-4f6d-56eb-96a8-a48708fcd15a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473707} {:answer-field/choices [{:answer/id #uuid "642ff713-a98e-574b-ab8d-f4ec58c4a354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472626} {:answer/id #uuid "f07b0134-b33f-5f41-9115-502b58e12756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472627}] :answer-field/correct {:answer/id #uuid "f07b0134-b33f-5f41-9115-502b58e12756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472627} :answer-field/id #uuid "7f28af97-dc10-5715-ba3e-f26a28eab3f5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473708}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bbe5a871-1924-5655-ad62-5cf32208bd34" :question/math-academy-id "q-129908" :question/problem "Let $D$ be a finite region enclosed by the curves $y=\\frac{1}{2}{x}^{2}-1$ and $y=2-|x|.$ If $R=[-2,2]\\times [-1,2],$ and\n\n$$\n{∬}_{D}x\\operatorname{sin}⁡(x+y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n- **I.** ${\\begin{aligned}x\\operatorname{sin}⁡(x+y), & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n- **II.** ${\\begin{aligned}x\\operatorname{sin}⁡(x+y), & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n- **III.** ${\\begin{aligned}x\\operatorname{sin}⁡(x+y), & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/1a/1a5369b58b14444c5ea0ce4bb36954d1d0b7964dcef4e95f9cc527694b3a9e4f.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $x\\operatorname{sin}⁡(x+y)$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}x\\operatorname{sin}⁡(x+y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and III equal $x\\operatorname{sin}⁡(x+y)$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function II. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,2)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616 :topic/title "Double Integrals Over Non-Rectangular Domains"} :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407276} :db/id #edb/ref 17592186407302}]} {:db/id #edb/ref 17592186407498 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions" :topic/_knowledge-points [{:db/id #edb/ref 17592186048604 :topic/id 