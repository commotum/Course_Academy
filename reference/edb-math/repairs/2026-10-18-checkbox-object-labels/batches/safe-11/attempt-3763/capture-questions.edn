7592186473403}] :answer-field/correct {:answer/id #uuid "c5dfbfc4-31ca-58ef-a279-bf4edc4619d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473403} :answer-field/id #uuid "4bea3d27-a56b-539b-b049-f7f9f0e7812c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474096}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "476816fb-a049-55c8-86b3-04683cf8a95e" :question/math-academy-id "q-78604" :question/problem "Which of the following residue classes modulo $6$ contain the integer $7?$\n\nI. $[-5]_{6}$\n\nII. $[3]_{6}$\n\nIII. $[1]_{6}$\n\nSelect all that apply." :question/worked-solution "We have $7\\in [a]_{6}$ if \n\n$$\n7≡a\\,(\\text{mod}\\,6).\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $7\\in [-5]_{6}$ because $7≡-5\\,(\\text{mod}\\,6)$ $\\,✓$\n\n- $7\\notin [3]_{6}$ because $7≢3\\,(\\text{mod}\\,6)$ $\\,\\times $\n\n- $7\\in [1]_{6}$ because $7≡1\\,(\\text{mod}\\,6)$ $\\,✓$\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186412966 :knowledge-point/_questions [{:db/id #edb/ref 17592186152098 :knowledge-point/id #uuid "9c1fe7ea-d91e-5440-b756-37a460a18f19" :knowledge-point/title "Identifying Residue Classes Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6e7c1fd-c51f-58f5-ab67-eb7ce0f07759" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473500} {:answer/id #uuid "efec4b84-7421-5a5d-8924-41a32849ead2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/