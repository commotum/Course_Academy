e/checkbox} :db/id #edb/ref 17592186473725} {:answer-field/choices [{:answer/id #uuid "7057d88b-1459-5572-8b90-225fe7507d1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472662} {:answer/id #uuid "09ed49a2-61b4-5571-b71d-a8135e86fa2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472663}] :answer-field/correct {:answer/id #uuid "09ed49a2-61b4-5571-b71d-a8135e86fa2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472663} :answer-field/id #uuid "8936a0e3-4ffe-5d36-8c85-7c84649c2227" :answer-field/key "S" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d49dd3c-2d26-5daf-baa6-13e98e158d10" :question/math-academy-id "q-130772" :question/problem "Which of the following are elementary matrices?\n\n$$\nP=\\begin{bmatrix}1 & 1 \\\\ -3 & 1\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 1 \\\\ 1 & 2\\end{bmatrix},\\,S=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrices $P$ and $Q$ are not elementary matrices because they can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $S$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:={R}_{1}+(-1){R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =S\\end{aligned}\n$$\n\nTherefore, only $S$ is an elementary matrix."} {:db/id #edb/ref 17592186400506 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050576 :topic/id #uuid "54fffdff-21ee-5191-90e6-7d1d444eefd6" :topic/math-academy-id 1726 :topic/title "Elementary 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c34442a-1ba5-50e6-9956-6c60c53a175d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472664} {:answer/id #uuid "bcb5e1b1-f89e-5daa-85b2-e0dde4da66b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472665}] :answer-field/correct {:answer/id #uuid "4c34442a-1ba5-50e6-9956-6c60c53a175d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472664} :answer-field/id #uuid "61214d2d-44ba-553b-b6a3-330618cebbc3" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473727} {:answer-field/choices [{:answer/id #uuid "41438b30-61cc-5947-860b-7cfc8403798e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472666} {:answer/id #uuid "341c504d-f433-56b8-84a8-a8071aab725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472667}] :answer-field/correct {:answer/id #uuid "341c504d-f433-56b8-84a8-a8071aab725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472667} :answer-field/id #uuid "404fba34-ac4e-5d8f-94be-c73393320824" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473728} {:answer-field/choices [{:answer/id #uuid "3cbd5216-0eff-5c56-b724-fc09fc8bb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472668} {:answer/id #uuid "a66c8c1d-1486-5250-a60d-94bda0fdbe47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472669}] :answer-field/correct {:answer/id #uuid "3cbd5216-0eff-5c56-b724-fc09fc8bb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472668} :answer-field/id #uuid "04ab6b85-9a99-552b-a3a8-da32f99df79a" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea3b1565-0857-5d0a-8afe-805754b2cf2a" :question/math-academy-id "q-130778" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=\\begin{bmatrix}3 & -2 \\\\ 5 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}6 & -2 \\\\ 3 & 9\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrices $A$ and $C$ are not elementary matrices because they can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $B$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:=4{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:=4{R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, only $B$ is an elementary matrix."} {:db/id #edb/ref 17592186400632 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} {:answer/id #uuid "d6aa4878-727c-5081-a2f3-b05cc3779d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437885}] :answer-field/correct {:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} :answer-field/id #uuid "819cb8bf-d475-5f1d-b674-12ded903565c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438971} {:answer-field/choices [{:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} {:answer/id #uuid "97937812-2266-5255-828e-cf5b3f4f3d5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437887}] :answer-field/correct {:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} :answer-field/id #uuid "0eda7076-17f5-56be-93f9-786bf1b9618f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438972} {:answer-field/choices [{:answer/id #uuid "87384631-af80-5ad6-9a5c-bcc246f5f41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437888} {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889}] :answer-field/correct {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889} :answer-field/id #uuid "fa55c229-a084-546e-87ad-83ef1343ba34" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438973}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-6y-2z &=4 \\\\ 3x-9y-3z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186400639 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf929f6a-e145-57f9-9489-b8af5e174866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437890} {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891}] :answer-field/correct {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891} :answer-field/id #uuid "2fbdbbd8-b352-5675-a10c-aa7c8880cb1e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438974} {:answer-field/choices [{:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} {:answer/id #uuid "6cec419e-f6b4-51c0-ae9e-deed2e858fc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437893}] :answer-field/correct {:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} :answer-field/id #uuid "51c120d2-aebb-5e91-8e2f-ef0869ec4dd4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438975} {:answer-field/choices [{:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} {:answer/id #uuid "262383e4-8fe8-5d1c-ad11-c487ac71bc1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437895}] :answer-field/correct {:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} :answer-field/id #uuid "07a2a3d4-474a-5d37-b1a5-05837e60f654" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438976}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+7y &=1 \\\\ -2x-4y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ y &=4.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186400646 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=6 \\\\ -2x+y &=-3 \\\\ 4x-4y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system has no solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ y &=-1.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement II is true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"} :activity/title "Gaussian Elimination For NxM Systems of Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492210} :db/id #edb/ref 17592186492950}]} {:db/id #edb/ref 17592186401586 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither" :topic/_knowledge-points [{:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4564e18e-6dd3-592f-b9bf-6a20676a3b9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472766} {:answer/id #uuid "45b0e7fa-80cd-5a12-9738-58511f6045e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472767}] :answer-field/correct {:answer/id #uuid "4564e18e-6dd3-592f-b9bf-6a20676a3b9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472766} :answer-field/id #uuid "855b803a-41ec-54c7-b217-cd7e07f3f903" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473778} {:answer-field/choices [{:answer/id #uuid "90203ed1-4476-519f-9f88-b4e02ca64ace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472768} {:answer/id #uuid "97ba8073-07f2-57a8-a1bd-4281e7eb3559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472769}] :answer-field/correct {:answer/id #uuid "90203ed1-4476-519f-9f88-b4e02ca64ace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472768} :answer-field/id #uuid "193ec04e-372e-5547-a37c-6dcc99f24e8b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473779} {:answer-field/choices [{:answer/id #uuid "cec72ac9-8abf-5d07-936d-25ec93cb55c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472770} {:answer/id #uuid "1f3c4534-d68b-508f-9b49-1132a3559fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472771}] :answer-field/correct {:answer/id #uuid "1f3c4534-d68b-508f-9b49-1132a3559fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472771} :answer-field/id #uuid "3aa6603a-92f4-51b4-90a0-db5e275129ca" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473780}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fd6f7437-bc45-50cb-9400-bcd422c5b408" :question/math-academy-id "q-168921" :question/problem "Which of the following statements are true regarding the finite region bounded between the circle ${x}^{2}+{y}^{2}=4$ and the ellipse $4{x}^{2}+(y+1)^{2}=1?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/bc/bc6b71d1fe69abd34dbd939dc62ede5201b75713e25456cf084e889bc44f449e.png)\n\nWe have the following:\n\n- The vertical line $x=0.4$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/4a/4a1fd7069abaa3b3fa4d9c286773d226798bf3ad565e85663cab44557fd635c1.png)\n\n- The horizontal line $y=-1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/26/260e8e959ca95a029a98bd4102106a66df418ea73c0640398c8fdebfdbf812f6.png)\n\nTherefore, only statement III is true."} {:db/id #edb/ref 17592186401948 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant" :topic/_knowledge-points [{:db/id #edb/ref 17592186048533 :topic/id #uuid "a7996653-9e76-59d9-b493-05cb731632cb" :topic/math-academy-id 1566 :topic/title "Elementary Trigonometric Equations Containing Cosecant"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e142106e-ef73-57fa-840c-e61255e848de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473028} {:answer/id #uuid "8b51a4de-5f58-5a3a-9667-4951bc2003c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473029}] :answer-field/correct {:answer/id #uuid "8b51a4de-5f58-5a3a-9667-4951bc2003c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473029} :answer-field/id #uuid "853fc5ed-1831-5264-84f8-89ac0a5394d8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473909} {:answer-field/choices [{:answer/id #uuid "a178d0a0-7bb3-51f9-a2f0-d6770e6ab934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473030} {:answer/id #uuid "8d8c6e69-3447-5efd-bc84-017d7a667be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473031}] :answer-field/correct {:answer/id #uuid "a178d0a0-7bb3-51f9-a2f0-d6770e6ab934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473030} :answer-field/id #uuid "3e7b7604-ac37-5dd6-8299-2c0bf2fa638c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473910} {:answer-field/choices [{:answer/id #uuid "d256c368-dee8-53d7-9b0f-05cd06cd375d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473032} {:answer/id #uuid "c453c311-c99b-5aaa-a02e-c0d2e2e20b4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473033}] :answer-field/correct {:answer/id #uuid "d256c368-dee8-53d7-9b0f-05cd06cd375d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473032} :answer-field/id #uuid "bdfa7e16-65c0-53eb-9f2b-c2106fc2c104" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c11092b-9e53-51e1-b299-c5287bf677e1" :question/math-academy-id "q-29477" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{csc}⁡x=\\frac{1}{3}$\nII. $\\operatorname{csc}⁡x=3$\nIII. $\\operatorname{csc}⁡x=1$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions."} {:db/id #edb/ref 17592186401988 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065a462e-4cdc-5a25-9872-a7c085366472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473034} {:answer/id #uuid "4796d2c2-5c3f-5420-b0ba-923e0a7362e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473035}] :answer-field/correct {:answer/id #uuid "4796d2c2-5c3f-5420-b0ba-923e0a7362e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473035} :answer-field/id #uuid "19956410-3b4e-5a83-9e55-0c91ef55ef44" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473912} {:answer-field/choices [{:answer/id #uuid "6ade44ee-fae7-5546-89bf-d1e056d045e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473036} {:answer/id #uuid "6dc593be-5cc2-56f6-8fa5-0c64040fb219" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473037}] :answer-field/correct {:answer/id #uuid "6ade44ee-fae7-5546-89bf-d1e056d045e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473036} :answer-field/id #uuid "e330bc56-8a53-567d-8afb-824a3a134195" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473913} {:answer-field/choices [{:answer/id #uuid "bf6585ad-85fb-5822-832a-d01d1092359f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473038} {:answer/id #uuid "f582afb8-3915-5150-91e3-1ad4ae998fd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473039}] :answer-field/correct {:answer/id #uuid "bf6585ad-85fb-5822-832a-d01d1092359f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473038} :answer-field/id #uuid "fa659d4d-f3e6-5ed9-9b2f-d21dc395e444" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "561c404c-366e-5e58-b3aa-1094d48ff6e7" :question/math-academy-id "q-31919" :question/problem "Which of the following completes the statement so that it is true:\n\n*If $det(A)\\ne 0,$ where $A$ is a $2\\times 2$-matrix, then $A$ is $\\underline{\\phantom{xxxxxx}}$ .*\n\nI. invertible\n\nII. **not ** invertible\n\nIII. singular\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.  \n\nNow, since the fifth part of the invertible matrix theorem is true ($det(A)\\ne 0$), all the other parts of the theorem are true too. Therefore, according to the theorem, only option I gives a true statement:\n\n- *If $det(A)\\ne 0$ , then $A$ is invertible.* $\\,✓$"} {:db/id #edb/ref 17592186402427 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve" :topic/_knowledge-points [{:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900 :topic/title "Level Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9abfdb74-a53a-5872-9e51-bd0aa07bb10c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473082} {:answer/id #uuid "9e287248-2f2b-5be8-9e40-4ece19f43e16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473083}] :answer-field/correct {:answer/id #uuid "9e287248-2f2b-5be8-9e40-4ece19f43e16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473083} :answer-field/id #uuid "87236ea7-a2fc-5398-9f98-8b0dec672075" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473936} {:answer-field/choices [{:answer/id #uuid "e72057f6-fbf3-5494-8883-b63e2381aab7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473084} {:answer/id #uuid "f6fe42c2-35b2-5914-abe8-4b65467d7b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473085}] :answer-field/correct {:answer/id #uuid "e72057f6-fbf3-5494-8883-b63e2381aab7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473084} :answer-field/id #uuid "6f6a83fd-694a-5132-a8a6-4888b5faa104" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473937} {:answer-field/choices [{:answer/id #uuid "a858058d-dbdf-59ef-a7db-6b095c446be0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473086} {:answer/id #uuid "1cefc54e-0efc-53ef-8cc1-fff5488204b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473087}] :answer-field/correct {:answer/id #uuid "1cefc54e-0efc-53ef-8cc1-fff5488204b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473087} :answer-field/id #uuid "29967360-3ab9-5db6-88fc-1504799fabb3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb8b2d04-67d4-51d3-8ebf-71fc804b1a61" :question/math-academy-id "q-35527" :question/problem "The level curves of the function $f(x,y)=xy$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=1$ gives a hyperbola\n- **II.** $c=-1$ gives a parabola\n- **III.** $c=0$ gives the axes $x=0$ and $y=0$" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}xy & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=\\pm 1$ then the level curves are $xy=\\pm 1,$ which are hyperbolas.\n\n- If $c=0$ then the level curves are $xy=0,$ which consists of the axes $x=0$ and $y=0.$\n\nSo, only statements I and III are true."} {:db/id #edb/ref 17592186402609 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53f93a90-917d-59e1-ad77-0b9aad541d3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438266} {:answer/id #uuid "12af740c-a997-5387-8362-5e2cc16732ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438267}] :answer-field/correct {:answer/id #uuid "53f93a90-917d-59e1-ad77-0b9aad541d3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438266} :answer-field/id #uuid "2b6fcdaf-3dd3-5706-a56b-12ba3e57c541" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439162} {:answer-field/choices [{:answer/id #uuid "80660670-28fa-562c-9cdd-803d3f3b6e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438268} {:answer/id #uuid "5834e804-b776-587a-9eff-2c1a6107cc1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438269}] :answer-field/correct {:answer/id #uuid "5834e804-b776-587a-9eff-2c1a6107cc1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438269} :answer-field/id #uuid "676ac767-8dfd-50fa-9ecf-b51ab8fab0b5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439163} {:answer-field/choices [{:answer/id #uuid "56d97f56-3c64-5231-b1a7-ace7dd7012d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438270} {:answer/id #uuid "1c459c6d-1c91-560e-9b29-0f2524d0be20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438271}] :answer-field/correct {:answer/id #uuid "56d97f56-3c64-5231-b1a7-ace7dd7012d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438270} :answer-field/id #uuid "091267d0-c528-519a-8b1c-763f1c12a047" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439164}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a5eb8a6b-37c6-54e6-b340-18101dbf3f8f" :question/math-academy-id "q-38187" :question/problem "Which of the following statements are true regarding the matrix $N$ given below?\n\nSelect all that apply.\n\n- **I.** $N$ is **not** a singular matrix\n- **II.** $N$ is a singular matrix\n- **III.** $det(N)=-1$\n\n$$\nN=\\begin{bmatrix}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(N) & =|\\begin{aligned}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{aligned}| \\\\  & =\\frac{1}{7}|\\begin{aligned}4 & -\\frac{1}{7} \\\\ 5 & -\\frac{1}{7}\\end{aligned}|-3|\\begin{aligned}\\frac{1}{7} & -\\frac{1}{7} \\\\ \\frac{1}{7} & -\\frac{1}{7}\\end{aligned}|+(-\\frac{1}{7})|\\begin{aligned}\\frac{1}{7} & 4 \\\\ \\frac{1}{7} & 5\\end{aligned}| \\\\  & =\\frac{1}{7}(-\\frac{4}{7}+\\frac{5}{7})-3(-\\frac{1}{49}+\\frac{1}{49})-\\frac{1}{7}(\\frac{5}{7}-\\frac{4}{7}) \\\\  & =\\frac{1}{7}\\cdot \\frac{1}{7}-3\\cdot 0-\\frac{1}{7}\\cdot \\frac{1}{7} \\\\  & =\\frac{1}{49}-\\frac{1}{49} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(N)=0$, the matrix is singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186402649 :knowledge-point/_questions [{:db/id #edb/ref 17592186129148 :knowledge-point/id #uuid "34aa8f4e-20f1-5dda-ac53-6eb411543897" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Polynomial" :topic/_knowledge-points [{:db/id #edb/ref 17592186050046 :topic/id #uuid "288ef1bc-9e03-59cc-957a-e1edeebef5c3" :topic/math-academy-id 2050 :topic/title "End Behavior of Polynomials"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2af9542-5873-59ba-8fd2-2224540f5f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473094} {:answer/id #uuid "80e69516-f9fe-5fc8-a4e8-ec88eed841f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473095}] :answer-field/correct {:answer/id #uuid "80e69516-f9fe-5fc8-a4e8-ec88eed841f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473095} :answer-field/id #uuid "cc3916a7-eb28-5705-88d0-d32146793e3f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473942} {:answer-field/choices [{:answer/id #uuid "cbf21d05-b027-5353-8ae3-707bf655961b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473096} {:answer/id #uuid "80136753-69e8-51e0-ba12-4733cb3025b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473097}] :answer-field/correct {:answer/id #uuid "cbf21d05-b027-5353-8ae3-707bf655961b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473096} :answer-field/id #uuid "f1e53732-1f78-5e7b-9390-6681afca476c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473943} {:answer-field/choices [{:answer/id #uuid "38a7e570-def5-5287-8816-c25103ff58e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473098} {:answer/id #uuid "9b38576a-7c14-5700-b49a-4e768e3dda43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473099}] :answer-field/correct {:answer/id #uuid "9b38576a-7c14-5700-b49a-4e768e3dda43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473099} :answer-field/id #uuid "70e3dc48-c10f-5799-8dfe-bacdcdc314db" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473944}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4ced118-ede6-56c5-a59a-002b28515d4b" :question/math-academy-id "q-38580" :question/problem "![](images/ea/ea87f040e4249a04c21dd6c8466ffd194d60753056c29f00d8956e182db61ff3.png)\n\nThe graph of the polynomial $y=F(x)$ is shown above. Which of the following statements are true?\n\nI. The degree of $F(x)$ is odd.\nII. The degree of $F(x)$ is even.\nIII. The coefficient of the leading term is positive.\n\nSelect all that apply." :question/worked-solution "The end behavior of $F(x)$ is\n\n- $F(x)\\to \\infty $ as $x\\to \\infty ,$ and\n\n- $F(x)\\to -\\infty $ as $x\\to -\\infty .$\n\nConsequently, \n\n- the degree of $F(x)$ is odd, and\n\n- the leading coefficient of $F(x)$ is positive.\n\nSo II is false, and I and III are true."} {:db/id #edb/ref 17592186402662 :knowledge-point/_questions [{:db/id #edb/ref 17592186129097 :knowledge-point/id #uuid "485fd759-96b3-553f-9eaa-849878c30885" :knowledge-point/title "Identifying a Jump Discontinuity Given a Function Definition" :topic/_knowledge-points [{:db/id #edb/ref 17592186050124 :topic/id #uuid "2eb940a7-12ca-5de2-9f75-d2efec304289" :topic/math-academy-id 2003 :topic/title "Jump Discontinuities"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd4f6098-e65a-5d99-8d01-d5540fe512d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473100} {:answer/id #uuid "fd96cfe2-8341-57f7-a6fd-4e8fd15ffdc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473101}] :answer-field/correct {:answer/id #uuid "fd4f6098-e65a-5d99-8d01-d5540fe512d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473100} :answer-field/id #uuid "23300eaf-c06a-55ae-96a5-109a93a24313" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473945} {:answer-field/choices [{:answer/id #uuid "1a1aa91f-46cf-5054-b21c-0dc18abb0e15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473102} {:answer/id #uuid "aec88665-75e7-5206-8964-0e8fab4087c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473103}] :answer-field/correct {:answer/id #uuid "aec88665-75e7-5206-8964-0e8fab4087c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473103} :answer-field/id #uuid "5f0517c1-3b20-515a-9d13-401eb77bb19c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473946} {:answer-field/choices [{:answer/id #uuid "bfa5f7a7-56a2-50c2-a370-08952da156b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473104} {:answer/id #uuid "57491428-7d27-5443-af5c-8de9a1e1b62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473105}] :answer-field/correct {:answer/id #uuid "bfa5f7a7-56a2-50c2-a370-08952da156b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473104} :answer-field/id #uuid "06a77207-d167-5dbe-9c2b-2c7f1f3ce2ea" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473947}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f9c9f1a-022c-5394-a51c-b1a490ff1e16" :question/math-academy-id "q-38715" :question/problem "Which of the following statements are true regarding the function $f(x)$ below?\n\n$$\nf(x)={\\begin{aligned}(x-1)^{3}, & x<0 \\\\ {x}^{6}+1, & x\\ge 0\\end{aligned}\n$$\n\nSelect all that apply.\n\n- **I.** It has a removable discontinuity at $x=0.$\n- **II.** It has a jump discontinuity at $x=0.$\n- **III.** It's continuous at $x=0.$" :question/worked-solution "For $x=0,$ let's go through our continuity checklist:\n\n- $f(0)={0}^{6}+1=1$ exists $\\,\\,✓$\n\n- Let's now check the left and right limits. We see that\n\n$$\n{lim}_{x\\to {0}^{-}}f(x)={lim}_{x\\to {0}^{-}}{(x-1)}^{3}=(0-1)^{3}=-1\n$$\n\nwhile \n\n$$\n{lim}_{x\\to {0}^{+}}f(x)={lim}_{x\\to {0}^{+}}({x}^{6}+1)={0}^{6}+1=1.\n$$\n\nSo both the left and right limits exist and are finite, but they are not equal. $\\,\\,\\times $\n\nTherefore, $f(x)$ has a jump discontinuity at $x=0.$ \n\nHence, I is false, II is true and III is false."} {:db/id #edb/ref 17592186402695 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots" :topic/_knowledge-points [{:db/id #edb/ref 17592186049363 :topic/id #uuid "eefd5285-6b99-569d-a5bb-365f176fa757" :topic/math-academy-id 807 :topic/title "Vertical Asymptotes of Rational Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9b1cd4-2765-5911-bf4d-ab94fa28dffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439745} {:answer/id #uuid "0205637e-c6c7-5efb-b969-574286186336" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439746}] :answer-field/correct {:answer/id #uuid "1b9b1cd4-2765-5911-bf4d-ab94fa28dffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439745} :answer-field/id #uuid "701fd38d-2e9d-5fa9-8c52-97331a2dfb74" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440230} {:answer-field/choices [{:answer/id #uuid "96d20032-2a04-59d8-b369-c2bfeac9edd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439747} {:answer/id #uuid "24389cce-7954-5559-8a48-cb113db6a3b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439748}] :answer-field/correct {:answer/id #uuid "96d20032-2a04