b/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474083} {:answer-field/choices [{:answer/id #uuid "9299b1f8-2251-5b43-9bd2-4bbaff81aeec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473378} {:answer/id #uuid "f3b6fc24-4f6b-56f1-8866-6340118d47db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473379}] :answer-field/correct {:answer/id #uuid "9299b1f8-2251-5b43-9bd2-4bbaff81aeec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473378} :answer-field/id #uuid "d3409a6e-f1df-5a50-bffb-d1d63615d8a7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474084}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97b65183-2af9-5046-876f-bba35987095c" :question/math-academy-id "q-77812" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{csc}⁡x+30=4\\operatorname{csc}⁡x$\n\nII. $5\\operatorname{csc}⁡x-1=2\\operatorname{csc}⁡x$\n\nIII. $\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x-12$\n\nSelect all that apply." :question/worked-solution "We first simplify the given equations, and get\n\nI. $\\operatorname{csc}⁡x=10$\n\nII. $\\operatorname{csc}⁡x=\\frac{1}{3}$\n\nIII. $\\operatorname{csc}⁡x=4$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation II has no solutions."} {:db/id #edb/ref 17592186403919 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048434 :topic/id #uuid "9ef976b2-cf49-59ec-9689-0ec6f4a92d3c" :topic/math-academy-id 288 :topic/title "The Mean Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66663666-6b2e-5179-9d1d-7e887c95870e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473380} {:answer/id #uuid "890f8342-7f94-50f9-bf58-253bb5456e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473381}] :answer-field/correct {:answer/id #uuid "890f8342-7f94-50f9-bf58-253bb5456e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473381} :answer-field/id #uuid "1e2a9ee2-1f01-5fd6-9c2a-edb0bf0a82d2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474085} {:answer-field/choices [{:answer/id #uuid "e09f2257-5747-5ba6-91f5-9c588074018a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473382} {:answer/id #uuid "ff04d293-ed97-59e0-bc20-921bdcd6c2ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473383}] :answer-field/correct {:answer/id #uuid "e09f2257-5747-5ba6-91f5-9c588074018a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473382} :answer-field/id #uuid "e8b21d0b-00b1-581c-8ff5-058a7a338509" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474086} {:answer-field/choices [{:answer/id #uuid "26839322-c67a-5c59-aef4-06789c32c634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473384} {:answer/id #uuid "98c2fafd-f8d6-54d6-811f-0da3599ec616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473385}] :answer-field/correct {:answer/id #uuid "98c2fafd-f8d6-54d6-811f-0da3599ec616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473385} :answer-field/id #uuid "3e08be54-a6b1-5674-8fc9-cc5c657d5491" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474087}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d6a5882-b479-5d6b-aea9-d1ab879c1fe4" :question/math-academy-id "q-77865" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-4,4]?$\n\nI. $f(x)={e}^{{x}^{2}}$\nII. $g(x)={2}^{1/{x}^{2}}$\nIII. $h(x)=\\sqrt{x+4}$\n\nSelect all that apply." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-4,4],$ the function must be continuous on $[-4,4]$ and differentiable on $(-4,4).$\n\nLet's check each function individually.\n\n- The function $f(x)={e}^{{x}^{2}}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-4,4]$ and differentiable on $(-4,4).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)={2}^{1/{x}^{2}}$ is not defined at $x=0,$ hence, it is not continuous at \n$x=0,$ and so it is not continuous on $[-4,4].$ Therefore, $g(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function $h(x)=\\sqrt{x+4}$ is continuous on $[-4,\\infty )$ and differentiable on $(-4,\\infty ).$ In particular, it is continuous on $[-4,4]$ and differentiable on $(-4,4).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, only the functions I and III satisfy the conditions for the mean value theorem over the interval $[-4,4].$"} {:db/id #edb/ref 17592186404044 :knowledge-point/_questions [{:db/id #edb/ref 17592186229137 :knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0" :knowledge-point/title "Using the Properties of Linear Differential Operators to Identify Them" :topic/_knowledge-points [{:db/id #edb/ref 17592186050537 :topic/id #uuid "51e12769-3848-5c84-bd86-1c35f7ad69b3" :topic/math-academy-id 6707 :topic/title "Linear Differential Operators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66945714-0f3d-5cc3-8b5b-507cf6021c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473404} {:answer/id #uuid "33c178cd-4b39-5618-b57b-522dc51e66cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473405}] :answer-field/correct {:answer/id #uuid "33c178cd-4b39-5618-b57b-522dc51e66cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473405} :answer-field/id #uuid "37627eb3-6003-5a17-832c-60ecd2564b36" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474097} {:answer-field/choices [{:answer/id #uuid "dd7e61ba-9286-52f0-8db5-33ed6dbfc475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473406} {:answer/id #uuid "a6f2ab4f-6694-5dfe-90b6-b4ea43acb064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473407}] :answer-field/correct {:answer/id #uuid "a6f2ab4f-6694-5dfe-90b6-b4ea43acb064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473407} :answer-field/id #uuid "2ea6015e-eb0c-5250-9754-e74bfdee2951" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474098} {:answer-field/choices [{:answer/id #uuid "6ca2d238-7517-5f09-b033-0cd58405b16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473408} {:answer/id #uuid "375b18c2-e3c0-5a4f-836e-bb3510f307ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473409}] :answer-field/correct {:answer/id #uuid "6ca2d238-7517-5f09-b033-0cd58405b16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473408} :answer-field/id #uuid "41c26e8c-9101-55a8-9a92-3125eab2120e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474099}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25cb2680-651e-5a50-81aa-a03a420f17ff" :question/math-academy-id "q-79609" :question/problem "Which of the following are linear differential operators?\n\nI. ${D}_{1}(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y$\nII. ${D}_{2}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-xy$\nIII. ${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$\n\nSelect all that apply." :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{y}_{1}+b{y}_{2} \\\\  & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{y}_{1}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-ax{y}_{1}-bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-x{y}_{2}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}) \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\na{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})=a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}.\\,\\times \n$$"} {:db/id #edb/ref 17592186404058 :knowledge-point/_questions [{:db/id #edb/ref 17592186152169 :knowledge-point/id #uuid "101e0c22-fbb4-5865-af5f-d669e2488d09" :knowledge-point/title "Identifying Solutions to Linear ODEs Using the Superposition Principle" :topic/_knowledge-points [{:db/id #edb/ref 17592186050032 :topic/id #uuid "277bf882-73ab-515e-84e5-4f7920acb235" :topic/math-academy-id 2549 :topic/title "The Superposition Principle"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1cdba25-84d8-529c-a7e4-55d2c163c39a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473410} {:answer/id #uuid "092a0e35-6b87-553a-b013-1899c41e8750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473411}] :answer-field/correct {:answer/id #uuid "092a0e35-6b87-553a-b013-1899c41e8750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473411} :answer-field/id #uuid "6a33fb9f-f4ab-5fa6-b8c2-2b315892dd81" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474100} {:answer-field/choices [{:answer/id #uuid "067dcce0-2ce3-5612-abc2-5e53e49fa8ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473412} {:answer/id #uuid "bb6e69d3-1313-595d-ae0c-66609c53a4a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473413}] :answer-field/correct {:answer/id #uuid "067dcce0-2ce3-5612-abc2-5e53e49fa8ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473412} :answer-field/id #uuid "7b5d1630-db1e-5690-8f20-a4e018fd9612" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474101} {:answer-field/choices [{:answer/id #uuid "940def32-e2e8-57dd-9dc8-9252c8387e34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473414} {:answer/id #uuid "f8e6d8c5-ffe3-5619-973e-7efdaa394e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473415}] :answer-field/correct {:answer/id #uuid "f8e6d8c5-ffe3-5619-973e-7efdaa394e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473415} :answer-field/id #uuid "aaa31532-0748-5306-a0e4-248ec10e3366" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474102}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "742f0d7e-0be6-5200-afaf-b211266d03e0" :question/math-academy-id "q-79799" :question/problem "Given that ${y}_{1}(t)={e}^{-t}$ and ${y}_{2}(t)={e}^{4t}$ are solutions to the equation ${y}^{″}-3{y}^{′}-4y=0,$ which of the following must also be a solution to the equation?\n\nI. $y(t)={e}^{-t-1}$\nII. $y(t)=7{e}^{-t}-3{e}^{-4t}$\nIII. $y(t)=\\frac{{e}^{4t}}{4}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(t)$ and ${y}_{2}(t)$ are solutions to a homogeneous, linear differential equation, and ${c}_{1}$ and ${c}_{2}$ are constants, then $y(t)={c}_{1}{y}_{1}(t)+{c}_{2}{y}_{2}(t)$ is also a solution to the equation.\n\nWe're given that ${y}_{1}(t)={e}^{-t}$ and ${y}_{2}(t)={e}^{4t}.$ Therefore, the following function is also a solution:\n\n$$\ny(t)={c}_{1}{e}^{-t}+{c}_{2}{e}^{4t}\n$$\n\nLet's consider each option:\n\n- The function $y(t)={e}^{-t-1}=\\frac{{e}^{-t}}{e}$ is a solution of the given equation. Here, ${c}_{1}=\\frac{1}{e},{c}_{2}=0.$\n\n- The function $y(t)=7{e}^{-t}-3{e}^{-4t}$ is **not** a solution of the given equation because ${e}^{-4t}$ is not a solution.\n\n- The function $y(t)=\\frac{{e}^{4t}}{4}$ is a solution of the given equation. Here, ${c}_{1}=0,{c}_{2}=\\frac{1}{4}.$"} {:db/id #edb/ref 17592186404482 :knowledge-point/_questions [{:db/id #edb/ref 17592186147499 :knowledge-point/id #uuid "6ed6eeb5-a646-5f47-b6d8-f1078f550376" :knowledge-point/title "Identifying Factors Giving an Exact ODE" :topic/_knowledge-points [{:db/id #edb/ref 17592186049438 :topic/id #uuid "f5406a8f-fa45-5605-9b0d-8775dff0b978" :topic/math-academy-id 2521 :topic/title "Exact Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e15f378a-48fc-52fe-8823-93e1ecd6bfa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473530} {:answer/id #uuid "ff0b8c78-df0e-5376-a1d5-062470f9b700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473531}] :answer-field/correct {:answer/id #uuid "e15f378a-48fc-52fe-8823-93e1ecd6bfa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473530} :answer-field/id #uuid "e8491ecc-d42f-5097-b247-4917384941a1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474160} {:answer-field/choices [{:answer/id #uuid "11eae91c-5d78-5a31-ba0c-4a2e1724c2e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473532} {:answer/id #uuid "5427f4e5-abc9-5196-b937-ea2a61a4979f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473533}] :answer-field/correct {:answer/id #uuid "11eae91c-5d78-5a31-ba0c-4a2e1724c2e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473532} :answer-field/id #uuid "d7a6a6b8-f0c5-5e99-bb31-95a22ffc645a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474161} {:answer-field/choices [{:answer/id #uuid "a748e074-f924-5d1c-9ca0-5cbd913edfa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473534} {:answer/id #uuid "e22fc836-77eb-51c5-b108-fdca97c84f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473535}] :answer-field/correct {:answer/id #uuid "e22fc836-77eb-51c5-b108-fdca97c84f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473535} :answer-field/id #uuid "d122ca1e-6dcc-5fcd-92e2-84487547bfc4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474162}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fa44e0d-f47d-55dc-9787-703e1dcaa8bd" :question/math-academy-id "q-90493" :question/problem "Consider the following differential equation:\n\n$$\nP(x,y)\\text{d}x+5{y}^{4}{e}^{2x}\\,\\text{d}y=0\n$$\n\nGiven that the differential equation is exact, which of the following functions could be $P(x,y)?$\n\nI. $10{y}^{5}{e}^{x}+4$\nII. $2{y}^{5}{e}^{2x}-y$\nIII. $2{y}^{5}{e}^{2x}+{e}^{-x}$\n\nSelect all that apply." :question/worked-solution "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nIn our case, we're given $Q(x,y)=5{y}^{4}{e}^{2x}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x$:\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(5{y}^{4}{e}^{2x})=10{y}^{4}{e}^{2x}\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=10{y}^{5}{e}^{x}+4.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(10{y}^{5}{e}^{x}+4)=50{y}^{4}{e}^{x}\\ne \\frac{∂Q}{∂x}\\,\\times \\end{aligned}\n$$\n\nTherefore, $P(x,y)=10{y}^{5}{e}^{x}+4$ does *not* give an exact equation.\n\n- Next, we check $P(x,y)=2{y}^{5}{e}^{2x}-y:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2{y}^{5}{e}^{2x}-y)=10{y}^{4}{e}^{2x}-1\\ne \\frac{∂Q}{∂x}\\,\\times \\end{aligned}\n$$\n\nTherefore, $P(x,y)=2{y}^{5}{e}^{2x}-y$ does *not* give an exact equation.\n\n- Finally, we check $P(x,y)=2{y}^{5}{e}^{2x}+{e}^{-x}:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2{y}^{5}{e}^{2x}+{e}^{-x})=10{y}^{4}{e}^{2x}=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2{y}^{5}{e}^{2x}+{e}^{-x}$ gives an exact equation."} {:db/id #edb/ref 17592186404489 :knowledge-point/_questions [{:db/id #edb/ref 17592186147592 :knowledge-point/id #uuid "fc7eacaa-2cf2-5cae-a40c-737c98124bcf" :knowledge-point/title "Determining the Degree of a Homogeneous Polynomial Using the Fast Method" :topic/_knowledge-points [{:db/id #edb/ref 17592186049922 :topic/id #uuid "1ecb929e-8b09-5ace-ac95-9f72f70c2772" :topic/math-academy-id 2536 :topic/title "Homogeneous Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec0311ce-b46b-5035-833a-cea67a498994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473536} {:answer/id #uuid "acbe6235-6424-5ca0-8ff0-d4f83a9b6e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473537}] :answer-field/correct {:answer/id #uuid "acbe6235-6424-5ca0-8ff0-d4f83a9b6e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473537} :answer-field/id #uuid "73412ddb-1b44-5d75-9d51-79a3b827c576" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474163} {:answer-field/choices [{:answer/id #uuid "0c3c7e4d-96ad-5456-af60-6a9be8b1b2c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473538} {:answer/id #uuid "9a7d5594-82ad-5f14-b78f-06bc040d3301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473539}] :answer-field/correct {:answer/id #uuid "9a7d5594-82ad-5f14-b78f-06bc040d3301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473539} :answer-field/id #uuid "5f571d9b-f764-5fe9-bebd-c3011862617e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474164} {:answer-field/choices [{:answer/id #uuid "bafda784-1720-5bb1-a298-7401ce3dc64a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473540} {:answer/id #uuid "0c9d50fe-1a80-59d8-9425-f2596d83aacb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473541}] :answer-field/correct {:answer/id #uuid "0c9d50fe-1a80-59d8-9425-f2596d83aacb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473541} :answer-field/id #uuid "152e7eef-107e-520a-9245-b37a9384cd65" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474165}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "056f268e-6f23-5cca-ba50-28679fda2fed" :question/math-academy-id "q-90580" :question/problem "Which of the following polynomials are homogeneous?\n\nI. $f(x)=7{x}^{7}$\nII. $g(x,y)=x+y$\nIII. $h(x,y,z)={x}^{2}z-2xyz+x{z}^{2}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's go through each of the options.\n\n- The function $f(x)$ is homogeneous of degree $7.$  It is a polynomial of degree $7,$ with no terms of degree other than $7.$\n\n- The function $g(x,y)$ is homogeneous of degree $1.$ It is a polynomial of degree $1,$ and all of its terms are of degree $1.$\n\n- The function $h(x,y,z)$ is  homogeneous of degree $3.$ It is a polynomial of degree $3,$ and all of its terms are of degree $3.$"} {:db/id #edb/ref 17592186404672 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a987d465-96cb-5565-87da-ae39b2f6a92a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473590} {:answer/id #uuid "3e93a862-63da-5b94-b287-04f38912e3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473591}] :answer-field/correct {:answer/id #uuid "3e93a862-63da-5b94-b287-04f38912e3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473591} :answer-field/id #uuid "ca99863b-b425-5b5a-ac1b-d0313dabcf4b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474190} {:answer-field/choices [{:answer/id #uuid "1fd96488-ba24-5395-9984-81005376bc49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473592} {:answer/id #uuid "d9c3983e-849e-58b2-8b42-2cd6e4159d2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473593}] :answer-field/correct {:answer/id #uuid "1fd96488-ba24-5395-9984-81005376bc49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473592} :answer-field/id #uuid "c07c7d0e-205c-53a2-a07b-dcf5bc52afaa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474191} {:answer-field/choices [{:answer/id #uuid "ed73706a-6e71-56ba-88e4-f857738dd0fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473594} {:answer/id #uuid "c42472a9-f281-5bea-92d5-c789d59d5b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473595}] :answer-field/correct {:answer/id #uuid "ed73706a-6e71-56ba-88e4-f857738dd0fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473594} :answer-field/id #uuid "ff1aee9a-9f0b-58d7-bba1-84da96bd2edc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5104a46-b15f-584e-909c-ecd7bde371f7" :question/math-academy-id "q-94277" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+49y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(7t+{ϕ}_{1})$\nII. $y=R{sin}^{2}⁡(7t+{ϕ}_{2})$\nIII. $y=A\\operatorname{sec}⁡7t+B\\operatorname{sin}⁡7t$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants.\n\nSelect all that apply." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=49\\,⟹\\,\\omega =7.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(7t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(7t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡7t+B\\operatorname{sin}⁡7t$\n\nTherefore, only function I could be used to represent  $y(t).$"} {:db/id #edb/ref 17592186404679 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations" :topic/_knowledge-points [{:db/id #edb/ref 17592186050824 :topic/id #uuid "69970c4c-efa5-537d-a31c-79a56da6e61a" :topic/math-academy-id 2524 :topic/title "Simple Harmonic Oscillators"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8985fe4-3ac5-56a7-9098-2eae5e6fa918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473596} {:answer/id #uuid "15ea8117-ebc8-5814-b2ac-1fe2bf2a8243" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473597}] :answer-field/correct {:answer/id #uuid "e8985fe4-3ac5-56a7-9098-2eae5e6fa918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473596} :answer-field/id #uuid "f84d5925-da95-5920-a7ac-94bedb2ce6db" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474193} {:answer-field/choices [{:answer/id #uuid "29113d34-992b-56b3-8a21-c7c09fdad7f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473598} {:answer/id #uuid "4def6162-cad2-5c33-8c5d-93189b905062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473599}] :answer-field/correct {:answer/id #uuid "4def6162-cad2-5c33-8c5d-93189b905062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473599} :answer-field/id #uuid "898e6262-677e-5b1f-905c-aa35b176ce24" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474194} {:answer-field/choices [{:answer/id #uuid "de417394-cdb1-5a81-a934-58231a475209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473600} {:answer/id #uuid "79e8f5d9-91e1-59d2-ba3c-24686e65b1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473601}] :answer-field/correct {:answer/id #uuid "de417394-cdb1-5a81-a934-58231a475209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473600} :answer-field/id #uuid "1010cd03-ef23-5e5c-9aeb-93be7f261c00" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23f8b8a5-7c24-563a-a40e-d60abf329c96" :question/math-academy-id "q-94278" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+5y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(5t+{ϕ}_{1})$\nII. $y=R\\operatorname{sin}⁡(\\sqrt{5}t+{ϕ}_{2})$\nIII. $y=A\\operatorname{sec}⁡\\sqrt{5}t+B\\operatorname{csc}⁡\\sqrt{5}t$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants.\n\nSelect all that apply." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=5\\,⟹\\,\\omega =\\sqrt{5}.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(\\sqrt{5}t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\sqrt{5}t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\sqrt{5}t+B\\operatorname{sin}⁡\\sqrt{5}t$\n\nTherefore, only statement II could be used to represent $y(t).$"} {:db/id #edb/ref 17592186405016 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences" :topic/_knowledge-points [{:db/id #edb/ref 17592186049983 :topic/id #uuid "23d28f28-6e03-59a9-9aed-cdda7589cb10" :topic/math-academy-id 1087 :topic/title "Limits of Sequences"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0118fcd2-3fb3-5d19-8d54-74b731ba63af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472514} {:answer/id #uuid "185007ee-7759-5766-aba5-89fd735ff1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472515}] :answer-field/correct {:answer/id #uuid "185007ee-7759-5766-aba5-89fd735ff1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472515} :answer-field/id #uuid "76e1c758-f96e-5e38-a825-4534ee09d9c8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473652} {:answer-field/choices [{:answer/id #uuid "be82617a-5165-5619-a963-79617d0fb8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472516} {:answer/id #uuid "a4acbd6f-94bc-50c4-8cf1-90972310c364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472517}] :answer-field/correct {:answer/id #uuid "be82617a-5165-5619-a963-79617d0fb8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472516} :answer-field/id #uuid "230986f1-b69c-54fe-a946-e524b56da72a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473653} {:answer-field/choices [{:answer/id #uuid "6428e025-be55-5e9d-a741-674cab46f66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472518} {:answer/id #uuid "dfd56f4c-ce88-53f8-9163-fd06eb6824f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472519}] :answer-field/correct {:answer/id #uuid "6428e025-be55-5e9d-a741-674cab46f66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472518} :answer-field/id #uuid "2fcd4fcd-f673-515e-8c18-48e21edbbda3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473654}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4fed36-e750-5401-88f4-2ac9e7e598e7" :question/math-academy-id "q-123316" :question/problem "Which of the following sequences diverge?\n\nI. ${a}_{n}=\\frac{{n}^{3}}{1-{n}^{2}}$ for $n\\ge 2$\nII. ${a}_{n}=\\frac{3}{n}$ for $n\\ge 1$\nIII. ${a}_{n}=\\frac{2{n}^{2}-3{n}^{3}}{{n}^{3}+5}$ for $n\\ge 1$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each sequence in turn. We need to calculate the limit of each sequence as $n$ approaches infinity.\n\n- In sequence I,  the dominant term in the denominator is $-{n}^{2},$ so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{{n}^{3}}{1-{n}^{2}} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{{n}^{3}}{{n}^{2}})}{(\\frac{1}{{n}^{2}}-\\frac{{n}^{2}}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{n}{(\\frac{1}{{n}^{2}}-1)} \\\\  & ={lim}_{n\\to \\infty }\\frac{n}{0-1} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges.\n\n- In sequence II, the limit is\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{3}{n}=0.\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence III, the dominant term in the denominator is ${n}^{3},$ so we divide the numerator and the denominator by ${n}^{3}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & =\\frac{2{n}^{2}-3{n}^{3}}{{n}^{3}+5} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{2{n}^{2}}{{n}^{3}}-\\frac{3{n}^{3}}{{n}^{3}})}{(\\frac{{n}^{3}}{{n}^{3}}+\\frac{5}{{n}^{3}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{2}{n}-3)}{(1+\\frac{5}{{n}^{3}})} \\\\  & =\\frac{0-3}{1+0} \\\\  & =-3.\\end{aligned}\n$$\n\nThe limit exists, so the sequence converges.\n\nIn conclusion, sequence I diverges."} {:db/id #edb/ref 17592186405146 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "3762310e-4280-5383-a623-be69110b6dd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473303}] :answer-field/correct {:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "7b242a5e-e0c2-5c98-9faf-9932a432bab4" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474046} {:answer-field/choices [{:answer/id #uuid "c468a92d-1de4-54b3-98e3-28167311714f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473304} {:answer/id #uuid "cc55be58-e4c5-5d28-bde2-dd07f224de99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "cc55be58-e4c5-5d28-bde2-dd07f224de99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "aa9139c6-224d-5848-a9fd-c41516bf7428" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474047} {:answer-field/choices [{:answer/id #uuid "61bba97e-fa99-5844-b1d0-4a1ac0911bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "27aa4326-84a9-502a-8ac6-38a05b1d7790" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473307}] :answer-field/correct {:answer/id #uuid "61bba97e-fa99-5844-b1d0-4a1ac0911bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306 :task-item/_responses [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "17d4295d-6d7f-5bde-a6ed-7e5d41c2a614" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbb2727c-01c4-5345-9e38-1d38c7fb43da" :question/math-academy-id "q-72575" :question/problem "Which of the following augmented matrices have coefficient matrices that are **not** in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccccc|c}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "A coefficient matrix, obtained by omitting the final column of its augmented matrix, is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The coefficient matrix of $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]\n$$\n\n- The coefficient matrix of $B$ is not in row echelon form since the leading entries of its first two rows are in columns $3$ and $2,$ respectively (condition II is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{array}\\right]\n$$\n\n- The coefficient matrix of $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccccc|c}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{array}\\right]\n$$\n\nTherefore, only $B$ has a coefficient matrix that is **not** in row echelon form." :task-item/_content [{:db/id #edb/ref 17592186526463 :task-item/content {:db/id #edb/ref 17592186405146} :task-item/elapsed-seconds 32.993 :task-item/id #uuid "1cf13a50-d282-4509-a4ee-caababb75b38" :task-item/next {:db/id #edb/ref 17592186526464} :task-item/responses [{:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17