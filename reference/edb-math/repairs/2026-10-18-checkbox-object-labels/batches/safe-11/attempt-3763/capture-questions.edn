ld/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440314} {:answer-field/choices [{:answer/id #uuid "4cfb6205-7f60-523e-9e19-0a6c99cb1be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439915} {:answer/id #uuid "1132f5d8-3334-5ba6-860f-3020fef135aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439916}] :answer-field/correct {:answer/id #uuid "4cfb6205-7f60-523e-9e19-0a6c99cb1be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439915} :answer-field/id #uuid "47cda995-fd9f-589a-85d9-cfbd97013861" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440315} {:answer-field/choices [{:answer/id #uuid "405c5964-ed58-56db-a7d0-221666926760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439917} {:answer/id #uuid "7990ef8e-46b5-5559-a2c5-aa8d65421d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439918}] :answer-field/correct {:answer/id #uuid "405c5964-ed58-56db-a7d0-221666926760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439917} :answer-field/id #uuid "84892d33-55b9-54ef-a343-3de68b52e47d" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440316} {:answer-field/choices [{:answer/id #uuid "d182b83a-f3d7-59a8-a2df-a282497de34c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439919} {:answer/id #uuid "767b3c80-fc75-58d7-a96d-c20b801d7033" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439920}] :answer-field/correct {:answer/id #uuid "d182b83a-f3d7-59a8-a2df-a282497de34c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439919} :answer-field/id #uuid "71df9b88-565a-50cb-b76e-a7999233dce6" :answer-field/key "VI" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440317}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c503ae86-f71f-5a21-9c90-e19ce4d410a1" :question/math-academy-id "q-71474" :question/problem "Given that $f(x,y,z)=\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z$, find the points $(x,y,z)$ where $∇f(x,y,z)=0.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,-1,-1)$\n- **II.** $(-1,-1,1)$\n- **III.** $(-1,1,-1)$\n- **IV.** $(-1,1,1)$\n- **V.** $(1,-1,-1)$\n- **VI.** $(1,1,1)$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{{x}^{2}y}+0-\\frac{1}{z{x}^{2}}-0 \\\\  & =-\\frac{z+y}{{x}^{2}yz} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{x{y}^{2}}-\\frac{1}{{y}^{2}}+0-0 \\\\  & =-\\frac{1+x}{x{y}^{2}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =0+0-\\frac{1}{{z}^{2}x}-1 \\\\  & =-\\frac{1+{z}^{2}x}{{z}^{2}x}\\end{aligned}\n$$\n\nHence, $∇f(x,y,z)=-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k.$ \n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }k\\end{aligned}\n$$\n\nSo, by equating the coefficient of $i$, $j$, and $k$, we obtain:\n\n$$\n\\begin{cases}-\\frac{z+y}{{x}^{2}yz}=0 \\\\ -\\frac{1+x}{x{y}^{2}}=0 \\\\ -\\frac{1+{z}^{2}x}{{z}^{2}x}=0\\end{cases}\n$$\n\nFrom the second equation, we get $x=-1.$ Substituting these into the third equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{1+{z}^{2}x}{{z}^{2}x} & =0 \\\\ -\\frac{1+{z}^{2}(-1)}{{z}^{2}(-1)} & =0 \\\\ 1-{z}^{2} & =0 \\\\ {z}^{2} & =1 \\\\ z & =\\pm 1\\end{aligned}\n$$\n\nSubstituting $x=-1$ into the first equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{z+y}{(-1)^{2}yz} & =0 \\\\ z+y & =0 \\\\ y & =-z\\end{aligned}\n$$\n\nWhen $z=1,$ we have $y=-1$ and when $z=-1,$ we have $y=1.$\n\nHence, $∇f(x,y,z)=0$ at two points: $(-1,-1,1)$ and $(-1,1,-1).$"} {:db/id #edb/ref 17592186403509 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bba5ddca-29ae-5471-a6a4-993be5c996d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473266} {:answer/id #uuid "8369e458-effb-5b2b-b5d4-aba006c45804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473267}] :answer-field/correct {:answer/id #uuid "8369e458-effb-5b2b-b5d4-aba006c45804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473267} :answer-field/id #uuid "8863fa22-3b39-5e93-9963-14e8b851c92e" :answer-field/key "N" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474028} {:answer-field/choices [{:answer/id #uuid "60e26ea5-9f10-529e-82c8-1409cac8b2bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473268} {:answer/id #uuid "1749b0ec-a540-5a67-a5c4-d23285285ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473269}] :answer-field/correct {:answer/id #uuid "60e26ea5-9f10-529e-82c8-1409cac8b2bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473268} :answer-field/id #uuid "de8378a0-44cf-5391-92e6-89fe38fdd15b" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474029} {:answer-field/choices [{:answer/id #uuid "0e75c4be-b101-5f9d-baaf-856e7cc7d65f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473270} {:answer/id #uuid "b3e2e004-d50b-5230-b52c-79e97034086b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473271}] :answer-field/correct {:answer/id #uuid "0e75c4be-b101-5f9d-baaf-856e7cc7d65f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473270} :answer-field/id #uuid "ce016b55-73ba-587f-8f45-40784a020589" :answer-field/key "Z" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f5bb9d1-db59-54f4-aa53-0a0fa0a6f6c0" :question/math-academy-id "q-71935" :question/problem "Which of the matrices below are singular?\n\n$$\nN=\\begin{bmatrix}3 & 1 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}1 \\\\ 2 \\\\ -2 \\\\ 1 \\\\ -1\\end{bmatrix},\\,Z=\\begin{bmatrix}0 & 8 \\\\ 2 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "- For the matrix $N$, we have\n\n$$\ndet(N)=3\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $det(N)=0,$ we conclude that $N$ is not invertible. Since $N$ is a square matrix that is not invertible, we also say that $N$ is singular.\n\n- The matrix $V$ is a $5\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $Z$, we have\n\n$$\ndet(Z)=0\\cdot 0-2\\cdot 8=-16.\n$$\n\nBecause $det(Z)\\ne 0,$ we conclude that $Z$ is invertible.\n\nTherefore, only $N$ is singular."} {:db/id #edb/ref 17592186403516 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049548 :topic/id #uuid "fe796bc3-3471-557c-9aa6-b1f458fd2aba" :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1be0fb0-9847-565b-b3c1-581466264ba8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473272} {:answer/id #uuid "037b4724-2974-5573-821c-be931e428675" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473273}] :answer-field/correct {:answer/id #uuid "a1be0fb0-9847-565b-b3c1-581466264ba8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473272} :answer-field/id #uuid "94f2a2ea-24ce-5a7c-a465-8a604fac4939" :answer-field/key "T" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474031} {:answer-field/choices [{:answer/id #uuid "af46807b-2810-56be-88f8-06e3ecb337ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473274} {:answer/id #uuid "238549e7-3ff3-56c2-b10d-990ab4747696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473275}] :answer-field/correct {:answer/id #uuid "af46807b-2810-56be-88f8-06e3ecb337ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473274} :answer-field/id #uuid "b73a784d-7afb-5d08-b1c6-524d553bcf9d" :answer-field/key "U" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474032} {:answer-field/choices [{:answer/id #uuid "c234f526-26f2-5eb0-a6cf-173562472af2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473276} {:answer/id #uuid "aaad2947-e803-5417-9079-e397f4a8ca24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473277}] :answer-field/correct {:answer/id #uuid "aaad2947-e803-5417-9079-e397f4a8ca24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473277} :answer-field/id #uuid "775f56d7-7a83-56b8-89ed-384ecac6070a" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474033}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ff070848-777f-5635-9918-6da54f4ec8b2" :question/math-academy-id "q-71937" :question/problem "Which of the matrices below are singular?\n\n$$\nT=\\begin{bmatrix}5 & -8 & 7 & -6 \\\\ 1 & -2 & 3 & -4\\end{bmatrix},\\,U=\\begin{bmatrix}3 & -15 \\\\ -1 & 4\\end{bmatrix},\\,V=\\begin{bmatrix}6 & 3 \\\\ 10 & 5\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "- The matrix $T$ is a $2\\times 4$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $U$, we have\n\n$$\ndet(U)=3\\cdot 4-(-1)\\cdot (-15)=-3.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\n- For the matrix $V$, we have\n\n$$\ndet(V)=6\\cdot 5-10\\cdot 3=0.\n$$\n\nBecause $det(V)=0,$ we conclude that $V$ is not invertible. Since $V$ is a square matrix that is not invertible, we also say that $V$ is singular.\n\nTherefore, only $V$ is singular."} {:db/id #edb/ref 17592186403564 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither" :topic/_knowledge-points [{:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d251ac-d08a-5fc3-9ec4-e2a5e2493afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473284} {:answer/id #uuid "19c1a0ea-5caa-5890-ac0d-2d827757e556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473285}] :answer-field/correct {:answer/id #uuid "19c1a0ea-5caa-5890-ac0d-2d827757e556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473285} :answer-field/id #uuid "1a048736-62c4-5ae7-ba08-ddae3a27ddb4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474037} {:answer-field/choices [{:answer/id #uuid "d1618621-5371-566a-a49c-7a0f183b30ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473286} {:answer/id #uuid "481f5b87-9f73-537d-9816-151ef21cea64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473287}] :answer-field/correct {:answer/id #uuid "481f5b87-9f73-537d-9816-151ef21cea64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473287} :answer-field/id #uuid "e5e9f322-c387-5cd3-8b91-fdc3fbea85d1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474038} {:answer-field/choices [{:answer/id #uuid "797651e0-5145-583d-85ca-f9008b9eeba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473288} {:answer/id #uuid "a16652aa-2afa-5a37-aef1-bd72dd19254f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473289}] :answer-field/correct {:answer/id #uuid "797651e0-5145-583d-85ca-f9008b9eeba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473288} :answer-field/id #uuid "a3c77b81-b299-5de1-b94d-45a418effefa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d94b1132-4667-52b0-83fe-bd8235741b13" :question/math-academy-id "q-72345" :question/problem "Which of the following statements are true regarding the finite region bounded between the line $y=x$ and the curve $y={x}^{3},$ in the first quadrant?\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\ny={x}^{3}\\,⟹\\,x=\\sqrt[3]{y}.\n$$\n\nNow, let's sketch our region.\n\n![](images/1d/1d1c1cbe30e6f612f824adc76d712a98194ffccc5edefc11cccdaf07204513ba.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le x\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt[3]{y}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"} :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186446081} :db/id #edb/ref 17592186446092}]} {:db/id #edb/ref 17592186403578 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4674279d-e3ea-5539-9cbc-34d7c71e17c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473290} {:answer/id #uuid "5f279552-7726-5666-87a0-a65e4d4cc9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473291}] :answer-field/correct {:answer/id #uuid "5f279552-7726-5666-87a0-a65e4d4cc9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473291} :answer-field/id #uuid "f4cb54d6-3a14-513f-8ad1-f5148424eee1" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474040} {:answer-field/choices [{:answer/id #uuid "6eea1b41-2bae-5e9f-8965-b073070a70d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473292} {:answer/id #uuid "a80e64bb-feff-50eb-a4f4-619c22aa833b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473293}] :answer-field/correct {:answer/id #uuid "6eea1b41-2bae-5e9f-8965-b073070a70d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473292} :answer-field/id #uuid "5e6054d8-ba8f-57c8-bb59-fabe4ae171da" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474041} {:answer-field/choices [{:answer/id #uuid "11cd364f-a07d-56b8-b694-0582874d8d3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473294} {:answer/id #uuid "d31078fc-19f3-593d-a925-42910ad64906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473295}] :answer-field/correct {:answer/id #uuid "d31078fc-19f3-593d-a925-42910ad64906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473295} :answer-field/id #uuid "83121e2f-2376-5ba8-a5f4-fd94050eb0d8" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474042}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "307a31ed-3320-5bc6-9033-1067b69032de" :question/math-academy-id "q-72491" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{43}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{bmatrix}\n$$\n\nTherefore, only $A$ and $C$ are **not** in row echelon form."} {:db/id #edb/ref 17592186403585 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db004ed2-ed81-5217-88ac-e52284d7ad3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473296} {:answer/id #uuid "002f6cc8-519c-547f-b765-dd76618c0b6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473297}] :answer-field/correct {:answer/id #uuid "db004ed2-ed81-5217-88ac-e52284d7ad3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473296} :answer-field/id #uuid "f127a0d3-e90a-58f9-8f2b-6e15c5df7965" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474043} {:answer-field/choices [{:answer/id #uuid "a2148234-bd1e-5fc0-8d51-841be04cafc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473298} {:answer/id #uuid "cce1e8ef-95aa-5cbe-8fcc-0e3c07df9260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473299}] :answer-field/correct {:answer/id #uuid "a2148234-bd1e-5fc0-8d51-841be04cafc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473298} :answer-field/id #uuid "15583ac9-f686-5248-9d7b-2d9435ac31bd" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474044} {:answer-field/choices [{:answer/id #uuid "7e393702-fa0d-5833-91a4-009529a56bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473300} {:answer/id #uuid "6b014640-d4fa-53b6-b967-987f231f0e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473301}] :answer-field/correct {:answer/id #uuid "6b014640-d4fa-53b6-b967-987f231f0e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473301} :answer-field/id #uuid "b2967199-fd81-5b0d-b35c-cae9b4782fc5" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba6bcd83-87df-5c0b-b121-63a0ff1205ca" :question/math-academy-id "q-72492" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{22}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}\n$$\n\nTherefore, only $C$ is **not** in row echelon form."} {:db/id #edb/ref 17592186403647 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither" :topic/_knowledge-points [{:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979 :topic/title "Type I and II Regions in Two-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db64764-98eb-5367-886f-33b324a9214a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473308} {:answer/id #uuid "7f0ff128-e5e1-50ea-8e47-b9e5ae3e0b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473309}] :answer-field/correct {:answer/id #uuid "1db64764-98eb-5367-886f-33b324a9214a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473308} :answer-field/id #uuid "89893083-1925-5c2b-90e5-c9adaba718f9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474049} {:answer-field/choices [{:answer/id #uuid "0dc8ce0d-097d-5ce1-b462-4947b26914f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473310} {:answer/id #uuid "2a96ce7b-6e8b-5a64-8a7a-90e984e28216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473311}] :answer-field/correct {:answer/id #uuid "0dc8ce0d-097d-5ce1-b462-4947b26914f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473310} :answer-field/id #uuid "904ecfbb-f462-5a7b-8006-329fe576e8eb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474050} {:answer-field/choices [{:answer/id #uuid "27a7ac9f-414b-5de1-8820-105f493fe970" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473312} {:answer/id #uuid "e869a60a-bd5e-5590-a53f-789d43379715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473313}] :answer-field/correct {:answer/id #uuid "e869a60a-bd5e-5590-a53f-789d43379715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473313} :answer-field/id #uuid "ec3ecf07-ff0d-544e-9e14-5cec0b49a0d7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474051}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "964e90c7-3ddc-59ef-9c19-6cc6da31e561" :question/math-academy-id "q-73552" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $(x-1)^{2}+4{y}^{2}=1$ and ${x}^{2}+4{y}^{2}=4?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/21/215dd0c920e700a75896fc54751ec20d197487a2c992cd8910810c66129c14dc.png)\n\nWe have the following:\n\n- The vertical line $x=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/7e/7e1a0c5dd2b4aadf7efe78d903234b8d00cf4fa92eb7a3b41209a856f2d14b01.png)\n\n- The horizontal line $y=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/a9/a90d7306e3f88a31609e368f9362248d6a12b7922b6a9e8c9f980ab31e7fb140.png)\n\nTherefore, only statement III is true."} {:db/id #edb/ref 17592186403787 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent" :topic/_knowledge-points [{:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733 :topic/title "Gaussian Elimination For NxM Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438514} {:answer/id #uuid "72c05b38-661e-55ef-b895-991dd965f68d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438515}] :answer-field/correct {:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438514} :answer-field/id #uuid "d5f63264-b18f-5fb9-8709-61b443e3ce15" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439286} {:answer-field/choices [{:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438516} {:answer/id #uuid "0cfc1f4e-c211-54e2-8df0-f80bdf080bed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438517}] :answer-field/correct {:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438516} :answer-field/id #uuid "a0678042-ac90-54b5-926f-6259f946ee55" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439287} {:answer-field/choices [{:answer/id #uuid "c32dbf70-7f15-517a-9383-074f32bf4f01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438518} {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438519}] :answer-field/correct {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438519} :answer-field/id #uuid "98fa2d2a-8e07-54bb-bb31-70f2215b776f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8971116-e24d-5808-9b29-a50e168511e5" :question/math-academy-id "q-74634" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-y &=-1 \\\\ 2x-4y &=3 \\\\ x+y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n\n- **II.** The system has a unique solution\n\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we will first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & \\frac{3}{2} & \\frac{5}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & 0 & \\frac{9}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=\\frac{9}{2},$ and it has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186403864 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049220 :topic/id #uuid "e46861d7-4b7a-5813-a6e8-914206606355" :topic/math-academy-id 1565 :topic/title "Elementary Trigonometric Equations Containing Secant"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acd031f-ce15-5c91-b73f-5f31e4bb1899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473332} {:answer/id #uuid "f667985d-d48c-5f2b-94e8-6e61ef5fd588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473333}] :answer-field/correct {:answer/id #uuid "f667985d-d48c-5f2b-94e8-6e61ef5fd588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473333} :answer-field/id #uuid "0b29fd12-66cc-595b-934f-f11eb10c7aed" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474061} {:answer-field/choices [{:answer/id #uuid "f8ffa324-af68-5895-a079-04ac45e6