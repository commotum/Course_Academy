6473426} {:answer/id #uuid "ac914ea6-d76c-5ffe-bcd2-cdb587ee9678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473427}] :answer-field/correct {:answer/id #uuid "a8e433b6-43ce-5e1b-a7c8-ad9306558803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473426} :answer-field/id #uuid "77db2363-4339-5281-bb25-6dd26c42fa43" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c2e3f55-ea9b-5b9e-badf-26b9e5d93c01" :question/math-academy-id "q-80384" :question/problem "![](images/b0/b0a08488ba59344033205903ca973870d0b10837295ced970bf307342e6f7241.png)\n\nWhich of the following statements are true regarding the function $f:[-3,3]\\to [-3,0]$ whose graph is shown above?\n\n- $f(-3)=f(3)$\n- $∀\\,{x}_{1},{x}_{2}\\in [-3,3],$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is an injection\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. According to the graph, we have $f(-3)=f(3)=0.$\n\n- Statement II is false. Again, we have $f(-3)=f(3)$ but $-3\\ne 3.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $[-3,3],$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is false. Indeed, since statement II is false, $f$ is not an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is \"I only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186051035 :topic/id #uuid "7c0a3263-cc36-57b6-839b-6ff5594cae61" :topic/math-academy-id 2678 :topic/title "Injections"} :activity/title "Injections" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407855} :db/id #edb/ref 17592186407891}]} {:db/id #edb/ref 17592186407889 :knowledge-point/_questions [{:db/id #edb/ref 17592186152196 :knowledge-point/id #uuid "a347133c-5e5a-5dd2-89ef-bdd14245ee6b" :knowledge-point/title "Identifying Injections For Functions Defined on the Set of Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186051035 :topic/id #uuid "7c0a3263-cc36-57b6-839b-6ff5594cae61" :topic/math-academy-id 2678 :topic/title "Injections"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2c29d1e-6a71-5a2b-9207-175266e9f0a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473416} {:answer/id #uuid "ad465e70-567d-5d4c-b486-b4b289256ae4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473417}] :answer-field/correct {:answer/id #uuid "f2c29d1e-6a71-5a2b-9207-175266e9f0a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473416} :answer-field/id #uuid "8acda064-7e39-560e-a976-7d967bc557bc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474103} {:answer-field/choices [{:answer/id #uuid "5fc875d8-5208-5b0d-a170-d502605bcd90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473418} {:answer/id #uuid "d55f5921-9bdf-51a5-9635-da02ad1b37fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473419}] :answer-field/correct {:answer/id #uuid "d55f5921-9bdf-51a5-9635-da02ad1b37fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473419} :answer-field/id #uuid "13e0236f-cc20-53bb-b712-8b098c3617d4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474104} {:answer-field/choices [{:answer/id #uuid "345cdf7e-550b-5e3d-b83b-320d18379e78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473420} {:answer/id #uuid "696eeb35-6a02-5604-8e86-344ab522fba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473421}] :answer-field/correct {:answer/id #uuid "696eeb35-6a02-5604-8e86-344ab522fba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473421} :answer-field/id #uuid "90f68307-4853-500d-b43e-b3e760f1eca0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474105}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58fa3eda-7303-530c-b266-fd43b4b16a9f" :question/math-academy-id "q-80370" :question/problem "![](images/7c/7c2f22af3b39c28d885ac490aae190e1b2d4ad55828a552fec031069d6d912a2.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\n- $f(0)=f(1)$\n- $∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is **one-to-one**\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. According to the graph, we have $f(0)=0$ and $f(1)=1.$\n\n- Statement II is true. As we can see from the graph, it passes the horizontal line test, meaning that there are no two distinct elements within $R$ that map to the same element in $R.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $R,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is true, $f$ is an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is \"II and III only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186051035 :topic/id #uuid "7c0a3263-cc36-57b6-839b-6ff5594cae61" :topic/math-academy-id 2678 :topic/title "Injections"} :activity/title "Injections" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407855} :db/id #edb/ref 17592186407890}]} {:db/id #edb/ref 17592186408038 :knowledge-point/_questions [{:db/id #edb/ref 17592186192801 :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF" :topic/_knowledge-points [{:db/id #edb/ref 17592186048532 :topic/id #uuid "a7907bdb-038e-5baa-a4ae-df7b362e291b" :topic/math-academy-id 4100 :topic/title "Continuous Random Variables Over Infinite Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abd3b4ad-7245-5359-aa08-f555f6155e8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453466} {:answer/id #uuid "cdfa7c36-5307-50a0-bf63-41b72cb111a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453467}] :answer-field/correct {:answe