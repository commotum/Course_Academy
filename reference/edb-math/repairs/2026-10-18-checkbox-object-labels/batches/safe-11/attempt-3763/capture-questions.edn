/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473390} {:answer/id #uuid "fc230375-393b-59e9-881c-e1dc86f27d29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473391}] :answer-field/correct {:answer/id #uuid "90f31dbd-3161-57f6-a8fa-37cec703fe4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473390} :answer-field/id #uuid "7a38ae81-8d40-5e8f-ad84-7cf8d41e0b85" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abd84654-ac2d-58a6-9574-529f2b4aa6f5" :question/math-academy-id "q-78597" :question/problem "Which of the following integers belong to the residue class $[-7]_{11}?$\n\nI. $15$\n\nII. $-4$\n\nIII. $7$\n\nSelect all that apply." :question/worked-solution "The residue class $[-7]_{11}$ consists of the elements that are congruent to $-7$ modulo $11.$ So, we have\n\n$$\n\\begin{aligned}[-7]_{11} & =\\{x\\in Z\\,|\\,x≡-7\\,(\\text{mod}\\,11)\\} \\\\  & =\\{x\\in Z\\,|\\,x=-7+11k,\\,k\\in Z\\} \\\\  & =\\{-7+11k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,-7-2\\cdot 11,\\,-7-11,\\,-7,\\,-7+11,\\,-7+2\\cdot 11,\\,…\\} \\\\  & =\\{…,-29,-18,-7,4,15,…\\}.\\end{aligned}\n$$\n\nWe see that $15$ belongs to $[-7]_{11},$ while $-4$ and $7$ do not.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186412975 :knowledge-point/_questions [{:db/id #edb/ref 17592186152098 :knowledge-point/id #uuid "9c1fe7ea-d91e-5440-b756-37a460a18f19" :knowledge-point/title "Identifying Residue Classes Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "755751ed-eb2f-5baa-977d-50e0cf4d1cab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473494} {:answer/id #uuid "f84e8c37-3c47-5019-bbd8-6aba66d56fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473495}] :answer-field/correct {:answer/id #uuid "755751ed-eb2f-5baa-977d-50e0cf4d1cab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473494} :answer-field/id #uuid "a8d1353b-d90a-5d11-a780-4eccdd5887e5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474142} {:answer-field/choices [{:answer/id #uuid "bfd97ab7-f65e-5746-a234-f9cc32fd2b7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473496} {:answer/id #uuid "67612c18-343f-5697-b45a-be10d24a76b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473497}] :answer-field/correct {:answer/id #uuid "67612c18-343f-5697-b45a-be10d24a76b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473497} :answer-field/id #uuid "f38f2e94-e42d-5ee7-b528-ea68585f7bae" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474143} {:answer-field/choices [{:answer/id #uuid "90bb2df1-1fda-574f-bafa-6b48d209310b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473498} {:answer/id #uuid "43196550-f13f-560d-b156-66c622c38634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473499}] :answer-field/correct {:answer/id #uuid "43196550-f13f-560d-b156-66c622c38634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473499} :answer-field/id #uuid "604bcfdf-cd10-583b-8001-b9796116f704" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474144}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1a9f6cf-cd8d-55d6-a82c-4176e7807557" :question/math-academy-id "q-86027" :question/problem "Which of the following residue classes modulo $10$ contain the integer $-4?$\n\nI. $[4]_{10}$\n\nII. $[-14]_{10}$\n\nIII. $[6]_{10}$\n\nSelect all that apply." :question/worked-solution "We have $-4\\in [a]_{10}$ if \n\n$$\n-4≡a\\,(\\text{mod}\\,10).\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $-4\\notin [4]_{10}$ because $-4≢4\\,(\\text{mod}\\,10)$ $\\,\\times $\n\n- $-4\\in [-14]_{10}$ because $-4≡-14\\,(\\text{mod}\\,10)$ $\\,✓$\n\n- $-4\\in [6]_{10}$ because $-4≡6\\,(\\text{mod}\\,10)$ $\\,✓$\n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186412976 :knowledge-point/_questions [{:db/id #edb/ref 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class" :topic/_knowledge-points [{:db/id #edb/ref 17592186050597 :topic/id #uuid "574a92ea-12bd-55d4-a248-945298d922a1" :topic/math-academy-id 2655 :topic/title "Residue Classes"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2989d3f5-e299-5e13-bb8a-b7064a9233d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473482} {:answer/id #uuid "6c9cdab6-aa49-55e9-8afe-7c6732a14f3a" :answer/type {:db/id #edb/ref 17592186045499 :