t} :answer/value "false" :db/id #edb/ref 17592186473234} {:answer/id #uuid "ba048084-4a5b-5ba4-a6f7-256f4eaa2a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473235}] :answer-field/correct {:answer/id #uuid "6b2ea28d-150d-554d-864f-0de6f3ae280f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473234} :answer-field/id #uuid "706d3a7f-ac71-5f66-9b96-e64e194462fb" :answer-field/key "Y" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0fa1b96-0701-5539-993f-8523f6af2e59" :question/math-academy-id "q-68745" :question/problem "Which of the following are diagonal matrices?\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$S=\\begin{bmatrix}4 & 0 & 0 & 0 \\\\ 0 & 3 & 0 & 0 \\\\ 0 & 0 & 4 & 0 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 3\\end{bmatrix}$</div>\n</div>\n\nSelect all that apply." :question/worked-solution "- $S$ is a diagonal matrix. It's a square matrix since it has the same number of rows and columns. Also, all the entries that do not lie on the main diagonal are zeros.\n\nNotice that $S$ is not an identity matrix since the diagonal entries are not all ones.\n\n- $R$ is *not* a diagonal matrix since it's not a square matrix.\n\n- $Y$ is *not* a diagonal matrix. It's a square matrix since it has the same number of rows and columns. But some of the entries that do not lie on the main diagonal are not zeros (for instance, ${y}_{31}=1\\ne 0$).\n\nTherefore, only $S$ is a diagonal matrix."} {:db/id #edb/ref 17592186403328 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186048896 :topic/id #uuid "ca183854-66cd-5b1f-9d29-03785c3216b8" :topic/math-academy-id 861 :topic/title "Introduction to Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a277476a-4a31-5ac1-b6c7-53eea4ca0936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438460} {:answer/id #uuid "3350a00f-9f20-5211-8919-6e15063d5ff5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438461}] :answer-field/correct {:answer/id #uuid "a277476a-4a31-5ac1-b6c7-53eea4ca0936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438460} :answer-field/id #uuid "a550dea0-a4e6-5f5f-a1fc-30beac9c5b2e" :answer-field/key "F" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439259} {:answer-field/choices [{:answer/id #uuid "7e13d414-9501-58ff-9f76-68853278a29e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438462} {:answer/id #uuid "46bbd3c8-690e-5402-854a-c49d24a96bcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438463}] :answer-field/correct {:answer/id #uuid "46bbd3c8-690e-5402-854a-c49d24a96bcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438463} :answer-field/id #uuid "eeffc4dc-ec3b-5e9c-91ff-12acade49e5b" :answer-field/key "G" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439260} {:answer-field/choices [{:answer/id #uuid "9e43