9537073 17592186576411 true] [17592186452847 1077 "IV" 13194139537073 17592186576411 false] [17592186452848 1077 "$C$ is closed under function addition" 13194139537073 17592186576411 true] [17592186452848 1077 "I" 13194139537073 17592186576411 false] [17592186452849 1077 "$C$ is closed under scalar multiplication" 13194139537073 17592186576411 true] [17592186452849 1077 "II" 13194139537073 17592186576411 false] [17592186452850 1077 "$C$ is a subspace of $C[0,1]$" 13194139537073 17592186576411 true] [17592186452850 1077 "III" 13194139537073 17592186576411 false] [17592186452851 1077 "$C$ is **not** a subspace of $C[0,1]$" 13194139537073 17592186576411 true] [17592186452851 1077 "IV" 13194139537073 17592186576411 false] [17592186452852 1077 "$E$ is closed under function addition" 13194139537073 17592186576411 true] [17592186452852 1077 "I" 13194139537073 17592186576411 false] [17592186452853 1077 "$E$ is closed under scalar multiplication" 13194139537073 17592186576411 true] [17592186452853 1077 "II" 13194139537073 17592186576411 false] [17592186452854 1077 "$E$ is a subspace of $C[-2,2]$" 13194139537073 17592186576411 true] [17592186452854 1077 "III" 13194139537073 17592186576411 false] [17592186452855 1077 "$E$ is **not** a subspace of $C[-2,2]$" 13194139537073 17592186576411 true] [17592186452855 1077 "IV" 13194139537073 17592186576411 false] [17592186452856 1077 "I" 13194139537073 17592186576411 false] [17592186452856 1077 "The constant function $f(x)=1$ for all $x\\in R$ belongs to $N.$" 13194139537073 17592186576411 true] [17592186452857 1077 "For any $f(t),g(t)\\in N,$ we have $f(t)-g(t)=g(t)-f(t).$" 13194139537073 17592186576411 true] [17592186452857 1077 "II" 13194139537073 17592186576411 false] [17592186452858 1077 "III" 13194139537073 17592186576411 false] [17592186452858 1077 "The addition of functions in $N$ is commutative." 13194139537073 17592186576411 true] [17592186452859 1077 "I" 13194139537073 17592186576411 false] [17592186452859 1077 "The zero-polynomial belongs to $F.$" 13194139537073 17592186576411 true] [17592186452860 1077 "For the zero polynomial $0$ and any $p(x)\\in F,$ we have $p(x)+0=p(x).$" 13194139537073 17592186576411 true] [17592186452860 1077 "II" 13194139537073 17592186576411 false] [17592186452861 1077 "III" 13194139537073 17592186576411 false] [17592186452861 1077 "There are polynomials $p(x),q(x)\\in F$ such that $p(x)+q(x)\\ne q(x)+p(x).$" 13194139537073 17592186576411 true] [17592186452865 1077 "For any $A\\in R,$ we have $1\\cdot A=A.$" 13194139537073 17592186576411 true] [17592186452865 1077 "I" 13194139537073 17592186576411 false] [17592186452866 1077 "For any $A\\in R,$ we have $-1(-1\\cdot A)=-A.$" 13194139537073 17592186576411 true] [17592186452866 1077 "II" 13194139537073 17592186576411 false] [17592186452867 1077 "For any $A\\in R$ and $\\alpha ,\\beta \\in R$, we have $(\\alpha +\\beta )A=\\alpha A+\\beta A.$" 13194139537073 17592186576411 true] [17592186452867 1077 "III" 13194139537073 17592186576411 false] [17592186452871 1077 "$2x\\in T.$" 13194139537073 17592186576411 true] [17592186452871 1077 "I" 13194139537073 17592186576411 false] [17592186452872 1077 "II" 13194139537073 17592186576411 false] [17592186452872 1077 "The scalar multiplication of polynomials in $T$ is associative." 13194139537073 17592186576411 true] [17592186452873 1077 "For any $p(x)\\in T$ and $\\alpha ,\\beta \\in R$, we have $(\\alpha +\\beta )p(x)=\\alpha p(x)+\\beta p(x).$" 13194139537073 17592186576411 true] [17592186452873 1077 "III" 13194139537073 17592186576411 false] [17592186452874 1077 "For any $p(x)\\in U$ and $\\alpha ,\\beta \\in R$, we have $\\alpha (\\beta p(x))=(\\alpha \\beta )p(x).$" 13194139537073 17592186576411 true] [17592186452874 1077 "I" 13194139537073 17592186576411 false] [17592186452875 1077 "II" 13194139537073 17592186576411 false] [17592186452875 1077 "Multiplication by $1$ does not change elements in $U.$" 13194139537073 17592186576411 true] [17592186452876 1077 "For any $p(x)\\in U$ and $\\alpha ,\\beta \\in R$, we have $(\\alpha +\\beta )p(x)=\\alpha p(x)+\\beta p(x).$" 13194139537073 17592186576411 true] [17592186452876 1077 "III" 13194139537073 17592186576411 false] [17592186452877 1077 "$R(x)=8{x}_{1}{x}_{2}$ is positive-definite" 13194139537073 17592186576411 true] [17592186452877 1077 "I" 13194139537073 17592186576411 false] [17592186452878 1077 "$S(x)={x}^{T}\\,\\begin{bmatrix}-2 & 0 \\\\ 0 & -5\\end{bmatrix}x$ is negative-definite" 13194139537073 17592186576411 true] [17592186452878 1077 "II" 13194139537073 17592186576411 false] [17592186452879 1077 "$T(x)={x}_{1}^{2}+6{x}_{2}^{2}$ is indefinite" 13194139537073 17592186576411 true] [17592186452879 1077 "III" 13194139537073 17592186576411 false] [17592186452880 1077 "${v}_{2}$ is a linear combination of ${v}_{1},$ ${v}_{3},$ and ${v}_{4}$" 13194139537073 17592186576411 true] [17592186452880 1077 "I" 13194139537073 17592186576411 false] [17592186452881 1077 "${x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has only zero solution ${x}_{2}={x}_{3}={x}_{4}=0$" 13194139537073 17592186576411 true] [17592186452881 1077 "II" 13194139537073 17592186576411 false] [17592186452882 1077 "$\\{{v}_{1},{v}_{2},{v}_{3},{v}_{4}\\}$ is a linearly independent set" 13194139537073 17592186576411 true] [17592186452882 1077 "III" 13194139537073 17592186576411 false] [17592186452883 1077 "${{v}_{1}+{v}_{2},{v}_{1}+{v}_{3},{v}_{2}}$ is linearly independent" 13194139537073 17592186576411 true] [17592186452883 1077 "I" 13194139537073 17592186576411 false] [17592186452884 1077 "${{v}_{1}-{v}_{2},{v}_{2}-{v}_{1}}$ is linearly independent" 13194139537073 17592186576411 true] [17592186452884 1077 "II" 13194139537073 17592186576411 false] [17592186452885 1077 "${{v}_{2},{v}_{3}}$ is linearly independent" 13194139537073 17592186576411 true] [17592186452885 1077 "III" 13194139537073 17592186576411 false] [17592186452886 1077 "${{v}_{1}-{v}_{2},{v}_{2}-{v}_{3},{v}_{3}-{v}_{1}}$ is linearly independent" 13194139537073 17592186576411 true] [17592186452886 1077 "I" 13194139537073 17592186576411 false] [17592186452887 1077 "${2{v}_{1},{v}_{2},3{v}_{3}}$ is linearly independent" 13194139537073 17592186576411 true] [17592186452887 1077 "II" 13194139537073 17592186576411 false] [17592186452888 1077 "${{v}_{1},{v}_{2}}$ is linearly dependent" 13194139537073 17592186576411 true] [17592186452888 1077 "III" 13194139537073 17592186576411 false] [17592186452889 1077 "I" 13194139537073 17592186576411 false] [17592186452889 1077 "The eigenvalues of $A$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=5$" 13194139537073 17592186576411 true] [17592186452890 1077 "${x}^{T}\\,A\\,x$ is positive-definite" 13194139537073 17592186576411 true] [17592186452890 1077 "II" 13194139537073 17592186576411 false] [17592186452891 1077 "$A$ is indefinite" 13194139537073 17592186576411 true] [17592186452891 1077 "III" 13194139537073 17592186576411 false] [17592186452892 1077 "${a}_{11}=-3$ and $det(A)=2$" 13194139537073 17592186576411 true] [17592186452892 1077 "I" 13194139537073 17592186576411 false] [17592186452893 1077 "${x}^{T}\\,A\\,x$ is negative-definite" 13194139537073 17592186576411 true] [17592186452893 1077 "II" 13194139537073 17592186576411 false] [17592186452894 1077 "$A$ is negative-definite" 13194139537073 17592186576411 true] [17592186452894 1077 "III" 13194139537073 17592186576411 false] [17592186452895 1077 "${a}_{11}=6$ and $det(A)=17$" 13194139537073 17592186576411 true] [17592186452895 1077 "I" 13194139537073 17592186576411 false] [17592186452896 1077 "${x}^{T}\\,A\\,x$ is positive-definite" 13194139537073 17592186576411 true] [17592186452896 1077 "II" 13194139537073 17592186576411 false] [17592186452897 1077 "$A$ is negative-definite" 13194139537073 17592186576411 true] [17592186452897 1077 "III" 13194139537073 17592186576411 false] [17592186452898 1077 "${a}_{11}=-5$ and $det(A)>0$" 13194139537073 17592186576411 true] [17592186452898 1077 "I" 13194139537073 17592186576411 false] [175921864