r.type/text} :answer/value "true" :db/id #edb/ref 17592186467943 :task-item/_responses [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "3d389fe9-b790-5945-910d-6661d44a7238" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ddf8ccb-f483-5bbe-8662-ef5250ea89a5" :question/math-academy-id "q-72489" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are **not** in row echelon form." :task-item/_content [{:db/id #edb/ref 17592186526389 :task-item/content {:db/id #edb/ref 17592186339126} :task-item/elapsed-seconds 16.434 :task-item/id #uuid "992a4a62-4d41-4f7a-b794-5156808e508e" :task-item/next {:db/id #edb/ref 17592186526390} :task-item/responses [{:answer/id #uuid "23b28d03-cd57-5d78-8671-e5c1d46ed665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467938} {:answer/id #uuid "b4308405-a8a5-56c9-af60-06c16d1d14d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467941} {:answer/id #uuid "3369f3e3-6e3d-5e75-b2a8-d84fac360cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467943}] :task-item/status {:db/id #edb/ref 17592186045571}}]} {:db/id #edb/ref 17592186339127 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aad04b9e-e1c0-5bb1-8988-f13ae2b12a53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467944} {:answer/id #uuid "182256c0-eed4-5308-8899-646442169606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467945}] :answer-field/correct {:answer/id #uuid "aad04b9e-e1c0-5bb1-8988-f13ae2b12a53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467944} :answer-field/id #uuid "e337cd9d-13a4-5dac-9234-3d41da87d9a0" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468693} {:answer-field/choices [{:answer/id #uuid "0777136a-d863-5438-b95f-bc866c333a22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467946} {:answer/id #uuid "96cecc84-650b-5579-bf1d-d6d830e791b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467947}] :answer-field/correct {:answer/id #uuid "96cecc84-650b-5579-bf1d-d6d830e791b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467947} :answer-field/id #uuid "a790397a-6735-5a19-8785-3d13a0ca79b8" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468694} {:answer-field/choices [{:answer/id #uuid "72991cce-897b-580a-82d9-a6ea9e4374ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467948} {:answer/id #uuid "44145af0-fb61-51cd-b673-1a7fef08d8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467949}] :answer-field/correct {:answer/id #uuid "72991cce-897b-580a-82d9-a6ea9e4374ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467948} :answer-field/id #uuid "05c578b4-fa57-5327-837b-e40c8423b3ba" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "937eaf0d-76e6-56ec-a651-23458856322a" :question/math-academy-id "q-72498" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$  is not in row echelon form since ${a}_{32}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=\\begin{bmatrix}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}\n$$\n\nTherefore, only $B$ is in row echelon form."} {:db/id #edb/ref 17592186341835 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7311cb50-f585-5f8b-8c7c-4