2186468601} {:answer-field/choices [{:answer/id #uuid "f9cafb59-0b24-588f-9bcb-424a9f69dc54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467762} {:answer/id #uuid "6c0fc1a7-5a2a-527a-85ed-2cc301299690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467763}] :answer-field/correct {:answer/id #uuid "6c0fc1a7-5a2a-527a-85ed-2cc301299690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467763} :answer-field/id #uuid "ce948b10-c87c-53ef-a62d-acb627747432" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02825ca8-1217-5576-a207-9808ead9dee4" :question/math-academy-id "q-66012" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n- **I.** $\\operatorname{sec}⁡x=1$\n- **II.** $\\operatorname{sec}⁡x=5$\n- **III.** $\\operatorname{sec}⁡x=-\\frac{1}{4}$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."} {:db/id #edb/ref 17592186335885 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1d4299d-351a-5fe9-a670-073cc9e5de38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438368} {:answer/id #uuid "fa255a93-20e8-54e8-97be-3ba846492184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438369}] :answer-field/correct {:answer/id #uuid "fa255a93-20e8-54e8-97be-3ba846492184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438369} :answer-field/id #uuid "9f1aeed1-5d5d-55f5-b47f-ad533ff3c9e9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439213} {:answer-field/choices [{:answer/id #uuid "98321251-a137-534c-9fe9-52d7da6b8d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438370} {:answer/id #uuid "9af520a8-05f9-5db2-8313-3ee23294d164" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438371}] :answer-field/correct {:answer/id #uuid "9af520a8-05f9-5db2-8313-3ee23294d164" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438371} :answer-field/id #uuid "ba5de37a-efe1-5701-9c49-2975bdd66304" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439214} {:answer-field/choices [{:answer/id #uuid "20ea6006-9ee8-51ed-af73-840f5ecd72e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438372} {:answer/id #uuid "5b63ac11-cd0e-537a-9f3c-14ff4d9d34c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438373}] :answer-field/correct {:answer/id #uuid "5b63ac11-cd0e-537a-9f3c-14ff4d9d34c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438373} :answer-field/id #uuid "938f0d88-c3f0-572a-a97c-94e4a874dfb3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2712841f-ac1b-5d69-a817-019e60c121da" :question/math-academy-id "q-66483" :question/problem "Given that $f(x)=1-x,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,\\infty )$\n- **II.** $x\\in (0,\\infty )$\n- **III.** $x\\in (-2,2)$" :question/worked-solution "The function $f(x)$ is a linear function with slope $-1$ and $y$-intercept $1,$ as shown below.\n\n![](images/73/73d9277c040ae457ba6d96e162574edbeeef965d181fa6011ca4ab0e4644bd82.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on $x\\in (0,\\infty )$ and $x\\in (-2,2).$\n\nTherefore, the correct answer is \"I, II, and III\"."} {:db/id #edb/ref 17592186335893 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d7d582-0e08-5fe3-8e62-df514f329d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438406} {:answer/id #uuid "41998fef-2e26-54fe-acf9-a5788490ab47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438407}] :answer-field/correct {:answer/id #uuid "41998fef-2e26-54fe-acf9-a5788490ab47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438407} :answer-field/id #uuid "b0378409-4fc6-5ebd-a16b-b9ce526ffed5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439232} {:answer-field/choices [{:answer/id #uuid "bd89e6d4-4284-5cef-ad54-c1065cbfd742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438408} {:answer/id #uuid "9f2c5391-3de3-59c1-a286-2ed065c30bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438409}] :answer-field/correct {:answer/id #uuid "bd89e6d4-4284-5cef-ad54-c1065cbfd742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438408} :answer-field/id #uuid "5868dcf2-b093-50db-b08d-7add6f5064eb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439233} {:answer-field/choices [{:answer/id #uuid "f1e919a5-9466-584c-b9bd-7477e3370765" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438410} {:answer/id #uuid "a16d2f7b-c0fb-5e81-8da1-26bc5ef53cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438411}] :answer-field/correct {:answer/id #uuid "a16d2f7b-c0fb-5e81-8da1-26bc5ef53cef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438411} :answer-field/id #uuid "d36afc1b-e6be-563c-8f1f-8a95a433bde4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439234}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26ae354c-e4a4-50d9-b820-8ba146650b10" :question/math-academy-id "q-66669" :question/problem "Given that $f(x)=(x-2)^{2},$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (2,\\infty )$\n\n- **II.** $x\\in (-1,5)$\n\n- **III.** $x\\in (-\\infty ,2]$" :question/worked-solution "The graph of the function $f(x)=(x-2)^{2},$ can be obtained in the following way:\n\n1\\. Take the curve $y={x}^{2}.$\n\n2\\. Translate it by $2$ units  to  the right  $f(x)=(x-2)^{2}.$\n\n![](images/1e/1e3ac550e35a3dc93b3e26e5834f763847b04f5133de02e368124f54dd2b9dd6.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-1,5).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/3e/3ebb316ca122b6786b8ef501fc7c56f8e0e68c8cfc32e5801c493d38382fc26c.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in (2,\\infty )$  and $x\\in (-\\infty ,2].$  On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/86/86c7c9cacc7a3868565f33130563ffed0ca423aa087e76cc08d103ea171822ed.png)\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186335899 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72a9977b-4906-5466-8a2e-080981fbbc3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438412} {:answer/id #uuid "bffb12a2-2512-535f-a05a-93d1ecd5edbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438413}] :answer-field/correct {:answer/id #uuid "bffb12a2-2512-535f-a05a-93d1ecd5edbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438413} :answer-field/id #uuid "6cb31fe6-c55b-53f4-9367-7623acd76b6c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439235} {:answer-field/choices [{:answer/id #uuid "cb16cbba-9564-553b-b9ec-711aa8dbca6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438414} {:answer/id #uuid "b93a4fce-89ce-58fb-80e2-43edf373bb3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438415}] :answer-field/correct {:answer/id #uuid "b93a4fce-89ce-58fb-80e2-43edf373bb3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438415} :answer-field/id #uuid "6db6c671-dedf-53e0-be3f-fcd379f0e138" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439236} {:answer-field/choices [{:answer/id #uuid "b379a802-24be-59ce-b981-52720b5955d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438416} {:answer/id #uuid "c0459670-ed37-5d93-b901-b40e7e54aeca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438417}] :answer-field/correct {:answer/id #uuid "b379a802-24be-59ce-b981-52720b5955d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438416} :answer-field/id #uuid "ade1d675-9ef4-50ee-b050-c20ae72bdedc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb9d3e2-6b9a-5fb3-b64e-0b7d921759d9" :question/math-academy-id "q-66679" :question/problem "Given that $f(x)=(x-1)^{2}-2,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,1]$\n\n- **II.** $x\\in (1,\\infty )$\n\n- **III.** $x\\in (-1,3]$" :question/worked-solution "The graph of the function $f(x)=(x-1)^{2}-2$ can be obtained in the following way:\n\n1\\. Take the curve $y={x}^{2}.$\n\n2\\. Translate it by $1$ units to the right,  to get $y=(x-1)^{2}.$\n\n3\\. Finally, translate $y=(x-1)^{2}$  by $2$ units down to get $f(x)=(x-1)^{2}-2.$\n\n![](images/f5/f53a4f97166877085c90acc01e3f8d0c6ac7bb3f704bbfb792d747122d314013.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on each of the intervals $x\\in (-\\infty ,1]$ and $x\\in (1,\\infty ).$ On these intervals, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/b0/b088c8ed1974a7c259dd54f85aec7a124579981971babfe8dee0313ca23b6458.png)\n\n  \n\n- The function $f(x)$ is not invertible on the interval $x\\in (-1,3].$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/b3/b3af13782a01213bb09fdeef38fbeb3fbca3f41348036e6786b4efa74a0166b4.png)\n\n \n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186335901 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ff36d03-5cc0-5d73-83c4-e624a390bbc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438418} {:answer/id #uuid "530329fb-ce87-5e84-b072-5a38f2ebf633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438419}] :answer-field/correct {:answer/id #uuid "530329fb-ce87-5e84-b072-5a38f2ebf633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438419} :answer-field/id #uuid "919e5c28-bbf2-5c80-b2d5-d434d820a43f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439238} {:answer-field/choices [{:answer/id #uuid "d13bb14f-1c20-5e94-8700-4dbd1f20f1b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438420} {:answer/id #uuid "78447fbd-2164-5eac-8c2b-44e4dc612b4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438421}] :answer-field/correct {:answer/id #uuid "d13bb14f-1c20-5e94-8700-4dbd1f20f1b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438420} :answer-field/id #uuid "358639a5-54d9-573f-8827-054bd466e1e6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439239} {:answer-field/choices [{:answer/id #uuid "38e632a0-32b1-57b2-ba0b-ca870495c039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438422} {:answer/id #uuid "361ecb6e-6cba-52c2-866f-654d5b3bf821" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438423}] :answer-field/correct {:answer/id #uuid "38e632a0-32b1-57b2-ba0b-ca870495c039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438422} :answer-field/id #uuid "02fe17af-c7ed-530c-9d35-2b5a79dc67c3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439240}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1120070d-b929-5ac5-a6ba-244a40b57b70" :question/math-academy-id "q-66687" :question/problem "Given that $f(x)=-{x}^{2}+1,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,0]$\n- **II.** $x\\in (-2,2]$\n- **III.** $x\\in (-2,\\infty )$" :question/worked-solution "The graph of the function $f(x)=-{x}^{2}+1$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Reflect its graph across  the $x$-axis to get $y=-{x}^{2}.$\n\n- Finally, translate $y=-{x}^{2}$  by $1$ unit up to  get $f(x)=-{x}^{2}+1.$\n\n![](images/83/83a9f5966c76b89b2cad9c6244e2e447fb0052fc7f946df954df76265628c4a7.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n*The function $f(x)$ is invertible on the interval $x\\in (-\\infty ,0].$ On this interval, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/f6/f694b6b1bc979289b748758385e05575990bd866457e75a84fbf7bdf335c03b9.png)\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-2,2].$ On this interval, some horizontal lines will intersect the curve more than once. Since  $(-2,2]$ is a subset of $(-2,\\infty )$, our function is not invertible on $x\\in (-2,\\infty )$ either.\n\n![](images/c0/c03118f3fd0193910b49e26ab5ea56e4320fd23583feb3267cd4442d0a157583.png)\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186335903 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cefd8d5e-1289-5ad1-914c-ab2775321488" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438436} {:answer/id #uuid "b576a8c1-7ea3-5fa1-8acc-832863849d14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438437}] :answer-field/correct {:answer/id #uuid "b576a8c1-7ea3-5fa1-8acc-832863849d14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438437} :answer-field/id #uuid "8ca5f16c-d2d5-56cb-9b50-6ad3cade9608" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439247} {:answer-field/choices [{:answer/id #uuid "befc7759-bd31-5c8e-9555-3cb0dd101a77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438438} {:answer/id #uuid "43259996-4978-511c-985e-68d25446c510" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438439}] :answer-field/correct {:answer/id #uuid "43259996-4978-511c-985e-68d25446c510" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438439} :answer-field/id #uuid "f6c11a88-ed6a-52c6-9f46-d560f8833eee" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439248} {:answer-field/choices [{:answer/id #uuid "43a190ae-1ab7-5e97-aea2-ab2e9632fae0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438440} {:answer/id #uuid "18ea5186-8355-5092-9c9e-79cb796117a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438441}] :answer-field/correct {:answer/id #uuid "18ea5186-8355-5092-9c9e-79cb796117a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438441} :answer-field/id #uuid "1a5a0d91-6853-5fb1-88df-fb42944cb144" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02e022db-b323-5e31-af64-39f79b6a6465" :question/math-academy-id "q-66725" :question/problem "Given that $f(x)=-x+3,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,\\infty )$\n\n- **II.** $x\\in (0.5,\\infty )$\n\n- **III.** $x\\in [-3,\\sqrt{2}]$" :question/worked-solution "The function $f(x)$ is a linear function with slope $-1$ and $y$-intercept $3,$ as shown below. \n\n![](images/aa/aaa05d1ab0fd630dacd81723fe00472cb901fb6f73af5f111f44459476191c0f.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (0.5,\\infty )$ and $x\\in [-3,\\sqrt{2}].$\n\nTherefore, the correct answer is \"I, II, and III\"."} {:db/id #edb/ref 17592186335904 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc2ebd76-b3da-51ec-9bb6-c0a8d8726a21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438442} {:answer/id #uuid "ed90097f-008e-5903-8afb-166e0fb732b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438443}] :answer-field/correct {:answer/id #uuid "ed90097f-008e-5903-8afb-166e0fb732b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438443} :answer-field/id #uuid "cb140f0c-688c-52f8-a90f-9018b950a280" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439250} {:answer-field/choices [{:answer/id #uuid "efd9c021-33f1-5537-af5a-c438ea2991ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438444} {:answer/id #uuid "4d46b3e2-aa3f-52ac-bda8-6b775f310423" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438445}] :answer-field/correct {:answer/id #uuid "4d46b3e2-aa3f-52ac-bda8-6b775f310423" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438445} :answer-field/id #uuid "5614c87c-6ed3-55e6-95b6-98e904f5c5d1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439251} {:answer-field/choices [{:answer/id #uuid "73ccc799-d970-5891-a63d-3482846a277e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438446} {:answer/id #uuid "52ff3f43-d7ba-5b03-a6cf-148b6c9c461e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438447}] :answer-field/correct {:answer/id #uuid "73ccc799-d970-5891-a63d-3482846a277e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438446} :answer-field/id #uuid "404e5779-63f4-5bb6-b2a6-acf55f92288b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439252}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ee60b09-63e9-5076-abae-7337fc233de5" :question/math-academy-id "q-66729" :question/problem "Given that $f(x)=|x-1|-2,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,1]$\n\n- **II.** $x\\in (1,\\infty )$\n\n- **III.** $x\\in (-\\infty ,2]$" :question/worked-solution "The graph of the function $f(x)=|x-1|-2$ can be obtained in the following way:\n\n1\\. Take the curve $y=|x|.$\n\n2\\. Translate it by $1$ units to the right,  to get $y=|x-1|.$\n\n3\\. Finally, translate $y=|x-1|$ by $2$ units down to get $f(x)=|x-1|-2.$\n\n![](images/75/753840da17642582f9dbc0debc18f1fa3efcbbb11142894c1dd823ad6c0c630a.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on each of the intervals $x\\in (-\\infty ,1]$ and $x\\in (1,\\infty ).$ On these intervals, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/15/15f1c797cbddd2ac8e2e9c5be72f842e7d1accfc5f619af57b1f35a27e1015c0.png)\n\n  \n\n- The function $f(x)$ is not invertible on the interval $x\\in (-\\infty ,2].$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/a1/a100489b49da7b06c98783b1b1c4ec0de9d891fc2b22f4b36b1a0ac2d54fc4f3.png)\n\nTherefore, the correct answer is \"I  and II only\"."} {:db/id #edb/ref 17592186335906 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e58af68f-eae1-53c6-9223-c7c0080b2c78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438448} {:answer/id #uuid "5371e2e8-a318-5761-84cf-2a344ab71943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438449}] :answer-field/correct {:answer/id #uuid "e58af68f-eae1-53c6-9223-c7c0080b2c78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438448} :answer-field/id #uuid "1aab5ce5-7c11-54ef-9873-01b2782d09cb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439253} {:answer-field/choices [{:answer/id #uuid "af8f6888-4ad1-59e7-bb89-aa5f77d9746f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438450} {:answer/id #uuid "aeb5ab9d-c02f-5f8d-ae8c-1482c9a4f08b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438451}] :answer-field/correct {:answer/id #uuid "aeb5ab9d-c02f-5f8d-ae8c-1482c9a4f08b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438451} :answer-field/id #uuid "5211022b-a915-5d40-8743-afe759a8dd9a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439254} {:answer-field/choices [{:answer/id #uuid "64cbf680-9981-52b0-97b5-fea787285feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438452} {:answer/id #uuid "557bf5d6-ae71-5f3d-acc6-c84051652a1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438453}] :answer-field/correct {:answer/id #uuid "557bf5d6-ae71-5f3d-acc6-c84051652a1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438453} :answer-field/id #uuid "ac161744-e926-5973-8bfb-6bbc90ec7d60" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439255}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7aa0547e-3ef1-575a-ba36-cf93ffa1c8dc" :question/math-academy-id "q-66778" :question/problem "Given that $f(x)=|x+1|-3,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,1]$\n- **II.** $x\\in [1,\\infty )$\n- **III.** $x\\in (-\\infty ,-1]$" :question/worked-solution "The graph of the function $f(x)=|x+1|-3$ can be obtained in the following way:\n\n- Take the curve $y=|x|.$\n\n- Translate it by $1$ units to the left,  to get $y=|x+1|.$\n\n- Finally, translate $y=|x+1|$ by $3$ units down to get $f(x)=|x+1|-3.$\n\n![](images/3b/3b9f56280089991c7db7652d84a777edd5c5e012921f0d48362f4fc3e4fd2a6e.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on each of the intervals $x\\in (-\\infty ,-1]$ and $x\\in [1,\\infty ).$ On these intervals, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/fd/fd0b0fe70e009f43e80b0f712b6cfd576deb4c4c0457f61adae04cf7e44f140c.png)\n\n  \n\n- The function $f(x)$ is not invertible on the interval $x\\in (-\\infty ,1].$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/58/582ec1960b053731bf201c84d8c58fd4e1734a2b085cd5549a01aace4b600b4a.png)\n\n \n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186335966 :knowledge-point/_questions [{:db/id #edb/ref 17592186087695 :knowledge-point/id #uuid "ddb59990-7419-585f-aa1b-901d59c8cfc1" :knowledge-point/title "Identifying a Zero Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048252 :topic/id #uuid "8c876864-a853-56d6-a887-91d7f8f1cf14" :topic/math-academy-id 862 :topic/title "Zero, Square, Diagonal and Identity Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092e6e39-62e1-5a0d-a93c-5ac81888a407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467764 :task-item/_responses [{:db/id #edb/ref 17592186567268 :task-item/content {:db/id #edb/ref 17592186335966} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "5e95dcb3-8237-54f7-a277-58c6618eb31c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467765}] :answer-field/correct {:answer/id #uuid "092e6e39-62e1-5a0d-a93c-5ac81888a407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467764 :task-item/_responses [{:db/id #edb/ref 17592186567268 :task-item/content {:db/id #edb/ref 17592186335966} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "dbd47159-e0bc-5765-a055-a94e61becd1b" :answer-field/key "T" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468603} {:answer-field/choices [{:an