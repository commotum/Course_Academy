35-d760-5912-b3d6-73fe2e8a7fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467744} :answer-field/id #uuid "e9bc1cf2-47b2-5636-8818-b4c2215358af" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468593}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25f01585-64f3-568e-9920-38b4cd0acafa" :question/math-academy-id "q-65991" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n- **I.** $(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6})$\n- **II.** $(0,0)$\n- **III.** $(-1,\\frac{\\pi }{3})$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},-\\frac{1}{\\sqrt{3}})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(0,0).$ We note the following:\n\n- The point $(0,0)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=0$ lies within this range. $\\,✓$\n\nTherefore, the point $(0,0)$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-1,\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},-1)$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(-1,\\frac{\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"} {:db/id #edb/ref 17592186335870 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049656 :topic/id #uuid "08bc988d-9fd4-51b9-b9a1-01573e3679f4" :topic/math-academy-id 1487 :topic/title "Graphing the Inverse Tangent Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c8ce2de-6acd-5eee-a7f7-86b7b0defa87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467746} {:answer/id #uuid "b8a11fe6-7938-5b94-bd6c-0382de6b4167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467747}] :answer-field/correct {:answer/id #uuid "b8a11fe6-7938-5b94-bd6c-0382de6b4167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467747} :answer-field/id #uuid "9ee02da6-8f97-5cd3-b80e-fc016445b3ba" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468594} {:answer-field/choices [{:answer/id #uuid "010b619d-865d-593e-bd64-c95f0b0c0362" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467748} {:answer/id #uuid "774e38d1-2f7d-5c97-bd41-aae4c7260d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :an