nowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/id #uuid "9d6972e8-70d1-541f-8fd7-7896e8369046" :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2beeb9c0-a0f7-572f-9461-8e4a373a720e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467980} {:answer/id #uuid "8f043ab9-4eb5-5c9b-b6ba-57dc17b4f7be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467981}] :answer-field/correct {:answer/id #uuid "2beeb9c0-a0f7-572f-9461-8e4a373a720e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467980} :answer-field/id #uuid "89241bf3-239b-53f8-b59f-0a2ba3f4cd35" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468711} {:answer-field/choices [{:answer/id #uuid "88e8dcc9-31ef-506a-8f36-3d6b6e08f6b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467982} {:answer/id #uuid "773a74ae-25e4-54cf-9507-ad7eedc154bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467983}] :answer-field/correct {:answer/id #uuid "773a74ae-25e4-54cf-9507-ad7eedc154bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467983} :answer-field/id #uuid "b1d12bf6-21a8-5597-91ee-a2d42bf3235a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db