dcc-a52396a7b645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467955} :answer-field/id #uuid "4691ceca-21a9-5d3f-be55-1f587cc36770" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468698}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f7d9000-6b1e-59bb-84e6-86f972afc228" :question/math-academy-id "q-72570" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{cccc|c}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{cccc|c}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{array}\\right]\n$$\n\n- The matrix $B$  is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{cccc|c}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{cccc|c}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186341837 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "871c0b9a-48a3-59d8-9e1f-f4475d4555bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467956} {:answer/id #uuid "b4d10848-e1fa-5f39-aa0a-cc7c26df2128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467957}] :answer-field/correct {:answer/id #uuid "b4d10848-e1fa-5f39-aa0a-cc7c26df2128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467957} :answer-field/id #uuid "61fe29b2-5b2d-5a8d-b1ba-4952d616468e" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468699} {:answer-field/choices [{:answer/id #uuid "4548ec32-611e-56d6-95ac-253399d8a77e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467958} {:answer/id #uuid "23eb05ce-32cd-5f44-bc7f-be463167a91d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467959}] :answer-field/correct {:answer/id #uuid "23eb05ce-32cd-5f44-bc7f-be463167a91d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467959} :answer-field/id #uuid "d56f52cb-9c78-584a-9dbb-7b23b1d89ddd" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468700} {:answer-field/choices [{:answer/id #uuid "468e9b34-a780-5fca-a56d-a2a2883f4d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467960} {:answer/id #uuid "a0aec6ac-9ba7-5c44-9c4a-8f2c4061212f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467961}] :answer-field/correct {:answer/id #uuid "468e9b34-a780-5fca-a56d-a2a2883f4d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467960} :answer-field/id #uuid "f3a4e593-82f4-562c-a9f7-3bfab9eb0154" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c409d434-4c7f-59fa-9d55-4c82bc621cc5" :question/math-academy-id "q-72574" :question/problem "Which of the following augmented matrices have coefficient matrices in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\n$$\nA=\\left[\\begin{array}{cccc|c}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied). \n\n$$\nA=\\left[\\begin{array}{cccc|c}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{ccc|c}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{array}\\right]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition  II is violated).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."} {:db/id #edb/ref 17592186341838 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186048980 :topic/id #uuid "d0f342d9-c70c-537f-9e04-f3b0beaf9c01" :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60637292-3e09-530b-ac61-fcbbce897d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467962} {:answer/id #uuid "e4dad7c2-9a72-5985-95d5-14eb19840971" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467963}] :answer-field/correct {:answer/id #uuid "60637292-3e09-530b-ac61-fcbbce897d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467962} :answer-field/id #uuid "bf03a675-2be