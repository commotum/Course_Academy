n/worked-solution "Graphs I and II are strictly monotone and pass the horizontal line test. Graphs III and IV each meet some horizontal line twice. There are four graphs, so all four labels are represented."} {:db/id #edb/ref 17592186125018 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a81cac-c158-5783-a483-6ff152ce8402" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439651} {:answer/id #uuid "42daca65-452a-55e0-9f61-39d7c2db68d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439652}] :answer-field/correct {:answer/id #uuid "42daca65-452a-55e0-9f61-39d7c2db68d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439652} :answer-field/id #uuid "cbaa5052-a72b-5b98-b51e-90609adfddc0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440183} {:answer-field/choices [{:answer/id #uuid "e20e9770-acba-561c-b3c6-986ee3d60f50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439653} {:answer/id #uuid "1c7138f1-0c5f-5149-a2d1-5a0a38eee3f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439654}] :answer-field/correct {:answer/id #uuid "e20e9770-acba-561c-b3c6-986ee3d60f50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text}