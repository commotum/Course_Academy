55a6-8173-f4bb51d2485b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471298}] :answer-field/correct {:answer/id #uuid "7c48180b-ef91-55a6-8173-f4bb51d2485b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471298} :answer-field/id #uuid "a7526d36-196d-56b8-94dc-a37daca6a4b7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5cba8b56-135d-52f2-8f27-ede5f8ef30f6" :question/math-academy-id "q-183619" :question/problem "$$\n∃{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in R,\\,2-{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}={w}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $x$ is *bound* since it's placed right next to the quantifier $∃:$\n\n$$\n∃\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,2-x=w\n$$\n\n- Occurrence II of the variable $x$ is *bound* since it lies within the scope of the quantifier $∃x$ that uses $x:$\n\n$$\n∃\\,x\\in R,\\,\\overbrace{2-{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}=w}^{\\text{scope of }∃x}\n$$\n\n- Occurrence III of the variable $w$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $w.$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∃{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,2-{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}={w}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\n$$\n\nTherefore, the free occurrence is \"III only.\""} {:db/id #edb/ref 17592186390212 :knowledge-point/_questions [{:db/id #edb/ref 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables" :topic/_knowledge-points [{:db/id #edb/ref 17592186050691 :topic/id #uuid "5f607ed3-b581-5e92-9101-c32dd179ab13" :topic/math-academy-id 2792 :topic/title "Nested Quantifiers"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f71a22-fc9f-552f-a9d9-a46f8dcfc90d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471299} {:answer/id #uuid "117e231e-8623-5e21-a59b-11496fbded59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471300}] :answer-field/correct {:answer/id #uuid "27f71a22-fc9f-552f-a9d9-a46f8dcfc90d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471299} :answer-field/id #uuid "b6c83e2c-3e5c-5076-8593-19b655c11223" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472155} {:answer-field/choices [{:answer/id #uuid "27230c26-6810-56a0-8bd7-ff8d43922f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471301} {:answer/id #uuid "114c9caf-15ed-5900-b23a-3372178c16fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471302}] :answer-field/correct {:answer/id #uuid "114c9caf-15ed-5900-b23a-3372178c16fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471302} :answer-field/id #uuid "6665bd07-59a9-5629-865d-a495f3ad2954" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472156} {:answer-field/choices [{:answer/id #uuid "1b7d0231-205c-56fd-9ea2-2ddb3e99793c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471303} {:answer/id #uuid "44987af5-9d26-5f40-b084-bcb86291212a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471304}] :answer-field/correct {:answer/id #uuid "1b7d0231-205c-56fd-9ea2-2ddb3e99793c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471303} :answer-field/id #uuid "4054af6c-64c2-5da3-8ab1-f1c077741993" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55254c80-6a13-5f2c-a4bb-f9bcddde8c2a" :question/math-academy-id "q-183649" :question/problem "$$\n∃\\,\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in Z,\\,{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}\\,|\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $m$ is *bound* since it's placed right next to the quantifier $∃:$\n\n$$\n∃\\,\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,n\\,|\\,m\n$$\n\n- Occurrence II of the variable $n$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $n.$\n\n- Occurrence III of the variable $m$ is *bound* since it lies within the scope of the quantifier $∃m$ that uses $m:$\n\n$$\n∃\\,\\,m\\in Z,\\,\\,\\overbrace{n\\,|\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}}^{\\text{scope of }∃m}\n$$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∃\\,\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\\,|\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\n$$\n\nTherefore, the free occurrence is \"II only.\""} {:db/id #edb/ref 17592186400944 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves" :topic/_knowledge-points [{:db/id #edb/ref 17592186049011 :topic/id #uuid "d33f7a90-b31c-5a5d-bdc7-84de678b50eb" :topic/math-academy-id 363 :topic/title "Intervals of Concavity"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55bb18bb-6b7e-5829-82a6-e18f9e4c28da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472724} {:answer/id #uuid "4df2726d-bc97-5a20-8554-8facd0fbf540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472725}] :answer-field/correct {:answer/id #uuid "55bb18bb-6b7e-5829-82a6-e18f9e4c28da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472724} :answer-field/id #uuid "edbc19a7-bfac-5d47-9ebd-142e9709d2cf" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473757} {:answer-field/choices [{:answer/id #uuid "f738f7ee-862e-528c-8a81-a14e41c9d755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472726} {:answer/id #uuid "3ee91d30-eadd-53b8-9a6b-0b97f4bd6970" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472727}] :answer-field/correct {:answer/id #uuid "3ee91d30-eadd-53b8-9a6b-0b97f4bd6970" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472727} :answer-field/id #uuid "cfedab04-db13-5dc7-8df3-d2f4595de507" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473758} {:answer-field/choices [{:answer/id #uuid "6f6e862f-1ffd-5d05-9b1b-41238c86bf23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472728} {:answer/id #uuid "40a49c9e-10d7-5a33-b2e8-9726cbf89631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472729}] :answer-field/correct {:answer/id #uuid "6f6e862f-1ffd-5d05-9b1b-41238c86bf23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472728} :answer-field/id #uuid "dae1ad91-a56c-5582-b5c7-c4af4f618586" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473759}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9955f0fd-f850-5637-ae70-443f1b225d5d" :question/math-academy-id "q-141738" :question/problem "![](images/7d/7d2f7497d6a11b4ceb994755498ef49bf0ce414601ab812dc55555c769a076ec.png)\n\nWhich of the curves above are concave up?\n\nSelect all that apply." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graph II curves upward (like a \"smile\") among the given graphs."} {:db/id #edb/ref 17592186400951 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves" :topic/_knowledge-points [{:db/id #edb/ref 17592186049011 :topic/id #uuid "d33f7a90-b31c-5a5d-bdc7-84de678b50eb" :topic/math-academy-id 363 :topic/title "Intervals of Concavity"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ee7beb8-8183-5fcc-b3ed-7ccd0eb5b0c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472730} {:answer/id #uuid "3bcf409d-d61f-5bdc-bb97-fb97a398f2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472731}] :answer-field/correct {:answer/id #uuid "3bcf409d-d61f-5bdc-bb97-fb97a398f2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472731} :answer-field/id #uuid "f22881e5-62c5-5d07-9716-5509ef72f3d8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473760} {:answer-field/choices [{:answer/id #uuid "db52a2ab-aa70-5898-8933-7a56ce48172e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472732} {:answer/id #uuid "b15b7f3e-8d4d-52f8-8e29-53439c349c57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472733}] :answer-field/correct {:answer/id #uuid "db52a2ab-aa70-5898-8933-7a56ce48172e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472732} :answer-field/id #uuid "7f0d3d30-bd5e-5491-a435-b642d53d7f0d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473761} {:answer-field/choices [{:answer/id #uuid "29f3b31a-8fee-5b18-8d8b-c80e6e46252c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472734} {:answer/id #uuid "1fd1a6c7-e25e-5d80-a180-d75f79495cfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472735}] :answer-field/correct {:answer/id #uuid "1fd1a6c7-e25e-5d80-a180-d75f79495cfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472735} :answer-field/id #uuid "32870185-8fb3-5995-ba2e-b8d84d9ba6a2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473762}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8be6241f-30ce-53dd-8d31-e6a859245baf" :question/math-academy-id "q-141740" :question/problem "![](images/2f/2f07f2751398a101b41bc2c923fcdd7f6a5144da00008904297c36b2d8d44a30.png)\n\nWhich of the curves above are concave up?\n\nSelect all that apply." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graphs I and III curve upward (like a \"smile\") among the given graphs."} {:db/id #edb/ref 17592186402516 :knowled