db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477207} :answer-field/id #uuid "fae5ae97-5a74-5251-b85f-fe579c7a5170" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477573}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18613fbc-efad-5e39-8673-d89aa94c710c" :question/math-academy-id "q-236888" :question/problem "![](images/10/102620aa55d15a8c07dc8224fd4de06d91cbd2abbbde6ee812df85a4862dc566.png)\n\nWhich of the above polygons are complex?\n\nSelect all that apply." :question/worked-solution "A polygon is **simple** if its boundary does not intersect itself. Otherwise, the polygon is called **complex**.\n\nAmong the given polygons, only polygon II has intersecting sides. \n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186110929 :knowledge-point/_questions [{:db/id #edb/ref 17592186110675 :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/title "Identifying Collinear Points on a Grid" :topic/_knowledge-points [{:db/id #edb/ref 17592186049892 :topic/id #uuid "1c2006c0-c4c4-5ff8-8fa2-7f9dd3693f49" :topic/math-academy-id 1500 :topic/title "Collinear Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7afd290-acc0-55c6-998c-768cd7580391" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477145} {:answer/id #uuid "6bfad2eb-0602-548b-9e77-506210b3bc85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477146}] :answer-field/correct {:answer/id #uuid "6bfad2eb-0602-548b-9e77-506210b3bc85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477146} :answer-field/id #uuid "8e823520-ee6e-57c6-8866-ce7228855732" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477542} {:answer-field/choices [{:answer/id #uuid "230de8f6-d07e-5dba-8bcc-a3b9c8b2125d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477147} {:answer/id #uuid "8e5146f6-0447-5fc5-bd68-f40aecec77f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477148}] :answer-field/correct {:answer/id #uuid "230de8f6-d07e-5dba-8bcc-a3b9c8b2125d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477147} :answer-field/id #uuid "a3bcafbf-d3e7-5c54-9da4-95aaae9dbd92" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477543} {:answer-field/choices [{:answer/id #uuid "d20b0e0d-f3a1-50f1-9b8e-686d5326c162" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477149} {:answer/id #uuid "c6bfc265-5ff0-51aa-b51f-40156f7ba1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477150}] :answer-field/correct {:answer/id #uuid "c6bfc265-5ff0-51aa-b51f-40156f7ba1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477150} :answer-field/id #uuid "d716b6f3-8e54-5ea0-9948-1e07367c1482" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477544}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ea9e0d7-7c8f-5224-8f6f-e5c31c36ab4a" :question/math-academy-id "q-155503" :question/problem "![](images/bb/bb96a7692787ca6e055b41d4f1599b87baa1ea331544ea42235a7131343c76e3.png)\n\nWhich of the diagrams above shows three collinear points?\n\nSelect all that apply." :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/54/54735541d4dfc424fe186ddabe0c3f9d3cbd45a0dc7a1b8f4551cf8c5e5bc14f.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/f0/f00f882c97fd201178e54f29151a48a4f41d4108cf375104cc338e968c55761b.png)\n\n- Diagram III shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/6e/6e0c0320775d93364e32655d1e09081382078fa7e96fbe621a8c558f63dfcabb.png)\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186124814 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049676 :topic/id #uuid "0a177390-6525-5d0c-8721-f7f75db39408" :topic/math-academy-id 1945 :topic/title "Global vs. Local Extrema and Critical Points of Multivariable Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bc876d5-f44a-5998-985c-5ffee4f76b67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477171} {:answer/id #uuid "77d03628-028e-52ab-8003-a110d2ad4fd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477172}] :answer-field/correct {:answer/id #uuid "77d03628-028e-52ab-8003-a110d2ad4fd2" :answer/type {:db/id #edb/ref 1759218604549