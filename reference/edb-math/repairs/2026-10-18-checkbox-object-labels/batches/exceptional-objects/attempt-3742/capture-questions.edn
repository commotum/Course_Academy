db/id #edb/ref 17592186469165} :answer-field/id #uuid "8df6bed7-94ed-5467-9b40-5bdc5c2235df" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470194} {:answer-field/choices [{:answer/id #uuid "e4f23960-532d-56dc-a2f0-3689d73fd744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469166} {:answer/id #uuid "8756a38a-dd41-5cd2-9f7e-889679dc1f2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469167}] :answer-field/correct {:answer/id #uuid "e4f23960-532d-56dc-a2f0-3689d73fd744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469166} :answer-field/id #uuid "fb5533c3-5e75-59ef-898a-e61b052fc950" :answer-field/key "Z" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c87cce5-2762-52a9-b3ea-307f7f887046" :question/math-academy-id "q-80332" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\pi $ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- The number $\\pi $ is not an integer, so it does *not* belong to $Z$ nor to $N,$ so we can write\n\n$$\n\\pi \\notin N,\\,\\pi \\notin Z.\n$$\n\n- Also, notice that $\\pi =3.14159\\,…\\,$ can not be written as the ratio of two integers, so it does *not* belong to $Q$ either, and we can write \n\n$$\n\\pi \\notin Q.\n$$\n\n- Every irrational number is both a real number and a complex number. Consequently, $\\pi $ belongs to both $R$ and $C,$ and we can write\n\n$$\n\\pi \\in R,\\,\\pi \\in C.\n$$\n\nTherefore, the correct answer is \"$R$ and $C$ only.\""} {:db/id #edb/ref 17592186362290 :knowledge-point/_questions [{:db/id #edb/ref 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves" :topic/_knowledge-points [{:db/id #edb/ref 17592186048655 :topic/id #uuid "b2c456e2-ef0a-5a75-95da-68bb5f61da4a" :topic/math-academy-id 3356 :topic/title "Simple, Closed, and Oriented Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b56df147-449a-5ae1-aa90-5d246df31e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469890} {:answer/id #uuid "df4aa174-0436-5464-a847-a5fdf50dec44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469891}] :answer-field/correct {:answer/id #uuid "b56df147-449a-5ae1-aa90-5d246df31e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469890} :answer-field/id #uuid "04750c82-c645-5c04-95c3-42d1924b2c67" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470557} {:answer-field/choices [{:answer/id #uuid "8cccafca-dfed-599a-aa20-1e6bf9896088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469892} {:answer/id #uuid "0e7165f4-d564-5873-886b-c132deff4b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #