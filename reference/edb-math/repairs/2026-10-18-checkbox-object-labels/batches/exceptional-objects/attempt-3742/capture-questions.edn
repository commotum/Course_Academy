text} :answer/value "true" :db/id #edb/ref 17592186474491} :answer-field/id #uuid "76568b59-f8c4-581e-85ed-5e14756744a2" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475171} {:answer-field/choices [{:answer/id #uuid "cd6b6c04-84a9-511c-8310-10083e79aea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474492} {:answer/id #uuid "6ea4d2c9-21d8-5a4f-8d97-47b992f3f9e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474493}] :answer-field/correct {:answer/id #uuid "cd6b6c04-84a9-511c-8310-10083e79aea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474492} :answer-field/id #uuid "0d56e51e-e4fa-5823-909b-8976120daa89" :answer-field/key "D" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475172}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9cc186b-22af-55d8-bf89-1dd19ae7b90f" :question/math-academy-id "q-164154" :question/problem "![](images/81/81604581fae8b25776727eca4450caa7d48c42a781706455ed585d5cfc4a25fa.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?\n\nSelect all that apply." :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch regions exist for the points $A$ and $C.$ Hence $A$ and $C$ are local maximum points.\n\n**Note**: For the point $A({x}_{A},{y}_{A},{z}_{A}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{A},{y}_{A})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\le f(a,b)$, the point $A$ does satisfy the conditions for a local maximum.\n\n![](images/36/3651b43178819666002775a26071a0bd2c9cb48b58a3c5516c38e085d50fc4a6.png)"} {:db/id #edb/ref 17592186513099 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "708a0bd6-cff7-58a7-b12b-8c2c6f7c6ecc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513125} {:answer/id #uuid "bd4818e9-ffff-5320-97a4-36bafb40f059" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513155}] :answer-field/correct {:answer/id #uuid "bd4818e9-ffff-5320-97a4-36bafb40f059" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513155} :answer-field/id #uuid "3622d97b-5226-58d5-9e67-20ff43def90b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186513105} {:answer-field/choices [{:answer/id #uuid "07081e6b-5b48-5d7b-aa0c-02968b5e3cfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186513092} {:answer/id #uuid "be6ec870-3dfa-56bb-b0b4-3883abd44faa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186513156}] :answer-field/correct {:answer/id #uuid "07081e6b-5b48-5d7b-aa0c-029