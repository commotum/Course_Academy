value "true" :db/id #edb/ref 17592186469155}] :answer-field/correct {:answer/id #uuid "f4bfa532-1538-5cca-8f2d-4d47f5143f4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469155} :answer-field/id #uuid "781c4ab4-096e-5a73-a81c-698082947273" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470189} {:answer-field/choices [{:answer/id #uuid "fd664d00-d639-529d-a5dd-793d6aa1dfaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469156} {:answer/id #uuid "cda1bb7c-b498-5d5f-a232-2e431d827287" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469157}] :answer-field/correct {:answer/id #uuid "cda1bb7c-b498-5d5f-a232-2e431d827287" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469157} :answer-field/id #uuid "e1493005-7319-5887-8360-d89429b14963" :answer-field/key "Z" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470190}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39280445-a454-56b4-bdba-1c7ee371d8c7" :question/math-academy-id "q-80331" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $-\\frac{27}{3}$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- The number $-\\frac{27}{3}=-9$ is negative, so it does *not* belong to $N,$ and we can write\n\n$$\n-\\frac{27}{3}\\notin N.\n$$\n\n- However, $-9$ is an integer, so it does belong to $Z,$ and we can write\n\n$$\n-\\frac{27}{3}\\in Z.\n$$\n\n- Every integer is a rational, real, and complex number. Consequently, $-\\frac{27}{3}$ belongs to $Q,R,$ and $C,$ and we can write\n\n$$\n-\\frac{27}{3}\\in Q,\\,-\\frac{27}{3}\\in R,\\,-\\frac{27}{3}\\in C.\n$$\n\nTherefore, the correct answer is \"$Z,Q,R,$ and $C$ only.\""} {:db/id #edb/ref 17592186348365 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0287e786-d236-580b-9444-d30f44500fe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469158} {:answer/id #uuid "1452ce32-c055-5da5-8242-a6dd44cbabe8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469159}] :answer-field/correct {:answer/id #uuid "1452ce32-c055-5da5-8242-a6dd44cbabe8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469159} :answer-field/id #uuid "4c5bf6ea-3b62-5a7e-a810-4b2cb9743b3d" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470191} {:answer-field/choices [{:answer/id #uuid "2bcc843e-d5df-542e-804d-6506118ad688" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id