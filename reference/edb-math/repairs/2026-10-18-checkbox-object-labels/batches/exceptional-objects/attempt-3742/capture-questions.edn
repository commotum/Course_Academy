5a37-be7e-527fce11e249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460254}] :answer-field/correct {:answer/id #uuid "20d9338f-cf53-5a37-be7e-527fce11e249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460254} :answer-field/id #uuid "0acab227-c554-5371-86d8-2548c636c47d" :answer-field/key "Z" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460993}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb3a08e1-046c-5655-8701-2c4bac14eb96" :question/math-academy-id "q-80234" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $-5$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- The number $-5$ is negative, so it does *not* belong to $N,$ and we can write\n\n$$\n-5\\notin N.\n$$\n\n- However, $-5$ is an integer, so it does belong to $Z,$ and we can write\n\n$$\n-5\\in Z.\n$$\n\n- Every integer is a rational, real, and complex number. Consequently, $-5$ belongs to $Q,R,$ and $C,$ and we can write\n\n$$\n-5\\in Q,\\,-5\\in R,\\,-5\\in C.\n$$\n\nTherefore, the correct answer is \"$Z,Q,R,$ and $C.$\""} {:db/id #edb/ref 17592186064503 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves" :topic/_knowledge-points [{:db/id #edb/ref 17592186049011 :topic/id #uuid "d33f7a90-b31c-5a5d-bdc7-84de678b50eb" :topic/math-academy-id 363 :topic/title "Intervals of Concavity"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b93bee7b-9d95-5423-8e1c-399dda55a57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459547} {:answer/id #uuid "3e56b729-6fa4-570f-8237-64e14a77c120" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459548}] :answer-field/correct {:answer/id #uuid "b93bee7b-9d95-5423-8e1c-399dda55a57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459547} :answer-field/id #uuid "fb55ba0f-4c1f-545f-a843-c5924a912ae6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460640} {:answer-field/choices [{:answer/id #uuid "e608ff10-c867-526c-8a3d-571af0743728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459549} {:answer/id #uuid "b27d14ae-3758-56a5-90a8-0bb40667c222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459550}] :answer-field/correct {:answer/id #uuid "e608ff10-c867-526c-8a3d-571af0743728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459549} :answer-field/id #uuid "73cd66d2-8694-5de7-853c-d208f6b12c77" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460641} {:answer-field/choices [{:answer/id #uuid "a1f3d673-082e-5424-a676-9c7e5ab3678e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459551} {:answer/id #uuid "0298cfa4-b332-52df-9c19-a427e194ea2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459552}] :answer-field/correct {:answer/id #uuid "0298cfa4-b332-52df-9c19-a427e194ea2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459552} :answer-field/id #uuid "70151fbc-485b-51d1-ab48-86bfbb02f5a2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "362ddce8-046e-5791-a78c-7440cb5f1723" :question/math-academy-id "q-141508" :question/problem "![](images/f4/f49ed44236dcfabd3276187899bd2d7d300cbc1c280c228cda0bc2e3599fe7a8.png)\n\nWhich of the curves above are concave up?\n\nSelect all that apply." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graph III curves upward (like a \"smile\") among the given graphs."} {:db/id #edb/ref 17592186106216 :knowledge-point/_questions [{:db/id #edb/ref 17592186105755 :knowledge-point/id #uuid "0d25a77b-7977-50b2-b375-51b8539bc9b9" :knowledge-point/title "Determining the Type of a Polygon" :topic/_knowledge-points [{:db/id #edb/ref 17592186048184 :topic/id #uuid "86927b03-ba99-5587-9673-31a5bae6ef0b" :topic/math-academy-id 1317 :topic/title "Polygons"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e69e1d5d-0656-5c9a-ba41-e8cea1efbe8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ide