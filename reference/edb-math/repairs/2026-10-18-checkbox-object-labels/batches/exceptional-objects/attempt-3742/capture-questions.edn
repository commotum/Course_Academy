nswer-field/id #uuid "6c22e257-18b9-5973-9c9f-ae85ffec73b4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439141} {:answer-field/choices [{:answer/id #uuid "8aef7162-d0e5-5631-91ce-694e2ecc3ef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438226} {:answer/id #uuid "c1588c7f-143f-535f-b50f-e63a5091e059" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438227}] :answer-field/correct {:answer/id #uuid "8aef7162-d0e5-5631-91ce-694e2ecc3ef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438226} :answer-field/id #uuid "56db77a8-773c-594c-afa2-0b04cacc3d8a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439142}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0429905-029f-5585-ac21-8d23fa4141fc" :question/math-academy-id "q-36063" :question/problem "![](images/1d/1dd593e8b48b13ec512a3e0c823ec0aaac4f5341bd519c7bb9b04648f95f4251.png)\n\nWhich of the graphs above correspond to an invertible function?\n\nSelect all that apply." :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](images/2a/2a68cbeceea9173ab7a53d334d073e9779b048ad8946fd3ff81b09adb79cee98.png)\n\nFrom the above, we see that:\n\n- For graph II, a horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph II shows a one-to-one function. As a result, this function is invertible.\n\n- For graphs I, III and IV, some horizontal lines intersect the curve more than once. These are not one-to-one functions. As a result, they are not invertible."} {:db/id #edb/ref 17592186335886 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889 :topic/title "Invertible Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b393ba9-a3ac-5808-94ed-3c11a65bce06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438390} {:answer/id #uuid "ce09f4bd-04c2-5f74-8906-b4202bebc260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438391}] :answer-field/correct {:answer/id #uuid "ce09f4bd-04c2-5f74-8906-b4202bebc260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438391} :answer-field/id #uuid "cf436ae2-cc85-573b-911c-97789c90dcfb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439224} {:answer-field/choices [{:answer/id #uuid "4c0ee5d6-084d-56b8-aa0e-c0258d95d108" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438392} {:answer/id #uuid "bfa5aec0-7411-557d-80cb-3019af06b156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438393}] :answer-field/correct {:answer/id #uuid "4c0ee5d6-084d-56b8-aa0e-c0258d95d108" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438392} :answer-field/id #uuid "487367e2-2599-53c8-bf9e-30339ddec50f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439225} {:answer-field/choices [{:answer/id #uuid "c21a3f03-90d9-53cb-bb71-9eea038a85ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438394} {:answer/id #uuid "49438212-d7d2-5534-aa5d-01794d4a4385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438395}] :answer-field/correct {:answer/id #uuid "49438212-d7d2-5534-aa5d-01794d4a4385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438395} :answer-field/id #uuid "05a53302-4e5d-5e14-b2b8-4f280d1ef98d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439226} {:answer-field/choices [{:answer/id #uuid "375d71bb-fa6f-5e85-ae88-5ea752aa5bfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438396} {:answer/id #uuid "ab81d9da-3733-5304-9619-8e0a6d376495" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438397}] :answer-field/correct {:answer/id #uuid "375d71bb-fa6f-5e85-ae88-5ea752aa5bfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438396} :answer-field/id #uuid "fbca9a6c-bf35-527a-b2dc-d52c66eea2c6" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439227}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0655d813-1b1b-5f2a-9217-33c596819669" :question/math-academy-id "q-66510" :question/problem "![](images/38/3897b7fcf079b2522cbd0138631a894cbca1005cd241524cf9f3995965278612.png)\n\nWhich of the graphs above correspond to an invertible function?\n\nSelect all that apply." :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](images/95/95b1bd18e41cba7d6d1175f66be053ffea52a32fbb35e2ad1d126dbeb2d73baf.png)\n\nFrom the above, we see that: \n\n- For graphs I and III, a horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graphs I and III show one-to-one functions. This means that these functions are invertible.\n\n- For graphs II and IV, some horizontal lines intersect the curve more than once. So, these are not one-to-one functions. As a result, they are not invertible."} {:db/id #edb/ref 17592186348364 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element" :topic/_knowledge-points [{:db/id #edb/ref 17592186049887 :topic/id #uuid "1bbcbfec-d0a8-5419-81c9-b34aaaaaa84f" :topic/math-academy-id 47 :topic/title "Special Sets"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fb1cc51-1db2-57b9-baf6-75de2e4cdec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469148} {:answer/id #uuid "dbccee3c-0547-5c53-8dfb-7fa8ba086442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469149}] :answer-field/correct {:answer/id #uuid "dbccee3c-0547-5c53-8dfb-7fa8ba086442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469149} :answer-field/id #uuid "1f5e3c87-547e-5a51-a277-73a08a1f920c" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/che