9b6b98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471309} {:answer/id #uuid "47e244b1-8fbd-5931-8cbe-a1843732e9b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471310}] :answer-field/correct {:answer/id #uuid "86fe7e95-dafd-55e3-a099-2e08519b6b98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471309} :answer-field/id #uuid "2fddddbd-d644-5857-bcfb-d2ac64e0c2e6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472160}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e3ef236-7e81-55bf-8f08-564fa1c1ae50" :question/math-academy-id "q-183669" :question/problem "$$\n(\\,∃y\\in (0,1),\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}y=1\\,)⇒(\\,∀{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}\\in (1,2),\\,x{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}>3\\,)\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $x$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $x.$\n\n- Occurrence II of the variable $z$ is *bound* since it is placed right next to the quantifier $∀:$\n\n$$\n(\\,∃y\\in (0,1),\\,xy=1\\,)⇒(\\,∀{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (1,2),\\,xz>3\\,)\n$$\n\n- Occurrence III of the variable $z$ is *bound* since it lies within the scope of the quantifier $∀$ that uses $z:$\n\n$$\n(\\,∃y\\in (0,1),\\,xy=1\\,)⇒(\\,∀z\\in (1,2),\\,\\overbrace{x{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}>3}^{\\text{scope of }∀z})\n$$\n\n \n\nThe occurrences of variables in the expression are as follows:\n\n$$\n(\\,∃{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (0,1),\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}=1\\,)⇒(\\,∀{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (1,2),\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}>3\\,)\n$$\n\nTherefore, the free occurrence is \"I only.\""} {:db/id #edb/ref 17592186381867 :knowledge-point/_questions [{:db/id #edb/ref 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables" :topic/_knowledge-points [{:db/id #edb/ref 17592186050691 :topic/id #uuid "5f607ed3-b581-5e92-9101-c32dd179ab13" :topic/math-academy-id 2792 :topic/title "Nested Quantifiers"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fda7182c-9b27-54fb-ae1a-8d57fe19c36e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471359} {:answer/id #uuid "e32d31ef-16ba-5f7a-a9dd-81cd32b4ec01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471360}] :answer-field/correct {:answer/id #uuid "fda7182c-9b27-54fb-ae1a-8d57fe19c36e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471359} :answer-field/id #uuid "9c2c916d-9df2-5d54-8d54-3148860ec045" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472185} {:answer-field/choices [{:answer/id #uuid "1d776f2f-d7f1-52a2-ab41-69e9765f8907" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471361} {:answer/id #uuid "0a1d90a0-d385-5638-a7af-b463cfa7cd50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471362}] :answer-field/correct {:answer/id #uuid "0a1d90a0-d385-5638-a7af-b463cfa7cd50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471362} :answer-field/id #uuid "c52a9fa8-43ce-56c3-ac5e-6c9511f4082a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472186} {:answer-field/choices [{:answer/id #uuid "24da09b9-7a22-5782-afed-5cb9868986bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471363} {:answer/id #uuid "3e03b584-5c34-5bbd-99fe-1e1d25f1324b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471364}] :answer-field/correct {:answer/id #uuid "3e03b584-5c34-5bbd-99fe-1e1d25f1324b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471364} :answer-field/id #uuid "9fb6dd46-9d46-5c39-81ef-15638fcdf267" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "390e8909-b67e-5f3a-bb33-1726ba1d68d6" :question/math-academy-id "q-216530" :question/problem "$$\n∀{\\,y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in Z,\\,y+{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}\\le {\\,z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $y$ is *bound* since it's placed right next to the quantifier $∀:$\n\n$$\n∀{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,y+x\\le z\n$$\n\n- Occurrence II of the variable $x$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $x.$\n\n- Occurrence III of the variable $z$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $z.$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∀{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,y+{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\\le {z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\n$$\n\nTherefore, the free occurrences are \"II and III only.\""} {:db/id #edb/ref 17592186381874 :knowledge-point/_questions [{:db/id #edb/ref 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables" :topic/_knowledge-points [{:db/id #edb/ref 17592186050691 :topic/id #uuid "5f607ed3-b581-5e92-9101-c32dd179ab13" :topic/math-academy-id 2792 :topic/title "Nested Quantifiers"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2883b9ba-32bd-5ff5-bcce-b579c830b5d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471365} {:answer/id #uuid "555b55f4-34bd-5b0e-9e56-002b7921c1ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471366}] :answer-field/correct {:answer/id #uuid "555b55f4-34bd-5b0e-9e56-002b7921c1ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471366} :answer-field/id #uuid "0ba74c19-e05e-599b-bbd8-455461faedc0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472188} {:answer-field/choices [{:answer/id #uuid "e07894ab-f2fd-5837-8dce-530c9db39f21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471367} {:answer/id #uuid "8256ae5a-2145-576f-b24c-70fde43e43bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471368}] :answer-field/correct {:answer/id #uuid "e07894ab-f2fd-5837-8dce-530c9db39f21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471367} :answer-field/id #uuid "7f394222-c342-5bf2-9565-301ff724543e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472189} {:answer-field/choices [{:answer/id #uuid "3c293a14-efb0-5e66-bdb9-90ab3fd059d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471369} {:answer/id #uuid "6b596922-2fca-5d75-b70f-37831468c2ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471370}] :answer-field/correct {:answer/id #uuid "6b596922-2fca-5d75-b70f-37831468c2ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471370} :answer-field/id #uuid "d2ad30a7-aa49-5946-bf6a-d22d986bc83e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d9a12d6-16ca-57db-975d-02505a889530" :question/math-academy-id "q-216618" :question/problem "$$\n(\\,∀x\\in N,\\,x>{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}+1\\,)⇒(\\,∃z\\in R,\\,{{z}^{3}}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}-1={y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\\,)\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $n$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $n.$\n\n- Occurrence II of the variable $z$ is *bound* since it lies within the scope of the quantifier $∃z$ that uses $z:$ \n\n$$\n(\\,∀x\\in N,\\,x>n+1\\,)⇒(\\,∃z\\in R,\\,\\overbrace{{z}^{3}-1={y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}}^{\\text{scope of }∃z}\\,)\n$$\n\n- Occurrence III of the variable $y$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $y.$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n(\\,∀{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in N,\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}>{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}+1\\,)⇒(\\,∃{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,{{z}^{3}}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}-1={y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\\,)\n$$\n\nTherefore, the free occurrence is \"I and III only.\""} {:db/id #edb/ref 17592186390205 :knowledge-point/_questions [{:db/id #edb/ref 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables" :topic/_knowledge-points [{:db/id #edb/ref 17592186050691 :to