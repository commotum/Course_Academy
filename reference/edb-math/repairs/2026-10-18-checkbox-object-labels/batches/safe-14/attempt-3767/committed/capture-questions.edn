rect answer is $f\\prime(x)=- 10 x.$ only."} {:db/id #edb/ref 17592186577256 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e2d78a6-0098-5570-8b75-9658bac896ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577262} {:answer/id #uuid "923779fe-8a1d-5656-8015-eaf792fb0480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577263}] :answer-field/correct {:answer/id #uuid "8e2d78a6-0098-5570-8b75-9658bac896ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577262} :answer-field/id #uuid "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/key "$f\\prime(x)=- 8 x^{3}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577242} {:answer-field/choices [{:answer/id #uuid "a723154a-a31d-503b-9579-bae0b8ee2011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577266} {:answer/id #uuid "cee2c378-b3ae-5d85-ae7e-47e9f7d4b976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577274}] :answer-field/correct {:answer/id #uuid "a723154a-a31d-503b-9579-bae0b8ee2011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577266} :answer-field/id #uuid "5f35dba7-7b86-5c82-83c0-db