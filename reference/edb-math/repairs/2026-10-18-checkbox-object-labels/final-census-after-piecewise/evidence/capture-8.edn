132-b9a5-526cf88a3a6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463873} :answer-field/id #uuid "76d1916c-2590-532b-a1d1-505dabfc6318" :answer-field/key "The number of people examined at a clinic until a person infected with a certain virus is found" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464870}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b122ef40-830b-573f-ad8c-2fa029e286ce" :question/math-academy-id "q-130490" :question/problem "Which of the following random variables follow a geometric distribution?\n\nSelect all that apply." :question/worked-solution "A geometric distribution is used to model the number of binomial experiments needed before the first success.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable “The number of people examined at a clinic during a day” does *not* follow a geometric distribution. Being examined is a binomial experiment, but the number of people examined cannot be interpreted as the number of binomial experiments needed before the first success.\n\n- Random variable “The average age of the people infected with a virus in a certain city” does *not* follow a geometric distribution. The average age of the people infected with a virus in a certain city is not a binomial experiment.\n\n- Random variable “The number of people examined at a clinic until a person infected with a certain virus is found” follows a geometric distribution. Being examined is a binomial experiment, and the number of people examined until a person infected with a certain virus is found can be interpreted as the number of binomial experiments needed before the first success.\n\nTherefore, the correct answer is “The number of people examined at a clinic until a person infected with a certain virus is found” only."} {:db/id #edb/ref 17592186265935 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant" :topic/_knowledge-points [{:db/id #edb/ref 17592186048146 :topic/id #uuid "832923c0-f0e3-599f-af85-37cb7dae2658" :topic/math-academy-id 153 :topic/title "The Determinant of a 3x3 Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a96a6f2b-900e-5634-9638-19c6ba6bffea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439527} {:answer/id #uuid "5d1afda0-1dac-5620-821a-ad4de506b094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439528}] :answer-field/correct {:answer/id #uuid "a96a6f2b-900e-5634-9638-19c6ba6bffea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439527} :answer-field/id #uuid "0a971e33-0a26-5898-ba8a-788195a8a8e8" :answer-field/key "$z=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440121} {:answer-field/choices [{:answer/id #uuid "d2790ee6-862d-5820-b3be-e055f4659069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439529} {:answer/id #uuid "d99a0961-46ae-512d-9fb7-6207f8fa1ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439530}] :answer-field/correct {:answer/id #uuid "d2790ee6-862d-5820-b3be-e055f4659069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439529} :answer-field/id #uuid "4b2d90b2-34d7-5699-a083-f922b6d5712c" :answer-field/key "$z=-2$" :answer-field/type {:db/id #edb/ref 175921864081