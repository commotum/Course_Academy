{:answer/id #uuid "f3730365-1faa-567b-9c31-4acdc410ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463584} {:answer/id #uuid "869dcee3-6d63-5587-84d7-2a86bd969317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463585}] :answer-field/correct {:answer/id #uuid "f3730365-1faa-567b-9c31-4acdc410ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463584} :answer-field/id #uuid "3622dfcc-ed36-50f5-8709-40aff4162d7a" :answer-field/key "$M=\\begin{bmatrix}-1 & 3 & -3 \\\\ 0 & 0 & 0 \\\\ -2 & 5 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc57098-3c69-5567-91db-1d90d4ec9c40" :question/math-academy-id "q-126275" :question/problem "Which of the following are square matrices?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- $K$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $L$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $1$ rows and $2$ columns, so it's a $1\\times 2$ matrix.\n\n- $M$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $4$ rows and $3$ columns, so it's a $4\\times 3$ matrix.\n\nTherefore, only $K$ is a square matrix."} {:db/id #edb/ref 17592186262604 :knowledge-point/_questions [{:db/id #edb/ref 17592186119772 :knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc" :knowledge-point/title "Identifying a Triangular Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf88710f-b87c-5266-9c5f-535bd49454b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437734} {:answer/id #uuid "54a08cb6-41ab-5dc1-bc15-470540725af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437735}] :answer-field/correct {:answer/id #uuid "54a08cb6-41ab-5dc1-bc15-470540725af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437735} :answer-field/id #uuid "2e9b060c-75fd-538d-8b17-6f8f74704b24" :answer-field/key "$A=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438896} {:answer-field/choices [{:answer/id #uuid "0da38aeb-d192-5fcc-aea2-560c50d82228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437736} {:answer/id #uuid "eadcc0f5-f9fb-5083-aa37-83f8b2760849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437737}] :answer-field/correct {:answer/id #uuid "eadcc0f5-f9fb-5083-aa37-83f8b2760849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437737} :answer-field/id #uuid "a5131af3-1aac-5801-be71-61200d0fdb9b" :answer-field/key "$B=\\begin{bmatrix}5 & 0 \\\\ -1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438897} {:answer-field/choices [{:answer/id #uuid "7a7a55f2-8f01-5f1a-af2e-f30eed260d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437738} {:answer/id #uuid "e0ffc388-0f49-5422-b561-53cde5fd175e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437739}] :answer-field/correct {:answer/id #uuid "7a7a55f2-8f01-5f1a-af2e-f30eed260d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437738} :answer-field/id #uuid "fc9f1a6e-ca69-519f-bba4-6e7006ac48ac" :answer-field/key "$C=\\begin{bmatrix}1 & -2 \\\\ 0 & 5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "addfb264-5013-5ace-a74a-d9286a8c951b" :question/math-academy-id "q-126351" :question/problem "Which of the following matrices are lower triangular matrices?\n\nSelect all that apply." :question/worked-solution "The matrices $A$ and $B$ are lower triangular matrices since all the entries above the main diagonal are zeros.\n\nThe matrix $C$ is *not* a lower triangular matrix since it has a non-zero element above the main diagonal: \n\n$$\n\\begin{aligned}{c}_{12} & =-2\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262616 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12919bee-30a9-5706-b50b-8d68bb9ec18f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437740} {:answer/id #uuid "bf178365-d264-5e92-b9fa-1