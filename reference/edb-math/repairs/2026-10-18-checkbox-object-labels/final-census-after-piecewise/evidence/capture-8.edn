0-5cae-bafa-4ec7c3c6e9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448295}] :answer-field/correct {:answer/id #uuid "484b7edd-b950-5cae-bafa-4ec7c3c6e9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448295} :answer-field/id #uuid "9fafc811-ec3d-58ec-be64-95611287b86a" :answer-field/key "$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4f36ed6-3fc6-5f37-801d-3dafa17482c6" :question/math-academy-id "q-128124" :question/problem "Let \n$A=\\begin{bmatrix}2 & -3 \\\\ 2 & 3\\end{bmatrix}.$ \nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)=0$ is false. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & -3 \\\\ 2 & 3\\end{bmatrix} \\\\  & =2\\cdot 3-(-3)\\cdot 2 \\\\  & =12\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “$A$ is invertible” is true by the first part of the invertible matrix theorem.\n\n- Statement “$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$” is true by the second part of the invertible matrix theorem.\n\nFinally, only statements “$A$ is invertible” and “$Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b$” are true."} {:db/id #edb/ref 17592186262877 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d364ced3-f0b4-5db0-a418-8e753ca019ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448296} {:answer/id #uuid "c073cf48-e7ec-54b8-aa41-5f5dd4380be4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448297}] :answer-field/correct {:answer/id #uuid "d364ced3-f0b4-5db0-a418-8e753ca019ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448296} :answer-field/id #uuid "3fe6ac89-7503-556b-afe3-bc96c1615f30" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449188} {:answer-field/choices [{:answer/id #uuid "e79c11e7-6e9c-5e41-a093-0a00d224cc41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448298} {:answer/id #uuid "9f4b969f-164a-59d2-bd0e-77808fa91ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448299}] :answer-field/correct {:answer/id #uuid "9f4b969f-164a-59d2-bd0e-77808fa91ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448299} :answer-field/id #uuid "9fb139ea-e0aa-5492-9328-5084dd32f1a0" :answer-field/key "The system  $Ax=0$ has exactly one solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449189} {:answer-field/choices [{:answer/id #uuid "151b861f-225f-5d93-94c6-8c117995a350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448300} {:answer/id #uuid "503ffa37-1521-58e6-8ba5-365468b412c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448301}] :answer-field/correct {:answer/id #uuid "151b861f-225f-5d93-94c6-8c117995a350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448300} :answer-field/id #uuid "262c7598-2a14-5bdc-94d3-bf80698480e8" :answer-field/key "The lines $7x+14y=2$ and $-2x+ky=-3$ intersect at infinitely many points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7887fe01-425a-54fe-9f35-ac58c1eba82c" :question/math-academy-id "q-128136" :question/problem "Let $A=\\begin{bmatrix}7 & 14 \\\\ -2 & k\\end{bmatrix}$ and $b=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},$ where $k$ is a constant such that $k\\ne -4.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement $det(A)=0$ is false. We have \n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}7 & 14 \\\\ -2 & k\\end{bmatrix} \\\\  & =7\\cdot k-(-2)\\cdot 14 \\\\  & =7k+28.\\end{aligned}\n$$\n\nNotice that $7k+28\\ne 0$ if $k\\ne -4.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement “The system  $Ax=0$ has exactly one solution” is true. Indeed, by the third part of the invertible matrix theorem, the unique solution to $Ax=0$ is the trivial one (zero).\n\n- Statement “The lines $7x+14y=2$ and $-2x+ky=-3$ intersect at infinitely many points” is false. According to the fourth part of the invertible matrix theorem, the lines must intersect at exactly one point.\n\nFinally, only statement “The system  $Ax=0$ has exactly one solution” is true."} {:db/id #edb/ref 17592186262879 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730 :topic/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbc51147-25b1-5778-aad6-bf5043f6cb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463664} {:answer/id #uuid "4313bd7f-c033-58ab-9701-6a606323f354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463665}] :answer-field/correct {:answer/id #uuid "cbc51147-25b1-5778-aad6-bf5043f6cb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463664} :answer-field/id #uuid "eb8075aa-0afd-51a1-a5c6-af05a9aed7f2" :answer-field/key "${\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}}^{-1}$ does not exist" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464766} {:answer-field/choices [{:answer/id #uuid "368fae73-e507-5e37-9bef-0792ca0debca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463666} {:answer/id #uuid "d4b9de64-5f82-5775-b0ce-00dc70fb2b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463667}] :answer-field/correct {:answer/id #uuid "368fae73-e507-5e37-9bef-0792ca0debca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463666} :answer-field/id #uuid "39c1f705-0894-5627-bf2d-13ce4da8aa7c" :answer-field/key "The lines $ax+by=0$ and $cx+dy=0$ intersect at infinitely many points" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464767} {:answer-field/choices [{:answer/id #uuid "0549c86c-aba6-5d1f-ac04-e74be35442d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463668} {:answer/id #uuid "699204bf-a3a7-5655-bc84-77191c72bfd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463669}] :answer-field/correct {:answer/id #uuid "699204bf-a3a7-5655-bc84-77191c72bfd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463669} :answer-field/id #uuid "e3a0de77-fbba-5ef9-91d1-ff05515f955d" :answer-field/key "$det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f225cdda-cd5f-5d3d-8527-91ba6c98c224" :question/math-academy-id "q-128151" :question/problem "Which of the following completes the statement so that it is true:\n\n*If the system $\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}x=0$ has the unique zero solution, then $\\underline{\\phantom{xxxxxx}}$ . *\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNow, since the third part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem, only option $det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0$ gives us a true statement:  \n\n*If the system $\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}x=0$ has the unique zero solution, then, $det\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\ne 0$ .* $\\,✓$"} {:db/id #edb/ref 17592186262880 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement" :topic/_knowledge-points [{:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-e