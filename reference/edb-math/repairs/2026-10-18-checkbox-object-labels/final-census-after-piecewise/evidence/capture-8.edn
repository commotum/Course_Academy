ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fc15eb5-6ce5-5be9-9bbc-fe517b5c7183" :question/math-academy-id "q-129218" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\operatorname{ln}⁡(x+2)}{x-2}?$ \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-3,-1]$ is closed, but the function is not defined on the part of the interval where $x\\le -2.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[-1,1]$ is closed, and the function is continuous on $[-1,1].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $[1,3]$ is closed, but the function is not defined at $x=2.$ Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[-1,1]$ only."} {:db/id #edb/ref 17592186262989 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186048748 :topic/id #uuid "bad1cfe2-7639-5714-8417-2b8af7ece5cb" :topic/math-academy-id 3571 :topic/title "The Extreme Value Theorem"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be60b44c-dc29-579a-8bbe-99cfeff6e423" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463712} {:answer/id #uuid "4ed92d1a-34d6-595b-af27-4fada8783f8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true