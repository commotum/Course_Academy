571}}]} :answer-field/id #uuid "771187b2-e28f-5a7d-a91d-34f73489e1ad" :answer-field/key "$C$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438903} {:answer-field/choices [{:answer/id #uuid "520ef5db-e43e-5e23-92a0-3ed7c62386b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437750} {:answer/id #uuid "6e998b87-0e1c-59a3-830c-e099cf52d227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437751 :task-item/_responses [{:db/id #edb/ref 17592186576321 :task-item/content {:db/id #edb/ref 17592186262617} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "6e998b87-0e1c-59a3-830c-e099cf52d227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437751 :task-item/_responses [{:db/id #edb/ref 17592186576321 :task-item/content {:db/id #edb/ref 17592186262617} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "c1bcc754-87e4-5cec-9f4e-5a5e7e36cb54" :answer-field/key "${C}^{T}$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438904}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f41ff7d0-b754-5033-a620-53eef8a376e3" :question/math-academy-id "q-126479" :question/problem "Consider the matrix\n\n$$\nC=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $C$ is upper triangular: **True.** All the entries below the main diagonal of $C$ are zeros:\n\n$$\nC=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\n- $C$ is lower triangular: **True.** All the entries above the main diagonal of $C$ are zeros:\n\n$$\nC=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\n- ${C}^{T}$ is upper triangular: **True.** All the entries below the main diagonal of ${C}^{T}$ are zeros:\n\n$$\n{C}^{T}=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $C$ is upper triangular.\n- $C$ is lower triangular.\n- ${C}^{T}$ is upper triangular." :task-item/_content [{:db/id #edb/ref 17592186576321 :task-item/content {:db/id #edb/ref 17592186262617} :task-item/elapsed-seconds 121.657 :task-item/id #uuid "c269a1c5-9c06-421c-8756-8e826f570d95" :task-item/next {:db/id #edb/ref 17592186576360} :task-item/responses [{:answer/id #uuid "86262feb-536d-5ef8-afcc-c7b14bc45026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437747} {:answer/id #uuid "0e783ddd-e977-54e7-8580-da07e92b8e98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437749} {:answer/id #uuid "6e998b87-0e1c-59a3-830c-e099cf52d227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437751}] :task-item/status {:db/id #edb/ref 17592186045571} :task-item/working-ended-at #inst "2026-10-17T23:26:42.574Z"}]} {:db/id #edb/ref 17592186262618 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbb2fac-47b6-5bca-8490-fe78f86c36be" :answer/type {