d "q-1261" :question/problem "For the sets $X={x,y,z},$ $Y={v,w},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nSelect all that apply." :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/31/316a12102e4be81291f06403815cfb63749b1fd3f463c465294e031543123484.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,v),(x,w),(y,v),(y,w),(z,v),(z,w)}.\n$$\n\nTherefore, the correct answer is $(x,v)\\in Z$; $(y,w)\\in Z$ only."} {:db/id #edb/ref 17592186262598 :knowledge-point/_questions [{:db/id #edb/ref 17592186087695 :knowledge-point/id #uuid "ddb59990-7419-585f-aa1b-901d59c8cfc1" :knowledge-point/title "Identifying a Zero Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186048252 :topic/id #uuid "8c876864-a853-56d6-a887-91d7f8f1cf14" :topic/math-academy-id 862 :topic/title "Zero, Square, Diagonal and Identity Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37604281-9d43-5bbd-bda5-53144e675aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463568} {:answer/id #uuid "9631a4fc-dd62-5cec-9261-ebdb8f30131a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463569}] :answer-field/correct {:answer/id #uuid "9631a4fc-dd62-5cec-9261-ebdb8f30131a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463569} :answer-field/id #uuid "60c94232-ba43-57ee-a962-32f5418c59f9" :answer-field/key "$G=\\begin{bmatrix}0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464718} {:answer-field/choices [{:answer/id #uuid "d4fc44cc-9ea3-56