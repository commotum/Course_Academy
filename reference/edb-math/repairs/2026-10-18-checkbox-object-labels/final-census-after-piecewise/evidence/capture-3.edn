swer.type/text} :answer/value "false" :db/id #edb/ref 17592186422339 :task-item/_responses [{:db/id #edb/ref 17592186409286 :task-item/content {:db/id #edb/ref 17592186167499} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "91464ac2-012a-5628-9de2-8468b2c1d708" :answer-field/key "$\\frac{1}{2}{x}^{2}{y}^{″}$ $=3{y}^{′},$ $\\,y(1)$ $=2,$ $\\,{y}^{′}(1)$ $=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422450} {:answer-field/choices [{:answer/id #uuid "3baf4f4e-994c-5a3d-8cd7-a08d6815e9e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422341} {:answer/id #uuid "ca77a9c5-67ca-5442-a2b6-728548b85c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422342 :task-item/_responses [{:db/id #edb/ref 17592186409286 :task-item/content {:db/id #edb/ref 17592186167499} :task-item/status {:db/id #edb/ref 17592186045571}}]}] :answer-field/correct {:answer/id #uuid "ca77a9c5-67ca-5442-a2b6-728548b85c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422342 :task-item/_responses [{:db/id #edb/ref 17592186409286 :task-item/content {:db/id #edb/ref 17592186167499} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "df06a3a0-7e3c-5b74-b120-cc16d360e1b5" :answer-field/key "$2{x}^{2}{y}^{′}=y,\\,y(0)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422451} {:answer-field/choices [{:answer/id #uuid "e9b50315-f8d9-5f53-a15e-c35152183cd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422343 :task-item/_responses [{:db/id #edb/ref 17592186409286 :task-item/content {:db/id #edb/ref 17592186167499} :task-item/status {:db/id #edb/ref 17592186045571}}]} {:answer/id #uuid "00362934-c6f7-5519-a9c5-57cedf485a65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422344}] :answer-field/correct {:answer/id #uuid "e9b50315-f8d9-5f53-a15e-c35152183cd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422343 :task-item/_responses [{:db/id #edb/ref 17592186409286 :task-item/content {:db/id #edb/ref 17592186167499} :task-item/status {:db/id #edb/ref 17592186045571}}]} :answer-field/id #uuid "41909812-23d6-5023-aa6c-ce2d4a23c2b5" :answer-field/key "$4{y}^{′}-\\frac{1}{3}xy=\\operatorname{ln}⁡y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422452}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed0b0a68-7ad2-55d7-8d80-82f9a5c1ced6" :question/math-academy-id "q-96986" :question/problem "Which of the following systems is a first-order initial value problem?\n\nSelect all that apply." :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System $\\frac{1}{2}{x}^{2}{y}^{″}$ $=3{y}^{′},$ $\\,y(1)$ $=2,$ $\\,{y}^{′}(1)$ $=1$ is not a first-order initial value problem. It consists of a *second*-order differential equation $\\frac{1}{2}{x}^{2}{y}^{″}=3{y}^{′}$ together with *two* initial conditions $y(1)=2,\\,{y}^{′}(1)=1.$ This is a second-order initial value problem.\n\n- System $2{x}^{2}{y}^{′}=y,\\,y(0)=2$ is a first-order initial value problem. It consists of a first-order differential equation $2{x}^{2}{y}^{′}=y$ together with the initial condition $y(0)=2.$\n\n- System $4{y}^{′}-\\frac{1}{3}xy=\\operatorname{ln}⁡y$ is not a first-order initial value problem. We have a first-order ordinary differential equation, but there is no initial condition.\n\nTherefore, the correct answer is $2{x}^{2}{y}^{′}=y,\\,y(0)=2$ only." :task-item/_content [{:db/id #edb/ref 17592186409286 :task-item/content {:db/id #edb/ref 17592186167499} :task-item/elapsed-seconds 18.089 :task-item/id #uuid "af5ea72f-851a-4b53-8ec3-48d3b87dfc01" :task-item/next {:db/id #edb/ref 17592186409287} :task-item/responses [{:answer/id #uuid "9b1657ec-ee94-56ab-9624-eb98b93a3f8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422339} {:answer/id #uuid "ca77a9c5-67ca-5442-a2b6-728548b85c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422342} {:answer/id #uuid "e9b50315-f8d9-5f53-a15e-c35152183cd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422343}] :task-item/status {:db/id #edb/ref 17592186045571}}]} {:db/id #edb/ref 17592186167513 :knowledge-point/_questions [{:db/id #edb/ref 17592186166841 :knowledge-point/id #uuid "00b14560-29f9-58fc-ac65-5505987579fb" :knowledge-point/title "Determining Situations That Can Be Modeled as a Discrete Uniform Distribution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048884 :topic/id #uuid "c96d046b-16b8-5aad-81a5-2dd906b25702" :topic/math-academy-id 3269 :topic/title "Modeling With Discrete Uniform Distributions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a530de0a-77de-5003-a76f-fcb582626874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460479} {:answer/id #uuid "dfc382f9-b868-576b-a4cb-a97788575bb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460480}] :answer-field/correct {:answer/id #uuid "dfc382f9-b868-576b-a4cb-a97788575bb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460480} :answer-field/id #uuid "05542c5e-e571-5d4d-8e56-d51882f83de2" :answer-field/key "The number obtained when picking an integer between $1$ and $10$ at random." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461106} {:answer-field/choices [{:answer/id #uuid "43d58a2f-9e30-5bdb-b947-eecf4a0f7f1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460481} {:answer/id #uuid "f390cd0a-fac0-5a81-a2fd-74cfcea9e0c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460482}] :answer-field/correct {:answer/id #uuid "43d58a2f-9e30-5bdb-b947-eecf4a0f7f1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460481} :answer-field/id #uuid "074e0f6e-ebf8-5a2e-820d-3817a62273a6" :answer-field/key "The number obtained when picking a real number between $1$ and $10$ at random." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461107} {:answer-field/choices [{:answer/id #uuid "488f9a0f-7ea7-5edc-b09b-dc4ae768435b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460483} {:answer/id #uuid "b3969827-e572-5519-9f6c-4d680cb2eca6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460484}] :answer-field/correct {:answer/id #uuid "488f9a0f-7ea7-5edc-b09b-dc4ae768435b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460483} :answer-field/id #uuid "2f06f550-be77-5b9e-8aa8-1f4410513c1e" :answer-field/key "The color of the ball obtained when a ball from a bag containing $3$ blue and $4$ red balls is chosen at random." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461108}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "200aef1f-7404-50e8-879d-3c216fa12872" :question/math-academy-id "q-97569" :question/problem "Which of the following random variables can be modeled as a discrete uniform distribution?\n\nSelect all that apply." :question/worked-solution "We can use the discrete uniform distribution to model the outcome of a single event when the support $S$ is finite, and each $x\\in S$ is equally likely.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable “The number obtained when picking an integer between $1$ and $10$ at random” can be modeled as a discrete uniform distribution. There are a finite number of integers between $1$ and $10,$ and since the selection is made at random, each integer has an equal probability of being selected.\n\n- Random variable “The number obtained when picking a real number between $1$ and $10$ at random” cannot be modeled as a discrete uniform distribution. This is because there are infinitely many real numbers between $1$ and $10,$ and so the support is not finite.\n\n- Random variable “The color of the ball obtained when a ball from a bag containing $3$ blue and $4$ red balls is chosen at random” cannot be modeled as a discrete uniform distribution. Each outcome is not equally likely, because there is a higher probability of selecting a red ball.\n\nTherefore, the correct answer is “The number obtained when picking an integer between $1$ and $10$ at random” only."} {:db/id #edb/ref 17592186167516 :knowledge-point/_questions [{:db/id #edb/ref 17592186166841 :knowledge-point/id #uuid "00b14560-29f9-58fc-ac65-5505987579fb" :knowledge-point/title "Determining Situations That Can Be Modeled as a Discrete Uniform Distribution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048884 :topic/id #uuid "c96d046b-16b8-5aad-81a5-2dd906b25702" :topic/math-academy-id 3269 :topic/title "Modeling With Discrete Uniform Distributions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9745601-d4c9-5195-b8ec-0ddeec75b662" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460485} {:answer/id #uuid "53f1c2de-ccb2-51c9-a72e-595edd9c4351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460486}] :answer-field/correct {:answer/id #uuid "e9745601-d4c9-5195-b8ec-0ddeec75b662" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460485} :answer-field/id #uuid "b96eba3b-c46f-57a5-93d1-537bd2ccb3d1" :answer-field/key "The number of correct answers in a multiple choice test of $10$ questions, where each answer is either \"true\" or \"false,\" and each answer is guessed randomly." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461109} {:answer-field/choices [{:answer/id #uuid "78d4990c-08ab-5faa-8dd0-473c1327dcd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460487} {:answer/id #uuid "b6feb510-0a6a-5cb5-813f-15c77a27c705" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460488}] :answer-field/correct {:answer/id #uuid "b6feb510-0a6a-5cb5-813f-15c77a27c705" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460488} :answer-field/id #uuid "864cee92-e88e-52c4-b7ca-424b356cfeeb" :answer-field/key "The number obtained when spinning a fair roulette wheel." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461110} {:answer-field/choices [{:answer/id #uuid "8f92524b-aee2-5040-afd3-e199667102d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460489} {:answer/id #uuid "02095f52-4961-5297-b708-38ff563efd5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460490}] :answer-field/correct {:answer/id #uuid "8f92524b-aee2-5040-afd3-e199667102d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460489} :answer-field/id #uuid "bec8df0d-23e2-5333-95c0-ed30247b63b2" :answer-field/key "The initial letter of a word picked at random from an English dictionary." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3f94f8a-9ac9-561e-91b8-f484694ecc10" :question/math-academy-id "q-97745" :question/problem "Which of the following random variables can be modeled as a discrete uniform distribution?\n\nSelect all that apply." :question/worked-solution "We can use the discrete uniform distribution to model the outcome of a single event when the support $S$ is finite, and each $x\\in S$ is equally likely.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable “The number of correct answers in a multiple choice test of $10$ questions, where each answer is either \"true\" or \"false,\" and each answer is guessed randomly” cannot be modeled as a discrete uniform distribution. Each number of correct answers is not equally likely. For example, it is more likely to score $50%$ than $100%.$\n\n- Random variable “The number obtained when spinning a fair roulette wheel” can be modeled as a discrete uniform distribution. For example, each outcome of a roulette wheel is represented by a number between $0$ and $37,$ and since the roulette is fair, each number is equally likely.\n\n- Random variable “The initial letter of a word picked at random from an English dictionary” cannot be modeled as a discrete uniform distribution. Each outcome is not equally likely, because some letters are more common than others.\n\nTherefore, the correct answer is “The number obtained when spinning a fair roulette wheel” only."} {:db/id #edb/ref 17592186172278 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0472bb5e-4a90-5cd6-9de5-ebef5117beaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437594} {:answer/id #uuid "f88ae56c-e114-5adc-b201-c66477067085" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437595}] :answer-field/correct {:answer/id #uuid "f88ae56c-e114-5adc-b201-c66477067085" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437595} :answer-field/id #uuid "dbb3b38e-ed8e-5a59-9388-07674b092db3" :answer-field/key "$G(x,y)={x}^{2}\\,i-{y}^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438826} {:answer-field/choices [{:answer/id #uuid "aad1daee-f461-5f33-a5be-9837ee051c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437596} {:answer/id #uuid "e0211d47-e1df-5da8-8b13-855c00b96273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437597}] :answer-field/correct {:answer/id #uuid "e0211d47-e1df-5da8-8b13-855c00b96273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437597} :answer-field/id #uuid "090cb07d-b3c5-5c39-80ad-a9d21b5b0936" :answer-field/key "$H(x,y)=\\operatorname{ln}⁡y\\,i-{e}^{xy}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438827} {:answer-field/choices [{:answer/id #uuid "f8655475-7a8d-5a44-bdb9-605e4fe17d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437598} {:answer/id #uuid "28b18abe-37d6-5c8a-b396-b1abcba8e763" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437599}] :answer-field/correct {:answer/id #uuid "f8655475-7a8d-5a44-bdb9-605e4fe17d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437598} :answer-field/id #uuid "19bef9f2-14bf-5988-884b-2c3e717c03e5" :answer-field/key "$K(x,y,z)=x\\,i-y\\,j+z\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438828}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2d1a20d-340e-5980-ad18-92b97e0270ba" :question/math-academy-id "q-122465" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $H(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,y>0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $K(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\nTherefore, the correct answer is $G(x,y)={x}^{2}\\,i-{y}^{2}\\,j$; $H(x,y)=\\operatorname{ln}⁡y\\,i-{e}^{xy}\\,j$ only."} {:db/id #edb/ref 17592186172279 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257efe5e-2614-5ac2-bf85-79ecbfa90a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437600} {:answer/id #uuid "9b6b7630-7b4f-55f1-bc9a-d761bb022686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437601}] :answer-field/correct {:answer/id #uuid "257efe5e-2614-5ac2-bf85-79ecbfa90a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437600} :answer-field/id #uuid "cb7b4231-7e44-5469-8d42-537ade15949a" :answer-field/key "$G(t)={e}^{t}\\,i-t\\,j+\\operatorname{sin}⁡t\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438829} {:answer-field/choices [{:answer/id #uuid "c2a1f4d6-a1e4-52e9-8825-2408433db854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437602} {:answer/id #uuid "d3b41f11-8dd8-570a-b746-ce040d0c6094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437603}] :answer-field/correct {:answer/id #uuid "c2a1f4d6-a1e4-52e9-8825-2408433db854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437602} :answer-field/id #uuid "666ed197-24fa-5d30-ae83-a374aabe3407" :answer-field/key "$H(x,y)={x}^{2}\\,i-{y}^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438830} {:answer-field/choices [{:answer/id #uuid "0b2abe03-84b2-5689-9957-2c5ddaaeaf0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437604} {:answer/id #uuid "4235aad1-8567-5a5f-b358-a0eadb4ecae7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437605}] :answer-field/correct {:answer/id #uuid "4235aad1-8567-5a5f-b358-a0eadb4ecae7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437605} :answer-field/id #uuid "3a3877a7-32e1-5f78-bf7a-c67ae72c6830" :answer-field/key "$K(x,y,z)=\\operatorname{cot}⁡x\\,i-y\\,j+z\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438831}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "060c20fc-1491-5624-9b50-89ab0dfe4d22" :question/math-academy-id "q-122467" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $H(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $K(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $K(x,y,z)=\\operatorname{cot}⁡x\\,i-y\\,j+z\\,k$ only."} {:db/id #edb/ref 17592186172283 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9db2c395-ec42-5ded-b118-40b7f641733e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437612} {:answer/id #uuid "416808ed-a781-5b4b-95e5-19a652e061b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437613}] :answer-field/correct {:answer/id #uuid "416808ed-a781-5b4b-95e5-19a652e061b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437613} :answer-field/id #uuid "c3b88c55-88f1-525f-b310-4ec0ae74fb86" :answer-field/key "$P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438835} {:answer-field/choices [{:answer/id #uuid "b870f025-7855-54e1-ba52-ff6dc5d12029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437614} {:answer/id #uuid "272a82e6-92c9-5b61-b5b0-91bb28d461e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437615}] :answer-field/correct {:answer/id #uuid "b870f025-7855-54e1-ba52-ff6dc5d12029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437614} :answer-field/id #uuid "cd800195-cb3a-5cb6-83d8-4a289879ed7b" :answer-field/key "$Q(x,y,z)$ $=y\\,i$ $-xy\\,j$ $+(z+1)\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438836} {:answer-field/choices [{:answer/id #uuid "d35aa822-dcce-5b60-823d-bc8fd4d47fd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437616} {:answer/id #uuid "57ad27bc-d96f-5039-a317-bdadedc1b542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437617}] :answer-field/correct {:answer/id #uuid "d35aa822-dcce-5b60-823d-bc8fd4d47fd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437616} :answer-field/id #uuid "91b9cc2d-8a9d-5c85-8be1-4e96ec3dbdef" :answer-field/key "$R(t)=(t+1)\\,i-(3t-1)\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b23ed53-bb63-5272-af53-a6429d08e4c0" :question/math-academy-id "q-122643" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x\\ne 0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $Q(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  $R$ (not ${R}^{2}$) to vectors in ${R}^{2}.$\n\nTherefore, the correct answer is $P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$ only."} {:db/id #edb/ref 17592186172285 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions" :topic/_knowledge-points [{:db/id #edb/ref 17592186050412 :topic/id #uuid "46db30fb-cff1-5fef-85ad-641fbb5c68f2" :topic/math-academy-id 3343 :topic/title "Vector Fields"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "662120df-b64d-54ef-9755-4c19a2619b08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437690} {:answer/id #uuid "5f979ab0-c9f1-5a39-8279-36823d8a4b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437691}] :answer-field/correct {:answer/id #uuid "5f979ab0-c9f1-5a39-8279-36823d8a4b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437691} :answer-field/id #uuid "f9a1bfb0-97af-571d-8fa7-cabca9f81b58" :answer-field/key "$U(x,y,z)$ $=⟨x+2,\\sqrt{x-y},\\operatorname{ln}⁡z⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438874} {:answer-field/choices [{:answer/id #uuid "68c998f6-9652-545f-9f75-a13c62365a3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437692} {:answer/id #uuid "b439a47b-3c58-5ada-b83b-cb0d5f96aba3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437693}] :answer-field/correct {:answer/id #uuid "68c998f6-9652-545f-9f75-a13c62365a3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437692} :answer-field/id #uuid "50e0a766-53e1-58da-b795-ea4aa130a9a2" :answer-field/key "$V(x,y)=⟨x{e}^{y},1-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438875} {:answer-field/choices [{:answer/id #uuid "a15fd7a1-495c-5a1f-9e2c-3e2cf8f73c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437694} {:answer/id #uuid "c163aff7-0957-5238-8912-1448c3c67129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437695}] :answer-field/correct {:answer/id #uuid "a15fd7a1-495c-5a1f-9e2c-3e2cf8f73c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437694} :answer-field/id #uuid "ec68c1f1-2b47-5081-9d50-db69af906f2a" :answer-field/key "$W(t)=⟨{t}^{2},2t,2-3t⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4052d0d0-adca-5eb3-9bef-49295b1e5651" :question/math-academy-id "q-122697" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $U(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ge y,\\,z>0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $V(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $W(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\nTherefore, the correct answer is $U(x,y,z)$ $=⟨x+2,\\sqrt{x-y},\\operatorname{ln}⁡z⟩$ only."} {:db/id #edb/ref 17592186172299 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path" :topic/_knowledge-points [{:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360 :topic/title "Path Independence of Line Integrals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11cb0bd2-c4ef-5dd6-8c0b-38f8a14033cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459509} {:answer/id #uuid "0c2641ca-1b88-5d2b-a9c3-627699c70f9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459510}] :answer-field/correct {:answer/id #uuid "0c2641ca-1b88-5d2b-a9c3-627699c70f9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459510} :answer-field/id #uuid "701b7295-ba30-510e-8aed-ce8e567b3964" :answer-field/key "${\\int }_{{C}_{1}}F\\cdot \\text{d}r=0,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460621} {:answer-field/choices [{:answer/id #uuid "4b712a69-6903-5945-beae-57def102aba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459511} {:answer/id #uuid "9c38e779-e7e6-5c6a-b62e-5d5b58d2d870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459512}] :answer-field/correct {:answer/id #uuid "4b712a69-6903-5945-beae-57def102aba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459511} :answer-field/id #uuid "8e0c6886-c030-53c3-a1a5-957b02f81b60" :answer-field/key "${\\int }_{{C}_{2}}F\\cdot \\text{d}r=0,$ where ${C}_{2}$ is the path along the parabola $y={x}^{2},$ traversed from $O$ to $A.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460622} {:answer-field/choices [{:answer/id #uuid "bd0a984a-de37-5319-9554-273e15f7477f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459513} {:answer/id #uuid "0d197d92-6732-599f-a209-f5a39a673b01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459514}] :answer-field/correct {:answer/id #uuid "bd0a984a-de37-5319-9554-273e15f7477f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459513} :answer-field/id #uuid "05075a1e-9b2d-5493-88e7-7c07957ae17d" :answer-field/key "${\\int }_{C}F\\cdot \\text{d}r$ is independent of path." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460623} {:answer-field/choices [{:answer/id #uuid "ec1aa6d1-7c31-58d9-aff7-9461af74c578" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459515} {:answer/id #uuid "f18b9afa-c071-5b2c-ab57-e1879ab20b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459516}] :answer-field/correct {:answer/id #uuid "ec1aa6d1-7c31-58d9-aff7-9461af74c578" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459515} :answer-field/id #uuid "27c273e9-3d77-5c11-8cf8-2b50e06e227b" :answer-field/key "$F$ is conservative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460624}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "41a70c70-f13c-564f-a1cc-c8837528e651" :question/math-academy-id "q-125636" :question/problem "Consider the vector field $F(x,y)=⟨y,\\,-x⟩$ and the points $O(0,0)$ and $A(1,1)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement “${\\int }_{{C}_{1}}F\\cdot \\text{d}r=0,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$” is true. Parameterizing the line segment, we have\n\n$$\n{r}_{1}(t)=⟨t,\\,t⟩,\\,t\\in [0,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}⟨t,\\,-t⟩\\cdot ⟨1,\\,1⟩\\text{d}t \\\\  & ={\\int }_{0}^{1}t-t\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}0\\,\\text{d}t \\\\  & =0.\\end{aligned}\n$$\n\n- Statement “${\\int }_{{C}_{2}}F\\cdot \\text{d}r=0,$ where ${C}_{2}$ is the path along the parabola $y={x}^{2},$ traversed from $O$ to $A.$” is false. Parameterizing the line segment, we have\n\n$$\n{r}_{2}(t)=⟨t,\\,{t}^{2}⟩,\\,t\\in [0,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}⟨{t}^{2},\\,-t⟩\\cdot ⟨1,\\,2t⟩\\text{d}t \\\\  & ={\\int }_{0}^{1}{t}^{2}-2{t}^{2}\\,\\text{d}t \\\\  & =-{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t \\\\  & =-{\\frac{{t}^{3}}{3}|}_{0}^{1} \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$\n\n- Statement “${\\int }_{C}F\\cdot \\text{d}r$ is independent of path” is false. Since ${C}_{1}$ and ${C}_{2}$ have the same initial and terminal points, yet\n\n$$\n{\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne {\\int }_{{C}_{2}}F\\cdot \\text{d}r,\n$$\n\nwe conclude that ${\\int }_{C}F\\cdot \\text{d}r$ is path-dependent.\n\n- Statement “$F$ is conservative” is false. If a vector field is conservative then it is path-independent. Since $F$ is path-dependent, it is not conservative."} {:db/id #edb/ref 17592186172300 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path" :topic/_knowledge-points [{:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360 :topic/title "Path Independence of Line Integrals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d40cf388-ace4-5cff-ada6-1673e5e97d67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448200} {:answer/id #uuid "3038d1f6-6212-58a8-b86d-a76d84b57160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448201}] :answer-field/correct {:answer/id #uuid "3038d1f6-6212-58a8-b86d-a76d84b57160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448201} :answer-field/id #uuid "fe07bb4a-705f-5e32-9710-7321adbcae68" :answer-field/key "$F$ is conservative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449140} {:answer-field/choices [{:answer/id #uuid "df2c42fd-7c23-501b-a763-96fa00dbe8ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448202} {:answer/id #uuid "94707d81-43e0-5f96-a07d-b6f0edb7ceec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448203}] :answer-field/correct {:answer/id #uuid "94707d81-43e0-5f96-a07d-b6f0edb7ceec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448203} :answer-field/id #uuid "673af9ea-69b0-5da6-8e80-899b018d9e08" :answer-field/key "${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449141} {:answer-field/choices [{:answer/id #uuid "c888a3f0-aad5-5214-8bc6-e27333ae2d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448204} {:answer/id #uuid "fa849542-2afc-5697-bb40-d4cdbcae4678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448205}] :answer-field/correct {:answer/id #uuid "fa849542-2afc-5697-bb40-d4cdbcae4678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448205} :answer-field/id #uuid "e7ca9ca1-ba5a-5998-8516-91b8d08ef6d3" :answer-field/key "${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{2}$ is the path along the curve $y=\\operatorname{ln}⁡(x+1),$ traversed from $O$ to $A.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449142}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77c64f72-bc4e-5149-99d1-c9f993fca3fa" :question/math-academy-id "q-125663" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{x+y},\\,{e}^{x+y}⟩$ and the points $O(0,0)$ and $A(1,\\operatorname{ln}⁡2)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement “$F$ is conservative” is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{x+y}.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement “${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$” is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf={e}^{x+y}.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(1,\\operatorname{ln}⁡2)-f(0,0) \\\\  & ={e}^{1+\\operatorname{ln}⁡2}-{e}^{0} \\\\  & =e\\cdot {e}^{\\operatorname{ln}⁡2}-1 \\\\  & =2e-1.\\end{aligned}\n$$\n\n- Statement “${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{2}$ is the path along the curve $y=\\operatorname{ln}⁡(x+1),$ traversed from $O$ to $A.$” is true. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=2e-1.\n$$\n\nTherefore, the correct answer is “$F$ is conservative”; “${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$”; “${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{2}$ is the path along the curve $y=\\operatorname{ln}⁡(x+1),$ traversed from $O$ to $A.$”."} {:db/id #edb/ref 17592186172569 :knowledge-point/_questions [{:db/id #edb/ref 17592186172018 :knowledge-point/id #uuid "244419de-9b13-5923-b0a5-1bdc6f9b03b2" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes" :topic/_knowledge-points [{:db/id #edb/ref 17592186048885 :topic/id #uuid "c96ee93a-fd82-595c-824f-e11934066ffc" :topic/math-academy-id 3350 :topic/title "Analyzing Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b141b2a6-6f61-5e9d-b419-e3770f1e0984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460083} {:answer/id #uuid "499fda92-d9e4-5263-8bc2-ef1eae055b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460084}] :answer-field/correct {:answer/id #uuid "b141b2a6-6f61-5e9d-b419-e3770f1e0984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460083} :answer-field/id #uuid "35a6896a-8a35-59c8-b44a-e1c9f4d15980" :answer-field/key "${y}^{′}=2xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460908} {:answer-field/choices [{:answer/id #uuid "97b25c56-fd70-5ee4-b322-d1c1653537cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460085} {:answer/id #uuid "e41e9c75-a017-527e-a98b-18fa337a8c2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460086}] :answer-field/correct {:answer/id #uuid "e41e9c75-a017-527e-a98b-18fa337a8c2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460086} :answer-field/id #uuid "4b9c4db5-7452-5f2e-863e-d11c400f2c88" :answer-field/key "${y}^{′}=-xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460909} {:answer-field/choices [{:answer/id #uuid "ef7cfed8-397e-5393-a6ec-a93e8c26ba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460087} {:answer/id #uuid "77654353-17a5-52c3-be06-25e9314c15c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460088}] :answer-field/correct {:answer/id #uuid "ef7cfed8-397e-5393-a6ec-a93e8c26ba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460087} :answer-field/id #uuid "0cdda0ee-37a2-5936-921a-0b1e86c097c4" :answer-field/key "${y}^{′}=x+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc5e6ef1-2f84-542e-97fb-884aded42acc" :question/math-academy-id "q-50189" :question/problem "![](images/35/35f52e6a2c3eafe59fea3c14351067fdf4b78b8c2f247454429952eb3a6f8270.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "![](images/e3/e3afa2080ea81f679c9c9b3423cfbe7b11bed5625854a0a33ff01312ca3629e4.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=0$ and $y=0$ divide the plane into $4$ regions. The sign of the slopes in each of the $4$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>0$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n| --- | --- | --- |\n| $y<0$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation ${y}^{′}=2xy$ does *not* give the required behavior. The right-hand side of ${y}^{′}=2xy$ evaluates to zero at $x=0$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>0$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation ${y}^{′}=-xy$ gives the required behavior. The right-hand side of ${y}^{′}=-xy$ evaluates to zero at $x=0$ and $y=0,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation ${y}^{′}=x+1$ does *not* give the required behavior. The right-hand side of ${y}^{′}=x+1$ evaluates to zero at $x=-1$ only.\n\nTherefore, the correct answer is ${y}^{′}=-xy$ only."} {:db/id #edb/ref 17592186172570 :knowledge-point/_questions [{:db/id #edb/ref 17592186172016 :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes" :topic/_knowledge-points [{:db/id #edb/ref 17592186048885 :topic/id #uuid "c96ee93a-fd82-595c-824f-e11934066ffc" :topic/math-academy-id 3350 :topic/title "Analyzing Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d483db5-6039-5d58-9b7b-a5d6e48e9a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460089} {:answer/id #uuid "df151d3c-0083-537d-973e-6b958d2bbc8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460090}] :answer-field/correct {:answer/id #uuid "0d483db5-6039-5d58-9b7b-a5d6e48e9a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460089} :answer-field/id #uuid "d7cfed0f-a2db-5e00-808a-4d45f47c795a" :answer-field/key "${y}^{′}=x+y+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460911} {:answer-field/choices [{:answer/id #uuid "8cc687fe-4f1a-521c-96b7-0f1fd9c2adc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460091} {:answer/id #uuid "8cd90ba0-d4b3-52ee-a268-5996b8b70b62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460092}] :answer-field/correct {:answer/id #uuid "8cc687fe-4f1a-521c-96b7-0f1fd9c2adc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460091} :answer-field/id #uuid "bf6c66a4-f7e4-538f-971a-ecb469a5345b" :answer-field/key "${y}^{′}=\\frac{y}{x+1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460912} {:answer-field/choices [{:answer/id #uuid "b5886b67-6ce4-5655-82bc-93d3a41a0cad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460093} {:answer/id #uuid "5ec40f2c-6393-51e9-b19d-5d116ac5a3f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460094}] :answer-field/correct {:answer/id #uuid "5ec40f2c-6393-51e9-b19d-5d116ac5a3f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460094} :answer-field/id #uuid "358eabbd-0671-553b-b06f-c57f46cb2e67" :answer-field/key "${y}^{′}=\\frac{y}{x-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460913}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51432cc0-402d-52de-881d-7043efbc4221" :question/math-academy-id "q-50350" :question/problem "![](images/2f/2f577535c7e293a64139c0c68d2f09ea083041d806a634ae2d9a27055e96c00d.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/b8/b8a9560870e28c751b8869e298ffabdbcc23eec720c7a1057d55032a62767183.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The slopes of the slope field become vertical as $x\\to 1.$\n\n- The slopes of the slope field become horizontal at $y=0.$\n\nWith that in mind, let's consider each equation.\n\n- Equation ${y}^{′}=x+y+1$ does *not* give the required behavior. The right-hand side of ${y}^{′}=x+y+1$ does not evaluate to zero on $y=0$ (the value depends on $x$).\n\n- Equation ${y}^{′}=\\frac{y}{x+1}$ does *not* give the required behavior. The right-hand side of ${y}^{′}=\\frac{y}{x+1}$ evaluates to zero on $y=0,$ but \n\n$$\n{y}^{′}=\\frac{y}{x+1}\\to \\frac{y}{2}<\\infty \\,\\text{as}\\,x\\to 1.\n$$\n\n- Equation ${y}^{′}=\\frac{y}{x-1}$ gives the required behavior. The right-hand side of ${y}^{′}=\\frac{y}{x-1}$ evaluates to zero on $y=0,$ and \n\n$$\n{y}^{′}=|\\frac{y}{x-1}|\\to \\infty \\,\\text{as}\\,x\\to 1.\n$$\n\nTherefore, the correct answer is ${y}^{′}=\\frac{y}{x-1}$ only."} {:db/id #edb/ref 17592186172602 :knowledge-point/_questions [{:db/id #edb/ref 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9" :topic/_knowledge-points [{:db/id #edb/ref 17592186050318 :topic/id #uuid "3f7c8941-2bc1-5431-84b6-f34e556ea057" :topic/math-academy-id 3543 :topic/title "Divisibility of Integers by 3, 9, 6, and 7"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0e33143-acf7-5a35-af03-1a3487463d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460335} {:answer/id #uuid "c7f95c13-e187-549c-87e2-fbffba81c296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460336}] :answer-field/correct {:answer/id #uuid "e0e33143-acf7-5a35-af03-1a3487463d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460335} :answer-field/id #uuid "dc3513cd-5c77-58cb-bb51-0abd79ba01eb" :answer-field/key "$187\\,349$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461034} {:answer-field/choices [{:answer/id #uuid "174cfbd6-74ba-5052-af95-0af1127d8cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460337} {:answer/id #uuid "be0d0a96-668a-56e9-a0b0-2ed0f06cd4f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460338}] :answer-field/correct {:answer/id #uuid "be0d0a96-668a-56e9-a0b0-2ed0f06cd4f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460338} :answer-field/id #uuid "0db23ba0-8d4f-56d8-9943-169c2a62d527" :answer-field/key "$3\\,121\\,557$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461035} {:answer-field/choices [{:answer/id #uuid "9f7987c2-ada2-57d0-8865-0a8cb42ef70e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460339} {:answer/id #uuid "5b4748c9-7f66-5f88-9232-e52d09181370" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460340}] :answer-field/correct {:answer/id #uuid "9f7987c2-ada2-57d0-8865-0a8cb42ef70e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460339} :answer-field/id #uuid "6add55b9-a06d-5597-92a2-21c0d2720224" :answer-field/key "$99\\,125\\,041$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461036}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "335dd6d1-31fa-5c3c-b1bf-3369de1a0d91" :question/math-academy-id "q-85143" :question/problem "Which of the following numbers are divisible by $3?$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $3$ if the sum of its digits is divisible by $3.$\n\n- The sum of the digits of $187\\,349$ is\n\n$$\n1+8+7+3+4+9=32,\n$$\n\nwhich is *not* divisible by $3.$ So, $187\\,349$ is *not* divisible by $3.$\n\n- The sum of the digits of $3\\,121\\,557$ is\n\n$$\n3+1+2+1+5+5+7=24,\n$$\n\nwhich is divisible by $3.$ So, $3\\,121\\,557$ is divisible by $3.$\n\n- The sum of the digits of $99\\,125\\,041$ is\n\n$$\n9+9+1+2+5+0+4+1=31,\n$$\n\nwhich is *not* divisible by $3.$ So, $99\\,125\\,041$ is *not* divisible by $3.$\n\nTherefore, the correct answer is $3\\,121\\,557$ only."} {:db/id #edb/ref 17592186172617 :knowledge-point/_questions [{:db/id #edb/ref 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048224 :topic/id #uuid "89b54209-d10d-5a8f-8829-a2f0c5ee66d4" :topic/math-academy-id 3353 :topic/title "Modeling With the Exponential Distribution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51fd05d6-e9be-513c-a69d-3449f70f0be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460413} {:answer/id #uuid "0bae9af9-66ad-5af7-8f2d-73b6bba01d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460414}] :answer-field/correct {:answer/id #uuid "0bae9af9-66ad-5af7-8f2d-73b6bba01d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460414} :answer-field/id #uuid "314bfb8e-a7ec-5a5d-ad04-1c6ddbf49497" :answer-field/key "The amount of time until the next earthquake in a particular country" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461073} {:answer-field/choices [{:answer/id #uuid "78b73296-a401-593d-98e6-443c98150d51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460415} {:answer/id #uuid "90bc5d04-dc44-5307-b33f-b534b997b91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460416}] :answer-field/correct {:answer/id #uuid "78b73296-a401-593d-98e6-443c98150d51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460415} :answer-field/id #uuid "23d3ccf2-6d6a-566e-93da-c459cf822047" :answer-field/key "The number of giraffes in a zoo" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461074} {:answer-field/choices [{:answer/id #uuid "eb976e71-e022-559b-8644-8f65abb52a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460417} {:answer/id #uuid "723b033d-cb1a-5969-a52d-2e746283c810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460418}] :answer-field/correct {:answer/id #uuid "eb976e71-e022-559b-8644-8f65abb52a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460417} :answer-field/id #uuid "8effdf06-eee0-5a25-b7fb-3fdba248a84d" :answer-field/key "The number of defective bottles produced in a factory in a single day" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aedbbdaa-f6b9-52ee-98ba-ab79d3a64164" :question/math-academy-id "q-94945" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nSelect all that apply." :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable “The amount of time until the next earthquake in a particular country” could be modeled using an exponential distribution. Earthquakes can be modeled as independent events with a constant average rate, and we wish to know the amount of time until the next earthquake occurs.\n\n- Random variable “The number of giraffes in a zoo” does *not* follow an exponential distribution. There are no events that occur at a constant average rate, and there is no interval of continuous time or space.\n\n- Random variable “The number of defective bottles produced in a factory in a single day” does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of defective bottles produced is discrete, not continuous.\n\nTherefore, the correct answer is “The amount of time until the next earthquake in a particular country” only."} {:db/id #edb/ref 17592186172625 :knowledge-point/_questions [{:db/id #edb/ref 17592186172029 :knowledge-point/id #uuid "7a6bbb34-a43f-5e16-8a24-25c0d6970a38" :knowledge-point/title "Identifying a Quadratic Curve Type From Its Reduced Equation: No Cross-Product Term" :topic/_knowledge-points [{:db/id #edb/ref 17592186050760 :topic/id #uuid "64670a5e-dd35-51fc-bd24-210590f74fcd" :topic/math-academy-id 3336 :topic/title "Classifying Quadratic Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f74e5cac-5fa1-5913-b097-bbfbb558a4ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477491} {:answer/id #uuid "b04d30a9-862b-5922-aa61-4c21080e6261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477492}] :answer-field/correct {:answer/id #uuid "b04d30a9-862b-5922-aa61-4c21080e6261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477492} :answer-field/id #uuid "4e9331d7-eb32-5848-a41a-7768e9e3c9dd" :answer-field/key "${x}_{1}^{2}=6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477715} {:answer-field/choices [{:answer/id #uuid "739f9b2d-f525-52a6-9c4c-b5f7a895148d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477493} {:answer/id #uuid "aeb66722-f6bc-5c27-b93b-33f61576756f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477494}] :answer-field/correct {:answer/id #uuid "739f9b2d-f525-52a6-9c4c-b5f7a895148d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477493} :answer-field/id #uuid "ad460fe6-a6b8-5d19-8fcd-46fae2f7d401" :answer-field/key "${x}_{1}^{2}+\\frac{{x}_{2}^{2}}{5}=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477716} {:answer-field/choices [{:answer/id #uuid "bb480cd5-e9a4-517a-b0d5-4fcec4bff81d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477495} {:answer/id #uuid "8a869b7d-6beb-5fe3-93e8-d4e81ef106e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477496}] :answer-field/correct {:answer/id #uuid "bb480cd5-e9a4-517a-b0d5-4fcec4bff81d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477495} :answer-field/id #uuid "854812e6-d405-5148-8484-67f195d21ee7" :answer-field/key "${x}_{2}^{2}=-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477717}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "098d9a26-30b9-593f-93e1-d543e66fd2ef" :question/math-academy-id "q-95703" :question/problem "Which of the following equations define a non-empty set of points in the ${x}_{1}{x}_{2}$-plane?\n\nSelect all that apply." :question/worked-solution "Let's examine each of the equations in turn.\n\n- The equation ${x}_{1}^{2}=6$ defines a non-empty set. It represents two parallel lines, ${x}_{1}=-\\sqrt{6}$ and ${x}_{1}=\\sqrt{6}.$\n\n- The equation ${x}_{1}^{2}+\\frac{{x}_{2}^{2}}{5}=-1$ defines an empty set. Notice that the left-hand side is non-negative for all ${x}_{1}$ and ${x}_{2},$ while the right-hand side is negative.\n\n- The equation ${x}_{2}^{2}=-7$ defines an empty set. Notice that the left-hand side is non-negative for all ${x}_{2},$ while the right-hand side is negative.\n\nTherefore, the correct answer is ${x}_{1}^{2}=6$ only."} {:db/id #edb/ref 17592186172633 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges" :topic/_knowledge-points [{:db/id #edb/ref 17592186050312 :topic/id #uuid "3efe4c7e-e297-5f41-9d4f-bfd04820c753" :topic/math-academy-id 3334 :topic/title "Sets and Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7d39614-3a0d-5019-ab46-bf9577d64929" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460443} {:answer/id #uuid "69cedd4b-35c9-5dbb-a995-5e3511170b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460444}] :answer-field/correct {:answer/id #uuid "69cedd4b-35c9-5dbb-a995-5e3511170b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460444} :answer-field/id #uuid "7f161b74-f756-58ca-afa3-c1dafe425435" :answer-field/key "The domain of $f$ is ${0,1,2,3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461088} {:answer-field/choices [{:answer/id #uuid "46c77432-6659-5a30-943f-15a4679f65f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460445} {:answer/id #uuid "2da146eb-b89a-5766-88ab-7eb0b717ab7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460446}] :answer-field/correct {:answer/id #uuid "46c77432-6659-5a30-943f-15a4679f65f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460445} :answer-field/id #uuid "e1d2ffa6-7b45-5b57-ba9f-c5937f558a93" :answer-field/key "The codomain of $f$ is ${0,-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461089} {:answer-field/choices [{:answer/id #uuid "d094dd62-3065-5bbc-a3c9-3ca38d07f9df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460447} {:answer/id #uuid "e9f53fb0-5e72-5204-a844-3ee89538f8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460448}] :answer-field/correct {:answer/id #uuid "e9f53fb0-5e72-5204-a844-3ee89538f8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460448} :answer-field/id #uuid "78f494c5-7b9d-5aa5-ac60-a7c153efdbeb" :answer-field/key "The range of $f$ is ${0,-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461090}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06b8a099-20b6-59c6-83ca-7950b58f1030" :question/math-academy-id "q-96123" :question/problem "![](images/dc/dcee145044fe79dc7f4d07c3c4c1248df358cd8eda7a173cd8d4641f13404122.png)\n\nConsider the function $f:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nThe range of $f$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $f$ is $X={0,1,2,3},$\n\n- the codomain of $f$ is $Y={0,-1,-2},$\n\n- the range of $f$ is ${0,-1},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements “The domain of $f$ is ${0,1,2,3}$” and “The range of $f$ is ${0,-1}$” are true, while statement “The codomain of $f$ is ${0,-1}$” is false.\n\nTherefore, the correct answer “The domain of $f$ is ${0,1,2,3}$”; “The range of $f$ is ${0,-1}$” only."} {:db/id #edb/ref 17592186172639 :knowledge-point/_questions [{:db/id #edb/ref 17592186172041 :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative" :topic/_knowledge-points [{:db/id #edb/ref 17592186048489 :topic/id #uuid "a42b014b-839c-50bc-ab24-36abe7ee39ce" :topic/math-academy-id 3352 :topic/title "Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da12ce2e-948a-5da1-b6c4-ad3cf04c71f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440005} {:answer/id #uuid "2f3ad942-a0cf-5a11-addd-9344559df32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440006}] :answer-field/correct {:answer/id #uuid "2f3ad942-a0cf-5a11-addd-9344559df32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440006} :answer-field/id #uuid "efceae93-0e9a-5328-a673-594e38c76d62" :answer-field/key "At every point $(x, y)$ where $x > 1$ and $y > - 2$, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440360} {:answer-field/choices [{:answer/id #uuid "565446c4-7f3f-5d73-9316-39b5cad28fac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440007} {:answer/id #uuid "9973734a-4ca1-5ea9-b1e8-ac4cb9640a9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440008}] :answer-field/correct {:answer/id #uuid "565446c4-7f3f-5d73-9316-39b5cad28fac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440007} :answer-field/id #uuid "d58bf482-6466-584a-bdea-38251341fcdb" :answer-field/key "At every point $(x, y)$ where $x < 1$ and $y > - 2$, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440361} {:answer-field/choices [{:answer/id #uuid "08dd43ae-dafe-50fa-a506-9626463b04ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440009} {:answer/id #uuid "f1dd840c-1ae3-5613-8645-575ecdd71746" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440010}] :answer-field/correct {:answer/id #uuid "08dd43ae-dafe-50fa-a506-9626463b04ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440009} :answer-field/id #uuid "c6a8eb7e-030d-57b8-89a2-4a3b521b0192" :answer-field/key "At every point $(x, y)$ where $x > 1$ and $y < - 2$, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440362}] :question/id #uuid "4026efcc-47dd-5838-ae2e-6298d2d740c1" :question/math-academy-id "q-96475" :question/problem "Consider the differential equation $\\frac{dy}{dx} = (x - 1)(y + 2)$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For (x-1)(y+2), both factors are positive in region “At every point $(x, y)$ where $x > 1$ and $y > - 2$, the slope of the slope field is positive”. In regions “At every point $(x, y)$ where $x < 1$ and $y > - 2$, the slope of the slope field is positive” and “At every point $(x, y)$ where $x > 1$ and $y < - 2$, the slope of the slope field is positive” one factor is negative and one positive. Only statement “At every point $(x, y)$ where $x > 1$ and $y > - 2$, the slope of the slope field is positive” is true."} {:db/id #edb/ref 17592186172642 :knowledge-point/_questions [{:db/id #edb/ref 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048224 :topic/id #uuid "89b54209-d10d-5a8f-8829-a2f0c5ee66d4" :topic/math-academy-id 3353 :topic/title "Modeling With the Exponential Distribution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbc3f87c-6730-56a9-8853-acc1b2d1760c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460467} {:answer/id #uuid "8331e18d-65be-57cd-ab77-8e950fec3a18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460468}] :answer-field/correct {:answer/id #uuid "8331e18d-65be-57cd-ab77-8e950fec3a18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460468} :answer-field/id #uuid "cfcc64b2-2df8-523e-bbcf-b20e4ac51e44" :answer-field/key "The time interval between successive incidents at a particular crossroads" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461100} {:answer-field/choices [{:answer/id #uuid "fe2e6873-0973-53ac-b083-41af0b94929a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460469} {:answer/id #uuid "238b5d93-9a3f-5979-bf39-af975d141839" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460470}] :answer-field/correct {:answer/id #uuid "fe2e6873-0973-53ac-b083-41af0b94929a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460469} :answer-field/id #uuid "fbe4c71a-24ac-504b-9286-169b2b2017a6" :answer-field/key "The number of incidents in a month at a particular crossroads" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461101} {:answer-field/choices [{:answer/id #uuid "3d49d928-03b0-5904-8af3-39b694501a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460471} {:answer/id #uuid "39656ff0-9038-5ffe-8742-1e6ff1adc5a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460472}] :answer-field/correct {:answer/id #uuid "3d49d928-03b0-5904-8af3-39b694501a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460471} :answer-field/id #uuid "b6537a50-3047-53ac-b57b-eabb4bf2c985" :answer-field/key "The speed of a car that arrives at a particular crossroads" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461102}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d96e1ffd-8a4d-5e80-a6cb-f6d62a7321bd" :question/math-academy-id "q-96661" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nSelect all that apply." :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable “The time interval between successive incidents at a particular crossroads” could be modeled using an exponential distribution. Incidents can be modeled as independent events with a constant average rate, and we wish to know the amount of time until the next incident occurs.\n\n- Random variable “The number of incidents in a month at a particular crossroads” does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of incidents in a month is discrete, not continuous.\n\n- Random variable “The speed of a car that arrives at a particular crossroads” does *not* follow an exponential distribution. There are no events that occur at a constant average rate.\n\nTherefore, the correct answer is “The time interval between successive incidents at a particular crossroads” only."} {:db/id #edb/ref 17592186172645 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative" :topic/_knowledge-points [{:db/id #edb/ref 17592186048489 :topic/id #uuid "a42b014b-839c-50bc-ab24-36abe7ee39ce" :topic/math-academy-id 3352 :topic/title "Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "817b7d0e-081e-5f65-8394-7b2aa4d4b020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438622} {:answer/id #uuid "51e53bdb-ad9b-5fde-96ad-6776ae72ee75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438623}] :answer-field/correct {:answer/id #uuid "51e53bdb-ad9b-5fde-96ad-6776ae72ee75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438623} :answer-field/id #uuid "87784eaa-7f37-5cfd-bf94-f676298d7eb1" :answer-field/key "At every point in the first quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439340} {:answer-field/choices [{:answer/id #uuid "434b294c-ea0b-5331-849a-fa7706de7c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438624} {:answer/id #uuid "a7afa29d-56b9-57cf-9491-c30536a33167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438625}] :answer-field/correct {:answer/id #uuid "434b294c-ea0b-5331-849a-fa7706de7c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438624} :answer-field/id #uuid "c8a8760c-7b07-5de6-8cb4-15b2d479532a" :answer-field/key "At every point in the second quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439341} {:answer-field/choices [{:answer/id #uuid "005ad32f-fad3-5e4b-9876-1dea386fda92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438626} {:answer/id #uuid "da8dc176-0ecf-5a7b-9dd5-659d6a397554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438627}] :answer-field/correct {:answer/id #uuid "da8dc176-0ecf-5a7b-9dd5-659d6a397554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438627} :answer-field/id #uuid "83dc6e63-ac75-598d-8eb8-29e5e8e60f37" :answer-field/key "At every point in the third quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd7005de-da4a-5aae-a0ea-f0c01c178438" :question/math-academy-id "q-96767" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=2xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the first quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\\,\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the second quadrant, the slope of the slope field is positive” is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\\,\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement “At every point in the third quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\\,\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant."} {:db/id #edb/ref 17592186172648 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative" :topic/_knowledge-points [{:db/id #edb/ref 17592186048489 :topic/id #uuid "a42b014b-839c-50bc-ab24-36abe7ee39ce" :topic/math-academy-id 3352 :topic/title "Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3c0e91a-8719-5dbf-92fb-86a7721ef654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440023} {:answer/id #uuid "55bf2da5-d708-5480-8ab8-1441064688e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440024}] :answer-field/correct {:answer/id #uuid "a3c0e91a-8719-5dbf-92fb-86a7721ef654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440023} :answer-field/id #uuid "402941ab-b608-5343-ad5f-8ac1f83f99c2" :answer-field/key "At every point in the first quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440369} {:answer-field/choices [{:answer/id #uuid "e82d40ad-c41b-57a8-a872-ff25ef67196e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440025} {:answer/id #uuid "fa689d24-4924-55c6-8219-2928fe0f7962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440026}] :answer-field/correct {:answer/id #uuid "fa689d24-4924-55c6-8219-2928fe0f7962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440026} :answer-field/id #uuid "097f13ad-dd16-5c08-84cd-9bb354ae065e" :answer-field/key "At every point in the second quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440370} {:answer-field/choices [{:answer/id #uuid "934c3087-576f-525a-b55f-b5b5ad9f17fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440027} {:answer/id #uuid "926d422e-445c-57ec-9858-ba3785eafd46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440028}] :answer-field/correct {:answer/id #uuid "926d422e-445c-57ec-9858-ba3785eafd46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440028} :answer-field/id #uuid "f873dbf2-94f8-5412-b40f-fa9306104dc1" :answer-field/key "At every point in the third quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440371}] :question/id #uuid "1142a38e-b72d-5615-beec-20a68972aab2" :question/math-academy-id "q-97483" :question/problem "Consider the differential equation $\\frac{dy}{dx} = xy^{2}$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For xy^2, y^2 is positive in every open quadrant, so the slope has the sign of x. It is negative in quadrants II and III, and positive in quadrant I."} {:db/id #edb/ref 17592186172649 :knowledge-point/_questions [{:db/id #edb/ref 17592186172041 :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative" :topic/_knowledge-points [{:db/id #edb/ref 17592186048489 :topic/id #uuid "a42b014b-839c-50bc-ab24-36abe7ee39ce" :topic/math-academy-id 3352 :topic/title "Slope Fields for Nonautonomous Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d00f36e2-7dd8-58b5-a5b1-0ebba7aa6933" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438658} {:answer/id #uuid "a46a6654-913e-5d83-b11d-f2b6cc46331e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438659}] :answer-field/correct {:answer/id #uuid "a46a6654-913e-5d83-b11d-f2b6cc46331e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438659} :answer-field/id #uuid "b9fcc13e-f640-566c-9e43-967f6aad6e96" :answer-field/key "At every point $(x,y)$ where $x<-1$ and $y>2,$ the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439358} {:answer-field/choices [{:answer/id #uuid "8be5feeb-9d33-592c-a7c3-de2eabcecb75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438660} {:answer/id #uuid "ba8012c8-d490-5f67-b39d-c4d8b2098520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438661}] :answer-field/correct {:answer/id #uuid "ba8012c8-d490-5f67-b39d-c4d8b2098520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438661} :answer-field/id #uuid "f9ecebbf-d075-56b9-875f-97282f7006cc" :answer-field/key "At every point $(x,y)$ where $x<-1$ and $y<2,$ the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439359} {:answer-field/choices [{:answer/id #uuid "7480480b-28cb-58dd-9d62-47133cd8e084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438662} {:answer/id #uuid "26b8d424-6ae7-5f06-89f8-162aeb05ca51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438663}] :answer-field/correct {:answer/id #uuid "26b8d424-6ae7-5f06-89f8-162aeb05ca51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438663} :answer-field/id #uuid "7c7ae5f0-6a16-510b-b3e1-9d80c0ffee45" :answer-field/key "At every point $(x,y)$ where $x>-1$ and $y<2,$ the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e86fafab-049b-51e4-93da-aada8761c377" :question/math-academy-id "q-97538" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x+1)^{2}(y-2)$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=(x+1)^{2}(y-2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=-1$ or $y=2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/1f/1f4b1b2ca736fb83eff0a4b85a3f479bf99b3b337492d0a77abe739038ed141f.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/fd/fdafadd1631a75c2998aaed5c6bad62a3ea1dcc0ac57d245a00d167e74aa3bb4.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point $(x,y)$ where $x<-1$ and $y>2,$ the slope of the slope field is positive” is true. If $x<-1$ and $y>2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement “At every point $(x,y)$ where $x<-1$ and $y<2,$ the slope of the slope field is negative” is true. If $x<-1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement “At every point $(x,y)$ where $x>-1$ and $y<2,$ the slope of the slope field is negative” is true. If $x>-1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region."} {:db/id #edb/ref 17592186172664 :knowledge-point/_questions [{:db/id #edb/ref 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves" :topic/_knowledge-points [{:db/id #edb/ref 17592186048655 :topic/id #uuid "b2c456e2-ef0a-5a75-95da-68bb5f61da4a" :topic/math-academy-id 3356 :topic/title "Simple, Closed, and Oriented Curves"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52dbce36-54c0-52ac-b02a-1a0dcf5281a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460491} {:answer/id #uuid "cb0e4957-fb2d-57b1-b861-533d087a82b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460492}] :answer-field/correct {:answer/id #uuid "cb0e4957-fb2d-57b1-b861-533d087a82b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460492} :answer-field/id #uuid "fe217ebf-4848-5f37-8c0d-c9ae496feff3" :answer-field/key "![Curve I](images/33/331d09701db83dfc483e5792326e0bd8fb027fb014ee1a5ade5d4f5a0511bc0b.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461112} {:answer-field/choices [{:answer/id #uuid "5fbecd13-3f32-58ff-9467-3e1801e294d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460493} {:answer/id #uuid "c890c2fa-e9d2-51ca-a390-9aa83b1fc562" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460494}] :answer-field/correct {:answer/id #uuid "5fbecd13-3f32-58ff-9467-3e1801e294d2" :