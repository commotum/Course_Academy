′}-xy=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464875} {:answer-field/choices [{:answer/id #uuid "aef3aa88-07ae-5c22-b0e4-3dcd060e653f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463884} {:answer/id #uuid "f1b6dc71-fa1f-5546-a7a1-52cd8f76be5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463885}] :answer-field/correct {:answer/id #uuid "aef3aa88-07ae-5c22-b0e4-3dcd060e653f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463884} :answer-field/id #uuid "920346ba-105f-56c1-baa3-ede3853ae5b9" :answer-field/key "$\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7e46e30-10b0-546e-b7af-e3d72616cbd7" :question/math-academy-id "q-130671" :question/problem "Which of the following second-order differential equations are linear?\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2\n$$\n\nis a second-order linear ODE with $a(x)=\\operatorname{ln}⁡x,b(x)=-x,c(x)=1,$ and $f(x)=2.$\n\n- The equation\n\n$$\n{y}^{3}{y}^{″}+x{y}^{′}-xy=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${y}^{3}{y}^{″}.$\n\n- The equation\n\n$$\n\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}\n$$\n\nis **NOT** linear because it contains the nonlinear term $xy{y}^{′}.$\n\nTherefore, the correct answer is $(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2$ only."} {:db/id #edb/ref 17592186265955 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050677 :topic/id #uuid "5e132315-9606-5b30-bee3-61f0209d40c4" :topic/math-academy-id 2548 :topic/title "Introduction to Second-Order Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d90b07b-3b2f-5dd7-ae06-6bd4d25eaaaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463886} {:answer/id #uuid "41052ad9-08e4-5109-873f-da03122a643d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463887}] :answer-field/correct {:answer/id #uuid "3d90b07b-3b2f-5dd7-ae06-6bd4d25eaaaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463886} :answer-field/id #uuid "b0b765e3-1d1e-5789-ba6d-dddb94ca8a11" :answer-field/key "${e}^{2y}{y}^{″}-{x}^{2}{y}^{′}+3=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464877} {:answer-field/choices [{:answer/id #uuid "d0be1a6c-64d1-5b97-a693-794b4829a6c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463888} {:answer/id #uuid "40011b59-21dd-5ba2-87ee-913716a1d1ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463889}] :answer-field/correct {:answer/id #uuid "40011b59-21dd-5ba2-87ee-913716a1d1ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463889} :answer-field/id #uuid "548b2170-1a70-57b4-86ca-f3f786af7cf1" :answer-field/key "${e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464878} {:answer-field/choices [{:answer/id #uuid "5c59c159-20ee-55f0-9f4e-38ae699b98aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463890} {:answer/id #uuid "c479bd4a-bf8c-58d2-967d-6955dc92faff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463891}] :answer-field/correct {:answer/id #uuid "c479bd4a-bf8c-58d2-967d-6955dc92faff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463891} :answer-field/id #uuid "9f38b6f5-41a6-5ff9-854d-45366f49a5e0" :answer-field/key "${y}^{″}-2x{y}^{′}+5y=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e471b0b-273f-5999-b584-35af7a25a9a4" :question/math-academy-id "q-130675" :question/problem "Which of the following second-order differential equations are linear?\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n{e}^{2y}{y}^{″}-{x}^{2}{y}^{′}+3=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${e}^{2y}{y}^{″}.$\n\n- The equation\n\n$$\n{e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2\n$$\n\nis a second-order linear ODE with $a(x)={e}^{x},b(x)=4,c(x)=0,$ and $f(x)=2+x\\operatorname{sin}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}-2x{y}^{′}+5y=x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=-2x,c(x)=5,$ and $f(x)=x.$\n\nTherefore, the correct answer is ${e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2$; ${y}^{″}-2x{y}^{′}+5y=x$ only."} {:db/id #edb/ref 17592186265956 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs" :topic/_knowledge-points [{:db/id #edb/ref 17592186050677 :topic/id #uuid "5e132315-9606-5b30-bee3-61f0209d40c4" :topic/math-academy-id 2548 :topic/title "Introduction to Second-Order Linear ODEs"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5376bc4a-d2ee-53b0-8e83-f4f85ee671db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463892} {:answer/id #uuid "e836b290-1712-593e-90f1-85ca64c5b2f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463893}] :answer-field/correct {:answer/id #uuid "5376bc4a-d2ee-53b0-8e83-f4f85ee671db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463892} :answer-field/id #uuid "e61661a3-fd91-5136-a7ad-2a91a6b84524" :answer-field/key "$2{x}^{2}{y}^{″}-\\operatorname{ln}⁡x\\,{y}^{′}+{y}^{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464880} {:answer-field/choices [{:answer/id #uuid "dcf03b04-4823-5f32-bafa-b26f7eff5b14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463894} {:answer/id #uuid "f58e7ac7-373e-5c44-b04b-79bdda1f1397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463895}] :answer-field/correct {:answer/id #uuid "f58e7ac7-373e-5c44-b04b-79bdda1f1397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463895} :answer-field/id #uuid "734e4fb0-c9f7-5eb8-a761-e27666d89c5a" :answer-field/key "$2{y}^{″}+{x}^{3}{y}^{′}+2xy=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464881} {:answer-field/choices [{:answer/id #uuid "cca0dd39-832e-5666-a234-19e027e0e5e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463896} {:answer/id #uuid "d26d49be-9c70-5131-999c-164faa0ba30d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463897}] :answer-field/correct {:answer/id #uuid "d26d49be-9c70-5131-999c-164faa0ba30d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463897} :answer-field/id #uuid "9d9e8741-b915-5b8c-96a9-8e10a9e3c79e" :answer-field/key "${y}^{″}+x{y}^{′}=x{e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66d63369-22c5-5a2f-adb6-cc0d49c2dc04" :question/math-academy-id "q-130677" :question/problem "Which of the following second-order differential equations are linear?\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n2{x}^{2}{y}^{″}-\\operatorname{ln}⁡x\\,{y}^{′}+{y}^{2}=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${y}^{2}.$\n\n- The equation\n\n$$\n2{y}^{″}+{x}^{3}{y}^{′}+2xy=0\n$$\n\nis a second-order linear ODE with $a(x)=2,b(x)={x}^{3},c(x)=2x,$ and $f(x)=0.$\n\n- The equation\n\n$$\n{y}^{″}+x{y}^{′}=x{e}^{x}\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=x,c(x)=0,$ and $f(x)=x{e}^{x}.$\n\nTherefore, the correct answer is $2{y}^{″}+{x}^{3}{y}^{′}+2xy=0$; ${y}^{″}+x{y}^{′}=x{e}^{x}$ only."} {:db/id #edb/ref 17592186265973 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050576 :topic/id #uuid "54fffdff-21ee-5191-90e6-7d1d444eefd6" :topic/math-academy-id 1726 :topic/title "Elementary 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82c68fda-0f42-5c48-9715-68ca5d6ebb8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463898} {:answer/id #uuid "ae743fce-b45e-5abc-bd86-752ba9bcbc46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463899}] :answer-field/correct {:answer/id #uuid "ae743fce-b45e-5abc-bd86-752ba9bcbc46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463899} :answer-field/id #uuid "01448568-f01a-5eb2-9776-853e263f1da6" :answer-field/key "$A=\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464883} {:answer-field/choices [{:answer/id #uuid "78b1bf75-980f-5157-a21e-c5aaa7d1d2bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463900} {:answer/id #uuid "ce2a98f4-65b2-5c86-bfcb-8b40e5c7595b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463901}] :answer-field/correct {:answer/id #uuid "ce2a98f4-65b2-5c86-bfcb-8b40e5c7595b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463901} :answer-field/id #uuid "124e1032-53d8-59c4-9767-8aa9b08c5f27" :answer-field/key "$B=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464884} {:answer-field/choices [{:answer/id #uuid "11393e6b-38fe-5ee8-a898-8839130cc2bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463902} {:answer/id #uuid "1d89d028-e268-579c-869b-ea7d5ab042e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463903}] :answer-field/correct {:answer/id #uuid "11393e6b-38fe-5ee8-a898-8839130cc2bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463902} :answer-field/id #uuid "2539df0a-7237-5aec-a2e8-de82405d21b5" :answer-field/key "$C=\\begin{bmatrix}1 & -1 \\\\ 4 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ec5e472-dc1d-5891-bb93-866a6d9b3914" :question/math-academy-id "q-130774" :question/problem "Which of the following are elementary matrices?\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:={R}_{1}+{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix} \\\\  & =A\\end{aligned}\n$$\n\n- The matrix $B$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}↔{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\nTherefore, only $A$ and $B$ are elementary matrices."} {:db/id #edb/ref 17592186265998 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations" :topic/_knowledge-points [{:db/id #edb/ref 17592186048920 :topic/id #uuid "cc887b1d-8841-507d-a99b-b7888c08a675" :topic/math-academy-id 1728 :topic/title "Finding the Inverse of a 2x2 Matrix Using Row Operations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85584b3a-c6d4-52ce-a49a-aa5715567882" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463904} {:answer/id #uuid "cf095273-2cd2-5877-9b70-2ae96d4c801f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463905}] :answer-field/correct {:answer/id #uuid "85584b3a-c6d4-52ce-a49a-aa5715567882" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463904} :answer-field/id #uuid "bb66091b-2fc4-59f6-a708-47550a698f13" :answer-field/key "$A=\\begin{bmatrix}2 & 2 \\\\ 1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464886} {:answer-field/choices [{:answer/id #uuid "4a6db556-cb94-59ea-a9e7-0f8969a09752" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463906} {:answer/id #uuid "9d4c9764-6730-51df-88b4-124dc