 :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464046} :answer-field/id #uuid "5e30fd3b-e7f4-559e-b421-362f09cc1271" :answer-field/key "$q$ is a steady-state vector of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464957}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "05952a75-ee49-5c6e-985c-55f5554bd3f6" :question/math-academy-id "q-135311" :question/problem "$$\nP=\\begin{bmatrix}0.3 & 0.15 & 0.6 \\\\ 0.6 & 0.7 & 0.35 \\\\ 0.1 & 0.15 & 0.05\\end{bmatrix},\\,q=\\begin{bmatrix}0.1 \\\\ 0.7 \\\\ 0.2\\end{bmatrix}\n$$\n\nConsider the stochastic matrix $P$ and vector $q$ shown above. Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that $Pq=q.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “$q$ is a stochastic vector” is true. Indeed, $q$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement $Pq=q$ is false. Note that\n\n$$\nPq=\\begin{bmatrix}0.3 & 0.15 & 0.6 \\\\ 0.6 & 0.7 & 0.35 \\\\ 0.1 & 0.15 & 0.05\\end{bmatrix}\\begin{bmatrix}0.1 \\\\ 0.7 \\\\ 0.2\\end{bmatrix}=\\begin{bmatrix}0.03+0.105+0.12 \\\\ 0.06+0.49+0.07 \\\\ 0.01+0.105+0.01\\end{bmatrix}=\\begin{bmatrix}0.255 \\\\ 0.62 \\\\ 0.125\\end{bmatrix}\\ne q.\n$$\n\n- Statement “$q$ is a steady-state vector of $P$” is false. Since $Pq\\ne q,$ it is not a steady-state vector of $P.$\n\nTherefore, the correct answer is “$q$ is a stochastic vector” only."} {:db/id #edb/ref 17592186269073 :knowledge-point/_questions [{:db/id #edb/ref 17592186124614 :knowledge-point/id #uuid "66b24a98-c641-5e08-8bec-30f221d1bb22" :knowledge-point/title "Identifying Stochastic Vectors and Stochastic Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049585 :topic/id #uuid "024170b2-c2d1-503c-b046-b4baf9077735" :topic/math-academy-id 1911 :topic/title "Markov Chains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8786cf44-21c3-5f91-ae1e-9ed86d4c4ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464048} {:answer/id #uuid "6733f645-af10-5821-819f-178e020da088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464049}] :answer-field/correct {:answer/id #uuid "8786cf44-21c3-5f91-ae1e-9ed86d4c4ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464048} :answer-field/id #uuid "cf10f3fa-2ffc-5223-b491-71ebeb6d2901" :answer-field/key "$U=\\begin{bmatrix}0.1 & 0 & 0.9 \\\\ 0 & 0 & 0 \\\\ 0.9 & 0 & 0.1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464958} {:answer-field/choices [{:answer/id #uuid "04d077b2-7359-59a4-bab3-16da7d8ee52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464050} {:answer/id #uuid "25c5dce9-5e91-5159-8c35-a198c693e152" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464051}] :answer-field/correct {:answer/id #uuid "04d077b2-7359-59a4-bab3-16da7d8ee52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464050} :answer-field/id #uuid "a6141f05-7c5c-52c2-b7b5-86083319e913" :answer-field/key "$V=\\begin{bmatrix}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464959} {:answer-field/choices [{:answer/id #uuid "254b6e6f-8a77-5da1-8b3b-d863cf065f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464052} {:answer/id #uuid "3db8c5ce-4f8b-5b6c-9c0e-73a437e1a407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464053}] :answer-field/correct {:answer/id #uuid "3db8c5ce-4f8b-5b6c-9c0e-73a437e1a407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464053} :answer-field/id #uuid "746bc2c9-0d6d-5f8a-9494-27efcd2995b1" :answer-field/key "$W=\\begin{bmatrix}0.5 & 0.3 \\\\ 0.5 & 0.7\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7cb13afc-7824-57e2-abcc-e880dfaafeec" :question/math-academy-id "q-135488" :question/problem "Which of the following are stochastic matrices?\n\nSelect all that apply." :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is *not* a stochastic matrix since its second column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n\\begin{bmatrix}0.1 & 0 & 0.9 \\\\ 0 & 0 & 0 \\\\ 0.9 & 0 & 0.1\\end{bmatrix}\n$$\n\n- Matrix $V$  is *not* a stochastic matrix since its first column is not a stochastic vector (it contains negative entries): \n\n$$\n\\begin{bmatrix}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{bmatrix}\n$$\n\n- Matrix $W$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are non-negative and add up to one): \n\n$$\n\\begin{aligned}\\begin{bmatrix}0.5 & 0.3 \\\\ 0.5 & 0.7\\end{bmatrix}\\,\\begin{aligned}0.5+0.5=1 \\\\ 0.3+0.7=1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$W$ only.\""} {:db/id #edb/ref 17592186269146 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777 :topic/title "Triangular Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "625bfb45-fbfc-5c45-8a45-c019c11a0ebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437914} {:answer/id #uuid "24d952bc-2191-54a7-991a-b406bdb29aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437915}] :answer-field/correct {:answer/id #uuid "24d952bc-2191-54a7-991a-b406bdb29aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437915} :answer-field/id #uuid "045121f2-bd39-5c05-8c52-53047cd108bc" :answer-field/key "$A$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438986} {:answer-field/choices [{:answer/id #uuid "f7c070b1-6d63-5f49-bfdb-cbd527525bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437916} {:answer/id #uuid "f81712fc-ad06-5cc5-b788-916434b10d7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437917}] :answer-field/correct {:answer/id #uuid "f81712fc-ad06-5cc5-b788-916434b10d7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437917} :answer-field/id #uuid "067ee218-e6b2-559e-99ed-d1d5f0c090a8" :answer-field/key "$A$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438987} {:answer-field/choices [{:answer/id #uuid "da9876c3-99e9-5ed7-90b5-f31bdbecfc9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437918} {:answer/id #uuid "f370e4d0-30cc-52ff-ba53-d96669250c93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437919}] :answer-field/correct {:answer/id #uuid "f370e4d0-30cc-52ff-ba53-d96669250c93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437919} :answer-field/id #uuid "50b35816-7d87-509e-9051-cf11a392ea93" :answer-field/key "${A}^{T}+A$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438988}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ccdf19a6-45a3-5b56-b00e-b00d25e501ba" :question/math-academy-id "q-13771" :question/problem "Consider the matrix\n\n$$\nA=\\begin{bmatrix}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $A$ is upper triangular: **True.** This holds because all the entries below the main diagonal are zeros:\n\n$$\nA=\\begin{bmatrix}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\n- $A$ is lower triangular: **True.** This holds because all the entries above the main diagonal are zeros:\n\n$$\nA=\\begin{bmatrix}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\n- ${A}^{T}+A$ is lower triangular: **True.** This holds because the result of $A+{A}^{T}$ has all the entries above the main diagonal equal to zero: \n\n$$\n{A}^{T}+A=\\begin{bmatrix}16 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $A$ is upper triangular.\n- $A$ is lower triangular.\n- ${A}^{T}+A$ is lower triangular."} {:db/id #edb/ref 17592186269218 :knowledge-point/_questions [{:db/id #edb/ref 17592186162008 :knowledge-point/id #uuid "6289ad34-2393-5f5f-b7f0-a1ab1a3916f4" :knowledge-point/title "Identifying Possible Quadratic Form Types Using Substitution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6eb6c871-e00b-55bb-be24-d71ea25f7553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449514} {:answer/id #uuid "cf2f5c73-05c0-5880-a787-23f2d383e69c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449515}] :answer-field/correct {:answer/id #uuid "6eb6c871-e00b-55bb-be24-d71ea25f7553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449514} :answer-field/id #uuid "14e1058a-db49-54d3-b583-66942ce53dde" :answer-field/key "$R(x)=2{x}_{1}^{2}+3{x}_{2}^{2}$ is indefinite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450711} {:answer-field/choices [{:answer/id #uuid "3ab20bbc-df2d-5dc9-a5a5-982386f45345" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449516} {:answer/id #uuid "1e8f1f92-2b9d-5f7f-bc2d-24f6eb154d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449517}] :answer-field/correct {:answer/id #uuid "1e8f1f92-2b9d-5f7f-bc2d-24f6eb154d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449517} :answer-field/id #uuid "50f32587-2de7-571b-be31-977fd7b99f4b" :answer-field/key "$S(x)={x}^{T}\\,\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}x$ is negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450712} {:answer-field/choices [{:answer/id #uuid "d6f4dc65-45d4-5b00-9ce2-8f695a7fd648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449518} {:answer/id #uuid "dd8caa95-465f-5b75-ae0e-1069da94d070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449519}] :answer-field/correct {:answer/id #uuid "d6f4dc65-45d4-5b00-9ce2-8f695a7fd648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449518} :answer-field/id #uuid "7cfb8ffa-e4df-5320-b046-1846fb4aeab9" :answer-field/key "$T(x)={x}_{1}{x}_{2}$ is positive-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450713}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44381bf9-c027-58df-ba36-2d3bed72d50c" :question/math-academy-id "q-139436" :question/problem "Which of the following statements regarding quadratic forms are true?\n\nSelect all that apply." :question/worked-solution "Recall that, a quadratic form $Q(x)$ is:\n\n- positive-definite if $Q(x)>0$ for all $x\\in {R}^{n}∖{0};$\n\n- negative-definite if $Q(x)<0$ for all $x\\in {R}^{n}∖{0};$\n\n- indefinite if \n\n- $Q({x}_{1})>0$ for some ${x}_{1}\\in {R}^{n},$ and\n\n- $Q({x}_{2})<0$ for some ${x}_{2}\\in {R}^{n}.$\n\nWith that in mind, let's examine each of the quadratic forms in turn.\n\n- Statement “$R(x)=2{x}_{1}^{2}+3{x}_{2}^{2}$ is indefinite” is false. We have\n\n$$\n\\begin{aligned}R(x)=2{x}_{1}^{2}+3{x}_{2}^{2}>0\\end{aligned}\n$$\n\nfor all $x\\in {R}^{n}∖{0}.$ So, the quadratic form is positive-definite.\n\n- Statement “$S(x)={x}^{T}\\,\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}x$ is negative-definite” is true. Indeed, since\n\n$$\n\\begin{aligned}S(x) & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} \\\\  & =-{x}_{1}^{2}-2{x}_{2}^{2}<0\\end{aligned}\n$$\n\nfor all $x\\in {R}^{n}∖{0},$ the quadratic form is negative-definite.\n\n- Statement “$T(x)={x}_{1}{x}_{2}$ is positive-definite” is false. Substituting ${x}_{1}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},$ we get\n\n$$\n\\begin{aligned}T({x}_{1}) & =1\\cdot 1=1>0,\\end{aligned}\n$$\n\nwhile substituting ${x}_{2}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}T({x}_{2}) & =1\\cdot (-1)=-1<0.\\end{aligned}\n$$\n\nSo, the quadratic form is indefinite.\n\nTherefore, the correct answer is “$S(x)={x}^{T}\\,\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}x$ is negative-definite” only."} {:db/id #edb/ref 17592186269221 :knowledge-point/_questions [{:db/id #edb/ref 17592186162009 :knowledge-point/id #uuid "4105f1cb-eb48-5946-92f7-cd5e67689912" :knowledge-point/title "Identifying a Quadratic Form Type by Calculating the Corresponding Eigenvalues" :topic/_knowledge-points [{:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3c25508-a03c-54ed-af75-528b36334d08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464054} {:answer/id #uuid "f997d662-f0fe-5970-be50-6cced7ae7b58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464055}] :answer-field/correct {:answer/id #uuid "f997d662-f0fe-5970-be50-6cced7ae7b58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464055} :answer-field/id #uuid "f09da3cc-6896-57c1-b85f-50c6209f8fae" :answer-field/key "${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464961} {:answer-field/choices [{:answer/id #uuid "a30af1cd-d4ae-5f09-b616-cad8cd88ec73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464056} {:answer/id #uuid "6256dff6-b788-5cb5-8d29-52c667534b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464057}] :answer-field/correct {:answer/id #uuid "a30af1cd-d4ae-5f09-b616-cad8cd88ec73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464056} :answer-field/id #uuid "43c4ab03-9594-5b6b-ae8b-d04de998a6a6" :answer-field/key "${x}^{T}\\,Rx,$ where the eigenvalues of $R$ are ${\\lambda }_{1}={\\lambda }_{2}=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464962} {:answer-field/choices [{:answer/id #uuid "50467cc1-00c3-5d22-812d-d54f3f3960c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464058} {:answer/id #uuid "3c0b1cda-a69f-5c84-8c20-b1e4a0fb21d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464059}] :answer-field/correct {:answer/id #uuid "50467cc1-00c3-5d22-812d-d54f3f3960c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464058} :answer-field/id #uuid "a3999868-4945-5e38-b4fa-18fc7ca1a6ff" :answer-field/key "${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464963}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30844de8-e636-5e8f-ba19-823c3f8b1cf5" :question/math-academy-id "q-139455" :question/problem "Which of the following quadratic forms over ${R}^{2}$ are negative semi-definite?\n\nSelect all that apply." :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- Quadratic form “${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=0$” is negative semi-definite. Indeed, all of the eigenvalues of $Q$ are non-positive.\n\n- Quadratic form “${x}^{T}\\,Rx,$ where the eigenvalues of $R$ are ${\\lambda }_{1}={\\lambda }_{2}=1$” is *not* negative semi-definite since all of the eigenvalues of $R$ are positive.\n\n- Quadratic form “${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=2$” is *not* negative semi-definite since some of the eigenvalues of $S$ are positive (for example, ${\\lambda }_{2}=2$ is positive).\n\nTherefore, the correct answer is “${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=0$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"} :activity/title "Positive-Definite and Negative-Definite Quadratic Forms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186504030} :db/id #edb/ref 17592186504718}]} {:db/id #edb/ref 17592186269222 :knowledge-point/_questions [{:db/id #edb/ref 17592186162009 :knowledge-point/id #uuid "4105f1cb-eb48-5946-92f7-cd5e67689912" :knowledge-point/title "Identifying a Quadratic Form Type by Calculating the Corresponding Eigenvalues" :topic/_knowledge-points [{:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1457b085-9378-5537-a697-8815390a9df5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449520} {:answer/id #uuid "d441aa63-741d-5fc7-bc2f-c1887e1eb78e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449521}] :answer-field/correct {:answer/id #uuid "d441aa63-741d-5fc7-bc2f-c1887e1eb78e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449521} :answer-field/id #uuid "f1f88e3b-6fce-53e2-a863-e2915680b41b" :answer-field/key "The eigenvalues of $A$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450714} {:answer-field/choices [{:answer/id #uuid "ca05c6cb-ef8b-5373-a32f-aa4f99251f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449522} {:answer/id #uuid "cf59c74f-66ed-596d-9946-c21a0fb85247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449523}] :answer-field/correct {:answer/id #uuid "ca05c6cb-ef8b-5373-a32f-aa4f99251f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449522} :answer-field/id #uuid "4e10d470-87af-5c03-a536-81b74c55a80e" :answer-field/key "${x}^{T}\\,A\\,x$ is indefinite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450715} {:answer-field/choices [{:answer/id #uuid "52d5d12d-b0f0-5117-a773-5495feb2d298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449524} {:answer/id #uuid "00c4db35-c875-59bd-9e1a-40ed34ed91d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449525}] :answer-field/correct {:answer/id #uuid "52d5d12d-b0f0-5117-a773-5495feb2d298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449524} :answer-field/id #uuid "7eefdd5d-b9a9-56fd-912a-519b7219b52b" :answer-field/key "$A$ is negative semi-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450716}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e96bcaa6-6221-5f7c-9daa-4047225c2c05" :question/math-academy-id "q-139457" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement “The eigenvalues of $A$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=5$” is true. Indeed, by computing the characteristic equation of $A,$ we obtain\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & -2 \\\\ -2 & 4-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(4-\\lambda )-(4) & =0 \\\\ {\\lambda }^{2}-5\\lambda  & =0 \\\\ \\lambda  & =0,\\,5.\\end{aligned}\n$$\n\n- Statements “${x}^{T}\\,A\\,x$ is indefinite” and “$A$ is negative semi-definite” are false. Since both eigenvalues of $A$ are non-negative, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is positive semi-definite.\n\nTherefore, the correct answer is “The eigenvalues of $A$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=5$” only."} {:db/id #edb/ref 17592186269223 :knowledge-point/_questions [{:db/id #edb/ref 17592186162009 :knowledge-point/id #uuid "4105f1cb-eb48-5946-92f7-cd5e67689912" :knowledge-point/title "Identifying a Quadratic Form Type by Calculating the Corresponding Eigenvalues" :topic/_knowledge-points [{:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0174d75c-71dc-5ecb-9978-0afa7bf31836" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464060} {:answer/id #uuid "1571f173-0629-58b6-bf88-d5211c7e4969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464061}] :answer-field/correct {:answer/id #uuid "1571f173-0629-58b6-bf88-d5211c7e4969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464061} :answer-field/id #uuid "c8f7c51d-3e18-5bcf-9dfe-c109b3196174" :answer-field/key "${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464964} {:answer-field/choices [{:answer/id #uuid "bf30537c-9bfd-5d49-9bf0-7daf53659951" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464062} {:answer/id #uuid "ad9ec894-c432-504a-9be9-d97512134bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464063}] :answer-field/correct {:answer/id #uuid "bf30537c-9bfd-5d49-9bf0-7daf53659951" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464062} :answer-field/id #uuid "d4369eae-3af3-5d0d-96dd-bf3c91d0e50f" :answer-field/key "${x}^{T}\\,Rx,$ where the eigenvalues of $R$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464965} {:answer-field/choices [{:answer/id #uuid "30828ca0-e286-5320-a545-ecd25568f4d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464064} {:answer/id #uuid "a8b4b2a7-057a-56db-9141-df8234613514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464065}] :answer-field/correct {:answer/id #uuid "a8b4b2a7-057a-56db-9141-df8234613514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464065} :answer-field/id #uuid "7ed51de2-cad2-5793-aada-609d89fdc6cf" :answer-field/key "${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}={\\lambda }_{2}=10$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464966}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80bdad61-ebf7-546e-ab4f-0e8486894231" :question/math-academy-id "q-139458" :question/problem "Which of the following quadratic forms over ${R}^{2}$ are positive semi-definite? \n\nSelect all that apply." :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- Quadratic form “${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=1$” is positive semi-definite. Indeed, all of the eigenvalues of $Q$ are non-negative.\n\n- Quadratic form “${x}^{T}\\,Rx,$ where the eigenvalues of $R$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=6$” is *not* positive semi-definite since some of the eigenvalues of $R$ are negative (for example, ${\\lambda }_{1}=-1$ is negative).\n\n- Quadratic form “${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}={\\lambda }_{2}=10$” is positive semi-definite. Indeed, all of the eigenvalues of $S$ are non-negative.\n\nTherefore, the correct answer is “${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=1$”; “${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}={\\lambda }_{2}=10$” only."} {:db/id #edb/ref 17592186269224 :knowledge-point/_questions [{:db/id #edb/ref 17592186162009 :knowledge-point/id #uuid "4105f1cb-eb48-5946-92f7-cd5e67689912" :knowledge-point/title "Identifying a Quadratic Form Type by Calculating the Corresponding Eigenvalues" :topic/_knowledge-points [{:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5ddcfc0-292c-5cb2-9f45-5419c2a13d8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449526} {:answer/id #uuid "1ece8954-5a1c-5b2f-8921-c1762576f869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449527}] :answer-field/correct {:answer/id #uuid "b5ddcfc0-292c-5cb2-9f45-5419c2a13d8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449526} :answer-field/id #uuid "0194949c-aad3-5929-accb-a77de79ebda9" :answer-field/key "The eigenvalues of $A$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450717} {:answer-field/choices [{:answer/id #uuid "901712f6-2196-5116-b6eb-9ec322256c84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449528} {:answer/id #uuid "c2001294-60a6-5ba3-bbd0-df63331dc65e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449529}] :answer-field/correct {:answer/id #uuid "901712f6-2196-5116-b6eb-9ec322256c84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449528} :answer-field/id #uuid "3957c690-352c-5adb-9484-2b219ab8ad73" :answer-field/key "${x}^{T}\\,A\\,x$ is positive semi-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450718} {:answer-field/choices [{:answer/id #uuid "a473654a-3c7a-5cbc-a26c-dd414807f54c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449530} {:answer/id #uuid "9da286f4-dd08-5312-aac1-b131428b4413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449531}] :answer-field/correct {:answer/id #uuid "9da286f4-dd08-5312-aac1-b131428b4413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449531} :answer-field/id #uuid "dd5ff80d-3210-52c8-b24c-ee9e5aec7fcf" :answer-field/key "$A$ is indefinite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450719}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36a88a67-992a-5e00-85ac-8bb48fc32f6c" :question/math-academy-id "q-139460" :question/problem "Consider the matrix $A=\\begin{bmatrix}-2 & -2 \\\\ -2 & 1\\end{bmatrix}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement “The eigenvalues of $A$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=2$” is false. Computing the characteristic equation of $A,$ we obtain\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}-2-\\lambda  & -2 \\\\ -2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-2-\\lambda )(1-\\lambda )-(4) & =0 \\\\ {\\lambda }^{2}+\\lambda -6 & =0 \\\\ \\lambda  & =-3,\\,2.\\end{aligned}\n$$\n\n- Statement “${x}^{T}\\,A\\,x$ is positive semi-definite” is false, while statement “$A$ is indefinite” is true. Since $A$ has both positive and negative eigenvalues, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is indefinite.\n\nTherefore, the correct answer is “$A$ is indefinite” only."} {:db/id #edb/ref 17592186269225 :knowledge-point/_questions [{:db/id #edb/ref 17592186162010 :knowledge-point/id #uuid "cbebdd1b-0716-55cb-8df6-12a35b517ab5" :knowledge-point/title "Identifying a Quadratic Form Type Using Sylvester's Criterion" :topic/_knowledge-points [{:db/id #edb/ref 17592186048555 :topic/id #uuid "a95c2c28-8d05-5d82-baa9-f51e879c16c9" :topic/math-academy-id 3127 :topic/title "Positive-Definite and Negative-Definite Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daa79a2c-7393-51fd-aa68-53f7bcbfd36a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449532} {:answer/id #uuid "3d7d5d0c-57fa-5f8d-a238-f9a8292d8c79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449533}] :answer-field/correct {:answer/id #uuid "3d7d5d0c-57fa-5f8d-a238-f9a8292d8c79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449533} :answer-field/id #uuid "aebff15a-46bb-5e25-b5f7-52cc4f246811" :answer-field/key "${a}_{11}=2$ and $det(A)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450720} {:answer-field/choices [{:answer/id #uuid "b1909387-b83c-52db-b6e3-ab497516fded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449534} {:answer/id #uuid "8eebe797-5a30-55f7-8a3a-e1cba2f6d82d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449535}] :answer-field/correct {:answer/id #uuid "b1909387-b83c-52db-b6e3-ab497516fded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449534} :answer-field/id #uuid "79794586-10dc-5ee4-b484-f880ca056d6d" :answer-field/key "${x}^{T}\\,A\\,x$ is positive-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450721} {:answer-field/choices [{:answer/id #uuid "08f5b011-a5ec-5e29-8cff-d8e9fe83ea41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449536} {:answer/id #uuid "158c0776-5611-5095-a30f-0b3db7bfac21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449537}] :answer-field/correct {:answer/id #uuid "08f5b011-a5ec-5e29-8cff-d8e9fe83ea41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449536} :answer-field/id #uuid "e2987329-85fb-5d6c-a910-7bce43831da5" :answer-field/key "$A$ is negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450722}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "906865b3-32d2-5d7f-b7fc-d38ff3d60bed" :question/math-academy-id "q-139462" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & 3 \\\\ 3 & 3\\end{bmatrix}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement “${a}_{11}=2$ and $det(A)=-3$” is true. Indeed, ${a}_{11}=2$ and \n\n$$\ndet(A)=|\\begin{aligned}2 & 3 \\\\ 3 & 3\\end{aligned}|=-3.\n$$\n\n- Statements “${x}^{T}\\,A\\,x$ is positive-definite” and  “$A$ is negative-definite” are false. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=2>0, \\\\ {Δ}_{2} & =|\\begin{aligned}2 & 3 \\\\ 3 & 3\\end{aligned}|=-3<0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, neither the quadratic form ${x}^{T}\\,A\\,x$ nor the matrix $A$ is positive-definite or negative-definite.\n\nTherefore, the correct answer is “${a}_{11}=2$ and $det(A)=-3$” only."} {:db/id #edb/ref 17592186271977 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186049045 :topic/id #uuid "d599481a-4f0d-50b9-8ceb-db8805f8eeee" :topic/math-academy-id 2094 :topic/title "The Dot Product in N-Dimensional Euclidean Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef2a43dc-1c80-5218-8157-b47bfd63573e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464066} {:answer/id #uuid "22e726e5-b98c-52df-9b1a-b35a9f15da31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464067}] :answer-field/correct {:answer/id #uuid "ef2a43dc-1c80-5218-8157-b47bfd63573e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464066} :answer-field/id #uuid "aa9e3927-b1ca-5800-a0de-54fc10194caa" :answer-field/key "$a\\cdot a<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464967} {:answer-field/choices [{:answer/id #uuid "b6bd907c-c4b8-55fb-99be-397ec11a6b04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464068} {:answer/id #uuid "ae87cd28-7716-5402-aca0-8d6623681047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464069}] :answer-field/correct {:answer/id #uuid "b6bd907c-c4b8-55fb-99be-397ec11a6b04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464068} :answer-field/id #uuid "3a586de5-5ce3-5e58-8db1-7ae30b72a0c6" :answer-field/key "$b\\cdot a>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464968} {:answer-field/choices [{:answer/id #uuid "6df519d6-28f6-5dd9-8e63-336379d28b7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464070} {:answer/id #uuid "85d2b764-e3d4-5e6e-a505-4b6d357818bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464071}] :answer-field/correct {:answer/id #uuid "6df519d6-28f6-5dd9-8e63-336379d28b7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464070} :answer-field/id #uuid "738f91c0-56e2-59fb-bc86-5d2fb319fe65" :answer-field/key "$b\\cdot a=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a127128-cb22-56be-ba7d-5b1447ce81f1" :question/math-academy-id "q-139957" :question/problem "Suppose $a\\cdot (a+b)=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement $a\\cdot a<0$ is false. Indeed, $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement $b\\cdot a>0$ and $b\\cdot a=5$ are false. Simplifying the expression $a\\cdot (a+b)=0$, we have\n\n$$\n\\begin{aligned}a\\cdot (a+b) & =0 \\\\ a\\cdot a+a\\cdot b & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $b\\cdot a<0.$\n\nTherefore, we conclude that the correct answer is \"None of the statements are true\"."} {:db/id #edb/ref 17592186271986 :knowledge-point/_questions [{:db/id #edb/ref 17592186124509 :knowledge-point/id #uuid "f020b27f-1cd4-550b-a83a-2afbb7e5db72" :knowledge-point/title "Identifying the Dimension of the Null Space of Matrices Using Inspection" :topic/_knowledge-points [{:db/id #edb/ref 17592186050996 :topic/id #uuid "7821b684-8118-5d42-9459-ebb20010e0ff" :topic/math-academy-id 1868 :topic/title "The Dimension of the Null Space of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "883ff5fb-cd92-5295-9749-a73ce52161a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449538} {:answer/id #uuid "2e88af28-4c09-5fdd-833e-3651c7b725a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449539}] :answer-field/correct {:answer/id #uuid "883ff5fb-cd92-5295-9749-a73ce52161a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449538} :answer-field/id #uuid "7ce0ae24-e14f-528f-9ca2-cb88c8ee5075" :answer-field/key "If $A=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}$ then $\\text{dim(Null}(A))=2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450723} {:answer-field/choices [{:answer/id #uuid "37eb73c9-f986-55cc-9e3f-f09e85663a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449540} {:answer/id #uuid "2ce7d866-9357-5b45-adf0-8ba30f460f4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449541}] :answer-field/correct {:answer/id #uuid "2ce7d866-9357-5b45-adf0-8ba30f460f4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449541} :answer-field/id #uuid "6951fea3-e73e-5bad-80b0-953cb0ffd39f" :answer-field/key "If $B=\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & \\,0\\end{bmatrix}$ then $\\text{dim(Null}(B))=1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450724} {:answer-field/choices [{:answer/id #uuid "c92b8fb7-773b-5e7e-86ea-fb0940461d26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449542} {:answer/id #uuid "d3e75f22-fdfa-557d-9f38-f1532123424c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449543}] :answer-field/correct {:answer/id #uuid "d3e75f22-fdfa-557d-9f38-f1532123424c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449543} :answer-field/id #uuid "c27e54eb-3b76-501f-9b56-f677edad7f97" :answer-field/key "If $C=\\begin{bmatrix}5 & 4 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ then $\\text{dim(Null}(C))=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c75ae37f-79fb-5023-b676-a4acf7953ba3" :question/math-academy-id "q-139973" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- Statement “If $A=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}$ then $\\text{dim(Null}(A))=2.$” is false. The matrix $A$ has $2$ pivot columns and no non-pivot columns. So, \n\n$$\n\\text{dim(Null}(A))=0.\n$$\n\n- Statement “If $B=\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & \\,0\\end{bmatrix}$ then $\\text{dim(Null}(B))=1.$” is true. The matrix $B$ has $2$ pivot columns and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- Statement “If $C=\\begin{bmatrix}5 & 4 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ then $\\text{dim(Null}(C))=0.$” is true. The matrix $C$ has $3$ pivot columns and no non-pivot columns. So, \n\n$$\n\\text{dim(Null}(C))=0.\n$$\n\nTherefore, the correct answer is “If $B=\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & \\,0\\end{bmatrix}$ then $\\text{dim(Null}(B))=1.$”; “If $C=\\begin{bmatrix}5 & 4 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ then $\\text{dim(Null}(C))=0.$” only."} {:db/id #edb/ref 17592186271990 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050129 :topic/id #uuid "2eee4710-3f26-5186-948b-a819cfaf4083" :topic/math-academy-id 1775 :topic/title "Cramer's Rule for 2x2 Systems of Linear Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aee602c-4d2a-536f-b5a1-43a412811ff2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464072} {:answer/id #uuid "13c7384c-1cfa-57cc-8a50-9bf3eab8a9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464073}] :answer-field/correct {:answer/id #uuid "1aee602c-4d2a-536f-b5a1-43a412811ff2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464072} :answer-field/id #uuid "7c3b7373-e5a8-5e2b-8acc-0be10c9b59f2" :answer-field/key "$-3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464970} {:answer-field/choices [{:answer/id #uuid "550ef764-b469-5976-ae9d-0020002e1ead" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464074} {:answer/id #uuid "d1697d54-6fd0-5d05-b11b-25f7ce8acc26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464075}] :answer-field/correct {:answer/id #uuid "d1697d54-6fd0-5d05-b11b-25f7ce8acc26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464075} :answer-field/id #uuid "1f5b3e10-e84c-56fd-8992-d584ea10b2ad" :answer-field/key "$3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464971} {:answer-field/choices [{:answer/id #uuid "fab9ce83-630e-5c19-ae07-249274247140" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464076} {:answer/id #uuid "7bc5ed4c-a4d9-52b6-ad58-1348db969598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464077}] :answer-field/correct {:answer/id #uuid "fab9ce83-630e-5c19-ae07-249274247140" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464076} :answer-field/id #uuid "5b13ee4f-81c8-5307-88d8-1a4665b341de" :answer-field/key "$|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=3|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464972}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "09aa5cfb-0ccb-582a-bfa8-b6151a1b73a2" :question/math-academy-id "q-139979" :question/problem "Let $⟨x,3⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}kx+3y &=1 \\\\ 7x-2y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ 3 & =\\frac{|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|}{|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|} \\\\ 3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}| & =|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is $3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$ only."} {:db/id #edb/ref 17592186271991 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050129 :topic/id #uuid "2eee4710-3f26-5186-948b-a819cfaf4083" :topic/math-academy-id 1775 :topic/title "Cramer's Rule for 2x2 Systems of Linear Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8504eb0f-93c6-5d20-8195-88dbad00b315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464078} {:answer/id #uuid "c70ffc2d-dbef-5e28-8e5a-6e4a97b209b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464079}] :answer-field/correct {:answer/id #uuid "8504eb0f-93c6-5d20-8195-88dbad00b315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464078} :answer-field/id #uuid "83c98712-e70e-5484-9096-216f3da1b3f6" :answer-field/key "$|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=2|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464973} {:answer-field/choices [{:answer/id #uuid "855711cd-7b19-555c-ab6e-e3cbe95bee72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464080} {:answer/id #uuid "8f8516b4-64ce-53f5-938e-8dfecd51f520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464081}] :answer-field/correct {:answer/id #uuid "855711cd-7b19-555c-ab6e-e3cbe95bee72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464080} :answer-field/id #uuid "acfad26a-36f9-5d0e-a1e7-36cd998ca21e" :answer-field/key "$|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=-4|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464974} {:answer-field/choices [{:answer/id #uuid "988ccea1-2f9c-50fe-b323-1720447bfb02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464082} {:answer/id #uuid "725b0b06-d3c5-567b-9157-156746df62ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464083}] :answer-field/correct {:answer/id #uuid "725b0b06-d3c5-567b-9157-156746df62ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464083} :answer-field/id #uuid "535c6a07-6be3-5ec1-a653-291a4880438d" :answer-field/key "$-2|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464975}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ddc658b6-e0a7-590f-af72-c80671fc917f" :question/math-academy-id "q-139980" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}15x+8y &=-1 \\\\ kx+13y &=-31.\\end{aligned}\\right.\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nSelect all that apply." :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|}{|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|} \\\\ -2|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}| & =|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is $-2|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$ only."} {:db/id #edb/ref 17592186272012 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "643b4a3a-7263-51ad-8b17-fdd82678cf99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464084} {:answer/id #uuid "e3e66fb8-1a18-56f4-8033-3baba4940db9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464085}] :answer-field/correct {:answer/id #uuid "643b4a3a-7263-51ad-8b17-fdd82678cf99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464084} :answer-field/id #uuid "2ceb200f-e369-571b-b619-8f16a603488c" :answer-field/key "$A$ is a triangular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464976} {:answer-field/choices [{:answer/id #uuid "198009c8-d9e6-556e-aa1c-228a37b12311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464086} {:answer/id #uuid "da19cf9c-0b56-5a20-b004-c70d313f5184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464087}] :answer-field/correct {:answer/id #uuid "da19cf9c-0b56-5a20-b004-c70d313f5184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464087} :answer-field/id #uuid "d98905ac-4493-5551-96b2-6d52f8e3f566" :answer-field/key "$A$ does not have identical rows" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464977} {:answer-field/choices [{:answer/id #uuid "63ea76cf-d936-573e-a0be-56de7954b8ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464088} {:answer/id #uuid "24e2aa19-faca-5a81-a238-e9e984e89ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464089}] :answer-field/correct {:answer/id #uuid "24e2aa19-faca-5a81-a238-e9e984e89ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464089} :answer-field/id #uuid "ed42e6d2-1aff-5708-ad8c-b45de0195450" :answer-field/key "$A$ does not have proportional columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464978}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f60fdb9d-cf89-59bd-ad65-e9ec096b82df" :question/math-academy-id "q-140049" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|\\ne 0.$ Which of the following statements must be true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's consider our statements in turn.\n\n- Statement “$A$ is a triangular matrix” is false. For example, consider the matrix \n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nWe have that \n\n$$\n|A|=1\\cdot 1-(-2)\\cdot 2=5\\ne 0\n$$\n\nbut $A$ is not a triangular matrix.\n\n- Statements “$A$ does not have identical rows” and “$A$ does not have proportional columns” are true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\nHence, if $|A|\\ne 0$ then $A$ doesn't have proportional nor identical rows/columns.\n\nTherefore, the correct answer is “$A$ does not have identical rows”; “$A$ does not have proportional columns” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186416113} :db/id #edb/ref 17592186416115} {:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"} :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498725} :db/id #edb/ref 17592186499606}]} {:db/id #edb/ref 17592186272013 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero" :topic/_knowledge-points [{:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201 :topic/title "Conditions When a Determinant Equals Zero"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dcaf5cb-763f-5cf3-9460-94fc22fd63a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464090} {:answer/id #uuid "94b51605-0792-5dfb-9caa-c9f83344d279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464091}] :answer-field/correct {:answer/id #uuid "94b51605-0792-5dfb-9caa-c9f83344d279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464091} :answer-field/id #uuid "977b3534-4011-5dfd-a7b9-79927cd06b86" :answer-field/key "$A$ has proportional columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464979} {:answer-field/choices [{:answer/id #uuid "fc8b5695-d93e-519e-8d9e-dc6c8a41f9b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464092} {:answer/id #uuid "6b733140-0c4b-5274-8eb8-dcc1ee96785c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464093}] :answer-field/correct {:answer/id #uuid "fc8b5695-d93e-519e-8d9e-dc6c8a41f9b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464092} :answer-field/id #uuid "9e5c0b84-632c-50f3-8754-70310b21a57f" :answer-field/key "$A$ has identical columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464980} {:answer-field/choices [{:answer/id #uuid "f726adc9-d1dc-521c-8654-53c52267101e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464094} {:answer/id #uuid "94789da1-7829-587f-bfab-9c55f7f2211d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464095}] :answer-field/correct {:answer/id #uuid "f726adc9-d1dc-521c-8654-53c52267101e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464094} :answer-field/id #uuid "121070ea-b2d0-524b-8159-ea2fbac7bd33" :answer-field/key "$A$ has identical rows" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464981}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14e63fd3-62b7-575e-b489-4cda5c20ed53" :question/math-academy-id "q-140050" :question/problem "$$\nA=\\begin{bmatrix}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=\\begin{bmatrix}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{bmatrix}\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ does *not* have identical rows.\n\nTherefore, the correct answer is “$A$ has proportional columns” only."} {:db/id #edb/ref 17592186272020 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049371 :topic/id #uuid "ef6bb570-cff7-5ef3-a4ba-79063f5d81ad" :topic/math-academy-id 1962 :topic/title "The Invertible Matrix Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4f795a3-cd3e-5c24-bdd1-ff02322fb141" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449544} {:answer/id #uuid "3d5f8ab7-4cce-5ec8-9a38-14eac636465a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449545}] :answer-field/correct {:answer/id #uuid "3d5f8ab7-4cce-5ec8-9a38-14eac636465a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449545} :answer-field/id #uuid "560c80ce-e4b3-5482-bf01-5c8099377097" :answer-field/key "$\\text{Ker}(T)\\ne {0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450726} {:answer-field/choices [{:answer/id #uuid "9b6944cb-1813-5a1f-986a-16a0f89b670d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449546} {:answer/id #uuid "04ea8826-2226-5b0d-af91-83a1cb71b3d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449547}] :answer-field/correct {:answer/id #uuid "9b6944cb-1813-5a1f-986a-16a0f89b670d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449546} :answer-field/id #uuid "3061c284-4a1c-557d-9087-cca41c6f72fc" :answer-field/key "$T$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450727} {:answer-field/choices [{:answer/id #uuid "c4f917bf-a566-5747-9a2b-6eaec0f84a74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449548} {:answer/id #uuid "49bdfd16-13d5-5c89-b23e-1909972b63af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449549}] :answer-field/correct {:answer/id #uuid "c4f917bf-a566-5747-9a2b-6eaec0f84a74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449548} :answer-field/id #uuid "a1a7f4e8-5911-5127-81da-9e012724e169" :answer-field/key "$\\text{rank}(T)=7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450728}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "992aa4b0-2c51-5ac6-900d-30c5c0b14be1" :question/math-academy-id "q-140079" :question/problem "Which of the following statements are true given that $T:{R}^{7}\\to {R}^{7}$ is a linear transformation whose standard matrix is $T,$ and $T({v}_{1})=T({v}_{2})$ for some distinct vectors  ${v}_{1}$ and ${v}_{2}?$\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{7}$ into ${R}^{7},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{7} \\\\  & \\text{rank}(T)=7 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)\\ne {0}$ is true. Indeed, since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne {0}.$\n\n- Statement “$T$ is invertible” is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne {0},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement $\\text{rank}(T)=7$ is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{rank}(T)\\ne 7.$\n\nTherefore, the correct answer is $\\text{Ker}(T)\\ne {0}$ only."} {:db/id #edb/ref 17592186272021 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186049371 :topic/id #uuid "ef6bb570-cff7-5ef3-a4ba-79063f5d81ad" :topic/math-academy-id 1962 :topic/title "The Invertible Matrix Theorem in Terms of Linear Transformations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afa82d44-d03d-5e9b-af04-272ab90230e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464096} {:answer/id #uuid "71f897c8-dfce-5b45-8f4c-bb7062ae467e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464097}] :answer-field/correct {:answer/id #uuid "afa82d44-d03d-5e9b-af04-272ab90230e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464096} :answer-field/id #uuid "6ed222a1-7190-5964-99bc-a9de5fd0be28" :answer-field/key "$\\text{Ker}(T)\\ne \\{0\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464982} {:answer-field/choices [{:answer/id #uuid "5a1a3dca-d308-5f38-927f-67b0c977e32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464098} {:answer/id #uuid "d292b59f-adc1-58d1-98bc-5da647707c1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464099}] :answer-field/correct {:answer/id #uuid "d292b59f-adc1-58d1-98bc-5da647707c1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464099} :answer-field/id #uuid "cafebd75-e7fa-54e1-9bcf-2578d3061be4" :answer-field/key "$T$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464983} {:answer-field/choices [{:answer/id #uuid "dbb177f8-879b-5898-9551-53329abe91c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464100} {:answer/id #uuid "7332d203-8792-51a5-976c-10e58a391aaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464101}] :answer-field/correct {:answer/id #uuid "7332d203-8792-51a5-976c-10e58a391aaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464101} :answer-field/id #uuid "b8de8dc2-3957-5b43-9b1f-bfdfb462141b" :answer-field/key "$\\text{nullity}(T)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464984}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1cac76f2-abeb-58d4-87e9-5f3619bedd4c" :question/math-academy-id "q-140085" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $\\text{rank}(T)=5,$ then $\\underline{\\phantom{xxxxxx}}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)\\ne \\{0\\}$ is false. Since $\\text{rank}(T)=5,$ the invertible matrix theorem implies that $\\text{Ker}(T)=\\{0\\}.$\n\n- Statement “$T$ is invertible” is true. Indeed, since $\\text{rank}(T)=5,$ the invertible matrix theorem implies that $T$ is invertible.\n\n- Statement $\\text{nullity}(T)=0$ is true. Indeed, since $T$ is invertible, the invertible matrix theorem implies that $\\text{nullity}(T)=0.$\n\nTherefore, the correct answer is “$T$ is invertible”; $\\text{nullity}(T)=0$ only."} {:db/id #edb/ref 17592186272063 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases" :topic/_knowledge-points [{:db/id #edb/ref 17592186050324 :topic/id #uuid "3ffd42a4-cf3d-5ec4-9be0-19d427299cac" :topic/math-academy-id 2014 :topic/title "Connections Between Matrix Representations of a Linear Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de51a0dc-dd2e-51c5-bdf6-35f0d167a4af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449550} {:answer/id #uuid "3074d86e-e8f4-59b8-b9ef-b9acd04d1e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449551}] :answer-field/correct {:answer/id #uuid "de51a0dc-dd2e-51c5-bdf6-35f0d167a4af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449550} :answer-field/id #uuid "6b489027-47a6-5418-b1a4-ae90726f7d12" :answer-field/key "$[T]_{C}={P}_{B\\to C}^{-1}\\cdot [T]_{B}\\cdot {P}_{B\\to C}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450729} {:answer-field/choices [{:answer/id #uuid "5973a2ab-b2dd-592e-a584-1a43d4c02adf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449552} {:answer/id #uuid "475f048c-5791-5804-8edc-299acd62ba0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449553}] :answer-field/correct {:answer/id #uuid "475f048c-5791-5804-8edc-299acd62ba0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449553} :answer-field/id #uuid "9997d045-331c-54ca-b718-1546606cd597" :answer-field/key "$[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450730} {:answer-field/choices [{:answer/id #uuid "61266a01-b00a-5764-85eb-7849d7f3d7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449554} {:answer/id #uuid "8422f214-fd53-5e1a-8fa7-538645d77eaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449555}] :answer-field/correct {:answer/id #uuid "61266a01-b00a-5764-85eb-7849d7f3d7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449554} :answer-field/id #uuid "85ff507d-5d08-5b56-a407-069075198e07" :answer-field/key "$[T]_{B}={P}_{B\\to C}\\cdot [T]_{C}\\cdot {P}_{B\\to C}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450731}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cf5001e6-d49e-526a-bbd2-b37f328e04e1" :question/math-academy-id "q-140361" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is $[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$ only."} {:db/id #edb/ref 17592186272064 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases" :topic/_knowledge-points [{:db/id #edb/ref 17592186050324 :topic/id #uuid "3ffd42a4-cf3d-5ec4-9be0-19d427299cac" :topic/math-academy-id 2014 :topic/title "Connections Between Matrix Representations of a Linear Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "525de6aa-bc06-5fb2-8b57-d030bfea5609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449556} {:answer/id #uuid "76383dc8-b07d-5da6-a0f8-3e3e160edd4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449557}] :answer-field/correct {:answer/id #uuid "76383dc8-b07d-5da6-a0f8-3e3e160edd4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449557} :answer-field/id #uuid "668f1b09-54dc-5332-92bf-fa0c0746ea48" :answer-field/key "$[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450732} {:answer-field/choices [{:answer/id #uuid "02c13acd-e218-582d-8b3f-0052625f748d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449558} {:answer/id #uuid "1b3e8dff-05eb-5f8a-b119-18f4d1b087fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449559}] :answer-field/correct {:answer/id #uuid "02c13acd-e218-582d-8b3f-0052625f748d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449558} :answer-field/id #uuid "9df531d2-e4ae-5fef-b0fc-dee7598d3b7e" :answer-field/key "$[T]_{C}={P}_{B\\to C}^{-1}\\cdot [T]_{B}\\cdot {P}_{B\\to C}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450733} {:answer-field/choices [{:answer/id #uuid "29f5b7b3-e092-5649-ab6e-26506be9ca10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449560} {:answer/id #uuid "1fee3d4c-1a3f-5145-990c-3f79a5c72792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449561}] :answer-field/correct {:answer/id #uuid "29f5b7b3-e092-5649-ab6e-26506be9ca10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449560} :answer-field/id #uuid "e28759ca-7435-54da-9df5-57bdee87df1b" :answer-field/key "$[T]_{C}={P}_{B\\to C}\\cdot [T]_{C}\\cdot {P}_{B\\to C}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450734}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc68e9b9-f221-584c-883c-3c892a06e266" :question/math-academy-id "q-140362" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is $[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$ only."} {:db/id #edb/ref 17592186272087 :knowledge-point/_questions [{:db/id #edb/ref 17592186133869 :knowledge-point/id #uuid "62a2f835-498f-5b9e-9051-89c946558e56" :knowledge-point/title "Identifying True Statements About Orthogonal Vectors in Inner Product Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186050331 :topic/id #uuid "4076cd19-9f1e-54c7-b08d-83c706b3cbae" :topic/math-academy-id 2100 :topic/title "Orthogonal Vectors in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497c7760-d42f-5692-9a2b-f696bcb0055b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464102} {:answer/id #uuid "277a5a87-418d-51a1-a726-67cf72fc412e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464103}] :answer-field/correct {:answer/id #uuid "277a5a87-418d-51a1-a726-67cf72fc412e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464103} :answer-field/id #uuid "83086f7a-b7cb-5812-935f-60e558109693" :answer-field/key "$⟨f(t),g(t)⟩=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464985} {:answer-field/choices [{:answer/id #uuid "f8236707-38fd-5c0b-89a7-0a27fffeb00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464104} {:answer/id #uuid "57b74907-7a7f-5031-9194-c6a7d4bdc948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464105}] :answer-field/correct {:answer/id #uuid "f8236707-38fd-5c0b-89a7-0a27fffeb00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464104} :answer-field/id #uuid "274eab40-126e-5394-8c41-1828340662f4" :answer-field/key "$⟨f(t),g(t)⟩=\\frac{1}{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464986} {:answer-field/choices [{:answer/id #uuid "8913ca1a-f4ac-570e-9fa4-f8c757505f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464106} {:answer/id #uuid "6fc3a2fc-28db-525b-8a74-baf7b5fc3108" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464107}] :answer-field/correct {:answer/id #uuid "6fc3a2fc-28db-525b-8a74-baf7b5fc3108" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464107} :answer-field/id #uuid "080e9bc1-5374-5406-97b7-4e6bef226207" :answer-field/key "$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464987}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a0e37cf1-8e7e-52da-9921-f2cfa10fc56d" :question/math-academy-id "q-140434" :question/problem "Let $V=C[-1,0]$ be the vector space of all functions that are continuous on $[-1,0],$ equipped with the inner product \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{0}f(t)g(t)\\,\\text{d}t.\n$$\n\nGiven the functions $f(t)=({t}^{3}+t+1)^{3}$ and $g(t)=3{t}^{2}+1,$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we need to evaluate \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{0}({t}^{3}+t+1)^{3}(3{t}^{2}+1)\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u={t}^{3}+t+1,$ $\\text{d}u=(3{t}^{2}+1)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}({t}^{3}+t+1)^{3}(3{t}^{2}+1)\\,\\text{d}t & ={\\int }_{-1}^{1}{u}^{3}\\,\\text{d}u \\\\  & =\\frac{1}{4}{u}^{4}\\,{|}_{-1}^{1} \\\\  & =[\\frac{1}{4}(1)^{4}]-[\\frac{1}{4}(-1)^{4}] \\\\  & =0\\end{aligned}\n$$\n\nLet's now examine the statements:\n\n- Statement $⟨f(t),g(t)⟩=0$ is true, while statement $⟨f(t),g(t)⟩=\\frac{1}{4}$ is false. This is as a result of the above calculations.\n\n- Statement “$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$” is true. Since the inner product is zero, our vectors are orthogonal.\n\nTherefore, the correct answer is $⟨f(t),g(t)⟩=0$; “$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$” only."} {:db/id #edb/ref 17592186272092 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros" :topic/_knowledge-points [{:db/id #edb/ref 17592186050376 :topic/id #uuid "44312a5e-e7e0-507f-86f6-c3bcdecfd7fe" :topic/math-academy-id 1964 :topic/title "The Characteristic Equation of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb643844-0c56-5e23-9937-c4d548e084c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449562} {:answer/id #uuid "8a4b9bd6-2a00-59a9-a615-c97c3e869865" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449563}] :answer-field/correct {:answer/id #uuid "8a4b9bd6-2a00-59a9-a615-c97c3e869865" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449563} :answer-field/id #uuid "136321e8-01a0-5e29-b277-512685edf90f" :answer-field/key "$\\lambda =0$ is an eigenvalue of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450735} {:answer-field/choices [{:answer/id #uuid "97521b78-12e0-5c5d-8379-a7c0b43deff5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449564} {:answer/id #uuid "2e911fcf-5da4-5773-a35d-f09f35516166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449565}] :answer-field/correct {:answer/id #uuid "2e911fcf-5da4-5773-a35d-f09f35516166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449565} :answer-field/id #uuid "0f2d1ae9-8c9e-5ac2-a9bb-09e86348c551" :answer-field/key "$\\lambda =-4$ is an eigenvalue of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450736} {:answer-field/choices [{:answer/id #uuid "2fbac379-e615-5a86-9163-aad1e70a6e39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449566} {:answer/id #uuid "9cdbec38-3b6f-5e45-a26d-04e807074a86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449567}] :answer-field/correct {:answer/id #uuid "2fbac379-e615-5a86-9163-aad1e70a6e39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449566} :answer-field/id #uuid "04180575-beb1-59bc-83ca-8f929f6a729f" :answer-field/key "The eigenvalue $\\lambda =2$ has algebraic multiplicity $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a042e23b-9a4b-5f08-a06a-17d78f4dd358" :question/math-academy-id "q-140450" :question/problem "$$\nP=\\begin{bmatrix}5 & 2 & -6 & 8 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & -3 & -4 & 9 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}.\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}5-\\lambda  & 2 & -6 & 8 \\\\ 0 & -\\lambda  & 0 & 7 \\\\ 0 & -3 & -4-\\lambda  & 9 \\\\ 0 & 0 & 0 & 2-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 2 & -6 & 8 \\\\ 0 & -\\lambda  & 0 & 7 \\\\ 0 & -3 & -4-\\lambda  & 9 \\\\ 0 & 0 & 0 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )\\begin{vmatrix}-\\lambda  & 0 & 7 \\\\ -3 & -4-\\lambda  & 9 \\\\ 0 & 0 & 2-\\lambda \\end{vmatrix} & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(5-\\lambda )\\cdot (2-\\lambda )\\begin{vmatrix}-\\lambda  & 0 \\\\ -3 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(2-\\lambda )(-\\lambda )(-4-\\lambda ) & =0 \\\\ (\\lambda -5)(\\lambda -2)\\lambda (\\lambda +4) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =5,$ $\\lambda =2,$ $\\lambda =0,$ and $\\lambda =-4$  (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is “$\\lambda =0$ is an eigenvalue of $P$”; “$\\lambda =-4$ is an eigenvalue of $P$” only."} {:db/id #edb/ref 17592186272104 :knowledge-point/_questions [{:db/id #edb/ref 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal" :topic/_knowledge-points [{:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a096c2-c6c3-52ba-8ac3-585757485178" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464108} {:answer/id #uuid "56ad38ea-3da9-54a5-b599-12a437f08a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464109}] :answer-field/correct {:answer/id #uuid "56ad38ea-3da9-54a5-b599-12a437f08a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464109} :answer-field/id #uuid "bd73ff08-a0f2-55a4-ab61-bf0d8769c609" :answer-field/key "$U={\\begin{bmatrix}5 \\\\ 3 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464988} {:answer-field/choices [{:answer/id #uuid "4c0fff84-54a3-54cd-a2e6-fe2346e5c3bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464110} {:answer/id #uuid "82a0f2d6-342e-528e-be81-c9d0b902af44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464111}] :answer-field/correct {:answer/id #uuid "4c0fff84-54a3-54cd-a2e6-fe2346e5c3bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464110} :answer-field/id #uuid "bd3a8733-5fd0-54bc-836c-e7cc8f83b523" :answer-field/key "$V={\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix},\\begin{bmatrix}4 \\\\ -2 \\\\ 2\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464989} {:answer-field/choices [{:answer/id #uuid "c76788ef-a5ec-5512-9168-7ccf38baeca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464112} {:answer/id #uuid "5633e640-236c-5992-b88d-01b8d795c3bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464113}] :answer-field/correct {:answer/id #uuid "5633e640-236c-5992-b88d-01b8d795c3bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464113} :answer-field/id #uuid "df2030c1-66d7-59ae-9ef7-a05da9bdf30c" :answer-field/key "$W={\\begin{bmatrix}5 \\\\ 3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}2 \\\\ -3 \\\\ -1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b412ef2-b86f-5688-ad69-1945a2870af7" :question/math-academy-id "q-140480" :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$ \n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2},{w}_{3}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ notice that\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}5 \\\\ 3 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix}=10-9-1=0 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $V,$ notice that \n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ -2 \\\\ 2\\end{bmatrix}=4-4+4=4\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3 \\\\ -1\\end{bmatrix}=10-9-1=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{3} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}=0+3-3=0 & ✓ \\\\ {w}_{2}\\cdot {w}_{3} & =\\begin{bmatrix}2 \\\\ -3 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}=0-3+3=0 & ✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"."} {:db/id #edb/ref 17592186272106 :knowledge-point/_questions [{:db/id #edb/ref 17592186133781 :knowledge-point/id #uuid "ed5c8af7-e617-5e8c-be01-45a26eb17d4d" :knowledge-point/title "Determining Whether Sets are Orthonormal" :topic/_knowledge-points [{:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe7b5c5f-a26d-5d34-bfcb-d5696b3c7942" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464114} {:answer/id #uuid "1bab4da3-03b0-5c35-95f9-e1837ab424f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464115}] :answer-field/correct {:answer/id #uuid "1bab4da3-03b0-5c35-95f9-e1837ab424f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464115} :answer-field/id #uuid "f11ee610-452b-5628-a0a2-72ae40e7ab77" :answer-field/key "$U={\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464991} {:answer-field/choices [{:answer/id #uuid "1366dbcb-9dad-5292-ba82-6f19179612a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464116} {:answer/id #uuid "d3421cd8-7243-549f-baa8-2099100e2b0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464117}] :answer-field/correct {:answer/id #uuid "d3421cd8-7243-549f-baa8-2099100e2b0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464117} :answer-field/id #uuid "3853292a-fe0b-516d-9a99-df4ebadfedb6" :answer-field/key "$V={\\begin{bmatrix}\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ -\\frac{2}{3}\\end{bmatrix},\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464992} {:answer-field/choices [{:answer/id #uuid "ddafd2b2-18ea-5850-b12e-4909c1360753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464118} {:answer/id #uuid "e3b80115-a2f6-5830-9801-70d1e6f5eed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464119}] :answer-field/correct {:answer/id #uuid "ddafd2b2-18ea-5850-b12e-4909c1360753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464118} :answer-field/id #uuid "b01ebad9-f142-5b89-860c-309aff28bda8" :answer-field/key "$W={\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464993}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d09c8cc-56af-54e4-b26f-33ef3a4b7c45" :question/math-academy-id "q-140483" :question/problem "Which of the following sets are orthonormal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$ \n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{1} &=1 \\\\ {u}_{2}\\cdot {u}_{2} &=1.\\end{aligned}\\right.$\n\n- ${v}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{v}_{1}\\cdot {v}_{1} &=1 \\\\ {v}_{2}\\cdot {v}_{2} &=1.\\end{aligned}\\right.$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{w}_{1}\\cdot {w}_{1} &=1 \\\\ {w}_{2}\\cdot {w}_{2} &=1.\\end{aligned}\\right.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=-\\frac{1}{2}+\\frac{1}{2}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{1}{2}+\\frac{1}{2}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{1}{2}+\\frac{1}{2}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ we get the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ -\\frac{2}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}=\\frac{2}{3\\sqrt{5}}+0-\\frac{2}{3\\sqrt{5}}=0 & ✓ \\\\ {v}_{1}\\cdot {v}_{1} & =\\begin{bmatrix}\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ -\\frac{2}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ -\\frac{2}{3}\\end{bmatrix}=\\frac{1}{9}+\\frac{4}{9}+\\frac{4}{9}=1 & ✓ \\\\ {v}_{2}\\cdot {v}_{2} & =\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}=\\frac{4}{5}+\\frac{1}{5}=1 & ✓\\end{aligned}\n$$\n\nSo, $V$ is an orthonormal set.\n\n- For the set $W,$ notice that\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}=-\\frac{1}{2}-\\frac{1}{2}=-1 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $V$ only\"."} {:db/id #edb/ref 17592186272107 :knowledge-point/_questions [{:db/id #edb/ref 17592186133781 :knowledge-point/id #uuid "ed5c8af7-e617-5e8c-be01-45a26eb17d4d" :knowledge-point/title "Determining Whether Sets are Orthonormal" :topic/_knowledge-points [{:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97ee4807-0768-5dc5-aeb6-4da0e5622499" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464120} {:answer/id #uuid "867eac9d-8432-5a6b-a7e2-86a32542c8cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464121}] :answer-field/correct {:answer/id #uuid "867eac9d-8432-5a6b-a7e2-86a32542c8cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464121} :answer-field/id #uuid "38be1c21-f6e9-54d4-9142-3c32d41421a3" :answer-field/key "$U={\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix},\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464994} {:answer-field/choices [{:answer/id #uuid "11b479a3-7665-5809-93c8-9923bd9dd078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464122} {:answer/id #uuid "0434d7ec-2c3f-5911-b5ee-e68fee2943f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464123}] :answer-field/correct {:answer/id #uuid "11b479a3-7665-5809-93c8-9923bd9dd078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464122} :answer-field/id #uuid "d7fe6036-bc87-5e27-87c6-c994de7b29fc" :answer-field/key "$V={\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464995} {:answer-field/choices [{:answer/id #uuid "c6e7f0ef-5080-5bcb-a31e-245444bb3767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464124} {:answer/id #uuid "8a380d84-b266-5704-bc8b-eadf0657fcbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464125}] :answer-field/correct {:answer/id #uuid "c6e7f0ef-5080-5bcb-a31e-245444bb3767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464124} :answer-field/id #uuid "988bc0b9-cec8-5860-8c76-531f6f5c225e" :answer-field/key "$W={\\begin{bmatrix}\\frac{2}{\\sqrt{29}} \\\\ -\\frac{5}{\\sqrt{29}}\\end{bmatrix},\\begin{bmatrix}-\\frac{2}{\\sqrt{29}} \\\\ \\frac{5}{\\sqrt{29}}\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464996}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "762f53a4-6eba-533a-aefb-847dcb22ecb6" :question/math-academy-id "q-140484" :question/problem "Which of the following sets are orthonormal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$\n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2}}$, respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{1} &=1 \\\\ {u}_{2}\\cdot {u}_{2} &=1.\\end{aligned}\\right.$\n\n- ${v}_{1}\\cdot {v}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{v}_{1}\\cdot {v}_{1} &=1 \\\\ {v}_{2}\\cdot {v}_{2} &=1.\\end{aligned}\\right.$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,\\left\\{\\begin{aligned}{w}_{1}\\cdot {w}_{1} &=1 \\\\ {w}_{2}\\cdot {w}_{2} &=1.\\end{aligned}\\right.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}=\\frac{6}{13}-\\frac{6}{13}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}=\\frac{4}{13}+\\frac{9}{13}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}=\\frac{9}{13}+\\frac{4}{13}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{1} & =\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3\\end{bmatrix}=4+9=13\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ notice that\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}\\frac{2}{\\sqrt{29}} \\\\ -\\frac{5}{\\sqrt{29}}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{2}{\\sqrt{29}} \\\\ \\frac{5}{\\sqrt{29}}\\end{bmatrix}=-\\frac{4}{29}-\\frac{25}{29}=-1\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ only\"." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049811 :topic/id #uuid "157ebcd0-6389-529a-a695-53136d4482c5" :topic/math-academy-id 2103 :topic/title "Orthogonal Sets in Euclidean Spaces"} :activity/title "Orthogonal Sets in Euclidean Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186510757} :db/id #edb/ref 17592186511617}]} {:db/id #edb/ref 17592186272112 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14825df6-62a0-58c7-84f8-874b33d80648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464126} {:answer/id #uuid "e1fbbaf0-77de-5023-a066-2a3d3242c32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464127}] :answer-field/correct {:answer/id #uuid "14825df6-62a0-58c7-84f8-874b33d80648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464126} :answer-field/id #uuid "5210290a-0c21-5691-8070-7eab6efd06ea" :answer-field/key "${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464997} {:answer-field/choices [{:answer/id #uuid "e25fed85-ab3b-5a31-8f1d-2a199858b504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464128} {:answer/id #uuid "5b56749b-79d6-59cb-8f18-a65746c114a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464129}] :answer-field/correct {:answer/id #uuid "e25fed85-ab3b-5a31-8f1d-2a199858b504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464128} :answer-field/id #uuid "09f16e55-e049-5129-afae-8b306d36faba" :answer-field/key "${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464998} {:answer-field/choices [{:answer/id #uuid "0a92bd8e-cc40-5cc1-818c-7a58e0faa065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464130} {:answer/id #uuid "71370a5b-7609-5a96-aecd-d3b1db769e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464131}] :answer-field/correct {:answer/id #uuid "0a92bd8e-cc40-5cc1-818c-7a58e0faa065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464130} :answer-field/id #uuid "0148a50b-ed82-5196-9619-6267975e2539" :answer-field/key "$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464999}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0aa2e7ba-284c-52fb-a0ea-9a38be5541e4" :question/math-academy-id "q-140500" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={e}^{t},\\,{f}_{3}(t)={e}^{-t}\n$$\n\nGiven that the inner product in the vector space $C[-1,1]$ of continuous functions over $[-1,1]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{1}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩ & =⟨t,{e}^{t}⟩ \\\\  & ={\\int }_{-1}^{1}t{e}^{t}\\,\\text{d}t\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}={e}^{t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{t}\\,\\text{d}t={e}^{t}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}t{e}^{t}\\,\\text{d}t & =uv{|}_{-1}^{1}-{\\int }_{-1}^{1}{u}^{′}v\\,\\text{d}t \\\\  & =t{e}^{t}{|}_{-1}^{1}-{\\int }_{-1}^{1}{e}^{t}\\,\\text{d}t \\\\  & =(e+{e}^{-1})-{e}^{t}{|}_{-1}^{1} \\\\  & =(e+{e}^{-1})-(e-{e}^{-1}) \\\\  & =2{e}^{-1}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩ & =⟨t,{e}^{-t}⟩ \\\\  & ={\\int }_{-1}^{1}t{e}^{-t}\\,\\text{d}t\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}={e}^{-t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{-t}\\,\\text{d}t=-{e}^{-t}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}t{e}^{-t}\\,\\text{d}t & =uv{|}_{-1}^{1}-{\\int }_{-1}^{1}{u}^{′}v\\,\\text{d}t \\\\  & =-t{e}^{-t}{|}_{-1}^{1}+{\\int }_{-1}^{1}{e}^{-t}\\,\\text{d}t \\\\  & =(-{e}^{-1}-e)-{e}^{-t}{|}_{-1}^{1} \\\\  & =(-{e}^{-1}-e)-({e}^{-1}-e) \\\\  & =-2{e}^{-1}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${f}_{1}(t)⊥̸{f}_{2}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186272117 :knowledge-point/_questions [{:db/id #edb/ref 17592186133791 :knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049489 :topic/id #uuid "f8e64c9f-51e4-540d-a7ed-38ccf90ff042" :topic/math-academy-id 2125 :topic/title "Projection Matrices, Linear Transformations and Their Properties"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5323cb97-ac83-5617-9451-c5dfd680fbc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449568} {:answer/id #uuid "a9828927-8aaf-5ea7-a8ec-5fb9d03db992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449569}] :answer-field/correct {:answer/id #uuid "5323cb97-ac83-5617-9451-c5dfd680fbc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449568} :answer-field/id #uuid "a0cbb15e-453d-5b51-81b0-ca47930a92de" :answer-field/key "${A}^{T}=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450738} {:answer-field/choices [{:answer/id #uuid "a18dfad2-f45c-5903-8c9f-08e7b63dde4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449570} {:answer/id #uuid "81e75614-a0e7-5c9a-a480-2d8eefd2495e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449571}] :answer-field/correct {:answer/id #uuid "81e75614-a0e7-5c9a-a480-2d8eefd2495e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449571} :answer-field/id #uuid "0c33c7c0-4023-5c8d-ba94-8003a8af2ae3" :answer-field/key "${A}^{2}=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450739} {:answer-field/choices [{:answer/id #uuid "924e6b72-ed71-52d5-8470-46bc097810ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449572} {:answer/id #uuid "248635cc-dccd-548b-bb11-890a2ac23cbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449573}] :answer-field/correct {:answer/id #uuid "924e6b72-ed71-52d5-8470-46bc097810ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449572} :answer-field/id #uuid "528cf493-a516-506a-97a3-468d5630b6dd" :answer-field/key "$A$ is an orthogonal projection matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450740}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6043910d-249c-5dcb-8998-243aef51387f" :question/math-academy-id "q-140516" :question/problem "$$\nA=\\begin{bmatrix}2 & -2 \\\\ 1 & -1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement ${A}^{T}=A$ is false since ${A}^{T}\\ne A.$\n\n- Statement ${A}^{2}=A$ is true. Indeed, \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}2 & -2 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}2 & -2 \\\\ 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -2 \\\\ 1 & -1\\end{bmatrix} \\\\  & =A.\\end{aligned}\n$$\n\n- Statement “$A$ is an orthogonal projection matrix” is false since not both statements ${A}^{T}=A$ and ${A}^{2}=A$ are true.\n\nTherefore, the correct answer is \" ${A}^{2}=A$ only.\"" :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186049489 :topic/id #uuid "f8e64c9f-51e4-540d-a7ed-38ccf90ff042" :topic/math-academy-id 2125 :topic/title "Projection Matrices, Linear Transformations and Their Properties"} :activity/title "Projection Matrices, Linear Transformations and Their Properties" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553857} :db/id #edb/ref 17592186554655}]} {:db/id #edb/ref 17592186272132 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product" :topic/_knowledge-points [{:db/id #edb/ref 17592186048572 :topic/id #uuid "aabe8b8c-a429-5abb-824a-40f9fdf376e0" :topic/math-academy-id 2104 :topic/title "Orthogonal Sets in Inner Product Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d426fbe9-2fb2-5b28-967f-234309d25849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449574} {:answer/id #uuid "fdd99d73-78c2-5236-b09b-9ba613721f68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449575}] :answer-field/correct {:answer/id #uuid "d426fbe9-2fb2-5b28-967f-234309d25849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449574} :answer-field/id #uuid "9097899a-6ed8-5834-83d9-726bd3b6cf6e" :answer-field/key "${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450741} {:answer-field/choices [{:answer/id #uuid "d2cc8389-7838-565b-a698-71a1092881de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449576} {:answer/id #uuid "fe7dda05-3241-5fa4-8034-6b34a36ab464" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449577}] :answer-field/correct {:answer/id #uuid "fe7dda05-3241-5fa4-8034-6b34a36ab464" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449577} :answer-field/id #uuid "4561b560-5b74-503e-9255-064df400247c" :answer-field/key "${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450742} {:answer-field/choices [{:answer/id #uuid "2ebdfbca-646e-5a4a-a419-81feca830588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449578} {:answer/id #uuid "e03cb4d2-ee7f-542e-bb5a-1009b0ea20bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449579}] :answer-field/correct {:answer/id #uuid "2ebdfbca-646e-5a4a-a419-81feca830588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449578} :answer-field/id #uuid "39f56975-4129-5966-8dae-664be98d8fbe" :answer-field/key "$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450743}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1e4b04d4-e7d3-5042-809a-2a3512a7a902" :question/math-academy-id "q-140556" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=2(t-1),\\,{f}_{2}(t)={e}^{t},\\,{f}_{3}(t)={e}^{(t-1)^{2}}\n$$\n\nGiven that the inner product in the vector space $C[0,2]$ of continuous functions over $[0,2]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{2}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩ & =⟨2(t-1),{e}^{t}⟩ \\\\  & ={\\int }_{0}^{2}2(t-1)({e}^{t})\\,\\text{d}t\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=2(t-1) & ⟹ & {u}^{′}=2, \\\\ {v}^{′}={e}^{t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{t}\\,\\text{d}t={e}^{t}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}2(t-1){e}^{t}\\,\\text{d}t & =uv{|}_{0}^{2}-{\\int }_{0}^{2}{u}^{′}v\\,\\text{d}t \\\\  & =(2(t-1){e}^{t}){|}_{0}^{2}-{\\int }_{0}^{2}2{e}^{t}\\,\\text{d}t \\\\  & =(2{e}^{2}-(-2))-2{e}^{t}{|}_{0}^{2} \\\\  & =2{e}^{2}+2-(2{e}^{2}-2) \\\\  & =4\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product” is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩ & =⟨2(t-1),{e}^{(t-1)^{2}}⟩ \\\\  & ={\\int }_{0}^{2}2(t-1){e}^{(t-1)^{2}}\\,\\text{d}t \\\\  & ={e}^{(t-1)^{2}}{|}_{0}^{2} \\\\  & =e-e \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${f}_{1}(t)⊥̸{f}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186272134 :knowledge-point/_questions [{:db/id #edb/ref 17592186133951 :knowledge-point/id #uuid "da20ffe7-173b-5fc0-8629-3b9b70222860" :knowledge-point/title "Identifying True Statements About Orthogonal Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186049606 :topic/id #uuid "03f0df59-343c-5dd7-ad4a-b7bacf1e1f44" :topic/math-academy-id 2105 :topic/title "Orthogonal Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98311a5d-c789-50b1-998c-82789cf3e15c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464132} {:answer/id #uuid "4a1caad2-1552-53b2-ad65-0faf937f9cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464133}] :answer-field/correct {:answer/id #uuid "4a1caad2-1552-53b2-ad65-0faf937f9cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464133} :answer-field/id #uuid "94d3e7a6-f070-518f-bca6-72c0a2e523f0" :answer-field/key "If $\\lambda $ is a real eigenvalue of $Q,$ then $\\lambda =\\pm 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465000} {:answer-field/choices [{:answer/id #uuid "2950a552-7b64-54f3-9df5-37fbc1daf708" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464134} {:answer/id #uuid "57bc0bcf-2d74-5b42-80b8-a9462aac80d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464135}] :answer-field/correct {:answer/id #uuid "2950a552-7b64-54f3-9df5-37fbc1daf708" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464134} :answer-field/id #uuid "11e24475-4728-5731-901b-4204e0ce6cef" :answer-field/key "If the determinant of $P$ is either $1$ or $-1,$ then $P$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465001} {:answer-field/choices [{:answer/id #uuid "427e5f77-75e3-5ea5-8f93-8f5a66733617" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464136} {:answer/id #uuid "01222f75-c4bd-542d-8467-b02dd4c8ea9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464137}] :answer-field/correct {:answer/id #uuid "427e5f77-75e3-5ea5-8f93-8f5a66733617" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464136} :answer-field/id #uuid "d74724c4-d89e-52f6-b857-07eecbd822cb" :answer-field/key "$Q-I$ is singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465002}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3d61daa-c943-5ecf-a98c-7f9bcd210491" :question/math-academy-id "q-140565" :question/problem "Which of the following statements are true regarding the $n\\times n$ orthogonal matrix $Q$ and the $n\\times n$ matrix $P?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a matrix $Q$ is orthogonal if and only if\n\n$$\nQ{Q}^{T}={Q}^{T}Q=I.\n$$\n\nTo check that a matrix is orthogonal, it is sufficient to check that the above equation is satisfied.\n\nMoreover, we have the following properties:\n\n- For any orthogonal matrix $Q,$ we have ${Q}^{-1}={Q}^{T}.$\n\n- $(AB)^{T}={B}^{T}{A}^{T}$ for conformable matrices $A$ and $B.$\n\nWith that in mind, let's inspect each of the statements in turn.\n\n- Statement “If $\\lambda $ is a real eigenvalue of $Q,$ then $\\lambda =\\pm 1$” is true. If $\\lambda $ is an eigenvalue of an orthogonal matrix $Q$ then $\\lambda =\\pm 1$\n\n- Statement “If the determinant of $P$ is either $1$ or $-1,$ then $P$ is orthogonal” is false. Every orthogonal matrix has the determinant equal to $\\pm 1$, but not every matrix with the determinant equal to $\\pm 1$ is orthogonal. As a counterexample, consider the following matrix:\n\n$$\nP=\\begin{bmatrix}2 & 1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nThe determinant of $P$ is\n\n$$\n\\begin{aligned}det(P)=2\\cdot 1-1\\cdot 1=1,\\end{aligned}\n$$\n\n however, $P$ is not orthogonal since, for example, the first column is not normalized.\n\n- Statement “$Q-I$ is singular” is false. As a counterexample, consider the following orthogonal matrix:\n\n$$\nQ=\\begin{bmatrix}\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}\n$$\n\nWe have that\n\n$$\nQ-I=\\begin{bmatrix}\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & -\\frac{2}{5}\\end{bmatrix}\n$$\n\nand $Q-I$ is not singular since, for example, it doesn't have proportional rows or columns.\n\nTherefore, the correct answer is “If $\\lambda $ is a real eigenvalue of $Q,$ then $\\lambda =\\pm 1$” only."} {:db/id #edb/ref 17592186272158 :knowledge-point/_questions [{:db/id #edb/ref 17592186124528 :knowledge-point/id #uuid "20a6c0cf-04d4-5908-a03f-1adf491b9282" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem in Terms of Eigenvalues" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d4ff535-a1f0-5ce6-8b0f-0685c923aebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464138} {:answer/id #uuid "e9853f79-3460-5bbc-b09c-1486f81f69b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464139}] :answer-field/correct {:answer/id #uuid "1d4ff535-a1f0-5ce6-8b0f-0685c923aebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464138} :answer-field/id #uuid "d9e19efd-b193-5d8c-951e-06d2594d3c69" :answer-field/key "$\\lambda (\\lambda -3)(\\lambda +2)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465003} {:answer-field/choices [{:answer/id #uuid "d591cdfe-787c-561e-b1ab-96a237381b8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464140} {:answer/id #uuid "3bd54853-c89a-5086-aedb-4b0387aa7aa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464141}] :answer-field/correct {:answer/id #uuid "3bd54853-c89a-5086-aedb-4b0387aa7aa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464141} :answer-field/id #uuid "99d9f0ad-5dbc-52a9-a14d-c0423c3659b8" :answer-field/key "$2{\\lambda }^{3}-4{\\lambda }^{2}+\\lambda -4=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465004} {:answer-field/choices [{:answer/id #uuid "4d063335-7f55-523f-94d2-bc87bd49b8d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464142} {:answer/id #uuid "c08d56be-7940-5e02-8c76-d6c91fd825db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464143}] :answer-field/correct {:answer/id #uuid "4d063335-7f55-523f-94d2-bc87bd49b8d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464142} :answer-field/id #uuid "708f3344-420a-5f82-a998-358eeabd9c9b" :answer-field/key "$5{\\lambda }^{3}+2{\\lambda }^{2}-3\\lambda =0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27c4d64e-3a6c-52f2-bb70-03acd0cf6bbd" :question/math-academy-id "q-140834" :question/problem "If $A$ is a $3\\times 3$ invertible matrix, then which of the following could be the characteristic equation of $A?$\n\nSelect all that apply." :question/worked-solution "Since $A$ is invertible, according to the invertible matrix theorem, $0$ can't be an eigenvalue of $A.$ As a result, $\\lambda =0$ should not be a solution to the corresponding characteristic equation. \n\nWith that in mind, let's examine the given equations in turn.\n\n- Equation $\\lambda (\\lambda -3)(\\lambda +2)=0$ **cannot** be the characteristic equation of $A$ since $\\lambda =0$ is a root of the equation.\n\n- Equation $2{\\lambda }^{3}-4{\\lambda }^{2}+\\lambda -4=0$ could be the characteristic equation of $A.$ Indeed, $\\lambda =0$ is not a root of the equation.\n\n- Equation $5{\\lambda }^{3}+2{\\lambda }^{2}-3\\lambda =0$ **cannot** be the characteristic equation of $A$ since $\\lambda =0$ is a root of the equation.\n\nTherefore, the correct answer is $2{\\lambda }^{3}-4{\\lambda }^{2}+\\lambda -4=0$ only."} {:db/id #edb/ref 17592186272159 :knowledge-point/_questions [{:db/id #edb/ref 17592186124528 :knowledge-point/id #uuid "20a6c0cf-04d4-5908-a03f-1adf491b9282" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem in Terms of Eigenvalues" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54b49fd5-f088-5454-be5d-5107c647f0f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449580} {:answer/id #uuid "13e0f499-69e4-5ec1-b4f2-1ad1e4f28df9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449581}] :answer-field/correct {:answer/id #uuid "13e0f499-69e4-5ec1-b4f2-1ad1e4f28df9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449581} :answer-field/id #uuid "272bcebc-fe8b-57b4-ae53-626fe72f2b23" :answer-field/key "$\\lambda =2$ is a root of the characteristic equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450744} {:answer-field/choices [{:answer/id #uuid "5e17838a-706f-5603-a10d-92de20c57c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449582} {:answer/id #uuid "0ab54959-e3f9-5e7c-b65b-3f4c44ab857d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449583}] :answer-field/correct {:answer/id #uuid "5e17838a-706f-5603-a10d-92de20c57c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449582} :answer-field/id #uuid "c399833e-a33e-5bf1-abf9-d826969c4585" :answer-field/key "$\\lambda =0$ is an eigenvalue of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450745} {:answer-field/choices [{:answer/id #uuid "62e97b3f-deab-5976-8ff6-07262066e30a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449584} {:answer/id #uuid "3b3e26df-93cc-5b9e-a97e-f3c98599c684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449585}] :answer-field/correct {:answer/id #uuid "3b3e26df-93cc-5b9e-a97e-f3c98599c684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449585} :answer-field/id #uuid "f1e96681-263d-592f-94b0-d87293b9e481" :answer-field/key "$A$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1812a9f8-6cf3-5d8f-b5c7-1adf1d688a91" :question/math-academy-id "q-140835" :question/problem "A matrix $A$ has the characteristic equation $2{\\lambda }^{3}-3{\\lambda }^{2}-4=0.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem in terms of eigenvectors states the following:\n\n*The square matrix $A$ is invertible if and only if $0$ is not an eigenvalue of $A.$*\n\nWith that in mind, let's examine our statements.\n\n- Statement “$\\lambda =2$ is a root of the characteristic equation” is true. Indeed, substituting $\\lambda =2$ into the equation, we obtain\n\n$$\n\\begin{aligned}2{\\lambda }^{3}-3{\\lambda }^{2}-4 & =0 \\\\ 2(2)^{3}-3(2)^{2}-4 & =0 \\\\ 16-12-4 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$\\lambda =0$ is an eigenvalue of $A$” is false. Since $\\lambda =0$ is not a root of the characteristic equation, $\\lambda =0$ is not an eigenvalue of $A.$\n\n- Statement “$A$ is invertible” is true. Indeed, $\\lambda =0$ is not an eigenvalue of $A.$ As a result, according to the invertible matrix theorem, $A$ is invertible.\n\nTherefore, the correct answer is “$\\lambda =2$ is a root of the characteristic equation”; “$A$ is invertible” only."} {:db/id #edb/ref 17592186272160 :knowledge-point/_questions [{:db/id #edb/ref 17592186124605 :knowledge-point/id #uuid "c34e7d59-6bb4-5c2f-808f-212503d55338" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31698bf4-835e-5391-bd94-e5338ea6725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449586} {:answer/id #uuid "5d3381fd-405f-5c82-9e7e-171f8dc5dbf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449587}] :answer-field/correct {:answer/id #uuid "5d3381fd-405f-5c82-9e7e-171f8dc5dbf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449587} :answer-field/id #uuid "81d2e4de-00be-5228-ac60-63ff9be610ee" :answer-field/key "$(A+4I)x=0$ has a nonzero solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450747} {:answer-field/choices [{:answer/id #uuid "5889c469-8246-5988-a4b6-18db86a78f24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449588} {:answer/id #uuid "4c685a84-65d1-5256-b2c2-aa1ebe137a6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449589}] :answer-field/correct {:answer/id #uuid "5889c469-8246-5988-a4b6-18db86a78f24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449588} :answer-field/id #uuid "8dca00bd-3230-521f-ad18-be85e3bb3f7f" :answer-field/key "$\\text{Col}(A+4I)={R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450748} {:answer-field/choices [{:answer/id #uuid "ea8085ac-e799-5424-8198-147afdc52305" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449590} {:answer/id #uuid "42e23434-b855-57e0-a5e5-feab08f636f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449591}] :answer-field/correct {:answer/id #uuid "ea8085ac-e799-5424-8198-147afdc52305" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449590} :answer-field/id #uuid "8ee94435-98e2-554c-8d74-17c95d5c7950" :answer-field/key "$\\text{nullity}(A+4I)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47d1848e-d69a-5675-a8fe-fca5e30be264" :question/math-academy-id "q-140838" :question/problem "If $A$ is a $2\\times 2$ matrix and $\\lambda =-4$ is an eigenvalue of $A,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=A+4I.$\n\n- Statement “$(A+4I)x=0$ has a nonzero solution” is true. Notice that if $\\lambda =4$ is an eigenvalue of $A,$ then the nonzero solutions of $(A+4I)x=0$ are eigenvectors of $A.$ As a result, the matrix $M=A+4I$ must be singular.\n\n- Statements $\\text{Col}(A+4I)={R}^{2}$ and $\\text{nullity}(A+4I)=0$ are false. Since $M=A+4I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{Col}(A+4I)\\ne {R}^{2},\n$$\n\nand \n\n$$\n\\text{nullity}(A+4I)\\ne 0.\n$$\n\nTherefore, the correct answer is “$(A+4I)x=0$ has a nonzero solution” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"} :activity/title "The Invertible Matrix Theorem in Terms of Eigenvalues" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569444} :db/id #edb/ref 17592186570046}]} {:db/id #edb/ref 17592186272161 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8814293-c8a9-578f-8657-39a79ba1371c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449592} {:answer/id #uuid "9bfdb8f8-d8cb-528e-b9a4-cc0c1b63c6e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449593}] :answer-field/correct {:answer/id #uuid "9bfdb8f8-d8cb-528e-b9a4-cc0c1b63c6e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449593} :answer-field/id #uuid "4178ebcf-70fd-5899-ba5f-d287bb465aff" :answer-field/key "$A-7I$ is singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450750} {:answer-field/choices [{:answer/id #uuid "07fbd334-3cb4-5c97-bc5d-e7ad07664145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449594} {:answer/id #uuid "86749cb9-992d-5952-84f4-2774168aaffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449595}] :answer-field/correct {:answer/id #uuid "07fbd334-3cb4-5c97-bc5d-e7ad07664145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449594} :answer-field/id #uuid "f0ed7cb0-5034-527d-8e0b-18cfb88e3287" :answer-field/key "$\\text{nullity}(A-7I)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450751} {:answer-field/choices [{:answer/id #uuid "80c3ee31-dad8-510e-a6f6-7b0ff0870e77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449596} {:answer/id #uuid "52e36725-146c-55d1-82ce-88952ae9ecda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449597}] :answer-field/correct {:answer/id #uuid "52e36725-146c-55d1-82ce-88952ae9ecda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449597} :answer-field/id #uuid "e0b37f56-b08e-5b30-9546-ef7378db28c7" :answer-field/key "$\\lambda =7$ is an eigenvalue of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450752}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f77ae0b2-0cbc-5c99-a8dc-82a79dae8fdc" :question/math-academy-id "q-140840" :question/problem "If $A$ is a $2\\times 2$ matrix and $\\text{rank}(A-7I)=0,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $2$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=2.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statements “$A-7I$ is singular” is true. By the invertible matrix theorem, since $\\text{nullity}(A-7I)\\ne 0,$ we obtain that $A-7I$ must be singular.\n\n- Statement $\\text{nullity}(A-7I)=0$ is false. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(A-7I) & =2-\\text{rank}(A-7I) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement “$\\lambda =7$ is an eigenvalue of $A$” is true. Notice that if $M=A-7I$ is singular, then $(A-7I)x=0$ has nonzero solutions which will be eigenvectors of $A.$ As a result, $\\lambda =7$ is an eigenvalue of $A.$\n\nTherefore, the correct answer is “$A-7I$ is singular”; “$\\lambda =7$ is an eigenvalue of $A$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"} :activity/title "The Invertible Matrix Theorem in Terms of Eigenvalues" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569444} :db/id #edb/ref 17592186570068}]} {:db/id #edb/ref 17592186272162 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b4be9e5-5d17-516f-93ec-642cf35049d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449598} {:answer/id #uuid "cab9c958-3a80-540b-ab7a-187b9352bd82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449599}] :answer-field/correct {:answer/id #uuid "cab9c958-3a80-540b-ab7a-187b9352bd82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449599} :answer-field/id #uuid "6e69b620-3713-58e6-9c80-9c97e40a0bac" :answer-field/key "$A+8I$ is singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450753} {:answer-field/choices [{:answer/id #uuid "0f4ce6ec-b2f5-5058-9d0d-7b33a69016c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449600} {:answer/id #uuid "adb445f6-8d41-53c4-b1c0-49499e68f169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449601}] :answer-field/correct {:answer/id #uuid "adb445f6-8d41-53c4-b1c0-49499e68f169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449601} :answer-field/id #uuid "2734be2f-47b8-53e8-a929-15f253facda9" :answer-field/key "$\\lambda =-8$ is an eigenvalue of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450754} {:answer-field/choices [{:answer/id #uuid "07ccfdef-4d8c-5a2b-a0e4-4e9f919059db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449602} {:answer/id #uuid "c783651d-7745-524f-98a6-8e6ba3438853" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449603}] :answer-field/correct {:answer/id #uuid "07ccfdef-4d8c-5a2b-a0e4-4e9f919059db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449602} :answer-field/id #uuid "60e7c511-421d-56c7-ab16-331aa5063b36" :answer-field/key "$\\text{rank}(A+8I)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450755}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "78a8d2b4-93c9-5ecc-ada3-6436c09c3461" :question/math-academy-id "q-140842" :question/problem "If $A$ is a $3\\times 3$ matrix and $\\text{nullity}(A+8I)=2,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a $3\\times 3$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{3} \\\\  & \\text{dim(Col}(M))=3=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $3$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=3.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statements “$A+8I$ is singular” is true. By the invertible matrix theorem, since $\\text{nullity}(A+8I)\\ne 0,$ we obtain that $A+8I$ must be singular.\n\n- Statement “$\\lambda =-8$ is an eigenvalue of $A$” is true. Notice that if $M=A+8I$ is singular, then $(A+8I)x=0$ has nonzero solutions which will be eigenvectors of $A.$ As a result, $\\lambda =-8$ is an eigenvalue of $A.$\n\n- Statement $\\text{rank}(A+8I)=2$ is false. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{rank}(A+8I) & =3-\\text{nullity}(A+8I) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the correct answer is “$A+8I$ is singular”; “$\\lambda =-8$ is an eigenvalue of $A$” only." :step/_content [{:activity/_steps {:activity/scope {:db/id #edb/ref 17592186046669} :activity/title "Linear Algebra: Placement Exam" :activity/type {:db/id #edb/ref 17592186045462 :db/ident :activity.type/diagnostic} :db/id #edb/ref 17592186549302} :db/id #edb/ref 17592186550064}]} {:db/id #edb/ref 17592186272168 :knowledge-point/_questions [{:db/id #edb/ref 17592186161984 :knowledge-point/id #uuid "e62e458d-0724-5dbe-b448-b79404f279f9" :knowledge-point/title "Identifying Matrices of Quadratic Forms" :topic/_knowledge-points [{:db/id #edb/ref 17592186049450 :topic/id #uuid "f66a029b-c648-5d01-a90b-9ef34d0631d3" :topic/math-academy-id 3123 :topic/title "Quadratic Forms"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "355ee90c-29a8-5f7d-9858-d5d774afc427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464144} {:answer/id #uuid "52c13329-ed29-5a6a-9c3a-980f9b642801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464145}] :answer-field/correct {:answer/id #uuid "355ee90c-29a8-5f7d-9858-d5d774afc427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464144} :answer-field/id #uuid "57268d9e-f878-521e-88c1-e38ad05c4b25" :answer-field/key "$R=\\begin{bmatrix}5 & -2 \\\\ -2 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465006} {:answer-field/choices [{:answer/id #uuid "4fca2a6a-5f0e-57c2-b88a-83793aa0ea03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464146} {:answer/id #uuid "d9140ca1-8724-5815-b59d-81a85f001cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464147}] :answer-field/correct {:answer/id #uuid "4fca2a6a-5f0e-57c2-b88a-83793aa0ea03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464146} :answer-field/id #uuid "d672360c-79a2-53e5-89fd-18eb4ebb73b0" :answer-field/key "$S=\\begin{bmatrix}3 & 2 & 4 \\\\ 2 & -1 & 0 \\\\ 4 & -1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465007} {:answer-field/choices [{:answer/id #uuid "729a3d56-7c5c-50c8-b093-a5ba7c6c0128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464148} {:answer/id #uuid "a192252a-3f86-5dc5-852c-3bafb620daf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464149}] :answer-field/correct {:answer/id #uuid "a192252a-3f86-5dc5-852c-3bafb620daf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464149} :answer-field/id #uuid "045f8e77-8eca-5ea2-86b3-e877ff4aa8cc" :answer-field/key "$T=\\begin{bmatrix}0 & 1 & -1 \\\\ 1 & 3 & -2 \\\\ -1 & -2 & 5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465008}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d68a509c-d790-5483-ab3b-63aef29c3b19" :question/math-academy-id "q-140870" :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Recall that every quadratic form defined on ${R}^{3}$ has an associated $3\\times 3$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $R$ *cannot* be a matrix of a quadratic form defined on ${R}^{3}$ since it's a $2\\times 2$ matrix (not $3\\times 3$).\n\n- $S$ *cannot* be a matrix of a quadratic form defined on ${R}^{3}.$ Although it's a $3\\times 3$ matrix, $S$ is not symmetric since ${s}_{23}\\ne {s}_{32}.$\n\n- $T$ could be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\nTherefore, the correct answer is \"$T$ only.\""} {:db/id #edb/ref 17592186272182 :knowledge-point/_questions [{:db/id #edb/ref 17592186184220 :knowledge-point/id #uuid "dc36f534-6b27-5619-a29e-9954d0310adb" :knowledge-point/title "Verifying Continuity of Two-Piece Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049945 :topic/id #uuid "206244d9-1644-5f25-8714-55d6414eed96" :topic/math-academy-id 3831 :topic/title "Further Continuity of Piecewise Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4e381bf-6c9c-5605-966a-b35057da2e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449604} {:answer/id #uuid "9c8f32ca-165a-5393-ae63-c150ce1c306b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449605}] :answer-field/correct {:answer/id #uuid "9c8f32ca-165a-5393-ae63-c150ce1c306b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449605} :answer-field/id #uuid "66e0a478-6a35-5744-894e-c9b8f611afd0" :answer-field/key "$f(x)$ is left-continuous at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450756} {:answer-field/choices [{:answer/id #uuid "a636b18f-de45-54dd-bf75-d5e8df57e845" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449606} {:answer/id #uuid "01199d5e-e4db-5cee-be87-85f83410a997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449607}] :answer-field/correct {:answer/id #uuid "01199d5e-e4db-5cee-be87-85f83410a997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449607} :answer-field/id #uuid "2752ff2a-799c-5a7d-8cee-7ee9be00a515" :answer-field/key "$f(x)$ is right-continuous at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450757} {:answer-field/choices [{:answer/id #uuid "4bc9a02a-c873-542d-bbd5-2ec547ae30ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449608} {:answer/id #uuid "98305c7d-910a-50c8-af6b-67e895437595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449609}] :answer-field/correct {:answer/id #uuid "98305c7d-910a-50c8-af6b-67e895437595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449609} :answer-field/id #uuid "dc30472f-1800-5c50-8589-44d98ff1f3c9" :answer-field/key "$f(x)$ is continuous at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450758}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3fd6961-1be3-5be2-829e-70725d6ca86c" :question/math-academy-id "q-141001" :question/problem "Which of the following statements are true regarding the function $f(x),$ defined below?\n\n$$\nf(x)={\\begin{aligned}-{x}^{2},\\, & x\\le 1 \\\\ \\operatorname{cos}⁡(\\pi x),\\, & x>1\\end{aligned}\n$$\n\nSelect all that apply." :question/worked-solution "We're required to determine the left and right continuity properties of $f(x)$ at $x=1.$\n\nLet's start by computing $f(1):$\n\n$$\n\\begin{aligned}f(1) & =-{1}^{2} \\\\  & =-1\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$f(x)$ is left-continuous at $x=1$” is true. The function is left-continuous at $x=1$ since the left-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & =-{1}^{2} \\\\  & =-1 \\\\  & =f(1)\\end{aligned}\n$$\n\n- Statement “$f(x)$ is right-continuous at $x=1$” is true. The function is right-continuous at $x=1$ since the right-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & =\\operatorname{cos}⁡(\\pi \\cdot 1) \\\\  & =\\operatorname{cos}⁡(\\pi ) \\\\  & =-1 \\\\  & =f(1)\\end{aligned}\n$$\n\n- Statement “$f(x)$ is continuous at $x=1$” is true. The function is both left and right-continuous at $x=1,$ which implies that the function is continuous at $x=1.$\n\nTherefore, the correct answer is “$f(x)$ is left-continuous at $x=1$”; “$f(x)$ is right-continuous at $x=1$”; “$f(x)$ is continuous at $x=1$”."} {:db/id #edb/ref 17592186272183 :knowledge-point/_questions [{:db/id #edb/ref 17592186184220 :knowledge-point/id #uuid "dc36f534-6b27-5619-a29e-9954d0310adb" :knowledge-point/title "Verifying Continuity of Two-Piece Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049945 :topic/id #uuid "206244d9-1644-5f25-8714-55d6414eed96" :topic/math-academy-id 3831 :topic/title "Further Continuity of Piecewise Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe2430c1-9404-50ea-91aa-3200b0d08b94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449610} {:answer/id #uuid "245efc5d-44d1-5d39-bc8d-755339aee997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449611}] :answer-field/correct {:answer/id #uuid "245efc5d-44d1-5d39-bc8d-755339aee997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449611} :answer-field/id #uuid "a0b46b54-1d4c-5359-8b33-f10c46121151" :answer-field/key "$h(x)$ is left-continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450759} {:answer-field/choices [{:answer/id #uuid "abd205bc-7836-5b62-b46c-5b0c8fabd4f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449612} {:answer/id #uuid "935626d6-d0e9-5b9e-b18b-5ee5afab6724" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449613}] :answer-field/correct {:answer/id #uuid "935626d6-d0e9-5b9e-b18b-5ee5afab6724" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449613} :answer-field/id #uuid "abc396d6-4840-5c57-8b2c-3a929f1325f8" :answer-field/key "$h(x)$ is right-continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450760} {:answer-field/choices [{:answer/id #uuid "5e46b964-af22-5a0f-9648-47dd8d1771a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449614} {:answer/id #uuid "add493c5-11a8-52c0-bc04-c4fdcab8552b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449615}] :answer-field/correct {:answer/id #uuid "add493c5-11a8-52c0-bc04-c4fdcab8552b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449615} :answer-field/id #uuid "af422182-903f-5f2d-82a8-7b8aa64d8f0e" :answer-field/key "$h(x)$ is continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450761}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce7bb2c8-a5d2-5cd9-93b3-f572c13f436f" :question/math-academy-id "q-141002" :question/problem "Which of the following statements are true regarding the function $h(x),$ defined below?\n\n$$\nh(x)={\\begin{aligned}{x}^{3}-27,\\, & x<3 \\\\ \\operatorname{ln}⁡(x-2),\\, & x\\ge 3\\end{aligned}\n$$\n\nSelect all that apply." :question/worked-solution "We're required to determine the left and right continuity properties of $h(x)$ at $x=3.$\n\nLet's start by computing $h(3):$\n\n$$\n\\begin{aligned}h(3) & =\\operatorname{ln}⁡(3-2) \\\\  & =\\operatorname{ln}⁡1 \\\\  & =0\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$h(x)$ is left-continuous at $x=3$” is true. The function is left-continuous at $x=3$ since the left-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}h(x) & ={3}^{3}-27 \\\\  & =27-27 \\\\  & =0 \\\\  & =h(3)\\end{aligned}\n$$\n\n- Statement “$h(x)$ is right-continuous at $x=3$” is true. The function is right-continuous at $x=3$ since the right-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{+}}h(x) & =\\operatorname{ln}⁡(3-2) \\\\  & =\\operatorname{ln}⁡1 \\\\  & =0 \\\\  & =h(3)\\end{aligned}\n$$\n\n- Statement “$h(x)$ is continuous at $x=3$” is true. The function is both left and right-continuous at $x=3,$ which implies that the function is continuous at $x=3.$\n\nTherefore, the correct answer is “$h(x)$ is left-continuous at $x=3$”; “$h(x)$ is right-continuous at $x=3$”; “$h(x)$ is continuous at $x=3$”."} {:db/id #edb/ref 17592186272185 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049945 :topic/id #uuid "206244d9-1644-5f25-8714-55d6414eed96" :topic/math-academy-id 3831 :topic/title "Further Continuity of Piecewise Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce697823-b9ba-531c-b6f6-70c01e71b761" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464150} {:answer/id #uuid "80fb9aca-744f-5fe8-afe1-cdac1ac5b86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464151}] :answer-field/correct {:answer/id #uuid "80fb9aca-744f-5fe8-afe1-cdac1ac5b86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464151} :answer-field/id #uuid "65ae853f-8dce-5116-80a7-2c8ac7eba9c7" :answer-field/key "$g(x)$ is left-continuous at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465009} {:answer-field/choices [{:answer/id #uuid "1e5c4e5a-3e5f-5204-b749-a5e0440b79b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464152} {:answer/id #uuid "e233e265-68ee-5d13-a722-52a821c352f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464153}] :answer-field/correct {:answer/id #uuid "1e5c4e5a-3e5f-5204-b749-a5e0440b79b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464152} :answer-field/id #uuid "da3ea246-aa5b-5727-95be-be543e633a91" :answer-field/key "$g(x)$ is right-continuous at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465010} {:answer-field/choices [{:answer/id #uuid "1a4ef20b-9de9-53a0-84f4-1b5455e1dafb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464154} {:answer/id #uuid "bb9e1cf6-558c-558b-b78c-b49fab9a0c52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464155}] :answer-field/correct {:answer/id #uuid "1a4ef20b-9de9-53a0-84f4-1b5455e1dafb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464154} :answer-field/id #uuid "c96e675e-3b15-5e60-9aa2-5c5f606831d2" :answer-field/key "$g(x)$ is continuous at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465011}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7059aa8-79d3-5da6-b8bc-f64a765f9c2a" :question/math-academy-id "q-141014" :question/problem "Which of the following statements are true regarding the function $g(x),$ defined below?\n\n$$\ng(x)={\\begin{aligned}\\frac{1}{x-1}, & x<0 \\\\ -1, & x=0 \\\\ x+1, & x>0\\end{aligned}\n$$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We're required to determine the left and right continuity properties of $g(x)$ at $x=0.$\n\nFirst, we note that \n\n$$\n\\begin{aligned}g(0)=-1.\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$g(x)$ is left-continuous at $x=0$” is true. The function is left-continuous at $x=0$ since the left-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}g(x) & =\\frac{1}{0-1} \\\\  & =-\\frac{1}{1} \\\\  & =-1 \\\\  & =g(0)\\end{aligned}\n$$\n\n- Statement “$g(x)$ is right-continuous at $x=0$” is false. The function is *not* right-continuous at $x=0$ since the right-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}g(x) & =0+1 \\\\  & =1 \\\\  & \\ne g(0)\\end{aligned}\n$$\n\n- Statement “$g(x)$ is continuous at $x=0$” is false. For the function to be continuous at $x=0,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not right-continuous at $x=0.$\n\nTherefore, the correct answer is “$g(x)$ is left-continuous at $x=0$” only."} {:db/id #edb/ref 17592186272186 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049945 :topic/id #uuid "206244d9-1644-5f25-8714-55d6414eed96" :topic/math-academy-id 3831 :topic/title "Further Continuity of Piecewise Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a46dca9-6a77-532b-a621-e5e80789d8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464156} {:answer/id #uuid "5799ce27-8068-5b2f-8fc8-1f78767a9193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464157}] :answer-field/correct {:answer/id #uuid "1a46dca9-6a77-532b-a621-e5e80789d8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464156} :answer-field/id #uuid "b6b70a5b-de1a-57c7-b6ce-d41bca7868cc" :answer-field/key "$h(x)$ is left-continuous at $x=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465012} {:answer-field/choices [{:answer/id #uuid "029a3a0e-cfc6-552a-aa69-8f2a2cb429c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464158} {:answer/id #uuid "518c434f-e88b-53ed-afdc-7cca270b0fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464159}] :answer-field/correct {:answer/id #uuid "029a3a0e-cfc6-552a-aa69-8f2a2cb429c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464158} :answer-field/id #uuid "4f08f511-e51f-5132-9f31-250abcbd76a9" :answer-field/key "$h(x)$ is right-continuous at $x=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465013} {:answer-field/choices [{:answer/id #uuid "07badc24-5a5f-5098-9c7b-2981336dbdc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464160} {:answer/id #uuid "0c0605c1-7e2a-5150-b68c-ac31d743ba94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464161}] :answer-field/correct {:answer/id #uuid "07badc24-5a5f-5098-9c7b-2981336dbdc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464160} :answer-field/id #uuid "d54d83fd-9fa4-552f-9d17-d870629c26c9" :answer-field/key "$h(x)$ is continuous at $x=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465014}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a7b393e-0e8e-512c-933e-c05c7c1e88c8" :question/math-academy-id "q-141016" :question/problem "Which of the following statements are true regarding the function $h(x),$ defined below?\n\n$$\nh(x)={\\begin{aligned}\\operatorname{cos}⁡x, & x<\\frac{\\pi }{2} \\\\ 1, & x=\\frac{\\pi }{2} \\\\ 2x, & x>\\frac{\\pi }{2}\\end{aligned}\n$$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We're required to determine the left and right continuity properties of $h(x)$ at $x=\\frac{\\pi }{2}.$\n\nFirst, we note that \n\n$$\n\\begin{aligned}h(\\frac{\\pi }{2})=1.\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$h(x)$ is left-continuous at $x=\\frac{\\pi }{2}$” is false. The function is *not* left-continuous at $x=\\frac{\\pi }{2}$ since the left-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{-}}h(x) & =\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0 \\\\  & \\ne h(\\frac{\\pi }{2})\\end{aligned}\n$$\n\n- Statement “$h(x)$ is right-continuous at $x=\\frac{\\pi }{2}$” is false. The function is *not* right-continuous at $x=\\frac{\\pi }{2}$ since the right-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{+}}h(x) & =2(\\frac{\\pi }{2}) \\\\  & =\\pi  \\\\  & \\ne h(\\frac{\\pi }{2})\\end{aligned}\n$$\n\n- Statement “$h(x)$ is continuous at $x=\\frac{\\pi }{2}$” is false. For the function to be continuous at $x=\\frac{\\pi }{2},$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at $x=\\frac{\\pi }{2}.$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186272187 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions" :topic/_knowledge-points [{:db/id #edb/ref 17592186049945 :topic/id #uuid "206244d9-1644-5f25-8714-55d6414eed96" :topic/math-academy-id 3831 :topic/title "Further Continuity of Piecewise Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "988e81c4-45bb-54db-b4b2-1ec2c36ff182" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464162} {:answer/id #uuid "3ce495f2-062e-58e7-a0de-68a83e12a6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464163}] :answer-field/correct {:answer/id #uuid "988e81c4-45bb-54db-b4b2-1ec2c36ff182" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464162} :answer-field/id #uuid "883267ec-1fe0-50b6-86d2-7b796edd3287" :answer-field/key "$h(x)$ is left-continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465015} {:answer-field/choices [{:answer/id #uuid "65570c34-7b80-5bbf-8f7b-e95de7fe096f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464164} {:answer/id #uuid "725aa7c0-9778-5c52-b7e7-eb03ec0ecd07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464165}] :answer-field/correct {:answer/id #uuid "725aa7c0-9778-5c52-b7e7-eb03ec0ecd07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464165} :answer-field/id #uuid "88e9a163-3bd7-5759-a715-0e15d8d082ae" :answer-field/key "$h(x)$ is right-continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465016} {:answer-field/choices [{:answer/id #uuid "61bffde0-2eb4-57d2-8617-cdd9d92f31d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464166} {:answer/id #uuid "35c2be1c-5675-5964-8242-63f9c8659250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464167}] :answer-field/correct {:answer/id #uuid "61bffde0-2eb4-57d2-8617-cdd9d92f31d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464166} :answer-field/id #uuid "6d7af2d1-d887-5751-9373-e70956735d2d" :answer-field/key "$h(x)$ is continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465017}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3376f0ce-d656-5952-8ec5-482d4a788f05" :question/math-academy-id "q-141017" :question/problem "Which of the following statements are true regarding the function $h(x),$ defined below?\n\n$$\nh(x)={\\begin{aligned}2x+1, & x<-1 \\\\ 1, & x=-1 \\\\ x+2, & x>-1\\end{aligned}\n$$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We're required to determine the left and right continuity properties of $h(x)$ at $x=-1.$\n\nFirst, we note that \n\n$$\n\\begin{aligned}h(-1)=1.\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$h(x)$ is left-continuous at $x=-1$” is false. The function is *not* left-continuous at $x=-1$ since the left-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{-}}h(x) & =2(-1)+1 \\\\  & =-2+1 \\\\  & =-1 \\\\  & \\ne h(-1)\\end{aligned}\n$$\n\n- Statement “$h(x)$ is right-continuous at $x=-1$” is true. The function is right-continuous at $x=-1$ since the right-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{+}}h(x) & =-1+2 \\\\  & =1 \\\\  & =h(-1)\\end{aligned}\n$$\n\n- Statement “$h(x)$ is continuous at $x=-1$” is false. For the function to be continuous at $x=-1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at $x=-1.$\n\nTherefore, the correct answer is “$h(x)$ is right-continuous at $x=-1$” only."} {:db/id #edb/ref 17592186272196 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58cf84e4-bf37-53ee-9c4e-c48312865eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437932} {:answer/id #uuid "7c777b71-5609-57b6-98cd-5de6ad97f13e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437933}] :answer-field/correct {:answer/id #uuid "58cf84e4-bf37-53ee-9c4e-c48312865eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437932} :answer-field/id #uuid "1754ff84-62e2-5fa6-b4ab-1a4ed225ccf5" :answer-field/key "${f}^{′}(x)=2\\operatorname{cos}⁡2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438995} {:answer-field/choices [{:answer/id #uuid "fd869c55-39da-53e6-ae83-c00f9f75727e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437934} {:answer/id #uuid "3ebf7563-afa0-50f3-97cb-0e17f76f6a4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437935}] :answer-field/correct {:answer/id #uuid "fd869c55-39da-53e6-ae83-c00f9f75727e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437934} :answer-field/id #uuid "94674f44-214d-51de-8806-6b7b3a2c49aa" :answer-field/key "Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438996} {:answer-field/choices [{:answer/id #uuid "68878cd7-dc72-5e55-800f-d9aceba0d493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437936} {:answer/id #uuid "5695c90a-25d5-5c15-8845-780cd00f9341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437937}] :answer-field/correct {:answer/id #uuid "68878cd7-dc72-5e55-800f-d9aceba0d493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437936} :answer-field/id #uuid "b41c643e-8038-5852-a780-537545979885" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438997}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c28aa3d-73cf-552e-9e05-dfc5bcb67151" :question/math-academy-id "q-141080" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=2y\n$$\n\nLet $f(x)=\\frac{1}{2}\\operatorname{sin}⁡2x.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement ${f}^{′}(x)=2\\operatorname{cos}⁡2x$ is false. Differentiating $f(x)=\\frac{1}{2}\\operatorname{sin}⁡2x,$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\frac{1}{2}\\operatorname{sin}⁡2x)}^{′} \\\\  & =\\frac{1}{2}\\cdot 2\\operatorname{cos}⁡2x \\\\  & =\\operatorname{cos}⁡2x \\\\  & \\ne 2\\operatorname{cos}⁡2x.\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is false. Substituting $y=\\frac{1}{2}\\operatorname{sin}⁡2x$ and ${y}^{′}=\\operatorname{cos}⁡2x$ into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}2y \\\\ \\operatorname{cos}⁡2x & \\overset{?}{=}2(\\frac{1}{2}\\operatorname{sin}⁡2x) \\\\ \\operatorname{cos}⁡2x & \\ne \\operatorname{sin}⁡2x\\,\\times \\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is false. Since statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is false, the function $y=\\frac{1}{2}\\operatorname{sin}⁡2x$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186272197 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc440dfb-329e-5cce-98e2-d61a73c6573b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437938} {:answer/id #uuid "eb3e6505-7161-5f6a-be56-c236d5b1a400" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437939}] :answer-field/correct {:answer/id #uuid "eb3e6505-7161-5f6a-be56-c236d5b1a400" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437939} :answer-field/id #uuid "062dd2dc-b6ff-50a1-9e87-20f44d397210" :answer-field/key "${f}^{′}(x)=-2\\operatorname{sin}⁡2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438998} {:answer-field/choices [{:answer/id #uuid "97fcaffe-490b-50d3-bd81-11d7998b6387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437940} {:answer/id #uuid "bfde07d3-eb9e-55be-b75d-2f6e35461ba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437941}] :answer-field/correct {:answer/id #uuid "97fcaffe-490b-50d3-bd81-11d7998b6387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437940} :answer-field/id #uuid "6e330e7c-b25a-5b7f-9f95-b68a2feb22aa" :answer-field/key "Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438999} {:answer-field/choices [{:answer/id #uuid "60c19038-4ad6-599a-bc53-f97ce9ff756a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437942} {:answer/id #uuid "22a53b8b-e4ab-51f5-a137-7c3a442b5a2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437943}] :answer-field/correct {:answer/id #uuid "60c19038-4ad6-599a-bc53-f97ce9ff756a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437942} :answer-field/id #uuid "ad20673a-9803-59bc-b2e5-d66a0d3efe10" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82065c87-2fb6-51b8-8d32-9c57d0719fb4" :question/math-academy-id "q-141081" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=y\\operatorname{cos}⁡2x\n$$\n\nLet $f(x)=\\operatorname{cos}⁡2x.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement ${f}^{′}(x)=-2\\operatorname{sin}⁡2x$ is true. Differentiating $f(x)=\\operatorname{cos}⁡2x,$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{cos}⁡2x)}^{′} \\\\  & =-2\\operatorname{sin}⁡2x.\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is false. Substituting $y=\\operatorname{cos}⁡2x$ and ${y}^{′}=-2\\operatorname{sin}⁡2x$ into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}y\\operatorname{cos}⁡2x \\\\ -2\\operatorname{sin}⁡2x & \\overset{?}{=}\\operatorname{cos}⁡2x\\cdot \\operatorname{cos}⁡2x \\\\ -2\\operatorname{sin}⁡2x & \\ne {cos}^{2}⁡2x\\,\\times \\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is false. Since statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is false, the function $y=\\operatorname{cos}⁡2x$ is not a solution to our differential equation.\n\nTherefore, the correct answer is ${f}^{′}(x)=-2\\operatorname{sin}⁡2x$ only."} {:db/id #edb/ref 17592186272198 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76321bcd-1dfe-54f5-8624-a1897a3eb02d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437944} {:answer/id #uuid "74e24dca-87ac-5021-88ea-6d2cad76cfe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437945}] :answer-field/correct {:answer/id #uuid "74e24dca-87ac-5021-88ea-6d2cad76cfe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437945} :answer-field/id #uuid "96ed6203-45be-5de5-bbe2-94c88e917af6" :answer-field/key "${f}^{′}(x)=\\frac{1}{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439001} {:answer-field/choices [{:answer/id #uuid "83ec8f2a-644e-5350-a178-f851274405b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437946} {:answer/id #uuid "f48e3736-83c7-5b2f-8b2a-b7622b40ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437947}] :answer-field/correct {:answer/id #uuid "f48e3736-83c7-5b2f-8b2a-b7622b40ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437947} :answer-field/id #uuid "9225aa09-89ea-55c4-8ca6-de93ab83d375" :answer-field/key "Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439002} {:answer-field/choices [{:answer/id #uuid "67767ab0-4e77-5125-a2ab-a6302dab16e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437948} {:answer/id #uuid "adffa49b-1f3c-5361-8969-94df35c322c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437949}] :answer-field/correct {:answer/id #uuid "adffa49b-1f3c-5361-8969-94df35c322c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437949} :answer-field/id #uuid "ecd1164d-c8c5-54ab-8801-2a7ea56a251e" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b7a88f7-a074-5f69-9224-f1585f849cc4" :question/math-academy-id "q-141082" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{1}{{e}^{y}}\n$$\n\nLet $f(x)=\\operatorname{ln}⁡x.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement ${f}^{′}(x)=\\frac{1}{x}$ is true. Differentiating $f(x)=\\operatorname{ln}⁡x,$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{ln}⁡x)}^{′} \\\\  & =\\frac{1}{x}.\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is true. Substituting $y=\\operatorname{ln}⁡x$ and ${y}^{′}=\\frac{1}{x}$ into the original equation, we get a true statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{1}{{e}^{y}} \\\\ \\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{\\operatorname{ln}⁡x}} \\\\ \\frac{1}{x} & =\\frac{1}{x}\\,✓\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is true. Since statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is true, the function $y=\\operatorname{ln}⁡x$ is a solution to our differential equation.\n\nTherefore, the correct answer is ${f}^{′}(x)=\\frac{1}{x}$; “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement”; “The function $y=f(x)$ is a solution of the differential equation”."} {:db/id #edb/ref 17592186272199 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9eb1ace-da7e-5399-a3fe-3eca3341dc04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437950} {:answer/id #uuid "8294de83-bfe6-5d3e-907f-46fca51b308f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437951}] :answer-field/correct {:answer/id #uuid "a9eb1ace-da7e-5399-a3fe-3eca3341dc04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437950} :answer-field/id #uuid "9f826ec9-1240-515d-9e72-2dd14068a0b0" :answer-field/key "${f}^{′}(x)=-\\frac{2}{{x}^{3}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439004} {:answer-field/choices [{:answer/id #uuid "307652cb-8dec-5139-b1b9-8b42d2c243ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437952} {:answer/id #uuid "d0fc6fa1-75d1-54ae-a895-4bd473e2976a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437953}] :answer-field/correct {:answer/id #uuid "307652cb-8dec-5139-b1b9-8b42d2c243ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437952} :answer-field/id #uuid "93d26810-7687-5dab-8301-97c0074dc993" :answer-field/key "Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439005} {:answer-field/choices [{:answer/id #uuid "430fce2c-320b-5e26-93df-7d20527603a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437954} {:answer/id #uuid "4dee6609-1868-55be-9c34-9e4174a83b33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437955}] :answer-field/correct {:answer/id #uuid "430fce2c-320b-5e26-93df-7d20527603a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437954} :answer-field/id #uuid "81855480-1021-5030-8cb7-a5a2db6e6e14" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4402732-29b4-541b-a6e6-a372fd33bf97" :question/math-academy-id "q-141084" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{y}{{x}^{2}},\\,x\\ne 0\n$$\n\nLet $f(x)=-\\frac{1}{{x}^{2}}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement ${f}^{′}(x)=-\\frac{2}{{x}^{3}}$ is false. Differentiating $f(x)=-\\frac{1}{{x}^{2}},$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(-\\frac{1}{{x}^{2}})}^{′} \\\\  & =\\frac{2}{{x}^{3}} \\\\  & \\ne -\\frac{2}{{x}^{3}}.\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is false. Substituting $y=-\\frac{1}{{x}^{2}}$ and ${y}^{′}=\\frac{2}{{x}^{3}}$ into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{y}{{x}^{2}} \\\\ \\frac{2}{{x}^{3}} & \\overset{?}{=}\\frac{(-\\frac{1}{{x}^{2}})}{{x}^{2}} \\\\ \\frac{2}{{x}^{3}} & \\ne -\\frac{1}{{x}^{4}}\\,\\times \\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is false. Since statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is false, the function $y=-\\frac{1}{{x}^{2}}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186272200 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation" :topic/_knowledge-points [{:db/id #edb/ref 17592186049486 :topic/id #uuid "f8bc5d87-e505-5270-9efd-ad77aaf46e52" :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "654fa534-773a-593f-977c-52c967bc6758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437956} {:answer/id #uuid "3e1670b2-e9d2-5154-a206-4f8b1150ce6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437957}] :answer-field/correct {:answer/id #uuid "654fa534-773a-593f-977c-52c967bc6758" :answer/t