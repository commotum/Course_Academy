 1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & \\ne I,\\,\\times  \\\\ B & =\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}2 & 1 \\\\ -1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}-1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 0 \\\\ 4 & 1\\end{bmatrix} \\\\  & \\ne I,\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."} {:db/id #edb/ref 17592186266016 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form" :topic/_knowledge-points [{:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904 :topic/title "Identifying the Pivot Columns of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f5cb1d-3cc0-5920-94a0-6503b58de4ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574191} {:answer/id #uuid "a26f771e-96ce-5fbc-a2e7-dd0a0f6f0323" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574192}] :answer-field/correct {:answer/id #uuid "25f5cb1d-3cc0-5920-94a0-6503b58de4ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574191} :answer-field/id #uuid "547d671a-2442-5a46-9e74-48636cf5d6bf" :answer-field/key "Column 1: $\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field