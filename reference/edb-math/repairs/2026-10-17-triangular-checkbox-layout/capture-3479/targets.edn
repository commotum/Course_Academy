#{[{:db/id #edb/ref 17592186119585 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119771 :knowledge-point/title "Describing a Triangular Matrix"}] :question/id #uuid "fe3edf12-af5b-5bb0-b5b3-efb6cd809134" :question/math-academy-id "e-4394" :question/problem "How can we best describe the following matrix? \n\n![](images/fc/fc2ed708d717844ca73b7ecbfd8467923fad091ae524153350e7e2fb3df1ea4e.png)" :question/worked-solution "Notice that $A$ is a matrix for which all entries above the diagonal are $0$'s:\n![](images/52/5260137f2dbf20b44400659be8467da333ff228e5bff323465f920a9505ee5f2.png)\n\nTherefore, it is a lower triangular matrix.\n\nIt is not an upper triangular matrix or a diagonal matrix since there is a non-zero element below the diagonal: $a_{21}=6 \\neq 0.$"}] [{:db/id #edb/ref 17592186120421 :knowledge-point/_questions [{:db/id #edb/ref 17592186119772 :knowledge-point/title "Identifying a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e6ed773-f146-5b01-ba44-174c9edd753c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439755} {:answer/id #uuid "fc6cb7c6-9ffe-571b-8f58-c063f4684d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439756}] :answer-field/correct {:answer/id #uuid "fc6cb7c6-9ffe-571b-8f58-c063f4684d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439756} :answer-field/id #uuid "0d41c154-1263-5cf5-868f-bd6f8fca89a3" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440235} {:answer-field/choices [{:answer/id #uuid "0976b793-967e-51b7-a412-465c8f4b7390" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439757} {:answer/id #uuid "a