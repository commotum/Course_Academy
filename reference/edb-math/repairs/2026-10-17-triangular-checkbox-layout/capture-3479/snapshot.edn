19-f7d9-5728-9237-83bd49e641c5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438456} :answer-field/id #uuid "675400e7-a720-59bf-af25-ecd415319950" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439257} {:answer-field/choices [{:answer/id #uuid "63de0a7e-308e-5ca3-bfc3-0ba27b3a202e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438458} {:answer/id #uuid "179fafc0-1ae3-5917-a9f8-eae561e2b95b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438459}] :answer-field/correct {:answer/id #uuid "179fafc0-1ae3-5917-a9f8-eae561e2b95b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438459} :answer-field/id #uuid "d0b333bd-888b-5051-81d0-d4f153ba848c" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439258}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "deb97145-eaf3-5dcc-a36b-24fae2c52b5c" :question/math-academy-id "q-68754" :question/problem "Consider the matrix \n$A=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is upper triangular\n- **II.** $A$ is lower triangular\n- **III.** $A+{A}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false, since $A$ has non-zero entries below the main diagonal:\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\n- Statement II is false, since $A$ has non-zero entries above the main diagonal:\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\n- Statement III is true, since the result of $A+{A}^{T}$ has all the entries below the main diagonal equal to zero:\n\n$$\nA+{A}^{T}=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id 17592186342194 :knowledge-point/_questions [{:db/id 17592186119784 :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5292e9e-deab-5423-81ea-859716c87e84" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438502} {:answer/id #uuid "6e553caf-cc56-5f3d-be8a-245cca543780" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438503}] :answer-field/correct {:answer/id #uuid "6e553caf-cc56-5f3d-be8a-245cca543780" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438503} :answer-field/id #uuid "3ab33538-7993-5acb-9468-e0e3dd4ad807" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439280} {:answer-field/choices [{:answer/id #uuid "b9bbb38a-9967-5612-8d8d-b7bb86341338" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438504} {:answer/id #uuid "38526a4d-7583-5f69-ae01-76ab71dc5556" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438505}] :answer-field/correct {:answer/id #uuid "b9bbb38a-9967-5612-8d8d-b7bb86341338" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438504} :answer-field/id #uuid "8d6d93d9-8d6f-56cf-ac99-984802318cde" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439281} {:answer-field/choices [{:answer/id #uuid "d6e70b79-a9e1-5d68-a28e-f96b03f12a43" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438506} {:answer/id #uuid "9e9ac29b-2109-50ad-a691-a49a7e8a0ffe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438507}] :answer-field/correct {:answer/id #uuid "d6e70b79-a9e1-5d68-a28e-f96b03f12a43" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438506} :answer-field/id #uuid "e1a6caeb-050e-5490-9f4b-d0d5518bd887" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439282}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e68d4b2f-c3b6-584c-8430-662a571e8316" :question/math-academy-id "q-74318" :question/problem "Consider the matrix \n$C=\\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $C$ is upper triangular\n- **II.** $C$ is lower triangular\n- **III.** ${C}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. All the entries below the main diagonal of $C$ are zeros:\n\n$$\nC=\\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- Statement II is false, since $C$ has non-zero entries above the main diagonal:\n\n$$\nC=\\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- Statement III is false, since ${C}^{T}$ has non-zero entries below the main diagonal:\n\n$$\n{C}^{T}=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & 4 & 0 & 0 \\\\ 1 & 0 & 2 & 0 \\\\ 0 & 4 & 1 & 3\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id 17592186342195 :knowledge-point/_questions [{:db/id 17592186119784 :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answe