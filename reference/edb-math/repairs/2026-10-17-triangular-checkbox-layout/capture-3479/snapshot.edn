 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3134bb79-8649-57fa-abcd-16a6ab38fbaa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186479921} {:answer/id #uuid "764ed816-8787-5076-98dd-1c3b168501d3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479925}] :answer-field/correct {:answer/id #uuid "764ed816-8787-5076-98dd-1c3b168501d3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479925} :answer-field/id #uuid "24f3da38-d1e2-5f54-8d65-64e6db935e0a" :answer-field/key "B" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186479916} {:answer-field/choices [{:answer/id #uuid "9108f5ab-b178-5d40-aa32-e6345497ae54" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479926} {:answer/id #uuid "f86f042d-c2f3-5f2e-9c91-5d865e69da55" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186479937}] :answer-field/correct {:answer/id #uuid "f86f042d-c2f3-5f2e-9c91-5d865e69da55" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186479937} :answer-field/id #uuid "b9d1ae7a-aeb4-5b03-b19f-69231383a540" :answer-field/key "A" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186479931} {:answer-field/choices [{:answer/id #uuid "22877a4b-7733-5c74-8cfb-814f11a06f64" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186479915} {:answer/id #uuid "a3395525-2a93-57cc-a70a-25efcca5f6e9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479929}] :answer-field/correct {:answer/id #uuid "a3395525-2a93-57cc-a70a-25efcca5f6e9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479929} :answer-field/id #uuid "ecfe2d8c-e527-5267-827f-dece5f8a31e8" :answer-field/key "C" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186479936}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c165030-6920-5600-9915-e7a3de47595e" :question/problem "Which of the following matrices are upper triangular matrices?\n\nSelect all that apply.\n\n$A=\\begin{bmatrix}-11 & 0 & -3 & 0 \\\\ 0 & 0 & 0 & 9 \\\\ 0 & 0 & 4 & -10 \\\\ 0 & 0 & 0 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}-7 & 0 & 2 \\\\ 0 & 4 & 7 \\\\ -1 & 5 & -9\\end{bmatrix},\\,C=\\begin{bmatrix}-8 & 0 & -4 \\\\ 0 & -4 & 0 \\\\ 0 & 2 & 0\\end{bmatrix}.$" :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =-1\\ne 0 \\\\ {c}_{32} & =2\\ne 0\\end{aligned}\n$$"}] [{:db/id 17592186479928 :knowledge-point/_questions [{:db/id 17592186119772 :knowledge-point/title "Identifying a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9d1d21-7b21-52d6-a6eb-d39e84838138" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479913} {:answer/id #uuid "e8353198-6db6-5ce0-8192-5d16d6fbc638" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186479935}] :answer-field/correct {:answer/id #uuid "1a9d1d21-7b21-52d6-a6eb-d39e84838138" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186479913} :answer-field/id #uuid "2548dc7d-fd02-52f0-8019-6f18794e6db3" :answer-field/key "C" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 175921864