}0 & -2 & 0 \\\\ 2 & 0 & 1 \\\\ 0 & -1 & 0\\end{bmatrix}\n$$\n\n- Statement III is false, since $A$ has non-zero entries below the main diagonal\n\n$$\nA=\\begin{bmatrix}7 & 0 & 0 \\\\ -2 & 0 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186335970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9d2a661-7d90-525c-9631-0c05ef108b03" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438454} {:answer/id #uuid "5deab4fd-cb30-5b98-a484-4483eb06b0c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438455}] :answer-field/correct {:answer/id #uuid "a9d2a661-7d90-525c-9631-0c05ef108b03" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438454} :answer-field/id #uuid "89c02379-086d-5617-b96e-c2e3ec7d9a9b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439256} {:answer-field/choices [{:answer/id #uuid "69513619-f7d9-5728-9237-83bd49e641c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438456} {:answer/id #uuid "ab7677e6-30d1-5eff-a3c5-95011127b77e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438457}] :answer-field/correct {:answer/id #uuid "69513619-f7d9-5728-9237-83bd49e641c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438456} :answer-field/id #uuid "675400e7-a720-59bf-af25-ecd415319950" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439257} {:answer-field/choices [{:answer/id #uuid "63de0a7e-308e-5ca3-bfc3-0ba27b3a202e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438458} {:answer/id #uuid "179fafc0-1ae3-591