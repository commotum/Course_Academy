5e9d-9935-fbf3414db9ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C=\\begin{bmatrix}0 & -1 \\\\ 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186260670} {:answer/id #uuid "89212b5f-4485-5c4a-b4e2-c1ef65585d7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186261068} {:answer/id #uuid "bebca5d9-6d1a-5817-b8da-7eabbdef4d81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A=\\begin{bmatrix}4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186261559} {:answer/id #uuid "ffcb6a99-0bd4-51ca-8095-57e4548dde55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "E=\\begin{bmatrix}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186262118}] :answer-field/correct {:answer/id #uuid "37c4a7a7-6201-5e3d-b83c-54214a0f73f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260369} :answer-field/id #uuid "58d1ccae-7378-52fd-94ac-13da15be20dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2e910d3-5a56-5ffe-990b-2c75157e1876" :question/math-academy-id "q-126352" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $D$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nD=\\begin{bmatrix}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $C$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=\\begin{bmatrix}4 & 0 \\\\ 1 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}0 & -1 \\\\ 5 & 1\\end{bmatrix},\\,E=\\begin{bmatrix}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{bmatrix}.\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186262606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444210f3-62f9-5a79-983b-cb130e47cdf7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C=\\begin{bmatrix}6 & 7 \\\\ -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186260470} {:answer/id #uuid "6651e89b-870d-5413-8f00-8d96b56e49c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B=\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186260766} {:answer/id #uuid "844897da-9608-5dd5-98e7-d4da1a4ec155" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186261025} {:answer/id #uuid "9a74db97-2782-5e50-9e12-0c4456b66a87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "E=\\begin{bmatrix}1 & -3 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186261215} {:answer/id #uuid "9f58f91c-fe9e-5c7f-8841-fec1c4d68389" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A=\\begin{bmatrix}9 & 0 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186261257}] :answer-field/correct {:answer/id #uuid "9a74db97-2782-5e50-9e12-0c4456b66a87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "E=\\begin{bmatrix}1 & -3 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186261215} :answer-field/id #uuid "3437cc72-e427-5ac7-afd8-fe2d376e33a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8edd360b-8c0f-5c8f-b5f1-4655b27f3fa4" :question/math-academy-id "q-126354" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $E$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nE=\\begin{bmatrix}1 & -3 \\\\ 0 & 5\\end{bmatrix}\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $C$, and $D$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=\\begin{bmatrix}9 & 0 \\\\ -1 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}6 & 7 \\\\ -2 & 1\\end{bmatrix},\\,D=\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186269143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28741486-369e-5706-ae1b-b725c51b2ab6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "E=\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186266505} {:answer/id #uuid "4e31dd9f-15de-59d3-94cd-966926a7e530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A=\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186266840} {:answer/id #uuid "533fb3ba-63f1-555e-98ed-8058779ed29c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C=\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 2 & 3 \\\\ 0 & -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186266889} {:answer/id #uuid "b9bdd702-b2df-5c6c-a4c2-63341c07bd3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186267810} {:answer/id #uuid "eadc47d2-6d03-54da-ac2e-565204378e46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ -5 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186268237}] :answer-field/correct {:answer/id #uuid "4e31dd9f-15de-59d3-94cd-966926a7e530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A=\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186266840} :answer-field/id #uuid "bbef8b98-e8a0-