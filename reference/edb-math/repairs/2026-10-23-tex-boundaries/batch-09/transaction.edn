}^{2}+2}}\\,\\text{d}x=\n$$"] [:db/cas 17592186526091 :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2{x}^{2}+2}}\\,\\text{d}x & =\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2({x}^{2}+1)}}\\,\\text{d}x \\\\  & =-\\frac{2\\sqrt{2}}{\\sqrt{2}}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x \\\\  & =-2\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$" "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2{x}^{2}+2}}\\,\\text{d}x & =\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2({x}^{2}+1)}}\\,\\text{d}x \\\\  & =-\\frac{2\\sqrt{2}}{\\sqrt{2}}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x \\\\  & =-2\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$"] [:db/cas 17592186526103 :question/problem "$$\n\n$\\int \\frac{3}{4|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$" "$$\n\\int \\frac{3}{4|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=\n$$"] [:db/cas 17592186526103 :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{3}{4|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-\\frac{3}{4}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x=-\\frac{3}{4}\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$" "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{3}{4|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-\\frac{3}{4}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x=-\\frac{3}{4}\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$"] [:db/cas 17592186526105 :question/worked-solution "$$\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({e}^{x/4}+\\frac{2}{x\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int {e}^{x/4}\\,\\text{d}x+\\int \\frac{2}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\int {e}^{x/4}-2\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x\\,\\text{d}x \\\\  & =4{e}^{x/4}-2\\operatorname{arsech}⁡x+C \\\\  & =2(2{e}^{x/4}-\\operatorname{arsech}⁡x)+C.\\end{aligned}\n$$" "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({e}^{x/4}+\\frac{2}{x\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int {e}^{x/4}\\,\\text{d}x+\\int \\frac{2}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\int {e}^{x/4}-2\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x\\,\\text{d}x \\\\  & =4{e}^{x/4}-2\\operatorname{arsech}⁡x+C \\\\  & =2(2{e}^{x/4}-\\operatorname{arsech}⁡x)+C.\\end{aligned}\n$$"] [:db/cas 17592186527137 :question/problem "Anna makes two cakes. The first cake weighs $1,200\\,\\text{g},$ while the second cake weighs $140%$ of the weight of the first. What is the weight of the second cake?" "Anna makes two cakes. The first cake weighs $1,200\\,\\text{g},$ while the second cake weighs $140\\%$ of the weight of the first. What is the weight of the second cake?"] [:db/cas 17592186527137 :question/worked-solution "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the weight of the first cake, which is $1,200\\,\\text{g}.$ The percentage is $140%,$ and the part is the weight of the second cake.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n140%=140÷100=1.4\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140%\\times 1,200 \\\\  & =1.4\\times 1,200 \\\\  & =1,680\\end{aligned}\n$$\n\nTherefore, $140%$ of $1,200$ is $1,680.$ So, the weight of the second cake is $1,680\\,\\text{g}.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n140%=\\frac{140}{100}=\\frac{140÷20}{100÷20}=\\frac{7}{5}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140%\\times 1,200 \\\\  & =\\frac{7}{5}\\times 1,200 \\\\  & =7\\times \\frac{1,200}{5} \\\\  & =7\\times 240 \\\\  & =1,680\\end{aligned}\n$$\n\nTherefore, $140%$ of $1,200$ is $1,680.$ So, the weight of the second cake is $1,680\\,\\text{g}.$" "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the weight of the first cake, which is $1,200\\,\\text{g}.$ The percentage is $140\\%,$ and the part is the weight of the second cake.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n140\\%=140÷100=1.4\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140\\%\\times 1,200 \\\\  & =1.4\\times 1,200 \\\\  & =1,680\\end{aligned}\n$$\n\nTherefore, $140\\%$ of $1,200$ is $1,680.$ So, the weight of the second cake is $1,680\\,\\text{g}.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n140\\%=\\frac{140}{100}=\\frac{140÷20}{100÷20}=\\frac{7}{5}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140\\%\\times 1,200 \\\\  & =\\frac{7}{5}\\times 1,200 \\\\  & =7\\times \\frac{1,200}{5} \\\\  & =7\\times 240 \\\\  & =1,680\\end{aligned}\n$$\n\nTherefore, $140\\%$ of $1,200$ is $1,680.$ So, the weight of the second cake is $1,680\\,\\text{g}.$"] [:db/cas 17592186531578 :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]x(t)+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $x(t)={x}_{c}(t)+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$1$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,{t}^{2}+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $2$\n  </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,t+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    .\n  </td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $1$\n  </td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]x(t)+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n$x(t)={x}_{c}(t)+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$1$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n$\\,\\,{t}^{2}+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n$2$\n  </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n$\\,\\,t+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    .\n  </td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n$1$\n  </td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186531631 :question/problem "A water tank with a capacity of $5,000$ liters is filled with water to $42.5%$ of its capacity. How much water is in the tank?" "A water tank with a capacity of $5,000$ liters is filled with water to $42.5\\%$ of its capacity. How much water is in the tank?"] [:db/cas 17592186531631 :question/worked-solution "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the capacity of the tank, which is $5,000$ liters. The percentage is $42.5%,$ and the part is the amount of water in the tank.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n42.5%=42.5÷100=0.425\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =42.5%\\times 5,000 \\\\  & =0.425\\times 5,000 \\\\  & =2,125\\end{aligned}\n$$\n\nTherefore, $42.5%$ of $5,000$ is $2,125.$ Thus, there are $2,125$ liters of water in the tank.\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n42.5%=\\frac{42.5}{100}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =42.5%\\times 5,000 \\\\  & =\\frac{42.5}{100}\\times 5,000 \\\\  & =42.5\\times \\frac{5,000}{100} \\\\  & =42.5\\times 50 \\\\  & =2,125\\end{aligned}\n$$\n\nTherefore, $42.5%$ of $5,000$ is $2,125.$ Thus, there are $2,125$ liters of water in the tank." "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the capacity of the tank, which is $5,000$ liters. The percentage is $42.5\\%,$ and the part is the amount of water in the tank.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n42.5\\%=42.5÷100=0.425\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =42.5\\%\\times 5,000 \\\\  & =0.425\\times 5,000 \\\\  & =2,125\\end{aligned}\n$$\n\nTherefore, $42.5\\%$ of $5,000$ is $2,125.$ Thus, there are $2,125$ liters of water in the tank.\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n42.5\\%=\\frac{42.5}{100}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =42.5\\%\\times 5,000 \\\\  & =\\frac{42.5}{100}\\times 5,000 \\\\  & =42.5\\times \\frac{5,000}{100} \\\\  & =42.5\\times 50 \\\\  & =2,125\\end{aligned}\n$$\n\nTherefore, $42.5\\%$ of $5,000$ is $2,125.$ Thus, there are $2,125$ liters of water in the tank."] [:db/cas 17592186533979 :question/worked-solution "First, note that the series can be written as\n\n$$\n6{\\sum }_{n=3}^{\\infty }\\frac{1}{n(n+1)}.\n$$\n\nUsing partial fractions, we can write the series as\n\n$$\n6{\\sum }_{n=3}^{\\infty }(\\frac{1}{n}-\\frac{1}{n+1}).\n$$\n\nComputing the first few partial sums, starting with $n=3,$ gives\n\n$$\n\n$$\n\\begin{aligned}{s}_{3} & =6[(\\frac{1}{3}-\\frac{1}{4})] \\\\ {s}_{4} & =6[(\\frac{1}{3}-\\cancel{\\frac{1}{4}})+(\\cancel{\\frac{1}{4}}-\\frac{1}{5})] \\\\ {s}_{5} & =6[(\\frac{1}{3}-\\cancel{\\frac{1}{4}})+(\\cancel{\\frac{1}{4}}-\\cancel{\\frac{1}{5}})+(\\cancel{\\frac{1}{5}}-\\frac{1}{6})] \\\\ {s}_{6} & =6[(\\frac{1}{3}-\\cancel{\\frac{1}{4}})+(\\cancel{\\frac{1}{4}}-\\cancel{\\frac{1}{5}})+(\\cancel{\\frac{1}{5}}-\\cancel{\\frac{1}{6}})+(\\cancel{\\frac{1}{6}}-\\frac{1}{7})].\\end{aligned}\n$$\n\nNotice that in each partial sum, we always end up canceling all terms except for the first and last terms. Therefore, the $N$th partial sum is\n\n$$\n{s}_{N}=6[\\frac{1}{3}-\\frac{1}{N+1}].\n$$\n\nFinally, we can determine the sum of the series by taking the limit of ${s}_{N}:$\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }\\frac{6}{n(n+1)} & ={lim}_{N\\to \\infty }{s}_{N} \\\\  & ={lim}_{N\\to \\infty }6[\\frac{1}{3}-\\frac{1}{N+1}] \\\\  & =6[\\frac{1}{3}-0] \\\\  & =2\\end{aligned}\n$$" "First, note that the series can be written as\n\n$$\n6{\\sum }_{n=3}^{\\infty }\\frac{1}{n(n+1)}.\n$$\n\nUsing partial fractions, we can write the series as\n\n$$\n6{\\sum }_{n=3}^{\\infty }(\\frac{1}{n}-\\frac{1}{n+1}).\n$$\n\nComputing the first few partial sums, starting with $n=3,$ gives\n\n$$\n\\begin{aligned}{s}_{3} & =6[(\\frac{1}{3}-\\frac{1}{4})] \\\\ {s}_{4} & =6[(\\frac{1}{3}-\\cancel{\\frac{1}{4}})+(\\cancel{\\frac{1}{4}}-\\frac{1}{5})] \\\\ {s}_{5} & =6[(\\frac{1}{3}-\\cancel{\\frac{1}