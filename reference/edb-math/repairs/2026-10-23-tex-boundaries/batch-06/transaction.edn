5\\times 120 \\\\  & =54\\end{aligned}\n$$\n\nTherefore, $45\\%$ of $120$ is $54.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n45\\%=\\frac{45}{100}=\\frac{45÷5}{100÷5}=\\frac{9}{20}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =45\\%\\times 120 \\\\  & =\\frac{9}{20}\\times 120 \\\\  & =9\\times \\frac{120}{20} \\\\  & =9\\times 6 \\\\  & =54\\end{aligned}\n$$\n\nTherefore, $45\\%$ of $120$ is $54.$"] [:db/cas 17592186441677 :question/problem "What is $9%$ of $1,000?$" "What is $9\\%$ of $1,000?$"] [:db/cas 17592186441677 :question/worked-solution "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $1,000$, and the percentage is $9%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n9%=9÷100=0.09\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =9%\\times 1,000 \\\\  & =0.09\\times 1,000 \\\\  & =90\\end{aligned}\n$$\n\nTherefore, $9%$ of $1,000$ is $90.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n9%=\\frac{9}{100}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =9%\\times 1,000 \\\\  & =\\frac{9}{100}\\times 1,000 \\\\  & =9\\times \\frac{1,000}{100} \\\\  & =9\\times 10 \\\\  & =90\\end{aligned}\n$$\n\nTherefore, $9%$ of $1,000$ is $90.$" "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $1,000$, and the percentage is $9\\%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n9\\%=9÷100=0.09\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =9\\%\\times 1,000 \\\\  & =0.09\\times 1,000 \\\\  & =90\\end{aligned}\n$$\n\nTherefore, $9\\%$ of $1,000$ is $90.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n9\\%=\\frac{9}{100}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =9\\%\\times 1,000 \\\\  & =\\frac{9}{100}\\times 1,000 \\\\  & =9\\times \\frac{1,000}{100} \\\\  & =9\\times 10 \\\\  & =90\\end{aligned}\n$$\n\nTherefore, $9\\%$ of $1,000$ is $90.$"] [:db/cas 17592186441678 :question/problem "$240%$ of $50$ is equal to{{field-1}}." "$240\\%$ of $50$ is equal to{{field-1}}."] [:db/cas 17592186441678 :question/worked-solution "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $50,$ and the percentage is $240%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n240%=240÷100=2.4\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =240%\\times 50 \\\\  & =2.4\\times 50 \\\\  & =120\\end{aligned}\n$$\n\nTherefore, $240%$ of $50$ is $120.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n240%=\\frac{240}{100}=\\frac{240÷20}{100÷20}=\\frac{12}{5}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =240%\\times 50 \\\\  & =\\frac{12}{5}\\times 50 \\\\  & =12\\times \\frac{50}{5} \\\\  & =12\\times 10 \\\\  & =120\\end{aligned}\n$$\n\nTherefore, $240%$ of $50$ is $120.$" "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $50,$ and the percentage is $240\\%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n240\\%=240÷100=2.4\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percen