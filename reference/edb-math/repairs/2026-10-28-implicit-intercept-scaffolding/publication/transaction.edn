77238a5d0"] [:db/ensure "5d1aed36-4ca6-5b73-ac7d-33356fc15e04" :answer-field/validate] [:db/add "29cb5437-699d-5aaf-9a62-4154c1c9021d" :question/id #uuid "29cb5437-699d-5aaf-9a62-4154c1c9021d"] [:db/add "29cb5437-699d-5aaf-9a62-4154c1c9021d" :question/problem "The curve has equation $2 x^{2} + 3 y^{2}=45$. The **tangent** line at $\\left(3,3\\right)$ meets the $y$-axis at $P$. Find the coordinates of $P$."] [:db/add "29cb5437-699d-5aaf-9a62-4154c1c9021d" :question/worked-solution "Treat $y$ as a function of $x$. Differentiate implicitly and collect the derivative terms:\n\n$$\n\\begin{aligned}\n4 x+\\left(6 y\\right)\\frac{dy}{dx}&=0 \\\\\n\\left(6 y\\right)\\frac{dy}{dx}&=-\\left(4 x\\right) \\\\\n\\frac{dy}{dx}&=-\\frac{4 x}{6 y}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the given point:\n\n$$\nm_{\\mathrm{t}}=-\\frac{12}{18}=- \\frac{2}{3}\n$$\n\nThe tangent line uses $m=- \\frac{2}{3}$.\n\nUse the given point and this slope:\n\n$$\n\\begin{aligned}\ny-\\left(3\\right)&=- \\frac{2}{3}\\left(x-\\left(3\\right)\\right) \\\\\ny&=- \\frac{2}{3}\\left(x-\\left(3\\right)\\right)+\\left(3\\right)\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$. Substitute and simplify:\n\n$$\n\\begin{aligned}\ny&=- \\frac{2}{3}\\left(0-\\left(3\\right)\\right)+\\left(3\\right) \\\\\ny&=5\n\\end{aligned}\n$$\n\nTherefore $P=\\left(0,5\\right)$."] [:db/add "29cb5437-699d-5aaf-9a62-4154c1c9021d" :question/difficulty :question.difficulty/easy] [:db/add "29cb5437-699d-5aaf-9a62-4154c1c9021d" :question/answer-fields "5d1aed36-4ca6-5b73-ac7d-33356fc15e04"] [:db/ensure "29cb5437-699d-5aaf-9a62-4154c1c9021d" :question/validate] [:db/add 17592186054847 :knowledge-point/questions "29cb5437-699d-5aaf-9a62-4154c1c9021d"] [:db/add "8b9ac18c-6cb1-5ee4-b2ae-85e778c2a695" :answer/id #uuid "8b9ac18c-6cb1-5ee4-b2ae-85e778c2a695"] [:db/add "8b9ac18c-6cb1-5ee4-b2ae-85e778c2a695" :answer/type :answer.type/math] [:db/add "8b9ac18c-6cb1-5ee4-b2ae-85e778c2a695" :answer/value "\\left(-1,0\\right)"] [:db/ensure "8b9ac18c-6cb1-5ee4-b2ae-85e778c2a695" :answer/validate] [:db/add "94c95d14-b867-5ca7-a53b-0023220ab117" :answer/id #uuid "94c95d14-b867-5ca7-a53b-0023220ab117"] [:db/add "94c95d14-b867-5ca7-a53b-0023220ab117" :answer/type :answer.type/math] [:db/add "94c95d14-b867-5ca7-a53b-0023220ab117" :answer/value "\\left(5,0\\right)"] [:db/ensure "94c95d14-b867-5ca7-a53b-0023220ab117" :answer/validate] [:db/add "ce5be1e9-231e-5382-91f8-46e87df3234c" :answer/id #uuid "ce5be1e9-231e-5382-91f8-46e87df3234c"] [:db/add "ce5be1e9-231e-5382-91f8-46e87df3234c" :answer/type :answer.type/math] [:db/add "ce5be1e9-231e-5382-91f8-46e87df3234c" :answer/value "\\left(11,0\\right)"] [:db/ensure "ce5be1e9-231e-5382-91f8-46e87df3234c" :answer/validate] [:db/add "a16893dd-7f2e-5ac3-9e44-6880f0379a03" :answer/id #uuid "a16893dd-7f2e-5ac3-9e44-6880f0379a03"] [:db/add "a16893dd-7f2e-5ac3-9e44-6880f0379a03" :answer/type :answer.type/math] [:db/add "a16893dd-7f2e-5ac3-9e44-6880f0379a03" :answer/value "\\left(\\frac{21}{4},0\\right)"] [:db/ensure "a16893dd-7f2e-5ac3-9e44-6880f0379a03" :answer/validate] [:db/add "91d14913-9638-5ab9-8438-f64ab31f6aa6" :answer/id #uuid "91d14913-9638-5ab9-8438-f64ab31f6aa6"] [:db/add "91d14913-9638-5ab9-8438-f64ab31f6aa6" :answer/type :answer.type/math] [:db/add "91d14913-9638-5ab9-8438-f64ab31f6aa6" :answer/value "\\left(7,0\\right)"] [:db/ensure "91d14913-9638-5ab9-8438-f64ab31f6aa6" :answer/validate] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/id #uuid "b48986ee-f556-50ff-8a64-244f567c0bb4"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/key "selection"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/type :answer-field.type/radio] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/choices "8b9ac18c-6cb1-5ee4-b2ae-85e778c2a695"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/choices "94c95d14-b867-5ca7-a53b-0023220ab117"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/choices "ce5be1e9-231e-5382-91f8-46e87df3234c"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/choices "a16893dd-7f2e-5ac3-9e44-6880f0379a03"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/choices "91d14913-9638-5ab9-8438-f64ab31f6aa6"] [:db/add "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/correct "91d14913-9638-5ab9-8438-f64ab31f6aa6"] [:db/ensure "b48986ee-f556-50ff-8a64-244f567c0bb4" :answer-field/validate] [:db/add "ade4db6f-9e71-5dba-9592-8dbd1a642310" :question/id #uuid "ade4db6f-9e71-5dba-9592-8dbd1a642310"] [:db/add "ade4db6f-9e71-5dba-9592-8dbd1a642310" :question/problem "The curve has equation $3 x^{2} + 4 y^{2}=63$. The **tangent** line at $\\left(3,-3\\right)$ meets the $x$-axis at $P$. Find the coordinates of $P$."] [:db/add "ade4db6f-9e71-5dba-9592-8dbd1a642310" :question/worked-solution "Treat $y$ as a function of $x$. Differentiate implicitly and collect the derivative terms:\n\n$$\n\\begin{aligned}\n6 x+\\left(8 y\\right)\\frac{dy}{dx}&=0 \\\\\n\\left(8 y\\right)\\frac{dy}{dx}&=-\\left(6 x\\right) \\\\\n\\frac{dy}{dx}&=-\\frac{6 x}{8 y}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the given point:\n\n$$\nm_{\\mathrm{t}}=-\\frac{18}{-24}=\\frac{3}{4}\n$$\n\nThe tangent line uses $m=\\frac{3}{4}$.\n\nUse the given point and this slope:\n\n$$\n\\begin{aligned}\ny-\\left(-3\\right)&=\\frac{3}{4}\\left(x-\\left(3\\right)\\right) \\\\\ny&=\\frac{3}{4}\\left(x-\\left(3\\right)\\right)+\\left(-3\\right)\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$. Substitute and simplify:\n\n$$\n\\begin{aligned}\n0&=\\frac{3}{4}\\left(x-\\left(3\\right)\\right)+\\left(-3\\right) \\\\\nx-\\left(3\\right)&=-\\frac{-3}{\\frac{3}{4}} \\\\\nx&=7\n\\end{aligned}\n$$\n\nTherefore $P=\\left(7,0\\right)$."] [:db/add "ade4db6f-9e71-5dba-9592-8dbd1a642310" :question/difficulty :question.difficulty/easy] [:db/add "ade4db6f-9e71-5dba-9592-8dbd1a642310" :question/answer-fields "b48986ee-f556-50ff-8a64-244f567c0bb4"] [:db/ensure "ade4db6f-9e71-5dba-9592-8dbd1a642310" :question/validate] [:db/add 17592186054847 :knowledge-point/questions "ade4db6f-9e71-5dba-9592-8dbd1a642310"] [:db/add "generator" :question-generator/id #uuid "d8e64e6a-7cb3-57f5-9fd2-5fecce6ddf6f"] [:db/add "generator" :question-generator/script "generators/db/db14b9d81fe472e20b72cfee2fa00331bd719b102731526a7637a83e2d067dd8/generator.py"] [:db/add 17592186054847 :knowledge-point/question-generator "generator"] [:db/ensure 17592186054847 :knowledge-point/validate]]
