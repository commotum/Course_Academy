17592186284253}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "570f79f9-b528-59df-a2a6-a750762e3979" :question/math-academy-id "q-170132" :question/problem "If $x=3{y}^{3}-4{y}^{5},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(3{y}^{3}-4{y}^{5}) \\\\  & =3\\frac{\\text{d}}{\\text{d}y}({y}^{3})-4\\frac{\\text{d}}{\\text{d}y}({y}^{5}) \\\\  & =9{y}^{2}-20{y}^{4}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{1}{9{y}^{2}-20{y}^{4}}.\n$$"} {:db/id #edb/ref 17592186297345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "918ce529-fbbf-5879-a12c-b8ff4969d44e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2y-1}" :db/id #edb/ref 17592186296049}] :answer-field/correct {:answer/id #uuid "918ce529-fbbf-5879-a12c-b8ff4969d44e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2y-1}" :db/id #edb/ref 17592186296049} :answer-field/id #uuid "3fd03d82-67c6-5e97-bdf5-e0d9e331e1dc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296756}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "33ddb022-5204-5f5d-a7fe-9687a12ba27b" :question/math-academy-id "q-312549" :question/problem "Given that $x={y}^{2}-y,$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{2}-y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{2})-\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =2y-1\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{1}{2y-1}.\n$$"} {:db/id #edb/ref 17592186315109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421}] :answer-field/correct {:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421} :answer-field/id #uuid "a13b0fcc-1e2e-571c-b6df-a879bcbc6ca8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314443}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aed30416-75f3-525a-aed4-35612b1daf20" :question/math-academy-id "q-341608" :question/problem "Given that $x=-\\frac{2}{{y}^{2}}+5{y}^{2},$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n<div class=\"question-equation fraction-equation\">\n<span>$\\frac{\\text{d}y}{\\text{d}x}=$</span>\n<span class=\"answer-fraction\">\n<span class=\"answer-fraction-numerator\">${y}^{3}$</span>\n<span class=\"answer-fraction-denominator\">{{field-1}}</span>\n</span>\n</div>" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+5{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-2}+5{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+5\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-2(-2{y}^{-3})+5(2y) \\\\  & =\\frac{4}{{y}^{3}}+10y \\\\  & =\\frac{4+10{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{{y}^{3}}{4+10{y}^{4}}.\n$$"} {:db/id #edb/ref 17592186524978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a5abe1-8a17-5f77-aca0-0fecc6ce44b1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{(5y-2)^2}{15}" :db/id #edb/ref 17592186524382}] :answer-field/correct {:answer/id #uuid "03a5abe1-8a17-5f77-aca0-0fecc6ce44b1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{(5y-2)^2}{15}" :db/id #edb/ref 17592186524382} :answer-field/id #uuid "78ee6ce2-448a-5e5a-a2ca-c421a7bb8463" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524894}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "35035d93-2432-5072-a261-b3e11d036f56" :question/math-academy-id "q-166151" :question/problem "Given that $x=\\frac{3}{5y-2},$ write $\\frac{\\text{d}y}{\\text{d}x}$ in terms of $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}\\,=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x=\\frac{3}{5y-2}$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}\\left(\\frac{3}{5y-2}\\right) \\\\  & =3\\frac{\\text{d}}{\\text{d}y}((5y-2)^{-1}) \\\\  & =-3(5y-2)^{-2}\\cdot 5 \\\\  & =-\\frac{15}{(5y-2)^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=-\\frac{1}{15}(5y-2)^{2}.\n$$"}] :knowledge-point/title "Calculating dy/dx Using dx/dy"}]}
