62-0046-5ff6-be71-aee3cc7e71f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{3}}{4+4{y}^{4}}" :db/id #edb/ref 17592186300130} :answer-field/id #uuid "84d7d2bf-ce4d-5963-b71f-6932bfd6b3ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301646}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cd82fd71-e11f-52b4-879b-d6f659d732bf" :question/math-academy-id "q-32705" :question/problem "If $x=-\\frac{2}{{y}^{2}}+2{y}^{2},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+2{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-2}+2{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+2\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =4{y}^{-3}+4y \\\\  & =\\frac{4}{{y}^{3}}+4y \\\\  & =\\frac{4+4{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{{y}^{3}}{4+4{y}^{4}}.\n$$"} {:db/id #edb/ref 17592186233834 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ca47a5ef-4902-5764-841f-f4a92c465140" :question/math-academy-id "q-32667" :question/problem "If $x=2{y}^{2}+7y-\\frac{3}{y},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{2}+7y-\\frac{3}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{2}+7y-3{y}^{-1}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}({y}^{2})+7\\frac{\\text{d}}{\\text{d}y}(y)-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =4y+7+3{y}^{-2} \\\\  & =4y+7+\\frac{3}{{y}^{2}} \\\\  & =\\frac{4{y}^{3}+7{y}^{2}+3}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{{y}^{2}}{4{y}^{3}+7{y}^{2}+3}.\n$$"} {:db/id #edb/ref 17592186233915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cbf544-da6e-594e-afde-61e58b7a0c32" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186232842}] :answer-field/correct {:answer/id #uuid "18cbf544-da6e-594e-afde-61e58b7a0c32" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186232842} :answer-field/id #uuid "f87b4831-167f-5261-9548-eabab639f861" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232841} {:answer-field/choices [{:answer/id #uuid "3b74550d-4f2a-53a5-9859-638903e9e0ef" :answer/type {:db/ident :answer.type/math} :answer/value "15{y}^{5}" :db/id #edb/ref 17592186232844}] :answer-field/correct {:answer/id #uuid "3b74550d-4f2a-53a5-9859-638903e9e0ef" :answer/type {:db/ident :answer.type/math} :answer/value "15{y}^{5}" :db/id #edb/ref 17592186232844} :answer-field/id #uuid "f2050ee9-aabb-5a35-8caf-bf27987581b6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232843}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e92e83a8-1c00-5738-9fc2-4ba6c65f2b58" :question/math-academy-id "q-341626" :question/problem "Given that $x=4\\sqrt{y}+3{y}^{5},$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n<div class=\"question-equation fraction-equation\">\n<span>$\\frac{\\text{d}y}{\\text{d}x}=$</span>\n<span class=\"answer-fraction\">\n<span class=\"answer-fraction-numerator\">{{field-1}}</span>\n<span class=\"answer-fraction-denominator\">$2\\sqrt{y}\\,+${{field-2}}</span>\n</span>\n</div>" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4\\sqrt{y}+3{y}^{5}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{1/2}+3{y}^{5}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{1/2})+\\frac{\\text{d}}{\\text{d}y}(3{y}^{5}) \\\\  & =2{y}^{-1/2}+15{y}^{4} \\\\  & =\\frac{2}{\\sqrt{y}}+15{y}^{4} \\\\  & =\\frac{2\\sqrt{y}}{y}+15{y}^{4} \\\\  & =\\frac{2\\sqrt{y}+15{y}^{5}}{y}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{y}{2\\sqrt{y}+15{y}^{5}}.\n$$"} {:db/id #edb/ref 17592186244242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18368760-9ddd-590c-8504-ac684d4a7552" :answer/type {:db/ident :answer.type/math} :answer/value "15{y}^{2}-20y" :db/id #edb/ref 17592186241390} {:answer/id #uuid "3e303b8b-f1ac-5a66-9423-bea9710de798" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3y-20{y}^{2}}" :db/id #edb/ref 17592186241735} {:answer/id #uuid "51a97498-2ce1-56ec-8f2d-31e65df70135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{y}^{2}-10y}" :db/id #edb/ref 17592186241909} {:answer/id #uuid "6b0d0145-cf55-590a-b3f5-a04fac5deec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15{y}^{2}-20y}" :db/id #edb/ref 17592186242141} {:answer/id #uuid "ed51ff09-6401-520a-8e1b-522db433c5bd" :answer/type {:db/ident :answer.type/math} :answer/value "15y-10{y}^{2}" :db/id #edb/ref 17592186243278}] :answer-field/correct {:answer/id #uuid "6b0d0145-cf55-590a-b3f5-a04fac5deec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15{y}^{2}-20y}" :db/id #edb/ref 17592186242141} :answer-field/id #uuid "cfbc73a4-587b-5578-95db-03bfd926635a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243803}] :question/difficulty {:db/ident :question.difficulty/easy} :que