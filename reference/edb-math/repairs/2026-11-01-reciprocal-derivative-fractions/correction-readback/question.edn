#{[{:db/id #edb/ref 17592186315109 :knowledge-point/_questions [{:knowledge-point/id #uuid "00ac6edc-908a-50be-9ef1-4b24ba597d1d" :knowledge-point/title "Calculating dy/dx Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421}] :answer-field/correct {:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421} :answer-field/id #uuid "a13b0fcc-1e2e-571c-b6df-a879bcbc6ca8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aed30416-75f3-525a-aed4-35612b1daf20" :question/math-academy-id "q-341608" :question/problem "Given that $x=-\\frac{2}{{y}^{2}}+5{y}^{2},$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n<div class=\"question-equation fraction-equation\">\n<span>$\\frac{\\text{d}y}{\\text{d}x}=$</span>\n<span class=\"answer-fraction\">\n<span class=\"answer-fraction-numerator\">${y}^{3}$</span>\n<span class=\"answer-fraction-denominator\">{{field-1}}</span>\n</span>\n</div>" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+5{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-2}+5{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+5\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-2(-2{y}^{-3})+5(2y) \\\\  & =\\frac{4}{{y}^{3}}+10y \\\\  & =\\frac{4+10{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={\\left(\\frac{\\text{d}x}{\\text{d}y}\\right)}^{-1}=\\frac{{y}^{3}}{4+10{y}^{4}}.\n$$"}]}
