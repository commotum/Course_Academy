 \\\\ -1 & 4 & {\\color{gray}∗} & 11 & 2\\end{bmatrix}\n$$\n\n   \n\nSo, the minor is\n\n$$\n{M}_{13}=\\begin{vmatrix}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186391944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f0160d-c9c5-5e42-a12c-4b4274aeedd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}3 & -4 & 5 \\\\ 0 & 7 & 1 \\\\ 8 & -9 & -2\\end{vmatrix}" :db/id #edb/ref 17592186391946} {:answer/id #uuid "5376434d-936a-550a-9ce0-17ce08931d7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}7 & 0 & 1 \\\\ 13 & 5 & 5 \\\\ -9 & 2 & -2\\end{vmatrix}" :db/id #edb/ref 17592186391947} {:answer/id #uuid "580bc3a4-2427-5188-b5db-92e39240838a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & 7 & 0 \\\\ 17 & 13 & 5 \\\\ 8 & -9 & 2\\end{vmatrix}" :db/id #edb/ref 17592186391948} {:answer/id #uuid "d1d04ceb-4371-51b4-b0f4-9e1c065eea13" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-4 & 0 & 5 \\\\ 13 & 5 & 5 \\\\ -9 & 2 & -2\\end{vmatrix}" :db/id #edb/ref 17592186391949} {:answer/id #uuid "995458e2-2ea1-526c-9601-c3eb1ba56516" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}3 & -4 & 0 \\\\ 0 & 7 & 0 \\\\ 17 & 13 & 5\\end{vmatrix}" :db/id #edb/ref 17592186391950}] :answer-field/correct {:db/id #edb/ref 17592186391947} :answer-field/id #uuid "9b27d4c4-f074-5e91-8d69-7447178d4698" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391945}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9f0632a-5b82-5460-bd39-fe01374e4256" :question/math-academy-id "q-36092" :question/problem "Find the minor of ${c}_{11}$ in \n$$\n\\displaystyle C=\\begin{bmatrix}3 & -4 & 0 & 5 \\\\ 0 & 7 & 0 & 1 \\\\ 17 & 13 & 5 & 5 \\\\ 8 & -9 & 2 & -2\\end{bmatrix}.\n$$" :question/worked-solution "To get the minor of of ${c}_{11}$, we remove the $1$st row and $1$st column:\n\n$$\nC=\\begin{bmatrix}\\bbox[lightgray, 2pt]{3} & {\\color{gray}∗} & {\\color{gray}∗} & {\\color{gray}∗} \\\\ {\\color{gray}∗} & 7 & 0 & 1 \\\\ {\\color{gray}∗} & 13 & 5 & 5 \\\\ {\\color{gray}∗} & -9 & 2 & -2\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{11}=\\begin{vmatrix}7 & 0 & 1 \\\\ 13 & 5 & 5 \\\\ -9 & 2 & -2\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186392455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbd2805-5b5d-5da0-a17c-1d780695556e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-1 & 6 & 0 \\\\ 0 & 3 & -9 \\\\ -4 & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186392457} {:answer/id #uuid "74e92b10-2baf-5de6-837b-fb52df6e5b4e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186392458} {:answer/id #uuid "42f03cfa-2d33-5fbd-a8ec-bd25305db522" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & 5 & 7 \\\\ 0 & 3 & -9 \\\\ -4 & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186392459} {:answer/id #uuid "75e81c03-d073-5698-8f85-3a4e473cfc7a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}-1 & 6 & 0 \\\\ 2 & 5 & 7 \\\\ -4 & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186392460} {:answer/id #uuid "4f787ba3-9c9c-55c6-bae9-6bfe9a4c5a1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}6 & 4 & 0 \\\\ 5 & 0 & 7 \\\\ 0 & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186392461}] :answer-field/correct {:db/id #edb/ref 17592186392458} :answer-field/id #uuid "a2746e40-3c71-5486-a042-f766ef893f7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392456}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "368c9476-6b26-5a56-b85b-a41230a98028" :question/math-academy-id "q-42092" :question/problem "Find the cofactor of ${b}_{32}$ in $B=\\begin{bmatrix}-1 & 6 & 4 & 0 \\\\ 2 & 5 & 0 & 7 \\\\ 0 & 3 & 5 & -9 \\\\ -4 & 0 & 0 & 1\\end{bmatrix}.$" :question/worked-solution "First, to get the minor of ${b}_{32}$, we remove the $3$rd  row and $2$nd column: \n\n$$\nB=\\begin{bmatrix}-1 & {\\color{gray}∗} & 4 & 0 \\\\ 2 & {\\color{gray}∗} & 0 & 7 \\\\ {\\color{gray}∗} & \\bbox[lightgray, 2pt]{{\\color{gray}3}} & {\\color{gray}∗} & {\\color{gray}∗} \\\\ -4 & {\\color{gray}∗} & 0 & 1\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{32}=\\begin{vmatrix}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{vmatrix}.\n$$\n\nTherefore, the cofactor of ${b}_{32}$ is\n\n$$\n\\begin{aligned}{C}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =-{M}_{32} \\\\  & =-\\begin{vmatrix}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdecdb2a-be1a-535a-bee9-9659ab7d1d37" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{vmatrix}" :db/id #edb/ref 17592186393093} {:answer/id #uuid "81a8a04c-db9c-57ca-b056-75bc4bda4bb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-7 & 0 & \\,1 \\\\ 10 & -1 & \\,0 \\\\ -2 & 0 & \\,2\\end{vmatrix}" :db/id #edb/ref 17592186393094} {:answer/id #uuid "07c43492-f6dd-5136-82a3-13dad2882b0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-7 & 0 & \\,1 \\\\ 10 & -1 & \\,0 \\\\ 11 & 0 & \\,-3\\end{vmatrix}" :db/id #edb/ref 17592186393095} {:answer/id #uuid "01e785ae-c084-571e-93e7-3cc45466fd54" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}3 & 0 & \\,1 \\\\ 1 & -1 & \\,0 \\\\ 0 & 3 & \\,2\\end{vmatrix}" :db/id #edb/ref 17592186393096} {:answer/id #uuid "435c0dce-546b-54b9-bdab-d4baeb3c9ec3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}10 & 1 & \\,0 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{vmatrix}" :db/id #edb/ref 17592186393097}] :answer-field/correct {:db/id #edb/ref 17592186393093} :answer-field/id #uuid "b15b527c-7c8f-54df-aefc-bcdbdc70d5ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393092}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "caf1e0fb-eb87-5e71-a542-0c1755eff5ab" :question/math-academy-id "q-71189" :question/problem "What is the minor of ${p}_{23}$ in  $$\n\\displaystyle P=\\begin{bmatrix}-7 & 3 & 0 & \\,1 \\\\ 10 & 1 & -1 & \\,0 \\\\ -2 & 0 & 3 & \\,2 \\\\ 11 & 3 & 0 & \\,-3\\end{bmatrix}?\n$$" :question/worked-solution "To get the minor of ${p}_{23}$, we remove the  $2$nd row and the $3$rd column:\n\n$$\nP=\\begin{bmatrix}-7 & 3 & {\\color{gray}∗} & 1 \\\\ {\\color{gray}∗} & {\\color{gray}∗} & \\bbox[lightgray, 2pt]{{\\color{gray}-1}} & {\\color{gray}∗} \\\\ -2 & 0 & {\\color{gray}∗} & 2 \\\\ 11 & 3 & {\\color{gray}∗} & -3\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{23}=\\begin{vmatrix}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186393098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf02146-e1b0-5539-b4e5-5e4db585f712" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{vmatrix}" :db/id #edb/ref 17592186393100} {:answer/id #uuid "639ab66c-d0ba-5e67-b27c-fee7c12393fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & -1 & 0 \\\\ 5 & -1 & 1 \\\\ 7 & 10 & 8\\end{vmatrix}" :db/id #edb/ref 17592186393101} {:answer/id #uuid "e0e8b3c9-465c-55d4-b781-46d61c898c4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & 1 & 0 \\\\ 5 & 0 & 1 \\\\ 7 & 2 & 8\\end{vmatrix}" :db/id #edb/ref 17592186393102} {:answer/id #uuid "e9c7b7b0-99e1-5530-8565-49e93df10d3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 7 & 10 & 8\\end{vmatrix}" :db/id #edb/ref 17592186393103} {:answer/id #uuid "923bf90c-f200-5ae2-850a-6b9cff1e3bf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-1 & 0 & 1 \\\\ 10 & 2 & 8 \\\\ -3 & 0 & 3\\end{vmatrix}" :db/id #edb/ref 17592186393104}] :answer-field/correct {:db/id #edb/ref 17592186393100} :answer-field/id #uuid "dd952f15-a2c4-53c4-ab18-fdcc2715d46f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393099}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5a3f02c-617a-514d-b9f7-86ea907e6206" :question/math-academy-id "q-71190" :question/problem "What is the minor of ${u}_{34}$ in  $U=\\begin{bmatrix}2 & -1 & 1 & 0 \\\\ 5 & -1 & 0 & 1 \\\\ 7 & 10 & 2 & 8 \\\\ 9 & -3 & 0 & 3\\end{bmatrix}?$" :question/worked-solution "To get the minor of ${u}_{34}$, we remove the  $3$rd row and the $4$th column:\n\n$$\nU=\\begin{bmatrix}2 & -1 & 1 & {\\color{gray}∗} \\\\ 5 & -1 & 0 & {\\color{gray}∗} \\\\ {\\color{gray}∗} & {\\color{gray}∗} & {\\color{gray}∗} & \\bbox[lightgray, 2pt]{{\\color{gray}8}} \\\\ 9 & -3 & 0 & {\\color{gray}∗}\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=\\begin{vmatrix}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186393292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f6f82c2-90c5-5b86-9116-e45789f5346b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\begin{bmatrix}0 & -1 & 3 \\\\ 0 & 4 & 18 \\\\ -12 & 0 & -6\\end{bmatrix}" :db/id #edb/ref 17592186393294} {:answer/id #uuid "48104ce2-f01f-520d-9994-ff0f604fb955" :answer/type {:db/ident :answer.type/math} :answer/value "12\\begin{bmatrix}0 & 0 & 12 \\\\ 1 & -4 & -18 \\\\ -3 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186393295} {:answer/id #uuid "e267455a-8414-553e-ad9e-957e9a3d2a98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{12}\\begin{bmatrix}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 0 & -6\\end{bmatrix}" :db/id #edb/ref 17592186393296} {:answer/id #uuid "792ada25-1920-5890-a2c7-80e2010138b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & -1 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{bmatrix}" :db/id #edb/ref 17592186393297} {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\begin{bmatrix}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{bmatrix}" :db/id #edb/ref 17592186393298}] :answer-field/correct {:db/id #edb/ref 17592186393298} :answer-field/id #uuid "14ebbec9-43d1-5641-a2c2-12f7a04b7202" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393293}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d1042ad-eb6e-59f8-9dab-abab5265f662" :question/math-academy-id "q-73485" :question/problem "Find the inverse of the matrix $A=\\begin{bmatrix}-2 & 0 & 4 \\\\ 4 & 3 & 1 \\\\ -1 & 0 & 0\\end{bmatrix}$\ngiven that $det(A)=12.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=12\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}3 & 1 \\\\ 0 & 0\\end{vmatrix} & \\begin{vmatrix}4 & 1 \\\\ -1 & 0\\end{vmatrix} & \\begin{vmatrix}4 & 3 \\\\ -1 & 0\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 4 \\\\ 0 & 0\\end{vmatrix} & \\begin{vmatrix}-2 & 4 \\\\ -1 & 0\\end{vmatrix} & \\begin{vmatrix}-2 & 0 \\\\ -1 & 0\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 4 \\\\ 3 & 1\\end{vmatrix} & \\begin{vmatrix}-2 & 4 \\\\ 4 & 1\\end{vmatrix} & \\begin{vmatrix}-2 & 0 \\\\ 4 & 3\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & -18 & -6\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 18 & -6\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{12}\\begin{bmatrix}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "306a57a1-c90d-5377-92c1-ce8a4090bf78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395940} {:answer/id #uuid "8bcb109b-8e0c-537f-97bd-617cfaf0f544" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186395941} {:answer/id #uuid "f263605b-a3cd-5db3-ab7d-ef1aab9f3dff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395942} {:answer/id #uuid "236f7032-923a-5882-b067-96dd10890441" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}2 & 1 \\\\ 5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186395943} {:answer/id #uuid "8b77ea03-f99e-5649-8358-600824460ebc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395944}] :answer-field/correct {:db/id #edb/ref 17592186395942} :answer-field/id #uuid "aedcf9db-ed57-5dd9-8b52-eb742bee0864" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395939}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e922303e-f1e5-5b8d-b2da-04cdac58e3ea" :question/math-academy-id "q-7945" :question/problem "Calculate ${Q}^{-1}$, where\n$$\n\\displaystyle Q=\\begin{bmatrix}-3 & 1 \\\\ 5 & -2\\end{bmatrix}.\n$$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nQ=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $Q$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Q)=(-3)\\cdot (-2)-5\\cdot 1=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{1}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Q{Q}^{-1} & =\\begin{bmatrix}-3 & 1 \\\\ 5 & -2\\end{bmatrix}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {Q}^{-1}Q & =\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}\\begin{bmatrix}-3 & 1 \\\\ 5 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "741083d8-7378-5329-81bd-75ee950b2144" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471555} {:answer/id #uuid "4b7d78d5-2816-585a-9205-a6e70044ec0b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471556}] :answer-field/correct {:db/id #edb/ref 17592186471556} :answer-field/id #uuid "1ec26382-ce45-51fe-9719-373d673b7f62" :answer-field/key "$P=\\begin{bmatrix}4 & 3 \\\\ 8 & 6\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472283} {:answer-field/choices [{:answer/id #uuid "3df8f3cc-d84c-5eee-b203-2e5b3a76ac8d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471557} {:answer/id #uuid "084c65aa-a350-580e-b2a3-5201f6c81dfd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471558}] :answer-field/correct {:db/id #edb/ref 17592186471558} :answer-field/id #uuid "d2cbff6b-6444-5254-a29c-7df2a40ce247" :answer-field/key "$Q=\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472284} {:answer-field/choices [{:answer/id #uuid "699ee824-9041-5440-9507-9d2a68088e86" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471559} {:answer/id #uuid "b999e8b9-c8e3-57fc-af6a-5cfb661ee0e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471560}] :answer-field/correct {:db/id #edb/ref 17592186471559} :answer-field/id #uuid "7a76c867-cf40-5ba2-9a8c-90664e519511" :answer-field/key "$R=\\begin{bmatrix}2 & -4 & 3 \\\\ 3 & -4 & 2\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472285}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "17761662-c8e1-5053-be1d-f17ca1632a52" :question/math-academy-id "q-7915" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $P$, we have\n\n$$\ndet(P)=4\\cdot 6-8\\cdot 3=0.\n$$\n\nBecause $det(P)=0,$ we conclude that $P$ is not invertible. Since $P$ is a square matrix that is not invertible, we also say that $P$ is singular.\n\n- For the matrix $Q$, we have\n\n$$\ndet(Q)=1\\cdot 1-(-1)\\cdot (-1)=0.\n$$\n\nBecause $det(Q)=0,$ we conclude that $Q$ is not invertible. Since $Q$ is a square matrix that is not invertible, we also say that $Q$ is singular.\n\n- The matrix $R$ is a $2\\times 3$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $P$ and $Q$ are singular."}] [{:db/id #edb/ref 17592186398333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bce01ee3-e62d-5dbf-8ab7-ab7ffd839257" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\begin{bmatrix}-2 & 8 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186398335} {:answer/id #uuid "cb1c7834-02fe-5c78-b2fe-aa883eb34976" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\begin{bmatrix}8 & 2 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398336} {:answer/id #uuid "c2e1ebaa-2f3e-5015-b022-3d3df282249e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}\\begin{bmatrix}8 & 2 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398337} {:answer/id #uuid "717243f7-02ac-50c5-9655-63bba2b18b42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-1 & 2 \\\\ 3 & 8\\end{bmatrix}" :db/id #edb/ref 17592186398338} {:answer/id #uuid "fcfc218d-9756-5117-a5b1-a400cbe24097" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398339}] :answer-field/correct {:db/id #edb/ref 17592186398339} :answer-field/id #uuid "16d27f97-4329-5b65-b357-06a7d75d56ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398334}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9fd0e8ab-5ed1-5462-b099-07b3173547c9" :question/math-academy-id "q-127736" :question/problem "Calculate ${Z}^{-1}$ where\n$$\n\\displaystyle Z=\\begin{bmatrix}1 & 2 \\\\ 3 & 8\\end{bmatrix}.\n$$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nZ=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $Z$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Z)=1\\cdot 8-3\\cdot 2=2\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Z{Z}^{-1} & =\\begin{bmatrix}1 & 2 \\\\ 3 & 8\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {Z}^{-1}Z & =\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7ce0b9-8bef-5a30-a632-26629274772f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-2 & 3 \\\\ 5 & 7\\end{bmatrix}" :db/id #edb/ref 17592186398342} {:answer/id #uuid "a1e85deb-4ee7-5dd1-83b9-549af07b1b5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -3 \\\\ -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186398343} {:answer/id #uuid "506981c3-b1de-57d9-8bb9-05dbc5caad2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-2 & -3 \\\\ 5 & 7\\end{bmatrix}" :db/id #edb/ref 17592186398344} {:answer/id #uuid "c55c053c-99f7-578e-a9b7-2928fc100ac3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186398345} {:answer/id #uuid "da2f7c91-660d-5f24-88f0-96190a785249" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186398346}] :answer-field/correct {:db/id #edb/ref 17592186398345} :answer-field/id #uuid "194044ba-41ba-5420-975a-652d3ae5b598" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398341}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9cf7ac8-28c7-510c-8205-256a03a04ef2" :question/math-academy-id "q-127737" :question/problem "Calculate ${U}^{-1}$, where \n$$\n\\displaystyle U=\\begin{bmatrix}-2 & 3 \\\\ -5 & 7\\end{bmatrix}.\n$$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nU=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $U$ can be found using the following formula:\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(U)=-2\\cdot 7-(-5)\\cdot 3=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{1}\\begin{bmatrix}7 & -3 \\\\ -(-5) & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}U{U}^{-1} & =\\begin{bmatrix}-2 & 3 \\\\ -5 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {U}^{-1}U & =\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}\\begin{bmatrix}-2 & 3 \\\\ -5 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ba324b7-0f59-5f58-97d8-72603006234e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472568} {:answer/id #uuid "35d1bf70-dd44-5f00-ace4-811a4e3e1bbb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472569}] :answer-field/correct {:db/id #edb/ref 17592186472569} :answer-field/id #uuid "70d07d03-c34c-5845-8935-896ff2fde738" :answer-field/key "$A=\\begin{bmatrix}3 \\\\ 1 \\\\ 9\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473679} {:answer-field/choices [{:answer/id #uuid "6761343e-3cb3-55f7-a59d-31304c33661b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472570} {:answer/id #uuid "b1649aac-77b0-5dac-9373-2f007c41a012" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472571}] :answer-field/correct {:db/id #edb/ref 17592186472570} :answer-field/id #uuid "6588ae30-e559-5601-8ef8-17cc3ef6f0a1" :answer-field/key "$B=\\begin{bmatrix}-3 & 15 \\\\ 1 & 5\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473680} {:answer-field/choices [{:answer/id #uuid "5499f975-6325-5729-a9ba-045a3cca2d15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472572} {:answer/id #uuid "3bc00b66-d40e-52ef-8970-33efae0b0fac" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472573}] :answer-field/correct {:db/id #edb/ref 17592186472572} :answer-field/id #uuid "7cced4e2-6cfd-5a39-854d-313251047edc" :answer-field/key "$C=\\begin{bmatrix}7 & 4 \\\\ 3 & 2\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473681}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd3729c7-43c0-5883-808f-5b63c7f7af84" :question/math-academy-id "q-127826" :question/problem "Which of the matrices below does **not** have an inverse?\n\nSelect all that apply." :question/worked-solution "- The matrix $A$ is a $3\\times 1$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=-3\\cdot 5-1\\cdot 15=-30.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=7\\cdot 2-3\\cdot 4=2.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ does not have an inverse."}] [{:db/id #edb/ref 17592186400485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b3cd2b-284b-5242-a0fd-852bf0b1881c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}5y &=-9 \\\\ x &=-1\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422744} {:answer/id #uuid "2540c038-f7ff-526e-8623-0b2eb9995f47" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}5y &=9 \\\\ x &=1\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422762} {:answer/id #uuid "86106155-653b-5126-ac12-f97cdb674767" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}x+5y &=9 \\\\ x &=-1\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422839} {:answer/id #uuid "9560da06-25ad-5721-bc24-046715bc8034" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}5y &=9 \\\\ x &=-1\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422854} {:answer/id #uuid "be15d0f0-70f8-5910-afd6-1af63be69956" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}x+5y &=9 \\\\ y &=-1\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422888}] :answer-field/correct {:db/id #edb/ref 17592186422854} :answer-field/id #uuid "0c4d849c-e24c-5150-9286-220ece393a3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400486}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a1162f6f-3b06-5edc-926f-fe3ac4ca244f" :question/math-academy-id "q-130528" :question/problem "What is the system of equations represented by\n\n$$\n\\begin{bmatrix}0 & 5 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}9 \\\\ -1\\end{bmatrix}?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}0x+5y &=9 \\\\ x+0y &=-1\\end{aligned}\\right.\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}5y &=9 \\\\ x &=-1.\\end{aligned}\\right.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b0257b-5aa5-5961-8c79-b270612973ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}y &=0 \\\\ x-4y &=5\\end{aligned}\\right." :db/id #edb/ref 17592186403497} {:answer/id #uuid "efe4f88d-8258-5d39-be46-855c1e2c58e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}y &=0 \\\\ -4x+y &=5\\end{aligned}\\right." :db/id #edb/ref 17592186403498} {:answer/id #uuid "7cea8dbe-3578-5886-bfe4-f51b25347ed9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=0 \\\\ x-4y &=5\\end{aligned}\\right." :db/id #edb/ref 17592186403499} {:answer/id #uuid "aba3c242-ef16-5d89-8d0a-32ce47931725" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}y &=5 \\\\ x-4y &=0\\end{aligned}\\right." :db/id #edb/ref 17592186403500} {:answer/id #uuid "777783df-e9bd-5dfd-9c9a-d3ccfc310aa7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=0 \\\\ x-3y &=5\\end{aligned}\\right." :db/id #edb/ref 17592186403501}] :answer-field/correct {:db/id #edb/ref 17592186403497} :answer-field/id #uuid "796fd7cb-3aaa-51b5-a9d2-6f0f250be044" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403496}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f74fa12-0053-502d-b17f-669ab25e05d2" :question/math-academy-id "q-71854" :question/problem "What is the system of equations represented by\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ -3 & 12\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -15\\end{bmatrix}?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}0x-y &=0 \\\\ -3x+12y &=-15.\\end{aligned}\\right.\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\left\\{\\begin{aligned}y &=0 \\\\ x-4y &=5.\\end{aligned}\\right.\n$$"}] [{:db/id #edb/ref 17592186403509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bba5ddca-29ae-5471-a6a4-993be5c996d1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473266} {:answer/id #uuid "8369e458-effb-5b2b-b5d4-aba006c45804" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473267}] :answer-field/correct {:db/id #edb/ref 17592186473267} :answer-field/id #uuid "8863fa22-3b39-5e93-9963-14e8b851c92e" :answer-field/key "$N=\\begin{bmatrix}3 & 1 \\\\ 0 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474028} {:answer-field/choices [{:answer/id #uuid "60e26ea5-9f10-529e-82c8-1409cac8b2bb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473268} {:answer/id #uuid "1749b0ec-a540-5a67-a5c4-d23285285ca9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473269}] :answer-field/correct {:db/id #edb/ref 17592186473268} :answer-field/id #uuid "de8378a0-44cf-5391-92e6-89fe38fdd15b" :answer-field/key "$V=\\begin{bmatrix}1 \\\\ 2 \\\\ -2 \\\\ 1 \\\\ -1\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474029} {:answer-field/choices [{:answer/id #uuid "0e75c4be-b101-5f9d-baaf-856e7cc7d65f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473270} {:answer/id #uuid "b3e2e004-d50b-5230-b52c-79e97034086b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473271}] :answer-field/correct {:db/id #edb/ref 17592186473270} :answer-field/id #uuid "ce016b55-73ba-587f-8f45-40784a020589" :answer-field/key "$Z=\\begin{bmatrix}0 & 8 \\\\ 2 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474030}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f5bb9d1-db59-54f4-aa53-0a0fa0a6f6c0" :question/math-academy-id "q-71935" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $N$, we have\n\n$$\ndet(N)=3\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $det(N)=0,$ we conclude that $N$ is not invertible. Since $N$ is a square matrix that is not invertible, we also say that $N$ is singular.\n\n- The matrix $V$ is a $5\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $Z$, we have\n\n$$\ndet(Z)=0\\cdot 0-2\\cdot 8=-16.\n$$\n\nBecause $det(Z)\\ne 0,$ we conclude that $Z$ is invertible.\n\nTherefore, only $N$ is singular."}] [{:db/id #edb/ref 17592186403516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1be0fb0-9847-565b-b3c1-581466264ba8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473272} {:answer/id #uuid "037b4724-2974-5573-821c-be931e428675" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473273}] :answer-field/correct {:db/id #edb/ref 17592186473272} :answer-field/id #uuid "94f2a2ea-24ce-5a7c-a465-8a604fac4939" :answer-field/key "$T=\\begin{bmatrix}5 & -8 & 7 & -6 \\\\ 1 & -2 & 3 & -4\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474031} {:answer-field/choices [{:answer/id #uuid "af46807b-2810-56be-88f8-06e3ecb337ff" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473274} {:answer/id #uuid "238549e7-3ff3-56c2-b10d-990ab4747696" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473275}] :answer-field/correct {:db/id #edb/ref 17592186473274} :answer-field/id #uuid "b73a784d-7afb-5d08-b1c6-524d553bcf9d" :answer-field/key "$U=\\begin{bmatrix}3 & -15 \\\\ -1 & 4\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474032} {:answer-field/choices [{:answer/id #uuid "c234f526-26f2-5eb0-a6cf-173562472af2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473276} {:answer/id #uuid "aaad2947-e803-5417-9079-e397f4a8ca24" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473277}] :answer-field/correct {:db/id #edb/ref 17592186473277} :answer-field/id #uuid "775f56d7-7a83-56b8-89ed-384ecac6070a" :answer-field/key "$V=\\begin{bmatrix}6 & 3 \\\\ 10 & 5\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ff070848-777f-5635-9918-6da54f4ec8b2" :question/math-academy-id "q-71937" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- The matrix $T$ is a $2\\times 4$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $U$, we have\n\n$$\ndet(U)=3\\cdot 4-(-1)\\cdot (-15)=-3.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\n- For the matrix $V$, we have\n\n$$\ndet(V)=6\\cdot 5-10\\cdot 3=0.\n$$\n\nBecause $det(V)=0,$ we conclude that $V$ is not invertible. Since $V$ is a square matrix that is not invertible, we also say that $V$ is singular.\n\nTherefore, only $V$ is singular."}] [{:db/id #edb/ref 17592186426308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "332694ea-bd99-5523-b1d8-48a224b3dc34" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186426297} {:answer/id #uuid "6ed8db16-e8bd-5c83-b560-aef74fb47014" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186426299} {:answer/id #uuid "864823ca-9fd6-5647-872e-3574bd6be0c8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186426300} {:answer/id #uuid "d90a60bf-c9df-5642-a65f-043b1fbac549" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186426303} {:answer/id #uuid "f712f3e2-029b-5a8a-b19e-340bb36a3186" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186426304}] :answer-field/correct {:db/id #edb/ref 17592186426300} :answer-field/id #uuid "7ea44ec1-58ba-5956-a980-aec4c772ced8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426307}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "60094f6c-d2bd-58df-8627-15176f255263" :question/math-academy-id "q-104435" :question/problem "The entry ${a}_{21}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 0 & 1 \\\\ 2 & k & 2 \\\\ 1 & 3 & -1\\end{bmatrix}\n$$\nequals $2.$ Find the value of $k.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}1 & 0 & 1 \\\\ 2 & k & 2 \\\\ 1 & 3 & -1\\end{vmatrix} & =1\\begin{vmatrix}k & 2 \\\\ 3 & -1\\end{vmatrix}-0\\begin{vmatrix}2 & 2 \\\\ 1 & -1\\end{vmatrix}+1\\begin{vmatrix}2 & k \\\\ 1 & 3\\end{vmatrix} \\\\  & =1(-k-6)-0+1(6-k) \\\\  & =-k-6+6-k \\\\  & =-2k.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}2 & 2 \\\\ 1 & -1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}2 & 2 \\\\ 1 & -1\\end{vmatrix} \\\\  & =-(-2-2) \\\\  & =4.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{12} \\\\  & =\\frac{1}{-2k}\\cdot 4 \\\\  & =-\\frac{2}{k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{21}^{′}=2$, we have\n\n$$\n\\begin{aligned}-\\frac{2}{k} & =2 \\\\ -2 & =2k \\\\ -\\frac{2}{2} & =k \\\\ k & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186426309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16cc7665-faef-5318-96fb-c89a1b7adc64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}2 & -8 & -1 \\\\ 0 & -3 & 0 \\\\ -1 & 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186426296} {:answer/id #uuid "39a3852a-5680-51e4-9e2a-405e8aa0a909" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\begin{bmatrix}2 & -8 & -1 \\\\ 0 & -3 & 0 \\\\ -1 & 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186426298} {:answer/id #uuid "95310ad0-4ea0-549a-b41e-47e2e1481ffb" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\begin{bmatrix}2 & 0 & -1 \\\\ 8 & -3 & 1 \\\\ -1 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186426301} {:answer/id #uuid "b9fbec83-d0b7-55ad-a7b0-15c8c1d2d21d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -8 & -1 \\\\ 0 & -3 & 0 \\\\ -1 & -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186426302} {:answer/id #uuid "fc2f21f0-c001-5a27-883c-872065513e5c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\begin{bmatrix}2 & 0 & -1 \\\\ 8 & -3 & 0 \\\\ -1 & 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186426305}] :answer-field/correct {:db/id #edb/ref 17592186426298} :answer-field/id #uuid "4b1f25d6-5390-5fe3-998f-b7a40d9649c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ccf4f432-0d42-54bc-b36a-bd39fd754033" :question/math-academy-id "q-73478" :question/problem "Find the inverse of the matrix $A=\\begin{bmatrix}-1 & 3 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & -2 & 2\\end{bmatrix}$\ngiven that $det(A)=-3.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=-3\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}1 & 0 \\\\ -2 & 2\\end{vmatrix} & \\begin{vmatrix}0 & 0 \\\\ 1 & 2\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 1 & -2\\end{vmatrix} \\\\ \\begin{vmatrix}3 & 1 \\\\ -2 & 2\\end{vmatrix} & \\begin{vmatrix}-1 & 1 \\\\ 1 & 2\\end{vmatrix} & \\begin{vmatrix}-1 & 3 \\\\ 1 & -2\\end{vmatrix} \\\\ \\begin{vmatrix}3 & 1 \\\\ 1 & 0\\end{vmatrix} & \\begin{vmatrix}-1 & 1 \\\\ 0 & 0\\end{vmatrix} & \\begin{vmatrix}-1 & 3 \\\\ 0 & 1\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & -1 \\\\ 8 & -3 & -1 \\\\ -1 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}2 & 0 & -1 \\\\ -8 & -3 & 1 \\\\ -1 & 0 & -1\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}2 & -8 & -1 \\\\ 0 & -3 & 0 \\\\ -1 & 1 & -1\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =-\\frac{1}{3}\\begin{bmatrix}2 & -8 & -1 \\\\ 0 & -3 & 0 \\\\ -1 & 1 & -1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6bd69d-eb28-52f2-9e31-c5b78c1f5326" :answer/type {:db/ident :answer.type/math} :answer/value "-56" :db/id #edb/ref 17592186570980} {:answer/id #uuid "7df978ee-1cba-5e6d-a0df-7a5d2c0faa72" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186571088} {:answer/id #uuid "b58b8460-eabb-5831-9222-ae5190c87747" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186571171} {:answer/id #uuid "e4b666c4-2e1e-5e88-95b7-208ffe3d3b53" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186571247} {:answer/id #uuid "fd9e80fa-761b-575b-8358-1633af610880" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186571278}] :answer-field/correct {:db/id #edb/ref 17592186571088} :answer-field/id #uuid "2984758c-d2d0-5408-9558-da3f2d0bbdb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571300}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5f805a2f-454d-5b6b-b94e-f4a78a778d84" :question/math-academy-id "q-131099" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle T=\\begin{bmatrix}0 & 0 & 0 & -10 \\\\ 0 & 4 & 0 & -5 \\\\ 1 & 3 & 2 & 0 \\\\ 1 & 2 & 3 & -25\\end{bmatrix}\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(T) & ={t}_{11}{C}_{11}+{t}_{12}{C}_{12}+{t}_{13}{C}_{13}+{t}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}-10\\cdot {C}_{14} \\\\  & =-10{C}_{14} \\\\  & =-10\\cdot \\begin{vmatrix}∗ & ∗ & ∗ & -10 \\\\ 0 & 4 & 0 & ∗ \\\\ 1 & 3 & 2 & ∗ \\\\ 1 & 2 & 3 & ∗\\end{vmatrix} \\\\  & =-10(-1)^{1+4}\\begin{vmatrix}0 & 4 & 0 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 3\\end{vmatrix} \\\\  & =10\\left(0\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & 3\\end{vmatrix}-4\\cdot \\begin{vmatrix}1 & 2 \\\\ 1 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}1 & 3 \\\\ 1 & 2\\end{vmatrix}\\right) \\\\  & =10(0-4(1\\cdot 3-1\\cdot 2)+0) \\\\  & =10\\cdot (-4) \\\\  & =-40\\end{aligned}\n$$"}]}
