 row and $2$nd column: \n\n$$\nX=\\begin{bmatrix}1 & {\\color{gray}∗} & 2 & -5 & -1 \\\\ 3 & {\\color{gray}∗} & 6 & 3 & 1 \\\\ -1 & {\\color{gray}∗} & -5 & 6 & -4 \\\\ 4 & {\\color{gray}∗} & 3 & 8 & 3 \\\\ {\\color{gray}∗} & \\bbox[lightgray, 2pt]{{\\color{gray}3}} & {\\color{gray}∗} & {\\color{gray}∗} & {\\color{gray}∗}\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{52}=\\begin{vmatrix}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{vmatrix}.\n$$\n\nNow, the cofactor of ${x}_{52}$ is\n\n$$\n\\begin{aligned}{C}_{52} & =(-1)^{5+2}{M}_{52} \\\\  & =-{M}_{52} \\\\  & =-\\begin{vmatrix}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "338045b0-64d0-5ebf-a057-2cef9ed29ca9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}3 & -8 & 1 & 0 \\\\ 3 & 5 & 0 & 1 \\\\ -25 & -1 & 6 & -4 \\\\ 4 & 8 & 8 & 3\\end{vmatrix}" :db/id #edb/ref 17592186263447} {:answer/id #uuid "40a809ef-a58a-5141-897e-5ca0e3d65f04" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}3 & -8 & 1 & 0 \\\\ 3 & 5 & 0 & 1 \\\\ -25 & -1 & 6 & -4 \\\\ 4 & 8 & 8 & 3\\end{vmatrix}" :db/id #edb/ref 17592186263571} {:answer/id #uuid "dfe8006b-142b-5171-b366-b49610d775d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{vmatrix}" :db/id #edb/ref 17592186264945} {:answer/id #uuid "e38b6938-7f5f-54d4-beb6-c9c35c7a9e26" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{vmatrix}" :db/id #edb/ref 17592186264978} {:answer/id #uuid "ff7de405-c8be-59e0-bed7-5d7269b3a8e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & \\sqrt{13} & 0 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 8 & 3 & 8 & 3 \\\\ 3 & \\sqrt{2} & -9 & 7\\end{vmatrix}" :db/id #edb/ref 17592186265246}] :answer-field/correct {:db/id #edb/ref 17592186264945} :answer-field/id #uuid "233238c1-b02d-5669-8149-02a937f78875" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265307}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b6b1e4d2-2558-5a17-9d34-9f5f93546f16" :question/math-academy-id "q-130907" :question/problem "Find the cofactor of ${p}_{35}$ in \n$$\n\\displaystyle P=\\begin{bmatrix}3 & -8 & 2 & 1 & 0 \\\\ 3 & 5 & \\sqrt{13} & 0 & 1 \\\\ -25 & -1 & -5 & 6 & -4 \\\\ 4 & 8 & 3 & 8 & 3 \\\\ 11 & 3 & \\sqrt{2} & -9 & 7\\end{bmatrix}.\n$$" :question/worked-solution "First, to get the minor of ${p}_{35}$, we remove the $3$rd row and $5$th column: \n\n$$\nP=\\begin{bmatrix}3 & -8 & 2 & 1 & {\\color{gray}∗} \\\\ 3 & 5 & \\sqrt{13} & 0 & {\\color{gray}∗} \\\\ {\\color{gray}∗} & {\\color{gray}∗} & {\\color{gray}∗} & {\\color{gray}∗} & \\bbox[lightgray, 2pt]{{\\color{gray}-4}} \\\\ 4 & 8 & 3 & 8 & {\\color{gray}∗} \\\\ 11 & 3 & \\sqrt{2} & -9 & {\\color{gray}∗}\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{35}=\\begin{vmatrix}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{vmatrix}.\n$$\n\nNow, the cofactor of ${p}_{35}$ is\n\n$$\n\\begin{aligned}{C}_{35} & =(-1)^{3+5}{M}_{35} \\\\  & ={M}_{35} \\\\  & =\\begin{vmatrix}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254608a3-f4c4-524d-bdd6-4734ea7a9ed3" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186263322} {:answer/id #uuid "6ca6a3f0-0a99-59ca-89a0-00d1f53a84ec" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186263935} {:answer/id #uuid "848415f8-f9ee-573e-9e2c-e1517406f8f7" :answer/type {:db/ident :answer.type/math} :answer/value "-125" :db/id #edb/ref 17592186264137} {:answer/id #uuid "9205aebe-b2d8-5a93-8a96-975a2e76b5c9" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186264250} {:answer/id #uuid "e0fb479c-83a3-5744-99c8-93b5e83e4668" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186264955}] :answer-field/correct {:db/id #edb/ref 17592186264955} :answer-field/id #uuid "4716f2cc-0f74-549d-b0ab-845a4315cc85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "984e49ec-1c3a-575d-8328-f0b575ca3b17" :question/math-academy-id "q-131096" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle D=\\begin{bmatrix}0 & 0 & 0 & 1 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 1 & 2 & 3 \\\\ 6 & 5 & 3 & 0\\end{bmatrix}.\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(D) & ={d}_{11}{C}_{11}+{d}_{12}{C}_{12}+{d}_{13}{C}_{13}+{d}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+1\\cdot {C}_{14} \\\\  & =1{C}_{14} \\\\  & =1\\cdot \\begin{vmatrix}{\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}1} \\\\ 0 & 4 & 0 & {\\color{lightgray}∗} \\\\ 0 & 1 & 2 & {\\color{lightgray}∗} \\\\ 6 & 5 & 3 & {\\color{lightgray}∗}\\end{vmatrix} \\\\  & =1(-1)^{1+4}\\begin{vmatrix}0 & 4 & 0 \\\\ 0 & 1 & 2 \\\\ 6 & 5 & 3\\end{vmatrix} \\\\  & =-1\\left(0\\cdot \\begin{vmatrix}1 & 2 \\\\ 5 & 3\\end{vmatrix}-4\\cdot \\begin{vmatrix}0 & 2 \\\\ 6 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}0 & 1 \\\\ 6 & 5\\end{vmatrix}\\right) \\\\  & =-(0-4(3\\cdot 0-2\\cdot 6)+0) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a08f51-b677-5b68-ba7a-dac3baa9eb2a" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186263449} {:answer/id #uuid "6b51c736-ffe0-52cf-a537-2dbf8f99b091" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{31}{2}" :db/id #edb/ref 17592186263926} {:answer/id #uuid "86e76cd7-4277-5294-92f3-131eaa99845a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186264166} {:answer/id #uuid "ae7b46e1-3b32-525c-ad19-743406d4fd14" :answer/type {:db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186264501} {:answer/id #uuid "f10b6e0e-0a43-5cd2-aaf1-18a085bf0628" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186265117}] :answer-field/correct {:db/id #edb/ref 17592186263449} :answer-field/id #uuid "310e57cf-52eb-56bb-88ee-20cd79122820" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265333}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec31df61-abd0-5be5-8c6f-e699fba92ddd" :question/math-academy-id "q-131114" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle Z=\\begin{bmatrix}\\frac{1}{2} & 0 & 0 & 0 \\\\ 5 & 0 & -2 & 0 \\\\ 1 & 5 & 3 & 2 \\\\ 1 & 2 & 3 & 8\\end{bmatrix}\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =\\frac{1}{2}\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =\\frac{1}{2}{C}_{11} \\\\  & =\\frac{1}{2}\\cdot \\begin{vmatrix}{\\color{lightgray}\\frac{1}{2}} & {\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}∗} \\\\ {\\color{lightgray}∗} & 0 & -2 & 0 \\\\ {\\color{lightgray}∗} & 5 & 3 & 2 \\\\ {\\color{lightgray}∗} & 2 & 3 & 8\\end{vmatrix} \\\\  & =\\frac{1}{2}(-1)^{1+1}\\begin{vmatrix}0 & -2 & 0 \\\\ 5 & 3 & 2 \\\\ 2 & 3 & 8\\end{vmatrix} \\\\  & =\\frac{1}{2}\\left(0\\cdot \\begin{vmatrix}3 & 2 \\\\ 3 & 8\\end{vmatrix}-(-2)\\cdot \\begin{vmatrix}5 & 2 \\\\ 2 & 8\\end{vmatrix}+0\\cdot \\begin{vmatrix}5 & 3 \\\\ 2 & 3\\end{vmatrix}\\right) \\\\  & =\\frac{1}{2}(0+2(5\\cdot 8-2\\cdot 2)+0) \\\\  & =\\frac{1}{2}\\cdot 72 \\\\  & =36\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ad7fbd-daaf-5638-b84c-e71398abac22" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263153} {:answer/id #uuid "1bafca79-f3d5-5d3c-94b1-acb828f5d148" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186263260} {:answer/id #uuid "4cf09706-5715-5579-bf1d-d65287fd8c53" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186263666} {:answer/id #uuid "d4648e08-8d5c-5a1c-9f99-ddecfd09c9a7" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186264849} {:answer/id #uuid "f09fabd2-0746-5418-a46d-e35f208be02e" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186265110}] :answer-field/correct {:db/id #edb/ref 17592186263260} :answer-field/id #uuid "79a1e1f3-7831-5686-8eed-cf31e6adf808" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265451}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "868d3e09-dc03-51a5-9f3e-bb57d096be39" :question/math-academy-id "q-131122" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle W=\\begin{bmatrix}0 & -1 & 0 & 2 \\\\ 0 & 5 & 0 & 1 \\\\ 3 & 2 & 1 & 0 \\\\ 0 & 4 & 3 & 6\\end{bmatrix}.\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(W) & ={w}_{11}{C}_{11}+{w}_{12}{C}_{12}+{w}_{13}{C}_{13}+{w}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+(-1)\\cdot {C}_{12}+0\\cdot {C}_{13}+2\\cdot {C}_{14} \\\\  & =-{C}_{12}+2{C}_{14} \\\\  & =-1\\cdot \\begin{vmatrix}{\\color{lightgray}∗} & {\\color{lightgray}-1} & {\\color{lightgray}∗} & {\\color{lightgray}∗} \\\\ 0 & {\\color{lightgray}∗} & 0 & 1 \\\\ 3 & {\\color{lightgray}∗} & 1 & 0 \\\\ 0 & {\\color{lightgray}∗} & 3 & 6\\end{vmatrix}+2\\cdot \\begin{vmatrix}{\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}2} \\\\ 0 & 5 & 0 & {\\color{lightgray}∗} \\\\ 3 & 2 & 1 & {\\color{lightgray}∗} \\\\ 0 & 4 & 3 & {\\color{lightgray}∗}\\end{vmatrix} \\\\  & =-1\\cdot (-1)^{1+2}\\begin{vmatrix}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{vmatrix}+2\\cdot (-1)^{4+1}\\begin{vmatrix}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{vmatrix}-2\\begin{vmatrix}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}1 & 0 \\\\ 3 & 6\\end{vmatrix}-0\\cdot \\begin{vmatrix}3 & 0 \\\\ 0 & 6\\end{vmatrix}+1\\cdot \\begin{vmatrix}3 & 1 \\\\ 0 & 3\\end{vmatrix}-2\\left(0\\cdot \\begin{vmatrix}2 & 1 \\\\ 4 & 3\\end{vmatrix}-5\\cdot \\begin{vmatrix}3 & 1 \\\\ 0 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}3 & 2 \\\\ 0 & 4\\end{vmatrix}\\right) \\\\  & =9-2\\cdot (-5)\\cdot 9 \\\\  & =9+90 \\\\  & =99\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dfdbbd1-5a22-5fac-b1e2-3afe6c40ce0f" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186263676} {:answer/id #uuid "55f5d0f8-a672-555a-a9fc-13c54562ca11" :answer/type {:db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186263740} {:answer/id #uuid "bdb209a5-aa3e-5b55-a77c-6f8d24ec3380" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186264648} {:answer/id #uuid "eadc0e14-599f-56be-8b29-dcb4146bb189" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186265046} {:answer/id #uuid "f8a8de52-0682-5310-813f-8db91b654bb4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186265177}] :answer-field/correct {:db/id #edb/ref 17592186265046} :answer-field/id #uuid "15c91375-19ab-565d-8c35-c44e7cc346df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265278}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4e01c006-ae42-500a-b8c8-9322bf670a47" :question/math-academy-id "q-131123" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle H=\\begin{bmatrix}0 & 1 & 0 & -1 \\\\ 0 & 3 & 0 & 8 \\\\ 1 & 2 & 1 & 0 \\\\ 0 & 2 & 1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(H) & ={h}_{11}{C}_{11}+{h}_{12}{C}_{12}+{h}_{13}{C}_{13}+{h}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+1\\cdot {C}_{12}+0\\cdot {C}_{13}+(-1)\\cdot {C}_{14} \\\\  & ={C}_{12}-{C}_{14} \\\\  & =1\\cdot \\begin{vmatrix}{\\color{lightgray}∗} & {\\color{lightgray}1} & {\\color{lightgray}∗} & {\\color{lightgray}∗} \\\\ 0 & {\\color{lightgray}∗} & 0 & 8 \\\\ 1 & {\\color{lightgray}∗} & 1 & 0 \\\\ 0 & {\\color{lightgray}∗} & 1 & 2\\end{vmatrix}+(-1)\\cdot \\begin{vmatrix}{\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}∗} & {\\color{lightgray}-1} \\\\ 0 & 3 & 0 & {\\color{lightgray}∗} \\\\ 1 & 2 & 1 & {\\color{lightgray}∗} \\\\ 0 & 2 & 1 & {\\color{lightgray}∗}\\end{vmatrix} \\\\  & =1\\cdot (-1)^{1+2}\\begin{vmatrix}0 & 0 & 8 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 2\\end{vmatrix}+(-1)\\cdot (-1)^{4+1}\\begin{vmatrix}0 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 2 & 1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}0 & 0 & 8 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 2\\end{vmatrix}+\\begin{vmatrix}0 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 2 & 1\\end{vmatrix} \\\\  & =-\\left(0\\cdot \\begin{vmatrix}1 & 0 \\\\ 1 & 2\\end{vmatrix}-0\\cdot \\begin{vmatrix}1 & 0 \\\\ 0 & 2\\end{vmatrix}+8\\cdot \\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix}\\right)+\\left(0\\cdot \\begin{vmatrix}2 & 1 \\\\ 2 & 1\\end{vmatrix}-3\\cdot \\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix}+0\\cdot \\begin{vmatrix}1 & 2 \\\\ 0 & 2\\end{vmatrix}\\right) \\\\  & =8\\cdot (-1)+(-3)\\cdot 1 \\\\  & =-8-3 \\\\  & =-11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45901bed-283a-5f6b-a0e8-c82fb99c77cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186285423} {:answer/id #uuid "590cea1c-0a7c-5f07-8068-694058c3a868" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{44}" :db/id #edb/ref 17592186285603} {:answer/id #uuid "6649b745-668c-5e5d-b83b-1cf253b1e095" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{22}" :db/id #edb/ref 17592186285716} {:answer/id #uuid "d89e0dd4-5791-5cf7-b3cb-314c7f78a09c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{40}" :db/id #edb/ref 17592186286760} {:answer/id #uuid "e7904946-6db5-50df-9602-9962763b4fcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{44}" :db/id #edb/ref 17592186286907}] :answer-field/correct {:db/id #edb/ref 17592186285716} :answer-field/id #uuid "70430d88-1fa4-5196-ac2c-0e31afc80076" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287382}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dc94d59e-a3d1-5387-8338-9ada65b5d11f" :question/math-academy-id "q-18281" :question/problem "Determine the entry ${a}_{21}^{′}$ in the inverse of a matrix $A=\\begin{bmatrix}2 & 4 & 1 \\\\ 0 & 1 & -3 \\\\ -2 & 3 & 0\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}A=\\begin{vmatrix}2 & 4 & 1 \\\\ 0 & 1 & -3 \\\\ -2 & 3 & 0\\end{vmatrix} & =2\\begin{vmatrix}1 & -3 \\\\ 3 & 0\\end{vmatrix}-4\\begin{vmatrix}0 & -3 \\\\ -2 & 0\\end{vmatrix}+1\\begin{vmatrix}0 & 1 \\\\ -2 & 3\\end{vmatrix} \\\\  & =2(0+9)-4(0-6)+1(0+2) \\\\  & =18+24+2 \\\\  & =44.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}0 & -3 \\\\ -2 & 0\\end{vmatrix} \\\\  & =-\\begin{vmatrix}0 & -3 \\\\ -2 & 0\\end{vmatrix} \\\\  & =-(0-6) \\\\  & =6.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′}=\\frac{1}{\\text{det}(A)}{c}_{12}=\\frac{1}{44}\\cdot 6=\\frac{3}{22}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14576e31-28a0-51c9-98e0-cb0e88b08edb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186284968} {:answer/id #uuid "87d3e443-ddd4-51ad-bc3b-642891265441" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186286034} {:answer/id #uuid "a41b5f85-604a-5b3f-adf2-0829d0c2aa47" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286292} {:answer/id #uuid "b5e84826-763e-57fb-8b0f-9e77c3cef0a4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186286446} {:answer/id #uuid "bb4a17fa-acb7-5e63-84dc-98fea7d83242" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186286492}] :answer-field/correct {:db/id #edb/ref 17592186286034} :answer-field/id #uuid "12bcbace-edf5-5ef6-b7b6-ab1e80cb8fbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287180}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b297987-b62d-5714-afb9-ac77feefadc2" :question/math-academy-id "q-18282" :question/problem "Determine the entry ${a}_{12}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}1 & 3 & 1 \\\\ 0 & 2 & 2 \\\\ -1 & 0 & 1\\end{bmatrix}$ if its determinant is $-2.$" :question/worked-solution "Since we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}\\begin{vmatrix}3 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}3 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-(3-0) \\\\  & =-3.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′}=\\frac{1}{\\text{det}(A)}{c}_{21}=\\frac{1}{-2}\\cdot (-3)=\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6942a4fb-bae8-501d-ad2a-66103f54ad63" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186285753} {:answer/id #uuid "7c6dd01f-de8b-5f99-94f9-eab25a4ecb77" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285936} {:answer/id #uuid "82e68463-04bd-50cb-87ed-af0f56c6cae0" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186285988} {:answer/id #uuid "9b48164a-0903-562b-8d03-395f496b0c19" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286211} {:answer/id #uuid "b4e18ab7-2363-5919-84cd-f61b850984a9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186286431}] :answer-field/correct {:db/id #edb/ref 17592186285753} :answer-field/id #uuid "2ed4da02-e9fd-53f8-937f-fdc5a00e81e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287244}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9f46698-54a7-56c6-b512-47750a5ae9a8" :question/math-academy-id "q-18283" :question/problem "Determine the entry ${a}_{13}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}0 & 5 & 1 \\\\ 2 & -1 & 3 \\\\ 2 & 2 & 4\\end{bmatrix}$ if its determinant is $-4.$" :question/worked-solution "Since we want the entry ${a}_{13}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{31}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{31} & =(-1)^{3+1}\\begin{vmatrix}5 & 1 \\\\ -1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 1 \\\\ -1 & 3\\end{vmatrix} \\\\  & =15-(-1) \\\\  & =16.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{13}^{′}=\\frac{1}{\\text{det}(A)}{c}_{31}=\\frac{1}{-4}\\cdot 16=-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e56ee5-4fb6-5816-869f-e39c23a78b4f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186285084} {:answer/id #uuid "3fbf79ad-839a-5229-93e9-65fad5cfd1b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186285385} {:answer/id #uuid "4eb285a6-7afd-5ad8-ab82-98a513400c25" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285520} {:answer/id #uuid "f2cea90f-f0ed-5d57-bca3-334408a81e2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186287013} {:answer/id #uuid "fd525363-2a62-5343-aac2-348e4bfefb7f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186287105}] :answer-field/correct {:db/id #edb/ref 17592186287105} :answer-field/id #uuid "ac120b1e-d324-518f-9e93-f08acaa655f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287500}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "670b2139-910a-54c1-b1cc-9c11eb5fdc1e" :question/math-academy-id "q-18284" :question/problem "Determine the entry ${a}_{22}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}1 & -3 & 0 \\\\ -1 & 0 & 2 \\\\ 0 & 2 & 4\\end{bmatrix}$ if its determinant is $-16.$" :question/worked-solution "Since we want the entry ${a}_{22}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{22}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{22} & =(-1)^{2+2}\\begin{vmatrix}1 & 0 \\\\ 0 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 0 \\\\ 0 & 4\\end{vmatrix} \\\\  & =4-0 \\\\  & =4.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{22}^{′}=\\frac{1}{\\text{det}(A)}{c}_{22}=\\frac{1}{-16}\\cdot 4=-\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f415776-37dc-54e3-9800-2d01e510bf06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186284919} {:answer/id #uuid "60a2a07e-a39e-5566-8bba-7375b15d76ec" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285675} {:answer/id #uuid "7595df60-c82c-590b-b868-221b7368f2ba" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186285879} {:answer/id #uuid "a0ab4c0e-9b0e-5237-9348-d4be45093c5a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286252} {:answer/id #uuid "f133bf14-3c6d-5286-a6d1-bf00852e4721" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186287001}] :answer-field/correct {:db/id #edb/ref 17592186286252} :answer-field/id #uuid "baa7a81a-d6ae-5365-9fa0-1142a694af59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287534}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5cade28-be41-57ee-910f-46e652127d0c" :question/math-academy-id "q-18285" :question/problem "Determine the entry ${a}_{31}^{′}$ in the inverse of a matrix $A=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=\\begin{vmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{vmatrix} & =0\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}-0\\begin{vmatrix}0 & 0 \\\\ 2 & 1\\end{vmatrix}+1\\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix} \\\\  & =0-0+(0-2) \\\\  & =-2.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{31}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}\\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix} \\\\  & =0-2 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′}=\\frac{1}{\\text{det}(A)}{c}_{13}=\\frac{1}{-2}\\cdot (-2)=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232327fd-1dfa-5996-8e84-95bb6a9f8cc3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11}{39}" :db/id #edb/ref 17592186285103} {:answer/id #uuid "c4f41583-27a2-56ac-9a18-17faf2b31721" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186286592} {:answer/id #uuid "c776e656-4613-5245-90ac-bb7e8e9dd6d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{13}" :db/id #edb/ref 17592186286614} {:answer/id #uuid "d31191b1-ed1c-5824-a66f-2602858ec4ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{39}" :db/id #edb/ref 17592186286707} {:answer/id #uuid "ef342a1d-6164-5836-994c-98cb5484b941" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{39}" :db/id #edb/ref 17592186286982}] :answer-field/correct {:db/id #edb/ref 17592186286707} :answer-field/id #uuid "7c346e23-1fbd-5f16-925c-878fb4d2e5f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287408}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dcb03ff4-bc8a-5928-846f-20e56388fdb2" :question/math-academy-id "q-18286" :question/problem "Determine the entry ${a}_{32}^{′}$ in the inverse of the matrix $A$ $=\\begin{bmatrix}1 & 4 & -1 \\\\ -3 & 2 & 0 \\\\ 0 & -1 & 3\\end{bmatrix}$ if its determinant is $39.$" :question/worked-solution "Since we want the entry ${a}_{32}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{23}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{23} & =(-1)^{2+3}\\begin{vmatrix}1 & 4 \\\\ 0 & -1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}1 & 4 \\\\ 0 & -1\\end{vmatrix} \\\\  & =-(-1-0) \\\\  & =1.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{32}^{′}=\\frac{1}{\\text{det}(A)}{c}_{23}=\\frac{1}{39}\\cdot 1=\\frac{1}{39}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06123fff-7c78-51f2-81b7-d35d5c15b5e0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186284836} {:answer/id #uuid "11d094be-9dc7-5405-8cce-9907e9c51654" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186284945} {:answer/id #uuid "3c9cbbbd-12e1-5cce-8786-a3ceed193971" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186285356} {:answer/id #uuid "ab1a2f27-2e9e-5b7f-a874-29bebc8a2d4f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{24}" :db/id #edb/ref 17592186286347} {:answer/id #uuid "b72dc0b0-3001-5783-b493-cbb1bcd44dc0" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186286459}] :answer-field/correct {:db/id #edb/ref 17592186284836} :answer-field/id #uuid "1c45b83d-dd3d-58f3-83e0-2b583f24f687" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287206}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35c43087-68b2-5ef3-b590-6196109cdd18" :question/math-academy-id "q-18287" :question/problem "Determine the entry ${a}_{13}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}8 & 4 & 0 \\\\ 4 & 2 & 6 \\\\ 1 & 0 & 2\\end{bmatrix}$ if its determinant is $24.$" :question/worked-solution "Since we want the entry ${a}_{13}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{31}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{31} & =(-1)^{3+1}\\begin{vmatrix}4 & 0 \\\\ 2 & 6\\end{vmatrix} \\\\  & =\\begin{vmatrix}4 & 0 \\\\ 2 & 6\\end{vmatrix} \\\\  & =24-0 \\\\  & =24.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{13}^{′}=\\frac{1}{\\text{det}(A)}{c}_{31}=\\frac{1}{24}\\cdot 24=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aba01f9-7f51-5a8f-a7a8-dc4fa8fb483a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{71}" :db/id #edb/ref 17592186285161} {:answer/id #uuid "51897cf6-89ff-547a-a77d-fb4c229f6e36" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{10}{71}" :db/id #edb/ref 17592186285537} {:answer/id #uuid "83757217-5865-5baa-8ad8-1b2c54dde4ef" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{71}" :db/id #edb/ref 17592186285995} {:answer/id #uuid "c1f44981-7ac4-5b60-aa71-18f4807ae1be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{71}" :db/id #edb/ref 17592186286563} {:answer/id #uuid "f5e75515-8616-5fe3-a6a1-8dc2e1fa3a3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{71}" :db/id #edb/ref 17592186287038}] :answer-field/correct {:db/id #edb/ref 17592186286563} :answer-field/id #uuid "909dfb56-2abf-58f1-9f5d-3fcdb81ce8b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287447}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b862f7e3-dfeb-537e-b5d6-1de6a752faf3" :question/math-academy-id "q-18288" :question/problem "Determine the entry ${a}_{21}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}2 & 5 & -3 \\\\ -1 & 0 & 2 \\\\ 5 & -6 & 3\\end{bmatrix}$ if its determinant is $71.$" :question/worked-solution "Since we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}-1 & 2 \\\\ 5 & 3\\end{vmatrix} \\\\  & =-\\begin{vmatrix}-1 & 2 \\\\ 5 & 3\\end{vmatrix} \\\\  & =-(-3-10) \\\\  & =13.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′}=\\frac{1}{\\text{det}(A)}{c}_{12}=\\frac{1}{71}\\cdot 13=\\frac{13}{71}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ea5ce6-ddda-5579-a684-d25f1058ba21" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186291202}] :answer-field/correct {:db/id #edb/ref 17592186291202} :answer-field/id #uuid "37543ffb-2c43-58fb-b8f8-ec6390531c18" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291916} {:answer-field/choices [{:answer/id #uuid "5e68dafa-a528-5425-b437-aef1cfe308b1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291035}] :answer-field/correct {:db/id #edb/ref 17592186291035} :answer-field/id #uuid "d0da29d0-45c3-5185-ae2d-49709322be04" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292367} {:answer-field/choices [{:answer/id #uuid "0b91bb20-bc8d-5241-9f91-00fa694c64e0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186290688}] :answer-field/correct {:db/id #edb/ref 17592186290688} :answer-field/id #uuid "e298cd73-8828-57b4-8bf2-f0f5222a8ea9" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292439} {:answer-field/choices [{:answer/id #uuid "49aee00a-74f6-5575-b7e9-6aed820fbfa2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186290936}] :answer-field/correct {:db/id #edb/ref 17592186290936} :answer-field/id #uuid "f771b189-a202-540f-9ad3-94aa036d9d1c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292509}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a396b1e-6a9c-5212-b41d-2db22ab00f92" :question/math-academy-id "q-275612" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-4y+3x &=8 \\\\ 2x &=-3,\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>$2$</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$8$</td></tr>\n<tr><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, we organize the system so that it is in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}3x-4y &=8 \\\\ 2x+0y &=-3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -4 \\\\ 2 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}8 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -4 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}8 \\\\ -3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186292883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fba74c9-a43c-555d-83a0-5e97204b4777" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186291171}] :answer-field/correct {:db/id #edb/ref 17592186291171} :answer-field/id #uuid "ea8202f6-c433-5f73-acb4-de5dcc90eb03" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292470}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2f93a0ad-99aa-54d9-bd35-c1d6b3dc5f05" :question/math-academy-id "q-275738" :question/problem "If $B=\\begin{bmatrix}x-5 & x+3 \\\\ 2 & -3\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(x-5)\\cdot (-3)-2\\cdot (x+3) \\\\  & =-3x+15-2x-6 \\\\  & =-5x+9.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-5x+9 & =0 \\\\ -5x & =-9 \\\\ x & =\\frac{9}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ed7a213-aacc-56d2-9779-25fff16d3e85" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186290969}] :answer-field/correct {:db/id #edb/ref 17592186290969} :answer-field/id #uuid "b7851796-9230-52fb-8a26-b3ea3a329032" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292298}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "30ba35b5-5f35-540d-9096-c30d7199aaa4" :question/math-academy-id "q-275755" :question/problem "Determine the entry ${a}_{32}^{′}$ in the inverse of a matrix \n$$\n\\displaystyle A=\\begin{bmatrix}3 & 0 & -3 \\\\ 1 & -1 & -1 \\\\ 0 & 2 & -2\\end{bmatrix}.\n$$\n\n${a}_{32}^{′}=$\n{{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=\\begin{vmatrix}3 & 0 & -3 \\\\ 1 & -1 & -1 \\\\ 0 & 2 & -2\\end{vmatrix} & =3\\begin{vmatrix}-1 & -1 \\\\ 2 & -2\\end{vmatrix}-0\\begin{vmatrix}1 & -1 \\\\ 0 & -2\\end{vmatrix}+(-3)\\begin{vmatrix}1 & -1 \\\\ 0 & 2\\end{vmatrix} \\\\  & =3(2+2)-0-3(2-0) \\\\  & =6.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{32}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{32}^{t}={c}_{23}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{23} & =(-1)^{2+3}\\begin{vmatrix}3 & 0 \\\\ 0 & 2\\end{vmatrix} \\\\  & =-\\begin{vmatrix}3 & 0 \\\\ 0 & 2\\end{vmatrix} \\\\  & =-(6-0) \\\\  & =-6.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{32}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{32}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{23} \\\\  & =\\frac{1}{6}\\cdot (-6) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0032ffbe-ef0e-59aa-b26f-1bbc10e77544" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186290634}] :answer-field/correct {:db/id #edb/ref 17592186290634} :answer-field/id #uuid "84f92a9c-0b0f-5450-99ed-3b1e0df3d706" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292148}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a90f7ea-2f5b-53dd-b349-fa9148f654dc" :question/math-academy-id "q-275756" :question/problem "The entry ${a}_{12}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 0 & -1 \\\\ 1 & -1 & -1 \\\\ 0 & 1 & k\\end{bmatrix}\n$$\nequals $-\\frac{1}{2}$ and $det(A)=-k.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=-k\n$$\n\nSince we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}^{t}={c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}\\begin{vmatrix}0 & -1 \\\\ 1 & k\\end{vmatrix} \\\\  & =-\\begin{vmatrix}0 & -1 \\\\ 1 & k\\end{vmatrix} \\\\  & =-(0+1) \\\\  & =-1\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{12}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{21} \\\\  & =\\frac{1}{(-k)}\\cdot (-1) \\\\  & =\\frac{1}{k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{12}^{′}=-\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k} & =-\\frac{1}{2} \\\\ k & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dd1446d-3318-52d7-b8ca-ff5fb69db2c9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291032}] :answer-field/correct {:db/id #edb/ref 17592186291032} :answer-field/id #uuid "e08c8940-8a05-58bf-bed8-cc4535359cbf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292434}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3b033d4e-fbed-55f2-bf1a-00675137d39e" :question/math-academy-id "q-275757" :question/problem "The entry ${a}_{13}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & -1 & -1 \\\\ 2 & k & -2\\end{bmatrix}\n$$\nequals $-1.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}1 & 1 & -1 \\\\ 2 & -1 & -1 \\\\ 2 & k & -2\\end{vmatrix} & =1\\begin{vmatrix}-1 & -1 \\\\ k & -2\\end{vmatrix}-1\\begin{vmatrix}2 & -1 \\\\ 2 & -2\\end{vmatrix}+(-1)\\begin{vmatrix}2 & -1 \\\\ 2 & k\\end{vmatrix} \\\\  & =(2+k)-(-4+2)-(2k+2) \\\\  & =2+k+2-2k-2 \\\\  & =2-k.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{13}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}^{t}={c}_{31}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{31} & =(-1)^{3+1}\\begin{vmatrix}1 & -1 \\\\ -1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ -1 & -1\\end{vmatrix} \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{13}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{13}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{31} \\\\  & =\\frac{1}{2-k}\\cdot (-2) \\\\  & =\\frac{2}{k-2}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{13}^{′}=-1$, we have\n\n$$\n\\begin{aligned}\\frac{2}{k-2} & =-1 \\\\ -1\\cdot (k-2) & =2 \\\\ k-2 & =-2 \\\\ k & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f094e6ec-5f6f-5194-9357-eb5f114fc97a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296547}] :answer-field/correct {:db/id #edb/ref 17592186296547} :answer-field/id #uuid "3a06ad97-49ee-5366-b8f2-4bd5dbd655a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296744} {:answer-field/choices [{:answer/id #uuid "3c475049-0b34-568a-8379-75689981b1cf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295611}] :answer-field/correct {:db/id #edb/ref 17592186295611} :answer-field/id #uuid "58394d53-5ee7-54cb-8c01-d51839d9b8d0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296813}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8e1210d-36f7-5324-a441-3fe5324d9d56" :question/math-academy-id "q-313957" :question/problem "Let $B=\\begin{bmatrix}x-4 & 1 \\\\ 7 & x+2\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(x-4)\\cdot (x+2)-7\\cdot 1 \\\\  & ={x}^{2}-2x-8-7 \\\\  & ={x}^{2}-2x-15.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-2x-15 & =0 \\\\ (x+3)(x-5) & =0 \\\\ x & =-3,5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-3\\,\\text{and}\\,x=5.\n$$"}] [{:db/id #edb/ref 17592186297543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "774f2323-67ac-5cdc-be84-7c83c08e1d31" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295917}] :answer-field/correct {:db/id #edb/ref 17592186295917} :answer-field/id #uuid "2a818b40-3c97-5c91-bfcb-9784b9054765" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296716} {:answer-field/choices [{:answer/id #uuid "690f3afb-ceb8-5b8e-bb3e-5cad6f4dfb7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186295857}] :answer-field/correct {:db/id #edb/ref 17592186295857} :answer-field/id #uuid "2d4a0345-1cd9-58bc-a954-d45105626bff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296719} {:answer-field/choices [{:answer/id #uuid "f5743304-7d60-5006-a86f-7e14ddb7f705" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186296570}] :answer-field/correct {:db/id #edb/ref 17592186296570} :answer-field/id #uuid "e3a534a3-319d-5a0d-ba11-55a736a3ca56" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297105}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5afec83f-c01d-57b0-a129-7a451b173c66" :question/math-academy-id "q-316753" :question/problem "Calculate ${A}^{-1},$ where\n$$\n\\displaystyle A=\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$-2$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=(-6)\\cdot 2-3\\cdot (-5)=3\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ -(-5) & -6\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ 5 & -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix}\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {A}^{-1}A & =\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix}\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f66079f-8a13-5f2d-b31c-0226934fa120" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186295881}] :answer-field/correct {:db/id #edb/ref 17592186295881} :answer-field/id #uuid "2471fbb6-4020-556f-a24a-22a1c2f5e2a0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296698} {:answer-field/choices [{:answer/id #uuid "0e7b5b59-0ba4-5602-87fc-1603751e6151" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295353}] :answer-field/correct {:db/id #edb/ref 17592186295353} :answer-field/id #uuid "7d537624-30b3-5cb7-b8f0-e8594a47571a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296889} {:answer-field/choices [{:answer/id #uuid "64863451-c3cd-5629-ac5b-993b0bd3afb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186295839}] :answer-field/correct {:db/id #edb/ref 17592186295839} :answer-field/id #uuid "d1ddbf64-a9bc-5822-9543-9eb5227576a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c5d479a-db20-5ea3-ab0e-6622e81ae62c" :question/math-academy-id "q-316768" :question/problem "Calculate ${A}^{-1},$ where\n$$\n\\displaystyle A=\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$0$</td></tr>\n<tr><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=5\\cdot (-2)-0\\cdot 0=-10\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{-10}\\begin{bmatrix}-2 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1/5 & 0 \\\\ 0 & -1/2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}1/5 & 0 \\\\ 0 & -1/2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {A}^{-1}A & =\\begin{bmatrix}1/5 & 0 \\\\ 0 & -1/2\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ff1b0a9-fde2-5367-87f0-bb860645334c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186298176}] :answer-field/correct {:db/id #edb/ref 17592186298176} :answer-field/id #uuid "588ee9fc-b1ad-590a-902a-aa67ff051060" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298940} {:answer-field/choices [{:answer/id #uuid "4e235848-7d84-5c03-8f30-0fd2297b7d8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186297879}] :answer-field/correct {:db/id #edb/ref 17592186297879} :answer-field/id #uuid "98cadb3e-fd34-5d08-9dd7-982a5a1572bf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299143} {:answer-field/choices [{:answer/id #uuid "a55fb1b2-3b16-5c94-9d74-cc1c7a144fb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186298278}] :answer-field/correct {:db/id #edb/ref 17592186298278} :answer-field/id #uuid "e519f8fb-61e9-5c0d-a5e4-7091ce4b87b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2eafafcb-8727-5ab6-b75d-030156359000" :question/math-academy-id "q-316780" :question/problem "Calculate ${A}^{-1},$ where\n$$\n\\displaystyle A=\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$-\\frac{1}{2}$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=6\\cdot 1-2\\cdot 9=-12\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{-12}\\begin{bmatrix}1 & -2 \\\\ -9 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix}\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {A}^{-1}A & =\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix}\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b2c8819-78f4-5fff-bc17-cec5c19efd38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186298086}] :answer-field/correct {:db/id #edb/ref 17592186298086} :answer-field/id #uuid "b790ef95-1954-53e9-951c-93434ba44d92" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299257}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95d2a0a0-79cd-50d5-95db-d0f4cfda76fd" :question/math-academy-id "q-316781" :question/problem "If $B=\\begin{bmatrix}2x & 5x-1 \\\\ 4 & -2\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x)\\cdot (-2)-4\\cdot (5x-1) \\\\  & =-4x+4-20x \\\\  & =-24x+4.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-24x+4 & =0 \\\\ 24x & =4 \\\\ x & =\\frac{4}{24} \\\\ x & =\\frac{1}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "892579b6-7828-5a0d-ab85-d5b77ff9a388" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298147}] :answer-field/correct {:db/id #edb/ref 17592186298147} :answer-field/id #uuid "e05f6368-cb27-51a1-9aa0-8c61326772fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299398}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e69fc32-4426-5cb8-9829-2fc1f8cd28fb" :question/math-academy-id "q-316782" :question/problem "If $B=\\begin{bmatrix}1 & 2 \\\\ 3x+2 & 2x-4\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =1\\cdot (2x-4)-2\\cdot (3x+2) \\\\  & =2x-4-6x-4 \\\\  & =-4x-8.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-4x-8 & =0 \\\\ -4x & =8 \\\\ x & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f65bbf81-a8fe-5107-aa3e-22d11d717c75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186298604}] :answer-field/correct {:db/id #edb/ref 17592186298604} :answer-field/id #uuid "635dc510-988f-5cfd-b2b9-b02500ed4e94" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298971}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a90dc1ce-cf3a-57f1-9a32-63fe824c4a01" :question/math-academy-id "q-316783" :question/problem "If $B=\\begin{bmatrix}5x & -1 \\\\ 6x-8 & 2\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(5x)\\cdot 2-(-1)\\cdot (6x-8) \\\\  & =10x+6x-8 \\\\  & =16x-8.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}16x-8 & =0 \\\\ 16x & =8 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c35d1a75-f277-5a94-961c-420517cab2dc" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186298410}] :answer-field/correct {:db/id #edb/ref 17592186298410} :answer-field/id #uuid "7ee21428-abe9-5f94-b753-8373c581c767" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299065}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1bc74342-0f37-5e04-9085-a552735d6bba" :question/math-academy-id "q-316784" :question/problem "If $B=\\begin{bmatrix}-3 & -x+1 \\\\ 5 & 2x+7\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(-3)\\cdot (2x+7)-5\\cdot (-x+1) \\\\  & =-6x-21+5x-5 \\\\  & =-x-26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-x-26 & =0 \\\\ -x & =26 \\\\ x & =-26\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cca41b-96b6-5473-9aca-86b0db2b84ed" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{9}" :db/id #edb/ref 17592186297576}] :answer-field/correct {:db/id #edb/ref 17592186297576} :answer-field/id #uuid "32d3dd1b-e2db-5caf-ae0b-809e4a9c8547" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298811}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d52bc53-4740-5cbf-85a5-c4eda2c297f6" :question/math-academy-id "q-316785" :question/problem "If $B=\\begin{bmatrix}4 & -2 \\\\ 7x-3 & x+8\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =4\\cdot (x+8)-(-2)\\cdot (7x-3) \\\\  & =4x+32+14x-6 \\\\  & =18x+26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}18x+26 & =0 \\\\ 18x & =-26 \\\\ x & =-\\frac{13}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629ba2fb-f7a0-55ec-8318-3a578b3a696d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297974}] :answer-field/correct {:db/id #edb/ref 17592186297974} :answer-field/id #uuid "0facb49d-44d7-596b-8283-cf6ecd88d19e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298692} {:answer-field/choices [{:answer/id #uuid "b84a7230-bf17-5af7-b714-634c6fe7a61b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298353}] :answer-field/correct {:db/id #edb/ref 17592186298353} :answer-field/id #uuid "2558d65a-fb7e-502b-9124-c77726154021" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298762}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "113042b9-3913-565d-9ff6-26aa252c490f" :question/math-academy-id "q-316825" :question/problem "Let $B=\\begin{bmatrix}2x+4 & 0 \\\\ 15 & -x-3\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x+4)\\cdot (-x-3)-0\\cdot 15 \\\\  & =-2{x}^{2}-6x-4x-12 \\\\  & =-2{x}^{2}-10x-12.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-2{x}^{2}-10x-12 & =0 \\\\ -2({x}^{2}+5x+6) & =0 \\\\ (x+3)(x+2) & =0 \\\\ x & =-3,-2\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-3\\,\\text{and}\\,x=-2.\n$$"}] [{:db/id #edb/ref 17592186299507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5366c8ee-0f20-52a8-af0d-6262c3e3a64d" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186297903}] :answer-field/correct {:db/id #edb/ref 17592186297903} :answer-field/id #uuid "0d33276a-59ca-5611-8a71-d122c8fe1aa8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298680} {:answer-field/choices [{:answer/id #uuid "08d68a03-e244-5376-9981-66b7a4ebd931" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297599}] :answer-field/correct {:db/id #edb/ref 17592186297599} :answer-field/id #uuid "1ef19e34-416f-58ea-9adf-3a70138385ab" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a81a924-c8d9-5da7-9d7c-338e9d3bb52d" :question/math-academy-id "q-316828" :question/problem "Let $B=\\begin{bmatrix}2x+1 & x-40 \\\\ 1 & -x\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x+1)\\cdot (-x)-(x-40)\\cdot 1 \\\\  & =-2{x}^{2}-x-x+40 \\\\  & =-2{x}^{2}-2x+40.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-2{x}^{2}-2x+40 & =0 \\\\ -2({x}^{2}+x-20) & =0 \\\\ -2(x-4)(x+5) & =0 \\\\ x & =4,-5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-5\\,\\text{and}\\,x=4.\n$$"}] [{:db/id #edb/ref 17592186299508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd68271a-9473-595e-b5cc-3fdbfc5ed8a8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298378}] :answer-field/correct {:db/id #edb/ref 17592186298378} :answer-field/id #uuid "91c07df3-718b-531d-bfd7-b454f78a656b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299118} {:answer-field/choices [{:answer/id #uuid "0ab82d06-28db-5541-b1f2-29ddc998b877" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186297608}] :answer-field/correct {:db/id #edb/ref 17592186297608} :answer-field/id #uuid "e11d6092-7929-53ab-a1f3-28dc7122ce6a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299403}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6886658-7f8f-54c1-b88e-4ea7a22c6205" :question/math-academy-id "q-316829" :question/problem "Let $B=\\begin{bmatrix}3 & -x+7 \\\\ x-5 & 0\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =3\\cdot 0-(-x+7)\\cdot (x-5) \\\\  & ={x}^{2}-5x-7x+35 \\\\  & ={x}^{2}-12x+35.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-12x+35 & =0 \\\\ (x-7)(x-5) & =0 \\\\ x & =7,5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=5\\,\\text{and}\\,x=7.\n$$"}] [{:db/id #edb/ref 17592186299608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5799816e-9719-5798-9c9a-f732bf85395d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297918}] :answer-field/correct {:db/id #edb/ref 17592186297918} :answer-field/id #uuid "8e09e8b7-c1e7-5293-a3b0-a64b67e11230" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299109} {:answer-field/choices [{:answer/id #uuid "054e6b51-eb57-5c1b-9a70-ba76b85003af" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297579}] :answer-field/correct {:db/id #edb/ref 17592186297579} :answer-field/id #uuid "dd3c78a5-7d86-5214-885d-4d4a59a37dad" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299387} {:answer-field/choices [{:answer/id #uuid "f5e7828e-dd01-5831-b8b3-7a3d04ee5c37" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298600}] :answer-field/correct {:db/id #edb/ref 17592186298600} :answer-field/id #uuid "dd64cf6f-11f6-5ef3-91fd-c592d03e9ba6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299388} {:answer-field/choices [{:answer/id #uuid "2a47bed5-86bf-5575-a6f3-62dc7b99c50b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186297729}] :answer-field/correct {:db/id #edb/ref 17592186297729} :answer-field/id #uuid "f1cfb69b-e49e-559e-828c-651dc0c48b86" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299450}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c61272a7-8421-5bdb-8693-8d42ca9c2c67" :question/math-academy-id "q-317494" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-3x+4y &=10 \\\\ 5x+2y &=-7,\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$4$</td></tr>\n<tr><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-4}}</td></tr>\n<tr><td>$-7$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, notice that both $x$ and $y$ appear in each equation, all the variables are on the left-hand side, and all the constants are on the right-hand side.\n\n$$\n\\left\\{\\begin{aligned}-3x+4y &=10 \\\\ 5x+2y &=-7\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-3 & 4 \\\\ 5 & 2\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}10 \\\\ -7\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-3 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}10 \\\\ -7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb708238-1c4f-5e19-b952-7a1cae1199fc" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298437}] :answer-field/correct {:db/id #edb/ref 17592186298437} :answer-field/id #uuid "10c56e2f-c0ae-54bc-ae0e-78956ef2054b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298696} {:answer-field/choices [{:answer/id #uuid "0ffca954-c164-5a2e-875b-0abd28c1ee63" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186297624}] :answer-field/correct {:db/id #edb/ref 17592186297624} :answer-field/id #uuid "16089658-2d6e-598a-a69c-59786030f56b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298719} {:answer-field/choices [{:answer/id #uuid "c1e3aeae-9a20-54b1-bcf6-e179312cdfb3" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298403}] :answer-field/correct {:db/id #edb/ref 17592186298403} :answer-field/id #uuid "34d2db7f-f2fc-551e-be82-e24ba81e7a71" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298818} {:answer-field/choices [{:answer/id #uuid "161f1e5b-bf46-5ca1-8193-7dc4c1f6d8c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297647}] :answer-field/correct {:db/id #edb/ref 17592186297647} :answer-field/id #uuid "34e53f1f-5449-539f-a271-070f9a7b60cd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298819}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d8d92f30-ed38-54b4-8a62-755656e16597" :question/math-academy-id "q-317500" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-6y &=4 \\\\ 3x+5y\\, &=-7\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$5$</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$4$</td></tr>\n<tr><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. \nThe variable $x$ does not appear in the first equation, but this just means its coefficient is $0.$ So, we get\n\n$$\n\\left\\{\\begin{aligned}0x-6y &=4 \\\\ 3x+5y\\, &=-7\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & -6 \\\\ 3 & 5\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & -6 \\\\ 3 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fc1c30-8ccd-5457-8993-f07f475f8013" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186298415}] :answer-field/correct {:db/id #edb/ref 17592186298415} :answer-field/id #uuid "2477b178-6307-5735-b558-7b5c6e62c0a0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298760} {:answer-field/choices [{:answer/id #uuid "0ab496cc-788e-5652-89d7-f96603cd8005" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297607}] :answer-field/correct {:db/id #edb/ref 17592186297607} :answer-field/id #uuid "63b918f7-22b3-5376-aaa2-00533d549ab7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298973} {:answer-field/choices [{:answer/id #uuid "de44a703-88c3-5e8d-8c8b-9b29522c0607" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298503}] :answer-field/correct {:db/id #edb/ref 17592186298503} :answer-field/id #uuid "ac49caa6-1aec-575c-9de6-24bb4b87c1ed" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299219} {:answer-field/choices [{:answer/id #uuid "0dd7d52a-dd21-5b39-8a68-a746df7cf693" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186297618}] :answer-field/correct {:db/id #edb/ref 17592186297618} :answer-field/id #uuid "fcafb9f8-b362-5db3-8bd7-958e6228521a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11e074c7-4d99-5668-b58b-9eacc1e24ba9" :question/math-academy-id "q-317506" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-5x &=10 \\\\ 4y &=-12\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$4$</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$10$</td></tr>\n<tr><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $y$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $x$ does not appear in the second equation, which means that its coefficient is $0$ too. \n\nSo, we get\n\n$$\n\\left\\{\\begin{aligned}-5x+0y &=10 \\\\ 0x+4y &=-12\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-5 & 0 \\\\ 0 & 4\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-5 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022e6234-3d4c-5534-b14b-8dd9bdb81787" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297569}] :answer-field/correct {:db/id #edb/ref 17592186297569} :answer-field/id #uuid "0f39389f-6cf5-5175-93ea-d9025fc2b1cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298691} {:answer-field/choices [{:answer/id #uuid "4281dc0a-fa1a-57fe-ba5e-0b198d0f04b9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297821}] :answer-field/correct {:db/id #edb/ref 17592186297821} :answer-field/id #uuid "3dce52a6-e1fb-505d-861e-fa03455f8a83" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298850} {:answer-field/choices [{:answer/id #uuid "0883bef8-8eee-57db-b571-055f27f66e49" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297595}] :answer-field/correct {:db/id #edb/ref 17592186297595} :answer-field/id #uuid "8025cb60-b66f-58f5-b1d5-18ece79bb38f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299071} {:answer-field/choices [{:answer/id #uuid "81b901a4-7191-5ebd-8fd0-4d4f97fb1ca3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298110}] :answer-field/correct {:db/id #edb/ref 17592186298110} :answer-field/id #uuid "ce2a2be0-b727-52ee-be2a-d935cb92e54a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299327}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d45db123-306d-57eb-b5b7-bb39126a8f2b" :question/math-academy-id "q-317517" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}8y &=-8 \\\\ -4x &=7\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$8$</td></tr>\n<tr><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-4}}</td></tr>\n<tr><td>$7$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation.\n\nThe variable $x$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $y$ does not appear in the second equation, which means that its coefficient is $0$ too. So, we get\n\n$$\n\\left\\{\\begin{aligned}0x+8y &=-8 \\\\ -4x+0y &=7\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & 8 \\\\ -4 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-8 \\\\ 7\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & 8 \\\\ -4 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ 7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299615 :question/answer-fields [{:answer-field/choices [{:answer/id #uu