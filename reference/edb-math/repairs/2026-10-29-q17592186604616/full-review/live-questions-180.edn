#{[{:db/id #edb/ref 17592186571408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac68f12-2312-545a-8955-97b0d65f236d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571035} {:answer/id #uuid "8d105c7c-f6d4-5e71-9c7c-4dc0c9b642d8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 5 & 2 \\\\ 5 & 0 & 2 \\\\ -5 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186571110} {:answer/id #uuid "c32a0d09-0b2d-5a3b-9258-984ea01ca297" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571191} {:answer/id #uuid "c4808a90-10c0-5c25-923b-83c194b3406e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & 5 & 2 \\\\ 5 & 0 & 2 \\\\ -5 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186571196} {:answer/id #uuid "d4adf8be-5589-54a4-9376-a8eed3ab727e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 2 & 0 \\\\ 6 & -2 & 8 \\\\ 3 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571219}] :answer-field/correct {:db/id #edb/ref 17592186571191} :answer-field/id #uuid "a2272371-24d5-5f31-83e4-a4207fd7fa8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571345}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64da2690-5503-52bf-8b2b-4188c9d74be7" :question/math-academy-id "q-71016" :question/problem "Find the cofactor of ${x}_{32}$ in \n$$\n\\displaystyle X=\\begin{bmatrix}0 & 5 & 2 & 3 \\\\ 5 & 0 & 2 & 0 \\\\ -5 & 6 & -2 & 8 \\\\ -6 & 3 & 1 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, to get the minor of ${x}_{32}$, we remove the $3$rd row and $2$nd column: \n\n$$\nX=\\begin{bmatrix}0 & ∗ & 2 & 3 \\\\ 5 & ∗ & 2 & 0 \\\\ ∗ & 6 & ∗ & ∗ \\\\ -6 & ∗ & 1 & 0\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{32}=\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}\n$$\n\n  \n\nTherefore, the cofactor of ${x}_{32}$ is\n\n$$\n\\begin{aligned}{C}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =-{M}_{32} \\\\  & =-\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2df5fbd1-0fa9-566e-9409-3005b855a70e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}1 & 2 & -7 & 0 \\\\ 11 & 5 & 4 & 3 \\\\ 0 & -5 & 0 & 8 \\\\ 5 & 3 & -6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186570960} {:answer/id #uuid "42dcdfd6-3ca8-535d-894d-a222382ef22c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}7 & 0 & -3 & 8 \\\\ 1 & 2 & -7 & 0 \\\\ 11 & 5 & 4 & 3 \\\\ 0 & -5 & 0 & 8\\end{vmatrix}" :db/id #edb/ref 17592186570991} {:answer/id #uuid "63b59635-ce7e-59f1-9aa6-87acd25161ab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}1 & 2 & -7 & 0 \\\\ 11 & 5 & 4 & 3 \\\\ 0 & -5 & 0 & 8 \\\\ 5 & 3 & -6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571045} {:answer/id #uuid "6896d360-39e5-5896-94e3-99aecdc23bb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & -3 & 8 & 5 \\\\ 2 & -7 & 0 & 0 \\\\ 5 & 4 & 3 & -2 \\\\ -5 & 0 & 8 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571054} {:answer/id #uuid "9fca4361-6fb9-56f4-968e-a8721362befb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & -3 & 8 & 5 \\\\ 2 & -7 & 0 & 0 \\\\ 5 & 4 & 3 & -2 \\\\ -5 & 0 & 8 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571137}] :answer-field/correct {:db/id #edb/ref 17592186570960} :answer-field/id #uuid "d51a2c81-3602-58d3-84ef-37d289d6883b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571361}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82c9b97c-e98d-52ee-a188-94feebd68b47" :question/math-academy-id "q-36091" :question/problem "Find the minor of  ${e}_{15}$ in  $$\n\\displaystyle E=\\begin{bmatrix}7 & 0 & -3 & 8 & 5 \\\\ 1 & 2 & -7 & 0 & 0 \\\\ 11 & 5 & 4 & 3 & -2 \\\\ 0 & -5 & 0 & 8 & 0 \\\\ 5 & 3 & -6 & 0 & 7\\end{bmatrix}.\n$$" :question/worked-solution "To get the minor of ${e}_{15}$, we remove the $1$st row and $5$th column:\n\n$$\nE=\\begin{bmatrix}∗ & ∗ & ∗ & ∗ & 5 \\\\ 1 & 2 & -7 & 0 & ∗ \\\\ 11 & 5 & 4 & 3 & ∗ \\\\ 0 & -5 & 0 & 8 & ∗ \\\\ 5 & 3 & -6 & 0 & ∗\\end{bmatrix}\n$$\n\n \n\nSo, the minor is\n\n$$\n{M}_{15}=\\begin{vmatrix}1 & 2 & -7 & 0 \\\\ 11 & 5 & 4 & 3 \\\\ 0 & -5 & 0 & 8 \\\\ 5 & 3 & -6 & 0\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186571443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c409eaf-a88b-52d0-93e4-e06a7fbd8275" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186570931} {:answer/id #uuid "460aef30-08cb-5a20-8328-3ae1a8f946cb" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186571000} {:answer/id #uuid "929a7047-4cab-559a-b902-fb43e8ec1d1d" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186571119} {:answer/id #uuid "e1597bd3-5f9c-5dd4-9a8d-382a63c04f0f" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186571237} {:answer/id #uuid "f7b70f72-82d4-57c3-b86c-4d54f9b46376" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186571267}] :answer-field/correct {:db/id #edb/ref 17592186571000} :answer-field/id #uuid "cfe34648-d2b0-538a-b862-47f017b7fd97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571357}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d888b8b4-33e2-5465-96a7-f2cf43e527f2" :question/math-academy-id "q-32746" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle W=\\begin{bmatrix}1 & 0 & 5 & 0 \\\\ 2 & 0 & 0 & 0 \\\\ -1 & 3 & 0 & 4 \\\\ 8 & 0 & 1 & -2\\end{bmatrix}.\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(W) & ={w}_{11}{C}_{11}+{w}_{12}{C}_{12}+{w}_{13}{C}_{13}+{w}_{14}{C}_{14} \\\\  & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+5\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & ={C}_{11}+5{C}_{13} \\\\  & =1\\cdot \\begin{vmatrix}1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 0 & 0 \\\\ ∗ & 3 & 0 & 4 \\\\ ∗ & 0 & 1 & -2\\end{vmatrix}+5\\cdot \\begin{vmatrix}∗ & ∗ & 5 & ∗ \\\\ 2 & 0 & ∗ & 0 \\\\ -1 & 3 & ∗ & 4 \\\\ 8 & 0 & ∗ & -2\\end{vmatrix} \\\\  & =1\\cdot (-1)^{1+1}\\begin{vmatrix}0 & 0 & 0 \\\\ 3 & 0 & 4 \\\\ 0 & 1 & -2\\end{vmatrix}+5\\cdot (-1)^{1+3}\\begin{vmatrix}2 & 0 & 0 \\\\ -1 & 3 & 4 \\\\ 8 & 0 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 0 & 0 \\\\ 3 & 0 & 4 \\\\ 0 & 1 & -2\\end{vmatrix}+5\\begin{vmatrix}2 & 0 & 0 \\\\ -1 & 3 & 4 \\\\ 8 & 0 & -2\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}0 & 4 \\\\ 1 & -2\\end{vmatrix}-0\\cdot \\begin{vmatrix}3 & 4 \\\\ 0 & -2\\end{vmatrix}+0\\cdot \\begin{vmatrix}3 & 0 \\\\ 0 & 1\\end{vmatrix}+5\\left(2\\cdot \\begin{vmatrix}3 & 4 \\\\ 0 & -2\\end{vmatrix}-0\\cdot \\begin{vmatrix}-1 & 4 \\\\ 8 & -2\\end{vmatrix}+0\\cdot \\begin{vmatrix}-1 & 3 \\\\ 8 & 0\\end{vmatrix}\\right) \\\\  & =10(3\\cdot (-2)-4\\cdot 0) \\\\  & =10\\cdot (-6) \\\\  & =-60\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0b4e1e-e16a-5d57-a191-c6eb7eff538c" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186600022} {:answer/id #uuid "44982a56-5627-5e65-ac8e-9b5b6c879436" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186600076} {:answer/id #uuid "5b45886f-bd56-5ee9-b0f7-cf4cdcf15fc2" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186600097} {:answer/id #uuid "a6965eb6-aa6c-58a9-acb7-bd1729caa394" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 5" :db/id #edb/ref 17592186600173} {:answer/id #uuid "c0f27d38-3c6d-5ce8-a935-b8b67829650c" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 15" :db/id #edb/ref 17592186600203}] :answer-field/correct {:db/id #edb/ref 17592186600076} :answer-field/id #uuid "1b272139-c011-5ef3-afd7-43c157f672b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600277}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "163e82d3-7de9-5355-b49b-8f10761151ec" :question/math-academy-id "q-127902" :question/problem "If $A=\\begin{bmatrix}k & 10 \\\\ 10 & k\\end{bmatrix}$ is a singular matrix, calculate the value(s) of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =k\\cdot k-10\\cdot 10 \\\\  & ={k}^{2}-100.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}{k}^{2}-100 & =0 \\\\ {k}^{2} & =100 \\\\ k & =\\pm 10\\end{aligned}\n$$\n\nTherefore, the values of $k$ are $k=\\pm 10$"}] [{:db/id #edb/ref 17592186600357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f07a85c-3c89-5ba1-a5d3-6811f114ab60" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186600067} {:answer/id #uuid "4043a130-391c-571e-87d0-535da9e7a739" :answer/type {:db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186600072} {:answer/id #uuid "4daa3867-ffce-5d54-a8ab-e11eb579536c" :answer/type {:db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186600087} {:answer/id #uuid "dcdd3410-3bf7-5121-8f99-6c98996b05f3" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186600233} {:answer/id #uuid "dce81e67-74dc-5364-a47c-2df715b351c1" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186600234}] :answer-field/correct {:db/id #edb/ref 17592186600234} :answer-field/id #uuid "6f3a1d19-546e-5407-901b-42419a5e7169" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "317fb5e0-7e24-51ce-9d06-ba5360352841" :question/math-academy-id "q-71971" :question/problem "If $E=\\begin{bmatrix}y & y \\\\ 5 & 4\\end{bmatrix}$ is a singular matrix, calculate the value of $y.$" :question/worked-solution "The matrix $E$ is singular if and only if $det(E)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(E) & =y\\cdot 4-5\\cdot y \\\\  & =4y-5y \\\\  & =-y\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $y:$\n\n$$\n\\begin{aligned}-y & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the value of $y$ is $y=0.$"}] [{:db/id #edb/ref 17592186600373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b437de6-bde8-5811-97bd-69a5bf10ef1e" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186600038} {:answer/id #uuid "5534553e-5393-5be1-aec5-c70e4a78ba89" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186600094} {:answer/id #uuid "a3cfe9a1-88fc-5b0d-b7d7-2558d0a86c9e" :answer/type {:db/ident :answer.type/text} :answer/value "$A$  only" :db/id #edb/ref 17592186600168} {:answer/id #uuid "aa88717f-c900-5639-8ec3-cfe5fe0ad471" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186600177} {:answer/id #uuid "de3d5772-e2de-5707-a559-c93a05f19b51" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186600236}] :answer-field/correct {:db/id #edb/ref 17592186600236} :answer-field/id #uuid "ddbaa67e-fb9b-5552-b48f-8e0ceca6d32b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600331}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8bf9f0bd-e57c-5e80-abc3-63e7a8e64309" :question/math-academy-id "q-127824" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=\\begin{bmatrix}1 & 6 & 1 \\\\ 5 & 1 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}1 & -3 \\\\ 2 & -4\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 2 \\\\ 6 & 4\\end{bmatrix}.\n$$" :question/worked-solution "- The matrix $A$ is a $2\\times 3$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=1\\cdot (-4)-2\\cdot (-3)=2.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=3\\cdot 4-6\\cdot 2=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."}] [{:db/id #edb/ref 17592186600382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1c6150-1eb6-5505-8739-ae729b3150ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 \\\\ -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186600020} {:answer/id #uuid "3de09173-4491-5c3c-9f97-6f54a07cda87" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186600064} {:answer/id #uuid "647a0684-4db3-5276-ac29-2887027fa1be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\begin{bmatrix}4 & -1 \\\\ -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186600106} {:answer/id #uuid "a5e6ff72-51e0-5cca-8827-80c50fb9db62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186600172} {:answer/id #uuid "e883190e-6aa1-5503-8c13-4736da8cd8b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186600248}] :answer-field/correct {:db/id #edb/ref 17592186600172} :answer-field/id #uuid "1e0f73aa-0fa9-5276-8447-bb4aef660c2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600278}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "adb40482-3ae4-5cc7-a373-aa47d9b12cf4" :question/math-academy-id "q-7964" :question/problem "Calculate ${U}^{-1}$, where \n$$\n\\displaystyle U=\\begin{bmatrix}1 & -1 \\\\ 3 & 4\\end{bmatrix}.\n$$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nU=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $U$ can be found using the following formula:\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(U)=1\\cdot 4-3\\cdot (-1)=7\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{7}\\begin{bmatrix}4 & -(-1) \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\frac{1}{7}\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}U{U}^{-1} & =\\begin{bmatrix}1 & -1 \\\\ 3 & 4\\end{bmatrix}\\cdot \\frac{1}{7}\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {U}^{-1}U & =\\frac{1}{7}\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ee1a91f-0986-5f75-8563-dff87edc6456" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id #edb/ref 17592186600066} {:answer/id #uuid "5f292669-205a-5459-946d-3a7ac60d84a4" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id #edb/ref 17592186600101} {:answer/id #uuid "652da823-4b08-5363-802c-21ddcba8693b" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ only" :db/id #edb/ref 17592186600108} {:answer/id #uuid "944a8498-f5b9-5183-9d55-be9a1fd836bd" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id #edb/ref 17592186600154} {:answer/id #uuid "ebdca042-3eea-5a34-8bd8-07ea54c935bf" :answer/type {:db/ident :answer.type/text} :answer/value "$W$ only" :db/id #edb/ref 17592186600253}] :answer-field/correct {:db/id #edb/ref 17592186600066} :answer-field/id #uuid "54b5da73-bdec-50be-b2f4-a4efdff70f05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0fa7f9a-b080-583d-bd30-cc8dcc01e824" :question/math-academy-id "q-71936" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nU=\\begin{bmatrix}4 & 5 \\\\ 1 & 2\\end{bmatrix},\\,V=\\begin{bmatrix}3 & 3 \\\\ 3 & 3\\end{bmatrix},\\,W=\\begin{bmatrix}-3 & -4 \\\\ 3 & 4\\end{bmatrix}.\n$$" :question/worked-solution "- For the matrix $U$, we have\n\n$$\ndet(U)=4\\cdot 2-1\\cdot 5=3.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\n- For the matrix $V$, we have\n\n$$\ndet(V)=3\\cdot 3-3\\cdot 3=0.\n$$\n\nBecause $det(V)=0,$ we conclude that $V$ is not invertible.\n\n- For the matrix $W$, we have\n\n$$\ndet(W)=(-3)\\cdot 4-3\\cdot (-4)=0.\n$$\n\nBecause $det(W)=0,$ we conclude that $W$ is not invertible.\n\nTherefore, only $V$ and $W$ do not have an inverse."}] [{:db/id #edb/ref 17592186600818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51553fc8-df61-5c1b-ae4b-7c85e3676d39" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186600571} {:answer/id #uuid "847772cb-5736-57ba-a3e6-63f220366a5d" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186600609} {:answer/id #uuid "bd489d7c-879e-56a0-ae00-57c62f690e47" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186600652} {:answer/id #uuid "df6ad157-5a55-5cbe-891b-5e50dd1e5d87" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186600678} {:answer/id #uuid "f8e92a3f-7c3f-597a-959b-afd4f1946ef9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600700}] :answer-field/correct {:db/id #edb/ref 17592186600700} :answer-field/id #uuid "25c48f05-9eac-585e-ab58-f47ac84ab3e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600713}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b46f8d40-b8fd-5dae-ada5-540532068a02" :question/math-academy-id "q-73537" :question/problem "The entry ${a}_{21}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & -1 & 3 \\\\ 2 & 0 & k \\\\ 0 & -1 & -3\\end{bmatrix}\n$$\nequals $-\\frac{2}{3}$ and $det(A)=k-12.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=k-12\n$$\n\nSince we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}2 & k \\\\ 0 & -3\\end{vmatrix} \\\\  & =-\\begin{vmatrix}2 & k \\\\ 0 & -3\\end{vmatrix} \\\\  & =-(-6-0) \\\\  & =6\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{12} \\\\  & =\\frac{1}{k-12}\\cdot 6 \\\\  & =\\frac{6}{k-12}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{21}^{′}=-\\frac{2}{3}$, we have\n\n$$\n\\begin{aligned}-\\frac{2}{3} & =\\frac{6}{k-12} \\\\ -2(k-12) & =6\\cdot 3 \\\\ -2k+24 & =18 \\\\ -2k & =-6 \\\\ k & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b36490-856a-5985-b78a-69d67ce62921" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 2 \\\\ 4 & 4 & -1 \\\\ 1 & 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186600510} {:answer/id #uuid "0f3e098e-a957-59c8-8488-e0ccbc38cbc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 & 1 \\\\ -2 & 2 & 1 \\\\ 8 & -7 & -4\\end{bmatrix}" :db/id #edb/ref 17592186600518} {:answer/id #uuid "2c645ea0-c838-5dc6-a1f2-9549f5459759" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{bmatrix}" :db/id #edb/ref 17592186600544} {:answer/id #uuid "5e3817a5-b57c-5066-8d26-a6866ca56a90" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & -8 \\\\ -1 & -2 & 7 \\\\ -1 & -1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186600580} {:answer/id #uuid "fc08c14b-d138-5b8a-91e6-aa18d1bd812e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186600701}] :answer-field/correct {:db/id #edb/ref 17592186600518} :answer-field/id #uuid "b532e752-9725-55e1-bf79-8c2c7ddfba58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600762}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c91b0db6-12d0-5fb2-84a7-539b101b21df" :question/math-academy-id "q-38654" :question/problem "Find the inverse of the matrix $A=\\begin{bmatrix}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{bmatrix}.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** Find the determinant of $A.$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{vmatrix} & =1\\begin{vmatrix}4 & 1 \\\\ -1 & 0\\end{vmatrix}-3\\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix}+1\\begin{vmatrix}0 & 4 \\\\ 2 & -1\\end{vmatrix} \\\\  & =1(0+1)-3(0-2)+1(0-8) \\\\  & =1+6-8 \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}4 & 1 \\\\ -1 & 0\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix} & \\begin{vmatrix}0 & 4 \\\\ 2 & -1\\end{vmatrix} \\\\ \\begin{vmatrix}3 & 1 \\\\ -1 & 0\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 2 & 0\\end{vmatrix} & \\begin{vmatrix}1 & 3 \\\\ 2 & -1\\end{vmatrix} \\\\ \\begin{vmatrix}3 & 1 \\\\ 4 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 3 \\\\ 0 & 4\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 & -8 \\\\ 1 & -2 & -7 \\\\ -1 & 1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}1 & 2 & -8 \\\\ -1 & -2 & 7 \\\\ -1 & -1 & 4\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 & 1 \\\\ -2 & 2 & 1 \\\\ 8 & -7 & -4\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f2b124-71ee-5657-8ada-63e428f0312b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186600537}] :answer-field/correct {:db/id #edb/ref 17592186600537} :answer-field/id #uuid "7cf99068-4357-5b0a-b273-958b12875ee1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600745}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "db6245be-eb53-5345-be03-62f39702734c" :question/math-academy-id "q-319534" :question/problem "Determine the entry ${a}_{31}^{′}$ in the inverse of a matrix \n\n$$\nA=\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & -3 & 1 \\\\ 4 & 1 & 2\\end{bmatrix}\n$$\n\nif its determinant is $1.$\n\n${a}_{31}^{′}=$\n{{field-1}}" :question/worked-solution "Since we want the entry ${a}_{31}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}\\begin{vmatrix}0 & -3 \\\\ 4 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}0 & -3 \\\\ 4 & 1\\end{vmatrix} \\\\  & =(+1)((0)(1)-(-3)(4)) \\\\  & =12.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′} & =\\frac{1}{det(A)}\\,{c}_{13} \\\\  & =\\frac{1}{1}\\cdot 12 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c06ae024-a5e4-5103-8230-4758a97c238f" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186600656}] :answer-field/correct {:db/id #edb/ref 17592186600656} :answer-field/id #uuid "3bf67162-7954-5d66-af90-00e60f27422c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600721} {:answer-field/choices [{:answer/id #uuid "3e3618cf-fbbe-5cbc-b315-fc64ce11481b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186600553}] :answer-field/correct {:db/id #edb/ref 17592186600553} :answer-field/id #uuid "c8244a9f-409d-5fc6-bb9c-0e58fa735fb4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600766} {:answer-field/choices [{:answer/id #uuid "1158ba47-5581-5b99-a840-c8e3abde5500" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186600520}] :answer-field/correct {:db/id #edb/ref 17592186600520} :answer-field/id #uuid "f38103b9-2758-5c45-995c-7d48215b7ae5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600776}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ead1890b-ae72-51f9-a5ff-15a6985df681" :question/math-academy-id "q-319401" :question/problem "Find the inverse of the matrix $A=\\begin{bmatrix}0 & -2 & -1 \\\\ -2 & -1 & -3 \\\\ -3 & 2 & -3\\end{bmatrix}.$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$-8$</td><td>$5$</td></tr>\n<tr><td>$3$</td><td>$-3$</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$6$</td><td>$-4$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** Find the determinant of $A.$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}0 & -2 & -1 \\\\ -2 & -1 & -3 \\\\ -3 & 2 & -3\\end{vmatrix} & =0\\begin{vmatrix}-1 & -3 \\\\ 2 & -3\\end{vmatrix}-(-2)\\begin{vmatrix}-2 & -3 \\\\ -3 & -3\\end{vmatrix}-1\\begin{vmatrix}-2 & -1 \\\\ -3 & 2\\end{vmatrix} \\\\  & =0((-1)(-3)-(-3)(2))+2((-2)(-3)-(-3)(-3))-((-2)(2)-(-1)(-3)) \\\\  & =0(3+6)+2(6-9)-(-4-3) \\\\  & =0+2(-3)+7 \\\\  & =1.\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}-1 & -3 \\\\ 2 & -3\\end{vmatrix} & \\begin{vmatrix}-2 & -3 \\\\ -3 & -3\\end{vmatrix} & \\begin{vmatrix}-2 & -1 \\\\ -3 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}-2 & -1 \\\\ 2 & -3\\end{vmatrix} & \\begin{vmatrix}0 & -1 \\\\ -3 & -3\\end{vmatrix} & \\begin{vmatrix}0 & -2 \\\\ -3 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}-2 & -1 \\\\ -1 & -3\\end{vmatrix} & \\begin{vmatrix}0 & -1 \\\\ -2 & -3\\end{vmatrix} & \\begin{vmatrix}0 & -2 \\\\ -2 & -1\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-1)(-3)-(-3)(2) & (-2)(-3)-(-3)(-3) & (-2)(2)-(-1)(-3) \\\\ (-2)(-3)-(-1)(2) & (0)(-3)-(-1)(-3) & (0)(2)-(-2)(-3) \\\\ (-2)(-3)-(-1)(-1) & (0)(-3)-(-1)(-2) & (0)(-1)-(-2)(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -3 & -7 \\\\ 8 & -3 & -6 \\\\ 5 & -2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}9 & 3 & -7 \\\\ -8 & -3 & 6 \\\\ 5 & 2 & -4\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}9 & -8 & 5 \\\\ 3 & -3 & 2 \\\\ -7 & 6 & -4\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{1}\\begin{bmatrix}9 & -8 & 5 \\\\ 3 & -3 & 2 \\\\ -7 & 6 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -8 & 5 \\\\ 3 & -3 & 2 \\\\ -7 & 6 & -4\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186604576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2a9ff2e-cd07-5184-a748-73ab5a2d6469" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186604446}] :answer-field/correct {:db/id #edb/ref 17592186604446} :answer-field/id #uuid "0feb7ced-b4bf-5741-ad36-a2148dc30e2f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604477} {:answer-field/choices [{:answer/id #uuid "9de62a0e-39f7-5eda-bc85-d8efb3f38800" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+5y" :db/id #edb/ref 17592186604384}] :answer-field/correct {:db/id #edb/ref 17592186604384} :answer-field/id #uuid "dcafc6de-7bf3-5d44-bb3a-ffe721ef67ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604548}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "28030764-dfab-5186-ade3-6ad982a69767" :question/math-academy-id "q-317581" :question/problem "What is the system of equations represented by\n\n$$\n\\begin{bmatrix}-2 & 5 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}7 \\\\ -2\\end{bmatrix}?\n$$\n\nThe corresponding system of equations is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-system\" role=\"group\" aria-label=\"System of equations\">\n<table aria-label=\"Equation rows\"><tbody>\n<tr><td>{{field-1}}</td><td>$=$</td><td>$7$</td></tr>\n<tr><td>{{field-2}}</td><td>$=$</td><td>$\\hspace{0.167em}\\hspace{0.167em}-2.$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "The $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-2x+5y &=7 \\\\ 0x+y &=-2\\end{aligned}\\right.\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\left\\{\\begin{aligned}-2x+5y &=7 \\\\ y &=-2\\end{aligned}\\right.\n$$"}] [{:db/id #edb/ref 17592186604586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90cc1755-3b32-50cc-b1e6-ef23a46d69c9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186604369}] :answer-field/correct {:db/id #edb/ref 17592186604369} :answer-field/id #uuid "59edda13-aa56-59d2-a2c1-31e7089761e2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604508} {:answer-field/choices [{:answer/id #uuid "26eeddf7-93c2-53bd-ad97-82b1061c68f3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186604248}] :answer-field/correct {:db/id #edb/ref 17592186604248} :answer-field/id #uuid "721b7e6e-1bb7-5f00-ada8-f1dbf1715717" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604512} {:answer-field/choices [{:answer/id #uuid "f335d289-160c-598f-bf7e-435d8e515f13" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186604460}] :answer-field/correct {:db/id #edb/ref 17592186604460} :answer-field/id #uuid "d42950d8-eb61-57e8-b18b-da5b2e9b5b24" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604542} {:answer-field/choices [{:answer/id #uuid "f3405b0c-f0a1-5c1c-80fa-4d87429cefcf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186604461}] :answer-field/correct {:db/id #edb/ref 17592186604461} :answer-field/id #uuid "eebb4c5c-83ec-5325-b46e-124dfb9b5470" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604557}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c8ad85b-6e42-5b46-a5f5-5b11787c440b" :question/math-academy-id "q-317533" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-y &=6 \\\\ 5y-2x &=0,\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$5$</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$6$</td></tr>\n<tr><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, we organize the system so that it is in the correct order and both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}3x-y &=6 \\\\ -2x+5y &=0\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -1 \\\\ -2 & 5\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}6 \\\\ 0\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -1 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 \\\\ 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186604609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56428ccd-1ce7-5816-a899-435e1ac9183e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3y+x &=1 \\\\ -2x &=8\\end{aligned}\\right." :db/id #edb/ref 17592186604309} {:answer/id #uuid "7cf1edc9-bdf7-5457-8ec9-e8f592989ba7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x+2y &=2 \\\\ -2y &=8\\end{aligned}\\right." :db/id #edb/ref 17592186604355} {:answer/id #uuid "b3463627-ba39-5be5-afde-676336a272da" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x+y &=2 \\\\ x-2y &=8\\end{aligned}\\right." :db/id #edb/ref 17592186604399} {:answer/id #uuid "b3582981-6b87-58a6-ace2-43635eee5ea9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x+y &=2 \\\\ y &=6\\end{aligned}\\right." :db/id #edb/ref 17592186604400} {:answer/id #uuid "bd4b9ceb-2f0d-5953-9ce6-17f5fd3bc469" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x+y &=2 \\\\ -2y &=8\\end{aligned}\\right." :db/id #edb/ref 17592186604412}] :answer-field/correct {:db/id #edb/ref 17592186604412} :answer-field/id #uuid "e8e8861d-3639-5a9c-b966-676d3d269727" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186604554}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9f9355a7-de6b-578e-99a5-c8853736c1f1" :question/math-academy-id "q-32017" :question/problem "What is the system of equations represented by\n\n$$\n\\begin{bmatrix}3 & 1 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 8\\end{bmatrix}?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}3x+y &=2 \\\\ 0x-2y &=8\\end{aligned}\\right.\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\left\\{\\begin{aligned}3x+y &=2 \\\\ -2y &=8\\end{aligned}\\right.\n$$"}] [{:db/id #edb/ref 17592186604610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38cb783a-6cf7-5f17-961c-0c2082059c7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ -2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186604272} {:answer/id #uuid "8b09f947-acde-58af-ab0a-7b461ae58809" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186604361} {:answer/id #uuid "afa108c1-cbc3-5791-a361-9e8f180aabcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186604397} {:answer/id #uuid "f599bda4-8506-586d-980b-5b70ba2d97ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186604464} {:answer/id #uuid "f88d0a48-b832-5468-bac1-9eb7d313e9b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186604468}] :answer-field/correct {:db/id #edb/ref 17592186604397} :answer-field/id #uuid "26e644b6-2e14-5572-a9c4-d5bbf06fe85e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186604484}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a6bce15c-7366-5bbf-8596-fb4c6459f4a6" :question/math-academy-id "q-130512" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}3 &=-y \\\\ 0 &=-1-2x\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}0x+y &=-3 \\\\ 2x+0y &=-1\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & 1 \\\\ 2 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-3 \\\\ -1\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ -1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186604616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5459f0c-1eb6-5dba-828b-ab6a6f4e5a55" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186604432}] :answer-field/correct {:db/id #edb/ref 17592186604432} :answer-field/id #uuid "47f7f112-87ba-552d-9bb8-3ac461686805" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604500} {:answer-field/choices [{:answer/id #uuid "68e83df2-aba5-55a1-8fc1-ef2c2a65026d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186604324}] :answer-field/correct {:db/id #edb/ref 17592186604324} :answer-field/id #uuid "4a882650-5a0d-5009-9b74-8d5dda92188f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604501} {:answer-field/choices [{:answer/id #uuid "dbd6285b-9b3d-5b05-83b8-c709475213de" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186604439}] :answer-field/correct {:db/id #edb/ref 17592186604439} :answer-field/id #uuid "a1e5ed5f-7786-5034-9ae9-c27a1bb0f473" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604527} {:answer-field/choices [{:answer/id #uuid "cac4d593-370a-5637-be73-4fba331c6e8f" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186604423}] :answer-field/correct {:db/id #edb/ref 17592186604423} :answer-field/id #uuid "f723ac45-173c-5f24-b300-04ee475710c3" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604559}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce1947c5-ab86-5a81-ab9f-f80633f35f4f" :question/math-academy-id "q-317518" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-6y &=18 \\\\ 5x &=-20\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n<div class=\"matrix-answer\">\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$-6$</td></tr>\n<tr><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$x$</td></tr>\n<tr><td>$y$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-4}}</td></tr>\n<tr><td>$-20$</td></tr>\n</tbody></table>\n</div>\n<span class=\"matrix-answer-label\">$.$</span>\n</div>" :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $x$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $y$ does not appear in the second equation, which means that its coefficient is $0$ too. So, we get\n\n$$\n\\left\\{\\begin{aligned}0x-6y &=18 \\\\ 5x+0y &=-20\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & -6 \\\\ 5 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}18 \\\\ -20\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & -6 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}18 \\\\ -20\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186604622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d51918f-f7a2-530a-93ba-8aa1dbff97a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 \\\\ 1 & 7\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186604236} {:answer/id #uuid "66eb2540-892b-5054-a627-b0e911168b27" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186604319} {:answer/id #uuid "a3b027b7-0143-5279-816e-8d13997ff02f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -5 \\\\ 1 & -7\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186604388} {:answer/id #uuid "ada4f760-4b62-5d97-a72e-4fe27db835db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5 \\\\ 1 & -7\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186604394} {:answer/id #uuid "e90aa008-f624-5e7b-88aa-5b451ad76ca7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 \\\\ 1 & -6\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186604450}] :answer-field/correct {:db/id #edb/ref 17592186604450} :answer-field/id #uuid "ae7c45bc-6cd0-5ead-ad70-0fd0273ce816" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186604531}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f90a2076-00d9-5a6f-a56a-3ae14ad4c0fe" :question/math-academy-id "q-12290" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}3x+5y &=4 \\\\ x-6y &=-4\\end{aligned}\\right.\n$$" :question/worked-solution "First, notice that both $x$ and $y$ appear in each equation, all the variables are on the left-hand side, and all the constants are on the right-hand side.\n\n$$\n\\left\\{\\begin{aligned}3x+5y &=4 \\\\ x-6y &=-4\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & 5 \\\\ 1 & -6\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & 5 \\\\ 1 & -6\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186611564 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "872a59d9-2a6e-547b-b686-29a466ace462" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186611287}] :answer-field/correct {:db/id #edb/ref 17592186611287} :answer-field/id #uuid "a302373c-fcd2-55cf-98e6-280009bfae2a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611527}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0a5bb82e-45f2-5aba-afd0-22db66e7e7ca" :question/math-academy-id "q-319935" :question/problem "The entry ${a}_{21}^{′}$ in the inverse of the matrix\n\n$$\nA=\\begin{bmatrix}1 & 2 & 0 \\\\ -1 & 1 & -1 \\\\ k & 3 & -2\\end{bmatrix}\n$$\n\nequals $1.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}1 & 2 & 0 \\\\ -1 & 1 & -1 \\\\ k & 3 & -2\\end{vmatrix} \\\\  & =1\\begin{vmatrix}1 & -1 \\\\ 3 & -2\\end{vmatrix}-2\\begin{vmatrix}-1 & -1 \\\\ k & -2\\end{vmatrix}+0\\begin{vmatrix}-1 & 1 \\\\ k & 3\\end{vmatrix} \\\\  & =(-2+3)-2(2+k) \\\\  & =1-(4+2k) \\\\  & =-3-2k \\\\  & =-(2k+3)\\end{aligned}\n$$\n\nSince we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{21}^{t}={c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}-1 & -1 \\\\ k & -2\\end{vmatrix} \\\\  & =-((-1)(-2)-(-1)(k)) \\\\  & =-(2+k) \\\\  & =-(k+2).\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′} & =\\frac{1}{det(A)}{c}_{21}^{t} \\\\  & =\\frac{1}{det(A)}{c}_{12} \\\\  & =\\frac{1}{-(2k+3)}\\cdot (-(k+2)) \\\\  & =\\frac{k+2}{2k+3}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{21}^{′}=1$, we have\n\n$$\n\\begin{aligned}\\frac{k+2}{2k+3} & =1 \\\\ k+2 & =2k+3 \\\\ -k & =1 \\\\ k & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c2e24f4-264a-5456-8f09-0cc6e41f8b87" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186611116} {:answer/id #uuid "3521eb3b-cef0-57ea-aa15-699b7b0211a7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186611148} {:answer/id #uuid "5d3513cf-8f30-5995-8346-cc049c17848a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186611212} {:answer/id #uuid "f087b195-d50e-53b9-800b-bfb285efe97f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186611443} {:answer/id #uuid "f6230837-e819-5013-9af6-52a66bf4058f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186611455}] :answer-field/correct {:db/id #edb/ref 17592186611212} :answer-field/id #uuid "f7303399-4003-56d1-af13-0767ff00fc5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186611554}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4619cb6c-a671-59dc-a776-f446915a036e" :question/math-academy-id "q-73536" :question/problem "The entry ${a}_{31}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}-1 & k & 0 \\\\ 3 & 3 & 2 \\\\ 1 & -1 & 1\\end{bmatrix}\n$$\nequals $\\frac{3}{2}$ and $det(A)=-5-k.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=-5-k\n$$\n\nSince we want the entry ${a}_{31}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}\\begin{vmatrix}3 & 3 \\\\ 1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 3 \\\\ 1 & -1\\end{vmatrix} \\\\  & =-3-3 \\\\  & =-6\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{13} \\\\  & =\\frac{1}{-5-k}\\cdot (-6) \\\\  & =\\frac{6}{5+k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{31}^{′}=\\frac{3}{2}$, we have\n\n$$\n\\begin{aligned}\\frac{3}{2} & =\\frac{6}{5+k} \\\\ 3(5+k) & =6\\cdot 2 \\\\ 15+3k & =12 \\\\ 3k & =-3 \\\\ k & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3be6385-7d4d-5b86-95ed-ed2957fb5803" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186611324}] :answer-field/correct {:db/id #edb/ref 17592186611324} :answer-field/id #uuid "af46b406-04d2-5ffc-9f40-6b2954fefd5b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611535}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b7bc8482-69d8-57e2-9de9-9b1bf30b81a1" :question/math-academy-id "q-319526" :question/problem "Determine the entry ${a}_{11}^{′}$ in the inverse of a matrix \n\n$$\nA=\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & -2 & 1 \\\\ 0 & 4 & 1\\end{bmatrix}\n$$\n\nif its determinant is $-15.$\n\n${a}_{11}^{′}=$\n{{field-1}}" :question/worked-solution "Since we want the entry ${a}_{11}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{11}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{11} & =(-1)^{1+1}\\begin{vmatrix}-2 & 1 \\\\ 4 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ 4 & 1\\end{vmatrix} \\\\  & =1\\cdot ((-2)(1)-1\\cdot 4) \\\\  & =-2-4 \\\\  & =-6.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{11}^{′} & =\\frac{1}{det(A)}\\,{c}_{11} \\\\  & =\\frac{1}{(-15)}\\cdot (-6) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059f8960-87af-5d7d-b2fa-f8766446208e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186611077}] :answer-field/correct {:db/id #edb/ref 17592186611077} :answer-field/id #uuid "1c36c8b7-425e-5a7c-9637-052cbe58e3bd" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611473} {:answer-field/choices [{:answer/id #uuid "10297945-1dca-586b-b5b8-f14b79ce88a2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186611098}] :answer-field/correct {:db/id #edb/ref 17592186611098} :answer-field/id #uuid "47b85eee-500b-5ea8-b9ab-69a36d7a81d0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611490} {:answer-field/choices [{:answer/id #uuid "cb96c50d-6dfc-5eaa-afd1-b3a2c05d0be2" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186611384}] :answer-field/correct {:db/id #edb/ref 17592186611384} :answer-field/id #uuid "71a4eb74-77f1-5068-99c2-8a5ecf228451" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611502}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e5a04f6b-9c32-51a1-8584-2e22374d1c23" :question/math-academy-id "q-319391" :question/problem "Find the inverse of the matrix $A=\\begin{bmatrix}-1 & 1 & -2 \\\\ 2 & -3 & -3 \\\\ 2 & -2 & 3\\end{bmatrix}.$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$15$</td><td>$-1$</td><td>{{field-1}}</td></tr>\n<tr><td>$12$</td><td>$-1$</td><td>{{field-2}}</td></tr>\n<tr><td>$-2$</td><td>$0$</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** Find the determinant of $A.$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}-1 & 1 & -2 \\\\ 2 & -3 & -3 \\\\ 2 & -2 & 3\\end{vmatrix} & =(-1)\\begin{vmatrix}-3 & -3 \\\\ -2 & 3\\end{vmatrix}-1\\begin{vmatrix}2 & -3 \\\\ 2 & 3\\end{vmatrix}+(-2)\\begin{vmatrix}2 & -3 \\\\ 2 & -2\\end{vmatrix} \\\\  & =(-1)(-9-6)-(6+6)-2(-4+6) \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}-3 & -3 \\\\ -2 & 3\\end{vmatrix} & \\begin{vmatrix}2 & -3 \\\\ 2 & 3\\end{vmatrix} & \\begin{vmatrix}2 & -3 \\\\ 2 & -2\\end{vmatrix} \\\\ \\begin{vmatrix}1 & -2 \\\\ -2 & 3\\end{vmatrix} & \\begin{vmatrix}-1 & -2 \\\\ 2 & 3\\end{vmatrix} & \\begin{vmatrix}-1 & 1 \\\\ 2 & -2\\end{vmatrix} \\\\ \\begin{vmatrix}1 & -2 \\\\ -3 & -3\\end{vmatrix} & \\begin{vmatrix}-1 & -2 \\\\ 2 & -3\\end{vmatrix} & \\begin{vmatrix}-1 & 1 \\\\ 2 & -3\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-15 & 12 & 2 \\\\ -1 & 1 & 0 \\\\ -9 & 7 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}-15 & -12 & 2 \\\\ 1 & 1 & 0 \\\\ -9 & -7 & 1\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}-15 & 1 & -9 \\\\ -12 & 1 & -7 \\\\ 2 & 0 & 1\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{(-1)}\\begin{bmatrix}-15 & 1 & -9 \\\\ -12 & 1 & -7 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 & -1 & 9 \\\\ 12 & -1 & 7 \\\\ -2 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186625576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8ceb60-6db8-5c7d-8851-b0c2a69c88bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186624882} {:answer/id #uuid "2017d1dd-dba6-5cbf-826c-40565d5b7043" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186624926} {:answer/id #uuid "2e78e4a7-52ae-5460-b973-3b7d84ca9cf8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186624958} {:answer/id #uuid "a6490c6d-4268-52f3-b92b-f66db0a505ae" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186625169} {:answer/id #uuid "ab1893f1-d571-587d-8357-27fdbc90e001" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186625182}] :answer-field/correct {:db/id #edb/ref 17592186625182} :answer-field/id #uuid "386d3320-64de-5d1e-acad-177a63b28b9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186625397}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b8f17fbf-d4c9-5f9a-9bcf-bed23fc30d79" :question/math-academy-id "q-104438" :question/problem "The entry ${a}_{13}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}2 & 1 & 0 \\\\ -1 & 1 & 3 \\\\ 1 & 2 & k\\end{bmatrix}\n$$\nequals $1.$ Find the value of $k.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}2 & 1 & 0 \\\\ -1 & 1 & 3 \\\\ 1 & 2 & k\\end{vmatrix} & =2\\begin{vmatrix}1 & 3 \\\\ 2 & k\\end{vmatrix}-1\\begin{vmatrix}-1 & 3 \\\\ 1 & k\\end{vmatrix}+0\\begin{vmatrix}-1 & 1 \\\\ 1 & 2\\end{vmatrix} \\\\  & =2(k-6)-(-k-3)+0 \\\\  & =2k-12+k+3 \\\\  & =3k-9.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{13}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{31}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{31} & =(-1)^{3+1}\\begin{vmatrix}1 & 0 \\\\ 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 0 \\\\ 1 & 3\\end{vmatrix} \\\\  & =3-0 \\\\  & =3.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{13}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{31} \\\\  & =\\frac{1}{3k-9}\\cdot 3 \\\\  & =\\frac{1}{k-3}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{13}^{′}=1$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k-3} & =1 \\\\ 1 & =k-3 \\\\ k & =1+3 \\\\ k & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186625610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a111e9-569c-5457-b841-7ebd6cfa6dee" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186624902} {:answer/id #uuid "3f58f754-5d41-5e30-b09f-48dee6ab149e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186624983} {:answer/id #uuid "601998f9-bfd1-578b-a74f-f95009b215f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186625054} {:answer/id #uuid "c5f176e5-c22d-5d82-9d97-8ad6752dd7d0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186625236} {:answer/id #uuid "ddad50f4-e906-5449-8818-58572a55978f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186625288}] :answer-field/correct {:db/id #edb/ref 17592186625236} :answer-field/id #uuid "43b6386a-1e22-5792-98a7-8f1a08478511" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186625404}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f6dced0c-d4f4-5f20-bcf9-59108634e1a7" :question/math-academy-id "q-104393" :question/problem "Determine the entry ${a}_{31}^{′}$ in the inverse of a matrix $A=\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 3 & 1 \\\\ 0 & 2 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=\\begin{vmatrix}-1 & 0 & 0 \\\\ 2 & 3 & 1 \\\\ 0 & 2 & 1\\end{vmatrix} & =-1\\begin{vmatrix}3 & 1 \\\\ 2 & 1\\end{vmatrix}-0\\begin{vmatrix}2 & 1 \\\\ 0 & 1\\end{vmatrix}+0\\begin{vmatrix}2 & 3 \\\\ 0 & 2\\end{vmatrix} \\\\  & =-1(3-2)-0+0 \\\\  & =-1.\\end{aligned}\n$$\n\n  \n\nSince we want the entry ${a}_{31}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}\\begin{vmatrix}2 & 3 \\\\ 0 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 3 \\\\ 0 & 2\\end{vmatrix} \\\\  & =(4-0) \\\\  & =4.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′} &=\\frac{1}{\\text{det}(A)}{c}_{13}=\\frac{1}{-1}\\cdot 4=-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186625613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d247569a-6dab-5a8e-b4f6-32d43beee8fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{11}" :db/id #edb/ref 17592186625262}] :answer-field/correct {:db/id #edb/ref 17592186625262} :answer-field/id #uuid "96e78d53-3194-58c2-9a8f-21ea3115ff96" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186625447}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9660b54-4ac9-5bbc-94ea-1bbf185c9ce6" :question/math-academy-id "q-319419" :question/problem "Determine the entry ${a}_{21}^{′}$ in the inverse of a matrix \n$$\n\\displaystyle A=\\begin{bmatrix}2 & 1 & 0 \\\\ 0 & 3 & -1 \\\\ 1 & 0 & 2\\end{bmatrix}.\n$$\n\n${a}_{21}^{′}=$\n{{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=\\begin{vmatrix}2 & 1 & 0 \\\\ 0 & 3 & -1 \\\\ 1 & 0 & 2\\end{vmatrix} & =2\\begin{vmatrix}3 & -1 \\\\ 0 & 2\\end{vmatrix}-1\\begin{vmatrix}0 & -1 \\\\ 1 & 2\\end{vmatrix}+0\\begin{vmatrix}0 & 3 \\\\ 1 & 0\\end{vmatrix} \\\\  & =2(6+0)-1(0+1)+0(0-3) \\\\  & =11.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{21}^{t}={c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}0 & -1 \\\\ 1 & 2\\end{vmatrix} \\\\  & =-\\begin{vmatrix}0 & -1 \\\\ 1 & 2\\end{vmatrix} \\\\  & =-(0+1) \\\\  & =-1.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{21}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{12} \\\\  & =\\frac{1}{11}\\cdot (-1) \\\\  & =-\\frac{1}{11}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186636424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eba3e10-9ddb-55e1-808a-04226e4fa3f9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186635786} {:answer/id #uuid "64341ddf-2846-5a4d-a080-cd32cb6b7d90" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186635961} {:answer/id #uuid "e6ad276b-78c8-573f-933c-3fde8aea3984" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186636213} {:answer/id #uuid "f9c29a93-a8c8-5a3c-82eb-90f7c073eaa2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186636266} {:answer/id #uuid "fedc77fc-a1ce-57f9-ae26-12695fda1b3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186636281}] :answer-field/correct {:db/id #edb/ref 17592186635786} :answer-field/id #uuid "7730892a-531a-52a4-8eaa-4d502c9fab1c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186636336}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01611052-4ac5-5fe5-ac2d-a0e0aa59a3aa" :question/math-academy-id "q-104424" :question/problem "Determine the entry ${a}_{21}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 2 & 3 \\\\ 3 & 2 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$ \n\n$$\n\\begin{aligned}\\text{det}A=\\begin{vmatrix}1 & 0 & 0 \\\\ 1 & 2 & 3 \\\\ 3 & 2 & 1\\end{vmatrix} & =1\\begin{vmatrix}2 & 3 \\\\ 2 & 1\\end{vmatrix}-0\\begin{vmatrix}1 & 3 \\\\ 3 & 1\\end{vmatrix}+0\\begin{vmatrix}1 & 2 \\\\ 3 & 2\\end{vmatrix} \\\\  & =(2-6)-0+0 \\\\  & =-4.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}\\begin{vmatrix}1 & 3 \\\\ 3 & 1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}1 & 3 \\\\ 3 & 1\\end{vmatrix} \\\\  & =-(1-9) \\\\  & =8.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′} &=\\frac{1}{\\text{det}(A)}{c}_{12}=\\frac{1}{-4}\\cdot 8=-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186636426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a540a4b-5677-5950-b393-782b57c7492d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186636055}] :answer-field/correct {:db/id #edb/ref 17592186636055} :answer-field/id #uuid "cd1ccf7d-9ac6-5d27-88e8-ebfa042cdddb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186636377}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "03001b40-710d-5346-b654-dc59c20e3d00" :question/math-academy-id "q-319446" :question/problem "The entry ${a}_{33}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}2 & 1 & 0 \\\\ 0 & k & -1 \\\\ 1 & 2 & 1\\end{bmatrix}\n$$\nequals $\\frac{2}{5}$ and $det(A)=2k+3.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=2k+3\n$$\n\nSince we want the entry ${a}_{33}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{33}^{t}={c}_{33}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{33} & =(-1)^{3+3}\\begin{vmatrix}2 & 1 \\\\ 0 & k\\end{vmatrix} \\\\  & =+\\begin{vmatrix}2 & 1 \\\\ 0 & k\\end{vmatrix} \\\\  & =2k-0 \\\\  & =2k.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{33}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{33}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{33} \\\\  & =\\frac{1}{(2k+3)}\\cdot (2k) \\\\  & =\\frac{2k}{\\,2k+3\\,}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{33}^{′}=\\frac{2}{5}$, we have\n\n$$\n\\begin{aligned}\\frac{2k}{\\,2k+3\\,} & =\\frac{2}{5} \\\\ 10k & =4k+6 \\\\ 6k & =6 \\\\ k & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186636513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ff949e-f038-5985-9cd2-e21450d2f50f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186635798} {:answer/id #uuid "27179faa-c570-53f1-a3cc-2ef27f4ceab0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186635842} {:answer/id #uuid "4b53ca47-3313-5ba6-840a-966028472cb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186635905} {:answer/id #uuid "b17cd313-d09a-51c7-8ee5-f5a252231301" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186636090} {:answer/id #uuid "e47872cb-1378-5fba-9085-51a677fdb6dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186636208}] :answer-field/correct {:db/id #edb/ref 17592186636208} :answer-field/id #uuid "cc3f7e7d-9f1f-50c8-a395-0968fb32cc4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186636375}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de2a1a3d-677c-5794-89a2-14dc0ad897d1" :question/math-academy-id "q-104409" :question/problem "Determine the entry ${a}_{23}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}-1 & 0 & 2 \\\\ 1 & -1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=\\begin{vmatrix}-1 & 0 & 2 \\\\ 1 & -1 & 0 \\\\ 0 & 2 & 1\\end{vmatrix} & =(-1)\\begin{vmatrix}-1 & 0 \\\\ 2 & 1\\end{vmatrix}-0\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}+2\\begin{vmatrix}1 & -1 \\\\ 0 & 2\\end{vmatrix} \\\\  & =-(-1-0)-0+2(2-0) \\\\  & =1+4 \\\\  & =5.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{23}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{32}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{32} & =(-1)^{3+2}\\begin{vmatrix}-1 & 2 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-\\begin{vmatrix}-1 & 2 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-(0-2) \\\\  & =2.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{23}^{′} &=\\frac{1}{\\text{det}(A)}{c}_{32}=\\frac{1}{5}\\cdot 2=\\frac{2}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186638274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a22ce79-1d12-54b1-bfd1-d8761d73f9e6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186637859}] :answer-field/correct {:db/id #edb/ref 17592186637859} :answer-field/id #uuid "7ed629dc-a655-5be0-827d-9aeb0242c025" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186638196} {:answer-field/choices [{:answer/id #uuid "fceb9cdb-b220-5c29-b471-1cecbf50addf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186638136}] :answer-field/correct {:db/id #edb/ref 17592186638136} :answer-field/id #uuid "a172d80d-ac7d-56d7-9fd5-1cbccb1ea7d4" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186638205} {:answer-field/choices [{:answer/id #uuid "16275eaf-0927-5b10-96a7-81fb24186321" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186637787}] :answer-field/correct {:db/id #edb/ref 17592186637787} :answer-field/id #uuid "cae5c648-52ee-5be4-8c17-bd859d860490" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186638220}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a1ece672-381b-5993-95b2-2676f34ec62a" :question/math-academy-id "q-275736" :question/problem "Calculate ${C}^{-1}$, where\n$$\n\\displaystyle C=\\begin{bmatrix}-5 & 10 \\\\ -2 & 5\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${C}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$1$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nC=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $C$ can be found using the following formula:\n\n$$\n\\begin{aligned}{C}^{-1} & =\\frac{1}{det(C)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(C)=(-5)\\cdot 5-(-2)\\cdot 10=-5\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{C}^{-1} & =\\frac{1}{det(C)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{(-5)}\\begin{bmatrix}5 & -10 \\\\ 2 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 2 \\\\ -2/5 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}C{C}^{-1} & =\\begin{bmatrix}-5 & 10 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}-1 & 2 \\\\ -2/5 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {C}^{-1}C & =\\begin{bmatrix}-1 & 2 \\\\ -2/5 & 1\\end{bmatrix}\\begin{bmatrix}-5 & 10 \\\\ -2 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186643117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a64b9bd-6dcb-527c-827b-dcb15f8709ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & -7 & 3 & 0 \\\\ 5 & 7 & 3 & 5 \\\\ -5 & 0 & 6 & 0 \\\\ 3 & -6 & \\sqrt{5} & -21\\end{vmatrix}" :db/id #edb/ref 17592186642713} {:answer/id #uuid "b272ff33-fa43-5e9b-ba34-4b822f5cfd2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}1 & 2 & -7 & 3 \\\\ 9 & 5 & 7 & 3 \\\\ 8 & -5 & 0 & 6 \\\\ 5 & 3 & -6 & \\sqrt{5}\\end{vmatrix}" :db/id #edb/ref 17592186642911} {:answer/id #uuid "dda04c26-89f3-59b9-9efe-c68671ef5c0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & -3 & 8 & 4 \\\\ 2 & -7 & 3 & 0 \\\\ 5 & 7 & 3 & 5 \\\\ -5 & 0 & 6 & 0\\end{vmatrix}" :db/id #edb/ref 17592186642967} {:answer/id #uuid "edd3d61d-c971-5ff0-a59f-659bf1da96a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}1 & 0 & -3 & 8 \\\\ 1 & 2 & -7 & 3 \\\\ 9 & 5 & 7 & 3 \\\\ 8 & -5 & 0 & 6\\end{vmatrix}" :db/id #edb/ref 17592186642994} {:answer/id #uuid "f1ef15e5-ecae-576f-aaf9-c16ed930915d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}1 & -7 & 3 & 0 \\\\ 9 & 7 & 3 & 5 \\\\ 8 & 0 & 6 & 0 \\\\ 5 & -6 & \\sqrt{5} & -21\\end{vmatrix}" :db/id #edb/ref 17592186642998}] :answer-field/correct {:db/id #edb/ref 17592186642994} :answer-field/id #uuid "63620ee5-7ff5-518d-81f2-6c7bbc42f311" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186643059}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2383e30e-5033-5e1b-92c6-1ebcb1d8079a" :question/math-academy-id "q-130815" :question/problem "Find the minor of  ${v}_{55}$ in  $$\n\\displaystyle V=\\begin{bmatrix}1 & 0 & -3 & 8 & 4 \\\\ 1 & 2 & -7 & 3 & 0 \\\\ 9 & 5 & 7 & 3 & 5 \\\\ 8 & -5 & 0 & 6 & 0 \\\\ 5 & 3 & -6 & \\sqrt{5} & -21\\end{bmatrix}.\n$$" :question/worked-solution "To get the minor of ${v}_{55}$, we remove the $5$th row and $5$th column:\n\n$$\nV=\\begin{bmatrix}1 & 0 & -3 & 8 & ∗ \\\\ 1 & 2 & -7 & 3 & ∗ \\\\ 9 & 5 & 7 & 3 & ∗ \\\\ 8 & -5 & 0 & 6 & ∗ \\\\ ∗ & ∗ & ∗ & ∗ & -21\\end{bmatrix}\n$$\n\n \n\nSo, the minor is\n\n$$\n{M}_{55}=\\begin{vmatrix}1 & 0 & -3 & 8 \\\\ 1 & 2 & -7 & 3 \\\\ 9 & 5 & 7 & 3 \\\\ 8 & -5 & 0 & 6\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186643139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053116ca-313b-56ce-a956-3c7f4597489f" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186642656} {:answer/id #uuid "0b373bc4-88f5-5616-a4f7-8e2811f1955c" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186642662} {:answer/id #uuid "0eddd27f-5a26-599b-9df1-b3392d624d99" :answer/type {:db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186642669} {:answer/id #uuid "6618e701-1d3d-5185-88ed-7f3e1c4b1982" :answer/type {:db/ident :answer.type/math} :answer/value "-74" :db/id #edb/ref 17592186642791} {:answer/id #uuid "ad96e13e-0720-50c4-b826-7760fe00f9da" :answer/type {:db/ident :answer.type/math} :answer/value "-120" :db/id #edb/ref 17592186642900}] :answer-field/correct {:db/id #edb/ref 17592186642900} :answer-field/id #uuid "02886858-e42e-5411-9061-40e870e06665" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186643022}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7670c93b-533c-50b0-b134-5971914f737e" :question/math-academy-id "q-131097" :question/problem "Calculate the determinant of the matrix\n$$\n\\displaystyle B=\\begin{bmatrix}0 & 0 & 5 & 0 \\\\ 2 & 0 & 3 & 0 \\\\ 0 & 4 & 5 & 4 \\\\ 2 & 3 & 4 & 0\\end{bmatrix}.\n$$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(B) & ={b}_{11}{C}_{11}+{b}_{12}{C}_{12}+{b}_{13}{C}_{13}+{b}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+5\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =5{C}_{13} \\\\  & =5\\cdot \\begin{vmatrix}∗ & ∗ & 5 & ∗ \\\\ 2 & 0 & ∗ & 0 \\\\ 0 & 4 & ∗ & 4 \\\\ 2 & 3 & ∗ & 0\\end{vmatrix} \\\\  & =5(-1)^{1+3}\\begin{vmatrix}2 & 0 & 0 \\\\ 0 & 4 & 4 \\\\ 2 & 3 & 0\\end{vmatrix} \\\\  & =5\\left(2\\cdot \\begin{vmatrix}4 & 4 \\\\ 3 & 0\\end{vmatrix}-0\\cdot \\begin{vmatrix}0 & 4 \\\\ 2 & 0\\end{vmatrix}+0\\cdot \\begin{vmatrix}0 & 4 \\\\ 2 & 3\\end{vmatrix}\\right) \\\\  & =5(2\\cdot (-4\\cdot 0-4\\cdot 3)-0+0) \\\\  & =5(-24) \\\\  & =-120\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96be67a4-c2ca-5871-8b9b-f6a3384c0b3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186657226}] :answer-field/correct {:db/id #edb/ref 17592186657226} :answer-field/id #uuid "946f6c51-9964-54fd-a5a6-0e0b8b7640ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657395}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb1cb9fa-2270-5926-825a-1c72f6086193" :question/math-academy-id "q-319539" :question/problem "Determine the entry ${a}_{22}^{′}$ in the inverse of a matrix \n\n$$\nA=\\begin{bmatrix}2 & 0 & 1 \\\\ 1 & 3 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}\n$$\n\nif its determinant is $8.$\n\n${a}_{22}^{′}=$\n{{field-1}}" :question/worked-solution "Since we want the entry ${a}_{22}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{22}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{22} & =(-1)^{2+2}\\begin{vmatrix}2 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}2 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =\\,1\\cdot (2\\cdot 1-1\\cdot 0) \\\\  & =2.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{22}^{′} & =\\frac{1}{det(A)}\\,{c}_{22} \\\\  & =\\frac{1}{8}\\cdot 2 \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19738653-b2fb-55d2-b2fa-05451aa3eb37" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186661018}] :answer-field/correct {:db/id #edb/ref 17592186661018} :answer-field/id #uuid "10aa64e0-7998-5b52-8326-2b53f7b20a1c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186661405}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fe356574-da54-5187-9023-e89b4a8bf8d4" :question/math-academy-id "q-319945" :question/problem "The entry ${a}_{23}^{′}$ in the inverse of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & -3 & -3 \\\\ -3 & -3 & -2 \\\\ k & -3 & -2\\end{bmatrix}\n$$\n\nequals $1.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}-3 & -3 & -3 \\\\ -3 & -3 & -2 \\\\ k & -3 & -2\\end{vmatrix} \\\\  & =(-3)\\begin{vmatrix}-3 & -2 \\\\ -3 & -2\\end{vmatrix}-(-3)\\begin{vmatrix}-3 & -2 \\\\ k & -2\\end{vmatrix}+(-3)\\begin{vmatrix}-3 & -3 \\\\ k & -3\\end{vmatrix} \\\\  & =(-3)((-3)(-2)-(-2)(-3))+3((-3)(-2)-(-2)k)+(-3)((-3)(-3)-(-3)k) \\\\  & =(-3)(6-6)+3(6+2k)+(-3)(9+3k) \\\\  & =0+18+6k-27-9k \\\\  & =-3k-9\\end{aligned}\n$$\n\nSince we want the entry ${a}_{23}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{23}^{t}={c}_{32}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{32} & =(-1)^{3+2}\\begin{vmatrix}-3 & -3 \\\\ -3 & -2\\end{vmatrix} \\\\  & =-((-3)(-2)-(-3)(-3)) \\\\  & =-(6-9) \\\\  & =3.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{23}^{′} & =\\frac{1}{det(A)}{c}_{23}^{t} \\\\  & =\\frac{1}{det(A)}{c}_{32} \\\\  & =\\frac{3}{-3k-9} \\\\  & =-\\frac{1}{k+3}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{23}^{′}=1$, we have\n\n$$\n\\begin{aligned}-\\frac{1}{k+3} & =1 \\\\ \\frac{1}{k+3} & =-1 \\\\ k+3 & =-1 \\\\ k & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186666069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4de0bd-b7f9-5bd1-aa02-46566bea2b14" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}2 & -3 & 4 \\\\ 3 & 1 & 0 \\\\ 2 & -3 & 4\\end{vmatrix}" :db/id #edb/ref 17592186665529} {:answer/id #uuid "0d49ef88-ae1a-5fa8-9e77-d789fca29c40" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 3 & 1 \\\\ 1 & 2 & -3 \\\\ 1 & 7 & 2\\end{vmatrix}" :db/id #edb/ref 17592186665534} {:answer/id #uuid "7d49babd-84f0-5ffa-bec1-bc41d4a7ba63" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & 2 & -3 \\\\ 0 & 3 & 1 \\\\ 1 & 2 & -3\\end{vmatrix}" :db/id #edb/ref 17592186665712} {:answer/id #uuid "9e2b5328-3c1e-5261-a034-ede64a0b0d68" :answer/type {:db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}2 & -3 & 4 \\\\ 3 & 1 & 0 \\\\ 2 & -3 & 4\\end{vmatrix}" :db/id #edb/ref 17592186665764} {:answer/id #uuid "d0a61f80-9024-5d48-811c-a3476e1e6b7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}5 & -3 & 4 \\\\ 1 & -3 & 4 \\\\ 1 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186665840}] :answer-field/correct {:db/id #edb/ref 17592186665534} :answer-field/id #uuid "8e3470c1-1484-52f0-a5e0-eb74befddef3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186665995}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "21188a40-5263-51ed-b597-fb34cf4b486b" :question/math-academy-id "q-32728" :question/problem "Find the cofactor of ${g}_{14}$ in \n$$\n\\displaystyle G=\\begin{bmatrix}5 & 2 & -3 & 4 \\\\ 0 & 3 & 1 & 0 \\\\ 1 & 2 & -3 & 4 \\\\ 1 & 7 & 2 & -1\\end{bmatrix}.\n$$" :question/worked-solution "First, to get the minor of ${g}_{14}$, we remove the $1$st row and $4$th column: \n\n$$\nG=\\begin{bmatrix}∗ & ∗ & ∗ & 4 \\\\ 0 & 3 & 1 & ∗ \\\\ 1 & 2 & -3 & ∗ \\\\ 1 & 7 & 2 & ∗\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{14}=\\begin{vmatrix}0 & 3 & 1 \\\\ 1 & 2 & -3 \\\\ 1 & 7 & 2\\end{vmatrix}.\n$$\n\nTherefore, the cofactor of ${g}_{14}$ is\n\n$$\n\\begin{aligned}{C}_{14} & =(-1)^{1+4}{M}_{14} \\\\  & =-{M}_{14} \\\\  & =-\\begin{vmatrix}0 & 3 & 1 \\\\ 1 & 2 & -3 \\\\ 1 & 7 & 2\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186666097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a13b33-2a9b-517d-9513-fc646254a060" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & -1 & 5 & -2 \\\\ 7 & 2 & 0 & \\sqrt{2} \\\\ 3 & 2 & 8 & 4 \\\\ 4 & 1 & 3 & 12\\end{vmatrix}" :db/id #edb/ref 17592186665550} {:answer/id #uuid "3b56c257-847e-5ac4-94b9-6c9499e979cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}-1 & 5 & -2 & \\sqrt{7} \\\\ 2 & 0 & \\sqrt{2} & 3 \\\\ \\sqrt{11} & 2 & 0 & 1 \\\\ 1 & 3 & 12 & 2\\end{vmatrix}" :db/id #edb/ref 17592186665611} {:answer/id #uuid "6fd2f92b-acd8-5bd1-a549-1e21da4629d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & -1 & -2 & \\sqrt{7} \\\\ 7 & 2 & \\sqrt{2} & 3 \\\\ 5 & \\sqrt{11} & 0 & 1 \\\\ 4 & 1 & 12 & 2\\end{vmatrix}" :db/id #edb/ref 17592186665688} {:answer/id #uuid "a5f70842-c14a-5b97-85e1-a7489488addf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & -1 & 5 & -2 \\\\ 7 & 2 & 0 & \\sqrt{2} \\\\ 5 & \\sqrt{11} & 2 & 0 \\\\ 4 & 1 & 3 & 12\\end{vmatrix}" :db/id #edb/ref 17592186665777} {:answer/id #uuid "f1cbafb7-8bc9-5345-ad58-fb22ecea30c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & -1 & -2 & \\sqrt{7} \\\\ 7 & 2 & \\sqrt{2} & 3 \\\\ 3 & 2 & 4 & -1 \\\\ 5 & \\sqrt{11} & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186665890}] :answer-field/correct {:db/id #edb/ref 17592186665890} :answer-field/id #uuid "d2993074-3fce-50ca-9959-cc321999f02d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186666034}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6662fd5b-4529-5162-bcb8-eb561e266bc7" :question/math-academy-id "q-130813" :question/problem "What is the minor of ${f}_{53}$ in  $$\n\\displaystyle F=\\begin{bmatrix}0 & -1 & 5 & -2 & \\sqrt{7} \\\\ 7 & 2 & 0 & \\sqrt{2} & 3 \\\\ 3 & 2 & 8 & 4 & -1 \\\\ 5 & \\sqrt{11} & 2 & 0 & 1 \\\\ 4 & 1 & 3 & 12 & 2\\end{bmatrix}?\n$$" :question/worked-solution "To get the minor of ${f}_{53}$, we remove the $5$th row and $3$rd column:\n\n$$\nF=\\begin{bmatrix}0 & -1 & ∗ & -2 & \\sqrt{7} \\\\ 7 & 2 & ∗ & \\sqrt{2} & 3 \\\\ 3 & 2 & ∗ & 4 & -1 \\\\ 5 & \\sqrt{11} & ∗ & 0 & 1 \\\\ ∗ & ∗ & 3 & ∗ & ∗\\end{bmatrix}\n$$\n\n   \n\nSo, the minor is\n\n$$\n{M}_{53}=\\begin{vmatrix}0 & -1 & -2 & \\sqrt{7} \\\\ 7 & 2 & \\sqrt{2} & 3 \\\\ 3 & 2 & 4 & -1 \\\\ 5 & \\sqrt{11} & 0 & 1\\end{vmatrix}.\n$$"}]}
