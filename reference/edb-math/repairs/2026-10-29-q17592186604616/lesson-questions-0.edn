type/math} :answer/value "\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 9 x + 6 y = - 1 \\\\ \\displaystyle x = - 2\\end{array} \\right. \\end{array}" :db/id #edb/ref 17592186113408} {:answer/id #uuid "f05adb6e-e4fd-54ee-a877-80be7e74409e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 3 x + 2 y = - 1 \\\\ \\displaystyle x = - 2\\end{array} \\right. \\end{array}" :db/id #edb/ref 17592186113409} {:answer/id #uuid "f761650d-2720-5b17-8f25-48a1bb41f74b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 9 x + 6 y = 3 \\\\ \\displaystyle x + y = - 2\\end{array} \\right. \\end{array}" :db/id #edb/ref 17592186113410} {:answer/id #uuid "3b491284-60c9-534a-a93b-663a44d5a865" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 9 x + 6 y - 3 = 0 \\\\ \\displaystyle x - 2 = 0\\end{array} \\right. \\end{array}" :db/id #edb/ref 17592186113411}] :answer-field/id #uuid "ca7d485d-e01a-5fee-be3e-8b54af74ae8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113406}] :question/id #uuid "35b88fb0-9cd6-5ac5-a270-9cfdc3fa43ad" :question/math-academy-id "q-32020" :question/problem "What is the system of equations represented by\n$$\n\\displaystyle \\begin{bmatrix}9 & 6 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}-3 \\\\ -2\\end{bmatrix}\n$$?"}] [{:db/id #edb/ref 17592186115977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb33624c-6be3-586c-9f4c-c074a27c7f0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & -1 \\\\ 2 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186114800} {:answer/id #uuid "098