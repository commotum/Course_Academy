wer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}10 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186113361} {:answer/id #uuid "ec2b98e9-54be-57be-a5be-e6bbcb0f4cf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}10 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186113362} {:answer/id #uuid "5c7d2242-a652-5592-a077-e9c3a917780a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 1 & 9\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113363}] :answer-field/id #uuid "db161969-3909-540d-9bda-f153f7134ab2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113358}] :question/id #uuid "0468eabf-1364-5afc-8b00-c2d28bd74d7f" :question/math-academy-id "q-31874" :question/problem "Represent the following system of equations using matrices:\n$$\n\\displaystyle \\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle y + 3 x - 8 = 2 \\\\ \\displaystyle y + 9 = 5\\end{array} \\right. \\end{array}\n$$"}] [{:db/id #edb/ref 17592186115733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "844af2ff-91bd-5774-977a-c4b75a56b7e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2x+5y &=-7 \\\\ x &=10\\end{aligned}\\right." :db/id #edb/ref 17592186298123} {:answer/id #uuid "ba86e523-ab11-5712-a0ef-e9273fbba9ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2x-5y &=10 \\\\ y &=-7\\end{aligned}\\right." :db/id #edb/ref 17592186298364} {:answer/id #uuid "c0094f31-2ab1-54a0-a168-daab0cf20812" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2x+5y &=10 \\\\ y &=-7\\end{aligned}\\ri