ac890f0-a9d7-5b17-a40e-a5d265c117e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186254312} {:answer/id #uuid "72520afb-7f21-542b-a3df-d45e415f22cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186254683} {:answer/id #uuid "a1cb95dc-24db-531b-ad73-639a23776783" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186255097} {:answer/id #uuid "aa7eeada-dbe5-547f-9c1d-1e0392b79546" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186255177}] :answer-field/correct {:db/id #edb/ref 17592186255097} :answer-field/id #uuid "065e052d-4c76-5e45-8830-930b465810e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255927}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b54cfad2-6363-5425-bcc2-f4a9411e32b9" :question/math-academy-id "q-12291" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}x &=y-1 \\\\ x &=-y+1\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}x-y &=-1 \\\\ x+y &=1\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad42806-a1fb-502b-92c9-cc550a2947d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186263104} {:answer/id #uuid "3814d838-f67b-5fd0-9cf1-5bd3b8068e17" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186263506} {:answer/id #uuid "70300fb3-4714-53a0-81a4-d324647570c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 10\\end{bmatrix}" :db/id #edb/ref 17592186263972} {:answer/id #uuid "a40dd9f9-794b-5250-b118-912c1bcea248" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186264398} {:answer/id #uuid "c23a5f0c-9b6e-5b61-bcc9-719659fcd17f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -10\\end{bmatrix}" :db/id #edb/ref 17592186264687}] :answer-field/correct {:db/id #edb/ref 17592186264687} :answer-field/id #uuid "1393e60c-9a9d-558f-82b5-5e2a716a7edd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265276}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5438297a-3242-553b-b76b-9231f3aaa360" :question/math-academy-id "q-130501" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}2x+y &=4 \\\\ x-y &=-10\\end{aligned}\\right.\n$$" :question/worked-solution "First, notice that both $x$ and $y$ appear in each equation, all the variables are on the left-hand side, and all the constants are on the right-hand side.\n\n$$\n\\left\\{\\begin{aligned}2x+y &=4 \\\\ x-y &=-10\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}2 & 1 \\\\ 1 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}4 \\\\ -10\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}2 & 1 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -10\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11874c88-0d8d-5fdc-98e7-8f98e6a3f365" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 4 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186263162} {:answer/id #uuid "87092bc6-cce8-59e3-97f8-85ea23e9e36d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -4 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186264169} {:answer/id #uuid "a375bbba-4d73-59f8-98fd-ff55611b114c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 4 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186264389} {:answer/id #uuid "c344dea9-14a2-5e14-b911-cdb495284357" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -4 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186264702} {:answer/id #uuid "d761b6a0-7cd7-5ded-a020-ef128be56117" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186264877}] :answer-field/correct {:db/id #edb/ref 17592186264702} :answer-field/id #uuid "e12d11e5-1bfe-5244-a9f3-13036e9bc00f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265641}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d99d7426-520b-5e1d-945d-430bc4355051" :question/math-academy-id "q-130510" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}3x-1 &=4y \\\\ y &=-4\\end{aligned}\\right.\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}3x-4y &=1 \\\\ 0x+y &=-4\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -4 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -4 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6149c1e3-2adb-5ef4-9f00-d3b2f8ea2b11" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -5 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263840} {:answer/id #uuid "ae8b8a48-bedd-5065-93e5-a6639b2ed96c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -5 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264503} {:answer/id #uuid "b1b9dd15-da63-5ed4-bc90-f1be32942872" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -5 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264529} {:answer/id #uuid "b5a71f49-1f77-5bf1-a994-f837b58aa69e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264571} {:answer/id #uuid "c98be70a-8345-5fab-81a8-e8ad07f81f34" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264763}] :answer-field/correct {:db/id #edb/ref 17592186264571} :answer-field/id #uuid "031ee993-209a-598a-9707-1c175f7a4052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265254}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf8957cc-bd4d-53d8-bdac-5e6b1bfee90e" :question/math-academy-id "q-130511" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}x-5 &=y \\\\ y &=2x+3\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}x-y &=5 \\\\ -2x+y &=3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & -1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07c2532f-265d-518f-9242-3d66b909f114" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263072} {:answer/id #uuid "543b0987-b8ca-58c6-ba1b-9391f717f671" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263726} {:answer/id #uuid "9b04c073-d7dd-5790-ad72-0a5eca03bf2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264326} {:answer/id #uuid "9d796aff-5533-5fa8-a17b-584c4f6954b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264348} {:answer/id #uuid "bae2913a-0008-5d4d-af2d-d7a90a3b9ab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264624}] :answer-field/correct {:db/id #edb/ref 17592186263072} :answer-field/id #uuid "6bf40629-d731-54a2-b026-37276de9ddd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265430}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9720c969-3638-5f11-8696-12578cb9e2c9" :question/math-academy-id "q-130514" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}-3 &=y \\\\ 1 &=-2+x\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}0x+y &=-3 \\\\ x+0y &=3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dcde906-c5fb-5fc0-b6a8-8961649a59ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}10x+25y &=-15 \\\\ 12x+6y &=3\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422754} {:answer/id #uuid "727892e1-58ea-5d36-b86b-82b51a10eb55" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}2x+5y &=3 \\\\ 4x+y &=-2\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422822} {:answer/id #uuid "a12e8848-d478-59a6-a4bb-c9297a758c18" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}10x+25y &=-15 \\\\ 12x+3y &=6\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422866} {:answer/id #uuid "b92215d8-8706-55a2-9e83-085b95ecb6b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}10x+5y &=-15 \\\\ 12x+3y &=6\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422884} {:answer/id #uuid "e1575aa2-a070-55bb-b7a7-08d8f4d81a38" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\left\\{\\begin{aligned}2x+5y &=15 \\\\ 4x+y &=-6\\end{aligned}\\right.\\end{aligned}" :db/id #edb/ref 17592186422911}] :answer-field/correct {:db/id #edb/ref 17592186422822} :answer-field/id #uuid "0929e729-c74a-53df-b186-d608a6e127ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265262}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e54120f-ad5a-5b0e-97ad-23133523c995" :question/math-academy-id "q-130523" :question/problem "What is the system of equations represented by\n\n$$\n\\begin{bmatrix}10 & 25 \\\\ 12 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}15 \\\\ -6\\end{bmatrix}?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}10x+25y &=15 \\\\ 12x+3y &=-6\\end{aligned}\\right.\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2x+5y &=3 \\\\ 4x+y &=-2.\\end{aligned}\\right.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bec536f-f8a0-5917-8735-203411ca376c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x-4y &=-1 \\\\ x &=3\\end{aligned}\\right." :db/id #edb/ref 17592186263114} {:answer/id #uuid "13808937-e709-5baf-bd70-906d13045e3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x-4y &=3 \\\\ x &=-1\\end{aligned}\\right." :db/id #edb/ref 17592186263183} {:answer/id #uuid "441d0ffb-ffd6-58ae-a17d-9d7d0730d034" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x-4y &=-1 \\\\ y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186263599} {:answer/id #uuid "834d660c-f342-580a-bd90-9491af1021d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3y-4x &=-1 \\\\ y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186264128} {:answer/id #uuid "e782c9a3-4077-58c9-8359-eecbb821497c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}3x-4y &=-3 \\\\ y &=1\\end{aligned}\\right." :db/id #edb/ref 17592186265016}] :answer-field/correct {:db/id #edb/ref 17592186263599} :answer-field/id #uuid "71665118-325d-5577-b749-fff1dfd7861f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265439}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d26bf48b-80cb-5dd2-a23e-0d3f566745b3" :question/math-academy-id "q-130525" :question/problem "What is the system of equations represented by\n\n$$\n\\begin{bmatrix}3 & -4 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}3x-4y &=-1 \\\\ 0x+y &=3\\end{aligned}\\right.\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\left\\{\\begin{aligned}3x-4y &=-1 \\\\ y &=3.\\end{aligned}\\right.\n$$"}] [{:db/id #edb/ref 17592186292874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ea5ce6-ddda-5579-a684-d25f1058ba21" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186291202}] :answer-field/correct {:db/id #edb/ref 17592186291202} :answer-field/id #uuid "37543ffb-2c43-58fb-b8f8-ec6390531c18" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291916} {:answer-field/choices [{:answer/id #uuid "5e68dafa-a528-5425-b437-aef1cfe308b1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291035}] :answer-field/correct {:db/id #edb/ref 17592186291035} :answer-field/id #uuid "d0da29d0-45c3-5185-ae2d-49709322be04" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292367} {:answer-field/choices [{:answer/id #uuid "0b91bb20-bc8d-5241-9f91-00fa694c64e0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186290688}] :answer-field/correct {:db/id #edb/ref 17592186290688} :answer-field/id #uuid "e298cd73-8828-57b4-8bf2-f0f5222a8ea9" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292439} {:answer-field/choices [{:answer/id #uuid "49aee00a-74f6-5575-b7e9-6aed820fbfa2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186290936}] :answer-field/correct {:db/id #edb/ref 17592186290936} :answer-field/id #uuid "f771b189-a202-540f-9ad3-94aa036d9d1c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292509}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a396b1e-6a9c-5212-b41d-2db22ab00f92" :question/math-academy-id "q-275612" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-4y+3x &=8 \\\\ 2x &=-3,\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | $2$ | {{field-3}} |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | $8$ |  |\n| --- | --- | --- |\n|  | {{field-4}} |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |  |  |\n|  | $2$ | {{field-3}} |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | $8$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n\n." :question/worked-solution "First, we organize the system so that it is in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}3x-4y &=8 \\\\ 2x+0y &=-3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -4 \\\\ 2 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}8 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -4 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}8 \\\\ -3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5799816e-9719-5798-9c9a-f732bf85395d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297918}] :answer-field/correct {:db/id #edb/ref 17592186297918} :answer-field/id #uuid "8e09e8b7-c1e7-5293-a3b0-a64b67e11230" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299109} {:answer-field/choices [{:answer/id #uuid "054e6b51-eb57-5c1b-9a70-ba76b85003af" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297579}] :answer-field/correct {:db/id #edb/ref 17592186297579} :answer-field/id #uuid "dd3c78a5-7d86-5214-885d-4d4a59a37dad" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299387} {:answer-field/choices [{:answer/id #uuid "f5e7828e-dd01-5831-b8b3-7a3d04ee5c37" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298600}] :answer-field/correct {:db/id #edb/ref 17592186298600} :answer-field/id #uuid "dd64cf6f-11f6-5ef3-91fd-c592d03e9ba6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299388} {:answer-field/choices [{:answer/id #uuid "2a47bed5-86bf-5575-a6f3-62dc7b99c50b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186297729}] :answer-field/correct {:db/id #edb/ref 17592186297729} :answer-field/id #uuid "f1cfb69b-e49e-559e-828c-651dc0c48b86" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299450}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c61272a7-8421-5bdb-8693-8d42ca9c2c67" :question/math-academy-id "q-317494" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-3x+4y &=10 \\\\ 5x+2y &=-7,\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | $4$ |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} | {{field-3}} |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | {{field-4}} |  |\n| --- | --- | --- |\n|  | $-7$ |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | $4$ |  |  |  |  |\n|  | {{field-2}} | {{field-3}} |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n|  | $-7$ |  |  |  |  |  |\n\n." :question/worked-solution "First, notice that both $x$ and $y$ appear in each equation, all the variables are on the left-hand side, and all the constants are on the right-hand side.\n\n$$\n\\left\\{\\begin{aligned}-3x+4y &=10 \\\\ 5x+2y &=-7\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-3 & 4 \\\\ 5 & 2\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}10 \\\\ -7\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-3 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}10 \\\\ -7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb708238-1c4f-5e19-b952-7a1cae1199fc" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298437}] :answer-field/correct {:db/id #edb/ref 17592186298437} :answer-field/id #uuid "10c56e2f-c0ae-54bc-ae0e-78956ef2054b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298696} {:answer-field/choices [{:answer/id #uuid "0ffca954-c164-5a2e-875b-0abd28c1ee63" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186297624}] :answer-field/correct {:db/id #edb/ref 17592186297624} :answer-field/id #uuid "16089658-2d6e-598a-a69c-59786030f56b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298719} {:answer-field/choices [{:answer/id #uuid "c1e3aeae-9a20-54b1-bcf6-e179312cdfb3" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298403}] :answer-field/correct {:db/id #edb/ref 17592186298403} :answer-field/id #uuid "34d2db7f-f2fc-551e-be82-e24ba81e7a71" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298818} {:answer-field/choices [{:answer/id #uuid "161f1e5b-bf46-5ca1-8193-7dc4c1f6d8c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297647}] :answer-field/correct {:db/id #edb/ref 17592186297647} :answer-field/id #uuid "34e53f1f-5449-539f-a271-070f9a7b60cd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298819}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d8d92f30-ed38-54b4-8a62-755656e16597" :question/math-academy-id "q-317500" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-6y &=4 \\\\ 3x+5y\\, &=-7\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $5$ |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | $4$ |  |\n| --- | --- | --- |\n|  | {{field-4}} |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |  |  |\n|  | {{field-3}} | $5$ |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | $4$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n\n." :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. \nThe variable $x$ does not appear in the first equation, but this just means its coefficient is $0.$ So, we get\n\n$$\n\\left\\{\\begin{aligned}0x-6y &=4 \\\\ 3x+5y\\, &=-7\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & -6 \\\\ 3 & 5\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & -6 \\\\ 3 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fc1c30-8ccd-5457-8993-f07f475f8013" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186298415}] :answer-field/correct {:db/id #edb/ref 17592186298415} :answer-field/id #uuid "2477b178-6307-5735-b558-7b5c6e62c0a0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298760} {:answer-field/choices [{:answer/id #uuid "0ab496cc-788e-5652-89d7-f96603cd8005" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297607}] :answer-field/correct {:db/id #edb/ref 17592186297607} :answer-field/id #uuid "63b918f7-22b3-5376-aaa2-00533d549ab7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298973} {:answer-field/choices [{:answer/id #uuid "de44a703-88c3-5e8d-8c8b-9b29522c0607" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298503}] :answer-field/correct {:db/id #edb/ref 17592186298503} :answer-field/id #uuid "ac49caa6-1aec-575c-9de6-24bb4b87c1ed" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299219} {:answer-field/choices [{:answer/id #uuid "0dd7d52a-dd21-5b39-8a68-a746df7cf693" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186297618}] :answer-field/correct {:db/id #edb/ref 17592186297618} :answer-field/id #uuid "fcafb9f8-b362-5db3-8bd7-958e6228521a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11e074c7-4d99-5668-b58b-9eacc1e24ba9" :question/math-academy-id "q-317506" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-5x &=10 \\\\ 4y &=-12\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $4$ |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | $10$ |  |\n| --- | --- | --- |\n|  | {{field-4}} |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |  |  |\n|  | {{field-3}} | $4$ |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | $10$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n\n." :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $y$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $x$ does not appear in the second equation, which means that its coefficient is $0$ too. \n\nSo, we get\n\n$$\n\\left\\{\\begin{aligned}-5x+0y &=10 \\\\ 0x+4y &=-12\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-5 & 0 \\\\ 0 & 4\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-5 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022e6234-3d4c-5534-b14b-8dd9bdb81787" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297569}] :answer-field/correct {:db/id #edb/ref 17592186297569} :answer-field/id #uuid "0f39389f-6cf5-5175-93ea-d9025fc2b1cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298691} {:answer-field/choices [{:answer/id #uuid "4281dc0a-fa1a-57fe-ba5e-0b198d0f04b9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297821}] :answer-field/correct {:db/id #ed