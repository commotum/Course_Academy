db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288726} {:answer/id #uuid "926da738-6ea6-53a7-b613-8359f66a864b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡2+\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186289015} {:answer/id #uuid "e33f2640-c785-5dc0-acda-5e6494b2de0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{2}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186289542}] :answer-field/correct {:db/id #edb/ref 17592186288687} :answer-field/id #uuid "30b841af-b6a0-5f34-a593-ca46481cf7b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289838}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "07ddd93b-2266-558f-9ab3-369202ae0194" :question/math-academy-id "q-210752" :question/problem "$$\n\\displaystyle \\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3783aaf0-95fe-582e-9b6c-214d1b88d33f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288408} {:answer/id #uuid "37ab6ab5-1c0e-58f5-b386-e76cdaa7443e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288410} {:answer/id #uuid "4d666098-aa58-56fe-865c-a47cdc80ed88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288570} {:answer/id #uuid "be835456-2ece-556e-a15f-dfc8e8723b39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡3|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186289286} {:answer/id #uuid "efd7546d-984c-5ba3-b883-fe67852b9b22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/id #edb/ref 17592186289618}] :answer-field/correct {:db/id #edb/ref 17592186288410} :answer-field/id #uuid "9a19bf0f-f7af-52cd-8c16-c823fa1c1794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290073}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "550df46c-f0bc-5517-a411-d24ef095d3fc" :question/math-academy-id "q-210781" :question/problem "$$\n\\displaystyle \\int \\frac{3}{x{log}_{3}⁡(2x)}\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={log}_{3}⁡(2x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x{log}_{3}⁡(2x)}\\,\\text{d}x & =\\int \\frac{3}{{log}_{3}⁡(2x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{3}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡3\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =3\\operatorname{ln}⁡3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1008f91c-5312-57ff-b584-94eee41fe74d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)-2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288152} {:answer/id #uuid "1da60212-9b1b-5f90-b4ad-60a5d028fa99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)-4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288219} {:answer/id #uuid "2d0f56b4-96f6-5e10-b8c1-e96fcb0adb3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)+2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288328} {:answer/id #uuid "c400b002-970a-5f9c-b980-7c4fcc67cff4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(3t)+{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289327} {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641}] :answer-field/correct {:db/id #edb/ref 17592186289641} :answer-field/id #uuid "92070a66-23e2-56dd-9cc9-c4b8a5e22afc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290057}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c6e26edb-f404-57aa-9e8d-fef8eb7ecc78" :question/math-academy-id "q-21339" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$$\n\\displaystyle x=2\\operatorname{sin}⁡(3t)-1,\\,y=2\\operatorname{cos}⁡(2t)+2\n$$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(3t)-1) \\\\  & =2\\operatorname{cos}⁡(3t)\\cdot 3 \\\\  & =6\\operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)+2) \\\\  & =-2\\operatorname{sin}⁡(2t)\\cdot 2 \\\\  & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(6\\operatorname{cos}⁡(3t))^{2}+(-4\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{2}⁡(3t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d3de1db-0fcc-5d54-a34d-c4772f63450c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288331} {:answer/id #uuid "4d6783bc-60cb-5ebf-aed7-e258b2417e6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{16{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288571} {:answer/id #uuid "72dafc8f-1319-50ac-8575-b91418fddf5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288830} {:answer/id #uuid "7dd6ac01-4a42-5fe6-a775-9f769a7e8298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288884} {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967}] :answer-field/correct {:db/id #edb/ref 17592186288967} :answer-field/id #uuid "3cb71b35-5d29-5e3f-a2c7-defaa9483e1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289861}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97f4a57c-d78d-5eaa-81d0-22dc3ac7dd99" :question/math-academy-id "q-21347" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$$\n\\displaystyle x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{sin}⁡(3t)\n$$\nfrom $t=\\frac{\\pi }{4}$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))=3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{(2\\operatorname{cos}⁡(2t))^{2}+(3\\operatorname{cos}⁡(3t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69475fb9-4639-5aee-af40-ad859a263a2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186288774} {:answer/id #uuid "91284f31-5e28-57a6-85bb-2b392b818d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289008} {:answer/id #uuid "a96e4ea4-d995-5d4a-b26e-2d37c11a1916" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289155} {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} {:answer/id #uuid "ef891aab-5620-5243-8798-2c0bd3ae8835" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(t)-{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289612}] :answer-field/correct {:db/id #edb/ref 17592186289176} :answer-field/id #uuid "0e6962ab-6088-50b4-b289-81a33c131c7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289765}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1524414a-eeb0-5a99-93da-15745003f6ea" :question/math-academy-id "q-21354" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$$\n\\displaystyle x=\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t),\\,y=t-\\operatorname{sin}⁡(t)\n$$\nfrom $t=0$ to $t=\\frac{\\pi }{4}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t))=\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡(t))=1-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t))^{2}+(1-\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)+2\\operatorname{cos}⁡(t)\\operatorname{sin}⁡(t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346358f5-312e-5c8a-9238-6be633b31e62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}x-\\operatorname{cos}x+C" :db/id #edb/ref 17592186288379} {:answer/id #uuid "419bbacf-36c2-544f-888a-5bf28372bd28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}x+\\operatorname{cos}x+C" :db/id #edb/ref 17592186288478} {:answer/id #uuid "70205983-7a23-51c1-a345-bf2ec479a0bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}x+C" :db/id #edb/ref 17592186288812} {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}x+\\operatorname{cos}x+C" :db/id #edb/ref 17592186289261} {:answer/id #uuid "c6a193d2-0ce7-5a28-86c4-834fae7f7271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}x-\\operatorname{cos}x+C" :db/id #edb/ref 17592186289350}] :answer-field/correct {:db/id #edb/ref 17592186289261} :answer-field/id #uuid "0c59fbc8-d124-507b-af30-f117e1976ad1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289758}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d70818e9-1705-53df-abe3-9e6e72f287c6" :question/math-academy-id "q-2161" :question/problem "$$\n\\displaystyle \\int (cos⁡x-sin⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (cos⁡x-sin⁡x)\\,\\text{d}x & =\\int cos⁡x\\,\\text{d}x-\\int sin⁡x\\,\\text{d}x \\\\  & =sin⁡x-(-cos⁡x)+C \\\\  & =sin⁡x+cos⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd0c250-5bf4-502b-ac7f-de044cfaaa10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{csc}x+\\operatorname{tan}x+C" :db/id #edb/ref 17592186288340} {:answer/id #uuid "3f822d39-9367-56e2-94ac-4e46c353ca47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{csc}x-\\operatorname{tan}x+C" :db/id #edb/ref 17592186288464} {:answer/id #uuid "74d923d2-3efc-5ca9-941b-f2721f9ebb87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{csc}x+\\operatorname{sec}x+C" :db/id #edb/ref 17592186288844} {:answer/id #uuid "abf937ba-cc12-532c-bb17-a12d2975c76f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{cot}x+\\operatorname{tan}x+C" :db/id #edb/ref 17592186289171} {:answer/id #uuid "ba90d1ee-fd42-5b53-b6d2-9a950b91bbcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{csc}x+\\operatorname{tan}x+C" :db/id #edb/ref 17592186289264}] :answer-field/correct {:db/id #edb/ref 17592186289264} :answer-field/id #uuid "1f887537-7c98-501a-bbfa-38699eb068a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289808}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "150e96e0-2dad-5989-ac38-041fb3f1fdd0" :question/math-academy-id "q-2164" :question/problem "$$\n\\displaystyle \\int (4csc⁡xcot⁡x+{sec}^{2}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int csc⁡xcot⁡x\\,\\text{d}x & =-csc⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (4csc⁡xcot⁡x+{sec}^{2}⁡x)\\,\\text{d}x & =\\int 4csc⁡xcot⁡x\\,\\text{d}x+\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =4(-csc⁡x)+tan⁡x+C \\\\  & =-4csc⁡x+tan⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c728a9-8853-5dbb-9a52-ac3ca4d3417c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}t" :db/id #edb/ref 17592186288191}] :answer-field/correct {:db/id #edb/ref 17592186288191} :answer-field/id #uuid "02bb05bf-a1f7-51cf-8ae2-2094c691d008" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186289736}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "181428c3-2e2d-57bb-a4e9-bf41e0f64825" :question/math-academy-id "q-223096" :question/problem "$$\nT(t)=\\frac{1}{5}(-4\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j+3\\,k).\n$$\n\nThe unit tangent vector to a curve at an arbitrary point is given above. Find the principal normal vector to that curve at an arbitrary point on the curve.\n\n$N(t)=$\n{{field-1}}\n$i\\,-\\operatorname{sin}⁡t\\,j$" :question/worked-solution "First, we calculate ${T}^{′}(t):$ \n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{5}(-4\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j+3\\,k)) \\\\  & =\\frac{1}{5}(-4\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+4\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(3)\\,k) \\\\  & =-\\frac{4}{5}(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\frac{4}{5}‖\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j‖ \\\\  & =\\frac{4}{5}\\sqrt{(\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t)^{2}+{0}^{2}} \\\\  & =\\frac{4}{5}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{-\\frac{4}{5}(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)}{\\frac{4}{5}} \\\\  & =-\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d617821-6685-519e-9a4d-28281ac958a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}(t+1)" :db/id #edb/ref 17592186288333} {:answer/id #uuid "099d7c1b-7772-5cc6-9777-a7e269acac3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sin(t+1)" :db/id #edb/ref 17592186483587}] :answer-field/correct {:db/id #edb/ref 17592186483587} :answer-field/id #uuid "5ee93b5a-7a7f-5de6-b120-52987f2cfbac" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186289935}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "705b4f99-555b-54e9-8531-2285040b4156" :question/math-academy-id "q-223101" :question/problem "$$\nT(t)=\\frac{1}{2}(\\operatorname{sin}⁡(t+1)\\,i+\\sqrt{3}\\,j+\\operatorname{cos}⁡(t+1)\\,k).\n$$\n\nThe unit tangent vector to a curve at an arbitrary point is given above. Find the principal normal vector to that curve at an arbitrary point on the curve.\n\n$N(t)=$\n$\\operatorname{cos}⁡(t+1)\\,i\\,-$\n{{field-1}}\n$k$" :question/worked-solution "First, we calculate ${T}^{′}(t):$ \n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}(\\operatorname{sin}⁡(t+1)\\,i+\\sqrt{3}\\,j+\\operatorname{cos}⁡(t+1)\\,k)) \\\\  & =\\frac{1}{2}(\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t+1))\\,i+\\sqrt{3}\\frac{\\text{d}}{\\text{d}t}(1)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(t+1))\\,k) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(t+1)\\,i-\\operatorname{sin}⁡(t+1)\\,k)\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\frac{1}{2}‖\\operatorname{cos}⁡(t+1)\\,i-\\operatorname{sin}⁡(t+1)\\,k‖ \\\\  & =\\frac{1}{2}\\sqrt{(\\operatorname{cos}⁡(t+1))^{2}+{0}^{2}+(-\\operatorname{sin}⁡(t+1))^{2}} \\\\  & =\\frac{1}{2}\\sqrt{{cos}^{2}⁡(t+1)+{sin}^{2}⁡(t+1)} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{\\frac{1}{2}(\\operatorname{cos}⁡(t+1)\\,i-\\operatorname{sin}⁡(t+1)\\,k)}{\\left(\\frac{1}{2}\\right)} \\\\  & =\\operatorname{cos}⁡(t+1)\\,i-\\operatorname{sin}⁡(t+1)\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b065d0c4-ae1f-50a2-b8ce-abadb16cab89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}t-\\operatorname{cos}t" :db/id #edb/ref 17592186289199}] :answer-field/correct {:db/id #edb/ref 17592186289199} :answer-field/id #uuid "9990184e-f59b-52cc-8832-d0f30c08ed1b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186290072}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e58e7b11-695c-5012-abe2-6643a16064cc" :question/math-academy-id "q-223102" :question/problem "$$\nT(t)=\\frac{\\sqrt{2}}{2}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩.\n$$\n\nThe unit tangent vector to a curve at an arbitrary point is given above. Find the principal normal vector to that curve at an arbitrary point on the curve.\n\n$N(t)=-\\frac{\\sqrt{2}}{2}$\n$⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,$\n{{field-1}}\n$⟩$" :question/worked-solution "First, we calculate ${T}^{′}(t):$ \n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\sqrt{2}}{2}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩) \\\\  & =\\frac{\\sqrt{2}}{2}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{\\sqrt{2}}{2}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t+\\operatorname{cos}⁡t⟩ \\\\  & =-\\frac{\\sqrt{2}}{2}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =|-\\frac{\\sqrt{2}}{2}|‖⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩‖ \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{sin}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{2({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =1\\end{aligned}\n$$\n\nFinally, we we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{-\\frac{\\sqrt{2}}{2}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩}{1} \\\\  & =-\\frac{\\sqrt{2}}{2}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "674f313a-77f0-5fc8-abb7-91c3e1a7184e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}t" :db/id #edb/ref 17592186288758} {:answer/id #uuid "999808ca-0444-5335-ac02-8d182fdfd0a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sin t" :db/id #edb/ref 17592186442585}] :answer-field/correct {:db/id #edb/ref 17592186442585} :answer-field/id #uuid "88606f6e-77e8-504e-bf1e-6d51d3bd6834" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186290029}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0891613-fa7a-56c3-a9d8-1b98ea108f48" :question/math-academy-id "q-223107" :question/problem "Given the curve $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+2\\sqrt{2}\\,t\\,k$, find the principal normal vector $N(t)$ at an arbitrary point on the curve.\n\n$N(t)=$\n{{field-1}}\n$i\\,-\\operatorname{cos}⁡t$\n\n$j$" :question/worked-solution "First, we find the unit tangent vector $T(t).$ To do this, we calculate ${r}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}\\,t)\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\sqrt{2}\\,k \\\\  \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(\\operatorname{cos}⁡t)^{2}+(-\\operatorname{sin}⁡t)^{2}+(2\\sqrt{2})^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t+8} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nTherefore, the unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\sqrt{2}\\,k}{3} \\\\  & =\\frac{1}{3}\\operatorname{cos}⁡t\\,i-\\frac{1}{3}\\operatorname{sin}⁡t\\,j+\\frac{2}{3}\\sqrt{2}\\,k.\\end{aligned}\n$$\n\nNext, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i-\\frac{1}{3}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{3}\\sqrt{2})\\,k \\\\  & =-\\frac{1}{3}\\operatorname{sin}⁡t\\,i-\\frac{1}{3}\\operatorname{cos}⁡t\\,j+0\\,k \\\\  & =-\\frac{1}{3}\\operatorname{sin}⁡t\\,i-\\frac{1}{3}\\operatorname{cos}⁡t\\,j \\\\  \\\\ ‖{T}^{′}(t)‖ & =\\sqrt{{(-\\frac{1}{3}\\operatorname{sin}⁡t)}^{2}+{(-\\frac{1}{3}\\operatorname{cos}⁡t)}^{2}+{0}^{2}} \\\\  & =\\sqrt{\\frac{1}{9}({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{-\\frac{1}{3}\\operatorname{sin}⁡t\\,i-\\frac{1}{3}\\operatorname{cos}⁡t\\,j}{\\left(\\frac{1}{3}\\right)} \\\\  & =-\\operatorname{sin}⁡t\\,i-\\operatorname{cos}⁡t\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4961a14-388a-5b76-9063-6584b2a0778a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}t" :db/id #edb/ref 17592186289644}] :answer-field/correct {:db/id #edb/ref 17592186289644} :answer-field/id #uuid "7cef406a-ea9f-5a4c-8a84-bd5cc907ac0d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186290004}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "08b660d8-2de0-57eb-af5f-98c5287529ec" :question/math-academy-id "q-223114" :question/problem "Given the curve $r(t)=⟨4\\operatorname{cos}⁡t,\\,3t,\\,-4\\operatorname{sin}⁡t⟩$, find the principal normal vector $N(t)$ at an arbitrary point on the curve.\n\n$N(t)=⟨$\n{{field-1}}\n$,\\,0\\,,\\operatorname{sin}⁡t⟩$" :question/worked-solution "First, we find the unit tangent vector $T(t).$ To do this, we calculate ${r}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(3t),\\,\\frac{\\text{d}}{\\text{d}t}(-4\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-4\\operatorname{sin}⁡t,\\,3,\\,-4\\operatorname{cos}⁡t⟩ \\\\  \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(3)^{2}+(-4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16({sin}^{2}⁡t+{cos}^{2}⁡t)+9} \\\\  & =\\sqrt{25} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{5}⟨-4\\operatorname{sin}⁡t,\\,3,\\,-4\\operatorname{cos}⁡t⟩ \\\\  & =⟨-\\frac{4}{5}\\operatorname{sin}⁡t,\\,\\frac{3}{5},\\,-\\frac{4}{5}\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nNext, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\frac{4}{5}\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{3}{5}\\right),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{4}{5}\\operatorname{cos}⁡t)⟩ \\\\  & =⟨-\\frac{4}{5}\\operatorname{cos}⁡t,\\,0,\\,\\frac{4}{5}\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{4}{5}⟨-\\operatorname{cos}⁡t,\\,0,\\,\\operatorname{sin}⁡t⟩ \\\\  \\\\ ‖{T}^{′}(t)‖ & =\\sqrt{{(-\\frac{4}{5}\\operatorname{cos}⁡t)}^{2}+{0}^{2}+{(\\frac{4}{5}\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\sqrt{\\frac{16}{25}({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{\\frac{4}{5}⟨-\\operatorname{cos}⁡t,\\,0,\\,\\operatorname{sin}⁡t⟩}{\\left(\\frac{4}{5}\\right)} \\\\  & =⟨-\\operatorname{cos}⁡t,\\,0,\\,\\operatorname{sin}⁡t⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0273afcf-1982-5569-8348-f10a8e77aad7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186465881} {:answer/id #uuid "1526315c-74f6-5bb1-a15f-52ce2cf483f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186465882}] :answer-field/correct {:db/id #edb/ref 17592186465882} :answer-field/id #uuid "7a11075d-7e91-53e3-8287-8ac5fd97acb2" :answer-field/key "$x=\\frac{\\pi }{4}$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466784} {:answer-field/choices [{:answer/id #uuid "c496d87e-e47e-5f9d-8298-d6c0c32cca85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186465883} {:answer/id #uuid "9b5f781a-5bc0-57ae-80e8-0675eb804587" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186465884}] :answer-field/correct {:db/id #edb/ref 17592186465884} :answer-field/id #uuid "d88e12bf-9078-5424-8848-e2cb1e920461" :answer-field/key "${f}^{″}(\\frac{\\pi }{4})<0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466785} {:answer-field/choices [{:answer/id #uuid "c3910ecb-9299-5ff4-844f-6a07a3aa9e28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186465885} {:answer/id #uuid "9fbca59f-a430-5c3d-8b2e-b5eb1ff6889e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186465886}] :answer-field/correct {:db/id #edb/ref 17592186465885} :answer-field/id #uuid "5770f9b6-676c-5c90-9086-6fea3b63ca67" :answer-field/key "$f(x)$ has a relative minimum at $x=\\frac{\\pi }{4}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466786} {:answer-field/choices [{:answer/id #uuid "6366535a-8f24-51ba-b21e-f43ec8b0bf98" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186668511} {:answer/id #uuid "2d921b3c-deca-594b-b042-9dd5735a7c75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186668512}] :answer-field/correct {:db/id #edb/ref 17592186668511} :answer-field/id #uuid "aea63e81-9533-5487-95cb-b0e89ba5e91f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186668833}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "527ec064-c6b0-5d4a-ac97-7dea39646f9c" :question/math-academy-id "q-22495" :question/problem "For the function $f(x)=\\operatorname{sin}⁡x\\operatorname{cos}⁡x,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify whether $x=\\frac{\\pi }{4}$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=\\operatorname{sin}⁡x\\operatorname{cos}⁡x,$ we get\n\n$$\n{f}^{′}(x)=\\operatorname{cos}⁡x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x\\operatorname{sin}⁡x={cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡(2x),\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2x) & =0 \\\\ 2x & =\\frac{\\pi }{2}+n\\pi , \\\\ x & =\\frac{\\pi }{4}+\\frac{n\\pi }{2},\\end{aligned}\n$$\n\nwhere $n$ is an integer.\n\nSo we have critical points at $x=\\frac{\\pi }{4}+\\frac{n\\pi }{2}.$ We're interested in the critical point $x=\\frac{\\pi }{4}.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-2\\operatorname{sin}⁡(2x),\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=\\frac{\\pi }{4}$, we get\n\n$$\n{f}^{″}\\left(\\frac{\\pi }{4}\\right)=-2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=-2<0.\n$$\n\nThe second derivative is negative at $x=\\frac{\\pi }{4},$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=\\frac{\\pi }{4}$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}\\left(\\frac{\\pi }{4}\\right)<0\\,✓$\n\n- $f(x)$ has a relative *maximum* at $x=\\frac{\\pi }{4}\\,\\times $\n\nTherefore, the correct answer is “$x=\\frac{\\pi }{4}$ is a critical point of $f(x)$”; ${f}^{″}\\left(\\frac{\\pi }{4}\\right)<0$ only."} {:db/id #edb/ref 17592186290437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f1030c-14e2-59e9-a189-ae72636d7cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{x}+\\frac{{5}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186288429} {:answer/id #uuid "831fe1aa-d1a9-59de-914e-66c8e45135cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+{2}^{x}ln⁡2+C" :db/id #edb/ref 17592186288914} {:answer/id #uuid "a92a1f84-319a-5ffc-912d-da344601d75d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{x}}{5}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289153} {:answer/id #uuid "bfec5a66-eb21-510f-ac20-724d2da23f30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+\\frac{x}{ln⁡2}+C" :db/id #edb/ref 17592186289301} {:answer/id #uuid "f611671a-7317-5307-aefb-d9046cadfb32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289655}] :answer-field/correct {:db/id #edb/ref 17592186289655} :answer-field/id #uuid "6b01bf45-11e5-550e-91d5-6d78dcabad9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289964}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3b4a92d-a353-507a-becb-bee354a44152" :question/math-academy-id "q-2277" :question/problem "$$\n\\displaystyle \\int (5{e}^{x}+{2}^{x})\\,\\text{d}x=\n$$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x & =5\\int {e}^{x}\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b380ef8c-3cb1-5a1b-adc6-78611268d1fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.792" :db/id #edb/ref 17592186289217}] :answer-field/correct {:db/id #edb/ref 17592186289217} :answer-field/id #uuid "1daa0351-1016-577a-9f79-e088b3a73a70" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186289805}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8de7fdc-d84b-57e9-af41-b859fe4ea824" :question/math-academy-id "q-228897" :question/problem "If ${e}^{x}=6,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{x} & =6 \\\\ ln⁡({e}^{x}) & =ln⁡(6) \\\\ x & =ln⁡(6)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈1.792\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186290443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078c6f54-8a90-570d-b35c-a74273909664" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\operatorname{cot}⁡(3x)}{3y+1}" :db/id #edb/ref 17592186288093} {:answer/id #uuid "2246442e-020d-574a-8441-1430c141e7c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{cot}^{2}⁡(3x)}{2y+1}" :db/id #edb/ref 17592186288251} {:answer/id #uuid "a389ed33-85ab-5efc-b38c-37f637636ddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{sec}^{2}⁡(3x)}{y+1}" :db/id #edb/ref 17592186289125} {:answer/id #uuid "b3b1f7f5-2930-5b7c-b842-100eb308f5ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{sec}^{2}⁡(3x)}{2y+1}" :db/id #edb/ref 17592186289219} {:answer/id #uuid "cb43772c-130c-57f1-8c10-6233e01d16ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\operatorname{cot}⁡(3x)}{y+1}" :db/id #edb/ref 17592186289379}] :answer-field/correct {:db/id #edb/ref 17592186289219} :answer-field/id #uuid "0e55e3cc-8566-5ead-b496-998e3c5f2250" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289764}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "610d7896-a073-528d-972b-ac6b8950750a" :question/math-academy-id "q-2290" :question/problem "Given that $\\operatorname{tan}⁡(3x)-{y}^{2}=y,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\begin{aligned}\\operatorname{tan}⁡(3x)-{y}^{2} & =y \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x)-{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x))-\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ 3{sec}^{2}⁡(3x)-2y\\left(\\frac{\\text{d}y}{\\text{d}x}\\right) & =\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}3{sec}^{2}⁡(3x) & =\\frac{\\text{d}y}{\\text{d}x}(2y+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3{sec}^{2}⁡(3x)}{2y+1}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35c7e725-b76a-5ca3-8f68-81dde24e12fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "tan⁡\\theta =2\\sqrt{3}" :db/id #edb/ref 17592186288393} {:answer/id #uuid "47f9a517-21ec-5bde-9415-58fb02a4d95f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "tan⁡\\theta =\\sqrt{3}" :db/id #edb/ref 17592186288529} {:answer/id #uuid "67d96bb0-aef1-5c39-b7de-845d48da5707" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "tan⁡\\theta =7\\sqrt{11}" :db/id #edb/ref 17592186288761} {:answer/id #uuid "ae74efb7-3f7b-5281-8d41-2f4067dc2059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "tan⁡\\theta =-2\\sqrt{3}" :db/id #edb/ref 17592186289188} {:answer/id #uuid "e6308953-e63f-50f5-9353-0e539006938f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "tan⁡\\theta =-\\sqrt{3}" :db/id #edb/ref 17592186289559}] :answer-field/correct {:db/id #edb/ref 17592186288529} :answer-field/id #uuid "bd274261-7c8a-5928-bc7a-5397a25e3e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290141}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0ca170ad-d931-5618-b051-e0ab68f9da15" :question/math-academy-id "q-23307" :question/problem "If $cos⁡\\theta =-\\frac{1}{2}$ and ${180}^{∘}<\\theta <{270}^{∘},$ then what is the value of $tan⁡\\theta ?$" :question/worked-solution "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/78/7873579bb5dd1976330ec24f13b30dd384f916cf23bbf48aac4b2a522ee9548a.png)\n\nWe're given that $cos⁡\\theta =-\\frac{1}{2}.$ We can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =-\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe select the negative answer since $sin⁡\\theta $ is negative in the third quadrant. So, $sin⁡\\theta =-\\frac{\\sqrt{3}}{2}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{\\left(-\\frac{\\sqrt{3}}{2}\\right)}{\\left(-\\frac{1}{2}\\right)}=\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186290461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277373e3-169a-586e-ad29-c1c31afaae90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186288292} {:answer/id #uuid "6a095a67-ddbe-5bf7-9a39-f8782eff2ea0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186288780} {:answer/id #uuid "94d134d0-8d56-5307-b137-977c53f49ff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186289029} {:answer/id #uuid "ae3d194e-cae3-5d1d-9ecd-a175924b168f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186289186} {:answer/id #uuid "cc7343e7-6e46-504c-b190-873fccc910a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186289392}] :answer-field/correct {:db/id #edb/ref 17592186289392} :answer-field/id #uuid "78b2f4eb-6782-5d0a-9ec1-3e356d9f2e48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289993}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d60ea30f-16e8-5e44-938b-3986249a44fc" :question/math-academy-id "q-23526" :question/problem "$$\n\\displaystyle \\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\n$$" :question/worked-solution "Since both fractions are over a common denominator, we can add them. This gives\n\n$$\n\\begin{aligned}\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1-2{cos}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$\n\nThen, we use ${cos}^{2}⁡\\theta =1-{sin}^{2}⁡\\theta $ to simplify the expression in the numerator:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\\operatorname{sin}⁡\\theta .\n$$"} {:db/id #edb/ref 17592186290464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac8f83a-3129-5a17-9f82-1d0be2333401" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186288113} {:answer/id #uuid "3a3acab6-0c3d-5bfc-b385-f134c9a724d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186288434} {:answer/id #uuid "4a78d6a3-4d88-5d31-9940-4d232728d6d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186288547} {:answer/id #uuid "b689a2bb-e96a-54ae-8d36-885dce884ae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186289241} {:answer/id #uuid "ccfa3b18-d5b5-5f3f-a5f9-6bf64f095776" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta -1" :db/id #edb/ref 17592186289397}] :answer-field/correct {:db/id #edb/ref 17592186288113} :answer-field/id #uuid "51541fdb-f065-5267-b858-e8fc8acbc41f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289907}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88ca457f-2b23-5dac-9e86-c6ad9814fd4a" :question/math-academy-id "q-23597" :question/problem "Simplify $(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1).$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1)={sec}^{2}⁡\\theta -1\n$$\n\nThen, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n{sec}^{2}⁡\\theta -1={tan}^{2}⁡\\theta \n$$\n\nTherefore, we conclude that\n\n$$\n(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1)={tan}^{2}⁡\\theta .\n$$"} {:db/id #edb/ref 17592186290471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "674c0513-7905-504c-92c1-3c6f01a96ca3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288757} {:answer/id #uuid "81b4d543-b017-53b6-80b4-aff42e94822a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288906} {:answer/id #uuid "bfd660ea-b004-5de1-b71b-924e8cf8c0b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186289299} {:answer/id #uuid "d7107bd8-b2ac-52a7-b60c-6160baa28359" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186289462} {:answer/id #uuid "ffd7d41d-f0c4-5dc8-b2c1-2dba7cb0822f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186289728}] :answer-field/correct {:db/id #edb/ref 17592186288906} :answer-field/id #uuid "daefc306-4b4e-51e9-9f0d-8eac8144a5ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290198}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8dd70fdd-1e42-5626-9c90-56ff228e6dc2" :question/math-academy-id "q-23640" :question/problem "Simplify ${csc}^{4}⁡x-2{csc}^{2}⁡x\\cdot {cot}^{2}⁡x+{cot}^{4}⁡x.$" :question/worked-solution "First,  notice that the given expression is a perfect square:\n\n$$\n\\begin{aligned}{csc}^{4}⁡x-2{csc}^{2}⁡x\\,\\cdot \\,{cot}^{2}⁡x+{cot}^{4}⁡x & ={({csc}^{2}⁡x-{cot}^{2}⁡x)}^{2}\\end{aligned}\n$$\n\nNow, using the  identity ${csc}^{2}⁡x-{cot}^{2}⁡x=1$, we have\n\n$$\n\\begin{aligned}{({csc}^{2}⁡x-{cot}^{2}⁡x)}^{2} & =(1)^{2} \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1730c016-e47d-5e89-958d-f1d37076bc34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{csc}^{4}⁡(2x)+1" :db/id #edb/ref 17592186288187} {:answer/id #uuid "a48f3bf6-66ee-57a6-bfc3-1b5a76482e83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{3}⁡(2x)" :db/id #edb/ref 17592186289129} {:answer/id #uuid "ac0c00e8-abe7-57ac-a6d5-a08ece28ede5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{csc}^{2}⁡x" :db/id #edb/ref 17592186289172} {:answer/id #uuid "dcec233a-8749-503b-be0c-c8f00fcf4cf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{csc}^{4}⁡(2x)" :db/id #edb/ref 17592186289502} {:answer/id #uuid "e790c4a1-bfd9-57b0-a129-7dcd5baaeb49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{3}⁡(2x)+1" :db/id #edb/ref 17592186289570}] :answer-field/correct {:db/id #edb/ref 17592186289502} :answer-field/id #uuid "47ed917d-4a74-54a6-8dc0-96d9ad86ffc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289888}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b551a57b-8ebe-5d22-82e3-03b19ea7ac17" :question/math-academy-id "q-23641" :question/problem "Simplify $4{csc}^{2}⁡(2x)+4{csc}^{2}⁡(2x)\\cdot {cot}^{2}⁡(2x).$" :question/worked-solution "First, we factor the $4{csc}^{2}⁡(2x)$ from the first two terms:\n\n$$\n\\begin{aligned}4{csc}^{2}⁡(2x)+4{csc}^{2}⁡(2x)\\cdot {cot}^{2}⁡(2x) & =4{csc}^{2}⁡(2x)\\cdot (1+{cot}^{2}⁡(2x))\\end{aligned}\n$$\n\nNow, using the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}4{csc}^{2}⁡(2x)\\cdot (1+{cot}^{2}⁡(2x)) & =4{csc}^{2}⁡(2x)\\cdot {csc}^{2}⁡(2x) \\\\  & =4{csc}^{4}⁡(2x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb8834a-50b7-5416-880c-a8fd45d432bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186288135} {:answer/id #uuid "13ea8bc8-393e-5910-9dfa-5a1ece3971a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288168} {:answer/id #uuid "526475f0-7a67-5902-ad09-03aaeaa90b76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288604} {:answer/id #uuid "69cdaa41-514c-59d8-8b47-dc49563092c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186288778} {:answer/id #uuid "d3227cac-a33f-5639-a941-a9ded844e2ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186289430}] :answer-field/correct {:db/id #edb/ref 17592186288168} :answer-field/id #uuid "6d1ac430-1346-5392-97ab-d61f5c529673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289970}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4adf28a2-e005-5bdd-b207-f7c30d8f8ad8" :question/math-academy-id "q-23642" :question/problem "Simplify ${csc}^{4}⁡\\theta -{cot}^{4}⁡\\theta -2{cot}^{2}⁡\\theta .$" :question/worked-solution "First, let's recall the following identity:\n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, we get\n\n$$\n\\begin{aligned}{csc}^{4}⁡\\theta -{cot}^{4}⁡\\theta -2{cot}^{2}⁡\\theta  & ={csc}^{4}⁡\\theta -{({cot}^{2}⁡\\theta )}^{2}-2{cot}^{2}⁡\\theta  \\\\  & ={csc}^{4}⁡\\theta -({csc}^{2}⁡\\theta -1)^{2}-2({csc}^{2}⁡\\theta -1) \\\\  & ={csc}^{4}⁡\\theta -({csc}^{4}⁡\\theta -2{csc}^{2}⁡\\theta +1)-2{csc}^{2}⁡\\theta +2 \\\\  & ={csc}^{4}⁡\\theta -{csc}^{4}⁡\\theta +2{csc}^{2}⁡\\theta -1-2{csc}^{2}⁡\\theta +2 \\\\  & =\\cancel{{csc}^{4}⁡\\theta }-\\cancel{{csc}^{4}⁡\\theta }+\\cancel{2{csc}^{2}⁡\\theta }-1-\\cancel{2{csc}^{2}⁡\\theta }+2 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b893e88-6c9a-56e9-8608-e0b4080028b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta -1" :db/id #edb/ref 17592186288208} {:answer/id #uuid "1e732542-cd64-5532-9f1e-2a8cd91d6245" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186288227} {:answer/id #uuid "27b9b855-3df9-595c-8a7c-7a6e47eab97e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186288295} {:answer/id #uuid "2e420882-7834-5bd3-99e2-7a78312dea0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta +1" :db/id #edb/ref 17592186288344} {:answer/id #uuid "9b3dee33-fa21-5a9a-8f07-0284d65f8771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186289072}] :answer-field/correct {:db/id #edb/ref 17592186289072} :answer-field/id #uuid "1fe08a40-82a7-5441-b916-6de2c793f998" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289809}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bc8dd438-a2fc-517c-b7e9-e06f0f739289" :question/math-academy-id "q-23796" :question/problem "${csc}^{2}⁡\\theta ({tan}^{2}⁡\\theta -{sin}^{2}⁡\\theta )=$" :question/worked-solution "First, we recall the following identities: \n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\,\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta }\\,\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta }\n$$\n\nNext, we expand the parentheses and use the above identities, as follows:\n\n$$\n\\begin{aligned}{csc}^{2}⁡\\theta ({tan}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) & ={csc}^{2}⁡\\theta \\cdot {tan}^{2}⁡\\theta -{csc}^{2}⁡\\theta \\cdot {sin}^{2}⁡\\theta  \\\\  & =\\frac{1}{{sin}^{2}⁡\\theta }\\cdot \\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }-\\frac{1}{{sin}^{2}⁡\\theta }\\cdot {sin}^{2}⁡\\theta  \\\\  & =\\frac{1}{\\cancel{{sin}^{2}⁡\\theta }}\\cdot \\frac{\\cancel{{sin}^{2}⁡\\theta }}{{cos}^{2}⁡\\theta }-\\frac{1}{\\cancel{{sin}^{2}⁡\\theta }}\\cdot \\cancel{{sin}^{2}⁡\\theta } \\\\  & =\\frac{1}{{cos}^{2}⁡\\theta }-1 \\\\  & ={sec}^{2}⁡\\theta -1\\end{aligned}\n$$\n\nFinally, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nWe can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}{sec}^{2}⁡\\theta -1 & ={tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{csc}^{2}⁡\\theta ({tan}^{2}⁡\\theta -{sin}^{2}⁡\\theta )={tan}^{2}⁡\\theta .\n$$"} {:db/id #edb/ref 17592186290507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045ea7df-d48b-5101-9c0c-7774dc6805c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186288062} {:answer/id #uuid "4d31c233-2e4c-57f7-9920-b65073d0d7ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288566} {:answer/id #uuid "64c5cf3d-8049-5124-af6a-dce315f146c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288745} {:answer/id #uuid "7951f08c-4d89-5398-9695-a3e5c15037b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288867} {:answer/id #uuid "d4ccec9a-d724-59c9-bf5f-e71a3038702e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186289445}] :answer-field/correct {:db/id #edb/ref 17592186288745} :answer-field/id #uuid "008e8235-fe77-52a6-94f1-aa6a712b1be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289730}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a183fbf8-0afb-55d8-9c23-9f82dba8cb3e" :question/math-academy-id "q-23799" :question/problem "$$\n\\displaystyle \\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }=\n$$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta (1-{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nNext, we rewrite the numerator using $1-{sin}^{2}⁡\\theta ={cos}^{2}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta (1-{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta {cos}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\operatorname{cos}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }}{2\\operatorname{sin}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }} \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nThen, we rewrite $\\operatorname{tan}⁡\\theta $ using its definition and simplify further:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{sin}⁡\\theta }}{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\cancel{\\operatorname{sin}⁡\\theta }} \\\\  & =\\frac{1}{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2} \\\\  & =\\frac{1}{\\cancel{\\operatorname{cos}⁡\\theta }}\\cdot \\frac{\\cancel{\\operatorname{cos}⁡\\theta }}{2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }=\\frac{1}{2}\n$$"} {:db/id #edb/ref 17592186290510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e9f8a16-ff09-5f79-a6bf-cbb7ae4b2cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡x+1" :db/id #edb/ref 17592186288574} {:answer/id #uuid "6fd70fe9-cd2b-54a0-92ed-673217cf8585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186288808} {:answer/id #uuid "9cc9663d-cbb3-5fdb-a3c0-1f14b51a5538" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186289088} {:answer/id #uuid "bf53601a-1c08-59ec-9a42-2570f16e5525" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186289293} {:answer/id #uuid "efc6802f-4229-5f81-ab18-3d63117f754c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x+1" :db/id #edb/ref 17592186289617}] :answer-field/correct {:db/id #edb/ref 17592186288808} :answer-field/id #uuid "64ec8b3f-8125-5231-aebe-9acb5e4b9349" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289948}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2b71b00-c11b-5c0b-9ab2-a575a74118da" :question/math-academy-id "q-23847" :question/problem "$({sin}^{2}⁡x+{cos}^{2}⁡x)+{tan}^{2}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nAlso, recall the Pythagorean formula for sines and cosines:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\n$$\n\nUsing the above identities, we can simplify our expression as follows:\n\n$$\n\\begin{aligned}({sin}^{2}⁡x+{cos}^{2}⁡x)+{tan}^{2}⁡x & =1+{tan}^{2}⁡x \\\\  & ={sec}^{2}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074fdb0b-a308-592d-95a7-627490475229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186288090} {:answer/id #uuid "5783022f-4924-5f6c-9cae-555095fa0e46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186288640} {:answer/id #uuid "90b88db6-bab3-5a4c-99fa-584338a46a92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186289002} {:answer/id #uuid "cf687924-3c7d-5b1e-a02e-efa81c08aab6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186289416} {:answer/id #uuid "db309d7c-29f6-5802-ae1d-a51c0aae9f9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186289494}] :answer-field/correct {:db/id #edb/ref 17592186288640} :answer-field/id #uuid "a1dd2961-41df-5267-b65a-47c8ee4b24c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290090}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a349287-5d4c-537c-9bb0-00fd8c054f79" :question/math-academy-id "q-23849" :question/problem "Simplify $\\frac{{cot}^{2}⁡x}{{csc}^{2}⁡x}-1+{sin}^{2}⁡x$" :question/worked-solution "First, we operate the first two terms, as follows:\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x}{{csc}^{2}⁡x}-1+{sin}^{2}⁡x & =\\frac{({cot}^{2}⁡x-{csc}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x \\\\  & =\\frac{-({csc}^{2}⁡x-{cot}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡x-{cot}^{2}⁡x=1,$ we get\n\n$$\n\\begin{aligned}\\frac{-({csc}^{2}⁡x-{cot}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x & =\\frac{-1}{{csc}^{2}⁡x}+{sin}^{2}⁡x \\\\  & =-{sin}^{2}⁡x+{sin}^{2}⁡x \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08139daf-29b8-522c-86f5-f4b319f2f128" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}sin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186288095} {:answer/id #uuid "1e48d6b6-0438-5f89-a52d-d8eb2780f6d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{xsin⁡x-2cos⁡x}{10{x}^{4}}" :db/id #edb/ref 17592186288226} {:answer/id #uuid "325a8965-b65d-5099-9f7f-4f1627e15fe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{sin⁡x-cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186288360} {:answer/id #uuid "35245c0f-50c6-5ecf-911b-c14b9458549b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186288387} {:answer/id #uuid "f8a5b569-bd3b-52ae-9b0c-22db66e06b6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{sin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186289668}] :answer-field/correct {:db/id #edb/ref 17592186288387} :answer-field/id #uuid "b894772b-c0c7-50ad-9f3f-8c10e4604ab7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290134}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3b0fa11c-feb9-540f-a74b-38792fbe2335" :question/math-academy-id "q-2385" :question/problem "If $f(x)=\\frac{cos⁡x}{10{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=cos⁡x$ and $v(x)=10{x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(-sin⁡x)(10{x}^{2})-(cos⁡x)(20x)}{(10{x}^{2})^{2}} \\\\  & =\\frac{-10{x}^{2}sin⁡x-20xcos⁡x}{100{x}^{4}} \\\\  & =\\frac{\\cancel{10x}(-xsin⁡x-2cos⁡x)}{\\cancel{10x}\\cdot 10{x}^{3}} \\\\  & =\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47cb1ec6-7258-5391-bba7-eddd1709db30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288525} {:answer/id #uuid "4a8d72a9-6e73-515a-854b-4f57d5fcacdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288549} {:answer/id #uuid "8ebdf1f9-0a5f-5a05-a4cc-707aff2447eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288987} {:answer/id #uuid "a105dd5b-7398-57b0-9f26-b6bec2f24a09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186289108} {:answer/id #uuid "fa411dac-4ab5-5b47-81f9-8021d5039ac9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186289679}] :answer-field/correct {:db/id #edb/ref 17592186289108} :answer-field/id #uuid "1532933f-2925-54d8-9ae2-1303326ed3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289779}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a01be135-3059-50f3-96f4-e6908bb8d8f2" :question/math-academy-id "q-23853" :question/problem "Simplify ${sec}^{4}⁡x-2{sec}^{2}⁡x\\cdot {tan}^{2}⁡x+{tan}^{4}⁡x.$" :question/worked-solution "First, we can simplify our expression by factoring it, as follows:\n\n$$\n\\begin{aligned}{sec}^{4}⁡x-2{sec}^{2}⁡x\\cdot {tan}^{2}⁡x+{tan}^{4}⁡x & =({sec}^{2}⁡x)^{2}-2{sec}^{2}⁡x\\cdot {tan}^{2}⁡x+({tan}^{2}⁡x)^{2} \\\\  & ={({sec}^{2}⁡x-{tan}^{2}⁡x)}^{2}\\end{aligned}\n$$\n\nNext, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nFinally, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}{({sec}^{2}⁡x-{tan}^{2}⁡x)}^{2} & ={(1)}^{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{4}⁡x-2{sec}^{2}⁡x\\cdot {tan}^{2}⁡x+{tan}^{4}⁡x=1.\n$$"} {:db/id #edb/ref 17592186290515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6cf8d1-b88c-5c0f-893d-aa16bafa8630" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cot}^{3}⁡x" :db/id #edb/ref 17592186288235} {:answer/id #uuid "27747757-4ae1-5223-a09f-3d4987818098" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cot}^{2}⁡x-1" :db/id #edb/ref 17592186288293} {:answer/id #uuid "2ee9a410-bee6-52c4-aaa9-d3fe29873e10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡x" :db/id #edb/ref 17592186288348} {:answer/id #uuid "d4e2e6e5-aad8-5bf6-a054-8fe4f5221591" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cot}⁡x" :db/id #edb/ref 17592186289446} {:answer/id #uuid "fcc5832c-ae9c-54ba-8ab4-fb5823947b58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186289699}] :answer-field/correct {:db/id #edb/ref 17592186289699} :answer-field/id #uuid "63b6ccb1-ad37-508e-8c90-e709f327b271" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289944}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e817b7ff-13b9-5c41-abb9-36ddedcd3f8b" :question/math-academy-id "q-23896" :question/problem "Simplify ${sec}^{2}⁡x({cot}^{2}⁡x-{cos}^{2}⁡x).$" :question/worked-solution "First, we expand the parentheses using the distributive property. This gives \n\n$$\n\\begin{aligned}{sec}^{2}⁡x({cot}^{2}⁡x-{cos}^{2}⁡x) & ={sec}^{2}⁡x\\cdot {cot}^{2}⁡x-{sec}^{2}⁡x\\cdot {cos}^{2}⁡x \\\\  & =\\frac{1}{{cos}^{2}⁡x}\\cdot \\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}-\\frac{1}{{cos}^{2}⁡x}\\cdot {cos}^{2}⁡x \\\\  & =\\frac{1}{{sin}^{2}⁡x}-1 \\\\  & ={csc}^{2}⁡x-1.\\end{aligned}\n$$\n\n \n\nNow, using the identity ${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta $, we have\n\n$$\n\\begin{aligned}{sec}^{2}⁡x({cot}^{2}⁡x-{cos}^{2}⁡x) & ={cot}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b18c6a05-844b-5206-b3e5-0ce6326b0d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{4}⁡\\theta " :db/id #edb/ref 17592186289206} {:answer/id #uuid "b436c6f7-d646-5b9f-aa11-5941dcdc990c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{3}⁡x" :db/id #edb/ref 17592186289225} {:answer/id #uuid "d8589411-fbdf-5b50-9eba-de99e34580ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{csc}^{2}⁡\\theta " :db/id #edb/ref 17592186289474} {:answer/id #uuid "d86ac2a5-c6c6-5345-9657-3860d675b972" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{2}⁡\\theta " :db/id #edb/ref 17592186289476} {:answer/id #uuid "fec95ded-39dc-5c20-9496-9dcb8bfbcf09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186289716}] :answer-field/correct {:db/id #edb/ref 17592186289206} :answer-field/id #uuid "0b30197c-f6f6-5ce8-b1f2-2d38394819a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289755}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2d6dd75-f063-5feb-ad58-0c61bba9a5c9" :question/math-academy-id "q-23897" :question/problem "Simplify $1+{cot}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta .$" :question/worked-solution "First, we use the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ as follows:\n\n$$\n\\begin{aligned}1+{cot}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta  & =[1+{cot}^{2}⁡\\theta ]+{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta  \\\\  & ={csc}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta \\end{aligned}\n$$\n\nNow, we factor out ${csc}^{2}⁡\\theta ,$ and we use the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ again. This gives\n\n$$\n\\begin{aligned}{csc}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta  & ={csc}^{2}⁡\\theta (1+{cot}^{2}⁡\\theta ) \\\\  & ={csc}^{2}⁡\\theta \\,({csc}^{2}⁡\\theta )\\, \\\\  & ={csc}^{4}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c11a98-a429-5f8c-9801-3e71352bfb47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186288285} {:answer/id #uuid "3897ff35-e87a-5a29-9032-5e07bd0c4985" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288419} {:answer/id #uuid "5d3ffb47-3276-5091-a415-fa8fec9ce38d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288683} {:answer/id #uuid "d455067b-0dec-5c44-8118-9b5b1ff428e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186289440} {:answer/id #uuid "f9aa2d21-a95b-5bbf-8025-7e8589c6fa4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186289677}] :answer-field/correct {:db/id #edb/ref 17592186288419} :answer-field/id #uuid "17bab95c-81ea-5471-ab78-f85af95d1be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289787}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2ce8a935-1da8-5328-91b9-35c9544cd048" :question/math-academy-id "q-23898" :question/problem "Simplify ${tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -\\frac{1}{{cot}^{2}⁡\\theta }.$" :question/worked-solution "First, we write the given expression as:\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -\\frac{1}{{cot}^{2}⁡\\theta } & ={tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -{tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nNow, we factor out ${tan}^{2}⁡\\theta $ and use the identity \n${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta .$\nThis gives\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -{tan}^{2}⁡\\theta  & ={tan}^{2}⁡\\theta \\,({csc}^{2}⁡\\theta -1) \\\\  & ={tan}^{2}⁡\\theta \\,{cot}^{2}⁡\\theta  \\\\  & ={tan}^{2}⁡\\theta \\cdot \\frac{1}{{tan}^{2}⁡\\theta } \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e395c8-f565-5740-959d-6bf0c34f8710" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288420} {:answer/id #uuid "47d8a58a-8445-5585-bc47-18b1d4683989" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288526} {:answer/id #uuid "60da0eec-e09f-556c-977c-0afa9bca8118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{3x}{sec}^{2}⁡x+3\\operatorname{tan}⁡x" :db/id #edb/ref 17592186288710} {:answer/id #uuid "9efacfe8-4ef9-586f-935e-d85e18391332" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{3x}({sec}^{2}⁡x+\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186289098} {:answer/id #uuid "d7f42cff-705d-5052-8de2-d67ef0b14a77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{sec}^{2}⁡x+3{a}^{3x}\\operatorname{tan}⁡x" :db/id #edb/ref 17592186289468}] :answer-field/correct {:db/id #edb/ref 17592186288420} :answer-field/id #uuid "84733a66-1c91-5acb-9908-573c1e35d199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290021}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d4cb91b7-6460-5845-ba44-f35610f01889" :question/math-academy-id "q-2392" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y={a}^{3x}\\operatorname{tan}⁡x.$" :question/worked-solution "This question requires the product rule. Let $u(x)=\\operatorname{tan}⁡x$ and $v(x)={a}^{3x}.$ Then\n\n$$\n{u}^{′}(x)={sec}^{2}⁡x,\\,{v}^{′}(x)=3{a}^{3x}\\operatorname{ln}⁡a.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({sec}^{2}⁡x)({a}^{3x})+(\\operatorname{tan}⁡x)(3{a}^{3x}\\operatorname{ln}⁡a) \\\\  & ={a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f0c7111-a060-5641-9f28-08ebb3f97820" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54x{sin}^{2}⁡(9{x}^{2}-1)\\,\\operatorname{cos}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186288462} {:answer/id #uuid "4bff2b13-d34a-5a2a-ab84-1110b5438aad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x{sin}^{2}⁡(9{x}^{2}-1)\\,{cos}^{2}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186288558} {:answer/id #uuid "9a36fc3b-3a7c-5fac-bbfb-9178461a03fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18x{sin}^{2}⁡(9{x}^{2}-1)\\,{cos}^{2}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186289063} {:answer/id #uuid "b0394bcf-fb4f-5bf6-9de5-f7e8cc6ee14a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18x{sin}^{2}⁡(9{x}^{2}-1)\\,\\operatorname{cos}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186289196} {:answer/id #uuid "d6add1df-78d9-5682-b6d5-4c7d9b74e6ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54x{sin}^{3}⁡(9{x}^{2}-1)\\,{cos}^{3}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186289458}] :answer-field/correct {:db/id #edb/ref 17592186288462} :answer-field/id #uuid "7a37d7f9-8684-5d8d-b945-6f277a28d504" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289997}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d9cfcb56-203d-51a2-aa05-78075c70500a" :question/math-academy-id "q-2397" :question/problem "Find ${f}^{′}(x)$ when $f(x)={sin}^{3}⁡(9{x}^{2}-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{3},\\,u=\\operatorname{sin}⁡v,\\,v=9{x}^{2}-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=3{u}^{2},\\,\\frac{\\text{d}u}{\\text{d}v}=\\operatorname{cos}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=18x.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =3{u}^{2}\\cdot (\\operatorname{cos}⁡v)\\cdot 18x \\\\  & =3(\\operatorname{sin}⁡(9{x}^{2}-1))^{2}\\cdot (\\operatorname{cos}⁡(9{x}^{2}-1))\\cdot 18x \\\\  & =54x{sin}^{2}⁡(9{x}^{2}-1)\\operatorname{cos}⁡(9{x}^{2}-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e325549-0ba2-58a4-9dd0-b7eeab733a2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{12\\sqrt{10}}{9}" :db/id #edb/ref 17592186288690} {:answer/id #uuid "711ceffb-4865-53d9-9611-f3a1decdf347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{12\\sqrt{10}}{9}" :db/id #edb/ref 17592186288820} {:answer/id #uuid "7898b32b-d4ed-51f2-9a35-5baa748788bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{4\\sqrt{3}}{9}" :db/id #edb/ref 17592186288861} {:answer/id #uuid "8539f05d-296c-57de-915f-aca8cd6f5c02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186288929} {:answer/id #uuid "f5ba1841-d71c-5d4d-b14b-60831a836195" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186289653}] :answer-field/correct {:db/id #edb/ref 17592186289653} :answer-field/id #uuid "5ba29cbe-ca92-58c4-8bd5-f5015788e1a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289924}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f537dceb-5fdb-5fdd-9eed-d90c522b7358" :question/math-academy-id "q-24069" :question/problem "If $\\operatorname{sin}⁡\\theta =\\frac{3}{7}$ and ${0}^{∘}<\\theta <{90}^{∘}$ then what is the value of $\\operatorname{cos}⁡\\theta ?$" :question/worked-solution "![](images/9d/9d9aa1e6ffac387c53c7a1b35217a51cd17db7242ddedec4ff72c229a73d5291.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{7}.$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{7}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{3}{7}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{49}} \\\\  & =\\pm \\sqrt{\\frac{40}{49}} \\\\  & =\\pm \\frac{2\\sqrt{10}}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{10}}{7}.$"} {:db/id #edb/ref 17592186290526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d58ece6-1540-5c87-93fc-70b63a7417e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{2\\sqrt{21}}{21}" :db/id #edb/ref 17592186288332} {:answer/id #uuid "4f6c7df7-d9d8-5ab3-b99c-78b469e993c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{2\\sqrt{21}}{63}" :db/id #edb/ref 17592186288579} {:answer/id #uuid "af4e493c-6431-56a2-a2e5-28cd72bbc58e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{3\\sqrt{21}}{105}" :db/id #edb/ref 17592186289192} {:answer/id #uuid "bc120ac5-b066-5ea0-8867-330f58750505" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{2\\sqrt{21}}{63}" :db/id #edb/ref 17592186289273} {:answer/id #uuid "e2156236-2645-5e32-a437-798e4f4f8539" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{2\\sqrt{21}}{21}" :db/id #edb/ref 17592186289538}] :answer-field/correct {:db/id #edb/ref 17592186289538} :answer-field/id #uuid "ddfbb993-eeda-5d36-ae6c-7be445e847ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290204}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cb825d4a-21ae-55df-8bd3-4e6fa7cb77e6" :question/math-academy-id "q-24072" :question/problem "If $\\operatorname{sin}⁡\\theta =\\frac{2}{5}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/b8/b81b4602d221eb04aab76b0ed8853ab75a5c3cf93e76cc489344bc15133c4daf.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{2}{5}.$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{2}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{2}{5}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{25}} \\\\  & =\\pm \\sqrt{\\frac{21}{25}} \\\\  & =\\pm \\frac{\\sqrt{21}}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{\\sqrt{21}}{5}.$\n\nFinally, knowing that $$\n\\displaystyle \\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },\n$$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\left(\\frac{2}{5}\\right)}{\\left(-\\frac{\\sqrt{21}}{5}\\right)}=-\\frac{2}{\\sqrt{21}}=-\\frac{2\\sqrt{21}}{21}.\n$$"} {:db/id #edb/ref 17592186290527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff4a424-0cef-5827-8c65-342739e67db3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "cos⁡\\theta =\\frac{12}{13}" :db/id #edb/ref 17592186288148} {:answer/id #uuid "2366efa2-2630-5239-8896-1355bc1533d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "cos⁡\\theta =-\\frac{12}{13}" :db/id #edb/ref 17592186288255} {:answer/id #uuid "33e7b36e-41fd-5047-aa7c-c6fbbf77c80f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "cos⁡\\theta =\\frac{15}{17}" :db/id #edb/ref 17592186288374} {:answer/id #uuid "512ea8bf-0ec8-5a32-9816-ea662b2485cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "cos⁡\\theta =\\frac{7}{9}" :db/id #edb/ref 17592186288593} {:answer/id #uuid "719ed65b-d208-5878-a2f7-2752e2d0dc6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "cos⁡\\theta =-\\frac{15}{17}" :db/id #edb/ref 17592186288824}] :answer-field/correct {:db/id #edb/ref 17592186288255} :answer-field/id #uuid "1026f54b-e5ff-52c0-9e4c-7c46c21df6a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289770}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2acc488c-8752-546a-8c14-2587df0cb445" :question/math-academy-id "q-24074" :question/problem "If $sin⁡\\theta =\\frac{5}{13}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $cos⁡\\theta ?$" :question/worked-solution "![](images/d6/d6ec4c0b71e64cd659bceea63a49f0ef09c44ee1c31353fd377963d7cdf3c3db.png)\n\nWe're given that $sin⁡\\theta =\\frac{5}{13}.$ We can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{5}{13}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{5}{13}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{169}} \\\\  & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{12}{13}.$"} {:db/id #edb/ref 17592186290532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4c60530-1607-5398-bd6a-f3326aefc2c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.791" :db/id #edb/ref 17592186289444}] :answer-field/correct {:db/id #edb/ref 17592186289444} :answer-field/id #uuid "c950de86-5a80-576d-949b-f061e8f58b52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186290169}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "905090eb-9e63-5fb8-8001-0c20fb8ec0d1" :question/math-academy-id "q-242899" :question/problem "Given that ${8}^{1-x}={3}^{x/2},$ what is the value of $x?$ Round your answer to $3$ decimal places.\n\n$x≈$\n{{field-1}}" :question/worked-solution "First, we take ${log}_{8}$ on both sides of the equation: \n\n$$\n\\begin{aligned}{8}^{1-x} & ={3}^{x/2} \\\\ {log}_{8}⁡({8}^{1-x}) & ={log}_{8}⁡({3}^{x/2})\\end{aligned}\n$$\n\n \n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side:\n\n$$\n1-x={log}_{8}⁡({3}^{x/2})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n1-x=\\frac{x}{2}{log}_{8}⁡3\n$$\n\nFinally, we solve for $x,$ as follows: \n\n$$\n\\begin{aligned}1-x & =\\frac{x}{2}{log}_{8}⁡3 \\\\ 1 & =x+\\frac{x}{2}{log}_{8}⁡3 \\\\ x+\\frac{x}{2}{log}_{8}⁡3 & =1 \\\\ 2x+x{log}_{8}⁡3 & =2 \\\\ x(2+{log}_{8}⁡3) & =2 \\\\ x & =\\frac{2}{2+{log}_{8}⁡3}\\end{aligned}\n$$\n\nUsing the change of base formula, we have\n\n$$\n{log}_{8}⁡(3)=\\frac{\\operatorname{ln}⁡(3)}{\\operatorname{ln}⁡(8)}≈0.528\\,321.\n$$\n\nFinally,  we can approximate $x$ as \n\n$$\nx≈\\frac{2}{2+0.528\\,321}≈0.791,\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186290544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1796227e-017a-5277-9a8b-341f8ab0f588" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\operatorname{log}(2)-1}" :db/id #edb/ref 17592186288188}] :answer-field/correct {:db/id #edb/ref 17592186288188} :answer-field/id #uuid "c725e141-97f2-57ac-b578-52cbbecfae93" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186290160}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c52d167-9370-5103-baea-7365420c35b8" :question/math-academy-id "q-242938" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x+1}={2}^{x}?$\n\n$x=$\n{{field-1}}" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation: \n\n$$\n\\begin{aligned}{10}^{x+1} & ={2}^{x} \\\\ \\operatorname{log}⁡({10}^{x+1}) & =\\operatorname{log}⁡({2}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\nx+1=\\operatorname{log}⁡({2}^{x})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx+1=x\\operatorname{log}⁡(2)\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x\\operatorname{log}⁡(2)-x & =1 \\\\ x(\\operatorname{log}⁡(2)-1) & =1 \\\\ x & =\\frac{1}{\\operatorname{log}⁡(2)-1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092b0c5b-0160-5a75-9372-1a1fdb751e1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186288101} {:answer/id #uuid "31abf215-be36-54ee-8b76-e49d4e9b492e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186288358} {:answer/id #uuid "3be41de6-97ad-5092-b695-0e4929346475" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186288446} {:answer/id #uuid "550de42c-4cff-54ea-8ee4-ee43e8d49952" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288622} {:answer/id #uuid "735b1249-d927-5f24-ad57-ab6915632bff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186288836}] :answer-field/correct {:db/id #edb/ref 17592186288446} :answer-field/id #uuid "90015ecb-38ee-5e28-845e-011957440a16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2abb4fd3-0dbf-5cf1-b72d-0a77012faa09" :question/math-academy-id "q-24322" :question/problem "$$\n\\displaystyle \\frac{\\operatorname{sec}⁡\\theta -\\operatorname{cos}⁡\\theta }{3\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta }=\n$$" :question/worked-solution "First, we rewrite the expression using the definitions of $\\operatorname{sec}⁡\\theta $ and $\\operatorname{tan}⁡\\theta $:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sec}⁡\\theta -\\operatorname{cos}⁡\\theta }{3\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta } & =\\frac{\\frac{1}{\\operatorname{cos}⁡\\theta }-\\operatorname{cos}⁡\\theta }{3\\left(\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\right)\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nNext, we multiply the numerator and the denominator by $\\operatorname{cos}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\cdot (\\frac{1}{\\operatorname{cos}⁡\\theta }-\\operatorname{cos}⁡\\theta )}{3\\operatorname{cos}⁡\\theta \\cdot \\left(\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\right)\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{cos}⁡\\theta \\cdot \\frac{1}{\\operatorname{cos}⁡\\theta }-{cos}^{2}⁡\\theta }{3\\left(\\frac{\\operatorname{cos}⁡\\theta \\cdot {sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\right)} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡\\theta }\\cdot \\frac{1}{\\cancel{\\operatorname{cos}⁡\\theta }}-{cos}^{2}⁡\\theta }{3\\left(\\frac{\\cancel{\\operatorname{cos}⁡\\theta }\\cdot {sin}^{2}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }}\\right)} \\\\  & =\\frac{1-{cos}^{2}⁡\\theta }{3{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nThen, we use $1-{cos}^{2}⁡\\theta ={sin}^{2}⁡\\theta $ to simplify the expression:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡\\theta }{3{sin}^{2}⁡\\theta } & =\\frac{{sin}^{2}⁡\\theta }{3{sin}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{sin}^{2}⁡\\theta }}{3\\cancel{{sin}^{2}⁡\\theta }} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{\\operatorname{sec}⁡\\theta -\\operatorname{cos}⁡\\theta }{3\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta }=\\frac{1}{3}\n$$"} {:db/id #edb/ref 17592186290546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c6c484f-0d4c-5059-abdc-0a5388322664" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)" :db/id #edb/ref 17592186288449} {:answer/id #uuid "905767c2-2f4f-53cd-a805-da5f17ade7e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)" :db/id #edb/ref 17592186288998} {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right)" :db/id #edb/ref 17592186289118} {:answer/id #uuid "b27cd6d7-da62-5d7b-84c9-e5730cb22b5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{4\\pi }{5}\\right)" :db/id #edb/ref 17592186289211} {:answer/id #uuid "e1c5c2bc-0b3f-5d28-8a4b-51fdecf0f8b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)" :db/id #edb/ref 17592186289536}] :answer-field/correct {:db/id #edb/ref 17592186289118} :answer-field/id #uuid "f665bcbb-88dc-5ad6-8703-67a0c36bad75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290240}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a509f6a5-78b4-503c-a592-ded49f6e4644" :question/math-academy-id "q-24341" :question/problem "Express $1-2{sin}^{2}⁡\\left(\\frac{\\pi }{5}\\right)$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{5}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡\\left(\\frac{\\pi }{5}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{5}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43eca4f5-7e71-5c4d-b3d7-7641c44eb318" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)" :db/id #edb/ref 17592186288495} {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{6\\pi }{5}\\right)" :db/id #edb/ref 17592186288539} {:answer/id #uuid "93678e0d-634c-5d71-b943-62299e286df9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{3\\pi }{5}\\right)" :db/id #edb/ref 17592186289019} {:answer/id #uuid "c7df7cd8-b50b-55b6-b605-e2f558905842" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right)" :db/id #edb/ref 17592186289355} {:answer/id #uuid "c878a2ea-30a4-57ca-8bad-92bcefc1de12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{4\\pi }{5}\\right)" :db/id #edb/ref 17592186289360}] :answer-field/correct {:db/id #edb/ref 17592186288539} :answer-field/id #uuid "44b91e88-c247-552d-ac22-5e6fb9335e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289882}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ccbcdf42-d0d6-5ef1-b1a3-dd2467d078f8" :question/math-academy-id "q-24499" :question/problem "Express $$\n\\displaystyle {cos}^{2}⁡\\left(\\frac{3\\pi }{5}\\right)-{sin}^{2}⁡\\left(\\frac{3\\pi }{5}\\right)\n$$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\left(\\frac{3\\pi }{5}\\right)$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡\\left(\\frac{3\\pi }{5}\\right)-{sin}^{2}⁡\\left(\\frac{3\\pi }{5}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{5}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{6\\pi }{5}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062a3218-733e-525a-8b5d-331d7e8996a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186288081} {:answer/id #uuid "24557d4c-6a4a-5cd5-a7e3-e24950b0390f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{60}^{∘}" :db/id #edb/ref 17592186288265} {:answer/id #uuid "2d84974c-0049-5521-a257-45ab79f50d17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{60}^{∘}\\operatorname{sin}⁡{60}^{∘}" :db/id #edb/ref 17592186288337} {:answer/id #uuid "d7ea36f8-fdb9-5210-9922-102972d65fd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{60}^{∘}\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186289467} {:answer/id #uuid "f0888764-f8f2-5ce9-b665-20d788007d1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186289621}] :answer-field/correct {:db/id #edb/ref 17592186289621} :answer-field/id #uuid "b91ed20d-b388-5b5f-8238-6bf59161d259" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290136}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4eaa49cb-94d5-5c4a-8e77-4592aca20df1" :question/math-academy-id "q-24641" :question/problem "$$\n\\displaystyle \\frac{\\operatorname{sin}⁡{60}^{∘}\\operatorname{cot}⁡{30}^{∘}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}}=\n$$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={30}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {30}^{∘}) & =2\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{30}^{∘} \\\\ \\operatorname{sin}⁡({60}^{∘}) & =2\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{30}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{60}^{∘}\\operatorname{cot}⁡{30}^{∘}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} & =\\frac{2\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{30}^{∘}\\cdot \\frac{\\operatorname{cos}⁡{30}^{∘}}{\\operatorname{sin}⁡{30}^{∘}}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{2{cos}^{2}⁡{30}^{∘}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{{cos}^{2}⁡{30}^{∘}-1+{cos}^{2}⁡{30}^{∘}}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{{cos}^{2}⁡{30}^{∘}-(1-{cos}^{2}⁡{30}^{∘})}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity in the form ${sin}^{2}⁡{30}^{∘}=1-{cos}^{2}⁡{30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡{30}^{∘}-(1-{cos}^{2}⁡{30}^{∘})}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} & =\\frac{{cos}^{2}⁡{30}^{∘}-{sin}^{2}⁡{30}^{∘}}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{(\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘})(\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘})}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{(\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘})\\cancel{(\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘})}}{\\cancel{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}}} \\\\  & =\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b75bdb8-3ea8-5b60-874a-dc7e2ed8e8e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\text{ arcsec }y+C" :db/id #edb/ref 17592186288555} {:answer/id #uuid "549137e8-c93b-553a-88ae-c56c3509772f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{arcsin}⁡y+C" :db/id #edb/ref 17592186288616} {:answer/id #uuid "6bb704be-6a28-52b3-bd08-a672eef1a367" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\text{ arccsc }y+C" :db/id #edb/ref 17592186288794} {:answer/id #uuid "7940eb84-6a2b-5ba0-b37c-140d22758e0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\text{ arcsec }y+C" :db/id #edb/ref 17592186288866} {:answer/id #uuid "fb429378-2e91-5817-9c2b-96b8e5ed15cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\text{ arccot }y+C" :db/id #edb/ref 17592186289688}] :answer-field/correct {:db/id #edb/ref 17592186288555} :answer-field/id #uuid "775e17c2-e49b-551c-8bb1-e9bbc23ea701" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0be79b52-86d6-59fc-99d7-9763abd0657c" :question/math-academy-id "q-2501" :question/problem "$$\n\\displaystyle \\int \\frac{2}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y=\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y=\\text{arcsec}\\,y.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y & =2\\int \\frac{1}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y \\\\  & =2\\text{ arcsec }y+C.\\end{aligned}\\end{aligned}\n$$"} {:answer/id #uuid "51f578a9-cbd3-500d-b55c-d564c80794ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{log}_{9}⁡(5)}" :db/id #edb/ref 17592186290982} {:answer/id #uuid "61a24d9b-5760-5004-b4f0-752020b46818" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+{log}_{9}⁡(5)" :db/id #edb/ref 17592186291046} {:answer/id #uuid "709a2b05-5bae-57d8-9933-96272b7cd86f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2+{log}_{9}⁡(5)}" :db/id #edb/ref 17592186291115} {:answer/id #uuid "d86a0c7b-8348-5b84-927c-9b00881731e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2-{log}_{9}⁡(5)}" :db/id #edb/ref 17592186291537} {:answer/id #uuid "f6fb9a89-cac2-5b97-bff0-c2669ccb7ea5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{9}⁡(5)" :db/id #edb/ref 17592186291673} {:db/id #edb/ref 17592186292575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cab719f-64d1-5208-a9a3-b5e24ce7d2b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.018" :db/id #edb/ref 17592186291233}] :answer-field/correct {:db/id #edb/ref 17592186291233} :answer-field/id #uuid "1f674e8d-79f7-5935-addf-086e29aa8bfc" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291851} {:answer-field/choices [{:answer/id #uuid "cf2b7498-dbf3-5dc1-9730-f1a819261976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.066" :db/id #edb/ref 17592186291511}] :answer-field/correct {:db/id #edb/ref 17592186291511} :answer-field/id #uuid "697ea549-9af9-53c1-bd59-c8f9e02b3267" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292056}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0c20466f-73d1-5125-9bdb-69fe3a5c2f0e" :question/math-academy-id "q-256554" :question/problem "Suppose we wish to find a root of the function $f(x)=\\operatorname{tan}⁡({x}^{2})-x+1$ in the interval $[1.8,2.2].$ Calculate the first two iterations of the Newton-Raphson process starting from the point ${x}_{0}=1.8.$ Round your answers to three decimal places.\n\n${x}_{1}≈$\n{{field-1}}\n$,\\,{x}_{2}≈$\n{{field-2}}" :question/worked-solution "The formula for the Newton-Raphson method is\n\n$$\n{x}_{n+1}={x}_{n}-\\frac{f({x}_{n})}{{f}^{′}({x}_{n})}\n$$\n\nwhere ${f}^{′}({x}_{n})$ is the derivative of $f(x)$ evaluated at ${x}_{n}.$\n\nIn our case, we have\n\n$$\n{f}^{′}(x)=(\\operatorname{tan}⁡({x}^{2})-x+1)^{′}=2x{sec}^{2}⁡({x}^{2})-1.\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n\\begin{aligned}{x}_{n+1} & ={x}_{n}-\\frac{\\operatorname{tan}⁡({x}_{n}^{2})-{x}_{n}+1}{2{x}_{n}{sec}^{2}⁡({x}_{n}^{2})-1}\\end{aligned}\n$$\n\nStarting with ${x}_{0}=1.8,$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-\\frac{\\operatorname{tan}⁡({x}_{0}^{2})-{x}_{0}+1}{2{x}_{0}{sec}^{2}⁡({x}_{0}^{2})-1} \\\\  & =1.8-\\frac{\\operatorname{tan}⁡({1.8}^{2})-1.8+1}{2(1.8){sec}^{2}⁡({1.8}^{2})-1} \\\\  & =2.066\\,129…\\end{aligned}\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-\\frac{\\operatorname{tan}⁡({x}_{1}^{2})-{x}_{1}+1}{2{x}_{1}{sec}^{2}⁡({x}_{1}^{2})-1} \\\\  & =(2.066\\,129…)-\\frac{\\operatorname{tan}⁡((2.066\\,129…)^{2})-(2.066\\,129…)+1}{2(2.066\\,129…){sec}^{2}⁡((2.066\\,129…)^{2})-1} \\\\  & =2.017\\,679….\\end{aligned}\n$$\n\nTherefore, ${x}_{1}≈2.066$ and ${x}_{2}≈2.018,$ rounded to three decimal places."} {:db/id #edb/ref 17592186292617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bec87b5-543b-50bd-b325-3aa54b40b353" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.708" :db/id #edb/ref 17592186290879}] :answer-field/correct {:db/id #edb/ref 17592186290879} :answer-field/id #uuid "eea7cecd-5b0b-52d1-98c4-84327ebafa2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4873899-1d4e-5ac3-af6e-023b6c9c81f9" :question/math-academy-id "q-263069" :question/problem "If ${e}^{t}=15,$ then $t≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $t:$\n\n$$\n\\begin{aligned}{e}^{t} & =15 \\\\ ln⁡({e}^{t}) & =ln⁡(15) \\\\ t & =ln⁡(15)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nt≈2.708\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186292618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7ec5234-d5d2-5b2c-9b34-1d43a1c334a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.732" :db/id #edb/ref 17592186291365}] :answer-field/correct {:db/id #edb/ref 17592186291365} :answer-field/id #uuid "f76ff3ea-61b9-5ef7-959b-4f20471f4ec6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292508}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8fa3225-9eff-5b91-9505-8bb2cf404f2e" :question/math-academy-id "q-263077" :question/problem "If ${e}^{3x}=9,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{3x} & =9 \\\\ ln⁡({e}^{3x}) & =ln⁡(9) \\\\ 3x & =ln⁡(9) \\\\ x & =\\frac{1}{3}ln⁡(9)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.732\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186292619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0b1428f-3777-5e97-9fb3-49faf347c08e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.222" :db/id #edb/ref 17592186291574}] :answer-field/correct {:db/id #edb/ref 17592186291574} :answer-field/id #uuid "00e67df2-4e50-5cf6-8001-1fd0abb920a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291732}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a0b41575-560d-5ec9-8c58-ecf5304e673c" :question/math-academy-id "q-263081" :question/problem "If ${e}^{5-y/2}=\\sqrt[5]{7},$ then $y≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{5-y/2} & =\\sqrt[5]{7} \\\\ ln⁡({e}^{5-y/2}) & =ln⁡(\\sqrt[5]{7}) \\\\ 5-\\frac{y}{2} & =ln⁡({7}^{1/5})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side and solve for $y:$\n\n$$\n\\begin{aligned}5-\\frac{y}{2} & =\\frac{1}{5}ln⁡(7) \\\\ -\\frac{y}{2} & =\\frac{1}{5}ln⁡(7)-5 \\\\ y & =-\\frac{2}{5}ln⁡(7)+10\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈9.222\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186292626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79aa1cb7-797d-553f-8ba6-d1f8ab36481b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.197" :db/id #edb/ref 17592186291147}] :answer-field/correct {:db/id #edb/ref 17592186291147} :answer-field/id #uuid "789f06ff-d74e-5ecb-842e-286987b75e5f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292114}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1153c8ea-590e-5259-8ecc-5853eab3d5b4" :question/math-academy-id "q-263178" :question/problem "If ${e}^{x+2}-7=2,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{x+2}-7 & =2 \\\\ {e}^{x+2} & =2+7 \\\\ {e}^{x+2} & =9\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{x+2} & =9 \\\\ ln⁡({e}^{x+2}) & =ln⁡(9) \\\\ x+2 & =ln⁡(9) \\\\ x & =ln⁡(9)-2\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.197\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186292627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5ed29f-f759-542d-8808-ee60ab10dd3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.403" :db/id #edb/ref 17592186290898}] :answer-field/correct {:db/id #edb/ref 17592186290898} :answer-field/id #uuid "d74f91c3-c33c-5be0-a360-bfd17a89b78c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292390}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96c56758-96d0-59b3-b1f1-5393c3950a3d" :question/math-academy-id "q-263199" :question/problem "If $9-{e}^{3-4x}=5,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}9-{e}^{3-4x} & =5 \\\\ -{e}^{3-4x} & =5-9 \\\\ -{e}^{3-4x} & =-4 \\\\ {e}^{3-4x} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{3-4x} & =4 \\\\ ln⁡({e}^{3-4x}) & =ln⁡(4) \\\\ 3-4x & =ln⁡(4) \\\\ -4x & =ln⁡(4)-3 \\\\ x & =-\\frac{1}{4}ln⁡(4)+\\frac{3}{4}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.403\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186292628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99712afe-46b1-57c2-a5b8-1b2e99110b1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.198" :db/id #edb/ref 17592186291296}] :answer-field/correct {:db/id #edb/ref 17592186291296} :answer-field/id #uuid "cba766d3-cf7c-511e-b1a9-468534029e3c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292353}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd44a9f8-805f-5834-9354-5593694485e1" :question/math-academy-id "q-263201" :question/problem "If ${e}^{5+y/2}-9=21,$ then $y≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{5+y/2}-9 & =21 \\\\ {e}^{5+y/2} & =21+9 \\\\ {e}^{5+y/2} & =30\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{5+y/2} & =30 \\\\ ln⁡({e}^{5+y/2}) & =ln⁡(30) \\\\ 5+\\frac{y}{2} & =ln⁡(30) \\\\ \\frac{y}{2} & =ln⁡(30)-5 \\\\ y & =2ln⁡(30)-10\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈-3.198\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186292646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47fe5df5-7916-5060-8fbe-5ad8b202e09b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{1+2\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186290928} {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} {:answer/id #uuid "84375010-b552-520c-9e30-6bce98e9d946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{log}⁡(7)" :db/id #edb/ref 17592186291193} {:answer/id #uuid "a942eb9e-20af-5ce8-bcb0-edde94e6b8d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291370} {:answer/id #uuid "da13d7a6-842f-5188-995b-f601e0fb9261" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291544}] :answer-field/correct {:db/id #edb/ref 17592186291063} :answer-field/id #uuid "480c9754-f2a3-545e-b087-84a9e0daed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186291963}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3565dc73-156f-57ee-a4a3-9af19402d1e5" :question/math-academy-id "q-26385" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x-3}={7}^{x}?$" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{10}^{x-3} & ={7}^{x} \\\\ \\operatorname{log}⁡({10}^{x-3}) & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x-3 & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x-3 & =x\\operatorname{log}⁡(7)\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-x\\operatorname{log}⁡(7) & =3 \\\\ x(1-\\operatorname{log}⁡(7)) & =3 \\\\ x & =\\frac{3}{1-\\operatorname{log}⁡(7)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f85746-b79b-5580-b5d4-13f1d8e44462" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.293" :db/id #edb/ref 17592186290737} {:answer/id #uuid "33cde5e3-9a3b-53ea-b943-70c8a99494f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5.891" :db/id #edb/ref 17592186290840} {:answer/id #uuid "35d82a02-03b6-51c5-8449-78b2bc84ce9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.213" :db/id #edb/ref 17592186290852} {:answer/id #uuid "4a79d869-63a0-57b2-96e1-c9779852a986" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7.712" :db/id #edb/ref 17592186290948} {:answer/id #uuid "fc971f9e-6d7d-5373-b123-f07b18462734" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.544" :db/id #edb/ref 17592186291706}] :answer-field/correct {:db/id #edb/ref 17592186290852} :answer-field/id #uuid "191c3242-0209-5594-87e0-47ca785c4d4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186291830}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d6a09c3-0907-53a4-ad37-e4629c10f3e2" :question/math-academy-id "q-26828" :question/problem "Given that ${5}^{y}={4}^{y+1},$ what is the value of $y?$ Round your answer to $3$ decimal places." :question/worked-solution "First, we take ${log}_{5}$ on both sides of the equation: \n\n$$\n\\begin{aligned}{5}^{y}={4}^{y+1} \\\\ {log}_{5}⁡({5}^{y}) & ={log}_{5}⁡({4}^{y+1})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side:\n\n$$\n\\begin{aligned}y & ={log}_{5}⁡({4}^{y+1})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}y & =(y+1){log}_{5}⁡4\\end{aligned}\n$$\n\nFinally, we solve for $y,$ as follows: \n\n$$\n\\begin{aligned}y & =(y+1){log}_{5}⁡4 \\\\ y & =y{log}_{5}⁡4+{log}_{5}⁡4 \\\\ y-y{log}_{5}⁡4 & ={log}_{5}⁡4 \\\\ y(1-{log}_{5}⁡4) & ={log}_{5}⁡4 \\\\ y & =\\frac{{log}_{5}⁡4}{1-{log}_{5}⁡4}\\end{aligned}\n$$\n\nUsing the change of base formula, we have\n\n$$\n{log}_{5}⁡(4)=\\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(5)}≈0.861\\,353.\n$$\n\nFinally, then, we can approximate $y$ as\n\n$$\n\\begin{aligned}y≈\\frac{0.861\\,353}{1-0.861\\,353}≈6.213,\\end{aligned}\n$$\n\nto $3$ decimal places."} {:db/id #edb/ref 17592186292685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078b25eb-c753-58c4-a8bb-c23711fdad11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186290671} {:answer/id #uuid "7908b470-d7ec-55b9-b4ab-b86372edd49a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186291145} {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} {:answer/id #uuid "9fdbc26c-f0b1-58b7-b55e-4663ee54eccb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186291327} {:answer/id #uuid "fcc2c5b1-4056-55a7-8817-839d1d89caec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2+\\sqrt{3}}{2}" :db/id #edb/ref 17592186291707}] :answer-field/correct {:db/id #edb/ref 17592186291181} :answer-field/id #uuid "d670500b-2a4c-531d-a949-3190b98d3ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186292387}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83f3d502-62d9-5e1b-a7be-52d9144a4c16" :question/math-academy-id "q-26907" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}.$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2} & ={sin}^{2}⁡({105}^{∘})+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘}) \\\\  & =[{sin}^{2}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘})]+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) \\\\  & =1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={105}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {105}^{∘}) \\\\  & =\\operatorname{sin}⁡({210}^{∘}) \\\\  & =\\operatorname{sin}⁡({180}^{∘}+{30}^{∘}) \\\\  & =-\\operatorname{sin}⁡({30}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}=\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186292696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5868b07-bcc9-5439-8718-abc34721e4f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438022} {:answer/id #uuid "b4492437-18b0-5ea5-afe3-0c95f6e8c559" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438023}] :answer-field/correct {:db/id #edb/ref 17592186438023} :answer-field/id #uuid "049db57c-a0e7-56de-b01d-934b8edb71e7" :answer-field/key "The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439040} {:answer-field/choices [{:answer/id #uuid "f4c2d785-bfd8-52bd-920b-fdf30600fb45" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438024} {:answer/id #uuid "65d473ca-16c2-5906-9a4b-4d38e4d203a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438025}] :answer-field/correct {:db/id #edb/ref 17592186438024} :answer-field/id #uuid "e8b8f0da-7701-59ac-b62e-e3c7f0b5a210" :answer-field/key "The function has a minimum value at  $x=2\\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439041} {:answer-field/choices [{:answer/id #uuid "88d518a6-aec2-5916-b3c0-47b033deb6e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438026} {:answer/id #uuid "0e2171a1-1911-5a58-a449-b31bc5f2edce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438027}] :answer-field/correct {:db/id #edb/ref 17592186438026} :answer-field/id #uuid "cf911183-758e-5ef8-9432-74581ddfaa58" :answer-field/key "The function intersects the $y$-axis at $y=0.$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439042}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "69137884-05b3-53be-9c7c-95b53b1ed329" :question/math-academy-id "q-27009" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{cos}⁡x?$\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\n\nLet's go through each statement.\n\n- Statement “The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$” is true. At $x=\\frac{\\pi }{2}$ the function intersects the $x$-axis.\n\n- Statement “The function has a minimum value at  $x=2\\pi .$” is false. The function has a maximum at $x=2\\pi .$\n\n- Statement “The function intersects the $y$-axis at $y=0.$” is false. The function intersects the $y$-axis at $y=1.$"} {:db/id #edb/ref 17592186292727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c1725fb-975f-51e3-8eec-0844256c34ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{36}{325}" :db/id #edb/ref 17592186290953}] :answer-field/correct {:db/id #edb/ref 17592186290953} :answer-field/id #uuid "bf060066-aacf-5a66-8030-ccd7f61d5e82" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292322}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42464198-f113-5e86-82f0-2260d0107c59" :question/math-academy-id "q-271612" :question/problem "Suppose that for the angles $u$ and $v,$ we have \n\n$$\n\\operatorname{cos}⁡u=\\frac{5}{13},\\,\\operatorname{sin}⁡v=\\frac{7}{25},\\,\\operatorname{cos}⁡v=\\frac{24}{25}.\n$$\n\nGiven that $u$ lies in the first quadrant, then $\\operatorname{cos}⁡(u+v)=${{field-1}}." :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{cos}⁡u,$ $\\operatorname{sin}⁡v,$ and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡u,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{sin}^{2}⁡u=1-{cos}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡u & =1-{cos}^{2}⁡u \\\\  & =1-{\\left(\\frac{5}{13}\\right)}^{2} \\\\  & =1-\\frac{{5}^{2}}{{13}^{2}} \\\\  & =1-\\frac{25}{169} \\\\  & =\\frac{169}{169}-\\frac{24}{169} \\\\  & =\\frac{144}{169}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡u & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{12}{13}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =\\left(\\frac{5}{13}\\right)\\left(\\frac{24}{25}\\right)-\\left(\\frac{12}{13}\\right)\\left(\\frac{7}{25}\\right) \\\\  & =\\frac{24}{65}-\\frac{84}{325} \\\\  & =\\frac{36}{325}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26fe8f92-f264-557d-b8e4-1a1dfec3498c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{10}" :db/id #edb/ref 17592186290793}] :answer-field/correct {:db/id #edb/ref 17592186290793} :answer-field/id #uuid "6bfb8429-2b84-5bcd-a29e-f9064ab94f24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292064}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1dafbc26-1aa1-5df3-b798-6d246921bf82" :question/math-academy-id "q-271617" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=-\\frac{4}{5},\\,\\operatorname{cos}⁡v=-\\frac{\\sqrt{2}}{2},\\,\\operatorname{sin}⁡v=\\frac{\\sqrt{2}}{2}.\n$$\n\nGiven that $u$ lies in the third quadrant, then $\\operatorname{cos}⁡(u-v)=${{field-1}}." :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡v$, and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡u$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{cos}^{2}⁡u=1-{sin}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{\\left(-\\frac{4}{5}\\right)}^{2} \\\\  & =1-\\frac{{4}^{2}}{{5}^{2}} \\\\  & =1-\\frac{16}{25} \\\\  & =\\frac{25}{25}-\\frac{16}{25} \\\\  & =\\frac{9}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{cos}⁡u=-\\frac{3}{5}.\n$$\n\nWe can now apply the difference formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u-v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =\\left(-\\frac{3}{5}\\right)\\left(-\\frac{\\sqrt{2}}{2}\\right)+\\left(-\\frac{4}{5}\\right)\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\  & =\\frac{3\\sqrt{2}}{10}-\\frac{4\\sqrt{2}}{10} \\\\  & =-\\frac{\\sqrt{2}}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff7d0b6-1895-568d-b515-ba46dd6959a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3-4\\sqrt{3}}{10}" :db/id #edb/ref 17592186290826}] :answer-field/correct {:db/id #edb/ref 17592186290826} :answer-field/id #uuid "6436577d-1f9d-5470-b7e0-60f51f166225" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292038}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e6371ba1-5c30-5fe6-b37f-fa6c2f905782" :question/math-academy-id "q-274503" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{3}{5},\\,\\operatorname{cos}⁡u=-\\frac{4}{5},\\,\\operatorname{cos}⁡v=\\frac{1}{2}.\n$$\n\nIf $v$ lies in the first quadrant, then $\\operatorname{sin}⁡(u+v)=${{field-1}}." :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{\\left(\\frac{1}{2}\\right)}^{2} \\\\  & =1-\\frac{{1}^{2}}{{2}^{2}} \\\\  & =1-\\frac{1}{4} \\\\  & =\\frac{4}{4}-\\frac{1}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡v=\\frac{\\sqrt{3}}{2}.\n$$\n\nWe can now apply the sum formula as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =\\left(\\frac{3}{5}\\right)\\left(\\frac{1}{2}\\right)+\\left(-\\frac{4}{5}\\right)\\left(\\frac{\\sqrt{3}}{2}\\right) \\\\  & =\\frac{3}{10}-\\frac{4\\sqrt{3}}{10} \\\\  & =\\frac{3-4\\sqrt{3}}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292747 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a12936-1a3b-55e4-b900-dda3cbbdad7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}-4}{6}" :db/id #edb/ref 17592186290791}] :answer-field/correct {:db/id #edb/ref 17592186290791} :answer-field/id #uuid "77257d81-1d73-5cb6-a7e4-4b2e4f7b8b4a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292107}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "17265ebe-4880-5a24-bfe4-3494b2c4ee49" :question/math-academy-id "q-274544" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡v=-\\frac{\\sqrt{2}}{2},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{2}}{2},\\,\\operatorname{cos}⁡u=\\frac{1}{3}.\n$$\n\nIf $u$ lies in the fourth quadrant, then $\\operatorname{sin}⁡(u-v)=${{field-1}}." :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡v$, $\\operatorname{cos}⁡v$, and $\\operatorname{cos}⁡u.$ To find the missing value of $\\operatorname{sin}⁡u$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{sin}^{2}⁡u=1-{cos}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡u & =1-{cos}^{2}⁡u \\\\  & =1-{\\left(\\frac{1}{3}\\right)}^{2} \\\\  & =1-\\frac{{1}^{2}}{{3}^{2}} \\\\  & =1-\\frac{1}{9} \\\\  & =\\frac{9}{9}-\\frac{1}{9} \\\\  & =\\frac{8}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡u & =\\pm \\sqrt{\\frac{7}{9}} \\\\  & =\\pm \\frac{2\\sqrt{2}}{3}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the fourth quadrant, where sine is negative. So, we disregard the positive value, and we have \n\n$$\n\\operatorname{sin}⁡u=-\\frac{2\\sqrt{2}}{3}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =\\left(-\\frac{2\\sqrt{2}}{3}\\right)\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(\\frac{1}{3}\\right)\\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-\\frac{4}{6}+\\frac{\\sqrt{2}}{6} \\\\  & =\\frac{\\sqrt{2}-4}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55f3a3b5-f828-5f5f-85d3-b243f93aa9d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.292" :db/id #edb/ref 17592186290996}] :answer-field/correct {:db/id #edb/ref 17592186290996} :answer-field/id #uuid "30bdc6ca-5b29-5eab-b87f-396653ba6112" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291898} {:answer-field/choices [{:answer/id #uuid "d412a48b-29da-5b8b-8cd1-f1c17f28e1bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{53}" :db/id #edb/ref 17592186291526}] :answer-field/correct {:db/id #edb/ref 17592186291526} :answer-field/id #uuid "d3226d66-9711-5833-93e7-7e6f3a191ab5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292376}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41b11208-89e0-56f6-aeac-8b4c4d771fd4" :question/math-academy-id "q-274595" :question/problem "Express $2\\operatorname{sin}⁡x+7\\operatorname{cos}⁡x$ in the form $R\\operatorname{sin}⁡(x+ϕ)$ with $ϕ\\in (0,\\frac{\\pi }{2}).$ Use the **exact value** for $R,$ and round $ϕ$ to **three decimal places**.\n\n$2\\operatorname{sin}⁡x+7\\operatorname{cos}⁡x≈$\n{{field-1}}\n$\\operatorname{sin}⁡(x\\,+$\n{{field-2}}$)$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{sin}⁡x+7\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(x)+7\\operatorname{cos}⁡(x) & =(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=2 \\\\ R\\operatorname{sin}⁡ϕ &=7\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{7}{2} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{7}{2} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{7}{2}\\right) \\\\ ϕ & ≈1.292\\,\\text{rad},\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{R}^{2}{sin}^{2}⁡(ϕ)+{R}^{2}{cos}^{2}⁡(ϕ) & ={7}^{2}+{2}^{2} \\\\ {R}^{2}({sin}^{2}⁡(ϕ)+{cos}^{2}⁡(ϕ)) & =49+4 \\\\ {R}^{2} & =53 \\\\ R & =\\sqrt{53}\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n2\\operatorname{sin}⁡(x)+7\\operatorname{cos}⁡(x)≈\\sqrt{53}\\operatorname{sin}⁡(x+1.292)\n$$"} {:db/id #edb/ref 17592186292758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8348ba7f-c208-5d0e-92f5-7a8e4f06e828" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{29}" :db/id #edb/ref 17592186291189}] :answer-field/correct {:db/id #edb/ref 17592186291189} :answer-field/id #uuid "5cc5f697-3559-5aa0-a4de-9cc9496cb60a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292015}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cc874750-92f9-5569-aa4f-3175d04a7525" :question/math-academy-id "q-274608" :question/problem "Given that the expression $2\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x$ can be written as $R\\operatorname{cos}⁡(x-ϕ)$ with $R>0,$ what is the value of $R?$\n\n$R=$\n{{field-1}}" :question/worked-solution "The difference formula for cosine gives\n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(x-ϕ) & =R(\\operatorname{cos}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{sin}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x=R\\operatorname{cos}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x=(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{sin}⁡ϕ &=2 \\\\ R\\operatorname{cos}⁡ϕ &=5\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{sin}⁡ϕ)}^{2}+{(R\\operatorname{cos}⁡ϕ)}^{2} & =(2)^{2}+(5)^{2} \\\\ {R}^{2}({sin}^{2}⁡ϕ+{cos}^{2}⁡ϕ) & =4+25 \\\\ {R}^{2} & =29 \\\\ R & =\\sqrt{29}\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186292855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c7ff64a-dcd9-59b0-9327-aea87fdbf4a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10-z" :db/id #edb/ref 17592186290811}] :answer-field/correct {:db/id #edb/ref 17592186290811} :answer-field/id #uuid "2dee6e83-7420-5167-abb4-e451b17c4859" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291889}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25bd1e17-12b6-5048-8654-690129aadfd1" :question/math-academy-id "q-275501" :question/problem "For the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}x & 3 & y \\\\ 2 & x & z \\\\ 1 & w & 5\\end{bmatrix},\n$$\nfind the minor ${M}_{12}$ of the element ${a}_{12}.$\n\n${M}_{12}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${a}_{12},$ we remove the first row and second column: \n\n$$\nA=\\begin{bmatrix}∗ & 3 & ∗ \\\\ 2 & ∗ & z \\\\ 1 & ∗ & 5\\end{bmatrix}\n$$\n\nSo, the minor of ${a}_{12}$ is\n\n$$\n\\begin{aligned}{M}_{12} & =det\\begin{bmatrix}2 & z \\\\ 1 & 5\\end{bmatrix} \\\\  & =\\begin{vmatrix}2 & z \\\\ 1 & 5\\end{vmatrix} \\\\  & =2\\cdot 5-z\\cdot 1 \\\\  & =10-z\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff83e47c-1d5e-5a2b-9248-5243ee17b3c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186291724}] :answer-field/correct {:db/id #edb/ref 17592186291724} :answer-field/id #uuid "05d848d0-ac5b-5fb4-a9a4-804f761e1a53" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291753}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1cdb365a-568a-54ff-a0ff-388e4c99f9fd" :question/math-academy-id "q-275539" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\text{v}=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}.$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}1 & 4 \\\\ 2 & -1\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}1 & 4 \\\\ 2 & -1\\end{vmatrix} \\\\  & =1\\cdot (-1)-4\\cdot 2 \\\\  & =-9\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-9\\,|=9\n$$"} {:db/id #edb/ref 17592186292868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c438cd2-2f9a-56e9-ba78-198237723b47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186290809}] :answer-field/correct {:db/id #edb/ref 17592186290809} :answer-field/id #uuid "9902feec-4c1f-5bad-9074-0772c0883e74" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292218}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ff3bf305-a423-59b5-a761-0e3f9822d595" :question/math-academy-id "q-275585" :question/problem "If $A=\\begin{bmatrix}-5 & 3 & 0 \\\\ 1 & 7 & 5 \\\\ 0 & -2 & -3\\end{bmatrix},$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-5 & 3 & 0 \\\\ 1 & 7 & 5 \\\\ 0 & -2 & -3\\end{vmatrix} & =-5\\begin{vmatrix}7 & 5 \\\\ -2 & -3\\end{vmatrix}-3\\begin{vmatrix}1 & 5 \\\\ 0 & -3\\end{vmatrix}+0\\begin{vmatrix}1 & 7 \\\\ 0 & -2\\end{vmatrix} \\\\  & =-5(-21-(-10))-3(-3-0)+0 \\\\  & =-5\\cdot (-11)-3\\cdot (-3) \\\\  & =55+9 \\\\  & =64\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186291058}] :answer-field/correct {:db/id #edb/ref 17592186291058} :answer-field/id #uuid "5deef2d0-b2e7-54ab-a3df-7734195f5705" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292019}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d712990-6aa9-538b-af72-704fc59cbac8" :question/math-academy-id "q-275598" :question/problem "If\n$$\n\\displaystyle C=\\begin{bmatrix}1 & k \\\\ 4 & 6\\end{bmatrix}\n$$\nand\n$\\text{det}(C)=-14,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}1 & k \\\\ 4 & 6\\end{vmatrix} \\\\  & =1\\cdot 6-k\\cdot 4 \\\\  & =6-4k.\\end{aligned}\n$$\n\nSince $det(C)=-14$, we get\n\n$$\n\\begin{aligned}det(C) & =-14 \\\\ 6-4k & =-14 \\\\ -4k & =-14-6 \\\\ -4k & =-20 \\\\ k & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186291266}] :answer-field/correct {:db/id #edb/ref 17592186291266} :answer-field/id #uuid "339de4a9-ce7b-517d-9496-4255c739b1c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291908}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d673c24b-03d4-55e8-a5fb-605bc1d6c21f" :question/math-academy-id "q-275601" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{bmatrix}\n$$\nand $det(A)=7,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{vmatrix} \\\\  & =(3+p)(5-p)-(4p-{p}^{2})\\cdot 1 \\\\  & =15-3p+5p-{p}^{2}-4p+{p}^{2} \\\\  & =15-2p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =15-2p.\\end{aligned}\n$$\n\nFinally, since $det(A)=7$, we obtain\n\n$$\n\\begin{aligned}det(A) & =7 \\\\ 15-2p & =7 \\\\ -2p & =-8 \\\\ p & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d2a35b5-b3fc-5870-8139-a0f009be1ae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186291234}] :answer-field/correct {:db/id #edb/ref 17592186291234} :answer-field/id #uuid "040aff19-8fde-5325-9a72-92cc6df66da4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291746}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7227f9ac-0ffc-5d99-83ac-2d10c6986d6c" :question/math-academy-id "q-275706" :question/problem "Find the **exact** value of the expression below.\n\n${cos}^{4}⁡({15}^{∘})-2{cos}^{2}⁡({15}^{∘}){sin}^{2}⁡({15}^{∘})+{sin}^{4}⁡({15}^{∘})=$\n{{field-1}}" :question/worked-solution "First, notice that our expression is a perfect square that can be rewritten as follows:\n\n$$\n\\begin{aligned}{cos}^{4}⁡({15}^{∘})-2{cos}^{2}⁡({15}^{∘}){sin}^{2}⁡({15}^{∘})+{sin}^{4}⁡({15}^{∘}) & ={({cos}^{2}⁡({15}^{∘})-{sin}^{2}⁡({15}^{∘}))}^{2}\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={15}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡({15}^{∘})-{sin}^{2}⁡({15}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {15}^{∘}) \\\\  & =\\operatorname{cos}⁡({30}^{∘}) \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{({cos}^{2}⁡({15}^{∘})-{sin}^{2}⁡({15}^{∘}))}^{2} & ={\\left(\\frac{\\sqrt{3}}{2}\\right)}^{2}=\\frac{3}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fba74c9-a43c-555d-83a0-5e97204b4777" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186291171}] :answer-field/correct {:db/id #edb/ref 17592186291171} :answer-field/id #uuid "ea8202f6-c433-5f73-acb4-de5dcc90eb03" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292470}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2f93a0ad-99aa-54d9-bd35-c1d6b3dc5f05" :question/math-academy-id "q-275738" :question/problem "If $B=\\begin{bmatrix}x-5 & x+3 \\\\ 2 & -3\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(x-5)\\cdot (-3)-2\\cdot (x+3) \\\\  & =-3x+15-2x-6 \\\\  & =-5x+9.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-5x+9 & =0 \\\\ -5x & =-9 \\\\ x & =\\frac{9}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ed7a213-aacc-56d2-9779-25fff16d3e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186290969}] :answer-field/correct {:db/id #edb/ref 17592186290969} :answer-field/id #uuid "b7851796-9230-52fb-8a26-b3ea3a329032" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292298}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "30ba35b5-5f35-540d-9096-c30d7199aaa4" :question/math-academy-id "q-275755" :question/problem "Determine the entry ${a}_{32}^{′}$ in the inverse of a matrix \n$$\n\\displaystyle A=\\begin{bmatrix}3 & 0 & -3 \\\\ 1 & -1 & -1 \\\\ 0 & 2 & -2\\end{bmatrix}.\n$$\n\n${a}_{32}^{′}=$\n{{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=\\begin{vmatrix}3 & 0 & -3 \\\\ 1 & -1 & -1 \\\\ 0 & 2 & -2\\end{vmatrix} & =3\\begin{vmatrix}-1 & -1 \\\\ 2 & -2\\end{vmatrix}-0\\begin{vmatrix}1 & -1 \\\\ 0 & -2\\end{vmatrix}+(-3)\\begin{vmatrix}1 & -1 \\\\ 0 & 2\\end{vmatrix} \\\\  & =3(2+2)-0-3(2-0) \\\\  & =6.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{32}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{32}^{t}={c}_{23}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{23} & =(-1)^{2+3}\\begin{vmatrix}3 & 0 \\\\ 0 & 2\\end{vmatrix} \\\\  & =-\\begin{vmatrix}3 & 0 \\\\ 0 & 2\\end{vmatrix} \\\\  & =-(6-0) \\\\  & =-6.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{32}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{32}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{23} \\\\  & =\\frac{1}{6}\\cdot (-6) \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0032ffbe-ef0e-59aa-b26f-1bbc10e77544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186290634}] :answer-field/correct {:db/id #edb/ref 17592186290634} :answer-field/id #uuid "84f92a9c-0b0f-5450-99ed-3b1e0df3d706" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292148}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a90f7ea-2f5b-53dd-b349-fa9148f654dc" :question/math-academy-id "q-275756" :question/problem "The entry ${a}_{12}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 0 & -1 \\\\ 1 & -1 & -1 \\\\ 0 & 1 & k\\end{bmatrix}\n$$\nequals $-\\frac{1}{2}$ and $det(A)=-k.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=-k\n$$\n\nSince we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}^{t}={c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}\\begin{vmatrix}0 & -1 \\\\ 1 & k\\end{vmatrix} \\\\  & =-\\begin{vmatrix}0 & -1 \\\\ 1 & k\\end{vmatrix} \\\\  & =-(0+1) \\\\  & =-1\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{12}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{21} \\\\  & =\\frac{1}{(-k)}\\cdot (-1) \\\\  & =\\frac{1}{k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{12}^{′}=-\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k} & =-\\frac{1}{2} \\\\ k & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dd1446d-3318-52d7-b8ca-ff5fb69db2c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186291032}] :answer-field/correct {:db/id #edb/ref 17592186291032} :answer-field/id #uuid "e08c8940-8a05-58bf-bed8-cc4535359cbf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292434}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3b033d4e-fbed-55f2-bf1a-00675137d39e" :question/math-academy-id "q-275757" :question/problem "The entry ${a}_{13}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & -1 & -1 \\\\ 2 & k & -2\\end{bmatrix}\n$$\nequals $-1.$ Find the value of $k.$\n\n$k=${{field-1}}" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=\\begin{vmatrix}1 & 1 & -1 \\\\ 2 & -1 & -1 \\\\ 2 & k & -2\\end{vmatrix} & =1\\begin{vmatrix}-1 & -1 \\\\ k & -2\\end{vmatrix}-1\\begin{vmatrix}2 & -1 \\\\ 2 & -2\\end{vmatrix}+(-1)\\begin{vmatrix}2 & -1 \\\\ 2 & k\\end{vmatrix} \\\\  & =(2+k)-(-4+2)-(2k+2) \\\\  & =2+k+2-2k-2 \\\\  & =2-k.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{13}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}^{t}={c}_{31}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{31} & =(-1)^{3+1}\\begin{vmatrix}1 & -1 \\\\ -1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ -1 & -1\\end{vmatrix} \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{13}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{13}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{31} \\\\  & =\\frac{1}{2-k}\\cdot (-2) \\\\  & =\\frac{2}{k-2}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{13}^{′}=-1$, we have\n\n$$\n\\begin{aligned}\\frac{2}{k-2} & =-1 \\\\ -1\\cdot (k-2) & =2 \\\\ k-2 & =-2 \\\\ k & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a3fe0d-b34c-5bb8-b1f3-dc5d8eca2468" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186290720}] :answer-field/correct {:db/id #edb/ref 17592186290720} :answer-field/id #uuid "07e2a83e-a1a8-5c12-9edf-33f4a344c96c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291760} {:answer-field/choices [{:answer/id #uuid "6634bf9f-785d-5998-8bc6-6bf2bf22b822" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186291066}] :answer-field/correct {:db/id #edb/ref 17592186291066} :answer-field/id #uuid "93a02cdf-28be-5434-93d5-c6e111efd86d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292197} {:answer-field/choices [{:answer/id #uuid "fec0e11e-aa0a-549e-b6fc-7edf5f309577" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186291721}] :answer-field/correct {:db/id #edb/ref 17592186291721} :answer-field/id #uuid "f1d42cae-af03-514c-b698-ac6e1baf7763" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292487}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b1472133-fedd-5702-9754-ac7f5c7dd85b" :question/math-academy-id "q-275787" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+z &=4x+y+2 \\\\ x+y &=2z+2 \\\\ y &=x-y+z+1\\end{aligned}\\right.\n$$\n\nFind the solution $x=[x,y,z]^{T}$ of the system by computing the inverse of the coefficient matrix.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$x=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First, let's rewrite the system in the correct order:\n\n$$\n\\left\\{\\begin{aligned}-3x-y+z &=2 \\\\ x+y-2z &=2 \\\\ -x+2y-z &=1\\end{aligned}\\right.\n$$\n\nNext, we  write the system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n\\begin{bmatrix}-3 & -1 & 1 \\\\ 1 & 1 & -2 \\\\ -1 & 2 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 2 \\\\ 1\\end{bmatrix}.\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}-3 & -1 & 1 \\\\ 1 & 1 & -2 \\\\ -1 & 2 & -1\\end{vmatrix} \\\\  & =-3\\begin{vmatrix}1 & -2 \\\\ 2 & -1\\end{vmatrix}-(-1)\\begin{vmatrix}1 & -2 \\\\ -1 & -1\\end{vmatrix}+1\\begin{vmatrix}1 & 1 \\\\ -1 & 2\\end{vmatrix} \\\\  & =-3(-1+4)+(-1-2)+(2+1) \\\\  & =-9-3+3 \\\\  & =-9.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}1 & -2 \\\\ 2 & -1\\end{vmatrix} & \\begin{vmatrix}1 & -2 \\\\ -1 & -1\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ -1 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}-1 & 1 \\\\ 2 & -1\\end{vmatrix} & \\begin{vmatrix}-3 & 1 \\\\ -1 & -1\\end{vmatrix} & \\begin{vmatrix}-3 & -1 \\\\ -1 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}-1 & 1 \\\\ 1 & -2\\end{vmatrix} & \\begin{vmatrix}-3 & 1 \\\\ 1 & -2\\end{vmatrix} & \\begin{vmatrix}-3 & -1 \\\\ 1 & 1\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -3 & 3 \\\\ -1 & 4 & -7 \\\\ 1 & 5 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=\\begin{bmatrix}3 & 3 & 3 \\\\ 1 & 4 & 7 \\\\ 1 & -5 & -2\\end{bmatrix}.\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=\\begin{bmatrix}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{bmatrix}.\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{9}\\begin{bmatrix}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{bmatrix}.\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{9}\\begin{bmatrix}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\  & =-\\frac{1}{9}\\begin{bmatrix}9 \\\\ 9 \\\\ 18\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37a8b394-dc1a-56e5-ada6-e0a77ad5fd82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{3}" :db/id #edb/ref 17592186290860}] :answer-field/correct {:db/id #edb/ref 17592186290860} :answer-field/id #uuid "3815fab7-6153-5efe-a792-f07623d07a98" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5ce2cb5e-3626-5f7f-a5f8-6a199333e771" :question/math-academy-id "q-275794" :question/problem "Find the Cartesian equation of the hyperbola $x=\\sqrt{3}\\operatorname{tan}⁡t,\\,y=2\\operatorname{sec}⁡t.$\n\n{{field-1}}\n$=1$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent Identity.\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{3}\\operatorname{tan}⁡t \\\\ \\frac{x}{\\sqrt{3}} & =\\operatorname{tan}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{3})^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{x}^{2}}{3} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =2\\operatorname{sec}⁡t \\\\ \\frac{y}{2} & =\\operatorname{sec}⁡t \\\\ \\frac{{y}^{2}}{{2}^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{4} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{3}+1 & =\\frac{{y}^{2}}{4} \\\\ \\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{3} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37c3f977-3e9a-5581-b7c7-0a753fe07a23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186290862}] :answer-field/correct {:db/id #edb/ref 17592186290862} :answer-field/id #uuid "1523ff22-33c0-5b63-8d7e-3e6f6fc4fd3d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291812}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1fbbeed8-3715-57e7-9c27-c12aff1cd8cd" :question/math-academy-id "q-275796" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=\\begin{bmatrix}-1 & 4 \\\\ 2 & -5\\end{bmatrix}?\n$$\n\nThe area scale factor is\n{{field-1}} ." :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|-1\\cdot (-5)-4\\cdot 2| \\\\  & =|5-8| \\\\  & =|-3| \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a83ab106-89dc-5fa2-af06-d95dca43e108" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186291367}] :answer-field/correct {:db/id #edb/ref 17592186291367} :answer-field/id #uuid "5fb45841-c0ff-5c19-8bdd-567e4db25b6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292025}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8634089c-33df-5988-9ded-93f44325cdf9" :question/math-academy-id "q-275981" :question/problem "The unit square $D$ has vertices $(1,0),(0,0),(0,1),(1,1).$ What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}6 & 1 \\\\ 0 & 2\\end{bmatrix}\n$$\n\n$\\text{Area}(T(D))=$\n{{field-1}}" :question/worked-solution "First, let's sketch our region:\n\n![](images/68/6805467a24cb40559f205cbfcecc4f5a34ff2ec6ebda8ae67f997c02f123b53c.png)\n\nRecall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=1\\cdot 1=1.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=6\\cdot 2-0\\cdot 1=12.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,12\\,|\\cdot 1 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9a32d0-01ff-5fb2-8117-4707bdbee4ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186290744}] :answer-field/correct {:db/id #edb/ref 17592186290744} :answer-field/id #uuid "3cdd15ad-3eed-5010-b2ec-68df5076df03" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291943}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cdc6b8c5-10ed-5f95-a14d-218d0c9272e7" :question/math-academy-id "q-275983" :question/problem "The triangle $D$ has vertices $(2,2),(4,6),(6,2).$ What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}1 & 3 \\\\ -2 & 0\\end{bmatrix}\n$$\n\n$\\text{Area}(T(D))=$\n{{field-1}}" :question/worked-solution "First, let's sketch our region:\n\n![](images/a4/a4e507191aecd02e16fafba29598972df423e975dd554b260ca355f0cf6476a1.png)\n\nRecall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot 4\\cdot 4=8.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=1\\cdot 0-3\\cdot (-2)=6.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,6\\,|\\cdot 8 \\\\  & =48.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee12904a-c1d1-5fca-be49-dfc28b82133d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186291626}] :answer-field/correct {:db/id #edb/ref 17592186291626} :answer-field/id #uuid "d58c800e-db81-5f5d-a314-1fbbd43f6acc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292382}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9afdc46e-e890-5eab-ac3f-a6908140cd13" :question/math-academy-id "q-275984" :question/problem "![](images/32/32fc2965c35872f2511ab7c24e931d62c8cbcc6d1c70c67cad6016dedad5d8fd.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}0 & -1 \\\\ 2 & 3\\end{bmatrix}\n$$\n\n$\\text{Area}(T(D))=$\n{{field-1}}" :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=2\\cdot 3=6.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=0\\cdot 3-(-1)\\cdot 2=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,2\\,|\\cdot 6 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186294925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87a39b75-5b5c-52ce-a925-9fed75ea83ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186293462}] :answer-field/correct {:db/id #edb/ref 17592186293462} :answer-field/id #uuid "67766d4c-25f8-5df8-bac1-69f39dc42703" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294294} {:answer-field/choices [{:answer/id #uuid "612370e1-06c2-53fb-b10d-99a6427989b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}({log}_{3}(8)+1)" :db/id #edb/ref 17592186293329}] :answer-field/correct {:db/id #edb/ref 17592186293329} :answer-field/id #uuid "b301b102-60f4-506b-82ed-b4052d4a7977" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294575}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e7b48d4-ce79-57fa-8f7a-79e784ea9598" :question/math-academy-id "q-277844" :question/problem "Solve the inequality $\\frac{1}{4}\\cdot {3}^{2x-1}\\ge 2.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{4}\\cdot {3}^{2x-1} & \\ge 2 \\\\ {3}^{2x-1} & \\ge 8.\\end{aligned}\n$$\n\nThen, taking the logarithm to base $3$ of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}{log}_{3}⁡({3}^{2x-1}) & \\ge {log}_{3}⁡(8) \\\\ 2x-1 & \\ge {log}_{3}⁡(8) \\\\ 2x & \\ge {log}_{3}⁡(8)+1 \\\\ x & \\ge \\frac{1}{2}({log}_{3}⁡(8)+1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186294926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea38e6be-f014-5512-a1ba-8ccb320a90bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}(14)" :db/id #edb/ref 17592186293846} {:answer/id #uuid "91970135-4657-52ee-9605-13ea624195a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\log_{4}(14)" :db/id #edb/ref 17592186548640}] :answer-field/correct {:db/id #edb/ref 17592186548640} :answer-field/id #uuid "12bd06f5-c128-5ece-a1ad-42f93aab1e1c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186293989} {:answer-field/choices [{:answer/id #uuid "d80fb632-82ac-5a2d-82ff-8e718314f84a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186293771} {:answer/id #uuid "2b25051c-b8bf-5ffe-b946-a66583b2154e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value ">" :db/id #edb/ref 17592186548438}] :answer-field/correct {:db/id #edb/ref 17592186548438} :answer-field/id #uuid "2a79b385-65a0-5ead-8571-f9e6b4e68eee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294072}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d5edd14-7e7b-53cf-8d2d-da6793a07e0a" :question/math-academy-id "q-277846" :question/problem "Solve the inequality $\\frac{1}{2}\\cdot {4}^{x}>7.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{2}\\cdot {4}^{x} & >7 \\\\ {4}^{x} & >14.\\end{aligned}\n$$\n\nThen, taking the logarithm to base $4$ of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}{log}_{4}⁡({4}^{x}) & >{log}_{4}⁡(14) \\\\ x & >{log}_{4}⁡(14).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186294927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32a0b6a5-2609-508e-9eea-d042d58c62ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{log}_{9}(12)" :db/id #edb/ref 17592186293147}] :answer-field/correct {:db/id #edb/ref 17592186293147} :answer-field/id #uuid "20762090-4186-5d00-a08b-231bd3bf35b7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294036} {:answer-field/choices [{:answer/id #uuid "f26001d2-5db0-5eb8-8746-bf5da7b5090d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186293878}] :answer-field/correct {:db/id #edb/ref 17592186293878} :answer-field/id #uuid "667b8cea-d746-596a-a0c3-901b029db669" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294290}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "afa06374-fd1e-58d7-85c5-0dcba6a7a370" :question/math-academy-id "q-277847" :question/problem "Solve the inequality $8\\cdot {9}^{x}\\ge \\frac{2}{3}.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}8\\cdot {9}^{x} & \\ge \\frac{2}{3} \\\\ {9}^{x} & \\ge \\frac{1}{12}.\\end{aligned}\n$$\n\nThen, taking the logarithm to base $9$ of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}{log}_{9}⁡({9}^{x}) & \\ge {log}_{9}⁡\\left(\\frac{1}{12}\\right) \\\\ {log}_{9}⁡({9}^{x}) & \\ge {log}_{9}⁡({12}^{-1}) \\\\ x & \\ge -{log}_{9}⁡(12).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48d7f4db-ef4c-56cc-99e6-9bf7f3b331f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186293231}] :answer-field/correct {:db/id #edb/ref 17592186293231} :answer-field/id #uuid "6fd39daf-ed23-50f0-a8cc-1d6b2fe174b1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294325} {:answer-field/choices [{:answer/id #uuid "ed812d92-cf9b-55dd-be6b-9009c91cfefb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186293855}] :answer-field/correct {:db/id #edb/ref 17592186293855} :answer-field/id #uuid "a4470776-9a09-5a98-8e15-08440507ee7b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294520} {:answer-field/choices [{:answer/id #uuid "4a76e0df-ea05-5a84-af25-c3368e8292cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186293240}] :answer-field/correct {:db/id #edb/ref 17592186293240} :answer-field/id #uuid "b85ddf6e-58e5-509f-9739-8f35b751d386" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294589}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ec4391b-c16d-5ae7-9c68-9a2dc8e4592b" :question/math-academy-id "q-278508" :question/problem "Solve the inequality $9{log}_{4}⁡(5x-10)-6<3.$\n\n{{field-1}}{{field-2}}$x\\,<$\n{{field-3}}" :question/worked-solution "First, we isolate the logarithm:\n\n$$\n\\begin{aligned}9{log}_{4}⁡(5x-10)-6 & <3 \\\\ 9{log}_{4}⁡(5x-10) & <9 \\\\ {log}_{4}⁡(5x-10) & <1\\end{aligned}\n$$\n\nNow, we use each side of the inequality as an exponent of $4.$ We get the following:\n\n$$\n\\begin{aligned}{4}^{{log}_{4}⁡(5x-10)} & <{4}^{1} \\\\ 5x-10 & <4 \\\\ 5x & <14 \\\\ x & <\\frac{14}{5}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithm in the original inequality. To find the domain of the logarithm, we recall that the argument of the logarithm must be positive:\n\n$$\n5x-10>0\\,⇒\\,x>2\n$$\n\nOur solution is $x<\\frac{14}{5},$ which can be expressed as $(-\\infty ,\\frac{14}{5}).$ Additionally, the domain of the logarithm is $x>2,$ which can be expressed as $(2,\\infty ).$ To find the solutions that are in the domain of the logarithm, we take the intersection:\n\n$$\n(-\\infty ,\\frac{14}{5})\\cap (2,\\infty )=(2,\\frac{14}{5})\n$$\n\nTherefore, the solution is $x\\in (2,\\frac{14}{5}),$ which can also be written as $2<x<\\frac{14}{5}.$"} {:db/id #edb/ref 17592186295033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e58acbd0-7625-535e-95ac-19dffa370229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186293831}] :answer-field/correct {:db/id #edb/ref 17592186293831} :answer-field/id #uuid "1d22ab58-7a75-5c9d-8990-f2155b5b40dc" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294023} {:answer-field/choices [{:answer/id #uuid "e7469d9c-3548-58de-b572-dea06607bb6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186293837}] :answer-field/correct {:db/id #edb/ref 17592186293837} :answer-field/id #uuid "b390c223-ce9a-5341-86ff-3c9d730ec96c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294578}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "084cdbb0-0280-5159-90c7-cdb66bd5f599" :question/math-academy-id "q-278673" :question/problem "Solve the inequality ${log}_{5}⁡(6x-3)\\ge {log}_{5}⁡(3x+9).$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "We use each side of the inequality as an exponent of $5.$ This gives the following:\n\n$$\n\\begin{aligned}{5}^{\\operatorname{log}⁡(6x-3)} & \\ge {5}^{\\operatorname{log}⁡(3x+9)} \\\\ 6x-3 & \\ge 3x+9 \\\\ 3x & \\ge 12 \\\\ x & \\ge 4\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:\n\n$$\n\\begin{aligned}6x-3 & >0 & ⇒ &  & x & >\\frac{1}{2} \\\\ 3x+9 & >0 & ⇒ &  & x & >-3\\end{aligned}\n$$\n\nOur solution is $x\\ge 4,$ which can be expressed as $[4,\\infty ).$ Additionally, the domains of the logarithms are $x>\\frac{1}{2}$ and $x>-3,$ which can be expressed as $(\\frac{1}{2},\\infty )$ and $(-3,\\infty )$ respectively. To find the solutions that are in the domains of the logarithms, we take the intersection:\n\n$$\n[4,\\infty )\\cap (\\frac{1}{2},\\infty )\\cap (-3,\\infty )=[4,\\infty )\n$$\n\nTherefore, the solution is $x\\in [4,\\infty ),$ which can also be written as $x\\ge 4.$"} {:db/id #edb/ref 17592186295040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "484e9b5b-7ec5-5c7e-81d4-785057f24208" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All real numbers except the values $x=-\\frac{\\pi }{2}+2n\\pi $ for any integer $n$" :db/id #edb/ref 17592186293228} {:answer/id #uuid "6a9870d8-cc15-566d-abce-b5c337c8c24e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All real numbers except the value $0$" :db/id #edb/ref 17592186293376} {:answer/id #uuid "a19cad40-260d-5965-b211-375cec090e3b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All real numbers except the values $x=n\\pi $ for any integer $n$" :db/id #edb/ref 17592186293568} {:answer/id #uuid "b1769fad-0552-5e48-b29a-ee9d11af87a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All real numbers except the values $x=\\frac{\\pi }{2}+n\\pi $ for any integer $n$" :db/id #edb/ref 17592186293627} {:answer/id #uuid "fbe4efe0-1634-51af-96b3-8d5cabcfeb75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All real numbers except the values $x=2n\\pi $ for any integer $n$" :db/id #edb/ref 17592186293918}] :answer-field/correct {:db/id #edb/ref 17592186293568} :answer-field/id #uuid "e4c07dfb-ae7f-5202-a834-134337f902c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186294737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f81ea686-4120-5c45-938a-e6e0324c336c" :question/math-academy-id "q-27910" :question/problem "What is the domain of $y=cot⁡x?$" :question/worked-solution "Let's recall the graph of $y=cot⁡x.$\n\n![](images/22/22674bef9e806fca07026b8d441877c251761de4c64cc005eed912e62a34ce67.png)\n\nNote that:\n\n- The function $y=cot⁡x$ is defined for all real numbers except the values $x=n\\pi $ for any integer $n.$"} {:db/id #edb/ref 17592186295072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0462ddf3-90a3-5ab6-a456-1ff7a836f3c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2n\\pi " :db/id #edb/ref 17592186292950} {:answer/id #uuid "46ad3340-134d-5edc-be10-2536f5bb6ded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=n\\pi " :db/id #edb/ref 17592186293222} {:answer/id #uuid "79bc83f9-c96c-5499-a318-46fb0fef515e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186293421} {:answer/id #uuid "8176e59c-aa46-5cb9-96ac-287e4094d69e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=n\\pi " :db/id #edb/ref 17592186293451} {:answer/id #uuid "cb560abe-8d7c-58b1-9775-c18ee6e576f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186293720}] :answer-field/correct {:db/id #edb/ref 17592186293451} :answer-field/id #uuid "a1e1078d-dc2f-5cd6-ba92-c5fc27c498c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186294515}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "050464a7-5479-591b-a2a4-d7fb8ff766e4" :question/math-academy-id "q-27946" :question/problem "Which expression gives all of the asymptotes of $y=cot⁡x?$ Assume $n$ is an integer." :question/worked-solution "Let's recall the graph of $y=cot⁡x.$\n\n![](images/22/22674bef9e806fca07026b8d441877c251761de4c64cc005eed912e62a34ce67.png)\n\nNote that:\n\n- The vertical asymptotes of the graph occur at integer multiples of $\\pi ,$ such as $0,\\pm \\pi ,\\pm 2\\pi ,…$\n\nTherefore, the asymptotes of $y=cot⁡x$ occur at $x=n\\pi $ for integer $n.$"} {:db/id #edb/ref 17592186295073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95f286cb-962a-5369-86ee-a115523b6724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186293520}] :answer-field/correct {:db/id #edb/ref 17592186293520} :answer-field/id #uuid "b2a30617-f8ef-515a-98d4-eb78551feac8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294572}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b49ee3c3-6e96-54ae-a1e6-faa62914d565" :question/math-academy-id "q-279463" :question/problem "If $z=6-10\\text{i}$, then $z+\\overset{―}{z}=${{field-1}}." :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=6-10\\text{i},$ the real part is $Re(z)=6,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(6) \\\\  & =12.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=6-10\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=6+10\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(6-10\\text{i})+(6+10\\text{i}) \\\\  & =(6+6)+\\text{i}(-10+10) \\\\  & =12+\\text{i}0 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb31b60f-3050-5ef7-b4c3-2476ae1e52f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-146" :db/id #edb/ref 17592186293849}] :answer-field/correct {:db/id #edb/ref 17592186293849} :answer-field/id #uuid "9e0b8646-041e-54fe-904d-5fd7e7631312" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294500}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6794ccbb-8ffd-5507-a0b5-d0921c89d7f6" :question/math-academy-id "q-280387" :question/problem "If $H=\\begin{bmatrix}0 & 7 & 2 \\\\ 1 & 0 & -5 \\\\ 4 & -3 & 0\\end{bmatrix},$ then $det(H)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & 7 & 2 \\\\ 1 & 0 & -5 \\\\ 4 & -3 & 0\\end{vmatrix} & =0\\begin{vmatrix}0 & -5 \\\\ -3 & 0\\end{vmatrix}-7\\begin{vmatrix}1 & -5 \\\\ 4 & 0\\end{vmatrix}+2\\begin{vmatrix}1 & 0 \\\\ 4 & -3\\end{vmatrix} \\\\  & =0-7(0-(-20))+2(-3-0) \\\\  & =-7\\cdot (20)+2\\cdot (-3) \\\\  & =-140-6 \\\\  & =-146\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a27456-d8f3-561b-bb79-e130d6872c6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186293031}] :answer-field/correct {:db/id #edb/ref 17592186293031} :answer-field/id #uuid "3d897447-080d-5fa1-811f-5026bf48e4a4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294141}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee0a6b76-25b3-5557-92d9-083561656751" :question/math-academy-id "q-280390" :question/problem "If $A=\\begin{bmatrix}0 & 2 & -3 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & 4\\end{bmatrix},$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & 2 & -3 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & 4\\end{vmatrix} & =0\\begin{vmatrix}0 & 5 \\\\ 0 & 4\\end{vmatrix}-2\\begin{vmatrix}0 & 5 \\\\ 0 & 4\\end{vmatrix}+(-3)\\begin{vmatrix}0 & 0 \\\\ 0 & 0\\end{vmatrix} \\\\  & =0-2(0-0)-3(0-0) \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1339ed7b-7b32-5f2e-97a1-9339503ac331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "87" :db/id #edb/ref 17592186293012}] :answer-field/correct {:db/id #edb/ref 17592186293012} :answer-field/id #uuid "93fac66a-4741-5f19-907d-88bd6bf67c55" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294462}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "602c9b3b-40e9-5371-929a-34e8b2aaccf1" :question/math-academy-id "q-280393" :question/problem "If $Q=\\begin{bmatrix}3 & -2 & 5 \\\\ 4 & 1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix},$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & -2 & 5 \\\\ 4 & 1 & 0 \\\\ -1 & 3 & 2\\end{vmatrix} & =3\\begin{vmatrix}1 & 0 \\\\ 3 & 2\\end{vmatrix}-(-2)\\begin{vmatrix}4 & 0 \\\\ -1 & 2\\end{vmatrix}+5\\begin{vmatrix}4 & 1 \\\\ -1 & 3\\end{vmatrix} \\\\  & =3(1\\cdot 2-0\\cdot 3)+2(4\\cdot 2-0\\cdot (-1))+5(4\\cdot 3-1\\cdot (-1)) \\\\  & =3(2)+2(8)+5(12+1) \\\\  & =6+16+5(13) \\\\  & =6+16+65 \\\\  & =87\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7756ac8b-4d3e-5612-bad7-e5a160c5a43f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-33" :db/id #edb/ref 17592186293420}] :answer-field/correct {:db/id #edb/ref 17592186293420} :answer-field/id #uuid "a7577202-1833-561f-80ac-32392b1ecb99" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294534}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5aadd6ce-d715-5a22-9944-d786941130cb" :question/math-academy-id "q-280394" :question/problem "If $R=\\begin{bmatrix}1 & -2 & 0 \\\\ 4 & 3 & 5 \\\\ 6 & -1 & 2\\end{bmatrix},$ then $det(R)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & -2 & 0 \\\\ 4 & 3 & 5 \\\\ 6 & -1 & 2\\end{vmatrix} & =1\\begin{vmatrix}3 & 5 \\\\ -1 & 2\\end{vmatrix}-(-2)\\begin{vmatrix}4 & 5 \\\\ 6 & 2\\end{vmatrix}+0\\begin{vmatrix}4 & 3 \\\\ 6 & -1\\end{vmatrix} \\\\  & =1(3\\cdot 2-5\\cdot (-1))+2(4\\cdot 2-5\\cdot 6)+0 \\\\  & =1(6+5)+2(8-30) \\\\  & =11+2(-22) \\\\  & =11-44 \\\\  & =-33\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "199cfd6b-b7c6-5ebd-9bb2-5a78fca81a8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "69" :db/id #edb/ref 17592186293039}] :answer-field/correct {:db/id #edb/ref 17592186293039} :answer-field/id #uuid "ca1eadfe-246c-5ca2-a02d-27c7056e56da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294645}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c583368-3601-5727-a2d2-942c7b9558d3" :question/math-academy-id "q-280400" :question/problem "If $W=\\begin{bmatrix}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{bmatrix},$ then $det(W)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{vmatrix} & =5\\begin{vmatrix}4 & 6 \\\\ -3 & 1\\end{vmatrix}-(-2)\\begin{vmatrix}-1 & 6 \\\\ 2 & 1\\end{vmatrix}+3\\begin{vmatrix}-1 & 4 \\\\ 2 & -3\\end{vmatrix} \\\\  & =5(4\\cdot 1-6\\cdot (-3))+2((-1)(1)-6\\cdot 2)+3((-1)(-3)-4\\cdot 2) \\\\  & =5(4+18)+2(-1-12)+3(3-8) \\\\  & =5(22)+2(-13)+3(-5) \\\\  & =110-26-15 \\\\  & =69\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b6fb57b-36e2-543a-ab01-e63593d507d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "44" :db/id #edb/ref 17592186293544}] :answer-field/correct {:db/id #edb/ref 17592186293544} :answer-field/id #uuid "9633885c-c66b-52e8-84a6-2cf06bb918b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294471}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8c1908a-4170-5ad4-8920-81bd7dfc6050" :question/math-academy-id "q-280403" :question/problem "Given that $A=\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & x & 4 \\\\ -2 & 5 & 1\\end{bmatrix}$ and $det(A)=37$, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}\\text{det}(F) & =\\begin{vmatrix}2 & 1 & 0 \\\\ 3 & x & 4 \\\\ -2 & 5 & 1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}x & 4 \\\\ 5 & 1\\end{vmatrix}-1\\begin{vmatrix}3 & 4 \\\\ -2 & 1\\end{vmatrix}+0\\begin{vmatrix}3 & x \\\\ -2 & 5\\end{vmatrix} \\\\  & =2(x\\cdot 1-4\\cdot 5)-(3\\cdot 1-4\\cdot (-2)) \\\\  & =2(x-20)-(3+8) \\\\  & =2x-40-11 \\\\  & =2x-51\\end{aligned}\n$$\n\nSince the determinant of the matrix is $37,$ we have\n\n$$\n\\begin{aligned}2x-51 & =37 \\\\ 2x & =88 \\\\ x & =44.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a14d7c-c976-5346-a0ff-1a7451eb909b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{43}}{2}" :db/id #edb/ref 17592186293594}] :answer-field/correct {:db/id #edb/ref 17592186293594} :answer-field/id #uuid "744d1c09-7fab-597a-b711-9626275fab38" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294339} {:answer-field/choices [{:answer/id #uuid "0e75f6dd-e85a-5f64-bcc4-624a0a4629af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{43}}{2}" :db/id #edb/ref 17592186292998}] :answer-field/correct {:db/id #edb/ref 17592186292998} :answer-field/id #uuid "d728a0ab-06b9-5153-aa9d-039b19b0b1ea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294689}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "854d343a-6ceb-5dbc-aed9-5a3bba384840" :question/math-academy-id "q-280540" :question/problem "Given that the determinant of $\\begin{bmatrix}{x}^{2}-2 & 3 & 0 \\\\ x & -2 & -1 \\\\ 1 & 4 & 0\\end{bmatrix}$ is $32$, find all the possible values of $x$ **in ascending order**.\n\nIn ascending order, $x=$\n{{field-1}} and $x=$\n{{field-2}}." :question/worked-solution "Let’s use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}{x}^{2}-2 & 3 & 0 \\\\ x & -2 & -1 \\\\ 1 & 4 & 0\\end{vmatrix} \\\\  & =({x}^{2}-2)\\begin{vmatrix}-2 & -1 \\\\ 4 & 0\\end{vmatrix}-3\\begin{vmatrix}x & -1 \\\\ 1 & 0\\end{vmatrix}+0 \\\\  & =({x}^{2}-2)(-2\\cdot 0-(-1)(4))-3(x\\cdot 0-(-1)(1)) \\\\  & =({x}^{2}-2)(4)-3(1) \\\\  & =4{x}^{2}-8-3 \\\\  & =4{x}^{2}-11\\end{aligned}\n$$\n\nSince the determinant of the matrix is $32$, we have\n\n$$\n\\begin{aligned}4{x}^{2}-11 & =32 \\\\ 4{x}^{2} & =43 \\\\ {x}^{2} & =\\frac{43}{4} \\\\ x & =\\pm \\sqrt{\\frac{43}{4}} \\\\  & =\\pm \\frac{\\sqrt{43}}{2}\\end{aligned}\n$$\n\nTherefore, **in ascending order**, the solutions are $x=-\\frac{\\sqrt{43}}{2}$ and $x=\\frac{\\sqrt{43}}{2}.$"} {:db/id #edb/ref 17592186295161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0455064-a7d8-59fd-ac77-33abf41ca336" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186293865}] :answer-field/correct {:db/id #edb/ref 17592186293865} :answer-field/id #uuid "718e1993-6243-5b67-ad85-b48d5e4c1b0e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294333} {:answer-field/choices [{:answer/id #uuid "f5474c54-161f-5c59-93d2-847eb2a1ab3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186293891}] :answer-field/correct {:db/id #edb/ref 17592186293891} :answer-field/id #uuid "904e7486-ae2f-53e2-a8b8-33a2fef9eb06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294451}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f11851f4-08f0-546e-8ec7-83f1d8f0d049" :question/math-academy-id "q-280541" :question/problem "Given that the determinant of $\\begin{bmatrix}x & 2x & 5 \\\\ 3 & x & 4 \\\\ 7 & 1 & 2\\end{bmatrix}$ is $40$, find all the possible values of $x$ **in ascending order**.\n\nIn ascending order, $x=$\n{{field-1}} and $x=$\n{{field-2}}." :question/worked-solution "Let’s use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}x & 2x & 5 \\\\ 3 & x & 4 \\\\ 7 & 1 & 2\\end{vmatrix} \\\\  & =x\\begin{vmatrix}x & 4 \\\\ 1 & 2\\end{vmatrix}-2x\\begin{vmatrix}3 & 4 \\\\ 7 & 2\\end{vmatrix}+5\\begin{vmatrix}3 & x \\\\ 7 & 1\\end{vmatrix} \\\\  & =x(2x-4)-2x(3\\cdot 2-4\\cdot 7)+5(3-7x) \\\\  & =x(2x-4)-2x(-22)+15-35x \\\\  & =2{x}^{2}-4x+44x+15-35x \\\\  & =2{x}^{2}+5x+15\\end{aligned}\n$$\n\nSince the determinant of the matrix is $40$, we have\n\n$$\n\\begin{aligned}2{x}^{2}+5x+15 & =40 \\\\ 2{x}^{2}+5x-25 & =0 \\\\ x & =\\frac{-5\\pm \\sqrt{{5}^{2}-4(2)(-25)}}{2(2)} \\\\ x & =\\frac{-5+\\sqrt{225}}{4} \\\\  & =\\frac{-5\\pm 15}{4}.\\end{aligned}\n$$\n\nTherefore, **in ascending order**, the solutions are $x=-5$ and $x=\\frac{5}{2}.$"} {:answer/id #uuid "00628492-eb93-5878-979e-30036d304edf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186295270} {:answer/id #uuid "032db269-5170-5f9b-a293-a64c6b8de5f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡x+C" :db/id #edb/ref 17592186295278} {:answer/id #uuid "03eaae83-aa97-5d62-99ec-86500aa38887" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot \\frac{x}{ln⁡5}+{e}^{x}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295284} {:answer/id #uuid "097bf9be-35d0-5117-aeeb-185f65a4e444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡3\\cdot \\frac{{log}_{2}⁡x}{2}+C" :db/id #edb/ref 17592186295316} {:answer/id #uuid "0abba1e8-07a5-5982-8931-920e2b54ed11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5ln⁡|x|+C" :db/id #edb/ref 17592186295324} {:answer/id #uuid "0b9f3ccb-57a5-54e7-9651-cd8e38e071bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/id #edb/ref 17592186295330} {:answer/id #uuid "0c595f3e-4a64-5335-bfee-ef4f9c199d44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186295335} {:answer/id #uuid "0cfff078-9fb4-5b67-bb26-7811957a40b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{e}^{ln⁡x}+C" :db/id #edb/ref 17592186295341} {:answer/id #uuid "0dae15a2-1ee3-5e1c-9740-88dbcb27308a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186295346} {:answer/id #uuid "0e5a70b3-ab83-532b-aa08-1862b689d752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}{x}^{7/3}-3ln⁡|x|+C" :db/id #edb/ref 17592186295352} {:a