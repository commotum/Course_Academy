7592186045492} :db/id #edb/ref 17592186297027}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c61512ea-75fe-570f-a0cc-dddb6d063776" :question/math-academy-id "q-316609" :question/problem "The triangle $D$ has vertices $(2,2),(5,2),(4,5).$ What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}-5 & 0 \\\\ 0 & -2\\end{bmatrix}\n$$\n\n$\\text{Area}(T(D))=$\n{{field-1}}" :question/worked-solution "First, let's sketch our region:\n\n![](images/ae/aef99dd5276166e5c7b4fb2f716b060390b6577f2d3625dd5dc835bcec6c4856.png)\n\nRecall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot 3\\cdot 3=\\frac{9}{2}.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=(-5)\\cdot (-2)-0\\cdot 0=10.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,10\\,|\\cdot \\frac{9}{2} \\\\  & =45.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0336dc05-5463-5201-a8da-0faecf9910eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186295279}] :answer-field/correct {:db/id #edb/ref 17592186295279} :answer-field/id #uuid "721c731e-98d6-587b-9ae2-2a2d48e7465a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296870}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "afbe4468-f038-5a99-8fab-8d1cd8807b58" :question/math-academy-id "q-316612" :question/problem "The triangle $D$ has vertices $(2,1),(6,1),(5,4).$ What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}4 & 1 \\\\ -3 & 1\\end{bmatrix}\n$$\n\n$\\text{Area}(T(D))=$\n{{field-1}}" :question/worked-solution "First, let's sketch our region:\n\n![](images/92/92ee29a22baa10f4af25db8221e7d67c729f5f0f1b5e1b3c37aee7e31a92bdfb.png)\n\nRecall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot 4\\cdot 3=6.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=4\\cdot 1-1\\cdot (-3)=4+3=7.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,7\\,|\\cdot 6 \\\\  & =42.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c47da02-0de3-57ba-80b0-c125c05b20e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡5}{3}" :db/id #edb/ref 17592186295525} {:answer/id #uuid "4c228dda-3c12-503a-ae76-b6dbd65e3cfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{ln}⁡3}{2\\sqrt{5}}" :db/id #edb/ref 17592186295701} {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} {:answer/id #uuid "cb2d8a19-1869-5d11-b6b2-5d7224310807" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296333} {:answer/id #uuid "fe9d3052-96a7-52e6-88ad-4c8dcf860d47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{31\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296624}] :answer-field/correct {:db/id #edb/ref 17592186295887} :answer-field/id #uuid "d0467277-3365-50ac-9fc9-dd5fec40a456" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186297066}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7168c66b-e063-53c6-92aa-cf6372184dec" :question/math-academy-id "q-31669" :question/problem "What is the value of $$\n\\displaystyle {\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x?\n$$" :question/worked-solution "Let $u={log}_{5}⁡(5x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x\\operatorname{ln}⁡5}\\cdot 5=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x & =7{\\int }_{1}^{5}{log}_{5}⁡(5x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =7{\\int }_{1}^{2}u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}{|}_{1}^{2} \\\\  & =7\\operatorname{ln}⁡5\\cdot (\\frac{4}{2}-\\frac{1}{2}) \\\\  & =\\frac{21\\operatorname{ln}⁡5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "774f2323-67ac-5cdc-be84-7c83c08e1d31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186295917}] :answer-field/correct {:db/id #edb/ref 17592186295917} :answer-field/id #uuid "2a818b40-3c97-5c91-bfcb-9784b9054765" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296716} {:answer-field/choices [{:answer/id #uuid "690f3afb-ceb8-5b8e-bb3e-5cad6f4dfb7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186295857}] :answer-field/correct {:db/id #edb/ref 17592186295857} :answer-field/id #uuid "2d4a0345-1cd9-58bc-a954-d45105626bff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296719} {:answer-field/choices [{:answer/id #uuid "f5743304-7d60-5006-a86f-7e14ddb7f705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186296570}] :answer-field/correct {:db/id #edb/ref 17592186296570} :answer-field/id #uuid "e3a534a3-319d-5a0d-ba11-55a736a3ca56" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186297105}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5afec83f-c01d-57b0-a129-7a451b173c66" :question/math-academy-id "q-316753" :question/problem "Calculate ${A}^{-1},$ where\n$$\n\\displaystyle A=\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$-2$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=(-6)\\cdot 2-3\\cdot (-5)=3\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ -(-5) & -6\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ 5 & -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix}\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {A}^{-1}A & =\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix}\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f66079f-8a13-5f2d-b31c-0226934fa120" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186295881}] :answer-field/correct {:db/id #edb/ref 17592186295881} :answer-field/id #uuid "2471fbb6-4020-556f-a24a-22a1c2f5e2a0" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296698} {:answer-field/choices [{:answer/id #uuid "0e7b5b59-0ba4-5602-87fc-1603751e6151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186295353}] :answer-field/correct {:db/id #edb/ref 17592186295353} :answer-field/id #uuid "7d537624-30b3-5cb7-b8f0-e8594a47571a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296889} {:answer-field/choices [{:answer/id #uuid "64863451-c3cd-5629-ac5b-993b0bd3afb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186295839}] :answer-field/correct {:db/id #edb/ref 17592186295839} :answer-field/id #uuid "d1ddbf64-a9bc-5822-9543-9eb5227576a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186297071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c5d479a-db20-5ea3-ab0e-6622e81ae62c" :question/math-academy-id "q-316768" :question/problem "Calculate ${A}^{-1},$ where\n$$\n\\displaystyle A=\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$0$</td></tr>\n<tr><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=5\\cdot (-2)-0\\cdot 0=-10\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{-10}\\begin{bmatrix}-2 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1/5 & 0 \\\\ 0 & -1/2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}1/5 & 0 \\\\ 0 & -1/2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {A}^{-1}A & =\\begin{bmatrix}1/5 & 0 \\\\ 0 & -1/2\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ff1b0a9-fde2-5367-87f0-bb860645334c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186298176}] :answer-field/correct {:db/id #edb/ref 17592186298176} :answer-field/id #uuid "588ee9fc-b1ad-590a-902a-aa67ff051060" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298940} {:answer-field/choices [{:answer/id #uuid "4e235848-7d84-5c03-8f30-0fd2297b7d8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186297879} {:answer/id #uuid "d0dc05a3-9592-4ffe-8c1f-fecc32b0cb4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac16" :db/id #edb/ref 17592186747015}] :answer-field/correct {:db/id #edb/ref 17592186297879} :answer-field/id #uuid "98cadb3e-fd34-5d08-9dd7-982a5a1572bf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299143} {:answer-field/choices [{:answer/id #uuid "a55fb1b2-3b16-5c94-9d74-cc1c7a144fb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186298278} {:answer/id #uuid "9e6e167a-c84a-4720-b8c8-5f70102f3d3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac34" :db/id #edb/ref 17592186747016}] :answer-field/correct {:db/id #edb/ref 17592186298278} :answer-field/id #uuid "e519f8fb-61e9-5c0d-a5e4-7091ce4b87b3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2eafafcb-8727-5ab6-b75d-030156359000" :question/math-academy-id "q-316780" :question/problem "Calculate ${A}^{-1},$ where\n$$\n\\displaystyle A=\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${A}^{-1}=\\hspace{0.222em}\\hspace{0.222em}$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$-\\frac{1}{2}$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=6\\cdot 1-2\\cdot 9=-12\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{-12}\\begin{bmatrix}1 & -2 \\\\ -9 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix}\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓} \\\\ {A}^{-1}A & =\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix}\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,{\\color{green}✓}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b2c8819-78f4-5fff-bc17-cec5c19efd38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186298086}] :answer-field/correct {:db/id #edb/ref 17592186298086} :answer-field/id #uuid "b790ef95-1954-53e9-951c-93434ba44d92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299257}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95d2a0a0-79cd-50d5-95db-d0f4cfda76fd" :question/math-academy-id "q-316781" :question/problem "If $B=\\begin{bmatrix}2x & 5x-1 \\\\ 4 & -2\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x)\\cdot (-2)-4\\cdot (5x-1) \\\\  & =-4x+4-20x \\\\  & =-24x+4.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-24x+4 & =0 \\\\ 24x & =4 \\\\ x & =\\frac{4}{24} \\\\ x & =\\frac{1}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "892579b6-7828-5a0d-ab85-d5b77ff9a388" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186298147}] :answer-field/correct {:db/id #edb/ref 17592186298147} :answer-field/id #uuid "e05f6368-cb27-51a1-9aa0-8c61326772fd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299398}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e69fc32-4426-5cb8-9829-2fc1f8cd28fb" :question/math-academy-id "q-316782" :question/problem "If $B=\\begin{bmatrix}1 & 2 \\\\ 3x+2 & 2x-4\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =1\\cdot (2x-4)-2\\cdot (3x+2) \\\\  & =2x-4-6x-4 \\\\  & =-4x-8.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-4x-8 & =0 \\\\ -4x & =8 \\\\ x & =-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f65bbf81-a8fe-5107-aa3e-22d11d717c75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186298604} {:answer/id #uuid "093503b2-c5a2-487b-b9f9-f087c1d15faf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac12" :db/id #edb/ref 17592186747026}] :answer-field/correct {:db/id #edb/ref 17592186298604} :answer-field/id #uuid "635dc510-988f-5cfd-b2b9-b02500ed4e94" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298971}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a90dc1ce-cf3a-57f1-9a32-63fe824c4a01" :question/math-academy-id "q-316783" :question/problem "If $B=\\begin{bmatrix}5x & -1 \\\\ 6x-8 & 2\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(5x)\\cdot 2-(-1)\\cdot (6x-8) \\\\  & =10x+6x-8 \\\\  & =16x-8.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}16x-8 & =0 \\\\ 16x & =8 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c35d1a75-f277-5a94-961c-420517cab2dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-26" :db/id #edb/ref 17592186298410}] :answer-field/correct {:db/id #edb/ref 17592186298410} :answer-field/id #uuid "7ee21428-abe9-5f94-b753-8373c581c767" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299065}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1bc74342-0f37-5e04-9085-a552735d6bba" :question/math-academy-id "q-316784" :question/problem "If $B=\\begin{bmatrix}-3 & -x+1 \\\\ 5 & 2x+7\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(-3)\\cdot (2x+7)-5\\cdot (-x+1) \\\\  & =-6x-21+5x-5 \\\\  & =-x-26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-x-26 & =0 \\\\ -x & =26 \\\\ x & =-26\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cca41b-96b6-5473-9aca-86b0db2b84ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{13}{9}" :db/id #edb/ref 17592186297576}] :answer-field/correct {:db/id #edb/ref 17592186297576} :answer-field/id #uuid "32d3dd1b-e2db-5caf-ae0b-809e4a9c8547" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298811}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d52bc53-4740-5cbf-85a5-c4eda2c297f6" :question/math-academy-id "q-316785" :question/problem "If $B=\\begin{bmatrix}4 & -2 \\\\ 7x-3 & x+8\\end{bmatrix}$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =4\\cdot (x+8)-(-2)\\cdot (7x-3) \\\\  & =4x+32+14x-6 \\\\  & =18x+26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}18x+26 & =0 \\\\ 18x & =-26 \\\\ x & =-\\frac{13}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629ba2fb-f7a0-55ec-8318-3a578b3a696d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186297974}] :answer-field/correct {:db/id #edb/ref 17592186297974} :answer-field/id #uuid "0facb49d-44d7-596b-8283-cf6ecd88d19e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298692} {:answer-field/choices [{:answer/id #uuid "b84a7230-bf17-5af7-b714-634c6fe7a61b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186298353}] :answer-field/correct {:db/id #edb/ref 17592186298353} :answer-field/id #uuid "2558d65a-fb7e-502b-9124-c77726154021" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298762}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "113042b9-3913-565d-9ff6-26aa252c490f" :question/math-academy-id "q-316825" :question/problem "Let $B=\\begin{bmatrix}2x+4 & 0 \\\\ 15 & -x-3\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x+4)\\cdot (-x-3)-0\\cdot 15 \\\\  & =-2{x}^{2}-6x-4x-12 \\\\  & =-2{x}^{2}-10x-12.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-2{x}^{2}-10x-12 & =0 \\\\ -2({x}^{2}+5x+6) & =0 \\\\ (x+3)(x+2) & =0 \\\\ x & =-3,-2\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-3\\,\\text{and}\\,x=-2.\n$$"} {:db/id #edb/ref 17592186299507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5366c8ee-0f20-52a8-af0d-6262c3e3a64d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186297903}] :answer-field/correct {:db/id #edb/ref 17592186297903} :answer-field/id #uuid "0d33276a-59ca-5611-8a71-d122c8fe1aa8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298680} {:answer-field/choices [{:answer/id #uuid "08d68a03-e244-5376-9981-66b7a4ebd931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186297599}] :answer-field/correct {:db/id #edb/ref 17592186297599} :answer-field/id #uuid "1ef19e34-416f-58ea-9adf-3a70138385ab" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a81a924-c8d9-5da7-9d7c-338e9d3bb52d" :question/math-academy-id "q-316828" :question/problem "Let $B=\\begin{bmatrix}2x+1 & x-40 \\\\ 1 & -x\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x+1)\\cdot (-x)-(x-40)\\cdot 1 \\\\  & =-2{x}^{2}-x-x+40 \\\\  & =-2{x}^{2}-2x+40.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-2{x}^{2}-2x+40 & =0 \\\\ -2({x}^{2}+x-20) & =0 \\\\ -2(x-4)(x+5) & =0 \\\\ x & =4,-5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-5\\,\\text{and}\\,x=4.\n$$"} {:db/id #edb/ref 17592186299508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd68271a-9473-595e-b5cc-3fdbfc5ed8a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186298378}] :answer-field/correct {:db/id #edb/ref 17592186298378} :answer-field/id #uuid "91c07df3-718b-531d-bfd7-b454f78a656b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299118} {:answer-field/choices [{:answer/id #uuid "0ab82d06-28db-5541-b1f2-29ddc998b877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186297608}] :answer-field/correct {:db/id #edb/ref 17592186297608} :answer-field/id #uuid "e11d6092-7929-53ab-a1f3-28dc7122ce6a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299403}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6886658-7f8f-54c1-b88e-4ea7a22c6205" :question/math-academy-id "q-316829" :question/problem "Let $B=\\begin{bmatrix}3 & -x+7 \\\\ x-5 & 0\\end{bmatrix}$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =3\\cdot 0-(-x+7)\\cdot (x-5) \\\\  & ={x}^{2}-5x-7x+35 \\\\  & ={x}^{2}-12x+35.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-12x+35 & =0 \\\\ (x-7)(x-5) & =0 \\\\ x & =7,5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=5\\,\\text{and}\\,x=7.\n$$"} {:db/id #edb/ref 17592186299591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ce25fc2-f172-5796-bdb4-80f062501242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "47" :db/id #edb/ref 17592186298240}] :answer-field/correct {:db/id #edb/ref 17592186298240} :answer-field/id #uuid "42ec026c-9601-596a-aac7-34e1c7298d90" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298866}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52b70b4e-c944-5a6c-9fb5-10e8bb1b8364" :question/math-academy-id "q-317335" :question/problem "Calculate $det(R)$ given that\n$$\n\\displaystyle R=\\begin{bmatrix}8 & -5 \\\\ 3 & 4\\end{bmatrix}.\n$$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =\\begin{vmatrix}8 & -5 \\\\ 3 & 4\\end{vmatrix} \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56075e41-2276-59fc-aa32-dc0aefbc46ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186297914}] :answer-field/correct {:db/id #edb/ref 17592186297914} :answer-field/id #uuid "9dd2ce63-3870-5dc7-88b5-af30fb44581f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299157}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "51e6ce71-0f6b-5ca6-9047-0832d38b3af3" :question/math-academy-id "q-317336" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}2 & 4 \\\\ 1 & 3\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}2 & 4 \\\\ 1 & 3\\end{vmatrix} \\\\  & =(2)(3)-(4)(1) \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299593 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6324678-0597-5421-a104-04c3342494f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52" :db/id #edb/ref 17592186298419}] :answer-field/correct {:db/id #edb/ref 17592186298419} :answer-field/id #uuid "cfc4e21a-193b-52dd-8dc9-d21c2d8f7ddb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299337}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd3c7419-67b1-5120-a5e4-6bd19d8d0a71" :question/math-academy-id "q-317342" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}6 & -2 \\\\ 5 & 7\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}6 & -2 \\\\ 5 & 7\\end{vmatrix} \\\\  & =(6)(7)-(-2)(5) \\\\  & =42+10 \\\\  & =52.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616}] :answer-field/correct {:db/id #edb/ref 17592186297616} :answer-field/id #uuid "0ac069ea-97f0-5b28-aae8-5ec01ea01538" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298670}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6ca014c-b5cb-5825-95b8-87e00a3142c6" :question/math-academy-id "q-317367" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{vmatrix} \\\\  & =\\frac{2}{5}\\cdot 2-(-3)\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =\\frac{4}{5}-\\frac{3}{2} \\\\  & =-\\frac{7}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774}] :answer-field/correct {:db/id #edb/ref 17592186297774} :answer-field/id #uuid "eab4d4b7-2252-5c08-b2b6-6e240fa0a5f2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299429}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a27ba74d-67e7-552a-808b-c86c1ab2858a" :question/math-academy-id "q-317368" :question/problem "Calculate $det(E)$ given that\n$$\n\\displaystyle E=\\begin{bmatrix}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{bmatrix}.\n$$\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =\\begin{vmatrix}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-\\frac{3}{4}\\cdot (-1)-5\\cdot 2 \\\\  & =\\frac{3}{4}-10 \\\\  & =-\\frac{37}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811}] :answer-field/correct {:db/id #edb/ref 17592186297811} :answer-field/id #uuid "d3a33b9b-67e3-53e5-bc18-a48957e9fa7a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299357}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5cb8c1aa-faf5-5b19-b22a-04f7e16807fe" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}3x & 2y \\\\ -5 & x\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}3x & 2y \\\\ -5 & x\\end{vmatrix} \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186298479}] :answer-field/correct {:db/id #edb/ref 17592186298479} :answer-field/id #uuid "154b6de9-0d77-5e77-8de1-45bf6ab48913" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1e3ffcd6-7f26-5f4f-8230-33ae44d7f744" :question/math-academy-id "q-317377" :question/problem "If\n$$\n\\displaystyle D=\\begin{bmatrix}2 & m \\\\ 3 & 5\\end{bmatrix}\n$$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}2 & m \\\\ 3 & 5\\end{vmatrix} \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186298524}] :answer-field/correct {:db/id #edb/ref 17592186298524} :answer-field/id #uuid "ebf4f818-ea4f-5a3d-9526-388b53c60cf1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0f61095-530a-54e2-bb79-353fa0efed39" :question/math-academy-id "q-317382" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}1+r & 2-r \\\\ -5 & 4\\end{bmatrix}\n$$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =\\begin{vmatrix}1+r & 2-r \\\\ -5 & 4\\end{vmatrix} \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186298164}] :answer-field/correct {:db/id #edb/ref 17592186298164} :answer-field/id #uuid "0eda0fee-f95d-5630-8031-5abef3969057" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298688}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e22859c-f056-5995-96a3-08af912796b8" :question/math-academy-id "q-317385" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}3+s & 2s \\\\ -4 & 3-s\\end{bmatrix}\n$$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}3+s & 2s \\\\ -4 & 3-s\\end{vmatrix} \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74545791-26c1-5947-9c5b-b677dc493399" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186298054}] :answer-field/correct {:db/id #edb/ref 17592186298054} :answer-field/id #uuid "ee6c562c-1cf7-5f43-b2d5-435bef859ba2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299441}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "503c449a-b9d1-5796-9d9e-bf3065bb8dec" :question/math-academy-id "q-318971" :question/problem "Suppose $|\\hspace{0.167em}\\mathbf{r}\\hspace{0.167em}|=10$ and the angle between vectors $\\mathbf{r}$ and $\\mathbf{s}$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $\\mathbf{r}$ onto $\\mathbf{s}.$\n\n${\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r}=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r} & =|\\hspace{0.167em}\\mathbf{r}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =10cos\\hspace{-0.167em}\\left(\\frac{2\\pi }{3}\\right) \\\\  & =10\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5684a7-6510-556f-b323-b27961d61e18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186297675}] :answer-field/correct {:db/id #edb/ref 17592186297675} :answer-field/id #uuid "4ac50c16-4972-5306-a766-6c8022e7162a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298886}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0d7d073-069e-5803-942e-5e5c5ad68481" :question/math-academy-id "q-318972" :question/problem "Suppose $|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|=8$ and the angle between vectors $\\mathbf{p}$ and $\\mathbf{q}$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}.$\n\n${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =8cos\\hspace{-0.167em}\\left(\\frac{\\pi }{6}\\right) \\\\  & =8\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =4\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e39c7bca-ae4b-503b-9c4a-c72c47f4989e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186298530}] :answer-field/correct {:db/id #edb/ref 17592186298530} :answer-field/id #uuid "c1d8a04d-078a-5212-83f2-c8e21cfb6