f-21ed-5b2e-9434-25aa8ce390e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.008" :db/id #edb/ref 17592186307374} {:answer/id #uuid "ffdfa769-0806-5af0-9025-c5eddc26e501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.207" :db/id #edb/ref 17592186307513}] :answer-field/correct {:db/id #edb/ref 17592186307374} :answer-field/id #uuid "77a7d37e-11f1-5127-9778-9c0d0f0faf2f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186307898} {:answer-field/choices [{:answer/id #uuid "7756d51b-5a8b-5b8e-ae39-41cd08ff78c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "151.234" :db/id #edb/ref 17592186306284} {:answer/id #uuid "78522bcc-7dee-5093-aa33-c787a0607b20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22.656" :db/id #edb/ref 17592186306293} {:answer/id #uuid "7e7cfe8f-62e2-54e0-9a7e-b040229c85fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60.938" :db/id #edb/ref 17592186306360} {:answer/id #uuid "7e8e8db2-1ec6-5967-8682-82fdfee56c5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "134.431" :db/id #edb/ref 17592186306364} {:answer/id #uuid "cd158b73-bf88-508c-874a-794bdb120369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95.612" :db/id #edb/ref 17592186307053}] :answer-field/correct {:db/id #edb/ref 17592186306364} :answer-field/id #uuid "947fc853-dfdf-5127-a902-cc01f26d4e03" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186307991}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2d2f0e2d-e315-598e-85b7-5c7b01c99d78" :question/math-academy-id "q-334569" :question/problem "The global truncation error (GTE) of a numerical method with step size $Δx$ is\n\n$$\ne(Δx)=5(Δx)^{4}-(Δx)^{5}.\n$$\n\nComplete the following sentences.$\\,$ With step size $Δx=0.7,$ the global truncation error is $≈$\n{{field-1}}.\n\n$\\,$ With step size $Δx=0.2,$ the global truncation error is $≈$\n{{field-2}}.\n\n$\\,$ Decreasing from $Δx=0.7$ to $Δx=0.2,$ the GTE is reduced by a factor of $≈$\n{{field-3}}.\n\n$\\,$ According to this data, the order of the method is approximately\n{{field-4}}." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nFirst, we compute the GTE for the given step sizes:\n\n- With step size $Δx=0.7,$ the GTE is\n\n$$\n\\begin{aligned}e(0.7) & =5(0.7)^{4}-(0.7)^{5} \\\\  & =5\\cdot 0.2401-1\\cdot 0.168\\,07 \\\\  & =1.200\\,5-0.168\\,07 \\\\  & =1.032\\,43 \\\\  & ≈1.032.\\end{aligned}\n$$\n\n- With step size $Δx=0.2,$ the GTE is\n\n$$\n\\begin{aligned}e(0.2) & =5(0.2)^{4}-(0.2)^{5} \\\\  & =5\\cdot 0.001\\,6-1\\cdot 0.000\\,32 \\\\  & =0.008-0.000\\,32 \\\\  & =0.007\\,68 \\\\  & ≈0.008.\\end{aligned}\n$$\n\nNext, we determine the order by comparing the errors. The step size decreases from $0.7$ to $0.2.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.7}{0.2}=3.5.\n$$\n\nAs a result, for a numerical method of order $p,$ the GTE should decrease by a factor of approximately\n\n$$\n{k}^{p}=(3.5)^{p}.\n$$\n\nOn the other hand, the GTE actually decreases from $1.032\\,43$ to $0.007\\,68.$ So, it reduces by a factor of\n\n$$\n\\frac{1.032\\,43}{0.007\\,68}=134.430\\,99…≈134.431.\n$$\n\nComparing the two scale factors for the GTE, we get\n\n$$\n\\begin{aligned}(3.5)^{p} & ≈134.430\\,99… \\\\ p & ≈{log}_{3.5}⁡(134.430\\,99…) \\\\ p & ≈3.912….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is\n$4.$\n\nIndeed, this coincides with the definition of the order from the expression for the GTE:\n\n$$\ne(Δx)=5(Δx)^{4}-(Δx)^{5}\\,⇒\\,e(Δx)=O\\,((Δx)^{4})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nHence, the order of the method is $4.$"} {:db/id #edb/ref 17592186308663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516b9685-0ec7-5784-b050-aded8c8a1cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186305943} {:answer/id #uuid "51732cc2-4655-5a0a-a764-680869a446ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186305944} {:answer/id #uuid "6801fd43-32da-53c7-958f-9fd853108be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186306143} {:answer/id #uuid "818a54c4-98fa-5ddd-8121-3a619a4286a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186306389} {:answer/id #uuid "c22ebcd6-6d54-5211-b00c-21fc407fd31d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186306962}] :answer-field/correct {:db/id #edb/ref 17592186306962} :answer-field/id #uuid "82c894fd-10b5-50a4-85f2-09325e510c52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186307932}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9e60f41-0074-5df6-9afc-69a24a0bbeb5" :question/math-academy-id "q-334644" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.25,$ the observed local truncation error is $τ(0.25)=0.50.$\n\n- With step size $Δx=0.10,$ the observed local truncation error is $τ(0.10)=0.01.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.25$ to $0.10.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.25}{0.10}=2.5.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}=(2.5)^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.50$ to $0.01.$ So, it reduces by a factor of\n\n$$\n\\frac{0.50}{0.01}=50.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}(2.5)^{p+1} & ≈50 \\\\ p+1 & ≈{log}_{2.5}⁡(50) \\\\ p+1 & ≈4.269… \\\\ p & ≈3.269….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $3.$"} {:db/id #edb/ref 17592186308664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23973e17-4d84-522b-8415-f15d8d6cd355" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186305490} {:answer/id #uuid "77acd52d-6e2b-5ae0-8067-e20d4ca97301" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186306288} {:answer/id #uuid "7e2323cf-e7c5-59dc-ab1f-517b7cc509f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186306356} {:answer/id #uuid "85bae4c8-8a16-5414-8609-ee2e3824871a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186306428} {:answer/id #uuid "91d3d298-b109-57e9-a129-668ed74e99ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186306531}] :answer-field/correct {:db/id #edb/ref 17592186306356} :answer-field/id #uuid "8df9b1f6-ae90-53f3-b7f1-0e157eeb1df7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186307969}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fcb96b5a-0e95-52c4-ac1f-597bc14204c1" :question/math-academy-id "q-334645" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.16,$ the observed local truncation error is $τ(0.16)=0.40.$\n\n- With step size $Δx=0.04,$ the observed local truncation error is $τ(0.04)=0.005.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.16$ to $0.04.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.16}{0.04}=4.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={4}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.40$ to $0.005.$ So, it reduces by a factor of\n\n$$\n\\frac{0.40}{0.005}=80.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{4}^{p+1} & ≈80 \\\\ p+1 & ≈{log}_{4}⁡(80) \\\\ p+1 & ≈3.161… \\\\ p & ≈2.161….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $2.$"} {:db/id #edb/ref 17592186308665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05cb8cbf-2525-5aa2-adfe-cd481e3a035f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186305203} {:answer/id #uuid "21bfa1f7-f19d-56ce-b7f8-e855ea310574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186305475} {:answer/id #uuid "2eabd2c9-c08e-5c90-8a9a-e97ba53e2e24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186305595} {:answer/id #uuid "7458f81a-c783-575e-87db-c6a1d925d0af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186306256} {:answer/id #uuid "8c4785ce-99ec-52cb-ac88-d882b4bd6fc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186306484}] :answer-field/correct {:db/id #edb/ref 17592186305475} :answer-field/id #uuid "b8a56bc7-802d-5130-a340-47dd3d54165b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186308107}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8e9fee6-366d-51d7-82a2-1629aefe0b96" :question/math-academy-id "q-334647" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.15,$ the observed local truncation error is $τ(0.15)=0.54.$\n\n- With step size $Δx=0.05,$ the observed local truncation error is $τ(0.05)=0.003.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.15$ to $0.05.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.15}{0.05}=3.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={3}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.54$ to $0.003.$ So, it reduces by a factor of\n\n$$\n\\frac{0.54}{0.003}=180.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{3}^{p+1} & ≈180 \\\\ p+1 & ≈{log}_{3}⁡(180) \\\\ p+1 & ≈4.726… \\\\ p & ≈3.726….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $4.$"} {:db/id #edb/ref 17592186308666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c0e0c0-17b6-5c20-bf7f-ca89227d47fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186305160} {:answer/id #uuid "21a70832-25e3-5ba0-862a-d3800a6737a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186305474} {:answer/id #uuid "58b2797c-2939-5a4a-bc50-65965ef06246" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186306004} {:answer/id #uuid "9eee1d64-ab5d-5eb5-bb76-81c85df3758a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186306645} {:answer/id #uuid "f5d9524f-0201-5b2f-a85d-56b833974db5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186307430}] :answer-field/correct {:db/id #edb/ref 17592186305474} :answer-field/id #uuid "efb5bf84-d4f3-5868-92b1-c0b777b05c39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186308281}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b20caa4-47fd-550a-81fb-67a189c54897" :question/math-academy-id "q-334648" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.35,$ the observed local truncation error is $τ(0.35)=0.75.$\n\n- With step size $Δx=0.10,$ the observed local truncation error is $τ(0.10)=0.005.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.35$ to $0.10.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.35}{0.10}=3.5.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}=(3.5)^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.75$ to $0.005.$ So, it reduces by a factor of\n\n$$\n\\frac{0.75}{0.005}=150.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}(3.5)^{p+1} & ≈150 \\\\ p+1 & ≈{log}_{3.5}⁡(150) \\\\ p+1 & ≈3.999… \\\\ p & ≈2.999….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $3.$"} {:db/id #edb/ref 17592186308667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d2fcee1-789f-5a65-b0c3-dbb43767d387" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186305422} {:answer/id #uuid "3223be5f-1c23-51da-ac5b-227bc9ab4e05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186305619} {:answer/id #uuid "7c9568f3-303b-5e68-b773-a6eb6264efec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186306339} {:answer/id #uuid "929c322b-6dd4-562d-bdcd-e14b9e67aee2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186306541} {:answer/id #uuid "b44f66d3-8c24-5e49-a0a1-36983570214c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186306841}] :answer-field/correct {:db/id #edb/ref 17592186306339} :answer-field/id #uuid "dd4d4697-8b4c-5997-bfc4-9a5ec2b0f3a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186308216}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f92b889e-ac1a-5f7b-b100-034485795a76" :question/math-academy-id "q-334650" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.20,$ the observed local truncation error is $τ(0.20)=0.78.$\n\n- With step size $Δx=0.08,$ the observed local truncation error is $τ(0.08)=0.008.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.20$ to $0.08.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.20}{0.08}=2.5.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}=(2.5)^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.78$ to $0.008.$ So, it reduces by a factor of\n\n$$\n\\frac{0.78}{0.008}=97.5.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}(2.5)^{p+1} & ≈97.5 \\\\ p+1 & ≈{log}_{2.5}⁡(97.5) \\\\ p+1 & ≈4.99… \\\\ p & ≈3.99….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $4.$"} {:answer/id #uuid "487cf069-3ce8-55d6-8f31-00a5f9dc3430" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "computing $det({Φ}_{0}(0))$" :db/id #edb/ref 17592186309301} {:answer/id #uuid "da008b03-0e26-5237-9b25-2d7b8d78755e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cos}^{2}⁡x" :db/id #edb/ref 17592186310501} {:db/id #edb/ref 17592186311638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ea01709-12b4-58a6-ab2e-4962013826ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{e}^{-3/2}" :db/id #edb/ref 17592186309345}] :answer-field/correct {:db/id #edb/ref 17592186309345} :answer-field/id #uuid "31904c2b-2a8f-532b-964d-ea9d4fd7f84e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310924} {:answer-field/choices [{:answer/id #uuid "40a594be-b7bf-590a-ba97-77efa196cdf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-3/2}" :db/id #edb/ref 17592186309240}] :answer-field/correct {:db/id #edb/ref 17592186309240} :answer-field/id #uuid "31dce419-ace0-5455-9896-3d1050329377" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310925}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "21ef4a3a-3143-5d28-9b7b-5c36663b99e0" :question/math-academy-id "q-335917" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)={t}^{2}ln\\,({t}^{2}),\\,t>0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment.\n\nThe acceleration is zero at $t=$\n{{field-1}}, and the velocity at this moment is\n$v=$\n{{field-2}}." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\ns(t)={t}^{2}ln\\,({t}^{2})=2{t}^{2}\\operatorname{ln}⁡(t)\n$$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(2{t}^{2}\\operatorname{ln}⁡(t)) \\\\  & =2(2t)\\operatorname{ln}⁡(t)+2{t}^{2}\\cdot \\frac{1}{t} \\\\  & =4t\\operatorname{ln}⁡(t)+2t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4t\\operatorname{ln}⁡(t)+2t) \\\\  & =4\\operatorname{ln}⁡(t)+4t\\cdot \\frac{1}{t}+2 \\\\  & =4\\operatorname{ln}⁡(t)+6\\end{aligned}\n$$\n\nNext, we put $a(t)=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}4\\operatorname{ln}⁡(t)+6 & =0 \\\\ 4\\operatorname{ln}⁡(t) & =-6 \\\\ \\operatorname{ln}⁡(t) & =-\\frac{3}{2} \\\\ t & ={e}^{-3/2}\\end{aligned}\n$$\n\nSo the acceleration is zero when $t={e}^{-3/2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v\\,({e}^{-3/2}) & ={e}^{-3/2}(4ln\\,({e}^{-3/2})+2) \\\\  & ={e}^{-3/2}(4\\cdot \\left(-\\frac{3}{2}\\right)+2) \\\\  & ={e}^{-3/2}(-6+2) \\\\  & =-4{e}^{-3/2}\\end{aligned}\n$$\n\nTherefore, the acceleration is zero at $t={e}^{-3/2},$ and the velocity at this moment is $v=-4{e}^{-3/2}.$"} {:db/id #edb/ref 17592186311639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e0c2b4c-3635-5650-a4d5-2b4fcb2458c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{ln}(2)" :db/id #edb/ref 17592186309879}] :answer-field/correct {:db/id #edb/ref 17592186309879} :answer-field/id #uuid "8f602e95-584a-5023-86c3-436dd72e8776" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311197} {:answer-field/choices [{:answer/id #uuid "f1c50573-2cfe-55fe-9e22-9104f673ef53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186310674}] :answer-field/correct {:db/id #edb/ref 17592186310674} :answer-field/id #uuid "db687731-0abe-581c-9757-eabd90c503db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311435}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fb520858-1659-5942-b7f5-935661020acc" :question/math-academy-id "q-335924" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=t\\operatorname{ln}⁡(t)-{t}^{2},\\,t>0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment.\n\nThe acceleration is zero at $t=$\n{{field-1}}, and the velocity at this moment is\n$v=$\n{{field-2}}." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{ln}⁡(t)-{t}^{2}) \\\\  & =1\\cdot \\operatorname{ln}⁡(t)+t\\cdot \\frac{1}{t}-2t \\\\  & =\\operatorname{ln}⁡(t)+1-2t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t)+1-2t) \\\\  & =\\frac{1}{t}-2\\end{aligned}\n$$\n\nNext, we put $a(t)=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}\\frac{1}{t}-2 & =0 \\\\ \\frac{1}{t} & =2 \\\\ t & =\\frac{1}{2}\\end{aligned}\n$$\n\nSo the acceleration is zero when $t=\\frac{1}{2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v\\,\\left(\\frac{1}{2}\\right) & =ln\\,\\left(\\frac{1}{2}\\right)+1-2\\cdot \\frac{1}{2} \\\\  & =ln\\,\\left(\\frac{1}{2}\\right)+1-1 \\\\  & =ln\\,\\left(\\frac{1}{2}\\right) \\\\  & =-\\operatorname{ln}⁡(2)\\end{aligned}\n$$\n\nTherefore, the acceleration is zero at $t=\\frac{1}{2},$ and the velocity at this moment is $v=-\\operatorname{ln}⁡(2).$"} {:db/id #edb/ref 17592186311648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1666e2ac-b3fe-5abf-bf6c-480c904e35c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "properties of invertible matrices" :db/id #edb/ref 17592186308916} {:answer/id #uuid "2a0e242e-f8bc-5b61-92f4-057c108c04c9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "definition of matrix multiplication" :db/id #edb/ref 17592186309064} {:answer/id #uuid "39e9ae43-ec84-53c1-9ff5-1cab8a1513fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "substituting ${Φ}^{′}=A\\,Φ$" :db/id #edb/ref 17592186309193} {:answer/id #uuid "88c4bae8-f281-5b85-b676-befbbaf6a7b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "definition of a fundamental matrix" :db/id #edb/ref 17592186309823}] :answer-field/correct {:db/id #edb/ref 17592186308916} :answer-field/id #uuid "2dd0c097-ae2f-556e-9141-4922553f97a2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186310913} {:answer-field/choices [{:answer/id #uuid "1d589487-f539-5a2a-9c68-978fcbd8d916" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Φ(t)" :db/id #edb/ref 17592186308974} {:answer/id #uuid "4f7f3a02-4a57-5a6f-82ac-295a09b04201" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A" :db/id #edb/ref 17592186309351} {:answer/id #uuid "801400d7-5f92-5160-aa74-65afe20e1479" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{A}^{-1}" :db/id #edb/ref 17592186309754} {:answer/id #uuid "f6c6ca05-bdfb-57f3-acf6-42e584e9e189" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Φ}^{-1}" :db/id #edb/ref 17592186310710}] :answer-field/correct {:db/id #edb/ref 17592186308974} :answer-field/id #uuid "60ac3f93-6295-5f30-bd13-d2e6c1a521c6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186311049} {:answer-field/choices [{:answer/id #uuid "5b75abdf-0c2f-5971-941e-b26da9a01df8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "properties of invertible matrices" :db/id #edb/ref 17592186309435} {:answer/id #uuid "85a84435-5c8a-5585-b8e5-e8bffe321073" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "substituting ${Φ}^{′}=A\\,Φ$" :db/id #edb/ref 17592186309787} {:answer/id #uuid "eac98a1a-0bc6-5585-badc-67bd9c21bfee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "definition of a fundamental matrix" :db/id #edb/ref 17592186310617} {:answer/id #uuid "fe87b04f-2863-5764-85be-e1341c2b05ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "definition of matrix multiplication" :db/id #edb/ref 17592186310783}] :answer-field/correct {:db/id #edb/ref 17592186310617} :answer-field/id #uuid "b40a4c73-e790-56ac-96c9-d5fa994ccaf7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186311314}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3d9725c1-fcc5-57a9-8b5a-bd5efbda8207" :question/math-academy-id "q-336093" :question/problem "Consider the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant $2\\times 2$ matrix. Let $Φ(t)$ be a fundamental matrix for this system. A derivation showing that $Φ(t)$ is invertible for all $t$ is given below.\n\n$\\text{L1}:\\,$ Let ${x}_{1}(t)$ and ${x}_{2}(t)$ be the columns of $Φ(t)$\n\n$\\text{L2}:\\,$ ${x}_{1}(t)$ and ${x}_{2}(t)$ are linearly independent for all $t$\n\n$\\text{L3}:\\,$ $det(Φ(t))\\ne 0$ for all $t$\n\n$\\text{L4}:\\,$ $Φ(t)$ is invertible for all $t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ states the independence of the columns of {{field-1}}.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by the {{field-2}}.\n\n$\\,$ Line $\\text{L4}$ follows from line $\\text{L3}$ by the {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first interpret line $\\text{L2}.$ Line $\\text{L2}$ states that the two columns of $Φ(t)$ are linearly independent, which is required of a fundamental matrix. Thus, $\\text{L2}$ states independence of the columns of $Φ(t).$\n\n- Next, we consider lines $\\text{L1}$ and $\\text{L2}.$ Since $Φ(t)$ is a fundamental matrix, its columns ${x}_{1}(t)$ and ${x}_{2}(t)$ form a basis of the solution space for our system. Thus, $\\text{L2}$ follows from $\\text{L1}$ by the $\\text{definition of a fundamental matrix}.$\n\n- Finally, we consider lines $\\text{L3}$ and $\\text{L4}.$ Recall that a square matrix is invertible when its determinant is nonzero. Since in $\\text{L3}$ we have that $det(Φ(t))\\ne 0$ for all $t,$ it follows that $Φ(t)$ is invertible for all $t.$ Thus, $\\text{L4}$ follows from $\\text{L3}$ by the $\\text{properties of invertible matrices}.$"} {:db/id #edb/ref 17592186311653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "606ae851-a7d5-58a3-8e79-a9296cf345d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{cot}t+t\\operatorname{ln}t{csc}^{2}t}{t{cot}^{2}t}" :db/id #edb/ref 17592186309478}] :answer-field/correct {:db/id #edb/ref 17592186309478} :answer-field/id #uuid "d339cd93-b3fc-51f1-96cc-794e009be99e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311407}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "123379b4-b283-5d57-933b-9e195e37586e" :question/math-academy-id "q-336130" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{\\operatorname{ln}⁡t}{\\operatorname{cot}⁡t}.$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{\\operatorname{ln}⁡t}{\\operatorname{cot}⁡t}\\right) \\\\  & =\\frac{(\\operatorname{cot}⁡t\\cdot \\frac{1}{t}-\\operatorname{ln}⁡t(-{csc}^{2}⁡t))}{{cot}^{2}⁡t} \\\\  & =\\frac{\\left(\\frac{\\operatorname{cot}⁡t+t\\operatorname{ln}⁡t{csc}^{2}⁡t}{t}\\right)}{{cot}^{2}⁡t} \\\\  & =\\frac{\\operatorname{cot}⁡t+t\\operatorname{ln}⁡t{csc}^{2}⁡t}{t{cot}^{2}⁡t}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b33e03-7d09-53a3-8c70-3dba6fc6951f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2" :db/id #edb/ref 17592186308773}] :answer-field/correct {:db/id #edb/ref 17592186308773} :answer-field/id #uuid "55396af7-b226-573a-8520-ad5375ad2e65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311013}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "752c8e69-6c0d-53b3-ae19-5a162922b12b" :question/math-academy-id "q-336146" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=3{log}_{2}⁡t-2t,\\,t>0.\n$$\n\nCalculate the velocity at time $t=2.$ Round your answer to one decimal place.\n\n$v(2)≈$\n{{field-1}}" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{log}_{2}⁡t-2t) \\\\  & =\\frac{3}{t\\operatorname{ln}⁡2}-2\\end{aligned}\n$$\n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =\\frac{3}{2\\operatorname{ln}⁡2}-2 \\\\  & =0.16404… \\\\  & ≈0.2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "752af0da-dbae-5520-b62b-cf96e0283d3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{ln}\\left(\\frac{11}{3}\\right)" :db/id #edb/ref 17592186309661}] :answer-field/correct {:db/id #edb/ref 17592186309661} :answer-field/id #uuid "09205559-5a9a-53bf-8f0c-47fbdcd2d6a5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310819}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "999290d3-e880-5065-9964-ee6f1b8bd7a7" :question/math-academy-id "q-336717" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{1}^{3}\\frac{1}{4x-1}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =4x-1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4 \\\\ \\text{d}u & =4\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=4x-1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 1 & 3 \\\\ \\hline u & 3 & 11 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{3}\\frac{1}{(4x-1)}\\,\\text{d}x={\\int }_{3}^{11}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{11}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{3}^{11}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{3}^{11} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(11)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}ln\\,\\left(\\frac{11}{3}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2086e10e-bf6b-570b-9e79-ede9a646fe9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{\\sqrt{3}}{4},\\,-\\frac{1}{4},\\,\\frac{\\sqrt{3}}{2}⟩" :db/id #edb/ref 17592186308994} {:answer/id #uuid "5cb11ed9-985f-544c-8920-3388c7a6519f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{\\sqrt{3}}{4},\\,\\frac{1}{4},\\,\\frac{\\sqrt{3}}{2}⟩" :db/id #edb/ref 17592186309444} {:answer/id #uuid "9168ec64-3a53-5b16-9c62-1d367dbacf53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{\\sqrt{3}}{4},\\,\\frac{1}{4},\\,-\\frac{\\sqrt{3}}{2}⟩" :db/id #edb/ref 17592186309912} {:answer/id #uuid "aa550866-db3a-5d4c-8873-53cc1c2abea2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{\\sqrt{3}}{4},\\,-\\frac{1}{4},\\,-\\frac{\\sqrt{3}}{2}⟩" :db/id #edb/ref 17592186310125} {:answer/id #uuid "fc13a552-61c6-552f-9a18-b4b5b329247c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2},\\,-\\frac{\\sqrt{3}}{2}⟩" :db/id #edb/ref 17592186310761}] :answer-field/correct {:db/id #edb/ref 17592186310125} :answer-field/id #uuid "ac3a2c81-3ab1-5fd1-97e5-0673d9615ba5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186311291}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "730871e0-d608-50a9-8e24-089b6fc0a471" :question/math-academy-id "q-33676" :question/problem "Find the unit tangent vector to the curve   $r(t)=⟨\\operatorname{sin}⁡t\\,,\\,\\operatorname{cos}⁡t\\,,\\,2{cos}^{2}⁡t⟩$  at the point where $t=\\frac{\\pi }{6}.$" :question/worked-solution "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{6}:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\,2\\frac{\\text{d}}{\\text{d}t}({cos}^{2}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t,\\,-4\\cdot \\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t⟩ \\\\ {r}^{′}\\left(\\frac{\\pi }{6}\\right) & =⟨\\operatorname{cos}⁡\\frac{\\pi }{6},\\,-\\operatorname{sin}⁡\\frac{\\pi }{6},\\,-4\\cdot \\operatorname{cos}⁡\\frac{\\pi }{6}\\cdot \\operatorname{sin}⁡\\frac{\\pi }{6}⟩ \\\\  & =⟨\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2},\\,-4\\cdot \\frac{\\sqrt{3}}{2}\\cdot \\frac{1}{2}⟩ \\\\  & =⟨\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2},\\,-\\sqrt{3}⟩\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}\\left(\\frac{\\pi }{6}\\right):$ \n\n$$\n\\begin{aligned}‖{r}^{′}\\left(\\frac{\\pi }{6}\\right)‖ & =\\sqrt{{\\left(\\frac{\\sqrt{3}}{2}\\right)}^{2}+{\\left(-\\frac{1}{2}\\right)}^{2}+(-\\sqrt{3})^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}+3} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}\\left(\\frac{\\pi }{6}\\right)$ and obtain the unit tangent vector to the given curve at the point where $\\frac{\\pi }{6}:$\n\n$$\n\\begin{aligned}T\\left(\\frac{\\pi }{6}\\right) & =\\frac{{r}^{′}\\left(\\frac{\\pi }{6}\\right)}{‖{r}^{′}\\left(\\frac{\\pi }{6}\\right)‖} \\\\  & =\\frac{1}{2}\\text{ }⟨\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2},\\,-\\sqrt{3}⟩ \\\\  & =⟨\\frac{\\sqrt{3}}{4},\\,-\\frac{1}{4},\\,-\\frac{\\sqrt{3}}{2}⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5789afad-b84f-5f8d-b48e-643fcc282e4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186309405}] :answer-field/correct {:db/id #edb/ref 17592186309405} :answer-field/id #uuid "0a9cf4b1-bba2-5b45-abc8-21932ce7b3bf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310824}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1b11af32-1fc9-5539-bcdc-5bfdb12c2b8b" :question/math-academy-id "q-336782" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)}{\\operatorname{cot}⁡(2x)}=\n$$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are $\\lim_{x\\to {0}^{+}}\\operatorname{csc}⁡(x)=\\infty $ and $\\lim_{x\\to {0}^{+}}\\operatorname{cot}⁡(2x)=\\infty ,$ respectively, so we have the indeterminate form $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)}{\\operatorname{cot}⁡(2x)} & =\\lim_{x\\to {0}^{+}}\\frac{[\\operatorname{csc}⁡(x)]^{′}}{[\\operatorname{cot}⁡(2x)]^{′}} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{-\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{-2{csc}^{2}⁡(2x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{2{csc}^{2}⁡(2x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\left(\\frac{1}{\\operatorname{sin}⁡(x)}\\right)\\left(\\frac{\\operatorname{cos}⁡(x)}{\\operatorname{sin}⁡(x)}\\right)}{2\\left(\\frac{1}{{sin}^{2}⁡(2x)}\\right)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){sin}^{2}⁡(2x)}{2{sin}^{2}⁡(x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){(2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x))}^{2}}{2{sin}^{2}⁡(x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x)\\cdot 4{sin}^{2}⁡(x){cos}^{2}⁡(x)}{2{sin}^{2}⁡(x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{4{cos}^{3}⁡(x)\\cancel{{sin}^{2}⁡(x)}}{2\\cancel{{sin}^{2}⁡(x)}} \\\\  & =\\lim_{x\\to {0}^{+}}2{cos}^{3}⁡(x) \\\\  & =2{cos}^{3}⁡(0) \\\\  & =2\\cdot 1 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a1f7051-76a8-5e30-aadf-4a572c67a20e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186309569}] :answer-field/correct {:db/id #edb/ref 17592186309569} :answer-field/id #uuid "da832720-b643-5978-9ddd-fd0ef7ee4a2b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311433}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4980fc43-3957-5137-8a22-f74496d06d0b" :question/math-academy-id "q-336798" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{cos}⁡(x))}{\\operatorname{sec}⁡(x)}=\n$$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are  $\\lim_{x\\to (\\pi /2)^{-}}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)=-\\infty $ and  $\\lim_{x\\to (\\pi /2)^{-}}\\operatorname{sec}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}{\\operatorname{sec}⁡x} & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{cos}⁡x)]}^{′}}{{[\\operatorname{sec}⁡x]}^{′}} \\\\  & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{-\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x\\operatorname{tan}⁡x} \\\\  & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\cancel{-\\operatorname{tan}⁡x}}{\\operatorname{sec}⁡x\\cancel{\\operatorname{tan}⁡x}} \\\\  & =\\lim_{x\\to (\\pi /2)^{-}}\\left(-\\frac{1}{\\operatorname{sec}⁡x}\\right) \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}\\operatorname{cos}⁡x \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311756 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7abab752-1b7c-5b52-9b1c-6ac3d6705441" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186309707}] :answer-field/correct {:db/id #edb/ref 17592186309707} :answer-field/id #uuid "1d2a1527-abc0-5c97-aa16-af52abb1ecd5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310871}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "90c07f78-de76-5544-8060-f4dd40c8aa0c" :question/math-academy-id "q-336802" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{sec}⁡x)}{ln\\,(\\operatorname{cot}⁡x)}=\n$$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are $\\lim_{x\\to (\\pi /2)^{-}}ln\\,(\\operatorname{sec}⁡x)=\\infty $ and $\\lim_{x\\to (\\pi /2)^{-}}ln\\,(\\operatorname{cot}⁡x)=-\\infty ,$ respectively, so we have the case $\\frac{\\infty }{-\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{sec}⁡x)}{ln\\,(\\operatorname{cot}⁡x)} & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{{[ln\\,(\\operatorname{sec}⁡x)]}^{′}}{{[ln\\,(\\operatorname{cot}⁡x)]}^{′}} \\\\  & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\left(\\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\right)}{\\left(-\\frac{{csc}^{2}⁡x}{\\operatorname{cot}⁡x}\\right)} \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{cot}⁡x}{{csc}^{2}⁡x} \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\frac{1}{\\operatorname{tan}⁡x}}{\\frac{1}{{sin}^{2}⁡x}} \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}{sin}^{2}⁡x \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16490572-a595-5eca-89ee-f34d90a62a8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186308915}] :answer-field/correct {:db/id #edb/ref 17592186308915} :answer-field/id #uuid "a061c995-608d-52a7-82b0-3c42c5bd3c61" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311259}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "564f761a-7e2a-5b6b-bf32-97c437e743f7" :question/math-academy-id "q-336935" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\,\\lim_{x\\to 0}\\frac{ln\\,(1+\\operatorname{sin}⁡(2x))-\\operatorname{sin}⁡(2x)}{1-\\operatorname{cos}⁡(3x)}=\n$$\n{{field-1}}" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{ln\\,(1+\\operatorname{sin}⁡(2x))-\\operatorname{sin}⁡(2x)}{1-\\operatorname{cos}⁡(3x)} & =\\lim_{x\\to 0}\\frac{{[ln\\,(1+\\operatorname{sin}⁡(2x))-\\operatorname{sin}⁡(2x)]}^{′}}{[1-\\operatorname{cos}⁡(3x)]^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{\\frac{2\\operatorname{cos}⁡(2x)}{1+\\operatorname{sin}⁡(2x)}-2\\operatorname{cos}⁡(2x)}{3\\operatorname{sin}⁡(3x)} \\\\  & =-\\frac{2}{3}\\lim_{x\\to 0}\\frac{\\operatorname{cos}⁡(2x)-\\operatorname{cos}⁡(2x)(1+\\operatorname{sin}⁡(2x))}{(1+\\operatorname{sin}⁡(2x))\\operatorname{sin}⁡(3x)} \\\\  & =-\\frac{2}{3}\\lim_{x\\to 0}\\frac{\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡(2x)}{(1+\\operatorname{sin}⁡(2x))\\operatorname{sin}⁡(3x)} \\\\  & =-\\frac{2}{3}\\lim_{x\\to 0}\\frac{\\frac{1}{2}\\operatorname{sin}⁡(4x)}{(1+\\operatorname{sin}⁡(2x))\\operatorname{sin}⁡(3x)}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{ln\\,(1+\\operatorname{sin}⁡(2x))-\\operatorname{sin}⁡(2x)}{1-\\operatorname{cos}⁡(3x)} & =-\\frac{2}{3}\\lim_{x\\to 0}\\frac{\\frac{1}{2}\\operatorname{sin}⁡(4x)}{(1+\\operatorname{sin}⁡(2x))\\operatorname{sin}⁡(3x)} \\\\  & =-\\frac{2}{3}\\lim_{x\\to 0}\\frac{{[\\frac{1}{2}\\operatorname{sin}⁡(4x)]}^{′}}{{[(1+\\operatorname{sin}⁡(2x))\\operatorname{sin}⁡(3x)]}^{′}} \\\\  & =-\\frac{2}{3}\\lim_{x\\to 0}\\frac{2\\operatorname{cos}⁡(4x)}{2\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡(3x)+3(1+\\operatorname{sin}⁡(2x))\\operatorname{cos}⁡(3x)} \\\\  & =-\\frac{2}{3}\\cdot \\frac{2}{3} \\\\  & =-\\frac{4}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4ab3de-923f-5831-b79d-2fa27391f8ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186310654}] :answer-field/correct {:db/id #edb/ref 17592186310654} :answer-field/id #uuid "2073f922-a950-5b20-a4a6-6ee6db0d94ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310877}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9ee79b2-bfaf-5068-997a-8ac4b51a6abe" :question/math-academy-id "q-336943" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\,\\lim_{x\\to 0}\\frac{1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)}{1-\\operatorname{cos}⁡(3x)}=\n$$\n{{field-1}}" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)}{1-\\operatorname{cos}⁡(3x)} & =\\lim_{x\\to 0}\\frac{{[1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)]}^{′}}{{[1-\\operatorname{cos}⁡(3x)]}^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{4\\operatorname{sin}⁡(4x)+4\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)}{3\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{4}{3}\\lim_{x\\to 0}\\frac{\\operatorname{sin}⁡(4x)+\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)}{\\operatorname{sin}⁡(3x)}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)}{1-\\operatorname{cos}⁡(3x)} & =\\frac{4}{3}\\lim_{x\\to 0}\\frac{\\operatorname{sin}⁡(4x)+\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)}{\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{4}{3}\\lim_{x\\to 0}\\frac{{[\\operatorname{sin}⁡(4x)+\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)]}^{′}}{[\\operatorname{sin}⁡(3x)]^{′}} \\\\  & =\\frac{4}{3}\\lim_{x\\to 0}\\frac{4\\operatorname{cos}⁡(4x)+2{cos}^{2}⁡(2x)-2{sin}^{2}⁡(2x)}{3\\operatorname{cos}⁡(3x)} \\\\  & =\\frac{4}{3}\\cdot \\frac{4+2}{3} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fada8a6-7710-59de-b52e-f184d45cd037" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186309896}] :answer-field/correct {:db/id #edb/ref 17592186309896} :answer-field/id #uuid "396a4919-1957-541b-9cd1-791e4c556a1e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186310946}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e34adca9-52ea-5918-9113-f6b8e7bf7260" :question/math-academy-id "q-336971" :question/problem "Evaluate the following limit:\n\n$\\lim_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x}=$\n{{field-1}}" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & =\\lim_{x\\to \\infty }\\frac{[{x}^{3}]^{′}}{[{ln}^{2}⁡x]^{′}} \\\\  & =\\lim_{x\\to \\infty }\\frac{3{x}^{2}}{\\left(\\frac{2\\operatorname{ln}⁡x}{x}\\right)} \\\\  & =\\lim_{x\\to \\infty }\\frac{3{x}^{3}}{2\\operatorname{ln}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & =\\lim_{x\\to \\infty }\\frac{[3{x}^{3}]^{′}}{{[2\\operatorname{ln}⁡x]}^{′}} \\\\  & =\\lim_{x\\to \\infty }\\frac{9{x}^{2}}{\\left(\\frac{2}{x}\\right)} \\\\  & =\\lim_{x\\to \\infty }\\frac{9{x}^{3}}{2} \\\\  & =\\infty .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0262bc07-b36e-5703-9a15-7254839103e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡2x(-2\\operatorname{cos}⁡x+2)" :db/id #edb/ref 17592186308763} {:answer/id #uuid "2dae14f3-9eff-5713-b17f-43f1700d5954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡2x(-2\\operatorname{cos}⁡2x+2)" :db/id #edb/ref 17592186309091} {:answer/id #uuid "68017aab-5a89-5ef7-98b0-7eaff537a6fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡x(-2\\operatorname{cos}⁡x+2)" :db/id #edb/ref 17592186309549} {:answer/id #uuid "da008b03-0e26-5237-9b25-2d7b8d78755e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cos}^{2}⁡x" :db/id #edb/ref 17592186310501} {:answer/id #uuid "e9f95076-9770-52a6-85d4-de748196e98f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186310611}] :answer-field/correct {:db/id #edb/ref 17592186310611} :answer-field/id #uuid "4b426771-91ac-5b9a-b56f-63072115e657" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186310990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "354894e0-2841-574a-800b-fa009e2764c8" :question/math-academy-id "q-337983" :question/problem "If $D(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+4{y}^{2},$ then $D(\\operatorname{cos}⁡2x)=$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x,y)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x,y)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x,y)y\n$$\n\nwith ${f}_{2}=y,{f}_{1}=0,$ and ${f}_{0}=4y.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y=\\operatorname{cos}⁡2x:$\n\n$$\n\\begin{aligned}D(\\operatorname{cos}⁡2x) & =\\operatorname{cos}⁡2x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\operatorname{cos}⁡2x)+4{(\\operatorname{cos}⁡2x)}^{2} \\\\  & =\\operatorname{cos}⁡2x\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{sin}⁡2x)+4{cos}^{2}⁡2x \\\\  & =\\operatorname{cos}⁡2x(-4\\operatorname{cos}⁡2x)+4{cos}^{2}⁡2x \\\\  & =-4{cos}^{2}⁡2x+4{cos}^{2}⁡2x \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f178b3d-5611-58f8-8e79-7986a6589964" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{cos}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|-x\\operatorname{sin}⁡2x){e}^{x}" :db/id #edb/ref 17592186308986} {:answer/id #uuid "30ea5c22-71e4-5586-a6dc-edacc4a5ffb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{sin}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|-2x\\operatorname{cos}⁡2x){e}^{x}" :db/id #edb/ref 17592186309117} {:answer/id #uuid "363f7868-8e91-54a2-80d5-d41452799331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{sin}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|+x\\operatorname{cos}⁡2x){e}^{x}" :db/id #edb/ref 17592186309161} {:answer/id #uuid "c73b6a78-acdb-5bbb-b6b6-dfe883ba38a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{sin}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|-4x\\operatorname{cos}⁡2x){e}^{x}" :db/id #edb/ref 17592186310348} {:answer/id #uuid "d7a86c55-f60e-5da2-b49f-ede3805000f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{cos}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|+2x\\operatorname{sin}⁡2x){e}^{x}" :db/id #edb/ref 17592186310487}] :answer-field/correct {:db/id #edb/ref 17592186309117} :answer-field/id #uuid "3d97a950-549b-5ab2-9118-48b526d9e3eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186310960}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "291ae9e7-aff4-5123-ac08-1f6fcd3cc238" :question/math-academy-id "q-338142" :question/problem "Consider the following differential equation\n\n$$\n{y}^{″}-2{y}^{′}+5y=4{e}^{x}\\operatorname{csc}⁡2x.\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)=(A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡2x){e}^{x}+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method. You may also wish to make use of the following result (integration constant omitted):*\n\n$$\n\\int \\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\\,dx=\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|\n$$" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx,\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFirst, we note that the forcing term is $f(x)=4{e}^{x}\\operatorname{csc}⁡2x.$\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)=(A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡2x){e}^{x}.\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{x}\\operatorname{cos}⁡2x,\\,{y}_{2}(x)={e}^{x}\\operatorname{sin}⁡2x.\n$$\n\nWe can use the method of variation of parameters if these solutions are linearly independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix} \\\\  & ={y}_{1}(x){y}_{2}^{′}(x)-{y}_{1}^{′}(x){y}_{2}(x) \\\\  & =({e}^{x}\\operatorname{cos}⁡2x)({e}^{x}\\operatorname{sin}⁡2x)^{′}-({e}^{x}\\operatorname{cos}⁡2x)^{′}({e}^{x}\\operatorname{sin}⁡2x) \\\\  & =({e}^{x}\\operatorname{cos}⁡2x)({e}^{x}\\operatorname{sin}⁡2x+2{e}^{x}\\operatorname{cos}⁡2x)-({e}^{x}\\operatorname{cos}⁡2x-2{e}^{x}\\operatorname{sin}⁡2x)({e}^{x}\\operatorname{sin}⁡2x) \\\\  & ={e}^{2x}\\operatorname{cos}⁡2x\\operatorname{sin}⁡2x+2{e}^{2x}{cos}^{2}⁡2x-{e}^{2x}\\operatorname{cos}⁡2x\\operatorname{sin}⁡2x+2{e}^{2x}{sin}^{2}⁡2x \\\\  & =2{e}^{2x}({cos}^{2}⁡2x+{sin}^{2}⁡2x) \\\\  & =2{e}^{2x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent.\n\nLet’s compute ${u}_{1}(x)$ and ${u}_{2}(x)$:\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx \\\\  & =-\\int \\frac{4{e}^{x}\\operatorname{csc}⁡2x\\cdot {e}^{x}\\operatorname{sin}⁡2x}{2{e}^{2x}}\\,dx \\\\  & =-2\\int dx \\\\  & =-2x \\\\ {u}_{2}(x) & =\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx \\\\  & =\\int \\frac{4{e}^{x}\\operatorname{csc}⁡2x\\cdot {e}^{x}\\operatorname{cos}⁡2x}{2{e}^{2x}}\\,dx \\\\  & =2\\int \\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\\,dx \\\\  & =\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(-2x)({e}^{x}\\operatorname{cos}⁡2x)+(\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|)({e}^{x}\\operatorname{sin}⁡2x) \\\\  & =(\\operatorname{sin}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|-2x\\operatorname{cos}⁡2x){e}^{x}.\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =(A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡2x){e}^{x}+\\underbrace{(\\operatorname{sin}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|-2x\\operatorname{cos}⁡2x){e}^{x}}_{g(x)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=(\\operatorname{sin}⁡2x\\operatorname{ln}⁡|\\operatorname{sin}⁡2x|-2x\\operatorname{cos}⁡2x){e}^{x}.\n$$"} {:answer/id #uuid "2785d5fd-1764-5f97-a587-0f8481691389" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)=0" :db/id #edb/ref 17592186312277} {:answer/id #uuid "652efead-3751-5826-ad6d-52673095f934" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)=0" :db/id #edb/ref 17592186312772} {:answer/id #uuid "7e821c05-f7cc-5936-aebf-19dc944488de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186312993} {:answer/id #uuid "8a0cff89-e1c9-5b44-b926-6fdd25c5b754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186313073} {:answer/id #uuid "a5f7d3ce-1c5b-5eee-bbb8-8fd1c873b451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)=0" :db/id #edb/ref 17592186313279} {:answer/id #uuid "f5b8be24-3d20-5105-bbcd-8ea24d66f421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186313940} {:db/id #edb/ref 17592186314698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c648e38-7cc5-5dcf-9021-2394fd32b96a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}\\operatorname{cos}⁡4x\\operatorname{csc}⁡2x" :db/id #edb/ref 17592186312319} {:answer/id #uuid "2ce1fc5f-2da5-5b0b-80ba-f8df3b61c73d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}\\operatorname{sin}⁡4x\\operatorname{sec}⁡2x" :db/id #edb/ref 17592186312324} {:answer/id #uuid "33913f9d-f88f-57ed-97d8-78055dbc85b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡4x\\operatorname{sec}⁡2x" :db/id #edb/ref 17592186312390} {:answer/id #uuid "744ef512-134b-571f-9ecd-17d43e03b0af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{cos}⁡4x\\operatorname{csc}⁡2x" :db/id #edb/ref 17592186312900} {:answer/id #uuid "ceb5671d-5993-5a82-866f-3ac133f5ce78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{cos}⁡4x\\operatorname{csc}⁡2x" :db/id #edb/ref 17592186313591}] :answer-field/correct {:db/id #edb/ref 17592186312319} :answer-field/id #uuid "5dfa1250-d18e-541a-ad3a-13bb3e49e2fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314272}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "280f32a1-77b0-558e-a146-5c2de5be7ce0" :question/math-academy-id "q-338528" :question/problem "Consider the following differential equation\n\n$$\n{y}^{″}+4y={csc}^{3}⁡2x.\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)=P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x+g(x),\n$$\n\nwhere $P$ and $Q$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method. You may also wish to make use of the following result:*\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡4x=2{cos}^{2}⁡2x-1\\end{aligned}\n$$" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx,\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFirst, we note that the forcing term is $f(x)={csc}^{3}⁡2x.$\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)=P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x.\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡2x,\\,{y}_{2}(x)=\\operatorname{sin}⁡2x.\n$$\n\nWe can use the method of variation of parameters if these solutions are independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix} \\\\  & ={y}_{1}(x){y}_{2}^{′}(x)-{y}_{1}^{′}(x){y}_{2}(x) \\\\  & =(\\operatorname{cos}⁡2x)(\\operatorname{sin}⁡2x)^{′}-(\\operatorname{cos}⁡2x)^{′}(\\operatorname{sin}⁡2x) \\\\  & =(\\operatorname{cos}⁡2x)(2\\operatorname{cos}⁡2x)-(-2\\operatorname{sin}⁡2x)(\\operatorname{sin}⁡2x) \\\\  & =2{cos}^{2}⁡2x+2{sin}^{2}⁡2x \\\\  & =2\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nLet's compute ${u}_{1}(x)$ and ${u}_{2}(x)$:\n\n- First, we compute ${u}_{1}(x):$\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{{csc}^{3}⁡2x\\cdot \\operatorname{sin}⁡2x}{2}\\,dx \\\\  & =-\\frac{1}{2}\\int {csc}^{2}⁡2x\\,dx \\\\  & =\\frac{1}{4}\\operatorname{cot}⁡2x\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}(x):$\n\n$$\n\\begin{aligned}{u}_{2}(x) & =\\int \\frac{{csc}^{3}⁡2x\\cdot \\operatorname{cos}⁡2x}{2}\\,dx \\\\  & =\\frac{1}{2}\\int \\frac{\\operatorname{cos}⁡2x}{{sin}^{3}⁡2x}\\,dx\\end{aligned}\n$$\n\nLet $u=\\operatorname{sin}⁡2x.$ Then $du=2\\operatorname{cos}⁡2x\\,dx,$ so $\\operatorname{cos}⁡2x\\,dx=\\frac{1}{2}\\,du,$ and the integral becomes\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int \\frac{\\operatorname{cos}⁡2x}{{sin}^{3}⁡2x}\\,dx & =\\frac{1}{2}\\int \\frac{1}{{u}^{3}}(\\frac{1}{2}\\,du) \\\\  & =\\frac{1}{4}\\int {u}^{-3}\\,du \\\\  & =-\\frac{1}{8}{u}^{-2} \\\\  & =-\\frac{1}{8{sin}^{2}⁡2x}.\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(\\frac{1}{4}\\operatorname{cot}⁡2x)(\\operatorname{cos}⁡2x)+\\left(-\\frac{1}{8{sin}^{2}⁡2x}\\right)(\\operatorname{sin}⁡2x) \\\\  & =\\frac{{cos}^{2}⁡2x}{4\\operatorname{sin}⁡2x}-\\frac{1}{8\\operatorname{sin}⁡2x} \\\\  & =\\frac{1}{8\\operatorname{sin}⁡2x}(2{cos}^{2}⁡2x-1) \\\\  & =\\frac{\\operatorname{cos}⁡4x}{8\\operatorname{sin}⁡2x} \\\\  & =\\frac{1}{8}\\operatorname{cos}⁡4x\\,\\operatorname{csc}⁡2x.\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x\\,+\\,\\underbrace{\\frac{1}{8}\\operatorname{cos}⁡4x\\operatorname{csc}⁡2x}_{g(x)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=\\frac{1}{8}\\operatorname{cos}⁡4x\\operatorname{csc}⁡2x.\n$$"} {:db/id #edb/ref 17592186314734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "363bca26-2640-561a-8e0a-ff8738b01764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{2x}" :db/id #edb/ref 17592186312413} {:answer/id #uuid "52bd3689-9dc2-5748-a490-ce6278807abe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x{e}^{2x}" :db/id #edb/ref 17592186312646} {:answer/id #uuid "74a80b12-9e6c-5cc9-bd02-14b770af302c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}{e}^{2x}" :db/id #edb/ref 17592186312904} {:answer/id #uuid "91b81410-4c41-5e18-985f-4a81442d8b35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}{e}^{2x}" :db/id #edb/ref 17592186313139} {:answer/id #uuid "a339f694-ae0b-579c-9ec4-e426b6eee714" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{2x}" :db/id #edb/ref 17592186313259}] :answer-field/correct {:db/id #edb/ref 17592186312413} :answer-field/id #uuid "bb7da265-faa3-54ac-8254-6d53c36f0c05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314524}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee370497-ed10-5931-a8db-bee5e7b95d07" :question/math-academy-id "q-338767" :question/problem "Consider the following differential equation\n\n$$\n{y}^{″}-4{y}^{′}+5y=x{e}^{2x}.\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)={e}^{2x}\\,(A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x)+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method. You may also wish to make use of the following results (integration constants omitted):*\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x-x\\operatorname{cos}⁡x \\\\ \\int x\\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{cos}⁡x+x\\operatorname{sin}⁡x\\end{aligned}\n$$" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx,\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFirst, we note that the forcing term is $f(x)=x{e}^{2x}.$\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)={e}^{2x}\\,(A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x).\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{2x}\\operatorname{cos}⁡x,\\,{y}_{2}(x)={e}^{2x}\\operatorname{sin}⁡x.\n$$\n\nWe can use the method of variation of parameters if these solutions are linearly independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix} \\\\  & ={y}_{1}(x){y}_{2}^{′}(x)-{y}_{1}^{′}(x){y}_{2}(x) \\\\  & =({e}^{2x}\\operatorname{cos}⁡x)({e}^{2x}\\operatorname{sin}⁡x)^{′}-({e}^{2x}\\operatorname{cos}⁡x)^{′}({e}^{2x}\\operatorname{sin}⁡x) \\\\  & =({e}^{2x}\\operatorname{cos}⁡x)(2{e}^{2x}\\operatorname{sin}⁡x+{e}^{2x}\\operatorname{cos}⁡x)-(2{e}^{2x}\\operatorname{cos}⁡x-{e}^{2x}\\operatorname{sin}⁡x)({e}^{2x}\\operatorname{sin}⁡x) \\\\  & ={e}^{4x}({cos}^{2}⁡x+{sin}^{2}⁡x) \\\\  & ={e}^{4x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent.\n\nLet’s compute ${u}_{1}(x)$ and ${u}_{2}(x)$:\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx \\\\  & =-\\int \\frac{x{e}^{2x}\\cdot {e}^{2x}\\operatorname{sin}⁡x}{{e}^{4x}}\\,dx \\\\  & =-\\int x\\operatorname{sin}⁡x\\,dx \\\\  & =-(\\operatorname{sin}⁡x-x\\operatorname{cos}⁡x) \\\\  & =x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x \\\\ {u}_{2}(x) & =\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx \\\\  & =\\int \\frac{x{e}^{2x}\\cdot {e}^{2x}\\operatorname{cos}⁡x}{{e}^{4x}}\\,dx \\\\  & =\\int x\\operatorname{cos}⁡x\\,dx \\\\  & =\\operatorname{cos}⁡x+x\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)({e}^{2x}\\operatorname{cos}⁡x)+(\\operatorname{cos}⁡x+x\\operatorname{sin}⁡x)({e}^{2x}\\operatorname{sin}⁡x) \\\\  & ={e}^{2x}\\,(x{cos}^{2}⁡x-\\operatorname{sin}⁡x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x\\operatorname{cos}⁡x+x{sin}^{2}⁡x) \\\\  & =x{e}^{2x}.\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & ={e}^{2x}\\,(A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x)+\\underbrace{x{e}^{2x}}_{g(x)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=x{e}^{2x}.\n$$"} {:db/id #edb/ref 17592186314735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35fd9ec9-3d3f-53e6-8238-a74f46a06f98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-x}(\\operatorname{sin}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+x\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186312410} {:answer/id #uuid "37665da0-5d7d-577e-8565-d16bdc9f092b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-x}(\\operatorname{cos}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+x\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186312420} {:answer/id #uuid "37d7f0dd-1036-541f-8e35-7648f51924cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{-x}(\\operatorname{cos}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+x\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186312426} {:answer/id #uuid "76666fe5-e863-5cdc-be5d-a1317f7f43cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-x}(\\operatorname{cos}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|-x\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186312922} {:answer/id #uuid "e080bfc5-54af-552b-a07f-1bf0467be33a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{-x}(\\operatorname{sin}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|-x\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186313741}] :answer-field/correct {:db/id #edb/ref 17592186312420} :answer-field/id #uuid "2021cc91-6d9a-53d7-97fb-870580622516" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314095}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af45463a-7235-5271-b87d-27925e5aeef0" :question/math-academy-id "q-338774" :question/problem "Consider the following differential equation\n\n$$\n{y}^{″}+2{y}^{′}+2y={e}^{-x}\\operatorname{sec}⁡x.\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)={e}^{-x}(A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x)+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method. You may also wish to make use of the following result (integration constant omitted):*\n\n$$\n\\int \\operatorname{tan}⁡x\\,\\text{d}x=-\\operatorname{ln}⁡|\\operatorname{cos}⁡x|\n$$" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx,\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFirst, we note that the forcing term is $f(x)={e}^{-x}\\operatorname{sec}⁡x.$\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)={e}^{-x}(A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x).\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{-x}\\operatorname{cos}⁡x,\\,{y}_{2}(x)={e}^{-x}\\operatorname{sin}⁡x.\n$$\n\nWe can use the method of variation of parameters if these solutions are linearly independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix} \\\\  & ={y}_{1}(x){y}_{2}^{′}(x)-{y}_{1}^{′}(x){y}_{2}(x) \\\\  & =({e}^{-x}\\operatorname{cos}⁡x)({e}^{-x}\\operatorname{sin}⁡x)^{′}-({e}^{-x}\\operatorname{cos}⁡x)^{′}({e}^{-x}\\operatorname{sin}⁡x) \\\\  & =({e}^{-x}\\operatorname{cos}⁡x)(-{e}^{-x}\\operatorname{sin}⁡x+{e}^{-x}\\operatorname{cos}⁡x)-(-{e}^{-x}\\operatorname{cos}⁡x-{e}^{-x}\\operatorname{sin}⁡x)({e}^{-x}\\operatorname{sin}⁡x) \\\\  & ={e}^{-2x}({cos}^{2}⁡x+{sin}^{2}⁡x) \\\\  & ={e}^{-2x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent.\n\nLet’s compute ${u}_{1}(x)$ and ${u}_{2}(x)$:\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,dx \\\\  & =-\\int \\frac{{e}^{-x}\\operatorname{sec}⁡x\\cdot {e}^{-x}\\operatorname{sin}⁡x}{{e}^{-2x}}\\,dx \\\\  & =-\\int \\operatorname{tan}⁡x\\,dx \\\\  & =\\operatorname{ln}⁡|\\operatorname{cos}⁡x| \\\\ {u}_{2}(x) & =\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,dx \\\\  & =\\int \\frac{{e}^{-x}\\operatorname{sec}⁡x\\cdot {e}^{-x}\\operatorname{cos}⁡x}{{e}^{-2x}}\\,dx \\\\  & =\\int dx \\\\  & =x\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(\\operatorname{ln}⁡|\\operatorname{cos}⁡x|)({e}^{-x}\\operatorname{cos}⁡x)+(\\operatorname{sin}⁡x)(x{e}^{-x}) \\\\  & ={e}^{-x}(\\operatorname{cos}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+x\\operatorname{sin}⁡x).\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & ={e}^{-x}(A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x)+\\underbrace{{e}^{-x}(\\operatorname{cos}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+x\\operatorname{sin}⁡x)}_{g(x)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)={e}^{-x}(\\operatorname{cos}⁡x\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+x\\operatorname{sin}⁡x).\n$$"} {:db/id #edb/ref 17592186314747 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "652efead-3751-5826-ad6d-52673095f934" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)=0" :db/id #edb/ref 17592186312772} {:answer/id #uuid "f5b8be24-3d20-5105-bbcd-8ea24d66f421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186313940}] :answer-field/correct {:db/id #edb/ref 17592186313940} :answer-field/id #uuid "158cd97b-d50a-5c28-bc86-7572fca777a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314066} {:answer-field/choices [{:answer/id #uuid "060cef8f-af9e-53f8-a579-22ced1921251" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186312015} {:answer/id #uuid "14677f79-68f9-574f-8e6f-5636727a08aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "has no solution" :db/id #edb/ref 17592186312116} {:answer/id #uuid "382608df-809b-54b0-a002-e15fa3ab12b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186312429} {:answer/id #uuid "3da08caa-0dfc-55dd-a0e1-4228ae5095f3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186312474}] :answer-field/correct {:db/id #edb/ref 17592186312429} :answer-field/id #uuid "23beeeb3-82bc-5259-9274-d64b3de3c779" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314102} {:answer-field/choices [{:answer/id #uuid "496a3a84-245b-551a-b8d9-7d6d775196fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{2x}" :db/id #edb/ref 17592186312564} {:answer/id #uuid "816e1f13-ee96-5fd0-b384-86113e2af972" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{2x}$" :db/id #edb/ref 17592186313018} {:answer/id #uuid "8e035af8-bc7a-5945-861b-8088003c1635" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)={e}^{-2x}$ and ${y}_{2}(x)={e}^{-3x}$" :db/id #edb/ref 17592186313105} {:answer/id #uuid "e932acc6-0cc0-5361-be67-c4b840fadecd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)=\\operatorname{sin}⁡2x$ and ${y}_{2}(x)=\\operatorname{cos}⁡2x$" :db/id #edb/ref 17592186313832} {:answer/id #uuid "f8f86c42-2059-53cd-aa7b-4490f4e245e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)={e}^{3x}$ and ${y}_{2}(x)={e}^{-x}$" :db/id #edb/ref 17592186313967}] :answer-field/correct {:db/id #edb/ref 17592186312564} :answer-field/id #uuid "af749fd6-984e-5aaf-85c4-27df1ba1c250" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314483} {:answer-field/choices [{:answer/id #uuid "12751484-3d11-5c0e-ad1d-b781221c4a18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186312107} {:answer/id #uuid "73ad3e95-891e-5e49-8c3f-7142af3c9f96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6e(e-1)" :db/id #edb/ref 17592186312893} {:answer/id #uuid "be57a3c4-4536-5d62-8a7d-39c067b4928e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{e}^{2}" :db/id #edb/ref 17592186313465} {:answer/id #uuid "bff96a55-b8e0-5ac9-9d14-98b174c21aff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(1)\\operatorname{cos}⁡(1)" :db/id #edb/ref 17592186313478} {:answer/id #uuid "d89744d4-9cdc-578e-a357-328a4b0f21f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡(1)" :db/id #edb/ref 17592186313680}] :answer-field/correct {:db/id #edb/ref 17592186313465} :answer-field/id #uuid "eecda61a-26b0-55c0-a855-c267c85ea6e4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314665}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "660a9b99-a847-5a2d-9d2b-a5729bbfe708" :question/math-academy-id "q-338980" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}-3{y}^{′}+2y=0,\\,y(0)+{y}^{′}(0)=y(1)-{y}^{′}(1)=0,\\,0\\le x\\le 1\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=\\begin{bmatrix}{y}_{1}(0)+{y}_{1}^{′}(0) & {y}_{2}(0)+{y}_{2}^{′}(0) \\\\ {y}_{1}(1)-{y}_{1}^{′}(1) & {y}_{2}(1)-{y}_{2}^{′}(1)\\end{bmatrix}.\n$$\n\nFill in the correct options in the reasoning below.\n\n$\\,$ The boundary value problem has a unique solution if and only if {{field-1}}.\n\n$\\,$ The fundamental solutions to this BVP are {{field-2}}.\n\n$\\,$ For this BVP, we have $det(A)=$  {{field-3}}.\n\n$\\,$ Therefore, this BVP {{field-4}}." :question/worked-solution "Suppose we have the second-order homogeneous boundary value (BVP) problem\n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y=0,\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)=0,\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)=0,\n$$\n\nwhere $P$ and $Q$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ Furthermore, suppose the fundamental solutions to the equation are ${y}_{1}(x)$ and ${y}_{2}(x).$ \n\nNow, let's define the following matrix:\n\n$$\nA=\\begin{bmatrix}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{bmatrix}\n$$\n\nThen, the BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$\nIn other words, if the determinant equals zero, then the BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Robin boundary conditions, given by\n\n$$\ny(0)+{y}^{′}(0)=0,\\,y(1)-{y}^{′}(1)=0.\n$$\n\nSo, setting ${\\alpha }_{1}=1,$ ${\\beta }_{1}=1,$ ${\\alpha }_{2}=1,$ ${\\beta }_{2}=-1,$ and $a=0,$  $b=1,$ the matrix $A$ becomes\n\n$$\nA=\\begin{bmatrix}{y}_{1}(0)+{y}_{1}^{′}(0) & {y}_{2}(0)+{y}_{2}^{′}(0) \\\\ {y}_{1}(1)-{y}_{1}^{′}(1) & {y}_{2}(1)-{y}_{2}^{′}(1)\\end{bmatrix}.\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-3m+2 & =0 \\\\ (m-1)(m-2) & =0.\\end{aligned}\n$$\n\nSo, we have ${m}_{1}=1$ and ${m}_{2}=2,$ and so the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{x}\\,\\text{and}\\,{y}_{2}(x)={e}^{2x}.\n$$\n\nDifferentiating, we have\n\n$$\n{y}_{1}^{′}(x)={e}^{x},\\,{y}_{2}^{′}(x)=2{e}^{2x}.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}{e}^{0}+{e}^{0} & {e}^{3(0)}+2{e}^{2(0)} \\\\ {e}^{1}-{e}^{1} & {e}^{2(1)}-2{e}^{2(1)}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 3 \\\\ 0 & -{e}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\nand we have\n\n$$\n\\begin{aligned}det(A) & =2(-{e}^{2})-0(3) \\\\  & =-2{e}^{2}.\\end{aligned}\n$$\n\nSince $det(A)\\ne 0,$ we conclude that this BVP $\\text{has a unique solution }y≡0.$"} {:db/id #edb/ref 17592186314752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a680505-498a-5baa-bf8e-c8493ba36124" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)=x{e}^{x}$" :db/id #edb/ref 17592186312053} {:answer/id #uuid "4e7db26b-228b-53be-afc2-3a3e7da6b078" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)=\\operatorname{sin}⁡2x$ and ${y}_{2}(x)=\\operatorname{cos}⁡2x$" :db/id #edb/ref 17592186312612} {:answer/id #uuid "5c5230a2-04a0-5134-a4c7-7efa4c1a4929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{1}(x)=\\operatorname{sin}x$ and ${y}_{2}(x)=\\operatorname{cos}x" :db/id #edb/ref 17592186312710} {:answer/id #uuid "7921d995-baa4-5000-868c-bc1346a61f65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)=\\operatorname{sin}⁡x$ and ${y}_{2}(x)=\\operatorname{cos}⁡x$" :db/id #edb/ref 17592186312943} {:answer/id #uuid "fa41b384-4fc5-5374-9c6c-be8449048632" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{-x}$" :db/id #edb/ref 17592186313972}] :answer-field/correct {:db/id #edb/ref 17592186312710} :answer-field/id #uuid "2ee879c3-d1c4-53a0-be99-7f013284e0ad" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314136} {:answer-field/choices [{:answer/id #uuid "8a0cff89-e1c9-5b44-b926-6fdd25c5b754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186313073} {:answer/id #uuid "a5f7d3ce-1c5b-5eee-bbb8-8fd1c873b451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "det(A)=0" :db/id #edb/ref 17592186313279}] :answer-field/correct {:db/id #edb/ref 17592186313073} :answer-field/id #uuid "4759d324-ef04-52de-be42-6a8421eeffec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314208} {:answer-field/choices [{:answer/id #uuid "2520787a-b0f9-58d9-8b5a-36f0879d3ca9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186312256} {:answer/id #uuid "3238eeb2-28be-5763-91e9-565c8d9a9275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186312381} {:answer/id #uuid "aceefb60-31a3-5fa8-a95e-7a050ee75da0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e" :db/id #edb/ref 17592186313329} {:answer/id #uuid "efd09585-f5f0-5b92-af46-f809514543fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{1-\\pi }-{e}^{\\pi -1}" :db/id #edb/ref 17592186313895}] :answer-field/correct {:db/id #edb/ref 17592186312381} :answer-field/id #uuid "be1be495-891a-5f69-84c8-049cedb0b0b2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314537} {:answer-field/choices [{:answer/id #uuid "4d7403ef-88a9-5566-9212-7ff33f750616" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186312604} {:answer/id #uuid "5b86a9ba-8350-56c2-88df-f1ec399e5d51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "has no solution" :db/id #edb/ref 17592186312705} {:answer/id #uuid "9183a42f-9619-57f2-91de-e24059183ddf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186313135} {:answer/id #uuid "f0e5e064-38ea-5f89-af28-f698d3210066" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186313904}] :answer-field/correct {:db/id #edb/ref 17592186312604} :answer-field/id #uuid "e5968d31-3597-5af0-bdb8-92f17a1f65b4" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314640}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a430fd57-63d6-5c8d-a2e1-572f77f00d5f" :question/math-academy-id "q-339097" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}+y=0,\\,y(0)=y(\\pi )=0,\\,0\\le x\\le \\pi \n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=\\begin{bmatrix}{y}_{1}(0) & {y}_{2}(0) \\\\ {y}_{1}(\\pi ) & {y}_{2}(\\pi )\\end{bmatrix}.\n$$\n\nFill in the correct options in the reasoning below.\n\n$\\,$ The boundary value problem has a unique solution if and only if {{field-1}}.\n\n$\\,$ The fundamental solutions to this BVP are {{field-2}}.\n\n$\\,$ For this BVP, we have $det(A)=$  {{field-3}}.\n\n$\\,$ Therefore, this BVP {{field-4}}." :question/worked-solution "Suppose we have the second-order homogeneous boundary value (BVP) problem\n\n$$\n{y}^{″}(x)+P(x){y}^{′}+Q(x)y=0,\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)=0,\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)=0\n$$\n\nwhere $P$ and $Q$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ Furthermore, suppose the fundamental solutions to the equation are ${y}_{1}(x)$ and ${y}_{2}(x).$ \n\nNow, let's define the following matrix:\n\n$$\nA=\\begin{bmatrix}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{bmatrix}\n$$\n\nThen, the BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$\n\nIn other words, if the determinant equals zero, then the BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Dirichlet boundary conditions. So, setting ${\\alpha }_{i}=1,{\\beta }_{i}=0,a=0,$ and $b=\\pi ,$ the matrix $A$ reduces to\n\n$$\nA=\\begin{bmatrix}{y}_{1}(0) & {y}_{2}(0) \\\\ {y}_{1}(\\pi ) & {y}_{2}(\\pi )\\end{bmatrix}.\n$$\n\nTo find the fundamental solutions, we solve the auxiliary equation\n\n$$\n{m}^{2}+1=0,\n$$\n\nwhich has roots $\\pm i.$ Thus, the fundamental solutions are\n\n$$\n{y}_{1}(x)=\\operatorname{sin}⁡x\\text{ and }{y}_{2}(x)=\\operatorname{cos}⁡x.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\nA=\\begin{bmatrix}0 & 1 \\\\ 0 & -1\\end{bmatrix}\n$$\n\nand we have\n\n$$\n\\begin{aligned}det(A) & =0(-1)-1(0) \\\\  & =0.\\end{aligned}\n$$\n\nSince $det(A)=0$ we conclude that this BVP $\\text{has infinitely many solutions.}$"} {:db/id #edb/ref 17592186314787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f0d6aa8-606b-5bec-a3af-6502cd631d39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186313226}] :answer-field/correct {:db/id #edb/ref 17592186313226} :answer-field/id #uuid "0e8cb47d-8737-5de7-ae92-ad8fc0cb2ccc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314055}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dced79c7-5f2c-5235-8004-8d45b7bc9bd7" :question/math-academy-id "q-339490" :question/problem "Evaluate the following limit:\n\n$$\n\\lim_{x\\to \\,\\sqrt{3}}sin\\,(\\frac{3}{4}\\operatorname{arctan}⁡(x))=\n$$\n{{field-1}}" :question/worked-solution "![](images/68/68f1ebd0457e0c127f8ed6c979feba58196aa6bb43d97d211efa9b39bc33f637.png)\n\nThe domain of $\\operatorname{arctan}⁡(x)$ is $(-\\infty ,\\infty ).$\n\nNow, substituting $x=\\sqrt{3}$ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,\\sqrt{3}}sin\\,(\\frac{3}{4}\\operatorname{arctan}⁡(x)) & =sin\\,(\\frac{3}{4}\\operatorname{arctan}⁡(\\sqrt{3})) \\\\  & =sin\\,(\\frac{3}{4}\\cdot \\frac{\\pi }{3}) \\\\  & =sin\\,\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c93f72ea-a72b-534b-8b07-68dd630ed592" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466465} {:answer/id #uuid "eb4276fe-b5e7-5574-9671-cc628285f741" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466466}] :answer-field/correct {:db/id #edb/ref 17592186466466} :answer-field/id #uuid "83fd42ce-5dfd-5e09-a6ac-41488ad2578f" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=\\operatorname{ln}⁡(2t)\\,{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=2{x}_{1}(t)+\\sqrt{3}\\,t\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186467076} {:answer-field/choices [{:answer/id #uuid "24108b29-e70d-58fb-a033-49aaedd4e644" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466467} {:answer/id #uuid "490664f0-bbaa-576a-be50-ee9ee5989469" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466468}] :answer-field/correct {:db/id #edb/ref 17592186466468} :answer-field/id #uuid "5e318dbe-bf05-5a37-b0f2-d45b795f3fec" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=cos\\,(\\frac{3\\pi }{8}){x}_{1}(t)+{13}^{2}{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{1}(t)-\\pi {x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186467077} {:answer-field/choices [{:answer/id #uuid "9faa87d0-2c58-5b56-b62c-9beeaa0bb339" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466469} {:answer/id #uuid "a7f1d784-e5f4-5c2f-a451-9e8b401c4e28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466470}] :answer-field/correct {:db/id #edb/ref 17592186466469} :answer-field/id #uuid "8b3c8a51-7071-55bf-9a02-177f4c98b266" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=2{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}^{2}(t)+{x}_{2}^{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186467078}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "686f5a84-c1ca-551b-b5e9-fd8d6a7feafb" :question/math-academy-id "q-339540" :question/problem "Which of the following are first-order linear systems of ODEs?\n\nSelect all that apply." :question/worked-solution "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t) &=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\\right.\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- ${x}_{1}(t)$ and ${x}_{2}(t)$ are unknown functions (dependent variables).\n\nWith this in mind, let's inspect each system:\n\n- System $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=\\operatorname{ln}⁡(2t)\\,{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=2{x}_{1}(t)+\\sqrt{3}\\,t\\end{aligned}\\right.\n$$ is a first-order linear system of ODEs since it can be written in the standard form, where\n\n$$\n\\begin{aligned}a(t)=\\operatorname{ln}⁡(2t), &  & b(t)=1, &  & f(t)=0, \\\\ c(t)=2, &  & d(t)=0, &  & g(t)=\\sqrt{3}\\,t.\\end{aligned}\n$$\n\n- System $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=cos\\,\\left(\\frac{3\\pi }{8}\\right){x}_{1}(t)+{13}^{2}{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{1}(t)-\\pi {x}_{2}(t)\\end{aligned}\\right.\n$$ is a first-order linear system of ODEs since it can be written in the standard form, where\n\n$$\n\\begin{aligned}a(t)=cos\\,\\left(\\frac{3\\pi }{8}\\right), &  & b(t)={13}^{2}, &  & f(t)=0, \\\\ c(t)=9, &  & d(t)=-\\pi , &  & g(t)=0.\\end{aligned}\n$$\n\n- System $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=2{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}^{2}(t)+{x}_{2}^{2}(t)\\end{aligned}\\right.\n$$ is not a first-order linear system of ODEs since it contains the terms ${x}_{1}^{2}(t)$ and ${x}_{2}^{2}(t).$\n\nTherefore, the correct answer is $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=\\operatorname{ln}⁡(2t)\\,{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=2{x}_{1}(t)+\\sqrt{3}\\,t\\end{aligned}\\right.\n$$; $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=cos\\,\\left(\\frac{3\\pi }{8}\\right){x}_{1}(t)+{13}^{2}{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{1}(t)-\\pi {x}_{2}(t)\\end{aligned}\\right.\n$$ only."} {:db/id #edb/ref 17592186314855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be74376b-f6cf-583f-95b4-d0baeaa08b4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186313468}] :answer-field/correct {:db/id #edb/ref 17592186313468} :answer-field/id #uuid "daac023f-b3e5-5739-9d3f-7f31e324cbea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314615}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bb1c657b-33e1-538c-a41b-0a68255fe01e" :question/math-academy-id "q-339797" :question/problem "Evaluate the following limit:\n\n$$\n\\lim_{x\\to 0}\\frac{3{sin}^{2}⁡x}{2{x}^{2}}=\n$$\n{{field-1}}" :question/worked-solution "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to 0}\\,\\frac{3{sin}^{2}⁡x}{2{x}^{2}}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\,\\frac{3{sin}^{2}⁡x}{2{x}^{2}} & =\\lim_{x\\to 0}(\\frac{3}{2}\\cdot \\frac{{sin}^{2}⁡x}{{x}^{2}}) \\\\  & =\\frac{3}{2}\\cdot {lim}_{x\\to 0}{\\left(\\frac{\\operatorname{sin}⁡x}{x}\\right)}^{2} \\\\  & =\\frac{3}{2}\\cdot {[\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}]}^{2} \\\\  & =\\frac{3}{2}\\cdot {1}^{2} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dcc27e7-95b3-51a3-8ce2-f478b5639a0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186312985}] :answer-field/correct {:db/id #edb/ref 17592186312985} :answer-field/id #uuid "55c95f7d-1794-5dae-b0e8-f350d95dcde1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314253}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "71ed2e26-0e24-5b2f-bb68-bcacff682ddf" :question/math-academy-id "q-339798" :question/problem "Evaluate the following limit:\n\n$\\lim_{x\\to 0}\\frac{{sin}^{5}⁡x}{4{x}^{4}}=$\n{{field-1}}" :question/worked-solution "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to 0}\\,\\frac{{sin}^{5}⁡x}{4{x}^{4}}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\,\\frac{{sin}^{5}⁡x}{4{x}^{4}} & =\\lim_{x\\to 0}(\\frac{1}{4}\\cdot \\frac{{sin}^{4}⁡x}{{x}^{4}}\\cdot \\operatorname{sin}⁡x) \\\\  & =\\frac{1}{4}\\cdot {lim}_{x\\to 0}\\,\\frac{{sin}^{4}⁡x}{{x}^{4}}\\cdot {lim}_{x\\to 0}\\,\\operatorname{sin}⁡x \\\\  & =\\frac{1}{4}\\cdot {lim}_{x\\to 0}{\\left(\\frac{\\operatorname{sin}⁡x}{x}\\right)}^{4}\\cdot {lim}_{x\\to 0}\\,\\operatorname{sin}⁡x \\\\  & =\\frac{1}{4}\\cdot {[\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}]}^{4}\\cdot {lim}_{x\\to 0}\\,\\operatorname{sin}⁡x \\\\  & =\\frac{1}{4}\\cdot {1}^{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddf94f51-0ff1-50ae-bad8-f27b8dd41ff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186313722}] :answer-field/correct {:db/id #edb/ref 17592186313722} :answer-field/id #uuid "1d695fb2-0a1c-5813-8633-32337be30f6c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45102bcc-b0f0-58bb-8720-e0d524eca593" :question/math-academy-id "q-339843" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1/2}\\frac{3}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}\\frac{3}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =3{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =3\\cdot \\operatorname{arcsin}⁡x\\,{|}_{0}^{1/2} \\\\  & =3(arcsin\\,\\left(\\frac{1}{2}\\right)-\\operatorname{arcsin}⁡(0)) \\\\  & =3(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ee19c8-ffa3-51c2-90c8-f32e76bf3ba8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4x}" :db/id #edb/ref 17592186312005} {:answer/id #uuid "04e1e1ed-ae8d-46b8-ab8d-1085b1802387" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11/(4x)" :db/id #edb/ref 17592186409335}] :answer-field/correct {:db/id #edb/ref 17592186312005} :answer-field/id #uuid "e6760650-0666-56ec-a209-471cd8d6b267" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314644}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dffc415e-0ffd-5f91-84e8-ab042b2a6f3c" :question/math-academy-id "q-339949" :question/problem "Given that $y=\\frac{11}{4}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}ln⁡x) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{x} \\\\  & =\\frac{11}{4x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77574496-a3d5-5133-b54d-5a41edeef925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{3x}" :db/id #edb/ref 17592186312931} {:answer/id #uuid "8d49850c-09b0-4746-acd2-5bace5c80ed5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7/(3x)" :db/id #edb/ref 17592186409336}] :answer-field/correct {:db/id #edb/ref 17592186312931} :answer-field/id #uuid "2d5f9fb9-2594-5780-812f-98f59dc7cafe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314132}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eeedc903-d84c-5e00-bc96-dcee7bf9bc01" :question/math-academy-id "q-339950" :question/problem "Given that $y=-\\frac{7}{3}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{7}{3}ln⁡x) \\\\  & =-\\frac{7}{3}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =-\\frac{7}{3}\\cdot \\frac{1}{x} \\\\  & =-\\frac{7}{3x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4252b1b-dd35-545d-814f-9733f49b7285" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186313645}] :answer-field/correct {:db/id #edb/ref 17592186313645} :answer-field/id #uuid "1f1326d4-3786-5ce8-bdc5-383026fa0fef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314091} {:answer-field/choices [{:answer/id #uuid "4a6854d6-273e-50f7-ac16-5801c62a2345" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186312576}] :answer-field/correct {:db/id #edb/ref 17592186312576} :answer-field/id #uuid "b220aac7-54ee-544e-b56a-707200ae420e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314491}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b715659f-46cf-51b3-82e4-5f218178bf7e" :question/math-academy-id "q-339967" :question/problem "Find $\\lim_{x\\to {0}^{-}}f(x)$ and $\\lim_{x\\to {2}^{+}}f(x)$ for the function given by\n\n$$\nf(x)=\\begin{cases}3sin\\,(\\frac{\\pi }{3}x)+2 & \\text{ for }\\,x<0 \\\\ \\sqrt{7x+2}-1 & \\text{ for }\\,x\\ge 2.\\end{cases}\n$$\n\n$$\n\\lim_{x\\to {0}^{-}}f(x)=\n$$\n{{field-1}}\n$\\,$ and $\\,$\n$$\n\\lim_{x\\to {2}^{+}}f(x)=\n$$\n{{field-2}}" :question/worked-solution "Approaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=3sin\\,(\\frac{\\pi }{3}x)+2.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{-}}[3sin\\,(\\frac{\\pi }{3}x)+2] \\\\  & =3sin\\,(\\frac{\\pi }{3}(0))+2 \\\\  & =3\\operatorname{sin}⁡(0)+2 \\\\  & =3\\cdot 0+2 \\\\  & =2.\\end{aligned}\n$$\n\nOn the other hand, approaching $x=2$ from the right, we have $x\\ge 2,$ so we use the expression $f(x)=\\sqrt{7x+2}-1.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{+}}f(x) & =\\lim_{x\\to {2}^{+}}(\\sqrt{7x+2}-1) \\\\  & =\\sqrt{7(2)+2}-1 \\\\  & =\\sqrt{16}-1 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277904a9-9e9e-53f0-a87c-616303962482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55-\\frac{1}{\\operatorname{ln}6}" :db/id #edb/ref 17592186312275} {:answer/id #uuid "fce43cba-9363-5793-89ef-2161d7a4191d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55-\\frac{1}{\\ln 6}" :db/id #edb/ref 17592186525833}] :answer-field/correct {:db/id #edb/ref 17592186525833} :answer-field/id #uuid "0bb11537-ff22-5776-85db-c4e4d92da407" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9fb0b98-97be-5fa4-a0a8-73b036fd9d03" :question/math-academy-id "q-339994" :question/problem "Given the function $y=2{x}^{3}+x-3{log}_{6}⁡x,$ find the instantaneous rate of change at $x=3.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=3$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}+x-3{log}_{6}⁡x) \\\\  & =2\\cdot 3{x}^{2}+1-3\\cdot \\frac{1}{x\\operatorname{ln}⁡6} \\\\  & =6{x}^{2}+1-\\frac{3}{x\\operatorname{ln}⁡6}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(6{x}^{2}+1-\\frac{3}{x\\operatorname{ln}⁡6})|}_{x=3} \\\\  & =6(3)^{2}+1-\\frac{3}{3\\cdot \\operatorname{ln}⁡6} \\\\  & =55-\\frac{1}{\\operatorname{ln}⁡6}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c897e4-b652-55dd-8d72-bc5035453929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24-\\frac{5}{2\\operatorname{ln}3}" :db/id #edb/ref 17592186312506}] :answer-field/correct {:db/id #edb/ref 17592186312506} :answer-field/id #uuid "32f3d565-6897-5bcf-9632-a037dba3624d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1eb887e7-89db-539c-9d35-d652e9bb15c3" :question/math-academy-id "q-340024" :question/problem "Given the function $y=2{x}^{3}-5{log}_{3}⁡x,$ the slope of the tangent line at $x=2$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-5{log}_{3}⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({x}^{3})-5\\frac{\\text{d}}{\\text{d}x}({log}_{3}⁡x) \\\\  & =2\\cdot 3{x}^{2}-5\\cdot \\frac{1}{xln⁡3} \\\\  & =6{x}^{2}-\\frac{5}{xln⁡3}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(6{x}^{2}-\\frac{5}{xln⁡3})|}_{x=2} \\\\  & =6(2)^{2}-\\frac{5}{2ln⁡3} \\\\  & =24-\\frac{5}{2ln⁡3}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101f0087-1aec-50e5-a9b7-d806a0ea860a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{\\operatorname{ln}2}+5" :db/id #edb/ref 17592186312090}] :answer-field/correct {:db/id #edb/ref 17592186312090} :answer-field/id #uuid "9a7fc2dd-1d62-5a23-a97f-19baf25d47a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314431}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1b69d4c2-7ebc-59ed-aa14-566d23bb3592" :question/math-academy-id "q-340026" :question/problem "Given the function $y=6{log}_{2}⁡x+4{x}^{2}-3x,$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6{log}_{2}⁡x+4{x}^{2}-3x) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})-3\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =6\\cdot \\frac{1}{xln⁡2}+4\\cdot 2x-3 \\\\  & =\\frac{6}{xln⁡2}+8x-3\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{6}{xln⁡2}+8x-3)|}_{x=1} \\\\  & =\\frac{6}{1\\cdot ln⁡2}+8(1)-3 \\\\  & =\\frac{6}{ln⁡2}+5\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cdb78ad-20bf-5af0-a094-1b3f6357e552" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{e}^{x}" :db/id #edb/ref 17592186312717} {:answer/id #uuid "6cffecb4-1fcc-411a-8289-8bcd57cb4ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6e^{x}" :db/id #edb/ref 17592186409337}] :answer-field/correct {:db/id #edb/ref 17592186312717} :answer-field/id #uuid "7a411b7f-e09b-54e6-9330-1c2c71a4efc6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314334}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6869b95a-63a5-54db-b062-b375ad3ac68d" :question/math-academy-id "q-340056" :question/problem "Given that $f(x)=6{e}^{x}+ln⁡8,$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡8$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}+ln⁡8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡8) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =6{e}^{x}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5617ce4a-0d0b-5579-9117-39b8a7543d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186312669}] :answer-field/correct {:db/id #edb/ref 17592186312669} :answer-field/id #uuid "2f020ff7-e48f-5d76-8f54-670acd328fee" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314137} {:answer-field/choices [{:answer/id #uuid "8ff049c5-7f8f-5346-ac3a-aaed71e61b59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186313124}] :answer-field/correct {:db/id #edb/ref 17592186313124} :answer-field/id #uuid "4466b777-c531-51f5-b4c7-953fe848e7e9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314198}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2bcfc462-a947-5f79-9ef0-9568ba62e9fc" :question/math-academy-id "q-340062" :question/problem "The largest interval of continuity for the function $f(x)={log}_{e}⁡(4+2x)$ is\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}$).$" :question/worked-solution "The logarithmic function ${log}_{e}⁡(4+2x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n4+2x>0\\,⟹\\,2x>-4\\,⟹\\,x>-2\n$$\n\nTherefore, the function $f(x)={log}_{e}⁡(4+2x)$ is continuous on the interval $(-2,\\infty ).$"} {:db/id #edb/ref 17592186314906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6db64c05-bd48-51ef-9218-df180caf5534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186312840}] :answer-field/correct {:db/id #edb/ref 17592186312840} :answer-field/id #uuid "413c0c5a-e837-526a-8b03-fa256fc8b859" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314186}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19b7181e-4102-59d9-864a-c870a873bbda" :question/math-academy-id "q-340067" :question/problem "Given that $f(x)=9{e}^{x}+ln⁡4$, the slope of the tangent line at $x=ln⁡2$ is{{field-1}}." :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡4$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}+ln⁡4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡4) \\\\  & =9\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =9{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=ln⁡2} & ={(9{e}^{x})\\,|}_{x=ln⁡2} \\\\  & =9{e}^{ln⁡2} \\\\  & =9\\cdot 2 \\\\  & =18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e84b004d-c756-5287-9cf0-ae759a9460fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186313821}] :answer-field/correct {:db/id #edb/ref 17592186313821} :answer-field/id #uuid "43d689b0-18f8-5f20-be93-c7b79c382dc1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314196} {:answer-field/choices [{:answer/id #uuid "0896c83a-20b5-57de-be91-06ebe5ca2851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty " :db/id #edb/ref 17592186312037}] :answer-field/correct {:db/id #edb/ref 17592186312037} :answer-field/id #uuid "714a1370-07eb-5a26-8895-b30351ef9a20" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314317}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a83e9a77-8ebb-59d3-a88e-9e7019ef06bb" :question/math-academy-id "q-340069" :question/problem "The largest interval of continuity for the function $f(x)={log}_{e}⁡(10-5x)$ is\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}$).$" :question/worked-solution "The logarithmic function ${log}_{e}⁡(10-5x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n10-5x>0\\,⟹\\,5x<10\\,⟹\\,x<2\n$$\n\nTherefore, the function $f(x)={log}_{e}⁡(10-5x)$ is continuous on the interval $(-\\infty ,2).$"} {:db/id #edb/ref 17592186314908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfe78000-2ea3-5c77-849f-f0d25fc0e94c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty " :db/id #edb/ref 17592186313736}] :answer-field/correct {:db/id #edb/ref 17592186313736} :answer-field/id #uuid "1e719c33-13ae-5785-a290-78ce42a20bbd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314090} {:answer-field/choices [{:answer/id #uuid "90dcc1ea-f71d-5c09-b36e-fadc0c554547" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186313130}] :answer-field/correct {:db/id #edb/ref 17592186313130} :answer-field/id #uuid "f03cd458-e540-51a8-a7dc-b665c8fdf325" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314671}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ab9485a-5743-50f1-8638-78d915ca5aa4" :question/math-academy-id "q-340082" :question/problem "The largest interval of continuity for the function $f(x)={log}_{e}⁡(4-x)+\\operatorname{cos}⁡(2x)$ is\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}$).$" :question/worked-solution "The function consists of two parts, a logarithm and a cosine.\n\nThe cosine $\\operatorname{cos}⁡(2x)$ is continuous at all points in its domain, and its domain consists of all real numbers. So, we focus on the logarithm.\n\nLikewise, the logarithmic function ${log}_{e}⁡(4-x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n4-x>0\\,⟹\\,x<4\n$$\n\nTherefore, the function $f(x)={log}_{e}⁡(4-x)+\\operatorname{cos}⁡(2x)$ is continuous on the interval $(-\\infty ,4).$"} {:db/id #edb/ref 17592186314913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a1b399-700a-5dd2-967b-49969d3534b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{x}\\operatorname{ln}(3)+\\frac{1}{x\\operatorname{ln}(10)}" :db/id #edb/ref 17592186312291}] :answer-field/correct {:db/id #edb/ref 17592186312291} :answer-field/id #uuid "38b53a32-4b9b-556b-afd9-471f5f44697e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314162}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6065f3ff-ff9c-5643-832d-8d1ba7e4dfa6" :question/math-academy-id "q-340105" :question/problem "Given that $f(x)={3}^{x}+log⁡x$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+log⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}}{\\text{d}x}(log⁡x) \\\\  & ={3}^{x}ln⁡(3)+\\frac{1}{xln⁡(10)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cea7a0d-5e57-5d82-b9dc-783b5889bf1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{x}+\\frac{3}{x\\operatorname{ln}(5)}" :db/id #edb/ref 17592186312833}] :answer-field/correct {:db/id #edb/ref 17592186312833} :answer-field/id #uuid "8b6adce3-ac95-53df-964b-74afaf250503" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314381}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05a9cae0-c21b-5778-9f36-154aaf19469f" :question/math-academy-id "q-340106" :question/problem "Given that $y=-{e}^{x}+3{log}_{5}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-{e}^{x}+3{log}_{5}⁡x) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({e}^{x})+3\\frac{\\text{d}}{\\text{d}x}({log}_{5}⁡x) \\\\  & =-{e}^{x}+3\\cdot \\frac{1}{xln⁡(5)} \\\\  & =-{e}^{x}+\\frac{3}{xln⁡(5)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60475637-df2c-5099-a5a7-9cd23687c0fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{3}-\\frac{1}{\\operatorname{ln}2}" :db/id #edb/ref 17592186312747}] :answer-field/correct {:db/id #edb/ref 17592186312747} :answer-field/id #uuid "6bd5a890-600f-5ed0-9892-4e5fc04515a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314310}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c352abb-1992-52cb-94e7-b48e48f5bbc8" :question/math-academy-id "q-340110" :question/problem "Given the function $y=4{e}^{x}-3{log}_{2}⁡x+7,$ the slope of the tangent line at $x=3$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-3{log}_{2}⁡x+7) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-3\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+\\frac{\\text{d}}{\\text{d}x}(7) \\\\  & =4{e}^{x}-3\\cdot \\frac{1}{xln⁡2}+0 \\\\  & =4{e}^{x}-\\frac{3}{xln⁡2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(4{e}^{x}-\\frac{3}{xln⁡2})|}_{x=3} \\\\  & =4{e}^{3}-\\frac{3}{3\\cdot ln⁡2} \\\\  & =4{e}^{3}-\\frac{1}{ln⁡2}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cf00962-b6b4-5998-9975-1454f9f132c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186312597}] :answer-field/correct {:db/id #edb/ref 17592186312597} :answer-field/id #uuid "6cd890a5-ae47-5a39-8de8-b66ed079ea1f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314313}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0e13b26-bfd5-5474-9a46-4ad33e13d1cb" :question/math-academy-id "q-340137" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{\\theta \\to 0}\\,\\frac{{sec}^{2}⁡\\theta -1}{3\\theta {cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }=\n$$\n{{field-1}}" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{{sec}^{2}⁡\\theta -1}{3\\theta {cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta } & =\\lim_{\\theta \\to 0}\\,\\frac{{tan}^{2}⁡\\theta }{3\\theta {cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta } \\\\  & =\\lim_{\\theta \\to 0}\\,\\frac{\\left(\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }\\right)}{3\\theta {cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta } \\\\  & =\\lim_{\\theta \\to 0}(\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }\\cdot \\frac{1}{3\\theta {cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\cdot \\frac{1}{3{cos}^{4}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{3{cos}^{4}⁡\\theta }\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta }=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nInstead, let's recall the following special limit:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\frac{\\operatorname{sin}⁡\\theta }{\\theta } & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\,\\frac{1}{3{cos}^{4}⁡\\theta }=\\frac{1}{3{cos}^{4}⁡0}=\\frac{1}{3}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\left(\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\right)\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{3{cos}^{4}⁡\\theta } & =1\\cdot \\frac{1}{3}=\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b10b5839-c3fe-5a3d-8320-30a9fbd4c299" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186313350}] :answer-field/correct {:db/id #edb/ref 17592186313350} :answer-field/id #uuid "abd4a1e0-a3ec-521a-bf0b-3432f0cdd18b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314473}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "024f2f9f-248f-5918-9d85-569efea4127c" :question/math-academy-id "q-340150" :question/problem "Evaluate the following limit:\n\n$$\n\\displaystyle \\lim_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{cot}⁡\\theta }{4\\operatorname{sec}⁡\\theta }=\n$$\n{{field-1}}" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{cot}⁡\\theta }{4\\operatorname{sec}⁡\\theta } & =\\lim_{\\theta \\to 0}(\\frac{\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }÷4\\operatorname{sec}⁡\\theta ) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }÷\\frac{4}{\\operatorname{cos}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{4}) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\frac{{cos}^{2}⁡\\theta }{4}) \\\\  & =\\lim_{\\theta \\to 0}\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\frac{{cos}^{2}⁡\\theta }{4}\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1}{(\\lim_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta })} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\frac{{cos}^{2}⁡\\theta }{4}=\\frac{{cos}^{2}⁡0}{4}=\\frac{1}{4}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\frac{{cos}^{2}⁡\\theta }{4} & =1\\cdot \\frac{1}{4}=\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202a3876-df45-5f69-9dea-3b48cc477974" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{ln}(8){8}^{x}" :db/id #edb/ref 17592186312218} {:answer/id #uuid "4ad5377e-557d-4b02-81f5-eba612380c71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\cdot8^{x}\\ln8" :db/id #edb/ref 17592186409340}] :answer-field/correct {:db/id #edb/ref 17592186312218} :answer-field/id #uuid "5168e7a2-5958-57af-b48a-ff61e1073f47" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314237}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ca876738-9b8d-5832-85d7-2d09df78130a" :question/math-academy-id "q-340272" :question/problem "Given that $f(x)=7-2\\cdot {8}^{x}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(7-2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-\\frac{\\text{d}}{\\text{d}x}(2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-2\\frac{\\text{d}}{\\text{d}x}({8}^{x}) \\\\  & =0-2(ln⁡(8){8}^{x}) \\\\  & =-2ln⁡(8){8}^{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40066746-e699-53ed-82fd-0f35f8e924c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}(5)+4" :db/id #edb/ref 17592186312491} {:answer/id #uuid "8688c450-e972-4ef8-abf7-296b751229f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5^{x}\\ln5-18x^2+4" :db/id #edb/ref 17592186409339}] :answer-field/correct {:db/id #edb/ref 17592186312491} :answer-field/id #uuid "d4ba52fe-3ccd-59f7-bca4-208b03b18375" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314595}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d2b3624c-f62d-5f81-b0de-c13d8e4bf17c" :question/math-academy-id "q-340280" :question/problem "Given that $f(x)={5}^{x}-6{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-6{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-6\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =ln⁡(5)\\cdot {5}^{x}-6(3{x}^{2})+4(1)-0 \\\\  & =ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4)|}_{x=0} \\\\  & =ln⁡(5)\\cdot {5}^{0}-18(0)^{2}+4 \\\\  & =ln⁡(5)\\cdot 1-0+4 \\\\  & =ln⁡(5)+4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b30762e2-6372-5e4a-97b1-6d005cf98ed9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186313368}] :answer-field/correct {:db/id #edb/ref 17592186313368} :answer-field/id #uuid "549368ba-9fa3-52c5-b107-d157358f7c0c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314248}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d01addad-4c74-58d9-88d4-649f6209fd72" :question/math-academy-id "q-340301" :question/problem "For the piecewise function \n\n$$\nf(x)=\\begin{cases}3{e}^{\\,\\,sin(x-1)}\\, & \\text{ for }\\,x<1 \\\\ p{x}^{3}\\, & \\text{ for }\\,x\\ge 1\\end{cases}\n$$\n\nit is known that $\\lim_{x\\to 1}f(x)=3.$ What is the value of the constant $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "In order for $\\lim_{x\\to 1}f(x)$ to be equal to $3,$ the left and right-sided limits must both exist and be equal to $3.$\n\n- Approaching from the left, we have $x<1,$ so we use the expression $f(x)=3{e}^{\\,\\operatorname{sin}⁡(x-1)}.$ We get \n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}f(x) & =\\lim_{x\\to {1}^{-}}3{e}^{\\,\\,sin(x-1)} \\\\  & =3{e}^{\\,\\,sin(1-1)} \\\\  & =3{e}^{\\,\\,sin(0)} \\\\  & =3{e}^{0} \\\\  & =3\\,.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>1,$ so we use the expression $f(x)=p{x}^{3}.$ We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{+}}(p{x}^{3}) \\\\  & =p\\cdot {1}^{3} \\\\  & =p\\,.\\end{aligned}\n$$\n\nFinally, since the left and right-sided limits must be equal, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}f(x) & =\\lim_{x\\to {1}^{-}}f(x) \\\\ p & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbaaae38-fd03-521a-987f-003fe81bd8ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x{sec}^{2}x-\\operatorname{tan}x}{{x}^{2}}" :db/id #edb/ref 17592186313438} {:answer/id #uuid "c9165d35-f202-4d72-b2f0-d01b91122a73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sec^2x-\\tan x}{x^2}" :db/id #edb/ref 17592186673917}] :answer-field/correct {:db/id #edb/ref 17592186313438} :answer-field/id #uuid "444462bc-40fb-5b71-86e8-ac7080c78e9b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314197}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "18258014-36f7-5eab-9f3f-292a9627b048" :question/math-academy-id "q-340308" :question/problem "If $f(x)=\\frac{tan⁡x}{x}$,  find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=tan⁡x$ and $v(x)=x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(tan⁡x)^{′}\\cdot x-tan⁡x\\cdot (x)^{′}}{{x}^{2}} \\\\  & =\\frac{{sec}^{2}⁡x\\cdot x-tan⁡x\\cdot 1}{{x}^{2}} \\\\  & =\\frac{x{sec}^{2}⁡x-tan⁡x}{{x}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43024ff2-7333-5aaf-9591-019e27a3d6e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{sin}x-x\\operatorname{cos}x}{{sin}^{2}x}" :db/id #edb/ref 17592186312509}] :answer-field/correct {:db/id #edb/ref 17592186312509} :answer-field/id #uuid "6587bb6d-addc-5565-8d8b-182baf9e3e12" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314294}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10dcc430-0a77-5b8b-9487-843346dfaa0d" :question/math-academy-id "q-340309" :question/problem "If $f(x)=\\frac{x}{sin⁡x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=x$ and $v(x)=sin⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(x)^{′}\\cdot sin⁡x-x\\cdot (sin⁡x)^{′}}{{(sin⁡x)}^{2}} \\\\  & =\\frac{1\\cdot sin⁡x-x\\cdot cos⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{sin⁡x-xcos⁡x}{{sin}^{2}⁡x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "030817a4-5c86-5a0e-952e-cf5f2fb1ae18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{ln}2" :db/id #edb/ref 17592186311984}] :answer-field/correct {:db/id #edb/ref 17592186311984} :answer-field/id #uuid "99739388-4d18-5c69-8fdc-dc054d584966" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314427}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1df174b4-8cf7-500c-9fc1-5a7ed4adda8f" :question/math-academy-id "q-340316" :question/problem "If a curve $C$ is given by $y=\\frac{{2}^{x}}{{x}^{2}-1},$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nThe slope at $x=0$ is\n{{field-1}}." :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={2}^{x}$ and $v(x)={x}^{2}-1.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{({2}^{x})}^{′}\\cdot ({x}^{2}-1)-{2}^{x}\\cdot {({x}^{2}-1)}^{′}}{{({x}^{2}-1)}^{2}} \\\\  & =\\frac{{2}^{x}ln⁡2\\cdot ({x}^{2}-1)-{2}^{x}\\cdot 2x}{{({x}^{2}-1)}^{2}} \\\\  & =\\frac{{2}^{x}[({x}^{2}-1)ln⁡2-2x]}{{({x}^{2}-1)}^{2}}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}\\,(0) & =\\frac{{2}^{0}[({0}^{2}-1)ln⁡2-2(0)]}{{({0}^{2}-1)}^{2}} \\\\  & =\\frac{-ln⁡2}{1} \\\\  & =-ln⁡2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at $x=0$ is $-ln⁡2.$"} {:db/id #edb/ref 17592186314932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cadf6e0-479a-5eb1-bed6-41de67fcde17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{csc}x\\operatorname{cot}x" :db/id #edb/ref 17592186312190}] :answer-field/correct {:db/id #edb/ref 17592186312190} :answer-field/id #uuid "5e19e32f-4d6c-5aaa-8114-0d5626382a44" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314273}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "23fd6f2c-8994-5050-a37a-61410033ca13" :question/math-academy-id "q-340335" :question/problem "Given that $f(x)=\\frac{1-sin⁡x}{sin⁡x},$ find ${f}^{′}(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u=1-sin⁡x$ and $v=sin⁡x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-cos⁡x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{sin⁡x\\cdot (-cos⁡x)-(1-sin⁡x)\\cdot cos⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{cos⁡x(-sin⁡x-1+sin⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{cos⁡x\\cdot (-1)}{{sin}^{2}⁡x} \\\\  & =-\\frac{1}{sin⁡x}\\cdot \\frac{cos⁡x}{sin⁡x} \\\\  & =-csc⁡xcot⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d58cd28-0b2e-5dc6-8d9f-4ed89ec4aa5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}x+x\\operatorname{sin}x" :db/id #edb/ref 17592186312472}] :answer-field/correct {:db/id #edb/ref 17592186312472} :answer-field/id #uuid "db75a262-e72e-5fe8-a7c4-cd5620e1e8e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314620}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86ab750e-4dae-544c-82a8-041d54807290" :question/math-academy-id "q-340337" :question/problem "Given that $y=\\frac{x}{cos⁡x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{cos}^{2}⁡x}\\cdot (\n$$\n{{field-1}}\n$).$" :question/worked-solution "Let $u=x$ and $v=cos⁡x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-sin⁡x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{cos⁡x\\cdot 1-x\\cdot (-sin⁡x)}{{cos}^{2}⁡x} \\\\  & =\\frac{1}{{cos}^{2}⁡x}\\cdot (cos⁡x+xsin⁡x\\,).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1e08605-30ac-5180-b993-bb8905dcf80f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}x-1}{(\\operatorname{ln}x)^{2}}" :db/id #edb/ref 17592186313247}] :answer-field/correct {:db/id #edb/ref 17592186313247} :answer-field/id #uuid "d0021a41-de95-5d7c-9f18-7f5e0c873094" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314583}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c69eee29-5e7a-522d-bfc9-641f3d5d4893" :question/math-academy-id "q-340341" :question/problem "Given that $y=\\frac{x}{ln⁡x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u=x$ and $v=ln⁡x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(ln⁡x\\cdot 1-x\\cdot \\frac{1}{x})}{{(ln⁡x)}^{2}} \\\\  & =\\frac{ln⁡x-1}{{(ln⁡x)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe403dd4-e8fc-5b37-a657-5cdb8ad41fe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-2\\operatorname{ln}x" :db/id #edb/ref 17592186314003}] :answer-field/correct {:db/id #edb/ref 17592186314003} :answer-field/id #uuid "392caec0-4bec-552a-a683-fe5f52bda24d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314167}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4ac3d430-ffd8-5d49-8cb6-f41434a00666" :question/math-academy-id "q-340343" :question/problem "Given that $y=\\frac{{log}_{3}⁡x}{{x}^{2}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=($\n{{field-1}}\n$)\\cdot \\frac{1}{{x}^{3}ln⁡3}$" :question/worked-solution "Let $u={log}_{3}⁡x=\\frac{ln⁡x}{ln⁡3}$ and $v={x}^{2}.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =\\frac{1}{xln⁡3}\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{({x}^{2}\\cdot \\frac{1}{xln⁡3}-\\frac{ln⁡x}{ln⁡3}\\cdot 2x)}{({x}^{2})^{2}} \\\\  & =\\frac{(\\frac{x}{ln⁡3}-\\frac{2xln⁡x}{ln⁡3})}{{x}^{4}} \\\\  & =\\frac{x-2xln⁡x}{{x}^{4}ln⁡3} \\\\  & =\\frac{x(1-2ln⁡x)}{{x}^{4}ln⁡3} \\\\  & =\\frac{1-2ln⁡x}{{x}^{3}ln⁡3} \\\\  & =(\\,1-2ln⁡x\\,)\\cdot \\frac{1}{{x}^{3}ln⁡3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c51051a6-39a4-5d3d-8f84-11efa084f10e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{2}+\\frac{1}{2}" :db/id #edb/ref 17592186313521}] :answer-field/correct {:db/id #edb/ref 17592186313521} :answer-field/id #uuid "618ea825-b730-590f-be99-2b4638c41dba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314282}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e5793e05-ded5-5153-bb6f-74c424b138c4" :question/math-academy-id "q-340441" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}(x-\\frac{2}{1+{x}^{2}})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(x-\\frac{2}{1+{x}^{2}})\\,\\text{d}x & ={\\int }_{0}^{1}x\\,\\text{d}x-2{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{x}^{2}\\,{|}_{0}^{1}+2\\,\\text{arccot}\\,x\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2}({1}^{2}-{0}^{2})+2(\\text{arccot}(1)-\\text{arccot}(0)) \\\\  & =\\frac{1}{2}+2(\\frac{\\pi }{4}-\\frac{\\pi }{2}) \\\\  & =-\\frac{\\pi }{2}+\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "970e1936-ac2b-534a-8ed4-97d799d35e63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186313177}] :answer-field/correct {:db/id #edb/ref 17592186313177} :answer-field/id #uuid "f6a75775-f14f-5a3f-b4e1-1d6d0f134ccc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314681}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8caad42a-7778-5faa-ba43-6f75823507a3" :question/math-academy-id "q-340497" :question/problem "Find the slope $m$ of the tangent to the curve $y=-4{e}^{2-x}$ at the point where $x=2-ln⁡(3).$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u},\\,u=2-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot (-1) \\\\  & =4{e}^{u} \\\\  & =4{e}^{2-x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=2-ln⁡(3)$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows\n\n$$\n\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}{|}_{x=2-ln⁡(3)} & =4{e}^{2-(2-ln⁡(3))} \\\\  & =4{e}^{ln⁡(3)} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0565c9a1-3267-5c8e-9342-8d4792792693" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "47" :db/id #edb/ref 17592186312010} {:answer/id #uuid "30337cd4-b663-516c-812c-f06d183d5cf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "44" :db/id #edb/ref 17592186312364} {:answer/id #uuid "94928d5f-97ee-5b8d-89ac-d044f0019c17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52" :db/id #edb/ref 17592186313167} {:answer/id #uuid "af9c85d6-087e-5c2a-b134-ecf511b1d930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "38" :db/id #edb/ref 17592186313344} {:answer/id #uuid "e3d77545-249a-5fbd-a02a-be4c5c92046d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186313773}] :answer-field/correct {:db/id #edb/ref 17592186312364} :answer-field/id #uuid "9d647f9e-721a-5afb-a7d1-b8fcf37b997b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314438}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3cd19394-53ef-5fb8-bd17-0eb0faf26bf7" :question/math-academy-id "q-340560" :question/problem "The rate at which the price of a particular product changes $P(t),$ after $t$ years, is given by the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=0.042P.\n$$\n\nIf the price today is $\\$120,$ how many years will it take for the price to increase to $\\$750?$\nRound your answer to the nearest year." :question/worked-solution "We model the price growth using the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=0.042P.\n$$\n\nThe solution to this equation is\n\n$$\nP(t)={P}_{0}\\,{e}^{0.042t},\n$$\n\nwhere ${P}_{0}$ is the initial value.\n\nWe're told that the price today is $\\$120,$ so we have ${P}_{0}=120.$\n\nTherefore, the price $P$ of the product after $t$ years is\n\n$$\nP(t)=120\\,{e}^{0.042t}\\,.\n$$\n\nTo find how many years it takes for the price to grow to $\\$750,$ we substitute $P(t)=750$ into the equation above and solve for $t,$ as follows:\n\n$$\n\\displaystyle \n\\begin{aligned}750 & =120\\,{e}^{0.042t} \\\\ \\frac{750}{120} & ={e}^{0.042t} \\\\ {e}^{0.042t} & =\\frac{25}{4} \\\\ \\operatorname{ln}⁡({e}^{0.042t}) & =ln\\,\\left(\\frac{25}{4}\\right) \\\\ 0.042t & =ln\\,\\left(\\frac{25}{4}\\right) \\\\ t & =\\frac{1}{0.042}ln\\,\\left(\\frac{25}{4}\\right) \\\\ t & ≈43.633\\end{aligned}\n\n$$\n\nRounding to the nearest integer, we conclude that it takes $44$ years for the price to increase to $\\$750.$"} {:db/id #edb/ref 17592186314973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b34c416-57fc-58ea-9d79-6823aeb070fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{csc}(x)}{x}-\\operatorname{ln}(x)\\operatorname{csc}(x)\\operatorname{cot}(x)" :db/id #edb/ref 17592186312703} {:answer/id #uuid "e40f4d4c-ab95-49a7-a265-aed1a305aa2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\csc x}{x}-\\csc x\\cot x\\ln x" :db/id #edb/ref 17592186674127}] :answer-field/correct {:db/id #edb/ref 17592186312703} :answer-field/id #uuid "1796b8ee-d2f7-5e22-9787-083c3b5ddf1b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b3a61332-223a-5fc8-8ea7-10ae847de63a" :question/math-academy-id "q-340582" :question/problem "Find ${h}^{′}(x)$ if $h(x)=ln⁡(x)csc⁡(x).$\n\n${h}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡(x)csc⁡(x)) \\\\  & =\\frac{1}{x}(csc⁡x)+(ln⁡(x))(-csc⁡(x)cot⁡(x)) \\\\  & =\\frac{csc⁡(x)}{x}-ln⁡(x)csc⁡(x)cot⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf4c902-f4f0-5e66-8a96-dff670ee7f7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}+3{csc}^{2}(x)" :db/id #edb/ref 17592186313873} {:answer/id #uuid "37c0f6b5-d756-4b09-a51f-240c726f1bcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{x}-3\\csc^2x" :db/id #edb/ref 17592186674130}] :answer-field/correct {:db/id #edb/ref 17592186313873} :answer-field/id #uuid "5a999c3f-682e-5c0e-a6ed-d84ccc7c3d5d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314265}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc3f29f8-f5c9-5816-a926-df2d0b5bf36c" :question/math-academy-id "q-340595" :question/problem "Find ${g}^{′}(x)$ for $g(x)={e}^{x}-3cot⁡(x).$\n\n${g}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}-3cot⁡(x)) \\\\  & ={e}^{x}-3(-{csc}^{2}⁡(x)) \\\\  & ={e}^{x}+3{csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e7edecf-22c1-57ae-b9db-577c0bc42b57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{cot}(x)}{x}" :db/id #edb/ref 17592186312992} {:answer/id #uuid "32d2c818-2da6-4950-824b-ab0db385afcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\cot x}{x}-\\ln x\\csc^2x" :db/id #edb/ref 17592186674132}] :answer-field/correct {:db/id #edb/ref 17592186312992} :answer-field/id #uuid "61d877e6-8bc9-5db8-855a-3075f76bd9a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314284}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "692c831b-b188-57f9-8d8a-25236044469a" :question/math-academy-id "q-340597" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}} $-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x)) \\\\  & =\\frac{1}{x}\\cdot \\operatorname{cot}⁡(x)+\\operatorname{ln}⁡(x)(-{csc}^{2}⁡(x)) \\\\  & =\\frac{\\operatorname{cot}⁡(x)}{x}-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56c1968-5cfb-5078-ac6d-1fb92ae0c8a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{csc}^{2}(x)" :db/id #edb/ref 17592186313276}] :answer-field/correct {:db/id #edb/ref 17592186313276} :answer-field/id #uuid "d98aad80-5c8a-5e64-afd9-dd37c9c06f08" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314612}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0fe74bab-fbda-57cd-8d62-b0fe7ee7ec0e" :question/math-academy-id "q-340598" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=x\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{cot}⁡(x)\\,-$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}⁡(x)) \\\\  & =1\\operatorname{cot}⁡(x)+x(-{csc}^{2}⁡(x)) \\\\  & =\\operatorname{cot}⁡(x)-x{csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d72bf0eb-ad62-5881-9084-66b56ea503b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{ln}(x)" :db/id #edb/ref 17592186313672}] :answer-field/correct {:db/id #edb/ref 17592186313672} :answer-field/id #uuid "e5eea6c3-db40-505b-9e0d-14232418925e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314641}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8691b6d-0ecf-5d21-b2f3-79779cf5dbfe" :question/math-academy-id "q-340599" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{ln⁡(x)}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+{csc}^{2}⁡(x)\\,\\cdot ${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | $x{cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,\\left(\\frac{ln⁡(x)}{cot⁡(x)}\\right) \\\\  & =\\frac{cot⁡(x)\\cdot \\frac{1}{x}-ln⁡(x)(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{\\left(\\frac{cot⁡(x)+xln⁡(x){csc}^{2}⁡(x)}{x}\\right)}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+{csc}^{2}⁡(x)\\cdot xln⁡(x)}{x{cot}^{2}⁡(x)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a88a36db-5e45-548d-8bfc-2a65d42b2b2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{csc}^{2}(x)" :db/id #edb/ref 17592186313297}] :answer-field/correct {:db/id #edb/ref 17592186313297} :answer-field/id #uuid "7bb36ddb-0276-5ac3-89fe-420e530a39fb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314339}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e33e2c96-5cc5-507d-8909-c27b983d8b76" :question/math-academy-id "q-340603" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{x}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | ${cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{x}{cot⁡(x)}\\right) \\\\  & =\\frac{1(cot⁡(x))-x(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+x{csc}^{2}⁡(x)}{{cot}^{2}⁡(x)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddf204d8-e22c-51c6-8fc3-35b6c7b7645b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{tan}(x)" :db/id #edb/ref 17592186313721}] :answer-field/correct {:db/id #edb/ref 17592186313721} :answer-field/id #uuid "b7dd68d5-5e9b-5e20-afa9-1cf870f43426" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314510}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cc86df7a-ccb0-5d8a-9c1d-7584dfc21d9f" :question/math-academy-id "q-340611" :question/problem "Find the derivative of $y={e}^{x}sec⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}={e}^{x}sec⁡(x)($\n{{field-1}}\n$)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}sec⁡(x)) \\\\  & ={e}^{x}sec⁡(x)+{e}^{x}sec⁡(x)tan⁡(x) \\\\  & ={e}^{x}sec⁡(x)(1+tan⁡(x))\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42958185-7df3-56a0-9626-eed54c7f99ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186312504}] :answer-field/correct {:db/id #edb/ref 17592186312504} :answer-field/id #uuid "65f1890c-928c-56f6-8eb3-b4f4e9dc83d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186314295}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e573d90a-bd1d-5d85-a1c8-ca191df5266e" :question/math-academy-id "q-340620" :question/problem "Find the derivative of $y=4sec⁡x+{e}^{x}$ at $x=0.$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{0}=$\n{{field-1}}" :question/worked-solution "First, we take the derivative of each term and then add them:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(4sec⁡x+{e}^{x}) \\\\  & =4sec⁡xtan⁡x+{e}^{x}\\end{aligned}\n$$\n\nThen, we substitute $x=0$:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=0} & =(4sec⁡xtan⁡x+{e}^{x})\\,{|}_{x=0} \\\\  & =4sec⁡(0)tan⁡(0)+{e}^{0} \\\\  & =4\\cdot 1\\cdot 0+1 \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027eecbf-7d9e-56b4-a605-18bbb53e14b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186311977} {:answer/id #uuid "4494fa18-4bec-52af-830e-3d47e3335b32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186312528} {:answer/id #uuid "9649e93c-dcb4-5673-af2c-491163f8d92d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186313174} {:answer/id #uuid "d90019b4-a024-5ea2-b7e9-d632c152b387" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186313682} {:answer/id #uuid "e664ec95-b5dd-5b08-ac1e-628c8f111a90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186313800}] :answer-field/correct {:db/id #edb/ref 17592186313174} :answer-field/id #uuid "271f0e63-bff4-53c7-a28b-a628905d21bb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314113} {:answer-field/choices [{:answer/id #uuid "084986f6-01c0-508d-b7b2-e49ecf7afbf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186312035} {:answer/id #uuid "1b9be0ef-0626-58f6-8f34-f07d2341cc36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186312179} {:answer/id #uuid "1ee209f2-de18-556a-b781-2693cbbb09b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186312209} {:answer/id #uuid "4c486615-805d-5bc0-8681-1ee3c3e17ff9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186312592} {:answer/id #uuid "9a09cad1-8a04-5089-8601-85ab90a53a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186313194} {:answer/id #uuid "e661e1e8-358c-5402-8b71-9182bd7c2769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186313799}] :answer-field/correct {:db/id #edb/ref 17592186312035} :answer-field/id #uuid "3dd294ec-abdf-52bd-adbb-82925e22c66c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314178} {:answer-field/choices [{:answer/id #uuid "2adde187-25b8-5d4b-a204-1561619be2dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩}{⟨f(x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186312303} {:answer/id #uuid "44b54432-6be2-557b-86a3-52063866fc0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186312530} {:answer/id #uuid "91d08667-08e2-52ae-8373-62b7feb36f57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩}{⟨f(x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186313142} {:answer/id #uuid "b45c048e-2b73-557d-9a93-c538814c0f85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩}" :db/id #edb/ref 17592186313379} {:answer/id #uuid "c2c63573-93e1-5481-abea-0476f7532355" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(3x)⟩}{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩}" :db/id #edb/ref 17592186313501}] :answer-field/correct {:db/id #edb/ref 17592186312530} :answer-field/id #uuid "48c5f513-5509-5ed5-bf44-fe4e4be503ff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "189f6686-0cc6-5c02-8e21-1097f02fd5af" :question/math-academy-id "q-340628" :question/problem "Let $F(x)={x}^{2}+3$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{3}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{a}_{3} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that is piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(3x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(3x)⟩ &= ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(3x)⟩ \\\\ &= ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(3x)⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(3x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{3}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩ & ={\\int }_{-\\pi }^{\\pi }{cos}^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))+\\frac{1}{12}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(-6\\pi )) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(3x)⟩ & ={a}_{3}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩ \\\\ {a}_{3} & =\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩} \\\\ {a}_{3} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fed8a6-dde9-59a6-bc31-184c4876910c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186312040} {:answer/id #uuid "27e0630f-6397-5f50-acaf-792c1ed4a63f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186312279} {:answer/id #uuid "43aed6aa-dcf1-5ad7-a81d-0980770c21f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186312518} {:answer/id #uuid "7f4f1e1b-19ff-53ba-846a-bf53f48da618" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186312998} {:answer/id #uuid "c3b040b0-f184-56be-ac1d-d88fac453333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186313