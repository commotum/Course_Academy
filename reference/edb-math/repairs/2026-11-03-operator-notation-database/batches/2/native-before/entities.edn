 :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186334757}] :answer-field/correct {:db/id #edb/ref 17592186333069} :answer-field/id #uuid "0bb69352-4149-593c-bc7d-4e7284e4e477" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335259}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e18d5a8-08c4-5591-8e9a-7f22a6b8acbe" :question/math-academy-id "q-64661" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows: \n\n$$\n\\begin{aligned}{r}^{′}(t)=-2\\operatorname{sin}⁡2t\\,i+2\\,j-2\\operatorname{cos}⁡2t\\,k,\\,{T}^{′}(t)=-\\sqrt{2}\\operatorname{cos}⁡2t\\,i+\\sqrt{2}\\operatorname{sin}⁡2t\\,k\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${r}^{′}(t)$ and ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\sqrt{{(-\\sqrt{2}\\operatorname{cos}⁡2t)}^{2}+{(0)}^{2}+{(\\sqrt{2}\\operatorname{sin}⁡2t)}^{2}} \\\\  & =\\sqrt{2({cos}^{2}⁡2t+{sin}^{2}⁡2t)} \\\\  & =\\sqrt{2} \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(-2\\operatorname{sin}⁡2t)^{2}+{2}^{2}+(-2\\operatorname{cos}⁡2t)^{2}} \\\\  & =\\sqrt{4({sin}^{2}⁡2t+{cos}^{2}⁡2t)+4} \\\\  & =\\sqrt{4\\cdot 2} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\nHence, the curvature is \n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{\\sqrt{2}}{2\\sqrt{2}}=\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37af32ac-6d56-59b7-af88-a83bd549c119" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186333502} {:answer/id #uuid "89b6e43c-5175-58b9-a703-c4d3bd3ea434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186334213} {:answer/id #uuid "ec91d17d-8a59-5d87-b344-af638420e8b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186335062} {:answer/id #uuid "f164ca79-a714-5ace-a91e-f41a09d97456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186335104} {:answer/id #uuid "fd455317-5a16-56c0-bbb9-11acb365385d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186335216}] :answer-field/correct {:db/id #edb/ref 17592186335062} :answer-field/id #uuid "91f964f4-328c-5d44-bbab-649563165d63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335517}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe9f4359-a5d3-51ab-bfaf-67dd4916cffb" :question/math-academy-id "q-64666" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows: \n\n$$\n\\begin{aligned}{r}^{′}(t)=\\operatorname{sin}⁡t\\,i+\\sqrt{3}\\,j+\\operatorname{cos}⁡t\\,k,\\,{T}^{′}(t)=\\frac{\\operatorname{cos}⁡t}{2}\\,i-\\frac{\\operatorname{sin}⁡t}{2}\\,k\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${r}^{′}(t)$ and ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\operatorname{cos}⁡t}{2}\\right)}^{2}+{(0)}^{2}+{\\left(\\frac{-\\operatorname{sin}⁡t}{2}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{1}{4}({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\frac{1}{2} \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(\\operatorname{sin}⁡t)^{2}+(\\sqrt{3})^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{({sin}^{2}⁡t+{cos}^{2}⁡t)+3} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nHence, the curvature is \n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{\\left(\\frac{1}{2}\\right)}{2}=\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0654fbb0-4464-57df-b997-793b4d140585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186333048} {:answer/id #uuid "5118678c-2f8f-5690-b6fc-bf8555ce98e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186333728} {:answer/id #uuid "7651226e-fce4-5b52-bc1a-76607be7511d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{10}" :db/id #edb/ref 17592186334058} {:answer/id #uuid "7c4a2192-9402-508c-9568-f3777b5cf2c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{9}" :db/id #edb/ref 17592186334100} {:answer/id #uuid "a9569df6-5bae-5e8a-824f-b880322a1e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{\\sqrt{10}}" :db/id #edb/ref 17592186334472}] :answer-field/correct {:db/id #edb/ref 17592186333728} :answer-field/id #uuid "25483b54-8d2f-5ef1-a991-a9c7271a8af6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335308}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b6d968e1-179a-5b9e-896d-829a90d9d8fc" :question/math-academy-id "q-64680" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)=⟨\\,\\operatorname{sin}⁡3t,\\,\\operatorname{cos}⁡3t,\\,t⟩.$" :question/worked-solution "Let $T(t)$ denote the unit tangent to the given curve as a function of the parameter $t.$ Since we are given the curve $r(t)$ parametrized by the parameter $t$ (not the arc length $s$), we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we calculate ${r}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨3\\operatorname{cos}⁡3t,\\,-3\\operatorname{sin}⁡3t,\\,1⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3\\operatorname{cos}⁡3t)}^{2}+{(-3\\operatorname{sin}⁡3t)}^{2}+{(1)}^{2}} \\\\  & =\\sqrt{9({cos}^{2}⁡(3t)+{sin}^{2}⁡(3t))+1} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nHence, the corresponding unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{\\sqrt{10}}⟨3\\operatorname{cos}⁡3t,\\,-3\\operatorname{sin}⁡3t,\\,1⟩.\\end{aligned}\n$$\n\nNext, we calculate ${T}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{10}}⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(-3\\operatorname{sin}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(1)⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨-9\\operatorname{sin}⁡3t,\\,-9\\operatorname{cos}⁡3t,\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{10}}\\sqrt{(9\\operatorname{sin}⁡3t)^{2}+(-9\\operatorname{cos}⁡t)^{2}+{0}^{2}} \\\\  & =\\frac{1}{\\sqrt{10}}\\sqrt{{9}^{2}({sin}^{2}⁡3t+{cos}^{2}⁡3t)} \\\\  & =\\frac{9}{\\sqrt{10}}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{\\,\\frac{9}{\\sqrt{10}}\\,}{\\sqrt{10}}=\\frac{9}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d900898-f644-59cb-8bd9-292f8cf96161" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186333108} {:answer/id #uuid "128843bf-c0d0-5b0b-9af7-5c0891c02535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186333155} {:answer/id #uuid "867d9b75-2324-5dfe-830f-942376886bea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186334183} {:answer/id #uuid "de2d463a-06e0-5a98-b913-8a3a09131403" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186334926} {:answer/id #uuid "f58082e0-41ed-5179-bfb1-b391fbd71bba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186335143}] :answer-field/correct {:db/id #edb/ref 17592186334183} :answer-field/id #uuid "b4eb5247-b68b-5a82-8180-4c0ffe3de0aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335575}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9c7086f-08af-5d07-8de2-8cc3da9eb077" :question/math-academy-id "q-64681" :question/problem "![](images/94/94b8650466747f6858b30adbb8962e6c91159466b570f536d4999e2b08c31b67.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{1}{2},$ use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta .$" :question/worked-solution "![](images/cb/cb569d4b7b76699259d2167b8c930e636e3fb794b14ef25a4d909c224235d7c3.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{1}{2}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{1}{2}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{1}{2}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So our final answer is $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{3}}{2}.$"} {:db/id #edb/ref 17592186335738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07056c3e-506d-5641-9888-b4b318e25eff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186333058} {:answer/id #uuid "a034f5c0-3b14-5e29-8def-edc95efbd80e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186334397} {:answer/id #uuid "cb74b243-d73b-5089-bae4-f981f0a60cd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186334760} {:answer/id #uuid "d2ffa90f-9b1f-53a0-9ae4-72f9fe2ebb09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186334836} {:answer/id #uuid "d8504233-ad25-5121-8f69-909d3fab6b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186334884}] :answer-field/correct {:db/id #edb/ref 17592186333058} :answer-field/id #uuid "2b238c5f-814a-5a46-a972-3a25a21b520c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335319}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8585ed26-d09c-5c8e-84bf-c2d2c03840ec" :question/math-academy-id "q-64730" :question/problem "![](images/2f/2f01b946a5c7c0f93c2171379603c4426913af5a15d0bc03434785144cfe4102.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{2}}{2},$ what is $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "Any point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{2}}{2}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{2}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{2}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{2}{4}} \\\\  & =\\pm \\sqrt{\\frac{2}{4}} \\\\  & =\\pm \\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. Therefore $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{2}}{2}.$\n\nUsing the fact that $$\n\\displaystyle \\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },\n$$ we finally get\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\left(\\frac{\\sqrt{2}}{2}\\right)}{\\left(\\frac{\\sqrt{2}}{2}\\right)}=1.\n$$"} {:db/id #edb/ref 17592186335739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "369d7dc4-1f2c-58c7-8955-91cabe185acd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186333492} {:answer/id #uuid "6cbb8b9b-d6a9-5997-bce5-90424ff1180f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186333979} {:answer/id #uuid "b24b6fea-adc3-54a3-94dd-ad481dc00180" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186334555} {:answer/id #uuid "e0405203-826a-52d8-8a79-dcf3a04354bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186334940} {:answer/id #uuid "fa731375-053c-5708-bf47-16a574de2b6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186335183}] :answer-field/correct {:db/id #edb/ref 17592186333492} :answer-field/id #uuid "9bc84e1e-1ce0-5ed5-b29d-dc063985cbbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335527}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a6d0a779-de60-5fed-8e29-8de76943c6c3" :question/math-academy-id "q-64732" :question/problem "Consider a curve $r(s)$ parametrized by its arc length $s.$ Find the radius of curvature of $r(s)$ at an arbitrary point knowing that  its  unit tangent vector $T(s)$ is given by\n\n$$\n\\begin{aligned}T(s) & =\\frac{2}{3}\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right)\\,i+\\frac{2}{3}\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right)\\,j+\\frac{\\sqrt{5}}{3}\\,k\\,.\\end{aligned}\n$$" :question/worked-solution "Since the curve $r(s)$ and its unit tangent vector $T(s)$ are both parametrized by arc length $s$, we will use the following formula for the radius of curvature: \n\n$$\nR(s)=\\frac{1}{κ(s)}=\\frac{1}{‖{T}^{′}(s)‖}\n$$\n\nWe differentiate $T(s)$ with respect to $s$ and calculate its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{2}{3}\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right))i+\\frac{\\text{d}}{\\text{d}s}(\\frac{2}{3}\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right))\\,j+\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{\\sqrt{5}}{3}\\right)k \\\\  & =\\frac{2}{3}\\cdot \\frac{1}{3}(-\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right))\\,i+\\frac{2}{3}\\cdot \\frac{1}{3}\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right)\\,j+0\\,k \\\\  & =-\\frac{2}{9}\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right)\\,i+\\frac{2}{9}\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right)\\,j \\\\  & =\\frac{2}{9}[-\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right)\\,i+\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right)\\,j] \\\\ ‖{T}^{′}(s)‖ & =\\frac{2}{9}\\sqrt{{(-\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right))}^{2}+{(\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right))}^{2}+{0}^{2}} \\\\  & =\\frac{2}{9}\\sqrt{{sin}^{2}⁡\\left(\\frac{s}{3}\\right)+{cos}^{2}⁡\\left(\\frac{s}{3}\\right)} \\\\  & =\\frac{2}{9}\\end{aligned}\n$$\n\nTherefore, the radius of curvature is\n\n$$\nR(s)=\\frac{1}{‖{T}^{′}(s)‖}=\\frac{1}{\\left(\\frac{2}{9}\\right)}=\\frac{9}{2}.\n$$"} {:db/id #edb/ref 17592186335740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13837c57-fcf6-59ed-a939-a470108db450" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{8}" :db/id #edb/ref 17592186333161} {:answer/id #uuid "66df2533-6415-54e6-aecd-02e34294c2d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186333928} {:answer/id #uuid "9199da41-115a-549a-926f-7560fc8fae17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186334288} {:answer/id #uuid "af3ba4c9-eaee-5458-a599-2c97ee46fb5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186334534} {:answer/id #uuid "e32c6e4d-94ff-5ce6-869c-2bf3aead8861" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186334966}] :answer-field/correct {:db/id #edb/ref 17592186333161} :answer-field/id #uuid "1ac7cd9a-bd4e-577f-9519-5227a1ee21af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335288}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85d6e3bb-1239-5725-994c-6f104c6ddc40" :question/math-academy-id "q-64738" :question/problem "Consider a curve $r(s)$ parametrized by its arc length $s.$ Find the radius of curvature of $r(s)$ at an arbitrary point knowing that  its  unit tangent vector $T(s)$ is given by\n\n$$\n\\begin{aligned}T(s) & =⟨-\\frac{4}{5}\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right),\\,-\\frac{4}{5}\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right),\\,\\frac{3}{5}⟩\\,.\\end{aligned}\n$$" :question/worked-solution "Since the curve $r(s)$ and its unit tangent vector $T(s)$ are both parametrized by arc length $s$, we will use the following formula for the radius of curvature: \n\n$$\nR(s)=\\frac{1}{κ(s)}=\\frac{1}{‖{T}^{′}(s)‖}\n$$\n\nWe differentiate $T(s)$ with respect to $s$ and calculate its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-\\frac{4}{5}\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right)),\\,\\frac{\\text{d}}{\\text{d}s}(-\\frac{4}{5}\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right)),\\,\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{3}{5}\\right)⟩ \\\\  & =⟨-\\frac{4}{5}\\cdot \\frac{2}{5}\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right),\\,-\\frac{4}{5}(-\\frac{2}{5}\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right)),\\,0⟩ \\\\  & =⟨-\\frac{8}{25}\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right),\\,\\frac{8}{25}\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right),\\,0⟩ \\\\  & =\\frac{8}{25}⟨-\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right),\\,\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right),\\,0⟩ \\\\ ‖{T}^{′}(s)‖ & =\\frac{8}{25}\\sqrt{{(-\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right))}^{2}+{(\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right))}^{2}+{0}^{2}} \\\\  & =\\frac{8}{25}\\sqrt{{cos}^{2}⁡\\left(\\frac{2s}{5}\\right)+{sin}^{2}⁡\\left(\\frac{2s}{5}\\right)} \\\\  & =\\frac{8}{25}\\end{aligned}\n$$\n\nTherefore, the radius of curvature is\n\n$$\nR(s)=\\frac{1}{‖{T}^{′}(s)‖}=\\frac{1}{\\left(\\frac{8}{25}\\right)}=\\frac{25}{8}.\n$$"} {:db/id #edb/ref 17592186335760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155240ed-b9db-579f-ab22-372d1f686c54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186333177} {:answer/id #uuid "8ac6a5af-621c-5fc1-83e6-d810a1b8fd72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186334228} {:answer/id #uuid "a0f42eda-7341-5b4a-8a81-9b99656d9cd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186334404} {:answer/id #uuid "a80bfe5b-2289-5bc8-919e-983b37d1860f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186334461} {:answer/id #uuid "d6c3a04e-0d1e-549c-9ae2-2766e69b833a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186334872}] :answer-field/correct {:db/id #edb/ref 17592186334461} :answer-field/id #uuid "f335d016-ffab-5819-9d0a-5584dccaed71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335665}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0705b0fd-1e5b-500a-be13-4effb64c89dc" :question/math-academy-id "q-64900" :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})=2{cos}^{2}⁡x$ and $L({y}_{2})={sin}^{2}⁡x+4$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L({y}_{1}+2{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L({y}_{1}+2{y}_{2}) & =L({y}_{1})+2L({y}_{2}) \\\\  & =2{cos}^{2}⁡x+2\\cdot ({sin}^{2}⁡x+4) \\\\  & =2{cos}^{2}⁡x+2{sin}^{2}⁡x+8 \\\\  & =2({cos}^{2}⁡x+{sin}^{2}⁡x)+8 \\\\  & =2+8 \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159bd76d-aabf-5059-a127-408d2989f0bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186333182} {:answer/id #uuid "3789cd72-89a6-5e2f-9492-d7d751156542" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186333500} {:answer/id #uuid "8a31df51-1d7c-5c28-b360-dd1de5d8eca0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186334222} {:answer/id #uuid "9424ba9f-fb60-5bfc-bff0-89eec5a0bbb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186334309} {:answer/id #uuid "ac9fdbb5-b41a-5bc4-9f39-5f38dcbfbb58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186334505}] :answer-field/correct {:db/id #edb/ref 17592186334222} :answer-field/id #uuid "f148a5e1-b96d-5dcb-b87b-4d3a4113df1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335658}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0d34a3ba-689d-51af-888e-1a275d337823" :question/math-academy-id "q-64927" :question/problem "$cos⁡\\left(\\frac{11\\pi }{6}\\right)=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{11\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $$\n\\displaystyle cos⁡\\left(\\frac{11\\pi }{6}\\right)=\\frac{\\sqrt{3}}{2}.\n$$"} {:db/id #edb/ref 17592186335767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c75b77b-2b6b-52fc-89c4-5843ba9a391c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x-3" :db/id #edb/ref 17592186333098} {:answer/id #uuid "27801101-f207-5d15-8cb5-bee66e81094f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x+3" :db/id #edb/ref 17592186333351} {:answer/id #uuid "380a9d36-abf6-5b29-88f3-d7cad5d28ee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3sin⁡x" :db/id #edb/ref 17592186333505} {:answer/id #uuid "5da83864-3301-5aa4-a2ba-14e628be13d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-sin⁡x" :db/id #edb/ref 17592186333847} {:answer/id #uuid "6fc79e18-5e61-51c6-846a-88077db37154" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3sin⁡x" :db/id #edb/ref 17592186334008}] :answer-field/correct {:db/id #edb/ref 17592186334008} :answer-field/id #uuid "b6faf084-f3b1-5b16-ae31-a48d75784b52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335579}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3bc22e78-d1ed-569d-b43b-75210f4f820f" :question/math-academy-id "q-6496" :question/problem "![](images/0d/0dc58f26b27ab7ebf398995e46cf02142aa0c9c2f23aa2a91cb5e179c74a0cf3.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/0d/0d0a34d12bdf2318475e973d0151a0d6cb18c691949a209b11d3e725bdf58aa5.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $3$ to give $y=-3sin⁡x$\n\nTherefore, the given curve is the graph of $y=-3sin⁡x.$"} {:db/id #edb/ref 17592186335772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b05fec-223c-56bf-846e-c1dd3e529fc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{2}(x)=x\\operatorname{cos}⁡3x" :db/id #edb/ref 17592186333147} {:answer/id #uuid "4316fb3b-4ead-50d9-b393-d3a3f73206fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{2}(x)=\\operatorname{cos}⁡3x" :db/id #edb/ref 17592186333614} {:answer/id #uuid "5dafac36-0012-58ad-9ae8-980b43b4e78d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{2}(x)=\\operatorname{tan}⁡3x" :db/id #edb/ref 17592186333848} {:answer/id #uuid "8e74c3fb-c1c2-53e1-980d-f0ad20d22a8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{2}(x)=\\operatorname{csc}⁡3x" :db/id #edb/ref 17592186334261} {:answer/id #uuid "c6b9be1d-865a-5c53-a7cd-250bdaf0a6b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}_{2}(x)=x\\operatorname{sin}⁡3x" :db/id #edb/ref 17592186334716}] :answer-field/correct {:db/id #edb/ref 17592186333614} :answer-field/id #uuid "c83a3c69-9ddf-5684-bac6-3760d114ab07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335606}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "afb025b0-c527-5d33-8970-81ceec1a4be4" :question/math-academy-id "q-64998" :question/problem "Given that ${y}_{1}(x)=\\operatorname{sin}⁡3x$ is a solution to the equation ${y}^{″}+9y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(x)\\operatorname{sin}⁡3x.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}\\operatorname{sin}⁡3x+3u\\operatorname{cos}⁡3x \\\\ {y}_{2}^{″} & ={u}^{″}\\operatorname{sin}⁡3x+6{u}^{′}\\operatorname{cos}⁡3x-9u\\operatorname{sin}⁡3x.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}\\operatorname{sin}⁡3x+6{u}^{′}\\operatorname{cos}⁡3x-9u\\operatorname{sin}⁡3x)+9u\\operatorname{sin}⁡3x & =0 \\\\ {u}^{″}\\operatorname{sin}⁡3x+6{u}^{′}\\operatorname{cos}⁡3x & =0 \\\\ {u}^{″} & =-6{u}^{′}\\operatorname{cot}⁡3x.\\end{aligned}\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}=-6w\\operatorname{cot}⁡3x.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{csc}^{2}⁡3x.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{csc}^{2}⁡3x\\,⟹\\,u=-\\frac{{c}_{1}}{3}\\operatorname{cot}⁡3x+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u\\operatorname{sin}⁡3x$ becomes\n\n$$\n{y}_{2}(x)=\\operatorname{sin}⁡3x(-\\frac{{c}_{1}}{3}\\operatorname{cot}⁡3x+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=-3$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)=\\operatorname{sin}⁡3x(\\operatorname{cot}⁡3x)=\\operatorname{cos}⁡3x.\n$$"} {:db/id #edb/ref 17592186335783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ebb8345-8448-5af3-a7b5-f875fc57e26d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{55}{9}" :db/id #edb/ref 17592186333119} {:answer/id #uuid "87f8bdf1-b693-5449-95dc-41601ab98dee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186334192} {:answer/id #uuid "9cd4a426-2676-5c7e-b66d-c6dd8478bed9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{56}{81}" :db/id #edb/ref 17592186334369} {:answer/id #uuid "ac5680a5-b135-5e11-a025-14cbaf19a181" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{14}}{9}" :db/id #edb/ref 17592186334503} {:answer/id #uuid "af99c88e-1b1e-54e6-8e94-cc6dcf9705d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{56}{9}" :db/id #edb/ref 17592186334536}] :answer-field/correct {:db/id #edb/ref 17592186334503} :answer-field/id #uuid "2831461c-74ea-58e4-8c19-3e42bd31b998" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335313}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "43fa1511-b2d2-52bf-92cb-53a58f4a78b5" :question/math-academy-id "q-65059" :question/problem "![](images/5d/5d292a3598346bd05511c9c8979ba42845a88afe75a4740d8c4bdb9aa3968c87.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{5}{9},$ use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta .$" :question/worked-solution "![](images/48/488ff32187c9a9a335e3782fb717242d899f622c43010662e28edcabe0e1bde3.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{5}{9}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{5}{9}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{5}{9}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{5}{9}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{81}} \\\\  & =\\pm \\sqrt{\\frac{56}{81}} \\\\  & =\\pm \\frac{2\\sqrt{14}}{9}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So our final answer is $\\operatorname{sin}⁡\\theta =\\frac{2\\sqrt{14}}{9}.$"} {:db/id #edb/ref 17592186335785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596dbc8f-087c-5cf2-accd-e0290a3590a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{\\sqrt{6}}" :db/id #edb/ref 17592186333808} {:answer/id #uuid "ad4202f9-1df8-5702-aa30-7ebfe4130dbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186334517} {:answer/id #uuid "c29b3ce4-5742-5c0e-a80c-c46e912aa977" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{6}" :db/id #edb/ref 17592186334679} {:answer/id #uuid "cc5de6f1-fb22-59a3-a646-77d3c44a4d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{\\sqrt{6}}" :db/id #edb/ref 17592186334771} {:answer/id #uuid "d1f58498-935a-53c3-af47-c294d082ad34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186334822}] :answer-field/correct {:db/id #edb/ref 17592186334822} :answer-field/id #uuid "0e139d51-01cf-5ad5-af15-a0777e8b7fe3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335266}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee81fb0a-2d3c-5307-89ae-7908973bbefc" :question/math-academy-id "q-65062" :question/problem "![](images/43/43629ebfaa2f9811135ffb15f5e5a59b796b83e3a525b4ab480efb9840d40879.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{3}}{3},$ use the Pythagorean identity to find $sec⁡\\theta .$" :question/worked-solution "![](images/f5/f5219a363cdf18cfb628148ca7b9bbe6015b521799ed4487fa9b56843eaa3043.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{3}}{3}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{3}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{3}}{3}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{3}}{3}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{3}{9}} \\\\  & =\\pm \\sqrt{\\frac{6}{9}} \\\\  & =\\pm \\frac{\\sqrt{6}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{\\sqrt{6}}{3}.$\n\nKnowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{\\left(\\frac{\\sqrt{6}}{3}\\right)}=\\frac{3}{\\sqrt{6}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}sec⁡\\theta  & =\\frac{3}{\\sqrt{6}} \\\\  & =\\frac{3}{\\sqrt{6}}\\cdot \\frac{\\sqrt{6}}{\\sqrt{6}} \\\\  & =\\frac{3\\sqrt{6}}{6} \\\\  & =\\frac{\\sqrt{6}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ffeba9c-70a6-5328-9dc3-5020e0313ad2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186333595} {:answer/id #uuid "4eafe18b-8c02-5577-a960-94ba6f971ec7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186333711} {:answer/id #uuid "7213fed3-dd70-59f5-9da6-eb714e406490" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186334021} {:answer/id #uuid "9dc0b081-37ac-56aa-8ceb-99b894130c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{5}" :db/id #edb/ref 17592186334379} {:answer/id #uuid "fdb4516a-8d82-5f18-ae27-7aaf1618cf06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186335220}] :answer-field/correct {:db/id #edb/ref 17592186333595} :answer-field/id #uuid "b0192dd7-c731-5b69-8d4c-3c9bab7026de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335562}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "555c1e17-369e-580d-8f06-901f476b3eee" :question/math-academy-id "q-65064" :question/problem "![](images/45/455df038e550d78fc29463c1a2e22dd44838d24af7428a824f9046fecc1ac1db.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{15}}{5},$ use the Pythagorean identity to find $\\operatorname{csc}⁡\\theta .$" :question/worked-solution "![](images/44/44a555d222e3f6ff85208e8722a728ad240c558de7982d2a480bf9ddfb23ac6f.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{15}}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{15}}{5}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{15}}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{15}}{5}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{15}{25}} \\\\  & =\\pm \\sqrt{\\frac{10}{25}} \\\\  & =\\pm \\frac{\\sqrt{10}}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{10}}{5}.$\n\nKnowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡\\theta =\\frac{1}{\\left(\\frac{\\sqrt{10}}{5}\\right)}=\\frac{5}{\\sqrt{10}}.\\end{aligned}\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡\\theta  & =\\frac{5}{\\sqrt{10}} \\\\  & =\\frac{5}{\\sqrt{10}}\\cdot \\frac{\\sqrt{10}}{\\sqrt{10}} \\\\  & =\\frac{5\\sqrt{10}}{10} \\\\  & =\\frac{\\sqrt{10}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "194eaee8-54cb-563d-8f6d-d34f552da442" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186333221} {:answer/id #uuid "8dcc27a4-b6ff-5196-bfc9-478bbd73a589" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186334253} {:answer/id #uuid "a96bc338-b51a-5af0-adad-0e96975b2300" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186334473} {:answer/id #uuid "ad3570c1-3d28-5add-bb53-9c8895491a2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186334516} {:answer/id #uuid "e6417934-5eda-53e4-82d9-b2e434d37de6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186334996}] :answer-field/correct {:db/id #edb/ref 17592186334516} :answer-field/id #uuid "dfce3d7a-f48e-534b-a3f3-76cd7412d6ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335631}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7581029a-054b-5d43-92f5-a2b561001b1c" :question/math-academy-id "q-65072" :question/problem "![](images/e6/e666ddc8a8eda452abd833e963446c96de5d34dfbf76e9c92564e85a48080524.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{3}{5},$ use the Pythagorean identity to find $tan⁡\\theta .$" :question/worked-solution "![](images/fc/fc291f1fc5c4a712d3eef7ea2872de621855669d97445b24a2bc7a9da55949d9.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{3}{5}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{3}{5}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{3}{5}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{3}{5}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{25}} \\\\  & =\\pm \\sqrt{\\frac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{4}{5}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{\\left(\\frac{3}{5}\\right)}{\\left(\\frac{4}{5}\\right)}=\\frac{3}{4}.\n$$"} {:db/id #edb/ref 17592186335790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b84d4ec-9f5f-5a47-8517-3bb8f8c9e6f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{17}}{9}" :db/id #edb/ref 17592186333094} {:answer/id #uuid "0f97daea-fc44-5b9a-b6c8-8ae1ec14226d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{17}}{17}" :db/id #edb/ref 17592186333127} {:answer/id #uuid "26887548-0fc3-51f2-9193-efc1f3262179" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186333343} {:answer/id #uuid "9f0d2d95-0c48-5abf-8954-df6ad2d3263b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186334390} {:answer/id #uuid "c3781df0-cce1-500d-ae05-5955c50dfe45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{17}}{8}" :db/id #edb/ref 17592186334685}] :answer-field/correct {:db/id #edb/ref 17592186334685} :answer-field/id #uuid "360fb473-e8de-57ee-bab2-0cdf46873b28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5aa7dee2-18db-5dfd-b251-d711e6634ce2" :question/math-academy-id "q-65075" :question/problem "![](images/d8/d846227996dd5fc1d6c3ca30108f548ac0d3743ec9262db0a551d28a32386996.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{17}}{9},$ use the Pythagorean identity to find $cot⁡\\theta .$" :question/worked-solution "![](images/52/5284ae5a30a5d370d52c887cc6222ee4991a98d087dc751cbcfe5d7307ca1d47.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{17}}{9}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{\\sqrt{17}}{9}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{\\sqrt{17}}{9}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{17}}{9}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{17}{81}} \\\\  & =\\pm \\sqrt{\\frac{64}{81}} \\\\  & =\\pm \\frac{8}{9}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So, $sin⁡\\theta =\\frac{8}{9}.$\n\nFinally, knowing that $cot⁡\\theta =\\frac{cos⁡\\theta }{sin⁡\\theta },$ we have\n\n$$\ncot⁡\\theta =\\frac{\\left(\\frac{\\sqrt{17}}{9}\\right)}{\\left(\\frac{8}{9}\\right)}=\\frac{\\sqrt{17}}{8}.\n$$"} {:db/id #edb/ref 17592186335805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000286c7-5d78-5f85-8582-341603e6a0f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186332988} {:answer/id #uuid "3c926dc5-c1b9-58d1-a534-ca1ef6f33b66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{csc}⁡x" :db/id #edb/ref 17592186333560} {:answer/id #uuid "6671e7f3-d38a-5a8b-9904-1df9bce464dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186333922} {:answer/id #uuid "67a49c8d-15af-5d30-af81-1c15d6d58d7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡x" :db/id #edb/ref 17592186333940} {:answer/id #uuid "af0475c6-02d5-58b2-ad72-edc2f395cb2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{csc}^{2}⁡x" :db/id #edb/ref 17592186334531}] :answer-field/correct {:db/id #edb/ref 17592186333940} :answer-field/id #uuid "24cd164f-b9d3-5b71-a31d-63ebb4576058" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "16396e31-6473-5001-b95f-56cba13dafc8" :question/math-academy-id "q-65211" :question/problem "Simplify the expression $\\operatorname{cos}⁡x(\\operatorname{sec}⁡x-\\operatorname{cos}⁡x)$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x(\\operatorname{sec}⁡x-\\operatorname{cos}⁡x)=\\operatorname{cos}⁡x\\cdot \\operatorname{sec}⁡x-\\operatorname{cos}⁡x\\cdot \\operatorname{cos}⁡x\\end{aligned}\n$$\n\nThen, we use the identity $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}$ to further simplify the expression:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x\\cdot \\operatorname{sec}⁡x-\\operatorname{cos}⁡x\\cdot \\operatorname{cos}⁡x & =\\operatorname{cos}⁡x\\cdot \\frac{1}{\\operatorname{cos}⁡x}-{cos}^{2}⁡x \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{cos}⁡x}-{cos}^{2}⁡x \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡x}}{\\cancel{\\operatorname{cos}⁡x}}-{cos}^{2}⁡x \\\\  & =1-{cos}^{2}⁡x\\end{aligned}\n$$\n\nNow, we can use the identity ${sin}^{2}⁡x=1-{cos}^{2}⁡x$ to rewrite the expression on the right-hand side.\n\nTherefore, we conclude that:\n\n$$\n\\operatorname{cos}⁡x(\\operatorname{sec}⁡x-\\operatorname{cos}⁡x)={sin}^{2}⁡x\n$$"} {:db/id #edb/ref 17592186335806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a3d5eca-f411-5643-aa4d-35d3ef9848ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡x+1" :db/id #edb/ref 17592186333230} {:answer/id #uuid "a457f79d-88df-50d4-b7cb-695bebb93a96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334432} {:answer/id #uuid "ad464370-15d9-5b5e-9b9e-04ae6f9aa325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186334519} {:answer/id #uuid "f00a7b47-2966-5b0e-b022-de10e6ccf06c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡x" :db/id #edb/ref 17592186335093} {:answer/id #uuid "fe0e56a4-9096-568a-a480-e3cc1f380f3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186335227}] :answer-field/correct {:db/id #edb/ref 17592186335093} :answer-field/id #uuid "230bd128-0f74-509e-8b76-16eab4cc9809" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335302}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f45c9a7-af57-5bcc-a401-894d9ca48316" :question/math-academy-id "q-65214" :question/problem "Simplify the expression ${cos}^{3}⁡x({sec}^{3}⁡x-\\operatorname{sec}⁡x)$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}{cos}^{3}⁡x({sec}^{3}⁡x-\\operatorname{sec}⁡x) & ={cos}^{3}⁡x\\cdot {sec}^{3}⁡x-{cos}^{3}⁡x\\cdot \\operatorname{sec}⁡x\\end{aligned}\n$$\n\nThen, we use the identity $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}$ to further simplify the expression:\n\n$$\n\\begin{aligned}{cos}^{3}⁡x\\cdot {sec}^{3}⁡x-{cos}^{3}⁡x\\cdot \\operatorname{sec}⁡x & ={cos}^{3}⁡x\\cdot {\\left(\\frac{1}{\\operatorname{cos}⁡x}\\right)}^{3}-{cos}^{3}⁡x\\cdot \\frac{1}{\\operatorname{cos}⁡x} \\\\  & ={cos}^{3}⁡x\\cdot \\frac{1}{{cos}^{3}⁡x}-{cos}^{3}⁡x\\cdot \\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\frac{{cos}^{3}⁡x}{{cos}^{3}⁡x}-\\frac{{cos}^{3}⁡x}{\\operatorname{cos}⁡x} \\\\  & =\\frac{\\cancel{{cos}^{3}⁡x}}{\\cancel{{cos}^{3}⁡x}}-\\frac{{cos}^{2}⁡x\\cdot \\cancel{\\operatorname{cos}⁡x}}{\\cancel{\\operatorname{cos}⁡x}} \\\\  & =1-{cos}^{2}⁡x\\end{aligned}\n$$\n\nNow, we can use the identity ${sin}^{2}⁡x=1-{cos}^{2}⁡x$ to rewrite the expression on the right-hand side.\n\nTherefore, we conclude that:\n\n$$\n{cos}^{3}⁡x({sec}^{3}⁡x-\\operatorname{sec}⁡x)={sin}^{2}⁡x\n$$"} {:db/id #edb/ref 17592186335807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3af8940c-83a4-5170-9b41-72b3f9783916" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{sec}^{2}⁡x" :db/id #edb/ref 17592186333543} {:answer/id #uuid "5f6aeab6-d124-5346-9a26-d08864df240c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sec}⁡x+1" :db/id #edb/ref 17592186333858} {:answer/id #uuid "8887f58d-1e30-5f79-982d-3ce1501767a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186334199} {:answer/id #uuid "b588f775-f66a-5116-9181-39e55e0e3bb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186334580} {:answer/id #uuid "e88dd122-49d7-5a5c-9ad4-27b7301c33d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{cos}^{2}⁡x" :db/id #edb/ref 17592186335018}] :answer-field/correct {:db/id #edb/ref 17592186335018} :answer-field/id #uuid "2478a42f-4c89-57a0-bb96-3f4e38b21e5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335305}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eea33397-bf48-5fa0-9ebd-7769e421b00b" :question/math-academy-id "q-65217" :question/problem "$3\\operatorname{csc}⁡x(\\operatorname{sin}⁡x-{sin}^{3}⁡x)=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}3\\operatorname{csc}⁡x(\\operatorname{sin}⁡x-{sin}^{3}⁡x)=3\\operatorname{csc}⁡x\\cdot \\operatorname{sin}⁡x-3\\operatorname{csc}⁡x\\cdot {sin}^{3}⁡x\\end{aligned}\n$$\n\nThen, we use the identity $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}$ to further simplify the expression:\n\n$$\n\\begin{aligned}3\\operatorname{csc}⁡x\\cdot \\operatorname{sin}⁡x-3\\operatorname{csc}⁡x\\cdot {sin}^{3}⁡x & =3\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x-3\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot {sin}^{3}⁡x \\\\  & =\\frac{3\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x}-\\frac{3{sin}^{3}⁡x}{\\operatorname{sin}⁡x} \\\\  & =\\frac{3\\cancel{\\operatorname{sin}⁡x}}{\\cancel{\\operatorname{sin}⁡x}}-\\frac{3{sin}^{2}⁡x\\cdot \\cancel{\\operatorname{sin}⁡x}}{\\cancel{\\operatorname{sin}⁡x}} \\\\  & =3-3{sin}^{2}⁡x \\\\  & =3(1-{sin}^{2}⁡x)\\end{aligned}\n$$\n\nNow, we can use the identity ${cos}^{2}⁡x=1-{sin}^{2}⁡x$  to rewrite the expression on the right-hand side.\n\nTherefore, we conclude that:\n\n$$\n3\\operatorname{csc}⁡x(\\operatorname{sin}⁡x-{sin}^{3}⁡x)=3{cos}^{2}⁡x\n$$"} {:db/id #edb/ref 17592186335808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dba1b07-1963-5964-b235-93ae2ff2ae0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186333569} {:answer/id #uuid "5a161b35-9168-53e9-830b-a1b3a05c9535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{sin}^{2}⁡x" :db/id #edb/ref 17592186333815} {:answer/id #uuid "7ae13cf9-e295-54fe-a97d-83a773aaa07c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{csc}⁡x" :db/id #edb/ref 17592186334091} {:answer/id #uuid "8fd3c202-023d-5b6e-a9da-7b4e7899ec00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{2}⁡x" :db/id #edb/ref 17592186334272} {:answer/id #uuid "ce3090ee-7d31-5bde-8be2-bceec7779b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186334785}] :answer-field/correct {:db/id #edb/ref 17592186333815} :answer-field/id #uuid "528621c5-b1a3-563c-9b7d-98be706af876" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335401}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7b29fb06-77d1-5a88-a337-98048687e38c" :question/math-academy-id "q-65218" :question/problem "$2\\operatorname{sin}⁡x(\\operatorname{csc}⁡x-\\operatorname{csc}⁡x\\cdot {cos}^{2}⁡x)=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x(\\operatorname{csc}⁡x-\\operatorname{csc}⁡x\\cdot {cos}^{2}⁡x)=2\\operatorname{sin}⁡x\\cdot \\operatorname{csc}⁡x-2\\operatorname{sin}⁡x\\cdot \\operatorname{csc}⁡x\\cdot {cos}^{2}⁡x\\end{aligned}\n$$\n\nThen, we use the identity $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}$ to further simplify the expression:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x\\cdot \\operatorname{csc}⁡x-2\\operatorname{sin}⁡x\\cdot \\operatorname{csc}⁡x\\cdot {cos}^{2}⁡x & =2\\operatorname{sin}⁡x\\cdot \\frac{1}{\\operatorname{sin}⁡x}-2\\operatorname{sin}⁡x\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot {cos}^{2}⁡x \\\\  & =\\frac{2\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x}-\\frac{2\\operatorname{sin}⁡x\\cdot {cos}^{2}⁡x}{\\operatorname{sin}⁡x} \\\\  & =\\frac{2\\cancel{\\operatorname{sin}⁡x}}{\\cancel{\\operatorname{sin}⁡x}}-\\frac{2\\cancel{\\operatorname{sin}⁡x}\\cdot {cos}^{2}⁡x}{\\cancel{\\operatorname{sin}⁡x}} \\\\  & =2-2{cos}^{2}⁡x \\\\  & =2(1-{cos}^{2}⁡x)\\end{aligned}\n$$\n\nNow, we can use the identity ${sin}^{2}⁡x=1-{cos}^{2}⁡x$ to rewrite the expression on the right-hand side.\n\nTherefore, we conclude that:\n\n$$\n2\\operatorname{sin}⁡x(\\operatorname{csc}⁡x-\\operatorname{csc}⁡x\\cdot {cos}^{2}⁡x)=2{sin}^{2}⁡x\n$$"} {:db/id #edb/ref 17592186335812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a7da12b-ea3a-504a-a67e-059f3e8f6262" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333673} {:answer/id #uuid "5f8c630d-dd33-5902-bd81-7e537fa8c89f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333859} {:answer/id #uuid "6a78f8af-27d5-5c47-b223-293242505696" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333963} {:answer/id #uuid "8c2d187e-60e7-5c28-830e-b6b7f8c13a3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186334240} {:answer/id #uuid "c5fdde48-1387-5551-8d00-6e41d1c098f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186334710}] :answer-field/correct {:db/id #edb/ref 17592186333859} :answer-field/id #uuid "141ae38c-3a63-53d0-a07e-541b12284ba0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335276}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c57c57c4-72ee-508f-9312-cda659353bab" :question/math-academy-id "q-65230" :question/problem "Simplify the expression $\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x+1}.$" :question/worked-solution "First, we rewrite the numerator using $1-{cos}^{2}⁡x={sin}^{2}⁡x.$\n\n$$\n\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x+1}=\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x+1}\n$$\n\nNext, we factor the numerator as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x+1} & =\\frac{(1+\\operatorname{cos}⁡x)(1-\\operatorname{cos}⁡x)}{\\operatorname{cos}⁡x+1} \\\\  & =\\frac{\\cancel{(1+\\operatorname{cos}⁡x)}(1-\\operatorname{cos}⁡x)}{\\cancel{\\operatorname{cos}⁡x+1}} \\\\  & =\\frac{1-\\operatorname{cos}⁡x}{1} \\\\  & =1-\\operatorname{cos}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5cae16-598c-5af3-a6de-8dbde303e83d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186333258} {:answer/id #uuid "57bc7fbb-e0db-539a-8053-e6eab5192967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186333792} {:answer/id #uuid "b43c2b21-1df1-58ab-9ebf-8f32ea26a09e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{sin}^{2}⁡x" :db/id #edb/ref 17592186334568} {:answer/id #uuid "d8e1949c-f48b-5015-b3a4-c152f24f1c45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334891} {:answer/id #uuid "df7d5775-99b2-54f0-ba06-c78a8d59cf1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{sin}^{2}⁡x" :db/id #edb/ref 17592186334934}] :answer-field/correct {:db/id #edb/ref 17592186334891} :answer-field/id #uuid "483a4ea3-4e25-57e1-a334-aabdf296e48b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335377}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5a3ec76e-4e30-58a7-abb7-8f66c55fb485" :question/math-academy-id "q-65231" :question/problem "If $$\n\\displaystyle \\frac{1-\\operatorname{sin}⁡x}{{cos}^{2}⁡x}=\\frac{1}{f(x)},\n$$ then $f(x)=$" :question/worked-solution "First, we rewrite the denominator using $1-{sin}^{2}⁡x={cos}^{2}⁡x.$\n\n$$\n\\frac{1-\\operatorname{sin}⁡x}{{cos}^{2}⁡x}=\\frac{1-\\operatorname{sin}⁡x}{1-{sin}^{2}⁡x}\n$$\n\nNext, we factor the denominator as difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-\\operatorname{sin}⁡x}{1-{sin}^{2}⁡x} & =\\frac{1-\\operatorname{sin}⁡x}{(1-\\operatorname{sin}⁡x)(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{\\cancel{1-\\operatorname{sin}⁡x}}{\\cancel{(1-\\operatorname{sin}⁡x)}(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{1}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nTherefore, $f(x)=1+\\operatorname{sin}⁡x.$"} {:db/id #edb/ref 17592186335814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009a70ce-f969-523c-9a1f-7fa8409b9ad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186332993} {:answer/id #uuid "48cc6064-a650-54a7-8362-e34db6429982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186333659} {:answer/id #uuid "83ec58ba-5daf-5a6d-87e7-0a28f91faeee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186334164} {:answer/id #uuid "d21a5517-72f5-50d9-9316-1384a7b245e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186334824} {:answer/id #uuid "f8e1f1c0-1000-54bc-ad77-41e971747a47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186335171}] :answer-field/correct {:db/id #edb/ref 17592186332993} :answer-field/id #uuid "4c100ae4-6ebc-5307-b7f8-0673e840f4ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335389}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81343d61-ef5f-5cc4-b4c3-87c9bb11867e" :question/math-academy-id "q-65236" :question/problem "$$\n\\displaystyle \\frac{1}{\\operatorname{cos}⁡\\theta }-\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }=\n$$" :question/worked-solution "First, we factor the expression:\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{cos}⁡\\theta }-\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta } & =\\frac{1}{\\operatorname{cos}⁡\\theta }-\\frac{1}{\\operatorname{cos}⁡\\theta }\\cdot {sin}^{2}⁡\\theta  \\\\  & =\\frac{1}{\\operatorname{cos}⁡\\theta }(1-{sin}^{2}⁡\\theta )\\end{aligned}\n$$\n\nThen, we use ${cos}^{2}⁡\\theta =1-{sin}^{2}⁡\\theta $ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{cos}⁡\\theta }(1-{sin}^{2}⁡\\theta ) & =\\frac{1}{\\operatorname{cos}⁡\\theta }\\cdot {cos}^{2}⁡\\theta  \\\\  & =\\frac{{cos}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡\\theta }\\operatorname{cos}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }} \\\\  & =\\operatorname{cos}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{1}{\\operatorname{cos}⁡\\theta }-\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }=\\operatorname{cos}⁡\\theta \n$$"} {:db/id #edb/ref 17592186335823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b8cf3c-b0f3-598e-8e68-29c961175544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333149} {:answer/id #uuid "42ade542-33b7-5813-873b-f7cc2574b213" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333611} {:answer/id #uuid "8ade98a8-acd8-5f5e-a8df-ea01e75da818" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186334232} {:answer/id #uuid "8f51271c-94f5-5c6b-a69b-7192605dc2e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cos}^{2}⁡x+1" :db/id #edb/ref 17592186334267} {:answer/id #uuid "f03f4a94-50a4-5389-a070-1a8f343caa01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cos}^{2}⁡x+1" :db/id #edb/ref 17592186335094}] :answer-field/correct {:db/id #edb/ref 17592186334232} :answer-field/id #uuid "2e895244-7616-5941-b789-a80c19b5d584" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335331}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f8fba9a8-ac13-5d81-96d3-8bd5b06057c5" :question/math-academy-id "q-65293" :question/problem "If $$\n\\displaystyle \\frac{\\operatorname{cos}⁡x+1}{{sin}^{2}⁡x}=\\frac{1}{f(x)},\n$$ then $f(x)=$" :question/worked-solution "First, we rewrite the denominator using $1-{cos}^{2}⁡x={sin}^{2}⁡x.$\n\n$$\n\\frac{\\operatorname{cos}⁡x+1}{{sin}^{2}⁡x}=\\frac{\\operatorname{cos}⁡x+1}{1-{cos}^{2}⁡x}\n$$\n\nNext, we factor the denominator as difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x+1}{1-{cos}^{2}⁡x} & =\\frac{\\operatorname{cos}⁡x+1}{(1+\\operatorname{cos}⁡x)(1-\\operatorname{cos}⁡x)} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡x+1}}{\\cancel{(1+\\operatorname{cos}⁡x)}(1-\\operatorname{cos}⁡x)} \\\\  & =\\frac{1}{1-\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, $f(x)=1-\\operatorname{cos}⁡x.$"} {:db/id #edb/ref 17592186335827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e69034ac-dafa-5930-9534-071e532133a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451489} {:answer/id #uuid "c79d71f8-411a-5d53-9c3b-a808ff276fcd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451490}] :answer-field/correct {:db/id #edb/ref 17592186451489} :answer-field/id #uuid "af683c1c-fb93-51f7-8ac5-a2a162727948" :answer-field/key "$x=-\\pi $ is not in the domain of the function." :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452592} {:answer-field/choices [{:answer/id #uuid "9aefb0cc-b61a-591b-938a-61ea84ad8322" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451491} {:answer/id #uuid "94538785-9bb8-5d4c-adcd-8998ecf59214" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451492}] :answer-field/correct {:db/id #edb/ref 17592186451491} :answer-field/id #uuid "140a5ba5-395f-5a59-8c85-ed4334f12df7" :answer-field/key "$y=-\\frac{1}{3}$ is in the range of the function." :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452593} {:answer-field/choices [{:answer/id #uuid "bb55f19f-2e84-5c66-b274-dd496fc42c33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451493} {:answer/id #uuid "e78d352f-70a9-5fb3-9cb7-e1d6d348d4bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451494}] :answer-field/correct {:db/id #edb/ref 17592186451494} :answer-field/id #uuid "e01f97a5-285a-5298-bb3d-ba1bb2236b16" :answer-field/key "$x=-\\frac{3\\pi }{2}$ is a vertical asymptote." :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452594}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e763b192-f670-5ee9-881f-7ff2a2620e1d" :question/math-academy-id "q-65332" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/da/da729794a0331383debd75be0a4ce4a9f2d4da3286f50bd4f284868996077412.png)\n\nLet's go through each statement.\n\n- Statement “$x=-\\pi $ is not in the domain of the function” is false. The function is defined for all real numbers except the values $\\frac{\\pi }{2}+n\\pi $ for any integer $n,$ thus it is defined for $x=-\\pi .$\n\n- Statement “$y=-\\frac{1}{3}$ is in the range of the function” is false. The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ so $y=-\\frac{1}{3}$ is not in the range.\n\n- Statement “$x=-\\frac{3\\pi }{2}$ is a vertical asymptote” is true. The function $y=sec⁡x$ has vertical asymptotes at $x=\\frac{\\pi }{2}+n\\pi $, thus $x=-\\frac{3\\pi }{2}$ is a vertical asymptote."} {:db/id #edb/ref 17592186335829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe1accd-9f21-5b79-b75e-3908cdd204c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡x+{tan}^{2}⁡x" :db/id #edb/ref 17592186333594} {:answer/id #uuid "4398e0fb-9942-57ff-b92e-4b8712f2e786" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186333620} {:answer/id #uuid "6bf5dda4-cfff-569a-bbef-8ca340d2a2ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x+{tan}^{2}⁡x" :db/id #edb/ref 17592186333974} {:answer/id #uuid "b73f4d0a-f5a8-5b96-9f74-64def6147bff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186334594} {:answer/id #uuid "e0834693-d5c1-572f-9588-4db84f60957b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186334945}] :answer-field/correct {:db/id #edb/ref 17592186333594} :answer-field/id #uuid "e8fb2b9a-9fc0-500b-b0a4-149aaf14cfba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335647}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6249526e-e37c-5205-a929-c57a9bec64c0" :question/math-academy-id "q-65399" :question/problem "Simplify ${sec}^{4}⁡x-{tan}^{4}⁡x.$" :question/worked-solution "First, we can simplify our expression by factoring it as a difference of squares, as follows:\n\n$$\n\\begin{aligned}{sec}^{4}⁡x-{tan}^{4}⁡x & =({sec}^{2}⁡x-{tan}^{2}⁡x)({sec}^{2}⁡x+{tan}^{2}⁡x)\\end{aligned}\n$$\n\nNext, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nFinally, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}({sec}^{2}⁡x-{tan}^{2}⁡x)({sec}^{2}⁡x+{tan}^{2}⁡x) & =(1)({sec}^{2}⁡x+{tan}^{2}⁡x) \\\\  & ={sec}^{2}⁡x+{tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{4}⁡x-{tan}^{4}⁡x={sec}^{2}⁡x+{tan}^{2}⁡x.\n$$"} {:db/id #edb/ref 17592186335830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29feff65-81cb-517d-9cba-cfde33cc3205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta +1" :db/id #edb/ref 17592186333382} {:answer/id #uuid "304985e4-e498-58ed-9d5a-aedb06d45056" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta -1" :db/id #edb/ref 17592186333436} {:answer/id #uuid "959f6fa4-b1fe-534d-8ede-08c8efb07d9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186334318} {:answer/id #uuid "a3d67bb3-c866-5d8c-a924-b876065ef2d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta +1" :db/id #edb/ref 17592186334427} {:answer/id #uuid "e8146ee7-1f33-586a-b673-afc7b22d8eda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186335013}] :answer-field/correct {:db/id #edb/ref 17592186334318} :answer-field/id #uuid "1b529f6d-4119-5e50-9545-1f3d96df1ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335290}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ae91237-e4be-54cf-9b80-96bb246fe25a" :question/math-academy-id "q-65400" :question/problem "Which of the following is equivalent to ${sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{sec}^{4}⁡\\theta +2{sec}^{2}⁡\\theta -1?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}{sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{sec}^{4}⁡\\theta +2{sec}^{2}⁡\\theta -1 & =-{sec}^{2}⁡\\theta ({sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta )+2{sec}^{2}⁡\\theta -1 \\\\  & =-{sec}^{2}⁡\\theta \\cdot (1)+2{sec}^{2}⁡\\theta -1 \\\\  & =-{sec}^{2}⁡\\theta +2{sec}^{2}⁡\\theta -1\\end{aligned}\n$$\n\nNext, we can further simplify our expression using $(2)$, as follows:\n\n$$\n\\begin{aligned}-{sec}^{2}⁡\\theta +2{sec}^{2}⁡\\theta -1 & ={sec}^{2}⁡\\theta -1 \\\\  & ={tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{sec}^{4}⁡\\theta +2{sec}^{2}⁡\\theta -1={tan}^{2}⁡\\theta .\n$$"} {:db/id #edb/ref 17592186335831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a064f8f-2a11-528b-9bec-12b36edf7c61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡x{tan}^{4}⁡x" :db/id #edb/ref 17592186333959} {:answer/id #uuid "777885a8-9028-53cf-82c4-cf986a344a29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x{tan}^{2}⁡x" :db/id #edb/ref 17592186334063} {:answer/id #uuid "7e030e31-aade-59aa-bc78-0c444b97af4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186334114} {:answer/id #uuid "8a4b61e4-4e2d-57af-8904-5d05d497dcc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{4}⁡x{tan}^{2}⁡x" :db/id #edb/ref 17592186334223} {:answer/id #uuid "b507af7e-05da-5bd2-8f76-251c65d30cca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡x{tan}^{2}⁡x" :db/id #edb/ref 17592186334573}] :answer-field/correct {:db/id #edb/ref 17592186334573} :answer-field/id #uuid "bcccc34d-aba3-51d9-88db-6a85b3dd1e94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335587}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "328751ad-dddc-5642-aed2-8634ba344213" :question/math-academy-id "q-65401" :question/problem "Which of the following is equivalent to ${sec}^{4}⁡x-2{sec}^{2}⁡x+1+{tan}^{2}⁡x?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n{sec}^{4}⁡x-2{sec}^{2}⁡x+1+{tan}^{2}⁡x={sec}^{4}⁡x-2{sec}^{2}⁡x+1+{sec}^{2}⁡x-1\n$$\n\nNext, we can further simplify our expression and use again $(2),$ as follows:\n\n$$\n\\begin{aligned}{sec}^{4}⁡x-2{sec}^{2}⁡x+1+{sec}^{2}⁡x-1 & ={sec}^{4}⁡x-2{sec}^{2}⁡x+\\cancel{1}+{sec}^{2}⁡x-\\cancel{1} \\\\  & ={sec}^{4}⁡x-{sec}^{2}⁡x \\\\  & ={sec}^{2}⁡x\\cdot ({sec}^{2}⁡x-1) \\\\  & ={sec}^{2}⁡x\\cdot {tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{4}⁡x-2{sec}^{2}⁡x+1+{tan}^{2}⁡x={sec}^{2}⁡x{tan}^{2}⁡x.\n$$"} {:db/id #edb/ref 17592186335832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39b0986f-30be-52b1-b6c2-991c744c1437" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186333529} {:answer/id #uuid "64b870c0-7dac-53bd-9eb7-b0954bd377f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186333902} {:answer/id #uuid "893c394c-c300-5c25-8976-ec5c2567630a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186334211} {:answer/id #uuid "bbeb419e-5e62-5462-8e39-5389bdff9674" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186334627} {:answer/id #uuid "de9d3666-82fe-57ea-8f07-0383e6ad66a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186334929}] :answer-field/correct {:db/id #edb/ref 17592186334211} :answer-field/id #uuid "1ec88c13-6567-5ae9-a2d1-9a7c7e53c4ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92128cd3-9953-5b46-96fd-516fd23182a9" :question/math-academy-id "q-65402" :question/problem "Simplify $(\\operatorname{sec}⁡x-\\operatorname{tan}⁡x)(\\operatorname{sec}⁡x+\\operatorname{tan}⁡x).$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n(\\operatorname{sec}⁡x-\\operatorname{tan}⁡x)(\\operatorname{sec}⁡x+\\operatorname{tan}⁡x)={sec}^{2}⁡x-{tan}^{2}⁡x\n$$\n\nThen, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(3),$ as follows:\n\n$$\n{sec}^{2}⁡x-{tan}^{2}⁡x=1\n$$\n\nTherefore, we conclude that\n\n$$\n(\\operatorname{sec}⁡x-\\operatorname{tan}⁡x)(\\operatorname{sec}⁡x+\\operatorname{tan}⁡x)=1.\n$$"} {:db/id #edb/ref 17592186335833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "667926b4-5c90-531a-b378-6f494a5d1b19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cos}^{2}⁡\\alpha +1" :db/id #edb/ref 17592186333923} {:answer/id #uuid "c5cd49c8-a91d-5e16-82e0-3a59c02eade8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\alpha " :db/id #edb/ref 17592186334708} {:answer/id #uuid "cb90bf50-d8ba-5ac7-82e4-ed9d529186b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡\\alpha " :db/id #edb/ref 17592186334763} {:answer/id #uuid "fd21f014-fa07-5fad-9788-85a4d336ac1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\alpha +1" :db/id #edb/ref 17592186335214} {:answer/id #uuid "fd5dc02f-8a16-5154-8aa7-5201c2ce6360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cos}^{2}⁡\\alpha " :db/id #edb/ref 17592186335217}] :answer-field/correct {:db/id #edb/ref 17592186334708} :answer-field/id #uuid "68fd51fe-4b10-56d5-85a1-b85de5e14009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335443}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f35559a-09fd-5000-bb22-39066fa429c2" :question/math-academy-id "q-65410" :question/problem "Simplify $$\n\\displaystyle \\frac{1+\\operatorname{sec}⁡\\alpha }{{tan}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha +1}.\n$$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\alpha ={sec}^{2}⁡\\alpha  \\\\  & (2) & {tan}^{2}⁡\\alpha ={sec}^{2}⁡\\alpha -1 \\\\  & (3) & {sec}^{2}⁡\\alpha -{tan}^{2}⁡\\alpha =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1+\\operatorname{sec}⁡\\alpha }{{tan}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha +1} & =\\frac{1+\\operatorname{sec}⁡\\alpha }{{sec}^{2}⁡\\alpha -1+\\operatorname{sec}⁡\\alpha +1} \\\\  & =\\frac{1+\\operatorname{sec}⁡\\alpha }{{sec}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha }\\end{aligned}\n$$\n\nFinally, we can further simplify our expression by factoring it out, as follows:\n\n$$\n\\begin{aligned}\\frac{1+\\operatorname{sec}⁡\\alpha }{{sec}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha } & =\\frac{1+\\operatorname{sec}⁡\\alpha }{\\operatorname{sec}⁡\\alpha (\\operatorname{sec}⁡\\alpha +1)} \\\\  & =\\frac{\\cancel{1+\\operatorname{sec}⁡\\alpha }}{\\operatorname{sec}⁡\\alpha \\cancel{(\\operatorname{sec}⁡\\alpha +1)}} \\\\  & =\\frac{1}{\\operatorname{sec}⁡\\alpha } \\\\  & =\\operatorname{cos}⁡\\alpha \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1+\\operatorname{sec}⁡\\alpha }{{tan}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha +1}=\\operatorname{cos}⁡\\alpha .\n$$"} {:db/id #edb/ref 17592186335837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b38ae2d-e945-50a4-9fcf-a5b4c47bf27b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5${sin}^{2}⁡2\\theta $" :db/id #edb/ref 17592186333092} {:answer/id #uuid "2ead471f-96cb-591a-91f9-c022361af740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186333421} {:answer/id #uuid "4122b94b-4840-5666-9431-97636330f898" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186333602} {:answer/id #uuid "4c1155f4-47fa-597e-94fc-71fd17a95690" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡2\\theta " :db/id #edb/ref 17592186333689} {:answer/id #uuid "deff35e1-10e2-57e3-8c7a-bae2717bc97c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186334933}] :answer-field/correct {:db/id #edb/ref 17592186333421} :answer-field/id #uuid "9ed4e9d8-4ebb-54f4-88d4-bc5802b2b888" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335534}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9aa3c2c8-ad31-53f1-a9e0-2f0e8c86616a" :question/math-academy-id "q-65445" :question/problem "Simplify $\\frac{{cos}^{2}⁡\\theta }{{csc}^{2}⁡\\theta -1}.$" :question/worked-solution "First, let's recall the following identity:\n\n$$\n{csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta \n$$\n\nSubstituting the above identity into the given expression, we get\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡\\theta }{{csc}^{2}⁡\\theta -1} & =\\frac{{cos}^{2}⁡\\theta }{{cot}^{2}⁡\\theta } \\\\  & ={cos}^{2}⁡\\theta \\cdot {tan}^{2}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta \\cdot \\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\cancel{{cos}^{2}⁡\\theta }\\cdot \\frac{{sin}^{2}⁡\\theta }{\\cancel{{cos}^{2}⁡\\theta }} \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27ad62a5-06f0-563a-85b8-54c83a5eec52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{cot}^{2}⁡\\theta " :db/id #edb/ref 17592186333354} {:answer/id #uuid "2ec01285-7179-53f0-b095-3a42a6a02304" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡\\theta +1" :db/id #edb/ref 17592186333423} {:answer/id #uuid "5235fc4b-a86f-5a59-a3c1-2982424ef8f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186333746} {:answer/id #uuid "5c9a393e-8f01-53c7-bb83-8d8dcc0a2f85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186333833} {:answer/id #uuid "c2a98521-c263-5a37-80ff-34ac1f414ff0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cot}^{2}⁡\\theta " :db/id #edb/ref 17592186334680}] :answer-field/correct {:db/id #edb/ref 17592186333833} :answer-field/id #uuid "f0613579-6685-52f7-acd7-de82e7ed9432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335657}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e65a59f6-f00e-56d6-a5f9-96619389f8fb" :question/math-academy-id "q-65446" :question/problem "Simplify $$\n\\displaystyle \\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta .\n$$" :question/worked-solution "First, let's recall the following identity: \n\n$$\n1={csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta \n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta  & =\\frac{{csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta  \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta )\\,(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta  \\\\  & =\\frac{\\cancel{(\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta )}\\,(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )}{\\cancel{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }}-\\operatorname{csc}⁡\\theta  \\\\  & =\\cancel{\\operatorname{csc}⁡\\theta }+\\operatorname{cot}⁡\\theta -\\cancel{\\operatorname{csc}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6c3b03-3d05-5b33-bf74-76ca35cbabaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186333271} {:answer/id #uuid "4761f285-4ce8-5ee4-b814-46c24cc30e6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186333648} {:answer/id #uuid "5ca6b901-5a7d-5974-a48f-316c1c0fefc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186333834} {:answer/id #uuid "eced2d99-93c9-51f1-91b1-74eb9a6cc988" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186335066} {:answer/id #uuid "f003fbdf-169b-5374-b5dc-383d09ea79f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186335092}] :answer-field/correct {:db/id #edb/ref 17592186335092} :answer-field/id #uuid "b32e3417-1c93-5649-9e27-6894d1e70346" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335565}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "142983e1-8dc9-5049-86db-6861631dfecc" :question/math-academy-id "q-65457" :question/problem "Simplify ${sin}^{2}⁡x+{sin}^{2}⁡x\\cdot {cot}^{2}⁡x+1.$" :question/worked-solution "First, we factor the ${sin}^{2}⁡x$ from the first two terms:\n\n$$\n\\begin{aligned}{sin}^{2}⁡x+{sin}^{2}⁡x\\cdot {cot}^{2}⁡x+1 & ={sin}^{2}⁡x(1+{cot}^{2}⁡x)+1\\end{aligned}\n$$\n\nNow, using the identity $1+{cot}^{2}⁡x={csc}^{2}⁡x,$ we have\n\n$$\n\\begin{aligned}{sin}^{2}⁡x(1+{cot}^{2}⁡x)+1 & ={sin}^{2}⁡x({csc}^{2}⁡x)+1 \\\\  & =\\cancel{{sin}^{2}⁡x}\\left(\\frac{1}{\\cancel{{sin}^{2}⁡x}}\\right)+1 \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81b3aace-60ab-5e62-8287-0e74997fe365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{csc}⁡x" :db/id #edb/ref 17592186334142} {:answer/id #uuid "9b934595-e962-5f66-92ad-1459448fc3f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{csc}⁡x" :db/id #edb/ref 17592186334361} {:answer/id #uuid "ac42fcd0-ffc7-5de1-898e-4c939cb2ddcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{csc}⁡x" :db/id #edb/ref 17592186334500} {:answer/id #uuid "bf60e8f1-2288-5385-a3b2-2dbc4285e786" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{csc}⁡x" :db/id #edb/ref 17592186334650} {:answer/id #uuid "e2c78f36-51ed-5212-9eb5-17a212ab6a42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{2}⁡x" :db/id #edb/ref 17592186334962}] :answer-field/correct {:db/id #edb/ref 17592186334361} :answer-field/id #uuid "26d09f32-d848-5314-ab3a-a425d7774882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335311}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5d58c970-2d4e-5275-a4bc-4ce44bad5af5" :question/math-academy-id "q-65463" :question/problem "Simplify $\\frac{{cot}^{2}⁡x}{\\operatorname{csc}⁡x-1}-1.$" :question/worked-solution "First, we multiply the numerator and the denominator of the fraction by $\\operatorname{csc}⁡x+1.$ This gives: \n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x}{\\operatorname{csc}⁡x-1} & =\\frac{{cot}^{2}⁡x}{\\operatorname{csc}⁡x-1}\\cdot \\frac{\\operatorname{csc}⁡x+1}{\\operatorname{csc}⁡x+1} \\\\  & =\\frac{{cot}^{2}⁡x\\,(\\operatorname{csc}⁡x+1)}{{csc}^{2}⁡x-1}\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta $, we have\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x\\,(\\operatorname{csc}⁡x+1)}{{csc}^{2}⁡x-1}-1 & =\\frac{{cot}^{2}⁡x\\,(\\operatorname{csc}⁡x+1)}{{cot}^{2}⁡x}-1 \\\\  & =\\frac{\\cancel{{cot}^{2}⁡x}\\,(\\operatorname{csc}⁡x+1)}{\\cancel{{cot}^{2}⁡x}}-1 \\\\  & =(\\operatorname{csc}⁡x+1)\\,-1 \\\\  & =\\operatorname{csc}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc982e4-c69b-533e-a8fe-cccac358ca96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186333248} {:answer/id #uuid "21a31dba-5f24-571d-9520-28aefdb82e0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186333289} {:answer/id #uuid "22886b05-c689-5ef5-837b-f8f9a4111abc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186333303} {:answer/id #uuid "eea843c9-af8e-5772-a5f2-36de1e49b8c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186335083} {:answer/id #uuid "f00173c6-d982-58c8-8d27-bffcb74b9d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186335091}] :answer-field/correct {:db/id #edb/ref 17592186335091} :answer-field/id #uuid "6f2e7169-4d6d-560f-8a19-8b547d6fae2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335456}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e53a0ef5-c396-5546-8d82-048f43ee6236" :question/math-academy-id "q-65487" :question/problem "Calculate $$\n\\displaystyle \\lim_{x\\to \\pi }{csc}^{2}⁡(\\frac{x}{3}-\\frac{\\pi }{6}).\n$$" :question/worked-solution "Substituting $x=\\pi $ directly into the limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to \\pi }{csc}^{2}⁡(\\frac{x}{3}-\\frac{\\pi }{6}) & ={csc}^{2}⁡(\\frac{\\pi }{3}-\\frac{\\pi }{6}) \\\\  & ={csc}^{2}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{{sin}^{2}⁡\\left(\\frac{\\pi }{6}\\right)} \\\\  & =\\frac{1}{{\\left(\\frac{1}{2}\\right)}^{2}} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19abe6cc-c0e6-5318-9bba-6e2d2be0a8f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{8}\\operatorname{cos}⁡(x-\\frac{\\pi }{2})" :db/id #edb/ref 17592186333225} {:answer/id #uuid "584da80b-6881-57f9-9a73-fd60f3431061" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{cos}⁡(8x-\\frac{\\pi }{2})" :db/id #edb/ref 17592186333794} {:answer/id #uuid "6f3f2813-cf64-5fed-a4b3-dce7fa30c100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{8}\\operatorname{cos}⁡(8x-\\frac{\\pi }{3})" :db/id #edb/ref 17592186334003} {:answer/id #uuid "8228473f-1341-5722-8de6-b9c7383e7b2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{cos}⁡(4x-\\frac{\\pi }{4})" :db/id #edb/ref 17592186334149} {:answer/id #uuid "e7878ec1-9cca-5547-9557-c028b73cc117" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{cos}⁡(8x-\\frac{\\pi }{4})" :db/id #edb/ref 17592186335009}] :answer-field/correct {:db/id #edb/ref 17592186335009} :answer-field/id #uuid "170fe1bc-1fe3-533a-bfa3-e6dd43964564" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335282}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "96ac7103-36fb-556e-9958-61a600af1557" :question/math-academy-id "q-65508" :question/problem "$\\operatorname{cos}⁡(8x)+\\operatorname{sin}⁡(8x)=$" :question/worked-solution "The difference formula for cosine gives  \n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(8x-ϕ) & =R(\\operatorname{cos}⁡(8x)\\operatorname{cos}⁡ϕ+\\operatorname{sin}⁡(8x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡(8x)+R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡(8x).\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\operatorname{cos}⁡(8x)+\\operatorname{sin}⁡(8x)=R\\operatorname{cos}⁡(8x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\operatorname{cos}⁡(8x)+\\operatorname{sin}⁡(8x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡(8x)+(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡(8x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(8x)$ and $\\operatorname{cos}⁡(8x),$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=1 \\\\ R\\operatorname{sin}⁡ϕ &=1\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =1 \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡(1) \\\\ ϕ & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{sin}⁡ϕ)}^{2}+{(R\\operatorname{cos}⁡ϕ)}^{2} & ={1}^{2}+{1}^{2} \\\\ {R}^{2}({sin}^{2}⁡ϕ+{cos}^{2}⁡ϕ) & =2 \\\\ {R}^{2} & =2 \\\\ R & =\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\operatorname{cos}⁡(8x)+\\operatorname{sin}⁡(8x)=\\sqrt{2}\\operatorname{cos}⁡(8x-\\frac{\\pi }{4})\n$$"} {:db/id #edb/ref 17592186335844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c547b3f-9339-595e-9c3b-bc8ccefbdde1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186333977} {:answer/id #uuid "838ef890-d3a5-5e2a-baa4-5087b6183fb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186334161} {:answer/id #uuid "92c9f30b-2345-579c-99b2-e381db401faf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186334297} {:answer/id #uuid "b86ad773-1bf6-5c5c-a1ec-cbec8b70ac7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186334607} {:answer/id #uuid "bac43c09-1a62-575b-859f-1093b2e87bda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡\\theta -1" :db/id #edb/ref 17592186334618}] :answer-field/correct {:db/id #edb/ref 17592186334607} :answer-field/id #uuid "e473e965-3027-57ff-92f7-4bb13a04d812" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335636}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af934b5c-060e-559f-be83-e39a6825ecbb" :question/math-academy-id "q-65518" :question/problem "Simplify $$\n\\displaystyle \\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}.\n$$" :question/worked-solution "First, we multiply the numerator and the denominator of our expression by $\\operatorname{csc}⁡\\theta +1.$ This gives:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta }{\\operatorname{csc}⁡\\theta -1} & =\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}\\cdot \\frac{\\operatorname{csc}⁡\\theta +1}{\\operatorname{csc}⁡\\theta +1} \\\\  & =\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1)}{{csc}^{2}⁡\\theta -1}\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta $, we have\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1)}{{csc}^{2}⁡\\theta -1} & =\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1)}{{cot}^{2}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta \\,\\cancel{\\operatorname{cot}⁡\\theta }\\,(\\operatorname{csc}⁡\\theta +1)}{\\cancel{\\operatorname{cot}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\,\\operatorname{tan}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1) \\\\  & =\\cancel{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{sin}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }}\\,(\\operatorname{csc}⁡\\theta +1) \\\\  & =\\operatorname{sin}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1) \\\\  & =\\operatorname{sin}⁡\\theta \\,\\operatorname{csc}⁡\\theta +\\operatorname{sin}⁡\\theta  \\\\  & =\\cancel{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{\\cancel{\\operatorname{sin}⁡\\theta }}+\\operatorname{sin}⁡\\theta  \\\\  & =1+\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a86178-ac2b-5064-bbef-24b714b35fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186333010} {:answer/id #uuid "100a41bd-f87c-5386-bea8-85fb6e792893" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186333135} {:answer/id #uuid "3201b65a-32bd-5085-804e-586b0121763c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186333449} {:answer/id #uuid "8b2da2de-d9b1-5869-aee5-26fcc9196fb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186334233} {:answer/id #uuid "a6c83394-62d2-5204-a21d-e098e69662d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186334452}] :answer-field/correct {:db/id #edb/ref 17592186333135} :answer-field/id #uuid "7854bf16-47e5-5e5d-814d-597d16c77ac2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335469}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8c85c8f9-aa62-59e2-9ab2-63e22c0c922b" :question/math-academy-id "q-65574" :question/problem "Given that the expression $2\\operatorname{cos}⁡(4x)-3\\operatorname{sin}⁡(4x)$ can be written as $R\\operatorname{cos}⁡(4x+ϕ)$ with $R>0$, what is the value of $R?$" :question/worked-solution "The sum formula for cosine gives\n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(4x+ϕ) & =R(\\operatorname{cos}⁡(4x)\\operatorname{cos}⁡ϕ-\\operatorname{sin}⁡(4x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡(4x)-R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡(4x).\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{cos}⁡(4x)-3\\operatorname{sin}⁡(4x)=R\\operatorname{cos}⁡(4x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\operatorname{cos}⁡(4x)-3\\operatorname{sin}⁡(4x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡(4x)-(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡(4x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(4x)$ and $\\operatorname{cos}⁡(4x),$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=2 \\\\ R\\operatorname{sin}⁡ϕ &=3\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={2}^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =4+9 \\\\ {R}^{2} & =13 \\\\ R & =\\sqrt{13}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186335851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51f822cc-9011-564d-a319-7e858702bba7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{tan}⁡{40}^{∘}" :db/id #edb/ref 17592186333741} {:answer/id #uuid "58aee23b-c030-5778-b8f2-1a0f7ac7d41f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{sin}^{2}⁡{40}^{∘}" :db/id #edb/ref 17592186333797} {:answer/id #uuid "a747ffa4-2586-52ed-94cc-185d0de824ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{tan}⁡{80}^{∘}" :db/id #edb/ref 17592186334454} {:answer/id #uuid "b85d3e93-e364-5833-9a9e-bd9e1b1c25e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{80}^{∘}" :db/id #edb/ref 17592186334604} {:answer/id #uuid "e9eda8bc-ed46-550f-bce8-9742da7af733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{40}^{∘}" :db/id #edb/ref 17592186335036}] :answer-field/correct {:db/id #edb/ref 17592186333797} :answer-field/id #uuid "3563fe79-e30f-5bee-996d-0c0791b16f44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335344}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95efa6da-7216-501c-8391-1e0cbd18db0c" :question/math-academy-id "q-65614" :question/problem "$\\frac{\\operatorname{sin}⁡{80}^{∘}}{\\operatorname{cot}⁡{40}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={40}^{∘}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot {40}^{∘})=2\\operatorname{sin}⁡{40}^{∘}\\operatorname{cos}⁡{40}^{∘}\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡{80}^{∘}=2\\operatorname{sin}⁡{40}^{∘}\\operatorname{cos}⁡{40}^{∘}.\n$$\n\nRewriting the given expression using the above, we get\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{80}^{∘}}{\\operatorname{cot}⁡{40}^{∘}} & =\\frac{2\\operatorname{sin}⁡{40}^{∘}\\operatorname{cos}⁡{40}^{∘}}{\\frac{\\operatorname{cos}⁡{40}^{∘}}{\\operatorname{sin}⁡{40}^{∘}}} \\\\  & =\\frac{2{sin}^{2}⁡{40}^{∘}\\cancel{\\operatorname{cos}⁡{40}^{∘}}}{\\cancel{\\operatorname{cos}⁡{40}^{∘}}} \\\\  & =2{sin}^{2}⁡{40}^{∘}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033ef8e4-0132-5350-9528-79791d39157f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-sin⁡x" :db/id #edb/ref 17592186333016} {:answer/id #uuid "05706693-651e-5af5-88bc-7c7abc314b77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x" :db/id #edb/ref 17592186333033} {:answer/id #uuid "4520ae98-6137-51d9-b2c0-231555a091a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡x" :db/id #edb/ref 17592186333626} {:answer/id #uuid "533819be-4b03-5d22-a290-f81f12054451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡x" :db/id #edb/ref 17592186333750} {:answer/id #uuid "a55b318a-93a5-5c83-b16d-1159e2d7db6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(-x)" :db/id #edb/ref 17592186334438}] :answer-field/correct {:db/id #edb/ref 17592186333016} :answer-field/id #uuid "f368aa2c-5de9-5845-b01e-79241fa4219e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335666}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d44d9e4-10a4-5028-9ccd-84ebf594536b" :question/math-academy-id "q-65832" :question/problem "![](images/6b/6b7b001374d8ef011bc9f2e11cd84b53837c5f4e4133acc31e241cc91c9bd08d.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/db/dba90d9fc6f17599a41cd301247ec604726adb3454a4cee740c639d64c40618f.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $x$-axis.\n\nTherefore, the given curve is the graph of $y=-sin⁡x.$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\nsin⁡(-x)=-sin⁡x\n$$\n\nSo the graph could also be viewed as $y=sin⁡(-x).$ However, $y=sin⁡(-x)$ is not among the given options."} {:db/id #edb/ref 17592186335882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285d4843-cd4f-5207-9292-62707f46fbf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡(-x)-\\frac{1}{2}" :db/id #edb/ref 17592186333361} {:answer/id #uuid "52191854-3baf-5224-9f57-aa2cb071cc8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡(x)+2" :db/id #edb/ref 17592186333743} {:answer/id #uuid "d6be4195-bbc4-5627-83a5-10d37a217d59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2sin⁡(x)" :db/id #edb/ref 17592186334871} {:answer/id #uuid "d8bb0b06-8bba-5ecc-a784-f279a8c4a196" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{sin⁡(-x)}{2}" :db/id #edb/ref 17592186334889} {:answer/id #uuid "e86f09d6-9de7-530a-9842-1feed787e882" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡(x)-\\frac{1}{2}" :db/id #edb/ref 17592186335017}] :answer-field/correct {:db/id #edb/ref 17592186334889} :answer-field/id #uuid "ec0d9461-28a5-572c-9ac1-d1d89eb7c142" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335653}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "53d87565-73be-5249-961a-54ceaa8f563b" :question/math-academy-id "q-66202" :question/problem "![](images/79/7971e513c06a153a695cb7067514f0d69fd4c35711ea38c08184e25ccf72359a.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/5f/5f2e6c5d15161d02edc1ce014d926447cf4915e4b00b84b8c3935f9fbd8408d4.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $\\frac{1}{2}.$\n\nTherefore, the given curve is the graph of $y=\\frac{sin⁡(-x)}{2}.$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n\\frac{sin⁡(-x)}{2}=-\\frac{sin⁡(x)}{2}\n$$\n\nSo the graph could also be viewed as $y=-\\frac{sin⁡(x)}{2}.$ However, $y=-\\frac{sin⁡(x)}{2}$ is not among the given options."} {:db/id #edb/ref 17592186335888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff79e6f-631d-5bfd-a1aa-fa86f14ee9be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+2\\pi " :db/id #edb/ref 17592186333132} {:answer/id #uuid "18111461-7ace-5659-bab8-5208f982db48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186333204} {:answer/id #uuid "4096de65-1ecc-5d30-b6da-44dcd7d64fba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186333598} {:answer/id #uuid "5121b2ec-f55e-536b-9787-5bf44f6de907" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186333730} {:answer/id #uuid "d9ea6224-cc9f-5fe3-a180-63519162e08d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186334899}] :answer-field/correct {:db/id #edb/ref 17592186333730} :answer-field/id #uuid "39aaac3a-a375-54e9-93b9-3f8aae2090b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335350}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f32325ca-f6af-5642-b811-5b2d78cf8877" :question/math-academy-id "q-66594" :question/problem "If $tan⁡x=\\sqrt{3},$ for some $x$, find the value of $tan⁡(x-5\\pi ).$" :question/worked-solution "The period of $y=tan⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\ntan⁡x=tan⁡(x+n\\pi ).\n$$\n\nSubstituting $n=-5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}tan⁡x=tan⁡(x+(-5)\\cdot \\pi )=tan⁡(x-5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $tan⁡x=\\sqrt{3},$ we get that $tan⁡(x-5\\pi )=\\sqrt{3}.$"} {:db/id #edb/ref 17592186335890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f5104a-6ff3-54f4-aa5c-62ed37ead198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186333080} {:answer/id #uuid "63585c27-7a3a-5092-97b9-8b6f85d39e1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+\\pi " :db/id #edb/ref 17592186333888} {:answer/id #uuid "73594949-931f-5c38-acef-ed3ae383d30a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186334034} {:answer/id #uuid "a44c1fdd-bd1b-547b-a00c-f61e00401b03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}+2\\pi " :db/id #edb/ref 17592186334431} {:answer/id #uuid "fac57336-3737-5816-be0e-c9b839b24604" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186335186}] :answer-field/correct {:db/id #edb/ref 17592186334034} :answer-field/id #uuid "73908950-ca6a-51b9-b8ec-b5131be094bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335461}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fd590154-6c93-5483-8fea-428e3503f4be" :question/math-academy-id "q-66603" :question/problem "If $sec⁡x=\\frac{5}{2},$ then what is $4sec⁡(x+10\\pi )-3?$" :question/worked-solution "The period of $y=sec⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\nsec⁡x=sec⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}sec⁡x=sec⁡(x+2\\cdot 5\\cdot \\pi )=sec⁡(x+10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $sec⁡x=\\frac{5}{2},$ then $sec⁡(x+10\\pi )=\\frac{5}{2}.$\n\nFinally, then\n\n$$\n\\begin{aligned}4sec⁡(x+10\\pi )-3 & =4\\left(\\frac{5}{2}\\right)-3 \\\\  & =2(5)-3 \\\\  & =10-3 \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fcc95b7-91cb-5f53-b2b4-14c160ac23f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{log}_{2}⁡(4)-1}{2}" :db/id #edb/ref 17592186333130} {:answer/id #uuid "1fee1fb9-8ce7-5c33-9527-a0c47b96d1d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{log}_{2}⁡(4)-3" :db/id #edb/ref 17592186333276} {:answer/id #uuid "6bc04c65-425c-55e0-bd35-d36446347529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{log}_{2}⁡(3)+4}{3}" :db/id #edb/ref 17592186333973} {:answer/id #uuid "e5dda201-b2e5-5bec-bcf3-83fd40ff3a18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{log}_{2}⁡(3)-4" :db/id #edb/ref 17592186334991} {:answer/id #uuid "ebbb4348-b2e4-55f9-888a-af1a3b679fbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{log}_{2}⁡(3)+2}{3}" :db/id #edb/ref 17592186335052}] :answer-field/correct {:db/id #edb/ref 17592186333973} :answer-field/id #uuid "16895044-6f72-57ec-9658-5a2d0c3c1e53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335281}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "654ddb09-7601-52b6-a0ce-0c0c3d4e9e1f" :question/math-academy-id "q-66674" :question/problem "Find the root of $f(x)=-{2}^{3x-4}+81.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-{2}^{3x-4}+81=0\n$$\n\nFirst, we isolate the term with the variable exponent by subtracting $81$ from both sides:\n\n$$\n\\begin{aligned}-{2}^{3x-4}+81 & =0 \\\\ -{2}^{3x-4}+\\cancel{81}-\\cancel{81} & =0-81 \\\\ -{2}^{3x-4} & =-81 \\\\ {2}^{3x-4} & =81\\end{aligned}\n$$\n\nNow, we rewrite $81$ as ${3}^{4}$ to get\n\n$$\n{2}^{3x-4}={3}^{4}.\n$$\n\nThen we take ${log}_{2}$ of both sides of the equation:\n\n$$\n\\begin{aligned}{2}^{3x-4} & ={3}^{4} \\\\ {log}_{2}⁡({2}^{3x-4}) & ={log}_{2}⁡({3}^{4}) \\\\ 3x-4 & =4{log}_{2}⁡(3)\\end{aligned}\n$$\n\nFinally, we solve for $x$ as follows:\n\n$$\n\\begin{aligned}3x-4 & =4{log}_{2}⁡(3) \\\\ 3x & =4{log}_{2}⁡(3)+4 \\\\ x & =\\frac{4{log}_{2}⁡(3)+4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a380137-f59b-5306-a7a0-f3353de4ed0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186333229} {:answer/id #uuid "bf0d53db-4f56-5d47-834f-5d0a01b3b218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186334645} {:answer/id #uuid "c4ecd3ad-6a48-51e0-8fbe-3683fafde9a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186334700} {:answer/id #uuid "d2d7434a-a12d-54d8-b9e6-b5586d783803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}-4" :db/id #edb/ref 17592186334833} {:answer/id #uuid "d2f9298f-edad-54b0-8f2a-c96bc8cdcdd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+\\pi " :db/id #edb/ref 17592186334835}] :answer-field/correct {:db/id #edb/ref 17592186334645} :answer-field/id #uuid "6ed8dda0-5ccd-57b5-b04b-85458a4c39d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335455}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93cbc51f-bbe5-5350-b365-2efa0de8e1c8" :question/math-academy-id "q-66675" :question/problem "If $cot⁡x=\\sqrt{3}$ for some $x$, then find the value of $\\sqrt{3}cot⁡(x-\\pi )-4.$" :question/worked-solution "The period of $y=cot⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\ncot⁡x=cot⁡(x+n\\pi ).\n$$\n\nSubstituting $n=-1$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cot⁡x=cot⁡(x+(-1)\\cdot \\pi )=cot⁡(x-\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cot⁡x=\\sqrt{3},$ then $cot⁡(x-\\pi )=\\sqrt{3}.$\n\nFinally, then\n\n$$\n\\begin{aligned}\\sqrt{3}cot⁡(x-\\pi )-4 & =\\sqrt{3}(\\sqrt{3})-4 \\\\  & ={(\\sqrt{3})}^{2}-4 \\\\  & =3-4 \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ab7be2-dda3-5ed1-ac99-09c91d8ee0ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.277" :db/id #edb/ref 17592186333224} {:answer/id #uuid "30349d58-fc74-5b3b-bdfe-f35ac2999f7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.277" :db/id #edb/ref 17592186333435} {:answer/id #uuid "6e2a8989-51b3-5e13-ad5b-1afbc9a8f5cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.727" :db/id #edb/ref 17592186333990} {:answer/id #uuid "8324c711-5a4c-5526-bb63-c83f0d9eb296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.554" :db/id #edb/ref 17592186334159} {:answer/id #uuid "e0fa9c4c-5512-58eb-91d1-4c102e05372d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.554" :db/id #edb/ref 17592186334947}] :answer-field/correct {:db/id #edb/ref 17592186333435} :answer-field/id #uuid "4ff74f9c-19ae-5a3d-b268-bbf4ae9475d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335393}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "773f6463-e638-5263-aed4-c3fe89e22103" :question/math-academy-id "q-66902" :question/problem "Given that ${e}^{-5z}-6=-2,$ find the value of $z$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{-5z}-6 & =-2 \\\\ {e}^{-5z} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $z:$\n\n$$\n\\begin{aligned}{e}^{-5z} & =4 \\\\ ln⁡({e}^{-5z}) & =ln⁡(4) \\\\ -5z & =ln⁡(4) \\\\ z & =-\\frac{1}{5}ln⁡(4)\\end{aligned}\n$$\n\nTherefore, the solution is $z=-\\frac{1}{5}ln⁡(4)$\n\nEvaluating the above expression using a calculator gives\n\n$$\nz≈-0.277\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186335936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d0a8d6-dd5c-5ada-ba81-6811efa73ea9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x)+2.5" :db/id #edb/ref 17592186333307} {:answer/id #uuid "6ba1571a-c69c-54ef-92c0-04231b476124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x)-2.5" :db/id #edb/ref 17592186333972} {:answer/id #uuid "82cafcb1-6f62-5bfa-8ec0-d95708604141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2.5cos⁡(x)" :db/id #edb/ref 17592186334156} {:answer/id #uuid "90d4a85c-d91e-55da-8cbd-2e2ddccc0ad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x-2.5)" :db/id #edb/ref 17592186334280} {:answer/id #uuid "faf2bb54-d402-5ea0-b2d3-cd26182544c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2.5cos⁡(x)" :db/id #edb/ref 17592186335190}] :answer-field/correct {:db/id #edb/ref 17592186335190} :answer-field/id #uuid "ace9f282-a1a0-512c-8ddd-151c9a5d4e42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335557}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "383facd7-6cf2-5beb-9871-d9e7438338db" :question/math-academy-id "q-6769" :question/problem "![](images/b2/b2a714b91a3645643ac0e48696351b5d75d83cc5f79e42fdcc3f66c3210fe1d0.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/81/819b958aae76aa74f486ba9db7a8dcd5fcddd7bdeba9e03fcc75c479970dc690.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $2.5$ to give $y=-2.5cos⁡x$\n\nTherefore, the given curve is the graph of $y=-2.5cos⁡x.$"} {:db/id #edb/ref 17592186335938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c894b2-3d81-5866-ab49-9b1c828b6194" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x)+2" :db/id #edb/ref 17592186333192} {:answer/id #uuid "3116800f-efc0-515f-989a-20b0d4eccaae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x)-3" :db/id #edb/ref 17592186333441} {:answer/id #uuid "3a5fa3be-8ebe-5089-bdbc-621d2d0ed4e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x)+3" :db/id #edb/ref 17592186333534} {:answer/id #uuid "3dcf9598-531e-5c88-befb-5c6dbd086cdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x+3)" :db/id #edb/ref 17592186333572} {:answer/id #uuid "64ef4862-fb0d-59fd-b8c1-70a3fb9da318" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x)+3" :db/id #edb/ref 17592186333906}] :answer-field/correct {:db/id #edb/ref 17592186333534} :answer-field/id #uuid "5fd2c056-3fcf-5650-9bc7-4bc5dba7e512" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335428}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a9e39af0-331a-552a-ad75-1266c08a979d" :question/math-academy-id "q-6778" :question/problem "![](images/6b/6b142e1a5cb0b74e80311bb196d881f9f4fa7c8fc02ea5a9f0059cc79f23a270.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](images/ff/ffb62cf374d04f9d39a47a0f4bcac47548ed873c3a5e7fbd3c3bc2bf2a0a5803.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\n- Finally, translate it by $3$ units **up** to give $y=-cos⁡x+3$\n\nTherefore, the given curve is the graph of $y=-cos⁡x+3.$"} {:db/id #edb/ref 17592186335962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "073e778a-1825-51a2-9ad1-a82b274fb53c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x-3" :db/id #edb/ref 17592186333060} {:answer/id #uuid "0d713fc1-f074-51d4-98ee-f6f0351dee53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x-4" :db/id #edb/ref 17592186333107} {:answer/id #uuid "32130189-4879-50a8-bdad-e13cfabab40c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x-5" :db/id #edb/ref 17592186333451} {:answer/id #uuid "44f3839d-6c5f-524b-8345-05526e741692" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-sin⁡x-4" :db/id #edb/ref 17592186333625} {:answer/id #uuid "df87933f-3fa5-5e9a-a624-b05a887cce49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-sin⁡x-3" :db/id #edb/ref 17592186334935}] :answer-field/correct {:db/id #edb/ref 17592186333625} :answer-field/id #uuid "c61743d3-c628-5015-b2a8-89e56d99be7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335600}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88bdf6d7-442e-5160-8753-e955f1016be4" :question/math-academy-id "q-68373" :question/problem "![](images/64/647a6e293f82df668c6ac536ef08836c843ddd4631f2f706bde841bb8c6b9d5a.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](images/61/61cb8a268b004f6420141cf562d56a9cc68323969a5ebc7ad500941ed3c134b2.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, translate it by $4$ units **down** to give $y=-sin⁡x-4$\n\nTherefore, the given curve is the graph of $y=-sin⁡x-4.$"} {:db/id #edb/ref 17592186335976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c842fc6-bdb7-5fd1-95ec-a8a6c5c213af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(7x)+C" :db/id #edb/ref 17592186333694} {:answer/id #uuid "8817bce9-1d12-59f6-a5d1-e12cf7bf9ea0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(7x)}{7}+C" :db/id #edb/ref 17592186334193} {:answer/id #uuid "d4994be2-56ea-5429-8d7d-0f2980d19115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(49x)}{7}+C" :db/id #edb/ref 17592186334851} {:answer/id #uuid "d5ef86d7-cffa-55cc-8343-9157ea5e011e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(7x)}{49}+C" :db/id #edb/ref 17592186334864} {:answer/id #uuid "eff32ea7-4fa2-5bab-91d2-777e88bff4bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(49x)+C" :db/id #edb/ref 17592186335089}] :answer-field/correct {:db/id #edb/ref 17592186333694} :answer-field/id #uuid "ebde86f4-5f82-5ab1-8866-0726b82f2be1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335652}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1090f68a-a5e7-5187-bfa4-8579cbfba1e4" :question/math-academy-id "q-69475" :question/problem "$$\n\\displaystyle \\int \\frac{7\\,\\text{d}x}{|7x|\\sqrt{(7x)^{2}-1}}=\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{7\\,\\text{d}x}{|7x|\\sqrt{(7x)^{2}-1}}=7\\int \\frac{\\text{d}x}{|7x|\\sqrt{(7x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $7x.$\n\nSo, let's substitute $u=7x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=7\\,⟹\\,\\text{d}x=\\frac{1}{7}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}7\\int \\frac{1}{|7x|\\sqrt{(7x)^{2}-1}}\\text{d}x & =7\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{7}\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(7x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48ed7e88-42a3-5874-867c-a70eb196b8de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(9x)+C" :db/id #edb/ref 17592186333661} {:answer/id #uuid "8bc52df5-2130-5724-8f9a-3900402db0a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(9x)}{3}+C" :db/id #edb/ref 17592186334237} {:answer/id #uuid "961ad6bb-bcc5-55c8-bf62-b1d0251abaec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(9x)}{9}+C" :db/id #edb/ref 17592186334325} {:answer/id #uuid "d33c5bc0-c46c-505d-825e-d5fb312cca88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(3x)}{81}+C" :db/id #edb/ref 17592186334839} {:answer/id #uuid "d9456840-7b87-506e-b8e7-b50a98cb1b55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(3x)+C" :db/id #edb/ref 17592186334895}] :answer-field/correct {:db/id #edb/ref 17592186334237} :answer-field/id #uuid "2ae037e8-4b57-5061-96fb-95244295292c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335317}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea572027-5f6a-57b6-b534-919c7f5636f2" :question/math-academy-id "q-69477" :question/problem "$$\n\\displaystyle \\int \\frac{3\\,\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}=\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{3\\,\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}=3\\int \\frac{\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $9x.$\n\nSo, let's substitute $u=9x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,⟹\\,\\text{d}x=\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}3\\int \\frac{1}{|9x|\\sqrt{(9x)^{2}-1}}\\text{d}x & =3\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{9}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{3}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(9x)}{3}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245f8b76-960f-5227-85be-1848c57026fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(ru-st)" :db/id #edb/ref 17592186333328} {:answer/id #uuid "5179db59-ecf5-527f-b152-14da85049ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6ru-3st" :db/id #edb/ref 17592186333736} {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} {:answer/id #uuid "be3cb9cd-cb94-5657-98ff-b3d91e1ff9d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6ru+3st" :db/id #edb/ref 17592186334635} {:answer/id #uuid "fa49eaa1-621e-5ca8-a141-b55927a350aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(2st-ru)" :db/id #edb/ref 17592186335181}] :answer-field/correct {:db/id #edb/ref 17592186334293} :answer-field/id #uuid "8926dc70-416f-5104-b768-f00f2078937e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335501}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f8c0050-79c4-5426-9e5c-a8628ebc0ae0" :question/math-academy-id "q-69650" :question/problem "Calculate $det(H)$, if\n$$\n\\displaystyle H=\\begin{bmatrix}-2r & 3s \\\\ -2t & 3u\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =\\begin{vmatrix}-2r & 3s \\\\ -2t & 3u\\end{vmatrix} \\\\  & =-2r\\cdot 3u-3s\\cdot (-2t) \\\\  & =-6ru-(-6st) \\\\  & =-6ru+6st \\\\  & =6(st-ru)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd1c86f-37e4-5b7b-9ec3-6d55d9670cea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186333244} {:answer/id #uuid "4342bd65-1b39-56fb-b10b-45b1a8deeebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186333618} {:answer/id #uuid "982f2c1a-e0ab-57c2-b71f-62ccc2593e9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186334339} {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186334384} {:answer/id #uuid "ab173fd5-9f80-5b1f-9676-76188073a554" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186334491}] :answer-field/correct {:db/id #edb/ref 17592186334384} :answer-field/id #uuid "8c672b33-f965-56dc-b5e9-ce679a558195" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335509}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66ad3ebb-398d-57e0-be2a-0ce7c08b87a1" :question/math-academy-id "q-69661" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}1-p & 1+p \\\\ -3 & 2\\end{bmatrix}\n$$\nand $det(S)=2$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}1-p & 1+p \\\\ -3 & 2\\end{vmatrix} \\\\  & =(1-p)\\cdot 2-(1+p)\\cdot (-3) \\\\  & =2-2p+3+3p \\\\  & =5+p\\end{aligned}\n$$\n\nSince $det(S)=2$, we obtain:\n\n$$\n\\begin{aligned}det(S) & =2 \\\\ 5+p & =2 \\\\ p & =2-5 \\\\ p & =-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157c690f-1dd1-51f7-bf6b-acb2edb20b9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5pq" :db/id #edb/ref 17592186333181} {:answer/id #uuid "22aca4b7-dd87-57bd-bedc-92bb1d3a6bf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6pq" :db/id #edb/ref 17592186333306} {:answer/id #uuid "3025c91d-8141-5951-81ae-a1980863cabc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{q}^{2}p" :db/id #edb/ref 17592186333434} {:answer/id #uuid "63668438-815a-5e67-bd57-5797e67bca40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{p}^{2}-3q" :db/id #edb/ref 17592186333889} {:answer/id #uuid "781a1c29-7128-5fa0-b474-7c1ed77336c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{q}^{2}{p}^{2}" :db/id #edb/ref 17592186334068}] :answer-field/correct {:db/id #edb/ref 17592186333181} :answer-field/id #uuid "53ac27d0-32a6-5d20-b7da-740074902a3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335404}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "76f42e6e-510a-5862-a8bc-fb0815ad8720" :question/math-academy-id "q-69739" :question/problem "What is the minor of ${e}_{32}$ in the matrix\n$$\n\\displaystyle E=\\begin{bmatrix}2p & p & -q \\\\ -p & {q}^{2} & 3q \\\\ q & 0 & q\\end{bmatrix}?\n$$" :question/worked-solution "First, we remove the third row and the second column:\n\n$$\nE=\\begin{bmatrix}2p & ∗ & -q \\\\ -p & ∗ & 3q \\\\ ∗ & 0 & ∗\\end{bmatrix}\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}2p & -q \\\\ -p & 3q\\end{bmatrix} & =\\begin{vmatrix}2p & -q \\\\ -p & 3q\\end{vmatrix} \\\\  & =2p\\cdot 3q-(-q)\\cdot (-p) \\\\  & =6pq-pq \\\\  & =5pq\\end{aligned}\n$$"} {:db/id #edb/ref 17592186336002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29db2e07-4b6d-54f8-ba95-10bee51c961c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{2}" :db/id #edb/ref 17592186333378} {:answer/id #uuid "49cfa5a1-6e00-5b05-8d7d-58210b470e27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}" :db/id #edb/ref 17592186333668} {:answer/id #uuid "d05791d8-db4c-54b4-87ee-40f1ccfb77ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-2{y}^{2}" :db/id #edb/ref 17592186334809} {:answer/id #uuid "de3475d0-f75a-5f97-a2bd-86534ad2f83e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}" :db/id #edb/ref 17592186334927} {:answer/id #uuid "e33ee508-1b50-57be-80b5-8cb3e0a56b21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}-2{x}^{2}" :db/id #edb/ref 17592186334968}] :answer-field/correct {:db/id #edb/ref 17592186334927} :answer-field/id #uuid "854d2d06-6a07-53ba-a693-f3251576dae9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335492}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63ee1edc-0af6-5ae3-b7c6-a4e20a5d93bd" :question/math-academy-id "q-69760" :question/problem "What is the minor of ${t}_{33}$ in the matrix\n$$\n\\displaystyle T=\\begin{bmatrix}y-x & x & {y}^{2} \\\\ -x & y+x & 1 \\\\ {x}^{2} & {y}^{2} & {x}^{2}\\end{bmatrix}?\n$$" :question/worked-solution "First, we remove the third row and third column:\n\n$$\nT=\\begin{bmatrix}y-x & x & ∗ \\\\ -x & y+x & ∗ \\\\ ∗ & ∗ & {x}^{2}\\end{bmatrix}\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}y-x & x \\\\ -x & y+x\\end{bmatrix} & =\\begin{vmatrix}y-x & x \\\\ -x & y+x\\end{vmatrix} \\\\  & =(y-x)\\cdot (y+x)-x\\cdot (-x) \\\\  & ={y}^{2}-{x}^{2}+{x}^{2} \\\\  & ={y}^{2}-\\cancel{{x}^{2}}+\\cancel{{x}^{2}} \\\\  & ={y}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186336011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89dca9db-88dc-5f58-9f23-ec98ca1bbc75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438478} {:answer/id #uuid "128f9548-3706-5b6d-94e4-afd0ea31e354" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438479}] :answer-field/correct {:db/id #edb/ref 17592186438479} :answer-field/id #uuid "f8abcdf3-f784-54de-90bb-b51f314f8912" :answer-field/key "$M$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439268} {:answer-field/choices [{:answer/id #uuid "1b74bddc-ad74-5f61-a0ce-c1bb3f545d9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438480} {:answer/id #uuid "f99619dc-7a17-50df-b37c-d5f5007df859" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438481}] :answer-field/correct {:db/id #edb/ref 17592186438480} :answer-field/id #uuid "96b81975-4ed5-5bfd-b978-ee8fdac7cf77" :answer-field/key "$det(M)=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439269} {:answer-field/choices [{:answer/id #uuid "ad1a88c7-0f27-56c5-b163-10cc23842fb0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438482} {:answer/id #uuid "97a592ec-ef1e-56af-8795-1ae139a9168a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438483}] :answer-field/correct {:db/id #edb/ref 17592186438483} :answer-field/id #uuid "92e3b518-970c-5ddb-8ddd-c289c427c026" :answer-field/key "$det(M)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439270}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "924829bc-4eac-54c3-82c8-f773955ca97e" :question/math-academy-id "q-69834" :question/problem "Which of the following statements are true regarding the matrix $M$ given below?\n\nSelect all that apply.\n\n$$\nM=\\begin{bmatrix}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{vmatrix} \\\\  & =1\\begin{vmatrix}2 & 3 \\\\ 4 & -2\\end{vmatrix}-(-2)\\begin{vmatrix}1 & 3 \\\\ -2 & -2\\end{vmatrix}+1\\begin{vmatrix}1 & 2 \\\\ -2 & 4\\end{vmatrix} \\\\  & =1(-4-12)+2(-2+6)+1(4+4) \\\\  & =1\\cdot (-16)+2\\cdot 4+1\\cdot 8 \\\\  & =-16+8+8 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(M)=0$, the matrix is singular. \n\nTherefore, only statements “$M$ is a singular matrix” and $det(M)=0$ are true."} {:db/id #edb/ref 17592186336020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d979261-b00f-5b07-934f-d9becb3fb3bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186333109} {:answer/id #uuid "1c91238d-36cf-527e-8b6b-6cad045c8204" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186333246} {:answer/id #uuid "7f8bf08b-1cc2-59de-a1ba-777b195023cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186334125} {:answer/id #uuid "82ae6838-8ddb-54d9-a045-f1a8ea096659" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186334155} {:answer/id #uuid "8737c0c8-20be-5d68-93e5-6d7c391191b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186334186}] :answer-field/correct {:db/id #edb/ref 17592186334125} :answer-field/id #uuid "1dcb8695-5ddf-5c8b-8e2f-29aa15a6844f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335294}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7214ad71-6f54-5736-979a-1f4039dc6fdd" :question/math-academy-id "q-69938" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨-2,3⟩$ and $\\text{v}=⟨4,-6⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}-2 & 4 \\\\ 3 & -6\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}-2 & 4 \\\\ 3 & -6\\end{vmatrix} \\\\  & =(-2)\\cdot (-6)-4\\cdot 3 \\\\  & =12-12 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"} {:db/id #edb/ref 17592186336021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028cd858-4c44-5058-9e3c-4454de059b84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186333009} {:answer/id #uuid "290f684f-0aeb-5e5e-8b27-ced38ee80d5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0