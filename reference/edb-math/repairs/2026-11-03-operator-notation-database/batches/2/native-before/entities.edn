592186336987} :answer-field/id #uuid "0033f394-fd38-57df-b724-8ce5cc5ff702" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338279}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e4929ca-7804-5d00-ada3-f06fc525c774" :question/math-academy-id "q-71663" :question/problem "$$\n\\displaystyle \\int -3{csc}^{2}⁡y\\,\\text{d}y=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3{csc}^{2}⁡y\\,\\text{d}y & =-3\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-3(-cot⁡y)+C \\\\  & =3cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f94094-a13e-59d3-8e01-6476ad259936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}y\\operatorname{tan}y+C" :db/id #edb/ref 17592186336421} {:answer/id #uuid "4bbf7e18-db54-5ad4-94b3-6740e294fa86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}y+C" :db/id #edb/ref 17592186336736} {:answer/id #uuid "5a246749-d6a8-5b61-ab0c-eb37e92ba4e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{tan}y+C" :db/id #edb/ref 17592186336853} {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}y+C" :db/id #edb/ref 17592186337182} {:answer/id #uuid "cbbba5ec-56d3-5218-abf9-36a5e07211a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cot}y+C" :db/id #edb/ref 17592186337821}] :answer-field/correct {:db/id #edb/ref 17592186337182} :answer-field/id #uuid "709f437f-6931-5254-8a8a-e5df59c326ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338469}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e6d46060-4d10-5e18-98aa-e065865069a6" :question/math-academy-id "q-71664" :question/problem "$$\n\\displaystyle \\int -{csc}^{2}⁡y\\,\\text{d}y=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -{csc}^{2}⁡y\\,\\text{d}y & =-\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-(-cot⁡y)+C \\\\  & =cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1034906a-3ff2-5190-aa84-370c8a694595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}x+5\\operatorname{cot}x+C" :db/id #edb/ref 17592186336183} {:answer/id #uuid "1c0f4398-2a00-57b0-b576-0d1d9a1b08b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}x+5\\operatorname{cot}x+C" :db/id #edb/ref 17592186336295} {:answer/id #uuid "51bee0d5-412a-55a2-aa71-c32c51cf3aef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}x-5\\operatorname{cot}x+C" :db/id #edb/ref 17592186336781} {:answer/id #uuid "5355af50-9329-57b3-b77f-0f36a4e5d909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-csc+5\\operatorname{tan}x+C" :db/id #edb/ref 17592186336801} {:answer/id #uuid "607d955e-a572-5487-a0b1-e0d64b2e6b4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "csc-5\\operatorname{tan}x+C" :db/id #edb/ref 17592186336905}] :answer-field/correct {:db/id #edb/ref 17592186336295} :answer-field/id #uuid "7bafaa70-1f4e-59fb-9e5a-6775a181aa39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338493}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19dfcc66-7eec-5ed4-8474-81621b4b91ab" :question/math-academy-id "q-71666" :question/problem "$$\n\\displaystyle \\int sin⁡x-5{csc}^{2}⁡x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int {csc}^{2}⁡x\\,\\text{d}x & =-cot⁡x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int sin⁡x-5{csc}^{2}⁡x\\,\\text{d}x & =\\int sin⁡x\\,\\text{d}x-5\\int {csc}^{2}⁡x\\,\\text{d}x \\\\  & =-cos⁡x-5(-cot⁡x)+C \\\\  & =-cos⁡x+5cot⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "683d9e7c-61f6-5de6-abad-84dcf004875f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{cos}⁡x+4\\text{ arcsin }x+C" :db/id #edb/ref 17592186336963} {:answer/id #uuid "6a0882b7-a0a9-5289-b162-ca60fabaa466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{sec}⁡x-4\\text{ arcsin }x+C" :db/id #edb/ref 17592186336972} {:answer/id #uuid "d8aeeeb4-e86e-575d-892e-520d2e23abb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sec}⁡x-4\\text{ arcsec }x+C" :db/id #edb/ref 17592186337915} {:answer/id #uuid "f072d725-648f-5f34-a953-94bede93b280" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C" :db/id #edb/ref 17592186338135} {:answer/id #uuid "f9cfd3a0-4ec2-51e0-bd20-788b4c0c89d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C" :db/id #edb/ref 17592186338221}] :answer-field/correct {:db/id #edb/ref 17592186338221} :answer-field/id #uuid "55c2f8e1-3b8a-59cf-bd39-ca69a03b409c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "897f7448-7037-589b-bc8e-e9ffe322f46d" :question/math-academy-id "q-71774" :question/problem "$$\n\\displaystyle \\int (5\\operatorname{sin}⁡x+\\frac{4}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int (5\\operatorname{sin}⁡x+\\frac{4}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x & =\\int 5\\operatorname{sin}⁡x\\,\\text{d}x+\\int \\frac{4}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =5\\int \\operatorname{sin}⁡x\\,\\text{d}x+4\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =5(-\\operatorname{cos}⁡x)+4\\text{ arcsec }x+C \\\\  & =-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af732f3-b0dc-5793-a81b-2631dc11f520" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\text{ arcsec }x+C" :db/id #edb/ref 17592186336435} {:answer/id #uuid "733c5a21-c647-52ab-a919-8a80bbbead81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\text{ arcsin }x+C" :db/id #edb/ref 17592186337069} {:answer/id #uuid "75c8a2d2-a396-596b-8050-fe63de4a5851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\text{ arctan }x+C" :db/id #edb/ref 17592186337091} {:answer/id #uuid "95948138-a8a6-5445-b9c9-fdd287efee17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\text{ arctan }x+C" :db/id #edb/ref 17592186337398} {:answer/id #uuid "e59b54b8-9fef-5db5-8ace-2e476c52cf06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\text{ arcsec }x+C" :db/id #edb/ref 17592186338036}] :answer-field/correct {:db/id #edb/ref 17592186338036} :answer-field/id #uuid "9f257272-2f12-50ae-a6fd-7184a295f711" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338567}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c37f5da7-d3e9-5087-b956-7bcf82e01ec3" :question/math-academy-id "q-71775" :question/problem "If ${f}^{′}(x)=\\frac{9}{|x|\\sqrt{{x}^{2}-1}},$ then $f(x)=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\left(\\frac{9}{|x|\\sqrt{{x}^{2}-1}}\\right)\\text{d}x \\\\  & =\\int \\frac{9}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =9\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =9\\text{ arcsec }x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fd7bbbf-6e0c-51c5-a9fa-fc0f2bf1d945" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467896} {:answer/id #uuid "c58e8001-ca94-52dc-9ac3-efcb68b4cfa2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467897}] :answer-field/correct {:db/id #edb/ref 17592186467897} :answer-field/id #uuid "0afb67d1-8168-5df5-930f-8190b07edc62" :answer-field/key "$R=\\begin{bmatrix}5 & 2 \\\\ 10 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468669} {:answer-field/choices [{:answer/id #uuid "f6fa4bf8-f217-5274-8dab-28c162bb278d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467898} {:answer/id #uuid "f93fd016-1442-53ad-8597-12bc1e59568b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467899}] :answer-field/correct {:db/id #edb/ref 17592186467899} :answer-field/id #uuid "a00bd3e1-111e-5780-871b-467da013e81a" :answer-field/key "$S=\\begin{bmatrix}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468670} {:answer-field/choices [{:answer/id #uuid "3f78fc2c-5319-559a-b65c-0b1064d9bbc8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467900} {:answer/id #uuid "906cb48c-7d29-5136-a248-2c29457a1fee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467901}] :answer-field/correct {:db/id #edb/ref 17592186467900} :answer-field/id #uuid "c4c5cafc-4559-5564-a3f4-1bb51c7edb62" :answer-field/key "$T=\\begin{bmatrix}2 & 2 \\\\ -2 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468671}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6118feb2-c751-599a-b3b9-c8c760c49b6d" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\nSelect all that apply." :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse."} {:db/id #edb/ref 17592186339017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b04e9358-9109-5802-a83d-c003136f6776" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467902} {:answer/id #uuid "711d5a0b-0232-5cb7-8a88-a13f69141094" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467903}] :answer-field/correct {:db/id #edb/ref 17592186467903} :answer-field/id #uuid "6b39826b-4d43-597b-b35d-5dd3a91ceaf8" :answer-field/key "$X=\\begin{bmatrix}2 & 1 \\\\ -4 & 6 \\\\ 10 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468672} {:answer-field/choices [{:answer/id #uuid "af6e952f-1b3d-5415-9986-1f855a35a9dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467904} {:answer/id #uuid "d5a6c71b-66a8-52d7-88ab-87e3a0607923" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467905}] :answer-field/correct {:db/id #edb/ref 17592186467904} :answer-field/id #uuid "9f838e05-1a03-57ee-8f9c-10a9e960bcdd" :answer-field/key "$Y=\\begin{bmatrix}6 & 5 \\\\ 7 & 6\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468673} {:answer-field/choices [{:answer/id #uuid "3e98450e-f707-5f45-880a-72823035ac85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467906} {:answer/id #uuid "3b62048c-e540-5983-8cbf-aabcf18ff59a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467907}] :answer-field/correct {:db/id #edb/ref 17592186467906} :answer-field/id #uuid "2386ffd6-0069-5a17-ae65-0bf5f760c977" :answer-field/key "$Z=\\begin{bmatrix}-2 & 1 \\\\ 10 & 5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468674}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f09c20fa-fbe3-5a9f-8218-d2a4dd2af13c" :question/math-academy-id "q-71938" :question/problem "Which of the matrices below does **not** have an inverse?\n\nSelect all that apply." :question/worked-solution "- The matrix $X$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $Y$, we have\n\n$$\ndet(Y)=6\\cdot 6-7\\cdot 5=1.\n$$\n\nBecause $det(Y)\\ne 0,$ we conclude that $Y$ is invertible.\n\n- For the matrix $Z$, we have\n\n$$\ndet(Z)=(-2)\\cdot 5-10\\cdot 1=-20.\n$$\n\nBecause $det(Z)\\ne 0,$ we conclude that $Z$ is invertible.\n\nTherefore, only $X$ does not have an inverse."} {:db/id #edb/ref 17592186339028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16f0d1eb-63da-516d-b39c-98936ea702c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2}" :db/id #edb/ref 17592186336248} {:answer/id #uuid "3e475449-d5a0-5355-9040-0c60f6ed7506" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186336619} {:answer/id #uuid "4b8e773e-5ecc-5ed1-a6ae-65cce087450b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1" :db/id #edb/ref 17592186336734} {:answer/id #uuid "94bf4718-c6d0-59d1-9ec4-b22670dd22eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186337391} {:answer/id #uuid "96bb9ff0-d964-5085-8a7c-e0e55abb0c09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186337403}] :answer-field/correct {:db/id #edb/ref 17592186337403} :answer-field/id #uuid "01585e92-cf9f-5695-8971-52db4143edc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338280}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f42b909-72e3-5c68-a789-fc35f80e300c" :question/math-academy-id "q-71967" :question/problem "If $V=\\begin{bmatrix}7 & y \\\\ 5 & y\\end{bmatrix}$ is a singular matrix, calculate the value of $y.$" :question/worked-solution "The matrix $V$ is singular if and only if $det(V)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(V) & =7\\cdot y-5\\cdot y \\\\  & =7y-5y \\\\  & =2y\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $y:$\n\n$$\n\\begin{aligned}2y & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the value of $y$ is $y=0.$"} {:db/id #edb/ref 17592186339029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1608f206-6cae-571f-8d1e-16b6d162d46d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c=\\pm 6" :db/id #edb/ref 17592186336238} {:answer/id #uuid "287ca0dc-331e-527d-b8c0-e766a590d0c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c=\\pm 5" :db/id #edb/ref 17592186336411} {:answer/id #uuid "8f1fd271-6941-56e0-8167-86c17416a68a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c=-5" :db/id #edb/ref 17592186337323} {:answer/id #uuid "9f6e027a-7384-58dc-b2bb-94433e7f22eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c=6" :db/id #edb/ref 17592186337473} {:answer/id #uuid "e2f32404-27a9-5015-979f-c6987e1fe3c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c=5" :db/id #edb/ref 17592186338010}] :answer-field/correct {:db/id #edb/ref 17592186336411} :answer-field/id #uuid "53c72237-b3c8-5418-adbd-d5b4558f878e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338421}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d71eb817-7b8e-5d55-9dca-4bfa26de23cc" :question/math-academy-id "q-71968" :question/problem "If $H=\\begin{bmatrix}5 & c \\\\ c & 5\\end{bmatrix}$ is a singular matrix, calculate the value(s) of $c.$" :question/worked-solution "The matrix $H$ is singular if and only if $det(H)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(H) & =5\\cdot 5-c\\cdot c \\\\  & =25-{c}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $c:$\n\n$$\n\\begin{aligned}25-{c}^{2} & =0 \\\\ {c}^{2} & =25 \\\\ c & =\\pm 5\\end{aligned}\n$$\n\nTherefore, the values of $c$ are $c=\\pm 5.$"} {:db/id #edb/ref 17592186339030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f062ffd-0731-5c9d-b5df-1e280483ad62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-\\frac{3}{4}" :db/id #edb/ref 17592186336623} {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=0" :db/id #edb/ref 17592186337259} {:answer/id #uuid "9d1a9b12-eb65-52f2-be17-471977096571" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=5" :db/id #edb/ref 17592186337454} {:answer/id #uuid "db1521d6-6365-5c27-8635-662375c34db6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-5" :db/id #edb/ref 17592186337942} {:answer/id #uuid "e0112779-824d-50fa-a23d-b42b80a0e397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186337989}] :answer-field/correct {:db/id #edb/ref 17592186337259} :answer-field/id #uuid "82b667e3-83f0-533b-abd1-94355475f197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338510}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35c7dc25-96f0-5d9f-9d6a-dfbf5fcfb320" :question/math-academy-id "q-71969" :question/problem "If $M=\\begin{bmatrix}t & 4 \\\\ t & 10\\end{bmatrix}$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 10-t\\cdot 4 \\\\  & =10t-4t \\\\  & =6t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}6t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"} {:db/id #edb/ref 17592186339037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d94167b-5219-5c95-adcf-466464405ded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10\\text{i}" :db/id #edb/ref 17592186336879} {:answer/id #uuid "5e445890-ee12-5ee5-868a-d15e086c9f2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186336887} {:answer/id #uuid "796f67ec-bf65-5b9e-9f05-bc5b46846bb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-10\\text{i}" :db/id #edb/ref 17592186337123} {:answer/id #uuid "8a19e0e7-d593-5ee0-9374-80aefa2b1883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186337276} {:answer/id #uuid "fc43da1f-0ea0-5151-ac6b-538adc7539ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\text{i}" :db/id #edb/ref 17592186338246}] :answer-field/correct {:db/id #edb/ref 17592186337276} :answer-field/id #uuid "cf0e56bc-7b5d-51e6-8f15-5d75ab80e476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338645}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f201cb9b-2797-5afe-8d09-6f74e3afd294" :question/math-academy-id "q-71984" :question/problem "If $z=3+5\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=3+5\\text{i},$ the real part is $Re(z)=3,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(3) \\\\  & =6.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=3+5\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=3-5\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(3+5\\text{i})+(3-5\\text{i}) \\\\  & =(3+3)+\\text{i}(5-5) \\\\  & =6+\\text{i}0 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e439a-9165-56c6-8fdd-b21c8dea91e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8+14\\text{i}" :db/id #edb/ref 17592186336212} {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186336285} {:answer/id #uuid "1e6f5eb4-3b18-507b-9c32-4ce046ab8046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186336313} {:answer/id #uuid "d95dea67-8da9-5f2b-8c58-9a5fb247332b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\text{i}" :db/id #edb/ref 17592186337923} {:answer/id #uuid "f90cfae7-9eea-5dc8-8b18-628804095bea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186338215}] :answer-field/correct {:db/id #edb/ref 17592186336285} :answer-field/id #uuid "bd3178b7-71a4-5c4f-9b23-601af5c49da4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338617}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "568e1d1c-4c3e-536f-acb0-c6800da06527" :question/math-academy-id "q-71986" :question/problem "If $z=4+7\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=4+7\\text{i},$ the real part is $Re(z)=4,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(4) \\\\  & =8.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=4+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=4-7\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(4+7\\text{i})+(4-7\\text{i}) \\\\  & =(4+4)+\\text{i}(7-7) \\\\  & =8+\\text{i}0 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090db98a-2198-5da0-9837-071df361432d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186336107} {:answer/id #uuid "0c0106bc-7eda-5739-865a-3ec472711715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186336143} {:answer/id #uuid "4a8b49fd-9945-5fa1-90e0-defa4f987d27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\text{i}" :db/id #edb/ref 17592186336719} {:answer/id #uuid "aa6ee515-bf67-58ad-93ca-31b6bde416b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16+4\\text{i}" :db/id #edb/ref 17592186337569} {:answer/id #uuid "e36b9eaf-e854-57c1-86e9-55195be22df1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\text{i}" :db/id #edb/ref 17592186338015}] :answer-field/correct {:db/id #edb/ref 17592186336143} :answer-field/id #uuid "e0a1ef25-5cc5-537c-add5-f17e36d13d37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338672}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b985b2e-c022-50e4-a165-b4a8255e9bf1" :question/math-academy-id "q-71987" :question/problem "If $z=-8+2\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=-8+2\\text{i},$ the real part is $Re(z)=-8,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(-8) \\\\  & =-16.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-8+2\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-8-2\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(-8+2\\text{i})+(-8-2\\text{i}) \\\\  & =(-8+(-8))+\\text{i}(2-2) \\\\  & =-16+\\text{i}0 \\\\  & =-16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} {:answer/id #uuid "58b493c2-73d3-5db1-af15-0200a2937632" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186336844} {:answer/id #uuid "daf20704-2d65-5753-af90-f6e026c52e12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186337940} {:answer/id #uuid "ec4261ce-b5b3-5551-9fbd-56937e1eea24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186338091} {:answer/id #uuid "f7a97ce9-ff10-5758-b496-1ffe87d0bb3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186338202}] :answer-field/correct {:db/id #edb/ref 17592186336327} :answer-field/id #uuid "f930863c-55bb-55cc-bd9d-51b8ae4abea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338715}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9daecf1-e255-5c0c-a433-fdc798f551aa" :question/math-academy-id "q-72059" :question/problem "Calculate $$\n\\displaystyle \\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.\n$$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $$\n\\displaystyle -\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}\n$$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146ee98c-9e3d-59ea-b87c-00cdc34a5726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5{sin}^{7}⁡x" :db/id #edb/ref 17592186336225} {:answer/id #uuid "14dd93d6-22de-5579-9c40-bd091e9348e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡x{sin}^{7}⁡x" :db/id #edb/ref 17592186336229} {:answer/id #uuid "52065413-ca3d-5d6e-ba7f-0eae0320fd51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-40\\operatorname{cos}⁡x{sin}^{7}⁡x" :db/id #edb/ref 17592186336786} {:answer/id #uuid "9ff0b52a-3ba0-5515-9ea8-71447c670910" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-40{cos}^{7}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337479} {:answer/id #uuid "de50a041-b819-5dde-87df-ba80e14ef96c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40{cos}^{7}⁡x" :db/id #edb/ref 17592186337968}] :answer-field/correct {:db/id #edb/ref 17592186337479} :answer-field/id #uuid "9263207c-9def-540d-8075-a946dc50d58d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338548}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35acc32d-eaed-5047-8790-76ca5b79e5a8" :question/math-academy-id "q-72156" :question/problem "Find ${f}^{′}(x)$ when $f(x)=5{cos}^{8}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=5(\\operatorname{cos}⁡x)^{8}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=5{u}^{8},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=40{u}^{7},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =40{u}^{7}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =40(\\operatorname{cos}⁡x)^{7}(-\\operatorname{sin}⁡x) \\\\  & =-40{cos}^{7}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b52aa7c5-0426-5772-8576-0d06507ee246" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-28\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/id #edb/ref 17592186337642} {:answer/id #uuid "bca0ac11-5889-590d-b18f-dc821e5d6c5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-28{cos}^{6}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337708} {:answer/id #uuid "ec2962a1-647e-5d8b-9492-8e3b141a6e17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-28{sin}^{6}⁡x" :db/id #edb/ref 17592186338090} {:answer/id #uuid "f9f6bad8-7c0c-55c3-aec1-1f849a332783" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/id #edb/ref 17592186338224} {:answer/id #uuid "ff8e2ee2-8bc8-5f48-a816-f19ea88144d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{cos}^{6}⁡x" :db/id #edb/ref 17592186338274}] :answer-field/correct {:db/id #edb/ref 17592186337708} :answer-field/id #uuid "05250791-7660-5c5c-b045-5bac1563c939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338283}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e3f0d37-02ff-5992-af83-461909d51264" :question/math-academy-id "q-72157" :question/problem "Find ${f}^{′}(x)$ when $f(x)=4{cos}^{7}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=4(\\operatorname{cos}⁡x)^{7}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=4{u}^{7},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=28{u}^{6},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =28{u}^{6}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =28(\\operatorname{cos}⁡x)^{6}(-\\operatorname{sin}⁡x) \\\\  & =-28{cos}^{6}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad365d4-359a-52c4-805a-c1687b51bf98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡x{csc}^{2}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186336430} {:answer/id #uuid "646e64f6-f63d-5208-9dad-bae8b2423826" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡x{csc}^{2}⁡(\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186336932} {:answer/id #uuid "785f85d3-99ed-5869-bb7a-14c4604ec1c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{csc}^{2}⁡(\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186337115} {:answer/id #uuid "7d2e4cd6-fb63-51c7-b9f4-288b74