b/id #edb/ref 17592186455006} {:answer/id #uuid "42db5338-1e39-52a9-9b3f-1945f45b8bf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455015} {:answer/id #uuid "59542311-3beb-5ba9-afe8-6ee4234a603f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}{\\int }_{0}^{\\pi /4}{cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455059} {:answer/id #uuid "5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455070} {:answer/id #uuid "705ccca2-e01f-5eb0-be9c-6619697c9f9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455112} {:answer/id #uuid "8942f4a7-3e21-56af-9bb4-658bf93f6604" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455151} {:answer/id #uuid "aac6174e-2cde-5d16-8869-626f99dc3227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}{\\int }_{0}^{\\pi /4}{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455201} {:answer/id #uuid "de572935-367e-52cb-8f52-f59649494fbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455287} {:answer/id #uuid "e0fc3cdf-cbc6-5629-a612-73348098ca7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455291} {:answer/id #uuid "f5ea4357-cdc0-5451-a938-bd13cfa04e3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455325} {:db/id #edb/ref 17592186455436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c0f1a3a-2816-584e-a58f-1a944b890014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡2\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455004} {:answer/id #uuid "59542311-3beb-5ba9-afe8-6ee4234a603f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}{\\int }_{0}^{\\pi /4}{cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455059} {:answer/id #uuid "65217f58-febb-5f88-af93-f698f3e104ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455086} {:answer/id #uuid "aac6174e-2cde-5d16-8869-626f99dc3227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}{\\int }_{0}^{\\pi /4}{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455201} {:answer/id #uuid "d5463613-7aa5-5ac0-8e87-c4d1223952c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455273}] :answer-field/correct {:db/id #edb/ref 17592186455273} :answer-field/id #uuid "157407e8-4b6e-5f9e-8bc5-3a22df95510b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "22016566-6911-5c05-b305-606b27ad2ee0" :question/math-academy-id "q-76584" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s,\n$$ where $C$ is the section of the polar curve $r=\\sqrt{3}\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{3}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{3}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{3}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{3}\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\sqrt{3}\\operatorname{cos}⁡\\theta )}^{2}-{(\\sqrt{3}\\operatorname{sin}⁡\\theta )}^{2} \\\\  & =3{cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta  \\\\  & =3({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{3})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\sqrt{3})}^{2}+{0}^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}3\\operatorname{cos}⁡2\\theta \\cdot \\sqrt{3}\\cdot \\text{d}\\theta  \\\\  & =3\\sqrt{3}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "310d49af-1694-516d-bd51-3515b36d8de3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186454979} {:answer/id #uuid "7054bc25-ecf8-5bad-9c21-999a77440142" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186455111} {:answer/id #uuid "89923f74-469b-51f3-b20e-5d752974d11c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$\n is not diagonalizable" :db/id #edb/ref 17592186455152} {:answer/id #uuid "c49667d5-80f0-5ca4-aac6-19c3737abddf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186455241} {:answer/id #uuid "e6400608-0a28-5066-8778-f9b97a7687e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186455302}] :answer-field/correct {:db/id #edb/ref 17592186455302} :answer-field/id #uuid "c4ed917e-4479-55fb-ae93-f553e926f059" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455407}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a4040a9-af29-5df2-8d92-a7f8acbeb04b" :question/math-academy-id "q-80451" :question/problem "Determine if the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}3 & -4 \\\\ 2 & -3\\end{bmatrix}\n$$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3-\\lambda  & -4 \\\\ 2 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-3-\\lambda )-2\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186455443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239cca6c-804d-568c-9236-141e4ca7f897" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186454956} {:answer/id #uuid "2e30646b-950b-5207-8b78-2d3832e125e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}+2" :db/id #edb/ref 17592186454973} {:answer/id #uuid "4e5d6c92-e2a1-55af-af72-56edfe9fbc7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186455042} {:answer/id #uuid "7bbb07ca-e7d7-58c3-8c34-f10c0c9661fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186455130} {:answer/id #uuid "94132ebc-7150-5f36-9359-19697117b692" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186455172}] :answer-field/correct {:db/id #edb/ref 17592186455042} :answer-field/id #uuid "015c6706-f693-57f9-9ba0-4544584eb2cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455341}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3ed7acf8-9750-5997-81ee-fb6a8cd2e910" :question/math-academy-id "q-76685" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{C}(x-y)\\,\\text{d}s,\n$$ where the curve $C$ is given in polar form by $r=\\sqrt{\\operatorname{sin}⁡2\\theta }\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x-y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }-\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta } \\\\  & =(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}{r}^{′}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{\\operatorname{sin}⁡2\\theta }) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot (\\operatorname{cos}⁡2\\theta )\\cdot 2 \\\\  & =\\frac{\\operatorname{cos}⁡2\\theta }{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{\\operatorname{sin}⁡2\\theta +\\frac{{cos}^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡2\\theta +{cos}^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{1}{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}.\\end{aligned}\n$$\n\n   \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /4} \\\\  & =(\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{2}}{2})-(0+1) \\\\  & =\\sqrt{2}-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "404520d3-d967-5b0b-9a92-89f881bf696e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186455012} {:answer/id #uuid "890fe5ec-8858-5534-8b26-e75adee4e582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186455150} {:answer/id #uuid "90adc149-a9e2-5b9c-8313-fbc0425f524a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186455166} {:answer/id #uuid "e503b46f-e7bf-57d7-8559-2e0601cdad27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186455298} {:answer/id #uuid "ef25c8f6-c622-5edf-b418-bcdc116be329" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186455318}] :answer-field/correct {:db/id #edb/ref 17592186455012} :answer-field/id #uuid "63750d47-51f3-5cdf-a76b-72522571295c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455367}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f1c8267-786a-5d55-8970-d1a062c41c69" :question/math-academy-id "q-76673" :question/problem "Evaluate the integral of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$ along the polar curve $r=1$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{1}{{cos}^{2}⁡\\theta } \\\\  & ={sec}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89a99bb2-59a1-56e7-886a-f86b8515a140" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6e^{8-4x}" :db/id #edb/ref 17592186455153}] :answer-field/correct {:db/id #edb/ref 17592186455153} :answer-field/id #uuid "a6f760f5-5d84-52a0-b935-56a6e8048378" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186455395}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "45c14947-ce9d-54ff-a45e-efd6339354f3" :question/math-academy-id "q-343941" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(2)=6\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(2)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))\n$$\n\nNow, we apply the initial condition $y(2)=6.$ Using the hint that the particular solution part evaluates to zero at $x=2,$ we have\n\n$$\n\\begin{aligned}y(2) & =A{e}^{-4(2)}+{y}_{p}(2) \\\\ 6 & =A{e}^{-8}+0 \\\\ A & =6{e}^{8}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(6{e}^{8}){e}^{-4x}=6{e}^{8-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼6{e}^{8-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x)).\n$$"} {:db/id #edb/ref 17592186455452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a10cbc-62bc-52ef-9573-9bb8535117b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/id #edb/ref 17592186454915} {:answer/id #uuid "2e04cc6e-105d-58a6-b535-adb2aa80e8fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/id #edb/ref 17592186454971} {:answer/id #uuid "5374193f-6c53-5136-b249-4387a6f7f018" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /2}(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/id #edb/ref 17592186455054} {:answer/id #uuid "9a399ff3-ac04-580d-8f27-2c4ed2b64de5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/id #edb/ref 17592186455184} {:answer/id #uuid "eb4fc49c-efc5-5ad5-9f98-7f2015d47df2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/id #edb/ref 17592186455311}] :answer-field/correct {:db/id #edb/ref 17592186454915} :answer-field/id #uuid "98645239-f570-5bdc-ae35-ee32a0ef62bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455391}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "50247cc3-8637-5b67-95c3-4cdd3dd3329e" :question/math-academy-id "q-76582" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}(x+y)\\,\\text{d}s,\n$$ where $C$ is the section of the polar curve $r=\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{sin}⁡\\theta )}^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b297024-5803-5e1f-806e-e9147fe90127" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2+\\pi }{4}" :db/id #edb/ref 17592186455031} {:answer/id #uuid "77014ac8-9188-566a-ab76-fd0f1159cb28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2\\pi }{4}" :db/id #edb/ref 17592186455121} {:answer/id #uuid "a33f9d01-31ec-5113-88f0-e574bdf8e345" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2\\pi }{2}" :db/id #edb/ref 17592186455192} {:answer/id #uuid "cf548da9-86b9-58e8-bfb8-e84b31a042ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4+\\pi }{4}" :db/id #edb/ref 17592186455267} {:answer/id #uuid "f822b4a7-0b96-5267-a032-717ecb4736cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+\\pi }{4}" :db/id #edb/ref 17592186455328}] :answer-field/correct {:db/id #edb/ref 17592186455031} :answer-field/id #uuid "cfa59a1c-e79f-5e55-9bec-480e8a735e4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455411}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "50bd506e-5f91-5da4-a6e7-565dbeb70122" :question/math-academy-id "q-165416" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{C}{y}^{2}\\,\\text{d}s,\n$$ where the curve $C$ is given in polar form by $r=\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\,$ for $$\n\\displaystyle \\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}.\n$$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$, where $$\n\\displaystyle \\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}.\n$$\n\nNow, if $f(x,y)={y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2} \\\\  & ={sin}^{2}⁡\\theta \\sqrt[3]{{sin}^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{sin}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\cdot \\operatorname{cos}⁡3\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2}+{\\left(\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\right)}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{sin}^{2}⁡3\\theta }+\\frac{{cos}^{2}⁡3\\theta }{\\sqrt[3]{{sin}^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡3\\theta +{sin}^{2}⁡3\\theta }{\\sqrt[3]{{sin}^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{sin}^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{\\pi /4}^{3\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta \\sqrt[3]{{sin}^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}(1-\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{3\\pi }{4}-\\frac{(-1)}{2}-(\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a88e0b9-efe3-5c60-850b-a590ab5c7a1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2+\\pi }{2}" :db/id #edb/ref 17592186454927} {:answer/id #uuid "585c7fa1-6f4c-5c7c-9aa3-76aa043504d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+\\pi }{4}" :db/id #edb/ref 17592186455057} {:answer/id #uuid "5a95b8e9-6493-5f50-a29f-7ee9d41b4718" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+\\pi }{2}" :db/id #edb/ref 17592186455061} {:answer/id #uuid "a7330c13-ecf9-5fb5-8378-1f535c4f0420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2+\\pi }{4}" :db/id #edb/ref 17592186455199} {:answer/id #uuid "cb4e334f-cfe8-5326-92bb-f4acab21965f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2\\pi }{4}" :db/id #edb/ref 17592186455254}] :answer-field/correct {:db/id #edb/ref 17592186455199} :answer-field/id #uuid "866e10cb-7bc8-54b5-b98f-2a2d55ebe453" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455380}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7a3675b0-e883-52dd-8e3e-7330cc6b3856" :question/math-academy-id "q-165415" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{C}{x}^{2}\\,\\text{d}s,\n$$ where the curve $C$ is given in polar form by $r=\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\,$ for $$\n\\displaystyle -\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.\n$$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$, where $$\n\\displaystyle -\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.\n$$\n\nNow, if $f(x,y)={x}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2} \\\\  & ={cos}^{2}⁡\\theta \\sqrt[3]{{cos}^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{cos}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\cdot (-\\operatorname{sin}⁡3\\theta ) \\\\  & =-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2}+{\\left(-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\right)}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{cos}^{2}⁡3\\theta }+\\frac{{sin}^{2}⁡3\\theta }{\\sqrt[3]{{cos}^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡3\\theta +{sin}^{2}⁡3\\theta }{\\sqrt[3]{{cos}^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{cos}^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\sqrt[3]{{cos}^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(1+\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{4}+\\frac{1}{2}-(-\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e845a04-8cdb-5e9e-84f7-e0e83c51ac51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right)" :db/id #edb/ref 17592186455073} {:answer/id #uuid "e5794dc8-ca22-54fc-a518-c6c715487e09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{6}\\right)" :db/id #edb/ref 17592186455300} {:answer/id #uuid "e6a093ac-9f78-5544-b061-1933a24a44b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{6}\\right)" :db/id #edb/ref 17592186455305} {:answer/id #uuid "f895f8f8-5c23-5c95-9255-aeebe933932a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)" :db/id #edb/ref 17592186455330}] :answer-field/correct {:db/id #edb/ref 17592186455330} :answer-field/id #uuid "8751bc0c-cc97-539c-aaed-dee2b1d55e70" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186455383}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86bb2466-6029-5b95-bd68-985d08738376" :question/math-academy-id "q-344258" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+4y=f(x)\n$$\n\non $[-3,3]$, where $f$ is $6$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $6$-periodic on $[-3,3]$, we have $L=3$, so Fourier series on this interval use the basis \n\n$$\ncos\\,\\left(\\frac{n\\pi x}{3}\\right)\\,\\text{and}\\,sin\\,\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\n$$"} {:db/id #edb/ref 17592186455480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0810bb3f-c2fa-58b5-b891-5c4514181eb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)({\\sum }_{n=0}^{\\infty }{a}_{n}+4)" :db/id #edb/ref 17592186454923} {:answer/id #uuid "3a590d58-adcd-5aee-ba5f-885b57614221" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/id #edb/ref 17592186454998} {:answer/id #uuid "6ef76db9-b5c3-5953-bc60-e1853032b616" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/id #edb/ref 17592186455108} {:answer/id #uuid "a4e1e40b-afb1-57b5-bd98-93d521a6c0e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)(-4+{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/id #edb/ref 17592186455193}] :answer-field/correct {:db/id #edb/ref 17592186455108} :answer-field/id #uuid "69a096f9-2884-52fa-b0ef-ba88ca249a75" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186455371}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96918677-d74f-5a11-bcee-c80ebc5a3b95" :question/math-academy-id "q-344035" :question/problem "$$\n{y}^{″}+2y=f(x),\\,y(0)=-4,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an even, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x)\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an even function and the differential operator contains no ${y}^{′}$ (damping) term, the particular solution inherits the symmetry and is also an even function consisting only of cosine terms. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+2=0$ gives roots $\\lambda =\\pm \\sqrt{2}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x)+B\\operatorname{sin}⁡(\\sqrt{2}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\n{y}^{′}(x)∼-A\\sqrt{2}\\operatorname{sin}⁡(\\sqrt{2}x)+B\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}x)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}sin\\,(\\frac{n\\pi }{2}x).\n$$\n\nUsing the derivative condition ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{2}\\operatorname{sin}⁡(0)+B\\sqrt{2}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{2}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we use the condition $y(0)=-4.$ With $B=0,$ the total solution is\n\n$$\ny(x)∼A\\operatorname{cos}⁡(\\sqrt{2}x)+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x).\n$$\n\nApplying $y(0)=-4$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}-4 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =-4-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nSubstituting $A$ back into ${y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{cos}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x)\n$$"} {:db/id #edb/ref 17592186455483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30fa23ce-2a64-5f21-af68-65dc34a26e11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\operatorname{sin}⁡(\\sqrt{10}x)" :db/id #edb/ref 17592186454978} {:answer/id #uuid "966b9893-02ce-5002-92b6-528d0cbf1845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\operatorname{cos}⁡(\\sqrt{10}x)" :db/id #edb/ref 17592186455174} {:answer/id #uuid "cd4cbb92-f7b5-5cd0-b586-5f6f713d2615" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6}{\\sqrt{10}\\operatorname{cos}⁡(\\sqrt{10})}\\operatorname{cos}⁡(\\sqrt{10}x)" :db/id #edb/ref 17592186455258} {:answer/id #uuid "cea66f81-9d52-5528-86a7-49bf7d5e5e3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\operatorname{cos}⁡(\\sqrt{10}x)" :db/id #edb/ref 17592186455264}] :answer-field/correct {:db/id #edb/ref 17592186455264} :answer-field/id #uuid "e0337040-d506-5af7-a704-b40619be2791" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186455419}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9a34abd9-b695-5ab7-980c-61ca9112523d" :question/math-academy-id "q-344326" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+10y=f(x),\\,{y}^{′}(0)=0,\\,{y}^{′}(1)=6\n$$\n\nwhere $f(x)$ is $4$-periodic and odd. Select the missing part in the solution of the BVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}^{′}(0)=0$ and ${y}_{p}^{′}(1)=0.$*\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$" :question/worked-solution "We write the solution as $y={y}_{c}+{y}_{p}$, where ${y}_{c}$ solves the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, solve the homogeneous equation ${y}^{″}+10y=0.$ Its general solution is\n\n$$\n{y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{10}x)+B\\operatorname{sin}⁡(\\sqrt{10}x).\n$$\n\nComputing the derivative, we get\n\n$$\n{y}^{′}(x)=-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10}x)+B\\sqrt{10}\\operatorname{cos}⁡(\\sqrt{10}x)+{y}_{p}^{′}(x).\n$$\n\nNow, we use the hint. Since ${y}_{p}^{′}(0)=0$ and ${y}_{p}^{′}(1)=0$, we have\n\n$$\n{y}^{′}(0)={y}_{c}^{′}(0)\\,\\text{and}\\,{y}^{′}(1)={y}_{c}^{′}(1).\n$$\n\nNext, we apply the boundary conditions. \n\n- Use ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =0+B\\sqrt{10}(1)+{y}_{p}^{′}(0) \\\\ 0 & =B\\sqrt{10}+0 \\\\ B & =0\\end{aligned}\n$$\n\nSo, ${y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{10}x).$\n\n- Use ${y}^{′}(1)=6$ with $B=0:$\n\n$$\n\\begin{aligned}{y}^{′}(1) & =-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})+{y}_{p}^{′}(1) \\\\ 6 & =-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})+0 \\\\ A & =-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\operatorname{cos}⁡(\\sqrt{10}x)+{\\sum }_{n=1}^{\\infty }{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$"} {:db/id #edb/ref 17592186455484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a75b67-5f2f-522b-91db-f97635ae5971" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186454937} {:answer/id #uuid "2405db00-e007-59b1-bf44-c16b5a7629f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186454958} {:answer/id #uuid "8a580176-26a2-5536-906f-5573392c1d28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186455155} {:answer/id #uuid "d6c54752-bf5b-5114-8706-a39bfe9f6e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186455279} {:answer/id #uuid "e81cddbe-cf94-5088-b2c6-2672b342f18e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186455306}] :answer-field/correct {:db/id #edb/ref 17592186455155} :answer-field/id #uuid "d82fe19b-8cd0-5df1-bf94-5bdbb9c5b9df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455416}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9c7ce8e8-7ebb-5185-86d9-47c695c84f48" :question/math-academy-id "q-76768" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{C}\\sqrt{x}y\\,\\text{d}s,\n$$ where the curve $C$ is given in polar form by $r=4\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =4{cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=4{cos}^{2}⁡\\theta $ and $y=4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=\\sqrt{x}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{4{cos}^{2}⁡\\theta }\\cdot 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8|\\operatorname{cos}⁡\\theta |\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{cos}⁡\\theta |=\\operatorname{cos}⁡\\theta $ because $0\\le \\theta \\le \\frac{\\pi }{2}⟹\\operatorname{cos}⁡\\theta \\ge 0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(4\\operatorname{cos}⁡\\theta ) \\\\  & =-4\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(4\\operatorname{cos}⁡\\theta )^{2}+(-4\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{16({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =4.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{x}y\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}8{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 4\\cdot \\text{d}\\theta  \\\\  & =32{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡\\theta ,$ $\\text{d}u=-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}32{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =32{\\int }_{1}^{0}-{u}^{2}\\,\\text{d}u \\\\  & =32{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =32\\cdot \\frac{1}{3}{u}^{3}{|}_{0}^{1} \\\\  & =\\frac{32}{3}({1}^{3}-{0}^{3}) \\\\  & =\\frac{32}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc074f0-8d82-55d9-960a-7332cb2a9aba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{-\\pi /8}^{\\pi /4}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186454931} {:answer/id #uuid "1a14529d-3768-5610-b079-b36a0abcae5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186454945} {:answer/id #uuid "3dabd53e-5bb6-5035-b84f-4f492fd16bdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455006} {:answer/id #uuid "705ccca2-e01f-5eb0-be9c-6619697c9f9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455112} {:answer/id #uuid "e0fc3cdf-cbc6-5629-a612-73348098ca7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455291}] :answer-field/correct {:db/id #edb/ref 17592186454945} :answer-field/id #uuid "30132071-c6bc-5d04-908b-c84e3cfc46ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455355}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcf9f8c6-5d3c-5211-90e2-bddb94921272" :question/math-academy-id "q-76609" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s,\n$$ where $C$ is the section of the polar curve $r=1\\,$ for $$\n\\displaystyle -\\frac{\\pi }{8}\\le \\theta \\le \\frac{\\pi }{4}?\n$$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =1\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $$\n\\displaystyle -\\frac{\\pi }{8}\\le \\theta \\le \\frac{\\pi }{4}.\n$$\n\nNow, if $f(x,y)=xy(1-{x}^{2})$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot (1-{cos}^{2}⁡\\theta ) \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot {sin}^{2}⁡\\theta  \\\\  & ={sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(1)^{2}+{0}^{2}} \\\\  & =\\sqrt{1+0} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /8}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42db5338-1e39-52a9-9b3f-1945f45b8bf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455015} {:answer/id #uuid "66a47cde-b229-5742-a3c9-cd9a46d82b71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455091} {:answer/id #uuid "8942f4a7-3e21-56af-9bb4-658bf93f6604" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455151} {:answer/id #uuid "ad686914-2f26-5181-bfe3-df5b8db65ff9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455207} {:answer/id #uuid "f5ea4357-cdc0-5451-a938-bd13cfa04e3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186455325}] :answer-field/correct {:db/id #edb/ref 17592186455151} :answer-field/id #uuid "300a6c45-5c56-5b70-8220-7a36e97b7d82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455354}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce434154-3398-5488-977f-b3adb13e5b25" :question/math-academy-id "q-76607" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}xy\\,\\text{d}s,\n$$ where $C$ is the section of the polar curve $r=2\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2{cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2{cos}^{2}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2{cos}^{2}⁡\\theta \\cdot 2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =4{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\operatorname{cos}⁡\\theta )=-2\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(2\\operatorname{cos}⁡\\theta )^{2}+(-2\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{4({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}4{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082112eb-8a26-5265-b137-26bd8c295b06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{sin}^{3}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186454924} {:answer/id #uuid "0ae41ca2-e608-5696-b440-d41c065df75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186454928} {:answer/id #uuid "5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455070} {:answer/id #uuid "76d63731-dd9b-510e-8131-e402a45ba6a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455120} {:answer/id #uuid "de572935-367e-52cb-8f52-f59649494fbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455287}] :answer-field/correct {:db/id #edb/ref 17592186455070} :answer-field/id #uuid "436cc0aa-bff3-5b92-a639-ba2e62b0da93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455360}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee634955-812e-57a4-9691-da172190ae0a" :question/math-academy-id "q-76611" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}(x+y)^{2}\\,\\text{d}s,\n$$ where $C$ is the section of the polar curve $r=\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\pi ?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={cos}^{2}⁡\\theta $ and $y=\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)=(x+y)^{2}$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2} \\\\  & ={(\\operatorname{cos}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ))}^{2} \\\\  & ={cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}.\\end{aligned}\n$$\n\n \n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186455509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e86b23-ab58-5191-ad26-f69ae3689883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{81}{64}" :db/id #edb/ref 17592186454977} {:answer/id #uuid "436fc72b-b372-56c4-8b22-e7ad0b501850" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{32}" :db/id #edb/ref 17592186455016} {:answer/id #uuid "669bf703-838e-5938-ae0d-38fb979f2c88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{128}" :db/id #edb/ref 17592186455090} {:answer/id #uuid "79e64d1a-8928-56a0-b539-e3221053a6ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{64}" :db/id #edb/ref 17592186455127} {:answer/id #uuid "fb8a62c2-9594-5471-887e-0b239c4e7aad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{128}" :db/id #edb/ref 17592186455336}] :answer-field/correct {:db/id #edb/ref 17592186455090} :answer-field/id #uuid "d0754811-61f8-5b43-b64d-d1916d6e8f79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455412}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "eec86b54-2bc2-5f46-8f9a-0f8c56be4962" :question/math-academy-id "q-76769" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{C}x{y}^{2}\\,\\text{d}s,\n$$ where the curve $C$ is given in polar form by $r=3\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{6}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =3{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=3{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{6}.$\n\nNow, if $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot (3{sin}^{2}⁡\\theta )^{2} \\\\  & =27{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(3\\operatorname{sin}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(3\\operatorname{sin}⁡\\theta )^{2}+(3\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{9({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =3.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /6}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}27{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 3\\cdot \\text{d}\\theta  \\\\  & =81{\\int }_{0}^{\\pi /6}{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}81{\\int }_{0}^{\\pi /6}{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =81{\\int }_{0}^{1/2}{u}^{5}\\,\\text{d}u \\\\  & =81\\cdot \\frac{1}{6}{u}^{6}\\,{|}_{0}^{1/2} \\\\  & =\\frac{27}{2}(\\left(\\frac{1}{2}\\right)^{6}-{0}^{6}) \\\\  & =\\frac{27}{128}\\end{aligned}\n$$"} {:answer/id #uuid "14eb9fcd-7abf-50ea-acb9-8e896cb286b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{9}(1-2{r}^{2}{sin}^{2}⁡\\theta )\\,dr\\,d\\theta " :db/id #edb/ref 17592186458663} {:answer/id #uuid "4752d255-6d05-5b8c-9bc7-d3d564d74fbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{9}(1-2{r}^{2}{sin}^{2}⁡\\theta )r\\,dr\\,d\\theta " :db/id #edb/ref 17592186458759} {:answer/id #uuid "4d3491ea-d8ce-5605-97f6-fd42cbc08809" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{3\\pi /2}\\,{\\int }_{0}^{9}(1-2{r}^{2}{sin}^{2}⁡\\theta )r\\,dr\\,d\\theta " :db/id #edb/ref 17592186458767} {:db/id #edb/ref 17592186459223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76e9497e-95ac-551f-b7f9-a976c2b420b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186458839} {:answer/id #uuid "8daee35f-46c8-5466-b3b4-c225766c4214" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\pi " :db/id #edb/ref 17592186458874} {:answer/id #uuid "9f77bfdf-543d-55d9-98f8-52a2f2343148" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\pi " :db/id #edb/ref 17592186458910} {:answer/id #uuid "a61402b4-43f9-5d6a-b293-8db1d57747f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32\\pi " :db/id #edb/ref 17592186458925} {:answer/id #uuid "e782fbf2-3eee-5d13-a745-b3e38c6a490e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186459031}] :answer-field/correct {:db/id #edb/ref 17592186458910} :answer-field/id #uuid "16ca1c58-b325-53c7-b363-8ad3f071412f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186459095}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3227ab6b-7873-5e0c-8df6-f96bbac69dd6" :question/math-academy-id "q-126735" :question/problem "![](images/1f/1f56006dd06fab3bbc736c45ac6e9d65a401b88e0a9eb8a5db404fb67b89977e.png)\n\nEvaluate $$\n\\displaystyle {∮}_{C}({e}^{x}-8{x}^{2}y)dx+({y}^{7}+8x{y}^{2})\\,dy,\n$$ where the path $C$ is shown above." :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/f3/f393d0facc98fe365e2c622e24223d6045b48b490937ba6e2f25d86d7eb4810f.png)\n\nNow, since \n\n$$\nP(x,y)={e}^{x}-8{x}^{2}y,\\,Q(x,y)={y}^{7}+8x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-8{x}^{2},\\,\\frac{∂Q}{∂x}=8{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x}-8{x}^{2}y)dx+({y}^{7}+8x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(8{y}^{2}-(-8{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}8({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}[2{r}^{4}]_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}32\\,\\text{d}\\theta  \\\\  & =32[\\theta ]_{-\\pi /2}^{0} \\\\  & =32\\cdot \\frac{\\pi }{2} \\\\  & =16\\pi .\\end{aligned}\n$$"} {:answer-field/choices [{:answer/id #uuid "87ddde79-2216-55f9-a241-4e3672b694c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460233} {:answer/id #uuid "0b7a88de-d9d2-5ec0-a2fb-a186b71ec20e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460234}] :answer-field/correct {:db/id #edb/ref 17592186460233} :answer-field/id #uuid "e844d229-6b8b-51c9-b888-0ba89abf3b5b" :answer-field/key "$y(x)={sin}^{2}⁡(2x)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460983} {:answer-field/choices [{:answer/id #uuid "d574a5c6-6e85-5840-a6c9-47afbd64f5f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460359} {:answer/id #uuid "fb406f8b-7d21-583e-8970-b28bc7c03256" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460360}] :answer-field/correct {:db/id #edb/ref 17592186460359} :answer-field/id #uuid "d633ac8f-3e41-5a25-a8d2-0ce35f4524f7" :answer-field/key "${\\int }_{-2}^{2}{sin}^{2}⁡x\\,\\text{d}x$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461046} {:answer-field/choices [{:answer/id #uuid "8704f06e-0eca-5a70-9700-c5526052b2a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460407} {:answer/id #uuid "6518d566-4b59-5853-9f01-fa65f41a11a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460408}] :answer-field/correct {:db/id #edb/ref 17592186460407} :answer-field/id #uuid "328cbc85-02de-5782-9f6f-1bfc8ec8fbb3" :answer-field/key "${a}_{11}=-1$ and $det(A)>0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461070} {:answer-field/choices [{:answer/id #uuid "9a841c83-c0e