7592186045499} :answer/value "unbounded below" :db/id #edb/ref 17592186487673} {:answer/id #uuid "3ce4e8eb-5308-5d7a-a1f9-c3552f8495a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "unbounded above" :db/id #edb/ref 17592186487681} {:answer/id #uuid "886afc4d-e66c-5812-a260-a3ec7d3a61f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "bounded below" :db/id #edb/ref 17592186487828} {:answer/id #uuid "ecf52883-ed79-514b-ab30-628dfe55ba7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "bounded above" :db/id #edb/ref 17592186488015}] :answer-field/correct {:db/id #edb/ref 17592186487673} :answer-field/id #uuid "f0db6243-3349-5558-9574-70fe3060bd88" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186488167}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "506b27d0-9ecb-54b1-8cb0-ba21f98fbff3" :question/math-academy-id "q-343939" :question/problem "Consider the set $B=(-\\infty ,\\sqrt{2}\\,].$ Complete the following reasoning to determine $inf(B)$ and $sup(B).$\n\nThe infimum of $B$ is the {{field-1}} of $B,$ and the supremum is the {{field-2}} of $B.$\n\nSince $B$ is {{field-3}}, we have $inf(B)$ {{field-4}}.\n\nSince $B$ is {{field-5}}, we have $sup(B)$ {{field-6}}." :question/worked-solution "The infimum of $B$ is the greatest lower bound of $B,$ and the supremum is the smallest upper bound of $B.$\n\nTo find the infimum of this set, we must find the set containing **all** lower bounds of $B$ (i.e., the set of lower bounds) and take the maximum of this set.\n\nSince $B$ is unbounded below, $B$ has no lower bounds, so $inf(B)=-\\infty .$\n\nNext, to find the supremum of this set, we must find the set containing **all** upper bounds of $B$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nIn our case, we have the following:\n\n- Any number in the set $x\\ge \\sqrt{2}$ is greater than or equal to the elements of $B.$ Thus, the set $[\\sqrt{2},\\infty )$ contains only upper bounds of $B.$\n\n- Any number in the set $x<\\sqrt{2}$ is **not** an upper bound of $B.$ In other words, we can always find an element of $B$ that is greater than $x$ for any $x<\\sqrt{2}.$\n\nTherefore, $[\\sqrt{2},\\infty )$ is the set of upper bounds of $B,$ and\n\n$$\nsup(B)=min\\,[\\sqrt{2},\\infty )=\\sqrt{2}.\n$$\n\nThe completed reasoning is given below.\n\nThe infimum of a set $B$ is the $\\text{greatest lower bound}$ of $B,$ and the supremum is the $\\text{smallest upper bound}$ of $B.$\n\nSince $B$ is $\\text{unbounded below},$ we have $inf(B)=-\\infty .$\n\nSince $B$ is $\\text{bounded above},$ we have $sup(B)=\\sqrt{2}.$"} {:db/id #edb/ref 17592186488210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2af8039-a78b-5fde-b644-dab8ea6d11a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186487936}] :answer-field/correct {:db/id #edb/ref 17592186487936} :answer-field/id #uuid "d47acad2-139e-5bc5-9fa6-bc7c2c008592" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488150}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "56f49ac3-e6b5-56aa-af36-053b89a652ef" :question/math-academy-id "q-253900" :question/problem "![](images/40/40c6f3bbfcbf08db07501076a43ba011da20c57c70865ec2700334d560936eae.png)\n\nWhat is the infimum of the function $y=f(x)$ shown above?\n\n${inf}_{x\\in R}f(x)=$\n{{field-1}}" :question/worked-solution "The infimum of a function is the infimum of the range of the function.\n\nIn this case, the range of $f$ is $A=(-1,2].$\n\nTo find the infimum of a set $A,$ we must find the set containing **all** lower bounds of $A$ (i.e., the set of lower bounds) and take the maximum of this set.\n\nSo, in our case, we have that\n\n- any number $y\\le -1$ is a lower bound of $A,$\n\n- any number $y>-1$ is **not** a lower bound of $A.$ In other words, we can always find an element of $A$ that is smaller than $y$ for any $y>-1.$\n\nTherefore, $(-\\infty ,-1]$ is the set of lower bounds of $A,$ and\n\n$$\n{inf}_{x\\in R}f(x)=inf(A)=max(-\\infty ,-1]=-1.\n$$"} {:db/id #edb/ref 17592186488226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc6ad13d-df94-5509-9f6e-43f2e945d4dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186487983}] :answer-field/correct {:db/id #edb/ref 17592186487983} :answer-field/id #uuid "c2b06594-fe7b-5644-beb7-982cb8ef3010" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488141}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "73aef377-5ed1-5df9-8acf-ea492a3b5fe7" :question/math-academy-id "q-253548" :question/problem "Consider the set $D,$ defined as\n\n$$\nD=\\{n-{n}^{2}:n\\in \\{1,2,3,4\\}\\}.\n$$\n\nWhat is the infimum of $D?$\n\n$inf(D)=$\n{{field-1}}" :question/worked-solution "The infimum of a set $D$ is the greatest lower bound of $D.$\n\nIf $D$ is a finite set, the infimum of $D$ equals its minimum.\n\nFirst, let's write down all the terms of our set by substituting $n=1,2,3,4$ into the expression for the elements of $D:$\n\n$$\n\\begin{aligned}1-{1}^{2} & =0 \\\\ 2-{2}^{2} & =-2 \\\\ 3-{3}^{2} & =-6 \\\\ 4-{4}^{2} & =-12\\end{aligned}\n$$\n\nSo, we have\n\n$$\nD=\\{0,\\,-2,\\,-6,\\,-12\\}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}inf(D) & =min\\{0,\\,-2,\\,-6,\\,-12\\}=-12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186488237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d245cd70-93bb-5fe0-8b39-c61cbd52e2d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186487967}] :answer-field/correct {:db/id #edb/ref 17592186487967} :answer-field/id #uuid "fe90978e-57e2-5d2c-a9e0-a9c95c24e6df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488177}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8b620bc4-f772-542c-8902-9f29e69330eb" :question/math-academy-id "q-253546" :question/problem "What is the supremum of the set $C=\\{-4,\\,3,\\,-2,\\,1\\}?$\n\n$sup(C)=$\n{{field-1}}" :question/worked-solution "The supremum of a set $C$ is the smallest upper bound of $C.$\n\nIf $C$ is a finite set, the supremum of $C$ equals its maximum. Therefore,\n\n$$\n\\begin{aligned}sup(C) & =max\\{-4,\\,3,\\,-2,\\,1\\}=3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186488264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac9b3db-343c-58f0-83db-0523448093be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=1\\in A" :db/id #edb/ref 17592186487857} {:answer/id #uuid "b1f6d5db-d453-51b2-81bf-72bad96c4aaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=0\\in A" :db/id #edb/ref 17592186487905} {:answer/id #uuid "c14e4e69-3b50-5f9c-aab3-933c64469cdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=+\\infty " :db/id #edb/ref 17592186487932} {:answer/id #uuid "c152b716-01ac-5012-a5ba-cb9700cb7912" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=1\\notin A" :db/id #edb/ref 17592186487933} {:answer/id #uuid "c8035750-8d78-5097-9367-a314cfe52d58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=0\\notin A" :db/id #edb/ref 17592186487948}] :answer-field/correct {:db/id #edb/ref 17592186487932} :answer-field/id #uuid "afd78a1e-c9e7-53fa-8911-aad04834878d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186488129}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d021d0f6-fbf3-5eed-804d-eee551071be6" :question/math-academy-id "q-253911" :question/problem "Consider the following set.\n\n$$\nA=\\{(-1)^{n}\\cdot (n-1)\\,:\\,n\\in N\\}\n$$\n\nFor this set, we have that {{field-1}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nThe elements of $A$ are the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=(-1)^{n}\\cdot (n-1),\\,n\\in N=\\{1,2,3,4,…\\}.\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/58/5812e3dd22994d613ecc84087418cddfa978e98c1324869f290e1bf2b1317bad.png)\n\nWe see that ${a}_{n}$ is an oscillating, non-convergent sequence. Moreover, $A$ is unbounded above. In other words, for any real number $x,$ we can always find a sufficiently large $n$ such that ${a}_{n}$ is greater than $x.$ Therefore, $A$ has no upper bounds and $sup(A)=+\\infty .$"} {:db/id #edb/ref 17592186488268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001ea1a7-1458-5c83-890d-ac74cc58fe9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186487567} {:answer/id #uuid "535f4ffd-0ca2-5b35-a57d-b6136a9b6c06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186487733} {:answer/id #uuid "8609cb0b-e6f4-52db-9fa5-e1327dd9e5b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186487820} {:answer/id #uuid "b191a8b5-a6ab-5925-89cc-2226c519e67c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186487902}] :answer-field/correct {:db/id #edb/ref 17592186487820} :answer-field/id #uuid "020067a1-9263-50e4-b33c-092afcb490cd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186488051} {:answer-field/choices [{:answer/id #uuid "275267aa-7fe6-5509-801e-f9b125fe4ce0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$inf(B)$ does not exist" :db/id #edb/ref 17592186487649} {:answer/id #uuid "5e6fc4ae-7a22-54f3-b550-cb820c80a006" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(B)=-1\\in B" :db/id #edb/ref 17592186487756} {:answer/id #uuid "a578b96c-4dcd-5d98-afab-f309822e5646" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(B)=2\\in B" :db/id #edb/ref 17592186487876} {:answer/id #uuid "d46a64ba-9ced-58f0-be3d-8e24b4b25a3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(B)=-1\\notin B" :db/id #edb/ref 17592186487970} {:answer/id #uuid "e113409c-949f-5f4f-94e4-46ddd49d56bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(B)=2\\notin B" :db/id #edb/ref 17592186487997}] :answer-field/correct {:db/id #edb/ref 17592186487756} :answer-field/id #uuid "19e3672d-b2c0-5d72-8182-458842a8082b" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186488065} {:answer-field/choices [{:answer/id #uuid "258f7939-f785-5dc4-a181-5aba44350878" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "smallest upper bound" :db/id #edb/ref 17592186487644} {:answer/id #uuid "b3f10959-4573-5095-94c3-45484a99ec71" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "greatest upper bound" :db/id #edb/ref 17592186487909} {:answer/id #uuid "c1157647-1f2f-5647-ba3c-a7d0af45f9e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "greatest lower bound" :db/id #edb/ref 17592186487930} {:answer/id #uuid "de33f900-f0ee-54b2-86e2-8e0dbacd4624" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "smallest lower bound" :db/id #edb/ref 17592186487988}] :answer-field/correct {:db/id #edb/ref 17592186487930} :answer-field/id #uuid "7711e40c-c300-5c27-b9a0-b4edcb7004f6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186488101} {:answer-field/choices [{:answer/id #uuid "71992831-f081-5b4f-8e3b-b908eab2b80a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186487795} {:answer/id #uuid "cde51993-46ba-5136-b04b-e60fd29425c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186487961}] :answer-field/correct {:db/id #edb/ref 17592186487795} :answer-field/id #uuid "8228ce6d-4eae-56db-adb9-39e0b92fe3e4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186488107}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d48b0cc5-05e8-55c3-b441-64611554a8ed" :question/math-academy-id "q-253553" :question/problem "Consider the set $B=[-1,2).$ Complete the following reasoning to identify $inf(B).$\n\nThe infimum of $B$ is the {{field-1}} of $B.$\n\nThe set of lower bounds of $B$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x{{field-2}}{{field-3}}\\}\n$$\n\nTherefore, {{field-4}}." :question/worked-solution "The infimum of $B$ is the greatest lower bound of $B.$\n\nTo find the infimum of this set, we must find the set containing **all** lower bounds of $B$ (i.e., the set of lower bounds) and take the maximum of this set.\n\nIn our case, we have the following:\n\n- Any number in the set $x\\le -1$ is smaller than or equal to the elements of $B.$ Thus, the set $(-\\infty ,-1]$ contains only lower bounds of $B.$\n\n- Any number in the set $x>-1$ is **not** a lower bound of $B.$ In other words, we can always find an element of $B$ that is smaller than $x$ for any $x>-1.$\n\nTherefore, $(-\\infty ,-1]$ is the set of lower bounds of $B,$ and\n\n$$\ninf(B)=max(-\\infty ,-1]=-1.\n$$\n\nNotice that $-1$ is also the minimum of $B.$\n\nThe completed reasoning is given below.\n\nThe infimum of $B$ is the $\\text{greatest lower bound}$ of $B.$\n\nThe set of lower bounds of $B$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x\\le -1\\}\n$$\n\nTherefore, $inf(B)=-1\\in B.$"} {:db/id #edb/ref 17592186488271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67197de5-74fe-5dc0-abe6-0952b996a82d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186487773}] :answer-field/correct {:db/id #edb/ref 17592186487773} :answer-field/id #uuid "42f7eabb-2484-504e-a47e-b134986a6e92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ddf4ec2c-4f4d-56c1-bc14-78cfd2f52940" :question/math-academy-id "q-253895" :question/problem "![](images/50/50b52da574101dfca7c620411a446f2c5f3ef41242186ca38da072e140019024.png)\n\nWhat is the supremum of the function $y=f(x)$ shown above?\n\n${sup}_{x\\in R}f(x)=$\n{{field-1}}" :question/worked-solution "The supremum of a function is the supremum of the range of the function.\n\nIn this case, the range of $f$ is $A=(-2,3].$\n\nTo find the supremum of a set $A,$ we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nSo, in our case, we have that\n\n- any number $y\\ge 3$ is an upper bound of $A,$\n\n- any number $y<3$ cannot be an upper bound of $A$ because $3,$ an element of $A,$ is greater than $y.$\n\nTherefore, $[3,\\infty )$ is the set of upper bounds of $A,$ and\n\n$$\n{sup}_{x\\in R}f(x)=sup(A)=min[3,\\infty )=3.\n$$"} {:db/id #edb/ref 17592186488350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15fcd547-653b-552b-85ad-75b74c038726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+\\frac{{4}^{x}}{ln⁡4}+C" :db/id #edb/ref 17592186488355} {:answer/id #uuid "b7d70a89-ba08-5cbb-ac39-03d367adfd7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{x}}{5}+\\frac{{4}^{x}}{ln⁡4}+C" :db/id #edb/ref 17592186488367} {:answer/id #uuid "e4c8cd93-0c8d-5137-a955-741377209ad4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+{4}^{x}ln⁡4+C" :db/id #edb/ref 17592186488372} {:answer/id #uuid "eb7ec02e-0659-522a-9153-1d205b3645fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{x}+\\frac{{5}^{x}}{ln⁡4}+C" :db/id #edb/ref 17592186488374} {:answer/id #uuid "f7cf6924-5468-598a-89b2-51aedcf4589d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+\\frac{x}{ln⁡4}+C" :db/id #edb/ref 17592186488376}] :answer-field/correct {:db/id #edb/ref 17592186488355} :answer-field/id #uuid "4ad71a46-de5e-5a86-86a7-aaf01c87103b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488361}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "06b0b1bd-ae5d-56cf-89fa-4d6392983b6e" :question/problem "$$\n\\displaystyle \\int (5{e}^{x}+{4}^{x})\\,\\text{d}x=\n$$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (5{e}^{x}+{4}^{x})\\,\\text{d}x & =5\\int {e}^{x}\\,\\text{d}x+\\int {4}^{x}\\,\\text{d}x \\\\  & =5{e}^{x}+\\frac{{4}^{x}}{ln⁡4}+C.\\end{aligned}\\end{aligned}\n$$"} {:answer/id #uuid "15fcd547-653b-552b-85ad-75b74c038726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{x}+\\frac{{4}^{x}}{ln⁡4}+C" :db/id #edb/ref 17592186488355} {:answer/id #uuid "2aea10bb-853d-516c-8881-38e0458d2aa7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{3x}-\\frac{{7}^{2x}}{ln⁡x}+\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186488357} {:answer/id #uuid "68c0b390-e877-55ee-9e76-30d056d7e23f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}+\\frac{{7}^{x}}{ln⁡2}+\\frac{{x}^{2}}{3}+C" :db/id #edb/ref 17592186488363} {:answer/id #uuid "b7d70a89-ba08-5cbb-ac39-03d367adfd7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{x}}{5}+\\frac{{4}^{x}}{ln⁡4}+C" :db/id #edb/ref 17592186488367} {:answer/id #uuid "c779612a-03b7-5b03-bdd5-d469206d5055" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{x}-\\frac{{7}^{x}}{ln⁡7}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186488368} {:answer/id #uuid "e3714c2f-038a-502c-8e59-d26f59c829cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value 