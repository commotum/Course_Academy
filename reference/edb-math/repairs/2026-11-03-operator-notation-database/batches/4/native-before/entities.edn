ext{d}}{\\text{d}x}(\\frac{7}{4}{e}^{x}) \\\\  & =0+\\frac{7}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{7}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡2} & ={(\\frac{7}{4}{e}^{x})\\,|}_{x=-ln⁡2} \\\\  & =\\frac{7}{4}{e}^{-ln⁡2} \\\\  & =\\frac{7}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{7}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d8c6b79-f2e6-53a0-a862-d058db79b1df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{20}" :db/id #edb/ref 17592186480032}] :answer-field/correct {:db/id #edb/ref 17592186480032} :answer-field/id #uuid "b8bb0ea8-e867-5b13-8fba-c0a5615adfbb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186480035}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f32ccf8c-9eba-53b7-a331-a184e3771a1b" :question/problem "Given that $f(x)=\\frac{11}{4}{e}^{x}-11$, the slope of the tangent line at $x=-ln⁡5$ is{{field-1}}." :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{11}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡5$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡5} & ={(\\frac{11}{4}{e}^{x})\\,|}_{x=-ln⁡5} \\\\  & =\\frac{11}{4}{e}^{-ln⁡5} \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{5} \\\\  & =\\frac{11}{20}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080f6753-8c70-5915-9a0d-bd865b290678" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\,{e}^{t}" :db/id #edb/ref 17592186480125} {:answer/id #uuid "6cdb4830-f175-5239-a293-3eeaeb64ec02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}\\,{e}^{t}}{2}" :db/id #edb/ref 17592186480286} {:answer/id #uuid "79a108d2-31f6-5580-a65c-9af14c23117c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{-t}" :db/id #edb/ref 17592186480310} {:answer/id #uuid "9ce60844-2f9b-561b-af0b-96198d74c1e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}\\,{e}^{-t}}{2}" :db/id #edb/ref 17592186480369} {:answer/id #uuid "cebd021e-80fb-5feb-a087-fc29f42f4665" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\,{e}^{-t}" :db/id #edb/ref 17592186480457}] :answer-field/correct {:db/id #edb/ref 17592186480369} :answer-field/id #uuid "fbef7b1b-2a5f-5dce-929c-f5b8a633c936" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186480630}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1fed5aa4-7f90-50cb-8379-da324cfd5754" :question/math-academy-id "q-80612" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows:\n\n$$\n\\begin{aligned}{r}^{′}(t)={e}^{t}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩,\\,{T}^{′}(t)=-\\frac{\\sqrt{2}}{2}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t),$ we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${T}^{′}(t)$ and ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =|-\\frac{\\sqrt{2}}{2}|\\sqrt{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{({sin}^{2}⁡t+{cos}^{2}⁡t)+({sin}^{2}⁡t+{cos}^{2}⁡t)+(2\\operatorname{cos}⁡t\\operatorname{sin}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t)} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{1+1+0} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{2} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & ={e}^{t}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)^{2}} \\\\  & ={e}^{t}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t} \\\\  & ={e}^{t}\\sqrt{({cos}^{2}⁡t+{sin}^{2}⁡t)+({cos}^{2}⁡t+{sin}^{2}⁡t)+(-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)} \\\\  & ={e}^{t}\\sqrt{1+1+0} \\\\  & =\\sqrt{2}\\,{e}^{t}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{\\sqrt{2}\\,{e}^{t}}=\\frac{\\sqrt{2}\\,{e}^{-t}}{2}.\\end{aligned}\n$$"} {:answer/id #uuid "344eed9f-15e2-5d9d-a328-322b0adeb917" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{3}⁡2" :db/id #edb/ref 17592186480839} {:answer/id #uuid "602828b8-7fa4-51b0-ae3e-ca2c02d7c8af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186480917} {:answer/id #uuid "68632396-ccfe-581e-8589-6ce419497b94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{ln}^{3}⁡2" :db/id #edb/ref 17592186480933} {:answer/id #uuid "79ad7697-010f-568d-851d-4911a16f499a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186480962} {:answer/id #uuid "95eca681-53e5-51f4-8569-95f9733c2dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{ln}^{2}⁡2" :db/id #edb/ref 17592186481024} {:answer/id #uuid "b6110701-1956-577b-a189-4d9681a4e3ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186481086} {:answer/id #uuid "f0d1564e-78dd-55a4-b512-a4adf4fcad56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{ln}^{2}⁡2" :db/id #edb/ref 17592186481203} {:db/id #edb/ref 17592186481357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e360105-eb66-5367-814d-689677702f6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186480975} {:answer/id #uuid "9e9f7126-1aec-56cb-a084-4f34d28dafc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186481043} {:answer/id #uuid "a79440e4-ebcc-5811-a667-c1e64c7db96b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186481055} {:answer/id #uuid "c27b400b-e962-57cc-9be7-11f6f93220fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186481111} {:answer/id #uuid "d99527b4-de43-5d96-9eda-144ff935847e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186481146}] :answer-field/correct {:db/id #edb/ref 17592186480975} :answer-field/id #uuid "2a10b6cc-8155-5c1e-bf70-aecfcd94d2ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481254}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3b9226c2-67e0-5858-9c64-ae46c4147a95" :question/math-academy-id "q-163257" :question/problem "Find the average value of the function $f(x,y)={y}^{2}$ on the disk of radius $2$ centered at the origin." :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {2}^{2}=4\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <2\\pi \\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta {\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,{[\\frac{{r}^{4}}{4}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta (4-0)\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =2{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =2[(2\\pi -0)-\\frac{1}{2}(\\operatorname{sin}⁡4\\pi -\\operatorname{sin}⁡0)] \\\\  & =2\\cdot 2\\pi  \\\\  & =4\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{4\\pi }\\cdot 4\\pi =1.\n$$"} {:db/id #edb/ref 17592186481371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4c86f2-5cfb-5693-a142-edc6be59008a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186480767} {:answer/id #uuid "344eed9f-15e2-5d9d-a328-322b0adeb917" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{3}⁡2" :db/id #edb/ref 17592186480839} {:answer/id #uuid "68632396-ccfe-581e-8589-6ce419497b94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{ln}^{3}⁡2" :db/id #edb/ref 17592186480933} {:answer/id #uuid "79ad7697-010f-568d-851d-4911a16f499a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186480962} {:answer/id #uuid "95eca681-53e5-51f4-8569-95f9733c2dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{ln}^{2}⁡2" :db/id #edb/ref 17592186481024}] :answer-field/correct {:db/id #edb/ref 17592186480933} :answer-field/id #uuid "f081c215-96de-53ac-b301-926b90ac00ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481333}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5de90e63-3afe-527a-b599-3cdcd703aa52" :question/math-academy-id "q-83656" :question/problem "Using the change of variables $u={e}^{x}$ and $v={e}^{y},$ evaluate the double integral\n\n$$\n{∬}_{D}y\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,1\\le {e}^{x}\\le 2,\\,1\\le {e}^{y}\\le 4\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu={e}^{x},\\,v={e}^{y}\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{x} & 0 \\\\ 0 & \\text{ }\\text{ }{e}^{y}\\end{vmatrix} \\\\  & ={e}^{x+y}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{{e}^{x+y}}=\\frac{1}{uv}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y\\,dx\\,dy & ={∬}_{Δ}\\operatorname{ln}⁡v\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}\\operatorname{ln}⁡v\\cdot |\\frac{1}{uv}|\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}[{\\int }_{1}^{4}\\frac{\\operatorname{ln}⁡v}{v}\\,dv]du \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}{[\\frac{{ln}^{2}⁡v}{2}]}_{1}^{4}du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{u}[{ln}^{2}⁡4-{ln}^{2}⁡1]\\,du \\\\  & =\\frac{{ln}^{2}⁡4}{2}{\\int }_{1}^{2}\\frac{1}{u}\\,du \\\\  & =2{ln}^{2}⁡2[\\operatorname{ln}⁡u]_{1}^{2} \\\\  & =2{ln}^{2}⁡2(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2{ln}^{3}⁡2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ff48332-0b7f-5b0d-8590-a4d156a2b875" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186480862} {:answer/id #uuid "69523ed9-1689-5400-b80a-645cd83eb2ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 2\\sqrt{2} & 0 \\\\ 0 & 0 & -2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186480935} {:answer/id #uuid "8e3287fd-4f76-531c-8093-5fc460eaebc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186481007} {:answer/id #uuid "949111d0-6bc2-5d15-8315-e4a2fc30e721" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186481019} {:answer/id #uuid "9666dbcc-708b-575b-a68d-ee485b61f0dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186481027}] :answer-field/correct {:db/id #edb/ref 17592186481027} :answer-field/id #uuid "95c98126-2281-5305-93e6-da18146facd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481292}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f2c9542-25be-572a-a669-8d12401722e1" :question/math-academy-id "q-84600" :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}4 & 0 & 3 \\\\ 2 & 4 & -9 \\\\ -8 & 0 & -4\\end{bmatrix}.\n$$\n\nDetermine whether $A=PD{P}^{-1}$ for some invertible matrix $P$ and a diagonal matrix $D,$ where $P$ and $D$ are both real. In the affirmative case, find a possible diagonal matrix $D.$" :question/worked-solution "First, we need to determine whether $D$ is diagonalizable over $R.$\n\nWe start by computing the eigenvalues of $A.$ To do that, we solve the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & 3 \\\\ 2 & 4-\\lambda  & -9 \\\\ -8 & 0 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}4-\\lambda  & 3 \\\\ -8 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((4-\\lambda )(-4-\\lambda )+24) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}+8) & =0.\\end{aligned}\n$$\n\nFor the quadratic polynomial $\\,{\\lambda }^{2}+8\\,$ we have that the discriminant $D<0.$ So, it doesn't have real roots. \n\nTherefore, $A$ is not diagonalizable over $R.$"} {:db/id #edb/ref 17592186481389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac193e9-56da-5e90-afd1-e67c5f8d1870" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186480816} {:answer/id #uuid "602828b8-7fa4-51b0-ae3e-ca2c02d7c8af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186480917} {:answer/id #uuid "8be6f850-b0e1-5bd0-adfc-a35ba9264b99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡2" :db/id #edb/ref 17592186481005} {:answer/id #uuid "b6110701-1956-577b-a189-4d9681a4e3ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186481086} {:answer/id #uuid "f0d1564e-78dd-55a4-b512-a4adf4fcad56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{ln}^{2}⁡2" :db/id #edb/ref 17592186481203}] :answer-field/correct {:db/id #edb/ref 17592186481203} :answer-field/id #uuid "a913f95c-4f3f-51d9-a609-d167776b85b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481297}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7fe6b99e-c147-51fb-b13e-2b0491dcfd3c" :question/math-academy-id "q-83653" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}\\frac{\\operatorname{ln}⁡(y-2x)}{y-2x}\\,dxdy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,1\\le y-2x\\le 4,\\,0\\le y\\le 2\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le y-2x\\le 4,\\,0\\le y\\le 2,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-2x\\,\\text{and}\\,v=y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,0\\le v\\le 2\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & \\text{ }\\text{ }1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{\\operatorname{ln}⁡(y-2x)}{y-2x}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}\\frac{\\operatorname{ln}⁡u}{u}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{\\operatorname{ln}⁡u}{u}\\,|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}[{\\int }_{1}^{4}\\frac{\\operatorname{ln}⁡u}{u}\\,du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{[\\frac{{ln}^{2}⁡u}{2}]}_{1}^{4}dv \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({ln}^{2}⁡4-{ln}^{2}⁡1)\\,dv \\\\  & =\\frac{1}{4}{ln}^{2}⁡4{\\int }_{0}^{2}dv \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡2)^{2}\\cdot [v]_{0}^{2} \\\\  & ={ln}^{2}⁡2\\cdot (2-0) \\\\  & =2{ln}^{2}⁡2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e40d47-7a70-5f2c-ba24-6a855b1d6eb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{16}{3\\pi }" :db/id #edb/ref 17592186480757} {:answer/id #uuid "43bff162-e0e6-5e6e-b559-7547ee7c72a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186480868} {:answer/id #uuid "e1b2263d-a0be-566e-8984-74cc5d983449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{16}{5\\pi }" :db/id #edb/ref 17592186481164} {:answer/id #uuid "e83a9fc3-1293-5456-b3e0-ca1e41eb01ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{32}{3}" :db/id #edb/ref 17592186481182} {:answer/id #uuid "e979451f-00ff-5ed9-83e8-7aff07a87414" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{32}{3\\pi }" :db/id #edb/ref 17592186481185}] :answer-field/correct {:db/id #edb/ref 17592186481185} :answer-field/id #uuid "7e8c2182-159c-53aa-a9ec-6a0270a24944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481282}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b0a81f04-6f59-512d-aa20-c54e3b26a51d" :question/math-academy-id "q-163277" :question/problem "![](images/06/06a853735916ae3219eea02fa7e7e30d9e941106600cd5b642d951f553aace59.png)\n\nFind the average value of the function $f(x,y)=5y({x}^{2}+{y}^{2})$ on the semicircle shown above." :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {1}^{2}=\\frac{\\pi }{2}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at \n$(1,0).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that is mind, let's now write the $y=-\\sqrt{2x-{x}^{2}}$ in polar coordinates:\n\n$$\n\\begin{aligned}y & =-\\sqrt{2x-{x}^{2}} \\\\ {y}^{2} & =2x-{x}^{2} \\\\ {x}^{2}+{y}^{2} & =2x \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}5y({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}5r\\operatorname{sin}⁡\\theta ((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\operatorname{sin}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta [{r}^{5}]_{0}^{2\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta ((2\\operatorname{cos}⁡\\theta )^{5}-0)\\,\\text{d}\\theta  \\\\  & =32{\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {cos}^{5}⁡\\theta \\,\\text{d}\\theta  \\\\  & =32{[-\\frac{1}{6}{cos}^{6}⁡\\theta ]}_{-\\pi /2}^{0} \\\\  & =-\\frac{16}{3}[{cos}^{6}⁡(0)-{cos}^{6}⁡\\left(-\\frac{\\pi }{2}\\right)] \\\\  & =-\\frac{16}{3}(1-0) \\\\  & =-\\frac{16}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\left(\\frac{\\pi }{2}\\right)}\\cdot \\left(-\\frac{16}{3}\\right)=-\\frac{32}{3\\pi }.\n$$"} {:db/id #edb/ref 17592186481418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062b1938-49ed-576d-84ed-09a8fb852cc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{{\\pi }^{3}}{8}" :db/id #edb/ref 17592186480749} {:answer/id #uuid "34aac4ef-6b3d-5a11-9211-3216b95b6351" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186480841} {:answer/id #uuid "365aa022-a66e-5c42-b417-e96430223091" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{3}}{8}-1" :db/id #edb/ref 17592186480846} {:answer/id #uuid "9d25158d-398d-5c30-8fda-c6ddce1b0d76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{2}}{16}-1" :db/id #edb/ref 17592186481040} {:answer/id #uuid "f17962e7-50b9-5445-bd8a-61e21702bfc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{3}}{16}" :db/id #edb/ref 17592186481208}] :answer-field/correct {:db/id #edb/ref 17592186481208} :answer-field/id #uuid "be68da14-ad39-5dd8-8b81-96f9bc5c3b1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481309}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c8466ab0-fd66-5adb-8220-fa89c46bae69" :question/math-academy-id "q-38309" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}y{cos}^{2}⁡(y-x)\\,dxdy,\n$$\n\n \nwhere $$\n\\displaystyle D=\\{(x,y)\\,:\\,|y-x|\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2}\\}.\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n\\frac{\\pi }{2}\\le y-x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2},\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-x\\,\\text{and}\\,v=y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,-\\frac{\\pi }{2}\\le u\\le \\frac{\\pi }{2},\\,0\\le v\\le \\frac{\\pi }{2}\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & \\text{ }\\text{ }1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y{cos}^{2}⁡(y-x)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}v{cos}^{2}⁡u\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}v{cos}^{2}⁡u\\cdot |-1|\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{0}^{\\pi /2}v[{\\int }_{-\\pi /2}^{\\pi /2}{cos}^{2}⁡u\\,du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}v[{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡2u+1)du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}v[\\frac{\\operatorname{sin}⁡2u}{2}+u]_{-\\pi /2}^{\\pi /2}\\,dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}\\pi v\\,dv \\\\  & =\\frac{\\pi }{2}[\\frac{{v}^{2}}{2}]_{0}^{\\pi /2} \\\\  & =\\frac{\\pi }{2}\\cdot \\frac{{\\pi }^{2}}{8} \\\\  & =\\frac{{\\pi }^{3}}{16}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e532867a-5904-5097-b258-56f52a8eafe0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{\\operatorname{ln}9}-8+11e" :db/id #edb/ref 17592186481486}] :answer-field/correct {:db/id #edb/ref 17592186481486} :answer-field/id #uuid "71a8e926-e788-53c1-a4f8-cd5345e7fd65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186481481}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "24f4145d-a04e-5fb8-8280-a3728a721ed4" :question/problem "Given the function  $y=5{log}_{9}⁡x-8\\operatorname{ln}⁡x+11{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{9}⁡x-8\\operatorname{ln}⁡x+11{e}^{x}) \\\\  & =\\frac{5}{x\\operatorname{ln}⁡9}-\\frac{8}{x}+11{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{5}{x\\operatorname{ln}⁡9}-\\frac{8}{x}+11{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{5}{1\\cdot \\operatorname{ln}⁡9}-\\frac{8}{1}+11{e}^{1} \\\\  & =\\frac{5}{\\operatorname{ln}⁡9}-8+11e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dacc1cb1-f678-5e21-9b7f-a0bb91c67018" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{\\operatorname{ln}4}-9+11e" :db/id #edb/ref 17592186481485}] :answer-field/correct {:db/id #edb/ref 17592186481485} :answer-field/id #uuid "05c94f4f-e971-5303-b923-27e267ef297a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186481476}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3cd2bdcf-6143-519a-ac11-bbd298abfe66" :question/problem "Given the function  $y=8{log}_{4}⁡x-9\\operatorname{ln}⁡x+11{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8{log}_{4}⁡x-9\\operatorname{ln}⁡x+11{e}^{x}) \\\\  & =\\frac{8}{x\\operatorname{ln}⁡4}-\\frac{9}{x}+11{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{8}{x\\operatorname{ln}⁡4}-\\frac{9}{x}+11{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{8}{1\\cdot \\operatorname{ln}⁡4}-\\frac{9}{1}+11{e}^{1} \\\\  & =\\frac{8}{\\operatorname{ln}⁡4}-9+11e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1adbe12d-f32a-5283-bfd1-ceea4ff485dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{\\operatorname{ln}6}-5+8e" :db/id #edb/ref 17592186481478}] :answer-field/correct {:db/id #edb/ref 17592186481478} :answer-field/id #uuid "ed93bfe6-3d23-5d4d-86fd-f655f3e1d84f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186481487}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7f163702-82c3-5ed2-8962-43ef81d57fe6" :question/problem "Given the function  $y=3{log}_{6}⁡x-5\\operatorname{ln}⁡x+8{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{log}_{6}⁡x-5\\operatorname{ln}⁡x+8{e}^{x}) \\\\  & =\\frac{3}{x\\operatorname{ln}⁡6}-\\frac{5}{x}+8{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x\\operatorname{ln}⁡6}-\\frac{5}{x}+8{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{3}{1\\cdot \\operatorname{ln}⁡6}-\\frac{5}{1}+8{e}^{1} \\\\  & =\\frac{3}{\\operatorname{ln}⁡6}-5+8e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cde23ae-bead-5869-9906-e9c6214c46d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\operatorname{ln}12}-7+7e" :db/id #edb/ref 17592186481482}] :answer-field/correct {:db/id #edb/ref 17592186481482} :answer-field/id #uuid "0bb7323d-b76c-5542-af71-a8b52e1ad3fe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186481477}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a17970fe-3001-5d61-8d91-323cad97da24" :question/problem "Given the function  $y=2{log}_{12}⁡x-7\\operatorname{ln}⁡x+7{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{log}_{12}⁡x-7\\operatorname{ln}⁡x+7{e}^{x}) \\\\  & =\\frac{2}{x\\operatorname{ln}⁡12}-\\frac{7}{x}+7{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x\\operatorname{ln}⁡12}-\\frac{7}{x}+7{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{2}{1\\cdot \\operatorname{ln}⁡12}-\\frac{7}{1}+7{e}^{1} \\\\  & =\\frac{2}{\\operatorname{ln}⁡12}-7+7e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186481489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a9452ef-d6d8-5d77-ba34-757f36ca67bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12/(7x)" :db/id #edb/ref 17592186481490} {:answer/id #uuid "e342c790-6ed9-5d0c-ad29-dfb8163ed40f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{12}{7x}" :db/id #edb/ref 17592186481492}] :answer-field/correct {:db/id #edb/ref 17592186481492} :answer-field/id #uuid "d4026733-e07a-5d7b-af8c-4ddcdd5e7562" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186481491}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2aa37d05-2721-560e-879d-45257a2942c1" :question/problem "Given that $y=-\\frac{12}{7}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{12}{7}ln⁡x) \\\\  & =-\\frac{12}{7}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =-\\frac{12}{7}\\cdot \\frac{1}{x} \\\\  & =-\\frac{12}{7x}.\\end{aligned}\n$$"} {:answer/id #uuid "0cf20c60-05f2-5708-980b-fd1527c75409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\pi /2}{\\int }_{0}^{9\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{4}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/id #edb/ref 17592186481802} {:answer/id #uuid