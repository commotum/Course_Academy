41f6b-566b-50c0-84f6-8e034c917e79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186489431}] :answer-field/correct {:db/id #edb/ref 17592186489407} :answer-field/id #uuid "3ee0f43d-3c4a-51a8-975c-eb46b3a70f21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489402}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c3baed33-1cfd-5982-8e88-c33747aa34cf" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(2x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=2x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=2.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 2 \\\\  & =4(\\operatorname{cot}⁡(2x-1))^{3}\\cdot (-{csc}^{2}⁡(2x-1))\\cdot 2 \\\\  & =-8{cot}^{3}⁡(2x-1){csc}^{2}⁡(2x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-8{cot}^{3}⁡(2(0)-1){csc}^{2}⁡(2(0)-1) \\\\  & =-8{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-8(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =8{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"} {:answer/id #uuid "c4041f6b-566b-50c0-84f6-8e034c917e79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186489431} {:db/id #edb/ref 17592186489432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2970eeb1-3b49-50db-9453-4ae0d788a789" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\operatorname{cot}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186489394} {:answer/id #uuid "83cf7332-9e22-5d6b-ac71-dbdbc51417e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186489418} {:answer/id #uuid "c620ccb3-5b19-5217-abfc-3a07d7d021d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489434} {:answer/id #uuid "d7a96852-18db-5426-80b3-8889b50de605" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489436} {:answer/id #uuid "e235745d-204e-54fb-993d-8da177d2d7b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489442}] :answer-field/correct {:db/id #edb/ref 17592186489434} :answer-field/id #uuid "fe24ada9-bd92-5b0d-bbee-0258963f8532" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489450}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c51262c0-6413-5083-b852-6971681819a1" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(3x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=3x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=3.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 3 \\\\  & =4(\\operatorname{cot}⁡(3x-1))^{3}\\cdot (-{csc}^{2}⁡(3x-1))\\cdot 3 \\\\  & =-12{cot}^{3}⁡(3x-1){csc}^{2}⁡(3x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-12{cot}^{3}⁡(3(0)-1){csc}^{2}⁡(3(0)-1) \\\\  & =-12{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-12(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =12{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"} {:answer/id #uuid "c620ccb3-5b19-5217-abfc-3a07d7d021d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489434} {:answer/id #uuid "d7a96852-18db-5426-80b3-8889b50de605" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489436} {:answer/id #uuid "e235745d-204e-54fb-993d-8da177d2d7b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489442} {:answer/id #uuid "e2c86454-1fbf-57d8-9fab-f0e9a82e9af9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{sin}^{2}⁡(1{x}^{2}-1)\\,{cos}^{2}⁡(1{x}^{2}-1)" :db/id #edb/ref 17592186489443} {:db/id #edb/ref 17592186489448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22005ee4-41d0-5760-b893-f0fac19db39a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489393} {:answer/id #uuid "2f2a9975-b462-5030-bd6f-57419893c0e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186489396} {:answer/id #uuid "6fd77f99-da27-58dd-a347-1c31d50cedc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489414} {:answer/id #uuid "9249d26c-d661-549a-91a4-caf233a82221" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186489422} {:answer/id #uuid "af8ef9cf-cd77-54c5-ad2b-ba9478fe6d6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cot}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186489426}] :answer-field/correct {:db/id #edb/ref 17592186489414} :answer-field/id #uuid "3abb3881-a4da-56ea-afd6-a57f4bafd656" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489400}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f751f15c-49b5-572a-960c-e6e9fe0fd73f" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(1x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=1x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=1.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 1 \\\\  & =4(\\operatorname{cot}⁡(1x-1))^{3}\\cdot (-{csc}^{2}⁡(1x-1))\\cdot 1 \\\\  & =-4{cot}^{3}⁡(1x-1){csc}^{2}⁡(1x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-4{cot}^{3}⁡(1(0)-1){csc}^{2}⁡(1(0)-1) \\\\  & =-4{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-4(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =4{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"} {:answer/id #uuid "f7dc7484-013b-5097-9937-5df5cca67819" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x{sin}^{2}⁡(1{x}^{2}-1)\\,\\operatorname{cos}⁡(1{x}^{2}-1)" :db/id #edb/ref 17592186489449} {:answer/id #uuid "05f23a5e-38cb-539f-b7c3-cad96ff77d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=\\sqrt{5}\\in A" :db/id #edb/ref 17592186489526} {:answer/id #uuid "10e66bfe-083b-5be0-9583-02c2dd9dbc3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=\\frac{13}{3}\\in A" :db/id #edb/ref 17592186489555} {:answer/id #uuid "16f916cc-94f7-5a71-a178-e1e606a172ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(A)=-1\\notin A" :db/id #edb/ref 17592186489566} {:answer/id #uuid "225d50ae-b160-598c-be28-9629eed2f658" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=1\\in A" :db/id #edb/ref 17592186489593} {:answer/id #uuid "266c7228-b4bb-5e08-96bf-a8a086712c66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(A)=0\\in A" :db/id #edb/ref 17592186489601} {:answer/id #uuid "2f766286-1a1c-57a8-a6b8-b616bc34023c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=1\\notin A" :db/id #edb/ref 17592186489620} {:answer/id #uuid "359012f5-cc9b-54d0-9e9d-abb5cc134d22" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$sup(A)$ does not exist" :db/id #edb/ref 17592186489636} {:answer/id #uuid "5295bbac-a212-512d-9607-9f1f6bb17448" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(A)=-\\infty " :db/id #edb/ref 17592186489709} {:answer/id #uuid "64f36bf8-3759-5b50-8859-73b64d5b2c38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡3\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489752} {:answer/id #uuid "89293f7d-7259-5ca0-9d47-f57a27be0b52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=5\\in A" :db/id #edb/ref 17592186489831} {:answer/id #uuid "c65bb871-f69d-5809-a2e7-c05b75873a6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$sup(A)$ does not exist" :db/id #edb/ref 17592186489944} {:answer/id #uuid "cfcb399e-74da-5c9e-8dac-e3eed6a5f7de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(A)=-1\\in A" :db/id #edb/ref 17592186489976} {:answer/id #uuid "d5186c5a-5a30-5325-9bea-58622f595315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "inf(A)=0\\notin A" :db/id #edb/ref 17592186489987} {:answer/id #uuid "d622005e-b5a8-5b3b-b564-16897d776f36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=5\\notin A" :db/id #edb/ref 17592186489989} {:answer/id #uuid "df7f2a2d-61f7-56a7-bec1-7262e75f747b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=\\frac{13}{3}\\notin A" :db/id #edb/ref 17592186490001} {:answer/id #uuid "ee34141a-6edc-54b6-9e0d-cc36d21328ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=\\sqrt{5}\\notin A" :db/id #edb/ref 17592186490028} {:db/id #edb/ref 17592186490216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3db2d41-9f95-5454-99e3-3731cf3c7216" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186489907}] :answer-field/correct {:db/id #edb/ref 17592186489907} :answer-field/id #uuid "641a7bf6-8d64-5bbd-b720-80aba2e3fd36" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490133}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0ecf28e6-85ea-58f8-8358-bdfe911fb50e" :question/math-academy-id "q-253542" :question/problem "What is the infimum of the set $C=\\{-1,\\,-3,\\,0,\\,2,\\,1,\\,-2\\}?$\n\n$inf(C)=$\n{{field-1}}" :question/worked-solution "The infimum of a set $C$ is the greatest lower bound of $C.$\n\nIf $C$ is a finite set, the infimum of $C$ equals its minimum. Therefore,\n\n$$\n\\begin{aligned}inf(C) & =min\\{-1,\\,-3,\\,0,\\,2,\\,1,\\,-2\\}=-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e66bfe-083b-5be0-9583-02c2dd9dbc3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=\\frac{13}{3}\\in A" :db/id #edb/ref 17592186489555} {:answer/id #uuid "89293f7d-7259-5ca0-9d47-f57a27be0b52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=5\\in A" :db/id #edb/ref 17592186489831} {:answer/id #uuid "c65bb871-f69d-5809-a2e7-c05b75873a6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$sup(A)$ does not exist" :db/id #edb/ref 17592186489944} {:answer/id #uuid "d622005e-b5a8-5b3b-b564-16897d776f36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=5\\notin A" :db/id #edb/ref 17592186489989} {:answer/id #uuid "df7f2a2d-61f7-56a7-bec1-7262e75f747b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sup(A)=\\frac{13}{3}\\notin A" :db/id #edb/ref 17592186490001}] :answer-field/correct {:db/id #edb/ref 17592186489989} :answer-field/id #uuid "236e608b-8ac0-548b-a7ea-fa7e8de10892" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186490090}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2472238f-de89-5651-9808-c29025aa1081" :question/math-academy-id "q-253514" :question/problem "Consider the following set.\n\n$$\nA=\\{5-{\\left(\\frac{2}{3}\\right)}^{n}\\,:\\,n\\in N\\}\n$$\n\nFor this set, we have {{field-1}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nThe elements of $A$ are all the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=5-{\\left(\\frac{2}{3}\\right)}^{n},\\,n\\in N=\\{1,2,3,4,…\\}.\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/1e/1ea2ed214496ed38ae605e9ac64bebd781a0d5529561fce44d98cca6839d6fbb.png)\n\nWe see that ${a}_{n}$ is increasing and converges to $5.$ \n\nSo, in our case, we have that\n\n- any number in the set $x\\ge 5$ is an upper bound of $A,$\n\n- any number in the set $x<5$ is **not** an upper bound of $A.$ In other words, we can always find a sufficiently large $n$ so that $5-{\\left(\\frac{2}{3}\\right)}^{n}$ is greater than $x$ for any $x<5.$\n\nTherefore, $[5,\\infty )$ is the set of upper bounds of $A,$ and \n\n$$\nsup(A)=min[5,\\infty )=5.\n$$\n\nNotice that $5$ is *not* the maximum of $A$ (the set $A$ has no maximum). Therefore, we conclude that\n\n$$\nsup(A)=5\\notin A.\n$$"} {:db/id #edb/ref 17592186490225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b7494e-bb79-5b12-9236-a587f999330d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489565} {:answer/id #uuid "1b976c74-2288-5edb-ac14-b1435c6814f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡3\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489578} {:answer/id #uuid "4a39aa0a-e274-5fb2-8704-b394c3cd5dd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186489687} {:answer/id #uuid "65a94067-f449-5e05-8e2b-89087734bd4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡x\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489754} {:answer/id #uuid "7c3b6154-88e4-5ca3-9c7b-ddeffecf3bd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489798}] :answer-field/correct {:db/id #edb/ref 17592186489798} :answer-field/id #uuid "3273c5e4-90f1-5aee-9f26-60f52ccd89f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490099}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "29e8aaaf-e383-5b29-a6be-9cfefb451c7a" :question/math-academy-id "q-31616" :question/problem "What is the value of $$\n\\displaystyle {\\int }_{5}^{25}\\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x?\n$$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $25$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{25}\\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3{\\int }_{5}^{25}\\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =3\\operatorname{ln}⁡5(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =3\\operatorname{ln}⁡2\\operatorname{ln}⁡5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcae1ab-8b52-5672-bb43-dd85e7593b29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186489655}] :answer-field/correct {:db/id #edb/ref 17592186489655} :answer-field/id #uuid "383aa34f-a1d1-5f56-a588-24ec2c1c5712" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490106}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "332a6eec-904f-5523-bf1a-c62328e3b046" :question/math-academy-id "q-253552" :question/problem "Consider the set $A,$ defined as\n\n$$\nA=\\{(-1)^{n+1}\\cdot n:n\\in \\{1,2,3,4\\}\\}.\n$$\n\nWhat is the supremum of $A?$\n\n$sup(A)=$\n{{field-1}}" :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nIf $A$ is a finite set, the supremum of $A$ equals its maximum. \n\nFirst, let's write down all the terms of our set by substituting $n=1,2,3,4$ into the expression for the elements of $A:$\n\n$$\n\\begin{aligned}(-1)^{1+1}\\cdot 1 & =1 \\\\ (-1)^{2+1}\\cdot 2 & =-2 \\\\ (-1)^{3+1}\\cdot 3 & =3 \\\\ (-1)^{4+1}\\cdot 4 & =-4\\end{aligned}\n$$\n\nSo, we have\n\n$$\nA=\\{1,\\,-2,\\,3,\\,-4\\}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sup(A) & =max\\{1,\\,-2,\\,3,\\,-4\\}=3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "588a64f8-b007-597a-90a1-13bc0deadb69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(\\operatorname{ln}⁡3)" :db/id #edb/ref 17592186489726} {:answer/id #uuid "58d74548-f1c5-5c19-af0c-64a5b689a324" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489727} {:answer/id #uuid "64f36bf8-3759-5b50-8859-73b64d5b2c38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡3\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489752} {:answer/id #uuid "ae420e08-ae64-53a3-b2a8-a61252329c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489897} {:answer/id #uuid "fba1a44c-3ac0-56fc-b34d-91572dd0f45a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡x\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186490061}] :answer-field/correct {:db/id #edb/ref 17592186489727} :answer-field/id #uuid "1e61d7a6-a656-53b9-8d80-257f6bbc76cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490088}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "43a38f2f-26ab-5a55-9c36-de9ec5e565a5" :question/math-academy-id "q-31615" :question/problem "What is the value of $$\n\\displaystyle {\\int }_{4}^{8}\\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x?\n$$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $8$ |\n| --- | --- | --- |\n| $u$ | $2$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{8}\\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & ={\\int }_{4}^{8}\\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{3}\\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2(\\operatorname{ln}⁡|u|){|}_{2}^{3} \\\\  & =\\operatorname{ln}⁡2\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59077802-2ece-52ce-8fdb-8f6f3735b72f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489730} {:answer/id #uuid "da84991b-fcac-5426-a689-60bfacfa87a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489996} {:answer/id #uuid "df6c29bc-d773-5ece-9a45-14b4359b35cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489999} {:answer/id #uuid "eed896f0-f769-50fb-a53d-7bc14aff6cc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490029} {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032}] :answer-field/correct {:db/id #edb/ref 17592186490032} :answer-field/id #uuid "a108c977-d111-5123-bfa0-9f9dd2b6376b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490166}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "633f13a2-1c12-5a0e-ade7-b4d04e14c842" :question/math-academy-id "q-13844" :question/problem "What is the value of $$\n\\displaystyle {\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x?\n$$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡8$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{2}\\frac{1}{(\\operatorname{ln}⁡(4x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {(-{u}^{-1})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}\\cdot {\\left(\\frac{1}{u}\\right)|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡8}-\\frac{1}{\\operatorname{ln}⁡4}) \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡{2}^{3}}-\\frac{1}{\\operatorname{ln}⁡{2}^{2}}) \\\\  & =-\\frac{3}{2}(\\frac{1}{3\\operatorname{ln}⁡2}-\\frac{1}{2\\operatorname{ln}⁡2}) \\\\  & =-\\frac{3}{2}\\left(-\\frac{1}{6\\operatorname{ln}⁡2}\\right) \\\\  & =\\frac{1}{4\\operatorname{ln}⁡2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e1ddde-094e-575d-9216-44ec5195d360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186489524} {:answer/id #uuid "3f4f994b-ba11-5ca0-aef7-b28106a79f3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186489658} {:answer/id #uuid "4cd1b0f7-d80a-50b7-845c-cc2784569fb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186489694} {:answer/id #uuid "f3ccc00a-63f1-5bd8-a453-0e81d703f3e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186490040}] :answer-field/correct {:db/id #edb/ref 17592186490040} :answer-field/id #uuid "149b46b7-83ac-5b5a-b14c-9564fbc3ed3d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186490085} {:answer-field/choices [{:answer/id #uuid "2653f489-1ea3-5e38-8c0d-93a677463b87" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "smalles