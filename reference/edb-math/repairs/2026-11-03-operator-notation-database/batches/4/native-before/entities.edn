ede-5cd9-b8a2-779cbb72169e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡6=x" :db/id #edb/ref 17592186514113}] :answer-field/correct {:db/id #edb/ref 17592186513533} :answer-field/id #uuid "8bfd34ec-e52b-501c-99fa-9774a784be78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514294}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "053acc10-5279-5930-8cdc-4b0bb8c6548c" :question/math-academy-id "q-2982" :question/problem "${2}^{x}=64$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{x}=64$ with $a={b}^{x},$ we get $a=64$ and $b=2.$\n\nTherefore, the equation ${2}^{x}=64$ is equivalent to ${log}_{2}⁡64=x.$"} {:db/id #edb/ref 17592186514360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ab3879-2e3a-5271-93d4-d0935bd2ca32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\operatorname{sinh}⁡x-{sech}^{2}⁡x" :db/id #edb/ref 17592186513546} {:answer/id #uuid "3e36c9ef-6a7c-5a09-b3f9-570560a4f21f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{sinh}⁡x+\\operatorname{sech}⁡x" :db/id #edb/ref 17592186513696} {:answer/id #uuid "68b6196b-17c0-5be3-898c-a6ae5af8c973" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x" :db/id #edb/ref 17592186513813} {:answer/id #uuid "7489366b-e83b-5e6a-b0ff-16b6391f4b81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{sinh}⁡x-{sech}^{2}⁡x" :db/id #edb/ref 17592186513838} {:answer/id #uuid "ac937534-fd96-5c16-81b1-91fa1a169e39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{sinh}⁡x+{sech}^{2}⁡x" :db/id #edb/ref 17592186513985}] :answer-field/correct {:db/id #edb/ref 17592186513838} :answer-field/id #uuid "8394f195-7cf1-5ba2-9173-5600bc8349c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514288}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05b36d37-a26f-5d16-ae0b-dd50ba7890e6" :question/math-academy-id "q-95670" :question/problem "Find the derivative of $y=6\\operatorname{cosh}⁡x-\\operatorname{tanh}⁡x.$" :question/worked-solution "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{cosh}⁡x-\\operatorname{tanh}⁡x) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) \\\\  & =6\\operatorname{sinh}⁡x-{sech}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184567b3-3117-53f7-b834-8fce87f609ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{32}⁡2=x" :db/id #edb/ref 17592186513594} {:answer/id #uuid "4eb874fd-69aa-54af-bae8-bfb72c700049" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{x}⁡32=2" :db/id #edb/ref 17592186513746} {:answer/id #uuid "75fbd0b9-d9fb-5560-8900-a790eefb385f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{32}⁡x=2" :db/id #edb/ref 17592186513845} {:answer/id #uuid "b632151f-5928-5f49-843d-035deb3c234e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡x=32" :db/id #edb/ref 17592186514010} {:answer/id #uuid "bf5c1add-f890-555f-a7fd-bd4ad49b0a43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡32=x" :db/id #edb/ref 17592186514036}] :answer-field/correct {:db/id #edb/ref 17592186514036} :answer-field/id #uuid "dcd57e18-4821-54a3-925c-9c080aae5c81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514328}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "084b231a-35a2-58f7-86fa-95eb22a6b762" :question/math-academy-id "q-66551" :question/problem "${2}^{x}=32$ is equivalent to" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{x}=32$ with $a={b}^{x},$ we get $a=32$ and $b=2.$\n\nTherefore, the equation ${2}^{x}=32$ is equivalent to ${log}_{2}⁡32=x.$"} {:db/id #edb/ref 17592186514369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e651fca-df91-5a95-892f-780cef22a6df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186513611} {:answer/id #uuid "b85887ad-503b-5a31-9a5f-ed5afa3bbe07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186514018} {:answer/id #uuid "e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186514143} {:answer/id #uuid "f606c8f4-0164-5bb8-968e-6ee4d224953a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186514173} {:answer/id #uuid "f88ff125-ed18-5a84-bda5-936ae6d644fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186514181}] :answer-field/correct {:db/id #edb/ref 17592186514143} :answer-field/id #uuid "3235286d-76ea-568e-a9be-0249cc7ffbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514244}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13976613-adec-5296-be7c-cccd907c4b03" :question/math-academy-id "q-42998" :question/problem "Find $det({A}^{-1})$, if $$\n\\displaystyle A=\\begin{bmatrix}-2 & 1 \\\\ 4 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}-2 & 1 \\\\ 4 & 3\\end{bmatrix} \\\\  & =-6-4 \\\\  & =-10\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=-\\frac{1}{10}.\n$$"} {:db/id #edb/ref 17592186514372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022f1a03-c389-5417-9840-269af635a05d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{sech}⁡x-4\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186513530} {:answer/id #uuid "755e0dee-1ad3-5455-a72b-95356420ea2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{sech}⁡x+4\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186513841} {:answer/id #uuid "a72f2c7a-f375-5c68-a7ef-897ca237a31f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}{sech}^{2}⁡x-4\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186513963} {:answer/id #uuid "af7c9ea1-288c-5839-b4c5-25fe0687c0f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{sech}^{2}⁡x-4\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186513993} {:answer/id #uuid "f04916b4-6e99-5195-a44d-8f7bbbffacb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{sech}^{2}⁡x+4\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186514158}] :answer-field/correct {:db/id #edb/ref 17592186513993} :answer-field/id #uuid "29223fdb-fde4-56b6-bbbe-c49644ecd755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514240}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "16fea3d9-04d8-53ba-a81e-4ab7949c02d8" :question/math-academy-id "q-95671" :question/problem "Find the derivative of $y=\\frac{1}{2}\\operatorname{tanh}⁡x-4\\operatorname{sinh}⁡x.$" :question/worked-solution "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{tanh}⁡x-4\\operatorname{sinh}⁡x) \\\\  & =\\frac{1}{2}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)-4\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) \\\\  & =\\frac{1}{2}{sech}^{2}⁡x-4\\operatorname{cosh}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35efc2f3-5a80-5c14-ac74-576bc64f637c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡\\left(\\frac{27}{125}\\right)=\\frac{5}{3}" :db/id #edb/ref 17592186513676} {:answer/id #uuid "4edddaae-0652-54d7-9e9e-760697b96951" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3/5}⁡\\left(\\frac{27}{125}\\right)=-3" :db/id #edb/ref 17592186513747} {:answer/id #uuid "a62f0c1d-b7ab-5121-a583-d8ea6867f60b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3/5}⁡(3)=\\frac{27}{125}" :db/id #edb/ref 17592186513960} {:answer/id #uuid "aa0b430c-71e7-521b-9094-32d9db437933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{5/3}⁡(3)=\\frac{27}{125}" :db/id #edb/ref 17592186513974} {:answer/id #uuid "d64ad2ea-d44d-5757-b9ab-7c102491d163" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{5/3}⁡\\left(\\frac{27}{125}\\right)=-3" :db/id #edb/ref 17592186514092}] :answer-field/correct {:db/id #edb/ref 17592186514092} :answer-field/id #uuid "e306a9cd-6875-5b02-81a9-110f46795dae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514330}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "277ed942-8515-5af5-8070-395ac017b6ed" :question/math-academy-id "q-108051" :question/problem "$$\n\\displaystyle {\\left(\\frac{5}{3}\\right)}^{-3}=\\frac{27}{125}\n$$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare $$\n\\displaystyle {\\left(\\frac{5}{3}\\right)}^{-3}=\\frac{27}{125}\n$$ with $a={b}^{x},$ we get $a=\\frac{27}{125},b=\\frac{5}{3}$ and $x=-3.$\n\nTherefore, the given equation can be expressed as ${log}_{5/3}⁡\\left(\\frac{27}{125}\\right)=-3.$"} {:db/id #edb/ref 17592186514392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1036a5d2-4490-507d-98fa-001436fca0c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/3}⁡(1.587)≈4" :db/id #edb/ref 17592186513573} {:answer/id #uuid "11bc61a1-c5df-575f-a750-df7c1b87d279" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡(1.587)≈\\frac{1}{3}" :db/id #edb/ref 17592186513578} {:answer/id #uuid "44f257e1-6c2d-5a7b-b95b-d1cc1c85a226" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1.587}⁡(4)≈\\frac{1}{3}" :db/id #edb/ref 17592186513715} {:answer/id #uuid "80e8559d-f893-517b-8e0e-7cc3f3f01d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡\\left(\\frac{1}{3}\\right)≈1.587" :db/id #edb/ref 17592186513868} {:answer/id #uuid "de29e40b-df70-5eef-a11c-b501cec6c718" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1.587}⁡\\left(\\frac{1}{3}\\right)≈4" :db/id #edb/ref 17592186514116}] :answer-field/correct {:db/id #edb/ref 17592186513578} :answer-field/id #uuid "2d76220b-8379-56f0-b6f2-29c1efe40950" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514243}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3dd9e34f-3ee0-5a42-8a59-8773ae3a745a" :question/math-academy-id "q-66569" :question/problem "$\\sqrt[3]{4}≈1.587$ is equivalent to" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{4}^{1/3}≈1.587\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${4}^{1/3}≈1.587$ with $a={b}^{x},$ we get $a=1.587,b=4$ and $x=\\frac{1}{3}.$\n\nTherefore, the approximation $\\sqrt[3]{4}≈1.587$ is equivalent to ${log}_{4}⁡(1.587)≈\\frac{1}{3}.$"} {:db/id #edb/ref 17592186514398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d05d41c-03ea-5483-92aa-af31d2669524" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{\\operatorname{tanh}⁡{x}^{2}}{tanh}^{2}⁡{x}^{2}" :db/id #edb/ref 17592186513563} {:answer/id #uuid "2d9d5eb0-a002-5a56-9626-9a307dc92e97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{\\operatorname{tanh}⁡{x}^{2}}" :db/id #edb/ref 17592186513654} {:answer/id #uuid "8982439d-179b-56ff-9170-4b8f7f5cd5a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{{sech}^{2}⁡{x}^{2}}" :db/id #edb/ref 17592186513889} {:answer/id #uuid "b7343704-b6ba-5f2d-a062-42537a712dd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{\\operatorname{tanh}⁡{x}^{2}}{sech}^{2}⁡{x}^{2}" :db/id #edb/ref 17592186514014} {:answer/id #uuid "cdf51d8c-9d4d-5b3e-a107-4a55357ce776" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{{sech}^{2}⁡{x}^{2}}{sech}^{2}⁡{x}^{2}" :db/id #edb/ref 17592186514068}] :answer-field/correct {:db/id #edb/ref 17592186514014} :answer-field/id #uuid "c1758f56-8a11-59aa-87ff-3d7393707dd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514317}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49c81891-b661-5bda-b31c-54f1cc0220f3" :question/math-academy-id "q-165764" :question/problem "Find the derivative of $f(x)={e}^{\\operatorname{tanh}⁡{x}^{2}}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={e}^{g},\\,g=\\operatorname{tanh}⁡s,\\,s={x}^{2}\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}s}\\cdot \\frac{\\text{d}s}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}g}={e}^{g},\\,\\frac{\\text{d}g}{\\text{d}s}={sech}^{2}⁡s,\\,\\frac{\\text{d}s}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nFinally, multiplying the three results together and substituting for $g$ and $s$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={e}^{g}\\cdot {sech}^{2}⁡s\\cdot 2x \\\\  & ={e}^{\\operatorname{tanh}⁡{x}^{2}}\\cdot {sech}^{2}⁡{x}^{2}\\cdot 2x \\\\  & =2x{e}^{\\operatorname{tanh}⁡{x}^{2}}{sech}^{2}⁡{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f15ee6d-3774-57ff-9f40-a364a73b2883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}(\\operatorname{tanh}⁡3{x}^{2}+2{x}^{2}{sech}^{2}⁡{x}^{3})" :db/id #edb/ref 17592186513655} {:answer/id #uuid "341588b0-e576-5b38-951a-6a4b0b80aa65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}\\operatorname{tanh}⁡3{x}^{2}" :db/id #edb/ref 17592186513674} {:answer/id #uuid "b623ea0e-88cb-5afa-9b2e-75fa617f8b6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}{sech}^{2}⁡{x}^{3}" :db/id #edb/ref 17592186514009} {:answer/id #uuid "b78b565d-f891-5af0-a9bc-c15c2a69d9e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}(4\\operatorname{tanh}⁡{x}^{3}+3{x}^{3}{sech}^{2}⁡{x}^{3})" :db/id #edb/ref 17592186514015} {:answer/id #uuid "fe7a160f-b010-5b9c-8d7a-ac5d3301bb8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}(\\operatorname{tanh}⁡{x}^{3}+{x}^{3}{sech}^{2}⁡{x}^{3})" :db/id #edb/ref 17592186514205}] :answer-field/correct {:db/id #edb/ref 17592186514015} :answer-field/id #uuid "ec831a69-91d7-5f4f-b333-65069789c09e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514339}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d5258aa-0eff-5685-bbfc-832665398ac8" :question/math-academy-id "q-165768" :question/problem "Find the derivative of $t(x)={x}^{4}\\operatorname{tanh}⁡{x}^{3}.$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{4}$ and $v(x)=\\operatorname{tanh}⁡{x}^{3}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{t}^{′}(x) & =({x}^{4})^{′}\\cdot \\operatorname{tanh}⁡{x}^{3}+{x}^{4}\\cdot (\\operatorname{tanh}⁡{x}^{3})^{′} \\\\  & =4{x}^{3}\\cdot \\operatorname{tanh}⁡{x}^{3}+{x}^{4}\\cdot 3{x}^{2}{sech}^{2}⁡{x}^{3} \\\\  & =4{x}^{3}\\operatorname{tanh}⁡{x}^{3}+3{x}^{6}{sech}^{2}⁡{x}^{3} \\\\  & ={x}^{3}(4\\operatorname{tanh}⁡{x}^{3}+3{x}^{3}{sech}^{2}⁡{x}^{3})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d02516-dc5f-556e-b39b-13fd3d6b51e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}" :db/id #edb/ref 17592186513626} {:answer/id #uuid "4191a7a4-bbad-54ca-ae0a-22ddbb9adf9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}(2\\operatorname{cosh}⁡x+x\\operatorname{sinh}⁡x)}{\\operatorname{sinh}⁡x}" :db/id #edb/ref 17592186513705} {:answer/id #uuid "52b32764-b280-54de-ab6f-645fd35e4af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}(2\\operatorname{cosh}⁡x+x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}" :db/id #edb/ref 17592186513762} {:answer/id #uuid "a599deda-ccd7-5dbd-bc5d-645966e7e62e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{\\operatorname{cosh}⁡x}" :db/id #edb/ref 17592186513958} {:answer/id #uuid "f4ad5635-7e83-5570-a915-b14de794c9a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{sinh}^{2}⁡x}" :db/id #edb/ref 17592186514171}] :answer-field/correct {:db/id #edb/ref 17592186513626} :answer-field/id #uuid "7190823c-7b62-5fe3-8832-a1c3ce66183b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514281}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "620df981-8ac1-59e8-bd3d-58c107521764" :question/math-academy-id "q-95319" :question/problem "Find the derivative of $g(x)=\\frac{{x}^{2}}{\\operatorname{cosh}⁡x}.$" :question/worked-solution "In this case, the expression for $g(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={x}^{2}$ and $v(x)=\\operatorname{cosh}⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{g}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{2})^{′}\\cdot \\operatorname{cosh}⁡x-{x}^{2}\\cdot (\\operatorname{cosh}⁡x)^{′}}{(\\operatorname{cosh}⁡x)^{2}} \\\\  & =\\frac{2x\\operatorname{cosh}⁡x-{x}^{2}\\operatorname{sinh}⁡x}{{cosh}^{2}⁡x} \\\\  & =\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862}] :answer-field/correct {:db/id #edb/ref 17592186513862} :answer-field/id #uuid "ba412a72-8abe-5840-811a-70be04c017e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186514310}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "709bef3c-1deb-5177-94a0-6a0cd6bca192" :question/math-academy-id "q-166075" :question/problem "$$\n\\displaystyle \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{f}{h}\\right)\\,=\n$${{field-1}}" :question/worked-solution "Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$\n\nWe apply the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{f}{h}\\right) & =\\frac{{f}^{′}(x)\\cdot h(x)-f(x)\\cdot {h}^{′}(x)}{[h(x)]^{2}} \\\\  & =\\frac{{(\\frac{1}{2}{e}^{x})}^{′}\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)^{′}}{(-4\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{cos}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{2{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{8{sin}^{2}⁡x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080d06a2-ac80-5731-a0d0-206b199bf240" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{9}⁡81=\\frac{1}{2}" :db/id #edb/ref 17592186513553} {:answer/id #uuid "1f13dace-deeb-5459-8d06-c6c340fa8c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/2}⁡9=81" :db/id #edb/ref 17592186513613} {:answer/id #uuid "39829f81-a9cf-5068-bf86-ed19ab5065ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/9}⁡81=\\frac{1}{2}" :db/id #edb/ref 17592186513683} {:answer/id #uuid "85a1a928-ea1a-584e-b442-0719b4f51dbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡81=9" :db/id #edb/ref 17592186513881} {:answer/id #uuid "88b82b32-8bc8-502a-8a2d-cd08fa683704" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{81}⁡9=\\frac{1}{2}" :db/id #edb/ref 17592186513887}] :answer-field/correct {:db/id #edb/ref 17592186513887} :answer-field/id #uuid "946be36d-0d7e-50b8-bc82-1c900e600018" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "79a0a9c5-85f5-5fac-9044-aee801b38acc" :question/math-academy-id "q-99475" :question/problem "$\\sqrt{81}=9$ can be expressed as" :question/worked-solution "Notice that the given equation can be written using exponents as follows:\n\n$$\n{81}^{1/2}=9\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${81}^{1/2}=9$ with $a={b}^{x},$ we get $a=9,b=81$ and $x=\\frac{1}{2}.$\n\nTherefore, the equation $\\sqrt{81}=9$ is equivalent to ${log}_{81}⁡9=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186514429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "672925f1-f187-5823-b735-1420d87c9526" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3{x}^{2}}{\\operatorname{sinh}⁡{x}^{3}}" :db/id #edb/ref 17592186513807} {:answer/id #uuid "850b3671-0aaa-5270-8744-c50895b0849f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{{sinh}^{2}⁡{x}^{3}}" :db/id #edb/ref 17592186513879} {:answer/id #uuid "93445aab-8702-553f-ab97-b9a3cb2200c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{\\operatorname{sinh}⁡{x}^{3}}" :db/id #edb/ref 17592186513914} {:answer/id #uuid "acfbff32-5d56-5f99-a479-a3fd08b6c9f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}\\operatorname{tanh}⁡{x}^{3}" :db/id #edb/ref 17592186513986} {:answer/id #uuid "ceb54f55-a1ae-5979-8460-80acb2a96a67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{x}^{2}\\operatorname{coth}⁡{x}^{3}" :db/id #edb/ref 17592186514071}] :answer-field/correct {:db/id #edb/ref 17592186513879} :answer-field/id #uuid "d1ea0ed9-861a-53c7-a186-58ae5ac5ba7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514325}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c706f9d-3f1b-52c2-a133-ccf4032fcc0e" :question/math-academy-id "q-95682" :question/problem "Find the derivative of $f(x)=\\frac{1}{\\operatorname{sinh}⁡{x}^{3}}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=\\frac{1}{g},\\,g=\\operatorname{sinh}⁡s,\\,s={x}^{3}\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}s}\\cdot \\frac{\\text{d}s}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}g} & =-\\frac{1}{{g}^{2}},\\,\\frac{\\text{d}g}{\\text{d}s}=\\operatorname{cosh}⁡s,\\,\\frac{\\text{d}s}{\\text{d}x}=3{x}^{2}.\\end{aligned}\n$$\n\nFinally, multiplying the three results together and substituting for $g$ and $s$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{1}{{g}^{2}}\\cdot \\operatorname{cosh}⁡s\\cdot 3{x}^{2} \\\\  & =-\\frac{1}{{sinh}^{2}⁡{x}^{3}}\\cdot \\operatorname{cosh}⁡{x}^{3}\\cdot 3{x}^{2} \\\\  & =-\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{{sinh}^{2}⁡{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "089b12fd-140f-59f5-a8a5-715dca5123f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1}⁡0=3" :db/id #edb/ref 17592186513554} {:answer/id #uuid "23f4ce3d-4f01-5698-89bb-bac48ce52ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡1=0" :db/id #edb/ref 17592186513631} {:answer/id #uuid "45bd9db6-bed5-53fb-adb8-ecddcd12ada4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1}⁡3=0" :db/id #edb/ref 17592186513720} {:answer/id #uuid "a8423aab-ff25-5db5-954b-ceedb3aa5c61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡0=1" :db/id #edb/ref 17592186513969} {:answer/id #uuid "d7b6d170-fc89-5ebb-ae6a-d4dd7cbc31d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡1=3" :db/id #edb/ref 17592186514094}] :answer-field/correct {:db/id #edb/ref 17592186513631} :answer-field/id #uuid "1f10cdcc-3eda-57e1-a376-3057e449f3c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514232}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8064db11-eab8-5f4f-8e90-6d9982417bde" :question/math-academy-id "q-66556" :question/problem "${3}^{0}=1$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${3}^{0}=1$ with $a={b}^{x},$ we get $a=1,b=3$ and $x=0.$\n\nTherefore, the equation ${3}^{0}=1$ is equivalent to ${log}_{3}⁡1=0.$\n\nNote that ${log}_{n}⁡1=0$ for any $n>0,n\\ne 1.$"} {:db/id #edb/ref 17592186514436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5576b01a-9d1c-5313-b50a-e30808c3d5e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{tanh}⁡x" :db/id #edb/ref 17592186513764} {:answer/id #uuid "7e2af0f0-a818-54d9-b56d-5228585449fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186513860} {:answer/id #uuid "80281663-e94f-539d-9b79-950c750311f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}\\operatorname{sech}⁡x" :db/id #edb/ref 17592186513866} {:answer/id #uuid "e6717f7c-2154-5695-905e-b3451522c467" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}\\operatorname{cosh}⁡x" :db/id #edb/ref 17592186514138} {:answer/id #uuid "fe09c074-c5d7-5c62-88d6-9836961da553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{sech}⁡x" :db/id #edb/ref 17592186514202}] :answer-field/correct {:db/id #edb/ref 17592186513860} :answer-field/id #uuid "14d5db5c-02d3-5b2c-b27c-ac3d6f3cb6ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514222}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "925db400-88a9-5795-a4b0-aad7734a8104" :question/math-academy-id "q-95674" :question/problem "Find the derivative of $y=\\frac{1}{4}\\operatorname{sinh}⁡x.$" :question/worked-solution "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}\\operatorname{sinh}⁡x) \\\\  & =\\frac{1}{4}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) \\\\  & =\\frac{1}{4}\\operatorname{cosh}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c27e08e-7979-5085-966a-00121afa4123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡\\left(\\frac{1}{27}\\right)=-3" :db/id #edb/ref 17592186513779} {:answer/id #uuid "5f7bb6ce-8cc7-571e-bcdb-5f8b2f8aa903" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/27}⁡(3)=-3" :db/id #edb/ref 17592186513789} {:answer/id #uuid "af149b16-2612-571f-b52c-5eeaf58f7db5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/3}⁡\\left(\\frac{1}{27}\\right)=-3" :db/id #edb/ref 17592186513991} {:answer/id #uuid "e8435ee1-2262-52ef-a9f1-8810afdf0d86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/27}⁡(3)=-\\frac{1}{3}" :db/id #edb/ref 17592186514139} {:answer/id #uuid "eb25b335-5a1c-5de6-9dd1-8cde3debcc45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(3)=-\\frac{1}{27}" :db/id #edb/ref 17592186514146}] :answer-field/correct {:db/id #edb/ref 17592186513779} :answer-field/id #uuid "fe35be8a-6cae-54e8-bb3f-35ee3a0741c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514354}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb68a7c2-cb48-5196-952e-fea6e54d1914" :question/math-academy-id "q-66572" :question/problem "${3}^{-3}=\\frac{1}{27}$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${3}^{-3}=\\frac{1}{27}$ with $a={b}^{x},$ we get $a=\\frac{1}{27},b=3$ and $x=-3.$\n\nTherefore, the given equation can be expressed as ${log}_{3}⁡\\left(\\frac{1}{27}\\right)=-3.$"} {:db/id #edb/ref 17592186514459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1271b9bb-4fdb-5546-ba5d-c1a6d89b1fad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1.414}⁡(2)≈\\frac{1}{2}" :db/id #edb/ref 17592186513580} {:answer/id #uuid "333d8f38-b484-5b5c-869f-463a6bcb7de1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(1.414)≈\\frac{1}{2}" :db/id #edb/ref 17592186513670} {:answer/id #uuid "49d0c7ae-e60f-5aab-ae75-f8fed70ad7c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/2}⁡(2)≈1.414" :db/id #edb/ref 17592186513732} {:answer/id #uuid "4d05961b-3847-5b4d-a042-e9b4bdb8e4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/2}⁡(1.414)≈2" :db/id #edb/ref 17592186513741} {:answer/id #uuid "8582ee23-38f4-5200-ad88-a59804769f78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡\\left(\\frac{1}{2}\\right)≈1.414" :db/id #edb/ref 17592186513880}] :answer-field/correct {:db/id #edb/ref 17592186513670} :answer-field/id #uuid "c725419d-ab8e-5561-9557-352ac0cb53cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514320}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be53ea1d-fce1-50b2-b27f-f485b9e423e6" :question/math-academy-id "q-66504" :question/problem "$\\sqrt{2}≈1.414$ can be expressed as" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{2}^{1/2}≈1.412\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{1/2}≈1.412$ with $a={b}^{x},$ we get $a=1.412,b=2$ and $x=\\frac{1}{2}.$\n\nTherefore, the approximation $\\sqrt{2}≈1.414$ can be expressed as ${log}_{2}⁡(1.414)≈\\frac{1}{2}.$"} {:db/id #edb/ref 17592186514468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c8e0eb-b4ed-5750-97d5-7df316c93a28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{22}" :db/id #edb/ref 17592186513595} {:answer/id #uuid "5109da14-c4b1-5d66-8b72-c7c4fe59acde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186513753} {:answer/id #uuid "8e41c8c1-320c-5148-80c5-566550b07342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186513899} {:answer/id #uuid "bb8b9732-250a-5c1f-8b41-8e1659261954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{11}" :db/id #edb/ref 17592186514030} {:answer/id #uuid "ccf68bac-d6a7-5572-952f-aca8d66f7daf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186514062}] :answer-field/correct {:db/id #edb/ref 17592186513595} :answer-field/id #uuid "e2f9929b-cbb7-535e-88cc-fde1a1ddedec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514329}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e03bdc50-8826-55ed-961a-7b04fba13b73" :question/math-academy-id "q-43064" :question/problem "Find $det({A}^{-1}),$ if $$\n\\displaystyle A=\\begin{bmatrix}5 & 1 \\\\ -2 & 4\\end{bmatrix}.\n$$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}5 & 1 \\\\ -2 & 4\\end{bmatrix} \\\\  & =20+2 \\\\  & =22\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=\\frac{1}{22}.\n$$"} {:db/id #edb/ref 17592186514476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3f0de-10ab-59f8-9482-ea6432ae1a1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/16}⁡16=0" :db/id #edb/ref 17592186513574} {:answer/id #uuid "130dd748-2866-5a43-a676-5219cb240dfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/16}⁡\\left(\\frac{1}{16}\\right)=0" :db/id #edb/ref 17592186513582} {:answer/id #uuid "45709d79-2399-5b8b-aae1-30eedf29c6f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{16}⁡\\left(\\frac{1}{16}\\right)=1" :db/id #edb/ref 17592186513717} {:answer/id #uuid "4eaaec78-93a2-5429-be99-8a6af0db45f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{16}⁡\\left(\\frac{1}{16}\\right)=0" :db/id #edb/ref 17592186513745} {:answer/id #uuid "b60d526a-7477-5f97-a248-b96dfdb5a1a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{1/16}⁡\\left(\\frac{1}{16}\\right)=1" :db/id #edb/ref 17592186514008}] :answer-field/correct {:db/id #edb/ref 17592186514008} :answer-field/id #uuid "226d2ad1-67a7-50c4-9d80-2df4abf628bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514234}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f3941239-6e19-5b0b-909a-0a8f6dea7adb" :question/math-academy-id "q-108048" :question/problem "$$\n\\displaystyle {\\left(\\frac{1}{16}\\right)}^{1}=\\frac{1}{16}\n$$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare $$\n\\displaystyle {\\left(\\frac{1}{16}\\right)}^{1}=\\frac{1}{16}\n$$ with $a={b}^{x},$ we get $a=\\frac{1}{16},b=\\frac{1}{16}$ and $x=1.$\n\nTherefore, the equation $$\n\\displaystyle {\\left(\\frac{1}{16}\\right)}^{1}=\\frac{1}{16}\n$$ is equivalent to ${log}_{1/16}⁡\\left(\\frac{1}{16}\\right)=1.$\n\nNote that ${log}_{n}⁡n=1$ for any $n>0,n\\ne 1.$"} {:db/id #edb/ref 17592186514477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191cd351-d4ff-5f52-907b-a2c3f524d64f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{tanh}⁡x" :db/id #edb/ref 17592186513598} {:answer/id #uuid "1b20229e-fd53-5bb6-967d-eaca865549dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\operatorname{cosh}⁡x\\operatorname{sinh}⁡x}" :db/id #edb/ref 17592186513603} {:answer/id #uuid "485634ed-c1d2-554e-96aa-54fcfd862af2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2\\operatorname{sinh}⁡x}{{cosh}^{2}⁡x}" :db/id #edb/ref 17592186513727} {:answer/id #uuid "cd92acaa-1c83-560e-a425-aed5df0e16b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x}" :db/id #edb/ref 17592186514064} {:answer/id #uuid "d22f6724-03d0-588c-afd0-a8fb517b5b3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{{cosh}^{2}⁡x}" :db/id #edb/ref 17592186514081}] :answer-field/correct {:db/id #edb/ref 17592186513727} :answer-field/id #uuid "591aed53-5fc1-5718-aec4-5541a100c653" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514268}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4f3ca36-fa30-5fa4-b1a8-a0cc296aaddc" :question/math-academy-id "q-95683" :question/problem "Find the derivative of $f(x)=\\frac{2}{\\operatorname{cosh}⁡x}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=\\frac{2}{g},\\,g=\\operatorname{cosh}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=-\\frac{2}{{g}^{2}},\n$$\n\nand \n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=\\operatorname{sinh}⁡x,\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{2}{{g}^{2}}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{2}{{cosh}^{2}⁡x}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{2\\operatorname{sinh}⁡x}{{cosh}^{2}⁡x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3a7fdb-eefe-51a3-9ec9-f7c801ef2416" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186513564} {:answer/id #uuid "7200c83a-2142-5d00-85db-a56671970e08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186513836} {:answer/id #uuid "7223184f-b1ee-5d86-a4ef-23d7fc3ee742" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186513837} {:answer/id #uuid "924f6560-699b-5491-8855-7e4d83c4748a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186513912} {:answer/id #uuid "ab6ff50e-3a08-5efc-b570-80d38bf9dae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186513979}] :answer-field/correct {:db/id #edb/ref 17592186513837} :answer-field/id #uuid "fd3f9993-5662-5d10-ad04-17586e5bdd3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fd31a01e-94fe-56c0-b345-2a845f22f0d5" :question/math-academy-id "q-138131" :question/problem "The maximum  value of the quadratic form $Q(x)={x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}-6{x}_{1}{x}_{2},$ when $‖x‖=1,$ is equal to $4.$ Which of the following is a vector $x$ at which the maximum  is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & -3 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=4:$ \n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}1 & -3 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}-4\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-3 & -3 & 0 \\\\ -3 & -3 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives the eigenvector $$\n\\displaystyle v=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$"} {:answer/id #uuid "0c174169-aa47-5034-8eb6-f7f3f6a67204" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{csch}⁡x\\operatorname{coth}⁡x+3{csch}^{2}⁡x" :db/id #edb/ref 17592186514898} {:answer/id #uuid "14996826-58fd-5f33-872c-ee218d66b803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{csch}^{2}⁡x(2x{coth}^{2}⁡x+1)" :db/id #edb/ref 17592186514916} {:answer/id #uuid "18df1be8-527c-5a6e-9f98-b10d18413d0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(\\operatorname{coth}⁡{x}^{2}-2{x}^{2}{csch}^{2}⁡{x}^{2})" :db/id #edb/ref 17592186514927} {:answer/id #uuid "1a0450e8-6fb9-5c06-a492-b2d7b234798f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2{csch}^{2}⁡x\\operatorname{coth}⁡x" :db/id #edb/ref 17592186514929} {:answer/id #uuid "2079f812-1687-58bc-84c8-a6540751137c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{csch}^{2}⁡x(2x\\operatorname{coth}⁡x+1)" :db/id #edb/ref 17592186514946} {:answer/id #uuid "22fc55f5-eece-5862-9495-0d348b157ed8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{csch}^{2}⁡x+\\operatorname{coth}⁡x" :db/id #edb/ref 17592186514954} {:answer/id #uuid "27eb7323-cc8e-5eb9-884b-240fb1bdb83f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6{sech}^{2}⁡x" :db/id #edb/ref 17592186514964} {:answer/id #uuid "28420209-4741-5df8-9bcf-b3d002b845fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6{csch}^{2}⁡x" :db/id #edb/ref 17592186514967} {:answer/id #uuid "291fa27b-e8d1-5ed7-8fbf-082f5be7a7e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{csch}^{2}⁡x" :db/id #edb/ref 17592186514968} {:an