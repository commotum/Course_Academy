}⁡({x}^{3})" :db/id #edb/ref 17592186539848} {:answer/id #uuid "d91f4297-0733-5082-b97e-b9972dff4d1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{log}_{3}⁡20" :db/id #edb/ref 17592186539853} {:answer/id #uuid "e3d4e277-0fc4-529c-ada0-4c7bf18a7cf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{216}⁡48" :db/id #edb/ref 17592186539868} {:answer/id #uuid "f213b84e-618e-5486-8267-09711b7b7a84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539886} {:answer/id #uuid "f33b67b7-0bd9-5cf2-97c4-bb4c7e0b9a78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{18}⁡48" :db/id #edb/ref 17592186539888} {:answer/id #uuid "f9945c07-0881-5176-8dd2-9c1ee7fffd20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539901} {:db/id #edb/ref 17592186540023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03195d80-906e-5fc4-b665-ca11a907a266" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{log}_{2}⁡({x}^{2})+{log}_{2}⁡y" :db/id #edb/ref 17592186539482} {:answer/id #uuid "2beb1263-7f89-51b2-8426-5dc78802710c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(6{x}^{2})+{log}_{2}⁡y" :db/id #edb/ref 17592186539559} {:answer/id #uuid "610f83c3-839e-5fac-8926-025ab2318eb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(6{x}^{2})\\cdot {log}_{2}⁡y" :db/id #edb/ref 17592186539641} {:answer/id #uuid "8b306202-b82d-5f8f-bbfd-0f93aaf85d33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{log}_{2}⁡({x}^{2})\\cdot {log}_{2}⁡y" :db/id #edb/ref 17592186539713} {:answer/id #uuid "92ce0afc-f028-593a-8a4e-cacddfdbecd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{log}_{2}⁡({x}^{2})+6{log}_{2}⁡y" :db/id #edb/ref 17592186539724}] :answer-field/correct {:db/id #edb/ref 17592186539724} :answer-field/id #uuid "5c12e007-157e-5741-a3fe-0c93e6f16113" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539958}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0be7ea7e-f479-5c43-ae90-b193d0f73efd" :question/math-academy-id "q-47211" :question/problem "$6{log}_{2}⁡({x}^{2}y)=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule for logarithms and the distributive law, we obtain\n\n$$\n\\begin{aligned}6{log}_{2}⁡({x}^{2}y) & =6({log}_{2}⁡({x}^{2})+{log}_{2}⁡y) \\\\  & =6{log}_{2}⁡({x}^{2})+6{log}_{2}⁡y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abb28333-7302-5a02-a869-b9a7b366e5a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186539769}] :answer-field/correct {:db/id #edb/ref 17592186539769} :answer-field/id #uuid "d81436c8-b74d-57b3-bd49-9a96197736a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540001}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35a5df48-5462-5c58-bbc0-60fbb99c3f4a" :question/math-academy-id "q-250785" :question/problem "If ${log}_{5}⁡s=4$ and ${log}_{5}⁡t=5,$ then ${log}_{5}⁡(st)=${{field-1}}." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, we have\n\n$$\n\\begin{aligned}{log}_{5}⁡(st) & ={log}_{5}⁡s+{log}_{5}⁡t \\\\  & =4+5 \\\\  & =9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69b0c92e-95e1-5661-aec1-9ae9caa97009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡80" :db/id #edb/ref 17592186539654} {:answer/id #uuid "7e0ce3ee-44e4-5ad3-91f7-655a17df7801" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539687} {:answer/id #uuid "b34ee540-b11b-5b08-b555-ddd08ccb0109" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{ln}⁡21" :db/id #edb/ref 17592186539786} {:answer/id #uuid "d00287f7-a13f-59bf-82e2-68e3c87d856d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{ln}⁡21" :db/id #edb/ref 17592186539836} {:answer/id #uuid "dbb62eb4-23f2-5362-a28e-1ee272dfc1dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡32" :db/id #edb/ref 17592186539855}] :answer-field/correct {:db/id #edb/ref 17592186539786} :answer-field/id #uuid "ca912710-1e96-5c92-97a7-f13c2675599d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539998}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "36bfe507-bf36-5e20-b82e-5099f50d12ef" :question/math-academy-id "q-99909" :question/problem "Express $8\\operatorname{ln}⁡7+8\\operatorname{ln}⁡3$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}8\\operatorname{ln}⁡7+8\\operatorname{ln}⁡3 & =8(\\operatorname{ln}⁡7+\\operatorname{ln}⁡3) \\\\  & =8\\operatorname{ln}⁡(7\\cdot 3) \\\\  & =8\\operatorname{ln}⁡21.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n8\\operatorname{ln}⁡7+8\\operatorname{ln}⁡3=8\\operatorname{ln}⁡21.\n$$"} {:db/id #edb/ref 17592186540045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6563490e-1ac0-53ef-ab99-05500d25141e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{18}⁡13" :db/id #edb/ref 17592186539646} {:answer/id #uuid "7e056c0f-0002-5d5b-bf81-a67b2f76e5c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{6}⁡13" :db/id #edb/ref 17592186539686} {:answer/id #uuid "a3635b55-e19b-56d9-8c0a-0e8f74d3c21f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{6}⁡48" :db/id #edb/ref 17592186539754} {:answer/id #uuid "e3d4e277-0fc4-529c-ada0-4c7bf18a7cf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{216}⁡48" :db/id #edb/ref 17592186539868} {:answer/id #uuid "f33b67b7-0bd9-5cf2-97c4-bb4c7e0b9a78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{18}⁡48" :db/id #edb/ref 17592186539888}] :answer-field/correct {:db/id #edb/ref 17592186539754} :answer-field/id #uuid "bffb35e1-1e25-5cd4-871a-eb15db9f4c0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539991}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3a84d4a4-1873-5e3e-810d-d5ca7ce87d53" :question/math-academy-id "q-66743" :question/problem "Express ${log}_{6}⁡8+{log}_{6}⁡3+{log}_{6}⁡2$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule for logarithms, we can combine the first two terms as follows:\n\n$$\n\\begin{aligned}{log}_{6}⁡8+{log}_{6}⁡3+{log}_{6}⁡2 & ={log}_{6}⁡(8\\cdot 3)+{log}_{6}⁡2 \\\\  & ={log}_{6}⁡24+{log}_{6}⁡2\\end{aligned}\n$$\n\nUsing the product rule for logarithms once more, we obtain\n\n$$\n\\begin{aligned}{log}_{6}⁡24+{log}_{6}⁡2 & ={log}_{6}⁡(24\\cdot 2) \\\\  & ={log}_{6}⁡48.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cc6b6a6-43be-5279-9c28-d4a15b97a7cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186539635} {:answer/id #uuid "87cbfab1-bb2d-5b42-b1df-3089693d6029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10x+2y" :db/id #edb/ref 17592186539705} {:answer/id #uuid "8c5e26d6-7fb1-52eb-bd97-ef78fa48ede9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186539716} {:answer/id #uuid "9840868f-b940-5ed2-9e5b-49430536cb5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{10}{y}^{2}" :db/id #edb/ref 17592186539731} {:answer/id #uuid "b1e3d3db-20d4-51c4-9b30-1d9e01636929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20xy" :db/id #edb/ref 17592186539783}] :answer-field/correct {:db/id #edb/ref 17592186539635} :answer-field/id #uuid "36b051f5-bf1c-54e5-8a93-26e5b24b1e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539940}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4ea44857-e35f-51f3-a0fe-716b02fb3232" :question/math-academy-id "q-108103" :question/problem "If $\\operatorname{ln}⁡x=10$ and $\\operatorname{ln}⁡y=2$, then $\\operatorname{ln}⁡(xy)=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(xy) & =\\operatorname{ln}⁡x+\\operatorname{ln}⁡y \\\\  & =10+2 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db5a639-f3fe-598f-ab82-81a7029de9bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{log}_{6}⁡20" :db/id #edb/ref 17592186539507} {:answer/id #uuid "445c01e6-52e6-54d8-8abe-4213152f1a48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10{log}_{3}⁡20" :db/id #edb/ref 17592186539606} {:answer/id #uuid "82fdc84f-7132-5172-8c03-9226be816ca4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{log}_{6}⁡9" :db/id #edb/ref 17592186539696} {:answer/id #uuid "9457237b-99a1-52c8-b7cd-c0936c7acc0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10{log}_{3}⁡9" :db/id #edb/ref 17592186539725} {:answer/id #uuid "d91f4297-0733-5082-b97e-b9972dff4d1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{log}_{3}⁡20" :db/id #edb/ref 17592186539853}] :answer-field/correct {:db/id #edb/ref 17592186539853} :answer-field/id #uuid "03f6e7c1-29f6-526a-acd6-fbd0f2dceb15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539919}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56e99923-e71e-5783-b293-6f220455cbaa" :question/math-academy-id "q-66752" :question/problem "Express $5{log}_{3}⁡4+5{log}_{3}⁡5$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}5{log}_{3}⁡4+5{log}_{3}⁡5 & =5({log}_{3}⁡4+{log}_{3}⁡5) \\\\  & =5{log}_{3}⁡(4\\cdot 5) \\\\  & =5{log}_{3}⁡20.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n5{log}_{3}⁡4+5{log}_{3}⁡5=5{log}_{3}⁡20.\n$$"} {:db/id #edb/ref 17592186540054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "472859b6-378d-5a85-9402-f77209b6b266" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+{log}_{2}⁡(2{x}^{2})" :db/id #edb/ref 17592186539609} {:answer/id #uuid "6c751c3d-6306-5ba4-b5d9-890c50db6015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(5{x}^{2})" :db/id #edb/ref 17592186539662} {:answer/id #uuid "cc9395b5-2ba1-5433-9ecd-e4f246ee484e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5+{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539829} {:answer/id #uuid "f213b84e-618e-5486-8267-09711b7b7a84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539886} {:answer/id #uuid "f9945c07-0881-5176-8dd2-9c1ee7fffd20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539901}] :answer-field/correct {:db/id #edb/ref 17592186539829} :answer-field/id #uuid "28066d7c-a21f-504a-9a50-84587dda6f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539934}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "64aa673c-cb55-5490-a5e1-8f5f8d78ed0e" :question/math-academy-id "q-66760" :question/problem "${log}_{2}⁡(32{x}^{2})=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n{log}_{2}⁡(32{x}^{2})={log}_{2}⁡32+{log}_{2}⁡({x}^{2}).\n$$\n\nSince $32={2}^{5},$ we have\n\n$$\n{log}_{2}⁡32={log}_{2}⁡({2}^{5})=5.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{log}_{2}⁡(32{x}^{2}) & ={log}_{2}⁡32+{log}_{2}⁡({x}^{2}) \\\\  & =5+{log}_{2}⁡({x}^{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58e41124-d27e-5bf8-a849-55991f19b628" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186539631} {:answer/id #uuid "b1098335-0f3d-532a-9ba1-59d86a55f4e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186539778} {:answer/id #uuid "bd65e325-f1b8-5c87-9662-6c18254e66f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186539807} {:answer/id #uuid "f74d244e-220f-5aa8-ba66-446e22db924d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186539897} {:answer/id #uuid "fadee215-c360-5052-9061-2ac46dc7f6ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186539902}] :answer-field/correct {:db/id #edb/ref 17592186539631} :answer-field/id #uuid "db152ebb-c302-5112-8c45-9948cd14ca8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540002}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "789a361b-1deb-51ca-88a0-26707116d922" :question/math-academy-id "q-65381" :question/problem "![](images/e9/e980e9415d52338c90eb5c167a32b02815237b1554f9aea06f831e88db6f3777.png)\n\n$\\operatorname{cot}⁡\\theta =$" :question/worked-solution "Remember that $cot$ is the reciprocal of $tan.$ So first we need to compute tangent:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite}}{\\text{adjacent}}=\\frac{PR}{QR}=\\frac{3}{QR}\\end{aligned}\n$$\n\nTo find the length $QR,$ we can use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}QR & =\\sqrt{P{Q}^{2}-P{R}^{2}} \\\\  & =\\sqrt{(3\\sqrt{5})^{2}-{3}^{2}} \\\\  & =\\sqrt{45-9} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta =\\frac{3}{6}=\\frac{1}{2},\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\operatorname{cot}⁡\\theta ={\\left(\\frac{1}{2}\\right)}^{-1}=2.\n$$"} {:db/id #edb/ref 17592186540074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f66b5f8-e76f-5f77-8f96-098a448df87a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186539542} {:answer/id #uuid "22e0ee74-658c-52fe-a2b1-2df54d380881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186539547} {:answer/id #uuid "38ae8a7e-8879-58a2-b77d-2f1efa7ea909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{7}" :db/id #edb/ref 17592186539585} {:answer/id #uuid "9579f35d-0a62-56c0-87be-1dce6c45f688" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186539727} {:answer/id #uuid "fdf065d6-21d7-507f-b607-cc7b49b70a85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186539911}] :answer-field/correct {:db/id #edb/ref 17592186539727} :answer-field/id #uuid "42169019-4c90-5f92-9ed4-0e9272ff36d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539949}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9728a2a0-30c7-53d5-836b-39033ca5b896" :question/math-academy-id "q-122902" :question/problem "![](images/a9/a9003434f721485b5ee3eb2ed417d0c4c68514b98060f6149bc974270e55411a.png)\n\n$\\operatorname{csc}⁡P=$" :question/worked-solution "Remember that $csc$ is the reciprocal of $sin.$ So first we need to compute sine:\n\n$$\n\\operatorname{sin}⁡P=\\frac{\\text{opposite}}{\\text{hypotenuse}}=\\frac{QR}{PR}=\\frac{QR}{15}\n$$\n\nTo find the length $QR,$ we can use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}QR & =\\sqrt{P{R}^{2}-P{Q}^{2}} \\\\  & =\\sqrt{{15}^{2}-{9}^{2}} \\\\  & =\\sqrt{225-81} \\\\  & =\\sqrt{144} \\\\  & =12\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\operatorname{sin}⁡P=\\frac{QR}{15}=\\frac{12}{15}=\\frac{4}{5},\n$$\n\nand therefore\n\n$$\n\\operatorname{csc}⁡P={\\left(\\frac{4}{5}\\right)}^{-1}=\\frac{5}{4}.\n$$"} {:db/id #edb/ref 17592186540076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7cf433-98e4-521c-8756-1aaa0de20101" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64\\operatorname{log}⁡64" :db/id #edb/ref 17592186539505} {:answer/id #uuid "32ec0506-3bbd-5450-aec5-45053e66e796" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\operatorname{log}⁡14" :db/id #edb/ref 17592186539574} {:answer/id #uuid "3703a9c5-f286-515d-ba66-fc309d04cfa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡64" :db/id #edb/ref 17592186539581} {:answer/id #uuid "3ffc69cd-1816-56af-b4a4-2f614d0c6c05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{log}⁡14" :db/id #edb/ref 17592186539594} {:answer/id #uuid "d52273df-2cdc-5121-ae5a-a9b18d565cb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{log}⁡64" :db/id #edb/ref 17592186539841}] :answer-field/correct {:db/id #edb/ref 17592186539841} :answer-field/id #uuid "c885df1b-32ff-5811-ba54-2d8aa2af7d3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539996}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ea8b2b1-a8ee-55af-9a04-8ea83c2d0aaa" :question/math-academy-id "q-108100" :question/problem "Express $4\\operatorname{log}⁡2+4\\operatorname{log}⁡4+4\\operatorname{log}⁡8$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}4\\operatorname{log}⁡2+4\\operatorname{log}⁡4+4\\operatorname{log}⁡8 & =4(\\operatorname{log}⁡2+4\\operatorname{log}⁡4+\\operatorname{log}⁡8) \\\\  & =4\\operatorname{log}⁡(2\\cdot 4\\cdot 8) \\\\  & =4\\operatorname{log}⁡64.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n4\\operatorname{log}⁡2+4\\operatorname{log}⁡4+4\\operatorname{log}⁡8=4\\operatorname{log}⁡64.\n$$"} {:db/id #edb/ref 17592186540078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "415f038f-67ba-5731-a5d9-4c493aae49d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\theta +3\\operatorname{tanh}⁡\\theta +C" :db/id #edb/ref 17592186539597} {:answer/id #uuid "611583f3-73a3-5910-9337-e629d7e0cca7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\theta -3\\operatorname{coth}⁡\\theta +C" :db/id #edb/ref 17592186539642} {:answer/id #uuid "cd3bf55a-7e91-578c-ac7e-93c48a3a031c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+3\\operatorname{coth}⁡\\theta +C" :db/id #edb/ref 17592186539832} {:answer/id #uuid "de1f39e7-a858-5e32-867a-fa83afb3cc0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\theta -3\\operatorname{tanh}⁡\\theta +C" :db/id #edb/ref 17592186539860} {:answer/id #uuid "f7abe1a8-28a1-5586-879d-579b4850ac51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-3\\operatorname{tanh}⁡\\theta +C" :db/id #edb/ref 17592186539898}] :answer-field/correct {:db/id #edb/ref 17592186539860} :answer-field/id #uuid "4e18955b-050b-5a8f-9af9-f9eafd8a4e09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539955}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a2700145-f14c-508c-9486-f4eea106d539" :question/math-academy-id "q-96016" :question/problem "$$\n\\displaystyle \\int (4-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta =\n$$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{tanh}⁡\\theta )={sech}^{2}⁡\\theta \\,⇒\\,\\int {sech}^{2}⁡\\theta \\,\\text{d}\\theta =\\operatorname{tanh}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (4-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta  & =\\int 4\\,\\text{d}\\theta +\\int (-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4\\int \\,\\text{d}\\theta -3\\int {sech}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4\\theta -3\\operatorname{tanh}⁡\\theta +C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020e75fa-c086-57b4-9ebf-21542d8c63cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539480} {:answer/id #uuid "19adf85a-9390-59b5-8ea9-1d27f9b2fd10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+{log}_{4}⁡(2{x}^{3})" :db/id #edb/ref 17592186539534} {:answer/id #uuid "4cdce3f1-a378-50c2-a9e9-17d33b0d500b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{log}_{4}⁡(2{x}^{3})" :db/id #edb/ref 17592186539617} {:answer/id #uuid "8ccf5773-895e-5f5b-9ed9-deca69d9a7d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539717} {:answer/id #uuid "d73b0aa8-1e69-5772-8f5d-4f93250e4de6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539848}] :answer-field/correct {:db/id #edb/ref 17592186539480} :answer-field/id #uuid "089e5ce6-a93c-5b0c-b28e-ebc7a141b727" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539922}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c529b9a8-1cea-5cb5-8b9e-8f76c8202de5" :question/math-academy-id "q-66758" :question/problem "${log}_{4}⁡(16{x}^{3})=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n\\begin{aligned}{log}_{4}⁡(16{x}^{3})={log}_{4}⁡16+{log}_{4}⁡({x}^{3}).\\end{aligned}\n$$\n\nSince $16={4}^{2},$ we have\n\n$$\n{log}_{4}⁡16={log}_{4}⁡({4}^{2})=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{log}_{4}⁡(16{x}^{3}) & ={log}_{4}⁡16+{log}_{4}⁡({x}^{3}) \\\\  & =2+{log}_{4}⁡({x}^{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d762dc30-ad94-5117-9809-03ee4cc6d7fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p^2q^2" :db/id #edb/ref 17592186539849}] :answer-field/correct {:db/id #edb/ref 17592186539849} :answer-field/id #uuid "f88f9804-ffdf-554f-8671-c239c2d469a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540019}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7c12aa8-de03-59c9-ab5d-5e64e226cea3" :question/math-academy-id "q-250764" :question/problem "Write the following expression as a single logarithm.\n\n$5\\operatorname{ln}⁡p+5\\operatorname{ln}⁡q+5\\operatorname{ln}⁡(pq)=5\\operatorname{ln}⁡(${{field-1}}$)$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}5\\operatorname{ln}⁡p+5\\operatorname{ln}⁡q+5\\operatorname{ln}⁡(pq) & =5(\\operatorname{ln}⁡p+\\operatorname{ln}⁡q+\\operatorname{ln}⁡(pq)) \\\\  & =5\\operatorname{ln}⁡(p\\cdot q\\cdot pq) \\\\  & =5\\operatorname{ln}⁡({p}^{2}{q}^{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04eea80b-51f5-55aa-bacb-612eb84f806e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t^6" :db/id #edb/ref 17592186539488}] :answer-field/correct {:db/id #edb/ref 17592186539488} :answer-field/id #uuid "00dd99a1-dae8-5610-99d8-c9c6b36aae72" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539916}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f62edb2c-be7a-51bc-a4d3-e51bf196542b" :question/math-academy-id "q-250763" :question/problem "Write the following expression as a single logarithm.\n\n$4\\operatorname{log}⁡t+4\\operatorname{log}⁡({t}^{2})+4\\operatorname{log}⁡({t}^{3})=4\\operatorname{log}⁡(${{field-1}}$)$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}4\\operatorname{log}⁡t+4\\operatorname{log}⁡({t}^{2})+4\\operatorname{log}⁡({t}^{3}) & =4(\\operatorname{log}⁡t+\\operatorname{log}⁡({t}^{2})+\\operatorname{log}⁡({t}^{3})) \\\\  & =4\\operatorname{log}⁡(t\\cdot {t}^{2}\\cdot {t}^{3}) \\\\  & =4\\operatorname{log}⁡({t}^{1+2+3}) \\\\  & =4\\operatorname{log}⁡({t}^{6}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16428388-adc9-5bc3-a420-1ca62578bc67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186539525}] :answer-field/correct {:db/id #edb/ref 17592186539525} :answer-field/id #uuid "9daa41b5-a3c9-591b-8bf6-1fa87f56a85e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9b76f6d-a314-5376-893f-3c9706a4c31e" :question/math-academy-id "q-251858" :question/problem "Consider two sets of $39$ paired observations ${x}_{1},{x}_{2},…,{x}_{39},$ and ${y}_{1},{y}_{2},…,{y}_{39}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=663,\\,{S}_{yy}=1\\,092,\\,{S}_{xy}=975.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=975.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{975}{39} \\\\  & =25.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197e74ce-32e5-5a69-87d8-f7fbe61494be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539532} {:answer/id #uuid "2f4c7963-1deb-5a29-86ed-b9412ff17c06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20+\\operatorname{log}⁡x" :db/id #edb/ref 17592186539567} {:answer/id #uuid "882199fc-d098-5e8a-ace9-084eb555a224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡2+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539706} {:answer/id #uuid "ac257b80-c474-59a8-895d-20f3d20f523e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539772} {:answer/id #uuid "c1f80b35-efbd-55e9-a59e-52dc28ea93ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+\\operatorname{log}⁡x" :db/id #edb/ref 17592186539815}] :answer-field/correct {:db/id #edb/ref 17592186539772} :answer-field/id #uuid "6cb60d82-ebf9-5dcc-8726-85d1f4e43c62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539962}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fba4c35a-120c-5bd8-b872-2cfc6815a465" :question/math-academy-id "q-66559" :question/problem "$\\operatorname{log}⁡(100{x}^{2})=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(100{x}^{2})=\\operatorname{log}⁡100+\\operatorname{log}⁡({x}^{2}).\\end{aligned}\n$$\n\nSince $100={10}^{2},$ we have\n\n$$\n\\operatorname{log}⁡100=\\operatorname{log}⁡({10}^{2})=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(100{x}^{2}) & =\\operatorname{log}⁡100+\\operatorname{log}⁡({x}^{2}) \\\\  & =2+\\operatorname{log}⁡({x}^{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30095a16-941c-5ff3-8355-ce843412be95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\operatorname{log}⁡6+9\\operatorname{log}⁡z" :db/id #edb/ref 17592186539570} {:answer/id #uuid "4affeb3e-b42c-5d5b-8cab-c8154d657845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡54\\cdot \\operatorname{log}⁡z" :db/id #edb/ref 17592186539613} {:answer/id #uuid "7cee4f51-d29f-5795-bc14-e1d92f5c1eea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡54+9\\operatorname{log}⁡z" :db/id #edb/ref 17592186539685} {:answer/id #uuid "98634f48-1f44-519f-baf0-65a1ef368065" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\operatorname{log}⁡6\\cdot \\operatorname{log}⁡z" :db/id #edb/ref 17592186539732} {:answer/id #uuid "d6a95e06-d45a-5718-a707-1fcd0ea8d7e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\operatorname{log}⁡6+\\operatorname{log}⁡z" :db/id #edb/ref 17592186539847}] :answer-field/correct {:db/id #edb/ref 17592186539570} :answer-field/id #uuid "39b373e2-c023-56ba-ad40-38e2f5029528" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539942}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbe8f3d1-3c93-5a68-ac60-38c193b6c6b9" :question/math-academy-id "q-47212" :question/problem "$9\\operatorname{log}⁡(6z)=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule for logarithms and the distributive law, we obtain\n\n$$\n\\begin{aligned}9\\operatorname{log}⁡(6z) & =9(\\operatorname{log}⁡6+\\operatorname{log}⁡z) \\\\  & =9\\operatorname{log}⁡6+9\\operatorname{log}⁡z.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186541060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fa5b866-e128-5753-a445-f1b463ce86be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x+4)^2}{25}+\\frac{(y-2)^2}{27}" :db/id #edb/ref 17592186540742}] :answer-field/correct {:db/id #edb/ref 17592186540742} :answer-field/id #uuid "b240cd70-b283-509c-882a-a63367769e6b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186541018}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0d95a82d-3596-5013-a69c-59119b644955" :question/math-academy-id "q-327800" :question/problem "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=5\\operatorname{cos}⁡\\theta -4,\\,y=3\\sqrt{3}\\,\\operatorname{sin}⁡\\theta +2,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\operatorname{cos}⁡\\theta -4 \\\\ \\frac{x+4}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+4)^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x+4)^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =3\\sqrt{3}\\operatorname{sin}⁡\\theta +2 \\\\ \\frac{y-2}{3\\sqrt{3}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y-2)^{2}}{(3\\sqrt{3})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y-2)^{2}}{27} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{27} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{27}=1.\n$$"} {:db/id #edb/ref 17592186541076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222b62ab-1bfb-546b-aab5-03561e3c701f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186540586} {:answer/id #uuid "262dc74b-263d-5d80-9193-e12e8b9113bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186540595} {:answer/id #uuid "3fc77f0f-f146-5ca7-b666-ad8985b69724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186540635} {:answer/id #uuid "e0610972-c22b-5f94-966b-2d4ed2ec3bd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186540910} {:answer/id #uuid "e423743e-6949-5391-8f90-a809db7277ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186540914}] :answer-field/correct {:db/id #edb/ref 17592186540595} :answer-field/id #uuid "030979c4-2ad6-5121-addd-f709ea3b08d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540943}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "40216ba0-427a-539f-9353-a0236ab249d0" :question/math-academy-id "q-85235" :question/problem "![](images/fd/fd812d1d33801a3ce8368feca0e7d6b87e02bcfab5d904d9b59172d95d0204e5.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{11}}{6},$ use the Pythagorean identity to find $\\operatorname{csc}⁡\\theta .$" :question/worked-solution "![](images/e0/e087efb9eb18158005722dd6628cc8f19b22a2b33cad8f67205b8ea398e62c54.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{11}}{6}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{11}}{6}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{11}}{6}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{11}}{6}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{11}{36}} \\\\  & =\\pm \\sqrt{\\frac{25}{36}} \\\\  & =\\pm \\frac{5}{6}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{5}{6}.$\n\nFinally, knowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{\\left(\\frac{5}{6}\\right)}=\\frac{6}{5}.\n$$"} {:db/id #edb/ref 17592186541091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10217f51-caf3-5dd4-96ac-8656fdc36c51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186540556} {:answer/id #uuid "3bbc2cd9-05ee-5ab2-b7f8-ecea5083e238" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186540626} {:answer/id #uuid "4655fb84-1019-5281-8d52-c7b7aa2b05c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186540649} {:answer/id #uuid "80cb97b9-3cce-5ddf-a76a-626c77b83982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186540744} {:answer/id #uuid "bb0e0e46-2dfb-5983-8032-25be5dcb57b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4\\sqrt{5}}{5}" :db/id #edb/ref 17592186540842}] :answer-field/correct {:db/id #edb/ref 17592186540744} :answer-field/id #uuid "0b703d74-20ff-5a85-bdd0-120e273b7e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540949}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "67eb7841-2530-5536-9fe7-7fe1cd1941b8" :question/math-academy-id "q-37897" :question/problem "![](images/1b/1b084e0ad229e935d70d751f0e0ddaacf5832017951a7ef8e334f27834662d5c.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{5}}{3},$ use the Pythagorean identity to find $\\operatorname{tan}⁡\\theta .$" :question/worked-solution "![](images/57/5778175613309c2b4b8007291ad122b879de1cd409ad3513f3f786c8f4885927.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{5}}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{5}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{5}}{3}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{5}}{3}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{5}{9}} \\\\  & =\\pm \\sqrt{\\frac{4}{9}} \\\\  & =\\pm \\frac{2}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{2}{3}.$\n\nKnowing that $$\n\\displaystyle \\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },\n$$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\left(\\frac{2}{3}\\right)}{\\left(\\frac{\\sqrt{5}}{3}\\right)}=\\frac{2}{\\sqrt{5}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{2}{\\sqrt{5}} \\\\  & =\\frac{2}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} \\\\  & =\\frac{2\\sqrt{5}}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186541118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7e03f86-abab-5944-93ad-4c56076946d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^2}{50}+\\frac{y^2}{63}" :db/id #edb/ref 17592186540920}] :answer-field/correct {:db/id #edb/ref 17592186540920} :answer-field/id #uuid "0c37ef4d-2cd6-55e8-930f-488347a97b91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540950}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0a23b4a-b8a9-57f6-be01-ea66f5dec94e" :question/math-academy-id "q-327807" :question/problem "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=5\\sqrt{2}\\operatorname{cos}⁡\\theta ,\\,y=3\\sqrt{7}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\sqrt{2}\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{5\\sqrt{2}} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{(5\\sqrt{2})^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{50} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =3\\sqrt{7}\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{3\\sqrt{7}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{(3\\sqrt{7})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{63} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\frac{{x}^{2}}{50}+\\frac{{y}^{2}}{63}={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{50}+\\frac{{y}^{2}}{63}=1.\n$$"} {:db/id #edb/ref 17592186541137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4662ff5c-1779-587c-8818-862f89cec631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186540650} {:answer/id #uuid "57b912a8-d2ae-5a4c-a949-6c6b3b4e2b7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{14}}{3}" :db/id #edb/ref 17592186540676} {:answer/id #uuid "78b7c07c-ec2e-5b2b-8de0-b1f928e490af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{14}}{2}" :db/id #edb/ref 17592186540731} {:answer/id #uuid "9d3c24fb-cfb1-5483-9975-5fe28ec66e17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186540791} {:answer/id #uuid "c78c0d6a-5d3e-5010-92bc-68ad33e022bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186540862}] :answer-field/correct {:db/id #edb/ref 17592186540731} :answer-field/id #uuid "e825c5c1-d92a-52fc-8cd7-189d7de3d71e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541042}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d952daa8-27a5-56d3-8d17-8e3ce2fc3807" :question/math-academy-id "q-124785" :question/problem "![](images/ca/ca003331d04113119019996f15296ec2ab16fa0c14227a12f5f421c4c4103746.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{2}}{3},$ use the Pythagorean identity to find $\\operatorname{cot}⁡\\theta .$" :question/worked-solution "![](images/f0/f0c1c9df42fc2ed772353baec0f81e796485d8bf3c1cd9dde234e74e39a04c56.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{2}}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{3}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{\\sqrt{2}}{3}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{2}{9}} \\\\  & =\\pm \\sqrt{\\frac{7}{9}} \\\\  & =\\pm \\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{7}}{3}$\n\nKnowing that $$\n\\displaystyle \\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },\n$$ we have\n\n$$\n\\operatorname{cot}⁡\\theta =\\frac{\\left(\\frac{\\sqrt{7}}{3}\\right)}{\\left(\\frac{\\sqrt{2}}{3}\\right)}=\\frac{\\sqrt{7}}{\\sqrt{2}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡\\theta  & =\\frac{\\sqrt{7}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{7}}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{7\\cdot 2}}{2} \\\\  & =\\frac{\\sqrt{14}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186541147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4db871-9264-5abb-8b35-f8cefa4d7edc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{49}-\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186540554} {:answer/id #uuid "2ca34a0e-8d0c-5de6-a6da-86fe375f2f1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1" :db/id #edb/ref 17592186540603} {:answer/id #uuid "383804ba-6e24-59d1-8b86-33a991e9821e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186540617} {:answer/id #uuid "389fd57e-2d25-5ed5-a585-2bc467281b50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186540619} {:answer/id #uuid "5dd2ee4e-8bd6-545a-9a0a-ae52bffe93ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{49}=1" :db/id #edb/ref 17592186540686}] :answer-field/correct {:db/id #edb/ref 17592186540603} :answer-field/id #uuid "4318b039-4a2e-5f72-894b-9e7f5517fbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540973}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7435811-f6b1-5cc6-8105-467790c4f32b" :question/math-academy-id "q-15801" :question/problem "Determine the Cartesian equation of the ellipse\n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =4\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{4} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{4}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{16} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =7\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{7} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{7}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{49} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1.\n$$"} {:db/id #edb/ref 17592186541154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e8b185-9e4d-524a-98a5-45013ad83009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186540543} {:answer/id #uuid "0a6e02d6-f190-5b77-94b7-25463dc18fdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186540544} {:answer/id #uuid "5cae022b-6032-5575-aa99-3439709b9c23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186540684} {:answer/id #uuid "624013de-ac75-5b7a-a4d8-e9822947abad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186540694} {:answer/id #uuid "6f15d79f-35df-5dfd-909e-20ba976f3a93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186540721}] :answer-field/correct {:db/id #edb/ref 17592186540544} :answer-field/id #uuid "9d7d6654-0ebf-57f1-bbf5-229f64325368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541007}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb5c025a-0d14-591c-9102-8c187483f1d5" :question/math-academy-id "q-85233" :question/problem "![](images/75/751d38a1a37afd277cbd54850abf61db898a231b49ad0d4bcaa5964bbab601e1.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{4}{5},$ use the Pythagorean identity to find $\\operatorname{csc}⁡\\theta .$" :question/worked-solution "![](images/05/0534847b2363ff75e053b9d05736ff367f2ad6da527b7100de0018d003c4c9df.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{4}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{4}{5}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{4}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{4}{5}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{16}{25}} \\\\  & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{3}{5}.$\n\nFinally, knowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{\\left(\\frac{3}{5}\\right)}=\\frac{5}{3}.\n$$"} {:db/id #edb/ref 17592186542116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41bac9b3-13f7-5b8b-a321-f1d007e4bfa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7.891" :db/id #edb/ref 17592186541561} {:answer/id #uuid "d16681c8-41f9-5f36-a7de-90f0e375ea52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10.934" :db/id #edb/ref 17592186541867} {:answer/id #uuid "dfb8c2e8-dfe1-54d9-9a97-0a6f51e8c3e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.901" :db/id #edb/ref 17592186541898} {:answer/id #uuid "e3ce0c7a-2d06-5133-af07-3fbd01d22a1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9.413" :db/id #edb/ref 17592186541905} {:answer/id #uuid "fbf377cf-e020-545e-b783-2989924ac608" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6.678" :db/id #edb/ref 17592186541950}] :answer-field/correct {:db/id #edb/ref 17592186541905} :answer-field/id #uuid "792b62eb-9bf9-54a8-88d7-aa878a9e5b83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542024}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1016352e-7a56-5245-a46f-5f32ded11ee4" :question/math-academy-id "q-26830" :question/problem "Given that $\\frac{{3}^{x}}{5}=3\\cdot {4}^{x},$ what is the value of $x?$ Round your answer to $3$ decimal places." :question/worked-solution "First, notice that, by multiplying by $5$ on both sides,  the given equation is equivalent to\n\n$$\n{3}^{x}=15\\cdot {4}^{x}\n$$\n\nNow, we take ${log}_{3}$ on both sides of the equation: \n\n$$\n{log}_{3}⁡({3}^{x})={log}_{3}⁡(15\\cdot {4}^{x})\n$$\n\nThen, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side:\n\n$$\n\\begin{aligned}x & ={log}_{3}⁡(15\\cdot {4}^{x})\\end{aligned}\n$$\n\nNext, we use  the product law and the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x & ={log}_{3}⁡(15\\cdot {4}^{x}) \\\\  & ={log}_{3}⁡(15)+{log}_{3}⁡({4}^{x}) \\\\  & ={log}_{3}⁡(15)+x{log}_{3}⁡4\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x & ={log}_{3}⁡(15)+x{log}_{3}⁡4 \\\\ x-x{log}_{3}⁡4 & ={log}_{3}⁡(15) \\\\ x(1-{log}_{3}⁡4) & ={log}_{3}⁡(15) \\\\ x & =\\frac{{log}_{3}⁡(15)}{1-{log}_{3}⁡4}\\end{aligned}\n$$\n\nUsing the change of base formula, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡(15)=\\frac{\\operatorname{ln}⁡15}{\\operatorname{ln}⁡3}≈2.464\\,974, \\\\ {log}_{3}⁡4=\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}≈1.261\\,860.\\end{aligned}\n$$\n\nFinally, we can approximate $x$ as\n\n$$\nx≈\\frac{2.464\\,974}{1-1.261\\,860}≈-9.413,\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186542131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47dfb872-e75b-5f9a-b45e-fbda4b8838ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<81" :db/id #edb/ref 17592186541572} {:answer/id #uuid "7045c8aa-5d5b-5ee3-9e2f-bf220567c38d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1<x<82" :db/id #edb/ref 17592186541649} {:answer/id #uuid "84e6302e-5afe-52b3-aec8-107a6a770214" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1<x<82" :db/id #edb/ref 17592186541692} {:answer/id #uuid "9c6b1555-ce02-5e87-a301-c4190c7b7287" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2<x<81" :db/id #edb/ref 17592186541747} {:answer/id #uuid "de6a8700-2d0e-527a-9eef-a3846087e808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>82" :db/id #edb/ref 17592186541894}] :answer-field/correct {:db/id #edb/ref 17592186541649} :answer-field/id #uuid "bf8c253d-591c-537b-af74-0a69ba582f86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542053}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "36e07a88-c6e0-5488-ba80-e3ecff483738" :question/math-academy-id "q-88012" :question/problem "Solve the inequality $3{log}_{3}⁡(x-1)-5<7.$" :question/worked-solution "First, we isolate the logarithm:\n\n$$\n\\begin{aligned}3{log}_{3}⁡(x-1)-5 & <7 \\\\ 3{log}_{3}⁡(x-1) & <12 \\\\ {log}_{3}⁡(x-1) & <4\\end{aligned}\n$$\n\nNow, we use each side of the inequality as an exponent of $3.$ We get the following:\n\n$$\n\\begin{aligned}{3}^{{log}_{3}⁡(x-1)} & <{3}^{4} \\\\ x-1 & <81 \\\\ x & <82\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithm in the original inequality. To find the domain of the logarithm, we recall that the argument of the logarithm must be positive:\n\n$$\nx-1>0\\,⇒\\,x>1\n$$\n\nOur solution is $x<82,$ which can be expressed as $(-\\infty ,82).$ Additionally, the domain of the logarithm is $x>1,$ which can be expressed as $(1,\\infty ).$ To find the solutions that are in the domain of the logarithm, we take the intersection:\n\n$$\n(-\\infty ,82)\\cap (1,\\infty )=(1,82)\n$$\n\nTherefore, the solution is $x\\in (1,82),$ which can also be written as $1<x<82.$"} {:db/id #edb/ref 17592186542149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07c51994-a16e-53c5-9f4b-087d4584a0b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{1-\\operatorname{log}⁡(3)}" :db/id #edb/ref 17592186541438} {:answer/id #uuid "193d4f96-76f2-5425-9669-b57d4ff37861" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2-\\operatorname{log}⁡(3)}" :db/id #edb/ref 17592186541472} {:answer/id #uuid "23c339b2-9834-5db4-b684-69e13092c852" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(2)+\\operatorname{log}⁡(3)" :db/id #edb/ref 17592186541497} {:answer/id #uuid "30102e12-e4ae-556a-874d-a561ad884f6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{\\operatorname{log}⁡(2)}" :db/id #edb/ref 17592186541518} {:answer/id #uuid "88716cb2-3b00-516a-bad7-a9836ec1eaee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{log}⁡(3)" :db/id #edb/ref 17592186541698}] :answer-field/correct {:db/id #edb/ref 17592186541438} :answer-field/id #uuid "dfc1aca4-c021-5871-bb55-6eb2d01facdd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542074}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c4b6334-f991-59a6-8939-03bf51753adb" :question/math-academy-id "q-66873" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x-2}={3}^{x}?$" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation: \n\n$$\n\\begin{aligned}{10}^{x-2} & ={3}^{x} \\\\ \\operatorname{log}⁡({10}^{x-2}) & =\\operatorname{log}⁡({3}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\nx-2=\\operatorname{log}⁡({3}^{x})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx-2=x\\operatorname{log}⁡(3)\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-2 & =x\\operatorname{log}⁡(3) \\\\ x-x\\operatorname{log}⁡(3) & =2 \\\\ x(1-\\operatorname{log}⁡(3)) & =2 \\\\ x & =\\frac{2}{1-\\operatorname{log}⁡(3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186542160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16446a4c-7a1c-59f3-bc40-4c1c6c59865f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.194" :db/id #edb/ref 17592186541467}] :answer-field/correct {:db/id #edb/ref 17592186541467} :answer-field/id #uuid "2690682d-4da1-5e1c-906c-371ce3d099aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186541981}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7088fa93-cf81-5263-ba93-771873a7af12" :question/math-academy-id "q-242900" :question/problem "Given that ${5}^{x+4}={2}^{2-x},$ what is the value of $x?$ Round your answer to $3$ decimal places.\n\n$x≈$\n{{field-1}}" :question/worked-solution "First, we take ${log}_{5}$ on both sides of the equation: \n\n$$\n\\begin{aligned}{5}^{x+4} & ={2}^{2-x} \\\\ {log}_{5}⁡({5}^{x+4}) & ={log}_{5}⁡({2}^{2-x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side:\n\n$$\nx+4={log}_{5}⁡({2}^{2-x})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx+4=(2-x){log}_{5}⁡(2)\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x+4 & =(2-x){log}_{5}⁡(2) \\\\ x+4 & =2{log}_{5}⁡(2)-x{log}_{5}⁡(2) \\\\ x+x{log}_{5}⁡(2) & =2{log}_{5}⁡(2)-4 \\\\ x(1+{log}_{5}⁡(2)) & =2{log}_{5}⁡(2)-4 \\\\ x & =\\frac{2{log}_{5}⁡(2)-4}{1+{log}_{5}⁡(2)}\\end{aligned}\n$$\n\nUsing the change of base formula, we have\n\n$$\n{log}_{5}⁡(2)=\\frac{\\operatorname{ln}⁡(2)}{\\operatorname{ln}⁡(5)}≈0.430\\,677.\n$$\n\nFinally, we can approximate $x$ as\n\n$$\nx≈\\frac{2\\cdot 0.430\\,677-4}{1+0.430\\,677}≈-2.194,\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186542173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1770f611-9506-5c65-badc-9ba567423390" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186541471}] :answer-field/correct {:db/id #edb/ref 17592186541471} :answer-field/id #uuid "12d10a1f-799d-5ce9-9008-249ea9bc58c1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186541974} {:answer-field/choices [{:answer/id #uuid "b3da09dd-8dd6-5605-be7f-0b87e6ec4f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2^{\\frac{2}{5}}-4" :db/id #edb/ref 17592186541791}] :answer-field/correct {:db/id #edb/ref 17592186541791} :answer-field/id #uuid "5e07d3f9-6517-533a-8691-42014e926a21" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542013}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "96832f47-df31-501c-8b04-84adf76c5b92" :question/math-academy-id "q-278513" :question/problem "Solve the inequality $5{log}_{2}⁡(x+4)-2>0.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "First, we isolate the logarithm:\n\n$$\n\\begin{aligned}5{log}_{2}⁡(x+4)-2 & >0 \\\\ 5{log}_{2}⁡(x+4) & >2 \\\\ {log}_{2}⁡(x+4) & >\\frac{2}{5}\\end{aligned}\n$$\n\nNow, we use each side of the inequality as an exponent of $2.$ We get the following:\n\n$$\n\\begin{aligned}{2}^{{log}_{2}⁡(x+4)} & >{2}^{2/5} \\\\ x+4 & >\\sqrt[5]{4} \\\\ x & >\\sqrt[5]{4}-4\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithm in the original inequality. To find the domain of the logarithm, we recall that the argument of the logarithm must be positive:\n\n$$\nx+4>0\\,⇒\\,x>-4\n$$\n\nOur solution is $x>\\sqrt[5]{4}-4,$ which can be expressed as $(\\sqrt[5]{4}-4,\\infty ).$ Additionally, the domain of the logarithm is $x>-4,$ which can be expressed as $(-4,\\infty ).$ To find the solutions that are in the domain of the logarithm, we take the intersection:\n\n$$\n(\\sqrt[5]{4}-4,\\infty )\\cap (-4,\\infty )=(\\sqrt[5]{4}-4,\\infty )\n$$\n\nTherefore, the solution is \n\n$$\nx\\in (\\sqrt[5]{4}-4,\\infty ),\\text{ which can also be written as }x>\\sqrt[5]{4}-4.\n$$"} {:db/id #edb/ref 17592186542191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63493919-14e9-5870-9f2f-d3d0b3c6ca3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186541629} {:answer/id #uuid "6b42332f-6a16-50fb-a17d-46adbcaf4ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186541638} {:answer/id #uuid "91418d79-29a9-572d-b4d7-bafef27445b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186541721} {:answer/id #uuid "932b696a-79d9-5324-a927-905a53c9a20b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186541726} {:answer/id #uuid "e8d2b48f-3075-5059-96ef-05cbd27dae7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186541918}] :answer-field/correct {:db/id #edb/ref 17592186541918} :answer-field/id #uuid "875cd90c-6d43-5b85-9fc6-7e9ce6214967" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542031}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "afcfe65d-5017-5ca6-9a0c-f6939bdd2a4f" :question/math-academy-id "q-170401" :question/problem "The maximum value of the quadratic form $Q(x)=-4{x}_{1}^{2}+6{x}_{1}{x}_{2}+4{x}_{2}^{2},$ when $‖x‖=1,$ is equal to $5.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-4 & 3 \\\\ 3 & 4\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=5:$\n\n$$\n\\begin{aligned}A-5I & =\\begin{bmatrix}-4 & 3 \\\\ 3 & 4\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-9 & 3 \\\\ 3 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.\n$$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{10},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186542197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39245218-c124-5e3b-9885-ad36c021185d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{log}⁡(3)}{1+\\operatorname{log}⁡(3)}" :db/id #edb/ref 17592186541546} {:answer/id #uuid "393def19-6af1-5280-a953-dc5078e18f2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{log}⁡(3)" :db/id #edb/ref 17592186541547} {:answer/id #uuid "90a6f8e6-6d98-51f3-9401-29c3de7e41d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{log}⁡(3)-1}{1-\\operatorname{log}⁡(3)}" :db/id #edb/ref 17592186541719} {:answer/id #uuid "d51d8d66-8e5b-5398-a14f-9cb65b564558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(2)-\\operatorname{log}⁡(3)" :db/id #edb/ref 17592186541877} {:answer/id #uuid "db1a2cbf-86a0-53b0-8ba7-b2badd721bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(3)-1" :db/id #edb/ref 17592186541890}] :answer-field/correct {:db/id #edb/ref 17592186541719} :answer-field/id #uuid "87b34590-cca4-5e71-8290-c7d0e45d01f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542032}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b722f56c-7d4f-5883-9de4-4bfad6f8a324" :question/math-academy-id "q-66883" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x+1}={3}^{x+2}?$" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation:   \n\n$$\n\\begin{aligned}{10}^{x+1} & ={3}^{x+2} \\\\ \\operatorname{log}⁡({10}^{x+1}) & =\\operatorname{log}⁡({3}^{x+2})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\nx+1=\\operatorname{log}⁡({3}^{x+2})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x+1 & =(x+2)\\operatorname{log}⁡(3) \\\\ x+1 & =x\\operatorname{log}⁡(3)+2\\operatorname{log}⁡(3)\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x+1 & =x\\operatorname{log}⁡(3)+2\\operatorname{log}⁡(3) \\\\ x-x\\operatorname{log}⁡(3) & =2\\operatorname{log}⁡(3)-1 \\\\ x(1-\\operatorname{log}⁡(3)) & =2\\operatorname{log}⁡(3)-1 \\\\ x & =\\frac{2\\operatorname{log}⁡(3)-1}{1-\\operatorname{log}⁡(3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186542206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6726d53-1c49-55d4-a9fc-abfb02d98019" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi -2}{2}" :db/id #edb/ref 17592186541766}] :answer-field/correct {:db/id #edb/ref 17592186541766} :answer-field/id #uuid "da69ddf7-0c95-5610-bb80-afdff6c65e1a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542070} {:answer-field/choices [{:answer/id #uuid "bae7493b-97fa-5e69-b993-6f9d41cd3185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi (4-\\pi )}{4}" :db/id #edb/ref 17592186541809}] :answer-field/correct {:db/id #edb/ref 17592186541809} :answer-field/id #uuid "eb8b6806-7bed-5b6d-a52c-5d124c4f7580" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542088}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c83da1a3-053f-5553-bc32-57bdb774a02e" :question/math-academy-id "q-351547" :question/problem "Find the Cartesian equation of the normal line to the polar curve $r=4\\theta \\operatorname{cos}⁡\\theta $ at $\\theta =\\frac{\\pi }{4},$ given that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta )=2\\operatorname{sin}⁡(2\\theta )+4\\theta \\operatorname{cos}⁡(2\\theta ), \\\\ {x}^{′}(\\theta )=2+2\\operatorname{cos}⁡(2\\theta )-4\\theta \\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$\n\nThe Cartesian equation of the normal line is $y=$\n{{field-1}} $x\\,+$\n{{field-2}}." :question/worked-solution "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n{y}^{′}(\\theta )=2\\operatorname{sin}⁡(2\\theta )+4\\theta \\operatorname{cos}⁡(2\\theta ),\\,{x}^{′}(\\theta )=2+2\\operatorname{cos}⁡(2\\theta )-4\\theta \\operatorname{sin}⁡(2\\theta ).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{2\\operatorname{sin}⁡(2\\theta )+4\\theta \\operatorname{cos}⁡(2\\theta )}{2+2\\operatorname{cos}⁡(2\\theta )-4\\theta \\operatorname{sin}⁡(2\\theta )}.\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /4} \\\\  & =\\frac{2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})+4\\cdot \\frac{\\pi }{4}\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4})}{2+2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4})-4\\cdot \\frac{\\pi }{4}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})} \\\\  & =\\frac{2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)+\\pi \\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)}{2+2\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\pi \\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)} \\\\  & =\\frac{2}{2-\\pi }.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\theta {cos}^{2}⁡\\theta  \\\\  & =4\\cdot \\frac{\\pi }{4}{cos}^{2}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\pi \\cdot {\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2} \\\\  & =\\frac{\\pi }{2} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\theta \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =2\\theta \\operatorname{sin}⁡(2\\theta ) \\\\  & =2\\cdot \\frac{\\pi }{4}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =\\frac{\\pi }{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =\\frac{\\pi }{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-\\frac{\\pi }{2} & =\\frac{\\pi -2}{2}(x-\\frac{\\pi }{2}) \\\\ y & =\\frac{\\pi -2}{2}\\,x+\\frac{\\pi (4-\\pi )}{4}\\end{aligned}\n$$\n\n![](images/2b/2bb2678804e79eb60cf9e1b16df60b8dad4ec4ccf8b2a9234a838c394ab9f3ac.png)"} {:db/id #edb/ref 17592186542215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a44896-e16c-55e0-b031-ed3c4525e491" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186541466}] :answer-field/correct {:db/id #edb/ref 17592186541466} :answer-field/id #uuid "2b01fc71-15e0-5989-a945-a229e3e4981a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186541983} {:answer-field/choices [{:answer/id #uuid "441f08b4-04dd-5e42-838c-9e7b01251fc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186541567}] :answer-field/correct {:db/id #edb/ref 17592186541567} :answer-field/id #uuid "ea70e8a0-cc70-507c-a9ef-fbc409c64de9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e1dd610f-bcb9-5742-82dd-3d71c2887869" :question/math-academy-id "q-362883" :question/problem "Find the Cartesian equation $y=f(x)$ of the tangent line to the polar curve $r=7\\operatorname{sin}⁡\\theta $ at $\\theta =\\frac{\\pi }{6},$ given that \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{tan}⁡2\\theta .\n$$\n\nThe Cartesian equation of the tangent line is $y=$\n{{field-1}}$x\\,-$\n{{field-2}}." :question/worked-solution "To find the equation of the tangent line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{tan}⁡2\\theta .\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /6} \\\\  & =\\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{6}) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{3}\\right) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =7\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =7\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =7\\cdot \\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{7\\sqrt{3}}{4} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =7\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =7{sin}^{2}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =7{\\left(\\frac{1}{2}\\right)}^{2} \\\\  & =\\frac{7}{4}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\frac{7\\sqrt{3}}{4},\\frac{7}{4}).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent:\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-\\frac{7}{4} & =\\sqrt{3}(x-\\frac{7\\sqrt{3}}{4}) \\\\ y-\\frac{7}{4} & =\\sqrt{3}x-\\frac{21}{4} \\\\ y & =\\sqrt{3}\\,x-\\frac{7}{2}\\end{aligned}\n$$\n\n![](images/4d/4d58fd3550e70915f3bc2a5e8ecd64cc4ef6c154a84ca536a5ca6ef6ddf49450.png)"} {:db/id #edb/ref 17592186542227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b084a71-1f9e-54dd-851a-82a512a9441f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186541576} {:answer/id #uuid "51fb79b7-312a-53eb-918f-6f6757c1cf62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{2}}\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186541589} {:answer/id #uuid "7476878f-31ec-5872-a987-7e9e201cce2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186541661} {:answer/id #uuid "a4c7c0f8-394d-59c4-a369-40c36e6330fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186541762} {:answer/id #uuid "d4a1a9b5-c93a-5c68-be93-e1db0cd98414" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186541875}] :answer-field/correct {:db/id #edb/ref 17592186541576} :answer-field/id #uuid "f7b7ca88-f1ff-5236-b465-788cafd4842d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542100}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0a5dfca-c787-55e8-9cb2-9d81fe185f23" :question/math-academy-id "q-138129" :question/problem "The maximum value of the quadratic form $Q(x)=-3{x}_{1}^{2}+8{x}_{1}{x}_{2}+3{x}_{2}^{2},$ when $‖x‖=1,$ is equal to $5.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=5:$\n\n$$\n\\begin{aligned}A-5I & =\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-8 & 4 \\\\ 4 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\n$$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\n$$"} {:answer/id #uuid "027931f1-c81a-5437-9a6a-eaecb93a762a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡({x}^{3}+x)" :db/id #edb/ref 17592186542646} {:answer/id #uuid "0cece677-9803-52b0-b907-23768dbe2ac7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{2}⁡(x)+\\frac{1}{2}{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/id #edb/ref 17592186542667} {:answer/id #uuid "0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡\\left(\\frac{\\sqrt[3]{x}}{y}\\right)" :db/id #edb/ref 17592186542671} {:answer/id #uuid "10851533-4282-5b80-bae7-98d8fc92685d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542678} {:answer/id #uuid "170013cd-1ce2-5957-923e-754a4df4bd3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-9" :db/id #edb/ref 17592186542699} {:answer/id #uuid "18804b67-878e-56f2-a908-9dd72d5c6203" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡\\left(\\frac{7}{5}\\right)" :db/id #edb/ref 17592186542701} {:answer/id #uuid "1fdf82a0-2583-54a3-bd7d-1ee3403c2774" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(y)-{log}_{3}⁡(x)" :db/id #edb/ref 17592186542727} {:answer/id #uuid "290b87bb-8570-5cb4-83b9-b6d2e59941cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542749} {:answer/id #uuid "312ee280-346c-51be-9a5b-40f3ad5f100e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(7t)" :db/id #edb/ref 17592186542770} {:answer/id #uuid "31ee8031-ab23-5347-a954-5922df481593" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(x)\\cdot {log}_{3}⁡(y)" :db/id #edb/ref 17592186542772} {:answer/id #uuid "390b5693-f1ca-5a29-a8de-7aacb1098e9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)+3" :db/id #edb/ref 17592186542790} {:answer/id #uuid "3adf2bc5-273b-5e81-9d24-ceeca3bf0302" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{5}⁡(\\sqrt{x})" :db/id #edb/ref 17592186542800} {:answe