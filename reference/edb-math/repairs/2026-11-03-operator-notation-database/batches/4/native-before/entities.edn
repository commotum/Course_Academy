answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.6" :db/id #edb/ref 17592186543148} {:answer/id #uuid "e4bcee11-548a-590b-b15f-c15919dd5066" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186543220}] :answer-field/correct {:db/id #edb/ref 17592186542771} :answer-field/id #uuid "75dda720-e013-520a-938a-10e65394a073" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543368}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "03b07b19-1587-5e10-a223-7c9ddb411106" :question/math-academy-id "q-25145" :question/problem "Find the value of ${log}_{z}⁡(512)$ if ${log}_{z}⁡(8)=0.3.$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms and the information given, we get:\n\n$$\n\\begin{aligned}{log}_{z}⁡(512) & ={log}_{z}⁡({8}^{3}) \\\\  & =3\\cdot {log}_{z}⁡(8) \\\\  & =3\\cdot 0.3 \\\\  & =0.9\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18804b67-878e-56f2-a908-9dd72d5c6203" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡\\left(\\frac{7}{5}\\right)" :db/id #edb/ref 17592186542701} {:answer/id #uuid "74910754-3a09-5360-8578-a6e630ecceac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(2)" :db/id #edb/ref 17592186542945} {:answer/id #uuid "846f084c-4d8e-5b3c-94e0-bd4bc2d3d3de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(35)" :db/id #edb/ref 17592186542995} {:answer/id #uuid "9eff8071-7a7a-58ad-9478-1815b1968cb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(2)" :db/id #edb/ref 17592186543063} {:answer/id #uuid "b99e14c7-a03d-57b7-b791-a59cc36431e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(35)" :db/id #edb/ref 17592186543125}] :answer-field/correct {:db/id #edb/ref 17592186542701} :answer-field/id #uuid "92823537-f145-578d-8121-413772b2c835" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543389}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15c5c76c-d78d-5592-bdec-a5d9824a4594" :question/math-academy-id "q-66765" :question/problem "Express ${log}_{2}⁡(7)-{log}_{2}⁡(5)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as:\n\n$$\n{log}_{2}⁡(7)-{log}_{2}⁡(5)={log}_{2}⁡\\left(\\frac{7}{5}\\right)\n$$"} {:db/id #edb/ref 17592186543483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fdf82a0-2583-54a3-bd7d-1ee3403c2774" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(y)-{log}_{3}⁡(x)" :db/id #edb/ref 17592186542727} {:answer/id #uuid "31ee8031-ab23-5347-a954-5922df481593" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(x)\\cdot {log}_{3}⁡(y)" :db/id #edb/ref 17592186542772} {:answer/id #uuid "7f80c10e-5297-5c3f-976a-b2a1b6bb66bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{log}_{3}⁡(x)}{{log}_{3}⁡(y)}" :db/id #edb/ref 17592186542983} {:answer/id #uuid "b25d0d08-c661-51ef-9ff7-c14e5da09762" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(x)+{log}_{3}⁡(y)" :db/id #edb/ref 17592186543104} {:answer/id #uuid "ecc6e0b1-d90c-5f5b-9ef7-e7b55fb39ddf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)" :db/id #edb/ref 17592186543239}] :answer-field/correct {:db/id #edb/ref 17592186543239} :answer-field/id #uuid "058dd5c5-0df5-5561-a280-d0460c220852" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543294}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "20936b5f-864e-5ae6-90f1-dfba78a6f020" :question/math-academy-id "q-47257" :question/problem "${log}_{3}⁡\\left(\\frac{x}{y}\\right)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for logarithms, we obtain:\n\n$$\n\\begin{aligned}{log}_{3}⁡\\left(\\frac{x}{y}\\right) & ={log}_{3}⁡(x)-{log}_{3}⁡(y)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190687e3-a7f2-5a29-8dc7-a0bea5da56e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(3y)-2\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542705} {:answer/id #uuid "7581ab19-811f-5e47-b443-b607c614c0b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542948} {:answer/id #uuid "78a1a98e-88c2-5374-88b4-1257de2627c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(3y)+\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542960} {:answer/id #uuid "ad34430e-a9d9-513c-8d4f-f1869c33c3a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{log}⁡(3y)+2\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186543095} {:answer/id #uuid "e87adda8-665d-5091-a708-f9408a979f13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{log}⁡(y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186543232}] :answer-field/correct {:db/id #edb/ref 17592186542948} :answer-field/id #uuid "f6b9d0a5-0953-5666-a839-4b5670a6fac3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543465}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c8cf324-472b-5836-8692-8d44663200a5" :question/math-academy-id "q-1101" :question/problem "$\\operatorname{log}⁡\\left(\\frac{3y}{\\sqrt{x}}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{log}⁡\\left(\\frac{3y}{\\sqrt{x}}\\right) & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡(\\sqrt{x}) \\\\  & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡({x}^{1/2}) \\\\  & =\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cece677-9803-52b0-b907-23768dbe2ac7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{2}⁡(x)+\\frac{1}{2}{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/id #edb/ref 17592186542667} {:answer/id #uuid "6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186542922} {:answer/id #uuid "6a89e1fb-1817-5ee7-bb66-dae6fa7f2260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{2}⁡(x)-\\frac{1}{2}{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186542928} {:answer/id #uuid "ec14ff8e-fb9a-5ae2-9974-b0a7e6bb510d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{2}⁡(x)-2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186543236} {:answer/id #uuid "fb088d0f-9bbb-51fc-8107-4545e4127621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{log}_{2}⁡(x)-2{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/id #edb/ref 17592186543281}] :answer-field/correct {:db/id #edb/ref 17592186542922} :answer-field/id #uuid "b2475f77-a3bc-521f-922f-608b63eb6022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543423}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34847574-efca-5670-8924-e70a3bcc31ce" :question/math-academy-id "q-66923" :question/problem "${log}_{2}⁡\\left(\\frac{\\sqrt{x}{y}^{2}}{z}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get\n\n$$\n{log}_{2}⁡\\left(\\frac{\\sqrt{x}{y}^{2}}{z}\\right)={log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z).\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z)={log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) & ={log}_{2}⁡({x}^{1/2})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) \\\\  & =\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\\end{aligned}\n$$\n\nTherefore\n\n$$\n{log}_{2}⁡\\left(\\frac{\\sqrt{x}{y}^{2}}{z}\\right)=\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\n$$"} {:db/id #edb/ref 17592186543498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08538244-0a29-5cc7-b86c-0a8d7eb92a45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{x}^{2}}{y}\\right)" :db/id #edb/ref 17592186542656} {:answer/id #uuid "5d51face-45fc-5f92-aa4c-e940cfa9f9a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡\\left(\\frac{x}{y}\\right)" :db/id #edb/ref 17592186542890} {:answer/id #uuid "69b0b1b4-2068-59f6-8caa-0232583e7632" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{x}^{4}}{{y}^{2}}\\right)" :db/id #edb/ref 17592186542924} {:answer/id #uuid "bd225b51-2569-5aab-a898-96374e23410e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{y}^{4}}{{x}^{2}}\\right)" :db/id #edb/ref 17592186543135} {:answer/id #uuid "e5bfefa4-4a1a-5bbe-945c-432a0e867b73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{y}^{2}}{x}\\right)" :db/id #edb/ref 17592186543224}] :answer-field/correct {:db/id #edb/ref 17592186542924} :answer-field/id #uuid "4f6009af-c9fb-5d51-99cd-1ba483beaabc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543339}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "49c1090f-0d14-5ccb-9c30-a8b9c4fffd87" :question/math-academy-id "q-79403" :question/problem "Express $4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y) & =\\operatorname{ln}⁡({x}^{4})-\\operatorname{ln}⁡({y}^{2}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{x}^{4}}{{y}^{2}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166addb8-c2f1-5d2d-9873-0a17afec2f1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e+\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186542695} {:answer/id #uuid "276974b1-5543-5e63-b8c1-928234d07545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{ln}⁡(x-5)" :db/id #edb/ref 17592186542742} {:answer/id #uuid "61e1ae29-15b8-582a-aa4f-7bb4c3defafc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{ln}⁡(x)+\\frac{5}{e}" :db/id #edb/ref 17592186542905} {:answer/id #uuid "7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186542973} {:answer/id #uuid "88f6512a-e755-51b7-8dea-3427afc1e864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e-\\operatorname{ln}⁡(x)-5" :db/id #edb/ref 17592186543001}] :answer-field/correct {:db/id #edb/ref 17592186542973} :answer-field/id #uuid "2ee605d5-badf-5ba4-afaa-ea809cbe4caf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543320}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4d345e50-4921-588f-ae74-039f20e6e137" :question/math-academy-id "q-100242" :question/problem "$\\operatorname{ln}⁡\\left(\\frac{ex}{5}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡\\left(\\frac{ex}{5}\\right) & =\\operatorname{ln}⁡(ex)-\\operatorname{ln}⁡(5) \\\\  & =\\operatorname{ln}⁡(e)+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5) \\\\  & =1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0269a173-54ba-5ccf-a6e0-995965a165aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(13)" :db/id #edb/ref 17592186542644} {:answer/id #uuid "4e543ebb-1b6e-57d7-a4cc-de52b91accec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(13)-6\\operatorname{ln}⁡(z)" :db/id #edb/ref 17592186542852} {:answer/id #uuid "71ac5314-1262-522d-bc00-0042ccd70e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{ln}⁡(z-13)" :db/id #edb/ref 17592186542940} {:answer/id #uuid "ba338d13-209f-57cf-bc5e-38caaf642b94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13)" :db/id #edb/ref 17592186543127} {:answer/id #uuid "e1f1b615-0943-5954-af8a-c55ae24c583b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(z)" :db/id #edb/ref 17592186543215}] :answer-field/correct {:db/id #edb/ref 17592186543127} :answer-field/id #uuid "b0f4d0f6-7f8a-58c2-8e17-d618255d36d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543422}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a291781-59c8-57ab-aafe-d8f0841ec267" :question/math-academy-id "q-47198" :question/problem "$\\operatorname{ln}⁡\\left(\\frac{{z}^{6}}{13}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient quotient and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡\\left(\\frac{{z}^{6}}{13}\\right) & =\\operatorname{ln}⁡({z}^{6})-\\operatorname{ln}⁡(13) \\\\  & =6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "986de02b-222a-5a6d-891b-6e5b891ef90a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186543037} {:answer/id #uuid "9eef2f87-e855-5d53-80f4-202dbca3fd5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186543061} {:answer/id #uuid "a677f03a-acb9-5439-be1f-b1eb7dee2b3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186543078} {:answer/id #uuid "b67ada9d-787b-5291-af4f-7eef69f5678d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186543114} {:answer/id #uuid "e80ede49-5f0c-5bd8-a8bd-3022152fe7f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186543231}] :answer-field/correct {:db/id #edb/ref 17592186543114} :answer-field/id #uuid "2cd04507-0815-5cf4-b8b9-c2671207a55b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543319}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "841f3191-5c7e-5e47-b725-127033cb9a73" :question/math-academy-id "q-79453" :question/problem "If ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, then ${log}_{5}⁡({x}^{2}{y}^{3})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{5}⁡({x}^{2}{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{5}⁡({x}^{2}{y}^{3}) & ={log}_{5}⁡({x}^{2})+{log}_{5}⁡({y}^{3}) \\\\  & =2{log}_{5}⁡(x)+3{log}_{5}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, we conclude that\n\n$$\n2{log}_{5}⁡(x)+3{log}_{5}⁡(y)=2\\cdot 3+3\\cdot 2=12.\n$$\n\nHence\n\n$$\n{log}_{5}⁡({x}^{2}{y}^{3})=12.\n$$"} {:db/id #edb/ref 17592186543525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39ee37b9-1672-5997-a9c4-14acc15072a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186542795} {:answer/id #uuid "428fc9d0-d6e4-5748-97e1-c1560c6587e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186542819} {:answer/id #uuid "695cba00-73e4-5455-a33a-71c5595df47f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5+\\operatorname{ln}⁡x" :db/id #edb/ref 17592186542923} {:answer/id #uuid "c9535bdb-a29f-5d9f-bfbb-1b72f93b2cf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{ln}⁡x" :db/id #edb/ref 17592186543164} {:answer/id #uuid "ef302096-6f7f-54d7-a9e2-d98378f237a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{ln}⁡x" :db/id #edb/ref 17592186543249}] :answer-field/correct {:db/id #edb/ref 17592186543249} :answer-field/id #uuid "718f16aa-73f6-5186-9af4-70c5fc5b859c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543362}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87e631c2-0787-575b-9e30-ac64f270159d" :question/math-academy-id "q-108203" :question/problem "$\\operatorname{ln}⁡({x}^{5})=$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms, we get:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{5})=5\\operatorname{ln}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "170013cd-1ce2-5957-923e-754a4df4bd3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-9" :db/id #edb/ref 17592186542699} {:answer/id #uuid "390b5693-f1ca-5a29-a8de-7aacb1098e9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)+3" :db/id #edb/ref 17592186542790} {:answer/id #uuid "3c27c541-3a63-5fc4-ab19-bafc688b3c69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-3" :db/id #edb/ref 17592186542803} {:answer/id #uuid "6173b34d-e283-50ae-9765-c9f0bdcdfe52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)-{log}_{3}⁡(x)+3" :db/id #edb/ref 17592186542904} {:answer/id #uuid "8e12ed65-2a4a-5809-a1a7-871496b64eeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(5)-{log}_{3}⁡(x)-9" :db/id #edb/ref 17592186543012}] :answer-field/correct {:db/id #edb/ref 17592186542803} :answer-field/id #uuid "9f77377e-ee2a-59ef-bb46-445ff072d429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543403}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b91269e-ac3e-5858-87ab-575f9e7b0df8" :question/math-academy-id "q-66781" :question/problem "${log}_{3}⁡\\left(\\frac{5x}{27}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡\\left(\\frac{5x}{27}\\right) & ={log}_{3}⁡(5x)-{log}_{3}⁡(27) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-{log}_{3}⁡({3}^{3}) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb557ae-9a47-526e-ae26-b4f9d80275d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7k" :db/id #edb/ref 17592186542726} {:answer/id #uuid "a31007c0-bb7e-5195-b1fe-bac89c68dbbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k+12" :db/id #edb/ref 17592186543070} {:answer/id #uuid "cff918bc-b5d0-5906-8d66-bbe4168f3474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k-12" :db/id #edb/ref 17592186543178} {:answer/id #uuid "daad00e3-599f-5edb-abd8-30682e338221" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k+7" :db/id #edb/ref 17592186543199} {:answer/id #uuid "de2a4dff-046b-5136-b0e7-22b11eceaca1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12k" :db/id #edb/ref 17592186543205}] :answer-field/correct {:db/id #edb/ref 17592186543070} :answer-field/id #uuid "3aab8c1f-76ff-5a2c-9c46-d7294b8c857e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543330}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9796dfce-fb6b-57bd-b442-e9278daaaa20" :question/math-academy-id "q-98925" :question/problem "If ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4$, then ${log}_{2}⁡(x{y}^{3})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{2}⁡(x{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(x{y}^{3}) & ={log}_{2}⁡(x)+{log}_{2}⁡({y}^{3}) \\\\  & ={log}_{2}⁡(x)+3{log}_{2}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4,$ we conclude that\n\n$$\n\\begin{aligned}{log}_{2}⁡(x)+3{log}_{2}⁡(y) & =k+3\\cdot 4 \\\\  & =k+12.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{log}_{2}⁡(x{y}^{3})=k+12.\n$$"} {:db/id #edb/ref 17592186543537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a0860c-abf2-5370-b060-96e1084cffd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186542649} {:answer/id #uuid "11f202f0-5a2c-50a9-86a4-8e1f90d2fc6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186542684} {:answer/id #uuid "3aba9863-6882-5c55-b998-3acd603f7eb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186542799} {:answer/id #uuid "6205b6b7-d050-5d47-87dc-6d856a0d0ebf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186542909} {:answer/id #uuid "f68b95c9-151d-592e-b2bc-183c5a0f18e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186543271}] :answer-field/correct {:db/id #edb/ref 17592186542684} :answer-field/id #uuid "57d33dfc-c4ba-5526-b7de-f65fa8c64c01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543344}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9f684a9a-73a2-5a55-8105-9ed436326180" :question/math-academy-id "q-108205" :question/problem "By expressing $\\frac{3}{4}\\operatorname{ln}⁡x$ in the form $\\operatorname{ln}⁡({x}^{k}),$ determine the value of $k.$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms, we get:\n\n$$\n\\frac{3}{4}\\operatorname{ln}⁡x=\\operatorname{ln}⁡({x}^{3/4})\n$$\n\nHence $k=\\frac{3}{4}.$"} {:db/id #edb/ref 17592186543541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de3d2cd-60aa-59f4-9c1c-0d3d70e7064b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{x}-{y}^{5}" :db/id #edb/ref 17592186542718} {:answer/id #uuid "3adf2bc5-273b-5e81-9d24-ceeca3bf0302" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{5}⁡(\\sqrt{x})" :db/id #edb/ref 17592186542800} {:answer/id #uuid "6a2fdb68-0b95-5c0e-94b2-81028526e2ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{5}⁡\\left(\\frac{\\sqrt{x}}{5y}\\right)" :db/id #edb/ref 17592186542927} {:answer/id #uuid "896cc279-0ed5-5375-8db2-e1b363fec667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{x}-1" :db/id #edb/ref 17592186543003} {:answer/id #uuid "b7267a79-3839-5f21-b62c-09c9545b4060" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{5}⁡\\left(\\frac{\\sqrt{x}}{{y}^{5}}\\right)" :db/id #edb/ref 17592186543117}] :answer-field/correct {:db/id #edb/ref 17592186543117} :answer-field/id #uuid "3df2d483-a123-580b-8ed7-a2a425df48f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543332}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8ef19a1-f2fa-5f29-a4ae-a1f3f6bb227d" :question/math-academy-id "q-1110" :question/problem "Express $\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y) & ={log}_{5}⁡({x}^{1/2})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡(\\sqrt{x})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡\\left(\\frac{\\sqrt{x}}{{y}^{5}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99dce7ce-64f2-5c0a-9837-190cd80030e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi}{3}" :db/id #edb/ref 17592186543043}] :answer-field/correct {:db/id #edb/ref 17592186543043} :answer-field/id #uuid "6de9e1be-49f8-52e7-a91c-12166b2a5eb3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543360} {:answer-field/choices [{:answer/id #uuid "e2224658-7330-566b-9cbb-e995ea4833aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186543216}] :answer-field/correct {:db/id #edb/ref 17592186543216} :answer-field/id #uuid "7726603e-9dba-5342-9622-38dad57d93fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543371}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa82973f-2912-57c5-acdd-b4b8b9abbe44" :question/math-academy-id "q-338486" :question/problem "![](images/25/2593d513ce130090a84cc26e71bf321960712a6ccb2d8ff82e55e4728cc0657c.png)\n\nThe graph above shows the curve $y=2{cos}^{2}⁡x$ and the curve $y=\\operatorname{cos}⁡x$ on the interval $0\\le x<2\\pi .$ The curves intersect at the points $A,B,C,$ and $D,$ as shown. Determine the exact values of the $x$-coordinates of points $A$ and $D,$ in radians.\n\nThe $x$-coordinate of point $A$ is\n{{field-1}}\nand the $x$-coordinate of point $D$ is\n{{field-2}}." :question/worked-solution "At the intersection points, the $y$ values of both graphs are the same. This gives the equation $2{cos}^{2}⁡x=\\operatorname{cos}⁡x.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}2{cos}^{2}⁡x & =\\operatorname{cos}⁡x \\\\ 2{cos}^{2}⁡x-\\operatorname{cos}⁡x & =0 \\\\ \\operatorname{cos}⁡x(2\\operatorname{cos}⁡x-1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{cos}⁡x=0,\\,2\\operatorname{cos}⁡x-1=0.\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{cos}⁡x=0.$ The solutions to this equation for $0\\le x<2\\pi $ are $x=\\frac{\\pi }{2},\\,\\frac{3\\pi }{2}.$\n\n- Then, we solve $2\\operatorname{cos}⁡x-1=0,$ or equivalently $\\operatorname{cos}⁡x=\\frac{1}{2}.$ The solutions to this equation for $0\\le x<2\\pi $ are $x=\\frac{\\pi }{3},\\,\\frac{5\\pi }{3}.$\n\nCombining the solutions and ordering them from smallest to largest, we obtain\n\n$$\n{x}_{1}=\\frac{\\pi }{3},\\,{x}_{2}=\\frac{\\pi }{2},\\,{x}_{3}=\\frac{3\\pi }{2},\\,{x}_{4}=\\frac{5\\pi }{3}.\n$$\n\nTherefore, the $x$-coordinate of point $A$ is\n$\\frac{\\pi }{3}$\nand the $x$-coordinate of point $D$ is\n$\\frac{5\\pi }{3}.$"} {:db/id #edb/ref 17592186543547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06386582-1858-5b59-a352-479a8fbec1ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k-m" :db/id #edb/ref 17592186542651} {:answer/id #uuid "a7595e68-63e0-55b4-9190-55fd9ad8ee38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k+m" :db/id #edb/ref 17592186543080} {:answer/id #uuid "c8679008-38bf-5c0c-91af-6a3638018d35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{k}{m}" :db/id #edb/ref 17592186543162} {:answer/id #uuid "e5e08e8d-ec38-59a8-94ea-46959cbfc389" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "km" :db/id #edb/ref 17592186543225} {:answer/id #uuid "ed27e2cf-d889-5413-8f07-fe2a732afd99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "m-k" :db/id #edb/ref 17592186543243}] :answer-field/correct {:db/id #edb/ref 17592186542651} :answer-field/id #uuid "54df9ca0-9526-59ba-8d0c-624262e20b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543342}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ada9c1dd-522d-5138-9cfe-44ee7af19872" :question/math-academy-id "q-108201" :question/problem "If $\\operatorname{log}⁡(y)=k$ and $\\operatorname{log}⁡\\left(\\frac{y}{x}\\right)=m$, then $\\operatorname{log}⁡(x)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(x) & =\\operatorname{log}⁡\\left(\\frac{y}{\\left(\\frac{y}{x}\\right)}\\right) \\\\  & =\\operatorname{log}⁡(y)-\\operatorname{log}⁡\\left(\\frac{y}{x}\\right) \\\\  & =k-m.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312ee280-346c-51be-9a5b-40f3ad5f100e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(7t)" :db/id #edb/ref 17592186542770} {:answer/id #uuid "5543e5e9-fa34-55a2-963c-46317805891c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡\\left(\\frac{{t}^{7}}{2}\\right)" :db/id #edb/ref 17592186542869} {:answer/id #uuid "61eaa231-d53f-5412-a297-547a805089db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡\\left(\\frac{7t}{2}\\right)" :db/id #edb/ref 17592186542907} {:answer/id #uuid "ce45adcc-4013-5eaa-828b-6c4c5f9aefd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡(t+7)" :db/id #edb/ref 17592186543175} {:answer/id #uuid "f7a71173-deae-5155-8154-2b2bf6b3687d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{2}⁡({t}^{7})" :db/id #edb/ref 17592186543275}] :answer-field/correct {:db/id #edb/ref 17592186543275} :answer-field/id #uuid "eba2b04a-58b1-5797-a2dc-057b2fcfd9dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543458}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b071d322-d430-5f91-b157-0d44ee6fac29" :question/math-academy-id "q-100019" :question/problem "$7{log}_{2}⁡t=$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n\\operatorname{log}⁡({c}^{m})=m\\operatorname{log}⁡(c)\n$$\n\nUsing the power rule for logarithms, we obtain\n\n$$\n7{log}_{2}⁡t={log}_{2}⁡({t}^{7}).\n$$"} {:db/id #edb/ref 17592186543555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7574b035-fb76-58c1-aaf3-b6389076e7bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186542947}] :answer-field/correct {:db/id #edb/ref 17592186542947} :answer-field/id #uuid "a7620e10-48ae-5504-a96e-87ea7b96af22" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543413} {:answer-field/choices [{:answer/id #uuid "580a354e-1779-5718-b38a-6a25da50d38b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{6}" :db/id #edb/ref 17592186542880}] :answer-field/correct {:db/id #edb/ref 17592186542880} :answer-field/id #uuid "e477022f-fdfc-5eff-a7bd-6ef731fb7877" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543451}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bf7fd672-fd24-5897-b0f7-1572fe68c96d" :question/math-academy-id "q-339149" :question/problem "Expressed in **ascending order** in radians, the exact solutions to the equation $cos\\,(x+\\frac{\\pi }{6})=\\frac{1}{2},$ for $0\\le x<2\\pi ,$ are\n\n${x}_{1}=$ \n{{field-1}}, $\\,{x}_{2}=$ \n{{field-2}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}x+\\frac{\\pi }{6} & =\\frac{\\pi }{3}+n\\cdot 2\\pi , & \\, & \\, & x+\\frac{\\pi }{6} & =\\frac{5\\pi }{3}+n\\cdot 2\\pi .\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{\\pi }{3}-\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & x & =\\frac{5\\pi }{3}-\\frac{\\pi }{6}+n\\cdot 2\\pi  \\\\ x & =\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & x & =\\frac{3\\pi }{2}+n\\cdot 2\\pi \\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{6}$ and $x=\\frac{3\\pi }{2}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$\n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n{x}_{1}=\\frac{\\pi }{6},\\,{x}_{2}=\\frac{3\\pi }{2}.\n$$"} {:db/id #edb/ref 17592186543573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10851533-4282-5b80-bae7-98d8fc92685d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542678} {:answer/id #uuid "290b87bb-8570-5cb4-83b9-b6d2e59941cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542749} {:answer/id #uuid "599a54dc-6c33-56a6-8830-1ae45124f78d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542884} {:answer/id #uuid "84635862-dc5f-5a84-88a5-ebc9a5b22bda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{log}_{3}⁡(x)+{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542994} {:answer/id #uuid "91fec59e-a5fa-5664-9d8b-2381d008fe09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{3}⁡(x)+{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186543022}] :answer-field/correct {:db/id #edb/ref 17592186542678} :answer-field/id #uuid "3ccb3dbb-60a9-5fb3-a5b6-44c5f5ad437b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543331}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e3b649a8-d282-53b7-b8c8-e883fd47c0b9" :question/math-academy-id "q-79406" :question/problem "${log}_{3}⁡\\left(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get:\n\n$$\n{log}_{3}⁡\\left(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}}\\right)={log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})={log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z}).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n{log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z})=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$\n\nTherefore\n\n$$\n{log}_{3}⁡\\left(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}}\\right)=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$"} {:db/id #edb/ref 17592186543577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡\\left(\\frac{\\sqrt[3]{x}}{y}\\right)" :db/id #edb/ref 17592186542671} {:answer/id #uuid "57aa5928-9fe8-571f-bec1-84a8858c534f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡\\left(\\frac{3x}{y}\\right)" :db/id #edb/ref 17592186542879} {:answer/id #uuid "5db0ca0e-d6da-543d-94a6-0b0616316cbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡\\left(\\frac{x}{3y}\\right)" :db/id #edb/ref 17592186542891} {:answer/id #uuid "c76a97fc-fdf4-5ad6-8243-95edbdc9a876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡(\\sqrt[3]{x}y)" :db/id #edb/ref 17592186543160} {:answer/id #uuid "ecfa35ae-3197-55c3-8180-1535e0873fbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{4}⁡\\left(\\frac{{x}^{3}}{y}\\right)" :db/id #edb/ref 17592186543240}] :answer-field/correct {:db/id #edb/ref 17592186542671} :answer-field/id #uuid "bb4f622f-2866-535c-a540-b48bd6d1ad52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543431}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e70f2288-3b25-5d12-a8c5-361a6e66e0f3" :question/math-academy-id "q-100243" :question/problem "Express $\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y) & ={log}_{4}⁡({x}^{1/3})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡(\\sqrt[3]{x})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡\\left(\\frac{\\sqrt[3]{x}}{y}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010f0bb3-cfce-57dc-a3dd-0e6bf16e313e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3\\operatorname{cos}⁡\\theta }r\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186543678} {:answer/id #uuid "4cde6b07-0e2a-568b-abd2-30c5e1ac404b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{3\\operatorname{sin}⁡\\theta }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186543699} {:answer/id #uuid "63130042-5901-5034-86fc-435727d0f3f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3\\operatorname{sin}⁡\\theta }{r}^{2}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186543702} {:answer/id #uuid "7ee5d5f6-e473-541e-87b4-e95658ad2cff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{3\\operatorname{cos}⁡\\theta }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186543705} {:answer/id #uuid "f0fe3285-6e13-5d53-953e-91a811e1db98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{3\\operatorname{sin}⁡\\theta }r\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186543725}] :answer-field/correct {:db/id #edb/ref 17592186543699} :answer-field/id #uuid "3d84f478-b5b5-5f25-9156-e2d90cf503dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543693}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dc21b297-d346-5eac-82b2-8f472263113f" :question/problem "If $$\n\\displaystyle D=\\{(x,y)\\,:\\,{x}^{2}+(y-\\frac{3}{2})^{2}\\le \\frac{9}{4}\\},\n$$ then $$\n\\displaystyle {∬}_{D}x\\,\\text{d}A=\n$$\n\nChoose the polar setup whose bounds describe $D$ with $r\\ge 0$ and whose integrand is the given Cartesian integrand multiplied by the Jacobian $r.$" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/07/074eb42aff2c78d93136fc9e56b2420450f72c5d34c6b12da8bf84e080db75ea.png)\n\nNotice that the region $D$ represents the disk of radius $\\frac{3}{2}$ centered at $(0,\\frac{3}{2}).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write the ${x}^{2}+(y-\\frac{3}{2})^{2}=\\frac{9}{4}$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-\\frac{3}{2})^{2} & =\\frac{9}{4} \\\\ {(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta -\\frac{3}{2})}^{2} & =\\frac{9}{4} \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -3r\\operatorname{sin}⁡\\theta +\\frac{9}{4} & =\\frac{9}{4} \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-3r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-3r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-3\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=3\\operatorname{sin}⁡\\theta .$\n\nNow, let's determine the limits for $r$ and $\\theta .$ First of all, $r$ can vary from $r=0$ (at the origin) to $r=3\\operatorname{sin}⁡\\theta $ (at the boundary of the region): \n\n![](images/ce/cea2b2ddd6b211073b579d71bd8ed08405fa04e354825a124acb71bedf413295.png)\n\nSecondly, $\\theta $ can vary between $\\theta =0$ (the positive $x$-axis) and $\\theta =\\pi $ (the negative $x$-axis):\n\n![](images/bb/bbe07b71b3c82cde2e9175b06904905206984b04ca9a8ccd746b051212f5e8d8.png)\n\nSo, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={∬}_{Δ}r\\operatorname{cos}⁡\\theta \\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{3\\operatorname{sin}⁡\\theta }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a0021cd-4a2d-5b31-bfd5-25eef39f0c2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\cdot\\left(2(\\operatorname{tan}⁡\\phi)+\\operatorname{sec}⁡\\phi\\right)" :db/id #edb/ref 17592186543915} {:answer/id #uuid "324e9c24-dfb8-53f2-85af-cfde89b4acea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\cdot\\left(\\operatorname{tan}⁡\\phi+\\operatorname{sec}⁡\\phi\\right)" :db/id #edb/ref 17592186543920} {:answer/id #uuid "879810a8-1530-5fce-ae66-9e20a0f28465" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\cdot\\left(\\operatorname{cot}⁡\\phi+\\operatorname{cos}⁡\\phi\\right)" :db/id #edb/ref 17592186543936} {:answer/id #uuid "93bf6f47-b09c-576f-bb5b-a516f908a5bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\cdot\\left(\\operatorname{tan}⁡\\phi+1\\right)" :db/id #edb/ref 17592186543938} {:answer/id #uuid "a9b2908b-a5d7-5d5d-bb4b-2bb1faa11f10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\cdot\\left(-(\\operatorname{tan}⁡\\phi)+\\operatorname{sec}⁡\\phi\\right)" :db/id #edb/ref 17592186543946}] :answer-field/correct {:db/id #edb/ref 17592186543920} :answer-field/id #uuid "499f09fc-39a0-5be4-baee-7ba917c91a16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543924}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a56543e2-db0d-5bbe-9f00-ce5c215e5be9" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle 8\\cdot\\left(\\frac{{sin}^{3}⁡\\phi+\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+1}{\\operatorname{cos}⁡\\phi}\\right).\n$$" :question/worked-solution "First, we factor $\\operatorname{sin}⁡\\phi$ from the first two terms:\n\n$$\n8\\cdot\\left(\\frac{{sin}^{3}⁡\\phi+\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+1}{\\operatorname{cos}⁡\\phi}\\right)=8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi({sin}^{2}⁡\\phi+{cos}^{2}⁡\\phi)+1}{\\operatorname{cos}⁡\\phi}\\right)\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi({sin}^{2}⁡\\phi+{cos}^{2}⁡\\phi)+1}{\\operatorname{cos}⁡\\phi}\\right) & =8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi+1}{\\operatorname{cos}⁡\\phi}\\right) \\\\  & =8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi}{\\operatorname{cos}⁡\\phi}+\\frac{1}{\\operatorname{cos}⁡\\phi}\\right) \\\\  & =8\\cdot\\left(\\operatorname{tan}⁡\\phi+\\operatorname{sec}⁡\\phi\\right)\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n8\\cdot\\left(\\frac{{sin}^{3}⁡\\phi+\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+1}{\\operatorname{cos}⁡\\phi}\\right)=8\\cdot\\left(\\operatorname{tan}⁡\\phi+\\operatorname{sec}⁡\\phi\\right)\n$$"} {:db/id #edb/ref 17592186543947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54edeba8-927f-56a7-b47f-e46bb9ab034e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{cot}⁡\\phi" :db/id #edb/ref 17592186543925} {:answer/id #uuid "7bc3dbb2-eabc-5f51-8d0d-fe7444a83cc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(8\\operatorname{tan}⁡\\phi)" :db/id #edb/ref 17592186543931} {:answer/id #uuid "9d17391d-e21d-5862-a0c0-ed1309eafc36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8\\operatorname{tan}⁡\\phi)\\sin \\phi" :db/id #edb/ref 17592186543941} {:answer/id #uuid "c71ec218-4a75-51eb-8d8a-dabab8c2d97c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{tan}⁡\\phi" :db/id #edb/ref 17592186543952} {:answer/id #uuid "f36257d7-71ad-576f-96fa-5afff209087b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(8\\operatorname{tan}⁡\\phi)" :db/id #edb/ref 17592186543958}] :answer-field/correct {:db/id #edb/ref 17592186543952} :answer-field/id #uuid "813958db-5f62-52cd-b1f0-43bdcb335b0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543933}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "af869c9b-07fb-5375-ae05-04154af3873f" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle 8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+{sin}^{3}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right).\n$$" :question/worked-solution "First, we factor the numerator:\n\n$$\n8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+{sin}^{3}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right)=8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi\\cdot ({cos}^{2}⁡\\phi+{sin}^{2}⁡\\phi)}{\\operatorname{cos}⁡\\phi}\\right)\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi\\cdot ({cos}^{2}⁡\\phi+{sin}^{2}⁡\\phi)}{\\operatorname{cos}⁡\\phi}\\right) & =8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi\\cdot 1}{\\operatorname{cos}⁡\\phi}\\right) \\\\  & =8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right) \\\\  & =8\\operatorname{tan}⁡\\phi\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+{sin}^{3}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right)=8\\operatorname{tan}⁡\\phi.\n$$"} {:db/id #edb/ref 17592186543959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09808695-7738-5c8a-9ea5-1755aecfe0b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3(4\\operatorname{sec}⁡\\phi )}{2}" :db/id #edb/ref 17592186543906} {:answer/id #uuid "292df7c5-2d13-5ed1-9eef-3f05a8dadde6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(4\\operatorname{sec}⁡\\phi )" :db/id #edb/ref 17592186543914} {:answer/id #uuid "458bb221-b324-5ba3-a5c3-6d904739d379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4\\operatorname{sec}⁡\\phi )\\cos \\phi" :db/id #edb/ref 17592186543923} {:answer/id #uuid "694d3240-f1c3-5bf9-b1d0-e579178b1749" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{sec}⁡\\phi " :db/id #edb/ref 17592186543927} {:answer/id #uuid "cd4bb8f7-e950-572d-b909-b7691078d5bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cos}⁡\\phi " :db/id #edb/ref 17592186543954}] :answer-field/correct {:db/id #edb/ref 17592186543927} :answer-field/id #uuid "97abb51b-60dd-5d8a-87cc-8deda195a885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543939}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f4a5275a-4ac6-5cc3-ad58-4b1c9fb73487" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle 2\\cdot\\left(\\frac{{sin}^{4}⁡\\phi +{sin}^{2}⁡\\phi {cos}^{2}⁡\\phi +{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right).\n$$" :question/worked-solution "First, we factor the numerator:\n\n$$\n2\\cdot\\left(\\frac{{sin}^{4}⁡\\phi +{sin}^{2}⁡\\phi {cos}^{2}⁡\\phi +{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right)=2\\cdot\\left(\\frac{{sin}^{2}⁡\\phi ({sin}^{2}⁡\\phi +{cos}^{2}⁡\\phi )+{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right)\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}2\\cdot\\left(\\frac{{sin}^{2}⁡\\phi ({sin}^{2}⁡\\phi +{cos}^{2}⁡\\phi )+{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right) & =2\\cdot\\left(\\frac{{sin}^{2}⁡\\phi \\cdot 1+{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right) \\\\  & =2\\cdot\\left(\\frac{2{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right) \\\\  & =2\\cdot\\left(\\frac{2\\cdot {sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\cdot \\operatorname{cos}⁡\\phi }\\right) \\\\  & =2\\cdot\\left(\\frac{2\\cdot \\cancel{{sin}^{2}⁡\\phi }}{\\cancel{{sin}^{2}⁡\\phi }\\cdot \\operatorname{cos}⁡\\phi }\\right) \\\\  & =2\\cdot\\left(\\frac{2}{\\operatorname{cos}⁡\\phi }\\right) \\\\  & =4\\operatorname{sec}⁡\\phi \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n2\\cdot\\left(\\frac{{sin}^{4}⁡\\phi +{sin}^{2}⁡\\phi {cos}^{2}⁡\\phi +{sin}^{2}⁡\\phi }{{sin}^{2}⁡\\phi \\operatorname{cos}⁡\\phi }\\right)=4\\operatorname{sec}⁡\\phi.\n$$"} {:db/id #edb/ref 17592186544015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbb58a5e-aca0-59c4-912f-79726bee9634" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186544054}] :answer-field/correct {:db/id #edb/ref 17592186544054} :answer-field/id #uuid "dea7cd5a-b58b-58d0-9d87-50e8f2bc76db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0271a4be-2e1b-5236-8901-8d8148db0863" :question/problem "Suppose $|\\,a\\,|=\\frac{8}{3}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{5\\pi }{6}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{8}{3}cos\\,\\left(\\frac{5\\pi }{6}\\right) \\\\  & =\\frac{8}{3}\\cdot \\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\  & =-\\frac{4\\sqrt{3}}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21dcbf1e-95fe-5861-b267-8fd9bba617e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13\\sqrt{6}}{4}" :db/id #edb/ref 17592186544019}] :answer-field/correct {:db/id #edb/ref 17592186544019} :answer-field/id #uuid "df2ca04f-d6ae-5f52-bafe-c833132086ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544059}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5178e3f5-c8fd-52bb-a8fd-c681d5274952" :question/problem "Suppose $|\\,a\\,|=\\frac{13\\sqrt{2}}{2}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{13\\sqrt{2}}{2}cos\\,\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{13\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{13\\sqrt{6}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544032 :question/answer-fields [{:answer-fie