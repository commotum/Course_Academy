\\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=x\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}x\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{\\rho }^{4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=x\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}x\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{\\rho }^{4}\\operatorname{cos}⁡\\theta {\\sin }^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$"] [:db/cas 17592186482585 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$  represents one-quarter of the sphere of radius $10$ centered at $(10,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=20x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =20x \\\\ {\\rho }^{2} & =20\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/16/165ed50d8f94f3b896f4d19647fb514f544221872a6df241a6ab6c3797bbd698.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{y}{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}+{(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}} \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$  represents one-quarter of the sphere of radius $10$ centered at $(10,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=20x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =20x \\\\ {\\rho }^{2} & =20\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/16/165ed50d8f94f3b896f4d19647fb514f544221872a6df241a6ab6c3797bbd698.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{y}{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}+{(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}} \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{\\rho }^{2}{\\sin }^{2}⁡ϕ({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )} \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$"] [:db/cas 17592186482726 :answer/value "\\frac{1}{7}\\ln \\mid 7\\csch x + 1 \\mid + C" "\\frac{1}{7}\\ln \\mid 7\\operatorname{csch}  x + 1 \\mid + C"] [:db/cas 17592186482728 :question/problem "What is $$\n\\displaystyle \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displaystyle \\int\\frac{\\csch^{2} x}{7\\coth x + 1}dx\n$$?" "What is $$\n\\displaystyle \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displaystyle \\int\\frac{\\operatorname{csch} ^{2} x}{7\\coth x + 1}dx\n$$?"] [:db/cas 17592186482728 :question/worked-solution "$$\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\nLet $u=7\\coth x+1$. Differentiating gives\n\n$$\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-7\\csch^2 x,\n\\qquad \\csch^2 x\\,\\mathrm{d}x=-\\frac{1}{7}\\,\\mathrm{d}u.$$\