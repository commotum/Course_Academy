d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{(1+\\operatorname{sin}⁡\\theta )^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{2+2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }\\sqrt{{sin}^{2}⁡\\left(\\frac{\\theta }{2}\\right)+{cos}^{2}⁡\\left(\\frac{\\theta }{2}\\right)+2\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }\\sqrt{{(\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right))}^{2}}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }|\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)|\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{[|-\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)|]}_{\\pi /2}^{\\pi } \\\\  & =2\\sqrt{2}(|-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)|-|-\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)|) \\\\  & =2\\sqrt{2}(1-0) \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$" "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\t