)\\,|}_{x=-ln⁡2} \\\\  & =\\frac{7}{4}{e}^{-ln⁡2} \\\\  & =\\frac{7}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{7}{8}.\\end{aligned}\n$$" "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $\\ln ⁡5$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\ln ⁡5+\\frac{7}{4}{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\ln ⁡5)+\\frac{\\text{d}}{\\text{d}x}(\\frac{7}{4}{e}^{x}) \\\\  & =0+\\frac{7}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{7}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-\\ln ⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-\\ln ⁡2} & ={(\\frac{7}{4}{e}^{x})\\,|}_{x=-\\ln ⁡2} \\\\  & =\\frac{7}{4}{e}^{-\\ln ⁡2} \\\\  & =\\frac{7}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{7}{8}.\\end{aligned}\n$$"] [:db/cas 17592186480048 :question/problem "Given that $f(x)=\\frac{11}{4}{e}^{x}-11$, the slope of the tangent line at $x=-ln⁡5$ is{{field-1}}." "Given that $f(x)=\\frac{11}{4}{e}^{x}-11$, the slope of the tangent line at $x=-\\ln ⁡5$ is{{field-1}}."] [:db/cas 17592186480048 :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{11}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡5$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡5} & ={(\\frac{11}{4}{e}^{x})\\,|}_{x=-ln⁡5} \\\\  & =\\frac{11}{4}{e}^{-ln⁡5} \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{5} \\\\  & =\\frac{11}{20}.\\end{aligned}\n$$" "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{11}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-\\ln ⁡5$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-\\ln ⁡5} & ={(\\frac{11}{4}{e}^{x})\\,|}_{x=-\\ln ⁡5} \\\\  & =\\frac{11}{4}{e}^{-\\ln ⁡5} \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{5} \\\\  & =\\frac{11}{20}.\\end{aligned}\n$$"] [:db/cas 17592186480641 :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t),$ we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${T}^{′}(t)$ and ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =|-\\frac{\\sqrt{2}}{2}|\\sqrt{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{({sin}^{2}⁡t+{cos}^{2}⁡t)+({sin}^{2}⁡t+{cos}^{2}⁡t)+(2\\operatorname{cos}⁡t\\operatorname{sin}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t)} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{1+1+0} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{2} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & ={e}^{t}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)^{2}} \\\\  & ={e}^{t}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t} \\\\  & ={e}^{t}\\sqrt{({cos}^{2}⁡t+{sin}^{2}⁡t)+({cos}^{2}⁡t+{sin}^{2}⁡t)+(-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)} \\\\  & ={e}^{t}\\sqrt{1+1+0} \\\\  & =\\sqrt{2}\\,{e}^{t}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{\\sqrt{2}\\,{e}^{t}}=\\frac{\\sqrt{2}\\,{e}^{-t}}{2}.\\end{aligned}\n$$" "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t),$ we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${T}^{′}(t)$ and ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =|-\\frac{\\sqrt{2}}{2}|\\sqrt{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{\\sin }^{2}⁡t+{\\cos }^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{\\sin }^{2}⁡t+{\\cos }^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)+({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)+(2\\operatorname{cos}⁡t\\operatorname{sin}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t)} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{1+1+0} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{2} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & ={e}^{t}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)^{2}} \\\\  & ={e}^{t}\\sqrt{{\\cos }^{2}⁡t+{\\sin }^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{\\cos }^{2}⁡t+{\\sin }^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t} \\\\  & ={e}^{t}\\sqrt{({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)+({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)+(-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)} \\\\  & ={e}^{t}\\sqrt{1+1+0} \\\\  & =\\sqrt{2}\\,{e}^{t}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{\\sqrt{2}\\,{e}^{t}}=\\frac{\\sqrt{2}\\,{e}^{-t}}{2}.\\end{aligned}\n$$"] [:db/cas 17592186480839 :answer/value "{ln}^{3}⁡2" "{\\ln }^{3}⁡2"] [:db/cas 17592186480917 :answer/value "{ln}^{2}⁡2" "{\\ln }^{2}⁡2"] [:db/cas 17592186480933 :answer/value "2{ln}^{3}⁡2" "2{\\ln }^{3}⁡2"] [:db/cas 17592186480962 :answer/value "{ln}^{2}⁡2" "{\\ln }^{2}⁡2"] [:db/cas 17592186481024 :answer/value "2{ln}^{2}⁡2" "2{\\ln }^{2}⁡2"] [:db/cas 17592186481086 :answer/value "4{ln}^{2}⁡2" "4{\\ln }^{2}⁡2"] [:db/cas 17592186481203 :answer/value "2{ln}^{2}⁡2" "2{\\ln }^{2}⁡2"] [:db/cas 17592186481357 :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {2}^{2}=4\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <2\\pi \\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta {\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,{[\\frac{{r}^{4}}{4}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta (4-0)\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =2{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =2[(2\\pi -0)-\\frac{1}{2}(\\operatorname{sin}⁡4\\pi -\\operatorname{sin}⁡0)] \\\\  & =2\\cdot 2\\pi  \\\\  & =4\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{4\\pi }\\cdot 4\\pi =1.\n$$" "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {2}^{2}=4\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <2\\pi \\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}{\\sin }^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\sin }^{2}⁡\\theta {\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\sin }^{2}⁡\\theta \\,{[\\frac{{r}^{4}}{4}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\sin }^{2}⁡\\theta (4-0)\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{\\sin }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =2{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =2[(2\\pi -0)-\\frac{1}{2}(\\operatorname{sin}⁡4\\pi -\\operatorname{sin}⁡0)] \\\\  & =2\\cdot 2\\pi  \\\\  & =4\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{4\\pi }\\cdot 4\\pi =1.\n$$"] [:db/cas 17592186481371 :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu={e}^{x},\\,v={e}^{y}\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{x} & 0 \\\\ 0 & \\text{ }\\text{ }{e}^{y}\\end{vmatrix} \\\\  & ={e}^{x+y}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{{e}^{x+y}}=\\frac{1}{uv}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y\\,dx\\,dy & ={∬}_{Δ}\\operatorname{ln}⁡v\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}\\operatorname{ln}⁡v\\cdot |\\frac{1}{uv}|\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}[{\\int }_{1}^{4}\\frac{\\operatorname{ln}⁡v}{v}\\,dv]du \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}{[\\frac{{ln}^{2}⁡v}{2}]}_{1}^{4}du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{u}[{ln}^{2}⁡4-{ln}^{2}⁡1]\\,du \\\\  & =\\frac{{ln}^{2}⁡4}{2}{\\int }_{1}^{2}\\frac{1}{u}\\,du \\\\  & =2{ln}^{2}⁡2[\\operatorname{ln}⁡u]_{1}^{2} \\\\  & =2{ln}^{2}⁡2(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2{ln}^{3}⁡2.\\end{aligned}\n$$" "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu={e}^{x},\\,v={e}^{y}\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{x} & 0 \\\\ 0 & \\text{ }\\text{ }{e}^{y}\\end{vmatrix} \\\\  & ={e}^{x+y}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{{e}^{x+y}}=\\frac{1}{uv}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y\\,dx\\,dy & ={∬}_{Δ}\\operatorname{ln}⁡v\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}\\operatorname{ln}⁡v\\cdot |\\frac{1}{uv}|\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}[{\\int }_{1}^{4}\\frac{\\operatorname{ln}⁡v}{v}\\,dv]du \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}{[\\frac{{\\ln }^{2}⁡v}{2}]}_{1}^{4}du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{u}[{\\ln }^{2}⁡4-{\\ln }^{2}⁡1]\\,du \\\\  & =\\frac{{\\ln }^{2}⁡4}{2}{\\int }_{1}^{2}\\frac{1}{u}\\,du \\\\  & =2{\\ln }^{2}⁡2[\\operatorname{ln}⁡u]_{1}^{2} \\\\  & =2{\\ln }^{2}⁡2(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2{\\ln }^{3}⁡2.\\end{aligned}\n$$"] [:db/cas 17592186481388 :question/worked-solution "First, we need to determine whether $D$ is diagonalizable over $R.$\n\nWe start by computing the eigenvalues of $A.$ To do that, we solve the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & 3 \\\\ 2 & 4-\\lambda  & -9 \\\\ -8 & 0 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}4-\\lambda  & 3 \\\\ -8 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((4-\\lambda )(-4-\\lambda )+24) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}+8) & =0.\\end{aligned}\n$$\n\nFor the quadratic polynomial $\\,{\\lambda }^{2}+8\\,$ we have that the discriminant $D<0.$ So, it doesn't have real roots. \n\nTherefore, $A$ is not diagonalizable over $R.$" "First, we need to determine whether $D$ is diagonalizable over $R.$\n\nWe start by computing the eigenvalues of $A.$ To do that, we solve the characteristic equation, as follows:\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & 3 \\\\ 2 & 4-\\lambda  & -9 \\\\ -8 & 0 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}4-\\lambda  & 3 \\\\ -8 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((4-\\lambda )(-4-\\lambda )+24) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}+8) & =0.\\end{aligned}\n$$\n\nFor the quadratic polynomial $\\,{\\lambda }^{2}+8\\,$ we have that the discriminant $D<0.$ So, it doesn't have real roots. \n\nTherefore, $A$ is not diagonalizable over $R.$"] [:db/cas 17592186481389 :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le y-2x\\le 4,\\,0\\le y\\le 2,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-2x\\,\\text{and}\\,v=y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,0\\le v\\le 2\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & \\text{ }\\text{ }1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{\\operatorname{ln}⁡(y-2x)}{y-2x}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}\\frac{\\operatorname{ln}⁡u}{u}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{\\operatorname{ln}⁡u}{u}\\,|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}[{\\int }_{1}^{4}\\frac{\\operatorname{ln}⁡u}{u}\\,du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{[\\frac{{ln}^{2}⁡u}{2}]}_{1}^{4}dv \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({ln}^{2}⁡4-{ln}^{2}⁡1)\\,dv \\\\  & =\\frac{1}{4}{ln}^{2}⁡4{\\int }_{0}^{2}dv \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡2)^{2}\\cdot [v]_{0}^{2} \\\\  & ={ln}^{2}⁡2\\cdot (2-0) \\\\  & =2{ln}^{2}⁡2.\\end{aligned}\n$$" "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le y-2x\\le 4,\\,0\\le y\\le 2,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-2x\\,\\text{and}\\,v=y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,0\\le v\\le 2\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & \\text{ }\\text{ }1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{\\operatorname{ln}⁡(y-2x)}{y-2x}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}\\frac{\\operatorname{ln}⁡u}{u}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{\\operatorname{ln}⁡u}{u}\\,|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}[{\\int }_{1}^{4}\\frac{\\operatorname{ln}⁡u}{u}\\,du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{[\\frac{{\\ln }^{2}⁡u}{2}]}_{1}^{4}dv \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({\\ln }^{2}⁡4-{\\ln }^{2}⁡1)\\,dv \\\\  & =\\frac{1}{4}{\\ln }^{2}⁡4{\\int }_{0}^{2}dv \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡2)^{2}\\cdot [v]_{0}^{2} \\\\  & ={\\ln }^{2}⁡2\\cdot (2-0) \\\\  & =2{\\ln }^{2}⁡2.\\end{aligned}\n$$"] [:db/cas 17592186481407 :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {1}^{2}=\\frac{\\pi }{2}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at \n$(1,0).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that is mind, let's now write the $y=-\\sqrt{2x-{x}^{2}}$ in polar coordinates:\n\n$$\n\\begin{aligned}y & =-\\sqrt{2x-{x}^{2}} \\\\ {y}^{2} & =2x-{x}^{2} \\\\ {x}^{2}+{y}^{2} & =2x \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}5y({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}5r\\operatorname{sin}⁡\\theta ((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\operatorname{sin}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta [{r}^{5}]_{0}^{2\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta ((2\\operatorname{cos}⁡\\theta )^{5}-0)\\,\\text{d}\\theta  \\\\  & =32{\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {cos}^{5}⁡\\theta \\,\\text{d}\\theta  \\\\  & =32{[-\\frac{1}{6}{cos}^{6}⁡\\theta ]}_{-\\pi /2}^{0} \\\\  & =-\\frac{16}{3}[{cos}^{6}⁡(0)-{cos}^{6}⁡\\left(-\\frac{\\pi }{2}\\right)] \\\\  & =-\\frac{16}{3}(1-0) \\\\  & =-\\frac{16}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\left(\\frac{\\pi }{2}\\right)}\\cdot \\left(-\\frac{16}{3}\\right)=-\\frac{32}{3\\pi }.\n$$" "First, notice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {1}^{2}=\\frac{\\pi }{2}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at \n$(1,0).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that is mind, let's now write the $y=-\\sqrt{2x-{x}^{2}}$ in polar coordinates:\n\n$$\n\\begin{aligned}y & =-\\sqrt{2x-{x}^{2}} \\\\ {y}^{2} & =2x-{x}^{2} \\\\ {x}^{2}+{y}^{2} & =2x \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta ) & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}5y({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}5r\\operatorname{sin}⁡\\theta ((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\operatorname{sin}⁡\\theta ({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta [{r}^{5}]_{0}^{2\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta ((2\\operatorname{cos}⁡\\theta )^{5}-0)\\,\\text{d}\\theta  \\\\  & =32{\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {\\cos }^{5}⁡\\theta \\,\\text{d}\\theta  \\\\  & =32{[-\\frac{1}{6}{\\cos }^{6}⁡\\theta ]}_{-\\pi /2}^{0} \\\\  & =-\\frac{16}{3}[{\\cos }^{6}⁡(0)-{\\cos }^{6}⁡\\left(-\\frac{\\pi }{2}\\right)] \\\\  & =-\\frac{16}{3}(1-0) \\\\  & =-\\frac{16}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\left(\\frac{\\pi }{2}\\right)}\\cdot \\left(-\\frac{16}{3}\\right)=-\\frac{32}{3\\pi }.\n$$"] [:db/cas 17592186481418 :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}y{cos}^{2}⁡(y-x)\\,dxdy,\n$$\n\n \nwhere $$\n\\displaystyle D=\\{(x,y)\\,:\\,|y-x|\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2}\\}.\n$$" "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}y{\\cos }^{2}⁡(y-x)\\,dxdy,\n$$\n\n \nwhere $$\n\\displaystyle D=\\{(x,y)\\,:\\,|y-x|\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2}\\}.\n$$"] [:db/cas 17592186481418 :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n\\frac{\\pi }{2}\\le y-x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2},\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-x\\,\\text{and}\\,v=y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,-\\frac{\\pi }{2}\\le u\\le \\frac{\\pi }{2},\\,0\\le v\\le \\frac{\\pi }{2}\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & \\text{ }\\text{ }1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y{cos}^{2}⁡(y-x)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}v{cos}^{2}⁡u\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}v{cos}^{2}⁡u\\cdot |-1|\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{0}^{\\pi /2}v[{\\int }_{-\\pi /2}^{\\pi /2}{cos}^{2}⁡u\\,du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}v[{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡2u+1)du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}v[\\frac{\\operatorname{sin}⁡2u}{2}+u]_{-\\pi /2}^{\\pi /2}\\,dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}\\pi v\\,dv \\\\  & =\\frac{\\pi }{2}[\\frac{{v}^{2}}{2}]_{0}^{\\pi /2} \\\\  & =\\frac{\\pi }{2}\\cdot \\frac{{\\pi }^{2}}{8} \\\\  & =\\frac{{\\pi }^{3}}{16}.\\end{aligned}\n$$" "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n\\frac{\\pi }{2}\\le y-x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2},\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-x\\,\\text{and}\\,v=y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,-\\frac{\\pi }{2}\\le u\\le \\frac{\\pi }{2},\\,0\\le v\\le \\frac{\\pi }{2}\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & \\text{ }\\text{ }1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y{\\cos }^{2}⁡(y-x)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}v{\\cos }^{2}⁡u\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}v{\\cos }^{2}⁡u\\cdot |-1|\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{0}^{\\pi /2}v[{\\int }_{-\\pi /2}^{\\pi /2}{\\cos }^{2}⁡u\\,du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}v[{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡2u+1)du]dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}v[\\frac{\\operatorname{sin}⁡2u}{2}+u]_{-\\pi /2}^{\\pi /2}\\,dv \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}\\pi v\\,dv \\\\  & =\\frac{\\pi }{2}[\\frac{{v}^{2}}{2}]_{0}^{\\pi /2} \\\\  & =\\frac{\\pi }{2}\\cdot \\frac{{\\pi }^{2}}{8} \\\\  & =\\frac{{\\pi }^{3}}{16}.\\end{aligned}\n$$"] [:db/cas 17592186481479 :question/problem "Given the function  $y=5{log}_{9}⁡x-8\\operatorname{ln}⁡x+11{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." "Given the function  $y=5{\\log }_{9}⁡x-8\\operatorname{ln}⁡x+11{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}."] [:db/cas 17592186481479 :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{9}⁡x-8\\operatorname{ln}⁡x+11{e}^{x}) \\\\  & =\\frac{5}{x\\operatorname{ln}⁡9}-\\frac{8}{x}+11{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{5}{x\\operatorname{ln}⁡9}-\\frac{8}{x}+11{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{5}{1\\cdot \\operatorname{ln}⁡9}-\\frac{8}{1}+11{e}^{1} \\\\  & =\\frac{5}{\\operatorname{ln}⁡9}-8+11e\\,.\\end{aligned}\n$$" "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({\\log }_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{\\log }_{9}⁡x-8\\operatorname{ln}⁡x+11{e}^{x}) \\\\  & =\\frac{5}{x\\operatorname{ln}⁡9}-\\frac{8}{x}+11{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{5}{x\\operatorname{ln}⁡9}-\\frac{8}{x}+11{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{5}{1\\cdot \\operatorname{ln}⁡9}-\\frac{8}{1}+11{e}^{1} \\\\  & =\\frac{5}{\\operatorname{ln}⁡9}-8+11e\\,.\\end{aligned}\n$$"] [:db/cas 17592186481480 :question/problem "Given the function  $y=8{log}_{4}⁡x-9\\operatorname{ln}⁡x+11{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." "Given the function  $y=8{\\log }_{4}⁡x-9\\operatorname{ln}⁡x+11{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}."] [:db/cas 17592186481480 :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8{log}_{4}⁡x-9\\operatorname{ln}⁡x+11{e}^{x}) \\\\  & =\\frac{8}{x\\operatorname{ln}⁡4}-\\frac{9}{x}+11{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{8}{x\\operatorname{ln}⁡4}-\\frac{9}{x}+11{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{8}{1\\cdot \\operatorname{ln}⁡4}-\\frac{9}{1}+11{e}^{1} \\\\  & =\\frac{8}{\\operatorname{ln}⁡4}-9+11e\\,.\\end{aligned}\n$$" "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({\\log }_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\