{d}\\theta " "{\\int }_{-\\pi /8}^{\\pi /4}{\\sin }^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455006 :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " "{\\int }_{-\\pi /8}^{\\pi /4}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455015 :answer/value "4{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " "4{\\int }_{0}^{\\pi /2}{\\cos }^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455059 :answer/value "\\sqrt{6}{\\int }_{0}^{\\pi /4}{cos}^{2}⁡\\theta \\,\\text{d}\\theta " "\\sqrt{6}{\\int }_{0}^{\\pi /4}{\\cos }^{2}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455070 :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " "{\\int }_{0}^{\\pi }{\\cos }^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta "] [:db/cas 17592186455112 :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " "{\\int }_{-\\pi /8}^{\\pi /4}{\\sin }^{2}⁡\\theta {\\cos }^{2}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455151 :answer/value "8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " "8{\\int }_{0}^{\\pi /2}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455201 :answer/value "2\\sqrt{3}{\\int }_{0}^{\\pi /4}{sin}^{2}⁡\\theta \\,\\text{d}\\theta " "2\\sqrt{3}{\\int }_{0}^{\\pi /4}{\\sin }^{2}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455287 :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " "{\\int }_{0}^{\\pi }{\\sin }^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta "] [:db/cas 17592186455291 :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " "{\\int }_{-\\pi /8}^{\\pi /4}{\\sin }^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455325 :answer/value "4{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " "4{\\int }_{0}^{\\pi /2}{\\sin }^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta "] [:db/cas 17592186455436 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{3}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{3}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{3}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{3}\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\sqrt{3}\\operatorname{cos}⁡\\theta )}^{2}-{(\\sqrt{3}\\operatorname{sin}⁡\\theta )}^{2} \\\\  & =3{cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta  \\\\  & =3({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{3})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\sqrt{3})}^{2}+{0}^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}3\\operatorname{cos}⁡2\\theta \\cdot \\sqrt{3}\\cdot \\text{d}\\theta  \\\\  & =3\\sqrt{3}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{3}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{3}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{3}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{3}\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\sqrt{3}\\operatorname{cos}⁡\\theta )}^{2}-{(\\sqrt{3}\\operatorname{sin}⁡\\theta )}^{2} \\\\  & =3{\\cos }^{2}⁡\\theta -3{\\sin }^{2}⁡\\theta  \\\\  & =3({\\cos }^{2}⁡\\theta -{\\sin }^{2}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{3})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\sqrt{3})}^{2}+{0}^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}3\\operatorname{cos}⁡2\\theta \\cdot \\sqrt{3}\\cdot \\text{d}\\theta  \\\\  & =3\\sqrt{3}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186455441 :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3-\\lambda  & -4 \\\\ 2 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-3-\\lambda )-2\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$" "First, we find the eigenvalues of the matrix $A$ by solving $\\det (A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3-\\lambda  & -4 \\\\ 2 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-3-\\lambda )-2\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$"] [:db/cas 17592186455443 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x-y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }-\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta } \\\\  & =(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}{r}^{′}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{\\operatorname{sin}⁡2\\theta }) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot (\\operatorname{cos}⁡2\\theta )\\cdot 2 \\\\  & =\\frac{\\operatorname{cos}⁡2\\theta }{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{\\operatorname{sin}⁡2\\theta +\\frac{{cos}^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡2\\theta +{cos}^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{1}{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}.\\end{aligned}\n$$\n\n   \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /4} \\\\  & =(\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{2}}{2})-(0+1) \\\\  & =\\sqrt{2}-1\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x-y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }-\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta } \\\\  & =(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}{r}^{′}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{\\operatorname{sin}⁡2\\theta }) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot (\\operatorname{cos}⁡2\\theta )\\cdot 2 \\\\  & =\\frac{\\operatorname{cos}⁡2\\theta }{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{\\operatorname{sin}⁡2\\theta +\\frac{{\\cos }^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{{\\sin }^{2}⁡2\\theta +{\\cos }^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{1}{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}.\\end{aligned}\n$$\n\n   \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /4} \\\\  & =(\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{2}}{2})-(0+1) \\\\  & =\\sqrt{2}-1\\end{aligned}\n$$"] [:db/cas 17592186455445 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{1}{{cos}^{2}⁡\\theta } \\\\  & ={sec}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta }{{\\cos }^{2}⁡\\theta } \\\\  & =\\frac{1}{{\\cos }^{2}⁡\\theta } \\\\  & ={\\sec }^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\sec }^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\sec }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$"] [:db/cas 17592186455449 :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(2)=6\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(2)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))\n$$" "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(2)=6\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(2)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$$\n\\displaystyle +{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{2\\pi n}{3}x)+{b}_{n}\\sin \\,(\\frac{2\\pi n}{3}x))\n$$"] [:db/cas 17592186455449 :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))\n$$\n\nNow, we apply the initial condition $y(2)=6.$ Using the hint that the particular solution part evaluates to zero at $x=2,$ we have\n\n$$\n\\begin{aligned}y(2) & =A{e}^{-4(2)}+{y}_{p}(2) \\\\ 6 & =A{e}^{-8}+0 \\\\ A & =6{e}^{8}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(6{e}^{8}){e}^{-4x}=6{e}^{8-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼6{e}^{8-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x)).\n$$" "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{2\\pi n}{3}x)+{b}_{n}\\sin \\,(\\frac{2\\pi n}{3}x))\n$$\n\nNow, we apply the initial condition $y(2)=6.$ Using the hint that the particular solution part evaluates to zero at $x=2,$ we have\n\n$$\n\\begin{aligned}y(2) & =A{e}^{-4(2)}+{y}_{p}(2) \\\\ 6 & =A{e}^{-8}+0 \\\\ A & =6{e}^{8}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(6{e}^{8}){e}^{-4x}=6{e}^{8-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼6{e}^{8-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\cos \\,(\\frac{2\\pi n}{3}x)+{b}_{n}\\sin \\,(\\frac{2\\pi n}{3}x)).\n$$"] [:db/cas 17592186455452 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{sin}⁡\\theta )}^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & ={\\sin }^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={\\sin }^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{\\sin }^{2}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{sin}⁡\\theta )}^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186455453 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$, where $$\n\\displaystyle \\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}.\n$$\n\nNow, if $f(x,y)={y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2} \\\\  & ={sin}^{2}⁡\\theta \\sqrt[3]{{sin}^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{sin}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\cdot \\operatorname{cos}⁡3\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2}+{\\left(\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\right)}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{sin}^{2}⁡3\\theta }+\\frac{{cos}^{2}⁡3\\theta }{\\sqrt[3]{{sin}^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡3\\theta +{sin}^{2}⁡3\\theta }{\\sqrt[3]{{sin}^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{sin}^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{\\pi /4}^{3\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta \\sqrt[3]{{sin}^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}(1-\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{3\\pi }{4}-\\frac{(-1)}{2}-(\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$, where $$\n\\displaystyle \\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}.\n$$\n\nNow, if $f(x,y)={y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2} \\\\  & ={\\sin }^{2}⁡\\theta \\sqrt[3]{{\\sin }^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{sin}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{\\sin }^{2}⁡3\\theta }}\\cdot \\operatorname{cos}⁡3\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{\\sin }^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2}+{\\left(\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{\\sin }^{2}⁡3\\theta }}\\right)}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{\\sin }^{2}⁡3\\theta }+\\frac{{\\cos }^{2}⁡3\\theta }{\\sqrt[3]{{\\sin }^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{\\cos }^{2}⁡3\\theta +{\\sin }^{2}⁡3\\theta }{\\sqrt[3]{{\\sin }^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{\\sin }^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{\\pi /4}^{3\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{\\sin }^{2}⁡\\theta \\sqrt[3]{{\\sin }^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{\\sin }^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{\\sin }^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}(1-\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{3\\pi }{4}-\\frac{(-1)}{2}-(\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$"] [:db/cas 17592186455471 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$, where $$\n\\displaystyle -\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.\n$$\n\nNow, if $f(x,y)={x}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2} \\\\  & ={cos}^{2}⁡\\theta \\sqrt[3]{{cos}^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{cos}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\cdot (-\\operatorname{sin}⁡3\\theta ) \\\\  & =-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2}+{\\left(-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\right)}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{cos}^{2}⁡3\\theta }+\\frac{{sin}^{2}⁡3\\theta }{\\sqrt[3]{{cos}^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡3\\theta +{sin}^{2}⁡3\\theta }{\\sqrt[3]{{cos}^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{cos}^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\sqrt[3]{{cos}^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(1+\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{4}+\\frac{1}{2}-(-\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$, where $$\n\\displaystyle -\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.\n$$\n\nNow, if $f(x,y)={x}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2} \\\\  & ={\\cos }^{2}⁡\\theta \\sqrt[3]{{\\cos }^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{cos}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{\\cos }^{2}⁡3\\theta }}\\cdot (-\\operatorname{sin}⁡3\\theta ) \\\\  & =-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{\\cos }^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2}+{\\left(-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{\\cos }^{2}⁡3\\theta }}\\right)}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{\\cos }^{2}⁡3\\theta }+\\frac{{\\sin }^{2}⁡3\\theta }{\\sqrt[3]{{\\cos }^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{\\cos }^{2}⁡3\\theta +{\\sin }^{2}⁡3\\theta }{\\sqrt[3]{{\\cos }^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{\\cos }^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{\\cos }^{2}⁡\\theta \\sqrt[3]{{\\cos }^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{\\cos }^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{\\cos }^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(1+\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{4}+\\frac{1}{2}-(-\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$"] [:db/cas 17592186455474 :question/worked-solution "Because $f$ is $6$-periodic on $[-3,3]$, we have $L=3$, so Fourier series on this interval use the basis \n\n$$\ncos\\,\\left(\\frac{n\\pi x}{3}\\right)\\,\\text{and}\\,sin\\,\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\n$$" "Because $f$ is $6$-periodic on $[-3,3]$, we have $L=3$, so Fourier series on this interval use the basis \n\n$$\n\\cos \\,\\left(\\frac{n\\pi x}{3}\\right)\\,\\text{and}\\,\\sin \\,\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\n$$"] [:db/cas 17592186455480 :question/problem "$$\n{y}^{″}+2y=f(x),\\,y(0)=-4,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an even, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x)\n$$" "$$\n{y}^{″}+2y=f(x),\\,y(0)=-4,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an even, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=0}^{\\infty }{a}_{n}\\cos \\,(\\frac{n\\pi }{2}x)\n$$"] [:db/cas 17592186455480 :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an even function and the differential operator contains no ${y}^{′}$ (damping) term, the particular solution inherits the symmetry and is also an even function consisting only of cosine terms. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+2=0$ gives roots $\\lambda =\\pm \\sqrt{2}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x)+B\\operatorname{sin}⁡(\\sqrt{2}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\n{y}^{′}(x)∼-A\\sqrt{2}\\operatorname{sin}⁡(\\sqrt{2}x)+B\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}x)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}sin\\,(\\frac{n\\pi }{2}x).\n$$\n\nUsing the derivative condition ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{2}\\operatorname{sin}⁡(0)+B\\sqrt{2}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{2}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we use the condition $y(0)=-4.$ With $B=0,$ the total solution is\n\n$$\ny(x)∼A\\operatorname{cos}⁡(\\sqrt{2}x)+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x).\n$$\n\nApplying $y(0)=-4$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}-4 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =-4-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nSubstituting $A$ back into ${y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{cos}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x)\n$$" "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an even function and the differential operator contains no ${y}^{′}$ (damping) term, the particular solution inherits the symmetry and is also an even function consisting only of cosine terms. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}\\cos \\,(\\frac{n\\pi }{2}x).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+2=0$ gives roots $\\lambda =\\pm \\sqrt{2}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x)+B\\operatorname{sin}⁡(\\sqrt{2}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\n{y}^{′}(x)∼-A\\sqrt{2}\\operatorname{sin}⁡(\\sqrt{2}x)+B\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}x)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}\\sin \\,(\\frac{n\\pi }{2}x).\n$$\n\nUsing the derivative condition ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{2}\\operatorname{sin}⁡(0)+B\\sqrt{2}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{2}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we use the condition $y(0)=-4.$ With $B=0,$ the total solution is\n\n$$\ny(x)∼A\\operatorname{cos}⁡(\\sqrt{2}x)+{\\sum }_{n=0}^{\\infty }{a}_{n}\\cos \\,(\\frac{n\\pi }{2}x).\n$$\n\nApplying $y(0)=-4$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}-4 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =-4-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nSubstituting $A$ back into ${y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{cos}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})+{\\sum }_{n=0}^{\\infty }{a}_{n}\\cos \\,(\\frac{n\\pi }{2}x)\n$$"] [:db/cas 17592186455483 :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+10y=f(x),\\,{y}^{′}(0)=0,\\,{y}^{′}(1)=6\n$$\n\nwhere $f(x)$ is $4$-periodic and odd. Select the missing part in the solution of the BVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}^{′}(0)=0$ and ${y}_{p}^{′}(1)=0.$*\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$" "Consider the boundary value problem\n\n$$\n{y}^{″}+10y=f(x),\\,{y}^{′}(0)=0,\\,{y}^{′}(1)=6\n$$\n\nwhere $f(x)$ is $4$-periodic and odd. Select the missing part in the solution of the BVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}^{′}(0)=0$ and ${y}_{p}^{′}(1)=0.$*\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,\\left(\\frac{n\\pi x}{2}\\right).\n$$"] [:db/cas 17592186455483 :question/worked-solution "We write the solution as $y={y}_{c}+{y}_{p}$, where ${y}_{c}$ solves the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, solve the homogeneous equation ${y}^{″}+10y=0.$ Its general solution is\n\n$$\n{y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{10}x)+B\\operatorname{sin}⁡(\\sqrt{10}x).\n$$\n\nComputing the derivative, we get\n\n$$\n{y}^{′}(x)=-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10}x)+B\\sqrt{10}\\operatorname{cos}⁡(\\sqrt{10}x)+{y}_{p}^{′}(x).\n$$\n\nNow, we use the hint. Since ${y}_{p}^{′}(0)=0$ and ${y}_{p}^{′}(1)=0$, we have\n\n$$\n{y}^{′}(0)={y}_{c}^{′}(0)\\,\\text{and}\\,{y}^{′}(1)={y}_{c}^{′}(1).\n$$\n\nNext, we apply the boundary conditions. \n\n- Use ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =0+B\\sqrt{10}(1)+{y}_{p}^{′}(0) \\\\ 0 & =B\\sqrt{10}+0 \\\\ B & =0\\end{aligned}\n$$\n\nSo, ${y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{10}x).$\n\n- Use ${y}^{′}(1)=6$ with $B=0:$\n\n$$\n\\begin{aligned}{y}^{′}(1) & =-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})+{y}_{p}^{′}(1) \\\\ 6 & =-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})+0 \\\\ A & =-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\operatorname{cos}⁡(\\sqrt{10}x)+{\\sum }_{n=1}^{\\infty }{b}_{n}sin\\,\\left(\\frac{n\\pi x}{2}\\right).\n$$" "We write the solution as $y={y}_{c}+{y}_{p}$, where ${y}_{c}$ solves the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, solve the homogeneous equation ${y}^{″}+10y=0.$ Its general solution is\n\n$$\n{y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{10}x)+B\\operatorname{sin}⁡(\\sqrt{10}x).\n$$\n\nComputing the derivative, we get\n\n$$\n{y}^{′}(x)=-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10}x)+B\\sqrt{10}\\operatorname{cos}⁡(\\sqrt{10}x)+{y}_{p}^{′}(x).\n$$\n\nNow, we use the hint. Since ${y}_{p}^{′}(0)=0$ and ${y}_{p}^{′}(1)=0$, we have\n\n$$\n{y}^{′}(0)={y}_{c}^{′}(0)\\,\\text{and}\\,{y}^{′}(1)={y}_{c}^{′}(1).\n$$\n\nNext, we apply the boundary conditions. \n\n- Use ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =0+B\\sqrt{10}(1)+{y}_{p}^{′}(0) \\\\ 0 & =B\\sqrt{10}+0 \\\\ B & =0\\end{aligned}\n$$\n\nSo, ${y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{10}x).$\n\n- Use ${y}^{′}(1)=6$ with $B=0:$\n\n$$\n\\begin{aligned}{y}^{′}(1) & =-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})+{y}_{p}^{′}(1) \\\\ 6 & =-A\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})+0 \\\\ A & =-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-\\frac{6}{\\sqrt{10}\\operatorname{sin}⁡(\\sqrt{10})}\\operatorname{cos}⁡(\\sqrt{10}x)+{\\sum }_{n=1}^{\\infty }{b}_{n}\\sin \\,\\left(\\frac{n\\pi x}{2}\\right).\n$$"] [:db/cas 17592186455484 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =4{cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=4{cos}^{2}⁡\\theta $ and $y=4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=\\sqrt{x}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{4{cos}^{2}⁡\\theta }\\cdot 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8|\\operatorname{cos}⁡\\theta |\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{cos}⁡\\theta |=\\operatorname{cos}⁡\\theta $ because $0\\le \\theta \\le \\frac{\\pi }{2}⟹\\operatorname{cos}⁡\\theta \\ge 0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(4\\operatorname{cos}⁡\\theta ) \\\\  & =-4\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(4\\operatorname{cos}⁡\\theta )^{2}+(-4\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{16({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =4.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{x}y\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}8{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 4\\cdot \\text{d}\\theta  \\\\  & =32{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡\\theta ,$ $\\text{d}u=-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}32{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =32{\\int }_{1}^{0}-{u}^{2}\\,\\text{d}u \\\\  & =32{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =32\\cdot \\frac{1}{3}{u}^{3}{|}_{0}^{1} \\\\  & =\\frac{32}{3}({1}^{3}-{0}^{3}) \\\\  & =\\frac{32}{3}\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =4{\\cos }^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=4{\\cos }^{2}⁡\\theta $ and $y=4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=\\sqrt{x}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{4{\\cos }^{2}⁡\\theta }\\cdot 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8|\\operatorname{cos}⁡\\theta |\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8{\\cos }^{2}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{cos}⁡\\theta |=\\operatorname{cos}⁡\\theta $ because $0\\le \\theta \\le \\frac{\\pi }{2}⟹\\operatorname{cos}⁡\\theta \\ge 0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(4\\operatorname{cos}⁡\\theta ) \\\\  & =-4\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(4\\operatorname{cos}⁡\\theta )^{2}+(-4\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{16({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )} \\\\  & =4.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{x}y\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}8{\\cos }^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 4\\cdot \\text{d}\\theta  \\\\  & =32{\\int }_{0}^{\\pi /2}{\\cos }^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡\\theta ,$ $\\text{d}u=-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}32{\\int }_{0}^{\\pi /2}{\\cos }^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =32{\\int }_{1}^{0}-{u}^{2}\\,\\text{d}u \\\\  & =32{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =32\\cdot \\frac{1}{3}{u}^{3}{|}_{0}^{1} \\\\  & =\\frac{32}{3}({1}^{3}-{0}^{3}) \\\\  & =\\frac{32}{3}\\end{aligned}\n$$"] [:db/cas 17592186455490 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =1\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $$\n\\displaystyle -\\frac{\\pi }{8}\\le \\theta \\le \\frac{\\pi }{4}.\n$$\n\nNow, if $f(x,y)=xy(1-{x}^{2})$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot (1-{cos}^{2}⁡\\theta ) \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot {sin}^{2}⁡\\theta  \\\\  & ={sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(1)^{2}+{0}^{2}} \\\\  & =\\sqrt{1+0} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /8}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =1\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $$\n\\displaystyle -\\frac{\\pi }{8}\\le \\theta \\le \\frac{\\pi }{4}.\n$$\n\nNow, if $f(x,y)=xy(1-{x}^{2})$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot (1-{\\cos }^{2}⁡\\theta ) \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot {\\sin }^{2}⁡\\theta  \\\\  & ={\\sin }^{3}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(1)^{2}+{0}^{2}} \\\\  & =\\sqrt{1+0} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /8}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{\\sin }^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{\\sin }^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186455497 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2{cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2{cos}^{2}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2{cos}^{2}⁡\\theta \\cdot 2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =4{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\operatorname{cos}⁡\\theta )=-2\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(2\\operatorname{cos}⁡\\theta )^{2}+(-2\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{4({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}4{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2{\\cos }^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2{\\cos }^{2}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2{\\cos }^{2}⁡\\theta \\cdot 2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =4{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\operatorname{cos}⁡\\theta )=-2\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(2\\operatorname{cos}⁡\\theta )^{2}+(-2\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{4({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}4{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi /2}{\\cos }^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186455508 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={cos}^{2}⁡\\theta $ and $y=\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)=(x+y)^{2}$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2} \\\\  & ={(\\operatorname{cos}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ))}^{2} \\\\  & ={cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}.\\end{aligned}\n$$\n\n \n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta .\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={\\cos }^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={\\cos }^{2}⁡\\theta $ and $y=\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)=(x+y)^{2}$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({\\cos }^{2}⁡\\theta +\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2} \\\\  & ={(\\operatorname{cos}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ))}^{2} \\\\  & ={\\cos }^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}.\\end{aligned}\n$$\n\n \n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\cos }^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\cos }^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186455509 :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =3{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=3{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{6}.$\n\nNow, if $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot (3{sin}^{2}⁡\\theta )^{2} \\\\  & =27{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(3\\operatorname{sin}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(3\\operatorname{sin}⁡\\theta )^{2}+(3\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{9({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =3.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /6}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}27{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 3\\cdot \\text{d}\\theta  \\\\  & =81{\\int }_{0}^{\\pi /6}{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}81{\\int }_{0}^{\\pi /6}{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =81{\\int }_{0}^{1/2}{u}^{5}\\,\\text{d}u \\\\  & =81\\cdot \\frac{1}{6}{u}^{6}\\,{|}_{0}^{1/2} \\\\  & =\\frac{27}{2}(\\left(\\frac{1}{2}\\right)^{6}-{0}^{6}) \\\\  & =\\frac{27}{128}\\end{aligned}\n$$" "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =3{\\sin }^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=3{\\sin }^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{6}.$\n\nNow, if $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot (3{\\sin }^{2}⁡\\theta )^{2} \\\\  & =27{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(3\\operatorname{sin}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(3\\operatorname{sin}⁡\\theta )^{2}+(3\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{9({\\sin }^{2}⁡\\theta +{\\cos }^{2}⁡\\theta )} \\\\  & =3.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /6}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}27{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 3\\cdot \\text{d}\\theta  \\\\  & =81{\\int }_{0}^{\\pi /6}{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}81{\\int }_{0}^{\\pi /6}{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =81{\\int }_{0}^{1/2}{u}^{5}\\,\\text{d}u \\\\  & =81\\cdot \\frac{1}{6}{u}^{6}\\,{|}_{0}^{1/2} \\\\  & =\\frac{27}{2}(\\left(\\frac{1}{2}\\right)^{6}-{0}^{6}) \\\\  & =\\frac{27}{128}\\end{aligned}\n$$"] [:db/cas 17592186458663 :answer/value "{\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{9}(1-2{r}^{2}{sin}^{2}⁡\\theta )\\,dr\\,d\\theta " "{\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{9}(1-2{r}^{2}{\\sin }^{2}⁡\\theta )\\,dr\\,d\\theta "] [:db/cas 17592186458759 :answer/value "{\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{9}(1-2{r}^{2}{sin}^{2}⁡\\theta )r\\,dr\\,d\\theta " "{\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{9}(1-2{r}^{2}{\\sin }^{2}⁡\\theta )r\\,dr\\,d\\theta "] [:db/cas 17592186458767 :answer/value "{\\int }_{0}^{3\\pi /2}\\,{\\int }_{0}^{9}(1-2{r}^{2}{sin}^{2}⁡\\theta )r\\,dr\\,d\\theta " "{\\int }_{0}^{3\\pi /2}\\,{\\int }_{0}^{9}(1-2{r}^{2}{\\sin }^{2}⁡\\theta )r\\,dr\\,d\\theta "] [:db/cas 17592186459223 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/f3/f393d0facc98fe365e2c622e24223d6045b48b490937ba6e2f25d86d7eb4810f.png)\n\nNow, since \n\n$$\nP(x,y)={e}^{x}-8{x}^{2}y,\\,Q(x,y)={y}^{7}+8x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-8{x}^{2},\\,\\frac{∂Q}{∂x}=8{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x}-8{x}^{2}y)dx+({y}^{7}+8x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(8{y}^{2}-(-8{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}8({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}[2{r}^{4}]_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}32\\,\\text{d}\\theta  \\\\  & =32[\\theta ]_{-\\pi /2}^{0} \\\\  & =32\\cdot \\frac{\\pi }{2} \\\\  & =16\\pi .\\end{aligned}\n$$" "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/f3/f393d0facc98fe365e2c622e24223d6045b48b490937ba6e2f25d86d7eb4810f.png)\n\nNow, since \n\n$$\nP(x,y)={e}^{x}-8{x}^{2}y,\\,Q(x,y)={y}^{7}+8x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-8{x}^{2},\\,\\frac{∂Q}{∂x}=8{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x}-8{x}^{2}y)dx+({y}^{7}+8x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(8{y}^{2}-(-8{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}8({r}^{2}{\\cos }^{2}⁡\\theta +{r}^{2}{\\sin }^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}[2{r}^{4}]_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}32\\,\\text{d}\\theta  \\\\  & =32[\\theta ]_{-\\pi /2}^{0} \\\\  & =32\\cdot \\frac{\\pi }{2} \\\\  & =16\\pi .\\end{aligned}\n$$"] [:db/cas 17592186460983 :answer-field/key "$y(x)={sin}^{2}⁡(2x)$" "$y(x)={\\sin }^{2}⁡(2x)$"] [:db/cas 17592186461046 :answer-field/key "${\\int }_{-2}^{2}{sin}^{2}⁡x\\,\\text{d}x$" "${\\int }_{-2}^{2}{\\sin }^{2}⁡x\\,\\text{d}x$"] [:db/cas 17592186461070 :answer-field/key "${a}_{11}=-1$ and $det(A)>0$" "${a}_{11}=-1$ and $\\det (A)>0$"] [:db/cas 17592186462613 :answer-field/key "${\\int }_{-\\pi /2}^{\\pi /4}{sin}^{5}⁡x\\,\\text{d}x$" "${\\i