\sinh^2 x} \\, \\textrm{d}x.\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $$\n\\displaystyle{\\int} \\dfrac{1}{1+\\sinh^2 x} \\, \\textrm{d}x.\n$$"] [:db/cas 17592186166634 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$First, we find the hyperbolic identity that corresponds to the secant-tangent identity \n\n$$\n1 + \\tan^2 x= \\sec^2{x}.\n$$\n\nUsing Osborn's rule, we get the hyperbolic secant-tangent identity\n\n$$\n1-\\tanh^2x=\\sech^2{x}.\n$$\n\nUsing the above, we rewrite the integral and evaluate it as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{\\operatorname{tanh}⁡x-{tanh}^{3}⁡x}{\\operatorname{sech}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{(1-{tanh}^{2}⁡x)\\operatorname{tanh}⁡x}{\\operatorname{sech}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{{sech}^{2}⁡x\\operatorname{tanh}⁡x}{\\operatorname{sech}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{sech}⁡x\\,{|}_{0}^{\\operatorname{ln}⁡2} \\\\  & =-\\operatorname{sech}⁡(\\operatorname{ln}⁡2)+\\operatorname{sech}⁡0 \\\\  & =-\\frac{2}{{e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}}+\\frac{2}{{e}^{0}+{e}^{0}} \\\\  & =-\\frac{2}{(2+\\frac{1}{2})}+1 \\\\  & =-\\frac{2}{\\left(\\frac{5}{2}\\right)}+1 \\\\  & =-\\frac{4}{5}+1 \\\\  & =\\frac{1}{5}\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$First, we find the hyperbolic identity that corresponds to the secant-tangent identity \n\n$$\n1 + \\tan^2 x= \\sec^2{x}.\n$$\n\nUsing Osborn's rule, we get the hyperbolic secant-tangent identity\n\n$$\n1-\\tanh^2x=\\operatorname{sech} ^2{x}.\n$$\n\nUsing the above, we rewrite the integral and evaluate it as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{\\operatorname{tanh}⁡x-{\\tanh }^{3}⁡x}{\\operatorname{sech}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{(1-{\\tanh }^{2}⁡x)\\operatorname{tanh}⁡x}{\\operatorname{sech}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{{\\operatorname{sech} }^{2}⁡x\\operatorname{tanh}⁡x}{\\operatorname{sech}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{sech}⁡x\\,{|}_{0}^{\\operatorname{ln}⁡2} \\\\  & =-\\operatorname{sech}⁡(\\operatorname{ln}⁡2)+\\operatorname{sech}⁡0 \\\\  & =-\\frac{2}{{e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}}+\\frac{2}{{e}^{0}+{e}^{0}} \\\\  & =-\\frac{2}{(2+\\frac{1}{2})}+1 \\\\  & =-\\frac{2}{\\left(\\frac{5}{2}\\right)}+1 \\\\  & =-\\frac{4}{5}+1 \\\\  & =\\frac{1}{5}\\end{aligned}\n$$"] [:db/cas 17592186166634 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$Evaluate $$\n\\displaystyle \\int_{0}^{\\ln 2} \\dfrac{\\tanh{x}-\\tanh^3{x}}{\\sech{x}} \\, \\textrm{d}x.\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$Evaluate $$\n\\displaystyle \\int_{0}^{\\ln 2} \\dfrac{\\tanh{x}-\\tanh^3{x}}{\\operatorname{sech} {x}} \\, \\textrm{d}x.\n$$"] [:db/cas 17592186166635 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$Evaluate $$\n\\displaystyle \\int_{\\ln 3}^{\\ln 6} \\dfrac{\\csch{x}}{\\coth^2{x} - 1} \\, \\textrm{d}x.\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$Evaluate $$\n\\displaystyle \\int_{\\ln 3}^{\\ln 6} \\dfrac{\\operatorname{csch} {x}}{\\coth^2{x} - 1} \\, \\textrm{d}x.\n$$"] [:db/cas 17592186166635 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the cosecant-cotangent identity \n\n$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n1 + \\cot^2 x= \\csc^2{x}.\n$$\n\nUsing Osborn's rule, we get the hyperbolic cosecant-cotangent identity\n\n$$\n\\coth^2x - 1=\\csch^2{x}.\n$$\n\nUsing the above, we rewrite the integral and evaluate it, as follows:\n\n$$\n\\begin{aligned}\n\t\t\\int_{\\ln 3}^{\\ln 6} \\dfrac{\\csch{x}}{\\coth^2{x} - 1} \\, \\textrm{d}x\n\t\t\t&= \\int_{\\ln 3}^{\\ln 6} \\dfrac{\\csch{x}}{\\csch^2{x}} \\, \\textrm{d}x \\\\[5pt]\n\t\t\t&= \\int_{\\ln 3}^{\\ln 6} \\sinh{x} \\, \\textrm{d}x \\\\[5pt]\n\t\t\t&= \\cosh{x} \\Big|_{\\ln 3}^{\\ln 6}\\\\[5pt]\n\t\t\t&= \\cosh(\\ln 6) - \\cosh(\\ln 3)\\\\[5pt]\n\t\t\t&= \\left(\\dfrac{e^{\\ln 6}+e^{-\\ln 6}}{2}\\right) - \\left(\\dfrac{e^{\\ln 3}+e^{-\\ln 3}}{2}\\right)\\\\[5pt]\n\t\t\t&= \\left(\\dfrac{6 + \\dfrac{1}{6}}{2}\\right) - \\left(\\dfrac{3 + \\dfrac{1}{3}}{2}\\right)\\\\[5pt]\n\t\t\t&= \\dfrac{37}{12} - \\dfrac{5}{3}\\\\[5pt]\n\t\t\t&= \\dfrac{37}{12} - \\dfrac{20}{12} \\\\[5pt]\n            &= \\dfrac{17}{12}\n\t\\end{aligned}\n$$" "First, we find the hyperbolic identity that corresponds to the cosecant-cotangent identity \n\n$$\n\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n1 + \\cot^2 x= \\csc^2{x}.\n$$\n\nUsing Osborn's rule, we get the hyperbolic cosecant-cotangent identity\n\n$$\n\\coth^2x - 1=\\operatorname{csch} ^2{x}.\n$$\n\nUsing the above, we rewrite the integral and evaluate it, as follows:\n\n$$\n\\begin{aligned}\n\t\t\\int_{\\ln 3}^{\\ln 6} \\dfrac{\\operatorname{csch} {x}}{\\coth^2{x} - 1} \\, \\textrm{d}x\n\t\t\t&= \\int_{\\ln 3}^{\\ln 6} \\dfrac{\\operatorname{csch} {x}}{\\operatorname{csch} ^2{x}} \\, \\textrm{d}x \\\\[5pt]\n\t\t\t&= \\int_{\\ln 3}^{\\ln 6} \\sinh{x} \\, \\textrm{d}x \\\\[5pt]\n\t\t\t&= \\cosh{x} \\Big|_{\\ln 3}^{\\ln 6}\\\\[5pt]\n\t\t\t&= \\cosh(\\ln 6) - \\cosh(\\ln 3)\\\\[5pt]\n\t\t\t&= \\left(\\dfrac{e^{\\ln 6}+e^{-\\ln 6}}{2}\\right) - \\left(\\dfrac{e^{\\ln 3}+e^{-\\ln 3}}{2}\\right)\\\\[5pt]\n\t\t\t&= \\left(\\dfrac{6 + \\dfrac{1}{6}}{2}\\right) - \\left(\\dfrac{3 + \\dfrac{1}{3}}{2}\\right)\\\\[5pt]\n\t\t\t&= \\dfrac{37}{12} - \\dfrac{5}{3}\\\\[5pt]\n\t\t\t&= \\dfrac{37}{12} - \\dfrac{20}{12} \\\\[5pt]\n            &= \\dfrac{17}{12}\n\t\\end{aligned}\n$$"] [:db/cas 17592186166636 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$First, we find the hyperbolic identity that corresponds to the Pythagorean identity\n\n$$\n\\cos^2 \\theta + \\sin^2 \\theta = 1.\n$$\n\nUsing Osborn's rule, we get the hyperbolic Pythagorean identity\n\n$$\n\\cosh^2 \\theta - \\sinh^2 \\theta = 1.\n$$\n\nSetting $\\theta = 2x + 1,$ we get \n\n$$\n\\cosh^2 (2x+1) - \\sinh^2(2x+1) = 1\n$$\n\nwhich can be written as\n\n$$\n\\cosh^2 (2x+1) -1 = \\sinh^2(2x+1).\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{2}{{cosh}^{2}⁡(2x+1)-1}\\,\\text{d}x & =2\\int \\frac{1}{{sinh}^{2}⁡(2x+1)}\\,\\text{d}x \\\\  & =2\\int {csch}^{2}⁡(2x+1)\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡(2x+1)+C.\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$First, we find the hyperbolic identity that corresponds to the Pythagorean identity\n\n$$\n\\cos^2 \\theta + \\sin^2 \\theta = 1.\n$$\n\nUsing Osborn's rule, we get the hyperbolic Pythagorean identity\n\n$$\n\\cosh^2 \\theta - \\sinh^2 \\theta = 1.\n$$\n\nSetting $\\theta = 2x + 1,$ we get \n\n$$\n\\cosh^2 (2x+1) - \\sinh^2(2x+1) = 1\n$$\n\nwhich can be written as\n\n$$\n\\cosh^2 (2x+1) -1 = \\sinh^2(2x+1).\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{2}{{\\cosh }^{2}⁡(2x+1)-1}\\,\\text{d}x & =2\\int \\frac{1}{{\\sinh }^{2}⁡(2x+1)}\\,\\text{d}x \\\\  & =2\\int {\\operatorname{csch} }^{2}⁡(2x+1)\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡(2x+1)+C.\\end{aligned}\n$$"] [:db/cas 17592186166636 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$Calculate $$\n\\displaystyle{\\int \\dfrac{2}{\\cosh^2(2x+1)-1} \\, \\textrm{d}x}.\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$Calculate $$\n\\displaystyle{\\int \\dfrac{2}{\\cosh^2(2x+1)-1} \\, \\textrm{d}x}.\n$$"] [:db/cas 17592186166641 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\cos{2x}= \\cos^2{x}-\\sin^2{x}\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\cosh 2x = \\cosh^2{x} + \\sinh^2{x}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int {cosh}^{2}⁡x+{sinh}^{2}⁡x\\,\\text{d}x & =\\int \\operatorname{cosh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{sinh}⁡2x+C.\\end{aligned}\n$$" "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\cos{2x}= \\cos^2{x}-\\sin^2{x}\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\cosh 2x = \\cosh^2{x} + \\sinh^2{x}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int {\\cosh }^{2}⁡x+{\\sinh }^{2}⁡x\\,\\text{d}x & =\\int \\operatorname{cosh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{sinh}⁡2x+C.\\end{aligned}\n$$"] [:db/cas 17592186166642 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\cos{2x} =2\\cos^2 x -1.\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\cosh{2x} =2\\cosh^2 x -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n\\cosh^2 x = \\dfrac{1}{2} \\left(\\cosh 2x +1 \\right).\n$$\n\nSubstituting this into our integral, we get\n\