}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\coth  (-\\ln 3).$"] [:db/cas 17592186166650 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\coth x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(-\\operatorname{ln}⁡3) & =\\frac{1+{e}^{-2(-\\operatorname{ln}⁡3)}}{1-{e}^{-2(-\\operatorname{ln}⁡3)}} \\\\  & =\\frac{1+{e}^{2\\operatorname{ln}⁡3}}{1-{e}^{2\\operatorname{ln}⁡3}} \\\\  & =\\frac{1+{e}^{\\operatorname{ln}⁡{3}^{2}}}{1-{e}^{\\operatorname{ln}⁡{3}^{2}}} \\\\  & =\\frac{1+{3}^{2}}{1-{3}^{2}} \\\\  & =\\frac{1+9}{1-9} \\\\  & =\\frac{10}{(-8)} \\\\  & =-\\frac{5}{4}.\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\coth x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(-\\operatorname{ln}⁡3) & =\\frac{1+{e}^{-2(-\\operatorname{ln}⁡3)}}{1-{e}^{-2(-\\operatorname{ln}⁡3)}} \\\\  & =\\frac{1+{e}^{2\\operatorname{ln}⁡3}}{1-{e}^{2\\operatorname{ln}⁡3}} \\\\  & =\\frac{1+{e}^{\\operatorname{ln}⁡{3}^{2}}}{1-{e}^{\\operatorname{ln}⁡{3}^{2}}} \\\\  & =\\frac{1+{3}^{2}}{1-{3}^{2}} \\\\  & =\\frac{1+9}{1-9} \\\\  & =\\frac{10}{(-8)} \\\\  & =-\\frac{5}{4}.\\end{aligned}\n$$"] [:db/cas 17592186166674 :question/worked-solution "The normal component of acceleration is given by\n\n$$\na_N = \\dfrac{||\\mathbf v \\times \\mathbf a||}{||\\mathbf v||}.\n$$\n\nFirst, we compute the acceleration vector by differentiating the velocity vector, as follows:\n\n$$\n\\begin{aligned}a & =⟨\\frac{\\text{d}}{\\text{d}t}(-4),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(2t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))⟩ \\\\  & =⟨0,\\,-2\\operatorname{sin}⁡(2t),\\,2\\operatorname{cos}⁡(2t)⟩\\end{aligned}\n$$\n\nNext, we compute $\\mathbf v \\times \\mathbf a{:}$\n\n$$\n\\begin{aligned}v\\times a & =⟨-4,\\,\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(2t)⟩\\times ⟨0,\\,-2\\operatorname{sin}⁡(2t),\\,2\\operatorname{cos}⁡(2t)⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ -4 & \\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ 0 & -2\\operatorname{sin}⁡(2t) & 2\\operatorname{cos}⁡(2t)\\end{vmatrix} \\\\  & =\\text{ }\\begin{vmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -2\\operatorname{sin}⁡(2t) & 2\\operatorname{cos}⁡(2t)\\end{vmatrix}\\,i-\\begin{vmatrix}-4 & \\operatorname{sin}⁡(2t) \\\\ 0 & 2\\operatorname{cos}⁡(2t)\\end{vmatrix}\\,j+\\begin{vmatrix}-4 & \\operatorname{cos}⁡(2t) \\\\ 0 & -2\\operatorname{sin}⁡(2t)\\end{vmatrix}\\,k \\\\  & =⟨2{cos}^{2}⁡(2t)+2{sin}^{2}⁡(2t),8\\operatorname{cos}⁡(2t),8\\operatorname{sin}⁡(2t)⟩ \\\\  & =⟨2,8\\operatorname{cos}⁡(2t),8\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$\n\nNow, we compute $||\\mathbf v||$ and $||\\mathbf v \\times \\mathbf a||\\mathbin{:}$\n\n$$\n\\begin{aligned}||v|| & =\\sqrt{{(-4)}^{2}+{(\\operatorname{cos}⁡(2t))}^{2}+{(\\operatorname{sin}⁡(2t))}^{2}} \\\\  & =\\sqrt{16+{cos}^{2}⁡(2t)+{sin}^{2}⁡(2t)} \\\\  & =\\sqrt{16+1} \\\\  & =\\sqrt{17}, \\\\ ||v\\times a|| & =\\sqrt{{(2)}^{2}+{(8\\operatorname{cos}⁡(2t))}^{2}+{(8\\operatorname{sin}⁡(2t))}^{2}} \\\\  & =\\sqrt{4+64{cos}^{2}⁡(2t)+64{sin}^{2}⁡(2t)} \\\\  & =\\sqrt{4+64({cos}^{2}⁡(2t)+{sin}^{2}⁡(2t))} \\\\  & =\\sqrt{4+64} \\\\  & =\\sqrt{68} \\\\  & =2\\sqrt{17}\\end{aligned}\n$$\n\nFinally, we calculate the normal component of the acceleration, and we get\n\n$$\n\\begin{aligned}{a}_{N} & =\\frac{||v\\times a||}{||v||} \\\\  & =\\frac{2\\sqrt{17}}{\\sqrt{17}} \\\\  & =2.\\end{aligned}\n$$" "The normal component of acceleration is given by\n\n$$\na_N = \\dfrac{||\\mathbf v \\times \\mathbf a||}{||\\mathbf v||}.\n$$\n\nFirst, we compute the acceleration vector by differentiating the velocity vector, as follows:\n\n$$\n\\begin{aligned}a & =⟨\\frac{\\text{d}}{\\text{d}t}(-4),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(2t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))⟩ \\\\  & =⟨0,\\,-2\\operatorname{sin}⁡(2t),\\,2\\operatorname{cos}⁡(2t)⟩\\end{aligned}\n$$\n\nNext, we compute $\\mathbf v \\times \\mathbf a{:}$\n\n$$\n\\begin{aligned}v\\times a & =⟨-4,\\,\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(2t)⟩\\times ⟨0,\\,-2\\operatorname{sin}⁡(2t),\\,2\\operatorname{cos}⁡(2t)⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ -4 & \\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ 0 & -2\\operatorname{sin}⁡(2t) & 2\\operatorname{cos}⁡(2t)\\end{vmatrix} \\\\  & =\\text{ }\\begin{vmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -2\\operatorname{sin}⁡(2t) & 2\\operatorname{cos}⁡(2t)\\end{vmatrix}\\,i-\\begin{vmatrix}-4 & \\operatorname{sin}⁡(2t) \\\\ 0 & 2\\operatorname{cos}⁡(2t)\\end{vmatrix}\\,j+\\begin{vmatrix}-4 & \\operatorname{cos}⁡(2t) \\\\ 0 & -2\\operatorname{sin}⁡(2t)\\end{vmatrix}\\,k \\\\  & =⟨2{\\cos }^{2}⁡(2t)+2{\\sin }^{2}⁡(2t),8\\operatorname{cos}⁡(2t),8\\operatorname{sin}⁡(2t)⟩ \\\\  & =⟨2,8\\operatorname{cos}⁡(2t),8\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$\n\nNow, we compute $||\\mathbf v||$ and $||\\mathbf v \\times \\mathbf a||\\mathbin{:}$\n\n$$\n\\begin{aligned}||v|| & =\\sqrt{{(-4)}^{2}+{(\\operatorname{cos}⁡(2t))}^{2}+{(\\operatorname{sin}⁡(2t))}^{2}} \\\\  & =\\sqrt{16+{\\cos }^{2}⁡(2t)+{\\sin }^{2}⁡(2t)} \\\\  & =\\sqrt{16+1} \\\\  & =\\sqrt{17}, \\\\ ||v\\times a|| & =\\sqrt{{(2)}^{2}+{(8\\operatorname{cos}⁡(2t))}^{2}+{(8\\operatorname{sin}⁡(2t))}^{2}} \\\\  & =\\sqrt{4+64{\\cos }^{2}⁡(2t)+64{\\sin }^{2}⁡(2t)} \\\\  & =\\sqrt{4+64({\\cos }^{2}⁡(2t)+{\\sin }^{2}⁡(2t))} \\\\  & =\\sqrt{4+64} \\\\  & =\\sqrt{68} \\\\  & =2\\sqrt{17}\\end{aligned}\n$$\n\nFinally, we calculate the normal component of the acceleration, and we get\n\n$$\n\\begin{aligned}{a}_{N} & =\\frac{||v\\times a||}{||v||} \\\\  & =\\frac{2\\sqrt{17}}{\\sqrt{17}} \\\\  & =2.\\end{aligned}\n$$"] [:db/cas 17592186166679 :question/worked-solution "The binormal vector is given by\n\n$$\n\\mathbf B(t) = \\mathbf T(t) \\times \\mathbf N(t),\n$$\n\nwhere the principal normal vector $\\mathbf N(t)$ is given by\n\n$$\n\\mathbf N(t)= \\dfrac{\\mathbf T'(t)}{\\|\\mathbf T'(t)\\|}.\n$$\n\nFirst, we find the principal normal $\\mathbf{N}(t).$ To do this, we calculate $\\mathbf T'(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{5}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡4t),\\,\\frac{\\text{d}}{\\text{d}t}(2),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡4t)⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨4\\operatorname{cos}⁡4t,\\,0,\\,-4\\operatorname{sin}⁡4t⟩ \\\\  & =\\frac{4}{\\sqrt{5}}⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{5}}\\sqrt{(4\\operatorname{cos}⁡4t)^{2}+{0}^{2}+{(-4\\operatorname{sin}⁡4t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16{cos}^{2}⁡4t+16{sin}^{2}⁡4t} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16({cos}^{2}⁡4t+{sin}^{2}⁡4t)} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16} \\\\  & =\\frac{4}{\\sqrt{5}}\\end{aligned}\n$$\n\nNow, we normalize $\\mathbf T'(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{\\frac{4}{\\sqrt{5}}⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩}{\\left(\\frac{4}{\\sqrt{5}}\\right)} \\\\  & =⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{5}}⟨\\operatorname{sin}⁡4t,2,\\operatorname{cos}⁡4t⟩\\times ⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩ \\\\  & =\\frac{1}{\\sqrt{5}}\\,\\begin{vmatrix}i & j & k \\\\ \\operatorname{sin}⁡4t & 2 & \\operatorname{cos}⁡4t \\\\ \\operatorname{cos}⁡4t & 0 & -\\operatorname{sin}⁡4t\\end{vmatrix} \\\\  & =\\frac{1}{\\sqrt{5}}\\left[\\text{ }\\begin{vmatrix}2 & \\operatorname{cos}⁡4t \\\\ 0 & -\\operatorname{sin}⁡4t\\end{vmatrix}\\,i-\\begin{vmatrix}\\operatorname{sin}⁡4t & \\operatorname{cos}⁡4t \\\\ \\operatorname{cos}⁡4t & -\\operatorname{sin}⁡4t\\end{vmatrix}\\,j+\\begin{vmatrix}\\operatorname{sin}⁡4t & 2 \\\\ \\operatorname{cos}⁡4t & 0\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{\\sqrt{5}}⟨-2\\operatorname{sin}⁡4t-0,-(-{sin}^{2}⁡4t-{cos}^{2}⁡4t),0-2\\operatorname{cos}⁡4t⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨-2\\operatorname{sin}⁡4t,\\,1,\\,-2\\operatorname{cos}⁡4t⟩\\end{aligned}\n$$" "The binormal vector is given by\n\n$$\n\\mathbf B(t) = \\mathbf T(t) \\times \\mathbf N(t),\n$$\n\nwhere the principal normal vector $\\mathbf N(t)$ is given by\n\n$$\n\\mathbf N(t)= \\dfrac{\\mathbf T'(t)}{\\|\\mathbf T'(t)\\|}.\n$$\n\nFirst, we find the principal normal $\\mathbf{N}(t).$ To do this, we calculate $\\mathbf T'(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{5}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡4t),\\,\\frac{\\text{d}}{\\text{d}t}(2),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡4t)⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨4\\operatorname{cos}⁡4t,\\,0,\\,-4\\operatorname{sin}⁡4t⟩ \\\\  & =\\frac{4}{\\sqrt{5}}⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{5}}\\sqrt{(4\\operatorname{cos}⁡4t)^{2}+{0}^{2}+{(-4\\operatorname{sin}⁡4t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16{\\cos }^{2}⁡4t+16{\\sin }^{2}⁡4t} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16({\\cos }^{2}⁡4t+{\\sin }^{2}⁡4t)} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16} \\\\  & =\\frac{4}{\\sqrt{5}}\\end{aligned}\n$$\n\nNow, we normalize $\\mathbf T'(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{\\frac{4}{\\sqrt{5}}⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩}{\\left(\\frac{4}{\\sqrt{5}}\\right)} \\\\  & =⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{5}}⟨\\operatorname{sin}⁡4t,2,\\operatorname{cos}⁡4t⟩\\times ⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩ \\\\  & =\\frac{1}{\\sqrt{5}}\\,\\begin{vmatrix}i & j & k \\\\ \\operatorname{sin}⁡4t & 2 & \\operatorname{cos}⁡4t \\\\ \\operatorname{cos}⁡4t & 0 & -\\operatorname{sin}⁡4t\\end{vmatrix} \\\\  & =\\frac{1}{\\sqrt{5}}\\left[\\text{ }\\begin{vmatrix}2 & \\operatorname{cos}⁡4t \\\\ 0 & -\\operatorname{sin}⁡4t\\end{vmatrix}\\,i-\\begin{vmatrix}\\operatorname{sin}⁡4t & \\operatorname{cos}⁡4t \\\\ \\operatorname{cos}⁡4t & -\\operatorname{sin}⁡4t\\end{vmatrix}\\,j+\\begin{vmatrix}\\operatorname{sin}⁡4t & 2 \\\\ \\operatorname{cos}⁡4t & 0\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{\\sqrt{5}}⟨-2\\operatorname{sin}⁡4t-0,-(-{\\sin }^{2}⁡4t-{\\cos }^{2}⁡4t),0-2\\operatorname{cos}⁡4t⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨-2\\operatorname{sin}⁡4t,\\,1,\\,-2\\operatorname{cos}⁡4t⟩\\end{aligned}\n$$"] [:db/cas 17592186166722 :question/problem "Which of the following statements are true regarding the function\n$$\n\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\sech{x}\n$$?\n\n1. The function is increasing over $(0, \\infty)$.\n2. The function has a vertical asymptote.\n3. The domain of the function is $(-\\infty, 0) \\cup (0, \\infty)$." "Which of the following statements are true regarding the function\n$$\n\\displaystyle \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\operatorname{sech} {x}\n$$?\n\n1. The function is increasing over $(0, \\infty)$.\n2. The function has a vertical asymptote.\n3. The domain of the function is $(-\\infty, 0) \\cup (0, \\infty)$."] [:db/cas 17592186166722 :question/worked-solution "Let's recall the graph of\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\sech{x}\n$$\n\n![](images/e6/e68bcc4e3c81b645bc57046f633f1f2cce8e0a550aca7ce9ece42f778db31f44.png)\n\nLet's now examine our statements in turn.\n\n- Statement I is false. The function $y=\\sech x$ is decreasing over $(0, \\infty)$.\n- Statement II is false. The function has no vertical asymptotes.\n- Statement III is false. The domain of the function is $(-\\infty, \\infty)$.\n\nTherefore, none of the statements are true." "Let's recall the graph of\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\operatorname{sech} {x}\n$$\n\n![](images/e6/e68bcc4e3c81b645bc57046f633f1f2cce8e0a550aca7ce9ece42f778db31f44.png)\n\nLet's now examine our statements in turn.\n\n- Statement I is false. The function $y=\\operatorname{sech}  x$ is decreasing over $(0, \\infty)$.\n- Statement II is false. The function has no vertical asymptotes.\n- Statement III is false. The domain of the function is $(-\\infty, \\infty)$.\n\nTherefore, none of the statements are true."] [:db/cas 17592186166723 :question/problem "Which of the following statements are true regarding the function\n$$\n\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\csch{x}\n$$?\n\n1. The function has no zeros.\n2. $\\csch{x} \\to -\\infty$ as $x \\to 0^-$.\n3. The function is even." "Which of the following statements are true regarding the function\n$$\n\\displaystyle \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\operatorname{csch} {x}\n$$?\n\n1. The function has no zeros.\n2. $\\operatorname{csch} {x} \\to -\\infty$ as $x \\to 0^-$.\n3. The function is even."] [:db/cas 17592186166723 :question/worked-solution "Let's recall the graph of\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\csch{x}\n$$\n\n![](images/2e/2e67e1e48ecad04a570bc17b4b4b6a63479c75cd9c2685bfc43a7739de10f0a4.png)\n\nLet's now examine our statements in turn.\n\n- Statement I is true. The function $y=\\csch{x}$ has no zeros.\n- Statement II is true. Indeed, we have that $\\csch{x} \\to -\\infty$ as $x \\to 0^-$.\n- Statement III is false. The function is odd (the graph has rotational symmetry of order $2$ about the origin).\n\nTherefore, only I and II are true." "Let's recall the graph of\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\operatorname{csch} {x}\n$$\n\n![](images/2e/2e67e1e48ecad04a570bc17b4b4b6a63479c75cd9c2685bfc43a7739de10f0a4.png)\n\nLet's now examine our statements in turn.\n\n- Statement I is true. The function $y=\\operatorname{csch} {x}$ has no zeros.\n- Statement II is true. Indeed, we have that $\\operatorname{csch} {x} \\to -\\infty$ as $x \\to 0^-$.\n- Statement III is false. The function is odd (the graph has rotational symmetry of order $2$ about the origin).\n\nTherefore, only I and II are true."] [:db/cas 17592186166724 :question/problem "Which of the following statements are true regarding the function\n$$\n\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\coth{x}\n$$?\n\n1. The function has a zero at $x=0$.\n2. $\\coth{x} \\to 1$ as $x \\to \\infty$.\n3. The range of the function is $(0, \\infty)$." "Which of the following statements are true regarding the function\n$$\n\\displaystyle \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\coth{x}\n$$?\n\n1. The function has a zero at $x=0$.\n2. $\\coth{x} \\to 1$ as $x \\to \\infty$.\n3. The range of the function is $(0, \\infty)$."] [:db/cas 17592186166724 :question/worked-solution "Let's recall the graph of\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\coth{x}\n$$\n\n![](images/00/00b3a3a57f32b0ed97ab4ccbba0d6c90be16d7dfa85bbb4d25703a8e2967d26b.png)\n\nLet's now examine our statements in turn.\n\n- Statement I is false. The function does not have zeros in its domain.\n- Statement II is true. Indeed, we have that $\\coth{x} \\to 1$ as $x \\to \\infty$.\n- Statement III is false. The range of the function is $(-\\infty, -1) \\cup (1, \\infty)$.\n\nTherefore, the correct answer is \"II only.\"" "Let's recall the graph of\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}y=\\coth{x}\n$$\n\n![](images/00/00b3a3a57f32b0ed97ab4ccbba0d6c90be16d7dfa85bbb4d25703a8e2967d26b.png)\n\nLet's now examine our statements in turn.\n\n- Statement I is false. The function does not have zeros in its domain.\n- Statement II is true. Indeed, we have that $\\coth{x} \\to 1$ as $x \\to \\infty$.\n- Statement III is false. The range of the function is $(-\\infty, -1) \\cup (1, \\infty)$.\n\nTherefore, the correct answer is \"II only.\""] [:db/cas 17592186166725 :question/problem "$\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n       \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}$Find a hyperbolic identity that corresponds to the trigonometric identity $1 + \\cot^2{x} = \\csc^2{x}.$" "$\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n       \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}$Find a hyperbolic identity that corresponds to the trigonometric identity $1 + \\cot^2{x} = \\csc^2{x}.$"] [:db/cas 17592186166725 :question/worked-solution "$\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n       \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}$Osborn's rule allows us to construct a hyperbolic identity from a corresponding trigonometric identity.\n\nTo apply Osborn's rule, we follow two steps:\n\n1\\. Replace every trigonometric function with its corresponding hyperbolic function.\n\n2\\. For any product of two trigonometric sines, flip the sign of the corresponding product of hyperbolic sines.\n\nWe're given the following trigonometric identity:\n\n$$\n1 + \\cot^2{x} = \\csc^2{x}\n$$\n\nNotice that \n\n$$\n\\cot^2{x} = \\dfrac{\\cos^2{x}}{\\sin^2{x}} \\qquad \\textrm{and} \\qquad \\csc^2{x} = \\dfrac{1}{\\sin^2{x}}\n$$\n\nand thus, we have two products of sines. Therefore, the corresponding hyperbolic identity is \n\n$$\n1 \\,{\\mathbf{\\color{red}{-}}}\\, \\coth^2{x} = {\\mathbf{\\color{red}{-}}}\\,\\csch^2{x}.\n$$" "$\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n       \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}$Osborn's rule allows us to construct a hyperbolic identity from a corresponding trigonometric identity.\n\nTo apply Osborn's rule, we follow two steps:\n\n1\\. Replace every trigonometric function with its corresponding hyperbolic function.\n\n2\\. For any product of two trigonometric sines, flip the sign of the corresponding product of hyperbolic sines.\n\nWe're given the following trigonometric identity:\n\n$$\n1 + \\cot^2{x} = \\csc^2{x}\n$$\n\nNotice that \n\n$$\n\\cot^2{x} = \\dfrac{\\cos^2{x}}{\\sin^2{x}} \\qquad \\textrm{and} \\qquad \\csc^2{x} = \\dfrac{1}{\\sin^2{x}}\n$$\n\nand thus, we have two products of sines. Therefore, the corresponding hyperbolic identity is \n\n$$\n1 \\,{\\mathbf{\\color{red}{-}}}\\, \\coth^2{x} = {\\mathbf{\\color{red}{-}}}\\,\\operatorname{csch} ^2{x}.\n$$"] [:db/cas 17592186167074 :question/problem "Given that $X∼Exp\\left(\\frac{1}{2}\\right)$, what is $E[X]$?" "Given that $X∼\\operatorname{Exp} \\left(\\frac{1}{2}\\right)$, what is $E[X]$?"] [:db/cas 17592186167075 :question/problem "Given that $X∼Exp(0.75)$, what is $E[X]$?" "Given that $X∼\\operatorname{Exp} (0.75)$, what is $E[X]$?"] [:db/cas 17592186167077 :question/problem "The time $X$, in minutes, between two users logging in on a computer network can be modeled as an exponential random variable $X∼Exp\\left(\\frac{1}{3}\\right)$. If a user has just logged in, what is the average time until the next user logs in?" "The time $X$, in minutes, between two users logging in on a computer network can be modeled as an exponential random variable $X∼\\operatorname{Exp} \\left(\\frac{1}{3}\\right)$. If a user has just logged in, what is the average time until the next user logs in?"] [:db/cas 17592186167099 :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ 2 & 1\\end{bmatrix}\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(1-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-2\\lambda -3 & =0 \\\\ (\\lambda -3)(\\lambda +1) & =0 \\\\ \\lambda  & =3,\\,-1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}=3.\n$$" "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\n\\max \\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\n\\min \\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ 2 & 1\\end{bmatrix}\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(1-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-2\\lambda -3 & =0 \\\\ (\\lambda -3)(\\lambda +1) & =0 \\\\ \\lambda  & =3,\\,-1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\max \\{Q(x)\\,|\\,‖x‖=1\\}=3.\n$$"] [:db/cas 17592186167100 :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}7 & 0 & 0 \\\\ 0 & 8 & -2 \\\\ 0 & -2 & 5\\end{bmatrix}\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}7-\\lambda  & 0 & 0 \\\\ 0 & 8-\\lambda  & -2 \\\\ 0 & -2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )\\begin{vmatrix}8-\\lambda  & -2 \\\\ -2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )((8-\\lambda )(5-\\lambda )-4) & =0 \\\\ (7-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ (7-\\lambda )(\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,7,\\,4\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}=4.\n$$" "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\n\\max {Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\n\\min {Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}7 & 0 & 0 \\\\ 0 & 8 & -2 \\\\ 0 & -2 & 5\\end{bmatrix}\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}7-\\lambda  & 0 & 0 \\\\ 0 & 8-\\lambda  & -2 \\\\ 0 & -2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )\\begin{vmatrix}8-\\lambda  & -2 \\\\ -2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )((8-\\lambda )(5-\\lambda )-4) & =0 \\\\ (7-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ (7-\\lambda )(\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,7,\\,4\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\min {Q(x)\\,|\\,‖x‖=1}=4.\n$$"] [:db/cas 17592186167136 :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {3}^{2}=9\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta <2\\pi }.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}2{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{∬}_{Δ}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\,{[\\frac{{r}^{4}}{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }(\\frac{81}{4}-0)\\text{d}\\theta  \\\\  & =\\frac{81}{2}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{81}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{81}{2}(2\\pi -0) \\\\  & =81\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{9\\pi }\\cdot 81\\pi =9.\n$$" "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {3}^{2}=9\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta <2\\pi }.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}2{r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{∬}_{Δ}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\,{[\\frac{{r}^{4}}{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }(\\frac{81}{4}-0)\\text{d}\\theta  \\\\  & =\\frac{81}{2}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{81}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{81}{2}(2\\pi -0) \\\\  & =81\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{9\\pi }\\cdot 81\\pi =9.\n$$"] [:db/cas 17592186167167 :question/worked-solution "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=\\begin{vmatrix}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{2}(x)=\\begin{vmatrix}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{3}(x)=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=\\operatorname{sec}⁡(x).$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(x),\\,{y}_{3}=\\operatorname{sin}⁡(x).\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =\\begin{vmatrix}1 & \\operatorname{cos}⁡(x) & \\operatorname{sin}⁡(x) \\\\ 0 & -\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ 0 & -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & ={sin}^{2}⁡(x)+{cos}^{2}⁡(x) \\\\  & =1.\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{3},$ we compute the determinant ${W}_{3}(x)$:\n\n$$\n\\begin{aligned}{W}_{3}(x) & =\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & \\operatorname{cos}⁡(x) \\\\ 0 & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & =-\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{3}(x) & =(-1)^{3-3}\\int \\frac{g(x){W}_{3}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sec}⁡(x)(-\\operatorname{sin}⁡(x))}{1}\\,\\text{d}x \\\\  & =\\int -\\frac{\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|\\operatorname{cos}⁡(x)|.\\end{aligned}\n$$" "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=\\begin{vmatrix}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{2}(x)=\\begin{vmatrix}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{3}(x)=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=\\operatorname{sec}⁡(x).$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(x),\\,{y}_{3}=\\operatorname{sin}⁡(x).\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =\\begin{vmatrix}1 & \\operatorname{cos}⁡(x) & \\operatorname{sin}⁡(x) \\\\ 0 & -\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ 0 & -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & ={\\sin }^{2}⁡(x)+{\\cos }^{2}⁡(x) \\\\  & =1.\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{3},$ we compute the determinant ${W}_{3}(x)$:\n\n$$\n\\begin{aligned}{W}_{3}(x) & =\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & \\operatorname{cos}⁡(x) \\\\ 0 & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & =-\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{3}(x) & =(-1)^{3-3}\\int \\frac{g(x){W}_{3}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sec}⁡(x)(-\\operatorname{sin}⁡(x))}{1}\\,\\text{d}x \\\\  & =\\int -\\frac{\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|\\operatorname{cos}⁡(x)|.\\end{aligned}\n$$"] [:db/cas 17592186167275 :question/worked-solution "We begin by using the half-angle identity\n\n$$\n{sin}^{2}⁡(3x)=\\frac{1}{2}(1-\\operatorname{cos}⁡(6x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩ & ={\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{12}(\\operatorname{sin}⁡(6\\pi )-(\\operatorname{sin}⁡(-6\\pi )) \\\\  & =\\pi .\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{sin}⁡(3x)$ $\\text{are not orthogonal}$ with respect to the inner product." "We begin by using the half-angle identity\n\n$$\n{\\sin }^{2}⁡(3x)=\\frac{1}{2}(1-\\operatorname{cos}⁡(6x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩ & ={\\int }_{-\\pi }^{\\pi }{\\sin }^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{12}(\\operatorname{sin}⁡(6\\pi )-(\\operatorname{sin}⁡(-6\\pi )) \\\\  & =\\pi .\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{sin}⁡(3x)$ $\\text{are not orthogonal}$ with respect to the inner product."] [:db/cas 17592186167282 :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(5x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ &= ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(5x)⟩ \\\\ &= ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{-\\pi }^{\\pi }{cos}^{2}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{20}(\\operatorname{sin}⁡(10\\pi )-(\\operatorname{sin}⁡(-10\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ & ={a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ \\\\ {a}_{5} & =\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩} \\\\ {a}_{5} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x.\\end{aligned}\n$$" "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(5x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ &= ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(5x)⟩ \\\\ &= ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{-\\pi }^{\\pi }{\\cos }^{2}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{20}(\\operatorname{sin}⁡(10\\pi )-(\\operatorname{sin}⁡(-10\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ & ={a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ \\\\ {a}_{5} & =\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩} \\\\ {a}_{5} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x.\\end{aligned}\n$$"] [:db/cas 17592186167298 :question/worked-solution "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=\\begin{vmatrix}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{2}(x)=\\begin{vmatrix}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{3}(x)=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=\\operatorname{sec}⁡x\\operatorname{tan}⁡x.$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(x),\\,{y}_{3}=\\operatorname{sin}⁡(x).\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =\\begin{vmatrix}1 & \\operatorname{cos}⁡(x) & \\operatorname{sin}⁡(x) \\\\ 0 & -\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ 0 & -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & ={sin}^{2}⁡(x)+{cos}^{2}⁡(x) \\\\  & =1\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{1},$ we compute the determinant ${W}_{1}(x)$:\n\n$$\n\\begin{aligned}{W}_{1}(x) & =\\begin{vmatrix}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\operatorname{cos}⁡(x) & \\operatorname{sin}⁡(x) \\\\ -\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x)\\end{vmatrix} \\\\  & ={cos}^{2}⁡(x)+{sin}^{2}⁡(x) \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{1}(x) & =(-1)^{3-1}\\int \\frac{g(x){W}_{1}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\cdot 1}{1}\\,\\text{d}x \\\\  & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x.\\end{aligned}\n$$" "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=\\begin{vmatrix}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{2}(x)=\\begin{vmatrix}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{vmatrix},\\,{W}_{3}(x)=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=\\operatorname{sec}⁡x\\operatorname{tan}⁡x.$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(x),\\,{y}_{3}=\\operatorname{sin}⁡(x).\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =\\begin{vmatrix}1 & \\operatorname{cos}⁡(x) & \\operatorname{sin}⁡(x) \\\\ 0 & -\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ 0 & -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x) \\\\ -\\operatorname{cos}⁡(x) & -\\operatorname{sin}⁡(x)\\end{vmatrix} \\\\  & ={\\sin }^{2}⁡(x)+{\\cos }^{2}⁡(x) \\\\  & =1\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{1},$ we compute the determinant ${W}_{1}(x)$:\n\n$$\n\\begin{aligned}{W}_{1}(x) & =\\begin{vmatrix}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\operatorname{cos}⁡(x) & \\operatorname{sin}⁡(x) \\\\ -\\operatorname{sin}⁡(x) & \\operatorname{cos}⁡(x)\\end{vmatrix} \\\\  & ={\\cos }^{2}⁡(x)+{\\sin }^{2}⁡(x) \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{1}(x) & =(-1)^{3-1}\\int \\frac{g(x){W}_{1}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\cdot 1}{1}\\,\\text{d}x \\\\  & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x.\\end{aligned}\n$$"] [:db/cas 17592186167321 :question/problem "Given that $X$ is a random variable such that $X∼U[- 1, 9]$, find $Var[X]$.\n\n> A scientific calculator is required to answer this question." "Given that $X$ is a random variable such that $X∼U[- 1, 9]$, find $\\operatorname{Var} [X]$.\n\n> A scientific calculator is required to answer this question."] [:db/cas 17592186167323 :question/problem "Given that $X$ is a random variable such that $X∼U[- 12,-8]$, find $Var[X]$.\n\n> A scientific calculator is required to answer this question." "Given that $X$ is a random variable such that $X∼U[- 12,-8]$, find $\\operatorname{Var} [X]$.\n\n> A scientific calculator is required to answer this question."] [:db/cas 17592186167341 :question/worked-solution "First, we recall the results for the derivatives of the basic reciprocal hyperbolic functions:\n\n$$\n(\\operatorname{sech}⁡x)^{′}=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x,\\,(\\operatorname{csch}⁡x)^{′}=-\\operatorname{csch}⁡x\\operatorname{coth}⁡x,\\,(\\operatorname{coth}⁡x)^{′}=-{csch}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{csch}⁡x-\\operatorname{coth}⁡x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x)-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x) \\\\  & =-3\\operatorname{csch}⁡x\\operatorname{coth}⁡x-(-{csch}^{2}⁡x) \\\\  & =\\operatorname{csch}⁡x(\\operatorname{csch}⁡x-3\\operatorname{coth}⁡x).\\end{aligned}\n$$" "First, we recall the results for the derivatives of the basic reciprocal hyperbolic functions:\n\n$$\n(\\operatorname{sech}⁡x)^{′}=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x,\\,(\\operatorname{csch}⁡x)^{′}=-\\operatorname{csch}⁡x\\operatorname{coth}⁡x,\\,(\\operatorname{coth}⁡x)^{′}=-{\\operatorname{csch} }^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{csch}⁡x-\\operatorname{coth}⁡x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x)-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x) \\\\  & =-3\\operatorname{csch}⁡x\\operatorname{coth}⁡x-(-{\\operatorname{csch} }^{2}⁡x) \\\\  & =\\operatorname{csch}⁡x(\\operatorname{csch}⁡x-3\\operatorname{coth}⁡x).\\end{aligned}\n$$"] [:db/cas 17592186167354 :question/problem "If $y = 2arsinh (\\ln x)$, then $\\frac{dy}{dx} =$" "If $y = 2\\operatorname{arsinh}  (\\ln x)$, then $\\frac{dy}{dx} =$"] [:db/cas 17592186167368 :question/worked-solution "First, we recall the results for the derivatives of the basic reciprocal hyperbolic functions:\n\n$$\n(\\operatorname{sech}⁡x)^{′}=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x,\\,(\\operatorname{csch}⁡x)^{′}=-\\operatorname{csch}⁡x\\operatorname{coth}⁡x,\\,(\\operatorname{coth}⁡x)^{′}=-{csch}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$" "First, we recall the results for the derivatives of the basic reciprocal hyperbolic functions:\n\n$$\n(\\operatorname{sech}⁡x)^{′}=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x,\\,(\\operatorname{csch}⁡x)^{′}=-\\operatorname{csch}⁡x\\operatorname{coth}⁡x,\\,(\\operatorname{coth}⁡x)^{′}=-{\\operatorname{csch} }^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$"] [:db/cas 17592186167390 :question/problem "Find the derivative of $f(x) =-3sech (2x - 1)$." "Find the derivative of $f(x) =-3\\operatorname{sech}  (2x - 1)$."] [:db/cas 17592186167408 :question/problem "Calculate $$\n\\displaystyle \\int \\frac{{coth}^{2}⁡x}{{sinh}^{2}⁡x+1}\\,\\text{d}x.\n$$" "Calculate $$\n\\displaystyle \\int \\frac{{\\coth }^{2}⁡x}{{\\sinh }^{2}⁡x+1}\\,\\text{d}x.\n$$"] [:db/cas 17592186167408 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the Pythagorean identity \n\n$$\n{cos}^{2}⁡x+{sin}^{2}⁡x=1.\n$$\n\nUsing Osborn's rule, we get the hyperbolic Pythagorean identity\n\n$$\n{cosh}^{2}⁡x-{sinh}^{2}⁡x=1.\n$$\n\nAdditionally, we have\n\n$$\n\\operatorname{coth}⁡x=\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}.\n$$\n\nUsing the above, we rewrite the denominator and calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{coth}^{2}⁡x}{{sinh}^{2}⁡x+1}\\,\\text{d}x & =\\int \\frac{{coth}^{2}⁡x}{{cosh}^{2}⁡x-1+1}\\text{d}x \\\\  & =\\int \\frac{{coth}^{2}⁡x}{{cosh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{\\left(\\frac{{cosh}^{2}⁡x}{{sinh}^{2}⁡x}\\right)}{{cosh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{sinh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int {csch}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡x+C\\end{aligned}\n$$" "First, we find the hyperbolic identity that corresponds to the Pythagorean identity \n\n$$\n{\\cos }^{2}⁡x+{\\sin }^{2}⁡x=1.\n$$\n\nUsing Osborn's rule, we get the hyperbolic Pythagorean identity\n\n$$\n{\\cosh }^{2}⁡x-{\\sinh }^{2}⁡x=1.\n$$\n\nAdditionally, we have\n\n$$\n\\operatorname{coth}⁡x=\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}.\n$$\n\nUsing the above, we rewrite the denominator and calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{\\coth }^{2}⁡x}{{\\sinh }^{2}⁡x+1}\\,\\text{d}x & =\\int \\frac{{\\coth }^{2}⁡x}{{\\cosh }^{2}⁡x-1+1}\\text{d}x \\\\  & =\\int \\frac{{\\coth }^{2}⁡x}{{\\cosh }^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{\\left(\\frac{{\\cosh }^{2}⁡x}{{\\sinh }^{2}⁡x}\\right)}{{\\cosh }^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{\\sinh }^{2}⁡x}\\,\\text{d}x \\\\  & =\\int {\\operatorname{csch} }^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡x+C\\end{aligned}\n$$"] [:db/cas 17592186167418 :question/problem "$$\n\\displaystyle \\int (3{cosh}^{2}⁡x+3{sinh}^{2}⁡x)\\,\\text{d}x=\n$$" "$$\n\\displaystyle \\int (3{\\cosh }^{2}⁡x+3{\\sinh }^{2}⁡x)\\,\\text{d}x=\n$$"] [:db/cas 17592186167418 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2x={cos}^{2}⁡x-{sin}^{2}⁡x.\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2x={cosh}^{2}⁡x+{sinh}^{2}⁡x\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int (3{cosh}^{2}⁡x+3{sinh}^{2}⁡x)\\,\\text{d}x & =\\int 3({cosh}^{2}⁡x+{sinh}^{2}⁡x)\\,\\text{d}x \\\\  & =3\\int ({cosh}^{2}⁡x+{sinh}^{2}⁡x)\\,\\text{d}x \\\\  & =3\\int \\operatorname{cosh}⁡2x\\,\\text{d}x \\\\  & =3\\cdot \\frac{1}{2}\\operatorname{sinh}⁡2x+C \\\\  & =\\frac{3}{2}\\operatorname{sinh}⁡2x+C.\\end{aligned}\n$$" "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2x={\\cos }^{2}⁡x-{\\sin }^{2}⁡x.\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2x={\\cosh }^{2}⁡x+{\\sinh }^{2}⁡x\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int (3{\\cosh }^{2}⁡x+3{\\sinh }^{2}⁡x)\\,\\text{d}x & =\\int 3({\\cosh }^{2}⁡x+{\\sinh }^{2}⁡x)\\,\\text{d}x \\\\  & =3\\int ({\\cosh }^{2}⁡x+{\\sinh }^{2}⁡x)\\,\\text{d}x \\\\  & =3\\int \\operatorname{cosh}⁡2x\\,\\text{d}x \\\\  & =3\\cdot \\frac{1}{2}\\operatorname{sinh}⁡2x+C \\\\  & =\\frac{3}{2}\\operatorname{sinh}⁡2x+C.\\end{aligned}\n$$"] [:db/cas 17592186167419 :question/problem "$$\n\\displaystyle {\\int }_{0}^{1}({cosh}^{2}⁡\\left(\\frac{x}{2}\\right)+{sinh}^{2}⁡\\left(\\frac{x}{2}\\right)+2x)\\,\\text{d}x=\n$$" "$$\n\\displaystyle {\\int }_{0}^{1}({\\cosh }^{2}⁡\\left(\\frac{x}{2}\\right)+{\\sinh }^{2}⁡\\left(\\frac{x}{2}\\right)+2x)\\,\\text{d}x=\n$$"] [:db/cas 17592186167419 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2\\theta ={cosh}^{2}⁡\\theta +{sinh}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{2},$ we get\n\n$$\n\\operatorname{cosh}⁡x={cosh}^{2}⁡\\left(\\frac{x}{2}\\right)+{sinh}^{2}⁡\\left(\\frac{x}{2}\\right).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({cosh}^{2}⁡\\left(\\frac{x}{2}\\right)+{sinh}^{2}⁡\\left(\\frac{x}{2}\\right)+2x)\\,\\text{d}x & ={\\int }_{0}^{1}(\\operatorname{cosh}⁡x+2x)\\,\\text{d}x \\\\  & ={(\\operatorname{sinh}⁡x+{x}^{2})|}_{0}^{1} \\\\  & =[\\operatorname{sinh}⁡1+{1}^{2}]-[\\operatorname{sinh}⁡0+{0}^{2}] \\\\  & =\\operatorname{sinh}⁡1+1.\\end{aligned}\n$$" "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2\\theta ={\\cos }^{2}⁡\\theta -{\\sin }^{2}⁡\\theta .\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2\\theta ={\\cosh }^{2}⁡\\theta +{\\sinh }^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{2},$ we get\n\n$$\n\\operatorname{cosh}⁡x={\\cosh }^{2}⁡\\left(\\frac{x}{2}\\right)+{\\sinh }^{2}⁡\\left(\\frac{x}{2}\\right).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({\\cosh }^{2}⁡\\left(\\frac{x}{2}\\right)+{\\sinh }^{2}⁡\\left(\\frac{x}{2}\\right)+2x)\\,\\text{d}x & ={\\int }_{0}^{1}(\\operatorname{cosh}⁡x+2x)\\,\\text{d}x \\\\  & ={(\\operatorname{sinh}⁡x+{x}^{2})|}_{0}^{1} \\\\  & =[\\operatorname{sinh}⁡1+{1}^{2}]-[\\operatorname{sinh}⁡0+{0}^{2}] \\\\  & =\\operatorname{sinh}⁡1+1.\\end{aligned}\n$$"] [:db/cas 17592186167421 :question/problem "Evaluate \n$$\n\\displaystyle {\\int }_{0}^{1}({cosh}^{2}⁡2x+x)\\,\\text{d}x.\n$$" "Evaluate \n$$\n\\displaystyle {\\int }_{0}^{1}({\\cosh }^{2}⁡2x+x)\\,\\text{d}x.\n$$"] [:db/cas 17592186167421 :question/worked-solution "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2\\theta =2{cosh}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cosh}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cosh}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{cosh}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cosh}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({cosh}^{2}⁡2x+x)\\,\\text{d}x & ={\\int }_{0}^{1}(\\frac{1}{2}(\\operatorname{cosh}⁡4x+1)+x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(\\frac{1}{2}\\operatorname{cosh}⁡4x+\\frac{1}{2}+x)\\,\\text{d}x \\\\  & ={(\\frac{1}{8}\\operatorname{sinh}⁡4x+\\frac{1}{2}x+\\frac{1}{2}{x}^{2})|}_{0}^{1} \\\\  & =[\\frac{1}{8}\\operatorname{sinh}⁡4+\\frac{1}{2}+\\frac{1}{2}\\cdot {1}^{2}]-[\\frac{1}{4}\\operatorname{sinh}⁡0+0-\\frac{1}{2}{0}^{2}] \\\\  & =\\frac{1}{8}\\operatorname{sinh}⁡4+1.\\end{aligned}\n$$" "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2\\theta =2{\\cos }^{2}⁡\\theta -1.\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2\\theta =2{\\cosh }^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{\\cosh }^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cosh}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{\\cosh }^{2}⁡2x=\\frac{1}{2}(\\operatorname{cosh}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({\\cosh }^{2}⁡2x+x)\\,\\text{d}x & ={\\int }_{0}^{1}(\\frac{1}{2}(\\operatorname{cosh}⁡4x+1)+x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(\\frac{1}{2}\\operatorname{cosh}⁡4x+\\frac{1}{2}+x)\\,\\text{d}x \\\\  & ={(\\frac{1}{8}\\operatorname{sinh}⁡4x+\\frac{1}{2}x+\\frac{1}{2}{x}^{2})|}_{0}^{1} \\\\  & =[\\frac{1}{8}\\operatorname{sinh}⁡4+\\frac{1}{2}+\\frac{1}{2}\\cdot {1}^{2}]-[\\frac{1}{4}\\operatorname{sinh}⁡0+0-\\frac{1}{2}{0}^{2}] \\\\  & =\\frac{1}{8}\\operatorname{sinh}⁡4+1.\\end{aligned}\n$$"] [:db/cas 17592186167424 :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{coth}⁡x$ and $v(x)={e}^{x}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{(\\operatorname{coth}⁡x)}^{′}\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot {({e}^{x})}^{′}}{{({e}^{x})}^{2}} \\\\  & =\\frac{(-{csch}^{2}⁡x)\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot ({e}^{x})}{{e}^{2x}} \\\\  & =-\\frac{{e}^{x}({csch}^{2}⁡x+\\operatorname{coth}⁡x)}{{e}^{2x}} \\\\  & =-\\frac{{csch}^{2}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}\\end{aligned}\\end{aligned}\n$$" "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{coth}⁡x$ and $v(x)={e}^{x}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{(\\operatorname{coth}⁡x)}^{′}\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot {({e}^{x})}^{′}}{{({e}^{x})}^{2}} \\\\  & =\\frac{(-{\\operatorname{csch} }^{2}⁡x)\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot ({e}^{x})}{{e}^{2x}} \\\\  & =-\\frac{{e}^{x}({\\operatorname{csch} }^{2}⁡x+\\operatorname{coth}⁡x)}{{e}^{2x}} \\\\  & =-\\frac{{\\operatorname{csch} }^{2}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}\\end{aligned}\\end{aligned}\n$$"] [:db/cas 17592186167428 :question/problem "Given that $t > 0$ and $t \\ne 1$, which of the following is equivalent to $csch (2\\ln t)$?" "Given that $t > 0$ and $t \\ne 1$, which of the following is equivalent to $\\operatorname{csch}  (2\\ln t)$?"] [:db/cas 17592186167429 :question/problem "What is $sech (-2)$?" "What is $\\operatorname{sech}  (-2)$?"] [:db/cas 17592186167430 :question/problem "Which of the following is equivalent to $sech (2t^{3})$?" "Which of the following is equivalent to $\\operatorname{sech}  (2t^{3})$?"] [:db/cas 17592186167464 :question/problem "Find a hyperbolic identity that corresponds to the trigonometric identity ${cos}^{2}⁡x+{sin}^{2}⁡x=1.$" "Find a hyperbolic identity that corresponds to the trigonometric identity ${\\cos }^{2}⁡x+{\\sin }^{2}⁡x=1.$"] [:db/cas 17592186167496 :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{5}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,4⟩\\times ⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩ \\\\  & =\\frac{1}{5}\\begin{vmatrix}i & j & k \\\\ -3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t & 4 \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t & 0\\end{vmatrix} \\\\  & =\\frac{1}{5}\\left[\\text{ }\\begin{vmatrix}3\\operatorname{cos}⁡t & 4 \\\\ -\\operatorname{sin}⁡t & 0\\end{vmatrix}\\,i-\\begin{vmatrix}-3\\operatorname{sin}⁡t & 4 \\\\ -\\operatorname{cos}⁡t & 0\\end{vmatrix}\\,j+\\begin{vmatrix}-3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{5}⟨(0-(-4\\operatorname{sin}⁡t)),-(0-(-4\\operatorname{cos}⁡t)),(3{sin}^{2}⁡t+3{cos}^{2}⁡t)⟩ \\\\  & =\\frac{1}{5}⟨4\\operatorname{sin}⁡t,-4\\operatorname{cos}⁡t,3⟩.\\end{aligned}\n$$" "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{5}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,4⟩\\times ⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩ \\\\  & =\\frac{1}{5}\\begin{vmatrix}i & j & k \\\\ -3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t & 4 \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t & 0\\end{vmatrix} \\\\  & =\\frac{1}{5}\\left[\\text{ }\\begin{vmatrix}3\\operatorname{cos}⁡t & 4 \\\\ -\\operatorname{sin}⁡t & 0\\end{vmatrix}\\,i-\\begin{vmatrix}-3\\operatorname{sin}⁡t & 4 \\\\ -\\operatorname{cos}⁡t & 0\\end{vmatrix}\\,j+\\begin{vmatrix}-3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{5}⟨(0-(-4\\operatorname{sin}⁡t)),-(0-(-4\\operatorname{cos}⁡t)),(3{\\sin }^{2}⁡t+3{\\cos }^{2}⁡t)⟩ \\\\  & =\\frac{1}{5}⟨4\\operatorname{sin}⁡t,-4\\operatorname{cos}⁡t,3⟩.\\end{aligned}\n$$"] [:db/cas 17592186167498 :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}⟨\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{3}\\sqrt{(0)^{2}+{(-\\operatorname{cos}⁡t)}^{2}+{(-\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩}{\\left(\\frac{1}{3}\\right)}=⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{3}⟨2\\sqrt{2},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\times ⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{1}{3}\\begin{vmatrix}i & j & k \\\\ 2\\sqrt{2} & -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{vmatrix} \\\\  & =\\frac{1}{3}\\left[\\text{ }\\begin{vmatrix}-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{vmatrix}\\,i-\\begin{vmatrix}2\\sqrt{2} & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{vmatrix}\\,j+\\begin{vmatrix}2\\sqrt{2} & -\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{cos}⁡t\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{3}⟨({sin}^{2}⁡t-(-{cos}^{2}⁡t)),-(-2\\sqrt{2}\\operatorname{sin}⁡t-0),(-2\\sqrt{2}\\operatorname{cos}⁡t-0)⟩ \\\\  & =\\frac{1}{3}⟨1,\\,2\\sqrt{2}\\operatorname{sin}⁡t,\\,-2\\sqrt{2}\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}⟨\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{3}\\sqrt{(0)^{2}+{(-\\operatorname{cos}⁡t)}^{2}+{(-\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{\\cos }^{2}⁡t+{\\sin }^{2}⁡t} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩}{\\left(\\frac{1}{3}\\right)}=⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{3}⟨2\\sqrt{2},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\times ⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{1}{3}\\begin{vmatrix}i & j & k \\\\ 2\\sqrt{2} & -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{vmatrix} \\\\  & =\\frac{1}{3}\\left[\\text{ }\\begin{vmatrix}-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{vmatrix}\\,i-\\begin{vmatrix}2\\sqrt{2} & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{vmatrix}\\,j+\\begin{vmatrix}2\\sqrt{2} & -\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{cos}⁡t\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{3}⟨({\\sin }^{2}⁡t-(-{\\cos }^{2}⁡t)),-(-2\\sqrt{2}\\operatorname{sin}⁡t-0),(-2\\sqrt{2}\\operatorname{cos}⁡t-0)⟩ \\\\  & =\\frac{1}{3}⟨1,\\,2\\sqrt{2}\\operatorname{sin}⁡t,\\,-2\\sqrt{2}\\operatorname{cos}⁡t⟩\\end{aligned}\n$$"] [:db/cas 17592186167526 :question/problem "Given that $X∼NB(12, 0.3)$, what is $Var[X]$?\n\n> A scientific calculator is required to answer this question." "Given that $X∼NB(12, 0.3)$, what is $\\operatorname{Var} [X]$?\n\n> A scientific calculator is required to answer this question."] [:db/cas 17592186167976 :tutorial/content "The variance of $X$ is determined by the following formula:\n\n$$\n\\textrm{Var}[X] = \\dfrac{r(1-p)}{p^2}\n$$\n\nAgain, it's worth comparing this to the variance of $X_{\\textrm G}\\sim \\textrm{Geom}(p)$. Recall that\n\n$$\n\\textrm{Var}[X_{\\textrm G}] = \\dfrac{(1-p)}{p^2}\n$$\n\nIt's easy to see how the two rules are related. First, we can think of $X$ as a sum of $r$ independent geometric random variables:\n\n$$\nX = \\underbrace{X_{\\textrm{G}_1} + X_{\\textrm{G}_2} +\\cdots + X_{\\textrm{G}_r}}_{r \\textrm{times}}\n$$\n\nwhere $X_{\\textrm{G}_1}, X_{\\textrm{G}_2}, \\ldots, X_{\\textrm{G}_r} \\sim \\textrm{Geom}(p)$. By the properties of variance for sums of independent random variables, we have\n\n$$\n\\begin{aligned}\nVar[X] &= Var[X_{G_{1}}] + Var[X_{G_{2}}] + ⋯ + Var[X_{G_{r}}] \\\\\n&= \\underbrace{((1 - p))/(p^{2}) + ((1 - p))/(p^{2}) + ⋯ + ((1 - p))/(p^{2})}_{r\\text{ times}} \\\\\n&= (r(1 - p))/(p^{2})\n\\end{aligned}\n$$" "The variance of $X$ is determined by the following formula:\n\n$$\n\\textrm{Var}[X] = \\dfrac{r(1-p)}{p^2}\n$$\n\nAgain, it's worth comparing this to the variance of $X_{\\textrm G}\\sim \\textrm{Geom}(p)$. Recall that\n\n$$\n\\textrm{Var}[X_{\\textrm G}] = \\dfrac{(1-p)}{p^2}\n$$\n\nIt's easy to see how the two rules are related. First, we can think of $X$ as a sum of $r$ independent geometric random variables:\n\n$$\nX = \\underbrace{X_{\\textrm{G}_1} + X_{\\textrm{G}_2} +\\cdots + X_{\\textrm{G}_r}}_{r \\textrm{times}}\n$$\n\nwhere $X_{\\textrm{G}_1}, X_{\\textrm{G}_2}, \\ldots, X_{\\textrm{G}_r} \\sim \\textrm{Geom}(p)$. By the properties of variance for sums of independent random variables, we have\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [X] &= \\operatorname{Var} [X_{G_{1}}] + \\operatorname{Var} [X_{G_{2}}] + ⋯ + \\operatorname{Var} [X_{G_{r}}] \\\\\n&= \\underbrace{((1 - p))/(p^{2}) + ((1 - p))/(p^{2}) + ⋯ + ((1 - p))/(p^{2})}_{r\\text{ times}} \\\\\n&= (r(1 - p))/(p^{2})\n\\end{aligned}\n$$"] [:db/cas 17592186168090 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivatives of the reciprocal hyperbolic functions are as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) & =-\\operatorname{csch}⁡x\\operatorname{coth}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x) & =-{csch}^{2}⁡x\\end{aligned}\n$$\n\nLet's use these results to find the derivative of \n\n$$\ny= \\sech x - 2\\csch x.\n$$\n\nDifferentiating term-by-term, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivatives of the reciprocal hyperbolic functions are as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) & =-\\operatorname{csch}⁡x\\operatorname{coth}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x) & =-{\\operatorname{csch} }^{2}⁡x\\end{aligned}\n$$\n\nLet's use these results to find the derivative of \n\n$$\ny= \\operatorname{sech}  x - 2\\operatorname{csch}  x.\n$$\n\nDifferentiating term-by-term, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$"] [:db/cas 17592186168091 :tutorial/content "The derivatives of the base inverse hyperbolic functions are shown below:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nNow that we know the derivative of the base inverse hyperbolic functions, we can differentiate combinations of these functions, by using the properties of differentiation.\n\nFor example, let's find the derivative of \n\n$$\ny = \\arcosh(x^2).\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡({x}^{2})) \\\\  & =\\frac{1}{\\sqrt{({x}^{2})^{2}-1}}\\cdot {({x}^{2})}^{′} \\\\  & =\\frac{1}{\\sqrt{{x}^{4}-1}}\\cdot 2x \\\\  & =\\frac{2x}{\\sqrt{{x}^{4}-1}}.\\end{aligned}\n$$" "The derivatives of the base inverse hyperbolic functions are shown below:\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nNow that we know the derivative of the base inverse hyperbolic functions, we can differentiate combinations of these functions, by using the properties of differentiation.\n\nFor example, let's find the derivative of \n\n$$\ny = \\operatorname{arcosh} (x^2).\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡({x}^{2})) \\\\  & =\\frac{1}{\\sqrt{({x}^{2})^{2}-1}}\\cdot {({x}^{2})}^{′} \\\\  & =\\frac{1}{\\sqrt{{x}^{4}-1}}\\cdot 2x \\\\  & =\\frac{2x}{\\sqrt{{x}^{4}-1}}.\\end{aligned}\n$$"] [:db/cas 17592186168092 :tutorial/content "The derivatives of the inverse reciprocal hyperbolic functions are shown below:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x) & =-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}, &  & x\\in (-\\infty ,0)\\cup (0,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x) & =-\\frac{1}{x\\sqrt{1-{x}^{2}}}, &  & x\\in (0,1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & x\\in (-\\infty ,-1)\\cup (1,\\infty )\\end{aligned}\n$$\n\nNow that we know the derivative of the base inverse reciprocal hyperbolic functions, we can differentiate combinations of these functions, by using the properties of differentiation.\n\nFor example, let's find the derivative of\n\n$$\ny = \\arsech{(-x^2)}\n$$\n\nUsing the formulas above together with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡(-{x}^{2})) \\\\  & =-\\frac{1}{(-{x}^{2})\\sqrt{1-{(-{x}^{2})}^{2}}}\\cdot {(-{x}^{2})}^{′} \\\\  & =-\\frac{1}{-{x}^{2}\\sqrt{1-{x}^{4}}}\\cdot (-2x) \\\\  & =-\\frac{2}{x\\sqrt{1-{x}^{4}}}.\\end{aligned}\n$$" "The derivatives of the inverse reciprocal hyperbolic functions are shown below:\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x) & =-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}, &  & x\\in (-\\infty ,0)\\cup (0,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x) & =-\\frac{1}{x\\sqrt{1-{x}^{2}}}, &  & x\\in (0,1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & x\\in (-\\infty ,-1)\\cup (1,\\infty )\\end{aligned}\n$$\n\nNow that we know the derivative of the base inverse reciprocal hyperbolic functions, we can differentiate combinations of these functions, by using the properties of differentiation.\n\nFor example, let's find the derivative of\n\n$$\ny = \\operatorname{arsech} {(-x^2)}\n$$\n\nUsing the formulas above together with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡(-{x}^{2})) \\\\  & =-\\frac{1}{(-{x}^{2})\\sqrt{1-{(-{x}^{2})}^{2}}}\\cdot {(-{x}^{2})}^{′} \\\\  & =-\\frac{1}{-{x}^{2}\\sqrt{1-{x}^{4}}}\\cdot (-2x) \\\\  & =-\\frac{2}{x\\sqrt{1-{x}^{4}}}.\\end{aligned}\n$$"] [:db/cas 17592186168093 :tutorial/content "Recall the following derivatives of the inverse hyperbolic functions:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nSince integration is the reverse of differentiation, we arrive at the following basic integrals:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =\\operatorname{arsinh}⁡x+C, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =\\operatorname{arcosh}⁡x+C, &  & \\,x\\in (1,\\infty ) \\\\ \\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{artanh}⁡x+C, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nWe can now use these formulas for finding integrals. For example, let's find the integral\n\n$$\n\\int \\left(\\dfrac{5}{2\\sqrt{x^2-1}} + 2x \\right) \\textrm d x\n$$\n\nUsing the properties of integration and the formulas above, we obtain\n\n$$\n\\begin{aligned}\\int (\\frac{5}{2\\sqrt{{x}^{2}-1}}+2x)\\text{d}x & =\\frac{5}{2}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x+\\int 2x\\,\\text{d}x \\\\  & =\\frac{5}{2}\\operatorname{arcosh}⁡x+{x}^{2}+C.\\end{aligned}\n$$" "Recall the following derivatives of the inverse hyperbolic functions:\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nSince integration is the reverse of differentiation, we arrive at the following basic integrals:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =\\operatorname{arsinh}⁡x+C, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =\\operatorname{arcosh}⁡x+C, &  & \\,x\\in (1,\\infty ) \\\\ \\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{artanh}⁡x+C, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nWe can now use these formulas for finding integrals. For example, let's find the integral\n\n$$\n\\int \\left(\\dfrac{5}{2\\sqrt{x^2-1}} + 2x \\right) \\textrm d x\n$$\n\nUsing the properties of integration and the formulas above, we obtain\n\n$$\n\\begin{aligned}\\int (\\frac{5}{2\\sqrt{{x}^{2}-1}}+2x)\\text{d}x & =\\frac{5}{2}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x+\\int 2x\\,\\text{d}x \\\\  & =\\frac{5}{2}\\operatorname{arcosh}⁡x+{x}^{2}+C.\\end{aligned}\n$$"] [:db/cas 17592186168094 :tutorial/content "Recall the following derivatives of the inverse reciprocal hyperbolic functions:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x) & =-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}, &  & \\,x\\in (-\\infty ,0)\\cup (0,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x) & =-\\frac{1}{x\\sqrt{1-{x}^{2}}}, &  & \\,x\\in (0,1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-\\infty ,-1)\\cup (1,\\infty )\\end{aligned}\n$$\n\nSince integration is the reverse of differentiation, we arrive at the following basic integrals:\n\n$$\n\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x & =-\\operatorname{arcsch}⁡x+C, &  & \\,x\\in (-\\infty ,0)\\cup (0,\\infty ) \\\\ \\int \\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =-\\operatorname{arsech}⁡x+C, &  & \\,x\\in (0,1) \\\\ \\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{arcoth}⁡x+C, &  & \\,x\\in (-\\infty ,-1)\\cup (1,\\infty )\\end{aligned}\n$$\n\nWe can now use these formulas for finding integrals. For example, let's find the integral\n\n$$\n\\int \\left(\\dfrac{2}{3x\\sqrt{1-x^2}} + \\cos x \\right) \\textrm d x.\n$$\n\nUsing the properties of integration and the formulas above, we obtain\n\n$$\n\\begin{aligned}\\int (\\frac{2}{3x\\sqrt{1-{x}^{2}}}+\\operatorname{cos}⁡x)\\text{d}x & =\\frac{2}{3}\\int \\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x+\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-\\frac{2}{3}\\operatorname{arsech}⁡x+\\operatorname{sin}⁡x+C.\\end{aligned}\n$$" "Recall the following derivatives of the inverse reciprocal hyperbolic functions:\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x) & =-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}, &  & \\,x\\in (-\\infty ,0)\\cup (0,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x) & =-\\frac{1}{x\\sqrt{1-{x}^{2}}}, &  & \\,x\\in (0,1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-\\infty ,-1)\\cup (1,\\infty )\\end{aligned}\n$$\n\nSince integration is the reverse of differentiation, we arrive at the following basic integrals:\n\n$$\n\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x & =-\\operatorname{arcsch}⁡x+C, &  & \\,x\\in (-\\infty ,0)\\cup (0,\\infty ) \\\\ \\int \\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =-\\operatorname{arsech}⁡x+C, &  & \\,x\\in (0,1) \\\\ \\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{arcoth}⁡x+C, &  & \\,x\\in (-\\infty ,-1)\\cup (1,\\infty )\\end{aligned}\n$$\n\nWe can now use these formulas for finding integrals. For example, let's find the integral\n\n$$\n\\int \\left(\\dfrac{2}{3x\\sqrt{1-x^2}} + \\cos x \\right) \\textrm d x.\n$$\n\nUsing the properties of integration and the formulas above, we obtain\n\n$$\n\\begin{aligned}\\int (\\frac{2}{3x\\sqrt{1-{x}^{2}}}+\\operatorname{cos}⁡x)\\text{d}x & =\\frac{2}{3}\\int \\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x+\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-\\frac{2}{3}\\operatorname{arsech}⁡x+\\operatorname{sin}⁡x+C.\\end{aligned}\n$$"] [:db/cas 17592186168095 :tutorial/content "Consider the integral\n\n$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\n$$\n\\int \\csch^2(2x+3) \\, \\textrm{d}x\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, it is very similar to the basic integral for the hyperbolic cotangent,\n\n$$\n\\int \\csch^2 u \\, \\textrm{d}u = -\\coth u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $2x+3$.\n\nSo, let\n\n$$\nu=2x+3\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 2\\quad\\Longrightarrow\\quad \\textrm{d}x = \\dfrac{1}{2} \\, \\textrm{d}u\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\n\\intcsch^{2} (2x + 3)dx &= \\intcsch^{2} u \\cdot \\frac{1}{2}du \\\\\n&= \\frac{1}{2}\\intcsch^{2} udu \\\\\n&= \\frac{1}{2}(-\\coth u) + C \\\\\n&=-\\frac{1}{2}\\coth (2x + 3) + C\n\\end{aligned}\n$$" "Consider the integral\n\n$$\n\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\n$$\n\\int \\operatorname{csch} ^2(2x+3) \\, \\textrm{d}x\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, it is very similar to the basic integral for the hyperbolic cotangent,\n\n$$\n\\int \\operatorname{csch} ^2 u \\, \\textrm{d}u = -\\coth u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $2x+3$.\n\nSo, let\n\n$$\nu=2x+3\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 2\\quad\\Longrightarrow\\quad \\textrm{d}x = \\dfrac{1}{2} \\, \\textrm{d}u\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\n\\intcsch^{2} (2x + 3)dx &= \\intcsch^{2} u \\cdot \\frac{1}{2}du \\\\\n&= \\frac{1}{2}\\intcsch^{2} udu \\\\\n&= \\frac{1}{2}(-\\coth u) + C \\\\\n&=-\\frac{1}{2}\\coth (2x + 3) + C\n\\end{aligned}\n$$"] [:db/cas 17592186168096 :tutorial/content "Consider the integral\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int \\dfrac{2}{\\sqrt{4x^2-1}} \\, \\textrm{d}x.\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can rewrite our integral as\n\n$$\n\\int \\dfrac{2}{\\sqrt{4x^2-1}}\\,\\textrm{d}x = 2 \\int \\dfrac{1}{\\sqrt{\\left(2x\\right)^2-1}}\\textrm{d}x,\n$$\n\nwhich becomes very similar to the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{u^2-1}}\\,\\textrm{d}u = \\arcosh u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $2x.$\n\nSo, let $u=2x.$ Differentiating, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=2\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\dfrac{1}{2} \\,\\textrm{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{\\sqrt{4{x}^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{\\sqrt{(2x)^{2}-1}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\text{\\arcosh}u+C \\\\  & =\\text{\\arcosh}(2x)+C\\end{aligned}\\end{aligned}\n$$" "Consider the integral\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int \\dfrac{2}{\\sqrt{4x^2-1}} \\, \\textrm{d}x.\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can rewrite our integral as\n\n$$\n\\int \\dfrac{2}{\\sqrt{4x^2-1}}\\,\\textrm{d}x = 2 \\int \\dfrac{1}{\\sqrt{\\left(2x\\right)^2-1}}\\textrm{d}x,\n$$\n\nwhich becomes very similar to the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{u^2-1}}\\,\\textrm{d}u = \\operatorname{arcosh}  u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $2x.$\n\nSo, let $u=2x.$ Differentiating, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=2\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\dfrac{1}{2} \\,\\textrm{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{\\sqrt{4{x}^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{\\sqrt{(2x)^{2}-1}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\text{\\arcosh}u+C \\\\  & =\\text{\\arcosh}(2x)+C\\end{aligned}\\end{aligned}\n$$"] [:db/cas 17592186168097 :tutorial/content "Consider the integral\n\n$$\n\\displaystyle \\int \\dfrac{1}{6x\\sqrt{1-36x^2}} \\, \\textrm{d}x\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can rewrite our integral as\n\n$$\n\\int \\dfrac{1}{6x\\sqrt{1-36x^2}}\\,\\textrm{d}x = \\int \\dfrac{1}{(6x)\\sqrt{1-\\left(6x\\right)^2}}\\textrm{d}x\n$$\n\nwhich becomes very similar to the basic integral for the inverse hyperbolic secant,\n\n$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\n$$\n\\int \\frac{1}{u\\sqrt{1-u^2}}\\,\\textrm{d}u = -\\arsech u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $6x$.\n\nSo, let's substitute $u =6x$. Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=6 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\dfrac{1}{6} \\,\\textrm{d}u\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{6x\\sqrt{1 - 36x^{2}}}dx &= \\int(1)/(6x\\sqrt{1 - (6x)^{2}})dx \\\\\n&= \\int\\frac{1}{u\\sqrt{1 - u^{2}}} \\cdot \\frac{1}{6}du \\\\\n&= \\frac{1}{6}\\int\\frac{1}{u\\sqrt{1 - u^{2}}}du \\\\\n&=-\\frac{1}{6}arsech u + C \\\\\n&=-\\frac{1}{6}arsech (6x) + C\n\\end{aligned}\n$$" "Consider the integral\n\n$$\n\\displaystyle \\int \\dfrac{1}{6x\\sqrt{1-36x^2}} \\, \\textrm{d}x\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can rewrite our integral as\n\n$$\n\\int \\dfrac{1}{6x\\sqrt{1-36x^2}}\\,\\textrm{d}x = \\int \\dfrac{1}{(6x)\\sqrt{1-\\left(6x\\right)^2}}\\textrm{d}x\n$$\n\nwhich becomes very similar to the basic integral for the inverse hyperbolic secant,\n\n$$\n\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\n$$\n\\int \\frac{1}{u\\sqrt{1-u^2}}\\,\\textrm{d}u = -\\operatorname{arsech}  u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $6x$.\n\nSo, let's substitute $u =6x$. Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=6 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\dfrac{1}{6} \\,\\textrm{d}u\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{6x\\sqrt{1 - 36x^{2}}}dx &= \\int(1)/(6x\\sqrt{1 - (6x)^{2}})dx \\\\\n&= \\int\\frac{1}{u\\sqrt{1 - u^{2}}} \\cdot \\frac{1}{6}du \\\\\n&= \\frac{1}{6}\\int\\frac{1}{u\\sqrt{1 - u^{2}}}du \\\\\n&=-\\frac{1}{6}arsech u + C \\\\\n&=-\\frac{1}{6}\\operatorname{arsech}  (6x) + C\n\\end{aligned}\n$$"] [:db/cas 17592186168099 :tutorial/content "We can also complete the square to integrate hyperbolic *arcsecant*, *arccosecant*, and *arccotangent*.\n\nFor example, let's consider the integral\n\n$$\n\\int \\dfrac{1}{\\left(x+3\\right)\\sqrt{-x^2-6x}} \\textrm{d}x.\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can complete the square for the argument of the square root in the denominator, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}-6x & =-({x}^{2}+6x) \\\\  & =-({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) \\\\  & =-((x+3)^{2}-9) \\\\  & =9-(x+3)^{2}\\end{aligned}\n$$\n\nIf we plug the above into our integral and collect a factor of $9$ under the square root, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\int \\frac{1}{(x+3)\\sqrt{9-(x+3)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{3(x+3)\\sqrt{1-{\\left(\\frac{x+3}{3}\\right)}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{\\left(\\frac{x+3}{3}\\right)\\sqrt{1-{\\left(\\frac{x+3}{3}\\right)}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis now looks more familiar! Let $u = \\dfrac {x+3}{3}.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 3\\,\\textrm{d}u.\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{\\left(\\frac{x+3}{3}\\right)\\sqrt{1-{\\left(\\frac{x+3}{3}\\right)}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nThis is a basic integral for an inverse reciprocal hyperbolic function, and we can solve it in one step:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡\\left(\\frac{x+3}{3}\\right)+C.\\end{aligned}\n$$" "We can also complete the square to integrate hyperbolic *arcsecant*, *arccosecant*, and *arccotangent*.\n\nFor example, let's consider the integral\n\n$$\n\\int \\dfrac{1}{\\left(x+3\\right)\\sqrt{-x^2-6x}} \\textrm{d}x.\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can complete the square for the argument of the square root in the denominator, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}-6x & =-({x}^{2}+6x) \\\\  & =-({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) \\\\  & =-((x+3)^{2}-9) \\\\  & =9-(x+3)^{2}\\end{aligned}\n$$\n\nIf we plug the above into our integral and collect a factor of $9$ under the square root, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\int \\frac{1}{(x+3)\\sqrt{9-(x+3)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{3(x+3)\\sqrt{1-{\\left(\\frac{x+3}{3}\\right)}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{\\left(\\frac{x+3}{3}\\right)\\sqrt{1-{\\left(\\frac{x+3}{3}\\right)}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis now looks more familiar! Let $u = \\dfrac {x+3}{3}.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 3\\,\\textrm{d}u.\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{\\left(\\frac{x+3}{3}\\right)\\sqrt{1-{\\left(\\frac{x+3}{3}\\right)}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nThis is a basic integral for an inverse reciprocal hyperbolic function, and we can solve it in one step:\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡\\left(\\frac{x+3}{3}\\right)+C.\\end{aligned}\n$$"] [:db/cas 17592186168100 :tutorial/content "We derive formulas for the derivatives of the inverse hyperbolic functions from the functions' definitions. \n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor instance, let's show that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh{x}) = \\dfrac{1}{\\sqrt{x^2+1}}.\n$$\n\nRecall that\n\n$$\n\\arsinh{x} = \\ln\\big(x+\\sqrt{x^2+1}\\big).\n$$\n\nDifferentiating using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1})) \\\\  & =\\frac{1}{x+\\sqrt{{x}^{2}+1}}\\cdot (x+\\sqrt{{x}^{2}+1})^{′} \\\\  & =\\frac{(1+\\frac{x}{\\sqrt{{x}^{2}+1}})}{x+\\sqrt{{x}^{2}+1}} \\\\  & =\\frac{\\sqrt{{x}^{2}+1}+x}{\\sqrt{{x}^{2}+1}(x+\\sqrt{{x}^{2}+1})} \\\\  & =\\frac{\\cancel{x+\\sqrt{{x}^{2}+1}}}{\\sqrt{{x}^{2}+1}\\cancel{(x+\\sqrt{{x}^{2}+1})}} \\\\  & =\\frac{1}{\\sqrt{{x}^{2}+1}}.\\end{aligned}\n$$\n\nSimilarly, we can obtain the other formulas." "We derive formulas for the derivatives of the inverse hyperbolic functions from the functions' definitions. \n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor instance, let's show that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\operatorname{arsinh} {x}) = \\dfrac{1}{\\sqrt{x^2+1}}.\n$$\n\nRecall that\n\n$$\n\\operatorname{arsinh} {x} = \\ln\\big(x+\\sqrt{x^2+1}\\big).\n$$\n\nDifferentiating using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1})) \\\\  & =\\frac{1}{x+\\sqrt{{x}^{2}+1}}\\cdot (x+\\sqrt{{x}^{2}+1})^{′} \\\\  & =\\frac{(1+\\frac{x}{\\sqrt{{x}^{2}+1}})}{x+\\sqrt{{x}^{2}+1}} \\\\  & =\\frac{\\sqrt{{x}^{2}+1}+x}{\\sqrt{{x}^{2}+1}(x+\\sqrt{{x}^{2}+1})} \\\\  & =\\frac{\\cancel{x+\\sqrt{{x}^{2}+1}}}{\\sqrt{{x}^{2}+1}\\cancel{(x+\\sqrt{{x}^{2}+1})}} \\\\  & =\\frac{1}{\\sqrt{{x}^{2}+1}}.\\end{aligned}\n$$\n\nSimilarly, we can obtain the other formulas."] [:db/cas 17592186168101 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$ \n\nWe wish to prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\sech{x}) = -\\sech{x} \\tanh{x}.\n$$\n\nTo do this, we can use the fact that\n\n$$\n\\sech x = \\dfrac{1}{\\cosh x}.\n$$\n\nDifferentiating the above equation using the chain rule, we arrive at\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{\\operatorname{cosh}⁡x}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}{(\\operatorname{cosh}⁡x)}^{-1} \\\\  & =-{(\\operatorname{cosh}⁡x)}^{-2}\\cdot (\\operatorname{cosh}⁡x)^{′} \\\\  & =-\\frac{1}{{cosh}^{2}⁡x}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{1}{\\operatorname{cosh}⁡x}\\cdot \\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x} \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\end{aligned}\n$$\n\nWe can prove the results for the derivatives of the hyperbolic cosecant and cotangent in a similar way." "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$ \n\nWe wish to prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\operatorname{sech} {x}) = -\\operatorname{sech} {x} \\tanh{x}.\n$$\n\nTo do this, we can use the fact that\n\n$$\n\\operatorname{sech}  x = \\dfrac{1}{\\cosh x}.\n$$\n\nDifferentiating the above equation using the chain rule, we arrive at\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{\\operatorname{cosh}⁡x}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}{(\\operatorname{cosh}⁡x)}^{-1} \\\\  & =-{(\\operatorname{cosh}⁡x)}^{-2}\\cdot (\\operatorname{cosh}⁡x)^{′} \\\\  & =-\\frac{1}{{\\cosh }^{2}⁡x}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{1}{\\operatorname{cosh}⁡x}\\cdot \\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x} \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\end{aligned}\n$$\n\nWe can prove the results for the derivatives of the hyperbolic cosecant and cotangent in a similar way."] [:db/cas 17592186168102 :tutorial/content "Recall that \n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\int \\dfrac{1}{1-x^2} \\,\\textrm{d}x = {\\color{blue}\\artanh{x}} + C, \\qquad {\\color{blue}x\\in(-1,1)}.\n$$\n\nBut we have just seen that\n\n$$\n\\int \\dfrac{1}{1-x^2} \\,\\textrm{d}x = {\\color{red}\\arcoth{x}} + C, \\qquad {\\color{red}x\\in(-\\infty,-1) \\cup (1,\\infty)}.\n$$\n\nNotice that the integral on the left-hand side is the same but we used different functions on the right. What is the difference, and how do we know which hyperbolic function to use?\n\nThe difference is the domain of the variable $x.$ When the $|x| < 1,$ we use the antiderivative $\\artanh{x},$ otherwise we use the antiderivative $\\arcoth{x}.$\n\nFor instance, we have that\n\n$$\n\\begin{aligned}{\\int }_{-1/2}^{1/2}\\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{artanh}⁡x\\,{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{artanh}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{artanh}⁡\\left(-\\frac{1}{2}\\right).\\end{aligned}\n$$\n\nNote that since the limits of integration lie in the interval $(-1,1),$ we used the antiderivative $\\artanh{x}.$\n\nWhile, on the other hand, we have that\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}\\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{arcoth}⁡x\\,{|}_{2}^{3} \\\\  & =\\operatorname{arcoth}⁡(3)-\\operatorname{arcoth}⁡(2).\\end{aligned}\n$$\n\nNote that since the limits of integration lie in the interval $(1,\\infty),$ we used the antiderivative $\\arcoth{x}.$" "Recall that \n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\int \\dfrac{1}{1-x^2} \\,\\textrm{d}x = {\\color{blue}\\operatorname{artanh} {x}} + C, \\qquad {\\color{blue}x\\in(-1,1)}.\n$$\n\nBut we have just seen that\n\n$$\n\\int \\dfrac{1}{1-x^2} \\,\\textrm{d}x = {\\color{red}\\operatorname{arcoth} {x}} + C, \\qquad {\\color{red}x\\in(-\\infty,-1) \\cup (1,\\infty)}.\n$$\n\nNotice that the integral on the left-hand side is the same but we used different functions on the right. What is the difference, and how do we know which hyperbolic function to use?\n\nThe difference is the domain of the variable $x.$ When the $|x| < 1,$ we use the antiderivative $\\operatorname{artanh} {x},$ otherwise we use the antiderivative $\\operatorname{arcoth} {x}.$\n\nFor instance, we have that\n\n$$\n\\begin{aligned}{\\int }_{-1/2}^{1/2}\\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{artanh}⁡x\\,{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{artanh}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{artanh}⁡\\left(-\\frac{1}{2}\\right).\\end{aligned}\n$$\n\nNote that since the limits of integration lie in the interval $(-1,1),$ we used the antiderivative $\\operatorname{artanh} {x}.$\n\nWhile, on the other hand, we have that\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}\\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{arcoth}⁡x\\,{|}_{2}^{3} \\\\  & =\\operatorname{arcoth}⁡(3)-\\operatorname{arcoth}⁡(2).\\end{aligned}\n$$\n\nNote that since the limits of integration lie in the interval $(1,\\infty),$ we used the antiderivative $\\operatorname{arcoth} {x}.$"] [:db/cas 17592186168110 :tutorial/content "It can be shown that if $X\\sim \\textrm{Bernoulli}(p)$, then\n\n$$\n\\textrm{E}[X] = p, \\qquad \\textrm{Var}[X] = p(1-p)\n$$\n\nWe'll now prove these two results. First, recall that if $X\\sim \\textrm{Bernoulli}(p)$, then the PMF of $X$ is given by\n\n$$\nf(x) =\n{\\left\\{  \\begin{array}{ll}p , & x = 1 , \\\\ 1 - p , & x = 0.\\end{array} \\right. }\n$$\n\nBy definition, we have\n\n$$\n\\textrm E[X] = \\sum_{x\\in \\{0,1\\}} x \\cdot f(x)\n$$\n\nTherefore,\n\n$$\nE[X] = 1 \\cdot p + 0 \\cdot (1 - p) = p\n$$\n\nFor the variance, we first recall that\n\n$$\n\\textrm{Var}[X] = \\textrm E[X^2] - \\left(\\textrm{E}[X]\\right)^2\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nVar[X] &= E[X^{2}] - (E[X])^{2} \\\\\n&= 1^{2} \\cdot p + 0^{2} \\cdot (1 - p) - p^{2} \\\\\n&= p - p^{2} \\\\\n&= p(1 - p)\n\\end{aligned}\n$$" "It can be shown that if $X\\sim \\textrm{Bernoulli}(p)$, then\n\n$$\n\\textrm{E}[X] = p, \\qquad \\textrm{Var}[X] = p(1-p)\n$$\n\nWe'll now prove these two results. First, recall that if $X\\sim \\textrm{Bernoulli}(p)$, then the PMF of $X$ is given by\n\n$$\nf(x) =\n{\\left\\{  \\begin{array}{ll}p , & x = 1 , \\\\ 1 - p , & x = 0.\\end{array} \\right. }\n$$\n\nBy definition, we have\n\n$$\n\\textrm E[X] = \\sum_{x\\in \\{0,1\\}} x \\cdot f(x)\n$$\n\nTherefore,\n\n$$\nE[X] = 1 \\cdot p + 0 \\cdot (1 - p) = p\n$$\n\nFor the variance, we first recall that\n\n$$\n\\textrm{Var}[X] = \\textrm E[X^2] - \\left(\\textrm{E}[X]\\right)^2\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [X] &= E[X^{2}] - (E[X])^{2} \\\\\n&= 1^{2} \\cdot p + 0^{2} \\cdot (1 - p) - p^{2} \\\\\n&= p - p^{2} \\\\\n&= p(1 - p)\n\\end{aligned}\n$$"] [:db/cas 17592186168117 :tutorial/content "It's possible to convert every trigonometric identity to a corresponding *hyperbolic* identity using **Osborn's rule.** \n\nTo apply Osborn's rule, we follow two steps:\n\n1\\. Replace every trigonometric function with its corresponding hyperbolic function.\n\n2\\. For any product of *two trigonometric sines*, change the sign of the corresponding product of hyperbolic sines.\n\nTo demonstrate, consider the Pythagorean trigonometric identity:\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n\\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\cos^2 x \\:{\\color{blue}{\\boldsymbol +}}\\: \\sin^2 x = 1\n$$\n\nNotice that this trigonometric identity contains a product of two sines. Therefore, to find the corresponding hyperbolic identity, we change each trigonometric function to its corresponding hyperbolic counterpart and change the sign in front of the corresponding product of sines. \n\nThus, the corresponding hyperbolic identity is\n\n$$\n\\cosh^2 x \\:{\\color{red}{\\boldsymbol -}}\\: \\sinh^2 x = 1.\n$$\n\n \n\nWe can check that this identity is indeed true using the definitions of the hyperbolic sine and cosine:\n\n$$\n\\begin{aligned}{cosh}^{2}⁡x-{sinh}^{2}⁡x & ={(\\frac{1}{2}({e}^{x}+{e}^{-x}))}^{2}-{(\\frac{1}{2}({e}^{x}-{e}^{-x}))}^{2} \\\\  & =\\frac{1}{4}{({e}^{x}+{e}^{-x})}^{2}-\\frac{1}{4}{({e}^{x}-{e}^{-x})}^{2} \\\\  & =\\frac{1}{4}({({e}^{x}+{e}^{-x})}^{2}-{({e}^{x}-{e}^{-x})}^{2}) \\\\  & =\\frac{1}{4}({e}^{2x}+2+{e}^{-2x}-({e}^{2x}-2+{e}^{-2x})) \\\\  & =\\frac{1}{4}(\\cancel{{e}^{2x}}+2+\\cancel{{e}^{-2x}}-(\\cancel{{e}^{2x}}-2+\\cancel{{e}^{-2x}})) \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1\\,✓\\end{aligned}\n$$" "It's possible to convert every trigonometric identity to a corresponding *hyperbolic* identity using **Osborn's rule.** \n\nTo apply Osborn's rule, we follow two steps:\n\n1\\. Replace every trigonometric function with its corresponding hyperbolic function.\n\n2\\. For any product of *two trigonometric sines*, change the sign of the corresponding product of hyperbolic sines.\n\nTo demonstrate, consider the Pythagorean trigonometric identity:\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n\\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\cos^2 x \\:{\\color{blue}{\\boldsymbol +}}\\: \\sin^2 x = 1\n$$\n\nNotice that this trigonometric identity contains a product of two sines. Therefore, to find the corresponding hyperbolic identity, we change each trigonometric function to its corresponding hyperbolic counterpart and change the sign in front of the corresponding product of sines. \n\nThus, the corresponding hyperbolic identity is\n\n$$\n\\cosh^2 x \\:{\\color{red}{\\boldsymbol -}}\\: \\sinh^2 x = 1.\n$$\n\n \n\nWe can check that this identity is indeed true using the definitions of the hyperbolic sine and cosine:\n\n$$\n\\begin{aligned}{\\cosh }^{2}⁡x-{\\sinh }^{2}⁡x & ={(\\frac{1}{2}({e}^{x}+{e}^{-x}))}^{2}-{(\\frac{1}{2}({e}^{x}-{e}^{-x}))}^{2} \\\\  & =\\frac{1}{4}{({e}^{x}+{e}^{-x})}^{2}-\\frac{1}{4}{({e}^{x}-{e}^{-x})}^{2} \\\\  & =\\frac{1}{4}({({e}^{x}+{e}^{-x})}^{2}-{({e}^{x}-{e}^{-x})}^{2}) \\\\  & =\\frac{1}{4}({e}^{2x}+2+{e}^{-2x}-({e}^{2x}-2+{e}^{-2x})) \\\\  & =\\frac{1}{4}(\\cancel{{e}^{2x}}+2+\\cancel{{e}^{-2x}}-(\\cancel{{e}^{2x}}-2+\\cancel{{e}^{-2x}})) \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1\\,✓\\end{aligned}\n$$"] [:db/cas 17592186168118 :tutorial/content "We can compute integrals containing hyperbolic functions using the hyperbolic counterparts of the Pythagorean identity. We use Osborn's rule to convert a trigonometric identity to a corresponding hyperbolic identity. \n\nOsborn's rule states that to convert a trigonometric identity to a corresponding hyperbolic identity, we\n\n- replace every trigonometric function with its corresponding hyperbolic function, and\n\n- for any product of two trigonometric sines, change the sign of the corresponding product of hyperbolic sines.\n\n$\\displaystyle \n        \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor example, suppose we want to calculate the following integral:\n\n$$\n\\int \\cosh^2{x} - \\sinh^2{x} \\: \\textrm{d}x\n$$\n\nFirst, we recall the Pythagorean identity\n\n$$\n\\cos^2{x} + \\sin^2{x} = 1.\n$$\n\nUsing Osborn's rule, we get the corresponding hyperbolic identity\n\n$$\n\\cosh^2{x} - \\sinh^2{x} = 1.\n$$\n\nTherefore, we evaluate our integral as follows:\n\n$$\n\\begin{aligned}\\int \\underbrace{{cosh}^{2}⁡x-{sinh}^{2}⁡x}_{1}\\,\\text{d}x=\\int 1\\,\\text{d}x=x+C\\end{aligned}\n$$\n\nLet's see another example." "We can compute integrals containing hyperbolic functions using the hyperbolic counterparts of the Pythagorean identity. We use Osborn's rule to convert a trigonometric identity to a corresponding hyperbolic identity. \n\nOsborn's rule states that to convert a trigonometric identity to a corresponding hyperbolic identity, we\n\n- replace every trigonometric function with its corresponding hyperbolic function, and\n\n- for any product of two trigonometric sines, change the sign of the corresponding product of hyperbolic sines.\n\n$\\displaystyle \n        \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor example, suppose we want to calculate the following integral:\n\n$$\n\\int \\cosh^2{x} - \\sinh^2{x} \\: \\textrm{d}x\n$$\n\nFirst, we recall the Pythagorean identity\n\n$$\n\\cos^2{x} + \\sin^2{x} = 1.\n$$\n\nUsing Osborn's rule, we get the corresponding hyperbolic identity\n\n$$\n\\cosh^2{x} - \\sinh^2{x} = 1.\n$$\n\nTherefore, we evaluate our integral as follows:\n\n$$\n\\begin{aligned}\\int \\underbrace{{\\cosh }^{2}⁡x-{\\sinh }^{2}⁡x}_{1}\\,\\text{d}x=\\int 1\\,\\text{d}x=x+C\\end{aligned}\n$$\n\nLet's see another example."] [:db/cas 17592186168119 :tutorial/content "$\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$We can use Osborn's rule to write down the hyperbolic equivalents of the sectant-tangent and cotangent-cosecant identities.\n\nFrom the secant-tangent identity\n\n$$\n1 + \\tan^2 x = \\sec^2 x\n$$\n\nwe have the equivalent hyperbolic identity\n\n$$\n1 - \\tanh^2 x = \\sech^2 x.\n$$\n\nSimilarly, from the cotangent-cosecant identity\n\n$$\n1+\\cot^2 x = \\csc^2 x\n$$\n\nwe have the equivalent hyperbolic identity\n\n$$\n1-\\coth^2 x  = -\\csch^2 x\n$$\n\nwhich we can rewrite as\n\n$$\n\\coth^2 x - 1 = \\csch^2 x.\n$$\n\nThese identities can be used to solve certain integrals involving the expressions $\\tanh^2{x},$ $\\coth^2 x,$ $\\sech^2 x,$ or $\\csch^2{x}.$" "$\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$We can use Osborn's rule to write down the hyperbolic equivalents of the sectant-tangent and cotangent-cosecant identities.\n\nFrom the secant-tangent identity\n\n$$\n1 + \\tan^2 x = \\sec^2 x\n$$\n\nwe have the equivalent hyperbolic identity\n\n$$\n1 - \\tanh^2 x = \\operatorname{sech} ^2 x.\n$$\n\nSimilarly, from the cotangent-cosecant identity\n\n$$\n1+\\cot^2 x = \\csc^2 x\n$$\n\nwe have the equivalent hyperbolic identity\n\n$$\n1-\\coth^2 x  = -\\operatorname{csch} ^2 x\n$$\n\nwhich we can rewrite as\n\n$$\n\\coth^2 x - 1 = \\operatorname{csch} ^2 x.\n$$\n\nThese identities can be used to solve certain integrals involving the expressions $\\tanh^2{x},$ $\\coth^2 x,$ $\\operatorname{sech} ^2 x,$ or $\\operatorname{csch} ^2{x}.$"] [:db/cas 17592186168120 :tutorial/content "We can compute integrals containing hyperbolic functions using the hyperbolic counterparts of the trigonometric double-angle formulas. We use Osborn's rule to convert a trigonometric identity to a corresponding hyperbolic identity. \n\nOsborn's rule states that to convert a trigonometric identity to a corresponding hyperbolic identity, we\n\n- replace every trigonometric function with its corresponding hyperbolic function, and\n\n- for any product of two trigonometric sines, change the sign of the corresponding product of hyperbolic sines.\n\n$\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n        \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n        \\newcommand{\\tanh}{\\mathop{\\rm tanh}\\nolimits}\n        \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor example, let's consider the following integral:\n\n$$\n\\displaystyle{\\int} \\sinh x \\cosh x \\, \\textrm{d}x\n$$\n\n  \n\nNotice that the corresponding trigonometric integral is\n\n$$\n\\displaystyle{\\int} \\sin x \\cos x \\, \\textrm{d}x.\n$$\n\n  \n\nOne way of solving this trigonometric integral is to use the double-angle formula for sine:\n\n$$\n\\sin 2x = 2\\sin x \\cos x\n$$\n\nApplying Osborn's rule, we get an equivalent hyperbolic identity:\n\n$$\n\\sinh 2x = 2\\sinh x \\cosh x\n$$\n\nRearranging the above formula, we get\n\n$$\n\\dfrac{1}{2}\\sinh {2x}= \\sinh x \\cosh x.\n$$\n\n \n\nTherefore, we can calculate our original integral as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{sinh}⁡x\\operatorname{cosh}⁡x\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{2}\\operatorname{cosh}⁡2x+C \\\\  & =\\frac{1}{4}\\operatorname{cosh}⁡2x+C\\end{aligned}\n$$" "We can compute integrals containing hyperbolic functions using the hyperbolic counterparts of the trigonometric double-angle formulas. We use Osborn's rule to convert a trigonometric identity to a corresponding hyperbolic identity. \n\nOsborn's rule states that to convert a trigonometric identity to a corresponding hyperbolic identity, we\n\n- replace every trigonometric function with its corresponding hyperbolic function, and\n\n- for any product of two trigonometric sines, change the sign of the corresponding product of hyperbolic sines.\n\n$\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n        \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n        \\newcommand{\\tanh}{\\mathop{\\rm tanh}\\nolimits}\n        \\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor example, let's consider the following integral:\n\n$$\n\\displaystyle{\\int} \\sinh x \\cosh x \\, \\textrm{d}x\n$$\n\n  \n\nNotice that the corresponding trigonometric integral is\n\n$$\n\\displaystyle{\\int} \\sin x \\cos x \\, \\textrm{d}x.\n$$\n\n  \n\nOne way of solving this trigonometric integral is to use the double-angle formula for sine:\n\n$$\n\\sin 2x = 2\\sin x \\cos x\n$$\n\nApplying Osborn's rule, we get an equivalent hyperbolic identity:\n\n$$\n\\sinh 2x = 2\\sinh x \\cosh x\n$$\n\nRearranging the above formula, we get\n\n$$\n\\dfrac{1}{2}\\sinh {2x}= \\sinh x \\cosh x.\n$$\n\n \n\nTherefore, we can calculate our original integral as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{sinh}⁡x\\operatorname{cosh}⁡x\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{2}\\operatorname{cosh}⁡2x+C \\\\  & =\\frac{1}{4}\\operatorname{cosh}⁡2x+C\\end{aligned}\n$$"] [:db/cas 17592186168126 :tutorial/content "The **hyperbolic secant** is the reciprocal of the hyperbolic cosine:\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\n$$\ny = \\sech{x} = \\dfrac{1}{\\cosh{x}} = \\dfrac{2}{e^x+e^{-x}}\n$$\n\nTo plot the graph of $y=\\sech x$, we create a table with some values, rounded to the nearest hundredth.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$x$</strong></td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\cosh x$</td>\n<td data-cell-align=\"center\">$27.31$</td>\n<td data-cell-align=\"center\">$10.07$</td>\n<td data-cell-align=\"center\">$3.76$</td>\n<td data-cell-align=\"center\">$1.54$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1.54$</td>\n<td data-cell-align=\"center\">$3.76$</td>\n<td data-cell-align=\"center\">$10.07$</td>\n<td data-cell-align=\"center\">$27.31$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\sech x$</td>\n<td data-cell-align=\"center\">$0.04$</td>\n<td data-cell-align=\"center\">$0.10$</td>\n<td data-cell-align=\"center\">$0.27$</td>\n<td data-cell-align=\"center\">$0.65$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0.65$</td>\n<td data-cell-align=\"center\">$0.27$</td>\n<td data-cell-align=\"center\">$0.10$</td>\n<td data-cell-align=\"center\">$0.04$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we get the following curves:\n\n![](images/53/5370161b731c9bda369b732ab62e71bcba59b1b12d5cb22c359b3ec7577114ff.png)\n\nWe can summarize some of the basic properties of hyperbolic secant from its graph.\n\n- The domain is $(-\\infty,\\infty)$ and the range is $(0,1]$.\n- It's an even function (the graph is symmetric about the $y$-axis).\n- It has no zeros.\n- Its maximum value occurs at $x=0$.\n- Its graph is increasing over $(-\\infty,0)$ and is decreasing over $(0,\\infty)$. Moreover,$\\qquad$ $\\sech{x} \\to 0$ as $x \\to \\pm\\infty$." "The **hyperbolic secant** is the reciprocal of the hyperbolic cosine:\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\n$$\ny = \\operatorname{sech} {x} = \\dfrac{1}{\\cosh{x}} = \\dfrac{2}{e^x+e^{-x}}\n$$\n\nTo plot the graph of $y=\\operatorname{sech}  x$, we create a table with some values, rounded to the nearest hundredth.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$x$</strong></td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\cosh x$</td>\n<td data-cell-align=\"center\">$27.31$</td>\n<td data-cell-align=\"center\">$10.07$</td>\n<td data-cell-align=\"center\">$3.76$</td>\n<td data-cell-align=\"center\">$1.54$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1.54$</td>\n<td data-cell-align=\"center\">$3.76$</td>\n<td data-cell-align=\"center\">$10.07$</td>\n<td data-cell-align=\"center\">$27.31$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\operatorname{sech}  x$</td>\n<td data-cell-align=\"center\">$0.04$</td>\n<td data-cell-align=\"center\">$0.10$</td>\n<td data-cell-align=\"center\">$0.27$</td>\n<td data-cell-align=\"center\">$0.65$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0.65$</td>\n<td data-cell-align=\"center\">$0.27$</td>\n<td data-cell-align=\"center\">$0.10$</td>\n<td data-cell-align=\"center\">$0.04$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we get the following curves:\n\n![](images/53/5370161b731c9bda369b732ab62e71bcba59b1b12d5cb22c359b3ec7577114ff.png)\n\nWe can summarize some of the basic properties of hyperbolic secant from its graph.\n\n- The domain is $(-\\infty,\\infty)$ and the range is $(0,1]$.\n- It's an even function (the graph is symmetric about the $y$-axis).\n- It has no zeros.\n- Its maximum value occurs at $x=0$.\n- Its graph is increasing over $(-\\infty,0)$ and is decreasing over $(0,\\infty)$. Moreover,$\\qquad$ $\\operatorname{sech} {x} \\to 0$ as $x \\to \\pm\\infty$."] [:db/cas 17592186168127 :tutorial/content "The **hyperbolic cosecant** is the reciprocal of the hyperbolic sine:\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\n$$\ny = \\csch{x} = \\dfrac{1}{\\sinh{x}} = \\dfrac{2}{e^x-e^{-x}}\n$$\n\nTo plot the graph of $y=\\csch x$, we create a table with some values, rounded to the nearest hundredth.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$x$</strong></td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,\\sinh x\\,$</td>\n<td data-cell-align=\"center\">$-27.29$</td>\n<td data-cell-align=\"center\">$-10.02$</td>\n<td data-cell-align=\"center\">$-3.63$</td>\n<td data-cell-align=\"center\">$-1.18$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1.18$</td>\n<td data-cell-align=\"center\">$3.63$</td>\n<td data-cell-align=\"center\">$10.02$</td>\n<td data-cell-align=\"center\">$27.29$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\csch x$</td>\n<td data-cell-align=\"center\">$-0.04$</td>\n<td data-cell-align=\"center\">$-0.10$</td>\n<td data-cell-align=\"center\">$-0.28$</td>\n<td data-cell-align=\"center\">$-0.85$</td>\n<td data-cell-align=\"center\">$\\text{undef.}$</td>\n<td data-cell-align=\"center\">$0.85$</td>\n<td data-cell-align=\"center\">$0.28$</td>\n<td data-cell-align=\"center\">$0.10$</td>\n<td data-cell-align=\"center\">$0.04$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we get the following curves:\n\n![](images/42/426fc7b972acb4a32935967497925b1a0f194f8adfcf8cf232e4edfcb34ce3cc.png)\n\nWe can summarize some of the basic properties of hyperbolic cosecant from its graph.\n\n- The domain and range are $(-\\infty,0) \\cup (0,\\infty)$.\n- It's an odd function (the graph has rotational symmetry of order $2$ about the origin).\n- It has no zeros.\n- Its graph is decreasing over the entire domain. Moreover:$\\qquad$ $\\csch{x} \\to 0$ as $x \\to \\pm\\infty$ $\\qquad$ $\\csch{x} \\to -\\infty$ as $x \\to 0^-$$\\qquad$ $\\csch{x} \\to \\infty$ as $x \\to 0^+$" "The **hyperbolic cosecant** is the reciprocal of the hyperbolic sine:\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\n$$\ny = \\operatorname{csch} {x} = \\dfrac{1}{\\sinh{x}} = \\dfrac{2}{e^x-e^{-x}}\n$$\n\nTo plot the graph of $y=\\operatorname{csch}  x$, we create a table with some values, rounded to the nearest hundredth.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$x$</strong></td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,\\sinh x\\,$</td>\n<td data-cell-align=\"center\">$-27.29$</td>\n<td data-cell-align=\"center\">$-10.02$</td>\n<td data-cell-align=\"center\">$-3.63$</td>\n<td data-cell-align=\"center\">$-1.18$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1.18$</td>\n<td data-cell-align=\"center\">$3.63$</td>\n<td data-cell-align=\"center\">$10.02$</td>\n<td data-cell-align=\"center\">$27.29$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\operatorname{csch}  x$</td>\n<td data-cell-align=\"center\">$-0.04$</td>\n<td data-cell-align=\"center\">$-0.10$</td>\n<td data-cell-align=\"center\">$-0.28$</td>\n<td data-cell-align=\"center\">$-0.85$</td>\n<td data-cell-align=\"center\">$\\text{undef.}$</td>\n<td data-cell-align=\"center\">$0.85$</td>\n<td data-cell-align=\"center\">$0.28$</td>\n<td data-cell-align=\"center\">$0.10$</td>\n<td data-cell-align=\"center\">$0.04$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we get the following curves:\n\n![](images/42/426fc7b972acb4a32935967497925b1a0f194f8adfcf8cf232e4edfcb34ce3cc.png)\n\nWe can summarize some of the basic properties of hyperbolic cosecant from its graph.\n\n- The domain and range are $(-\\infty,0) \\cup (0,\\infty)$.\n- It's an odd function (the graph has rotational symmetry of order $2$ about the origin).\n- It has no zeros.\n- Its graph is decreasing over the entire domain. Moreover:$\\qquad$ $\\operatorname{csch} {x} \\to 0$ as $x \\to \\pm\\infty$ $\\qquad$ $\\operatorname{csch} {x} \\to -\\infty$ as $x \\to 0^-$$\\qquad$ $\\operatorname{csch} {x} \\to \\infty$ as $x \\to 0^+$"] [:db/cas 17592186168128 :tutorial/content "The **hyperbolic cotangent** is the reciprocal of the hyperbolic tangent:\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} y = \\coth{x} = \\dfrac{\\cosh{x}}{\\sinh{x}} = \\dfrac{e^x+e^{-x}}{e^x-e^{-x}}\n$$\n\nCreating a table of values and plotting the points in the usual way, we get the following curves:\n\n![](images/97/971820e7f7714f95f6745c90bbee9c4c9265f463446b433929b9412f4e8625b7.png)\n\nWe can summarize some of the basic properties of hyperbolic cotangent from its graph.\n\n- The domain is $(-\\infty,0) \\cup (0,\\infty)$ and the range is $(-\\infty,-1) \\cup (1,\\infty)$.\n- It's an odd function (the graph has rotational symmetry of order $2$ about the origin).\n- It has no zeros.\n- Its graph is decreasing over the entire domain. Moreover:$\\qquad$ $\\coth{x} \\to -1$ as $x \\to -\\infty$ $\\qquad$ $\\coth{x} \\to 1$ as $x \\to \\infty$ $\\qquad$ $\\coth{x} \\to -\\infty$ as $x \\to 0^-$ $\\qquad$ $\\coth{x} \\to \\infty$ as $x \\to 0^+$" "The **hyperbolic cotangent** is the reciprocal of the hyperbolic tangent:\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits} \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits} \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} y = \\coth{x} = \\dfrac{\\cosh{x}}{\\sinh{x}} = \\dfrac{e^x+e^{-x}}{e^x-e^{-x}}\n$$\n\nCreating a table of values and plotting the points in the usual way, we get the following curves:\n\n![](images/97/971820e7f7714f95f6745c90bbee9c4c9265f463446b433929b9412f4e8625b7.png)\n\nWe can summarize some of the basic properties of hyperbolic cotangent from its graph.\n\n- The domain is $(-\\infty,0) \\cup (0,\\infty)$ and the range is $(-\\infty,-1) \\cup (1,\\infty)$.\n- It's an odd function (the graph has rotational symmetry of order $2$ about the origin).\n- It has no zeros.\n- Its graph is decreasing over the entire domain. Moreover:$\\qquad$ $\\coth{x} \\to -1$ as $x \\to -\\infty$ $\\qquad$ $\\coth{x} \\to 1$ as $x \\to \\infty$ $\\qquad$ $\\coth{x} \\to -\\infty$ as $x \\to 0^-$ $\\qquad$ $\\coth{x} \\to \\infty$ as $x \\to 0^+$"] [:db/cas 17592186168152 :tutorial/content "Suppose we want to calculate the integral\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\n\\int \\dfrac{1}{\\sinh^2 x}\\,\\textrm{d}x.\n$$\n\nFirst, we note the following hyperbolic identity:\n\n$$\n\\csch{x} = \\dfrac{1}{\\sinh{x}}\n$$\n\nTherefore, we can write our integral as\n\n$$\n\\int \\dfrac{1}{\\sinh^2{x}} \\,\\textrm{d}x\n= \\int \\left(\\dfrac{1}{\\sinh{x}}\\right)^2 \\,\\textrm{d}x\n= \\int \\csch^2{x} \\,\\textrm{d}x.\n$$\n\nFrom here, we can see that this is just a standard hyperbolic integral:\n\n$$\n\\int \\dfrac{1}{\\sinh^2{x}}\\,\\textrm{d}x = \\int \\csch^2{x}\\,\\textrm{d}x = -\\coth{x} + C\n$$" "Suppose we want to calculate the integral\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n        \\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n        \\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n        \\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n        \\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n\n\\int \\dfrac{1}{\\sinh^2 x}\\,\\textrm{d}x.\n$$\n\nFirst, we note the following hyperbolic identity:\n\n$$\n\\operatorname{csch} {x} = \\dfrac{1}{\\sinh{x}}\n$$\n\nTherefore, we can write our integral as\n\n$$\n\\int \\dfrac{1}{\\sinh^2{x}} \\,\\textrm{d}x\n= \\int \\left(\\dfrac{1}{\\sinh{x}}\\right)^2 \\,\\textrm{d}x\n= \\int \\operatorname{csch} ^2{x} \\,\\textrm{d}x.\n$$\n\nFrom here, we can see that this is just a standard hyperbolic integral:\n\n$$\n\\int \\dfrac{1}{\\sinh^2{x}}\\,\\textrm{d}x = \\int \\operatorname{csch} ^2{x}\\,\\textrm{d}x = -\\coth{x} + C\n$$"] [:db/cas 17592186168153 :tutorial/content "When applying Osborn's rule, we must be aware that sometimes a product of two sines is \"hidden.\"\n\nTo demonstrate, consider the following trigonometric identity:\n\n$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n\\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n1 \\:{\\color{blue}{\\boldsymbol +}}\\: \\tan^2 x = \\sec^2 x\n$$\n\nAt first glance, it may seem that there is no product of sines, and we do not need to change any signs in the corresponding hyperbolic identity.\n\nHowever, recall that\n\n$$\n\\tan x = \\dfrac{\\sin x}{\\cos x}\n$$\n\nwhich implies that\n\n$$\n\\tan^2 x = \\dfrac{\\sin^2 x}{\\cos^2 x}.\n$$\n\nSo, there is a hidden product of sines within the $\\tan^2 x$ term, and we need to flip the sign in front of this term when writing down the corresponding hyperbolic identity.\n\nThus, the corresponding hyperbolic identity is\n\n$$\n1 \\:{\\color{red}{\\boldsymbol -}}\\: \\tanh^2 x = \\sech^2 x.\n$$" "When applying Osborn's rule, we must be aware that sometimes a product of two sines is \"hidden.\"\n\nTo demonstrate, consider the following trigonometric identity:\n\n$$\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n\\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n1 \\:{\\color{blue}{\\boldsymbol +}}\\: \\tan^2 x = \\sec^2 x\n$$\n\nAt first glance, it may seem that there is no product of sines, and we do not need to change any signs in the corresponding hyperbolic identity.\n\nHowever, recall that\n\n$$\n\\tan x = \\dfrac{\\sin x}{\\cos x}\n$$\n\nwhich implies that\n\n$$\n\\tan^2 x = \\dfrac{\\sin^2 x}{\\cos^2 x}.\n$$\n\nSo, there is a hidden product of sines within the $\\tan^2 x$ term, and we need to flip the sign in front of this term when writing down the corresponding hyperbolic identity.\n\nThus, the corresponding hyperbolic identity is\n\n$$\n1 \\:{\\color{red}{\\boldsymbol -}}\\: \\tanh^2 x = \\operatorname{sech} ^2 x.\n$$"] [:db/cas 17592186170354 :answer/value "Y∼Exp(4)" "Y∼\\operatorname{Exp} (4)"] [:db/cas 17592186170355 :answer/value "Y∼Exp(2)" "Y∼\\operatorname{Exp} (2)"] [:db/cas 17592186170356 :answer/value "Y∼Exp(3)" "Y∼\\operatorname{Exp} (3)"] [:db/cas 17592186171712 :question/worked-solution "Notice that $y=e^{x/2} \\geq 0$ for all $x \\in [0,2].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)=e^{x/2},$ and \n\n$$\nD = \\big\\{ (x,\\theta) \\: : \\: 0 \\leq x \\leq 2, \\: 0 \\leq \\theta \\lt 2\\pi \\big\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f=e^{x/2},$ we obtain $f' = \\dfrac12 e^{x/2}.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′}=⟨\\frac{1}{2}{e}^{x},\\,-{e}^{x/2}\\operatorname{cos}⁡\\theta ,\\,-{e}^{x/2}\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nTherefore, the $1$st component of the product is $\\dfrac{1}{2}e^x.$" "Notice that $y=e^{x/2} \\geq 0$ for all $x \\in [0,2].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)=e^{x/2},$ and \n\n$$\nD = \\big\\{ (x,\\theta) \\: : \\: 0 \\leq x \\leq 2, \\: 0 \\leq \\theta \\lt 2\\pi \\big\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨f{f}^{′}{\\cos }^{2}⁡\\theta +f{f}^{′}{\\sin }^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f=e^{x/2},$ we obtain $f' = \\dfrac12 e^{x/2}.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′}=⟨\\frac{1}{2}{e}^{x},\\,-{e}^{x/2}\\operatorname{cos}⁡\\theta ,\\,-{e}^{x/2}\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nTherefore, the $1$st component of the product is $\\dfrac{1}{2}e^x.$"] [:db/cas 17592186171713 :question/worked-solution "Notice that $x=\\sin z \\geq 0$ for all $z \\in [0, \\pi].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{cos}⁡\\theta ,\\,f(z)\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,(z,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(z)=\\sin z,$ and\n\n$$\nD = \\big\\{ (z,\\theta) \\, : \\, 0 \\leq z \\leq \\pi , \\, 0 \\leq \\theta \\leq 2\\pi\\big\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{z}^{′} & =⟨\\frac{∂x}{∂z},\\,\\frac{∂y}{∂z},\\,\\frac{∂z}{∂z}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ,\\,1⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ,\\,0⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta  & 0\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & 0\\end{vmatrix},\\,-\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{vmatrix},\\,\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f{cos}^{2}⁡\\theta +{f}^{′}f{sin}^{2}⁡\\theta ⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f⟩.\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}+({f}^{′}f)^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}z\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}z \\\\  & =2\\pi {\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z.\\end{aligned}\n$$\n\nSince $f(z)=\\sin z,$ we obtain $f'(z) = \\cos z.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡z\\sqrt{1+(\\operatorname{cos}⁡z)^{2}}\\,\\text{d}z \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡z\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}z.\\end{aligned}\n$$" "Notice that $x=\\sin z \\geq 0$ for all $z \\in [0, \\pi].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{cos}⁡\\theta ,\\,f(z)\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,(z,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(z)=\\sin z,$ and\n\n$$\nD = \\big\\{ (z,\\theta) \\, : \\, 0 \\leq z \\leq \\pi , \\, 0 \\leq \\theta \\leq 2\\pi\\big\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{z}^{′} & =⟨\\frac{∂x}{∂z},\\,\\frac{∂y}{∂z},\\,\\frac{∂z}{∂z}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ,\\,1⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ,\\,0⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta  & 0\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & 0\\end{vmatrix},\\,-\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{vmatrix},\\,\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f{\\cos }^{2}⁡\\theta +{f}^{′}f{\\sin }^{2}⁡\\theta ⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f⟩.\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}+({f}^{′}f)^{2}} \\\\  & =\\sqrt{{f}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}z\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}z \\\\  & =2\\pi {\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z.\\end{aligned}\n$$\n\nSince $f(z)=\\sin z,$ we obtain $f'(z) = \\cos z.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{0}^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡z\\sqrt{1+(\\operatorname{cos}⁡z)^{2}}\\,\\text{d}z \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡z\\sqrt{1+{\\cos }^{2}⁡z}\\,\\text{d}z.\\end{aligned}\n$$"] [:db/cas 17592186171725 :question/worked-solution "Given nonempty sets $A$ and $B$, if either $A$ or $B$ is infinite, then\n\n$$\n\\big| A \\times B \\big| = \\max \\{ |A|, |B| \\}.\n$$\n\nAlso, note that\n\n$$\n2^{\\aleph_0} = \\mathfrak{c}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}|\\mathcal{P}((0,1))\\times \\mathcal{P}(\\mathbb{N})| & =max\\{|\\mathcal{P}((0,1))|,|\\mathcal{P}(\\mathbb{N})|\\} \\\\  & =max\\{{2}^{\\mathfrak{c}},{2}^{{\\mathrm{ℵ}}_{0}}\\} \\\\  & =max\\{{2}^{\\mathfrak{c}},\\mathfrak{c}\\} \\\\  & ={2}^{\\mathfrak{c}}.\\end{aligned}\n$$" "Given nonempty sets $A$ and $B$, if either $A$ or $B$ is infinite, then\n\n$$\n\\big| A \\times B \\big| = \\max \\{ |A|, |B| \\}.\n$$\n\nAlso, note that\n\n$$\n2^{\\aleph_0} = \\mathfrak{c}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}|\\mathcal{P}((0,1))\\times \\mathcal{P}(\\mathbb{N})| & =\\max \\{|\\mathcal{P}((0,1))|,|\\mathcal{P}(\\mathbb{N})|\\} \\\\  & =\\max \\{{2}^{\\mathfrak{c}},{2}^{{\\mathrm{ℵ}}_{0}}\\} \\\\  & =\\max \\{{2}^{\\mathfrak{c}},\\mathfrak{c}\\} \\\\  & ={2}^{\\mathfrak{c}}.\\end{aligned}\n$$"] [:db/cas 17592186171753 :question/worked-solution "Let's write down the formal statement $P$ that we wish to prove:\n$\\phantom{\\lnot}P: \\quad \\forall n \\in \\mathbb Z,\\: 4 \\not\\mid (n^4 - 11)$\n\nTo prove that $P$ is true, we assume that $\\lnot P$ is true and show this leads to a contradiction.\n$\\lnot P: \\quad \\exists n\\in \\mathbb Z,\\: 4 \\mid (n^4 - 11)$\n\nWe begin our proof as follows:\n\n> Assume, for a contradiction, that $4 \\mid (n^4 - 11)$. Then, $n^4 - 11 = 4k$, where $k$ is an integer.\n\nSince the problem relates to divisibility by $4$, let's write the equation\n\n$$\nn^4 - 11 = 4k\n$$\n\nin terms of congruence modulo $4$.\n\n> Therefore, we have the following chain of equivalences:\n> $$\n\\begin{aligned}{n}^{4}-11=4k\\hspace{1em} & ⇔\\hspace{1em}{n}^{4}=4k+11 \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡4k+11\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡11\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡11-4\\cdot 2\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡3\\hspace{1em} &  & (\\text{mod }4)\\end{aligned}\n$$\n\nThis gives us the residue of $n^4$ modulo $4{:}$\n\n> Hence, we have that $n^4 \\textrm{mod} 4 = 3$.\n\nNow, let's calculate all possible residues of $n^4$ modulo $4$. To do that, we substitute $n=0,1,2,3$ into $n^4$ and compute the residues:\n\n$$\n\\begin{aligned}\n0^{4}mod4 &= 0 \\\\\n1^{4}mod4 &= 1 \\\\\n2^{4}mod4 &= 0 \\\\\n3^{4}mod4 &= 1\n\\end{aligned}\n$$\n\nNotice that there are only two residues possible. So, we proceed as follows:\n\n> However, substituting $n = 0,1,2,3$ into the expression $n^4$, we obtain that\n> $n^4 \\textrm{mod} 4 \\in R = \\{0,1\\}$.\n> But this is a contradiction since $n^4 \\textrm{mod} 3 = 3$ by assumption.\n\nSince we have a contradiction, our original assumption must be incorrect. Hence, we write our conclusion as follows:\n\n> Therefore, we conclude that $4 \\not\\mid (n^4 - 11)$." "Let's write down the formal statement $P$ that we wish to prove:\n$\\phantom{\\lnot}P: \\quad \\forall n \\in \\mathbb Z,\\: 4 \\not\\mid (n^4 - 11)$\n\nTo prove that $P$ is true, we assume that $\\lnot P$ is true and show this leads to a contradiction.\n$\\lnot P: \\quad \\exists n\\in \\mathbb Z,\\: 4 \\mid (n^4 - 11)$\n\nWe begin our proof as follows:\n\n> Assume, for a contradiction, that $4 \\mid (n^4 - 11)$. Then, $n^4 - 11 = 4k$, where $k$ is an integer.\n\nSince the problem relates to divisibility by $4$, let's write the equation\n\n$$\nn^4 - 11 = 4k\n$$\n\nin terms of congruence modulo $4$.\n\n> Therefore, we have the following chain of equivalences:\n> $$\n\\begin{aligned}{n}^{4}-11=4k\\hspace{1em} & ⇔\\hspace{1em}{n}^{4}=4k+11 \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡4k+11\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡11\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡11-4\\cdot 2\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}{n}^{4}≡3\\hspace{1em} &  & (\\text{mod }4)\\end{aligned}\n$$\n\nThis gives us the residue of $n^4$ modulo $4{:}$\n\n> Hence, we have that $n^4 \\textrm{mod} 4 = 3$.\n\nNow, let's calculate all possible residues of $n^4$ modulo $4$. To do that, we substitute $n=0,1,2,3$ into $n^4$ and compute the residues:\n\n$$\n\\begin{aligned}\n0^{4}\\bmod 4 &= 0 \\\\\n1^{4}\\bmod 4 &= 1 \\\\\n2^{4}\\bmod 4 &= 0 \\\\\n3^{4}\\bmod 4 &= 1\n\\end{aligned}\n$$\n\nNotice that there are only two residues possible. So, we proceed as follows:\n\n> However, substituting $n = 0,1,2,3$ into the expression $n^4$, we obtain that\n> $n^4 \\textrm{mod} 4 \\in R = \\{0,1\\}$.\n> But this is a contradiction since $n^4 \\textrm{mod} 3 = 3$ by assumption.\n\nSince we have a contradiction, our original assumption must be incorrect. Hence, we write our conclusion as follows:\n\n> Therefore, we conclude that $4 \\not\\mid (n^4 - 11)$."] [:db/cas 17592186171755 :question/worked-solution "Let's write down the formal statement $P$ that we wish to prove:\n\n$$\n\\phantom{\\lnot}P: \\quad \\forall n\\in \\mathbb Z,\\: 4 \\not\\mid (14n+1)\n$$\n\nTo prove that $P$ is true, we assume that $\\lnot P$ is true and show this leads to a contradiction.\n\n$$\n\\lnot P: \\quad \\exists n\\in \\mathbb Z,\\: 4 \\mid (14n+1)\n$$\n\nWe begin our proof as follows:\n\n> Assume, for a contradiction, that $4 \\mid (14n+1)$. Then, $14n+1=4k$, where $k$ is an integer.\n\nSince the problem relates to divisibility by $4$, let's write the equation\n\n$$\n14n+1=4k\n$$\n\nin terms of congruence modulo $4$.\n\n> Therefore, we have the following chain of equivalences:\n> $$\n\\begin{aligned}14n+1=4k\\hspace{1em} & ⇔\\hspace{1em}14n=4k-1 \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡4k-1\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡-1\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡-1+4\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡3\\hspace{1em} &  & (\\text{mod }4)\\end{aligned}\n$$\n\nThis gives us the residue of $14n$ modulo $4{:}$\n\n> Hence, we have that $14n \\textrm{mod} 4 = 3$.\n\nNow, let's calculate all possible residues of $14n$ modulo $4$. To do that, we substitute $n=0,1,2,3$ into $14n$ and compute the residues:\n\n$$\n\\begin{aligned}\n14 \\cdot 0mod4 &= 0 \\\\\n14 \\cdot 1mod4 &= 2 \\\\\n14 \\cdot 2mod4 &= 0 \\\\\n14 \\cdot 3mod4 &= 2\n\\end{aligned}\n$$\n\nNotice that there are only two residues possible. So, we proceed as follows:\n\n> However, substituting $n=0,1,2,3$ into the expression $14n$, we obtain that\n> $14n \\textrm{mod} 4 \\in \\{0,2\\}$.\n> But this is a contradiction since $14n \\textrm{mod} 4 = 3$ by assumption.\n\nSince we have a contradiction, our original assumption must be incorrect. Hence, we write our conclusion as follows:\n\n> Therefore, we conclude that $4 \\not\\mid (14n+1)$." "Let's write down the formal statement $P$ that we wish to prove:\n\n$$\n\\phantom{\\lnot}P: \\quad \\forall n\\in \\mathbb Z,\\: 4 \\not\\mid (14n+1)\n$$\n\nTo prove that $P$ is true, we assume that $\\lnot P$ is true and show this leads to a contradiction.\n\n$$\n\\lnot P: \\quad \\exists n\\in \\mathbb Z,\\: 4 \\mid (14n+1)\n$$\n\nWe begin our proof as follows:\n\n> Assume, for a contradiction, that $4 \\mid (14n+1)$. Then, $14n+1=4k$, where $k$ is an integer.\n\nSince the problem relates to divisibility by $4$, let's write the equation\n\n$$\n14n+1=4k\n$$\n\nin terms of congruence modulo $4$.\n\n> Therefore, we have the following chain of equivalences:\n> $$\n\\begin{aligned}14n+1=4k\\hspace{1em} & ⇔\\hspace{1em}14n=4k-1 \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡4k-1\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡-1\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡-1+4\\hspace{1em} &  & (\\text{mod }4) \\\\ \\hspace{1em} & ⇔\\hspace{1em}14n≡3\\hspace{1em} &  & (\\text{mod }4)\\end{aligned}\n$$\n\nThis gives us the residue of $14n$ modulo $4{:}$\n\n> Hence, we have that $14n \\textrm{mod} 4 = 3$.\n\nNow, let's calculate all possible residues of $14n$ modulo $4$. To do that, we substitute $n=0,1,2,3$ into $14n$ and compute the residues:\n\n$$\n\\begin{aligned}\n14 \\cdot 0\\bmod 4 &= 0 \\\\\n14 \\cdot 1\\bmod 4 &= 2 \\\\\n14 \\cdot 2\\bmod 4 &= 0 \\\\\n14 \\cdot 3\\bmod 4 &= 2\n\\end{aligned}\n$$\n\nNotice that there are only two residues possible. So, we proceed as follows:\n\n> However, substituting $n=0,1,2,3$ into the expression $14n$, we obtain that\n> $14n \\textrm{mod} 4 \\in \\{0,2\\}$.\n> But this is a contradiction since $14n \\textrm{mod} 4 = 3$ by assumption.\n\nSince we have a contradiction, our original assumption must be incorrect. Hence, we write our conclusion as follows:\n\n> Therefore, we conclude that $4 \\not\\mid (14n+1)$."] [:db/cas 17592186171851 :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(5\\operatorname{cos}⁡\\pi t\\,i+5\\operatorname{sin}⁡\\pi t\\,j)^{′} \\\\  & =-5\\pi \\operatorname{sin}⁡\\pi t\\,i+5\\pi \\operatorname{cos}⁡\\pi t\\,j.\\end{aligned}\n$$\n\nTo find the speed, we calculate the magnitude of the velocity vector as follows:\n\n$$\n\\begin{aligned}||v(t)|| & =\\sqrt{(-5\\pi \\operatorname{sin}⁡\\pi t)^{2}+(5\\pi \\operatorname{cos}⁡\\pi t)^{2}} \\\\  & =\\sqrt{25{\\pi }^{2}{sin}^{2}⁡\\pi t+25{\\pi }^{2}{cos}^{2}⁡\\pi t} \\\\  & =\\sqrt{25{\\pi }^{2}({sin}^{2}⁡\\pi t+{cos}^{2}⁡\\pi t)} \\\\  & =5\\pi \\end{aligned}\n$$\n\nTherefore, the object's speed is $5 \\pi \\textrm{ m/s}.$\n\nNote that the speed is constant, but the velocity is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n||\\mathbf v|| = R|\\omega|,\n$$\n\nwhere $R$ is the radius of the circle, and $\\omega$ is the angular velocity.\n\nIn our case, the radius of the circle is $R=5\\,\\textrm m$ and the angular frequency $\\omega = \\pi \\,\\textrm{rad/s}.$ Therefore,\n\n$$\n||\\mathbf v|| = 5\\cdot |\\pi| = 5\\pi \\textrm{ m/s}.\n$$" "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(5\\operatorname{cos}⁡\\pi t\\,i+5\\operatorname{sin}⁡\\pi t\\,j)^{′} \\\\  & =-5\\pi \\operatorname{sin}⁡\\pi t\\,i+5\\pi \\operatorname{cos}⁡\\pi t\\,j.\\end{aligned}\n$$\n\nTo find the speed, we calculate the magnitude of the velocity vector as follows:\n\n$$\n\\begin{aligned}||v(t)|| & =\\sqrt{(-5\\pi \\operatorname{sin}⁡\\pi t)^{2}+(5\\pi \\operatorname{cos}⁡\\pi t)^{2}} \\\\  & =\\sqrt{25{\\pi }^{2}{\\sin }^{2}⁡\\pi t+25{\\pi }^{2}{\\cos }^{2}⁡\\pi t} \\\\  & =\\sqrt{25{\\pi }^{2}({\\sin }^{2}⁡\\pi t+{\\cos }^{2}⁡\\pi t)} \\\\  & =5\\pi \\end{aligned}\n$$\n\nTherefore, the object's speed is $5 \\pi \\textrm{ m/s}.$\n\nNote that the speed is constant, but the velocity is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n||\\mathbf v|| = R|\\omega|,\n$$\n\nwhere $R$ is the radius of the circle, and $\\omega$ is the angular velocity.\n\nIn our case, the radius of the circle is $R=5\\,\\textrm m$ and the angular frequency $\\omega = \\pi \\,\\textrm{rad/s}.$ Therefore,\n\n$$\n||\\mathbf v|| = 5\\cdot |\\pi| = 5\\pi \\textrm{ m/s}.\n$$"] [:db/cas 17592186171852 :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(4(\\operatorname{cos}⁡3t\\,i+\\operatorname{sin}⁡3t\\,j))^{′} \\\\  & =-12\\operatorname{sin}⁡3t\\,i+12\\operatorname{cos}⁡3t\\,j.\\end{aligned}\n$$\n\nThen, we find the acceleration vector by differentiating the velocity vector. \n\n$$\n\\begin{aligned}a(t) & =(v(t))^{′} \\\\  & =(-12\\operatorname{sin}⁡3t\\,i+12\\operatorname{cos}⁡3t\\,j)^{′} \\\\  & =-36\\operatorname{cos}⁡3t\\,i-36\\operatorname{sin}⁡3t\\,j\\end{aligned}\n$$\n\nFinally, we calculate the magnitude of the acceleration as follows:\n\n$$\n\\begin{aligned}||a(t)|| & =\\sqrt{(-36\\operatorname{cos}⁡3t)^{2}+(-36\\operatorname{sin}⁡3t)^{2}} \\\\  & =\\sqrt{{36}^{2}{cos}^{2}⁡3t+{36}^{2}{sin}^{2}⁡3t} \\\\  & =\\sqrt{{36}^{2}} \\\\  & =36\\end{aligned}\n$$\n\nTherefore, the magnitude of the acceleration is $36\\, \\textrm{m/s}^2.$\n\nNote that $||\\mathbf a||$ is constant, but $\\mathbf a$ is not.\n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n\\mathbf a = -\\omega^2\\mathbf r \\qquad \\Rightarrow \\qquad ||\\mathbf a|| = \\omega^2||\\mathbf r||.\n$$\n\nIn our case, the radius of the circle is $R=4\\,\\textrm m$ and the angular frequency $\\omega = 3\\,\\textrm{rad/s}.$ Therefore,\n\n$$\n||\\mathbf a|| = 3^2\\cdot |4| = 36\\, \\textrm{m/s}^2.\n$$" "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(4(\\operatorname{cos}⁡3t\\,i+\\operatorname{sin}⁡3t\\,j))^{′} \\\\  & =-12\\operatorname{sin}⁡3t\\,i+12\\operatorname{cos}⁡3t\\,j.\\end{aligned}\n$$\n\nThen, we find the acceleration vector by differentiating the velocity vector. \n\n$$\n\\begin{aligned}a(t) & =(v(t))^{′} \\\\  & =(-12\\operatorname{sin}⁡3t\\,i+12\\operatorname{cos}⁡3t\\,j)^{′} \\\\  & =-36\\operatorname{cos}⁡3t\\,i-36\\operatorname{sin}⁡3t\\,j\\end{aligned}\n$$\n\nFinally, we calculate the magnitude of the acceleration as follows:\n\n$$\n\\begin{aligned}||a(t)|| & =\\sqrt{(-36\\operatorname{cos}⁡3t)^{2}+(-36\\operatorname{sin}⁡3t)^{2}} \\\\  & =\\sqrt{{36}^{2}{\\cos }^{2}⁡3t+{36}^{2}{\\sin }^{2}⁡3t} \\\\  & =\\sqrt{{36}^{2}} \\\\  & =36\\end{aligned}\n$$\n\nTherefore, the magnitude of the acceleration is $36\\, \\textrm{m/s}^2.$\n\nNote that $||\\mathbf a||$ is constant, but $\\mathbf a$ is not.\n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n\\mathbf a = -\\omega^2\\mathbf r \\qquad \\Rightarrow \\qquad ||\\mathbf a|| = \\omega^2||\\mathbf r||.\n$$\n\nIn our case, the radius of the circle is $R=4\\,\\textrm m$ and the angular frequency $\\omega = 3\\,\\textrm{rad/s}.$ Therefore,\n\n$$\n||\\mathbf a|| = 3^2\\cdot |4| = 36\\, \\textrm{m/s}^2.\n$$"] [:db/cas 17592186171895 :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn polar coordinates, the arc length element $\\textrm d s$ is given by\n\n$$\n\\textrm ds = \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSo, for a polar curve defined as $r = r(\\theta)$ for $\\theta_1 \\leq \\theta \\leq \\theta_2,$ we have\n\n$$\nL=\t\\int_C \\,\\textrm d s =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=1-\\sin{\\theta},$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = -\\cos{\\theta}.\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(1-\\operatorname{sin}⁡\\theta )}^{2}+{(-\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn polar coordinates, the arc length element $\\textrm d s$ is given by\n\n$$\n\\textrm ds = \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSo, for a polar curve defined as $r = r(\\theta)$ for $\\theta_1 \\leq \\theta \\leq \\theta_2,$ we have\n\n$$\nL=\t\\int_C \\,\\textrm d s =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=1-\\sin{\\theta},$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = -\\cos{\\theta}.\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(1-\\operatorname{sin}⁡\\theta )}^{2}+{(-\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1-2\\operatorname{sin}⁡\\theta +{\\sin }^{2}⁡\\theta +{\\cos }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"] [:db/cas 17592186171896 :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn polar coordinates, the arc length element $\\textrm d s$ is given by\n\n$$\n\\textrm ds = \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSo, for a polar curve defined as $r = r(\\theta)$ for $\\theta_1 \\leq \\theta \\leq \\theta_2,$ we have\n\n$$\nL=\t\\int_C \\,\\textrm d s =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=2(1+\\sin\\theta),$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = 2\\cos{\\theta}.\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4(1+\\operatorname{sin}⁡\\theta )^{2}+4{(\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{2+2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we recall the following identities:\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\left(\\frac{\\theta }{2}\\right)+{cos}^{2}⁡\\left(\\frac{\\theta }{2}\\right)=1,\\,\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)\\end{aligned}\n$$\n\nRewriting our integral using the above identities, we can evaluate it as follows:\n\n$$\n\\begin{aligned}L & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{{sin}^{2}⁡\\left(\\frac{\\theta }{2}\\right)+{cos}^{2}⁡\\left(\\frac{\\theta }{2}\\right)+2\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{{(\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right))}^{2}}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }|\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)|\\,\\text{d}\\theta  \\\\  & =4\\sqrt{2}{[-\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)]}_{0}^{\\pi } \\\\  & =4\\sqrt{2}(-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right))-(-\\operatorname{cos}⁡(0)+\\operatorname{sin}⁡(0)) \\\\  & =4\\sqrt{2}((0+1)-(-1+0)) \\\\  & =8\\sqrt{2}\\end{aligned}\n$$" "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn polar coordinates, the arc length element $\\textrm d s$ is given by\n\n$$\n\\textrm ds = \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSo, for a polar curve defined as $r = r(\\theta)$ for $\\theta_1 \\leq \\theta \\leq \\theta_2,$ we have\n\n$$\nL=\t\\int_C \\,\\textrm d s =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=2(1+\\sin\\theta),$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = 2\\cos{\\theta}.\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4(1+\\operatorname{sin}⁡\\theta )^{2}+4{(\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +{\\sin }^{2}⁡\\theta +{\\cos }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{2+2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we recall the following identities:\n\n$$\n\\begin{aligned}{\\sin }^{2}⁡\\left(\\frac{\\theta }{2}\\right)+{\\cos }^{2}⁡\\left(\\frac{\\theta }{2}\\right)=1,\\,\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)\\end{aligned}\n$$\n\nRewriting our integral using the above identities, we can evaluate it as follows:\n\n$$\n\\begin{aligned}L & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{{\\sin }^{2}⁡\\left(\\frac{\\theta }{2}\\right)+{\\cos }^{2}⁡\\left(\\frac{\\theta }{2}\\right)+2\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{{(\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right))}^{2}}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }|\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)|\\,\\text{d}\\theta  \\\\  & =4\\sqrt{2}{[-\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)]}_{0}^{\\pi } \\\\  & =4\\sqrt{2}(-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right))-(-\\operatorname{cos}⁡(0)+\\operatorname{sin}⁡(0)) \\\\  & =4\\sqrt{2}((0+1)-(-1+0)) \\\\  & =8\\sqrt{2}\\end{aligned}\n$$"] [:db/cas 17592186172229 :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $Re(z) > 0$?\n\n1. $$\n\\displaystyle \\int_{1}^{∞}t^{z - 1}e^{-t}dt\n$$\n2. $$\n\\displaystyle \\int_{0}^{∞}\\frac{t^{z - 1}}{e^{t}}dt\n$$\n3. $$\n\\displaystyle \\int_{0}^{∞}\\frac{e^{t}}{t^{z - 1}}dt\n$$" "Which of the following integrals are equivalent to $Γ(z)$ for $\\Re (z) > 0$?\n\n1. $$\n\\displaystyle \\int_{1}^{∞}t^{z - 1}e^{-t}dt\n$$\n2. $$\n\\displaystyle \\int_{0}^{∞}\\frac{t^{z - 1}}{e^{t}}dt\n$$\n3. $$\n\\displaystyle \\int_{0}^{∞}\\frac{e^{t}}{t^{z - 1}}dt\n$$"] [:db/cas 17592186172232 :question/worked-solution "Notice that $x=1+{y}^{2}\\ge 0$ for all $y\\in [-1,1].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(y)\\operatorname{cos}⁡\\theta ,\\,y,\\,f(y)\\operatorname{sin}⁡\\theta ⟩,\\,(y,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(y)=1+{y}^{2},$ and\n\n$$\nD={(y,\\theta )\\,:\\,-1\\le y\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂x}{∂y},\\,\\frac{∂y}{∂y}\\,\\frac{∂z}{∂y}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,0,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & 1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′}{cos}^{2}⁡\\theta -f{f}^{′}{sin}^{2}⁡\\theta ,\\,f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′},\\,f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f\\operatorname{cos}⁡\\theta )^{2}+(-f{f}^{′})^{2}+(f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}y\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y\\,\\text{d}\\theta  \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y.\\end{aligned}\n$$\n\nSince $f=1+{y}^{2},$ we obtain ${f}^{′}=2y.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y & =2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+(2y)^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+4{y}^{2}}\\,\\text{d}y.\\end{aligned}\n$$" "Notice that $x=1+{y}^{2}\\ge 0$ for all $y\\in [-1,1].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(y)\\operatorname{cos}⁡\\theta ,\\,y,\\,f(y)\\operatorname{sin}⁡\\theta ⟩,\\,(y,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(y)=1+{y}^{2},$ and\n\n$$\nD={(y,\\theta )\\,:\\,-1\\le y\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂x}{∂y},\\,\\frac{∂y}{∂y}\\,\\frac{∂z}{∂y}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,0,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & 1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′}{\\cos }^{2}⁡\\theta -f{f}^{′}{\\sin }^{2}⁡\\theta ,\\,f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′},\\,f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f\\operatorname{cos}⁡\\theta )^{2}+(-f{f}^{′})^{2}+(f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}y\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y\\,\\text{d}\\theta  \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y.\\end{aligned}\n$$\n\nSince $f=1+{y}^{2},$ we obtain ${f}^{′}=2y.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y & =2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+(2y)^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+4{y}^{2}}\\,\\text{d}y.\\end{aligned}\n$$"] [:db/cas 17592186172233 :question/worked-solution "Notice that $y=\\operatorname{sin}⁡x\\ge 0$ for all $x\\in [0,\\pi ].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)=\\operatorname{sin}⁡x,$ and\n\n$$\nD={(x,\\theta )\\,:\\,0\\le x\\le \\pi ,\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f=\\operatorname{sin}⁡x,$ we obtain ${f}^{′}=\\operatorname{cos}⁡x.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′}=⟨\\operatorname{sin}⁡x\\operatorname{cos}⁡x,\\,-\\operatorname{sin}⁡x\\operatorname{cos}⁡\\theta ,\\,-\\operatorname{sin}⁡x\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$" "Notice that $y=\\operatorname{sin}⁡x\\ge 0$ for all $x\\in [0,\\pi ].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)=\\operatorname{sin}⁡x,$ and\n\n$$\nD={(x,\\theta )\\,:\\,0\\le x\\le \\pi ,\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨f{f}^{′}{\\cos }^{2}⁡\\theta +f{f}^{′}{\\sin }^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f=\\operatorname{sin}⁡x,$ we obtain ${f}^{′}=\\operatorname{cos}⁡x.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′}=⟨\\operatorname{sin}⁡x\\operatorname{cos}⁡x,\\,-\\operatorname{sin}⁡x\\operatorname{cos}⁡\\theta ,\\,-\\operatorname{sin}⁡x\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$"] [:db/cas 17592186172236 :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $Re(z) > 0$?\n\n1. $$\n\\displaystyle 2\\displaystyle \\int_{0}^{∞}\\frac{e^{-t^{2}}}{t^{2z - 2}}dt\n$$\n2. $$\n\\displaystyle 2\\displaystyle \\int_{1}^{∞}\\frac{t^{z}}{e^{t^{2}}}dt\n$$\n3. $$\n\\displaystyle 2\\displaystyle \\int_{0}^{∞}t^{2z - 1}e^{-t^{2}}dt\n$$" "Which of the following integrals are equivalent to $Γ(z)$ for $\\Re (z) > 0$?\n\n1. $$\n\\displaystyle 2\\displaystyle \\int_{0}^{∞}\\frac{e^{-t^{2}}}{t^{2z - 2}}dt\n$$\n2. $$\n\\displaystyle 2\\displaystyle \\int_{1}^{∞}\\frac{t^{z}}{e^{t^{2}}}dt\n$$\n3. $$\n\\displaystyle 2\\displaystyle \\int_{0}^{∞}t^{2z - 1}e^{-t^{2}}dt\n$$"] [:db/cas 17592186172288 :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{(1-2\\operatorname{cos}⁡\\theta )^{2}+(2\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta +4{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{(1-2\\operatorname{cos}⁡\\theta )^{2}+(2\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta +4{\\sin }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"] [:db/cas 17592186172289 :question/problem "Which of the following expressions is obtained by using the pointwise polar arc-length integrand for $$\n\\displaystyle {\\int }_{C}\\,\\text{d}s,\n$$ where $C$ is the path along the polar curve $r={sec}^{3}⁡\\theta \\,$ for $-\\pi /2<\\theta<\\pi /2$? Interpret the endpoint integrals as improper integrals." "Which of the following expressions is obtained by using the pointwise polar arc-length integrand for $$\n\\displaystyle {\\int }_{C}\\,\\text{d}s,\n$$ where $C$ is the path along the polar curve $r={\\sec }^{3}⁡\\theta \\,$ for $-\\pi /2<\\theta<\\pi /2$? Interpret the endpoint integrals as improper integrals."] [:db/cas 17592186172289 :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={sec}^{3}⁡\\theta \\,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3{sec}^{3}⁡\\theta \\operatorname{tan}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{({sec}^{3}⁡\\theta )}^{2}+{(3{sec}^{3}⁡\\theta \\operatorname{tan}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{sec}^{6}⁡\\theta +9{sec}^{6}⁡\\theta {tan}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{sec}^{6}⁡\\theta (1+9{tan}^{2}⁡\\theta })\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}{sec}^{3}⁡\\theta \\sqrt{1+9{tan}^{2}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$\n\nThese endpoint integrals are improper and diverge to $+\\infty.$ The requested expression is determined by the pointwise arc-length integrand on $-\\pi/2<\\theta<\\pi/2.$" "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={\\sec }^{3}⁡\\theta \\,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3{\\sec }^{3}⁡\\theta \\operatorname{tan}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{({\\sec }^{3}⁡\\theta )}^{2}+{(3{\\sec }^{3}⁡\\theta \\operatorname{tan}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{\\sec }^{6}⁡\\theta +9{\\sec }^{6}⁡\\theta {\\tan }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{\\sec }^{6}⁡\\theta (1+9{\\tan }^{2}⁡\\theta })\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}{\\sec }^{3}⁡\\theta \\sqrt{1+9{\\tan }^{2}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$\n\nThese endpoint integrals are improper and diverge to $+\\infty.$ The requested expression is determined by the pointwise arc-length integrand on $-\\pi/2<\\theta<\\pi/2.$"] [:db/cas 17592186172290 :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{sec}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{(\\operatorname{sec}⁡\\theta )}^{2}+{(\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sec}^{2}⁡\\theta +{sec}^{2}⁡\\theta {tan}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sec}^{2}⁡\\theta (1+{tan}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sec}^{4}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}{sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{tan}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\sqrt{3}-\\frac{\\sqrt{3}}{3} \\\\  & =\\frac{2\\sqrt{3}}{3}.\\end{aligned}\n$$" "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{sec}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{(\\operatorname{sec}⁡\\theta )}^{2}+{(\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{\\sec }^{2}⁡\\theta +{\\sec }^{2}⁡\\theta {\\tan }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{\\sec }^{2}⁡\\theta (1+{\\tan }^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{\\sec }^{4}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}{\\sec }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{tan}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\sqrt{3}-\\frac{\\sqrt{3}}{3} \\\\  & =\\frac{2\\sqrt{3}}{3}.\\end{aligned}\n$$"] [:db/cas 17592186172379 :question/problem "$$\n⟨\\,{cos}^{2}⁡y\\operatorname{cos}⁡\\theta ,\\text{_______}\\,,\\,{cos}^{2}⁡y\\operatorname{sin}⁡\\theta ⟩\n$$\n\n \n\nThe fundamental vector product of the surface of revolution generated by rotating the curve $x={cos}^{2}⁡y$ by $2\\pi $ radians about the $y$-axis for $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]$ is given above. What is the $2$nd  component of the product?" "$$\n⟨\\,{\\cos }^{2}⁡y\\operatorname{cos}⁡\\theta ,\\text{_______}\\,,\\,{\\cos }^{2}⁡y\\operatorname{sin}⁡\\theta ⟩\n$$\n\n \n\nThe fundamental vector product of the surface of revolution generated by rotating the curve $x={\\cos }^{2}⁡y$ by $2\\pi $ radians about the $y$-axis for $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]$ is given above. What is the $2$nd  component of the product?"] [:db/cas 17592186172379 :question/worked-solution "Notice that $x={cos}^{2}⁡y\\ge 0$ for all $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ The parametrization of our surface of revolution is \n\n$$\n\\begin{aligned}r=⟨f(y)\\operatorname{cos}⁡\\theta ,y,\\,f(y)\\operatorname{sin}⁡\\theta ⟩,\\,(y,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(y)={cos}^{2}⁡y,$ and  \n\n$$\nD={(y,\\theta )\\,:\\,-\\frac{\\pi }{2}\\le y\\le \\frac{\\pi }{2},\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂x}{∂y},\\,\\frac{∂y}{∂y},\\,\\frac{∂z}{∂y}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,0,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & 1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-{f}^{′}f{cos}^{2}⁡\\theta -{f}^{′}f{sin}^{2}⁡\\theta ,\\,f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-{f}^{′}f,\\,f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f={cos}^{2}⁡y,$ we obtain ${f}^{′}=-2\\operatorname{sin}⁡y\\operatorname{cos}⁡y.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′}=⟨{cos}^{2}⁡y\\operatorname{cos}⁡\\theta ,\\,2\\operatorname{sin}⁡y{cos}^{3}⁡y,\\,{cos}^{2}⁡y\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$" "Notice that $x={\\cos }^{2}⁡y\\ge 0$ for all $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ The parametrization of our surface of revolution is \n\n$$\n\\begin{aligned}r=⟨f(y)\\operatorname{cos}⁡\\theta ,y,\\,f(y)\\operatorname{sin}⁡\\theta ⟩,\\,(y,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(y)={\\cos }^{2}⁡y,$ and  \n\n$$\nD={(y,\\theta )\\,:\\,-\\frac{\\pi }{2}\\le y\\le \\frac{\\pi }{2},\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂x}{∂y},\\,\\frac{∂y}{∂y},\\,\\frac{∂z}{∂y}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,0,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & 1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-{f}^{′}f{\\cos }^{2}⁡\\theta -{f}^{′}f{\\sin }^{2}⁡\\theta ,\\,f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-{f}^{′}f,\\,f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f={\\cos }^{2}⁡y,$ we obtain ${f}^{′}=-2\\operatorname{sin}⁡y\\operatorname{cos}⁡y.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′}=⟨{\\cos }^{2}⁡y\\operatorname{cos}⁡\\theta ,\\,2\\operatorname{sin}⁡y{\\cos }^{3}⁡y,\\,{\\cos }^{2}⁡y\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$"] [:db/cas 17592186172380 :question/worked-solution "Notice that $y={x}^{4}\\ge 0$ for all $x\\in [-2,2].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,\\,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)={x}^{4},$ and\n\n$$\nD={(x,\\theta )\\,:\\,-2\\le x\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f{f}^{′})^{2}+(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}x \\\\  & ={\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nSince $f={x}^{4},$ we obtain ${f}^{′}=4{x}^{3}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x & =2\\pi {\\int }_{-2}^{2}{x}^{4}\\sqrt{1+(4{x}^{3})^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-2}^{2}{x}^{4}\\sqrt{1+16{x}^{6}}\\,\\text{d}x.\\end{aligned}\n$$" "Notice that $y={x}^{4}\\ge 0$ for all $x\\in [-2,2].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,\\,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)={x}^{4},$ and\n\n$$\nD={(x,\\theta )\\,:\\,-2\\le x\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,-\\begin{vmatrix}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{vmatrix},\\,\\begin{vmatrix}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{vmatrix}\\right\\rangle  \\\\  & =⟨f{f}^{′}{\\cos }^{2}⁡\\theta +f{f}^{′}{\\sin }^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f{f}^{′})^{2}+(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}x \\\\  & ={\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nSince $f={x}^{4},$ we obtain ${f}^{′}=4{x}^{3}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x & =2\\pi {\\int }_{-2}^{2}{x}^{4}\\sqrt{1+(4{x}^{3})^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-2}^{2}{x}^{4}\\sqrt{1+16{x}^{6}}\\,\\text{d}x.\\end{aligned}\n$$"] [:db/cas 17592186172447 :question/problem "Prove by contradiction that $17∤(n^{4} + 7)$ for any $n ∈ Z$.\n\nYou may assume without proof that $n^{4}mod17 ∈ {0, 1, 4, 13, 16}$ for all possible $n$.\n\nAssume, for a contradiction, that $17$ {{field-1}} $(n^{4} + 7)$. Then, {{field-2}}, where $k$ is an integer.\n\nTherefore, we have the following equivalence:\n\n$17(n^{4} + 7) = k$ {{field-3}} {{field-4}}\n\nHence, we have that $n^{4}mod17 =$ {{field-5}}.\n\nWe're given that\n$n^{4}mod17 ∈ R = {0, 1, 4, 13, 16}$\nfor all $n$. Therefore, we have a contradiction since\n{{field-6}}\n{{field-7}}." "Prove by contradiction that $17∤(n^{4} + 7)$ for any $n ∈ Z$.\n\nYou may assume without proof that $n^{4}\\bmod 17 ∈ {0, 1, 4, 13, 16}$ for all possible $n$.\n\nAssume, for a contradiction, that $17$ {{field-1}} $(n^{4} + 7)$. Then, {{field-2}}, where $k$ is an integer.\n\nTherefore, we have the following equivalence:\n\n$17(n^{4} + 7) = k$ {{field-3}} {{field-4}}\n\nHence, we have that $n^{4}\\bmod 17 =$ {{field-5}}.\n\nWe're given that\n$n^{4}\\bmod 17 ∈ R = {0, 1, 4, 13, 16}$\nfor all $n$. Therefore, we have a contradiction since\n{{field-6}}\n{{field-7}}."] [:db/cas 17592186172450 :question/problem "Prove by contradiction that $3∤(n^{4} + 1)$ for any $n ∈ Z$.\n\nAssume, for a contradiction, that $3$ {{field-1}} $(n^{4} + 1)$. Then, {{field-2}}, where $k$ is an integer.\n\nTherefore, we have the following equivalence:\n\n$k(n^{4} + 1) = 3$ {{field-3}} {{field-4}}\n\nHence, we have that $n^{4}mod3 =$ {{field-5}}.\n\nHowever, substituting $n = 0, 1, 2$ into the expression $n^{4}$, we obtain that\n$2$ {{field-6}}\nBut this is a contradiction since $n^{4}mod3 =$ {{field-7}} by assumption." "Prove by contradiction that $3∤(n^{4} + 1)$ for any $n ∈ Z$.\n\nAssume, for a contradiction, that $3$ {{field-1}} $(n^{4} + 1)$. Then, {{field-2}}, where $k$ is an integer.\n\nTherefore, we have the following equivalence:\n\n$k(n^{4} + 1) = 3$ {{field-3}} {{field-4}}\n\nHence, we have that $n^{4}\\bmod 3 =$ {{field-5}}.\n\nHowever, substituting $n = 0, 1, 2$ into the expression $n^{4}$, we obtain that\n$2$ {{field-6}}\nBut this is a contradiction since $n^{4}\\bmod 3 =$ {{field-7}} by assumption."] [:db/cas 17592186172477 :question/problem "Consider the independent random variables $Y_{1}∼Γ(2, 3)$ and $Y_{2}∼Exp(3)$. What is the distribution of $Y = Y_{1} + Y_{2}$?\n\n*Hint: You may wish to make use of the following results.*\n\n| Distribution | $M(t)$ | $t$-domain |\n| --- | ---: | ---: |\n| $U[a, b]$ | $\\left\\{  \\begin{array}{ll}{\\displaystyle \\frac{ {e}^{t b} - {e}^{t a}}{t ( b - a )}} , \\hspace{1em} & t \\ne  0 \\\\ 1 , \\hspace{2em} & t = 0\\end{array} \\right.$ | $t ∈ R$ |\n| $N(μ, σ^{2})$ | $\\exp (μt + \\frac{1}{2}σ^{2}t^{2})$ | $t ∈ R$ |\n| $χ^{2}(k)$ | $(1 - 2t)^{-k/2}$ | $t < \\frac{1}{2}$ |\n| $Exp(λ)$ | $\\frac{λ}{λ - t}$ | $t < λ$ |\n| $Γ(α, λ)$ | $\\left(\\frac{λ}{λ - t}\\right)^{α}$ | $t < λ$ |" "Consider the independent random variables $Y_{1}∼Γ(2, 3)$ and $Y_{2}∼\\operatorname{Exp} (3)$. What is the distribution of $Y = Y_{1} + Y_{2}$?\n\n*Hint: You may wish to make use of the following results.*\n\n| Distribution | $M(t)$ | $t$-domain |\n| --- | ---: | ---: |\n| $U[a, b]$ | $\\left\\{  \\begin{array}{ll}{\\displaystyle \\frac{ {e}^{t b} - {e}^{t a}}{t ( b - a )}} , \\hspace{1em} & t \\ne  0 \\\\ 1 , \\hspace{2em} & t = 0\\end{array} \\right.$ | $t ∈ R$ |\n| $N(μ, σ^{2})$ | $\\exp (μt + \\frac{1}{2}σ^{2}t^{2})$ | $t ∈ R$ |\n| $χ^{2}(k)$ | $(1 - 2t)^{-k/2}$ | $t < \\frac{1}{2}$ |\n| $\\operatorname{Exp} (λ)$ | $\\frac{λ}{λ - t}$ | $t < λ$ |\n| $Γ(α, λ)$ | $\\left(\\frac{λ}{λ - t}\\right)^{α}$ | $t < λ$ |"] [:db/cas 17592186172543 :question/problem "Consider the independent random variables $Y_{1}∼N(0, 1)$ and $Y_{2}∼N(0, 1)$. What is the distribution of $Y = Y_{1} + Y_{2}$?\n\n*Hint: You may wish to make use of the following results.*\n\n| Distribution | $M(t)$ | $t$-domain |\n| --- | ---: | ---: |\n| $U[a, b]$ | $\\left\\{  \\begin{array}{ll}{\\displaystyle \\frac{ {e}^{t b} - {e}^{t a}}{t ( b - a )}} , \\hspace{1em} & t \\ne  0 \\\\ 1 , \\hspace{2em} & t = 0\\end{array} \\right.$ | $t ∈ R$ |\n| $N(μ, σ^{2})$ | $\\exp (μt + \\frac{1}{2}σ^{2}t^{2})$ | $t ∈ R$ |\n| $χ^{2}(k)$ | $(1 - 2t)^{-k/2}$ | $t < \\frac{1}{2}$ |\n| $Exp(λ)$ | $\\frac{λ}{λ - t}$ | $t < λ$ |\n| $Γ(α, λ)$ | $\\left(\\frac{λ}{λ - t}\\right)^{α}$ | $t < λ$ |" "Consider the independent random variables $Y_{1}∼N(0, 1)$ and $Y_{2}∼N(0, 1)$. What is the distribution of $Y = Y_{1} + Y_{2}$?\n\n*Hint: You may wish to make use of the following results.*\n\n| Distribution | $M(t)$ | $t$-domain |\n| --- | ---: | ---: |\n| $U[a, b]$ | $\\left\\{  \\begin{array}{ll}{\\displaystyle \\frac{ {e}^{t b} - {e}^{t a}}{t ( b - a )}} , \\hspace{1em} & t \\ne  0 \\\\ 1 , \\hspace{2em} & t = 0\\end{array} \\right.$ | $t ∈ R$ |\n| $N(μ, σ^{2})$ | $\\exp (μt + \\frac{1}{2}σ^{2}t^{2})$ | $t ∈ R$ |\n| $χ^{2}(k)$ | $(1 - 2t)^{-k/2}$ | $t < \\frac{1}{2}$ |\n| $\\operatorname{Exp} (λ)$ | $\\frac{λ}{λ - t}$ | $t < λ$ |\n| $Γ(α, λ)$ | $\\left(\\frac{λ}{λ - t}\\right)^{α}$ | $t < λ$ |"] [:db/cas 17592186172651 :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(2\\operatorname{cos}⁡3t\\,i+2\\operatorname{sin}⁡3t\\,j)^{′} \\\\  & =-6\\operatorname{sin}⁡3t\\,i+6\\operatorname{cos}⁡3t\\,j.\\end{aligned}\n$$\n\nTo find the speed, we calculate the magnitude of the velocity vector, as follows:\n\n$$\n\\begin{aligned}||v(t)|| & =\\sqrt{(-6\\operatorname{sin}⁡3t)^{2}+(6\\operatorname{cos}⁡3t)^{2}} \\\\  & =\\sqrt{36{sin}^{2}⁡3t+36{cos}^{2}⁡3t} \\\\  & =\\sqrt{36({sin}^{2}⁡3t+{cos}^{2}⁡3t)} \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the speed of the object is $6\\text{ m/s}.$\n\nNote that the speed is constant, but the velocity is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n||v||=R|\\omega |,\n$$\n\nwhere $R$ is the radius of the circle, and $\\omega $ is the angular velocity.\n\nIn our case, the radius of the circle is $R=2\\,\\text{m}$ and the angular frequency $\\omega =3\\,\\text{rad/s}.$ Therefore,\n\n$$\n||v||=2\\cdot |3|=6\\text{ m/s}.\n$$" "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(2\\operatorname{cos}⁡3t\\,i+2\\operatorname{sin}⁡3t\\,j)^{′} \\\\  & =-6\\operatorname{sin}⁡3t\\,i+6\\operatorname{cos}⁡3t\\,j.\\end{aligned}\n$$\n\nTo find the speed, we calculate the magnitude of the velocity vector, as follows:\n\n$$\n\\begin{aligned}||v(t)|| & =\\sqrt{(-6\\operatorname{sin}⁡3t)^{2}+(6\\operatorname{cos}⁡3t)^{2}} \\\\  & =\\sqrt{36{\\sin }^{2}⁡3t+36{\\cos }^{2}⁡3t} \\\\  & =\\sqrt{36({\\sin }^{2}⁡3t+{\\cos }^{2}⁡3t)} \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the speed of the object is $6\\text{ m/s}.$\n\nNote that the speed is constant, but the velocity is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n||v||=R|\\omega |,\n$$\n\nwhere $R$ is the radius of the circle, and $\\omega $ is the angular velocity.\n\nIn our case, the radius of the circle is $R=2\\,\\text{m}$ and the angular frequency $\\omega =3\\,\\text{rad/s}.$ Therefore,\n\n$$\n||v||=2\\cdot |3|=6\\text{ m/s}.\n$$"] [:db/cas 17592186172652 :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(3(\\operatorname{cos}⁡2t\\,i+\\operatorname{sin}⁡2t\\,j))^{′} \\\\  & =-6\\operatorname{sin}⁡2t\\,i+6\\operatorname{cos}⁡2t\\,j\\end{aligned}\n$$\n\nThen, we find the acceleration vector by differentiating the velocity vector. \n\n$$\n\\begin{aligned}a(t) & =(v(t))^{′} \\\\  & =(-6\\operatorname{sin}⁡2t\\,i+6\\operatorname{cos}⁡2t\\,j)^{′} \\\\  & =-12\\operatorname{cos}⁡2t\\,i-12\\operatorname{sin}⁡2t\\,j.\\end{aligned}\n$$\n\nFinally, we calculate the magnitude of the acceleration as follows:\n\n$$\n\\begin{aligned}||a(t)|| & =\\sqrt{(-12\\operatorname{cos}⁡2t)^{2}+(-12\\operatorname{sin}⁡2t)^{2}} \\\\  & =\\sqrt{144{cos}^{2}⁡2t+144{sin}^{2}⁡2t} \\\\  & =\\sqrt{144} \\\\  & =12\\end{aligned}\n$$\n\nTherefore, the magnitude of the acceleration is $12\\,{\\text{m/s}}^{2}.$\n\nNote that $||a||$ is constant, but $a$ is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\na=-{\\omega }^{2}r\\,⇒\\,||a||={\\omega }^{2}||r||.\n$$\n\nIn our case, the radius of the circle is $a=3\\,\\text{m}$ and the angular frequency $\\omega =2\\,\\text{rad/s}.$ Therefore,\n\n$$\n||a||={2}^{2}\\cdot 3=12\\,{\\text{m/s}}^{2}.\n$$" "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(3(\\operatorname{cos}⁡2t\\,i+\\operatorname{sin}⁡2t\\,j))^{′} \\\\  & =-6\\operatorname{sin}⁡2t\\,i+6\\operatorname{cos}⁡2t\\,j\\end{aligned}\n$$\n\nThen, we find the acceleration vector by differentiating the velocity vector. \n\n$$\n\\begin{aligned}a(t) & =(v(t))^{′} \\\\  & =(-6\\operatorname{sin}⁡2t\\,i+6\\operatorname{cos}⁡2t\\,j)^{′} \\\\  & =-12\\operatorname{cos}⁡2t\\,i-12\\operatorname{sin}⁡2t\\,j.\\end{aligned}\n$$\n\nFinally, we calculate the magnitude of the acceleration as follows:\n\n$$\n\\begin{aligned}||a(t)|| & =\\sqrt{(-12\\operatorname{cos}⁡2t)^{2}+(-12\\operatorname{sin}⁡2t)^{2}} \\\\  & =\\sqrt{144{\\cos }^{2}⁡2t+144{\\sin }^{2}⁡2t} \\\\  & =\\sqrt{144} \\\\  & =12\\end{aligned}\n$$\n\nTherefore, the magnitude of the acceleration is $12\\,{\\text{m/s}}^{2}.$\n\nNote that $||a||$ is constant, but $a$ is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\na=-{\\omega }^{2}r\\,⇒\\,||a||={\\omega }^{2}||r||.\n$$\n\nIn our case, the radius of the circle is $a=3\\,\\text{m}$ and the angular frequency $\\omega =2\\,\\text{rad/s}.$ Therefore,\n\n$$\n||a||={2}^{2}\\cdot 3=12\\,{\\text{m/s}}^{2}.\n$$"] [:db/cas 17592186173126 :tutorial/content "Suppose we wish to carry out the following hypothesis test:\n\n- $H_0: p_1 = p_2$\n- $H_1: p_1 > p_2$\n\nAs we just saw, the variance of the difference between the two sampling distributions is\n\n$$\n\\textrm{Var}[\\widehat{\\,p}_1 - \\widehat{\\,p}_2] = \\dfrac{p_1(1-p_1)}{n_1} + \\dfrac{p_2(1-p_2)}{n_2}\n$$\n\nNow, under the null hypothesis, the two proportions are equal. Thus, assuming that $H_0$ is true, we can set\n\n$$\np_1 = p_2 = p\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\nVar[\\widehat{p}_{1} - \\widehat{p}_{2}] &= (p(1 - p))/(n_{1}) + (p(1 - p))/(n_{2})\n\\end{aligned}\n$$\n\nwhich simplifies to\n\n$$\n\\begin{aligned}\nVar[\\widehat{p}_{1} - \\widehat{p}_{2}] &= p(1 - p)(\\frac{1}{n_{1}} + \\frac{1}{n_{2}})\n\\end{aligned}\n$$\n\nSince the two proportions are equal under the null hypothesis, we can use a **pooled estimate** $\\overline{p}$ of the shared proportion $p$ to form a point estimate.\n\n$$\n\\overline{p} = \\dfrac{x_1+x_2}{n_1+n_2} = \\dfrac{n_1\\widehat{\\,p}_1+n_2\\widehat{\\,p}_2}{n_1+n_2}\n$$\n\nwhere $x_1$ and $x_2$ give the number of sample elements from the first and second samples, respectively, with the characteristic.\n\nThus, our estimate for the variance is\n\n$$\n\\textrm{Var}[\\widehat{\\,p}_1 - \\widehat{\\,p}_2] =\\overline{p}(1-\\overline{p})\\left(\\dfrac{1}{n_1} + \\dfrac{1}{n_2}\\right)\n$$\n\nThis is similar to the pooled variance estimate we saw in a previous lesson.\n\nAs a result, we can use the following normal approximation:\n\n$$\n\\dfrac {(\\widehat{\\,p}_1 - \\widehat{\\,p}_2) - (p_1-p_2)} {\\sqrt{\\overline{p}(1-\\overline{p}) \\left(\\dfrac{1}{n_1}+\\dfrac{1}{n_2} \\right)} \\phantom{\\mid}} \\sim N(0,1)\n$$\n\nNote the following:\n\n- A pooled variance estimate is preferable to an unpooled estimate when the null hypothesis assumes $p_1 = p_2$. It can be shown that the standard error of the pooled estimate is lower than the unpooled one, making our hypothesis test more reliable.\n- On the other hand, suppose we have the following null hypothesis:\n$H_0: p_1 - p_2 = k \\neq 0$.\nIn this case, the variances cannot be assumed equal, and we must use an unpooled estimate for the variance, i.e.,\n$$\n\\displaystyle \\textrm{Var}[\\widehat{\\,p}_1 - \\widehat{\\,p}_2] = \\dfrac{p_1(1-p_1)}{n_1} + \\dfrac{p_2(1-p_2)}{n_2}.\n$$\n\nIn this lesson, we'll only consider null hypotheses of the form $p_1 = p_2$." "Suppose we wish to carry out the following hypothesis test:\n\n- $H_0: p_1 = p_2$\n- $H_1: p_1 > p_2$\n\nAs we just saw, the variance of the difference between the two sampling distributions is\n\n$$\n\\textrm{Var}[\\widehat{\\,p}_1 - \\widehat{\\,p}_2] = \\dfrac{p_1(1-p_1)}{n_1} + \\dfrac{p_2(1-p_2)}{n_2}\n$$\n\nNow, under the null hypothesis, the two proportions are equal. Thus, assuming that $H_0$ is true, we can set\n\n$$\np_1 = p_2 = p\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [\\widehat{p}_{1} - \\widehat{p}_{2}] &= (p(1 - p))/(n_{1}) + (p(1 - p))/(n_{2})\n\\end{aligned}\n$$\n\nwhich simplifies to\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [\\widehat{p}_{1} - \\widehat{p}_{2}] &= p(1 - p)(\\frac{1}{n_{1}} + \\frac{1}{n_{2}})\n\\end{aligned}\n$$\n\nSince the two proportions are equal under the null hypothesis, we can use a **pooled estimate** $\\overline{p}$ of the shared proportion $p$ to form a point estimate.\n\n$$\n\\overline{p} = \\dfrac{x_1+x_2}{n_1+n_2} = \\dfrac{n_1\\widehat{\\,p}_1+n_2\\widehat{\\,p}_2}{n_1+n_2}\n$$\n\nwhere $x_1$ and $x_2$ give the number of sample elements from the first and second samples, respectively, with the characteristic.\n\nThus, our estimate for the variance is\n\n$$\n\\textrm{Var}[\\widehat{\\,p}_1 - \\widehat{\\,p}_2] =\\overline{p}(1-\\overline{p})\\left(\\dfrac{1}{n_1} + \\dfrac{1}{n_2}\\right)\n$$\n\nThis is similar to the pooled variance estimate we saw in a previous lesson.\n\nAs a result, we can use the following normal approximation:\n\n$$\n\\dfrac {(\\widehat{\\,p}_1 - \\widehat{\\,p}_2) - (p_1-p_2)} {\\sqrt{\\overline{p}(1-\\overline{p}) \\left(\\dfrac{1}{n_1}+\\dfrac{1}{n_2} \\right)} \\phantom{\\mid}} \\sim N(0,1)\n$$\n\nNote the following:\n\n- A pooled variance estimate is preferable to an unpooled estimate when the null hypothesis assumes $p_1 = p_2$. It can be shown that the standard error of the pooled estimate is lower than the unpooled one, making our hypothesis test more reliable.\n- On the other hand, suppose we have the following null hypothesis:\n$H_0: p_1 - p_2 = k \\neq 0$.\nIn this case, the variances cannot be assumed equal, and we must use an unpooled estimate for the variance, i.e.,\n$$\n\\displaystyle \\textrm{Var}[\\widehat{\\,p}_1 - \\widehat{\\,p}_2] = \\dfrac{p_1(1-p_1)}{n_1} + \\dfrac{p_2(1-p_2)}{n_2}.\n$$\n\nIn this lesson, we'll only consider null hypotheses of the form $p_1 = p_2$."] [:db/cas 17592186173205 :tutorial/content "Suppose a particle $P$ moves along a circle of radius $R$ centered at the origin in the $xy$-plane. \n\n![](images/45/4564f4c4fcd8068f3bf1645a310afab7fcdc2f82fec6966cb220558c1e93639a.png)\n\n    \n\nNote the following:\n\n- The **position vector** $\\mathbf r$ extends from the origin to $P$ in the *radial* direction, while\n\n- the **velocity vector** $\\mathbf v$ points in the direction of the particle's motion, *tangential* to the circle.\n\nFirst, let's assume that $P$ is at the point $(R,0)$ when $t=0.$ Then, we have\n\n$$\n\\mathbf r(t) = R\\left(\\cos\\omega t \\, \\mathbf i + \\sin\\omega t \\,\\mathbf j\\right).\n$$\n\nWe can easily derive a convenient formula relating $\\mathbf v$ and $\\omega$ by differentiating $\\mathbf r(t){:}$\n\nDifferentiating once, we get\n\n$$\n\\begin{aligned}v(t) & ={r}^{′}(t) \\\\  & ={(R(\\operatorname{cos}⁡\\omega t\\,i+\\operatorname{sin}⁡\\omega t\\,j))}^{′} \\\\  & =R\\omega (-\\operatorname{sin}⁡\\omega t\\,i+\\operatorname{cos}⁡\\omega t\\,j).\\end{aligned}\n$$\n\nBy computing the magnitude of this vector, we see that\n\n$$\n\\begin{aligned}||v|{|}^{2} & ={R}^{2}{\\omega }^{2}((-\\operatorname{sin}⁡\\omega t)^{2}+{(\\operatorname{cos}⁡\\omega t)}^{2}) \\\\  & ={R}^{2}{\\omega }^{2}({sin}^{2}⁡\\omega t+{cos}^{2}⁡\\omega t) \\\\  & ={R}^{2}{\\omega }^{2}.\\end{aligned}\n$$\n\nTaking the square root, we get\n\n$$\n||\\mathbf v || = R|\\omega|.\n$$\n\nNote that while the magnitude of the velocity vector (i.e., the speed) is constant, its direction is continuously changing, which means that an object in uniform circular motion also experiences *acceleration* (more on this shortly)." "Suppose a particle $P$ moves along a circle of radius $R$ centered at the origin in the $xy$-plane. \n\n![](images/45/4564f4c4fcd8068f3bf1645a310afab7fcdc2f82fec6966cb220558c1e93639a.png)\n\n    \n\nNote the following:\n\n- The **position vector** $\\mathbf r$ extends from the origin to $P$ in the *radial* direction, while\n\n- the **velocity vector** $\\mathbf v$ points in the direction of the particle's motion, *tangential* to the circle.\n\nFirst, let's assume that $P$ is at the point $(R,0)$ when $t=0.$ Then, we have\n\n$$\n\\mathbf r(t) = R\\left(\\cos\\omega t \\, \\mathbf i + \\sin\\omega t \\,\\mathbf j\\right).\n$$\n\nWe can easily derive a convenient formula relating $\\mathbf v$ and $\\omega$ by differentiating $\\mathbf r(t){:}$\n\nDifferentiating once, we get\n\n$$\n\\begin{aligned}v(t) & ={r}^{′}(t) \\\\  & ={(R(\\operatorname{cos}⁡\\omega t\\,i+\\operatorname{sin}⁡\\omega t\\,j))}^{′} \\\\  & =R\\omega (-\\operatorname{sin}⁡\\omega t\\,i+\\operatorname{cos}⁡\\omega t\\,j).\\end{aligned}\n$$\n\nBy computing the magnitude of this vector, we see that\n\n$$\n\\begin{aligned}||v|{|}^{2} & ={R}^{2}{\\omega }^{2}((-\\operatorname{sin}⁡\\omega t)^{2}+{(\\operatorname{cos}⁡\\omega t)}^{2}) \\\\  & ={R}^{2}{\\omega }^{2}({\\sin }^{2}⁡\\omega t+{\\cos }^{2}⁡\\omega t) \\\\  & ={R}^{2}{\\omega }^{2}.\\end{aligned}\n$$\n\nTaking the square root, we get\n\n$$\n||\\mathbf v || = R|\\omega|.\n$$\n\nNote that while the magnitude of the velocity vector (i.e., the speed) is constant, its direction is continuously changing, which means that an object in uniform circular motion also experiences *acceleration* (more on this shortly)."] [:db/cas 17592186173293 :tutorial/content "We can use proof by contradiction to demonstrate the non-divisibility of certain expressions.\n\nFor example, let's prove that for any $n\\in\\mathbb Z$,\n\n$$\n6 \\not\\mid (3n+1)\n$$\n\nFirst, we write down the formal statement $P$ that we wish to prove:\n\n$$\n\\phantom{\\lnot}P: \\quad \\forall n\\in \\mathbb Z,\\: 6 \\not\\mid (3n+1)\n$$\n\nTo prove that $P$ is true by contradiction, we assume that $\\lnot P$ is true and show this leads to a contradiction.\n\n$$\n\\lnot P: \\quad \\exists n\\in \\mathbb Z,\\: 6 \\mid (3n+1)\n$$\n\nWe begin our proof as follows:\n\n> *Assume, for a contradiction, that $6 \\mid (3n+1)$. Then, $3n+1=6k$, where $k$ is an integer.*\n\nSince the problem relates to divisibility by $6$, let's write the equation\n\n$$\n3n+1=6k\n$$\n\nin terms of congruence modulo $6$.\n\n> *Therefore, we have the following chain of equivalences:*\n> $$\n\\begin{aligned}3n+1=6k\\hspace{1em} & ⇔\\hspace{1em}3n=6k-1 \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡6k-1\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡0\\cdot k-1\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡-1\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡-1+6\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡5\\hspace{1em} &  & (\\text{mod }6)\\end{aligned}\n$$\n\nThis gives us the residue of $3n$ modulo $6{:}$\n\n> *Hence, we have that $3n \\textrm{mod} 6 = 5$.*\n\nNow, let's calculate all possible residues of $3n$ modulo $6$. To do that, we substitute\n\n$$\nn=0,1,\\ldots,5\n$$\n\ninto $3n$ and compute the residues:\n\n$$\n\\begin{aligned}\n3 \\cdot 0mod6 &= 0 \\\\\n3 \\cdot 1mod6 &= 3 \\\\\n3 \\cdot 2mod6 &= 0 \\\\\n3 \\cdot 3mod6 &= 3 \\\\\n3 \\cdot 4mod6 &= 0 \\\\\n3 \\cdot 5mod6 &= 3\n\\end{aligned}\n$$\n\nNotice that there are only two residues possible. So, we proceed as follows:\n\n> *However, substituting $n=0,1,\\ldots,5$ into the expression $3n$, we obtain that*\n> $3n \\textrm{mod} 6 \\in \\{0, 3\\}$.\n> *But this is a contradiction since $3n \\textrm{mod} 6 = 5$ by assumption.*\n\nSince we have a contradiction, our original assumption must be incorrect. Hence, we write our conclusion as follows:\n\n> *Therefore, we conclude that $6 \\not\\mid (3n+1)$.*\n\nNow that we've figured out the details, let's state the full proof." "We can use proof by contradiction to demonstrate the non-divisibility of certain expressions.\n\nFor example, let's prove that for any $n\\in\\mathbb Z$,\n\n$$\n6 \\not\\mid (3n+1)\n$$\n\nFirst, we write down the formal statement $P$ that we wish to prove:\n\n$$\n\\phantom{\\lnot}P: \\quad \\forall n\\in \\mathbb Z,\\: 6 \\not\\mid (3n+1)\n$$\n\nTo prove that $P$ is true by contradiction, we assume that $\\lnot P$ is true and show this leads to a contradiction.\n\n$$\n\\lnot P: \\quad \\exists n\\in \\mathbb Z,\\: 6 \\mid (3n+1)\n$$\n\nWe begin our proof as follows:\n\n> *Assume, for a contradiction, that $6 \\mid (3n+1)$. Then, $3n+1=6k$, where $k$ is an integer.*\n\nSince the problem relates to divisibility by $6$, let's write the equation\n\n$$\n3n+1=6k\n$$\n\nin terms of congruence modulo $6$.\n\n> *Therefore, we have the following chain of equivalences:*\n> $$\n\\begin{aligned}3n+1=6k\\hspace{1em} & ⇔\\hspace{1em}3n=6k-1 \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡6k-1\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡0\\cdot k-1\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡-1\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡-1+6\\hspace{1em} &  & (\\text{mod }6) \\\\ \\hspace{1em} & ⇔\\hspace{1em}3n≡5\\hspace{1em} &  & (\\text{mod }6)\\end{aligned}\n$$\n\nThis gives us the residue of $3n$ modulo $6{:}$\n\n> *Hence, we have that $3n \\textrm{mod} 6 = 5$.*\n\nNow, let's calculate all possible residues of $3n$ modulo $6$. To do that, we substitute\n\n$$\nn=0,1,\\ldots,5\n$$\n\ninto $3n$ and compute the residues:\n\n$$\n\\begin{aligned}\n3 \\cdot 0\\bmod 6 &= 0 \\\\\n3 \\cdot 1\\bmod 6 &= 3 \\\\\n3 \\cdot 2\\bmod 6 &= 0 \\\\\n3 \\cdot 3\\bmod 6 &= 3 \\\\\n3 \\cdot 4\\bmod 6 &= 0 \\\\\n3 \\cdot 5\\bmod 6 &= 3\n\\end{aligned}\n$$\n\nNotice that there are only two residues possible. So, we proceed as follows:\n\n> *However, substituting $n=0,1,\\ldots,5$ into the expression $3n$, we obtain that*\n> $3n \\textrm{mod} 6 \\in \\{0, 3\\}$.\n> *But this is a contradiction since $3n \\textrm{mod} 6 = 5$ by assumption.*\n\nSince we have a contradiction, our original assumption must be incorrect. Hence, we write our conclusion as follows:\n\n> *Therefore, we conclude that $6 \\not\\mid (3n+1)$.*\n\nNow that we've figured out the details, let's state the full proof."] [:db/cas 17592186175694 :question/worked-solution "The period of $y = \\cos x$ is $2\\pi.$ Therefore, for any integer $n$ we have\n\n$$\n\\cos{x} = \\cos{(x+2n\\pi)} .\n$$\n\nSubstituting $n=2$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cos⁡x & =cos⁡(x+2\\cdot 2\\cdot \\pi ) \\\\  & =cos⁡(x+4\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos{x} =- \\dfrac {1}{3},$ then $\\cos{(x+4\\pi)} = - \\dfrac {1}{3}.$\n\nFinally, then\n\n$$\n\\begin{aligned}2cos⁡(x+4\\pi )+3 & =2\\left(-\\frac{1}{3}\\right)+3 \\\\  & =-\\frac{2}{3}+3 \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$" "The period of $y = \\cos x$ is $2\\pi.$ Therefore, for any integer $n$ we have\n\n$$\n\\cos{x} = \\cos{(x+2n\\pi)} .\n$$\n\nSubstituting $n=2$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\cos ⁡x & =\\cos ⁡(x+2\\cdot 2\\cdot \\pi ) \\\\  & =\\cos ⁡(x+4\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos{x} =- \\dfrac {1}{3},$ then $\\cos{(x+4\\pi)} = - \\dfrac {1}{3}.$\n\nFinally, then\n\n$$\n\\begin{aligned}2\\cos ⁡(x+4\\pi )+3 & =2\\left(-\\frac{1}{3}\\right)+3 \\\\  & =-\\frac{2}{3}+3 \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$"] [:db/cas 17592186175696 :question/worked-solution "The period of $y=\\tan x$ is $\\pi.$ Therefore, for any integer $n,$ we have\n\n$$\n\\tan x = \\tan (x+n\\pi).\n$$\n\nSubstituting $n=-2$ into the above gives\n\n$$\n\\begin{aligned}tan⁡x & =tan⁡(x+(-2)\\cdot \\pi )=tan⁡(x-2\\pi ).\\end{aligned}\n$$\n\nSince $\\tan\\left( x\\right) = -2,$ we get that $\\tan\\left( x-2\\pi\\right) = -2.$" "The period of $y=\\tan x$ is $\\pi.$ Therefore, for any integer $n,$ we have\n\n$$\n\\tan x = \\tan (x+n\\pi).\n$$\n\nSubstituting $n=-2$ into the above gives\n\n$$\n\\begin{aligned}\\tan ⁡x & =\\tan ⁡(x+(-2)\\cdot \\pi )=\\tan ⁡(x-2\\pi ).\\end{aligned}\n$$\n\nSince $\\tan\\left( x\\right) = -2,$ we get that $\\tan\\left( x-2\\pi\\right) = -2.$"] [:db/cas 17592186175698 :question/worked-solution "The period of $y = \\sec x$ is $2\\pi.$ Therefore, for integer $n$ we have\n\n$$\n\\sec{x} = \\sec{(x+2n\\pi)} .\n$$\n\nSubstituting $n=4$ into the above gives\n\n$$\n\\begin{aligned}sec⁡x & =sec⁡(x+2\\cdot 4\\cdot \\pi ) \\\\  & =sec⁡(x+8\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\sec{x} = 2\\sqrt 2,$ then $\\sec{(x+8\\pi)} = 2\\sqrt 2.$" "The period of $y = \\sec x$ is $2\\pi.$ Therefore, for integer $n$ we have\n\n$$\n\\sec{x} = \\sec{(x+2n\\pi)} .\n$$\n\nSubstituting $n=4$ into the above gives\n\n$$\n\\begin{aligned}\\sec ⁡x & =\\sec ⁡(x+2\\cdot 4\\cdot \\pi ) \\\\  & =\\sec ⁡(x+8\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\sec{x} = 2\\sqrt 2,$ then $\\sec{(x+8\\pi)} = 2\\sqrt 2.$"] [:db/cas 17592186175702 :question/worked-solution "The period of $y = \\cot x$ is $\\pi.$ Therefore, for any integer $n,$ we have\n\n$$\n\\cot{x} = \\cot{(x+n\\pi)} .\n$$\n\nSubstituting $n=5$ into the above gives\n\n$$\n\\begin{aligned}cot⁡x & =cot⁡(x+5\\cdot \\pi ) \\\\  & =cot⁡(x+5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cot{x} = 1,$ then $\\cot{(x+5\\pi)} = 1.$" "The period of $y = \\cot x$ is $\\pi.$ Therefore, for any integer $n,$ we have\n\n$$\n\\cot{x} = \\cot{(x+n\\pi)} .\n$$\n\nSubstituting $n=5$ into the above gives\n\n$$\n\\begin{aligned}\\cot ⁡x & =\\cot ⁡(x+5\\cdot \\pi ) \\\\  & =\\cot ⁡(x+5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cot{x} = 1,$ then $\\cot{(x+5\\pi)} = 1.$"] [:db/cas 17592186175703 :question/worked-solution "First, let's recall the graph of $y=\\cos{x}.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\cos{x}$ is $2\\pi.$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\cos{x}$ is an *even* function, and we have\n\n$$\n\\cos(-x) = \\cos{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\cos{x},$ we have\n\n$$\n\\begin{aligned}cos⁡(-x-6\\pi ) & =cos⁡(-x-2\\pi \\cdot 3) \\\\  & =cos⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\cos{x},$ we have\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =\\frac{\\sqrt{3}}{4}.\\end{aligned}\n$$\n\nTherefore, $\\cos (-x-6\\pi)= \\dfrac{\\sqrt 3}{4}.$" "First, let's recall the graph of $y=\\cos{x}.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\cos{x}$ is $2\\pi.$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\cos{x}$ is an *even* function, and we have\n\n$$\n\\cos(-x) = \\cos{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\cos{x},$ we have\n\n$$\n\\begin{aligned}\\cos ⁡(-x-6\\pi ) & =\\cos ⁡(-x-2\\pi \\cdot 3) \\\\  & =\\cos ⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\cos{x},$ we have\n\n$$\n\\begin{aligned}\\cos ⁡(-x) & =\\cos ⁡x \\\\  & =\\frac{\\sqrt{3}}{4}.\\end{aligned}\n$$\n\nTherefore, $\\cos (-x-6\\pi)= \\dfrac{\\sqrt 3}{4}.$"] [:db/cas 17592186175704 :question/worked-solution "First, let's recall the graph of $y=\\tan{x}.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\tan{x}$ is $\\pi.$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\tan{x}$ is an *odd* function, and we have\n\n$$\n\\tan(-x) = -\\tan{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\tan{x},$ we have\n\n$$\n\\begin{aligned}tan⁡(-x+7\\pi ) & =tan⁡(-x+\\pi \\cdot 7) \\\\  & =tan⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\tan{x},$ we have\n\n$$\n\\begin{aligned}tan⁡(-x) & =-tan⁡x \\\\  & =-\\left(-\\frac{2}{3}\\right).\\end{aligned}\n$$\n\nTherefore, $\\tan (-x+7\\pi)=\\dfrac{2}{3}.$" "First, let's recall the graph of $y=\\tan{x}.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\tan{x}$ is $\\pi.$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\tan{x}$ is an *odd* function, and we have\n\n$$\n\\tan(-x) = -\\tan{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\tan{x},$ we have\n\n$$\n\\begin{aligned}\\tan ⁡(-x+7\\pi ) & =\\tan ⁡(-x+\\pi \\cdot 7) \\\\  & =\\tan ⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\tan{x},$ we have\n\n$$\n\\begin{aligned}\\tan ⁡(-x) & =-\\tan ⁡x \\\\  & =-\\left(-\\frac{2}{3}\\right).\\end{aligned}\n$$\n\nTherefore, $\\tan (-x+7\\pi)=\\dfrac{2}{3}.$"] [:db/cas 17592186175705 :question/worked-solution "First, let's recall the graph of $y = \\sec{x}.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\sec{x}$ is $2\\pi.$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\sec{x}$ is an *even* function, and we have\n\n$$\n\\sec(-x) = \\sec{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\sec{x},$ we have\n\n$$\n\\begin{aligned}sec⁡(-x-14\\pi ) & =sec⁡(-x-2\\pi \\cdot 7) \\\\  & =sec⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\sec{x},$ we have\n\n$$\n\\begin{aligned}sec⁡(-x) & =sec⁡x \\\\  & =-\\frac{11}{6}.\\end{aligned}\n$$\n\nTherefore, $\\sec(-x - 14\\pi) = -\\dfrac{11}{6}.$" "First, let's recall the graph of $y = \\sec{x}.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\sec{x}$ is $2\\pi.$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\sec{x}$ is an *even* function, and we have\n\n$$\n\\sec(-x) = \\sec{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\sec{x},$ we have\n\n$$\n\\begin{aligned}\\sec ⁡(-x-14\\pi ) & =\\sec ⁡(-x-2\\pi \\cdot 7) \\\\  & =\\sec ⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\sec{x},$ we have\n\n$$\n\\begin{aligned}\\sec ⁡(-x) & =\\sec ⁡x \\\\  & =-\\frac{11}{6}.\\end{aligned}\n$$\n\nTherefore, $\\sec(-x - 14\\pi) = -\\dfrac{11}{6}.$"] [:db/cas 17592186175707 :question/worked-solution "First, let's recall the graph of $y=\\cot{x}.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\cot{x}$ is $\\pi.$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\cot{x}$ is an *odd* function, and we have\n\n$$\n\\cot(-x) = -\\cot{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\cot{x},$ we have\n\n$$\n\\begin{aligned}cot⁡(-x+7\\pi ) & =cot⁡(-x+\\pi \\cdot 7) \\\\  & =cot⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\cot{x},$ we have\n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, $\\cot (-x+7\\pi)=-2.$" "First, let's recall the graph of $y=\\cot{x}.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\cot{x}$ is $\\pi.$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\cot{x}$ is an *odd* function, and we have\n\n$$\n\\cot(-x) = -\\cot{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\cot{x},$ we have\n\n$$\n\\begin{aligned}\\cot ⁡(-x+7\\pi ) & =\\cot ⁡(-x+\\pi \\cdot 7) \\\\  & =\\cot ⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\cot{x},$ we have\n\n$$\n\\begin{aligned}\\cot ⁡(-x) & =-\\cot ⁡x \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, $\\cot (-x+7\\pi)=-2.$"] [:db/cas 17592186175713 :question/worked-solution "First, substituting the transformations\n\n$$\nx =\\dfrac1{2}X, \\qquad\ny = Z, \\qquad\nz = 2Y\n$$\n\ninto our equation, we get \n\n$$\nZ = X^2 + Y^2.\n$$\n\nIf $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX = r\\cos\\theta, \\qquad\nY = r\\sin\\theta, \\qquad \nZ = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}Z & ={X}^{2}+{Y}^{2} \\\\ Z & =(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} \\\\ Z & ={r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\ Z & ={r}^{2}.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(r,\\theta ) & =⟨x,y,z⟩ \\\\  & =⟨\\frac{1}{2}X,Z,2Y⟩ \\\\  & =⟨\\frac{1}{2}r\\operatorname{cos}⁡\\theta ,\\,Z,\\,2r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨\\frac{1}{2}r\\operatorname{cos}⁡\\theta ,\\,{r}^{2},\\,2r\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $r \\in [0,\\infty)$ and $\\theta \\in [0,2\\pi).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue} \\dfrac1{2} r \\cos\\theta}.$" "First, substituting the transformations\n\n$$\nx =\\dfrac1{2}X, \\qquad\ny = Z, \\qquad\nz = 2Y\n$$\n\ninto our equation, we get \n\n$$\nZ = X^2 + Y^2.\n$$\n\nIf $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX = r\\cos\\theta, \\qquad\nY = r\\sin\\theta, \\qquad \nZ = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}Z & ={X}^{2}+{Y}^{2} \\\\ Z & =(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} \\\\ Z & ={r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta ) \\\\ Z & ={r}^{2}.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(r,\\theta ) & =⟨x,y,z⟩ \\\\  & =⟨\\frac{1}{2}X,Z,2Y⟩ \\\\  & =⟨\\frac{1}{2}r\\operatorname{cos}⁡\\theta ,\\,Z,\\,2r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨\\frac{1}{2}r\\operatorname{cos}⁡\\theta ,\\,{r}^{2},\\,2r\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $r \\in [0,\\infty)$ and $\\theta \\in [0,2\\pi).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue} \\dfrac1{2} r \\cos\\theta}.$"] [:db/cas 17592186175743 :question/worked-solution "We know that the profit function is given by\n\n$$\nP(x)=R(x)-C(x)\n$$\n\nwhere $x$ is the number of units, $C(x)$ is the cost function and $R(x)$ is the revenue function.\n\nWe're given the price function $p(x)$, so the revenue function is\n\n$$\n\\begin{aligned}\nR(x) &= (number of units) \\cdot (price per unit) \\\\\n&= x \\cdot p(x) \\\\\n&= x(50 - 0.1x) \\\\\n&= 50x - 0.1x^{2}\n\\end{aligned}\n$$\n\nWe're also told that the fixed costs are $\\$2\\,000$ per month, and each unit costs $\\$20$ to make. Therefore, the cost function is\n\n$$\n\\begin{aligned}\nC(x) &= (fixed cost) + (number of units) \\cdot (cost per unit) \\\\\n&= 2000 + x \\cdot 20 \\\\\n&= 2000 + 20x\n\\end{aligned}\n$$\n\nFinally, we can now calculate the profit function:\n\n$$\n\\begin{aligned}\nP(x) &= R(x) - C(x) \\\\\n&= (50x - 0.1x^{2}) - (2000 + 20x) \\\\\n&= 50x - 0.1x^{2} - 2000 - 20x \\\\\n&=-0.1x^{2} + 30x - 2000\n\\end{aligned}\n$$" "We know that the profit function is given by\n\n$$\nP(x)=R(x)-C(x)\n$$\n\nwhere $x$ is the number of units, $C(x)$ is the cost function and $R(x)$ is the revenue function.\n\nWe're given the price function $p(x)$, so the revenue function is\n\n$$\n\\begin{aligned}\nR(x) &= (number of units) \\cdot (price per unit) \\\\\n&= x \\cdot p(x) \\\\\n&= x(50 - 0.1x) \\\\\n&= 50x - 0.1x^{2}\n\\end{aligned}\n$$\n\nWe're also told that the fixed costs are $\\$2\\,000$ per month, and each unit costs $\\$20$ to make. Therefore, the cost function is\n\n$$\n\\begin{aligned}\nC(x) &= (fixed \\cos t) + (number of units) \\cdot (\\cos t per unit) \\\\\n&= 2000 + x \\cdot 20 \\\\\n&= 2000 + 20x\n\\end{aligned}\n$$\n\nFinally, we can now calculate the profit function:\n\n$$\n\\begin{aligned}\nP(x) &= R(x) - C(x) \\\\\n&= (50x - 0.1x^{2}) - (2000 + 20x) \\\\\n&= 50x - 0.1x^{2} - 2000 - 20x \\\\\n&=-0.1x^{2} + 30x - 2000\n\\end{aligned}\n$$"] [:db/cas 17592186175810 :question/worked-solution "We use the following identity:\n\n$$\n\\begin{aligned}\nVar[X] &= E[X^{2}] - E[X]^{2} \\\\\n&= M^{″}(0) - [M^{′}(0)]^{2}\n\\end{aligned}\n$$\n\nFirst, we express $M(t)$ in a form that is easy to differentiate:\n\n$$\nM(t) = (1-2t)^{-2}\n$$\n\nComputing derivatives of $M(t)$, we get\n\n$$\n\\begin{aligned}\nM^{′}(t) &= (4)/((1 - 2t)^{3}) \\\\\nM^{″}(t) &= (24)/((1 - 2t)^{4})\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nM^{′}(0) &= 4 \\\\\nM^{″}(0) &= 24\n\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\nVar[X] &= M^{″}(0) - [M^{′}(0)]^{2} \\\\\n&= 24 - 4^{2} \\\\\n&= 8\n\\end{aligned}\n$$" "We use the following identity:\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [X] &= E[X^{2}] - E[X]^{2} \\\\\n&= M^{″}(0) - [M^{′}(0)]^{2}\n\\end{aligned}\n$$\n\nFirst, we express $M(t)$ in a form that is easy to differentiate:\n\n$$\nM(t) = (1-2t)^{-2}\n$$\n\nComputing derivatives of $M(t)$, we get\n\n$$\n\\begin{aligned}\nM^{′}(t) &= (4)/((1 - 2t)^{3}) \\\\\nM^{″}(t) &= (24)/((1 - 2t)^{4})\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nM^{′}(0) &= 4 \\\\\nM^{″}(0) &= 24\n\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [X] &= M^{″}(0) - [M^{′}(0)]^{2} \\\\\n&= 24 - 4^{2} \\\\\n&= 8\n\\end{aligned}\n$$"] [:db/cas 17592186175820 :question/worked-solution "Recall that the ellipse $\\dfrac{x^2}{4}+\\dfrac{y^2}{16}=1$ in $xy$-plane has the parametrization\n\n$$\n\\langle x,y \\rangle = \\big\\langle 2\\cos{t}, \\: 4\\sin{t} \\big\\rangle,\n\\qquad t \\in [0,2\\pi),\n$$\n\nsince \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16} & =\\frac{(2\\operatorname{cos}⁡t)^{2}}{4}+\\frac{(4\\operatorname{sin}⁡t)^{2}}{16} \\\\  & =\\frac{4{cos}^{2}⁡t}{4}+\\frac{16{sin}^{2}⁡t}{16} \\\\  & ={cos}^{2}⁡t+{sin}^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨{\\color{blue}2\\operatorname{cos}t},\\hspace{0.222em}4\\operatorname{sin}t,\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t \\in [0,2\\pi)$ and $z \\in (-\\infty,\\infty).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}2\\cos{t}}.$" "Recall that the ellipse $\\dfrac{x^2}{4}+\\dfrac{y^2}{16}=1$ in $xy$-plane has the parametrization\n\n$$\n\\langle x,y \\rangle = \\big\\langle 2\\cos{t}, \\: 4\\sin{t} \\big\\rangle,\n\\qquad t \\in [0,2\\pi),\n$$\n\nsince \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16} & =\\frac{(2\\operatorname{cos}⁡t)^{2}}{4}+\\frac{(4\\operatorname{sin}⁡t)^{2}}{16} \\\\  & =\\frac{4{\\cos }^{2}⁡t}{4}+\\frac{16{\\sin }^{2}⁡t}{16} \\\\  & ={\\cos }^{2}⁡t+{\\sin }^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨{\\color{blue}2\\operatorname{cos}t},\\hspace{0.222em}4\\operatorname{sin}t,\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t \\in [0,2\\pi)$ and $z \\in (-\\infty,\\infty).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}2\\cos{t}}.$"] [:db/cas 17592186175821 :question/worked-solution "First, substituting the transformations\n\n$$\nx = 3X, \\qquad\ny = 4Z, \\qquad\nz = Y\n$$\n\ninto our equation, we get\n\n$$\nX^2 + Y^2 - Z^2 = 1.\n$$\n\nIf $(r, \\theta, Z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX = r\\cos\\theta, \\qquad\nY = r\\sin\\theta, \\qquad \nZ = Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{Z}^{2} & =1 \\\\ {r}^{2}-{Z}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola $r^2 - Z^2 = 1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta$ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n\\langle r, Z \\rangle = \\langle \\cosh{\\phi}, \\: \\sinh{\\phi} \\rangle,\n\\qquad \\phi \\in \\mathbb R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3X,4Z,Y⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,4Z,\\,r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3(\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ,\\,(\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ,\\,\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi)$ and $\\phi \\in \\mathbb R.$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue} \\cosh{\\phi} \\sin\\theta }.$" "First, substituting the transformations\n\n$$\nx = 3X, \\qquad\ny = 4Z, \\qquad\nz = Y\n$$\n\ninto our equation, we get\n\n$$\nX^2 + Y^2 - Z^2 = 1.\n$$\n\nIf $(r, \\theta, Z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX = r\\cos\\theta, \\qquad\nY = r\\sin\\theta, \\qquad \nZ = Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =1 \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )-{Z}^{2} & =1 \\\\ {r}^{2}-{Z}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola $r^2 - Z^2 = 1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta$ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n\\langle r, Z \\rangle = \\langle \\cosh{\\phi}, \\: \\sinh{\\phi} \\rangle,\n\\qquad \\phi \\in \\mathbb R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3X,4Z,Y⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,4Z,\\,r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3(\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ,\\,(\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ,\\,\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi)$ and $\\phi \\in \\mathbb R.$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue} \\cosh{\\phi} \\sin\\theta }.$"] [:db/cas 17592186175823 :question/worked-solution "Recall that the hyperbola $\\dfrac{z^2}{4} - \\dfrac{x^2}{16} = 1$ for $z \\geq 2$ in $xz$-plane has the parametrization\n\n$$\n\\langle x , z \\rangle = \\big \\langle 4\\tan{t}, \\, 2\\sec{t} \\big\\rangle,\n\n\\qquad t \\in \\left(-\\dfrac{\\pi}{2},\\dfrac{\\pi}{2}\\right)\n$$\n\nsince \n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{4}-\\frac{{x}^{2}}{16} & =\\frac{(2\\operatorname{sec}⁡t)^{2}}{4}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & =\\frac{4{sec}^{2}⁡t}{4}-\\frac{16{tan}^{2}⁡t}{16} \\\\  & ={sec}^{2}⁡t-{tan}^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,y) & =⟨x,y,z⟩ \\\\  & =⟨4\\operatorname{tan}t,\\hspace{0.167em}y,\\hspace{0.167em}{\\color{blue}2\\operatorname{sec}t}⟩\\end{aligned}\n$$\n\nwhere $$\n\\displaystyle t \\in \\left(-\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2}\\right)\n$$ and $y \\in (-\\infty, \\infty).$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue}2\\sec{t}}.$" "Recall that the hyperbola $\\dfrac{z^2}{4} - \\dfrac{x^2}{16} = 1$ for $z \\geq 2$ in $xz$-plane has the parametrization\n\n$$\n\\langle x , z \\rangle = \\big \\langle 4\\tan{t}, \\, 2\\sec{t} \\big\\rangle,\n\n\\qquad t \\in \\left(-\\dfrac{\\pi}{2},\\dfrac{\\pi}{2}\\right)\n$$\n\nsince \n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{4}-\\frac{{x}^{2}}{16} & =\\frac{(2\\operatorname{sec}⁡t)^{2}}{4}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & =\\frac{4{\\sec }^{2}⁡t}{4}-\\frac{16{\\tan }^{2}⁡t}{16} \\\\  & ={\\sec }^{2}⁡t-{\\tan }^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,y) & =⟨x,y,z⟩ \\\\  & =⟨4\\operatorname{tan}t,\\hspace{0.167em}y,\\hspace{0.167em}{\\color{blue}2\\operatorname{sec}t}⟩\\end{aligned}\n$$\n\nwhere $$\n\\displaystyle t \\in \\left(-\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2}\\right)\n$$ and $y \\in (-\\infty, \\infty).$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue}2\\sec{t}}.$"] [:db/cas 17592186175824 :question/worked-solution "If $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(x,y,z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nx = r\\cos\\theta, \\qquad\n\ny = r\\sin\\theta, \\qquad \n\nz = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =-9 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{z}^{2} & =-9 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{z}^{2} & =-9 \\\\ {r}^{2}-{z}^{2} & =-9 \\\\ {z}^{2}-{r}^{2} & =9.\\end{aligned}\n$$\n\nHere, the hyperbola $z^2 - r^2 = 9$ represents the intersection of our hyperboloid with the plane that passes through the $z$-axis and makes the angle of $\\theta$ with the positive $x$-axis. \n\n![](images/4e/4e7b508432f12b8dc98e37ae2786d220eb97bdc58fe5a29c5f7728cac46471f0.png)\n\nUsing the hint, a parametrization of such hyperbola can be given as\n\n$$\n\\langle z, r \\rangle = \\langle 3\\cosh{\\phi}, \\: 3\\sinh{\\phi} \\rangle,\n\\qquad \\phi \\in \\mathbb R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩ \\\\  & =⟨(3\\operatorname{sinh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,(3\\operatorname{sinh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{cosh}⁡ϕ⟩ \\\\  & =⟨3\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,3\\operatorname{sinh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{cosh}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi)$ and $\\phi \\in \\mathbb R.$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}3\\sinh{\\phi} \\cos\\theta} .$" "If $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(x,y,z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nx = r\\cos\\theta, \\qquad\n\ny = r\\sin\\theta, \\qquad \n\nz = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =-9 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{z}^{2} & =-9 \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )-{z}^{2} & =-9 \\\\ {r}^{2}-{z}^{2} & =-9 \\\\ {z}^{2}-{r}^{2} & =9.\\end{aligned}\n$$\n\nHere, the hyperbola $z^2 - r^2 = 9$ represents the intersection of our hyperboloid with the plane that passes through the $z$-axis and makes the angle of $\\theta$ with the positive $x$-axis. \n\n![](images/4e/4e7b508432f12b8dc98e37ae2786d220eb97bdc58fe5a29c5f7728cac46471f0.png)\n\nUsing the hint, a parametrization of such hyperbola can be given as\n\n$$\n\\langle z, r \\rangle = \\langle 3\\cosh{\\phi}, \\: 3\\sinh{\\phi} \\rangle,\n\\qquad \\phi \\in \\mathbb R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩ \\\\  & =⟨(3\\operatorname{sinh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,(3\\operatorname{sinh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{cosh}⁡ϕ⟩ \\\\  & =⟨3\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,3\\operatorname{sinh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{cosh}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi)$ and $\\phi \\in \\mathbb R.$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}3\\sinh{\\phi} \\cos\\theta} .$"] [:db/cas 17592186175864 :question/worked-solution "We use the following identity:\n\n$$\n\\begin{aligned}\nSD[X] &= \\sqrt{Var[X]} \\\\\n&= \\sqrt{E[X^{2}] - E[X]^{2}} \\\\\n&= \\sqrt{M^{″}(0) - [M^{′}(0)]^{2}}\n\\end{aligned}\n$$\n\nComputing derivatives of $M(t)$, we get\n\n$$\n\\begin{aligned}\nM^{′}(t) &= \\frac{1}{5}e^{t} \\\\\nM^{″}(t) &= \\frac{1}{5}e^{t}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nM^{′}(0) &= \\frac{1}{5} \\\\\nM^{″}(0) &= \\frac{1}{5}\n\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\nSD[X] &= \\sqrt{M^{″}(0) - [M^{′}(0)]^{2}} \\\\\n&= \\sqrt{\\frac{1}{5} - \\left(\\frac{1}{5}\\right)^{2}} \\\\\n&= \\sqrt{\\frac{4}{25}} \\\\\n&= \\frac{2}{5}\n\\end{aligned}\n$$" "We use the following identity:\n\n$$\n\\begin{aligned}\nSD[X] &= \\sqrt{\\operatorname{Var} [X]} \\\\\n&= \\sqrt{E[X^{2}] - E[X]^{2}} \\\\\n&= \\sqrt{M^{″}(0) - [M^{′}(0)]^{2}}\n\\end{aligned}\n$$\n\nComputing derivatives of $M(t)$, we get\n\n$$\n\\begin{aligned}\nM^{′}(t) &= \\frac{1}{5}e^{t} \\\\\nM^{″}(t) &= \\frac{1}{5}e^{t}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nM^{′}(0) &= \\frac{1}{5} \\\\\nM^{″}(0) &= \\frac{1}{5}\n\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\nSD[X] &= \\sqrt{M^{″}(0) - [M^{′}(0)]^{2}} \\\\\n&= \\sqrt{\\frac{1}{5} - \\left(\\frac{1}{5}\\right)^{2}} \\\\\n&= \\sqrt{\\frac{4}{25}} \\\\\n&= \\frac{2}{5}\n\\end{aligned}\n$$"] [:db/cas 17592186176195 :question/worked-solution "Recall that the hyperbola ${x}^{2}-{y}^{2}=9$ for $x\\ge 3$ in $xy$-plane has the parametrization\n\n$$\n⟨x,y⟩=⟨3\\operatorname{sec}⁡t,\\,3\\operatorname{tan}⁡t⟩,\\,t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})\n$$\n\nsince \n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =(3\\operatorname{sec}⁡t)^{2}-(3\\operatorname{tan}⁡t)^{2} \\\\  & =9({sec}^{2}⁡t-{tan}^{2}⁡t) \\\\  & =9.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨3\\operatorname{sec}t,\\hspace{0.222em}{\\color{blue}3\\operatorname{tan}t},\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})$ and $z\\in (-\\infty ,\\infty ).$\n\nTherefore, the second component of $\\mathbf{f}$ is ${\\color{blue}3\\operatorname{tan}t}.$" "Recall that the hyperbola ${x}^{2}-{y}^{2}=9$ for $x\\ge 3$ in $xy$-plane has the parametrization\n\n$$\n⟨x,y⟩=⟨3\\operatorname{sec}⁡t,\\,3\\operatorname{tan}⁡t⟩,\\,t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})\n$$\n\nsince \n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =(3\\operatorname{sec}⁡t)^{2}-(3\\operatorname{tan}⁡t)^{2} \\\\  & =9({\\sec }^{2}⁡t-{\\tan }^{2}⁡t) \\\\  & =9.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨3\\operatorname{sec}t,\\hspace{0.222em}{\\color{blue}3\\operatorname{tan}t},\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})$ and $z\\in (-\\infty ,\\infty ).$\n\nTherefore, the second component of $\\mathbf{f}$ is ${\\color{blue}3\\operatorname{tan}t}.$"] [:db/cas 17592186176196 :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(x,y,z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{z}^{2} & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{z}^{2} & =16 \\\\ {r}^{2}-{z}^{2} & =16.\\end{aligned}\n$$\n\nHere, the hyperbola ${r}^{2}-{z}^{2}=16$ represents the intersection of our hyperboloid with the plane that passes through the $z$-axis and makes the angle of $\\theta $ with the positive $x$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨r,z⟩=⟨4\\operatorname{cosh}⁡ϕ,\\,4\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩ \\\\  & =⟨(4\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,(4\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ⟩ \\\\  & =⟨4\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,4\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the second component of $f$ is $4\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta .$" "If $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(x,y,z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{z}^{2} & =16 \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )-{z}^{2} & =16 \\\\ {r}^{2}-{z}^{2} & =16.\\end{aligned}\n$$\n\nHere, the hyperbola ${r}^{2}-{z}^{2}=16$ represents the intersection of our hyperboloid with the plane that passes through the $z$-axis and makes the angle of $\\theta $ with the positive $x$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨r,z⟩=⟨4\\operatorname{cosh}⁡ϕ,\\,4\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩ \\\\  & =⟨(4\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,(4\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ⟩ \\\\  & =⟨4\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,4\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,4\\operatorname{sinh}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the second component of $f$ is $4\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta .$"] [:db/cas 17592186176197 :question/worked-solution "First, substituting the transformations\n\n$$\nx=3X,\\,y=Z,\\,z=2Y\n$$\n\ninto our equation, we get\n\n$$\n{X}^{2}+{Y}^{2}-{Z}^{2}=1.\n$$\n\nIf $(r,\\theta ,Z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{Z}^{2} & =1 \\\\ {r}^{2}-{Z}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola ${r}^{2}-{Z}^{2}=1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta $ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨r,Z⟩=⟨\\operatorname{cosh}⁡ϕ,\\,\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3X,Z,2Y⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,Z,\\,2r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3(\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,\\operatorname{sinh}⁡ϕ,\\,2(\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,\\operatorname{sinh}⁡ϕ,\\,2\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the first component of $f$ is $3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta .$" "First, substituting the transformations\n\n$$\nx=3X,\\,y=Z,\\,z=2Y\n$$\n\ninto our equation, we get\n\n$$\n{X}^{2}+{Y}^{2}-{Z}^{2}=1.\n$$\n\nIf $(r,\\theta ,Z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =1 \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )-{Z}^{2} & =1 \\\\ {r}^{2}-{Z}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola ${r}^{2}-{Z}^{2}=1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta $ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨r,Z⟩=⟨\\operatorname{cosh}⁡ϕ,\\,\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3X,Z,2Y⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,Z,\\,2r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3(\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,\\operatorname{sinh}⁡ϕ,\\,2(\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,\\operatorname{sinh}⁡ϕ,\\,2\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the first component of $f$ is $3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta .$"] [:db/cas 17592186176201 :question/worked-solution "First, substituting the transformations\n\n$$\nx=3X,\\,y=Z,\\,z=2Y\n$$\n\ninto our equation, we get\n\n$$\n{X}^{2}+{Y}^{2}-{Z}^{2}=-1.\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =-1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =-1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{Z}^{2} & =-1 \\\\ {r}^{2}-{Z}^{2} & =-1 \\\\ {Z}^{2}-{r}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola ${Z}^{2}-{r}^{2}=1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta $ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨Z,r⟩=⟨\\operatorname{cosh}⁡ϕ,\\,\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3X,Z,2Y⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,Z,\\,2r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3(\\operatorname{sinh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,\\operatorname{cosh}⁡ϕ,\\,2(\\operatorname{sinh}⁡ϕ)\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,\\operatorname{cosh}⁡ϕ,\\,2\\operatorname{sinh}⁡ϕ\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the second component of $f$ is $3\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta .$" "First, substituting the transformations\n\n$$\nx=3X,\\,y=Z,\\,z=2Y\n$$\n\ninto our equation, we get\n\n$$\n{X}^{2}+{Y}^{2}-{Z}^{2}=-1.\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =-1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =-1 \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )-{Z}^{2} & =-1 \\\\ {r}^{2}-{Z}^{2} & =-1 \\\\ {Z}^{2}-{r}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola ${Z}^{2}-{r}^{2}=1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta $ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨Z,r⟩=⟨\\operatorname{cosh}⁡ϕ,\\,\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3X,Z,2Y⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,Z,\\,2r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3(\\operatorname{sinh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,\\operatorname{cosh}⁡ϕ,\\,2(\\operatorname{sinh}⁡ϕ)\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,\\operatorname{cosh}⁡ϕ,\\,2\\operatorname{sinh}⁡ϕ\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the second component of $f$ is $3\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta .$"] [:db/cas 17592186176208 :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{2}}\\,\\text{d}x.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+(\\operatorname{cos}⁡x)^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+{cos}^{2}⁡x}\\,\\text{d}x.\\end{aligned}\n$$" "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{2}}\\,\\text{d}x.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+(\\operatorname{cos}⁡x)^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+{\\cos }^{2}⁡x}\\,\\text{d}x.\\end{aligned}\n$$"] [:db/cas 17592186176214 :question/worked-solution "For a surface $S$ defined by $y=f(x,z)$ with $(x,z)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{\\left(\\frac{∂y}{∂x}\\right)}^{2}+{\\left(\\frac{∂y}{∂z}\\right)}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\ny=\\operatorname{sin}⁡x+z,\\,(x,z)\\in D,\n$$\n\nwhere \n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le z\\le \\operatorname{sin}⁡(2x)\\},\n$$\n\nas shown in the diagram below.\n\n![](images/be/be5dc3bf3ed4b6b7bee06d583b69e40a3922edede1e61a6f0b68d2ce0767f92a.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂y}{∂x} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡x+z)=\\operatorname{cos}⁡x, \\\\ \\frac{∂y}{∂z} & =\\frac{∂}{∂z}(\\operatorname{sin}⁡x+z)=1,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{\\left(\\frac{∂y}{∂x}\\right)}^{2}+{\\left(\\frac{∂y}{∂z}\\right)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(\\operatorname{cos}⁡x)^{2}+(1)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{2+{cos}^{2}⁡x}\\,\\text{d}A \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡(2x)}\\sqrt{2+{cos}^{2}⁡x}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2+{cos}^{2}⁡x}\\cdot z\\,{|}_{z=0}^{z=\\operatorname{sin}⁡(2x)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\sqrt{2+{cos}^{2}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nSetting $u=2+{cos}^{2}⁡x,$ we get $\\text{d}u=-2\\operatorname{cos}⁡x\\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{sin}⁡(2x)\\,\\text{d}x.$ Also, the limits must be changed as follows:\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & \\frac{\\pi }{2} \\\\ \\hline u & 3 & 2 \\\\ \\hline\\end{array}\n$$\n\n \n\nSubstituting these into our integral, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\sqrt{2+{cos}^{2}⁡x}\\,\\text{d}x & =-{\\int }_{3}^{2}{u}^{1/2}\\,\\text{d}u \\\\  & ={\\int }_{2}^{3}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{3}{u}^{3/2}\\,{|}_{2}^{3} \\\\  & =\\frac{2}{3}({3}^{3/2}-{2}^{3/2}) \\\\  & =\\frac{2}{3}(3\\sqrt{3}-2\\sqrt{2}).\\end{aligned}\n$$" "For a surface $S$ defined by $y=f(x,z)$ with $(x,z)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{\\left(\\frac{∂y}{∂x}\\right)}^{2}+{\\left(\\frac{∂y}{∂z}\\right)}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\ny=\\operatorname{sin}⁡x+z,\\,(x,z)\\in D,\n$$\n\nwhere \n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le z\\le \\operatorname{sin}⁡(2x)\\},\n$$\n\nas shown in the diagram below.\n\n![](images/be/be5dc3bf3ed4b6b7bee06d583b69e40a3922edede1e61a6f0b68d2ce0767f92a.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂y}{∂x} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡x+z)=\\operatorname{cos}⁡x, \\\\ \\frac{∂y}{∂z} & =\\frac{∂}{∂z}(\\operatorname{sin}⁡x+z)=1,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{\\left(\\frac{∂y}{∂x}\\right)}^{2}+{\\left(\\frac{∂y}{∂z}\\right)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(\\operatorname{cos}⁡x)^{2}+(1)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{2+{\\cos }^{2}⁡x}\\,\\text{d}A \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡(2x)}\\sqrt{2+{\\cos }^{2}⁡x}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2+{\\cos }^{2}⁡x}\\cdot z\\,{|}_{z=0}^{z=\\operatorname{sin}⁡(2x)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\sqrt{2+{\\cos }^{2}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nSetting $u=2+{\\cos }^{2}⁡x,$ we get $\\text{d}u=-2\\operatorname{cos}⁡x\\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{sin}⁡(2x)\\,\\text{d}x.$ Also, the limits must be changed as follows:\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & \\frac{\\pi }{2} \\\\ \\hline u & 3 & 2 \\\\ \\hline\\end{array}\n$$\n\n \n\nSubstituting these into our integral, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\sqrt{2+{\\cos }^{2}⁡x}\\,\\text{d}x & =-{\\int }_{3}^{2}{u}^{1/2}\\,\\text{d}u \\\\  & ={\\int }_{2}^{3}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{3}{u}^{3/2}\\,{|}_{2}^{3} \\\\  & =\\frac{2}{3}({3}^{3/2}-{2}^{3/2}) \\\\  & =\\frac{2}{3}(3\\sqrt{3}-2\\sqrt{2}).\\end{aligned}\n$$"] [:db/cas 17592186176224 :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}4-\\lambda  & 1 \\\\ -1 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(2-\\lambda )-1\\cdot (-1) & =0 \\\\ {\\lambda }^{2}-6\\lambda +9 & =0 \\\\ (\\lambda -3)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=3.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(3)=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}.\n$$" "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}4-\\lambda  & 1 \\\\ -1 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(2-\\lambda )-1\\cdot (-1) & =0 \\\\ {\\lambda }^{2}-6\\lambda +9 & =0 \\\\ (\\lambda -3)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=3.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(3)=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}.\n$$"] [:db/cas 17592186176225 :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}6-\\lambda  & 5 \\\\ -10 & -9-\\lambda \\end{vmatrix} & =0 \\\\ (6-\\lambda )(-9-\\lambda )-(5)(-10) & =0 \\\\ {\\lambda }^{2}+3\\lambda -4 & =0 \\\\ (\\lambda -1)(\\lambda +4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(1)\\,⊕\\,{J}_{1}(-4)=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}.\n$$" "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}6-\\lambda  & 5 \\\\ -10 & -9-\\lambda \\end{vmatrix} & =0 \\\\ (6-\\lambda )(-9-\\lambda )-(5)(-10) & =0 \\\\ {\\lambda }^{2}+3\\lambda -4 & =0 \\\\ (\\lambda -1)(\\lambda +4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(1)\\,⊕\\,{J}_{1}(-4)=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}.\n$$"] [:db/cas 17592186176230 :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}-8-\\lambda  & 5 \\\\ -5 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (-8-\\lambda )(2-\\lambda )-5\\cdot (-5) & =0 \\\\ {\\lambda }^{2}+6\\lambda +9 & =0 \\\\ (\\lambda +3)(\\lambda +3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-3.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(-3)=\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}.\n$$" "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}-8-\\lambda  & 5 \\\\ -5 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (-8-\\lambda )(2-\\lambda )-5\\cdot (-5) & =0 \\\\ {\\lambda }^{2}+6\\lambda +9 & =0 \\\\ (\\lambda +3)(\\lambda +3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-3.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(-3)=\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}.\n$$"] [:db/cas 17592186176282 :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}5-\\lambda  & -2 \\\\ 1 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(8-\\lambda )-(-2)(1) & =0 \\\\ {\\lambda }^{2}-13\\lambda +42 & =0 \\\\ (\\lambda -7)(\\lambda -6) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=7$ and ${\\lambda }_{2}=6.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(7)\\,⊕\\,{J}_{1}(6)=\\begin{bmatrix}7 & 0 \\\\ 0 & 6\\end{bmatrix}\n$$" "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}5-\\lambda  & -2 \\\\ 1 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(8-\\lambda )-(-2)(1) & =0 \\\\ {\\lambda }^{2}-13\\lambda +42 & =0 \\\\ (\\lambda -7)(\\lambda -6) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=7$ and ${\\lambda }_{2}=6.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(7)\\,⊕\\,{J}_{1}(6)=\\begin{bmatrix}7 & 0 \\\\ 0 & 6\\end{bmatrix}\n$$"] [:db/cas 17592186176284 :question/problem "Given that the moment-generating function of the random variable $X$ is given by\n$M(t) = \\frac{1}{2}(e^{-t} + e^{t})$,\n\ncompute $Var[X]$." "Given that the moment-generating function of the random variable $X$ is given by\n$M(t) = \\frac{1}{2}(e^{-t} + e^{t})$,\n\ncompute $\\operatorname{Var} [X]$."] [:db/cas 17592186176346 :question/problem "If $cos⁡a=-\\frac{1}{3},$ then $cos⁡(-a)=$" "If $\\cos ⁡a=-\\frac{1}{3},$ then $\\cos ⁡(-a)=$"] [:db/cas 17592186176346 :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph over the $y$-axis, we get the same picture. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}cos⁡(-a) & =cos⁡a \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$" "First, let's recall the graph of $y=\\cos ⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph over the $y$-axis, we get the same picture. This means that $\\cos ⁡x$ is an *even* function, and we have\n\n$$\n\\cos ⁡(-x)=\\cos ⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\cos ⁡(-a) & =\\cos ⁡a \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"] [:db/cas 17592186176347 :question/problem "If $tan⁡a=-2,$ then $tan⁡(-a)=$" "If $\\tan ⁡a=-2,$ then $\\tan ⁡(-a)=$"] [:db/cas 17592186176347 :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$" "First, let's recall the graph of $y=\\tan ⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $\\tan ⁡x$ is an *odd* function, and we have\n\n$$\n\\tan ⁡(-x)=-\\tan ⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\tan ⁡(-a) & =-\\tan ⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$"] [:db/cas 17592186176401 :question/worked-solution "First, substituting the transformations\n\n$$\nx=Z,\\,y=2X,\\,z=Y\n$$\n\ninto our equation, we get \n\n$$\nZ={X}^{2}+{Y}^{2}.\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}Z & ={X}^{2}+{Y}^{2} \\\\ Z & =(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} \\\\ Z & ={r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\ Z & ={r}^{2}.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(r,\\theta ) & =⟨x,y,z⟩ \\\\  & =⟨Z,2X,Y⟩ \\\\  & =⟨Z,\\,2r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨{r}^{2},\\,2r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $r\\in [0,\\infty )$ and $\\theta \\in [0,2\\pi ).$\n\nTherefore, the third component of $f$ is $r\\operatorname{sin}⁡\\theta .$" "First, substituting the transformations\n\n$$\nx=Z,\\,y=2X,\\,z=Y\n$$\n\ninto our equation, we get \n\n$$\nZ={X}^{2}+{Y}^{2}.\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}Z & ={X}^{2}+{Y}^{2} \\\\ Z & =(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} \\\\ Z & ={r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta ) \\\\ Z & ={r}^{2}.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(r,\\theta ) & =⟨x,y,z⟩ \\\\  & =⟨Z,2X,Y⟩ \\\\  & =⟨Z,\\,2r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨{r}^{2},\\,2r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $r\\in [0,\\infty )$ and $\\theta \\in [0,2\\pi ).$\n\nTherefore, the third component of $f$ is $r\\operatorname{sin}⁡\\theta .$"] [:db/cas 17592186176440 :question/problem "Find the moment-generating function $M(t)$ of $X∼Exp(4)$ for $t < 4$.$M(t) =$\n{{field-1}}" "Find the moment-generating function $M(t)$ of $X∼\\operatorname{Exp} (4)$ for $t < 4$.$M(t) =$\n{{field-1}}"] [:db/cas 17592186176446 :question/problem "Find the moment-generating function $M(t)$ of $X∼Exp(1)$ for $t < 1$.$M(t) =$\n{{field-1}}" "Find the moment-generating function $M(t)$ of $X∼\\operatorname{Exp} (1)$ for $t < 1$.$M(t) =$\n{{field-1}}"] [:db/cas 17592186176452 :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply." "Which of the following statements are true regarding the function $y=\\tan ⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply."] [:db/cas 17592186176452 :question/worked-solution "Let's plot the graph of $y=tan⁡x.$\n\n![](images/32/326418398ce1a33f03a21f3bdb58107856f4ccb72241429f1604486281e60822.png)\n\nLet's go through each statement.\n\n- Statement “The function has asymptotes at $x=n\\pi .$” is false. The function has an asymptote at $x=\\frac{\\pi }{2}$ and the period is $\\pi .$ Therefore, the asymptotes occur at $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement “The function returns only positive values on the intervals $(\\pi n,\\frac{\\pi }{2}+\\pi n)\\,.$” is true. The function returns only positive values on the interval $(0,\\frac{\\pi }{2})$ and the period is $\\pi .$ Therefore, the function is positive on $(n\\pi ,\\frac{\\pi }{2}+n\\pi )\\,.$\n\n- Statement “The function has zeros at $x=\\frac{\\pi }{2}+n\\pi .$” is false. The zeros occur at $x=0,\\pm \\pi ,\\pm 2\\pi ,…,$ which can be written as $x=n\\pi .$\n\nSo, the correct answer is “The function returns only positive values on the intervals $(\\pi n,\\frac{\\pi }{2}+\\pi n)\\,.$” only." "Let's plot the graph of $y=\\tan ⁡x.$\n\n![](images/32/326418398ce1a33f03a21f3bdb58107856f4ccb72241429f1604486281e60822.png)\n\nLet's go through each statement.\n\n- Statement “The function has asymptotes at $x=n\\pi .$” is false. The function has an asymptote at $x=\\frac{\\pi }{2}$ and the period is $\\pi .$ Therefore, the asymptotes occur at $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement “The function returns only positive values on the intervals $(\\pi n,\\frac{\\pi }{2}+\\pi n)\\,.$” is true. The function returns only positive values on the interval $(0,\\frac{\\pi }{2})$ and the period is $\\pi .$ Therefore, the function is positive on $(n\\pi ,\\frac{\\pi }{2}+n\\pi )\\,.$\n\n- Statement “The function has zeros at $x=\\frac{\\pi }{2}+n\\pi .$” is false. The zeros occur at $x=0,\\pm \\pi ,\\pm 2\\pi ,…,$ which can be written as $x=n\\pi .$\n\nSo, the correct answer is “The function returns only positive values on the intervals $(\\pi n,\\frac{\\pi }{2}+\\pi n)\\,.$” only."] [:db/cas 17592186176480 :question/worked-solution "First, we need to find the eigenvalues of $A.$ To do that, we must solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-6-\\lambda  & -4 \\\\ 5 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (-6-\\lambda )(2-\\lambda )-(-4)(5) & =0 \\\\ -12+6\\lambda -2\\lambda +{\\lambda }^{2}+20 & =0 \\\\ {\\lambda }^{2}+4\\lambda +8 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-4\\pm \\sqrt{{4}^{2}-4(1)(8)}}{2(1)} \\\\  & =\\frac{-4\\pm 4\\text{i}}{2} \\\\  & =-2\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-2\\pm 2\\text{i}.$\n\nNow, let's consider the eigenvalue ${\\lambda }_{1}=-2+2\\text{i}.$ We have\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}-6 & -4 \\\\ 5 & 2\\end{bmatrix}-\\begin{bmatrix}-2+2\\text{i} & 0 \\\\ 0 & -2+2\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4-2\\text{i} & -4 \\\\ 5 & 4-2\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, we get the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}(-4-2\\text{i}){x}_{1}-4{x}_{2} &=0 \\\\ 5{x}_{1}+(4-2\\text{i}){x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-(-2+2\\text{i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=(-1-\\frac{1}{2}\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ (-1-\\frac{1}{2}\\text{i}){x}_{1}\\end{bmatrix},\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=2,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}2 \\\\ -2-\\text{i}\\end{bmatrix}.\n$$\n\n \n\nThen, to compute the second eigenvector corresponding to ${\\lambda }_{2}=-2-2\\text{i}$, we simply compute the complex conjugate of ${\\overset{―}{v}}_{1},$ and get\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}2 \\\\ -2+\\text{i}\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}} & =\\frac{(2)(2)}{(-2-\\text{i})(-2+\\text{i})}=\\frac{4}{5}.\\end{aligned}\n$$" "First, we need to find the eigenvalues of $A.$ To do that, we must solve the characteristic equation $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-6-\\lambda  & -4 \\\\ 5 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (-6-\\lambda )(2-\\lambda )-(-4)(5) & =0 \\\\ -12+6\\lambda -2\\lambda +{\\lambda }^{2}+20 & =0 \\\\ {\\lambda }^{2}+4\\lambda +8 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-4\\pm \\sqrt{{4}^{2}-4(1)(8)}}{2(1)} \\\\  & =\\frac{-4\\pm 4\\text{i}}{2} \\\\  & =-2\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-2\\pm 2\\text{i}.$\n\nNow, let's consider the eigenvalue ${\\lambda }_{1}=-2+2\\text{i}.$ We have\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}-6 & -4 \\\\ 5 & 2\\end{bmatrix}-\\begin{bmatrix}-2+2\\text{i} & 0 \\\\ 0 & -2+2\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4-2\\text{i} & -4 \\\\ 5 & 4-2\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, we get the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}(-4-2\\text{i}){x}_{1}-4{x}_{2} &=0 \\\\ 5{x}_{1}+(4-2\\text{i}){x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-(-2+2\\text{i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=(-1-\\frac{1}{2}\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ (-1-\\frac{1}{2}\\text{i}){x}_{1}\\end{bmatrix},\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=2,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}2 \\\\ -2-\\text{i}\\end{bmatrix}.\n$$\n\n \n\nThen, to compute the second eigenvector corresponding to ${\\lambda }_{2}=-2-2\\text{i}$, we simply compute the complex conjugate of ${\\overset{―}{v}}_{1},$ and get\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}2 \\\\ -2+\\text{i}\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}} & =\\frac{(2)(2)}{(-2-\\text{i})(-2+\\text{i})}=\\frac{4}{5}.\\end{aligned}\n$$"] [:db/cas 17592186176496 :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y={log}_{2}⁡x?$ \n\nSelect all that apply." "On which of the following intervals can the extreme value theorem be applied to the function $y={\\log }_{2}⁡x?$ \n\nSelect all that apply."] [:db/cas 17592186176589 :question/problem "Given that the moment-generating function of the random variable $X$ is given by\n$M(t) = \\frac{1}{\\sqrt{1 - 2t}}$,\n\ncompute $Var[X]$." "Given that the moment-generating function of the random variable $X$ is given by\n$M(t) = \\frac{1}{\\sqrt{1 - 2t}}$,\n\ncompute $\\operatorname{Var} [X]$."] [:db/cas 17592186176990 :tutorial/content "![](images/86/867722106ffd8445b62a98ab43197ac2fba646faff95017ef7e92c254a97fb6e.png)\n\n  \n\nThe surface $S$ shown above consists of the part of the paraboloid $z=x^2+y^2$ that lies under the plane $z=9.$ Let's compute the surface area of $S.$\n\nThe plane intersects the paraboloid when $z=9.$ Thus, the curve that describes the intersection points is\n\n$$\nx^2+y^2 = 9,\n$$\n\nwhich is a circle of radius $3$ in the $xy$-plane. \n\nTherefore, our surface can be described by the equations\n\n$$\nz = f(x,y) = x^2 + y^2, \\quad (x,y) \\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD = \\left\\{(x,y): \\, x^2 + y^2 \\le 9\\right\\}.\n$$\n\nTo compute the surface area of $S,$ we use the formula\n\n$$\n\\iint\\limits_S \\,  \\text{d}S = \\iint\\limits_D \\sqrt{1+\\left(\\dfrac{\\partial z}{\\partial x}\\right)^2+\\left(\\dfrac{\\partial z}{\\partial y}\\right)^2} \\: \\text{d}A.\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})=2x, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}({x}^{2}+{y}^{2})=2y\\end{aligned}\n$$\n\nSubstituting these expressions into our surface area formula, we get\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{\\left(\\frac{∂z}{∂x}\\right)}^{2}+{\\left(\\frac{∂z}{∂y}\\right)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(2x)^{2}+(2y)^{2}}\\,dA \\\\  & ={∬}_{D}\\sqrt{1+4{x}^{2}+4{y}^{2}}\\,dA.\\end{aligned}\n$$\n\nNow, by changing the variables to polar coordinates $(x,y)\\to (r,\\theta),$ we have $\\textrm dA = r\\,\\textrm d r\\, \\textrm d \\theta.$ Thus, our integration region becomes\n\n$$\n\\Delta = \\left\\{(r,\\theta): \\, 0\\leq r\\leq 3,\\:0\\leq\\theta\\lt 2\\pi\\right\\}.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+4{x}^{2}+4{y}^{2}}\\,dA & ={∬}_{Δ}\\sqrt{1+4(r\\operatorname{cos}⁡\\theta )^{2}+4(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,dr\\,d\\theta  \\\\  & ={∬}_{Δ}r\\sqrt{1+4{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,dr\\,d\\theta  \\\\  & ={∬}_{Δ}r\\sqrt{1+4{r}^{2}}\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}r\\sqrt{1+4{r}^{2}\\,}\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,d\\theta \\,{\\int }_{0}^{3}r\\sqrt{1+4{r}^{2}\\,}\\,dr \\\\  & =2\\pi {\\int }_{0}^{3}r\\sqrt{1+4{r}^{2}\\,}\\,dr \\\\  & =2\\pi {[\\frac{1}{12}{(1+4{r}^{2})}^{3/2}]}_{0}^{3} \\\\  & =\\frac{\\pi }{6}{[{(1+4{r}^{2})}^{3/2}]}_{0}^{3} \\\\  & =\\frac{\\pi }{6}(37\\sqrt{37}-1).\\end{aligned}\n$$\n\nSo, we conclude that the area of our surface is \n\n$$\n\\iint\\limits_S \\,  \\text{d}S =  \\dfrac{\\pi}{6}(37\\sqrt{37} -1).\n$$" "![](images/86/867722106ffd8445b62a98ab43197ac2fba646faff95017ef7e92c254a97fb6e.png)\n\n  \n\nThe surface $S$ shown above consists of the part of the paraboloid $z=x^2+y^2$ that lies under the plane $z=9.$ Let's compute the surface area of $S.$\n\nThe plane intersects the paraboloid when $z=9.$ Thus, the curve that describes the intersection points is\n\n$$\nx^2+y^2 = 9,\n$$\n\nwhich is a circle of radius $3$ in the $xy$-plane. \n\nTherefore, our surface can be described by the equations\n\n$$\nz = f(x,y) = x^2 + y^2, \\quad (x,y) \\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD = \\left\\{(x,y): \\, x^2 + y^2 \\le 9\\right\\}.\n$$\n\nTo compute the surface area of $S,$ we use the formula\n\n$$\n\\iint\\limits_S \\,  \\text{d}S = \\iint\\limits_D \\sqrt{1+\\left(\\dfrac{\\partial z}{\\partial x}\\right)^2+\\left(\\dfrac{\\partial z}{\\partial y}\\right)^2} \\: \\text{d}A.\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})=2x, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}({x}^{2}+{y}^{2})=2y\\end{aligned}\n$$\n\nSubstituting these expressions into our surface area formula, we get\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{\\left(\\frac{∂z}{∂x}\\right)}^{2}+{\\left(\\frac{∂z}{∂y}\\right)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(2x)^{2}+(2y)^{2}}\\,dA \\\\  & ={∬}_{D}\\sqrt{1+4{x}^{2}+4{y}^{2}}\\,dA.\\end{aligned}\n$$\n\nNow, by changing the variables to polar coordinates $(x,y)\\to (r,\\theta),$ we have $\\textrm dA = r\\,\\textrm d r\\, \\textrm d \\theta.$ Thus, our integration region becomes\n\n$$\n\\Delta = \\left\\{(r,\\theta): \\, 0\\leq r\\leq 3,\\:0\\leq\\theta\\lt 2\\pi\\right\\}.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+4{x}^{2}+4{y}^{2}}\\,dA & ={∬}_{Δ}\\sqrt{1+4(r\\operatorname{cos}⁡\\theta )^{2}+4(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,dr\\,d\\theta  \\\\  & ={∬}_{Δ}r\\sqrt{1+4{r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )}\\,dr\\,d\\theta  \\\\  & ={∬}_{Δ}r\\sqrt{1+4{r}^{2}}\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}r\\sqrt{1+4{r}^{2}\\,}\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,d\\theta \\,{\\int }_{0}^{3}r\\sqrt{1+4{r}^{2}\\,}\\,dr \\\\  & =2\\pi {\\int }_{0}^{3}r\\sqrt{1+4{r}^{2}\\,}\\,dr \\\\  & =2\\pi {[\\frac{1}{12}{(1+4{r}^{2})}^{3/2}]}_{0}^{3} \\\\  & =\\frac{\\pi }{6}{[{(1+4{r}^{2})}^{3/2}]}_{0}^{3} \\\\  & =\\frac{\\pi }{6}(37\\sqrt{37}-1).\\end{aligned}\n$$\n\nSo, we conclude that the area of our surface is \n\n$$\n\\iint\\limits_S \\,  \\text{d}S =  \\dfrac{\\pi}{6}(37\\sqrt{37} -1).\n$$"] [:db/cas 17592186177007 :tutorial/content "Suppose that $X$ is a random variable. We know that the variance of $X$ can be expressed in terms of the raw moments $\\textrm E[X]$ and $\\textrm E[X^2]$ as follows:\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - \\textrm{E}[X]^2\n$$\n\nLet $M(t)$ be the moment-generating function of $X$. Since\n\n$$\n\\textrm E [X] = M'(0), \\qquad \\textrm E [X^2] = M''(0)\n$$\n\nwe can express the variance of $X$ in terms of derivatives of the MGF evaluated at zero:\n\n$$\n\\textrm{Var}[X] =M''(0) - [M'(0)]^2\n$$\n\nFor example, let the random variable $X$ have the following probability distribution:\n\n$$\nf(x) = {\\left\\{  \\begin{array}{ll}{\\displaystyle \\frac{2}{3}} , & x = 0 \\\\ {\\displaystyle \\frac{1}{3}} , & x = 1\\end{array} \\right. }\n$$\n\nThen, the MGF is given by\n\n$$\n\\begin{aligned}\nM(t) &= f(0)e^{0t} + f(1)e^{t} \\\\\n&= \\frac{2}{3} + \\frac{1}{3}e^{t}\n\\end{aligned}\n$$\n\nTaking the first derivative and the second derivative of MGF, we get\n\n$$\n\\begin{aligned}\nM^{′}(t) &= \\frac{d}{dx}(\\frac{2}{3} + \\frac{1}{3}e^{t}) \\\\\n&= \\frac{1}{3}e^{t}, \\\\\nM^{″}(t) &= \\frac{d}{dx}(M^{′}(t)) \\\\\n&= \\frac{d}{dx}(\\frac{1}{3}e^{t}) \\\\\n&= \\frac{1}{3}e^{t}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nVar[X] &= M^{″}(0) - (M^{′}(0))^{2} \\\\\n&= \\frac{1}{3} - \\left(\\frac{1}{3}\\right)^{2} \\\\\n&= \\frac{1}{3} - \\frac{1}{9} \\\\\n&= \\frac{2}{9}\n\\end{aligned}\n$$" "Suppose that $X$ is a random variable. We know that the variance of $X$ can be expressed in terms of the raw moments $\\textrm E[X]$ and $\\textrm E[X^2]$ as follows:\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - \\textrm{E}[X]^2\n$$\n\nLet $M(t)$ be the moment-generating function of $X$. Since\n\n$$\n\\textrm E [X] = M'(0), \\qquad \\textrm E [X^2] = M''(0)\n$$\n\nwe can express the variance of $X$ in terms of derivatives of the MGF evaluated at zero:\n\n$$\n\\textrm{Var}[X] =M''(0) - [M'(0)]^2\n$$\n\nFor example, let the random variable $X$ have the following probability distribution:\n\n$$\nf(x) = {\\left\\{  \\begin{array}{ll}{\\displaystyle \\frac{2}{3}} , & x = 0 \\\\ {\\displaystyle \\frac{1}{3}} , & x = 1\\end{array} \\right. }\n$$\n\nThen, the MGF is given by\n\n$$\n\\begin{aligned}\nM(t) &= f(0)e^{0t} + f(1)e^{t} \\\\\n&= \\frac{2}{3} + \\frac{1}{3}e^{t}\n\\end{aligned}\n$$\n\nTaking the first derivative and the second derivative of MGF, we get\n\n$$\n\\begin{aligned}\nM^{′}(t) &= \\frac{d}{dx}(\\frac{2}{3} + \\frac{1}{3}e^{t}) \\\\\n&= \\frac{1}{3}e^{t}, \\\\\nM^{″}(t) &= \\frac{d}{dx}(M^{′}(t)) \\\\\n&= \\frac{d}{dx}(\\frac{1}{3}e^{t}) \\\\\n&= \\frac{1}{3}e^{t}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\operatorname{Var} [X] &= M^{″}(0) - (M^{′}(0))^{2} \\\\\n&= \\frac{1}{3} - \\left(\\frac{1}{3}\\right)^{2} \\\\\n&= \\frac{1}{3} - \\frac{1}{9} \\\\\n&= \\frac{2}{9}\n\\end{aligned}\n$$"] [:db/cas 17592186177024 :tutorial/content "We can construct a cost function $C(x)$ for a business using the following equation:\n\n$$\nC(x) = (\\text{fixed cost}) + (\\textrm{number of units})\\cdot (\\textrm{cost per unit})\n$$\n\nLet's break this equation down a bit:\n\n- The **fixed cost** is the part of the cost function that does not change. Irrespective of how many units are produced, fixed costs are always the same. Fixed costs typically incorporate rent, utilities, communications, employee wages, taxes, etc.\n- The term $(\\textrm{number of units})\\cdot (\\textrm{cost per unit})$ represents the **variable cost.** This part of the cost function changes depending on how many units are produced.\n\nFor example, suppose that a company produces $x$ units of sweaters per month. Each unit costs $\\$49$ to make, and the company's fixed costs are $\\$4\\,500$ per month.\n\nWe can calculate the cost function $C(x)$ for this company as follows:\n\n$$\n\\begin{aligned}\nC(x) &= (fixed cost) + (number of units) \\cdot (cost per unit) \\\\\n&= 4500 + x \\cdot 49 \\\\\n&= 4500 + 49x\n\\end{aligned}\n$$\n\nTo calculate the cost of producing $50$ units, we substitute $x=50$ into $C(x)$. This gives\n\n$$\n\\begin{aligned}\nC(50) &= 4500 + 49(50) \\\\\n&= 4500 + 2450 \\\\\n&= 6950\n\\end{aligned}\n$$\n\nTherefore, it costs the company $\\$6\\,950$ to produce $50$ units." "We can construct a cost function $C(x)$ for a business using the following equation:\n\n$$\nC(x) = (\\text{fixed cost}) + (\\textrm{number of units})\\cdot (\\textrm{cost per unit})\n$$\n\nLet's break this equation down a bit:\n\n- The **fixed cost** is the part of the cost function that does not change. Irrespective of how many units are produced, fixed costs are always the same. Fixed costs typically incorporate rent, utilities, communications, employee wages, taxes, etc.\n- The term $(\\textrm{number of units})\\cdot (\\textrm{cost per unit})$ represents the **variable cost.** This part of the cost function changes depending on how many units are produced.\n\nFor example, suppose that a company produces $x$ units of sweaters per month. Each unit costs $\\$49$ to make, and the company's fixed costs are $\\$4\\,500$ per month.\n\nWe can calculate the cost function $C(x)$ for this company as follows:\n\n$$\n\\begin{aligned}\nC(x) &= (fixed \\cos t) + (number of units) \\cdot (\\cos t per unit) \\\\\n&= 4500 + x \\cdot 49 \\\\\n&= 4500 + 49x\n\\end{aligned}\n$$\n\nTo calculate the cost of producing $50$ units, we substitute $x=50$ into $C(x)$. This gives\n\n$$\n\\begin{aligned}\nC(50) &= 4500 + 49(50) \\\\\n&= 4500 + 2450 \\\\\n&= 6950\n\\end{aligned}\n$$\n\nTherefore, it costs the company $\\$6\\,950$ to produce $50$ units."] [:db/cas 17592186177054 :tutorial/content "![](images/7a/7a1647aa543ef6b9c4c2004e358a91b8d034bd8d72cc53e72bf0dc69266366bc.png)\n\nTo find the horizontal tangents, we proceed as follows:\n\n**Step 1**: Compute the derivatives $y'(\\theta)$ and $x'(\\theta).$ \n\nDoing this using the usual methods, we get\n\n$$\nx'(\\theta)=-\\sin\\theta(2\\cos\\theta+1), \\qquad \ny'(\\theta)=2\\cos^2\\theta +\\cos\\theta - 1.\n$$\n\n**Step 2**: Find the values of $\\theta$ where $y'(\\theta)=0.$\n\nWriting down the equation $y'(\\theta) = 0$ and factoring, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1 & =0 \\\\ (2\\operatorname{cos}⁡\\theta -1)(\\operatorname{cos}⁡\\theta +1) & =0.\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n2\\cos\\theta-1 = 0, \\qquad \\cos\\theta + 1= 0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve the equation\n\n$$\n2\\cos\\theta-1 = 0,  \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solutions to this equation are \n\n$$\n\\theta = \\dfrac{\\pi}{3},\\dfrac{5\\pi}{3}.\n$$\n\n- Then, we solve the equation\n\n$$\n\\cos\\theta + 1=0, \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solution to this equation is \n\n$$\n\\theta = \\pi.\n$$\n\nTherefore, we have three candidate solutions:\n\n$$\n\\theta_1 = \\dfrac{\\pi}{3}, \\qquad \\theta_2 = \\pi, \\qquad \\theta_3 = \\dfrac{5\\pi}{3}\n$$\n\n**Step 3**: Check to see whether any candidates have $x'(\\theta) = 0.$ \n\nWe substitute our candidate solutions into the expression for $x'(\\theta).$ If $x'(\\theta) = 0,$ further investigation is necessary.  \n\n- Substituting $\\theta_1 = \\dfrac{\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{\\pi }{3}\\right) & =-\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)(2\\operatorname{cos}⁡\\left(\\frac{\\pi }{3}\\right)+1) \\\\  & =-\\frac{\\sqrt{3}}{2}(2\\cdot \\frac{1}{2}+1) \\\\  & =-\\frac{\\sqrt{3}}{2}(1+1) \\\\  & =-\\frac{\\sqrt{3}}{2}\\cdot 2 \\\\  & =-\\sqrt{3} \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_1 = \\dfrac{\\pi}{3}$ is a valid solution.\n\n- Substituting $\\theta_2 = \\pi,$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\pi ) & =-\\operatorname{sin}⁡(\\pi )(2\\operatorname{cos}⁡(\\pi )+1) \\\\  & =-0\\cdot (-1) \\\\  & =0.\\,\\times \\end{aligned}\n$$\n\nTherefore, we draw *no conclusion* regarding $\\theta_2 = \\pi.$\n\n- Substituting $\\theta_1 = \\dfrac{5\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{\\pi }{3}\\right) & =-\\operatorname{sin}⁡\\left(\\frac{5\\pi }{3}\\right)(2\\operatorname{cos}⁡\\left(\\frac{5\\pi }{3}\\right)+1) \\\\  & =\\frac{\\sqrt{3}}{2}(2\\cdot \\frac{1}{2}+1) \\\\  & =\\frac{\\sqrt{3}}{2}(1+1) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot 2 \\\\  & =\\sqrt{3} \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_1 = \\dfrac{5\\pi}{3}$ is a valid solution.\n\nWe now make the following conclusions: \n\n- We have horizontal tangents where $\\theta = \\dfrac{\\pi}{3}$ and $\\theta = \\dfrac{5\\pi}{3}.$ These correspond to the points $A$ and $B,$ respectively.\n\n- This analysis gave no conclusion regarding the point where $\\theta = \\pi.$ We'll learn to deal with points like this in future lessons.\n\nFor the remainder of this lesson, we will not concern ourselves with the case where $y'(\\theta)$ and $x'(\\theta)$ are both zero. However, it's worth carrying out step 3 regardless when solving these problems, as this will help develop good habits that will come in handy later." "![](images/7a/7a1647aa543ef6b9c4c2004e358a91b8d034bd8d72cc53e72bf0dc69266366bc.png)\n\nTo find the horizontal tangents, we proceed as follows:\n\n**Step 1**: Compute the derivatives $y'(\\theta)$ and $x'(\\theta).$ \n\nDoing this using the usual methods, we get\n\n$$\nx'(\\theta)=-\\sin\\theta(2\\cos\\theta+1), \\qquad \ny'(\\theta)=2\\cos^2\\theta +\\cos\\theta - 1.\n$$\n\n**Step 2**: Find the values of $\\theta$ where $y'(\\theta)=0.$\n\nWriting down the equation $y'(\\theta) = 0$ and factoring, we get\n\n$$\n\\begin{aligned}2{\\cos }^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1 & =0 \\\\ (2\\operatorname{cos}⁡\\theta -1)(\\operatorname{cos}⁡\\theta +1) & =0.\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n2\\cos\\theta-1 = 0, \\qquad \\cos\\theta + 1= 0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve the equation\n\n$$\n2\\cos\\theta-1 = 0,  \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solutions to this equation are \n\n$$\n\\theta = \\dfrac{\\pi}{3},\\dfrac{5\\pi}{3}.\n$$\n\n- Then, we solve the equation\n\n$$\n\\cos\\theta + 1=0, \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solution to this equation is \n\n$$\n\\theta = \\pi.\n$$\n\nTherefore, we have three candidate solutions:\n\n$$\n\\theta_1 = \\dfrac{\\pi}{3}, \\qquad \\theta_2 = \\pi, \\qquad \\theta_3 = \\dfrac{5\\pi}{3}\n$$\n\n**Step 3**: Check to see whether any candidates have $x'(\\theta) = 0.$ \n\nWe substitute our candidate solutions into the expression for $x'(\\theta).$ If $x'(\\theta) = 0,$ further investigation is necessary.  \n\n- Substituting $\\theta_1 = \\dfrac{\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{\\pi }{3}\\right) & =-\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)(2\\operatorname{cos}⁡\\left(\\frac{\\pi }{3}\\right)+1) \\\\  & =-\\frac{\\sqrt{3}}{2}(2\\cdot \\frac{1}{2}+1) \\\\  & =-\\frac{\\sqrt{3}}{2}(1+1) \\\\  & =-\\frac{\\sqrt{3}}{2}\\cdot 2 \\\\  & =-\\sqrt{3} \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_1 = \\dfrac{\\pi}{3}$ is a valid solution.\n\n- Substituting $\\theta_2 = \\pi,$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\pi ) & =-\\operatorname{sin}⁡(\\pi )(2\\operatorname{cos}⁡(\\pi )+1) \\\\  & =-0\\cdot (-1) \\\\  & =0.\\,\\times \\end{aligned}\n$$\n\nTherefore, we draw *no conclusion* regarding $\\theta_2 = \\pi.$\n\n- Substituting $\\theta_1 = \\dfrac{5\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{\\pi }{3}\\right) & =-\\operatorname{sin}⁡\\left(\\frac{5\\pi }{3}\\right)(2\\operatorname{cos}⁡\\left(\\frac{5\\pi }{3}\\right)+1) \\\\  & =\\frac{\\sqrt{3}}{2}(2\\cdot \\frac{1}{2}+1) \\\\  & =\\frac{\\sqrt{3}}{2}(1+1) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot 2 \\\\  & =\\sqrt{3} \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_1 = \\dfrac{5\\pi}{3}$ is a valid solution.\n\nWe now make the following conclusions: \n\n- We have horizontal tangents where $\\theta = \\dfrac{\\pi}{3}$ and $\\theta = \\dfrac{5\\pi}{3}.$ These correspond to the points $A$ and $B,$ respectively.\n\n- This analysis gave no conclusion regarding the point where $\\theta = \\pi.$ We'll learn to deal with points like this in future lessons.\n\nFor the remainder of this lesson, we will not concern ourselves with the case where $y'(\\theta)$ and $x'(\\theta)$ are both zero. However, it's worth carrying out step 3 regardless when solving these problems, as this will help develop good habits that will come in handy later."] [:db/cas 17592186177061 :tutorial/content "![](images/20/20b8d6a35a9925c0442830f0abd20c522f0e3a420d27e6239e43120edbfc55d3.png)\n\nTo find the vertical tangents, we proceed as follows:\n\n**Step 1**: Compute the derivatives $y'(\\theta)$ and $x'(\\theta).$ \n\nDoing this using the usual methods, we get\n\n$$\nx'(\\theta)=-\\sin\\theta(2\\cos\\theta+1), \\qquad \ny'(\\theta)=2\\cos^2\\theta +\\cos\\theta - 1.\n$$\n\n**Step 2**: Find the values of $\\theta$ where $x'(\\theta)=0{:}$\n\nWriting down the equation $x'(\\theta) = 0,$ we get\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡\\theta (2\\operatorname{cos}⁡\\theta +1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n\\sin\\theta = 0, \\qquad 2\\cos\\theta+1= 0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve the equation\n\n$$\n\\sin\\theta = 0,  \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solutions to this equation are \n\n$$\n\\theta = 0,\\pi.\n$$\n\n- Then, we solve the equation\n\n$$\n2\\cos\\theta+1= 0, \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solutions to this equation are\n\n$$\n\\theta = \\dfrac{2\\pi}{3},\\dfrac{4\\pi}{3}.\n$$\n\nTherefore, we have four candidate solutions:\n\n$$\n\\theta_1 =0, \\qquad \\theta_2 = \\dfrac{2\\pi}{3}, \\qquad \\theta_3 = \\pi, \\qquad \\theta_2 = \\dfrac{4\\pi}{3}.\n$$\n\n**Step 3**: Check to see whether any candidates have $y'(\\theta) = 0.$ \n\nWe substitute our candidate solutions into $y'(\\theta)$ and check that $y'(\\theta) \\neq 0.$ If $y'(\\theta) = 0,$ further investigation is necessary.\n\n- Substituting $\\theta_1 = 0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & =2{cos}^{2}⁡(0)+\\operatorname{cos}⁡(0)-1 \\\\  & =2+1-1 \\\\  & =2 \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_1 = 0$ is a valid solution.\n\n- Substituting $\\theta_2 = \\dfrac{2\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{y}^{′}\\left(\\frac{2\\pi }{3}\\right) & =2{cos}^{2}⁡\\left(\\frac{2\\pi }{3}\\right)+\\operatorname{cos}⁡\\left(\\frac{2\\pi }{3}\\right)-1 \\\\  & =2\\cdot {\\left(-\\frac{1}{2}\\right)}^{2}-\\frac{1}{2}-1 \\\\  & =2\\cdot \\frac{1}{4}-\\frac{1}{2}-1 \\\\  & =\\frac{1}{2}-\\frac{1}{2}-1 \\\\  & =-1 \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_2 = \\dfrac{2\\pi}{3}$ is a valid solution.\n\n- Substituting $\\theta_3 = \\pi,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\pi ) & =2{cos}^{2}⁡(\\pi )+\\operatorname{cos}⁡(\\pi )-1 \\\\  & =2\\cdot (-1)^{2}-1-1 \\\\  & =2-1-1 \\\\  & =0.\\,\\times \\end{aligned}\n$$\n\nTherefore, we draw *no conclusion* regarding $\\theta_3 = \\pi.$\n\n- Substituting $\\theta_4 = \\dfrac{4\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{y}^{′}\\left(\\frac{4\\pi }{3}\\right) & =2{cos}^{2}⁡\\left(\\frac{4\\pi }{3}\\right)+\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)-1 \\\\  & =2\\cdot {\\left(-\\frac{1}{2}\\right)}^{2}-\\frac{1}{2}-1 \\\\  & =2\\cdot \\frac{1}{4}-\\frac{1}{2}-1 \\\\  & =\\frac{1}{2}-\\frac{1}{2}-1 \\\\  & =-1 \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_4 = \\dfrac{4\\pi}{3}$ is a valid solution.\n\nWe now make the following conclusions: \n\n- We have vertical tangents where $$\n\\displaystyle \\theta = 0, \\dfrac{2\\pi}{3},\\dfrac{4\\pi}{3}.\n$$ These correspond to the points $P, Q,$ and $R,$ respectively.\n\n- Again, this analysis gave no conclusion regarding the point where $\\theta = \\pi.$ We'll learn to deal with points like this in future lessons." "![](images/20/20b8d6a35a9925c0442830f0abd20c522f0e3a420d27e6239e43120edbfc55d3.png)\n\nTo find the vertical tangents, we proceed as follows:\n\n**Step 1**: Compute the derivatives $y'(\\theta)$ and $x'(\\theta).$ \n\nDoing this using the usual methods, we get\n\n$$\nx'(\\theta)=-\\sin\\theta(2\\cos\\theta+1), \\qquad \ny'(\\theta)=2\\cos^2\\theta +\\cos\\theta - 1.\n$$\n\n**Step 2**: Find the values of $\\theta$ where $x'(\\theta)=0{:}$\n\nWriting down the equation $x'(\\theta) = 0,$ we get\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡\\theta (2\\operatorname{cos}⁡\\theta +1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n\\sin\\theta = 0, \\qquad 2\\cos\\theta+1= 0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve the equation\n\n$$\n\\sin\\theta = 0,  \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solutions to this equation are \n\n$$\n\\theta = 0,\\pi.\n$$\n\n- Then, we solve the equation\n\n$$\n2\\cos\\theta+1= 0, \\qquad 0 \\leq \\theta < 2\\pi.\n$$\n\nThe solutions to this equation are\n\n$$\n\\theta = \\dfrac{2\\pi}{3},\\dfrac{4\\pi}{3}.\n$$\n\nTherefore, we have four candidate solutions:\n\n$$\n\\theta_1 =0, \\qquad \\theta_2 = \\dfrac{2\\pi}{3}, \\qquad \\theta_3 = \\pi, \\qquad \\theta_2 = \\dfrac{4\\pi}{3}.\n$$\n\n**Step 3**: Check to see whether any candidates have $y'(\\theta) = 0.$ \n\nWe substitute our candidate solutions into $y'(\\theta)$ and check that $y'(\\theta) \\neq 0.$ If $y'(\\theta) = 0,$ further investigation is necessary.\n\n- Substituting $\\theta_1 = 0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & =2{\\cos }^{2}⁡(0)+\\operatorname{cos}⁡(0)-1 \\\\  & =2+1-1 \\\\  & =2 \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_1 = 0$ is a valid solution.\n\n- Substituting $\\theta_2 = \\dfrac{2\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{y}^{′}\\left(\\frac{2\\pi }{3}\\right) & =2{\\cos }^{2}⁡\\left(\\frac{2\\pi }{3}\\right)+\\operatorname{cos}⁡\\left(\\frac{2\\pi }{3}\\right)-1 \\\\  & =2\\cdot {\\left(-\\frac{1}{2}\\right)}^{2}-\\frac{1}{2}-1 \\\\  & =2\\cdot \\frac{1}{4}-\\frac{1}{2}-1 \\\\  & =\\frac{1}{2}-\\frac{1}{2}-1 \\\\  & =-1 \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_2 = \\dfrac{2\\pi}{3}$ is a valid solution.\n\n- Substituting $\\theta_3 = \\pi,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\pi ) & =2{\\cos }^{2}⁡(\\pi )+\\operatorname{cos}⁡(\\pi )-1 \\\\  & =2\\cdot (-1)^{2}-1-1 \\\\  & =2-1-1 \\\\  & =0.\\,\\times \\end{aligned}\n$$\n\nTherefore, we draw *no conclusion* regarding $\\theta_3 = \\pi.$\n\n- Substituting $\\theta_4 = \\dfrac{4\\pi}{3},$ we get\n\n$$\n\\begin{aligned}{y}^{′}\\left(\\frac{4\\pi }{3}\\right) & =2{\\cos }^{2}⁡\\left(\\frac{4\\pi }{3}\\right)+\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)-1 \\\\  & =2\\cdot {\\left(-\\frac{1}{2}\\right)}^{2}-\\frac{1}{2}-1 \\\\  & =2\\cdot \\frac{1}{4}-\\frac{1}{2}-1 \\\\  & =\\frac{1}{2}-\\frac{1}{2}-1 \\\\  & =-1 \\\\  & \\ne 0.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\theta_4 = \\dfrac{4\\pi}{3}$ is a valid solution.\n\nWe now make the following conclusions: \n\n- We have vertical tangents where $$\n\\displaystyle \\theta = 0, \\dfrac{2\\pi}{3},\\dfrac{4\\pi}{3}.\n$$ These correspond to the points $P, Q,$ and $R,$ respectively.\n\n- Again, this analysis gave no conclusion regarding the point where $\\theta = \\pi.$ We'll learn to deal with points like this in future lessons."] [:db/cas 17592186177078 :tutorial/content "To find a parametrization of one sheet of the hyperbolic cylinder defined in Cartesian coordinates as \n\n$$\n\\dfrac{x^2}{25}-\\dfrac{y^2}{16}=1\n$$\n\nfor $x \\geq 5,$ recall that the corresponding hyperbola in $xy$-plane has the parametrization\n\n$$\n\\langle x,y \\rangle = \\big\\langle 5 \\sec{t}, \\: 4 \\tan{t} \\big\\rangle,\n\\qquad t\\in\\left(-\\dfrac\\pi2,\\dfrac\\pi2\\right)\n$$\n\nWe can check that this indeed parametrizes our base hyperbola by substituting the parametric equations into the equation of the base curve: \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{16} & =\\frac{(5\\operatorname{sec}⁡t)^{2}}{25}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & ={sec}^{2}⁡t-{tan}^{2}⁡t \\\\  & =1\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨5\\operatorname{sec}t,\\hspace{0.222em}4\\operatorname{tan}t,\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t\\in\\left(-\\dfrac\\pi2,\\dfrac\\pi2\\right)$ and $z \\in (-\\infty,\\infty).$" "To find a parametrization of one sheet of the hyperbolic cylinder defined in Cartesian coordinates as \n\n$$\n\\dfrac{x^2}{25}-\\dfrac{y^2}{16}=1\n$$\n\nfor $x \\geq 5,$ recall that the corresponding hyperbola in $xy$-plane has the parametrization\n\n$$\n\\langle x,y \\rangle = \\big\\langle 5 \\sec{t}, \\: 4 \\tan{t} \\big\\rangle,\n\\qquad t\\in\\left(-\\dfrac\\pi2,\\dfrac\\pi2\\right)\n$$\n\nWe can check that this indeed parametrizes our base hyperbola by substituting the parametric equations into the equation of the base curve: \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{16} & =\\frac{(5\\operatorname{sec}⁡t)^{2}}{25}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & ={\\sec }^{2}⁡t-{\\tan }^{2}⁡t \\\\  & =1\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨5\\operatorname{sec}t,\\hspace{0.222em}4\\operatorname{tan}t,\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t\\in\\left(-\\dfrac\\pi2,\\dfrac\\pi2\\right)$ and $z \\in (-\\infty,\\infty).$"] [:db/cas 17592186177079 :tutorial/content "We can also parametrize elliptic paraboloids using cylindrical polar coordinates. \n\nFor example, let's parametrize the elliptic paraboloid defined in Cartesian coordinates as\n\n$$\nz=\\dfrac{x^2}{9}+y^2.\n$$\n\nThe first step is to perform a substitution that transforms our paraboloid to one whose horizontal cross-sections (traces) are circles. To do this, we first define the following change of variables:\n\n$$\nx = 3X, \\qquad\ny = Y, \\qquad\nz = Z\n$$\n\n \n\nSubstituting this into the equation of our paraboloid, we get\n\n$$\n\\begin{aligned}z & =\\frac{{x}^{2}}{9}+{y}^{2} \\\\ Z & =\\frac{(3X)^{2}}{9}+{Y}^{2} \\\\ Z & ={X}^{2}+{Y}^{2}.\\end{aligned}\n$$\n\nNext, recall that if $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX = r\\cos\\theta, \\qquad\nY = r\\sin\\theta, \\qquad \nZ = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}Z & ={X}^{2}+{Y}^{2} \\\\ Z & =(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} \\\\ Z & ={r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\ Z & ={r}^{2}.\\end{aligned}\n$$\n\n  \n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(r,\\theta ) & =⟨x,y,z⟩ \\\\  & =⟨3X,Y,Z⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,Z⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,{r}^{2}⟩\\end{aligned}\n$$\n\nThus, the polar parametrization of our surface is as follows:\n\n$$\n\\mathbf{f}(r, \\theta) =  \\big\\langle 3 r\\cos\\theta, \\: r\\sin\\theta, \\: r^2 \\big\\rangle, \\qquad r \\in [0,\\infty), \\quad \\theta \\in [0,2\\pi)\n$$\n\nLet's now consider a case where the elliptic paraboloid has an axis of symmetry that's not parallel to the $z$-axis." "We can also parametrize elliptic paraboloids using cylindrical polar coordinates. \n\nFor example, let's parametrize the elliptic paraboloid defined in Cartesian coordinates as\n\n$$\nz=\\dfrac{x^2}{9}+y^2.\n$$\n\nThe first step is to perform a substitution that transforms our paraboloid to one whose horizontal cross-sections (traces) are circles. To do this, we first define the following change of variables:\n\n$$\nx = 3X, \\qquad\ny = Y, \\qquad\nz = Z\n$$\n\n \n\nSubstituting this into the equation of our paraboloid, we get\n\n$$\n\\begin{aligned}z & =\\frac{{x}^{2}}{9}+{y}^{2} \\\\ Z & =\\frac{(3X)^{2}}{9}+{Y}^{2} \\\\ Z & ={X}^{2}+{Y}^{2}.\\end{aligned}\n$$\n\nNext, recall that if $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX = r\\cos\\theta, \\qquad\nY = r\\sin\\theta, \\qquad \nZ = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}Z & ={X}^{2}+{Y}^{2} \\\\ Z & =(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} \\\\ Z & ={r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta ) \\\\ Z & ={r}^{2}.\\end{aligned}\n$$\n\n  \n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(r,\\theta ) & =⟨x,y,z⟩ \\\\  & =⟨3X,Y,Z⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,Z⟩ \\\\  & =⟨3r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,{r}^{2}⟩\\end{aligned}\n$$\n\nThus, the polar parametrization of our surface is as follows:\n\n$$\n\\mathbf{f}(r, \\theta) =  \\big\\langle 3 r\\cos\\theta, \\: r\\sin\\theta, \\: r^2 \\big\\rangle, \\qquad r \\in [0,\\infty), \\quad \\theta \\in [0,2\\pi)\n$$\n\nLet's now consider a case where the elliptic paraboloid has an axis of symmetry that's not parallel to the $z$-axis."] [:db/cas 17592186177080 :tutorial/content "We often need cylindrical polar coordinates *and* hyperbolic functions to parametrize a hyperboloid.\n\nFor example, let's parametrize a hyperboloid of one sheet defined in Cartesian coordinates as \n\n$$\nx^2+y^2-z^2=9.\n$$\n\n \n\nWe start by transforming to cylindrical polar coordinates in the usual way:\n\n$$\nx = r\\cos\\theta, \\qquad\ny = r\\sin\\theta, \\qquad \nz = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =9 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{z}^{2} & =9 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{z}^{2} & =9 \\\\ {r}^{2}-{z}^{2} & =9.\\end{aligned}\n$$\n\nHere, the hyperbola $r^2 - z^2 = 9$ represents the intersection of our hyperboloid with the vertical plane that passes through the $z$-axis and makes the angle of $\\theta$ with the positive $x$-axis. \n\n![](images/80/807e7c016733140d391ff69e0aa9695fe0927f4575607edc9b084eae5b7426a4.png)\n\n   \n\nUsing hyperbolic functions, we can parametrize this hyperbola as follows:\n\n$$\n\\langle r, z \\rangle = \\langle 3\\cosh{\\phi}, \\: 3\\sinh{\\phi} \\rangle,\n\\qquad \\phi \\in \\mathbb R\n$$\n\nTherefore, for any point $(x,y,z)$ on our surface, we obtain the following parametrization of our hyperbola:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩ \\\\  & =⟨(3\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,(3\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{sinh}⁡ϕ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,3\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{sinh}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi)$ and $\\phi \\in \\mathbb R.$" "We often need cylindrical polar coordinates *and* hyperbolic functions to parametrize a hyperboloid.\n\nFor example, let's parametrize a hyperboloid of one sheet defined in Cartesian coordinates as \n\n$$\nx^2+y^2-z^2=9.\n$$\n\n \n\nWe start by transforming to cylindrical polar coordinates in the usual way:\n\n$$\nx = r\\cos\\theta, \\qquad\ny = r\\sin\\theta, \\qquad \nz = z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =9 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{z}^{2} & =9 \\\\ {r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )-{z}^{2} & =9 \\\\ {r}^{2}-{z}^{2} & =9.\\end{aligned}\n$$\n\nHere, the hyperbola $r^2 - z^2 = 9$ represents the intersection of our hyperboloid with the vertical plane that passes through the $z$-axis and makes the angle of $\\theta$ with the positive $x$-axis. \n\n![](images/80/807e7c016733140d391ff69e0aa9695fe0927f4575607edc9b084eae5b7426a4.png)\n\n   \n\nUsing hyperbolic functions, we can parametrize this hyperbola as follows:\n\n$$\n\\langle r, z \\rangle = \\langle 3\\cosh{\\phi}, \\: 3\\sinh{\\phi} \\rangle,\n\\qquad \\phi \\in \\mathbb R\n$$\n\nTherefore, for any point $(x,y,z)$ on our surface, we obtain the following parametrization of our hyperbola:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩ \\\\  & =⟨(3\\operatorname{cosh}⁡ϕ)\\operatorname{cos}⁡\\theta ,\\,(3\\operatorname{cosh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{sinh}⁡ϕ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta ,\\,3\\operatorname{cosh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,3\\operatorname{sinh}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi)$ and $\\phi \\in \\mathbb R.$"] [:db/cas 17592186179436 :question/worked-solution "Recall that for any affine transformation \n\n$$\n\\mathbf{T}: \\mathbf{u} \\longrightarrow A \\mathbf{u} + \\mathbf{b},\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $\\mathbf u$ and $\\mathbf b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $\\mathbf{T}$ is non-singular, i.e., when $\\det(A) \\neq 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $\\mathbf{T}$ is singular, i.e., when $\\det(A) = 0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $\\mathbf{T}$ is \n$$\nA = \n{\\left[ \\begin{array}{cc}2 & 1 \\\\ 4 & 2\\end{array} \\right]}.\n$$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}2 & 1 \\\\ 4 & 2\\end{vmatrix} \\\\  & =2\\cdot 2-4\\cdot 1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $\\mathbf{T}$ is non-invertible and the image of the triangle under the action of $\\mathbf{T}$ is a line segment." "Recall that for any affine transformation \n\n$$\n\\mathbf{T}: \\mathbf{u} \\longrightarrow A \\mathbf{u} + \\mathbf{b},\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $\\mathbf u$ and $\\mathbf b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $\\mathbf{T}$ is non-singular, i.e., when $\\det(A) \\neq 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $\\mathbf{T}$ is singular, i.e., when $\\det(A) = 0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $\\mathbf{T}$ is \n$$\nA = \n{\\left[ \\begin{array}{cc}2 & 1 \\\\ 4 & 2\\end{array} \\right]}.\n$$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}\\det (T) & =\\begin{vmatrix}2 & 1 \\\\ 4 & 2\\end{vmatrix} \\\\  & =2\\cdot 2-4\\cdot 1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $\\mathbf{T}$ is non-invertible and the image of the triangle under the action of $\\mathbf{T}$ is a line segment."] [:db/cas 17592186179505 :question/worked-solution "First, we take $\\log_2$ on both sides of the equation: \n\n$$\n\\begin{aligned}{2}^{x+1} & ={3}^{x} \\\\ {log}_{2}⁡({2}^{x+1}) & ={log}_{2}⁡({3}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b \\left( b^c \\right) = c$ to simplify the left-hand side. This gives:\n\n$$\nx+1 = \\log_2 \\left(3^{x}\\right)\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx+1 = x \\log_2 \\left(3\\right)\n$$\n\nFinally, we solve for $x,$ as follows: \n\n$$\n\\begin{aligned}x+1 & =x{log}_{2}⁡(3) \\\\ x{log}_{2}⁡(3)-x & =1 \\\\ x({log}_{2}⁡(3)-1) & =1 \\\\ x & =\\frac{1}{{log}_{2}⁡(3)-1}\\end{aligned}\n$$" "First, we take $\\log_2$ on both sides of the equation: \n\n$$\n\\begin{aligned}{2}^{x+1} & ={3}^{x} \\\\ {\\log }_{2}⁡({2}^{x+1}) & ={\\log }_{2}⁡({3}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b \\left( b^c \\right) = c$ to simplify the left-hand side. This gives:\n\n$$\nx+1 = \\log_2 \\left(3^{x}\\right)\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx+1 = x \\log_2 \\left(3\\right)\n$$\n\nFinally, we solve for $x,$ as follows: \n\n$$\n\\begin{aligned}x+1 & =x{\\log }_{2}⁡(3) \\\\ x{\\log }_{2}⁡(3)-x & =1 \\\\ x({\\log }_{2}⁡(3)-1) & =1 \\\\ x & =\\frac{1}{{\\log }_{2}⁡(3)-1}\\end{aligned}\n$$"] [:db/cas 17592186179526 :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a quarter-circle of radius $2$ centered at $O,$ shown below. \n\n![](images/d0/d0ae53dd5d0932cbf834a166e851c227f75cb546b591a9fd43930ec06f0e9ddf.png)\n\nThe curve $C$ can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad \\dfrac{\\pi}{2} \\le t \\le \\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = 2x+y^2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)+(2\\operatorname{sin}⁡t)^{2} \\\\  & =4(\\operatorname{cos}⁡t+{sin}^{2}⁡t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(2x+{y}^{2})\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }4(\\operatorname{cos}⁡t+{sin}^{2}⁡t)\\cdot 2\\cdot \\text{d}t \\\\  & =8{\\int }_{\\pi /2}^{\\pi }(\\operatorname{cos}⁡t+{sin}^{2}⁡t)\\,\\text{d}t.\\end{aligned}\n$$" "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a quarter-circle of radius $2$ centered at $O,$ shown below. \n\n![](images/d0/d0ae53dd5d0932cbf834a166e851c227f75cb546b591a9fd43930ec06f0e9ddf.png)\n\nThe curve $C$ can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad \\dfrac{\\pi}{2} \\le t \\le \\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = 2x+y^2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)+(2\\operatorname{sin}⁡t)^{2} \\\\  & =4(\\operatorname{cos}⁡t+{\\sin }^{2}⁡t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(2x+{y}^{2})\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }4(\\operatorname{cos}⁡t+{\\sin }^{2}⁡t)\\cdot 2\\cdot \\text{d}t \\\\  & =8{\\int }_{\\pi /2}^{\\pi }(\\operatorname{cos}⁡t+{\\sin }^{2}⁡t)\\,\\text{d}t.\\end{aligned}\n$$"] [:db/cas 17592186179529 :question/worked-solution "First, notice that a parametrization for the given path is\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{1em}t\\in [0,\\frac{\\pi }{2}].\\end{aligned}\n$$\n\nThe derivative of $\\mathbf r(t)$  is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & ={x}^{'}(t)\\hspace{0.167em}\\mathbf{i}+{y}^{'}(t)\\hspace{0.167em}\\mathbf{j}=-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore, we can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y\\,dx-x\\,dy}{{x}^{2}+{y}^{2}} & ={\\int }_{0}^{\\pi /2}\\frac{y\\cdot {x}^{′}-x\\cdot {y}^{′}}{{x}^{2}+{y}^{2}}\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{(2\\operatorname{sin}⁡t)(-2\\operatorname{sin}⁡t)-(2\\operatorname{cos}⁡t)(2\\operatorname{cos}⁡t)}{(2\\operatorname{cos}⁡t)^{2}+(2\\operatorname{sin}⁡t)^{2}},dt \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{-4{sin}^{2}⁡t-4{cos}^{2}⁡t}{4({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{-4({sin}^{2}⁡t+{cos}^{2}⁡t)}{4({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,dt \\\\  & =-{\\int }_{0}^{\\pi /2}\\,dt \\\\  & =-\\frac{\\pi }{2}\\end{aligned}\n$$" "First, notice that a parametrization for the given path is\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{1em}t\\in [0,\\frac{\\pi }{2}].\\end{aligned}\n$$\n\nThe derivative of $\\mathbf r(t)$  is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & ={x}^{'}(t)\\hspace{0.167em}\\mathbf{i}+{y}^{'}(t)\\hspace{0.167em}\\mathbf{j}=-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore, we can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y\\,dx-x\\,dy}{{x}^{2}+{y}^{2}} & ={\\int }_{0}^{\\pi /2}\\frac{y\\cdot {x}^{′}-x\\cdot {y}^{′}}{{x}^{2}+{y}^{2}}\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{(2\\operatorname{sin}⁡t)(-2\\operatorname{sin}⁡t)-(2\\operatorname{cos}⁡t)(2\\operatorname{cos}⁡t)}{(2\\operatorname{cos}⁡t)^{2}+(2\\operatorname{sin}⁡t)^{2}},dt \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{-4{\\sin }^{2}⁡t-4{\\cos }^{2}⁡t}{4({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)}\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{-4({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)}{4({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)}\\,dt \\\\  & =-{\\int }_{0}^{\\pi /2}\\,dt \\\\  & =-\\frac{\\pi }{2}\\end{aligned}\n$$"] [:db/cas 17592186179572 :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $1$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle \\cos{t}, \\: \\sin{t} \\big\\rangle, \\qquad 0 \\le t \\lt 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-1,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(\\operatorname{cos}⁡t)^{2}-1 \\\\  & ={cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({cos}^{2}⁡t-1)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡t-1\\,\\text{d}t.\\end{aligned}\n$$" "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $1$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle \\cos{t}, \\: \\sin{t} \\big\\rangle, \\qquad 0 \\le t \\lt 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{\\sin }^{2}⁡t+{\\cos }^{2}⁡t} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-1,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(\\operatorname{cos}⁡t)^{2}-1 \\\\  & ={\\cos }^{2}⁡t-1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({\\cos }^{2}⁡t-1)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{\\cos }^{2}⁡t-1\\,\\text{d}t.\\end{aligned}\n$$"] [:db/cas 17592186179573 :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\nx^2 + \\dfrac{y^2}{2^2}  = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle \\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad \\dfrac{\\pi}{2} \\le t \\le \\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{3{cos}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{1+3{cos}^{2}⁡t}\\end{aligned}\n$$\n\nNow, since $f(x,y) = 12xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =12\\cdot \\operatorname{cos}⁡t\\cdot 2\\operatorname{sin}⁡t=24\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}12xy\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }24\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\sqrt{1+3{cos}^{2}⁡t}\\cdot \\text{d}t \\\\  & =24{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{cos}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+3\\cos^2 {t},$ $\\textrm d u=-6\\sin t\\cos \n t\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}24{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{cos}^{2}⁡t}\\,\\text{d}t & =-4{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =-4\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =-\\frac{8}{3}({4}^{3/2}-{1}^{3/2}) \\\\  & =-\\frac{8}{3}(8-1) \\\\  & =-\\frac{56}{3}\\end{aligned}\n$$" "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\nx^2 + \\dfrac{y^2}{2^2}  = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle \\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad \\dfrac{\\pi}{2} \\le t \\le \\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{\\sin }^{2}⁡t+4{\\cos }^{2}⁡t} \\\\  & =\\sqrt{3{\\cos }^{2}⁡t+({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =\\sqrt{1+3{\\cos }^{2}⁡t}\\end{aligned}\n$$\n\nNow, since $f(x,y) = 12xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =12\\cdot \\operatorname{cos}⁡t\\cdot 2\\operatorname{sin}⁡t=24\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}12xy\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }24\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\sqrt{1+3{\\cos }^{2}⁡t}\\cdot \\text{d}t \\\\  & =24{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{\\cos }^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+3\\cos^2 {t},$ $\\textrm d u=-6\\sin t\\cos \n t\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}24{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{\\cos }^{2}⁡t}\\,\\text{d}t & =-4{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =-4\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =-\\frac{8}{3}({4}^{3/2}-{1}^{3/2}) \\\\  & =-\\frac{8}{3}(8-1) \\\\  & =-\\frac{56}{3}\\end{aligned}\n$$"] [:db/cas 17592186179578 :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{4^2} + \\dfrac{y^2}{1^2} = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\left\\langle 4\\cos{t}, \\: \\sin{t} \\right\\rangle, \\qquad 0 \\le t \\lt 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{15{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{15{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y) = \\dfrac{x}{y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}=4\\operatorname{cot}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{y}\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cot}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$" "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{4^2} + \\dfrac{y^2}{1^2} = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\left\\langle 4\\cos{t}, \\: \\sin{t} \\right\\rangle, \\qquad 0 \\le t \\lt 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{\\sin }^{2}⁡t+{\\cos }^{2}⁡t} \\\\  & =\\sqrt{15{\\sin }^{2}⁡t+({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =\\sqrt{15{\\sin }^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y) = \\dfrac{x}{y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}=4\\operatorname{cot}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{y}\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cot}⁡t\\sqrt{15{\\sin }^{2}⁡t+1}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{15{\\sin }^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$"] [:db/cas 17592186179579 :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad 0 \\le t \\le 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(2\\operatorname{cos}⁡t)^{2}-2 \\\\  & =4{cos}^{2}⁡t-2 \\\\  & =2(2{cos}^{2}⁡t-1) \\\\  & =2\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }2\\operatorname{cos}⁡2t\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\textrm d u=2\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t & =2{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =2\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =2(0-0) \\\\  & =0\\end{aligned}\n$$" "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad 0 \\le t \\le 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{\\sin }^{2}⁡t+4{\\cos }^{2}⁡t} \\\\  & =\\sqrt{4({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(2\\operatorname{cos}⁡t)^{2}-2 \\\\  & =4{\\cos }^{2}⁡t-2 \\\\  & =2(2{\\cos }^{2}⁡t-1) \\\\  & =2\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }2\\operatorname{cos}⁡2t\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\textrm d u=2\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t & =2{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =2\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =2(0-0) \\\\  & =0\\end{aligned}\n$$"] [:db/cas 17592186179588 :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{2^2} + \\dfrac{y^2}{3^2} = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $3,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\left\\langle 2\\cos{t}, \\: 3\\sin{t} \\right\\rangle, \\qquad -\\dfrac{\\pi}{2} \\le t \\le \\dfrac{\\pi}{2}.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(3\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+9{cos}^{2}⁡t} \\\\  & =\\sqrt{5{cos}^{2}⁡t+4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{5{cos}^{2}⁡t+4}\\end{aligned}\n$$\n\nNow, since $f(x,y) = 2xy,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)(3\\operatorname{sin}⁡t) \\\\  & =12\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}2xy\\,\\text{d}s & ={\\int }_{-\\pi /2}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}12\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{5{cos}^{2}⁡t+4}\\,\\text{d}t \\\\  & =12{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{5{cos}^{2}⁡t+4}\\,\\text{d}t.\\end{aligned}\n$$" "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{2^2} + \\dfrac{y^2}{3^2} = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $3,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\left\\langle 2\\cos{t}, \\: 3\\sin{t} \\right\\rangle, \\qquad -\\dfrac{\\pi}{2} \\le t \\le \\dfrac{\\pi}{2}.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(3\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{\\sin }^{2}⁡t+9{\\cos }^{2}⁡t} \\\\  & =\\sqrt{5{\\cos }^{2}⁡t+4({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =\\sqrt{5{\\cos }^{2}⁡t+4}\\end{aligned}\n$$\n\nNow, since $f(x,y) = 2xy,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)(3\\operatorname{sin}⁡t) \\\\  & =12\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}2xy\\,\\text{d}s & ={\\int }_{-\\pi /2}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}12\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{5{\\cos }^{2}⁡t+4}\\,\\text{d}t \\\\  & =12{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{5{\\cos }^{2}⁡t+4}\\,\\text{d}t.\\end{aligned}\n$$"] [:db/cas 17592186179591 :question/worked-solution "Along the curve, we have\n\n$$\nx(t) =2t, \\qquad \ny(t) = \\cos t , \\qquad \nz(t) = \\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =2\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz & ={\\int }_{0}^{\\pi }{x}^{3}\\frac{\\text{d}x}{\\text{d}t}\\,dt+z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }({x}^{3}\\frac{\\text{d}x}{\\text{d}t}+z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }(2t)^{3}\\cdot (2)+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}-{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+({cos}^{2}⁡t-{sin}^{2}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+\\operatorname{cos}⁡2t\\,dt\\end{aligned}\n$$" "Along the curve, we have\n\n$$\nx(t) =2t, \\qquad \ny(t) = \\cos t , \\qquad \nz(t) = \\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =2\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz & ={\\int }_{0}^{\\pi }{x}^{3}\\frac{\\text{d}x}{\\text{d}t}\\,dt+z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }({x}^{3}\\frac{\\text{d}x}{\\text{d}t}+z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }(2t)^{3}\\cdot (2)+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}-{\\sin }^{2}⁡t+{\\cos }^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+({\\cos }^{2}⁡t-{\\sin }^{2}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+\\operatorname{cos}⁡2t\\,dt\\end{aligned}\n$$"] [:db/cas 17592186179596 :question/worked-solution "Along the curve, we have\n\n$$\nx(t) = \\cos t, \\qquad\ny(t) = 3\\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{\\pi }y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt-x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(y\\cdot \\frac{\\text{d}x}{\\text{d}t}-x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi }3\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)-(\\operatorname{cos}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }-3{sin}^{2}⁡t-3{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }\\,dt \\\\  & =-3{t|}_{0}^{\\pi } \\\\  & =-3\\pi \\end{aligned}\n$$" "Along the curve, we have\n\n$$\nx(t) = \\cos t, \\qquad\ny(t) = 3\\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{\\pi }y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt-x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(y\\cdot \\frac{\\text{d}x}{\\text{d}t}-x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi }3\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)-(\\operatorname{cos}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }-3{\\sin }^{2}⁡t-3{\\cos }^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }{\\sin }^{2}⁡t+{\\cos }^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }\\,dt \\\\  & =-3{t|}_{0}^{\\pi } \\\\  & =-3\\pi \\end{aligned}\n$$"] [:db/cas 17592186179597 :question/worked-solution "The notation $\\displaystyle\\oint$ is used to remind us that we're dealing with a line integral over a *closed* curve.\n\nWe will use the formula\n\n$$\n\\oint\\limits_C \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = \\int_a^b \\mathbf{F}(\\mathbf{r}(t)) \\cdot \\mathbf{r}'(t) \\,\\textrm{d}t.\n$$\n\nFirst, we need to parameterize a circle of radius $1$ centered at the origin. It can be parameterized as \n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} + \\sin{t}\\,\\mathbf{j},\n\\qquad 0 \\leq t \\lt 2\\pi.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx = \\cos{t}, \\qquad\ny = \\sin{t}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,j=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nComputing $\\mathbf{r}'(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j)\\cdot (-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j) \\\\  & =-{sin}^{2}⁡t+{cos}^{2}⁡t \\\\  & =-(1-{cos}^{2}⁡t)+{cos}^{2}⁡t \\\\  & =2{cos}^{2}⁡t-1 \\\\  & =\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,dt \\\\  & ={[\\frac{1}{2}\\operatorname{sin}⁡2t]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡4\\pi -\\frac{1}{2}\\operatorname{sin}⁡(0) \\\\  & =0.\\end{aligned}\n$$" "The notation $\\displaystyle\\oint$ is used to remind us that we're dealing with a line integral over a *closed* curve.\n\nWe will use the formula\n\n$$\n\\oint\\limits_C \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = \\int_a^b \\mathbf{F}(\\mathbf{r}(t)) \\cdot \\mathbf{r}'(t) \\,\\textrm{d}t.\n$$\n\nFirst, we need to parameterize a circle of radius $1$ centered at the origin. It can be parameterized as \n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} + \\sin{t}\\,\\mathbf{j},\n\\qquad 0 \\leq t \\lt 2\\pi.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx = \\cos{t}, \\qquad\ny = \\sin{t}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,j=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nComputing $\\mathbf{r}'(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j)\\cdot (-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j) \\\\  & =-{\\sin }^{2}⁡t+{\\cos }^{2}⁡t \\\\  & =-(1-{\\cos }^{2}⁡t)+{\\cos }^{2}⁡t \\\\  & =2{\\cos }^{2}⁡t-1 \\\\  & =\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,dt \\\\  & ={[\\frac{1}{2}\\operatorname{sin}⁡2t]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡4\\pi -\\frac{1}{2}\\operatorname{sin}⁡(0) \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186179606 :question/worked-solution "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx = 4\\cos t, \\qquad\n\ty = 4\\sin t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y-x=4(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t), \\\\ Q(x,y) & =-(x+y)=-4(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t).\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t))\\cdot (4\\operatorname{cos}⁡t)-(-4(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t))\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{cos}^{2}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{sin}^{2}⁡t\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }(-1)\\,\\text{d}t \\\\  & =-16t{|}_{0}^{2\\pi } \\\\  & =-16(2\\pi -0) \\\\  & =-32\\pi \\end{aligned}\n$$" "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx = 4\\cos t, \\qquad\n\ty = 4\\sin t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y-x=4(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t), \\\\ Q(x,y) & =-(x+y)=-4(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t).\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t))\\cdot (4\\operatorname{cos}⁡t)-(-4(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t))\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{\\cos }^{2}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{\\sin }^{2}⁡t\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }(-1)\\,\\text{d}t \\\\  & =-16t{|}_{0}^{2\\pi } \\\\  & =-16(2\\pi -0) \\\\  & =-32\\pi \\end{aligned}\n$$"] [:db/cas 17592186179607 :question/worked-solution "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\dfrac{x^2}{1^2}+\\dfrac{y^2}{3^2} = 1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $1$ and $3,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} +3\\sin{t}\\,\\mathbf{j},\n\\qquad 0 \\leq t \\leq 2\\pi.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx = \\cos t, \\qquad\ny = 3\\sin t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =xy=3\\operatorname{sin}⁡t\\operatorname{cos}⁡t, \\\\ Q(x,y) & ={x}^{2}={cos}^{2}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\cos t, \\textrm d u = -\\sin t\\,\\textrm d t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\cdot (3\\operatorname{cos}⁡t)-({cos}^{2}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }9\\operatorname{sin}⁡t{cos}^{2}⁡t+\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }10\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & =-{\\int }_{1}^{1}10{u}^{2}\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\dfrac{x^2}{1^2}+\\dfrac{y^2}{3^2} = 1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $1$ and $3,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} +3\\sin{t}\\,\\mathbf{j},\n\\qquad 0 \\leq t \\leq 2\\pi.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx = \\cos t, \\qquad\ny = 3\\sin t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =xy=3\\operatorname{sin}⁡t\\operatorname{cos}⁡t, \\\\ Q(x,y) & ={x}^{2}={\\cos }^{2}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\cos t, \\textrm d u = -\\sin t\\,\\textrm d t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\cdot (3\\operatorname{cos}⁡t)-({\\cos }^{2}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }9\\operatorname{sin}⁡t{\\cos }^{2}⁡t+\\operatorname{sin}⁡t{\\cos }^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }10\\operatorname{sin}⁡t{\\cos }^{2}⁡t\\,\\text{d}t \\\\  & =-{\\int }_{1}^{1}10{u}^{2}\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$"] [:db/cas 17592186179609 :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\n\\lim_{θ \\to  0}\\frac{\\tan 2θ}{θ} &= \\lim_{θ \\to  0}(\\left(\\frac{\\sin 2θ}{\\cos 2θ}\\right))/(θ) \\\\\n&= \\lim_{θ \\to  0}(\\frac{\\sin 2θ}{θ} \\cdot \\frac{1}{\\cos 2θ}) \\\\\n&= \\lim_{θ \\to  0}\\frac{\\sin 2θ}{θ} \\cdot lim_(θ → 0)\\frac{1}{\\cos 2θ}\n\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0$, both numerator and denominator approach $0$. So, if we attempt to evaluate the limit directly, we get\n$$\n\\displaystyle \\lim_{\\theta \\to 0}\\: \\dfrac{\\sin 2\\theta}{\\theta} = \\dfrac{0}{0},\n$$\nwhich is an indeterminate form. Instead, let's recall the following special limit:\n$$\n\\displaystyle \\lim_{x \\to 0}\\: \\dfrac{\\sin x}{x} =1\n$$We rewrite the given limit using the algebra of limits, as follows:\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\hspace{0.222em}\\frac{\\operatorname{sin}2\\theta }{\\theta } & =\\lim_{\\theta \\to 0}(2\\cdot \\frac{\\operatorname{sin}2\\theta }{2\\theta }) \\\\  & =2\\cdot \\lim_{\\theta \\to 0}\\hspace{0.222em}\\frac{sin{\\color{blue}{2\\theta }}}{{\\color{blue}{2\\theta }}}\\end{aligned}\n$$Let $x = 2\\theta$. Then, since $x\\to0$ as $\\theta \\to 0$, we have\n$$\n\\displaystyle 2 \\cdot \\lim_{\\theta \\to 0}\\: \\dfrac{\\sin \\color{blue}2\\theta}{\\color{blue}2\\theta} = 2 \\cdot \\lim_{x \\to 0}\\: \\dfrac{\\sin \\color{blue}x}{\\color{blue}x} = 2 \\cdot 1 =2.\n$$\n- Consider the second limit. Evaluating it directly, we get\n$$\n\\displaystyle \\lim_{\\theta \\to 0} \\: \\dfrac{1}{\\cos 2\\theta} = \\dfrac{1}{\\cos 0} = \\dfrac11 = 1.\n$$\n\nTherefore, we have\n\n$$\n\\lim_{θ \\to  0}\\frac{\\sin 2θ}{θ} \\cdot lim_(θ → 0)\\frac{1}{\\cos 2θ} = 2 \\cdot 1 = 2\n$$" "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\n\\lim_{θ \\to  0}\\frac{\\tan 2θ}{θ} &= \\lim_{θ \\to  0}(\\left(\\frac{\\sin 2θ}{\\cos 2θ}\\right))/(θ) \\\\\n&= \\lim_{θ \\to  0}(\\frac{\\sin 2θ}{θ} \\cdot \\frac{1}{\\cos 2θ}) \\\\\n&= \\lim_{θ \\to  0}\\frac{\\sin 2θ}{θ} \\cdot lim_(θ → 0)\\frac{1}{\\cos 2θ}\n\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0$, both numerator and denominator approach $0$. So, if we attempt to evaluate the limit directly, we get\n$$\n\\displaystyle \\lim_{\\theta \\to 0}\\: \\dfrac{\\sin 2\\theta}{\\theta} = \\dfrac{0}{0},\n$$\nwhich is an indeterminate form. Instead, let's recall the following special limit:\n$$\n\\displaystyle \\lim_{x \\to 0}\\: \\dfrac{\\sin x}{x} =1\n$$We rewrite the given limit using the algebra of limits, as follows:\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\hspace{0.222em}\\frac{\\operatorname{sin}2\\theta }{\\theta } & =\\lim_{\\theta \\to 0}(2\\cdot \\frac{\\operatorname{sin}2\\theta }{2\\theta }) \\\\  & =2\\cdot \\lim_{\\theta \\to 0}\\hspace{0.222em}\\frac{\\sin {\\color{blue}{2\\theta }}}{{\\color{blue}{2\\theta }}}\\end{aligned}\n$$Let $x = 2\\theta$. Then, since $x\\to0$ as $\\theta \\to 0$, we have\n$$\n\\displaystyle 2 \\cdot \\lim_{\\theta \\to 0}\\: \\dfrac{\\sin \\color{blue}2\\theta}{\\color{blue}2\\theta} = 2 \\cdot \\lim_{x \\to 0}\\: \\dfrac{\\sin \\color{blue}x}{\\color{blue}x} = 2 \\cdot 1 =2.\n$$\n- Consider the second limit. Evaluating it directly, we get\n$$\n\\displaystyle \\lim_{\\theta \\to 0} \\: \\dfrac{1}{\\cos 2\\theta} = \\dfrac{1}{\\cos 0} = \\dfrac11 = 1.\n$$\n\nTherefore, we have\n\n$$\n\\lim_{θ \\to  0}\\frac{\\sin 2θ}{θ} \\cdot lim_(θ → 0)\\frac{1}{\\cos 2θ} = 2 \\cdot 1 = 2\n$$"] [:db/cas 17592186179957 :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $4$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,0\\le t\\le 2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+16{cos}^{2}⁡t} \\\\  & =\\sqrt{16({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}-{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(4\\operatorname{cos}⁡t)^{2}-(4\\operatorname{sin}⁡t)^{2} \\\\  & =16{cos}^{2}⁡t-16{sin}^{2}⁡t \\\\  & =16({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\  & =16\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}⁡(2t)\\cdot 4\\cdot \\text{d}t \\\\  & =64{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\text{d}u=2\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}64{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t & =32{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =32\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =32(0-0) \\\\  & =0\\end{aligned}\n$$" "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $4$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,0\\le t\\le 2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{\\sin }^{2}⁡t+16{\\cos }^{2}⁡t} \\\\  & =\\sqrt{16({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}-{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(4\\operatorname{cos}⁡t)^{2}-(4\\operatorname{sin}⁡t)^{2} \\\\  & =16{\\cos }^{2}⁡t-16{\\sin }^{2}⁡t \\\\  & =16({\\cos }^{2}⁡t-{\\sin }^{2}⁡t) \\\\  & =16\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}⁡(2t)\\cdot 4\\cdot \\text{d}t \\\\  & =64{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\text{d}u=2\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}64{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t & =32{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =32\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =32(0-0) \\\\  & =0\\end{aligned}\n$$"] [:db/cas 17592186179959 :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2\\operatorname{cos}⁡t+(2\\operatorname{sin}⁡t)^{2} \\\\  & =2\\operatorname{cos}⁡t+4{sin}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(2\\operatorname{cos}⁡t+4{sin}^{2}⁡t)\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }(\\operatorname{cos}⁡t+2{sin}^{2}⁡t)\\,\\text{d}t.\\end{aligned}\n$$" "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{\\sin }^{2}⁡t+4{\\cos }^{2}⁡t} \\\\  & =\\sqrt{4({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2\\operatorname{cos}⁡t+(2\\operatorname{sin}⁡t)^{2} \\\\  & =2\\operatorname{cos}⁡t+4{\\sin }^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(2\\operatorname{cos}⁡t+4{\\sin }^{2}⁡t)\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }(\\operatorname{cos}⁡t+2{\\sin }^{2}⁡t)\\,\\text{d}t.\\end{aligned}\n$$"] [:db/cas 17592186179962 :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+{y}^{2}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{15{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{15{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{4y}{x},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4y}{x} \\\\  & =4\\cdot \\frac{\\operatorname{sin}⁡t}{(4\\operatorname{cos}⁡t)} \\\\  & =\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{4y}{x}\\,\\text{d}s & ={\\int }_{\\pi /2}^{3\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{tan}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$" "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+{y}^{2}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{\\sin }^{2}⁡t+{\\cos }^{2}⁡t} \\\\  & =\\sqrt{15{\\sin }^{2}⁡t+({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)} \\\\  & =\\sqrt{15{\\sin }^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{4y}{x},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4y}{x} \\\\  & =4\\cdot \\frac{\\operatorname{sin}⁡t}{(4\\operatorname{cos}⁡t)} \\\\  & =\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{4y}{x}\\,\\text{d}s & ={\\int }_{\\pi /2}^{3\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{tan}⁡t\\sqrt{15{\\sin }^{2}⁡t+1}\\,\\text{d}t.\\end{aligne