\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int \\dfrac{\\ln{\\pi}}{\\sqrt{x^2-1}}\\,\\textrm d x=\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int \\dfrac{\\ln{\\pi}}{\\sqrt{x^2-1}}\\,\\textrm d x=\n$$"] [:db/cas 17592186166597 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcosh x) = \\dfrac{1}{\\sqrt{x^2-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡\\pi }{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\operatorname{arcosh}  x) = \\dfrac{1}{\\sqrt{x^2-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡\\pi }{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$"] [:db/cas 17592186166598 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $$\n\\displaystyle \\int \\dfrac{1}{2(1-x^2)}\\,\\textrm d x\n$$ for $|x|< 1.$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $$\n\\displaystyle \\int \\dfrac{1}{2(1-x^2)}\\,\\textrm d x\n$$ for $|x|< 1.$"] [:db/cas 17592186166598 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\artanh x) = \\dfrac{1}{1-x^2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1}{2(1-{x}^{2})}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=\\frac{1}{2}\\,\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimi