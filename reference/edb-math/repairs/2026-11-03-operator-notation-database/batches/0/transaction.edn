ll-align=\"center\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$\\color{red}3$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$\\color{red}0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n</tbody></table></div></td>\n<td data-cell-align=\"center\" data-cell-valign=\"top\"><div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\">\n<tbody><tr>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$\\color{red}3$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$\\color{red}0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n</tbody></table></div></td>\n<td data-cell-align=\"center\" data-cell-valign=\"top\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\"></td>\n</tr>\n</tbody></table></div>\n\n\n**Step 3**: Pick a multiple of $3$ that is easy to compute but is no larger than $30$. Let's pick\n\n$$\n3 \\times {\\color{blue}10} = 30\n$$\n\nWe write $\\color{blue}10$ above the box and subtract $3 \\times {\\color{blue}10}$ from $\\color{red}30$ inside the box.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-fill=\"#EBF5FB\" data-border-top=\"none\" data-border-left=\"none\">$200$</td>\n<td data-cell-align=\"center\" data-fill=\"#EBF5FB\" data-border-top=\"none\" data-border-right=\"none\" data-border-left=\"none\">$\\color{blue}10$</td>\n</tr>\n<tr>\n<td data-cell-align=\"right\" data-cell-valign=\"top\" data-border-top=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"><div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\">\n<tbody><tr>\n<td data-fill=\"#EBF5FB\">$3$</td>\n</tr>\n</tbody></table></div></td>\n<td data-cell-align=\"center\" data-cell-valign=\"top\"><div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$6$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$3$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-border-bottom=\"none\" data-border-left=\"none\">$-\\!$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$6$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$0$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$\\color{red}3$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$\\color{red}0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n</tbody></table></div></td>\n<td data-cell-align=\"center\" data-cell-valign=\"top\"><div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$\\color{red}3$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\">$\\color{red}0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-border-bottom=\"none\" data-border-left=\"none\">$-\\!$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$3$</td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$0$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-left=\"none\"></td>\n<td data-cell-align=\"center\" data-border-left=\"none\">$\\fbox{0}$</td>\n<td data-cell-align=\"center\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"></td>\n</tr>\n</tbody></table></div></td>\n<td data-cell-align=\"center\" data-cell-valign=\"top\" data-border-top=\"none\" data-border-right=\"none\" data-border-bottom=\"none\"></td>\n</tr>\n</tbody></table></div>\n\n\nWe get $\\fbox{0}$, so the division is done.\n\n**Step 4**: To find the quotient of $630 \\operatorname{div}  3$, we add the numbers on top of the boxes:\n\n$$\n200+10=210\n$$\n\nTherefore,\n\n$$\n630 \\operatorname{div}  3 = 210\n$$\n\nLet's now look at an example with a remainder."] [:db/cas 17592186144017 :tutorial/content "It's important to interpret quotients and remainders when they arise in real-life problems.\n\nConsider the following situation:\n\n> *There are $38$ students in a class. The teacher divided this class into groups of $5$. As a result, there were several fully-filled groups and one incomplete group.*\n\nLet's answer the following questions:\n\n1. How many fully-filled groups were there?\n2. How many students were in the incomplete group?\n3. How many groups were there in total?\n\nSince the class was divided into groups of $5$, let's start by dividing $38$ by $5$:\n\n$$\n38 \\div 5 = {\\color{blue}7} \\,\\text{R}\\, {\\color{red}3}\n$$\n\nLet's now answer our questions by interpreting this result:\n\n- The quotient of our division is ${\\color{blue}{7}}$. This means that there were $\\color{blue}7$ fully-filled groups.\n- The remainder of our division is ${\\color{red}{3}}$. This means that there were ${\\color{red}{3}}$ students in the incomplete group.\n- Since we have $\\color{blue}7$ fully-filled groups and $1$ incomplete group, there were ${\\color{blue}7} + 1 = 8$ groups in total.\n\nLet's see some more examples." "It's important to interpret quotients and remainders when they arise in real-life problems.\n\nConsider the following situation:\n\n> *There are $38$ students in a class. The teacher divided this class into groups of $5$. As a result, there were several fully-filled groups and one incomplete group.*\n\nLet's answer the following questions:\n\n1. How many fully-filled groups were there?\n2. How many students were in the incomplete group?\n3. How many groups were there in total?\n\nSince the class was divided into groups of $5$, let's start by dividing $38$ by $5$:\n\n$$\n38 \\operatorname{div}  5 = {\\color{blue}7} \\,\\text{R}\\, {\\color{red}3}\n$$\n\nLet's now answer our questions by interpreting this result:\n\n- The quotient of our division is ${\\color{blue}{7}}$. This means that there were $\\color{blue}7$ fully-filled groups.\n- The remainder of our division is ${\\color{red}{3}}$. This means that there were ${\\color{red}{3}}$ students in the incomplete group.\n- Since we have $\\color{blue}7$ fully-filled groups and $1$ incomplete group, there were ${\\color{blue}7} + 1 = 8$ groups in total.\n\nLet's see some more examples."] [:db/cas 17592186144022 :tutorial/content "It's important to interpret quotients and remainders when they arise in real-life problems.\n\nConsider the following situation:\n\n> *Clare must pack $64$ candy bars into boxes. Each box can contain $5$ candy bars. She wishes to create as many fully-filled boxes as possible.*\n\nLet's answer the following questions:\n\n1. How many fully-filled boxes will there be?\n2. How many candy bars will there be in the partially-filled box?\n3. How many boxes will there be in total?\n\nSince the $64$ candy bars are distributed into boxes containing $5$ bars each, we start by dividing $64$ by $5$ using the long division method:\n\n| $1$$2$$5$$\\!\\!\\enclose{longdiv}{6 {\\:\\phantom{\\mid}} 4}$$-\\!\\!\\!\\!$$5$$1$$4$$-\\!\\!\\!\\!$$1$$0$${4}$ |\n| --- |\n\nThe result of the long division is\n\n$$\n64 \\div 5 = {\\color{blue}{12}}\\,\\text{R}\\,{\\color{red}{4}}\n$$\n\nLet's now answer our questions by interpreting this result:\n\n- The quotient of the division is ${\\color{blue}{12}}$. This means that there will be ${\\color{blue}{12}}$ fully-filled boxes.\n- The remainder of the division is ${\\color{red}{4}}$. This means that there will be ${\\color{red}{4}}$ candy bars in the partially-filled box.\n- Since we have ${\\color{blue}{12}}$ fully-filled boxes and one partially-filled box, there will be ${\\color{blue}{12}}+1 = 13$ boxes in total.\n\nLet's see some more examples." "It's important to interpret quotients and remainders when they arise in real-life problems.\n\nConsider the following situation:\n\n> *Clare must pack $64$ candy bars into boxes. Each box can contain $5$ candy bars. She wishes to create as many fully-filled boxes as possible.*\n\nLet's answer the following questions:\n\n1. How many fully-filled boxes will there be?\n2. How many candy bars will there be in the partially-filled box?\n3. How many boxes will there be in total?\n\nSince the $64$ candy bars are distributed into boxes containing $5$ bars each, we start by dividing $64$ by $5$ using the long division method:\n\n| $1$$2$$5$$\\!\\!\\enclose{longdiv}{6 {\\:\\phantom{\\mid}} 4}$$-\\!\\!\\!\\!$$5$$1$$4$$-\\!\\!\\!\\!$$1$$0$${4}$ |\n| --- |\n\nThe result of the long division is\n\n$$\n64 \\operatorname{div}  5 = {\\color{blue}{12}}\\,\\text{R}\\,{\\color{red}{4}}\n$$\n\nLet's now answer our questions by interpreting this result:\n\n- The quotient of the division is ${\\color{blue}{12}}$. This means that there will be ${\\color{blue}{12}}$ fully-filled boxes.\n- The remainder of the division is ${\\color{red}{4}}$. This means that there will be ${\\color{red}{4}}$ candy bars in the partially-filled box.\n- Since we have ${\\color{blue}{12}}$ fully-filled boxes and one partially-filled box, there will be ${\\color{blue}{12}}+1 = 13$ boxes in total.\n\nLet's see some more examples."] [:db/cas 17592186144039 :tutorial/content "Fraction subtraction works similarly to addition. However, this time, we *remove* shaded parts that refer to the same whole.\n\nLet's consider the following subtraction problem:\n\n$$\n\\dfrac34 - \\dfrac14\n$$\n\nWe start by representing this problem using an area model:\n\n![](images/d1/d13531cc9adc5a5a4f57da5e51fafc57af1206d7189068b6d0e67467d5375bfe.png)\n\nTo subtract the fractions, we count the number of shaded parts in the right shape and remove the number of parts shown in the left shape. This leave us with\n\n$$\n3-1={\\color{red}2}\n$$\n\nshaded parts:\n\n![](images/1c/1c279e5b4f26b8cfc501d43270b3f01dc68f9c47104343e66bfa015658ec6bd1.png)\n\nTherefore, we have\n\n$$\n\\dfrac{3}{4} - \\dfrac{1}{4} = \\dfrac{\\color{red}2}{4}\n$$\n\nFinally, we can simplify this fraction by dividing the numerator and denominator by $2$:\n\n$$\n\\dfrac24 = \\dfrac{2\\div 2}{4\\div 2} = \\dfrac12\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac34 - \\dfrac14 = \\dfrac12\n$$" "Fraction subtraction works similarly to addition. However, this time, we *remove* shaded parts that refer to the same whole.\n\nLet's consider the following subtraction problem:\n\n$$\n\\dfrac34 - \\dfrac14\n$$\n\nWe start by representing this problem using an area model:\n\n![](images/d1/d13531cc9adc5a5a4f57da5e51fafc57af1206d7189068b6d0e67467d5375bfe.png)\n\nTo subtract the fractions, we count the number of shaded parts in the right shape and remove the number of parts shown in the left shape. This leave us with\n\n$$\n3-1={\\color{red}2}\n$$\n\nshaded parts:\n\n![](images/1c/1c279e5b4f26b8cfc501d43270b3f01dc68f9c47104343e66bfa015658ec6bd1.png)\n\nTherefore, we have\n\n$$\n\\dfrac{3}{4} - \\dfrac{1}{4} = \\dfrac{\\color{red}2}{4}\n$$\n\nFinally, we can simplify this fraction by dividing the numerator and denominator by $2$:\n\n$$\n\\dfrac24 = \\dfrac{2\\operatorname{div}  2}{4\\operatorname{div}  2} = \\dfrac12\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac34 - \\dfrac14 = \\dfrac12\n$$"] [:db/cas 17592186144045 :tutorial/content "To write a fraction in its lowest terms, we divide the numerator and denominator by their greatest common factor.\n\nFor example, let's write the following fraction in lowest terms:\n\n$$\n\\dfrac{8}{20}\n$$\n\nWe start by finding the greatest common factor of $8$ and $20$:\n\n- Factors of $8:\\quad 1,2,{\\color{blue}{4}}, 8$\n- Factors of $20:\\quad 1,2, {\\color{blue}{4}}, 5, 10, 20$\n\nSo, the greatest common factor of $8$ and $20$ is ${\\color{blue}{4}}$.\n\nNow, dividing both the numerator and denominator by our greatest common factor $({\\color{blue}{4}})$ gives\n\n$$\n\\dfrac{8}{20} = \\dfrac{8 \\div {\\color{blue}{4}}}{20 \\div {\\color{blue}{4}}}=\\dfrac{2}{5}\n$$\n\nSo,\n\n$$\n\\dfrac{8}{20}\n$$\n\nexpressed in lowest terms is\n\n$$\n\\dfrac25\n$$" "To write a fraction in its lowest terms, we divide the numerator and denominator by their greatest common factor.\n\nFor example, let's write the following fraction in lowest terms:\n\n$$\n\\dfrac{8}{20}\n$$\n\nWe start by finding the greatest common factor of $8$ and $20$:\n\n- Factors of $8:\\quad 1,2,{\\color{blue}{4}}, 8$\n- Factors of $20:\\quad 1,2, {\\color{blue}{4}}, 5, 10, 20$\n\nSo, the greatest common factor of $8$ and $20$ is ${\\color{blue}{4}}$.\n\nNow, dividing both the numerator and denominator by our greatest common factor $({\\color{blue}{4}})$ gives\n\n$$\n\\dfrac{8}{20} = \\dfrac{8 \\operatorname{div}  {\\color{blue}{4}}}{20 \\operatorname{div}  {\\color{blue}{4}}}=\\dfrac{2}{5}\n$$\n\nSo,\n\n$$\n\\dfrac{8}{20}\n$$\n\nexpressed in lowest terms is\n\n$$\n\\dfrac25\n$$"] [:db/cas 17592186144052 :tutorial/content "We can also *divide* the numerator and denominator of a fraction by the same number to give an equivalent fraction.\n\nFor example, let's consider the following fraction:\n\n$$\n\\dfrac{6}{12}\n$$\n\nLet's create some equivalent fractions by dividing:\n\n- Notice that $6$ and $12$ both have ${\\color{blue}{2}}$ as a factor. Therefore, we can divide our fraction by ${\\color{blue}{2}}$ to create an equivalent fraction:\n\n$$\n\\dfrac{6}{12} = \\dfrac{6\\div {\\color{blue}{2}}}{12 \\div {\\color{blue}{2}}} = \\dfrac36\n$$\n\n- Similarly, $6$ and $12$ both have ${\\color{red}{3}}$ as a factor. Therefore, we can divide our fraction by ${\\color{red}{3}}$ to create an equivalent fraction:\n\n$$\n\\dfrac{6}{12} = \\dfrac{6\\div {\\color{red}{3}}}{12 \\div {\\color{red}{3}}} = \\dfrac24\n$$\n\n- Finally, $6$ and $12$ also have ${\\color{purple}{6}}$ as a factor. Therefore, we can divide our fraction by ${\\color{purple}{6}}$ to create an equivalent fraction:\n\n$$\n\\dfrac{6}{12} = \\dfrac{6\\div {\\color{purple}{6}}}{12 \\div {\\color{purple}{6}}} = \\dfrac12\n$$\n\nTherefore, the following fractions are all equivalent:\n\n$$\n\\dfrac{6}{12}, \\qquad \\dfrac{3}{6}, \\qquad \\dfrac{2}{4}, \\qquad \\dfrac12\n$$" "We can also *divide* the numerator and denominator of a fraction by the same number to give an equivalent fraction.\n\nFor example, let's consider the following fraction:\n\n$$\n\\dfrac{6}{12}\n$$\n\nLet's create some equivalent fractions by dividing:\n\n- Notice that $6$ and $12$ both have ${\\color{blue}{2}}$ as a factor. Therefore, we can divide our fraction by ${\\color{blue}{2}}$ to create an equivalent fraction:\n\n$$\n\\dfrac{6}{12} = \\dfrac{6\\operatorname{div}  {\\color{blue}{2}}}{12 \\operatorname{div}  {\\color{blue}{2}}} = \\dfrac36\n$$\n\n- Similarly, $6$ and $12$ both have ${\\color{red}{3}}$ as a factor. Therefore, we can divide our fraction by ${\\color{red}{3}}$ to create an equivalent fraction:\n\n$$\n\\dfrac{6}{12} = \\dfrac{6\\operatorname{div}  {\\color{red}{3}}}{12 \\operatorname{div}  {\\color{red}{3}}} = \\dfrac24\n$$\n\n- Finally, $6$ and $12$ also have ${\\color{purple}{6}}$ as a factor. Therefore, we can divide our fraction by ${\\color{purple}{6}}$ to create an equivalent fraction:\n\n$$\n\\dfrac{6}{12} = \\dfrac{6\\operatorname{div}  {\\color{purple}{6}}}{12 \\operatorname{div}  {\\color{purple}{6}}} = \\dfrac12\n$$\n\nTherefore, the following fractions are all equivalent:\n\n$$\n\\dfrac{6}{12}, \\qquad \\dfrac{3}{6}, \\qquad \\dfrac{2}{4}, \\qquad \\dfrac12\n$$"] [:db/cas 17592186144056 :tutorial/content "Let's consider the following area model.\n\n![](images/15/156ce7d2152909e84e0dab8a476c9265f4d154a35356894936daf6f4eab2fe95.png)\n\nTo determine the missing length, we consider the area of the blue rectangle (the one on the right-hand side).\n\nThe area of the blue rectangle is $12$, and its width is $3$. Therefore, the length of this rectangle must be\n\n$$\n12 \\div 3 = 4\n$$\n\nLet's add this length to our area model.\n\n![](images/a1/a197e64e8f3cba7ff00466d46862a8456865859dcb4bba285ee92efbcc6ad645.png)\n\nAnd we're done! Let's see another example." "Let's consider the following area model.\n\n![](images/15/156ce7d2152909e84e0dab8a476c9265f4d154a35356894936daf6f4eab2fe95.png)\n\nTo determine the missing length, we consider the area of the blue rectangle (the one on the right-hand side).\n\nThe area of the blue rectangle is $12$, and its width is $3$. Therefore, the length of this rectangle must be\n\n$$\n12 \\operatorname{div}  3 = 4\n$$\n\nLet's add this length to our area model.\n\n![](images/a1/a197e64e8f3cba7ff00466d46862a8456865859dcb4bba285ee92efbcc6ad645.png)\n\nAnd we're done! Let's see another example."] [:db/cas 17592186144057 :tutorial/content "Area models can be used to represent division problems.\n\nFor example, let's take a look at the following area model.\n\n![](images/99/996da3c5559f3251d95012c865ee61c2bb8cbf377acb483271c14348affa3ce9.png)\n\nNow, let's look at the big rectangle:\n\n- its length is $10+6=16$\n- its width is $4$\n- its area is ${\\color{blue}{40}}+{\\color{blue}{24}}=64$\n\nSince the area of the big rectangle equals its length multiplied by its width, this model represents the following multiplication problem:\n\n$$\n16 \\times 4= 64\n$$\n\nWriting this as a division problem, we get\n\n$$\n16 = 64\\div 4\n$$\n\n**Note:** When using area models to represent division problems, the divisor ($4$ in this case) is the number on the *left-hand side* of our model." "Area models can be used to represent division problems.\n\nFor example, let's take a look at the following area model.\n\n![](images/99/996da3c5559f3251d95012c865ee61c2bb8cbf377acb483271c14348affa3ce9.png)\n\nNow, let's look at the big rectangle:\n\n- its length is $10+6=16$\n- its width is $4$\n- its area is ${\\color{blue}{40}}+{\\color{blue}{24}}=64$\n\nSince the area of the big rectangle equals its length multiplied by its width, this model represents the following multiplication problem:\n\n$$\n16 \\times 4= 64\n$$\n\nWriting this as a division problem, we get\n\n$$\n16 = 64\\operatorname{div}  4\n$$\n\n**Note:** When using area models to represent division problems, the divisor ($4$ in this case) is the number on the *left-hand side* of our model."] [:db/cas 17592186144058 :tutorial/content "We can use area models to represent division problems involving three-digit numbers.\n\nLet's consider the area model below.\n\n![](images/7c/7ccfb4c03d006e630f4cf7d5c38e44b06e2647d0d082c30e32250deca4bbc7a9.png)\n\nTo determine the missing length, we consider the area of the yellow rectangle (the one on the left-hand side).\n\nThe area of the yellow rectangle is $320$, and its width is $4$. Hence, the length of this rectangle must be\n$320\\div 4$.\n\nTo carry out this division, we write $320$ as a product with $10$ as one of the factors and then swap the order of multiplication and division:\n\n$$\n\\begin{aligned}320 \\div 4 &= 32 \\cdot 10 \\div 4 \\\\ &= 32 \\div 4 \\cdot 10 \\\\ &= (32 \\div 4) \\cdot 10 \\\\ &= 8 \\cdot 10 \\\\ &= 80\\end{aligned}\n$$\n\nWe can now add this length to the area model.\n\n![](images/ad/addc22099bd0b2ba80e9260f115a991d1299eaf86e4fcebe242656363f389d4c.png)" "We can use area models to represent division problems involving three-digit numbers.\n\nLet's consider the area model below.\n\n![](images/7c/7ccfb4c03d006e630f4cf7d5c38e44b06e2647d0d082c30e32250deca4bbc7a9.png)\n\nTo determine the missing length, we consider the area of the yellow rectangle (the one on the left-hand side).\n\nThe area of the yellow rectangle is $320$, and its width is $4$. Hence, the length of this rectangle must be\n$320\\operatorname{div}  4$.\n\nTo carry out this division, we write $320$ as a product with $10$ as one of the factors and then swap the order of multiplication and division:\n\n$$\n\\begin{aligned}320 \\operatorname{div}  4 &= 32 \\cdot 10 \\operatorname{div}  4 \\\\ &= 32 \\operatorname{div}  4 \\cdot 10 \\\\ &= (32 \\operatorname{div}  4) \\cdot 10 \\\\ &= 8 \\cdot 10 \\\\ &= 80\\end{aligned}\n$$\n\nWe can now add this length to the area model.\n\n![](images/ad/addc22099bd0b2ba80e9260f115a991d1299eaf86e4fcebe242656363f389d4c.png)"]]
