imits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = \\operatorname{arcoth} {e^x},$ then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$"] [:db/cas 17592186166605 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcoth x) = \\dfrac{1}{1-x^2}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡{e}^{x}) \\\\  & =\\frac{1}{1-({e}^{x})^{2}}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{1-{e}^{2x}}\\cdot {e}^{x} \\\\  & =\\frac{{e}^{x}}{1-{e}^{2x}}.\\end{aligned}\n$$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\operatorname{arcoth}  x) = \\dfrac{1}{1-x^2}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡{e}^{x}) \\\\  & =\\frac{1}{1-({e}^{x})^{2}}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{1-{e}^{2x}}\\cdot {e}^{x} \\\\  & =\\frac{{e}^{x}}{1-{e}^{2x}}.\\end{aligned}\n$$"] [:db/cas 17592186166606 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $f(x) = \\sin{x} \\cdot \\arcsch{x},$ then $f'(x) = \\cos{x} \\arcsch{x} + g(x).$ What is $g(x)?$" "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $f(x) = \\sin{x} \\cdot \\operatorname{arcsch} {x},$ then $f'(x) = \\cos{x} \\operatorname{arcsch} {x} + g(x).$ What is $g(x)?$"] [:db/cas 17592186166606 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newc