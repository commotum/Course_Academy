372c8489c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(a + b)∣5" :db/id #edb/ref 17592186057955}] :answer-field/id #uuid "113333ea-6c64-5be8-97b7-8b6243d4d78a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186057951}] :question/id #uuid "a73caa75-a809-5559-994e-2d6d6ce4bf22" :question/math-academy-id "q-225343" :question/problem "Let $a, b ∈ Z$. Prove that $a≡b(\\bmod 5)$ provided that $3a≡3b(\\bmod 5)$.\n\nUsing the definition of {{field-1}},\n\n$3(a - b)∣5$ {{field-2}}"} {:db/id #edb/ref 17592186060249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33f0f137-c430-5061-9aba-b7129465682e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288376} {:answer/id #uuid "35864b6e-3160-54c7-bb0e-bbc1a3db4cf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288392} {:answer/id #uuid "4b2e4678-898e-5968-8e8e-f42eee7f8c22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288553} {:answer/id #uuid "9b91da1b-cbc8-5cbe-9932-fdd206c48a34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186289077} {:answer/id #uuid "dc2818c1-253d-5758-83e4-f0b3910f6f07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186289497}] :answer-field/correct {:db/id #edb/ref 17592186288392} :answer-field/id #uuid "8b668a88-94da-5c15-92cb-0b1782d6eb86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f5ad5b9-cf75-5c20-a9c5-6e5d15578fe2" :question/math-academy-id "q-24788" :question/problem "Find the exact value of $$\n\\displaystyle {(\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right))}^{2}.\n$$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right))}^{2} & ={\\sin }^{2}⁡\\left(\\frac{\\pi }{12}\\right)-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)+{\\cos }^{2}⁡\\left(\\frac{\\pi }{12}\\right) \\\\  & =[{\\sin }^{2}⁡\\left(\\frac{\\pi }{12}\\right)+{\\cos }^{2}⁡\\left(\\frac{\\pi }{12}\\right)]-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right) \\\\  & =1-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right) & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\begin{aligned}1-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right) & =1-\\left(\\frac{1}{2}\\right)=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right))}^{2}=\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186060347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23fa492c-2b6f-575d-887c-9228be9a16f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{sin}⁡x" :db/id #edb/ref 17592186333322} {:answer/id #uuid "8d7c6404-2b25-54fa-94d0-6f77d064763b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334251} {:answer/id #uuid "95cc9a2a-f119-5a30-83a9-1de8f468d8a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334323} {:answer/id #uuid "b1d83c2b-3dc3-52bb-b1dd-c662d588dbae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{sin}^{2}⁡x" :db/id #edb/ref 17592186334549} {:answer/id #uuid "dd5708a4-4e83-57c4-b5c5-e5fe68d5f4dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334922}] :answer-field/correct {:db/id #edb/ref 17592186334251} :answer-field/id #uuid "b36ee6a4-c232-5bf3-bd7c-ec897ad3be2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335567}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c024ed7c-9654-5da5-b602-2f368dd77de2" :question/math-academy-id "q-65181" :question/problem "Simplify the expression $\\frac{{\\cos }^{2}⁡x}{\\operatorname{sin}⁡x+1}.$" :question/worked-solution "First, we rewrite the numerator using $1-{\\sin }^{2}⁡x={\\cos }^{2}⁡x.$\n\n$$\n\\frac{{\\cos }^{2}⁡x}{\\operatorname{sin}⁡x+1}=\\frac{1-{\\sin }^{2}⁡x}{\\operatorname{sin}⁡x+1}\n$$\n\nNext, we factor the numerator as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{\\sin }^{2}⁡x}{\\operatorname{sin}⁡x+1} & =\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{\\operatorname{sin}⁡x+1} \\\\  & =\\frac{\\cancel{(1+\\operatorname{sin}⁡x)}(1-\\operatorname{sin}⁡x)}{\\cancel{\\operatorname{sin}⁡x+1}} \\\\  & =\\frac{1-\\operatorname{sin}⁡x}{1} \\\\  & =1-\\operatorname{sin}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186060348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e882ed-9be9-5c93-9290-85c83bfaa63f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333006} {:answer/id #uuid "10a1509f-d591-511e-8ccc-b589dbd5d876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186333141} {:answer/id #uuid "a941abfc-6f5e-5d3e-b8e1-5ce00d6dc491" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186334471} {:answer/id #uuid "b54ab5be-502c-52bb-ab06-157743cc85de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186334576} {:answer/id #uuid "fb04eb10-d232-5a60-87b0-3c6823371bca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186335192}] :answer-field/correct {:db/id #edb/ref 17592186334576} :answer-field/id #uuid "a83da8ba-d6f8-5166-892b-88e078e49555" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335546}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6649e183-eb4d-5947-a240-b0aee73aa4fe" :question/math-academy-id "q-65182" :question/problem "If $$\n\\displaystyle \\frac{1-\\operatorname{cos}⁡x}{{\\sin }^{2}⁡x}=\\frac{1}{f(x)},\n$$ then $f(x)=$" :question/worked-solution "First, we rewrite the denominator using $1-{\\cos }^{2}⁡x={\\sin }^{2}⁡x.$\n\n$$\n\\frac{1-\\operatorname{cos}⁡x}{{\\sin }^{2}⁡x}=\\frac{1-\\operatorname{cos}⁡x}{1-{\\cos }^{2}⁡x}\n$$\n\nNext, we factor the denominator as difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-\\operatorname{cos}⁡x}{1-{\\cos }^{2}⁡x} & =\\frac{1-\\operatorname{cos}⁡x}{(1-\\operatorname{cos}⁡x)(1+\\operatorname{cos}⁡x)} \\\\  & =\\frac{\\cancel{1-\\operatorname{cos}⁡x}}{\\cancel{(1-\\operatorname{cos}⁡x)}(1+\\operatorname{cos}⁡x)} \\\\  & =\\frac{1}{1+\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, $f(x)=1+\\operatorname{cos}⁡x.$"} {:db/id #edb/ref 17592186060363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8a12e03-7bf6-5ac3-82b1-af9cc21b81b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = π\\sin (x)" :db/id #edb/ref 17592186058801} {:answer/id #uuid "ec32cb0d-2bce-55b3-bd65-1bfc5d7e99dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = \\sin (x) - π" :db/id #edb/ref 17592186058802} {:answer/id #uuid "14041484-fa99-5fc9-83c4-2cf98603cf7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y =-\\sin (πx)" :db/id #edb/ref 17592186058803} {:answer/id #uuid "4cee018c-40d7-57c2-85b2-4b2d7288563f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y =-\\sin (x)" :db/id #edb/ref 17592186058804} {:answer/id #uuid "77fd0efd-af17-558b-b93f-45dc3bd64218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = \\sin (x)" :db/id #edb/ref 17592186058805}] :answer-field/id #uuid "cb0968ac-abba-5392-a5fe-c38d817e6fb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186058800} {:answer-field/choices [{:answer/id #uuid "0fa65de1-f8c2-59ee-a58c-73e8d5a35da2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-sin⁡(x)" :db/id #edb/ref 17592186403200} {:answer/id #uuid "cae2feac-73a9-5382-be98-e2d0b9a31076" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pi sin⁡(x)" :db/id #edb/ref 17592186403201} {:answer/id #uuid "d5459411-109c-5634-a6d6-08426f206d22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-sin⁡(\\pi x)" :db/id #edb/ref 17592186403202} {:answer/id #uuid "7886e8be-97bf-51de-9431-947f4fe26d47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡(x)-\\pi " :db/id #edb/ref 17592186403203} {:answer/id #uuid "d253f678-7f7d-5e04-b080-f88bfe3b102d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡(x)" :db/id #edb/ref 17592186403204}] :answer-field/correct {:db/id #edb/ref 17592186403200} :answer-field/id #uuid "d5a960d3-9ccd-5921-846a-d374278a4922" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403199}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d5ac861-a6f5-5aad-8010-c1a0229f1d0d" :question/math-academy-id "q-6580" :question/problem "![](images/2f/2fec23f57e68ac65bf05662e70fba9ac5872f77d63a55f89f7e90b9f0b9bfa24.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/02/0204cfb247273efc20a31366dcb84096d630aa6dbe90c94a8802834205bbdd56.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=\\sin ⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-\\sin ⁡x.$\n\nTherefore, the given curve is the graph of $y=-\\sin ⁡x.$"} {:db/id #edb/ref 17592186060366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd0657d0-1f29-512a-935d-c3b3b8aa4ccd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡x" :db/id #edb/ref 17592186334778} {:answer/id #uuid "d2bc693e-23a9-5d61-bba6-477bccc86499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(-x)" :db/id #edb/ref 17592186334832} {:answer/id #uuid "ea055c5c-7b01-53c0-a64b-fcf490320520" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡x" :db/id #edb/ref 17592186335037} {:answer/id #uuid "fa71f645-2374-59ab-96bd-b55af1cdc155" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x-\\pi )" :db/id #edb/ref 17592186335182} {:answer/id #uuid "fefbaf2a-4796-5b0b-8b76-ee9dd03e709a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=sin⁡(-x)" :db/id #edb/ref 17592186335232}] :answer-field/correct {:db/id #edb/ref 17592186334832} :answer-field/id #uuid "9f7e5da8-36bf-5025-bf3d-d1e45ccf9bb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335535}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "681b918b-daff-5df7-b3b5-e24ca656fe11" :question/math-academy-id "q-65833" :question/problem "![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "The given curve is the graph of $y=\\cos ⁡x.$\n\nNotice that, because the cosine function is even, it is symmetric about the $y$-axis, i.e.,\n\n$$\n\\cos ⁡(-x)=\\cos ⁡x\n$$\n\nSo the graph could also be viewed as $y=\\cos ⁡(-x).$"} {:db/id #edb/ref 17592186060378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128a5057-1cb1-5eb4-97a3-3cc570034ca6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x)+1" :db/id #edb/ref 17592186333156} {:answer/id #uuid "153a535d-7e15-56cb-9811-bc9d26abc82d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=cos⁡(x+1)" :db/id #edb/ref 17592186333175} {:answer/id #uuid "66484a78-6886-5632-b0d2-c2cbda1d5026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x+1)" :db/id #edb/ref 17592186333918} {:answer/id #uuid "7a6a43a7-63e8-531b-b3b2-c68be6ebd0f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x)+1" :db/id #edb/ref 17592186334089} {:answer/id #uuid "95c965cd-c257-5edf-9206-304f9ab44f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-cos⁡(x)-1" :db/id #edb/ref 17592186334322}] :answer-field/correct {:db/id #edb/ref 17592186334089} :answer-field/id #uuid "ab96b33c-013b-5bd3-bb1c-eec5cc36e2d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335556}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "27ee5b5b-7d28-5cc8-95f1-b8374e27584d" :question/math-academy-id "q-6777" :question/problem "![](images/a0/a0fad408979d571a333d24fa51c402c9679dca25a899ee2fd65a3bf566a51681.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](images/c2/c27ff316601ece28946ef45711690d6aabca92a4c35f07b0b1cc1c0982fb5d8e.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=\\cos ⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-\\cos ⁡x.$\n\n- Finally, translate it by $1$ unit **up** to give $y=-\\cos ⁡x+1$\n\nTherefore, the given curve is the graph of $y=-\\cos ⁡x+1.$"} {:db/id #edb/ref 17592186060433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee631ca-08b6-57a2-baf8-01c55b9afe77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186059221} {:answer/id #uuid "c5af626c-0f95-5482-8308-f1c6ab338191" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186059222} {:answer/id #uuid "28ce4cae-57d3-5a1a-b387-e5356ff9eb27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186059223} {:answer/id #uuid "3d6093c7-d7d3-5b73-8456-ffe862656b95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186059224} {:answer/id #uuid "4a120f6a-8cf8-5a36-8599-d3bf2ba42ffa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186059225}] :answer-field/correct {:db/id #edb/ref 17592186059221} :answer-field/id #uuid "dc9fc087-b031-5720-bd66-af06b92f0136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186059220}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c23322a3-0d32-5f5e-94fe-517b1c9adee5" :question/math-academy-id "q-906" :question/problem "If ${\\log }_{4}⁡x=3$, then $x=$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use a base of $4$ for the exponentiation as well:\n\n$$\n\\begin{aligned}{\\log }_{4}⁡x & =3 \\\\ {4}^{{\\log }_{4}⁡x} & ={4}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{\\log }_{4}⁡x}=x.$\n\nTherefore, \n\n$$\n\\begin{aligned}x & ={4}^{3} \\\\ x & =64.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186060450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0315a0c1-8e93-55c4-b28a-30f0ae9610cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186357784} {:answer/id #uuid "77c1dc2e-024e-5c4b-beb2-f733502ac77d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186358787} {:answer/id #uuid "7ff9ce2a-cbe8-5d79-93a4-76f40fb9e37b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186358869} {:answer/id #uuid "8a4d33c6-a100-512f-a9be-112dbf385d47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186358957} {:answer/id #uuid "c9d1af3f-8416-5b82-9e39-9309a5040a16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186359523}] :answer-field/correct {:db/id #edb/ref 17592186358869} :answer-field/id #uuid "0d9ac11a-04f8-5372-b25f-a5363dbf63f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360021}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "20571cf0-076d-5c7b-a788-d7a5f5cb703e" :question/math-academy-id "q-9710" :question/problem "The entry ${a}_{12}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ k & 6 & 0\\end{bmatrix}\n$$\nequals $18.$ Find the value of $k.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\det (A)=\\begin{vmatrix}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ k & 6 & 0\\end{vmatrix} & =1\\begin{vmatrix}1 & 4 \\\\ 6 & 0\\end{vmatrix}-2\\begin{vmatrix}0 & 4 \\\\ k & 0\\end{vmatrix}+3\\begin{vmatrix}0 & 1 \\\\ k & 6\\end{vmatrix} \\\\  & =1(0-24)-2(0-4k)+3(0-k) \\\\  & =8k-3k-24 \\\\  & =5k-24.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}\\begin{vmatrix}2 & 3 \\\\ 6 & 0\\end{vmatrix} \\\\  & =-\\begin{vmatrix}2 & 3 \\\\ 6 & 0\\end{vmatrix} \\\\  & =-(0-18) \\\\  & =18.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{\\det (A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{21} \\\\  & =\\frac{1}{5k-24}\\cdot 18 \\\\  & =\\frac{18}{5k-24}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{13}^{′}=18$, we have\n\n$$\n\\begin{aligned}\\frac{18}{5k-24} & =18 \\\\ \\frac{1}{5k-24} & =1 \\\\ 1 & =5k-24 \\\\ 25 & =5k \\\\ k & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186060454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141d3bda-708e-5cd1-a9c3-33813075f0e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438670} {:answer/id #uuid "c97bfd73-22d0-514a-b96a-af8b07567307" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438671}] :answer-field/correct {:db/id #edb/ref 17592186438671} :answer-field/id #uuid "e441ef7a-f7d8-556c-897f-7d0c7a6b2bc1" :answer-field/key "$det(F)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439364} {:answer-field/choices [{:answer/id #uuid "aa853019-8cb7-57bb-8d89-07bb087c8654" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438672} {:answer/id #uuid "5e56b566-9992-53f1-aacf-331d0f084061" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438673}] :answer-field/correct {:db/id #edb/ref 17592186438673} :answer-field/id #uuid "e6cc4081-efb3-5cbd-91d9-77bb4d9690f4" :answer-field/key "$F$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439365} {:answer-field/choices [{:answer/id #uuid "1db0c840-997f-55b7-bab1-3572f80549a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438674} {:answer/id #uuid "9da77c68-30c2-574d-8a12-c8183bf926de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438675}] :answer-field/correct {:db/id #edb/ref 17592186438674} :answer-field/id #uuid "3e1cd461-5747-5d77-9466-83683a668421" :answer-field/key "$det(F)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439366}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n$$\nF=\\begin{bmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\det (F) & =\\begin{vmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{vmatrix} \\\\  & =0\\begin{vmatrix}4 & 5 \\\\ 7 & 8\\end{vmatrix}-1\\begin{vmatrix}3 & 5 \\\\ 6 & 8\\end{vmatrix}+2\\begin{vmatrix}3 & 4 \\\\ 6 & 7\\end{vmatrix} \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $\\det (F)=0$, the matrix is singular. \n\nTherefore, only statements $\\det (F)=0$ and “$F$ is a singular matrix” are true."} {:db/id #edb/ref 17592186060458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2e2a7fa-1a07-507e-9cfb-d555fed4d92f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}5 & -5 & -5 \\\\ -6 & 5 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186059371} {:answer/id #uuid "413612e5-67ec-5bfe-a7b4-1ae63f30a529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}5 & -7 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186059372} {:answer/id #uuid "4c1f7f26-d02f-5e3f-a75e-088281efd141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186059373} {:answer/id #uuid "4f81fba0-53c1-5618-97a3-e5a601c25bd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}\\begin{bmatrix}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186059374} {:answer/id #uuid "4fa3e0c4-2a51-5f34-aca2-36798ca2ba7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186059375}] :answer-field/correct {:db/id #edb/ref 17592186059375} :answer-field/id #uuid "0e2f5d0b-4478-5dc8-803a-bd9eeb731d12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186059370}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86bd8759-9672-5297-874b-c9bf15a86252" :question/math-academy-id "q-9965" :question/problem "Find the inverse of the matrix $A = \\begin{bmatrix}1 & -1 & 3 \\\\ 2 & 1 & 2 \\\\ -2 & -2 & 1\\end{bmatrix}$\ngiven that $\\det (A) = 5$." :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** Find the determinant of $A$.\n\n$$\n\\det(A)=(1)(5)+(-1)(-6)+(3)(-2)=5.\n$$\n\n**Step 2:** Form the matrix of minors. Delete row $i$ and column $j$ to obtain $M_{ij}$. For example,\n\n$$\nM_{11}=\\begin{vmatrix}1 & 2 \\\\ -2 & 1\\end{vmatrix}=5.\n$$\n\nComputing the remaining minors gives\n\n$$\nM=\\begin{bmatrix}5 & 6 & -2 \\\\ 5 & 7 & -4 \\\\ -5 & -4 & 3\\end{bmatrix}.\n$$\n\n**Step 3:** Apply the alternating signs $(-1)^{i+j}$ to form the cofactor matrix.\n\n$$\nC=\\begin{bmatrix}5 & -6 & -2 \\\\ -5 & 7 & 4 \\\\ -5 & 4 & 3\\end{bmatrix}.\n$$\n\n**Step 4:** Transpose the matrix of cofactors.\n\n$$\nC^T=\\begin{bmatrix}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}.\n$$\n\n**Step 5:** Divide by the nonzero determinant.\n\n$$\nA^{-1}=\\frac{1}{\\det(A)}C^T=\\frac{1}{5}\\begin{bmatrix}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{bmatrix}=\\begin{bmatrix}1 & -1 & -1 \\\\ - \\frac{6}{5} & \\frac{7}{5} & \\frac{4}{5} \\\\ - \\frac{2}{5} & \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186060459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e65ae8a-57ce-5eb7-8254-bbe131d8f40c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186059377} {:answer/id #uuid "b31705b8-2e69-5452-b12a-9cd85d22b26a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186059378} {:answer/id #uuid "ff8b60ca-2038-56d9-bf33-2d7df3d1d28d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186059379} {:answer/id #uuid "1c2241db-dca5-5b98-b283-c76148dd792e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186059380} {:answer/id #uuid "58134502-f6c0-5d83-9274-d6f7f28fca66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186059381}] :answer-field/correct {:db/id #edb/ref 17592186059377} :answer-field/id #uuid "168f3dd3-003b-54d0-ae3c-e643ac553095" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186059376}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c04effc9-bb43-5aa7-be8b-3e036c90cdc8" :question/math-academy-id "q-9997" :question/problem "The entry $a_{23}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A = \\begin{bmatrix}1 & 0 & -1 \\\\ 1 & 1 & 3 \\\\ 3 & k & 1\\end{bmatrix}\n$$\nequals $-1$ and $\\det (A) = 4 - 4k$. Find the value of $k$." :question/worked-solution "Since $A^{-1}=\\dfrac{1}{\\det(A)}C^T,$ the entry $a_{23}^{\\prime}$ uses the cofactor $C_{32}$. Remove row $3$ and column $2$ to get\n\n$$\nC_{32}=(-1)^{3+2}\\begin{vmatrix}1 & -1 \\\\ 1 & 3\\end{vmatrix}=-4.\n$$\n\nUsing the given determinant, we obtain\n\n$$\na_{23}^{\\prime}=\\frac{-4}{4-4k}.\n$$\n\nThe inverse exists only when $k\\ne1$. Set this entry equal to $-1$ and solve:\n\n$$\n\\begin{aligned}\\frac{-4}{4-4k}&=-1\\\\-4&=-4+4k\\\\k&=0.\\end{aligned}\n$$\n\nAt $k=0,$ the determinant is $4\\ne0,$ so this value is valid."} {:db/id #edb/ref 17592186060863 :tutorial/content "Let's now derive the law of cosines in the following form:\n\n$$\na^2 = b^2 + c^2 - 2bc\\cos A\n$$\n\nConsider $\\triangle ABC$ with sides of lengths $a,b,$ and $c,$ as shown below. \n\n![](images/7c/7cc2a0cbb6a02af829e070fc54cfdbe616683f86527b119a530053a34048e699.png)\n\nLet's now add the height $\\overline{CH}$ and assume it has length $h,$ as shown.\n\n![](images/d4/d4e80b2b54283ea353b687d959e9d8fc6c9303e85081c0a46b48703ee3dae7d5.png)\n\nThe remainder of this proof consists of two steps:\n\n- **Step 1**: Write down expressions for $\\cos A$ and $\\sin A.$\n\n- **Step 2**: Apply the Pythagorean theorem to $\\triangle BHC,$ and simplify.\n\nUsing elementary trigonometry, we have\n\n$$\n\\cos A = \\dfrac{AH}{b}, \\qquad \\sin A = \\dfrac{h}{b},\n$$\n\nwhich can be written as\n\n$$\nAH =  b\\cos A, \\qquad h = b\\sin A.\n$$\n\nApplying the Pythagorean theorem to $\\triangle BHC$ and using our expression for $h,$ we have\n\n$$\n\\begin{aligned}{a}^{2} & =(BH)^{2}+{h}^{2} \\\\ {a}^{2} & =(BH)^{2}+{b}^{2}{\\sin }^{2}⁡A.\\end{aligned}\n$$\n\nNow, consider the length of the side $\\overline{AB}.$ Since $\\overline{AB}$ consists of two segments, $\\overline{AH}$ and $\\overline{BH},$ we have\n\n$$\nc = AH + BH\\quad \\Longrightarrow\\quad BH = c - AH,\n$$\n\nand using our expression for $AH,$ we have\n\n$$\nBH = c - b\\cos A.\n$$\n\nSubstituting this into our expression for $a^2,$ we have\n\n$$\n\\begin{aligned}{a}^{2} & =(BH)^{2}+{b}^{2}{\\sin }^{2}⁡A \\\\  & =(c-b\\operatorname{cos}⁡A)^{2}+{b}^{2}{\\sin }^{2}⁡A \\\\  & ={c}^{2}-2bc\\operatorname{cos}⁡A+{b}^{2}{\\cos }^{2}⁡A+{b}^{2}{\\sin }^{2}⁡A \\\\  & ={b}^{2}{\\cos }^{2}⁡A+{b}^{2}{\\sin }^{2}⁡A+{c}^{2}-2bc\\operatorname{cos}⁡A \\\\  & ={b}^{2}({\\cos }^{2}⁡A+{\\sin }^{2}⁡A)+{c}^{2}-2bc\\operatorname{cos}⁡A.\\end{aligned}\n$$\n\nIt can be shown that $\\cos^2A + \\sin^2 A = 1$ for any angle $A$ (this is the Pythagorean theorem in trigonometric form). Therefore, we have\n\n$$\na^2 = b^2 + c^2 - 2bc\\cos A\n$$\n\nas required.\n\nWe can use a similar argument to prove the following results:\n\n$$\n\\begin{aligned}{b}^{2} &={a}^{2}+{c}^{2}-2ac\\operatorname{cos}⁡B \\\\ {c}^{2} &={a}^{2}+{b}^{2}-2ab\\operatorname{cos}⁡C\\end{aligned}\n$$" :tutorial/id #uuid "6ee27fb2-d873-53a9-b674-446b546b19ec" :tutorial/math-academy-id 13281 :tutorial/title "Deriving the Law of Cosines"} {:db/id #edb/ref 17592186060906 :tutorial/content "Suppose we are given the equation $\\log_3 x = 4.$ Can we determine $x?$\n\nRecall that the inverse operation of the logarithm is exponentiation. So, to isolate $x,$ we must exponentiate both sides of this equation. \n\nThe base of the logarithm is $3,$ so we use a base of $3$ for the exponentiation as well:\n\n$$\n\\begin{aligned}{\\log }_{3}⁡x & =4 \\\\ {3}^{({\\log }_{3}⁡x)} & ={3}^{4}\\end{aligned}\n$$\n\nThe equation above may look complicated, but since exponentiation is the inverse function of the logarithm, we know that $3^{(\\log_3{x})}=x.$ Therefore, we get   \n\n$$\n\\begin{aligned}x & ={3}^{4} \\\\ x & =81.\\end{aligned}\n$$\n\nWe conclude that $x = 81$ is the solution." :tutorial/id #uuid "bbfe9e19-d1ed-5df9-97f9-0e9c7f9f50e9" :tutorial/math-academy-id 2810 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186060995 :tutorial/content "Recall the following division properties of modular arithmetic for\n\n$$\nk\\neq 0{:}\n$$\n\n- The first division property states that\n$ka \\equiv kb \\quad(\\text{mod}\\,kn) \\quad \\Rightarrow \\quad a \\equiv b \\quad(\\textrm{mod}\\,n)$.\n\n- The second division property states that\n$\\left(ka\\equiv kb\\:(\\textrm{mod} \\,n)\\right) \\:\\land\\: \\left(\\textrm{gcd}(k,n)=1\\right) \\quad \\Rightarrow\\quad a \\equiv b \\quad(\\textrm{mod}\\, n)$.\n\nLet's prove that the second property holds in the following case:\n\n$$\n\\underbrace{3a \\equiv 3b}_{P(a,b)} \\quad\\Rightarrow\\quad \\underbrace{a \\equiv b}_{Q(a,b)} \\qquad (\\textrm{mod} \\: 4)\n$$\n\nWe begin our proof by assuming $P$ is true.\n\n> *Assume* $3a \\equiv 3b\\:(\\textrm{mod} \\: 4)$.\n> *Then, by the definition of modular congruence, we have*\n> $3a≡3b(\\bmod 4) \\mid ⇔4∣(3a - 3b); ⇔4∣3(a - b)$.\n\nNow, we recall the following divisibility property of integers:\n\n$$\n(c \\mid ab) \\:\\land\\: (\\textrm{gcd}(a,c)=1) \\quad\\Rightarrow\\quad (c \\mid b)\n$$\n\nUsing this fact, we have the following:\n\n> *Now, since $3(a-b)$ is divisible by $4$ and $\\textrm{gcd}(4,3)=1$, the difference $(a-b)$ must be divisible by $4$, i.e.,*\n> $4 \\mid (a-b)$.\n\nFinally, we use the definition of modular congruence one more:\n\n> *Therefore, according to the definition of modular congruence, we have*\n> $a \\equiv b \\qquad (\\textrm{mod} \\: 4)$.\n\nAnd we're done.\n\nLet's restate the full proof." :tutorial/id #uuid "8fd2037f-aec8-565a-9c0c-22615e446a93" :tutorial/math-academy-id 8326 :tutorial/title "The Division Properties"} {:db/id #edb/ref 17592186061013 :tutorial/content "Proposition:\n\n$$\n3a \\equiv 3b\\quad\\Rightarrow\\quad a \\equiv b \\qquad (\\textrm{mod} \\: 4)\n$$\n\nProof:\n\n> *Assume* $3a \\equiv 3b\\:(\\textrm{mod} \\: 4)$. *Then, by the definition of modular congruence, we have*\n> $3a≡3b(\\bmod 4) \\mid ⇔4∣(3a - 3b); ⇔4∣3(a - b)$.\n> *Now, since $3(a-b)$ is divisible by $4$ and $\\textrm{gcd}(4,3)=1$, the difference $(a-b)$ must be divisible by $4$, i.e.,*\n> $4 \\mid (a-b)$.\n> *Therefore, according to the definition of modular congruence, we have*\n> $a \\equiv b \\qquad (\\textrm{mod} \\: 4)$.\n\nLet's now prove a particular instance of the first division property." :tutorial/id #uuid "86168776-3fc0-5076-a690-9c7d84ec6e52" :tutorial/math-academy-id 9427 :tutorial/title "Stating the Full Proof"} {:answer/id #uuid "c7972bb9-e5cc-58cc-86d5-0bd6f002c1d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\operatorname{arcsec} x + C" :db/id #edb/ref 17592186061430} {:answer/id #uuid "c98b46ef-d2a8-5b9f-9f96-ce5a5091c412" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} x + C" :db/id #edb/ref 17592186061431} {:answer/id #uuid "2e1edb87-4b01-5746-80d7-6f9375e5253f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arccsc} (11x) + C" :db/id #edb/ref 17592186061432} {:answer/id #uuid "78fd9a9d-5030-5f94-99f4-f0d95947fb4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (11x) + C" :db/id #edb/ref 17592186061433} {:answer/id #uuid "7b900c6a-908d-5d62-a159-62202b7f9b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\operatorname{arccsc} x + C" :db/id #edb/ref 17592186061434} {:answer/id #uuid "fcb978ea-4613-5d07-b1f6-e9e1aa7216e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\arccos x + C" :db/id #edb/ref 17592186061436} {:answer/id #uuid "0ed5b070-e847-5e87-96d2-722370af988a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\arctan x + C" :db/id #edb/ref 17592186061438} {:answer/id #uuid "d6b15cd7-1f5c-541d-a559-3d86e8a87d4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arcsec} x + C" :db/id #edb/ref 17592186061935} {:answer/id #uuid "4308d3ee-9e2e-58b2-8761-6ec289470799" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arccot} x + C" :db/id #edb/ref 17592186061936} {:answer/id #uuid "57293ad3-d768-51f3-8aaf-e7786fff1a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arccsc} x + C" :db/id #edb/ref 17592186061937} {:answer/id #uuid "8944cb74-2e5e-515a-a63f-7b8a7e86a355" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{arcsec} (8x))/(8) + C" :db/id #edb/ref 17592186063703} {:answer/id #uuid "e1018bb8-3b0b-58ba-b5ca-5f161a78d9f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arcsec} (8x) + C" :db/id #edb/ref 17592186063704} {:answer/id #uuid "07ff72c6-173d-5dd8-ae05-f2db21a0abc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (8x) + C" :db/id #edb/ref 17592186063705} {:answer/id #uuid "46bf3bac-62db-586a-a2ef-2700358ceb9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (64x) + C" :db/id #edb/ref 17592186063706} {:answer/id #uuid "4f5f07c7-154f-5cc5-a7d7-beef5b7ad18a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{arcsec} (4x))/(4) + C" :db/id #edb/ref 17592186063707} {:answer/id #uuid "88f90975-0515-58b0-a084-10ecd3313242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arcsec} (2x) + C" :db/id #edb/ref 17592186063768} {:answer/id #uuid "bb1ae62a-5d7c-553f-b91b-e9122ab8f92c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (2x) + C" :db/id #edb/ref 17592186063769} {:answer/id #uuid "061e358a-a593-5647-a79f-4c6fdcd9b43e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{arcsec} (2x))/(2) + C" :db/id #edb/ref 17592186063770} {:answer/id #uuid "2d743270-6050-5a4c-b34e-816cb83e91dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arcsec} (2x) + C" :db/id #edb/ref 17592186063771} {:answer/id #uuid "371decde-a130-5186-8557-fccc9516569a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{arcsec} (2x))/(4) + C" :db/id #edb/ref 17592186063772} {:db/id #edb/ref 17592186064034 :question/id #uuid "b411bf9f-f944-505d-94dc-13df743545dd" :question/math-academy-id "e-259" :question/problem "The function $h(x)$ is given by\n$$\nh(x)=\n{\\left\\{  \\begin{array}{ll}{\\log }_{3}  ( x + c ) , & x \\ne  0 , \\\\ 2 , & x = 0.\\end{array} \\right. }\n$$\n\nGiven that $h(x)$ is continuous at $x=0,$ what is the value of $c?$" :question/worked-solution "From the definition of $h(x),$ we have that \n\n$$\n\\begin{aligned}\\lim_{x\\to 0}h(x) & =\\lim_{x\\to 0}{\\log }_{3}⁡(x+c) \\\\  & ={\\log }_{3}⁡(0+c) \\\\  & ={\\log }_{3}⁡(c).\\end{aligned}\n$$\n\nIn order for $h(x)$ to be continuous at $x=0,$ we must have\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}h(x) & =h(0) \\\\ {\\log }_{3}⁡(c) & =2 \\\\ c & ={3}^{2} \\\\ c & =9.\\end{aligned}\n$$\n\nTherefore, setting $c=9$ removes the point discontinuity."} {:db/id #edb/ref 17592186064052 :question/id #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" :question/math-academy-id "e-382" :question/problem "Calculate $$\n\\displaystyle \\int 3\\sin{x}\\,\\textrm d x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 3\\sin ⁡x\\,\\text{d}x & =3\\int \\sin ⁡x\\,\\text{d}x \\\\  & =3(-\\cos ⁡x)+C \\\\  & =-3\\cos ⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064053 :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/math-academy-id "e-383" :question/problem "Calculate $$\n\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = - \\csc x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-\\csc ⁡x\\cot ⁡x)\\,\\text{d}x & =-\\int (\\csc ⁡x\\cot ⁡x)\\,\\text{d}x \\\\  & =-(-\\csc ⁡x)+C \\\\  & =\\csc ⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064055 :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/math-academy-id "e-385" :question/problem "Calculate the integral $$\n\\displaystyle{\\int} \\csc{x}(\\csc{x}+3\\cot{x} )\\, \\textrm{d}x.\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\int \\csc ⁡x(\\csc ⁡x+3\\cot ⁡x)\\,\\text{d}x & =\\int {\\csc }^{2}⁡x+3\\csc ⁡x\\cot ⁡x\\,\\text{d}x \\\\  & =\\int {\\csc }^{2}⁡x\\,\\text{d}x+3\\int \\csc ⁡x\\cot ⁡x\\,\\text{d}x \\\\  & =-\\cot ⁡x-3\\csc ⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064059 :question/id #uuid "81e3df9e-e5ab-57ec-9a82-149a277e94f0" :question/math-academy-id "e-3890" :question/problem "If $f'(x) = \\dfrac{5}{|x|\\sqrt{x^2 - 1}} - 2x,$ then $f(x)=$" :question/worked-solution "Recall that\n\n$$\n\\int \\dfrac{1}{|x|\\sqrt{x^2 - 1}} \\, \\textrm dx = \\operatorname{arcsec}  \\, x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\int {f}^{′}(x)\\,\\text{d}x \\\\  & =\\int (\\frac{5}{|x|\\sqrt{{x}^{2}-1}}-2x)\\text{d}x \\\\  & =\\int \\frac{5}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x-\\int 2x\\,\\text{d}x \\\\  & =5\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x-2\\int x\\,\\text{d}x \\\\  & =5\\operatorname{arcsec} \\,(x)-2\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =5\\operatorname{arcsec} \\,(x)-{x}^{2}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064093 :question/id #uuid "15473603-5bb5-5a20-8fc9-e4d7589ccb38" :question/math-academy-id "e-473" :question/problem "Calculate $$\n\\displaystyle \\int \\dfrac{1}{\\sin x}\\left(\\cot x + \\sin^2 x\\right)\\,\\textrm d x.\n$$" :question/worked-solution "We multiply out the parentheses and then use the identity $\\dfrac{1}{\\sin x } = \\csc x,$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\operatorname{sin}⁡x}(\\operatorname{cot}⁡x+{\\sin }^{2}⁡x)\\,\\text{d}x & =\\int (\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cot}⁡x+\\frac{1}{\\operatorname{sin}⁡x}\\cdot {\\sin }^{2}⁡x)\\,\\text{d}x \\\\  & =\\int (\\operatorname{csc}⁡x\\cdot \\operatorname{cot}⁡x+\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x+\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{csc}⁡x-\\operatorname{cos}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064094 :question/id #uuid "68d2eb66-87ab-5182-9669-376bd1f70673" :question/math-academy-id "e-474" :question/problem "Calculate $$\n\\displaystyle \\int_0^{\\pi/3} \\dfrac{\\sin x}{\\cos^2 x}\\,\\textrm d x.\n$$" :question/worked-solution "We can write the integral as\n\n$$\n\\int_0^{\\pi/3} \\dfrac{\\sin x}{\\cos^2 x}\\,\\textrm d x =  \\int_0^{\\pi/3} \\dfrac{1}{\\cos x}\\cdot \\dfrac{\\sin x}{\\cos x}\\,\\textrm d x.\n$$\n\nWe then use the fact that $\\dfrac{\\sin x }{\\cos x}  = \\tan x$ and $\\dfrac{1}{\\cos x} = \\sec x$ to express this as\n\n$$\n\\int_0^{\\pi/3} \\sec x\\tan x\\,\\textrm d x,\n$$\n\nwhich is a standard trigonometric integral. Therefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sin}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x{|}_{0}^{\\pi /3} \\\\  & =\\operatorname{sec}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{sec}⁡(0) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064101 :question/id #uuid "56860611-869d-5035-bf8f-f568c774d78d" :question/math-academy-id "e-5014" :question/problem "$$\n\\displaystyle {\\displaystyle \\int \\dfrac{5\\, \\textrm{d}x}{|5x|\\sqrt{(5x)^2-1}}  = }\n$$" :question/worked-solution "This resembles the basic integral for $\\operatorname{arcsec} ,$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^2-1}} \\textrm{d}u = \\operatorname{arcsec} (u)+C.\n$$\n\nLet $u = 5x.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=5\n\\quad\\Longrightarrow\\quad\n5\\,\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5\\,\\text{d}x}{|5x|\\sqrt{(5x)^{2}-1}} & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\operatorname{arcsec} (u)+C \\\\  & =\\operatorname{arcsec} (5x)+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064127 :question/id #uuid "373a63fc-3dae-5880-8a49-63b5c64888f3" :question/math-academy-id "e-734" :question/problem "Given that $f(x) = \\sin^3{x}$, calculate $f'(x).$" :question/worked-solution "First, we write\n\n$$\nf(x) = (\\sin{x})^3.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf = u^3, \\qquad u=\\sin x.\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = 3u^2, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = \\cos{x}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3{u}^{2}\\cdot (\\operatorname{cos}⁡x) \\\\  & =3(\\operatorname{sin}⁡x)^{2}\\operatorname{cos}⁡x \\\\  & =3{\\sin }^{2}⁡x\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064128 :question/id #uuid "ceddd310-5fe4-5b55-8210-991ff22c66b0" :question/math-academy-id "e-7349" :question/problem "Peter is standing on the bank of a river. He observes a speed boat $B$ going downstream at a constant distance of $10\\,\\textrm{m}$ from the bank. If the boat moves at a constant speed of $8 \\, \\textrm{m/s}$ parallel to the bank, at what rate is the angle $\\theta,$ between the observer's line of sight to the boat and the bank, decreasing when $\\theta = \\dfrac{\\pi}6?$ Assume the angle of elevation is decreasing at a **positive** rate, and do not round the answer.\n\n![](images/ab/abf063d149ae14c11b9ca62208a4390b32ae191418c2e0fe77f6038479fd5625.png)" :question/worked-solution "![](images/11/113109cb44fd2d10cd3b88324ed58d2ff6455a25c81b4f62eb1862b7ced03b52.png)\n\nIn the figure, $y$ is the distance between the boat and the bank and $x$ is the horizontal distance traveled by that boat after passing Peter. The quantity $y=10$ meters does not change with time because the boat is at a constant distance from the bank.\n\nWe wish to calculate $\\dfrac{\\textrm{d}\\theta}{\\textrm{d}t}.$\nTo do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{10}{x} \\\\ x & =10\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(10\\operatorname{cot}⁡\\theta ) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =(-10{\\csc }^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\dfrac{\\textrm d x}{\\textrm d t}=8$ and $\\theta = \\dfrac{\\pi}6.$ Substituting this into the above, we reach\n\n$$\n\\begin{aligned}8 & =(-10{\\csc }^{2}⁡\\left(\\frac{\\pi }{6}\\right))\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ -\\frac{4}{5} & ={\\csc }^{2}⁡\\left(\\frac{\\pi }{6}\\right)\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ -\\frac{4}{5} & ={(2)}^{2}\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ -\\frac{4}{5} & =4\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =-\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, the rate at which the angle $\\theta$ is decreasing is $\\dfrac{1}{5}$ radians per second."} {:db/id #edb/ref 17592186064129 :question/id #uuid "4ebd0289-b278-5352-b7bd-10ae218c43fb" :question/math-academy-id "e-735" :question/problem "Find the derivative of $y = \\tan{\\left(\\sin(x)\\right)}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny = \\tan u, \\qquad u = \\sin x.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = \\sec^2 u,\\qquad \\dfrac{\\textrm{d}u}{\\textrm d x} = \\cos x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={\\sec }^{2}⁡u\\cdot \\operatorname{cos}⁡x \\\\  & ={\\sec }^{2}⁡(\\operatorname{sin}⁡x)\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064136 :question/id #uuid "82a52178-7e95-554c-aedb-34e2f0336fa5" :question/math-academy-id "e-8341" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $$\n\\displaystyle \\int 8\\cosh t \\,\\textrm{d}t.\n$$" :question/worked-solution "Recall that\n\n$$\n\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}\n\\dfrac{\\textrm d}{\\textrm d t}(\\sinh t) = \\cosh{t} \\quad\\Rightarrow\\quad  \\int \\cosh{t} \\, \\textrm dt = \\sinh{t} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 8\\operatorname{cosh}⁡t\\,\\text{d}t=8\\int \\operatorname{cosh}⁡t\\,\\text{d}t=8\\operatorname{sinh}⁡t+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064137 :question/id #uuid "94c41155-d10a-55e6-8483-34750849a283" :question/math-academy-id "e-8342" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int \\left(-3\\operatorname{sech}  x \\tanh x\\right) \\,\\textrm{d}x =\n$$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{sech}  x) = -\\operatorname{sech} {x}\\tanh x \n\\quad\\Rightarrow\\quad  \n\\int \\operatorname{sech} {x}\\tanh{x} \\, \\textrm dx = -\\operatorname{sech} {x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-3\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x & =-3\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =-3(-\\operatorname{sech}⁡x)+C \\\\  & =3\\operatorname{sech}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064138 :question/id #uuid "ed338404-097d-55ca-8d99-18e421934afd" :question/math-academy-id "e-8343" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int 6\\operatorname{sech} ^2 x \\,\\textrm{d}x =\n$$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\tanh x) = \\operatorname{sech} ^2{x} \\quad\\Rightarrow\\quad  \\int \\operatorname{sech} ^2{x} \\, \\textrm dx = \\tanh{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 6{\\operatorname{sech} }^{2}⁡x\\,\\text{d}x=6\\int {\\operatorname{sech} }^{2}⁡x\\,\\text{d}x=6\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064139 :question/id #uuid "cdb3db67-7734-5828-8b55-2faa5aee8541" :question/math-academy-id "e-8344" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\displaystyle \\int (-8\\operatorname{csch} ^2 x )\\,\\textrm{d}x =\n$$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\coth x) = -\\operatorname{csch} ^2{x} \\quad\\Rightarrow\\quad  \\int \\operatorname{csch} ^2{x} \\, \\textrm dx = -\\coth{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8{\\operatorname{csch} }^{2}⁡x)\\,\\text{d}x & =-8\\int {\\operatorname{csch} }^{2}⁡x\\,\\text{d}x \\\\  & =-(-8\\operatorname{coth}⁡x)+C \\\\  & =8\\operatorname{coth}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46152cad-db26-5489-9885-4872107442fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\operatorname{arcsec} x+C" :db/id #edb/ref 17592186285429} {:answer/id #uuid "729aed06-b282-521d-acb9-4668cd5b0175" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (11x)+C" :db/id #edb/ref 17592186285842} {:answer/id #uuid "938eb1ee-7ab4-5c5a-9a1e-41f61385c5ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arccsc} (11x)+C" :db/id #edb/ref 17592186286131} {:answer/id #uuid "bacc3b3a-e948-590d-a0b3-c31bb9639de6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} x+C" :db/id #edb/ref 17592186286488} {:answer/id #uuid "cf0db5b1-a31d-566b-9b38-cd041089c3ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\operatorname{arccsc} x+C" :db/id #edb/ref 17592186286666}] :answer-field/correct {:db/id #edb/ref 17592186285429} :answer-field/id #uuid "01c584f0-c6ff-5109-ba98-24519ff2f970" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287140}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f5ca0aa8-06db-5c6f-bb07-38d950f613d0" :question/math-academy-id "q-19100" :question/problem "$$\n\\displaystyle \\int \\frac{11}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{arcsec} \\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{11}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =11\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =11\\operatorname{arcsec} x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baa4c6ed-0656-52a9-b84d-6c0586bbf1ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186061886} {:answer/id #uuid "ce9731c6-1cd0-51f2-951f-91af70d3b2f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186061887} {:answer/id #uuid "d41dcfb3-71c0-5308-ad84-d40f6585c83c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186061888} {:answer/id #uuid "0bb0f941-5f6e-52b5-9643-7b85a074122a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186061889} {:answer/id #uuid "17dc2606-aa3d-56e0-99c4-8ce2f7b9c915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186061890}] :answer-field/correct {:db/id #edb/ref 17592186061888} :answer-field/id #uuid "e4fb3bc1-1f84-543d-b0c9-f3618bab9b3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186061885}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5d5f2f26-ac35-577f-8f70-a5c17a0b97f4" :question/math-academy-id "q-24416" :question/problem "${\\log }_{4}⁡1=$" :question/worked-solution "We have the general rule that:\n\n$$\n{\\log }_{n}⁡1=0\n$$\n\nIn our case, $n=4.$ Therefore:\n\n$$\n{\\log }_{4}⁡1=0\n$$"} {:db/id #edb/ref 17592186064857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eef9722-f326-5995-94aa-696c6de0feb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431077} {:answer/id #uuid "ab45b025-5861-5024-8958-4ef3403a84cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431080} {:answer/id #uuid "c9711a7d-8c7c-54ef-b29c-11352c7fb2db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡x-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431087} {:answer/id #uuid "cb6108cc-2a4c-50ea-9d2d-80ef3ef54486" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{tan}⁡x-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431088} {:answer/id #uuid "f002d208-93d4-565e-847d-55497116f0c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cot}⁡x-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431094}] :answer-field/correct {:db/id #edb/ref 17592186431094} :answer-field/id #uuid "dd13680e-c437-5191-a0b8-f472cae34b1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063198}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4246a553-248d-558d-9e27-dac3cd88b439" :question/math-academy-id "q-49271" :question/problem "$$\n\\displaystyle \\int \\frac{1}{{\\cos }^{2}⁡x}({\\cot }^{2}⁡x+{\\cos }^{2}⁡x\\operatorname{sin}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "We multiply out the parentheses and then use the identity ${\\cot }^{2}⁡x=\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x},$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{{\\cos }^{2}⁡x}({\\cot }^{2}⁡x+{\\cos }^{2}⁡x\\operatorname{sin}⁡x)\\,\\text{d}x & =\\int (\\frac{1}{{\\cos }^{2}⁡x}\\cdot {\\cot }^{2}⁡x+\\frac{1}{{\\cos }^{2}⁡x}\\cdot {\\cos }^{2}⁡x\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int (\\frac{1}{{\\cos }^{2}⁡x}\\cdot \\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x}+\\frac{1}{{\\cos }^{2}⁡x}\\cdot {\\cos }^{2}⁡x\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int (\\frac{1}{{\\sin }^{2}⁡x}+\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int ({\\csc }^{2}⁡x+\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int {\\csc }^{2}⁡x\\,\\text{d}x+\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cot}⁡x-\\operatorname{cos}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3541e9d4-b110-5c63-a736-7fc7f4d31791" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186330422} {:answer/id #uuid "86df8515-e1e9-50e5-8ffa-c0f477c898b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331153} {:answer/id #uuid "9dec32d8-d9c0-5660-8378-5288983a6ac9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x+\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331364} {:answer/id #uuid "a3922fe0-a979-577b-8dba-fd55ff68e732" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x+\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331416} {:answer/id #uuid "f1373522-1826-5a96-a8aa-2b1480b28e0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186332069}] :answer-field/correct {:db/id #edb/ref 17592186331153} :answer-field/id #uuid "dc984231-74ce-5ee3-a0d9-26f2e71c9fc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332589}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c589cab7-d081-524b-ae47-ab787d74dcb4" :question/math-academy-id "q-49273" :question/problem "$$\n\\displaystyle \\int \\frac{{\\cos }^{3}⁡x+{\\cot }^{2}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x=\n$$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{\\cos }^{3}⁡x+{\\cot }^{2}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{\\cos }^{2}⁡x}({\\cos }^{3}⁡x+{\\cot }^{2}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${\\cot }^{2}⁡x=\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{\\cos }^{2}⁡x}({\\cos }^{3}⁡x+\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x})\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{\\cos }^{3}⁡x+{\\cot }^{2}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{\\cos }^{2}⁡x}({\\cos }^{3}⁡x+\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x})\\text{d}x \\\\  & =\\int (\\frac{1}{{\\cos }^{2}⁡x}\\cdot {\\cos }^{3}⁡x+\\frac{1}{{\\cos }^{2}⁡x}\\cdot \\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+\\frac{1}{{\\sin }^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+{\\csc }^{2}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16897289-4603-55b3-85a9-7a4e51b12fc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}\\operatorname{tan}⁡x\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186330138} {:answer/id #uuid "351bd75d-098f-5b2a-b526-a98d2a025590" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}{tan}^{2}⁡x{sec}^{2}⁡x+C" :db/id #edb/ref 17592186330419} {:answer/id #uuid "50b59dc3-9cc4-5d56-8dae-d5fde6823b0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}{tan}^{2}⁡x+C" :db/id #edb/ref 17592186330681} {:answer/id #uuid "9532f3f6-9b3e-5893-931d-79b72c8db1fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}{csc}^{2}⁡x+C" :db/id #edb/ref 17592186331272} {:answer/id #uuid "bc8968e8-f099-5f73-8828-0a36b59f6c6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331612}] :answer-field/correct {:db/id #edb/ref 17592186331612} :answer-field/id #uuid "6b7347c5-9c24-53ba-ae9d-867009e5aca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332398}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f71f24a-4751-5945-a98f-4a541dbf6232" :question/math-academy-id "q-49275" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{{\\tan }^{2}⁡x}{8{\\sin }^{2}⁡x}\\,\\text{d}x.\n$$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{\\tan }^{2}⁡x}{8{\\sin }^{2}⁡x}\\,\\text{d}x=\\frac{1}{8}\\int {\\tan }^{2}⁡x\\cdot \\frac{1}{{\\sin }^{2}⁡x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $$\n\\displaystyle \\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$ and $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{\\tan }^{2}⁡x}{8{\\sin }^{2}⁡x}\\,\\text{d}x & =\\frac{1}{8}\\int {\\tan }^{2}⁡x\\cdot \\frac{1}{{\\sin }^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int {\\left(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\right)}^{2}\\cdot \\frac{1}{{\\sin }^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int \\frac{{\\sin }^{2}⁡x}{{\\cos }^{2}⁡x}\\cdot \\frac{1}{{\\sin }^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int \\frac{1}{{\\cos }^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int {\\left(\\frac{1}{\\operatorname{cos}⁡x}\\right)}^{2}\\text{d}x \\\\  & =\\frac{1}{8}\\int {\\sec }^{2}⁡x\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e9e8cc-7e2c-5b9c-8895-6a0d01a94483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{3}^{x}}{ln⁡3}+C" :db/id #edb/ref 17592186333213} {:answer/id #uuid "2550874f-8ee9-5a21-ad79-124324b76991" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ln⁡({3}^{x})+C" :db/id #edb/ref 17592186333335} {:answer/id #uuid "602373f3-a4ef-5989-b10a-66c28e72546b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{x}ln⁡3+C" :db/id #edb/ref 17592186333867} {:answer/id #uuid "93360ddb-2f30-5402-b6bd-6562c3c2c6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{x}+C" :db/id #edb/ref 17592186334300} {:answer/id #uuid "94f01e4b-399e-55ad-bf45-f119b26a99ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡x}{ln⁡3}+C" :db/id #edb/ref 17592186334315}] :answer-field/correct {:db/id #edb/ref 17592186333213} :answer-field/id #uuid "fb7cb00b-1c03-5bd1-8af9-27f6fe69ec11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335676}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "709a586a-cd76-5969-9f50-4116711ad7ab" :question/math-academy-id "q-66139" :question/problem "Calculate $$\n\\displaystyle \\int {3}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {3}^{x}\\,\\text{d}x & =\\frac{{3}^{x}}{\\ln ⁡3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33cf2d14-d04d-51e3-b76e-64b8e1a665b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\text{arcsec}(8x)+C" :db/id #edb/ref 17592186333465} {:answer/id #uuid "3dc9dd34-b284-58b6-84db-345e4e630da9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(64x)+C" :db/id #edb/ref 17592186333571} {:answer/id #uuid "8f11fd04-9fa8-5d58-b9c9-6ab52adba008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(8x)+C" :db/id #edb/ref 17592186334264} {:answer/id #uuid "d2244dec-f6d2-5e94-8b71-32f7eabc6720" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(8x)}{8}+C" :db/id #edb/ref 17592186334825} {:answer/id #uuid "d66dc866-442a-59b0-ad6e-365d928672f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(4x)}{4}+C" :db/id #edb/ref 17592186334866}] :answer-field/correct {:db/id #edb/ref 17592186334264} :answer-field/id #uuid "ae92fcf7-e93b-597c-a9c2-a8feb16ae56b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335558}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c758c6a-6697-5dfb-b64a-bc653c6c226b" :question/math-academy-id "q-69476" :question/problem "$$\n\\displaystyle \\int \\frac{8\\,\\text{d}x}{|8x|\\sqrt{(8x)^{2}-1}}=\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{8\\,\\text{d}x}{|8x|\\sqrt{(8x)^{2}-1}}=8\\int \\frac{\\text{d}x}{|8x|\\sqrt{(8x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\operatorname{arcsec} ,$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\operatorname{arcsec} (u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $8x.$\n\nSo, let's substitute $u=8x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8\\,⟹\\,\\text{d}x=\\frac{1}{8}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}8\\int \\frac{1}{|8x|\\sqrt{(8x)^{2}-1}}\\text{d}x & =8\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{8}\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\operatorname{arcsec} u+C \\\\  & =\\operatorname{arcsec} (8x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c16993-bae3-52c0-92ad-275cbeb50cdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9\\operatorname{sin}⁡x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186336262} {:answer/id #uuid "2e93c5d7-0745-5a8c-a9b3-de22c4366a79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\operatorname{sin}⁡x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186336481} {:answer/id #uuid "61070e19-b4f6-5780-b52f-32136383a579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9{cos}^{2}⁡x" :db/id #edb/ref 17592186336909} {:answer/id #uuid "97d86c60-9434-5c84-85a6-a6f88a1b92d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\operatorname{sin}⁡x{cos}^{2}⁡x" :db/id #edb/ref 17592186337417} {:answer/id #uuid "a8a113ac-1f7d-54a3-aa47-90b10288ae2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337557}] :answer-field/correct {:db/id #edb/ref 17592186336481} :answer-field/id #uuid "2a78cc6f-1a98-5e11-9c07-21ff7e2374f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338355}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "270b54b6-fdc6-5a75-af7c-f8052eee38ff" :question/math-academy-id "q-72154" :question/problem "Find ${f}^{′}(x)$ when $f(x)=9{\\sin }^{2}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=9(\\operatorname{sin}⁡x)^{2}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=9{u}^{2},\\,u=\\operatorname{sin}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=18u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =18u\\cdot \\operatorname{cos}⁡x \\\\  & =18\\operatorname{sin}⁡x\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17153736-08a5-511b-8d66-3076de3a56f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\text{arcsec}(2x)+C" :db/id #edb/ref 17592186339331} {:answer/id #uuid "287af432-ac1d-5bb0-9cce-df095ab56481" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(2x)}{4}+C" :db/id #edb/ref 17592186339481} {:answer/id #uuid "3031610e-8402-5eae-b837-b04a952ccb28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\text{arcsec}(2x)+C" :db/id #edb/ref 17592186339548} {:answer/id #uuid "741561ed-033d-5aff-8ad7-766c99be57a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\,\\text{arcsec}(2x)+C" :db/id #edb/ref 17592186340158} {:answer/id #uuid "c8a5cb98-9b11-5ca7-8b96-437d604616ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{arcsec}(2x)}{2}+C" :db/id #edb/ref 17592186340906}] :answer-field/correct {:db/id #edb/ref 17592186339548} :answer-field/id #uuid "79900759-4114-5519-b212-5c813256836c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341594}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a6fafd98-c438-5a64-a87a-7a2d0a58fd7e" :question/math-academy-id "q-73717" :question/problem "$$\n\\displaystyle \\int \\frac{2}{|x|\\sqrt{4{x}^{2}-1}}\\,\\text{d}x=\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{2\\,\\text{d}x}{|x|\\sqrt{4{x}^{2}-1}}=4\\int \\frac{\\text{d}x}{|2x|\\sqrt{(2x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\operatorname{arcsec} ,$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\operatorname{arcsec} (u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $2x.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{|x|\\sqrt{4{x}^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x|\\sqrt{(2x)^{2}-1}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =2\\,\\operatorname{arcsec} \\,u+C \\\\  & =2\\,\\operatorname{arcsec} (2x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e4c1ce-4f9c-5bb7-ae3e-725c36b43eec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\pi \\operatorname{coth}⁡x+C" :db/id #edb/ref 17592186357765} {:answer/id #uuid "22b09c51-8766-5f26-aca8-a80acc80fcdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\pi \\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186358052} {:answer/id #uuid "77b6c9c7-ec92-5929-a251-3378f21e9213" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186358786} {:answer/id #uuid "c25e8c9e-befc-58e3-a8e4-e8ebd1c3143f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186359457} {:answer/id #uuid "dcddbbf9-ec28-5f89-9894-25fc0c9b26c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\operatorname{coth}⁡x+C" :db/id #edb/ref 17592186359693}] :answer-field/correct {:db/id #edb/ref 17592186359457} :answer-field/id #uuid "da331e09-5812-5d03-806f-1da0fe3178e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360378}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "500d6eed-a80c-58be-9749-913f1b16bec9" :question/math-academy-id "q-95257" :question/problem "$$\n\\int 2\\pi {\\operatorname{sech} }^{2}⁡x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={\\operatorname{sech} }^{2}⁡x\\,⇒\\,\\int {\\operatorname{sech} }^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 2\\pi {\\operatorname{sech} }^{2}⁡x\\,\\text{d}x & =2\\pi \\int {\\operatorname{sech} }^{2}⁡x\\,\\text{d}x \\\\  & =2\\pi \\operatorname{tanh}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0075baee-8162-536a-a1aa-424af9c1888c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186514872} {:answer/id #uuid "2246e344-4fce-54a4-b3ff-1285907e3b1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{coth}⁡x+C" :db/id #edb/ref 17592186514951} {:answer/id #uuid "4708a223-4b97-50f3-ae35-227f3d98f8b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{coth}⁡x+C" :db/id #edb/ref 17592186515023} {:answer/id #uuid "56c3407d-f5bf-5b83-98bb-b6f2afb56bbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{tanh}^{2}⁡x+C" :db/id #edb/ref 17592186515066} {:answer/id #uuid "8b636f38-63a2-5cc3-a702-a1c9d0a01952" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186515164}] :answer-field/correct {:db/id #edb/ref 17592186514951} :answer-field/id #uuid "48e58b7f-0e47-51aa-9681-5a195c1670e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063881}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fae7c1d5-448a-5919-983f-8d5f0479e16d" :question/math-academy-id "q-95260" :question/problem "$$\n\\int 4{\\operatorname{csch} }^{2}⁡x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{\\operatorname{csch} }^{2}⁡x\\,⇒\\,\\int {\\operatorname{csch} }^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 4{\\operatorname{csch} }^{2}⁡x\\,\\text{d}x & =4\\int {\\operatorname{csch} }^{2}⁡x\\,\\text{d}x \\\\  & =-4\\operatorname{coth}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef4b406-1c2c-5f52-a1f0-b52478a2d78a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186358170} {:answer/id #uuid "4df6a0d4-af15-5aeb-90ce-f321161abc45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{coth}⁡x-\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186358424} {:answer/id #uuid "d8b82f02-66bd-50a8-be33-d7982251f1d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{coth}⁡x-\\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186359651} {:answer/id #uuid "dd9281c5-8f66-51c7-bf40-ac8ffac71123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186359701} {:answer/id #uuid "e559d785-c7d0-5939-9e3c-b7f12b3ad8ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186359785}] :answer-field/correct {:db/id #edb/ref 17592186358170} :answer-field/id #uuid "ea3b13f8-492a-5948-9a64-cda1a28f24ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360415}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c3aed1bc-a85e-5da0-b40e-ec9bcf1402df" :question/math-academy-id "q-96057" :question/problem "$$\n\\displaystyle \\int (5{\\operatorname{csch} }^{2}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x & \\,⇒\\,\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x=-\\operatorname{sech}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{\\operatorname{csch} }^{2}⁡x & \\,⇒\\,\\int {\\operatorname{csch} }^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (5{\\operatorname{csch} }^{2}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x & =5\\int {\\operatorname{csch} }^{2}⁡x\\,\\text{d}x-\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =5(-\\operatorname{coth}⁡x)-(-\\operatorname{sech}⁡x)+C \\\\  & =-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186065381 :tutorial/content "In this lesson, we learned how to use substitution to evaluate integrals that give rise to inverse trigonometric functions.\n\nAlthough you can always solve these integrals by going through the substitution process, it is convenient to remember the following key results:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{1-(ax)^{2}}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arcsin}⁡(ax)+C \\\\ \\int \\frac{1}{\\sqrt{{a}^{2}-{x}^{2}}}\\,\\text{d}x & =\\operatorname{arcsin}⁡\\left(\\frac{x}{a}\\right)+C \\\\ \\int \\frac{1}{1+(ax)^{2}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arctan}⁡(ax)+C \\\\ \\int \\frac{1}{{a}^{2}+{x}^{2}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arctan}⁡\\left(\\frac{x}{a}\\right)+C \\\\ \\int \\frac{1}{|ax|\\sqrt{(ax)^{2}-1}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arcsec} (ax)+C\\end{aligned}\n$$\n\nTo remember the results above, note the following:\n\n- Whenever the integrand has an $ax$ term, the argument of the resulting inverse trigonometric function is $ax.$\n\n- Otherwise, if the $a$ and $x$ are separated, then the argument of the resulting inverse trigonometric function is $\\dfrac{x}{a}.$\n\n- All the results are multiplied by $\\dfrac{1}{a},$ except for $\\arcsin \\left( \\dfrac{x}{a} \\right) + C.$" :tutorial/id #uuid "02539765-4345-5409-87f9-9901a59b7ebf" :tutorial/math-academy-id 4800 :tutorial/title "Summary of Key Results"} {:db/id #edb/ref 17592186065390 :tutorial/content "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nWe know that the derivative of the hyperbolic sine is the hyperbolic cosine:\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\sinh{x}) = \\cosh{x}\n$$\n\nSince integration is the reverse of differentiation, we have\n\n$$\n\\int \\cosh{x}\\,\\textrm d x = \\sinh{x} + C.\n$$\n\nSimilarly, by considering the derivative of the hyperbolic cosine, we have\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\cosh x) = \\sinh{x} \\qquad\\Rightarrow\\qquad \\int \\sinh x\\  \\textrm{d}x = \\cosh x + C.\n$$" :tutorial/id #uuid "d780519f-20fa-5840-be56-4a5f0539ed6e" :tutorial/math-academy-id 5211 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186065392 :tutorial/content "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nBy considering the derivatives of the hyperbolic tangent, secant, cosecant, and cotangent, we arrive at the following results:\n\n$$\n\\begin{aligned}\\int {\\operatorname{sech} }^{2}⁡x\\text{ }\\text{d}x & =\\operatorname{tanh}⁡x+C \\\\ \\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\text{ }\\text{d}x & =-\\operatorname{sech}⁡x+C \\\\ \\int \\operatorname{csch}⁡x\\operatorname{coth}⁡x\\text{ }\\text{d}x & =-\\operatorname{csch}⁡x+C \\\\ \\int {\\operatorname{csch} }^{2}⁡x\\text{ }\\text{d}x & =-\\operatorname{coth}⁡x+C\\end{aligned}\n$$" :tutorial/id #uuid "9e3a8b50-3176-54c9-a9a3-e21f958ab6b2" :tutorial/math-academy-id 5371 :tutorial/title "Integration Using Reciprocal Hyperbolic Functions"} {:db/id #edb/ref 17592186065409 :tutorial/content "We know that the derivative of sine is cosine:\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\sin{x}) = \\cos{x}\n$$\n\nSince integration is the reverse of differentiation, we see that the integral of cosine is sine:\n\n$$\n\\int \\cos{x}\\,\\textrm d x = \\sin{x} + C\n$$\n\nWe can discover two other integrals by considering the derivatives of cosine and tangent:\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡x\\text{ }\\text{d}x & =-\\operatorname{cos}⁡x+C \\\\ \\int {\\sec }^{2}⁡x\\text{ }\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nSimilarly, by considering the derivatives of secant, cosecant, and cotangent, we arrive at\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\text{ }\\text{d}x & =\\operatorname{sec}⁡x+C \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\text{ }\\text{d}x & =-\\operatorname{csc}⁡x+C \\\\ \\int {\\csc }^{2}⁡x\\text{ }\\text{d}x & =-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$\n\nWith these six formulas, we can integrate many different trigonometric functions." :tutorial/id #uuid "bfa0c70d-6cf7-5c69-8995-d9f6c980a4ba" :tutorial/math-academy-id 718 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186065410 :tutorial/content "Recall the following derivatives of the inverse trigonometric functions:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}x) & =\\frac{1}{\\sqrt{1-{x}^{2}}} \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}x) & =\\frac{1}{1+{x}^{2}} \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsec} \\,x) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\end{aligned}\n$$\n\nSince integration is the opposite of differentiation, we arrive at the following results:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\text{d}x & =\\operatorname{arcsin}(x)+C \\\\ \\int \\frac{1}{1+{x}^{2}}\\text{d}x & =\\operatorname{arctan}(x)+C \\\\ \\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\text{d}x & =\\operatorname{arcsec} (x)+C\\end{aligned}\n$$" :tutorial/id #uuid "a238ada9-9756-56cd-992d-a26ce54ab913" :tutorial/math-academy-id 723 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186065435 :tutorial/content "Suppose we want to calculate the integral\n\n$$\n\\displaystyle \\int\\dfrac{1}{\\sin^2x}\\,\\textrm d x.\n$$\n\nAt first glance, this looks kind of tricky. However, if we use the identity $\\dfrac{1}{\\sin x} = \\csc x,$ we can rewrite the integral as\n\n$$\n\\begin{aligned}\\int \\frac{1}{{\\sin }^{2}⁡x}\\,\\text{d}x &=\\int {\\left(\\frac{1}{\\operatorname{sin}⁡x}\\right)}^{2}\\,\\text{d}x=\\int {\\csc }^{2}⁡x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we see that this is just a standard trigonometric integral:\n\n$$\n\\int\\dfrac{1}{\\sin^2x}\\,\\textrm d x  =  \\int\\csc^2 x\\,\\textrm d x =-\\cot x + C\n$$\n\nWhen confronted with a tricky-looking trigonometric integral, we can often reduce it to a standard integral using a trigonometric identity." :tutorial/id #uuid "d2dcb6a2-e8f7-5bb7-9450-e0b65532681a" :tutorial/math-academy-id 867 :tutorial/title "Introduction"} {:answer/id #uuid "9c8edcdc-8f1c-51c2-bbb5-0e9493ab87c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{arcsec} (x + 3) + C" :db/id #edb/ref 17592186066869} {:answer/id #uuid "b6844ac0-a966-53fc-be83-d306677a8eb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (x - 2) + C" :db/id #edb/ref 17592186066870} {:answer/id #uuid "fa2b0b46-a229-5aff-94f5-75873e2dcacb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (x + 2) + C" :db/id #edb/ref 17592186066871} {:answer/id #uuid "1f2b6cc8-ec18-57b5-b67e-f5bf938fc06b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}\\operatorname{arcsec} (2x - 4) + C" :db/id #edb/ref 17592186066872} {:answer/id #uuid "30330287-bf74-50f2-bc68-0fbb07832428" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} \\left(\\frac{x - 2}{2}\\right) + C" :db/id #edb/ref 17592186066873} {:answer/id #uuid "00709870-7f4c-5356-80cf-211ddd517d75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} \\left(\\frac{x + 5}{4}\\right) + C" :db/id #edb/ref 17592186067457} {:answer/id #uuid "08706584-6769-5f22-b6e5-308bfc2b331f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}\\operatorname{arcsec} (x + 1) + C" :db/id #edb/ref 17592186067458} {:answer/id #uuid "10539117-6887-5312-98eb-ea55255b06d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arcsec} (x + 5) + C" :db/id #edb/ref 17592186067459} {:answer/id #uuid "4e582638-1a45-5e4d-9977-3694cc0bc819" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arcsec} \\left(\\frac{x}{5}\\right) + C" :db/id #edb/ref 17592186067460} {:answer/id #uuid "7dc24e3b-ad25-5d1c-bb6c-6e85ec57a5ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{arcsec} (x + 4) + C" :db/id #edb/ref 17592186067461} {:db/id #edb/ref 17592186068506 :question/id #uuid "4e0188f0-4d2b-5f3c-b1bd-12270e3adc0f" :question/math-academy-id "e-14576" :question/problem "Evaluate the integral $$\n\\displaystyle{\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x}.\n$$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}\n    x^2-2x&= x^2 -2x +(1-1)\\\\[3pt]\n              &= (x^2 -2x +1)-1\\\\[3pt]\n         &= (x-1)^2-1\n         \n  \\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x \n= \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{(x-1)^2-1}}\\, \\textrm{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^2-1}} \\, \\textrm{d}u = \\operatorname{arcsec}  \\, u +C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-1$.\n\nSo, let's perform the substitution\n\n$$\nu=x-1.\n$$\n\n \nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$1+\\dfrac{2}{\\sqrt{3}}$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$u$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{\\sqrt{3}}$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n</tbody></table></div>\n\n\nTherefore,\n\n$$\n\\begin{aligned}\n    \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x \n&=  \\int_{1+2/\\sqrt{3}}^{3}\\dfrac{1}{|x-1|\\sqrt{(x-1)^2-1}}\\,\\textrm{d}x \\\\[5pt]\n&=\\int_{2/\\sqrt{3}}^{2} \\dfrac{1}{|u|\\sqrt{u^2-1}}\\, \\textrm{d}u\\\\[5pt]\n&=  \\operatorname{arcsec} \\, {u}\\Big|_{2/\\sqrt{3}}^{2}\\\\[5pt]\n&= \\operatorname{arcsec}  \\left(2\\right)  - \\operatorname{arcsec} \\left(\\dfrac{2}{\\sqrt{3}} \\right)\\\\[5pt]\n&=\\left(\\dfrac{\\pi}{3}-\\dfrac{\\pi}{6}\\right)\\\\[5pt]\n&=\\dfrac{\\pi}{6}.\n\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186068569 :question/id #uuid "234c7a86-037c-5316-9419-14db90d1da60" :question/math-academy-id "e-466" :question/problem "Calculate $$\n\\displaystyle \\int x^2 \\sec^2\\left(x^3-\\dfrac{\\pi}{6}\\right)\\,\\textrm d x.\n$$" :question/worked-solution "Let $u = x^3 - \\dfrac{\\pi}{6}.$ Differentiating, we have\n\n$$\n\\dfrac{\\textrm{d} u}{\\textrm{d}x } = 3x^2 \\quad\\Longrightarrow\\quad \\dfrac 1 3 \\textrm d u = x^2\\,\\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {x}^{2}{\\sec }^{2}⁡({x}^{3}-\\frac{\\pi }{6})\\,\\text{d}x & =\\int {\\sec }^{2}⁡({x}^{3}-\\frac{\\pi }{6})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int {\\sec }^{2}⁡(u)\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {\\sec }^{2}⁡(u)\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{tan}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{tan}⁡({x}^{3}-\\frac{\\pi }{6})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186068570 :question/id #uuid "03e461a3-0fe0-5fb5-813e-ae23a5dc606a" :question/math-academy-id "e-467" :question/problem "Evaluate the integral $$\n\\displaystyle \\int_0^{\\pi/4} \\dfrac{\\tan x \\sec^2 x}{1+\\tan^2x}\\,\\textrm d x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(1+\\tan^2 x) = 2\\tan{x}\\sec^2 x.\n$$\n\nSo, let $u = 1+\\tan^2 x.$ Differentiating, we have\n\n$$\n\\dfrac{\\textrm{d} u}{\\textrm{d}x } = 2\\tan x\\sec^2 x \\quad\\Longrightarrow\\quad \\dfrac 1 2 \\textrm d u = \\tan x\\sec^2 x\\,\\textrm d x.\n$$\n\nCalculating the limits for $u$ gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$\\pi/4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$u$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n</tbody></table></div>\n\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{\\operatorname{tan}⁡x{\\sec }^{2}⁡x}{1+{\\tan }^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\frac{1}{1+{\\tan }^{2}⁡x}\\cdot \\operatorname{tan}⁡x{\\sec }^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186068580 :question/id #uuid "5b83575b-9674-5dc5-b3eb-a918f145be93" :question/math-academy-id "e-497" :question/problem "Calculate $$\n\\displaystyle \\int \\dfrac{\\ln^2{x}}{x} \\textrm{d}x\n$$ using integration by parts." :question/worked-solution "First, we let\n\n$$\nI = \\int \\dfrac{\\ln^2 x}{x} \\, \\textrm{d}x.\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={\\ln }^{2}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x} & \\,⇒\\,v=\\int \\frac{1}{x}\\text{d}x=\\operatorname{ln}⁡x\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{\\ln }^{2}⁡x}{x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({\\ln }^{2}⁡x)(\\operatorname{ln}⁡x)-\\int (\\operatorname{ln}⁡x)\\left(\\frac{2\\operatorname{ln}⁡x}{x}\\right)\\text{d}x \\\\  & ={\\ln }^{3}⁡x-2\\int \\frac{{\\ln }^{2}⁡x}{x}\\,\\text{d}x \\\\  & ={\\ln }^{3}⁡x-2I.\\end{aligned}\n$$\n\nFinally, we solve for $I,$ remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}I & ={\\ln }^{3}⁡x-2I \\\\ 3I & ={\\ln }^{3}⁡x \\\\ I & =\\frac{{\\ln }^{3}⁡x}{3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186068622 :question/id #uuid "68d38626-1153-51ec-a3c6-d39c927fdd99" :question/math-academy-id "e-600" :question/problem "A curve is defined by the parametric equations \n\n$$\nx =  \\sin(2t), \\qquad y= 2\\cos (2t) \\qquad 0 \\leq t \\lt \\pi.\n$$\n\nGiven that $\\dfrac{\\textrm d y}{\\textrm d x} = -2 \\tan(2t),$ calculate $\\dfrac{\\textrm d^2 y}{\\textrm d x^2}$ at the point where $t=\\dfrac\\pi 8.$" :question/worked-solution "To compute $\\dfrac{\\textrm d^2 y }{\\textrm d x^2},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}\\left(\\frac{dy}{dx}\\right)}{\\left(\\frac{dx}{dt}\\right)}.\\end{aligned}\n$$\n\nWe're given that $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}= -2 \\tan(2t),$ and we can calculate $\\dfrac{\\mathrm dx}{\\mathrm dt}$ as follows:\n\n$$\n\\dfrac{\\mathrm dx}{\\mathrm dt} = \\dfrac{\\mathrm d}{\\mathrm dt} ( \\sin 2t ) = 2 \\cos(2t).\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(-2\\operatorname{tan}⁡2t)}{2\\operatorname{cos}⁡(2t)} \\\\  & =\\frac{-4{\\sec }^{2}⁡(2t)}{2\\operatorname{cos}⁡(2t)} \\\\  & =-4{\\sec }^{2}⁡(2t)\\cdot \\frac{1}{2}\\operatorname{sec}⁡(2t) \\\\  & =-2{\\sec }^{3}⁡(2t).\\end{aligned}\n$$\n\nFinally, we evaluate at $t=\\dfrac{\\pi}{8},$ and we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}{|}_{t=\\pi /8} & =-2{\\sec }^{3}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =-2{\\sec }^{3}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =-2{(\\sqrt{2})}^{3} \\\\  & =-4\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a9ba381-dfc6-54d8-b261-945875616b86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186266662} {:answer/id #uuid "9828aecd-8ee6-528b-84cd-c4bcd17317b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}\\operatorname{sec}⁡({x}^{3})+C" :db/id #edb/ref 17592186267508} {:answer/id #uuid "c2c830ad-dfcc-5ddf-a4bf-a03b19a9f887" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186267881} {:answer/id #uuid "f14834f1-3a8c-5e06-be70-0657e9f80ea7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186268290} {:answer/id #uuid "fe106718-50d2-53cd-a30d-c21520e167e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186268381}] :answer-field/correct {:db/id #edb/ref 17592186268381} :answer-field/id #uuid "19c18458-8765-5ccd-8e3b-95cdb8f39a5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268448}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1978088-009a-552d-a613-5fc9a66c590e" :question/math-academy-id "q-13474" :question/problem "$$\n\\displaystyle \\int 4{x}^{2}{\\sec }^{2}⁡({x}^{3})\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={x}^{3}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 4{x}^{2}{\\sec }^{2}⁡({x}^{3})\\,\\text{d}x & =4\\int {\\sec }^{2}⁡({x}^{3})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =4\\int {\\sec }^{2}⁡(u)\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{4}{3}\\int {\\sec }^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{4}{3}\\operatorname{tan}⁡u+C \\\\  & =\\frac{4}{3}\\operatorname{tan}⁡({x}^{3})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3aa958-bc48-54b0-a782-1a49bad9967f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186516512}] :answer-field/correct {:db/id #edb/ref 17592186516512} :answer-field/id #uuid "439b77bc-4301-5739-aa18-4a33b0088491" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186066342}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e32f2a81-d301-5b15-8a48-dc736c374d85" :question/math-academy-id "q-252598" :question/problem "If the equation ${\\log }_{25}⁡5=\\frac{1}{2}$ is equivalent to $\\sqrt{b}=5,$  then $b=${{field-1}}." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${\\log }_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${\\log }_{25}⁡5=\\frac{1}{2}$ with ${\\log }_{b}⁡a=x,$ we get $a=5,$ $b=25,$ and $x=\\frac{1}{2}.$\n\nTherefore, the given equation is equivalent to ${25}^{1/2}=5,$ which is also equivalent to $\\sqrt{25}=5.$ Consequently, $b=25.$"} {:db/id #edb/ref 17592186069262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb84938b-4e85-52ad-bd29-6493a85415ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2x^{2}}(\\ln (x) + \\ln (x) + 2) + C" :db/id #edb/ref 17592186066743} {:answer/id #uuid "4c631bea-6fbf-571f-a223-68b06cf6efd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2x^{2}}(2\\ln (x) + 2x + 1) + C" :db/id #edb/ref 17592186066744} {:answer/id #uuid "7121bd29-f8e0-5390-af8a-61942f7f1d9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4x^{2}}(2\\ln^{2} (x) + 2\\ln (x) + 1) + C" :db/id #edb/ref 17592186066745} {:answer/id #uuid "783b8264-0c1f-5b95-a989-efc67d9cee3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4x^{2}}(2\\ln^{2} (x) - 2x\\ln (x) - 1) + C" :db/id #edb/ref 17592186066746} {:answer/id #uuid "7c175ddc-5a30-554c-a959-fd0d2ab57583" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\ln (x))/(4x^{2})(4\\ln (x) + 2x - 1) + C" :db/id #edb/ref 17592186066747}] :answer-field/id #uuid "524578ee-6e6e-58c9-9a66-2e748e474ad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186066742} {:answer-field/choices [{:answer/id #uuid "f93bb800-dc42-5668-91b5-920a928aa57c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2{x}^{2}}(\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(x)+2)+C" :db/id #edb/ref 17592186377322} {:answer/id #uuid "11358afa-0e6f-5a2c-ac00-bac5ee0d2324" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4{x}^{2}}(2{ln}^{2}⁡(x)-2x\\operatorname{ln}⁡(x)-1)+C" :db/id #edb/ref 17592186377323} {:answer/id #uuid "8700b438-ddae-5f4f-9b2f-8578bc8c450e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2{x}^{2}}(2\\operatorname{ln}⁡(x)+2x+1)+C" :db/id #edb/ref 17592186377324} {:answer/id #uuid "06a6cfac-e003-591c-93ea-d82ce1a4d5dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4{x}^{2}}(2{ln}^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C" :db/id #edb/ref 17592186377325} {:answer/id #uuid "3f20800c-2e9e-54bc-b586-4b25aa538d0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡(x)}{4{x}^{2}}(4\\operatorname{ln}⁡(x)+2x-1)+C" :db/id #edb/ref 17592186377326}] :answer-field/correct {:db/id #edb/ref 17592186377325} :answer-field/id #uuid "4f4ccc09-3130-56b3-a2bb-f52755a0fe14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186377321}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6c2769dd-8773-5498-9a3b-b2fed58e581f" :question/math-academy-id "q-3400" :question/problem "$$\n\\displaystyle \\int \\frac{{\\ln }^{2}⁡x}{{x}^{3}}\\,\\text{d}x=\n$$" :question/worked-solution "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={\\ln }^{2}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(x)}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\ln }^{2}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({\\ln }^{2}⁡(x))\\left(-\\frac{1}{2{x}^{2}}\\right)-\\int \\left(-\\frac{1}{2{x}^{2}}\\right)\\left(\\frac{2\\operatorname{ln}⁡(x)}{x}\\right)\\,\\text{d}x \\\\  & =-\\frac{{\\ln }^{2}⁡(x)}{2{x}^{2}}+\\int \\frac{\\operatorname{ln}⁡(x)}{{x}^{3}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int \\frac{\\operatorname{ln}⁡(x)}{{x}^{3}}\\text{d}x.\n$$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡(x))\\left(-\\frac{1}{2{x}^{2}}\\right)-\\int \\left(-\\frac{1}{2{x}^{2}}\\right)\\left(\\frac{1}{x}\\right)\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}+\\frac{1}{2}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int \\frac{{\\ln }^{2}⁡x}{{x}^{3}}\\,\\text{d}x & =-\\frac{{\\ln }^{2}⁡(x)}{2{x}^{2}}+(-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C) \\\\  & =-\\frac{{\\ln }^{2}⁡(x)}{2{x}^{2}}-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C \\\\  & =-\\frac{1}{4{x}^{2}}(2{\\ln }^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8493e63b-e686-55a1-be24-8c7387ac529a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186067577} {:answer/id #uuid "b510294a-158b-59cf-9325-faaa6db5c999" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186067579} {:answer/id #uuid "b70392a5-b997-5c61-a383-809b3402a781" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186067580} {:answer/id #uuid "547cd2d2-426a-5ed4-ba68-b0d437d86899" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186067581} {:answer/id #uuid "1c227681-1e75-580c-a1f0-afa6524eba89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e-1" :db/id #edb/ref 17592186547373}] :answer-field/correct {:db/id #edb/ref 17592186067579} :answer-field/id #uuid "2656a382-672f-58cb-ac31-49e3432a71cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d20f7fe1-3115-57de-8eab-3a56c473cbe5" :question/math-academy-id "q-49976" :question/problem "Evaluate $$\n\\displaystyle {\\int }_{1}^{e}\\frac{{\\ln }^{3}⁡z}{z}\\,\\text{d}z\n$$ using integration by parts." :question/worked-solution "Let's denote the indefinite integral by $$\n\\displaystyle I=\\int \\frac{{\\ln }^{3}⁡z}{z}\\,\\text{d}z.\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={\\ln }^{3}⁡z\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}z}=\\frac{3{\\ln }^{2}⁡z}{z}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}z}=\\frac{1}{z}\\, & ⇒\\,v=\\int \\frac{1}{z}\\,\\text{d}z=\\operatorname{ln}⁡z.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{\\ln }^{3}⁡z}{z}\\,\\text{d}z \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}z}\\,\\text{d}z \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}z}\\,\\text{d}z \\\\  & ={\\ln }^{3}⁡z(\\operatorname{ln}⁡z)-\\int (\\operatorname{ln}⁡z)\\left(\\frac{3{\\ln }^{2}⁡z}{z}\\right)\\,\\text{d}z \\\\  & ={\\ln }^{4}⁡z-3\\int \\frac{{\\ln }^{3}⁡z}{z}\\,\\text{d}x \\\\  & ={\\ln }^{4}⁡z-3I.\\end{aligned}\n$$\n\nNow, we solve for $I.$ We can ignore the constant of integration in this case, because it is insignificant for further evaluation of the definite integral.\n\n$$\n\\begin{aligned}I & ={\\ln }^{4}⁡z-3I \\\\ 4I & ={\\ln }^{4}⁡z \\\\ I & =\\frac{{\\ln }^{4}⁡z}{4}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{{\\ln }^{3}⁡z}{z}\\,\\text{d}z & =\\frac{1}{4}({\\ln }^{4}⁡z){|}_{1}^{e} \\\\  & =\\frac{1}{4}({\\ln }^{4}⁡(e)-{\\ln }^{4}⁡(1)) \\\\  & =\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ded48646-180c-5b0b-a6e9-fca073f5a695" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186067645} {:answer/id #uuid "0f6a5f44-7c10-57f2-8e95-6bb68e1b82b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427576} {:answer/id #uuid "2331cd21-2ed1-5625-a66c-71e5cb90700e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{1}{2},\\,2⟩" :db/id #edb/ref 17592186427578} {:answer/id #uuid "4ac18ed6-58a3-5417-b730-cedc5302f322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,\\,2⟩" :db/id #edb/ref 17592186427580} {:answer/id #uuid "a96be7b9-8d6b-519e-93fb-b0e6acf1e4a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427584}] :answer-field/correct {:db/id #edb/ref 17592186427584} :answer-field/id #uuid "2aea7a53-b7bf-5584-8696-8766da29f419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067642}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2dc454b1-c8a7-57a0-a955-d54808121033" :question/math-academy-id "q-50359" :question/problem "Given that $r(t)=⟨{\\cos }^{2}⁡t,\\,{\\sin }^{2}⁡t⟩,$ calculate $r\\left(\\frac{\\pi }{4}\\right).$" :question/worked-solution "We substitute $t=\\frac{\\pi }{4}$ into our function, and we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{4}\\right) & =⟨{\\cos }^{2}⁡\\left(\\frac{\\pi }{4}\\right),\\,{\\sin }^{2}⁡\\left(\\frac{\\pi }{4}\\right)⟩ \\\\  & =⟨{\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2},\\,{\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2}⟩ \\\\  & =⟨\\frac{1}{2},\\,\\frac{1}{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc57df2e-a9e1-5597-8c96-67142bcba8ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186068033} {:answer/id #uuid "fd013c82-9f8e-5dc8-90a2-6df6eafbdb0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186068034} {:answer/id #uuid "1e56c10e-8e6c-5bd8-b662-a1f587ffaa32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186068035} {:answer/id #uuid "6f1dc5f5-88de-5a6d-bab2-82e21ffb09ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186068036} {:answer/id #uuid "78bed3c5-f6cd-5f4c-9007-067d7f3405af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186068037}] :answer-field/correct {:db/id #edb/ref 17592186068034} :answer-field/id #uuid "28cab92d-a9f7-5598-9171-3ac640fd4cec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186068032}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b5aa8fd4-f7ec-5fc2-9e44-57ad3643264d" :question/math-academy-id "q-66511" :question/problem "The equation ${\\log }_{5}⁡5=1$ is equivalent to ${b}^{1}=5.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${\\log }_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${\\log }_{5}⁡5=1$ with ${\\log }_{b}⁡a=x,$ we get $a=5,$ $b=5,$ and $x=1.$\n\nTherefore, the given equation is equivalent to ${5}^{1}=5.$ Consequently, $b=5.$"} {:db/id #edb/ref 17592186070032 :tutorial/content "In some cases, applying integration by parts can lead to a cyclic pattern, where the original integral reappears after a few steps. This cyclic behavior allows us to solve the integral by forming an equation that can be solved algebraically.\n\nTo illustrate, let's consider the following example:\n\n$$\nI = \\int \\dfrac{\\ln x}{x} \\textrm{d}x\n$$\n\nLet's try using the method of integration by parts. We suppose that\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x} & \\,⇒\\,v=\\int \\frac{1}{x}\\text{d}x=\\operatorname{ln}⁡x\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\operatorname{ln}⁡x)-\\int (\\operatorname{ln}⁡x)\\left(\\frac{1}{x}\\right)\\text{d}x \\\\  & ={\\ln }^{2}⁡x-\\int \\frac{\\operatorname{ln}⁡x}{x}\\text{d}x \\\\  & ={\\ln }^{2}⁡x-I\\,.\\end{aligned}\n$$\n\nWe now have the same integral $I$ on both sides of the equality. Thinking about $I$ as some unknown variable, we can easily solve this equation:\n\n$$\n\\begin{aligned}I & ={\\ln }^{2}⁡x-I \\\\ I+I & ={\\ln }^{2}⁡x \\\\ 2I & ={\\ln }^{2}⁡x \\\\ I & =\\frac{{\\ln }^{2}⁡x}{2}+C\\,.\\end{aligned}\n$$\n\nNotice that we added a constant of integration right at the very end of the calculation." :tutorial/id #uuid "eac7b2d2-bdab-56e5-bb03-00e69bb0caf6" :tutorial/math-academy-id 904 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186078225 :question/id #uuid "b19955e9-3e5d-597e-81bc-f8f675e78e9b" :question/math-academy-id "e-265" :question/problem "Given that the function\n$$\ng(x) =\n{\\left\\{  \\begin{array}{ll}{\\log }_{2}  ( a x + 1 ) , & 0 \\le  x \\le  1 \\\\ {\\log }_{3}  ( 2 x + 1 ) , & x > 1\\end{array} \\right. }\n$$ \nis continuous at $x=1$, find the value of $a.$" :question/worked-solution "At $x=1,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}g(x) & =\\lim_{x\\to {1}^{-}}{\\log }_{2}⁡(ax+1) \\\\  & ={\\log }_{2}⁡(a(1)+1) \\\\  & ={\\log }_{2}⁡(a+1),\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}g(x) & =\\lim_{x\\to {1}^{+}}({\\log }_{3}⁡(2x+1)) \\\\  & ={\\log }_{3}⁡(2(1)+1) \\\\  & ={\\log }_{3}⁡(3) \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=1,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}g(x) & =\\lim_{x\\to {1}^{+}}g(x) \\\\ {\\log }_{2}⁡(a+1) & =1 \\\\ a+1 & ={2}^{1} \\\\ a & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186078329 :question/id #uuid "e7ff1089-5799-5654-8e78-5c801a676aa1" :question/math-academy-id "e-6167" :question/problem "Evaluate $$\n\\displaystyle \\lim_{\\theta \\to 0}\\: \\dfrac{\\theta \\cot \\theta}{4 \\cos^2 \\theta}.\n$$" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{cot}⁡\\theta }{4{\\cos }^{2}⁡\\theta } & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{4{\\cos }^{2}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta ) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{4{\\cos }^{2}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{4\\operatorname{cos}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{4\\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\: \\dfrac{\\theta}{\\sin\\theta} = \\dfrac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1}{(\\lim_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta })} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n\\lim_{\\theta \\to 0} \\:\\dfrac{1}{4 \\cos \\theta} = \\dfrac{1}{4\\cos 0} = \\dfrac14.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{4\\operatorname{cos}⁡\\theta } & =1\\cdot \\frac{1}{4}=\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186078956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4aede1-3786-5970-9b8c-f50380dd1c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186327055} {:answer/id #uuid "33fc45f8-9d63-57cb-b8d4-838ff4ecc832" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{2}-1" :db/id #edb/ref 17592186327385} {:answer/id #uuid "39ce0c62-737f-59df-abb7-bff934bb470f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186327439} {:answer/id #uuid "5d1aa65a-a26d-5ed6-9e33-63bcf3bc951b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186327755} {:answer/id #uuid "e92a81c0-acc9-5cf4-b6b1-22557dac773d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{2}" :db/id #edb/ref 17592186328975}] :answer-field/correct {:db/id #edb/ref 17592186327055} :answer-field/id #uuid "30f22838-8791-513e-97df-fad00c144144" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329274}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ee6d25b7-0717-51a6-88fe-073d54984a61" :question/math-academy-id "q-4718" :question/problem "Find ${F}^{′}(0)$ if $$\n\\displaystyle F(x)={\\int }_{x}^{\\operatorname{sin}⁡(x)}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t.\n$$" :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals, and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\operatorname{sin}⁡(x)}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t & ={\\int }_{x}^{a}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{sin}⁡(x)}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{sin}⁡(x)}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\operatorname{sin}⁡x.$\n\nThe integrand $\\sqrt[3]{1+{t}^{2}}$ is continuous for all $t,$ so applying FTC II gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{sin}⁡(x)}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{sin}⁡x}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t) \\\\  & =-\\sqrt[3]{1+{x}^{2}}+\\frac{\\text{du}}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}\\sqrt[3]{1+{t}^{2}}\\,\\text{d}t) \\\\  & =-\\sqrt[3]{1+{x}^{2}}+(\\operatorname{cos}⁡(x))\\sqrt[3]{1+{u}^{2}} \\\\  & =\\operatorname{cos}⁡(x)\\sqrt[3]{1+(\\operatorname{sin}⁡(x))^{2}}-\\sqrt[3]{1+{x}^{2}} \\\\  & =\\operatorname{cos}⁡(x)\\sqrt[3]{1+{\\sin }^{2}⁡(x)}-\\sqrt[3]{1+{x}^{2}}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{sin}⁡x.$\n\nFinally, we can compute ${F}^{′}(0).$ We get\n\n$$\n\\begin{aligned}{F}^{′}(0) & =\\operatorname{cos}⁡(0)\\sqrt[3]{1+{\\sin }^{2}⁡(0)}-\\sqrt[3]{1+(0)^{2}} \\\\  & =1\\sqrt[3]{1}-\\sqrt[3]{1} \\\\  & =1-1 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186079032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "325d2db4-591b-5d8e-9668-0baa1d346840" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186330396} {:answer/id #uuid "58fd4d58-1988-5413-90b1-4a3a9c8c8a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186330747} {:answer/id #uuid "e43c9ee3-7b3f-5a7f-8db5-1df7291b344c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186331965} {:answer/id #uuid "f763134b-6706-5c86-9156-5d0dbf6a8aa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186332122} {:answer/id #uuid "f992cc57-3b69-5e91-bb2a-b41416b937e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186332141}] :answer-field/correct {:db/id #edb/ref 17592186332141} :answer-field/id #uuid "390d4b73-4608-5cc8-8765-0709b326f438" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332296}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2090ed89-1b9f-5b68-b522-52c6e26b20f8" :question/math-academy-id "q-49240" :question/problem "Calculate $$\n\\displaystyle {\\int }_{\\pi /8}^{\\pi /8}{\\sin }^{3}⁡(\\operatorname{tan}⁡2x)\\,\\text{d}x.\n$$" :question/worked-solution "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{\\pi /8}^{\\pi /8}{\\sin }^{3}⁡(\\operatorname{tan}⁡2x)\\,\\text{d}x=0\n$$"} {:db/id #edb/ref 17592186082957 :question/id #uuid "b593adba-7766-5cce-b607-ae3f2ad24970" :question/math-academy-id "e-3275" :question/problem "Evaluate $\\sin{30^\\circ} + \\cos{60^\\circ} + \\tan^2{30^\\circ}.$" :question/worked-solution "The angles $30^\\circ$ and $60^\\circ$ are special angles, and their trigonometric ratios have the particular values\n\n$$\n\\sin{30^\\circ} = \\dfrac{1}{2}, \\qquad \\cos 60^\\circ = \\dfrac{1}{2} , \\qquad \\tan{30^\\circ} = \\dfrac{\\sqrt{3}}{3}.\n$$\n\nAlso, note that $\\tan^2{30^\\circ}$ simply means $(\\tan{30^\\circ})^2.$ \n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡{30}^{∘}+\\operatorname{cos}⁡{60}^{∘}+{\\tan }^{2}⁡{30}^{∘} &= \\operatorname{sin}⁡{30}^{∘}+\\operatorname{cos}⁡{60}^{∘}+(\\operatorname{tan}⁡{30}^{∘})^{2} \\\\ &= \\frac{1}{2}+\\frac{1}{2}+{\\left(\\frac{\\sqrt{3}}{3}\\right)}^{2} \\\\ &= 1+\\frac{3}{9} \\\\ &= 1+\\frac{1}{3} \\\\ &= \\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186083541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61793dff-d971-5eb0-823e-10f4a8a6d478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{3}\\operatorname{tan}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186273230} {:answer/id #uuid "cab93d75-99dc-5d85-9884-aac3e0a1e371" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{3}\\operatorname{cot}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186274151} {:answer/id #uuid "d61fe9fd-2340-55df-aee4-5bda7eb6a6bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{3}\\operatorname{csc}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186274261} {:answer/id #uuid "d6e0b57f-2fc7-566f-b81a-2392c8a845fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{3}\\operatorname{cos}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186274266} {:answer/id #uuid "dfa11a94-61eb-5698-8d5f-dc9e2afbc594" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{3}\\operatorname{sin}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186274363}] :answer-field/correct {:db/id #edb/ref 17592186274261} :answer-field/id #uuid "268df1f6-d115-5465-9d50-d0baf3ef7890" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274704}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8bbaf62f-484c-5d9e-8854-24692016788e" :question/math-academy-id "q-15397" :question/problem "Which of the following gives the length of the curve $y=\\operatorname{ln}⁡(\\operatorname{csc}⁡x)$ on $[1,3]?$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\operatorname{ln}⁡(\\operatorname{csc}⁡x),$ $a=1,$ and $b=3.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{-\\operatorname{csc}⁡x\\cdot \\operatorname{cot}⁡x}{\\operatorname{csc}⁡x}=-\\operatorname{cot}⁡x\n$$\n\nSubstituting ${f}^{′}(x)=-\\operatorname{cot}⁡x$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{3}\\sqrt{1+{[{f}^{′}(x)]}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\sqrt{1+{(-\\operatorname{cot}⁡x)}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\sqrt{{\\csc }^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}|\\operatorname{csc}⁡x|\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\operatorname{csc}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nNote, that we use $|\\operatorname{csc}⁡x|=\\operatorname{csc}⁡x$, which is valid due to that $\\operatorname{csc}⁡x>0$ on $[1,3].$"} {:db/id #edb/ref 17592186083629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df4dda98-8d08-5aa1-b971-a32efc874cf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186527751}] :answer-field/correct {:db/id #edb/ref 17592186527751} :answer-field/id #uuid "cf265784-3524-535f-b856-9cb56b3c770b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186080780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e834e51f-4cf4-548e-8d17-140ff3808367" :question/math-academy-id "q-244566" :question/problem "![](images/4c/4c2f042b71421ad5f394fa8e3ee0374696cbc79d7df1b962bef99c1542dc0979.png)\n\n$\\operatorname{csc}⁡C=${{field-1}}" :question/worked-solution "Remember that $\\csc $ is the reciprocal of $sin.$ So\n\n$$\n\\operatorname{csc}⁡C=\\frac{1}{\\operatorname{sin}⁡C}.\n$$\n\nWe have that $m∠C={45}^{∘},$ which is a special angle, and its sine has the value\n\n$$\n\\operatorname{sin}⁡C=\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2}.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡C & =\\frac{1}{\\operatorname{sin}⁡C} \\\\  & =\\frac{1}{\\left(\\frac{\\sqrt{2}}{2}\\right)} \\\\  & =\\frac{2}{\\sqrt{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186084434 :tutorial/content "A **complex number** is a combination of a real number and an imaginary number.\nIf we add the real number $\\color{blue}2$ and the imaginary number ${\\color{red}3\\textrm{i}}$, we get the complex number ${\\color{blue}2} +{\\color{red}3\\textrm{i}}$.\n\nThis complex number has **real part** equal to $\\color{blue}2$ and **imaginary part** equal to ${\\color{red}3}$, which we write as\n\n$$\n\\begin{aligned}\n\\Re (2 + 3\\textrm{i}) &= 2, \\\\\n\\Im (2 + 3\\textrm{i}) &= 3\n\\end{aligned}\n$$\n\nIn general, we write a complex number as ${\\color{blue}a} + {\\color{red}b\\textrm{i}}$, where $\\color{blue}a$ is the real part and $\\color{red}b$ is the imaginary part." :tutorial/id #uuid "9fb6e22b-2218-5737-b025-a05e94e21a43" :tutorial/math-academy-id 2859 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186087477 :question/id #uuid "7826cd52-8603-51ff-902e-c7764639dccd" :question/math-academy-id "e-3666" :question/problem "Express $$\n\\displaystyle \\cos^2{\\left(\\dfrac{\\pi}{24}\\right)} - \\sin^2{\\left(\\dfrac{\\pi}{24}\\right)}\n$$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n\\cos^2 x - \\sin^2 x = \\cos 2x\n$$\n\nSubstituting $x={\\dfrac{\\pi}{24}}$ into the above, we get\n\n$$\n\\begin{aligned}{\\cos }^{2}⁡\\left(\\frac{\\pi }{24}\\right)-{\\sin }^{2}⁡\\left(\\frac{\\pi }{24}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{24}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186087478 :question/id #uuid "2b9dc462-ec26-5762-aa64-d9e8f16112c9" :question/math-academy-id "e-3667" :question/problem "Express $2\\cos^2{\\left(\\dfrac{\\pi}{3}\\right)}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2 \\cos^2 x - 1 = \\cos 2x\n$$\n\nSubstituting $x={\\dfrac{\\pi}{3}}$ into the above, we get\n\n$$\n\\begin{aligned}2{\\cos }^{2}⁡\\left(\\frac{\\pi }{3}\\right)-1 & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{2\\pi }{3}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186087479 :question/id #uuid "e617aaf2-1232-57cc-8644-2467effda030" :question/math-academy-id "e-3668" :question/problem "Without using a calculator, find the exact value of $\\cos^2\\left( 22.5^\\circ\\right) - \\sin^2\\left( 22.5^\\circ\\right).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n\\cos^2 x - \\sin^2 x = \\cos 2x\n$$\n\nSubstituting $x={22.5^\\circ}$ into the above, we get\n\n$$\n\\begin{aligned}{\\cos }^{2}⁡({22.5}^{∘})-{\\sin }^{2}⁡({22.5}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {22.5}^{∘}) \\\\  & =\\operatorname{cos}⁡{45}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186087508 :question/id #uuid "318fc39e-0efe-5b98-968c-ff4408706471" :question/math-academy-id "e-4502" :question/problem "Calculate $A^{-1},$ where\n\n$$\nA = \\begin{bmatrix}{\\color{blue}{1}} & 0 \\\\ -2 & {\\color{red}{1}}\\end{bmatrix}.\n$$" :question/worked-solution "Given a $2 \\times 2$ matrix\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A =\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}$</div>\n</div>\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{\\det (A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\n\\det(A) = 1 \\cdot 1 - 0 \\cdot (-2) = 1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{\\det (A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}. \\\\  & =\\frac{1}{1}\\begin{bmatrix}1 & -0 \\\\ -(-2) & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {A}^{-1}A & =\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186087510 :question/id #uuid "ef06dd89-501b-5d2b-a56d-4554a049a91d" :question/math-academy-id "e-4504" :question/problem "If \n$$\n\\displaystyle A =\n \\begin{bmatrix}1-k & 2 \\\\ 2 & 1-k\\end{bmatrix}\n$$\n is a singular matrix, calculate the value(s) of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $\\det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}\\det (A) & =(1-k)(1-k)-4 \\\\  & ={k}^{2}-2k-3.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k\\mathbin{:}$\n\n$$\n\\begin{aligned}{k}^{2}-2k-3 & =0 \\\\ (k-3)(k+1) & =0 \\\\ k & =3,-1\\end{aligned}\n$$\n\nTherefore, the values of $k$ are $k=3$ and $k=-1.$"} {:db/id #edb/ref 17592186087557 :question/id #uuid "961ff66e-ce82-5ef7-bd5e-d5aa14c1ec58" :question/math-academy-id "e-5379" :question/problem "Find the Cartesian equation of the hyperbola with the parametric equations $x = 6\\sec{t},\\, y = 4 \\sqrt{2}\\tan{t}.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\sec t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =6\\operatorname{sec}⁡t \\\\ \\frac{x}{6} & =\\operatorname{sec}⁡t \\\\ {\\left(\\frac{x}{6}\\right)}^{2} & ={(\\operatorname{sec}⁡t)}^{2} \\\\ \\frac{{x}^{2}}{{6}^{2}} & ={\\sec }^{2}⁡t \\\\ \\frac{{x}^{2}}{36} & ={\\sec }^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\tan{t}$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =4\\sqrt{2}\\operatorname{tan}⁡t \\\\ \\frac{y}{4\\sqrt{2}} & =\\operatorname{tan}⁡t \\\\ {\\left(\\frac{y}{4\\sqrt{2}}\\right)}^{2} & ={(\\operatorname{tan}⁡t)}^{2} \\\\ \\frac{{y}^{2}}{{(4\\sqrt{2})}^{2}} & ={\\tan }^{2}⁡t \\\\ \\frac{{y}^{2}}{32} & ={\\tan }^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity $\\tan^2{t} + 1 = \\sec^2{t}$ and rearranging, we get\n\n$$\n\\begin{aligned}{\\tan }^{2}⁡t+1 & ={\\sec }^{2}⁡t \\\\ \\frac{{y}^{2}}{32}+1 & =\\frac{{x}^{2}}{36} \\\\ \\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{32} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186087616 :question/id #uuid "8bff424d-8f2e-528b-acf0-12c33958a132" :question/math-academy-id "e-6817" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=3\\cos\\theta + 2,\\quad y=3\\sin\\theta - 4, \\quad 0\\leq\\theta\\lt 2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta.$ We can do this using the Pythagorean identity:\n\n$$\n\\cos^2 \\theta + \\sin^2 \\theta = 1\n$$\n\nBy isolating the $\\cos\\theta$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x-2}{3} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x-2)^{2}}{{3}^{2}} & ={\\cos }^{2}⁡\\theta  \\\\ \\frac{(x-2)^{2}}{9} & ={\\cos }^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\sin\\theta$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y+4}{3} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y+4)^{2}}{{3}^{2}} & ={\\sin }^{2}⁡\\theta  \\\\ \\frac{(y+4)^{2}}{9} & ={\\sin }^{2}⁡\\theta .\\end{aligned}\n$$\n\nSubstituting these values into the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}{\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta  & =1 \\\\ \\frac{(x-2)^{2}}{9}+\\frac{(y+4)^{2}}{9} & =1 \\\\ (x-2)^{2}+(y+4)^{2} & =9.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $(x-2)^2 + (y+4)^2 = 9.$"} {:db/id #edb/ref 17592186087989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b6b2951-5fda-53c8-896a-8bde83921b7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459437} {:answer/id #uuid "c82dca82-40a1-54e5-8fe2-071a3a53d264" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459438}] :answer-field/correct {:db/id #edb/ref 17592186459437} :answer-field/id #uuid "8c97d18a-669f-55a0-ae63-6af35a70edb2" :answer-field/key "$A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460585} {:answer-field/choices [{:answer/id #uuid "6411512f-7951-596a-b5a9-6237363cf23b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459439} {:answer/id #uuid "b589497c-aaa2-56ee-9385-1f32f8cc20e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459440}] :answer-field/correct {:db/id #edb/ref 17592186459439} :answer-field/id #uuid "7db0dbb8-05ee-56da-a79d-d8bf4fa9497d" :answer-field/key "$B=\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460586} {:answer-field/choices [{:answer/id #uuid "eb6ed13f-8fd7-53ba-8290-837d992b005f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459441} {:answer/id #uuid "da8baa64-f2af-5f17-8355-f4e19addbcd5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459442}] :answer-field/correct {:db/id #edb/ref 17592186459442} :answer-field/id #uuid "0b3bde15-dda9-5eec-8013-c3084007af6f" :answer-field/key "$C=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460587}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd3fba16-5fcc-50bc-8866-44ee67a3b9b6" :question/math-academy-id "q-11718" :question/problem "Which of the matrices below are singular?\n\nSelect all that apply." :question/worked-solution "- For the matrix $A$, we have\n\n$$\n\\det (A)=0\\cdot 0-1\\cdot 1=-1.\n$$\n\nBecause $\\det (A)\\ne 0,$ we conclude that $A$ is invertible.\n\n- The matrix $B$ is a $3\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\n\\det (C)=1\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $\\det (C)=0,$ we conclude that $C$ is not invertible. Since $C$ is a square matrix that is not invertible, we also say that $C$ is singular.\n\nTherefore, only $C$ is singular."} {:db/id #edb/ref 17592186087991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "419dd4e5-12cc-5539-9ce1-12dbb328e826" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-\\frac{2}{3}" :db/id #edb/ref 17592186251098} {:answer/id #uuid "7e26377c-0b5f-5e88-8cee-a0c378d66f48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-\\frac{3}{2}" :db/id #edb/ref 17592186251612} {:answer/id #uuid "a1d02b22-933b-5127-9e49-db343d3d3057" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=0" :db/id #edb/ref 17592186251946} {:answer/id #uuid "e9173fd7-88e5-5605-babf-0c1896274065" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186252591} {:answer/id #uuid "f7a703d4-42c5-5789-b2d3-b2087a71eba0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\frac{3}{2}" :db/id #edb/ref 17592186252720}] :answer-field/correct {:db/id #edb/ref 17592186251946} :answer-field/id #uuid "73272f9c-f427-56d0-a21e-b2927edff5b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee61babb-f6b1-5a98-9886-55df60a724bf" :question/math-academy-id "q-11723" :question/problem "If $A=\\begin{bmatrix}k & k \\\\ 2 & 1\\end{bmatrix}$ is a singular matrix, calculate the value of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $\\det (A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}\\det (A) & =k\\cdot 1-k\\cdot 2 \\\\  & =k-2k \\\\  & =-k\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}-k & =0 \\\\ k & =0\\end{aligned}\n$$\n\nTherefore, the value of $k$ is $k=0.$"} {:db/id #edb/ref 17592186087993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c0a8452-772e-5183-968e-5081778d81a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459443} {:answer/id #uuid "16964185-0fa1-5c40-ba30-02add50a42e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459444}] :answer-field/correct {:db/id #edb/ref 17592186459444} :answer-field/id #uuid "1d7d1630-9e25-5340-bd4c-d1503c868d24" :answer-field/key "$A=\\begin{bmatrix}1 & 5 & 0 \\\\ -1 & 1 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460588} {:answer-field/choices [{:answer/id #uuid "c49f134d-b275-58ab-85af-ec9fd2b5885b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459445} {:answer/id #uuid "e352c568-e812-5e17-b65a-6e55c2065821" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459446}] :answer-field/correct {:db/id #edb/ref 17592186459446} :answer-field/id #uuid "91e63b07-cfa6-51d4-9446-17be269137d3" :answer-field/key "$B=\\begin{bmatrix}6 & 8 \\\\ 3 & 4\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460589} {:answer-field/choices [{:answer/id #uuid "5cd74d9f-29c9-5af3-86e7-5d73dd7bfffd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459447} {:answer/id #uuid "20983efb-be24-5fea-9f77-4785c48e9e97" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459448}] :answer-field/correct {:db/id #edb/ref 17592186459447} :answer-field/id #uuid "18e9fed9-651b-5bfd-9db4-7ea966e44fd6" :answer-field/key "$C=\\begin{bmatrix}-1 & 1 \\\\ 5 & 5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460590}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d6fdbc09-a579-52c0-b98c-5f14a5229abc" :question/math-academy-id "q-11725" :question/problem "Which of the matrices below does **not** have an inverse?\n\nSelect all that apply." :question/worked-solution "- The matrix $A$ is a $2\\times 3$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\n\\det (B)=6\\cdot 4-8\\cdot 3=0.\n$$\n\nBecause $\\det (B)=0,$ we conclude that $B$ is not invertible.\n\n- For the matrix $C$, we have\n\n$$\n\\det (C)=(-1)\\cdot 5-1\\cdot 5=-10.\n$$\n\nBecause $\\det (C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ and $B$ do not have an inverse."} {:db/id #edb/ref 17592186088094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075d6c0f-91ae-5d3a-8904-f94acdc0ce84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)" :db/id #edb/ref 17592186288092} {:answer/id #uuid "250beb4e-89fe-54a1-a69b-97059dc5f771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186288272} {:answer/id #uuid "4169b527-77fc-5467-b408-c2fac538f2a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right)" :db/id #edb/ref 17592186288476} {:answer/id #uuid "4fd0eaa1-713d-59b2-aa0a-54b382724e36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{5\\pi }{2}\\right)" :db/id #edb/ref 17592186288584} {:answer/id #uuid "af22ea99-4405-5cb4-84cc-edd0522c77e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{3\\pi }{4}\\right)" :db/id #edb/ref 17592186289191}] :answer-field/correct {:db/id #edb/ref 17592186288476} :answer-field/id #uuid "75c1b968-b21c-5ef9-be91-d01d0d0f5cc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289986}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eda88667-03a3-54d2-bc45-5bd8cd910c52" :question/math-academy-id "q-24488" :question/problem "Express $$\n\\displaystyle {\\cos }^{2}⁡\\left(\\frac{3\\pi }{4}\\right)-{\\sin }^{2}⁡\\left(\\frac{3\\pi }{4}\\right)\n$$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{\\cos }^{2}⁡x-{\\sin }^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{4}$ into the above, we get\n\n$$\n\\begin{aligned}{\\cos }^{2}⁡\\left(\\frac{3\\pi }{4}\\right)-{\\sin }^{2}⁡\\left(\\frac{3\\pi }{4}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{4}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7088b1af-54df-5c95-bec1-e96b53c5f1cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right)" :db/id #edb/ref 17592186288815} {:answer/id #uuid "9ca70449-d3c0-500a-bf01-9fc59bdb8e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{5\\pi }{2}\\right)" :db/id #edb/ref 17592186289086} {:answer/id #uuid "ab1691b5-d526-5306-8cf2-8c5f601c7ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{5\\pi }{3}\\right)" :db/id #edb/ref 17592186289165} {:answer/id #uuid "e0db6555-c3dc-5b31-9920-d1231647197e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{7\\pi }{3}\\right)" :db/id #edb/ref 17592186289533} {:answer/id #uuid "e474e08f-fd81-5207-ab8d-f763fcb42bbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{10\\pi }{3}\\right)" :db/id #edb/ref 17592186289548}] :answer-field/correct {:db/id #edb/ref 17592186289548} :answer-field/id #uuid "6da4ca44-fffb-53ef-ac9c-e81ad6738ecf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289972}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a18ec028-af86-5940-bde5-98a13535f55f" :question/math-academy-id "q-24490" :question/problem "Express $2{\\cos }^{2}⁡\\left(\\frac{5\\pi }{3}\\right)-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{\\cos }^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{5\\pi }{3}$ into the above, we get\n\n$$\n\\begin{aligned}2{\\cos }^{2}⁡\\left(\\frac{5\\pi }{3}\\right)-1 & =\\operatorname{cos}⁡(2\\cdot \\frac{5\\pi }{3}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{10\\pi }{3}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0043b9dd-acd7-5722-ae3f-3f717ea8f717" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288026} {:answer/id #uuid "0fcd1b2f-6684-5235-9ad9-1439089c5d1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288147} {:answer/id #uuid "2e93b461-8b28-554d-a5d3-b0197fe38c18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288346} {:answer/id #uuid "38664848-58db-58e9-955b-e673ca767957" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186288415} {:answer/id #uuid "679b2481-2702-5446-9e64-41947ec19124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288759}] :answer-field/correct {:db/id #edb/ref 17592186288759} :answer-field/id #uuid "0e2b6c24-7b3b-5d04-808b-ab04891dc6ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289763}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "baeab088-833a-54f7-96df-e4a2e1a80c83" :question/math-academy-id "q-24514" :question/problem "Find the exact value of $$\n\\displaystyle {\\cos }^{2}⁡\\left(\\frac{\\pi }{12}\\right)-{\\sin }^{2}⁡\\left(\\frac{\\pi }{12}\\right).\n$$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{\\cos }^{2}⁡x-{\\sin }^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n\\begin{aligned}{\\cos }^{2}⁡\\left(\\frac{\\pi }{12}\\right)-{\\sin }^{2}⁡\\left(\\frac{\\pi }{12}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c335d98-0aff-5512-8c90-fb857ce5f43e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186290690} {:answer/id #uuid "0f5e2260-8483-51b1-bece-55704d606b17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186290702} {:answer/id #uuid "b76b10df-1ac1-504b-a97f-8b92f696b0d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186291429} {:answer/id #uuid "f27a750b-ccda-56d7-bfaf-2c1c37c66eb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186291652} {:answer/id #uuid "fb47e48c-4106-50e5-87c5-9d5d71d6c1ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186291697}] :answer-field/correct {:db/id #edb/ref 17592186291697} :answer-field/id #uuid "8ea8649a-e5af-5e8b-bbeb-3b924ae079e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186292181}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0283435-c23b-5d26-b5af-8d4a513ca18b" :question/math-academy-id "q-26706" :question/problem "Find the exact value of $1-2{\\sin }^{2}⁡({67.5}^{∘}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{\\sin }^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={67.5}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{\\sin }^{2}⁡({67.5}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {67.5}^{∘}) \\\\  & =\\operatorname{cos}⁡{135}^{∘} \\\\  & =-\\operatorname{cos}⁡{45}^{∘} \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbb39e3d-7c00-5ffd-b219-385bdbb65fb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.151" :db/id #edb/ref 17592186086179} {:answer/id #uuid "3c550fd6-0c84-5822-b466-66a312508be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.946" :db/id #edb/ref 17592186086180} {:answer/id #uuid "40a3f90a-5606-5f21-9444-7efba36a199f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.845" :db/id #edb/ref 17592186086181} {:answer/id #uuid "6683b2b6-bc11-5d63-9a9c-82de11e77232" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.321" :db/id #edb/ref 17592186086182} {:answer/id #uuid "7f117552-88ca-5863-8469-88b09dabfb56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.856" :db/id #edb/ref 17592186086183}] :answer-field/correct {:db/id #edb/ref 17592186086180} :answer-field/id #uuid "e61fb05b-bb1f-57bd-a3ae-f9d4180ef892" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086178}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "70d22aee-cf89-5d3c-9988-c197ae387fe1" :question/math-academy-id "q-66592" :question/problem "Find the solution to the equation ${e}^{y}=7$ rounded to $3$ decimal places." :question/requires-calculator true :question/worked-solution "First, we take $\\ln $ of both sides of the equation and solve for $y$:\n\n$$\n\\begin{aligned}{e}^{y} & =7 \\\\ \\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡(7) \\\\ y & =\\operatorname{ln}⁡(7)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈1.946\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186088264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2966ce7d-72d7-561e-87f1-61fb01260240" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.651" :db/id #edb/ref 17592186333374} {:answer/id #uuid "3ab8e2c0-dbab-5870-863a-8d45b09a5889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.305" :db/id #edb/ref 17592186333539} {:answer/id #uuid "7cb6d880-3356-5ffb-bd65-6308f5960095" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.527" :db/id #edb/ref 17592186334104} {:answer/id #uuid "951e60d4-e2c6-57d3-91cb-dcf75d4cff51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.195" :db/id #edb/ref 17592186334316} {:answer/id #uuid "cec18578-7a6b-5d74-82a3-074461aeca04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.151" :db/id #edb/ref 17592186334793}] :answer-field/correct {:db/id #edb/ref 17592186333539} :answer-field/id #uuid "57d9d4eb-3ca5-50f6-b52c-32a28cac37f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335414}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "063b851a-c4a8-502d-80ec-f9c4d61efa9a" :question/math-academy-id "q-66940" :question/problem "Find the solution to the equation ${e}^{1-2x}=5$ rounded to $3$ decimal places." :question/requires-calculator true :question/worked-solution "First, we take $\\ln $ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{e}^{1-2x} & =5 \\\\ \\ln ⁡({e}^{1-2x}) & =\\ln ⁡(5) \\\\ 1-2x & =\\ln ⁡(5) \\\\ -2x & =\\ln ⁡(5)-1 \\\\ x & =\\frac{1-\\ln ⁡(5)}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈-0.305\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186088339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "397011d1-40ef-58e1-a271-2a88e28eddef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡{20}^{∘}\\operatorname{cos}⁡{20}^{∘}" :db/id #edb/ref 17592186342709} {:answer/id #uuid "5f5fa170-0ddc-52a6-868a-72cbec943905" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cos}^{2}⁡{40}^{∘}" :db/id #edb/ref 17592186343043} {:answer/id #uuid "6e8b168b-8168-5d02-9a89-868692b0642f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡{40}^{∘}" :db/id #edb/ref 17592186343189} {:answer/id #uuid "737e14b8-f80f-5ff7-a071-c67c9ee7f9e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{20}^{∘}\\operatorname{cos}⁡{20}^{∘}" :db/id #edb/ref 17592186343238} {:answer/id #uuid "dc28258e-62ee-554a-9496-55d7f7b52dfa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{40}^{∘}" :db/id #edb/ref 17592186344170}] :answer-field/correct {:db/id #edb/ref 17592186343189} :answer-field/id #uuid "72362da5-626c-57b5-9cfa-ac674781feb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344698}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9c84ae1b-25c3-565d-8730-075bec8eef99" :question/math-academy-id "q-7698" :question/problem "Express $5-10{\\sin }^{2}⁡{20}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n5(1-2{\\sin }^{2}⁡{20}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{\\sin }^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={20}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{\\sin }^{2}⁡{20}^{∘} & =\\operatorname{cos}⁡(2\\cdot {20}^{∘})=\\operatorname{cos}⁡{40}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n5(1-2{\\sin }^{2}⁡{20}^{∘})=5\\operatorname{cos}⁡{40}^{∘}.\n$$"} {:db/id #edb/ref 17592186088376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b85d5df-e79b-52b2-8057-2e31eaea53ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{5}-\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186345440} {:answer/id #uuid "4e214a28-51f7-54c0-8cbb-7f3284c8d14c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{\\sqrt{5}}-\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186346018} {:answer/id #uuid "5e38fa25-11dc-55bf-90c5-8f3e29b0f5ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186346162} {:answer/id #uuid "b03ca2c2-7b70-55fe-9621-202f7bf907f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{9}=1" :db/id #edb/ref 17592186346890} {:answer/id #uuid "e8c9129e-1f7a-591c-b3fd-8988a647583d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{\\sqrt{5}}-\\frac{{x}^{2}}{3}=1" :db/id #edb/ref 17592186347403}] :answer-field/correct {:db/id #edb/ref 17592186345440} :answer-field/id #uuid "f51b630f-cf5c-537b-8f8f-a3c4d62daf1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186348034}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8b759c31-90c7-5fab-8980-94a67e08f99a" :question/math-academy-id "q-7987" :question/problem "Find the Cartesian equation of the hyperbola $x=\\sqrt{5}\\operatorname{sec}⁡t,\\,y=3\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{5}\\operatorname{sec}⁡t \\\\ \\frac{x}{\\sqrt{5}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{5})^{2}} & ={\\sec }^{2}⁡t \\\\ \\frac{{x}^{2}}{5} & ={\\sec }^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =3\\operatorname{tan}⁡t \\\\ \\frac{y}{3} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{{3}^{2}} & ={\\tan }^{2}⁡t \\\\ \\frac{{y}^{2}}{9} & ={\\tan }^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${\\tan }^{2}⁡t+1={\\sec }^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{\\tan }^{2}⁡t+1 & ={\\sec }^{2}⁡t \\\\ \\frac{{y}^{2}}{9}+1 & =\\frac{{x}^{2}}{5} \\\\ \\frac{{x}^{2}}{5}-\\frac{{y}^{2}}{9} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1b0500-415f-5429-89d9-fbbb92a98ae2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.31" :db/id #edb/ref 17592186352546} {:answer/id #uuid "cd29b07a-70bf-5347-a5b0-93e51c59301b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.74" :db/id #edb/ref 17592186353348} {:answer/id #uuid "e36a586c-680f-580d-a120-8ca0ede7f5be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.22" :db/id #edb/ref 17592186353548} {:answer/id #uuid "ef8e504f-d2c6-5f83-8ce5-d298b778f10a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.23" :db/id #edb/ref 17592186353653} {:answer/id #uuid "fde2ebba-1cad-5211-b6e3-3a258bce156d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.66" :db/id #edb/ref 17592186353793}] :answer-field/correct {:db/id #edb/ref 17592186353793} :answer-field/id #uuid "4ee08007-7eba-5dcc-a203-e575bd3f6bdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353951}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1eede2a0-b32f-5395-87d1-df0fef1f0013" :question/math-academy-id "q-8454" :question/problem "Find, in radians to two decimal places, the argument of $z=7-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/d0/d096d76118bc06b2d5c79d5017c0178d96fc84bff6f97d563b7b872d26e75d20.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Therefore $\\frac{3\\pi }{2}<\\arg ⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =\\arctan ⁡\\left(\\frac{5}{7}\\right)≈0.620\\,25.\n$$\n\nTherefore,\n\n$$\n\\theta =\\arg ⁡(z)=2\\pi -0.620\\,25≈5.66\n$$\n\nto two decimal places."} {:db/id #edb/ref 17592186088448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5b13632-d202-5d8a-a29c-7fd493b7f28b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y^{2}}{6} - \\frac{x^{2}}{2} = 1" :db/id #edb/ref 17592186087342} {:answer/id #uuid "d80622eb-217c-588c-b842-ba143a8ca4ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{6} - \\frac{y^{2}}{2} = 1" :db/id #edb/ref 17592186087343} {:answer/id #uuid "03c390a3-0011-53c0-94e3-87891b963e18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{4} - \\frac{y^{2}}{36} = 1" :db/id #edb/ref 17592186087344} {:answer/id #uuid "522ef455-c7df-5472-9bd6-eb72f8f21e47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{2} - \\frac{y^{2}}{6} = 1" :db/id #edb/ref 17592186087345} {:answer/id #uuid "797dd586-9c9f-5b90-951c-19f5a19c32df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y^{2}}{2} - \\frac{x^{2}}{6} = 1" :db/id #edb/ref 17592186087346}] :answer-field/id #uuid "43395a9a-f3a9-536f-b3ff-c42a92db8e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186087341} {:answer-field/choices [{:answer/id #uuid "45b07bef-5244-588c-9ddc-ae7116c77d2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{2}-\\frac{{x}^{2}}{6}=1" :db/id #edb/ref 17592186364448} {:answer/id #uuid "4acaceb8-9337-5d7f-b402-91766ae58363" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186364449} {:answer/id #uuid "9accd101-1841-5f6d-acf5-e4cfb10226bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{6}-\\frac{{x}^{2}}{2}=1" :db/id #edb/ref 17592186364450} {:answer/id #uuid "4ae6cbf5-27d1-5910-b4bc-c5a2676fb501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186364451} {:answer/id #uuid "398cb15c-8bcd-583f-a06a-8a1d47f2bf84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186364452}] :answer-field/correct {:db/id #edb/ref 17592186364451} :answer-field/id #uuid "777aa002-3a0b-5f6b-b461-590b82ef1b0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186364447}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da4b3797-7dda-5074-b813-a73affb3ac7b" :question/math-academy-id "q-89294" :question/problem "Find the Cartesian equation of the hyperbola $x=\\sqrt{2}\\operatorname{sec}⁡t,\\,y=\\sqrt{6}\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{2}\\operatorname{sec}⁡t \\\\ \\frac{x}{\\sqrt{2}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{2})^{2}} & ={\\sec }^{2}⁡t \\\\ \\frac{{x}^{2}}{2} & ={\\sec }^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\sqrt{6}\\operatorname{tan}⁡t \\\\ \\frac{y}{\\sqrt{6}} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{(\\sqrt{6})^{2}} & ={\\tan }^{2}⁡t \\\\ \\frac{{y}^{2}}{6} & ={\\tan }^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${\\tan }^{2}⁡t+1={\\sec }^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{\\tan }^{2}⁡t+1 & ={\\sec }^{2}⁡t \\\\ \\frac{{y}^{2}}{6}+1 & =\\frac{{x}^{2}}{2} \\\\ \\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{6} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088881 :tutorial/content "It's possible to write the double angle formula for cosine in two alternative forms.\n\nFrom the Pythagorean identity $\\sin^2{x}+\\cos^2{x}=1,$ we obtain $\\cos^2{x}=1-\\sin^2{x}.$\nSubstituting this into the double-angle formula for cosine, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2x & ={\\cos }^{2}⁡x-{\\sin }^{2}⁡x \\\\  & =(1-{\\sin }^{2}⁡x)-{\\sin }^{2}⁡x \\\\  & =1-2{\\sin }^{2}⁡x.\\end{aligned}\n$$\n\nThis gives an alternative form of the double-angle formula for cosine. We'll restate it below:\n\n$$\n\\cos{2x} =1 - 2\\sin^2{x}\n$$\n\nSimilarly, from the same Pythagorean identity, we obtain that $\\sin^2{x}=1-\\cos^2{x}.$ Substituting into the double-angle formula for cosine, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2x & ={\\cos }^{2}⁡x-{\\sin }^{2}⁡x \\\\  & ={\\cos }^{2}⁡x-(1-{\\cos }^{2}⁡x) \\\\  & =2{\\cos }^{2}⁡x-1.\\end{aligned}\n$$\n\nThis is another alternative form of the double-angle formula for cosine:\n\n$$\n\\cos{2x} =2\\cos^2{x}-1\n$$" :tutorial/id #uuid "5da93916-34c4-5c5a-806c-82bae4dc1e02" :tutorial/math-academy-id 2639 :tutorial/title "Alternative Forms of the Double-Angle Formula for Cosine"} {:db/id #edb/ref 17592186088895 :tutorial/content "Given a $2 \\times 2$ matrix\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A =\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}$</div>\n</div>\n\nthe **inverse** of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{\\det (A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$" :tutorial/id #uuid "9694c9ae-0d23-54a2-a458-b9c2262e4fba" :tutorial/math-academy-id 3045 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186088916 :tutorial/content "When we add a complex number and its conjugate, the result is always twice the real part of the complex number. That is to say,\n\n$$\nz + \\overline{z} = 2\\operatorname{Re}(z),\n$$\n\nwhere $\\operatorname{Re}(z)$ is the real part of $z.$\n\nFor example, suppose we have a complex number $z = 3+4\\textrm{i}.$ To obtain the conjugate, we just flip the sign of the imaginary part and get $\\overline{z} = 3 - 4 \\textrm{i}.$\n\nNow, adding $z$ and its conjugate $\\overline{z},$ we find that the real part $(3)$ is doubled while the imaginary part $(4)$ is canceled out:\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(3+4\\text{i})+(3-4\\text{i}) \\\\  & =(3+3)+(4\\text{i}-4\\text{i}) \\\\  & =6+0\\text{i} \\\\  & =6\\end{aligned}\n$$\n\nThis result holds in general. For any complex number $z=x+\\textrm{i}y,$ the conjugate is $\\overline{z} = x-\\textrm{i}y,$ and when we add, we find that the real part $(x)$ is doubled while the imaginary part $(y)$ is canceled out:\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(x+\\text{i}y)+(x-\\text{i}y) \\\\  & =(x+x)+(\\text{i}y-\\text{i}y) \\\\  & =2x+\\text{i}0 \\\\  & =2x \\\\  & =2\\Re (z).\\end{aligned}\n$$" :tutorial/id #uuid "aa576d65-023e-5ad0-9cc8-fff8c2b730f1" :tutorial/math-academy-id 3425 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186088917 :tutorial/content "When we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part. That is to say,\n\n$$\nz\\overline{z} = x^2 + y^2 = (\\operatorname{Re}(z))^2 + (\\operatorname{Im}(z))^2.\n$$\n\nFor example, suppose we have a complex number $z=3+4\\textrm{i}.$  To obtain the conjugate, we just flip the sign of the imaginary part and get $\\overline{z} = 3 - 4 \\textrm{i}.$\n\nNow, multiplying $z$ and its conjugate $\\overline{z},$ we find that the result is the sum of squares of the real part $(3^2=9)$ and the imaginary part $(4^2=16)\\mathbin{:}$\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(3+4\\text{i})(3-4\\text{i}) \\\\  & ={3}^{2}-3(4\\text{i})+3(4\\text{i})-{4}^{2}{\\text{i}}^{2} \\\\  & =9-12\\text{i}+12\\text{i}-16(-1) \\\\  & =9+16 \\\\  & =25\\end{aligned}\n$$\n\nThis result holds in general. For any complex number $z=x+\\textrm{i}y,$ the conjugate is $\\overline{z} = x-\\textrm{i}y,$ and when we multiply, we find that the result is the sum of squares of the real part $(x^2)$ and the imaginary part $(y^2)\\mathbin{:}$\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(x+\\text{i}y)(x-\\text{i}y) \\\\  & ={x}^{2}-\\text{i}xy+\\text{i}xy-{\\text{i}}^{2}{y}^{2} \\\\  & ={x}^{2}-(-1){y}^{2} \\\\  & ={x}^{2}+{y}^{2} \\\\  & =(\\Re (z))^{2}+(\\Im (z))^{2}\\end{aligned}\n$$" :tutorial/id #uuid "282ac3b7-1a83-5a26-9532-97ac664356fc" :tutorial/math-academy-id 3427 :tutorial/title "Calculating the Product of a Complex Number and its Conjugate"} {:db/id #edb/ref 17592186088973 :tutorial/content "We've been told that the parametric equations of a horizontal hyperbola centered at the origin are\n\n$$\nx=a\\sec{t},\\quad y=b\\tan{t}\n$$\n\nwhere $a$ and $b$ are positive constants. Can we be sure that these equations do indeed describe a hyperbola?\n\nFirst, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x & =a\\operatorname{sec}⁡t & ⟹ &  & \\operatorname{sec}⁡t & =\\frac{x}{a}, \\\\ y & =b\\operatorname{tan}⁡t & ⟹ &  & \\operatorname{tan}⁡t & =\\frac{y}{b}.\\end{aligned}\n$$\n\nNow, we recall the secant-tangent identity:\n\n$$\n\\tan^2{t} + 1 = \\sec^2{t}.\n$$\n\nSubstituting the above into the secant-tangent identity, we get\n\n$$\n\\begin{aligned}{\\tan }^{2}⁡t+1 & ={\\sec }^{2}⁡t \\\\ {\\left(\\frac{y}{b}\\right)}^{2}+1 & ={\\left(\\frac{x}{a}\\right)}^{2} \\\\ \\frac{{y}^{2}}{{b}^{2}}+1 & =\\frac{{x}^{2}}{{a}^{2}} \\\\ \\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}} & =1.\\end{aligned}\n$$\n\nThis is the Cartesian equation of a horizontal hyperbola centered at the origin. Therefore, the parametric equations do indeed describe a horizontal hyperbola." :tutorial/id #uuid "fb10cbc8-566e-5d0f-82ce-e8d9fb516e6e" :tutorial/math-academy-id 4633 :tutorial/title "Explanation of the Parametric Equations of Hyperbolas Centered at the Origin"} {:db/id #edb/ref 17592186091934 :question/id #uuid "48d7b03b-c991-574a-bf15-8765ca43724b" :question/math-academy-id "e-11113" :question/problem "Let $\\mathbf{X} = [X_1, X_2]^T$ be a bivariate normal random vector. The variances of $X_1$ and $X_2$ and their correlation coefficient are given by\n\n$$\n\\sigma_1^2=9,\\qquad \\sigma_2^2 = 1, \\qquad \\rho = \\dfrac1{3}.\n$$\n\nGiven that the joint probability density function of $\\mathbf X$ is\n\n$$\nf(\\mathbf x) = \\dfrac1k\\,\\mathrm{exp}\\left( -\\dfrac 12(\\mathbf x - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf x - \\boldsymbol \\mu)\\right),\n$$\n\nwhere $\\boldsymbol{\\mu}$ is the mean vector and $\\Sigma$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $\\mathbf{X} = [X_1, X_2]^T$ is a bivariate normal vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{pmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{pmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix}=\\begin{bmatrix}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{bmatrix}\\end{aligned}\n$$\n\nwhere $\\sigma^2_i = \\textrm{Var}[X_i],$ $\\sigma_{12} = \\textrm{Cov}[X_1,X_2],$ and $\\rho$ is the correlation, then the joint probability density function of $\\mathbf X$ is\n\n$$\nf(\\mathbf x) = \\dfrac{1}{2\\pi\\sqrt{|\\Sigma|}} \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf x - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf x - \\boldsymbol \\mu)\\right)\n$$\n\nand $|\\Sigma|$ denotes the determinant of $\\Sigma.$\n\nUsing the given values of $\\sigma^2_1, \\sigma^2_2$, and $\\rho,$ our covariance matrix is\n\n$$\n\\Sigma \n= \n\n{\\left[ \\begin{array}{cc}9 & \\frac{1}{3} \\cdot  \\sqrt{9} \\cdot  \\sqrt{1} \\\\ \\frac{1}{3} \\cdot  \\sqrt{9} \\cdot  \\sqrt{1} & 1\\end{array} \\right]}\n\n\n=\n\n{\\left[ \\begin{array}{cc}9 & 1 \\\\ 1 & 1\\end{array} \\right]}.\n$$\n\nTherefore,\n\n$$\n|\\Sigma| = 9\\cdot 1 - 1\\cdot 1 = 8.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{8}}\\exp (-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{4\\pi \\sqrt{2}}\\exp (-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=4\\pi\\sqrt 2.$"} {:db/id #edb/ref 17592186091935 :question/id #uuid "90ff4bf9-f8d3-5179-9d02-0e0a46a3cc98" :question/math-academy-id "e-11114" :question/problem "Let $\\mathbf{X} = [X_1,X_2]^T$ be a bivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}2 \\\\ -1\\end{bmatrix},\\,Σ=\\begin{bmatrix}4 & -3 \\\\ -3 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nFind the distribution of $Y = 3X_1 + X_2 .$" :question/worked-solution "Recall that if $\\mathbf{X} = [X_1, X_2]^T$ is a bivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{bmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY= aX_1 + bX_2\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ \\operatorname{Var} [Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have $\\mu_1 = 2$ and $\\mu_2 = -1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[3{X}_{1}+{X}_{2}] \\\\  & =3\\text{E}[{X}_{1}]+\\text{E}[{X}_{2}] \\\\  & =3\\cdot {\\mu }_{1}+{\\mu }_{2} \\\\  & =3\\cdot 2+(-1) \\\\  & =5.\\end{aligned}\n$$\n\nAlso, we have $\\sigma_1^2 = 4, \\sigma_2^2 = 7,$ and $\\sigma_{12} = \\sigma_{21} = -3.$ Therefore, \n\n$$\n\\begin{aligned}\\operatorname{Var} [Y] & =\\operatorname{Var} [3{X}_{1}+{X}_{2}] \\\\  & ={3}^{2}\\cdot 4+{1}^{2}\\cdot 7+2\\cdot 3\\cdot 1\\cdot (-3) \\\\  & =36+7-18 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY \\sim N(5,25).\n$$"} {:db/id #edb/ref 17592186091936 :question/id #uuid "f9e6c722-6017-57b9-9de6-c83c2f14c8c4" :question/math-academy-id "e-11115" :question/problem "Let $\\mathbf{X} = [X_1, X_2,X_3]^T$ be a multivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}6 & 1 & 2 \\\\ 1 & 3 & 2 \\\\ 2 & 2 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nFind the distribution of $Y = X_1 -2X_2 +4 X_3.$" :question/worked-solution "Recall that if $\\mathbf{X} =  [X_1, X_2, \\ldots, X_k]^T$ is a multivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ then the random variable $Y,$ defined as\n\n$$\nY= \\mathbf c^T \\mathbf X = \\sum_{i=1}^k c_i X_i\n$$\n\nis a normally distributed random variable, where $\\mathbf c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ \\operatorname{Var} [Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y = X_1 -2X_2 +4 X_3,$ we have \n\n$$\n\\mathbf c = {\\left[ \\begin{array}{c}1 \\\\ - 2 \\\\ 4\\end{array} \\right]}.\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =\\begin{bmatrix}1 & -2 & 4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\  & =1-4+4 \\\\  & =1,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =\\begin{bmatrix}1 & -2 & 4\\end{bmatrix}\\begin{bmatrix}6 & 1 & 2 \\\\ 1 & 3 & 2 \\\\ 2 & 2 & 4\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 & 4\\end{bmatrix}\\begin{bmatrix}12 \\\\ 3 \\\\ 14\\end{bmatrix} \\\\  & =12-6+56 \\\\  & =62.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY\\sim N(1,62).\n$$"} {:db/id #edb/ref 17592186091945 :question/id #uuid "cc45cc10-61e3-5cb7-babc-7253a5158c4b" :question/math-academy-id "e-12767" :question/problem "$$\n\\mathbf{1}_{A}(-1) = 0, \\qquad \\mathbf{1}_{B}(-1) = 1\n$$\n\nGiven the values of the indicator functions of the sets $A$ and $B,$ which of the following statements are true?\n\nI. $\\mathbf{1}_{A \\,\\cup\\, B}\\,(-1) = 1$\n\nII. $\\mathbf{1}_{A \\,\\cup\\, B}\\,(-1) = 0$\n\nIII. $-1 \\in A \\cup B$" :question/worked-solution "Recall that the indicator functions of $\\overline{A},$ $A \\cap B,$ and $A \\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =\\min \\{{1}_{A}(x),{1}_{B}(x)\\} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =\\max \\{{1}_{A}(x),{1}_{B}(x)\\}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{A\\,\\cup \\,B}\\,(-1) & =\\max \\{{1}_{A}(-1),{1}_{B}(-1)\\} \\\\  & =\\max \\{0,1\\} \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since $\\mathbf{1}_{A \\,\\cup\\, B}\\,(-1) = 1,$ we conclude that $-1$ belongs to $A \\cup B.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186092026 :question/id #uuid "d32f2604-fc3f-5e80-8085-483e6fd9a3ad" :question/math-academy-id "e-4521" :question/problem "Solve the following system of linear equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}3y+x+z &=0 \\\\ z+4y-5 &=2 \\\\ 1+2x-y &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are in the correct order and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}x+3y+z &=0 \\\\ 0x+4y+z &=7 \\\\ 2x-y+0z &=-4\\end{aligned}\\right.\n$$\n\nNext, we  write the system in the form $A\\mathbf{x} = \\mathbf{b}$, where $A$ is a $3\\times 3$ matrix and $\\mathbf{x}$ and $\\mathbf{b}$ are $3\\times 1$ column vectors. We can do this as follows:\n\n\n\n$$\n\\begin{bmatrix}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{bmatrix} \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} = \\begin{bmatrix}0 \\\\ 7 \\\\ -4\\end{bmatrix}\n$$\n\n\n\nNow, the solution to $A\\mathbf{x}=\\mathbf{b}$ is given by $\\mathbf{x}= A^{-1}\\mathbf{b}.$ So, we compute $A^{-1}$ as follows:\n\n*Step 1*: Find the determinant of $A.$\n\n$$\n\\begin{aligned}\\det (A)=\\begin{vmatrix}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{vmatrix} & =1\\begin{vmatrix}4 & 1 \\\\ -1 & 0\\end{vmatrix}-3\\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix}+1\\begin{vmatrix}0 & 4 \\\\ 2 & -1\\end{vmatrix} \\\\  & =(1)-3(-2)+(-8) \\\\  & =1+6-8 \\\\  & =-1\\end{aligned}\n$$\n\n*Step 2*: Compute the matrix of minors.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}4 & 1 \\\\ -1 & 0\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix} & \\begin{vmatrix}0 & 4 \\\\ 2 & -1\\end{vmatrix} \\\\ \\begin{vmatrix}3 & 1 \\\\ -1 & 0\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 2 & 0\\end{vmatrix} & \\begin{vmatrix}1 & 3 \\\\ 2 & -1\\end{vmatrix} \\\\ \\begin{vmatrix}3 & 1 \\\\ 4 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 3 \\\\ 0 & 4\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 & -8 \\\\ 1 & -2 & -7 \\\\ -1 & 1 & 4\\end{bmatrix}\\end{aligned}\n$$\n\n*Step 3*:  Find the matrix of cofactors.\n\n\n\n$$\nC=\\begin{bmatrix}1 & 2 & -8 \\\\ -1 & -2 & 7 \\\\ -1 & -1 & 4\\end{bmatrix}\n$$\n\n\n\n*Step 4*: Transpose the matrix of cofactors.\n\n\n\n$$\nC^T=\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{bmatrix}\n$$\n\n\n\n*Step 5*: Apply the inverse matrix formula.\n\n\n\n$$\nA^{-1}=\\dfrac{1}{\\det (A)}C^T=\\dfrac{1}{-1}\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{bmatrix} =\\begin{bmatrix}-1 & 1 & 1 \\\\ -2 & 2 & 1 \\\\ 8 & -7 & -4\\end{bmatrix} .\n$$\n\n\n\nFinally, we can calculate the solution as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}-1 & 1 & 1 \\\\ -2 & 2 & 1 \\\\ 8 & -7 & -4\\end{bmatrix}\\begin{bmatrix}0 \\\\ 7 \\\\ -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 10 \\\\ -33\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the solution is $x=3,$ $y=10,$ $z=-33.$"} {:db/id #edb/ref 17592186092037 :question/id #uuid "667cc169-01b1-5cd1-88ae-6a36335e1daf" :question/math-academy-id "e-5274" :question/problem "Simplify $\\left[3\\,\\textrm{cis}\\left(\\dfrac{\\pi}{4}\\right)\\right]^3$." :question/worked-solution "We use the identity\n\n$$\n\\begin{aligned}\n[r\\operatorname{cis} (θ)]^{n} &= r^{n}\\operatorname{cis} (nθ)\n\\end{aligned}\n$$\n\nwith $n=3$, $r=3$, and\n\n$$\n\\theta=\\dfrac{\\pi}{4}\n$$\n\nSubstituting in these values, we get\n\n$$\n\\begin{aligned}\n[3\\operatorname{cis} \\left(\\frac{π}{4}\\right)]^{3} &= 3^{3}\\operatorname{cis} (3 \\cdot \\frac{π}{4}) = 27\\operatorname{cis} \\left(\\frac{3π}{4}\\right)\n\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\nr\\,\\textrm{cis}(\\theta) = r \\left[ \\cos (\\theta) +\\textrm{i}\\sin(\\theta) \\right]\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\n27\\operatorname{cis} \\left(\\frac{3π}{4}\\right) &= 27[\\cos \\left(\\frac{3π}{4}\\right) + \\textrm{i}\\sin \\left(\\frac{3π}{4}\\right)] \\\\\n&= 27(-\\frac{\\sqrt{2}}{2} + \\textrm{i}\\frac{\\sqrt{2}}{2}) \\\\\n&=-\\frac{27\\sqrt{2}}{2} + \\frac{27\\sqrt{2}}{2}\\textrm{i}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092072 :question/id #uuid "3e096041-22f8-5b7e-88d7-eca10203a379" :question/math-academy-id "e-5470" :question/problem "![](images/e8/e8ff769df4089e6ed9a47d56d7317acf41b8aef6a255abc705c0e7ec31a446ea.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $\\mathbf{T}$ with the standard matrix $T,$ given below?\n$$\nT =\n{\\left[ \\begin{array}{cc}4 & 2 \\\\ - 1 & 2\\end{array} \\right]}\n$$" :question/worked-solution "Recall that for any linear transformation $\\mathbf{T},$ we have the following connection between the area of $D$ and the area of the image $\\mathbf{T}(D)$ under the action of $\\mathbf{T}\\mathbin{:}$\n\n$$\n\\text{Area}(\\mathbf{T}(D)) = |\\det(T)| \\cdot \\text{Area}(D)\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D) = \\frac{1}{2} \\cdot 3 \\cdot 4 = 6.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\n\\det(T) = 4 \\cdot 2 -  2 \\cdot (-1) = 10.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|\\det (T)|\\cdot \\text{Area}(D) \\\\  & =|\\,10\\,|\\cdot 6 \\\\  & =60.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092073 :question/id #uuid "e0f036c5-c27d-5a0e-aeb1-cb7c99b49691" :question/math-academy-id "e-5471" :question/problem "A triangle $D$ has vertices $(1,1)$, $(4,5),$ and $(-2,1).$ What is the area of the image of $D$ under the action of the linear transformation $\\mathbf{T}$ with the standard matrix $T,$ given below?\n$$\nT =\n{\\left[ \\begin{array}{cc}- 7 & 5 \\\\ - 2 & 3\\end{array} \\right]}\n$$" :question/worked-solution "First, let's sketch our region:\n\n![](images/ee/ee8f0cf16983d87fa505303ed6372a3f389518d05b3e13f2e9e2121038792b84.png)\n\nRecall that for any linear transformation $\\mathbf{T},$ we have the following connection between the area of $D$ and the area of the image $\\mathbf{T}(D)$ under the action of $\\mathbf{T}\\mathbin{:}$\n\n$$\n\\text{Area}(\\mathbf{T}(D)) = |\\det(T)| \\cdot \\text{Area}(D)\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D) = \\dfrac{1}{2} \\cdot 3 \\cdot 4 = 6.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\n\\det(T) = (-7) \\cdot 3 -  5 \\cdot (-2) = -11.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|\\det (T)|\\cdot \\text{Area}(D) \\\\  & =|-11|\\cdot 6 \\\\  & =66.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092074 :question/id #uuid "aebe3048-cc5b-5340-a15e-d577ae2ee72a" :question/math-academy-id "e-5479" :question/problem "Find the characteristic equation of the matrix \n$$\nA=\n{\\left[ \\begin{array}{cc}2 & 4 \\\\ 3 & 2\\end{array} \\right]}.\n$$" :question/worked-solution "First, we find the matrix $\\, A-\\lambda I\\mathbin{:}$\n﻿﻿﻿$A - \\lambda I = \n{\\left[ \\begin{array}{cc}2 - \\lambda  & 4 \\\\ 3 & 2 - \\lambda \\end{array} \\right]}.$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 4 \\\\ 3 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(2-\\lambda )-4\\cdot 3 & =0 \\\\ 4-4\\lambda +{\\lambda }^{2}-12 & =0 \\\\ {\\lambda }^{2}-4\\lambda -8 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092075 :question/id #uuid "55e695b2-4581-5ba7-9604-506234b88323" :question/math-academy-id "e-5480" :question/problem "Find all real eigenvalues of the matrix\n$$\nB= {\\left[ \\begin{array}{cc}4 & 0 \\\\ 0 & 4\\end{array} \\right]}.\n$$" :question/worked-solution "Let's start by writing the matrix $B-\\lambda I\\mathbin{:}$\n$$\nB - \\lambda I = \n{\\left[ \\begin{array}{cc}4 - \\lambda  & 0 \\\\ 0 & 4 - \\lambda \\end{array} \\right]}\n$$\n\nNow, let's find and solve the characteristic equation $\\det(B-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}\\det (B-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 \\\\ 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(4-\\lambda )-0\\cdot 0 & =0 \\\\ (\\lambda -4)^{2} & =0\\end{aligned}\n$$\n\nTherefore, the matrix $B$ has only one eigenvalue $\\lambda=4,$ which is a double root of the characteristic equation. \n\n**Note:** We also say that $\\lambda=4$ has an **algebraic multiplicity** of $2.$"} {:db/id #edb/ref 17592186092076 :question/id #uuid "a42d0af8-869c-5c2a-8182-22b14b9546e2" :question/math-academy-id "e-5481" :question/problem "Find all real eigenvalues of the matrix $A={\\left[ \\begin{array}{cc}10 & 3 \\\\ 6 & 7\\end{array} \\right]}.$" :question/worked-solution "Let's start by writing the matrix $A - \\lambda I\\mathbin{:}$\n﻿﻿$A - \\lambda I = \n{\\left[ \\begin{array}{cc}10 - \\lambda  & 3 \\\\ 6 & 7 - \\lambda \\end{array} \\right]}$\n\nNow, let's find and solve the characteristic equation $\\det(A-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}10-\\lambda  & 3 \\\\ 6 & 7-\\lambda \\end{vmatrix} & =0 \\\\ (10-\\lambda )(7-\\lambda )-3\\cdot 6 & =0 \\\\ 70-7\\lambda -10\\lambda +{\\lambda }^{2}-18 & =0 \\\\ {\\lambda }^{2}-17\\lambda +52 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{17\\pm \\sqrt{(-17)^{2}-4\\cdot 1\\cdot 52}}{2\\cdot 1} \\\\  & =\\frac{17\\pm \\sqrt{81}}{2} \\\\  & =\\frac{17\\pm 9}{2} \\\\  & =13,4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda=13$ and $\\lambda=4.$"} {:db/id #edb/ref 17592186092077 :question/id #uuid "9e40836e-18e9-5df6-a930-05875b920335" :question/math-academy-id "e-5482" :question/problem "Find all real eigenvalues of the matrix $A={\\left[ \\begin{array}{cc}3 & 0 \\\\ 9 & - 2 \\sqrt{3}\\end{array} \\right]}.$" :question/worked-solution "Let's start by writing the matrix $A - \\lambda I \\mathbin{:}$\n﻿﻿﻿$A - \\lambda I = \n{\\left[ \\begin{array}{cc}3 - \\lambda  & 0 \\\\ 9 & - 2 \\sqrt{3} - \\lambda \\end{array} \\right]}$\n\nNow, let's find and solve the characteristic equation $\\det (A - \\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 0 \\\\ 9 & -2\\sqrt{3}-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-2\\sqrt{3}-\\lambda )-9\\cdot 0 & =0 \\\\ (\\lambda -3)(\\lambda +2\\sqrt{3}) & =0\\end{aligned}\n$$\n\nSo, we get the eigenvalues $\\lambda={\\color{red}3}$ and $\\lambda={\\color{blue}-2\\sqrt{3}}.$\n\nIf we look again at the matrix $\\,A={\\left[ \\begin{array}{cc}{\\color{red}3} & 0 \\\\ 9 & {\\color{blue}- 2 \\sqrt{3}}\\end{array} \\right]},$\nwe see that the eigenvalues are the entries on the main diagonal. This is true in general: the eigenvalues of a *triangular* or *diagonal* matrix are *always* given by the entries on the main diagonal!\n\n**Watch out!** For a general matrix (which is neither triangular nor diagonal), this might not be the case!"} {:db/id #edb/ref 17592186092082 :question/id #uuid "86835544-a7f1-5be2-99c1-14e39a14f3fd" :question/math-academy-id "e-603" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=e^t(\\cos{t}+\\sin{t}), \\quad y=e^t(\\cos{t}-\\sin{t}) , \\quad t\\in \\left[0,\\dfrac{\\pi}{4}\\right].\n$$\n\n![](images/15/15d185178bf8882f837c19361d630c0e537e145ca2337cad4655677255d0348a.png)" :question/worked-solution "Computing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\  & =2{e}^{t}\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\  & =-2{e}^{t}\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(2{e}^{t}\\operatorname{cos}⁡t)}^{2}+{(-2{e}^{t}\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{4{e}^{2t}({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}2{e}^{t}\\,\\text{d}t \\\\  & =2{e}^{t}{|}_{0}^{\\pi /4} \\\\  & =2({e}^{\\pi /4}-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092089 :question/id #uuid "0d1dcc59-e7af-5a86-87ba-aa7ee1b23767" :question/math-academy-id "e-632" :question/problem "Find the area bounded by the polar curve $r = \\cos(3\\theta)$ and the lines $\\theta = -\\dfrac{\\pi}{6}$ and $\\theta = \\dfrac{\\pi}{6}.$\n\n![](images/35/350a721c254dab3a8acb2ae54ca5be0bcde6ab036e6936939194c57ae55fe4ff.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = \\cos(3\\theta),$ $\\theta_1=-\\dfrac{\\pi}{6},$ and $\\theta_2=\\dfrac{\\pi}{6},$ this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}{\\cos }^{2}⁡(3\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /6}^{\\pi /6}(1+\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}(\\theta {|}_{-\\pi /6}^{\\pi /6}+\\frac{1}{6}\\operatorname{sin}⁡(6\\theta ){|}_{-\\pi /6}^{\\pi /6}) \\\\  & =\\frac{1}{4}((\\frac{\\pi }{6}-\\left(-\\frac{\\pi }{6}\\right))+\\frac{1}{6}(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡(-\\pi ))) \\\\  & =\\frac{1}{4}(\\frac{\\pi }{3}+0) \\\\  & =\\frac{\\pi }{12}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092090 :question/id #uuid "6040d180-ed1d-52b8-809c-b5820352d3d8" :question/math-academy-id "e-633" :question/problem "Find the area bounded by the polar curve $r = 1+2\\cos\\theta$ for $$\n\\displaystyle \\dfrac{2\\pi}{3} \\leq \\theta \\leq \\dfrac{4\\pi}{3},\n$$ as shown below.\n\n![](images/6b/6bfa0990b560bcb09f2a9eb0b9542296f2a8f1c196b6740702e81c59941d66c5.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = 1+2\\cos(\\theta),$ $\\theta_1=\\dfrac{2\\pi}{3},$ and $\\theta_2=\\dfrac{4\\pi}{3},$ this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+2\\operatorname{cos}⁡(\\theta ))^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+4\\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\cdot \\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+2\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+\\operatorname{sin}⁡(2\\theta )\\,{|}_{2\\pi /3}^{4\\pi /3}) \\\\  & =\\frac{1}{2}(3\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+\\operatorname{sin}⁡(2\\theta )\\,{|}_{2\\pi /3}^{4\\pi /3}) \\\\  & =\\frac{1}{2}(2\\pi -4\\sqrt{3}+\\sqrt{3}) \\\\  & =\\frac{1}{2}(2\\pi -3\\sqrt{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092091 :question/id #uuid "8a885f78-0028-5b6e-80e6-1215f5d934a2" :question/math-academy-id "e-639" :question/problem "Find the **total** area of the shaded region that lies between the polar curves $r=2\\cos(2\\theta)$ and $r=1,$ as shown below.\n\n![](images/7c/7c023033b4d3e0fa6ea5a2d9866688e360b759fba6aa0a5dd6241e148d7b093d.png)" :question/worked-solution "Consider the rightmost pair of petals. First, we find the values of $\\theta$ for which the two curves intersect:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡(2\\theta ) & =1 \\\\ \\operatorname{cos}⁡(2\\theta ) & =\\frac{1}{2}\\end{aligned}\n$$\n\nThis gives us two solutions for $2\\theta \\in [-\\pi,\\pi]$:\n\n$$\n2\\theta = -\\dfrac{\\pi}{3}, \\dfrac{\\pi}{3} \\qquad \\Longrightarrow \\qquad \\theta= -\\dfrac{\\pi}{6}, \\dfrac{\\pi}{6}\n$$\n\nTo determine which is the inner function and which is the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/1d/1dc9ce9add3d7135f69c92590ebde003d4e5ee31446d6202222ac890e2f42a9c.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=1,$ and\n\n- *leaves* through the outer function $r=2\\cos(2\\theta).$\n\nTo find the area, we use the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} \\Big( \\big[ {\\color{brown}\\text{outer}} \\big]^2 - \\big[ {\\color{blue}\\text{inner}} \\big]^2 \\Big) \\:\\textrm{d}\\theta,\n$$\n\nwhere\n\n$\\qquad$ $\\theta_1=-\\dfrac{\\pi}{6}, \\quad$ and $\\quad \\theta_2=\\dfrac{\\pi}{6}.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}((2\\operatorname{cos}⁡(2\\theta ))^{2}-{1}^{2})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(4{\\cos }^{2}⁡(2\\theta )-1)\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(2(1+\\operatorname{cos}⁡(4\\theta ))-1)\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(1+2\\operatorname{cos}⁡(4\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}\\theta {|}_{-\\pi /6}^{\\pi /6}+\\frac{1}{4}\\operatorname{sin}⁡(4\\theta ){|}_{-\\pi /6}^{\\pi /6} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{6}-\\left(-\\frac{\\pi }{6}\\right))+\\frac{1}{4}(\\operatorname{sin}⁡\\frac{2\\pi }{3}-\\operatorname{sin}⁡\\left(-\\frac{2\\pi }{3}\\right)) \\\\  & =\\frac{\\pi }{6}+\\frac{1}{4}(\\frac{\\sqrt{3}}{2}-\\left(-\\frac{\\sqrt{3}}{2}\\right)) \\\\  & =\\frac{\\pi }{6}+\\frac{\\sqrt{3}}{4}.\\end{aligned}\n$$\n\nTherefore, the total area is\n\n$$\n\\begin{aligned}A & =4{A}_{1}=4(\\frac{\\pi }{6}+\\frac{\\sqrt{3}}{4})=\\frac{2\\pi }{3}+\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092092 :question/id #uuid "c30d91c2-ee63-5b20-ab39-6d356f711fd8" :question/math-academy-id "e-640" :question/problem "Find the shaded area that lies between the polar curves $r=\\sin\\theta$ and $r=2\\sin\\theta,$ as shown below.\n\n![](images/23/2389273b09df3e9bc9262a2daed848fbd518707e683e5d06a8dd0217766036bb.png)" :question/worked-solution "First, we find the values of $\\theta$ for which the two curves intersect:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡\\theta  & =\\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =0\\end{aligned}\n$$\n\nThis gives us two solutions for $\\theta \\in \\left[0,\\pi\\right]\\mathbin{:}$\n\n$$\n\\theta = 0, \\pi\n$$\n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/4c/4ce437c0d6b1f196269c5c1e56e687a6dca21fd407834dce20bfa7ac76298002.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=\\sin\\theta,$ and\n\n- *leaves* through the outer function $r=2\\sin\\theta.$\n\nTo find the area, we use the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} \\Big( \\big[ {\\color{brown}\\text{outer}} \\big]^2 - \\big[ {\\color{blue}\\text{inner}} \\big]^2 \\Big) \\:\\textrm{d}\\theta,\n$$\n\nwhere\n\n$\\qquad$ $\\theta_1=0, \\quad$ and $\\quad \\theta_2=\\pi.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{0}^{\\pi }((2\\operatorname{sin}⁡\\theta )^{2}-(\\operatorname{sin}⁡\\theta )^{2})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }3{\\sin }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{3}{4}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{3}{4}(\\theta -\\frac{\\operatorname{sin}⁡2\\theta }{2}){|}_{0}^{\\pi } \\\\  & =\\frac{3}{4}[(\\pi -\\frac{\\operatorname{sin}⁡(2\\pi )}{2})-(0-\\frac{\\operatorname{sin}⁡0}{2})] \\\\  & =\\frac{3\\pi }{4}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092093 :question/id #uuid "57034318-5a6e-53f6-a8d3-ae8c61692947" :question/math-academy-id "e-641" :question/problem "![](images/0b/0bb9e5e7315d4bcd5fc21700fdd2597f6d9b585a109145de53c6f94e9530eabf.png)\n\nFind the arc length of the polar curve $r=2(1-\\cos\\theta)$ for $0 \\leq \\theta \\leq \\pi$ (shown in blue in the picture above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta)$ is given by\n\n$$\nL =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=2(1-\\cos\\theta),$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = 2\\sin\\theta.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(2-2\\operatorname{cos}⁡\\theta )^{2}+{(2\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4-8\\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta +4{\\sin }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4-8\\operatorname{cos}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1-\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now use the half-angle formula $1-\\cos\\theta =2\\sin^2\\left(\\dfrac{\\theta}{2}\\right)$ to give\n\n$$\n\\begin{aligned}L & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{2{\\sin }^{2}⁡\\left(\\frac{\\theta }{2}\\right)}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}\\cdot \\sqrt{2}\\cdot {\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right)\\,\\text{d}\\theta  \\\\  & ={-4\\cdot 2(\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right))|}_{0}^{\\pi } \\\\  & =-8(\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cos}⁡0) \\\\  & =-8(0-1) \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092105 :question/id #uuid "a2d8dca5-a0f3-5b6f-81f5-4eea46ee70d8" :question/math-academy-id "e-6822" :question/problem "![](images/d7/d7b39805131dc562e233d49a84f69d30e80ca29cb9443012032d18fdb4512054.png)\n\nFind the area bounded by the polar curve $r = 2\\sin\\theta + 2\\cos\\theta$ for $$\n\\displaystyle \\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{3\\pi}{4},\n$$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = 2\\sin\\theta + 2\\cos\\theta,$ $\\theta_1=\\dfrac{\\pi}{2},$ and $\\theta_2=\\dfrac{3\\pi}{4},$ this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(2\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(4{\\sin }^{2}⁡\\theta +8\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(4+8\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{4}{2}{\\int }_{\\pi /2}^{3\\pi /4}(1+\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{3\\pi /4}-\\frac{\\operatorname{cos}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{3\\pi /4}) \\\\  & =2\\theta \\,{|}_{\\pi /2}^{3\\pi /4}-\\operatorname{cos}⁡(2\\theta )\\,{|}_{\\pi /2}^{3\\pi /4} \\\\  & =2(\\frac{3\\pi }{4}-\\frac{\\pi }{2})-(\\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right)-\\operatorname{cos}⁡(\\pi )) \\\\  & =\\frac{\\pi }{2}-1 \\\\  & =\\frac{\\pi -2}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092113 :question/id #uuid "5bae6269-2112-56ea-b123-bee58701cf87" :question/math-academy-id "e-7130" :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$$\n\\displaystyle x=t, \\, y=\\ln{(\\cos{t})}\n$$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](images/48/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(\\operatorname{cos}⁡t))=-\\operatorname{tan}⁡t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(1)}^{2}+{(-\\operatorname{tan}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+{\\tan }^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{\\sec }^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡t\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092123 :question/id #uuid "dd29a0e8-2912-531e-a44c-62aa6d604273" :question/math-academy-id "e-7361" :question/problem "Find an integral expression that gives the shaded area between the polar curves $r=2\\cos(3\\theta)$ and $r=1,$ as shown below.\n\n![](images/9f/9fdeb4d842f141d702027e7a2ec3e7618eacd57c3c97119f851dd2497d8ee813.png)" :question/worked-solution "Consider the rightmost petal, oriented along the $x$-axis. First, we find the values of $\\theta$ for which the two curves intersect:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡(3\\theta ) & =1 \\\\ \\operatorname{cos}⁡(3\\theta ) & =\\frac{1}{2}\\end{aligned}\n$$\n\nThis gives us two solutions for $3\\theta \\in \\left[-\\pi,\\pi\\right]\\mathbin{:}$\n\n$$\n3\\theta = -\\dfrac{\\pi}{3}, \\dfrac{\\pi}{3} \\qquad \\Longrightarrow \\qquad \\theta= -\\dfrac{\\pi}{9}, \\dfrac{\\pi}{9}\n$$\n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/89/8950c8f5e8ea54736714e83f584ccc4b164cdee53cf3c3f64a8e0c9f81f16e6a.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=1,$ and\n\n- *leaves* through the outer function $r=2\\cos(3\\theta).$\n\nTo find the area, we use the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} \\Big( \\big[ {\\color{brown}\\text{outer}} \\big]^2 - \\big[ {\\color{blue}\\text{inner}} \\big]^2 \\Big) \\:\\textrm{d}\\theta,\n$$\n\nwhere\n\n$\\qquad$ $\\theta_1=-\\dfrac{\\pi}{9}, \\quad$ and $\\quad \\theta_2=\\dfrac{\\pi}{9}.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{-\\pi /9}^{\\pi /9}[{(2\\operatorname{cos}⁡(3\\theta ))}^{2}-{1}^{2}]\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /9}^{\\pi /9}(4{\\cos }^{2}⁡(3\\theta )-1)\\text{d}\\theta \\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092124 :question/id #uuid "4bc28849-2812-5b53-a2da-36198c06e290" :question/math-academy-id "e-7362" :question/problem "Find an integral expression that gives the area of the shaded region that lies between the polar curves $r=\\cos\\theta$ and $r=\\sin\\theta,$ as shown below.\n\n*Hint: In the first quadrant, the curves intersect when $\\theta=\\dfrac{\\pi}{4}$ and $\\theta=\\dfrac{\\pi}{2}.$* \n\n![](images/7f/7fcd600ef6c13f5c643ffa929fa44f5dfa683f9af5555ac97ed5540a9f09d9b3.png)" :question/worked-solution "We are given that our curves intersect when $\\theta_1= \\dfrac{\\pi}{4}$ and $\\theta_2=\\dfrac{\\pi}{2}.$ \n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/7f/7f016c0657ffc3566d32248d9fcb62bbb4cea73777188b7bf7843e93feb16f88.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=\\cos\\theta,$ and\n\n- *leaves* through the outer function $r=\\sin\\theta.$\n\nTo find the area, we use the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} \\Big( \\big[ {\\color{brown}\\text{outer}} \\big]^2 - \\big[ {\\color{blue}\\text{inner}} \\big]^2 \\Big) \\:\\textrm{d}\\theta,\n$$\n\nwhere\n\n$\\qquad$ $\\theta_1= \\dfrac{\\pi}{4}, \\quad$ and $\\quad \\theta_2=\\dfrac{\\pi}{2}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{\\pi /4}^{\\pi /2}{(\\operatorname{sin}⁡\\theta )}^{2}-{(\\operatorname{cos}⁡\\theta )}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{\\pi /2}({\\sin }^{2}⁡\\theta -{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{\\pi /2}-\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta  \\\\  & =-\\frac{1}{2}{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092125 :question/id #uuid "8b8e3c66-fc60-57ac-baf7-0661e213d01e" :question/math-academy-id "e-7400" :question/problem "![](images/e5/e5647c0f19727d1e626e637464cc57444e0bc0f2f8e99a4afd15d3c3631dc3f0.png)\n\nFind an integral expression for the arc length of the polar curve $r=3-\\sin(7\\theta)$ for $0 \\leq \\theta \\leq \\pi,$ shown in blue in the diagram above." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta)$ is given by\n\n$$\nL =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=3-\\sin(7\\theta),$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} =-7\\cos(7\\theta)\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(3-\\operatorname{sin}⁡(7\\theta ))^{2}+(-7\\operatorname{cos}⁡(7\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9-6\\operatorname{sin}⁡(7\\theta )+{\\sin }^{2}⁡(7\\theta )+49{\\cos }^{2}⁡(7\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9-6\\operatorname{sin}⁡(7\\theta )+{\\sin }^{2}⁡(7\\theta )+{\\cos }^{2}⁡(7\\theta )+48{\\cos }^{2}⁡(7\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9-6\\operatorname{sin}⁡(7\\theta )+1+48{\\cos }^{2}⁡(7\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{10-6\\operatorname{sin}⁡(7\\theta )+48{\\cos }^{2}⁡(7\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092129 :question/id #uuid "53c7a748-dadb-516e-879b-92cd0c986041" :question/math-academy-id "e-7454" :question/problem "What is the area scale factor of the linear transformation $\\mathbf{T}$ that is given by its standard matrix \n$$\nT = \n{\\left[ \\begin{array}{cc}2 & 3 \\\\ 1 & 4\\end{array} \\right]}?\n$$" :question/worked-solution "The area scale factor of a linear transformation $\\mathbf T$ with standard matrix $T$ is equal to $|\\det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|\\det (T)| & =|2\\cdot 4-3\\cdot 1| \\\\  & =|8-3| \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092136 :question/id #uuid "6fc6a60d-11e9-56c1-9328-0179059d4c56" :question/math-academy-id "e-8389" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\operatorname{arsinh} {2} =$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\operatorname{arsinh}  x$ is \n\n$$\n\\operatorname{arsinh} {x} =\\ln\\left(x+\\sqrt{x^2+1}\\right).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\operatorname{arsinh} {2} & = \\ln\\left(2 + \\sqrt{2^2+1}\\right)\\\\[5pt]\n\t\t\t\t\t\t\t   \n& = \\ln\\left(2 + \\sqrt{4+1}\\right)\\\\[5pt]\n\t\t\t\t\t\t\t \n&=\\ln\\left(2 + \\sqrt 5\\right).\n\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092137 :question/id #uuid "a8951542-ff6f-5b96-a287-b4c7f928b572" :question/math-academy-id "e-8390" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\operatorname{arcosh} {3} =$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\operatorname{arcosh} {x}$ is \n\n$$\n\\operatorname{arcosh} {x} = \\ln\\left(x+\\sqrt{x^2-1}\\right).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\operatorname{arcosh} {3}\n                                                       \n& = \\ln\\left(3+\\sqrt{3^2-1}\\right)\\\\[3pt]\n\t\t\t\t\t\t\t   \n& = \\ln\\left(3+\\sqrt{9-1}\\right)\\\\[3pt]\n\n& = \\ln\\left(3+\\sqrt{8}\\right)\\\\[3pt]\n\t\t\t\t\t\t\t \n&=\\ln{\\left(3+2\\sqrt{2}\\right)}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092138 :question/id #uuid "13299051-2164-5d54-b90e-52c7a8f1d7f2" :question/math-academy-id "e-8391" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\operatorname{artanh} \\left ( \\dfrac{1}{2} \\right ) =$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\operatorname{artanh} {x}$ is \n\n$$\n\\operatorname{artanh} {x} = \\dfrac{1}{2}\\ln\\left(\\dfrac{1+x}{1-x}\\right).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\operatorname{artanh} \\left ( \\dfrac{1}{2} \\right )\n                \n& = \\dfrac{1}{2}\\ln\\left(\\dfrac{1+\\dfrac{1}{2}}{1-\\dfrac{1}{2}}\\right)\\\\[5pt]\n\t\t\n&=\\dfrac{1}{2}\\ln\\left(\\dfrac{\\dfrac{3}{2}}{\\dfrac{1}{2}}\\right)\\\\[5pt]\n\t\t\n&=\\dfrac{1}{2}\\ln{3}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092140 :question/id #uuid "4fbdc166-4225-5fa5-aaa2-0f09073e8e2e" :question/math-academy-id "e-8768" :question/problem "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nUsing the definition of the hyperbolic sine, calculate $f^{-1}(x)$ given that $f(x) = \\sinh{\\left(x^2\\right)}$ and $x \\geq 0.$" :question/worked-solution "$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\nLet $y = \\sinh{\\left(x^2\\right)}.$\nSince $x \\geq 0,$ we have $y \\geq 0.$\n\nTo find the inverse function we swap $x$ and $y{:}$\n\n$$\nx = \\sinh{\\left(y^2\\right)},\n$$\n\nwhere $x\\in[0,\\infty)$ and $y\\in[0,\\infty).$\n\nNext, we apply the definition of $\\sinh x{:}$\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}({e}^{{y}^{2}}-{e}^{-{y}^{2}}) \\\\ 2x & ={e}^{{y}^{2}}-{e}^{-{y}^{2}} \\\\ 2x{e}^{{y}^{2}} & ={e}^{2{y}^{2}}-1\\end{aligned}\n$$\n\nBringing everything to the left-hand side, we get\n\n$$\n\\begin{aligned}{e}^{2{y}^{2}}-2x{e}^{{y}^{2}}-1 & =0 \\\\ {({e}^{{y}^{2}})}^{2}-2x({e}^{{y}^{2}})-1 & =0.\\end{aligned}\n$$\n\nLet $Y = e^{y^2}.$ We can form a quadratic equation in $Y$ and solve it by completing the square, as follows:\n\n$$\n\\begin{aligned}{Y}^{2}-2xY-1 & =0 \\\\ (Y-x)^{2}-{x}^{2}-1 & =0 \\\\ (Y-x)^{2} & ={x}^{2}+1 \\\\ Y-x & =\\pm \\sqrt{{x}^{2}+1} \\\\ Y & =x\\pm \\sqrt{{x}^{2}+1} \\\\ {e}^{{y}^{2}} & =x\\pm \\sqrt{{x}^{2}+1}\\end{aligned}\n$$\n\nSince $e^{y^2} >0$ for all real $y,$ and $x -\\sqrt{x^2+1} <0,$ we must select the positive branch:\n\n$$\n\\begin{aligned}{e}^{{y}^{2}} & =x+\\sqrt{{x}^{2}+1} \\\\ \\operatorname{ln}⁡({e}^{{y}^{2}}) & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}) \\\\ {y}^{2} & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1}) \\\\ y & =\\pm \\sqrt{\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1})}\\end{aligned}\n$$\n\nFinally, since we require $y\\ge 0,$ we select the positive solution. Therefore,\n\n$$\nf^{-1}(x) = \\sqrt{\\ln\\left(x+\\sqrt{x^2+1}\\right)}.\n$$"} {:db/id #edb/ref 17592186092471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60627aba-89ef-53b6-b4ce-ca7854856bfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186236430} {:answer/id #uuid "70edbcb1-0834-5f95-9e7a-268c0a3c7bca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186236535} {:answer/id #uuid "806bb986-60b0-52f0-9e7d-fe440e12d7b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186236617} {:answer/id #uuid "d998f6fb-b8bd-532a-8961-d0fc2000cb68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186237195} {:answer/id #uuid "da1538df-e67c-5454-aadf-6bd6796416e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186237201}] :answer-field/correct {:db/id #edb/ref 17592186237201} :answer-field/id #uuid "cb257275-f2f7-5467-9be9-cb2bc1b74739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237704}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dcf46b6f-f5d9-5eec-afdf-9ca4614f945b" :question/math-academy-id "q-10255" :question/problem "![](images/ac/ac040bc2c3eb943f947f34602c7c03e90f18e129a0fa7749d8ae60faaab12f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=t-\\operatorname{sin}⁡t,\\,y=1-\\operatorname{cos}⁡t,\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡t)=1-\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-\\operatorname{cos}⁡t)=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(1-\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1-2\\operatorname{cos}⁡t+{\\cos }^{2}⁡t+{\\sin }^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{\\sin }^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right) \\\\ \\operatorname{cos}⁡t & =1-2{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right) \\\\ 1-\\operatorname{cos}⁡t & =2{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right) \\\\ 2-2\\operatorname{cos}⁡t & =4{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right)\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{4{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\left(\\frac{t}{2}\\right)\\text{d}t \\\\  & =-2\\cdot 2\\cdot {\\operatorname{cos}⁡\\left(\\frac{t}{2}\\right)|}_{0}^{\\pi } \\\\  & =-4(\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cos}⁡0) \\\\  & =-4(0-1) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cbcb05c-0d49-5cbd-80eb-6b804f107249" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$λ = \\sqrt{3}$ and $λ = 2$" :db/id #edb/ref 17592186089268} {:answer/id #uuid "0a494e60-093c-58c4-a59c-aa2a3b60e7e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186089269} {:answer/id #uuid "323c248b-e18e-5611-b08d-9631fd900654" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$λ =-2$ and $λ = \\sqrt{3}$" :db/id #edb/ref 17592186089270} {:answer/id #uuid "479da784-7457-5ebe-ab3e-66bcab6eacf4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$λ =-2$ and $λ =-\\sqrt{3}$" :db/id #edb/ref 17592186089271} {:answer/id #uuid "5016ca94-d6c8-5940-9a53-df997f015259" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$λ = 4$ (double root)" :db/id #edb/ref 17592186089272}] :answer-field/id #uuid "aed5cf4f-5cf4-5caf-81e8-f22caef29322" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089267} {:answer-field/choices [{:answer/id #uuid "403a1993-2eb3-586b-abbd-dfbb80940fae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186395986} {:answer/id #uuid "b8a6ca2d-3dc9-5356-a637-77388249f113" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-2$ and $\\lambda =-\\sqrt{3}$" :db/id #edb/ref 17592186395987} {:answer/id #uuid "21c5c9ca-97c8-5152-9b6c-25a5632a907d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =\\sqrt{3}$ and $\\lambda =2$" :db/id #edb/ref 17592186395988} {:answer/id #uuid "87da898e-ea6a-541f-9651-68144afb0f0f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-2$ and $\\lambda =\\sqrt{3}$" :db/id #edb/ref 17592186395989} {:answer/id #uuid "46e8370f-0146-536e-a75f-2dc4592b1276" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186395990}] :answer-field/correct {:db/id #edb/ref 17592186395988} :answer-field/id #uuid "b1ec3bb9-10bd-5719-b579-dd5c85d65b96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186395985}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b1fb4b20-223a-5224-b15e-06a76416065c" :question/math-academy-id "q-11983" :question/problem "Find all real eigenvalues of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}\\sqrt{3} & 0 \\\\ 4 & 2\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}\\sqrt{3}-\\lambda  & 0 \\\\ 4 & 2-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}\\sqrt{3}-\\lambda  & 0 \\\\ 4 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (\\sqrt{3}-\\lambda )(2-\\lambda )-0\\cdot 4 & =0 \\\\ (\\lambda -\\sqrt{3})(\\lambda -2) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\sqrt{3}$ and $\\lambda =2.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."} {:db/id #edb/ref 17592186092560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09914385-0a05-5f0a-babc-48e716b5d3a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(-2,\\sqrt{15})" :db/id #edb/ref 17592186548372} {:answer/id #uuid "22382cd6-21f0-5384-9d9e-e555a766fac4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(-2,13)" :db/id #edb/ref 17592186548421} {:answer/id #uuid "2d44a4ab-bf70-577b-95d4-802bedc72e77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(-2,17)" :db/id #edb/ref 17592186548444} {:answer/id #uuid "9a5b2179-34b2-5f28-a785-1f671241e094" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(-2,\\sqrt{17})" :db/id #edb/ref 17592186548660} {:answer/id #uuid "dc53f2d3-d6bf-569d-bb68-e47e1dbbc0e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(-2,\\sqrt{13})" :db/id #edb/ref 17592186548783}] :answer-field/correct {:db/id #edb/ref 17592186548421} :answer-field/id #uuid "e35154dd-0662-5424-962f-17ec732aca8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089531}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "695d4d94-877b-5df0-9f8f-05a7c0cd7954" :question/math-academy-id "q-143542" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}1 & 1 \\\\ 1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nFind the distribution of $Y={X}_{1}-2{X}_{2}.$" :question/requires-calculator true :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{bmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ \\operatorname{Var} [Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=0$ and ${\\mu }_{2}=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}-2{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]-2\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}-2\\cdot {\\mu }_{2} \\\\  & =0-2\\cdot (1) \\\\  & =-2.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=1,{\\sigma }_{2}^{2}=4,$ and ${\\sigma }_{12}={\\sigma }_{21}=1.$ Therefore, \n\n$$\n\\begin{aligned}\\operatorname{Var} [Y] & =\\operatorname{Var} [{X}_{1}-2{X}_{2}] \\\\  & ={1}^{2}\\cdot 1+(-2)^{2}\\cdot 4+2\\cdot 1\\cdot (-2)\\cdot 1 \\\\  & =1+16-4 \\\\  & =13.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-2,13).\n$$"} {:db/id #edb/ref 17592186092570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb710060-c87a-5bc6-9114-7d3d41ec4032" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8 + 8\\frac{\\sqrt{3}}{2}\\textrm{i}" :db/id #edb/ref 17592186089592} {:answer/id #uuid "f127b73b-0829-50dd-8316-8ff5c287ba46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8 - 8\\sqrt{3}\\textrm{i}" :db/id #edb/ref 17592186089593} {:answer/id #uuid "2427c938-7a0e-555b-bab8-4243d90cb7be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8 + 8\\sqrt{3}\\textrm{i}" :db/id #edb/ref 17592186089594} {:answer/id #uuid "44953886-5297-5ddc-acd2-bff81365e3b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8 + 8\\frac{\\sqrt{3}}{2}\\textrm{i}" :db/id #edb/ref 17592186089595} {:answer/id #uuid "6d887dc1-53e5-5b16-9467-648cb19679c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8 + 8\\sqrt{2}\\textrm{i}" :db/id #edb/ref 17592186089596}] :answer-field/id #uuid "d93b9e0b-fc69-5019-b969-79f969cb055e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089591}] :question/id #uuid "c07fbf18-ad64-5018-80de-98a555e53033" :question/math-academy-id "q-15139" :question/problem "What is $[4\\operatorname{cis} \\left(\\frac{π}{3}\\right)]^{2}$?"} {:db/id #edb/ref 17592186092572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0ea08a1-9720-53ab-801d-2d2c63e34eb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32\\sqrt{2} + 32\\sqrt{2}\\textrm{i}" :db/id #edb/ref 17592186089604} {:answer/id #uuid "0f00cec2-f71a-52a2-a3e2-5adbf8637e6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\sqrt{2} - 32\\sqrt{2}\\textrm{i}" :db/id #edb/ref 17592186089605} {:answer/id #uuid "1e8d6a71-1856-5258-95e4-1fb0d98010b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16\\sqrt{2} + 8\\sqrt{2}\\textrm{i}" :db/id #edb/ref 17592186089606} {:answer/id #uuid "4ba7f16c-7354-5413-833e-70fae3f6f9c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32\\sqrt{3} + 8\\sqrt{3}\\textrm{i}" :db/id #edb/ref 17592186089607} {:answer/id #uuid "6fccf4cd-8f6e-5638-8dbb-e07f13b11d3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32\\sqrt{3} - 4\\sqrt{3}\\textrm{i}" :db/id #edb/ref 17592186089608}] :answer-field/id #uuid "3c1754a1-8e2a-5496-a250-3d29835d9604" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089603}] :question/id #uuid "3f02ee97-98c3-587d-83d6-df4090482f32" :question/math-academy-id "q-15148" :question/problem "What is $[2\\operatorname{cis} \\left(\\frac{π}{24}\\right)]^{6}$?"} {:db/id #edb/ref 17592186092575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c02db39-1323-5178-823d-035cbc0e974b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273319} {:answer/id #uuid "76f538de-df54-5fad-9a26-4e6bcab7eb7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273399} {:answer/id #uuid "7f93ecb1-ea78-5b92-86af-7eaf211452f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273483} {:answer/id #uuid "a4a2a416-fa2b-57e0-ae21-9414bcd449ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273807} {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472}] :answer-field/correct {:db/id #edb/ref 17592186274472} :answer-field/id #uuid "8d36b979-5ca7-502e-b3f6-581c418d1ffe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274874}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d674e5dc-8a57-5368-b53e-8363dba234a5" :question/math-academy-id "q-15185" :question/problem "![](images/80/80577a585741748702b61596db84983592ecbc6c01fca78af033bf82dbe62ad2.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$$\n\\displaystyle x={e}^{t},\\,y={e}^{t}\\operatorname{sin}⁡t\n$$\nfrom $t=-3$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)={e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}\\sqrt{{e}^{2t}+{e}^{2t}{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{1+{\\sin }^{2}⁡t+{\\cos }^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4c0cb8-d9a4-5c3a-9a2d-8f3bcc6f2d8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\sqrt{3}" :db/id #edb/ref 17592186548384} {:answer/id #uuid "59b192f8-8a08-5e40-93d5-ab8e3f2938f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\pi " :db/id #edb/ref 17592186548520} {:answer/id #uuid "843df82d-bd20-5e2b-8054-24ab30500319" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\sqrt{5}" :db/id #edb/ref 17592186548609} {:answer/id #uuid "bb0c62a2-2941-508f-8b34-49fd4599dbf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\pi " :db/id #edb/ref 17592186548726} {:answer/id #uuid "fca68fd5-18c4-580f-8af1-5f191fa77ca9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\sqrt{5}" :db/id #edb/ref 17592186548862}] :answer-field/correct {:db/id #edb/ref 17592186548520} :answer-field/id #uuid "e306f3ba-57fb-5958-a190-c31ffdd43476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089645}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0707e3bd-3da9-5662-809b-216f2be6b97a" :question/math-academy-id "q-159689" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector. The variances of ${X}_{1}$ and ${X}_{2}$ and their covariance are given by\n\n$$\n{\\sigma }_{1}^{2}=10,\\,{\\sigma }_{2}^{2}=5,\\,{\\sigma }_{12}=5.\n$$\n\nGiven that the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{k}\\,\\exp (-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )),\n$$\n\nwhere $\\mu $ is the mean vector and $Σ$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{pmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{pmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix}=\\begin{bmatrix}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{bmatrix}\\end{aligned}\n$$\n\nwhere ${\\sigma }_{i}^{2}=\\text{Var}[{X}_{i}],$ ${\\sigma }_{12}=\\text{Cov}[{X}_{1},{X}_{2}],$ and $\\rho $ is the correlation, then the joint probability density function of $X$ is\n\n$$\nf({x}_{1},{x}_{2})=\\frac{1}{2\\pi \\sqrt{|Σ|}}\\exp (-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu ))\n$$\n\nand $|Σ|$ denotes the determinant of $Σ.$\n\nUsing the given values of ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2}$, and ${\\sigma }_{12},$ our covariance matrix is\n\n$$\nΣ=\\begin{bmatrix}10 & 5 \\\\ 5 & 5\\end{bmatrix}.\n$$\n\nTherefore,\n\n$$\n|Σ|=10\\cdot 5-5\\cdot 5=25.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{25}}\\exp (-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{10\\pi }\\exp (-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=10\\pi .$"} {:db/id #edb/ref 17592186092580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a17a8449-31bb-525a-8ca5-1e66b4a439fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1711" :db/id #edb/ref 17592186089652} {:answer/id #uuid "a49337cb-0f46-5c90-84d8-7f669ba7f29b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1762" :db/id #edb/ref 17592186089653} {:answer/id #uuid "d019c2f7-49d1-571b-ac68-b7db432075f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1977" :db/id #edb/ref 17592186089654} {:answer/id #uuid "de43eab0-c4d8-5a9d-b725-ecc7339189c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2033" :db/id #edb/ref 17592186089655} {:answer/id #uuid "4eaee5a4-a5b3-5342-a3a6-6a78faf919f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2005" :db/id #edb/ref 17592186089656}] :answer-field/correct {:db/id #edb/ref 17592186089655} :answer-field/id #uuid "d5efdcd4-17d6-5391-871c-f2a692148bfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089651}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89c577b9-8c2b-5e60-9161-7d08d52dcc46" :question/math-academy-id "q-159694" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}1 & 1 \\\\ 1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nLet $Y={X}_{1}-2{X}_{2}.$ Calculate $P(Y\\ge 1).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.03\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.04\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.05\\,$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.8\\,$</th><td data-cell-align=\"center\">$\\,0.7967\\,$</td><td data-cell-align=\"center\">$\\,0.7995\\,$</td><td data-cell-align=\"center\">$\\,0.8023\\,$</td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.9\\,$</th><td data-cell-align=\"center\">$\\,0.8238\\,$</td><td data-cell-align=\"center\">$\\,0.8264\\,$</td><td data-cell-align=\"center\">$\\,0.8289\\,$</td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,1.0\\,$</th><td data-cell-align=\"center\">$\\,0.8485\\,$</td><td data-cell-align=\"center\">$\\,0.8508\\,$</td><td data-cell-align=\"center\">$\\,0.8531\\,$</td></tr>\n</tbody></table></div>\n\n" :question/requires-calculator true :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{bmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ \\operatorname{Var} [Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=0$ and ${\\mu }_{2}=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}-2{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]-2\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}-2\\cdot {\\mu }_{2} \\\\  & =0-2\\cdot (1) \\\\  & =-2.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=1,{\\sigma }_{2}^{2}=4,$ and ${\\sigma }_{12}={\\sigma }_{21}=1.$ Therefore, \n\n$$\n\\begin{aligned}\\operatorname{Var} [Y] & =\\operatorname{Var} [{X}_{1}-2{X}_{2}] \\\\  & ={1}^{2}\\cdot 1+(-2)^{2}\\cdot 4+2\\cdot 1\\cdot (-2)\\cdot 1 \\\\  & =1+16-4 \\\\  & =13.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(-2,13).\n$$\n\nNow, we need to compute $P(Y\\ge 1).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 1) & =P(Z\\ge \\frac{1-(-2)}{\\sqrt{13}}) \\\\  & =P(Z\\ge 0.832)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(Z\\ge 0.83) & =1-P(Z<0.83) \\\\  & =1-P(Z\\le 0.83) \\\\  & =1-Φ(0.83)\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\nΦ(0.83)=0.7967.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P(Z\\ge 0.83) & =1-Φ(0.83) \\\\  & =1-0.7967 \\\\  & =0.2033.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(Y\\ge 1)=0.2033.\n$$"} {:db/id #edb/ref 17592186092581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a20292c9-1982-585c-be36-9420091bb57e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3300" :db/id #edb/ref 17592186089658} {:answer/id #uuid "a5e8eb56-0371-5757-8469-9c0697832e0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2810" :db/id #edb/ref 17592186089659} {:answer/id #uuid "b73494d1-fc66-51a2-9f26-71a8c9140462" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2401" :db/id #edb/ref 17592186089660} {:answer/id #uuid "bc1516df-74a2-5d5b-89ee-857bc7a12a70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3062" :db/id #edb/ref 17592186089661} {:answer/id #uuid "1e0330de-9644-59fe-8b6a-f5a8dcc656bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3783" :db/id #edb/ref 17592186089662}] :answer-field/correct {:db/id #edb/ref 17592186089659} :answer-field/id #uuid "63118e31-c8a5-57cd-b21b-61395ca13c09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089657}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "719754e3-0e30-5697-91d7-a36d391d48f5" :question/math-academy-id "q-159695" :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}3 \\\\ 1 \\\\ 2\\end{bmatrix},\\,Σ=\\begin{bmatrix}2 & 1 & 1 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nLet $Y={X}_{1}+2{X}_{2}-{X}_{3}.$ Find $P(Y<1).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.05\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.06\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.07\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.5\\,$</th><td data-cell-align=\"center\">$\\,0.7088\\,$</td><td data-cell-align=\"center\">$\\,0.7123\\,$</td><td data-cell-align=\"center\">$\\,0.7157\\,$</td><td data-cell-align=\"center\">$\\,0.7190\\,$</td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.6\\,$</th><td data-cell-align=\"center\">$\\,0.7422\\,$</td><td data-cell-align=\"center\">$\\,0.7454\\,$</td><td data-cell-align=\"center\">$\\,0.7486\\,$</td><td data-cell-align=\"center\">$\\,0.7517\\,$</td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.7\\,$</th><td data-cell-align=\"center\">$\\,0.7734\\,$</td><td data-cell-align=\"center\">$\\,0.7764\\,$</td><td data-cell-align=\"center\">$\\,0.7794\\,$</td><td data-cell-align=\"center\">$\\,0.7823\\,$</td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.8\\,$</th><td data-cell-align=\"center\">$\\,0.8023\\,$</td><td data-cell-align=\"center\">$\\,0.8051\\,$</td><td data-cell-align=\"center\">$\\,0.8078\\,$</td><td data-cell-align=\"center\">$\\,0.8106\\,$</td></tr>\n</tbody></table></div>\n\n" :question/requires-calculator true :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ \\operatorname{Var} [Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y={X}_{1}+2{X}_{2}-{X}_{3},$ we have \n\n$$\nc=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}.\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =\\begin{bmatrix}1 & 2 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =3+2-2 \\\\  & =3,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =\\begin{bmatrix}1 & 2 & -1\\end{bmatrix}\\begin{bmatrix}2 & 1 & 1 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\  & =3+10-1 \\\\  & =12.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(3,12).\n$$\n\nNow, we need to compute $P(Y<1).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y<1) & =P(Z<\\frac{1-3}{\\sqrt{12}}) \\\\  & =P(Z<-0.58)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(Z<-0.58) & =P(Z\\le -0.58) \\\\  & =Φ(-0.58).\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\nΦ(0.58)=0.7190.\n$$\n\nBy the symmetry of the normal distribution, we have\n\n$$\nΦ(-0.58)=1-Φ(0.58)=1-0.7190=0.2810.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P(Z<-0.58)=0.2810.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(Y<1)=0.2810.\n$$"} {:db/id #edb/ref 17592186092602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d280c1f-3e76-55d8-ac14-ba38ed573031" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459641} {:answer/id #uuid "e59ee5d2-6a44-57d6-8fca-2ab4dfa82d0e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459642}] :answer-field/correct {:db/id #edb/ref 17592186459641} :answer-field/id #uuid "6bd85771-4fdf-5781-aec0-77a096dcc550" :answer-field/key "${1}_{A\\,\\cap \\,B}\\,(5)=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460687} {:answer-field/choices [{:answer/id #uuid "932e5b72-2412-5425-a69f-1c5c9b00d4cb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459643} {:answer/id #uuid "ff2bf056-35d3-5548-b9d8-14d1a0e85708" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459644}] :answer-field/correct {:db/id #edb/ref 17592186459644} :answer-field/id #uuid "003c01a6-9fc8-5470-b192-529dcc80605f" :answer-field/key "${1}_{A\\,\\cap \\,B}\\,(5)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460688} {:answer-field/choices [{:answer/id #uuid "139e8020-5633-5b5f-aa89-637381683bba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459645} {:answer/id #uuid "c9da6006-39ab-5503-a7b6-1bedab9fe445" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459646}] :answer-field/correct {:db/id #edb/ref 17592186459645} :answer-field/id #uuid "10569c31-698f-5e42-8b38-fb51c01be650" :answer-field/key "$5\\in A\\cap B$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460689} {:answer-field/choices [{:answer/id #uuid "13645072-43f8-5b1a-a593-c4bbe6872a88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186667978} {:answer/id #uuid "ef351941-03e8-5292-b46a-6284349c311c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186667979}] :answer-field/correct {:db/id #edb/ref 17592186667978} :answer-field/id #uuid "184fb33e-46b3-52b2-abbc-ea6e7899de6a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186668266}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dbfb19de-ef84-5bc1-a24a-a4632bbb8c2c" :question/math-academy-id "q-172721" :question/problem "$$\n{1}_{A}(5)=1,\\,{1}_{B}(5)=0\n$$\n\nGiven the values of the indicator functions of the sets $A$ and $B,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =\\min \\{{1}_{A}(x),{1}_{B}(x)\\} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =\\max \\{{1}_{A}(x),{1}_{B}(x)\\}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement ${1}_{A\\,\\cap \\,B}\\,(5)=1$ is false while statement ${1}_{A\\,\\cap \\,B}\\,(5)=0$ is true. We have\n\n$$\n\\begin{aligned}{1}_{A\\,\\cap \\,B}\\,(5) & =\\min \\{{1}_{A}(5),{1}_{B}(5)\\} \\\\  & =\\min \\{1,0\\} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement $5\\in A\\cap B$ is false. Since ${1}_{A\\,\\cap \\,B}\\,(5)=0,$ we conclude that $5$ does not belong to $A\\cap B.$\n\nTherefore, the correct answer is ${1}_{A\\,\\cap \\,B}\\,(5)=0$ only."} {:db/id #edb/ref 17592186092604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d76cebc-b6fb-5524-8283-b87a8706d0a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186089796} {:answer/id #uuid "a035904c-4fe1-5a9f-a9bf-e49750aa30b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186089797} {:answer/id #uuid "f97d5917-25f1-5529-9b0f-beee8799d9a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186089798} {:answer/id #uuid "48009762-6e64-51c1-8c34-e8d675fca580" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186089799} {:answer/id #uuid "678c699c-69d3-50d3-949b-5005fc07d7cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186089800}] :answer-field/correct {:db/id #edb/ref 17592186089797} :answer-field/id #uuid "88da4f35-85b0-53f0-a65f-db9edf474b77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186089795}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bab9e63e-a883-5b00-876f-108808a6cc8e" :question/math-academy-id "q-172723" :question/problem "$$\n{1}_{A}(5)=1,\\,{1}_{B}(5)=0\n$$\n\nGiven the values of the indicator functions of the sets $A$ and $B,$ which of the following statements are true?\n\nI. ${1}_{A\\,\\cup \\,B}\\,(5)=1$\n\nII. ${1}_{A\\,\\cup \\,B}\\,(5)=0$\n\nIII. $5\\in A\\cup B$" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =\\min \\{{1}_{A}(x),{1}_{B}(x)\\} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =\\max \\{{1}_{A}(x),{1}_{B}(x)\\}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{A\\,\\cup \\,B}\\,(5) & =\\max \\{{1}_{A}(5),{1}_{B}(5)\\} \\\\  & =\\max \\{1,0\\} \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{A\\,\\cup \\,B}\\,(5)=1,$ we conclude that $5$ belongs to $A\\cup B.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186092628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b4da550-43d1-5bf0-ba07-2d9c8866fa45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi -8}{2}" :db/id #edb/ref 17592186528557} {:answer/id #uuid "87cb5c61-72c1-5207-ac68-6c4fc40a404e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi +8}{2}" :db/id #edb/ref 17592186528625} {:answer/id #uuid "9c7ba2fb-9f38-56bc-8fe5-e96e6dbabc3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi +8}{4}" :db/id #edb/ref 17592186528675} {:answer/id #uuid "a23714c3-4f78-5ba1-a107-d1e73692eea4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi +4}{2}" :db/id #edb/ref 17592186528692} {:answer/id #uuid "f974103f-b624-52cf-acc4-f3366c464e19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186528919}] :answer-field/correct {:db/id #edb/ref 17592186528557} :answer-field/id #uuid "3d48976e-ecd9-52fe-8371-edaabd05c065" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186090051}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb2c5d25-e3ba-5c5d-9450-482e68e4a749" :question/math-academy-id "q-20640" :question/problem "![](images/4a/4a83949bcdf4ed8d99cac451d6db21986c24819d1601578890f86fe3df99666a.png)\n\nFind the area bounded by the polar curve $r=2+2\\operatorname{cos}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\pi ,$ as shown above." :question/requires-calculator true :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2+2\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(2+2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(4+8\\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{4}{2}{\\int }_{\\pi /2}^{\\pi }(1+2\\operatorname{cos}⁡\\theta +{\\cos }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{\\pi })) \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{\\pi /2}^{\\pi }) \\\\  & =3\\theta \\,{|}_{\\pi /2}^{\\pi }+4\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{\\pi } \\\\  & =3(\\pi -\\frac{\\pi }{2})+4(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right))+\\frac{1}{2}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(\\pi )) \\\\  & =\\frac{3\\pi }{2}-4+\\frac{1}{2}(0) \\\\  & =\\frac{3\\pi -8}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e42bea0-ae31-5c53-973d-aa17ac450933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-4\\lambda -4=0" :db/id #edb/ref 17592186321378} {:answer/id #uuid "3c9bdffb-21f8-5d69-a0bd-17fe65627150" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-4\\lambda +4=0" :db/id #edb/ref 17592186321615} {:answer/id #uuid "3f87dd55-fd67-54f3-a30e-392aed0248a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}+3\\lambda +9=0" :db/id #edb/ref 17592186321646} {:answer/id #uuid "ac110cfb-d9fa-56d7-95de-4b61052b6737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-1=0" :db/id #edb/ref 17592186322495} {:answer/id #uuid "f703d3fa-fa27-5c44-95ed-f194c20cdf12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}+4\\lambda +4=0" :db/id #edb/ref 17592186323086}] :answer-field/correct {:db/id #edb/ref 17592186323086} :answer-field/id #uuid "7d352f44-669a-5112-9b66-540b684a29de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323418}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "21a76447-bb7c-5d72-a771-38739632e899" :question/math-academy-id "q-36758" :question/problem "Find the characteristic equation of the matrix $A=\\begin{bmatrix}2 & 2 \\\\ -8 & -6\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}2-\\lambda  & 2 \\\\ -8 & -6-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 2 \\\\ -8 & -6-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-6-\\lambda )-(-8)\\cdot 2 & =0 \\\\ -12-2\\lambda +6\\lambda +{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2}+4\\lambda +4 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24a537b1-5dc1-566a-9e74-e2dcfcb05234" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =6$ and $\\lambda =10$" :db/id #edb/ref 17592186321430} {:answer/id #uuid "2f09fc12-e77b-5d3a-8bf5-3206a98228e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186321511} {:answer/id #uuid "8109cdb3-fff2-519d-b607-3ccd4eadccb8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =8$ and $\\lambda =5$" :db/id #edb/ref 17592186322162} {:answer/id #uuid "aa2951cc-d69d-5205-be76-aee83aade18c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-6$ and $\\lambda =-10$" :db/id #edb/ref 17592186322485} {:answer/id #uuid "da37b8b4-b86c-52be-9edf-4d44daca250f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =8$ (double root)" :db/id #edb/ref 17592186322856}] :answer-field/correct {:db/id #edb/ref 17592186321511} :answer-field/id #uuid "255562d5-b67b-5f8c-b0e9-9ed67cabbd41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323241}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f563abe4-0d8d-5d69-9a75-20dcd9079f0b" :question/math-academy-id "q-36776" :question/problem "Find all real eigenvalues of the matrix\n$$\n\\displaystyle Q=\\begin{bmatrix}-6 & -3 \\\\ 2 & -10\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}-6-\\lambda  & -3 \\\\ 2 & -10-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $\\det (Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\det (Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}-6-\\lambda  & -3 \\\\ 2 & -10-\\lambda \\end{vmatrix} & =0 \\\\ (-6-\\lambda )(-10-\\lambda )-(-3)\\cdot 2 & =0 \\\\ 60+6\\lambda +10\\lambda +{\\lambda }^{2}+6 & =0 \\\\ {\\lambda }^{2}+16\\lambda +66 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & ={16}^{2}-4\\cdot 1\\cdot 66 \\\\  & =256-264 \\\\  & =-8 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions, and therefore, $Q$ does not have real eigenvalues."} {:db/id #edb/ref 17592186092709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1c5547-1ac6-53d1-b475-3c1f3a7a7421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186327355} {:answer/id #uuid "cc9bc47f-e4a1-5a48-ad95-9fdc8c30c725" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186328727} {:answer/id #uuid "e561604b-c400-5b31-b7b4-38788bbd36a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186328943} {:answer/id #uuid "ee8db0ff-6f78-5797-8626-bb072f3b6837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186329018} {:answer/id #uuid "ef36cb4d-9cd4-585e-b2e1-dfd00cf7e9a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186329023}] :answer-field/correct {:db/id #edb/ref 17592186327355} :answer-field/id #uuid "b8241441-5d37-5b80-8d02-80f7b14d12b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329508}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "be9d95c2-a710-5571-987b-8cd6ddd0d0ab" :question/math-academy-id "q-42449" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\left\\{\\begin{aligned}2x-3+z &=0 \\\\ 5y-1+3x &=2z+1 \\\\ 3z+2x-1 &=2y\\end{aligned}\\right.\n$$\n\nFind  $x+y+z.$" :question/worked-solution "First, let's rewrite the system in the correct order:\n\n$$\n\\left\\{\\begin{aligned}2x+z &=3 \\\\ 3x+5y-2z &=2 \\\\ 2x-2y+3z &=1\\end{aligned}\\right.\n$$\n\nNext, we  write the system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n\\begin{bmatrix}2 & 0 & 1 \\\\ 3 & 5 & -2 \\\\ 2 & -2 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}.\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}\\det (A) & =\\begin{vmatrix}2 & 0 & 1 \\\\ 3 & 5 & -2 \\\\ 2 & -2 & 3\\end{vmatrix} \\\\  & =2\\begin{vmatrix}5 & -2 \\\\ -2 & 3\\end{vmatrix}-0+\\begin{vmatrix}3 & 5 \\\\ 2 & -2\\end{vmatrix} \\\\  & =2(15-4)+(-6-10) \\\\  & =22-16 \\\\  & =6.\\end{aligned}\n$$\n\n \n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}5 & -2 \\\\ -2 & 3\\end{vmatrix} & \\begin{vmatrix}3 & -2 \\\\ 2 & 3\\end{vmatrix} & \\begin{vmatrix}3 & 5 \\\\ 2 & -2\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 1 \\\\ -2 & 3\\end{vmatrix} & \\begin{vmatrix}2 & 1 \\\\ 2 & 3\\end{vmatrix} & \\begin{vmatrix}2 & 0 \\\\ 2 & -2\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 1 \\\\ 5 & -2\\end{vmatrix} & \\begin{vmatrix}2 & 1 \\\\ 3 & -2\\end{vmatrix} & \\begin{vmatrix}2 & 0 \\\\ 3 & 5\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}11 & 13 & -16 \\\\ 2 & 4 & -4 \\\\ -5 & -7 & 10\\end{bmatrix}.\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=\\begin{bmatrix}11 & -13 & -16 \\\\ -2 & 4 & 4 \\\\ -5 & 7 & 10\\end{bmatrix}.\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=\\begin{bmatrix}11 & -2 & -5 \\\\ -13 & 4 & 7 \\\\ -16 & 4 & 10\\end{bmatrix}.\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{\\det (A)}{C}^{T}=\\frac{1}{6}\\begin{bmatrix}11 & -2 & -5 \\\\ -13 & 4 & 7 \\\\ -16 & 4 & 10\\end{bmatrix}.\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{6}\\begin{bmatrix}11 & -2 & -5 \\\\ -13 & 4 & 7 \\\\ -16 & 4 & 10\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}24 \\\\ -24 \\\\ -30\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ -4 \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nTherefore, $x+y+z=4-4-5=-5.$"} {:db/id #edb/ref 17592186092732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070b1605-3f0f-5052-807c-9e2da26f1b13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{(5x-2)\\operatorname{ln}⁡(3)}" :db/id #edb/ref 17592186525221} {:answer/id #uuid "2d8415e7-55ff-5ae3-b4f6-b66c8c1d541d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{(5x-2)}" :db/id #edb/ref 17592186525312} {:answer/id #uuid "4f82f8a5-4d83-5410-bc3d-5d0dbb832acc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{(2x-5)\\operatorname{ln}⁡(5)}" :db/id #edb/ref 17592186525407} {:answer/id #uuid "7e998750-c647-5300-8e4d-ccc8bad0a0cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{(5x-2)\\operatorname{ln}⁡(5)}" :db/id #edb/ref 17592186525520} {:answer/id #uuid "845c0b40-9827-530c-894b-969a75a5872a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{(5x-2)\\operatorname{ln}⁡(3)}" :db/id #edb/ref 17592186525539}] :answer-field/correct {:db/id #edb/ref 17592186525221} :answer-field/id #uuid "80eb6a81-e7b7-57ed-8210-04192f46d9f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186090592}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6612d2f1-5666-54fd-9c5c-1217f3a2dfe0" :question/math-academy-id "q-48008" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y={\\log }_{3}⁡(5x-2).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={\\log }_{3}⁡(u),\\,u=5x-2.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{u\\operatorname{ln}⁡(3)},\\,\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u\\operatorname{ln}⁡(3)}\\cdot 5 \\\\  & =\\frac{1}{(5x-2)\\operatorname{ln}⁡(3)}\\cdot 5 \\\\  & =\\frac{5}{(5x-2)\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48fb4307-6ed3-5c9c-b575-3ba634b07a24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{{cos}^{2}⁡(2\\theta )-4{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186330604} {:answer/id #uuid "4d66b536-d432-592f-a552-3d83dea6fff4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{{cos}^{2}⁡(2\\theta )+{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186330653} {:answer/id #uuid "aed125a5-00ff-5286-9d0e-22a4dfe0b47e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{{cos}^{2}⁡(2\\theta )+4{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186331494} {:answer/id #uuid "bc622ef6-2ea5-5738-a6db-23a2ff317b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{{sin}^{2}⁡(2\\theta )+4{cos}^{2}⁡(2\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186331610} {:answer/id #uuid "c74a4616-57fa-5359-a03f-682fd7db8330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{{sin}^{2}⁡(2\\theta )+2{cos}^{2}⁡(2\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186331713}] :answer-field/correct {:db/id #edb/ref 17592186331494} :answer-field/id #uuid "2a1ff240-3ade-5343-b0cf-fe6ee4dd31c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332268}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1df0a62-d91d-5d2f-932b-891ad126ab27" :question/math-academy-id "q-51198" :question/problem "Which of the following gives the arc length of the polar curve $r=\\operatorname{cos}⁡(2\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{3}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{cos}⁡(2\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{sin}⁡(2\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{(\\operatorname{cos}⁡(2\\theta ))^{2}+(-2\\operatorname{sin}⁡(2\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{\\cos }^{2}⁡(2\\theta )+4{\\sin }^{2}⁡(2\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b33f62-1c4b-5eb7-9b68-a0bdc8010e29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(1+2\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta " :db/id #edb/ref 17592186546264} {:answer/id #uuid "7f68387b-522e-502d-9a1b-91419e23d1a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{\\pi /6}^{5\\pi /6}(2-2\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta " :db/id #edb/ref 17592186546534} {:answer/id #uuid "91ea854b-1461-5935-b266-98df8a735f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{\\pi /6}^{5\\pi /6}(1+2\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta " :db/id #edb/ref 17592186546572} {:answer/id #uuid "eed08439-af4a-5586-a170-387a4884b0ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(2+2\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta " :db/id #edb/ref 17592186546788} {:answer/id #uuid "f5f7e6c5-fc20-5849-b326-89fcb36dc209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /2}(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta " :db/id #edb/ref 17592186546804}] :answer-field/correct {:db/id #edb/ref 17592186546264} :answer-field/id #uuid "f7de1137-af83-5dbc-a6d6-01c665e55f57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186090790}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "223cc6ef-68a5-5f2e-83a6-238009c2a928" :question/math-academy-id "q-51268" :question/problem "![](images/2d/2db9a6bb859b74c6755dc79261372f58c87b8378d4acc997cad819c32d5faf18.png)\n\nWhich of the following gives the area of the shaded region that lies between the polar curves $r=2\\operatorname{cos}⁡\\theta $ and $r=1,$ as shown above?" :question/worked-solution "First, we find the values of $\\theta $ for which the two curves intersect:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡\\theta  & =1 \\\\ \\operatorname{cos}⁡\\theta  & =\\frac{1}{2}\\end{aligned}\n$$\n\nWe have two solutions: \n\n$\\,$ $\\theta =-\\frac{\\pi }{3},\\frac{\\pi }{3}$    \n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/d8/d802b734480b75e6e8e16f49c84fb4685cbcd6ddbdc33c8c40b29de7dc7c3824.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=1,$ and\n\n- *leaves* through the outer function $r=2\\operatorname{cos}⁡\\theta .$\n\nTo find the area, we use the formula\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}\\theta ,\n$$\n\n \n\nwhere\n\n$\\,$ ${\\theta }_{1}=-\\frac{\\pi }{3}\\,$ and $\\,{\\theta }_{2}=\\frac{\\pi }{3}.$    \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(4{\\cos }^{2}⁡\\theta -1))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(1+2\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f2c80a-d585-5a1b-a6cf-4bf7d8d37eb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186355153} {:answer/id #uuid "6a23fbcc-05e8-5db0-8dc8-a17157353f37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186355601} {:answer/id #uuid "762a042f-abf4-5263-a895-2f32e4b8ec08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186355699} {:answer/id #uuid "b878533b-b908-58a8-88a5-cf162499f7f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186356281} {:answer/id #uuid "d9883d1d-7aed-598f-b250-adbdcb6374e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186356572}] :answer-field/correct {:db/id #edb/ref 17592186355601} :answer-field/id #uuid "06526027-3b2f-5cc0-bb6a-ad2676da0aa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186356926}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fdc48455-0a40-5b7f-be99-05aa87be4ff6" :question/math-academy-id "q-9294" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=\\begin{bmatrix}1 & 5 \\\\ 0 & -2\\end{bmatrix}?\n$$" :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|\\det (T)|.$ Therefore,\n\n$$\n\\begin{aligned}|\\det (T)| & =|1\\cdot (-2)-5\\cdot 0| \\\\  & =|-2-0| \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70f6fa8e-1e5a-58a0-b4ab-dab81fb4a222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186355663} {:answer/id #uuid "7c5e1b14-0805-5969-ba99-5f0034f0f3d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186355757} {:answer/id #uuid "7c6809c9-5dea-5efb-8094-39c7f28cc4c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186355759} {:answer/id #uuid "d0a107fc-06d0-5262-a219-b4ac264bd35a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186356490} {:answer/id #uuid "f33a4a36-3176-54df-95f1-6b9795ca03ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186356790}] :answer-field/correct {:db/id #edb/ref 17592186355757} :answer-field/id #uuid "eee38f98-422f-5a90-9660-1d19870bbc4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357333}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34fb5c40-9873-55cf-a77d-c4a2ec2ac3ac" :question/math-academy-id "q-9297" :question/problem "The unit square $D$ has vertices $(1,0),(0,0),(0,1),(1,1).$ What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}7 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$" :question/worked-solution "First, let's sketch our region:\n\n![](images/3c/3cbf4ce4422e043cedb73e9b10bba11e9cb1e64352ff182eff8aaa0046c4e8f3.png)\n\nRecall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|\\det (T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=1\\cdot 1=1.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\n\\det (T)=7\\cdot (-1)-0\\cdot 0=-7.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|\\det (T)|\\cdot \\text{Area}(D) \\\\  & =|-7|\\cdot 1 \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56526058-2de7-50b1-af1f-f31bc13fc216" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186373389} {:answer/id #uuid "3232cdac-596d-5d9d-816d-4d7aa9f578b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186373390} {:answer/id #uuid "a09403fc-caf5-5041-9b82-6ff989f83d29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186373391} {:answer/id #uuid "b5fc5385-17ff-54bb-ad6b-39a7b2a2fc88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186373392} {:answer/id #uuid "8d84d121-5d99-5cbd-ae03-eec69944053a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186373393}] :answer-field/correct {:db/id #edb/ref 17592186373392} :answer-field/id #uuid "2c35337d-0220-5fd3-aac4-e29b8a8ca843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373388}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "acdb6914-4298-5f30-86cf-26ee03d852ff" :question/math-academy-id "q-9300" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=\\begin{bmatrix}7 & 1 \\\\ 5 & 5\\end{bmatrix}?\n$$" :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|\\det (T)|.$ Therefore,\n\n$$\n\\begin{aligned}|\\det (T)| & =|7\\cdot 5-1\\cdot 5| \\\\  & =|35-5| \\\\  & =30.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43f7a022-23ac-53c8-a81d-072f503d8fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186355270} {:answer/id #uuid "4d646465-2c5a-5ca4-b933-806b037217a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\pi " :db/id #edb/ref 17592186355353} {:answer/id #uuid "519ae3d6-ebd2-56c4-b611-9fffaf2c2e43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80\\pi " :db/id #edb/ref 17592186355392} {:answer/id #uuid "67a53918-48e6-591c-9e5b-8d73080dc4da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "160" :db/id #edb/ref 17592186355583} {:answer/id #uuid "d5647ae4-bc8a-51dc-8452-b54a04fb4241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\pi " :db/id #edb/ref 17592186356532}] :answer-field/correct {:db/id #edb/ref 17592186356532} :answer-field/id #uuid "e1640760-c633-5dbb-a8f2-26644e16ddb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357318}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45faf24d-552b-523b-9d7b-94bb05598c82" :question/math-academy-id "q-9302" :question/problem "![](images/4f/4f31b9f180b1b766451685428fc289766832fe5d0c7d8902a601ebf060eab0e7.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}-2 & -1 \\\\ 0 & 5\\end{bmatrix}.\n$$" :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|\\det (T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\pi \\cdot {2}^{2}=4\\pi .\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\n\\det (T)=(-2)\\cdot 5-(-1)\\cdot 0=-10.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|\\det (T)|\\cdot \\text{Area}(D) \\\\  & =|-10|\\cdot 4\\pi  \\\\  & =40\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387e4d1f-ffff-549c-ae36-b18c3b2031ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186091616} {:answer/id #uuid "0f9c7839-7769-5b9e-b9cb-6a4582448142" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =8$ and $\\lambda =-5$" :db/id #edb/ref 17592186446638} {:answer/id #uuid "86cab0f8-b15d-5ea1-8e36-97308b179e3a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-8$ and  $\\lambda =5$" :db/id #edb/ref 17592186446675} {:answer/id #uuid "c3c98ca9-4231-5356-a04c-0710da85992a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =0$ and $\\lambda =-5$" :db/id #edb/ref 17592186446692} {:answer/id #uuid "d968872b-bafd-5fbf-be0b-0478c03ae541" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-5$ (double root)" :db/id #edb/ref 17592186446701}] :answer-field/correct {:db/id #edb/ref 17592186446638} :answer-field/id #uuid "2fc34f16-51f9-5f2d-8f00-589e55c33860" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091612}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ecc70e1-e461-5246-9098-c27aa6c114e3" :question/math-academy-id "q-9341" :question/problem "Find all real eigenvalues of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}-4 & 2 \\\\ 6 & 7\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}-4-\\lambda  & 2 \\\\ 6 & 7-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-4-\\lambda  & 2 \\\\ 6 & 7-\\lambda \\end{vmatrix} & =0 \\\\ (-4-\\lambda )(7-\\lambda )-2\\cdot 6 & =0 \\\\ -28-7\\lambda +4\\lambda +{\\lambda }^{2}-12 & =0 \\\\ {\\lambda }^{2}-3\\lambda -40 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{3\\pm \\sqrt{(-3)^{2}+4\\cdot 1\\cdot 40}}{2} \\\\  & =\\frac{3\\pm \\sqrt{169}}{2} \\\\  & =\\frac{3\\pm 13}{2} \\\\  & =8,-5.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =8$ and $\\lambda =-5.$"} {:db/id #edb/ref 17592186092903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d80dad0-53c0-5d27-b5bd-04bb58893f9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186091620} {:answer/id #uuid "18d67bdb-601f-58e7-8b75-d3e4da748215" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =1$ and $\\lambda =4$" :db/id #edb/ref 17592186446641} {:answer/id #uuid "4a33786d-34fc-5151-8170-2a142f2702df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-2$  (double root)" :db/id #edb/ref 17592186446654} {:answer/id #uuid "89b8c0e6-ae99-51c1-8e85-66f98539ea38" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =2$  (double root)" :db/id #edb/ref 17592186446676} {:answer/id #uuid "f1455b86-25c6-5810-8b96-3462621d7ca7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =4$ and $\\lambda =4$" :db/id #edb/ref 17592186446709}] :answer-field/correct {:db/id #edb/ref 17592186446676} :answer-field/id #uuid "7fe56ff3-6e9f-5f5f-b666-d2ba2dce775a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d64c1c7-5e2c-5d9e-ad36-647b8fb50a8a" :question/math-academy-id "q-9346" :question/problem "Find all real eigenvalues of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}3 & 1 \\\\ -1 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}3-\\lambda  & 1 \\\\ -1 & 1-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $\\det (A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 1 \\\\ -1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(1-\\lambda )+1\\cdot 1 & =0 \\\\ 3-3\\lambda -\\lambda +{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2}-4\\lambda +4 & =0 \\\\ (\\lambda -2)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, the matrix $A$ has only one eigenvalue $\\lambda =2,$ which is a double root of the characteristic equation."} {:db/id #edb/ref 17592186092922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190a5314-e72d-527b-aa9e-4c0079dd688c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186357971} {:answer/id #uuid "1bee1bb4-be7d-5d20-8d21-32d53d01088d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186357991} {:answer/id #uuid "a7a0db5f-5c7a-5f5e-a290-e7a1248188e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186359199} {:answer/id #uuid "be699b03-471d-5316-a2b6-92062d60c4b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186359416} {:answer/id #uuid "efdd4d3d-453e-5e4d-8a75-09e728ac5829" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186359891}] :answer-field/correct {:db/id #edb/ref 17592186357971} :answer-field/id #uuid "7a502992-4bc8-5b1f-9a6e-579818ef462a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360195}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dfaa6223-b113-5398-adeb-e8d8b6d36965" :question/math-academy-id "q-9532" :question/problem "![](images/08/085be1e624ae99afee256d2a9591f17d2f33f688364b6e59fdcd7c415206bda7.png)\n\nFind the arc length of the polar curve $r=2\\operatorname{sin}⁡\\theta $ for $$\n\\displaystyle \\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}\n$$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{(2\\operatorname{sin}⁡\\theta )^{2}+{(2\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{4({\\sin }^{2}⁡\\theta +{\\cos }^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{\\pi /2}^{5\\pi /6}1\\,\\text{d}\\theta  \\\\  & =2\\theta {|}_{\\pi /2}^{5\\pi /6} \\\\  & =2(\\frac{5\\pi }{6}-\\frac{\\pi }{2}) \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "875d7ca4-7a0d-5f26-b878-2dc0465b3840" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (\\sqrt{w} + \\sqrt{w + 1})" :db/id #edb/ref 17592186091745} {:answer/id #uuid "ac8f5e96-bbce-5f83-906d-6d3a2b51841b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (2\\sqrt{w} + 1)" :db/id #edb/ref 17592186091746} {:answer/id #uuid "212a60ad-9bd4-510b-94ee-3e59a201ed2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (w + \\sqrt{w} + 1)" :db/id #edb/ref 17592186091747} {:answer/id #uuid "4767c923-e714-5654-b53f-429956eed283" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (w + \\sqrt{w + 1})" :db/id #edb/ref 17592186091748} {:answer/id #uuid "51a7c729-6d7e-5aa1-b9e6-409205e5240d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (w + \\sqrt{\\sqrt{w} + 1})" :db/id #edb/ref 17592186091749}] :answer-field/id #uuid "1ddf0e7e-658b-54b6-a8be-c67e4150f41e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091744}] :question/id #uuid "dab9b20a-fc24-5fd3-9387-a7929eb53caf" :question/math-academy-id "q-95606" :question/problem "Given that $w \\ge 0$, which of the following is equivalent to $\\operatorname{arsinh}  \\sqrt{w}$?"} {:db/id #edb/ref 17592186092926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbead542-d753-5b46-9d05-7809a93bcff0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{7 - u}{7 + u}\\right)" :db/id #edb/ref 17592186091757} {:answer/id #uuid "241d998d-54b4-5b77-9039-44d506437224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{7u + 1}{7u - 1}\\right)" :db/id #edb/ref 17592186091758} {:answer/id #uuid "498638b3-a272-5a26-a609-7e707dc7024b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{u + 7}{u - 7}\\right)" :db/id #edb/ref 17592186091759} {:answer/id #uuid "4f88bbbe-0992-50b1-a850-a6b97af484db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{u - 7}{u + 7}\\right)" :db/id #edb/ref 17592186091760} {:answer/id #uuid "651ee9c6-3503-52d5-8bc1-553eb636d13d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{u + 7}{7 - u}\\right)" :db/id #edb/ref 17592186091761}] :answer-field/id #uuid "d374882f-4778-551b-b1fe-f816c5440eac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091756}] :question/id #uuid "502fc288-40d5-53a0-89bc-4f72b012ddda" :question/math-academy-id "q-95620" :question/problem "Given that $u ∈ (-7, 7)$, which of the following is equivalent to $\\operatorname{artanh}  \\left(-\\frac{u}{7}\\right)$?"} {:db/id #edb/ref 17592186092927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "829d2602-04e7-5eda-9abc-ae903b9ca85d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (2\\sqrt{2} - 1)" :db/id #edb/ref 17592186091763} {:answer/id #uuid "b1fc84fa-ce90-5c7e-8b62-f70021a87e73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (2 - \\sqrt{2})" :db/id #edb/ref 17592186091764} {:answer/id #uuid "f1462520-a0d4-5fba-9299-3b82180ba57a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (2\\sqrt{2} + 1)" :db/id #edb/ref 17592186091765} {:answer/id #uuid "025baf8d-2ae8-5933-afdf-3ec8d4422ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (\\sqrt{2} + 1)" :db/id #edb/ref 17592186091766} {:answer/id #uuid "18afa070-e6cb-575a-981f-dc836227b4a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (\\sqrt{2} + 3)" :db/id #edb/ref 17592186091767}] :answer-field/id #uuid "aca5897e-a679-525f-ade6-aa969090af9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091762}] :question/id #uuid "5694806e-f178-50a0-9a44-97e34d1abe01" :question/math-academy-id "q-9586" :question/problem "What is $\\operatorname{arcosh}  \\sqrt{2}$?"} {:db/id #edb/ref 17592186092928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81dda91c-adad-5110-b121-67b64e5983b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (1 + \\sqrt{2})" :db/id #edb/ref 17592186091769} {:answer/id #uuid "8c7457e2-dae3-5ba6-9cd6-f7e049b7d322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (2\\sqrt{2})" :db/id #edb/ref 17592186091770} {:answer/id #uuid "c96f31c6-5694-58a2-b836-abe0bcc3006c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln (\\sqrt{2} - 1)" :db/id #edb/ref 17592186091771} {:answer/id #uuid "1a385f8b-af7f-503c-990b-1ffe5aae3c60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186091772} {:answer/id #uuid "6e0b8efb-d1ca-50e7-910b-d98bb4dcafb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln 2" :db/id #edb/ref 17592186091773}] :answer-field/id #uuid "6896c475-76b7-56d2-a1a8-ee654a3e5697" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091768}] :question/id #uuid "dd0a0045-d225-5941-89d0-3aabbd23688a" :question/math-academy-id "q-9589" :question/problem "What is $\\operatorname{arsinh}  (-1)$?"} {:db/id #edb/ref 17592186092929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83208a45-1944-502a-be7d-8ac652ff6834" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln 2" :db/id #edb/ref 17592186091775} {:answer/id #uuid "970438ba-6445-5a1a-9e2c-4f8d68b26e6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\ln 2" :db/id #edb/ref 17592186091776} {:answer/id #uuid "9baea8a1-f60c-5207-b3b9-0563b921a289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\ln 2" :db/id #edb/ref 17592186091777} {:answer/id #uuid "16772058-3273-5420-8bb5-4fb6e7a5416a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\ln 2" :db/id #edb/ref 17592186091778} {:answer/id #uuid "647ca3f7-9830-5e7e-95d0-ab0307433e8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\ln \\sqrt{2}" :db/id #edb/ref 17592186091779}] :answer-field/id #uuid "1477e992-2f94-513e-96a1-8b65a9efaec0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091774}] :question/id #uuid "13573294-7d3f-5638-91b8-642e05b1a758" :question/math-academy-id "q-9594" :question/problem "What is $\\operatorname{artanh}  \\left(\\frac{1}{3}\\right)$?"} {:db/id #edb/ref 17592186092935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149377ee-41da-5426-80f4-7eca214e8353" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi }{2}" :db/id #edb/ref 17592186566403} {:answer/id #uuid "824b7854-95c6-5e28-b075-9f3b0f0b7de9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186566610} {:answer/id #uuid "879b4088-bbd8-5c61-9ad3-2c11316f7261" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186566620} {:answer/id #uuid "94ddff8c-3225-52d1-8da7-7cb8fd933e29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186566655} {:answer/id #uuid "aceeef36-d6cc-56ff-b7e8-3dc517fd523d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi }{4}" :db/id #edb/ref 17592186566706}] :answer-field/correct {:db/id #edb/ref 17592186566403} :answer-field/id #uuid "94aaec13-9d03-5421-8bca-4274546a15c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186091810}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff59952d-8c60-571b-985b-2cd62b3bb719" :question/math-academy-id "q-9709" :question/problem "![](images/55/551cca083ab3e8ac624d119b5539574a79636b83c63574880249e52f198bfcb5.png)\n\nFind the shaded area that lies between the polar curves $r=2(1+\\operatorname{sin}⁡\\theta )$ and $r=1+\\operatorname{sin}⁡\\theta ,$ as shown above." :question/requires-calculator true :question/worked-solution "First, we find the values of $\\theta $ for which the two curves intersect:\n\n$$\n\\begin{aligned}2(1+\\operatorname{sin}⁡\\theta ) & =1+\\operatorname{sin}⁡\\theta  \\\\ 2+2\\operatorname{sin}⁡\\theta  & =1+\\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =-1\\end{aligned}\n$$\n\nThis gives us two solutions for $$\n\\displaystyle \\theta \\in [-\\frac{\\pi }{2},\\frac{3\\pi }{2}]:\n$$\n\n$$\n\\theta =-\\frac{\\pi }{2},\\frac{3\\pi }{2}\n$$\n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/d0/d0ebb3b99f66e8c1af93f1a15ff4284f5fb9a83fb4d91bad1027e18c8b447939.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=1+\\operatorname{sin}⁡\\theta ,$ and\n\n- *leaves* through the outer function $r=2(1+\\operatorname{sin}⁡\\theta ).$\n\nTo find the area, we use the formula\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}\\theta ,\n$$\n\nwhere\n\n$\\,$ ${\\theta }_{1}=-\\frac{\\pi }{2},\\,$ and $\\,{\\theta }_{2}=\\frac{3\\pi }{2}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{-\\pi /2}^{3\\pi /2}((2(1+\\operatorname{sin}⁡\\theta ))^{2}-(1+\\operatorname{sin}⁡\\theta )^{2})\\,\\text{d}\\theta  \\\\  & =\\frac{3}{2}{\\int }_{-\\pi /2}^{3\\pi /2}(1+2\\operatorname{sin}⁡\\theta +{\\sin }^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{3}{2}(\\theta {|}_{-\\pi /2}^{3\\pi /2}-2\\operatorname{cos}⁡\\theta {|}_{-\\pi /2}^{3\\pi /2}+\\frac{1}{2}{\\int }_{-\\pi /2}^{3\\pi /2}(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{3}{2}((\\frac{3\\pi }{2}+\\frac{\\pi }{2})-2(0-0)+\\frac{1}{2}\\theta {|}_{-\\pi /2}^{3\\pi /2}-\\frac{1}{4}\\operatorname{sin}⁡(2\\theta ){|}_{-\\pi /2}^{3\\pi /2}) \\\\  & =\\frac{3}{2}(2\\pi +\\frac{1}{2}(\\frac{3\\pi }{2}+\\frac{\\pi }{2})-\\frac{1}{4}(0-0)) \\\\  & =\\frac{3}{2}(2\\pi +\\pi ) \\\\  & =\\frac{9\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32a629f7-cdad-5e40-a7af-57d44a79f15c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=42,y=-35,z=-9" :db/id #edb/ref 17592186358203} {:answer/id #uuid "97b406c3-436c-57d8-91d8-6a6d532f277b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=42,y=35,z=9" :db/id #edb/ref 17592186359081} {:answer/id #uuid "bbe4c40c-106e-5783-9379-eb17253bb71e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-42,y=-35,z=9" :db/id #edb/ref 17592186359384} {:answer/id #uuid "da2241a8-e247-5ffa-bffa-9d28c1845cd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=42,y=-35,z=9" :db/id #edb/ref 17592186359661} {:answer/id #uuid "edfac0cb-1146-5514-b6e8-174d46a416bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=22,y=-45,z=-9" :db/id #edb/ref 17592186359871}] :answer-field/correct {:db/id #edb/ref 17592186359661} :answer-field/id #uuid "2fa87ff7-4613-5f53-9da8-db784a9b17ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360069}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e2cd33f-1df6-521c-a13d-e818a65472f5" :question/math-academy-id "q-9722" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\left\\{\\begin{aligned}2y+3z+x &=-1 \\\\ 4z+y &=1 \\\\ 5x+6y-3 &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "We organize the system so that it’s in the correct order first:\n\n$$\n\\left\\{\\begin{aligned}x+2y+3z &=-1 \\\\ y+4z &=1 \\\\ 5x+6y &=0\\end{aligned}\\right.\n$$\n\nWe wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ 5 & 6 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}\\det (A) & =\\begin{vmatrix}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ 5 & 6 & 0\\end{vmatrix} \\\\  & =1\\begin{vmatrix}1 & 4 \\\\ 6 & 0\\end{vmatrix}-2\\begin{vmatrix}0 & 4 \\\\ 5 & 0\\end{vmatrix}+3\\begin{vmatrix}0 & 1 \\\\ 5 & 6\\end{vmatrix} \\\\  & =1(-24)-2(-20)+3(-5) \\\\  & =1.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}1 & 4 \\\\ 6 & 0\\end{vmatrix} & \\begin{vmatrix}0 & 4 \\\\ 5 & 0\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 5 & 6\\end{vmatrix} \\\\ \\begin{vmatrix}2 & 3 \\\\ 6 & 0\\end{vmatrix} & \\begin{vmatrix}1 & 3 \\\\ 5 & 0\\end{vmatrix} & \\begin{vmatrix}1 & 2 \\\\ 5 & 6\\end{vmatrix} \\\\ \\begin{vmatrix}2 & 3 \\\\ 1 & 4\\end{vmatrix} & \\begin{vmatrix}1 & 3 \\\\ 0 & 4\\end{vmatrix} & \\begin{vmatrix}1 & 2 \\\\ 0 & 1\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 & -20 & -5 \\\\ -18 & -15 & -4 \\\\ 5 & 4 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=\\begin{bmatrix}-24 & 20 & -5 \\\\ 18 & -15 & 4 \\\\ 5 & -4 & 1\\end{bmatrix}.\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=\\begin{bmatrix}-24 & 18 & 5 \\\\ 20 & -15 & -4 \\\\ -5 & 4 & 1\\end{bmatrix}.\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{\\det (A)}{C}^{T}=\\frac{1}{1}\\begin{bmatrix}-24 & 18 & 5 \\\\ 20 & -15 & -4 \\\\ -5 & 4 & 1\\end{bmatrix}.\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}-24 & 18 & 5 \\\\ 20 & -15 & -4 \\\\ -5 & 4 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}42 \\\\ -35 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nHence the solution is $x=42,y=-35,z=9.$"} {:db/id #edb/ref 17592186093352 :tutorial/content "Suppose we would like to find the arc length of the curve defined parametrically as\n\n$$\nx=2\\cos{t}, \\quad y=2\\sin{t}\n$$\n\nfrom $t=0$ to $t=\\dfrac{\\pi}{2},$ as shown below.\n\n![](images/83/836757696669a0852812a63c8cafcf9ac3bddd73558f7b3e67c8427ec39c008a.png)\n\nIt can be shown that the arc length $L$ of a curve defined parametrically by\n\n$$\nx=x(t), \\quad y=y(t), \\qquad t\\in [t_1,t_2],\n$$\n\nis given by the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\,\\textrm{d}t.\n$$\n\nThe intuition behind this formula is given at the end of this tutorial.\n\nAccording to the formula, the length of the blue arc is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t))}^{2}+{(\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(-2\\operatorname{sin}⁡t)}^{2}+{(2\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{4({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}2\\,\\text{d}t \\\\  & =2t{|}_{0}^{\\pi /2} \\\\  & =2(\\frac{\\pi }{2}-0) \\\\  & =\\pi .\\end{aligned}\n$$" :tutorial/id #uuid "fad3b2e7-80ac-52b4-bcc3-6ba5062e2d49" :tutorial/math-academy-id 1078 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186093357 :tutorial/content "Suppose we want to find the area of the region bounded by the polar curve $r = 3\\cos\\theta$ and the rays $\\theta_1 = 0$ and $\\theta_2 = \\dfrac{\\pi}{2},$ as shown in blue in the picture below. Can we calculate this area using polar coordinates?\n\n![](images/2c/2c7e638a338aed2155ef5bf388be1f83a3a67d2296d5be09987b099a07edacbd.png)\n\nIn general, the area of the region bounded by a polar curve $r=r(\\theta)$ and the rays $\\theta=\\theta_1$ and $\\theta=\\theta_2$ is given by the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2 \\:\\textrm{d}\\theta.\n$$\n\nTherefore, the area of the half-circle above can be obtained as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(3\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}{\\cos }^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}\\frac{1}{2}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{9}{4}(\\theta {|}_{0}^{\\pi /2}+\\frac{1}{2}\\operatorname{sin}⁡(2\\theta ){|}_{0}^{\\pi /2}) \\\\  & =\\frac{9}{4}(\\frac{\\pi }{2}+0) \\\\  & =\\frac{9\\pi }{8}\\end{aligned}\n$$" :tutorial/id #uuid "37d5627c-6e4c-5ffe-b3f4-9efac9c1cc1c" :tutorial/math-academy-id 1126 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186093360 :tutorial/content "Consider the polar curves $r=2(1+\\cos\\theta)$ and $r=2.$ What is the area of the shaded region shown below?\n\n![](images/c0/c011bf3b40639e10ec151541d0892d5095b2d983b6ed03247824f06f225c10d9.png)\n\nFirst, we find the values of $\\theta$ for which the two curves intersect:\n\n$$\n\\begin{aligned}2(1+\\operatorname{cos}⁡\\theta ) & =2 \\\\ 1+\\operatorname{cos}⁡\\theta  & =1 \\\\ \\operatorname{cos}⁡\\theta  & =0\\end{aligned}\n$$\n\nThis gives us two solutions for $$\n\\displaystyle \\theta \\in \\left[-\\dfrac{\\pi}{2},\\dfrac{\\pi}{2}\\right],\n$$ namely\n\n$$\n\\theta = -\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2}\n$$\n\nTo find the area, we use the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} \\Big( \\big[ {\\color{brown}\\text{outer curve}} \\big]^2 - \\big[ {\\color{blue}\\text{inner curve}} \\big]^2 \\Big) \\:\\textrm{d}\\theta,\n$$\n\nIn our case, we have\n\n$\\qquad$ $\\theta_1=-\\dfrac{\\pi}{2}, \\quad$ and $\\quad \\theta_2=\\dfrac{\\pi}{2}.$ \n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/7b/7b77af383d0d05d00c91db364e17675dfd45445eb5ac8e2926f8bb90220bc0fe.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=2,$ and\n\n- *leaves* through the outer function $r=2(1+\\cos\\theta).$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}({(2(1+\\operatorname{cos}⁡\\theta ))}^{2}-{2}^{2})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(4(1+2\\operatorname{cos}⁡\\theta +{\\cos }^{2}⁡\\theta )-4)\\text{d}\\theta  \\\\  & =2{\\int }_{-\\pi /2}^{\\pi /2}(2\\operatorname{cos}⁡\\theta +{\\cos }^{2}⁡\\theta )\\text{d}\\theta .\\end{aligned}\n$$" :tutorial/id #uuid "87bcd4b8-6965-56b9-8f60-65d778fe217c" :tutorial/math-academy-id 1138 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186093364 :tutorial/content "We've been using the following formula to compute the arc length bounded by a polar curve:\n\n$$\nL = \\int_{\\theta_1}^{\\theta_2} \\sqrt{ r^2 + \\left( \\frac{\\textrm{d}r}{\\textrm{d}\\theta} \\right)^2} \\:\\textrm{d}\\theta\n$$\n\nBut where does this formula come from? Let's start with the familiar formula for the arc length of a parametric curve:\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left(\\frac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 +\\left(\\frac{\\textrm{d}y}{\\textrm{d}t}\\right)^2 }\\textrm{d}t\n$$\n\nA polar curve is really just a parametric curve with parameter $\\theta$ and parametric equations given by\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nWriting the arc length formula for a parametric function with parameter $\\theta,$ we have\n\n$$\nL = \\int_{\\theta_1}^{\\theta_2} \\sqrt{ \\left(\\frac{\\textrm{d}x}{\\textrm{d}\\theta}\\right)^2 +\\left(\\frac{\\textrm{d}y}{\\textrm{d}\\theta}\\right)^2 }\\textrm{d}\\theta .\n$$\n\nSince $x = r \\cos \\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(r\\operatorname{cos}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{cos}⁡\\theta +r\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nLikewise, since $y=r\\sin \\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(r\\operatorname{sin}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{sin}⁡\\theta +r\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{sin}⁡\\theta +r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSubstituting the above into our expression for $L,$ we reach the desired formula:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}\\theta }\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{(\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{sin}⁡\\theta +r\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}{\\cos }^{2}⁡\\theta +{r}^{2}{\\sin }^{2}⁡\\theta +{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}{\\sin }^{2}⁡\\theta +{r}^{2}{\\cos }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\\end{aligned}\n$$" :tutorial/id #uuid "1821e80d-8c1b-5d2f-88dd-c207d2c3d99f" :tutorial/math-academy-id 1144 :tutorial/title "Derivation of the Main Formula"} {:db/id #edb/ref 17592186093413 :tutorial/content "Remember that the\n\n$$\n\\textrm{cis}\\left(\\theta\\right)\n$$\n\nnotation is a compact notation for expressing complex numbers:\n\n$$\n\\textrm{cis}\\left(\\theta\\right) = \\cos(\\theta) + \\textrm{i} \\sin(\\theta)\n$$\n\nWe can write De Moivre's theorem in\n\n$$\n\\textrm{cis}\\left(\\theta\\right)\n$$\n\nnotation as follows:\n\n$$\n\\begin{aligned}\n[\\cos (θ) + \\textrm{i}\\sin (θ)]^{n} &= \\cos (nθ) + \\textrm{i}\\sin (nθ) \\\\\n&= ⇓ \\mid ⇓ \\\\\n[\\operatorname{cis} (θ)]^{n} &= \\operatorname{cis} (nθ)\n\\end{aligned}\n$$\n\nTherefore, to raise a complex number in the form\n\n$$\nz=r\\textrm{cis}\\left(\\theta\\right)\n$$\n\nto the power of $n$, we can use the identity\n\n$$\n\\left[r\\,\\textrm{cis}\\left(\\theta\\right)\\right]^n = r^n\\,\\textrm{cis}\\left(n\\theta\\right)\n$$" :tutorial/id #uuid "c63be7a8-c76d-510d-a36e-c18974d6e464" :tutorial/math-academy-id 3452 :tutorial/title "De Moivre's Theorem for Complex Numbers in CIS Notation"} {:db/id #edb/ref 17592186093437 :tutorial/content "Consider the shaded region $D$ shown below.\n\n![](images/ca/cae19e62492782b42b69675ec0babd005407c7db8ce4dc6d77a14da06beedfc1.png)\n\nHow can we calculate the area of the image of $D$ under the action of the linear transformation $\\mathbf{T}$ that is given by its standard matrix $$T=\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix}?$$\n\nFor any linear transformation $\\mathbf{T},$ we have the following connection between the area of $D$ and the area of the image $\\mathbf{T}(D)$ under the action of $\\mathbf{T}\\mathbin{:}$\n\n$$\\text{Area}(\\mathbf{T}(D)) = |\\det(T)| \\cdot \\text{Area}(D)$$\n\nThis equation is important. It tells us that $|\\det(T)|$ is the **area scale factor** of the transformation.\n\nFrom the diagram, we have\n\n$$\\text{Area}(D) = 2 \\cdot 3 = 6.$$\n\nComputing the determinant of $T,$ we get\n\n$$\\det(T) = 0 \\cdot 0 - (-2) \\cdot 2 = 4.$$\n\nTherefore, $$\\begin{aligned}\\text{Area}(T(D)) & =|\\det (T)|\\cdot \\text{Area}(D) \\\\ & =|\\,4\\,|\\cdot 6 \\\\ & =24.\\end{aligned}$$" :tutorial/id #uuid "3ab20008-b37c-55e5-8c73-88497d1ff8a3" :tutorial/math-academy-id 3553 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186093438 :tutorial/content "Consider the matrix $A= {\\left[ \\begin{array}{cc}2 & 5 \\\\ - 1 & - 4\\end{array} \\right]}.$ How can we find its eigenvalues?\n\nBy definition, we need to find the value(s) of $\\,\\lambda\\,$ such that $\\,A\\mathbf{\\color{blue}v} = \\lambda \\mathbf{\\color{blue}v}\\,$ is true for some *non-zero* vector $\\mathbf{\\color{blue}v}.$ Let's re-write this equation as follows:\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ Av-\\lambda v & =0 \\\\ Av-\\lambda Iv & =0 \\\\ (A-\\lambda I)v & =0\\end{aligned}\n$$\n\nThe final equation above tells us that there should be at least one non-zero vector $\\mathbf{\\color{blue}v}$ that lies in $\\textrm{Null}(A-\\lambda I)$, the null space of the matrix $A-\\lambda I.$ As a result, the invertible matrix theorem tells us that the matrix $\\, A-\\lambda I \\,$ must be singular, meaning $\\det(A-\\lambda I) = 0.$\n\nWe've reduced the problem to finding the values of $\\lambda$ that satisfy the equation\n\n$$\n\\det(A-\\lambda I) = 0,\n$$\n\nwhich is called the **characteristic equation** of the matrix $A$. So, let's solve it!\n\nFirst, we write down the matrix $A-\\lambda I\\mathbin{:}$\n\n$$\n\\begin{aligned}A\\,-\\,\\lambda I & =\\begin{bmatrix}2 & 5 \\\\ -1 & -4\\end{bmatrix}\\,-\\,\\lambda \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\,-\\,\\lambda  & 5 \\\\ -1 & -4\\,-\\,\\lambda \\end{bmatrix}\\end{aligned}\n$$\n\nThen, we solve the characteristic equation $\\det(A-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}\\det (A-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 5 \\\\ -1 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-4-\\lambda )-5\\cdot (-1) & =0 \\\\ -8-2\\lambda +4\\lambda +{\\lambda }^{2}+5 & =0 \\\\ {\\lambda }^{2}+2\\lambda -3 & =0 \\\\ (\\lambda +3)(\\lambda -1) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues of $A$ are $\\lambda=-3$ and $\\lambda=1.$" :tutorial/id #uuid "992adb24-3547-5b71-bb96-561b2f90f721" :tutorial/math-academy-id 3559 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186093454 :tutorial/content "The hyperbolic functions have inverse functions that are easy to define. The **inverse hyperbolic functions** are the following:\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n- The **inverse hyperbolic sine**, defined as\n\n$$\n\\sinh^{-1}{x} = \\operatorname{arsinh} {x} = \\ln\\big(x+\\sqrt{x^2+1}\\big), \\qquad x \\in (-\\infty, \\infty).\n$$\n\nThe graph of the inverse hyperbolic sine function is given below.\n\n![](images/1f/1f07f38b11cf297e099341df2ab062d4691c4502098c060de565b70f1ea7e360.png)\n\n- The **inverse hyperbolic cosine**, defined as\n\n$$\n\\cosh^{-1}{x} = \\operatorname{arcosh} {x} = \\ln\\big(x+\\sqrt{x^2-1}\\big), \\qquad x \\in [1, \\infty).\n$$\n\nThe graph of the inverse hyperbolic cosine function is given below.\n\n![](images/60/60607a764c50807dcb0f4f05328d900c626079654995cffbaa84fa2214788835.png)\n\n- The **inverse hyperbolic tangent**, defined as\n\n$$\n\\tanh^{-1}{x} = \\operatorname{artanh} {x} = \\dfrac12\\ln\\left(\\dfrac{1+x}{1-x}\\right), \\qquad x \\in (-1, 1).\n$$\n\nThe graph of the inverse hyperbolic tangent function is given below.\n\n![](images/96/96b4f7aa06ee165751dcaa2101e9dea104d95d5bebdaea7bc4f317d9160b5a7a.png)\n\nFor example, to calculate $\\operatorname{arcosh} (\\sqrt2)$ we substitute $x$ for $\\sqrt2$ in the formula for $\\operatorname{arcosh} $ and get\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡(\\sqrt{2}) & =\\operatorname{ln}⁡(\\sqrt{2}+\\sqrt{{(\\sqrt{2})}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(\\sqrt{2}+\\sqrt{2-1}) \\\\  & =\\operatorname{ln}⁡(\\sqrt{2}+1).\\end{aligned}\n$$" :tutorial/id #uuid "afeb7395-4188-5e5e-8d91-200a65a1cbb9" :tutorial/math-academy-id 5206 :tutorial/title "Introduction"} {:db/id #edb/ref 17592186093455 :tutorial/content "We can derive the formulas from inverse hyperbolic sine, cosine, and tangent from the definition of these base functions. \n\nFor example, let's show that\n$\\newcommand{\\operatorname{arsinh} }{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\operatorname{arcosh} }{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\operatorname{artanh} }{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\operatorname{sech} }{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\operatorname{csch} }{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\operatorname{arsech} }{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\operatorname{arcsch} }{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\operatorname{arcoth} }{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\cosh^{-1}{x} = \\operatorname{arcosh} {x} = \\ln\\big(x+\\sqrt{x^2-1}\\big), \\qquad x \\in [1, \\infty).\n$$\n\nRecall that\n\n$$\n\\cosh{x} = \\dfrac12 \\left( e^x + e^{-x} \\right).\n$$\n\nFirst, let $y = \\cosh{x}$ and $x \\geq 0.$ Then we have $y\\geq 1.$\n\nTo find the inverse function we swap $x$ and $y{:}$ \n\n$$\n\\begin{aligned}x & =\\operatorname{cosh}⁡y\\end{aligned}\n$$\n\nSo, now we have that $x \\geq 1$ and $y \\geq 0.$\n\nNext, we use the definition of $\\cosh x$ and bring everything to the left-hand side:\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}({e}^{y}+{e}^{-y}) \\\\ 2x & ={e}^{y}+{e}^{-y} \\\\ 2x{e}^{y} & ={e}^{2y}+1 \\\\ {e}^{2y}-2x{e}^{y}+1 & =0 \\\\ {({e}^{y})}^{2}-2x({e}^{y})+1 & =0.\\end{aligned}\n$$\n\nLetting $Y = e^{y},$ we form a quadratic equation in $Y$ and solve it by completing the square:\n\n$$\n\\begin{aligned}{Y}^{2}-2xY+1 & =0 \\\\ (Y-x)^{2}-{x}^{2}+1 & =0 \\\\ (Y-x)^{2} & ={x}^{2}-1 \\\\ Y-x & =\\pm \\sqrt{{x}^{2}-1} \\\\ Y & =x\\pm \\sqrt{{x}^{2}-1} \\\\ {e}^{y} & =x\\pm \\sqrt{{x}^{2}-1} \\\\ y & =\\operatorname{ln}⁡(x\\pm \\sqrt{{x}^{2}-1})\\end{aligned}\n$$\n\nNote that for  $x\\ge 1,$ we have $x-\\sqrt{x^{2}-1}\\leq 1$ and  $x+\\sqrt{x^{2}-1}\\geq 1.$ Since $y \\ge 0,$ the logarithm in the above equality must be positive, so we reject the alternative with the negative sign. This gives\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\\end{aligned}\n$$\n\nSo, we obtain our formula for $\\operatorname{arcosh} {:}$\n\n$$\nf^{-1}(x)=\n\\operatorname{arcosh} {x} = \\ln\\big(x+\\sqrt{x^2-1}\\big).\n$$" :tutorial/id #uuid "edf0d23e-aec4-5b77-befa-2433291ed5af" :tutorial/math-academy-id 5219 :tutorial/title "Deriving the Formulas for the Inverse Hyperbolic Functions"} {:db/id #edb/ref 17592186093482 :tutorial/content "Earlier, we compared the PDF of $X\\sim N(\\mu,\\sigma^2),$ given by \n\n$$\nf(x) = (2\\pi)^{-{\\color{red}1}/2 } ({\\color{blue}\\sigma^2})^{-1/2} \\: \\mathrm{exp}\\left( -\\frac{1}{2} (x-\\mu) ({\\color{blue}\\sigma^2})^{-1} (x-\\mu) \\right).\n$$\n\nand the joint PDF of a bivariate normal distribution $\\mathbf X = [X_1,X_2]^T$ with mean vector $\\boldsymbol\\mu$ and covariance matrix $\\Sigma,$ given by\n\n$$\nf(x_1, x_2) = (2\\pi)^{-{\\color{red}2}/2} {\\color{blue}|\\Sigma|}^{-1/2} \\: \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf X - \\boldsymbol \\mu)^T \\,{\\color{blue}\\Sigma}^{-1} \\,(\\mathbf X - \\boldsymbol \\mu)\\right).\n$$\n\nWe can generalize this for an arbitrary number of variables ${\\color{red}p},$ as follows:\n\n$$\nf(x_1, x_2, \\ldots, x_p) = (2\\pi)^{-{\\color{red}p}/2} {\\color{blue}|\\Sigma|}^{-1/2} \\: \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf X - \\boldsymbol \\mu)^T \\,{\\color{blue}\\Sigma}^{-1} \\,(\\mathbf X - \\boldsymbol \\mu)\\right)\n$$\n\nThe function $f(x_1, x_2, \\ldots, x_p)$ is called the **multivariate normal** density function. A random vector $\\mathbf X = [X_1,X_2,\\ldots,X_p]^T$ with this joint density function is said to follow a **multivariate normal distribution**.\n\nSimilar to the bivariate case, we can consider linear combinations of coordinates of multivariate normal random vectors: \n\n*If $\\mathbf{X} =  [X_1, X_2, \\ldots, X_k]^T$ is a multivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ then the random variable $Y,$ defined as \n\n$$\nY= \\mathbf c^T \\mathbf X = \\sum_{i=1}^k c_i X_i\n$$\n\n is a normally distributed random variable, where $\\mathbf c$ is any $k\\times 1$ column vector, and*\n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ \\operatorname{Var} [Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nNotice that the expression for the variance is a quadratic form." :tutorial/id #uuid "e2ce75d0-2db0-5254-880f-d1042f119f29" :tutorial/math-academy-id 6998 :tutorial/title "The Multivariate Normal Distribution"} {:db/id #edb/ref 17592186093483 :tutorial/content "Recall that a normally distributed random variable $X\\sim N(\\mu,\\sigma^2)$ has the probability density function\n\n$$\nf(x) = \\dfrac{1}{\\sigma \\sqrt{2\\pi}} e^{-\\frac{1}{2} \\left( \\frac{x-\\mu}{\\sigma} \\right)^2}.\n$$\n\nThis probability density function can be written as \n\n$$\nf(x) = (2\\pi)^{-{\\color{red}1}/2 } ({\\color{blue}\\sigma^2})^{-1/2} \\: \\mathrm{exp}\\left( -\\frac{1}{2} (x-\\mu) ({\\color{blue}\\sigma^2})^{-1} (x-\\mu) \\right).\n$$\n\nLet's compare this to the density function of a bivariate normal vector. First, we rewrite the joint density $f(x_1,x_2)$ of the bivariate normal distribution as follows:\n\n$$\n\\begin{aligned}f({x}_{1},{x}_{2}) & =\\frac{1}{2\\pi \\sqrt{|Σ|}}\\,\\exp (-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu )) \\\\  & =(2\\pi )^{-1}|Σ{|}^{-1/2}\\,\\exp (-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu )) \\\\  & =(2\\pi )^{-2/2}{|Σ|}^{-1/2}\\,\\exp (-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu ))\\end{aligned}\n$$\n\nBy comparing the expressions for $f(x)$ and $f(x_1,x_2),$ we see that the *bivariate* normal distribution can be considered as a generalization of the *normal distribution* from the ${\\color{red}1}$-dimensional case (when we have only one variable, $x$) to the ${\\color{red}2}$-dimensional case (when we have two variables, $x_1$ and $x_2$).\n\nThis analogy will be particularly helpful when extending the bivariate normal distribution to more than two random variables." :tutorial/id #uuid "198d2a80-9efc-509c-8852-d560b1203524" :tutorial/math-academy-id 7016 :tutorial/title "Normal Distribution vs. Bivariate Normal Distribution"} {:db/id #edb/ref 17592186093484 :tutorial/content "A linear combination of coordinates of a bivariate normal random vector generates a (one-dimensional) normal distribution:\n\n*If $\\mathbf{X} = [X_1, X_2]^T$ is a bivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ given by*\n\n$$\n\\begin{aligned}\\mu =\\begin{bmatrix}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{bmatrix},\\,Σ=\\begin{bmatrix}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{bmatrix},\\end{aligned}\n$$\n\n*then the random variable $Y,$ defined as* \n\n$$\nY= aX_1 + bX_2\n$$\n\n*is a normally distributed random variable for all values of $a$ and $b.$ Furthermore, we have that*\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ \\operatorname{Var} [Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$" :tutorial/id #uuid "62a410d8-f059-5273-ba3a-15646c153a7b" :tutorial/math-academy-id 7017 :tutorial/title "Linear Combinations of Normal Random Variables From Bivariate Distributions"} {:db/id #edb/ref 17592186093496 :tutorial/content "Recall that the indicator function of a set $A \\subseteq X$ is the function\n\n$$\n\\mathbf{1}_A(x) =\n{\\left\\{  \\begin{array}{ll}1 , & \\text{if } {x \\in A} , \\\\ 0 , & \\text{if } {x \\notin A} .\\end{array} \\right. }\n$$\n\nTherefore, the indicator function of the complement $\\overline{A}$ is given by \n\n$$\n\\mathbf{1}_{\\overline{A}}(x) =\n{\\left\\{  \\begin{array}{ll}1 , & \\text{if } {x \\in \\overline{A}} , \\\\ 0 , & \\text{if } {x \\notin \\overline{A}} .\\end{array} \\right. }\n$$\n\nThis means that the indicator function of $A$ and its complement are related as follows:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x)\\end{aligned}\n$$\n\nSimilarly, the indicator functions of $A \\cap B$ and union $A \\cup B$ can be expressed through the indicator functions of $A$ and $B.$\n\n- For the indicator function of the *intersection*, we have: \n\n$$\n\\begin{aligned}{1}_{A\\,\\cap \\,B}\\,(x) & =\\min \\{{1}_{A}(x),{1}_{B}(x)\\} \\\\  & ={1}_{A}(x)\\cdot {1}_{B}(x)\\end{aligned}\n$$\n\n- For the indicator function of the *union*, we have \n\n$$\n\\begin{aligned}{1}_{A\\,\\cup \\,B}\\,(x) & =\\max \\{{1}_{A}(x),{1}_{B}(x)\\} \\\\  & ={1}_{A}(x)+{1}_{B}(x)-{1}_{A}(x)\\cdot {1}_{B}(x).\\end{aligned}\n$$\n\nWe can prove these results by splitting them into cases." :tutorial/id #uuid "a111c445-39e3-5ddd-8272-48ef3795a3b0" :tutorial/math-academy-id 8007 :tutorial/title "Properties of Indicator Functions"} {:db/id #edb/ref 17592186096404 :question/id #uuid "a2bb6a33-8a57-5b6b-9d35-cf611fbd5c9b" :question/math-academy-id "e-185" :question/problem "If $f(x) = e^{-2x}\\tan({x^2})$, then what is $f'(x)?$" :question/worked-solution "This question requires the product rule. Let $u(x) = e^{-2x}$ and $v(x)=\\tan{(x^2)}.$ Then\n\n$$\nu'(x) = -2e^{-2x}, \\qquad v'(x) = 2x\\sec^2(x^2).\n$$\n\nNote that we used the chain rule to differentiate both $u$ and $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(-2{e}^{-2x})\\cdot \\operatorname{tan}⁡({x}^{2})+{e}^{-2x}\\cdot 2x{\\sec }^{2}⁡({x}^{2}) \\\\  & =2{e}^{-2x}(-\\operatorname{tan}⁡({x}^{2})+x{\\sec }^{2}⁡({x}^{2})) \\\\  & =2{e}^{-2x}(x{\\sec }^{2}⁡({x}^{2})-\\operatorname{tan}⁡({x}^{2})).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096407 :question/id #uuid "91e6008e-5c37-55aa-8cf6-cac61198f459" :question/math-academy-id "e-3542" :question/problem "Given that the expression $\\sqrt{2}\\sin x + \\sqrt{7}\\cos x$ can be written as $R\\sin(x+\\phi)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{2}\\sin x + \\sqrt{7}\\cos x   = R\\sin(x+\\phi),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{2}\\sin x + \\sqrt{7}\\cos x    = (R \\cos \\phi ) \\sin x + (R \\sin \\phi ) \\cos x\n$$\n\nEquating the coefficients of $\\sin x$ and $\\cos x,$ we have the following system:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{2} \\\\ R\\operatorname{sin}⁡ϕ &=\\sqrt{7}\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={\\sqrt{2}}^{2}+{\\sqrt{7}}^{2} \\\\ {R}^{2}({\\cos }^{2}⁡ϕ+{\\sin }^{2}⁡ϕ) & =2+7 \\\\ {R}^{2} & =9 \\\\ R & =3.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186096408 :question/id #uuid "557b1b6e-c54a-5fa9-85e1-3cea346c3bd3" :question/math-academy-id "e-3543" :question/problem "Write $3\\sin x-2\\cos x$ in the form $R\\sin(x-\\phi)$ with $\\phi \\in \\left( 0, \\dfrac{\\pi}{2} \\right)$. Round $\\phi$ to $3$ decimal places." :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n3 \\sin x - 2 \\cos x    = R\\sin(x-\\phi) ,\n$$\n\nwe get the following identity:\n\n$$\n3 \\sin x - 2 \\cos x   = (R \\cos \\phi ) \\sin x - (R \\sin \\phi )\\cos x\n$$\n\nEquating the coefficients of $\\sin x$ and $\\cos x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=3 \\\\ R\\operatorname{sin}⁡ϕ &=2\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2}{3} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{2}{3} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{2}{3}\\right) \\\\  & ≈0.588\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(3)^{2}+(2)^{2} \\\\ {R}^{2}({\\cos }^{2}⁡ϕ+{\\sin }^{2}⁡ϕ) & =9+4 \\\\ {R}^{2} & =13 \\\\ R & =\\sqrt{13}.\\end{aligned}\n$$\n\nNote that we only considered the positive root, since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n3\\sin(x)-2\\cos(x) \\approx \\sqrt{13} \\sin \\left(x - 0.588 \\right)\n$$"} {:db/id #edb/ref 17592186096409 :question/id #uuid "9ea36397-ab9d-5567-8b38-3e83ba624e7f" :question/math-academy-id "e-3544" :question/problem "Write $3\\cos x - \\sqrt{3}\\sin x$ in the form $R\\cos(x+\\phi)$ with $\\phi \\in \\left( 0, \\dfrac{\\pi}{2} \\right).$" :question/worked-solution "The difference formula for cosine gives\n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(x+ϕ) & =R(\\operatorname{cos}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{sin}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n3\\cos x - \\sqrt{3}\\sin x   = R\\cos(x+\\phi)\n$$\n\nwe get the following identity:\n\n$$\n3\\cos x - \\sqrt{3}\\sin x   = (R \\cos \\phi) \\cos x -( R \\sin \\phi )\\sin x\n$$\n\nEquating the coefficients of $\\sin x$ and $\\cos x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=3 \\\\ R\\operatorname{sin}⁡ϕ &=\\sqrt{3}\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{3}}{3} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{\\sqrt{3}}{3} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\n \n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{sin}⁡ϕ)}^{2}+{(R\\operatorname{cos}⁡ϕ)}^{2} & ={3}^{2}+(\\sqrt{3})^{2} \\\\ {R}^{2}({\\sin }^{2}⁡ϕ+{\\cos }^{2}⁡ϕ) & =9+3 \\\\ {R}^{2} & =12 \\\\ R & =\\sqrt{12} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n3\\cos x - \\sqrt{3}\\sin x = 2\\sqrt{3}\\cos\\left(x + \\dfrac{\\pi}{6}\\right)\n$$"} {:db/id #edb/ref 17592186096418 :question/id #uuid "6bb0eded-7277-5ab5-8c13-bfc480403b1a" :question/math-academy-id "e-3635" :question/problem "Given that $f(x)=x^2\\ln x,$ find $f'(x).$" :question/worked-solution "Here, we have the product of two functions $u(x) = x^2$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2})}^{′}\\ln ⁡x+{x}^{2}{(\\ln ⁡x)}^{′} \\\\  & =2x\\cdot \\ln ⁡x+{x}^{2}\\left(\\frac{1}{x}\\right) \\\\  & =2x\\ln ⁡x+x \\\\  & =x(2\\ln ⁡x+1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096419 :question/id #uuid "072ce609-b04d-57b0-9c7d-cbb8765c38fa" :question/math-academy-id "e-3636" :question/problem "If a curve $\\mathcal C$ is given by $y=e^x\\sin x,$ calculate the slope of the tangent line to the curve at the point where $x=\\dfrac \\pi 2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x) = e^x$ and $v(x)=\\sin{x}.$ Then, we have\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = e^x,\\qquad \\dfrac{\\textrm d v}{\\textrm d x} = \\cos x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot \\cos ⁡x+\\sin ⁡x\\cdot {e}^{x} \\\\  & ={e}^{x}(\\cos ⁡x+\\sin ⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\dfrac\\pi 2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi /2} & ={e}^{\\pi /2}(\\cos ⁡\\left(\\frac{\\pi }{2}\\right)+\\sin ⁡\\left(\\frac{\\pi }{2}\\right)) \\\\  & ={e}^{\\pi /2}(0+1) \\\\  & ={e}^{\\pi /2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $e^{\\pi/2}.$"} {:db/id #edb/ref 17592186096467 :question/id #uuid "a30b523c-d689-520a-a708-f3b5190eaf9d" :question/math-academy-id "e-477" :question/problem "Calculate the integral $$\n\\displaystyle\\int \\dfrac{1}{1-\\sin^2 x}\\,\\textrm{d}x.\n$$" :question/worked-solution "We use a variation of the Pythagorean identity:\n\n$$\n\\sin^2 x + \\cos^2 x = 1\\quad\\Longrightarrow\\quad  \\cos^2 x = 1-\\sin^2 x.\n$$\n\nUsing the above, we rewrite the denominator and calculate the resulting integral:\n\n$$\n\\begin{aligned}\\int \\frac{1}{1-{\\sin }^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{\\cos }^{2}⁡x}\\,\\text{d}x \\\\  & =\\int {\\left(\\frac{1}{\\operatorname{cos}⁡x}\\right)}^{2}\\,\\text{d}x \\\\  & =\\int {\\sec }^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096473 :question/id #uuid "6269e793-cee7-59d6-8656-12a5a7475f2a" :question/math-academy-id "e-483" :question/problem "Calculate $$\n\\displaystyle{\\int} \\sin^2(3x)  \\, \\textrm{d}x.\n$$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the $\\sin^2$ term: \n\n$$\n\\cos {2\\theta}=1-2\\sin^2\\theta.\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\dfrac{1}{2}\\left(1-\\cos {2\\theta} \\right )=\\sin^2\\theta.\n$$\n\nLetting $\\theta = 3x$, we have\n\n$$\n\\dfrac{1}{2}\\left(1-\\cos {6x} \\right )=\\sin^2(3x).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}\\int {\\sin }^{2}⁡(3x)\\,\\text{d}x & =\\int \\frac{1}{2}(1-\\operatorname{cos}⁡6x)\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int (1-\\operatorname{cos}⁡6x)\\,\\text{d}x \\\\  & =\\frac{1}{2}(x-\\frac{1}{6}\\operatorname{sin}⁡6x)+C \\\\  & =\\frac{1}{2}x-\\frac{1}{12}\\operatorname{sin}⁡6x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096476 :question/id #uuid "672d52f6-89d8-550d-863b-7c5157d59ca3" :question/math-academy-id "e-494" :question/problem "Calculate $$\n\\displaystyle \\int \\dfrac{\\log_4{x}}{x^3} \\,\\textrm{d}x.\n$$" :question/worked-solution "We define\n\n$$\n\\begin{aligned}u={\\log }_{4}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ {v}^{′}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\,\\frac{1}{2{x}^{2}}\\,.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\log }_{4}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u{v}^{′}\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={\\log }_{4}⁡x(-\\,\\frac{1}{2{x}^{2}})-\\int (-\\,\\frac{1}{2{x}^{2}})\\frac{1}{x\\operatorname{ln}⁡4}\\,\\text{d}x \\\\  & =-\\frac{1}{2{x}^{2}}\\,{\\log }_{4}⁡x+\\frac{1}{2\\operatorname{ln}⁡4}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡x}{2{x}^{2}\\operatorname{ln}⁡4}+\\frac{1}{2\\operatorname{ln}⁡4}(-\\,\\frac{1}{2{x}^{2}})+C \\\\  & =-\\frac{\\operatorname{ln}⁡x}{2{x}^{2}\\operatorname{ln}⁡4}-\\frac{1}{4{x}^{2}\\operatorname{ln}⁡4}+C \\\\  & =-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{2}\\operatorname{ln}⁡4}+C,\\end{aligned}\n$$\n\nNote that in the above calculation we used the change of base formula $\\log_4{x}=\\dfrac{\\ln{x}}{\\ln{4}}.$"} {:db/id #edb/ref 17592186096541 :question/id #uuid "b00f1213-cdaf-512c-9842-92cbee1ec63a" :question/math-academy-id "e-6100" :question/problem "Differentiate $y = \\cos^4{2x}.$" :question/worked-solution "First, we express $y$ as a composite function\n\n$$\ny = u^4, \\qquad u = \\cos{v}, \\qquad v = 2x.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = 4u^3,\\qquad \\dfrac{\\textrm{d}u}{\\textrm d v} = -\\sin{v},\\qquad \\dfrac{\\textrm{d}v}{\\textrm d x} = 2.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-\\operatorname{sin}⁡v)\\cdot (2) \\\\  & =4(\\operatorname{cos}⁡2x)^{3}\\cdot (-\\operatorname{sin}⁡2x)\\cdot (2) \\\\  & =-8{\\cos }^{3}⁡2x\\operatorname{sin}⁡2x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096542 :question/id #uuid "7a0aba38-1167-5365-bbd2-cd2ba7e57b15" :question/math-academy-id "e-612" :question/problem "Find $\\mathbf F(t)$ given that $\\mathbf F'(t)= \\langle 6t^5+2t, \\sec^2 t\\rangle.$" :question/worked-solution "Note that \n\n$$\n\\mathbf F(t)=\\int \\mathbf F'(t)\\, \\textrm d t=\\int \\left\\langle 6t^5+2t,\\, \\sec^2 t\\right\\rangle \\, \\textrm d t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨6{t}^{5}+2t,\\,{\\sec }^{2}⁡t⟩\\,\\text{d}t & =⟨\\int (6{t}^{5}+2t)\\,\\text{d}t,\\,\\int {\\sec }^{2}⁡t\\,\\text{d}t⟩ \\\\  & =⟨{t}^{6}+{t}^{2}+{c}_{1},\\,\\operatorname{tan}⁡t+{c}_{2}⟩ \\\\  & =⟨{t}^{6}+{t}^{2},\\,\\operatorname{tan}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{6}+{t}^{2},\\,\\operatorname{tan}⁡t⟩+C,\\end{aligned}\n$$\n\nwhere $\\mathbf C$ is an arbitrary (vector) constant of integration."} {:db/id #edb/ref 17592186096934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "852006ff-7481-5fe7-b0ff-2e2c6cc81924" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186239211} {:answer/id #uuid "8e847ec3-947d-5ab7-9659-f743b3fa803a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186239292} {:answer/id #uuid "e4f51c9e-8327-5008-ae93-feeb7d4821c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186240064} {:answer/id #uuid "f559a43e-68f1-5619-b329-7a3891eac5b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186240220} {:answer/id #uuid "f7727860-96f1-56b5-bf07-9034b812e1c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186240238}] :answer-field/correct {:db/id #edb/ref 17592186239211} :answer-field/id #uuid "1af0e04e-29d5-58a7-8ea1-25378dbc76bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240375}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b22a8cc-4bee-5afb-9668-7a994a70948e" :question/math-academy-id "q-10559" :question/problem "Calculate\n$$\n\\displaystyle \\int (4{\\cos }^{2}⁡x-2)\\,\\text{d}x.\n$$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${\\cos }^{2}⁡x$ term, given by\n\n$$\n\\operatorname{cos}⁡2x=2{\\cos }^{2}⁡x-1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{\\cos }^{2}⁡x=\\frac{1}{2}(\\operatorname{cos}⁡2x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (4{\\cos }^{2}⁡x-2)\\,\\text{d}x & =\\int (4(\\frac{1}{2}(\\operatorname{cos}⁡2x+1))-2)\\,\\text{d}x \\\\  & =\\int (2\\operatorname{cos}⁡2x+2-2)\\,\\text{d}x \\\\  & =\\int 2\\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =2(\\frac{1}{2}\\operatorname{sin}⁡2x)+C \\\\  & =\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f36e7c5-f56a-5348-8931-e0dbeac1132d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100\\operatorname{tan}⁡x-100+C" :db/id #edb/ref 17592186239013} {:answer/id #uuid "82397b20-79c9-5247-99ac-06126a82bd57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-100\\operatorname{tan}⁡x-100x+C" :db/id #edb/ref 17592186239187} {:answer/id #uuid "cbc4aadf-5a74-567a-8ecc-d734a866d60e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-100\\operatorname{tan}⁡x-100+C" :db/id #edb/ref 17592186239842} {:answer/id #uuid "dfc52073-790f-5487-a29d-35397b8e4288" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100\\operatorname{tan}⁡x-100x+C" :db/id #edb/ref 17592186240011} {:answer/id #uuid "f82b7b7d-cac4-58ef-a7df-f3ae7d554280" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-100\\operatorname{cot}⁡x-100x+C" :db/id #edb/ref 17592186240250}] :answer-field/correct {:db/id #edb/ref 17592186240011} :answer-field/id #uuid "19aa3789-4da8-5c2b-8183-9ec9da1419b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240371}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "54957225-7249-5981-b35f-869b61fff264" :question/math-academy-id "q-10563" :question/problem "Calculate $$\n\\displaystyle \\int 100{\\tan }^{2}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "First, we select the identity that contains a ${\\tan }^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{\\tan }^{2}⁡x={\\sec }^{2}⁡x.\n$$\n\nRearranging the above identity gives\n\n$$\n{\\tan }^{2}⁡x={\\sec }^{2}⁡x-1.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int 100{\\tan }^{2}⁡x\\,\\text{d}x & =\\int 100({\\sec }^{2}⁡x-1)\\text{d}x \\\\  & =\\int (100{\\sec }^{2}⁡x-100)\\text{d}x \\\\  & =100\\operatorname{tan}⁡x-100x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43b7621b-c3f2-5b66-ac83-e2b7d10aae48" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the statements are true." :db/id #edb/ref 17592186093615} {:answer/id #uuid "500e5314-9f8d-5c20-982d-836725263db7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186093616} {:answer/id #uuid "5d8534d4-62b5-5ef4-b9cf-5ebf44d9d62a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186093617} {:answer/id #uuid "6f084cd6-64ea-5ce1-b7ef-cb8be891185d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186093618} {:answer/id #uuid "6f6484ff-0485-5b70-aa34-62ffe0b90c08" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186093619}] :answer-field/id #uuid "50b4059d-857b-5f4d-9125-19d17c29fc17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186093614}] :question/id #uuid "0c8e6cdd-2075-560a-ad21-7e80496b36eb" :question/math-academy-id "q-10847" :question/problem "A course teacher wants to check the strength of the linear correlation between the following variables:\n\n- $x$, the final grade a student received on finishing the course, and\n- $y$, the student's score in the exam.\n\nYou are given that $\\operatorname{Cov} (x, y) = 140$, $σ_{x} = 5$, and $σ_{y} = 30$. Which of the following statements are true?\n\n1. $ρ \\approx 0.93$\n2. There is a strong positive correlation between $x$ and $y$.\n3. There is a weak positive correlation between $x$ and $y$.\n\n*Hint: $\\mid ρ \\mid > 0.7$ indicates a strong correlation, and $0.3 \\le \\mid ρ \\mid \\le 0.7$ indicates a weak correlation.*\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186096964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aceadd5-e975-5092-801f-eb599650e517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186244555} {:answer/id #uuid "20834f13-c631-5b35-8afc-4d339c90f609" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186244600} {:answer/id #uuid "4eb3190b-44a2-5acf-91b3-68cd1d88dc91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186245012} {:answer/id #uuid "9119b52b-fba9-5512-8a8c-38cad3c0cf3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186245582} {:answer/id #uuid "e7dd6186-a7d7-5033-b3f0-bee91827ba0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186246367}] :answer-field/correct {:db/id #edb/ref 17592186246367} :answer-field/id #uuid "7ad2a0bf-f499-54f7-bc07-037d9af4ff3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246761}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "60acf08a-2dba-5856-a17a-f9ec2a8623fa" :question/math-academy-id "q-11296" :question/problem "Given that the expression $4\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ)\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=4 \\\\ R\\operatorname{sin}⁡ϕ &=3\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={4}^{2}+{3}^{2} \\\\ {R}^{2}({\\cos }^{2}⁡ϕ+{\\sin }^{2}⁡ϕ) & =16+9 \\\\ {R}^{2} & =25 \\\\ R & =5.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186097056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47d0d172-5a30-57d5-a766-d99669bdec9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡(3x)+1)+C" :db/id #edb/ref 17592186257411} {:answer/id #uuid "5650ea15-d618-5b47-8c28-c84f1b05c79b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡2}(\\operatorname{ln}⁡(3x)+2)+C" :db/id #edb/ref 17592186257525} {:answer/id #uuid "b25a9222-222c-5e15-ba09-a0c57522e510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡2}(\\operatorname{ln}⁡(3x)-1)+C" :db/id #edb/ref 17592186258336} {:answer/id #uuid "e6b91501-5eb2-51d9-8768-15ceeaa9babf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡2}(x\\operatorname{ln}⁡(3x)-2)+C" :db/id #edb/ref 17592186258785} {:answer/id #uuid "eec4b01f-b497-53f1-8b34-4b8b2d67f6ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡(3x)-1)+C" :db/id #edb/ref 17592186258851}] :answer-field/correct {:db/id #edb/ref 17592186258851} :answer-field/id #uuid "6b1e6c3d-3d86-5dab-9cbb-0d0320668747" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259215}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8f0b656-4bc9-55ad-bafd-83e444f61957" :question/math-academy-id "q-12568" :question/problem "Calculate $$\n\\displaystyle \\int x{\\log }_{2}⁡(3x)\\,\\text{d}x.\n$$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={\\log }_{2}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=x\\, & ⟹\\,v=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int x{\\log }_{2}⁡(3x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={\\log }_{2}⁡(3x)\\cdot \\left(\\frac{{x}^{2}}{2}\\right)-\\int \\left(\\frac{{x}^{2}}{2}\\right)\\left(\\frac{1}{x\\operatorname{ln}⁡2}\\right)\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{\\log }_{2}⁡(3x)}{2}-\\frac{1}{2\\operatorname{ln}⁡2}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡(3x)}{2\\operatorname{ln}⁡2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡(3x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${\\log }_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$"} {:db/id #edb/ref 17592186097057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0155e70c-7153-50ac-ae32-b2c98bd947de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\operatorname{ln}⁡x+2}{{x}^{2}\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186256794} {:answer/id #uuid "492b97f9-d3ef-59ab-b561-3b0dcf2167b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡x+2}{4{x}^{2}\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186257422} {:answer/id #uuid "528a8324-2d4a-5fa6-b598-f741cb33ee5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡x+1}{2{x}^{2}\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186257489} {:answer/id #uuid "57f151a3-62b4-585a-a72e-e79e50e78a38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{2}\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186257543} {:answer/id #uuid "eff5e611-dfe2-5583-8b84-0312c0fe1b79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{ln}⁡x+1}{{x}^{2}\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186258867}] :answer-field/correct {:db/id #edb/ref 17592186257543} :answer-field/id #uuid "f07a98a3-4e03-5c25-9500-65acccf243a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259449}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ce071f41-118b-504d-a520-d6c46fbbaaf1" :question/math-academy-id "q-12570" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{{\\log }_{3}⁡x}{{x}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={\\log }_{3}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\log }_{3}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={\\log }_{3}⁡x\\cdot \\left(-\\frac{1}{2{x}^{2}}\\right)-\\int \\left(-\\frac{1}{2{x}^{2}}\\right)\\left(\\frac{1}{x\\operatorname{ln}⁡3}\\right)\\,\\text{d}x \\\\  & =-\\frac{{\\log }_{3}⁡x}{2{x}^{2}}+\\frac{1}{2\\operatorname{ln}⁡3}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{{\\log }_{3}⁡x}{2{x}^{2}}-\\frac{1}{4{x}^{2}\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{\\operatorname{ln}⁡x}{2{x}^{2}\\operatorname{ln}⁡3}-\\frac{1}{4{x}^{2}\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{2}\\operatorname{ln}⁡3}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${\\log }_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$"} {:db/id #edb/ref 17592186097201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91221116-88ce-521b-bad3-726d8605d47f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7x{sec}^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2)}{4{x}^{2}}" :db/id #edb/ref 17592186289006} {:answer/id #uuid "cce2b4d8-a4ef-58c6-9b31-914df56eedb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7{sec}^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2)}{16{x}^{2}}" :db/id #edb/ref 17592186289395} {:answer/id #uuid "d8b28c22-8699-5534-b552-2ffbcb24e1e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x{sec}^{2}⁡(7x-2)+\\operatorname{tan}⁡(7x-2)}{4{x}^{2}}" :db/id #edb/ref 17592186289479} {:answer/id #uuid "eb7cddbb-8584-5d98-9e76-f760c3dad214" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7x{sec}^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2)}{16{x}^{2}}" :db/id #edb/ref 17592186289591} {:answer/id #uuid "f7dc46cb-df18-5bde-895e-17fa801c55f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{sec}^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2)}{4{x}^{2}}" :db/id #edb/ref 17592186289664}] :answer-field/correct {:db/id #edb/ref 17592186289006} :answer-field/id #uuid "379f9fa9-539c-5ea4-aa1b-2d627f7a6c75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3cae07ba-0147-5b66-85db-519e500d15f1" :question/math-academy-id "q-2396" :question/problem "Find ${y}^{′}$ for $y=\\frac{\\operatorname{tan}⁡(7x-2)}{4x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\operatorname{tan}⁡(7x-2)$ and the denominator $v(x)=4x.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=7{\\sec }^{2}⁡(7x-2),\\,{v}^{′}(x)=4.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(7{\\sec }^{2}⁡(7x-2))(4x)-\\operatorname{tan}⁡(7x-2)(4)}{(4x)^{2}} \\\\  & =\\frac{4(7x{\\sec }^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2))}{16{x}^{2}} \\\\  & =\\frac{\\text{⧸}4(7x{\\sec }^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2))}{\\text{⧸}4(4{x}^{2})} \\\\  & =\\frac{7x{\\sec }^{2}⁡(7x-2)-\\operatorname{tan}⁡(7x-2)}{4{x}^{2}}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ce40c2-2208-50e8-8d8d-8b86847659a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡(x-\\frac{\\pi }{6})" :db/id #edb/ref 17592186295385} {:answer/id #uuid "8bf9509e-33eb-53a0-a6ad-bc3e4bab7c1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{cos}⁡(x-\\frac{\\pi }{12})" :db/id #edb/ref 17592186296011} {:answer/id #uuid "b0e76266-6bd5-5cda-b48a-24ae8f2ec06a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cos}⁡(x-\\frac{\\pi }{3})" :db/id #edb/ref 17592186296200} {:answer/id #uuid "b4d965a2-a14d-5e53-9fc0-f70ba89698bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{cos}⁡(x-\\frac{\\pi }{4})" :db/id #edb/ref 17592186296218} {:answer/id #uuid "fdddd448-e8ec-5b9c-96a1-a79e72942810" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡(x-\\frac{\\pi }{4})" :db/id #edb/ref 17592186296618}] :answer-field/correct {:db/id #edb/ref 17592186295385} :answer-field/id #uuid "c86731c7-5c99-52cc-b981-b6b4dff0f659" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186297046}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d31aaa3c-4e44-57d5-8b17-880f83f68511" :question/math-academy-id "q-30580" :question/problem "$\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=$" :question/requires-calculator true :question/worked-solution "The difference formula for cosine gives\n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(x-ϕ) & =R(\\operatorname{cos}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{sin}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=R\\operatorname{cos}⁡(x-ϕ)\n$$\n\nwe get the following identity:\n\n$$\n\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{3} \\\\ R\\operatorname{sin}⁡ϕ &=1\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{1}{\\sqrt{3}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{\\sqrt{3}}{3} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{sin}⁡ϕ)}^{2}+{(R\\operatorname{cos}⁡ϕ)}^{2} & ={1}^{2}+(\\sqrt{3})^{2} \\\\ {R}^{2}({\\sin }^{2}⁡ϕ+{\\cos }^{2}⁡ϕ) & =1+3 \\\\ {R}^{2} & =4 \\\\ R & =2.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=2\\operatorname{cos}⁡(x-\\frac{\\pi }{6})\n$$"} {:db/id #edb/ref 17592186097272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33da66f9-4db0-534b-a9e5-7d131719c2fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{sec}⁡(2x+\\frac{\\pi }{6})-2x+C" :db/id #edb/ref 17592186330409} {:answer/id #uuid "4c7e6b6a-d72a-5288-bcc5-cc8682a3e699" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡(2x+\\frac{\\pi }{6})-x+C" :db/id #edb/ref 17592186330644} {:answer/id #uuid "6a462c1e-277a-5cc8-a656-feee1fe95254" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{tan}⁡(2x+\\frac{\\pi }{6})-x+C" :db/id #edb/ref 17592186330904} {:answer/id #uuid "e29c3ec2-6870-554f-9d5f-5d806df53818" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{tan}⁡(2x+\\frac{\\pi }{6})+C" :db/id #edb/ref 17592186331953} {:answer/id #uuid "fa50c537-badc-5e7b-9916-e9adc6bf5c21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡(2x+\\frac{\\pi }{6})-2x+C" :db/id #edb/ref 17592186332144}] :answer-field/correct {:db/id #edb/ref 17592186330904} :answer-field/id #uuid "e6d039be-00fe-5eec-960d-36f33ea019d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332606}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80d349d8-53d5-5ccb-8a77-300f5edef09d" :question/math-academy-id "q-49268" :question/problem "$$\n\\displaystyle \\int {\\tan }^{2}⁡(2x+\\frac{\\pi }{6})\\text{d}x=\n$$" :question/worked-solution "From the identity  $1+{\\tan }^{2}⁡\\theta ={\\sec }^{2}⁡\\theta $ with $\\theta =2x+\\frac{\\pi }{6},$ we get \n\n$$\n\\begin{aligned}1+{\\tan }^{2}⁡(2x+\\frac{\\pi }{6}) & ={\\sec }^{2}⁡(2x+\\frac{\\pi }{6}) \\\\ {\\tan }^{2}⁡(2x+\\frac{\\pi }{6}) & ={\\sec }^{2}⁡(2x+\\frac{\\pi }{6})-1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int {\\tan }^{2}⁡(2x+\\frac{\\pi }{6})\\text{d}x & =\\int ({\\sec }^{2}⁡(2x+\\frac{\\pi }{6})-1)\\text{d}x \\\\  & =\\int {\\sec }^{2}⁡(2x+\\frac{\\pi }{6})\\text{d}x-\\int 1\\cdot \\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡(2x+\\frac{\\pi }{6})-x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4864337d-4964-5f3d-8a78-eab6333d873d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi (3-{\\pi }^{2})}{3}" :db/id #edb/ref 17592186330598} {:answer/id #uuid "7b7b686a-60ba-523a-9061-757f6c9ae618" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi (3+7{\\pi }^{2})}{2}" :db/id #edb/ref 17592186331038} {:answer/id #uuid "98e3cbce-9ff0-5d56-9eb0-f6d9132ada14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi (1+5{\\pi }^{2})}{4}" :db/id #edb/ref 17592186331314} {:answer/id #uuid "a445a858-0446-5db8-bf7a-ad2117e910f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi (7-{\\pi }^{2})}{6}" :db/id #edb/ref 17592186331424} {:answer/id #uuid "d4fa301d-cf6a-5a6e-aeb0-0ec10947906e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi (3-7{\\pi }^{2})}{3}" :db/id #edb/ref 17592186331836}] :answer-field/correct {:db/id #edb/ref 17592186331836} :answer-field/id #uuid "df3c6fed-be9d-59e4-b64b-f97c94f61970" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332593}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ff02ae2-e392-569a-a8d7-eca11afff7ee" :question/math-academy-id "q-49297" :question/problem "Evaluate \n$$\n\\displaystyle {\\int }_{\\pi }^{2\\pi }(2{\\cos }^{2}⁡2x-{x}^{2})\\text{d}x.\n$$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${\\cos }^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{\\cos }^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{\\cos }^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n2{\\cos }^{2}⁡2x=2[\\frac{1}{2}(\\operatorname{cos}⁡4x+1)]=\\operatorname{cos}⁡4x+1.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{\\pi }^{2\\pi }(2{\\cos }^{2}⁡2x-{x}^{2})\\text{d}x & ={\\int }_{\\pi }^{2\\pi }(\\operatorname{cos}⁡4x+1-{x}^{2})\\,\\text{d}x \\\\  & ={(\\frac{1}{4}\\operatorname{sin}⁡4x+x-\\frac{1}{3}{x}^{3})|}_{\\pi }^{2\\pi } \\\\  & =[\\frac{1}{4}\\operatorname{sin}⁡2\\pi +2\\pi -\\frac{1}{3}\\cdot 2{\\pi }^{3}]-[\\frac{1}{4}\\operatorname{sin}⁡4\\pi +\\pi -\\frac{1}{3}{\\pi }^{3}] \\\\  & =2\\pi -\\frac{8{\\pi }^{3}}{3}-\\pi +\\frac{{\\pi }^{3}}{3} \\\\  & =\\pi -\\frac{7{\\pi }^{3}}{3} \\\\  & =\\frac{3\\pi -7{\\pi }^{3}}{3} \\\\  & =\\frac{\\pi (3-7{\\pi }^{2})}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02287c3d-f1b6-5a0c-b0b0-de3e47decfc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12\\sqrt{3}" :db/id #edb/ref 17592186329980} {:answer/id #uuid "057325d7-42e0-5a77-bb0c-7e5db88955f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\sqrt{3}" :db/id #edb/ref 17592186330003} {:answer/id #uuid "0bac8292-d189-5225-a261-419d08eec6c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\sqrt{3}" :db/id #edb/ref 17592186330052} {:answer/id #uuid "93122106-e3d8-5ff8-abce-ee6f92e9f208" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186331256} {:answer/id #uuid "f8743c79-654d-58c8-9d76-e74a2b46c67a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\sqrt{3}" :db/id #edb/ref 17592186332133}] :answer-field/correct {:db/id #edb/ref 17592186331256} :answer-field/id #uuid "9a218147-d094-5001-954c-ef4077811877" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332473}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6a87e286-9a46-59f9-9b03-f26ebb498611" :question/math-academy-id "q-49326" :question/problem "Evaluate $$\n\\displaystyle {\\int }_{-\\pi /6}^{\\pi /6}\\frac{9-9{\\tan }^{4}⁡x}{1-{\\tan }^{2}⁡x}\\,\\text{d}x.\n$$" :question/worked-solution "First, we select the identity that contains a ${\\tan }^{2}⁡x$ term. We can use the identity \n\n$$\n1+{\\tan }^{2}⁡x={\\sec }^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /6}^{\\pi /6}\\frac{9-9{\\tan }^{4}⁡x}{1-{\\tan }^{2}⁡x}\\,\\text{d}x & =9{\\int }_{-\\pi /6}^{\\pi /6}\\frac{1-{\\tan }^{4}⁡x}{1-{\\tan }^{2}⁡x}\\,\\text{d}x \\\\  & =9{\\int }_{-\\pi /6}^{\\pi /6}\\frac{(1-{\\tan }^{2}⁡x)(1+{\\tan }^{2}⁡x)}{1-{\\tan }^{2}⁡x}\\,\\text{d}x \\\\  & =9{\\int }_{-\\pi /6}^{\\pi /6}(1+{\\tan }^{2}⁡x)\\text{d}x \\\\  & =9{\\int }_{-\\pi /6}^{\\pi /6}{\\sec }^{2}⁡x\\,\\text{d}x \\\\  & =9\\operatorname{tan}⁡x\\,{|}_{-\\pi /6}^{\\pi /6} \\\\  & =9\\operatorname{tan}⁡\\left(\\frac{\\pi }{6}\\right)-9\\operatorname{tan}⁡\\left(-\\frac{\\pi }{6}\\right) \\\\  & =9\\cdot \\frac{\\sqrt{3}}{3}-9\\left(-\\frac{\\sqrt{3}}{3}\\right) \\\\  & =3\\sqrt{3}+3\\sqrt{3} \\\\  & =6\\sqrt{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "120a969c-c232-5a6a-9ebc-f3876756aa9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)+x+C" :db/id #edb/ref 17592186493422} {:answer/id #uuid "2f1ecc2b-8f38-5a56-b452-79a084abe981" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493470} {:answer/id #uuid "381e7704-3610-52d0-943d-11d2f5db4582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)+x+C" :db/id #edb/ref 17592186493483} {:answer/id #uuid "741642b8-40a1-5ddc-a062-46c687fc6284" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493563} {:answer/id #uuid "da75dca0-cf1f-53aa-85b2-c756cac65ae8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493734}] :answer-field/correct {:db/id #edb/ref 17592186493470} :answer-field/id #uuid "d8ea9791-475d-59e1-8890-18149e61f29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095580}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e657762c-92c8-5c88-91d7-fe5813627920" :question/math-academy-id "q-49327" :question/problem "$$\n\\displaystyle \\int {\\cot }^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x=\n$$" :question/worked-solution "From the identity $1+{\\cot }^{2}⁡\\theta ={\\csc }^{2}⁡\\theta $ with $\\theta =\\frac{\\pi }{2}-x,$ we get \n\n$$\n\\begin{aligned}1+{\\cot }^{2}⁡(\\frac{\\pi }{2}-x) & ={\\csc }^{2}⁡(\\frac{\\pi }{2}-x) \\\\ {\\cot }^{2}⁡(\\frac{\\pi }{2}-x) & ={\\csc }^{2}⁡(\\frac{\\pi }{2}-x)-1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int {\\cot }^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x & =\\int ({\\csc }^{2}⁡(\\frac{\\pi }{2}-x)-1)\\text{d}x \\\\  & =\\int {\\csc }^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x-\\int 1\\cdot \\text{d}x \\\\  & =\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108a7ce4-2fbf-516f-a9ee-b0a3967d1ebb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\pi +25{\\pi }^{4}" :db/id #edb/ref 17592186330097} {:answer/id #uuid "47bebd14-566b-5a48-8dbc-247b8097cc88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\pi -{\\pi }^{3}" :db/id #edb/ref 17592186330597} {:answer/id #uuid "60ddca83-6f18-5dc0-95bb-2dc02a3ce78b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\pi -{\\pi }^{4}" :db/id #edb/ref 17592186330809} {:answer/id #uuid "c27ccaf5-3c10-5e24-8068-3a5fefe8b53c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi -5{\\pi }^{4}" :db/id #edb/ref 17592186331679} {:answer/id #uuid "e52dff9e-56c4-5804-958b-c767f612d3a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi -{\\pi }^{4}" :db/id #edb/ref 17592186331969}] :answer-field/correct {:db/id #edb/ref 17592186330809} :answer-field/id #uuid "5bb69ecc-629f-586f-a88d-4e843428cff3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332379}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d7b11093-5b5a-58f1-bca1-3927cf2df9a7" :question/math-academy-id "q-49447" :question/problem "$$\n\\displaystyle {\\int }_{0}^{\\pi }(10{\\cos }^{2}⁡x-4{x}^{3}+10{\\sin }^{2}⁡x)\\text{d}x=\n$$" :question/worked-solution "We use the Pythagorean identity:\n\n$$\n{\\cos }^{2}⁡x+{\\sin }^{2}⁡x=1\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }(10{\\cos }^{2}⁡x-4{x}^{3}+10{\\sin }^{2}⁡x)\\text{d}x & ={\\int }_{0}^{\\pi }(10({\\sin }^{2}⁡x+{\\cos }^{2}⁡x)-4{x}^{3})\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }(10\\cdot 1-4{x}^{3})\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }(10-4{x}^{3})\\text{d}x \\\\  & =(10x-{x}^{4}){|}_{0}^{\\pi } \\\\  & =[10\\pi -{\\pi }^{4}]-[10\\cdot 0-{0}^{4}] \\\\  & =10\\pi -{\\pi }^{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "357c35d1-32a0-5caf-817a-521658867e2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186330425} {:answer/id #uuid "3df07292-21d6-5c23-9ed0-c588dc73341d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡x-\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186330496} {:answer/id #uuid "719554fc-869e-5692-98bf-1cc26c988faf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186330969} {:answer/id #uuid "ae52a3c5-138c-561e-ae2d-fa7c100cad3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{csc}⁡x+\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331490} {:answer/id #uuid "fe6f982c-ed9e-594e-ba25-ca7f05215369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186332190}] :answer-field/correct {:db/id #edb/ref 17592186330425} :answer-field/id #uuid "d737672a-92fc-5c6e-a5c2-20bf29ec9095" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332579}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "549e92f3-8254-599c-8f33-a7787db1bdf4" :question/math-academy-id "q-51122" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{1-\\operatorname{sin}⁡x}\\,\\text{d}x.\n$$" :question/worked-solution "We use a variation of the Pythagorean identity:\n\n$$\n{\\sin }^{2}⁡x+{\\cos }^{2}⁡x=1\\,⟹\\,{\\cos }^{2}⁡x=1-{\\sin }^{2}⁡x.\n$$\n\nUsing the above, we rewrite the denominator and calculate the resulting integral:\n\n$$\n\\begin{aligned}\\int \\frac{1}{1-\\operatorname{sin}⁡x}\\,\\text{d}x & =\\int (\\frac{1}{1-\\operatorname{sin}⁡x}\\cdot \\frac{1+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x})\\text{d}x \\\\  & =\\int \\frac{1+\\operatorname{sin}⁡x}{1-{\\sin }^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1+\\operatorname{sin}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x \\\\  & =\\int (\\frac{1}{{\\cos }^{2}⁡x}+\\frac{\\operatorname{sin}⁡x}{{\\cos }^{2}⁡x})\\text{d}x \\\\  & =\\int ({\\sec }^{2}⁡x+\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\text{d}x \\\\  & =\\operatorname{tan}⁡x+\\operatorname{sec}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d55afc9-6d02-55b5-8600-da25ffb42e0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}x-\\frac{1}{4}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186330651} {:answer/id #uuid "80fbbd32-3388-5e11-9882-0de3096c8a2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331095} {:answer/id #uuid "8e9ff708-688f-5fcb-8a74-a1d7879d9dc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+\\frac{1}{4}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331212} {:answer/id #uuid "b8a0e113-ac2d-538f-ad7f-5694c58ff9fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{1}{4}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331583} {:answer/id #uuid "d0381dad-2311-5de5-b1ea-73f5cfaebfc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331798}] :answer-field/correct {:db/id #edb/ref 17592186330651} :answer-field/id #uuid "4a4e8a21-abb1-5b6c-99aa-fe68c73a9489" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332328}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "656c1182-f5c3-5ce0-a174-62cb354d7b3e" :question/math-academy-id "q-51127" :question/problem "Calculate $$\n\\displaystyle \\int {\\sin }^{2}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2x=1-2{\\sin }^{2}⁡x.\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2x)={\\sin }^{2}⁡x.\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}\\int {\\sin }^{2}⁡x\\,\\text{d}x & =\\int \\frac{1}{2}(1-\\operatorname{cos}⁡2x)\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int (1-\\operatorname{cos}⁡2x)\\,\\text{d}x \\\\  & =\\frac{1}{2}(x-\\frac{1}{2}\\operatorname{sin}⁡2x)+C \\\\  & =\\frac{1}{2}x-\\frac{1}{4}\\operatorname{sin}⁡2x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097817 :tutorial/content "For a general logarithm of base $a,$ the derivative is given by\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( \\log_a x \\right)= \\dfrac{1}{x\\ln a}.\n$$\n\nAlso, recall that whenever $\\log$ is written without a base, we can assume that it represents the base $10.$ So, we have\n\n$$\n\\log x =  \\log_{10} x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{d}{dx}(\\operatorname{log}⁡x) & =\\frac{d}{dx}({\\log }_{10}⁡x)=\\frac{1}{x\\operatorname{ln}⁡10}.\\end{aligned}\n$$\n\n**Note:** To see where this rule comes from, we can use the change-of-base formula as shown below.\n\n$$\n\\log_a x = \\dfrac{\\ln x}{\\ln a}\n$$\n\nTaking the derivative and using the fact that $\\ln a$ is a constant, then, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({\\log }_{a}⁡x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡a}\\right) \\\\  & =\\frac{1}{\\operatorname{ln}⁡a}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{\\operatorname{ln}⁡a}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{x\\operatorname{ln}⁡a}.\\end{aligned}\n$$" :tutorial/id #uuid "7a7450e4-ec0e-5a5e-9c86-9430eb889be7" :tutorial/math-academy-id 2616 :tutorial/title "Differentiating a Logarithmic Function with a General Base"} {:db/id #edb/ref 17592186097822 :tutorial/content "We can now prove that $(\\tan x)' = \\sec^2{x}$ using the quotient rule. Here's how! \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\right) \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}\\cdot (\\operatorname{cos}⁡x)-(\\operatorname{sin}⁡x)\\cdot (\\operatorname{cos}⁡x)^{′}}{{\\cos }^{2}⁡x} \\\\  & =\\frac{(\\operatorname{cos}⁡x)\\cdot (\\operatorname{cos}⁡x)-(\\operatorname{sin}⁡x)\\cdot (-\\operatorname{sin}⁡x)}{{\\cos }^{2}⁡x} \\\\  & =\\frac{{\\cos }^{2}⁡x+{\\sin }^{2}⁡x}{{\\cos }^{2}⁡x} \\\\  & =\\frac{1}{{\\cos }^{2}⁡x} \\\\  & ={\\sec }^{2}⁡x.\\end{aligned}\n$$" :tutorial/id #uuid "584707ea-2c96-5389-926d-b9ac87adc17c" :tutorial/math-academy-id 2626 :tutorial/title "Justifying the Formula for the Derivative of Tangent"} {:db/id #edb/ref 17592186097923 :tutorial/content "Let's recall the three double-angle formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2x) & ={\\cos }^{2}⁡x-{\\sin }^{2}⁡x \\\\  & =2{\\cos }^{2}⁡x-1 \\\\  & =1-2{\\sin }^{2}⁡x.\\end{aligned}\n$$\n\nWe can use the double-angle formulas for cosine to integrate $\\sin^2{x}$ and $\\cos^2{x}.$ Let's take a look at some examples." :tutorial/id #uuid "87755d89-cab8-5737-9e44-ae816aefe23f" :tutorial/math-academy-id 880 :tutorial/title "Using the Double-Angle Formulas for Cosine"} {:answer/id #uuid "9dbb571e-cf26-5153-8fd9-2a13aab10234" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{cis} \\left(\\frac{π}{3}\\right)" :db/id #edb/ref 17592186098464} {:answer/id #uuid "19065725-b91f-5231-8fba-6020a90ee48a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{cis} \\left(\\frac{5π}{3}\\right)" :db/id #edb/ref 17592186098465} {:answer/id #uuid "1a58b405-73ac-58f6-aa70-74574c36c02f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{cis} \\left(\\frac{4π}{3}\\right)" :db/id #edb/ref 17592186098466} {:answer/id #uuid "2e38f448-e341-5830-8313-f69946508eb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{cis} \\left(\\frac{5π}{3}\\right)" :db/id #edb/ref 17592186098467} {:answer/id #uuid "5284a527-c1b5-5d7f-ad59-6b3eb38bf90c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{cis} \\left(\\frac{π}{3}\\right)" :db/id #edb/ref 17592186098468} {:answer/id #uuid "9a31b7f9-9cd0-571d-a0ed-767a2b772c1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\operatorname{cis} \\left(\\frac{π}{4}\\right)" :db/id #edb/ref 17592186098470} {:answer/id #uuid "b6b8e3df-4db7-5382-81af-a1ed0723e4ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\operatorname{cis} \\left(\\frac{3π}{4}\\right)" :db/id #edb/ref 17592186098471} {:answer/id #uuid "c3f1835a-3389-587d-adab-b43bb181e30d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{2}\\operatorname{cis} \\left(\\frac{7π}{4}\\right)" :db/id #edb/ref 17592186098472} {:answer/id #uuid "fa149bff-cd93-57ca-9ee8-dfbdafbe79e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{2}\\operatorname{cis} \\left(\\frac{π}{4}\\right)" :db/id #edb/ref 17592186098473} {:answer/id #uuid "251ed9ed-2e52-5f10-9e43-19c26802f3f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\operatorname{cis} \\left(\\frac{5π}{4}\\right)" :db/id #edb/ref 17592186098474} {:answer/id #uuid "ae6e5fa3-592d-5fd4-814c-88e9418d891a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cis} \\left(\\frac{π}{4}\\right)" :db/id #edb/ref 17592186099580} {:answer/id #uuid "db79cabf-1cda-513c-abf2-f88ba38a0a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cis} \\left(\\frac{7π}{4}\\right)" :db/id #edb/ref 17592186099581} {:answer/id #uuid "4298e3fa-f5a5-5229-8414-11e8e8fdfc88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cis} \\left(\\frac{5π}{4}\\right)" :db/id #edb/ref 17592186099582} {:answer/id #uuid "55cea33b-06bd-5b8e-8dd5-1344aac53f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{cis} \\left(\\frac{5π}{4}\\right)" :db/id #edb/ref 17592186099583} {:answer/id #uuid "73b75871-0753-54ee-910f-3d8e2a256d85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{cis} \\left(\\frac{π}{4}\\right)" :db/id #edb/ref 17592186099584} {:answer/id #uuid "e1a3d9d3-e9e7-5442-a211-c88bc8e2647b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cis} \\left(\\frac{π}{3}\\right)" :db/id #edb/ref 17592186099586} {:answer/id #uuid "05986258-56e7-5c84-b9c0-9ffcb26a05c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{cis} \\left(\\frac{2π}{3}\\right)" :db/id #edb/ref 17592186099587} {:answer/id #uuid "084864c1-355e-5deb-8e74-2daa9ec31f3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{cis} \\left(\\frac{π}{3}\\right)" :db/id #edb/ref 17592186099588} {:answer/id #uuid "11102d40-2f55-59bf-8cf8-f29433c668a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{cis} \\left(-\\frac{π}{3}\\right)" :db/id #edb/ref 17592186099589} {:answer/id #uuid "6e441b9d-d218-5441-865d-84895af099df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{cis} \\left(\\frac{π}{3}\\right)" :db/id #edb/ref 17592186099590} {:db/id #edb/ref 17592186100609 :question/id #uuid "1579f932-6e7f-5daa-b001-54a9f6c236ad" :question/math-academy-id "e-14406" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\dfrac{\\log^2_3 x }{x} \\,\\textrm d x.\n$$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\dfrac{(\\log_3 x)^2 }{x} \\,\\textrm d x.\n$$\n\nLet $u=\\log_3 x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{x\\ln 3}\\quad\\Longrightarrow\\quad\\ln 3\\,\\textrm d u = \\dfrac 1 x \\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{({\\log }_{3}⁡x)^{2}}{x}\\,\\text{d}x & =\\int ({\\log }_{3}⁡x)^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int {u}^{2}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{1}{3}{u}^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3({\\log }_{3}⁡x)^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3{\\log }_{3}^{3}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186100701 :question/id #uuid "c824ba23-c39c-5205-81a3-98d2e4b823f3" :question/math-academy-id "e-4438" :question/problem "Calculate the area of the parallelogram spanned by $\\textbf{u}=\\langle 3,-2 \\rangle$ and $\\textbf{v}=\\langle 6, -4 \\rangle.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM =\n\t{\\left[ \\begin{array}{cc}3 & 6 \\\\ - 2 & - 4\\end{array} \\right]}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}\\det (M) & =\\begin{vmatrix}3 & 6 \\\\ -2 & -4\\end{vmatrix} \\\\  & =3\\cdot (-4)-6\\cdot (-2) \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $\\det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA = |\\,0\\,| = 0\n$$"} {:db/id #edb/ref 17592186100714 :question/id #uuid "f3d396ea-caed-51ed-a4d8-0bfc3301f2f3" :question/math-academy-id "e-5101" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=\\csc{t},\\,\\,\\, y=2\\cot{t}, \\quad 0 < t < \\dfrac{\\pi}{2}.\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{csc}⁡t\\, & ⇒\\,\\operatorname{csc}⁡t=x \\\\ y=2\\operatorname{cot}⁡t\\, & ⇒\\,\\operatorname{cot}⁡t=\\frac{y}{2}.\\end{aligned}\n$$\n\nDividing the Pythagorean identity $\\sin^{2}{t}+\\cos^{2}{t}=1$ by $\\sin^{2}{t},$ we get\n\n$$\n\\begin{aligned}\\frac{{\\sin }^{2}⁡t}{{\\sin }^{2}⁡t}+\\frac{{\\cos }^{2}⁡t}{{\\sin }^{2}⁡t} & =\\frac{1}{{\\sin }^{2}⁡t} \\\\ 1+{\\left(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}\\right)}^{2} & ={\\left(\\frac{1}{\\operatorname{sin}⁡t}\\right)}^{2} \\\\ 1+{\\cot }^{2}⁡t & ={\\csc }^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\csc{t} = x$ and $\\cot t =\\dfrac{y}{2}$ into this formula, we get\n\n$$\n\\begin{aligned}1+{\\left(\\frac{y}{2}\\right)}^{2} & ={x}^{2} \\\\ \\frac{{y}^{2}}{4} & ={x}^{2}-1 \\\\ {y}^{2} & =4({x}^{2}-1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y^2 = 4\\left( x^2-1 \\right).$\n\nFinally, since $0 < t < \\dfrac{\\pi}{2}$ and $x=\\csc t,$ the interval on the $x$-axis is $x \\geq 1.$"} {:db/id #edb/ref 17592186100730 :question/id #uuid "fa568c9e-5eaa-5d49-843a-38c8a265aa07" :question/math-academy-id "e-5403" :question/problem "If $z_1=5\\textrm{cis}\\left(\\dfrac{5\\pi}{6}\\right)$ and $z_2=3\\textrm{cis}\\left(\\dfrac{\\pi}{3}\\right)$, calculate the product $z_1z_2$." :question/worked-solution "To compute the product of two complex numbers\n\n$$\nz_1 = r_1\\textrm{cis}\\,\\theta_1\n$$\n\nand\n\n$$\nz_2 = r_2\\textrm{cis}\\,\\theta_2\n$$\n\nwe use the formula\n\n$$\nz_1z_2 = r_1 r_2\\,\\textrm{cis}\\left(\\theta_1 + \\theta_2\\right)\n$$\n\nSubstituting $r_1 = 5$, $r_2 = 3$,\n\n$$\n\\theta_1 = \\dfrac{5\\pi}{6}\n$$\n\nand\n\n$$\n\\theta_2 = \\dfrac{\\pi}{3}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\nz_{1}z_{2} &= 5 \\cdot 3 \\cdot \\operatorname{cis} (\\frac{5π}{6} + \\frac{π}{3}) \\\\\n&= 15\\operatorname{cis} \\left(\\frac{7π}{6}\\right)\n\\end{aligned}\n$$\n\nBy expanding the $\\textrm{cis}$ notation and evaluating the sine and cosine, we can get the expression in Cartesian form:\n\n$$\n\\begin{aligned}\nz_{1}z_{2} &= 15\\operatorname{cis} \\left(\\frac{7π}{6}\\right) \\\\\n&= 15[\\cos \\left(\\frac{7π}{6}\\right) + \\textrm{i}\\sin \\left(\\frac{7π}{6}\\right)] \\\\\n&= 15[- \\frac{\\sqrt{3}}{2} + \\textrm{i}\\left(-\\frac{1}{2}\\right)] \\\\\n&=-\\frac{15}{2}(\\sqrt{3} + \\textrm{i})\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186100731 :question/id #uuid "b382e588-1481-5378-a45b-24527c9475a3" :question/math-academy-id "e-5404" :question/problem "If $z_1=3\\textrm{cis}\\left(\\dfrac{3\\pi}{4}\\right)$ and $z_2=9\\textrm{cis}\\left(\\dfrac{\\pi}{2}\\right)$, calculate the quotient $\\dfrac{z_1}{z_2}$." :question/worked-solution "To compute the quotient of two complex numbers\n\n$$\nz_1 = r_1\\textrm{cis}\\,\\theta_1\n$$\n\nand\n\n$$\nz_2 = r_2\\textrm{cis}\\,\\theta_2\n$$\n\nwe use the formula\n\n$$\n\\dfrac{z_1}{z_2} = \\dfrac{r_1}{r_2}\\,\\textrm{cis}\\left(\\theta_1 - \\theta_2\\right)\n$$\n\nSubstituting $r_1 = 3$, $r_2 = 9$,\n\n$$\n\\theta_1 = \\dfrac{3\\pi}{4}\n$$\n\nand\n\n$$\n\\theta_2 = \\dfrac{\\pi}{2}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\n\\frac{z_{1}}{z_{2}} &= \\frac{3}{9}\\operatorname{cis} (\\frac{3π}{4} - \\frac{π}{2}) \\\\\n&= \\frac{1}{3}\\operatorname{cis} \\left(\\frac{π}{4}\\right)\n\\end{aligned}\n$$\n\nBy expanding the $\\textrm{cis}$ notation and evaluating the sine and cosine, we can get the expression in Cartesian form:\n\n$$\n\\begin{aligned}\n\\frac{z_{1}}{z_{2}} &= \\frac{1}{3}\\operatorname{cis} \\left(\\frac{π}{4}\\right) \\\\\n&= \\frac{1}{3}[\\cos \\left(\\frac{π}{4}\\right) + \\textrm{i}\\sin \\left(\\frac{π}{4}\\right)] \\\\\n&= \\frac{1}{3}[\\frac{\\sqrt{2}}{2} + \\textrm{i}\\frac{\\sqrt{2}}{2}] \\\\\n&= \\frac{1}{6}(\\sqrt{2} + \\sqrt{2}\\textrm{i})\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186100737 :question/id #uuid "5cc34501-8fa7-5071-88e7-51ef7c05bfad" :question/math-academy-id "e-5721" :question/problem "Express the complex number $4\\,\\textrm{cis}\\left(\\dfrac{\\pi}{6}\\right)$ in the form $a+\\textrm i b$." :question/worked-solution "The number $\\textrm{cis}\\,\\theta$ corresponds to\n\n$$\n\\textrm{cis}\\,\\theta = \\cos \\theta + \\textrm{i}\\sin \\theta\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\n4\\operatorname{cis} \\left(\\frac{π}{6}\\right) &= 4[\\cos \\left(\\frac{π}{6}\\right) + \\textrm{i}\\sin \\left(\\frac{π}{6}\\right)] \\\\\n&= 4[\\frac{\\sqrt{3}}{2} + \\textrm{i}\\left(\\frac{1}{2}\\right)] \\\\\n&= 2\\sqrt{3} + 2\\textrm{i}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3834cd28-59bb-579a-9438-f0c990ef8544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{15}{{ln}^{3}⁡(3x)}" :db/id #edb/ref 17592186266632} {:answer/id #uuid "88b07b84-7107-5a7d-ab77-963e934bbed0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{{ln}^{2}⁡(3x)}+C" :db/id #edb/ref 17592186267357} {:answer/id #uuid "e9c5bc00-f7dc-587e-b392-bb8fee1f11bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268224} {:answer/id #uuid "ed683359-bd54-5829-8677-c183904d17ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268252} {:answer/id #uuid "f5eb23a5-741f-5f84-9cfa-dcfe634aeafc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268324}] :answer-field/correct {:db/id #edb/ref 17592186268224} :answer-field/id #uuid "00e0a046-60d9-5919-9ccb-b91a58a0c5cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268403}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6b36b281-88d8-5ece-aa59-a18e57169f2d" :question/math-academy-id "q-13814" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{5}{x{\\ln }^{2}⁡(3x)}\\,\\text{d}x.\n$$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x{\\ln }^{2}⁡(3x)}\\,\\text{d}x & =5\\int \\frac{1}{(\\operatorname{ln}⁡(3x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{{u}^{2}}\\cdot \\text{d}u \\\\  & =-5\\cdot {u}^{-1}+C \\\\  & =-\\frac{5}{u}+C \\\\  & =-\\frac{5}{\\operatorname{ln}⁡(3x)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cdd0cee-d5dc-55dd-b18b-edd5c5d143b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186098296} {:answer/id #uuid "a95de19e-8a0c-5ea7-a40e-8653db2879e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186098297} {:answer/id #uuid "c73cb9d0-0bfe-5fae-8bc1-10f38468113d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186098298} {:answer/id #uuid "db6c4cce-5a1e-5047-98c5-fd057127d3c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186098299} {:answer/id #uuid "1f8cc2f3-9815-5b94-8ea4-2375914bf19e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186098300}] :answer-field/correct {:db/id #edb/ref 17592186098300} :answer-field/id #uuid "aaaebb3c-11a8-5d61-b73a-97d31a924d49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186098295}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8b935d32-f672-54cd-918e-5cf82b270c6e" :question/math-academy-id "q-141616" :question/problem "![](images/06/0669cf5e31d559c70c22c5154c0e43638eb5df8a11bedab1e5eea4dc4d7ab90f.png)\n\nThe function $f(x)$ is defined and differentiable on $[-2,2].$ The graph of ${f}^{′}(x)$, the derivative of $f(x),$ is shown above, where the area of the region between the graph and the $x$-axis is $7.$ Find the maximum value of $f(x)$ on the interval $[-2,2]$ given that $f(-2)=2.$" :question/worked-solution "According to the candidates test, the maximum value of $f(x)$ on $[-2,2]$ must occur at a critical point or an endpoint of the interval. \n\n**Step 1**: Find the critical points:\n\nWe see that ${f}^{′}(x)$ is defined everywhere on $x\\in (-2,2),$ and ${f}^{′}(x)\\ne 0$ on this interval. Therefore, the candidates are $x=-2,2.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus:\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}f(-2) & =2 \\\\ f(2) & =f(-2)+{\\int }_{-2}^{2}{f}^{′}(x)\\,\\text{d}x \\\\  & =2+7 \\\\  & =9\\end{aligned}\n$$\n\n**Step 3**: Select the largest value of $f$ from our candidates. \n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\n{f}_{\\text{max}}=\\max \\{2,9\\}=9.\n$$\n\nTherefore, the maximum value of $f$ is ${f}_{\\text{max}}=9,$ and the value of $x$ that maximizes $f(x)$ is ${x}_{\\text{max}}=2.$"} {:db/id #edb/ref 17592186101169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3c22357-e423-53dd-881d-10a8851f96ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186098350} {:answer/id #uuid "1d473754-30a3-5220-8b02-f868f25d294b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186098351} {:answer/id #uuid "215c2d09-dec4-5245-9539-d5cdc275185a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186098352} {:answer/id #uuid "4b8e1f41-64f8-59e0-9724-a1c5c1048ea7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186098353} {:answer/id #uuid "5577da54-f5fb-54a7-9f4e-6e9bcb0caab2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186098354}] :answer-field/correct {:db/id #edb/ref 17592186098351} :answer-field/id #uuid "fd1e9bdb-d524-5760-8ec4-cba71941a400" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186098349}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9dcfbb8-b458-5675-b01f-0a851451c52c" :question/math-academy-id "q-144824" :question/problem "![](images/a4/a4a238887e789979e276421850330c5b36a82c485312c06e831c0df96266b85b.png)\n\nThe function $f(x)$ is defined and differentiable on $[-1,5].$ The graph of ${f}^{′}(x),$ the derivative of $f(x),$ is shown above, where the area of the region between the graph and the $x$-axis is $6.$ Find the minimum value of $f(x)$ on the interval $[-1,5]$ given that $f(-1)=1.$" :question/worked-solution "According to the candidates test, the minimum value of $f(x)$ on $[-1,5]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points:\n\nWe see that ${f}^{′}(x)$ is defined everywhere on $x\\in (-1,5),$ and ${f}^{′}(x)\\ne 0$ on this interval. Therefore, the candidates are $x=-1,5.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus:\n\n$$\n\\begin{aligned}f(-1) & =1 \\\\ f(5) & =f(-1)+{\\int }_{-1}^{5}{f}^{′}(x)\\,\\text{d}x \\\\  & =1+6 \\\\  & =7\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\n{f}_{\\text{min}}=\\min \\{1,7\\}=1.\n$$\n\nTherefore, the minimum value of $f$ is ${f}_{\\text{min}}=1,$ and the value of $x$ that minimizes $f(x)$ is ${x}_{\\text{min}}=-1.$"} {:db/id #edb/ref 17592186101176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9af57894-36ab-5e73-bc6c-53679f507c77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\textrm{i}" :db/id #edb/ref 17592186098392} {:answer/id #uuid "d0e58a11-4660-5dcb-9953-cc0476088493" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 + 6\\textrm{i}" :db/id #