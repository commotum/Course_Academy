nding to the function $g(x_{1}, x_{2}, f(x_{1}, x_{2}, x_{3}))$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_{1}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_{2}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_{3}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$g(x_{1}, x_{2}, f(x_{1}, x_{2}, x_{3}))$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">{{field-1}}</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">{{field-2}}</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">{{field-3}}</td>\n</tr>\n<tr>\n<td data-cell-align