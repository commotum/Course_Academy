f 17592186239891} {:answer/id #uuid "d222d7af-bcc2-54b0-bd8f-b14855923fe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{ln}^{2}⁡2}{3}" :db/id #edb/ref 17592186239900} {:answer/id #uuid "da6b93e1-2f2d-5dd2-9235-e2c75c2150c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{ln}^{3}⁡2+\\operatorname{ln}⁡2-9" :db/id #edb/ref 17592186239960} {:answer/id #uuid "ddbcc56c-8e28-5705-901c-a7945ed7e836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{sec⁡x(tan⁡x+1)}{3{e}^{x}}" :db/id #edb/ref 17592186239990} {:answer/id #uuid "e22d82e1-3f0d-5981-bca2-0a4d5eba60db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{x}ln⁡2csc⁡xcot⁡x" :db/id #edb/ref 17592186240044} {:answer/id #uuid "e6e37b21-cc92-59c4-9bda-e10d7f67783c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3cos⁡x-sec⁡xtan⁡x" :db/id #edb/ref 17592186240087} {:answer/id #uuid "f072d48a-4459-559f-aaa6-60307b5cf008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5-{csc}^{2}⁡x" :db/id #edb/ref 17592186240177} {:answer/id #uuid "f622f3d7-b438-53d7-9272-6937b0c0643b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3{u}^{2}{cos}^{2}⁡v+4{u}^{2}+36}" :db/id #edb/ref 17592186240225} {:answer/id #uuid "ffca6930-a453-5efc-ba11-64e5e1be934c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186240327} {:db/id #edb/ref 17592186240804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037393f2-b6d0-5f15-83d8-ecc1860d366c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & -2 & 4 \\\\ 0 & -1 & 2 \\\\ 0 & 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186238112} {:answer/id #uuid "6ab2f7b0-2737-5b4c-bbd9-35ee06e4f051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & -1 & 1 \\\\ 4 & 2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186238979} {:answer/id #uuid "6e0bd746-222a-5820-82fc-3ca96f0e2566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 1 & -1 \\\\ -4 & -2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186239002} {:answer/id #uuid "d9eb1982-ea08-5419-a703-c8a1cd07e7c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 3 & 1 \\\\ 0 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186239957} {:answer/id #uuid "ff00e538-8c1b-580a-b72d-811689b8542b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 3 & 1 \\\\ 0 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186240313}] :answer-field/correct {:db/id #edb/ref 17592186239002} :answer-field/id #uuid "703ead68-58ab-5b1c-a34a-4f9cab386dc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240537}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0b281857-5cf5-5dda-b8cb-bae31f90bde6" :question/math-academy-id "q-104134" :question/problem "Find the inverse of the matrix $A=\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 3 & 1 \\\\ 0 & 2 & 1\\end{bmatrix}$\ngiven that $det(A)=-1.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=-1\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}3 & 1 \\\\ 2 & 1\\end{vmatrix} & \\begin{vmatrix}2 & 1 \\\\ 0 & 1\\end{vmatrix} & \\begin{vmatrix}2 & 3 \\\\ 0 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 0 \\\\ 2 & 1\\end{vmatrix} & \\begin{vmatrix}-1 & 0 \\\\ 0 & 1\\end{vmatrix} & \\begin{vmatrix}-1 & 0 \\\\ 0 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 0 \\\\ 3 & 1\\end{vmatrix} & \\begin{vmatrix}-1 & 0 \\\\ 2 & 1\\end{vmatrix} & \\begin{vmatrix}-1 & 0 \\\\ 2 & 3\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 & 4 \\\\ 0 & -1 & -2 \\\\ 0 & -1 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}1 & -2 & 4 \\\\ 0 & -1 & 2 \\\\ 0 & 1 & -3\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & -1 & 1 \\\\ 4 & 2 & -3\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{(-1)}\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & -1 & 1 \\\\ 4 & 2 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 1 & -1 \\\\ -4 & -2 & 3\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1011aa3a-954e-50dc-ae18-549fb483dc2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{x}^{2}}-\\frac{1}{2{x}^{4}}" :db/id #edb/ref 17592186238192} {:answer/id #uuid "37a1c828-f01a-5291-b4c3-a7df666b6ef7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2{x}^{4}}+\\frac{1}{x}" :db/id #edb/ref 17592186238537} {:answer/id #uuid "624d0f96-ecbc-542d-a722-fcec02fdffb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186238921} {:answer/id #uuid "77f204bc-bb7d-50f3-9399-6ddab9bf24e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3{x}^{3}}-\\frac{2}{x}" :db/id #edb/ref 17592186239090} {:answer/id #uuid "cf221d71-61bf-50ec-ba67-26d985655f37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{{x}^{2}}-\\frac{1}{{x}^{4}}" :db/id #edb/ref 17592186239871}] :answer-field/correct {:db/id #edb/ref 17592186238921} :answer-field/id #uuid "25967c04-e2d2-5d17-a034-bddf2421e5de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240397}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3c5fc6aa-a9f3-5065-aa63-827da84b30b5" :question/math-academy-id "q-104191" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=ln⁡x+\\frac{1}{6{x}^{2}}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+\\frac{1}{6{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+\\frac{1}{6}{x}^{-2}) \\\\  & =\\frac{1}{x}+\\frac{1}{6}\\cdot (-2){x}^{-2-1} \\\\  & ={x}^{-1}-\\frac{1}{3}{x}^{-3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-1}-\\frac{1}{3}{x}^{-3}) \\\\  & =(-1){x}^{-1-1}-\\frac{1}{3}\\cdot (-3){x}^{-3-1} \\\\  & =\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa44a27-ef68-5389-9758-f884a5d93477" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x" :db/id #edb/ref 17592186238277} {:answer/id #uuid "2415dd70-94cd-5924-9d0e-22cf05a020c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{\\sqrt{{x}^{5}}}+cos⁡x" :db/id #edb/ref 17592186238374} {:answer/id #uuid "93cb1ee1-225c-5deb-b3e5-a0bf21607a98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{{x}^{5}}-sin⁡x" :db/id #edb/ref 17592186239332} {:answer/id #uuid "9d1e2a22-2c42-5e28-96bc-5600c10b0095" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3\\sqrt{{x}^{5}}}+2sin⁡x" :db/id #edb/ref 17592186239420} {:answer/id #uuid "b15c3867-b8c6-5277-b1af-d18fc8689a91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{{x}^{5}}-2cos⁡x" :db/id #edb/ref 17592186239603}] :answer-field/correct {:db/id #edb/ref 17592186238277} :answer-field/id #uuid "3465f331-8843-5ef7-b5b2-36db197078df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c7aef485-7834-5512-aabf-9615a3c07b9a" :question/math-academy-id "q-104192" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{4}{\\sqrt{x}}+2sin⁡x.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{\\sqrt{x}}+2sin⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{-1/2}+2sin⁡x) \\\\  & =4\\left(-\\frac{1}{2}\\right){x}^{-1/2-1}+2cos⁡x \\\\  & =-2{x}^{-3/2}+2cos⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-3/2}+2cos⁡x) \\\\  & =-2\\left(-\\frac{3}{2}\\right){x}^{-3/2-1}-2sin⁡x \\\\  & =\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d92a68-6dc4-55b8-819a-be6de39de124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186238115} {:answer/id #uuid "4ee6de5f-21b1-5f5b-b00e-fe4e72154f4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186238731} {:answer/id #uuid "5bcc1a21-6f7d-5e4e-bc94-692e6346036d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186238856} {:answer/id #uuid "93773063-d397-5639-a296-d8298ec31817" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239329} {:answer/id #uuid "c9d0a4f7-e201-567f-a54d-9b674bbe5d97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239828}] :answer-field/correct {:db/id #edb/ref 17592186238856} :answer-field/id #uuid "925a1ba9-2a5a-5cae-9b78-da6137bd36e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240585}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab4208a8-9578-51f0-acb9-055b5b3297cd" :question/math-academy-id "q-104273" :question/problem "$$\nf(r,\\theta )=⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,\\text{_____}⟩\n$$\n\nThe vector-valued function $f(r,\\theta )$ parametrizes the surface defined in cylindrical polar coordinates as \n$\\frac{{z}^{2}}{{r}^{4}}={sin}^{2}⁡2\\theta $\nfor $z\\ge 0$ and $0\\le \\theta \\le \\frac{\\pi }{2}.$ What is the third component of $f?$" :question/worked-solution "First, we write the equation of the surface in the form $z=f(r,\\theta ):$\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{{r}^{4}} & ={sin}^{2}⁡2\\theta  \\\\ {z}^{2} & ={r}^{4}{sin}^{2}⁡2\\theta  \\\\ z & ={r}^{2}|\\operatorname{sin}⁡2\\theta | \\\\ z & ={r}^{2}\\operatorname{sin}⁡2\\theta \\end{aligned}\n$$\n\nWe disregard the negative solution since we are given that $z\\ge 0.$ Also, we drop the absolute value bars because $\\operatorname{sin}⁡2\\theta \\ge 0$ for  $0\\le \\theta \\le \\frac{\\pi }{2}.$  \n\nIf $(r,\\theta ,z)$ are the cylindrical coordinates of a point and $(x,y,z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,z⟩.\n$$\n\nFinally, substituting $z={r}^{2}\\operatorname{sin}⁡2\\theta ,$ we obtain\n\n$$\nf(r,\\theta )=⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,{r}^{2}\\operatorname{sin}⁡2\\theta ⟩.\n$$\n\nTherefore, the third component of $f$ is ${r}^{2}\\operatorname{sin}⁡2\\theta .$"} {:db/id #edb/ref 17592186240845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20897b11-31f3-5236-8344-066364ab30aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{x}\\operatorname{cos}x-{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186238339} {:answer/id #uuid "2e9dc0f2-2211-5b4e-a2e7-26a81ec7f21c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}\\operatorname{cos}x+\\operatorname{sin}x" :db/id #edb/ref 17592186238465} {:answer/id #uuid "528c811e-a747-5b55-b5c7-a2d707220097" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}\\operatorname{cos}x-{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186238765} {:answer/id #uuid "c9cd3281-ae65-5560-8442-2a603e50ff12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{x}\\operatorname{cos}x+\\operatorname{sin}x" :db/id #edb/ref 17592186239827} {:answer/id #uuid "cce47b31-03c3-57e4-ae08-02ac34ba2a0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}\\operatorname{cos}x+{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186239848}] :answer-field/correct {:db/id #edb/ref 17592186238765} :answer-field/id #uuid "fe0d6216-93d3-5d7b-aefb-cbdf2e8a0a46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240776}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d7240cf-a773-5ae8-8c7e-03955317789e" :question/math-academy-id "q-104297" :question/problem "Differentiate ${e}^{x}cos⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}cos⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot cos⁡x+{e}^{x}\\cdot (cos⁡x)^{′} \\\\  & =({e}^{x})(cos⁡x)+({e}^{x})(-sin⁡x) \\\\  & ={e}^{x}cos⁡x-{e}^{x}sin⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2632ed0e-a0d8-5838-99b3-caf9fc3323f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{sec⁡x(3-tan⁡x)}{{e}^{x}}" :db/id #edb/ref 17592186238386} {:answer/id #uuid "a30b3d40-730b-51f0-91c8-75d864cb46ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3sec⁡x(tan⁡x-1)}{{e}^{2x}}" :db/id #edb/ref 17592186239475} {:answer/id #uuid "c336da9c-792b-5424-869b-a052d7ed93a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3sec⁡x(tan⁡x-1)}{{e}^{x}}" :db/id #edb/ref 17592186239776} {:answer/id #uuid "cbb7ae18-48e7-50b1-acfe-ee839427a602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{sec⁡x(3-tan⁡x)}{{e}^{2x}}" :db/id #edb/ref 17592186239841} {:answer/id #uuid "ddbcc56c-8e28-5705-901c-a7945ed7e836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{sec⁡x(tan⁡x+1)}{3{e}^{x}}" :db/id #edb/ref 17592186239990}] :answer-field/correct {:db/id #edb/ref 17592186239776} :answer-field/id #uuid "19a7c17a-3225-5ddf-8958-0a6ed618d4a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240370}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8b729c6-447d-5486-b8ab-6761a892119d" :question/math-academy-id "q-104325" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3sec⁡x}{{e}^{x}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{3sec⁡x}{{e}^{x}}\\right) \\\\  & =\\frac{(3sec⁡xtan⁡x)({e}^{x})-(3sec⁡x)({e}^{x})}{({e}^{x})^{2}} \\\\  & =\\frac{3{e}^{x}sec⁡x(tan⁡x-1)}{{e}^{2x}} \\\\  & =\\frac{3sec⁡x(tan⁡x-1)}{{e}^{x}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a41ac59-e4b2-575f-8c90-43895d009fcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ\\operatorname{sin}⁡\\theta {cos}^{3}⁡ϕ" :db/id #edb/ref 17592186238699} {:answer/id #uuid "582c5fce-a4c7-5fcf-bbc3-f1919593b473" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ{cos}^{3}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238816} {:answer/id #uuid "6317a0c2-458e-5478-9e03-1662af7bd126" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ{cos}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238924} {:answer/id #uuid "7452a017-5479-5003-8a3c-6bd6345e4ae6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186239053} {:answer/id #uuid "87e5ff49-23f6-52c0-9253-2a37f8ebb044" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ\\operatorname{sin}⁡\\theta {cos}^{2}⁡ϕ" :db/id #edb/ref 17592186239236}] :answer-field/correct {:db/id #edb/ref 17592186238816} :answer-field/id #uuid "c95011d6-57e0-5721-8599-1890c43ee0ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240681}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0182a635-c5bf-5468-bfb5-8e21b55ef8c2" :question/math-academy-id "q-104368" :question/problem "$$\nf(\\theta ,ϕ)=⟨\\text{_____},\\,ϕ{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{cos}^{2}⁡\\theta \\operatorname{cos}⁡ϕ⟩\n$$\n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho =ϕ{cos}^{2}⁡\\theta .$\nWhat is the first component of $f?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =ϕ{cos}^{2}⁡\\theta ,$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨ϕ{cos}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{cos}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{cos}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨ϕ{cos}^{3}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{cos}^{2}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the first component of $f$ is $ϕ{cos}^{3}⁡\\theta \\operatorname{sin}⁡ϕ.$"} {:db/id #edb/ref 17592186240859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57f3d9c7-7c0c-5e96-89bf-7f33e45b5099" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡2\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238812} {:answer/id #uuid "5f3c282b-26ca-5daa-a40a-87226b0df98c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238884} {:answer/id #uuid "8eb82535-2acd-5a26-b875-149c36a2c21c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ" :db/id #edb/ref 17592186239295} {:answer/id #uuid "95b941f6-6383-5db9-b5dd-6e70a8cfc10c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186239350} {:answer/id #uuid "ce7f5849-89ab-5380-8c35-99f76b79ca0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186239864}] :answer-field/correct {:db/id #edb/ref 17592186238812} :answer-field/id #uuid "042f70bb-fb8c-5bb4-9bda-03ea74b21086" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240331}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a9e5109e-4f42-5a9d-b1d9-a120a5c5fa29" :question/math-academy-id "q-104372" :question/problem "$$\nf(\\theta ,ϕ)=⟨\\text{_____},\\,2{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ⟩\n$$\n\n \n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho =2\\operatorname{sin}⁡\\theta .$\nWhat is the first component of $f?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =2\\operatorname{sin}⁡\\theta ,$ we obtain \n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨\\operatorname{sin}⁡2\\theta \\operatorname{sin}⁡ϕ,\\,2{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the first component of $f$ is $\\operatorname{sin}⁡2\\theta \\operatorname{sin}⁡ϕ.$"} {:db/id #edb/ref 17592186240860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "314ba01e-97fa-502e-834c-85bc950e705a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238483} {:answer/id #uuid "3ce1e74a-5003-59b4-9882-e3cd70bc695f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ{sin}^{3}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238582} {:answer/id #uuid "3f082dad-886c-5e08-b838-33d0fdf3b861" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238606} {:answer/id #uuid "5952e398-f0dd-5b91-9eca-52ab54bb6f61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ" :db/id #edb/ref 17592186238823} {:answer/id #uuid "898e8ba4-037b-50bf-9a73-4536cedd15f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ϕ\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186239252}] :answer-field/correct {:db/id #edb/ref 17592186238582} :answer-field/id #uuid "5b0857ac-e4fb-560c-9a43-81fec9565c2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240499}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f7322663-d17a-5b8b-9446-b90394808a49" :question/math-academy-id "q-104375" :question/problem "$$\nf(\\theta ,ϕ)=⟨ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\text{_____},\\,ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡ϕ⟩\n$$\n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho =ϕ{sin}^{2}⁡\\theta .$\nWhat is the second component of $f?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =ϕ{sin}^{2}⁡\\theta ,$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨ϕ{sin}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{3}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the second component of $f$ is $ϕ{sin}^{3}⁡\\theta \\operatorname{sin}⁡ϕ.$"} {:db/id #edb/ref 17592186240871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "318e4ff1-9eda-5227-97de-069fe65726f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186238485} {:answer/id #uuid "581fb52d-c562-5a61-83a7-0ccc875e2d6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186238814} {:answer/id #uuid "852c2a15-9bb2-5c2f-a3f3-70dc20643dc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186239213} {:answer/id #uuid "99946c30-ae52-50d2-ab9b-73478b6df019" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186239388} {:answer/id #uuid "c135f6ba-7057-5a82-9972-767caa7e7342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186239744}] :answer-field/correct {:db/id #edb/ref 17592186239388} :answer-field/id #uuid "05ee2e28-0127-5de7-9d19-9359e9043495" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240334}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc11b8c2-85be-59ad-bbca-214a365781c5" :question/math-academy-id "q-104413" :question/problem "Determine the entry ${a}_{23}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}3 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$ \n\n$$\n\\begin{aligned}\\text{det}A=\\begin{vmatrix}3 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{vmatrix} & =3\\begin{vmatrix}1 & 0 \\\\ -1 & 1\\end{vmatrix}-0\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}+1\\begin{vmatrix}1 & 1 \\\\ 0 & -1\\end{vmatrix} \\\\  & =3(1-0)-0+(-1-0) \\\\  & =3+0-1 \\\\  & =2.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{23}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{32}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{32} & =(-1)^{3+2}\\begin{vmatrix}3 & 1 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-\\begin{vmatrix}3 & 1 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-(0-1) \\\\  & =1.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{23}^{′}=\\frac{1}{\\text{det}(A)}{c}_{32}=\\frac{1}{2}\\cdot 1=\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321b8d3b-cd54-5aec-b3c6-614d9119d85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186238490} {:answer/id #uuid "82f83531-f2a4-50ef-b8cf-747f2110b4e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186239195} {:answer/id #uuid "c2a62450-4a64-5b83-97a1-956b91c29de7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186239765} {:answer/id #uuid "c3910286-f59a-54dd-9194-1920e9c24f46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186239783} {:answer/id #uuid "efe95074-4ae4-5190-923c-417bab521d7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186240167}] :answer-field/correct {:db/id #edb/ref 17592186239765} :answer-field/id #uuid "0c312751-eff3-5874-b792-a6fa94261128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d6189c9e-c299-5fe1-934e-c85b7854108f" :question/math-academy-id "q-104416" :question/problem "Determine the entry ${a}_{31}^{′}$ in the inverse of a matrix $A$ $=\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & 2 & 1 \\\\ 2 & -1 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$ \n\n$$\n\\begin{aligned}\\text{det}A=\\begin{vmatrix}-1 & 1 & 0 \\\\ 1 & 2 & 1 \\\\ 2 & -1 & 1\\end{vmatrix} & =(-1)\\begin{vmatrix}2 & 1 \\\\ -1 & 1\\end{vmatrix}-1\\begin{vmatrix}1 & 1 \\\\ 2 & 1\\end{vmatrix}+0\\begin{vmatrix}1 & 2 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-(2+1)-(1-2)+0 \\\\  & =-3+1+0 \\\\  & =-2.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{31}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}\\begin{vmatrix}1 & 2 \\\\ 2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 2 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-1-4 \\\\  & =-5.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′}=\\frac{1}{\\text{det}(A)}{c}_{13}=\\frac{1}{-2}\\cdot (-5)=\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0823e679-5623-5513-8197-33a1c8ae8c23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186238141} {:answer/id #uuid "4ef0a0c8-e834-5d68-a259-7fedd6fed2b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186238732} {:answer/id #uuid "6c5fede8-1aad-5729-9d8a-208e730ea058" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186238989} {:answer/id #uuid "e74baa48-26f8-5695-bad5-d271d1e3e38f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186240091} {:answer/id #uuid "fa084b2e-50e1-5131-aea7-50c9409524aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186240265}] :answer-field/correct {:db/id #edb/ref 17592186238732} :answer-field/id #uuid "65817036-87eb-5cc8-80d8-f7e75f7b7758" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240517}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "57a186fd-b1ba-539f-bb9d-e1998b570fc0" :question/math-academy-id "q-104428" :question/problem "The entry ${a}_{12}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}0 & 0 & 1 \\\\ k & 1 & 1 \\\\ -2 & 2 & 1\\end{bmatrix}\n$$\nequals $\\frac{1}{2}$ and $det(A)=2k+2.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=2k+2\n$$\n\nSince we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}\\begin{vmatrix}0 & 1 \\\\ 2 & 1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}0 & 1 \\\\ 2 & 1\\end{vmatrix} \\\\  & =-(0-2) \\\\  & =2\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{21} \\\\  & =\\frac{1}{2k+2}\\cdot 2 \\\\  & =\\frac{1}{k+1}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{12}^{′}=\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k+1} & =\\frac{1}{2} \\\\ k+1 & =2 \\\\ k & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3541fac5-1091-5ae2-a5ad-314c1f884760" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186238516} {:answer/id #uuid "5ae53416-c44d-546d-8f7e-7708603910aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186238842} {:answer/id #uuid "6328ad49-14be-5303-988b-aaee411b7a0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186238926} {:answer/id #uuid "eb9f65d2-628a-5c01-b36e-b3ccb0b68a33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186240128} {:answer/id #uuid "f4a8d1a8-0d2d-581e-9482-a9f728baa3e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186240216}] :answer-field/correct {:db/id #edb/ref 17592186240216} :answer-field/id #uuid "57747a39-2687-5194-90fc-e0d6b4a69104" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240491}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "539f41b1-227f-56ae-b693-cf3443bf466c" :question/math-academy-id "q-104431" :question/problem "The entry ${a}_{32}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 0 & 1 \\\\ 1 & 1 & k \\\\ -1 & 2 & 1\\end{bmatrix}\n$$\nequals $-1$ and $det(A)=4-2k.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=4-2k\n$$\n\nSince we want the entry ${a}_{32}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{23}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{23} & =(-1)^{2+3}\\begin{vmatrix}1 & 0 \\\\ -1 & 2\\end{vmatrix} \\\\  & =-\\begin{vmatrix}1 & 0 \\\\ -1 & 2\\end{vmatrix} \\\\  & =-(2-0) \\\\  & =-2\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{32}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{23} \\\\  & =\\frac{1}{4-2k}\\cdot (-2) \\\\  & =\\frac{1}{k-2}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{32}^{′}=-1$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k-2} & =-1 \\\\ 1 & =2-k \\\\ k & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3907885c-b8d9-5a8a-b101-b8bacd3c100c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186238548} {:answer/id #uuid "59dc3dbc-a563-5ed7-a2b8-0b53ab3690df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186238829} {:answer/id #uuid "7219f929-3c4c-5130-ba67-06b6ec68f6bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186239034} {:answer/id #uuid "e1294134-a47b-51be-972a-dbe70aba54ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186240033} {:answer/id #uuid "e666f6f4-3b9a-508e-addb-22f8d57a69de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186240078}] :answer-field/correct {:db/id #edb/ref 17592186238548} :answer-field/id #uuid "4d4629b7-d427-5661-a6f1-3af0b7b88fc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240464}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55417378-dec5-552f-8b04-ebd15181a9f3" :question/math-academy-id "q-104439" :question/problem "The entry ${a}_{22}^{′}$ in the inverse of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 2 & 1 \\\\ -1 & k & 2 \\\\ 0 & 2 & 1\\end{bmatrix}\n$$\nequals $-\\frac{1}{4}$ and $det(A)=k-4.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=k-4\n$$\n\nSince we want the entry ${a}_{22}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{22}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{22} & =(-1)^{2+2}\\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{22}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{22} \\\\  & =\\frac{1}{k-4}\\cdot 1 \\\\  & =\\frac{1}{k-4}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{22}^{′}=-\\frac{1}{4}$, we have\n\n$$\n\\begin{aligned}-\\frac{1}{4} & =\\frac{1}{k-4} \\\\ k-4 & =-4 \\\\ k & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f7e706-6667-560b-bd84-79164bd2ed56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186238265} {:answer/id #uuid "485520fe-f7db-5462-90b3-8b9dc00969d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186238684} {:answer/id #uuid "4ebd5941-c9bf-5355-a88c-6736db31de31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186238730} {:answer/id #uuid "746fc071-c68b-5025-87be-eb8a9b327237" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186239055} {:answer/id #uuid "fe35b390-cf3c-53c9-b56a-b8e3bb467faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186240302}] :answer-field/correct {:db/id #edb/ref 17592186239055} :answer-field/id #uuid "1a5d153b-a4b3-593f-9ec7-5127df5989a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240372}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10b5a865-9dfd-5753-8931-5381fe6e32af" :question/math-academy-id "q-104442" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $$\n\\displaystyle f(x)=\\frac{sec⁡x}{\\sqrt{3}}+\\frac{3{x}^{2}}{\\pi }.\n$$" :question/worked-solution "First, we take the derivative of each term and then add them, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{sec⁡x}{\\sqrt{3}}+\\frac{3{x}^{2}}{\\pi }) \\\\  & =\\frac{sec⁡xtan⁡x}{\\sqrt{3}}+\\frac{6x}{\\pi }\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{\\pi /3} & =\\frac{1}{\\sqrt{3}}\\cdot sec⁡\\left(\\frac{\\pi }{3}\\right)\\cdot tan⁡\\left(\\frac{\\pi }{3}\\right)+\\frac{6}{\\pi }\\cdot \\frac{\\pi }{3} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot 2\\cdot \\sqrt{3}+2 \\\\  & =2+2 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290df338-cbf5-5bde-98fe-bac5fcf6883e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186238418} {:answer/id #uuid "7ddc03a9-31e0-5513-b8a2-708a0189a34d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186239146} {:answer/id #uuid "8c16ab80-c07b-5b4b-ad79-83a262db83fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186239272} {:answer/id #uuid "b62a8c7a-d543-5087-9732-2e1cdd0bd83b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186239645} {:answer/id #uuid "e537f447-3bfe-5af5-84c5-e2af277694e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186240067}] :answer-field/correct {:db/id #edb/ref 17592186240067} :answer-field/id #uuid "3dbcab08-178c-57a6-a96a-3ec75b0b9a67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240438}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b86d16b9-91e7-5d11-97b1-e0f931afe9d2" :question/math-academy-id "q-104536" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\left\\{\\begin{aligned}y+z &=1 \\\\ 2x-2z &=2+2y \\\\ 2y+4z &=2x-2\\end{aligned}\\right.\n$$\n\nFind  $x+y+z.$" :question/worked-solution "First, let's rewrite the system in the correct order:\n\n$$\n\\left\\{\\begin{aligned}y+z &=1 \\\\ 2x-2y-2z &=2 \\\\ -2x+2y+4z &=-2\\end{aligned}\\right.\n$$\n\nNext, we  write the system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n\\begin{bmatrix}0 & 1 & 1 \\\\ 2 & -2 & -2 \\\\ -2 & 2 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix}.\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}0 & 1 & 1 \\\\ 2 & -2 & -2 \\\\ -2 & 2 & 4\\end{vmatrix} \\\\  & =0\\begin{vmatrix}-2 & -2 \\\\ 2 & 4\\end{vmatrix}-1\\begin{vmatrix}2 & -2 \\\\ -2 & 4\\end{vmatrix}+1\\begin{vmatrix}2 & -2 \\\\ -2 & 2\\end{vmatrix} \\\\  & =0-(8-4)+(4-4) \\\\  & =-4+0 \\\\  & =-4.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}-2 & -2 \\\\ 2 & 4\\end{vmatrix} & \\begin{vmatrix}2 & -2 \\\\ -2 & 4\\end{vmatrix} & \\begin{vmatrix}2 & -2 \\\\ -2 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}1 & 1 \\\\ 2 & 4\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ -2 & 4\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ -2 & 2\\end{vmatrix} \\\\ \\begin{vmatrix}1 & 1 \\\\ -2 & -2\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 2 & -2\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 2 & -2\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 4 & 0 \\\\ 2 & 2 & 2 \\\\ 0 & -2 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=\\begin{bmatrix}-4 & -4 & 0 \\\\ -2 & 2 & -2 \\\\ 0 & 2 & -2\\end{bmatrix}.\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=\\begin{bmatrix}-4 & -2 & 0 \\\\ -4 & 2 & 2 \\\\ 0 & -2 & -2\\end{bmatrix}.\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{-4}\\begin{bmatrix}-4 & -2 & 0 \\\\ -4 & 2 & 2 \\\\ 0 & -2 & -2\\end{bmatrix}=\\frac{1}{2}\\begin{bmatrix}2 & 1 & 0 \\\\ 2 & -1 & -1 \\\\ 0 & 1 & 1\\end{bmatrix}.\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & 1 & 0 \\\\ 2 & -1 & -1 \\\\ 0 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}4 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $x+y+z=2+1+0=3.$"} {:db/id #edb/ref 17592186240894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1604f16b-b6ec-5977-8db2-4745c554c4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3,y=-11,z=-6" :db/id #edb/ref 17592186238242} {:answer/id #uuid "1fd6c920-44cd-558c-b5b5-5a4fb709b7fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-11,y=6,z=-3" :db/id #edb/ref 17592186238330} {:answer/id #uuid "37255593-62a2-5d88-b4ca-46ad8477c825" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=11,y=6,z=3" :db/id #edb/ref 17592186238534} {:answer/id #uuid "862e6d9d-6938-55b2-9966-6d4c843929b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=11,y=-6,z=-3" :db/id #edb/ref 17592186239222} {:answer/id #uuid "f6e74476-4ff0-5e8b-8dc3-25b96e048393" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=6,y=-3,z=-11" :db/id #edb/ref 17592186240233}] :answer-field/correct {:db/id #edb/ref 17592186239222} :answer-field/id #uuid "0d168cf8-68f1-5703-91a1-1c3db1aa2a7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240348}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30372d4a-7cb0-560b-a8cf-a404cabf96f7" :question/math-academy-id "q-104541" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\left\\{\\begin{aligned}y+z+x &=2 \\\\ -3z+y &=3 \\\\ 2x+y &=4-4z\\end{aligned}\\right.\n$$" :question/worked-solution "We organize the system so that it’s in the correct order first:\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=2 \\\\ y-3z &=3 \\\\ 2x+y+4z &=4\\end{aligned}\\right.\n$$\n\nWe wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 1 & -3 \\\\ 2 & 1 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}.\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}1 & 1 & 1 \\\\ 0 & 1 & -3 \\\\ 2 & 1 & 4\\end{vmatrix} \\\\  & =1\\begin{vmatrix}1 & -3 \\\\ 1 & 4\\end{vmatrix}-1\\begin{vmatrix}0 & -3 \\\\ 2 & 4\\end{vmatrix}+1\\begin{vmatrix}0 & 1 \\\\ 2 & 1\\end{vmatrix} \\\\  & =(4+3)-(0+6)+(0-2) \\\\  & =-1.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}1 & -3 \\\\ 1 & 4\\end{vmatrix} & \\begin{vmatrix}0 & -3 \\\\ 2 & 4\\end{vmatrix} & \\begin{vmatrix}0 & 1 \\\\ 2 & 1\\end{vmatrix} \\\\ \\begin{vmatrix}1 & 1 \\\\ 1 & 4\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 2 & 4\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 2 & 1\\end{vmatrix} \\\\ \\begin{vmatrix}1 & 1 \\\\ 1 & -3\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 0 & -3\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 0 & 1\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 6 & -2 \\\\ 3 & 2 & -1 \\\\ -4 & -3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=\\begin{bmatrix}7 & -6 & -2 \\\\ -3 & 2 & 1 \\\\ -4 & 3 & 1\\text{ }\\end{bmatrix}.\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=\\begin{bmatrix}7 & -3 & -4 \\\\ -6 & 2 & 3 \\\\ -2 & 1 & 1\\end{bmatrix}.\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{-1}\\begin{bmatrix}7 & -3 & -4 \\\\ -6 & 2 & 3 \\\\ -2 & 1 & 1\\end{bmatrix}=\\begin{bmatrix}-7 & 3 & 4 \\\\ 6 & -2 & -3 \\\\ 2 & -1 & -1\\end{bmatrix}.\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}-7 & 3 & 4 \\\\ 6 & -2 & -3 \\\\ 2 & -1 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}11 \\\\ -6 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nHence the solution is $x=11,y=-6,z=-3.$"} {:db/id #edb/ref 17592186240895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef491d6-2ab5-50e3-af24-150a984cf7e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1,y=2,z=1" :db/id #edb/ref 17592186238315} {:answer/id #uuid "6433840e-f62b-5d25-8771-780117ffbb37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1,y=1,z=2" :db/id #edb/ref 17592186238933} {:answer/id #uuid "7d19c17c-f45c-59ab-ad2c-fc3a4aac1a70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1,y=-2,z=-1" :db/id #edb/ref 17592186239137} {:answer/id #uuid "e38fd3ea-ff34-57f1-b478-4bbf6667b49b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,y=-1,z=2" :db/id #edb/ref 17592186240056} {:answer/id #uuid "e8758369-817b-5292-aa34-f56b3a84956f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2,y=1,z=1" :db/id #edb/ref 17592186240101}] :answer-field/correct {:db/id #edb/ref 17592186238315} :answer-field/id #uuid "d3164e39-ba71-5ae7-8548-2f22c8c3ac60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240704}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c5fa419-7d88-586a-9224-2f097b998fb5" :question/math-academy-id "q-104546" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\left\\{\\begin{aligned}z+x &=2 \\\\ 2y-3z &=1 \\\\ 2z-y &=-3x+3\\end{aligned}\\right.\n$$" :question/worked-solution "We organize the system so that it’s in the correct order first:\n\n$$\n\\left\\{\\begin{aligned}x+z &=2 \\\\ 2y-3z &=1 \\\\ 3x-y+2z &=3\\end{aligned}\\right.\n$$\n\nWe wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 3 & -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix}.\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 3 & -1 & 2\\end{vmatrix} \\\\  & =1\\begin{vmatrix}2 & -3 \\\\ -1 & 2\\end{vmatrix}-0\\begin{vmatrix}0 & -3 \\\\ 3 & 2\\end{vmatrix}+1\\begin{vmatrix}0 & 2 \\\\ 3 & -1\\end{vmatrix} \\\\  & =(4-3)-0+(0-6) \\\\  & =-5.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}2 & -3 \\\\ -1 & 2\\end{vmatrix} & \\begin{vmatrix}0 & -3 \\\\ 3 & 2\\end{vmatrix} & \\begin{vmatrix}0 & 2 \\\\ 3 & -1\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 1 \\\\ -1 & 2\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 3 & 2\\end{vmatrix} & \\begin{vmatrix}1 & 0 \\\\ 3 & -1\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 1 \\\\ 2 & -3\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 0 & -3\\end{vmatrix} & \\begin{vmatrix}1 & 0 \\\\ 0 & 2\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 9 & -6 \\\\ 1 & -1 & -1 \\\\ -2 & -3 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=\\begin{bmatrix}1 & -9 & -6 \\\\ -1 & -1 & 1 \\\\ -2 & 3 & 2\\end{bmatrix}.\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=\\begin{bmatrix}1 & -1 & -2 \\\\ -9 & -1 & 3 \\\\ -6 & 1 & 2\\end{bmatrix}.\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{5}\\begin{bmatrix}1 & -1 & -2 \\\\ -9 & -1 & 3 \\\\ -6 & 1 & 2\\end{bmatrix}.\n$$\n\n \n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{5}\\begin{bmatrix}1 & -1 & -2 \\\\ -9 & -1 & 3 \\\\ -6 & 1 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nHence the solution is $x=1,y=2,z=1.$"} {:db/id #edb/ref 17592186240896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f068118-69f8-545c-a59c-bbfeb68cc68a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}\\operatorname{sin}⁡2x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186238468} {:answer/id #uuid "aff1ff05-43c0-5d47-b081-606201d6e332" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}\\operatorname{sin}⁡4x-\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186239583} {:answer/id #uuid "b0c8c053-f62a-5876-84dd-07b34658dade" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}\\operatorname{sin}⁡2x-\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186239593} {:answer/id #uuid "c3f3ad1e-6062-5b73-8e3e-5b0ff92966dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186239785} {:answer/id #uuid "cdf0f62f-831c-50ff-abd5-6eca305541e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186239857}] :answer-field/correct {:db/id #edb/ref 17592186239857} :answer-field/id #uuid "1a600a63-da52-5853-9d98-985d824bed2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240373}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "61dee2fb-b4a6-546d-85eb-f80ded427acb" :question/math-academy-id "q-10457" :question/problem "$$\n\\displaystyle \\int (5{cos}^{2}⁡2x-\\frac{{x}^{2}}{2})\\text{d}x=\n$$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (5{cos}^{2}⁡2x-\\frac{{x}^{2}}{2})\\text{d}x & =\\int [5\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)-\\frac{{x}^{2}}{2}]\\text{d}x \\\\  & =\\int (\\frac{5}{2}\\operatorname{cos}⁡4x+\\frac{5}{2}-\\frac{{x}^{2}}{2})\\text{d}x \\\\  & =\\frac{5}{2}\\cdot \\frac{1}{4}\\operatorname{sin}⁡4x+\\frac{5}{2}x-\\frac{1}{2}\\cdot \\frac{1}{3}{x}^{3}+C \\\\  & =\\frac{5}{8}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab61eea-ba71-5224-bbe8-eca2df0fe157" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{{\\pi }^{2}}-1" :db/id #edb/ref 17592186238278} {:answer/id #uuid "4b0e41b7-21e7-573e-b5d2-f356608a6ae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{\\pi -1}" :db/id #edb/ref 17592186238703} {:answer/id #uuid "ace99781-1604-53b3-b08e-f26c241a358f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186239557} {:answer/id #uuid "c2892dd7-dcc3-567c-8bcb-ac89416a6e15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}+\\pi " :db/id #edb/ref 17592186239762} {:answer/id #uuid "e7de7023-d488-540d-962c-5b17cc9d176b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186240095}] :answer-field/correct {:db/id #edb/ref 17592186238278} :answer-field/id #uuid "58ef2ea0-0a2c-50ba-bcc4-0d5182b81264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240495}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "86f7c787-e5df-5794-8bba-c906aa91522f" :question/math-academy-id "q-104739" :question/problem "Consider the vector field $\\mathbf{F},$ defined as\n\n$$\n\\mathbf{F}(x,y)={y}^{2}\\operatorname{cos}x\\hspace{0.167em}\\mathbf{i}+(2y\\operatorname{sin}x+{e}^{y})\\hspace{0.167em}\\mathbf{j}.\n$$\n\nEvaluate $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r,\n$$ where $C$ is the curve $y={x}^{2}+{sin}^{2}⁡x$ for $x\\in [0,\\pi ].$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $\\mathbf{r}(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}\\mathrm{∇}f\\cdot \\text{d}\\mathbf{r}=f(\\mathbf{r}(b))-f(\\mathbf{r}(a)).\n$$\n\n \n\nFirst, we define $P(x,y)$ and $Q(x,y)$ as follows:\n\n$$\n\\mathbf{F}(x,y)=\\underbrace{{y}^{2}\\operatorname{cos}x}_{P(x,y)}\\hspace{0.167em}\\mathbf{i}+\\underbrace{(2y\\operatorname{sin}x+{e}^{y})}_{Q(x,y)}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nTo apply the fundamental theorem for line integrals, we must first find a potential function $f$ (if it exists) such that $\\mathbf{F}=\\mathrm{∇}f.$ Notice that the domain of $\\mathbf{F}$ is ${\\mathbb{R}}^{2},$ and\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=2y\\operatorname{cos}⁡x\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${\\mathbb{R}}^{2},$ there exists a potential function $f$ such that $\\mathbf{F}=\\mathrm{∇}f,$ and we must have\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & ={y}^{2}\\operatorname{cos}⁡x, \\\\ {f}_{y}(x,y) & =2y\\operatorname{sin}⁡x+{e}^{y}.\\end{aligned}\n$$\n\nReconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf(x,y)={y}^{2}\\operatorname{sin}⁡x+{e}^{y}.\n$$\n\nNote that we set $C=0$ for the arbitrary constant since we can use any function $f$ that satisfies $\\mathrm{∇}f=\\mathbf{F}.$\n\nWe're now ready to apply the fundamental theorem for line integrals. A suitable parametrization of the curve $C$ is given by\n\n$$\n\\mathbf{r}(t)=⟨t,{t}^{2}+{\\operatorname{sin}}^{2}t⟩,\\hspace{1em}t\\in [0,\\pi ].\n$$\n\nThe position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩, \\\\ r(\\pi ) & =⟨\\pi ,{\\pi }^{2}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0)$ and $(\\pi ,{\\pi }^{2}).$\n\nFinally, applying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{C}\\mathrm{∇}f\\cdot \\text{d}\\mathbf{r} \\\\  & =f(\\pi ,{\\pi }^{2})-f(0,0) \\\\  & =({\\pi }^{4}\\cdot \\operatorname{sin}\\pi +{e}^{{\\pi }^{2}})-({0}^{2}\\cdot \\operatorname{sin}0+{e}^{0}) \\\\  & =(0+{e}^{{\\pi }^{2}})-(0+1) \\\\  & ={e}^{{\\pi }^{2}}-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61346844-f5db-5d81-988d-5f22f99364e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447690} {:answer/id #uuid "e325de96-c1e7-580b-b09d-da93b3fe3b32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447691}] :answer-field/correct {:db/id #edb/ref 17592186447691} :answer-field/id #uuid "59cd2a41-7643-579c-a7be-c9328567102c" :answer-field/key "$H(0,0)>0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448885} {:answer-field/choices [{:answer/id #uuid "65db9d78-e369-5af7-bf80-9aaea2cb0ae9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447692} {:answer/id #uuid "6608fb9a-406b-57eb-94b3-59aa661b60b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447693}] :answer-field/correct {:db/id #edb/ref 17592186447692} :answer-field/id #uuid "b0e6461c-403e-5a30-8b5c-3a1d65889782" :answer-field/key "$\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)>0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448886} {:answer-field/choices [{:answer/id #uuid "b9a29471-bdb1-5c51-8ffd-2502d26abe0f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447694} {:answer/id #uuid "5344e453-2eb8-5606-91f5-05f0b3a8e966" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447695}] :answer-field/correct {:db/id #edb/ref 17592186447695} :answer-field/id #uuid "d18799fe-c555-58ca-86dc-b96e74bdbd5a" :answer-field/key "The point $(0,0)$ is a local maximum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448887}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcc06ba1-1065-5981-a107-14dc46cea80e" :question/math-academy-id "q-104984" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}{e}^{-({x}^{2}+{y}^{2})}(2{x}^{2}-1) & 2xy{e}^{-({x}^{2}+{y}^{2})} \\\\ 2xy{e}^{-({x}^{2}+{y}^{2})} & {e}^{-({x}^{2}+{y}^{2})}(2{y}^{2}-1)\\end{bmatrix}\n$$\n\nand has a stationary point at $(0,0).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement $H(0,0)>0$ is true. Indeed, computing the determinant of ${f}^{″}(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))=(-1)^{2}-{0}^{2}=1>0.\n$$\n\n- Statement $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)>0$ is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,0))_{11}=-1<0.$\n\n- Statement “The point $(0,0)$ is a local maximum of $f$” is true. Indeed, since $H(0,0)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)<0,$ the point $(0,0)$ is a local maximum by the second partial derivative test.\n\nTherefore, the correct answer is $H(0,0)>0$; “The point $(0,0)$ is a local maximum of $f$” only."} {:db/id #edb/ref 17592186240970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9cc0718-c1bb-56fe-874b-3d2ed5f2544b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447696} {:answer/id #uuid "b8a64893-6a9e-56d1-b0d5-82ee55f35b0c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447697}] :answer-field/correct {:db/id #edb/ref 17592186447697} :answer-field/id #uuid "79f7f53c-0965-5c42-ac79-38c8c8f55dfc" :answer-field/key "$H(1,1)>0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448888} {:answer-field/choices [{:answer/id #uuid "9811b78d-bf42-5074-a5f1-5e3202d9d52d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447698} {:answer/id #uuid "628b95af-f66d-55ad-8d57-7ecc283f7128" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447699}] :answer-field/correct {:db/id #edb/ref 17592186447698} :answer-field/id #uuid "2d4f29fa-7863-537a-b965-983d1cdcaf33" :answer-field/key "$\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)<0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448889} {:answer-field/choices [{:answer/id #uuid "2f185b9e-94d3-5cc1-88c1-f600cdb21736" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447700} {:answer/id #uuid "54aa6c5e-2f33-5d68-8e97-c072039a6157" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447701}] :answer-field/correct {:db/id #edb/ref 17592186447700} :answer-field/id #uuid "3602e327-d83c-5c85-bf65-690df58a1047" :answer-field/key "The point $(1,1)$ is a local maximum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448890}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e273e9fd-fb16-5b0e-b15b-fcbb70918d78" :question/math-academy-id "q-104995" :question/problem "The function \n$f(x,y)$\nhas the first derivative\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}3{x}^{2}-3y & 3{y}^{2}-3x\\end{bmatrix},\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we notice that since ${f}^{′}(x,y)=\\begin{bmatrix}3{x}^{2}-3y & 3{y}^{2}-3x\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=3{x}^{2}-3y,\\,\\frac{∂f}{∂y}=3{y}^{2}-3x.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(3{x}^{2}-3y)=6x \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(3{y}^{2}-3x)=6y \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(3{y}^{2}-3x)=-3\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}6x & -3 \\\\ -3 & 6y\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=\\begin{bmatrix}6 & -3 \\\\ -3 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $H(1,1)>0$ is true. Indeed, computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))={6}^{2}-(-3)^{2}=27>0.\n$$\n\n- Statement $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)<0$ is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=6>0.$\n\n- Statement “The point $(1,1)$ is a local maximum of $f$” is false. Since $H(1,1)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0,$ the point $(1,1)$ is a local minimum by the second partial derivative test.\n\nTherefore, the correct answer is $H(1,1)>0$ only."} {:db/id #edb/ref 17592186240983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b29cd5-55b5-5722-ba90-23f769345723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186238150} {:answer/id #uuid "5bc19ba5-b098-5af2-b759-18b7d61fa0df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186238854} {:answer/id #uuid "64e8e822-ab38-5fcf-a7cb-162397992404" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238937} {:answer/id #uuid "9cd846ec-dcb9-5576-8a82-5cbd0e68c90d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239418} {:answer/id #uuid "a19047b8-6624-5f0c-b217-a2d6a5d4fcd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cos}⁡t+5\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186239462}] :answer-field/correct {:db/id #edb/ref 17592186238937} :answer-field/id #uuid "f5a8c5d5-fcb2-5bdd-8555-14fa5c61c1d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240761}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "645a82fe-e42f-5dc9-9e79-d8bd0747a894" :question/math-academy-id "q-105136" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{cos}⁡t,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}$ equals $5\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=5\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =5{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-4\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9db971-884b-5cf9-9a84-c91c9fa4fa01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238276} {:answer/id #uuid "39658250-b0fe-59bb-a334-a4e517b0d75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238550} {:answer/id #uuid "880b7d31-ec04-56db-ad2a-f754621f1b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239237} {:answer/id #uuid "b1b15087-e383-5255-8efc-84ad43c168b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239607} {:answer/id #uuid "cd180c30-2f84-5a24-af62-8965f36db06d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239851}] :answer-field/correct {:db/id #edb/ref 17592186239607} :answer-field/id #uuid "51c982ce-3e72-5b74-bcb0-6eb543685681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240480}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2bf55fb2-ca86-5707-a52a-d891899878f4" :question/math-academy-id "q-105186" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=2,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t+6\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}$ equals $6.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=6,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t+6)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+6{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have integrals over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-2\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =6-2\\operatorname{sin}⁡t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0442097d-1b68-55b7-9cb8-c462931d1330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238117} {:answer/id #uuid "0e522cac-c75a-5c1f-9bac-01ed6857debd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{ln⁡5}" :db/id #edb/ref 17592186238178} {:answer/id #uuid "44b6755c-aead-5542-8a1b-64818f1fbff2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238650} {:answer/id #uuid "461da220-919b-5435-93cc-a2ea3dad39d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}ln⁡7+\\frac{1}{x}" :db/id #edb/ref 17592186238664} {:answer/id #uuid "ffca6930-a453-5efc-ba11-64e5e1be934c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186240327}] :answer-field/correct {:db/id #edb/ref 17592186238117} :answer-field/id #uuid "7bea711e-203a-5f4c-8d6c-0248b489ff5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240554}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a3193e7-39e5-59fc-a3d8-c6e491fa4479" :question/math-academy-id "q-105256" :question/problem "Find ${f}^{′}(x)$ for $f(x)={7}^{x}+{log}_{5}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}+{log}_{5}⁡x) \\\\  & ={7}^{x}\\cdot ln⁡7+\\frac{1}{xln⁡5} \\\\  & ={7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00535c78-693d-578f-9854-35ede0f5ea84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186238081} {:answer/id #uuid "56c48d9d-1d29-5486-a7a5-24c09b6716ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }+5" :db/id #edb/ref 17592186238804} {:answer/id #uuid "9df9ae80-6d01-5879-b89f-4b4c816fb271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }-5" :db/id #edb/ref 17592186239436} {:answer/id #uuid "a2edb5df-f3ab-5a56-b218-c1793bbbc5b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{\\pi }" :db/id #edb/ref 17592186239473} {:answer/id #uuid "d1e52b5d-7e6c-50b9-8aa1-34d4c2e3f3a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186239899}] :answer-field/correct {:db/id #edb/ref 17592186239899} :answer-field/id #uuid "e98e4466-7268-5d92-b403-0d0b4b3f5a67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240738}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "454b86d7-c6a0-5ac5-a0b5-59bf704396c0" :question/math-academy-id "q-105298" :question/problem "Find ${f}^{′}\\left(\\frac{\\pi }{2}\\right)$ if $f(x)=ln⁡x-5csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x-5csc⁡x) \\\\  & =\\frac{1}{x}-5(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}+5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{2}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}\\left(\\frac{\\pi }{2}\\right) & =\\frac{1}{\\left(\\frac{\\pi }{2}\\right)}+5csc⁡\\left(\\frac{\\pi }{2}\\right)cot⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =\\frac{2}{\\pi }+5\\cdot 1\\cdot 0 \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b187e54-5678-58b5-9aff-2031ec98f761" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{x}csc⁡x(ln⁡2+cot⁡x)" :db/id #edb/ref 17592186238160} {:answer/id #uuid "2058ffb0-c56f-523c-bf66-f8cc7453f206" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "csc⁡x({2}^{x}ln⁡2-cot⁡x)" :db/id #edb/ref 17592186238334} {:answer/id #uuid "7a0c46bc-3e8d-51d9-90c9-36764bcb9a99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{x}csc⁡x(ln⁡2-cot⁡x)" :db/id #edb/ref 17592186239108} {:answer/id #uuid "d1795b5a-93ce-5e52-9bea-134248e1edce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "csc⁡x({2}^{x}ln⁡2+cot⁡x)" :db/id #edb/ref 17592186239891} {:answer/id #uuid "e22d82e1-3f0d-5981-bca2-0a4d5eba60db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{x}ln⁡2csc⁡xcot⁡x" :db/id #edb/ref 17592186240044}] :answer-field/correct {:db/id #edb/ref 17592186239108} :answer-field/id #uuid "831bbc3d-026c-54df-89fc-4dc90147c376" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240563}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d61641d-525b-5efe-8635-c3fda06c667c" :question/math-academy-id "q-105299" :question/problem "Find ${f}^{′}(x)$ if $f(x)={2}^{x}csc⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({2}^{x}csc⁡x) \\\\  & ={2}^{x}ln⁡2(csc⁡x)+{2}^{x}(-csc⁡xcot⁡x) \\\\  & ={2}^{x}csc⁡x(ln⁡2-cot⁡x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342af53-2f55-5c64-ada7-5e6f534a392d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}-{csc}^{2}⁡x" :db/id #edb/ref 17592186238108} {:answer/id #uuid "25e791c4-5e5d-54a5-a4d8-243c4ebd3551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5-csc⁡x" :db/id #edb/ref 17592186238383} {:answer/id #uuid "2a8cdc06-3917-5a72-8baf-b7984c9c4345" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5+csc⁡x" :db/id #edb/ref 17592186238429} {:answer/id #uuid "36a65434-a9ca-5879-a8bf-ac9ba0af8ece" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5+{csc}^{2}⁡x" :db/id #edb/ref 17592186238526} {:answer/id #uuid "f072d48a-4459-559f-aaa6-60307b5cf008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5-{csc}^{2}⁡x" :db/id #edb/ref 17592186240177}] :answer-field/correct {:db/id #edb/ref 17592186238526} :answer-field/id #uuid "d4627284-dc8a-5fab-aaa8-c7cf89fd3ae3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240707}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cfb4b430-487b-5445-947c-5c3c68e5ffd5" :question/math-academy-id "q-105309" :question/problem "Find ${f}^{′}(x)$ if $f(x)={5}^{x}-cot⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-cot⁡x) \\\\  & ={5}^{x}ln⁡5-(-{csc}^{2}⁡x) \\\\  & ={5}^{x}ln⁡5+{csc}^{2}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "286fa88f-8ea5-503e-8fb0-428138ec40ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}sec⁡x(1+tan⁡x)" :db/id #edb/ref 17592186238410} {:answer/id #uuid "332c8633-3843-5c31-a194-e34735ef2602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}sec⁡x(1-tan⁡x)" :db/id #edb/ref 17592186238499} {:answer/id #uuid "8bc2bfad-0679-520a-922e-89fcbb185bdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}sec⁡x(ln⁡5+tan⁡x)" :db/id #edb/ref 17592186239269} {:answer/id #uuid "9e62b7b8-8b3e-5c27-ac36-76b46c3019f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}sec⁡x(ln⁡5-tan⁡x)" :db/id #edb/ref 17592186239440} {:answer/id #uuid "c0d4930a-e248-568f-8ae5-64a2d0673eb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}sec⁡xtan⁡x" :db/id #edb/ref 17592186239738}] :answer-field/correct {:db/id #edb/ref 17592186239269} :answer-field/id #uuid "f62f2c07-95e1-52c0-8500-ebb6139248e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240762}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd297ed3-dba2-5110-9b3e-0d62167228f9" :question/math-academy-id "q-105314" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y={5}^{x}sec⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}sec⁡x) \\\\  & ={5}^{x}ln⁡5sec⁡x+{5}^{x}sec⁡xtan⁡x \\\\  & ={5}^{x}sec⁡x(ln⁡5+tan⁡x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01edfff5-f123-51ba-a62f-aed1989315e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3cos⁡x-sec⁡xtan⁡x" :db/id #edb/ref 17592186238096} {:answer/id #uuid "249f92ae-729a-555f-b6e1-5e5982b4eabc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3tan⁡x" :db/id #edb/ref 17592186238377} {:answer/id #uuid "8feef765-b5e2-58fa-b272-4256330846a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3cos⁡x+sec⁡xtan⁡x" :db/id #edb/ref 17592186239307} {:answer/id #uuid "bd795b11-23bc-5d2e-92ff-9130b95d5d2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3cos⁡x+sec⁡xtan⁡x" :db/id #edb/ref 17592186239707} {:answer/id #uuid "e6e37b21-cc92-59c4-9bda-e10d7f67783c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3cos⁡x-sec⁡xtan⁡x" :db/id #edb/ref 17592186240087}] :answer-field/correct {:db/id #edb/ref 17592186239307} :answer-field/id #uuid "51e2cff0-7cc5-5c58-867f-157458144217" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240481}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5d31a05-3052-5924-9370-b49e037bb225" :question/math-academy-id "q-105316" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=3sin⁡x+sec⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3sin⁡x+sec⁡x) \\\\  & =3cos⁡x+sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2083fb67-822f-5c61-a364-c7c9d194031b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x,y)$ has a saddle point at $(4,0)$ and a local maximum at $(3,1)$" :db/id #edb/ref 17592186238338} {:answer/id #uuid "2d567df9-25a8-5d23-8121-d47039a7f3a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x,y)$ has a saddle point at $(1,0)$ and a local maximum at $(5,-4)$" :db/id #edb/ref 17592186238456} {:answer/id #uuid "6248101c-5576-5662-a6e6-9e82ed11cdba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x,y)$ has a local minimum at $(1,0)$ and a local maximum at $(5,-4)$" :db/id #edb/ref 17592186238920} {:answer/id #uuid "9657dc67-31a7-5307-b0a3-970644a18023" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x,y)$ has a local minimum at $(1,0)$ and a saddle point at $(5,-4)$" :db/id #edb/ref 17592186239356} {:answer/id #uuid "a885e205-57e3-5ddd-bba6-1c3c5468b96a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x,y)$ has a saddle point at $(4,0)$ and a local minimum at $(3,1)$" :db/id #edb/ref 17592186239522}] :answer-field/correct {:db/id #edb/ref 17592186238456} :answer-field/id #uuid "2d816319-57a5-5bfb-bdbc-1674489ced59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240415}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9136d3e6-f2a0-5b9c-a6a2-efe0a42ad6ee" :question/math-academy-id "q-105335" :question/problem "Find and categorize all the local extrema of the function \n$f(x,y)$ \ngiven that\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}4-4y-4x & 4-4x+{y}^{2}\\end{bmatrix}.\n$$" :question/worked-solution "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}4-4y-4x & 4-4x+{y}^{2}\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=4-4y-4x,\\,\\frac{∂f}{∂y}=4-4x+{y}^{2}.\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting ${f}^{′}(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n\\left\\{\\begin{aligned}4-4y-4x &=0 \\\\ 4-4x+{y}^{2} &=0\\end{aligned}\\right.\n$$\n\nSolving the first equation for $x,$ we get\n\n$$\n4-4y-4x=0\\,⟹\\,x=1-y.\n$$\n\nThen, substituting this into the second equation, we get\n\n$$\n\\begin{aligned}4-4(1-y)+{y}^{2} & =0 \\\\ {y}^{2}+4y & =0 \\\\ y(y+4) & =0 \\\\ y & =-4,0.\\end{aligned}\n$$\n\nBack-substituting these values into $x=1-y,$ we obtain\n\n$$\ny=-4\\,⟹\\,x=1-(-4)=5,\\,\\,y=0\\,\\,\\,\\,\\,\\,⟹\\,x=1-0=1.\n$$\n\nHence, $(1,0)$ and $(5,-4)$ are stationary points of $f(x,y).$\n\nTo classify these stationary points, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(4-4y-4x)=-4\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(4-4x+{y}^{2})=-4 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(4-4y-4x)=-4\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(4-4x+{y}^{2})=2y\\end{aligned}\n$$\n\nSo, the second derivative is \n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}-4 & -4 \\\\ -4 & 2y\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we evaluate the second derivative at each of the stationary points and use it to categorize them:\n\n- Evaluating the second derivative at $(1,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,0)=\\begin{bmatrix}-4 & -4 \\\\ -4 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant $H(1,0),$ we get\n\n$$\nH(1,0)=det({f}^{″}(1,0))=(-4)\\cdot 0-(-4)^{2}=-16<0,\n$$\n\nTherefore, $f(1,0)$ is a saddle point.\n\n- Evaluating the second derivative at $(5,-4),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(5,-4)=\\begin{bmatrix}-4 & -4 \\\\ -4 & -8\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant $H(5,-4),$ we get\n\n$$\nH(5,-4)=det({f}^{″}(5,-4))=(-4)\\cdot (-8)-(-4)^{2}=16>0\n$$\n\nFinally, since $H(5,-4)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(5,-4)={h}_{11}=-4<0,$ the function $f$ has a local maximum at $(5,-4).$\n\nIn conclusion, $f(x,y)$ has a saddle point at $(1,0)$ and a local maximum at $(5,-4).$"} {:db/id #edb/ref 17592186241048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4685a758-8058-59e8-be2d-d72a4eb0fc8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186238670} {:answer/id #uuid "5dacfce1-68a9-5c38-82ae-51b76dde731a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186238872} {:answer/id #uuid "6d7b90df-84fa-5a7d-a3d2-67a93fd997aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186238997} {:answer/id #uuid "8e0c2135-f068-52d9-96d9-dbf623cda9e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186239288} {:answer/id #uuid "d7982561-569e-5b8a-b9c6-caa4a0425f51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186239936}] :answer-field/correct {:db/id #edb/ref 17592186239288} :answer-field/id #uuid "3b390aba-0d56-5d95-8cc5-d2f376b637b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240435}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75f19d0b-76eb-589a-abaa-1f1225a49ad8" :question/math-academy-id "q-105409" :question/problem "$$\n\\lim_{x\\to 0}\\,\\frac{4{sin}^{2}⁡x}{5{x}^{2}}=\n$$" :question/worked-solution "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to 0}\\,\\frac{4{sin}^{2}⁡x}{5{x}^{2}}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\,\\frac{4{sin}^{2}⁡x}{5{x}^{2}} & =\\lim_{x\\to 0}(\\frac{4}{5}\\cdot \\frac{{sin}^{2}⁡x}{{x}^{2}}) \\\\  & =\\frac{4}{5}\\cdot {lim}_{x\\to 0}\\,\\frac{{sin}^{2}⁡x}{{x}^{2}} \\\\  & =\\frac{4}{5}\\cdot {lim}_{x\\to 0}{\\left(\\frac{\\operatorname{sin}⁡x}{x}\\right)}^{2} \\\\  & =\\frac{4}{5}\\cdot {[\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}]}^{2} \\\\  & =\\frac{4}{5}\\cdot {1}^{2} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b374cb36-b270-54a2-9c73-47ae726af5e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186239620} {:answer/id #uuid "bb0b78c4-2f3a-5fce-823e-d81ae6de6f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186239684} {:answer/id #uuid "c32755a8-e99f-5d7a-8200-e7970316f610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186239775} {:answer/id #uuid "d3e94380-af17-5752-98a9-8c16b98c6de0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186239916} {:answer/id #uuid "ff1ca130-7021-5de0-b756-2f3d00100218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186240314}] :answer-field/correct {:db/id #edb/ref 17592186239916} :answer-field/id #uuid "5af16464-9867-5fd2-8e7f-875e19c7e569" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240498}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a91918b-4080-5b4a-a50f-84435b2d1d0c" :question/math-academy-id "q-105433" :question/problem "$$\n\\displaystyle \\lim_{\\theta \\to 0}\\,\\frac{4\\theta }{\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta }=\n$$" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{4\\theta }{\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta } & =\\lim_{\\theta \\to 0}(4\\theta \\cdot \\frac{1}{\\operatorname{sec}⁡\\theta }\\cdot \\frac{1}{\\operatorname{tan}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}(4\\theta \\cdot \\operatorname{cos}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot 4{cos}^{2}⁡\\theta ) \\\\  & =\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}(4{cos}^{2}⁡\\theta )\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1}{(\\lim_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta })} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n\\lim_{\\theta \\to 0}(4{cos}^{2}⁡\\theta )=4{cos}^{2}⁡0=4.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}(4{cos}^{2}⁡\\theta ) & =1\\cdot 4=4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207694ee-c15e-52f3-bb66-f33a851ce611" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,9]" :db/id #edb/ref 17592186238335} {:answer/id #uuid "3c20ba8b-2e10-5132-a056-29aa069b3176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,9)" :db/id #edb/ref 17592186238577} {:answer/id #uuid "b7bfd850-f4d9-52b8-81ae-78105af6e087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,\\infty )" :db/id #edb/ref 17592186239658} {:answer/id #uuid "bfec8dba-b953-5117-aa44-b1bff76a7008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,9)\\cup (9,\\infty )" :db/id #edb/ref 17592186239722} {:answer/id #uuid "cf064986-a99a-57bb-a79a-63eb94087f26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-9)" :db/id #edb/ref 17592186239869}] :answer-field/correct {:db/id #edb/ref 17592186238577} :answer-field/id #uuid "7d28cd6f-ee76-5092-8a2e-5adc89ae8bda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240556}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "204fc59a-09be-565a-89b0-1a7d59d1b5dd" :question/math-academy-id "q-105474" :question/problem "Find the largest interval of continuity for the function $f(x)={log}_{5}⁡(9-x).$" :question/worked-solution "The logarithmic function ${log}_{2}⁡(9-x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n9-x>0\\,⟹\\,x<9\n$$\n\nTherefore, the function $f(x)=\\operatorname{log}⁡(9-x)$ is continuous on the interval $(-\\infty ,9).$"} {:db/id #edb/ref 17592186241085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1227f4b0-06a3-5fc7-8c93-b5af1a177857" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cot}⁡x-4+C" :db/id #edb/ref 17592186238208} {:answer/id #uuid "492da1b4-8b46-56ca-9bee-c5c3eb9e9d0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{cot}⁡x-4x+C" :db/id #edb/ref 17592186238692} {:answer/id #uuid "4fedb8f0-ecbc-50a6-ba25-50ab73295e55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{cot}⁡x-4+C" :db/id #edb/ref 17592186238744} {:answer/id #uuid "7cae5577-59bb-5fe5-a586-fd0ac21c8c8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cot}⁡x+4x+C" :db/id #edb/ref 17592186239133} {:answer/id #uuid "d4582b84-f7bf-534d-97d8-019338b1b94b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cot}⁡x-4x+C" :db/id #edb/ref 17592186239921}] :answer-field/correct {:db/id #edb/ref 17592186238692} :answer-field/id #uuid "5d4535e1-af84-50af-ad45-7f6151d28b56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240501}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6393e517-2496-53a1-b67b-2aac5387e96c" :question/math-academy-id "q-10560" :question/problem "Calculate $$\n\\displaystyle \\int 4{cot}^{2}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n\\begin{aligned}{cot}^{2}⁡x & ={csc}^{2}⁡x-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int 4{cot}^{2}⁡x\\,\\text{d}x & =\\int 4({csc}^{2}⁡x-1)\\,\\text{d}x \\\\  & =\\int (4{csc}^{2}⁡x-4)\\,\\text{d}x \\\\  & =-4\\operatorname{cot}⁡x-4x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207d77ed-be13-5153-afe2-ae80e5b7f112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{2}}{4}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186238337} {:answer/id #uuid "28105387-c390-577f-9ff0-c4baeace7982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{2}}{2}+2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186238404} {:answer/id #uuid "b3bb9480-a81f-5b1c-a3e4-9b258924585f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{4}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186239622} {:answer/id #uuid "e275e549-1a9e-5716-9267-52c2998cfc50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{2}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186240046} {:answer/id #uuid "eccf72c3-ca4d-588a-9a06-99d2e7feb952" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{2}}{4}+2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186240136}] :answer-field/correct {:db/id #edb/ref 17592186238337} :answer-field/id #uuid "0856888b-fde6-55ae-8b77-4199daefdce1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240341}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "812f95db-2c0e-5010-aa63-2f9280fe2856" :question/math-academy-id "q-10564" :question/problem "Calculate $$\n\\displaystyle \\int (2-\\frac{x}{2}+2{cot}^{2}⁡x)\\,\\text{d}x.\n$$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n\\begin{aligned}{cot}^{2}⁡x & ={csc}^{2}⁡x-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int (2-\\frac{x}{2}+2{cot}^{2}⁡x)\\,\\text{d}x & =\\int (2-\\frac{x}{2}+2({csc}^{2}⁡x-1))\\,\\text{d}x \\\\  & =\\int (2-\\frac{x}{2}+2{csc}^{2}⁡x-2)\\,\\text{d}x \\\\  & =\\int (-\\frac{x}{2}+2{csc}^{2}⁡x)\\,\\text{d}x \\\\  & =-\\frac{1}{2}\\cdot \\frac{{x}^{2}}{2}-2\\operatorname{cot}⁡x+C \\\\  & =-\\frac{{x}^{2}}{4}-2\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5125fb-3e96-5ce0-8832-2ccb4ece2284" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}+4\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186238309} {:answer/id #uuid "33595af0-0575-5a98-a0ad-7d6a2bdb2b81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+2\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186238501} {:answer/id #uuid "34a8f80e-f267-55e5-8c10-3e12fd51aa8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{3}}{2}+4\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186238511} {:answer/id #uuid "720d5ba0-8cd2-5a5c-b439-1ef3224c8065" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{3}}{2}-4\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186239033} {:answer/id #uuid "e075f592-cecb-518d-bb8f-0b633133ae19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186240020}] :answer-field/correct {:db/id #edb/ref 17592186238309} :answer-field/id #uuid "7e611862-2fc2-5d26-86b8-3b8f10f8471f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240557}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ab2101d-06dc-593b-bfec-f1e45d399129" :question/math-academy-id "q-10565" :question/problem "$$\n\\displaystyle \\int (4-3{x}^{2}+4{tan}^{2}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x\\,⟹\\,{tan}^{2}⁡x={sec}^{2}⁡x-1.\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int (4-3{x}^{2}+4{tan}^{2}⁡x)\\,\\text{d}x & =\\int (4-3{x}^{2}+4({sec}^{2}⁡x-1))\\,\\text{d}x \\\\  & =\\int (4-3{x}^{2}+4{sec}^{2}⁡x-4)\\,\\text{d}x \\\\  & =\\int (-3{x}^{2}+4{sec}^{2}⁡x)\\,\\text{d}x \\\\  & =-3\\cdot \\frac{{x}^{3}}{3}+4\\operatorname{tan}⁡x+C \\\\  & =-{x}^{3}+4\\operatorname{tan}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1639f667-cc0c-541f-beb3-df7075bcd242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6z\\hspace{0.167em}\\mathbf{k}" :db/id #edb/ref 17592186238243} {:answer/id #uuid "746766cf-a9af-578f-8dc5-0e36b21b4e06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\hspace{0.167em}\\mathbf{i}" :db/id #edb/ref 17592186239054} {:answer/id #uuid "7681ef8d-3f67-572c-af5f-8f55918debf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbf{0}" :db/id #edb/ref 17592186239078} {:answer/id #uuid "7de0f017-aa4f-55fa-b7f6-e4e3b289359f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6z\\hspace{0.167em}\\mathbf{j}" :db/id #edb/ref 17592186239147} {:answer/id #uuid "e7823a5e-3336-5cc7-868c-2023128957eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6z\\hspace{0.167em}\\mathbf{j}+2\\hspace{0.167em}\\mathbf{\\text{k}}" :db/id #edb/ref 17592186240093}] :answer-field/correct {:db/id #edb/ref 17592186239147} :answer-field/id #uuid "da2209b7-9fdc-539d-9358-25e617c5c773" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240714}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b3b1abb-e804-5079-8fb6-32a843b8454e" :question/math-academy-id "q-105668" :question/problem "Given that $\\mathbf{F}(x,y,z)=3{z}^{2}\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j}+\\mathbf{k},$ what is $\\text{curl}\\hspace{0.167em}\\mathbf{F}?$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}+R\\hspace{0.167em}\\mathbf{k}$ is a vector field on ${\\mathbb{R}}^{3}$ and the partial derivatives of the components of $\\mathbf{F}$ all exist, then the curl of $\\mathbf{F}$ is the vector field given by\n\n$$\ncurl\\hspace{0.167em}\\mathbf{F}=\\mathrm{∇}\\times \\mathbf{F}=\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{vmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 3{z}^{2} & 2y & 1\\end{vmatrix} \\\\  & =[\\frac{∂}{∂y}(1)-\\frac{∂}{∂z}(2y)]\\mathbf{i}-[\\frac{∂}{∂x}(1)-\\frac{∂}{∂z}(3{z}^{2})]\\mathbf{j}+[\\frac{∂}{∂x}(2y)-\\frac{∂}{∂y}(3{z}^{2})]\\mathbf{k} \\\\  & =(0-0)\\mathbf{i}-(0-6z)\\mathbf{j}+(0-0)\\mathbf{k} \\\\  & =6z\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d650c1-149f-5757-9587-2d05e7bdf855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186238205} {:answer/id #uuid "5335d16f-a84e-5b3e-b354-de02ea150c39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}+\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186238772} {:answer/id #uuid "64681e8d-39d1-5faf-ac7f-a604c349e91c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}-\\frac{3}{5}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186238936} {:answer/id #uuid "940d2c4d-f823-5543-85bc-88a7957dace4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}-\\frac{7}{5}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186239336} {:answer/id #uuid "cb9d2f46-656b-5f67-8740-d57524fe0094" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186239840}] :answer-field/correct {:db/id #edb/ref 17592186239840} :answer-field/id #uuid "cb055678-80b5-562a-bc4a-fd37fcc7ea2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240686}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f79178f2-ea4e-568f-a26a-8eda65a5b236" :question/math-academy-id "q-10567" :question/problem "$$\n\\displaystyle \\int (7+4{x}^{3}+7{cot}^{2}⁡(3x-2\\pi ))\\,\\text{d}x=\n$$" :question/worked-solution "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ with $\\theta =3x-2\\pi ,$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(3x-2\\pi ) & ={csc}^{2}⁡(3x-2\\pi ).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int (7+4{x}^{3}+7{cot}^{2}⁡(3x-2\\pi ))\\,\\text{d}x & =\\int (4{x}^{3}+7+7{cot}^{2}⁡(3x-2\\pi ))\\,\\text{d}x \\\\  & =\\int (4{x}^{3}+7[1+{cot}^{2}⁡(3x-2\\pi )])\\,\\text{d}x \\\\  & =\\int (4{x}^{3}+7{csc}^{2}⁡(3x-2\\pi ))\\,\\text{d}x \\\\  & =4\\cdot \\frac{{x}^{4}}{4}+7(-\\frac{1}{3}\\operatorname{cot}⁡(3x-2\\pi ))+C \\\\  & ={x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133c1b20-5150-50da-8523-674470a0cfe9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}" :db/id #edb/ref 17592186238215} {:answer/id #uuid "5c8be352-8015-5be2-b8df-9a4f3ad0aa93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\hspace{0.167em}\\mathbf{k}" :db/id #edb/ref 17592186238865} {:answer/id #uuid "82de7a70-0733-5cde-9eac-f208a1690d08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\hspace{0.167em}\\mathbf{k}" :db/id #edb/ref 17592186239194} {:answer/id #uuid "82fbfc1b-0c81-5da1-927a-375691efc6ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}-\\mathbf{k}" :db/id #edb/ref 17592186239197} {:answer/id #uuid "853fbdfa-bdb1-5373-adfe-5cf0720fa54b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbf{i}-2\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}" :db/id #edb/ref 17592186239216}] :answer-field/correct {:db/id #edb/ref 17592186239197} :answer-field/id #uuid "c42bc9e6-d9aa-54be-b2ee-e7d0d024b8b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240672}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8f1a0a3-0b71-52cd-b327-6c0ec92e34be" :question/math-academy-id "q-105672" :question/problem "Consider the vector field $\\mathbf{F}={e}^{y+z}\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}+xyz\\hspace{0.167em}\\mathbf{k}.$ Evaluate $\\mathrm{∇}\\times \\mathbf{F}$ at the point  $(2,1,-1).$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}+R\\hspace{0.167em}\\mathbf{k}$ is a vector field on ${\\mathbb{R}}^{3}$ and the partial derivatives of the components of $\\mathbf{F}$ all exist, then the curl of $\\mathbf{F}$ is the vector field given by\n\n$$\ncurl\\hspace{0.167em}\\mathbf{F}=\\mathrm{∇}\\times \\mathbf{F}=\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{vmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ {e}^{y+z} & 1 & xyz\\end{vmatrix} \\\\  & =[\\frac{∂}{∂y}(xyz)-\\frac{∂}{∂z}(1)]\\mathbf{i}-[\\frac{∂}{∂x}(xyz)-\\frac{∂}{∂z}({e}^{y+z})]\\mathbf{j}+[\\frac{∂}{∂x}(1)-\\frac{∂}{∂y}({e}^{y+z})]\\mathbf{k} \\\\  & =(xz-0)\\mathbf{i}-(yz-{e}^{y+z})\\mathbf{j}+(0-{e}^{y+z})\\mathbf{k} \\\\  & =xz\\hspace{0.167em}\\mathbf{i}+({e}^{y+z}-yz)\\mathbf{j}-{e}^{y+z}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{curl}\\hspace{0.167em}\\mathbf{F}$ at the point $(2,1,-1),$ and obtain\n\n$$\n\\begin{aligned}(\\text{curl}\\hspace{0.167em}\\mathbf{F})(2,1,-1) & =2(-1)\\hspace{0.167em}\\mathbf{i}+({e}^{1+(-1)}-1(-1))\\mathbf{j}-{e}^{1+(-1)}\\hspace{0.167em}\\mathbf{k} \\\\  & =-2\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}-\\mathbf{k}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56985235-fa3e-5355-b5e3-46e01ac2a247" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}\\operatorname{tan}⁡(5x+\\pi )-{x}^{5}+C" :db/id #edb/ref 17592186238802} {:answer/id #uuid "6987c4ae-ab66-56c9-8d35-74bdb216be38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}\\operatorname{tan}⁡(5x+\\pi )+\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186238971} {:answer/id #uuid "d13bd42c-6107-59af-8803-31227c827109" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}\\operatorname{tan}⁡(5x+\\pi )-\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186239889} {:answer/id #uuid "e070939b-4357-5295-9190-1c5ff7d82693" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}\\operatorname{tan}⁡(5x+\\pi )-{x}^{5}+C" :db/id #edb/ref 17592186240018} {:answer/id #uuid "e69b1fa3-ba07-57cc-8ea6-7cdd8b8fecc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}\\operatorname{tan}⁡(5x+\\pi )-{x}^{5}+C" :db/id #edb/ref 17592186240081}] :answer-field/correct {:db/id #edb/ref 17592186240081} :answer-field/id #uuid "60df668c-def0-5d48-85b2-7b3977057599" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240509}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d63e7c45-202f-53e4-8cfc-4ac24fd29e59" :question/math-academy-id "q-10568" :question/problem "Calculate $$\n\\displaystyle \\int (9{tan}^{2}⁡(5x+\\pi )-5{x}^{4}+9)\\,\\text{d}x.\n$$" :question/worked-solution "From the identity  $1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta $ with $\\theta =(5x+\\pi ),$ we get \n\n$$\n1+{tan}^{2}⁡(5x+\\pi )={sec}^{2}⁡(5x+\\pi ).\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int (9{tan}^{2}⁡(5x+\\pi )-5{x}^{4}+9)\\,\\text{d}x & =\\int (9[1+{tan}^{2}⁡(5x+\\pi )]-5{x}^{4})\\,\\text{d}x \\\\  & =\\int (9{sec}^{2}⁡(5x+\\pi )-5{x}^{4})\\,\\text{d}x \\\\  & =9\\cdot (\\frac{1}{5}\\operatorname{tan}⁡(5x+\\pi ))-5\\cdot \\frac{{x}^{5}}{5}+C \\\\  & =\\frac{9}{5}\\operatorname{tan}⁡(5x+\\pi )-{x}^{5}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2739d8-8263-5715-80a0-b3b7c6968f79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186238306} {:answer/id #uuid "382f295d-a445-5d8b-bc0f-6ace3caf95de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186238540} {:answer/id #uuid "73aae932-0595-5347-8815-ae9f181c5b17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186239045} {:answer/id #uuid "7f2d8986-d88d-5b5c-9f11-422be6546780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{5}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186239162} {:answer/id #uuid "c61dff78-fa4e-581e-a2bf-f0e93446cb93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186239798}] :answer-field/correct {:db/id #edb/ref 17592186239045} :answer-field/id #uuid "898c248a-58ee-5aa9-8564-479985c71b0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f8cd9927-85e7-5cc4-8971-2d06dd8aa5a8" :question/math-academy-id "q-106405" :question/problem "Find the Cartesian equation of the ellipse\n\n$$\nx=5\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =4\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{4} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{4}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{16} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{16} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{16}=1.\n$$"} {:db/id #edb/ref 17592186241171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "430731d8-2746-561b-9932-67b216b9fe6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+9{y}^{2}=1" :db/id #edb/ref 17592186238637} {:answer/id #uuid "6d5367ef-504b-5ba3-a55b-c4c01e11de99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}-9{y}^{2}=1" :db/id #edb/ref 17592186238996} {:answer/id #uuid "e04c2016-5bb4-58d5-b9d6-a2cd96a09d37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{x}^{2}+4{y}^{2}=1" :db/id #edb/ref 17592186240017} {:answer/id #uuid "e0b0efb3-ded6-535b-9129-9f1e0979660f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{x}^{2}+\\frac{1}{9}{y}^{2}=1" :db/id #edb/ref 17592186240025} {:answer/id #uuid "e0f34c9d-d585-551d-ad3a-8864f684d38c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{x}^{2}-\\frac{1}{9}{y}^{2}=1" :db/id #edb/ref 17592186240028}] :answer-field/correct {:db/id #edb/ref 17592186238637} :answer-field/id #uuid "e50ff31d-bfd9-5fd4-b0bd-dcf00ea22347" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240730}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6677d4ff-0012-5e92-83bc-c53813937d2b" :question/math-academy-id "q-106406" :question/problem "Find the Cartesian equation of the ellipse\n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{3}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}\\operatorname{cos}⁡\\theta  \\\\ 2x & =\\operatorname{cos}⁡\\theta  \\\\ 4{x}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{3}\\operatorname{sin}⁡\\theta  \\\\ 3y & =\\operatorname{sin}⁡\\theta  \\\\ 9{y}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}4{x}^{2}+9{y}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n4{x}^{2}+9{y}^{2}=1.\n$$"} {:db/id #edb/ref 17592186241172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c85e08-cf6a-5307-80f4-ce01ca0ebcac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}{x}^{2}+\\frac{9}{4}{y}^{2}=1" :db/id #edb/ref 17592186238422} {:answer/id #uuid "45c84b8d-f295-5003-a523-bb16c6bcf8f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}{x}^{2}-\\frac{4}{9}{y}^{2}=1" :db/id #edb/ref 17592186238658} {:answer/id #uuid "689800b2-34c6-5ad7-a7b0-9045f353fb27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}{x}^{2}+\\frac{9}{4}{y}^{2}=1" :db/id #edb/ref 17592186238964} {:answer/id #uuid "ae4de9d6-48b4-5098-a575-119212df9e4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}{x}^{2}-\\frac{9}{4}{y}^{2}=1" :db/id #edb/ref 17592186239570} {:answer/id #uuid "c35b39d0-2b50-56f0-b092-5a399f164c51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}{x}^{2}+\\frac{4}{9}{y}^{2}=1" :db/id #edb/ref 17592186239778}] :answer-field/correct {:db/id #edb/ref 17592186239778} :answer-field/id #uuid "45dde714-85df-57b8-888c-f62cc7cc39a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240450}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9b47425b-d1be-54fd-a4d5-ddff6578df69" :question/math-academy-id "q-106407" :question/problem "Find the Cartesian equation of the ellipse\n\n$$\nx=\\frac{2}{3}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{3}{2}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\frac{2}{3}\\operatorname{cos}⁡\\theta  \\\\ \\frac{3}{2}x & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{9}{4}{x}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\frac{3}{2}\\operatorname{sin}⁡\\theta  \\\\ \\frac{2}{3}y & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{4}{9}{y}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{9}{4}{x}^{2}+\\frac{4}{9}{y}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{9}{4}{x}^{2}+\\frac{4}{9}{y}^{2}=1.\n$$"} {:db/id #edb/ref 17592186241173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0363f299-ebce-5cd3-a3d9-6edbee6ef1d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{(x-2)}^{2}+\\frac{1}{4}{(y-3)}^{2}=1" :db/id #edb/ref 17592186238110} {:answer/id #uuid "09798478-efa7-5adb-b8d0-a50d61788683" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{(x-2)}^{2}-4{(y-3)}^{2}=1" :db/id #edb/ref 17592186238149} {:answer/id #uuid "117cba79-f965-5374-92ac-bc6e684c94b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{(x-3)}^{2}+4{(y-2)}^{2}=1" :db/id #edb/ref 17592186238201} {:answer/id #uuid "ae1fc9c6-aa5a-5af7-8fe4-228cbf131588" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{(x-2)}^{2}-\\frac{1}{4}{(y-3)}^{2}=1" :db/id #edb/ref 17592186239567} {:answer/id #uuid "d42beaa6-50c5-5dd1-9084-6b775db8f4aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{(x-2)}^{2}+4{(y-3)}^{2}=1" :db/id #edb/ref 17592186239919}] :answer-field/correct {:db/id #edb/ref 17592186239919} :answer-field/id #uuid "57eda148-ff6d-5235-8674-30b291d678a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240493}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f6811d7d-6469-50eb-bfd3-5c7960859395" :question/math-academy-id "q-106408" :question/problem "Calculate the Cartesian equation of the ellipse\n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta +2,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta +3,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}\\operatorname{cos}⁡\\theta +2 \\\\ x-2 & =\\frac{1}{2}\\operatorname{cos}⁡\\theta  \\\\ 2(x-2) & =\\operatorname{cos}⁡\\theta  \\\\ 4{(x-2)}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}\\operatorname{sin}⁡\\theta +3 \\\\ y-3 & =\\frac{1}{2}\\operatorname{sin}⁡\\theta  \\\\ 2(y-3) & =\\operatorname{sin}⁡\\theta  \\\\ 4{(y-3)}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}4{(x-2)}^{2}+4{(y-3)}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n4{(x-2)}^{2}+4{(y-3)}^{2}=1.\n$$"} {:answer/id #uuid "04abdb1e-7b1d-54d8-9d20-4774bb8df4ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-{cos}^{2}⁡z" :db/id #edb/ref 17592186241217} {:answer/id #uuid "152cb325-9ed7-57e6-9c36-b431d68cdffb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241362} {:answer/id #uuid "2e76f4b9-59bb-51c9-a297-586eb211cb2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241592} {:answer/id #uuid "31b49354-993e-598b-9371-99716a3a784e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{cos}^{2}⁡(2z)" :db/id #edb/ref 17592186241618} {:answer/id #uuid "33d1a60d-2b25-5917-b2e1-7176812399fd" :answer/type {:db/id #edb/ref 17592186045498}