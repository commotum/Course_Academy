d #edb/ref 17592186241198} {:answer/id #uuid "3278dc91-9e2c-5dd5-8fba-9bf0bf0f5f4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{12}-\\frac{{x}^{2}}{25}=1" :db/id #edb/ref 17592186241623} {:answer/id #uuid "916a516b-03ae-50a0-9fb8-87576bcd6d61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{12}=1" :db/id #edb/ref 17592186242457} {:answer/id #uuid "9e0fe848-afba-5785-83d5-2076cdbac58b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{2\\sqrt{3}}=1" :db/id #edb/ref 17592186242564} {:answer/id #uuid "be65878e-829a-5867-950c-0b410e0c8d60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186242851}] :answer-field/correct {:db/id #edb/ref 17592186242851} :answer-field/id #uuid "47991efd-ac27-5365-a659-140b2781503f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243574}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14ba5bcb-d69f-50c5-9b72-1cf9a802a574" :question/math-academy-id "q-106528" :question/problem "Find the Cartesian equation of the hyperbola $x=5\\operatorname{sec}⁡t,\\,y=2\\sqrt{3}\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\operatorname{sec}⁡t \\\\ \\frac{x}{5} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(5)^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{25} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =2\\sqrt{3}\\operatorname{tan}⁡t \\\\ \\frac{y}{2\\sqrt{3}} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{(2\\sqrt{3})^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{12} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{12}+1 & =\\frac{{x}^{2}}{25} \\\\ \\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{12} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1465f21d-292b-53ac-9847-54166e18ee6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186241356} {:answer/id #uuid "48e91da2-bb25-5a41-8179-06eb5bcd03fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{5}-\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186241841} {:answer/id #uuid "67bef949-4f5c-5781-b490-e661e68cf4cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{5}=1" :db/id #edb/ref 17592186242112} {:answer/id #uuid "8a66c382-2777-5439-8d3b-d3e1d94b3aa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{9}=1" :db/id #edb/ref 17592186242398} {:answer/id #uuid "f8b635c2-ab24-5573-af2e-fc1e9fd290f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{5}=1" :db/id #edb/ref 17592186243373}] :answer-field/correct {:db/id #edb/ref 17592186242112} :answer-field/id #uuid "8a6467e5-606e-5554-adf5-856c4b60961a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243698}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1eee5c4e-0644-59a1-b819-0a637e0aafee" :question/math-academy-id "q-106623" :question/problem "Find the Cartesian equation of the hyperbola $x=\\sqrt{5}\\operatorname{tan}⁡t,\\,y=3\\operatorname{sec}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent Identity.\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{5}\\operatorname{tan}⁡t \\\\ \\frac{x}{\\sqrt{5}} & =\\operatorname{tan}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{5})^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{x}^{2}}{5} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =3\\operatorname{sec}⁡t \\\\ \\frac{y}{3} & =\\operatorname{sec}⁡t \\\\ \\frac{{y}^{2}}{{3}^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{9} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{5}+1 & =\\frac{{y}^{2}}{9} \\\\ \\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{5} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c83430f-a9ed-5dba-8391-e56d8b389a41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{2}=1" :db/id #edb/ref 17592186241420} {:answer/id #uuid "4881018d-4b01-5700-b455-38f30ace0be9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186241838} {:answer/id #uuid "7c0b7f27-6cb5-556a-acab-e265117255a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186242268} {:answer/id #uuid "a0ac3ca2-93fd-5a2c-bb2b-33863d5d2bb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186242584} {:answer/id #uuid "f95acd59-e6c5-5b01-9c26-31794a6d5b6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186243374}] :answer-field/correct {:db/id #edb/ref 17592186241838} :answer-field/id #uuid "494a9b84-1f3a-5887-b2c4-4f11ecf6538d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243578}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "118e20fb-8b1f-5237-8abf-63e94df22dfc" :question/math-academy-id "q-106626" :question/problem "Find the Cartesian equation of the hyperbola $x=2\\operatorname{tan}⁡t,\\,y=\\sqrt{3}\\operatorname{sec}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent Identity.\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =2\\operatorname{tan}⁡t \\\\ \\frac{x}{2} & =\\operatorname{tan}⁡t \\\\ \\frac{{x}^{2}}{{2}^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{x}^{2}}{4} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\sqrt{3}\\operatorname{sec}⁡t \\\\ \\frac{y}{\\sqrt{3}} & =\\operatorname{sec}⁡t \\\\ \\frac{{y}^{2}}{(\\sqrt{3})^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{3} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{4}+1 & =\\frac{{y}^{2}}{3} \\\\ \\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{4} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0722213d-c8ee-54ee-94c7-cd494db1880f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{64}-\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186241240} {:answer/id #uuid "4ab7f10a-2f67-5dfa-abf6-96b57f964b5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{64}=1" :db/id #edb/ref 17592186241852} {:answer/id #uuid "cce3e9d9-4be0-59fb-b05f-18645d886ec0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{8}=1" :db/id #edb/ref 17592186242982} {:answer/id #uuid "d01641a8-ee87-5785-b33f-37c7a3f9d46c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{64}-\\frac{{x}^{2}}{25}=1" :db/id #edb/ref 17592186243014} {:answer/id #uuid "dcda1623-3df3-5258-9591-22f02590ca4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{64}=1" :db/id #edb/ref 17592186243144}] :answer-field/correct {:db/id #edb/ref 17592186241852} :answer-field/id #uuid "44989dd7-a5d4-544d-a979-282e2cce4b0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243568}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8e7a3969-02f2-5af9-9af8-d0d3eea06f1d" :question/math-academy-id "q-106671" :question/problem "Find the Cartesian equation of the hyperbola $x=8\\operatorname{tan}⁡t,\\,y=5\\operatorname{sec}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent Identity.\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =8\\operatorname{tan}⁡t \\\\ \\frac{x}{8} & =\\operatorname{tan}⁡t \\\\ \\frac{{x}^{2}}{{8}^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{x}^{2}}{64} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\n- Squaring the $\\operatorname{sec}⁡t$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =5\\operatorname{sec}⁡t \\\\ \\frac{y}{5} & =\\operatorname{sec}⁡t \\\\ \\frac{{y}^{2}}{{5}^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{25} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{64}+1 & =\\frac{{y}^{2}}{25} \\\\ \\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{64} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "365c4773-e368-5e9e-b8d3-09d97f8cf201" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186241658} {:answer/id #uuid "6115395b-4dd0-5476-84c1-62a064355b01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186242054} {:answer/id #uuid "718e50be-5a17-5e14-88c8-db7be4da154a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186242189} {:answer/id #uuid "a8ffe555-2803-571a-a13e-b08b1c573270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186242663} {:answer/id #uuid "db656494-d26d-54fd-a2be-e62b928fc054" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186243129}] :answer-field/correct {:db/id #edb/ref 17592186242054} :answer-field/id #uuid "2a7931ea-4640-57b6-8a13-7f713b36ad36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00eda352-d2e8-5490-8b6e-f1ece02f57de" :question/math-academy-id "q-106715" :question/problem "Determine the Cartesian equation of the ellipse\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =3\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{3} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{3}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{9} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =5\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{5} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{5}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{25} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{25} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{25}=1.\n$$"} {:db/id #edb/ref 17592186243988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5f64a4-69b8-506a-96e2-55cc614503b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-5\\lambda +6=0" :db/id #edb/ref 17592186241748} {:answer/id #uuid "6351b874-0657-5b03-8f6d-b3af44ed45eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-\\lambda -5=0" :db/id #edb/ref 17592186242074} {:answer/id #uuid "7f96fe85-4deb-5454-be68-8f1d1eb3789a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-6\\lambda +5=0" :db/id #edb/ref 17592186242301} {:answer/id #uuid "850c4548-d88e-5179-b3ab-422e6c25aebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}+5\\lambda +6=0" :db/id #edb/ref 17592186242341} {:answer/id #uuid "de6f6b53-4aeb-53fe-a160-f60001d8e561" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}+6\\lambda -5=0" :db/id #edb/ref 17592186243157}] :answer-field/correct {:db/id #edb/ref 17592186242301} :answer-field/id #uuid "18e5bea9-6d8b-54b1-b7e9-453e353537ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243481}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f2440fe-5d7f-50f0-96da-6c8dae104de5" :question/math-academy-id "q-106958" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle B=\\begin{bmatrix}5 & -1 \\\\ 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=\\begin{bmatrix}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(1-\\lambda )-0\\cdot (-1) & =0 \\\\ 5-5\\lambda -\\lambda +{\\lambda }^{2}+0 & =0 \\\\ {\\lambda }^{2}-6\\lambda +5 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f4a9979-9331-527c-9a58-b605efa72ab2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =5$ (double root)" :db/id #edb/ref 17592186241599} {:answer/id #uuid "3ae0ed4a-8e97-5df1-8df6-685ed7091fc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186241704} {:answer/id #uuid "8ef93f17-6adf-5084-aa32-8d61dce089ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =5$ and $\\lambda =3$" :db/id #edb/ref 17592186242438} {:answer/id #uuid "b40e6d5c-7f3d-5066-a193-992efb7df8c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =3$ (double root)" :db/id #edb/ref 17592186242753} {:answer/id #uuid "d19c701e-a7b6-5b89-8cb1-8ac37633c34f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =-3$ and $\\lambda =5$" :db/id #edb/ref 17592186243026}] :answer-field/correct {:db/id #edb/ref 17592186242438} :answer-field/id #uuid "b2596615-37e3-522f-b818-be72bc984a81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243758}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "951a8d7c-f3c2-5c26-a5f9-4fbae8462dba" :question/math-academy-id "q-106995" :question/problem "Find all real eigenvalues of the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}5 & 0 \\\\ 2 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}5-\\lambda  & 0 \\\\ 2 & 3-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 0 \\\\ 2 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(3-\\lambda )-0\\cdot 2 & =0 \\\\ (\\lambda -5)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =5$ and $\\lambda =3.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."} {:db/id #edb/ref 17592186244059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152cb325-9ed7-57e6-9c36-b431d68cdffb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241362} {:answer/id #uuid "2e76f4b9-59bb-51c9-a297-586eb211cb2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241592} {:answer/id #uuid "33d1a60d-2b25-5917-b2e1-7176812399fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241637} {:answer/id #uuid "7ab59f64-3cac-5e93-b9c8-4dd4ce8cba35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186242259} {:answer/id #uuid "ec2442e6-3bcb-5d29-a607-74db0268944f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186243268}] :answer-field/correct {:db/id #edb/ref 17592186241637} :answer-field/id #uuid "fdd15e38-3eee-5ed4-a0c4-348e7c224b10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243881}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f637ee3d-e925-50b9-8fb1-4aa44482e5e0" :question/math-academy-id "q-107459" :question/problem "Given that $y=3\\cdot {4}^{{x}^{2}-1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\cdot {4}^{u},\\,u={x}^{2}-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\cdot {4}^{u}ln⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\cdot {4}^{u}ln⁡4\\cdot 2x \\\\  & =6x\\cdot {4}^{{x}^{2}-1}ln⁡4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530546dd-8877-5ee4-a9a9-4e6037256c79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186241920} {:answer/id #uuid "600e2c77-5502-5a78-b78c-316c9d3b0309" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242042} {:answer/id #uuid "a399353b-dcb8-5ce5-8226-adfa95834745" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242614} {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} {:answer/id #uuid "f5f46ff0-e8a9-5bfe-82dc-8df71e3e5cb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186243356}] :answer-field/correct {:db/id #edb/ref 17592186242615} :answer-field/id #uuid "cfbbf656-26a0-5730-8af0-76fb3508854c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243802}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0d30f56-0d1c-5b77-92c9-4ebf415c4add" :question/math-academy-id "q-107461" :question/problem "If $f(x)={6}^{1-4x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={6}^{u},\\,u=1-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={6}^{u}ln⁡6,\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}ln⁡6\\cdot (-4) \\\\  & =-4\\cdot {6}^{u}ln⁡6 \\\\  & =-4\\cdot {6}^{1-4x}ln⁡6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a360978-aee5-5269-8d52-acc2bd0275e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186241405} {:answer/id #uuid "25673268-8127-5ee3-b825-513101850416" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186241501} {:answer/id #uuid "6897500e-83b8-5825-826f-1025d76e05ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186242120} {:answer/id #uuid "6b8fc62b-50d0-5120-83ac-a5a6fadf71ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186242147} {:answer/id #uuid "ea60d2ce-203d-54fa-98fe-e801388a4604" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186243256}] :answer-field/correct {:db/id #edb/ref 17592186243256} :answer-field/id #uuid "d71ff737-aa65-5af2-a6cf-4a60a954b47e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243814}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d183c0be-f11b-5263-ad65-5f80a8b88944" :question/math-academy-id "q-107553" :question/problem "Given that the expression $\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ)\n$$\n\nwe get the following identity:\n\n$$\n\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=1 \\\\ R\\operatorname{sin}⁡ϕ &=\\sqrt{3}\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={1}^{2}+(\\sqrt{3})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =1+3 \\\\ {R}^{2} & =4 \\\\ R & =2.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186244079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a205532-e34f-557b-a0c0-053abd30eea5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186241699} {:answer/id #uuid "6297d470-6d2f-5928-800e-035c75eb05da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186242063} {:answer/id #uuid "b06e6eaa-b780-58bf-937a-279d07b53b55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186242717} {:answer/id #uuid "da178b17-77be-55a6-9b4d-94738faef983" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186243124} {:answer/id #uuid "e15c84e5-203f-5b1c-ba93-a249e9f8958d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186243182}] :answer-field/correct {:db/id #edb/ref 17592186242063} :answer-field/id #uuid "e2e16e30-05ef-536b-9cc8-882666bdc09d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243830}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "28f7f0f2-9596-5dff-a1a9-20b56e96837b" :question/math-academy-id "q-107555" :question/problem "Given that the expression $\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ &=2\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+{2}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4 \\\\ {R}^{2} & =9 \\\\ R & =3.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186244080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eaa118e-da37-5659-b6ab-4781575cb126" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186241594} {:answer/id #uuid "53b22941-7f11-5f07-859e-07c9db8cf3cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186241928} {:answer/id #uuid "559c3499-e28e-5b21-a963-720014c2153b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186241949} {:answer/id #uuid "6f62da69-c89a-541b-b2a8-60baf67b6cbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186242171} {:answer/id #uuid "c40ce7e8-c28f-537f-9f82-d26ad190ef0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186242901}] :answer-field/correct {:db/id #edb/ref 17592186242901} :answer-field/id #uuid "1a454399-9748-589f-81bc-49c6bff05dcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243487}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89a5ccaf-82fe-5c91-bdfd-da2445211fc9" :question/math-academy-id "q-107558" :question/problem "Given that the expression $\\sqrt{3}\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x-ϕ)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{3}\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{3}\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{3} \\\\ R\\operatorname{sin}⁡ϕ &=3\\end{aligned}\\right.\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{3})^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =3+9 \\\\ {R}^{2} & =12 \\\\ R & =2\\sqrt{3}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"} {:db/id #edb/ref 17592186244087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdcb2bf-8345-5e1b-882c-bf6e4b7d33af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241316} {:answer/id #uuid "18b631c1-613b-593f-b662-0a358baf67b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{60}^{∘})" :db/id #edb/ref 17592186241395} {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} {:answer/id #uuid "c9bc19ce-1933-5942-9c00-cd53cf354ffd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186242958} {:answer/id #uuid "ee2dba2c-bb4d-57ec-8b76-7eedaf1d151b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186243291}] :answer-field/correct {:db/id #edb/ref 17592186241504} :answer-field/id #uuid "88598f20-c925-534c-af55-d6bf9e3c545c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243696}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e33547cc-9eda-5fa2-ada1-bbe7653d7d33" :question/math-academy-id "q-107570" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ &=\\sqrt{5}\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{5}}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡1 \\\\  & ={45}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+(\\sqrt{5})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+5 \\\\ {R}^{2} & =10 \\\\ R & =\\sqrt{10}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})\n$$"} {:db/id #edb/ref 17592186244088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "419fbda5-ea39-5bfc-8620-cc182f000989" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{sin}⁡(x+{30}^{∘})" :db/id #edb/ref 17592186241769} {:answer/id #uuid "8673b6f9-f305-57aa-a3da-3798105dccd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{sin}⁡(x+{60}^{∘})" :db/id #edb/ref 17592186242359} {:answer/id #uuid "b142571f-e6f5-57ea-bc1e-c3ec1c8dd0c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{sin}⁡(x+{60}^{∘})" :db/id #edb/ref 17592186242723} {:answer/id #uuid "cb449938-9332-56b0-9eff-2e784a030f94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}\\operatorname{sin}⁡(x+{60}^{∘})" :db/id #edb/ref 17592186242970} {:answer/id #uuid "fc60dcd0-0116-5c41-a6dc-f553b90f74ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{sin}⁡(x+{30}^{∘})" :db/id #edb/ref 17592186243404}] :answer-field/correct {:db/id #edb/ref 17592186241769} :answer-field/id #uuid "5af43c0e-a61c-50ae-bb48-b0ac6b82527e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243620}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f29e134-3f34-58a8-8500-c5b6c8981089" :question/math-academy-id "q-107571" :question/problem "$\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x=$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{6} \\\\ R\\operatorname{sin}⁡ϕ &=\\sqrt{2}\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{2}}{\\sqrt{6}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{1}{\\sqrt{3}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{\\sqrt{3}}{3} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right) \\\\ ϕ & ={30}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{6})^{2}+(\\sqrt{2})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =6+2 \\\\ {R}^{2} & =8 \\\\ R & =2\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x=2\\sqrt{2}\\operatorname{sin}⁡(x+{30}^{∘})\n$$"} {:db/id #edb/ref 17592186244089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} {:answer/id #uuid "4b4c9039-c2fb-5ec2-94bc-d45cd5379b7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186241858} {:answer/id #uuid "786d7e6b-a9ac-5d0e-ae28-08ad63146c2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}\\operatorname{sin}⁡(x+0.741)" :db/id #edb/ref 17592186242240} {:answer/id #uuid "870281f1-0101-507d-854d-e412a542cbbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186242361} {:answer/id #uuid "bbc5f724-7da5-5411-9f8c-9ba0486c21de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186242824}] :answer-field/correct {:db/id #edb/ref 17592186241721} :answer-field/id #uuid "9923f324-3fc1-5d64-bb7b-b26016552565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243724}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e19c29ed-ca08-5b08-881a-c2cea1937130" :question/math-academy-id "q-107574" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ &=2\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{2\\sqrt{5}}{5} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{2\\sqrt{5}}{5}\\right) \\\\ ϕ & ≈0.730\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get: \n\n$$\n\\begin{aligned}{R}^{2}{cos}^{2}⁡ϕ+{R}^{2}{sin}^{2}⁡ϕ & =(\\sqrt{5})^{2}+{2}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4 \\\\ {R}^{2} & =9 \\\\ R & =3\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈3\\operatorname{sin}⁡(x+0.730)\n$$"} {:db/id #edb/ref 17592186244090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "485d8e23-3ab1-55c2-99a1-e124e58ca8cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25\\operatorname{sin}⁡(2x+1.107)" :db/id #edb/ref 17592186241834} {:answer/id #uuid "4a94187f-ef30-54e4-86bf-6ee94cbef5b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sin}⁡(2x+1.351)" :db/id #edb/ref 17592186241851} {:answer/id #uuid "6ba8ff6c-a827-5cf1-b94b-1aab0efb4151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25\\operatorname{sin}⁡(2x+1.150)" :db/id #edb/ref 17592186242149} {:answer/id #uuid "91076749-48dd-581b-af7a-a42822dde81a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sin}⁡(2x+0.464)" :db/id #edb/ref 17592186242451} {:answer/id #uuid "93357f11-d50a-564c-951d-dd2c8ab628a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sin}⁡(2x+1.107)" :db/id #edb/ref 17592186242471}] :answer-field/correct {:db/id #edb/ref 17592186242471} :answer-field/id #uuid "9d439e5a-bdb4-539c-8fc9-a547716eadbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243732}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "256dccd4-6466-57bf-a816-93e7357a6fc5" :question/math-academy-id "q-107577" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡(2x)+2\\sqrt{5}\\operatorname{cos}⁡(2x)≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(2x+ϕ) & =R(\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡(2x)+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡(2x).\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡(2x)+2\\sqrt{5}\\operatorname{cos}⁡(2x)=R\\operatorname{sin}⁡(2x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡(2x)+2\\sqrt{5}\\operatorname{cos}⁡(2x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(2x)+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(2x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(2x),$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ &=2\\sqrt{5}\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2\\sqrt{5}}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =2 \\\\ ϕ & =\\operatorname{arctan}⁡(2) \\\\  & =1.107\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+(2\\sqrt{5})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4\\cdot 5 \\\\ {R}^{2} & =25 \\\\ R & =5.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡(2x)+2\\sqrt{5}\\operatorname{cos}⁡(2x)≈5\\operatorname{sin}⁡(2x+1.107)\n$$"} {:db/id #edb/ref 17592186244109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "633f0ebe-32ab-50f0-9e8f-09a9eb607c56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =9$ (double root)" :db/id #edb/ref 17592186242073} {:answer/id #uuid "932a12c1-261e-51ee-80f5-7add48bc18c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =2$ and $\\lambda =9$" :db/id #edb/ref 17592186242470} {:answer/id #uuid "93b1196c-0074-560f-86a8-6822a4095847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =1$ and $\\lambda =18$" :db/id #edb/ref 17592186242475} {:answer/id #uuid "ba82803e-df0c-5ada-8931-ce4e8257ea9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =0$ and $\\lambda =18$" :db/id #edb/ref 17592186242815} {:answer/id #uuid "ecad5c6a-34b1-50b3-8cd7-abb4cb6246a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186243273}] :answer-field/correct {:db/id #edb/ref 17592186242815} :answer-field/id #uuid "0818e6fa-35d7-5bee-9be7-dfa3e3d2be94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243454}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f128d753-12d7-51df-b895-9c1460388388" :question/math-academy-id "q-107843" :question/problem "Find all real eigenvalues of the matrix\n$$\n\\displaystyle N=\\begin{bmatrix}18 & -5 \\\\ 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $N-\\lambda I:$\n﻿﻿﻿\n\n$$\nN-\\lambda I=\\begin{bmatrix}18-\\lambda  & -5 \\\\ 0 & 0-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(N-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(N-\\lambda I) & =0 \\\\ \\begin{vmatrix}18-\\lambda  & -5 \\\\ 0 & -\\lambda \\end{vmatrix} & =0 \\\\ (18-\\lambda )(-\\lambda )-0\\cdot (-5) & =0 \\\\ \\lambda (\\lambda -18) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =0$ and $\\lambda =18.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."} {:db/id #edb/ref 17592186244110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a96d68e-1fa4-541b-b969-5ad9ad877559" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =1$ and $\\lambda =43$" :db/id #edb/ref 17592186241274} {:answer/id #uuid "3fa22426-2c63-51ef-8ae0-9e3385cbf206" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =43$ (double root)" :db/id #edb/ref 17592186241752} {:answer/id #uuid "b5b862fe-da16-5b54-8cc4-0d2a73ecb1eb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186242767} {:answer/id #uuid "c010ea74-931f-5ed7-82a4-366b8e5ff3d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =13$ (double root)" :db/id #edb/ref 17592186242860} {:answer/id #uuid "fb27cfbc-81e9-5f53-8596-793c8294e762" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\lambda =13$ and $\\lambda =43$" :db/id #edb/ref 17592186243395}] :answer-field/correct {:db/id #edb/ref 17592186242767} :answer-field/id #uuid "3d879f6a-f621-5faa-a1c9-b89dff4b4b09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243558}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41123383-6ac1-5b34-8d5e-987d1637c699" :question/math-academy-id "q-107852" :question/problem "Find all real eigenvalues of the matrix\n$$\n\\displaystyle Q=\\begin{bmatrix}5 & 1 \\\\ -3 & 8\\end{bmatrix}.\n$$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}5-\\lambda  & 1 \\\\ -3 & 8-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 1 \\\\ -3 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(8-\\lambda )-(-3)\\cdot 1 & =0 \\\\ 40-5\\lambda -8\\lambda +{\\lambda }^{2}+3 & =0 \\\\ {\\lambda }^{2}-13\\lambda +43 & =0.\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & =(-13)^{2}-4\\cdot 1\\cdot 43 \\\\  & =169-172 \\\\  & =-3 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $Q$ does not have real eigenvalues."} {:db/id #edb/ref 17592186244111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5cd195-916d-51d3-a145-ac3d8abbdf92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-3\\lambda -40=0" :db/id #edb/ref 17592186241427} {:answer/id #uuid "2bdfc526-d86a-5e73-baca-2112c1ad2358" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-3\\lambda +40=0" :db/id #edb/ref 17592186241571} {:answer/id #uuid "35403cd9-ea2a-5b57-971f-4e9e59069317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-\\lambda -40=0" :db/id #edb/ref 17592186241646} {:answer/id #uuid "a5cf22be-62ee-5bda-9228-41b20aca0652" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}+\\lambda -10=0" :db/id #edb/ref 17592186242639} {:answer/id #uuid "dd32357c-ec00-5793-bb30-3f656df8bc88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{2}-4\\lambda +10=0" :db/id #edb/ref 17592186243148}] :answer-field/correct {:db/id #edb/ref 17592186241427} :answer-field/id #uuid "9d00855c-44e0-5a49-b0df-a66417f8be4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243729}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11ba9d38-2921-5184-bf8a-8d9ae2f12bf8" :question/math-academy-id "q-107987" :question/problem "Find the characteristic equation of the matrix \n$$\n\\displaystyle B=\\begin{bmatrix}8 & 0 \\\\ 6 & -5\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=\\begin{bmatrix}8-\\lambda  & 0 \\\\ 6 & -5-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 0 \\\\ 6 & -5-\\lambda \\end{vmatrix} & =0 \\\\ (8-\\lambda )(-5-\\lambda )-6\\cdot 0 & =0 \\\\ -40-8\\lambda +5\\lambda +{\\lambda }^{2} & =0 \\\\ {\\lambda }^{2}-3\\lambda -40 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b3c5a5-7375-5461-b9f0-c802ef651773" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186241212} {:answer/id #uuid "2f76bb9d-e6c7-5e1a-b8a2-67876cf68b7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186241604} {:answer/id #uuid "78aac119-4dde-5951-ad35-559a566ff943" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-17" :db/id #edb/ref 17592186242243} {:answer/id #uuid "a223bb82-bec3-501b-aded-253a53009b2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186242600} {:answer/id #uuid "c3968252-fc1a-5b53-9617-261d78f533e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186242897}] :answer-field/correct {:db/id #edb/ref 17592186242600} :answer-field/id #uuid "cf01c73d-57cf-5598-8656-0c2a923068f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243800}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c5d0d5a-1c35-5e42-acae-01a474314ae5" :question/math-academy-id "q-1087" :question/problem "Calculate $det(T)$, if\n$$\n\\displaystyle T=\\begin{bmatrix}\\frac{1}{2} & 17 \\\\ 1 & 10\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(T) & =\\begin{vmatrix}\\frac{1}{2} & 17 \\\\ 1 & 10\\end{vmatrix} \\\\  & =\\frac{1}{2}\\cdot 10-17\\cdot 1 \\\\  & =5-17 \\\\  & =-12\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c2564b-6ebc-5712-bbd4-5f30166c948b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡(4z)+1" :db/id #edb/ref 17592186241780} {:answer/id #uuid "832d57a9-a1e0-575a-bfbd-f05181e6e490" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡(4z)-4" :db/id #edb/ref 17592186242326} {:answer/id #uuid "97bf63a5-3de6-5450-bc1d-1a6d54292dc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡z+4" :db/id #edb/ref 17592186242509} {:answer/id #uuid "b4625aca-6a87-5266-a0e4-002554f0e27a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡(4z)" :db/id #edb/ref 17592186242756} {:answer/id #uuid "dc44875b-bc82-5d63-86ea-4f088df5aef7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{tan}^{2}⁡z-2" :db/id #edb/ref 17592186243139}] :answer-field/correct {:db/id #edb/ref 17592186241780} :answer-field/id #uuid "d6186f9a-ccc8-5562-b122-5c1da7924096" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243811}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0fcc97e4-3645-5517-967a-e3b54a04fc40" :question/math-academy-id "q-108744" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={tan}^{2}⁡(4x+4y).\n$$\n\nUsing a substitution of the form $z=x+y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we factor the right-hand side of the given equation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={tan}^{2}⁡(4(x+y)).\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & ={tan}^{2}⁡(4z)\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}={tan}^{2}⁡(4z)+1.\n$$\n\nTherefore, $f(z)={tan}^{2}⁡(4z)+1.$"} {:db/id #edb/ref 17592186244164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "608b3d03-19b5-5374-a0fc-a3e27b90ee08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+y" :db/id #edb/ref 17592186242047} {:answer/id #uuid "8ac8bd69-61c9-5857-b202-82dc6129daa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+3y-1" :db/id #edb/ref 17592186242405} {:answer/id #uuid "8bf2b77c-254e-52e0-94a6-cd014f0b7106" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+{y}^{2}" :db/id #edb/ref 17592186242420} {:answer/id #uuid "8c940178-b04a-5b7f-a292-4e37eb8625a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+3y" :db/id #edb/ref 17592186242421} {:answer/id #uuid "961a895c-1016-54fe-b41b-3219981caf71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-{x}^{2}+{y}^{2}" :db/id #edb/ref 17592186242496}] :answer-field/correct {:db/id #edb/ref 17592186242421} :answer-field/id #uuid "3871dbc7-9d0f-5041-a42a-8c541e698f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243544}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0b7b4d1c-df4d-5986-bef2-30931183e55d" :question/math-academy-id "q-108780" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=2{sin}^{2}⁡(3x+3y)-1.\n$$\n\nThe general solution to this equation can be expressed in the form\n\n$$\n\\operatorname{cot}⁡(g(x,y))=-6x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we factor the right-hand side of the given equation.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2{sin}^{2}⁡(3(x+y))-1\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =2{sin}^{2}⁡(3z)-1\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2{sin}^{2}⁡(3z).\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}{csc}^{2}⁡(3z)\\,\\frac{\\text{d}z}{\\text{d}x} & =2 \\\\ \\int {csc}^{2}⁡(3z)\\,\\text{d}z & =\\int 2\\,\\text{d}x \\\\ -\\frac{1}{3}\\operatorname{cot}⁡(3z) & =2x+K \\\\ \\operatorname{cot}⁡(3z) & =-6x+C\\end{aligned}\n$$\n\nwhere $C=-3K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\operatorname{cot}⁡(3x+3y)=-6x+C\n$$\n\nTherefore, \n\n$$\ng(x,y)=3x+3y.\n$$"} {:db/id #edb/ref 17592186244167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04abdb1e-7b1d-54d8-9d20-4774bb8df4ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-{cos}^{2}⁡z" :db/id #edb/ref 17592186241217} {:answer/id #uuid "31b49354-993e-598b-9371-99716a3a784e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{cos}^{2}⁡(2z)" :db/id #edb/ref 17592186241618} {:answer/id #uuid "3607250f-d7b9-5ae3-a14e-98ec3c876b1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cos}^{2}⁡(z+1)" :db/id #edb/ref 17592186241652} {:answer/id #uuid "54d6d454-c216-524f-86e4-4a4fc3a80862" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cos}^{2}⁡(2z+1)" :db/id #edb/ref 17592186241943} {:answer/id #uuid "f5893635-8581-51fa-8667-bb774fb040b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-{cos}^{2}⁡(z+1)" :db/id #edb/ref 17592186243350}] :answer-field/correct {:db/id #edb/ref 17592186243350} :answer-field/id #uuid "abfc50ff-9ac3-5cb7-8a24-9576f8190a25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243746}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f19af75-a0de-5eec-8c80-0e4cc891ad39" :question/math-academy-id "q-108800" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={cos}^{2}⁡(2x-y+1).\n$$\n\nUsing a substitution of the form $z=2x-y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=2x-y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2-\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=2-\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}2-\\frac{\\text{d}z}{\\text{d}x} & ={cos}^{2}⁡(z+1)\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2-{cos}^{2}⁡(z+1).\n$$\n\nTherefore, $f(z)=2-{cos}^{2}⁡(z+1).$"} {:db/id #edb/ref 17592186244169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce51685-f180-59a8-8398-4f2461a0c7e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5-3{tan}^{2}⁡z" :db/id #edb/ref 17592186241867} {:answer/id #uuid "871089d9-f341-5092-8ccb-710312c1500d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-{tan}^{2}⁡(z-5)" :db/id #edb/ref 17592186242363} {:answer/id #uuid "87f2e6b6-aaad-513d-a404-4edede8cf981" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+{tan}^{2}⁡z" :db/id #edb/ref 17592186242373} {:answer/id #uuid "aaf535e8-89f8-5e4c-8b07-ecd2d591cfa7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-5{tan}^{2}⁡z" :db/id #edb/ref 17592186242676} {:answer/id #uuid "d418acdd-f22e-5d57-9607-c556cfe678d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+5\\operatorname{tan}⁡z" :db/id #edb/ref 17592186243052}] :answer-field/correct {:db/id #edb/ref 17592186242676} :answer-field/id #uuid "0b0aca84-3c6c-5519-bd2a-14b78a11c9d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243458}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e81268a9-ddfd-5f92-b961-b0aa841e7817" :question/math-academy-id "q-108802" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={tan}^{2}⁡(3x-5y).\n$$\n\nUsing a substitution of the form $z=3x-5y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=3x-5y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=3-5\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{5}-\\frac{1}{5}\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{3}{5}-\\frac{1}{5}\\,\\frac{\\text{d}z}{\\text{d}x} & ={tan}^{2}⁡z\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=3-5{tan}^{2}⁡z.\n$$\n\nTherefore, $f(z)=3-5{tan}^{2}⁡z.$"} {:db/id #edb/ref 17592186244229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006893c9-19ba-585c-9e32-bfd4faf22536" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186241188} {:answer/id #uuid "083a0005-e055-5ef1-ae3f-b4184a601b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186241249} {:answer/id #uuid "3ce00bee-a8cc-5e5e-a94e-eb4ec6402982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186241722} {:answer/id #uuid "ca9920ca-f6cf-5e76-8bf4-40033f6ae117" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242966} {:answer/id #uuid "edbf5faa-5d8f-55bc-8aac-4740cd883d9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186243284}] :answer-field/correct {:db/id #edb/ref 17592186241249} :answer-field/id #uuid "5367f0f2-957f-5f2a-9f1c-1decd00abc65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243600}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c401ac87-eb9d-550f-aa95-5fff16627f53" :question/math-academy-id "q-109102" :question/problem "Find the Jordan canonical form of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}3 & -4 \\\\ 1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}3-\\lambda  & -4 \\\\ 1 & -1-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-1-\\lambda )-1\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-2\\lambda +1 & =0 \\\\ (\\lambda -1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=1.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(1)=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186244266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29988310-e3cb-5074-b48e-a0d5cd0b71eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{\\sqrt{e}}\\,\\text{s}" :db/id #edb/ref 17592186241546} {:answer/id #uuid "70950e21-f64d-5e65-988e-990ff9bd3046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=1\\,\\text{s}" :db/id #edb/ref 17592186242185} {:answer/id #uuid "c455cad7-1861-55ea-8805-3c4050ac92c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=e\\,\\text{s}" :db/id #edb/ref 17592186242906} {:answer/id #uuid "cc9e7ec0-2e2e-5fa6-8de4-f5c7b8a6b248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186242977} {:answer/id #uuid "df484059-af1e-5494-ac51-0a241b61c446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{e}\\,\\text{s}" :db/id #edb/ref 17592186243165}] :answer-field/correct {:db/id #edb/ref 17592186242185} :answer-field/id #uuid "39688573-9cf9-586f-8cfb-4374658f9420" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243549}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44bcce29-44a3-5949-85ff-55ab7d8ed22b" :question/math-academy-id "q-109279" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)={ln}^{2}⁡t+2,\\,t>0.\n$$\n\nCalculate the time at which the particle is stationary." :question/worked-solution "The particle is stationary when its velocity is zero. So first, we need to calculate the velocity function. We can do that by taking the derivative of the position function, as follows:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({ln}^{2}⁡t+2) \\\\  & =\\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}\n$$\n\nThe particle is stationary when $v=0\\,\\text{m/s}.$ So, we set $v=0$ and solve for $t:$\n\n$$\n\\begin{aligned}\\frac{2\\operatorname{ln}⁡t}{t} & =0 \\\\ \\operatorname{ln}⁡t & =0 \\\\ t & =1\\end{aligned}\n$$\n\nTherefore, the particle is stationary at $t=1\\,\\text{s}.$"} {:db/id #edb/ref 17592186244271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1816cc3a-098a-51d7-8a9b-44051edcef01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186241389} {:answer/id #uuid "27d0a24c-fbca-5739-b879-af4f89c228a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186241526} {:answer/id #uuid "3f344766-6b92-5b8e-a55d-6e40eb062dcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186241745} {:answer/id #uuid "59d9b08e-9729-5a66-9093-6e99d2e59772" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186241989} {:answer/id #uuid "7b28815c-1a62-59a8-9f38-c7db059ebfff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 1 & 5\\end{bmatrix}" :db/id #edb/ref 17592186242264}] :answer-field/correct {:db/id #edb/ref 17592186241526} :answer-field/id #uuid "8b3df0ae-5095-5364-b4c4-0b622e41a210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243699}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa8294c2-0b9e-5133-97e1-eef81a69651e" :question/math-academy-id "q-109315" :question/problem "Find the Jordan canonical form of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}7 & 2 \\\\ -2 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}7-\\lambda  & 2 \\\\ -2 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )(3-\\lambda )-2\\cdot (-2) & =0 \\\\ {\\lambda }^{2}-10\\lambda +25 & =0 \\\\ (\\lambda -5)(\\lambda -5) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=5.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(5)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186244272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ce7a75-813f-5ae4-b539-bccc51785d0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186241988} {:answer/id #uuid "7e8994de-63ba-53ae-b699-bc7263d361c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186242291} {:answer/id #uuid "93704c6d-c0fb-525a-ae41-0563128e7814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186242472} {:answer/id #uuid "98183edb-8f61-5213-a098-3a5d7f57525e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186242512} {:answer/id #uuid "a30ab4aa-b409-53b0-968d-af58d57b67bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186242606}] :answer-field/correct {:db/id #edb/ref 17592186242512} :answer-field/id #uuid "8bb16f68-5636-5662-9ee8-09a56750b6b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243701}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52870c2b-5862-5c0b-884f-72d410941954" :question/math-academy-id "q-109316" :question/problem "Find a Jordan canonical form of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}1 & 2 \\\\ 2 & -2\\end{bmatrix}.\n$$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1-\\lambda  & 2 \\\\ 2 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(-2-\\lambda )-(2)(2) & =0 \\\\ {\\lambda }^{2}+\\lambda -6 & =0 \\\\ (\\lambda +3)(\\lambda -2) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=2.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(-3)\\,⊕\\,{J}_{1}(2)=\\begin{bmatrix}-3 & 0 \\\\ 0 & 2\\end{bmatrix}.\n$$"} {:answer/id #uuid "03a28cfe-f7a8-55f5-bb93-c844116543a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20{arcsin}^{4}⁡(4x)}{\\sqrt{1-16{x}^{2}}}" :db/id #edb/ref 17592186244339} {:answer/id #uuid "0683cfd6-324d-52be-947a-7be93342bf67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20{arcsin}^{2}⁡(4x)}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186244366} {:answer/id #uuid "0aba1084-dd62-5f6d-8414-67325a66d2b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u\\sqrt{{u}^{2}+{cos}^{2}⁡v}" :db/id #edb/ref 17592186244408} {:answer/id #uuid "1664cb6e-2cff-5407-8245-95b80c5e1a2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {e}^{1-{y}^{2}}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186244520} {:answer/id #uuid "2257e067-0d5e-5c19-87e5-ca613d5120cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨x,\\,{ln}^{2}⁡(x-1)\\operatorname{cos}⁡\\theta ,\\,{ln}^{2}⁡(x-1)\\operatorname{sin}⁡\\theta ⟩" :db/id #edb/ref 17592186244614} {:answer/id #uuid "238d9c4f-3b25-52f7-9f82-80add2605c70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{cos}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sin}⁡({[{f}^{-1}(x)]}^{3})}{12{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186244627} {:answer/id #uuid "248c560a-5504-5344-ba06-31ff881f4228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ln⁡(2)-1" :db/id #edb/ref 17592186244640} {:answer/id #uuid "291c3195-b924-5096-97d2-58aff463eca1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{arcsin}^{4}⁡(4x)}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186244673} {:answer/id #uuid "37b42a97-8973-57c9-9667-d48f2ac42a0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {csc}^{2}⁡y\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186244807} {:answer/id #uuid "422f2f7f-75d3-5282-804c-01dae36541e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\operatorname{arctan}⁡(5x)}{{x}