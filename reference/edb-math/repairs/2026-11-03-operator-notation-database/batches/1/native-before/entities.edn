uid "743a0f97-3b90-5694-8b06-bcb5462a0241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186242210} {:answer/id #uuid "d62c64fb-a6a1-5888-8090-3849aad6cf51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186243077}] :answer-field/correct {:db/id #edb/ref 17592186242210} :answer-field/id #uuid "79b9683f-1f18-521d-9419-eadcd2d3ba43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243673}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7348e9e6-dfba-5dbc-a5b3-afaa8281be9c" :question/math-academy-id "q-106522" :question/problem "Find the Cartesian equation of the hyperbola $x=\\sqrt{3}\\operatorname{sec}⁡t,\\,y=4\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{3}\\operatorname{sec}⁡t \\\\ \\frac{x}{\\sqrt{3}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{3})^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{3} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =4\\operatorname{tan}⁡t \\\\ \\frac{y}{4} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{{4}^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{16} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{16}+1 & =\\frac{{x}^{2}}{3} \\\\ \\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{16} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100c5077-234e-5f61-9100-12b95264446f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{12}=1" :db/id #edb/ref 17592186241319} {:answer/id #uuid "6a730aa4-dd93-5d1e-9a4c-eca6bc238fd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186242138} {:answer/id #uuid "d709f505-665f-50d0-b8de-ef841b89f308" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{12}-\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186243087} {:answer/id #uuid "eaf960e8-8f5a-5f2b-84c4-f0b975ca0c26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186243262} {:answer/id #uuid "f04f4c9c-5769-514b-8c29-fe62ce0a656b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{12}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186243316}] :answer-field/correct {:db/id #edb/ref 17592186243087} :answer-field/id #uuid "c0594e5e-9738-51ca-955c-b1a4b5a8f80f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243778}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af943c2b-8efb-52a1-9ba0-375300448462" :question/math-academy-id "q-106524" :question/problem "Find the Cartesian equation of the hyperbola $x=2\\sqrt{3}\\operatorname{sec}⁡t,\\,y=2\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =2\\sqrt{3}\\operatorname{sec}⁡t \\\\ \\frac{x}{2\\sqrt{3}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(2\\sqrt{3})^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{12} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =2\\operatorname{tan}⁡t \\\\ \\frac{y}{2} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{{2}^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{4} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{4}+1 & =\\frac{{x}^{2}}{12} \\\\ \\frac{{x}^{2}}{12}-\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3240ab96-eed4-5754-946a-52eea9c91d0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186241622} {:answer/id #uuid "69e5566d-cfaf-556e-8d0b-cbaf31f74a8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{5}=1" :db/id #edb/ref 17592186242132} {:answer/id #uuid "816915ec-5301-5786-b634-5de6a27b5036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{5}-\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186242313} {:answer/id #uuid "94839fab-7eb1-57e2-a228-b095c8181ca1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{3}=1" :db/id #edb/ref 17592186242483} {:answer/id #uuid "ac3ab948-1612-536f-8002-e61701a3a6b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186242686}] :answer-field/correct {:db/id #edb/ref 17592186241622} :answer-field/id #uuid "fb093481-845c-59d9-97c7-1dd5fda35a5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243875}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15e0fdb8-5dad-558c-a81b-b6d856e0082f" :question/math-academy-id "q-106526" :question/problem "Find the Cartesian equation of the hyperbola $x=\\sqrt{3}\\operatorname{sec}⁡t,\\,y=\\sqrt{5}\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{3}\\operatorname{sec}⁡t \\\\ \\frac{x}{\\sqrt{3}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{3})^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{3} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\sqrt{5}\\operatorname{tan}⁡t \\\\ \\frac{y}{\\sqrt{5}} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{(\\sqrt{5})^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{5} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{5}+1 & =\\frac{{x}^{2}}{3} \\\\ \\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{5} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186243902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56307aee-6e11-5a2b-8f68-a686b118670c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{18}=1" :db/id #edb/ref 17592186241957} {:answer/id #uuid "5837a20d-9342-5d9b-ab27-dc0f9dfd937f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{18}-\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186241979} {:answer/id #uuid "6f54e68b-1fb0-54f5-9f97-c8d2d4cd76b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{y}^{2}}{18}-\\frac{{x}^{2}}{3}=1" :db/id #edb/ref 17592186242170} {:answer/id #uuid "c27edde4-d124-548b-aef6-8c044e2b2b1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{18}=1" :db/id #edb/ref 17592186242887} {:answer/id #uuid "e5abf