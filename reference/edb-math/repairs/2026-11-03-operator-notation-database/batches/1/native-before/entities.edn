s not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 5-7\\cdot 0=5.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular."} {:db/id #edb/ref 17592186262839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0752f8-54df-507a-872b-fce6c55fcc41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-1" :db/id #edb/ref 17592186259989} {:answer/id #uuid "1b8f8217-73b8-5aac-bc6a-21c690404158" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=3" :db/id #edb/ref 17592186260111} {:answer/id #uuid "a0659982-c103-5f57-83fb-988b62210ec7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=1" :db/id #edb/ref 17592186261268} {:answer/id #uuid "a7949e65-d752-55be-b89d-fa6d51459350" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-3" :db/id #edb/ref 17592186261338} {:answer/id #uuid "cbb45516-48e8-5a7d-bb41-07e91dbcf8b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=0" :db/id #edb/ref 17592186261669}] :answer-field/correct {:db/id #edb/ref 17592186261268} :answer-field/id #uuid "de18e845-9fc1-5af4-bf61-8d1ea6725965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262509}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "524e74d6-0355-574f-af8e-7809bad3676c" :question/math-academy-id "q-127899" :question/problem "If $A=\\begin{bmatrix}k-1 & k-1 \\\\ 3 & -1\\end{bmatrix}$ is a singular matrix, calculate the value of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =(k-1)\\cdot (-1)-(k-1)\\cdot 3 \\\\  & =-k+1-3k+3 \\\\  & =-4k+4\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}-4k+4 & =0 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore, the value of $k$ is $k=1.$"} {:db/id #edb/ref 17592186262840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0c10c6-3508-5550-98fd-f098d04bede5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 3" :db/id #edb/ref 17592186260141} {:answer/id #uuid "3e8f1f21-9c81-5ef5-b4fe-0d20d66954ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 9" :db/id #edb/ref 17592186260426} {:answer/id #uuid "66ed762d-bc10-5c9a-9a0d-59b6f60da393" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=0" :db/id #edb/ref 17592186260773} {:answer/id #uuid "beafacad-b185-562e-8397-0f520d94cd1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 1" :db/id #edb/ref 17592186261557} {:answer/id #uuid "c4bf894e-96f1-598c-861b-46bd6ece34bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 4" :db/id #edb/ref 17592186261612}] :answer-field/correct {:db/id #edb/ref 17592186260426} :answer-field/id #uuid "909985c8-f2ff-5344-aacb-a238867289fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49be873f-6aae-5fe9-b9e9-08cc0609f50a" :question/math-academy-id "q-127900" :question/problem "If $A=\\begin{bmatrix}k & 3 \\\\ 27 & k\\end{bmatrix}$ is a singular matrix, calculate the value(s) of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =k\\cdot k-27\\cdot 3 \\\\  & ={k}^{2}-81.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}{k}^{2}-81 & =0 \\\\ {k}^{2} & =81 \\\\ k & =\\pm 9\\end{aligned}\n$$\n\nTherefore, the values of $k$ are $k=\\pm 9.$"} {:db/id #edb/ref 17592186262841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} {:answer/id #uuid "82ad1107-f4f2-56fb-a170-26080bfb5a58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=\\pm 9" :db/id #edb/ref 17592186261009} {:answer/id #uuid "93eed24a-7d3e-5252-8646-ba1e56d6756f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=1" :db/id #edb/ref 17592186261161} {:answer/id #uuid "acb60d02-9af1-5edb-8a62-0a7f615d8394" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=\\pm 4" :db/id #edb/ref 17592186261386} {:answer/id #uuid "f1b9c926-8614-5473-84ac-a0af3c07259f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=2" :db/id #edb/ref 17592186261991}] :answer-field/correct {:db/id #edb/ref 17592186259936} :answer-field/id #uuid "b5f9163f-3e19-52b4-9fae-e228093cfe55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262453}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54a4b93b-d93e-5ce6-98ac-7b0ed79d28ef" :question/math-academy-id "q-127901" :question/problem "If $A=\\begin{bmatrix}48 & a \\\\ a & 3\\end{bmatrix}$ is a singular matrix, calculate the value(s) of $a.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =48\\cdot 3-a\\cdot a \\\\  & =144-{a}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $a:$\n\n$$\n\\begin{aligned}144-{a}^{2} & =0 \\\\ {a}^{2} & =144 \\\\ a & =\\pm 12\\end{aligned}\n$$\n\nTherefore, the values of $a$ are $a=\\pm 12.$"} {:db/id #edb/ref 17592186262842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e10364-a8ca-5a9b-8ec9-fb274ee07c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=9" :db/id #edb/ref 17592186259910} {:answer/id #uuid "64215484-b9df-5191-b8c1-9280990fe3aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=4" :db/id #edb/ref 17592186260740} {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=0" :db/id #edb/ref 17592186261470} {:answer/id #uuid "cec39778-4048-5806-ae58-6218823c031b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186261705} {:answer/id #uuid "d2a62acf-b03a-52a7-ab5a-7633988a7413" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186261728}] :answer-field/correct {:db/id #edb/ref 17592186261470} :answer-field/id #uuid "cfd7d4c7-e60d-5c53-95c8-2c7046132a9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a4d5dba8-4e64-55e3-a838-e85b88eeb6cd" :question/math-academy-id "q-127903" :question/problem "If $M=\\begin{bmatrix}t & 5 \\\\ t & 9\\end{bmatrix}$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"} {:db/id #edb/ref 17592186262843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3059120f-ca9e-51ca-9841-1f8df800e6d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n=\\pm 4" :db/id #edb/ref 17592186260311} {:answer/id #uuid "5bf24db5-f1ae-5524-83bc-edf5d3ad239e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n=10" :db/id #edb/ref 17592186260659} {:answer/id #uuid "621ece07-1998-5006-b429-8870d6c0b314" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n=\\frac{3}{5}" :db/id #edb/ref 17592186260720} {:answer/id #uuid "673bf1ec-9954-5f5f-b4e0-082e19a5ab7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n=\\frac{1}{4}" :db/id #edb/ref 17592186260777} {:answer/id #uuid "929a515e-de47-5de2-b043-79d260b71667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n=\\pm 8" :db/id #edb/ref 17592186261149}] :answer-field/correct {:db/id #edb/ref 17592186261149} :answer-field/id #uuid "b1e9e066-1c72-5b37-a693-dbbf75cdc32f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262445}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97157127-f9e4-550a-8517-ce69acd7410c" :question/math-academy-id "q-127905" :question/problem "If $P=\\begin{bmatrix}n & -4 \\\\ -16 & n\\end{bmatrix}$ is a singular matrix, calculate the value(s) of $n.$" :question/worked-solution "The matrix $P$ is singular if and only if $det(P)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(P) & =n\\cdot n-(-16)\\cdot (-4) \\\\  & ={n}^{2}-64.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $n:$\n\n$$\n\\begin{aligned}{n}^{2}-64 & =0 \\\\ {n}^{2} & =64 \\\\ n & =\\pm 8\\end{aligned}\n$$\n\nTherefore, the values of $n$ are $n=\\pm 8.$"} {:db/id #edb/ref 17592186262844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "327c9e3e-2327-51e3-ab75-0eb4d6685f48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=0" :db/id #edb/ref 17592186260330} {:answer/id #uuid "5528c44b-359f-5f31-ae64-915cc0634cea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=5" :db/id #edb/ref 17592186260602} {:answer/id #uuid "919764a7-f044-599d-84f6-09b075397514" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=4" :db/id #edb/ref 17592186261140} {:answer/id #uuid "97871f23-59b7-5612-bd45-e5666681499e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186261190} {:answer/id #uuid "f0dc053c-ee76-590f-8164-11bfcb310e3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{5}" :db/id #edb/ref 17592186261984}] :answer-field/correct {:db/id #edb/ref 17592186260330} :answer-field/id #uuid "3e938186-12f9-50c6-849c-59f9dee1509b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262236}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14d76c92-61a7-5867-aa92-05e432da7958" :question/math-academy-id "q-127906" :question/problem "If $M=\\begin{bmatrix}t & 2 \\\\ t & -8\\end{bmatrix}$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot (-8)-t\\cdot 2 \\\\  & =-8t-2t \\\\  & =-10t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}-10t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"} {:db/id #edb/ref 17592186262866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb58962-45f1-5f8d-a8be-d42637576c1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{c}^{2}-{d}^{2}" :db/id #edb/ref 17592186260119} {:answer/id #uuid "226c487c-dbfb-505f-8761-48db1cc45592" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{b}^{2}+cd" :db/id #edb/ref 17592186260174} {:answer/id #uuid "66f85059-05db-5010-a63e-acd4da954bcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "bc+4d" :db/id #edb/ref 17592186260775} {:answer/id #uuid "a8bd6057-f82e-59b9-acad-babe49368353" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2bd" :db/id #edb/ref 17592186261349} {:answer/id #uuid "eb22f58f-dd2f-5800-b7fb-0b59fae6040f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10cd+5b" :db/id #edb/ref 17592186261938}] :answer-field/correct {:db/id #edb/ref 17592186261349} :answer-field/id #uuid "e3f11083-aaba-5410-8dfb-d783fbbe4486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262527}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f427be12-299d-59f1-ae44-457ae0e31b75" :question/math-academy-id "q-128014" :question/problem "What is the minor of ${a}_{12}$ in the matrix\n$$\n\\displaystyle A=\\begin{bmatrix}4 & -3d & 5b \\\\ b & {c}^{2} & b-d \\\\ b & -10c & b+d\\end{bmatrix}?\n$$" :question/worked-solution "First, we remove the first row and second column:\n\n$$\nA=\\begin{bmatrix}∗ & -3d & ∗ \\\\ b & ∗ & b-d \\\\ b & ∗ & b+d\\end{bmatrix}\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}b & b-d \\\\ b & b+d\\end{bmatrix} & =\\begin{vmatrix}b & b-d \\\\ b & b+d\\end{vmatrix} \\\\  & =b\\cdot (b+d)-(b-d)\\cdot b \\\\  & ={b}^{2}+bd-{b}^{2}+db \\\\  & =2bd\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "319c26d8-cd1f-558f-b9ba-62aa42d75694" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3pr-{r}^{2}" :db/id #edb/ref 17592186260320} {:answer/id #uuid "40b4c3b9-0dac-5605-872f-1102d7173aa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5pq+6r" :db/id #edb/ref 17592186260441} {:answer/id #uuid "881fbb24-f9f1-530b-a99b-b89149717875" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36pq" :db/id #edb/ref 17592186261063} {:answer/id #uuid "c6bda17d-cd64-5edb-96bc-38c5f28be06f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6qr-p" :db/id #edb/ref 17592186261630} {:answer/id #uuid "ce8ee965-ac75-5b84-9499-54ea2fa7c3fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186261703}] :answer-field/correct {:db/id #edb/ref 17592186261063} :answer-field/id #uuid "0fd151a3-11e8-54c3-8e7e-17ed85ea5842" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262153}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab657870-efc9-54fa-b807-10ebb4cc9089" :question/math-academy-id "q-128024" :question/problem "What is the minor of ${t}_{22}$ in the matrix\n$$\n\\displaystyle T=\\begin{bmatrix}3p & r & 3p \\\\ q & r & -q \\\\ -6q & -p & 6q\\end{bmatrix}?\n$$" :question/worked-solution "First, we remove the second row and the second column:\n\n$$\nT=\\begin{bmatrix}3p & ∗ & 3p \\\\ ∗ & r & ∗ \\\\ -6q & ∗ & 6q\\end{bmatrix}\n$$\n\n \n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}3p & 3p \\\\ -6q & 6q\\end{bmatrix} & =\\begin{vmatrix}3p & 3p \\\\ -6q & 6q\\end{vmatrix} \\\\  & =3p\\cdot 6q-3p\\cdot (-6q) \\\\  & =18pq+18pq \\\\  & =36pq\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "938435d8-69e4-5177-83be-c2661b220df3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437788} {:answer/id #uuid "b0acf52f-1926-563b-90fe-5bd5c838a2cc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437789}] :answer-field/correct {:db/id #edb/ref 17592186437788} :answer-field/id #uuid "ef069a99-e51d-5c41-b3dd-fbe618b3ae29" :answer-field/key "$det(Q)=-5$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438923} {:answer-field/choices [{:answer/id #uuid "fda1810e-40d9-5b5a-8ed9-7de0e91b6696" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437790} {:answer/id #uuid "ae8badb5-ccf3-54b7-bf14-15f19c3c783e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437791}] :answer-field/correct {:db/id #edb/ref 17592186437790} :answer-field/id #uuid "3a6baa2c-bfa2-5841-829c-446168fc4d31" :answer-field/key "$det(Q)=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438924} {:answer-field/choices [{:answer/id #uuid "bd3030ea-f56b-54f2-b19e-0fe96063ba8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437792} {:answer/id #uuid "13768b60-6037-5979-87a7-85e46aa637f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437793}] :answer-field/correct {:db/id #edb/ref 17592186437792} :answer-field/id #uuid "10609156-1bc3-5176-82f7-7da72d8cac5c" :answer-field/key "$Q$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438925} {:answer-field/choices [{:answer/id #uuid "45f9eaa1-ec03-587f-9925-ac1e03ddc805" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186667930} {:answer/id #uuid "ceeca510-070e-5b7e-a5b0-fde585d5adcb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186667931}] :answer-field/correct {:db/id #edb/ref 17592186667931} :answer-field/id #uuid "ceb5d4cf-1c76-560f-9b77-bb0950007541" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186668242}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f86fe2f1-042a-5183-8a18-518a658cc1a0" :question/math-academy-id "q-128474" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n$$\nQ=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 3 & 1 \\\\ 3 & 5 & 3\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =\\begin{vmatrix}1 & 1 & -1 \\\\ 2 & 3 & 1 \\\\ 3 & 5 & 3\\end{vmatrix} \\\\  & =1\\begin{vmatrix}3 & 1 \\\\ 5 & 3\\end{vmatrix}-1\\begin{vmatrix}2 & 1 \\\\ 3 & 3\\end{vmatrix}-1\\begin{vmatrix}2 & 3 \\\\ 3 & 5\\end{vmatrix} \\\\  & =1(9-5)-1(6-3)-1(10-9) \\\\  & =1\\cdot 4-1\\cdot 3-1\\cdot 1 \\\\  & =4-3-1 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, none of the statements are true."} {:db/id #edb/ref 17592186262908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9c8a655-dc30-5747-b5e0-efd4fa464943" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437794} {:answer/id #uuid "b3238a25-1600-54c9-a92e-d6b1f31166ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437795}] :answer-field/correct {:db/id #edb/ref 17592186437794} :answer-field/id #uuid "0457a549-1799-5124-a11e-6cbe8bf02f40" :answer-field/key "$T$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438926} {:answer-field/choices [{:answer/id #uuid "86770289-d595-5a74-8241-7f7eaf943501" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437796} {:answer/id #uuid "0065df67-0fde-5ae4-ab1b-04075255afaf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437797}] :answer-field/correct {:db/id #edb/ref 17592186437797} :answer-field/id #uuid "48c446f0-c232-5d1a-a9fa-08c4d973bbe4" :answer-field/key "$T$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438927} {:answer-field/choices [{:answer/id #uuid "06d221ff-7342-5189-8083-2e45e2305d69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437798} {:answer/id #uuid "db168e14-a68a-5486-95d1-8d4686854e72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437799}] :answer-field/correct {:db/id #edb/ref 17592186437799} :answer-field/id #uuid "5b5f6d45-4846-5d6c-b409-f20f073263eb" :answer-field/key "$det(T)=-30$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438928}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "898815e0-65a8-55f9-b81f-a64efbb5e7e4" :question/math-academy-id "q-128476" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\nSelect all that apply.\n\n$$\nT=\\begin{bmatrix}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}1 & 1 \\\\ 3 & 1\\end{vmatrix}-3\\begin{vmatrix}2 & 1 \\\\ 1 & 1\\end{vmatrix}-5\\begin{vmatrix}2 & 1 \\\\ 1 & 3\\end{vmatrix} \\\\  & =1(1-3)-3(2-1)-5(6-1) \\\\  & =1\\cdot (-2)-3\\cdot 1-5\\cdot 5 \\\\  & =-2-3-25 \\\\  & =-30\\end{aligned}\n$$\n\n \n\nSince $det(T)=-30\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statements “$T$ is **not** a singular matrix” and $det(T)=-30$ are true."} {:db/id #edb/ref 17592186262913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96a78a3a-a96f-5296-bb6f-17bd0c2c1029" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437812} {:answer/id #uuid "8a41bcde-2807-5a96-8245-df7493039a41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437813}] :answer-field/correct {:db/id #edb/ref 17592186437813} :answer-field/id #uuid "2d87a851-8d26-5425-83e8-dba94be07b21" :answer-field/key "$R$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438935} {:answer-field/choices [{:answer/id #uuid "9d06dd62-d83d-54e9-b4ea-1974429d75ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437814} {:answer/id #uuid "423c9da1-fb5c-5eb1-aac0-e8f7d5033fa6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437815}] :answer-field/correct {:db/id #edb/ref 17592186437815} :answer-field/id #uuid "ad0097cd-c1c7-5438-b4af-b5844d0cf50a" :answer-field/key "$det(R)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438936} {:answer-field/choices [{:answer/id #uuid "9e2b6e65-193a-5e1a-ae4e-babcf8cd0b3f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437816} {:answer/id #uuid "4daf1704-b4bb-5190-aede-54368b9e49c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437817}] :answer-field/correct {:db/id #edb/ref 17592186437816} :answer-field/id #uuid "727b8a81-c497-5e39-8d74-82d5d2b34ab9" :answer-field/key "$det(R)=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438937}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d0d8a3d8-8c1e-55f4-b495-022734d0f802" :question/math-academy-id "q-128484" :question/problem "Which of the following statements are true regarding the matrix $R$ given below?\n\nSelect all that apply.\n\n$$\nR=\\begin{bmatrix}2 & \\sqrt{2} & 2 \\\\ \\frac{1}{2} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =\\begin{vmatrix}2 & \\sqrt{2} & 2 \\\\ \\frac{1}{2} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{vmatrix} \\\\  & =2\\begin{vmatrix}0 & -1 \\\\ \\sqrt{2} & 4\\end{vmatrix}-\\sqrt{2}\\begin{vmatrix}\\frac{1}{2} & -1 \\\\ 1 & 4\\end{vmatrix}+2\\begin{vmatrix}\\frac{1}{2} & 0 \\\\ 1 & \\sqrt{2}\\end{vmatrix} \\\\  & =2(0+\\sqrt{2})-\\sqrt{2}(2+1)+2(\\frac{\\sqrt{2}}{2}-0) \\\\  & =2\\cdot \\sqrt{2}-\\sqrt{2}\\cdot 3+2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =2\\sqrt{2}-3\\sqrt{2}+\\sqrt{2} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements “$R$ is a singular matrix” and $det(R)=0$ are true."} {:db/id #edb/ref 17592186262917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fb98df-401c-5fa9-9f2f-08261df60aa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186259918} {:answer/id #uuid "220b8b83-724a-5cbe-853b-6caa42638775" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186260170} {:answer/id #uuid "726ac3fa-740a-5e90-81fa-f599fc3f37a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186260875} {:answer/id #uuid "81ca9339-6bce-5219-8fae-787545463a11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186261005} {:answer/id #uuid "8c6b36bf-bffd-5918-ae53-d958ad6e391a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186261101}] :answer-field/correct {:db/id #edb/ref 17592186261005} :answer-field/id #uuid "c45caafc-858f-500e-9ef9-058205b847f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262475}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cb6a7e0a-d356-5b58-a703-e0864f9a1a58" :question/math-academy-id "q-128500" :question/problem "Given that\n$$\n\\displaystyle B=\\begin{bmatrix}1 & 2 & -5 \\\\ 1 & 2 & 1 \\\\ y & 2 & 1\\end{bmatrix}\n$$\nand $det(B)=12,$ find the value of $y.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}\\text{det}(B) & =\\begin{vmatrix}1 & 2 & -5 \\\\ 1 & 2 & 1 \\\\ y & 2 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}2 & 1 \\\\ 2 & 1\\end{vmatrix}-2\\begin{vmatrix}1 & 1 \\\\ y & 1\\end{vmatrix}-5\\begin{vmatrix}1 & 2 \\\\ y & 2\\end{vmatrix} \\\\  & =0-2\\cdot (1-y)-5\\cdot (2-2y) \\\\  & =12y-12\\end{aligned}\n$$\n\nSince the determinant of the matrix is $12,$ we have:\n\n$$\n\\begin{aligned}12y-12 & =12 \\\\ 12y & =24 \\\\ y & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183c086d-012b-5f39-b92e-4550955dfcbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186260085} {:answer/id #uuid "2044861f-98f6-51d9-9cf5-e5080be450a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186260152} {:answer/id #uuid "21a46985-36f6-5f1d-b213-16f3935ec5b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186260165} {:answer/id #uuid "91c5f6e6-19cd-5455-92f6-06f29a9d6687" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186261142} {:answer/id #uuid "c0800f44-af37-5d5d-b586-92ebc2148392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186261575}] :answer-field/correct {:db/id #edb/ref 17592186261575} :answer-field/id #uuid "9a39ba2f-181c-558b-b3c6-6fdf22cdca96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262399}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9517ddd6-18dd-5bea-948b-a75416c96cbb" :question/math-academy-id "q-128502" :question/problem "Given that \n$$\n\\displaystyle C=\\begin{bmatrix}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{bmatrix}\n$$ \nand $det(C)=28,$ find the value of $q.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $q:$\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}q & 5 \\\\ -5 & 1\\end{vmatrix}-3\\begin{vmatrix}-1 & 5 \\\\ 0 & 1\\end{vmatrix}+1\\begin{vmatrix}-1 & q \\\\ 0 & -5\\end{vmatrix} \\\\  & =2\\cdot (q+25)-3\\cdot (-1)+5 \\\\  & =2q+58\\end{aligned}\n$$\n\nSince the determinant of the matrix is $28,$ we have:\n\n$$\n\\begin{aligned}2q+58 & =28 \\\\ 2q & =-30 \\\\ q & =-15\\end{aligned}\n$$"} {:answer/id #uuid "029d5750-b526-536a-a08f-8c172e389abf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi /2)\\times (0,\\pi /2)}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{(\\pi /2,\\pi )\\times (0,\\pi /2)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A" :db/id #edb/ref 17592186263021} {:answer/id #uuid "0ff40f7d-1572-5d71-9d5f-4fc51663adc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({e}^{t}+{sec}^{2}⁡t)\\,i+(2t\\operatorname{ln}⁡t+t)\\,k" :db/id #edb/ref 17592186263147} {:answer/id #uuid "13e8712f-c64b-5894-8cff-69131c40260f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{csc}^{2}⁡x+4" :db/id #edb/ref 17592186263187} {:answer/id #uuid "2694a5ad-d4b8-5c2e-a209-1d1669bb396f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({e}^{t}+{sec}^{2}⁡t)\\,j+2t\\operatorname{ln}⁡t\\,k" :db/id #edb/ref 17592186263336} {:answer/id #uuid "336fc230-0cd9-5c0e-b9fb-3cfa956fcc4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{csc}^{2}⁡x" :db/id #edb/ref 17592186263445} {:answer/id #uuid "4aac0fba-4b64-50bb-9caf-f03e67f9ee00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{2}⁡x+{cot}^{2}⁡x" :db/id #edb/ref 17592186263640} {:answer/id #uuid "4c2e3754-505f-53b9-8c1e-df9937e78a3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sec}^{2}⁡t\\,i+(2t\\operatorname{ln}⁡t+t)\\,k" :db/id #edb/ref 17592186263660} {:answer/id #uuid "54c68558-3e6b-5638-ab8a-a14258febd7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{csc}^{2}⁡x" :db/id #edb/ref 17592186263728} {:answer/id #uuid "60e83ae7-a36d-5e21-acbd-47e10763906d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (0,\\pi /4)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A+{∬}_{(0,\\pi )\\times (\\pi /4,\\pi /2)}y\\operatorname{cos}⁡x\\