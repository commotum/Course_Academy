1}{\\sqrt{7}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{7}{|x|\\sqrt{7{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{7\\sqrt{7}}{|\\sqrt{7}x|\\sqrt{(\\sqrt{7}x)^{2}-1}}\\,\\text{d}x \\\\  & =7\\sqrt{7}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{7}}\\text{d}u) \\\\  & =7\\sqrt{7}\\cdot \\frac{1}{\\sqrt{7}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =7\\,\\text{arcsec }u+C \\\\  & =7\\,\\text{arcsec}(\\sqrt{7}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06349d8e-8391-574b-b6ee-d09717af159e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\sqrt{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186247480} {:answer/id #uuid "28b08c9d-77c7-5bea-8de3-24e47c4a6b22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186247786} {:answer/id #uuid "4b4c8ae4-b8b1-5ed2-b232-73c90f37ed26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186248097} {:answer/id #uuid "97ffb8aa-ac92-5db2-a3d4-4a6b34576f59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{8}}{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248778} {:answer/id #uuid "b9b1dd01-2ffe-53eb-9456-1dfad676593b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{arcsec}\\left(\\frac{x}{\\sqrt{8}}\\right)+C" :db/id #edb/ref 17592186249084}] :answer-field/correct {:db/id #edb/ref 17592186247786} :answer-field/id #uuid "f124bfeb-924c-5974-b5d6-5bac9d8b7458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250090}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d978df6a-8484-5ed1-885e-b4758185514d" :question/math-academy-id "q-114056" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\text{d}x=\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{8}x.$\n\nSo, let's substitute $u=\\sqrt{8}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{8}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{8}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\,\\text{d}x \\\\  & =8\\sqrt{8}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{8}}\\text{d}u) \\\\  & =8\\sqrt{8}\\cdot \\frac{1}{\\sqrt{8}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =8\\,\\text{arcsec }u+C \\\\  & =8\\,\\text{arcsec}(\\sqrt{8}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20eeed43-06fc-5a51-a569-cc359295eeb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(50x)+C" :db/id #edb/ref 17592186247713} {:answer/id #uuid "23a4faf6-7048-5692-877b-730a3aa48b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(10x)+C" :db/id #edb/ref 17592186247737} {:answer/id #uuid "860a98b5-c89e-5a98-a319-70c942ace928" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\,\\text{arcsec}(10x)+C" :db/id #edb/ref 17592186248619} {:answer/id #uuid "c1ea824c-8f8e-5257-ae08-86f03dfd7210" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,\\text{arcsec}(10x)+C" :db/id #edb/ref 17592186249149} {:answer/id #uuid "d7024181-5209-53f4-9e77-1d70e6a37869" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186249324}] :answer-field/correct {:db/id #edb/ref 17592186249149} :answer-field/id #uuid "1249c5e2-b95a-56a8-9562-7cfa27416496" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249702}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1386e5e4-c2d1-50fc-ab2e-40d086cf4081" :question/math-academy-id "q-114057" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\text{d}x=\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $10x.$\n\nSo, let's substitute $u=10x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10\\,⟹\\,\\text{d}x=\\frac{1}{10}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\,\\text{d}x \\\\  & =50\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{10}\\text{d}u) \\\\  & =50\\cdot \\frac{1}{10}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =5\\,\\text{arcsec }u+C \\\\  & =5\\,\\text{arcsec}(10x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15af9c4d-6b3b-599c-9211-07f95e750f61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{arcsec} x+C" :db/id #edb/ref 17592186247619} {