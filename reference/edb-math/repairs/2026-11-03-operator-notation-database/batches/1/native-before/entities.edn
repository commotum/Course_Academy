field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186187026}] :question/id #uuid "62fb930e-2f28-571d-9c9f-e9c6e3be11c3" :question/math-academy-id "q-148182" :question/problem "Consider two random variables $X$ and $Y$ with expectations $E[X] = 6$, $E[Y] = 5$, mixed moment $E[XY] = 32$, and variances $Var[X] = 4$ and $Var[Y] = 3$. Find the covariance matrix for $X$ and $Y$."} {:db/id #edb/ref 17592186188881 :question/answer-fields [{:answer-field/id #uuid "759c1274-8d85-576c-b617-fa9874b86f0c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186187426}] :question/id #uuid "8c6abe86-696b-577e-94a0-120defba964f" :question/math-academy-id "q-210374" :question/problem "$0.4h =$ {{field-1}} $min$\n\n> A calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186188882 :question/answer-fields [{:answer-field/id #uuid "9ad1673a-4b0a-5fd5-b8aa-d1b6835dc807" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186187427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33c79919-4a60-577d-91a2-3a232d6dae9a" :question/math-academy-id "q-210376" :question/problem "$4200s =$ {{field-1}} $min$\n\n> A calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186188920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c43560-d323-57f5-a800-ae331e44d866" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "300min" :db/id #edb/ref 17592186187597} {:answer/id #uuid "f0c4e8b9-36d7-5b5f-9f7d-9e231f77c00f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "540min" :db/id #edb/ref 17592186187598} {:answer/id #uuid "f6af11b7-6645-579d-aa26-b03479c9864b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1080min" :db/id #edb/ref 17592186187599} {:answer/id #uuid "0113cc0b-7990-5