c3f-f3a6d716a608" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249689}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "08d0f1cc-d4ff-5f13-b460-2feb29c2a12c" :question/math-academy-id "q-113944" :question/problem "$$\n\\displaystyle \\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =\\int {sec}^{2}⁡x\\,\\text{d}x-2\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x-2(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06250698-b13e-582c-ab47-f2d9aeeef595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{csc}\\theta \\operatorname{cot}\\theta +C" :db/id #edb/ref 17592186247479} {:answer/id #uuid "3f2e6923-03da-5825-bf9a-5c6badb63c5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sec}\\theta \\operatorname{tan}\\theta +C" :db/id #edb/ref 17592186247982} {:answer/id #uuid "6da7f9f1-b8f9-516b-89dc-ff9a7ca64823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{cot}\\theta +C" :db/id #edb/ref 17592186248396} {:answer/id #uuid "ae4ad190-1c95-556f-9537-4266117170f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{tan}\\theta +C" :db/id #edb/ref 17592186248982} {:answer/id #uuid "c997db75-c57f-5a92-8164-7c5ab30df6f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cot}\\theta +C" :db/id #edb/ref 17592186249217}] :answer-field/correct {:db/id #edb/ref 17592186248396} :answer-field/id #uuid "9af25303-4d1e-529c-932b-6b3643d5d3d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f660826-f465-5ee2-b41b-5a557d761074" :question/math-academy-id "q-113947" :question/problem "$$\n\\displaystyle \\int 5{csc}^{2}⁡\\theta \\,\\text{d}\\theta =\n$$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡\\theta \\,\\text{d}\\theta =-cot⁡\\theta +C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5{csc}^{2}⁡\\theta \\,\\text{d}\\theta  & =5\\int {csc}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =5(-cot⁡\\theta )+C \\\\  & =-5cot⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33da3ed1-1777-5bf4-8cfc-9e5a29ccb4c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{tan}^{3}⁡x}{3}+\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186247891} {:answer/id #uuid "62494273-c0c0-5f7f-8ebb-533f7f201a63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{sec}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186248310} {:answer/id #uuid "89765658-5c5b-5edc-a80e-0d5330eacbc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186248646} {:answer/id #uuid "8df579a6-b4b7-59be-810b-4b8fd64e8efe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{sec}^{3}⁡x}{3}+C" :db/id #edb/ref 17592186248688} {:answer/id #uuid "ce4aa2aa-cecd-5b62-ae9a-109027768536" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{tan}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186249252}] :answer-field/correct {:db/id #edb/ref 17592186248646} :answer-field/id #uuid "812aa8aa-0438-595b-bab8-2d74de8d3b64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249894}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9801153f-b480-580e-a696-7b55c194e174" :question/math-academy-id "q-113983" :question/problem "Calculate the integral $$\n\\displaystyle \\int ({sec}^{2}⁡x+1)\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=\\operatorname{sec}⁡x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,⟹\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int ({sec}^{2}⁡x+1)\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\int ({u}^{2}+1)\\,\\text{d}u \\\\  & =\\frac{{u}^{3}}{3}+u+C \\\\  & =\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254254b3-d4a0-54c9-ac1e-ee05acbabc64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}⁡x+C" :db/id #edb/ref 17592186247752} {:answer/id #uuid "44cdb3aa-54aa-5e3d-91cc-188c8ad81e29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248039} {:answer/id #uuid "47d6d603-3f64-5f3d-9792-34e35a52deb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248064} {:answer/id #uuid "54647379-fd57-5c64-be8d-ab2381cdcfe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248182} {:answer/id #uuid "a149b29b-935e-5e8f-910f-3a39f1539f77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248865}] :answer-field/correct {:db/id #edb/ref 17592186248039} :answer-field/id #uuid "7570be9b-8fa8-53ff-853e-6ff96a771057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249870}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c740bb4-ff2e-5c3c-8f3d-5a68fa36c853" :question/math-academy-id "q-114020" :question/problem "$$\n\\displaystyle \\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "225507dc-148f-5a6f-94ae-b671ee8c43a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186247730} {:answer/id #uuid "a28decf6-e50f-5cd8-a481-bb4b6ce53e6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186248876} {:answer/id #uuid "f0a219d2-19b3-55a0-a684-551ff9a54e4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}⁡x+C" :db/id #edb/ref 17592186249538} {:answer/id #uuid "fa1f8080-6e0f-5732-9038-7a2a1a9a5eb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186249602} {:answer/id #uuid "fc2c6263-1e0a-5c90-9099-9c9495d07821" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡7\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186249620}] :answer-field/correct {:db/id #edb/ref 17592186247730} :answer-field/id #uuid "26ddcb54-192a-55af-8766-39fbf5ecde77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249743}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1cd00feb-cfab-542a-aa56-7db9c40f1132" :question/math-academy-id "q-114021" :question/problem "$$\n\\displaystyle \\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={log}_{7}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{7}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2557c8c9-61d4-546a-b12e-2149e3cb0784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247753} {:answer/id #uuid "4b9ffc95-a0ae-5868-bc4f-b4a2ff82ae20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186248100} {:answer/id #uuid "90d77fc7-cc8f-513f-84a7-ae393b51759b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,\\text{arcsec}(5x)+C" :db/id #edb/ref 17592186248710} {:answer/id #uuid "da3de159-0af1-5109-a432-7a259afa945f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186249353} {:answer/id #uuid "f5ce8cb5-8424-5bdb-b48e-afc1856f992f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(5x)+C" :db/id #edb/ref 17592186249568}] :answer-field/correct {:db/id #edb/ref 17592186247753} :answer-field/id #uuid "5bb9394d-1677-5845-bcf1-c7fd75b784b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249835}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "721577ab-4fa8-5463-8c74-5d6cebd1decf" :question/math-academy-id "q-114051" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{5{x}^{2}-1}}=\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{5}x.$\n\nSo, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{5}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\sqrt{5}\\cdot \\frac{1}{\\sqrt{5}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d1c680b-da3e-532e-b768-23a73eed1830" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248115} {:answer/id #uuid "76b64e00-cc9d-56bb-96a5-6ed308000d0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}\\left(\\frac{x}{\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186248469} {:answer/id #uuid "81a2d087-34bd-5b98-b3f9-540414b7de9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248571} {:answer/id #uuid "a16a9266-9795-55dc-8015-252092435b4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\,\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248867} {:answer/id #uuid "f738a875-32bb-5a84-9c85-9b96cb51105b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249583}] :answer-field/correct {:db/id #edb/ref 17592186248571} :answer-field/id #uuid "1add6643-9b56-5600-a0e9-cb809f1a9078" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249716}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "087bd91d-1f6c-594e-8ca6-46ed6f38b1d4" :question/math-academy-id "q-114052" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{|x|\\sqrt{2{x}^{2}-1}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{2{x}^{2}-1}}=\\int \\frac{\\sqrt{2}}{|\\sqrt{2}x|\\sqrt{(\\sqrt{2}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{2}x.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{2{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{2}}{|\\sqrt{2}x|\\sqrt{(\\sqrt{2}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{2}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\sqrt{2}\\cdot \\frac{1}{\\sqrt{2}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f7223b-3eec-5940-8deb-7bc6e19cac0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}\\left(\\frac{x}{\\sqrt{3}}\\right)+C" :db/id #edb/ref 17592186247868} {:answer/id #uuid "3d76b2e3-b64f-5ff7-9e80-9f8479c9c899" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247967} {:answer/id #uuid "9bd42595-09d2-528a-bd27-8cbc87ecbf1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248810} {:answer/id #uuid "def281e2-ae26-5545-95a5-a8332aa49347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(3x)+C" :db/id #edb/ref 17592186249402} {:answer/id #uuid "f9f3a636-5c31-5b0d-9342-5cf8e8d5dd79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186249601}] :answer-field/correct {:db/id #edb/ref 17592186247967} :answer-field/id #uuid "ad6f5e31-fa19-5c0b-8277-0506de476581" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249977}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c9656774-7502-5500