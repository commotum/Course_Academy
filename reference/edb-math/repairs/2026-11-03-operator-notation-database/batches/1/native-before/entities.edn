e-90e8-b700b7b53c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2ln⁡(2)+1" :db/id #edb/ref 17592186246497} {:answer/id #uuid "faecbb4c-e0f8-59a8-a3d7-92a5f5e02711" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2ln⁡(2)" :db/id #edb/ref 17592186246516} {:answer/id #uuid "fd2c8e48-3c4f-5a64-a23d-41f839aecaea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{cos}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{3})}{6{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186246526} {:db/id #edb/ref 17592186247077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238d9c4f-3b25-52f7-9f82-80add2605c70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{cos}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sin}⁡({[{f}^{-1}(x)]}^{3})}{12{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186244627} {:answer/id #uuid "45d4690b-f1b7-5498-99ce-2f3f214b7989" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{csc}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{3})}{12{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186244933} {:answer/id #uuid "846eab57-f58b-5ce0-8970-0cb2f1cf9705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{sec}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{csc}⁡({[{f}^{-1}(x)]}^{3})}{6{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186245481} {:answer/id #uuid "bc6e794c-f47a-548e-968f-7fce93502fff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{sin}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{3})}{3{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186245995} {:answer/id #uuid "fd2c8e48-3c4f-5a64-a23d-41f839aecaea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{cos}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{3})}{6{[{f}^{-1}(x)]}^{2}}" :db/id #edb/ref 17592186246526}] :answer-field/correct {:db/id #edb/ref 17592186244933} :answer-field/id #uuid "7625ff93-3a38-537c-b33c-8d65fc8c4d27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246751}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "26ecaa15-7fc1-5f17-ad1a-3b24d506c8ff" :question/math-academy-id "q-110048" :question/problem "If $f(x)={sin}^{4}⁡({x}^{3}),$ find ${({f}^{-1})}^{′}(x)$ as a function of ${f}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y={sin}^{4}⁡({x}^{3}),$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx={sin}^{4}⁡({y}^{3})\n$$\n\nNote that in the equation above, we have $y={f}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({sin}^{4}⁡({y}^{3})) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =4{sin}^{3}⁡({y}^{3})\\cdot \\operatorname{cos}⁡({y}^{3})\\cdot 3{y}^{2} \\\\ \\frac{\\text{d}x}{\\text{d}y} & =12{y}^{2}{sin}^{3}⁡({y}^{3})\\operatorname{cos}⁡({y}^{3}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{12{y}^{2}{sin}^{3}⁡({y}^{3})\\operatorname{cos}⁡({y}^{3})} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{{csc}^{3}⁡({y}^{3})\\operatorname{sec}⁡({y}^{3})}{12{y}^{2}}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & =\\frac{{csc}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{3})}{12{[{f}^{-1}(x)]}^{2}} \\\\ {({f}^{-1})}^{′}(x) & =\\frac{{csc}^{3}⁡({[{f}^{-1}(x)]}^{3})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{3})}{12{[{f}^{-1}(x)]}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a28cfe-f7a8-55f5-bb93-c844116543a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20{arcsin}^{4}⁡(4x)}{\\sqrt{1-16{x}^{2}}}" :db/id #edb/ref 17592186244339} {:answer/id #uuid "0683cfd6-324d-52be-947a-7be93342bf67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20{arcsin}^{2}⁡(4x)}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186244366} {:answer/id #uuid "291c3195-b924-5096-97d2-58aff463eca1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{arcsin}^{4}⁡(4x)}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186244673} {:answer/id #uuid "b5a54dab-caaa-553b-9647-43174130eae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{arcsin}^{4}⁡(4x)}{\\sqrt{1-16{x}^{2}}}" :db/id #edb/ref 17592186245935} {:answer/id #uuid "d6879f05-71a5-5633-8a4f-48f033e53739" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{arcsin}^{4}⁡(2x)}{\\sqrt{1-16{x}^{2}}}" :db/id #edb/ref 17592186246224}] :answer-field/correct {:db/id #edb/ref 17592186244339} :answer-field/id #uuid "d727648e-a912-5fe9-a1d6-60b82c8cbc64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246931}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e5fed501-0318-5ebc-ac8a-b3dabb60d87f" :question/math-academy-id "q-110049" :question/problem "Find ${f}^{′}(x)$ for $f(x)={arcsin}^{5}⁡(4x).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[{arcsin}^{5}⁡(4x)] \\\\  & =5{arcsin}^{4}⁡(4x)\\cdot \\frac{\\text{d}}{\\text{d}x}[\\operatorname{arcsin}⁡(4x)] \\\\  & =5{arcsin}^{4}⁡(4x)\\cdot [\\frac{1}{\\sqrt{1-(4x)^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(4x)] \\\\  & =5{arcsin}^{4}⁡(4x)\\cdot [\\frac{1}{\\sqrt{1-(4x)^{2}}}\\cdot 4] \\\\  & =5{arcsin}^{4}⁡(4x)\\cdot \\frac{4}{\\sqrt{1-16{x}^{2}}} \\\\  & =\\frac{20{arcsin}^{4}⁡(4x)}{\\sqrt{1-16{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248c560a-5504-5344-ba06-31ff881f4228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ln⁡(2)-1" :db/id #edb/ref 17592186244640} {:answer/id #uuid "453ad4e8-fc91-5dc6-a9a5-3321c0d9dc49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ln⁡(2)+1" :db/id #edb/ref 17592186244926} {:answer/id #uuid "a51377ae-5388-50fe-83c3-7ef69418daf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186245796} {:answer/id #uuid "f8312b64-ab69-53ae-90e8-b700b7b53c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2ln⁡(2)+1" :db/id #edb/ref 17592186246497} {:answer/id #uuid "faecbb4c-e0f8-59a8-a3d7-92a5f5e02711" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2ln⁡(2)" :db/id #edb/ref 17592186246516}] :answer-field/correct {:db/id #edb/ref 17592186245796} :answer-field/id #uuid "8a081fae-877e-5e2e-acae-a2b3a4e290d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246787}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "48d44085-8aaf-5ed5-9d45-53625f178071" :question/math-academy-id "q-110536" :question/problem "Given that ${e}^{y+1}-1=3,$ then $y=$" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{y+1}-1 & =3 \\\\ {e}^{y+1} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{y+1} & =4 \\\\ ln⁡({e}^{y+1}) & =ln⁡(4) \\\\ y+1 & =2ln⁡(2) \\\\ y & =2ln⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=2ln⁡(2)-1.$"} {:db/id #edb/ref 17592186247162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "422f2f7f-75d3-5282-804c-01dae36541e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\operatorname{arctan}⁡(5x)}{{x}^{2}(25{x}^{2}+1)}-\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/id #edb/ref 17592186244893} {:answer/id #uuid "4f37590a-6a26-50d7-a8ac-951edce8ec7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25\\operatorname{arctan}⁡(5x)}{{x}^{2}(10{x}^{2}+1)}-\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/id #edb/ref 17592186245019} {:answer/id #uuid "95b2d703-4580-5275-8001-1c4f67454578" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\operatorname{arctan}⁡(x)}{{x}^{2}(5{x}^{2}+1)}-\\frac{1}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/id #edb/ref 17592186245624} {:answer/id #uuid "9e09149e-c759-5d6e-9395-a7746269d35f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{{x}^{2}(25{x}^{2}+1)}+\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/id #edb/ref 17592186245722} {:answer/id #uuid "de0af789-5b34-5b2c-8cdf-f12d3ad45e18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{10{x}^{2}(25{x}^{2}+1)}+\\frac{1}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/id #edb/ref 17592186246279}] :answer-field/correct {:db/id #edb/ref 17592186244893} :answer-field/id #uuid "343ec2e3-488a-540f-9600-6b9c97dfec87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246636}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3d2a50a9-fa10-517c-8b03-bc1008dc69c1" :question/math-academy-id "q-110769" :question/problem "Find ${f}^{′}(x)$ if  $f(x)=\\frac{{arctan}^{2}⁡(5x)}{{x}^{2}}.$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[\\frac{{arctan}^{2}⁡(5x)}{{x}^{2}}] \\\\  & =\\frac{{x}^{2}\\cdot 2\\cdot \\operatorname{arctan}⁡(5x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(5x))-(2x){arctan}^{2}⁡(5x)}{{x}^{4}} \\\\  & =\\frac{2{x}^{2}\\cdot \\operatorname{arctan}⁡(5x)\\cdot \\frac{5}{1+(5x)^{2}}-(2x){arctan}^{2}⁡(5x)}{{x}^{4}} \\\\  & =\\frac{10\\operatorname{arctan}⁡(5x)}{{x}^{2}(25{x}^{2}+1)}-\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "083c51fc-aa18-56dc-b3c0-124a775f8946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186244378} {:answer/id #uuid "675427f6-ac1f-521a-b7bc-59f1e3b0b6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186245221} {:answer/id #uuid "714d2134-55a2-57cb-8d39-8bf99301077a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186245324} {:answer/id #uuid "98716022-d6bf-54d3-874d-c54fc12b52e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186245665} {:answer/id #uuid "ba1eb9d4-e845-50fa-86d1-d1a588f1aaf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186245976}] :answer-field/correct {:db/id #edb/ref 17592186244378} :answer-field/id #uuid "ae9c6475-f39e-5cd6-88f8-b618ffddc3b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246865}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "800aa4d6-ad4a-5a10-9d04-aca005ce255a" :question/math-academy-id "q-110986" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\left\\{\\begin{aligned}\\frac{c}{yx\\operatorname{ln}⁡y},\\, & 1\\le x\\le e,\\,e\\le y\\le {e}^{x}, \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\\right.\n$$\n\n \nwhere $c$ is a positive real number. Find the value of $c.$" :question/worked-solution "To verify that $f(x,y)$ is a valid joint probability density function, we must check the following conditions:\n\n- $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}$\n\n- $$\n\\displaystyle {∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y=1\n$$\n\nFirst, let's sketch the region $D=\\{(x,y)\\,:\\,1\\le x\\le e,\\,e\\le y\\le {e}^{x}\\}.$\n\n![](images/26/268e469b0306d22e6b6dc05905a9d56a1cabd4b0e405f741ff458ca241440d4a.png)\n\nNow, let's check our conditions:\n\n- Since $c>0,$ we clearly have $f(x,y)\\ge 0$ for all $(x,y)\\in {R}^{2}.$ So the first condition is satisfied.\n\n- For the second condition to be satisfied, we must have \n\n$$\n{\\int }_{1}^{e}{\\int }_{e}^{{e}^{x}}\\frac{c}{yx\\operatorname{ln}⁡y}\\,dy\\,dx=1.\n$$\n\n$$\n{∬}_{{R}^{2}}f(x,y)\\,\\text{d}x\\text{d}y={∬}_{D}f(x,y)\\,\\text{d}x\\text{d}y={\\int }_{1}^{e}{\\int }_{e}^{{e}^{x}}\\frac{c}{yx\\operatorname{ln}⁡y}\\,\\text{d}y\\,\\text{d}x=1.\n$$\n\nWe evaluate the inner integral by integrating with respect to $y$, treating  $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{\\int }_{e}^{{e}^{x}}\\frac{c}{yx\\operatorname{ln}⁡y}\\,dy\\,dx & ={\\int }_{1}^{e}\\frac{c}{x}[{\\int }_{e}^{{e}^{x}}\\frac{1}{y\\operatorname{ln}⁡y}\\,dy]\\,dx \\\\  & ={\\int }_{1}^{e}\\frac{c}{x}[\\operatorname{ln}⁡(\\operatorname{ln}⁡y)]_{y=e}^{y={e}^{x}}\\,dx \\\\  & ={\\int }_{1}^{e}\\frac{c}{x}(\\operatorname{ln}⁡(\\operatorname{ln}⁡{e}^{x})-\\operatorname{ln}⁡(\\operatorname{ln}⁡e))\\,dx \\\\  & ={\\int }_{1}^{e}\\frac{c\\operatorname{ln}⁡x}{x}dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x$:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{c\\operatorname{ln}⁡x}{x}dx & ={[\\frac{c{ln}^{2}⁡x}{2}]}_{1}^{e} \\\\  & =\\frac{c{ln}^{2}⁡e}{2}-\\frac{c{ln}^{2}⁡1}{2} \\\\  & =\\frac{c}{2}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{c}{2}=1\\,⇒\\,c=2.\n$$"} {:db/id #edb/ref 17592186247271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11c08573-7da9-5f3b-b9fd-fec195d31103" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186244476} {:answer/id #uuid "5e335c01-3ed8-5339-b6f5-9c86715a3d81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186245144} {:answer/id #uuid "6f39158b-343b-54a4-a58f-8a9e22e04844" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186245302} {:answer/id #uuid "c064ccfa-827e-55c6-a74d-6e5ef1a1740b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186246025} {:answer/id #uuid "df6f14c9-ab93-5ac1-93d6-e9ba23b53626" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186246294}] :answer-field/correct {:db/id #edb/ref 17592186245144} :answer-field/id #uuid "a63e8c62-de50-5a10-9a1b-bd6b42fee004" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246845}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c42da78-9ea0-51ad-8c5a-339fd62f507f" :question/math-academy-id "q-112460" :question/problem "Find a Jordan canonical form of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}6 & 2 \\\\ -6 & -1\\end{bmatrix}.\n$$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}6-\\lambda  & 2 \\\\ -6 & -1-\\lambda \\end{vmatrix} & =0 \\\\ (6-\\lambda )(-1-\\lambda )-(2)(-6) & =0 \\\\ {\\lambda }^{2}-5\\lambda +6 & =0 \\\\ (\\lambda -2)(\\lambda -3) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(2)\\,⊕\\,{J}_{1}(3)=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186247274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab2a49f-5115-530e-97c3-1b1bb0541d2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186244552} {:answer/id #uuid "4ced7594-eb63-5e90-9cf7-7baeb83b3729" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186245001} {:answer/id #uuid "7ac018fe-3210-5652-b55e-eb8117548410" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186245393} {:answer/id #uuid "b5b336b3-dbea-55da-80a0-114a1a68cecd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186245936} {:answer/id #uuid "e35b19a2-2f4b-52ee-b008-052e29d4a93d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186246335}] :answer-field/correct {:db/id #edb/ref 17592186245001} :answer-field/id #uuid "286183bc-8aa8-534a-92ac-02a1b45c3832" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246612}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c65cf82a-f166-50d6-aa2c-093e0ec14d49" :question/math-academy-id "q-112475" :question/problem "Find the Jordan canonical form of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}-6 & -1 \\\\ 4 & -2\\end{bmatrix}.\n$$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}-6-\\lambda  & -1 \\\\ 4 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (-6-\\lambda )(-2-\\lambda )-(-1)\\cdot (4) & =0 \\\\ {\\lambda }^{2}+8\\lambda +16 & =0 \\\\ (\\lambda +4)(\\lambda +4) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-4.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(-4)=\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186247275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c28e38d-7d43-572e-8dc8-5806d62baaac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186244562} {:answer/id #uuid "275ac931-c96a-52b5-8682-783dafe0f416" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 & 0 \\\\ 0 & -5\\end{bmatrix}" :db/id #edb/ref 17592186244659} {:answer/id #uuid "548831ab-b257-5bee-b421-94ce89aa4000" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186245057} {:answer/id #uuid "caa17224-d62e-5023-b707-37ece540c3e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 & 1 \\\\ 0 & -5\\end{bmatrix}" :db/id #edb/ref 17592186246114} {:answer/id #uuid "d38db0a4-5c87-584e-b1e2-36d827004b02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186246196}] :answer-field/correct {:db/id #edb/ref 17592186246114} :answer-field/id #uuid "7038d961-4d3a-56af-af77-85a896477007" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246744}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "615d8439-9397-5820-a816-1931afbd87cd" :question/math-academy-id "q-112477" :question/problem "Find the Jordan canonical form of the matrix \n$$\n\\displaystyle A=\\begin{bmatrix}-12 & -7 \\\\ 7 & 2\\end{bmatrix}.\n$$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}-12-\\lambda  & -7 \\\\ 7 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (-12-\\lambda )(2-\\lambda )-(-7)\\cdot 7 & =0 \\\\ {\\lambda }^{2}+10\\lambda +25 & =0 \\\\ (\\lambda +5)(\\lambda +5) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-5.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(-5)=\\begin{bmatrix}-5 & 1 \\\\ 0 & -5\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186247282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f1c6b98-25f8-5e4b-b169-c98a156923ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$162$ cars per day" :db/id #edb/ref 17592186245016} {:answer/id #uuid "779d5d52-77eb-5021-9fdb-6949a0551730" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$140$ cars per day" :db/id #edb/ref 17592186245373} {:answer/id #uuid "811be8e1-8e6b-5190-8d78-5e4b9cd0b31b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$125$ cars per day" :db/id #edb/ref 17592186245455} {:answer/id #uuid "c45a009c-113a-5c51-b8a5-aee9dd3c26fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$100$ cars per day" :db/id #edb/ref 17592186246059} {:answer/id #uuid "e07a4990-5522-544f-8f86-dacc8fa566a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$120$ cars per day" :db/id #edb/ref 17592186246309}] :answer-field/correct {:db/id #edb/ref 17592186246309} :answer-field/id #uuid "78d8582c-8f74-5c8e-a7a1-5a0e9065a5b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246756}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b547e5e1-1e78-5d71-9ff5-a1728add6182" :question/math-academy-id "q-112507" :question/problem "The rate $O$ of the orders a car factory receives can be modeled as $O(t)=100t{e}^{-0.1t}$ cars per day. The rate at which cars are completed can be modeled as $C(t)=50+10sin⁡(\\frac{2\\pi }{7}t)$ cars per day. In both cases, $t$ is the time, in days, since the launch of the new model. \n\nWhat is the rate of change in the number of cars under construction $28$ days after the model's launch? Assume that an ordered car goes into construction as soon as the factory receives its order. Round your answer to the nearest integer." :question/worked-solution "The rate of change of the number of cars under construction at time $t$ is equal to the order rate minus the completion rate, that is,\n\n$$\nO(t)-C(t).\n$$\n\nSubstituting $t=28,$ the rate of change in the number of cars under construction after $28$ days is\n\n$$\n\\begin{aligned}O(t)-C(t) & =100(28){e}^{-0.1(28)}-(50+10sin⁡(\\frac{2\\pi }{7}(28))) \\\\  & =100(28){e}^{-2.8}-50-10sin⁡(8\\pi ) \\\\  & =100(28){e}^{-2.8}-50 \\\\  & ≈120.\\end{aligned}\n$$\n\nTherefore, the rate of change in the number of cars in construction after $28$ days is $120$ cars per day."} {:db/id #edb/ref 17592186247316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4801d5b1-c06b-5cf5-85ac-ea3f71bdd759" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}\\operatorname{sin}⁡(x+1.341)" :db/id #edb/ref 17592186244957} {:answer/id #uuid "69073a06-ab72-5519-8fcd-467180601ff8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}\\operatorname{sin}⁡(x+0.415)" :db/id #edb/ref 17592186245243} {:answer/id #uuid "d4230ea9-cdef-5577-b0ab-7115a04b37b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}\\operatorname{sin}⁡(x+0.983)" :db/id #edb/ref 17592186246205} {:answer/id #uuid "e31b3950-17ba-51f5-a265-0d0e792eb023" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}\\operatorname{sin}⁡(x+0.983)" :db/id #edb/ref 17592186246331} {:answer/id #uuid "f6a62187-5079-5666-ab6a-144a2737194f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}\\operatorname{sin}⁡(x+0.983)" :db/id #edb/ref 17592186246490}] :answer-field/correct {:db/id #edb/ref 17592186246490} :answer-field/id #uuid "d348fa83-f28d-50c2-bce4-37a177a537c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246922}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "abf2a161-03cb-55e0-99c1-1308ac08b447" :question/math-academy-id "q-11290" :question/problem "$2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(x)+3\\operatorname{cos}⁡(x) & =(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=2 \\\\ R\\operatorname{sin}⁡ϕ &=3\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{3}{2} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{3}{2} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{3}{2}\\right) \\\\ ϕ & ≈0.983\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{R}^{2}{sin}^{2}⁡(ϕ)+{R}^{2}{cos}^{2}⁡(ϕ) & ={3}^{2}+{2}^{2} \\\\ {R}^{2}({sin}^{2}⁡(ϕ)+{cos}^{2}⁡(ϕ)) & =9+4 \\\\ {R}^{2} & =13 \\\\ R & =\\sqrt{13}\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n2\\operatorname{sin}⁡(x)+3\\operatorname{cos}⁡(x)≈\\sqrt{13}\\operatorname{sin}⁡(x+0.983)\n$$"} {:db/id #edb/ref 17592186247317 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117a3a93-2c6f-5984-a73e-6e70f74e0439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{14}\\operatorname{sin}⁡(x+0.689)" :db/id #edb/ref 17592186244474} {:answer/id #uuid "4c712478-7af6-56f8-bf2f-bd290e111a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{20}\\operatorname{sin}⁡(x+0.896)" :db/id #edb/ref 17592186244995} {:answer/id #uuid "6964ca93-45e6-5c9c-9926-9f1497e7956d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{40}\\operatorname{sin}⁡(x+0.968)" :db/id #edb/ref 17592186245245} {:answer/id #uuid "b39823b0-0f28-5faa-8995-775d1029fe5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{41}\\operatorname{sin}⁡(x+0.103)" :db/id #edb/ref 17592186245913} {:answer/id #uuid "bc0fffc8-c949-5190-b233-f837986a0977" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{41}\\operatorname{sin}⁡(x+0.896)" :db/id #edb/ref 17592186245991}] :answer-field/correct {:db/id #edb/ref 17592186245991} :answer-field/id #uuid "8a81d9d9-b251-53c7-b0fa-61a5d58449bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246789}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ba7d09f7-efa8-5411-b860-5a937a2a4958" :question/math-academy-id "q-11291" :question/problem "$4\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=4 \\\\ R\\operatorname{sin}⁡ϕ &=5\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{5}{4} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{5}{4} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{5}{4}\\right) \\\\  & ≈0.896\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{R}^{2}{sin}^{2}⁡ϕ+{R}^{2}{cos}^{2}⁡ϕ & ={5}^{2}+{4}^{2} \\\\ {R}^{2}({sin}^{2}⁡ϕ+{cos}^{2}⁡ϕ) & =25+16 \\\\ {R}^{2} & =41 \\\\ R & =\\sqrt{41}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$ \n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n \n\n$$\n4\\operatorname{sin}⁡x+5\\operatorname{cos}⁡x≈\\sqrt{41}\\operatorname{sin}⁡(x+0.896)\n$$"} {:answer/id #uuid "001d516e-ba06-5b95-b4a6-f35dab9a3672" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\text{arcsec}(x+4)+C" :db/id #edb/ref 17592186247415} {:answer/id #uuid "00c4a36b-1ea2-5c73-8a8e-897727eb8f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{6}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186247419} {:answer/id #uuid "01c50259-96ff-5091-b6d8-d010aabcd87a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{e}^{2}-3}{4{ln}^{2}⁡2}" :db/id #edb/ref 17592186247435} {:answer/id #uuid "0251f12b-0bcd-5543-9eb5-f4ec7e4c9752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}{sec}^{3}⁡x+C" :db/id #edb/ref 17592186247439} {:answer/id #uuid "0558a391-cdbf-584c-a0f0-8f221f341cae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06349d8e-8391-574b-b6ee-d09717af159e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\sqrt{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186247480} {:answer/id #uuid "069e5dc3-903f-56c3-80b2-a36d93cb6a14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{arcsec}(x-2)+C" :db/id #edb/ref 17592186247483} {:answer/id #uuid "06b51ddf-dec0-5572-8ab9-d7d1e668270f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>2-{log}_{6}⁡3" :db/id #edb/ref 17592186247485} {:answer/id #uuid "0ba2385b-5f1b-5244-83c1-b965a5b9ded8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{cos}^{2}⁡x+x+C" :db/id #edb/ref 17592186247525} {:answer/id #uuid "0f54fcd2-11eb-5de2-b3f7-146de7b6348a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{({log}_{4}⁡x)}^{2}+2{log}_{4}⁡(x)+C" :db/id #ed