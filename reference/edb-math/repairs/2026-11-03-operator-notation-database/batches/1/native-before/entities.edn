{9}^{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{9}^{x}}{ln⁡9}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fd8908-86c1-5758-81a1-2ec277f68aa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\left(\\frac{1}{8}\\right)}^{x}ln⁡8+C" :db/id #edb/ref 17592186247614} {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} {:answer/id #uuid "5253b616-1982-56f6-8a9e-7ac1838f5f20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/id #edb/ref 17592186248162} {:answer/id #uuid "57f12027-6306-5a43-b276-eb500592f0a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/id #edb/ref 17592186248222} {:answer/id #uuid "7f8980f3-ea7f-50a6-9c9c-7812ebfc0549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186248544}] :answer-field/correct {:db/id #edb/ref 17592186247681} :answer-field/id #uuid "8d70d61a-ae6a-57e0-bc6d-72a634f609db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249920}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "89cd3b1f-2f20-5813-8f46-6c4d05bd7fcb" :question/math-academy-id "q-113893" :question/problem "Calculate $$\n\\displaystyle \\int {\\left(\\frac{1}{8}\\right)}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {\\left(\\frac{1}{8}\\right)}^{x}\\,\\text{d}x & =\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡\\left(\\frac{1}{8}\\right)}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡\\left(\\frac{1}{8}\\right) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡\\left(\\frac{1}{8}\\right)}+C=-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271c490c-5a05-5e0a-9c8e-cee6e93cd8b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6}\\operatorname{cos}\\theta +C" :db/id #edb/ref 17592186247771} {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{cos}\\theta +C" :db/id #edb/ref 17592186247936} {:answer/id #uuid "8369302d-e75e-5f17-a44e-47eda2ef57fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\operatorname{sin}\\theta +C" :db/id #edb/ref 17592186248585} {:answer/id #uuid "8f10e1a5-527b-5f97-860b-39eca916d8f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{sin}\\theta +C" :db/id #edb/ref 17592186248696} {:answer/id #uuid "a8b91066-0304-5eec-9198-3b7d46a0b0c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\operatorname{cos}\\theta +C" :db/id #edb/ref 17592186248923}] :answer-field/correct {:db/id #edb/ref 17592186247936} :answer-field/id #uuid "d679155c-4e3c-59a8-a851-7bdacacd637d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250043}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4099e9a0-92e6-5376-9bf3-b36d248db1d1" :question/math-academy-id "q-113907" :question/problem "$$\n\\displaystyle \\int (-6sin⁡\\theta )\\,\\text{d}\\theta =\n$$" :question/worked-solution "Recall that\n\n$$\n\\int sin⁡\\theta \\,\\text{d}\\theta =-cos⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-6sin⁡\\theta )\\,\\text{d}\\theta  & =-6\\int sin⁡\\theta \\,\\text{d}\\theta  \\\\  & =-6(-cos⁡\\theta )+C \\\\  & =6cos⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e110585-148d-5b73-8c52-9b80a228a906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}\\operatorname{sin}y+C" :db/id #edb/ref 17592186247973} {:answer/id #uuid "44cfbe88-2a28-57ed-af22-7a46cf6cebff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\operatorname{sin}y+C" :db/id #edb/ref 17592186248040} {:answer/id #uuid "48228916-ab6f-548c-a9e8-682af00b3143" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}y+C" :db/id #edb/ref 17592186248069} {:answer/id #uuid "54690fdf-f2bf-58c6-8959-b1212dbd668c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sin}y+C" :db/id #edb/ref 17592186248183} {:answer/id #uuid "9537f444-1492-5ebc-9220-1ba17b75bed1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{cos}y+C" :db/id #edb/ref 17592186248750}] :answer-field/correct {:db/id #edb/ref 17592186248183} :answer-field/id #uuid "3b943c43-477a-5079-9de3-d33c94e57c4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249775}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "51e2c13f-c606-5d86-a345-77ece48f02ef" :question/math-academy-id "q-113908" :question/problem "$$\n\\displaystyle \\int 5cos⁡y\\,\\text{d}y=\n$$" :question/worked-solution "Recall that\n\n$$\n\\int cos⁡y\\,\\text{d}y=sin⁡y+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5cos⁡y\\,\\text{d}y & =5\\int cos⁡y\\,\\text{d}y \\\\  & =5(sin⁡y)+C \\\\  & =5sin⁡y+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7aeb20-aa4f-5c00-b50e-3e615f4643cc" :answer/type {:db/id #edb/ref 17592186