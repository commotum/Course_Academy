#{[{:db/id #edb/ref 17592186115400 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114954 :question/id #uuid "fd6239d1-4fec-50b9-8018-f6e185c4e0d0" :question/math-academy-id "e-209" :question/problem "If $f(x) =3 x\\, \\operatorname{arccsc} x,$ calculate $f'(x).$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccsc} $ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{arccsc}  x) \t=  -\\dfrac 1 {|x| \\sqrt {x^2 - 1}} \\, .\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3x\\,\\operatorname{arccsc} x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x\\,\\operatorname{arccsc} x) \\\\  & =3(x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccsc} x)+\\operatorname{arccsc} x\\cdot \\frac{\\text{d}}{\\text{d}x}(x)) \\\\  & =3x\\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)+3\\,\\operatorname{arccsc} x\\cdot 1 \\\\  & =-\\frac{3x}{|x|\\sqrt{{x}^{2}-1}}+3\\,\\operatorname{arccsc} x.\\end{aligned}\n$$"} :knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813 :topic/difficulty 1.3069182911607868 :topic/id #uuid "c2580f8e-3ba3-5aa9-b1f1-0d8e49986381" :topic/knowledge-points [{:db/id #edb/ref 17592186096617} {:db/id #edb/ref 17592186096618} {:db/id #edb/ref 17592186096619}] :topic/math-academy-id 1109 :topic/next [{:db/id #edb/ref 17592186048842}] :topic/title "The Product Rule for Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186746779 :question-generator/id #uuid "acdd6c17-3060-5dcb-b999-d027ebe2df3f" :question-generator/script "generators/e7/e75cb7beba2061da8c9485f6c49912e51833c2b27e10fe659f9acd7836d7b608/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115532 :question/answer-fields [{:answer-field/choices [