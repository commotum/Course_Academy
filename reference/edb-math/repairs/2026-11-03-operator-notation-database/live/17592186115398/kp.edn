#{[{:db/id #edb/ref 17592186115398 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114947 :question/id #uuid "5adf056c-d122-54e6-b55f-5e85d39750c4" :question/math-academy-id "e-207" :question/problem "Calculate $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$ if $y = 2 \\,\\operatorname{arccot}  x.$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{arccot}  x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\operatorname{arccot} x) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} x) \\\\  & =2\\cdot \\left(-\\frac{1}{1+{x}^{2}}\\right) \\\\  & =-\\frac{2}{1+{x}^{2}}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/knowledge-points [{:db/id #edb/ref 17592186059862} {:db/id #edb/ref 17592186059863} {:db/id #edb/ref 17592186059864} {:db/id #edb/ref 17592186059865}] :topic/math-academy-id 278 :topic/next [{:db/id #edb/ref 17592186048442} {:db/id #edb/ref 17592186050711}] :topic/title "The Sum and Constant Multiple Rules for Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186746731 :question-generator/id #uuid "6480feec-cf6d-5dff-8120-72f8abff4f56" :question-generator/script "generators/29/2937c6cbfa2773e94932dbd9e4400bcc997cc408fe16565a5938e53e49f8d6bf/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b139de46-c7cd-5376-868a-4d2ff2bcef21" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\frac{3}{\\mid x \\mid \\sqrt{x^{2} - 1}}" :db/i