{tan}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186249252}] :answer-field/correct {:answer/id #uuid "89765658-5c5b-5edc-a80e-0d5330eacbc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186248646} :answer-field/id #uuid "812aa8aa-0438-595b-bab8-2d74de8d3b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249894}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9801153f-b480-580e-a696-7b55c194e174" :question/math-academy-id "q-113983" :question/problem "Calculate the integral $$\n\\displaystyle \\int ({sec}^{2}⁡x+1)\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=\\operatorname{sec}⁡x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,⟹\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int ({sec}^{2}⁡x+1)\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\int ({u}^{2}+1)\\,\\text{d}u \\\\  & =\\frac{{u}^{3}}{3}+u+C \\\\  & =\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519b8fb0-5928-5ec9-8613-12c9d1306f72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266873} {:answer/id #uuid "60890db1-c6f4-5143-9b9a-ae422da31c9c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186266994} {:answer/id #uuid "87157abc-6212-562b-a343-90c57626ecf4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186267338} {:answer/id #uuid "8b99c65a-2714-56e5-af5f-38d5a8ea0940" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186267396} {:answer/id #uuid "919ec147-de01-530b-97cb-da754894b913" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186267439}] :answer-field/correct {:answer/id #uuid "8b99c65a-2714-56e5-af5f-38d5a8ea0940" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186267396} :answer-field/id #uuid "8c52e3dd-dd13-5927-892c-f499bebd302f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268655}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "996adb7b-cb39-5733-9d5d-ec3bcfe1a670" :question/math-academy-id "q-13663" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{\\pi /9}^{\\pi /6}2{csc}^{2}⁡(3x)\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /9$ | $\\pi /6$ |\n| --- | --- | --- |\n| $u$ | $\\pi /3$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /9}^{\\pi /6}2{csc}^{2}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /3}^{\\pi /2}2{csc}^{2}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{\\pi /3}^{\\pi /2}{csc}^{2}⁡u\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\operatorname{cot}⁡u{|}_{\\pi /3}^{\\pi /2} \\\\  & =-\\frac{2}{3}(\\operatorname{cot}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cot}⁡\\left(\\frac{\\pi }{3}\\right)) \\\\  & =-\\frac{2}{3}(0-\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{2\\sqrt{3}}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c351233-a918-5f2c-867c-b36c3e634b45" :answer/type {:db/ident :answer.type/math} :answer/value "10\\operatorname{sec}⁡(10x)+C" :db/id #edb/ref 1759