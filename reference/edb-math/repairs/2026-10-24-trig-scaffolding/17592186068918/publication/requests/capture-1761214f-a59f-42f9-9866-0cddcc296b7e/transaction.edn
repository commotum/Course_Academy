sec{\\left(x \\right)} + 3}\\,\\mathrm{d}x\n$$"] [:db/add "cb22fcf0-993c-5966-acfa-b01e2aafd293" :question/worked-solution "Let $u=2 \\sec{\\left(x \\right)} + 3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2 \\tan{\\left(x \\right)} \\sec{\\left(x \\right)}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 \\tan{\\left(x \\right)} \\sec{\\left(x \\right)}}{2 \\sec{\\left(x \\right)} + 3}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u.\n$$"] [:db/add "cb22fcf0-993c-5966-acfa-b01e2aafd293" :question/difficulty :question.difficulty/easy] [:db/add "cb22fcf0-993c-5966-acfa-b01e2aafd293" :question/answer-fields "a5c5b866-690a-536b-8016-b5bc64541276"] [:db/ensure "cb22fcf0-993c-5966-acfa-b01e2aafd293" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "cb22fcf0-993c-5966-acfa-b01e2aafd293"] [:db/add "9269a841-cb22-57b2-a1b9-ab5722aaacb3" :answer/id #uuid "9269a841-cb22-57b2-a1b9-ab5722aaacb3"] [:db/add "9269a841-cb22-57b2-a1b9-ab5722aaacb3" :answer/type :answer.type/math] [:db/add "9269a841-cb22-57b2-a1b9-ab5722aaacb3" :answer/value "-3\\left(\\ln\\left|\\cos{\\left(x \\right)} + 2\\right|\\right)"] [:db/ensure "9269a841-cb22-57b2-a1b9-ab5722aaacb3" :answer/validate] [:db/add "36cdbfc0-1dbe-5184-9526-131f920264cf" :answer-field/id #uuid "36cdbfc0-1dbe-5184-9526-131f920264cf"] [:db/add "36cdbfc0-1dbe-5184-9526-131f920264cf" :answer-field/key "answer"] [:db/add "36cdbfc0-1dbe-5184-9526-131f920264cf" :answer-field/type :answer-field.type/blank] [:db/add "36cdbfc0-1dbe-5184-9526-131f920264cf" :answer-field/choices "9269a841-cb22-57b2-a1b9-ab5722aaacb3"] [:db/add "36cdbfc0-1dbe-5184-9526-131f920264cf" :answer-field/correct "9269a841-cb22-57b2-a1b9-ab5722aaacb3"] [:db/ensure "36cdbfc0-1dbe-5184-9526-131f920264cf" :answer-field/validate] [:db/add "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/id #uuid "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0"] [:db/add "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 \\sin{\\left(x \\right)}}{\\cos{\\left(x \\right)} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 1/u\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/worked-solution "Let $u=\\cos{\\left(x \\right)} + 2$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\sin{\\left(x \\right)}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 \\sin{\\left(x \\right)}}{\\cos{\\left(x \\right)} + 2}\\,\\mathrm{d}x\\\\&=-3\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-3\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=-3\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n-3\\left(\\ln\\left|\\cos{\\left(x \\right)} + 2\\right|\\right)+C.\n$$"] [:db/add "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/difficulty :question.difficulty/moderate] [:db/add "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/answer-fields "36cdbfc0-1dbe-5184-9526-131f920264cf"] [:db/ensure "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0"] [:db/add "1ab35f0d-ed0b-53a6-a709-eee21b017721" :answer/id #uuid "1ab35f0d-ed0b-53a6-a709-eee21b017721"] [:db/add "1ab35f0d-ed0b-53a6-a709-eee21b017721" :answer/type :answer.type/math] [:db/add "1ab35f0d-ed0b-53a6-a709-eee21b017721" :answer/value "- \\frac{2}{3}\\left(\\ln\\left|\\cos^{3}{\\left(x \\right)} + 3\\right|\\right)"] [:db/ensure "1ab35f0d-ed0b-53a6-a709-eee21b017721" :answer/validate] [:db/add "32b8e67e-6266-592b-9ab4-48fe7c1076bd" :answer-field/id #uuid "32b8e67e-6266-592b-9ab4-48fe7c1076bd"] [:db/add "32b8e67e-6266-592b-9ab4-48fe7c1076bd" :answer-field/key "answer"] [:db/add "32b8e67e-6266-592b-9ab4-48fe7c1076bd" :answer-field/type :answer-field.type/blank] [:db/add "32b8e67e-6266-592b-9ab4-48fe7c1076bd" :answer-field/choices "1ab35f0d-ed0b-53a6-a709-eee21b017721"] [:db/add "32b8e67e-6266-592b-9ab4-48fe7c1076bd" :answer-field/correct "1ab35f0d-ed0b-53a6-a709-eee21b017721"] [:db/ensure "32b8e67e-6266-592b-9ab4-48fe7c1076bd" :answer-field/validate] [:db/add "7696509d-e5cb-5529-a8eb-a961ebd3df4c" :question/id #uuid "7696509d-e5cb-5529-a8eb-a961ebd3df4c"] [:db/add "7696509d-e5cb-5529-a8eb-a961ebd3df4c" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 \\sin{\\left(x \\right)} \\cos^{2}{\\left(x \\right)}}{\\cos^{3}{\\left(x \\right)} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 1/u\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "7696509d-e5cb-5529-a8eb-a961ebd3df4c" :question/worked-solution "Let $u=\\cos^{3}{\\left(x \\right)} + 3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- 3 \\sin{\\left(x \\right)} \\cos^{2}{\\left(x \\right)}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 \\sin{\\left(x \\right)} \\cos^{2}{\\left(x \\right)}}{\\cos^{3}{\\left(x \\right)} + 3}\\,\\mathrm{d}x\\\\&=- \\frac{2}{3}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{2}{3}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=- \\frac{2}{3}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{2}{3}\\left(\\ln\\left|\\cos^{3}{\\left(x \\right)} + 3\\right|\\right)+C.\n$$"] [:db/add "7696509d-e5cb-5529-a8eb-a961ebd3df4c" :question/difficulty :question.difficulty/moderate] [:db/add "7696509d-e5cb-5529-a8eb-a961ebd3df4c" :question/answer-fields "32b8e67e-6266-592b-9ab4-48fe7c1076bd"] [:db/ensure "7696509d-e5cb-5529-a8eb-a961ebd3df4c" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "7696509d-e5cb-5529-a8eb-a961ebd3df4c"] [:db/add "f00314b4-92f2-5497-b21f-1f1d41f4a650" :answer/id #uuid "f00314b4-92f2-5497-b21f-1f1d41f4a650"] [:db/add "f00314b4-92f2-5