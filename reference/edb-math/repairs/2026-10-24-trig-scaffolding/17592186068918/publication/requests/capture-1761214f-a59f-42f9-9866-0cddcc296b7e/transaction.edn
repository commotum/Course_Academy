2cfa-514c-bee4-deec7f0746d9" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "5799d41a-2cfa-514c-bee4-deec7f0746d9"] [:db/add "50065767-b289-53fe-a618-d57bf652d952" :answer/id #uuid "50065767-b289-53fe-a618-d57bf652d952"] [:db/add "50065767-b289-53fe-a618-d57bf652d952" :answer/type :answer.type/math] [:db/add "50065767-b289-53fe-a618-d57bf652d952" :answer/value "\\sec{\\left(x \\right)} + 3-3\\left(\\ln\\left|\\sec{\\left(x \\right)} + 3\\right|\\right)"] [:db/ensure "50065767-b289-53fe-a618-d57bf652d952" :answer/validate] [:db/add "22f19925-f30d-5472-9d85-cbeba2358e50" :answer-field/id #uuid "22f19925-f30d-5472-9d85-cbeba2358e50"] [:db/add "22f19925-f30d-5472-9d85-cbeba2358e50" :answer-field/key "answer"] [:db/add "22f19925-f30d-5472-9d85-cbeba2358e50" :answer-field/type :answer-field.type/blank] [:db/add "22f19925-f30d-5472-9d85-cbeba2358e50" :answer-field/choices "50065767-b289-53fe-a618-d57bf652d952"] [:db/add "22f19925-f30d-5472-9d85-cbeba2358e50" :answer-field/correct "50065767-b289-53fe-a618-d57bf652d952"] [:db/ensure "22f19925-f30d-5472-9d85-cbeba2358e50" :answer-field/validate] [:db/add "f6d82a54-5d2e-504b-a04e-946dd548ece7" :question/id #uuid "f6d82a54-5d2e-504b-a04e-946dd548ece7"] [:db/add "f6d82a54-5d2e-504b-a04e-946dd548ece7" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{\\tan{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\sec{\\left(x \\right)} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 1/u\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "f6d82a54-5d2e-504b-a04e-946dd548ece7" :question/worked-solution "Let $u=\\sec{\\left(x \\right)} + 3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\tan{\\left(x \\right)} \\sec{\\left(x \\right)}.\n$$\n\nSince $\\sec{\\left(x \\right)}=u-3$, rewrite the remaining factor:\n\n$$\n\\frac{u-3}{u}=1-\\frac{3}{u}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{\\tan{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\sec{\\left(x \\right)} + 3}\\,\\mathrm{d}x\\\\&=\\int 1 - \\frac{3}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\int 1 - \\frac{3}{u}\\,\\mathrm{d}u=u-3\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\sec{\\left(x \\right)} + 3-3\\left(\\ln\\left|\\sec{\\left(x \\right)} + 3\\right|\\right)+C.\n$$"] [:db/add "f6d82a54-5d2e-504b-a04e-946dd548ece7" :question/difficulty :question.difficulty/hard] [:db/add "f6d82a54-5d2e-504b-a04e-946dd548ece7" :question/answer-fields "22f19925-f30d-5472-9d85-cbeba2358e50"] [:db/ensure "f6d82a54-5d2e-504b-a04e-946dd548ece7" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "f6d82a54-5d2e-504b-a04e-946dd548ece7"] [:db/add "generator" :question-generator/id #uuid "d4269f3a-b357-54c0-8e94-27f039c3b613"] [:db/add "generator" :question-generator/script "generators/b4/b4a1184baf1a0c145e71bb92ddcd6462ad4ceafcca3d350d16bc0ec0ea18f5ad/generator.py"] [:db/add 17592186068918 :knowledge-point/question-generator "generator"] [:db/ensure 17592186068918 :knowledge-point/validate] [:db/cas 17592186677532 :question/retired nil true] [:db/cas 17592186677534 :question/retired nil true] [:db/cas 17592186677538 :question/retired nil true] [:db/cas 17592186677541 :question/retired nil true] [:db/cas 17592186677542 :question/retired nil true] [:db/cas 17592186677546 :question/retired nil true] [:db/cas 17592186677547 :question/retired nil true] [:db/cas 17592186677553 :question/retired nil true] [:db/cas 17592186677558 :question/retired nil true] [:db/cas 17592186677561 :question/retired nil true] [:db/cas 17592186677565 :question/retired nil true] [:db/cas 17592186677566 :question/retired nil true] [:db/cas 17592186677567 :question/retired nil true] [:db/cas 17592186677572 :question/retired nil true] [:db/cas 17592186677574 :question/retired nil true] [:db/cas 17592186677579 :question/retired nil true] [:db/cas 17592186677582 :question/retired nil true] [:db/cas 17592186677585 :q