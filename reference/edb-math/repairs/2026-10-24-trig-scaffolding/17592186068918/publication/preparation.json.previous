b-0671b340a575\" :question/answer-fields \"63dcec39-549e-5039-9442-a0a995f59f47\"] [17592186068918 :knowledge-point/questions \"6365eecd-51bd-5d2b-b4cb-0671b340a575\"] [\"03ec3115-dffb-50ca-8717-1e65a0c26e01\" :answer/id #uuid \"03ec3115-dffb-50ca-8717-1e65a0c26e01\"] [\"03ec3115-dffb-50ca-8717-1e65a0c26e01\" :answer/type :answer.type/math] [\"03ec3115-dffb-50ca-8717-1e65a0c26e01\" :answer/value \"-4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"9358b6f8-54c9-5b2a-86e3-f2772f13c4c7\" :answer/id #uuid \"9358b6f8-54c9-5b2a-86e3-f2772f13c4c7\"] [\"9358b6f8-54c9-5b2a-86e3-f2772f13c4c7\" :answer/type :answer.type/math] [\"9358b6f8-54c9-5b2a-86e3-f2772f13c4c7\" :answer/value \"\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\"] [\"ddf0d371-4cd7-5ac0-ba61-f65d6f0da153\" :answer/id #uuid \"ddf0d371-4cd7-5ac0-ba61-f65d6f0da153\"] [\"ddf0d371-4cd7-5ac0-ba61-f65d6f0da153\" :answer/type :answer.type/math] [\"ddf0d371-4cd7-5ac0-ba61-f65d6f0da153\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"db5532a8-01d2-5496-bec6-298a568030be\" :answer/id #uuid \"db5532a8-01d2-5496-bec6-298a568030be\"] [\"db5532a8-01d2-5496-bec6-298a568030be\" :answer/type :answer.type/math] [\"db5532a8-01d2-5496-bec6-298a568030be\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"59f50c54-3617-5a11-8a1f-35f51ea0ae77\" :answer/id #uuid \"59f50c54-3617-5a11-8a1f-35f51ea0ae77\"] [\"59f50c54-3617-5a11-8a1f-35f51ea0ae77\" :answer/type :answer.type/math] [\"59f50c54-3617-5a11-8a1f-35f51ea0ae77\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/id #uuid \"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/key \"answer\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/type :answer-field.type/radio] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/choices \"03ec3115-dffb-50ca-8717-1e65a0c26e01\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/choices \"9358b6f8-54c9-5b2a-86e3-f2772f13c4c7\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/choices \"ddf0d371-4cd7-5ac0-ba61-f65d6f0da153\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/choices \"db5532a8-01d2-5496-bec6-298a568030be\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/choices \"59f50c54-3617-5a11-8a1f-35f51ea0ae77\"] [\"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\" :answer-field/correct \"ddf0d371-4cd7-5ac0-ba61-f65d6f0da153\"] [\"919f75ec-7f1f-560b-8330-8df8da2a5224\" :question/id #uuid \"919f75ec-7f1f-560b-8330-8df8da2a5224\"] [\"919f75ec-7f1f-560b-8330-8df8da2a5224\" :question/problem \"Use the substitution $u=\\\\tan{\\\\left(x \\\\right)} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2 \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"919f75ec-7f1f-560b-8330-8df8da2a5224\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sec^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"919f75ec-7f1f-560b-8330-8df8da2a5224\" :question/difficulty :question.difficulty/easy] [\"919f75ec-7f1f-560b-8330-8df8da2a5224\" :question/answer-fields \"4a8bae6a-34c7-5b09-b7e4-3c90f5ea511d\"] [17592186068918 :knowledge-point/questions \"919f75ec-7f1f-560b-8330-8df8da2a5224\"] [\"551f085e-f23c-5e9a-a6a0-346cd3db3e82\" :answer/id #uuid \"551f085e-f23c-5e9a-a6a0-346cd3db3e82\"] [\"551f085e-f23c-5e9a-a6a0-346cd3db3e82\" :answer/type :answer.type/math] [\"551f085e-f23c-5e9a-a6a0-346cd3db3e82\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"944e1c4a-7ca0-56db-a5a2-49a0e7c97ee6\" :answer/id #uuid \"944e1c4a-7ca0-56db-a5a2-49a0e7c97ee6\"] [\"944e1c4a-7ca0-56db-a5a2-49a0e7c97ee6\" :answer/type :answer.type/math] [\"944e1c4a-7ca0-56db-a5a2-49a0e7c97ee6\" :answer/value \"-\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6b58d5f7-2355-5c24-82fe-86895dd90620\" :answer/id #uuid \"6b58d5f7-2355-5c24-82fe-86895dd90620\"] [\"6b58d5f7-2355-5c24-82fe-86895dd90620\" :answer/type :answer.type/math] [\"6b58d5f7-2355-5c24-82fe-86895dd90620\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2121e5c6-95ec-56b9-bb26-dcc0b1ddc00b\" :answer/id #uuid \"2121e5c6-95ec-56b9-bb26-dcc0b1ddc00b\"] [\"2121e5c6-95ec-56b9-bb26-dcc0b1ddc00b\" :answer/type :answer.type/math] [\"2121e5c6-95ec-56b9-bb26-dcc0b1ddc00b\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f055b66c-71a4-5fa0-898c-44e8fe8b6764\" :answer/id #uuid \"f055b66c-71a4-5fa0-898c-44e8fe8b6764\"] [\"f055b66c-71a4-5fa0-898c-44e8fe8b6764\" :answer/type :answer.type/math] [\"f055b66c-71a4-5fa0-898c-44e8fe8b6764\" :answer/value \"\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/id #uuid \"7d16b70a-bf8f-53d5-96b3-61367669c8c3\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/key \"answer\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/type :answer-field.type/radio] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/choices \"551f085e-f23c-5e9a-a6a0-346cd3db3e82\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/choices \"944e1c4a-7ca0-56db-a5a2-49a0e7c97ee6\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/choices \"6b58d5f7-2355-5c24-82fe-86895dd90620\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/choices \"2121e5c6-95ec-56b9-bb26-dcc0b1ddc00b\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/choices \"f055b66c-71a4-5fa0-898c-44e8fe8b6764\"] [\"7d16b70a-bf8f-53d5-96b3-61367669c8c3\" :answer-field/correct \"6b58d5f7-2355-5c24-82fe-86895dd90620\"] [\"cfc0bcd5-2490-5028-8991-b48ed70c3add\" :question/id #uuid \"cfc0bcd5-2490-5028-8991-b48ed70c3add\"] [\"cfc0bcd5-2490-5028-8991-b48ed70c3add\" :question/problem \"Use the substitution $u=2 \\\\cos{\\\\left(x \\\\right)} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{\\\\sin{\\\\left(x \\\\right)}}{2 \\\\cos{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"cfc0bcd5-2490-5028-8991-b48ed70c3add\" :question/worked-solution \"Let $u=2 \\\\cos{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\sin{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\sin{\\\\left(x \\\\right)}}{2 \\\\cos{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"cfc0bcd5-2490-5028-8991-b48ed70c3add\" :question/difficulty :question.difficulty/easy] [\"cfc0bcd5-2490-5028-8991-b48ed70c3add\" :question/answer-fields \"7d16b70a-bf8f-53d5-96b3-61367669c8c3\"] [17592186068918 :knowledge-point/questions \"cfc0bcd5-2490-5028-8991-b48ed70c3add\"] [\"c92a62ca-1d41-59c6-9cdb-668e1fdc0183\" :answer/id #uuid \"c92a62ca-1d41-59c6-9cdb-668e1fdc0183\"] [\"c92a62ca-1d41-59c6-9cdb-668e1fdc0183\" :answer/type :answer.type/math] [\"c92a62ca-1d41-59c6-9cdb-668e1fdc0183\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a28e74c4-1971-54b9-85c5-d8a29b05c8de\" :answer/id #uuid \"a28e74c4-1971-54b9-85c5-d8a29b05c8de\"] [\"a28e74c4-1971-54b9-85c5-d8a29b05c8de\" :answer/type :answer.type/math] [\"a28e74c4-1971-54b9-