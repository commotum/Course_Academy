                ":answer/value": "\\ln\\left(2\\right)-\\ln\\left(1\\right)"
              }
            ],
            ":answer-field/correct": [
              ":answer/id",
              "cf96e8b8-c225-5478-b6ec-c2ab0af2d47d"
            ]
          }
        ]
      },
