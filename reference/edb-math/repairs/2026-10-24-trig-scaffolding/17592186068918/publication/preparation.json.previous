255-bb9b-56a906f714e7\" :question/problem \"Use the substitution $u=\\\\sin{\\\\left(x \\\\right)} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"8a4f75e6-6f41-5255-bb9b-56a906f714e7\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"8a4f75e6-6f41-5255-bb9b-56a906f714e7\" :question/difficulty :question.difficulty/easy] [\"8a4f75e6-6f41-5255-bb9b-56a906f714e7\" :question/answer-fields \"bc04fd17-21a7-5780-bf51-df77d73d6c0a\"] [17592186068918 :knowledge-point/questions \"8a4f75e6-6f41-5255-bb9b-56a906f714e7\"] [\"8b0a7f1d-d739-598c-8722-9081804e023d\" :answer/id #uuid \"8b0a7f1d-d739-598c-8722-9081804e023d\"] [\"8b0a7f1d-d739-598c-8722-9081804e023d\" :answer/type :answer.type/math] [\"8b0a7f1d-d739-598c-8722-9081804e023d\" :answer/value \"\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\"] [\"ee1a5af2-9fcb-51bd-ad8a-d4f72263e8a5\" :answer/id #uuid \"ee1a5af2-9fcb-51bd-ad8a-d4f72263e8a5\"] [\"ee1a5af2-9fcb-51bd-ad8a-d4f72263e8a5\" :answer/type :answer.type/math] [\"ee1a5af2-9fcb-51bd-ad8a-d4f72263e8a5\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b0cb935f-bf33-5863-b288-986fc938c011\" :answer/id #uuid \"b0cb935f-bf33-5863-b288-986fc938c011\"] [\"b0cb935f-bf33-5863-b288-986fc938c011\" :answer/type :answer.type/math] [\"b0cb935f-bf33-5863-b288-986fc938c011\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c094c219-5c4f-59b7-a206-506a53bca1c6\" :answer/id #uuid \"c094c219-5c4f-59b7-a206-506a53bca1c6\"] [\"c094c219-5c4f-59b7-a206-506a53bca1c6\" :answer/type :answer.type/math] [\"c094c219-5c4f-59b7-a206-506a53bca1c6\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"85065cc8-b14c-5f41-8ddd-0fa0d3774ed5\" :answer/id #uuid \"85065cc8-b14c-5f41-8ddd-0fa0d3774ed5\"] [\"85065cc8-b14c-5f41-8ddd-0fa0d3774ed5\" :answer/type :answer.type/math] [\"85065cc8-b14c-5f41-8ddd-0fa0d3774ed5\" :answer/value \"-\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/id #uuid \"a5c5b866-690a-536b-8016-b5bc64541276\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/key \"answer\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/type :answer-field.type/radio] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/choices \"8b0a7f1d-d739-598c-8722-9081804e023d\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/choices \"ee1a5af2-9fcb-51bd-ad8a-d4f72263e8a5\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/choices \"b0cb935f-bf33-5863-b288-986fc938c011\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/choices \"c094c219-5c4f-59b7-a206-506a53bca1c6\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/choices \"85065cc8-b14c-5f41-8ddd-0fa0d3774ed5\"] [\"a5c5b866-690a-536b-8016-b5bc64541276\" :answer-field/correct \"8b0a7f1d-d739-598c-8722-9081804e023d\"] [\"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/id #uuid \"cb22fcf0-993c-5966-acfa-b01e2aafd293\"] [\"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/problem \"Use the substitution $u=2 \\\\sec{\\\\left(x \\\\right)} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{2 \\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\"] [\"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/worked-solution \"Let $u=2 \\\\sec{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{2 \\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/difficulty :question.difficulty/easy] [\"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/answer-fields \"a5c5b866-690a-536b-8016-b5bc64541276\"] [17592186068918 :knowledge-point/questions \"cb22fcf0-993c-5966-acfa-b01e2aafd293\"] [\"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/id #uuid \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\"] [\"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/type :answer.type/math] [\"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/value \"-3\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)\"] [\"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/id #uuid \"36cdbfc0-1dbe-5184-9526-131f920264cf\"] [\"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/key \"answer\"] [\"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/type :answer-field.type/blank] [\"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/choices \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\"] [\"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/correct \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\"] [\"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/id #uuid \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\"] [\"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sin{\\\\left(x \\\\right)}}{\\\\cos{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\sin{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sin{\\\\left(x \\\\right)}}{\\\\cos{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-3\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"] [\"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/difficulty :question.difficulty/moderate] [\"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/answer-fields \"36cdbfc0-1dbe-5184-9526-131f920264cf\"] [17592186068918 :knowledge-point/questions \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\"] [\"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/id #uuid \"1ab35f0d-ed0b-53a6-a709-eee21b017721\"] [\"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/type :answer.type/math] [\"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\ln\\\\left|\\\\cos^{3}{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [\"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/id #uuid \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\"] [\"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/key \"answer\"] [\"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/type :answer-field.type/blank] [\"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/choices \"1ab35f0d-ed0b-53a6-a709-eee21b017721\"] [\"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/correct \"1ab35f0d-ed0b-53a6-a709-eee21b017721\"] [\"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/id #uuid \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\"] [\"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/worked-solution \"Let $u=\\\\cos^{3}{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2}{3}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(\\\\ln\\\\left|\\\\cos^{3}{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/difficulty :question.difficulty/moderate] [\"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/answer-fields \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\"] [17592186068918 :knowledge-point/questions \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\"] [\"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/id #uuid \"f00314b4-92f2-5497-b21f-1f1d41f4a650\"] [\"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/type :answer.type/math] [\"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/value \"\\\\ln\\\\left|\\\\sin{\\\\left(x \\\\right)} + 3\\\\right|\"] [\"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/id #uuid \"a491747c-9717-57ec-8a22-d2cd7b67a98d\"] [\"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/key \"answer\"] [\"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/type :answer-field.type/blank] [\"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/choices \"f00314b4-92f2-5497-b21f-1f1d41f4a650\"] [\"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/correct \"f00314b4-92f2-5497-b21f-1f1d41f4a650\"] [\"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/id #uuid \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\"] [\"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|\\\\sin{\\\\left(x \\\\right)} + 3\\\\right|+C.\\n$$\"] [\"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/difficulty :question.difficulty/moderate] [\"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/answer-fields \"a491747c-9717-57ec-8a22-d2cd7b67a98d\"] [17592186068918 :knowledge-point/questions \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\"] [\"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/id #uuid \"6dd2783b-acc8-5a41-8814-632a6b7798da\"] [\"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/type :answer.type/math] [\"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/value \"-2\\\\left(\\\\ln\\\\left|\\\\cot{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [\"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/id #uuid \"aabe90bb-6032-57cd-a78d-227c633731d7\"] [\"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/key \"answer\"] [\"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/type :answer-field.type/blank] [\"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/choices \"6dd2783b-acc8-5a41-8814-632a6b7798da\"] [\"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/correct \"6dd2783b-acc8-5a41-8814-632a6b7798da\"] [\"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/id #uuid \"ce1c55da-cc20-5add-93cc-f834a01ce872\"] [\"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\csc^{2}{\\\\left(x \\\\right)}}{\\\\cot{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/worked-solution \"Let $u=\\\\cot{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\csc^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\csc^{2}{\\\\left(x \\\\right)}}{\\\\cot{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\ln\\\\left|\\\\cot{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/difficulty :question.difficulty/moderate] [\"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/answer-fields \"aabe90bb-6032-57cd-a78d-227c633731d7\"] [17592186068918 :knowledge-point/questions \"ce1c55da-cc20-5add-93cc-f834a01ce872\"] [\"f883f755-b22e-57d8-8353-c6de87919773\" :answer/id #uuid \"f883f755-b22e-57d8-8353-c6de87919773\"] [\"f883f755-b22e-57d8-8353-c6de87919773\" :answer/type :answer.type/math] [\"f883f755-b22e-57d8-8353-c6de87919773\" :answer/value \"-3\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [\"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/id #uuid \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\"] [\"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/key \"answer\"] [\"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/type :answer-field.type/blank] [\"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/choices \"f883f755-b22e-57d8-8353-c6de87919773\"] [\"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/correct \"f883f755-b22e-57d8-8353-c6de87919773\"] [\"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/id #uuid \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\"] [\"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cot{\\\\left(x \\\\right)} \\\\csc{\\\\left(x \\\\right)}}{\\\\csc{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\cot{\\\\left(x \\\\right)} \\\\csc{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cot{\\\\left(x \\\\right)} \\\\csc{\\\\left(x \\\\right)}}{\\\\csc{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-3\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/difficulty :question.difficulty/moderate] [\"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/answer-fields \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\"] [17592186068918 :knowledge-point/questions \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\"] [\"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/id #uuid \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\"] [\"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/type :answer.type/math] [\"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/value \"3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [\"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/id #uuid \"e1e1b014-ac28-5db6-b361-da5b615faa1e\"] [\"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/key \"answer\"] [\"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/type :answer-field.type/blank] [\"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/choices \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\"] [\"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/correct \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\"] [\"20077b72-a8a0-5949-928b-697800f9f411\" :question/id #uuid \"20077b72-a8a0-5949-928b-697800f9f411\"] [\"20077b72-a8a0-5949-928b-697800f9f411\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"20077b72-a8a0-5949-928b-697800f9f411\" :question/worked-solution \"Let $u=\\\\sec{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"20077b72-a8a0-5949-928b-697800f9f411\" :question/difficulty :question.difficulty/moderate] [\"20077b72-a8a0-5949-928b-697800f9f411\" :question/answer-fields \"e1e1b014-ac28-5db6-b361-da5b615faa1e\"] [17592186068918 :knowledge-point/questions \"20077b72-a8a0-5949-928b-697800f9f411\"] [\"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/id #uuid \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\"] [\"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/type :answer.type/math] [\"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin^{2}{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)\"] [\"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/id #uuid \"caa84d65-7734-5833-b30f-0692f3355cb3\"] [\"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/key \"answer\"] [\"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/type :answer-field.type/blank] [\"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/choices \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\"] [\"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/correct \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\"] [\"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/id #uuid \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\"] [\"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/worked-solution \"Let $u=\\\\sin^{2}{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin^{2}{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)+C.\\n$$\"] [\"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/difficulty :question.difficulty/moderate] [\"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/answer-fields \"caa84d65-7734-5833-b30f-0692f3355cb3\"] [17592186068918 :knowledge-point/questions \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\"] [\"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/id #uuid \"ce712152-3ba6-54ef-b73d-bbd1f4166638\"] [\"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/type :answer.type/math] [\"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/value \"3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)\"] [\"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/id #uuid \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\"] [\"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/key \"answer\"] [\"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/type :answer-field.type/blank] [\"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/choices \"ce712152-3ba6-54ef-b73d-bbd1f4166638\"] [\"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/correct \"ce712152-3ba6-54ef-b73d-bbd1f4166638\"] [\"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/id #uuid \"780aa30d-a997-50f9-ae44-01b49bca3290\"] [\"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sec^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"] [\"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/difficulty :question.difficulty/moderate] [\"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/answer-fields \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\"] [17592186068918 :knowledge-point/questions \"780aa30d-a997-50f9-ae44-01b49bca3290\"] [\"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/id #uuid \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\"] [\"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/type :answer.type/math] [\"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/value \"\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 1\\\\right|\"] [\"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/id #uuid \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\"] [\"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/key \"answer\"] [\"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/type :answer-field.type/blank] [\"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/choices \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\"] [\"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/correct \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\"] [\"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/id #uuid \"80d4ee8f-50d5-560e-99ae-11b6253219c3\"] [\"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x^{2} \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 1\\\\right|+C.\\n$$\"] [\"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/difficulty :question.difficulty/hard] [\"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/answer-fields \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\"] [17592186068918 :knowledge-point/questions \"80d4ee8f-50d5-560e-99ae-11b6253219c3\"] [\"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/id #uuid \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\"] [\"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/type :answer.type/math] [\"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/value \"3\\\\left(\\\\sec{\\\\left(x \\\\right)} + 1-\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)\"] [\"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/id #uuid \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\"] [\"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/key \"answer\"] [\"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/type :answer-field.type/blank] [\"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/choices \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\"] [\"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/correct \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\"] [\"925407a6-15df-507e-b702-30c13be91427\" :question/id #uuid \"925407a6-15df-507e-b702-30c13be91427\"] [\"925407a6-15df-507e-b702-30c13be91427\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"925407a6-15df-507e-b702-30c13be91427\" :question/worked-solution \"Let $u=\\\\sec{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nSince $\\\\sec{\\\\left(x \\\\right)}=u-1$, rewrite the remaining factor:\\n\\n$$\\n\\\\frac{u-1}{u}=1-\\\\frac{1}{u}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int 1 - \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n3\\\\left(\\\\int 1 - \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(u-\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\sec{\\\\left(x \\\\right)} + 1-\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)+C.\\n$$\"] [\"925407a6-15df-507e-b702-30c13be91427\" :question/difficulty :question.difficulty/hard] [\"925407a6-15df-507e-b702-30c13be91427\" :question/answer-fields \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\"] [17592186068918 :knowledge-point/questions \"925407a6-15df-507e-b702-30c13be91427\"] [\"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/id #uuid \"0b7887f9-f432-51a2-b303-334d07b2cba3\"] [\"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/type :answer.type/math] [\"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(x^{2} \\\\right)} + 3\\\\right|\\\\right)\"] [\"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/id #uuid \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\"] [\"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/key \"answer\"] [\"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/type :answer-field.type/blank] [\"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/choices \"0b7887f9-f432-51a2-b303-334d07b2cba3\"] [\"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/correct \"0b7887f9-f432-51a2-b303-334d07b2cba3\"] [\"e8649475-994f-54e3-8796-29f4ecd57606\" :question/id #uuid \"e8649475-994f-54e3-8796-29f4ecd57606\"] [\"e8649475-994f-54e3-8796-29f4ecd57606\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{x \\\\cos{\\\\left(x^{2} \\\\right)}}{\\\\sin{\\\\left(x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"e8649475-994f-54e3-8796-29f4ecd57606\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(x^{2} \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x \\\\cos{\\\\left(x^{2} \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{x \\\\cos{\\\\left(x^{2} \\\\right)}}{\\\\sin{\\\\left(x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(x^{2} \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"e8649475-994f-54e3-8796-29f4ecd57606\" :question/difficulty :question.difficulty/hard] [\"e8649475-994f-54e3-8796-29f4ecd57606\" :question/answer-fields \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\"] [17592186068918 :knowledge-point/questions \"e8649475-994f-54e3-8796-29f4ecd57606\"] [\"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/id #uuid \"5330c5f8-10e3-58c6-91a5-4dca22835059\"] [\"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/type :answer.type/math] [\"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/value \"\\\\tan{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [\"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/id #uuid \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\"] [\"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/key \"answer\"] [\"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/type :answer-field.type/blank] [\"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/choices \"5330c5f8-10e3-58c6-91a5-4dca22835059\"] [\"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/correct \"5330c5f8-10e3-58c6-91a5-4dca22835059\"] [\"783c2a89-9f00-534b-8121-076b71f15964\" :question/id #uuid \"783c2a89-9f00-534b-8121-076b71f15964\"] [\"783c2a89-9f00-534b-8121-076b71f15964\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"783c2a89-9f00-534b-8121-076b71f15964\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sec^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nSince $\\\\tan{\\\\left(x \\\\right)}=u-3$, rewrite the remaining factor:\\n\\n$$\\n\\\\frac{u-3}{u}=1-\\\\frac{3}{u}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u=u-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\tan{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"783c2a89-9f00-534b-8121-076b71f15964\" :question/difficulty :question.difficulty/hard] [\"783c2a89-9f00-534b-8121-076b71f15964\" :question/answer-fields \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\"] [17592186068918 :knowledge-point/questions \"783c2a89-9f00-534b-8121-076b71f15964\"] [\"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/id #uuid \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\"] [\"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/type :answer.type/math] [\"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/value \"\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(1\\\\right)\"] [\"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/id #uuid \"d8fe7e48-e89b-5110-9b40-2a3e19531370\"] [\"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/key \"answer\"] [\"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/type :answer-field.type/blank] [\"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/choices \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\"] [\"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/correct \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\"] [\"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/id #uuid \"62ce3275-2baa-559b-b2b1-d066e2b0c811\"] [\"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $\\\\sin{\\\\left(0 \\\\right)}=0,\\\\quad \\\\sin{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=1$.\\n\\n{{answer}}\"] [\"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/worked-solution \"Let $u=\\\\sin^{2}{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{1}^{2} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nBoth transformed bounds are positive. Evaluating gives\\n\\n$$\\n\\\\left[\\\\ln u\\\\right]_{1}^{2}=\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(1\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(1\\\\right).\\n$$\"] [\"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/difficulty :question.difficulty/hard] [\"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/answer-fields \"d8fe7e48-e89b-5110-9b40-2a3e19531370\"] [17592186068918 :knowledge-point/questions \"62ce3275-2baa-559b-b2b1-d066e2b0c811\"] [\"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/id #uuid \"89ccb77f-ea19-5517-a80b-5775b27f0059\"] [\"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/type :answer.type/math] [\"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/value \"-\\\\left(\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right)\"] [\"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/id #uuid \"a2f382a7-7017-56d3-989d-72bb9b1a4196\"] [\"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/key \"answer\"] [\"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/type :answer-field.type/blank] [\"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/choices \"89ccb77f-ea19-5517-a80b-5775b27f0059\"] [\"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/correct \"89ccb77f-ea19-5517-a80b-5775b27f0059\"] [\"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/id #uuid \"ef2b20da-499d-545a-b464-cf852a7c9a60\"] [\"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $\\\\cos{\\\\left(0 \\\\right)}=1,\\\\quad \\\\cos{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=0$.\\n\\n{{answer}}\"] [\"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/worked-solution \"Let $u=\\\\cos^{3}{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int_{3}^{2} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth transformed bounds are positive. Evaluating gives\\n\\n$$\\n-\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{2}\\\\right)=-\\\\left(\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n-\\\\left(\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\"] [\"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/difficulty :question.difficulty/hard] [\"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/answer-fields \"a2f382a7-7017-56d3-989d-72bb9b1a4196\"] [17592186068918 :knowledge-point/questions \"ef2b20da-499d-545a-b464-cf852a7c9a60\"] [\"a498463e-efb3-52d7-aba4-90b784066259\" :answer/id #uuid \"a498463e-efb3-52d7-aba4-90b784066259\"] [\"a498463e-efb3-52d7-aba4-90b784066259\" :answer/type :answer.type/math] [\"a498463e-efb3-52d7-aba4-90b784066259\" :answer/value \"\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 2\\\\right|\"] [\"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/id #uuid \"567efca9-1396-52a6-9c25-b5fc3c639dce\"] [\"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/key \"answer\"] [\"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/type :answer-field.type/blank] [\"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/choices \"a498463e-efb3-52d7-aba4-90b784066259\"] [\"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/correct \"a498463e-efb3-52d7-aba4-90b784066259\"] [\"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/id #uuid \"5799d41a-2cfa-514c-bee4-deec7f0746d9\"] [\"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x^{2} \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 2\\\\right|+C.\\n$$\"] [\"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/difficulty :question.difficulty/hard] [\"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/answer-fields \"567efca9-1396-52a6-9c25-b5fc3c639dce\"] [17592186068918 :knowledge-point/questions \"5799d41a-2cfa-514c-bee4-deec7f0746d9\"] [\"50065767-b289-53fe-a618-d57bf652d952\" :answer/id #uuid \"50065767-b289-53fe-a618-d57bf652d952\"] [\"50065767-b289-53fe-a618-d57bf652d952\" :answer/type :answer.type/math] [\"50065767-b289-53fe-a618-d57bf652d952\" :answer/value \"\\\\sec{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [\"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/id #uuid \"22f19925-f30d-5472-9d85-cbeba2358e50\"] [\"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/key \"answer\"] [\"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/type :answer-field.type/blank] [\"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/choices \"50065767-b289-53fe-a618-d57bf652d952\"] [\"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/correct \"50065767-b289-53fe-a618-d57bf652d952\"] [\"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/id #uuid \"f6d82a54-5d2e-504b-a04e-946dd548ece7\"] [\"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [\"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/worked-solution \"Let $u=\\\\sec{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nSince $\\\\sec{\\\\left(x \\\\right)}=u-3$, rewrite the remaining factor:\\n\\n$$\\n\\\\frac{u-3}{u}=1-\\\\frac{3}{u}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u=u-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\sec{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/difficulty :question.difficulty/hard] [\"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/answer-fields \"22f19925-f30d-5472-9d85-cbeba2358e50\"] [17592186068918 :knowledge-point/questions \"f6d82a54-5d2e-504b-a04e-946dd548ece7\"] [\"generator\" :question-generator/id #uuid \"d4269f3a-b357-54c0-8e94-27f039c3b613\"] [\"generator\" :question-generator/script \"generators/b4/b4a1184baf1a0c145e71bb92ddcd6462ad4ceafcca3d350d16bc0ec0ea18f5ad/generator.py\"] [17592186068918 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186068918 :knowledge-point/question-generator 17592186677604]]}",
