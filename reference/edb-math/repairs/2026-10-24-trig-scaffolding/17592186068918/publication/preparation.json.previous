  "before_edn": "{:db/id 17592186068918 :knowledge-point/canonical-example {:db/id 17592186068570 :question/id #uuid \"03e461a3-0fe0-5fb5-813e-ae23a5dc606a\" :question/math-academy-id \"e-467\" :question/problem \"Evaluate the integral $$\\n\\\\displaystyle \\\\int_0^{\\\\pi/4} \\\\dfrac{\\\\tan x \\\\sec^2 x}{1+\\\\tan^2x}\\\\,\\\\textrm d x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator, because\\n\\n$$\\n\\\\dfrac{\\\\textrm d}{\\\\textrm d x}(1+\\\\tan^2 x) = 2\\\\tan{x}\\\\sec^2 x.\\n$$\\n\\nSo, let $u = 1+\\\\tan^2 x.$ Differentiating, we have\\n\\n$$\\n\\\\dfrac{\\\\textrm{d} u}{\\\\textrm{d}x } = 2\\\\tan x\\\\sec^2 x \\\\quad\\\\Longrightarrow\\\\quad \\\\dfrac 1 2 \\\\textrm d u = \\\\tan x\\\\sec^2 x\\\\,\\\\textrm d x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi/4$ |\\n| --- | --- | --- |\\n| $u$ | $1$ | $2$ |\\n\\nWe now substitute and evaluate, as follows:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /4}\\\\frac{\\\\operatorname{tan}⁡x{sec}^{2}⁡x}{1+{tan}^{2}⁡x}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /4}\\\\frac{1}{1+{tan}^{2}⁡x}\\\\cdot \\\\operatorname{tan}⁡x{sec}^{2}⁡x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{1}^{2}\\\\frac{1}{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}{\\\\int }_{1}^{2}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}(\\\\operatorname{ln}⁡2-\\\\operatorname{ln}⁡1) \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡2\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"fc24eade-1b3d-5672-88fd-0bb48b371509\" :knowledge-point/question-generator {:db/id 17592186677604 :question-generator/id #uuid \"0410c7a8-bc55-5402-b03c-564f9f5071d7\" :question-generator/script \"generators/4b/4b2e25b742b9774b1ca671527404155a24785563eb88306aece872c5951d48a5/generator.py\"} :knowledge-point/questions [{:db/id 17592186069003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"86e493cf-4eca-5e4c-80d2-77afb41f75fd\" :answer/type {:db/ident :answer.type/math} :answer/value \"1 + \\\\sqrt{2} - \\\\ln 2\" :db/id 17592186065452} {:answer/id #uuid \"9165ce54-93c6-51e3-8558-20f309c69be9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln (1 + \\\\sqrt{2}) - \\\\ln 2\" :db/id 17592186065453} {:answer/id #uuid \"0344248e-4755-5685-a633-05cc9a0872eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln (1 + \\\\sqrt{2}) + \\\\ln 2\" :db/id 17592186065454} {:answer/id #uuid \"6e6c0845-9461-5d57-a858-7ed83c05ef06\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln (1 - \\\\sqrt{2}) + \\\\ln 2\" :db/id 17592186065455} {:answer/id #uuid \"7279b708-b196-52f0-9a24-096cbe3995a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln (1 - \\\\sqrt{2}) - \\\\ln 2\" :db/id 17592186065456}] :answer-field/id #uuid \"b7f369f9-7f9e-599a-8425-7c791428487b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186065451}] :question/id #uuid \"303d3df5-cfea-526f-9302-5030f9dcd8e5\" :question/math-academy-id \"q-10046\" :question/problem \"Evaluate the integral\\n$$\\n\\\\displaystyle \\\\int_{0}^{π/4}\\\\frac{\\\\sec x\\\\tan x}{1 + \\\\sec x}dx.\\n$$\"} {:db/id 17592186069378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9e43b630-b6a2-5123-a011-6042294f224b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln \\\\mid \\\\cos y \\\\mid + C\" :db/id 17592186067439} {:answer/id #uuid \"f749f18b-33e1-5e25-b75f-8ade5f77baf7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln \\\\mid \\\\sin y \\\\mid + C\" :db/id 17592186067440} {:answer/id #uuid \"fea5da83-a8a5-58ab-b1e2-dde7dcef46a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\ln \\\\mid \\\\cos y \\\\mid + C\" :db/id 17592186067441} {:answer/id #uuid \"07d38840-06f3-56fd-a5b1-61ad6d3fb4a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln \\\\mid \\\\cos 2y \\\\mid + C\" :db/id 17592186067442} {:answer/id #uuid \"5a2b6100-5623-5a6f-b406-0a18b42d30cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\ln \\\\mid \\\\sin y \\\\mid + C\" :db/id 17592186067443}] :answer-field/id #uuid \"b97e2c13-f2cd-5d1e-88da-f3dd5dd2b254\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186067438}] :question/id #uuid \"f1ed1cca-64de-51a1-af7d-232da14939bd\" :question/math-academy-id \"q-49557\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int\\\\frac{2\\\\cos y}{\\\\sin y}dy\\n$$?\"} {:db/id 17592186237790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"185fe2d1-eecd-5c47-9e9c-eca8f23689c6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(2+\\\\operatorname{sin}⁡(1))+\\\\operatorname{ln}⁡(2-\\\\operatorname{sin}⁡(1))\" :db/id 17592186235967} {:answer/id #uuid \"76b6ae8e-c79f-55ba-a4ee-eefbd27a16dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(1-\\\\operatorname{sin}⁡(2))-\\\\operatorname{ln}⁡(1+\\\\operatorname{sin}⁡(2))\" :db/id 17592186236561} {:answer/id #uuid \"a2d45765-acec-5856-a6ab-e36b05832cb4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(2-\\\\operatorname{sin}⁡(1))+\\\\operatorname{ln}⁡(2+\\\\operatorname{sin}⁡(1))\" :db/id 17592186236838} {:answer/id #uuid \"cc183065-84cd-56eb-a1d1-9d2feb89fa08\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(1+\\\\operatorname{sin}⁡(1))-\\\\operatorname{ln}⁡(1-\\\\operatorname{sin}⁡(1))\" :db/id 17592186237113} {:answer/id #uuid \"f48fc14e-d981-58be-9dc4-626252e8ef41\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{ln}⁡(1+\\\\operatorname{sin}⁡(2))-\\\\operatorname{ln}⁡(1-\\\\operatorname{sin}⁡(2))\" :db/id 17592186237361}] :answer-field/correct {:answer/id #uuid \"cc183065-84cd-56eb-a1d1-9d2feb89fa08\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(1+\\\\operatorname{sin}⁡(1))-\\\\operatorname{ln}⁡(1-\\\\operatorname{sin}⁡(1))\" :db/id 17592186237113} :answer-field/id #uuid \"34e59f25-dfe5-5cac-9866-d5a810c20c90\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186237513}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1f3bfc39-323e-5886-ac57-446859b38bb7\" :question/math-academy-id \"q-10045\" :question/problem \"$$\\n\\\\displaystyle {\\\\int }_{-1}^{1}\\\\frac{\\\\operatorname{cos}⁡x}{1+\\\\operatorname{sin}⁡x}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator, because\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}x}(1+\\\\operatorname{sin}⁡x)=\\\\operatorname{cos}⁡x.\\n$$\\n\\nSo, let $u=1+\\\\operatorname{sin}⁡x.$ Differentiating, we have \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\operatorname{cos}⁡x\\\\,⟹\\\\,\\\\text{d}u=\\\\operatorname{cos}⁡x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $-1$ | $1$ |\\n| --- | --- | --- |\\n| $u$ | $1-\\\\operatorname{sin}⁡(1)$ | $1+\\\\operatorname{sin}⁡(1)$ |\\n\\nWe now substitute and evaluate, as follows:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{-1}^{1}\\\\frac{\\\\operatorname{cos}⁡x}{1+\\\\operatorname{sin}⁡x}\\\\,\\\\text{d}x & ={\\\\int }_{-1}^{1}\\\\frac{1}{1+\\\\operatorname{sin}⁡x}\\\\cdot \\\\operatorname{cos}⁡x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{1-\\\\operatorname{sin}⁡(1)}^{1+\\\\operatorname{sin}⁡(1)}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{ln}⁡|u|{|}_{1-\\\\operatorname{sin}⁡(1)}^{1+\\\\operatorname{sin}⁡(1)} \\\\\\\\  & =\\\\operatorname{ln}⁡(1+\\\\operatorname{sin}⁡(1))-\\\\operatorname{ln}⁡(1-\\\\operatorname{sin}⁡(1))\\\\end{aligned}\\n$$\"} {:db/id 17592186250148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"21e3ecae-eebb-5e3a-a11b-f0a963c45845\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x|+C\" :db/id 17592186247724} {:answer/id #uuid \"40e20505-16c6-5378-838a-6646518a5bbc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x|+C\" :db/id 17592186247998} {:answer/id #uuid \"4c791187-2258-52f5-98d9-f31bd89f2b7f\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x+2|+C\" :db/id 17592186248106} {:answer/id #uuid \"c006ff4f-d73f-524e-9036-74de891bcd97\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x+2|+C\" :db/id 17592186249131} {:answer/id #uuid \"e4fe0ff3-3d1e-517d-9ef9-18da948a5fd5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x+2|+C\" :db/id 17592186249441}] :answer-field/correct {:answer/id #uuid \"e4fe0ff3-3d1e-517d-9ef9-18da948a5fd5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x+2|+C\" :db/id 17592186249441} :answer-field/id #uuid \"dee454e9-5772-5a92-9bc2-c3b4bcce16d4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186250054}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cf1ad1f8-f4e6-5785-9ed6-ccc3fe200091\" :question/math-academy-id \"q-113998\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{2\\\\operatorname{csc}⁡x\\\\operatorname{cot}⁡x}{\\\\operatorname{csc}⁡x+2}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u=\\\\operatorname{csc}⁡x+2.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-\\\\operatorname{csc}⁡x\\\\operatorname{cot}⁡x\\\\,⟹\\\\,-\\\\text{d}u=\\\\operatorname{csc}⁡x\\\\operatorname{cot}⁡x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{2\\\\operatorname{csc}⁡x\\\\operatorname{cot}⁡x}{\\\\operatorname{csc}⁡x+2}\\\\,\\\\text{d}x & =2\\\\int \\\\frac{1}{\\\\operatorname{csc}⁡x+2}\\\\cdot \\\\operatorname{csc}⁡x\\\\operatorname{cot}⁡x\\\\,\\\\text{d}x \\\\\\\\  & =2\\\\int \\\\frac{1}{u}\\\\cdot (-\\\\text{d}u) \\\\\\\\  & =-2\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =-2\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =-2\\\\operatorname{ln}⁡|\\\\operatorname{csc}⁡x+2|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186320749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1334b7fa-d127-5c64-b002-27ad26e5060d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186319444}] :answer-field/correct {:answer/id #uuid \"1334b7fa-d127-5c64-b002-27ad26e5060d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186319444} :answer-field/id #uuid \"f2b3eddf-4c98-5452-9b07-9d55d5e1acb3\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186320676}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f99bfe31-a733-5730-90f9-a01fb52dbe70\" :question/math-academy-id \"q-350887\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /2}\\\\frac{2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)}{{sin}^{2}⁡(x)+3}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u={sin}^{2}⁡(x)+3,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,⟹\\\\,\\\\text{d}u=2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /2$ |\\n| --- | --- | --- |\\n| $u$ | $3$ | $4$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /2}\\\\frac{2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)}{{sin}^{2}⁡(x)+3}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /2}\\\\frac{1}{{sin}^{2}⁡(x)+3}\\\\cdot 2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{3}^{4}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{ln}⁡|u|\\\\,{|}_{3}^{4} \\\\\\\\  & =\\\\operatorname{ln}⁡4-\\\\operatorname{ln}⁡3 \\\\\\\\  & =\\\\operatorname{ln}⁡\\\\left(\\\\frac{4}{3}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186320750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4af3f687-0fd5-5613-b369-2c62699adfdd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}\\\\left(\\\\frac{6}{5}\\\\right)\" :db/id 17592186319615}] :answer-field/correct {:answer/id #uuid \"4af3f687-0fd5-5613-b369-2c62699adfdd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}\\\\left(\\\\frac{6}{5}\\\\right)\" :db/id 17592186319615} :answer-field/id #uuid \"388b5a6e-6419-5e60-a343-6344e34c07b9\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186320295}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"efdb53cf-5359-5a73-8752-5be46ae654bd\" :question/math-academy-id \"q-350901\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /3}^{\\\\pi /2}\\\\frac{24\\\\operatorname{sin}⁡(x){cos}^{2}⁡(x)}{8{cos}^{3}⁡(x)+5}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=8{cos}^{3}⁡(x)+5,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}x}(8{cos}^{3}⁡(x)+5)=-24{cos}^{2}⁡(x)\\\\operatorname{sin}⁡(x).\\n$$\\n\\nSo, differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-24{cos}^{2}⁡(x)\\\\operatorname{sin}⁡(x)\\\\,⟹\\\\,-\\\\text{d}u=24\\\\operatorname{sin}⁡(x){cos}^{2}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /3$ | $\\\\pi /2$ |\\n| --- | --- | --- |\\n| $u$ | $6$ | $5$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /3}^{\\\\pi /2}\\\\frac{24\\\\operatorname{sin}⁡(x){cos}^{2}⁡(x)}{8{cos}^{3}⁡(x)+5}\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /3}^{\\\\pi /2}\\\\frac{1}{8{cos}^{3}⁡(x)+5}\\\\cdot 24\\\\operatorname{sin}⁡(x){cos}^{2}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{6}^{5}\\\\frac{1}{u}\\\\cdot (-\\\\text{d}u) \\\\\\\\  & =-{\\\\int }_{6}^{5}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{ln}⁡|u|{|}_{6}^{5} \\\\\\\\  & =-(\\\\operatorname{ln}⁡5-\\\\operatorname{ln}⁡6) \\\\\\\\  & =\\\\operatorname{ln}⁡\\\\left(\\\\frac{6}{5}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186320751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1fb74e6d-27ba-5dab-9bc3-14bcd6aca19d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186319487} {:answer/id #uuid \"bf2617d8-6d99-5cd0-a36b-cb5a85fa00c5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186429919}] :answer-field/correct {:answer/id #uuid \"bf2617d8-6d99-5cd0-a36b-cb5a85fa00c5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186429919} :answer-field/id #uuid \"eb778354-29e8-5b6b-9ab2-f74bbde5e184\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186320651}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8cafdf18-d2d8-5608-a2ba-c48b80df9a64\" :question/math-academy-id \"q-350904\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\frac{\\\\operatorname{csc}⁡(x)\\\\operatorname{cot}⁡(x)}{2+\\\\operatorname{csc}⁡(x)}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=2+\\\\operatorname{csc}⁡(x),$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-\\\\operatorname{csc}⁡(x)\\\\operatorname{cot}⁡(x)\\\\,⟹\\\\,-\\\\text{d}u=\\\\operatorname{csc}⁡(x)\\\\operatorname{cot}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /6$ | $\\\\pi /2$ |\\n| --- | --- | --- |\\n| $u$ | $4$ | $3$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\frac{\\\\operatorname{csc}⁡(x)\\\\operatorname{cot}⁡(x)}{2+\\\\operatorname{csc}⁡(x)}\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\frac{1}{2+\\\\operatorname{csc}⁡(x)}\\\\cdot (\\\\operatorname{csc}⁡(x)\\\\operatorname{cot}⁡(x))\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{4}^{3}\\\\frac{1}{u}\\\\,(-\\\\text{d}u) \\\\\\\\  & =-{\\\\int }_{4}^{3}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{ln}⁡|u|{|}_{4}^{3} \\\\\\\\  & =-(\\\\operatorname{ln}⁡3-\\\\operatorname{ln}⁡4) \\\\\\\\  & =\\\\operatorname{ln}⁡\\\\left(\\\\frac{4}{3}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186342058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4ebec160-c5ac-548d-a451-e22560d5e12b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡|\\\\operatorname{cos}⁡({y}^{2})|+C\" :db/id 17592186339843} {:answer/id #uuid \"7b8992b4-908e-5460-ac2b-f416bb5dc366\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{ln}⁡|\\\\operatorname{cos}⁡({y}^{2})|+C\" :db/id 17592186340237} {:answer/id #uuid \"8e5a7820-a12c-5bfc-bde4-617efde18d2e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡|\\\\operatorname{sin}⁡({y}^{2})|+C\" :db/id 17592186340408} {:answer/id #uuid \"cab5ae41-b98b-5ba7-a67b-473710627bc1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{ln}⁡|\\\\operatorname{cos}⁡({y}^{2})|+C\" :db/id 17592186340922} {:answer/id #uuid \"cd94d4a2-ccc1-5dba-be7a-60f4ca899cad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{ln}⁡|\\\\operatorname{sin}⁡({y}^{2})|+C\" :db/id 17592186340953}] :answer-field/correct {:answer/id #uuid \"cd94d4a2-ccc1-5dba-be7a-60f4ca899cad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{ln}⁡|\\\\operatorname{sin}⁡({y}^{2})|+C\" :db/id 17592186340953} :answer-field/id #uuid \"d39a8b1c-171e-529f-bad2-ef340a8e19a9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341755}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"0b965c69-7854-507b-827e-0b6fbbb52fef\" :question/math-academy-id \"q-73674\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{y\\\\operatorname{cos}⁡({y}^{2})}{\\\\operatorname{sin}⁡({y}^{2})}\\\\,\\\\text{d}y.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator, because\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}y}(\\\\operatorname{sin}⁡({y}^{2}))=2y\\\\operatorname{cos}⁡({y}^{2}).\\n$$\\n\\nSo, let $u=\\\\operatorname{sin}⁡({y}^{2}).$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}y}=2y\\\\operatorname{cos}⁡({y}^{2})\\\\,⟹\\\\,\\\\frac{1}{2}\\\\,\\\\text{d}u=y\\\\operatorname{cos}⁡({y}^{2})\\\\,\\\\text{d}y.\\n$$\\n\\nWe now substitute and evaluate, as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{y\\\\operatorname{cos}⁡({y}^{2})}{\\\\operatorname{sin}⁡({y}^{2})}\\\\,\\\\text{d}y & =\\\\int \\\\frac{1}{\\\\operatorname{sin}⁡({y}^{2})}\\\\cdot (y\\\\operatorname{cos}⁡({y}^{2}))\\\\,\\\\text{d}y \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|\\\\operatorname{sin}⁡({y}^{2})|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186429930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5e5262af-da0e-5a59-8704-7c9dacf4de2f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{tan}^{2}⁡x}{2}-\\\\operatorname{tan}⁡x+K\" :db/id 17592186429914} {:answer/id #uuid \"9f63075a-1c8a-5a7b-92d3-a38ee960a89e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡x-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x+1|+K\" :db/id 17592186429916} {:answer/id #uuid \"9fd0f034-ce27-5ace-8026-4eaf6cb1ce68\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡(x-1)-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x+1|+K\" :db/id 17592186429917} {:answer/id #uuid \"f18bdd3d-8085-5e2e-822e-62d75b040c5c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡(x+1)-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x|+K\" :db/id 17592186429923} {:answer/id #uuid \"f602ed78-2e15-5cdc-81a3-3dc36a33f074\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡x-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x|+K\" :db/id 17592186429925}] :answer-field/correct {:answer/id #uuid \"9f63075a-1c8a-5a7b-92d3-a38ee960a89e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡x-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x+1|+K\" :db/id 17592186429916} :answer-field/id #uuid \"5edcce3e-e53a-5f19-ab28-fc88ce15b3a5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186429926}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"305ab7d8-b9f8-5861-8b01-dd9a503b80df\" :question/math-academy-id \"q-113997\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{{sec}^{2}⁡x\\\\operatorname{tan}⁡x}{\\\\operatorname{tan}⁡x+1}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u=\\\\operatorname{tan}⁡x+1.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={sec}^{2}⁡x\\\\,⟹\\\\,\\\\text{d}u={sec}^{2}⁡x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{sec}^{2}⁡x\\\\operatorname{tan}⁡x}{\\\\operatorname{tan}⁡x+1}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{\\\\operatorname{tan}⁡x+1}\\\\cdot {sec}^{2}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{\\\\operatorname{tan}⁡x+1}\\\\cdot \\\\operatorname{tan}⁡x\\\\cdot {sec}^{2}⁡x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}(u-1)\\\\text{d}u \\\\\\\\  & =\\\\int (1-\\\\frac{1}{u})\\\\,\\\\text{d}u \\\\\\\\  & =u-\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =(\\\\operatorname{tan}⁡x+1)-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x+1|+C \\\\\\\\  & =\\\\operatorname{tan}⁡x-\\\\operatorname{ln}⁡|\\\\operatorname{tan}⁡x+1|+K\\\\end{aligned}\\n$$\\n\\nwhere $K=C+1.$\"} {:db/id 17592186487529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"23cf7ff8-ac0a-583b-9194-64e241ac34ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487525} {:answer/id #uuid \"2f886dbf-5e77-59c5-b9f8-0d0800987e35\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487526} {:answer/id #uuid \"6c032907-c215-5c0a-8b01-3af3123417e4\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\ln|\\\\cos{\\\\left(2 x \\\\right)}|+C\" :db/id 17592186487535} {:answer/id #uuid \"74a107be-c47e-5e9f-a02e-5aacc9f7ae55\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487538} {:answer/id #uuid \"936f452b-de84-532f-83e7-1207a5463f1b\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487540}] :answer-field/correct {:answer/id #uuid \"23cf7ff8-ac0a-583b-9194-64e241ac34ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487525} :answer-field/id #uuid \"bd4fdade-a996-587b-b242-5642b13e79d9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186487542}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"459a1856-08e3-58a5-a323-78e543c7636b\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int \\\\frac{12 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x\\n$$?\" :question/retired true :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{12 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x &= 12\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\ &= 12\\\\ln|u|+C \\\\\\\\ &= 12\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186487530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ed0b69d-8844-542b-a022-2ac49874c1d3\" :answer/type {:db/ident :answer.type/math} :answer/value \"10\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487519} {:answer/id #uuid \"22fb7175-bd4b-5f6d-9edd-8332a76c2511\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487524} {:answer/id #uuid \"c18bbf4d-3ca1-53e6-8d27-ed0ce5740719\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\ln|\\\\cos{\\\\left(2 x \\\\right)}|+C\" :db/id 17592186487543} {:answer/id #uuid \"ce6ea91f-0c79-53bc-a963-521fef76d0ad\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487547} {:answer/id #uuid \"ed9c0331-dc0d-5796-b21a-3236521cb610\" :answer/type {:db/ident :answer.type/math} :answer/value \"10\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487551}] :answer-field/correct {:answer/id #uuid \"ed9c0331-dc0d-5796-b21a-3236521cb610\" :answer/type {:db/ident :answer.type/math} :answer/value \"10\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487551} :answer-field/id #uuid \"443cef31-03e1-58e4-9184-90224f755907\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186487528}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"506f1a8f-ac78-5b6b-a7d4-2626e81c6ae4\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int \\\\frac{10 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x\\n$$?\" :question/retired true :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{10 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x &= 10\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\ &= 10\\\\ln|u|+C \\\\\\\\ &= 10\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186487536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e9be174-390d-54e4-a3e4-976e630a0775\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487521} {:answer/id #uuid \"20675308-ba26-5814-9099-4d6a5aa269aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487522} {:answer/id #uuid \"2217b3ce-3120-59ad-a32c-b25adbdfe3cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487523} {:answer/id #uuid \"73e70d84-59dd-567b-bcd8-6355ab50c465\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\ln|\\\\cos{\\\\left(2 x \\\\right)}|+C\" :db/id 17592186487537} {:answer/id #uuid \"fa5b9eed-5d22-527e-bec7-4f2a6d50a878\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487552}] :answer-field/correct {:answer/id #uuid \"fa5b9eed-5d22-527e-bec7-4f2a6d50a878\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487552} :answer-field/id #uuid \"01ef7e32-d7cb-534b-91ae-cd39a184e31c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186487518}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"6d12445d-3523-59d2-975c-8479b75a0de1\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int \\\\frac{4 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x\\n$$?\" :question/retired true :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{4 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x &= 4\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\ &= 4\\\\ln|u|+C \\\\\\\\ &= 4\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186487541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"12be31af-33e6-533c-b43c-df530db8a53e\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\ln|\\\\cos{\\\\left(2 x \\\\right)}|+C\" :db/id 17592186487520} {:answer/id #uuid \"63550523-6b44-51dc-8b90-f25fcaa6964f\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487533} {:answer/id #uuid \"c4d56462-2c53-5292-b5dd-9141ecf775bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487544} {:answer/id #uuid \"c6de0190-86b7-511d-a84b-04d8d6445003\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487545} {:answer/id #uuid \"cd3030db-8e37-5a82-a2b5-9f3e5c97fbc0\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487546}] :answer-field/correct {:answer/id #uuid \"c4d56462-2c53-5292-b5dd-9141ecf775bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487544} :answer-field/id #uuid \"ed5838e0-9886-563d-bc6e-695ec8b26180\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186487550}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b96cc90a-35c7-5b03-8d60-2bbab937f8a9\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int \\\\frac{6 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x\\n$$?\" :question/retired true :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{6 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x &= 6\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\ &= 6\\\\ln|u|+C \\\\\\\\ &= 6\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186487549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2f950554-f2ea-5fdd-88cc-0a3087be60f1\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487527} {:answer/id #uuid \"56da9bcd-de98-551c-9e68-0327b5d0fca5\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\ln|\\\\cos{\\\\left(x \\\\right)}|+C\" :db/id 17592186487532} {:answer/id #uuid \"63e78026-d2b5-50aa-b3e9-0f7929bfdf9e\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487534} {:answer/id #uuid \"76354bd2-33da-5ed2-a107-7c4e3e5d14b5\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487539} {:answer/id #uuid \"de9dab10-8cad-591f-b747-fdbf496601ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\ln|\\\\cos{\\\\left(2 x \\\\right)}|+C\" :db/id 17592186487548}] :answer-field/correct {:answer/id #uuid \"63e78026-d2b5-50aa-b3e9-0f7929bfdf9e\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\" :db/id 17592186487534} :answer-field/id #uuid \"5300ef6b-7c36-55eb-af80-9a4052e28072\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186487531}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e88b2308-4616-50fe-8f78-409a09f81009\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int \\\\frac{8 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x\\n$$?\" :question/retired true :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{8 \\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)}}\\\\,\\\\text{d}x &= 8\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\ &= 8\\\\ln|u|+C \\\\\\\\ &= 8\\\\ln|\\\\sin{\\\\left(x \\\\right)}|+C\\\\end{aligned}\\n$$\"} {:db/id 17592186580897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f8233fce-5fa1-504d-a858-b5359a37944d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\ln\\\\left(\\\\frac{5}{2}\\\\right)\" :db/id 17592186580778}] :answer-field/correct {:answer/id #uuid \"f8233fce-5fa1-504d-a858-b5359a37944d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\ln\\\\left(\\\\frac{5}{2}\\\\right)\" :db/id 17592186580778} :answer-field/id #uuid \"f2d8f522-565f-5640-81d7-21d42b1024a7\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186580876}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"2ed18e1b-5d9e-5d88-b764-bf87259e7a34\" :question/math-academy-id \"q-350908\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /4}\\\\frac{{sec}^{2}⁡(x)}{2+3\\\\operatorname{tan}⁡(x)}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=2+3\\\\operatorname{tan}⁡(x),$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{sec}^{2}⁡(x)\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={sec}^{2}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /4$ |\\n| --- | --- | --- |\\n| $u$ | $2$ | $5$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /4}\\\\frac{{sec}^{2}⁡(x)}{2+3\\\\operatorname{tan}⁡(x)}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /4}\\\\frac{1}{2+3\\\\operatorname{tan}⁡(x)}\\\\cdot {sec}^{2}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{2}^{5}\\\\frac{1}{u}\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}{\\\\int }_{2}^{5}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{ln}⁡|u|{|}_{2}^{5} \\\\\\\\  & =\\\\frac{1}{3}(\\\\operatorname{ln}⁡5-\\\\operatorname{ln}⁡2) \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{5}{2}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186580904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9862e91c-0efe-5bb8-8925-45bc31839846\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186580645}] :answer-field/correct {:answer/id #uuid \"9862e91c-0efe-5bb8-8925-45bc31839846\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(\\\\frac{4}{3}\\\\right)\" :db/id 17592186580645} :answer-field/id #uuid \"65d0530e-816a-5976-ad52-1c7704a78646\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186580830}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"49d4a023-e567-5ef0-bff2-0a05874f4d54\" :question/math-academy-id \"q-350892\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /3}\\\\frac{\\\\operatorname{sec}⁡(x)\\\\operatorname{tan}⁡(x)}{2+\\\\operatorname{sec}⁡(x)}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=2+\\\\operatorname{sec}⁡(x),$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\operatorname{sec}⁡(x)\\\\operatorname{tan}⁡(x)\\\\,⟹\\\\,\\\\text{d}u=\\\\operatorname{sec}⁡(x)\\\\operatorname{tan}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /3$ |\\n| --- | --- | --- |\\n| $u$ | $3$ | $4$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /3}\\\\frac{\\\\operatorname{sec}⁡(x)\\\\operatorname{tan}⁡(x)}{2+\\\\operatorname{sec}⁡(x)}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /3}\\\\frac{1}{2+\\\\operatorname{sec}⁡(x)}\\\\cdot \\\\operatorname{sec}⁡(x)\\\\operatorname{tan}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{3}^{4}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{ln}⁡|u|\\\\,{|}_{3}^{4} \\\\\\\\  & =\\\\operatorname{ln}⁡4-\\\\operatorname{ln}⁡3 \\\\\\\\  & =\\\\operatorname{ln}⁡\\\\left(\\\\frac{4}{3}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186580917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4372d15c-6169-5803-bfb8-66c3f2f3cbf5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡|{tan}^{3}⁡x|+C\" :db/id 17592186580500} {:answer/id #uuid \"4deac130-288d-5045-b1d2-b52497fdefa0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{(1+{tan}^{3}⁡x)^{2}}{6}+C\" :db/id 17592186580520} {:answer/id #uuid \"61729743-7563-55d5-8b83-b7ddbc821b96\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡|1+{tan}^{3}⁡x|+C\" :db/id 17592186580551} {:answer/id #uuid \"6264dfba-3484-5fd9-b5f3-94b863b01f18\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|{tan}^{3}⁡x|}{3}+C\" :db/id 17592186580552} {:answer/id #uuid \"aa07f6f8-4014-5a7c-801e-34f67c5ef101\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|1+{tan}^{3}⁡x|}{3}+C\" :db/id 17592186580670}] :answer-field/correct {:answer/id #uuid \"aa07f6f8-4014-5a7c-801e-34f67c5ef101\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|1+{tan}^{3}⁡x|}{3}+C\" :db/id 17592186580670} :answer-field/id #uuid \"32eb1b68-1758-57ca-a900-b98c6ab2561c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580809}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"6921b481-ec14-522b-b9b9-dcaba2949b0c\" :question/math-academy-id \"q-113987\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{{tan}^{2}⁡x{sec}^{2}⁡x}{1+{tan}^{3}⁡x}\\\\,\\\\text{d}x\\n$$\" :question/worked-solution \"Let $u=1+{tan}^{3}⁡x.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{tan}^{2}⁡x\\\\cdot {sec}^{2}⁡x\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={tan}^{2}⁡x{sec}^{2}⁡x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{tan}^{2}⁡x{sec}^{2}⁡x}{1+{tan}^{3}⁡x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{1+{tan}^{3}⁡x}\\\\cdot {tan}^{2}⁡x{sec}^{2}⁡x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot (\\\\frac{1}{3}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{3}\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{ln}⁡|1+{tan}^{3}⁡x|+C \\\\\\\\  & =\\\\frac{\\\\operatorname{ln}⁡|1+{tan}^{3}⁡x|}{3}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186580921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"45daf244-4c3f-5472-93a8-da7d6c3bdccd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{9}{16}\\\\right)\" :db/id 17592186580505} {:answer/id #uuid \"52196bc9-8d38-5c9d-83d2-2c96f288c9a8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡\\\\left(\\\\frac{4}{9}\\\\right)\" :db/id 17592186580525} {:answer/id #uuid \"b5431721-a52a-5556-b365-52a555669b07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{16}{9}\\\\right)\" :db/id 17592186580682} {:answer/id #uuid \"d171db58-409b-5e77-8fc1-6b70a1ac11c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡\\\\left(\\\\frac{9}{2}\\\\right)\" :db/id 17592186580716} {:answer/id #uuid \"e3853a5f-a3bd-5d18-8620-4554383b00ec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{9}{8}\\\\right)\" :db/id 17592186580745}] :answer-field/correct {:answer/id #uuid \"b5431721-a52a-5556-b365-52a555669b07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{16}{9}\\\\right)\" :db/id 17592186580682} :answer-field/id #uuid \"1444f051-3ccb-51c7-99bf-4f860a1031ca\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580800}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"86968101-fa3c-5286-a648-9b995fa5fe70\" :question/math-academy-id \"q-114003\" :question/problem \"Evaluate the integral\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /3}\\\\frac{\\\\operatorname{sin}⁡x{cos}^{2}⁡x}{{cos}^{3}⁡x+1}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator, because\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}x}({cos}^{3}⁡x+1)=-3{cos}^{2}⁡x\\\\operatorname{sin}⁡x.\\n$$\\n\\nSo, let $u={cos}^{3}⁡x+1.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-3{cos}^{2}⁡x\\\\operatorname{sin}⁡x\\\\,⟹\\\\,-\\\\frac{1}{3}\\\\text{d}u={cos}^{2}⁡x\\\\operatorname{sin}⁡x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /3$ |\\n| --- | --- | --- |\\n| $u$ | $2$ | $9/8$ |\\n\\nWe now substitute and evaluate, as follows:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /3}\\\\frac{\\\\operatorname{sin}⁡x{cos}^{2}⁡x}{{cos}^{3}⁡x+1}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /3}\\\\frac{1}{{cos}^{3}⁡x+1}\\\\cdot \\\\operatorname{sin}⁡x{cos}^{2}⁡x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{2}^{9/8}\\\\frac{1}{u}\\\\cdot \\\\left(-\\\\frac{1}{3}\\\\right)\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{3}{\\\\int }_{2}^{9/8}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{3}\\\\operatorname{ln}⁡|u|{|}_{2}^{9/8} \\\\\\\\  & =-\\\\frac{1}{3}(\\\\operatorname{ln}⁡\\\\left(\\\\frac{9}{8}\\\\right)-\\\\operatorname{ln}⁡(2)) \\\\\\\\  & =\\\\frac{1}{3}(\\\\operatorname{ln}⁡(2)-\\\\operatorname{ln}⁡\\\\left(\\\\frac{9}{8}\\\\right)) \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{2}{\\\\left(\\\\frac{9}{8}\\\\right)}\\\\right) \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{ln}⁡\\\\left(\\\\frac{16}{9}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186601906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1076235e-749e-5a4a-9320-4c7fadf47260\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\" :db/id 17592186601606} {:answer/id #uuid \"175ac7d8-8458-5a41-b3c3-c89df547e0fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(2)\" :db/id 17592186601615} {:answer/id #uuid \"9c6341ab-6fb8-5ddb-a50c-adef3352e253\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{ln}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\" :db/id 17592186601719} {:answer/id #uuid \"af3073c6-be0b-56c9-82b5-e45a8a289d90\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡(2)}{2}\" :db/id 17592186601734} {:answer/id #uuid \"b485a7b4-df9d-511e-8b4f-3dedf91fe647\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{ln}⁡(2)\" :db/id 17592186601741}] :answer-field/correct {:answer/id #uuid \"af3073c6-be0b-56c9-82b5-e45a8a289d90\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡(2)}{2}\" :db/id 17592186601734} :answer-field/id #uuid \"d11d6f61-1356-5f40-bb93-ae94797c1250\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186601874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3a066d83-0a5d-5a8a-a634-adb2f5d14194\" :question/math-academy-id \"q-114004\" :question/problem \"Evaluate the integral\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\sqrt{\\\\pi }/2}\\\\frac{x{sec}^{2}⁡({x}^{2})}{1+\\\\operatorname{tan}⁡({x}^{2})}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator, because\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}x}(1+\\\\operatorname{tan}⁡({x}^{2}))=2x{sec}^{2}⁡({x}^{2}).\\n$$\\n\\nSo, let $u=1+\\\\operatorname{tan}⁡({x}^{2}).$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x{sec}^{2}⁡({x}^{2})\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=x{sec}^{2}⁡({x}^{2})\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\sqrt{\\\\pi }/2$ |\\n| --- | --- | --- |\\n| $u$ | $1$ | $2$ |\\n\\nWe now substitute and evaluate, as follows:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\sqrt{\\\\pi }/2}\\\\frac{x{sec}^{2}⁡({x}^{2})}{1+\\\\operatorname{tan}⁡({x}^{2})}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\sqrt{\\\\pi }/2}\\\\frac{1}{1+\\\\operatorname{tan}⁡({x}^{2})}\\\\cdot x{sec}^{2}⁡({x}^{2})\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{1}^{2}\\\\frac{1}{u}\\\\cdot \\\\frac{1}{2}\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}{\\\\int }_{1}^{2}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|u|{|}_{1}^{2} \\\\\\\\  & =\\\\frac{1}{2}(\\\\operatorname{ln}⁡(2)-\\\\operatorname{ln}⁡(1)) \\\\\\\\  & =\\\\frac{\\\\operatorname{ln}⁡(2)}{2}\\\\end{aligned}\\n$$\"} {:db/id 17592186605890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1d3db550-ee1e-555b-bc06-390b655b9f88\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{ln}⁡(\\\\operatorname{cot}⁡z{csc}^{2}⁡z)+C\" :db/id 17592186605303} {:answer/id #uuid \"8f72f014-9e7c-59fb-98ca-5331183256fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{ln}⁡(\\\\operatorname{cot}⁡z{csc}^{2}⁡z)+C\" :db/id 17592186605506} {:answer/id #uuid \"93f3445d-8a85-5c2f-8baa-633dd26d1b5d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C\" :db/id 17592186605516} {:answer/id #uuid \"c36518f3-9d8f-570c-bc9d-9d52b3886265\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C\" :db/id 17592186605603} {:answer/id #uuid \"f9e87827-2dcf-5ee9-ae1c-1a99767181e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C\" :db/id 17592186605704}] :answer-field/correct {:answer/id #uuid \"c36518f3-9d8f-570c-bc9d-9d52b3886265\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C\" :db/id 17592186605603} :answer-field/id #uuid \"b32f6229-f7ef-5aeb-8794-e2748decb297\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186605801}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"9da80b7e-7d28-5432-bd06-d6318df2aa62\" :question/math-academy-id \"q-73679\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{\\\\operatorname{cot}⁡z{csc}^{2}⁡z}{5+{cot}^{2}⁡z}\\\\,\\\\text{d}z.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator, because\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}z}(5+{cot}^{2}⁡z)=-2\\\\operatorname{cot}⁡z{csc}^{2}⁡z.\\n$$\\n\\nSo, let $u=5+{cot}^{2}⁡z.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}z}=-2\\\\operatorname{cot}⁡z{csc}^{2}⁡z\\\\,⟹\\\\,-\\\\frac{1}{2}\\\\text{d}u=\\\\operatorname{cot}⁡z{csc}^{2}⁡z\\\\,\\\\text{d}z.\\n$$\\n\\nWe now substitute and evaluate, as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{\\\\operatorname{cot}⁡z{csc}^{2}⁡z}{5+{cot}^{2}⁡z}\\\\,\\\\text{d}z & =\\\\int \\\\frac{1}{5+{cot}^{2}⁡z}\\\\cdot (\\\\operatorname{cot}⁡z{csc}^{2}⁡z)\\\\,\\\\text{d}z \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\,(-\\\\frac{1}{2}\\\\,\\\\text{d}u) \\\\\\\\  & =-\\\\frac{1}{2}\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{ln}⁡|5+{cot}^{2}⁡z|+C \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C\\\\end{aligned}\\n$$\\n\\nNotice that, in the last step, we used that fact that $5+{cot}^{2}⁡z>0$ for all $z.$\"} {:db/id 17592186611592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1abbf2fd-661b-577d-a513-f229acab8823\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x+2|+K\" :db/id 17592186611113} {:answer/id #uuid \"2bddba74-b12f-51cd-bb38-9bf41ed23c8d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡x-2\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x|+K\" :db/id 17592186611134} {:answer/id #uuid \"47a14ae1-4a94-5f9b-be11-89fb0f1c002d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡x-\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x|+K\" :db/id 17592186611176} {:answer/id #uuid \"736a618d-d978-55b7-b28d-0258c647fa80\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡x-2\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x+2|+K\" :db/id 17592186611253} {:answer/id #uuid \"cb5b8794-e086-5e47-875a-8960900d59f8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{sec}^{2}⁡x}{2}-2(\\\\operatorname{sec}⁡x+2)+K\" :db/id 17592186611382}] :answer-field/correct {:answer/id #uuid \"736a618d-d978-55b7-b28d-0258c647fa80\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡x-2\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x+2|+K\" :db/id 17592186611253} :answer-field/id #uuid \"39bad3fb-fb66-55d6-a03e-191c31db083f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186611483}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"608e4079-c5cf-5bc1-86f5-dc3d95b6c536\" :question/math-academy-id \"q-113992\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{{sec}^{2}⁡x\\\\operatorname{tan}⁡x}{\\\\operatorname{sec}⁡x+2}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u=\\\\operatorname{sec}⁡x+2.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,⟹\\\\,\\\\text{d}u=\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{sec}^{2}⁡x\\\\operatorname{tan}⁡x}{\\\\operatorname{sec}⁡x+2}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{\\\\operatorname{sec}⁡x+2}\\\\cdot {sec}^{2}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{\\\\operatorname{sec}⁡x+2}\\\\cdot \\\\operatorname{sec}⁡x\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}(u-2)\\\\text{d}u \\\\\\\\  & =\\\\int (1-\\\\frac{2}{u})\\\\,\\\\text{d}u \\\\\\\\  & =u-2\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =(\\\\operatorname{sec}⁡x+2)-2\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x+2|+C \\\\\\\\  & =\\\\operatorname{sec}⁡x-2\\\\operatorname{ln}⁡|\\\\operatorname{sec}⁡x+2|+K\\\\end{aligned}\\n$$\\n\\nwhere $K=C+2.$\"} {:db/id 17592186611635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4f681274-8155-51ee-ad77-348e7876de6e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(2-\\\\frac{\\\\sqrt{3}}{3}\\\\right)\" :db/id 17592186611184}] :answer-field/correct {:answer/id #uuid \"4f681274-8155-51ee-ad77-348e7876de6e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(2-\\\\frac{\\\\sqrt{3}}{3}\\\\right)\" :db/id 17592186611184} :answer-field/id #uuid \"0e64f1c3-2bf6-5c85-8785-62d619c1e862\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186611468}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cb44b163-37d5-508d-9ab8-65534f9ef9d3\" :question/math-academy-id \"q-350899\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /4}^{\\\\pi /3}\\\\frac{{csc}^{2}⁡(x)}{2-\\\\operatorname{cot}⁡(x)}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=2-\\\\operatorname{cot}⁡(x),$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={csc}^{2}⁡(x)\\\\,⟹\\\\,\\\\text{d}u={csc}^{2}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /4$ | $\\\\pi /3$ |\\n| --- | --- | --- |\\n| $u$ | $1$ | $2-1/\\\\sqrt{3}$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /4}^{\\\\pi /3}\\\\frac{{csc}^{2}⁡(x)}{2-\\\\operatorname{cot}⁡(x)}\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /4}^{\\\\pi /3}\\\\frac{1}{2-\\\\operatorname{cot}⁡(x)}\\\\cdot {csc}^{2}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{1}^{\\\\,2-1/\\\\sqrt{3}}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{ln}⁡|u|\\\\,{|}_{1}^{\\\\,2-1/\\\\sqrt{3}} \\\\\\\\  & =ln\\\\,(2-\\\\frac{1}{\\\\sqrt{3}})-\\\\operatorname{ln}⁡1 \\\\\\\\  & =\\\\operatorname{ln}⁡(2-\\\\frac{1}{\\\\sqrt{3}})\\\\end{aligned}\\n$$\"} {:db/id 17592186658911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e4c71a0a-4275-5b8a-bccf-d4231b72bd35\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\ln\\\\left(\\\\frac{11}{9}\\\\right)\" :db/id 17592186658749}] :answer-field/correct {:answer/id #uuid \"e4c71a0a-4275-5b8a-bccf-d4231b72bd35\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\ln\\\\left(\\\\frac{11}{9}\\\\right)\" :db/id 17592186658749} :answer-field/id #uuid \"b397fe91-52a9-5cb2-bc6b-e513305ae845\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186658883}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"04020b90-365b-571a-8c75-e2c949d4627a\" :question/math-academy-id \"q-350900\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /6}^{\\\\pi /3}\\\\frac{\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)}{{sin}^{2}⁡(x)+2}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u={sin}^{2}⁡(x)+2,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}}{\\\\text{d}x}({sin}^{2}⁡(x)+2)=2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x).\\n$$\\n\\nSo, differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /6$ | $\\\\pi /3$ |\\n| --- | --- | --- |\\n| $u$ | $9/4$ | $11/4$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /6}^{\\\\pi /3}\\\\frac{\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)}{{sin}^{2}⁡(x)+2}\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /6}^{\\\\pi /3}\\\\frac{1}{{sin}^{2}⁡(x)+2}\\\\cdot \\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{9/4}^{11/4}\\\\frac{1}{u}\\\\cdot \\\\frac{1}{2}\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}{\\\\int }_{9/4}^{11/4}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|u|{|}_{9/4}^{11/4} \\\\\\\\  & =\\\\frac{1}{2}(\\\\operatorname{ln}⁡\\\\left(\\\\frac{11}{4}\\\\right)-\\\\operatorname{ln}⁡\\\\left(\\\\frac{9}{4}\\\\right)) \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡\\\\left(\\\\frac{11}{9}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186658945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"28e86867-633f-551d-9bf0-b746c8e64385\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(\\\\frac{3}{2}\\\\right)\" :db/id 17592186658463}] :answer-field/correct {:answer/id #uuid \"28e86867-633f-551d-9bf0-b746c8e64385\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left(\\\\frac{3}{2}\\\\right)\" :db/id 17592186658463} :answer-field/id #uuid \"5fdcf189-7f8c-5cef-a469-75e9f58c3e36\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186658856}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"621ac2af-aa8d-5c1e-9e0f-da9ef50c366f\" :question/math-academy-id \"q-346380\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /2}\\\\frac{2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)}{{cos}^{2}⁡(x)+2}\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u={cos}^{2}⁡(x)+2,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,⟹\\\\,-\\\\text{d}u=2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /2$ |\\n| --- | --- | --- |\\n| $u$ | $3$ | $2$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /2}\\\\frac{2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)}{{cos}^{2}⁡(x)+2}\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /2}\\\\frac{1}{{cos}^{2}⁡(x)+2}\\\\cdot 2\\\\operatorname{sin}⁡(x)\\\\operatorname{cos}⁡(x)\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{3}^{2}\\\\frac{1}{u}\\\\,(-\\\\text{d}u) \\\\\\\\  & =-{\\\\int }_{3}^{2}\\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{ln}⁡|u|\\\\,{|}_{3}^{2} \\\\\\\\  & =-(\\\\operatorname{ln}⁡2-\\\\operatorname{ln}⁡3) \\\\\\\\  & =\\\\operatorname{ln}⁡3-\\\\operatorname{ln}⁡2 \\\\\\\\  & =\\\\operatorname{ln}⁡\\\\left(\\\\frac{3}{2}\\\\right)\\\\end{aligned}\\n$$\"} {:db/id 17592186677532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677600}] :answer-field/correct {:answer/id #uuid \"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677600} :answer-field/id #uuid \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677569}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right)\" :db/id 17592186677576}] :answer-field/correct {:answer/id #uuid \"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right)\" :db/id 17592186677576} :answer-field/id #uuid \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677570}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{6}} \\\\frac{- 7 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}}{4 \\\\sec{\\\\left(2 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=4 \\\\sec{\\\\left(2 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=3 + 4 \\\\sqrt{2}\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=11\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{6}} \\\\frac{- 7 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}}{4 \\\\sec{\\\\left(2 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{8}\\\\left(\\\\int_{3 + 4 \\\\sqrt{2}}^{11} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{7}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3 + 4 \\\\sqrt{2}}^{11}\\\\right)=- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(3 + 4 \\\\sqrt{2}\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\" :db/id 17592186677584}] :answer-field/correct {:answer/id #uuid \"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\" :db/id 17592186677584} :answer-field/id #uuid \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677588}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 9 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=16 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 9 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{9}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{9}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right)\" :db/id 17592186677544}] :answer-field/correct {:answer/id #uuid \"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right)\" :db/id 17592186677544} :answer-field/id #uuid \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677543}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{10}} \\\\frac{- 5 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=40 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=5\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{10}} \\\\frac{- 5 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{8}\\\\left(\\\\int_{5}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{5}^{9}\\\\right)=- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\" :db/id 17592186677583}] :answer-field/correct {:answer/id #uuid \"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\" :db/id 17592186677583} :answer-field/id #uuid \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677591}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{7 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}}{\\\\csc{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{7 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}}{\\\\csc{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677562}] :answer-field/correct {:answer/id #uuid \"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677562} :answer-field/id #uuid \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677593}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)\" :db/id 17592186677596}] :answer-field/correct {:answer/id #uuid \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)\" :db/id 17592186677596} :answer-field/id #uuid \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677577}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"31af3e89-444a-5351-ab86-623f9917660d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{\\\\tan{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(4 x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSince $\\\\tan{\\\\left(4 x \\\\right)}=u-2$, the remaining quotient is\\n\\n$$\\n\\\\frac{u-2}{u}=1-\\\\frac{2}{u}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{\\\\tan{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int 1 - \\\\frac{2}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int 1 - \\\\frac{2}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(u-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)+C.\\n$$\"} {:db/id 17592186677553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\" :db/id 17592186677578}] :answer-field/correct {:answer/id #uuid \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\" :db/id 17592186677578} :answer-field/id #uuid \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677575}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 30 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)\" :db/id 17592186677568}] :answer-field/correct {:answer/id #uuid \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)\" :db/id 17592186677568} :answer-field/id #uuid \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677601}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 7 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}}{2 \\\\sec{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=2 \\\\sec{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 7 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}}{2 \\\\sec{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677581}] :answer-field/correct {:answer/id #uuid \"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677581} :answer-field/id #uuid \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x \\\\right)}}{\\\\sin{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(4 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\cos{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x \\\\right)}}{\\\\sin{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\" :db/id 17592186677536}] :answer-field/correct {:answer/id #uuid \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\" :db/id 17592186677536} :answer-field/id #uuid \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677597}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=24 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677540}] :answer-field/correct {:answer/id #uuid \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677540} :answer-field/id #uuid \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677573}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\cos{\\\\left(5 x \\\\right)}}{\\\\sin{\\\\left(5 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(5 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5 \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\cos{\\\\left(5 x \\\\right)}}{\\\\sin{\\\\left(5 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)\" :db/id 17592186677595}] :answer-field/correct {:answer/id #uuid \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)\" :db/id 17592186677595} :answer-field/id #uuid \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677548}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 36 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{36}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{36}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)\" :db/id 17592186677559}] :answer-field/correct {:answer/id #uuid \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)\" :db/id 17592186677559} :answer-field/id #uuid \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677563}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}}{2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 16 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}}{2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677550}] :answer-field/correct {:answer/id #uuid \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677550} :answer-field/id #uuid \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677533}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{8 \\\\sin{\\\\left(4 x \\\\right)}}{\\\\cos{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(4 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 4 \\\\sin{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{8 \\\\sin{\\\\left(4 x \\\\right)}}{\\\\cos{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right)\" :db/id 17592186677551}] :answer-field/correct {:answer/id #uuid \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right)\" :db/id 17592186677551} :answer-field/id #uuid \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677560}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{24}} \\\\frac{- 4 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=32 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\pi}{24}&\\\\Longrightarrow u=\\\\frac{13}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{24}} \\\\frac{- 4 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{8}\\\\left(\\\\int_{3}^{\\\\frac{13}{3}} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{\\\\frac{13}{3}}\\\\right)=- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{3}\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right)\" :db/id 17592186677602}] :answer-field/correct {:answer/id #uuid \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right)\" :db/id 17592186677602} :answer-field/id #uuid \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677537}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\sqrt{\\\\pi}}{4}} \\\\frac{- 6 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}}{2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=16 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\sqrt{\\\\pi}}{4}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\sqrt{\\\\pi}}{4}} \\\\frac{- 6 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}}{2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{8}\\\\left(\\\\int_{3}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{5}\\\\right)=- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677545}] :answer-field/correct {:answer/id #uuid \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677545} :answer-field/id #uuid \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677535}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{6 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 4 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{6 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"33508499-ed71-5b55-9836-8de60b78372c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677549}] :answer-field/correct {:answer/id #uuid \"33508499-ed71-5b55-9836-8de60b78372c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677549} :answer-field/id #uuid \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677555}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 5 \\\\sin{\\\\left(3 x \\\\right)}}{\\\\cos{\\\\left(3 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(3 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(3 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 5 \\\\sin{\\\\left(3 x \\\\right)}}{\\\\cos{\\\\left(3 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{5}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{5}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677539}] :answer-field/correct {:answer/id #uuid \"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\" :db/id 17592186677539} :answer-field/id #uuid \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677590}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 3 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 3 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186677592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right)\" :db/id 17592186677556}] :answer-field/correct {:answer/id #uuid \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right)\" :db/id 17592186677556} :answer-field/id #uuid \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677554}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{8}} \\\\frac{7 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 36 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=8\\\\\\\\x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{8}} \\\\frac{7 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{36}\\\\left(\\\\int_{8}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{7}{36}\\\\left(\\\\left[\\\\ln u\\\\right]_{8}^{5}\\\\right)=- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right)\" :db/id 17592186677564}] :answer-field/correct {:answer/id #uuid \"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right)\" :db/id 17592186677564} :answer-field/id #uuid \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677580}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} \\\\frac{3 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}}{4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 16 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=8\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} \\\\frac{3 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}}{4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{16}\\\\left(\\\\int_{8}^{4} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{16}\\\\left(\\\\left[\\\\ln u\\\\right]_{8}^{4}\\\\right)=- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right)\" :db/id 17592186677598}] :answer-field/correct {:answer/id #uuid \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right)\" :db/id 17592186677598} :answer-field/id #uuid \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677586}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{30}}^{\\\\frac{\\\\pi}{10}} \\\\frac{3 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}}{\\\\csc{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 5 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{30}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=6\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{30}}^{\\\\frac{\\\\pi}{10}} \\\\frac{3 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}}{\\\\csc{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{5}\\\\left(\\\\int_{7}^{6} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{5}\\\\left(\\\\left[\\\\ln u\\\\right]_{7}^{6}\\\\right)=- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(6\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right).\\n$$\"} {:db/id 17592186677603 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3e5390db-5116-5562-a668-6167295df915\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\" :db/id 17592186677552}] :answer-field/correct {:answer/id #uuid \"3e5390db-5116-5562-a668-6167295df915\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\" :db/id 17592186677552} :answer-field/id #uuid \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677571}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\sec^{2}{\\\\left(5 x \\\\right)}}{3 \\\\tan{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/worked-solution \"Let $u=3 \\\\tan{\\\\left(5 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15 \\\\sec^{2}{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\sec^{2}{\\\\left(5 x \\\\right)}}{3 \\\\tan{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"}] :knowledge-point/title \"Integrating Quotients Containing Trigonometric Functions Using Substitution\"}",
