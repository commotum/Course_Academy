}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"f0a8c230-87a3-5723-b85f-4967952af1c4\" :question/difficulty :question.difficulty/easy] [:db/add \"f0a8c230-87a3-5723-b85f-4967952af1c4\" :question/answer-fields \"2e369801-d8cb-518d-93ed-b1d974171264\"] [:db/ensure \"f0a8c230-87a3-5723-b85f-4967952af1c4\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"f0a8c230-87a3-5723-b85f-4967952af1c4\"] [:db/add \"c0999e2d-64f9-52e7-9720-d0eb8206448f\" :answer/id #uuid \"c0999e2d-64f9-52e7-9720-d0eb8206448f\"] [:db/add \"c0999e2d-64f9-52e7-9720-d0eb8206448f\" :answer/type :answer.type/math] [:db/add \"c0999e2d-64f9-52e7-9720-d0eb8206448f\" :answer/value \"-6\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c0999e2d-64f9-52e7-9720-d0eb8206448f\" :answer/validate] [:db/add \"35109246-3fdc-5042-882a-69fdbf9b0c1b\" :answer/id #uuid \"35109246-3fdc-5042-882a-69fdbf9b0c1b\"] [:db/add \"35109246-3fdc-5042-882a-69fdbf9b0c1b\" :answer/type :answer.type/math] [:db/add \"35109246-3fdc-5042-882a-69fdbf9b0c1b\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"35109246-3fdc-5042-882a-69fdbf9b0c1b\" :answer/validate] [:db/add \"60bcbc44-64d6-51c5-93b2-347ba8258c29\" :answer/id #uuid \"60bcbc44-64d6-51c5-93b2-347ba8258c29\"] [:db/add \"60bcbc44-64d6-51c5-93b2-347ba8258c29\" :answer/type :answer.type/math] [:db/add \"60bcbc44-64d6-51c5-93b2-347ba8258c29\" :answer/value \"-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"60bcbc44-64d6-51c5-93b2-347ba8258c29\" :answer/validate] [:db/add \"26cfff16-a171-576a-8252-6d5d3d4d59da\" :answer/id #uuid \"26cfff16-a171-576a-8252-6d5d3d4d59da\"] [:db/add \"26cfff16-a171-576a-8252-6d5d3d4d59da\" :answer/type :answer.type/math] [:db/add \"26cfff16-a171-576a-8252-6d5d3d4d59da\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"26cfff16-a171-576a-8252-6d5d3d4d59da\" :answer/validate] [