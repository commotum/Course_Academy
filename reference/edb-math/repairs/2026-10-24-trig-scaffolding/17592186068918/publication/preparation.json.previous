/id #uuid \"cb22fcf0-993c-5966-acfa-b01e2aafd293\"] [:db/add \"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/problem \"Use the substitution $u=2 \\\\sec{\\\\left(x \\\\right)} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{2 \\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/worked-solution \"Let $u=2 \\\\sec{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{2 \\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/difficulty :question.difficulty/easy] [:db/add \"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/answer-fields \"a5c5b866-690a-536b-8016-b5bc64541276\"] [:db/ensure \"cb22fcf0-993c-5966-acfa-b01e2aafd293\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"cb22fcf0-993c-5966-acfa-b01e2aafd293\"] [:db/add \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/id #uuid \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\"] [:db/add \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/type :answer.type/math] [:db/add \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/value \"-3\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)\"] [:db/ensure \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\" :answer/validate] [:db/add \"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/id #uuid \"36cdbfc0-1dbe-5184-9526-131f920264cf\"] [:db/add \"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/key \"answer\"] [:db/add \"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/type :answer-field.type/blank] [:db/add \"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/choices \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\"] [:db/add \"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/correct \"9269a841-cb22-57b2-a1b9-ab5722aaacb3\"] [:db/ensure \"36cdbfc0-1dbe-5184-9526-131f920264cf\" :answer-field/validate] [:db/add \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/id #uuid \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\"] [:db/add \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sin{\\\\left(x \\\\right)}}{\\\\cos{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\sin{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sin{\\\\left(x \\\\right)}}{\\\\cos{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-3\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/difficulty :question.difficulty/moderate] [:db/add \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/answer-fields \"36cdbfc0-1dbe-5184-9526-131f920264cf\"] [:db/ensure \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0\"] [:db/add \"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/id #uuid \"1ab35f0d-ed0b-53a6-a709-eee21b017721\"] [:db/add \"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/type :answer.type/math] [:db/add \"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\ln\\\\left|\\\\cos^{3}{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"1ab35f0d-ed0b-53a6-a709-eee21b017721\" :answer/validate] [:db/add \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/id #uuid \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\"] [:db/add \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/key \"answer\"] [:db/add \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/type :answer-field.type/blank] [:db/add \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/choices \"1ab35f0d-ed0b-53a6-a709-eee21b017721\"] [:db/add \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/correct \"1ab35f0d-ed0b-53a6-a709-eee21b017721\"] [:db/ensure \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\" :answer-field/validate] [:db/add \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/id #uuid \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\"] [:db/add \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/worked-solution \"Let $u=\\\\cos^{3}{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2}{3}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(\\\\ln\\\\left|\\\\cos^{3}{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/difficulty :question.difficulty/moderate] [:db/add \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/answer-fields \"32b8e67e-6266-592b-9ab4-48fe7c1076bd\"] [:db/ensure \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"7696509d-e5cb-5529-a8eb-a961ebd3df4c\"] [:db/add \"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/id #uuid \"f00314b4-92f2-5497-b21f-1f1d41f4a650\"] [:db/add \"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/type :answer.type/math] [:db/add \"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/value \"\\\\ln\\\\left|\\\\sin{\\\\left(x \\\\right)} + 3\\\\right|\"] [:db/ensure \"f00314b4-92f2-5497-b21f-1f1d41f4a650\" :answer/validate] [:db/add \"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/id #uuid \"a491747c-9717-57ec-8a22-d2cd7b67a98d\"] [:db/add \"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/key \"answer\"] [:db/add \"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/type :answer-field.type/blank] [:db/add \"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/choices \"f00314b4-92f2-5497-b21f-1f1d41f4a650\"] [:db/add \"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/correct \"f00314b4-92f2-5497-b21f-1f1d41f4a650\"] [:db/ensure \"a491747c-9717-57ec-8a22-d2cd7b67a98d\" :answer-field/validate] [:db/add \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/id #uuid \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\"] [:db/add \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\cos{\\\\left(x \\\\right)}}{\\\\sin{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|\\\\sin{\\\\left(x \\\\right)} + 3\\\\right|+C.\\n$$\"] [:db/add \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/difficulty :question.difficulty/moderate] [:db/add \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/answer-fields \"a491747c-9717-57ec-8a22-d2cd7b67a98d\"] [:db/ensure \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"703ae5ee-f48d-5ae1-9724-9627d7b60e09\"] [:db/add \"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/id #uuid \"6dd2783b-acc8-5a41-8814-632a6b7798da\"] [:db/add \"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/type :answer.type/math] [:db/add \"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/value \"-2\\\\left(\\\\ln\\\\left|\\\\cot{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"6dd2783b-acc8-5a41-8814-632a6b7798da\" :answer/validate] [:db/add \"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/id #uuid \"aabe90bb-6032-57cd-a78d-227c633731d7\"] [:db/add \"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/key \"answer\"] [:db/add \"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/type :answer-field.type/blank] [:db/add \"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/choices \"6dd2783b-acc8-5a41-8814-632a6b7798da\"] [:db/add \"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/correct \"6dd2783b-acc8-5a41-8814-632a6b7798da\"] [:db/ensure \"aabe90bb-6032-57cd-a78d-227c633731d7\" :answer-field/validate] [:db/add \"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/id #uuid \"ce1c55da-cc20-5add-93cc-f834a01ce872\"] [:db/add \"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\csc^{2}{\\\\left(x \\\\right)}}{\\\\cot{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/worked-solution \"Let $u=\\\\cot{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\csc^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\csc^{2}{\\\\left(x \\\\right)}}{\\\\cot{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\ln\\\\left|\\\\cot{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/difficulty :question.difficulty/moderate] [:db/add \"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/answer-fields \"aabe90bb-6032-57cd-a78d-227c633731d7\"] [:db/ensure \"ce1c55da-cc20-5add-93cc-f834a01ce872\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"ce1c55da-cc20-5add-93cc-f834a01ce872\"] [:db/add \"f883f755-b22e-57d8-8353-c6de87919773\" :answer/id #uuid \"f883f755-b22e-57d8-8353-c6de87919773\"] [:db/add \"f883f755-b22e-57d8-8353-c6de87919773\" :answer/type :answer.type/math] [:db/add \"f883f755-b22e-57d8-8353-c6de87919773\" :answer/value \"-3\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"f883f755-b22e-57d8-8353-c6de87919773\" :answer/validate] [:db/add \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/id #uuid \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\"] [:db/add \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/key \"answer\"] [:db/add \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/type :answer-field.type/blank] [:db/add \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/choices \"f883f755-b22e-57d8-8353-c6de87919773\"] [:db/add \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/correct \"f883f755-b22e-57d8-8353-c6de87919773\"] [:db/ensure \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\" :answer-field/validate] [:db/add \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/id #uuid \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\"] [:db/add \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cot{\\\\left(x \\\\right)} \\\\csc{\\\\left(x \\\\right)}}{\\\\csc{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\cot{\\\\left(x \\\\right)} \\\\csc{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cot{\\\\left(x \\\\right)} \\\\csc{\\\\left(x \\\\right)}}{\\\\csc{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-3\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/difficulty :question.difficulty/moderate] [:db/add \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/answer-fields \"0abfea5d-1ac2-500e-bb14-291a9e0da07a\"] [:db/ensure \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"bab98a5c-2ddd-50d6-91fa-60cd4695380d\"] [:db/add \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/id #uuid \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\"] [:db/add \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/type :answer.type/math] [:db/add \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/value \"3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\" :answer/validate] [:db/add \"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/id #uuid \"e1e1b014-ac28-5db6-b361-da5b615faa1e\"] [:db/add \"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/key \"answer\"] [:db/add \"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/type :answer-field.type/blank] [:db/add \"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/choices \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\"] [:db/add \"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/correct \"bd2a637b-83f7-52aa-abad-a4e36eb55b32\"] [:db/ensure \"e1e1b014-ac28-5db6-b361-da5b615faa1e\" :answer-field/validate] [:db/add \"20077b72-a8a0-5949-928b-697800f9f411\" :question/id #uuid \"20077b72-a8a0-5949-928b-697800f9f411\"] [:db/add \"20077b72-a8a0-5949-928b-697800f9f411\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"20077b72-a8a0-5949-928b-697800f9f411\" :question/worked-solution \"Let $u=\\\\sec{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"20077b72-a8a0-5949-928b-697800f9f411\" :question/difficulty :question.difficulty/moderate] [:db/add \"20077b72-a8a0-5949-928b-697800f9f411\" :question/answer-fields \"e1e1b014-ac28-5db6-b361-da5b615faa1e\"] [:db/ensure \"20077b72-a8a0-5949-928b-697800f9f411\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"20077b72-a8a0-5949-928b-697800f9f411\"] [:db/add \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/id #uuid \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\"] [:db/add \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/type :answer.type/math] [:db/add \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin^{2}{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)\"] [:db/ensure \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\" :answer/validate] [:db/add \"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/id #uuid \"caa84d65-7734-5833-b30f-0692f3355cb3\"] [:db/add \"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/key \"answer\"] [:db/add \"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/type :answer-field.type/blank] [:db/add \"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/choices \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\"] [:db/add \"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/correct \"ef0d9fcb-a667-5a85-886b-f50fc6acfb74\"] [:db/ensure \"caa84d65-7734-5833-b30f-0692f3355cb3\" :answer-field/validate] [:db/add \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/id #uuid \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\"] [:db/add \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/worked-solution \"Let $u=\\\\sin^{2}{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin^{2}{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/difficulty :question.difficulty/moderate] [:db/add \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/answer-fields \"caa84d65-7734-5833-b30f-0692f3355cb3\"] [:db/ensure \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"ea3cd195-fdb7-5c6e-8504-469d2e3e5bab\"] [:db/add \"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/id #uuid \"ce712152-3ba6-54ef-b73d-bbd1f4166638\"] [:db/add \"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/type :answer.type/math] [:db/add \"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/value \"3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)\"] [:db/ensure \"ce712152-3ba6-54ef-b73d-bbd1f4166638\" :answer/validate] [:db/add \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/id #uuid \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\"] [:db/add \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/key \"answer\"] [:db/add \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/type :answer-field.type/blank] [:db/add \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/choices \"ce712152-3ba6-54ef-b73d-bbd1f4166638\"] [:db/add \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/correct \"ce712152-3ba6-54ef-b73d-bbd1f4166638\"] [:db/ensure \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\" :answer-field/validate] [:db/add \"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/id #uuid \"780aa30d-a997-50f9-ae44-01b49bca3290\"] [:db/add \"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sec^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/difficulty :question.difficulty/moderate] [:db/add \"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/answer-fields \"9e7ff2ce-a64f-5786-8850-baa9daa58a2f\"] [:db/ensure \"780aa30d-a997-50f9-ae44-01b49bca3290\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"780aa30d-a997-50f9-ae44-01b49bca3290\"] [:db/add \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/id #uuid \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\"] [:db/add \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/type :answer.type/math] [:db/add \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/value \"\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 1\\\\right|\"] [:db/ensure \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\" :answer/validate] [:db/add \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/id #uuid \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\"] [:db/add \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/key \"answer\"] [:db/add \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/type :answer-field.type/blank] [:db/add \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/choices \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\"] [:db/add \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/correct \"e7b067c8-3722-55b9-b8ac-a23c09e7e657\"] [:db/ensure \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\" :answer-field/validate] [:db/add \"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/id #uuid \"80d4ee8f-50d5-560e-99ae-11b6253219c3\"] [:db/add \"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x^{2} \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 1\\\\right|+C.\\n$$\"] [:db/add \"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/difficulty :question.difficulty/hard] [:db/add \"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/answer-fields \"75aa1959-f5f5-5ee0-adbd-ee11354e47f7\"] [:db/ensure \"80d4ee8f-50d5-560e-99ae-11b6253219c3\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"80d4ee8f-50d5-560e-99ae-11b6253219c3\"] [:db/add \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/id #uuid \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\"] [:db/add \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/type :answer.type/math] [:db/add \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/value \"3\\\\left(\\\\sec{\\\\left(x \\\\right)} + 1-\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)\"] [:db/ensure \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\" :answer/validate] [:db/add \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/id #uuid \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\"] [:db/add \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/key \"answer\"] [:db/add \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/type :answer-field.type/blank] [:db/add \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/choices \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\"] [:db/add \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/correct \"8d74ba2b-bc8a-5009-98ca-91dc8b8c3a0b\"] [:db/ensure \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\" :answer-field/validate] [:db/add \"925407a6-15df-507e-b702-30c13be91427\" :question/id #uuid \"925407a6-15df-507e-b702-30c13be91427\"] [:db/add \"925407a6-15df-507e-b702-30c13be91427\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"925407a6-15df-507e-b702-30c13be91427\" :question/worked-solution \"Let $u=\\\\sec{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nSince $\\\\sec{\\\\left(x \\\\right)}=u-1$, rewrite the remaining factor:\\n\\n$$\\n\\\\frac{u-1}{u}=1-\\\\frac{1}{u}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int 1 - \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n3\\\\left(\\\\int 1 - \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(u-\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\sec{\\\\left(x \\\\right)} + 1-\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 1\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"925407a6-15df-507e-b702-30c13be91427\" :question/difficulty :question.difficulty/hard] [:db/add \"925407a6-15df-507e-b702-30c13be91427\" :question/answer-fields \"bc24d8c1-2dba-5a15-86c1-7b8a92a86f17\"] [:db/ensure \"925407a6-15df-507e-b702-30c13be91427\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"925407a6-15df-507e-b702-30c13be91427\"] [:db/add \"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/id #uuid \"0b7887f9-f432-51a2-b303-334d07b2cba3\"] [:db/add \"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/type :answer.type/math] [:db/add \"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(x^{2} \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"0b7887f9-f432-51a2-b303-334d07b2cba3\" :answer/validate] [:db/add \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/id #uuid \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\"] [:db/add \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/key \"answer\"] [:db/add \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/type :answer-field.type/blank] [:db/add \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/choices \"0b7887f9-f432-51a2-b303-334d07b2cba3\"] [:db/add \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/correct \"0b7887f9-f432-51a2-b303-334d07b2cba3\"] [:db/ensure \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\" :answer-field/validate] [:db/add \"e8649475-994f-54e3-8796-29f4ecd57606\" :question/id #uuid \"e8649475-994f-54e3-8796-29f4ecd57606\"] [:db/add \"e8649475-994f-54e3-8796-29f4ecd57606\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{x \\\\cos{\\\\left(x^{2} \\\\right)}}{\\\\sin{\\\\left(x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"e8649475-994f-54e3-8796-29f4ecd57606\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(x^{2} \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x \\\\cos{\\\\left(x^{2} \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{x \\\\cos{\\\\left(x^{2} \\\\right)}}{\\\\sin{\\\\left(x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(x^{2} \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"e8649475-994f-54e3-8796-29f4ecd57606\" :question/difficulty :question.difficulty/hard] [:db/add \"e8649475-994f-54e3-8796-29f4ecd57606\" :question/answer-fields \"35ed0262-5b26-5a59-a1ca-1e9767a0763a\"] [:db/ensure \"e8649475-994f-54e3-8796-29f4ecd57606\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"e8649475-994f-54e3-8796-29f4ecd57606\"] [:db/add \"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/id #uuid \"5330c5f8-10e3-58c6-91a5-4dca22835059\"] [:db/add \"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/type :answer.type/math] [:db/add \"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/value \"\\\\tan{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"5330c5f8-10e3-58c6-91a5-4dca22835059\" :answer/validate] [:db/add \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/id #uuid \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\"] [:db/add \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/key \"answer\"] [:db/add \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/type :answer-field.type/blank] [:db/add \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/choices \"5330c5f8-10e3-58c6-91a5-4dca22835059\"] [:db/add \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/correct \"5330c5f8-10e3-58c6-91a5-4dca22835059\"] [:db/ensure \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\" :answer-field/validate] [:db/add \"783c2a89-9f00-534b-8121-076b71f15964\" :question/id #uuid \"783c2a89-9f00-534b-8121-076b71f15964\"] [:db/add \"783c2a89-9f00-534b-8121-076b71f15964\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"783c2a89-9f00-534b-8121-076b71f15964\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sec^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nSince $\\\\tan{\\\\left(x \\\\right)}=u-3$, rewrite the remaining factor:\\n\\n$$\\n\\\\frac{u-3}{u}=1-\\\\frac{3}{u}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\tan{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u=u-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\tan{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"783c2a89-9f00-534b-8121-076b71f15964\" :question/difficulty :question.difficulty/hard] [:db/add \"783c2a89-9f00-534b-8121-076b71f15964\" :question/answer-fields \"53e8b1ed-c4bb-5483-ac19-99f71799dad5\"] [:db/ensure \"783c2a89-9f00-534b-8121-076b71f15964\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"783c2a89-9f00-534b-8121-076b71f15964\"] [:db/add \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/id #uuid \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\"] [:db/add \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/type :answer.type/math] [:db/add \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/value \"\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(1\\\\right)\"] [:db/ensure \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\" :answer/validate] [:db/add \"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/id #uuid \"d8fe7e48-e89b-5110-9b40-2a3e19531370\"] [:db/add \"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/key \"answer\"] [:db/add \"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/type :answer-field.type/blank] [:db/add \"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/choices \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\"] [:db/add \"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/correct \"cf96e8b8-c225-5478-b6ec-c2ab0af2d47d\"] [:db/ensure \"d8fe7e48-e89b-5110-9b40-2a3e19531370\" :answer-field/validate] [:db/add \"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/id #uuid \"62ce3275-2baa-559b-b2b1-d066e2b0c811\"] [:db/add \"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $\\\\sin{\\\\left(0 \\\\right)}=0,\\\\quad \\\\sin{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=1$.\\n\\n{{answer}}\"] [:db/add \"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/worked-solution \"Let $u=\\\\sin^{2}{\\\\left(x \\\\right)} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{2 \\\\sin{\\\\left(x \\\\right)} \\\\cos{\\\\left(x \\\\right)}}{\\\\sin^{2}{\\\\left(x \\\\right)} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{1}^{2} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nBoth transformed bounds are positive. Evaluating gives\\n\\n$$\\n\\\\left[\\\\ln u\\\\right]_{1}^{2}=\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(1\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(1\\\\right).\\n$$\"] [:db/add \"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/difficulty :question.difficulty/hard] [:db/add \"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/answer-fields \"d8fe7e48-e89b-5110-9b40-2a3e19531370\"] [:db/ensure \"62ce3275-2baa-559b-b2b1-d066e2b0c811\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"62ce3275-2baa-559b-b2b1-d066e2b0c811\"] [:db/add \"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/id #uuid \"89ccb77f-ea19-5517-a80b-5775b27f0059\"] [:db/add \"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/type :answer.type/math] [:db/add \"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/value \"-\\\\left(\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right)\"] [:db/ensure \"89ccb77f-ea19-5517-a80b-5775b27f0059\" :answer/validate] [:db/add \"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/id #uuid \"a2f382a7-7017-56d3-989d-72bb9b1a4196\"] [:db/add \"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/key \"answer\"] [:db/add \"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/type :answer-field.type/blank] [:db/add \"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/choices \"89ccb77f-ea19-5517-a80b-5775b27f0059\"] [:db/add \"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/correct \"89ccb77f-ea19-5517-a80b-5775b27f0059\"] [:db/ensure \"a2f382a7-7017-56d3-989d-72bb9b1a4196\" :answer-field/validate] [:db/add \"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/id #uuid \"ef2b20da-499d-545a-b464-cf852a7c9a60\"] [:db/add \"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $\\\\cos{\\\\left(0 \\\\right)}=1,\\\\quad \\\\cos{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=0$.\\n\\n{{answer}}\"] [:db/add \"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/worked-solution \"Let $u=\\\\cos^{3}{\\\\left(x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{2}} \\\\frac{3 \\\\sin{\\\\left(x \\\\right)} \\\\cos^{2}{\\\\left(x \\\\right)}}{\\\\cos^{3}{\\\\left(x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int_{3}^{2} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth transformed bounds are positive. Evaluating gives\\n\\n$$\\n-\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{2}\\\\right)=-\\\\left(\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n-\\\\left(\\\\ln\\\\left(2\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\"] [:db/add \"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/difficulty :question.difficulty/hard] [:db/add \"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/answer-fields \"a2f382a7-7017-56d3-989d-72bb9b1a4196\"] [:db/ensure \"ef2b20da-499d-545a-b464-cf852a7c9a60\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"ef2b20da-499d-545a-b464-cf852a7c9a60\"] [:db/add \"a498463e-efb3-52d7-aba4-90b784066259\" :answer/id #uuid \"a498463e-efb3-52d7-aba4-90b784066259\"] [:db/add \"a498463e-efb3-52d7-aba4-90b784066259\" :answer/type :answer.type/math] [:db/add \"a498463e-efb3-52d7-aba4-90b784066259\" :answer/value \"\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 2\\\\right|\"] [:db/ensure \"a498463e-efb3-52d7-aba4-90b784066259\" :answer/validate] [:db/add \"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/id #uuid \"567efca9-1396-52a6-9c25-b5fc3c639dce\"] [:db/add \"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/key \"answer\"] [:db/add \"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/type :answer-field.type/blank] [:db/add \"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/choices \"a498463e-efb3-52d7-aba4-90b784066259\"] [:db/add \"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/correct \"a498463e-efb3-52d7-aba4-90b784066259\"] [:db/ensure \"567efca9-1396-52a6-9c25-b5fc3c639dce\" :answer-field/validate] [:db/add \"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/id #uuid \"5799d41a-2cfa-514c-bee4-deec7f0746d9\"] [:db/add \"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(x^{2} \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}}{\\\\tan{\\\\left(x^{2} \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|\\\\tan{\\\\left(x^{2} \\\\right)} + 2\\\\right|+C.\\n$$\"] [:db/add \"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/difficulty :question.difficulty/hard] [:db/add \"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/answer-fields \"567efca9-1396-52a6-9c25-b5fc3c639dce\"] [:db/ensure \"5799d41a-2cfa-514c-bee4-deec7f0746d9\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"5799d41a-2cfa-514c-bee4-deec7f0746d9\"] [:db/add \"50065767-b289-53fe-a618-d57bf652d952\" :answer/id #uuid \"50065767-b289-53fe-a618-d57bf652d952\"] [:db/add \"50065767-b289-53fe-a618-d57bf652d952\" :answer/type :answer.type/math] [:db/add \"50065767-b289-53fe-a618-d57bf652d952\" :answer/value \"\\\\sec{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"50065767-b289-53fe-a618-d57bf652d952\" :answer/validate] [:db/add \"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/id #uuid \"22f19925-f30d-5472-9d85-cbeba2358e50\"] [:db/add \"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/key \"answer\"] [:db/add \"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/type :answer-field.type/blank] [:db/add \"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/choices \"50065767-b289-53fe-a618-d57bf652d952\"] [:db/add \"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/correct \"50065767-b289-53fe-a618-d57bf652d952\"] [:db/ensure \"22f19925-f30d-5472-9d85-cbeba2358e50\" :answer-field/validate] [:db/add \"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/id #uuid \"f6d82a54-5d2e-504b-a04e-946dd548ece7\"] [:db/add \"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 1/u\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/worked-solution \"Let $u=\\\\sec{\\\\left(x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\tan{\\\\left(x \\\\right)} \\\\sec{\\\\left(x \\\\right)}.\\n$$\\n\\nSince $\\\\sec{\\\\left(x \\\\right)}=u-3$, rewrite the remaining factor:\\n\\n$$\\n\\\\frac{u-3}{u}=1-\\\\frac{3}{u}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{\\\\tan{\\\\left(x \\\\right)} \\\\sec^{2}{\\\\left(x \\\\right)}}{\\\\sec{\\\\left(x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int 1 - \\\\frac{3}{u}\\\\,\\\\mathrm{d}u=u-3\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\sec{\\\\left(x \\\\right)} + 3-3\\\\left(\\\\ln\\\\left|\\\\sec{\\\\left(x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/difficulty :question.difficulty/hard] [:db/add \"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/answer-fields \"22f19925-f30d-5472-9d85-cbeba2358e50\"] [:db/ensure \"f6d82a54-5d2e-504b-a04e-946dd548ece7\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"f6d82a54-5d2e-504b-a04e-946dd548ece7\"] [:db/add \"generator\" :question-generator/id #uuid \"d4269f3a-b357-54c0-8e94-27f039c3b613\"] [:db/add \"generator\" :question-generator/script \"generators/b4/b4a1184baf1a0c145e71bb92ddcd6462ad4ceafcca3d350d16bc0ec0ea18f5ad/generator.py\"] [:db/add 17592186068918 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186068918 :knowledge-point/validate]] \"assertions\" [[\"13651448-c66c-5244-b022-21792d9330ae\" :answer/id #uuid \"13651448-c66c-5244-b022-21792d9330ae\"] [\"13651448-c66c-5244-b022-21792d9330ae\" :answer/type :answer.type/math] [\"13651448-c66c-5244-b022-21792d9330ae\" :answer/value \"-\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2359639f-7409-5449-ab5c-9d8fa23880ed\" :answer/id #uuid \"2359639f-7409-5449-ab5c-9d8fa23880ed\"] [\"2359639f-7409-5449-ab5c-9d8fa23880ed\" :answer/type :answer.type/math] [\"2359639f-7409-5449-ab5c-9d8fa23880ed\" :answer/val