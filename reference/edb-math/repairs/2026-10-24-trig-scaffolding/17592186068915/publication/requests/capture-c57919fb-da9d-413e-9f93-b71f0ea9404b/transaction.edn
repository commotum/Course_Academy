db/ensure "c902d9fa-5024-5388-801d-133c06ec4daf" :answer/validate] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/id #uuid "ec2ea545-7705-5b75-bfb2-a127dac9549b"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/key "answer"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/type :answer-field.type/radio] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/choices "a73c7853-e031-54b0-8d07-0814d416a36c"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/choices "78d2fabd-5621-5dc4-895e-1542b704d140"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/choices "d6516896-aae3-5b1a-8668-b8e47e7400b4"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/choices "a1815eda-ab58-58e7-8b74-3c36e64843de"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/choices "c902d9fa-5024-5388-801d-133c06ec4daf"] [:db/add "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/correct "78d2fabd-5621-5dc4-895e-1542b704d140"] [:db/ensure "ec2ea545-7705-5b75-bfb2-a127dac9549b" :answer-field/validate] [:db/add "e96a768a-8b82-51b7-a945-24730214a8a0" :question/id #uuid "e96a768a-8b82-51b7-a945-24730214a8a0"] [:db/add "e96a768a-8b82-51b7-a945-24730214a8a0" :question/problem "Use the substitution $u=3 x$. Which integral is obtained?\n\n$$\n\\int \\cos{\\left(3 x \\right)}\\,\\mathrm{d}x\n$$"] [:db/add "e96a768a-8b82-51b7-a945-24730214a8a0" :question/worked-solution "Let $u=3 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\cos{\\left(3 x \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{3}\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "e96a768a-8b82-51b7-a945-24730214a8a0" :question/difficulty :question.difficulty/easy] [:db/add "e96a768a-8b82-51b7-a945-24730214a8a0" :question/answer-fields "ec2ea545-7705-5b75-bfb2-a127dac9549b"] [:db/ensure "e96a768a-8b82-51b7-a945-24730214a8a0" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "e96a768a-8b82-51b7-a945-24730214a8a0"] [:db/add "dd974687-5fe3-5eb5-b3e7-f18717cb0939" :answer/id #uuid "dd974687-5fe3-5eb5-b3e7-f18717cb0939"] [:db/add "dd974687-5fe3-5eb5-b3e7-f18717cb0939" :answer/type :answer.type/math] [:db/add "dd974687-5fe3-5eb5-b3e7-f18717cb0939" :answer/value "- \\frac{\\cos{\\left(4 x + 3 \\right)}}{4}"] [:db/ensure "dd974687-5fe3-5eb5-b3e7-f18717cb0939" :answer/validate] [:db/add "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb" :answer-field/id #uuid "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb"] [:db/add "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb" :answer-field/key "answer"] [:db/add "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb" :answer-field/type :answer-field.type/blank] [:db/add "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb" :answer-field/choices "dd974687-5fe3-5eb5-b3e7-f18717cb0939"] [:db/add "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb" :answer-field/correct "dd974687-5fe3-5eb5-b3e7-f18717cb0939"] [:db/ensure "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb" :answer-field/validate] [:db/add "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/id #uuid "85d13d2d-f042-57af-a1a0-8e6f471f6d8a"] [:db/add "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/problem "Find an antiderivative.\n\n$$\n\\int \\sin{\\left(4 x + 3 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/worked-solution "Let $u=4 x + 3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\sin{\\left(4 x + 3 \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{1}{4}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- \\frac{\\cos{\\left(u \\right)}}{4}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{\\cos{\\left(4 x + 3 \\right)}}{4}+C.\n$$"] [:db/add "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/difficulty :question.difficulty/moderate] [:db/add "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/answer-fields "0c6c0ae1-37a9-54de-9f9b-77c31a7073fb"] [:db/ensure "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "85d13d2d-f042-57af-a1a0-8e6f471f6d8a"] [:db/add "5871b02d-2bef-5fb1-865e-65aff4cc3969" :answer/id #uuid "5871b02d-2bef-5fb1-865e-65aff4cc3969"] [:db/add "5871b02d-2bef-5fb1-865e-65aff4cc3969" :answer/type :answer.type/math] [:db/add "5871b02d-2bef-5fb1-865e-65aff4cc3969" :answer/value "\\frac{3}{4}"] [:db/ensure "5871b02d-2bef-5fb1-865e-65aff4cc3969" :answer/validate] [:db/add "866f3cb3-d08c-55fc-9741-2055767f7e3a" :answer-field/id #uuid "866f3cb3-d08c-55fc-9741-2055767f7e3a"] [:db/add "866f3cb3-d08c-55fc-9741-2055767f7e3a" :answer-field/key "answer"] [:db/add "866f3cb3-d08c-55fc-9741-2055767f7e3a" :answer-field/type :answer-field.type/blank] [:db/add "866f3cb3-d08c-55fc-9741-2055767f7e3a" :answer-field/choices "5871b02d-2bef-5fb1-865e-65aff4cc3969"] [:db/add "866f3cb3-d08c-55fc-9741-2055767f7e3a" :answer-field/correct "5871b02d-2bef-5fb1-865e-65aff4cc3969"] [:db/ensure "866f3cb3-d08c-55fc-9741-2055767f7e3a" :answer-field/validate] [:db/add "e448a4d2-65fb-5da5-83af-e67ab30b203d" :question/id #uuid "e448a4d2-65fb-5da5-83af-e67ab30b203d"] [:db/add "e448a4d2-65fb-5da5-83af-e67ab30b203d" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{3 \\pi}{8}}^{\\frac{\\pi}{2}} 3 \\cos{\\left(4 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\sin{\\left(\\frac{3 \\pi}{2} \\right)}=-1,\\quad \\sin{\\left(2 \\pi \\right)}=0$.\n\n{{answer}}"] [:db/add "e448a4d2-65fb-5da5-83af-e67ab30b203d" :question/worked-solution "Let $u=4 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4.\n$$\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\frac{3 \\pi}{8}&\\Longrightarrow u=\\frac{3 \\pi}{2}\\\\x=\\frac{\\pi}{2}&\\Longrightarrow u=2 \\pi\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{3 \\pi}{8}}^{\\frac{\\pi}{2}} 3 \\cos{\\left(4 x \\right)}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate:\n\n$$\n\\left[\\frac{3 \\sin{\\left(u \\right)}}{4}\\right]_{\\frac{3 \\pi}{2}}^{2 \\pi}=\\left(0\\right)-\\left(- \\frac{3}{4}\\right).\n$$\n\nThe answer is\n\n$$\n\\frac{3}{4}.\n$$"] [:db/add "e448a4d2-65fb-5da5-83af-e67ab30b203d" :question/difficulty :question.difficulty/moderate] [:db/add "e448a4d2-65fb-5da5-83af-e67ab30b203d" :question/answer-fields "866f3cb3-d08c-55fc-9741-2055767f7e3a"] [:db/ensure "e448a4d2-65fb-5da5-83af-e67ab30b203d" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "e448a4d2-65fb-5da5-83af-e67ab30b203d"] [:db/add "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3" :answer/id #uuid "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3"] [:db/add "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3" :answer/type :answer.type/math] [:db/add "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3" :answer/value "\\frac{3}{2}"] [:db/ensure "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3" :answer/validate] [:db/add "cc9a28eb-7848-5087-9875-b8382c66378c" :answer-field/id #uuid "cc9a28eb-7848-5087-9875-b8382c66378c"] [:db/add "cc9a28eb-7848-5087-9875-b8382c66378c" :answer-field/key "answer"] [:db/add "cc9a28eb-7848-5087-9875-b8382c66378c" :answer-field/type :answer-field.type/blank] [:db/add "cc9a28eb-7848-5087-9875-b8382c66378c" :answer-field/choices "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3"] [:db/add "cc9a28eb-7848-5087-9875-b8382c66378c" :answer-field/correct "21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3"] [:db/ensure "cc9a28eb-7848-5087-9875-b8382c66378c" :answer-field/validate] [:db/add "f85dd1a8-9614-5c1d-8fde-7f1192c68aed" :question/id #uuid "f85dd1a8-9614-5c1d-8fde-7f1192c68aed"] [:db/add "f85dd1a8-9614-5c1d-8fde-7f1192c68aed" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{\\pi}{4}}^{\\frac{\\pi}{2}} 3 \\sin{\\left(2 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C$.\n\nEndpoint values: $\\cos{\\left(\\frac{\\pi}{2} \\right)}=0,\\quad \\cos{\\left(\\pi \\right)}=-1$.\n\n{{answer}}"] [:db/add "f85dd1a8-9614-5c1d-8fde-7f1192c68aed" :question/worked-solution "Let $u=2 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2.\n$$\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{4}&\\Longrightarrow u=\\frac{\\pi}{2}\\\\x=\\frac{\\pi}{2}&\\Longrightarrow u=\\pi\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{4}}^{\\frac{\\pi}{2}} 3 \\sin{\\left(2 x \\right)}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int_{\\frac{\\pi}{2}}^{\\pi} \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate:\n\n$$\n\\left[- \\frac{3 \\cos{\\left(u \\right)}}{2}\\right]_{\\frac{\\pi}{2}}^{\\pi}=\\left(\\frac{3}{2}\\right)-\\left(0\\right).\n$$\n\nThe answer is\n\n$$\n\\frac{3}{2}.\n$$"] [:db/add "f85dd1a8-9614-5c1d-8fde-7f1192c68aed" :question/difficulty :question.difficulty/moderate] [:db/add "f85dd1a8-9614-5c1d-8fde-7f1192c68aed" :question/answer-fields "cc9a28eb-7848-5087-9875-b8382c66378c"] [:db/ensure "f85dd1a8-9614-5c1d-8fde-7f1192c68aed" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "f85dd1a8-9614-5c1d-8fde-7f1192c68aed"] [:db/add "06e86e62-b46c-53c0-b647-0a53dd840de6" :answer/id #uuid "06e86e62-b46c-53c0-b647-0a53dd840de6"] [:db/add "06e86e62-b46c-53c0-b647-0a53dd840de6" :answer/type :answer.type/math] [:db/add "06e86e62-b46c-53c0-b647-0a53dd840de6" :answer/value "\\sin{\\left(4 x + 1 \\right)}"] [:db/ensure "06e86e62-b46c-53c0-b647-0a53dd840de6" :