7d-ef5313f9c223"] [:db/ensure "d9e83ee0-4cee-5737-a67c-38a3c93a3e99" :answer-field/validate] [:db/add "77949b95-c0b4-5835-9c69-635a354c01c4" :question/id #uuid "77949b95-c0b4-5835-9c69-635a354c01c4"] [:db/add "77949b95-c0b4-5835-9c69-635a354c01c4" :question/problem "Use the substitution $u=3 x$. Which integral is obtained?\n\n$$\n\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}} \\cos{\\left(3 x \\right)}\\,\\mathrm{d}x\n$$"] [:db/add "77949b95-c0b4-5835-9c69-635a354c01c4" :question/worked-solution "Let $u=3 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3.\n$$\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{6}&\\Longrightarrow u=\\frac{\\pi}{2}\\\\x=\\frac{\\pi}{3}&\\Longrightarrow u=\\pi\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}} \\cos{\\left(3 x \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int_{\\frac{\\pi}{2}}^{\\pi} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{3}\\left(\\int_{\\frac{\\pi}{2}}^{\\pi} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "77949b95-c0b4-5835-9c69-635a354c01c4" :question/difficulty :question.difficulty/easy] [:db/add "77949b95-c0b4-5835-9c69-635a354c01c4" :question/answer-fields "d9e83ee0-4cee-5737-a67c-38a3c93a3e99"] [:db/ensure "77949b95-c0b4-5835-9c69-635a354c01c4" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "77949b95-c0b4-5835-9c69-635a354c01c4"] [:db/add "c717e493-67d1-5bc5-a487-4f2939406ecb" :answer/id #uuid "c717e493-67d1-5bc5-a487-4f2939406ecb"] [:db/add "c717e493-67d1-5bc5-a487-4f2939406ecb" :answer/type :answer.type/math] [:db/add "c717e493-67d1-5bc5-a487-4f2939406ecb" :answer/value "3\\left(\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)"] [:db/ensure "c717e493-67d1-5bc5-a487-4f2939406ecb" :answer/validate] [:db/add "0c353a19-a25f-5078-b6f3-06dfcb6caea6" :answer/id #uuid "0c353a19-