 \\right)}\\,\\mathrm{d}u.\n$$"] [:db/add "fdf6518e-e8a4-59f1-9024-2dc25c55475a" :question/difficulty :question.difficulty/easy] [:db/add "fdf6518e-e8a4-59f1-9024-2dc25c55475a" :question/answer-fields "0508bed8-6f0c-5744-9d06-ee9974f77066"] [:db/ensure "fdf6518e-e8a4-59f1-9024-2dc25c55475a" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "fdf6518e-e8a4-59f1-9024-2dc25c55475a"] [:db/add "2d555d93-51bc-5e73-a1f2-f1cf1d9857aa" :answer/id #uuid "2d555d93-51bc-5e73-a1f2-f1cf1d9857aa"] [:db/add "2d555d93-51bc-5e73-a1f2-f1cf1d9857aa" :answer/type :answer.type/math] [:db/add "2d555d93-51bc-5e73-a1f2-f1cf1d9857aa" :answer/value "\\frac{1}{3}\\left(\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)"] [:db/ensure "2d555d93-51bc-5e73-a1f2-f1cf1d9857aa" :answer/validate] [:db/add "7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8" :answer/id #uuid "7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8"] [:db/add "7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8" :answer/type :answer.type/math] [:db/add "7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8" :answer/value "\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\sin{\\left(u \\right)}\\,\\mathrm{d}u"] [:db/ensure "7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8" :answer/validate] [:db/add "3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3" :answer/id #uuid "3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3"] [:db/add "3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3" :answer/type :answer.type/math] [:db/add "3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3" :answer/value "3\\left(\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)"] [:db/ensure "3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3" :answer/validate] [:db/add "de064156-605e-5acc-9433-8f67797fd421" :answer/id #uuid "de064156-605e-5acc-9433-8f67797fd421"] [:db/add "de064156-605e-5acc-9433-8f67797fd421" :answer/type :answer.type/math] [:db/add "de064156-605e-5acc-9433-8f67797fd421" :answer/value "\\frac{1}{3}\\left(\\int_{2 \\pi}^{\\frac{3 \\pi}{2}} \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)"] [:db/ensure "de06415