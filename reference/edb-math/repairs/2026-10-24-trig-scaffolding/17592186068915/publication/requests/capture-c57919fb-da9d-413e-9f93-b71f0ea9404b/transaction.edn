23b-4f1a-58be-a8aa-4b6e169ef8a2" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2"] [:db/add "ed235227-92e6-56ef-94ee-f6721a92bb14" :answer/id #uuid "ed235227-92e6-56ef-94ee-f6721a92bb14"] [:db/add "ed235227-92e6-56ef-94ee-f6721a92bb14" :answer/type :answer.type/math] [:db/add "ed235227-92e6-56ef-94ee-f6721a92bb14" :answer/value "\\frac{\\cos{\\left(1 - 4 x \\right)}}{2}"] [:db/ensure "ed235227-92e6-56ef-94ee-f6721a92bb14" :answer/validate] [:db/add "1489bae4-46a0-523b-b1c4-f0b373879a4a" :answer-field/id #uuid "1489bae4-46a0-523b-b1c4-f0b373879a4a"] [:db/add "1489bae4-46a0-523b-b1c4-f0b373879a4a" :answer-field/key "answer"] [:db/add "1489bae4-46a0-523b-b1c4-f0b373879a4a" :answer-field/type :answer-field.type/blank] [:db/add "1489bae4-46a0-523b-b1c4-f0b373879a4a" :answer-field/choices "ed235227-92e6-56ef-94ee-f6721a92bb14"] [:db/add "1489bae4-46a0-523b-b1c4-f0b373879a4a" :answer-field/correct "ed235227-92e6-56ef-94ee-f6721a92bb14"] [:db/ensure "1489bae4-46a0-523b-b1c4-f0b373879a4a" :answer-field/validate] [:db/add "63ce9196-ff60-526d-af55-9fa94c804e8c" :question/id #uuid "63ce9196-ff60-526d-af55-9fa94c804e8c"] [:db/add "63ce9196-ff60-526d-af55-9fa94c804e8c" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 \\sin{\\left(1 - 4 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "63ce9196-ff60-526d-af55-9fa94c804e8c" :question/worked-solution "Let $u=1 - 4 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-4.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 \\sin{\\left(1 - 4 x \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{1}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{1}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{\\cos{\\left(u \\right)}}{2}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\cos{\\left(1 - 4 x \\right)}}{2}+C.\n$$"] [:db/add "63ce9196-ff60-526d-af55-9fa94c804e8c" :question/difficulty :question.difficulty/hard] [:db/add "63ce9196-ff60-526d-af55-9fa94c804e8c" :question/answer-fields "1489bae4-46a0-523b-b1c4-f0b373879a4a"] [:db/ensure "63ce9196-ff60-526d-af55-9fa94c804e8c" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "63ce9196-ff60-526d-af55-9fa94c804e8c"] [:db/add "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03" :answer/id #uuid "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03"] [:db/add "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03" :answer/type :answer.type/math] [:db/add "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03" :answer/value "- \\frac{1}{3}"] [:db/ensure "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03" :answer/validate] [:db/add "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64" :answer-field/id #uuid "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64"] [:db/add "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64" :answer-field/key "answer"] [:db/add "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64" :answer-field/type :answer-field.type/blank] [:db/add "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64" :answer-field/choices "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03"] [:db/add "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64" :answer-field/correct "7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03"] [:db/ensure "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64" :answer-field/validate] [:db/add "9891ad60-b02c-519b-bb3b-3ccdc5f192ce" :question/id #uuid "9891ad60-b02c-519b-bb3b-3ccdc5f192ce"] [:db/add "9891ad60-b02c-519b-bb3b-3ccdc5f192ce" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{\\pi}{6}} \\cos{\\left(\\pi - 3 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\sin{\\left(\\pi \\right)}=0,\\quad \\sin{\\left(\\frac{\\pi}{2} \\right)}=1$.\n\n{{answer}}"] [:db/add "9891ad60-b02c-519b-bb3b-3ccdc5f192ce" :question/worked-solution "Let $u=\\pi - 3 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-3.\n$$\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=\\pi\\\\x=\\frac{\\pi}{6}&\\Longrightarrow u=\\frac{\\pi}{2}\\end{aligned}\n$$\n\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{\\pi}{6}} \\cos{\\left(\\pi - 3 x \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{1}{3}\\left(\\int_{\\pi}^{\\frac{\\pi}{2}} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate:\n\n$$\n\\left[- \\frac{\\sin{\\left(u \\right)}}{3}\\right]_{\\pi}^{\\frac{\\pi}{2}}=\\left(- \\frac{1}{3}\\right)-\\left(0\\right).\n$$\n\nThe answer is\n\n$$\n- \\frac{1}{3}.\n$$"] [:db/add "9891ad60-b02c-519b-bb3b-3ccdc5f192ce" :question/difficulty :question.difficulty/hard] [:db/add "9891ad60-b02c-519b-bb3b-3ccdc5f192ce" :question/answer-fields "559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64"] [:db/ensure "9891ad60-b02c-519b-bb3b-3ccdc5f192ce" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "9891ad60-b02c-519b-bb3b-3ccdc5f192ce"] [:db/add "generator" :question-generator/id #uuid "9c56de7e-e192-530b-a1e1-58c6654e458d"] [:db/add "generator" :question-generator/script "generators/8c/8cc7eeae43792095e24c31a069aae8422965d29b422fbb787b8beebee0c7f513/generator.py"] [:db/add 17592186068915 :knowledge-point/question-generator "generator"] [:db/ensure 17592186068915 :knowledge-point/validate] [:db/cas 17592186676231 :question/retired nil true] [:db/cas 17592186676235 :question/retired nil true] [:db/cas 17592186676236 :question/retired nil true] [:db/cas 17592186676238 :question/retired nil true] [:db/cas 17592186676241 :question/retired nil true] [:db/cas 17592186676253 :question/retired nil true] [:db/cas 17592186676257 :question/retired nil true] [:db/cas 17592186676266 :question/retired nil true] [:db/cas 17592186676269 :question/retired nil true] [:db/cas 17592186676270 :question/retired nil true] [:db/cas 17592186676272 :question/retired nil true] [:db/cas 17