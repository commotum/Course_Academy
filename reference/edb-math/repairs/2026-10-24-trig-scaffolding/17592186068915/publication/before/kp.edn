1}{2}\\right)-\\left(1\\right)\\right)\\\\ &=\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)" :db/id #edb/ref 17592186676268}] :answer-field/correct {:answer/id #uuid "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)" :db/id #edb/ref 17592186676268} :answer-field/id #uuid "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676243}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int 4\\cos\\left(1 - 5 x\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}} $+C$" :question/worked-solution "Let $u=1 - 5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-5,\\qquad \\mathrm{d}x=\\left(- \\frac{1}{5}\\right)\\mathrm{d}u.\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int 4\\cos\\left(1 - 5 x\\right)\\,\\mathrm{d}x\\\\ &=4\\left(- \\frac{1}{5}\\right)\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{4}{5}\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{4}{5}\\left(\\sin\\left(u\\right)\\right)+C\\\\ &=- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1095f69b-f72b-5d81-882c-368fd3763fb6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4}{3}" :db/id #edb/ref 17592186676234} {:answer/id #uuid "4391081d-d9d8-53a8-901c-23dfa8a391b6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186676251} {:answer/id #uuid "731bf815-7497-513a-8015-90a1c2f96ce1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186676273} {:answer/id #uuid "d4884d8f-8b64-533d-83a9-9935b7714d72" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186676303} {:answer/id #uuid "e264be86-492d-555e-b3b6-d506cc7faafa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186676309}] :answer-field/correct {:answer/id #uuid "e264be86-492d-555e-b3b6-d506cc7faafa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186676309} :answer-field/id #uuid "8c747eea-34fe-5f67-8f02-1bbde55c0a0a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676278}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8b55ce3b-54d2-5872-9ccd-0fcc112b2251" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{6}} 8\\sin\\left(6 x\\right)\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=6 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6,\\qquad \\mathrm{d}x=\\left(\\frac{1}{6}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{12}&\\quad\\Longrightarrow\\quad u=6\\left(\\frac{\\pi}{12}\\right)+\\left(0\\right)=\\frac{\\pi}{2}\\\\ x=\\frac{\\pi}{6}&\\quad\\Longrightarrow\\quad u=6\\left(\\frac{\\pi}{6}\\right)+\\left(0\\right)=\\pi.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{6}} 8\\sin\\left(6 x\\right)\\,\\mathrm{d}x\\\\ &=8\\left(\\frac{1}{6}\\right)\\int_{\\frac{\\pi}{2}}^{\\pi} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\int_{\\frac{\\pi}{2}}^{\\pi} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{\\pi}{2}}^{\\pi}\\\\ &=- \\frac{4}{3}\\left(\\cos\\left(\\pi\\right)-\\cos\\left(\\frac{\\pi}{2}\\right)\\right)\\\\ &=- \\frac{4}{3}\\left(\\left(-1\\right)-\\left(0\\right)\\right)\\\\ &=\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}" :db/id #edb/ref 17592186676307}] :answer-field/correct {:answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}" :db/id #edb/ref 17592186676307} :answer-field/id #uuid "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(- \\frac{\\pi}{16}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{2 \\pi}{3}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{7}{3}\\left(\\frac{3}{4}\\right)\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\left[\\sin\\left(u\\right)\\right]_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}}\\\\ &=\\frac{7}{4}\\left(\\sin\\left(\\frac{2 \\pi}{3}\\right)-\\sin\\left(\\frac{\\pi}{4}\\right)\\right)\\\\ &=\\frac{7}{4}\\left(\\left(\\frac{\\sqrt{3}}{2}\\right)-\\left(\\frac{\\sqrt{2}}{2}\\right)\\right)\\\\ &=- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186676242} {:answer/id #uuid "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186676271} {:answer/id #uuid "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{27}{2}" :db/id #edb/ref 17592186676283} {:answer/id #uuid "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186676287} {:answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186676312}] :answer-field/correct {:answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186676312} :answer-field/id #uuid "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676281}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=\\frac{2 x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{2}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(- \\frac{\\pi}{4}\\right)+\\left(0\\right)=- \\frac{\\pi}{6}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\\\\ &=9\\left(\\frac{3}{2}\\right)\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\left[\\sin\\left(u\\right)\\right]_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}}\\\\ &=\\frac{27}{2}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(- \\frac{\\pi}{6}\\right)\\right)\\\\ &=\\frac{27}{2}\\left(\\left(\\frac{1}{2}\\right)-\\left(- \\frac{1}{2}\\right)\\right)\\\\ &=\\frac{27}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}" :db/id #edb/ref 17592186676260} {:answer/id #uuid "3f95e4b3-cd66-44b1-b124-3ae7d5a657f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9\\left(\\sqrt2-1\\right)}{32}" :db/id #edb/ref 17592186677690}] :answer-field/correct {:answer/id #uuid "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}" :db/id #edb/ref 17592186676260} :answer-field/id #uuid "159128b8-e040-5516-a836-f601577308cb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676239}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bde0ea65-e851-569d-a00d-23c578b58f06" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\pi}{2}}^{\\frac{15 \\pi}{16}} \\frac{3}{4}\\sin\\left(\\frac{4 x}{3} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{2}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{2}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{7 \\pi}{6}\\\\ x=\\frac{15 \\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{15 \\pi}{16}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{7 \\pi}{4}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{2}}^{\\frac{15 \\pi}{16}} \\frac{3}{4}\\sin\\left(\\frac{4 x}{3} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{3}{4}\\left(\\frac{3}{4}\\right)\\int_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{9}{16}\\int_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{9}{16}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}}\\\\ &=- \\frac{9}{16}\\left(\\cos\\left(\\frac{7 \\pi}{4}\\right)-\\cos\\left(\\frac{7 \\pi}{6}\\right)\\right)\\\\ &=- \\frac{9}{16}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}" :db/id #edb/ref 17592186676256}] :answer-field/correct {:answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}" :db/id #edb/ref 17592186676256} :answer-field/id #uuid "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676306}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c367b576-70c2-5965-8278-60a472b975f2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=- \\frac{2 x}{5} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{2}{5},\\qquad \\mathrm{d}x=\\left(- \\frac{5}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{15 \\pi}{4}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(- \\frac{15 \\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{11 \\pi}{6}\\\\ x=\\frac{5 \\pi}{24}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(\\frac{5 \\pi}{24}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{4}{3}\\left(- \\frac{5}{2}\\right)\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}}\\\\ &=\\frac{10}{3}\\left(\\cos\\left(\\frac{\\pi}{4}\\right)-\\cos\\left(\\frac{11 \\pi}{6}\\right)\\right)\\\\ &=\\frac{10}{3}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(\\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}" :db/id #edb/ref 17592186676300}] :answer-field/correct {:answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}" :db/id #edb/ref 17592186676300} :answer-field/id #uuid "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676285}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=- \\frac{3 x}{2} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{3}{2},\\qquad \\mathrm{d}x=\\left(- \\frac{2}{3}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{7 \\pi}{9}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{7 \\pi}{9}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{5 \\pi}{3}\\\\ x=- \\frac{\\pi}{6}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{\\pi}{6}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{3 \\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{5}{3}\\left(- \\frac{2}{3}\\right)\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\left[\\sin\\left(u\\right)\\right]_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}}\\\\ &=- \\frac{10}{9}\\left(\\sin\\left(\\frac{3 \\pi}{4}\\right)-\\sin\\left(\\frac{5 \\pi}{3}\\right)\\right)\\\\ &=- \\frac{10}{9}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\pi}" :db/id #edb/ref 17592186676302}] :answer-field/correct {:answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\pi}" :db/id #edb/ref 17592186676302} :answer-field/id #uuid "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676311}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{\\pi x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\pi}{2},\\qquad \\mathrm{d}x=\\left(\\frac{2}{\\pi}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(0\\right)+\\left(0\\right)=0\\\\ x=\\frac{1}{3}&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(\\frac{1}{3}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x\\\\ &=7\\left(\\frac{2}{\\pi}\\right)\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\left[\\sin\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{6}}\\\\ &=\\frac{14}{\\pi}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(0\\right)\\right)\\\\ &=\\frac{14}{\\pi}\\left(\\left(\\frac{1}{2}\\right)-\\left(0\\right)\\right)\\\\ &=\\frac{7}{\\pi}.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Trigonometric Functions With Linear Arguments"}]}
