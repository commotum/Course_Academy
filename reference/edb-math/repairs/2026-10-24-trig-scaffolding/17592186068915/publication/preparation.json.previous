  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/id #uuid \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\"] [:db/add \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/type :answer.type/math] [:db/add \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/value \"4\\\\left(\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/validate] [:db/add \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/id #uuid \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\"] [:db/add \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/type :answer.type/math] [:db/add \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/value \"\\\\int_{\\\\frac{3 \\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/validate] [:db/add \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/id #uuid \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\"] [:db/add \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/type :answer.type/math] [:db/add \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/value \"2\\\\left(\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/validate] [:db/add \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/id #uuid \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\"] [:db/add \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/type :answer.type/math] [:db/add \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/value \"\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{3 \\\\pi}{4}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/validate] [:db/add \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/id #uuid \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\"] [:db/add \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/type :answer.type/math] [:db/add \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/value \"\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/validate] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/id #uuid \"0508bed8-6f0c-5744-9d06-ee9974f77066\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/key \"answer\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/type :answer-field.type/radio] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\"] [:db/add \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/correct \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\"] [:db/ensure \"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/validate] [:db/add \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/id #uuid \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\"] [:db/add \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{3 \\\\pi}{4}} 2 \\\\cos{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\pi\\\\\\\\x=\\\\frac{3 \\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{3 \\\\pi}{4}} 2 \\\\cos{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/difficulty :question.difficulty/easy] [:db/add \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/answer-fields \"0508bed8-6f0c-5744-9d06-ee9974f77066\"] [:db/ensure \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\"] [:db/add \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/id #uuid \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\"] [:db/add \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/type :answer.type/math] [:db/add \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/validate] [:db/add \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/id #uuid \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\"] [:db/add \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/type :answer.type/math] [:db/add \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/value \"\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/validate] [:db/add \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/id #uuid \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\"] [:db/add \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/type :answer.type/math] [:db/add \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/value \"3\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/validate] [:db/add \"de064156-605e-5acc-9433-8f67797fd421\" :answer/id #uuid \"de064156-605e-5acc-9433-8f67797fd421\"] [:db/add \"de064156-605e-5acc-9433-8f67797fd421\" :answer/type :answer.type/math] [:db/add \"de064156-605e-5acc-9433-8f67797fd421\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{2 \\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"de064156-605e-5acc-9433-8f67797fd421\" :answer/validate] [:db/add \"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/id #uuid \"174e1f57-27ba-5b50-8e1c-98e49800fec6\"] [:db/add \"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/type :answer.type/math] [:db/add \"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/validate] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/id #uuid \"ae68e617-0d18-59ff-b276-92bb3877ffb1\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/key \"answer\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/type :answer-field.type/radio] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"de064156-605e-5acc-9433-8f67797fd421\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"174e1f57-27ba-5b50-8e1c-98e49800fec6\"] [:db/add \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/correct \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\"] [:db/ensure \"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/validate] [:db/add \"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/id #uuid \"cc8aa811-99e1-5f7b-aa43-885740447191\"] [:db/add \"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\\\\\x=\\\\frac{2 \\\\pi}{3}&\\\\Longrightarrow u=2 \\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/difficulty :question.difficulty/easy] [:db/add \"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/answer-fields \"ae68e617-0d18-59ff-b276-92bb3877ffb1\"] [:db/ensure \"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"cc8aa811-99e1-5f7b-aa43-885740447191\"] [:db/add \"329a4cb4-a769-5de9-aacc-d3079ac1112e\" :answer/id #uuid \"329a4cb4-a769-5de9-aacc-d3079ac1112e\"] [:db/add \"329a4cb4-a769-5de9-aacc-d3079ac1112e\" :answer/type :answer.type/math] [:db/add \"329a4cb4-a769-5de9-aacc-d3079ac1112e\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"329a4cb4-a769-5de9-aacc-d3079ac1112e\" :answer/validate] [:db/add \"0d7b3916-d16a-55a0-887c-9707e9a294ca\" :answer/id #uuid \"0d7b3916-d16a-55a0-887c-9707e9a294ca\"] [:db/add \"0d7b3916-d16a-55a0-887c-9707e9a294ca\" :answer/type :answer.type/math] [:db/add \"0d7b3916-d16a-55a0-887c-9707e9a294ca\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0d7b3916-d16a-55a0-887c-9707e9a294ca\" :answer/validate] [:db/add \"a8d12b77-3bc8-5510-bf0f-5292e1c94647\" :answer/id #uuid \"a8d12b77-3bc8-5510-bf0f-5292e1c94647\"] [:db/add \"a8d12b77-3bc8-5510-bf0f-5292e1c94647\" :answer/type :answer.type/math] [:db/add \"a8d12b77-3bc8-5510-bf0f-5292e1c94647\" :answer/value \"\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"a8d12b77-3bc8-5510-bf0f-5292e1c94647\" :answer/validate] [:db/add \"e3244a65-bdfd-5e2b-b49c-7d1d726668df\" :answer/id #uuid \"e3244a65-bdfd-5e2b-b49c-7d1d726668df\"] [:db/add \"e3244a65-bdfd-5e2b-b49c-7d1d726668df\" :answer/type :answer.type/math] [:db/add \"e3244a65-bdfd-5e2b-b49c-7d1d726668df\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e3244a65-bdfd-5e2b-b49c-7d1d726668df\" :answer/validate] [:db/add \"0d364c40-fa06-5866-9730-fc22241b4e8d\" :answer/id #uuid \"0d364c40-fa06-5866-9730-fc22241b4e8d\"] [:db/add \"0d364c40-fa06-5866-9730-fc22241b4e8d\" :answer/type :answer.type/math] [:db/add \"0d364c40-fa06-5866-9730-fc22241b4e8d\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0d364c40-fa06-5866-9730-fc22241b4e8d\" :answer/validate] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/id #uuid \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/key \"answer\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/type :answer-field.type/radio] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/choices \"329a4cb4-a769-5de9-aacc-d3079ac1112e\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/choices \"0d7b3916-d16a-55a0-887c-9707e9a294ca\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/choices \"a8d12b77-3bc8-5510-bf0f-5292e1c94647\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/choices \"e3244a65-bdfd-5e2b-b49c-7d1d726668df\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/choices \"0d364c40-fa06-5866-9730-fc22241b4e8d\"] [:db/add \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/correct \"329a4cb4-a769-5de9-aacc-d3079ac1112e\"] [:db/ensure \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\" :answer-field/validate] [:db/add \"01533aaa-438a-5910-8a75-4893f358992d\" :question/id #uuid \"01533aaa-438a-5910-8a75-4893f358992d\"] [:db/add \"01533aaa-438a-5910-8a75-4893f358992d\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"01533aaa-438a-5910-8a75-4893f358992d\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"01533aaa-438a-5910-8a75-4893f358992d\" :question/difficulty :question.difficulty/easy] [:db/add \"01533aaa-438a-5910-8a75-4893f358992d\" :question/answer-fields \"51f41b3b-a03c-5106-84c8-f7a88bbcb4fa\"] [:db/ensure \"01533aaa-438a-5910-8a75-4893f358992d\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"01533aaa-438a-5910-8a75-4893f358992d\"] [:db/add \"1370ebf1-d10d-5180-8784-1da63b65d3cc\" :answer/id #uuid \"1370ebf1-d10d-5180-8784-1da63b65d3cc\"] [:db/add \"1370ebf1-d10d-5180-8784-1da63b65d3cc\" :answer/type :answer.type/math] [:db/add \"1370ebf1-d10d-5180-8784-1da63b65d3cc\" :answer/value \"\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"1370ebf1-d10d-5180-8784-1da63b65d3cc\" :answer/validate] [:db/add \"a6a23450-f444-5f2f-a684-aa998f8e2f64\" :answer/id #uuid \"a6a23450-f444-5f2f-a684-aa998f8e2f64\"] [:db/add \"a6a23450-f444-5f2f-a684-aa998f8e2f64\" :answer/type :answer.type/math] [:db/add \"a6a23450-f444-5f2f-a684-aa998f8e2f64\" :answer/value \"-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a6a23450-f444-5f2f-a684-aa998f8e2f64\" :answer/validate] [:db/add \"724fe2c8-bd5c-52c8-822c-2f560bfc0df9\" :answer/id #uuid \"724fe2c8-bd5c-52c8-822c-2f560bfc0df9\"] [:db/add \"724fe2c8-bd5c-52c8-822c-2f560bfc0df9\" :answer/type :answer.type/math] [:db/add \"724fe2c8-bd5c-52c8-822c-2f560bfc0df9\" :answer/value \"-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"724fe2c8-bd5c-52c8-822c-2f560bfc0df9\" :answer/validate] [:db/add \"87d0fe98-793f-5c5c-ae8f-50ede75bb5b7\" :answer/id #uuid \"87d0fe98-793f-5c5c-ae8f-50ede75bb5b7\"] [:db/add \"87d0fe98-793f-5c5c-ae8f-50ede75bb5b7\" :answer/type :answer.type/math] [:db/add \"87d0fe98-793f-5c5c-ae8f-50ede75bb5b7\" :answer/value \"2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"87d0fe98-793f-5c5c-ae8f-50ede75bb5b7\" :answer/validate] [:db/add \"20a6f83e-08a7-5e18-b0a6-e42e13f4d6b1\" :answer/id #uuid \"20a6f83e-08a7-5e18-b0a6-e42e13f4d6b1\"] [:db/add \"20a6f83e-08a7-5e18-b0a6-e42e13f4d6b1\" :answer/type :answer.type/math] [:db/add \"20a6f83e-08a7-5e18-b0a6-e42e13f4d6b1\" :answer/value \"\\\\frac{1