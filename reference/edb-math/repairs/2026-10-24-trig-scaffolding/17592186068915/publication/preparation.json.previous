m{d}u.\\n$$\"] [:db/add \"03958827-e800-5038-835b-8f267d750c98\" :question/difficulty :question.difficulty/easy] [:db/add \"03958827-e800-5038-835b-8f267d750c98\" :question/answer-fields \"4794dbc9-64ab-5a53-a007-6a1a920a04b4\"] [:db/ensure \"03958827-e800-5038-835b-8f267d750c98\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"03958827-e800-5038-835b-8f267d750c98\"] [:db/add \"7339cd0e-1f29-56db-82c5-65e15ad5bc9b\" :answer/id #uuid \"7339cd0e-1f29-56db-82c5-65e15ad5bc9b\"] [:db/add \"7339cd0e-1f29-56db-82c5-65e15ad5bc9b\" :answer/type :answer.type/math] [:db/add \"7339cd0e-1f29-56db-82c5-65e15ad5bc9b\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\pi}^{\\\\frac{\\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"7339cd0e-1f29-56db-82c5-65e15ad5bc9b\" :answer/validate] [:db/add \"bc570b4c-f861-5bd1-93e0-e9c24129d5bc\" :answer/id #uuid \"bc570b4c-f861-5bd1-93e0-e9c24129d5bc\"] [:db/add \"bc570b4c-f861-5bd1-93e0-e9c24129d5bc\" :answer/type :answer.type/math] [:db/add \"bc570b4c-f861-5bd1-93e0-e9c24129d5bc\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{3}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"bc570b4c-f861-5bd1-93e0-e9c24129d5bc\" :answer/validate] [:db/add \"fcf34e2b-5be3-5e2f-a6e9-571fa3eaeb2f\" :answer/id #uuid \"fcf34e2b-5be3-5e2f-a6e9-571fa3eaeb2f\"] [:db/add \"fcf34e2b-5be3-5e2f-a6e9-571fa3eaeb2f\" :answer/type :answer.type/math] [:db/add \"fcf34e2b-5be3-5e2f-a6e9-571fa3eaeb2f\" :answer/value \"\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"fcf34e2b-5be3-5e2f-a6e9-571fa3eaeb2f\" :answer/validate] [:db/add \"11ea9010-2924-534e-b1c1-86b7f19e24e6\" :answer/id #uuid \"11ea9010-2924-534e-b1c1-86b7f19e24e6\"] [:db/add \"11ea9010-2924-534e-b1c1-86b7f19e24e6\" :answer/type :answer.type/math] [:db/add \"11ea9010-2924-534e-b1c1-86b7f19e24e6\" :answer/value \"3\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"11ea9010-2924-534e-b1c1-86b7f19e24e6\" :answer/validate] [:db/add \"008c380d-4108-5a19-967d-ef5313f9c223\" :answer/id #uuid \"008c380d-4108-5a19-967d-ef5313f9c223\"] [:db/add \"008c380d-4108-5a19-967d-ef5313f9c223\" :answer/type :answer.type/math] [:db/add \"008c380d-4108-5a19-967d-ef5313f9c223\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"008c380d-4108-5a19-967d-ef5313f9c223\" :answer/validate] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/id #uuid \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/key \"answer\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/type :answer-field.type/radio] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/choices \"7339cd0e-1f29-56db-82c5-65e15ad5bc9b\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/choices \"bc570b4c-f861-5bd1-93e0-e9c24129d5bc\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/choices \"fcf34e2b-5be3-5e2f-a6e9-571fa3eaeb2f\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/choices \"11ea9010-2924-534e-b1c1-86b7f19e24e6\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/choices \"008c380d-4108-5a19-967d-ef5313f9c223\"] [:db/add \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/correct \"008c380d-4108-5a19-967d-ef5313f9c223\"] [:db/ensure \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\" :answer-field/validate] [:db/add \"77949b95-c0b4-5835-9c69-635a354c01c4\" :question/id #uuid \"77949b95-c0b4-5835-9c69-635a354c01c4\"] [:db/add \"77949b95-c0b4-5835-9c69-635a354c01c4\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{3}} \\\\cos{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"77949b95-c0b4-5835-9c69-635a354c01c4\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=\\\\frac{\\\\pi}{3}&\\\\Longrightarrow u=\\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{3}} \\\\cos{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"77949b95-c0b4-5835-9c69-635a354c01c4\" :question/difficulty :question.difficulty/easy] [:db/add \"77949b95-c0b4-5835-9c69-635a354c01c4\" :question/answer-fields \"d9e83ee0-4cee-5737-a67c-38a3c93a3e99\"] [:db/ensure \"77949b95-c0b4-5835-9c69-635a354c01c4\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"77949b95-c0b4-5835-9c69-635a354c01c4\"] [:db/add \"c717e493-67d1-5bc5-a487-4f2939406ecb\" :answer/id #uuid \"c717e493-67d1-5bc5-a487-4f2939406ecb\"] [:db/add \"c717e493-67d1-5bc5-a487-4f2939406ecb\" :answer/type :answer.type/math] [:db/add \"c717e493-67d1-5bc5-a487-4f2939406ecb\" :answer/value \"3\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c717e493-67d1-5bc5-a487-4f2939406ecb\" :answer/validate] [:db/add \"0c353a19-a25f-5078-b6f3-06dfcb6caea6\" :answer/id #uuid \"0c353a19-a25f-5078-b6f3-06dfcb6caea6\"] [:db/add \"0c353a19-a25f-5078-b6f3-06dfcb6caea6\" :answer/type :answer.type/math] [:db/add \"0c353a19-a25f-5078-b6f3-06dfcb6caea6\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{4}}^{\\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0c353a19-a25f-5078-b6f3-06dfcb6caea6\" :answer/validate] [:db/add \"528070fb-b8bd-5441-9140-45ad14d2bb8c\" :answer/id #uuid \"528070fb-b8bd-5441-9140-45ad14d2bb8c\"] [:db/add \"528070fb-b8bd-5441-9140-45ad14d2bb8c\" :answer/type :answer.type/math] [:db/add \"528070fb-b8bd-5441-9140-45ad14d2bb8c\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{2 \\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"528070fb-b8bd-5441-9140-45ad14d2bb8c\" :answer/validate] [:db/add \"5fd23677-6da2-5d26-8454-2efaaa0f66da\" :answer/id #uuid \"5fd23677-6da2-5d26-8454-2efaaa0f66da\"] [:db/add \"5fd23677-6da2-5d26-8454-2efaaa0f66da\" :answer/type :answer.type/math] [:db/add \"5fd23677-6da2-5d26-8454-2efaaa0f66da\" :answer/value \"6\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5fd23677-6da2-5d26-8454-2efaaa0f66da\" :answer/validate] [:db/add \"87268af2-555b-5869-bd1d-42efcda52e84\" :answer/id #uuid \"87268af2-555b-5869-bd1d-42efcda52e84\"] [:db/add \"87268af2-555b-5869-bd1d-42efcda52e84\" :answer/type :answer.type/math] [:db/add \"87268af2-555b-5869-bd1d-42efcda52e84\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"87268af2-555b-5869-bd1d-42efcda52e84\" :answer/validate] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/id #uuid \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/key \"answer\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/type :answer-field.type/radio] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/choices \"c717e493-67d1-5bc5-a487-4f2939406ecb\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/choices \"0c353a19-a25f-5078-b6f3-06dfcb6caea6\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/choices \"528070fb-b8bd-5441-9140-45ad14d2bb8c\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/choices \"5fd23677-6da2-5d26-8454-2efaaa0f66da\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/choices \"87268af2-555b-5869-bd1d-42efcda52e84\"] [:db/add \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/correct \"87268af2-555b-5869-bd1d-42efcda52e84\"] [:db/ensure \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\" :answer-field/validate] [:db/add \"7f76f030-ea03-524c-9680-a6f688f6325f\" :question/id #uuid \"7f76f030-ea03-524c-9680-a6f688f6325f\"] [:db/add \"7f76f030-ea03-524c-9680-a6f688f6325f\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{\\\\frac{3 \\\\pi}{4}}^{\\\\pi} 3 \\\\sin{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"7f76f030-ea03-524c-9680-a6f688f6325f\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{3 \\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\\\\\x=\\\\pi&\\\\Longrightarrow u=2 \\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{3 \\\\pi}{4}}^{\\\\pi} 3 \\\\sin{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"7f76f030-ea03-524c-9680-a6f688f6325f\" :question/difficulty :question.difficulty/easy] [:db/add \"7f76f030-ea03-524c-9680-a6f688f6325f\" :question/answer-fields \"6ff1f7d1-ba92-5659-a166-86a70b0b1e04\"] [