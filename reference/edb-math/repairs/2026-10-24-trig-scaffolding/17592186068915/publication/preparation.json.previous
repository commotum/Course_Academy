answer/type :answer.type/math] [:db/add \"3185c284-174a-5de9-9fcc-b81120e57947\" :answer/value \"-\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"3185c284-174a-5de9-9fcc-b81120e57947\" :answer/validate] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/id #uuid \"a3508ac1-91cd-5909-b864-c38a56b47702\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/key \"answer\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/type :answer-field.type/radio] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/choices \"af66ef88-cf83-5f91-bfc0-f9f6fb513226\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/choices \"4f51384d-7893-5c2f-b40e-f039060605dc\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/choices \"6b56642e-85d1-54a2-9e38-06e33e664536\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/choices \"bdbd2481-d186-5643-8429-a445812bd2dc\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/choices \"3185c284-174a-5de9-9fcc-b81120e57947\"] [:db/add \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/correct \"4f51384d-7893-5c2f-b40e-f039060605dc\"] [:db/ensure \"a3508ac1-91cd-5909-b864-c38a56b47702\" :answer-field/validate] [:db/add \"369e69ee-ba29-5731-a1df-5057b2bd69bb\" :question/id #uuid \"369e69ee-ba29-5731-a1df-5057b2bd69bb\"] [:db/add \"369e69ee-ba29-5731-a1df-5057b2bd69bb\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\sin{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"369e69ee-ba29-5731-a1df-5057b2bd69bb\" :question/worked-solution \"Let $u=4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\sin{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"369e69ee-ba29-5731-a1df-5057b2bd69bb\" :question/difficulty :question.difficulty/easy] [:db/add \"369e69ee-ba29-5731-a1df-5057b2bd69bb\" :question/answer-fields \"a3508ac1-91cd-5909-b864-c38a56b47702\"] [:db/ensure \"369e69ee-ba29-5731-a1df-5057b2bd69bb\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"369e69ee-ba29-5731-a1df-5057b2bd69bb\"] [:db/add \"a73c7853-e031-54b0-8d07-0814d416a36c\" :answer/id #uuid \"a73c7853-e031-54b0-8d07-0814d416a36c\"] [:db/add \"a73c7853-e031-54b0-8d07-0814d416a36c\" :answer/type :answer.type/math] [:db/add \"a73c7853-e031-54b0-8d07-0814d416a36c\" :answer/value \"-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a73c7853-e031-54b0-8d07-0814d416a36c\" :answer/validate] [:db/add \"78d2fabd-5621-5dc4-895e-1542b704d140\" :answer/id #uuid \"78d2fabd-5621-5dc4-895e-1542b704d140\"] [:db/add \"78d2fabd-5621-5dc4-895e-1542b704d140\" :answer/type :answer.type/math] [:db/add \"78d2fabd-5621-5dc4-895e-1542b704d140\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"78d2fabd-5621-5dc4-895e-1542b704d140\" :answer/validate] [:db/add \"d6516896-aae3-5b1a-8668-b8e47e7400b4\" :answer/id #uuid \"d6516896-aae3-5b1a-8668-b8e47e7400b4\"] [:db/add \"d6516896-aae3-5b1a-8668-b8e47e7400b4\" :answer/type :answer.type/math] [:db/add \"d6516896-aae3-5b1a-8668-b8e47e7400b4\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d6516896-aae3-5b1a-8668-b8e47e7400b4\" :answer/validate] [:db/add \"a1815eda-ab58-58e7-8b74-3c36e64843de\" :answer/id #uuid \"a1815eda-ab58-58e7-8b74-3c36e64843de\"] [:db/add \"a1815eda-ab58-58e7-8b74-3c36e64843de\" :answer/type :answer.type/math] [:db/add \"a1815eda-ab58-58e7-8b74-3c36e64843de\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a1815eda-ab58-58e7-8b74-3c36e64843de\" :answer/validate] [:db/add \"c902d9fa-5024-5388-801d-133c06ec4daf\" :answer/id #uuid \"c902d9fa-5024-5388-801d-133c06ec4daf\"] [:db/add \"c902d9fa-5024-5388-801d-133c06ec4daf\" :answer/type :answer.type/math] [:db/add \"c902d9fa-5024-5388-801d-133c06ec4daf\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c902d9fa-5024-5388-801d-133c06ec4daf\" :answer/validate] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/id #uuid \"ec2ea545-7705-5b75-bfb2-a127dac9549b\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/key \"answer\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/type :answer-field.type/radio] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/choices \"a73c7853-e031-54b0-8d07-0814d416a36c\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/choices \"78d2fabd-5621-5dc4-895e-1542b704d140\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/choices \"d6516896-aae3-5b1a-8668-b8e47e7400b4\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/choices \"a1815eda-ab58-58e7-8b74-3c36e64843de\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/choices \"c902d9fa-5024-5388-801d-133c06ec4daf\"] [:db/add \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/correct \"78d2fabd-5621-5dc4-895e-1542b704d140\"] [:db/ensure \"ec2ea545-7705-5b75-bfb2-a127dac9549b\" :answer-field/validate] [:db/add \"e96a768a-8b82-51b7-a945-24730214a8a0\" :question/id #uuid \"e96a768a-8b82-51b7-a945-24730214a8a0\"] [:db/add \"e96a768a-8b82-51b7-a945-24730214a8a0\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\cos{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"e96a768a-8b82-51b7-a945-24730214a8a0\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\cos{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"e96a768a-8b82-51b7-a945-24730214a8a0\" :question/difficulty :question.difficulty/easy] [:db/add \"e96a768a-8b82-51b7-a945-24730214a8a0\" :question/answer-fields \"ec2ea545-7705-5b75-bfb2-a127dac9549b\"] [:db/ensure \"e96a768a-8b82-51b7-a945-24730214a8a0\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"e96a768a-8b82-51b7-a945-24730214a8a0\"] [:db/add \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\" :answer/id #uuid \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\"] [:db/add \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\" :answer/type :answer.type/math] [:db/add \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\" :answer/value \"- \\\\frac{\\\\cos{\\\\left(4 x + 3 \\\\right)}}{4}\"] [:db/ensure \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\" :answer/validate] [:db/add \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\" :answer-field/id #uuid \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\"] [:db/add \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\" :answer-field/key \"answer\"] [:db/add \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\" :answer-field/type :answer-field.type/blank] [:db/add \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\" :answer-field/choices \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\"] [:db/add \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\" :answer-field/correct \"dd974687-5fe3-5eb5-b3e7-f18717cb0939\"] [:db/ensure \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\" :answer-field/validate] [:db/add \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\" :question/id #uuid \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\"] [:db/add \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\sin{\\\\left(4 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\" :question/worked-solution \"Let $u=4 x + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\sin{\\\\left(4 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{\\\\cos{\\\\left(u \\\\right)}}{4}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{\\\\cos{\\\\left(4 x + 3 \\\\right)}}{4}+C.\\n$$\"] [:db/add \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\" :question/difficulty :question.difficulty/moderate] [:db/add \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\" :question/answer-fields \"0c6c0ae1-37a9-54de-9f9b-77c31a7073fb\"] [:db/ensure \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"85d13d2d-f042-57af-a1a0-8e6f471f6d8a\"] [:db/add \"5871b02d-2bef-5fb1-865e-65aff4cc3969\" :answer/id #uuid \"5871b02d-2bef-5fb1-865e-65aff4cc3969\"] [:db/add \"5871b02d-2bef-5fb1-865e-65aff4cc3969\" :answer/type :answer.type/math] [:db/add \"5871b02d-2bef-5fb1-865e-65aff4cc3969\" :answer/value \"\\\\frac{3}{4}\"] [:db/ensure \"5871b02d-2bef-5fb1-865e-65aff4cc3969\" :answer/validate] [:db/add \"866f3cb3-d08c-55fc-9741-2055767f7e3a\" :answer-field/id #uuid \"866f3cb3-d08c-55fc-9741-2055767f7e3a\"] [:db/add \"866f3cb3-d08c-55fc-9741-2055767f7e3a\" :answer-field/key \"answer\"] [:db/add \"866f3cb3-d08c-55fc-9741-2055767f7e3a\" :answer-field/type :answer-field.type/blank] [:db/add \"866f3cb3-d08c-55fc-9741-2055767f7e3a\" :answer-field/choices \"5871b02d-2bef-5fb1-865e-65aff4cc3969\"] [:db/add \"866f3cb3-d08c-55fc-9741-2055767f7e3a\" :answer-field/correct \"5871b02d-2bef-5fb1-865e-65aff4cc3969\"] [:db/ensure \"866f3cb3-d08c-55fc-9741-2055767f7e3a\" :answer-field/validate] [:db/add \"e448a4d2-65fb-5da5-83af-e67ab30b203d\" :question/id #uuid \"e448a4d2-65fb-5da5-83af-e67ab30b203d\"] [:db/add \"e448a4d2-65fb-5da5-83af-e67ab30b203d\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{3 \\\\pi}{8}}^{\\\\frac{\\\\pi}{2}} 3 \\\\cos{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\sin{\\\\left(\\\\frac{3 \\\\pi}{2} \\\\right)}=-1,\\\\quad \\\\sin{\\\\left(2 \\\\pi \\\\right)}=0$.\\n\\n{{answer}}\"] [:db/add \"e448a4d2-65fb-5da5-83af-e67ab30b203d\" :question/worked-solution \"Let $u=4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{3 \\\\pi}{8}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=2 \\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{3 \\\\pi}{8}}^{\\\\frac{\\\\pi}{2}} 3 \\\\cos{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[\\\\frac{3 \\\\sin{\\\\left(u \\\\right)}}{4}\\\\right]_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi}=\\\\left(0\\\\right)-\\\\left(- \\\\frac{3}{4}\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\frac{3}{4}.\\n$$\"] [:db/add \"e448a4d2-65fb-5da5-83af-e67ab30b203d\" :question/difficulty :question.difficulty/moderate] [:db/add \"e448a4d2-65fb-5da5-83af-e67ab30b203d\" :question/answer-fields \"866f3cb3-d08c-55fc-9741-2055767f7e3a\"] [:db/ensure \"e448a4d2-65fb-5da5-83af-e67ab30b203d\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"e448a4d2-65fb-5da5-83af-e67ab30b203d\"] [:db/add \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\" :answer/id #uuid \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\"] [:db/add \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\" :answer/type :answer.type/math] [:db/add \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\" :answer/value \"\\\\frac{3}{2}\"] [:db/ensure \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\" :answer/validate] [:db/add \"cc9a28eb-7848-5087-9875-b8382c66378c\" :answer-field/id #uuid \"cc9a28eb-7848-5087-9875-b8382c66378c\"] [:db/add \"cc9a28eb-7848-5087-9875-b8382c66378c\" :answer-field/key \"answer\"] [:db/add \"cc9a28eb-7848-5087-9875-b8382c66378c\" :answer-field/type :answer-field.type/blank] [:db/add \"cc9a28eb-7848-5087-9875-b8382c66378c\" :answer-field/choices \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\"] [:db/add \"cc9a28eb-7848-5087-9875-b8382c66378c\" :answer-field/correct \"21ace9e0-6bda-5c7f-ac52-9b7bae7dcbe3\"] [:db/ensure \"cc9a28eb-7848-5087-9875-b8382c66378c\" :answer-field/validate] [:db/add \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\" :question/id #uuid \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\"] [:db/add \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{2}} 3 \\\\sin{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\cos{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=0,\\\\quad \\\\cos{\\\\left(\\\\pi \\\\right)}=-1$.\\n\\n{{answer}}\"] [:db/add \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{2}} 3 \\\\sin{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\frac{3 \\\\cos{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{2}}^{\\\\pi}=\\\\left(\\\\frac{3}{2}\\\\right)-\\\\left(0\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\frac{3}{2}.\\n$$\"] [:db/add \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\" :question/difficulty :question.difficulty/moderate] [:db/add \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\" :question/answer-fields \"cc9a28eb-7848-5087-9875-b8382c66378c\"] [:db/ensure \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"f85dd1a8-9614-5c1d-8fde-7f1192c68aed\"] [:db/add \"06e86e62-b46c-53c0-b647-0a53dd840de6\" :answer/id #uuid \"06e86e62-b46c-53c0-b647-0a53dd840de6\"] [:db/add \"06e86e62-b46c-53c0-b647-0a53dd840de6\" :answer/type :answer.type/math] [:db/add \"06e86e62-b46c-53c0-b647-0a53dd840de6\" :answer/value \"\\\\sin{\\\\left(4 x + 1 \\\\right)}\"] [:db/ensure \"06e86e62-b46c-53c0-b647-0a53dd840de6\" :answer/validate] [:db/add \"58cda100-a260-5e8e-be68-fde68d9e9f1e\" :answer-field/id #uuid \"58cda100-a260-5e8e-be68-fde68d9e9f1e\"] [:db/add \"58cda100-a260-5e8e-be68-fde68d9e9f1e\" :answer-field/key \"answer\"] [:db/add \"58cda100-a260-5e8e-be68-fde68d9e9f1e\" :answer-field/type :answer-field.type/blank] [:db/add \"58cda100-a260-5e8e-be68-fde68d9e9f1e\" :answer-field/choices \"06e86e62-b46c-53c0-b647-0a53dd840de6\"] [:db/add \"58cda100-a260-5e8e-be68-fde68d9e9f1e\" :answer-field/correct \"06e86e62-b46c-53c0-b647-0a53dd840de6\"] [:db/ensure \"58cda100-a260-5e8e-be68-fde68d9e9f1e\" :answer-field/validate] [:db/add \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\" :question/id #uuid \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\"] [:db/add \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cos{\\\\left(4 x + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\" :question/worked-solution \"Let $u=4 x + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cos{\\\\left(4 x + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\sin{\\\\left(4 x + 1 \\\\right)}+C.\\n$$\"] [:db/add \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\" :question/difficulty :question.difficulty/moderate] [:db/add \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\" :question/answer-fields \"58cda100-a260-5e8e-be68-fde68d9e9f1e\"] [:db/ensure \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55\"] [:db/add \"228461a2-75b4-5f54-8f71-89933be5be66\" :answer/id #uuid \"228461a2-75b4-5f54-8f71-89933be5be66\"] [:db/add \"228461a2-75b4-5f54-8f71-89933be5be66\" :answer/type :answer.type/math] [:db/add \"228461a2-75b4-5f54-8f71-89933be5be66\" :answer/value \"- \\\\frac{3 \\\\cos{\\\\left(2 x + 1 \\\\right)}}{2}\"] [:db/ensure \"228461a2-75b4-5f54-8f71-89933be5be66\" :answer/validate] [:db/add \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\" :answer-field/id #uuid \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\"] [:db/add \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\" :answer-field/key \"answer\"] [:db/add \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\" :answer-field/type :answer-field.type/blank] [:db/add \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\" :answer-field/choices \"228461a2-75b4-5f54-8f71-89933be5be66\"] [:db/add \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\" :answer-field/correct \"228461a2-75b4-5f54-8f71-89933be5be66\"] [:db/ensure \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\" :answer-field/validate] [:db/add \"364c4cf3-af52-5e60-b60f-daba0a790be0\" :question/id #uuid \"364c4cf3-af52-5e60-b60f-daba0a790be0\"] [:db/add \"364c4cf3-af52-5e60-b60f-daba0a790be0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\sin{\\\\left(2 x + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"364c4cf3-af52-5e60-b60f-daba0a790be0\" :question/worked-solution \"Let $u=2 x + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\sin{\\\\left(2 x + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3 \\\\cos{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3 \\\\cos{\\\\left(2 x + 1 \\\\right)}}{2}+C.\\n$$\"] [:db/add \"364c4cf3-af52-5e60-b60f-daba0a790be0\" :question/difficulty :question.difficulty/moderate] [:db/add \"364c4cf3-af52-5e60-b60f-daba0a790be0\" :question/answer-fields \"9fb08089-1bd7-5116-9851-4fa4e676b4dc\"] [:db/ensure \"364c4cf3-af52-5e60-b60f-daba0a790be0\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"364c4cf3-af52-5e60-b60f-daba0a790be0\"] [:db/add \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\" :answer/id #uuid \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\"] [:db/add \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\" :answer/type :answer.type/math] [:db/add \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\" :answer/value \"- \\\\frac{2}{3}\"] [:db/ensure \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\" :answer/validate] [:db/add \"dcd96290-8241-5bb2-b355-d84f90a808e0\" :answer-field/id #uuid \"dcd96290-8241-5bb2-b355-d84f90a808e0\"] [:db/add \"dcd96290-8241-5bb2-b355-d84f90a808e0\" :answer-field/key \"answer\"] [:db/add \"dcd96290-8241-5bb2-b355-d84f90a808e0\" :answer-field/type :answer-field.type/blank] [:db/add \"dcd96290-8241-5bb2-b355-d84f90a808e0\" :answer-field/choices \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\"] [:db/add \"dcd96290-8241-5bb2-b355-d84f90a808e0\" :answer-field/correct \"b8772597-72e4-58b4-b2a1-6f679b96ed8f\"] [:db/ensure \"dcd96290-8241-5bb2-b355-d84f90a808e0\" :answer-field/validate] [:db/add \"25bced4a-34ed-5c44-b898-2a6f8e96effe\" :question/id #uuid \"25bced4a-34ed-5c44-b898-2a6f8e96effe\"] [:db/add \"25bced4a-34ed-5c44-b898-2a6f8e96effe\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{2}} 2 \\\\cos{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\sin{\\\\left(\\\\pi \\\\right)}=0,\\\\quad \\\\sin{\\\\left(\\\\frac{3 \\\\pi}{2} \\\\right)}=-1$.\\n\\n{{answer}}\"] [:db/add \"25bced4a-34ed-5c44-b898-2a6f8e96effe\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{3}&\\\\Longrightarrow u=\\\\pi\\\\\\\\x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{2}} 2 \\\\cos{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[\\\\frac{2 \\\\sin{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}}=\\\\left(- \\\\frac{2}{3}\\\\right)-\\\\left(0\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n- \\\\frac{2}{3}.\\n$$\"] [:db/add \"25bced4a-34ed-5c44-b898-2a6f8e96effe\" :question/difficulty :question.difficulty/moderate] [:db/add \"25bced4a-34ed-5c44-b898-2a6f8e96effe\" :question/answer-fields \"dcd96290-8241-5bb2-b355-d84f90a808e0\"] [:db/ensure \"25bced4a-34ed-5c44-b898-2a6f8e96effe\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"25bced4a-34ed-5c44-b898-2a6f8e96effe\"] [:db/add \"021af31d-9874-5ae8-a272-4821d0e63678\" :answer/id #uuid \"021af31d-9874-5ae8-a272-4821d0e63678\"] [:db/add \"021af31d-9874-5ae8-a272-4821d0e63678\" :answer/type :answer.type/math] [:db/add \"021af31d-9874-5ae8-a272-4821d0e63678\" :answer/value \"- \\\\frac{4}{3}\"] [:db/ensure \"021af31d-9874-5ae8-a272-4821d0e63678\" :answer/validate] [:db/add \"30b9da8d-548f-5899-b955-bc31acebc31c\" :answer-field/id #uuid \"30b9da8d-548f-5899-b955-bc31acebc31c\"] [:db/add \"30b9da8d-548f-5899-b955-bc31acebc31c\" :answer-field/key \"answer\"] [:db/add \"30b9da8d-548f-5899-b955-bc31acebc31c\" :answer-field/type :answer-field.type/blank] [:db/add \"30b9da8d-548f-5899-b955-bc31acebc31c\" :answer-field/choices \"021af31d-9874-5ae8-a272-4821d0e63678\"] [:db/add \"30b9da8d-548f-5899-b955-bc31acebc31c\" :answer-field/correct \"021af31d-9874-5ae8-a272-4821d0e63678\"] [:db/ensure \"30b9da8d-548f-5899-b955-bc31acebc31c\" :answer-field/validate] [:db/add \"50022ab1-a0ca-57a9-87be-133525d6d898\" :question/id #uuid \"50022ab1-a0ca-57a9-87be-133525d6d898\"] [:db/add \"50022ab1-a0ca-57a9-87be-133525d6d898\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} 4 \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\cos{\\\\left(\\\\frac{3 \\\\pi}{2} \\\\right)}=0,\\\\quad \\\\cos{\\\\left(2 \\\\pi \\\\right)}=1$.\\n\\n{{answer}}\"] [:db/add \"50022ab1-a0ca-57a9-87be-133525d6d898\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\\\\\x=\\\\frac{2 \\\\pi}{3}&\\\\Longrightarrow u=2 \\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} 4 \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\frac{4 \\\\cos{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi}=\\\\left(- \\\\frac{4}{3}\\\\right)-\\\\left(0\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n- \\\\frac{4}{3}.\\n$$\"] [:db/add \"50022ab1-a0ca-57a9-87be-133525d6d898\" :question/difficulty :question.difficulty/moderate] [:db/add \"50022ab1-a0ca-57a9-87be-133525d6d898\" :question/answer-fields \"30b9da8d-548f-5899-b955-bc31acebc31c\"] [:db/ensure \"50022ab1-a0ca-57a9-87be-133525d6d898\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"50022ab1-a0ca-57a9-87be-133525d6d898\"] [:db/add \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\" :answer/id #uuid \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\"] [:db/add \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\" :answer/type :answer.type/math] [:db/add \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\" :answer/value \"\\\\frac{\\\\sin{\\\\left(3 x + 2 \\\\right)}}{3}\"] [:db/ensure \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\" :answer/validate] [:db/add \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\" :answer-field/id #uuid \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\"] [:db/add \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\" :answer-field/key \"answer\"] [:db/add \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\" :answer-field/type :answer-field.type/blank] [:db/add \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\" :answer-field/choices \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\"] [:db/add \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\" :answer-field/correct \"3b2130aa-7e91-5e77-ad7e-0a4dadbf02b7\"] [:db/ensure \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\" :answer-field/validate] [:db/add \"6ea83d61-8ef7-5554-9089-4e7d6658d120\" :question/id #uuid \"6ea83d61-8ef7-5554-9089-4e7d6658d120\"] [:db/add \"6ea83d61-8ef7-5554-9089-4e7d6658d120\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\cos{\\\\left(3 x + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"6ea83d61-8ef7-5554-9089-4e7d6658d120\" :question/worked-solution \"Let $u=3 x + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\cos{\\\\left(3 x + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\sin{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\sin{\\\\left(3 x + 2 \\\\right)}}{3}+C.\\n$$\"] [:db/add \"6ea83d61-8ef7-5554-9089-4e7d6658d120\" :question/difficulty :question.difficulty/moderate] [:db/add \"6ea83d61-8ef7-5554-9089-4e7d6658d120\" :question/answer-fields \"aba90ca0-400c-5f66-bb8d-ad32c6b1fcb8\"] [:db/ensure \"6ea83d61-8ef7-5554-9089-4e7d6658d120\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"6ea83d61-8ef7-5554-9089-4e7d6658d120\"] [:db/add \"74c24471-9d9e-52c9-9422-32e366c0f2a9\" :answer/id #uuid \"74c24471-9d9e-52c9-9422-32e366c0f2a9\"] [:db/add \"74c24471-9d9e-52c9-9422-32e366c0f2a9\" :answer/type :answer.type/math] [:db/add \"74c24471-9d9e-52c9-9422-32e366c0f2a9\" :answer/value \"- \\\\frac{4}{3}\"] [:db/ensure \"74c24471-9d9e-52c9-9422-32e366c0f2a9\" :answer/validate] [:db/add \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\" :answer-field/id #uuid \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\"] [:db/add \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\" :answer-field/key \"answer\"] [:db/add \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\" :answer-field/type :answer-field.type/blank] [:db/add \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\" :answer-field/choices \"74c24471-9d9e-52c9-9422-32e366c0f2a9\"] [:db/add \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\" :answer-field/correct \"74c24471-9d9e-52c9-9422-32e366c0f2a9\"] [:db/ensure \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\" :answer-field/validate] [:db/add \"cce7215f-f09f-5bb0-8216-21c5515d0db7\" :question/id #uuid \"cce7215f-f09f-5bb0-8216-21c5515d0db7\"] [:db/add \"cce7215f-f09f-5bb0-8216-21c5515d0db7\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{6}} 4 \\\\sin{\\\\left(- 3 x + 2 \\\\pi \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\cos{\\\\left(2 \\\\pi \\\\right)}=1,\\\\quad \\\\cos{\\\\left(\\\\frac{3 \\\\pi}{2} \\\\right)}=0$.\\n\\n{{answer}}\"] [:db/add \"cce7215f-f09f-5bb0-8216-21c5515d0db7\" :question/worked-solution \"Let $u=- 3 x + 2 \\\\pi$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2 \\\\pi\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{6}} 4 \\\\sin{\\\\left(- 3 x + 2 \\\\pi \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{4}{3}\\\\left(\\\\int_{2 \\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[\\\\frac{4 \\\\cos{\\\\left(u \\\\right)}}{3}\\\\right]_{2 \\\\pi}^{\\\\frac{3 \\\\pi}{2}}=\\\\left(0\\\\right)-\\\\left(\\\\frac{4}{3}\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n- \\\\frac{4}{3}.\\n$$\"] [:db/add \"cce7215f-f09f-5bb0-8216-21c5515d0db7\" :question/difficulty :question.difficulty/hard] [:db/add \"cce7215f-f09f-5bb0-8216-21c5515d0db7\" :question/answer-fields \"334999f2-0ee1-5d2c-a8b2-9f1cd538e034\"] [:db/ensure \"cce7215f-f09f-5bb0-8216-21c5515d0db7\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"cce7215f-f09f-5bb0-8216-21c5515d0db7\"] [:db/add \"2bd2ef87-461c-54e9-9cd4-436889993594\" :answer/id #uuid \"2bd2ef87-461c-54e9-9cd4-436889993594\"] [:db/add \"2bd2ef87-461c-54e9-9cd4-436889993594\" :answer/type :answer.type/math] [:db/add \"2bd2ef87-461c-54e9-9cd4-436889993594\" :answer/value \"- \\\\sin{\\\\left(1 - 4 x \\\\right)}\"] [:db/ensure \"2bd2ef87-461c-54e9-9cd4-436889993594\" :answer/validate] [:db/add \"7662edc2-84aa-5b07-a675-80237a70e872\" :answer-field/id #uuid \"7662edc2-84aa-5b07-a675-80237a70e872\"] [:db/add \"7662edc2-84aa-5b07-a675-80237a70e872\" :answer-field/key \"answer\"] [:db/add \"7662edc2-84aa-5b07-a675-80237a70e872\" :answer-field/type :answer-field.type/blank] [:db/add \"7662edc2-84aa-5b07-a675-80237a70e872\" :answer-field/choices \"2bd2ef87-461c-54e9-9cd4-436889993594\"] [:db/add \"7662edc2-84aa-5b07-a675-80237a70e872\" :answer-field/correct \"2bd2ef87-461c-54e9-9cd4-436889993594\"] [:db/ensure \"7662edc2-84aa-5b07-a675-80237a70e872\" :answer-field/validate] [:db/add \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\" :question/id #uuid \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\"] [:db/add \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cos{\\\\left(1 - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\" :question/worked-solution \"Let $u=1 - 4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cos{\\\\left(1 - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\sin{\\\\left(1 - 4 x \\\\right)}+C.\\n$$\"] [:db/add \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\" :question/difficulty :question.difficulty/hard] [:db/add \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\" :question/answer-fields \"7662edc2-84aa-5b07-a675-80237a70e872\"] [:db/ensure \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd\"] [:db/add \"6ae91d07-3efa-5396-90bc-0c41330a98d6\" :answer/id #uuid \"6ae91d07-3efa-5396-90bc-0c41330a98d6\"] [:db/add \"6ae91d07-3efa-5396-90bc-0c41330a98d6\" :answer/type :answer.type/math] [:db/add \"6ae91d07-3efa-5396-90bc-0c41330a98d6\" :answer/value \"\\\\cos{\\\\left(2 - 3 x \\\\right)}\"] [:db/ensure \"6ae91d07-3efa-5396-90bc-0c41330a98d6\" :answer/validate] [:db/add \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\" :answer-field/id #uuid \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\"] [:db/add \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\" :answer-field/key \"answer\"] [:db/add \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\" :answer-field/type :answer-field.type/blank] [:db/add \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\" :answer-field/choices \"6ae91d07-3efa-5396-90bc-0c41330a98d6\"] [:db/add \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\" :answer-field/correct \"6ae91d07-3efa-5396-90bc-0c41330a98d6\"] [:db/ensure \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\" :answer-field/validate] [:db/add \"7c02193f-338d-5ea4-8f7d-c922830d530c\" :question/id #uuid \"7c02193f-338d-5ea4-8f7d-c922830d530c\"] [:db/add \"7c02193f-338d-5ea4-8f7d-c922830d530c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\sin{\\\\left(2 - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"7c02193f-338d-5ea4-8f7d-c922830d530c\" :question/worked-solution \"Let $u=2 - 3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\sin{\\\\left(2 - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\cos{\\\\left(2 - 3 x \\\\right)}+C.\\n$$\"] [:db/add \"7c02193f-338d-5ea4-8f7d-c922830d530c\" :question/difficulty :question.difficulty/hard] [:db/add \"7c02193f-338d-5ea4-8f7d-c922830d530c\" :question/answer-fields \"80e6fd79-df4f-5e2f-b1d0-c8b8ac7c8d51\"] [:db/ensure \"7c02193f-338d-5ea4-8f7d-c922830d530c\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"7c02193f-338d-5ea4-8f7d-c922830d530c\"] [:db/add \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\" :answer/id #uuid \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\"] [:db/add \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\" :answer/type :answer.type/math] [:db/add \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\" :answer/value \"1\"] [:db/ensure \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\" :answer/validate] [:db/add \"aec93d34-d853-521e-9b50-c9c26acbc741\" :answer-field/id #uuid \"aec93d34-d853-521e-9b50-c9c26acbc741\"] [:db/add \"aec93d34-d853-521e-9b50-c9c26acbc741\" :answer-field/key \"answer\"] [:db/add \"aec93d34-d853-521e-9b50-c9c26acbc741\" :answer-field/type :answer-field.type/blank] [:db/add \"aec93d34-d853-521e-9b50-c9c26acbc741\" :answer-field/choices \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\"] [:db/add \"aec93d34-d853-521e-9b50-c9c26acbc741\" :answer-field/correct \"a51af6db-9344-5ef0-81f9-25a39a63aa6f\"] [:db/ensure \"aec93d34-d853-521e-9b50-c9c26acbc741\" :answer-field/validate] [:db/add \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\" :question/id #uuid \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\"] [:db/add \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{8}} 4 \\\\cos{\\\\left(- 4 x + \\\\frac{\\\\pi}{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\sin{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=1,\\\\quad \\\\sin{\\\\left(0 \\\\right)}=0$.\\n\\n{{answer}}\"] [:db/add \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\" :question/worked-solution \"Let $u=- 4 x + \\\\frac{\\\\pi}{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-4.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=0\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{8}} 4 \\\\cos{\\\\left(- 4 x + \\\\frac{\\\\pi}{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{0} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\sin{\\\\left(u \\\\right)}\\\\right]_{\\\\frac{\\\\pi}{2}}^{0}=\\\\left(0\\\\right)-\\\\left(-1\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n1.\\n$$\"] [:db/add \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\" :question/difficulty :question.difficulty/hard] [:db/add \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\" :question/answer-fields \"aec93d34-d853-521e-9b50-c9c26acbc741\"] [:db/ensure \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"14a4bdf4-8ea4-51a6-81da-5304f43e7279\"] [:db/add \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\" :answer/id #uuid \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\"] [:db/add \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\" :answer/type :answer.type/math] [:db/add \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\" :answer/value \"\\\\frac{1}{2}\"] [:db/ensure \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\" :answer/validate] [:db/add \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\" :answer-field/id #uuid \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\"] [:db/add \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\" :answer-field/key \"answer\"] [:db/add \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\" :answer-field/type :answer-field.type/blank] [:db/add \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\" :answer-field/choices \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\"] [:db/add \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\" :answer-field/correct \"5d59fc83-7aa0-595d-aed1-8be7cb662f5e\"] [:db/ensure \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\" :answer-field/validate] [:db/add \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\" :question/id #uuid \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\"] [:db/add \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{4}} \\\\sin{\\\\left(\\\\pi - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\cos{\\\\left(\\\\pi \\\\right)}=-1,\\\\quad \\\\cos{\\\\left(0 \\\\right)}=1$.\\n\\n{{answer}}\"] [:db/add \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\" :question/worked-solution \"Let $u=\\\\pi - 4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-4.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\pi\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=0\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{4}} \\\\sin{\\\\left(\\\\pi - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int_{\\\\pi}^{0} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[\\\\frac{\\\\cos{\\\\left(u \\\\right)}}{4}\\\\right]_{\\\\pi}^{0}=\\\\left(\\\\frac{1}{4}\\\\right)-\\\\left(- \\\\frac{1}{4}\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\frac{1}{2}.\\n$$\"] [:db/add \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\" :question/difficulty :question.difficulty/hard] [:db/add \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\" :question/answer-fields \"7f4984fe-084f-51a5-bb0d-e7dc322c9849\"] [:db/ensure \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"ee47bd77-b3fc-5c96-b3c1-1120ca3a9273\"] [:db/add \"a8bb3a90-6824-5d37-96be-dd04dbd40003\" :answer/id #uuid \"a8bb3a90-6824-5d37-96be-dd04dbd40003\"] [:db/add \"a8bb3a90-6824-5d37-96be-dd04dbd40003\" :answer/type :answer.type/math] [:db/add \"a8bb3a90-6824-5d37-96be-dd04dbd40003\" :answer/value \"- \\\\sin{\\\\left(1 - 2 x \\\\right)}\"] [:db/ensure \"a8bb3a90-6824-5d37-96be-dd04dbd40003\" :answer/validate] [:db/add \"44f876a5-6b10-5536-9bb9-84048b43931d\" :answer-field/id #uuid \"44f876a5-6b10-5536-9bb9-84048b43931d\"] [:db/add \"44f876a5-6b10-5536-9bb9-84048b43931d\" :answer-field/key \"answer\"] [:db/add \"44f876a5-6b10-5536-9bb9-84048b43931d\" :answer-field/type :answer-field.type/blank] [:db/add \"44f876a5-6b10-5536-9bb9-84048b43931d\" :answer-field/choices \"a8bb3a90-6824-5d37-96be-dd04dbd40003\"] [:db/add \"44f876a5-6b10-5536-9bb9-84048b43931d\" :answer-field/correct \"a8bb3a90-6824-5d37-96be-dd04dbd40003\"] [:db/ensure \"44f876a5-6b10-5536-9bb9-84048b43931d\" :answer-field/validate] [:db/add \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\" :question/id #uuid \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\"] [:db/add \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cos{\\\\left(1 - 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\" :question/worked-solution \"Let $u=1 - 2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cos{\\\\left(1 - 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\sin{\\\\left(1 - 2 x \\\\right)}+C.\\n$$\"] [:db/add \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\" :question/difficulty :question.difficulty/hard] [:db/add \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\" :question/answer-fields \"44f876a5-6b10-5536-9bb9-84048b43931d\"] [:db/ensure \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"e7ec123b-4f1a-58be-a8aa-4b6e169ef8a2\"] [:db/add \"ed235227-92e6-56ef-94ee-f6721a92bb14\" :answer/id #uuid \"ed235227-92e6-56ef-94ee-f6721a92bb14\"] [:db/add \"ed235227-92e6-56ef-94ee-f6721a92bb14\" :answer/type :answer.type/math] [:db/add \"ed235227-92e6-56ef-94ee-f6721a92bb14\" :answer/value \"\\\\frac{\\\\cos{\\\\left(1 - 4 x \\\\right)}}{2}\"] [:db/ensure \"ed235227-92e6-56ef-94ee-f6721a92bb14\" :answer/validate] [:db/add \"1489bae4-46a0-523b-b1c4-f0b373879a4a\" :answer-field/id #uuid \"1489bae4-46a0-523b-b1c4-f0b373879a4a\"] [:db/add \"1489bae4-46a0-523b-b1c4-f0b373879a4a\" :answer-field/key \"answer\"] [:db/add \"1489bae4-46a0-523b-b1c4-f0b373879a4a\" :answer-field/type :answer-field.type/blank] [:db/add \"1489bae4-46a0-523b-b1c4-f0b373879a4a\" :answer-field/choices \"ed235227-92e6-56ef-94ee-f6721a92bb14\"] [:db/add \"1489bae4-46a0-523b-b1c4-f0b373879a4a\" :answer-field/correct \"ed235227-92e6-56ef-94ee-f6721a92bb14\"] [:db/ensure \"1489bae4-46a0-523b-b1c4-f0b373879a4a\" :answer-field/validate] [:db/add \"63ce9196-ff60-526d-af55-9fa94c804e8c\" :question/id #uuid \"63ce9196-ff60-526d-af55-9fa94c804e8c\"] [:db/add \"63ce9196-ff60-526d-af55-9fa94c804e8c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\sin{\\\\left(1 - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"63ce9196-ff60-526d-af55-9fa94c804e8c\" :question/worked-solution \"Let $u=1 - 4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\sin{\\\\left(1 - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\cos{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\cos{\\\\left(1 - 4 x \\\\right)}}{2}+C.\\n$$\"] [:db/add \"63ce9196-ff60-526d-af55-9fa94c804e8c\" :question/difficulty :question.difficulty/hard] [:db/add \"63ce9196-ff60-526d-af55-9fa94c804e8c\" :question/answer-fields \"1489bae4-46a0-523b-b1c4-f0b373879a4a\"] [:db/ensure \"63ce9196-ff60-526d-af55-9fa94c804e8c\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"63ce9196-ff60-526d-af55-9fa94c804e8c\"] [:db/add \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\" :answer/id #uuid \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\"] [:db/add \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\" :answer/type :answer.type/math] [:db/add \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\" :answer/value \"- \\\\frac{1}{3}\"] [:db/ensure \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\" :answer/validate] [:db/add \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\" :answer-field/id #uuid \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\"] [:db/add \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\" :answer-field/key \"answer\"] [:db/add \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\" :answer-field/type :answer-field.type/blank] [:db/add \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\" :answer-field/choices \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\"] [:db/add \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\" :answer-field/correct \"7d0f4e21-6b1a-544d-9189-ecf9b2f0cc03\"] [:db/ensure \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\" :answer-field/validate] [:db/add \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\" :question/id #uuid \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\"] [:db/add \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{6}} \\\\cos{\\\\left(\\\\pi - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\sin{\\\\left(\\\\pi \\\\right)}=0,\\\\quad \\\\sin{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=1$.\\n\\n{{answer}}\"] [:db/add \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\" :question/worked-solution \"Let $u=\\\\pi - 3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\pi\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{6}} \\\\cos{\\\\left(\\\\pi - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{3}\\\\left(\\\\int_{\\\\pi}^{\\\\frac{\\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\frac{\\\\sin{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\pi}^{\\\\frac{\\\\pi}{2}}=\\\\left(- \\\\frac{1}{3}\\\\right)-\\\\left(0\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n- \\\\frac{1}{3}.\\n$$\"] [:db/add \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\" :question/difficulty :question.difficulty/hard] [:db/add \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\" :question/answer-fields \"559a1b3d-66d6-54fa-b0b3-ca7a3aa0bb64\"] [:db/ensure \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\" :question/validate] [:db/add 17592186068915 :knowledge-point/questions \"9891ad60-b02c-519b-bb3b-3ccdc5f192ce\"] [:db/add \"generator\" :question-generator/id #uuid \"9c56de7e-e192-530b-a1e1-58c6654e458d\"] [:db/add \"generator\" :question-generator/script \"generators/8c/8cc7eeae43792095e24c31a069aae8422965d29b422fbb787b8beebee0c7f513/generator.py\"] [:db/add 17592186068915 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186068915 :knowledge-point/validate]] \"assertions\" [[\"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/id #uuid \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\"] [\"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/type :answer.type/math] [\"6c755fac-f0bb-5269-979c-07c4aa6a8b15\" :answer/value \"4\\\\left(\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/id #uuid \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\"] [\"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/type :answer.type/math] [\"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\" :answer/value \"\\\\int_{\\\\frac{3 \\\\pi}{2}}^{\\\\pi} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [\"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/id #uuid \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\"] [\"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/type :answer.type/math] [\"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\" :answer/value \"2\\\\left(\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/id #uuid \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\"] [\"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/type :answer.type/math] [\"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\" :answer/value \"\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{3 \\\\pi}{4}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [\"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/id #uuid \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\"] [\"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/type :answer.type/math] [\"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\" :answer/value \"\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/id #uuid \"0508bed8-6f0c-5744-9d06-ee9974f77066\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/key \"answer\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/type :answer-field.type/radio] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"6c755fac-f0bb-5269-979c-07c4aa6a8b15\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"ed67b1e6-bb5d-5999-98d5-613c2c5849e8\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"12e05b3a-ae3e-5532-aa5e-3bf110c781f6\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"eff62eea-eadd-56a5-bc38-0c50f5ee20f8\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/choices \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\"] [\"0508bed8-6f0c-5744-9d06-ee9974f77066\" :answer-field/correct \"ad9cf26a-eeb8-5ee6-8b56-ffd488817d72\"] [\"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/id #uuid \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\"] [\"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{3 \\\\pi}{4}} 2 \\\\cos{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [\"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\pi\\\\\\\\x=\\\\frac{3 \\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{3 \\\\pi}{4}} 2 \\\\cos{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int_{\\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/difficulty :question.difficulty/easy] [\"fdf6518e-e8a4-59f1-9024-2dc25c55475a\" :question/answer-fields \"0508bed8-6f0c-5744-9d06-ee9974f77066\"] [17592186068915 :knowledge-point/questions \"fdf6518e-e8a4-59f1-9024-2dc25c55475a\"] [\"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/id #uuid \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\"] [\"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/type :answer.type/math] [\"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/id #uuid \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\"] [\"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/type :answer.type/math] [\"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\" :answer/value \"\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\"] [\"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/id #uuid \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\"] [\"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/type :answer.type/math] [\"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\" :answer/value \"3\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"de064156-605e-5acc-9433-8f67797fd421\" :answer/id #uuid \"de064156-605e-5acc-9433-8f67797fd421\"] [\"de064156-605e-5acc-9433-8f67797fd421\" :answer/type :answer.type/math] [\"de064156-605e-5acc-9433-8f67797fd421\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{2 \\\\pi}^{\\\\frac{3 \\\\pi}{2}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/id #uuid \"174e1f57-27ba-5b50-8e1c-98e49800fec6\"] [\"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/type :answer.type/math] [\"174e1f57-27ba-5b50-8e1c-98e49800fec6\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/id #uuid \"ae68e617-0d18-59ff-b276-92bb3877ffb1\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/key \"answer\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/type :answer-field.type/radio] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"7ecfbe3a-e6bb-54c2-bc5a-e26384ccaeb8\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"3b4ee5ed-af33-5a5b-815c-d2c4ac4b12e3\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"de064156-605e-5acc-9433-8f67797fd421\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/choices \"174e1f57-27ba-5b50-8e1c-98e49800fec6\"] [\"ae68e617-0d18-59ff-b276-92bb3877ffb1\" :answer-field/correct \"2d555d93-51bc-5e73-a1f2-f1cf1d9857aa\"] [\"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/id #uuid \"cc8aa811-99e1-5f7b-aa43-885740447191\"] [\"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\"] [\"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{3 \\\\pi}{2}\\\\\\\\x=\\\\frac{2 \\\\pi}{3}&\\\\Longrightarrow u=2 \\\\pi\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{2 \\\\pi}{3}} \\\\sin{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{3 \\\\pi}{2}}^{2 \\\\pi} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/difficulty :question.difficulty/easy] [\"cc8aa811-99e1-5f7b-aa43-885740447191\" :question/answer-fields \"ae68e617-0d18-59ff-b276-92bb3877ffb1\"] [17592186068915 :knowledge-point/questions \"cc8aa811-99e1-5f7b-aa43-8857