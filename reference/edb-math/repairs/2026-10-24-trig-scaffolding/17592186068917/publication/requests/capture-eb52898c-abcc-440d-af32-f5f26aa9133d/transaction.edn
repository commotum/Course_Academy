-5fb6-9b86-74641c6f0660" :answer-field/correct "56e15bb6-b6d0-5170-b17c-c7ec6bfda498"] [:db/ensure "21244045-a0ed-5fb6-9b86-74641c6f0660" :answer-field/validate] [:db/add "e9365dbd-fe00-591b-8075-15e95aedd5c3" :question/id #uuid "e9365dbd-fe00-591b-8075-15e95aedd5c3"] [:db/add "e9365dbd-fe00-591b-8075-15e95aedd5c3" :question/problem "Use the substitution $u=x^{2}$. Which integral is obtained?\n\n$$\n\\int 3 x \\sec^{2}{\\left(x^{2} \\right)}\\,\\mathrm{d}x\n$$"] [:db/add "e9365dbd-fe00-591b-8075-15e95aedd5c3" :question/worked-solution "Let $u=x^{2}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2 x.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 x \\sec^{2}{\\left(x^{2} \\right)}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{2}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "e9365dbd-fe00-591b-8075-15e95aedd5c3" :question/difficulty :question.difficulty/easy] [:db/add "e9365dbd-fe00-591b-8075-15e95aedd5c3" :question/answer-fields "21244045-a0ed-5fb6-9b86-74641c6f0660"] [:db/ensure "e9365dbd-fe00-591b-8075-15e95aedd5c3" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "e9365dbd-fe00-591b-8075-15e95aedd5c3"] [:db/add "6d87ae77-06b9-5d22-994c-0dd36d086d92" :answer/id #uuid "6d87ae77-06b9-5d22-994c-0dd36d086d92"] [:db/add "6d87ae77-06b9-5d22-994c-0dd36d086d92" :answer/type :answer.type/math] [:db/add "6d87ae77-06b9-5d22-994c-0dd36d086d92" :answer/value "- \\frac{3 \\csc{\\left(x^{2} + 2 \\right)}}{2}"] [:db/ensure "6d87ae77-06b9-5d22-994c-0dd36d086d92" :answer/validate] [:db/add "b21ed25c-933f-522c-a404-61fadc00d605" :answer-field/id #uuid "b21ed25c-933f-522c-a404-61fadc00d605"] [:db/add "b21ed25c-933f-522c-a404-61fadc00d605" :answer-field/key "answer"] [:db/add "b21ed25c-933f-522c-a404-61fadc00d605" :answer-field/type :answer-field.type/blank] [:db/add "b21ed25c-933f-522c-a404-61fadc00d605" :answer-field/choices "6d87ae77-06b9-5d22-994c-0dd36d086d92"] [:db/add "b21ed25c-933f-522c-a404-61fadc00d605" :answer-field/correct "6d87ae77-06b9-5d22-994c-0dd36d086d92"] [:db/ensure "b21ed25c-933f-522c-a404-61fadc00d605" :answer-field/validate] [:db/add "a4406e92-3fdf-528c-bc71-97d93112204f" :question/id #uuid "a4406e92-3fdf-528c-bc71-97d93112204f"] [:db/add "a4406e92-3fdf-528c-bc71-97d93112204f" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 x \\cot{\\left(x^{2} + 2 \\right)} \\csc{\\left(x^{2} + 2 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u=- \\csc{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "a4406e92-3fdf-528c-bc71-97d93112204f" :question/worked-solution "Let $u=x^{2} + 2$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2 x.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 x \\cot{\\left(x^{2} + 2 \\right)} \\csc{\\left(x^{2} + 2 \\right)}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{3}{2}\\left(\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- \\frac{3 \\csc{\\left(u \\right)}}{2}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{3 \\csc{\\left(x^{2} + 2 \\right)}}{2}+C.\n$$"] [:db/add "a4406e92-3fdf-528c-bc71-97d93112204f" :question/difficulty :question.difficulty/moderate] [:db/add "a4406e92-3fdf-528c-bc71-97d93112204f" :question/answer-fields "b21ed25c-933f-522c-a404-61fadc00d605"] [:db/ensure "a4406e92-3fdf-528c-bc71-97d93112204f" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "a4406e92-3fdf-528c-bc71-97d93112204f"] [:db/add "eb3b0d2f-07ca-580d-9045-492a80e9b799" :answer/id #uuid "eb3b0d2f-07ca-580d-9045-492a80e9b799"] [:db/add "eb3b0d2f-07ca-580d-9045-492a80e9b799" :answer/type :answer.type/math] [:db/add "eb3b0d2f-07ca-580d-9045-492a80e9b799" :answer/value "- \\cos{\\left(x^{2} + 1 \\right)}"] [:db/ensure "eb3b0d2f-07ca-580d-9045-492a80e9b799" :answer/validate] [:db/add "03634545-7861-50d0-8f73-b4884120585a" :answer-field/id #uuid "03634545-7861-50d0-8f73-b4884120585a"] [:db/add "03634545-7861-50d0-8f73-b4884120585a" :answer-field/key "answer"] [:db/add "03634545-7861-50d0-8f73-b4884120585a" :answer-field/type :answer-field.type/blank] [:db/add "03634545-7861-50d0-8f73-b4884120585a" :answer-field/choices "eb3b0d2f-07ca-580d-9045-492a80e9b799"] [:db/add "03634545-7861-50d0-8f73-b4884120585a" :answer-field/correct "eb3b0d2f-07ca-580d-9045-492a80e9b799"] [:db/ensure "03634545-7861-50d0-8f73-b4884120585a" :answer-field/validate] [:db/add "69206d9d-63cd-5bb9-847c-bd4494453b87" :question/id #uuid "69206d9d-63cd-5bb9-847c-bd4494453b87"] [:db/add "69206d9d-63cd-5bb9-847c-bd4494453b87" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 x \\sin{\\left(x^{2} + 1 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "69206d9d-63cd-5bb9-847c-bd4494453b87" :question/worked-solution "Let $u=x^{2} + 1$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2 x.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 x \\sin{\\left(x^{2} + 1 \\right)}\\,\\mathrm{d}x\\\\&=\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\cos{\\left(x^{2} + 1 \\right)}+C.\n$$"] [:db/add "69206d9d-63cd-5bb9-847c-bd4494453b87" :question/difficulty :question.difficulty/moderate] [:db/add "69206d9d-63cd-5bb9-847c-bd4494453b87" :question/answer-fields "03634545-7861-50d0-8f73-b4884120585a"] [:db/ensure "69206d9d-63cd-5bb9-847c-bd4494453b87" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "69206d9d-63cd-5bb9-847c-bd4494453b87"] [:db/add "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f" :answer/id #uuid "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f"] [:db/add "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f" :answer/type :answer.type/math] [:db/add "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f" :answer/value "\\frac{2 \\sin{\\left(x^{3} \\right)}}{3}"] [:db/ensure "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f" :answer/validate] [:db/add "d8dd693c-bde5-5617-95da-76870682e40b" :answer-field/id #uuid "d8dd693c-bde5-5617-95da-76870682e40b"] [:db/add "d8dd693c-bde5-5617-95da-76870682e40b" :answer-field/key "answer"] [:db/add "d8dd693c-bde5-5617-95da-76870682e40b" :answer-field/type :answer-field.type/blank] [:db/add "d8dd693c-bde5-5617-95da-76870682e40b" :answer-field/choices "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f"] [:db/add "d8dd693c-bde5-5617-95da-76870682e40b" :answer-field/correct "62b9aad0-72b5-5996-bbcf-d9dadcd7a37f"] [:db/ensure "d8dd693c-bde5-5617-95da-76870682e40b" :answer-field/validate] [:db/add "76260971-dee8-535d-abad-25a054e5f811" :question/id #uuid "76260971-dee8-535d-abad-25a054e5f811"] [:db/add "76260971-dee8-535d-abad-25a054e5f811" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 x^{2} \\cos{\\left(x^{3} \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "76260971-dee8-535d-abad-25a054e5f811" :question/worked-solution "Let $u=x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3 x^{2}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 x^{2} \\cos{\\left(x^{3} \\right)}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{2}{3}\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{2 \\sin{\\left(u \\right)}}{3}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2 \\sin{\\left(x^{3} \\right)}}{3}+C.\n$$"] [:db/add "76260971-dee8-535d-abad-25a054e5f811" :question/difficulty :question.difficulty/moderate] [:db/add "76260971-dee8-535d-abad-25a054e5f811" :question/answer-fields "d8dd693c-bde5-5617-95da-76870682e40b"] [:db/ensure "76260971-dee8-535d-abad-25a054e5f811" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "76260971-dee8-535d-abad-25a054e5f811"] [:db/add "5cc8d3fc-1c12-528e-a342-81964a4d8e78" :answer/id #uuid "5cc8d3fc-1c12-528e-a342-81964a4d8e78"] [:db/add "5cc8d3fc-1c12-528e-a342-81964a4d8e78" :answer/type :answer.type/math] [:db/add "5cc8d3fc-1c12-528e-a342-81964a4d8e78" :answer/value "\\frac{\\tan{\\left(x^{3} + 1 \\right)}}{3}"] [:db/ensure "5cc8d3fc-1c12-528e-a342-81964a4d8e78" :answer/validate] [:db/add "0358b406-7288-515a-bd51-fe60af4c25a1" :answer-field/id #uuid "0358b406-7288-515a-bd51-fe60af4c25a1"] [:db/add "0358b406-7288-515a-bd51-fe60af4c25a1" :answer-field/key "answer"] [:db/add "0358b406-7288-515a-bd51-fe60af4c25a1" :answer-field/type :answer-field.type/blank] [:db/add "0358b406-7288-515a-bd51-fe60af4c25a1" :answer-field/choices "5cc8d3fc-1c12-528e-a342-81964a4d8e78"] [:db/add "0358b406-7288-515a-bd51-fe60af4c25a1" :answer-field/correct "5cc8d3fc-1c12-528e-a342-81964a4d8e78"] [:db/ensure "0358b406-7288-515a-bd51-fe60af4c25a1" :answer-field/validate] [:db/add "220ecb78-b0f1-5890-93be-f37a58cc6781" :question/id #uuid "220ecb78-b0f1-5890-93be-f37a58cc6781"] [:db/add "220ecb78-b0f1-5890-93be-f37a58cc6781" :question/problem "Find an antiderivative.\n\n$$\n\\int x^{2} \\sec^{2}{\\left(x^{3} + 1 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u=\\tan{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "220ecb78-b0f1-5890-93be-f37a58cc6781" :question/worked-solution "Let $u=x^{3} + 1$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3 x^{2}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int x^{2} \\sec^{2}{\\left(x^{3} + 1 \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{1}{3}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{\\tan{\\left(u \\right)}}{3}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\tan{\\left(x^{3} + 1 \\right)}}{3}+C.\n$$"] [:db/add "220ecb78-b0f1-5890-93be-f37a58cc6781" :question/difficulty :question.difficulty/moderate] [:db/add "220ecb78-b0f1-5890-93be-f37a58cc6781" :question/answer-fields "0358b406-7288-515a-bd51-fe60af4c25a1"] [:db/ensure "220ecb78-b0f1-5890-93be-f37a58cc6781" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "220ecb78-b0f1-5890-93be-f37a58cc6781"] [:db/add "a5c877b4-db6b-5042-9f8f-62cde24c9fcd" :answer/id #uuid "a5c877b4-db6b-5042-9f8f-62cde24c9fcd"] [:db/add "a5c877b4-db6b-5042-9f8f-62cde24c9fcd" :answer/type :answer.type/math] [:db/add "a5c877b4-db6b-5042-9f8f-62cde24c9fcd" :answer/value "\\frac{\\sec{\\left(x^{3} + 2 \\right)}}{3}"] [:db/ensure "a5c877b4-db6b-5042-9f8f-62cde24c9fcd" :answer/validate] [:db/add "432e7c05-7724-598e-814b-fb2c94effcd6" :answer-field/id #uuid "432e7c05-7724-598e-814b-fb2c94effcd6"] [:db/add "432e7c05-7724-598e-814b-fb2c94effcd6" :answer-field/key "answer"] [:db/add "432e7c05-7724-598e-814b-fb2c94effcd6" :answer-field/type :answer-field.type/blank] [:db/add "432e7c05-7724-598e-814b-fb2c94effcd6" :answer-field/choices "a5c877b4-db6b-5042-9f8f-62cde24c9fcd"] [:db/add "432e7c05-7724-598e-814b-fb2c94effcd6" :answer-field/correct "a5c877b4-db6b-5042-9f8f-62cde24c9fcd"] [:db/ensure "432e7c05-7724-598e-814b-fb2c94effcd6" :answer-field/validate] [:db/add "9566aff7-b976-5c0a-85c3-d7d41083e7b1" :question/id #uuid "9566aff7-b976-5c0a-85c3-d7d41083e7b1"] [:db/add "9566aff7-b976-5c0a-85c3-d7d41083e7b1" :question/problem "Find an antiderivative.\n\n$$\n\\int x^{2} \\tan{\\left(x^{3} + 2 \\right)} \\sec{\\left(x^{3} + 2 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\tan{\\left(u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u=\\sec{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "9566aff7-b976-5c0a-85c3-d7d41083e7b1" :question/worked-solution "Let $u=x^{3} + 2$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3 x^{2}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int x^{2} \\tan{\\left(x^{3} + 2 \\right)} \\sec{\\left(x^{3} + 2 \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\tan{\\left(u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{1}{3}\\left(\\int \\tan{\\left(u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{\\sec{\\left(u \\right)}}{3}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\sec{\\left(x^{3} + 2 \\right)}}{3}+C.\n$$"] [:db/add "9566aff7-b976-5c0a-85c3-d7d41083e7b1" :question/difficulty :question.difficulty/moderate] [:db/add "9566aff7-b976-5c0a-85c3-d7d41083e7b1" :question/answer-fields "432e7c05-7724-598e-814b-fb2c94effcd6"] [:db/ensure "9566aff7-b976-5c0a-85c3-d7d41083e7b1" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "9566aff7-b976-5c0a-85c3-d7d41083e7b1"] [:db/add "affbea99-8e67-5f38-9d01-129ad9570237" :answer/id #uuid "affbea99-8e67-5f38-9d01-129ad9570237"] [:db/add "affbea99-8e67-5f38-9d01-129ad9570237" :answer/type :answer.type/math] [:db/add "affbea99-8e67-5f38-9d01-129ad9570237" :answer/value "- \\frac{3 \\cot{\\left(x^{2} \\right)}}{2}"] [:db/ensure "affbea99-8e67-5f38-9d01-129ad9570237" :answer/validate] [:db/add "f324306a-1dd2-58ca-a8a7-d152b4f27a63" :answer-field/id #uuid "f324306a-1dd2-58ca-a8a7-d152b4f27a63"] [:db/add "f324306a-1dd2-58ca-a8a7-d152b4f27a63" :answer-field/key "answer"] [:db/add "f324306a-1dd2-58ca-a8a7-d152b4f27a63" :answer-field/type :answer-field.type/blank] [:db/add "f324306a-1dd2-58ca-a8a7-d152b4f27a63" :answer-field/choices "affbea99-8e67-5f38-9d01-129ad9570237"] [:db/add "f324306a-1dd2-58ca-a8a7-d152b4f27a63" :answer-field/correct "affbea99-8e67-5f38-9d01-129ad9570237"] [:db/ensure "f324306a-1dd2-58ca-a8a7-d152b4f27a63" :ans