u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- 3 \\sec{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- 3 \\sec{\\left(\\frac{1}{x + 1} \\right)}+C.\n$$"] [:db/add "b24398ca-99b9-5a39-a042-a9b6d791af93" :question/difficulty :question.difficulty/hard] [:db/add "b24398ca-99b9-5a39-a042-a9b6d791af93" :question/answer-fields "eb33753b-15c2-5041-9331-0cf5c84e60bc"] [:db/ensure "b24398ca-99b9-5a39-a042-a9b6d791af93" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "b24398ca-99b9-5a39-a042-a9b6d791af93"] [:db/add "796b20c7-6752-54be-9ba7-0e02d42d6849" :answer/id #uuid "796b20c7-6752-54be-9ba7-0e02d42d6849"] [:db/add "796b20c7-6752-54be-9ba7-0e02d42d6849" :answer/type :answer.type/math] [:db/add "796b20c7-6752-54be-9ba7-0e02d42d6849" :answer/value "- 2 \\sin{\\left(\\frac{1}{x} \\right)}"] [:db/ensure "796b20c7-6752-54be-9ba7-0e02d42d6849" :answer/validate] [:db/add "5f5b81ad-c73c-5093-8f9f-232ea653d45b" :answer-field/id #uuid "5f5b81ad-c73c-5093-8f9f-232ea653d45b"] [:db/add "5f5b81ad-c73c-5093-8f9f-232ea653d45b" :answer-field/key "answer"] [:db/add "5f5b81ad-c73c-5093-8f9f-232ea653d45b" :answer-field/type :answer-field.type/blank] [:db/add "5f5b81ad-c73c-5093-8f9f-232ea653d45b" :answer-field/choices "796b20c7-6752-54be-9ba7-0e02d42d6849"] [:db/add "5f5b81ad-c73c-5093-8f9f-232ea653d45b" :answer-field/correct "796b20c7-6752-54be-9ba7-0e02d42d6849"] [:db/ensure "5f5b81ad-c73c-5093-8f9f-232ea653d45b" :answer-field/validate] [:db/add "905bff24-82d3-5866-9044-a52ed8f0e8c4" :question/id #uuid "905bff24-82d3-5866-9044-a52ed8f0e8c4"] [:db/add "905bff24-82d3-5866-9044-a52ed8f0e8c4" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 \\cos{\\left(\\frac{1}{x} \\right)}}{x^{2}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"] [:db/add "905bff24-82d3-5866-9044-a52ed8f0e8c4" :question/worked-solution "Let $u=\\frac{1}{x}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{1}{x^{2}}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 \\cos{\\left(\\frac{1}{x} \\right)}}{x^{2}}\\,\\mathrm{d}x\\\\&=-2\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-2\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- 2 \\sin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- 2 \\sin{\\left(\\frac{1}{x} \\right)}+C.\n$$"] [:db/add "905bff24-82d3-5866-9044-a52ed8f0e8c4" :question/difficulty :question.difficulty/hard] [:db/add "905bff24-82d3-5866-9044-a52ed8f0e8c4" :question/answer-fields "5f5b81ad-c73c-5093-8f9f-232ea653d45b"] [:db/ensure "905bff24-82d3-5866-9044-a52ed8f0e8c4" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "905bff24-82d3-5866-9044-a52ed8f0e8c4"] [:db/add "5684b7df-c65b-5b00-93eb-8d6a2d066b08" :answer/id #uuid "5684b7df-c65b-5b00-93eb-8d6a2d066b08"] [:db/add "5684b7df-c65b-5b00-93eb-8d6a2d066b08" :answer/type :answer.type/math] [:db/add "5684b7df-c65b-5b00-93eb-8d6a2d066b08" :answer/value "6 \\sin{\\left(\\sqrt{x} \\right)}"] [:db/ensure "5684b7df-c65b-5b00-93eb-8d6a2d066b08" :answer/validate] [:db/add "a25fa674-6064-581d-a907-718018b34efa" :answer-field/id #uuid "a25fa674-6064-581d-a907-718018b34efa"] [:db/add "a25fa674-6064-581d-a907-718018b34efa" :answer-field/key "answer"] [:db/add "a25fa674-6064-581d-a907-718018b34efa" :answer-field/type :answer-field.type/blank] [:db/add "a25fa674-6064-581d-a907-718018b34efa" :answer-field/choices "5684b7df-c65b-5b00-93eb-8d6a2d066b08"] [:db/add "a25fa674-6064-581d-a907-718018b34efa" :answer-field/correct "5684b7df-c65b-5b00-93eb-8d6a2d066b08"] [:db/ensure "a25fa674-6064-581d-a907-718018b34efa" :answer-field/validate] [:db/add "4d30c709-e683-5166-a055-8d0acee315c9" :question/id #uuid "4d30c709-e683-5166-a055-8d0acee315c9"] [:db/add "4d30c709-e683-5166-a055-8d0acee315c9" :question/problem "Find an antiderivative.\n\n$$\n\\int \\f