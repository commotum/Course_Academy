17592186267896}] :answer-field/correct {:answer/id #uuid "c412de53-dcb8-561f-b75c-83b12fa53e7d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{cot}⁡({x}^{2})+C" :db/id #edb/ref 17592186267896} :answer-field/id #uuid "6edf94d4-6780-5605-a47c-83b77d601c42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9cb5aaff-6467-5367-a002-45fca048bd67" :question/math-academy-id "q-13464" :question/problem "Calculate $$\n\\displaystyle \\int x{csc}^{2}⁡({x}^{2})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int x{csc}^{2}⁡({x}^{2})\\,\\text{d}x & =\\int {csc}^{2}⁡({x}^{2})\\cdot x\\,\\text{d}x \\\\  & =\\int {csc}^{2}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {csc}^{2}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{cot}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{cot}⁡({x}^{2})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bba42d0-4d22-55d1-bf2a-5afa7f154545" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266532} {:answer/id #uuid "6f0dba1e-ebd9-58df-9ff0-a39f534c6156" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267118} {:answer/id #uuid "9a78f2b9-be60-5dd9-a1b2-d3dae91c37e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186267540} {:answer/id #uuid "a54496d0-737c-5f0e-b323-1106d3723e9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186267634} {:answer/id #uuid "da3d8464-42f7-59e9-bbc9-