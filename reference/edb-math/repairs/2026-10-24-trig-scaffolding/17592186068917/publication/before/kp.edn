ref 17592186267318} {:answer/id #uuid "8a690975-9629-524f-8754-019e655cbcf7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267378} {:answer/id #uuid "b4e7245c-ae8f-576f-ad7b-ae3e6def801c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186267761} {:answer/id #uuid "c5d49c16-cf0d-5d32-ac21-f912a3f35a4f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267918}] :answer-field/correct {:answer/id #uuid "c5d49c16-cf0d-5d32-ac21-f912a3f35a4f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267918} :answer-field/id #uuid "d8a52cc8-a59a-5790-8e07-7483e8b8eee9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268791}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f9af6a27-d8cc-5d10-84b4-1e204dd24944" :question/math-academy-id "q-13537" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\pi }}3x\\operatorname{sin}⁡(2{x}^{2})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=2{x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\text{d}u=x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi }$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\pi $ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi }}3x\\operatorname{sin}⁡(2{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi }}3\\operatorname{sin}⁡(2{x}^{2})\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }3\\operatorname{sin}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{3}{4}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{3}{4}\\operatorname{cos}⁡u{|}_{0}^{2\\pi } \\\\  & =-\\frac{3}{4}(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{3}{4}(1-1) \\\\  & =-\\frac{3}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4675341d-47de-58d1-9169-e4ea300f6534" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡\\left(\\frac{1}{x}\\right)+C" :db/id #edb/ref 17592186295666} {:answer/id #uuid "49060b70-8ca0-5560-a25f-c33fdf13abe5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\left(\\frac{1}{x}\\right)+C" :db/id #edb/ref 17592186295684} {:answer/id #uuid "73e82961-671e-5f43-927c-85b68cebb79e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡\\left(\\frac{1}{x}\\right)+C" :db/id #edb/ref 17592186295902} {:answer/id #uuid "8cc5e39c-b266-5cff-bbd7-b9a7c961e739" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡\\left(\\frac{1}{x}\\right)+C" :db/id #edb/ref 17592186296018} {:answer/id #uuid "902705ff-4eac-5fc0-8d8a-b9ebd4cdfeff" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡\\left(\\frac{1}{x}\\right)+C" :db/id #edb/ref 17592186296039}] :answer-field/correct {:answer/id #uuid "4675341d-47de-58d1-9169-e4ea300f6534" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡\\left(\\frac{1}{x}\\right)+C" :db/id #edb/ref 17592186295666} :answer-field/id #uuid "4c5828d6-8af8-5472-82db-0c5fb62611d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296780}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7ade3ef7-2470-5279-802e-68d9ba79206f" :question/math-academy-id "q-3038" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=\\frac{1}{x}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{{x}^{2}}\\,⟹\\,-\\text{d}u=\\frac{1}{{x}^{2}}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\,\\text{d}x & =\\int {sec}^{2}⁡\\left(\\frac{1}{x}\\right)\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡u\\cdot (-\\text{d}u) \\\\  & =-\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =-\\operatorname{tan}⁡u+C \\\\  & =-\\operatorname{tan}⁡\\left(\\frac{1}{x}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8483f978-0eb7-58b8-8af7-e33b9170b809" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318016}] :answer-field/correct {:answer/id #uuid "8483f978-0eb7-58b8-8af7-e33b9170b809" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318016} :answer-field/id #uuid "072ef757-3ef7-5291-a2b9-f78bdb72dd2b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318442}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b2f52a91-e2df-5743-9b16-3551c628a81b" :question/math-academy-id "q-350202" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\pi /12}}8xsec\\,(4{x}^{2})tan\\,(4{x}^{2})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=4{x}^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8x\\,⟹\\,\\text{d}u=8x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi /12}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi /3$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi /12}}8xsec\\,(4{x}^{2})tan\\,(4{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi /12}}sec\\,(4{x}^{2})tan\\,(4{x}^{2})\\cdot 8x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{sec}⁡(u)\\operatorname{tan}⁡(u)\\,\\text{d}u \\\\  & =\\operatorname{sec}⁡(u)\\,{|}_{0}^{\\pi /3} \\\\  & =\\operatorname{sec}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{sec}⁡(0) \\\\  & =2-1 \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a0832f3-44e5-55dc-b0d6-cde9d7754977" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317931}] :answer-field/correct {:answer/id #uuid "6a0832f3-44e5-55dc-b0d6-cde9d7754977" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317931} :answer-field/id #uuid "81013bc8-e699-5fa8-92f3-108172fec02c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318703}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4977c738-ef65-5d72-9699-ec8683cb5818" :question/math-academy-id "q-350203" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\sqrt{\\pi /12}}^{\\sqrt{\\pi /6}}12x\\operatorname{cos}⁡(6{x}^{2})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=6{x}^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=12x\\,⟹\\,\\text{d}u=12x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\sqrt{\\pi /12}$ | $\\sqrt{\\pi /6}$ |\n| --- | --- | --- |\n| $u$ | $\\pi /2$ | $\\pi $ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{\\pi /12}}^{\\sqrt{\\pi /6}}12x\\operatorname{cos}⁡(6{x}^{2})\\,\\text{d}x & ={\\int }_{\\sqrt{\\pi /12}}^{\\sqrt{\\pi /6}}\\operatorname{cos}⁡(6{x}^{2})\\cdot 12x\\,\\text{d}x \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡(u)\\,\\text{d}u \\\\  & =\\operatorname{sin}⁡(u)\\,{|}_{\\pi /2}^{\\pi } \\\\  & =\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =0-1 \\\\  & =-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67db1928-5d77-5d01-9982-b91efb720baf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cot{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486547} {:answer/id #uuid "80b3b820-877a-56c3-86d8-db243bd28b5d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\csc{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486551} {:answer/id #uuid "8414f7a2-369f-5120-b9a8-467cd2cbffd3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\cot{\\left(x^{2} \\right)}}{2}+C" :db/id #edb/ref 17592186486553} {:answer/id #uuid "8dcad831-351c-5fb6-8252-0ad06ca0e301" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cot{\\left(x^{2} \\right)}}{2}+C" :db/id #edb/ref 17592186486554} {:answer/id #uuid "d2010a1d-48cd-5e3a-8bb6-9f30dbdd2492" :answer/type {:db/ident :answer.type/math} :answer/value "\\cot{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486561}] :answer-field/correct {:answer/id #uuid "67db1928-5d77-5d01-9982-b91efb720baf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cot{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486547} :answer-field/id #uuid "240f4141-c6e4-573e-9f31-860c6fa6e3b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486545}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "002482ff-69a9-5b63-b3f0-5cd70a51819a" :question/problem "Calculate $$\n\\displaystyle \\int 2 x \\csc^{2}{\\left(x^{2} \\right)}\\,\\text{d}x.\n$$" :question/retired true :question/worked-solution "Let $u=x^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2 x \\csc^{2}{\\left(x^{2} \\right)}\\,\\text{d}x &= 1\\int \\csc^{2}{\\left(u \\right)}\\,\\text{d}u \\\\ &= - \\cot{\\left(u \\right)}+C \\\\ &= - \\cot{\\left(x^{2} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2b14aa-939d-5f78-95d5-a8ac2d5a46b9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486543} {:answer/id #uuid "1202f884-82b1-540e-bfd1-0ee80ba2c514" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486544} {:answer/id #uuid "b9b4275b-87e1-5689-822b-8dac3c858579" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486558} {:answer/id #uuid "cb6699db-b1f0-5226-8168-b9ec448eac86" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486560} {:answer/id #uuid "fcef9471-29d4-56f5-9a65-4b6c75538bcf" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486562}] :answer-field/correct {:answer/id #uuid "0b2b14aa-939d-5f78-95d5-a8ac2d5a46b9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486543} :answer-field/id #uuid "79c1360c-2029-597a-92dc-abe7f1cbfea3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486550}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "82583355-6299-599e-bdc6-d65fa8aebd0a" :question/problem "Calculate $$\n\\displaystyle \\int 2 x \\sin{\\left(x^{2} \\right)}\\,\\text{d}x.\n$$" :question/retired true :question/worked-solution "Let $u=x^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2 x \\sin{\\left(x^{2} \\right)}\\,\\text{d}x &= 1\\int \\sin{\\left(u \\right)}\\,\\text{d}u \\\\ &= - \\cos{\\left(u \\right)}+C \\\\ &= - \\cos{\\left(x^{2} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28b0a88b-6033-5a60-beab-0cbad3f7fed3" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\tan{\\left(x^{3} \\right)}+C" :db/id #edb/ref 17592186486546} {:answer/id #uuid "6f9bacea-3262-508b-9719-4fd80bf9d534" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\sec{\\left(x^{3} \\right)}}{3}+C" :db/id #edb/ref 17592186486548} {:answer/id #uuid "79463279-bba4-5ce7-b66d-91ca6c29fee1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\tan{\\left(x^{3} \\right)}}{3}+C" :db/id #edb/ref 17592186486549} {:answer/id #uuid "b44d88f2-1b54-541f-aa56-dae6e3f577f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\tan{\\left(x^{3} \\right)}}{2}+C" :db/id #edb/ref 17592186486556} {:answer/id #uuid "c04acc4c-98a0-5857-8fdc-cdb07ac37366" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\tan{\\left(x^{3} \\right)}+C" :db/id #edb/ref 17592186486559}] :answer-field/correct {:answer/id #uuid "79463279-bba4-5ce7-b66d-91ca6c29fee1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\tan{\\left(x^{3} \\right)}}{3}+C" :db/id #edb/ref 17592186486549} :answer-field/id #uuid "b59d98d5-6b64-56b9-afca-bffec0e1eaf3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486557}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9f181c0b-4ade-5cfb-806e-89c254367d4c" :question/problem "$$\n\\displaystyle \\int 8 x^{2} \\sec^{2}{\\left(x^{3} \\right)}\\,\\text{d}x=\n$$" :question/retired true :question/worked-solution "Let $u=x^{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3 x^{2}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 8 x^{2} \\sec^{2}{\\left(x^{3} \\right)}\\,\\text{d}x &= \\frac{8}{3}\\int \\sec^{2}{\\left(u \\right)}\\,\\text{d}u \\\\ &= \\frac{8 \\tan{\\left(u \\right)}}{3}+C \\\\ &= \\frac{8 \\tan{\\left(x^{3} \\right)}}{3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1536851e-467a-513f-a39f-a987ce9f476f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{sec}⁡({x}^{3})+C" :db/id #edb/ref 17592186580419} {:answer/id #uuid "419eae3a-7c99-539d-9f8c-43bd5d3ee2ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186580497} {:answer/id #uuid "57682a10-50f1-57c4-b856-6b7dcb623188" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡({x}^{3})+C" :db/id #edb/ref 17592186580531} {:answer/id #uuid "fb615c57-9a5f-515f-9538-4b290aa37b2d" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sec}⁡({x}^{3})+C" :db/id #edb/ref 17592186580784} {:answer/id #uuid "fd9a6454-9002-50d7-81dc-56d4699c4393" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186580788}] :answer-field/correct {:answer/id #uuid "1536851e-467a-513f-a39f-a987ce9f476f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{sec}⁡({x}^{3})+C" :db/id #edb/ref 17592186580419} :answer-field/id #uuid "ed6dccc4-202e-5529-b8af-ac630177fe14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "038974cd-ae48-5200-9bdc-eb592bd2ef40" :question/math-academy-id "q-13467" :question/problem "Calculate the integral $$\n\\displaystyle \\int {x}^{2}\\operatorname{sec}⁡({x}^{3})\\operatorname{tan}⁡({x}^{3})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{3}$, Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{sec}⁡({x}^{3})\\operatorname{tan}⁡({x}^{3})\\,\\text{d}x & =\\int \\operatorname{sec}⁡({x}^{3})\\operatorname{tan}⁡({x}^{3})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{sec}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{sec}⁡({x}^{3})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4cd558-9e46-545e-9b83-95b0ce86e4f9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{csc}⁡({x}^{3})+C" :db/id #edb/ref 17592186580405} {:answer/id #uuid "1a0cd29b-2281-5fdf-b83a-3d81905f346b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{cot}⁡({x}^{3})+C" :db/id #edb/ref 17592186580425} {:answer/id #uuid "2ff41e67-12fd-5ad3-95e3-b11f2dafd8a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡({x}^{3})+C" :db/id #edb/ref 17592186580466} {:answer/id #uuid "3ae7711a-aefc-5cb7-b38b-ebf016041585" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡({x}^{3})+C" :db/id #edb/ref 17592186580486} {:answer/id #uuid "a1cd5e71-b7f5-5663-936f-68abc2dbf93c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{csc}⁡({x}^{3})+C" :db/id #edb/ref 17592186580658}] :answer-field/correct {:answer/id #uuid "2ff41e67-12fd-5ad3-95e3-b11f2dafd8a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡({x}^{3})+C" :db/id #edb/ref 17592186580466} :answer-field/id #uuid "c8e9515f-e4f9-5256-98c2-11c0b1c56ec8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580864}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "185fc978-acea-5e9e-aec8-3d21ff92c62e" :question/math-academy-id "q-13470" :question/problem "Calculate the integral $$\n\\displaystyle \\int 3{x}^{2}\\operatorname{csc}⁡({x}^{3})\\operatorname{cot}⁡({x}^{3})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{3}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\text{d}u=3{x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{csc}⁡({x}^{3})\\operatorname{cot}⁡({x}^{3})\\,\\text{d}x & =\\int \\operatorname{csc}⁡({x}^{3})\\operatorname{cot}⁡({x}^{3})\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\operatorname{csc}⁡u+C \\\\  & =-\\operatorname{csc}⁡({x}^{3})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "399980b9-86fd-5875-909a-55ccdeec0bc9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186580483}] :answer-field/correct {:answer/id #uuid "399980b9-86fd-5875-909a-55ccdeec0bc9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186580483} :answer-field/id #uuid "2147e959-626e-5c5e-a384-3e369b129c13" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186580807}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "95f61cbe-50e0-52a1-9899-3308592615d8" :question/math-academy-id "q-350186" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\pi /4}}8x\\operatorname{cos}⁡(4{x}^{2})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=4{x}^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8x\\,⟹\\,\\text{d}u=8x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi /4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi /4}}8x\\operatorname{cos}⁡(4{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi /4}}\\operatorname{cos}⁡(4{x}^{2})\\cdot 8x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{cos}⁡(u)\\,\\text{d}u \\\\  & =\\operatorname{sin}⁡(u)\\,{|}_{0}^{\\pi } \\\\  & =\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0) \\\\  & =0-0 \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143b0cf4-599c-56a0-9697-0fd3b6ad7b6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡({x}^{3})+C" :db/id #edb/ref 17592186580415} {:answer/id #uuid "2da5f0d2-90ae-5eae-81fe-3ad54334ae4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{sin}⁡({x}^{3})+C" :db/id #edb/ref 17592186580460} {:answer/id #uuid "a609fb08-4df5-5f2f-b07c-716c4b0fa8c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{sin}⁡({x}^{3})+C" :db/id #edb/ref 17592186580666} {:answer/id #uuid "c625891a-9893-5be4-8d26-dd89a0f3f09e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{sin}⁡(3{x}^{2})+C" :db/id #edb/ref 17592186580696} {:answer/id #uuid "f6631fd8-eb98-5921-a11b-8cab13d33385" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{sin}⁡({x}^{2})+C" :db/id #edb/ref 17592186580776}] :answer-field/correct {:answer/id #uuid "2da5f0d2-90ae-5eae-81fe-3ad54334ae4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{sin}⁡({x}^{3})+C" :db/id #edb/ref 17592186580460} :answer-field/id #uuid "8cd33e1c-d19d-5110-b549-226f09fdc6db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580844}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c8478693-7123-504b-ab62-3a7e2bce3f4a" :question/math-academy-id "q-13471" :question/problem "$$\n\\displaystyle \\int 5{x}^{2}\\operatorname{cos}⁡({x}^{3})\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={x}^{3}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 5{x}^{2}\\operatorname{cos}⁡({x}^{3})\\,\\text{d}x & =\\int 5\\operatorname{cos}⁡({x}^{3})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int 5\\operatorname{cos}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{5}{3}\\operatorname{sin}⁡u+C \\\\  & =\\frac{5}{3}\\operatorname{sin}⁡({x}^{3})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186605837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5841f26e-e77f-5abf-8554-e49b74956114" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡({x}^{2})+C" :db/id #edb/ref 17592186605411} {:answer/id #uuid "ad4068a3-7725-577e-884c-b90d2c736c8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{tan}⁡({x}^{2})+C" :db/id #edb/ref 17592186605570} {:answer/id #uuid "bb027bbd-ba2d-5754-a425-ba0860b0a7f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡({x}^{2})+C" :db/id #edb/ref 17592186605592} {:answer/id #uuid "e0cf21a2-6ecf-507d-a9c4-69f7f0f50726" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sec}⁡({x}^{2})+C" :db/id #edb/ref 17592186605661} {:answer/id #uuid "fab56faa-facf-50d9-bd7a-d52d97b81de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{tan}⁡({x}^{2})+C" :db/id #edb/ref 17592186605708}] :answer-field/correct {:answer/id #uuid "fab56faa-facf-50d9-bd7a-d52d97b81de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{tan}⁡({x}^{2})+C" :db/id #edb/ref 17592186605708} :answer-field/id #uuid "0fb66e89-485f-5599-801d-5b503ee20e58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186605721}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1b7a1c4f-ee46-59c2-a0d1-028c953d1f17" :question/math-academy-id "q-13460" :question/problem "Calculate the integral $$\n\\displaystyle \\int x{sec}^{2}⁡({x}^{2})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int x{sec}^{2}⁡({x}^{2})\\,\\text{d}x & =\\int {sec}^{2}⁡({x}^{2})\\cdot x\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡({x}^{2})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186605847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084d6296-4e0e-5291-a90f-82b7617ff7a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186605264} {:answer/id #uuid "2341f810-fcdd-5f61-be44-39e52dde1228" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186605311} {:answer/id #uuid "320634f0-cac2-5787-bb32-88a333793829" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186605344} {:answer/id #uuid "86afb790-2d4b-5953-a77a-737ee084b7a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186605490} {:answer/id #uuid "a9fbf28e-c6bd-5a97-8692-75b54a26c81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186605562}] :answer-field/correct {:answer/id #uuid "2341f810-fcdd-5f61-be44-39e52dde1228" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186605311} :answer-field/id #uuid "d01f36ee-521c-54fe-9274-182cb22b18d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186605813}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3d11b8d3-3d89-559d-9bb2-2df9905b80bd" :question/math-academy-id "q-13544" :question/problem "$$\n\\displaystyle {\\int }_{\\sqrt{\\pi /18}}^{\\sqrt{\\pi /9}}2x{sec}^{2}⁡(3{x}^{2})\\,\\text{d}x=\n$$" :question/worked-solution "Let $u=3{x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\sqrt{\\pi /18}$ | $\\sqrt{\\pi /9}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi }{6}$ | $\\frac{\\pi }{3}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{\\pi /18}}^{\\sqrt{\\pi /9}}2x{sec}^{2}⁡(3{x}^{2})\\,\\text{d}x & ={\\int }_{\\sqrt{\\pi /18}}^{\\sqrt{\\pi /9}}2{sec}^{2}⁡(3{x}^{2})\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}2{sec}^{2}⁡u\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{\\pi /6}^{\\pi /3}{sec}^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{tan}⁡u{|}_{\\pi /6}^{\\pi /3} \\\\  & =\\frac{1}{3}(\\operatorname{tan}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{tan}⁡\\left(\\frac{\\pi }{6}\\right)) \\\\  & =\\frac{1}{3}(\\sqrt{3}-\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{1}{3}\\left(\\frac{2}{\\sqrt{3}}\\right) \\\\  & =\\frac{2\\sqrt{3}}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186611646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16adda69-f89e-5bfd-af50-5b8bdb679010" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x}\\operatorname{sin}⁡(\\sqrt{x})+C" :db/id #edb/ref 17592186611107} {:answer/id #uuid "35602054-babb-540a-9b9d-a91bf0cf7892" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡(\\sqrt{x})}{2}+C" :db/id #edb/ref 17592186611150} {:answer/id #uuid "4ad15320-a1c5-5373-af1d-0273c9fbce64" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\sqrt{x})+C" :db/id #edb/ref 17592186611180} {:answer/id #uuid "96c61819-0fb7-50f0-b5d8-8d48e3ea6491" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x}\\operatorname{cos}⁡(\\sqrt{x})+C" :db/id #edb/ref 17592186611307} {:answer/id #uuid "cff5f868-a0dd-5fc7-ad99-0ff5e51cab1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{sin}⁡(\\sqrt{x})}{\\sqrt{x}}+C" :db/id #edb/ref 17592186611398}] :answer-field/correct {:answer/id #uuid "4ad15320-a1c5-5373-af1d-0273c9fbce64" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\sqrt{x})+C" :db/id #edb/ref 17592186611180} :answer-field/id #uuid "447f0452-c7c0-5061-ac54-ed0e8121ebfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186611488}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f8b1a93e-d361-59f6-a945-adc08b0914f2" :question/math-academy-id "q-2377" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{\\operatorname{cos}⁡(\\sqrt{x})}{\\sqrt{x}}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=\\sqrt{x}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\,\\text{d}u=\\frac{1}{\\sqrt{x}}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\operatorname{cos}⁡(\\sqrt{x})}{\\sqrt{x}}\\,\\text{d}x & =\\int \\operatorname{cos}⁡(\\sqrt{x})\\cdot \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡u\\cdot 2\\,\\text{d}u \\\\  & =2\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =2\\operatorname{sin}⁡u+C \\\\  & =2\\operatorname{sin}⁡(\\sqrt{x})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d572ac-01af-5955-82aa-3e768b36e2f8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186657049}] :answer-field/correct {:answer/id #uuid "00d572ac-01af-5955-82aa-3e768b36e2f8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186657049} :answer-field/id #uuid "a6512d6a-335a-528d-b7fb-d8511385140d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657402}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1bf4d546-3968-549c-809c-efe4c07584b8" :question/math-academy-id "q-350883" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\sqrt{\\pi /30}}^{\\sqrt{\\pi /10}}10xcsc\\,(5{x}^{2})cot\\,(5{x}^{2})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=5{x}^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10x\\,⟹\\,\\text{d}u=10x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\sqrt{\\pi /30}$ | $\\sqrt{\\pi /10}$ |\n| --- | --- | --- |\n| $u$ | $\\pi /6$ | $\\pi /2$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{\\pi /30}}^{\\sqrt{\\pi /10}}10xcsc\\,(5{x}^{2})cot\\,(5{x}^{2})\\,\\text{d}x & ={\\int }_{\\sqrt{\\pi /30}}^{\\sqrt{\\pi /10}}csc\\,(5{x}^{2})cot\\,(5{x}^{2})\\cdot 10x\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\,\\text{d}u \\\\  & =-\\operatorname{csc}⁡(u)\\,{|}_{\\pi /6}^{\\pi /2} \\\\  & =-(\\operatorname{csc}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{csc}⁡\\left(\\frac{\\pi }{6}\\right)) \\\\  & =-(1-2) \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186658964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0007f85e-299c-5b79-b9ec-8453687d1ce7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{cot}⁡({x}^{3})+C" :db/id #edb/ref 17592186658407} {:answer/id #uuid "18a80f2e-bcd8-593d-984d-a492d040e259" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡({x}^{3})+C" :db/id #edb/ref 17592186658435} {:answer/id #uuid "35a285de-59a9-5b2f-88de-9dae11d3c597" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\operatorname{csc}⁡({x}^{3})+C" :db/id #edb/ref 17592186658482} {:answer/id #uuid "aea7e1e8-b929-5225-a1c2-e230e26ee364" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\operatorname{cot}⁡({x}^{3})+C" :db/id #edb/ref 17592186658660} {:answer/id #uuid "d78244c3-8175-5680-ae70-38b7480692ea" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡({x}^{3})+C" :db/id #edb/ref 17592186658731}] :answer-field/correct {:answer/id #uuid "aea7e1e8-b929-5225-a1c2-e230e26ee364" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\operatorname{cot}⁡({x}^{3})+C" :db/id #edb/ref 17592186658660} :answer-field/id #uuid "5769a818-a51d-5cb6-b9be-b957cdd1a61a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658851}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "afb796da-b0f3-583a-9b91-f7ceb9e49619" :question/math-academy-id "q-13469" :question/problem "Calculate the integral $$\n\\displaystyle \\int 2{x}^{2}{csc}^{2}⁡({x}^{3})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{3}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2{x}^{2}{csc}^{2}⁡({x}^{3})\\,\\text{d}x & =\\int 2{csc}^{2}⁡({x}^{3})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int 2{csc}^{2}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}\\int {csc}^{2}⁡u\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\operatorname{cot}⁡u+C \\\\  & =-\\frac{2}{3}\\operatorname{cot}⁡({x}^{3})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186658981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26428b0f-27ad-57ff-82c1-38411c7ad4e6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{csc}⁡({x}^{2})+C" :db/id #edb/ref 17592186658459} {:answer/id #uuid "64009f61-39d7-5a4c-87a5-147048718d28" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{csc}⁡({x}^{2})+C" :db/id #edb/ref 17592186658555} {:answer/id #uuid "88560ed4-3fd2-5e35-b823-59a0de90bf5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡({x}^{2})+C" :db/id #edb/ref 17592186658598} {:answer/id #uuid "9d479de0-2368-5b17-a3d1-550085306fdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡({x}^{2})+C" :db/id #edb/ref 17592186658634} {:answer/id #uuid "d4866fef-c958-566f-bda6-62f7eafd4907" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{cot}⁡({x}^{2})+C" :db/id #edb/ref 17592186658723}] :answer-field/correct {:answer/id #uuid "26428b0f-27ad-57ff-82c1-38411c7ad4e6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{csc}⁡({x}^{2})+C" :db/id #edb/ref 17592186658459} :answer-field/id #uuid "73c3d111-7c51-5bd3-8a2a-34f907747af7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186658862}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cd35717b-5994-5159-928f-a06c0623a4c4" :question/math-academy-id "q-13463" :question/problem "Calculate $$\n\\displaystyle \\int x\\operatorname{csc}⁡({x}^{2})\\operatorname{cot}⁡({x}^{2})\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int x\\operatorname{csc}⁡({x}^{2})\\operatorname{cot}⁡({x}^{2})\\,\\text{d}x & =\\int \\operatorname{csc}⁡({x}^{2})\\operatorname{cot}⁡({x}^{2})\\cdot x\\,\\text{d}x \\\\  & =\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{csc}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{csc}⁡({x}^{2})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f875e36d-de2a-5736-a342-e3fe9fc5e489" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cot{\\left(4 x^{2} \\right)}" :db/id #edb/ref 17592186677527}] :answer-field/correct {:answer/id #uuid "f875e36d-de2a-5736-a342-e3fe9fc5e489" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cot{\\left(4 x^{2} \\right)}" :db/id #edb/ref 17592186677527} :answer-field/id #uuid "bd04cd60-bda3-5cfd-862c-71c2696c1094" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677511}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "101b9e2e-a853-5b6d-9dde-606da78be59b" :question/problem "Find an antiderivative.\n\n$$\n\\int - 16 x \\csc^{2}{\\left(4 x^{2} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=4 x^{2}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8 x.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 16 x \\csc^{2}{\\left(4 x^{2} \\right)}\\,\\mathrm{d}x\\\\&=-2\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-2\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)=2 \\cot{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n2 \\cot{\\left(4 x^{2} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b78f18-a0fc-53c6-8a7b-11967228cf4a" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\cos{\\left(x^{3} \\right)}" :db/id #edb/ref 17592186677474}] :answer-field/correct {:answer/id #uuid "31b78f18-a0fc-53c6-8a7b-11967228cf4a" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\cos{\\left(x^{3} \\right)}" :db/id #edb/ref 17592186677474} :answer-field/id #uuid "b261a77b-1cf9-5e4e-aac4-71e2e8a1aec5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677508}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "19d11ce6-4765-5312-9507-03305372084d" :question/problem "Find an antiderivative.\n\n$$\n\\int - 9 x^{2} \\sin{\\left(x^{3} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3 x^{2}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 9 x^{2} \\sin{\\left(x^{3} \\right)}\\,\\mathrm{d}x\\\\&=-3\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-3\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=3 \\cos{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n3 \\cos{\\left(x^{3} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc63992a-9d07-51c6-9a14-7da8160f18ca" :answer/type {:db/ident :answer.type/math} :answer/value "- \\tan{\\left(4 x^{3} \\right)}" :db/id #edb/ref 17592186677518}] :answer-field/correct {:answer/id #uuid "cc63992a-9d07-51c6-9a14-7da8160f18ca" :answer/type {:db/ident :answer.type/math} :answer/value "- \\tan{\\left(4 x^{3} \\right)}" :db/id #edb/ref 17592186677518} :answer-field/id #uuid "43d191ba-9a39-5e10-8346-6d765a976bf9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677480}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1db3af81-54fc-56f5-90d7-2aef78d7368b" :question/problem "Find an antiderivative.\n\n$$\n\\int - 12 x^{2} \\sec^{2}{\\left(4 x^{3} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=4 x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=12 x^{2}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 12 x^{2} \\sec^{2}{\\left(4 x^{3} \\right)}\\,\\mathrm{d}x\\\\&=-\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u=- \\tan{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\tan{\\left(4 x^{3} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3361d4af-bd2b-5ae9-a120-637e9a9e0478" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\cos{\\left(\\frac{2}{x} \\right)}}{2}" :db/id #edb/ref 17592186677475}] :answer-field/correct {:answer/id #uuid "3361d4af-bd2b-5ae9-a120-637e9a9e0478" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\cos{\\left(\\frac{2}{x} \\right)}}{2}" :db/id #edb/ref 17592186677475} :answer-field/id #uuid "12bd3826-f8b2-58fe-8161-3fce354addb0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677463}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1e714881-ee39-59fc-9a3f-3bf6f9cafc07" :question/problem "Find an antiderivative.\n\n$$\n\\int - \\frac{\\sin{\\left(\\frac{2}{x} \\right)}}{x^{2}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=\\frac{2}{x}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{2}{x^{2}}.\n$$\n\nThe negative derivative is included in the factor outside the new integral.\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - \\frac{\\sin{\\left(\\frac{2}{x} \\right)}}{x^{2}}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{1}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- \\frac{\\cos{\\left(u \\right)}}{2}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{\\cos{\\left(\\frac{2}{x} \\right)}}{2}+C.\n$$"} {:db/id #edb/ref 17592186677468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "707ea017-4814-59c8-9a51-54005373d40b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sin{\\left(x^{2} \\right)}" :db/id #edb/ref 17592186677488}] :answer-field/correct {:answer/id #uuid "707ea017-4814-59c8-9a51-54005373d40b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sin{\\left(x^{2} \\right)}" :db/id #edb/ref 17592186677488} :answer-field/id #uuid "38ffebb3-bb75-519e-94de-a81686427cc9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677476}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1ef50331-2222-53a5-a60c-7d970b3c98ed" :question/problem "Find an antiderivative.\n\n$$\n\\int - 2 x \\cos{\\left(x^{2} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=x^{2}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2 x.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 2 x \\cos{\\left(x^{2} \\right)}\\,\\mathrm{d}x\\\\&=-\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=- \\sin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\sin{\\left(x^{2} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39ffb3ba-b62e-5f11-92d9-7036b34292ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\tan{\\left(\\frac{5}{x} \\right)}}{5}" :db/id #edb/ref 17592186677477}] :answer-field/correct {:answer/id #uuid "39ffb3ba-b62e-5f11-92d9-7036b34292ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\tan{\\left(\\frac{5}{x} \\right)}}{5}" :db/id #edb/ref 17592186677477} :answer-field/id #uuid "c436089f-aa2c-5f65-881b-e8fb257be424" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677515}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4583bf88-1e2a-5cbe-9d4f-a672a66aef43" :question/problem "Find an antiderivative.\n\n$$\n\\int - \\frac{2 \\sec^{2}{\\left(\\frac{5}{x} \\right)}}{x^{2}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=\\frac{5}{x}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{5}{x^{2}}.\n$$\n\nThe negative derivative is included in the factor outside the new integral.\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - \\frac{2 \\sec^{2}{\\left(\\frac{5}{x} \\right)}}{x^{2}}\\,\\mathrm{d}x\\\\&=\\frac{2}{5}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{2}{5}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{2 \\tan{\\left(u \\right)}}{5}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2 \\tan{\\left(\\frac{5}{x} \\right)}}{5}+C.\n$$"} {:db/id #edb/ref 17592186677482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db3231b5-aeed-5602-9be7-1ccd334e5bf3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sec{\\left(3 x^{3} \\right)}" :db/id #edb/ref 17592186677520}] :answer-field/correct {:answer/id #uuid "db3231b5-aeed-5602-9be7-1ccd334e5bf3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sec{\\left(3 x^{3} \\right)}" :db/id #edb/ref 17592186677520} :answer-field/id #uuid "3bc55393-9d08-5e57-99fa-5252031d3ff2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677478}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "47920ea4-5406-5ed0-8b6f-fa27c6691446" :question/problem "Find an antiderivative.\n\n$$\n\\int - 9 x^{2} \\tan{\\left(3 x^{3} \\right)} \\sec{\\left(3 x^{3} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=3 x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9 x^{2}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 9 x^{2} \\tan{\\left(3 x^{3} \\right)} \\sec{\\left(3 x^{3} \\right)}\\,\\mathrm{d}x\\\\&=-\\int \\tan{\\left(u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-\\int \\tan{\\left(u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u=- \\sec{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\sec{\\left(3 x^{3} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63f21307-c497-5db0-a85c-03c9d51ed1f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3} - \\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186677487}] :answer-field/correct {:answer/id #uuid "63f21307-c497-5db0-a85c-03c9d51ed1f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3} - \\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186677487} :answer-field/id #uuid "47dbca7f-63c7-50ca-9696-c48aa1bffece" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677483}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "73c5d24b-b081-5013-81bb-38ff31edef36" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{\\sqrt{5} \\sqrt{\\pi}}{6}}^{\\frac{\\sqrt{6} \\sqrt{\\pi}}{6}} - 4 x \\sin{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}}" :question/worked-solution "Let $u=3 x^{2} - \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6 x.\n$$\n\nChange both bounds:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt{5} \\sqrt{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{4}\\\\x=\\frac{\\sqrt{6} \\sqrt{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{3}\\end{aligned}\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\sqrt{5} \\sqrt{\\pi}}{6}}^{\\frac{\\sqrt{6} \\sqrt{\\pi}}{6}} - 4 x \\sin{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{2}{3}\\left(\\int_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}} \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate at both bounds:\n\n$$\n\\left[\\frac{2 \\cos{\\left(u \\right)}}{3}\\right]_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}}=\\left(\\frac{1}{3}\\right)-\\left(\\frac{\\sqrt{2}}{3}\\right).\n$$\n\nSimplifying gives\n\n$$\n\\frac{1}{3} - \\frac{\\sqrt{2}}{3}.\n$$"} {:db/id #edb/ref 17592186677494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0decba54-8a07-57e2-ad81-00835ebda0a6" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\sin{\\left(2 \\sqrt{x} - \\frac{\\pi}{6} \\right)}" :db/id #edb/ref 17592186677460}] :answer-field/correct {:answer/id #uuid "0decba54-8a07-57e2-ad81-00835ebda0a6" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\sin{\\left(2 \\sqrt{x} - \\frac{\\pi}{6} \\right)}" :db/id #edb/ref 17592186677460} :answer-field/id #uuid "fbf6a0de-6107-5841-b1f1-711ea3fa9b4f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677528}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "89bdc3ca-86c0-5c17-ac43-fa3e553566d0" :question/problem "Find an antiderivative.\n\n$$\n\\int - \\frac{2 \\cos{\\left(2 \\sqrt{x} - \\frac{\\pi}{6} \\right)}}{\\sqrt{x}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=2 \\sqrt{x} - \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{\\sqrt{x}}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - \\frac{2 \\cos{\\left(2 \\sqrt{x} - \\frac{\\pi}{6} \\right)}}{\\sqrt{x}}\\,\\mathrm{d}x\\\\&=-2\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-2\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- 2 \\sin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- 2 \\sin{\\left(2 \\sqrt{x} - \\frac{\\pi}{6} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ec1ea4d-e5b7-5b15-900d-6b9a8bdc5f43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18} - \\frac{\\sqrt{2}}{18}" :db/id #edb/ref 17592186677496}] :answer-field/correct {:answer/id #uuid "8ec1ea4d-e5b7-5b15-900d-6b9a8bdc5f43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18} - \\frac{\\sqrt{2}}{18}" :db/id #edb/ref 17592186677496} :answer-field/id #uuid "e8e215fc-d4c2-5cd1-b568-86a3864b9a1d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677522}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8d3c55dc-1e6c-5a48-93f5-b03770577f5c" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{\\sqrt[3]{30} \\sqrt[3]{\\pi}}{6}}^{\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}} - x^{2} \\cos{\\left(3 x^{3} - \\frac{\\pi}{4} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}}" :question/worked-solution "Let $u=3 x^{3} - \\frac{\\pi}{4}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9 x^{2}.\n$$\n\nChange both bounds:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt[3]{30} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{6}\\\\x=\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{4}\\end{aligned}\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\sqrt[3]{30} \\sqrt[3]{\\pi}}{6}}^{\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}} - x^{2} \\cos{\\left(3 x^{3} - \\frac{\\pi}{4} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{1}{9}\\left(\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{4}} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate at both bounds:\n\n$$\n\\left[- \\frac{\\sin{\\left(u \\right)}}{9}\\right]_{\\frac{\\pi}{6}}^{\\frac{\\pi}{4}}=\\left(- \\frac{\\sqrt{2}}{18}\\right)-\\left(- \\frac{1}{18}\\right).\n$$\n\nSimplifying gives\n\n$$\n\\frac{1}{18} - \\frac{\\sqrt{2}}{18}.\n$$"} {:db/id #edb/ref 17592186677497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d152707d-b92d-593a-a45f-6ff4e9f70d8b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 \\tan{\\left(5 x^{3} + \\frac{\\pi}{6} \\right)}}{5}" :db/id #edb/ref 17592186677519}] :answer-field/correct {:answer/id #uuid "d152707d-b92d-593a-a45f-6ff4e9f70d8b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 \\tan{\\left(5 x^{3} + \\frac{\\pi}{6} \\right)}}{5}" :db/id #edb/ref 17592186677519} :answer-field/id #uuid "c6614455-3b56-5713-b44f-e1f8edfc1857" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677516}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "91db11c0-dfd0-57e8-b6ea-5ae92e47c396" :question/problem "Find an antiderivative.\n\n$$\n\\int - 6 x^{2} \\sec^{2}{\\left(5 x^{3} + \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=5 x^{3} + \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=15 x^{2}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 6 x^{2} \\sec^{2}{\\left(5 x^{3} + \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{2}{5}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{2}{5}\\left(\\int \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- \\frac{2 \\tan{\\left(u \\right)}}{5}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{2 \\tan{\\left(5 x^{3} + \\frac{\\pi}{6} \\right)}}{5}+C.\n$$"} {:db/id #edb/ref 17592186677499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4c1f48-7a70-50b6-8c08-32c76bff5e3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cot{\\left(3 x^{2} + \\frac{\\pi}{6} \\right)}}{2}" :db/id #edb/ref 17592186677492}] :answer-field/correct {:answer/id #uuid "7d4c1f48-7a70-50b6-8c08-32c76bff5e3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cot{\\left(3 x^{2} + \\frac{\\pi}{6} \\right)}}{2}" :db/id #edb/ref 17592186677492} :answer-field/id #uuid "a6c480ed-e3e4-59ce-90b3-c54c7f7f8a37" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677505}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "973e9055-eac7-5fba-b71f-b62daa06bf9b" :question/problem "Find an antiderivative.\n\n$$\n\\int - 3 x \\csc^{2}{\\left(3 x^{2} + \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=3 x^{2} + \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6 x.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 3 x \\csc^{2}{\\left(3 x^{2} + \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{1}{2}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{1}{2}\\left(\\int \\csc^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{\\cot{\\left(u \\right)}}{2}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\cot{\\left(3 x^{2} + \\frac{\\pi}{6} \\right)}}{2}+C.\n$$"} {:db/id #edb/ref 17592186677500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9afe3b5-812c-5b18-a488-b9fd11d61a98" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7}{12} + \\frac{7 \\sqrt{3}}{36}" :db/id #edb/ref 17592186677523}] :answer-field/correct {:answer/id #uuid "e9afe3b5-812c-5b18-a488-b9fd11d61a98" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7}{12} + \\frac{7 \\sqrt{3}}{36}" :db/id #edb/ref 17592186677523} :answer-field/id #uuid "78973ae1-ce69-5f5c-8a3a-6e322d90d824" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677490}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9749bbc3-f1b3-5367-8b91-1569703885d7" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{\\sqrt[3]{18} \\sqrt[3]{\\pi}}{6}}^{\\frac{\\sqrt[3]{5} \\cdot 6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{12}} - 7 x^{2} \\sec^{2}{\\left(4 x^{3} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}}" :question/worked-solution "Let $u=4 x^{3} - \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=12 x^{2}.\n$$\n\nChange both bounds:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt[3]{18} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{6}\\\\x=\\frac{\\sqrt[3]{5} \\cdot 6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{12}&\\Longrightarrow u=\\frac{\\pi}{4}\\end{aligned}\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\sqrt[3]{18} \\sqrt[3]{\\pi}}{6}}^{\\frac{\\sqrt[3]{5} \\cdot 6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{12}} - 7 x^{2} \\sec^{2}{\\left(4 x^{3} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{7}{12}\\left(\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{4}} \\sec^{2}{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate at both bounds:\n\n$$\n\\left[- \\frac{7 \\tan{\\left(u \\right)}}{12}\\right]_{\\frac{\\pi}{6}}^{\\frac{\\pi}{4}}=\\left(- \\frac{7}{12}\\right)-\\left(- \\frac{7 \\sqrt{3}}{36}\\right).\n$$\n\nSimplifying gives\n\n$$\n- \\frac{7}{12} + \\frac{7 \\sqrt{3}}{36}.\n$$"} {:db/id #edb/ref 17592186677501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f03fa46a-1413-5fca-8b71-a8c0e88b14a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\csc{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)}}{4}" :db/id #edb/ref 17592186677524}] :answer-field/correct {:answer/id #uuid "f03fa46a-1413-5fca-8b71-a8c0e88b14a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\csc{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)}}{4}" :db/id #edb/ref 17592186677524} :answer-field/id #uuid "2f9c52dc-1a72-5826-9182-f27a0c5f6656" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677472}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9de74302-8fa4-56ae-bdfc-1a0e6cde33d5" :question/problem "Find an antiderivative.\n\n$$\n\\int - 5 x \\cot{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)} \\csc{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=2 x^{2} - \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4 x.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 5 x \\cot{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)} \\csc{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{5}{4}\\left(\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{5}{4}\\left(\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{5 \\csc{\\left(u \\right)}}{4}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{5 \\csc{\\left(2 x^{2} - \\frac{\\pi}{6} \\right)}}{4}+C.\n$$"} {:db/id #edb/ref 17592186677502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4240a1ff-fa1b-5a50-b86e-727de8a75f54" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 \\sqrt{2}}{9} + \\frac{8 \\sqrt{3}}{27}" :db/id #edb/ref 17592186677479}] :answer-field/correct {:answer/id #uuid "4240a1ff-fa1b-5a50-b86e-727de8a75f54" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 \\sqrt{2}}{9} + \\frac{8 \\sqrt{3}}{27}" :db/id #edb/ref 17592186677479} :answer-field/id #uuid "b8a9861d-151c-5794-b355-bec1caa4273e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677509}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a0f9e5be-a771-57c5-a59e-80a712358640" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}}^{\\frac{\\sqrt[3]{42} \\sqrt[3]{\\pi}}{6}} - 4 x^{2} \\cot{\\left(3 x^{3} - \\frac{\\pi}{4} \\right)} \\csc{\\left(3 x^{3} - \\frac{\\pi}{4} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}}" :question/worked-solution "Let $u=3 x^{3} - \\frac{\\pi}{4}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9 x^{2}.\n$$\n\nChange both bounds:\n\n$$\n\\begin{aligned}x=\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{4}\\\\x=\\frac{\\sqrt[3]{42} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{3}\\end{aligned}\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}}^{\\frac{\\sqrt[3]{42} \\sqrt[3]{\\pi}}{6}} - 4 x^{2} \\cot{\\left(3 x^{3} - \\frac{\\pi}{4} \\right)} \\csc{\\left(3 x^{3} - \\frac{\\pi}{4} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{4}{9}\\left(\\int_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}} \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate at both bounds:\n\n$$\n\\left[\\frac{4 \\csc{\\left(u \\right)}}{9}\\right]_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}}=\\left(\\frac{8 \\sqrt{3}}{27}\\right)-\\left(\\frac{4 \\sqrt{2}}{9}\\right).\n$$\n\nSimplifying gives\n\n$$\n- \\frac{4 \\sqrt{2}}{9} + \\frac{8 \\sqrt{3}}{27}.\n$$"} {:db/id #edb/ref 17592186677507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31949ad0-96b1-58e3-bf6c-53fb4c72e773" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\cos{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}}{3}" :db/id #edb/ref 17592186677473}] :answer-field/correct {:answer/id #uuid "31949ad0-96b1-58e3-bf6c-53fb4c72e773" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\cos{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}}{3}" :db/id #edb/ref 17592186677473} :answer-field/id #uuid "c9bad736-0fce-57a0-af1c-df02f7de5a48" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677517}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b1d33425-3609-51b7-b446-8aaf1d499fe0" :question/problem "Find an antiderivative.\n\n$$\n\\int - 4 x \\sin{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=3 x^{2} - \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6 x.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int - 4 x \\sin{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{2}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{2}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=\\frac{2 \\cos{\\left(u \\right)}}{3}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2 \\cos{\\left(3 x^{2} - \\frac{\\pi}{6} \\right)}}{3}+C.\n$$"} {:db/id #edb/ref 17592186677510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc8b030-b1bf-5b26-bff4-f7094c77cbf4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{2}}{6} + \\frac{5 \\sqrt{3}}{9}" :db/id #edb/ref 17592186677459}] :answer-field/correct {:answer/id #uuid "0dc8b030-b1bf-5b26-bff4-f7094c77cbf4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{2}}{6} + \\frac{5 \\sqrt{3}}{9}" :db/id #edb/ref 17592186677459} :answer-field/id #uuid "250cce16-4722-5b76-b45f-f77bd947727c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677471}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b8e0ec31-d0ce-535f-99ad-9b1b6605c3e8" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}}^{\\frac{3^{\\frac{2}{3}} \\sqrt[3]{5} \\sqrt[3]{\\pi}}{6}} - 5 x^{2} \\tan{\\left(2 x^{3} - \\frac{\\pi}{6} \\right)} \\sec{\\left(2 x^{3} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}}" :question/worked-solution "Let $u=2 x^{3} - \\frac{\\pi}{6}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6 x^{2}.\n$$\n\nChange both bounds:\n\n$$\n\\begin{aligned}x=\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{6}\\\\x=\\frac{3^{\\frac{2}{3}} \\sqrt[3]{5} \\sqrt[3]{\\pi}}{6}&\\Longrightarrow u=\\frac{\\pi}{4}\\end{aligned}\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{6^{\\frac{2}{3}} \\sqrt[3]{\\pi}}{6}}^{\\frac{3^{\\frac{2}{3}} \\sqrt[3]{5} \\sqrt[3]{\\pi}}{6}} - 5 x^{2} \\tan{\\left(2 x^{3} - \\frac{\\pi}{6} \\right)} \\sec{\\left(2 x^{3} - \\frac{\\pi}{6} \\right)}\\,\\mathrm{d}x\\\\&=- \\frac{5}{6}\\left(\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{4}} \\tan{\\left(u \\right)} \\sec{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate at both bounds:\n\n$$\n\\left[- \\frac{5 \\sec{\\left(u \\right)}}{6}\\right]_{\\frac{\\pi}{6}}^{\\frac{\\pi}{4}}=\\left(- \\frac{5 \\sqrt{2}}{6}\\right)-\\left(- \\frac{5 \\sqrt{3}}{9}\\right).\n$$\n\nSimplifying gives\n\n$$\n- \\frac{5 \\sqrt{2}}{6} + \\frac{5 \\sqrt{3}}{9}.\n$$"} {:db/id #edb/ref 17592186677512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58bfa3d8-d227-57e9-b82a-fe9da15e43ae" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\csc{\\left(3 x^{3} \\right)}" :db/id #edb/ref 17592186677486}] :answer-field/correct {:answer/id #uuid "58bfa3d8-d227-57e9-b82a-fe9da15e43ae" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\csc{\\left(3 x^{3} \\right)}" :db/id #edb/ref 17592186677486} :answer-field/id #uuid "7adf920c-bfc1-5695-b5d8-9224f28065ec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677491}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bd8c81ba-30ea-501d-a51f-626a1c33904a" :question/problem "Find an antiderivative.\n\n$$\n\\int 18 x^{2} \\cot{\\left(3 x^{3} \\right)} \\csc{\\left(3 x^{3} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=3 x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9 x^{2}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int 18 x^{2} \\cot{\\left(3 x^{3} \\right)} \\csc{\\left(3 x^{3} \\right)}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n2\\left(\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- 2 \\csc{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- 2 \\csc{\\left(3 x^{3} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cae070-0ed2-546a-b423-db4cc244efd9" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(3 x^{3} \\right)}" :db/id #edb/ref 17592186677470}] :answer-field/correct {:answer/id #uuid "24cae070-0ed2-546a-b423-db4cc244efd9" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(3 x^{3} \\right)}" :db/id #edb/ref 17592186677470} :answer-field/id #uuid "955fdd38-6ab4-5155-ae93-cec4da8fd5d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677498}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bdc9ccb7-c883-51d4-9fec-ab8fe84f9c03" :question/problem "Find an antiderivative.\n\n$$\n\\int 18 x^{2} \\sin{\\left(3 x^{3} \\right)}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$" :question/worked-solution "Let $u=3 x^{3}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9 x^{2}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int 18 x^{2} \\sin{\\left(3 x^{3} \\right)}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n2\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- 2 \\cos{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- 2 \\cos{\\left(3 x^{3} \\right)}+C.\n$$"} {:db/id #edb/ref 17592186677514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c350d3-cc87-543d-96d5-dac111bb66d8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sec{\\left(2 x^{3} + \\frac{\\pi}{6} \\right)}}{6}" :db/id #edb/ref 17592186677506}] :answer-field/correct {:answer/id #uuid "a7c350d3-cc87-543d-96d5-dac111bb66d8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sec{\\left(2 x^{3} + \\frac{\\pi}{6} \\right)}}{6}" :db/id #edb/ref 17592186677506} :answer-field/id #uuid "f08cf9d6-984c-5dbb-8482-f0f3c0ba90b2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677525}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c396d67e-fbe1-5c22-8d3f-5b57601ca9