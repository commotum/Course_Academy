bf816a4" :answer-field/choices "27089fe1-6c23-54f0-b47a-e3f93b7ed763"] [:db/add "eac44cab-9b65-515e-8347-37092bf816a4" :answer-field/choices "8f232962-11af-5eef-a0f7-f31a2c39f661"] [:db/add "eac44cab-9b65-515e-8347-37092bf816a4" :answer-field/choices "ce1f1971-e4a3-5412-aaf9-59726bff3a26"] [:db/add "eac44cab-9b65-515e-8347-37092bf816a4" :answer-field/choices "a0d4518d-2cf8-542e-a969-a7e5a27a4e61"] [:db/add "eac44cab-9b65-515e-8347-37092bf816a4" :answer-field/correct "27089fe1-6c23-54f0-b47a-e3f93b7ed763"] [:db/ensure "eac44cab-9b65-515e-8347-37092bf816a4" :answer-field/validate] [:db/add "a48686af-93c4-5286-bf96-27b158c78356" :question/id #uuid "a48686af-93c4-5286-bf96-27b158c78356"] [:db/add "a48686af-93c4-5286-bf96-27b158c78356" :question/problem "Evaluate exactly.\n\n$$\n\\int_{- \\frac{1}{5}}^{0} \\frac{2}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "a48686af-93c4-5286-bf96-27b158c78356" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{5}=\\frac{2}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=- \\frac{1}{5}&\\Longrightarrow u=-1\\\\x=0&\\Longrightarrow u=0\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{- \\frac{1}{5}}^{0} \\frac{2}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{5}\\left(\\int_{-1}^{0} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(0 \\right)}=0$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{2}{5}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{0}\\right)=\\frac{2}{5}\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{10}.\n$$"] [:db/add "a48686af-93c4-5286-bf96-27b158c78356" :question/difficulty :question.difficulty/easy] [:db/add "a48686af-93c4-5286-bf96-27b158c78356" :question/answer-fields "eac44cab-9b65-515e-8347-37092bf816a4"] [:db/ensure "a48686af-93c4-5286-bf96-27b158c78356" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "a48686af-93c4-5286-bf96-27b158c78356"] [:db/add "generator" :question-generator/id #uuid "1e091910-d315-52ae-aea4-c1d5d19b78c4"] [:db/add "generator" :question-generator/script "generators/9a/9a5879c86337cafcfacf5bafdbe55a92372948eb8ac2d81a11d85f3216ce3796/generator.py"] [:db/add 17592186064220 :knowledge-point/question-generator "generator"] [:db/ensure 17592186064220 :knowledge-point/validate] [:db/cas 17592186693053 :question/retired nil true] [:db/cas 17592186693061 :question/retired nil true] [:db/cas 17592186693080 :question/retired nil true] [:db/cas 17592186693105 :question/retired nil true] [:db/cas 17592186693108 :question/retired nil true]]
