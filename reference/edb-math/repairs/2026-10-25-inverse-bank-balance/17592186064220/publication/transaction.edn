f5b36ec" :answer-field/choices "ef4e0730-dfa3-5e5d-bb34-63a4b6741366"] [:db/add "05d61f50-9454-5f29-ba51-cc12ff5b36ec" :answer-field/choices "511b588a-f60a-5f0b-b76b-d1c469f68e78"] [:db/add "05d61f50-9454-5f29-ba51-cc12ff5b36ec" :answer-field/choices "977d1613-792e-5d29-8ea2-e0007e57e75a"] [:db/add "05d61f50-9454-5f29-ba51-cc12ff5b36ec" :answer-field/choices "32054a1a-0664-5bd7-a2c8-d22efdb399f8"] [:db/add "05d61f50-9454-5f29-ba51-cc12ff5b36ec" :answer-field/choices "14b61ba8-f63a-5d58-8bc5-65ee2e4b0582"] [:db/add "05d61f50-9454-5f29-ba51-cc12ff5b36ec" :answer-field/correct "14b61ba8-f63a-5d58-8bc5-65ee2e4b0582"] [:db/ensure "05d61f50-9454-5f29-ba51-cc12ff5b36ec" :answer-field/validate] [:db/add "8e805443-94b7-5de8-b223-d4c0deb150ed" :question/id #uuid "8e805443-94b7-5de8-b223-d4c0deb150ed"] [:db/add "8e805443-94b7-5de8-b223-d4c0deb150ed" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{8}} \\frac{4}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "8e805443-94b7-5de8-b223-d4c0deb150ed" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{4}=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{8}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{8}} \\frac{4}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}=\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{6}.\n$$"] [:db/add "8e805443-94b7-5de8-b223-d4c0deb150ed" :question/difficulty :question.difficulty/easy] [:db/add "8e805443-94b7-5de8-b223-d4c0deb150ed" :question/answer-fields "05d61f50-9454-5f29-ba51-cc12ff5b36ec"] [:db/ensure "8e805443-94b7-5de8-b223-d4c0deb150ed" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "8e805443-94b7-5de8-b223-d4c0deb150ed"] [:db/add "b7feefbe-f2c8-5d86-bf8a-13e789771c2c" :answer/id #uuid "b7feefbe-f2c8-5d86-bf8a-13e789771c2c"] [:db/add "b7feefbe-f2c8-5d86-bf8a-13e789771c2c" :answer/type :answer.type/math] [:db/add "b7feefbe-f2c8-5d86-bf8a-13e789771c2c" :answer/value "\\frac{3 \\pi}{4}"] [:db/ensure "b7feefbe-f2c8-5d86-bf8a-13e789771c2c" :answer/validate] [:db/add "e95de0fd-da01-5165-9a66-2a661872263d" :answer/id #uuid "e95de0fd-da01-5165-9a66-2a661872263d"] [:db/add "e95de0fd-da01-5165-9a66-2a661872263d" :answer/type :answer.type/math] [:db/add "e95de0fd-da01-5165-9a66-2a661872263d" :answer/value "\\frac{3 \\pi}{10}"] [:db/ensure "e95de0fd-da01-5165-9a66-2a661872263d" :answer/validate] [:db/add "fde4d329-11e7-5509-bf35-3fb7fd46d6e5" :answer/id #uuid "fde4d329-11e7-5509-bf35-3fb7fd46d6e5"] [:db/add "fde4d329-11e7-5509-bf35-3fb7fd46d6e5" :answer/type :answer.type/math] [:db/add "fde4d329-11e7-5509-bf35-3fb7fd46d6e5" :answer/value "\\frac{\\pi}{5}"] [:db/ensure "fde4d329-11e7-5509-bf35-3fb7fd46d6e5" :answer/validate] [:db/add "12c05537-9374-58af-a715-f7a705fc094b" :answer/id #uuid "12c05537-9374-58af-a715-f7a705fc094b"] [:db/add "12c05537-9374-58af-a715-f7a705fc094b" :answer/type :answer.type/math] [:db/add "12c05537-9374-58af-a715-f7a705fc094b" :answer/value "\\frac{3 \\pi}{20}"] [:db/ensure "12c05537-9374-58af-a715-f7a705fc094b" :answer/validate] [:db/add "3a3a44cd-1747-52b8-a876-8ab8bc0ed490" :answer/id #uuid "3a3a44cd-1747-52b8-a876-8ab8bc0ed490"] [:db/add "3a3a44cd-1747-52b8-a876-8ab8bc0ed490" :answer/type :answer.type/math] [:db/add "3a3a44cd-1747-52b8-a876-8ab8bc0ed490" :answer/value "\\frac{3 \\pi}{40}"] [:db/ensure "3a3a44cd-1747-52b8-a876-8ab8bc0ed490" :answer/validate] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/id #uuid "c42f8ad8-4651-5513-9fbd-2913f823f2d0"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/key "answer"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/type :answer-field.type/radio] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/choices "b7feefbe-f2c8-5d86-bf8a-13e789771c2c"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/choices "e95de0fd-da01-5165-9a66-2a661872263d"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/choices "fde4d329-11e7-5509-bf35-3fb7fd46d6e5"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/choices "12c05537-9374-58af-a715-f7a705fc094b"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/choices "3a3a44cd-1747-52b8-a876-8ab8bc0ed490"] [:db/add "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/correct "12c05537-9374-58af-a715-f7a705fc094b"] [:db/ensure "c42f8ad8-4651-5513-9fbd-2913f823f2d0" :answer-field/validate] [:db/add "a7267bef-6d93-518d-a40c-208d304f6659" :question/id #uuid "a7267bef-6d93-518d-a40c-208d304f6659"] [:db/add "a7267bef-6d93-518d-a40c-208d304f6659" :question/problem "Evaluate exactly.\n\n$$\n\\int_{- \\frac{1}{5}}^{0} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "a7267bef-6d93-518d-a40c-208d304f6659" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{5}=\\frac{3}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=- \\frac{1}{5}&\\Longrightarrow u=-1\\\\x=0&\\Longrightarrow u=0\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{- \\frac{1}{5}}^{0} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{-1}^{0} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(0 \\right)}=0$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{3}{5}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{0}\\right)=\\frac{3}{5}\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3 \\pi}{20}.\n$$"] [:db/add "a7267bef-6d93-518d-a40c-208d304f6659" :question/difficulty :question.difficulty/easy] [:db/add "a7267bef-6d93-518d-a40c-208d304f6659" :question/answer-fields "c42f8ad8-4651-5513-9fbd-2913f823f2d0"] [:db/ensure "a7267bef-6d93-518d-a40c-208d304f6659" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "a7267bef-6d93-518d-a40c-208d304f6659"] [:db/add "6238d0b8-0cf6-5bc6-a0cc-de1db18b84bf" :answer/id #uuid "6238d0b8-0cf6-5bc6-a0cc-de1db18b84bf"] [:db/add "6238d0b8-0cf6-5bc6-a0cc-de1db18b84bf" :answer/type :answer.type/math] [:db/add "6238d0b8-0cf6-5bc6-a0cc-de1db18b84bf" :answer/value "\\frac{3 \\pi}{4}"] [:db/ensure "6238d0b8-0cf6-5bc6-a0cc-de1db18b84bf" :answer/validate] [:db/add "d9aab288-d8e6-561b-8aea-db8ec6606ca9" :answer/id #uuid "d9aab288-d8e6-561b-8aea-db8ec6606ca9"] [:db/add "d9aab288-d8e6-561b-8aea-db8ec6606ca9" :answer/type :answer.type/math] [:db/add "d9aab288-d8e6-561b-8aea-db8ec6606ca9" :answer/value "\\frac{9 \\pi}{4}"] [:db/ensure "d9aab288-d8e6-561b-8aea-db8ec6606ca9" :answer/validate] [:db/add "87ef638d-a179-5b05-8715-a7e1291a2a20" :answer/id #uuid "87ef638d-a179-5b05-8715-a7e1291a2a20"] [:db/add "87ef638d-a179-5b05-8715-a7e1291a2a20" :answer/type :answer.type/math] [:db/add "87ef638d-a179-5b05-8715-a7e1291a2a20" :answer/value "\\frac{\\pi}{8}"] [:db/ensure "87ef638d-a179-5b05-8715-a7e1291a2a20" :answer/validate] [:db/add "93c96896-41d8-541b-8c8d-073254646c67" :answer/id #uuid "93c96896-41d8-541b-8c8d-073254646c67"] [:db/add "93c96896-41d8-541b-8c8d-073254646c67" :answer/type :answer.type/math] [:db/add "93c96896-41d8-541b-8c8d-073254646c67" :answer/value "\\frac{\\pi}{4}"] [:db/ensure "93c96896-41d8-541b-8c8d-073254646c67" :answer/validate] [:db/add "57774871-e260-5b20-86fa-bd7cb372a1e9" :answer/id #uuid "57774871-e260-5b20-86fa-bd7cb372a1e9"] [:db/add "57774871-e260-5b20-86fa-bd7cb372a1e9" :answer/type :answer.type/math] [:db/add "57774871-e260-5b20-86fa-bd7cb372a1e9" :answer/value "\\frac{\\pi}{2}"] [:db/ensure "57774871-e260-5b20-86fa-bd7cb372a1e9" :answer/validate] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/id #uuid "e0393e59-d30d-54b5-8d80-335e9242475a"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/key "answer"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/type :answer-field.type/radio] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/choices "6238d0b8-0cf6-5bc6-a0cc-de1db18b84bf"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/choices "d9aab288-d8e6-561b-8aea-db8ec6606ca9"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/choices "87ef638d-a179-5b05-8715-a7e1291a2a20"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/choices "93c96896-41d8-541b-8c8d-073254646c67"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/choices "57774871-e260-5b20-86fa-bd7cb372a1e9"] [:db/add "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/correct "93c96896-41d8-541b-8c8d-073254646c67"] [:db/ensure "e0393e59-d30d-54b5-8d80-335e9242475a" :answer-field/validate] [:db/add "f2526946-63b0-5d4c-935e-2bd3ace075e1" :question/id #uuid "f2526946-63b0-5d4c-935e-2bd3ace075e1"] [:db/add "f2526946-63b0-5d4c-935e-2bd3ace075e1" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{3}} \\frac{3}{9 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "f2526946-63b0-5d4c-935e-2bd3ace075e1" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{3}=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{3}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} \\frac{3}{9 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}=\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{4}.\n$$"] [:db/add "f2526946-63b0-5d4c-935e-2bd3ace075e1" :question/difficulty :question.difficulty/easy] [:db/add "f2526946-63b0-5d4c-935e-2bd3ace075e1" :question/answer-fields "e0393e59-d30d-54b5-8d80-335e9242475a"] [:db/ensure "f2526946-63b0-5d4c-935e-2bd3ace075e1" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "f2526946-63b0-5d4c-935e-2bd3ace075e1"] [:db/add "517cf536-da92-5faa-b580-365df082c0be" :answer/id #uuid "517cf536-da92-5faa-b580-365df082c0be"] [:db/add "517cf536-da92-5faa-b580-365df082c0be" :answer/type :answer.type/math] [:db/add "517cf536-da92-5faa-b580-365df082c0be" :answer/value "\\frac{\\pi}{20}"] [:db/ensure "517cf536-da92-5faa-b580-365df082c0be" :answer/validate] [:db/add "04f1bee8-5135-51f0-9e8d-a6e53dad5e8c" :answer/id #uuid "04f1bee8-5135-51f0-9e8d-a6e53dad5e8c"] [:db/add "04f1bee8-5135-51f0-9e8d-a6e53dad5e8c" :answer/type :answer.type/math] [:db/add "04f1bee8-5135-51f0-9e8d-a6e53dad5e8c" :answer/value "\\frac{\\pi}{10}"] [:db/ensure "04f1bee8-5135-51f0-9e8d-a6e53dad5e8c" :answer/validate] [:db/add "d7c39e37-d8a8-5df3-85b8-49894475be2b" :answer/id #uuid "d7c39e37-d8a8-5df3-85b8-49894475be2b"] [:db/add "d7c39e37-d8a8-5df3-85b8-49894475be2b" :answer/type :answer.type/math] [:db/add "d7c39e37-d8a8-5df3-85b8-49894475be2b" :answer/value "\\frac{\\pi}{30}"] [:db/ensure "d7c39e37-d8a8-5df3-85b8-49894475be2b" :answer/validate] [:db/add "6d37becd-8aa4-5d34-9746-e42bc1ea9d76" :answer/id #uuid "6d37becd-8aa4-5d34-9746-e42bc1ea9d76"] [:db/add "6d37becd-8aa4-5d34-9746-e42bc1ea9d76" :answer/type :answer.type/math] [:db/add "6d37becd-8aa4-5d34-9746-e42bc1ea9d76" :answer/value "\\frac{\\pi}{150}"] [:db/ensure "6d37becd-8aa4-5d34-9746-e42bc1ea9d76" :answer/validate] [:db/add "b58d47ec-65e7-5bbc-989e-5f646185864c" :answer/id #uuid "b58d47ec-65e7-5bbc-989e-5f646185864c"] [:db/add "b58d47ec-65e7-5bbc-989e-5f646185864c" :answer/type :answer.type/math] [:db/add "b58d47ec-65e7-5bbc-989e-5f646185864c" :answer/value "\\frac{\\pi}{15}"] [:db/ensure "b58d47ec-65e7-5bbc-989e-5f646185864c" :answer/validate] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/id #uuid "43e073aa-87c9-5622-950d-9a94ddd6e3fa"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/key "answer"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/type :answer-field.type/radio] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/choices "517cf536-da92-5faa-b580-365df082c0be"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/choices "04f1bee8-5135-51f0-9e8d-a6e53dad5e8c"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/choices "d7c39e37-d8a8-5df3-85b8-49894475be2b"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/choices "6d37becd-8aa4-5d34-9746-e42bc1ea9d76"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/choices "b58d47ec-65e7-5bbc-989e-5f646185864c"] [:db/add "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/correct "d7c39e37-d8a8-5df3-85b8-49894475be2b"] [:db/ensure "43e073aa-87c9-5622-950d-9a94ddd6e3fa" :answer-field/validate] [:db/add "560e2c24-ea3c-532b-8933-02d668239b6e" :question/id #uuid "560e2c24-ea3c-532b-8933-02d668239b6e"] [:db/add "560e2c24-ea3c-532b-8933-02d668239b6e" :question/problem "Evaluate exactly.\n\n$$\n\\int_{- \\frac{1}{10}}^{0} \\frac{1}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "560e2c24-ea3c-532b-8933-02d668239b6e" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $1\\cdot \\frac{1}{5}=\\frac{1}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=- \\frac{1}{10}&\\Longrightarrow u=- \\frac{1}{2}\\\\x=0&\\Longrightarrow u=0\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{- \\frac{1}{10}}^{0} \\frac{1}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{1}{5}\\left(\\int_{- \\frac{1}{2}}^{0} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(0 \\right)}=0$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{5}\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{0}\\right)=\\frac{1}{5}\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{30}.\n$$"] [:db/add "560e2c24-ea3c-532b-8933-02d668239b6e" :question/difficulty :question.difficulty/easy] [:db/add "560e2c24-ea3c-532b-8933-02d668239b6e" :question/answer-fields "43e073aa-87c9-5622-950d-9a94ddd6e3fa"] [:db/ensure "560e2c24-ea3c-532b-8933-02d668239b6e" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "560e2c24-ea3c-532b-8933-02d668239b6e"] [:db/add "06126d47-092b-50e3-8ece-de7711637309" :answer/id #uuid "06126d47-092b-50e3-8ece-de7711637309"] [:d