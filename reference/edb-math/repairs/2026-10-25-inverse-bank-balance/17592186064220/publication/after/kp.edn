type/math} :answer/value "\\frac{3}{10}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680231} {:answer/id #uuid "8831b9f9-d282-5391-89a7-7832f651a39a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680260} {:answer/id #uuid "b85a2c77-3cb5-53d6-bfb2-a344b7e57814" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680265} {:answer/id #uuid "d36e9edc-a7cc-51ce-9b66-c7fe4e007712" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680272} {:answer/id #uuid "e528e5f8-a327-5f4b-bf0c-b19d8b259e2d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{6}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680276}] :answer-field/correct {:answer/id #uuid "8831b9f9-d282-5391-89a7-7832f651a39a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680260} :answer-field/id #uuid "263081b9-c098-5296-b3ba-ccbd6cff89a0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680236}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e73fcff5-96f0-50ba-ade3-485d0e837c29" :question/problem "Use the substitution $u=5 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{5}} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{5}=\\frac{3}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{5}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{5}} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186680278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aeb26a0-e6e3-5188-9417-6267adb3f4f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680239} {:answer/id #uuid "2c090cd3-c0c6-5e38-85f2-7478c68e0ae8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680240} {:answer/id #uuid "2f4079f0-1d21-559b-9db1-982368a96d09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680241} {:answer/id #uuid "32518dfa-4394-5060-b026-c24b3b9d3b44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680242} {:answer/id #uuid "6cbe5ff7-2e79-5b8d-a58e-dab0aef22a56" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{4}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680256}] :answer-field/correct {:answer/id #uuid "2aeb26a0-e6e3-5188-9417-6267adb3f4f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680239} :answer-field/id #uuid "344abe5e-368e-5759-b323-d2d6cba9273e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680244}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e9a96d98-c61e-53c1-9060-cc112c4a0f74" :question/problem "Use the substitution $u=4 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{4}} \\frac{1}{16 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $1\\cdot \\frac{1}{4}=\\frac{1}{4}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{4}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{4}} \\frac{1}{16 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{4}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186680279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274dc628-a5a7-5262-b684-c9e4e3bcf005" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680237} {:answer/id #uuid "4f516887-2817-58c5-a56d-5088b8600e2b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680247} {:answer/id #uuid "75d2a700-c9db-53c9-b311-71eff8038144" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680258} {:answer/id #uuid "b4a22167-faf6-55c7-8fe9-b6551c864d35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680264} {:answer/id #uuid "c0348e5d-0372-55ce-9d72-93104a898efe" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u" :db/id #edb/ref 17592186680268}] :answer-field/correct {:answer/id #uuid "c0348e5d-0372-55ce-9d72-93104a898efe" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u" :db/id #edb/ref 17592186680268} :answer-field/id #uuid "f51fbec3-1e78-5859-b46b-1880ff84fac9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680284}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/problem "Use the substitution $u=2 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{4}} \\frac{2}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{2}=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{4}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{4}} \\frac{2}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\\\\&=\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\n$$"} {:db/id #edb/ref 17592186683011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "887f20d7-c3bb-5f93-b4e0-13c10c21e892" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186683033}] :answer-field/correct {:answer/id #uuid "887f20d7-c3bb-5f93-b4e0-13c10c21e892" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186683033} :answer-field/id #uuid "20aeb071-f38e-5388-a548-9dc76bbacdef" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186683015}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "13285ed5-a0db-5b3a-b640-d68de99074b7" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{4} \\frac{4}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{4}\\cdot 4=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=4&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{4} \\frac{4}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}=\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{4}.\n$$"} {:db/id #edb/ref 17592186683012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8ec46ef-2302-5566-a10d-87d41945d32a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186683040}] :answer-field/correct {:answer/id #uuid "a8ec46ef-2302-5566-a10d-87d41945d32a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186683040} :answer-field/id #uuid "c3a233d5-0ce0-5283-b70a-6b9c2aba4968" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186683044}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "16b53daa-14dc-5da8-8f94-7fbd5cede039" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{2} \\frac{2}{x^{2} + 4}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 4=4\\left(1+(\\frac{x}{2})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{2}\\cdot 2=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=2&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{2} \\frac{2}{x^{2} + 4}\\,\\mathrm{d}x\\\\&=\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}=\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{4}.\n$$"} {:db/id #edb/ref 17592186683014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce6ab13f-a216-56fc-a883-05600bc1089d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186683045}] :answer-field/correct {:answer/id #uuid "ce6ab13f-a216-56fc-a883-05600bc1089d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186683045} :answer-field/id #uuid "e60662bb-f35d-56ab-b75e-dfe60a001cb1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186683050}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1d222a92-2853-555f-98ca-efa744b18673" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-3}^{3} \\frac{3}{x^{2} + 9}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 9=9\\left(1+(\\frac{x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{3}\\cdot 3=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-3&\\Longrightarrow u=-1\\\\x=3&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-3}^{3} \\frac{3}{x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\int_{-1}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{1}=\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{2}.\n$$"} {:db/id #edb/ref 17592186683019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae5562fe-2a81-53c6-b681-260e6379d6d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186683041}] :answer-field/correct {:answer/id #uuid "ae5562fe-2a81-53c6-b681-260e6379d6d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186683041} :answer-field/id #uuid "f32f759b-4ff7-503d-828c-ae04505e7fdc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186683054}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2eaeaf04-a4a9-59d2-b4f7-87b6c47b8d9c" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{2} \\frac{4}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{16 - x^{2}}=4\\sqrt{1-(\\frac{x}{4})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $1\\cdot 4=4$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=2&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{2} \\frac{4}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\\\\&=4\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n4\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=4\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2 \\pi}{3}.\n$$"} {:db/id #edb/ref 17592186683020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f931b18d-a427-5e6c-8717-6fc9f2a68ff2" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186683056}] :answer-field/correct {:answer/id #uuid "f931b18d-a427-5e6c-8717-6fc9f2a68ff2" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186683056} :answer-field/id #uuid 