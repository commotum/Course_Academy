}{9})(- \\frac{9 \\sqrt{10}}{20})=- \\frac{1}{2} \\\\ x=\\frac{9 \\sqrt{5}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{9})(\\frac{9 \\sqrt{5}}{10})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{8}{\\sqrt{81 - 10 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{9}\\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{9})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{9}(\\frac{9 \\sqrt{10}}{10})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{4 \\sqrt{10}}{5}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{4 \\sqrt{10}}{5}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{10} \\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "420aac5e-015a-5dcf-96c2-aa80b9e6f176" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{7} \\pi}{140}" :db/id #edb/ref 17592186677087} {:answer/id #uuid "8e4169e3-9262-5493-b315-2902bc48450b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{7} \\pi}{500}" :db/id #edb/ref 17592186677118} {:answer/id #uuid "8f897da0-c7c7-5ad7-bec0-4f2425e87fbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{7} \\pi}{140}" :db/id #edb/ref 17592186677119} {:answer/id #uuid "c74a561c-863a-573f-9341-b53ede55d47d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{28}" :db/id #edb/ref 17592186677154} {:answer/id #uuid "f5aeea5c-ba27-5f18-85d7-6f9fc18ce357" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7} \\pi}{420}" :db/id #edb/ref 17592186677193}] :answer-field/correct {:answer/id #uuid "8f897da0-c7c7-5ad7-bec0-4f2425e87fbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{7} \\pi}{140}" :db/id #edb/ref 17592186677119} :answer-field/id #uuid "76e776ca-23c1-5993-b4b0-77109e7c5373" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677106}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{9}{7 x^{2} + 25}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n7 x^{2} + 25=25(1+(\\frac{7}{25})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{7} x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{7}}{5},\\qquad \\mathrm{d}x=(\\frac{5 \\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{5 \\sqrt{21}}{21}&\\Longrightarrow u=(\\frac{\\sqrt{7}}{5})(\\frac{5 \\sqrt{21}}{21})=\\frac{\\sqrt{3}}{3} \\\\ x=\\frac{5 \\sqrt{7}}{7}&\\Longrightarrow u=(\\frac{\\sqrt{7}}{5})(\\frac{5 \\sqrt{7}}{7})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{9}{7 x^{2} + 25}\\,\\mathrm{d}x \\\\  &= \\frac{9}{25}\\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{1}{1+(\\frac{\\sqrt{7} x}{5})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{9}{25}(\\frac{5 \\sqrt{7}}{7})\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}[\\operatorname{arctan}{\\left(u \\right)}]_{\\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{9 \\sqrt{7}}{35}(\\operatorname{arctan}(1)-\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{9 \\sqrt{7}}{35}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{7} \\pi}{140}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186677167}] :answer-field/correct {:answer/id #uuid "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186677167} :answer-field/id #uuid "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677138}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\sqrt{5}} \\frac{4}{\\sqrt{10 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{10 - x^{2}}=\\sqrt{10(1-(\\frac{1}{10})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{10}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{10},\\qquad \\mathrm{d}x=(\\sqrt{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(0)=0 \\\\ x=\\sqrt{5}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(\\sqrt{5})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\sqrt{5}} \\frac{4}{\\sqrt{10 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2 \\sqrt{10}}{5}\\int_{0}^{\\sqrt{5}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{10})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2 \\sqrt{10}}{5}(\\sqrt{10})\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 4\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 4[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{2}}{2}} \\\\  &= 4(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 4((\\frac{\\pi}{4})-(0)) \\\\  &= \\pi\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\sqrt{3} \\pi}{54}" :db/id #edb/ref 17592186677200}] :answer-field/correct {:answer/id #uuid "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\sqrt{3} \\pi}{54}" :db/id #edb/ref 17592186677200} :answer-field/id #uuid "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677168}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- 3 \\sqrt{3}}^{9} \\frac{6}{3 x^{2} + 81}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n3 x^{2} + 81=81(1+(\\frac{1}{27})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{3} x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{3}}{9},\\qquad \\mathrm{d}x=(3 \\sqrt{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- 3 \\sqrt{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{9})(- 3 \\sqrt{3})=-1 \\\\ x=9&\\Longrightarrow u=(\\frac{\\sqrt{3}}{9})(9)=\\sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- 3 \\sqrt{3}}^{9} \\frac{6}{3 x^{2} + 81}\\,\\mathrm{d}x \\\\  &= \\frac{2}{27}\\int_{- 3 \\sqrt{3}}^{9} \\frac{1}{1+(\\frac{\\sqrt{3} x}{9})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{2}{27}(3 \\sqrt{3})\\int_{-1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{3}}{9}\\int_{-1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{3}}{9}[\\operatorname{arctan}{\\left(u \\right)}]_{-1}^{\\sqrt{3}} \\\\  &= \\frac{2 \\sqrt{3}}{9}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(-1)) \\\\  &= \\frac{2 \\sqrt{3}}{9}((\\frac{\\pi}{3})-(- \\frac{\\pi}{4})) \\\\  &= \\frac{7 \\sqrt{3} \\pi}{54}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ac5bda-af2a-567a-972e-4eaed79b2cb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{100}" :db/id #edb/ref 17592186677044} {:answer/id #uuid "a63b8559-c82f-598b-a90b-350bd66e1c91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{20}" :db/id #edb/ref 17592186677129} {:answer/id #uuid "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186677133} {:answer/id #uuid "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}{\\left(\\frac{\\sqrt{2}}{2} \\right)}" :db/id #edb/ref 17592186677135} {:answer/id #uuid "daced14b-3627-5e01-8e59-8270db580180" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{4}" :db/id #edb/ref 17592186677172}] :answer-field/correct {:answer/id #uuid "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186677133} :answer-field/id #uuid "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677150}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "682222db-91f6-5331-b0ae-5361f8ce335b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{25 - x^{2}}=\\sqrt{25(1-(\\frac{1}{25})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{5},\\qquad \\mathrm{d}x=(5)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{5})(0)=0 \\\\ x=\\frac{5 \\sqrt{2}}{2}&\\Longrightarrow u=(\\frac{1}{5})(\\frac{5 \\sqrt{2}}{2})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{5}\\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{5})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{5}(5)\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{2}}{2}} \\\\  &= 1(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 1((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35733d7a-08b3-5eb1-b623-b285be791351" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\pi}{32}" :db/id #edb/ref 17592186677076} {:answer/id #uuid "bcc765d0-19d2-52d4-8cae-2b1ce27c3960" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{32}" :db/id #edb/ref 17592186677149} {:answer/id #uuid "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\pi}{32}" :db/id #edb/ref 17592186677159} {:answer/id #uuid "cbd0e262-e697-5db3-b587-5ac8bdb7b7be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\pi}{256}" :db/id #edb/ref 17592186677160} {:answer/id #uuid "dfafb482-d854-543e-90ed-7b48a0404ff0" :answer/type {:db/ident :answer.type/math} :answer/value "18 \\pi" :db/id #edb/ref 17592186677178}] :answer-field/correct {:answer/id #uuid "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\pi}{32}" :db/id #edb/ref 17592186677159} :answer-field/id #uuid "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677062}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{8}} \\frac{9}{64 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(8)(0)=0 \\\\ x=\\frac{1}{8}&\\Longrightarrow u=(8)(\\frac{1}{8})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{8}} \\frac{9}{64 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 9\\int_{0}^{\\frac{1}{8}} \\frac{1}{1+(8 x)^{2}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{8})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{8}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{8}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{9}{8}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{9}{8}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{9 \\pi}{32}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b98030-d11f-5f99-938a-5366d17d6d1d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186677052} {:answer/id #uuid "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186677069} {:answer/id #uuid "356b89e1-d725-57e8-b073-eb5591c2bcc3" :answer/type {:db/ident :answer.type/math} :answer/value "8 \\operatorname{arctan}{\\left(3 \\right)}" :db/id #edb/ref 17592186677075} {:answer/id #uuid "9d065717-78b1-5e32-873d-9ec56ea739b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(\\frac{1}{3} \\right)}}{3}" :db/id #edb/ref 175