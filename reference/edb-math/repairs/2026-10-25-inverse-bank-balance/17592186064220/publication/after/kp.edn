}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed763b1-4372-543e-8ee2-dcc84046626c" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\pi}{18}" :db/id #edb/ref 17592186677072} {:answer/id #uuid "755143cd-5ed9-5e1b-8d5b-5cda84267c28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{6}" :db/id #edb/ref 17592186677104} {:answer/id #uuid "e43f83e7-80cb-56df-b32b-9031973aa5a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{3}" :db/id #edb/ref 17592186677186} {:answer/id #uuid "ea5e3f07-99ff-540a-9cb5-d65bfdb3deaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{18}" :db/id #edb/ref 17592186677189} {:answer/id #uuid "ff22cf23-2c43-5d63-aaa0-e07be7fbd843" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{54}" :db/id #edb/ref 17592186677201}] :answer-field/correct {:answer/id #uuid "ea5e3f07-99ff-540a-9cb5-d65bfdb3deaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{18}" :db/id #edb/ref 17592186677189} :answer-field/id #uuid "b6d7a1bb-2b22-5fcb-95fb-9f44edd34200" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677144}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8d27d9cf-cb74-5840-b365-e7db0c04fb39" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{6}} \\frac{7}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=3 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3,\\qquad \\mathrm{d}x=(\\frac{1}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(3)(0)=0 \\\\ x=\\frac{1}{6}&\\Longrightarrow u=(3)(\\frac{1}{6})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{6}} \\frac{7}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x \\\\  &= 7\\int_{0}^{\\frac{1}{6}} \\frac{1}{\\sqrt{1-(3 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 7(\\frac{1}{3})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{7}{3}\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{7}{3}[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{7}{3}(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{7}{3}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{7 \\pi}{18}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e664b4d-38a8-5ddc-9c88-53307ae3c5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{15}" :db/id #edb/ref 17592186677085}] :answer-field/correct {:answer/id #uuid "3e664b4d-38a8-5ddc-9c88-53307ae3c5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{15}" :db/id #edb/ref 17592186677085} :answer-field/id #uuid "aa4440e7-6f62-5402-bbe0-f2650309cdb7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677134}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a2d73b9e-ded5-5263-8f8f-f603b91d7e83" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{10}} \\frac{4}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Use the linear substitution $u=5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=5,\\qquad \\mathrm{d}x=(\\frac{1}{5})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(5)(0)=0 \\\\ x=\\frac{1}{10}&\\Longrightarrow u=(5)(\\frac{1}{10})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{10}} \\frac{4}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x \\\\  &= 4\\int_{0}^{\\frac{1}{10}} \\frac{1}{\\sqrt{1-(5 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{1}{5})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{5}\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{4}{5}(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{4}{5}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{2 \\pi}{15}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd1c91ab-c520-5c89-9666-8520331af451" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{3}" :db/id #edb/ref 17592186677175}] :answer-field/correct {:answer/id #uuid "dd1c91ab-c520-5c89-9666-8520331af451" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{3}" :db/id #edb/ref 17592186677175} :answer-field/id #uuid "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677157}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{7}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=\\sqrt{9(1-(\\frac{1}{9})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{3},\\qquad \\mathrm{d}x=(3)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{3})(0)=0 \\\\ x=\\frac{3 \\sqrt{3}}{2}&\\Longrightarrow u=(\\frac{1}{3})(\\frac{3 \\sqrt{3}}{2})=\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{7}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{3}\\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{3})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{3}(3)\\int_{0}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 7\\int_{0}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 7[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{3}}{2}} \\\\  &= 7(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 7((\\frac{\\pi}{3})-(0)) \\\\  &= \\frac{7 \\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5802f692-c0cd-5a7e-897b-1371d250ef1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{24}" :db/id #edb/ref 17592186677093} {:answer/id #uuid "80d3531a-3427-5af4-ba44-51c4c3208105" :answer/type {:db/ident :answer.type/math} :answer/value "12 \\pi" :db/id #edb/ref 17592186677111} {:answer/id #uuid "c7a337d6-4b80-5385-bb22-efe