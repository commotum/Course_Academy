186050489} {:db/id #edb/ref 17592186050898}] :topic/title "Calculating Definite Integrals Using Substitution"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186693300 :question-generator/id #uuid "1e091910-d315-52ae-aea4-c1d5d19b78c4" :question-generator/script "generators/9a/9a5879c86337cafcfacf5bafdbe55a92372948eb8ac2d81a11d85f3216ce3796/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186064544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "400b63a0-4683-5a21-897e-9f816d13ecf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186285387} {:answer/id #uuid "72dc0745-c711-5555-b758-8857ea08db0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186285845} {:answer/id #uuid "7e97b556-fb4d-50ab-8db3-611fbf05e7d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186285953} {:answer/id #uuid "85326801-a074-5ff0-bebe-99064aa9feb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186286012} {:answer/id #uuid "b4f53bfe-9dac-5f4c-b151-f462bed9f133" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186286432}] :answer-field/correct {:answer/id #uuid "72dc0745-c711-5555-b758-8857ea08db0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186285845} :answer-field/id #uuid "a839d901-bb07-5422-9156-0f0bc9d6308d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287488}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "aa336cf9-b3b8-5d4a-a543-f9cee172da34" :question/math-academy-id "q-19394" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1}\\frac{2}{\\sqrt{2-{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{\\sqrt{2-{x}^{2}}}\\,\\text{d}x & =2{\\int }_{0}^{1}\\frac{1}{\\sqrt{2\\cdot (1-{x}^{2}/2)}}\\,\\text{d}x \\\\  & =\\frac{2}{\\sqrt{2}}{\\int }_{0}^{1}\\frac{1}{\\sqrt{1-{x}^{2}/2}}\\,\\text{d}x \\\\  & =\\sqrt{2}{\\int }_{0}^{1}\\frac{1}{\\sqrt{1-(x/\\sqrt{2})^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{\\sqrt{2}}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{2}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{2}}\\,⟹\\,\\text{d}x=\\sqrt{2}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{2}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{\\sqrt{2-{x}^{2}}}\\,\\text{d}x & =\\sqrt{2}{\\int }_{0}^{1}\\frac{1}{\\sqrt{1-(x/\\sqrt{2})^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{2}{\\int }_{0}^{\\sqrt{2}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (\\sqrt{2}\\,\\text{d}u) \\\\  & =2{\\int }_{0}^{\\sqrt{2}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =2\\operatorname{arcsin}⁡u{|}_{0}^{\\sqrt{2}/2} \\\\  & =2\\operatorname{arcsin}⁡\\left(\\frac{\\sqrt{2}}{2}\\right)-2\\operatorname{arcsin}⁡(0) \\\\  & =2\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3caebccd-a111-5c41-885b-601d0e3537ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\operatorname{arctan}⁡(14)" :db/id #edb/ref 17592186285359} {:answer/id #uuid "5c49b8ca-6a4c-5d5b-bee0-678ddd9d003c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}\\operatorname{arctan}⁡(7)" :db/id #edb/ref 17592186285633} {:answer/id #uuid "77e0a940-8e6f-54a7-9506-301d4949f5ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\operatorname{arctan}⁡(7)" :db/id #edb/ref 17592186285904} {:answer/id #uuid "c96c9e76-bbaf-5ac6-a64e-a08681842df9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}\\operatorname{arctan}⁡(14)" :db/id #edb/ref 17592186286625} {:answer/id #uuid "eda35d92-71e9-5870-9644-e45103f5e6c2" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{arctan}⁡(14)" :db/id #edb/ref 17592186286967}] :answer-field/correct {:answer/id #uuid "c96c9e76-bbaf-5ac6-a64e-a08681842df9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}\\operatorname{arctan}⁡(14)" :db/id #edb/ref 17592186286625} :answer-field/id #uuid "23ae6c57-6433-571b-8f19-8245bed72d97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287223}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4167c2cd-a204-5a1b-9ee4-1fca54336ae6" :question/math-academy-id "q-19397" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{7}\\frac{9}{2+8{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{7}\\frac{9}{2+8{x}^{2}}\\,\\text{d}x=\\frac{9}{2}{\\int }_{0}^{7}\\frac{1}{1+4{x}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $7$ |\n| --- | --- | --- |\n| $u$ | $0$ | $14$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}\\frac{9}{2+8{x}^{2}}\\,\\text{d}x & =\\frac{9}{2}{\\int }_{0}^{7}\\frac{1}{1+(2x)^{2}}\\,\\text{d}x \\\\  & =\\frac{9}{2}{\\int }_{0}^{14}\\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{9}{4}{\\int }_{0}^{14}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{9}{4}\\operatorname{arctan}⁡u{|}_{0}^{14} \\\\  & =\\frac{9}{4}\\operatorname{arctan}⁡(14)-\\frac{9}{4}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{9}{4}\\operatorname{arctan}⁡(14)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "243323f6-ad70-573c-a08a-406469d3a0ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186247740} {:answer/id #uuid "2f7538ae-df96-5bd6-89c4-eb9b39dfc0b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186247852} {:answer/id #uuid "5bf8e15f-3174-57fb-b8e4-5d360ff846f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186248257} {:answer/id #uuid "9f8775a6-08c9-5e68-8ded-0ebea2805076" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186248846} {:answer/id #uuid "a3358706-6bfa-540b-8aac-27669d842b97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186248885}] :answer-field/correct {:answer/id #uuid "5bf8e15f-3174-57fb-b8e4-5d360ff846f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186248257} :answer-field/id #uuid "6296fb51-a261-5315-98e2-bafc87eb4fd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249846}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b4d360a8-fe79-5362-9972-fed2a1994303" :question/math-academy-id "q-114074" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1/8}\\frac{2}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{1/8}\\frac{2}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x=2{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $(4x)^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{1/8}\\frac{2}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x & =2{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{4}\\text{d}u) \\\\  & =\\frac{1}{2}{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =\\frac{1}{2}(\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{arcsin}⁡(0)) \\\\  & =\\frac{1}{2}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{12}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bd84a82-8cbc-585f-8bbe-ce19fdb09a44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186247954} {:answer/id #uuid "47871075-deb3-513b-8a8e-3639234f622c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186248060} {:answer/id #uuid "983ebb92-bd83-5ed1-a0f3-8fe2c8c188ea" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186248782} {:answer/id #uuid "a7c31917-04d7-582e-b1d4-e26865d402a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186248917} {:answer/id #uuid "af0b67fe-7271-56c8-8367-495b25ff2f54" :answer/type {:db/ident :answer.type/math} :answer/value "8\\pi " :db/id #edb/ref 17592186248992}] :answer-field/correct {:answer/id #uuid "a7c31917-04d7-582e-b1d4-e26865d402a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186248917} :answer-field/id #uuid "25f9281c-e5d7-5f72-ac5c-0b25153c48f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249738}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d8425d47-32c7-547c-ab87-ac1c6071e1e8" :question/math-academy-id "q-114078" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{2}\\frac{1}{\\sqrt{8-{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{\\sqrt{8-{x}^{2}}}\\,\\text{d}x & ={\\int }_{0}^{2}\\frac{1}{\\sqrt{8\\cdot (1-{x}^{2}/8)}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{8}}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-{x}^{2}/8}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{8}}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/\\sqrt{8})^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{\\sqrt{8}}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{8}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{8}}\\,⟹\\,\\text{d}x=\\sqrt{8}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{2}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{\\sqrt{8-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{\\sqrt{8}}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/\\sqrt{8})^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{8}}{\\int }_{0}^{\\sqrt{2}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (\\sqrt{8}\\,\\text{d}u) \\\\  & ={\\int }_{0}^{\\sqrt{2}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u{|}_{0}^{\\sqrt{2}/2} \\\\  & =\\operatorname{arcsin}⁡\\left(\\frac{\\sqrt{2}}{2}\\right)-\\operatorname{arcsin}⁡(0) \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012323fc-4e7b-5948-bd33-ac6535cdacea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186247423} {:answer/id #uuid "275108dc-ba21-516f-8c42-bd8bf8d71064" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186247772} {:answer/id #uuid "3ab5218b-e36e-59ff-8b03-f71a3f5c4374" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{24}" :db/id #edb/ref 17592186247944} {:answer/id #uuid "82b6c265-2f3d-5dbe-b622-87847517b9ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{8}" :db/id #edb/ref 17592186248580} {:answer/id #uuid "afcf5a5d-6b1c-5e07-b91a-41eca607a863" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186249002}] :answer-field/correct {:answer/id #uuid "afcf5a5d-6b1c-5e07-b91a-41eca607a863" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186249002} :answer-field/id #uuid "f5f84de4-1a81-5ce2-ac8e-5901c4a2a352" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250104}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c216ad6d-32f4-5235-ae6f-6f4e1e6db054" :question/math-academy-id "q-114080" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =8{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{4\\cdot (1-{x}^{2}/4)}}\\,\\text{d}x \\\\  & =\\frac{8}{2}{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-{x}^{2}/4}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{2}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =4{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{\\sqrt{3}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (2\\,\\text{d}u) \\\\  & =8{\\int }_{0}^{\\sqrt{3}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =8\\operatorname{arcsin}⁡u{|}_{0}^{\\sqrt{3}/2} \\\\  & =8(\\operatorname{arcsin}⁡\\left(\\frac{\\sqrt{3}}{2}\\right)-\\operatorname{arcsin}⁡(0)) \\\\  & =8(\\frac{\\pi }{3}-0) \\\\  & =\\frac{8\\pi }{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b573ef-1007-53ad-a1f4-f1bbb6a97f3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{9}" :db/id #edb/ref 17592186247434} {:answer/id #uuid "21345a50-5601-54ac-b6b8-8854f3bcf25d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{3}" :db/id #edb/ref 17592186247719} {:answer/id #uuid "21932059-2779-56bb-aff8-46d2133806aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186247722} {:answer/id #uuid "b2ca1c00-7abb-53af-b061-a218e5f95af2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\pi " :db/id #edb/ref 17592186249025} {:answer/id #uuid "fe379fad-f57a-50e1-ad28-7deffbfbf656" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{9}" :db/id #edb/ref 17592186249647}] :answer-field/correct {:answer/id #uuid "01b573ef-1007-53ad-a1f4-f1bbb6a97f3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{9}" :db/id #edb/ref 17592186247434} :answer-field/id #uuid "20529d1c-5c66-5379-87b8-bf5bcb3ca23c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249730}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d206bd2a-2b8b-589e-945a-46c1dd7ed6d1" :question/math-academy-id "q-114084" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2}{3\\cdot (1+{x}^{2}/3)}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}/3}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{\\sqrt{3}}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{3}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{3}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{1}{1+{u}^{2}}\\cdot (\\sqrt{3}\\,\\text{d}u) \\\\  & =\\frac{2\\sqrt{3}}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{2\\sqrt{3}}{3}\\operatorname{arctan}⁡u{|}_{0}^{\\sqrt{3}/3} \\\\  & =\\frac{2\\sqrt{3}}{3}(\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right)-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{2\\sqrt{3}}{3}\\cdot \\frac{\\pi }{6} \\\\  & =\\frac{\\sqrt{3}\\pi }{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07df5620-8117-5d74-b65a-568506c2ddda" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186284848} {:answer/id #uuid "4699fac1-5a8f-5b40-afed-7064158b1c33" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186285437} {:answer/id #uuid "9ce9442e-a29f-597e-b2de-7761a1d30d17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186286222} {:answer/id #uuid "a22f372f-9504-584b-bc3e-87c16eaabc46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186286274} {:answer/id #uuid "e584a0a9-3825-5a55-8fc4-911388ec2a92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186286888}] :answer-field/correct {:answer/id #uuid "a22f372f-9504-584b-bc3e-87c16eaabc46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186286274} :answer-field/id #uuid "2ff436e5-f03c-513f-b406-812caeb45b91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287249}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "25b26ce0-b29c-55b2-a912-d3113c434dd9" :question/math-academy-id "q-19393" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{2}\\frac{5}{\\sqrt{16-{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{5}{\\sqrt{16-{x}^{2}}}\\,\\text{d}x & =5{\\int }_{0}^{2}\\frac{1}{\\sqrt{16\\cdot (1-{x}^{2}/16)}}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-{x}^{2}/16}}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/4)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{4}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{5}{\\sqrt{16-{x}^{2}}}\\,\\text{d}x & =\\frac{5}{4}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/4)^{2}}}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (4\\,\\text{d}u) \\\\  & =5{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =5\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =5\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-5\\operatorname{arcsin}⁡(0) \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bbb1cae-6e39-530c-8350-eb936f667815" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\pi " :db/id #edb/ref 17592186284882} {:answer/id #uuid "5ee39338-b490-52d5-8051-37da3e5e957f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{3}" :db/id #edb/ref 17592186285657} {:answer/id #uuid "64faa062-9068-565a-bb31-39dbd6d07913" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186285705} {:answer/id #uuid "68959faf-15c8-528e-bc75-90d2d2a0e5cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{6}" :db/id #edb/ref 17592186285749} {:answer/id #uuid "f7445989-6f9b-5004-8c4b-e95fea2ee953" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\pi }{3}" :db/id #edb/ref 17592186287053}] :answer-field/correct {:answer/id #uuid "68959faf-15c8-528e-bc75-90d2d2a0e5cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{6}" :db/id #edb/ref 17592186285749} :answer-field/id #uuid "77436f8b-d0d6-52c6-99f0-ade76c2dfb27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287399}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "20d8d0f4-d57e-564e-be24-7116faf35cef" :question/math-academy-id "q-19395" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{-0.25}^{0.25}\\frac{3}{\\sqrt{3-12{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-0.25}^{0.25}\\frac{3}{\\sqrt{3-12{x}^{2}}}\\,\\text{d}x & =3{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{3\\cdot (1-4{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{3}{\\sqrt{3}}{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n  \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(2x)}^{2}.$   \n\nSo, let's substitute $u=2x.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-0.25$ | $0.25$ |\n| --- | --- | --- |\n| $u$ | $-0.5$ | $0.5$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-0.25}^{0.25}\\frac{3}{\\sqrt{3-12{x}^{2}}}\\,\\text{d}x & =\\sqrt{3}{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{-0.5}^{0.5}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{\\sqrt{3}}{2}{\\int }_{-0.5}^{0.5}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{\\sqrt{3}}{2}\\operatorname{arcsin}⁡u{|}_{-0.5}^{0.5} \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{arcsin}⁡(0.5)-\\operatorname{arcsin}⁡(-0.5)) \\\\  & =\\frac{\\sqrt{3}}{2}(\\frac{\\pi }{6}+\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\pi }{3} \\\\  & =\\frac{\\sqrt{3}\\pi }{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "331c449c-78bb-5f8b-9dcd-69e5f627c3c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186285253} {:answer/id #uuid "53cbca06-5dff-57fe-91ef-daa24c5147f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186285559} {:answer/id #uuid "7d34e51c-e8eb-58a3-86e7-2325ea4401f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186285940} {:answer/id #uuid "c0230150-a2bf-5bf4-a26a-c06c4bd66ae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186286545} {:answer/id #uuid "db135799-7845-5945-af89-06c54826a98a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186286784}] :answer-field/correct {:answer/id #uuid "c0230150-a2bf-5bf4-a26a-c06c4bd66ae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186286545} :answer-field/id #uuid "b6de2d23-7e6a-5191-bba5-d88af28f962e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287530}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0d25ee70-cfd4-55fa-9b35-c615d86700ba" :question/math-academy-id "q-19396" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1/5}\\frac{20}{3+75{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can write this integral as\n\n$$\n{\\int }_{0}^{1/5}\\frac{20}{3+75{x}^{2}}\\,\\text{d}x=\\frac{20}{3}{\\int }_{0}^{1/5}\\frac{1}{1+25{x}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/5}\\frac{20}{3+75{x}^{2}}\\,\\text{d}x & =\\frac{20}{3}{\\int }_{0}^{1/5}\\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\frac{20}{3}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{4}{3}\\operatorname{arctan}⁡u{|}_{0}^{1} \\\\  & =\\frac{4}{3}\\operatorname{arctan}⁡(1)-\\frac{4}{3}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{4}{3}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e406c8b4-fe2c-53cd-abdc-dc32a0608267" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186318327}] :answer-field/correct {:answer/id #uuid "e406c8b4-fe2c-53cd-abdc-dc32a0608267" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186318327} :answer-field/id #uuid "c443a9b7-8c24-5662-be21-7a311e519118" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318847}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0ba9633b-5871-51f9-8aee-a3691915151d" :question/math-academy-id "q-346451" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1/3}\\frac{2}{1+9{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/3}\\frac{2}{1+9{x}^{2}}\\,\\text{d}x & =2{\\int }_{0}^{1/3}\\frac{1}{1+(3x)^{2}}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{2}{3}\\operatorname{arctan}⁡u\\,{|}_{0}^{1} \\\\  & =\\frac{2}{3}(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{2}{3}(\\frac{\\pi }{4}-0) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a18383d3-63cd-5639-931d-a7a1c504ecad" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186318118} {:answer/id #uuid "eef5da2c-2eb9-5619-b5fc-8c0b83845f3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186527772}] :answer-field/correct {:answer/id #uuid "eef5da2c-2eb9-5619-b5fc-8c0b83845f3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186527772} :answer-field/id #uuid "d4db02f7-5977-595a-8560-ebd6520e3bc1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318876}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "684a7fc3-f685-5be8-90e1-52ef15ddd822" :question/math-academy-id "q-346458" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{5}\\frac{6}{\\sqrt{100-{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{5}\\frac{6}{\\sqrt{100-{x}^{2}}}\\,\\text{d}x & =6{\\int }_{0}^{5}\\frac{1}{\\sqrt{100\\cdot (1-{x}^{2}/100)}}\\,\\text{d}x \\\\  & =\\frac{6}{10}{\\int }_{0}^{5}\\frac{1}{\\sqrt{1-{x}^{2}/100}}\\,\\text{d}x \\\\  & =\\frac{3}{5}{\\int }_{0}^{5}\\frac{1}{\\sqrt{1-(x/10)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{10}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{10}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{10}\\,⟹\\,\\text{d}x=10\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $5$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{5}\\frac{6}{\\sqrt{100-{x}^{2}}}\\,\\text{d}x & =\\frac{3}{5}{\\int }_{0}^{5}\\frac{1}{\\sqrt{1-(x/10)^{2}}}\\,\\text{d}x \\\\  & =\\frac{3}{5}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 10\\,\\text{d}u \\\\  & =6{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =6\\operatorname{arcsin}⁡u\\,{|}_{0}^{1/2} \\\\  & =6\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-6\\operatorname{arcsin}⁡(0) \\\\  & =6\\cdot \\frac{\\pi }{6} \\\\  & =\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186320815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7bafaa-3cbb-533d-b844-15cf79b3fe34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi \\sqrt{5}}{12}" :db/id #edb/ref 17592186319530}] :answer-field/correct {:answer/id #uuid "2a7bafaa-3cbb-533d-b844-15cf79b3fe34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi \\sqrt{5}}{12}" :db/id #edb/ref 17592186319530} :answer-field/id #uuid "f18bc040-ce10-594f-bb02-f617ff11efb9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320672}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b439af01-6063-5a0d-8dfc-d235cf8c0346" :question/math-academy-id "q-351291" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x & =10{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{5(1-16{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{10}{\\sqrt{5}}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x \\\\  & =2\\sqrt{5}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine, \n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(4x)}^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x & =2\\sqrt{5}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x \\\\  & =2\\sqrt{5}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{2}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{2}\\operatorname{arcsin}⁡u\\,{|}_{0}^{1/2} \\\\  & =\\frac{\\sqrt{5}}{2}(\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{arcsin}⁡(0)) \\\\  & =\\frac{\\sqrt{5}}{2}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi \\sqrt{5}}{12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6d4b36a-43a6-585a-a12c-95ad82f0ab96" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186319889}] :answer-field/correct {:answer/id #uuid "a6d4b36a-43a6-585a-a12c-95ad82f0ab96" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186319889} :answer-field/id #uuid "1307c487-f3d6-5566-a68c-5623882801fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320199}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b0098fa7-60fc-5090-aeb3-d82239a596c1" :question/math-academy-id "q-351827" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x & =15{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{36\\cdot (1-{x}^{2}/36)}}\\,\\text{d}x \\\\  & =\\frac{15}{6}{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{1-{x}^{2}/36}}\\,\\text{d}x \\\\  & =\\frac{5}{2}{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/6)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{6}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{6}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{6}\\,⟹\\,\\text{d}x=6\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $3\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x & =\\frac{5}{2}{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/6)^{2}}}\\,\\text{d}x \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\sqrt{3}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 6\\,\\text{d}u \\\\  & =15{\\int }_{0}^{\\sqrt{3}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =15\\operatorname{arcsin}⁡u\\,{|}_{0}^{\\sqrt{3}/2} \\\\  & =15\\operatorname{arcsin}⁡\\left(\\frac{\\sqrt{3}}{2}\\right)-15\\operatorname{arcsin}⁡(0) \\\\  & =15\\cdot \\frac{\\pi }{3} \\\\  & =5\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186320917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4d6374a-a8f4-5012-ba14-79979bb09a1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{5}" :db/id #edb/ref 17592186319994} {:answer/id #uuid "1222c3a4-de2b-5ccf-879e-6d55aee4c8b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi\\sqrt{3}}{5}" :db/id #edb/ref 17592186537260}] :answer-field/correct {:answer/id #uuid "1222c3a4-de2b-5ccf-879e-6d55aee4c8b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi\\sqrt{3}}{5}" :db/id #edb/ref 17592186537260} :answer-field/id #uuid "d0e46496-0573-5f7f-b6a6-15d10b4e8306" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320599}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "88256796-f1d7-5511-b30e-ef033cdfdfae" :question/math-academy-id "q-351834" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-0.2}^{0.2}\\frac{3}{\\sqrt{3-75{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-0.2}^{0.2}\\frac{3}{\\sqrt{3-75{x}^{2}}}\\,\\text{d}x & =3{\\int }_{-0.2}^{0.2}\\frac{1}{\\sqrt{3\\cdot (1-25{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{3}{\\sqrt{3}}{\\int }_{-0.2}^{0.2}\\frac{1}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{-0.2}^{0.2}\\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n  \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(5x)}^{2}.$   \n\nSo, let's substitute $u=5x.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-0.2$ | $0.2$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-0.2}^{0.2}\\frac{3}{\\sqrt{3-75{x}^{2}}}\\,\\text{d}x & =\\sqrt{3}{\\int }_{-0.2}^{0.2}\\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{-1}^{1}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{\\sqrt{3}}{5}{\\int }_{-1}^{1}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{\\sqrt{3}}{5}\\,\\operatorname{arcsin}⁡u{|}_{-1}^{1} \\\\  & =\\frac{\\sqrt{3}}{5}(\\operatorname{arcsin}⁡(1)-\\operatorname{arcsin}⁡(-1)) \\\\  & =\\frac{\\sqrt{3}}{5}(\\frac{\\pi }{2}+\\frac{\\pi }{2}) \\\\  & =\\frac{\\sqrt{3}\\,\\pi }{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a220c465-cd23-556a-b6f2-70e7e4ee705c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{18}" :db/id #edb/ref 17592186319874}] :answer-field/correct {:answer/id #uuid "a220c465-cd23-556a-b6f2-70e7e4ee705c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{18}" :db/id #edb/ref 17592186319874} :answer-field/id #uuid "3f065e5b-1a3e-5164-964f-ea2efbce87b8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320306}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8a43d62d-e653-5802-9217-17e3b89ace8c" :question/math-academy-id "q-351835" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x=2{\\int }_{0}^{1/12}\\frac{1}{\\sqrt{1-(6x)^{2}}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{12}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x & =2{\\int }_{0}^{1/12}\\frac{1}{\\sqrt{1-(6x)^{2}}}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{3}{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{1}{3}\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =\\frac{1}{3}(\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{arcsin}⁡(0)) \\\\  & =\\frac{1}{3}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{18}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ef55d3a-1d64-5e75-a936-57964a2c5268" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186319675}] :answer-field/correct {:answer/id #uuid "5ef55d3a-1d64-5e75-a936-57964a2c5268" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186319675} :answer-field/id #uuid "c611600a-1f7e-5aff-a691-ea5100dd312b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320579} {:answer-field/choices [{:answer/id #uuid "a866bed5-d733-533a-9199-2b822335e2cd" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186319897}] :answer-field/correct {:answer/id #uuid "a866bed5-d733-533a-9199-2b822335e2cd" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186319897} :answer-field/id #uuid "cf733acb-7ff6-5434-afab-1202dfb73dee" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320598}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "474d3d58-1cc2-50c1-8314-228946c22d89" :question/math-academy-id "q-351839" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{4}\\frac{12}{3+27{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}\n$\\operatorname{arctan}⁡($\n{{field-2}}$)$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{4}\\frac{12}{3+27{x}^{2}}\\,\\text{d}x=4{\\int }_{0}^{4}\\frac{1}{1+9{x}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $12$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}\\frac{12}{3+27{x}^{2}}\\,\\text{d}x & =4{\\int }_{0}^{4}\\frac{1}{1+(3x)^{2}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{12}\\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{4}{3}{\\int }_{0}^{12}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{4}{3}\\operatorname{arctan}⁡u{|}_{0}^{12} \\\\  & =\\frac{4}{3}\\operatorname{arctan}⁡(12)-\\frac{4}{3}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{4}{3}\\,arctan\\,(12)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e28a0da-0d28-58b0-9ea9-a556621c9cc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186319579}] :answer-field/correct {:answer/id #uuid "3e28a0da-0d28-58b0-9ea9-a556621c9cc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186319579} :answer-field/id #uuid "f17d058d-f41c-502a-aa59-824f88279a31" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320671}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6c01a93a-0fc6-5d70-b6e3-096c747b914e" :question/math-academy-id "q-351855" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{2}\\frac{1}{\\sqrt{12-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡(\n$$\n{{field-1}}$)$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{\\sqrt{12-{x}^{2}}}\\,\\text{d}x & ={\\int }_{0}^{2}\\frac{1}{\\sqrt{12\\cdot (1-{x}^{2}/12)}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{12}}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-{x}^{2}/12}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{12}}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/\\sqrt{12})^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{\\sqrt{12}}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{12}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{12}}\\,⟹\\,\\text{d}x=\\sqrt{12}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{\\sqrt{3}}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{\\sqrt{12-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{\\sqrt{12}}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/\\sqrt{12})^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{12}}{\\int }_{0}^{1/\\sqrt{3}}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (\\sqrt{12}\\,\\text{d}u) \\\\  & ={\\int }_{0}^{1/\\sqrt{3}}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u{|}_{0}^{1/\\sqrt{3}} \\\\  & =\\operatorname{arcsin}⁡\\left(\\frac{1}{\\sqrt{3}}\\right)-\\operatorname{arcsin}⁡(0) \\\\  & =\\operatorname{arcsin}⁡\\left(\\frac{1}{\\sqrt{3}}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d0c2f0-e1ef-5f9d-b277-1d69053a1f8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186330265} {:answer/id #uuid "5d04e998-1dc4-5619-8be2-aa1e5c1b7c5b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186330779} {:answer/id #uuid "866ac174-f329-56ce-b375-426c38e8089c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{1}{2}\\right)" :db/id #edb/ref 17592186331143} {:answer/id #uuid "a72e2a87-1718-5692-ae75-612ad60536bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186331438} {:answer/id #uuid "d944c1b0-1445-5a57-b346-1c4580f6e918" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186331877}] :answer-field/correct {:answer/id #uuid "a72e2a87-1718-5692-ae75-612ad60536bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186331438} :answer-field/id #uuid "7066a7e5-a4e7-571e-8102-812757ff24f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332406}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bf21744c-e558-571b-b3ed-9b3f13019f23" :question/math-academy-id "q-49538" :question/problem "What is the value of $$\n\\displaystyle {\\int }_{0}^{1}\\frac{1}{1+4{x}^{2}}\\,\\text{d}x\\,?\n$$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{1}\\frac{1}{1+4{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{\\text{d}x}{1+(2x)^{2}} \\\\  & ={\\int }_{0}^{2}\\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u{|}_{0}^{2} \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(2)-\\frac{1}{2}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(2)\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e86a4b-cc4c-5a6f-aaf3-ef2234d941ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{2}" :db/id #edb/ref 17592186330588} {:answer/id #uuid "569e6b60-bf68-55c0-a58d-f5683e2d1476" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186330724} {:answer/id #uuid "87600d1e-7d95-5096-a855-c3bc9ca0e904" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186331159} {:answer/id #uuid "9e6b1507-21a9-5241-8a35-d41f437e8d29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186331368} {:answer/id #uuid "b73d0144-5e6d-5adf-89c2-88b202a8b0e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186331568}] :answer-field/correct {:answer/id #uuid "b73d0144-5e6d-5adf-89c2-88b202a8b0e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186331568} :answer-field/id #uuid "ece6c44b-e4c3-57ea-8f7c-8273c4e5c5c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332617}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "edefe020-e961-5a43-95be-73f3210a7870" :question/math-academy-id "q-49546" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{-5/2}^{5/2}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}}.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-5/2}^{5/2}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}}\\, & ={\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{25\\cdot (1-{x}^{2}/25)}}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{1-{x}^{2}/25}}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{5}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-\\frac{5}{2}$ | $\\frac{5}{2}$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{-5/2}^{5/2}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}} & =\\frac{1}{5}{\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (5\\,\\text{d}u) \\\\  & ={\\int }_{-1/2}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{arcsin}⁡\\left(-\\frac{1}{2}\\right) \\\\  & =\\frac{\\pi }{6}+\\frac{\\pi }{6} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186368428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65f4d436-59f3-5763-bcdc-b3dd57872260" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186368430}] :answer-field/correct {:answer/id #uuid "65f4d436-59f3-5763-bcdc-b3dd57872260" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186368430} :answer-field/id #uuid "d6eaf7b2-0903-5d1f-bf6c-e8f7966021aa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368429} {:answer-field/choices [{:answer/id #uuid "29fd1abb-98ff-5074-9886-b94701e8a3c3" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368432}] :answer-field/correct {:answer/id #uuid "29fd1abb-98ff-5074-9886-b94701e8a3c3" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368432} :answer-field/id #uuid "ef16f665-49b9-5951-8bf5-581178032400" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368431}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3aa951d0-f5d2-580d-8cda-935baa717731" :question/math-academy-id "q-351850" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{25}\\frac{1}{25+{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}\n$\\operatorname{arctan}⁡($\n{{field-2}}$)$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{25}\\frac{1}{25+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{25}\\frac{1}{25\\cdot (1+{x}^{2}/25)}\\,\\text{d}x \\\\  & =\\frac{1}{25}{\\int }_{0}^{25}\\frac{1}{1+{x}^{2}/25}\\,\\text{d}x \\\\  & =\\frac{1}{25}{\\int }_{0}^{25}\\frac{1}{1+(x/5)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{5}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $25$ |\n| --- | --- | --- |\n| $u$ | $0$ | $5$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{25}\\frac{1}{25+{x}^{2}}\\,\\text{d}x & =\\frac{1}{25}{\\int }_{0}^{25}\\frac{1}{1+(x/5)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{25}{\\int }_{0}^{5}\\frac{1}{1+{u}^{2}}\\cdot (5\\,\\text{d}u) \\\\  & =\\frac{1}{5}{\\int }_{0}^{5}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u{|}_{0}^{5} \\\\  & =\\frac{1}{5}(\\operatorname{arctan}⁡(5)-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{1}{5}\\,arctan\\,(5)\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186377538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d90c6aca-5f52-581d-b9b7-53525c39db0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186377540} {:answer/id #uuid "35bc1324-3515-5f3b-b9da-7c903cdfb324" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{6}" :db/id #edb/ref 17592186427994}] :answer-field/correct {:answer/id #uuid "35bc1324-3515-5f3b-b9da-7c903cdfb324" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{6}" :db/id #edb/ref 17592186427994} :answer-field/id #uuid "8d0f7cff-e86b-56b3-9a00-cbb02d98343e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377539}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4068a5d2-2d7d-5115-9e90-ed45feea5f4e" :question/math-academy-id "q-351845" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{3}\\frac{10}{9+{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{10}{9+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{3}\\frac{10}{9\\cdot (1+{x}^{2}/9)}\\,\\text{d}x \\\\  & =\\frac{10}{9}{\\int }_{0}^{3}\\frac{1}{1+{x}^{2}/9}\\,\\text{d}x \\\\  & =\\frac{10}{9}{\\int }_{0}^{3}\\frac{1}{1+(x/3)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{3}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{10}{9+{x}^{2}}\\,\\text{d}x & =\\frac{10}{9}{\\int }_{0}^{3}\\frac{1}{1+(x/3)^{2}}\\,\\text{d}x \\\\  & =\\frac{10}{9}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{10}{3}{\\int }_{0}^{1}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{10}{3}\\operatorname{arctan}⁡u{|}_{0}^{1} \\\\  & =\\frac{10}{3}\\operatorname{arctan}⁡(1)-\\frac{10}{3}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{10}{3}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186428007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15391250-e023-5a04-9057-9658fe4de707" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186427993} {:answer/id #uuid "83a4d996-c213-5d67-946a-4cd6fe97edb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186427998} {:answer/id #uuid "abc0b7d1-6dfb-5790-a262-2aa331de3a0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186427999} {:answer/id #uuid "bb2aeebc-c3cc-5f32-bec9-7d9027991243" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186428000} {:answer/id #uuid "ea5fd737-b612-553b-8e19-91de7f399fb5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186428002}] :answer-field/correct {:answer/id #uuid "15391250-e023-5a04-9057-9658fe4de707" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186427993} :answer-field/id #uuid "ae824470-993a-5443-bdc9-a07993674d20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186428005}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bacbcea3-6ad6-5840-9bf7-1e8371e0974d" :question/math-academy-id "q-114075" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{3/2}\\frac{3}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3/2}\\frac{3}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =3{\\int }_{0}^{3/2}\\frac{1}{\\sqrt{9\\cdot (1-{x}^{2}/9)}}\\,\\text{d}x \\\\  & =3\\cdot \\frac{1}{3}{\\int }_{0}^{3/2}\\frac{1}{\\sqrt{1-{x}^{2}/9}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{3/2}\\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n  \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{3}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{3}{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3/2}\\frac{3}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & ={\\int }_{0}^{3/2}\\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =3{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =3\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =3(\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-\\operatorname{arcsin}⁡(0)) \\\\  & =3(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b1168a-ec72-53fd-aa75-2d246631fb21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186537232} {:answer/id #uuid "0d190ad0-5d86-58ee-99e2-6b1dcbd8e20d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{20}" :db/id #edb/ref 17592186537250} {:answer/id #uuid "7f9a665e-71e9-5ec8-bf10-4366e938cdb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186537477} {:answer/id #uuid "b06e5be7-dbe2-5334-99a2-daeab5470c11" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{5}" :db/id #edb/ref 17592186537565} {:answer/id #uuid "c764df4f-a1d7-5e04-a973-c2800addafd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186537616}] :answer-field/correct {:answer/id #uuid "0d190ad0-5d86-58ee-99e2-6b1dcbd8e20d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{20}" :db/id #edb/ref 17592186537250} :answer-field/id #uuid "5596b996-55c7-584d-a670-904b75102451" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537786}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "affed96b-3c3d-54a9-a279-f8432cb1a012" :question/math-academy-id "q-114073" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1/2}\\frac{2}{5+20{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can write this integral as\n\n$$\n{\\int }_{0}^{1/2}\\frac{2}{5+20{x}^{2}}\\,\\text{d}x=\\frac{2}{5}{\\int }_{0}^{1/2}\\frac{1}{1+4{x}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}\\frac{2}{5+20{x}^{2}}\\,\\text{d}x & =\\frac{2}{5}{\\int }_{0}^{1/2}\\frac{1}{1+(2x)^{2}}\\,\\text{d}x \\\\  & =\\frac{2}{5}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{5}{\\int }_{0}^{1}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u{|}_{0}^{1} \\\\  & =\\frac{1}{5}(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{1}{5}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{20}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b5a38d2-5ac3-59e4-b944-d3d0d9cc05e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arcsin}⁡(2)" :db/id #edb/ref 17592186580457} {:answer/id #uuid "4fb882bb-be71-5c59-a634-65b02781c9cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186580522} {:answer/id #uuid "60405895-e035-58cb-842d-10b09a8a4932" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡(8)" :db/id #edb/ref 17592186580549} {:answer/id #uuid "bf692bc8-d65d-5ceb-9734-cda57421cb3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(4)" :db/id #edb/ref 17592186580691} {:answer/id #uuid "dab99a72-47a9-51d7-b3b5-d9c4ea5ed620" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(8)" :db/id #edb/ref 17592186580729}] :answer-field/correct {:answer/id #uuid "4fb882bb-be71-5c59-a634-65b02781c9cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186580522} :answer-field/id #uuid "016466b0-e060-5aab-b591-d71625582e46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580789}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c579c1f3-be8e-5aac-8600-10eab58ffbc7" :question/math-academy-id "q-49549" :question/problem "$$\n\\displaystyle {\\int }_{0}^{8}\\frac{1}{16+{x}^{2}}\\,\\text{d}x=\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}\\frac{1}{16+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{8}\\frac{1}{16\\cdot (1+{x}^{2}/16)}\\,\\text{d}x \\\\  & =\\frac{1}{16}{\\int }_{0}^{8}\\frac{1}{1+{x}^{2}/16}\\,\\text{d}x \\\\  & =\\frac{1}{16}{\\int }_{0}^{8}\\frac{1}{1+(x/4)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{4}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $8$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{8}\\frac{1}{16+{x}^{2}}\\,\\text{d}x & =\\frac{1}{16}{\\int }_{0}^{8}\\frac{1}{1+(x/4)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{16}{\\int }_{0}^{2}\\frac{1}{1+{u}^{2}}\\cdot (4\\,\\text{d}u) \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u{|}_{0}^{2} \\\\  & =\\frac{1}{4}(\\operatorname{arctan}⁡(2)-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡(2)\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eb2f314-6218-5d20-846d-b1f62c244921" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186607839} {:answer/id #uuid "1f4d7f16-9e28-5cde-9ed7-301d3003cbf3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186607841} {:answer/id #uuid "4b379efb-0a72-500a-8ebf-e235cb2af673" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{10}" :db/id #edb/ref 17592186607901} {:answer/id #uuid "bafabf47-e243-501e-acbd-67f3d795684d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186608015} {:answer/id #uuid "fdc1e9c9-25e8-5c9a-a2fb-c81db3158f1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186608088}] :answer-field/correct {:answer/id #uuid "bafabf47-e243-501e-acbd-67f3d795684d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186608015} :answer-field/id #uuid "f92ab846-6ecb-5402-adcb-73ad9f5b7d61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608163}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "08c4a96f-48cd-5998-9cd6-61ef07570afd" :question/math-academy-id "q-49536" :question/problem "Find the value of $$\n\\displaystyle {\\int }_{0}^{1/10}\\frac{15}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{1/10}\\frac{15}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x=15{\\int }_{0}^{1/10}\\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{10}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{1/10}\\frac{15}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x & =15{\\int }_{0}^{1/10}\\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x \\\\  & =15{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =3{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =3\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =3\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)-3\\operatorname{arcsin}⁡(0) \\\\  & =\\frac{\\pi }{2}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4905c93-59e4-5489-bd39-01a851d21814" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{\\sqrt{5}}" :db/id #edb/ref 17592186608000}] :answer-field/correct {:answer/id #uuid "a4905c93-59e4-5489-bd39-01a851d21814" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{\\sqrt{5}}" :db/id #edb/ref 17592186608000} :answer-field/id #uuid "c0dee006-775c-5be5-9366-3859c81c1fc2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186608148}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9da4d62-79c8-546a-8cfa-f2f42789b365" :question/math-academy-id "q-351854" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{5}}\\frac{4}{5+{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{5}}\\frac{4}{5+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{5}}\\frac{4}{5\\cdot (1+{x}^{2}/5)}\\,\\text{d}x \\\\  & =\\frac{4}{5}{\\int }_{0}^{\\sqrt{5}}\\frac{1}{1+{x}^{2}/5}\\,\\text{d}x \\\\  & =\\frac{4}{5}{\\int }_{0}^{\\sqrt{5}}\\frac{1}{1+(x/\\sqrt{5})^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{\\sqrt{5}}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{5}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\sqrt{5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{5}}\\frac{4}{5+{x}^{2}}\\,\\text{d}x & =\\frac{4}{5}{\\int }_{0}^{\\sqrt{5}}\\frac{1}{1+(x/\\sqrt{5})^{2}}\\,\\text{d}x \\\\  & =\\frac{4}{5}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\cdot (\\sqrt{5}\\,\\text{d}u) \\\\  & =\\frac{4\\sqrt{5}}{5}{\\int }_{0}^{1}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{4\\sqrt{5}}{5}\\operatorname{arctan}⁡u{|}_{0}^{1} \\\\  & =\\frac{4\\sqrt{5}}{5}(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{4\\sqrt{5}}{5}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{\\sqrt{5}\\,\\pi }{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10252354-59e0-52a9-9b48-74493655f2f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{8}" :db/id #edb/ref 17592186607823} {:answer/id #uuid "14ee31c6-4603-5df0-8b74-6be6e55eac1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{16}" :db/id #edb/ref 17592186607828} {:answer/id #uuid "4f98b232-1df5-5b21-af96-8e7b1948133d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{4}" :db/id #edb/ref 17592186607909} {:answer/id #uuid "71d9a123-911c-547c-8814-a2abefd2a870" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49\\pi }{20}" :db/id #edb/ref 17592186607941} {:answer/id #uuid "eb6848f6-e949-5df8-aef3-41b88ea3c1cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49\\pi }{80}" :db/id #edb/ref 17592186608062}] :answer-field/correct {:answer/id #uuid "10252354-59e0-52a9-9b48-74493655f2f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{8}" :db/id #edb/ref 17592186607823} :answer-field/id #uuid "4ba83c09-1b1f-54ba-93e5-b8d879de48d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608108}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b356033c-192a-55fa-8af3-a9a824c7a21b" :question/math-academy-id "q-19398" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{2}\\frac{7}{4+{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{7}{4+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{2}\\frac{7}{4\\cdot (1+{x}^{2}/4)}\\,\\text{d}x \\\\  & =\\frac{7}{4}{\\int }_{0}^{2}\\frac{1}{1+{x}^{2}/4}\\,\\text{d}x \\\\  & =\\frac{7}{4}{\\int }_{0}^{2}\\frac{1}{1+(x/2)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{2}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{7}{4+{x}^{2}}\\,\\text{d}x & =\\frac{7}{4}{\\int }_{0}^{2}\\frac{1}{1+(x/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{7}{4}{\\int }_{0}^{2}\\frac{1}{1+{u}^{2}}\\cdot (2\\,\\text{d}u) \\\\  & =\\frac{7}{2}{\\int }_{0}^{1}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{7}{2}\\operatorname{arctan}⁡u{|}_{0}^{1} \\\\  & =\\frac{7}{2}\\operatorname{arctan}⁡(1)-\\frac{7}{2}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{7}{2}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{7\\pi }{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a19f002-f394-581c-8a71-944f99d29f1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\pi}{360}" :db/id #edb/ref 17592186677049}] :answer-field/correct {:answer/id #uuid "0a19f002-f394-581c-8a71-944f99d29f1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\pi}{360}" :db/id #edb/ref 17592186677049} :answer-field/id #uuid "b9486294-79c8-509d-84d4-b54229d994a1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677148}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0372c2fd-66f2-541c-882f-7c71be7cc96e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{3 \\sqrt{10}}{10}}^{\\frac{3 \\sqrt{30}}{10}} \\frac{1}{10 x^{2} + 9}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n10 x^{2} + 9=9(1+(\\frac{10}{9})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{3},\\qquad \\mathrm{d}x=(\\frac{3 \\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{3 \\sqrt{10}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{3})(\\frac{3 \\sqrt{10}}{10})=1 \\\\ x=\\frac{3 \\sqrt{30}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{3})(\\frac{3 \\sqrt{30}}{10})=\\sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{3 \\sqrt{10}}{10}}^{\\frac{3 \\sqrt{30}}{10}} \\frac{1}{10 x^{2} + 9}\\,\\mathrm{d}x \\\\  &= \\frac{1}{9}\\int_{\\frac{3 \\sqrt{10}}{10}}^{\\frac{3 \\sqrt{30}}{10}} \\frac{1}{1+(\\frac{\\sqrt{10} x}{3})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{9}(\\frac{3 \\sqrt{10}}{10})\\int_{1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{10}}{30}\\int_{1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{10}}{30}[\\operatorname{arctan}{\\left(u \\right)}]_{1}^{\\sqrt{3}} \\\\  &= \\frac{\\sqrt{10}}{30}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(1)) \\\\  &= \\frac{\\sqrt{10}}{30}((\\frac{\\pi}{3})-(\\frac{\\pi}{4})) \\\\  &= \\frac{\\sqrt{10} \\pi}{360}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\pi}{5}" :db/id #edb/ref 17592186677112}] :answer-field/correct {:answer/id #uuid "891d5a4a-d8d5-502c-9dfc-2c65f90cc8ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\pi}{5}" :db/id #edb/ref 17592186677112} :answer-field/id #uuid "5a9796b7-f543-5dc8-b952-8b55e73eb6a2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677097}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "21a4ebc8-c316-5cfd-93e4-ca1118604531" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\sqrt{10}} \\frac{8}{x^{2} + 10}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 10=10(1+(\\frac{1}{10})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{10}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{10},\\qquad \\mathrm{d}x=(\\sqrt{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(0)=0 \\\\ x=\\sqrt{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(\\sqrt{10})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\sqrt{10}} \\frac{8}{x^{2} + 10}\\,\\mathrm{d}x \\\\  &= \\frac{4}{5}\\int_{0}^{\\sqrt{10}} \\frac{1}{1+(\\frac{\\sqrt{10} x}{10})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{4}{5}(\\sqrt{10})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{4 \\sqrt{10}}{5}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{4 \\sqrt{10}}{5}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\sqrt{10} \\pi}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093ea6db-39b4-540d-abdb-9f769f0d4190" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}" :db/id #edb/ref 17592186677046} {:answer/id #uuid "297649ef-44df-588e-b84f-acc835a9587d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{49}" :db/id #edb/ref 17592186677068} {:answer/id #uuid "3658debc-c4b0-50eb-b768-7e1015c693c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{7}" :db/id #edb/ref 17592186677078} {:answer/id #uuid "59ced480-f5f7-5e7c-b714-da8fe15e0eec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{7}" :db/id #edb/ref 17592186677096} {:answer/id #uuid "dee94e97-9107-57cf-8abb-af0261012ca6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{6 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{7}" :db/id #edb/ref 17592186677177}] :answer-field/correct {:answer/id #uuid "3658debc-c4b0-50eb-b768-7e1015c693c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{7}" :db/id #edb/ref 17592186677078} :answer-field/id #uuid "39a7f2e1-904a-5576-a7b2-3a71b7ec4a32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677082}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "24b61c76-ca28-5b5c-9a6e-51d22a7f675a" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{14}} \\frac{6}{49 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=7 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=7,\\qquad \\mathrm{d}x=(\\frac{1}{7})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(7)(0)=0 \\\\ x=\\frac{1}{14}&\\Longrightarrow u=(7)(\\frac{1}{14})=\\frac{1}{2}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{14}} \\frac{6}{49 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 6\\int_{0}^{\\frac{1}{14}} \\frac{1}{1+(7 x)^{2}}\\,\\mathrm{d}x \\\\  &= 6(\\frac{1}{7})\\int_{0}^{\\frac{1}{2}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{6}{7}\\int_{0}^{\\frac{1}{2}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{6}{7}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{6}{7}(\\operatorname{arctan}(\\frac{1}{2})-\\operatorname{arctan}(0)) \\\\  &= \\frac{6}{7}((\\operatorname{arctan}{\\left(\\frac{1}{2} \\right)})-(0)) \\\\  &= \\frac{6 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} \\pi}{36}" :db/id #edb/ref 17592186677173}] :answer-field/correct {:answer/id #uuid "dad5e5d4-f28a-5e3c-9d7d-2ef281b00081" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} \\pi}{36}" :db/id #edb/ref 17592186677173} :answer-field/id #uuid "0970acb4-17e3-5133-8c74-81024d88697a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677048}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "26a5ab0e-8ab0-5f06-8396-7feffadcde08" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\sqrt{6}}{3}}^{\\frac{2 \\sqrt{3}}{3}} \\frac{2}{\\sqrt{16 - 6 x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{16 - 6 x^{2}}=\\sqrt{16(1-(\\frac{3}{8})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{4}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{4},\\qquad \\mathrm{d}x=(\\frac{2 \\sqrt{6}}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt{6}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{4})(\\frac{\\sqrt{6}}{3})=\\frac{1}{2} \\\\ x=\\frac{2 \\sqrt{3}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{4})(\\frac{2 \\sqrt{3}}{3})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{\\sqrt{6}}{3}}^{\\frac{2 \\sqrt{3}}{3}} \\frac{2}{\\sqrt{16 - 6 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int_{\\frac{\\sqrt{6}}{3}}^{\\frac{2 \\sqrt{3}}{3}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{6} x}{4})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{2 \\sqrt{6}}{3})\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}[\\operatorname{arcsin}{\\left(u \\right)}]_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{\\sqrt{6}}{3}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(\\frac{1}{2})) \\\\  &= \\frac{\\sqrt{6}}{3}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{6} \\pi}{36}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fe824ad-db88-5a89-a4f6-708549ce42b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677121} {:answer/id #uuid "a7d547bc-cbd1-53b4-84fe-a0b07f98b84d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{6} \\pi}{144}" :db/id #edb/ref 17592186677132} {:answer/id #uuid "b2bb5d3e-7051-5abd-89a8-2b656aebf919" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\pi}{36}" :db/id #edb/ref 17592186677136} {:answer/id #uuid "c87fae49-0f53-5df6-911f-e8c7a1db7141" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{6} \\pi}{48}" :db/id #edb/ref 17592186677156} {:answer/id #uuid "f4ca0d1e-aed4-5152-9954-1989b7c30009" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677192}] :answer-field/correct {:answer/id #uuid "8fe824ad-db88-5a89-a4f6-708549ce42b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677121} :answer-field/id #uuid "943865ee-77d8-59f0-8739-263d0db8cbb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677123}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "275ef93a-9e15-50cd-b072-9c822daf3676" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{2}{6 x^{2} + 4}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n6 x^{2} + 4=4(1+(\\frac{3}{2})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{2},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{6}}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\sqrt{2}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{2})(- \\frac{\\sqrt{2}}{3})=- \\frac{\\sqrt{3}}{3} \\\\ x=\\frac{\\sqrt{6}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{2})(\\frac{\\sqrt{6}}{3})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{2}{6 x^{2} + 4}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{1}{1+(\\frac{\\sqrt{6} x}{2})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{\\sqrt{6}}{3})\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}[\\operatorname{arctan}{\\left(u \\right)}]_{- \\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{\\sqrt{6}}{6}(\\operatorname{arctan}(1)-\\operatorname{arctan}(- \\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{\\sqrt{6}}{6}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{5 \\sqrt{6} \\pi}{72}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66ab3c07-aed9-5048-be41-aa6b32baf7e9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{10} \\pi}{10}" :db/id #edb/ref 17592186677100} {:answer/id #uuid "b2fb651a-cb3e-5812-8920-65d6a708aba9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\sqrt{10} \\pi}{5}" :db/id #edb/ref 17592186677137} {:answer/id #uuid "e3d3fca2-2f4b-5bb9-9152-d118b4c0a190" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{8}" :db/id #edb/ref 17592186677184} {:answer/id #uuid "f6f4d4a4-75e2-54f0-a2b8-e12175ae170b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{10} \\pi}{10}" :db/id #edb/ref 17592186677194} {:answer/id #uuid "fd4d363a-e4b7-53bf-85fa-46bfd12b2ff3