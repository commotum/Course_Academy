frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{8})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{4}(\\frac{4 \\sqrt{10}}{5})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{10}}{5}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{10}}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\\\  &= \\frac{3 \\sqrt{10}}{5}(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{3 \\sqrt{10}}{5}((\\frac{\\pi}{3})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{10} \\pi}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00551039-d607-5600-acd4-4dc4aef60bd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\pi}{6}" :db/id #edb/ref 17592186677042} {:answer/id #uuid "b6d5e3ae-feb8-5269-8089-cd58f1844709" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\pi}{3}" :db/id #edb/ref 17592186677143} {:answer/id #uuid "cc4e4223-fd94-5f6b-a213-4216edf8b5c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186677162} {:answer/id #uuid "e2796685-73b6-5e94-ae79-b8111f678b61" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{3}" :db/id #edb/ref 17592186677182} {:answer/id #uuid "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186677183}] :answer-field/correct {:answer/id #uuid "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186677183} :answer-field/id #uuid "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677199}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3678de14-c7a3-5309-a87e-827f356a473e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{2 - x^{2}}=\\sqrt{2(1-(\\frac{1}{2})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{2} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{2}}{2},\\qquad \\mathrm{d}x=(\\sqrt{2})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{2}}{2})(0)=0 \\\\ x=\\frac{\\sqrt{2}}{2}&\\Longrightarrow u=(\\frac{\\sqrt{2}}{2})(\\frac{\\sqrt{2}}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\sqrt{2}\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{2} x}{2})^{2}}}\\,\\mathrm{d}x \\\\  &= \\sqrt{2}(\\sqrt{2})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= 2(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= 2((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b08bd5-31bc-5c5a-ad01-1f39fa210754" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{10} \\pi}{3}" :db/id #edb/ref 