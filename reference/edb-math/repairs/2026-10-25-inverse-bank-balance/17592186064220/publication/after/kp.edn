ght)}\\right]_{- \\frac{1}{2}}^{0}\\right)=\\frac{3}{4}\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"} {:db/id #edb/ref 17592186693081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4efd285-7561-56f4-bccc-435c7e27f225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186693122}] :answer-field/correct {:answer/id #uuid "b4efd285-7561-56f4-bccc-435c7e27f225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186693122} :answer-field/id #uuid "c2c51ac5-8776-5b03-b151-314d5edb2a90" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693127}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "46f7c08c-b23a-52df-8bc9-26e935781bdc" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{2} \\frac{2}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{16 - x^{2}}=4\\sqrt{1-(\\frac{x}{4})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{2}\\cdot 4=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=2&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{2} \\frac{2}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"} {:db/id #edb/ref 17592186693090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af8c3b5d-659b-5ca4-8e21-2fc11a7d934b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{18}" :db/id #edb/ref 17592186693120}] :answer-field/correct {:answer/id #uuid "af8c3b5d-659b-5ca4-8e21-2fc11a7d934b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{18}" :db/id #edb/ref 17592186693120} :answer-field/id #uuid "e1fb631e-8d15-57f6-8580-ccaede1aab9a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693144}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "58813c00-a5b8-5081-ba5b-d06a58cf7795" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-6}^{0} \\frac{1}{x^{2} + 12}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{\\sqrt{3} x}{6}$. Then $\\mathrm{d}u=(\\frac{\\sqrt{3}}{6})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\nx^{2} + 12=12\\left(1+(\\frac{\\sqrt{3} x}{6})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=2 \\sqrt{3}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{12}\\cdot 2 \\sqrt{3}=\\frac{\\sqrt{3}}{6}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-6&\\Longrightarrow u=- \\sqrt{3}\\\\x=0&\\Longrightarrow u=0\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-6}^{0} \\frac{1}{x^{2} + 12}\\,\\mathrm{d}x\\\\&=\\frac{\\sqrt{3}}{6}\\left(\\int_{- \\sqrt{3}}^{0} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(- \\sqrt{3} \\right)}=- \\frac{\\pi}{3},\\quad \\arctan{\\left(0 \\right)}=0$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{\\sqrt{3}}{6}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{- \\sqrt{3}}^{0}\\right)=\\frac{\\sqrt{3}}{6}\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{3}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\sqrt{3} \\pi}{18}.\n$$"} {:db/id #edb/ref 17592186693099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe9023ae-c864-5d76-9a15-13dce5a7ca60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186693156}] :answer-field/correct {:answer/id #uuid "fe9023ae-c864-5d76-9a15-13dce5a7ca60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186693156} :answer-field/id #uuid "d6296145-a5c1-5ba5-8007-818515d6ea25" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693140}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ac272a5-80c3-5610-9fdd-20599dd9ef28" :question/problem "Evaluate exactly.\n\n$$\n\\int_{1}^{\\sqrt{2}} \\frac{3}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{2}\\cdot 2=3$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=1&\\Longrightarrow u=\\frac{1}{2}\\\\x=\\sqrt{2}&\\Longrightarrow u=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{1}^{\\sqrt{2}} \\frac{3}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{\\sqrt{2}}{2} \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}}\\right)=3\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(\\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{4}.\n$$"} {:db/id #edb/ref 17592186693105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40033031-1b4b-545b-b91a-61c608493633" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{5}" :db/id #edb/ref 17592186693075} {:answer/id #uuid "745e1aab-f6c3-5e91-9b42-28a49b50f687" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{40}" :db/id #edb/ref 17592186693101} {:answer/id #uuid "7d4d4b9b-89c7-52ba-89de-a8b5b6ceef7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{4}" :db/id #edb/ref 17592186693104} {:answer/id #uuid "95eeba75-f7cb-582d-9614-a666dc6b1787" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{10}" :db/id #edb/ref 17592186693111} {:answer/id #uuid "f52c8514-c00a-5c00-af9a-090007b206fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{20}" :db/id #edb/ref 17592186693152}] :answer-field/correct {:answer/id #uuid "f52c8514-c00a-5c00-af9a-090007b206fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{20}" :db/id #edb/ref 17592186693152} :answer-field/id #uuid "696f9700-be1d-59b3-b201-c8d34a6bbed5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693098}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7e848776-98b6-587b-8d7e-6e39a34f98ec" :question/problem "Evaluate exactly.\n\n$$\n\\int_{- \\frac{1}{5}}^{0} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value." :question/retired true :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{5}=\\frac{3}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=- \\frac{1}{5}&\\Longrightarrow u=-1\\\\x=0&\\Longrightarrow u=0\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{- \\frac{1}{5}}^{0} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{-1}^{0} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(0 \\right)}=0$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{3}{5}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{0}\\right)=\\frac{3}{5}\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3 \\pi}{20}.\n$$"} {:db/id #edb/ref 17592186693106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4126bb2e-adb1-5c84-aa81-bb8baff44860" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{8}" :db/id #edb/ref 17592186693077} {:answer/id #uuid "60703cd4-5113-5fa7-9aec-b6df4bd49021" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{12}" :db/id #edb/ref 17592186693095} {:answer/id #uuid "97e48d49-d461-5a37-9ce8-29eae33d10c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186693112} {:answer/id #uuid "9ef74460-5fc0-5fa5-9a48-eb85dae4f55b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186693114} {:answer/id #uuid "c5198f31-2a27-5440-96d8-786d3e5b37d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{6}" :db/id #edb/ref 17592186693129