ht)}\\right]_{-1}^{1}\\right)=\\frac{1}{4}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"} {:db/id #edb/ref 17592186679198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98984389-6c56-5627-9dcc-17a55eb70207" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186679154}] :answer-field/correct {:answer/id #uuid "98984389-6c56-5627-9dcc-17a55eb70207" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186679154} :answer-field/id #uuid "fc25e429-ec91-5412-b340-a316818fb8a9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679205}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f3812e4c-4072-5cbb-aae5-d8098598e7d2" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{3}{2}} \\frac{2}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=3\\sqrt{1-(\\frac{x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{2}{3}\\cdot 3=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{3}{2}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{3}{2}} \\frac{2}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"} {:db/id #edb/ref 17592186680232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33100aac-50de-58de-9226-e9a2e03cf619" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680243} {:answer/id #uuid "5f948732-e92d-5a70-bc4d-18f89c96a234" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680252} {:answer/id #uuid "aee33936-a65d-5b77-8bdf-a729e1364bce" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680263} {:answer/id #uuid "dfa4a012-7797-547f-90c2-6b9fb60c8d29" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680274} {:answer/id #uuid "ef9b8017-5293-5302-859c-691c0329147d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680281}] :answer-field/correct {:answer/id #uuid "ef9b8017-5293-5302-859c-691c0329147d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186680281} :answer-field/id #uuid "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680254}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/problem "Use the sub