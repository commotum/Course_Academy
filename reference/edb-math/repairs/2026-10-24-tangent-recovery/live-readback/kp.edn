db/ident :answer.type/math} :answer/value "7 + 4\\sqrt{3}" :db/id #edb/ref 17592186677615} {:answer/id #uuid "79bbecd2-7052-551f-b985-a270579dac25" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\frac{3}{2}\\sqrt{3}" :db/id #edb/ref 17592186677620} {:answer/id #uuid "7ff6f1cb-99f1-5ad9-96c0-f101d6f2907d" :answer/type {:db/ident :answer.type/math} :answer/value "-7 - 4\\sqrt{3}" :db/id #edb/ref 17592186677622} {:answer/id #uuid "a24e7d37-f2e6-585a-8c51-785ceda86a2d" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\sqrt{3}" :db/id #edb/ref 17592186677627} {:answer/id #uuid "cd7540fa-8de6-5472-9bd5-87ef57f7d097" :answer/type {:db/ident :answer.type/math} :answer/value "-2 - \\sqrt{3}" :db/id #edb/ref 17592186677633}] :answer-field/correct {:answer/id #uuid "a24e7d37-f2e6-585a-8c51-785ceda86a2d" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\sqrt{3}" :db/id #edb/ref 17592186677627} :answer-field/id #uuid "8945fe8b-99c1-510c-aea0-deb0fc8e995b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677624}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03747f8e-d819-5767-aa50-c6ba97c1eb0d" :question/problem "What is the exact value of $\\tan\\left(\\frac{17\\pi}{12}\\right)$?\n\n*Hint:* Use the fact that $\\frac{17\\pi}{12} = \\frac{5\\pi}{4} + \\frac{\\pi}{6}$." :question/worked-solution "Recall the sum formula for tangent:\n\n$$\n\\tan\\left(x + y\\right) = \\frac{\\tan x + \\tan y}{1 - \\tan x\\tan y}\n$$\n\nApply it with $x=\\frac{5\\pi}{4}$ and $y=\\frac{\\pi}{6}$. The special-angle values are $\\tan\\left(\\frac{5\\pi}{4}\\right)=1$ and $\\tan\\left(\\frac{\\pi}{6}\\right)=\\frac{1}{3}\\sqrt{3}$.\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{17\\pi}{12}\\right) &= \\tan\\left(\\frac{5\\pi}{4} + \\frac{\\pi}{6}\\right) \\\\\n&= \\frac{\\tan\\left(\\frac{5\\pi}{4}\\right) + \\tan\\left(\\frac{\\pi}{6}\\right)}{1 - \\tan\\left(\\frac{5\\pi}{4}\\right)\\tan\\left(\\frac{\\pi}{6}\\right)} \\\\\n&= \\frac{\\left(1\\right) + \\left(\\frac{1}{3}\\sqrt{3}\\right)}{1 - \\left(1\\right)\\left(\\frac{1}{3}\\sqrt{3}\\right)}\n\\end{aligned}\n$$\n\nMultiply the numerator and denominator by $3$ to clear the fractions:\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{17\\pi}{12}\\right) &= \\frac{3\\left(\\left(1\\right) + \\left(\\frac{1}{3}\\sqrt{3}\\right)\\right)}{3\\left(1 - \\left(1\\right)\\left(\\frac{1}{3}\\sqrt{3}\\right)\\right)} \\\\\n&= \\frac{3 + \\sqrt{3}}{3 - \\sqrt{3}}\n\\end{aligned}\n$$\n\nMultiply by the conjugate of the denominator, expand, and simplify:\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{17\\pi}{12}\\right) &= \\frac{3 + \\sqrt{3}}{3 - \\sqrt{3}}\\cdot \\frac{3 + \\sqrt{3}}{3 + \\sqrt{3}} \\\\\n&= \\frac{\\left(3 + \\sqrt{3}\\right)\\left(3 + \\sqrt{3}\\right)}{\\left(3 - \\sqrt{3}\\right)\\left(3 + \\sqrt{3}\\right)} \\\\\n&= \\frac{12 + 6\\sqrt{3}}{6} \\\\\n&= 2 + \\sqrt{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756c8279-36a1-58c1-9e09-99a7e12606b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186677618} {:answer/id #uuid "7f0289f1-255f-536f-9592-d4b62568ac18" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + 2\\sqrt{3}" :db/id #edb/ref 17592186677621} {:answer/id #uuid "847f3386-057b-5de8-917a-ce17305aefc7" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\sqrt{3}" :db/id #edb/ref 17592186677623} {:answer/id #uuid "b8648fcf-8c7d-5bee-af2c-0a0ae7e7a39c" :answer/type {:db/ident :answer.type/math} :answer/value "-1 - \\sqrt{3}" :db/id #edb/ref 17592186677631} {:answer/id #uuid "c7f1ca0e-6eaf-5516-a2a6-5dab4f26ca61" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + \\sqrt{3}" :db/id #edb/ref 17592186677632}] :answer-field/correct {:answer/id #uuid "847f3386-057b-5de8-917a-ce17305aefc7" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\sqrt{3}" :db/id #edb/ref 17592186677623} :answer-field/id #uuid "fe7fc624-39c8-54d3-a843-5e8e8b90d79c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677639}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0f9f101e-beae-5a98-a287-1e2393b13eda" :question/problem "What is the exact value of $\\tan\\left(\\frac{5\\pi}{12}\\right)$?\n\n*Hint:* Use the fact that $\\frac{5\\pi}{12} = \\frac{2\\pi}{3} - \\frac{\\pi}{4}$." :question/worked-solution "Recall the difference formula for tangent:\n\n$$\n\\tan\\left(x - y\\right) = \\frac{\\tan x - \\tan y}{1 + \\tan x\\tan y}\n$$\n\nApply it with $x=\\frac{2\\pi}{3}$ and $y=\\frac{\\pi}{4}$. The special-angle values are $\\tan\\left(\\frac{2\\pi}{3}\\right)=-\\sqrt{3}$ and $\\tan\\left(\\frac{\\pi}{4}\\right)=1$.\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{5\\pi}{12}\\right) &= \\tan\\left(\\frac{2\\pi}{3} - \\frac{\\pi}{4}\\right) \\\\\n&= \\frac{\\tan\\left(\\frac{2\\pi}{3}\\right) - \\tan\\left(\\frac{\\pi}{4}\\right)}{1 + \\tan\\left(\\frac{2\\pi}{3}\\right)\\tan\\left(\\frac{\\pi}{4}\\right)} \\\\\n&= \\frac{\\left(-\\sqrt{3}\\right) - \\left(1\\right)}{1 + \\left(-\\sqrt{3}\\right)\\left(1\\right)}\n\\end{aligned}\n$$\n\nCombining the terms gives\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{5\\pi}{12}\\right) &= \\frac{-1 - \\sqrt{3}}{1 - \\sqrt{3}}\n\\end{aligned}\n$$\n\nMultiply by the conjugate of the denominator, expand, and simplify:\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{5\\pi}{12}\\right) &= \\frac{-1 - \\sqrt{3}}{1 - \\sqrt{3}}\\cdot \\frac{1 + \\sqrt{3}}{1 + \\sqrt{3}} \\\\\n&= \\frac{\\left(-1 - \\sqrt{3}\\right)\\left(1 + \\sqrt{3}\\right)}{\\left(1 - \\sqrt{3}\\right)\\left(1 + \\sqrt{3}\\right)} \\\\\n&= \\frac{-4 - 2\\sqrt{3}}{-2} \\\\\n&= 2 + \\sqrt{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0202f1a6-6ce7-5319-bb13-d0d6e9972f5c" :answer/type {:db/ident :answer.type/math} :answer/value "-7 - 4\\sqrt{3}" :db/id #edb/ref 17592186677605} {:answer/id #uuid "3a5ae6d5-c3ed-5be2-9820-9bf3c588d1cf" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + 2\\sqrt{3}" :db/id #edb/ref 17592186677610} {:answer/id #uuid "415e4ef9-d36e-5cbe-afa7-92e78bb7d9db" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + \\sqrt{3}" :db/id #edb/ref 17592186677613} {:answer/id #uuid "4629d8fc-10c7-53f0-bcde-4dee1ada0b75" :answer/type {:db/ident :answer.type/math} :answer/value "-2 - \\sqrt{3}" :db/id #edb/ref 17592186677614} {:answer/id #uuid "969631a4-465a-5f70-b91c-a9373535e236" :answer/type {:db/ident :answer.type/math} :answer/value "4 + 2\\sqrt{3}" :db/id #edb/ref 17592186677626}] :answer-field/correct {:answer/id #uuid "415e4ef9-d36e-5cbe-afa7-92e78bb7d9db" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + \\sqrt{3}" :db/id #edb/ref 17592186677613} :answer-field/id #uuid "602c43a8-df5d-5392-a5d9-66f53b3ae47b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677617}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a6797692-7445-5505-a252-3c278c42c04d" :question/problem "What is the exact value of $\\tan\\left(\\frac{11\\pi}{12}\\right)$?\n\n*Hint:* Use the fact that $\\frac{11\\pi}{12} = \\frac{2\\pi}{3} + \\frac{\\pi}{4}$." :question/worked-solution "Recall the sum formula for tangent:\n\n$$\n\\tan\\left(x + y\\right) = \\frac{\\tan x + \\tan y}{1 - \\tan x\\tan y}\n$$\n\nApply it with $x=\\frac{2\\pi}{3}$ and $y=\\frac{\\pi}{4}$. The special-angle values are $\\tan\\left(\\frac{2\\pi}{3}\\right)=-\\sqrt{3}$ and $\\tan\\left(\\frac{\\pi}{4}\\right)=1$.\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{11\\pi}{12}\\right) &= \\tan\\left(\\frac{2\\pi}{3} + \\frac{\\pi}{4}\\right) \\\\\n&= \\frac{\\tan\\left(\\frac{2\\pi}{3}\\right) + \\tan\\left(\\frac{\\pi}{4}\\right)}{1 - \\tan\\left(\\frac{2\\pi}{3}\\right)\\tan\\left(\\frac{\\pi}{4}\\right)} \\\\\n&= \\frac{\\left(-\\sqrt{3}\\right) + \\left(1\\right)}{1 - \\left(-\\sqrt{3}\\right)\\left(1\\right)}\n\\end{aligned}\n$$\n\nCombining the terms gives\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{11\\pi}{12}\\right) &= \\frac{1 - \\sqrt{3}}{1 + \\sqrt{3}}\n\\end{aligned}\n$$\n\nMultiply by the conjugate of the denominator, expand, and simplify:\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{11\\pi}{12}\\right) &= \\frac{1 - \\sqrt{3}}{1 + \\sqrt{3}}\\cdot \\frac{1 - \\sqrt{3}}{1 - \\sqrt{3}} \\\\\n&= \\frac{\\left(1 - \\sqrt{3}\\right)\\left(1 - \\sqrt{3}\\right)}{\\left(1 + \\sqrt{3}\\right)\\left(1 - \\sqrt{3}\\right)} \\\\\n&= \\frac{4 - 2\\sqrt{3}}{-2} \\\\\n&= -2 + \\sqrt{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f8a84dc-6f30-5b8d-849f-0a2607255503" :answer/type {:db/ident :answer.type/math} :answer/value "2 - \\sqrt{3}" :db/id #edb/ref 17592186677611} {:answer/id #uuid "7614f38f-5dfe-5644-86a3-34491f401b43" :answer/type {:db/ident :answer.type/math} :answer/value "-4 - 2\\sqrt{3}" :db/id #edb/ref 17592186677619} {:answer/id #uuid "e03f8689-da5f-5c1e-b1f7-06c2501b9be7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186677635} {:answer/id #uuid "e337e546-9db1-5660-a2e2-21c11e812971" :answer/type {:db/ident :answer.type/math} :answer/value "-2 - \\sqrt{3}" :db/id #edb/ref 17592186677636} {:answer/id #uuid "e9aa36cd-3494-5716-994d-c95a0cd78890" :answer/type {:db/ident :answer.type/math} :answer/value "4 - 2\\sqrt{3}" :db/id #edb/ref 17592186677637}] :answer-field/correct {:answer/id #uuid "3f8a84dc-6f30-5b8d-849f-0a2607255503" :answer/type {:db/ident :answer.type/math} :answer/value "2 - \\sqrt{3}" :db/id #edb/ref 17592186677611} :answer-field/id #uuid "d5ac32ee-0306-5fad-a224-9a3d32a32d75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677634}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a95b84e8-c828-5406-8a1f-a91531c54241" :question/problem "What is the exact value of $\\tan\\left(15^\\circ\\right)$?\n\n*Hint:* Use the fact that $15^\\circ = 150^\\circ - 135^\\circ$." :question/worked-solution "Recall the difference formula for tangent:\n\n$$\n\\tan\\left(x - y\\right) = \\frac{\\tan x - \\tan y}{1 + \\tan x\\tan y}\n$$\n\nApply it with $x=150^\\circ$ and $y=135^\\circ$. The special-angle values are $\\tan\\left(150^\\circ\\right)=-\\frac{1}{3}\\sqrt{3}$ and $\\tan\\left(135^\\circ\\right)=-1$.\n\n$$\n\\begin{aligned}\n\\tan\\left(15^\\circ\\right) &= \\tan\\left(150^\\circ - 135^\\circ\\right) \\\\\n&= \\frac{\\tan\\left(150^\\circ\\right) - \\tan\\left(135^\\circ\\right)}{1 + \\tan\\left(150^\\circ\\right)\\tan\\left(135^\\circ\\right)} \\\\\n&= \\frac{\\left(-\\frac{1}{3}\\sqrt{3}\\right) - \\left(-1\\right)}{1 + \\left(-\\frac{1}{3}\\sqrt{3}\\right)\\left(-1\\right)}\n\\end{aligned}\n$$\n\nMultiply the numerator and denominator by $3$ to clear the fractions:\n\n$$\n\\begin{aligned}\n\\tan\\left(15^\\circ\\right) &= \\frac{3\\left(\\left(-\\frac{1}{3}\\sqrt{3}\\right) - \\left(-1\\right)\\right)}{3\\left(1 + \\left(-\\frac{1}{3}\\sqrt{3}\\right)\\left(-1\\right)\\right)} \\\\\n&= \\frac{3 - \\sqrt{3}}{3 + \\sqrt{3}}\n\\end{aligned}\n$$\n\nMultiply by the conjugate of the denominator, expand, and simplify:\n\n$$\n\\begin{aligned}\n\\tan\\left(15^\\circ\\right) &= \\frac{3 - \\sqrt{3}}{3 + \\sqrt{3}}\\cdot \\frac{3 - \\sqrt{3}}{3 - \\sqrt{3}} \\\\\n&= \\frac{\\left(3 - \\sqrt{3}\\right)\\left(3 - \\sqrt{3}\\right)}{\\left(3 + \\sqrt{3}\\right)\\left(3 - \\sqrt{3}\\right)} \\\\\n&= \\frac{12 - 6\\sqrt{3}}{6} \\\\\n&= 2 - \\sqrt{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067dc454-8e33-557c-8f64-69d35ed20714" :answer/type {:db/ident :answer.type/math} :answer/value "-2 - \\sqrt{3}" :db/id #edb/ref 17592186677607} {:answer/id #uuid "217bb7bc-3744-5668-9695-5c5be1164b94" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + \\frac{1}{2}\\sqrt{3}" :db/id #edb/ref 17592186677609} {:answer/id #uuid "408c0ccd-bc02-5973-a563-e91f571a9227" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + 2\\sqrt{3}" :db/id #edb/ref 17592186677612} {:answer/id #uuid "5a5d816d-56e7-5ee2-814f-bcc6c6e466b9" :answer/type {:db/ident :answer.type/math} :answer/value "-4 - 2\\sqrt{3}" :db/id #edb/ref 17592186677616} {:answer/id #uuid "eb62c362-4337-56f1-a35b-4eb2c8da504c" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + \\sqrt{3}" :db/id #edb/ref 17592186677638}] :answer-field/correct {:answer/id #uuid "067dc454-8e33-557c-8f64-69d35ed20714" :answer/type {:db/ident :answer.type/math} :answer/value "-2 - \\sqrt{3}" :db/id #edb/ref 17592186677607} :answer-field/id #uuid "8e36652c-3781-52d5-9915-e84d46c01691" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677625}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac69dede-acc7-5623-9f26-ad36407f7f0f" :question/problem "What is the exact value of $\\tan\\left(\\frac{19\\pi}{12}\\right)$?\n\n*Hint:* Use the fact that $\\frac{19\\pi}{12} = \\frac{\\pi}{4} + \\frac{4\\pi}{3}$." :question/worked-solution "Recall the sum formula for tangent:\n\n$$\n\\tan\\left(x + y\\right) = \\frac{\\tan x + \\tan y}{1 - \\tan x\\tan y}\n$$\n\nApply it with $x=\\frac{\\pi}{4}$ and $y=\\frac{4\\pi}{3}$. The special-angle values are $\\tan\\left(\\frac{\\pi}{4}\\right)=1$ and $\\tan\\left(\\frac{4\\pi}{3}\\right)=\\sqrt{3}$.\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{19\\pi}{12}\\right) &= \\tan\\left(\\frac{\\pi}{4} + \\frac{4\\pi}{3}\\right) \\\\\n&= \\frac{\\tan\\left(\\frac{\\pi}{4}\\right) + \\tan\\left(\\frac{4\\pi}{3}\\right)}{1 - \\tan\\left(\\frac{\\pi}{4}\\right)\\tan\\left(\\frac{4\\pi}{3}\\right)} \\\\\n&= \\frac{\\left(1\\right) + \\left(\\sqrt{3}\\right)}{1 - \\left(1\\right)\\left(\\sqrt{3}\\right)}\n\\end{aligned}\n$$\n\nCombining the terms gives\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{19\\pi}{12}\\right) &= \\frac{1 + \\sqrt{3}}{1 - \\sqrt{3}}\n\\end{aligned}\n$$\n\nMultiply by the conjugate of the denominator, expand, and simplify:\n\n$$\n\\begin{aligned}\n\\tan\\left(\\frac{19\\pi}{12}\\right) &= \\frac{1 + \\sqrt{3}}{1 - \\sqrt{3}}\\cdot \\frac{1 + \\sqrt{3}}{1 + \\sqrt{3}} \\\\\n&= \\frac{\\left(1 + \\sqrt{3}\\right)\\left(1 + \\sqrt{3}\\right)}{\\left(1 - \\sqrt{3}\\right)\\left(1 + \\sqrt{3}\\right)} \\\\\n&= \\frac{4 + 2\\sqrt{3}}{-2} \\\\\n&= -2 - \\sqrt{3}\n\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Exact Value Using the Sum and Difference Formulas for Tangent"}]}
