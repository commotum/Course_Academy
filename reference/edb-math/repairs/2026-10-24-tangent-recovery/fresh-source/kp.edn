question/id #uuid "4d2cbf11-539c-5729-8b25-cb111d75ab70" :question/math-academy-id "q-1759" :question/problem "What is the exact value of $\\tan \\left(\\frac{5π}{12}\\right)$?\n\n*Hint: Use the fact that $$\n\\displaystyle \\frac{5π}{12} = \\frac{π}{4} + \\frac{π}{6}.\n$$*"} {:db/id #edb/ref 17592186060280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fe7d567-2fed-5e75-98e3-58c564ae875b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186058303} {:answer/id #uuid "acd4d8a6-1111-5f26-8457-4386601baf97" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3} - 2}{2}" :db/id #edb/ref 17592186058304} {:answer/id #uuid "e75c3247-8ccb-5e51-856a-3225463231ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3} - 2" :db/id #edb/ref 17592186058305} {:answer/id #uuid "4d221a05-bdd8-5b37-87c4-5a5bdbf6227e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 2}{2}" :db/id #edb/ref 17592186058306} {:answer/id #uuid "5d444430-04e6-564d-8479-446e89d0d7a3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3} - 2" :db/id #edb/ref 17592186058307}] :answer-field/id #uuid "021ca669-cdd4-5a7d-a46c-8152a50fe4cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058302}] :question/id #uuid "a2938a8c-8f52-581f-8b4a-334518397013" :question/math-academy-id "q-43382" :question/problem "What is the exact value of $\\tan 285^{∘}$?\n\n*Hint: Use the fact that $285^{∘} = 240^{∘} + 45^{∘}$.*"}] :knowledge-point/title "Finding an Exact Value Using the Sum and Difference Formulas for Tangent"}]}
