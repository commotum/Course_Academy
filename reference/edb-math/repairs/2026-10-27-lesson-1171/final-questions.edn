 & 2 \\\\ 3 & \\sqrt{5} & -6 \\\\ 7 & -8 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{5}\\cdot 0+(-5)\\cdot 1+2\\cdot 0 \\\\ 3\\cdot 0+\\sqrt{5}\\cdot 1+(-6)\\cdot 0 \\\\ 7\\cdot 0+(-8)\\cdot 1+0\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 \\\\ \\sqrt{5} \\\\ -8\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a70a48ac-dad6-5dc6-938a-8e2f8133296d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310095}] :answer-field/correct {:answer/id #uuid "a70a48ac-dad6-5dc6-938a-8e2f8133296d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310095} :answer-field/id #uuid "1076bb95-e952-5d02-8472-b2f52c865eef" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310837} {:answer-field/choices [{:answer/id #uuid "b6c67d71-52aa-5409-9830-8401645fc37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186310227}] :answer-field/correct {:answer/id #uuid "b6c67d71-52aa-5409-9830-8401645fc37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186310227} :answer-field/id #uuid "3fec9d16-c062-5b5b-b693-27eda534afbf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310965} {:answer-field/choices [{:answer/id #uuid "e4a4384b-9701-5fda-99f2-e31da2469d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186310573}] :answer-field/correct {:answer/id #uuid "e4a4384b-9701-5fda-99f2-e31da2469d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type