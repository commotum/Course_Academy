d #uuid "9f215cc9-2733-5448-8e6a-2bb133106105" :question/math-academy-id "q-275522" :question/problem "Calculate the product $D{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$$\n\\displaystyle D=\\begin{bmatrix}-2 & 3 \\\\ 2 & 0\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$D\\cdot I_2=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $D$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nD\\cdot {I}_{2}=D=\\begin{bmatrix}-2 & 3 \\\\ 2 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186292862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ba8f9b9-ebe4-5a92-ad85-2a5904c716b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186291226}] :answer-field/correct {:answer/id #uuid "8ba8f9b9-ebe4-5a92-ad85-2a5904c716b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186291226} :answer-field/id #uuid "9c71c1d5-29c4-5775-add9-5e009062a4d6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292231} {:answer-field/choices [{:answer/id #uuid "3e10b6b5-317f-5bfd-9061-ca77b2bc0961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186290889}] :answer-field/correct {:answer/id #uuid "3e10b6b5-317f-5bfd-9061-ca77b2bc0961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.ty