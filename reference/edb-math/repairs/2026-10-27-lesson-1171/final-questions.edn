311868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ac8b17-7e11-562c-a2ac-7541b297f973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186309401}] :answer-field/correct {:answer/id #uuid "56ac8b17-7e11-562c-a2ac-7541b297f973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186309401} :answer-field/id #uuid "4597226b-1e40-5a57-9b8c-bc1cc3c255a1" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310980} {:answer-field/choices [{:answer/id #uuid "77e81909-6879-5cff-9653-ee1f5d1086cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186309689}] :answer-field/correct {:answer/id #uuid "77e81909-6879-5cff-9653-ee1f5d1086cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186309689} :answer-field/id #uuid "8a97cd18-d3ce-52af-ac4b-5edd53e4decb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311187} {:answer-field/choices [{:answer/id #uuid "9edd27b9-5e64-5d54-bae7-8c5b80d490a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{6}" :db/id #edb/ref 17592186310030}] :answer-field/correct {:answer/id #uuid "9edd27b9-5e64-5d54-bae7-8c5b80d490a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{6}" :db/id #edb/ref 17592186310030} :answer-field/id #uuid "d2994337-5383-56c4-96e5-caa691bb998d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311405}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10d2bcff-0136-5147-bba2-863359d76868" :question/math-academy-id "q-337661" :question/problem "Find the product $AB,$ if\n$$\n\\displaystyle A=\\begin{bmatrix}4 & -3 & -2\\sqrt{6} \\\\ -1 & 7 & \\sqrt{6} \\\\ 5 & 0 & -8\\end{bmatrix}\n$$\nand \n$$\n\\displaystyle B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3},$ the result must be the $3$rd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-2\\sqrt{6} \\\\ \\sqrt{6} \\\\ -8\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}4 & -3 & -2\\sqrt{6} \\\\ -1 & 7 & \\sqrt{6} \\\\ 5 & 0 & -8\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4\\cdot 0+(-3)\\cdot 0+(-2\\sqrt{6})\\cdot 1 \\\\ (-1)\\cdot 0+7\\cdot 0+\\sqrt{6}\\cdot 1 \\\\ 5\\cdot 0+0\\cdot 0+(-8)\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\sqrt{6} \\\\ \\sqrt{6} \\\\ -8\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b3f0dd-74d0-583b-bb4a-bb0d59b17444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186308876}] :answer-field/correct {:answer/id #uuid "11b3f0dd-74d0-583b-bb4a-bb0d59b17444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186308876} :answer-field/id #uuid "67c68364-75fc-5500-bef6-cf4b7471352e" :answer-field/key "field-2" :answer-field/type {:db/id