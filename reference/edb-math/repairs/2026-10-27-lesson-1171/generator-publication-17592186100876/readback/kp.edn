{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{bmatrix}.\n$$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & 1 & 0\\end{bmatrix}\\begin{bmatrix}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd465a5-2228-506e-85ae-bca8f7b15782" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186392437} {:answer/id #uuid "89c7f214-2178-5237-aa70-418be548a79a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 3\\sqrt{2} \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186392438} {:answer/id #uuid "b9584a78-324d-5402-b9dd-9340417fbdbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 3\\sqrt{2} & 2\\end{bmatrix}" :db/id #edb/ref 17592186392439} {:answer/id #uuid "9dfc011c-f3fc-50b6-918e-d5e364adfbb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{3} \\\\ -5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186392440} {:answer/id #uuid "f8d7fd08-e9dc-5175-be41-5413c7de1648" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{3} & -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392441}] :answer-field/correct {:answer/id #uuid "2cd465a5-2228-506e-85ae-bca8f7b15782" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186392437} :a