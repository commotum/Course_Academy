(5)\\cdot 0+(-8)\\cdot 0&=4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186719643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14f8ccbf-19ae-5428-9587-5cbb7d4b8d77" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -8 \\\\ -2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186719614} {:answer/id #uuid "733bb72f-38c2-5387-89f8-cb6204249e48" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -5 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186719632} {:answer/id #uuid "9a734496-6632-528a-b9fe-22acb6c153e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 9 \\\\ 2\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186719635} {:answer/id #uuid "a30534ed-bf57-541b-a00a-47de52a78840" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186719636} {:answer/id #uuid "adf0cfee-0a35-5b16-84a6-338861212dfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\sqrt{2} \\\\ -6 \\\\ 2\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186719637}] :answer-field/correct {:answer/id #uuid "14f8ccbf-19ae-5428-9587-5cbb7d4b8d77" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -8 \\\\ -2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186719614} :answer-field/id #uuid "d8d4ac69-eb16-5f85-98ac-3dc19108b20e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719642}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "deb9fd0b-14dc-55cb-b3d6-6b2c03535543" :question/problem "Find the product $AB$, if\n$$\nA=\\begin{bmatrix}2 & -1 & -3 \\\\ -8 & -5 & 9 \\\\ -2\\sqrt{2} & -6 & 2\\sqrt{5}\\end{bmatrix}\n$$\nand\n$$\nB=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "The matrix $B$ is column $1$ of $I_3$. Multiplying on the right selects column $1$ of $A$:\n$$\nAB=\\begin{bmatrix}2 \\\\ -8 \\\\ -2\\sqrt{2}\\end{bmatrix}\n$$\nCheck the entries by row-by-column multiplication:\n$$\n\\begin{aligned}(2)\\cdot 1+(-1)\\cdot 0+(-3)\\cdot 0&=2 \\\\ (-8)\\cdot 1+(-5)\\cdot 0+(9)\\cdot 0&=-8 \\\\ (-2\\sqrt{2})\\cdot 1+(-6)\\cdot 0+(2\\sqrt{5})\\cdot 0&=-2\\sqrt{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186719683 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07bdbb7f-f6a1-5862-8525-ba582a8fd255" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186719680} {:answer/id #uuid "10e3418f-bad4-5f3b-91b3-ac2a58ad947d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3\\end{bmatrix}" :db/id #edb/ref 17592186719681} {:answer/id #uuid "284f9377-68ba-5dc6-8d3c-5a953f115cf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186719684} {:answer/id #uuid "4cff9909-43b3-5ee0-bdf0-e39c93990e85" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\end{bmatrix}" :db/id #edb/ref 17592186719689} {:answer/id #uuid "d133462f-7a64-5154-b93f-b8cb755b4d9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9\\end{bmatrix}" :db/id #edb/ref 17592186719702}] :answer-field/correct {:answer/id #uuid "284f9377-68ba-5dc6-8d3c-5a953f115cf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186719684} :answer-field/id #uuid "718e74c5-c7f3-58f6-89d5-233e0ffd6bf2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719694}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1e9a72b0-c38f-5121-84ee-a13bbbd1859c" :question/problem "Calculate the product $(LM)R$, where\n$$\nL=\\begin{bmatrix}1 & 0 & 0\\end{bmatrix}\n$$\n$$\nM=\\begin{bmatrix}-6 & -3 & -\\sqrt{3} \\\\ 7 & -5 & 9 \\\\ \\frac{1}{2} & 9 & 3\\end{bmatrix}\n$$\nand\n$$\nR=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\nSelect the resulting $1\\times1$ matrix." :question/worked-solution "The row $L$ is row $1$ of $I_3$. Left multiplication selects row $1$ of $M$:\n$$\nLM=\\begin{bmatrix}-6 & -3 & -\\sqrt{3}\\end{bmatrix}\n$$\nThe column $R$ is column $3$ of $I_3$. Right multiplication selects entry $3$ of that row:\n$$\n(LM)R=\\begin{bmatrix}-\\sqrt{3}\\end{bmatrix}\n$$\nThe single entry is the dot product\n$$\n(-6)\\cdot 0+(-3)\\cdot 0+(-\\sqrt{3})\\cdot 1=-\\sqrt{3}\n$$"} {:db/id #edb/ref 17592186719685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142dff1e-2ce2-575d-965e-4b079f596f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186719682} {:answer/id #uuid "451ca3ed-03c4-562a-8d0e-1a9553de1eba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\end{bmatrix}" :db/id #edb/ref 17592186719688} {:answer/id #uuid "4f969150-69a8-5d36-8304-8c989bea9573" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9\\end{bmatrix}" :db/id #edb/ref 17592186719690} {:answer/id #uuid "b19f3919-53ed-58cf-8e4c-a9bab3d0b15b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186719698} {:answer/id #uuid "c3205db3-94b0-5bb7-81ef-59a141f6a5dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\end{bmatrix}" :db/id #edb/ref 17592186719699}] :answer-field/correct {:answer/id #uuid "c3205db3-94b0-5bb7-81ef-59a141f6a5dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\end{bmatrix}" :db/id #edb/ref 17592186719699} :answer-field/id #uuid "70ca2b7c-0e4e-5d53-9833-b174d6f537a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719693}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "33ee034e-0373-52ae-93d6-be17e900be8c" :question/problem "Calculate the product $(LM)R$, where\n$$\nL=\\begin{bmatrix}0 & 1 & 0\\end{bmatrix}\n$$\n$$\nM=\\begin{bmatrix}-9 & -\\sqrt{3} & -2\\sqrt{2} \\\\ 4 & \\frac{1}{2} & 2 \\\\ 2 & -5 & 8\\end{bmatrix}\n$$\nand\n$$\nR=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\n$$\nSelect the resulting $1\\times1$ matrix." :question/worked-solution "The row $L$ is row $2$ of $I_3$. Left multiplication selects row $2$ of $M$:\n$$\nLM=\\begin{bmatrix}4 & \\frac{1}{2} & 2\\end{bmatrix}\n$$\nThe column $R$ is column $1$ of $I_3$. Right multiplication selects entry $1$ of that row:\n$$\n(LM)R=\\begin{bmatrix}4\\end{bmatrix}\n$$\nThe single entry is the dot product\n$$\n(4)\\cdot 1+\\left(\\frac{1}{2}\\right)\\cdot 0+(2)\\cdot 0=4\n$$"} {:db/id #edb/ref 17592186719703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ca61ef9-7ed3-51d1-ab04-062fe3b9d017" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6\\end{bmatrix}" :db/id #edb/ref 17592186719686} {:answer/id #uuid "c5774482-4c8b-5ece-a082-f40d6297e492" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3.5\\end{bmatrix}" :db/id #edb/ref 17592186719700} {:answer/id #uuid "dbf7a02a-ae15-5536-ad68-d991b9356935" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1\\end{bmatrix}" :db/id #edb/ref 17592186719704} {:answer/id #uuid "e8eb46b8-d41e-5c8d-9411-39dba04637b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5\\end{bmatrix}" :db/id #edb/ref 17592186719706} {:answer/id #uuid "fdda5228-5674-544f-af5d-13f4f775d44d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186719707}] :answer-field/correct {:answer/id #uuid "3ca61ef9-7ed3-51d1-ab04-062fe3b9d017" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6\\end{bmatrix}" :db/id #edb/ref 17592186719686} :answer-field/id #uuid "4fb19b14-03be-5a7e-af90-454e2ed8055c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719691}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d897c352-e569-58d9-ab85-09e39383015b" :question/problem "Calculate the product $(LM)R$, where\n$$\nL=\\begin{bmatrix}1 & 0 & 0\\end{bmatrix}\n$$\n$$\nM=\\begin{bmatrix}-5 & -6 & \\sqrt{2} \\\\ -1 & 3.5 & 3.5 \\\\ -2.5 & 2 & -3\\end{bmatrix}\n$$\nand\n$$\nR=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$\nSelect the resulting $1\\times1$ matrix." :question/worked-solution "The row $L$ is row $1$ of $I_3$. Left multiplication selects row $1$ of $M$:\n$$\nLM=\\begin{bmatrix}-5 & -6 & \\sqrt{2}\\end{bmatrix}\n$$\nThe column $R$ is column $2$ of $I_3$. Right multiplication selects entry $2$ of that row:\n$$\n(LM)R=\\begin{bmatrix}-6\\end{bmatrix}\n$$\nThe single entry is the dot product\n$$\n(-5)\\cdot 0+(-6)\\cdot 1+(\\sqrt{2})\\cdot 0=-6\n$$"} {:db/id #edb/ref 17592186719705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44812fcc-76c9-563b-9cf9-49f314d1ec74" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1\\end{bmatrix}" :db/id #edb/ref 17592186719687} {:answer/id #uuid "67521577-effa-557b-94ac-9f73d8a27eac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3\\end{bmatrix}" :db/id #edb/ref 17592186719692} {:answer/id #uuid "8b2541c8-2288-532a-88c6-e83d5fee098e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186719695} {:answer/id #uuid "9f9c4ae9-edd9-516b-bd7e-f1b245db9633" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7\\end{bmatrix}" :db/id #edb/ref 17592186719696} {:answer/id #uuid "cb37aed1-89c5-5702-bf72-14a681c85def" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\end{bmatrix}" :db/id #edb/ref 17592186719701}] :answer-field/correct {:answer/id #uuid "8b2541c8-2288-532a-88c6-e83d5fee098e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186719695} :answer-field/id #uuid "ab87ad9a-942f-5e01-8e89-855093860f8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719697}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "dc59458e-b0e4-5a32-a361-696f43aca1d6" :question/problem "Calculate the product $(LM)R$, where\n$$\nL=\\begin{bmatrix}0 & 0 & 1\\end{bmatrix}\n$$\n$$\nM=\\begin{bmatrix}9 & \\frac{1}{2} & -3 \\\\ -7 & 3.5 & -1 \\\\ 4 & 7 & -2\\sqrt{2}\\end{bmatrix}\n$$\nand\n$$\nR=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\nSelect the resulting $1\\times1$ matrix." :question/worked-solution "The row $L$ is row $3$ of $I_3$. Left multiplication selects row $3$ of $M$:\n$$\nLM=\\begin{bmatrix}4 & 7 & -2\\sqrt{2}\\end{bmatrix}\n$$\nThe column $R$ is column $3$ of $I_3$. Right multiplication selects entry $3$ of that row:\n$$\n(LM)R=\\begin{bmatrix}-2\\sqrt{2}\\end{bmatrix}\n$$\nThe single entry is the dot product\n$$\n(4)\\cdot 0+(7)\\cdot 0+(-2\\sqrt{2})\\cdot 1=-2\\sqrt{2}\n$$"}] :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}]}
