}-3 \\\\ \\sqrt{3} \\\\ -1\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2\\sqrt{13} & -3 & 6 \\\\ 3 & \\sqrt{3} & -1 \\\\ 7 & -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\sqrt{13}\\cdot 0+(-3)\\cdot 1+6\\cdot 0 \\\\ 3\\cdot 0+\\sqrt{3}\\cdot 1+(-1)\\cdot 0 \\\\ 7\\cdot 0+(-1)\\cdot 1+0\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ \\sqrt{3} \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346a9c36-9c70-5a26-a683-b26b85be243e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\sqrt{11} \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186546084} {:answer/id #uuid "59c9f45b-de24-5684-9e28-4baa92ba5926" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{6} & 6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186546085} {:answer/id #uuid "8a367c8b-e09a-5e10-8f5d-0a988ff5dc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6\\end{bmatrix}" :db/id #edb/ref 17592186546088} {:answer/id #uuid "8e5b5143-6112-5bdb-a30c-e60d12cefc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186546089} {:answer/id #uuid "c22141b6-ad0a-5d40-b9aa-254caa95396e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} \\\\ -4 \\\\ 3\\sqrt{6}\\end{bmatrix}" :db/id #edb/ref 17592186546091}] :answer-field/correct {:answer/id #uuid "8e5b5143-6112-5bdb-a30c-e60d12cefc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186546089} :answer-field/id #uuid "fa2cb576-db76-5f72-8574-1fafaae20058" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546094}] :question