-72bac8afebc2" :answer-field/validate] [:db/add "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/id #uuid "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19"] [:db/add "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/problem "![Concave quadrilateral CDAB with measurements](images/bf/bf86dd66e68aa803862e9d743bff40c2c4e507b1504cd854e998c43b67babb59.png)\n\nThe area of the quadrilateral $CDAB$ is $6\\,\\text{in}^{2}$. The sides $CD=4.5\\,\\text{in}$ and $CB=9\\,\\text{in}$ meet at $110^\\circ$. What is the area of $\\triangle DAB$, rounded to the **nearest integer**?\n\nYou may use a scientific calculator."] [:db/add "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/worked-solution "First calculate the area of the enclosing triangle $CDB$. Use the two given sides and their included angle, with the calculator in degree mode.\n\n$$\n\\begin{aligned}A_{CDB}&=\\frac12\\cdot CD\\cdot CB\\cdot\\sin\\angle DCB\\\\&=\\frac12\\cdot 4.5\\cdot 9\\cdot\\sin110^\\circ\\\\&\\approx19.028776\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nThe enclosing triangle consists of the quadrilateral $CDAB$ and the missing triangle $DAB$. Subtract the quadrilateral area:\n\n$$\n\\begin{aligned}A_{DAB}&=A_{CDB}-A_{CDAB}\\\\&=20.25\\sin110^\\circ-6\\\\&\\approx13.028776\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nKeep full precision until this subtraction is complete. Rounded to the nearest integer, the area is $13\\,\\text{in}^{2}$."] [:db/add "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/requires-calculator true] [:db/add "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/difficulty :question.difficulty/hard] [:db/add "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/answer-fields "86cc20da-0806-55c2-82da-72bac8afebc2"] [:db/ensure "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19" :question/validate] [:db/add 17592186105906 :knowledge-point/questions "d404bbfa-8dd0-5a2d-a8c0-c559d2ca2f19"] [:db/add "4b35a86c-3c2e-59da-bb57-a43daba7d66f" :answer/id #uuid "4b35a86c-3c2e-59da-bb57-a43daba7d66f"] [:db/add "4b35a86c-3c2e-59da-bb57-a43daba7d66f" :answer/type :answer.type/math] [:db/add "4b35a86c-3c2e-59da-bb57-a43daba7d66f" :answer/value "9"] [:db/ensure "4b35a86c-3c2e-59da-bb57-a43daba7d66f" :answer/validate] [:db/add "05ba5370-502b-5a4d-bcef-09bf9a9b3f13" :answer-field/id #uuid "05ba5370-502b-5a4d-bcef-09bf9a9b3f13"] [:db/add "05ba5370-502b-5a4d-bcef-09bf9a9b3f13" :answer-field/key "field-1"] [:db/add "05ba5370-502b-5a4d-bcef-09bf9a9b3f13" :answer-field/type :answer-field.type/blank] [:db/add "05ba5370-502b-5a4d-bcef-09bf9a9b3f13" :answer-field/choices "4b35a86c-3c2e-59da-bb57-a43daba7d66f"] [:db/add "05ba5370-502b-5a4d-bcef-09bf9a9b3f13" :answer-field/correct "4b35a86c-3c2e-59da-bb57-a43daba7d66f"] [:db/ensure "05ba5370-502b-5a4d-bcef-09bf9a9b3f13" :answer-field/validate] [:db/add "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/id #uuid "bf3d0d92-b517-5ce2-8c7e-0af072712ccf"] [:db/add "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/problem "![Concave quadrilateral BCDA with measurements](images/61/617032a7ed09eac2bbb2e3d72d0a6afba838a111ff39bd88ad3cb37675ebf70f.png)\n\nThe area of the quadrilateral $BCDA$ is $6\\,\\text{in}^{2}$. The sides $BC=7\\,\\text{in}$ and $BA=6.5\\,\\text{in}$ meet at $42^\\circ$. The area of $\\triangle CDA$, rounded to the **nearest integer**, is {{field-1}} $\\text{in}^{2}$.\n\nYou may use a scientific calculator."] [:db/add "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/worked-solution "First calculate the area of the enclosing triangle $BCA$. Use the two given sides and their included angle, with the calculator in degree mode.\n\n$$\n\\begin{aligned}A_{BCA}&=\\frac12\\cdot BC\\cdot BA\\cdot\\sin\\angle CBA\\\\&=\\frac12\\cdot 7\\cdot 6.5\\cdot\\sin42^\\circ\\\\&\\approx15.222721\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nThe enclosing triangle consists of the quadrilateral $BCDA$ and the missing triangle $CDA$. Subtract the quadrilateral area:\n\n$$\n\\begin{aligned}A_{CDA}&=A_{BCA}-A_{BCDA}\\\\&=22.75\\sin42^\\circ-6\\\\&\\approx9.222721\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nKeep full precision until this subtraction is complete. Rounded to the nearest integer, the area is $9\\,\\text{in}^{2}$."] [:db/add "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/requires-calculator true] [:db/add "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/difficulty :question.difficulty/hard] [:db/add "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/answer-fields "05ba5370-502b-5a4d-bcef-09bf9a9b3f13"] [:db/ensure "bf3d0d92-b517-5ce2-8c7e-0af072712ccf" :question/validate] [:db/add 17592186105906 :knowledge-point/questions "bf3d0d92-b517-5ce2-8c7e-0af072712ccf"] [:db/add "7d46abed-adfd-5b7a-93d4-ad2de4660aa4" :answer/id #uuid "7d46abed-adfd-5b7a-93d4-ad2de4660aa4"] [:db/add "7d46abed-adfd-5b7a-93d4-ad2de4660aa4" :answer/type :answer.type/math] [:db/add "7d46abed-adfd-5b7a-93d4-ad2de4660aa4" :answer/value "11\\,\\text{in}^{2}"] [:db/ensure "7d46abed-adfd-5b7a-93d4-ad2de4660aa4" :answer/validate] [:db/add "76bbb6fd-169a-53f1-a58a-9e61783513f3" :answer/id #uuid "76bbb6fd-169a-53f1-a58a-9e61783513f3"] [:db/add "76bbb6fd-169a-53f1-a58a-9e61783513f3" :answer/type :answer.type/math] [:db/add "76bbb6fd-169a-53f1-a58a-9e61783513f3" :answer/value "8\\,\\text{in}^{2}"] [:db/ensure "76bbb6fd-169a-53f1-a58a-9e61783513f3" :answer/validate] [:db/add "6af99c8b-bc8d-5a28-8758-e330d70a9d4e" :answer/id #uuid "6af99c8b-bc8d-5a28-8758-e330d70a9d4e"] [:db/add "6af99c8b-bc8d-5a28-8758-e330d70a9d4e" :answer/type :answer.type/math] [:db/add "6af99c8b-bc8d-5a28-8758-e330d70a9d4e" :answer/value "21\\,\\text{in}^{2}"] [:db/ensure "6af99c8b-bc8d-5a28-8758-e330d70a9d4e" :answer/validate] [:db/add "79c36293-2f8b-588f-9a2c-04d777e79822" :answer/id #uuid "79c36293-2f8b-588f-9a2c-04d777e79822"] [:db/add "79c36293-2f8b-588f-9a2c-04d777e79822" :answer/type :answer.type/math] [:db/add "79c36293-2f8b-588f-9a2c-04d777e79822" :answer/value "24\\,\\text{in}^{2}"] [:db/ensure "79c36293-2f8b-588f-9a2c-04d777e79822" :answer/validate] [:db/add "5df94a7d-d3d6-5a07-90ce-8740f5959801" :answer