 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10)^{2}-5" :db/id #edb/ref 17592186549484} {:answer/id #uuid "8a5616f0-230f-5380-b162-0895d7287876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}+12" :db/id #edb/ref 17592186549580} {:answer/id #uuid "a61c1956-9aa0-5bda-b2b7-c15d6dd5eb67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}+10" :db/id #edb/ref 17592186549628} {:answer/id #uuid "adae3f5a-4f4b-5c8d-b4ef-48df06cebd7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}-7" :db/id #edb/ref 17592186549640} {:answer/id #uuid "b69ae637-47df-5d0a-a406-5a5d5619d853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}-9" :db/id #edb/ref 17592186549655}] :answer-field/correct {:answer/id #uuid "b69ae637-47df-5d0a-a406-5a5d5619d853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}-9" :db/id #edb/ref 17592186549655} :answer-field/id #uuid "12b561ff-d7d5-56bf-bd70-881cdbd1aea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7d3420b-3f28-5142-8868-756f1394ea88" :question/math-academy-id "q-141537" :question/problem "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5)^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5)^{2}-9.\n$$"} {:db/id #edb/ref 17592186272299 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d689ba-bd01-5c8c-a837-e258da17c76b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+14{)}^{2}-3" :db/id #edb/ref 17592186269467} {:answer/id #uuid "1ae296bc-02a6-5a55-99a3-25dba2bf946f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+14{)}^{2}-7" :db/id #edb/ref 17592186269485} {:answer/id #uuid "5ffcd7dd-520c-591c-ade0-bccb570bf302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+7{)}^{2}+4" :db/id #edb/ref 17592186270118} {:answer/id #uuid "8349d9bd-8fcd-5ef7-9a5d-06eb9d51fbd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+7{)}^{2}-4" :db/id #edb/ref 17592186270404} {:answer/id #uuid "cb2a4019-3480-5607-9078-2f4ff9776437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+7{)}^{2}+8" :db/id #edb/ref 17592186271054}] :answer-field/correct {:answer/id #uuid "8349d9bd-8fcd-5ef7-9a5d-06eb9d51fbd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+7{)}^{2}-4" :db/id #edb/ref 17592186270404} :answer-field/id #uuid "1baba50a-215c-5218-887c-fd66335a5c56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1238a204-3e93-5785-8e78-51f3b2b7a338" :question/math-academy-id "q-141548" :question/problem "Complete the square on the quadratic expression ${y}^{2}+14y+45.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot 7y+45\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${7}^{2},$ writing the constant term $45$ last:\n\n$$\n{{y}^{2}+2\\cdot 7y+{7}^{2}}_{⏟}-\\,{7}^{2}+45\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y+7{)}^{2}-{7}^{2}+45\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y+7{)}^{2}-4.\n$$"} {:db/id #edb/ref 17592186272303 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c357baf-37ee-59ff-b900-a32da3e0955f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}-12" :db/id #edb/ref 17592186269666} {:answer/id #uuid "483df771-1e1b-56ba-bd41-370566736e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+9" :db/id #edb/ref 17592186269926} {:answer/id #uuid "57316dd8-97c9-5036-80fa-245ab789f57e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}-6" :db/id #edb/ref 17592186270038} {:answer/id #uuid "b54b1ed7-1a5c-532c-9b56-213f971511e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+3" :db/id #edb/ref 17592186270881} {:answer/id #uuid "f79469df-027d-5f1b-b7e1-dc88f72d1a36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10{)}^{2}-5" :db/id #edb/ref 17592186271440}] :answer-field/correct {:answer/id #uuid "57316dd8-97c9-5036-80fa-245ab789f57e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}-6" :db/id #edb/ref 17592186270038} 