\n\n$$\n\\begin{aligned}{y}^{2}-4y+4 & = \\\\ {y}^{2}-4y+{2}^{2} & = \\\\ {y}^{2}-2\\cdot 2y+{2}^{2} & = \\\\ (y-2{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}-4y+4)+1 & = \\\\ (y-2{)}^{2}+1 & .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272044 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} {:answer/id #uuid "2044f8ba-a526-5264-9c8b-279475bc6079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+1" :db/id #edb/ref 17592186269538} {:answer/id #uuid "4ef60e4f-a72a-5357-acf3-4233e5a280e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-25{)}^{2}+1" :db/id #edb/ref 17592186269981} {:answer/id #uuid "d1396c9b-3b30-5a34-9af3-bb9767985973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10{)}^{2}+1" :db/id #edb/ref 17592186271110} {:answer/id #uuid "e97a70aa-76d8-5b9c-aa63-ecd9752ccf4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}+1" :db/id #edb/ref 17592186271312}] :answer-field/correct {:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} :answer-field/id #uuid "501bcbfe-9b64-5b29-8ec4-43efe59a3a60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271656}] :question/difficulty {:db/id #edb/re