es "0a0ca3f8-6ec2-5ceb-9420-61226acb9dbd"] [:db/add "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e" :answer-field/choices "c20836bf-d25a-5931-8c57-23624fd4dcd8"] [:db/add "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e" :answer-field/choices "ee1576d8-f766-5770-b29f-8346e71406fd"] [:db/add "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e" :answer-field/choices "43a6ff67-f7b6-5ba9-bde9-fdf764e26855"] [:db/add "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e" :answer-field/choices "aa52c127-4dcb-5166-9837-26d2f47bde24"] [:db/add "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e" :answer-field/correct "ee1576d8-f766-5770-b29f-8346e71406fd"] [:db/ensure "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e" :answer-field/validate] [:db/add "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08" :question/id #uuid "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08"] [:db/add "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08" :question/problem "Which of the following is a distinct line parallel to $18x+3y=-12$?"] [:db/add "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08" :question/worked-solution "For two distinct nonvertical lines to be parallel, they must have the same slope.\n\nTo find the slope of $18x+3y=-12$, convert to slope-intercept form:\n\n$$\n\\begin{aligned}\n18x+3y &= -12 \\\\\n3y &= -18x-12 \\\\\ny &= -6x-4\n\\end{aligned}\n$$\n\nThe slope is the coefficient of $x$, so the required slope is $-6$.\n\nRewrite the choices in slope-intercept form:\n\n$$\n\\begin{aligned}\n-12x-2y=8 &\\quad\\Longrightarrow\\quad y=-6x-4 \\\\\n9x+12y=-24 &\\quad\\Longrightarrow\\quad y=-\\frac{3}{4}x-2 \\\\\n-18x-3y=-6 &\\quad\\Longrightarrow\\quad y=-6x+2 \\\\\n9x+12y=-36 &\\quad\\Longrightarrow\\quad y=-\\frac{3}{4}x-3 \\\\\n-6x+8y=-24 &\\quad\\Longrightarrow\\quad y=\\frac{3}{4}x-3\n\\end{aligned}\n$$\n\nThe line $-12x-2y=8$ has both the same slope $-6$ and the same $y$-intercept $-4$ as the given line. It is the same line, so it is not a distinct parallel line.\n\nThe line $-18x-3y=-6$ has slope $-6$ and $y$-intercept $2$, different from $-4$. Therefore, it is a distinct parallel line.\n\n$$\n-18x-3y=-6\n$$"] [:db/add "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08" :question/difficulty :question.difficulty/hard] [:db/add "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08" :question/answer-fields "ba1ef6d5-a23d-56e4-9f8d-f49f92a7c70e"] [:db/ensure "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08" :question/validate] [:db/add 17592186087687 :knowledge-point/questions "f8d1fb4f-c4dd-590a-ab1d-79c15fd0ec08"] [:db/add "7ff97c90-6c4e-57da-93fe-395e879e1f60" :answer/id #uuid "7ff97c90-6c4e-57da-93fe-395e879e1f60"] [:db/add "7ff97c90-6c4e-57da-93fe-395e879e1f60" :answer/type :answer.type/math] [:db/add "7ff97c90-6c4e-57da-93fe-395e879e1f60" :answer/value "4x-2y=8"] [:db/ensure "7ff97c90-6c4e-57da-93fe-395e879e1f60" :answer/validate] [:db/add "63230fc8-a101-5929-8033-993e597431fe" :answer/id #uuid "63230fc8-a101-5929-8033-993e597431fe"] [:db/add "63230fc8-a101-5929-8033-993e597431fe" :answer/type :answer.type/math] [:db/add "63230fc8-a101-5929-8033-993e597431fe" :answer/value "-6x+3y=-3"] [:db/ensure "63230fc8-a101-5929-8033-993e597431fe" :answer/validate] [:db/add "60465de2-271a-5b07-939c-62db48c705f0" :answer/id #uuid "60465de2-271a-5b07-939c-62db48c705f0"] [:db/add "60465de2-271a-5b07-939c-62db48c705f0" :answer/type :answer.type/math] [:db/add "60465de2-271a-5b07-939c-62db48c705f0" :answer/value "-6x+8y=40"] [:db/ensure "60465de2-271a-5b07-939c-62db48c705f0" :answer/validate] [:db/add "bc6ec3a5-2c71-5712-9bad-86df6d912b40" :answer/id #uuid "bc6ec3a5-2c71-5712-9bad-86df6d912b40"] [:db/add "bc6ec3a5-2c71-5712-9bad-86df6d912b40" :answer/type :answer.type/math] [:db/add "bc6ec3a5-2c71-5712-9bad-86df6d912b40" :answer/value "3x-4y=-4"] [:db/ensure "bc6ec3a5-2c71-5712-9bad-86df6d912b40" :answer/validate] [:db/add "36a83a6f-2d62-57f9-8425-cb0c80fa082f" :answer/id #uuid "36a83a6f-2d62-57f9-8425-cb0c80fa082f"] [:db/add "36a83a6f-2d62-57f9-8425-cb0c80fa082f" :answer/type :answer.type/math] [:db/add "36a83a6f-2d62-57f9-8425-cb0c80fa082f" :answer/value "-6x-3y=3"] [:db/ensure "36a83a6f-2d62-57f9-8425-cb0c80fa082f" :answer/validate] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/id #uuid "8758680c-2490-5514-bf11-cb687fb680eb"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/key "selection"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/type :answer-field.type/radio] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/choices "7ff97c90-6c4e-57da-93fe-395e879e1f60"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/choices "63230fc8-a101-5929-8033-993e597431fe"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/choices "60465de2-271a-5b07-939c-62db48c705f0"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/choices "bc6ec3a5-2c71-5712-9bad-86df6d912b40"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/choices "36a83a6f-2d62-57f9-8425-cb0c80fa082f"] [:db/add "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/correct "bc6ec3a5-2c71-5712-9bad-86df6d912b40"] [:db/ensure "8758680c-2490-5514-bf11-cb687fb680eb" :answer-field/validate] [:db/add "021eb427-e543-5644-a57d-c3d31922ff7c" :question/id #uuid "021eb427-e543-5644-a57d-c3d31922ff7c"] [:db/add "021eb427-e543-5644-a57d-c3d31922ff7c" :question/problem "Which of the following is a distinct line parallel to $6x-8y=-40$?"] [:db/add "021eb427-e543-5644-a57d-c3d31922ff7c" :question/worked-solution "For two distinct nonvertical lines to be parallel, they must have the same slope.\n\nTo find the slope of $6x-8y=-40$, convert to slope-intercept form:\n\n$$\n\\begin{aligned}\n6x-8y &= -40 \\\\\n-8y &= -6x-40 \\\\\ny &= \\frac{3}{4}x+5\n\\end{aligned}\n$$\n\nThe slope is the coefficient of $x$, so the required slope is $\\frac{3}{4}$.\n\nRewrite the choices in slope-intercept form:\n\n$$\n\\begin{aligned}\n4x-2y=8 &\\quad\\Longrightarrow\\quad y=2x-4 \\\\\n-6x+3y=-3 &\\quad\\Longrightarrow\\quad y=2x-1 \\\\\n-6x+8y=40 &\\quad\\Longrightarrow\\quad y=\\frac{3}{4}x+5 \\\\\n3x-4y=-4 &\\quad\\Longrightarrow\\quad y=\\frac{3}{4}x+1 \\\\\n-6x-3y=3 &\\quad\\Longrightarrow\\quad y=-2x-1\n\\end{aligned}\n$$\n\nThe line $-6x+8y=40$ has both the same slope $\\frac{3}{4}$ and the same $y$-intercept $5$ as the given line. It is the same line, so it is not a distinct parallel line.\n\nThe line $3x-4y=-4$ has slope $\\frac{3}{4}$ and $y$-intercept $1$, different from $5$. Therefore, it is a distinct parallel line.\n\n$$\n3x-4y=-4\n$$"] [:db/add "021eb427-e543-5644-a57d-c3d31922ff7c" :question/difficulty :question.difficulty/hard] [:db/add "021eb427-e543-5644-a57d-c3d31922ff7c" :question/answer-fields "8758680c-2490-5514-bf11-cb687fb680eb"] [:db/ensure "021eb427-e543-5644-a57d-c3d31922ff7c" :question/validate] [:db/add 17592186087687 :knowledge-point/questions "021eb427-e543-5644-a57d-c3d31922ff7c"] [:db/add "abff22a5-ccad-5021-8f5b-898b64717099" :answer/id #uuid "abff22a5-ccad-5021-8f5b-898b64717099"] [:db/add "abff22a5-ccad-5021-8f5b-898b64717099" :answer/type :answer.type/math] [:db/add "abff22a5-ccad-5021-8f5b-898b64717099" :answer/value "-12x+3y=9"] [:db/ensure "abff22a5-ccad-5021-8f5b-898b64717099" :answer/validate] [:db/add "d1c6e703-9466-5a38-8478-8ca4ed630792" :answer/id #uuid "d1c6e703-9466-5a38-8478-8ca4ed630792"] [:db/add "d1c6e703-9466-5a38-8478-8ca4ed630792" :answer/type :answer.type/math] [:db/add "d1c6e703-9466-5a38-8478-8ca4ed630792" :answer/value "6x+2y=8"] [:db/ensure "d1c6e703-9466-5a38-8478-8ca4ed630792" :answer/validate] [:db/add "fbbb4ef5-7c1b-5223-95f3-e4e7100ecf72" :answer/id #uuid "fbbb4ef5-7c1b-5223-95f3-e4e7100ecf72"] [:db/add "fbbb4ef5-7c1b-5223-95f3-e4e7100ecf72" :answer/type :answer.type/math] [:db/add "fbbb4ef5-7c1b-5223-95f3-e4e7100ecf72" :answer/value "-12x-9y=18"] [:db/ensure "fbbb4ef5-7c1b-5223-95f3-e4e7100ecf72" :answer/validate] [:db/add "de1af5ea-ad51-5edf-8c10-6eac0b2039af" :answer/id #uuid "de1af5ea-ad51-5edf-8c10-6eac0b2039af"] [:db/add "de1af5ea-ad51-5edf-8c10-6eac0b2039af" :answer/type :answer.type/math] [:db/add "de1af5ea-ad51-5edf-8c10-6eac0b2039af" :answer/val