#{[{:db/id #edb/ref 17592186049201 :topic/id #uuid "e2f84ebe-3953-57c1-b57f-978988ee6101" :topic/knowledge-points [{:db/id #edb/ref 17592186179631 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179474 :question/id #uuid "9b0cfd54-9310-59e6-91cb-5b18413ae7b3" :question/math-academy-id "e-13979" :question/problem "What is the slope of the line $4x-2y=1?$" :question/worked-solution "We can find the slope of the line if we can express its equation in slope-intercept form. To do this, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4x-2y & =1 \\\\ -2y & =-4x+1 \\\\ 2y & =4x-1 \\\\ \\frac{2y}{2} & =\\frac{4x-1}{2} \\\\ y & =\\frac{4x}{2}-\\frac{1}{2} \\\\ y & =2x-\\frac{1}{2}\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=2.$"} :knowledge-point/id #uuid "48f52c24-cd5a-5701-8ec2-1d833e87a25f" :knowledge-point/title "Finding the Slope of a Line Given Standard Form"} {:db/id #edb/ref 17592186179632 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179475 :question/id #uuid "d1904d74-7f31-5211-b7d4-88f4f5042d64" :question/math-academy-id "e-13982" :question/problem "Find the point where the line $4x-3y=8$ intersects the $x$-axis." :question/worked-solution "To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x.$\n\n$$\n\\begin{aligned}\n\t4x-3y&=8\\\\[5pt]\n\t4x-3(0)&=8\\\\[5pt]\n\t4x&=8\\\\[5pt]\n\t\\dfrac{4x}{4}&=\\dfrac{8}{4}\\\\[5pt]\n\tx&=2\n\t\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $2,$ and we conclude that the line intersects the $x$-axis at $\\left(2,0\\right).$"} :knowledge-point/id #uuid "dd8533c7-7573-5917-b347-ce72d26a7168" :knowledge-point/title "Finding the X-Intercept of a Line"} {:db/id #edb/ref 17592186179633 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179476 :question/id #uuid "cbfa4dda-a399-5450-bacd-7681aebceede" :question/math-academy-id "e-13986" :question/problem "Find the point where the line $5x -4y=-8$ intersects the $y$-axis." :question/worked-solution "To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y.$\n\n$$\n\\begin{aligned}5x-4y & =-8 \\\\ 5(0)-4y & =-8 \\\\ -4y & =-8 \\\\ y & =2\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $2,$ and we conclude that the line intersects the $y$-axis at $\\left(0,2\\right).$"} :knowledge-point/id #uuid "ee8d9c8a-51c2-56b4-8006-e768bb7fa128" :knowledge-point/title "Finding the Y-Intercept of a Line"}] :topic/math-academy-id 3725 :topic/next [{:db/id #edb/ref 17592186048353} {:db/id #edb/ref 17592186048357} {:db/id #edb/ref 17592186049063} {:db/id #edb/ref 17592186049646} {:db/id #edb/ref 17592186050245} {:db/id #edb/ref 17592186050681} {:db/id #edb/ref 17592186051055}] :topic/title "Properties of Lines Given in Standard Form"}]}
