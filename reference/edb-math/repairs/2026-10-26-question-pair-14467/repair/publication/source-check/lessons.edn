#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186088504} :activity/id #uuid "16a4de81-848b-5638-b998-ac9062204da4" :activity/scope {:db/id #edb/ref 17592186050245} :activity/steps [{:db/id #edb/ref 17592186088504 :step/content {:db/id #edb/ref 17592186088989 :tutorial/content "Two distinct lines that never intersect are said to be **parallel.** For two lines to be parallel, they must have the same slope. \n\nFor example, the lines $y=2x+4$ and $y=2x-5$ have the same slope of $m=2,$ so they are parallel. Indeed, looking at the graph, we see that the two lines never cross.\n\n![](images/c7/c7d36372d9646d0ce10eff5d35a4f9b8e56a7b37b333c5d53ac243065ee751af.png)\n\nOn the other hand, the lines $y=\\dfrac{1}{2}x+4$ and $y=2x-5$ have different slopes, so they are *not* parallel. Indeed, looking at the graph, we see that the two lines *do* cross.\n\n![](images/92/92c1ee39ccbbbf20dc3f4a7f76a1114d975fb0826eeac13d273b4b4fd9a83105.png)" :tutorial/id #uuid "2a7600a0-ce9a-5126-866d-bc3d1cf82b41" :tutorial/math-academy-id 8902 :tutorial/title "Introduction"} :step/id #uuid "cab8d9d2-3173-5553-86f8-e9fb1aecfd16" :step/math-academy-id 144181 :step/next {:db/id #edb/ref 17592186088505}} {:db/id #edb/ref 17592186088505 :step/content {:db/id #edb/ref 17592186087686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087433 :question/id #uuid "4f0593d8-bce5-5c73-aedd-ffe0faf15a59" :question/math-academy-id "e-14364" :question/problem "The lines $y=cx+7$ and $y=5x-3$ are parallel. What is the value of $c$?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nBoth lines are in slope-intercept form, so we can pick out the slope of each equation by looking at the $x$-coefficient.\n\n- The slope of the line $y=cx+7$ is $c.$\n\n- The slope of the line $y=5x-3$ is $5.$\n\nBecause the slopes must be the same, we must have $c=5.$"} :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186714623} :knowledge-point/questions [{:db/id #edb/ref 17592186088072} {:db/id #edb/ref 17592186088073} {:db/id #edb/ref 17592186088176} {:db/id #edb/ref 17592186477079} {:db/id #edb/ref 17592186477083} {:db/id #edb/ref 17592186477084} {:db/id #edb/ref 17592186477087} {:db/id #edb/ref 17592186477088} {:db/id #edb/ref 17592186502083} {:db/id #edb/ref 17592186502163} {:db/id #edb/ref 17592186713631} {:db/id #edb/ref 17592186713643} {:db/id #edb/ref 17592186713646} {:db/id #edb/ref 17592186714605} {:db/id #edb/ref 17592186714606} {:db/id #edb/ref 17592186714607} {:db/id #edb/ref 17592186714610} {:db/id #edb/ref 17592186714621} {:db/id #edb/ref 17592186714636} {:db/id #edb/ref 17592186714638} {:db/id #edb/ref 17592186714646} {:db/id #edb/ref 17592186714654}] :knowledge-point/title "Identifying Parallel Lines Given in Slope-Intercept Form"} :step/id #uuid "212176f8-846a-5cf2-ae65-698c2a23cb29" :step/math-academy-id 144182 :step/next {:db/id #edb/ref 17592186088506}} {:db/id #edb/ref 17592186088506 :step/content {:db/id #edb/ref 17592186087687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087434 :question/id #uuid "b2f31785-e173-518c-a1fd-b069e0834b2a" :question/math-academy-id "e-14367" :question/problem "Which of the following lines is parallel to $12x - y=3?$\n\nI. $y=4x-8$\n\nII. $y=12x+1$\n\nIII. $y=3x-12$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $12x-y=3,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}12x-y & =3 \\\\ -y & =-12x+3 \\\\ y & =12x-3.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $12.$\n\nFrom the given options, the only line that has a slope of $12$ is $y = 12x+1.$"} :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049201}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/question-generator {:db/id #edb/ref 17592186714408} :knowledge-point/questions [{:db/id #edb/ref 17592186087980} {:db/id #edb/ref 17592186088003} {:db/id #edb/ref 17592186088086} {:db/id #edb/ref 17592186479320} {:db/id #edb/ref 17592186479333} {:db/id #edb/ref 17592186479334} {:db/id #edb/ref 17592186479338} {:db/id #edb/ref 17592186479347} {:db/id #edb/ref 17592186502109} {:db/id #edb/ref 17592186502128} {:db/id #edb/ref 17592186502137} {:db/id #edb/ref 17592186714030} {:db/id #edb/ref 17592186714036} {:db/id #edb/ref 17592186714037} {:db/id #edb/ref 17592186714373} {:db/id #edb/ref 17592186714379} {:db/id #edb/ref 17592186714384} {:db/id #edb/ref 17592186714389} {:db/id #edb/ref 17592186714399} {:db/id #edb/ref 17592186714460} {:db/id #edb/ref 17592186714461} {:db/id #edb/ref 17592186714466} {:db/id #edb/ref 17592186714467} {:db/id #edb/ref 17592186714520} {:db/id #edb/ref 17592186714521} {:db/id #edb/ref 17592186714527} {:db/id #edb/ref 17592186714531} {:db/id #edb/ref 17592186718307} {:db/id #edb/ref 17592186718380}] :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"} :step/id #uuid "2c4f6496-c80d-521c-a439-5e19df77d71b" :step/math-academy-id 144186 :step/next {:db/id #edb/ref 17592186088507}} {:db/id #edb/ref 17592186088507 :step/content {:db/id #edb/ref 17592186087688 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087435 :question/id #uuid "88c5f90c-9bf9-58a2-a9a2-7c7ff1fc4f8a" :question/math-academy-id "e-14370" :question/problem "The lines $y=2x$ and $kx-2y=-1$ are parallel. What is the value of $k?$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- The line $y=2x$ is in slope-intercept form, and its slope is $2.$\n\n- To find the slope of the line $kx-2y=-1,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}kx-2y & =-1 \\\\ -2y & =-kx-1 \\\\ 2y & =kx+1 \\\\ y & =\\frac{k}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $\\dfrac{k}{2}.$\n\nSince the slopes of the two lines must be equal, we must have $\\dfrac{k}{2}=2.$ Consequently, $k=4.$"} :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050622}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186714599} :knowledge-point/questions [{:db/id #edb/ref 17592186088067} {:db/id #edb/ref 17592186088068} {:db/id #edb/ref 17592186478499} {:db/id #edb/ref 17592186478500} {:db/id #edb/ref 17592186478503} {:db/id #edb/ref 17592186478508} {:db/id #edb/ref 17592186478514} {:db/id #edb/ref 17592186478516} {:db/id #edb/ref 17592186478518} {:db/id #edb/ref 17592186478519} {:db/id #edb/ref 17592186478523} {:db/id #edb/ref 17592186478526} {:db/id #edb/ref 17592186502071} {:db/id #edb/ref 17592186502088} {:db/id #edb/ref 17592186570774} {:db/id #edb/ref 17592186714052} {:db/id #edb/ref 17592186714053} {:db/id #edb/ref 17592186714054} {:db/id #edb/ref 17592186714574} {:db/id #edb/ref 17592186714577} {:db/id #edb/ref 17592186714578} {:db/id #edb/ref 17592186714579} {:db/id #edb/ref 17592186714581} {:db/id #edb/ref 17592186714624} {:db/id #edb/ref 17592186714627} {:db/id #edb/ref 17592186714629} {:db/id #edb/ref 17592186714631} {:db/id #edb/ref 17592186718421} {:db/id #edb/ref 17592186719040}] :knowledge-point/title "Finding Unknown Parameters"} :step/id #uuid "67b4f73a-8039-56d5-a90d-46d17f45eab1" :step/math-academy-id 144190}] :activity/title "Parallel Lines in the Coordinate Plane" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186087910}]}
