#{[{:db/id #edb/ref 17592186087687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087434 :question/id #uuid "b2f31785-e173-518c-a1fd-b069e0834b2a" :question/math-academy-id "e-14367" :question/problem "Which of the following lines is parallel to $12x - y=3?$\n\nI. $y=4x-8$\n\nII. $y=12x+1$\n\nIII. $y=3x-12$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $12x-y=3,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}12x-y & =3 \\\\ -y & =-12x+3 \\\\ y & =12x-3.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $12.$\n\nFrom the given options, the only line that has a slope of $12$ is $y = 12x+1.$"} :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049201 :topic/id #uuid "e2f84ebe-3953-57c1-b57f-978988ee6101" :topic/knowledge-points [{:db/id #edb/ref 17592186179631} {:db/id #edb/ref 17592186179632} {:db/id #edb/ref 17592186179633}] :topic/math-academy-id 3725 :topic/next [{:db/id #edb/ref 17592186048353} {:db/id #edb/ref 17592186048357} {:db/id #edb/ref 17592186049063} {:db/id #edb/ref 17592186049646} {:db/id #edb/ref 17592186050245} {:db/id #edb/ref 17592186050681} {:db/id #edb/ref 17592186051055}] :topic/title "Properties of Lines Given in Standard Form"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy}] :knowledge-point/question-generator {:db/id #edb/ref 17592186714408 :question-generator/id #uuid "827fc582-5d3a-5a7e-b221-5e7f7d7d5a4d" :question-generator/script "generators/3e/3e5be0963253ecbaff9964bd7bbb72fade1cef7a5a1fe5d8f2f5716a3b59ee0a/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186087980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6bf01d9-1387-514b-afb5-fde88dafcb9b" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{3}{2}x + 6" :db/id #edb/ref 17592186084615