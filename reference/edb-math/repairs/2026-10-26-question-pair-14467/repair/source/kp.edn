 $-3$, different from $-2$. Therefore, it is a distinct parallel line.\n\n$$\n9x+12y=-36\n$$"} {:db/id #edb/ref 17592186714467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a33b9d84-8668-534f-9a73-796a135439ca" :answer/type {:db/ident :answer.type/math} :answer/value "-6x+8y=-24" :db/id #edb/ref 17592186714457} {:answer/id #uuid "ce10323a-2909-5e2f-9196-35cfe10b78bf" :answer/type {:db/ident :answer.type/math} :answer/value "9x+12y=-24" :db/id #edb/ref 17592186714465} {:answer/id #uuid "d76f5764-3fe9-52a1-b936-b934ba9c4ea8" :answer/type {:db/ident :answer.type/math} :answer/value "-18x-3y=-6" :db/id #edb/ref 17592186714468} {:answer/id #uuid "db031500-8018-5b22-be34-aa6e31ec3b8f" :answer/type {:db/ident :answer.type/math} :answer/value "9x+12y=-36" :db/id #edb/ref 17592186714469} {:answer/id #uuid "f461cf5e-314a-5d09-8e5a-511af9bf11ab" :answer/type {:db/ident :answer.type/math} :answer/value "-12x-2y=8" :db/id #edb/ref 17592186714470}] :answer-field/correct {:answer/id #uuid "d76f5764-3fe9-52a1-b936-b934ba9c4ea8" :answer/type {:db/ident :answer.type/math} :answer/value "-18x-3y=-6" :db/id #edb/ref 17592186714468} :answer-field/id #uuid "22c92c14-2ffd-55b8-8cfe-5516140ed3fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186714446}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d64f7da5-9842-5d17-8bd6-ebac5d6d13c1" :question/problem "Which of the following is a distinct line parallel to $-12x-2y=8$?" :question/worked-solution "For two distinct nonvertical lines to be parallel, they must have the same slope.\n\nTo find the slope of $-12x-2y=8$, convert to slope-intercept form:\n\n$$\n\\begin{aligned}\n-12x-2y &= 8 \\\\\n-2y &= 12x+8 \\\\\ny &= -6x-4\n\\end{aligned}\n$$\n\nThe slope is the coefficient of $x$, so the required slope is $-6$.\n\nRewrite the choices in slope-intercept form:\n\n$$\n\\begin{aligned}\n-12x-2y=8 &\\quad\\Longrightarrow\\quad y=-6x-4 \\\\\n9x+12y=-24 &\\quad\\Longrightarrow\\quad y=-\\frac{3}{4}x-2 \\\\\n-18x-3y=-6 &\\quad\\Longrightarrow\\quad y=-6x+2 \\\\\n9x+12y=-36 &\\quad\\Longrightarrow\\quad y=-\\frac{3}{4}x-3 \\\\\n-6x+8y=-24 &\\quad\\Longrightarrow\\quad y=\\frac{3}{4}x-3\n\\end{aligned}\n$$\n\nThe line $-12x-2y=8$ has both the same slope $-6$ and the same $y$-intercept $-4$ as the given line. It is the same line, so it is not a distinct parallel line.\n\nThe line $-18x-3y=-6$ has slope $-6$ and $y$-intercept $2$, different from $-4$. Therefore, it is a distinct parallel line.\n\n$$\n-18x-3y=-6\n$$"} {:db/id #edb/ref 17592186714520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5340a911-ca79-5ce1-bab0-e52ff4fb850c" :answer/type {:db/ident :answer.type/math} :answer/value "2x-2y=-10" :db/id #edb/ref 17592186714523} {:answer/id #uuid "8c2c9207-8979-5cdd-b122-06a54edeed5a" :answer/type {:db/ident :answer.type/math} :answer/value "-3x+2y=10" :db/id #edb/ref 17592186714533} {:answer/id #uuid "ba830b5b-f203-5cf5-81eb-b0b09c6da81c" :answer/type {:db/ident :answer.type/math} :answer/value "9x-3y=6" :db/id #edb/ref 17592186714539} {:answer/id #uuid "cd639398-7de7-5b30-aa4c-7354feee80f7" :answer/type {:db/ident :answer.type/math} :answer/value "-9x-3y=-6" :db/id #edb/ref 17592186714540} {:answer/id #uuid "e4d0c16c-4f0d-5b15-af17-ddd00e63f861" :answer/type {:db/ident :answer.type/math} :answer/value "15x+3y=15" :db/id #edb/ref 17592186714543}] :answer-field/correct {:answer/id #uuid "5340a911-ca79-5ce1-bab0-e52ff4fb850c" :answer/type {:db/ident :answer.type/math} :answer/value "2x-2y=-10" :db/id #edb/ref 17592186714523} :answer-field/id #uuid "58178807-1699-591d-a607-3bfbc749e509" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186714524}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a8c2163-44d0-5249-8984-a3542ff3cd4b" :question/problem "Which of the following lines is parallel to $2x-2y=4$?" :question/worked-solution "For two distinct nonvertical lines to be parallel, they must have the same slope.\n\nTo find the slope of $2x-2y=4$, convert to slope-intercept form:\n\n$$\n\\begin{aligned}\n2x-2y &= 4 \\\\\n-2y &= -2x+4 \\\\\ny &= x-2\n\\end{aligned}\n$$\n\nThe slope is the coefficient of $x$, so the required slope is $1$.\n\nRewrite the choices in slope-intercept form:\n\n$$\n\\begin{aligned}\n-3x+2y=10 &\\quad\\Longrightarrow\\quad y=\\frac{3}{2}x+5 \\\\\n9x-3y=6 &\\quad\\Longrightarrow\\quad y=3x-2 \\\\\n-9x-3y=-6 &\\quad\\Longrightarrow\\quad y=-3x+2 \\\\\n15x+3y=15 &\\quad\\Longrightarrow\\quad y=-5x+5 \\\\\n2x-2y=-10 &\\quad\\Longrightarrow\\quad y=x+5\n\\end{aligned}\n$$\n\nOnly $2x-2y=-10$ has slope $1$.\n\nThe line $2x-2y=-10$ has slope $1$ and $y$-intercept $5$, different from $-2$. Therefore, it is a distinct parallel line.\n\n$$\n2x-2y=-10\n$$"} {:db/id #edb/ref 17592186714521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23199f91-e427-5936-b9a9-2c0eb3fe7a20" :answer/type {:db/ident :answer.type/math} :answer/value "-9x-3y=-6" :db/id #edb/ref 17592186714518} {:answer/id #uuid "709cfbf4-8715-5ea2-a993-774dff7f9070" :answer/type {:db/ident :answer.type/math} :answer/value "-3x+2y=10" :db/id #edb/ref 17592186714528} {:answer/id #uuid "79230eda-f7f9-5f22-aa23-76e08ac1cfc4" :answer/type {:db/ident :answer.type/math} :answer/value "15x+3y=15" :db/id #edb/ref 17592186714530} {:answer/id #uuid "ba4cb998-d881-56e6-a7f5-0a68b1215d0f" :answer/type {:db/ident :answer.type/math} :answer/value "2x-2y=-10" :db/id #edb/ref 17592186714538} {:answer/id #uuid "d77c15d4-367b-5f35-81f1-260369d1e033" :answer/type {:db/ident :answer.type/math} :answer/value "9x-3y=6" :db/id #edb/ref 17592186714542}] :answer-field/correct {:answer/id #uuid "d77c15d4-367b-5f35-81f1-260369d1e033" :answer/type {:db/ident :answer.type/math} :answer/value "9x-3y=6" :db/id #edb/ref 17592186714542} :answer-field/id #uuid "4310e8bb-2470-5fad-a6f7-e83630