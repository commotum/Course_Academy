#{[{:db/id #edb/ref 17592186059798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059597 :question/id #uuid "90177be7-ab0c-531b-b07b-778004ad6f2b" :question/math-academy-id "e-5185" :question/problem "An asset has been depreciating in value for the past $10$ years at an annual, continuously-compounded rate of $6\\%$. If that asset was initially worth $\\$13\\,500$, what is it worth now? Round your answer to the nearest dollar." :question/worked-solution "The continuously compounded growth equation is\n\n$$\n\\begin{aligned} P &= P_0e^{rt}. \\end{aligned}\n$$\n\nWe have an initial amount of\n\n$$\nP_0=13\\,500\n$$\n\na rate of $r=-0.06$, and a time duration of $t=10$ years. Substituting these values into the formula, we get\n\n$$\n\\begin{aligned} P &= P_0e^{rt} \\\\ &= 13\\,500e^{(-0.06)(10)} \\\\[3pt] &= 13\\,500e^{-0.6} \\\\[3pt] &= 13\\,500(0.548\\,81...) \\\\[3pt] &\\approx 7\\,409. \\end{aligned}\n$$\n\nTherefore, after $10$ years, the value of the asset has decreased to $\\$7\\,409$."} :knowledge-point/id #uuid "3dcfc681-0632-57a5-bd1e-e03d91d13f37" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049643 :topic/id #uuid "078cdd1c-3c63-520c-a331-823f69f948c9" :topic/knowledge-points [{:db/id #edb/ref 17592186110622} {:db/id #edb/ref 17592186110623} {:db/id #edb/ref 17592186110624}] :topic/math-academy-id 1481 :topic/next [{:db/id #edb/ref 17592186049665} {:db/id #edb/ref 17592186051065}] :topic/title "Modeling With Compound Interest"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/unobserved}] :knowledge-point/question-generator {:db/id #edb/ref 17592186718632 :question-generator/id #uuid "c6b4a59a-7c7e-5b35-b852-4a9db1db81e6" :question-generator/script "generators/75/751b1c1ce598970f0af1e83e67756b0c7a47300945cbaef64c13e98bdb72dc20/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c6f651a-51fb-5501-93cd-e7c6d2bac6ce" :answer/type {:db/ident :answer.type/math} :answer/value "3190" :db/id #edb/ref 17592186056707} {:answer/id #uuid "e59beb44-142d-554a-83d9-e6e3674c014a" :answer/type {:db/ident :answer.type/math} :answer/value "2411" :db/id #edb/ref 17592186056708} {:answer/id #uuid "ebe35416-f590-5375-8b9b-f9fcdc4feed3" :answer/type {:db/ident :answer.type/math} :answer/value "1987" :db/id #edb/ref 17592186056709} {:answer/id #uuid "f39577a4-4cb1-580f-a739-fd7a3c563124" :answer/type {:db/ident :answer.type/math} :answer/value "4019" :db/id #edb/ref 17592186056710} {:answer/id #uuid "71af604f-d21d-5162-8121-4055ca1595d7" :answer/type {:db/ident :answer.type/math} :answer/value "3156" :db/id #edb/ref 17592186056711}] :answer-field/correct {:answer/id #uuid "71af604f-d21d-5162-8121-4055ca1595d7" :answer/type {:db/ident :answer.type/math} :answer/value "3156" :db/id #edb/ref 17592186056711} :answer-field/id #uuid "7aef9cdf-cce8-5a5d-aa79-a95cdafe817a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056706}] :question/id #uuid "051effd0-f0ca-56ac-80f4-c13fb6384d81" :question/math-academy-id "q-1442" :question/problem "In the year $2009$, there were approximately $4120$ crimes in a particular city. The police department then promised a $3.81 \\mathrm{\\% }$ annual *decrease* in crime, continuously compounded. According to this model, how many crimes occurred in $2016$? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. Here $P_0=4120$, $r=-0.0381$ per year, and $t=2016-2009=7$ years. Substitute:\n\n$$\n\\begin{aligned}\nP &= 4120e^{(-0.0381)(7)} \\\\\n&= 4120e^{-0.2667} \\\\\n&\\approx 3155.5196.\n\\end{aligned}\n$$\n\nRounding to the nearest integer gives approximately $3156$ crimes in $2016$."} {:db/id #edb/ref 17592186060059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a795c7d9-52a6-5fbb-bfe2-98ab7631700f" :answer/type {:db/ident :answer.type/math} :answer/value "1897" :db/id #edb/ref 17592186056713} {:answer/id #uuid "b9d74518-2d15-5c66-b56f-878e030290ad" :answer/type {:db/ident :answer.type/math} :answer/value "2465" :db/id #edb/ref 17592186056714} {:answer/id #uuid "3cbbc84b-442c-576f-98d1-3905aabd784f" :answer/type {:db/ident :answer.type/math} :answer/value "791" :db/id #edb/ref 17592186056715} {:answer/id #uuid "4e95bef9-62a1-5376-8223-698dff01fbac" :answer/type {:db/ident :answer.type/math} :answer/value "2781" :db/id #edb/ref 17592186056716} {:answer/id #uuid "5657d9c1-82f1-59f8-835c-4836911a18e9" :answer/type {:db/ident :answer.type/math} :answer/value "2364" :db/id #edb/ref 17592186056717}] :answer-field/correct {:answer/id #uuid "3cbbc84b-442c-576f-98d1-3905aabd784f" :answer/type {:db/ident :answer.type/math} :answer/value "791" :db/id #edb/ref 17592186056715} :answer-field/id #uuid "c2b1290a-baee-5c94-bd1a-cc187dad454c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056712}] :question/id #uuid "c9077fb0-4ca3-538c-9a63-2f4162f39301" :question/math-academy-id "q-1445" :question/problem "In medieval times, there were $9830$ people living in a city struck by a plague. If the disease resulted in a daily *decrease* in the population at a continuously compounded rate of $18 \\mathrm{\\% } ,$ what was the city's population after $2$ weeks? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. Here $P_0=9830$ and $r=-0.18$ per day. Convert $2$ weeks to $t=14$ days, then substitute:\n\n$$\n\\begin{aligned}\nP &= 9830e^{(-0.18)(14)} \\\\\n&= 9830e^{-2.52} \\\\\n&\\approx 790.9179.\n\\end{aligned}\n$$\n\nRounding to the nearest integer gives approximately $791$ people."} {:db/id #edb/ref 17592186676365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "281ce7cd-75bd-525f-b070-a847f2ebaf4b" :answer/type {:db/ident :answer.type/math} :answer/value "6196" :db/id #edb/ref 17592186676360} {:answer/id #uuid "87f5bfa7-88f3-5afa-a30a-75b0e0af97fe" :answer/type {:db/ident :answer.type/math} :answer/value "4163" :db/id #edb/ref 17592186676372} {:answer/id #uuid "979d9353-e771-5fe7-baec-282f4e2ff3d8" :answer/type {:db/ident :answer.type/math} :answer/value "5964" :db/id #edb/ref 17592186676376} {:answer/id #uuid "aba8c665-5e72-587e-a064-4602ba23a281" :answer/type {:db/ident :answer.type/math} :answer/value "6173" :db/id #edb/ref 17592186676378} {:answer/id #uuid "bc8b2883-af5b-59d0-abf4-b2accbe58bf7" :answer/type {:db/ident :answer.type/math} :answer/value "8900" :db/id #edb/ref 17592186676381}] :answer-field/correct {:answer/id #uuid "aba8c665-5e72-587e-a064-4602ba23a281" :answer/type {:db/ident :answer.type/math} :answer/value "6173" :db/id #edb/ref 17592186676378} :answer-field/id #uuid "37ae0f79-55ed-5e57-88a6-2f7362ba9443" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676364}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3baaacd5-ce43-59a2-b728-fb3d5a7a28e0" :question/problem "In the year $2014$, there were approximately $8990$ crimes in a particular city. The police department then promised a $4.7\\%$ annual *decrease* in crime, continuously compounded. According to this model, how many crimes occurred in $2022$? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. The initial amount is $P_0=8990$. Since the amount decreases, the signed decimal rate is $r=-4.7/100=-0.047$. The elapsed time is $t=2022-2014=8$ years.\n\nSubstitute these values and round only the final amount:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n&= 8990e^{(-0.047)(8)} \\\\\n&= 8990e^{-0.376} \\\\\n&= 8990(0.6866023\\ldots) \\\\\n&\\approx 6173\n\\end{aligned}\n$$\n\nAccording to this model, approximately $6173$ crimes occurred in $2022$."} {:db/id #edb/ref 17592186676367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04485d0f-3f7a-59db-9aef-fb8411716374" :answer/type {:db/ident :answer.type/math} :answer/value "935" :db/id #edb/ref 17592186676353} {:answer/id #uuid "807bb38b-5e8d-5584-9db0-17f05605881a" :answer/type {:db/ident :answer.type/math} :answer/value "4290" :db/id #edb/ref 17592186676371} {:answer/id #uuid "e07b1d93-fba5-52db-86e2-e69cd56916f2" :answer/type {:db/ident :answer.type/math} :answer/value "2418" :db/id #edb/ref 17592186676384} {:answer/id #uuid "e6de0a79-a0fa-5c42-92df-9de589be7f94" :answer/type {:db/ident :answer.type/math} :answer/value "3241" :db/id #edb/ref 17592186676386} {:answer/id #uuid "ed36c281-a90f-5ab1-8917-8bf42bccea4b" :answer/type {:db/ident :answer.type/math} :answer/value "195" :db/id #edb/ref 17592186676387}] :answer-field/correct {:answer/id #uuid "e6de0a79-a0fa-5c42-92df-9de589be7f94" :answer/type {:db/ident :answer.type/math} :answer/value "3241" :db/id #edb/ref 17592186676386} :answer-field/id #uuid "939ecfb2-57f8-568c-8c8c-78970d1045a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676375}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3cb6a6d9-d90c-5424-8cd2-1b6b6fde595b" :question/problem "In medieval times, there were $9660$ people living in a city struck by a plague. If the disease resulted in a daily *decrease* in the population at a continuously compounded rate of $5.2\\%$, what was the city's population after $3$ weeks? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. The initial amount is $P_0=9660$. Since the amount decreases, the signed decimal rate is $r=-5.2/100=-0.052$. The rate is daily, so convert the duration to days: $t=3\\times 7=21$ days.\n\nSubstitute these values and round only the final amount:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n&= 9660e^{(-0.052)(21)} \\\\\n&= 9660e^{-1.092} \\\\\n&= 9660(0.3355447\\ldots) \\\\\n&\\approx 3241\n\\end{aligned}\n$$\n\nAfter $3$ weeks, the population was approximately $3241$ people."} {:db/id #edb/ref 17592186676373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d257551-e35c-5207-9243-1a4da759d210" :answer/type {:db/ident :answer.type/math} :answer/value "2395" :db/id #edb/ref 17592186676355} {:answer/id #uuid "2540320f-0d7b-5fcb-a660-fcf1de91cea6" :answer/type {:db/ident :answer.type/math} :answer/value "7367" :db/id #edb/ref 17592186676358} {:answer/id #uuid "273e80d1-df98-56f2-9507-8d44699e009e" :answer/type {:db/ident :answer.type/math} :answer/value "13674" :db/id #edb/ref 17592186676359} {:answer/id #uuid "2c2def10-79aa-539e-89ea-171e75397758" :answer/type {:db/ident :answer.type/math} :answer/value "17715" :db/id #edb/ref 17592186676362} {:answer/id #uuid "3c521202-85bd-5399-beb8-be2ae71319e9" :answer/type {:db/ident :answer.type/math} :answer/value "17320" :db/id #edb/ref 17592186676366}] :answer-field/correct {:answer/id #uuid "3c521202-85bd-5399-beb8-be2ae71319e9" :answer/type {:db/ident :answer.type/math} :answer/value "17320" :db/id #edb/ref 17592186676366} :answer-field/id #uuid "9acd7707-ff3e-5c11-a573-1a5e4ac65e6f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676377}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "894ca8fd-a74a-585e-ad54-7c29860968cb" :question/problem "In the year $2006$, there were approximately $19180$ crimes in a particular city. The police department then promised a $5.1\\%$ annual *decrease* in crime, continuously compounded. According to this model, how many crimes occurred in $2008$? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. The initial amount is $P_0=19180$. Since the amount decreases, the signed decimal rate is $r=-5.1/100=-0.051$. The elapsed time is $t=2008-2006=2$ years.\n\nSubstitute these values and round only the final amount:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n&= 19180e^{(-0.051)(2)} \\\\\n&= 19180e^{-0.102} \\\\\n&= 19180(0.9030295\\ldots) \\\\\n&\\approx 17320\n\\end{aligned}\n$$\n\nAccording to this model, approximately $17320$ crimes occurred in $2008$."} {:db/id #edb/ref 17592186676380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bed54f6-e9b5-579f-9532-810ec4b5064c" :answer/type {:db/ident :answer.type/math} :answer/value "4683" :db/id #edb/ref 17592186676357} {:answer/id #uuid "29611da7-14a4-5c74-a979-430dfe99ff17" :answer/type {:db/ident :answer.type/math} :answer/value "5825" :db/id #edb/ref 17592186676361} {:answer/id #uuid "322ecb41-2c37-566d-9df1-42471c1cddbd" :answer/type {:db/ident :answer.type/math} :answer/value "6182" :db/id #edb/ref 17592186676363} {:answer/id #uuid "4561de8e-f07d-5935-bc0e-aada72a05a90" :answer/type {:db/ident :answer.type/math} :answer/value "5985" :db/id #edb/ref 17592186676368} {:answer/id #uuid "6cbd8192-ee84-5762-8a25-ec77a0e938af" :answer/type {:db/ident :answer.type/math} :answer/value "4645" :db/id #edb/ref 17592186676370}] :answer-field/correct {:answer/id #uuid "6cbd8192-ee84-5762-8a25-ec77a0e938af" :answer/type {:db/ident :answer.type/math} :answer/value "4645" :db/id #edb/ref 17592186676370} :answer-field/id #uuid "0ad5b29c-d2a8-5cd3-a8ee-e4bcc75e6042" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676354}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b430f767-4592-541a-b047-59097359d724" :question/problem "In the year $1996$, there were approximately $6500$ crimes in a particular city. The police department then promised a $4.2\\%$ annual *decrease* in crime, continuously compounded. According to this model, how many crimes occurred in $2004$? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. The initial amount is $P_0=6500$. Since the amount decreases, the signed decimal rate is $r=-4.2/100=-0.042$. The elapsed time is $t=2004-1996=8$ years.\n\nSubstitute these values and round only the final amount:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n&= 6500e^{(-0.042)(8)} \\\\\n&= 6500e^{-0.336} \\\\\n&= 6500(0.7146231\\ldots) \\\\\n&\\approx 4645\n\\end{aligned}\n$$\n\nAccording to this model, approximately $4645$ crimes occurred in $2004$."} {:db/id #edb/ref 17592186676383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1480e555-ffbf-5106-9203-305f7f75be76" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186676356} {:answer/id #uuid "59be0d94-9790-5c02-8357-f44d19c4c97f" :answer/type {:db/ident :answer.type/math} :answer/value "2627" :db/id #edb/ref 17592186676369} {:answer/id #uuid "abd60026-61dd-535c-8d74-52451eb315b0" :answer/type {:db/ident :answer.type/math} :answer/value "994" :db/id #edb/ref 17592186676379} {:answer/id #uuid "d170e0e5-ab44-5c56-b875-0336249787d4" :answer/type {:db/ident :answer.type/math} :answer/value "643" :db/id #edb/ref 17592186676382} {:answer/id #uuid "e42952a4-78ea-5507-ab03-9ee303b01154" :answer/type {:db/ident :answer.type/math} :answer/value "1784" :db/id #edb/ref 17592186676385}] :answer-field/correct {:answer/id #uuid "abd60026-61dd-535c-8d74-52451eb315b0" :answer/type {:db/ident :answer.type/math} :answer/value "994" :db/id #edb/ref 17592186676379} :answer-field/id #uuid "897180fb-f477-5896-8afd-c3c124f31bd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676374}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d70606cc-3373-5e20-bd92-6ee87d5c95c9" :question/problem "In medieval times, there were $2630$ people living in a city struck by a plague. If the disease resulted in a daily *decrease* in the population at a continuously compounded rate of $13.9\\%$, what was the city's population after $1$ weeks? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "The continuously compounded growth equation is $P=P_0e^{rt}$. The initial amount is $P_0=2630$. Since the amount decreases, the signed decimal rate is $r=-13.9/100=-0.139$. The rate is daily, so convert the duration to days: $t=1\\times 7=7$ days.\n\nSubstitute these values and round only the final amount:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n&= 2630e^{(-0.139)(7)} \\\\\n&= 2630e^{-0.973} \\\\\n&= 2630(0.3779474\\ldots) \\\\\n&\\approx 994\n\\end{aligned}\n$$\n\nAfter $1$ weeks, the population was approximately $994$ people."}] :knowledge-point/title "Calculating a Final Amount After Continuous Compounding Is Applied"}]}
