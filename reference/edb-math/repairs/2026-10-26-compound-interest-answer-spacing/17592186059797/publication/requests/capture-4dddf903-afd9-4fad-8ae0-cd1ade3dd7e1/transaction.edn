49e" :answer-field/validate] [:db/add "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/id #uuid "dd13a5ec-3f35-5991-8ad7-2b401a1a0073"] [:db/add "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/problem "There are currently $543$ koalas living in a secluded forest, but their population is decreasing at a continuously compounded rate of $2.9\\%$ per year. How many years must pass for there to be only $23$ koalas left in that forest? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question."] [:db/add "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/worked-solution "The initial population is $P_0=543$ and the final population is $P=23$. A decrease of $2.9\\%$ per year means $r=-0.029$, with $t$ in years.\n\nUse the continuously compounded growth equation, isolate the exponential, take natural logarithms, and solve:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n23 &= 543e^{-0.029t} \\\\\ne^{-0.029t} &= \\frac{23}{543} \\\\\n\\ln\\left(e^{-0.029t}\\right) &= \\ln\\left(\\frac{23}{543}\\right) \\\\\n-0.029t &= \\ln\\left(\\frac{23}{543}\\right) \\\\\nt &= \\frac{\\ln\\left(\\frac{23}{543}\\right)}{-0.029} \\\\\nt &\\approx 109.02121 \\\\\nt &\\approx 109\\text{ years}\n\\end{aligned}\n$$\n\nTherefore, the time is approximately $109$ years."] [:db/add "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/requires-calculator true] [:db/add "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/difficulty :question.difficulty/moderate] [:db/add "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/answer-fields "a9206112-579e-5e6a-9e48-dcd910b9c49e"] [:db/ensure "dd13a5ec-3f35-5991-8ad7-2b401a1a0073" :question/validate] [:db/add 17592186059797 :knowledge-point/questions "dd13a5ec-3f35-5991-8ad7-2b401a1a0073"] [:db/add "7d3a3d21-e3e1-5503-8ce4-d06000037f07" :answer/id #uuid "7d3a3d21-e3e1-5503-8ce4-d06000037f07"] [:db/add "7d3a3d21-e3e1-5503-8ce4-d06000037f07" :answer/type :answer.type/text] [:db/add "7d3a3d21-e3e1-5503-8ce4-d06000037f07" :answer/value "$61\\%$ per minute"] [:db/ensure "7d3a3d21-e3e1-5503-8ce4-d06000037f07" :answer/validate] [:db/add "430db582-af40-570b-a5c3-4ef1c2f0d034" :answer/id #uuid "430db582-af40-570b-a5c3-4ef1c2f0d034"] [:db/add "430db582-af40-570b-a5c3-4ef1c2f0d034" :answer/type :answer.type/text] [:db/add "430db582-af40-570b-a5c3-4ef1c2f0d034" :answer/value "$64\\%$ per minute"] [:db/ensure "430db582-af40-570b-a5c3-4ef1c2f0d034" :answer/validate] [:db/add "40e81a47-41a8-5efe-b8ba-544e5d50b471" :answer/id #uuid "40e81a47-41a8-5efe-b8ba-544e5d50b471"] [:db/add "40e81a47-41a8-5efe-b8ba-544e5d50b471" :answer/type :answer.type/text] [:db/add "40e81a47-41a8-5efe-b8ba-544e5d50b471" :answer/value "$57\\%$ per minute"] [:db/ensure "40e81a47-41a8-5efe-b8ba-544e5d50b471" :answer/validate] [:db/add "c3fc5218-26f5-564f-b70c-a8e66705d04a" :answer/id #uuid "c3fc5218-26f5-564f-b70c-a8e66705d04a"] [:db/add "c3fc5218-26f5-564f-b70c-a8e66705d04a" :answer/type :answer.type/text] [:db/add "c3fc5218-26f5-564f-b70c-a8e66705d04a" :answer/value "$54\\%$ per minute"] [:db/ensure "c3fc5218-26f5-564f-b70c-a8e66705d04a" :answer/validate] [:db/add "70786690-4a26-54db-9ea8-72c5999e4729" :answer/id #uuid "70786690-4a26-54db-9ea8-72c5999e4729"] [:db/add "70786690-4a26-54db-9ea8-72c5999e4729" :answer/type :answer.type/text] [:db/add "70786690-4a26-54db-9ea8-72c5999e4729" :answer/value "$67\\%$ per minute"] [:db/ensure "70786690-4a26-54db-9ea8-72c5999e4729" :answer/validate] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/id #uuid "890957f7-308f-5ec1-b8ff-30e14a3050ba"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/key "selection"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/type :answer-field.type/radio] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/choices "7d3a3d21-e3e1-5503-8ce4-d06000037f07"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/choices "430db582-af40-570b-a5c3-4ef1c2f0d034"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/choices "40e81a47-41a8-5efe-b8ba-544e5d50b471"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/choices "c3fc5218-26f5-564f-b70c-a8e66705d04a"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/choices "70786690-4a26-54db-9ea8-72c5999e4729"] [:db/add "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/correct "7d3a3d21-e3e1-5503-8ce4-d06000037f07"] [:db/ensure "890957f7-308f-5ec1-b8ff-30e14a3050ba" :answer-field/validate] [:db/add "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/id #uuid "f6ec8216-66e5-56d8-884e-056c853ffa5a"] [:db/add "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/problem "In a biology class, the teacher began the experiment with $34$ bacteria in a petri dish. After $7$ minutes, the number of bacteria increased to $2372$. What was the continuously compounded growth rate of the bacteria? Round your answer to the nearest percent.\n\n> A scientific calculator is required to answer this question."] [:db/add "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/worked-solution "The initial population is $P_0=34$, the final population is $P=2372$, and the elapsed time is $t=7$ minutes. The decimal rate $r$ is per minute.\n\nUse the continuously compounded growth equation, isolate the exponential, take natural logarithms, and solve:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n2372 &= 34e^{7r} \\\\\ne^{7r} &= \\frac{2372}{34} \\\\\n\\ln\\left(e^{7r}\\right) &= \\ln\\left(\\frac{2372}{34}\\right) \\\\\n7r &= \\ln\\left(\\frac{2372}{34}\\right) \\\\\nr &= \\frac{\\ln\\left(\\frac{2372}{34}\\right)}{7} \\\\\nr &\\approx 0.6064469 \\\\\n100r &\\approx 60.64469\n\\end{aligned}\n$$\n\nConverting the decimal rate to a percentage and rounding to the nearest percent gives approximately $61\\%$ per minute."] [:db/add "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/requires-calculator true] [:db/add "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/difficulty :question.difficulty/moderate] [:db/add "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/answer-fields "890957f7-308f-5ec1-b8ff-30e14a3050ba"] [:db/ensure "f6ec8216-66e5-56d8-884e-056c853ffa5a" :question/validate] [:db/add 17592186059797 :knowledge-point/questions "f6ec8216-66e5-56d8-884e-056c853ffa5a"] [:db/add "generator" :question-generator/id #uuid "8ccd4862-b3c9-55fe-ae09-a880bf789cd6"] [:db/add "generator" :question-generator/script "generators/1f/1f6f4f6ff6650b7667b27bedf17177990dd5b22b40985ed2f42b8e0abf813cbe/generator.py"] [:db/add 17592186059797 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059797 :knowledge-point/validate] [:db/cas 17592186676439 :question/retired nil true] [:db/cas 17592186676440 :question/retired nil true] [:db/cas 17592186676442 :question/retired nil true] [:db/cas 17592186676450 :question/retired nil true] [:db/cas 17592186676460 :question/retired nil true]]
