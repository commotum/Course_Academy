/choices "a666c559-f529-56ad-9486-a2b1e8b2db68"] [:db/add "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc" :answer-field/choices "ebb1a0bf-293e-56a7-a6cb-2bd758c22d7b"] [:db/add "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc" :answer-field/choices "4d6b8174-642d-58e0-ae3d-4406879ea648"] [:db/add "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc" :answer-field/choices "ee77ff5d-d3ef-5a08-a02e-371a3435c0e2"] [:db/add "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc" :answer-field/choices "ef913d26-3ead-5e56-a257-bb5a581f5780"] [:db/add "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc" :answer-field/correct "ebb1a0bf-293e-56a7-a6cb-2bd758c22d7b"] [:db/ensure "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc" :answer-field/validate] [:db/add "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/id #uuid "88863802-911c-559b-a7a4-c6fd80ee55d9"] [:db/add "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/problem "There are currently $498$ koalas living in a secluded forest, but their population is decreasing at a continuously compounded rate of $3.4\\%$ per year. How many years must pass for there to be only $12$ koalas left in that forest? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question."] [:db/add "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/worked-solution "The initial population is $P_0=498$ and the final population is $P=12$. A decrease of $3.4\\%$ per year means $r=-0.034$, with $t$ in years.\n\nUse the continuously compounded growth equation, isolate the exponential, take natural logarithms, and solve:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n12 &= 498e^{-0.034t} \\\\\ne^{-0.034t} &= \\frac{12}{498} \\\\\n\\ln\\left(e^{-0.034t}\\right) &= \\ln\\left(\\frac{12}{498}\\right) \\\\\n-0.034t &= \\ln\\left(\\frac{12}{498}\\right) \\\\\nt &= \\frac{\\ln\\left(\\frac{12}{498}\\right)}{-0.034} \\\\\nt &\\approx 109.57922 \\\\\nt &\\approx 110\\text{ years}\n\\end{aligned}\n$$\n\nTherefore, the time is approximately $110$ years."] [:db/add "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/requires-calculator true] [:db/add "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/difficulty :question.difficulty/moderate] [:db/add "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/answer-fields "fb70bd51-1fd8-57f8-b3ab-44c130aa64bc"] [:db/ensure "88863802-911c-559b-a7a4-c6fd80ee55d9" :question/validate] [:db/add 17592186059797 :knowledge-point/questions "88863802-911c-559b-a7a4-c6fd80ee55d9"] [:db/add "9718cd12-6a3a-59f8-9358-ca178c4f0045" :answer/id #uuid "9718cd12-6a3a-59f8-9358-ca178c4f0045"] [:db/add "9718cd12-6a3a-59f8-9358-ca178c4f0045" :answer/type :answer.type/text] [:db/add "9718cd12-6a3a-59f8-9358-ca178c4f0045" :answer/value "$19\\%$ per minute"] [:db/ensure "9718cd12-6a3a-59f8-9358-ca178c4f0045" :answer/validate] [:db/add "60a3693b-c84e-5489-821d-08e118be639f" :answer/id #uuid "60a3693b-c84e-5489-821d-08e118be639f"] [:db/add "60a3693b-c84e-5489-821d-08e118be639f" :answer/type :answer.type/text] [:db/add "60a3693b-c84e-5489-821d-08e118be639f" :answer/value "$30\\%$ per minute"] [:db/ensure "60a3693b-c84e-5489-821d-08e118be639f" :answer/validate] [:db/add "0822be71-2c04-5d27-b42f-62e8fe74b25e" :answer/id #uuid "0822be71-2c04-5d27-b42f-62e8fe74b25e"] [:db/add "0822be71-2c04-5d27-b42f-62e8fe74b25e" :answer/type :answer.type/text] [:db/add "0822be71-2c04-5d27-b42f-62e8fe74b25e" :answer/value "$22\\%$ per minute"] [:db/ensure "0822be71-2c04-5d27-b42f-62e8fe74b25e" :answer/validate] [:db/add "99891059-8278-5f3d-bad3-bf3531b618f2" :answer/id #uuid "99891059-8278-5f3d-bad3-bf3531b618f2"] [:db/add "99891059-8278-5f3d-bad3-bf3531b618f2" :answer/type :answer.type/text] [:db/add "99891059-8278-5f3d-bad3-bf3531b618f2" :answer/value "$14\\%$ per minute"] [:db/ensure "99891059-8278-5f3d-bad3-bf3531b618f2" :answer/validate] [:db/add "170d0680-a11f-55df-b42b-ffc13dd8fdcc" :answer/id #uuid "170d0680-a11f-55df-b42b-ffc13dd8fdcc"] [:db/add "170d0680-a11f-55df-b42b-ffc13dd8fdcc" :answer/type :answer.type/text] [:db/add "170d0680-a11f-55df-b42b-ffc13dd8fdcc" :answer/value "$33\\%$ per minute"] [:db/ensure "170d0680-a11f-55df-b42b-ffc13dd8fdcc" :answer/validate] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/id #uuid "b6e01186-83ec-5681-9bc8-c56b5eedba65"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/key "selection"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/type :answer-field.type/radio] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/choices "9718cd12-6a3a-59f8-9358-ca178c4f0045"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/choices "60a3693b-c84e-5489-821d-08e118be639f"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/choices "0822be71-2c04-5d27-b42f-62e8fe74b25e"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/choices "99891059-8278-5f3d-bad3-bf3531b618f2"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/choices "170d0680-a11f-55df-b42b-ffc13dd8fdcc"] [:db/add "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/correct "99891059-8278-5f3d-bad3-bf3531b618f2"] [:db/ensure "b6e01186-83ec-5681-9bc8-c56b5eedba65" :answer-field/validate] [:db/add "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/id #uuid "7ad32226-32ee-52d3-ad07-c7cf248ffbb3"] [:db/add "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/problem "In a biology class, the teacher began the experiment with $25$ bacteria in a petri dish. After $14$ minutes, the number of bacteria increased to $184$. What was the continuously compounded growth rate of the bacteria? Round your answer to the nearest percent.\n\n> A scientific calculator is required to answer this question."] [:db/add "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/worked-solution "The initial population is $P_0=25$, the final population is $P=184$, and the elapsed time is $t=14$ minutes. The decimal rate $r$ is per minute.\n\nUse the continuously compounded growth equation, isolate the exponential, take natural logarithms, and solve:\n\n$$\n\\begin{aligned}\nP &= P_0e^{rt} \\\\\n184 &= 25e^{14r} \\\\\ne^{14r} &= \\frac{184}{25} \\\\\n\\ln\\left(e^{14r}\\right) &= \\ln\\left(\\frac{184}{25}\\right) \\\\\n14r &= \\ln\\left(\\frac{184}{25}\\right) \\\\\nr &= \\frac{\\ln\\left(\\frac{184}{25}\\right)}{14} \\\\\nr &\\approx 0.1425757 \\\\\n100r &\\approx 14.25757\n\\end{aligned}\n$$\n\nConverting the decimal rate to a percentage and rounding to the nearest percent gives approximately $14\\%$ per minute."] [:db/add "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/requires-calculator true] [:db/add "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/difficulty :question.difficulty/moderate] [:db/add "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/answer-fields "b6e01186-83ec-5681-9bc8-c56b5eedba65"] [:db/ensure "7ad32226-32ee-52d3-ad07-c7cf248ffbb3" :question/validate] [:db/add 17592186059797 :knowledge-point/questions "7ad32226-32ee-52d3-ad07-c7cf248ffbb3"] [:db/add "573ca87e-b81a-5c0e-b878-5f5403e71553" :answer/id #uuid "573ca87e-b81a-5c0e-b878-5f5403e71553"] [:db/add "573ca87e-b81a-5c0e-b878-5f5403e71553" :answer/type :answer.type/text] [:db/add "573ca87e-b81a-5c0e-b878-5f5403e71553" :answer/value "$74\\%$ per minute"] [:db/ensure "573ca87e-b81a-5c0e-b878-5f5403e71553" :answer/validate] [:db/add "7b4017a4-42e9-5326-a589-4eec872a59aa" :answer/id #uuid "7b4017a4-42e9-5326-a589-4eec872a59aa"] [:db/add "7b4017a4-42e9-5326-a589-4eec872a59aa" :answer/type :answer.type/text] [:db/add "7b4017a4-42e9-5326-a589-4eec872a59aa" :answer/value "$83\\%$ per minute"] [:db/ensure "7b4017a4-42e9-5326-a589-4eec872a59aa" :answer/validate] [:db/add "2504313d-b288-5df3-8cdc-0fd8dfc044e5" :answer/id #uuid "2504313d-b288-5df3-8cdc-0fd8dfc044e5"] [:db/add "2504313d-b288-5df3-8cdc-0fd8dfc044e5" :answer/type :answer.type/text] [:db/add "2504313d-b288-5df3-8cdc-0fd8dfc044e5" :answer/value "$67\\%$ per minute"] [:db/ensure "2504313d-b288-5df3-8cdc-0fd8dfc044e5" :answer/validate] [:db/add "eaf162e4-3acf-5b86-93bc-5b7a27c58e2d" :answer/id #uuid "eaf162e4-3acf-5b86-93bc-5b7a27c58e