 amount; keep full calculator precision in the exponential factor."] [:db/add "5aab128d-76b8-53ec-b6cf-8ee91e4ac6bc" :question/requires-calculator true] [:db/add "5aab128d-76b8-53ec-b6cf-8ee91e4ac6bc" :question/difficulty :question.difficulty/moderate] [:db/add "5aab128d-76b8-53ec-b6cf-8ee91e4ac6bc" :question/answer-fields "7c3706a9-8822-510d-9ec2-89e80c981911"] [:db/ensure "5aab128d-76b8-53ec-b6cf-8ee91e4ac6bc" :question/validate] [:db/add 17592186059796 :knowledge-point/questions "5aab128d-76b8-53ec-b6cf-8ee91e4ac6bc"] [:db/add "9f5f554d-d5a7-5beb-a268-2070a23d0c27" :answer/id #uuid "9f5f554d-d5a7-5beb-a268-2070a23d0c27"] [:db/add "9f5f554d-d5a7-5beb-a268-2070a23d0c27" :answer/type :answer.type/text] [:db/add "9f5f554d-d5a7-5beb-a268-2070a23d0c27" :answer/value "$\\$2.24$ per gallon"] [:db/ensure "9f5f554d-d5a7-5beb-a268-2070a23d0c27" :answer/validate] [:db/add "c5501144-58a6-5349-941e-25916a88033c" :answer/id #uuid "c5501144-58a6-5349-941e-25916a88033c"] [:db/add "c5501144-58a6-5349-941e-25916a88033c" :answer/type :answer.type/text] [:db/add "c5501144-58a6-5349-941e-25916a88033c" :answer/value "$\\$3.41$ per gallon"] [:db/ensure "c5501144-58a6-5349-941e-25916a88033c" :answer/validate] [:db/add "58d21fc9-0d91-5c0f-a19c-1c8a63df8836" :answer/id #uuid "58d21fc9-0d91-5c0f-a19c-1c8a63df8836"] [:db/add "58d21fc9-0d91-5c0f-a19c-1c8a63df8836" :answer/type :answer.type/text] [:db/add "58d21fc9-0d91-5c0f-a19c-1c8a63df8836" :answer/value "$\\$2.15$ per gallon"] [:db/ensure "58d21fc9-0d91-5c0f-a19c-1c8a63df8836" :answer/validate] [:db/add "86ca8b1f-93b0-528d-8959-1d11ee11ada7" :answer/id #uuid "86ca8b1f-93b0-528d-8959-1d11ee11ada7"] [:db/add "86ca8b1f-93b0-528d-8959-1d11ee11ada7" :answer/type :answer.type/text] [:db/add "86ca8b1f-93b0-528d-8959-1d11ee11ada7" :answer/value "$\\$1.98$ per gallon"] [:db/ensure "86ca8b1f-93b0-528d-8959-1d11ee11ada7" :answer/validate] [:db/add "8eff0b29-0180-5bba-a520-49576e944aba" :answer/id #uuid "8eff0b29-0180-5bba-a520-49576e944aba"] [:db/add "8eff0b29-0180-5bba-a520-49576e944aba" :answer/type :answer.type/text] [:db/add "8eff0b29-0180-5bba-a520-49576e944aba" :answer/value "$\\$2.06$ per gallon"] [:db/ensure "8eff0b29-0180-5bba-a520-49576e944aba" :answer/validate] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/id #uuid "d05938ca-1928-5730-9ba6-52102c984bb7"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/key "selection"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/type :answer-field.type/radio] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/choices "9f5f554d-d5a7-5beb-a268-2070a23d0c27"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/choices "c5501144-58a6-5349-941e-25916a88033c"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/choices "58d21fc9-0d91-5c0f-a19c-1c8a63df8836"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/choices "86ca8b1f-93b0-528d-8959-1d11ee11ada7"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/choices "8eff0b29-0180-5bba-a520-49576e944aba"] [:db/add "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/correct "58d21fc9-0d91-5c0f-a19c-1c8a63df8836"] [:db/ensure "d05938ca-1928-5730-9ba6-52102c984bb7" :answer-field/validate] [:db/add "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/id #uuid "cd7bbf30-51ef-516d-ac13-4000c7f30771"] [:db/add "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/problem "The average gas price in Chicago is $\\$2.06$ per gallon. Gas prices have been *decreasing* continuously at a rate of $2.1\\%$ per month. What was the gas price $2$ months ago? Round your answer to the nearest cent.\n\n> A scientific calculator is required to answer this question."] [:db/add "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/worked-solution "Use the continuously compounded growth equation $P=P_0e^{rt}$. The current amount is $P=2.06$, the rate is $r=-0.021$ (negative for decay), and the elapsed time is $t=2$ months. The time unit matches the rate. Substitute and divide by the exponential factor:\n\n$$\n\\begin{aligned}\n2.06 &= P_0e^{(-0.021)(2)} \\\\\n2.06 &= P_0e^{-0.042} \\\\\ne^{-0.042} &\\approx 0.95886978 \\\\\nP_0 &= \\frac{2.06}{e^{-0.042}} \\\\\n&\\approx 2.14836263 \\\\\n&\\approx 2.15\n\\end{aligned}\n$$\n\nThe earlier gas price was $\\$2.15$ per gallon. Round only the final amount; keep full calculator precision in the exponential factor."] [:db/add "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/requires-calculator true] [:db/add "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/difficulty :question.difficulty/moderate] [:db/add "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/answer-fields "d05938ca-1928-5730-9ba6-52102c984bb7"] [:db/ensure "cd7bbf30-51ef-516d-ac13-4000c7f30771" :question/validate] [:db/add 17592186059796 :knowledge-point/questions "cd7bbf30-51ef-516d-ac13-4000c7f30771"] [:db/add "312e7f0e-d133-528f-b7c7-02ffdf6cff7b" :answer/id #uuid "312e7f0e-d133-528f-b7c7-02ffdf6cff7b"] [:db/add "312e7f0e-d133-528f-b7c7-02ffdf6cff7b" :answer/type :answer.type/text] [:db/add "312e7f0e-d133-528f-b7c7-02ffdf6cff7b" :answer/value "$\\$2.54$ per gallon"] [:db/ensure "312e7f0e-d133-528f-b7c7-02ffdf6cff7b" :answer/validate] [:db/add "3421f0dd-1987-54ef-bc0a-d9b8f8811033" :answer/id #uuid "3421f0dd-1987-54ef-bc0a-d9b8f8811033"] [:db/add "3421f0dd-1987-54ef-bc0a-d9b8f8811033" :answer/type :answer.type/text] [:db/add "3421f0dd-1987-54ef-bc0a-d9b8f8811033" :answer/value "$\\$3.38$ per gallon"] [:db/ensure "3421f0dd-1987-54ef-bc0a-d9b8f8811033" :answer/validate] [:db/add "4d67f81f-fbc1-5160-80bc-b035d6bcee9c" :answer/id #uuid "4d67f81f-fbc1-5160-80bc-b035d6bcee9c"] [:db/add "4d67f81f-fbc1-5160-80bc-b035d6bcee9c" :answer/type :answer.type/text] [:db/add "4d67f81f-fbc1-5160-80bc-b035d6bcee9c" :answer/value "$\\$4.04$ per gallon"] [:db/ensure "4d67f81f-fbc1-5160-80bc-b035d6bcee9c" :answer/validate] [:db/add "97fd4ab8-100b-53fa-a441-7e8da7fbb4d5" :answer/id #uuid "97fd4ab8-100b-53fa-a441-7e8da7fbb4d5"] [:db/add "97fd4a