swer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730115} :answer-field/id #uuid "a49dafc4-f975-569a-afd6-17f3c993f5d6" :answer-field/key "$x=5$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186730168} {:answer-field/choices [{:answer/id #uuid "ab281096-304e-5992-aa88-b8a03f061bc8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730117} {:answer/id #uuid "b2b8df8a-ab1b-51ec-a595-b9a08db7a7b2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186730118}] :answer-field/correct {:answer/id #uuid "ab281096-304e-5992-aa88-b8a03f061bc8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730117} :answer-field/id #uuid "8b71e4e7-0e7f-5148-a43a-2f0900d9d468" :answer-field/key "$x=6$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186730169}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a815684f-b87f-5e55-b82d-ad4638cad69f" :question/math-academy-id "q-47911" :question/problem "![](images/bb/bb8959927fc561f9fc6e021b690c43f4ab57b169aa1526390e02c8d48386bfe3.png)\n\nThe graph of $y=f(x)$ is plotted above. What are the $x$-coordinates of the critical points?\n\nSelect all that apply." :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively. \n\nIn the given graph, we can see that \n\n- at $x=2$ the tangent to the graph is horizontal, so we have ${f}^{′}(0)=0,$ while\n\n- at $x=4$ there is a sharp corner, so ${f}^{′}(4)$ doesn't exist\n\n![](images/60/60f26a8aa758ae20b2b56325d822379d407276ffd6987f56a1e7934a6406c4d2.png)\n\n \n\nTherefore, there are two critical points, and their $x$-coordinates are $x=2$ and $x=4.$" :task-item/_content [{:db/id #edb/ref 17592186729498 :task-item/content {:db/id #edb/ref 17592186329838} :task-item/elapsed-seconds 13.139000000000001 :task-item/id #uuid "f961504c-45e8-49f8-9d42-6eabc15cc3bd" :task-item/next {:db/id #edb/ref 17592186729510} :task-item/responses [{:answer/id #uuid "652e1d3c-ce79-571d-becc-9c00c37f4c74" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730107} {:answer/id #uuid "7594def0-6497-58ef-932a-0ba92a5bad25" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186730110} {:answer/id #uuid "2260675b-0444-5d86-b1dc-278203348213" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730111} {:answer/id #uuid "d244748d-73ac-594f-bb11-571f118f3d16" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186730114} {:answer/id #uuid "09d86902-f4a1-57e1-ac91-7e56a92a8290" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730115} {:answer/id #uuid "ab281096-304e-5992-aa88-b8a03f061bc8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730117}] :task-item/status {:db/ident :task-item.status/correct} :task-item/working-ended-at #inst "2026-10-28T16:43:40.321Z"}]} {:db/id #edb/ref 17592186329839 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6180aa54-e47c-5045-96dc-d6eb10236078" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the closed interval $[1,5]$" :db/id #edb/ref 17592186327785} {:answer/id #uuid "68cc7e3e-0a69-5db2-890e-431c0fda202b" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186327838} {:answer/id #uuid "6e10d0e9-6028-5c2e-91cb-f1ca26face0f" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1$ and $x=5$ only" :db/id #edb/ref 17592186327888} {:answer/id #uuid "994e309b-55c5-5877-87a1-2e9f09aa18e4" :answer/type {:db/ident :answer.type/text} :answer/value "$x=5$ only" :db/id #edb/ref 17592186328258} {:answer/id #uuid "f3eac55a-cd29-5f9d-b57d-2607dc053e3b" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186329066}] :answer-field/correct {:answer/id #uuid "6180aa54-e47c-5045-96dc-d6eb10236078" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the closed interval $[1,5]$" :db/id #edb/ref 17592186327785} :answer-field/id #uuid "866bfbd0-c250-59be-9290-537b862c2ed7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329404}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cbc920c3-0ad5-5d73-9fe4-65007b1cfa41" :question/math-academy-id "q-47915" :question/problem "![](images/74/748abf694eac3c4e59fd09d3bc48648fe30e46561f536f9f9a16eac7eb526558.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the critical points?" :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively.\n\nIn the given graph, we can see that\n\n- at any point between  $x=1$ and $x=5$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0,$ and\n\n- at $x=1$ and at $x=5$  there are sharp corners, hence ${f}^{′}(1)$ and ${f}^{′}(5)$ don't exist.\n\n![](images/48/48b786a6b9c270336ce507525acf2503439b2424dba59ed9ea200830a79dd828.png)\n\n  \n\nTherefore, all numbers in the closed interval $[1,5]$ are critical points for $f(x).$" :task-item/_content [{:db/id #edb/ref 17592186729497 :task-item/content {:db/id #ed