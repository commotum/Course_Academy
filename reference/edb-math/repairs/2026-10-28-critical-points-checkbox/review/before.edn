ion/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "126dc5db-7aa0-5e31-885e-35517971a655" :question/math-academy-id "q-47918" :question/problem "![](images/4a/4a1843255ea718116bd2daa07f1375a3fb277c47ec8503fec90da824cd714d0b.png)\n\nThe graph of $y=f(x)$ is plotted above. Given that $f(x)$ is defined on the interval $x\\in [-2,10],$ which points represent the global maximum of $f(x)$ ?\n\nSelect all that apply." :question/worked-solution "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the highest point is $D,$ and so this point represents the global maximum of $f(x).$ \n\n**Note:** The point $B$ is not a global maximum, it's a local maximum."} {:db/id 17592186402909 :knowledge-point/_questions [{:db/id 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1bb4bbb-2f02-50e1-b55d-7e77f3b78b12" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186473162} {:answer/id #uuid "c6ed7761-00f8-51d4-8735-0e72b6326883" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186473163}] :answer-field/correct {:answer/id #uuid "a1bb4bbb-2f02-50e1-b55d-7e77f3b78b12" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186473162} :answer-field/id #uuid "ee30d273-5240-5e4c-a488-eda4ce0e214b" :answer-field/key "Point $A$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186473976} {:answer-field/choices [{:answer/id #uuid "0e39929d-71c5-5ec4-9835-ad2e78bc6b89" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186473164} {:answer/id #uuid "9047721c-4c2b-5ea1-a4ce-8f02ff331134" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186473165}] :answer-field/correct {:answer/id #uuid "9047721c-4c2b-5ea1-a4ce-8f02ff331134" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186473165} :answer-field/id #uuid "46330ef8-0578-5f27-bcb8-c43a60278821" :answer-field/key "Point $B$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186473977} {:answer-field/choices [{:answer/id #uuid "1e1ac187-ff1c-5969-ae9e-a58f01e62999" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186473166} {:answer/id #uuid "c312d046-6566-5797-bbb6-cdeaddeacff8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186473167}] :answer-field/correct {:answer/id #uuid "1e1ac187-ff1c-5969-ae9e-a58f01e62999" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186473166} :answer-field/id #uuid "1ac56e58-3cd4-5865-8da5-7df3f44a1700" :answer-field/key "Point $C$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186473978} {:answer-field/choices [{:answer/id #uuid "096abf0e-8813-572f-a4dc-f1d8ee885d13" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186473168} {:answer/id #uuid "94429a12-2904-53cb-bf8a-94ebff0aaf2b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186473169}] :answer-field/correct {:answer/id #uuid "94429a12-2904-53cb-bf8a-94ebff0aaf2b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186473169} :answer-field/id #uuid "653785a4-f06d-58dd-866f-fe771e34527f" :answer-field/key "Point $D$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186473979}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "62b39803-cf8b-5f2a-91f9-b83f48f12d0e" :question/math-academy-id "q-47919" :question/problem "![](images/d9/d9d8fb6d663d8dfd0cce24ae3817c936e2e97ab2df7aefeaa0c734caf0311b94.png)\n\nThe graph of $y=f(x)$ is plotted above. Given that $f(x)$ is defined on the interval $x\\in [-3,10]$, which points represent the global maximum of $f(x)?$\n\nSelect all that apply." :question/worked-solution "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the highest points are $B$ and $D$, and so these points represents the global maximum of $f(x).$"} {:db/id 17592186403633 :knowledge-point/_questions [{:db/id 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bd2520-0c4f-54a1-9032-4feba8ac4cd7" :answer/type {:db/ident :answer.type/text} :answer/value "$x=6$ only" :db/id 17592186403635} {:answer/id #uuid "bf955400-4c85-5799-a0bb-34bb8034740d" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id 17592186403636} {:answer/id #uuid "fab62fe8-12aa-52f0-b98d-2406eb0e0b56" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id 17592186403637} {:answer/id #uuid "b01d168e-efd5-5ced-839e-03be5807a102" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$ only" :db/id 17592186403638} {:answer/id #uuid "9102896f-bd20-58cb-a6f3-3d67a1deeab9" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the closed interval $[2,6]$" :db/id 17592186403639}] :answer-field/correct {:answer/id #uuid "9102896f-bd20-58cb-a6f3-3d67a1deeab9" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the closed interval $[2,6]$" :db/id 17592186403639} :answer-field/id #uuid "f7a88cb6-2519-5806-b90d-f5beabf35ae2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186403634}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6fc62285-d6ad-563b-a202-c3fe4f3d9e71" :question/math-academy-id "q-73409" :question/problem "![](images/7c/7c5bc75101a3bf4b4074bf60c1ab68962f2ed0de559f889365c3807be2fa833c.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the critical points?" :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively.\n\nIn the given graph, we can see that\n\n- at any point between $x=2$ and $x=6$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0,$ while\n\n- at $x=2$ and at $x=6$ there are sharp corners, hence ${f}^{′}(2)$ and ${f}^{′}(6)$ don't exist.\n\n![](images/6e/6e4299d762e26ff3de85ae0fd766d28368de937098dfcf232ce9a234fee826e1.png)\n\n  \n\nTherefore, all numbers in the closed interval $[2,6]$ are critical points for $f(x).$"} {:db/id 17592186403640 :knowledge-point/_questions [{:db/id 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb4d5bbd-8b8e-5b87-b552-49eb950fa340" :answer/type {:db/ident :answer.type/text} :answer/value "$x=3$ only" :db/id 17592186403642} {:answer/id #uuid "25a9ad5d-e3da-5b19-ae3c-1a4da3e2def8" :answer/type {:db/ident :answer.type/text} :answer/value "$x=3$, $x=4$, and $x=6$" :db/id 17592186403643} {:answer/id #uuid "4424aa1e-fbe6-5341-b6bf-db50547251d1" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the open interval $(3,4)$" :db/id 17592186403644} {:answer/id #uuid "d8f5049a-410b-5e0f-aa9d-73bdc98cfb29" :answer/type {:db/ident :answer.type/text} :answer/value "$x=4$ only" :db/id 17592186403645} {:answer/id #uuid "ae9b2849-1a87-535e-a5be-0fdab3635438" :answer/type {:db/ident :answer.type/text} :answer/value "$x=3$ and $x=4$ only" :db/id 17592186403646}] :answer-field/correct {:answer/id #uuid "4424aa1e-fbe6-5341-b6bf-db50547251d1" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the open interval $(3,4)$" :db/id 17592186403644} :answer-field/id #uuid "8aaf3855-a51d-5ca4-8c0a-99b3bc89ed52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186403641}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a831b1fe-cda9-5ab9-bf01-7acc19edee37" :question/math-academy-id "q-73410" :question/problem "![](images/ea/eab84ed04b86678fb4a8d23c010e9a22beead062595b49818ac95e996c3173e6.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the stationary points?" :question/worked-solution "The stationary points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that at any point between $x=3$ and $x=4$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points.\n\n![](images/ab/ab200bebf80bbd1abe6e0c43ec124fe359da25f38d4346d25d8741decc88aa26.png)\n\n  \n\nTherefore, the $x$-coordinates of the stationary points of $f(x)$, are all values in the open interval $(3,4).$ \n\n**Note:** At $x=3$ and $x=4$, there are sharp corners, so ${f}^{′}(x)$ doesn't exist at those points. This gives us two more critical points. But they are not stationary points."} {:db/id 17592186511535 :knowledge-point/_questions [{:db/id 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2adf1cf9-8c4d-5665-8948-53a09c6c23e5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186510871}] :answer-field/correct {:answer/id #uuid "2adf1cf9-8c4d-5665-8948-53a09c6c23e5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186510871} :answer-field/id #uuid "129d9d3d-517b-56d8-9503-4a5fa301d52f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186511320}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9de46d9e-0321-5243-8082-f7e3f4b58ad3" :question/math-academy-id "q-166366" :question/problem "For $0\\le t\\le 8,$ the equation ${q}^{′}(t)=0$ has at least{{field-1}}\nsolution(s)." :question/worked-solution "The solutions to ${q}^{′}(t)=0$ correspond to the stationary points of the graph of $q(t).$\n\nSketching a possible graph of $q(t),$ we get the following:\n\n![](images/2f/2fd9e08520f4a671a255f360e583140175650de856a12233962c99a064c4c582.png)\n\nFrom our sketch, we notice three stationary points located near $t=2,$ $t=3,$ and $t=4.$\n\nTherefore, the equation ${q}^{′}(t)=0$ has at least three solutions."} {:db/id 17592186514466 :knowledge-point/_questions [{:db/id 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233b9c64-ca46-556b-a55b-afac855b6ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id 17592186513630}] :answer-field/correct {:answer/id #uuid "233b9c64-ca46-556b-a55b-afac855b6ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id 17592186513630} :answer-field/id #uuid "0f1f1a16-dad9-5c77-b873-2409266dc186" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186514216} {:answer-field/choices [{:answer/id #uuid "578b231b-5611-5088-bf50-85af5441c79a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186513769}] :answer-field/correct {:answer/id #uuid "578b231b-5611-5088-bf50-85af5441c79a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186513769} :answer-field/id #uuid "e547d708-bc0b-5d82-8783-16718788d1d8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186514331}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d78b3b66-caba-5b75-9179-7631fdc0e796" :question/math-academy-id "q-166077" :question/problem "![](images/5d/5d2bfbefca5ce0a0b04accad183d0f43537d600c72000058b59f692398259a80.png)\n\nThe graph of $y=g(x)$ for $x\\in [-3,3]$ is plotted above. In ascending order, what are the $x$-coordinates of the points on this interval where ${g}^{′}(x)=0?$\n\n${g}^{′}(x)=0\\,$ when $\\,x\\,=$\n{{field-1}}\n$\\,$ and $\\,x\\,=$\n{{field-2}}\n." :question/worked-solution "A stationary point of $g(x)$ is a value of $x$ where ${g}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.  \n\nIn the given graph, we can see that at $x=-2$ and $x=2,$ the tangent to the graph is horizontal, so we have ${g}^{′}(x)=0$ at these points.\n\n![](images/36/36fd58470a5361250fa7852d92abe2b9c2dbf18ca97d00e51ea4013f8f3aa348.png)\n\n \n\nTherefore, there are two stationary points, and their $x$-coordinates (in ascending order) are $x=-2$ and $x=2.$"} {:db/id 17592186600800 :knowledge-point/_questions [{:db/id 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dcdc9a12-b11a-5d7f-9b00-066b934050c3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id 17592186600677}] :answer-field/correct {:answer/id #uuid "dcdc9a12-b11a-5d7f-9b00-066b934050c3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id 17592186600677} :answer-field/id #uuid "2f841642-fc60-5c5f-8d72-e3eee0268916" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186600718}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "714b10f7-bb61-543b-a3cf-55e2c487c8b6" :question/math-academy-id "q-167773" :question/problem "![](images/19/1915c74f3364314b284b37b6f0f4b31621f981d702966c8a7da1a3b63abb2179.png)\n\nThe graph of $y=g(x)$ is plotted above. What is the $x$-coordinate of the point where ${g}^{′}(x)=0?$\n\n${g}^{′}(x)=0$ when $x\\,=$\n{{field-1}}" :question/worked-solution "A stationary point of $g(x)$ is a value of $x$ where ${g}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.  \n\nIn the given graph, we can see that at $x=-1,$  the tangent to the graph is horizontal, so we have ${g}^{′}(x)=0$ at this point.\n\n![](images/53/53b00f9b6ff275b7575ad05e608d4d71afe7ef383a37b9e9f8c68117d778a149.png)\n\n \n\nTherefore, there is one stationary point, and its $x$-coordinate is $x=-1.$"} {:db/id 17592186600826 :knowledge-point/_questions [{:db/id 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2888f6ea-cc59-59d8-a5bb-544b41c8c594" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id 17592186600538} {:answer/id #uuid "9189d99e-b17a-561b-bd3e-ce72cb3f6f90" :answer/type {:db/ident :answer.type/text} :answer/value "$x=8$ only" :db/id 17592186600619} {:answer/id #uuid "b9cb8aeb-f507-5bdc-90aa-f92c9a456a0d" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-1$, $x=2$,  and $x=8$" :db/id 17592186600647} {:answer/id #uuid "d2686125-3d15-500a-915c-837b4d1dfc2e" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=8$ only" :db/id 17592186600665} {:answer/id #uuid "d4e008e5-5a99-587a-84b0-5e37eb6c32b8" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-1$ and $x=5$ only" :db/id 17592186600668}] :answer-field/correct {:answer/id #uuid "d2686125-3d15-500a-915c-837b4d1dfc2e" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=8$ only" :db/id 17592186600665} :answer-field/id #uuid "71d9e6ce-dbf0-5c02-a752-26f68cd829d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186600741}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7f1e70d-5c89-56c5-b289-958d7b590241" :question/math-academy-id "q-73400" :question/problem "![](images/99/991ced811f1c8f1e337025b6e2f7273d2b028a3af4a376efb8436956dc40fa62.png)\n\nThe graph of $y=f(x)$ is plotted above. What are the $x$-coordinates of the critical points?" :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively. \n\nIn the given graph, we can see that \n\n- at $x=2$ there is a sharp corner, so ${f}^{′}(2)$ doesn't exist, and\n\n- at $x=8$ there is a discontinuity, so  ${f}^{′}(8)$ doesn't exist  either.\n\n![](images/cf/cf7b011f1cf09fecbdc60271ee17869b0260f7b2d3b03e26d8a675e38d1f2f7c.png)\n\n \n\nTherefore, there are two critical points, and their $x$-coordinates are $x=2$ and $x=8.$"} {:db/id 17592186600837 :knowledge-point/_questions [{:db/id 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44bf7efd-76e0-53c1-939a-1fe7df2df08a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186600558} {:answer/id #uuid "70f39c71-b0a3-59ac-b6d1-f7e833cef523" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186600591} {:answer/id #uuid "79b20085-7a3f-58fa-b8e0-90c289798593" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id 17592186600600} {:answer/id #uuid "e1f075db-4173-570a-9bf9-e5701275eaf0" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186600681} {:answer/id #uuid "ee83d8ec-0c55-5717-bc71-16614770669e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id 17592186600691}] :answer-field/correct {:answer/id #uuid "70f39c71-b0a3-59ac-b6d1-f7e833cef523" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186600591} :answer-field/id #uuid "f66c229e-7713-50f3-babe-189f09d2d7f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186600778}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fc518e9d-35b1-5473-8374-94a56f67a024" :question/math-academy-id "q-48736" :question/problem "![](images/36/36477ec421ff4b7f349a060df762eadee83b008fbfc9e021a8893cc45e405cae.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\nI. $f(x)$ has  a stationary point at $x=2$\n\nII. $f(x)$ has  a local maximum at $x=-2$\n\nIII. $f(x)$ has a stationary point at $x=-2$" :question/worked-solution "Let's check our statements.\n\n- Statement I is true. Stationary points are points where ${f}^{′}(x)=0.$ In this case,  the graph of the function has a horizontal tangent line at $x=2$ and therefore, ${f}^{′}(2)=0.$\n\n- Statement II is true. The function has a local maximum at $x=-2$ since $f(-2)\\ge f(x)$ for all $x$ close enough  to $x=-2.$\n\n- Statement III is false. Stationary points are points where ${f}^{′}(x)=0.$ In this case,  the graph of the function has a sharp edge at $x=-2$ and therefore, ${f}^{′}(-2)$ does not exist.\n\nTherefore, only statements I and II are true."} {:db/id 17592186620883 :knowledge-point/_questions [{:db/id 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abcebd1-17cd-5d81-9415-1c9643559d88" :answer/type {:db/ident :answer.type/image} :answer/value "images/73/73d247927ae004253dc284df5521284b1537061a4b7d4490f896387e75d7bb9c.png" :db/id 17592186620016} {:answer/id #uuid "25023d26-b1f5-5b98-9363-685f82660428" :answer/type {:db/ident :answer.type/image} :answer/value "images/c0/c0ed670f9eb0f50d75a01a008109d5b67c58c03347e66088c20995f9ce2aaa10.png" :db/id 17592186620048} {:answer/id #uuid "38e4c544-e323-518a-bbdb-a8ea3d1da4a6" :answer/type {:db/ident :answer.type/image} :answer/value "images/b0/b0c8348b3066a3a62f3e8f0d2209b2daa7839b830df999f912fe2568386ecd88.png" :db/id 17592186620117} {:answer/id #uuid "aa03bbda-d2d1-5368-8004-68bc01e78a33" :answer/type {:db/ident :answer.type/image} :answer/value "images/18/18c89c2295730b373cac50f605d8e2a70d5364cf2d548436127f28b45ce13694.png" :db/id 17592186620415} {:answer/id #uuid "bbdb12e5-0bb5-535a-b8bf-93e5b8b800e4" :answer/type {:db/ident :answer.type/image} :answer/value "images/a4/a4bbb5de1a8351cd1b615087640026c6b344c6cc6684246e27a1a458439fbf96.png" :db/id 17592186620472}] :answer-field/correct {:answer/id #uuid "bbdb12e5-0bb5-535a-b8bf-93e5b8b800e4" :answer/type {:db/ident :answer.type/image} :answer/value "images/a4/a4bbb5de1a8351cd1b615087640026c6b344c6cc6684246e27a1a458439fbf96.png" :db/id 17592186620472} :answer-field/id #uuid "7c3e4821-af4a-577f-8877-28f462eca7f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186620731}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e32b2e15-14ff-5caa-9f25-4513bbaf1638" :question/math-academy-id "q-48043" :question/problem "The function $f(x)$ is defined on $x\\in [-3,5].$ It has a global maximum and a global minimum both at critical points inside the interval $x\\in (-3,5).$ Which of the following could be the graph of $f(x)?$" :question/worked-solution "The correct answer is shown below:\n\n![](images/c3/c34e392e42337d58cd0ea1f8fe94050a8931f3413bf1b749c4546bfa8a1e2d67.png)\n\nNote that:\n\n- The global maximum is located at the point marked as $A,$ which is a critical point of $f(x)$ that lies inside $(-3,5).$ Note that ${f}^{′}(x)=0$ at this point.\n\n- The global minimum is located at the point marked as $B,$ which is a critical point of $f(x)$ that lies inside $(-3,5).$ Note that ${f}^{′}(x)$ does not exist at this point (corner)."} {:db/id 17592186620891 :knowledge-point/_questions [{:db/id 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16815d31-7411-5233-9cb1-0a0dd68d34fc" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id 17592186620000} {:answer/id #uuid "3509f24d-1a31-5d2f-8bc6-6055d61503eb" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186620097} {:answer/id #uuid "512bb666-b885-5f43-bbf5-76508401fdf0" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ only" :db/id 17592186620183} {:answer/id #uuid "c4be2ac3-fe36-5cb3-8474-cda6904a0621" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186620498} {:answer/id #uuid "c4ff53c7-127d-5ab7-8922-654475e9faa1" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186620501}] :answer-field/correct {:answer/id #uuid "3509f24d-1a31-5d2f-8bc6-6055d61503eb" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186620097} :answer-field/id #uuid "fa08c47a-165b-5e75-ba82-50c7e3bfa2ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186620807}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f9fa6c95-e7a8-572d-883e-45f18ba990a5" :question/math-academy-id "q-47693" :question/problem "![](images/da/daba5c9c96666b81c5e0e3c0623aa97e234b208dc90f9a3f57785bfcc17552d9.png)\n\nThe graph of $y=f(x)$ is plotted above. Given that $f(x)$ is defined on the interval $x\\in [-10,2]$, which points represent the global minimum of $f(x)?$" :question/worked-solution "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the lowest point is $A,$ and so this point represents the global minimum of $f(x).$ \n\n**Note:** The point $C$ is not a global minimum, it's a local minimum."}]