        ":answer-field/id": "dbae254d-0fe9-5642-9e45-73b127b734b5",
        ":answer-field/key": "$f(x)$ has a local maximum at $x=-1$",
        ":answer-field/type": {
          ":db/ident": ":answer-field.type/checkbox"
