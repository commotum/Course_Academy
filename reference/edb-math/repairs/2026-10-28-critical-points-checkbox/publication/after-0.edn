/choices [{:answer/id #uuid "3a118646-6b9e-5c10-9946-7430287ddcf5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730161} {:answer/id #uuid "96292843-7539-5844-a44d-a5750d70b10d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186730162}] :answer-field/correct {:answer/id #uuid "3a118646-6b9e-5c10-9946-7430287ddcf5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730161} :answer-field/id #uuid "51c8305f-bdd8-5572-806e-783baa22aedc" :answer-field/key "$x=5$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186730210} {:answer-field/choices [{:answer/id #uuid "4b73cb42-bc53-5be5-a320-37d6cfc5e929" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730163} {:answer/id #uuid "0b27f7bf-c2f6-5afd-b3b9-e4f82edb7fd9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186730164}] :answer-field/correct {:answer/id #uuid "4b73cb42-bc53-5be5-a320-37d6cfc5e929" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186730163} :answer-field/id #uuid "adc28b2e-b134-5387-b817-d33a19ba725b" :answer-field/key "$x=7$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186730211}] :question/id #uuid "f0bd195d-16b6-5f90-9a71-becd595f800c" :question/math-academy-id "q-47913" :question/problem "![](images/e0/e06edfc459165563c9c77b4a3439dc0b98e2b94ded708989657d0c60490169d7.png)\n\nThe graph of $y = f(x)$ is plotted above. What are the $x$-coordinates of the stationary points?\n\nSelect all that apply."}] [{:db/id #edb/ref 17592186064835 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6073c8a-c89a-5a9c-8ade-98a160287927" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460077} {:answer/id #uuid "7e0c3b69-dec6-5f70-9fcc-a97060b38947" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460078}] :answer-field/correct {:answer/id #uuid "b6073c8a-c89a-5a9c-8ade-98a160287927" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460077} :answer-field/id #uuid "9bf08e57-4cd3-53cd-83c6-c7152976ea8d" :answer-field/key "$f(x)$ has a stationary point at $x=2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460905} {:answer-field/choices [{:answer/id #uuid "c5a852d6-21fd-5a29-8a75-ae52495112bd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460079} {:answer/id #uuid "41eb15e1-19bc-5288-b489-7f2d16632fd2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460080}] :answer-field/correct {:answer/id #uuid "41eb15e1-19bc-5288-b489-7f2d16632fd2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460080} :answer-field/id #uuid "02bd87fb-811c-57b3-ad45-4500d882b299" :answer-field/key "$f(x)$ has a local maximum at $x=2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460906} {:answer-field/choices [{:answer/id #uuid "2e8646b0-e817-5a5b-8321-477ab393d592" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460081} {:answer/id #uuid "ab7575c0-edd3-5cec-b9e4-43be43554184" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460082}] :answer-field/correct {:answer/id #uuid "ab7575c0-edd3-5cec-b9e4-43be43554184" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460082} :answer-field/id #uuid "71cede8f-ed10-5809-bb8d-dba1266829b2" :answer-field/key "$f(x)$ has a critical point at $x=2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460907}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9157fc37-ed6c-586e-91c2-30b330ac595f" :question/math-academy-id "q-48689" :question/problem "![](images/bb/bb17384f2313820f526f1ba4356f6f3c9e11fbb3791e4f7e2c6044cc604bf662.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\nSelect all that apply." :question/worked-solution "Let's check our statements.\n\n- Statement “$f(x)$ has a stationary point at $x=2$” is false. Stationary points are points where ${f}^{′}(x)=0.$ In this case, the graph of $f(x)$ has a has a sharp edge (cusp) at $x=2.$  Therefore, ${f}^{′}(2)$ does not exist and hence it can't be equal to zero.\n\n- Statement “$f(x)$ has a local maximum at $x=2$” is true. The function has a local maximum at $x=2$ since $f(x)\\le f(2)$ for $x$ near the point $x=2.$\n\n- Statement “$f(x)$ has a critical point at $x=2$” is true. The function has a critical point (a corner) at $x=2$ since the derivative does not exist at this point."}] [{:db/id #edb/ref 17592186235483 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98bc1b2f-fa8a-5961-97fa-ddd45efbed08" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234781}] :answer-field/correct {:answer/id #uuid "98bc1b2f-fa8a-5961-97fa-ddd45efbed08" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234781} :answer-field/id #uuid "a07bf729-338c-54c6-bcd6-05c9494ec558" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235162} {:answer-field/choices [{:answer/id #uuid "d6267a25-9bc8-5804-8ff9-a3389d082f89" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186234878}] :answer-field/correct {:answer/id #uuid "d6267a25-9bc8-5804-8ff9-a3389d082f89" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186234878} :answer-field/id #uuid "a1af1d84-8c6b-5668-ad6d-a9c0ec2f60b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235168}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0e8d54b3-157f-5822-ab7d-9b5417e23e37" :question/math-academy-id "q-167784" :question/problem "![](images/5d/5d2bfbefca5ce0a0b04accad183d0f43537d600c72000058b59f692398259a80.png)\n\nThe graph of $y=g(x)$ for $x\\in [-3,3]$ is plotted above. In ascending order, what are the $x$-coordinates of the points on this interval where ${g}^{′}(x)=0?$\n\n${g}^{′}(x)=0$ when $x\\,=${{field-1}} and $x\\,=${{field-2}}" :question/worked-solution "A stationary point of $g(x)$ is a value of $x$ where ${g}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.  \n\nIn the given graph, we can see that at $x=-2$ and $x=2,$ the tangent to the graph is horizontal, so we have ${g}^{′}(x)=0$ at these points.\n\n![](images/36/36fd58470a5361250fa7852d92abe2b9c2dbf18ca97d00e51ea4013f8f3aa348.png)\n\n \n\nTherefore, there are two stationary points, and their $x$-coordinates (in ascending order) are $x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186238003 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef111cd-88d5-5d0c-a713-e2afda7ea360" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the closed intervals $(-5,-2]$ and $[2,5)$" :db/id #edb/ref 17592186235896} {:answer/id #uuid "35c222f5-e13d-5691-836e-d49975b16248" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the intervals $(-5,-2)$ and $(2,5)$" :db/id #edb/ref 17592186236158} {:answer/id #uuid "7832d692-acf6-5c9c-bf83-c0945a451083" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-2$ and $x=2$ only" :db/id #edb/ref 17592186236571} {:answer/id #uuid "85051ee1-a093-5f0e-86c8-d74cb6d66d9b" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the open interval $(-2,2)$" :db/id #edb/ref 17592186236645} {:answer/id #uuid "c7d46879-1626-5503-b02f-6e85080618c9" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the closed interval $[-2,2]$" :db/id #edb/ref 17592186237084}] :answer-field/correct {:answer/id #uuid "35c222f5-e13d-5691-836e-d49975b16248" :answer/type {:db/ident :answer.type/text} :answer/value "All points in the intervals $(-5,-2)$ and $(2,5)$" :db/id #edb/ref 17592186236158} :answer-field/id #uuid "9741e23f-3fde-552b-93ac-9e5dea888ebe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237639}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d453f004-0326-56c7-8095-3e8cb906e25d" :question/math-academy-id "q-103432" :question/problem "![](images/55/55d089ab7c7947e3f9d67a11fd69fa3903abd6f10ef09853fe018eaa16524ec1.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the stationary points?" :question/worked-solution "The stationary points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that\n\n- at any point between $x=-5$ and $x=-2$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points,\n\n- at any point between $x=2$ and $x=5$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points,\n\n![](images/69/6983f3615bf721529173c11de3a9218962a57e4be5247f4bda1ac2fa496531ee.png)\n\n  \n\nTherefore, the $x$-coordinates of the stationary points of $f(x)$ are all values in the intervals $(-5,-2)$ and $(2,5).$ \n\n**Note:** At $x=-2$ and $x=2$, there are sharp corners, so ${f}^{′}(x)$ doesn't exist at those points. This gives us two more critical points, but they are not stationary points."}] [{:db/id #edb/ref 17592186238004 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "823ad727-022e-5fe1-84ba-0ac0156a929c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in {-3,-1}\\cup (2,4)" :db/id #edb/ref 17592186236630} {:answer/id #uuid "9369af5a-f1a7-5746-be5d-d0660d3fce7d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in {-1,0}\\cup [2,4)" :db/id #edb/ref 17592186236753} {:answer/id #uuid "c146d83f-3554-5cfb-9a81-a3637e9c0e70" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (2,4)" :db/id #edb/ref 17592186237045} {:answer/id #uuid "e823fd79-7f0c-5502-a11f-ae42da0aae1f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in {-3,-1,0,2}" :db/id #edb/ref 17592186237281} {:answer/id #uuid "eb5090a8-e244-519c-a3c1-6f1dd368e051" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in {-3,-1}" :db/id #edb/ref 17592186237296}] :answer-field/correct {:answer/id #uuid "823ad727-022e-5fe1-84ba-0ac0156a929c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in {-3,-1}\\cup (2,4)" :db/id #edb/ref 17592186236630} :answer-field/id #uuid "c5499dac-7dc3-583e-acf4-1d9864cb796f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237692}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e8e57fe9-2874-5a1f-9314-72e265a6e562" :question/math-academy-id "q-103434" :question/problem "![](images/07/07c617933910b3d82ed397fd77754beb2b49fef9bfb498dea3f51a392f6c1d03.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the stationary points?" :question/worked-solution "The stationary points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that\n\n- at $x=-3$ the tangent to the graph is horizontal, so we have ${f}^{′}(-3)=0,$\n\n- at $x=-1$ the tangent to the graph is horizontal, so we have ${f}^{′}(-1)=0,$\n\n- at any point between $x=2$ and $x=4$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points.\n\n![](images/d8/d8a2a08999b45a256fc0458069e50771c2c4ee03ab4f2ed1166f3aa8a1c70c83.png)\n\n  \n\nTherefore, the $x$-coordinates of the stationary points of $f(x)$ are $x=-3,$ $x=-1,$ and all values in the open interval $(2,4).$\n\n**Note:** At $x=0$ and $x=2$ there are sharp corners, so ${f}^{′}(x)$ doesn't exist at those points. This gives us two more critical points, but they are not stationary points."}] [{:db/id #edb/ref 17592186238005 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17ca57ad-6a39-5da3-a0a2-57aecb6d47fc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461273} {:answer/id #uuid "8774e632-f450-599c-8ad5-4217f5858897" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461274}] :answer-field/correct {:answer/id #uuid "8774e632-f450-599c-8ad5-4217f5858897" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461274} :answer-field/id #uuid "af89ebc7-578c-59cc-8ba0-af951c2a1619" :answer-field/key "$f(x)$ has a stationary point at $x=-1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462390} {:answer-field/choices [{:answer/id #uuid "822e6b63-fdce-5fbe-b767-c309319945b0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461275} {:answer/id #uuid "a5f48b58-20d7-5c59-a34c-5a2382d9ccf5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461276}] :answer-field/correct {:answer/id #uuid "a5f48b58-20d7-5c59-a34c-5a2382d9ccf5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461276} :answer-field/id #uuid "a36aef3b-008a-5af0-a829-ec2cab51c8aa" :answer-field/key "$f(x)$ has a critical point at $x=-1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462391} {:answer-field/choices [{:answer/id #uuid "fa66ed42-00b7-5149-afa9-e61ddf9c0006" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461277} {:answer/id #uuid "549d9b59-93c0-5e2d-aa3a-dc11d548a49b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461278}] :answer-field/correct {:answer/id #uuid "fa66ed42-00b7-5149-afa9-e61ddf9c0006" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461277} :answer-field/id #uuid "dbae254d-0fe9-5642-9e45-73b127b734b5" :answer-field/key "$f(x)$ has a local maximum at $x=-1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462392}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f635edc1-2f85-538f-89d8-4edf62a22ccc" :question/math-academy-id "q-103437" :question/problem "![](images/fb/fb61c048eb7eac87f82c53717f8f67251b59610817ddf1f267e80543c0c86959.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\nSelect all that apply." :question/worked-solution "Let's check our statements.\n\n- Statement “$f(x)$ has a stationary point at $x=-1$” is true. Stationary points are points where ${f}^{′}(x)=0.$ In this case, the graph of the function has a horizontal tangent line at $x=-1,$ and therefore, ${f}^{′}(-1)=0.$\n\n- Statement “$f(x)$ has a critical point at $x=-1$” is true. The function has a critical point at $x=-1$ since each stationary point is a critical point.\n\n- Statement “$f(x)$ has a local maximum at $x=-1$” is false. The function has a local minimum at $x=-1$ since $f(-1)\\le f(x)$ for all $x$ close enough to $x=-1.$\n\nTherefore, statements “$f(x)$ has a stationary point at $x=-1$” and “$f(x)$ has a critical point at $x=-1$” are true, while statement “$f(x)$ has a local maximum at $x=-1$” is false."}] [{:db/id #edb/ref 17592186238006 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b293e62f-6f87-5e32-9d47-30001e75a473" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461279} {:answer/id #uuid "d2a8359a-378f-5d30-b9c0-f8c4d4fb9c4d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461280}] :answer-field/correct {:answer/id #uuid "d2a8359a-378f-5d30-b9c0-f8c4d4fb9c4d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461280} :answer-field/id #uuid "92f57ac4-00e1-5c7e-9979-b50b20bf610f" :answer-field/key "$f(x)$ has a critical point at $x=-1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462393} {:answer-field/choices [{:answer/id #uuid "f6cc80e1-8c2d-50ca-9f1e-11ffa91bfdf4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461281} 