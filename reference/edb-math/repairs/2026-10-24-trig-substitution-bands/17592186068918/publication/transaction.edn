69-5e8e-b1a6-653a022f84a6"] [:db/add "750d6834-4969-5e8e-b1a6-653a022f84a6" :answer/type :answer.type/math] [:db/add "750d6834-4969-5e8e-b1a6-653a022f84a6" :answer/value "\\frac{9}{4}\\left(\\ln\\left|\\sin{\\left(4 x - \\frac{\\pi}{6} \\right)}\\right|\\right)"] [:db/ensure "750d6834-4969-5e8e-b1a6-653a022f84a6" :answer/validate] [:db/add "e336733f-ee9e-54b8-9050-d4b000b0a6fa" :answer-field/id #uuid "e336733f-ee9e-54b8-9050-d4b000b0a6fa"] [:db/add "e336733f-ee9e-54b8-9050-d4b000b0a6fa" :answer-field/key "field-1"] [:db/add "e336733f-ee9e-54b8-9050-d4b000b0a6fa" :answer-field/type :answer-field.type/blank] [:db/add "e336733f-ee9e-54b8-9050-d4b000b0a6fa" :answer-field/choices "750d6834-4969-5e8e-b1a6-653a022f84a6"] [:db/add "e336733f-ee9e-54b8-9050-d4b000b0a6fa" :answer-field/correct "750d6834-4969-5e8e-b1a6-653a022f84a6"] [:db/ensure "e336733f-ee9e-54b8-9050-d4b000b0a6fa" :answer-field/validate] [:db/add "3107f410-73e0-556c-972e-d2e0e2ce60a1" :question/id #uuid "3107f410-73e0-556c-972e-d2e0e2ce60a1"] [:db/add "3107f410-73e0-556c-972e-d2e0e2ce60a1" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{9 \\cos{\\left(4 x - \\frac{\\pi}{6} \\right)}}{\\sin{\\left(4 x - \\frac{\\pi}{6} \\right)}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "3107f410-73e0-556c-972e-d2e0e2ce60a1" :question/worked-solution "Let $u=\\sin{\\left(4 x - \\frac{\\pi}{6} \\right)}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4 \\cos{\\left(4 x - \\frac{\\pi}{6} \\right)}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{9 \\cos{\\left(4 x - \\frac{\\pi}{6} \\right)}}{\\sin{\\left(4 x - \\frac{\\pi}{6} \\right)}}\\,\\mathrm{d}x\\\\&=\\frac{9}{4}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{9}{4}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{9}{4}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{9}{4}\\left(\\ln\\left|\\sin{\\left(4 x - \\frac{\\pi}{6} \\right)}\\right|\\right)+C.\n$$"] [:db/add "3107f410-73e0-556c-972e-d2e0e2ce60a1" :question/difficulty :question.difficulty/easy] [:db/add "3107f410-73e0-556c-972e-d2e0e2ce60a1" :question/answer-fields "e336733f-ee9e-54b8-9050-d4b000b0a6fa"] [:db/ensure "3107f410-73e0-556c-972e-d2e0e2ce60a1" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "3107f410-73e0-556c-972e-d2e0e2ce60a1"] [:db/add "b30378af-9e64-5862-9388-b0ac09f501e1" :answer/id #uuid "b30378af-9e64-5862-9388-b0ac09f501e1"] [:db/add "b30378af-9e64-5862-9388-b0ac09f501e1" :answer/type :answer.type/math] [:db/add "b30378af-9e64-5862-9388-b0ac09f501e1" :answer/value "\\frac{9}{4}\\left(\\ln\\left|\\sin{\\left(4 x \\right)}\\right|\\right)"] [:db/ensure "b30378af-9e64-5862-9388-b0ac09f501e1" :answer/validate] [:db/add "67c3da68-4eda-5884-aa69-139b3f7565ce" :answer-field/id #uuid "67c3da68-4eda-5884-aa69-139b3f7565ce"] [:db/add "67c3da68-4eda-5884-aa69-139b3f7565ce" :answer-field/key "field-1"] [:db/add "67c3da68-4eda-5884-aa69-139b3f7565ce" :answer-field/type :answer-field.type/blank] [:db/add "67c3da68-4eda-5884-aa69-139b3f7565ce" :answer-field/choices "b30378af-9e64-5862-9388-b0ac09f501e1"] [:db/add "67c3da68-4eda-5884-aa69-139b3f7565ce" :answer-field/correct "b30378af-9e64-5862-9388-b0ac09f501e1"] [:db/ensure "67c3da68-4eda-5884-aa69-139b3f7565ce" :answer-field/validate] [:db/add "74afbb13-580e-502a-aebe-96d884b75a04" :question/id #uuid "74afbb13-580e-502a-aebe-96d884b75a04"] [:db/add "74afbb13-580e-502a-aebe-96d884b75a04" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{9 \\cos{\\left(4 x \\right)}}{\\sin{\\left(4 x \\right)}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "74afbb13-580e-502a-aebe-96d884b75a04" :question/worked-solution "Let $u=\\sin{\\left(4 x \\right)}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4 \\cos{\\left(4 x \\right)}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{9 \\cos{\\left(4 x \\right)}}{\\sin{\\left(4 x \\right)}}\\,\\mathrm{d}x\\\\&=\\frac{9}{4}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{9}{4}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{9}{4}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{9}{4}\\left(\\ln\\left|\\sin{\\left(4 x \\right)}\\right|\\right)+C.\n$$"] [:db/add "74afbb13-580e-502a-aebe-96d884b75a04" :question/difficulty :question.difficulty/easy] [:db/add "74afbb13-580e-502a-aebe-96d884b75a04" :question/answer-fields "67c3da68-4eda-5884-aa69-139b3f7565ce"] [:db/ensure "74afbb13-580e-502a-aebe-96d884b75a04" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "74afbb13-580e-502a-aebe-96d884b75a04"] [:db/add "33508499-ed71-5b55-9836-8de60b78372c" :answer/id #uuid "33508499-ed71-5b55-9836-8de60b78372c"] [:db/add "33508499-ed71-5b55-9836-8de60b78372c" :answer/type :answer.type/math] [:db/add "33508499-ed71-5b55-9836-8de60b78372c" :answer/value "\\frac{5}{3}\\left(\\ln\\left|\\cos{\\left(3 x \\right)}\\right|\\right)"] [:db/ensure "33508499-ed71-5b55-9836-8de60b78372c" :answer/validate] [:db/add "45939e87-0a0a-5c0b-91e7-263eff72a11d" :answer-field/id #uuid "45939e87-0a0a-5c0b-91e7-263eff72a11d"] [:db/add "45939e87-0a0a-5c0b-91e7-263eff72a11d" :answer-field/key "field-1"] [:db/add "45939e87-0a0a-5c0b-91e7-263eff72a11d" :answer-field/type :answer-field.type/blank] [:db/add "45939e87-0a0a-5c0b-91e7-263eff72a11d" :answer-field/choices "33508499-ed71-5b55-9836-8de60b78372c"] [:db/add "45939e87-0a0a-5c0b-91e7-263eff72a11d" :answer-field/correct "33508499-ed71-5b55-9836-8de60b78372c"] [:db/ensure "45939e87-0a0a-5c0b-91e7-263eff72a11d" :answer-field/validate] [:db/add "c6d6cd27-37d2-58db-bac2-18138e4d4737" :question/id #uuid "c6d6cd27-37d2-58db-bac2-18138e4d4737"] [:db/add "c6d6cd27-37d2-58db-bac2-18138e4d4737" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{- 5 \\sin{\\left(3 x \\right)}}{\\cos{\\left(3 x \\right)}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "c6d6cd27-37d2-58db-bac2-18138e4d4737" :question/worked-solution "Let $u=\\cos{\\left(3 x \\right)}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- 3 \\sin{\\left(3 x \\right)}.\n$$\n\nThe negative derivative is included in the factor outside the new integral.\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{- 5 \\sin{\\left(3 x \\right)}}{\\cos{\\left(3 x \\right)}}\\,\\mathrm{d}x\\\\&=\\frac{5}{3}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{5}{3}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{5}{3}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{5}{3}\\left(\\ln\\left|\\cos{\\left(3 x \\right)}\\right|\\right)+C.\n$$"] [:db/add "c6d6cd27-37d2-58db-bac2-18138e4d4737" :question/difficulty :question.difficulty/easy] [:db/add "c6d6cd27-37d2-58db-bac2-18138e4d4737" :question/answer-fields "45939e87-0a0a-5c0b-91e7-263eff72a11d"] [:db/ensure "c6d6cd27-37d2-58db-bac2-18138e4d4737" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "c6d6cd27-37d2-58db-bac2-18138e4d4737"] [:db/add "f889d838-03c2-5ae0-8c66-22e111d47a66" :answer/id #uuid "f889d838-03c2-5ae0-8c66-22e111d47a66"] [:db/add "f889d838-03c2-5ae0-8c66-22e111d47a66" :answer/type :answer.type/math] [:db/add "f889d838-03c2-5ae0-8c66-22e111d47a66" :answer/value "\\frac{1}{2}\\left(\\ln\\left|\\cos{\\left(2 x - \\frac{\\pi}{6} \\right)}\\right|\\right)"] [:db/ensure "f889d838-03c2-5ae0-8c66-22e111d47a66" :answer/validate] [:db/add "8bd37964-9015-5064-9fbe-2e52274439c3" :answer-field/id #uuid "8bd37964-9015-5064-9fbe-2e52274439c3"] [:db/add "8bd37964-9015-5064-9fbe-2e52274439c3" :answer-field/key "field-1"] [:db/add "8bd37964-9015-5064-9fbe-2e52274439c3" :answer-field/type :answer-field.type/blank] [:db/add "8bd37964-9015-5064-9fbe-2e52274439c3" :answer-field/choices "f889d838-03c2-5ae0-8c66-22e111d47a66"] [:db/add "8bd37964-9015-5064-9fbe-2e52274439c3" :answer-field/correct "f889d838-03c2-5ae0-8c66-22e111d47a66"] [:db/ensure "8bd37964-9015-5064-9fbe-2e52274439c3" :answer-field/validate] [:db/add "02afba5b-6298-5f27-a3bd-f58e8fe06b67" :question/id #uuid "02afba5b-6298-5f27-a3bd-f58e8fe06b67"] [:db/add "02afba5b-6298-5f27-a3bd-f58e8fe06b67" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{- \\sin{\\left(2 x - \\frac{\\pi}{6} \\right)}}{\\cos{\\left(2 x - \\frac{\\pi}{6} \\right)}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "02afba5b-6298-5f27-a3bd-f58e8fe06b67" :question/worked-solution "Let $u=\\cos{\\left(2 x - \\frac{\\pi}{6} \\right)}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- 2 \\sin{\\left(2 x - \\frac{\\pi}{6} \\right)}.\n$$\n\nThe negative derivative is included in the factor outside the new integral.\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{- \\sin{\\left(2 x - \\frac{\\pi}{6} \\right)}}{\\cos{\\left(2 x - \\frac{\\pi}{6} \\right)}}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(\\ln\\left|\\cos{\\left(2 x - \\frac{\\pi}{6} \\right)}\\right|\\right)+C.\n$$"] [:db/add "02afba5b-6298-5f27-a3bd-f58e8fe06b67" :question/difficulty :question.difficulty/easy] [:db/add "02afba5b-6298-5f27-a3bd-f58e8fe06b67" :question/answer-fields "8bd37964-9015-5064-9fbe-2e52274439c3"] [:db/ensure "02afba5b-6298-5f27-a3bd-f58e8fe06b67" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "02afba5b-6298-5f27-a3bd-f58e8fe06b67"] [:db/add "69bcd6d2-c71b-5ab8-9a79-87c67636a907" :answer/id #uuid "69bcd6d2-c71b-5ab8-9a79-87c67636a907"] [:db/add "69bcd6d2-c71b-5ab8-9a79-87c67636a907" :answer/type :answer.type/math] [:db/add "69bcd6d2-c71b-5ab8-9a79-87c67636a907" :answer/value "- \\frac{5}{16}\\left(\\ln\\left|2 \\cot^{2}{\\left(4 x \\right)} + 5\\right|\\right)"] [:db/ensure "69bcd6d2-c71b-5ab8-9a79-87c67636a907" :answer/validate] [:db/add "777376a0-3c60-5f8b-b5e0-9b879194c0d7" :answer-field/id #uuid "777376a0-3c60-5f8b-b5e0-9b879194c0d7"] [:db/add "777376a0-3c60-5f8b-b5e0-9b879194c0d7" :answer-field/key "field-1"] [:db/add "777376a0-3c60-5f8b-b5e0-9b879194c0d7" :answer-field/type :answer-field.type/blank] [:db/add "777376a0-3c60-5f8b-b5e0-9b879194c0d7" :answer-field/choices "69bcd6d2-c71b-5ab8-9a79-87c67636a907"] [:db/add "777376a0-3c60-5f8b-b5e0-9b879194c0d7" :answer-field/correct "69bcd6d2-c71b-5ab8-9a79-87c67636a907"] [:db/ensure "777376a0-3c60-5f8b-b5e0-9b879194c0d7" :answer-field/validate] [:db/add "a2a645f1-bf99-5a74-a0e5-18e8d6774434" :question/id #uuid "a2a645f1-bf99-5a74-a0e5-18e8d6774434"] [:db/add "a2a645f1-bf99-5a74-a0e5-18e8d6774434" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{5 \\cot{\\left(4 x \\right)} \\csc^{2}{\\left(4 x \\right)}}{2 \\cot^{2}{\\left(4 x \\right)} + 5}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "a2a645f1-bf99-5a74-a0e5-18e8d6774434" :question/worked-solution "Let $u=2 \\cot^{2}{\\left(4 x \\right)} + 5$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- 16 \\cot{\\left(4 x \\right)} \\csc^{2}{\\left(4 x \\right)}.\n$$\n\nThe negative derivative is included in the factor outside the new integral.\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{5 \\cot{\\left(4 x \\right)} \\csc^{2}{\\left(4 x \\right)}}{2 \\cot^{2}{\\left(4 x \\right)} + 5}\\,\\mathrm{d}x\\\\&=- \\frac{5}{16}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{5}{16}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=- \\frac{5}{16}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{5}{16}\\left(\\ln\\left|2 \\cot^{2}{\\left(4 x \\right)} + 5\\right|\\right)+C.\n$$"] [:db/add "a2a645f1-bf99-5a74-a0e5-18e8d6774434" :question/difficulty :question.difficulty/moderate] [:db/add "a2a645f1-bf99-5a74-a0e5-18e8d6774434" :question/answer-fields "777376a0-3c60-5f8b-b5e0-9b879194c0d7"] [:db/ensure "a2a645f1-bf99-5a74-a0e5-18e8d6774434" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "a2a645f1-bf99-5a74-a0e5-18e8d6774434"] [:db/add "ba872194-8fd3-555d-b72c-661799e80ea9" :answer/id #uuid "ba872194-8fd3-555d-b72c-661799e80ea9"] [:db/add "ba872194-8fd3-555d-b72c-661799e80ea9" :answer/type :answer.type/math] [:db/add "ba872194-8fd3-555d-b72c-661799e80ea9" :answer/value "- \\frac{9}{16}\\left(\\ln\\left|4 \\sin^{2}{\\left(2 x \\right)} + 4\\right|\\right)"] [:db/ensure "ba872194-8fd3-555d-b72c-661799e80ea9" :answer/validate] [:db/add "cd29a3c0-4a2f-5105-a406-bf870fb3962f" :answer-field/id #uuid "cd29a3c0-4a2f-5105-a406-bf870fb3962f"] [:db/add "cd29a3c0-4a2f-5105-a406-bf870fb3962f" :answer-field/key "field-1"] [:db/add "cd29a3c0-4a2f-5105-a406-bf870fb3962f" :answer-field/type :answer-field.type/blank] [:db/add "cd29a3c0-4a2f-5105-a406-bf870fb3962f" :answer-field/choices "ba872194-8fd3-555d-b72c-661799e80ea9"] [:db/add "cd29a3c0-4a2f-5105-a406-bf870fb3962f" :answer-field/correct "ba872194-8fd3-555d-b72c-661799e80ea9"] [:db/ensure "cd29a3c0-4a2f-5105-a406-bf870fb3962f" :answer-field/validate] [:db/add "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5" :question/id #uuid "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5"] [:db/add "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{- 9 \\sin{\\left(2 x \\right)} \\cos{\\left(2 x \\right)}}{4 \\sin^{2}{\\left(2 x \\right)} + 4}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5" :question/worked-solution "Let $u=4 \\sin^{2}{\\left(2 x \\right)} + 4$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=16 \\sin{\\left(2 x \\right)} \\cos{\\left(2 x \\right)}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{- 9 \\sin{\\left(2 x \\right)} \\cos{\\left(2 x \\right)}}{4 \\sin^{2}{\\left(2 x \\right)} + 4}\\,\\mathrm{d}x\\\\&=- \\frac{9}{16}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{9}{16}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=- \\frac{9}{16}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{9}{16}\\left(\\ln\\left|4 \\sin^{2}{\\left(2 x \\right)} + 4\\right|\\right)+C.\n$$"] [:db/add "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5" :question/difficulty :question.difficulty/moderate] [:db/add "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5" :question/answer-fields "cd29a3c0-4a2f-5105-a406-bf870fb3962f"] [:db/ensure "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "0c4ef409-febd-5faa-ad6d-4b74d9f54cc5"] [:db/add "3e5390db-5116-5562-a668-6167295df915" :answer/id #uuid "3e5390db-5116-5562-a668-6167295df915"] [:db/add "3e5390db-5116-5562-a668-6167295df915" :answer/type :answer.type/math] [:db/add "3e5390db-5116-5562-a668-6167295df915" :answer/value "- \\frac{2}{5}\\left(\\ln\\left|3 \\tan{\\left(5 x \\right)} + 3\\right|\\right)"] [:db/ensure "3e5390db-5116-5562-a668-6167295df915" :answer/validate] [:db/add "91c359bc-a2a5-559a-a927-f5ea7dd2bf36" :answer-field/id #uuid "91c359bc-a2a5-559a-a927-f5ea7dd2bf36"] [:db/add "91c359bc-a2a5-559a-a927-f5ea7dd2bf36" :answer-field/key "field-1"] [:db/add "91c359bc-a2a5-559a-a927-f5ea7dd2bf36" :answer-field/type :answer-field.type/blank] [:db/add "91c359bc-a2a5-559a-a927-f5ea7dd2bf36" :answer-field/choices "3e5390db-5116-5562-a668-6167295df915"] [:db/add "91c359bc-a2a5-559a-a927-f5ea7dd2bf36" :answer-field/correct "3e5390db-5116-5562-a668-6167295df915"] [:db/ensure "91c359bc-a2a5-559a-a927-f5ea7dd2bf36" :answer-field/validate] [:db/add "ff200dd1-fe8