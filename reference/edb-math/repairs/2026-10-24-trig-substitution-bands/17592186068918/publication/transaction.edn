\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{3}{2}\\left(\\ln\\left|\\sin{\\left(2 x + \\frac{\\pi}{6} \\right)}\\right|\\right)+C.\n$$"] [:db/add "d18d2d0d-fcf4-5a07-8a57-6df7fafbc007" :question/difficulty :question.difficulty/easy] [:db/add "d18d2d0d-fcf4-5a07-8a57-6df7fafbc007" :question/answer-fields "d3c656a2-a96b-50c8-930c-79df5dc92847"] [:db/ensure "d18d2d0d-fcf4-5a07-8a57-6df7fafbc007" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "d18d2d0d-fcf4-5a07-8a57-6df7fafbc007"] [:db/add "1781e2dd-9f8d-516f-8851-d2ce8c04531a" :answer/id #uuid "1781e2dd-9f8d-516f-8851-d2ce8c04531a"] [:db/add "1781e2dd-9f8d-516f-8851-d2ce8c04531a" :answer/type :answer.type/math] [:db/add "1781e2dd-9f8d-516f-8851-d2ce8c04531a" :answer/value "- \\frac{6}{5}\\left(\\ln\\left|\\sin{\\left(5 x \\right)}\\right|\\right)"] [:db/ensure "1781e2dd-9f8d-516f-8851-d2ce8c04531a" :answer/validate] [:db/add "a684ef73-2cee-5b36-8f8b-9f7e97862a21" :answer-field/id #uuid "a684ef73-2cee-5b36-8f8b-9f7e97862a21"] [:db/add "a684ef73-2cee-5b36-8f8b-9f7e97862a21" :answer-field/key "field-1"] [:db/add "a684ef73-2cee-5b36-8f8b-9f7e97862a21" :answer-field/type :answer-field.type/blank] [:db/add "a684ef73-2cee-5b36-8f8b-9f7e97862a21" :answer-field/choices "1781e2dd-9f8d-516f-8851-d2ce8c04531a"] [:db/add "a684ef73-2cee-5b36-8f8b-9f7e97862a21" :answer-field/correct "1781e2dd-9f8d-516f-8851-d2ce8c04531a"] [:db/ensure "a684ef73-2cee-5b36-8f8b-9f7e97862a21" :answer-field/validate] [:db/add "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc" :question/id #uuid "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc"] [:db/add "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{- 6 \\cos{\\left(5 x \\right)}}{\\sin{\\left(5 x \\right)}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc" :question/worked-solution "Let $u=\\sin{\\left(5 x \\right)}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=5 \\cos{\\left(5 x \\right)}.\n$$\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{- 6 \\cos{\\left(5 x \\right)}}{\\sin{\\left(5 x \\right)}}\\,\\mathrm{d}x\\\\&=- \\frac{6}{5}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{6}{5}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=- \\frac{6}{5}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{6}{5}\\left(\\ln\\left|\\sin{\\left(5 x \\right)}\\right|\\right)+C.\n$$"] [:db/add "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc" :question/difficulty :question.difficulty/easy] [:db/add "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc" :question/answer-fields "a684ef73-2cee-5b36-8f8b-9f7e97862a21"] [:db/ensure "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "85f9dec2-2bed-5b96-9584-ac2b0b6c1efc"] [:db/add "3a88d3f8-c8dd-572a-9d01-aa79fca55046" :answer/id #uuid "3a88d3f8-c8dd-572a-9d01-aa79fca55046"] [:db/add "3a88d3f8-c8dd-572a-9d01-aa79fca55046" :answer/type :answer.type/math] [:db/add "3a88d3f8-c8dd-572a-9d01-aa79fca55046" :answer/value "-2\\left(\\ln\\left|\\cos{\\left(4 x \\right)}\\right|\\right)"] [:db/ensure "3a88d3f8-c8dd-572a-9d01-aa79fca55046" :answer/validate] [:db/add "02bebe9d-1e9c-5670-8559-3f4e479a7833" :answer-field/id #uuid "02bebe9d-1e9c-5670-8559-3f4e479a7833"] [:db/add "02bebe9d-1e9c-5670-8559-3f4e479a7833" :answer-field/key "field-1"] [:db/add "02bebe9d-1e9c-5670-8559-3f4e479a7833" :answer-field/type :answer-field.type/blank] [:db/add "02bebe9d-1e9c-5670-8559-3f4e479a7833" :answer-field/choices "3a88d3f8-c8dd-572a-9d01-aa79fca55046"] [:db/add "02bebe9d-1e9c-5670-8559-3f4e479a7833" :answer-field/correct "3a88d3f8-c8dd-572a-9d01-aa79fca55046"] [:db/ensure "02bebe9d-1e9c-5670-8559-3f4e479a7833" :answer-field/validate] [:db/add "a8cca768-4d1c-5860-a67e-55a670ba3a27" :question/id #uuid "a8cca768-4d1c-5860-a67e-55a670ba3a27"] [:db/add "a8cca768-4d1c-5860-a67e-55a670ba3a27" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{8 \\sin{\\left(4 x \\right)}}{\\cos{\\left(4 x \\right)}}\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$"] [:db/add "a8cca768-4d1c-5860-a67e-55a670ba3a27" :question/worked-solution "Let $u=\\cos{\\left(4 x \\right)}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- 4 \\sin{\\left(4 x \\right)}.\n$$\n\nThe negative derivative is included in the factor outside the new integral.\n\nSubstituting, including the required constant factor, gives\n\n$$\n\\begin{aligned}&\\int \\frac{8 \\sin{\\left(4 x \\right)}}{\\cos{\\left(4 x \\right)}}\\,\\mathrm{d}x\\\\&=-2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=-2\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n-2\\left(\\ln\\left|\\cos{\\left(4 x \\right)}\\right|\\right)+C.\n$$"] [:db/add "a8cca768-4d1c-5860-a67e-55a670ba3a27" :question/difficulty :question.difficulty/easy] [:db/add "a8cca768-4d1c-5860-a67e-55a670ba3a27" :question/answer-fields "02bebe9d-1e9c-5670-8559-3f4e479a7833"] [:db/ensure "a8cca768-4d1c-5860-a67e-55a670ba3a27" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "a8cca768-4d1c-5860-a67e-55a670ba3a27"] [:db/add "2c95693f-2a78-56bb-95f9-a66f2650f9d7" :answer/id #uuid "2c95693f-2a78-56bb-95f9-a66f2650f9d7"] [:db/add "2c95693f-2a78-56bb-95f9-a66f2650f9d7" :answer/type :answer.type/math] [:db/add "2c95693f-2a78-56bb-95f9-a66f2650f9d7" :answer/value "- \\frac{3}{2}\\left(\\ln\\left|\\cos{\\left(4 x - \\frac{\\pi}{6} \\right)}\\right|\\right)"] [:db/ensure "2c95693f-2a78-56bb-95f9-a66f2650f9d7" :answer/validate] [:db/add "069ae5f6-7161-5806-b00a-7d25ff5a6e31" :answer-field/id #uuid "069ae5f6-7161-5806-b00a-7d25ff5a6e31"] [:db/add "069ae5f6-7161-5806-b00a-7d25ff5a6e31" :answer-field/key "field-1"] [:db/add "069ae5f6-7161-5806-b00a-7d25ff5a6e31" :answer-field/type :answer-field.ty